        1   DEFINE VARIABLE p-install as logical no-undo init false .
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Экспорт групп товаров ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable v-waitfram-action01         as character   no-undo .
       68   define variable v-waitfram-action02         as character   no-undo .
       69   define variable v-waitfram-action03         as character   no-undo .
       70   define variable mWaitFramTextBeg            as character   no-undo.
       71   define variable mWaitFramTextEnd            as character   no-undo.
       72   define variable mWaitFramView               as logical     no-undo.
       73   define variable mWaitProcEvent              as logical     no-undo init yes.
       74   define variable mWaitFramInterval           as integer     no-undo init 1 .
       75   define variable mWaitFramStop               as logical     no-undo.
       76   define variable mWaitFramStopUser           as logical     no-undo.
       77   define variable mWaitFramStopTimeOut        as logical     no-undo.
       78   define variable mWaitFramStartProc          as datetime-tz no-undo.
       79   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       80   define button B-WaitFramStop auto-end-key
       81        label "Стоп"
       82        size 10 by 1 tooltip "Остоновить процесс".
       83   define button B-viewProcInfo
       84        label "Информация"
       85        size 15 by 1 tooltip "Информация о процесс".
       86   define frame waitfram
       87     v-waitfram-action01 format "x(72)" no-label skip
       88     v-waitfram-action02 format "x(72)" no-label skip
       89     v-waitfram-action03 format "x(72)" no-label skip
       90     B-viewProcInfo
       91     B-WaitFramStop at row 4 col 30
       92     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       93     .
       94   define new global shared variable mBatchMode as logical no-undo init ?.
       95   define variable mFramBachModHandle as handle no-undo.
       96   mFramBachModHandle = frame waitfram:handle.
       97   define variable mFameOldVis as logical no-undo.
       98   define variable mVisCUrentVin as logical no-undo.
       99   if session:batch-mode
      100   then
      101      mBatchMode = yes.
      102   if mBatchMode = ? then do:
      103     mVisCUrentVin = current-window:visible.
      104     mFameOldVis = mFramBachModHandle:visible.
      105     mFramBachModHandle:visible  = yes.
      106     mBatchMode = mFramBachModHandle:visible ne yes.
      107     mFramBachModHandle:visible = mFameOldVis.
      108     current-window:visible = mVisCUrentVin.
      109   end.
      110    if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      115     end.
      116   on choose of B-WaitFramStop in frame waitfram
      117   do:
      118     mWaitFramStop = yes.
      119     mWaitFramStopUser = yes.
      120   end.
      121   function waitfram-check-timeout returns logical():
      122      define variable vtime as int64 no-undo.
      123      if mWaitFramStopTimeOut
      124      then
      125         return yes.
      126      vtime = ( now - mWaitFramStartProc ) / 1000 .
      127      if     mWaitFramTimeOut ne ?
      128         and mWaitFramTimeOut ne 0
      129         and mWaitFramTimeOut lt vtime
      130      then do:
      131         mWaitFramStopTimeOut = yes.
      132      end.
      133      return mWaitFramStopTimeOut.
      134   end.
      135   procedure waitfram-hide :
      136     if not session:batch-mode
      137     then do
      138     on error undo, return error return-value
      139     :
      140       pause 0 before-hide .
      141       if not mBatchMode then
      142         hide frame waitfram .
      143     if     not mWaitFramView
      144        and mWaitProcEvent
      145     then
      146       process events .
      147     end.
      148   end procedure.
      149   procedure waitfram-show :
      150     define input  parameter p-message as character no-undo .
      151     define variable v-left-margin as integer   no-undo .
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       if length(p-message) <= 70 then do:
      157         assign
      158           v-left-margin = integer((70 - length(p-message)) / 2)
      159         .
      160         assign
      161           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      162         .
      163         assign
      164           v-waitfram-action01 = " "
      165           v-waitfram-action02 = " "
      166                                    + fill(" ", v-left-margin)
      167                                    + p-message
      168           v-waitfram-action03 = " "
      169         .
      170       end.
      171       else do:
      172         define variable vRindex1 as integer no-undo.
      173         define variable vRindex2 as integer no-undo.
      174         vRindex1 = r-index(p-message," ",70).
      175         if vRindex1 = 0
      176         then
      177            vRindex1 = 70.
      178         if length(p-message)  <= vRindex1 + 70 then do:
      179           assign
      180             v-waitfram-action01 = " "
      181             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      182             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      183           .
      184         end.
      185         else do:
      186           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      187           if vRindex2 <= vRindex1
      188           then
      189              vRindex2 = vRindex1 + 70.
      190           assign
      191             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      194           .
      195         end.
      196       end.
      197       B-viewProcInfo:visible   in frame waitfram = no.
      198       B-viewProcInfo:sensitive in frame waitfram = no.
      199       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       if  (   mWaitFramView
      202          or  mWaitProcEvent)
      203          and not mBatchMode
      204       then
      205          display
      206             v-waitfram-action01 skip
      207             v-waitfram-action02 skip
      208             v-waitfram-action03 skip
      209          with frame waitfram .
      210       if     mWaitFramView
      211          then do:
      212             if     mWaitFramInterval ne ?
      213                and not mBatchMode
      214             then
      215                wait-for go of frame waitfram pause mWaitFramInterval.
      216          end.
      217          else
      218             if     mWaitProcEvent
      219                and not mBatchMode
      220             then
      221                process events .
      222     end.
      223   end procedure.
      224      procedure waitfram-show-this:
      225         define input  parameter iInterval as int64 no-undo.
      226         define variable vtime as int64 no-undo.
      227         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      228         mWaitFramInterval = iInterval.
      229         run waitfram-show (substitute("&1&2 &3&4" ,
      230                                       mWaitFramTextBeg ,
      231                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      232                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      233                                       mWaitFramTextEnd
      234                                      )
      235                           ).
      236      end.
      237      procedure WaitFramRunPause:
      238         define input  parameter iInterval as dec no-undo.
      239         define variable vStart  as datetime-tz no-undo.
      240         define variable vend    as datetime-tz no-undo.
      241         define variable vint as int64 no-undo.
      242         define variable vOk as logical no-undo.
      243         vStart = now.
      244         vend   = vStart.
      245         publish "WaitFramPause" (iInterval,output vOk).
      246         vend   =  now.
      247         vint = vend - vStart.
      248         vint = iInterval - vint / 1000.
      249         if     not mWaitFramStop
      250            and (   vint > 0
      251                 or (    not vOk
      252                     and iInterval eq ?
      253                     )
      254                 )
      255         then
      256            run waitfram-show-this (iInterval).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and vint > 0
      262         then do:
      263            run gbl/pause.p (vint * 1000).
      264         end.
      265         if iInterval ne ?
      266         then
      267            publish "WaitFramStop".
      268         waitfram-check-timeout().
      269      end.
      270      procedure WaitFramWaitFor:
      271         define input  parameter iInterval as dec no-undo.
      272         assign
      273            mWaitFramStartProc   = now
      274            mWaitFramStopUser    = no
      275            mWaitFramStopTimeOut = no
      276         .
      277         block-wait:
      278         do while not mWaitFramStop:
      279            run WaitFramRunPause (iInterval).
      280            if  waitfram-check-timeout()
      281            then do:
      282               leave block-wait.
      283            end.
      284         end.
      285         run waitfram-hide.
      286      end.
      287   procedure waitfram-join :
      288     define input  parameter p-line-1  as character no-undo .
      289     define input  parameter p-line-2  as character no-undo .
      290     define input  parameter p-line-3  as character no-undo .
      291     define output parameter p-message as character no-undo .
      292     do
      293     on error undo, return error return-value
      294     :
      295       assign
      296         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      299       .
      300     end.
      301   end procedure.
      302   function waitfram-join-function returns character
      303     (input p-line-1 as character
      304     ,input p-line-2 as character
      305     ,input p-line-3 as character
      306     ).
      307     define variable v-message as character no-undo .
      308     run waitfram-join in this-procedure
      309       (input  p-line-1
      310       ,input  p-line-2
      311       ,input  p-line-3
      312       ,output v-message
      313       ) .
      314     return v-message .
      315   end function .
      316   define variable vss-include-info1 as character format "X(65)" no-undo
      317   initial "@(#)$Workfile$ $Revision$".
      318   define temp-table temp_grplib_grp no-undo
      319       field sel           as character
      320       field nabor         as character
      321       field full-name     as character
      322       field print-code    as character
      323       field sort-name     as character
      324       field node-code     as integer
      325       field upper-code    as integer
      326       field calc-method   as character
      327       field round-method  as character
      328       field increase-pc   as decimal
      329       field min-marg      as character
      330       field max-marg      as character
      331       field cli-type      as character
      332       field cli-code      as integer
      333       field notcorr      as character
      334       field name          as character
      335       field level         as integer
      336       field mark          as character
      337       index pi is primary unique sort-name
      338       index fn full-name
      339       index nc is unique node-code
      340       index sl sel
      341       index uc upper-code
      342   .
      343   define temp-table temp_grplib_found-grp no-undo
      344       field full-name   as character
      345       field sort-name   as character
      346       field node-code   as integer
      347       field level       as integer
      348       field is-terminal as logical
      349       index pi is primary unique sort-name
      350       index fn full-name
      351       index lv level
      352       index it is-terminal
      353   .
      354   define temp-table temp_found-result-nodelist no-undo
      355       field node-code     as recid
      356       field processed     as logical
      357       field sort-name     as character
      358       field full-name     as character
      359       index pi is primary unique node-code
      360       index ps processed
      361   .
      362   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      363   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      364   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      365   procedure grplib-get-parameters :
      366   define input parameter p-store-type     as character        no-undo.
      367   define input parameter p-store-code     as integer          no-undo.
      368   do
      369   on error undo, return error
      370   :
      371       assign
      372           v-grplib-not-fill-extra-info = no
      373       .
      374   end.
      375   end procedure.
      376   procedure grplib-get-sort-name :
      377   do
      378   on error undo, return error
      379   :
      380   define input parameter p-node-code  as integer      no-undo.
      381   define output parameter p-sort-name as character    no-undo.
      382       define variable v-upper-code    as integer           no-undo.
      383       define buffer buf_gds-grp       for ub.gds-grp.
      384       define buffer buf_upper_gds-grp for ub.gds-grp.
      385       find first buf_gds-grp no-lock
      386            where buf_gds-grp.node-code = p-node-code
      387       no-error.
      388       if not available buf_gds-grp
      389       then do:
      390           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      391       end.
      392       assign
      393           p-sort-name  = ""
      394           v-upper-code = 1
      395       .
      396       do while buf_gds-grp.upper-code <> 0
      397       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      398       :
      399           assign
      400               p-sort-name  = buf_gds-grp.node-name
      401                            + (if p-sort-name <> "" then chr(2) else "")
      402                            + p-sort-name
      403               v-upper-code = buf_gds-grp.upper-code
      404           .
      405           find first buf_gds-grp no-lock
      406                where buf_gds-grp.node-code = v-upper-code
      407           no-error.
      408           if not available buf_gds-grp
      409           then do:
      410               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      411                                   + string( v-upper-code )
      412                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      413           end.
      414       end.
      415   end.
      416   end procedure.
      417   define variable vss-include-info2 as character format "X(65)" no-undo
      418   initial "@(#)$Workfile$ $Revision$".
      419   procedure grplib-get-full-name :
      420      define input parameter p-node-code  as integer      no-undo.
      421      define output parameter p-full-name as character    no-undo.
      422      do
      423   on error undo, return error
      424   :
      425       define variable v-upper-code    as integer           no-undo.
      426       define buffer buf_gds-grp       for ub.gds-grp.
      427       define buffer buf_upper_gds-grp for ub.gds-grp.
      428       find first buf_gds-grp no-lock
      429            where buf_gds-grp.node-code = p-node-code
      430       no-error.
      431       if not available buf_gds-grp
      432       then do:
      433           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      434       end.
      435       assign
      436           p-full-name  = ""
      437           v-upper-code = 1
      438       .
      439       do while buf_gds-grp.upper-code <> 0
      440       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      441       :
      442           assign
      443               p-full-name  = buf_gds-grp.node-name
      444                            + (if p-full-name <> "" then chr(47) else "")
      445                            + p-full-name
      446               v-upper-code = buf_gds-grp.upper-code
      447           .
      448           find first buf_gds-grp no-lock
      449                where buf_gds-grp.node-code = v-upper-code
      450           no-error.
      451           if not available buf_gds-grp
      452           then do:
      453               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      454                                   + string( v-upper-code )
      455                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      456           end.
      457       end.
      458       assign
      459       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      460       .
      461   end.
      462   end .
      463   procedure grplib-get-node-from-full-name :
      464   define input parameter p-full-name as character no-undo .
      465   define output parameter p-node-code as integer no-undo .
      466   define variable v-ii as integer no-undo .
      467   define variable v-upper-code as integer no-undo .
      468   define variable v-root-code as integer no-undo .
      469   define variable v-entry as character no-undo .
      470   define buffer buf_gds-grp       for ub.gds-grp.
      471   do
      472   on error undo, return error
      473   :
      474     find first buf_gds-grp no-lock
      475         where buf_gds-grp.upper-code = 0
      476     no-error .
      477     if not available buf_gds-grp
      478     then do:
      479         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      480     end.
      481     else do:
      482       assign
      483       v-root-code = buf_gds-grp.node-code
      484       .
      485     end.
      486     v-upper-code = v-root-code.
      487     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      488       assign
      489       v-entry = entry(v-ii, p-full-name, chr(47)).
      490       if v-entry = '' then leave.
      491       find first buf_gds-grp no-lock where
      492                 buf_gds-grp.node-name = v-entry
      493             and buf_gds-grp.upper-code = v-upper-code
      494             no-error.
      495       if not available buf_gds-grp then do:
      496         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      497       end.
      498       else do:
      499         p-node-code = buf_gds-grp.node-code.
      500         v-upper-code = buf_gds-grp.node-code.
      501       end.
      502     end.
      503   end.
      504   end .
      505   procedure grplib-get-root-code :
      506   do
      507   on error undo, return error
      508   :
      509   define output parameter p-root-code as integer      no-undo.
      510       define buffer buf_gds-grp       for ub.gds-grp.
      511       find first buf_gds-grp no-lock
      512           where buf_gds-grp.upper-code = 0
      513       no-error .
      514       if not available buf_gds-grp
      515       then do:
      516           undo, return error .
      517       end.
      518       else do:
      519           assign
      520               p-root-code = buf_gds-grp.node-code
      521           .
      522       end.
      523   end.
      524   end procedure.
      525   procedure grplib-find-grp-by-full-name :
      526   do
      527   on error undo, return error
      528   :
      529   define input parameter p-search-name  as character    no-undo.
      530   define input parameter p-fill-path    as logical      no-undo.
      531   define output parameter p-found       as logical      no-undo.
      532       define variable v-upper-code    as integer          no-undo.
      533       define variable v-counter       as integer           no-undo.
      534       define variable v-level         as integer           no-undo.
      535       define variable v-full-name     as character         no-undo.
      536       define variable v-sort-name     as character         no-undo.
      537       define buffer buf_gds-grp       for ub.gds-grp.
      538       assign
      539           p-search-name = replace( p-search-name, chr(47), chr(2) )
      540       .
      541       run grplib-get-root-code ( output v-upper-code ) no-error .
      542       if error-status :error
      543       then do:
      544           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      545       end.
      546       assign
      547           v-full-name  = ""
      548           v-level      = num-entries( p-search-name, chr(2) )
      549       .
      550       for each temp_grplib_found-grp
      551       :
      552           delete temp_grplib_found-grp.
      553       end.
      554       start-name-analyze:
      555       do v-counter = 1 to v-level
      556       :
      557           if v-counter < v-level
      558           then do:
      559               find first buf_gds-grp no-lock
      560                    where buf_gds-grp.upper-code = v-upper-code
      561                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      562               no-error .
      563               if not available buf_gds-grp
      564               then do:
      565                   assign
      566                       v-full-name  = p-search-name
      567                       v-sort-name  = p-search-name
      568                   .
      569                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      570               end.
      571               else do:
      572                   assign
      573                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      574                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      575                       v-upper-code = buf_gds-grp.node-code
      576                   .
      577                   if p-fill-path = yes
      578                   then do:
      579                       create temp_grplib_found-grp.
      580                       assign
      581                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      582                           temp_grplib_found-grp.sort-name = v-sort-name
      583                           temp_grplib_found-grp.node-code = v-upper-code
      584                           temp_grplib_found-grp.level     = v-counter
      585                       .
      586                   end.
      587               end.
      588           end.
      589           else do:
      590               for each buf_gds-grp no-lock
      591                  where buf_gds-grp.upper-code = v-upper-code
      592                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      593               :
      594                   assign
      595                       p-found = yes
      596                   .
      597                   create temp_grplib_found-grp.
      598                   assign
      599                       temp_grplib_found-grp.full-name = v-full-name
      600                                                           + (if v-full-name = "" then "" else chr(47) )
      601                                                           + buf_gds-grp.node-name + chr(47)
      602                       temp_grplib_found-grp.sort-name = v-sort-name
      603                                                           + ( if v-sort-name = "" then "" else chr(2) )
      604                                                           + buf_gds-grp.node-name
      605                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      606                       temp_grplib_found-grp.level     = v-level
      607                   .
      608               end.
      609               if p-found = no
      610               then do:
      611                   assign
      612                       v-full-name  = p-search-name
      613                       v-sort-name  = p-search-name
      614                   .
      615                   for each temp_grplib_found-grp
      616                   :
      617                       delete temp_grplib_found-grp.
      618                   end.
      619                   assign
      620                       p-found = no
      621                   .
      622               end.
      623           end.
      624       end.
      625   end.
      626   end procedure.
      627   procedure grplib-find-all-subgroup :
      628   do
      629   on error undo, return error
      630   :
      631   define input parameter p-start-node-code    as integer      no-undo.
      632   define input parameter p-terminal-only      as logical      no-undo.
      633       define variable v-start-full-name   as character     no-undo.
      634       define variable v-start-sort-name   as character     no-undo.
      635       define variable v-not-found         as logical       no-undo.
      636       define variable v-is-terminal       as logical       no-undo.
      637       define buffer buf_gds-grp           for ub.gds-grp.
      638       create temp_found-result-nodelist.
      639       assign
      640           temp_found-result-nodelist.node-code = p-start-node-code
      641           temp_found-result-nodelist.processed = no
      642       .
      643       run grplib-get-full-name in this-procedure (
      644             input p-start-node-code
      645           , output v-start-full-name
      646       ).
      647       run grplib-get-full-name in this-procedure (
      648             input p-start-node-code
      649           , output v-start-sort-name
      650       ).
      651       process-nodes:
      652       do while yes
      653       :
      654           find first temp_found-result-nodelist
      655                where temp_found-result-nodelist.node-code = p-start-node-code
      656           .
      657           assign
      658               temp_found-result-nodelist.processed = yes
      659           .
      660           for each buf_gds-grp no-lock
      661              where buf_gds-grp.upper-code = p-start-node-code
      662           on error undo, return error
      663           :
      664               run grplib-is-terminal in this-procedure (
      665                     input buf_gds-grp.node-code
      666                   , output v-is-terminal
      667               ).
      668               if v-is-terminal = yes
      669               then do:
      670                   create temp_grplib_found-grp.
      671                   assign
      672                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      673                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      674                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      675                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      676                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      677                       temp_grplib_found-grp.is-terminal = yes
      678                   .
      679               end.
      680               else do:
      681                   create temp_found-result-nodelist.
      682                   assign
      683                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      684                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      685                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      686                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      687                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      688                       temp_found-result-nodelist.processed = no
      689                   .
      690                   if p-terminal-only = no
      691                   then do:
      692                       create temp_grplib_found-grp.
      693                       assign
      694                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      695                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      696                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      697                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      698                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      699                           temp_grplib_found-grp.is-terminal = no
      700                       .
      701                   end.
      702               end.
      703           end.
      704           find first temp_found-result-nodelist
      705                where temp_found-result-nodelist.processed = no
      706           no-error.
      707           if not available temp_found-result-nodelist
      708           then do:
      709               leave process-nodes.
      710           end.
      711           else do:
      712               assign
      713                   p-start-node-code = temp_found-result-nodelist.node-code
      714                   v-start-full-name = temp_found-result-nodelist.full-name
      715                   v-start-sort-name = temp_found-result-nodelist.sort-name
      716               .
      717           end.
      718       end.
      719   end.
      720   end procedure.
      721   procedure grplib-expand-name :
      722   define input parameter p-start-name as character        no-undo.
      723   define output parameter p-end-name  as character        no-undo.
      724       define variable v-is-terminal   as logical      no-undo.
      725       define variable v-found         as character    no-undo.
      726       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      727   do
      728   for buf_temp_grplib_found-grp
      729   on error undo, return error
      730   :
      731       run grplib-find-grp-by-full-name in this-procedure (
      732             input p-start-name
      733           , input no
      734           , output v-found
      735       ) no-error.
      736       run grplib-get-max-substring in this-procedure (
      737                   input length( p-start-name )
      738                 , output p-end-name
      739       ) no-error .
      740       if error-status :error
      741       then do:
      742           assign
      743               p-end-name = ""
      744           .
      745       end.
      746       else do:
      747           find first temp_grplib_found-grp
      748               where temp_grplib_found-grp.full-name = p-end-name
      749           no-error.
      750           if available temp_grplib_found-grp
      751           then do:
      752               find first buf_temp_grplib_found-grp
      753                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      754                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      755               no-error.
      756               if not available buf_temp_grplib_found-grp
      757               then do:
      758                   run grplib-is-terminal in this-procedure (
      759                       input temp_grplib_found-grp.node-code
      760                       , output v-is-terminal
      761                   ).
      762               end.
      763           end.
      764       end.
      765   end.
      766   end procedure.
      767   procedure grplib-get-max-substring :
      768   do
      769   on error undo, return error
      770   :
      771   define input parameter p-min-substring-length   as integer      no-undo.
      772   define output parameter p-substring             as character    no-undo.
      773           define variable v-char-counter  as integer           no-undo.
      774           define variable v-current-char  as character         no-undo.
      775           define variable v-names-counter  as integer           no-undo.
      776           define variable v-base-string   as character         no-undo.
      777           assign
      778               v-char-counter  = p-min-substring-length
      779           .
      780           find first temp_grplib_found-grp no-error.
      781           if not available temp_grplib_found-grp
      782           then do:
      783               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      784           end.
      785           else do:
      786               assign
      787                   v-base-string  = temp_grplib_found-grp.full-name
      788                   v-char-counter = 0
      789               .
      790               counter-block:
      791               do while yes
      792               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      793               :
      794                   assign
      795                       v-char-counter  = v-char-counter + 1
      796                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      797                       v-names-counter = 0
      798                   .
      799                   compare-block:
      800                   for each temp_grplib_found-grp
      801                   :
      802                       assign
      803                           v-names-counter = v-names-counter + 1
      804                       .
      805                       if v-names-counter = 1
      806                       then do:
      807                           next compare-block.
      808                       end.
      809                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      810                       then do:
      811                           leave counter-block.
      812                       end.
      813                   end.
      814                   if v-names-counter = 1
      815                   then do:
      816                       assign
      817                           p-substring = v-base-string
      818                       .
      819                       return.
      820                   end.
      821               end.
      822               assign
      823                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      824               .
      825           end.
      826   end.
      827   end procedure.
      828   procedure grplib-is-terminal :
      829   do
      830   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      831   :
      832   define input parameter p-node-code      as integer      no-undo.
      833   define output parameter p-is-terminal   as logical      no-undo.
      834       define buffer buf_gds-grp       for ub.gds-grp.
      835       find first buf_gds-grp no-lock
      836           where buf_gds-grp.upper-code = p-node-code
      837       no-error .
      838       if not available buf_gds-grp
      839       then do:
      840           assign
      841               p-is-terminal = yes
      842           .
      843       end.
      844       else do:
      845           assign
      846               p-is-terminal = no
      847           .
      848       end.
      849   end.
      850   end procedure.
      851   procedure grplib-have-goods :
      852   do
      853   on error undo, return error
      854   :
      855   define input parameter p-node-code      as integer      no-undo.
      856   define output parameter p-have-goods   as logical      no-undo.
      857       define buffer buf_goods         for ub.goods.
      858       find first buf_goods no-lock
      859            where buf_goods.grp-code = p-node-code
      860       no-error .
      861       if available buf_goods
      862       then do:
      863           assign
      864               p-have-goods = yes
      865           .
      866       end.
      867       else do:
      868           assign
      869               p-have-goods = no
      870           .
      871       end.
      872   end.
      873   end procedure.
      874   procedure grplib-find-by-substring :
      875   do
      876   on error undo, return error
      877   :
      878   define input parameter p-start-code         as integer      no-undo.
      879   define input parameter p-full-search-string as character    no-undo.
      880   define output parameter p-found-code        as integer      no-undo.
      881   define output parameter p-full-name         as character    no-undo.
      882       define variable v-start-code     as integer           no-undo.
      883       define variable v-found          as logical  init no  no-undo.
      884       define buffer buf_gds-grp       for ub.gds-grp.
      885       search-grp:
      886       for each buf_gds-grp no-lock
      887           where buf_gds-grp.node-code > p-start-code
      888       :
      889           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      890           then do:
      891               assign
      892                   p-found-code = buf_gds-grp.node-code
      893                   v-found      = yes
      894               .
      895               run grplib-get-full-name in this-procedure (
      896                     input p-found-code
      897                   , output p-full-name
      898               ) no-error .
      899               if error-status :error
      900               then do:
      901                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      902               end.
      903               leave search-grp.
      904           end.
      905       end.
      906       if v-found = yes
      907       then do:
      908       end.
      909       else do:
      910           assign
      911               p-full-name  = ""
      912               p-found-code = 0
      913           .
      914       end.
      915   end.
      916   end procedure.
      917   procedure grplib-analyze-grp-name :
      918   do
      919   on error undo, return error
      920   :
      921   define input parameter p-grp-name       as character            no-undo.
      922   define input parameter p-upper-code     as integer              no-undo.
      923   define output parameter p-error-message as character init ""    no-undo.
      924       define variable v-char-list     as character    no-undo.
      925       define variable v-char-counter  as integer      no-undo.
      926       define variable v-full-name     as character    no-undo.
      927       if p-grp-name = "" then do:
      928           assign
      929               p-error-message = "Название группы не может быть пустым.".
      930           .
      931       end.
      932       else do:
      933           assign
      934               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      935           .
      936           do v-char-counter = 1 to num-entries( v-char-list )
      937           :
      938               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      939               then do:
      940                   assign
      941                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      942                   .
      943                   return.
      944               end.
      945           end.
      946           if p-upper-code > 0
      947           then do:
      948               run grplib-get-full-name in this-procedure (
      949                     input p-upper-code
      950                   , output v-full-name
      951               ) no-error .
      952               if error-status :error
      953               then do:
      954                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      955               end.
      956               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      957               then do:
      958                   assign
      959                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      960                   .
      961               end.
      962           end.
      963       end.
      964   end.
      965   end procedure.
      966   procedure grplib-get-lvl-num :
      967   define input parameter p-node-code  as integer      no-undo.
      968   define output parameter p-lvl-num   as integer      no-undo.
      969       define variable v-full-name    as character    no-undo.
      970   do
      971   on error undo, return error
      972   :
      973       run grplib-get-full-name in this-procedure (
      974             input p-node-code
      975           , output v-full-name
      976       ).
      977       assign
      978           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      979       .
      980       if p-lvl-num = -1
      981       then do:
      982           assign
      983               p-lvl-num = 0
      984           .
      985       end.
      986   end.
      987   end procedure.
      988   define stream sexp .
      989   define stream slog.
      990   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      991        LABEL "Отмена"
      992        SIZE 15 BY 1.13
      993        BGCOLOR 8 .
      994   DEFINE BUTTON Btn_OK AUTO-GO
      995        LABEL "Ввод"
      996        SIZE 15 BY 1.13
      997        BGCOLOR 8 .
      998   DEFINE BUTTON r-currency
      999        IMAGE-UP FILE "btn-down-arrow":U
     1000        IMAGE-DOWN FILE "btn-down-arrow":U
     1001        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1002        LABEL ""
     1003        SIZE 3 BY 1.
     1004   DEFINE VARIABLE f-name AS CHARACTER FORMAT "X(256)":U
     1005        LABEL "Файл"
     1006        VIEW-AS FILL-IN
     1007        SIZE 42 BY 1 NO-UNDO.
     1008   DEFINE VARIABLE rs-format AS INTEGER
     1009        VIEW-AS RADIO-SET VERTICAL
     1010        RADIO-BUTTONS
     1011             "Имя группы", 1,
     1012   "Имя группы,код группы,код родительской группы", 2
     1013        SIZE 52 BY 2.5 NO-UNDO.
     1014   DEFINE FRAME Dialog-Frame
     1015        rs-format AT ROW 2.21 COL 3.38 NO-LABEL WIDGET-ID 2
     1016        f-name AT ROW 5.04 COL 7.25 COLON-ALIGNED WIDGET-ID 8
     1017        r-currency AT ROW 5.08 COL 51.25 WIDGET-ID 52
     1018        Btn_OK AT ROW 7.21 COL 9
     1019        Btn_Cancel AT ROW 7.25 COL 26.63
     1020        "Выберите формат:" VIEW-AS TEXT
     1021             SIZE 19.5 BY .67 AT ROW 1.25 COL 3.5 WIDGET-ID 6
     1022        SPACE(36.37) SKIP(7.99)
     1023       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1024            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1025            TITLE "Экспорт групп товаров"
     1026            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     1027   ASSIGN
     1028          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1029          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1030   ASSIGN
     1031          r-currency:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1032   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1033   DO:
     1034     APPLY "END-ERROR":U TO SELF.
     1035   END.
     1036   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1037   DO:
     1038   define variable v-ok   as logical   no-undo .
     1039   DEFINE VARIABLE v-level-name as character no-undo .
     1040   DEFINE VARIABLE v-level-num as integer no-undo .
     1041   DEFINE VARIABLE v-full-level-name as character no-undo .
     1042   DEFINE VARIABLE v-node-code like ub.gds-grp.node-code no-undo .
     1043   DEFINE VARIABLE v-upper-code like ub.gds-grp.upper-code no-undo .
     1044   DEFINE VARIABLE v-calc-method like ub.gds-grp.calc-method no-undo .
     1045   DEFINE VARIABLE v-increase-pc like ub.gds-grp.increase-pc no-undo .
     1046   DEFINE VARIABLE v-d-pcnt like ub.gds-grp.d-pcnt no-undo .
     1047   DEFINE VARIABLE v-new-node-code like ub.gds-grp.node-code no-undo .
     1048   DEFINE VARIABLE v-rid as recid no-undo.
     1049   DEFINE VARIABLE v-ask as logical no-undo init yes.
     1050   DEFINE VARIABLE choice as integer no-undo .
     1051   define variable v-ind      as integer   no-undo .
     1052   define variable v-grp-name as character no-undo .
     1053   do
     1054   on error undo, return
     1055   :
     1056     assign
     1057       v-ok = false
     1058     .
     1059   assign     frame Dialog-Frame f-name  rs-format.
     1060   output stream sexp to value (f-name) .
     1061   export stream sexp substitute("GOODS_GRP_&1_0",rs-format) .
     1062   output stream sexp close .
     1063   run waitfram-show in this-procedure
     1064     (input "Ждите..."
     1065     ).
     1066   for each ub.gds-grp no-lock
     1067     where ub.gds-grp.upper-code <> 0
     1068   :
     1069     assign
     1070       v-ind = v-ind + 1
     1071     .
     1072     run grplib-get-full-name in this-procedure (
     1073                                                    input  ub.gds-grp.node-code
     1074                                                 ,output v-grp-name
     1075                                                 ) .
     1076     run waitfram-show in this-procedure
     1077       (input "Ждите..."
     1078       ).
     1079     output stream sexp to value (f-name) append .
     1080     if rs-format  = 1 then do:
     1081       export stream sexp v-grp-name .
     1082     end.
     1083     else do:
     1084       export stream sexp delimiter ',' gds-grp.node-name  gds-grp.node-code  gds-grp.upper-code  .
     1085     end.
     1086     output stream sexp close .
     1087     run waitfram-hide in this-procedure .
     1088   end.
     1089   if p-install = false then do:
     1090     message
     1091       "Экспорт групп товаров закончен" skip
     1092       "Экспортировано групп" v-ind skip
     1093       view-as alert-box information .
     1094   end.
     1095   END.
     1096   END .
     1097   ON CHOOSE OF r-currency IN FRAME Dialog-Frame
     1098   DO:
     1099   def var v-ok as log.
     1100   f-name = 'gds-grp.ggr' .
     1101         system-dialog get-file f-name
     1102         title "Выберите файл с группами товаров"
     1103         filters "Файлы групп товаров *.ggr" "*.ggr",
     1104                   "Все файлы  *.*" "*.*"
     1105         INITIAL-DIR "."
     1106         return-to-start-dir
     1107         must-exist
     1108         update v-ok
     1109         default-extension "ggr".
     1110       if v-ok <> true then do:
     1111         return .
     1112       end.
     1113   f-name:screen-value = search(f-name).
     1114   END.
     1115   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1116   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1117   MAIN-BLOCK:
     1118   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1119      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1120     RUN enable_UI.
     1121     WAIT-FOR GO OF FRAME Dialog-Frame.
     1122   END.
     1123   RUN disable_UI.
     1124   PROCEDURE disable_UI :
     1125     HIDE FRAME Dialog-Frame.
     1126   END PROCEDURE.
     1127   PROCEDURE enable_UI :
     1128     DISPLAY rs-format f-name
     1129         WITH FRAME Dialog-Frame.
     1130     ENABLE rs-format f-name r-currency Btn_OK Btn_Cancel
     1131         WITH FRAME Dialog-Frame.
     1132     VIEW FRAME Dialog-Frame.
     1133   END PROCEDURE.
     1134   PROCEDURE write-to-log :
     1135   define input parameter P-MESSAGE as character no-undo .
     1136     do
     1137     on error undo, return error
     1138     :
     1139       output STREAM SLOG TO imp-ggr.log append.
     1140       put STREAM SLOG unformatted
     1141       P-MESSAGE SKIP.
     1142       OUTPUT STREAM SLOG CLOSE.
     1143     end.
     1144   END PROCEDURE.
