        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 7502ab9e34da, 2658, rls $":u .
        3   define variable vss-author      as character no-undo init "$Author: SSlivenko $":u .
        4   define variable vss-date        as character no-undo init "$Date: Пн ноя 02 16:18:16 2020 +0300 $":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile: fill-pl-attr.p $":u .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/fill-pl-attr.p $":u .
        7   define variable vss-description as character no-undo init "утилита установки атрибута резервуара на удаленке" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure placelib_write-attr:
       67   define input  parameter p-code     like ub.place-attr.attr-code .
       68   define input  parameter p-obj-code like ub.place-attr.obj-code .
       69   define input  parameter p-obj-type like ub.place-attr.obj-type .
       70   define input  parameter p-pl-code  like ub.place-attr.pl-code .
       71   define input  parameter p-value    like ub.place-attr.attr-value .
       72   define output parameter p-ok       as logical.
       73   define buffer buf_place-attr for ub.place-attr .
       74     do on error undo, return error return-value :
       75        p-ok = false.
       76        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
       77                                                   and buf_place-attr.obj-code    = p-obj-code
       78                                                   and buf_place-attr.obj-type    = p-obj-type
       79                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       80        if not available buf_place-attr then do :
       81           create buf_place-attr.
       82           assign
       83             buf_place-attr.attr-code   = p-code
       84             buf_place-attr.attr-value  = p-value
       85             buf_place-attr.obj-code    = p-obj-code
       86             buf_place-attr.obj-type    = p-obj-type
       87             buf_place-attr.pl-code     = p-pl-code
       88           .
       89           p-ok = true.
       90        end.
       91        else do:
       92           buf_place-attr.attr-value  = p-value .
       93           p-ok = true.
       94        end.
       95     end.
       96   end.
       97   procedure placelib_get-attr:
       98   define input  parameter  p-code     like ub.place-attr.attr-code .
       99   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      100   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      101   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      102   define output parameter  p-value    like ub.place-attr.attr-value .
      103   define output parameter  p-ok       as logical.
      104   define buffer buf_place-attr for ub.place-attr .
      105     do on error undo, return error return-value :
      106        p-ok = false.
      107        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      108                                                   and buf_place-attr.obj-code    = p-obj-code
      109                                                   and buf_place-attr.obj-type    = p-obj-type
      110                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      111        if available buf_place-attr then do :
      112          p-value = buf_place-attr.attr-value.
      113          p-ok = true.
      114        end.
      115        else do :
      116          p-ok = false.
      117        end.
      118     end.
      119   end.
      120   procedure placelib_del-attr:
      121   define input parameter  p-code     like ub.place-attr.attr-code .
      122   define input parameter  p-obj-code like ub.place-attr.obj-code .
      123   define input parameter  p-obj-type like ub.place-attr.obj-type .
      124   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      125   define input parameter  p-value    like ub.place-attr.attr-value .
      126   define output parameter p-ok       as logical.
      127   define buffer buf_place-attr for ub.place-attr .
      128     do on error undo, return error return-value :
      129        p-ok = false.
      130        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      131                                                   and buf_place-attr.obj-code    = p-obj-code
      132                                                   and buf_place-attr.obj-type    = p-obj-type
      133                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      134        if available buf_place-attr then do :
      135           delete buf_place-attr.
      136           p-ok = true.
      137        end.
      138     end.
      139   end.
      140   define input  parameter p-obj-type as character   no-undo .
      141   define input  parameter p-obj-code as integer   no-undo .
      142   define input  parameter p-pl-code as integer   no-undo .
      143   define input  parameter p-attr-code as character no-undo .
      144   define input  parameter p-attr-value as character no-undo .
      145   define buffer buf_place for ub.place .
      146   define buffer buf_place-attr for ub.place-attr .
      147   on write of ub.place-attr override do:  end.
      148   find first buf_place no-lock where buf_place.obj-type = p-obj-type
      149                                  and buf_place.obj-code = p-obj-code
      150                                  and buf_place.pl-code  = p-pl-code
      151                                  no-error .
      152   if available buf_place
      153   then do transaction :
      154     find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-attr-code
      155                                                and buf_place-attr.obj-code    = buf_place.obj-code
      156                                                and buf_place-attr.obj-type    = buf_place.obj-type
      157                                                and buf_place-attr.pl-code     = buf_place.pl-code
      158                                                no-error .
      159     if not available buf_place-attr
      160     then do :
      161       create buf_place-attr .
      162       assign
      163         buf_place-attr.attr-code   = p-attr-code
      164         buf_place-attr.obj-code    = buf_place.obj-code
      165         buf_place-attr.obj-type    = buf_place.obj-type
      166         buf_place-attr.pl-code     = buf_place.pl-code
      167       .
      168     end .
      169     assign
      170       buf_place-attr.attr-value = p-attr-value
      171     .
      172   end .
