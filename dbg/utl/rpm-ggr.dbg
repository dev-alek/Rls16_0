     1182   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   define  stream PrnLibStream.
     1184   procedure prn-lib-prn-file :
     1185     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1186     define input parameter p-DIsabledoptions as integer no-undo .
     1187     define variable v-report-name as character no-undo .
     1188     define variable v-user-action as character no-undo .
     1189     define variable v-printed     as logical   no-undo .
     1190     define variable v-exist       as logical   no-undo .
     1191     do
     1192       on error undo, return error
     1193       :
     1194       run prn-lib-get-report-name  in this-procedure (
     1195         input parParentProc
     1196         ,output v-report-name
     1197         ).
     1198   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1200     (input  v-report-name
     1201     ,input  2
     1202     ,output v-exist
     1203     )  .
     1204       if NOT v-exist then
     1205       DO:
     1206         Message
     1207           "Нет заданий на печать ! "
     1208           view-as alert-box .
     1209         Return  .
     1210       End.
     1211       run gbl/prnfilen.w
     1212         (input  ""
     1213         ,input  p-DisabledOptions
     1214         ,input  string(v-report-name )
     1215         ,input  7
     1216         ,output v-user-action
     1217         ,output v-printed
     1218         ) .
     1219       if v-printed then
     1220       do:
     1221         return "YES" .
     1222       end.
     1223       else
     1224       do:
     1225         return "NO" .
     1226       end.
     1227     end.
     1228   end procedure.
     1229   procedure prn-lib-open-stream :
     1230     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1231     define input parameter p-page-size    as integer no-undo .
     1232     define input parameter p-is-stream    as logical no-undo .
     1233     define input parameter p-append       as logical no-undo .
     1234     define variable v-report-name as character no-undo .
     1235     do
     1236       on error undo, return error
     1237       :
     1238       run prn-lib-get-report-name  in this-procedure (
     1239         input parParentProc
     1240         ,output v-report-name
     1241         ).
     1242       if p-is-stream then
     1243       do:
     1244         if p-append then
     1245         do:
     1246           output stream PrnLibStream to value( v-report-name )
     1247             page-size value(p-page-size) append .
     1248         end.
     1249         if not p-append then
     1250         do:
     1251           output stream PrnLibStream to value( v-report-name )
     1252             page-size value(p-page-size) .
     1253         end.
     1254       end.
     1255       if not p-is-stream then
     1256       do:
     1257         if p-append then
     1258         do:
     1259           output to value( v-report-name )
     1260             page-size value(p-page-size) append .
     1261         end.
     1262         if not p-append then
     1263         do:
     1264           output to value( v-report-name )
     1265             page-size value(p-page-size) .
     1266         end.
     1267       end.
     1268     end.
     1269   end procedure.
     1270   procedure prn-lib-open-exp :
     1271     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1272     define input parameter p-is-stream    as logical no-undo .
     1273     define input parameter p-is-append    as logical no-undo .
     1274     define output parameter p-ReportFileName as char init "report" no-undo.
     1275     define output parameter p-process as logical no-undo .
     1276     define variable glog as logical no-undo .
     1277     do
     1278       on error undo, return error
     1279       :
     1280       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1281         TITLE      "Укажите путь"
     1282         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1283         ASK-OVERWRITE
     1284         CREATE-TEST-FILE
     1285         SAVE-AS
     1286         USE-FILENAME
     1287         DEFAULT-EXTENSION "txt"
     1288         UPDATE glog
     1289         .
     1290       if not glog then  return.
     1291       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1292       if p-is-stream then
     1293       do:
     1294         if p-is-append then
     1295         do:
     1296           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1297         end.
     1298         else
     1299         do:
     1300           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1301         end.
     1302       end.
     1303       else
     1304       do:
     1305         if p-is-append then
     1306         do:
     1307           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1308         end.
     1309         else
     1310         do:
     1311           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1312         end.
     1313       end.
     1314       p-process = yes.
     1315     end.
     1316   end procedure.
     1317   procedure prn-lib-get-report-name :
     1318     define input parameter parParentProc  as widget-handle no-undo.
     1319     define output parameter p-report-name as character no-undo .
     1320     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1321   end procedure.
     1322   procedure prn-lib-reportviewer-report-name :
     1323     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1324     define input parameter p-report-name-html as character no-undo .
     1325     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1326   end procedure.
     1327   procedure prn-lib-reportviewer :
     1328     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1329     define input parameter p-report-name-html as character no-undo .
     1330     define input parameter p-param        as character no-undo .
     1331     define variable v-excel           as character no-undo init 'TRUE' .
     1332     define variable v-value-character as character no-undo .
     1333     define variable v-value-integer   as character no-undo .
     1334     define variable v-value-date      as date      no-undo .
     1335     define variable v-value-decimal   as decimal   no-undo .
     1336     define variable rep-excel         as logical   no-undo .
     1337     define variable excel-string      as character no-undo .
     1338     define variable v-param-type      as character no-undo .
     1339     define variable v-tth             as handle    no-undo .
     1340     run adm/shattri.p (
     1341       input "get":U
     1342       ,input  ""
     1343       ,input  0
     1344       ,input  'report-glob':U
     1345       ,input  'rep-excel':U
     1346       ,output v-value-character
     1347       ,output v-value-date
     1348       ,output v-value-decimal
     1349       ,output v-value-integer
     1350       ,output rep-excel
     1351       ,output v-param-type
     1352       ,INPUT-OUTPUT table-handle v-tth
     1353       )  .
     1354     if rep-excel then v-excel = "TRUE" .
     1355     else v-excel = "FALSE" .
     1356     if p-param eq ""
     1357     then
     1358        p-param = "EXCEL:" + v-excel.
     1359     else
     1360        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1361     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1362   end procedure.
     1363   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1364   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1365   procedure fltopend_fltopend :
     1366   define input parameter p-parent-handle as handle no-undo .
     1367   define input parameter p-qh as handle no-undo .
     1368   define input parameter p-flt-open-open-query  as character no-undo .
     1369   define input parameter p-where-cond as character no-undo .
     1370   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1371   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1372   define input parameter p-indexed-reposition as character no-undo .
     1373     do
     1374     on error undo, return error
     1375     :
     1376   define variable v-prepare-string as character no-undo .
     1377   define variable glog as logical no-undo .
     1378   assign
     1379   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1380                      p-where-cond + chr(32)  +
     1381                      p-use-indFIRST-query-tail + chr(32) +
     1382                      p-use-ind-sort-clmn-by + chr(32) +
     1383                      p-indexed-reposition
     1384   .
     1385   assign
     1386   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1387   if not glog
     1388   or error-status:error then do:
     1389     message error-status:get-message(1) view-as alert-box .
     1390     undo, return error .
     1391   end.
     1392   assign
     1393   glog = p-qh:query-open no-error .
     1394   if not glog
     1395   or error-status:error then do:
     1396     message error-status:get-message(1) view-as alert-box .
     1397     undo, return error .
     1398   end.
     1399     end.
     1400   end procedure.
     1401   procedure fltopend_fltfindd :
     1402   define input parameter p-parent-handle as handle no-undo .
     1403   define input parameter p-qh as handle no-undo .
     1404   define input parameter p-rowid as rowid no-undo .
     1405   define input parameter p-next as logical no-undo .
     1406   define input parameter p-lock as integer no-undo .
     1407   define input parameter p-bh as handle no-undo .
     1408   define input parameter p-where-cond as character no-undo .
     1409   define input parameter p-use-index-phrase as character no-undo .
     1410   define variable glog as logical no-undo .
     1411   define variable v-qh as handle no-undo .
     1412   define variable v-bh as handle no-undo .
     1413   define variable v-recid as recid no-undo .
     1414   define variable v-prepare-string as character no-undo .
     1415   do
     1416   on error undo, return error
     1417   on stop undo, return error
     1418   :
     1419     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1420     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1421     create query v-qh.
     1422     v-qh:set-buffers(v-bh).
     1423     v-prepare-string = substitute("for each &1 &2 &3"
     1424                                     ,v-bh:name
     1425                                     ,p-where-cond
     1426                                     ,p-use-index-phrase).
     1427     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1428     if not glog then do:
     1429       delete object v-qh.
     1430       delete object v-bh.
     1431       undo, return error .
     1432     end.
     1433     glog = v-qh:query-open no-error .
     1434     if not glog then do:
     1435       delete object v-qh.
     1436       delete object v-bh.
     1437       undo, return error .
     1438     end.
     1439     if p-next then do:
     1440       v-qh:reposition-to-rowid(p-rowid) no-error .
     1441       glog = v-qh:get-next( p-lock) no-error .
     1442       glog = v-qh:get-next( p-lock) no-error .
     1443       if not glog or v-qh:query-off-end = yes then do:
     1444         glog = v-qh:get-first( p-lock) no-error .
     1445       end.
     1446     end.
     1447     else do:
     1448       glog = v-qh:get-first( p-lock) no-error .
     1449     end.
     1450     v-recid = v-bh:recid no-error .
     1451     delete object v-qh.
     1452     delete object v-bh.
     1453     return string(v-recid) .
     1454   end.
     1455   end procedure.
     1456   procedure fltopend_fltfindq :
     1457   define input parameter p-parent-handle as handle no-undo .
     1458   define input parameter p-qh as handle no-undo .
     1459   define input parameter p-next as logical no-undo .
     1460   define input parameter p-lock as integer no-undo .
     1461   define input parameter p-flt-open-open-query  as character no-undo .
     1462   define input parameter p-where-cond as character no-undo .
     1463   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1464   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1465   define input parameter p-indexed-reposition as character no-undo .
     1466   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1467   define variable glog as logical no-undo .
     1468   define variable v-qh as handle no-undo .
     1469   define variable v-bh as handle no-undo extent 18.
     1470   define variable v-rowid as rowid no-undo extent 18.
     1471   define variable v-ii as integer no-undo .
     1472   define variable v-prepare-string as character no-undo .
     1473   do
     1474   on error undo, return error
     1475   on stop undo, return error
     1476   :
     1477     create query v-qh.
     1478     do v-ii = 1 to p-qh:num-buffers:
     1479       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1480       assign
     1481       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1482       no-error.
     1483       v-qh:add-buffer(v-bh[v-ii]).
     1484     end.
     1485     assign
     1486     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1487                       p-where-cond + chr(32)  +
     1488                       p-use-indFIRST-query-tail + chr(32) +
     1489                       p-use-ind-sort-clmn-by + chr(32) +
     1490                       p-indexed-reposition
     1491     .
     1492     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1493     if not glog then do:
     1494       delete object v-qh.
     1495       do v-ii = 1 to p-qh:num-buffers:
     1496         delete object v-bh[v-ii].
     1497       end.
     1498       undo, return error .
     1499     end.
     1500     glog = v-qh:query-open no-error .
     1501     if not glog then do:
     1502       delete object v-qh.
     1503       do v-ii = 1 to p-qh:num-buffers:
     1504         delete object v-bh[v-ii].
     1505       end.
     1506       undo, return error .
     1507     end.
     1508     if p-next then do:
     1509       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1510       glog = v-qh:get-next( p-lock) no-error .
     1511       glog = v-qh:get-next( p-lock) no-error .
     1512       if not glog or v-qh:query-off-end = yes then do:
     1513         glog = v-qh:get-first( p-lock) no-error .
     1514       end.
     1515     end.
     1516     else do:
     1517       glog = v-qh:get-first( p-lock) no-error .
     1518     end.
     1519     do v-ii = 1 to p-qh:num-buffers:
     1520       assign
     1521       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1522       no-error.
     1523     end.
     1524     delete object v-qh.
     1525     do v-ii = 1 to p-qh:num-buffers:
     1526       delete object v-bh[v-ii].
     1527     end.
     1528   end.
     1529   end procedure.
     1530   define variable sort-column-name as character no-undo.
     1531   define variable filter-point     as character NO-UNDO INIT "rpm-ggr".
     1532   define variable filter-label     as character NO-UNDO INIT "Соответствие групп товаров в TH и RPM".
     1533   define variable filter-point0     as character NO-UNDO INIT "rpm-ggr".
     1534   define variable filter-label0     as character NO-UNDO INIT "Соответствие групп товаров в TH и RPM".
     1535   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1536   define variable v-doc-rec as recid no-undo .
     1537   define variable v-closed as character no-undo .
     1538   define variable v-type as character no-undo .
     1539   define variable v-attr-code as character no-undo .
     1540   FUNCTION get-cli-node-code RETURNS CHARACTER
     1541     ( INPUT p-uniq-key-rec AS character )  FORWARD.
     1542   FUNCTION get-cli-node-name RETURNS CHARACTER
     1543     ( INPUT p-uniq-key-rec AS CHARACTER )  FORWARD.
     1544   DEFINE BUTTON B-Help
     1545        LABEL "Помо&щь"
     1546        SIZE 3 BY 1
     1547        BGCOLOR 8 .
     1548   DEFINE BUTTON B-mark
     1549        LABEL "&*"
     1550        SIZE 3 BY 1.
     1551   DEFINE BUTTON b-print
     1552        LABEL "&Печать"
     1553        SIZE 3 BY 1.
     1554   DEFINE BUTTON b-quit AUTO-END-KEY
     1555        LABEL "&Выход"
     1556        SIZE 10 BY 1
     1557        BGCOLOR 8 .
     1558   DEFINE BUTTON b-sch
     1559        LABEL "Фильтр"
     1560        SIZE 3 BY 1.
     1561   DEFINE BUTTON B-sel AUTO-GO
     1562        LABEL "Вы&бор"
     1563        SIZE 10 BY 1.
     1564   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1565         VIEW-AS TEXT
     1566        SIZE 6 BY 1
     1567        FGCOLOR 4  NO-UNDO.
     1568   DEFINE QUERY br-gds-grp FOR X_ext-classif SCROLLING.
     1569   DEFINE BROWSE br-gds-grp
     1570     QUERY br-gds-grp NO-LOCK DISPLAY
     1571         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1572   entry(2, X_ext-classif.uniq-key-rec, chr(3)) COLUMN-LABEL "Вн.код!группы(TH)" FORMAT "X(9)"
     1573   X_ext-classif.charKEy_one  COLUMN-LABEL "Группа!RPM" FORMAT "X(5)"
     1574   X_ext-classif.KEY#_one  COLUMN-LABEL "Отдел!RPM" FORMAT ">>>>>>>>9"
     1575   X_ext-classif.KEY#_two  COLUMN-LABEL "Класс!RPM" FORMAT ">>>>>>>>9"
     1576   X_ext-classif.KEY#_three  COLUMN-LABEL "Подкласс!RPM" FORMAT ">>>>>>>>9"
     1577   X_ext-classif.charkey_two COLUMN-LABEL "Название группы" FORMAT "X(255)"
     1578       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 19.4 FIT-LAST-COLUMN.
     1579   DEFINE FRAME Dialog-Frame
     1580        b-quit AT ROW 1 COL 1
     1581        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1582        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1583        b-sch AT ROW 1 COL 89 WIDGET-ID 12
     1584        b-print AT ROW 1 COL 92 WIDGET-ID 10
     1585        B-Help AT ROW 1 COL 95
     1586        br-gds-grp AT ROW 2.87 COL 1 WIDGET-ID 100
     1587        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1588        SPACE(79.30) SKIP(21.26)
     1589       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1590            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1591            TITLE ""
     1592            CANCEL-BUTTON b-quit.
     1593   ASSIGN
     1594          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1595          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1596   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1597   DO:
     1598     APPLY "END-ERROR":U TO SELF.
     1599   END.
     1600   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1601   DO:
     1602     define variable loc#log as logical no-undo .
     1603     if available X_ext-classif then do:
     1604   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1605   define variable v-str-recid14 as character no-undo .
     1606   define variable v-num-entry14 as integer   no-undo .
     1607   assign
     1608     v-str-recid14 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1609     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1610   .
     1611   if v-num-entry14 > 0 then do:
     1612     assign
     1613       entry( v-num-entry14, v-rid-list ) = "":U
     1614       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1615     .
     1616   end.
     1617   else do:
     1618     assign
     1619       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1620     .
     1621   end.
     1622       loc#log = br-gds-grp:refresh() .
     1623       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1624           loc#log = br-gds-grp:select-next-row ().
     1625           apply "VALUE-CHANGED" to br-gds-grp in frame Dialog-Frame.
     1626       end.
     1627       if num-entries( v-rid-list ) = 0
     1628       then
     1629           hide mark-num in frame Dialog-Frame.
     1630       else
     1631           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1632     end.
     1633     apply "entry" to br-gds-grp in frame Dialog-Frame.
     1634   END.
     1635   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1636   DO:
     1637     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1638     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1639   END.
     1640   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1641   DO:
     1642     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1643     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1644   END.
     1645   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1646   DO:
     1647       if ( available X_ext-classif ) then do:
     1648       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1649       then
     1650       v-rid-list = string( recid( X_ext-classif ) ) .
     1651     end.
     1652   END.
     1653   ON VALUE-CHANGED OF br-gds-grp IN FRAME Dialog-Frame
     1654   DO:
     1655     IF AVAILABLE X_ext-classif THEN DO:
     1656     END.
     1657   END.
     1658   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1659   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1660   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   on help of frame Dialog-Frame
     1662   do:
     1663     run gbl/app_help.p
     1664       (input this-procedure :file-name
     1665       ,input ''
     1666       ,input ?
     1667       ) no-error.
     1668     if error-status :error then do:
     1669       message
     1670         "Ошибка при вызове помощи"
     1671         error-status :get-message(1)
     1672         view-as alert-box .
     1673     end.
     1674   end.
     1675   run minbtn-set in this-procedure .
     1676   on choose of b-help in frame Dialog-Frame
     1677   do:
     1678     apply "help":u to frame Dialog-Frame .
     1679   end.
     1680   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   procedure minbtn-set :
     1682       do
     1683           on error undo, return error return-value
     1684           :
     1685           define variable ii              as integer       no-undo .
     1686           define variable fh              as widget-handle no-undo .
     1687           define variable hh              as widget-handle no-undo .
     1688           define variable v-h             as handle        extent 4 no-undo .
     1689           define variable v-name-button   as character     no-undo .
     1690           define variable v-help-old-x    as decimal       no-undo .
     1691           define variable v-help-old-y    as decimal       no-undo .
     1692           define variable v-help-old-size as decimal       no-undo .
     1693           define variable v-frame-width   as decimal       no-undo .
     1694           define variable jj              as integer       no-undo .
     1695           do
     1696               on error undo, return error
     1697               :
     1698               assign
     1699                   v-frame-width = frame Dialog-Frame:width - 0.3
     1700                   fh            = frame Dialog-Frame:first-child
     1701                   hh            = fh:first-child
     1702                   ii            = 1
     1703                   .
     1704               do while valid-handle(hh):
     1705                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1706                   do:
     1707                       case lc(hh:name) :
     1708                           when "b-help" then
     1709                               do:
     1710                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1711                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1712                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1713                                   hh:TOOLTIP = "Помощь" .
     1714                                   v-help-old-x = hh:column .
     1715                                   v-help-old-y = hh:row    .
     1716                                   v-help-old-size = hh:width .
     1717                                   hh:width-chars = 2.5 .
     1718                               end.
     1719                           when "b-print" then
     1720                               do:
     1721                                   hh:load-image("cmp/b-print.bmp":u) .
     1722                                   hh:TOOLTIP = "Печать" .
     1723                                   v-h[ii] = hh:handle .
     1724                                   ii = ii + 1 .
     1725                                   hh:width-chars = 3 .
     1726                               end.
     1727                           when "b-history" or
     1728                           when "b-hist" then
     1729                               do:
     1730                                   hh:load-image("cmp/b-hist.bmp":u) .
     1731                                   hh:TOOLTIP = "История" .
     1732                                   v-h[ii] = hh:handle .
     1733                                   ii = ii + 1 .
     1734                                   hh:width-chars = 3 .
     1735                               end.
     1736                           when "b-sch" then
     1737                               do:
     1738                                   hh:load-image("cmp/b-sch.bmp":u) .
     1739                                   hh:TOOLTIP = "Установка Фильтра" .
     1740                                   v-h[ii] = hh:handle .
     1741                                   ii = ii + 1 .
     1742                                   hh:width-chars = 3 .
     1743                               end.
     1744                           when "b-hist-user" then
     1745                               do:
     1746                                   hh:load-image("cmp/b-hist.bmp":u) .
     1747                                   hh:TOOLTIP = "История пользователя" .
     1748                                   ii = ii + 1 .
     1749                               end.
     1750                       end case.
     1751                   end.
     1752                   hh = hh:next-sibling.
     1753               end.
     1754               b-help:column = v-frame-width - b-help:width-chars.
     1755               jj = 0.
     1756               repeat ii = 4 to 1 by -1 :
     1757                   if valid-handle (v-h[ii] ) then
     1758                   do:
     1759                       jj  = jj + 1 .
     1760                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1761                       v-h[ii]:row    = v-help-old-y .
     1762                   end.
     1763               end.
     1764           end.
     1765       end.
     1766   end procedure.
     1767   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1768   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1769   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1770   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1771   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1772   define variable v-diasize-current-frame-height as decimal   no-undo .
     1773   define variable v-diasize-change-size          as logical   no-undo .
     1774   define variable v-diasize-resize-button        as handle    no-undo .
     1775   define variable v-diasize-wndmax               as logical   no-undo .
     1776   define variable v-diasize-wndstore             as logical   no-undo .
     1777   define variable v-diasize-proc-name            as character no-undo .
     1778   define variable v-diasize-browse-handle        as handle    no-undo .
     1779   define variable v-diasize-browse-number        as integer   no-undo .
     1780   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1781   define temp-table temp-diasize-handle no-undo
     1782     field handle-value  as handle
     1783     field save-position as decimal
     1784     index xpk is primary unique handle-value
     1785     .
     1786   define temp-table temp-browse-handle no-undo
     1787     field browse-type   as character
     1788     field browse-number as integer
     1789     field browse-handle as handle
     1790     field original-size as decimal
     1791     index xpk is primary unique browse-type browse-number
     1792     index xie browse-type browse-handle
     1793   .
     1794   procedure diasize_change-height :
     1795     define input  parameter p-change-value  as decimal   no-undo .
     1796     define input  parameter p-move-resize   as logical   no-undo .
     1797     define variable v-field-group-handle    as handle    no-undo .
     1798     define variable v-object-handle         as handle    no-undo .
     1799     define variable v-frame-height          as decimal   no-undo .
     1800     define variable v-frame-virtual-height  as decimal   no-undo .
     1801     define variable v-browse-height         as decimal   no-undo .
     1802     define variable v-window-height         as decimal   no-undo .
     1803     define variable v-window-virtual-height as decimal   no-undo .
     1804     define variable v-change-sign           as integer   no-undo .
     1805     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1806     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1807     if p-change-value > 0
     1808     then do:
     1809       if frame Dialog-Frame :height + p-change-value
     1810           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1811       then do:
     1812         assign
     1813           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1814                           - (frame Dialog-Frame :height-chars)
     1815         .
     1816         if p-change-value <= 0
     1817         then do:
     1818           run diasize_position-resize-button in this-procedure .
     1819           return .
     1820         end.
     1821       end.
     1822     end.
     1823     if p-change-value < 0
     1824     then do:
     1825       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1826       then do:
     1827         assign
     1828           p-change-value = v-diasize-orig-frame-height
     1829                          - (frame Dialog-Frame :height-chars)
     1830         .
     1831         if p-change-value >= 0
     1832         then do:
     1833           run diasize_position-resize-button in this-procedure .
     1834           return .
     1835         end.
     1836       end.
     1837     end.
     1838     if p-change-value >= 0
     1839     then do:
     1840       assign
     1841         v-change-sign = 1
     1842       .
     1843     end.
     1844     else do:
     1845       assign
     1846         v-change-sign = -1
     1847       .
     1848     end.
     1849     assign
     1850       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1851     .
     1852     if p-change-value = 0
     1853     then do:
     1854       run diasize_position-resize-button in this-procedure .
     1855       return .
     1856     end.
     1857     move_block:
     1858     do
     1859     on error undo move_block, retry move_block
     1860     :
     1861       if retry
     1862       then do:
     1863         do
     1864         on error undo move_block, leave move_block
     1865         :
     1866           if p-change-value > 0
     1867           then do:
     1868             for each buf_temp-diasize-handle
     1869             on error undo, next
     1870             :
     1871               assign
     1872                 v-object-handle = buf_temp-diasize-handle.handle-value
     1873               .
     1874               if v-object-handle <> v-diasize-resize-button
     1875               then do:
     1876                 assign
     1877                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1878                 .
     1879               end.
     1880             end.
     1881             assign
     1882               v-diasize-browse-handle :height = v-browse-height
     1883             .
     1884             for each buf_temp-browse-handle
     1885               where buf_temp-browse-handle.browse-type = 'height':u
     1886             on error undo, next
     1887             :
     1888               assign
     1889                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1890               .
     1891             end.
     1892             assign
     1893               frame Dialog-Frame :height = v-frame-height
     1894             .
     1895             if frame Dialog-Frame :scrollable = true
     1896             then do:
     1897               assign
     1898                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1899               .
     1900             end.
     1901             run diasize_position-resize-button in this-procedure .
     1902           end.
     1903           else do:
     1904             if frame Dialog-Frame :scrollable = true
     1905             then do:
     1906               assign
     1907                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1908               .
     1909             end.
     1910             assign
     1911               frame Dialog-Frame :height = v-frame-height
     1912             .
     1913             assign
     1914               v-diasize-browse-handle :height = v-browse-height
     1915             .
     1916             for each buf_temp-browse-handle
     1917               where buf_temp-browse-handle.browse-type = 'height':u
     1918             on error undo, next
     1919             :
     1920               assign
     1921                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1922               .
     1923             end.
     1924             for each buf_temp-diasize-handle
     1925             on error undo, next
     1926             :
     1927               assign
     1928                 v-object-handle = buf_temp-diasize-handle.handle-value
     1929               .
     1930               if v-object-handle <> v-diasize-resize-button
     1931               then do:
     1932                 assign
     1933                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1934                 .
     1935               end.
     1936             end.
     1937             run diasize_position-resize-button in this-procedure .
     1938           end.
     1939           assign
     1940             v-diasize-change-size = false
     1941           .
     1942           leave move_block .
     1943         end.
     1944       end.
     1945       assign
     1946         v-diasize-need-full-display = true
     1947       .
     1948       if v-diasize-change-size = false
     1949       then do:
     1950         assign
     1951           v-diasize-change-size = true
     1952         .
     1953       end.
     1954       else do:
     1955         return .
     1956       end.
     1957       assign
     1958         v-frame-height = frame Dialog-Frame :height
     1959         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1960         v-browse-height = v-diasize-browse-handle :height
     1961       .
     1962       for each buf_temp-browse-handle
     1963         where buf_temp-browse-handle.browse-type = 'height':u
     1964       :
     1965         assign
     1966           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1967         .
     1968       end.
     1969       for each buf_temp-diasize-handle
     1970       :
     1971         delete buf_temp-diasize-handle .
     1972       end.
     1973       assign
     1974         v-field-group-handle = frame Dialog-Frame :first-child
     1975       .
     1976       do while valid-handle(v-field-group-handle)
     1977       :
     1978         assign
     1979           v-object-handle = v-field-group-handle :first-child
     1980         .
     1981         do while valid-handle(v-object-handle)
     1982         :
     1983           if  v-object-handle <> v-diasize-browse-handle :handle
     1984           and can-query(v-object-handle, "row")
     1985           and can-query(v-object-handle, "height")
     1986           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1987           then do:
     1988             find first buf_temp-browse-handle
     1989               where buf_temp-browse-handle.browse-type   = 'height':u
     1990                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1991               no-error .
     1992             if available buf_temp-browse-handle
     1993             then do:
     1994             end.
     1995             else do:
     1996               create buf_temp-diasize-handle .
     1997               assign
     1998                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1999                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2000               .
     2001             end.
     2002           end.
     2003           assign
     2004             v-object-handle = v-object-handle :next-sibling
     2005           .
     2006         end.
     2007         assign
     2008           v-field-group-handle = v-field-group-handle :next-sibling
     2009         .
     2010       end.
     2011       do with frame Dialog-Frame
     2012       :
     2013         hide v-diasize-resize-button .
     2014         assign
     2015           v-diasize-resize-button :row    = 1
     2016           v-diasize-resize-button :column = 1
     2017         .
     2018       end.
     2019       if p-change-value > 0
     2020       then do:
     2021         if frame Dialog-Frame :scrollable = true
     2022         then do:
     2023           assign
     2024             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2025             no-error .
     2026           if error-status :error
     2027           or error-status :get-message(1) <> ""
     2028           then do:
     2029             undo move_block, retry move_block .
     2030           end.
     2031         end.
     2032         assign
     2033           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2034           no-error .
     2035         if error-status :error
     2036         or error-status :get-message(1) <> ""
     2037         then do:
     2038           undo move_block, retry move_block .
     2039         end.
     2040         assign
     2041           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2042           no-error .
     2043         if error-status :error
     2044         or error-status :get-message(1) <> ""
     2045         then do:
     2046           undo move_block, retry move_block .
     2047         end.
     2048         for each buf_temp-browse-handle
     2049           where buf_temp-browse-handle.browse-type = 'height':u
     2050         on error undo move_block, retry move_block
     2051         :
     2052           assign
     2053             buf_temp-browse-handle.browse-handle :height
     2054               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2055             no-error .
     2056           if error-status :error
     2057           or error-status :get-message(1) <> ""
     2058           then do:
     2059             undo move_block, retry move_block .
     2060           end.
     2061         end.
     2062         for each buf_temp-diasize-handle
     2063         on error undo move_block, retry move_block
     2064         :
     2065           assign
     2066             v-object-handle = buf_temp-diasize-handle.handle-value
     2067           .
     2068           if v-object-handle <> v-diasize-resize-button
     2069           then do:
     2070             assign
     2071               v-object-handle :row = v-object-handle :row + p-change-value
     2072               no-error .
     2073             if error-status :error
     2074             or error-status :get-message(1) <> ""
     2075             then do:
     2076               undo move_block, retry move_block .
     2077             end.
     2078           end.
     2079         end.
     2080       end.
     2081       else do:
     2082         for each buf_temp-diasize-handle
     2083         on error undo move_block, retry move_block
     2084         :
     2085           assign
     2086             v-object-handle = buf_temp-diasize-handle.handle-value
     2087           .
     2088           if v-object-handle <> v-diasize-resize-button
     2089           then do:
     2090             assign
     2091               v-object-handle :row = v-object-handle :row + p-change-value
     2092               no-error .
     2093             if error-status :error
     2094             or error-status :get-message(1) <> ""
     2095             then do:
     2096               undo move_block, retry move_block .
     2097             end.
     2098           end.
     2099         end.
     2100         assign
     2101           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2102           no-error .
     2103         if error-status :error
     2104         or error-status :get-message(1) <> ""
     2105         then do:
     2106           undo move_block, retry move_block .
     2107         end.
     2108         for each buf_temp-browse-handle
     2109           where buf_temp-browse-handle.browse-type = 'height':u
     2110         on error undo move_block, retry move_block
     2111         :
     2112           assign
     2113             buf_temp-browse-handle.browse-handle :height
     2114               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2115             no-error .
     2116           if error-status :error
     2117           or error-status :get-message(1) <> ""
     2118           then do:
     2119             undo move_block, retry move_block .
     2120           end.
     2121         end.
     2122         assign
     2123           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2124           no-error .
     2125         if error-status :error
     2126         or error-status :get-message(1) <> ""
     2127         then do:
     2128           undo move_block, retry move_block .
     2129         end.
     2130         if frame Dialog-Frame :scrollable = true
     2131         then do:
     2132           assign
     2133             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2134             no-error .
     2135           if error-status :error
     2136           or error-status :get-message(1) <> ""
     2137           then do:
     2138             undo move_block, retry move_block .
     2139           end.
     2140         end.
     2141       end.
     2142       if p-move-resize = true
     2143       then do:
     2144         run diasize_position-resize-button in this-procedure .
     2145       end.
     2146       if v-diasize-wndstore = true
     2147       then do:
     2148         if connected("ub") = true
     2149         then do:
     2150           define variable v-cntxt-db-num        as integer   no-undo .
     2151           define variable v-cntxt-userid        as character no-undo .
     2152           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2153                                             , OUTPUT v-cntxt-userid
     2154                                             ) .
     2155           run gbl/wndsizew.p
     2156             (input  v-cntxt-db-num
     2157             ,input  v-cntxt-userid
     2158             ,input  v-diasize-proc-name
     2159             ,input  'height':u
     2160             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2161             ) .
     2162         end.
     2163       end.
     2164     end.
     2165     assign
     2166       v-diasize-change-size = false
     2167     .
     2168   end procedure.
     2169   procedure diasize_set-height :
     2170     define input  parameter p-new-height  as decimal   no-undo .
     2171     define input  parameter p-move-resize as logical   no-undo .
     2172     do
     2173     on error undo, return error return-value
     2174     :
     2175       run diasize_change-height in this-procedure
     2176         (input  (p-new-height - frame Dialog-Frame :height)
     2177         ,input  p-move-resize
     2178         ) .
     2179     end.
     2180   end procedure.
     2181   procedure diasize_change-width :
     2182     define input  parameter p-change-value as decimal   no-undo .
     2183     define input  parameter p-move-resize  as logical   no-undo .
     2184     define variable v-field-group-handle   as handle    no-undo .
     2185     define variable v-object-handle        as handle    no-undo .
     2186     define variable v-frame-width          as decimal   no-undo .
     2187     define variable v-frame-virtual-width  as decimal   no-undo .
     2188     define variable v-browse-width         as decimal   no-undo .
     2189     define variable v-window-width         as decimal   no-undo .
     2190     define variable v-window-virtual-width as decimal   no-undo .
     2191     define variable v-change-sign          as integer   no-undo .
     2192     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2193     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2194     if p-change-value > 0
     2195     then do:
     2196       if frame Dialog-Frame :width + p-change-value >
     2197           session :width-chars
     2198       then do:
     2199         assign
     2200           p-change-value = session :width-chars - frame Dialog-Frame :width
     2201         .
     2202         if p-change-value <= 0
     2203         then do:
     2204           run diasize_position-resize-button in this-procedure .
     2205           return .
     2206         end.
     2207       end.
     2208     end.
     2209     if p-change-value < 0
     2210     then do:
     2211       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2212       then do:
     2213         assign
     2214           p-change-value = v-diasize-orig-frame-width
     2215                          - frame Dialog-Frame :width
     2216         .
     2217         if p-change-value >= 0
     2218         then do:
     2219           run diasize_position-resize-button in this-procedure .
     2220           return .
     2221         end.
     2222       end.
     2223     end.
     2224     if p-change-value >= 0
     2225     then do:
     2226       assign
     2227         v-change-sign = 1
     2228       .
     2229     end.
     2230     else do:
     2231       assign
     2232         v-change-sign = -1
     2233       .
     2234     end.
     2235     assign
     2236       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2237     .
     2238     if p-change-value = 0
     2239     then do:
     2240       run diasize_position-resize-button in this-procedure .
     2241       return .
     2242     end.
     2243     move_block:
     2244     do
     2245     on error undo move_block, leave move_block
     2246     :
     2247       if retry
     2248       then do:
     2249         do
     2250         on error undo move_block, leave move_block
     2251         :
     2252           if p-change-value > 0
     2253           then do:
     2254             for each buf_temp-diasize-handle
     2255             on error undo, next
     2256             :
     2257               assign
     2258                 v-object-handle = buf_temp-diasize-handle.handle-value
     2259               .
     2260               if v-object-handle <> v-diasize-resize-button
     2261               then do:
     2262                 assign
     2263                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2264                 .
     2265               end.
     2266             end.
     2267             assign
     2268               v-diasize-browse-handle :width = v-browse-width
     2269             .
     2270             for each buf_temp-browse-handle
     2271               where buf_temp-browse-handle.browse-type = 'width':u
     2272             on error undo, next
     2273             :
     2274               assign
     2275                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2276               .
     2277             end.
     2278             assign
     2279               frame Dialog-Frame :width = v-frame-width
     2280             .
     2281             if frame Dialog-Frame :scrollable = true
     2282             then do:
     2283               assign
     2284                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2285               .
     2286             end.
     2287             run diasize_position-resize-button in this-procedure .
     2288           end.
     2289           else do:
     2290             if frame Dialog-Frame :scrollable = true
     2291             then do:
     2292               assign
     2293                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2294               .
     2295             end.
     2296             assign
     2297               frame Dialog-Frame :width = v-frame-width
     2298             .
     2299             for each buf_temp-browse-handle
     2300               where buf_temp-browse-handle.browse-type = 'width':u
     2301             on error undo, next
     2302             :
     2303               assign
     2304                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2305               .
     2306             end.
     2307             assign
     2308               v-diasize-browse-handle :width = v-browse-width
     2309             .
     2310             for each buf_temp-diasize-handle
     2311             on error undo, next
     2312             :
     2313               assign
     2314                 v-object-handle = buf_temp-diasize-handle.handle-value
     2315               .
     2316               if v-object-handle <> v-diasize-resize-button
     2317               then do:
     2318                 assign
     2319                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2320                 .
     2321               end.
     2322             end.
     2323             run diasize_position-resize-button in this-procedure .
     2324           end.
     2325           assign
     2326             v-diasize-change-size = false
     2327           .
     2328           leave move_block .
     2329         end.
     2330       end.
     2331       assign
     2332         v-diasize-need-full-display = true
     2333       .
     2334       if v-diasize-change-size = false
     2335       then do:
     2336         assign
     2337           v-diasize-change-size = true
     2338         .
     2339       end.
     2340       else do:
     2341         return .
     2342       end.
     2343       assign
     2344         v-frame-width = frame Dialog-Frame :width
     2345         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2346         v-browse-width = v-diasize-browse-handle :width
     2347       .
     2348       for each buf_temp-browse-handle
     2349         where buf_temp-browse-handle.browse-type = 'width':u
     2350       :
     2351         assign
     2352           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2353         .
     2354       end.
     2355       for each buf_temp-diasize-handle
     2356       :
     2357         delete buf_temp-diasize-handle .
     2358       end.
     2359       assign
     2360         v-field-group-handle = frame Dialog-Frame :first-child
     2361       .
     2362       do while valid-handle(v-field-group-handle)
     2363       :
     2364         assign
     2365           v-object-handle = v-field-group-handle :first-child
     2366         .
     2367         do while valid-handle(v-object-handle)
     2368         :
     2369           if  v-object-handle <> v-diasize-browse-handle :handle
     2370           and v-object-handle <> v-diasize-resize-button
     2371           and can-query(v-object-handle, "row")
     2372           and can-query(v-object-handle, "height")
     2373           and ( v-object-handle :col + v-object-handle :width
     2374                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2375               )
     2376           then do:
     2377             find first buf_temp-browse-handle
     2378               where buf_temp-browse-handle.browse-type   = 'width':u
     2379                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2380               no-error .
     2381             if available buf_temp-browse-handle
     2382             then do:
     2383             end.
     2384             else do:
     2385               create buf_temp-diasize-handle .
     2386               assign
     2387                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2388                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2389               .
     2390             end.
     2391           end.
     2392           assign
     2393             v-object-handle = v-object-handle :next-sibling
     2394           .
     2395         end.
     2396         assign
     2397           v-field-group-handle = v-field-group-handle :next-sibling
     2398         .
     2399       end.
     2400       do with frame Dialog-Frame
     2401       :
     2402         hide v-diasize-resize-button .
     2403         v-diasize-resize-button :row = 1.
     2404         v-diasize-resize-button :column = 1.
     2405       end.
     2406       if p-change-value > 0
     2407       then do:
     2408         if frame Dialog-Frame :scrollable = true
     2409         then do:
     2410           assign
     2411             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2412             no-error .
     2413           if error-status :error
     2414           or error-status :get-message(1) <> ""
     2415           then do:
     2416             undo move_block, retry move_block.
     2417           end.
     2418         end.
     2419         assign
     2420           frame Dialog-Frame :width = v-frame-width + p-change-value
     2421           no-error .
     2422         if error-status :error
     2423         or error-status :get-message(1) <> ""
     2424         then do:
     2425           undo move_block, retry move_block.
     2426         end.
     2427         assign
     2428           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2429         no-error .
     2430         if error-status :error
     2431         or error-status :get-message(1) <> ""
     2432         then do:
     2433           undo move_block, retry move_block.
     2434         end.
     2435         for each buf_temp-browse-handle
     2436           where buf_temp-browse-handle.browse-type = 'width':u
     2437         on error undo move_block, retry move_block
     2438         :
     2439           assign
     2440             buf_temp-browse-handle.browse-handle :width
     2441               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2442             no-error .
     2443           if error-status :error
     2444           or error-status :get-message(1) <> ""
     2445           then do:
     2446             undo move_block, retry move_block .
     2447           end.
     2448         end.
     2449         for each buf_temp-diasize-handle
     2450         on error undo move_block, retry move_block
     2451         :
     2452           assign
     2453             v-object-handle = buf_temp-diasize-handle.handle-value
     2454           .
     2455           if v-object-handle <> v-diasize-resize-button
     2456           then do:
     2457             assign
     2458               v-object-handle :col = v-object-handle :col + p-change-value
     2459               no-error .
     2460             if error-status :error
     2461             or error-status :get-message(1) <> ""
     2462             then do:
     2463               undo move_block, retry move_block .
     2464             end.
     2465           end.
     2466         end.
     2467       end.
     2468       else do:
     2469         for each buf_temp-diasize-handle
     2470         on error undo move_block, retry move_block
     2471         :
     2472           assign
     2473             v-object-handle = buf_temp-diasize-handle.handle-value
     2474           .
     2475           if v-object-handle <> v-diasize-resize-button
     2476           then do:
     2477             assign
     2478               v-object-handle :col = v-object-handle :col + p-change-value
     2479               no-error .
     2480             if error-status :error
     2481             or error-status :get-message(1) <> ""
     2482             then do:
     2483               undo move_block, retry move_block .
     2484             end.
     2485           end.
     2486         end.
     2487         for each buf_temp-browse-handle
     2488           where buf_temp-browse-handle.browse-type = 'width':u
     2489         on error undo move_block, retry move_block
     2490         :
     2491           assign
     2492             buf_temp-browse-handle.browse-handle :width
     2493               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2494             no-error .
     2495           if error-status :error
     2496           or error-status :get-message(1) <> ""
     2497           then do:
     2498             undo move_block, retry move_block .
     2499           end.
     2500         end.
     2501         assign
     2502           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2503           no-error .
     2504         if error-status :error
     2505         or error-status :get-message(1) <> ""
     2506         then do:
     2507           undo move_block, retry move_block.
     2508         end.
     2509         assign
     2510           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2511         no-error .
     2512         if error-status :error
     2513         or error-status :get-message(1) <> ""
     2514         then do:
     2515           undo move_block, retry move_block.
     2516         end.
     2517         if frame Dialog-Frame :scrollable = true
     2518         then do:
     2519           assign
     2520             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2521           no-error .
     2522           if error-status :error
     2523           or error-status :get-message(1) <> ""
     2524           then do:
     2525             undo move_block, retry move_block.
     2526           end.
     2527         end.
     2528       end.
     2529       if p-move-resize
     2530       then do:
     2531         run diasize_position-resize-button in this-procedure .
     2532       end.
     2533       if v-diasize-wndstore = true
     2534       then do:
     2535         if connected("ub") = true
     2536         then do:
     2537           define variable v-cntxt-db-num        as integer   no-undo .
     2538           define variable v-cntxt-userid        as character no-undo .
     2539           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2540                                             , OUTPUT v-cntxt-userid
     2541                                             ) .
     2542           run gbl/wndsizew.p
     2543             (input  v-cntxt-db-num
     2544             ,input  v-cntxt-userid
     2545             ,input  v-diasize-proc-name
     2546             ,input  'width':u
     2547             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2548             ) .
     2549         end.
     2550       end.
     2551     end.
     2552     assign
     2553       v-diasize-change-size = false
     2554     .
     2555   end procedure.
     2556   procedure diasize_set-width :
     2557     define input  parameter p-new-width  as decimal   no-undo .
     2558     define input  parameter p-move-resize as logical   no-undo .
     2559     do
     2560     on error undo, return error return-value
     2561     :
     2562       run diasize_change-width in this-procedure
     2563         (input  (p-new-width - frame Dialog-Frame :width)
     2564         ,input  p-move-resize
     2565         ) .
     2566     end.
     2567   end procedure.
     2568   procedure diasize_position-resize-button :
     2569     do with frame Dialog-Frame
     2570     :
     2571       hide v-diasize-resize-button .
     2572       assign
     2573         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2574                     - 1
     2575                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2576         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2577                     - 1
     2578                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2579       .
     2580       view v-diasize-resize-button .
     2581     end.
     2582   end procedure.
     2583   on alt-right anywhere
     2584   do:
     2585     run diasize_change-width in this-procedure
     2586       (input 1
     2587       ,input true
     2588       ) .
     2589     return no-apply .
     2590   end.
     2591   on alt-left anywhere
     2592   do:
     2593     run diasize_change-width in this-procedure
     2594       (input -1
     2595       ,input true
     2596       ) .
     2597     return no-apply .
     2598   end.
     2599   on alt-down anywhere
     2600   do:
     2601     run diasize_change-height in this-procedure
     2602       (input 1
     2603       ,input true
     2604       ) .
     2605     return no-apply .
     2606   end.
     2607   on alt-up anywhere
     2608   do:
     2609     run diasize_change-height in this-procedure
     2610       (input -1
     2611       ,input true
     2612       ) .
     2613     return no-apply .
     2614   end.
     2615   on alt-enter of frame Dialog-Frame
     2616   do:
     2617     run diasize_maximize in this-procedure
     2618       (input  ?
     2619       ).
     2620     return no-apply .
     2621   end.
     2622   procedure diasize_end-move :
     2623     do
     2624     on error undo, return error return-value
     2625     :
     2626       define variable v-row-delta as decimal   no-undo .
     2627       define variable v-col-delta as decimal   no-undo .
     2628       define variable v-new-row as decimal   no-undo .
     2629       define variable v-new-col as decimal   no-undo .
     2630       assign
     2631         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2632         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2633       .
     2634       assign
     2635         v-row-delta = v-new-row - frame Dialog-Frame :height
     2636         v-col-delta = v-new-col - frame Dialog-Frame :width
     2637       .
     2638       run diasize_change-height in this-procedure
     2639         (input v-row-delta
     2640         ,input true
     2641         ) .
     2642       run diasize_change-width in this-procedure
     2643         (input v-col-delta
     2644         ,input true
     2645         ) .
     2646     end.
     2647   end procedure.
     2648   procedure diasize_maximize :
     2649     define input  parameter p-action as logical   no-undo .
     2650     do
     2651     on error undo, return error return-value
     2652     :
     2653       if p-action = ?
     2654       then do:
     2655         if v-diasize-need-maximize = true
     2656         then do:
     2657           assign
     2658             p-action = true
     2659           .
     2660         end.
     2661         else do:
     2662           assign
     2663             p-action = false
     2664           .
     2665         end.
     2666       end.
     2667       if p-action = true
     2668       then do:
     2669         run diasize_change-height in this-procedure
     2670           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2671               - frame Dialog-Frame :height-chars
     2672           ,input true
     2673           ) .
     2674         run diasize_change-width in this-procedure
     2675           (input session :width-chars
     2676               - frame Dialog-Frame :width-chars
     2677           ,input true
     2678           ) .
     2679         assign
     2680           v-diasize-need-maximize = false
     2681         .
     2682       end.
     2683       else do:
     2684         run diasize_change-width in this-procedure
     2685           (input v-diasize-orig-frame-width
     2686               - frame Dialog-Frame :width-chars
     2687           ,input true
     2688           ) .
     2689         run diasize_change-height in this-procedure
     2690           (input v-diasize-orig-frame-height
     2691               - frame Dialog-Frame :height-chars
     2692           ,input true
     2693           ) .
     2694         assign
     2695           v-diasize-need-maximize = true
     2696         .
     2697       end.
     2698     end.
     2699   end procedure.
     2700   procedure diasize_restore-orig-size :
     2701     do
     2702     on error undo, return error return-value
     2703     :
     2704       assign
     2705         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2706         v-diasize-current-frame-height = frame Dialog-Frame :height
     2707       .
     2708       run diasize_set-height in this-procedure
     2709         (input  v-diasize-orig-frame-height
     2710         ,input  true
     2711         ) .
     2712       run diasize_set-width in this-procedure
     2713         (input  v-diasize-orig-frame-width
     2714         ,input  true
     2715         ) .
     2716     end.
     2717   end procedure.
     2718   procedure diasize_restore-current-size :
     2719     do
     2720     on error undo, return error return-value
     2721     :
     2722       run diasize_set-height in this-procedure
     2723         (input  v-diasize-current-frame-height
     2724         ,input  true
     2725         ) .
     2726       run diasize_set-width in this-procedure
     2727         (input  v-diasize-current-frame-width
     2728         ,input  true
     2729         ) .
     2730     end.
     2731   end procedure.
     2732   procedure diasize_set-browse-handle :
     2733     define input  parameter p-browse-handle as handle   no-undo .
     2734     define buffer buf_temp-browse-handle for temp-browse-handle .
     2735     do
     2736     on error undo, return error return-value
     2737     :
     2738       assign
     2739         v-diasize-browse-handle = p-browse-handle
     2740       .
     2741       for each buf_temp-browse-handle
     2742       on error undo, return error return-value
     2743       :
     2744         delete buf_temp-browse-handle .
     2745       end.
     2746     end.
     2747   end procedure.
     2748   procedure diasize_add_browse :
     2749     define input  parameter p-browse-type   as character no-undo .
     2750     define input  parameter p-browse-handle as handle    no-undo .
     2751     define buffer buf_temp-browse-handle for temp-browse-handle .
     2752     do
     2753     on error undo, return error return-value
     2754     :
     2755       assign
     2756         v-diasize-browse-number = v-diasize-browse-number + 1
     2757       .
     2758       create buf_temp-browse-handle .
     2759       assign
     2760         buf_temp-browse-handle.browse-type   = p-browse-type
     2761         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2762         buf_temp-browse-handle.browse-handle = p-browse-handle
     2763       .
     2764     end.
     2765   end procedure.
     2766   procedure diasize_init :
     2767     define variable v-default-value    as logical   no-undo .
     2768     define variable v-restore-saved    as logical   no-undo .
     2769     define variable v-resize-value-str as character no-undo .
     2770     do
     2771     on error undo, return error return-value
     2772     :
     2773       do with frame Dialog-Frame
     2774       :
     2775         assign
     2776           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2777           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2778           v-diasize-browse-handle     = browse br-gds-grp :handle
     2779         .
     2780         create button v-diasize-resize-button
     2781         assign
     2782           parent        = frame Dialog-Frame :first-child
     2783           label         = "s"
     2784           height-pixels = 16
     2785           width-pixels  = 16
     2786           visible       = true
     2787           sensitive     = true
     2788           movable       = true
     2789           triggers:
     2790             on end-move persistent run diasize_end-move in this-procedure .
     2791           end triggers.
     2792         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2793         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2794         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2795         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2796         assign
     2797           v-diasize-wndmax = false
     2798         .
     2799         if connected("ub") = true
     2800         then do:
     2801           define variable v-cntxt-db-num        as integer   no-undo .
     2802           define variable v-cntxt-userid        as character no-undo .
     2803           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2804                                             , OUTPUT v-cntxt-userid
     2805                                             ) .
     2806           run gbl/wndpar_r.p
     2807             (input  v-cntxt-db-num
     2808             ,input  v-cntxt-userid
     2809             ,input  'wndmax':U
     2810             ,output v-diasize-wndmax
     2811             ,output v-default-value
     2812             ) .
     2813         end.
     2814         assign
     2815           v-diasize-wndstore = false
     2816         .
     2817         if connected("ub") = true
     2818         then do:
     2819           run gbl/wndpar_r.p
     2820             (input  v-cntxt-db-num
     2821             ,input  v-cntxt-userid
     2822             ,input  'wndstore':U
     2823             ,output v-diasize-wndstore
     2824             ,output v-default-value
     2825             ) .
     2826         end.
     2827         assign
     2828           v-diasize-proc-name = entry(1, program-name(2), '.')
     2829         .
     2830         if v-diasize-wndstore = true
     2831         then do:
     2832           assign
     2833             v-restore-saved = false
     2834           .
     2835           if connected("ub") = true
     2836           then do:
     2837             run gbl/wndsizer.p
     2838               (input  v-cntxt-db-num
     2839               ,input  v-cntxt-userid
     2840               ,input  v-diasize-proc-name
     2841               ,input  'height':u
     2842               ,output v-resize-value-str
     2843               ) .
     2844             if v-resize-value-str <> '':U
     2845             then do:
     2846               run diasize_change-height in this-procedure
     2847                 (input  integer(v-resize-value-str)
     2848                 ,input  true
     2849                 ) .
     2850               assign
     2851                 v-restore-saved = true
     2852               .
     2853             end.
     2854           end.
     2855           if connected("ub") = true
     2856           then do:
     2857             run gbl/wndsizer.p
     2858               (input  v-cntxt-db-num
     2859               ,input  v-cntxt-userid
     2860               ,input  v-diasize-proc-name
     2861               ,input  'width':u
     2862               ,output v-resize-value-str
     2863               ) .
     2864             if v-resize-value-str <> '':U
     2865             then do:
     2866               run diasize_change-width in this-procedure
     2867                 (input  integer(v-resize-value-str)
     2868                 ,input  true
     2869                 ) .
     2870               assign
     2871                 v-restore-saved = true
     2872               .
     2873             end.
     2874           end.
     2875           if v-restore-saved <> true
     2876           then do:
     2877             if v-diasize-wndmax = true
     2878             then do:
     2879               run diasize_maximize in this-procedure
     2880                 (input  true
     2881                 ) .
     2882             end.
     2883           end.
     2884         end.
     2885         else do:
     2886           if v-diasize-wndmax = true
     2887           then do:
     2888             run diasize_maximize in this-procedure
     2889               (input  true
     2890               ) .
     2891           end.
     2892         end.
     2893       end.
     2894     end.
     2895   end procedure.
     2896   procedure diasize_need-full-display :
     2897     define output parameter p-need-full-display as logical   no-undo .
     2898     do
     2899     on error undo, return error return-value
     2900     :
     2901       assign
     2902         p-need-full-display = v-diasize-need-full-display
     2903       .
     2904       assign
     2905         v-diasize-need-full-display = false
     2906       .
     2907     end.
     2908   end procedure.
     2909   procedure get-context :
     2910      define output parameter p-db-num as integer          no-undo.
     2911      define output parameter p-user-id as character        no-undo.
     2912      define variable v-login               as character    no-undo.
     2913      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2914      define buffer buf_user-login  for ub.user-login .
     2915      do
     2916      on error undo, return error
     2917      :
     2918            FIND FIRST buf_sys-ctrl no-lock.
     2919            ASSIGN
     2920               v-login = USERID("ub")
     2921               p-db-num = buf_sys-ctrl.db-num
     2922            .
     2923            FIND FIRST buf_user-login
     2924                 WHERE buf_user-login.db-num = p-db-num
     2925                   AND buf_user-login.user-login = v-login
     2926                 no-lock
     2927                 no-error
     2928                 .
     2929            IF AVAILABLE buf_user-login
     2930            THEN DO:
     2931               assign
     2932                  p-user-id = buf_user-login.user-id
     2933               .
     2934            END.
     2935      end.
     2936   end procedure.
     2937       run diasize_init in this-procedure .
     2938   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2939   procedure set-filter-name :
     2940   define input parameter p-filter-name as character no-undo .
     2941     do with frame Dialog-Frame:
     2942       if p-filter-name > "" then do:
     2943         assign
     2944           frame Dialog-Frame:title
     2945             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2946         .
     2947         assign
     2948           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2949         .
     2950       end.
     2951       else do:
     2952         assign
     2953           b-sch :tooltip = ""
     2954         .
     2955       end.
     2956     end.
     2957   end procedure.
     2958   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2959   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2960     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2961     return no-apply.
     2962   end.
     2963   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2964   on INS of frame Dialog-Frame anywhere do:
     2965     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2966     return no-apply.
     2967   end.
     2968   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2969   on F2 of frame Dialog-Frame anywhere do:
     2970     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2971     return no-apply.
     2972   end.
     2973   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2974   on F2 of frame Dialog-Frame anywhere do:
     2975     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2976     return no-apply.
     2977   end.
     2978   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2979   on f5 of frame Dialog-Frame anywhere
     2980   do:
     2981     if available X_ext-classif then v-doc-rec = recid(X_ext-classif). run openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U) no-error. reposition br-gds-grp to recid(v-doc-rec) no-error. APPLy 'ENTRY' to br-gds-grp .
     2982       apply "VALUE-CHANGED" to br-gds-grp.
     2983   end.
     2984   MAIN-BLOCK:
     2985   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2986      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2987   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2988     run mainmenu_getcntxt in parparentproc
     2989       (output v-cntxt-db-num
     2990       ,output v-cntxt-userid
     2991       ,output v-cntxt-level
     2992       ,output v-cntxt-host-code-obj
     2993       ,output v-cntxt-obj-type
     2994       ,output v-cntxt-obj-code
     2995       ,output v-cntxt-db-num-obj
     2996       ,output v-cntxt-is-admin
     2997       ) .
     2998     v-rid-list = p-rid-list.
     2999     RUN Myenable.
     3000     WAIT-FOR GO OF FRAME Dialog-Frame.
     3001   END.
     3002   RUN disable_UI.
     3003   PROCEDURE disable_UI :
     3004     HIDE FRAME Dialog-Frame.
     3005   END PROCEDURE.
     3006   PROCEDURE enable_UI :
     3007     DISPLAY mark-num
     3008         WITH FRAME Dialog-Frame.
     3009     ENABLE b-quit B-mark B-sel b-sch b-print B-Help br-gds-grp mark-num
     3010         WITH FRAME Dialog-Frame.
     3011     VIEW FRAME Dialog-Frame.
     3012     OPEN QUERY br-gds-grp FOR EACH X_ext-classif NO-LOCK INDEXED-REPOSITION.
     3013   END PROCEDURE.
     3014   PROCEDURE MyEnable :
     3015   ENABLE
     3016   b-quit
     3017   b-print
     3018   b-sch
     3019   B-Help
     3020   br-gds-grp
     3021   WITH FRAME Dialog-Frame.
     3022   VIEW FRAME Dialog-Frame.
     3023   X_ext-classif.charkey_two:RESIZABLE IN BROWSE br-gds-grp = YES.
     3024   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3025   END PROCEDURE.
     3026   PROCEDURE OpenBr :
     3027   define input  parameter p-open-query     as logical   no-undo .
     3028   define input  parameter p-find-next      as logical   no-undo .
     3029   define input  parameter p-find-condition as character no-undo .
     3030   define variable sort-column-phrase as character no-undo .
     3031   define variable l-query-was-opened as logical no-undo .
     3032   define variable title0 as character no-undo .
     3033   define buffer buf_gds-grp for ub.gds-grp.
     3034   case sort-column-name :
     3035     when "" then do:
     3036       assign
     3037         sort-column-phrase = ""
     3038       .
     3039     end.
     3040     otherwise do:
     3041       assign
     3042         sort-column-phrase = "by " + sort-column-name
     3043       .
     3044     end.
     3045   end case.
     3046   filter-point = filter-point0 + p-list-mode .
     3047   title0 = "Соответствие групп товаров в разных системах TH".
     3048   ASSIGN
     3049   frame Dialog-Frame:title = substitute("&1", title0)
     3050   filter-label = SUBSTITUTE("&1"
     3051                             , frame Dialog-Frame:title
     3052                             )
     3053   .
     3054   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3055   define variable  l-disable-where-26  as logical   no-undo .
     3056   define variable  l-filter-open-26    as logical   .
     3057   define variable  flt-rec-26       as recid     no-undo .
     3058   define variable  filter-name-26      as character no-undo .
     3059   define variable  where-phrase-26     as character no-undo .
     3060   define variable  sort-phrase-26      as character no-undo .
     3061   define variable  where-phrase-rus-26 as character no-undo .
     3062   define variable  sort-phrase-rus-26  as character no-undo .
     3063     run waitfram-show in this-procedure
     3064       (input "ЖДИТЕ ..."
     3065       ).
     3066   run gbl/flt-get.p
     3067     (input filter-point
     3068     ,output flt-rec-26
     3069     ,output filter-name-26
     3070     ,output where-phrase-26
     3071     ,output sort-phrase-26
     3072     ,output where-phrase-rus-26
     3073     ,output sort-phrase-rus-26
     3074     ).
     3075       run set-filter-name in this-procedure
     3076         (INPUT filter-name-26
     3077         ) no-error .
     3078     assign
     3079       l-filter-open-26 = false
     3080     .
     3081     if flt-rec-26 <> ?
     3082       or sort-column-phrase > ""
     3083     then do:
     3084       define variable  parameter-2-26 as character no-undo .
     3085       define variable  parameter-3-26 as character no-undo .
     3086       define variable  parameter-4-26 as character no-undo .
     3087       define variable  parameter-5-26 as character no-undo .
     3088       define variable  parameter-6-26 as character no-undo .
     3089       define variable  parameter-7-26 as character no-undo .
     3090         assign
     3091         parameter-3-26 =
     3092                                 "FOR EACH X_ext-classif no-lock"
     3093         parameter-4-26 =
     3094           (
     3095             if (" X_ext-classif.classif-subject = 'gds-grp':U                         and X_ext-classif.classif-name = 'rpm_gds-grp':U                         AND X_ext-classif.db-num = - 1" + " " + where-phrase-26) <> ""
     3096             then  substitute('X_ext-classif.classif-subject = &1&2&1                         and X_ext-classif.classif-name = &1&3&1                         AND X_ext-classif.db-num = - 1', chr(34), 'gds-grp':U, 'rpm_gds-grp':U) + " " + where-phrase-26
     3097             else "true"
     3098           )
     3099         parameter-5-26 = (" " + "" + " " + "")
     3100         parameter-6-26 = if sort-phrase-26 = ''
     3101                              then
     3102           (
     3103           " " + "  " +
     3104             " " + sort-column-phrase +
     3105           " " + " BY X_ext-classif.charkey_two "
     3106           )
     3107                              else
     3108           (
     3109           " " + "  " +
     3110             " " + sort-column-phrase +
     3111           " " + sort-phrase-26
     3112           )
     3113         parameter-7-26 =
     3114           " INDEXED-REPOSITION  "
     3115       .
     3116       do
     3117       on stop undo, leave
     3118       on error undo, leave
     3119       :
     3120         assign
     3121           l-disable-where-26 =
     3122             (" X_ext-classif.classif-subject = 'gds-grp':U                         and X_ext-classif.classif-name = 'rpm_gds-grp':U                         AND X_ext-classif.db-num = - 1" + " " + where-phrase-26 = "")
     3123         .
     3124         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3125                             ,input QUERY br-gds-grp:handle
     3126                             ,input parameter-3-26
     3127                             ,input parameter-4-26
     3128                             ,input parameter-5-26
     3129                             ,input parameter-6-26
     3130                             ,input parameter-7-26
     3131                             )
     3132         .
     3133         assign
     3134           l-filter-open-26 = true
     3135         .
     3136       end.
     3137       if l-filter-open-26 = false then do:
     3138         message
     3139           "Ошибка при фильтрации / сортировке" skip
     3140           "Будут показаны записи без учета фильтра" skip
     3141           view-as alert-box .
     3142       end.
     3143       else do:
     3144           assign
     3145             l-query-was-opened = true
     3146           .
     3147       end.
     3148     end.
     3149     if l-filter-open-26 = false then do:
     3150       OPEN QUERY br-gds-grp FOR EACH X_ext-classif
     3151         where  X_ext-classif.classif-subject = 'gds-grp':U                         and X_ext-classif.classif-name = 'rpm_gds-grp':U                         AND X_ext-classif.db-num = - 1
     3152          BY X_ext-classif.charkey_two
     3153         INDEXED-REPOSITION
     3154     .
     3155         assign
     3156           l-query-was-opened = true
     3157         .
     3158     end.
     3159     run waitfram-hide in this-procedure .
     3160   APPLY "entry" TO br-gds-grp.
     3161   if available X_ext-classif then do:
     3162       APPLY "VALUE-CHANGED":U to br-gds-grp.
     3163   END.
     3164   END PROCEDURE.
     3165   PROCEDURE proc-b-print :
     3166   DEFINE VARIABLE date_string              as   character no-undo .
     3167   DEFINE VARIABLE Line                     as   character no-undo .
     3168   DEFINE VARIABLE for-time                 as   character no-undo .
     3169   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3170   DEFINE VARIABLE accum-count2             as   integer   no-undo .
     3171   define variable v-rid                    as   recid no-undo .
     3172   define variable v-node-code-chr          as   character no-undo .
     3173   DEFINE FRAME list1
     3174   v-node-code-chr COLUMN-LABEL "СВОЙ!код группы" FORMAT "X(9)"
     3175   X_ext-classif.KEY#_one  COLUMN-LABEL "ЧУЖОЙ!код группы" FORMAT ">>>>>>>>9"
     3176   X_ext-classif.charkey_two COLUMN-LABEL "Полное название группы" FORMAT "X(176)"
     3177   HEADER  date_string AT 5 format "X(35)"
     3178   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     3179   Line format "X(198)" AT 1
     3180   with width 232 down stream-io use-text    .
     3181   Line = fill("-", 198).
     3182   date_string = cur-time-print() .
     3183   run prn-lib-open-stream  in this-procedure (
     3184                                                input parParentProc
     3185                                               ,input 43
     3186                                               ,input yes
     3187                                               ,input no
     3188                                               ).
     3189   PUT  STREAM PrnLibStream
     3190   SPACE(25) ( frame Dialog-Frame:title )
     3191   format "x(90)" SKIP(1) .
     3192   FORM HEADER
     3193   Line format "X(198)" AT 1 SKIP
     3194   "Продолжение - на следующей странице" AT 30 SKIP
     3195   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3196   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3197   v-rid = recid(X_ext-classif).
     3198   FORM with FRAME List1.
     3199   run waitfram-show in this-procedure ( input "Ждите...").
     3200   DO WHILE available X_ext-classif :
     3201      GET prev br-gds-grp.
     3202   END.
     3203   GET next br-gds-grp.
     3204   DO WHILE available X_ext-classif :
     3205     Display STREAM PrnLibStream
     3206     (IF X_ext-classif.uniq-key-rec BEGINS 'gds-grp':U
     3207     THEN entry(2, X_ext-classif.uniq-key-rec, chr(3))
     3208     ELSE '') @ v-node-code-chr
     3209      X_ext-classif.KEY#_one
     3210      X_ext-classif.charkey_two
     3211     with FRAME List1.
     3212     DOWN STREAM PrnLibStream
     3213     1
     3214     with FRAME List1.
     3215     assign
     3216     accum-count = accum-count + 1
     3217     .
     3218     if X_ext-classif.uniq-key-rec <> '' then do:
     3219       accum-count2 = accum-count2 + 1.
     3220     end.
     3221     GET next br-gds-grp.
     3222   END.
     3223   UNDERLINE  STREAM PrnLibStream
     3224   v-node-code-chr
     3225   X_ext-classif.KEY#_one
     3226   X_ext-classif.charkey_two
     3227   with FRAME List1.
     3228   DISPLAY STREAM PrnLibStream
     3229   accum-count2 @ v-node-code-chr
     3230   accum-count @ X_ext-classif.key#_one
     3231   with frame List1.
     3232   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3233   HIDE  STREAM PrnLibStream FRAME List1.
     3234   output  STREAM PrnLibStream CLOSE.
     3235   reposition br-gds-grp to recid v-rid no-error .
     3236   apply "ENTRY" to br-gds-grp in frame Dialog-Frame .
     3237   run waitfram-hide in this-procedure .
     3238   run prn-lib-prn-file in this-procedure (
     3239                                             input parParentProc
     3240                                             ,input 0
     3241                                             ).
     3242   END PROCEDURE.
     3243   PROCEDURE proc-b-sch :
     3244   define variable v-ri as recid no-undo .
     3245   assign
     3246   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3247   .
     3248   assign
     3249   tbl = 'ext-classif':U
     3250   join-tbl = 'X_ext-classif'
     3251   fld = ""
     3252   lab = ""
     3253   spr = ""
     3254   dim = '0'
     3255   .
     3256   run fltfield-add in this-procedure('charkey_two', 'Назв.узла', '',
     3257   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3258   run fltfield-add in this-procedure('charkey_one', 'Группа(RPM)', '',
     3259   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3260   run fltfield-add in this-procedure('key#_one', 'Отдел(RPM)', '',
     3261   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3262   run fltfield-add in this-procedure('key#_two', 'Отдел(RPM)', '',
     3263   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3264   run fltfield-add in this-procedure('key#_three', 'Отдел(RPM)', '',
     3265   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3266   run fltfield-add in this-procedure('uniq-key-rec', 'Уникальный ключ записи в своей БД', '',
     3267   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3268   DO on stop undo, leave:
     3269       run gbl/filter.w ( INPUT parparentproc
     3270                    ,INPUT filter-point + chr(4) + filter-label
     3271                    ,INPUT tbl
     3272                    ,INPUT join-tbl
     3273                    ,INPUT fld
     3274                    ,INput lab
     3275                    ,INPUT spr
     3276                    ,INPUT  dim).
     3277       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3278       if v-ri <> ? then do:
     3279         reposition br-gds-grp to recid v-ri no-error.
     3280       end.
     3281       APPLY "ENTRY" to br-gds-grp in frame Dialog-Frame .
     3282       APPLY "VALUE-CHANGED" to br-gds-grp.
     3283   END .
     3284   END PROCEDURE.
     3285   FUNCTION get-cli-node-code RETURNS CHARACTER
     3286     ( INPUT p-uniq-key-rec AS character ) :
     3287   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3288   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3289   DEFINE BUFFER buf_gds-grp FOR ub.gds-grp.
     3290   if p-uniq-key-rec = '' then return ''.
     3291       RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3292                                           ,INPUT ?
     3293                                           ,INPUT "ub"
     3294                                           ,INPUT ?
     3295                                           ,INPUT NO-LOCK
     3296                                           ,OUTPUT v-rowid
     3297                                           ,OUTPUT v-tbl-name) NO-ERROR.
     3298       if error-status :error then do:
     3299         message
     3300           vss-workfile vss-revision vss-description skip
     3301           error-status :get-message(1)
     3302           error-status :get-message(2)
     3303         view-as alert-box error.
     3304         undo, return error.
     3305       end.
     3306       IF v-rowid = ? THEN RETURN ''.
     3307       FIND FIRST buf_gds-grp NO-LOCK WHERE ROWID(buf_gds-grp) = v-rowid.
     3308       RETURN substitute("&1"
     3309                         ,buf_gds-grp.node-code
     3310                         ).
     3311   END FUNCTION.
     3312   FUNCTION get-cli-node-name RETURNS CHARACTER
     3313     ( INPUT p-uniq-key-rec AS CHARACTER ) :
     3314   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3315   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3316   DEFINE BUFFER buf_gds-grp FOR ub.gds-grp.
     3317   if p-uniq-key-rec = '' then return ''.
     3318   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3319                                       ,input ?
     3320                                       ,INPUT "ub"
     3321                                       ,INPUT ?
     3322                                       ,INPUT NO-LOCK
     3323                                       ,OUTPUT v-rowid
     3324                                       ,OUTPUT v-tbl-name) no-error.
     3325   if error-status :error then do:
     3326     message
     3327       vss-workfile vss-revision vss-description skip
     3328       error-status :get-message(1)
     3329       error-status :get-message(2)
     3330     view-as alert-box error.
     3331     undo, return error.
     3332   end.
     3333   IF v-rowid = ? THEN RETURN 'НЕИЗВЕСТНАЯ ГРУППА ТОВАРОВ'.
     3334   FIND FIRST buf_gds-grp NO-LOCK WHERE ROWID(buf_gds-grp) = v-rowid.
     3335   RETURN buf_gds-grp.node-name.
     3336   END FUNCTION.
