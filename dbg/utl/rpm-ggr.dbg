        1   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
        2   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   DEFINE INPUT PARAMETER bttns AS character NO-UNDO.
        4   DEFINE INPUT PARAMETER p-list-mode AS character NO-UNDO.
        5   DEFINE INPUT-OUTPUT PARAMETER p-rid-list AS character NO-UNDO.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Соответствие групп товаров в TH и RPM".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable v-waitfram-action01         as character   no-undo .
       68   define variable v-waitfram-action02         as character   no-undo .
       69   define variable v-waitfram-action03         as character   no-undo .
       70   define variable mWaitFramTextBeg            as character   no-undo.
       71   define variable mWaitFramTextEnd            as character   no-undo.
       72   define variable mWaitFramView               as logical     no-undo.
       73   define variable mWaitProcEvent              as logical     no-undo init yes.
       74   define variable mWaitFramInterval           as integer     no-undo init 1 .
       75   define variable mWaitFramStop               as logical     no-undo.
       76   define variable mWaitFramStopUser           as logical     no-undo.
       77   define variable mWaitFramStopTimeOut        as logical     no-undo.
       78   define variable mWaitFramStartProc          as datetime-tz no-undo.
       79   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       80   define button B-WaitFramStop auto-end-key
       81        label "Стоп"
       82        size 10 by 1 tooltip "Остоновить процесс".
       83   define button B-viewProcInfo
       84        label "Информация"
       85        size 15 by 1 tooltip "Информация о процесс".
       86   define frame waitfram
       87     v-waitfram-action01 format "x(72)" no-label skip
       88     v-waitfram-action02 format "x(72)" no-label skip
       89     v-waitfram-action03 format "x(72)" no-label skip
       90     B-viewProcInfo
       91     B-WaitFramStop at row 4 col 30
       92     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       93     .
       94   define new global shared variable mBatchMode as logical no-undo init ?.
       95   define variable mFramBachModHandle as handle no-undo.
       96   mFramBachModHandle = frame waitfram:handle.
       97   define variable mFameOldVis as logical no-undo.
       98   define variable mVisCUrentVin as logical no-undo.
       99   if session:batch-mode
      100   then
      101      mBatchMode = yes.
      102   if mBatchMode = ? then do:
      103     mVisCUrentVin = current-window:visible.
      104     mFameOldVis = mFramBachModHandle:visible.
      105     mFramBachModHandle:visible  = yes.
      106     mBatchMode = mFramBachModHandle:visible ne yes.
      107     mFramBachModHandle:visible = mFameOldVis.
      108     current-window:visible = mVisCUrentVin.
      109   end.
      110    if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      115     end.
      116   on choose of B-WaitFramStop in frame waitfram
      117   do:
      118     mWaitFramStop = yes.
      119     mWaitFramStopUser = yes.
      120   end.
      121   function waitfram-check-timeout returns logical():
      122      define variable vtime as int64 no-undo.
      123      if mWaitFramStopTimeOut
      124      then
      125         return yes.
      126      vtime = ( now - mWaitFramStartProc ) / 1000 .
      127      if     mWaitFramTimeOut ne ?
      128         and mWaitFramTimeOut ne 0
      129         and mWaitFramTimeOut lt vtime
      130      then do:
      131         mWaitFramStopTimeOut = yes.
      132      end.
      133      return mWaitFramStopTimeOut.
      134   end.
      135   procedure waitfram-hide :
      136     if not session:batch-mode
      137     then do
      138     on error undo, return error return-value
      139     :
      140       pause 0 before-hide .
      141       if not mBatchMode then
      142         hide frame waitfram .
      143     if     not mWaitFramView
      144        and mWaitProcEvent
      145     then
      146       process events .
      147     end.
      148   end procedure.
      149   procedure waitfram-show :
      150     define input  parameter p-message as character no-undo .
      151     define variable v-left-margin as integer   no-undo .
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       if length(p-message) <= 70 then do:
      157         assign
      158           v-left-margin = integer((70 - length(p-message)) / 2)
      159         .
      160         assign
      161           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      162         .
      163         assign
      164           v-waitfram-action01 = " "
      165           v-waitfram-action02 = " "
      166                                    + fill(" ", v-left-margin)
      167                                    + p-message
      168           v-waitfram-action03 = " "
      169         .
      170       end.
      171       else do:
      172         define variable vRindex1 as integer no-undo.
      173         define variable vRindex2 as integer no-undo.
      174         vRindex1 = r-index(p-message," ",70).
      175         if vRindex1 = 0
      176         then
      177            vRindex1 = 70.
      178         if length(p-message)  <= vRindex1 + 70 then do:
      179           assign
      180             v-waitfram-action01 = " "
      181             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      182             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      183           .
      184         end.
      185         else do:
      186           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      187           if vRindex2 <= vRindex1
      188           then
      189              vRindex2 = vRindex1 + 70.
      190           assign
      191             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      194           .
      195         end.
      196       end.
      197       B-viewProcInfo:visible   in frame waitfram = no.
      198       B-viewProcInfo:sensitive in frame waitfram = no.
      199       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       if  (   mWaitFramView
      202          or  mWaitProcEvent)
      203          and not mBatchMode
      204       then
      205          display
      206             v-waitfram-action01 skip
      207             v-waitfram-action02 skip
      208             v-waitfram-action03 skip
      209          with frame waitfram .
      210       if     mWaitFramView
      211          then do:
      212             if     mWaitFramInterval ne ?
      213                and not mBatchMode
      214             then
      215                wait-for go of frame waitfram pause mWaitFramInterval.
      216          end.
      217          else
      218             if     mWaitProcEvent
      219                and not mBatchMode
      220             then
      221                process events .
      222     end.
      223   end procedure.
      224      procedure waitfram-show-this:
      225         define input  parameter iInterval as int64 no-undo.
      226         define variable vtime as int64 no-undo.
      227         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      228         mWaitFramInterval = iInterval.
      229         run waitfram-show (substitute("&1&2 &3&4" ,
      230                                       mWaitFramTextBeg ,
      231                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      232                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      233                                       mWaitFramTextEnd
      234                                      )
      235                           ).
      236      end.
      237      procedure WaitFramRunPause:
      238         define input  parameter iInterval as dec no-undo.
      239         define variable vStart  as datetime-tz no-undo.
      240         define variable vend    as datetime-tz no-undo.
      241         define variable vint as int64 no-undo.
      242         define variable vOk as logical no-undo.
      243         vStart = now.
      244         vend   = vStart.
      245         publish "WaitFramPause" (iInterval,output vOk).
      246         vend   =  now.
      247         vint = vend - vStart.
      248         vint = iInterval - vint / 1000.
      249         if     not mWaitFramStop
      250            and (   vint > 0
      251                 or (    not vOk
      252                     and iInterval eq ?
      253                     )
      254                 )
      255         then
      256            run waitfram-show-this (iInterval).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and vint > 0
      262         then do:
      263            run gbl/pause.p (vint * 1000).
      264         end.
      265         if iInterval ne ?
      266         then
      267            publish "WaitFramStop".
      268         waitfram-check-timeout().
      269      end.
      270      procedure WaitFramWaitFor:
      271         define input  parameter iInterval as dec no-undo.
      272         assign
      273            mWaitFramStartProc   = now
      274            mWaitFramStopUser    = no
      275            mWaitFramStopTimeOut = no
      276         .
      277         block-wait:
      278         do while not mWaitFramStop:
      279            run WaitFramRunPause (iInterval).
      280            if  waitfram-check-timeout()
      281            then do:
      282               leave block-wait.
      283            end.
      284         end.
      285         run waitfram-hide.
      286      end.
      287   procedure waitfram-join :
      288     define input  parameter p-line-1  as character no-undo .
      289     define input  parameter p-line-2  as character no-undo .
      290     define input  parameter p-line-3  as character no-undo .
      291     define output parameter p-message as character no-undo .
      292     do
      293     on error undo, return error return-value
      294     :
      295       assign
      296         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      299       .
      300     end.
      301   end procedure.
      302   function waitfram-join-function returns character
      303     (input p-line-1 as character
      304     ,input p-line-2 as character
      305     ,input p-line-3 as character
      306     ).
      307     define variable v-message as character no-undo .
      308     run waitfram-join in this-procedure
      309       (input  p-line-1
      310       ,input  p-line-2
      311       ,input  p-line-3
      312       ,output v-message
      313       ) .
      314     return v-message .
      315   end function .
      316   define new global shared variable g#language as character no-undo .
      317   if g#language <> '' and g#language <> 'rus':U then do:
      318     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      319   end.
      320   define new global shared variable g#library  as handle no-undo .
      321   define new global shared variable g#library2 as handle no-undo .
      322   define   shared variable g#auto as logical no-undo.
      323   define   shared variable g#news as logical no-undo.
      324   define   shared variable g#oxml as logical no-undo.
      325   define   shared variable g#esys as logical no-undo.
      326   define   shared variable g#news-source-db as integer no-undo.
      327   define   shared variable g#esys-source-esys as integer no-undo.
      328   define   shared variable g#db-num as integer   no-undo .
      329   define   shared variable g#userid as character no-undo .
      330   define   shared variable g#passwd as character no-undo .
      331   procedure proc-alt-shift-f2:
      332     if not ibs.th.gbl.gbl-var:rcode
      333   then
      334     run gbl\inidebug.p .
      335   end.
      336   procedure proc-alt-shift-f3:
      337     run gbl/prvssinf.p
      338       ( input this-procedure
      339       ) .
      340   end.
      341   define variable v-inform-launched as logical no-undo initial false .
      342   procedure proc-alt-shift-f4:
      343     define variable v-action as character no-undo .
      344     if v-inform-launched = false then do:
      345       assign
      346         v-inform-launched = true
      347       .
      348       run gbl/d-inform.w
      349         (  input self
      350         ,  input this-procedure
      351         , output v-action
      352         ) no-error .
      353       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      354       assign
      355         v-inform-launched = false
      356       .
      357     end.
      358   end.
      359   procedure proc-alt-f1:
      360     run gbl/corrhelp.p
      361       (input this-procedure
      362       ) .
      363   end .
      364   on alt-shift-f2 anywhere do:
      365     run proc-alt-shift-f2.
      366   end.
      367   on alt-shift-f3 anywhere do:
      368     run proc-alt-shift-f3 in this-procedure .
      369   end.
      370   on alt-shift-f4 anywhere do:
      371     run proc-alt-shift-f4 in this-procedure.
      372   end.
      373   on alt-f1 anywhere do:
      374     run proc-alt-f1 in this-procedure .
      375   end.
      376   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377     define variable v-cntxt-db-num        as integer   no-undo .
      378     define variable v-cntxt-userid        as character no-undo .
      379     define variable v-cntxt-level         as character no-undo .
      380     define variable v-cntxt-host-code-obj as integer   no-undo .
      381     define variable v-cntxt-obj-type      as character no-undo .
      382     define variable v-cntxt-obj-code      as integer   no-undo .
      383     define variable v-cntxt-db-num-obj    as integer   no-undo .
      384     define variable v-cntxt-is-admin      as logical   no-undo .
      385   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   procedure gen-key-rec :
      387     define input  parameter p-tbl-name    as character no-undo.
      388     define input  parameter p-bh_tbl-name as handle    no-undo.
      389     define output parameter p-key-rec     as character no-undo.
      390     do
      391     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      392     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      393     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      394     :
      395       define variable fh               as handle    no-undo .
      396       define variable v-ok             as logical   no-undo .
      397       define variable v-inform         as character no-undo .
      398       define variable v-ind            as integer   no-undo .
      399       define variable v-idx-field-qnty as integer   no-undo .
      400       if p-tbl-name = ?
      401         or p-tbl-name = "":U
      402       then do:
      403         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      404       end.
      405       if not p-bh_tbl-name:available then do:
      406         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      407       end.
      408       assign
      409         p-key-rec = p-tbl-name
      410         v-inform  = p-bh_tbl-name:index-information(1)
      411         v-ind     = 2
      412       .
      413       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      414       on error undo, return error
      415       :
      416         assign
      417           v-inform = p-bh_tbl-name:index-information( v-ind )
      418           v-ind    = v-ind + 1
      419         .
      420       end.
      421       if v-inform = ?
      422         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      423         or entry( 3, v-inform, ",":U ) <> "1":U
      424       then do:
      425         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      426       end.
      427       else do:
      428         assign
      429           v-idx-field-qnty = num-entries( v-inform ) - 4
      430         .
      431         if v-idx-field-qnty < 2 then do:
      432           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      433         end.
      434         do v-ind = 1 to v-idx-field-qnty by 2
      435         on error undo, return error
      436         :
      437           assign
      438             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      439             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      440           .
      441         end.
      442       end.
      443       if p-key-rec = ? then do:
      444         assign
      445           p-key-rec = "":U
      446         .
      447         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      448       end.
      449     end.
      450     return.
      451   end procedure.
      452   procedure gen-where-keyr-tab :
      453     define input  parameter i-tableSerach as character no-undo.
      454     define input  parameter i-tablekey   as character  no-undo.
      455     define input  parameter p-key-rec    as character  no-undo.
      456     define input  parameter p-key-handle as handle     no-undo .
      457     define input  parameter p-db-name    as character  no-undo .
      458     define input  parameter p-tt-handle  as handle     no-undo .
      459     define output parameter o-Where      as character  no-undo.
      460     do
      461     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      462     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      463     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      464     :
      465       define variable v-full-tbl-name  as character no-undo .
      466       define variable bh_tbl-name      as handle    no-undo .
      467       define variable fh_key           as handle    no-undo .
      468       define variable fh_search        as handle    no-undo .
      469       define variable v-field-num      as integer   no-undo .
      470       define variable v-count-fld      as integer   no-undo .
      471       define variable v-inform         as character no-undo .
      472       define variable v-ind            as integer   no-undo .
      473       define variable v-idx-field-qnty as integer   no-undo .
      474       define variable v-field-name     as character no-undo .
      475       define variable v-field-val      as character no-undo .
      476       define variable v-word-link      as character no-undo .
      477       define variable vTable           as character no-undo.
      478       define variable bh_tbl-key       as handle    no-undo .
      479       assign
      480         p-key-rec = trim( p-key-rec )
      481       .
      482       if p-key-handle <> ? then do:
      483         if not valid-handle(p-key-handle)
      484            or p-key-handle:type <> "buffer"
      485         then do:
      486           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      487         end.
      488         if num-entries( p-key-rec, chr(3) ) > 1
      489           or p-key-rec = ?
      490           or p-key-rec = "":U
      491         then do:
      492           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      493         end.
      494       end.
      495       else do:
      496         if p-key-rec = ?
      497           or p-key-rec = "":U
      498         then do:
      499           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      500         end.
      501       end.
      502       assign
      503         vTable = entry( 1 , p-key-rec, chr(3) )
      504       .
      505       if p-tt-handle <> ?
      506         and ( not valid-handle(p-tt-handle)
      507               or p-tt-handle:type <> "buffer"
      508             )
      509       then do:
      510         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      511       end.
      512       if p-tt-handle = ? then do:
      513         assign
      514           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      515         .
      516         create buffer bh_tbl-name for table v-full-tbl-name .
      517       end.
      518       else do:
      519         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      520       end.
      521       assign
      522         v-inform = bh_tbl-name:index-information(1)
      523         v-ind    = 2
      524       .
      525       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      526       on error undo, return error
      527       :
      528         assign
      529           v-inform = bh_tbl-name:index-information( v-ind )
      530           v-ind    = v-ind + 1
      531         .
      532       end.
      533       if v-inform = ?
      534         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      535         or entry( 3, v-inform, ",":U ) <> "1":U
      536       then do:
      537         delete object bh_tbl-name no-error.
      538         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      539       end.
      540       assign
      541         v-idx-field-qnty = num-entries( v-inform ) - 4
      542       .
      543       if v-idx-field-qnty < 2 then do:
      544         delete object bh_tbl-name no-error.
      545         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      546       end.
      547       assign
      548         o-where     = "where":U
      549         v-word-link = "":U
      550         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      551         v-count-fld = 0
      552       .
      553       if i-tablekey ne "" and i-tablekey ne ?
      554       then do:
      555         assign
      556           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      557         .
      558         create buffer bh_tbl-key for table v-full-tbl-name .
      559       end.
      560       if i-tableSerach ne "" and i-tableSerach ne ?
      561       then do:
      562         delete object bh_tbl-name no-error.
      563         assign
      564           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      565         .
      566         create buffer bh_tbl-name for table v-full-tbl-name .
      567       end.
      568       block_where:
      569       do v-ind = 1 to v-idx-field-qnty by 2
      570       on error undo, return error
      571       :
      572         assign
      573           v-count-fld = v-count-fld + 1
      574         .
      575         if p-key-handle = ?
      576           and v-count-fld > v-field-num
      577         then do:
      578           leave block_where.
      579         end.
      580         define variable VfieldKeyTable as handle no-undo.
      581         assign
      582           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      583           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      584         .
      585         if     bh_tbl-key ne ?
      586         then do:
      587            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      588            if VfieldKeyTable eq ?
      589            then next block_where.
      590         end.
      591         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      592         then
      593            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      594         else
      595            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      596         if p-key-handle = ? then do:
      597           assign
      598             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      599           .
      600         end.
      601         else do:
      602           assign
      603             fh_key = p-key-handle:buffer-field( v-field-name )
      604           .
      605           if fh_key = ?
      606             or not valid-handle( fh_key )
      607           then do:
      608             delete object bh_tbl-name.
      609             if     bh_tbl-key ne ?
      610             then
      611                delete object bh_tbl-key.
      612             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      613           end.
      614           assign
      615             v-field-val = fh_key:buffer-value
      616           .
      617         end.
      618         if fh_search:data-type ="character":U then do:
      619           assign
      620             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      621             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      622             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      623             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      624             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      625             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      626             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      627             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      628             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      629             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      630             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      631             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      632             v-field-val = substitute( '"&1"', v-field-val )
      633           .
      634         end.
      635         assign
      636           o-where = substitute( "&1 &2", o-where, v-field-val )
      637         .
      638         if v-word-link = "":U then do:
      639           assign
      640             v-word-link = "and":U
      641           .
      642         end.
      643       end.
      644       delete object bh_tbl-name.
      645       if     bh_tbl-key ne ?
      646       then
      647          delete object bh_tbl-key.
      648       if p-key-handle = ?
      649         and v-count-fld <> v-field-num
      650       then do:
      651         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      652       end.
      653     end.
      654   end procedure.
      655   procedure gen-hn-keyr-tab :
      656     define input  parameter i-tableSerach as character no-undo.
      657     define input  parameter i-tablekey   as character no-undo.
      658     define input  parameter p-key-rec    as character no-undo.
      659     define input  parameter p-key-handle as handle    no-undo .
      660     define input  parameter p-db-name    as character no-undo .
      661     define input  parameter p-tt-handle  as handle    no-undo .
      662     define input  parameter p-stts-lock  as integer   no-undo .
      663     define output parameter o-hn         as handle    no-undo.
      664     define variable v-full-tbl-name as character no-undo.
      665     define variable v-where         as character no-undo.
      666     define variable bh_tbl-name     as handle    no-undo.
      667     define variable vTable          as character no-undo.
      668     do
      669     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      670     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      671     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      672         run gen-where-keyr-tab(i-tableSerach,
      673                                i-tablekey,
      674                                p-key-rec,
      675                                p-key-handle,
      676                                p-db-name,
      677                                p-tt-handle,
      678                                output v-where).
      679         if i-tableSerach ne "" and i-tableSerach ne ?
      680         then do:
      681            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      682            create buffer bh_tbl-name for table v-full-tbl-name .
      683         end.
      684         else do:
      685            if p-tt-handle = ? then do:
      686               assign
      687                  vTable = entry( 1 , p-key-rec, chr(3) )
      688               .
      689               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      690               create buffer bh_tbl-name for table v-full-tbl-name .
      691            end.
      692            else do:
      693               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      694            end.
      695         end.
      696         if p-tt-handle = ? then do:
      697            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      698         end.
      699         else do:
      700            bh_tbl-name:find-first( v-where ) no-error .
      701         end.
      702         o-hn = bh_tbl-name.
      703      end.
      704   end procedure.
      705   procedure gen-hn-keyr :
      706     define input  parameter p-key-rec    as character no-undo.
      707     define input  parameter p-key-handle as handle    no-undo .
      708     define input  parameter p-db-name    as character no-undo .
      709     define input  parameter p-tt-handle  as handle    no-undo .
      710     define input  parameter p-stts-lock  as integer   no-undo .
      711     define output parameter o-hn         as handle    no-undo.
      712     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      713   end.
      714   procedure gen-row-keyr :
      715     define input  parameter p-key-rec    as character no-undo.
      716     define input  parameter p-key-handle as handle    no-undo .
      717     define input  parameter p-db-name    as character no-undo .
      718     define input  parameter p-tt-handle  as handle    no-undo .
      719     define input  parameter p-stts-lock  as integer   no-undo .
      720     define output parameter p-tbl-row    as rowid     no-undo.
      721     define output parameter p-tbl-name   as character no-undo.
      722     define variable vHn as handle no-undo.
      723       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      724       p-tbl-row = if vHn:available then vHn:rowid else ?.
      725       p-tbl-name =  vHn:table.
      726       delete object vHn no-error.
      727     if p-tbl-row = ? then do:
      728       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      729     end.
      730     else do:
      731       return.
      732     end.
      733   end procedure.
      734   procedure gen-key-fv :
      735     define input  parameter p-key-rec    as character no-undo .
      736     define output parameter p-field-list as character no-undo .
      737     define output parameter p-value-list as character no-undo.
      738     do
      739     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      740     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      741     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      742     :
      743       define variable v-full-tbl-name  as character no-undo .
      744       define variable bh_tbl-name      as handle    no-undo .
      745       define variable v-tbl-name       as character no-undo .
      746       define variable v-field-num      as integer   no-undo .
      747       define variable v-count-fld      as integer   no-undo .
      748       define variable v-inform         as character no-undo .
      749       define variable v-ind            as integer   no-undo .
      750       define variable v-idx-field-qnty as integer   no-undo .
      751       define variable v-delim-key      as character no-undo .
      752       if p-key-rec = ?
      753         or p-key-rec = "":U
      754       then do:
      755         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      756       end.
      757       assign
      758         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      759         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      760       .
      761       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      762       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      763       assign
      764         v-inform = bh_tbl-name:index-information(1)
      765         v-ind    = 2
      766       .
      767       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      768       on error undo, return error
      769       :
      770         assign
      771           v-inform = bh_tbl-name:index-information( v-ind )
      772           v-ind    = v-ind + 1
      773         .
      774       end.
      775       if v-inform = ?
      776         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      777         or entry( 3, v-inform, ",":U ) <> "1":U
      778       then do:
      779         delete object bh_tbl-name no-error.
      780         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      781       end.
      782       assign
      783         v-idx-field-qnty = num-entries( v-inform ) - 4
      784       .
      785       if v-idx-field-qnty < 2 then do:
      786         delete object bh_tbl-name no-error.
      787         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      788       end.
      789       assign
      790         p-field-list = "":U
      791         p-value-list = "":U
      792         v-delim-key  = "":U
      793         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      794         v-count-fld  = 0
      795       .
      796       block_where:
      797       do v-ind = 1 to v-idx-field-qnty by 2
      798       on error undo, return error
      799       :
      800         assign
      801           v-count-fld = v-count-fld + 1
      802         .
      803         if v-count-fld > v-field-num then do:
      804           leave block_where.
      805         end.
      806         assign
      807           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      808           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      809         .
      810         if v-ind = 1 then do:
      811           assign
      812             v-delim-key = chr(3)
      813           .
      814         end.
      815       end.
      816       delete object bh_tbl-name.
      817       if v-count-fld <> v-field-num then do:
      818         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      819       end.
      820     end.
      821   end procedure.
      822   procedure gen-key-field :
      823     define input  parameter p-table      as character no-undo .
      824     define output parameter p-field-list as character no-undo .
      825     do
      826     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      827     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      828     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      829     :
      830       define variable v-full-tbl-name  as character no-undo .
      831       define variable bh_tbl-name      as handle    no-undo .
      832       define variable v-tbl-name       as character no-undo .
      833       define variable v-field-num      as integer   no-undo .
      834       define variable v-count-fld      as integer   no-undo .
      835       define variable v-inform         as character no-undo .
      836       define variable v-ind            as integer   no-undo .
      837       define variable v-idx-field-qnty as integer   no-undo .
      838       define variable v-delim-key      as character no-undo .
      839       if p-table = ?
      840         or p-table = "":U
      841       then do:
      842         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      843       end.
      844       assign
      845         v-tbl-name      = p-table
      846         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      847       .
      848       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      849       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      850       assign
      851         v-inform = bh_tbl-name:index-information(1)
      852         v-ind    = 2
      853       .
      854       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      855       on error undo, return error
      856       :
      857         assign
      858           v-inform = bh_tbl-name:index-information( v-ind )
      859           v-ind    = v-ind + 1
      860         .
      861       end.
      862       if v-inform = ?
      863         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      864         or entry( 3, v-inform, ",":U ) <> "1":U
      865       then do:
      866         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      867       end.
      868       assign
      869         v-idx-field-qnty = num-entries( v-inform ) - 4
      870       .
      871       if v-idx-field-qnty < 2 then do:
      872         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      873       end.
      874       assign
      875         p-field-list = "":U
      876         v-delim-key  = "":U
      877         v-count-fld  = 0
      878       .
      879       block_where:
      880       do v-ind = 1 to v-idx-field-qnty by 2
      881       on error undo, return error
      882       :
      883         assign
      884           v-count-fld = v-count-fld + 1
      885         .
      886         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      887         if v-ind = 1 then do:
      888           assign
      889             v-delim-key = chr(3)
      890           .
      891         end.
      892       end.
      893       delete object bh_tbl-name.
      894     end.
      895   end procedure.
      896   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      897   define variable c-point  as character no-undo .
      898   define variable tbl      as character no-undo .
      899   define variable join-tbl as character no-undo .
      900   define variable fld      as character no-undo .
      901   define variable lab      as character no-undo .
      902   define variable spr      as character no-undo .
      903   define variable dim      as character no-undo .
      904   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   procedure fltfield-clear :
      906     define output parameter loc-fld as character no-undo.
      907     define output parameter loc-lab as character no-undo .
      908     define output parameter loc-spr as character no-undo .
      909     define output parameter loc-dim as character no-undo .
      910     assign
      911       loc-fld = ""
      912       loc-lab = ""
      913       loc-spr = ""
      914       loc-dim = "0"
      915     .
      916   end procedure .
      917   procedure fltfield-add :
      918     define input        parameter par-fld as character no-undo.
      919     define input        parameter par-lab as character no-undo .
      920     define input        parameter par-spr as character no-undo .
      921     define input-output parameter loc-fld as character no-undo.
      922     define input-output parameter loc-lab as character no-undo .
      923     define input-output parameter loc-spr as character no-undo .
      924     define input-output parameter loc-dim as character no-undo .
      925     do
      926     on error undo, return error
      927     :
      928       assign
      929       loc-fld = if loc-dim = '0'
      930                 then par-fld
      931                 else (loc-fld + chr(44) + par-fld)
      932       loc-lab = if loc-dim = '0'
      933                 then par-lab
      934                 else (loc-lab + chr(44) + par-lab)
      935       loc-spr = if loc-dim = '0'
      936                 then par-spr
      937                 else (loc-spr + chr(44) + par-spr)
      938       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      939                 string(integer(if num-entries(loc-dim) > 1
      940                               then entry(2, loc-dim)
      941                               else entry(1, loc-dim)
      942                               ) + 1)
      943       no-error
      944       .
      945     end.
      946   end procedure.
      947   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   FUNCTION mark-string RETURNS CHARACTER
      949     ( input p-recid as recid, input mark-list as character  ) :
      950     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      951   END FUNCTION.
      952   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      954   procedure cur-time :
      955      define output parameter p-today as date      no-undo .
      956      define output parameter p-time  as integer   no-undo .
      957     do
      958     on error undo, return error
      959     :
      960       define variable v-date1 as date      no-undo .
      961       define variable v-date2 as date      no-undo .
      962       define variable v-time  as integer   no-undo .
      963       assign
      964         v-date1 = today
      965         v-time  = time
      966         v-date2 = today
      967       .
      968       if v-date1 <> v-date2
      969       then do:
      970         assign
      971           v-date1 = today
      972           v-time  = v-time
      973         .
      974       end.
      975       assign
      976         p-today = v-date1
      977         p-time  = v-time
      978       .
      979     end.
      980   end.
      981   function cur-time-date returns character
      982   :
      983     return string(today, '99/99/9999':U) .
      984   end.
      985   function cur-time-mjd returns decimal
      986   :
      987     define variable v-date as date      no-undo .
      988     define variable v-time as integer   no-undo .
      989     run cur-time in this-procedure
      990       (output v-date
      991       ,output v-time
      992       ) .
      993     return integer(v-date) - 2400002 + (v-time / 86400) .
      994   end.
      995   function cur-time-get-ending-index returns integer
      996   (input p-number as integer
      997   )
      998   :
      999     if p-number < 0
     1000     or p-number = ?
     1001     then do:
     1002       return 1 .
     1003     end.
     1004     define variable v-rest as integer   no-undo .
     1005     assign
     1006       p-number = p-number modulo 100
     1007     .
     1008     if p-number < 20
     1009     then do:
     1010       assign
     1011         v-rest = p-number
     1012       .
     1013     end.
     1014     else do:
     1015       assign
     1016         v-rest = p-number modulo 10
     1017       .
     1018     end.
     1019     case v-rest :
     1020       when 1
     1021       then do:
     1022         return 2 .
     1023       end.
     1024       when 2 or
     1025       when 3 or
     1026       when 4
     1027       then do:
     1028         return 3 .
     1029       end.
     1030       otherwise do:
     1031         return 1 .
     1032       end.
     1033     end case .
     1034   end.
     1035   procedure cur-time-mjd-to-date :
     1036      define input  parameter i-mjd-diff as decimal no-undo.
     1037      define output parameter o-Date     as date    no-undo.
     1038      define output parameter o-Time     as integer no-undo.
     1039      define variable v-day-number as integer   no-undo .
     1040      if    i-mjd-diff < 0
     1041         or i-mjd-diff = ?
     1042      then do:
     1043         return "?" .
     1044      end.
     1045      assign
     1046         v-day-number = truncate(i-mjd-diff,0).
     1047         o-Date = date(v-day-number + 2400002).
     1048         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1049     .
     1050   end.
     1051   function cur-time-mjd-to-string returns character
     1052   (input p-mjd-diff as decimal
     1053   )
     1054   :
     1055     define variable v-day-number as integer   no-undo .
     1056     define variable v-seconds    as integer   no-undo .
     1057     define variable v-hour       as integer   no-undo .
     1058     define variable v-min        as integer   no-undo .
     1059     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1060     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1061     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1062     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1063     if p-mjd-diff < 0
     1064     or p-mjd-diff = ?
     1065     then do:
     1066       return "?" .
     1067     end.
     1068     assign
     1069       v-day-number = integer(truncate(p-mjd-diff,0))
     1070       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1071     .
     1072     if v-seconds > 86400
     1073     then do:
     1074       assign
     1075         v-seconds = 86400 - 1
     1076       .
     1077     end.
     1078     if v-seconds < 0
     1079     then do:
     1080       assign
     1081         v-seconds = 0
     1082       .
     1083     end.
     1084     assign
     1085       v-hour = truncate(v-seconds / 3600, 0)
     1086     .
     1087     assign
     1088       v-seconds = v-seconds modulo 3600
     1089     .
     1090     assign
     1091       v-min = truncate(v-seconds / 60, 0)
     1092     .
     1093     assign
     1094       v-seconds = v-seconds modulo 60
     1095     .
     1096     return
     1097         (if v-day-number <> 0
     1098           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1099           else ""
     1100         )
     1101       + (if v-day-number <> 0 or v-hour <> 0
     1102           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1103           else ""
     1104         )
     1105       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1106           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1107           else ""
     1108         )
     1109       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1110       .
     1111   end.
     1112   function cur-time-string returns character
     1113   :
     1114     define variable v-date as date      no-undo .
     1115     define variable v-time as integer   no-undo .
     1116     run cur-time in this-procedure
     1117       (output v-date
     1118       ,output v-time
     1119       ) .
     1120     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1121   end.
     1122   function cur-time-string-sec returns character
     1123   :
     1124     define variable v-date as date      no-undo .
     1125     define variable v-time as integer   no-undo .
     1126     run cur-time in this-procedure
     1127       (output v-date
     1128       ,output v-time
     1129       ) .
     1130     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1131   end.
     1132   function cur-time-custom  returns character
     1133   (input p-prefix as character
     1134   ,input p-date-format as character
     1135   ,input p-delimiter as character
     1136   ,input p-time-format as character
     1137   ,input p-suffix as character
     1138   )
     1139   :
     1140     define variable v-date as date      no-undo .
     1141     define variable v-time as integer   no-undo .
     1142     run cur-time in this-procedure
     1143       (output v-date
     1144       ,output v-time
     1145       ) .
     1146     return
     1147       p-prefix
     1148       + string(v-date, p-date-format)
     1149       + p-delimiter
     1150       + string(v-time, p-time-format)
     1151       + p-suffix
     1152       .
     1153   end.
     1154   function cur-time-print  returns character
     1155   :
     1156     define variable v-date as date      no-undo .
     1157     define variable v-time as integer   no-undo .
     1158     run cur-time in this-procedure
     1159       (output v-date
     1160       ,output v-time
     1161       ) .
     1162     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1163   end.
     1164   function cur-time-datetime returns datetime
     1165   :
     1166     define variable v-char as character no-undo .
     1167     define variable v-datetime as datetime no-undo .
     1168     v-char = cur-time-string().
     1169     v-datetime = datetime(v-char).
     1170     return  v-datetime.
     1171   end.
     1172   function cur-time-string-msec returns character
     1173   :
     1174     define variable v-date as datetime  no-undo .
     1175     v-date = now.
     1176     return string(v-date) .
     1177   end.
     1178   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1179   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1180   define  shared variable RepPathName        as character no-undo .
