     2259     , input no
     2260     , input ?
     2261     ) no-error.
     2262           if error-status:error then do:
     2263             undo c-l, return error return-value.
     2264           end.
     2265       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     2266          crt_gds-dtl.ov then do:
     2267         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     2268       end.
     2269       if paruse-parts then do:
     2270          if first-of (tt-gds-dtl.prod-code) then do:
     2271            for each tt-parts :
     2272              assign
     2273                chg-qnty = tt-parts.fact-qnty
     2274                mem-qnty = chg-qnty.
     2275              assign
     2276              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     2277              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     2278            end.
     2279            assign
     2280              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     2281              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     2282            assign
     2283              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     2284              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     2285            if crt_gds-dtl.doc-qnty = 0 then do:
     2286              delete crt_gds-dtl.
     2287            end.
     2288          end.
     2289       end.
     2290       else do:
     2291         assign
     2292           chg-qnty = tt-gds-dtl.fact-qnty
     2293           mem-qnty = chg-qnty.
     2294         assign
     2295           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     2296           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     2297           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     2298           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     2299         assign
     2300         varchg-qnty  = varchg-qnty  + chg-qnty
     2301         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     2302         if crt_gds-dtl.doc-qnty = 0 then do:
     2303           delete crt_gds-dtl.
     2304         end.
     2305       end.
     2306     end.
     2307     if crt_doc-line.doc-qnty = 0 then do:
     2308       delete crt_doc-line.
     2309     end.
     2310   end.
     2311   end.
     2312   end procedure.
