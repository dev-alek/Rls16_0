     2368   run waitfram-show in this-procedure  ("Ждите...") .
     2369   for each obj-list :
     2370     for each g#customer :
     2371       for each buf_trn-doc no-lock where
     2372               buf_trn-doc.fact-date <= x-date-end    and
     2373               buf_trn-doc.fact-date >= x-date-start  and
     2374               buf_trn-doc.doc-type   = 'рас':U    and
     2375               buf_trn-doc.ext-doc-type = 'ee':U   and
     2376               buf_trn-doc.cli-type     = g#customer.obj-type  and
     2377               buf_trn-doc.cli-code     = g#customer.obj-code  and
     2378               buf_trn-doc.obj-type     = obj-list.obj-type    and
     2379               buf_trn-doc.obj-code     = obj-list.obj-code
     2380               :
     2381         run clear-tt .
     2382           run create-income (buf_trn-doc.doc-code) .
     2383         end.
     2384     end.
     2385   end.
     2386   run waitfram-hide in this-procedure .
     2387   message "Все" view-as alert-box information .
     2388   procedure create-income :
     2389   define input  parameter p-ex-doc-code as character no-undo .
     2390   define buffer bufe_trn-doc  for ub.trn-doc  .
     2391   define buffer bufe_doc-line for ub.doc-line  .
     2392   define buffer bufe_gds-dtl  for ub.gds-dtl  .
     2393   define buffer bufe_parts    for ub.parts  .
     2394   define buffer new_trn-doc  for ub.trn-doc  .
     2395   define buffer buf_doc-line for ub.doc-line  .
     2396   define buffer buf_gds-dtl  for ub.gds-dtl  .
     2397   define buffer buf_parts    for ub.parts  .
     2398   define buffer buf_sysconf for ub.sysconf  .
     2399   define variable v-vat-type as character no-undo .
     2400   define variable v-new-doc-code as character no-undo .
     2401   define variable varchg-inv as logical no-undo .
     2402     do
     2403     on error undo, return error return-value
     2404     :
     2405   find first buf_sysconf where buf_sysconf.host-code = v-cntxt-host-code-obj no-lock no-error .
     2406    find first bufe_trn-doc no-lock  where
     2407               bufe_trn-doc.doc-code = p-ex-doc-code no-error .
     2408       run doc-code in this-procedure
     2409         ( input  "main":U,
     2410           input  v-cntxt-obj-type,
     2411           input  v-cntxt-obj-code,
     2412           input  ? ,
     2413           output v-new-doc-code ) no-error.
     2414   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2415   empty temp-table thbjattr_thbj-attr.
     2416   run adm/shattri.p (
     2417      input "get":U
     2418     ,input v-cntxt-obj-type
     2419     ,input v-cntxt-obj-code
     2420     ,input 'nakl_par':U
     2421     ,input  ""
     2422     ,output v-value-character
     2423     ,output v-value-date
     2424     ,output v-value-decimal
     2425     ,output v-value-integer
     2426     ,output v-value-logical
     2427     ,output par-type
     2428     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2429     ) no-error .
     2430         for each thbjattr_thbj-attr :
     2431           if thbjattr_thbj-attr.prop-code = 'type-vat' then v-value-integer = thbjattr_thbj-attr.property-value-integer.
     2432         end.
     2433             case v-value-integer:
     2434             when 1 or when ? then do:
     2435               assign
     2436                 v-vat-type = 'в т. ч.':U.
     2437             end.
     2438             when 2 then do:
     2439               assign
     2440                 v-vat-type = 'нет':U.
     2441             end.
     2442             when 3 then do:
     2443               assign
     2444                 v-vat-type = 'без':U.
     2445             end.
     2446             otherwise do:
     2447                 message   substitute(" Не верно задан атрибут 'Тип заведения НДС' (type-vat). &1 &2 &3 &4 &5" , v-cntxt-obj-type , v-cntxt-obj-code , error-status :get-message(1) , return-value , v-value-integer ) .
     2448                 return error return-value .
     2449             end.
     2450             end case.
     2451       create  tt-trn-doc.
     2452       buffer-copy  bufe_trn-doc  to    tt-trn-doc
     2453         assign
     2454         tt-trn-doc.pay-code             = buf_sysconf.out-pay
     2455         tt-trn-doc.status_              = 'накл':U
     2456         tt-trn-doc.exch-date            = bufe_trn-doc.doc-date
