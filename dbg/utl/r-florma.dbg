      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      572   procedure factord :
      573     define input  parameter p-fact-date            as date    no-undo .
      574     define input  parameter p-fact-time            as integer no-undo .
      575     define input  parameter p-fact-num             as integer no-undo .
      576     define input  parameter p-shift-date           as date    no-undo .
      577     define input  parameter p-shift-num            as integer no-undo .
      578     define input  parameter p-shift-on             as logical no-undo .
      579     define output parameter p-fact-order           as decimal no-undo .
      580     define output parameter p-shift-end-fact-order as decimal no-undo .
      581     define output parameter p-day-end-fact-order   as decimal no-undo .
      582     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      583     if p-fact-date = ?
      584     then do:
      585       return error "Не указана фактическая дата" .
      586     end.
      587     define variable v-fact-date-num as integer no-undo .
      588     assign
      589       v-fact-date-num = integer(p-fact-date)
      590     .
      591     if p-fact-num = ?
      592     or p-fact-num = 0
      593     then do:
      594       return error "Не задан p-fact-num " + string(p-fact-num) .
      595     end.
      596     if p-fact-num < 0
      597     then do:
      598       return error "Отрицательный fact-num " + string(p-fact-num) .
      599     end.
      600     if p-fact-num >= 100000000
      601     then do:
      602       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      603     end.
      604     if p-shift-on = true
      605     then do:
      606       if p-shift-date = ?
      607       then do:
      608         return error "Не задана дата смены" .
      609       end.
      610       if p-shift-num = ?
      611       or p-shift-num = 0
      612       then do:
      613         return error "Не задан номер смены" .
      614       end.
      615     end.
      616     else do:
      617       assign
      618         p-shift-date = p-fact-date
      619         p-shift-num  = 24
      620       .
      621     end.
      622     define variable v-shift-offset as integer no-undo .
      623     if p-shift-date = p-fact-date
      624     then do:
      625       assign
      626         v-shift-offset = 1
      627       .
      628     end.
      629     if p-shift-date < p-fact-date
      630     then do:
      631       assign
      632         v-shift-offset = 0
      633       .
      634     end.
      635     if p-shift-date > p-fact-date
      636     then do:
      637       message
      638         vss-workfile vss-revision vss-description skip
      639         "Неправильная дата закрытия смены" skip
      640         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      641         view-as alert-box error .
      642       undo, return error
      643         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      644           ,string(p-fact-date, '99/99/9999':U)
      645           ,string(p-shift-date, '99/99/9999':U)
      646           )
      647       .
      648     end.
      649     if p-shift-num < 1
      650     or p-shift-num > 24
      651     then do:
      652       message
      653         vss-workfile vss-revision vss-description skip
      654         "Неправильный номер смены" skip
      655         "p-shift-num" p-shift-num skip
      656         view-as alert-box error .
      657       undo, return error return-value .
      658     end.
      659     assign
      660       p-fact-order           = v-fact-date-num
      661                              + v-shift-offset * 0.5
      662                              + p-shift-num    * 0.02 - 0.01
      663                              + p-fact-num     * 0.0000000001
      664       p-shift-end-fact-order = v-fact-date-num
      665                              + v-shift-offset * 0.5
      666                              + p-shift-num    * 0.02
      667       p-day-end-fact-order   = v-fact-date-num
      668                              + 0.99
      669     .
      670     if p-fact-order           <= v-fact-date-num
      671     or p-shift-end-fact-order <= v-fact-date-num
      672     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      673     or p-shift-end-fact-order >= p-day-end-fact-order
      674     then do:
      675       message
      676         vss-workfile vss-revision vss-description skip
      677         "Внутренняя ошибка при генерации фактического номера" skip
      678         "p-fact-date"            p-fact-date            skip
      679         "p-fact-time"            p-fact-time            skip
      680         "p-fact-num"             p-fact-num             skip
      681         "p-shift-date"           p-shift-date           skip
      682         "p-shift-num"            p-shift-num            skip
      683         "p-shift-on"             p-shift-on             skip
      684         "p-shift-end-fact-order" p-shift-end-fact-order skip
      685         "p-day-end-fact-order"   p-day-end-fact-order   skip
      686         "v-fact-date-num"        v-fact-date-num        skip
      687         view-as alert-box error .
      688       undo, return error return-value .
      689     end.
      690   end procedure.
      691   procedure day-begin-fact-order :
      692     define input  parameter p-fact-date            as date    no-undo .
      693     define output parameter p-day-begin-fact-order as decimal no-undo .
      694     do
      695     on error undo, return error return-value
      696     :
      697       if p-fact-date = ?
      698       then do:
      699         assign
      700           p-day-begin-fact-order = 0
      701         .
      702       end.
      703       else do:
      704         assign
      705           p-day-begin-fact-order = integer(p-fact-date)
      706         .
      707       end.
      708     end.
      709   end procedure.
      710   procedure factord-max-fact-order :
      711     define output parameter p-max-fact-order as decimal   no-undo .
      712     do
      713     on error undo, return error return-value
      714     :
      715       run day-begin-fact-order in this-procedure
      716         (input  date(1, 1, 5000)
      717         ,output p-max-fact-order
      718         ) .
      719     end.
      720   end procedure.
      721   procedure factord-cut-archive :
      722     define input  parameter p-obj-type             as character no-undo .
      723     define input  parameter p-obj-code             as integer   no-undo .
      724     define input  parameter p-fact-date            as date      no-undo .
      725     define output parameter p-shift-on             as logical   no-undo .
      726     define output parameter p-shift-date           as date      no-undo .
      727     define output parameter p-shift-num            as integer   no-undo .
      728     define output parameter p-day-end-fact-order   as decimal   no-undo .
      729     define output parameter p-shift-end-fact-order as decimal   no-undo .
      730     define variable v-fact-order as decimal   no-undo .
      731     define buffer buf_shift-obj for ub.shift-obj .
      732     do
      733     on error undo, return error return-value
      734     :
      735   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      737     (input  p-obj-type
      738     ,input  p-obj-code
      739     ,input  'shift-on=request'
      740     ,output p-shift-on
      741     ) no-error .
      742       if error-status :error
      743       then do:
      744         message
      745           vss-workfile vss-revision vss-description skip
      746           "Ошибка при определении атрибута объекта" skip
      747           "Объект" p-obj-type p-obj-code skip
      748           error-status :get-message(1) skip
      749           return-value skip
      750           view-as alert-box error .
      751         undo, return error return-value .
      752       end.
      753       if p-shift-on = false
      754       then do:
      755         assign
      756           p-shift-date               = ?
      757           p-shift-num                = 0
      758         .
      759       end.
      760       else do:
      761         find first buf_shift-obj share-lock
      762           where buf_shift-obj.obj-type   = p-obj-type
      763             and buf_shift-obj.obj-code   = p-obj-code
      764             and buf_shift-obj.shift-date > p-fact-date
      765           use-index pi
      766           no-error .
      767         if not available buf_shift-obj
      768         or buf_shift-obj.status_ <> 'зкр':U
      769         then do:
      770           message
      771             vss-workfile vss-revision vss-description skip
      772             "Невозможно вычислить последнюю смену" skip
      773             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      774             "Объект" p-obj-type p-obj-code skip
      775             "Дата" p-fact-date skip
      776             view-as alert-box error .
      777           undo, return error return-value .
      778         end.
      779         find last buf_shift-obj share-lock
      780           where buf_shift-obj.obj-type = p-obj-type
      781             and buf_shift-obj.obj-code = p-obj-code
      782             and buf_shift-obj.shift-date <= p-fact-date
      783           use-index pi
      784           no-error .
      785         if available buf_shift-obj
      786         then do:
      787           if  buf_shift-obj.status_ = 'зкр':U
      788           then do:
      789             assign
      790               p-shift-date = buf_shift-obj.shift-date
      791               p-shift-num  = buf_shift-obj.shift-num
      792             .
      793           end.
      794           else do:
      795             message
      796               vss-workfile vss-revision vss-description skip
      797               "Невозможно вычислить последнюю смену" skip
      798               "Статус смены отличен от статуса" 'зкр':U skip
      799               "Объект" p-obj-type p-obj-code skip
      800               "Дата" p-fact-date skip
      801               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      802               view-as alert-box error .
      803             undo, return error return-value .
      804           end.
      805         end.
      806         else do:
      807           assign
      808             p-shift-date = p-fact-date - 1
      809             p-shift-num  = 1
      810           .
      811         end.
      812       end.
      813       run factord in this-procedure
      814         (input  p-fact-date
      815         ,input  1
      816         ,input  1
      817         ,input  p-shift-date
      818         ,input  p-shift-num
      819         ,input  p-shift-on
      820         ,output v-fact-order
      821         ,output p-shift-end-fact-order
      822         ,output p-day-end-fact-order
      823         ) no-error .
      824       if error-status :error
      825       then do:
      826         message
      827           vss-workfile vss-revision vss-description skip
      828           "Ошибка при вызове процедуры factord"
      829           error-status :get-message(1) skip
      830           return-value skip
      831           view-as alert-box error .
      832         undo, return error return-value .
      833       end.
      834     end.
      835   end procedure.
      836   procedure factord-lock-shift :
      837     define input  parameter p-obj-type  as character no-undo .
      838     define input  parameter p-obj-code  as integer   no-undo .
      839     define input  parameter p-fact-date as date      no-undo .
      840     define parameter buffer buf_shift-obj for ub.shift-obj .
      841     define variable v-shift-on      as logical   no-undo .
      842     define variable v-extra-message as character no-undo .
      843     define variable v-error as character no-undo .
      844     do
      845     on error undo, return error return-value
      846     :
      847   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      849     (input  p-obj-type
      850     ,input  p-obj-code
      851     ,input  'shift-on=request'
      852     ,output v-shift-on
      853     ) no-error .
      854       if error-status :error
      855       then do:
      856         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      857         undo, return error v-error .
      858       end.
      859       if v-shift-on = true
      860       then do:
      861         find first buf_shift-obj share-lock
      862           where buf_shift-obj.obj-type   = p-obj-type
      863             and buf_shift-obj.obj-code   = p-obj-code
      864             and buf_shift-obj.shift-date > p-fact-date
      865           use-index pi
      866           no-error .
      867         if not available buf_shift-obj
      868         or buf_shift-obj.status_ <> 'зкр':U
      869         then do:
      870           find last buf_shift-obj
      871             where buf_shift-obj.obj-type = p-obj-type
      872               and buf_shift-obj.obj-code = p-obj-code
      873               and buf_shift-obj.status_  = 'зкр':U
      874             use-index stts
      875             no-error .
      876           if available buf_shift-obj
      877           then do:
      878             assign
      879               v-extra-message =
      880                     substitute("Дата начала последеней закрытой смены на объекте &1"
      881                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      882                               )
      883             .
      884           end.
      885           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      886           undo, return error v-error .
      887         end.
      888       end.
      889     end.
      890   end procedure.
      891   procedure factord-end-day :
      892     define input  parameter p-fact-date            as date    no-undo .
      893     define output parameter p-day-end-fact-order   as decimal no-undo .
      894     do
      895     on error undo, return error return-value
      896     :
      897       if p-fact-date = ?
      898       then do:
      899         return error "Не указана фактическая дата" .
      900       end.
      901       assign
      902         p-day-end-fact-order = integer(p-fact-date) + 0.99
      903       .
      904     end.
      905   end procedure.
      906   procedure factord-to-date :
      907     define input  parameter p-fact-order as decimal no-undo .
      908     define output parameter p-fact-date  as date    no-undo .
      909     define variable v-ref-date  as date      no-undo .
      910     define variable v-ref-delta as integer   no-undo .
      911     do
      912     on error undo, return error return-value
      913     :
      914       if p-fact-order = ?
      915       or p-fact-order = 0
      916       then do:
      917         return error "Не указан fact-order" .
      918       end.
      919       assign
      920         v-ref-date  = date(1, 1, 2000)
      921       .
      922       assign
      923         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      924       .
      925       assign
      926         p-fact-date = v-ref-date + v-ref-delta
      927       .
      928     end.
      929   end procedure.
      930   procedure factord-to-fact-num :
      931     define input  parameter p-fact-order as decimal no-undo .
      932     define output parameter p-fact-num   as integer no-undo .
      933     define variable v-fact-order-trunc as decimal no-undo .
      934     do
      935     on error undo, return error return-value
      936     :
      937       if p-fact-order = ?
      938       or p-fact-order = 0
      939       then do:
      940         return error "Не указан fact-order" .
      941       end.
      942       assign
      943        v-fact-order-trunc = truncate(p-fact-order, 2)
      944       .
      945       assign
      946         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      947       .
      948     end.
      949   end procedure.
      950   procedure factord-to-shift-num :
      951     define input  parameter p-fact-order as decimal no-undo .
      952     define output parameter p-shift-num   as integer no-undo .
      953     define variable  p-shift-numd  as decimal   no-undo .
      954     define variable v-fact-order-trunc as decimal no-undo .
      955     do
      956     on error undo, return error return-value
      957     :
      958       if p-fact-order = ?
      959       or p-fact-order = 0
      960       then do:
      961         return error "Не указан fact-order" .
      962       end.
      963       assign
      964        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      965       .
      966       if v-fact-order-trunc < 0.5 then do:
      967         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      968       end.
      969       assign
      970         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      971         .
      972        assign
      973         p-shift-num = truncate (p-shift-numd , 0)
      974       .
      975     end.
      976   end procedure.
