     2464         tt-trn-doc.slt-type             = 'без':U
     2465         tt-trn-doc.office               = false
     2466         tt-trn-doc.fact-num             = 0
     2467         tt-trn-doc.out-code             = ""
     2468         tt-trn-doc.creid                = v-cntxt-userid
     2469         tt-trn-doc.flag_                = false
     2470         tt-trn-doc.ext-doc-type         = 'ie':U
     2471         tt-trn-doc.discnt-type          = ""
     2472         tt-trn-doc.ret-supp             = false
     2473         tt-trn-doc.print-rubl           = true
     2474         tt-trn-doc.hold-doc-code-child  = "no-hold":u
     2475         tt-trn-doc.hold-doc-code-parent = "no-hold":u
     2476         tt-trn-doc.obj-type             = v-cntxt-obj-type
     2477         tt-trn-doc.obj-code             = v-cntxt-obj-code
     2478       .
     2479   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2481     (input  v-cntxt-obj-type
