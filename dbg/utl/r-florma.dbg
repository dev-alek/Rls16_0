     2680    ,input no
     2681    ,input no
     2682    ,input yes
     2683    ,input this-procedure
     2684     ) no-error .
     2685             if error-status :error then do:
     2686                message
     2687                  vss-workfile vss-revision vss-description skip
     2688                  error-status :get-message(1) skip
