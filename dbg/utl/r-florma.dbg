     2499   ,input tt-trn-doc.flag_
     2500   ,input tt-trn-doc.host-code
     2501   ,input tt-trn-doc.internal
     2502   ,input tt-trn-doc.obj-code
     2503   ,input tt-trn-doc.obj-type
     2504   ,input tt-trn-doc.office
     2505   ,input tt-trn-doc.pay-code
     2506   ,input tt-trn-doc.ps
     2507   ,input tt-trn-doc.ret-supp
     2508   ,input tt-trn-doc.slt-type
     2509   ,input tt-trn-doc.status_
     2510   ,input tt-trn-doc.vat-type
     2511   ,input tt-trn-doc.ext-doc-type
     2512   ,input buf_sysconf.purch-code
     2513   ) no-error
     2514   .
     2515         .
     2516        if error-status :error then do:
     2517           message
     2518             vss-workfile vss-revision vss-description skip
     2519             error-status :get-message(1) skip
     2520             return-value skip
     2521             "str/crtrndoc.i"
     2522             view-as alert-box error
     2523           .
     2524        end.
     2525       find first new_trn-doc where new_trn-doc.doc-code = v-new-doc-code  exclusive-lock no-error .
     2526       if not available new_trn-doc then do:
     2527         message  substitute(" Ошибка &1" , error-status :get-message(1)  , return-value ) .
     2528         return error .
     2529       end.
     2530     for each  bufe_doc-line  no-lock  where
     2531               bufe_doc-line.doc-code = bufe_trn-doc.doc-code by bufe_doc-line.line-num :
     2532      find first buf_goods no-lock where
     2533                 buf_goods.artic     = bufe_doc-line.artic     and
     2534                 buf_goods.prod-type = bufe_doc-line.prod-type and
     2535                 buf_goods.prod-code = bufe_doc-line.prod-code no-error .
     2536   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2538     (input  tt-trn-doc.obj-type
     2539     ,input  tt-trn-doc.obj-code
     2540     ,input  buf_goods.artic
     2541     ,input  buf_goods.prod-type
     2542     ,input  buf_goods.prod-code
     2543     ,buffer ub.gds-obj
     2544     ) no-error .
     2545         if not available ub.gds-obj then do:
     2546           find first ub.gds-obj no-lock where
     2547                 ub.gds-obj.obj-type = new_trn-doc.obj-type and
     2548                 ub.gds-obj.obj-code = new_trn-doc.obj-code and
     2549                 ub.gds-obj.gds-code = buf_goods.gds-code no-error .
     2550                 if not available ub.gds-obj then do:
     2551                     message  substitute("Товар &1 &2 &3  &4 &5" ,
     2552                                       buf_goods.gds-code,
     2553                                       buf_goods.artic,
     2554                                       buf_goods.gds-name,
     2555                                       error-status :get-message(1) ,
     2556                                       return-value  ) .
     2557                     undo, return error .
     2558                 end.
     2559         end.
     2560         if ub.gds-obj.inv-on = true then do:
     2561               message  substitute("Товар &1 &2 &3  находится в инвентаризации. Прием документов невозможен." ,
     2562                                 buf_goods.gds-code ,
     2563                                 buf_goods.artic ,
     2564                                 buf_goods.gds-name
     2565                                 ) .
     2566               undo, return error .
     2567         end.
     2568           create tt2-doc-line .
     2569           BUFFER-COPY bufe_doc-line  to tt2-doc-line
     2570             assign
     2571               tt2-doc-line.cli-qnty       = bufe_doc-line.fact-qnty
     2572               tt2-doc-line.doc-qnty       = bufe_doc-line.fact-qnty
     2573               tt2-doc-line.fact-qnty      = bufe_doc-line.fact-qnty
     2574               tt2-doc-line.price-cli      = bufe_doc-line.price-rubl
     2575               tt2-doc-line.price-rubl     = bufe_doc-line.price-rubl
     2576               tt2-doc-line.price-base     = bufe_doc-line.price-base
     2577               tt2-doc-line.doc-code       = v-new-doc-code
     2578               tt2-doc-line.status_        = 'накл':U
     2579               tt2-doc-line.ext-doc-type   = 'ie':U
     2580               tt2-doc-line.slt-pc         = 0
     2581               tt2-doc-line.cli-base-rate  = 1
     2582               tt2-doc-line.line-num       = next-value (s-line-num, ub)
     2583               tt2-doc-line.unit-cli       = buf_goods.unit-base
     2584               tt2-doc-line.doc-density    = 1
     2585               tt2-doc-line.fact-density   = 1
     2586               tt2-doc-line.obj-code       = new_trn-doc.obj-code
     2587               tt2-doc-line.obj-type       = new_trn-doc.obj-type
     2588               .
     2589             for each bufe_gds-dtl no-lock where
     2590                      bufe_gds-dtl.doc-code  =  bufe_trn-doc.doc-code and
     2591                      bufe_gds-dtl.artic     =  bufe_doc-line.artic and
     2592                      bufe_gds-dtl.prod-type =  bufe_doc-line.prod-type and
     2593                      bufe_gds-dtl.prod-code =  bufe_doc-line.prod-code
     2594                      :
     2595                     create tt-gds-dtl.
     2596                     BUFFER-COPY bufe_gds-dtl  to tt-gds-dtl
     2597                       assign
     2598                         tt-gds-dtl.doc-code     = v-new-doc-code
     2599                         tt-gds-dtl.doc-qnty     = bufe_gds-dtl.fact-qnty
     2600                         tt-gds-dtl.fact-qnty    = bufe_gds-dtl.fact-qnty
     2601                         tt-gds-dtl.price-base   = bufe_gds-dtl.price-base
     2602                         tt-gds-dtl.price-rubl   = bufe_gds-dtl.price-rubl
     2603                         tt2-doc-line.price-cli  = bufe_gds-dtl.price-rubl
     2604                         tt2-doc-line.price-rubl = bufe_gds-dtl.price-rubl
     2605                         tt2-doc-line.price-base = bufe_gds-dtl.price-base
     2606                         tt-gds-dtl.obj-code     = new_trn-doc.obj-code
     2607                         tt-gds-dtl.obj-type     = new_trn-doc.obj-type
     2608                         .
     2609               end.
     2610         create tt-parts.
     2611         buffer-copy tt2-doc-line except tt2-doc-line.status_ to tt-parts .
     2612           assign
     2613             tt-parts.prod-type      = tt2-doc-line.prod-type
     2614             tt-parts.prod-code      = tt2-doc-line.prod-code
     2615             tt-parts.artic          = tt2-doc-line.artic
     2616             tt-parts.in-code        = new_trn-doc.doc-code
     2617             tt-parts.out-code       = new_trn-doc.doc-code
     2618             tt-parts.price-cli      = tt2-doc-line.price-rubl
     2619             tt-parts.price-rubl     = tt2-doc-line.price-rubl
     2620             tt-parts.price-base     = tt2-doc-line.price-base
     2621             tt-parts.qnty           = tt2-doc-line.fact-qnty
     2622             tt-parts.obj-type       = new_trn-doc.obj-type
     2623             tt-parts.obj-code       = new_trn-doc.obj-code
     2624             tt-parts.fact-date      = new_trn-doc.fact-date
     2625             tt-parts.fact-num       = new_trn-doc.fact-num
     2626             tt-parts.VAT-pc         = tt2-doc-line.vat-pc
     2627             tt-parts.part-code      = ""
     2628             tt-parts.PS             = ""
