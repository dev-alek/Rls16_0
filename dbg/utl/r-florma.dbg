     1785   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1786   function octal-to-char return character
     1787   ( p-string as character ) :
     1788     def var v-asc     as integer no-undo .
     1789     def var v-new-asc as integer no-undo .
     1790     def var ind       as integer no-undo .
     1791     if length(p-string) <> 3 then do:
     1792       return ? .
     1793     end.
     1794     assign
     1795       v-asc = 0
     1796     .
     1797     do ind = 1 to length(p-string)
     1798     :
     1799       assign
     1800         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     1801       .
     1802       if v-new-asc < 0 or v-new-asc >= 8 then do:
     1803         return ? .
     1804       end.
     1805       assign
     1806         v-asc = v-asc * 8 + v-new-asc
     1807       .
     1808     end.
     1809     return chr(v-asc) .
     1810   end function .
     1811   function char-to-octal return character
     1812   ( p-chr as character ) :
     1813     def var v-asc    as integer   no-undo .
     1814     def var ind      as integer   no-undo .
     1815     def var v-string as character no-undo .
     1816     if length(p-chr) <> 1 then do:
     1817       return ? .
     1818     end.
     1819     assign
     1820       v-asc    = asc(p-chr)
     1821       v-string = ""
     1822     .
     1823     do ind = 1 to 3
     1824     :
     1825       assign
     1826         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     1827       .
     1828       assign
     1829         v-asc = truncate(v-asc / 8, 0)
     1830       .
     1831     end.
     1832     return v-string .
     1833   end.
     1834   function str-encode return character
     1835   (   p-init-string       as character
     1836     , p-encode-char       as character
     1837     , p-special-char-list as character
     1838   ) :
     1839     def var p-encode-string as character no-undo .
     1840     def var ind                as integer no-undo .
     1841     def var v-num-special-char as integer no-undo .
     1842     def var v-special-char     as character no-undo .
     1843     if p-encode-char = ?
     1844     or p-encode-char = "" then do:
     1845       assign
     1846         p-encode-char = "~~"
     1847       .
     1848     end.
     1849     if p-init-string = ? then do:
     1850       return "?" .
     1851     end.
     1852     if p-init-string = "?" then do:
     1853       return p-encode-char + char-to-octal("?") .
     1854     end.
     1855     assign
     1856       v-num-special-char = length(p-special-char-list)
     1857       p-encode-string    = replace(p-init-string
     1858                                   ,p-encode-char
     1859                                   ,p-encode-char + char-to-octal(p-encode-char)
     1860                                   )
     1861     .
     1862     do ind = 1 to v-num-special-char
     1863     :
     1864       assign
     1865         v-special-char = substring(p-special-char-list, ind, 1)
     1866       .
     1867       if v-special-char <> p-encode-char then do:
     1868         assign
     1869           p-encode-string = replace (p-encode-string
     1870                                     ,v-special-char
     1871                                     ,p-encode-char + char-to-octal(v-special-char)
     1872                                     )
     1873         .
     1874       end.
     1875     end.
     1876     return p-encode-string .
     1877   end.
     1878   function str-decode returns character
     1879     (p-init-string   as character
     1880     ,p-encode-char   as character
     1881     ) :
     1882     def var p-decode-string as character no-undo .
     1883     def var ind                       as integer no-undo .
     1884     def var v-num-entries-init-string as integer no-undo .
     1885     def var v-sub-phrase              as character no-undo .
     1886     def var v-special-char            as character no-undo .
     1887     if p-encode-char = ?
     1888     or p-encode-char = "" then do:
     1889       assign
     1890         p-encode-char = "~~"
     1891       .
     1892     end.
     1893     if p-init-string = "?" then do:
     1894       return ? .
     1895     end.
     1896     assign
     1897       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     1898     .
     1899     if v-num-entries-init-string > 1 then do:
     1900       assign
     1901         p-decode-string = entry(1, p-init-string, p-encode-char)
     1902       .
     1903       do ind = 2 to v-num-entries-init-string
     1904       :
     1905         assign
     1906           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     1907         .
     1908         assign
     1909           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     1910         .
     1911         if v-special-char <> ? then do:
     1912           assign
     1913             p-decode-string = p-decode-string
     1914                             + v-special-char
     1915                             + substring(v-sub-phrase, 4)
     1916           .
     1917         end.
     1918         else do:
     1919           assign
     1920             p-decode-string = p-decode-string
     1921                             + p-encode-char
     1922                             + v-sub-phrase
     1923           .
     1924         end.
     1925       end.
     1926     end.
     1927     else do:
     1928       assign
     1929         p-decode-string = p-init-string
     1930       .
     1931     end.
     1932     return p-decode-string .
     1933   end.
