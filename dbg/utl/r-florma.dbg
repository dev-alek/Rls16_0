     1943   function hvrdtax return logical (input parrecid as recid):
     1944   define variable varresult as logical no-undo.
     1945   run hvrdtax-proc (input parrecid, output varresult).
     1946   return varresult.
     1947   end function.
     1948   procedure hvrdtax-proc:
     1949   define input  parameter parrecid  as recid   no-undo.
     1950   define output parameter parresult as logical no-undo.
     1951   define buffer bf_goods for ub.goods.
     1952   define buffer bf_units for ub.units.
     1953   define buffer rt_tax   for ub.tax.
     1954   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1955   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1956   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1957   if available rt_tax and
     1958       can-find(first ub.tax-units No-LOCK WHERE
     1959                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1960                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1961                                                       else assign parresult = no.
     1962   end procedure.
     1963   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1964   define new global shared variable g#lib-calc as handle no-undo .
     1965   procedure plgdsfnd :
     1966     define input  parameter p-chk-and-chs    as logical               no-undo .
     1967     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1968     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1969     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1970     define output parameter p-reserv-pl-code as   logical             no-undo .
     1971     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1972     define buffer buf_goods         for ub.goods .
     1973     define buffer buf_pl-gds        for ub.pl-gds .
     1974     define buffer buf_second_pl-gds for ub.pl-gds .
     1975     find first buf_goods no-lock where
     1976                buf_goods.gds-code = p-gds-code no-error .
     1977     if not available buf_goods
     1978     then do:
     1979       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1980     end.
     1981   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1982   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1983     (input  p-obj-type
     1984     ,input  p-obj-code
     1985     ,input  buf_goods.artic
     1986     ,input  buf_goods.prod-type
     1987     ,input  buf_goods.prod-code
     1988     ,input  'place-rsrv=request'
     1989     ,output p-reserv-pl-code
     1990     ) no-error .
     1991     if error-status :error
     1992     then do:
     1993       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1994     end.
     1995     if p-reserv-pl-code = no
     1996     then do:
     1997       return .
     1998     end.
     1999     if p-chk-and-chs <> yes
     2000     then do:
     2001       return .
     2002     end.
     2003     find first buf_pl-gds no-lock where
     2004                buf_pl-gds.obj-type = p-obj-type and
     2005                buf_pl-gds.obj-code = p-obj-code and
     2006                buf_pl-gds.gds-code = p-gds-code no-error .
     2007     if not available buf_pl-gds
     2008     then do:
     2009       return error "К товару не привязано ни одного места хранения" .
     2010     end.
     2011     find first buf_second_pl-gds no-lock where
     2012                buf_second_pl-gds.obj-type  = p-obj-type          and
     2013                buf_second_pl-gds.obj-code  = p-obj-code          and
     2014                buf_second_pl-gds.gds-code  = p-gds-code          and
     2015                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     2016     if not available buf_second_pl-gds
     2017     then do:
     2018       assign
     2019         p-pl-code = buf_pl-gds.pl-code
     2020       .
     2021     end.
     2022     else do:
     2023       if not valid-handle( parparentproc )
     2024       then do:
     2025         return error "Не выбрано место хранения " + chr(10) .
     2026       end.
     2027       run str/plgdssel.p
     2028         (
     2029            input parparentproc
     2030         ,  input p-obj-type
     2031         ,  input p-obj-code
     2032         ,  input p-gds-code
     2033         , output p-pl-code
     2034         ) no-error .
     2035       if error-status :error
     2036       then do:
     2037         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     2038                                , 'plgdssel.p':U
     2039                                , chr(10)
     2040                                , error-status :get-message( 1 )
     2041                                , return-value
     2042                                ) .
     2043       end.
     2044       if p-pl-code = ? or
     2045          p-pl-code = 0
     2046       then do:
     2047         return error "Не выбрано место хранения " + chr(10) .
     2048       end.
     2049     end.
     2050   end procedure.
