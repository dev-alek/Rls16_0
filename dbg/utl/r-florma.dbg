     1117   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1118   define variable v-waitfram-action01         as character   no-undo .
     1119   define variable v-waitfram-action02         as character   no-undo .
     1120   define variable v-waitfram-action03         as character   no-undo .
     1121   define variable mWaitFramTextBeg            as character   no-undo.
     1122   define variable mWaitFramTextEnd            as character   no-undo.
     1123   define variable mWaitFramView               as logical     no-undo.
     1124   define variable mWaitProcEvent              as logical     no-undo init yes.
     1125   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1126   define variable mWaitFramStop               as logical     no-undo.
     1127   define variable mWaitFramStopUser           as logical     no-undo.
     1128   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1129   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1130   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1131   define button B-WaitFramStop auto-end-key
     1132        label "Стоп"
     1133        size 10 by 1 tooltip "Остоновить процесс".
     1134   define button B-viewProcInfo
     1135        label "Информация"
     1136        size 15 by 1 tooltip "Информация о процесс".
     1137   define frame waitfram
     1138     v-waitfram-action01 format "x(72)" no-label skip
     1139     v-waitfram-action02 format "x(72)" no-label skip
     1140     v-waitfram-action03 format "x(72)" no-label skip
     1141     B-viewProcInfo
     1142     B-WaitFramStop at row 4 col 30
     1143     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1144     .
     1145   define new global shared variable mBatchMode as logical no-undo init ?.
     1146   define variable mFramBachModHandle as handle no-undo.
     1147   mFramBachModHandle = frame waitfram:handle.
     1148   define variable mFameOldVis as logical no-undo.
     1149   define variable mVisCUrentVin as logical no-undo.
     1150   if session:batch-mode
     1151   then
     1152      mBatchMode = yes.
     1153   if mBatchMode = ? then do:
     1154     mVisCUrentVin = current-window:visible.
     1155     mFameOldVis = mFramBachModHandle:visible.
     1156     mFramBachModHandle:visible  = yes.
     1157     mBatchMode = mFramBachModHandle:visible ne yes.
     1158     mFramBachModHandle:visible = mFameOldVis.
     1159     current-window:visible = mVisCUrentVin.
     1160   end.
     1161    if  log-manager:logfile-name ne ?
     1162     then DO:
     1163         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1164         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1165         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1166     end.
     1167   on choose of B-WaitFramStop in frame waitfram
     1168   do:
     1169     mWaitFramStop = yes.
     1170     mWaitFramStopUser = yes.
     1171   end.
     1172   function waitfram-check-timeout returns logical():
     1173      define variable vtime as int64 no-undo.
     1174      if mWaitFramStopTimeOut
     1175      then
     1176         return yes.
     1177      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1178      if     mWaitFramTimeOut ne ?
     1179         and mWaitFramTimeOut ne 0
     1180         and mWaitFramTimeOut lt vtime
     1181      then do:
     1182         mWaitFramStopTimeOut = yes.
     1183      end.
     1184      return mWaitFramStopTimeOut.
     1185   end.
     1186   procedure waitfram-hide :
     1187     if not session:batch-mode
     1188     then do
     1189     on error undo, return error return-value
     1190     :
     1191       pause 0 before-hide .
     1192       if not mBatchMode then
     1193         hide frame waitfram .
     1194     if     not mWaitFramView
     1195        and mWaitProcEvent
     1196     then
     1197       process events .
     1198     end.
     1199   end procedure.
     1200   procedure waitfram-show :
     1201     define input  parameter p-message as character no-undo .
     1202     define variable v-left-margin as integer   no-undo .
     1203     if not session:batch-mode
     1204     then do
     1205     on error undo, return error return-value
     1206     :
     1207       if length(p-message) <= 70 then do:
     1208         assign
     1209           v-left-margin = integer((70 - length(p-message)) / 2)
     1210         .
     1211         assign
     1212           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1213         .
     1214         assign
     1215           v-waitfram-action01 = " "
     1216           v-waitfram-action02 = " "
     1217                                    + fill(" ", v-left-margin)
     1218                                    + p-message
     1219           v-waitfram-action03 = " "
     1220         .
     1221       end.
     1222       else do:
     1223         define variable vRindex1 as integer no-undo.
     1224         define variable vRindex2 as integer no-undo.
     1225         vRindex1 = r-index(p-message," ",70).
     1226         if vRindex1 = 0
     1227         then
     1228            vRindex1 = 70.
     1229         if length(p-message)  <= vRindex1 + 70 then do:
     1230           assign
     1231             v-waitfram-action01 = " "
     1232             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1233             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1234           .
     1235         end.
     1236         else do:
     1237           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1238           if vRindex2 <= vRindex1
     1239           then
     1240              vRindex2 = vRindex1 + 70.
     1241           assign
     1242             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1243             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1244             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1245           .
     1246         end.
     1247       end.
     1248       B-viewProcInfo:visible   in frame waitfram = no.
     1249       B-viewProcInfo:sensitive in frame waitfram = no.
     1250       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1251       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1252       if  (   mWaitFramView
     1253          or  mWaitProcEvent)
     1254          and not mBatchMode
     1255       then
     1256          display
     1257             v-waitfram-action01 skip
     1258             v-waitfram-action02 skip
     1259             v-waitfram-action03 skip
     1260          with frame waitfram .
     1261       if     mWaitFramView
     1262          then do:
     1263             if     mWaitFramInterval ne ?
     1264                and not mBatchMode
     1265             then
     1266                wait-for go of frame waitfram pause mWaitFramInterval.
     1267          end.
     1268          else
     1269             if     mWaitProcEvent
     1270                and not mBatchMode
     1271             then
     1272                process events .
     1273     end.
     1274   end procedure.
     1275      procedure waitfram-show-this:
     1276         define input  parameter iInterval as int64 no-undo.
     1277         define variable vtime as int64 no-undo.
     1278         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1279         mWaitFramInterval = iInterval.
     1280         run waitfram-show (substitute("&1&2 &3&4" ,
     1281                                       mWaitFramTextBeg ,
     1282                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1283                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1284                                       mWaitFramTextEnd
     1285                                      )
     1286                           ).
     1287      end.
     1288      procedure WaitFramRunPause:
     1289         define input  parameter iInterval as dec no-undo.
     1290         define variable vStart  as datetime-tz no-undo.
     1291         define variable vend    as datetime-tz no-undo.
     1292         define variable vint as int64 no-undo.
     1293         define variable vOk as logical no-undo.
     1294         vStart = now.
     1295         vend   = vStart.
     1296         publish "WaitFramPause" (iInterval,output vOk).
     1297         vend   =  now.
     1298         vint = vend - vStart.
     1299         vint = iInterval - vint / 1000.
     1300         if     not mWaitFramStop
     1301            and (   vint > 0
     1302                 or (    not vOk
     1303                     and iInterval eq ?
     1304                     )
     1305                 )
     1306         then
     1307            run waitfram-show-this (iInterval).
     1308         vend   =  now.
     1309         vint = vend - vStart.
     1310         vint = iInterval - vint / 1000.
     1311         if     not mWaitFramStop
     1312            and vint > 0
     1313         then do:
     1314            run gbl/pause.p (vint * 1000).
     1315         end.
     1316         if iInterval ne ?
     1317         then
     1318            publish "WaitFramStop".
     1319         waitfram-check-timeout().
     1320      end.
     1321      procedure WaitFramWaitFor:
     1322         define input  parameter iInterval as dec no-undo.
     1323         assign
     1324            mWaitFramStartProc   = now
     1325            mWaitFramStopUser    = no
     1326            mWaitFramStopTimeOut = no
     1327         .
     1328         block-wait:
     1329         do while not mWaitFramStop:
     1330            run WaitFramRunPause (iInterval).
     1331            if  waitfram-check-timeout()
     1332            then do:
     1333               leave block-wait.
     1334            end.
     1335         end.
     1336         run waitfram-hide.
     1337      end.
     1338   procedure waitfram-join :
     1339     define input  parameter p-line-1  as character no-undo .
     1340     define input  parameter p-line-2  as character no-undo .
     1341     define input  parameter p-line-3  as character no-undo .
     1342     define output parameter p-message as character no-undo .
     1343     do
     1344     on error undo, return error return-value
     1345     :
     1346       assign
     1347         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1348                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1349                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1350       .
     1351     end.
     1352   end procedure.
     1353   function waitfram-join-function returns character
     1354     (input p-line-1 as character
     1355     ,input p-line-2 as character
     1356     ,input p-line-3 as character
     1357     ).
     1358     define variable v-message as character no-undo .
     1359     run waitfram-join in this-procedure
     1360       (input  p-line-1
     1361       ,input  p-line-2
     1362       ,input  p-line-3
     1363       ,output v-message
     1364       ) .
     1365     return v-message .
     1366   end function .
     1367   define new global shared variable g#lib-trn  as handle no-undo .
     1368   define new global shared variable g#lib-trn2 as handle no-undo .
     1369   define new global shared variable g#lib-trn3 as handle no-undo .
     1370   define new global shared variable g#lib-trn4 as handle no-undo .
     1371   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   procedure doc-code:
     1373   define input  parameter parmode          as   character           no-undo.
     1374   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1375   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1376   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1377   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1378   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1379   define variable vardb-remote     as   logical             no-undo.
     1380   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1381   define variable v-delimiter as character no-undo .
     1382   do
     1383   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1384   :
     1385   find first buf_sys-ctrl no-lock .
     1386   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1387     CASE parmode:
     1388       when "main":u then do:
     1389         if vardb-remote then do:
     1390           assign
     1391             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1392         end.
     1393         else do:
     1394           assign
     1395             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1396         end.
     1397       end.
     1398       when "trio" then do:
     1399         assign
     1400           pardoc-code = replace (parroot-doc-code, "=", "*").
     1401       end.
     1402       otherwise do:
     1403         assign
     1404         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1405         no-error
     1406         .
     1407         if error-status:error  then do:
     1408           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1409                                         ,chr(10)
     1410                                         ,parmode
     1411                                         ).
     1412         end.
     1413         if num-entries(parmode) = 1
     1414         and parmode <> "chip":U
     1415         and parmode <> "chip_s":U
     1416         then do:
     1417           assign
     1418           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1419         end.
     1420         else if (lookup("chip":U, parmode) > 0
     1421                  or
     1422                  lookup("chip_s":U, parmode) > 0) then do:
     1423           assign
     1424             vartemp-doc-code = parroot-doc-code.
     1425           do while true:
     1426             if index (vartemp-doc-code , ".") = 0 then
     1427               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1428             else
     1429               vartemp-doc-code  =
     1430               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1431               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1432               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1433             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1434           end.
     1435           assign
     1436             pardoc-code = vartemp-doc-code.
     1437         end.
     1438       end.
     1439     end CASE.
     1440     if pardoc-code = '':U
     1441     or (parroot-doc-code <> '':U
     1442     and pardoc-code = parroot-doc-code) then do:
     1443       undo, return error substitute("Ошибка при генерации номера документа&1"
     1444                                     ,chr(10)).
     1445     end.
     1446   end.
     1447   end. // procedure/method
     1448   function get-doc-code-int64 returns int64
     1449     ( input p-doc-code as character ) :
     1450     define variable v-ind              as integer   no-undo .
     1451     define variable v-num-entries      as integer   no-undo .
     1452     define variable v-doc-code-int64   as int64     no-undo .
     1453     define variable v-canonic-doc-code as character no-undo .
     1454     assign
     1455       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1456       v-canonic-doc-code = p-doc-code
     1457     .
     1458     do v-ind = 1 to v-num-entries
     1459     :
     1460       assign
     1461         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1462       .
     1463     end.
     1464     assign
     1465       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1466     .
     1467     return v-doc-code-int64 .
     1468   end. // function/method
     1469   function cross-list returns logical (
     1470     input parfirst-stream  as character,
     1471     input parsecond-stream as character,
     1472     input pardelim         as character).
     1473     if pardelim = ""
     1474     or pardelim = ?
     1475     then do:
     1476       assign
     1477         pardelim = ","
     1478       .
     1479     end.
     1480     define variable vari            as integer no-undo .
     1481     define variable varresult-cross as logical no-undo .
     1482     assign
     1483       varresult-cross = no
     1484     .
     1485     def var v-num-parfirst-stream as integer no-undo .
     1486     assign
     1487       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
     1488     .
     1489     do vari = 1 to v-num-parfirst-stream
     1490     :
     1491       if lookup(entry(vari, parfirst-stream, pardelim)
     1492                ,parsecond-stream
     1493                ,pardelim
     1494                ) > 0 then do:
     1495         assign
     1496           varresult-cross = yes
     1497         .
     1498         leave.
     1499       end.
     1500     end.
     1501     return varresult-cross .
     1502   end function.
