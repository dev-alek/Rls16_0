        1   block-level on error undo, throw.
        2   using ibs.th.gbl.gbl-var.
        3   define input parameter parparentproc    as handle no-undo .
        4   define input parameter p-parent-handle  as handle no-undo . // 24/IX-2018 - не используется
        5   define input parameter p-log-handle     as handle no-undo .
        6   define input parameter p-parameter      as character no-undo .
        7   define variable p-in-file     as character no-undo .
        8   define variable p-obj-code    as integer no-undo .
        9   define variable p-obj-type    as character no-undo .
       10   define variable p-is-close    as logical no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Импорт накладных".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75     // &delim-par
       76   define variable local-trace-on as logical no-undo .
       77   define variable log-file-name as character no-undo .
       78   local-trace-on = false .
       79   define variable v-input-error as logical no-undo .
       80   define variable v-view-log    as logical no-undo .
       81   define variable v-esm         as character no-undo .
       82   define variable v-num-params  as integer no-undo initial 4 .
       83   log-file-name = substitute("impdoc4.log", ibs.th.gbl.gbl-inipar:logDir) .
       84   if num-entries(p-parameter, chr(4)) = v-num-params then do:
       85     assign
       86        p-in-file  =          entry(1, p-parameter, chr(4))
       87        p-obj-code = integer( entry(2, p-parameter, chr(4)) )
       88        p-obj-type =          entry(3, p-parameter, chr(4))
       89        p-is-close = logical( entry(4, p-parameter, chr(4)) )
       90     no-error .
       91     v-input-error = error-status:error .
       92     if v-input-error then v-esm = error-status:get-message(1) .
       93   end.
       94   else do:
       95     assign
       96       v-input-error = yes
       97       v-esm         = substitute("Неверное количество ENTRY в составном параметре - &1, должно быть &2"
       98                                , num-entries(p-parameter, chr(4))
       99                                , v-num-params)
      100     .
      101   end.
      102   if v-input-error = yes then do:
      103       run write-log-and-file in p-log-handle ( 1, log-file-name, 1, substitute("Ошибка входных параметров:&2&1&2&3", p-parameter, chr(10), v-esm) ).
      104     v-view-log = yes.
      105     return.
      106   end.
      107   define temp-table tt-imp-parts no-undo // скопировано из utl/imp-doc4.p
      108      field artic         as character
      109              field f02           as character
      110      field part-code     as character
      111      field in-code       like ub.parts.in-code
      112      field gds-code      as int64
      113      field price-rubl    like ub.parts.price-rubl
      114      field fact-qnty     like ub.parts.fact-qnty
      115              field f08           as character
      116              field f09           as character
      117              field f10           as character
      118      field vat-tax-value as decimal
      119              field f12           as character
      120              field f13           as character
      121      field name-gtd      as character
      122              field f15           as character
      123              field f16           as character
      124      field srok-god      as character
      125              field f18           as character
      126              field f19           as character
      127      field supp-code     as integer
      128      field supp-type     as character
      129      field cont-prn-code like ub.contract.contract-prn-code
      130              field imp-row       as character // исходая строка из файла импорта
      131   .
      132   define variable v-count-all   as integer no-undo .
      133   define variable v-count-err   as integer no-undo .
      134   define variable v-count-err1  as integer no-undo .
      135   define variable v-count-err2  as integer no-undo .
      136   run import_file in this-procedure (p-in-file, output v-count-all) .
      137   run write-log-and-file in p-log-handle ( 1, log-file-name, 1, substitute("Всего прочитано &1 записей", v-count-all) ).
      138   define variable v-osn-fname as character no-undo .
      139   define variable v-art-fname as character no-undo .
      140   v-osn-fname = substitute("&1_supp.txt", p-obj-code) .
      141   v-art-fname = substitute("&1_gds.txt",  p-obj-code) .
      142   define variable v-err-file-name as character no-undo .
      143   define variable v-str           as character no-undo .
      144     v-str = entry(1, p-in-file, ".") .
      145     v-err-file-name = substitute("&2.err"
      146       , ibs.th.gbl.gbl-inipar:logDir
      147       , substring(  v-str,  r-index(v-str, "\") + 1  )
      148     ) .
      149   run utl/imp-doc4cr.p ( parparentproc
      150                        , p-log-handle  // хронометраж через write-log-and-file()
      151                        , log-file-name // имя лог-файла, в который выводится хронометраж
      152                        , p-obj-code
      153                        , p-obj-type
      154                        , p-is-close
      155                        , v-osn-fname // список соответствия поставщиков
      156                        , v-art-fname // список соответствия товаров
      157                        , v-err-file-name // файл для повторного импорта
      158                        , input table tt-imp-parts
      159                        , output v-count-err
      160                        , output v-count-err1
      161                        , output v-count-err2
      162                        ) .
      163   define stream f-inp .
      164   procedure import_file private:
      165   define input  parameter p-file-name as character no-undo .
      166   define output parameter p-count-all as integer no-undo .
      167   define variable v-imp-row as character no-undo .
      168   define variable v-err-msg as character no-undo .
      169   define buffer buf_tt-parts for tt-imp-parts .
      170     empty temp-table tt-imp-parts .
      171     p-count-all = 0 .
      172     v-err-msg = "" .
      173     file-info:file-name = p-file-name .
      174     if file-info:file-type = ? then do :
      175       v-err-msg = substitute("Отсутствует файл для импорта &1", p-file-name) .
      176       run write-log-and-file in p-log-handle ( 1, log-file-name, 1, v-err-msg ).
      177       undo, throw new Progress.Lang.AppError (v-err-msg) .
      178     end .
      179   do on error undo, throw:
      180     input stream f-inp from value(p-file-name) no-echo .
      181     repeat on endkey undo, leave:
      182       // import stream f-inp DELIMITER '` tt-imp-parts2 .
      183   
      184       v-imp-row = "" .
      185       import stream f-inp unformatted v-imp-row .
      186       p-count-all = p-count-all + 1 .
      187       if v-imp-row > "" then do:
      188         if num-entries(v-imp-row, ';') <> 22 then do :
      189           v-err-msg = "количество полей отличается от 22" .
      190           leave .
      191         end .
      192         
      193         create buf_tt-parts .
      194         assign
      195           buf_tt-parts.artic         = substring(  entry( 1, v-imp-row, ';'),  7  ) // отрезаем начальное "PART: &1;"
      196   
      197           buf_tt-parts.part-code     =      trim(  entry( 3, v-imp-row, ';')  )
      198           buf_tt-parts.in-code       =      trim(  entry( 4, v-imp-row, ';')  )
      199           buf_tt-parts.gds-code      =     int64(  entry( 5, v-imp-row, ';')  )
      200           buf_tt-parts.price-rubl    =   decimal(  entry( 6, v-imp-row, ';')  )
      201           buf_tt-parts.fact-qnty     =   decimal(  entry( 7, v-imp-row, ';')  )
      202           buf_tt-parts.vat-tax-value =   decimal(  entry(11, v-imp-row, ';')  )
      203           buf_tt-parts.name-gtd      =             entry(14, v-imp-row, ';')
      204           buf_tt-parts.srok-god      =             entry(17, v-imp-row, ';')
      205           buf_tt-parts.supp-code     =   integer(  entry(20, v-imp-row, ';')  )
      206           buf_tt-parts.supp-type     =             entry(21, v-imp-row, ';')
      207           buf_tt-parts.cont-prn-code =             entry(22, v-imp-row, ';')
      208           buf_tt-parts.imp-row       =                       v-imp-row
      209         .
      210         
      211       end . // end_of v-imp-row > ""
      212   
      213     end. // end_of repeat
      214   
      215     
      216     catch exAppErrors as class Progress.Lang.AppError :
      217       v-err-msg = exAppErrors:ReturnValue .
      218       if v-err-msg > "" then . else do :
      219         v-err-msg = exAppErrors:GetMessage(1) . 
      220         if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\imp-doc4.p" .
      221       end .
      222     end catch .
      223     catch exProErrors as class Progress.Lang.ProError :
      224       v-err-msg = exProErrors:GetMessage(1) . 
      225       if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\imp-doc4.p" .
      226     end catch .
      227     catch exAnyErrors as class Progress.Lang.Error:
      228       v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\imp-doc4.p " + exAnyErrors:GetMessage(1).
      229     end catch .
      230     finally: 
      231       input stream f-inp close.
      232       if v-err-msg > "" then do :
      233         v-err-msg = substitute ("Ошибка в строке &1 файла &2: &3 [&4]", p-count-all, p-file-name, v-err-msg, v-imp-row) .
      234         run write-log-and-file in p-log-handle ( 1, log-file-name, 1, v-err-msg ).
      235         undo, throw new Progress.Lang.AppError (v-err-msg) .
      236       end .
      237     end finally.
      238   end .
      239     
      240   
      241       if local-trace-on then do:
      242         define variable dsXmlFileName as character no-undo .
      243         dsXmlFileName = substitute("&1.xml", entry(1, p-file-name, ".")).
      244         temp-table tt-imp-parts:WRITE-XML ( "FILE", dsXmlFileName, true, "UTF-8").
      245       end .
      246   end procedure . /* import_file */
