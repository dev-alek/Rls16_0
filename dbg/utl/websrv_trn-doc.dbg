      885   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   function octal-to-char return character
      887   ( p-string as character ) :
      888     def var v-asc     as integer no-undo .
      889     def var v-new-asc as integer no-undo .
      890     def var ind       as integer no-undo .
      891     if length(p-string) <> 3 then do:
      892       return ? .
      893     end.
      894     assign
      895       v-asc = 0
      896     .
      897     do ind = 1 to length(p-string)
      898     :
      899       assign
      900         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      901       .
      902       if v-new-asc < 0 or v-new-asc >= 8 then do:
      903         return ? .
      904       end.
      905       assign
      906         v-asc = v-asc * 8 + v-new-asc
      907       .
      908     end.
      909     return chr(v-asc) .
      910   end function .
      911   function char-to-octal return character
      912   ( p-chr as character ) :
      913     def var v-asc    as integer   no-undo .
      914     def var ind      as integer   no-undo .
      915     def var v-string as character no-undo .
      916     if length(p-chr) <> 1 then do:
      917       return ? .
      918     end.
      919     assign
      920       v-asc    = asc(p-chr)
      921       v-string = ""
      922     .
      923     do ind = 1 to 3
      924     :
      925       assign
      926         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      927       .
      928       assign
      929         v-asc = truncate(v-asc / 8, 0)
      930       .
      931     end.
      932     return v-string .
      933   end.
      934   function str-encode return character
      935   (   p-init-string       as character
      936     , p-encode-char       as character
      937     , p-special-char-list as character
      938   ) :
      939     def var p-encode-string as character no-undo .
      940     def var ind                as integer no-undo .
      941     def var v-num-special-char as integer no-undo .
      942     def var v-special-char     as character no-undo .
      943     if p-encode-char = ?
      944     or p-encode-char = "" then do:
      945       assign
      946         p-encode-char = "~~"
      947       .
      948     end.
      949     if p-init-string = ? then do:
      950       return "?" .
      951     end.
      952     if p-init-string = "?" then do:
      953       return p-encode-char + char-to-octal("?") .
      954     end.
      955     assign
      956       v-num-special-char = length(p-special-char-list)
      957       p-encode-string    = replace(p-init-string
      958                                   ,p-encode-char
      959                                   ,p-encode-char + char-to-octal(p-encode-char)
      960                                   )
      961     .
      962     do ind = 1 to v-num-special-char
      963     :
      964       assign
      965         v-special-char = substring(p-special-char-list, ind, 1)
      966       .
      967       if v-special-char <> p-encode-char then do:
      968         assign
      969           p-encode-string = replace (p-encode-string
      970                                     ,v-special-char
      971                                     ,p-encode-char + char-to-octal(v-special-char)
      972                                     )
      973         .
      974       end.
      975     end.
      976     return p-encode-string .
      977   end.
      978   function str-decode returns character
      979     (p-init-string   as character
      980     ,p-encode-char   as character
      981     ) :
      982     def var p-decode-string as character no-undo .
      983     def var ind                       as integer no-undo .
      984     def var v-num-entries-init-string as integer no-undo .
      985     def var v-sub-phrase              as character no-undo .
      986     def var v-special-char            as character no-undo .
      987     if p-encode-char = ?
      988     or p-encode-char = "" then do:
      989       assign
      990         p-encode-char = "~~"
      991       .
      992     end.
      993     if p-init-string = "?" then do:
      994       return ? .
      995     end.
      996     assign
      997       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      998     .
      999     if v-num-entries-init-string > 1 then do:
     1000       assign
     1001         p-decode-string = entry(1, p-init-string, p-encode-char)
     1002       .
     1003       do ind = 2 to v-num-entries-init-string
     1004       :
     1005         assign
     1006           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     1007         .
     1008         assign
     1009           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     1010         .
     1011         if v-special-char <> ? then do:
     1012           assign
     1013             p-decode-string = p-decode-string
     1014                             + v-special-char
     1015                             + substring(v-sub-phrase, 4)
     1016           .
     1017         end.
     1018         else do:
     1019           assign
     1020             p-decode-string = p-decode-string
     1021                             + p-encode-char
     1022                             + v-sub-phrase
     1023           .
     1024         end.
     1025       end.
     1026     end.
     1027     else do:
     1028       assign
     1029         p-decode-string = p-init-string
     1030       .
     1031     end.
     1032     return p-decode-string .
     1033   end.
     1034   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1035   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
     1036   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
     1037     field cst-code                like ub.trn-doc.cst-code
     1038     field part-code               like ub.parts.part-code
     1039     .
     1040   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
     1041   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
     1042   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
     1043   function hvrdtax return logical (input parrecid as recid):
     1044   define variable varresult as logical no-undo.
     1045   run hvrdtax-proc (input parrecid, output varresult).
     1046   return varresult.
     1047   end function.
     1048   procedure hvrdtax-proc:
     1049   define input  parameter parrecid  as recid   no-undo.
     1050   define output parameter parresult as logical no-undo.
     1051   define buffer bf_goods for ub.goods.
     1052   define buffer bf_units for ub.units.
     1053   define buffer rt_tax   for ub.tax.
     1054   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1055   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1056   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1057   if available rt_tax and
     1058       can-find(first ub.tax-units No-LOCK WHERE
     1059                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1060                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1061                                                       else assign parresult = no.
     1062   end procedure.
     1063   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   define new global shared variable g#lib-calc as handle no-undo .
     1065   procedure plgdsfnd :
     1066     define input  parameter p-chk-and-chs    as logical               no-undo .
     1067     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1068     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1069     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1070     define output parameter p-reserv-pl-code as   logical             no-undo .
     1071     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1072     define buffer buf_goods         for ub.goods .
     1073     define buffer buf_pl-gds        for ub.pl-gds .
     1074     define buffer buf_second_pl-gds for ub.pl-gds .
     1075     find first buf_goods no-lock where
     1076                buf_goods.gds-code = p-gds-code no-error .
     1077     if not available buf_goods
     1078     then do:
     1079       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1080     end.
     1081   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1082   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1083     (input  p-obj-type
     1084     ,input  p-obj-code
     1085     ,input  buf_goods.artic
     1086     ,input  buf_goods.prod-type
     1087     ,input  buf_goods.prod-code
     1088     ,input  'place-rsrv=request'
     1089     ,output p-reserv-pl-code
     1090     ) no-error .
     1091     if error-status :error
     1092     then do:
     1093       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1094     end.
     1095     if p-reserv-pl-code = no
     1096     then do:
     1097       return .
     1098     end.
     1099     if p-chk-and-chs <> yes
     1100     then do:
     1101       return .
     1102     end.
     1103     find first buf_pl-gds no-lock where
     1104                buf_pl-gds.obj-type = p-obj-type and
     1105                buf_pl-gds.obj-code = p-obj-code and
     1106                buf_pl-gds.gds-code = p-gds-code no-error .
     1107     if not available buf_pl-gds
     1108     then do:
     1109       return error "К товару не привязано ни одного места хранения" .
     1110     end.
     1111     find first buf_second_pl-gds no-lock where
     1112                buf_second_pl-gds.obj-type  = p-obj-type          and
     1113                buf_second_pl-gds.obj-code  = p-obj-code          and
     1114                buf_second_pl-gds.gds-code  = p-gds-code          and
     1115                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1116     if not available buf_second_pl-gds
     1117     then do:
     1118       assign
     1119         p-pl-code = buf_pl-gds.pl-code
     1120       .
     1121     end.
     1122     else do:
     1123       if not valid-handle( parparentproc )
     1124       then do:
     1125         return error "Не выбрано место хранения " + chr(10) .
     1126       end.
     1127       run str/plgdssel.p
     1128         (
     1129            input parparentproc
     1130         ,  input p-obj-type
     1131         ,  input p-obj-code
     1132         ,  input p-gds-code
     1133         , output p-pl-code
     1134         ) no-error .
     1135       if error-status :error
     1136       then do:
     1137         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1138                                , 'plgdssel.p':U
     1139                                , chr(10)
     1140                                , error-status :get-message( 1 )
     1141                                , return-value
     1142                                ) .
     1143       end.
     1144       if p-pl-code = ? or
     1145          p-pl-code = 0
     1146       then do:
     1147         return error "Не выбрано место хранения " + chr(10) .
     1148       end.
     1149     end.
     1150   end procedure.
     1151   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
