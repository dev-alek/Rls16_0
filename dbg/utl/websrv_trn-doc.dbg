     3283   procedure clos-trn :
     3284     do
     3285     on error undo, return error return-value
     3286     :
     3287   define input parameter p-trn-code as character no-undo .
     3288   define buffer buf_s-trn-doc for ub.trn-doc.
     3289   define variable varmode            as   character           no-undo.
     3290   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3291   define variable varflag            like ub.trn-doc.flag     no-undo.
     3292   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3293   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3294   define variable varcheck-return as logical no-undo .
     3295   define variable varchg-inv      as logical no-undo .
     3296   assign
     3297     varmode         = '<закрытие документа>':U
     3298     varstatus       = 'запрос':U
     3299     varflag         = true
     3300     varcopystatus   = 'новый':U
     3301     varcopyflag     = false
     3302     varcheck-return = true
     3303     varchg-inv      = true
     3304     .
     3305   for each tt2-doc-line where is-tsd and doc-code = p-trn-code no-lock:
     3306     run unitqnty1 (
     3307         input tt2-doc-line.unit-cli,
     3308         input "",
     3309         input "",
     3310         input 0,
     3311         input "",
     3312         input tt2-doc-line.doc-qnty)
     3313     no-error.
     3314     if error-status:error then do:
     3315       run pcall-log-file in p-log-handle (input return-value) .
     3316       is-unit-error  = true.
     3317     end.
     3318     run unitqnty1 (
     3319         input tt2-doc-line.unit-cli,
     3320         input "",
     3321         input "",
     3322         input 0,
     3323         input "",
     3324         input tt2-doc-line.fact-qnty)
     3325     no-error.
     3326     if error-status:error then do:
     3327       run pcall-log-file in p-log-handle (input return-value) .
     3328       is-unit-error  = true.
     3329     end.
     3330   end.
     3331   if is-unit-error then do:
     3332     run pcall-log-file in p-log-handle (input "Невозможно перевести накладную в статус накл") .
     3333     return.
     3334   end.
