      171   procedure vss-get-parameters :
      172     define output parameter p-vss-parameters as character no-undo .
      173   end procedure.
      174   define new global shared variable g#vssrevis-logger as handle    no-undo .
      175   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      176   define variable v-vssrevis-logger                   as handle    no-undo .
      177   procedure vss-logevent :
      178     define input  parameter p-extra-paramters as character no-undo .
      179     define variable v-vssrevis-parameters as character no-undo .
      180     do
      181     on error undo, return error return-value
      182     :
      183       if  valid-handle(v-vssrevis-logger)
      184       and v-vssrevis-logger :get-signature("logevent") <> ""
      185       then do:
      186         run vss-get-parameters in this-procedure
      187           (output v-vssrevis-parameters
      188           ).
      189         run logevent in v-vssrevis-logger
      190           (input vss-workfile
      191           ,input vss-revision
      192           ,input v-vssrevis-parameters
      193           ,input p-extra-paramters
      194           ).
      195       end.
      196     end.
      197   end procedure.
      198   assign
      199     v-vssrevis-logger = g#vssrevis-logger
      200   .
      201   if  valid-handle(v-vssrevis-logger)
      202   and v-vssrevis-logger :get-signature("logevent") <> ""
      203   then do:
      204     assign
      205       v-vssrevis-logevent = true
      206     .
      207     run vss-logevent in this-procedure (input vss-description) .
      208   end.
      209   define new global shared variable g#language as character no-undo .
      210   if g#language <> '' and g#language <> 'rus':U then do:
      211     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      212   end.
      213   define new global shared variable g#library  as handle no-undo .
      214   define new global shared variable g#library2 as handle no-undo .
      215   define new global shared variable g#lib-trn  as handle no-undo .
      216   define new global shared variable g#lib-trn2 as handle no-undo .
      217   define new global shared variable g#lib-trn3 as handle no-undo .
      218   define new global shared variable g#lib-trn4 as handle no-undo .
      219   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      220   define variable to-day       as date no-undo .
      221   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   procedure doc-code:
      223   define input  parameter parmode          as   character           no-undo.
      224   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      225   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      226   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      227   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      228   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      229   define variable vardb-remote     as   logical             no-undo.
      230   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      231   define variable v-delimiter as character no-undo .
      232   do
      233   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      234   :
      235   find first buf_sys-ctrl no-lock .
      236   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      237     CASE parmode:
      238       when "main":u then do:
      239         if vardb-remote then do:
      240           assign
      241             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      242         end.
      243         else do:
      244           assign
      245             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      246         end.
      247       end.
      248       when "trio" then do:
      249         assign
      250           pardoc-code = replace (parroot-doc-code, "=", "*").
      251       end.
      252       otherwise do:
      253         assign
      254         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      255         no-error
      256         .
      257         if error-status:error  then do:
      258           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      259                                         ,chr(10)
      260                                         ,parmode
      261                                         ).
      262         end.
      263         if num-entries(parmode) = 1
      264         and parmode <> "chip":U
      265         and parmode <> "chip_s":U
      266         then do:
      267           assign
      268           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      269         end.
      270         else if (lookup("chip":U, parmode) > 0
      271                  or
      272                  lookup("chip_s":U, parmode) > 0) then do:
      273           assign
      274             vartemp-doc-code = parroot-doc-code.
      275           do while true:
      276             if index (vartemp-doc-code , ".") = 0 then
      277               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      278             else
      279               vartemp-doc-code  =
      280               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      281               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      282               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      283             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      284           end.
      285           assign
      286             pardoc-code = vartemp-doc-code.
      287         end.
      288       end.
      289     end CASE.
      290     if pardoc-code = '':U
      291     or (parroot-doc-code <> '':U
      292     and pardoc-code = parroot-doc-code) then do:
      293       undo, return error substitute("Ошибка при генерации номера документа&1"
      294                                     ,chr(10)).
      295     end.
      296   end.
      297   end. // procedure/method
      298   function get-doc-code-int64 returns int64
      299     ( input p-doc-code as character ) :
      300     define variable v-ind              as integer   no-undo .
      301     define variable v-num-entries      as integer   no-undo .
      302     define variable v-doc-code-int64   as int64     no-undo .
      303     define variable v-canonic-doc-code as character no-undo .
      304     assign
      305       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      306       v-canonic-doc-code = p-doc-code
      307     .
      308     do v-ind = 1 to v-num-entries
      309     :
      310       assign
      311         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      312       .
      313     end.
      314     assign
      315       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      316     .
      317     return v-doc-code-int64 .
      318   end. // function/method
      319   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   define variable v-waitfram-action01         as character   no-undo .
      321   define variable v-waitfram-action02         as character   no-undo .
      322   define variable v-waitfram-action03         as character   no-undo .
      323   define variable mWaitFramTextBeg            as character   no-undo.
      324   define variable mWaitFramTextEnd            as character   no-undo.
      325   define variable mWaitFramView               as logical     no-undo.
      326   define variable mWaitProcEvent              as logical     no-undo init yes.
      327   define variable mWaitFramInterval           as integer     no-undo init 1 .
      328   define variable mWaitFramStop               as logical     no-undo.
      329   define variable mWaitFramStopUser           as logical     no-undo.
      330   define variable mWaitFramStopTimeOut        as logical     no-undo.
      331   define variable mWaitFramStartProc          as datetime-tz no-undo.
      332   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      333   define button B-WaitFramStop auto-end-key
      334        label "Стоп"
      335        size 10 by 1 tooltip "Остоновить процесс".
      336   define button B-viewProcInfo
      337        label "Информация"
      338        size 15 by 1 tooltip "Информация о процесс".
      339   define frame waitfram
      340     v-waitfram-action01 format "x(72)" no-label skip
      341     v-waitfram-action02 format "x(72)" no-label skip
      342     v-waitfram-action03 format "x(72)" no-label skip
      343     B-viewProcInfo
      344     B-WaitFramStop at row 4 col 30
      345     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      346     .
      347   define new global shared variable mBatchMode as logical no-undo init ?.
      348   define variable mFramBachModHandle as handle no-undo.
      349   mFramBachModHandle = frame waitfram:handle.
      350   define variable mFameOldVis as logical no-undo.
      351   define variable mVisCUrentVin as logical no-undo.
      352   if session:batch-mode
      353   then
      354      mBatchMode = yes.
      355   if mBatchMode = ? then do:
      356     mVisCUrentVin = current-window:visible.
      357     mFameOldVis = mFramBachModHandle:visible.
      358     mFramBachModHandle:visible  = yes.
      359     mBatchMode = mFramBachModHandle:visible ne yes.
      360     mFramBachModHandle:visible = mFameOldVis.
      361     current-window:visible = mVisCUrentVin.
      362   end.
      363    if  log-manager:logfile-name ne ?
      364     then DO:
      365         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      366         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      367         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      368     end.
      369   on choose of B-WaitFramStop in frame waitfram
      370   do:
      371     mWaitFramStop = yes.
      372     mWaitFramStopUser = yes.
      373   end.
      374   function waitfram-check-timeout returns logical():
      375      define variable vtime as int64 no-undo.
      376      if mWaitFramStopTimeOut
      377      then
      378         return yes.
      379      vtime = ( now - mWaitFramStartProc ) / 1000 .
      380      if     mWaitFramTimeOut ne ?
      381         and mWaitFramTimeOut ne 0
      382         and mWaitFramTimeOut lt vtime
      383      then do:
      384         mWaitFramStopTimeOut = yes.
      385      end.
      386      return mWaitFramStopTimeOut.
      387   end.
      388   procedure waitfram-hide :
      389     if not session:batch-mode
      390     then do
      391     on error undo, return error return-value
      392     :
      393       pause 0 before-hide .
      394       if not mBatchMode then
      395         hide frame waitfram .
      396     if     not mWaitFramView
      397        and mWaitProcEvent
      398     then
      399       process events .
      400     end.
      401   end procedure.
      402   procedure waitfram-show :
      403     define input  parameter p-message as character no-undo .
      404     define variable v-left-margin as integer   no-undo .
      405     if not session:batch-mode
      406     then do
      407     on error undo, return error return-value
      408     :
      409       if length(p-message) <= 70 then do:
      410         assign
      411           v-left-margin = integer((70 - length(p-message)) / 2)
      412         .
      413         assign
      414           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      415         .
      416         assign
      417           v-waitfram-action01 = " "
      418           v-waitfram-action02 = " "
      419                                    + fill(" ", v-left-margin)
      420                                    + p-message
      421           v-waitfram-action03 = " "
      422         .
      423       end.
      424       else do:
      425         define variable vRindex1 as integer no-undo.
      426         define variable vRindex2 as integer no-undo.
      427         vRindex1 = r-index(p-message," ",70).
      428         if vRindex1 = 0
      429         then
      430            vRindex1 = 70.
      431         if length(p-message)  <= vRindex1 + 70 then do:
      432           assign
      433             v-waitfram-action01 = " "
      434             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      435             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      436           .
      437         end.
      438         else do:
      439           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      440           if vRindex2 <= vRindex1
      441           then
      442              vRindex2 = vRindex1 + 70.
      443           assign
      444             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      445             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      446             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      447           .
      448         end.
      449       end.
      450       B-viewProcInfo:visible   in frame waitfram = no.
      451       B-viewProcInfo:sensitive in frame waitfram = no.
      452       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      453       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      454       if  (   mWaitFramView
      455          or  mWaitProcEvent)
      456          and not mBatchMode
      457       then
      458          display
      459             v-waitfram-action01 skip
      460             v-waitfram-action02 skip
      461             v-waitfram-action03 skip
      462          with frame waitfram .
      463       if     mWaitFramView
      464          then do:
      465             if     mWaitFramInterval ne ?
      466                and not mBatchMode
      467             then
      468                wait-for go of frame waitfram pause mWaitFramInterval.
      469          end.
      470          else
      471             if     mWaitProcEvent
      472                and not mBatchMode
      473             then
      474                process events .
      475     end.
      476   end procedure.
      477      procedure waitfram-show-this:
      478         define input  parameter iInterval as int64 no-undo.
      479         define variable vtime as int64 no-undo.
      480         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      481         mWaitFramInterval = iInterval.
      482         run waitfram-show (substitute("&1&2 &3&4" ,
      483                                       mWaitFramTextBeg ,
      484                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      485                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      486                                       mWaitFramTextEnd
      487                                      )
      488                           ).
      489      end.
      490      procedure WaitFramRunPause:
      491         define input  parameter iInterval as dec no-undo.
      492         define variable vStart  as datetime-tz no-undo.
      493         define variable vend    as datetime-tz no-undo.
      494         define variable vint as int64 no-undo.
      495         define variable vOk as logical no-undo.
      496         vStart = now.
      497         vend   = vStart.
      498         publish "WaitFramPause" (iInterval,output vOk).
      499         vend   =  now.
      500         vint = vend - vStart.
      501         vint = iInterval - vint / 1000.
      502         if     not mWaitFramStop
      503            and (   vint > 0
      504                 or (    not vOk
      505                     and iInterval eq ?
      506                     )
      507                 )
      508         then
      509            run waitfram-show-this (iInterval).
      510         vend   =  now.
      511         vint = vend - vStart.
      512         vint = iInterval - vint / 1000.
      513         if     not mWaitFramStop
      514            and vint > 0
      515         then do:
      516            run gbl/pause.p (vint * 1000).
      517         end.
      518         if iInterval ne ?
      519         then
      520            publish "WaitFramStop".
      521         waitfram-check-timeout().
      522      end.
      523      procedure WaitFramWaitFor:
      524         define input  parameter iInterval as dec no-undo.
      525         assign
      526            mWaitFramStartProc   = now
      527            mWaitFramStopUser    = no
      528            mWaitFramStopTimeOut = no
      529         .
      530         block-wait:
      531         do while not mWaitFramStop:
      532            run WaitFramRunPause (iInterval).
      533            if  waitfram-check-timeout()
      534            then do:
      535               leave block-wait.
      536            end.
      537         end.
      538         run waitfram-hide.
      539      end.
      540   procedure waitfram-join :
      541     define input  parameter p-line-1  as character no-undo .
      542     define input  parameter p-line-2  as character no-undo .
      543     define input  parameter p-line-3  as character no-undo .
      544     define output parameter p-message as character no-undo .
      545     do
      546     on error undo, return error return-value
      547     :
      548       assign
      549         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      550                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      551                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      552       .
      553     end.
      554   end procedure.
      555   function waitfram-join-function returns character
      556     (input p-line-1 as character
      557     ,input p-line-2 as character
      558     ,input p-line-3 as character
      559     ).
      560     define variable v-message as character no-undo .
      561     run waitfram-join in this-procedure
      562       (input  p-line-1
      563       ,input  p-line-2
      564       ,input  p-line-3
      565       ,output v-message
      566       ) .
      567     return v-message .
      568   end function .
      569   function cross-list returns logical (
      570     input parfirst-stream  as character,
      571     input parsecond-stream as character,
      572     input pardelim         as character).
      573     if pardelim = ""
      574     or pardelim = ?
      575     then do:
      576       assign
      577         pardelim = ","
      578       .
      579     end.
      580     define variable vari            as integer no-undo .
      581     define variable varresult-cross as logical no-undo .
      582     assign
      583       varresult-cross = no
      584     .
      585     def var v-num-parfirst-stream as integer no-undo .
      586     assign
      587       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      588     .
      589     do vari = 1 to v-num-parfirst-stream
      590     :
      591       if lookup(entry(vari, parfirst-stream, pardelim)
      592                ,parsecond-stream
      593                ,pardelim
      594                ) > 0 then do:
      595         assign
      596           varresult-cross = yes
      597         .
      598         leave.
      599       end.
      600     end.
      601     return varresult-cross .
      602   end function.
