     1204   define variable dflt-cd as character no-undo .
     1205   c-l:
     1206   do on error undo, return error return-value :
     1207   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1208   assign
     1209       paruse-parts = false
     1210       .
     1211   assign
     1212     end-price = no.
     1213   if parinp-discnt-type = yes and
     1214      parinp-discnt-pc   = 0   and
     1215      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1216      then do:
     1217     assign
     1218       crt_trn-doc.tot-calc    = partot-calc
     1219       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1220       crt_trn-doc.discnt-type = pardiscnt-type.
     1221   end.
     1222   if parinp-agnt = ? then do:
     1223     assign
     1224       crt_trn-doc.agnt = paragnt.
     1225   end.
     1226   if parinp-boss = ? then do:
     1227     assign
     1228       crt_trn-doc.boss = parboss.
     1229   end.
     1230   if parinp-wrkr = ? then do:
     1231     assign
     1232       crt_trn-doc.wrkr = parwrkr.
     1233   end.
     1234   if parinp-base-rate  = ? then do:
     1235     assign
     1236       crt_trn-doc.base-rate  = parbase-rate.
     1237   end.
     1238   if parinp-base-scale = ? then do:
     1239     assign
     1240       crt_trn-doc.base-scale = parbase-scale.
     1241   end.
     1242   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1243   if available tt-doc-line then do:
     1244     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1245                      and crt_goods.prod-type = tt-doc-line.prod-type
     1246                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1247     if crt_goods.gds-type = 'у':U and
     1248        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1249       return error "В данный документ нельзя копировать услуги.".
     1250     end.
     1251     assign
     1252       real-type = crt_goods.gds-type.
     1253     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1254     if available crt_doc-line then do:
     1255       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1256                        and crt_goods.prod-type = crt_doc-line.prod-type
     1257                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1258       if crt_goods.gds-type <> real-type then do:
     1259         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1260       end.
     1261     end.
     1262     else do:
     1263       assign
     1264         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1265     end.
     1266   end.
     1267   r-l:
     1268   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1269     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1270                      and crt_goods.prod-type = tt-doc-line.prod-type
     1271                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1272   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1273      (
     1274       input crt_trn-doc.doc-code
     1275      ,input crt_trn-doc.obj-type
     1276      ,input crt_trn-doc.obj-code
     1277      ,input crt_goods.artic
     1278      ,input crt_goods.prod-type
     1279      ,input crt_goods.prod-code
     1280      ,input crt_goods.gds-name
     1281      ,input crt_goods.prt-root
     1282      ,input ?
     1283      ,input ?
     1284      ,input parcash-pay      ) no-error.
     1285     if error-status:error then do:
     1286       undo c-l, return error return-value.
     1287     end.
     1288     if return-value = "next" then do:
     1289       next r-l.
     1290     end.
     1291     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1292                                   crt_doc-line.artic     = crt_goods.artic      and
     1293                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1294                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1295     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1296                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1297                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1298                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1299                               break by tt-gds-dtl.artic
     1300                                     by tt-gds-dtl.prod-type
     1301                                     by tt-gds-dtl.prod-code
     1302                               :
     1303   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1304     ( input  tt-gds-dtl.artic
     1305      ,input  tt-gds-dtl.prod-type
     1306      ,input  tt-gds-dtl.prod-code
     1307      ,input  tt-gds-dtl.prt-code
     1308      ,input  tt-doc-line.obj-type
     1309      ,input  tt-doc-line.obj-code
     1310      ,output legal-node
     1311     ) no-error .
     1312       if error-status:error then do:
     1313          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1314       end.
     1315   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1316     ( input crt_trn-doc.obj-code
     1317      ,input crt_trn-doc.obj-type
     1318      ,input crt_trn-doc.doc-code
     1319      ,input crt_goods.artic
     1320      ,input crt_goods.prod-code
     1321      ,input crt_goods.prod-type
     1322      ,input legal-node
     1323      ,input yes
     1324     ) no-error .
     1325        if error-status:error then do:
     1326           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1327        end.
     1328        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1329                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1330                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1331                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1332                                     crt_gds-dtl.prt-code  = legal-node.
     1333       assign
     1334         crt_gds-dtl.ov             = parfix-price
     1335         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1336         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1337         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1338         .
     1339       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1340         assign
     1341           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1342           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1343           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1344           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1345       end.
     1346       if end-price then do:
     1347         assign
     1348           crt_gds-dtl.ov             = yes
     1349           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1350           crt_gds-dtl.discnt-base    = 0
     1351           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1352           crt_gds-dtl.discnt-rubl    = 0
     1353           crt_gds-dtl.discnt-pc      = 0
     1354           crt_gds-dtl.discnt-type    = yes.
     1355       end.
     1356   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1358     ( input recid(crt_gds-dtl)
     1359     , input no
     1360     , input ?
     1361     ) no-error.
     1362           if error-status:error then do:
     1363             undo c-l, return error return-value.
     1364           end.
     1365       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1366          crt_gds-dtl.ov then do:
     1367         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1368       end.
     1369       if paruse-parts then do:
     1370          if first-of (tt-gds-dtl.prod-code) then do:
     1371            for each tt-parts :
     1372              assign
     1373                chg-qnty = tt-parts.fact-qnty
     1374                mem-qnty = chg-qnty.
     1375              assign
     1376              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1377              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1378            end.
     1379            assign
     1380              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1381              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1382            assign
     1383              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1384              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1385            if crt_gds-dtl.doc-qnty = 0 then do:
     1386              delete crt_gds-dtl.
     1387            end.
     1388          end.
     1389       end.
     1390       else do:
     1391         assign
     1392           chg-qnty = tt-gds-dtl.fact-qnty
     1393           mem-qnty = chg-qnty.
     1394         assign
     1395           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1396           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1397           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1398           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1399         assign
     1400         varchg-qnty  = varchg-qnty  + chg-qnty
     1401         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1402         if crt_gds-dtl.doc-qnty = 0 then do:
     1403           delete crt_gds-dtl.
     1404         end.
     1405       end.
     1406     end.
     1407     if crt_doc-line.doc-qnty = 0 then do:
     1408       delete crt_doc-line.
     1409     end.
     1410   end.
     1411   end.
     1412   end procedure.
