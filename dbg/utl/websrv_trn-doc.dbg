      147   define output parameter p-ok-doc as integer   no-undo .
      148   define output parameter ERROR_ as logical no-undo initial false .
      149   define variable vss-revision    as character no-undo init "$Revision: 288743b2d1c0, 2956, rls $":U .
      150   define variable vss-author      as character no-undo init "$Author: VRukavishnikov $":U .
      151   define variable vss-date        as character no-undo init "$Date: Ср апр 06 16:23:40 2022 +0300 $":U .
