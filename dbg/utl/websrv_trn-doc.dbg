     3342       output varcopyflag
     3343     ) no-error .
     3344       if error-status:error then do :
     3345           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3346           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3347           undo, return error v-end-message.
     3348       end.
     3349   run str/trn-stat.p (
     3350       input  parparentproc ,
     3351       input  this-procedure ,
     3352       input  varmode,
     3353       input  p-trn-code,
     3354       input  varcheck-return,
     3355       input  v-cntxt-db-num,
     3356       input  v-cntxt-in-ov,
     3357       input  v-cntxt-rsrv-time,
     3358       input  v-cntxt-load-time,
     3359       input  v-cntxt-holidays,
     3360       input  NO,
     3361       output varchg-inv,
     3362       output table gds-list)
     3363       no-error.
     3364       if error-status:error then do :
     3365           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3366           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3367           undo, return error v-end-message.
     3368       end.
     3369     end.
     3370       for each ub.doc-line exclusive-lock where new_trn-doc.doc-code = ub.doc-line.doc-code:
     3371         find first buf_goods where ub.doc-line.artic = buf_goods.artic and
     3372           ub.doc-line.prod-type = buf_goods.prod-type  and
     3373           ub.doc-line.prod-code = buf_goods.prod-code
     3374           no-lock no-error .
     3375         find first ub.gds-dtl exclusive-lock where ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     3376           ub.gds-dtl.artic = buf_goods.artic and
     3377           ub.gds-dtl.prod-type = buf_goods.prod-type  and
     3378           ub.gds-dtl.prod-code = buf_goods.prod-code.
     3379         find first temp_doc-line where temp_doc-line.gds-code = buf_goods.gds-code.
     3380         ub.gds-dtl.doc-qnty  = temp_doc-line.doc-qnty.
     3381         ub.gds-dtl.fact-qnty = temp_doc-line.fact-qnty.
     3382         ub.doc-line.fact-qnty = temp_doc-line.fact-qnty.
     3383         ub.doc-line.doc-qnty = temp_doc-line.doc-qnty.
     3384         ub.doc-line.cli-qnty = temp_doc-line.fact-qnty.
     3385       end.
     3386   end procedure.
     3387   procedure clos-trn2 :
     3388   define input parameter p-trn-code as character no-undo .
     3389     do
     3390     on error undo, return error return-value
     3391     :
     3392   define buffer buf_s-trn-doc for ub.trn-doc.
     3393   define variable varmode            as   character           no-undo.
     3394   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3395   define variable varflag            like ub.trn-doc.flag     no-undo.
     3396   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3397   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3398   define variable varcheck-return as logical no-undo .
     3399   define variable varchg-inv as logical no-undo .
     3400   run str/trn-stat.p (
     3401       input  parparentproc ,
     3402       input  this-procedure ,
     3403       input  '<закрытие документа>':U ,
     3404       input  p-trn-code,
     3405       input  false  ,
     3406       input  v-cntxt-db-num,
     3407       input  false ,
     3408       input  v-cntxt-rsrv-time,
     3409       input  v-cntxt-load-time,
     3410       input  v-cntxt-holidays,
     3411       input  false ,
     3412       output varchg-inv ,
     3413       output table gds-list)
     3414       no-error.
     3415       if error-status:error then do :
     3416           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3417           return error v-end-message.
     3418       end.
     3419     end.
     3420   end procedure.
     3421   procedure mainmenu_getcntxt :
     3422   define output parameter p-cntxt-db-num                as integer   no-undo .
     3423   define output parameter p-cntxt-userid                as character no-undo .
     3424   define output parameter p-cntxt-level                 as character no-undo .
     3425   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
     3426   define output parameter p-cntxt-obj-type              as character no-undo .
     3427   define output parameter p-cntxt-obj-code              as integer   no-undo .
     3428   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
     3429   define output parameter p-cntxt-is-admin              as logical   no-undo .
     3430     do
     3431     on error undo, return error return-value
     3432     :
     3433   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3435     (input  vt-obj-type
     3436     ,input  vt-obj-code
     3437     ,output p-cntxt-db-num-obj
     3438     )  .
     3439     assign
     3440       p-cntxt-db-num          =  v-cntxt-db-num
     3441       p-cntxt-userid          =  v-cntxt-userid
     3442       p-cntxt-level           =  v-cntxt-level
     3443       p-cntxt-host-code-obj   =  vt-host-code
     3444       p-cntxt-obj-type        =  vt-obj-type
     3445       p-cntxt-obj-code        =  vt-obj-code
     3446       p-cntxt-is-admin        =  v-cntxt-is-admin
     3447     .
     3448     end.
     3449    end procedure.
     3450    procedure get-report-num :
     3451     define output parameter p-report-num as integer no-undo .
     3452      do
     3453      on error undo, return error return-value
     3454      :
     3455       assign
     3456         p-report-num = 1
     3457       .
     3458      end.
     3459    end procedure.
     3460   procedure clear-tt :
     3461     do
     3462     on error undo, return error return-value
     3463     :
     3464      for each tt-trn-doc:
     3465       delete tt-trn-doc.
     3466      end.
     3467       for each tt2-doc-line :
     3468           delete tt2-doc-line .
     3469       end.
     3470       for each tt-doc-line :
     3471           delete tt-doc-line .
     3472       end.
     3473       for each tt-gds-dtl :
     3474           delete tt-gds-dtl .
     3475       end.
     3476       for each tt-parts:
     3477           delete tt-parts .
     3478       end.
     3479       for each lib-trn_ret-doc :
     3480         delete lib-trn_ret-doc.
     3481       end.
     3482       for each lib-trn_ret-line :
     3483         delete lib-trn_ret-line      .
     3484       end.
     3485       for each lib-trn_ret-line-attr :
     3486         delete lib-trn_ret-line.
     3487       end.
     3488       for each lib-trn_ret-dtl :
     3489         delete lib-trn_ret-dtl.
     3490       end.
     3491       for each lib-trn_ret-parts :
     3492         delete lib-trn_ret-parts .
     3493       end.
     3494    end.
     3495   end procedure.
     3496   procedure add-nn :
     3497   define input  parameter p-doc-code as character no-undo .
     3498   define input  parameter p-doc-out as character no-undo .
     3499     do
     3500     on error undo, return error return-value
     3501     :
     3502       find first ub.doc-attr exclusive-lock where
     3503                ub.doc-attr.doc-code = p-doc-code and
     3504                ub.doc-attr.attr-code = 'nids':U no-error .
     3505       if not available ub.doc-attr then create ub.doc-attr.
     3506       assign
     3507         ub.doc-attr.doc-code = p-doc-code
     3508         ub.doc-attr.attr-code = 'nids':U
     3509         ub.doc-attr.attr-value = p-doc-out
     3510       .
     3511     end.
     3512   end procedure.
     3513   procedure calc-cost-price :
     3514   define input  parameter p-doc-code as character no-undo .
     3515   define buffer cur-doc-line  for ub.doc-line.
     3516   define buffer cur-goods     for ub.goods.
     3517   define buffer cur-gds-dtl   for ub.gds-dtl.
     3518   define buffer t-doc         for ub.trn-doc  .
     3519   define variable varnew-price like ub.doc-line.price-base no-undo.
     3520     do
     3521     on error undo, return error return-value
     3522     :
     3523     v-end-message = substitute("Просчет учетной цены для расходной накладной &1" , p-doc-code) .
     3524     run pcall-log-file in p-log-handle ( input v-end-message ) .
     3525     find first t-doc no-lock where t-doc.doc-code = p-doc-code .
     3526      for each  cur-doc-line where cur-doc-line.doc-code   = t-doc.doc-code         ,
     3527          first cur-goods    where cur-goods.artic         = cur-doc-line.artic     and
     3528                                   cur-goods.prod-type     = cur-doc-line.prod-type and
     3529                                   cur-goods.prod-code     = cur-doc-line.prod-code no-lock,
     3530          each  cur-gds-dtl  where cur-gds-dtl.doc-code    = cur-doc-line.doc-code  and
     3531                                   cur-gds-dtl.artic       = cur-doc-line.artic     and
     3532                                   cur-gds-dtl.prod-type   = cur-doc-line.prod-type and
     3533                                   cur-gds-dtl.prod-code   = cur-doc-line.prod-code no-lock :
     3534          assign
     3535            line-rec = recid(cur-doc-line)
     3536          .
     3537   assign
     3538     price-rubl-with-tax-loc = cur-doc-line.price-rubl
     3539     price-base-with-tax-loc = cur-doc-line.price-base
     3540   .
     3541   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3543     (output varinvprb
     3544     )  .
     3545      find first in-vatp_doc-attr no-lock
     3546       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     3547         and in-vatp_doc-attr.attr-code = 'envd':U
     3548       no-error .
     3549       if available in-vatp_doc-attr
     3550          then do:
     3551          assign
     3552            in-vatp-have-vat-slt = no.
     3553      end.
     3554      else do:
     3555        assign
     3556          in-vatp-have-vat-slt = yes.
     3557      end.
     3558      find first in-vatp-goods where in-vatp-goods.artic     = cur-doc-line.artic     and
     3559                                        in-vatp-goods.prod-type = cur-doc-line.prod-type and
     3560                                        in-vatp-goods.prod-code = cur-doc-line.prod-code no-lock.
     3561      if (not t-doc.internal and
     3562              t-doc.doc-type = 'при':U) or
     3563         in-vatp-goods.gds-type = 'у':U then do:
     3564         if varinvprb = "base":u then do:
     3565           assign
     3566             road-tax-base-loc = cur-doc-line.road-tax
     3567             road-tax-rubl-loc = cur-doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     3568         end.
     3569         else do:
     3570           ASSIGN
     3571             road-tax-rubl-loc = cur-doc-line.road-tax
     3572             road-tax-base-loc = cur-doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     3573         end.
     3574         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     3575         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     3576         assign
     3577           road-tax-cli-loc = ?.
     3578         ASSIGN
     3579           transport-base-loc = (if cur-doc-line.transport-base = ? then 0 else cur-doc-line.transport-base)
     3580           transport-rubl-loc = (if cur-doc-line.transport-rubl = ? then 0 else cur-doc-line.transport-rubl)
     3581           transport-cli-loc  = 0
     3582           other-base-loc     = (if cur-doc-line.other-base     = ? then 0 else cur-doc-line.other-base)
     3583           other-rubl-loc     = (if cur-doc-line.other-rubl     = ? then 0 else cur-doc-line.other-rubl)
     3584           other-cli-loc      = 0
     3585           vat-pc-loc         = (if cur-doc-line.vat-pc         = ? then 0 else cur-doc-line.vat-pc)
     3586           slt-pc-loc         = (if cur-doc-line.slt-pc         = ? then 0 else cur-doc-line.slt-pc).
     3587                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3588               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3589         assign
     3590           vat-cli-loc            = ?
     3591           slt-cli-loc            = ?
     3592           price-cli-with-tax-loc = ?.
     3593      end.
     3594      else do:
     3595                                                   for each in-vatp-parts where in-vatp-parts.out-code  = cur-doc-line.doc-code  and
     3596                                         in-vatp-parts.obj-type  = cur-doc-line.obj-type  and
     3597                                         in-vatp-parts.obj-code  = cur-doc-line.obj-code  and
     3598                                         in-vatp-parts.artic     = cur-doc-line.artic     and
     3599                                         in-vatp-parts.prod-type = cur-doc-line.prod-type and
     3600                                         in-vatp-parts.prod-code = cur-doc-line.prod-code
     3601                            use-index out-code no-lock:
     3602             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     3603                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     3604                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     3605                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     3606                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     3607                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     3608                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3609                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3610                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3611                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3612                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3613                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3614                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3615                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3616                         .
     3617         end.
     3618         ASSIGN
     3619           road-tax-base-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3620           road-tax-rubl-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3621           transport-base-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3622           transport-rubl-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3623           other-base-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3624           other-rubl-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3625                                           vat-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     3626           slt-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     3627                   vat-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     3628           slt-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     3629           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     3630           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     3631         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     3632         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     3633         if transport-base-loc = ? then transport-base-loc = 0.
     3634         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     3635         if other-base-loc     = ? then other-base-loc     = 0.
     3636         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     3637         assign
     3638           transport-cli-loc      = 0
     3639           other-cli-loc          = 0
     3640           road-tax-cli-loc       = ?
     3641           vat-cli-loc            = ?
     3642           slt-cli-loc            = ?
     3643           price-cli-with-tax-loc = ?.
     3644      end.
     3645   ASSIGN
     3646             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3647       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3648   .
     3649       assign
     3650         varnew-price = (if t-doc.print-rubl then price-rubl-with-tax-loc
     3651                                             else price-base-with-tax-loc ) .
     3652          run str/out-add.p ( this-procedure ,
     3653                         recid (t-doc),
     3654                         recid (cur-doc-line),
     3655                         recid (cur-gds-dtl),
     3656                         recid (cur-goods),
     3657                         "update-sale-price",
     3658                         string(varnew-price)) no-error.
     3659          if error-status :error then do:
     3660           v-end-message = substitute(" Ошибка при вызове программы out-add &1 &2" , error-status :get-message(1)  , return-value) .
     3661           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3662           undo, return error v-end-message.
     3663          end.
     3664      end.
     3665       if not is-tsd then do:
     3666         run gbl/calc-trn.p (  this-procedure , recid(new_trn-doc)) no-error .
     3667         if error-status :error then do:
     3668           v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     3669           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3670           undo, return error v-end-message.
     3671         end.
     3672       end.
     3673     end.
     3674   end procedure.
     3675   procedure cb_cloce-quest-neg :
     3676   define output parameter p-is-negostmess as logical   no-undo .
     3677     do
     3678     on error undo, return error return-value
     3679     :
     3680      p-is-negostmess = false .
     3681     end.
     3682   end procedure.
     3683   procedure unitqnty1 :
     3684     define input parameter  p-unit-name        like ub.units.unit-name no-undo .
     3685     define input parameter  p-artic            like ub.goods.artic     no-undo .
     3686     define input parameter  p-prod-type        like ub.goods.prod-type no-undo .
     3687     define input parameter  p-prod-code        like ub.goods.prod-code no-undo .
     3688     define input parameter  p-unit-description as character            no-undo .
     3689     define input parameter  p-qnty             as decimal              no-undo .
     3690     define buffer buf_units for ub.units .
     3691     define buffer buf_goods for ub.goods .
     3692     define variable v-artic as character no-undo .
     3693     define variable v-msg   as character no-undo .
     3694     if p-unit-description = ''
     3695     or p-unit-description = ?
     3696     then do:
     3697       assign
     3698         p-unit-description = "Единица измерения "
     3699       .
     3700     end.
     3701     if  p-unit-name <> ''
     3702     and p-unit-name <> ?
     3703     then do:
     3704       find first buf_units no-lock
     3705         where buf_units.unit-name = p-unit-name
     3706         no-error .
     3707       if not available buf_units
     3708       then do:
     3709         v-msg =
     3710           "Не найдена единица измерения " + chr(10) +
     3711           "p-unit-name" +   p-unit-name + chr(10) +
     3712           "p-artic" +       p-artic +  chr(10) +
     3713           "p-prod-type" +   p-prod-type + chr(10) +
     3714           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3715           "p-qnty" +        string (p-qnty) + chr(10)
     3716            .
     3717         undo, return v-msg .
     3718       end.
     3719     end.
     3720     else do:
     3721       find first buf_goods no-lock
     3722         where buf_goods.artic     = p-artic
     3723           and buf_goods.prod-type = p-prod-type
     3724           and buf_goods.prod-code = p-prod-code
     3725         no-error .
     3726       if not available buf_goods
     3727       then do:
     3728         v-msg =
     3729           "Не найден товар" + chr(10) +
     3730           "p-unit-name" +   p-unit-name + chr(10) +
     3731           "p-artic" +       p-artic +  chr(10) +
     3732           "p-prod-type" +   p-prod-type + chr(10) +
     3733           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3734           "p-qnty" +        string (p-qnty) + chr(10)
     3735           .
     3736         undo, return v-msg .
     3737       end.
     3738       find first buf_units no-lock
     3739         where buf_units.unit-name = buf_goods.unit-base
     3740         no-error .
     3741       if not available buf_units
     3742       then do:
     3743         v-msg =
     3744           "Не найдена единица измерения " + chr(10) +
     3745           "p-unit-name" +   p-unit-name + chr(10) +
     3746           "p-artic" +       p-artic +  chr(10) +
     3747           "p-prod-type" +   p-prod-type + chr(10) +
     3748           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3749           "p-qnty" +        string (p-qnty) + chr(10)
     3750           .
     3751         undo, return v-msg .
     3752       end.
     3753       assign
     3754         v-artic = "Артикул " + string(p-artic) + " " + string(p-prod-type)
     3755                 + " " + string(p-prod-code)
     3756         p-unit-description = "Базовая единица измерения"
     3757       .
     3758     end.
     3759     if lookup('шту':U, buf_units.type) > 0
     3760     or lookup('сер':U, buf_units.type) > 0
     3761     then do:
     3762       if p-qnty <> truncate(p-qnty, 0)
     3763       then do:
     3764         v-msg =
     3765           "Для штучного и серийного товаров резервируемое количество должно быть целым" + chr(10) +
     3766           v-artic + chr(10) +
     3767           p-unit-description + buf_units.unit-name + chr(10) +
     3768           "Запрошено количество " + string (p-qnty) + chr(10).
     3769         undo, return v-msg .
     3770       end.
     3771     end.
     3772   end procedure.
