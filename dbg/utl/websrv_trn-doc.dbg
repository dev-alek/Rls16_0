     1189   define input parameter paruse-parts       as   logical                no-undo.
     1190   define input parameter parall-qnty        as   logical                no-undo.
     1191   define input parameter parfix-price       as   logical                no-undo.
     1192   define buffer crt_trn-doc  for ub.trn-doc.
     1193   define buffer crt_goods    for ub.goods.
     1194   define buffer crt_doc-line for ub.doc-line.
     1195   define buffer crt_gds-dtl  for ub.gds-dtl.
