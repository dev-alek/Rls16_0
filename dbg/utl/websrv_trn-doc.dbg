     1457   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
     1458   procedure who-cli-ora :
     1459   define input  parameter p-cli-code-ora as integer   no-undo .
     1460   define output parameter p-cli-type as character no-undo .
     1461   define output parameter p-cli-code as integer   no-undo .
     1462     do
     1463     on error undo, return error return-value
     1464     :
     1465     if length (string(p-cli-code-ora))  <> 9 then do:
     1466        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
     1467     end.
     1468     if string(p-cli-code-ora) begins "1" or
     1469        string(p-cli-code-ora) begins "2" or
     1470        string(p-cli-code-ora) begins "4" then do:
     1471         p-cli-type = 'орг':U .
     1472         p-cli-code = p-cli-code-ora  .
     1473     end.
     1474     else do:
     1475       if string(p-cli-code-ora) begins "3" then do:
     1476         p-cli-type = 'чел':U .
     1477         p-cli-code = p-cli-code-ora  .
     1478       end.
     1479       else do:
     1480          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
     1481       end.
     1482     end.
     1483     define buffer buf_clients for ub.clients  .
     1484     find first buf_clients no-lock where
     1485                buf_clients.obj-type = p-cli-type and
     1486                buf_clients.obj-code = p-cli-code
     1487                no-error .
     1488         if error-status :error then do:
     1489             return error substitute
     1490             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
     1491                 p-cli-code-ora ,
     1492                 p-cli-type ,
     1493                 p-cli-code ) .
     1494         end.
     1495         if ora-icli_ver-stts-client then do:
     1496             if buf_clients.stts > 0 then do:
     1497                 return error substitute
     1498                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
     1499                     p-cli-code-ora ,
     1500                     p-cli-type ,
     1501                     p-cli-code ) .
     1502             end.
     1503         end.
     1504     end.
     1505   end procedure.
     1506   procedure ora-ver-goods :
     1507   define input  parameter p-gds-code as integer   no-undo .
     1508   define buffer buf_goods for ub.goods  .
     1509   define variable my-message as character no-undo .
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513           find first buf_goods no-lock where
     1514                      buf_goods.gds-code = p-gds-code no-error .
     1515               if error-status :error then do:
     1516                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
     1517                   undo, return error my-message.
     1518               end.
     1519             if buf_goods.stts > 0 then do:
     1520               assign
     1521                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
     1522                 undo, return error my-message.
     1523             end.
     1524     end.
     1525   end procedure.
     1526   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   procedure factord :
     1528     define input  parameter p-fact-date            as date    no-undo .
     1529     define input  parameter p-fact-time            as integer no-undo .
     1530     define input  parameter p-fact-num             as integer no-undo .
     1531     define input  parameter p-shift-date           as date    no-undo .
     1532     define input  parameter p-shift-num            as integer no-undo .
     1533     define input  parameter p-shift-on             as logical no-undo .
     1534     define output parameter p-fact-order           as decimal no-undo .
     1535     define output parameter p-shift-end-fact-order as decimal no-undo .
     1536     define output parameter p-day-end-fact-order   as decimal no-undo .
     1537     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1538     if p-fact-date = ?
     1539     then do:
     1540       return error "Не указана фактическая дата" .
     1541     end.
     1542     define variable v-fact-date-num as integer no-undo .
     1543     assign
     1544       v-fact-date-num = integer(p-fact-date)
     1545     .
     1546     if p-fact-num = ?
     1547     or p-fact-num = 0
     1548     then do:
     1549       return error "Не задан p-fact-num " + string(p-fact-num) .
     1550     end.
     1551     if p-fact-num < 0
     1552     then do:
     1553       return error "Отрицательный fact-num " + string(p-fact-num) .
     1554     end.
     1555     if p-fact-num >= 100000000
     1556     then do:
     1557       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1558     end.
     1559     if p-shift-on = true
     1560     then do:
     1561       if p-shift-date = ?
     1562       then do:
     1563         return error "Не задана дата смены" .
     1564       end.
     1565       if p-shift-num = ?
     1566       or p-shift-num = 0
     1567       then do:
     1568         return error "Не задан номер смены" .
     1569       end.
     1570     end.
     1571     else do:
     1572       assign
     1573         p-shift-date = p-fact-date
     1574         p-shift-num  = 24
     1575       .
     1576     end.
     1577     define variable v-shift-offset as integer no-undo .
     1578     if p-shift-date = p-fact-date
     1579     then do:
     1580       assign
     1581         v-shift-offset = 1
     1582       .
     1583     end.
     1584     if p-shift-date < p-fact-date
     1585     then do:
     1586       assign
     1587         v-shift-offset = 0
     1588       .
     1589     end.
     1590     if p-shift-date > p-fact-date
     1591     then do:
     1592       message
     1593         vss-workfile vss-revision vss-description skip
     1594         "Неправильная дата закрытия смены" skip
     1595         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1596         view-as alert-box error .
     1597       undo, return error
     1598         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1599           ,string(p-fact-date, '99/99/9999':U)
     1600           ,string(p-shift-date, '99/99/9999':U)
     1601           )
     1602       .
     1603     end.
     1604     if p-shift-num < 1
     1605     or p-shift-num > 24
     1606     then do:
     1607       message
     1608         vss-workfile vss-revision vss-description skip
     1609         "Неправильный номер смены" skip
     1610         "p-shift-num" p-shift-num skip
     1611         view-as alert-box error .
     1612       undo, return error return-value .
     1613     end.
     1614     assign
     1615       p-fact-order           = v-fact-date-num
     1616                              + v-shift-offset * 0.5
     1617                              + p-shift-num    * 0.02 - 0.01
     1618                              + p-fact-num     * 0.0000000001
     1619       p-shift-end-fact-order = v-fact-date-num
     1620                              + v-shift-offset * 0.5
     1621                              + p-shift-num    * 0.02
     1622       p-day-end-fact-order   = v-fact-date-num
     1623                              + 0.99
     1624     .
     1625     if p-fact-order           <= v-fact-date-num
     1626     or p-shift-end-fact-order <= v-fact-date-num
     1627     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1628     or p-shift-end-fact-order >= p-day-end-fact-order
     1629     then do:
     1630       message
     1631         vss-workfile vss-revision vss-description skip
     1632         "Внутренняя ошибка при генерации фактического номера" skip
     1633         "p-fact-date"            p-fact-date            skip
     1634         "p-fact-time"            p-fact-time            skip
     1635         "p-fact-num"             p-fact-num             skip
     1636         "p-shift-date"           p-shift-date           skip
     1637         "p-shift-num"            p-shift-num            skip
     1638         "p-shift-on"             p-shift-on             skip
     1639         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1640         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1641         "v-fact-date-num"        v-fact-date-num        skip
     1642         view-as alert-box error .
     1643       undo, return error return-value .
     1644     end.
     1645   end procedure.
     1646   procedure day-begin-fact-order :
     1647     define input  parameter p-fact-date            as date    no-undo .
     1648     define output parameter p-day-begin-fact-order as decimal no-undo .
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       if p-fact-date = ?
     1653       then do:
     1654         assign
     1655           p-day-begin-fact-order = 0
     1656         .
     1657       end.
     1658       else do:
     1659         assign
     1660           p-day-begin-fact-order = integer(p-fact-date)
     1661         .
     1662       end.
     1663     end.
     1664   end procedure.
     1665   procedure factord-max-fact-order :
     1666     define output parameter p-max-fact-order as decimal   no-undo .
     1667     do
     1668     on error undo, return error return-value
     1669     :
     1670       run day-begin-fact-order in this-procedure
     1671         (input  date(1, 1, 5000)
     1672         ,output p-max-fact-order
     1673         ) .
     1674     end.
     1675   end procedure.
     1676   procedure factord-cut-archive :
     1677     define input  parameter p-obj-type             as character no-undo .
     1678     define input  parameter p-obj-code             as integer   no-undo .
     1679     define input  parameter p-fact-date            as date      no-undo .
     1680     define output parameter p-shift-on             as logical   no-undo .
     1681     define output parameter p-shift-date           as date      no-undo .
     1682     define output parameter p-shift-num            as integer   no-undo .
     1683     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1684     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1685     define variable v-fact-order as decimal   no-undo .
     1686     define buffer buf_shift-obj for ub.shift-obj .
     1687     do
     1688     on error undo, return error return-value
     1689     :
     1690   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1691   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1692     (input  p-obj-type
     1693     ,input  p-obj-code
     1694     ,input  'shift-on=request'
     1695     ,output p-shift-on
     1696     ) no-error .
     1697       if error-status :error
     1698       then do:
     1699         message
     1700           vss-workfile vss-revision vss-description skip
     1701           "Ошибка при определении атрибута объекта" skip
     1702           "Объект" p-obj-type p-obj-code skip
     1703           error-status :get-message(1) skip
     1704           return-value skip
     1705           view-as alert-box error .
     1706         undo, return error return-value .
     1707       end.
     1708       if p-shift-on = false
     1709       then do:
     1710         assign
     1711           p-shift-date               = ?
     1712           p-shift-num                = 0
     1713         .
     1714       end.
     1715       else do:
     1716         find first buf_shift-obj share-lock
     1717           where buf_shift-obj.obj-type   = p-obj-type
     1718             and buf_shift-obj.obj-code   = p-obj-code
     1719             and buf_shift-obj.shift-date > p-fact-date
     1720           use-index pi
     1721           no-error .
     1722         if not available buf_shift-obj
     1723         or buf_shift-obj.status_ <> 'зкр':U
     1724         then do:
     1725           message
     1726             vss-workfile vss-revision vss-description skip
     1727             "Невозможно вычислить последнюю смену" skip
     1728             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1729             "Объект" p-obj-type p-obj-code skip
     1730             "Дата" p-fact-date skip
     1731             view-as alert-box error .
     1732           undo, return error return-value .
     1733         end.
     1734         find last buf_shift-obj share-lock
     1735           where buf_shift-obj.obj-type = p-obj-type
     1736             and buf_shift-obj.obj-code = p-obj-code
     1737             and buf_shift-obj.shift-date <= p-fact-date
     1738           use-index pi
     1739           no-error .
     1740         if available buf_shift-obj
     1741         then do:
     1742           if  buf_shift-obj.status_ = 'зкр':U
     1743           then do:
     1744             assign
     1745               p-shift-date = buf_shift-obj.shift-date
     1746               p-shift-num  = buf_shift-obj.shift-num
     1747             .
     1748           end.
     1749           else do:
     1750             message
     1751               vss-workfile vss-revision vss-description skip
     1752               "Невозможно вычислить последнюю смену" skip
     1753               "Статус смены отличен от статуса" 'зкр':U skip
     1754               "Объект" p-obj-type p-obj-code skip
     1755               "Дата" p-fact-date skip
     1756               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1757               view-as alert-box error .
     1758             undo, return error return-value .
     1759           end.
     1760         end.
     1761         else do:
     1762           assign
     1763             p-shift-date = p-fact-date - 1
     1764             p-shift-num  = 1
     1765           .
     1766         end.
     1767       end.
     1768       run factord in this-procedure
     1769         (input  p-fact-date
     1770         ,input  1
     1771         ,input  1
     1772         ,input  p-shift-date
     1773         ,input  p-shift-num
     1774         ,input  p-shift-on
     1775         ,output v-fact-order
     1776         ,output p-shift-end-fact-order
     1777         ,output p-day-end-fact-order
     1778         ) no-error .
     1779       if error-status :error
     1780       then do:
     1781         message
     1782           vss-workfile vss-revision vss-description skip
     1783           "Ошибка при вызове процедуры factord"
     1784           error-status :get-message(1) skip
     1785           return-value skip
     1786           view-as alert-box error .
     1787         undo, return error return-value .
     1788       end.
     1789     end.
     1790   end procedure.
     1791   procedure factord-lock-shift :
     1792     define input  parameter p-obj-type  as character no-undo .
     1793     define input  parameter p-obj-code  as integer   no-undo .
     1794     define input  parameter p-fact-date as date      no-undo .
     1795     define parameter buffer buf_shift-obj for ub.shift-obj .
     1796     define variable v-shift-on      as logical   no-undo .
     1797     define variable v-extra-message as character no-undo .
     1798     define variable v-error as character no-undo .
     1799     do
     1800     on error undo, return error return-value
     1801     :
     1802   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1803   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1804     (input  p-obj-type
     1805     ,input  p-obj-code
     1806     ,input  'shift-on=request'
     1807     ,output v-shift-on
     1808     ) no-error .
     1809       if error-status :error
     1810       then do:
     1811         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1812         undo, return error v-error .
     1813       end.
     1814       if v-shift-on = true
     1815       then do:
     1816         find first buf_shift-obj share-lock
     1817           where buf_shift-obj.obj-type   = p-obj-type
     1818             and buf_shift-obj.obj-code   = p-obj-code
     1819             and buf_shift-obj.shift-date > p-fact-date
     1820           use-index pi
     1821           no-error .
     1822         if not available buf_shift-obj
     1823         or buf_shift-obj.status_ <> 'зкр':U
     1824         then do:
     1825           find last buf_shift-obj
     1826             where buf_shift-obj.obj-type = p-obj-type
     1827               and buf_shift-obj.obj-code = p-obj-code
     1828               and buf_shift-obj.status_  = 'зкр':U
     1829             use-index stts
     1830             no-error .
     1831           if available buf_shift-obj
     1832           then do:
     1833             assign
     1834               v-extra-message =
     1835                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1836                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1837                               )
     1838             .
     1839           end.
     1840           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1841           undo, return error v-error .
     1842         end.
     1843       end.
     1844     end.
     1845   end procedure.
     1846   procedure factord-end-day :
     1847     define input  parameter p-fact-date            as date    no-undo .
     1848     define output parameter p-day-end-fact-order   as decimal no-undo .
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852       if p-fact-date = ?
     1853       then do:
     1854         return error "Не указана фактическая дата" .
     1855       end.
     1856       assign
     1857         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1858       .
     1859     end.
     1860   end procedure.
     1861   procedure factord-to-date :
     1862     define input  parameter p-fact-order as decimal no-undo .
     1863     define output parameter p-fact-date  as date    no-undo .
     1864     define variable v-ref-date  as date      no-undo .
     1865     define variable v-ref-delta as integer   no-undo .
     1866     do
     1867     on error undo, return error return-value
     1868     :
     1869       if p-fact-order = ?
     1870       or p-fact-order = 0
     1871       then do:
     1872         return error "Не указан fact-order" .
     1873       end.
     1874       assign
     1875         v-ref-date  = date(1, 1, 2000)
     1876       .
     1877       assign
     1878         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1879       .
     1880       assign
     1881         p-fact-date = v-ref-date + v-ref-delta
     1882       .
     1883     end.
     1884   end procedure.
     1885   procedure factord-to-fact-num :
     1886     define input  parameter p-fact-order as decimal no-undo .
     1887     define output parameter p-fact-num   as integer no-undo .
     1888     define variable v-fact-order-trunc as decimal no-undo .
     1889     do
     1890     on error undo, return error return-value
     1891     :
     1892       if p-fact-order = ?
     1893       or p-fact-order = 0
     1894       then do:
     1895         return error "Не указан fact-order" .
     1896       end.
     1897       assign
     1898        v-fact-order-trunc = truncate(p-fact-order, 2)
     1899       .
     1900       assign
     1901         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1902       .
     1903     end.
     1904   end procedure.
     1905   procedure factord-to-shift-num :
     1906     define input  parameter p-fact-order as decimal no-undo .
     1907     define output parameter p-shift-num   as integer no-undo .
     1908     define variable  p-shift-numd  as decimal   no-undo .
     1909     define variable v-fact-order-trunc as decimal no-undo .
     1910     do
     1911     on error undo, return error return-value
     1912     :
     1913       if p-fact-order = ?
     1914       or p-fact-order = 0
     1915       then do:
     1916         return error "Не указан fact-order" .
     1917       end.
     1918       assign
     1919        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1920       .
     1921       if v-fact-order-trunc < 0.5 then do:
     1922         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1923       end.
     1924       assign
     1925         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1926         .
     1927        assign
     1928         p-shift-num = truncate (p-shift-numd , 0)
     1929       .
     1930     end.
     1931   end procedure.
