     1169   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1170   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1171   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
