      153   define variable vss-archive     as character no-undo init "$Archive: utl/websrv_trn-doc.p $":U .
      154   define variable vss-description as character no-undo init "Импорт накладных из временной таблицы".
      155   procedure vss-get-info :
      156     define output parameter p-vss-revision    like vss-revision    no-undo .
      157     define output parameter p-vss-author      like vss-author      no-undo .
      158     define output parameter p-vss-date        like vss-date        no-undo .
