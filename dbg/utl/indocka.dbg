     1282   run gbl/filnline.p (input  parfile-cli
     1283                  ,output varend-new-line).
     1284   if varend-new-line = no then do:
     1285     output stream str-cli to value(parfile-cli) append.
     1286     put stream str-cli unformatted skip(1).
     1287     output stream str-cli close.
     1288   end.
     1289   input stream str-cli from value(parfile-cli).
     1290   assign
     1291     varfile-name-cli-log = entry(1, parfile-cli, ".") + ".log"
     1292     varfile-name-cli-err = entry(1, parfile-cli, ".") + ".err".
     1293   output stream str-cli-log to value(varfile-name-cli-log).
     1294   assign
     1295     varln = 0.
     1296   repeat :
     1297     import stream str-cli unformatted vartemp-str-cli.
     1298     assign
     1299       varln = varln + 1.
     1300     put stream str-cli-log unformatted "Считана строка " vartemp-str-cli " № " varln.
     1301     if vartemp-str-cli <> "":u then do:
     1302       if num-entries(vartemp-str-cli,";") <> 4 and
     1303          num-entries(vartemp-str-cli,";") <> 3 then do:
     1304         if varopen-err-cli <> yes then do:
     1305           output stream str-err to value(varfile-name-cli-err).
     1306           assign
     1307             varopen-err-cli = yes.
     1308         end.
     1309         put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1310         put stream str-err unformatted "Строка № " varln " количество параметров согласно формату 'Тип;Код;ID_поставщика;Договор' должен состоять из 4 или 3-х позиций. В строке " vartemp-str-cli " их " num-entries(vartemp-str-cli,";") skip.
     1311         assign
     1312           varfatal-error = yes.
     1313         next.
     1314       end.
     1315       assign
     1316         varobj-type = TRIM(entry(1, vartemp-str-cli, ";"), '"').
     1317       if varobj-type <> 'орг':U and
     1318          varobj-type <> 'чел':U then do:
     1319         if varopen-err-cli <> yes then do:
     1320           output stream str-err to value(varfile-name-cli-err).
     1321           assign
     1322             varopen-err-cli = yes.
     1323         end.
     1324         put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1325         put stream str-err unformatted "Строка № " varln " первый параметр согласно формату 'Тип;Код;ID_поставщика;Договор' должен быть 'орг' или 'чел'. В строке " vartemp-str-cli " он " varobj-type skip.
     1326         assign
     1327           varfatal-error = yes.
     1328         next.
     1329       end.
     1330       assign
     1331         varobj-code = integer(entry(2, vartemp-str-cli, ";")) no-error.
     1332       if error-status:error then do:
     1333         if varopen-err-cli <> yes then do:
     1334           output stream str-err to value(varfile-name-cli-err).
     1335           assign
     1336             varopen-err-cli = yes.
     1337         end.
     1338         put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1339         put stream str-err unformatted "Строка № " varln " второй параметр согласно формату 'Тип;Код;ID_поставщика;Договор' должен быть целым числом. В строке " vartemp-str-cli " он " entry(2, vartemp-str-cli, ";") skip.
     1340         assign
     1341           varfatal-error = yes.
     1342         next.
     1343       end.
     1344       if entry(4, vartemp-str-cli, ";") <> "":u then do:
     1345         assign
     1346           varcontract-code = integer(entry(4, vartemp-str-cli, ";")) no-error.
     1347         if error-status:error then do:
     1348           if varopen-err-cli <> yes then do:
     1349             output stream str-err to value(varfile-name-cli-err).
     1350             assign
     1351               varopen-err-cli = yes.
     1352           end.
     1353           put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1354           put stream str-err unformatted "Строка № " varln " четвертый параметр согласно формату 'Тип;Код;ID_поставщика;Договор' должен быть целым числом. В строке " vartemp-str-cli " он " entry(4, vartemp-str-cli, ";") skip.
     1355           assign
     1356             varfatal-error = yes.
     1357           next.
     1358         end.
     1359       end.
     1360       else do:
     1361         assign
     1362           varcontract-code = 0.
     1363       end.
     1364       assign
     1365         varid-supp = entry(3, vartemp-str-cli, ";").
     1366       find first tt-id where tt-id.id-supl-old-system = varid-supp  no-error.
     1367       if available tt-id then do:
     1368         if varopen-err-cli <> yes then do:
     1369           output stream str-err to value(varfile-name-cli-err).
     1370           assign
     1371             varopen-err-cli = yes.
     1372         end.
     1373         put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1374         put stream str-err unformatted "Строка № " varln ". Уже есть строка № " tt-id.ln " где ID_поставщика " tt-id.id-supl-old-system " ." skip.
     1375         assign
     1376           varfatal-error = yes.
     1377         next.
     1378       end.
     1379       find first bf_clients where bf_clients.obj-type = varobj-type and
     1380                                   bf_clients.obj-code = varobj-code no-lock no-error.
     1381       if not available bf_clients then do:
     1382         if varopen-err-cli <> yes then do:
     1383           output stream str-err to value(varfile-name-cli-err).
     1384           assign
     1385             varopen-err-cli = yes.
     1386         end.
     1387         put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1388         put stream str-err unformatted "Строка № " varln ". В справочнике нет клиента у которого тип " varobj-type " код " varobj-code skip.
     1389         assign
     1390           varfatal-error = yes.
     1391         next.
     1392       end.
     1393       if varcontract-code <> 0 then do:
     1394         find first bf_contract where bf_contract.host-code     = varhost-code     and
     1395                                      bf_contract.contract-code = varcontract-code no-lock no-error.
     1396         if not available bf_contract then do:
     1397           if varopen-err-cli <> yes then do:
     1398             output stream str-err to value(varfile-name-cli-err).
     1399             assign
     1400               varopen-err-cli = yes.
     1401           end.
     1402           put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1403           put stream str-err unformatted "Строка № " varln ". Объект " parobj-type " " parobj-code ".Фирма объекта " varhost-code " Нет договора с внутренним номером " varcontract-code " на данной фирме." skip.
     1404           assign
     1405             varfatal-error = yes.
     1406           next.
     1407         end.
     1408         if bf_contract.cli-type <> bf_clients.obj-type or
     1409            bf_contract.cli-code <> bf_clients.obj-code then do:
     1410           if varopen-err-cli <> yes then do:
     1411             output stream str-err to value(varfile-name-cli-err).
     1412             assign
     1413               varopen-err-cli = yes.
     1414           end.
     1415           put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1416           put stream str-err unformatted "Строка № " varln ". Объект " parobj-type " " parobj-code ".Фирма объекта " varhost-code " Договор с внутренним номером " entry(4, vartemp-str-cli, ";") " по поставщику. " bf_contract.cli-type " " bf_contract.cli-code " , но в строке указан поставщик " bf_clients.obj-type " " bf_clients.obj-code skip.
     1417           assign
     1418             varfatal-error = yes.
     1419           next.
     1420         end.
     1421       end.
     1422       create tt-id.
     1423       assign
     1424         tt-id.supp-type          = bf_clients.obj-type
     1425         tt-id.supp-code          = bf_clients.obj-code
     1426         tt-id.id-supl-old-system = varid-supp
     1427         tt-id.contract-code      = varcontract-code
     1428         tt-id.ln                 = varln
     1429       no-error.
     1430       if error-status:error then do:
     1431         if varopen-err-cli <> yes then do:
     1432           output stream str-err to value(varfile-name-cli-err).
     1433           assign
     1434             varopen-err-cli = yes.
     1435         end.
     1436         put stream str-cli-log unformatted ". Считанная строка имеет ошибки. " skip.
     1437         put stream str-err unformatted "Строка № " varln ". Ошибка при создании временной таблицы по поставщикам: " return-value error-status:get-message(1) skip.
     1438         assign
     1439           varfatal-error = yes.
     1440         next.
     1441       end.
     1442       put stream str-cli-log unformatted ". Считанная строка корректна. " skip.
     1443     end.
     1444   end.
     1445   input  stream str-cli     close.
     1446   output stream str-cli-log close.
     1447   if varopen-err-cli = yes then do:
     1448     output stream str-err close.
     1449   end.
     1450   if varfatal-error then do:
     1451     message
     1452       "Ошибка при импорте файла поставщиков." skip
     1453       "Документы не загружались." skip
     1454       view-as alert-box error.
     1455     run gbl/prnfilen.w
     1456       (input  "Ошибки при импорте файла поставщиков"
     1457       ,input  0
     1458       ,input  varfile-name-cli-err
     1459       ,input  7
     1460       ,output varuser-action
     1461       ,output varprinted
     1462       ).
     1463     return error.
     1464   end.
     1465   run gbl/filnline.p (input  parfile-doc
     1466                  ,output varend-new-line).
     1467   if varend-new-line = no then do:
     1468     output stream str-doc to value(parfile-doc) append.
     1469     put stream str-doc unformatted skip(1).
     1470     output stream str-doc close.
     1471   end.
     1472   input stream str-doc from value(parfile-doc).
     1473   assign
     1474     varfile-name-doc-log = entry(1, parfile-doc, ".") + ".log"
     1475     varfile-name-doc-err = entry(1, parfile-doc, ".") + ".err".
     1476   output stream str-doc-log to value(varfile-name-doc-log).
     1477   assign
     1478     varln = 0.
     1479   repeat :
     1480     import stream str-doc unformatted vartemp-str-doc.
     1481     assign
     1482       varln = varln + 1.
