        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: indocka.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: utl/indocka.p $":U .
        7   define variable vss-description as character no-undo initial "Утилита импорта документов по датам":U .
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define new global shared variable g#libbcrcn as handle no-undo .
       13   define new global shared variable g#library  as handle no-undo .
       14   define new global shared variable g#library2 as handle no-undo .
       15   define new global shared variable g#lib-trn  as handle no-undo .
       16   define new global shared variable g#lib-trn2 as handle no-undo .
       17   define new global shared variable g#lib-trn3 as handle no-undo .
       18   define new global shared variable g#lib-trn4 as handle no-undo .
       19   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       20   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
       21   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
       22     field cst-code                like ub.trn-doc.cst-code
       23     field part-code               like ub.parts.part-code
       24     .
       25   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
       26   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
       27   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
       28   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       29   procedure doc-code:
       30   define input  parameter parmode          as   character           no-undo.
       31   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       32   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       33   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       34   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       35   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       36   define variable vardb-remote     as   logical             no-undo.
       37   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       38   define variable v-delimiter as character no-undo .
       39   do
       40   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       41   :
       42   find first buf_sys-ctrl no-lock .
       43   vardb-remote = buf_sys-ctrl.db-num <> 0 .
       44     CASE parmode:
       45       when "main":u then do:
       46         if vardb-remote then do:
       47           assign
       48             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
       49         end.
       50         else do:
       51           assign
       52             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
       53         end.
       54       end.
       55       when "trio" then do:
       56         assign
       57           pardoc-code = replace (parroot-doc-code, "=", "*").
       58       end.
       59       otherwise do:
       60         assign
       61         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
       62         no-error
       63         .
       64         if error-status:error  then do:
       65           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
       66                                         ,chr(10)
       67                                         ,parmode
       68                                         ).
       69         end.
       70         if num-entries(parmode) = 1
       71         and parmode <> "chip":U
       72         and parmode <> "chip_s":U
       73         then do:
       74           assign
       75           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
       76         end.
       77         else if (lookup("chip":U, parmode) > 0
       78                  or
       79                  lookup("chip_s":U, parmode) > 0) then do:
       80           assign
       81             vartemp-doc-code = parroot-doc-code.
       82           do while true:
       83             if index (vartemp-doc-code , ".") = 0 then
       84               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
       85             else
       86               vartemp-doc-code  =
       87               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
       88               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
       89               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
       90             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
       91           end.
       92           assign
       93             pardoc-code = vartemp-doc-code.
       94         end.
       95       end.
       96     end CASE.
       97     if pardoc-code = '':U
       98     or (parroot-doc-code <> '':U
       99     and pardoc-code = parroot-doc-code) then do:
      100       undo, return error substitute("Ошибка при генерации номера документа&1"
      101                                     ,chr(10)).
      102     end.
      103   end.
      104   end. // procedure/method
      105   function get-doc-code-int64 returns int64
      106     ( input p-doc-code as character ) :
      107     define variable v-ind              as integer   no-undo .
      108     define variable v-num-entries      as integer   no-undo .
      109     define variable v-doc-code-int64   as int64     no-undo .
      110     define variable v-canonic-doc-code as character no-undo .
      111     assign
      112       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      113       v-canonic-doc-code = p-doc-code
      114     .
      115     do v-ind = 1 to v-num-entries
      116     :
      117       assign
      118         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      119       .
      120     end.
      121     assign
      122       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      123     .
      124     return v-doc-code-int64 .
      125   end. // function/method
      126   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127     define variable v-cntxt-db-num        as integer   no-undo .
