      171   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   procedure cur-time :
      173      define output parameter p-today as date      no-undo .
      174      define output parameter p-time  as integer   no-undo .
      175     do
      176     on error undo, return error
      177     :
      178       define variable v-date1 as date      no-undo .
      179       define variable v-date2 as date      no-undo .
      180       define variable v-time  as integer   no-undo .
      181       assign
      182         v-date1 = today
      183         v-time  = time
      184         v-date2 = today
      185       .
      186       if v-date1 <> v-date2
      187       then do:
      188         assign
      189           v-date1 = today
      190           v-time  = v-time
      191         .
      192       end.
      193       assign
      194         p-today = v-date1
      195         p-time  = v-time
      196       .
      197     end.
      198   end.
      199   function cur-time-date returns character
      200   :
      201     return string(today, '99/99/9999':U) .
      202   end.
      203   function cur-time-mjd returns decimal
      204   :
      205     define variable v-date as date      no-undo .
      206     define variable v-time as integer   no-undo .
      207     run cur-time in this-procedure
      208       (output v-date
      209       ,output v-time
      210       ) .
      211     return integer(v-date) - 2400002 + (v-time / 86400) .
      212   end.
      213   function cur-time-get-ending-index returns integer
      214   (input p-number as integer
      215   )
      216   :
      217     if p-number < 0
      218     or p-number = ?
      219     then do:
      220       return 1 .
      221     end.
      222     define variable v-rest as integer   no-undo .
      223     assign
      224       p-number = p-number modulo 100
      225     .
      226     if p-number < 20
      227     then do:
      228       assign
      229         v-rest = p-number
      230       .
      231     end.
      232     else do:
      233       assign
      234         v-rest = p-number modulo 10
      235       .
      236     end.
      237     case v-rest :
      238       when 1
      239       then do:
      240         return 2 .
      241       end.
      242       when 2 or
      243       when 3 or
      244       when 4
      245       then do:
      246         return 3 .
      247       end.
      248       otherwise do:
      249         return 1 .
      250       end.
      251     end case .
      252   end.
      253   procedure cur-time-mjd-to-date :
      254      define input  parameter i-mjd-diff as decimal no-undo.
      255      define output parameter o-Date     as date    no-undo.
      256      define output parameter o-Time     as integer no-undo.
      257      define variable v-day-number as integer   no-undo .
      258      if    i-mjd-diff < 0
      259         or i-mjd-diff = ?
      260      then do:
      261         return "?" .
      262      end.
      263      assign
      264         v-day-number = truncate(i-mjd-diff,0).
      265         o-Date = date(v-day-number + 2400002).
      266         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      267     .
      268   end.
      269   function cur-time-mjd-to-string returns character
      270   (input p-mjd-diff as decimal
      271   )
      272   :
      273     define variable v-day-number as integer   no-undo .
      274     define variable v-seconds    as integer   no-undo .
      275     define variable v-hour       as integer   no-undo .
      276     define variable v-min        as integer   no-undo .
      277     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      278     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      279     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      280     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      281     if p-mjd-diff < 0
      282     or p-mjd-diff = ?
      283     then do:
      284       return "?" .
      285     end.
      286     assign
      287       v-day-number = integer(truncate(p-mjd-diff,0))
      288       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      289     .
      290     if v-seconds > 86400
      291     then do:
      292       assign
      293         v-seconds = 86400 - 1
      294       .
      295     end.
      296     if v-seconds < 0
      297     then do:
      298       assign
      299         v-seconds = 0
      300       .
      301     end.
      302     assign
      303       v-hour = truncate(v-seconds / 3600, 0)
      304     .
      305     assign
      306       v-seconds = v-seconds modulo 3600
      307     .
      308     assign
      309       v-min = truncate(v-seconds / 60, 0)
      310     .
      311     assign
      312       v-seconds = v-seconds modulo 60
      313     .
      314     return
      315         (if v-day-number <> 0
      316           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      317           else ""
      318         )
      319       + (if v-day-number <> 0 or v-hour <> 0
      320           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      321           else ""
      322         )
      323       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      324           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      325           else ""
      326         )
      327       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      328       .
      329   end.
      330   function cur-time-string returns character
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      339   end.
      340   function cur-time-string-sec returns character
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      349   end.
      350   function cur-time-custom  returns character
      351   (input p-prefix as character
      352   ,input p-date-format as character
      353   ,input p-delimiter as character
      354   ,input p-time-format as character
      355   ,input p-suffix as character
      356   )
      357   :
      358     define variable v-date as date      no-undo .
      359     define variable v-time as integer   no-undo .
      360     run cur-time in this-procedure
      361       (output v-date
      362       ,output v-time
      363       ) .
      364     return
      365       p-prefix
      366       + string(v-date, p-date-format)
      367       + p-delimiter
      368       + string(v-time, p-time-format)
      369       + p-suffix
      370       .
      371   end.
      372   function cur-time-print  returns character
      373   :
      374     define variable v-date as date      no-undo .
      375     define variable v-time as integer   no-undo .
      376     run cur-time in this-procedure
      377       (output v-date
      378       ,output v-time
      379       ) .
      380     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      381   end.
      382   function cur-time-datetime returns datetime
      383   :
      384     define variable v-char as character no-undo .
      385     define variable v-datetime as datetime no-undo .
      386     v-char = cur-time-string().
      387     v-datetime = datetime(v-char).
      388     return  v-datetime.
      389   end.
      390   function cur-time-string-msec returns character
      391   :
      392     define variable v-date as datetime  no-undo .
      393     v-date = now.
      394     return string(v-date) .
      395   end.
      396   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   procedure factord :
      398     define input  parameter p-fact-date            as date    no-undo .
      399     define input  parameter p-fact-time            as integer no-undo .
      400     define input  parameter p-fact-num             as integer no-undo .
      401     define input  parameter p-shift-date           as date    no-undo .
      402     define input  parameter p-shift-num            as integer no-undo .
      403     define input  parameter p-shift-on             as logical no-undo .
      404     define output parameter p-fact-order           as decimal no-undo .
      405     define output parameter p-shift-end-fact-order as decimal no-undo .
      406     define output parameter p-day-end-fact-order   as decimal no-undo .
      407     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      408     if p-fact-date = ?
      409     then do:
      410       return error "Не указана фактическая дата" .
      411     end.
      412     define variable v-fact-date-num as integer no-undo .
      413     assign
      414       v-fact-date-num = integer(p-fact-date)
      415     .
      416     if p-fact-num = ?
      417     or p-fact-num = 0
      418     then do:
      419       return error "Не задан p-fact-num " + string(p-fact-num) .
      420     end.
      421     if p-fact-num < 0
      422     then do:
      423       return error "Отрицательный fact-num " + string(p-fact-num) .
      424     end.
      425     if p-fact-num >= 100000000
      426     then do:
      427       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      428     end.
      429     if p-shift-on = true
      430     then do:
      431       if p-shift-date = ?
      432       then do:
      433         return error "Не задана дата смены" .
      434       end.
      435       if p-shift-num = ?
      436       or p-shift-num = 0
      437       then do:
      438         return error "Не задан номер смены" .
      439       end.
      440     end.
      441     else do:
      442       assign
      443         p-shift-date = p-fact-date
      444         p-shift-num  = 24
      445       .
      446     end.
      447     define variable v-shift-offset as integer no-undo .
      448     if p-shift-date = p-fact-date
      449     then do:
      450       assign
      451         v-shift-offset = 1
      452       .
      453     end.
      454     if p-shift-date < p-fact-date
      455     then do:
      456       assign
      457         v-shift-offset = 0
      458       .
      459     end.
      460     if p-shift-date > p-fact-date
      461     then do:
      462       message
      463         vss-workfile vss-revision vss-description skip
      464         "Неправильная дата закрытия смены" skip
      465         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      466         view-as alert-box error .
      467       undo, return error
      468         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      469           ,string(p-fact-date, '99/99/9999':U)
      470           ,string(p-shift-date, '99/99/9999':U)
      471           )
      472       .
      473     end.
      474     if p-shift-num < 1
      475     or p-shift-num > 24
      476     then do:
      477       message
      478         vss-workfile vss-revision vss-description skip
      479         "Неправильный номер смены" skip
      480         "p-shift-num" p-shift-num skip
      481         view-as alert-box error .
      482       undo, return error return-value .
      483     end.
      484     assign
      485       p-fact-order           = v-fact-date-num
      486                              + v-shift-offset * 0.5
      487                              + p-shift-num    * 0.02 - 0.01
      488                              + p-fact-num     * 0.0000000001
      489       p-shift-end-fact-order = v-fact-date-num
      490                              + v-shift-offset * 0.5
      491                              + p-shift-num    * 0.02
      492       p-day-end-fact-order   = v-fact-date-num
      493                              + 0.99
      494     .
      495     if p-fact-order           <= v-fact-date-num
      496     or p-shift-end-fact-order <= v-fact-date-num
      497     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      498     or p-shift-end-fact-order >= p-day-end-fact-order
      499     then do:
      500       message
      501         vss-workfile vss-revision vss-description skip
      502         "Внутренняя ошибка при генерации фактического номера" skip
      503         "p-fact-date"            p-fact-date            skip
      504         "p-fact-time"            p-fact-time            skip
      505         "p-fact-num"             p-fact-num             skip
      506         "p-shift-date"           p-shift-date           skip
      507         "p-shift-num"            p-shift-num            skip
      508         "p-shift-on"             p-shift-on             skip
      509         "p-shift-end-fact-order" p-shift-end-fact-order skip
      510         "p-day-end-fact-order"   p-day-end-fact-order   skip
      511         "v-fact-date-num"        v-fact-date-num        skip
      512         view-as alert-box error .
      513       undo, return error return-value .
      514     end.
      515   end procedure.
      516   procedure day-begin-fact-order :
      517     define input  parameter p-fact-date            as date    no-undo .
      518     define output parameter p-day-begin-fact-order as decimal no-undo .
      519     do
      520     on error undo, return error return-value
      521     :
      522       if p-fact-date = ?
      523       then do:
      524         assign
      525           p-day-begin-fact-order = 0
      526         .
      527       end.
      528       else do:
      529         assign
      530           p-day-begin-fact-order = integer(p-fact-date)
      531         .
      532       end.
      533     end.
      534   end procedure.
      535   procedure factord-max-fact-order :
      536     define output parameter p-max-fact-order as decimal   no-undo .
      537     do
      538     on error undo, return error return-value
      539     :
      540       run day-begin-fact-order in this-procedure
      541         (input  date(1, 1, 5000)
      542         ,output p-max-fact-order
      543         ) .
      544     end.
      545   end procedure.
      546   procedure factord-cut-archive :
      547     define input  parameter p-obj-type             as character no-undo .
      548     define input  parameter p-obj-code             as integer   no-undo .
      549     define input  parameter p-fact-date            as date      no-undo .
      550     define output parameter p-shift-on             as logical   no-undo .
      551     define output parameter p-shift-date           as date      no-undo .
      552     define output parameter p-shift-num            as integer   no-undo .
      553     define output parameter p-day-end-fact-order   as decimal   no-undo .
      554     define output parameter p-shift-end-fact-order as decimal   no-undo .
      555     define variable v-fact-order as decimal   no-undo .
      556     define buffer buf_shift-obj for ub.shift-obj .
      557     do
      558     on error undo, return error return-value
      559     :
      560   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      562     (input  p-obj-type
      563     ,input  p-obj-code
      564     ,input  'shift-on=request'
      565     ,output p-shift-on
      566     ) no-error .
      567       if error-status :error
      568       then do:
      569         message
      570           vss-workfile vss-revision vss-description skip
      571           "Ошибка при определении атрибута объекта" skip
      572           "Объект" p-obj-type p-obj-code skip
      573           error-status :get-message(1) skip
      574           return-value skip
      575           view-as alert-box error .
      576         undo, return error return-value .
      577       end.
      578       if p-shift-on = false
      579       then do:
      580         assign
      581           p-shift-date               = ?
      582           p-shift-num                = 0
      583         .
      584       end.
      585       else do:
      586         find first buf_shift-obj share-lock
      587           where buf_shift-obj.obj-type   = p-obj-type
      588             and buf_shift-obj.obj-code   = p-obj-code
      589             and buf_shift-obj.shift-date > p-fact-date
      590           use-index pi
      591           no-error .
      592         if not available buf_shift-obj
      593         or buf_shift-obj.status_ <> 'зкр':U
      594         then do:
      595           message
      596             vss-workfile vss-revision vss-description skip
      597             "Невозможно вычислить последнюю смену" skip
      598             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      599             "Объект" p-obj-type p-obj-code skip
      600             "Дата" p-fact-date skip
      601             view-as alert-box error .
      602           undo, return error return-value .
      603         end.
      604         find last buf_shift-obj share-lock
      605           where buf_shift-obj.obj-type = p-obj-type
      606             and buf_shift-obj.obj-code = p-obj-code
      607             and buf_shift-obj.shift-date <= p-fact-date
      608           use-index pi
      609           no-error .
      610         if available buf_shift-obj
      611         then do:
      612           if  buf_shift-obj.status_ = 'зкр':U
      613           then do:
      614             assign
      615               p-shift-date = buf_shift-obj.shift-date
      616               p-shift-num  = buf_shift-obj.shift-num
      617             .
      618           end.
      619           else do:
      620             message
      621               vss-workfile vss-revision vss-description skip
      622               "Невозможно вычислить последнюю смену" skip
      623               "Статус смены отличен от статуса" 'зкр':U skip
      624               "Объект" p-obj-type p-obj-code skip
      625               "Дата" p-fact-date skip
      626               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      627               view-as alert-box error .
      628             undo, return error return-value .
      629           end.
      630         end.
      631         else do:
      632           assign
      633             p-shift-date = p-fact-date - 1
      634             p-shift-num  = 1
      635           .
      636         end.
      637       end.
      638       run factord in this-procedure
      639         (input  p-fact-date
      640         ,input  1
      641         ,input  1
      642         ,input  p-shift-date
      643         ,input  p-shift-num
      644         ,input  p-shift-on
      645         ,output v-fact-order
      646         ,output p-shift-end-fact-order
      647         ,output p-day-end-fact-order
      648         ) no-error .
      649       if error-status :error
      650       then do:
      651         message
      652           vss-workfile vss-revision vss-description skip
      653           "Ошибка при вызове процедуры factord"
      654           error-status :get-message(1) skip
      655           return-value skip
      656           view-as alert-box error .
      657         undo, return error return-value .
      658       end.
      659     end.
      660   end procedure.
      661   procedure factord-lock-shift :
      662     define input  parameter p-obj-type  as character no-undo .
      663     define input  parameter p-obj-code  as integer   no-undo .
      664     define input  parameter p-fact-date as date      no-undo .
      665     define parameter buffer buf_shift-obj for ub.shift-obj .
      666     define variable v-shift-on      as logical   no-undo .
      667     define variable v-extra-message as character no-undo .
      668     define variable v-error as character no-undo .
      669     do
      670     on error undo, return error return-value
      671     :
      672   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      673   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      674     (input  p-obj-type
      675     ,input  p-obj-code
      676     ,input  'shift-on=request'
      677     ,output v-shift-on
      678     ) no-error .
      679       if error-status :error
      680       then do:
      681         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      682         undo, return error v-error .
      683       end.
      684       if v-shift-on = true
      685       then do:
      686         find first buf_shift-obj share-lock
      687           where buf_shift-obj.obj-type   = p-obj-type
      688             and buf_shift-obj.obj-code   = p-obj-code
      689             and buf_shift-obj.shift-date > p-fact-date
      690           use-index pi
      691           no-error .
      692         if not available buf_shift-obj
      693         or buf_shift-obj.status_ <> 'зкр':U
      694         then do:
      695           find last buf_shift-obj
      696             where buf_shift-obj.obj-type = p-obj-type
      697               and buf_shift-obj.obj-code = p-obj-code
      698               and buf_shift-obj.status_  = 'зкр':U
      699             use-index stts
      700             no-error .
      701           if available buf_shift-obj
      702           then do:
      703             assign
      704               v-extra-message =
      705                     substitute("Дата начала последеней закрытой смены на объекте &1"
      706                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      707                               )
      708             .
      709           end.
      710           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      711           undo, return error v-error .
      712         end.
      713       end.
      714     end.
      715   end procedure.
      716   procedure factord-end-day :
      717     define input  parameter p-fact-date            as date    no-undo .
      718     define output parameter p-day-end-fact-order   as decimal no-undo .
      719     do
      720     on error undo, return error return-value
      721     :
      722       if p-fact-date = ?
      723       then do:
      724         return error "Не указана фактическая дата" .
      725       end.
      726       assign
      727         p-day-end-fact-order = integer(p-fact-date) + 0.99
      728       .
      729     end.
      730   end procedure.
      731   procedure factord-to-date :
      732     define input  parameter p-fact-order as decimal no-undo .
      733     define output parameter p-fact-date  as date    no-undo .
      734     define variable v-ref-date  as date      no-undo .
      735     define variable v-ref-delta as integer   no-undo .
      736     do
      737     on error undo, return error return-value
      738     :
      739       if p-fact-order = ?
      740       or p-fact-order = 0
      741       then do:
      742         return error "Не указан fact-order" .
      743       end.
      744       assign
      745         v-ref-date  = date(1, 1, 2000)
      746       .
      747       assign
      748         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      749       .
      750       assign
      751         p-fact-date = v-ref-date + v-ref-delta
      752       .
      753     end.
      754   end procedure.
      755   procedure factord-to-fact-num :
      756     define input  parameter p-fact-order as decimal no-undo .
      757     define output parameter p-fact-num   as integer no-undo .
      758     define variable v-fact-order-trunc as decimal no-undo .
      759     do
      760     on error undo, return error return-value
      761     :
      762       if p-fact-order = ?
      763       or p-fact-order = 0
      764       then do:
      765         return error "Не указан fact-order" .
      766       end.
      767       assign
      768        v-fact-order-trunc = truncate(p-fact-order, 2)
      769       .
      770       assign
      771         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      772       .
      773     end.
      774   end procedure.
      775   procedure factord-to-shift-num :
      776     define input  parameter p-fact-order as decimal no-undo .
      777     define output parameter p-shift-num   as integer no-undo .
      778     define variable  p-shift-numd  as decimal   no-undo .
      779     define variable v-fact-order-trunc as decimal no-undo .
      780     do
      781     on error undo, return error return-value
      782     :
      783       if p-fact-order = ?
      784       or p-fact-order = 0
      785       then do:
      786         return error "Не указан fact-order" .
      787       end.
      788       assign
      789        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      790       .
      791       if v-fact-order-trunc < 0.5 then do:
      792         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      793       end.
      794       assign
      795         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      796         .
      797        assign
      798         p-shift-num = truncate (p-shift-numd , 0)
      799       .
      800     end.
      801   end procedure.
      802   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      803   define variable v-waitfram-action01         as character   no-undo .
      804   define variable v-waitfram-action02         as character   no-undo .
      805   define variable v-waitfram-action03         as character   no-undo .
      806   define variable mWaitFramTextBeg            as character   no-undo.
      807   define variable mWaitFramTextEnd            as character   no-undo.
      808   define variable mWaitFramView               as logical     no-undo.
      809   define variable mWaitProcEvent              as logical     no-undo init yes.
      810   define variable mWaitFramInterval           as integer     no-undo init 1 .
      811   define variable mWaitFramStop               as logical     no-undo.
      812   define variable mWaitFramStopUser           as logical     no-undo.
      813   define variable mWaitFramStopTimeOut        as logical     no-undo.
      814   define variable mWaitFramStartProc          as datetime-tz no-undo.
      815   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      816   define button B-WaitFramStop auto-end-key
      817        label "Стоп"
      818        size 10 by 1 tooltip "Остоновить процесс".
      819   define button B-viewProcInfo
      820        label "Информация"
      821        size 15 by 1 tooltip "Информация о процесс".
      822   define frame waitfram
      823     v-waitfram-action01 format "x(72)" no-label skip
      824     v-waitfram-action02 format "x(72)" no-label skip
      825     v-waitfram-action03 format "x(72)" no-label skip
      826     B-viewProcInfo
      827     B-WaitFramStop at row 4 col 30
      828     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      829     .
      830   define new global shared variable mBatchMode as logical no-undo init ?.
      831   define variable mFramBachModHandle as handle no-undo.
      832   mFramBachModHandle = frame waitfram:handle.
      833   define variable mFameOldVis as logical no-undo.
      834   define variable mVisCUrentVin as logical no-undo.
      835   if session:batch-mode
      836   then
      837      mBatchMode = yes.
      838   if mBatchMode = ? then do:
      839     mVisCUrentVin = current-window:visible.
      840     mFameOldVis = mFramBachModHandle:visible.
      841     mFramBachModHandle:visible  = yes.
      842     mBatchMode = mFramBachModHandle:visible ne yes.
      843     mFramBachModHandle:visible = mFameOldVis.
      844     current-window:visible = mVisCUrentVin.
      845   end.
      846    if  log-manager:logfile-name ne ?
      847     then DO:
      848         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      849         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      850         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      851     end.
      852   on choose of B-WaitFramStop in frame waitfram
      853   do:
      854     mWaitFramStop = yes.
      855     mWaitFramStopUser = yes.
      856   end.
      857   function waitfram-check-timeout returns logical():
      858      define variable vtime as int64 no-undo.
      859      if mWaitFramStopTimeOut
      860      then
      861         return yes.
      862      vtime = ( now - mWaitFramStartProc ) / 1000 .
      863      if     mWaitFramTimeOut ne ?
      864         and mWaitFramTimeOut ne 0
      865         and mWaitFramTimeOut lt vtime
      866      then do:
      867         mWaitFramStopTimeOut = yes.
      868      end.
      869      return mWaitFramStopTimeOut.
      870   end.
      871   procedure waitfram-hide :
      872     if not session:batch-mode
      873     then do
      874     on error undo, return error return-value
      875     :
      876       pause 0 before-hide .
      877       if not mBatchMode then
      878         hide frame waitfram .
      879     if     not mWaitFramView
      880        and mWaitProcEvent
      881     then
      882       process events .
      883     end.
      884   end procedure.
      885   procedure waitfram-show :
      886     define input  parameter p-message as character no-undo .
      887     define variable v-left-margin as integer   no-undo .
      888     if not session:batch-mode
      889     then do
      890     on error undo, return error return-value
      891     :
      892       if length(p-message) <= 70 then do:
      893         assign
      894           v-left-margin = integer((70 - length(p-message)) / 2)
      895         .
      896         assign
      897           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      898         .
      899         assign
      900           v-waitfram-action01 = " "
      901           v-waitfram-action02 = " "
      902                                    + fill(" ", v-left-margin)
      903                                    + p-message
      904           v-waitfram-action03 = " "
      905         .
      906       end.
      907       else do:
      908         define variable vRindex1 as integer no-undo.
      909         define variable vRindex2 as integer no-undo.
      910         vRindex1 = r-index(p-message," ",70).
      911         if vRindex1 = 0
      912         then
      913            vRindex1 = 70.
      914         if length(p-message)  <= vRindex1 + 70 then do:
      915           assign
      916             v-waitfram-action01 = " "
      917             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      918             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      919           .
      920         end.
      921         else do:
      922           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      923           if vRindex2 <= vRindex1
      924           then
      925              vRindex2 = vRindex1 + 70.
      926           assign
      927             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      928             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      929             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      930           .
      931         end.
      932       end.
      933       B-viewProcInfo:visible   in frame waitfram = no.
      934       B-viewProcInfo:sensitive in frame waitfram = no.
      935       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      936       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      937       if  (   mWaitFramView
      938          or  mWaitProcEvent)
      939          and not mBatchMode
      940       then
      941          display
      942             v-waitfram-action01 skip
      943             v-waitfram-action02 skip
      944             v-waitfram-action03 skip
      945          with frame waitfram .
      946       if     mWaitFramView
      947          then do:
      948             if     mWaitFramInterval ne ?
      949                and not mBatchMode
      950             then
      951                wait-for go of frame waitfram pause mWaitFramInterval.
      952          end.
      953          else
      954             if     mWaitProcEvent
      955                and not mBatchMode
      956             then
      957                process events .
      958     end.
      959   end procedure.
      960      procedure waitfram-show-this:
      961         define input  parameter iInterval as int64 no-undo.
      962         define variable vtime as int64 no-undo.
      963         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      964         mWaitFramInterval = iInterval.
      965         run waitfram-show (substitute("&1&2 &3&4" ,
      966                                       mWaitFramTextBeg ,
      967                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      968                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      969                                       mWaitFramTextEnd
      970                                      )
      971                           ).
      972      end.
      973      procedure WaitFramRunPause:
      974         define input  parameter iInterval as dec no-undo.
      975         define variable vStart  as datetime-tz no-undo.
      976         define variable vend    as datetime-tz no-undo.
      977         define variable vint as int64 no-undo.
      978         define variable vOk as logical no-undo.
      979         vStart = now.
      980         vend   = vStart.
      981         publish "WaitFramPause" (iInterval,output vOk).
      982         vend   =  now.
      983         vint = vend - vStart.
      984         vint = iInterval - vint / 1000.
      985         if     not mWaitFramStop
      986            and (   vint > 0
      987                 or (    not vOk
      988                     and iInterval eq ?
      989                     )
      990                 )
      991         then
      992            run waitfram-show-this (iInterval).
      993         vend   =  now.
      994         vint = vend - vStart.
      995         vint = iInterval - vint / 1000.
      996         if     not mWaitFramStop
      997            and vint > 0
      998         then do:
      999            run gbl/pause.p (vint * 1000).
     1000         end.
     1001         if iInterval ne ?
     1002         then
     1003            publish "WaitFramStop".
     1004         waitfram-check-timeout().
     1005      end.
     1006      procedure WaitFramWaitFor:
     1007         define input  parameter iInterval as dec no-undo.
     1008         assign
     1009            mWaitFramStartProc   = now
     1010            mWaitFramStopUser    = no
     1011            mWaitFramStopTimeOut = no
     1012         .
     1013         block-wait:
     1014         do while not mWaitFramStop:
     1015            run WaitFramRunPause (iInterval).
     1016            if  waitfram-check-timeout()
     1017            then do:
     1018               leave block-wait.
     1019            end.
     1020         end.
     1021         run waitfram-hide.
     1022      end.
     1023   procedure waitfram-join :
     1024     define input  parameter p-line-1  as character no-undo .
     1025     define input  parameter p-line-2  as character no-undo .
     1026     define input  parameter p-line-3  as character no-undo .
     1027     define output parameter p-message as character no-undo .
     1028     do
     1029     on error undo, return error return-value
     1030     :
     1031       assign
     1032         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1033                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1034                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1035       .
     1036     end.
     1037   end procedure.
     1038   function waitfram-join-function returns character
     1039     (input p-line-1 as character
     1040     ,input p-line-2 as character
     1041     ,input p-line-3 as character
     1042     ).
     1043     define variable v-message as character no-undo .
     1044     run waitfram-join in this-procedure
     1045       (input  p-line-1
     1046       ,input  p-line-2
     1047       ,input  p-line-3
     1048       ,output v-message
     1049       ) .
     1050     return v-message .
     1051   end function .
     1052   define input parameter parparentproc as   handle              no-undo.
     1053   define input parameter parobj-type   like ub.clients.obj-type no-undo.
     1054   define input parameter parobj-code   like ub.clients.obj-code no-undo.
     1055   define input parameter parfile-cli   as   character           no-undo.
     1056   define input parameter parfile-doc   as   character           no-undo.
     1057   define input parameter parstatus     as   integer             no-undo.
     1058   define input parameter paragnt       as   integer             no-undo.
     1059   define input parameter parboss       as   integer             no-undo.
     1060   define input parameter parwrkr       as   integer             no-undo.
     1061   define stream str-cli.
     1062   define stream str-cli-log.
     1063   define stream str-err.
     1064   define stream str-doc.
     1065   define stream str-doc-log.
     1066   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1067     run mainmenu_getcntxt in parparentproc
     1068       (output v-cntxt-db-num
     1069       ,output v-cntxt-userid
     1070       ,output v-cntxt-level
     1071       ,output v-cntxt-host-code-obj
     1072       ,output v-cntxt-obj-type
