        1   class utl.gpwdbrw-data2:
        2      define stream sHtml.
        3      define temp-table ttTechProlBrw no-undo
        4         field id        as int64 column-label "Идентификатор"
        5         field fDate     as date  column-label "Дата"
        6         field fTime     as char  column-label "Время"
        7         field fHostName as char  column-label "Имя хоста"
        8         field fUser     as char  column-label "Пользователь"
        9         field fDetails  as char  column-label "Детали"
       10         index fdate fDate ftime
       11         .
       12      define public property hQuery as handle no-undo
       13      get.
       14      set.
       15      method public char GetQueryString(iFilter as class utl.gpwdbrw-filter):
       16         def var vQueryString as char no-undo init "for each b-tech-prol-pwd no-lock ".
       17         def var vWhere    as char   no-undo.
       18         vWhere = iFilter:GetWhere().
       19         if vWhere <> "" then
       20         do:
       21            vQueryString = substitute("&1 where &2", vQueryString, vWhere).
       22         end.
       23         return vQueryString.
       24      end method.
       25      method public void RefreshTT(iFilter as class utl.gpwdbrw-filter):
       26         def buffer b-tech-prol-pwd for tech-prol-pwd.
       27         def var vShop        as char   no-undo.
       28         def var vCashDesk    as char   no-undo.
       29         def var vWhere       as char   no-undo.
       30         def var hQuery-tt    as handle no-undo.
       31         def var vQueryString as char   no-undo.
       32         empty temp-table ttTechProlBrw.
       33         create query hQuery-tt.
       34         hQuery-tt:set-buffers(buffer b-tech-prol-pwd:handle).
       35         vQueryString = GetQueryString(iFilter).
       36         hQuery-tt:query-prepare(vQueryString).
       37         hQuery-tt:query-open.
       38         hQuery-tt:get-first().
       39         do while not hQuery-tt:query-off-end:
       40            define variable vregion as character no-undo.
       41            if num-entries  (b-tech-prol-pwd.shop-surr,chr(4))  eq 2
       42            then assign
       43               vregion = entry(1,b-tech-prol-pwd.shop-surr,chr(4))
       44               vShop = entry(2,b-tech-prol-pwd.shop-surr,chr(4))
       45               .
       46            else
       47               vShop = b-tech-prol-pwd.shop-surr.
       48            vCashDesk = b-tech-prol-pwd.cash-desk-surr.
       49            create ttTechProlBrw.
       50            assign
       51               ttTechProlBrw.id = b-tech-prol-pwd.id
       52               ttTechProlBrw.fDate = date(b-tech-prol-pwd.f-time)
       53               ttTechProlBrw.fTime = string(b-tech-prol-pwd.f-time,"99/99/99 HH:MM:SS")
       54               ttTechProlBrw.fTime = substring(ttTechProlBrw.fTime,10)
       55               ttTechProlBrw.fHostName = b-tech-prol-pwd.f-hostname
       56               ttTechProlBrw.fDetails = substitute(
       57                  "Регион &7 (&8) маг &1, касса &2, &3, &4 - &5, &6",
       58                  vShop,
       59                  vCashDesk,
       60                  b-tech-prol-pwd.f-date,
       61                  b-tech-prol-pwd.f-beg-time,
       62                  b-tech-prol-pwd.f-end-time,
       63                  b-tech-prol-pwd.f-fio,
       64                  vregion,
       65                  GetRegName(vregion))
       66            .
       67            if b-tech-prol-pwd.f-user <> "" then
       68            do:
       69               ttTechProlBrw.fUser = substitute("&1: &2",
       70                                                b-tech-prol-pwd.f-user,
       71                                                this-object:GetUserLogin(b-tech-prol-pwd.f-user)).
       72            end.
       73            hQuery-tt:get-next().
       74         end.
       75         hQuery-tt:query-close().
       76         finally:
       77            delete object hQuery-tt.
       78         end finally.
       79      end method.
       80      method public char GetRegName(reg as char):
       81         def buffer code for ub.code.
       82         define variable vParent as character no-undo.
       83         define variable vCode   as character no-undo.
       84         vParent = "cashobj".
       85         vCode   = reg.
       86         find first code where Code.parent eq vParent
       87                           and Code.code   eq vcode
       88         no-lock no-error.
       89         if avail code then
       90         do:
       91            return Code.CodeName
       92            .
       93         end.
       94         return "".
       95      end.
       96      method public char GetUserLogin(iUser as char):
       97         def var vUserLogin as char no-undo.
       98         def buffer buf_user-account for ub.user-account.
       99         for first buf_user-account where
      100                   buf_user-account.user-id = iUser
      101         no-lock:
      102            assign
      103               vUserLogin = substitute('&1 &2 &3':U
      104                                       ,buf_user-account.last-name
      105                                       ,buf_user-account.first-name
      106                                       ,buf_user-account.second-name
      107                                       )
      108            .
      109         end.
      110         return vUserLogin.
      111      end method.
      112      method public handle GetQuery():
      113         create query hQuery.
      114         hQuery:set-buffers(buffer ttTechProlBrw:handle).
      115         hQuery:query-prepare("FOR EACH ttTechProlBrw").
      116         hQuery:query-open.
      117         return hQuery.
      118      end method.
      119      method public void RefreshQuery(iFilter as class utl.gpwdbrw-filter):
      120         RefreshTT(iFilter).
      121         hQuery:query-close().
      122         hQuery:set-buffers(buffer ttTechProlBrw:handle).
      123         hQuery:query-prepare("FOR EACH ttTechProlBrw").
      124         hQuery:query-open.
      125      end method.
      126      method public void Dispose():
      127         empty temp-table ttTechProlBrw.
      128         if valid-handle(hQuery) then delete object hQuery.
      129      end method.
      130      method public void Report(iFilter as class utl.gpwdbrw-filter):
      131         def var vFullFileName as char  no-undo.
      132         def buffer ttTechProlBrw for ttTechProlBrw.
      133         main:
      134         do on error undo, throw:
      135            vFullFileName = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name() + ".html".
      136            output stream sHtml to value(vFullFileName) convert target 'UTF-8'.
      137            put stream sHtml unformatted
      138               "<!DOCTYPE HTML>" skip
      139               ' <html>' skip
      140               '  <head>' skip
      141               '   <meta charset="utf-8">' skip
      142               '    <style type="text/css">' skip
      143               '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      144               '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      145               '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      146               '   </style>' skip
      147               '  </head>' skip
      148               .
      149            put stream sHtml unformatted
      150               '<body>' skip
      151               '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
      152               '<thead>' skip
      153               .
      154            put stream sHtml unformatted
      155               '<tr>' skip
      156               '<td style="width: 70px;"></td>' skip
      157               '<td style="width: 70px;"></td>' skip
      158               '<td style="width: 250px;"></td>' skip
      159               '<td style="width: 250px;"></td>' skip
      160               '<td style="width: 600px;"></td>' skip
      161               '</tr>' skip
      162               .
      163            put stream sHtml unformatted
      164               '<tr>' skip
      165               '<td colspan="5" style="text-align: center; font-weight: bold; font: 25px arial;">Журнал генерации паролей для проведения технологических проливов </td>' skip
      166               '</tr>' skip
      167               '</thead>' skip .
      168            put stream sHtml unformatted
      169               '<tr>' skip
      170               '<td colspan="5" style="text-align: left; font-weight: bold;">Фильтры: </td>' skip
      171               '</tr>' skip
      172               '</thead>' skip .
      173            if iFilter:AllFiltersDisabled() then
      174            do:
      175               put stream sHtml unformatted
      176                  '<tr>' skip
      177                  '<td colspan="5" style="text-align: left; font-weight: bold;">    все </td>' skip
      178                  '</tr>' skip
      179                  '</thead>' skip .
      180            end.
      181            else
      182            do:
      183               put stream sHtml unformatted
      184                  '<tr>' skip
      185                  '<td colspan="5" style="text-align: left;">Способ объединения фильтров: ' + iFilter:GetModifierName() + '</td>' skip
      186                  '</tr>' skip
      187                  '</thead>' skip.
      188               this-object:PutStream(iFilter:User).
      189               this-object:PutStream(iFilter:HostName).
      190               this-object:PutStream(iFilter:DateGen).
      191               this-object:PutStream(iFilter:DateProl).
      192               this-object:PutStream(iFilter:Fio).
      193               this-object:PutStream(iFilter:ObjectNum).
      194               this-object:PutStream(iFilter:CashNum).
      195            end.
      196            put stream sHtml unformatted
      197               '<tbody>'                                                            skip
      198               '<TR>'                                                               skip
      199               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Дата</TD>'         skip
      200               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Время</TD>'        skip
      201               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Имя хоста</TD>'    skip
      202               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Пользователь</TD>' skip
      203               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">Детали</TD>'       skip
      204               '</TR>'                                                              skip
      205               .
      206            put stream sHtml unformatted
      207               '<tbody>'                                                 skip
      208               '<TR>'                                                    skip
      209               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">1</TD>' skip
      210               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">2</TD>' skip
      211               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">3</TD>' skip
      212               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">4</TD>' skip
      213               '<TD text_wrap="true" style="text-align: center; font-weight: bold; background: DarkSeaGreen;">6</TD>' skip
      214               '</TR>'                                                   skip
      215               .
      216            for each ttTechProlBrw:
      217               put stream sHtml unformatted
      218                  '<TR>' skip
      219                  '<TD text_wrap="true" style="text-align: center;">'  + string(ttTechProlBrw.fDate) + '</TD>' skip
      220                  '<TD text_wrap="true" style="text-align: center;">'  + ttTechProlBrw.fTime + '</TD>' skip
      221                  '<TD text_wrap="true" style="text-align: center;">'  + ttTechProlBrw.fHostName + '</TD>' skip
      222                  '<TD text_wrap="true" style="text-align: center;">'  + ttTechProlBrw.fUser + '</TD>' skip
      223                  '<TD text_wrap="true" style="text-align: left; padding-left: 20px">' + ttTechProlBrw.fDetails + '</TD>' skip
      224                  '</TR>'skip
      225               .
      226            end.
      227            output stream sHtml close.
      228            ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(vFullFileName, "") .
      229         end.
      230      end method.
      231      method public void PutStream(iCondition as class utl.flt-condition):
      232         def var vString as char no-undo.
      233         if iCondition:Enabled then
      234         do:
      235            vString = substitute("&1-&2-&3&4",
      236                                 replace(iCondition:FieldName,":",""),
      237                                 iCondition:Operation,
      238                                 iCondition:Value,
      239                                 if iCondition:FieldType = "между"
      240                                 then ("-" + iCondition:Value1)
      241                                 else "").
      242            put stream sHtml unformatted
      243               '<tr>' skip
      244               '<td colspan="5" style="text-align: left;"> ' + vString + '</td>' skip
      245               '</tr>' skip
      246               '</thead>' skip .
      247         end.
      248      end method.
      249   end class.
