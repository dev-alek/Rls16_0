        1   block-level on error undo, throw.
        2   define input         parameter gen-dir       as character no-undo .
        3   define input-output  parameter gen-file-list as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: gen-tbln.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/gen-tbln.p $":U .
        9   define variable vss-description as character no-undo init "Генерация include-файлов по имени таблицы".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure cur-time :
       70      define output parameter p-today as date      no-undo .
       71      define output parameter p-time  as integer   no-undo .
       72     do
       73     on error undo, return error
       74     :
       75       define variable v-date1 as date      no-undo .
       76       define variable v-date2 as date      no-undo .
       77       define variable v-time  as integer   no-undo .
       78       assign
       79         v-date1 = today
       80         v-time  = time
       81         v-date2 = today
       82       .
       83       if v-date1 <> v-date2
       84       then do:
       85         assign
       86           v-date1 = today
       87           v-time  = v-time
       88         .
       89       end.
       90       assign
       91         p-today = v-date1
       92         p-time  = v-time
       93       .
       94     end.
       95   end.
       96   function cur-time-date returns character
       97   :
       98     return string(today, '99/99/9999':U) .
       99   end.
      100   function cur-time-mjd returns decimal
      101   :
      102     define variable v-date as date      no-undo .
      103     define variable v-time as integer   no-undo .
      104     run cur-time in this-procedure
      105       (output v-date
      106       ,output v-time
      107       ) .
      108     return integer(v-date) - 2400002 + (v-time / 86400) .
      109   end.
      110   function cur-time-get-ending-index returns integer
      111   (input p-number as integer
      112   )
      113   :
      114     if p-number < 0
      115     or p-number = ?
      116     then do:
      117       return 1 .
      118     end.
      119     define variable v-rest as integer   no-undo .
      120     assign
      121       p-number = p-number modulo 100
      122     .
      123     if p-number < 20
      124     then do:
      125       assign
      126         v-rest = p-number
      127       .
      128     end.
      129     else do:
      130       assign
      131         v-rest = p-number modulo 10
      132       .
      133     end.
      134     case v-rest :
      135       when 1
      136       then do:
      137         return 2 .
      138       end.
      139       when 2 or
      140       when 3 or
      141       when 4
      142       then do:
      143         return 3 .
      144       end.
      145       otherwise do:
      146         return 1 .
      147       end.
      148     end case .
      149   end.
      150   procedure cur-time-mjd-to-date :
      151      define input  parameter i-mjd-diff as decimal no-undo.
      152      define output parameter o-Date     as date    no-undo.
      153      define output parameter o-Time     as integer no-undo.
      154      define variable v-day-number as integer   no-undo .
      155      if    i-mjd-diff < 0
      156         or i-mjd-diff = ?
      157      then do:
      158         return "?" .
      159      end.
      160      assign
      161         v-day-number = truncate(i-mjd-diff,0).
      162         o-Date = date(v-day-number + 2400002).
      163         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      164     .
      165   end.
      166   function cur-time-mjd-to-string returns character
      167   (input p-mjd-diff as decimal
      168   )
      169   :
      170     define variable v-day-number as integer   no-undo .
      171     define variable v-seconds    as integer   no-undo .
      172     define variable v-hour       as integer   no-undo .
      173     define variable v-min        as integer   no-undo .
      174     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      175     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      176     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      177     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      178     if p-mjd-diff < 0
      179     or p-mjd-diff = ?
      180     then do:
      181       return "?" .
      182     end.
      183     assign
      184       v-day-number = integer(truncate(p-mjd-diff,0))
      185       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187     if v-seconds > 86400
      188     then do:
      189       assign
      190         v-seconds = 86400 - 1
      191       .
      192     end.
      193     if v-seconds < 0
      194     then do:
      195       assign
      196         v-seconds = 0
      197       .
      198     end.
      199     assign
      200       v-hour = truncate(v-seconds / 3600, 0)
      201     .
      202     assign
      203       v-seconds = v-seconds modulo 3600
      204     .
      205     assign
      206       v-min = truncate(v-seconds / 60, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 60
      210     .
      211     return
      212         (if v-day-number <> 0
      213           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      214           else ""
      215         )
      216       + (if v-day-number <> 0 or v-hour <> 0
      217           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      221           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      222           else ""
      223         )
      224       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      225       .
      226   end.
      227   function cur-time-string returns character
      228   :
      229     define variable v-date as date      no-undo .
      230     define variable v-time as integer   no-undo .
      231     run cur-time in this-procedure
      232       (output v-date
      233       ,output v-time
      234       ) .
      235     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      236   end.
      237   function cur-time-string-sec returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      246   end.
      247   function cur-time-custom  returns character
      248   (input p-prefix as character
      249   ,input p-date-format as character
      250   ,input p-delimiter as character
      251   ,input p-time-format as character
      252   ,input p-suffix as character
      253   )
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return
      262       p-prefix
      263       + string(v-date, p-date-format)
      264       + p-delimiter
      265       + string(v-time, p-time-format)
      266       + p-suffix
      267       .
      268   end.
      269   function cur-time-print  returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-datetime returns datetime
      280   :
      281     define variable v-char as character no-undo .
      282     define variable v-datetime as datetime no-undo .
      283     v-char = cur-time-string().
      284     v-datetime = datetime(v-char).
      285     return  v-datetime.
      286   end.
      287   function cur-time-string-msec returns character
      288   :
      289     define variable v-date as datetime  no-undo .
      290     v-date = now.
      291     return string(v-date) .
      292   end.
      293   define temp-table tt-file no-undo
      294   field pre-prefix as character
      295   field pre-def as character
      296   field file-label as character
      297   field line-num as integer
      298   index pi is unique primary line-num
      299   index imain pre-def.
      300   do
      301   on error undo, return error
      302   :
      303     define variable v-today as date      no-undo.
      304     define variable v-time  as integer   no-undo.
      305     define variable tn      as character no-undo.
      306     define variable tn-f    as character no-undo .
      307     define variable v-line-num as integer no-undo .
      308     define stream NameStream.
      309     define frame ddd
      310       fl as character format "x(14)"  label "Таблица" at row 1.5  col 17 colon-aligned
      311       with view-as dialog-box side-labels three-d
      312       title "Генерация файлов " + program-name(1)
      313     .
      314   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      315   if trim( gen-dir ) = "":U then do:
      316     assign
      317       gen-dir = ".":U
      318     .
      319   end.
      320   assign
      321     file-info:file-name = gen-dir
      322   .
      323   if file-info :full-pathname = ""
      324   or file-info :full-pathname = ?  then do:
      325     message
      326       vss-workfile vss-revision vss-description skip
      327       substitute( "Уазанный каталог (&1) не найден!", gen-dir ) skip
      328       view-as alert-box error .
      329     undo, return error .
      330   end.
      331   assign
      332     gen-dir = file-info:full-pathname + "/":U
      333   .
      334     run gbl/dir-cre.p ( input gen-dir + "cmp":U ) no-error .
      335     if error-status:error then do:
      336       message
      337         vss-workfile vss-revision vss-description skip
      338         substitute( "Ошибка при создании каталога &1", gen-dir + "cmp":U ) skip
      339         error-status :get-message(1) skip
      340         return-value skip
      341         view-as alert-box error .
      342       undo, return error.
      343     end.
      344     view frame ddd.
      345     assign
      346       gen-file-list = gen-file-list + "," + "cmp/tbl-name.i":U
      347     .
      348     output stream NameStream to value( gen-dir + "cmp/tbl-name.i" ).
      349     run cur-time in this-procedure ( output v-today
      350                                     ,output v-time
      351                                    ).
      352     put stream NameStream unformatted
      353       '/*':U + chr(10)
      354       + chr(10)
      355       + '$':U + 'Revision: ':U + '$':U + chr(10)
      356       + '$':U + 'Author: ':U + '$':U + chr(10)
      357       + '$':U + 'Date: ':U + '$':U + chr(10)
      358       + '$':U + 'Workfile: ':U + '$':U + chr(10)
      359       + '$':U + 'Archive: ':U + '$':U + chr(10)
      360       + chr(10)
      361       + "Глобальные определения имен таблиц" + chr(10)
      362       + chr(10)
      363       + 'Автор: Перваков Михаил Сергеевич':U + chr(10)
      364       + 'Дата создания: 04/05/06':U + chr(10)
      365       + 'Author: Mikhail Pervakov':U + chr(10)
      366       + 'Creation date: 04/05/06':U + chr(10)
      367       + chr(10)
      368       + "Файл автоматически создается процедурой " + program-name(1) + chr(10)
      369       + chr(10)
      370       + '*/':U + chr(10)
      371       + chr(10)
      372     .
      373     for each ub._File no-lock
      374       where ub._File._Hidden = false
      375     by ub._File._File-Name
      376     :
      377       assign
      378         tn = ub._file._file-name
      379       .
      380       display
      381         tn @ fl
      382         with frame ddd
      383       .
      384       put stream NameStream unformatted "&glob table_" + tn + " '" + tn + "':U"
      385         + chr(10)
      386         .
      387     end.
      388     put stream NameStream unformatted
      389       chr(47) + chr(42) + ' ':U + chr(36) + 'Workfile: ':U + chr(36) + ' e n d ':U + chr(42) + chr(47) + chr(10)
      390       + chr(10)
      391     .
      392     OUTPUT STREAM NameStream close.
      393     assign
      394       gen-file-list = gen-file-list + "," + "cmp/tblbname.i":U
      395     .
      396     output stream NameStream to value( gen-dir + "cmp/tblbname.i" ).
      397     run cur-time in this-procedure ( output v-today
      398                                     ,output v-time
      399                                    ).
      400     put stream NameStream unformatted
      401       '/*':U + chr(10)
      402       + chr(10)
      403       + '$':U + 'Revision: ':U + '$':U + chr(10)
      404       + '$':U + 'Author: ':U + '$':U + chr(10)
      405       + '$':U + 'Date: ':U + '$':U + chr(10)
      406       + '$':U + 'Workfile: ':U + '$':U + chr(10)
      407       + '$':U + 'Archive: ':U + '$':U + chr(10)
      408       + chr(10)
      409       + "Глобальные определения имен таблиц" + chr(10)
      410       + chr(10)
      411       + 'Автор: Бахтадзе Наталья Викторовна':U + chr(10)
      412       + 'Дата создания: 01/29/07':U + chr(10)
      413       + 'Author: Bakhtadze Natalya':U + chr(10)
      414       + 'Creation date: 01/29/07':U + chr(10)
      415       + chr(10)
      416       + "Файл автоматически создается процедурой " + program-name(1) + chr(10)
      417       + chr(10)
      418       + '*/':U + chr(10)
      419       + chr(10)
      420     .
      421     for each ub._File no-lock
      422       where ub._File._Hidden = false
      423     by ub._File._File-Name
      424     :
      425       assign
      426         tn = ub._file._file-name
      427       .
      428       display
      429         tn @ fl
      430         with frame ddd
      431       .
      432       put stream NameStream unformatted "&glob bef-table_" + tn + " " + tn
      433         + chr(10)
      434         .
      435     end.
      436     put stream NameStream unformatted
      437       chr(47) + chr(42) + ' ':U + chr(36) + 'Workfile: ':U + chr(36) + ' e n d ':U + chr(42) + chr(47) + chr(10)
      438       + chr(10)
      439     .
      440     OUTPUT STREAM NameStream close.
      441     define variable v-path                    as character                no-undo .
      442     DEFINE VARIABLE v-full-path               as character                no-undo .
      443     DEFINE VARIABLE v-file-name               as character                no-undo .
      444     DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      445     DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      446     run gbl/filename.p (
      447                     input 'cmp/tbluname.i'
      448                   ,output v-full-path
      449                   ,output v-path
      450                   ,output v-file-name
      451                   ,output v-file-name-no-ext
      452                   ,output v-file-name-ext
      453                   ) no-error .
      454     if error-status:error then do:
      455       message
      456       return-value
      457       view-as alert-box ERROR.
      458       return.
      459     end.
      460     input stream Namestream from value(v-full-path) .
      461     repeat:
      462       create tt-file.
      463        assign tt-file.line-num = v-line-num + 1
      464        v-line-num = v-line-num + 1.
      465       import stream namestream tt-file except line-num.
      466       assign
      467       tt-file.file-label = trim(tt-file.file-label, chr(39))
      468       tt-file.file-label = trim(tt-file.file-label, chr(34))
      469       tt-file.file-label = trim(tt-file.file-label, chr(39))
      470       .
      471     end.
      472     input stream Namestream close.
      473     assign
      474       gen-file-list = gen-file-list + "," + "cmp/tblfname.i":U
      475     .
      476     output stream NameStream to value( gen-dir + "cmp/tblfname.i" ).
      477     run cur-time in this-procedure ( output v-today
      478                                     ,output v-time
      479                                    ).
      480     put stream NameStream unformatted
      481       '/*':U + chr(10)
      482       + chr(10)
      483       + '$':U + 'Revision: ':U + '$':U + chr(10)
      484       + '$':U + 'Author: ':U + '$':U + chr(10)
      485       + '$':U + 'Date: ':U + '$':U + chr(10)
      486       + '$':U + 'Workfile: ':U + '$':U + chr(10)
      487       + '$':U + 'Archive: ':U + '$':U + chr(10)
      488       + chr(10)
      489       + "Глобальные определения имен таблиц" + chr(10)
      490       + chr(10)
      491       + 'Автор: Бахтадзе Наталья Викторовна':U + chr(10)
      492       + 'Дата создания: 01/29/07':U + chr(10)
      493       + 'Author: Bakhtadze Natalya':U + chr(10)
      494       + 'Creation date: 01/29/07':U + chr(10)
      495       + chr(10)
      496       + "Файл автоматически создается процедурой " + program-name(1) + chr(10)
      497       + chr(10)
      498       + '*/':U + chr(10)
      499       + chr(10)
      500     .
      501     for each ub._File no-lock
      502       where ub._File._Hidden = false
      503     by ub._File._File-Name
      504     :
      505       assign
      506         tn = ub._file._file-name
      507       .
      508       find first tt-file no-lock where
      509             tt-file.pre-prefix = "&glob"
      510         and tt-file.pre-def = ("table_" + tn + "-full") no-error.
      511       if not available tt-file then do:
      512         if ub._file._file-label = ?
      513         or ub._file._file-label = '':U
      514         then do:
      515           assign
      516           tn-f = ub._file._file-name.
      517         end.
      518         else do:
      519           assign
      520           tn-f = ub._file._file-label.
      521         end.
      522       end.
      523       else do:
      524         assign
      525         tn-f = tt-file.file-label.
      526       end.
      527       display
      528         tn @ fl
      529         with frame ddd
      530       .
      531       put stream NameStream unformatted "&glob bef-table_" + tn + "-full " + tn-f
      532         + chr(10)
      533         .
      534       put stream NameStream unformatted "&glob table_" + tn + "-full '~{&bef-table_" + tn + "-full~}':U"
      535         + chr(10)
      536         .
      537     end.
      538     put stream NameStream unformatted
      539       chr(47) + chr(42) + ' ':U + chr(36) + 'Workfile: ':U + chr(36) + ' e n d ':U + chr(42) + chr(47) + chr(10)
      540       + chr(10)
      541     .
      542     OUTPUT STREAM NameStream close.
      543     hide frame ddd no-pause.
      544   end.
      545   RETURN.
