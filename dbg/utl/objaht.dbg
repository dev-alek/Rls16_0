      362   define temp-table userobjs_temp-user-obj no-undo
      363     field obj-type as character
      364     field obj-code as integer
      365     index xpk is primary unique obj-type obj-code
      366     .
      367   procedure userobjs_clear :
      368     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      369     do
      370     on error undo, return error return-value
      371     :
      372       for each buf_userobjs_temp-user-obj
      373       on error undo, return error return-value
      374       :
      375         delete buf_userobjs_temp-user-obj .
      376       end.
      377     end.
      378   end .
      379   procedure userobjs_object-count :
      380     define output parameter p-total-count as integer   no-undo .
      381     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      382     do
      383     on error undo, return error return-value
      384     :
      385       assign
      386         p-total-count = 0
      387       .
      388       for each buf_userobjs_temp-user-obj
      389       on error undo, return error return-value
      390       :
      391         assign
      392           p-total-count = p-total-count + 1
      393         .
      394       end.
      395     end.
      396   end.
      397   procedure userobjs_append :
      398      define input  parameter p-obj-type as character no-undo .
      399      define input  parameter p-obj-code as integer   no-undo .
      400     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      401     do
      402     on error undo, return error return-value
      403     :
      404       find first buf_userobjs_temp-user-obj
      405         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      406           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      407         no-error .
      408       if not available buf_userobjs_temp-user-obj
      409       then do:
      410         create buf_userobjs_temp-user-obj .
      411         assign
      412           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      413           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      414         .
      415       end.
      416     end.
      417   end.
      418   procedure userobjs_object-exist :
      419     define output parameter p-object-exist as logical   no-undo .
      420     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      421     do
      422     on error undo, return error return-value
      423     :
      424       find first buf_userobjs_temp-user-obj
      425         no-error .
      426       if not available buf_userobjs_temp-user-obj
      427       then do:
      428         assign
      429           p-object-exist = false
      430         .
      431       end.
      432       else do:
      433         assign
      434           p-object-exist = true
      435         .
      436       end.
      437     end.
      438   end.
      439   procedure userobjs_transfer :
      440     define input  parameter p-callback-handle as handle no-undo .
      441     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      442     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      443     do
      444     on error undo, return error return-value
      445     :
      446       if valid-handle(p-callback-handle) <> true
      447       then do:
      448         message
      449           vss-workfile vss-revision vss-description skip
      450           "Ошибка задания входных параметров" skip
      451           "Неизвестный указатель на процедуру" skip
      452           view-as alert-box error .
      453         undo, return error return-value .
      454       end.
      455       if p-callback-handle :get-signature("userobjs_append") = ""
      456       then do:
      457         message
      458           vss-workfile vss-revision vss-description skip
      459           "Ошибка задания входных параметров" skip
      460           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      461                     ,p-callback-handle :file-name
      462                     ) skip
      463           view-as alert-box error .
      464         undo, return error return-value .
      465       end.
      466       for each buf_userobjs_temp-user-obj
      467       on error undo, return error return-value
      468       :
      469         run userobjs_append in p-callback-handle
      470           (input  buf_userobjs_temp-user-obj.obj-type
      471           ,input  buf_userobjs_temp-user-obj.obj-code
      472           ) .
      473       end.
      474     end.
      475   end procedure.
      476   procedure userobjs_select-one :
      477      define input  parameter parparentproc     as widget-handle no-undo .
