      549   end.
      550   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   procedure factord :
      552     define input  parameter p-fact-date            as date    no-undo .
      553     define input  parameter p-fact-time            as integer no-undo .
      554     define input  parameter p-fact-num             as integer no-undo .
      555     define input  parameter p-shift-date           as date    no-undo .
      556     define input  parameter p-shift-num            as integer no-undo .
      557     define input  parameter p-shift-on             as logical no-undo .
      558     define output parameter p-fact-order           as decimal no-undo .
      559     define output parameter p-shift-end-fact-order as decimal no-undo .
      560     define output parameter p-day-end-fact-order   as decimal no-undo .
      561     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      562     if p-fact-date = ?
      563     then do:
      564       return error "Не указана фактическая дата" .
      565     end.
      566     define variable v-fact-date-num as integer no-undo .
      567     assign
      568       v-fact-date-num = integer(p-fact-date)
      569     .
      570     if p-fact-num = ?
      571     or p-fact-num = 0
      572     then do:
      573       return error "Не задан p-fact-num " + string(p-fact-num) .
      574     end.
      575     if p-fact-num < 0
      576     then do:
      577       return error "Отрицательный fact-num " + string(p-fact-num) .
      578     end.
      579     if p-fact-num >= 100000000
      580     then do:
      581       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      582     end.
      583     if p-shift-on = true
      584     then do:
      585       if p-shift-date = ?
      586       then do:
      587         return error "Не задана дата смены" .
      588       end.
      589       if p-shift-num = ?
      590       or p-shift-num = 0
      591       then do:
      592         return error "Не задан номер смены" .
      593       end.
      594     end.
      595     else do:
      596       assign
      597         p-shift-date = p-fact-date
      598         p-shift-num  = 24
      599       .
      600     end.
      601     define variable v-shift-offset as integer no-undo .
      602     if p-shift-date = p-fact-date
      603     then do:
      604       assign
      605         v-shift-offset = 1
      606       .
      607     end.
      608     if p-shift-date < p-fact-date
      609     then do:
      610       assign
      611         v-shift-offset = 0
      612       .
      613     end.
      614     if p-shift-date > p-fact-date
      615     then do:
      616       message
      617         vss-workfile vss-revision vss-description skip
      618         "Неправильная дата закрытия смены" skip
      619         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      620         view-as alert-box error .
      621       undo, return error
      622         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      623           ,string(p-fact-date, '99/99/9999':U)
      624           ,string(p-shift-date, '99/99/9999':U)
      625           )
      626       .
      627     end.
      628     if p-shift-num < 1
      629     or p-shift-num > 24
      630     then do:
      631       message
      632         vss-workfile vss-revision vss-description skip
      633         "Неправильный номер смены" skip
      634         "p-shift-num" p-shift-num skip
      635         view-as alert-box error .
      636       undo, return error return-value .
      637     end.
      638     assign
      639       p-fact-order           = v-fact-date-num
      640                              + v-shift-offset * 0.5
      641                              + p-shift-num    * 0.02 - 0.01
      642                              + p-fact-num     * 0.0000000001
      643       p-shift-end-fact-order = v-fact-date-num
      644                              + v-shift-offset * 0.5
      645                              + p-shift-num    * 0.02
      646       p-day-end-fact-order   = v-fact-date-num
      647                              + 0.99
      648     .
      649     if p-fact-order           <= v-fact-date-num
      650     or p-shift-end-fact-order <= v-fact-date-num
      651     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      652     or p-shift-end-fact-order >= p-day-end-fact-order
      653     then do:
      654       message
      655         vss-workfile vss-revision vss-description skip
      656         "Внутренняя ошибка при генерации фактического номера" skip
      657         "p-fact-date"            p-fact-date            skip
      658         "p-fact-time"            p-fact-time            skip
      659         "p-fact-num"             p-fact-num             skip
      660         "p-shift-date"           p-shift-date           skip
      661         "p-shift-num"            p-shift-num            skip
      662         "p-shift-on"             p-shift-on             skip
      663         "p-shift-end-fact-order" p-shift-end-fact-order skip
      664         "p-day-end-fact-order"   p-day-end-fact-order   skip
      665         "v-fact-date-num"        v-fact-date-num        skip
      666         view-as alert-box error .
      667       undo, return error return-value .
      668     end.
      669   end procedure.
      670   procedure day-begin-fact-order :
      671     define input  parameter p-fact-date            as date    no-undo .
      672     define output parameter p-day-begin-fact-order as decimal no-undo .
      673     do
      674     on error undo, return error return-value
      675     :
      676       if p-fact-date = ?
      677       then do:
      678         assign
      679           p-day-begin-fact-order = 0
      680         .
      681       end.
      682       else do:
      683         assign
      684           p-day-begin-fact-order = integer(p-fact-date)
      685         .
      686       end.
      687     end.
      688   end procedure.
      689   procedure factord-max-fact-order :
      690     define output parameter p-max-fact-order as decimal   no-undo .
      691     do
      692     on error undo, return error return-value
      693     :
      694       run day-begin-fact-order in this-procedure
      695         (input  date(1, 1, 5000)
      696         ,output p-max-fact-order
      697         ) .
      698     end.
      699   end procedure.
      700   procedure factord-cut-archive :
      701     define input  parameter p-obj-type             as character no-undo .
      702     define input  parameter p-obj-code             as integer   no-undo .
      703     define input  parameter p-fact-date            as date      no-undo .
      704     define output parameter p-shift-on             as logical   no-undo .
      705     define output parameter p-shift-date           as date      no-undo .
      706     define output parameter p-shift-num            as integer   no-undo .
      707     define output parameter p-day-end-fact-order   as decimal   no-undo .
      708     define output parameter p-shift-end-fact-order as decimal   no-undo .
      709     define variable v-fact-order as decimal   no-undo .
      710     define buffer buf_shift-obj for ub.shift-obj .
      711     do
      712     on error undo, return error return-value
      713     :
      714   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      716     (input  p-obj-type
      717     ,input  p-obj-code
      718     ,input  'shift-on=request'
      719     ,output p-shift-on
      720     ) no-error .
      721       if error-status :error
      722       then do:
      723         message
      724           vss-workfile vss-revision vss-description skip
      725           "Ошибка при определении атрибута объекта" skip
      726           "Объект" p-obj-type p-obj-code skip
      727           error-status :get-message(1) skip
      728           return-value skip
      729           view-as alert-box error .
      730         undo, return error return-value .
      731       end.
      732       if p-shift-on = false
      733       then do:
      734         assign
      735           p-shift-date               = ?
      736           p-shift-num                = 0
      737         .
      738       end.
      739       else do:
      740         find first buf_shift-obj share-lock
      741           where buf_shift-obj.obj-type   = p-obj-type
      742             and buf_shift-obj.obj-code   = p-obj-code
      743             and buf_shift-obj.shift-date > p-fact-date
      744           use-index pi
      745           no-error .
      746         if not available buf_shift-obj
      747         or buf_shift-obj.status_ <> 'зкр':U
      748         then do:
      749           message
      750             vss-workfile vss-revision vss-description skip
      751             "Невозможно вычислить последнюю смену" skip
      752             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      753             "Объект" p-obj-type p-obj-code skip
      754             "Дата" p-fact-date skip
      755             view-as alert-box error .
      756           undo, return error return-value .
      757         end.
      758         find last buf_shift-obj share-lock
      759           where buf_shift-obj.obj-type = p-obj-type
      760             and buf_shift-obj.obj-code = p-obj-code
      761             and buf_shift-obj.shift-date <= p-fact-date
      762           use-index pi
      763           no-error .
      764         if available buf_shift-obj
      765         then do:
      766           if  buf_shift-obj.status_ = 'зкр':U
      767           then do:
      768             assign
      769               p-shift-date = buf_shift-obj.shift-date
      770               p-shift-num  = buf_shift-obj.shift-num
      771             .
      772           end.
      773           else do:
      774             message
      775               vss-workfile vss-revision vss-description skip
      776               "Невозможно вычислить последнюю смену" skip
      777               "Статус смены отличен от статуса" 'зкр':U skip
      778               "Объект" p-obj-type p-obj-code skip
      779               "Дата" p-fact-date skip
      780               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      781               view-as alert-box error .
      782             undo, return error return-value .
      783           end.
      784         end.
      785         else do:
      786           assign
      787             p-shift-date = p-fact-date - 1
      788             p-shift-num  = 1
      789           .
      790         end.
      791       end.
      792       run factord in this-procedure
      793         (input  p-fact-date
      794         ,input  1
      795         ,input  1
      796         ,input  p-shift-date
      797         ,input  p-shift-num
      798         ,input  p-shift-on
      799         ,output v-fact-order
      800         ,output p-shift-end-fact-order
      801         ,output p-day-end-fact-order
      802         ) no-error .
      803       if error-status :error
      804       then do:
      805         message
      806           vss-workfile vss-revision vss-description skip
      807           "Ошибка при вызове процедуры factord"
      808           error-status :get-message(1) skip
      809           return-value skip
      810           view-as alert-box error .
      811         undo, return error return-value .
      812       end.
      813     end.
      814   end procedure.
      815   procedure factord-lock-shift :
      816     define input  parameter p-obj-type  as character no-undo .
      817     define input  parameter p-obj-code  as integer   no-undo .
      818     define input  parameter p-fact-date as date      no-undo .
      819     define parameter buffer buf_shift-obj for ub.shift-obj .
      820     define variable v-shift-on      as logical   no-undo .
      821     define variable v-extra-message as character no-undo .
      822     define variable v-error as character no-undo .
      823     do
      824     on error undo, return error return-value
      825     :
      826   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      827   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      828     (input  p-obj-type
      829     ,input  p-obj-code
      830     ,input  'shift-on=request'
      831     ,output v-shift-on
      832     ) no-error .
      833       if error-status :error
      834       then do:
      835         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      836         undo, return error v-error .
      837       end.
      838       if v-shift-on = true
      839       then do:
      840         find first buf_shift-obj share-lock
      841           where buf_shift-obj.obj-type   = p-obj-type
      842             and buf_shift-obj.obj-code   = p-obj-code
      843             and buf_shift-obj.shift-date > p-fact-date
      844           use-index pi
      845           no-error .
      846         if not available buf_shift-obj
      847         or buf_shift-obj.status_ <> 'зкр':U
      848         then do:
      849           find last buf_shift-obj
      850             where buf_shift-obj.obj-type = p-obj-type
      851               and buf_shift-obj.obj-code = p-obj-code
      852               and buf_shift-obj.status_  = 'зкр':U
      853             use-index stts
      854             no-error .
      855           if available buf_shift-obj
      856           then do:
      857             assign
      858               v-extra-message =
      859                     substitute("Дата начала последеней закрытой смены на объекте &1"
      860                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      861                               )
      862             .
      863           end.
      864           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      865           undo, return error v-error .
      866         end.
      867       end.
      868     end.
      869   end procedure.
      870   procedure factord-end-day :
      871     define input  parameter p-fact-date            as date    no-undo .
      872     define output parameter p-day-end-fact-order   as decimal no-undo .
      873     do
      874     on error undo, return error return-value
      875     :
      876       if p-fact-date = ?
      877       then do:
      878         return error "Не указана фактическая дата" .
      879       end.
      880       assign
      881         p-day-end-fact-order = integer(p-fact-date) + 0.99
      882       .
      883     end.
      884   end procedure.
      885   procedure factord-to-date :
      886     define input  parameter p-fact-order as decimal no-undo .
      887     define output parameter p-fact-date  as date    no-undo .
      888     define variable v-ref-date  as date      no-undo .
      889     define variable v-ref-delta as integer   no-undo .
      890     do
      891     on error undo, return error return-value
      892     :
      893       if p-fact-order = ?
      894       or p-fact-order = 0
      895       then do:
      896         return error "Не указан fact-order" .
      897       end.
      898       assign
      899         v-ref-date  = date(1, 1, 2000)
      900       .
      901       assign
      902         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      903       .
      904       assign
      905         p-fact-date = v-ref-date + v-ref-delta
      906       .
      907     end.
      908   end procedure.
      909   procedure factord-to-fact-num :
      910     define input  parameter p-fact-order as decimal no-undo .
      911     define output parameter p-fact-num   as integer no-undo .
      912     define variable v-fact-order-trunc as decimal no-undo .
      913     do
      914     on error undo, return error return-value
      915     :
      916       if p-fact-order = ?
      917       or p-fact-order = 0
      918       then do:
      919         return error "Не указан fact-order" .
      920       end.
      921       assign
      922        v-fact-order-trunc = truncate(p-fact-order, 2)
      923       .
      924       assign
      925         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      926       .
      927     end.
      928   end procedure.
      929   procedure factord-to-shift-num :
      930     define input  parameter p-fact-order as decimal no-undo .
      931     define output parameter p-shift-num   as integer no-undo .
      932     define variable  p-shift-numd  as decimal   no-undo .
      933     define variable v-fact-order-trunc as decimal no-undo .
      934     do
      935     on error undo, return error return-value
      936     :
      937       if p-fact-order = ?
      938       or p-fact-order = 0
      939       then do:
      940         return error "Не указан fact-order" .
      941       end.
      942       assign
      943        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      944       .
      945       if v-fact-order-trunc < 0.5 then do:
      946         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      947       end.
      948       assign
      949         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      950         .
      951        assign
      952         p-shift-num = truncate (p-shift-numd , 0)
      953       .
      954     end.
      955   end procedure.
      956   define buffer buf_db                     for ub.db .
      957   define buffer buf_clients                for ub.clients .
      958   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      959   define variable v-str-obj as character no-undo .
      960   do
      961   on error undo, return error
      962   :
      963     define variable v-num as integer no-undo .
      964   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      965     run mainmenu_getcntxt in parparentproc
      966       (output v-cntxt-db-num
      967       ,output v-cntxt-userid
      968       ,output v-cntxt-level
      969       ,output v-cntxt-host-code-obj
      970       ,output v-cntxt-obj-type
      971       ,output v-cntxt-obj-code
      972       ,output v-cntxt-db-num-obj
      973       ,output v-cntxt-is-admin
      974       ) .
      975     if p-install <> true
      976     then do:
      977       define variable v-ok                 as logical   no-undo .
      978       define variable v-recalc-date        as date      no-undo .
      979       define variable v-recalc-date-string as character no-undo .
      980       message
      981         "Задать единую дату перерасчета для выбранных объектов?" skip
      982         view-as alert-box question buttons yes-no update v-ok .
      983       assign
      984         v-recalc-date = ?
      985       .
      986       if v-ok = true
      987       then do:
      988         run gbl/d-prompt.w
      989           ( 'title=':u + "Введите дату" + '\':u
      990           + 'text1=':u + "Введите дату, начиная с которой надо перерассчитать" + '\':u
      991           + 'text2=':u + "складской архив по типам приобретения" + '\':u
      992           + 'type=date\':u
      993           ,input-output v-recalc-date-string
      994           ).
      995         if return-value = 'false':u
      996         then do:
      997           undo, return error .
      998         end.
      999         assign
     1000           v-recalc-date = date(v-recalc-date-string)
     1001         .
     1002         if v-recalc-date = ?
     1003         then do:
     1004           message
     1005             "Неправильна задана дата" v-recalc-date-string skip
     1006             view-as alert-box error .
     1007           undo, return error .
     1008         end.
     1009         assign
     1010           v-ok = true
     1011         .
     1012         message
     1013           "Перерассчитать объекты с даты" v-recalc-date "?" skip
     1014           "Вы должны быть уверены, что для всех объектов, которые вы затем выберете" skip
     1015           "складской архив по типам приобретения должен быть рассчитан до указанной даты включительно" skip
     1016           "или за более позднюю дату." skip
     1017           "Продолжить?" skip
     1018           view-as alert-box question buttons yes-no update v-ok .
     1019         if v-ok <> true
     1020         then do:
     1021           undo, return error .
     1022         end.
     1023       end.
     1024     end.
     1025     if p-install = true
     1026     then do:
     1027       assign
     1028         v-num = 1
     1029       .
     1030     end.
     1031     else do:
     1032       run gbl/d-askw.w
     1033         (input "Вопрос"
     1034         ,input "Рассчитать складской архив по типам приобретения" + chr(10)
     1035         + "На сменных объектах смена должна быть открыта, иначе эти объекты не будут обработаны"
     1036         ,input "|^"
     1037         ,input "Все объекты^confirm|Выбрать объекты|Отмена"
     1038         ,input "|"
     1039             + "|"
     1040             + ""
     1041         ,input 1
     1042         ,input 3
     1043         ,output v-num
     1044         ).
     1045     end.
     1046     case v-num :
     1047       when 1
     1048       then do:
     1049         define variable v-db-num as integer   no-undo .
     1050   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1051   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1052     (output v-db-num
     1053     )  .
     1054         for each buf_db no-lock
     1055           where v-db-num = 0
     1056              or (v-db-num <> 0
     1057                  and buf_db.db-num = v-db-num
     1058                 )
     1059         on error undo, return error
     1060         :
     1061           for each buf_clients no-lock
     1062             where buf_clients.db-num = buf_db.db-num
     1063           on error undo, return error
     1064           :
     1065             define buffer lock_shift-obj for ub.shift-obj .
     1066             run factord-lock-shift in this-procedure
     1067               (input  buf_clients.obj-type
     1068               ,input  buf_clients.obj-code
     1069               ,input  0
     1070               ,buffer lock_shift-obj
     1071               ) no-error .
     1072             if error-status :error  then do:
     1073               next.
     1074             end.
     1075             define variable v-attr-aht-del-chr  as character no-undo .
     1076             define variable v-attr-aht-del-type as character no-undo .
     1077             define variable v-attr-aht-del      as logical   no-undo .
     1078             run clntattr-value in this-procedure
     1079               (input  buf_clients.obj-type
     1080               ,input  buf_clients.obj-code
     1081               ,input  'aht-del':U
     1082               ,output v-attr-aht-del-chr
     1083               ,output v-attr-aht-del-type
     1084               ).
     1085             assign
     1086               v-attr-aht-del = lookup(v-attr-aht-del-chr, 'yes,true':u) > 0
     1087             .
     1088             if  v-attr-aht-del <> true
     1089             and buf_clients.stts = 0
     1090             then do:
     1091               run trg/calcaht.p
     1092                 (input buf_clients.obj-type
     1093                 ,input buf_clients.obj-code
     1094                 ,input false
     1095                 ,input false
     1096                 ,input v-recalc-date
     1097                 ,input true
     1098                 ,input v-cntxt-db-num
     1099                 ,input v-cntxt-userid
     1100                 ) no-error .
     1101               if error-status :error
     1102               then do:
     1103                 message
     1104                   vss-workfile vss-revision vss-description skip
     1105                   "Ошибка при расчете складского архива по типам приобретения" skip
     1106                   "Объект" buf_clients.obj-type buf_clients.obj-code skip
     1107                   "Информацию о рассчитанных объектах можно посмотреть в файле"
     1108                   "objaht.log" skip
     1109                   "или в АРМ Администратор" skip
     1110                   "Утилиты/Работа с архивами/Информация о складских архивах" skip
     1111                   error-status :get-message(1) skip
     1112                   return-value skip
     1113                   view-as alert-box error .
     1114                 undo, return error .
     1115               end.
     1116             end.
     1117           end.
     1118         end.
     1119       end.
     1120       when 2
     1121       then do:
     1122         define variable v-user-select as logical   no-undo .
     1123   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   run userobjs_select-many in this-procedure
     1125     (input  parparentproc
     1126     ,input  v-cntxt-db-num
     1127     ,input  v-cntxt-userid
     1128     ,input  v-cntxt-host-code-obj
     1129     ,input  v-cntxt-obj-type
     1130     ,input  v-cntxt-obj-code
     1131     ,output v-user-select
     1132     )  .
     1133         if v-user-select <> true
     1134         then do:
     1135           message
     1136             "Объект не выбран"
     1137             view-as alert-box information .
     1138           return .
     1139         end.
     1140         v-str-obj = "".
     1141         for each buf_userobjs_temp-user-obj
     1142         on error undo, return error return-value
     1143         :
     1144           find first buf_clients no-lock
     1145             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     1146               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     1147             .
     1148             define buffer lock2_shift-obj for ub.shift-obj .
     1149             run factord-lock-shift in this-procedure
     1150               (input  buf_clients.obj-type
     1151               ,input  buf_clients.obj-code
     1152               ,input  0
     1153               ,buffer lock2_shift-obj
     1154               ) no-error .
     1155             if error-status :error  then do:
     1156                v-str-obj  = v-str-obj + substitute("&1&2," , buf_clients.obj-type, buf_clients.obj-code ) .
     1157                next.
     1158             end.
     1159           run clntattr-value in this-procedure
     1160             (input  buf_clients.obj-type
     1161             ,input  buf_clients.obj-code
     1162             ,input  'aht-del':U
     1163             ,output v-attr-aht-del-chr
     1164             ,output v-attr-aht-del-type
     1165             ).
     1166           assign
     1167             v-attr-aht-del = lookup(v-attr-aht-del-chr, 'yes,true':u) > 0
     1168           .
     1169           if  v-attr-aht-del <> true
     1170           and buf_clients.stts = 0
     1171           then do:
     1172             run trg/calcaht.p
     1173               (input buf_clients.obj-type
     1174               ,input buf_clients.obj-code
     1175               ,input false
     1176               ,input (p-install <> true)
     1177               ,input v-recalc-date
     1178               ,input true
     1179               ,input v-cntxt-db-num
     1180               ,input v-cntxt-userid
     1181               ) no-error .
     1182             if error-status :error
     1183             then do:
     1184               message
     1185                 vss-workfile vss-revision vss-description skip
     1186                 "Ошибка при расчете складского архива по типам приобретения" skip
     1187                 "Объект" buf_clients.obj-type buf_clients.obj-code skip
     1188                 "Информацию о рассчитанных объектах можно посмотреть в файле"
     1189                 "objaht.log" skip
     1190                 "или в АРМ Администратор" skip
     1191                 "Утилиты/Работа с архивами/Информация о складских архивах" skip
     1192                 error-status :get-message(1) skip
     1193                 return-value skip
     1194                 view-as alert-box error .
     1195               undo, return error .
     1196             end.
     1197           end.
     1198         end.
     1199       end.
     1200       when 3
     1201       then do:
     1202         return .
     1203       end.
     1204     end.
     1205     v-str-obj =   if v-str-obj <> "" then
     1206     substitute( "Некорректные объекты без смены: &1" , trim(v-str-obj, ',') )
     1207     else " " .
     1208     if p-install = false
     1209     then do:
     1210       message
     1211         "Расчет складского архива по типам приобретения закончен" skip
     1212          v-str-obj skip
     1213         view-as alert-box information .
     1214     end.
     1215     return .
     1216   end.
