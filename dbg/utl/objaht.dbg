      480      define input  parameter p-host-code-obj   as integer   no-undo .
      481      define input  parameter p-obj-type        as character no-undo .
      482      define input  parameter p-obj-code        as integer   no-undo .
      483      define output parameter p-user-select     as logical   no-undo .
