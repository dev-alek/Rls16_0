      532   procedure thobjs :
      533      define input        parameter parparentproc     as widget-handle no-undo .
      534      define input        parameter i-bttns           as character     no-undo .
      535      define input        parameter i-list-mode       as character     no-undo.
      536      define input        parameter i-obj-type        as character     no-undo.
      537      define input        parameter i-db-num          as integer       no-undo.
      538      define input        parameter i-host-code       as integer       no-undo.
      539      define input-output parameter p-rid-list        as character     no-undo .
      540   run ref/thobjs.p
