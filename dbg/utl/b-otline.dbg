        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Просмотр строк архива для одной строки документа".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE QUERY external_tables FOR doc-line.
      108   RUN set-attribute-list (
      109       'Keys-Accepted = "",
      110        Keys-Supplied = ""':U).
      111   RUN set-attribute-list (
      112       'SortBy-Options = ""':U).
      113   DEFINE QUERY br_table FOR
      114         ot-line SCROLLING.
      115   DEFINE BROWSE br_table
      116     QUERY br_table NO-LOCK DISPLAY
      117         ot-line.sum-type FORMAT "X(8)":U
      118         ot-line.cat-id FORMAT "x(20)":U
      119         ot-line.fact-qnty FORMAT "->>,>>>,>>9.999":U
      120         ot-line.sum-base FORMAT "->>,>>9.99":U
      121         ot-line.sum-rubl FORMAT "->>,>>>,>>9.99":U
      122         ot-line.VAT-base FORMAT "->>>,>>>,>>9.99":U
      123         ot-line.VAT-rubl FORMAT "->,>>>,>>>,>>>,>>9.99":U
      124         ot-line.SLT-base FORMAT "->>>,>>>,>>9.99":U
      125         ot-line.SLT-rubl FORMAT "->,>>>,>>>,>>>,>>9.99":U
      126         ot-line.road-tax-base FORMAT "->,>>>,>>9.99":U
      127         ot-line.road-tax-rubl FORMAT "->,>>>,>>9.99":U
      128         ot-line.transport-base FORMAT "->,>>>,>>9.99":U
      129         ot-line.transport-rubl FORMAT "->,>>>,>>9.99":U
      130         ot-line.other-base FORMAT "->,>>>,>>9.99":U
      131         ot-line.other-rubl FORMAT "->,>>>,>>9.99":U
      132         ot-line.excise-base FORMAT "->>>,>>>,>>9.99":U
      133         ot-line.excise-rubl FORMAT "->,>>>,>>>,>>>,>>9.99":U
      134         ot-line.fact-order FORMAT "9999999999999999999999.9999999999":U
      135         ot-line.obj-type FORMAT "X(3)":U
      136         ot-line.obj-code FORMAT "99999":U
      137         ot-line.doc-code FORMAT "X(14)":U
      138         ot-line.artic FORMAT "X(16)":U
      139         ot-line.prod-type FORMAT "X(3)":U
      140         ot-line.prod-code FORMAT ">>>>>>>>9":U
      141         ot-line.ext-doc-type COLUMN-LABEL "DT" FORMAT "X(2)":U
      142       WITH NO-ASSIGN SEPARATORS SIZE 94.25 BY 6.71.
      143   DEFINE FRAME F-Main
      144        br_table AT ROW 1 COL 1
      145       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      146            SIDE-LABELS NO-UNDERLINE THREE-D
      147            AT COL 1 ROW 1 SCROLLABLE
      148            BGCOLOR 8 FGCOLOR 0 .
      149   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      150   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      151   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      152   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      153   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      154   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      155   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      156   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      157   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      158   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      159   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      160         adm-object-hdl = FRAME F-Main:HANDLE.
      161   RUN ensure-broker.
      162   THIS-PROCEDURE:ADM-DATA =
      163        'ADM1.1~`':U +
      164        'SmartObject~`':U +
      165        '~`':U +
      166        'YES~`':U +
      167        'doc-line~`':U +
      168        'ot-line~`':U +
      169        '~`':U +
      170        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      171           + "~`":U +
      172        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      173        'Record-Source,Record-Target,TableIO-Target~`':U +
      174        '~`':U +
      175        '~`~`~`~`~`~`~`~`~`~`~`':U +
      176        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      177            THEN "^^":U
      178        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      179             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      180   PROCEDURE adm-apply-entry :
      181     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      182   END PROCEDURE.
      183   PROCEDURE adm-destroy :
      184    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      185   END PROCEDURE.
      186   PROCEDURE adm-disable :
      187       DISABLE br_table WITH FRAME F-Main.
      188       RUN dispatch ('disable-fields':U).
      189       RUN set-attribute-list ('ENABLED=no':U).
      190       RETURN.
      191   END PROCEDURE.
      192   PROCEDURE adm-edit-attribute-list :
      193         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      194         RETURN.
      195   END PROCEDURE.
      196   PROCEDURE adm-enable :
      197       ENABLE UNLESS-HIDDEN br_table WITH FRAME F-Main.
      198       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      199       RUN set-attribute-list ('ENABLED=yes':U).
      200       RETURN.
      201   END PROCEDURE.
      202   PROCEDURE adm-exit :
      203        RUN notify ('exit':U).
      204     RETURN.
      205   END PROCEDURE.
      206   PROCEDURE adm-hide :
      207     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      208   END PROCEDURE.
      209   PROCEDURE adm-initialize :
      210     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      211   END PROCEDURE.
      212   PROCEDURE adm-show-errors :
      213       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      214       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      215           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      216       END.
      217       RETURN.
      218   END PROCEDURE.
      219   PROCEDURE adm-UIB-mode :
      220     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      221   END PROCEDURE.
      222   PROCEDURE adm-view :
      223     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      224   END PROCEDURE.
      225   PROCEDURE dispatch :
      226       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      227       RUN broker-dispatch IN adm-broker-hdl
      228           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      229       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      230   END PROCEDURE.
      231   PROCEDURE ensure-broker :
      232   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      233   IF RETURN-VALUE NE "ADM-Broker":U THEN
      234   DO:
      235       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      236       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      237   END.
      238   END PROCEDURE.
      239   PROCEDURE get-attribute :
      240     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      241     RUN broker-get-attribute IN adm-broker-hdl
      242         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      243     RETURN RETURN-VALUE.
      244   END PROCEDURE.
      245   PROCEDURE get-attribute-list :
      246     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      247     RUN broker-get-attribute-list IN adm-broker-hdl
      248         (INPUT THIS-PROCEDURE,
      249          INPUT ?,
      250          OUTPUT p-attr-list) NO-ERROR.
      251     RETURN.
      252   END PROCEDURE.
      253   PROCEDURE new-state :
      254     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      255     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      256     RETURN.
      257   END PROCEDURE.
      258   PROCEDURE notify :
      259     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      260     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      261     IF RETURN-VALUE = "ADM-ERROR":U THEN
      262         RETURN "ADM-ERROR":U.
      263     RETURN.
      264   END PROCEDURE.
      265   PROCEDURE set-attribute-list :
      266     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      267     RUN ensure-broker.
      268     RUN broker-set-attribute-list IN adm-broker-hdl
      269         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      270     RETURN.
      271   END PROCEDURE.
      272   PROCEDURE set-position :
      273       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      274       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      275       IF VALID-HANDLE(adm-object-hdl) THEN
      276       DO:
      277         ASSIGN adm-object-hdl:ROW    =   p-row
      278                adm-object-hdl:COLUMN =   p-col.
      279       END.
      280       RETURN.
      281   END PROCEDURE.
      282     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      283     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      284     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      285     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      286     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      287     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      288     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      289     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      290     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      291     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      292     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      293     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      294     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      295     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      296     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      297     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      298     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      299     IF "":U = "":U THEN
      300       RUN modify-list-attribute IN adm-broker-hdl
      301         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      302     RUN use-create-on-add(?).
      303   PROCEDURE adm-add-record :
      304       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      305          "must have at least one Enabled Table to perform Add.":U
      306          VIEW-AS ALERT-BOX ERROR.
      307       RETURN.
      308   END PROCEDURE.
      309   PROCEDURE adm-assign-record :
      310    MESSAGE
      311          "Object ":U THIS-PROCEDURE:FILE-NAME
      312            "must have at least one Enabled Table to perform Assign.":U
      313              VIEW-AS ALERT-BOX ERROR.
      314      RETURN.
      315     END PROCEDURE.
      316   PROCEDURE adm-assign-statement :
      317     RETURN.
      318   END PROCEDURE.
      319   PROCEDURE adm-cancel-record :
      320      RETURN.
      321     END PROCEDURE.
      322   PROCEDURE adm-copy-record :
      323       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      324        "must have at least one Enabled Table to perform Copy.":U
      325          VIEW-AS ALERT-BOX ERROR.
      326       RETURN.
      327   END PROCEDURE.
      328   PROCEDURE adm-create-record :
      329      RETURN.
      330   END PROCEDURE.
      331   PROCEDURE adm-current-changed :
      332     RETURN.
      333   END PROCEDURE.
      334   PROCEDURE adm-delete-record :
      335    MESSAGE
      336          "Object ":U THIS-PROCEDURE:FILE-NAME
      337            "must have at least one Enabled Table to perform Delete.":U
      338              VIEW-AS ALERT-BOX ERROR.
      339       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      340       RETURN.
      341   END PROCEDURE.
      342   PROCEDURE adm-disable-fields :
      343         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      344       RETURN.
      345   END PROCEDURE.
      346   PROCEDURE adm-enable-fields :
      347       RETURN.
      348   END PROCEDURE.
      349   PROCEDURE adm-end-update :
      350     RETURN.
      351   END PROCEDURE.
      352   PROCEDURE adm-reset-record :
      353       RETURN.
      354   END PROCEDURE.
      355   PROCEDURE adm-update-record :
      356       MESSAGE
      357         "Object ":U THIS-PROCEDURE:FILE-NAME
      358           "must have at least one Enabled Table to perform Update.":U
      359             VIEW-AS ALERT-BOX ERROR.
      360      RETURN.
      361   END PROCEDURE.
      362   PROCEDURE check-modified :
      363   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      364   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      365   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      366   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      367     IF check-state = "check":U THEN
      368     DO:
      369       RUN get-link-handle IN adm-broker-hdl
      370         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      371            OUTPUT group-target-list).
      372       IF group-target-list NE "":U THEN
      373       DO i = 1 TO NUM-ENTRIES(group-target-list):
      374         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      375         RUN check-modified IN curr-widget ('group-check':U).
      376         IF RETURN-VALUE NE "":U THEN
      377         DO:
      378           RUN check-modified-message(RETURN-VALUE).
      379           RETURN "":U.
      380         END.
      381       END.
      382     END.
      383     RETURN "":U.
      384   END PROCEDURE.
      385   PROCEDURE check-modified-message :
      386     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      387        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      388           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      389        IF RETURN-VALUE = "YES":U THEN
      390           RUN notify ('view,CONTAINER-SOURCE':U).
      391        MESSAGE IF p-changed-table NE ? THEN
      392           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      393           ELSE "Current values have been changed."
      394           SKIP "  Do you wish to save those changes?"
      395           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      396        IF ANS THEN
      397        DO:
      398           IF group-assign-target THEN
      399             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      400           ELSE RUN dispatch('update-record':U).
      401           IF RETURN-VALUE = "ADM-ERROR":U THEN
      402           DO:
      403               MESSAGE "Changes to the previous record were not saved."
      404                 VIEW-AS ALERT-BOX ERROR.
      405               IF group-assign-target THEN
      406                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      407               ELSE RUN dispatch ('cancel-record':U).
      408           END.
      409        END.
      410        ELSE DO:
      411          IF group-assign-target THEN
      412             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      413          ELSE RUN dispatch('cancel-record':U).
      414        END.
      415        RETURN.
      416   END PROCEDURE.
      417   PROCEDURE get-rowid :
      418       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      419       ASSIGN
      420       p-table   =   adm-first-table.
      421       RETURN.
      422   END PROCEDURE.
      423   PROCEDURE init-group-assign :
      424       RUN request-attribute IN adm-broker-hdl
      425         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      426       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      427         group-assign-target = yes.
      428       ELSE group-assign-target = no.
      429       RETURN.
      430   END PROCEDURE.
      431   PROCEDURE set-editors :
      432       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      433       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      434       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      435       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      436       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      437       DO WHILE VALID-HANDLE (curr-widget):
      438           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      439              curr-widget:HIDDEN = no THEN DO:
      440             CASE p-field-setting:
      441               WHEN "INITIALIZE":U THEN
      442               DO:
      443                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      444                     read-only-list +
      445                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      446                        STRING(curr-widget).
      447               END.
      448               WHEN "DISABLE":U OR
      449               WHEN "ENABLE":U THEN
      450               DO:
      451                   curr-widget:SENSITIVE = yes.
      452                   RUN get-attribute ('Read-Only-Editors':U).
      453                   IF RETURN-VALUE = ? OR
      454                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      455                       curr-widget:READ-ONLY =
      456                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      457               END.
      458               WHEN "CLEAR":U THEN
      459                   curr-widget:SCREEN-VALUE = "":U.
      460             END CASE.
      461           END.
      462           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      463       END.
      464       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      465         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      466           + '"':U).
      467       RETURN.
      468   END PROCEDURE.
      469   PROCEDURE use-check-modified-all :
      470    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      471     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      472     RETURN.
      473   END PROCEDURE.
      474   PROCEDURE use-create-on-add :
      475   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      476      RETURN.
      477   END PROCEDURE.
      478   PROCEDURE use-initial-lock :
      479     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      480     ASSIGN adm-initial-lock = p-attr-value.
      481     RETURN.
      482   END PROCEDURE.
      483   PROCEDURE adm-display-fields :
      484         IF AVAILABLE ot-line THEN
      485             DISPLAY ot-line.sum-type ot-line.cat-id ot-line.fact-qnty ot-line.sum-base ot-line.sum-rubl ot-line.VAT-base ot-line.VAT-rubl ot-line.SLT-base ot-line.SLT-rubl ot-line.road-tax-base ot-line.road-tax-rubl ot-line.transport-base ot-line.transport-rubl ot-line.other-base ot-line.other-rubl ot-line.excise-base ot-line.excise-rubl ot-line.fact-order ot-line.obj-type ot-line.obj-code ot-line.doc-code ot-line.artic ot-line.prod-type ot-line.prod-code ot-line.ext-doc-type WITH BROWSE br_table
      486               NO-ERROR.
      487       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      488       RETURN.
      489   END PROCEDURE.
      490   PROCEDURE adm-open-query :
      491       IF AVAILABLE(doc-line) THEN DO:
      492               OPEN QUERY br_table FOR EACH ot-line OF doc-line WHERE TRUE NO-LOCK     .
      493           adm-query-opened = yes.
      494           IF NUM-RESULTS("br_table":U) = 0 THEN
      495               RUN new-state ('no-record-available,SELF':U).
      496           ELSE DO:
      497               RUN new-state ('record-available,SELF':U).
      498               RUN new-state ('first-record,SELF':U).
      499           END.
      500       END.
      501       ELSE
      502       DO:
      503           CLOSE QUERY br_table.
      504           RELEASE ot-line NO-ERROR.
      505           RUN new-state ('no-external-record-available,SELF':U).
      506       END.
      507           IF NOT adm-updating-record THEN
      508               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      509     RETURN.
      510   END PROCEDURE.
      511   PROCEDURE adm-row-changed :
      512         IF VALID-HANDLE(adm-object-hdl) THEN
      513           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      514         RUN notify ('row-available':U).
      515         RETURN.
      516   END PROCEDURE.
      517   PROCEDURE reposition-query :
      518       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      519       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      520       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      521       IF table-name <> ? THEN
      522           REPOSITION br_table TO ROWID table-name NO-ERROR.
      523       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      524       RETURN.
      525   END PROCEDURE.
      526     adm-sts = br_table:SET-REPOSITIONED-ROW
      527       (br_table:DOWN,"CONDITIONAL":U).
      528     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      529   PROCEDURE set-size :
      530     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      531     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      532     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      533     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      534     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      535     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      536     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      537     ASSIGN pd_height = MAX(pd_height, 2.0)
      538            pd_width  = MAX(pd_width, 2.0)
      539            hBrowse     = br_table:HANDLE IN FRAME F-Main
      540            hFieldGroup = hBrowse:PARENT
      541            htmpWidget  = hFieldGroup:FIRST-CHILD
      542            hFrame      = hFieldGroup:PARENT.
      543     Search-For-Siblings:
      544     REPEAT WHILE VALID-HANDLE(htmpWidget):
      545       IF htmpWidget NE hBrowse THEN DO:
      546         IF htmpWidget:TYPE NE "BUTTON" OR
      547            htmpWidget:X    NE 4 OR
      548            htmpWidget:Y    NE 4 THEN DO:
      549           RETURN.
      550         END.
      551       END.
      552       htmpWidget = htmpWidget:NEXT-SIBLING.
      553     END.
      554     IF pd_width < hBrowse:WIDTH THEN
      555       ASSIGN hBrowse:WIDTH = pd_width
      556              hFrame:WIDTH  = pd_width     NO-ERROR.
      557     ELSE
      558       ASSIGN hFrame:WIDTH  = pd_width
      559              hBrowse:WIDTH = pd_width     NO-ERROR.
      560     IF pd_height < hBrowse:HEIGHT THEN
      561       ASSIGN hBrowse:HEIGHT = pd_height
      562              hFrame:HEIGHT  = pd_height     NO-ERROR.
      563     ELSE
      564       ASSIGN hFrame:HEIGHT  = pd_height
      565              hBrowse:HEIGHT = pd_height     NO-ERROR.
      566   END PROCEDURE.
      567   ASSIGN
      568          FRAME F-Main:SCROLLABLE       = FALSE
      569          FRAME F-Main:HIDDEN           = TRUE.
      570   ASSIGN
      571          br_table:NUM-LOCKED-COLUMNS IN FRAME F-Main     = 2.
      572   ON ROW-ENTRY OF br_table IN FRAME F-Main
      573   DO:
      574   END.
      575   ON ROW-LEAVE OF br_table IN FRAME F-Main
      576   DO:
      577   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      578   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      579   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      580     widget-enter = last-event:widget-enter.
      581     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      582     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      583       THEN widget-frame = widget-enter:FRAME.
      584     IF ((NOT VALID-HANDLE(widget-enter)) OR
      585         (widget-parent:TYPE = "BROWSE":U) OR
      586         (NOT VALID-HANDLE(widget-frame)) OR
      587         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      588     THEN DO:
      589         IF adm-brs-in-update THEN
      590         DO:
      591           MESSAGE
      592           "You must complete or cancel the update before leaving the current row."
      593               VIEW-AS ALERT-BOX WARNING.
      594           RETURN NO-APPLY.
      595         END.
      596         IF br_table:CURRENT-ROW-MODIFIED  OR
      597           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      598         DO:
      599           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      600           THEN DO:
      601             MESSAGE
      602             "Current record has been changed. " SKIP
      603             "Do you wish to save those changes?"
      604               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      605             IF l-save THEN
      606             DO:
      607                RUN dispatch('update-record':U).
      608                IF RETURN-VALUE = "ADM-ERROR":U THEN
      609                    RETURN NO-APPLY.
      610             END.
      611             ELSE RUN dispatch ('cancel-record':U).
      612           END.
      613           ELSE DO:
      614             RUN dispatch('update-record':U).
      615             IF RETURN-VALUE = "ADM-ERROR":U THEN
      616                 RETURN NO-APPLY.
      617           END.
      618         END.
      619     END.
      620   END.
      621   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      622   DO:
      623   RUN get-attribute('ADM-NEW-RECORD':U).
      624   IF RETURN-VALUE NE "YES":U THEN
      625     RUN notify ('row-available':U).
      626   END.
      627   if not this-procedure :persistent
      628   then do:
      629     message
      630       vss-workfile vss-revision vss-description skip
      631       "Ошибка при запуске процедуры" skip
      632       "Данную процедуру следует запускать только с параметром persistent" skip
      633       view-as alert-box error .
      634     undo, return error .
      635   end.
      636   PROCEDURE adm-row-available :
      637     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      638     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      639     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      640     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      641     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      642     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      643     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      644     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      645     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      646     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      647     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      648     IF adm-updating-record THEN RETURN.
      649     RUN get-attribute ('FIELDS-ENABLED':U).
      650     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      651     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      652         OUTPUT link-handle) NO-ERROR.
      653     IF link-handle = "":U THEN
      654         RETURN.
      655     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      656     IF NUM-ENTRIES(link-handle) > 1 THEN
      657         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      658             "encountered more than one RECORD-SOURCE.":U SKIP
      659             "The first - ":U record-source-hdl:file-name " - will be used.":U
      660                VIEW-AS ALERT-BOX ERROR.
      661     RUN get-attribute ('Key-Name':U).
      662     key-name = RETURN-VALUE.
      663     IF key-name = "":U THEN key-name = ?.
      664     IF key-name NE ? THEN DO:
      665       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      666         NO-ERROR.
      667       IF key-value NE ? THEN
      668         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      669     END.
      670     IF key-name eq ? THEN tbl-list = "doc-line":U.
      671         RUN send-records IN record-source-hdl
      672             (INPUT tbl-list, OUTPUT rowid-list) NO-ERROR.
      673         IF ERROR-STATUS:ERROR THEN RETURN.
      674     IF key-name ne ?
      675     THEN DO:
      676       RUN dispatch ('find-using-key':U).
      677       IF RETURN-VALUE eq "ADM-ERROR":U THEN RETURN RETURN-VALUE.
      678     END.
      679     ELSE
      680     DO:
      681       row-avail-cntr = row-avail-cntr + 1.
      682       row-avail-rowid = TO-ROWID(ENTRY(row-avail-cntr,rowid-list)).
      683       IF row-avail-rowid NE ROWID(doc-line) THEN different-row = yes.
      684       IF row-avail-rowid ne ? THEN DO:
      685          DO:
      686            IF row-avail-enabled AND
      687               (adm-initial-lock = "SHARE-LOCK":U OR
      688                adm-initial-lock = "EXCLUSIVE-LOCK":U) THEN
      689            DO:
      690              IF adm-initial-lock = "SHARE-LOCK":U
      691              THEN FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid SHARE-LOCK NO-ERROR.
      692              ELSE DO TRANSACTION:
      693                FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid EXCLUSIVE-LOCK NO-ERROR.
      694              END.
      695            END.
      696            ELSE FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid  NO-LOCK NO-ERROR.
      697            IF ERROR-STATUS:ERROR THEN DO:
      698              RUN dispatch ('show-errors':U).
      699              RETURN "ADM-ERROR":U.
      700            END.
      701          END.
      702       END.
      703       ELSE DO:
      704            IF AVAILABLE doc-line THEN RELEASE doc-line.
      705              IF NOT different-row THEN
      706                RUN dispatch('open-query').
      707        END.
      708     END.
      709   IF VALID-HANDLE (adm-object-hdl) THEN
      710       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      711     IF key-name ne ? OR different-row
      712     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      713     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
      714   END PROCEDURE.
      715   PROCEDURE disable_UI :
      716     HIDE FRAME F-Main.
      717     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      718   END PROCEDURE.
      719   PROCEDURE send-records :
      720     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
      721     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
      722     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
      723     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
      724     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
      725     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
      726         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
      727         CASE ENTRY(i, p-tbl-list):
      728       WHEN "doc-line":U THEN p-rowid-list = p-rowid-list +
      729           IF AVAILABLE doc-line THEN STRING(ROWID(doc-line))
      730           ELSE "?":U.
      731       WHEN "ot-line":U THEN p-rowid-list = p-rowid-list +
      732           IF AVAILABLE ot-line THEN STRING(ROWID(ot-line))
      733           ELSE "?":U.
      734           OTHERWISE
      735           DO:
      736               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      737                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
      738               IF link-handle NE "":U THEN
      739               DO:
      740                   IF NUM-ENTRIES(link-handle) > 1 THEN
      741                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
      742                               "encountered more than one RECORD-SOURCE.":U SKIP
      743                               "The first will be used.":U
      744                               VIEW-AS ALERT-BOX ERROR.
      745                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
      746                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
      747                   p-rowid-list = p-rowid-list + rowid-string.
      748               END.
      749               ELSE
      750               DO:
      751                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
      752                           "does not match tables in send-records":U
      753                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
      754                           "Check that objects are linked properly and that":U
      755                           "database qualification is consistent.":U
      756                       VIEW-AS ALERT-BOX ERROR.
      757                   RETURN ERROR.
      758               END.
      759           END.
      760           END CASE.
      761       END.
      762   END PROCEDURE.
      763   PROCEDURE state-changed :
      764     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      765     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      766     CASE p-state:
      767       WHEN "update-begin":U THEN
      768       DO:
      769           adm-brs-in-update = yes.
      770           RUN dispatch ('enable-fields':U).
      771           IF RETURN-VALUE = "ADM-ERROR":U THEN
      772           DO:
      773             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      774             RUN new-state('update-complete':U).
      775           END.
      776           ELSE DO:
      777             RUN dispatch ('apply-entry':U).
      778             RUN new-state('update':U).
      779           END.
      780       END.
      781       WHEN "update":U THEN
      782         DO:
      783           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
      784           RUN get-link-handle IN adm-broker-hdl
      785               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
      786                   NO-ERROR.
      787           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
      788             br_table:SENSITIVE IN FRAME F-Main = no.
      789         END.
      790       WHEN "update-complete":U THEN DO:
      791           br_table:SENSITIVE IN FRAME F-Main = yes.
      792           adm-brs-in-update = no.
      793           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
      794           IF RETURN-VALUE NE "YES":U THEN
      795           DO:
      796             IF NUM-RESULTS("br_table":U) NE ? AND
      797                NUM-RESULTS("br_table":U) NE 0
      798             THEN DO:
      799               GET CURRENT br_table.
      800               RUN dispatch ('row-changed':U).
      801             END.
      802           END.
      803           RUN new-state ('update-complete':U).
      804       END.
      805       WHEN "delete-complete":U THEN DO:
      806          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
      807          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
      808          IF NUM-RESULTS("br_table":U) = 0 THEN
      809            RUN notify('row-available':U).
      810       END.
      811       WHEN   'first-record':U        OR
      812         WHEN 'last-record':U         OR
      813         WHEN 'only-record':U         OR
      814         WHEN 'not-first-or-last':U   OR
      815         WHEN 'no-record-available':U OR
      816         WHEN 'no-external-record-available':U THEN
      817           RUN set-attribute-list('Query-Position=':U + p-state).
      818     END CASE.
      819   END PROCEDURE.
