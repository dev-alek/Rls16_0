      792   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   function octal-to-char return character
      794   ( p-string as character ) :
      795     def var v-asc     as integer no-undo .
      796     def var v-new-asc as integer no-undo .
      797     def var ind       as integer no-undo .
      798     if length(p-string) <> 3 then do:
      799       return ? .
      800     end.
      801     assign
      802       v-asc = 0
      803     .
      804     do ind = 1 to length(p-string)
      805     :
      806       assign
      807         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      808       .
      809       if v-new-asc < 0 or v-new-asc >= 8 then do:
      810         return ? .
      811       end.
      812       assign
      813         v-asc = v-asc * 8 + v-new-asc
      814       .
      815     end.
      816     return chr(v-asc) .
      817   end function .
      818   function char-to-octal return character
      819   ( p-chr as character ) :
      820     def var v-asc    as integer   no-undo .
      821     def var ind      as integer   no-undo .
      822     def var v-string as character no-undo .
      823     if length(p-chr) <> 1 then do:
      824       return ? .
      825     end.
      826     assign
      827       v-asc    = asc(p-chr)
      828       v-string = ""
      829     .
      830     do ind = 1 to 3
      831     :
      832       assign
      833         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      834       .
      835       assign
      836         v-asc = truncate(v-asc / 8, 0)
      837       .
      838     end.
      839     return v-string .
      840   end.
      841   function str-encode return character
      842   (   p-init-string       as character
      843     , p-encode-char       as character
      844     , p-special-char-list as character
      845   ) :
      846     def var p-encode-string as character no-undo .
      847     def var ind                as integer no-undo .
      848     def var v-num-special-char as integer no-undo .
      849     def var v-special-char     as character no-undo .
      850     if p-encode-char = ?
      851     or p-encode-char = "" then do:
      852       assign
      853         p-encode-char = "~~"
      854       .
      855     end.
      856     if p-init-string = ? then do:
      857       return "?" .
      858     end.
      859     if p-init-string = "?" then do:
      860       return p-encode-char + char-to-octal("?") .
      861     end.
      862     assign
      863       v-num-special-char = length(p-special-char-list)
      864       p-encode-string    = replace(p-init-string
      865                                   ,p-encode-char
      866                                   ,p-encode-char + char-to-octal(p-encode-char)
      867                                   )
      868     .
      869     do ind = 1 to v-num-special-char
      870     :
      871       assign
      872         v-special-char = substring(p-special-char-list, ind, 1)
      873       .
      874       if v-special-char <> p-encode-char then do:
      875         assign
      876           p-encode-string = replace (p-encode-string
      877                                     ,v-special-char
      878                                     ,p-encode-char + char-to-octal(v-special-char)
      879                                     )
      880         .
      881       end.
      882     end.
      883     return p-encode-string .
      884   end.
      885   function str-decode returns character
      886     (p-init-string   as character
      887     ,p-encode-char   as character
      888     ) :
      889     def var p-decode-string as character no-undo .
      890     def var ind                       as integer no-undo .
      891     def var v-num-entries-init-string as integer no-undo .
      892     def var v-sub-phrase              as character no-undo .
      893     def var v-special-char            as character no-undo .
      894     if p-encode-char = ?
      895     or p-encode-char = "" then do:
      896       assign
      897         p-encode-char = "~~"
      898       .
      899     end.
      900     if p-init-string = "?" then do:
      901       return ? .
      902     end.
      903     assign
      904       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      905     .
      906     if v-num-entries-init-string > 1 then do:
      907       assign
      908         p-decode-string = entry(1, p-init-string, p-encode-char)
      909       .
      910       do ind = 2 to v-num-entries-init-string
      911       :
      912         assign
      913           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      914         .
      915         assign
      916           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      917         .
      918         if v-special-char <> ? then do:
      919           assign
      920             p-decode-string = p-decode-string
      921                             + v-special-char
      922                             + substring(v-sub-phrase, 4)
      923           .
      924         end.
      925         else do:
      926           assign
      927             p-decode-string = p-decode-string
      928                             + p-encode-char
      929                             + v-sub-phrase
      930           .
      931         end.
      932       end.
      933     end.
      934     else do:
      935       assign
      936         p-decode-string = p-init-string
      937       .
      938     end.
      939     return p-decode-string .
      940   end.
      941   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      943   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      944     field cst-code                like ub.trn-doc.cst-code
      945     field part-code               like ub.parts.part-code
      946     .
      947   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
