       69   procedure vss-get-parameters :
       70     define output parameter p-vss-parameters as character no-undo .
       71   end procedure.
       72   define new global shared variable g#vssrevis-logger as handle    no-undo .
       73   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       74   define variable v-vssrevis-logger                   as handle    no-undo .
       75   procedure vss-logevent :
       76     define input  parameter p-extra-paramters as character no-undo .
       77     define variable v-vssrevis-parameters as character no-undo .
       78     do
       79     on error undo, return error return-value
       80     :
       81       if  valid-handle(v-vssrevis-logger)
       82       and v-vssrevis-logger :get-signature("logevent") <> ""
       83       then do:
       84         run vss-get-parameters in this-procedure
       85           (output v-vssrevis-parameters
       86           ).
       87         run logevent in v-vssrevis-logger
       88           (input vss-workfile
       89           ,input vss-revision
       90           ,input v-vssrevis-parameters
       91           ,input p-extra-paramters
       92           ).
       93       end.
       94     end.
       95   end procedure.
       96   assign
       97     v-vssrevis-logger = g#vssrevis-logger
       98   .
       99   if  valid-handle(v-vssrevis-logger)
      100   and v-vssrevis-logger :get-signature("logevent") <> ""
      101   then do:
      102     assign
      103       v-vssrevis-logevent = true
      104     .
      105     run vss-logevent in this-procedure (input vss-description) .
      106   end.
      107   define new global shared variable g#language as character no-undo .
      108   if g#language <> '' and g#language <> 'rus':U then do:
      109     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      110   end.
      111   define new global shared variable g#library  as handle no-undo .
      112   define new global shared variable g#library2 as handle no-undo .
      113   define   shared variable g#auto as logical no-undo.
      114   define   shared variable g#news as logical no-undo.
      115   define   shared variable g#oxml as logical no-undo.
      116   define   shared variable g#esys as logical no-undo.
      117   define   shared variable g#news-source-db as integer no-undo.
      118   define   shared variable g#esys-source-esys as integer no-undo.
      119   define   shared variable g#db-num as integer   no-undo .
      120   define   shared variable g#userid as character no-undo .
      121   define   shared variable g#passwd as character no-undo .
      122   define new global shared variable g#lib-trn  as handle no-undo .
      123   define new global shared variable g#lib-trn2 as handle no-undo .
      124   define new global shared variable g#lib-trn3 as handle no-undo .
      125   define new global shared variable g#lib-trn4 as handle no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable to-day       as date no-undo .
      128   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   procedure doc-code:
      130   define input  parameter parmode          as   character           no-undo.
      131   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      132   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      133   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      134   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      135   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      136   define variable vardb-remote     as   logical             no-undo.
      137   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      138   define variable v-delimiter as character no-undo .
      139   do
      140   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      141   :
      142   find first buf_sys-ctrl no-lock .
      143   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      144     CASE parmode:
      145       when "main":u then do:
      146         if vardb-remote then do:
      147           assign
      148             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      149         end.
      150         else do:
      151           assign
      152             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      153         end.
      154       end.
      155       when "trio" then do:
      156         assign
      157           pardoc-code = replace (parroot-doc-code, "=", "*").
      158       end.
      159       otherwise do:
      160         assign
      161         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      162         no-error
      163         .
      164         if error-status:error  then do:
      165           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      166                                         ,chr(10)
      167                                         ,parmode
      168                                         ).
      169         end.
      170         if num-entries(parmode) = 1
      171         and parmode <> "chip":U
      172         and parmode <> "chip_s":U
      173         then do:
      174           assign
      175           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      176         end.
      177         else if (lookup("chip":U, parmode) > 0
      178                  or
      179                  lookup("chip_s":U, parmode) > 0) then do:
      180           assign
      181             vartemp-doc-code = parroot-doc-code.
      182           do while true:
      183             if index (vartemp-doc-code , ".") = 0 then
      184               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      185             else
      186               vartemp-doc-code  =
      187               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      188               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      189               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      190             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      191           end.
      192           assign
      193             pardoc-code = vartemp-doc-code.
      194         end.
      195       end.
      196     end CASE.
      197     if pardoc-code = '':U
      198     or (parroot-doc-code <> '':U
      199     and pardoc-code = parroot-doc-code) then do:
      200       undo, return error substitute("Ошибка при генерации номера документа&1"
      201                                     ,chr(10)).
      202     end.
      203   end.
      204   end. // procedure/method
      205   function get-doc-code-int64 returns int64
      206     ( input p-doc-code as character ) :
      207     define variable v-ind              as integer   no-undo .
      208     define variable v-num-entries      as integer   no-undo .
      209     define variable v-doc-code-int64   as int64     no-undo .
      210     define variable v-canonic-doc-code as character no-undo .
      211     assign
      212       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      213       v-canonic-doc-code = p-doc-code
      214     .
      215     do v-ind = 1 to v-num-entries
      216     :
      217       assign
      218         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      219       .
      220     end.
      221     assign
      222       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      223     .
      224     return v-doc-code-int64 .
      225   end. // function/method
      226   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      227   define variable v-waitfram-action01         as character   no-undo .
      228   define variable v-waitfram-action02         as character   no-undo .
      229   define variable v-waitfram-action03         as character   no-undo .
      230   define variable mWaitFramTextBeg            as character   no-undo.
      231   define variable mWaitFramTextEnd            as character   no-undo.
      232   define variable mWaitFramView               as logical     no-undo.
      233   define variable mWaitProcEvent              as logical     no-undo init yes.
      234   define variable mWaitFramInterval           as integer     no-undo init 1 .
      235   define variable mWaitFramStop               as logical     no-undo.
      236   define variable mWaitFramStopUser           as logical     no-undo.
      237   define variable mWaitFramStopTimeOut        as logical     no-undo.
      238   define variable mWaitFramStartProc          as datetime-tz no-undo.
      239   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      240   define button B-WaitFramStop auto-end-key
      241        label "Стоп"
      242        size 10 by 1 tooltip "Остоновить процесс".
      243   define button B-viewProcInfo
      244        label "Информация"
      245        size 15 by 1 tooltip "Информация о процесс".
      246   define frame waitfram
      247     v-waitfram-action01 format "x(72)" no-label skip
      248     v-waitfram-action02 format "x(72)" no-label skip
      249     v-waitfram-action03 format "x(72)" no-label skip
      250     B-viewProcInfo
      251     B-WaitFramStop at row 4 col 30
      252     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      253     .
      254   define new global shared variable mBatchMode as logical no-undo init ?.
      255   define variable mFramBachModHandle as handle no-undo.
      256   mFramBachModHandle = frame waitfram:handle.
      257   define variable mFameOldVis as logical no-undo.
      258   define variable mVisCUrentVin as logical no-undo.
      259   if session:batch-mode
      260   then
      261      mBatchMode = yes.
      262   if mBatchMode = ? then do:
      263     mVisCUrentVin = current-window:visible.
      264     mFameOldVis = mFramBachModHandle:visible.
      265     mFramBachModHandle:visible  = yes.
      266     mBatchMode = mFramBachModHandle:visible ne yes.
      267     mFramBachModHandle:visible = mFameOldVis.
      268     current-window:visible = mVisCUrentVin.
      269   end.
      270    if  log-manager:logfile-name ne ?
      271     then DO:
      272         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      273         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      274         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      275     end.
      276   on choose of B-WaitFramStop in frame waitfram
      277   do:
      278     mWaitFramStop = yes.
      279     mWaitFramStopUser = yes.
      280   end.
      281   function waitfram-check-timeout returns logical():
      282      define variable vtime as int64 no-undo.
      283      if mWaitFramStopTimeOut
      284      then
      285         return yes.
      286      vtime = ( now - mWaitFramStartProc ) / 1000 .
      287      if     mWaitFramTimeOut ne ?
      288         and mWaitFramTimeOut ne 0
      289         and mWaitFramTimeOut lt vtime
      290      then do:
      291         mWaitFramStopTimeOut = yes.
      292      end.
      293      return mWaitFramStopTimeOut.
      294   end.
      295   procedure waitfram-hide :
      296     if not session:batch-mode
      297     then do
      298     on error undo, return error return-value
      299     :
      300       pause 0 before-hide .
      301       if not mBatchMode then
      302         hide frame waitfram .
      303     if     not mWaitFramView
      304        and mWaitProcEvent
      305     then
      306       process events .
      307     end.
      308   end procedure.
      309   procedure waitfram-show :
      310     define input  parameter p-message as character no-undo .
      311     define variable v-left-margin as integer   no-undo .
      312     if not session:batch-mode
      313     then do
      314     on error undo, return error return-value
      315     :
      316       if length(p-message) <= 70 then do:
      317         assign
      318           v-left-margin = integer((70 - length(p-message)) / 2)
      319         .
      320         assign
      321           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      322         .
      323         assign
      324           v-waitfram-action01 = " "
      325           v-waitfram-action02 = " "
      326                                    + fill(" ", v-left-margin)
      327                                    + p-message
      328           v-waitfram-action03 = " "
      329         .
      330       end.
      331       else do:
      332         define variable vRindex1 as integer no-undo.
      333         define variable vRindex2 as integer no-undo.
      334         vRindex1 = r-index(p-message," ",70).
      335         if vRindex1 = 0
      336         then
      337            vRindex1 = 70.
      338         if length(p-message)  <= vRindex1 + 70 then do:
      339           assign
      340             v-waitfram-action01 = " "
      341             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      342             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      343           .
      344         end.
      345         else do:
      346           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      347           if vRindex2 <= vRindex1
      348           then
      349              vRindex2 = vRindex1 + 70.
      350           assign
      351             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      352             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      353             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      354           .
      355         end.
      356       end.
      357       B-viewProcInfo:visible   in frame waitfram = no.
      358       B-viewProcInfo:sensitive in frame waitfram = no.
      359       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      360       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      361       if  (   mWaitFramView
      362          or  mWaitProcEvent)
      363          and not mBatchMode
      364       then
      365          display
      366             v-waitfram-action01 skip
      367             v-waitfram-action02 skip
      368             v-waitfram-action03 skip
      369          with frame waitfram .
      370       if     mWaitFramView
      371          then do:
      372             if     mWaitFramInterval ne ?
      373                and not mBatchMode
      374             then
      375                wait-for go of frame waitfram pause mWaitFramInterval.
      376          end.
      377          else
      378             if     mWaitProcEvent
      379                and not mBatchMode
      380             then
      381                process events .
      382     end.
      383   end procedure.
      384      procedure waitfram-show-this:
      385         define input  parameter iInterval as int64 no-undo.
      386         define variable vtime as int64 no-undo.
      387         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      388         mWaitFramInterval = iInterval.
      389         run waitfram-show (substitute("&1&2 &3&4" ,
      390                                       mWaitFramTextBeg ,
      391                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      392                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      393                                       mWaitFramTextEnd
      394                                      )
      395                           ).
      396      end.
      397      procedure WaitFramRunPause:
      398         define input  parameter iInterval as dec no-undo.
      399         define variable vStart  as datetime-tz no-undo.
      400         define variable vend    as datetime-tz no-undo.
      401         define variable vint as int64 no-undo.
      402         define variable vOk as logical no-undo.
      403         vStart = now.
      404         vend   = vStart.
      405         publish "WaitFramPause" (iInterval,output vOk).
      406         vend   =  now.
      407         vint = vend - vStart.
      408         vint = iInterval - vint / 1000.
      409         if     not mWaitFramStop
      410            and (   vint > 0
      411                 or (    not vOk
      412                     and iInterval eq ?
      413                     )
      414                 )
      415         then
      416            run waitfram-show-this (iInterval).
      417         vend   =  now.
      418         vint = vend - vStart.
      419         vint = iInterval - vint / 1000.
      420         if     not mWaitFramStop
      421            and vint > 0
      422         then do:
      423            run gbl/pause.p (vint * 1000).
      424         end.
      425         if iInterval ne ?
      426         then
      427            publish "WaitFramStop".
      428         waitfram-check-timeout().
      429      end.
      430      procedure WaitFramWaitFor:
      431         define input  parameter iInterval as dec no-undo.
      432         assign
      433            mWaitFramStartProc   = now
      434            mWaitFramStopUser    = no
      435            mWaitFramStopTimeOut = no
      436         .
      437         block-wait:
      438         do while not mWaitFramStop:
      439            run WaitFramRunPause (iInterval).
      440            if  waitfram-check-timeout()
      441            then do:
      442               leave block-wait.
      443            end.
      444         end.
      445         run waitfram-hide.
      446      end.
      447   procedure waitfram-join :
      448     define input  parameter p-line-1  as character no-undo .
      449     define input  parameter p-line-2  as character no-undo .
      450     define input  parameter p-line-3  as character no-undo .
      451     define output parameter p-message as character no-undo .
      452     do
      453     on error undo, return error return-value
      454     :
      455       assign
      456         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      457                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      458                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      459       .
      460     end.
      461   end procedure.
      462   function waitfram-join-function returns character
      463     (input p-line-1 as character
      464     ,input p-line-2 as character
      465     ,input p-line-3 as character
      466     ).
      467     define variable v-message as character no-undo .
      468     run waitfram-join in this-procedure
      469       (input  p-line-1
      470       ,input  p-line-2
      471       ,input  p-line-3
      472       ,output v-message
      473       ) .
      474     return v-message .
      475   end function .
      476   function cross-list returns logical (
      477     input parfirst-stream  as character,
      478     input parsecond-stream as character,
      479     input pardelim         as character).
      480     if pardelim = ""
      481     or pardelim = ?
      482     then do:
      483       assign
      484         pardelim = ","
      485       .
      486     end.
      487     define variable vari            as integer no-undo .
      488     define variable varresult-cross as logical no-undo .
      489     assign
      490       varresult-cross = no
      491     .
      492     def var v-num-parfirst-stream as integer no-undo .
      493     assign
      494       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      495     .
      496     do vari = 1 to v-num-parfirst-stream
      497     :
      498       if lookup(entry(vari, parfirst-stream, pardelim)
      499                ,parsecond-stream
      500                ,pardelim
      501                ) > 0 then do:
      502         assign
      503           varresult-cross = yes
      504         .
      505         leave.
      506       end.
      507     end.
      508     return varresult-cross .
      509   end function.
      510   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      511   define new global shared variable g#attr-lib  as handle no-undo .
      512   define variable v-attr-lib-variable as handle no-undo .
      513   procedure clntattr-code :
      514     define input  parameter p-code           as character no-undo .
      515     define output parameter p-type           as character no-undo .
      516     define output parameter p-format         as character no-undo .
      517     define output parameter p-label          as character no-undo .
      518     define output parameter p-user-can-edit  as logical   no-undo .
      519     define output parameter p-output-display as logical   no-undo .
      520     define output parameter p-other          as character no-undo .
      521     do
