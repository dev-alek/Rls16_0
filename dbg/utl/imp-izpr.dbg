       53   procedure vss-get-info :
       54     define output parameter p-vss-revision    like vss-revision    no-undo .
       55     define output parameter p-vss-author      like vss-author      no-undo .
       56     define output parameter p-vss-date        like vss-date        no-undo .
       57     define output parameter p-vss-workfile    like vss-workfile    no-undo .
