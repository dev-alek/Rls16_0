     1803   procedure clos-trn :
     1804     do
     1805     on error undo, return error return-value
     1806     :
     1807   define input parameter p-trn-code as character no-undo .
     1808   define buffer buf_s-trn-doc for ub.trn-doc.
     1809   define variable varmode            as   character           no-undo.
     1810   define variable varstatus          like ub.trn-doc.status_  no-undo.
     1811   define variable varflag            like ub.trn-doc.flag     no-undo.
     1812   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     1813   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     1814   define variable varcheck-return as logical no-undo .
