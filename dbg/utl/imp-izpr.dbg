      949   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      950   function hvrdtax return logical (input parrecid as recid):
      951   define variable varresult as logical no-undo.
      952   run hvrdtax-proc (input parrecid, output varresult).
      953   return varresult.
      954   end function.
      955   procedure hvrdtax-proc:
      956   define input  parameter parrecid  as recid   no-undo.
      957   define output parameter parresult as logical no-undo.
      958   define buffer bf_goods for ub.goods.
      959   define buffer bf_units for ub.units.
      960   define buffer rt_tax   for ub.tax.
      961   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      962   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      963   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      964   if available rt_tax and
      965       can-find(first ub.tax-units No-LOCK WHERE
      966                      ub.tax-units.tax-code = rt_tax.tax-code AND
      967                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      968                                                       else assign parresult = no.
      969   end procedure.
      970   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      971   define new global shared variable g#lib-calc as handle no-undo .
      972   procedure plgdsfnd :
      973     define input  parameter p-chk-and-chs    as logical               no-undo .
      974     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      975     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      976     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      977     define output parameter p-reserv-pl-code as   logical             no-undo .
      978     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      979     define buffer buf_goods         for ub.goods .
      980     define buffer buf_pl-gds        for ub.pl-gds .
      981     define buffer buf_second_pl-gds for ub.pl-gds .
      982     find first buf_goods no-lock where
      983                buf_goods.gds-code = p-gds-code no-error .
      984     if not available buf_goods
      985     then do:
      986       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      987     end.
      988   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      990     (input  p-obj-type
      991     ,input  p-obj-code
      992     ,input  buf_goods.artic
      993     ,input  buf_goods.prod-type
      994     ,input  buf_goods.prod-code
      995     ,input  'place-rsrv=request'
      996     ,output p-reserv-pl-code
      997     ) no-error .
      998     if error-status :error
      999     then do:
     1000       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1001     end.
     1002     if p-reserv-pl-code = no
     1003     then do:
     1004       return .
     1005     end.
     1006     if p-chk-and-chs <> yes
     1007     then do:
     1008       return .
     1009     end.
     1010     find first buf_pl-gds no-lock where
     1011                buf_pl-gds.obj-type = p-obj-type and
     1012                buf_pl-gds.obj-code = p-obj-code and
     1013                buf_pl-gds.gds-code = p-gds-code no-error .
     1014     if not available buf_pl-gds
     1015     then do:
     1016       return error "К товару не привязано ни одного места хранения" .
     1017     end.
     1018     find first buf_second_pl-gds no-lock where
     1019                buf_second_pl-gds.obj-type  = p-obj-type          and
     1020                buf_second_pl-gds.obj-code  = p-obj-code          and
     1021                buf_second_pl-gds.gds-code  = p-gds-code          and
     1022                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1023     if not available buf_second_pl-gds
     1024     then do:
     1025       assign
     1026         p-pl-code = buf_pl-gds.pl-code
     1027       .
     1028     end.
     1029     else do:
     1030       if not valid-handle( parparentproc )
     1031       then do:
     1032         return error "Не выбрано место хранения " + chr(10) .
     1033       end.
     1034       run str/plgdssel.p
     1035         (
     1036            input parparentproc
     1037         ,  input p-obj-type
     1038         ,  input p-obj-code
     1039         ,  input p-gds-code
     1040         , output p-pl-code
     1041         ) no-error .
     1042       if error-status :error
     1043       then do:
     1044         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1045                                , 'plgdssel.p':U
     1046                                , chr(10)
     1047                                , error-status :get-message( 1 )
     1048                                , return-value
     1049                                ) .
     1050       end.
     1051       if p-pl-code = ? or
     1052          p-pl-code = 0
     1053       then do:
     1054         return error "Не выбрано место хранения " + chr(10) .
     1055       end.
     1056     end.
     1057   end procedure.
     1058   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1060   define temp-table tt-doc-line no-undo like ub.doc-line
     1061   field cst-code like ub.trn-doc.cst-code
     1062   .
     1063   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1064   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1065   define temp-table tt-parts    no-undo like ub.parts.
     1066   procedure lib-trn_copy-inqu :
     1067   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1068   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1069   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1070   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1071   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1072   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1073   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1074   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1075   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1076   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1077   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1078   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1079   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1080   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1081   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1082   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1083   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1084   define input parameter parinp-discnt-type as   logical                no-undo.
     1085   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1086   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1087   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1088   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1089   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1090   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1091   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1092   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1093   define input parameter table for tt-doc-line.
     1094   define input parameter table for tt-gds-dtl.
     1095   define input parameter table for tt-parts.
     1096   define input parameter paruse-parts       as   logical                no-undo.
     1097   define input parameter parall-qnty        as   logical                no-undo.
     1098   define input parameter parfix-price       as   logical                no-undo.
     1099   define buffer crt_trn-doc  for ub.trn-doc.
     1100   define buffer crt_goods    for ub.goods.
     1101   define buffer crt_doc-line for ub.doc-line.
     1102   define buffer crt_gds-dtl  for ub.gds-dtl.
     1103   define variable end-price    as   logical              no-undo.
     1104   define variable real-type    like ub.goods.gds-type    no-undo.
     1105   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1106   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1107   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1108   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1109   define variable g-log        as   logical              no-undo.
     1110   define variable mem-qnty like chg-qnty no-undo.
     1111   define variable dflt-cd as character no-undo .
     1112   c-l:
     1113   do on error undo, return error return-value :
     1114   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1115   assign
     1116       paruse-parts = false
     1117       .
     1118   assign
     1119     end-price = no.
     1120   if parinp-discnt-type = yes and
     1121      parinp-discnt-pc   = 0   and
     1122      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1123      then do:
     1124     assign
     1125       crt_trn-doc.tot-calc    = partot-calc
     1126       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1127       crt_trn-doc.discnt-type = pardiscnt-type.
     1128   end.
     1129   if parinp-agnt = ? then do:
     1130     assign
     1131       crt_trn-doc.agnt = paragnt.
     1132   end.
     1133   if parinp-boss = ? then do:
     1134     assign
     1135       crt_trn-doc.boss = parboss.
     1136   end.
     1137   if parinp-wrkr = ? then do:
     1138     assign
     1139       crt_trn-doc.wrkr = parwrkr.
     1140   end.
     1141   if parinp-base-rate  = ? then do:
     1142     assign
     1143       crt_trn-doc.base-rate  = parbase-rate.
     1144   end.
     1145   if parinp-base-scale = ? then do:
     1146     assign
     1147       crt_trn-doc.base-scale = parbase-scale.
     1148   end.
     1149   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1150   if available tt-doc-line then do:
     1151     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1152                      and crt_goods.prod-type = tt-doc-line.prod-type
     1153                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1154     if crt_goods.gds-type = 'у':U and
     1155        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1156       return error "В данный документ нельзя копировать услуги.".
     1157     end.
     1158     assign
     1159       real-type = crt_goods.gds-type.
     1160     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1161     if available crt_doc-line then do:
     1162       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1163                        and crt_goods.prod-type = crt_doc-line.prod-type
     1164                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1165       if crt_goods.gds-type <> real-type then do:
     1166         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1167       end.
     1168     end.
     1169     else do:
     1170       assign
     1171         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1172     end.
     1173   end.
     1174   r-l:
     1175   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1176     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1177                      and crt_goods.prod-type = tt-doc-line.prod-type
     1178                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1179   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1180      (
     1181       input crt_trn-doc.doc-code
     1182      ,input crt_trn-doc.obj-type
     1183      ,input crt_trn-doc.obj-code
     1184      ,input crt_goods.artic
     1185      ,input crt_goods.prod-type
     1186      ,input crt_goods.prod-code
     1187      ,input crt_goods.gds-name
     1188      ,input crt_goods.prt-root
     1189      ,input ?
     1190      ,input ?
     1191      ,input parcash-pay      ) no-error.
     1192     if error-status:error then do:
     1193       undo c-l, return error return-value.
     1194     end.
     1195     if return-value = "next" then do:
     1196       next r-l.
     1197     end.
     1198     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1199                                   crt_doc-line.artic     = crt_goods.artic      and
     1200                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1201                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1202     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1203                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1204                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1205                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1206                               break by tt-gds-dtl.artic
     1207                                     by tt-gds-dtl.prod-type
     1208                                     by tt-gds-dtl.prod-code
     1209                               :
     1210   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1211     ( input  tt-gds-dtl.artic
     1212      ,input  tt-gds-dtl.prod-type
     1213      ,input  tt-gds-dtl.prod-code
     1214      ,input  tt-gds-dtl.prt-code
     1215      ,input  tt-doc-line.obj-type
     1216      ,input  tt-doc-line.obj-code
     1217      ,output legal-node
     1218     ) no-error .
     1219       if error-status:error then do:
     1220          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1221       end.
     1222   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1223     ( input crt_trn-doc.obj-code
     1224      ,input crt_trn-doc.obj-type
     1225      ,input crt_trn-doc.doc-code
     1226      ,input crt_goods.artic
     1227      ,input crt_goods.prod-code
     1228      ,input crt_goods.prod-type
     1229      ,input legal-node
     1230      ,input yes
     1231     ) no-error .
     1232        if error-status:error then do:
     1233           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1234        end.
     1235        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1236                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1237                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1238                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1239                                     crt_gds-dtl.prt-code  = legal-node.
     1240       assign
     1241         crt_gds-dtl.ov             = parfix-price
     1242         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1243         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1244         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1245         .
     1246       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1247         assign
     1248           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1249           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1250           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1251           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1252       end.
     1253       if end-price then do:
     1254         assign
     1255           crt_gds-dtl.ov             = yes
     1256           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1257           crt_gds-dtl.discnt-base    = 0
     1258           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1259           crt_gds-dtl.discnt-rubl    = 0
     1260           crt_gds-dtl.discnt-pc      = 0
     1261           crt_gds-dtl.discnt-type    = yes.
     1262       end.
     1263   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1264   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1265     ( input recid(crt_gds-dtl)
     1266     , input no
     1267     , input ?
     1268     ) no-error.
     1269           if error-status:error then do:
     1270             undo c-l, return error return-value.
     1271           end.
     1272       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1273          crt_gds-dtl.ov then do:
     1274         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1275       end.
     1276       if paruse-parts then do:
     1277          if first-of (tt-gds-dtl.prod-code) then do:
     1278            for each tt-parts :
     1279              assign
     1280                chg-qnty = tt-parts.fact-qnty
     1281                mem-qnty = chg-qnty.
     1282              assign
     1283              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1284              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1285            end.
     1286            assign
     1287              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1288              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1289            assign
     1290              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1291              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1292            if crt_gds-dtl.doc-qnty = 0 then do:
     1293              delete crt_gds-dtl.
     1294            end.
     1295          end.
     1296       end.
     1297       else do:
     1298         assign
     1299           chg-qnty = tt-gds-dtl.fact-qnty
     1300           mem-qnty = chg-qnty.
     1301         assign
     1302           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1303           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1304           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1305           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1306         assign
     1307         varchg-qnty  = varchg-qnty  + chg-qnty
     1308         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1309         if crt_gds-dtl.doc-qnty = 0 then do:
     1310           delete crt_gds-dtl.
     1311         end.
     1312       end.
     1313     end.
     1314     if crt_doc-line.doc-qnty = 0 then do:
     1315       delete crt_doc-line.
     1316     end.
     1317   end.
     1318   end.
     1319   end procedure.
     1320   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1321     define variable v-cntxt-db-num        as integer   no-undo .
     1322     define variable v-cntxt-userid        as character no-undo .
     1323     define variable v-cntxt-level         as character no-undo .
     1324     define variable v-cntxt-host-code-obj as integer   no-undo .
     1325     define variable v-cntxt-obj-type      as character no-undo .
     1326     define variable v-cntxt-obj-code      as integer   no-undo .
     1327     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1328     define variable v-cntxt-is-admin      as logical   no-undo .
