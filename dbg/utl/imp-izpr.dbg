     1831       input  v-cntxp-holidays,
     1832       input  NO,
     1833       output varchg-inv,
     1834       output table gds-list)
     1835       no-error.
     1836       if error-status:error then do:
     1837         return error substitute("Ошибка закрытия документа &3 &2 &1" , error-status :error , return-value ,  p-trn-code ) .
     1838       end.
     1839     end.
     1840   end procedure.
