      159   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   procedure cur-time :
      161      define output parameter p-today as date      no-undo .
      162      define output parameter p-time  as integer   no-undo .
      163     do
      164     on error undo, return error
      165     :
      166       define variable v-date1 as date      no-undo .
      167       define variable v-date2 as date      no-undo .
      168       define variable v-time  as integer   no-undo .
      169       assign
      170         v-date1 = today
      171         v-time  = time
      172         v-date2 = today
      173       .
      174       if v-date1 <> v-date2
      175       then do:
      176         assign
      177           v-date1 = today
      178           v-time  = v-time
      179         .
      180       end.
      181       assign
      182         p-today = v-date1
      183         p-time  = v-time
      184       .
      185     end.
      186   end.
      187   function cur-time-date returns character
      188   :
      189     return string(today, '99/99/9999':U) .
      190   end.
      191   function cur-time-mjd returns decimal
      192   :
      193     define variable v-date as date      no-undo .
      194     define variable v-time as integer   no-undo .
      195     run cur-time in this-procedure
      196       (output v-date
      197       ,output v-time
      198       ) .
      199     return integer(v-date) - 2400002 + (v-time / 86400) .
      200   end.
      201   function cur-time-get-ending-index returns integer
      202   (input p-number as integer
      203   )
      204   :
      205     if p-number < 0
      206     or p-number = ?
      207     then do:
      208       return 1 .
      209     end.
      210     define variable v-rest as integer   no-undo .
      211     assign
      212       p-number = p-number modulo 100
      213     .
      214     if p-number < 20
      215     then do:
      216       assign
      217         v-rest = p-number
      218       .
      219     end.
      220     else do:
      221       assign
      222         v-rest = p-number modulo 10
      223       .
      224     end.
      225     case v-rest :
      226       when 1
      227       then do:
      228         return 2 .
      229       end.
      230       when 2 or
      231       when 3 or
      232       when 4
      233       then do:
      234         return 3 .
      235       end.
      236       otherwise do:
      237         return 1 .
      238       end.
      239     end case .
      240   end.
      241   procedure cur-time-mjd-to-date :
      242      define input  parameter i-mjd-diff as decimal no-undo.
      243      define output parameter o-Date     as date    no-undo.
      244      define output parameter o-Time     as integer no-undo.
      245      define variable v-day-number as integer   no-undo .
      246      if    i-mjd-diff < 0
      247         or i-mjd-diff = ?
      248      then do:
      249         return "?" .
      250      end.
      251      assign
      252         v-day-number = truncate(i-mjd-diff,0).
      253         o-Date = date(v-day-number + 2400002).
      254         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      255     .
      256   end.
      257   function cur-time-mjd-to-string returns character
      258   (input p-mjd-diff as decimal
      259   )
      260   :
      261     define variable v-day-number as integer   no-undo .
      262     define variable v-seconds    as integer   no-undo .
      263     define variable v-hour       as integer   no-undo .
      264     define variable v-min        as integer   no-undo .
      265     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      266     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      267     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      268     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      269     if p-mjd-diff < 0
      270     or p-mjd-diff = ?
      271     then do:
      272       return "?" .
      273     end.
      274     assign
      275       v-day-number = integer(truncate(p-mjd-diff,0))
      276       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      277     .
      278     if v-seconds > 86400
      279     then do:
      280       assign
      281         v-seconds = 86400 - 1
      282       .
      283     end.
      284     if v-seconds < 0
      285     then do:
      286       assign
      287         v-seconds = 0
      288       .
      289     end.
      290     assign
      291       v-hour = truncate(v-seconds / 3600, 0)
      292     .
      293     assign
      294       v-seconds = v-seconds modulo 3600
      295     .
      296     assign
      297       v-min = truncate(v-seconds / 60, 0)
      298     .
      299     assign
      300       v-seconds = v-seconds modulo 60
      301     .
      302     return
      303         (if v-day-number <> 0
      304           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      305           else ""
      306         )
      307       + (if v-day-number <> 0 or v-hour <> 0
      308           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      309           else ""
      310         )
      311       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      312           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      313           else ""
      314         )
      315       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      316       .
      317   end.
      318   function cur-time-string returns character
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      327   end.
      328   function cur-time-string-sec returns character
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      337   end.
      338   function cur-time-custom  returns character
      339   (input p-prefix as character
      340   ,input p-date-format as character
      341   ,input p-delimiter as character
      342   ,input p-time-format as character
      343   ,input p-suffix as character
      344   )
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return
      353       p-prefix
      354       + string(v-date, p-date-format)
      355       + p-delimiter
      356       + string(v-time, p-time-format)
      357       + p-suffix
      358       .
      359   end.
      360   function cur-time-print  returns character
      361   :
      362     define variable v-date as date      no-undo .
      363     define variable v-time as integer   no-undo .
      364     run cur-time in this-procedure
      365       (output v-date
      366       ,output v-time
      367       ) .
      368     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      369   end.
      370   function cur-time-datetime returns datetime
      371   :
      372     define variable v-char as character no-undo .
      373     define variable v-datetime as datetime no-undo .
      374     v-char = cur-time-string().
      375     v-datetime = datetime(v-char).
      376     return  v-datetime.
      377   end.
      378   function cur-time-string-msec returns character
      379   :
      380     define variable v-date as datetime  no-undo .
      381     v-date = now.
      382     return string(v-date) .
      383   end.
      384   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   define variable v-waitfram-action01         as character   no-undo .
      386   define variable v-waitfram-action02         as character   no-undo .
      387   define variable v-waitfram-action03         as character   no-undo .
      388   define variable mWaitFramTextBeg            as character   no-undo.
      389   define variable mWaitFramTextEnd            as character   no-undo.
      390   define variable mWaitFramView               as logical     no-undo.
      391   define variable mWaitProcEvent              as logical     no-undo init yes.
      392   define variable mWaitFramInterval           as integer     no-undo init 1 .
      393   define variable mWaitFramStop               as logical     no-undo.
      394   define variable mWaitFramStopUser           as logical     no-undo.
      395   define variable mWaitFramStopTimeOut        as logical     no-undo.
      396   define variable mWaitFramStartProc          as datetime-tz no-undo.
      397   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      398   define button B-WaitFramStop auto-end-key
      399        label "Стоп"
      400        size 10 by 1 tooltip "Остоновить процесс".
      401   define button B-viewProcInfo
      402        label "Информация"
      403        size 15 by 1 tooltip "Информация о процесс".
      404   define frame waitfram
      405     v-waitfram-action01 format "x(72)" no-label skip
      406     v-waitfram-action02 format "x(72)" no-label skip
      407     v-waitfram-action03 format "x(72)" no-label skip
      408     B-viewProcInfo
      409     B-WaitFramStop at row 4 col 30
      410     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      411     .
      412   define new global shared variable mBatchMode as logical no-undo init ?.
      413   define variable mFramBachModHandle as handle no-undo.
      414   mFramBachModHandle = frame waitfram:handle.
      415   define variable mFameOldVis as logical no-undo.
      416   define variable mVisCUrentVin as logical no-undo.
      417   if session:batch-mode
      418   then
      419      mBatchMode = yes.
      420   if mBatchMode = ? then do:
      421     mVisCUrentVin = current-window:visible.
      422     mFameOldVis = mFramBachModHandle:visible.
      423     mFramBachModHandle:visible  = yes.
      424     mBatchMode = mFramBachModHandle:visible ne yes.
      425     mFramBachModHandle:visible = mFameOldVis.
      426     current-window:visible = mVisCUrentVin.
      427   end.
      428    if  log-manager:logfile-name ne ?
      429     then DO:
      430         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      431         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      432         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      433     end.
      434   on choose of B-WaitFramStop in frame waitfram
      435   do:
      436     mWaitFramStop = yes.
      437     mWaitFramStopUser = yes.
      438   end.
      439   function waitfram-check-timeout returns logical():
      440      define variable vtime as int64 no-undo.
      441      if mWaitFramStopTimeOut
      442      then
      443         return yes.
      444      vtime = ( now - mWaitFramStartProc ) / 1000 .
      445      if     mWaitFramTimeOut ne ?
      446         and mWaitFramTimeOut ne 0
      447         and mWaitFramTimeOut lt vtime
      448      then do:
      449         mWaitFramStopTimeOut = yes.
      450      end.
      451      return mWaitFramStopTimeOut.
      452   end.
      453   procedure waitfram-hide :
      454     if not session:batch-mode
      455     then do
      456     on error undo, return error return-value
      457     :
      458       pause 0 before-hide .
      459       if not mBatchMode then
      460         hide frame waitfram .
      461     if     not mWaitFramView
      462        and mWaitProcEvent
      463     then
      464       process events .
      465     end.
      466   end procedure.
      467   procedure waitfram-show :
      468     define input  parameter p-message as character no-undo .
      469     define variable v-left-margin as integer   no-undo .
      470     if not session:batch-mode
      471     then do
      472     on error undo, return error return-value
      473     :
      474       if length(p-message) <= 70 then do:
      475         assign
      476           v-left-margin = integer((70 - length(p-message)) / 2)
      477         .
      478         assign
      479           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      480         .
      481         assign
      482           v-waitfram-action01 = " "
      483           v-waitfram-action02 = " "
      484                                    + fill(" ", v-left-margin)
      485                                    + p-message
      486           v-waitfram-action03 = " "
      487         .
      488       end.
      489       else do:
      490         define variable vRindex1 as integer no-undo.
      491         define variable vRindex2 as integer no-undo.
      492         vRindex1 = r-index(p-message," ",70).
      493         if vRindex1 = 0
      494         then
      495            vRindex1 = 70.
      496         if length(p-message)  <= vRindex1 + 70 then do:
      497           assign
      498             v-waitfram-action01 = " "
      499             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      500             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      501           .
      502         end.
      503         else do:
      504           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      505           if vRindex2 <= vRindex1
      506           then
      507              vRindex2 = vRindex1 + 70.
      508           assign
      509             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      510             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      511             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      512           .
      513         end.
      514       end.
      515       B-viewProcInfo:visible   in frame waitfram = no.
      516       B-viewProcInfo:sensitive in frame waitfram = no.
      517       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      518       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      519       if  (   mWaitFramView
      520          or  mWaitProcEvent)
      521          and not mBatchMode
      522       then
      523          display
      524             v-waitfram-action01 skip
      525             v-waitfram-action02 skip
      526             v-waitfram-action03 skip
      527          with frame waitfram .
      528       if     mWaitFramView
      529          then do:
      530             if     mWaitFramInterval ne ?
      531                and not mBatchMode
      532             then
      533                wait-for go of frame waitfram pause mWaitFramInterval.
      534          end.
      535          else
      536             if     mWaitProcEvent
      537                and not mBatchMode
      538             then
      539                process events .
      540     end.
      541   end procedure.
      542      procedure waitfram-show-this:
      543         define input  parameter iInterval as int64 no-undo.
      544         define variable vtime as int64 no-undo.
      545         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      546         mWaitFramInterval = iInterval.
      547         run waitfram-show (substitute("&1&2 &3&4" ,
      548                                       mWaitFramTextBeg ,
      549                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      550                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      551                                       mWaitFramTextEnd
      552                                      )
      553                           ).
      554      end.
      555      procedure WaitFramRunPause:
      556         define input  parameter iInterval as dec no-undo.
      557         define variable vStart  as datetime-tz no-undo.
      558         define variable vend    as datetime-tz no-undo.
      559         define variable vint as int64 no-undo.
      560         define variable vOk as logical no-undo.
      561         vStart = now.
      562         vend   = vStart.
      563         publish "WaitFramPause" (iInterval,output vOk).
      564         vend   =  now.
      565         vint = vend - vStart.
      566         vint = iInterval - vint / 1000.
      567         if     not mWaitFramStop
      568            and (   vint > 0
      569                 or (    not vOk
      570                     and iInterval eq ?
      571                     )
      572                 )
      573         then
      574            run waitfram-show-this (iInterval).
      575         vend   =  now.
      576         vint = vend - vStart.
      577         vint = iInterval - vint / 1000.
      578         if     not mWaitFramStop
      579            and vint > 0
      580         then do:
      581            run gbl/pause.p (vint * 1000).
      582         end.
      583         if iInterval ne ?
      584         then
      585            publish "WaitFramStop".
      586         waitfram-check-timeout().
      587      end.
      588      procedure WaitFramWaitFor:
      589         define input  parameter iInterval as dec no-undo.
      590         assign
      591            mWaitFramStartProc   = now
      592            mWaitFramStopUser    = no
      593            mWaitFramStopTimeOut = no
      594         .
      595         block-wait:
      596         do while not mWaitFramStop:
      597            run WaitFramRunPause (iInterval).
      598            if  waitfram-check-timeout()
      599            then do:
      600               leave block-wait.
      601            end.
      602         end.
      603         run waitfram-hide.
      604      end.
      605   procedure waitfram-join :
      606     define input  parameter p-line-1  as character no-undo .
      607     define input  parameter p-line-2  as character no-undo .
      608     define input  parameter p-line-3  as character no-undo .
      609     define output parameter p-message as character no-undo .
      610     do
      611     on error undo, return error return-value
      612     :
      613       assign
      614         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      615                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      616                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      617       .
      618     end.
      619   end procedure.
      620   function waitfram-join-function returns character
      621     (input p-line-1 as character
      622     ,input p-line-2 as character
      623     ,input p-line-3 as character
      624     ).
      625     define variable v-message as character no-undo .
      626     run waitfram-join in this-procedure
      627       (input  p-line-1
      628       ,input  p-line-2
      629       ,input  p-line-3
      630       ,output v-message
      631       ) .
      632     return v-message .
      633   end function .
      634   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   procedure gen-key-rec :
      636     define input  parameter p-tbl-name    as character no-undo.
      637     define input  parameter p-bh_tbl-name as handle    no-undo.
      638     define output parameter p-key-rec     as character no-undo.
      639     do
      640     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      641     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      642     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      643     :
      644       define variable fh               as handle    no-undo .
      645       define variable v-ok             as logical   no-undo .
      646       define variable v-inform         as character no-undo .
      647       define variable v-ind            as integer   no-undo .
      648       define variable v-idx-field-qnty as integer   no-undo .
      649       if p-tbl-name = ?
      650         or p-tbl-name = "":U
      651       then do:
      652         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      653       end.
      654       if not p-bh_tbl-name:available then do:
      655         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      656       end.
      657       assign
      658         p-key-rec = p-tbl-name
      659         v-inform  = p-bh_tbl-name:index-information(1)
      660         v-ind     = 2
      661       .
      662       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      663       on error undo, return error
      664       :
      665         assign
      666           v-inform = p-bh_tbl-name:index-information( v-ind )
      667           v-ind    = v-ind + 1
      668         .
      669       end.
      670       if v-inform = ?
      671         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      672         or entry( 3, v-inform, ",":U ) <> "1":U
      673       then do:
      674         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      675       end.
      676       else do:
      677         assign
      678           v-idx-field-qnty = num-entries( v-inform ) - 4
      679         .
      680         if v-idx-field-qnty < 2 then do:
      681           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      682         end.
      683         do v-ind = 1 to v-idx-field-qnty by 2
      684         on error undo, return error
      685         :
      686           assign
      687             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      688             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      689           .
      690         end.
      691       end.
      692       if p-key-rec = ? then do:
      693         assign
      694           p-key-rec = "":U
      695         .
      696         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      697       end.
      698     end.
      699     return.
      700   end procedure.
      701   procedure gen-where-keyr-tab :
      702     define input  parameter i-tableSerach as character no-undo.
      703     define input  parameter i-tablekey   as character  no-undo.
      704     define input  parameter p-key-rec    as character  no-undo.
      705     define input  parameter p-key-handle as handle     no-undo .
      706     define input  parameter p-db-name    as character  no-undo .
      707     define input  parameter p-tt-handle  as handle     no-undo .
      708     define output parameter o-Where      as character  no-undo.
      709     do
      710     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      711     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      712     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      713     :
      714       define variable v-full-tbl-name  as character no-undo .
      715       define variable bh_tbl-name      as handle    no-undo .
      716       define variable fh_key           as handle    no-undo .
      717       define variable fh_search        as handle    no-undo .
      718       define variable v-field-num      as integer   no-undo .
      719       define variable v-count-fld      as integer   no-undo .
      720       define variable v-inform         as character no-undo .
      721       define variable v-ind            as integer   no-undo .
      722       define variable v-idx-field-qnty as integer   no-undo .
      723       define variable v-field-name     as character no-undo .
      724       define variable v-field-val      as character no-undo .
      725       define variable v-word-link      as character no-undo .
      726       define variable vTable           as character no-undo.
      727       define variable bh_tbl-key       as handle    no-undo .
      728       assign
      729         p-key-rec = trim( p-key-rec )
      730       .
      731       if p-key-handle <> ? then do:
      732         if not valid-handle(p-key-handle)
      733            or p-key-handle:type <> "buffer"
      734         then do:
      735           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      736         end.
      737         if num-entries( p-key-rec, chr(3) ) > 1
      738           or p-key-rec = ?
      739           or p-key-rec = "":U
      740         then do:
      741           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      742         end.
      743       end.
      744       else do:
      745         if p-key-rec = ?
      746           or p-key-rec = "":U
      747         then do:
      748           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      749         end.
      750       end.
      751       assign
      752         vTable = entry( 1 , p-key-rec, chr(3) )
      753       .
      754       if p-tt-handle <> ?
      755         and ( not valid-handle(p-tt-handle)
      756               or p-tt-handle:type <> "buffer"
      757             )
      758       then do:
      759         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      760       end.
      761       if p-tt-handle = ? then do:
      762         assign
      763           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      764         .
      765         create buffer bh_tbl-name for table v-full-tbl-name .
      766       end.
      767       else do:
      768         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      769       end.
      770       assign
      771         v-inform = bh_tbl-name:index-information(1)
      772         v-ind    = 2
      773       .
      774       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      775       on error undo, return error
      776       :
      777         assign
      778           v-inform = bh_tbl-name:index-information( v-ind )
      779           v-ind    = v-ind + 1
      780         .
      781       end.
      782       if v-inform = ?
      783         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      784         or entry( 3, v-inform, ",":U ) <> "1":U
      785       then do:
      786         delete object bh_tbl-name no-error.
      787         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      788       end.
      789       assign
      790         v-idx-field-qnty = num-entries( v-inform ) - 4
      791       .
      792       if v-idx-field-qnty < 2 then do:
      793         delete object bh_tbl-name no-error.
      794         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      795       end.
      796       assign
      797         o-where     = "where":U
      798         v-word-link = "":U
      799         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      800         v-count-fld = 0
      801       .
      802       if i-tablekey ne "" and i-tablekey ne ?
      803       then do:
      804         assign
      805           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      806         .
      807         create buffer bh_tbl-key for table v-full-tbl-name .
      808       end.
      809       if i-tableSerach ne "" and i-tableSerach ne ?
      810       then do:
      811         delete object bh_tbl-name no-error.
      812         assign
      813           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      814         .
      815         create buffer bh_tbl-name for table v-full-tbl-name .
      816       end.
      817       block_where:
      818       do v-ind = 1 to v-idx-field-qnty by 2
      819       on error undo, return error
      820       :
      821         assign
      822           v-count-fld = v-count-fld + 1
      823         .
      824         if p-key-handle = ?
      825           and v-count-fld > v-field-num
      826         then do:
      827           leave block_where.
      828         end.
      829         define variable VfieldKeyTable as handle no-undo.
      830         assign
      831           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      832           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      833         .
      834         if     bh_tbl-key ne ?
      835         then do:
      836            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      837            if VfieldKeyTable eq ?
      838            then next block_where.
      839         end.
      840         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      841         then
      842            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      843         else
      844            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      845         if p-key-handle = ? then do:
      846           assign
      847             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      848           .
      849         end.
      850         else do:
      851           assign
      852             fh_key = p-key-handle:buffer-field( v-field-name )
      853           .
      854           if fh_key = ?
      855             or not valid-handle( fh_key )
      856           then do:
      857             delete object bh_tbl-name.
      858             if     bh_tbl-key ne ?
      859             then
      860                delete object bh_tbl-key.
      861             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      862           end.
      863           assign
      864             v-field-val = fh_key:buffer-value
      865           .
      866         end.
      867         if fh_search:data-type ="character":U then do:
      868           assign
      869             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      870             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      871             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      872             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      873             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      874             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      875             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      876             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      877             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      878             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      879             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      880             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      881             v-field-val = substitute( '"&1"', v-field-val )
      882           .
      883         end.
      884         assign
      885           o-where = substitute( "&1 &2", o-where, v-field-val )
      886         .
      887         if v-word-link = "":U then do:
      888           assign
      889             v-word-link = "and":U
      890           .
      891         end.
      892       end.
      893       delete object bh_tbl-name.
      894       if     bh_tbl-key ne ?
      895       then
      896          delete object bh_tbl-key.
      897       if p-key-handle = ?
      898         and v-count-fld <> v-field-num
      899       then do:
      900         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      901       end.
      902     end.
      903   end procedure.
      904   procedure gen-hn-keyr-tab :
      905     define input  parameter i-tableSerach as character no-undo.
      906     define input  parameter i-tablekey   as character no-undo.
      907     define input  parameter p-key-rec    as character no-undo.
      908     define input  parameter p-key-handle as handle    no-undo .
      909     define input  parameter p-db-name    as character no-undo .
      910     define input  parameter p-tt-handle  as handle    no-undo .
      911     define input  parameter p-stts-lock  as integer   no-undo .
      912     define output parameter o-hn         as handle    no-undo.
      913     define variable v-full-tbl-name as character no-undo.
      914     define variable v-where         as character no-undo.
      915     define variable bh_tbl-name     as handle    no-undo.
      916     define variable vTable          as character no-undo.
      917     do
      918     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      919     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      920     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      921         run gen-where-keyr-tab(i-tableSerach,
      922                                i-tablekey,
      923                                p-key-rec,
      924                                p-key-handle,
      925                                p-db-name,
      926                                p-tt-handle,
      927                                output v-where).
      928         if i-tableSerach ne "" and i-tableSerach ne ?
      929         then do:
      930            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      931            create buffer bh_tbl-name for table v-full-tbl-name .
      932         end.
      933         else do:
      934            if p-tt-handle = ? then do:
      935               assign
      936                  vTable = entry( 1 , p-key-rec, chr(3) )
      937               .
      938               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      939               create buffer bh_tbl-name for table v-full-tbl-name .
      940            end.
      941            else do:
      942               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      943            end.
      944         end.
      945         if p-tt-handle = ? then do:
      946            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      947         end.
      948         else do:
      949            bh_tbl-name:find-first( v-where ) no-error .
      950         end.
      951         o-hn = bh_tbl-name.
      952      end.
      953   end procedure.
      954   procedure gen-hn-keyr :
      955     define input  parameter p-key-rec    as character no-undo.
      956     define input  parameter p-key-handle as handle    no-undo .
      957     define input  parameter p-db-name    as character no-undo .
      958     define input  parameter p-tt-handle  as handle    no-undo .
      959     define input  parameter p-stts-lock  as integer   no-undo .
      960     define output parameter o-hn         as handle    no-undo.
      961     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      962   end.
      963   procedure gen-row-keyr :
      964     define input  parameter p-key-rec    as character no-undo.
      965     define input  parameter p-key-handle as handle    no-undo .
      966     define input  parameter p-db-name    as character no-undo .
      967     define input  parameter p-tt-handle  as handle    no-undo .
      968     define input  parameter p-stts-lock  as integer   no-undo .
      969     define output parameter p-tbl-row    as rowid     no-undo.
      970     define output parameter p-tbl-name   as character no-undo.
      971     define variable vHn as handle no-undo.
      972       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      973       p-tbl-row = if vHn:available then vHn:rowid else ?.
      974       p-tbl-name =  vHn:table.
      975       delete object vHn no-error.
      976     if p-tbl-row = ? then do:
      977       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      978     end.
      979     else do:
      980       return.
      981     end.
      982   end procedure.
      983   procedure gen-key-fv :
      984     define input  parameter p-key-rec    as character no-undo .
      985     define output parameter p-field-list as character no-undo .
      986     define output parameter p-value-list as character no-undo.
      987     do
      988     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      989     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      990     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      991     :
      992       define variable v-full-tbl-name  as character no-undo .
      993       define variable bh_tbl-name      as handle    no-undo .
      994       define variable v-tbl-name       as character no-undo .
      995       define variable v-field-num      as integer   no-undo .
      996       define variable v-count-fld      as integer   no-undo .
      997       define variable v-inform         as character no-undo .
      998       define variable v-ind            as integer   no-undo .
      999       define variable v-idx-field-qnty as integer   no-undo .
     1000       define variable v-delim-key      as character no-undo .
     1001       if p-key-rec = ?
     1002         or p-key-rec = "":U
     1003       then do:
     1004         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1005       end.
     1006       assign
     1007         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1008         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1009       .
     1010       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1011       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1012       assign
     1013         v-inform = bh_tbl-name:index-information(1)
     1014         v-ind    = 2
     1015       .
     1016       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1017       on error undo, return error
     1018       :
     1019         assign
     1020           v-inform = bh_tbl-name:index-information( v-ind )
     1021           v-ind    = v-ind + 1
     1022         .
     1023       end.
     1024       if v-inform = ?
     1025         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1026         or entry( 3, v-inform, ",":U ) <> "1":U
     1027       then do:
     1028         delete object bh_tbl-name no-error.
     1029         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1030       end.
     1031       assign
     1032         v-idx-field-qnty = num-entries( v-inform ) - 4
     1033       .
     1034       if v-idx-field-qnty < 2 then do:
     1035         delete object bh_tbl-name no-error.
     1036         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1037       end.
     1038       assign
     1039         p-field-list = "":U
     1040         p-value-list = "":U
     1041         v-delim-key  = "":U
     1042         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1043         v-count-fld  = 0
     1044       .
     1045       block_where:
     1046       do v-ind = 1 to v-idx-field-qnty by 2
     1047       on error undo, return error
     1048       :
     1049         assign
     1050           v-count-fld = v-count-fld + 1
     1051         .
     1052         if v-count-fld > v-field-num then do:
     1053           leave block_where.
     1054         end.
     1055         assign
     1056           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1057           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1058         .
     1059         if v-ind = 1 then do:
     1060           assign
     1061             v-delim-key = chr(3)
     1062           .
     1063         end.
     1064       end.
     1065       delete object bh_tbl-name.
     1066       if v-count-fld <> v-field-num then do:
     1067         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1068       end.
     1069     end.
     1070   end procedure.
     1071   procedure gen-key-field :
     1072     define input  parameter p-table      as character no-undo .
     1073     define output parameter p-field-list as character no-undo .
     1074     do
     1075     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1076     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1077     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1078     :
     1079       define variable v-full-tbl-name  as character no-undo .
     1080       define variable bh_tbl-name      as handle    no-undo .
     1081       define variable v-tbl-name       as character no-undo .
     1082       define variable v-field-num      as integer   no-undo .
     1083       define variable v-count-fld      as integer   no-undo .
     1084       define variable v-inform         as character no-undo .
     1085       define variable v-ind            as integer   no-undo .
     1086       define variable v-idx-field-qnty as integer   no-undo .
     1087       define variable v-delim-key      as character no-undo .
     1088       if p-table = ?
     1089         or p-table = "":U
     1090       then do:
     1091         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1092       end.
     1093       assign
     1094         v-tbl-name      = p-table
     1095         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1096       .
     1097       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1098       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1099       assign
     1100         v-inform = bh_tbl-name:index-information(1)
     1101         v-ind    = 2
     1102       .
     1103       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1104       on error undo, return error
     1105       :
     1106         assign
     1107           v-inform = bh_tbl-name:index-information( v-ind )
     1108           v-ind    = v-ind + 1
     1109         .
     1110       end.
     1111       if v-inform = ?
     1112         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1113         or entry( 3, v-inform, ",":U ) <> "1":U
     1114       then do:
     1115         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1116       end.
     1117       assign
     1118         v-idx-field-qnty = num-entries( v-inform ) - 4
     1119       .
     1120       if v-idx-field-qnty < 2 then do:
     1121         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1122       end.
     1123       assign
     1124         p-field-list = "":U
     1125         v-delim-key  = "":U
     1126         v-count-fld  = 0
     1127       .
     1128       block_where:
     1129       do v-ind = 1 to v-idx-field-qnty by 2
     1130       on error undo, return error
     1131       :
     1132         assign
     1133           v-count-fld = v-count-fld + 1
     1134         .
     1135         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1136         if v-ind = 1 then do:
     1137           assign
     1138             v-delim-key = chr(3)
     1139           .
     1140         end.
     1141       end.
     1142       delete object bh_tbl-name.
     1143     end.
     1144   end procedure.
     1145   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1146   procedure progs-name :
     1147     define input  parameter p-action-code         as character no-undo .
     1148     define output parameter p-main-prog-name      as character no-undo .
     1149     define output parameter p-list-db-proc-name   as character no-undo .
     1150     define output parameter p-commit-proc-name    as character no-undo .
     1151     define output parameter p-execution-proc-name as character no-undo .
     1152     define output parameter p-recover-proc-name   as character no-undo .
     1153     define output parameter p-after-proc-name     as character no-undo .
     1154     do
     1155     on error undo, return error
     1156     :
     1157       case p-action-code :
     1158               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
     1159               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
     1160               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
     1161               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
     1162               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
     1163               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
     1164               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
     1165               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
     1166               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
     1167               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
     1168               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
     1169               otherwise do:
     1170           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info6, p-action-code ).
     1171         end.
     1172       end case.
     1173     end.
     1174     return.
     1175   end procedure.
     1176   procedure progs-title :
     1177     define input  parameter p-action-code         as character no-undo .
     1178     define output parameter p-action-title      as character no-undo .
     1179     do
     1180     on error undo, return error
     1181     :
     1182       case p-action-code :
     1183               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     1184               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     1185               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     1186               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     1187               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     1188               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     1189               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     1190               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     1191               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     1192               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     1193               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     1194               otherwise do:
     1195           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info6, p-action-code ).
     1196         end.
     1197       end case.
     1198     end.
     1199     return.
     1200   end procedure.
     1201   FUNCTION progs-title-function returns character(
     1202      input  p-action-code         as character):
     1203   define variable p-action-title      as character no-undo .
     1204     do
     1205     on error undo, return error
     1206     :
     1207       case p-action-code :
     1208               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     1209               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     1210               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     1211               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     1212               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     1213               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     1214               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     1215               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     1216               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     1217               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     1218               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     1219               otherwise do:
     1220           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info6, p-action-code ).
     1221         end.
     1222       end case.
     1223     end.
     1224     return p-action-title.
     1225   end FUNCTION.
     1226   procedure get-row-keyr-string :
     1227    define input  parameter p-key-rec  as character no-undo.
     1228    define output parameter p-tbl-title as character no-undo.
     1229    define output parameter p-rec-string  as character no-undo.
     1230     do
     1231     on error undo, return error
     1232     :
     1233       define variable v-full-tbl-name as character no-undo .
     1234       define variable bh_tbl-name     as handle    no-undo .
     1235       define variable fh              as handle    no-undo .
     1236       define variable v-ok            as logical   no-undo .
     1237       define variable v-field-num     as integer   no-undo .
     1238       define variable v-count-fld     as integer   no-undo .
     1239       define variable v-tbl-name as character no-undo.
     1240       if p-key-rec = ?
     1241         or p-key-rec = "":U
     1242       then do:
     1243         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1244       end.
     1245       assign
     1246         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1247         v-full-tbl-name = "ub.":U + v-tbl-name
     1248         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
     1249         p-rec-string         = "":U
     1250         v-count-fld     = 0
     1251       .
     1252       find ub._file
     1253         where ub._file._file-name = v-tbl-name
     1254         no-error.
     1255       if not available ub._file then do:
     1256         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info6, v-tbl-name ).
     1257       end.
     1258       assign
     1259       p-tbl-title = ub._file._file-label
     1260       .
     1261       find ub._index
     1262         where recid( ub._index  ) = ub._file._prime-index
     1263         no-error.
     1264       if not available ub._index
     1265         or LC( ub._index._index-name ) = "default":U
     1266       then do:
     1267         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1268       end.
     1269       block_where :
     1270       for each ub._index-field of ub._index  ,
     1271           each ub._field of _index-field
     1272           break by _index-seq
     1273       on error undo, return error
     1274       :
     1275         assign
     1276           v-count-fld = v-count-fld + 1
     1277         .
     1278         if v-count-fld > v-field-num then do:
     1279           leave block_where.
     1280         end.
     1281         if p-rec-string = "":U then do:
     1282           assign
     1283             p-rec-string = "":U
     1284           .
     1285         end.
     1286         else do:
     1287           assign
     1288             p-rec-string = p-rec-string + chr(32) + chr(44)
     1289           .
     1290         end.
     1291         assign
     1292           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     1293         .
     1294       end.
     1295       if v-count-fld <> v-field-num then do:
     1296         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
     1297       end.
     1298     end.
     1299     return.
     1300   end procedure.
     1301   FUNCTION uniq-key-rec-string-f returns character(
     1302      input  p-uniq-key-rec         as character):
     1303   define variable v-tbl-title as character no-undo .
     1304   define variable v-rec-string as character no-undo .
     1305     do
     1306     on error undo, return error
     1307     :
     1308       run get-row-keyr-string in this-procedure (
     1309                                                 input p-uniq-key-rec
     1310                                                 ,output v-tbl-title
     1311                                                 ,output v-rec-string).
     1312       assign
     1313       v-rec-string = (if v-tbl-title <> ? and
     1314                       v-tbl-title <> "":U
     1315                       then (v-tbl-title + ":")
     1316                      else "":U) + chr(32) + v-rec-string
     1317       .
     1318     end.
     1319     return v-rec-string.
     1320   end FUNCTION.
     1321   procedure create_db-rec_route :
     1322     define input parameter p1-uniq-key-rec as character no-undo .
     1323     define input parameter p1-action       as character no-undo .
     1324     define input parameter p1-operation    as character no-undo .
     1325     define input parameter p1-send-db-list as character no-undo .
     1326     define input parameter p1-db-init      as integer   no-undo .
     1327     define input parameter p1-parameters   as character no-undo .
     1328     define input parameter p1-answer-code  as integer   no-undo .
     1329     define input parameter p1-answer-msg   as character no-undo .
     1330     do
     1331     on error undo, return error
     1332     :
     1333       define variable v-command     as character no-undo .
     1334       define variable v-ind         as integer   no-undo .
     1335       define variable v-num-entries as integer   no-undo .
     1336       define variable v-curr-db     as integer   no-undo .
     1337       define variable v-db-for-send as character no-undo .
     1338       define variable v-db-num      as integer   no-undo .
     1339       define variable v-db-num-char as character no-undo .
     1340       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1341       find first buf_sys-ctrl no-lock .
     1342       assign
     1343         v-curr-db     = buf_sys-ctrl.db-num
     1344         v-db-for-send = "":U
     1345       .
     1346       if v-curr-db = 0 then do:
     1347         if p1-answer-code >= 0 then do:
     1348           if v-curr-db <> p1-db-init then do:
     1349             assign
     1350               v-db-for-send = string( p1-db-init )
     1351             .
     1352           end.
     1353         end.
     1354         else do:
     1355           assign
     1356             v-num-entries = num-entries( p1-send-db-list, chr(44) )
     1357           .
     1358           do v-ind = 1 to v-num-entries:
     1359             assign
     1360               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
     1361               v-db-num      = integer( v-db-num-char )
     1362             .
     1363             if v-db-num <> v-curr-db
     1364               and v-db-num <> p1-db-init
     1365             then do:
     1366               if v-db-for-send = "":U then do:
     1367                 assign
     1368                   v-db-for-send = v-db-num-char
     1369                 .
     1370               end.
     1371               else do:
     1372                 assign
     1373                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     1374                 .
     1375               end.
     1376             end.
     1377           end.
     1378         end.
     1379       end.
     1380       else do:
     1381         assign
     1382           v-db-for-send = "0":U
     1383         .
     1384       end.
     1385       if v-db-for-send <> "":U then do:
     1386         assign
     1387           v-command = "command":U + chr(1)
     1388                       + "two-commit":U + chr(1)
     1389                       + p1-action + chr(1)
     1390                       + p1-operation + chr(1)
     1391                       + p1-uniq-key-rec + chr(1)
     1392                       + string( p1-db-init ) + chr(1)
     1393                       + p1-parameters + chr(1)
     1394                       + string( p1-answer-code ) + chr(1)
     1395                       + p1-answer-msg
     1396         .
     1397         run nws/cr-route.p ( input 'send-cmd':U
     1398                       ,input v-command
     1399                       ,input ?
     1400                       ,input v-db-for-send
     1401                       ) no-error .
     1402         if error-status :error then do:
     1403           return error return-value.
     1404         end.
     1405       end.
     1406     end.
     1407     return.
     1408   end procedure.
     1409   procedure create_msg_route :
     1410     define input parameter p2-send-db-list as character no-undo .
     1411     define input parameter p2-msg          as character no-undo .
     1412     do
     1413     on error undo, return error
     1414     :
     1415       define variable v-msg-command as character no-undo .
     1416       define variable v-ind         as integer   no-undo .
     1417       define variable v-num-entries as integer   no-undo .
     1418       define variable v-curr-db     as integer   no-undo .
     1419       define variable v-db-for-send as character no-undo .
     1420       define variable v-db-num      as integer   no-undo .
     1421       define variable v-db-num-char as character no-undo .
     1422       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1423       find first buf_sys-ctrl no-lock .
     1424       assign
     1425         v-curr-db     = buf_sys-ctrl.db-num
     1426         v-db-for-send = "":U
     1427       .
     1428       if v-curr-db = 0 then do:
     1429         assign
     1430           v-num-entries = num-entries( p2-send-db-list, chr(44) )
     1431         .
     1432         do v-ind = 1 to v-num-entries:
     1433           assign
     1434             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
     1435             v-db-num      = integer( v-db-num-char )
     1436           .
     1437           if v-db-num <> v-curr-db then do:
     1438             if v-db-for-send = "":U then do:
     1439               assign
     1440                 v-db-for-send = v-db-num-char
     1441               .
     1442             end.
     1443             else do:
     1444               assign
     1445                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     1446               .
     1447             end.
     1448           end.
     1449         end.
     1450       end.
     1451       else do:
     1452         assign
     1453           v-db-for-send = "0":U
     1454         .
     1455       end.
     1456       if v-db-for-send <> "":U then do:
     1457         assign
     1458           v-msg-command = "command":U + chr(1)
     1459                           + "message-to-log":U + chr(1)
     1460                           + p2-msg
     1461         .
     1462         run nws/cr-route.p ( input 'send-cmd':U
     1463                       ,input v-msg-command
     1464                       ,input ?
     1465                       ,input v-db-for-send
     1466                       ) no-error .
     1467         if error-status :error then do:
     1468           return error substitute( "&1&2&3"
     1469                                     , return-value
     1470                                     , chr(10)
     1471                                     , error-status :get-message(1)
     1472                                   ).
     1473         end.
     1474       end.
     1475     end.
     1476     return.
     1477   end procedure.
     1478   function get-send-db-list returns character
     1479     ( input p-curr-db     as integer
     1480      ,input p-all-db-list as character
     1481     )
     1482   :
     1483     define variable v-send-db-list as character no-undo .
     1484     if p-curr-db = 0 then do:
     1485       assign
     1486         v-send-db-list = p-all-db-list
     1487       .
     1488     end.
     1489     else do:
     1490       assign
     1491         v-send-db-list = string(p-curr-db)
     1492       .
     1493     end.
     1494     return v-send-db-list .
     1495   end function .
     1496   define variable v-log-file as character no-undo init "pren-art.log".
     1497   define variable v-not-two-commit as logical no-undo .
     1498   define buffer buf_db for ub.db .
     1499   define stream LOgStream.
     1500   DEFINE BUTTON B-Help
     1501        LABEL "Помо&щь"
     1502        SIZE 3 BY 1
     1503        BGCOLOR 8 .
     1504   DEFINE BUTTON B-list
     1505        LABEL "&Список"
     1506        SIZE 10 BY 1.
     1507   DEFINE BUTTON b-quit AUTO-END-KEY
     1508        LABEL "&Выход"
     1509        SIZE 10 BY 1
     1510        BGCOLOR 8 .
     1511   DEFINE BUTTON B-replace
     1512        LABEL "&Заменить"
     1513        SIZE 10 BY 1
     1514        BGCOLOR 8 .
     1515   DEFINE BUTTON button-prod
     1516        IMAGE-UP FILE "btn-down-arrow":U
     1517        IMAGE-DOWN FILE "btn-down-arrow":U
     1518        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1519        LABEL "button-prod"
     1520        SIZE 3 BY .87.
     1521   DEFINE VARIABLE f-log-file AS CHARACTER FORMAT "X(256)":U
     1522        LABEL "Log-файл"
     1523        VIEW-AS FILL-IN
     1524        SIZE 68.4 BY 1
     1525        BGCOLOR 8  NO-UNDO.
     1526   DEFINE VARIABLE T-mes AS LOGICAL INITIAL no
     1527        LABEL "Выводить сообщения на экран"
     1528        VIEW-AS TOGGLE-BOX
     1529        SIZE 44.8 BY .8 NO-UNDO.
     1530   DEFINE QUERY Dialog-Frame FOR
     1531         cli_prod SCROLLING.
     1532   DEFINE FRAME Dialog-Frame
     1533        b-quit AT ROW 1 COL 1
     1534        B-replace AT ROW 1 COL 11
     1535        B-list AT ROW 1 COL 31
     1536        B-Help AT ROW 1 COL 71
     1537        ub.clients.obj-type AT ROW 2.87 COL 22.5 COLON-ALIGNED NO-LABEL
     1538             VIEW-AS FILL-IN
     1539             SIZE 6.9 BY 1
     1540        ub.clients.obj-code AT ROW 2.93 COL 30.4 COLON-ALIGNED NO-LABEL
     1541             VIEW-AS FILL-IN
     1542             SIZE 14.6 BY 1
     1543        button-prod AT ROW 3 COL 51.6
     1544        T-mes AT ROW 5.67 COL 2.8
     1545        f-log-file AT ROW 6.97 COL 2.4
     1546        ub.clients.obj-name AT ROW 4.47 COL 2.5 NO-LABEL
     1547              VIEW-AS TEXT
     1548             SIZE 52.4 BY .67
     1549        "Выбор производителя" VIEW-AS TEXT
     1550             SIZE 20.3 BY .87 AT ROW 3.03 COL 2.6
     1551             FGCOLOR 4
     1552        SPACE(59.84) SKIP(4.34)
     1553       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1554            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1555            TITLE "Смена производителя по списку товаров"
     1556            DEFAULT-BUTTON B-replace CANCEL-BUTTON b-quit.
     1557   ASSIGN
     1558          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1559          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1560   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1561   DO:
     1562     APPLY "END-ERROR":U TO SELF.
     1563   END.
     1564   ON CHOOSE OF B-list IN FRAME Dialog-Frame
     1565   DO:
     1566      run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
     1567   END.
     1568   ON CHOOSE OF B-replace IN FRAME Dialog-Frame
     1569   DO:
     1570     run proc-exit in this-procedure no-error.
     1571     if error-status:error then return no-apply.
     1572   END.
     1573   ON CHOOSE OF button-prod IN FRAME Dialog-Frame
     1574   DO:
     1575   define variable cli-list as character no-undo.
     1576       assign
     1577       cli-list = ""
     1578       .
     1579       run ref/cli-all.w ( input parparentproc
     1580                     , "b-sel"
     1581                     , 'про':U
     1582                     , 'все':U
     1583                     ,  'текущие':U
     1584                     , ?
     1585                     , ",,,,,,NO,,"
     1586                     , ?
     1587                     , output cli-list ) .
     1588       if cli-list <> ""
     1589       then do:
     1590           FIND FIRST ub.clients no-lock WHERE recid( ub.clients ) = int( cli-list )  .
     1591           display
     1592           ub.clients.obj-name
     1593           ub.clients.obj-type
     1594           ub.clients.obj-code
     1595           with frame Dialog-Frame
     1596           .
     1597       end.
     1598       else do:
     1599           assign
     1600           ub.clients.obj-name:screen-value = ""
     1601           ub.clients.obj-type:screen-value = "":U
     1602           ub.clients.obj-code:screen-value = "":U
     1603           .
     1604       end.
     1605   END.
     1606   ON LEAVE OF ub.clients.obj-code IN FRAME Dialog-Frame
     1607   DO:
     1608         FIND ub.clients WHERE ub.clients.obj-type = input frame Dialog-Frame clients.obj-type
     1609                                   and ub.clients.obj-code = input frame Dialog-Frame clients.obj-code
     1610                                   no-lock no-error.
     1611       if available ub.clients then
     1612           DISPLAY ub.clients.obj-name with frame Dialog-Frame.
     1613   END.
     1614   ON RETURN OF ub.clients.obj-code IN FRAME Dialog-Frame
     1615   DO:
     1616   define variable cli-list as character no-undo.
     1617       FIND ub.clients WHERE ub.clients.obj-type = input frame Dialog-Frame clients.obj-type
     1618                                   and ub.clients.obj-code = input frame Dialog-Frame clients.obj-code
     1619                                   no-lock no-error.
     1620       if available ub.clients then   do:
     1621               DISPLAY ub.clients.obj-name with frame Dialog-Frame.
     1622               return no-apply.
     1623           end.
     1624       else   do:
     1625               assign
     1626                cli-list = ""
     1627                .
     1628               run ref/cli-all.w (input parparentproc
     1629                             , "b-sel"
     1630                             , 'про':U
     1631                             , 'все':U
     1632                             , 'текущие':U
     1633                             , ?
     1634                             , ",,,,,,NO,,"
     1635                             , ?
     1636                             , output cli-list) .
     1637               if cli-list = "" then   do:
     1638                       apply "entry" to ub.clients.obj-code in frame Dialog-Frame.
     1639                       return no-apply.
     1640                   end.
     1641               FIND ub.clients WHERE recid (ub.clients) = integer(cli-list) NO-LOCK .
     1642               DISPLAY ub.clients.obj-type ub.clients.obj-code ub.clients.obj-name with frame Dialog-Frame.
     1643               return no-apply.
     1644           end.
     1645   END.
     1646   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1647   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1648   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1649   on help of frame Dialog-Frame
     1650   do:
     1651     run gbl/app_help.p
     1652       (input this-procedure :file-name
     1653       ,input ''
     1654       ,input ?
     1655       ) no-error.
     1656     if error-status :error then do:
     1657       message
     1658         "Ошибка при вызове помощи"
     1659         error-status :get-message(1)
     1660         view-as alert-box .
     1661     end.
     1662   end.
     1663   run minbtn-set in this-procedure .
     1664   on choose of b-help in frame Dialog-Frame
     1665   do:
     1666     apply "help":u to frame Dialog-Frame .
     1667   end.
     1668   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   procedure minbtn-set :
     1670       do
     1671           on error undo, return error return-value
     1672           :
     1673           define variable ii              as integer       no-undo .
     1674           define variable fh              as widget-handle no-undo .
     1675           define variable hh              as widget-handle no-undo .
     1676           define variable v-h             as handle        extent 4 no-undo .
     1677           define variable v-name-button   as character     no-undo .
     1678           define variable v-help-old-x    as decimal       no-undo .
     1679           define variable v-help-old-y    as decimal       no-undo .
     1680           define variable v-help-old-size as decimal       no-undo .
     1681           define variable v-frame-width   as decimal       no-undo .
     1682           define variable jj              as integer       no-undo .
     1683           do
     1684               on error undo, return error
     1685               :
     1686               assign
     1687                   v-frame-width = frame Dialog-Frame:width - 0.3
     1688                   fh            = frame Dialog-Frame:first-child
     1689                   hh            = fh:first-child
     1690                   ii            = 1
     1691                   .
     1692               do while valid-handle(hh):
     1693                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1694                   do:
     1695                       case lc(hh:name) :
     1696                           when "b-help" then
     1697                               do:
     1698                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1699                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1700                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1701                                   hh:TOOLTIP = "Помощь" .
     1702                                   v-help-old-x = hh:column .
     1703                                   v-help-old-y = hh:row    .
     1704                                   v-help-old-size = hh:width .
     1705                                   hh:width-chars = 2.5 .
     1706                               end.
     1707                           when "b-print" then
     1708                               do:
     1709                                   hh:load-image("cmp/b-print.bmp":u) .
     1710                                   hh:TOOLTIP = "Печать" .
     1711                                   v-h[ii] = hh:handle .
     1712                                   ii = ii + 1 .
     1713                                   hh:width-chars = 3 .
     1714                               end.
     1715                           when "b-history" or
     1716                           when "b-hist" then
     1717                               do:
     1718                                   hh:load-image("cmp/b-hist.bmp":u) .
     1719                                   hh:TOOLTIP = "История" .
     1720                                   v-h[ii] = hh:handle .
     1721                                   ii = ii + 1 .
     1722                                   hh:width-chars = 3 .
     1723                               end.
     1724                           when "b-sch" then
     1725                               do:
     1726                                   hh:load-image("cmp/b-sch.bmp":u) .
     1727                                   hh:TOOLTIP = "Установка Фильтра" .
     1728                                   v-h[ii] = hh:handle .
     1729                                   ii = ii + 1 .
     1730                                   hh:width-chars = 3 .
     1731                               end.
     1732                           when "b-hist-user" then
     1733                               do:
     1734                                   hh:load-image("cmp/b-hist.bmp":u) .
     1735                                   hh:TOOLTIP = "История пользователя" .
     1736                                   ii = ii + 1 .
     1737                               end.
     1738                       end case.
     1739                   end.
     1740                   hh = hh:next-sibling.
     1741               end.
     1742               b-help:column = v-frame-width - b-help:width-chars.
     1743               jj = 0.
     1744               repeat ii = 4 to 1 by -1 :
     1745                   if valid-handle (v-h[ii] ) then
     1746                   do:
     1747                       jj  = jj + 1 .
     1748                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1749                       v-h[ii]:row    = v-help-old-y .
     1750                   end.
     1751               end.
     1752           end.
     1753       end.
     1754   end procedure.
     1755   MAIN-BLOCK:
     1756   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1757      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1758   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1759     run mainmenu_getcntxt in parparentproc
     1760       (output v-cntxt-db-num
     1761       ,output v-cntxt-userid
     1762       ,output v-cntxt-level
     1763       ,output v-cntxt-host-code-obj
     1764       ,output v-cntxt-obj-type
     1765       ,output v-cntxt-obj-code
     1766       ,output v-cntxt-db-num-obj
     1767       ,output v-cntxt-is-admin
     1768       ) .
     1769     RUN MYenable.
     1770     find first buf_db no-lock
     1771       where buf_db.db-num > 0
     1772       no-error .
     1773     if available buf_db then do:
     1774       assign
     1775         v-not-two-commit = false
     1776       .
     1777     end.
     1778     else do:
     1779       assign
     1780         v-not-two-commit = true
     1781       .
     1782     end.
     1783     WAIT-FOR GO OF FRAME Dialog-Frame.
     1784   END.
     1785   RUN disable_UI.
     1786   PROCEDURE disable_UI :
     1787     HIDE FRAME Dialog-Frame.
     1788   END PROCEDURE.
     1789   PROCEDURE enable_UI :
     1790     OPEN QUERY Dialog-Frame FOR EACH cli_prod SHARE-LOCK.
     1791     GET FIRST Dialog-Frame.
     1792     DISPLAY T-mes f-log-file
     1793         WITH FRAME Dialog-Frame.
     1794     IF AVAILABLE ub.clients THEN
     1795       DISPLAY ub.clients.obj-type ub.clients.obj-code ub.clients.obj-name
     1796         WITH FRAME Dialog-Frame.
     1797     ENABLE b-quit B-replace B-list B-Help ub.clients.obj-type ub.clients.obj-code
     1798            button-prod T-mes ub.clients.obj-name
     1799         WITH FRAME Dialog-Frame.
     1800     VIEW FRAME Dialog-Frame.
     1801   END PROCEDURE.
     1802   PROCEDURE err-msg :
     1803   define input parameter p-msg      as character no-undo .
     1804   define input parameter p-silence  as logical no-undo .
     1805   define input parameter p-err-flag as logical   no-undo .
     1806     do
     1807     on error undo, return error
     1808     :
     1809       if p-silence = false then do:
     1810         if p-err-flag = true then do:
     1811           message
     1812             p-msg
     1813             view-as alert-box error .
     1814         end.
     1815         else do:
     1816           message
     1817             p-msg
     1818             view-as alert-box information .
     1819         end.
     1820       end.
     1821       if v-log-file <> "":U then do:
     1822         output stream Logstream to value(v-log-file) append.
     1823         put stream LogStream unformatted
     1824         p-msg skip.
     1825         output stream Logstream close.
     1826       end.
     1827     end.
     1828   END PROCEDURE.
     1829   PROCEDURE Myenable :
     1830       DISPLAY
     1831       'орг':U @ ub.clients.obj-type
     1832         WITH FRAME Dialog-Frame.
     1833     ENABLE b-quit B-replace B-list B-Help button-prod ub.clients.obj-type
     1834            ub.clients.obj-code ub.clients.obj-name T-mes
     1835         WITH FRAME Dialog-Frame.
     1836     VIEW FRAME Dialog-Frame.
     1837   END PROCEDURE.
     1838   PROCEDURE proc-exit :
     1839   define variable loc#log as logical no-undo.
     1840   define variable v-ok as integer no-undo.
     1841   define variable v-ii as integer .
     1842   define variable v-err as integer .
     1843   define variable v-msg as character no-undo.
     1844   define variable v-err-mes as character no-undo.
     1845   define buffer buf_goods for ub.goods .
     1846   define variable v-key-rec as character no-undo .
     1847   define variable v-param   as character no-undo .
     1848   assign
     1849   frame Dialog-Frame
     1850   T-mes.
     1851   if not can-find(first gds-list) then do:
     1852       message
     1853       "Вы не выбрали ни одного товара"
     1854       view-as alert-box.
     1855       return error.
     1856   end.
     1857   find first ub.clients no-lock where
     1858   ub.clients.obj-type = input frame Dialog-Frame clients.obj-type
     1859   AND ub.clients.obj-code = input frame Dialog-Frame clients.obj-code no-error.
     1860   if not available ub.clients then do:
     1861       message
     1862       "Вы не выбрали производителя"
     1863       view-as alert-box.
     1864       return error.
     1865   end.
     1866   if ub.clients.obj-type = 'маг':U or ub.clients.obj-type = 'скл':U then do:
     1867       message
     1868       "Склад/магазин не может быть производителем !"
     1869       view-as alert-box.
     1870       return error.
     1871    end.
     1872   message
     1873   "Для всех товаров выбранного Вами списка будет проведена замена производителя на" skip
     1874   ub.clients.obj-type ub.clients.obj-code ub.clients.obj-name skip
     1875   "для больших списков это процедура может занять много времени" skip
     1876   "Продолжить?"
     1877   view-as alert-box QUESTION buttons YES-NO update loc#log.
     1878   if not loc#log then return error.
     1879   run waitfram-show in this-procedure ("Ждите").
     1880   run set-file-title in this-procedure (v-log-file) .
     1881   for each gds-list
     1882   on error undo, next
     1883   on stop undo, next
     1884   :
     1885       assign
     1886       v-ii = v-ii + 1
     1887       .
     1888       if gds-list.prod-type = clients.obj-type and
     1889       gds-list.prod-code = clients.obj-code  then do:
     1890         assign
     1891         v-msg = "Товар" + chr(32) + string(gds-list.gds-code) + chr(32) +
     1892         "артикул" + chr(32) + gds-list.artic + chr(32) +
     1893         gds-list.prod-type + string(gds-list.prod-code) + chr(32) + "не требует замены производителя на" + chr(32) +
     1894         clients.obj-type + string(clients.obj-code) + chr(10) + "уже имеет производителя" + chr(32) +
     1895         clients.obj-type + string(clients.obj-code)
     1896         .
     1897         run err-msg in this-procedure (input (v-msg), input not t-mes, input false).
     1898         next.
     1899       end.
     1900       assign
     1901       v-err-mes = "":U.
     1902       if v-not-two-commit = false then do:
     1903         find first buf_goods no-lock
     1904           where buf_goods.artic     = gds-list.artic
     1905             and buf_goods.prod-type = gds-list.prod-type
     1906             and buf_goods.prod-code = gds-list.prod-code
     1907         .
     1908         run gen-key-rec( input 'goods':U
     1909                         ,input (buffer buf_goods:handle )
     1910                         ,output v-key-rec
     1911                       ) no-error.
     1912         if error-status :error then do:
     1913           assign
     1914           v-msg = "Ошибка при генерации уникального ключа для товара" + chr(32) + string(gds-list.gds-code)
     1915           + chr(32) + "артикул" + chr(32) + gds-list.artic + chr(32) +
     1916           gds-list.prod-type + string(gds-list.prod-code) + chr(32)
     1917           .
     1918           run err-msg in this-procedure (input (v-msg), input not t-mes, input true).
     1919           next.
     1920         end.
     1921         assign
     1922           v-param = substitute( "&1&2&3&2&4&2&5&2&6&2&7&2&8"
     1923                                 ,gds-list.gds-code
     1924                                 ,chr(4)
     1925                                 ,gds-list.artic
     1926                                 ,gds-list.prod-type
     1927                                 ,gds-list.prod-code
     1928                                 ,gds-list.artic
     1929                                 ,clients.obj-type
     1930                                 ,clients.obj-code
     1931                               ).
     1932         run nws/db-rec.p ( input 'ren-art':U
     1933                       ,input v-key-rec
     1934                       ,input v-param
     1935                     ) no-error .
     1936         if error-status:error or return-value = "false":U then do:
     1937           assign
     1938           v-err = v-err + 1.
     1939           assign
     1940           v-msg = "Товар" + chr(32) + string(gds-list.gds-code) + chr(32) +
     1941           "артикул" + chr(32) + gds-list.artic + chr(32) +
     1942           gds-list.prod-type + string(gds-list.prod-code) + chr(32) + "ОШИБКА замены производителя на" + chr(32) +
     1943           clients.obj-type + string(clients.obj-code) + chr(10) + (if not return-value = "false":U then return-value else v-err-mes)
     1944           .
     1945           run err-msg in this-procedure (input (v-msg), input not t-mes, input true).
     1946         end.
     1947         else do:
     1948           if v-err-mes = "":U then
     1949             assign
     1950             v-ok = v-Ok + 1
     1951             .
     1952           assign
     1953           v-msg = "Товар" + chr(32) + string(gds-list.gds-code) + chr(32) +
     1954           "артикул" + chr(32) + gds-list.artic + chr(32) +
     1955           gds-list.prod-type + string(gds-list.prod-code) + chr(32) + "замена  производителя на" + chr(32) +
     1956           clients.obj-type + string(clients.obj-code) + chr(10) + v-err-mes
     1957           .
     1958           if v-err-mes = "":U then do:
     1959             assign
     1960               v-msg = v-msg + chr(10) + "Замена производителя начата. Направлен запрос во все БД. После получения положительного ответа производитель будет заменен"
     1961             .
     1962           end.
     1963           run err-msg in this-procedure (input (v-msg), input not t-mes, input false).
     1964         end.
     1965       end.
     1966       else do:
     1967         run utl/ren-art.p ( input gds-list.gds-code
     1968                       ,input gds-list.artic
     1969                       ,input gds-list.prod-type
     1970                       ,input gds-list.prod-code
     1971                       ,input gds-list.artic
     1972                       ,input clients.obj-type
     1973                       ,input clients.obj-code
     1974                      ) no-error.
     1975         if error-status:error or return-value = "false":U then do:
     1976           assign
     1977           v-err = v-err + 1.
     1978           assign
     1979           v-msg = "Товар" + chr(32) + string(gds-list.gds-code) + chr(32) +
     1980           "артикул" + chr(32) + gds-list.artic + chr(32) +
     1981           gds-list.prod-type + string(gds-list.prod-code) + chr(32) + "ОШИБКА замены производителя на" + chr(32) +
     1982           clients.obj-type + string(clients.obj-code) + chr(10) + (if not return-value = "false":U then return-value else v-err-mes)
     1983           .
     1984           run err-msg in this-procedure (input (v-msg), input not t-mes, input true).
     1985         end.
     1986         else do:
     1987           if v-err-mes = "":U then
     1988           assign
     1989           v-ok = v-Ok + 1
     1990           .
     1991           assign
     1992           v-msg = "Товар" + chr(32) + string(gds-list.gds-code) + chr(32) +
     1993           "артикул" + chr(32) + gds-list.artic + chr(32) +
     1994           gds-list.prod-type + string(gds-list.prod-code) + chr(32) + "замена  производителя на" + chr(32) +
     1995           clients.obj-type + string(clients.obj-code) + chr(10) + v-err-mes
     1996           .
     1997           run err-msg in this-procedure (input (v-msg), input not t-mes, input false).
     1998         end.
     1999       end.
     2000       if v-ii modulo 10 = 0 then do:
     2001           run waitfram-show in this-procedure("Обработано" + chr(32) + string(v-ii)).
     2002       end.
     2003       delete gds-list.
     2004   end.
     2005   for each gds-list:
     2006       delete gds-list.
     2007   end.
     2008   run waitfram-hide in this-procedure.
     2009   message
     2010   "Утилита завершила работу" skip
     2011   "Из выбранных Вами" v-ii "товаров"
     2012   "удалось заменить производителя для" v-ok "товаров" skip
     2013   "ошибок - " v-err skip
     2014   view-as alert-box information.
     2015   END PROCEDURE.
     2016   PROCEDURE set-file-title :
     2017   define input parameter p-filename as character no-undo.
     2018   define variable v-today as date no-undo.
     2019   define variable v-time as integer no-undo.
     2020   define variable v-full-path        as character no-undo .
     2021   define variable v-path             as character no-undo .
     2022   define variable v-file-name        as character no-undo .
     2023   define variable v-file-name-no-ext as character no-undo .
     2024   define variable v-file-name-ext    as character no-undo .
     2025   output stream Logstream to value(p-filename) append.
     2026   run cur-time in this-procedure(output v-today, output v-time).
     2027   Put stream LogStream unformatted
     2028   "**************************************************" skip
     2029   "USER:":U v-cntxt-userid skip
     2030   string(v-today, "99/99/9999") chr(32) string(v-time, "HH:MM:SS")
     2031   skip.
     2032   output stream LogStream close.
     2033   run gbl/filename.p (
     2034                            input p-filename
     2035                           ,output v-full-path
     2036                           ,output v-path
     2037                           ,output v-file-name
     2038                           ,output v-file-name-no-ext
     2039                           ,output v-file-name-ext
     2040                           ).
     2041   display
     2042   v-full-path @ f-log-file
     2043   with frame Dialog-Frame.
     2044   END PROCEDURE.
