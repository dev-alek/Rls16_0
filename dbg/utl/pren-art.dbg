      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define  new shared  temp-table gds-list-hist no-undo
      139   field list-table as character
      140   field id as integer
      141   field line as integer
      142   field hist-mode as character
      143   field des as character
      144   field num-recs as integer
      145   field option_ as character
      146   field item_ as character
      147   field status_ as character
      148   field num-add as integer
      149   field num-ignored as integer
      150   field done as logical
