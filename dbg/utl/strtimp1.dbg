        1   DEFINE INPUT PARAMETER vattaxcd as integer no-undo.
        2   DEFINE INPUT PARAMETER slttaxcd as integer no-undo.
        3   DEFINE OUTPUT PARAMETER v_os-file   AS CHAR NO-UNDO INIT "".
        4   DEFINE OUTPUT PARAMETER choice      AS integer NO-UNDO.
        5   DEFINE OUTPUT PARAMETER p-artic     AS integer NO-UNDO.
        6   DEFINE OUTPUT PARAMETER p-name      AS integer NO-UNDO.
        7   DEFINE OUTPUT PARAMETER p-engl-name AS integer NO-UNDO.
        8   DEFINE OUTPUT PARAMETER p-unit-base AS integer NO-UNDO.
        9   DEFINE OUTPUT PARAMETER p-VAT-code  AS integer NO-UNDO.
       10   DEFINE OUTPUT PARAMETER p-SLT-code  AS integer NO-UNDO.
       11   DEFINE OUTPUT PARAMETER p-struct      AS integer NO-UNDO.
       12   DEFINE OUTPUT PARAMETER p-11      AS integer NO-UNDO.
       13   DEFINE OUTPUT PARAMETER p-22      AS integer NO-UNDO.
       14   DEFINE OUTPUT PARAMETER p-33      AS integer NO-UNDO.
       15   DEFINE OUTPUT PARAMETER p-44      AS integer NO-UNDO.
       16   DEFINE OUTPUT PARAMETER p-city      AS integer NO-UNDO.
       17   DEFINE OUTPUT PARAMETER p-grp      AS integer NO-UNDO.
       18   DEFINE OUTPUT PARAMETER p-gds-prt      AS integer NO-UNDO.
       19   DEFINE OUTPUT PARAMETER p-client      AS integer NO-UNDO.
       20   DEFINE OUTPUT PARAMETER  line     AS integer NO-UNDO.
       21   define variable vss-revision    as character no-undo init "$Revision$":u .
       22   define variable vss-author      as character no-undo init "$Author$":u .
       23   define variable vss-date        as character no-undo init "$Date$":u .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       25   define variable vss-archive     as character no-undo init "$Archive$":u .
       26   define variable vss-description as character no-undo init "Параметры файла альтернативного импорта товаров" .
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define   shared variable g#auto as logical no-undo.
       88   define   shared variable g#news as logical no-undo.
       89   define   shared variable g#oxml as logical no-undo.
       90   define   shared variable g#esys as logical no-undo.
       91   define   shared variable g#news-source-db as integer no-undo.
       92   define   shared variable g#esys-source-esys as integer no-undo.
       93   define   shared variable g#db-num as integer   no-undo .
       94   define   shared variable g#userid as character no-undo .
       95   define   shared variable g#passwd as character no-undo .
       96   procedure proc-alt-shift-f2:
       97     if not ibs.th.gbl.gbl-var:rcode
       98   then
       99     run gbl\inidebug.p .
      100   end.
      101   procedure proc-alt-shift-f3:
      102     run gbl/prvssinf.p
      103       ( input this-procedure
      104       ) .
      105   end.
      106   define variable v-inform-launched as logical no-undo initial false .
      107   procedure proc-alt-shift-f4:
      108     define variable v-action as character no-undo .
      109     if v-inform-launched = false then do:
      110       assign
      111         v-inform-launched = true
      112       .
      113       run gbl/d-inform.w
      114         (  input self
      115         ,  input this-procedure
      116         , output v-action
      117         ) no-error .
      118       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      119       assign
      120         v-inform-launched = false
      121       .
      122     end.
      123   end.
      124   procedure proc-alt-f1:
      125     run gbl/corrhelp.p
      126       (input this-procedure
      127       ) .
      128   end .
      129   on alt-shift-f2 anywhere do:
      130     run proc-alt-shift-f2.
      131   end.
      132   on alt-shift-f3 anywhere do:
      133     run proc-alt-shift-f3 in this-procedure .
      134   end.
      135   on alt-shift-f4 anywhere do:
      136     run proc-alt-shift-f4 in this-procedure.
      137   end.
      138   on alt-f1 anywhere do:
      139     run proc-alt-f1 in this-procedure .
      140   end.
      141   DEFINE stream gds-file.
      142   define temp-table temp_grplib_found-grp no-undo
      143       field full-name  as character
      144       field node-code  as integer
      145       field level      as integer
      146       index pi is primary unique full-name
      147       index lv level
      148   .
      149   DEFINE BUTTON B-exit AUTO-GO
      150        LABEL "&Ввод"
      151        SIZE 10 BY 1
      152        BGCOLOR 8 .
      153   DEFINE BUTTON B-file
      154        IMAGE-UP FILE "btn-down-arrow":U
      155        IMAGE-DOWN FILE "btn-down-arrow":U
      156        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      157        LABEL ""
      158        SIZE 3 BY 1.
      159   DEFINE BUTTON b-quit AUTO-END-KEY
      160        LABEL "&Отмена"
      161        SIZE 10 BY 1
      162        BGCOLOR 8 .
      163   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      164        LABEL "Файл импорта"
      165        VIEW-AS FILL-IN
      166        SIZE 25 BY 1 NO-UNDO.
      167   DEFINE VARIABLE RS-codir AS INTEGER
      168        VIEW-AS RADIO-SET VERTICAL
      169        RADIO-BUTTONS
      170             "1251", 1,
      171   "KOI8-R", 2
      172        SIZE 15.25 BY 2.63 NO-UNDO.
      173   DEFINE RECTANGLE RECT-atribut
      174        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      175        SIZE 30.63 BY 12.83.
      176   DEFINE VARIABLE T-11 AS LOGICAL INITIAL no
      177        LABEL "Назначение товара"
      178        VIEW-AS TOGGLE-BOX
      179        SIZE 20.5 BY 1 NO-UNDO.
      180   DEFINE VARIABLE T-22 AS LOGICAL INITIAL no
      181        LABEL "Характеристики товара"
      182        VIEW-AS TOGGLE-BOX
      183        SIZE 20.5 BY 1 NO-UNDO.
      184   DEFINE VARIABLE T-33 AS LOGICAL INITIAL no
      185        LABEL "Правила эксплуатации"
      186        VIEW-AS TOGGLE-BOX
      187        SIZE 20.5 BY 1 NO-UNDO.
      188   DEFINE VARIABLE T-44 AS LOGICAL INITIAL no
      189        LABEL "Сертификат товара"
      190        VIEW-AS TOGGLE-BOX
      191        SIZE 20.5 BY 1 NO-UNDO.
      192   DEFINE VARIABLE T-artic AS LOGICAL INITIAL yes
      193        LABEL "Артикул"
      194        VIEW-AS TOGGLE-BOX
      195        SIZE 17 BY 1 NO-UNDO.
      196   DEFINE VARIABLE T-city AS LOGICAL INITIAL no
      197        LABEL "Страна"
      198        VIEW-AS TOGGLE-BOX
      199        SIZE 20.5 BY 1 NO-UNDO.
      200   DEFINE VARIABLE T-client AS LOGICAL INITIAL no
      201        LABEL "Производитель"
      202        VIEW-AS TOGGLE-BOX
      203        SIZE 20.5 BY 1 NO-UNDO.
      204   DEFINE VARIABLE T-engl-name AS LOGICAL INITIAL no
      205        LABEL "Англ. название"
      206        VIEW-AS TOGGLE-BOX
      207        SIZE 17.63 BY 1 NO-UNDO.
      208   DEFINE VARIABLE T-gds-prt AS LOGICAL INITIAL no
      209        LABEL "Шкала"
      210        VIEW-AS TOGGLE-BOX
      211        SIZE 20.5 BY 1 NO-UNDO.
      212   DEFINE VARIABLE T-grp AS LOGICAL INITIAL no
      213        LABEL "Группа товара"
      214        VIEW-AS TOGGLE-BOX
      215        SIZE 20.5 BY 1 NO-UNDO.
      216   DEFINE VARIABLE T-name AS LOGICAL INITIAL yes
      217        LABEL "Название"
      218        VIEW-AS TOGGLE-BOX
      219        SIZE 17.75 BY 1 NO-UNDO.
      220   DEFINE VARIABLE T-SLT-code AS LOGICAL INITIAL no
      221        LABEL "Код НП"
      222        VIEW-AS TOGGLE-BOX
      223        SIZE 20.5 BY 1 NO-UNDO.
      224   DEFINE VARIABLE T-struct AS LOGICAL INITIAL no
      225        LABEL "Состав сырья"
      226        VIEW-AS TOGGLE-BOX
      227        SIZE 20.5 BY 1 NO-UNDO.
      228   DEFINE VARIABLE T-unit-base AS LOGICAL INITIAL no
      229        LABEL "Основная единица измерения"
      230        VIEW-AS TOGGLE-BOX
      231        SIZE 29 BY 1 NO-UNDO.
      232   DEFINE VARIABLE T-VAT-code AS LOGICAL INITIAL no
      233        LABEL "Код НДС"
      234        VIEW-AS TOGGLE-BOX
      235        SIZE 20.5 BY 1 NO-UNDO.
      236   DEFINE FRAME Dialog-Frame
      237        B-exit AT ROW 1 COL 1.13
      238        b-quit AT ROW 1 COL 11.13
      239        B-file AT ROW 2.88 COL 43.13
      240        file-name AT ROW 2.92 COL 3.38
      241        T-artic AT ROW 5 COL 24.5
      242        RS-codir AT ROW 5.38 COL 3.38 NO-LABEL
      243        T-name AT ROW 5.79 COL 24.5
      244        T-engl-name AT ROW 6.58 COL 24.5
      245        T-unit-base AT ROW 7.42 COL 24.5
      246        T-VAT-code AT ROW 8.21 COL 24.5
      247        T-SLT-code AT ROW 9 COL 24.5
      248        T-struct AT ROW 9.79 COL 24.5
      249        T-11 AT ROW 10.58 COL 24.5
      250        T-22 AT ROW 11.42 COL 24.5
      251        T-33 AT ROW 12.21 COL 24.5
      252        T-44 AT ROW 13 COL 24.5
      253        T-city AT ROW 13.79 COL 24.5
      254        T-grp AT ROW 14.58 COL 24.5
      255        T-gds-prt AT ROW 15.42 COL 24.5
      256        T-client AT ROW 16.21 COL 24.5
      257        RECT-atribut AT ROW 4.42 COL 24
      258        "Кодировка" VIEW-AS TEXT
      259             SIZE 15.75 BY .92 AT ROW 4.21 COL 3.38
      260        "Импортируемые поля" VIEW-AS TEXT
      261             SIZE 19.25 BY .88 AT ROW 4 COL 26.25
      262             FGCOLOR 3
      263        SPACE(10.37) SKIP(12.69)
      264       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      265            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      266            TITLE "Параметры файла импорта"
      267            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      268   ASSIGN
      269          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      270          FRAME Dialog-Frame:HIDDEN           = TRUE.
      271   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      272   DO:
      273     APPLY "END-ERROR":U TO SELF.
      274   END.
      275   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      276   DO:
      277     define variable NEN as integer No-UNDO.
      278     define variable vars as integer no-undo EXTENT 15.
      279     assign
      280     file-name
      281     v_os-file = file-name
      282     RS-codir
      283     choice = RS-codir
      284     T-artic
      285     T-name
      286     T-engl-name
      287     T-unit-base
      288     T-VAT-code
      289     T-SLT-code
      290     T-struct
      291     T-11
      292     T-22
      293     T-33
      294     T-44
      295     T-city
      296     T-grp
      297     T-gds-prt
      298     T-client
      299     NEN = NEN + integer(T-artic)
      300     vars[1] = NEN
      301     p-artic = vars[1]
      302     NEN = NEN + integer(T-name)
      303     vars[2] = if T-name then NEN else 0
      304     p-name = vars[2]
      305     NEN = NEN + integer(T-engl-name)
      306     vars[3] = if T-engl-name then NEN else 0
      307     p-engl-name = vars[3]
      308     NEN = NEN + integer(T-unit-base)
      309     vars[4] = if T-unit-base then NEN else 0
      310     p-unit-base = vars[4]
      311     NEN = NEN + integer(T-VAT-code)
      312     vars[5] = if T-VAT-code then NEN else 0
      313     p-VAT-code = vars[5]
      314     NEN = NEN + integer(T-SLT-code)
      315     vars[6] = if T-SLT-code then NEN else 0
      316     p-SLT-code = vars[6]
      317     NEN = NEN + integer(T-Struct)
      318     vars[7] = if T-Struct then NEN else 0
      319     p-Struct = vars[7]
      320     NEN = NEN + integer(T-11)
      321     vars[8] = if T-11 then NEN else 0
      322     p-grp = vars[8]
      323     NEN = NEN + integer(T-22)
      324     vars[9] = if T-22 then NEN else 0
      325     p-grp = vars[9]
      326     NEN = NEN + integer(T-33)
      327     vars[10] = if T-33 then NEN else 0
      328     p-grp = vars[10]
      329     NEN = NEN + integer(T-44)
      330     vars[11] = if T-44 then NEN else 0
      331     p-grp = vars[11]
      332     NEN = NEN + integer(T-city)
      333     vars[12] = if T-city then NEN else 0
      334     p-city = vars[12]
      335     NEN = NEN + integer(T-grp)
      336     vars[13] = if T-grp then NEN else 0
      337     p-grp = vars[13]
      338     NEN = NEN + integer(T-gds-prt)
      339     vars[14] = if T-gds-prt then NEN else 0
      340     p-gds-prt = vars[14]
      341     NEN = NEN + integer(T-client)
      342     vars[15] = if T-client then NEN else 0
      343     p-client = vars[15]
      344     .
      345     IF v_os-file = "" or v_os-file = ? then do:
      346       message "Не определен файл импорта!" view-as alert-box ERROR.
      347       return no-apply.
      348     END.
      349     IF (T-SLT-code OR T-VAt-code) AND NOT T-unit-base then do:
      350       message "Невозможно импортировать код НДС и/или код НП" SKIP
      351               "без импорта основной единицы измерения" view-as alert-box ERROR.
      352       return no-apply.
      353     end.
      354     line = NEN.
      355     CASE choice:
      356           WHEN 1 then do:
      357               input stream gds-file from value (v_os-file) convert source "1251".
      358           END.
      359           WHEN 2 then do:
      360               input stream gds-file from value (v_os-file) convert source "KOI8-R".
      361           END.
      362     END CASE.
      363   END.
      364   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      365   DO:
      366       define variable ll_commit AS LOG    NO-UNDO INIT NO.
      367       SYSTEM-DIALOG GET-FILE v_os-file
      368           TITLE "Выберите файл для импорта"
      369           FILTERS
      370             " Текстовые файлы (*.gim) " "*.gim",
      371             " Текстовые файлы (*.txt) " "*.txt",
      372             " Все файлы (*.*) "                      "*.*"
      373           return-to-start-dir
      374           must-exist
      375           update ll_commit
      376           default-extension "gim"
      377           .
      378       IF ll_commit <> YES THEN do:
      379          RETURN NO-APPLY.
      380       end.
      381       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      382           BELL.
      383           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      384           RETURN NO-APPLY.
      385       END.
      386       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      387       DISP file-name WITH FRAME Dialog-Frame.
      388   END.
      389   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      390   DO:
      391       assign v_os-file = "".
      392   END.
      393   ON LEAVE OF file-name IN FRAME Dialog-Frame
      394   DO:
      395       ASSIGN file-name.
      396       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      397           ASSIGN FILE-INFO:FILE-NAME = file-name.
      398           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      399           DISP file-name WITH FRAME Dialog-Frame.
      400       END.
      401       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
      402   END.
      403   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      404   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      405   MAIN-BLOCK:
      406   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      407      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      408     RUN enable_UI.
      409     WAIT-FOR GO OF FRAME Dialog-Frame.
      410   END.
      411   RUN disable_UI.
      412   PROCEDURE disable_UI :
      413     HIDE FRAME Dialog-Frame.
      414   END PROCEDURE.
      415   PROCEDURE enable_UI :
      416     DISPLAY file-name T-artic RS-codir T-name T-engl-name T-unit-base T-VAT-code
      417             T-SLT-code T-struct T-11 T-22 T-33 T-44 T-city T-grp T-gds-prt
      418             T-client
      419         WITH FRAME Dialog-Frame.
      420     ENABLE RECT-atribut B-exit b-quit B-file file-name RS-codir T-engl-name
      421            T-unit-base T-VAT-code T-SLT-code T-struct T-11 T-22 T-33 T-44 T-city
      422            T-grp T-gds-prt T-client
      423         WITH FRAME Dialog-Frame.
      424     VIEW FRAME Dialog-Frame.
      425   END PROCEDURE.
      426   PROCEDURE get-node-code :
      427   define input parameter p-search-name  as character    no-undo.
      428   define output parameter cod-grp  like gds-grp.node-code no-undo.
      429   define var p-fill-path    as logical      no-undo.
      430   define variable v-upper-code    as integer          no-undo.
      431   define variable v-not-found     as logical init yes no-undo.
      432   define variable v-counter       as integer           no-undo.
      433   define variable v-level         as integer           no-undo.
      434   define variable v-full-name     as character         no-undo.
      435   define buffer buf_gds-grp       for gds-grp.
      436   run grplib-get-root-code ( output v-upper-code ) no-error .
      437   if error-status :error
      438       then do:
      439           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      440   end.
      441   assign
      442       v-full-name  = ""
      443       v-level      = num-entries( p-search-name, chr(47) ) .
      444   for each temp_grplib_found-grp    :
      445       delete temp_grplib_found-grp.
      446   end.
      447   start-name-analyze:
      448   do v-counter = 1 to v-level :
      449       if v-counter < v-level  then do:
      450               find first buf_gds-grp no-lock
      451                    where buf_gds-grp.upper-code = v-upper-code
      452                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(47) )
      453               no-error .
      454               if not available buf_gds-grp
      455               then do:
      456                   assign
      457                       v-full-name  = p-search-name
      458                   .
      459                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      460               end.
      461               else do:
      462                   assign
      463                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47)) + buf_gds-grp.node-name
      464                       v-upper-code = buf_gds-grp.node-code
      465                   .
      466                   if p-fill-path = yes
      467                   then do:
      468                       create temp_grplib_found-grp.
      469                       assign
      470                           temp_grplib_found-grp.full-name = v-full-name
      471                           temp_grplib_found-grp.node-code = v-upper-code
      472                           temp_grplib_found-grp.level     = v-counter
      473                       .
      474                   end.
      475               end.
      476       end.
      477       else do:
      478               for each buf_gds-grp no-lock
      479                  where buf_gds-grp.upper-code = v-upper-code
      480                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(47) )
      481               :
      482                   assign
      483                       v-not-found = no
      484                   .
      485                   create temp_grplib_found-grp.
      486                   assign
      487                       temp_grplib_found-grp.full-name = v-full-name
      488                                                           + (if v-full-name = "" then "" else chr(47))
      489                                                           + buf_gds-grp.node-name
      490                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      491                       temp_grplib_found-grp.level     = v-level
      492                   .
      493               end.
      494               if v-not-found = yes
      495               then do:
      496                   assign
      497                       v-full-name  = p-search-name
      498                   .
      499                   for each temp_grplib_found-grp
      500                   :
      501                       delete temp_grplib_found-grp.
      502                   end.
      503                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      504               end.
      505       end.
      506   end.
      507   for each temp_grplib_found-grp no-lock:
      508     cod-grp =  temp_grplib_found-grp.node-code.
      509   end.
      510   END PROCEDURE.
      511   PROCEDURE grplib-get-root-code :
      512   do
      513   on error undo, return error
      514   :
      515   define output parameter p-root-code as integer      no-undo.
      516   define buffer buf_gds-grp       for gds-grp.
      517       find first buf_gds-grp no-lock
      518           where buf_gds-grp.upper-code = 0
      519       no-error .
      520       if not available buf_gds-grp
      521       then do:
      522           undo, return error .
      523       end.
      524       else do:
      525           assign
      526               p-root-code = buf_gds-grp.node-code
      527           .
      528       end.
      529   end.
      530   END PROCEDURE.
