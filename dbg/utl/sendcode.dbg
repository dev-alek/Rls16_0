        1   block-level on error undo, throw.
        2   define input  parameter iUtil as class ibs.th.utl.method-for-draw-utility no-undo.
        3   define input  parameter iCode as integer no-undo.
        4   define input  parameter ireclist as char no-undo.
        5   define variable mAnswer as character  no-undo.
        6   define new global shared variable g#language as character no-undo .
        7   if g#language <> '' and g#language <> 'rus':U then do:
        8     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        9   end.
       10   subscribe   to "ResponseToQuestion" anywhere run-procedure "SendAnswer".
       11   if iCode eq 1
       12   then do:
       13     mAnswer = "4".
       14     run str/sendcash.p(iUtil:parparentproc,this-procedure,this-procedure,string(iUtil:Obj-code) + chr(4) + "D").
       15   end.
       16    else if iCode eq 2
       17   then do:
       18     mAnswer = "1".
       19     run str/sendcash.p(iUtil:parparentproc,this-procedure,this-procedure,string(iUtil:obj-code) + chr(4) + "U").
       20   end.
       21   else if iCode eq 3
       22   then do:
       23     mAnswer = "4".
       24     run str/send-tax.p (iUtil:parparentproc, 'IBM':U, iUtil:obj-type, iUtil:obj-code, 'D') .
       25   end.
       26   else if iCode eq 4
       27   then do:
       28     mAnswer = "5".
       29     run str/send-tax.p (iUtil:parparentproc, 'IBM':U, iUtil:obj-type, iUtil:obj-code, 'U') .
       30   end.
       31   else if iCode eq 5
       32   then do:
       33     mAnswer = "4".
       34     run str/2cashpay.p(iUtil:parparentproc,this-procedure,this-procedure,'IBM':U + chr(4) + iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "D").
       35   end.
       36   else if iCode eq 6
       37   then do:
       38     mAnswer = "1".
       39     run str/2cashpay.p(iUtil:parparentproc,this-procedure,this-procedure,'IBM':U + chr(4) + iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "U").
       40   end.
       41   else if iCode eq 7
       42   then do:
       43     mAnswer = "7".
       44     run str/cash-cli.p(iUtil:parparentproc,this-procedure,this-procedure,string(ibs.th.gbl.gbl-var:g#db-num) + chr(4) + iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "D").
       45   end.
       46   else if iCode eq 8
       47   then do:
       48     mAnswer = "5".
       49     run str/cash-cli.p(iUtil:parparentproc,this-procedure,this-procedure,string(ibs.th.gbl.gbl-var:g#db-num)  + chr(4) + iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "U").
       50     mAnswer = "6".
       51     run str/cash-cli.p(iUtil:parparentproc,this-procedure,this-procedure,string(ibs.th.gbl.gbl-var:g#db-num)  + chr(4) + iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "U").
       52   end.
       53   else if iCode eq 9
       54   then do:
       55     mAnswer = "4".
       56     run str/senddcty.p (iUtil:parparentproc,this-procedure,this-procedure,iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "D").
       57   end.
       58   else if iCode eq 10
       59   then do:
       60     mAnswer = "1".
       61     run str/senddcty.p (iUtil:parparentproc,this-procedure,this-procedure,iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "U").
       62   end.
       63   else  if iCode eq 11
       64   then do:
       65     mAnswer = "1".
       66     run str/bpasend.p (iUtil:parparentproc,this-procedure,this-procedure,'IBM-XML':U + chr(4) + iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "DD").
       67   end.
       68   else  if iCode eq 12
       69   then do:
       70     mAnswer = "1".
       71     run str/bpasend.p (iUtil:parparentproc,this-procedure,this-procedure,'IBM-XML':U + chr(4) + iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "UU").
       72   end.
       73   else if iCode eq 13
       74   then do:
       75     mAnswer = "4".
       76     run str/del-gds.p (iUtil:parparentproc,this-procedure,this-procedure,string(iUtil:obj-code) + chr(4) + "no").
       77   end.
       78   else if iCode eq 14
       79   then do:
       80     mAnswer = "1".
       81     run str/send-gds-draw.p (iUtil:parparentproc).
       82   end.
       83   else if iCode eq 15
       84   then do:
       85     run str/sendcashcomm.p (iUtil:parparentproc,this-procedure,this-procedure,iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + "U","execute","dbClear",ireclist).
       86   end.
       87   else if iCode eq 16
       88   then do:
       89   run str/send-all.p ( iUtil:parparentproc
       90                       ,this-procedure
       91                       ,this-procedure
       92                       ,iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + 'D':U + chr(4) + 'emrc':U + chr(4) + 'Удаление справочника ЕМЦ':U
       93                        ) no-error.
       94   end.
       95   else if iCode eq 17
       96   then do:
       97   run str/send-all.p ( iUtil:parparentproc
       98                       ,this-procedure
       99                       ,this-procedure
      100                       ,iUtil:obj-type + chr(4) + string(iUtil:obj-code) + chr(4) + 'U':U + chr(4) + 'emrc':U + chr(4) + 'Передача справочника ЕМЦ':U
      101                        ) no-error.
      102   end.
      103   unsubscribe to "ResponseToQuestion".
      104   procedure SendAnswer:
      105      define output parameter oAnswer as character  no-undo.
      106      oAnswer = mAnswer.
      107   end procedure.
      108   procedure write-log-and-file :
      109   define input parameter p-tabs as integer no-undo .
      110   define input parameter p-log-file as character no-undo .
      111   define input parameter p-int2 as integer no-undo .
      112   define input parameter p-mess as character no-undo .
      113   iUtil:put-log(p-mess).
      114   end procedure.
      115   procedure show-counter :
      116   end procedure.
