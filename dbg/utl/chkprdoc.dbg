      483   procedure thobjs :
      484      define input        parameter parparentproc     as widget-handle no-undo .
      485      define input        parameter i-bttns           as character     no-undo .
      486      define input        parameter i-list-mode       as character     no-undo.
      487      define input        parameter i-obj-type        as character     no-undo.
      488      define input        parameter i-db-num          as integer       no-undo.
      489      define input        parameter i-host-code       as integer       no-undo.
      490      define input-output parameter p-rid-list        as character     no-undo .
      491   run ref/thobjs.p
      492           ( input parparentproc
      493            ,input  this-procedure :handle
      494           , input i-bttns
      495           , input i-list-mode
      496           , input i-obj-type
      497           , input i-db-num
      498           , input i-host-code
      499           , input-output p-rid-list ) no-error .
      500   end.
      501   define variable v-today                    as date      no-undo .
      502   define variable v-time                     as integer   no-undo .
      503   define variable v-total-err-obj            as integer   no-undo .
      504   define variable v-total-ind                as integer   no-undo .
      505   define variable v-grand-total-err          as integer   no-undo .
      506   define variable v-last-obj-type            as character no-undo .
      507   define variable v-last-obj-code            as integer   no-undo .
      508   define variable v-last-err-date            as date      no-undo .
      509   define variable v-err-file-name            as character no-undo .
      510   define variable v-log-file-name            as character no-undo .
      511   define stream sout .
      512   define variable v-object  as character no-undo .
      513   define frame a
      514     v-object        format "x(40)"       label "Объект" skip
      515     v-total-ind     format ">>>,>>>,>>9" label "Проверено объектов" skip
      516     v-total-err-obj format ">>>,>>>,>>9" label "Объектов с ошибками" skip
      517     with view-as dialog-box side-labels three-d
      518     title "Проверка документов переоценки"
      519     .
      520   do
      521   on error undo, return error return-value
      522   :
      523     assign
      524       v-log-file-name            = 'chkprdoc.txt':U
      525       v-err-file-name            = 'chkprdoc.err':U
      526     .
      527   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528     run mainmenu_getcntxt in parparentproc
      529       (output v-cntxt-db-num
      530       ,output v-cntxt-userid
      531       ,output v-cntxt-level
      532       ,output v-cntxt-host-code-obj
      533       ,output v-cntxt-obj-type
      534       ,output v-cntxt-obj-code
      535       ,output v-cntxt-db-num-obj
      536       ,output v-cntxt-is-admin
      537       ) .
      538     define variable v-num                     as integer   no-undo .
      539     define variable v-ok                      as logical   no-undo .
      540     define variable v-check-start-date-string as character no-undo .
      541     define variable v-check-start-date        as date      no-undo .
      542     assign
      543       v-ok = false
      544     .
      545     run gbl/d-askw.w
      546       (input "Вопрос"
      547       ,input "Проверка документов переоценки" + chr(10)
      548              + "Все переоценки или с определенной даты"
      549       ,input "|^"
      550       ,input "Все переоценки^confirm|С определенной даты|Отмена"
      551       ,input "|"
      552           + "|"
      553           + ""
      554       ,input 1
      555       ,input 3
      556       ,output v-num
      557       ).
      558     case v-num
      559     :
      560       when 1
      561       then do:
      562         assign
      563           v-check-start-date = ?
      564         .
      565       end.
      566       when 2
      567       then do:
      568         run gbl/d-prompt.w
      569           ( 'title=':u + "Введите дату" + '\':u
      570           + 'text1=':u + "Введите дату, начиная с которой надо проверить переоценки" + '\':u
      571           + 'type=date\':u
      572           ,input-output v-check-start-date-string
      573           ).
      574         if return-value = 'false':u
      575         then do:
      576           undo, return error .
      577         end.
      578         assign
      579           v-check-start-date = date(v-check-start-date-string)
      580         .
      581         if v-check-start-date = ?
      582         then do:
      583           message
      584             "Не выбрана дата" v-check-start-date-string skip
      585             view-as alert-box error .
      586           undo, return error .
      587         end.
      588       end.
      589       when 3
      590       then do:
      591         undo, return error .
      592       end.
      593     end.
      594     run gbl/d-askw.w
      595       (input "Вопрос"
      596       ,input "Проверка документов переоценки" + chr(10)
      597              + (if v-check-start-date <> ?
      598                 then substitute("Проверка документов переоценки с даты &1 включительно"
      599                                ,string(v-check-start-date, '99/99/9999':U)
      600                                )
      601                 else "Проверка документов переоценки за все даты"
      602                )
      603       ,input "|^"
      604       ,input "Все объекты^confirm|Выбрать объекты|Отмена"
      605       ,input "|"
      606           + "|"
      607           + ""
      608       ,input 1
      609       ,input 3
      610       ,output v-num
      611       ).
      612     case v-num
      613     :
      614       when 1
      615       then do:
      616         define buffer buf_db for ub.db .
      617         define buffer buf_clients for ub.clients .
      618         for each buf_db no-lock
      619         ,each buf_clients no-lock
      620           where buf_clients.db-num = buf_db.db-num
      621         on error undo, return error return-value
      622         :
      623           if buf_clients.stts = 0
      624           then do:
      625             run check-price-doc in this-procedure
      626               (input buf_clients.obj-type
      627               ,input buf_clients.obj-code
      628               ,input v-check-start-date
      629               ).
      630           end.
      631         end.
      632       end.
      633       when 2
      634       then do:
      635         define variable v-user-select as logical   no-undo .
      636   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      637   run userobjs_select-many in this-procedure
      638     (input  parparentproc
      639     ,input  v-cntxt-db-num
      640     ,input  v-cntxt-userid
      641     ,input  v-cntxt-host-code-obj
      642     ,input  v-cntxt-obj-type
      643     ,input  v-cntxt-obj-code
      644     ,output v-user-select
      645     )  .
      646         if v-user-select <> true
      647         then do:
      648           message
      649             "Объект не выбран"
      650             view-as alert-box information .
      651           return .
      652         end.
      653         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      654         for each buf_userobjs_temp-user-obj
      655         on error undo, return error return-value
      656         :
      657           run check-price-doc in this-procedure
      658             (input buf_userobjs_temp-user-obj.obj-type
      659             ,input buf_userobjs_temp-user-obj.obj-code
      660             ,input v-check-start-date
      661             ).
      662         end.
      663       end.
      664       otherwise do:
      665         return .
      666       end.
      667     end.
      668     hide frame a .
      669     if v-total-err-obj <> 0
      670     then do:
      671       message
      672         "Проверка складского архива по поставщикам" skip
      673         "" skip
      674         "Обнаружены ошибки в складском архиве по поставщикам" skip
      675         "Проверено объектов" v-total-ind skip
      676         "Всего объектов с ошибками" v-total-err-obj skip
      677         "Всего элементарных ошибок" v-grand-total-err skip
      678         "Список проверенных объектов выведен в файл" v-log-file-name skip
      679         "Список объектов с ошибками выведен в файл"  v-err-file-name skip
      680         view-as alert-box error .
      681     end.
      682     else do:
      683       message
      684         "Проверка складского архива по поставщикам закончена" skip
      685         "Проверено объектов" v-total-ind skip
      686         "Список проверенных объектов выведен в файл" v-log-file-name skip
      687         "Ошибок не обнаружено" skip
      688         view-as alert-box information .
      689     end.
      690   end.
      691   procedure check-price-doc :
      692     define input  parameter p-obj-type         as character no-undo .
      693     define input  parameter p-obj-code         as integer   no-undo .
      694     define input  parameter p-check-start-date as date      no-undo .
      695     define variable v-err-count         as integer   no-undo .
      696     define variable v-state-description as character no-undo .
      697     do
      698     on error undo, return error return-value
      699     :
      700       assign
      701         v-total-ind     = v-total-ind + 1
      702         v-last-obj-type = p-obj-type
      703         v-last-obj-code = p-obj-code
      704       .
      705       view frame a .
      706       display
      707         substitute('&1 &2', p-obj-type, p-obj-code) @ v-object
      708         v-total-err-obj       @ v-total-err-obj
      709         with frame a .
      710       output stream sout to value(v-log-file-name) append .
      711       export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
      712       export stream sout "Объект" p-obj-type p-obj-code .
      713       export stream sout "Начало проверки объекта".
      714       output stream sout close .
      715       run utl/chkobprd.p
      716         (input  p-obj-type
      717         ,input  p-obj-code
      718         ,input  p-check-start-date
      719         ,output v-err-count
      720         ,output v-state-description
      721         ) no-error .
      722       if error-status :error
      723       then do:
      724         output stream sout to value(v-log-file-name) append .
      725         export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
      726         export stream sout "Объект" p-obj-type p-obj-code .
      727         export stream sout "Аварийное завершение проверки объекта".
      728         export stream sout "Сообщение об ошибке" error-status :get-message(1) .
      729         export stream sout "Результат" return-value .
      730         output stream sout close .
      731       end.
      732       output stream sout to value(v-log-file-name) append .
      733       export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
      734       export stream sout "Объект" p-obj-type p-obj-code .
      735       export stream sout "Завершена проверка объекта".
      736       export stream sout "Ошибок" v-err-count .
      737       export stream sout v-state-description .
      738       output stream sout close .
      739       if v-err-count <> 0
      740       then do:
      741         assign
      742           v-total-err-obj = v-total-err-obj + 1
      743         .
      744         assign
      745           v-grand-total-err = v-grand-total-err + v-err-count
      746         .
      747         run cur-time in this-procedure
      748           (output v-today
      749           ,output v-time
      750           ) .
      751         output stream sout to value(v-err-file-name) append .
      752         export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
      753         export stream sout "Объект" p-obj-type p-obj-code .
      754         export stream sout "Ошибок" v-err-count .
      755         export stream sout v-state-description .
      756         output stream sout close .
      757       end.
      758     end.
      759   end procedure.
