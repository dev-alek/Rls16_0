     2006                   price-base-with-tax-salecl    = varsum-base-factovpcl / varfact-qntycl
     2007           slt-base-salecl               = varslt-base-factovpcl / varfact-qntycl
     2008           vat-base-buyercl              = varvat-base-factovpcl / varfact-qntycl
     2009           discnt-base-salecl            = vardsc-base-factovpcl / varfact-qntycl
     2010           vat-base-salecl               = varvatcons-base-factovpcl / varfact-qntycl
     2011                   price-rubl-with-tax-salecl    = varsum-rubl-factovpcl / varfact-qntycl
