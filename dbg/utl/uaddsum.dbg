     1999           slt-rubl-salecl               = varslt-rubl-docovpcl / varfact-qntycl
     2000           vat-rubl-buyercl              = varvat-rubl-docovpcl / varfact-qntycl
     2001           discnt-rubl-salecl            = vardsc-rubl-docovpcl / varfact-qntycl
     2002           vat-rubl-salecl               = varvatcons-rubl-docovpcl / varfact-qntycl.
     2003       end.
     2004       else do:
