     1240   field slt-rubl-doc       like ub.doc-line.price-base
     1241   field road-tax-base-doc  like ub.doc-line.price-base
     1242   field road-tax-rubl-doc  like ub.doc-line.price-base
     1243   field excise-base-doc    like ub.doc-line.price-base
     1244   field excise-rubl-doc    like ub.doc-line.price-base
     1245   field sum-dsc-base-acc   like ub.doc-line.price-base
     1246   field sum-dsc-rubl-acc   like ub.doc-line.price-base
     1247   field sum-dsc-cli-acc    like ub.doc-line.price-cli
     1248   field dsc-base-acc       like ub.doc-line.price-base
     1249   field dsc-rubl-acc       like ub.doc-line.price-base
     1250   field dsc-cli-acc        like ub.doc-line.price-cli
     1251   field vat-base-acc       like ub.doc-line.price-base
     1252   field vat-rubl-acc       like ub.doc-line.price-base
     1253   field vat-cli-acc        like ub.doc-line.price-cli
     1254   field slt-base-acc       like ub.doc-line.price-base
     1255   field slt-rubl-acc       like ub.doc-line.price-base
     1256   field slt-cli-acc        like ub.doc-line.price-cli
     1257   field road-tax-base-acc  like ub.doc-line.price-base
     1258   field road-tax-rubl-acc  like ub.doc-line.price-base
     1259   field road-tax-cli-acc   like ub.doc-line.price-cli
     1260   field excise-base-acc    like ub.doc-line.price-base
     1261   field excise-rubl-acc    like ub.doc-line.price-base
     1262   field excise-cli-acc     like ub.doc-line.price-cli
     1263   field transport-base-acc like ub.doc-line.price-base
     1264   field transport-rubl-acc like ub.doc-line.price-base
     1265   field transport-cli-acc  like ub.doc-line.price-cli
     1266   field other-base-acc     like ub.doc-line.price-base
     1267   field other-rubl-acc     like ub.doc-line.price-base
     1268   field other-cli-acc      like ub.doc-line.price-cli
     1269   field sum-dsc-base-cur   like ub.doc-line.price-base
     1270   field sum-dsc-rubl-cur   like ub.doc-line.price-base
     1271   field dsc-base-cur       like ub.doc-line.price-base
     1272   field dsc-rubl-cur       like ub.doc-line.price-base
     1273   field vat-base-cur       like ub.doc-line.price-base
     1274   field vat-rubl-cur       like ub.doc-line.price-base
     1275   field vat-base-buyer-cur like ub.doc-line.price-base
     1276   field vat-rubl-buyer-cur like ub.doc-line.price-base
     1277   field slt-base-cur       like ub.doc-line.price-base
     1278   field slt-rubl-cur       like ub.doc-line.price-base
     1279   field road-tax-base-cur  like ub.doc-line.price-base
     1280   field road-tax-rubl-cur  like ub.doc-line.price-base
     1281   field excise-base-cur    like ub.doc-line.price-base
     1282   field excise-rubl-cur    like ub.doc-line.price-base
     1283   index sum-type is primary unique sum-type.
     1284   .
     1285   define temp-table tt-allsum no-undo
     1286   field sum-type           as   character
     1287   field fact-qnty             as decimal
     1288   field cli-qnty              as decimal
     1289   field sum-dsc-base-doc      as decimal
     1290   field sum-dsc-rubl-doc      as decimal
     1291   field dsc-base-doc          as decimal
     1292   field dsc-rubl-doc          as decimal
