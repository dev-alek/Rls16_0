     1306   field dsc-base-acc          as decimal
     1307   field dsc-rubl-acc          as decimal
     1308   field dsc-cli-acc           as decimal
     1309   field vat-base-acc          as decimal
     1310   field vat-rubl-acc          as decimal
     1311   field vat-cli-acc           as decimal
     1312   field slt-base-acc          as decimal
     1313   field slt-rubl-acc          as decimal
     1314   field slt-cli-acc           as decimal
     1315   field road-tax-base-acc     as decimal
     1316   field road-tax-rubl-acc     as decimal
     1317   field road-tax-cli-acc      as decimal
     1318   field excise-base-acc       as decimal
     1319   field excise-rubl-acc       as decimal
     1320   field excise-cli-acc        as decimal
     1321   field transport-base-acc    as decimal
     1322   field transport-rubl-acc    as decimal
     1323   field transport-cli-acc     as decimal
     1324   field other-base-acc        as decimal
     1325   field other-rubl-acc        as decimal
     1326   field other-cli-acc         as decimal
     1327   field sum-dsc-base-cur      as decimal
     1328   field sum-dsc-rubl-cur      as decimal
     1329   field dsc-base-cur          as decimal
     1330   field dsc-rubl-cur          as decimal
     1331   field vat-base-cur          as decimal
     1332   field vat-rubl-cur          as decimal
     1333   field vat-base-buyer-cur    as decimal
     1334   field vat-rubl-buyer-cur    as decimal
     1335   field slt-base-cur          as decimal
     1336   field slt-rubl-cur          as decimal
     1337   field road-tax-base-cur     as decimal
