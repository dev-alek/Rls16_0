     2015           vat-rubl-salecl               = varvatcons-rubl-factovpcl / varfact-qntycl.
     2016       end.
     2017     end.
     2018   end.
     2019   assign
     2020     price-base-without-tax-salecl = price-base-with-tax-salecl - vat-base-salecl - slt-base-salecl - road-tax-base-salecl
     2021     price-rubl-without-tax-salecl = price-rubl-with-tax-salecl - vat-rubl-salecl - slt-rubl-salecl - road-tax-rubl-salecl.
     2022   end.
     2023   if paris-cur then do:
     2024     assign
     2025       parcurartic      = cl_tt-clcparts.artic
     2026       parcurprod-type  = cl_tt-clcparts.prod-type
     2027       parcurprod-code  = cl_tt-clcparts.prod-code
     2028       parcurdoc-type   = cl_tt-clcparts.doc-type
     2029       parcurdoc-code   = cl_tt-clcparts.out-code
     2030       parcurobj-type   = cl_tt-clcparts.obj-type
     2031       parcurobj-code   = cl_tt-clcparts.obj-code.
     2032     if parr-b = "base" then do:
     2033       assign
     2034         parcurprice-base = parcur-base
     2035         parcurprice-rubl = parcur-base * parbase-rate / parbase-scale.
     2036     end.
     2037     else do:
     2038       assign
     2039         parcurprice-base = parcur-base / parbase-rate * parbase-scale
     2040         parcurprice-rubl = parcur-base.
     2041     end.
     2042     assign
     2043       parcurbase-rate   = parbase-rate
     2044       parcurbase-scale  = parbase-scale
     2045       parcurdiscnt-base = 0
     2046       parcurdiscnt-rubl = 0
     2047       parcurfact-qnty   = cl_tt-clcparts.fact-qnty
     2048       parcurcli-qnty    = cl_tt-clcparts.cli-qnty
     2049       parcurdoc-qnty    = cl_tt-clcparts.qnty.
