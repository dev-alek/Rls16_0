     2981               varlastcur-road-tax = varroad-tax
     2982               varlastcur-excise   = varexcise
     2983               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2984               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2985               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2986               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2987             .
     2988         end.
     2989       end.
     2990       if varcur-fact-qnty = 0 then do:
     2991         assign
     2992           varcur-base      = varlastcur-base
     2993           varcur-road-tax  = varlastcur-road-tax
     2994           varcur-excise    = varlastcur-excise
     2995         .
     2996       end.
     2997       else do:
     2998         assign
     2999           varcur-base      = varcur-base      / varcur-fact-qnty
     3000           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3001           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3002         .
     3003       end.
     3004       if varcur-vat-pc = ?
     3005       then do:
     3006         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3007       end.
     3008       if varcur-slt-pc = ?
     3009       then do:
     3010         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3011       end.
     3012       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3013       assign
     3014         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3015       if varcur-cons-vat-pc = ? then do:
     3016         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3017       end.
     3018       define buffer buf_tt-clcparts for tt-clcparts .
     3019       for each buf_tt-clcparts
     3020       on error undo, return error return-value
     3021       :
     3022         delete buf_tt-clcparts.
     3023       end.
     3024       for each bf_parts no-lock
     3025         where bf_parts.out-code  = bf_doc-line.doc-code
     3026           and bf_parts.obj-type  = bf_doc-line.obj-type
     3027           and bf_parts.obj-code  = bf_doc-line.obj-code
     3028           and bf_parts.artic     = bf_doc-line.artic
     3029           and bf_parts.prod-type = bf_doc-line.prod-type
     3030           and bf_parts.prod-code = bf_doc-line.prod-code
     3031       on error undo, return error return-value
     3032       :
     3033         create buf_tt-clcparts .
     3034         buffer-copy bf_parts to buf_tt-clcparts .
     3035         if v-calcbypart = yes   then do:
     3036   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3037     (buffer bf_parts
     3038     ,output v-b-pcode
     3039     ) no-error .
     3040   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3042     (input  bf_parts.obj-type
     3043     ,input  bf_parts.obj-code
     3044     ,input  v-b-pcode
     3045     ,input  0
     3046     ,input  bf_trn-doc.fact-order
     3047     ,output vardoc-num
     3048     ,output varprice-salef
     3049     ,output varroad-tax
     3050     ,output varexcise
     3051     ) no-error .
     3052             if varprice-sale = ?
     3053             then do:
     3054               assign
     3055                 varprice-salef = 0
     3056                 varroad-tax   = 0
     3057                 varexcise     = 0
     3058               .
     3059             end.
     3060             assign
     3061             part-cur-base  = varprice-salef
     3062             part-cur-road-tax  = varroad-tax
     3063             part-cur-excise = varexcise.
     3064         end.
     3065       end.
     3066       run clcprtsl_calc-ttable in this-procedure
     3067         (input yes,
     3068          input yes,
     3069          input bf_doc-line.road-tax,
     3070          input bf_doc-line.excise,
     3071          input bf_doc-line.vat-pc,
     3072          input bf_doc-line.cons-vat-pc,
     3073          input bf_doc-line.slt-pc,
     3074          input bf_trn-doc.base-rate,
     3075          input bf_trn-doc.base-scale,
     3076          input varr-b,
     3077          input varcur-base,
     3078          input varcur-road-tax,
     3079          input varcur-excise,
     3080          input varcur-vat-pc,
     3081          input varcur-cons-vat-pc,
     3082          input varcur-slt-pc
     3083          ) no-error.
     3084       if error-status:error then do:
     3085         message
     3086           vss-workfile vss-revision vss-description skip
     3087           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3088           return-value skip
     3089           trim(error-status :get-message(1))
     3090           trim(error-status :get-message(2))
     3091           trim(error-status :get-message(3))
     3092           trim(error-status :get-message(4))
     3093           trim(error-status :get-message(5)) skip
     3094           view-as alert-box error.
     3095         undo, return error .
     3096       end.
     3097     end.
     3098   end.
     3099   end.
     3100   procedure clcprtsl_calc-ttable :
     3101   define input parameter paris-doc           as   logical                 no-undo.
     3102   define input parameter paris-cur           as   logical                 no-undo.
     3103   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3104   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3105   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3106   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3107   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3108   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3109   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3110   define input parameter parr-b              as   character               no-undo.
     3111   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3112   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3113   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3114   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3115   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3116   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3117   define buffer bf_tt-allsum      for tt-allsum.
     3118   define buffer bf_tt-clcparts    for tt-clcparts.
     3119   define buffer bf_tt-allsum-line for tt-allsum-line.
     3120   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3121   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3122   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3123   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3124   define variable varexcise          like ub.price-list.excise     no-undo.
     3125   do on error undo, return error return-value :
     3126   for each bf_tt-allsum-line
     3127   on error undo, return error return-value
     3128    :
     3129     delete bf_tt-allsum-line.
     3130   end.
     3131   for each bf_tt-allsum
     3132   on error undo, return error return-value
     3133   :
     3134     delete bf_tt-allsum.
     3135   end.
     3136   for each bf_tt-clcparts
     3137   on error undo, return error return-value
     3138   :
     3139   if v-calcbypart then do:
     3140             assign
     3141             parcur-base =   bf_tt-clcparts.part-cur-base
     3142             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3143             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3144             .
     3145   end.
     3146      run clcprtsl_calc-parts in this-procedure (
     3147        input recid(bf_tt-clcparts),
     3148        input paris-doc,
     3149        input paris-cur,
     3150        input parroad-tax,
     3151        input parexcise,
     3152        input parvat-pc,
     3153        input parcons-vat-pc,
     3154        input parslt-pc,
     3155        input parbase-rate,
     3156        input parbase-scale,
     3157        input parr-b,
     3158        input parcur-base,
     3159        input parcur-road-tax,
     3160        input parcur-excise,
     3161        input parcur-vat-pc,
     3162        input parcurcons-vat-pc,
     3163        input parcurslt-pc
     3164        ) no-error.
     3165     if error-status:error then do:
     3166       message
     3167         vss-workfile vss-revision vss-description skip
     3168         vss-include-info9 skip
     3169         "Ошибка при обсчете партии" skip
     3170         "Документ партии " bf_tt-clcparts.out-code skip
     3171         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3172         return-value skip
     3173         error-status:get-message(1) skip
     3174         error-status:get-message(2) skip
     3175         error-status:get-message(3) skip
     3176         view-as alert-box error .
     3177       undo, return error .
     3178     end.
     3179     for each bf_tt-allsum on error undo, return error return-value :
     3180       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3181       if not available bf_tt-allsum-line then do:
     3182         create bf_tt-allsum-line.
     3183         assign
     3184           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3185       end.
     3186       assign
     3187         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3188         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3189         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3190         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3191         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3192         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3193         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3194         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3195         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3196         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3197         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3198         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3199         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3200         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3201         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3202         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3203         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3204         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3205         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3206         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3207         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3208         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3209         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3210         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3211         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3212         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3213         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3214         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3215         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3216         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3217         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3218         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3219         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3220         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3221         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3222         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3223         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3224         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3225         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3226         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3227         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3228         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3229         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3230         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3231         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3232         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3233         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3234         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3235         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3236         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3237         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3238         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3239         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3240         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3241         .
     3242     end.
     3243   end.
     3244   end.
     3245   end procedure.
     3246   define temp-table tt-doc-line-sum     no-undo like ub.doc-line-sum.
     3247   define temp-table tt-old-doc-line-sum no-undo like tt-doc-line-sum.
     3248   define temp-table tt-wast-line        no-undo
     3249     field obj-type            like ub.doc-line.obj-type
     3250     field obj-code            like ub.doc-line.obj-code
     3251     field status_             like ub.doc-line.status_
     3252     field artic               like ub.doc-line.artic
     3253     field prod-type           like ub.doc-line.prod-type
     3254     field prod-code           like ub.doc-line.prod-code
     3255     field fact-order          like ub.doc-line.fact-order
     3256     field prev-inv-fact-order like ub.doc-line.fact-order
     3257     index prev-inv-fact-order      prev-inv-fact-order.
     3258     define new global shared variable g#lib-rwds as handle no-undo.
     3259   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3260   procedure factord :
     3261     define input  parameter p-fact-date            as date    no-undo .
     3262     define input  parameter p-fact-time            as integer no-undo .
     3263     define input  parameter p-fact-num             as integer no-undo .
     3264     define input  parameter p-shift-date           as date    no-undo .
     3265     define input  parameter p-shift-num            as integer no-undo .
     3266     define input  parameter p-shift-on             as logical no-undo .
     3267     define output parameter p-fact-order           as decimal no-undo .
     3268     define output parameter p-shift-end-fact-order as decimal no-undo .
     3269     define output parameter p-day-end-fact-order   as decimal no-undo .
     3270     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     3271     if p-fact-date = ?
     3272     then do:
     3273       return error "Не указана фактическая дата" .
     3274     end.
     3275     define variable v-fact-date-num as integer no-undo .
     3276     assign
     3277       v-fact-date-num = integer(p-fact-date)
     3278     .
     3279     if p-fact-num = ?
     3280     or p-fact-num = 0
     3281     then do:
     3282       return error "Не задан p-fact-num " + string(p-fact-num) .
     3283     end.
     3284     if p-fact-num < 0
     3285     then do:
     3286       return error "Отрицательный fact-num " + string(p-fact-num) .
     3287     end.
     3288     if p-fact-num >= 100000000
     3289     then do:
     3290       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     3291     end.
     3292     if p-shift-on = true
     3293     then do:
     3294       if p-shift-date = ?
     3295       then do:
     3296         return error "Не задана дата смены" .
     3297       end.
     3298       if p-shift-num = ?
     3299       or p-shift-num = 0
     3300       then do:
     3301         return error "Не задан номер смены" .
     3302       end.
     3303     end.
     3304     else do:
     3305       assign
     3306         p-shift-date = p-fact-date
     3307         p-shift-num  = 24
     3308       .
     3309     end.
     3310     define variable v-shift-offset as integer no-undo .
     3311     if p-shift-date = p-fact-date
     3312     then do:
     3313       assign
     3314         v-shift-offset = 1
     3315       .
     3316     end.
     3317     if p-shift-date < p-fact-date
     3318     then do:
     3319       assign
     3320         v-shift-offset = 0
     3321       .
     3322     end.
     3323     if p-shift-date > p-fact-date
     3324     then do:
     3325       message
     3326         vss-workfile vss-revision vss-description skip
     3327         "Неправильная дата закрытия смены" skip
     3328         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     3329         view-as alert-box error .
     3330       undo, return error
     3331         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     3332           ,string(p-fact-date, '99/99/9999':U)
     3333           ,string(p-shift-date, '99/99/9999':U)
     3334           )
     3335       .
     3336     end.
     3337     if p-shift-num < 1
     3338     or p-shift-num > 24
     3339     then do:
     3340       message
     3341         vss-workfile vss-revision vss-description skip
     3342         "Неправильный номер смены" skip
     3343         "p-shift-num" p-shift-num skip
     3344         view-as alert-box error .
     3345       undo, return error return-value .
     3346     end.
     3347     assign
     3348       p-fact-order           = v-fact-date-num
     3349                              + v-shift-offset * 0.5
     3350                              + p-shift-num    * 0.02 - 0.01
     3351                              + p-fact-num     * 0.0000000001
     3352       p-shift-end-fact-order = v-fact-date-num
     3353                              + v-shift-offset * 0.5
     3354                              + p-shift-num    * 0.02
     3355       p-day-end-fact-order   = v-fact-date-num
     3356                              + 0.99
     3357     .
     3358     if p-fact-order           <= v-fact-date-num
     3359     or p-shift-end-fact-order <= v-fact-date-num
     3360     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     3361     or p-shift-end-fact-order >= p-day-end-fact-order
     3362     then do:
     3363       message
     3364         vss-workfile vss-revision vss-description skip
     3365         "Внутренняя ошибка при генерации фактического номера" skip
     3366         "p-fact-date"            p-fact-date            skip
     3367         "p-fact-time"            p-fact-time            skip
     3368         "p-fact-num"             p-fact-num             skip
     3369         "p-shift-date"           p-shift-date           skip
     3370         "p-shift-num"            p-shift-num            skip
     3371         "p-shift-on"             p-shift-on             skip
     3372         "p-shift-end-fact-order" p-shift-end-fact-order skip
     3373         "p-day-end-fact-order"   p-day-end-fact-order   skip
     3374         "v-fact-date-num"        v-fact-date-num        skip
     3375         view-as alert-box error .
     3376       undo, return error return-value .
     3377     end.
     3378   end procedure.
     3379   procedure day-begin-fact-order :
     3380     define input  parameter p-fact-date            as date    no-undo .
     3381     define output parameter p-day-begin-fact-order as decimal no-undo .
     3382     do
     3383     on error undo, return error return-value
     3384     :
     3385       if p-fact-date = ?
     3386       then do:
     3387         assign
     3388           p-day-begin-fact-order = 0
     3389         .
     3390       end.
     3391       else do:
     3392         assign
     3393           p-day-begin-fact-order = integer(p-fact-date)
     3394         .
     3395       end.
     3396     end.
     3397   end procedure.
     3398   procedure factord-max-fact-order :
     3399     define output parameter p-max-fact-order as decimal   no-undo .
     3400     do
     3401     on error undo, return error return-value
     3402     :
     3403       run day-begin-fact-order in this-procedure
     3404         (input  date(1, 1, 5000)
     3405         ,output p-max-fact-order
     3406         ) .
     3407     end.
     3408   end procedure.
     3409   procedure factord-cut-archive :
     3410     define input  parameter p-obj-type             as character no-undo .
     3411     define input  parameter p-obj-code             as integer   no-undo .
     3412     define input  parameter p-fact-date            as date      no-undo .
     3413     define output parameter p-shift-on             as logical   no-undo .
     3414     define output parameter p-shift-date           as date      no-undo .
     3415     define output parameter p-shift-num            as integer   no-undo .
     3416     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3417     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3418     define variable v-fact-order as decimal   no-undo .
     3419     define buffer buf_shift-obj for ub.shift-obj .
     3420     do
     3421     on error undo, return error return-value
     3422     :
     3423   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3425     (input  p-obj-type
     3426     ,input  p-obj-code
     3427     ,input  'shift-on=request'
     3428     ,output p-shift-on
     3429     ) no-error .
     3430       if error-status :error
     3431       then do:
     3432         message
     3433           vss-workfile vss-revision vss-description skip
     3434           "Ошибка при определении атрибута объекта" skip
     3435           "Объект" p-obj-type p-obj-code skip
     3436           error-status :get-message(1) skip
     3437           return-value skip
     3438           view-as alert-box error .
     3439         undo, return error return-value .
     3440       end.
     3441       if p-shift-on = false
     3442       then do:
     3443         assign
     3444           p-shift-date               = ?
     3445           p-shift-num                = 0
     3446         .
     3447       end.
     3448       else do:
     3449         find first buf_shift-obj share-lock
     3450           where buf_shift-obj.obj-type   = p-obj-type
     3451             and buf_shift-obj.obj-code   = p-obj-code
     3452             and buf_shift-obj.shift-date > p-fact-date
     3453           use-index pi
     3454           no-error .
     3455         if not available buf_shift-obj
     3456         or buf_shift-obj.status_ <> 'зкр':U
     3457         then do:
     3458           message
     3459             vss-workfile vss-revision vss-description skip
     3460             "Невозможно вычислить последнюю смену" skip
     3461             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     3462             "Объект" p-obj-type p-obj-code skip
     3463             "Дата" p-fact-date skip
     3464             view-as alert-box error .
     3465           undo, return error return-value .
     3466         end.
     3467         find last buf_shift-obj share-lock
     3468           where buf_shift-obj.obj-type = p-obj-type
     3469             and buf_shift-obj.obj-code = p-obj-code
     3470             and buf_shift-obj.shift-date <= p-fact-date
     3471           use-index pi
     3472           no-error .
     3473         if available buf_shift-obj
     3474         then do:
     3475           if  buf_shift-obj.status_ = 'зкр':U
     3476           then do:
     3477             assign
     3478               p-shift-date = buf_shift-obj.shift-date
     3479               p-shift-num  = buf_shift-obj.shift-num
     3480             .
     3481           end.
     3482           else do:
     3483             message
     3484               vss-workfile vss-revision vss-description skip
     3485               "Невозможно вычислить последнюю смену" skip
     3486               "Статус смены отличен от статуса" 'зкр':U skip
     3487               "Объект" p-obj-type p-obj-code skip
     3488               "Дата" p-fact-date skip
     3489               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     3490               view-as alert-box error .
     3491             undo, return error return-value .
     3492           end.
     3493         end.
     3494         else do:
     3495           assign
     3496             p-shift-date = p-fact-date - 1
     3497             p-shift-num  = 1
     3498           .
     3499         end.
     3500       end.
     3501       run factord in this-procedure
     3502         (input  p-fact-date
     3503         ,input  1
     3504         ,input  1
     3505         ,input  p-shift-date
     3506         ,input  p-shift-num
     3507         ,input  p-shift-on
     3508         ,output v-fact-order
     3509         ,output p-shift-end-fact-order
     3510         ,output p-day-end-fact-order
     3511         ) no-error .
     3512       if error-status :error
     3513       then do:
     3514         message
     3515           vss-workfile vss-revision vss-description skip
     3516           "Ошибка при вызове процедуры factord"
     3517           error-status :get-message(1) skip
     3518           return-value skip
     3519           view-as alert-box error .
     3520         undo, return error return-value .
     3521       end.
     3522     end.
     3523   end procedure.
     3524   procedure factord-lock-shift :
     3525     define input  parameter p-obj-type  as character no-undo .
     3526     define input  parameter p-obj-code  as integer   no-undo .
     3527     define input  parameter p-fact-date as date      no-undo .
     3528     define parameter buffer buf_shift-obj for ub.shift-obj .
     3529     define variable v-shift-on      as logical   no-undo .
     3530     define variable v-extra-message as character no-undo .
     3531     define variable v-error as character no-undo .
     3532     do
     3533     on error undo, return error return-value
     3534     :
     3535   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3536   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3537     (input  p-obj-type
     3538     ,input  p-obj-code
     3539     ,input  'shift-on=request'
     3540     ,output v-shift-on
     3541     ) no-error .
     3542       if error-status :error
     3543       then do:
     3544         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     3545         undo, return error v-error .
     3546       end.
     3547       if v-shift-on = true
     3548       then do:
     3549         find first buf_shift-obj share-lock
     3550           where buf_shift-obj.obj-type   = p-obj-type
     3551             and buf_shift-obj.obj-code   = p-obj-code
     3552             and buf_shift-obj.shift-date > p-fact-date
     3553           use-index pi
     3554           no-error .
     3555         if not available buf_shift-obj
     3556         or buf_shift-obj.status_ <> 'зкр':U
     3557         then do:
     3558           find last buf_shift-obj
     3559             where buf_shift-obj.obj-type = p-obj-type
     3560               and buf_shift-obj.obj-code = p-obj-code
     3561               and buf_shift-obj.status_  = 'зкр':U
     3562             use-index stts
     3563             no-error .
     3564           if available buf_shift-obj
     3565           then do:
     3566             assign
     3567               v-extra-message =
     3568                     substitute("Дата начала последеней закрытой смены на объекте &1"
     3569                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     3570                               )
     3571             .
     3572           end.
     3573           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     3574           undo, return error v-error .
     3575         end.
     3576       end.
     3577     end.
     3578   end procedure.
     3579   procedure factord-end-day :
     3580     define input  parameter p-fact-date            as date    no-undo .
     3581     define output parameter p-day-end-fact-order   as decimal no-undo .
     3582     do
     3583     on error undo, return error return-value
     3584     :
     3585       if p-fact-date = ?
     3586       then do:
     3587         return error "Не указана фактическая дата" .
     3588       end.
     3589       assign
     3590         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3591       .
     3592     end.
     3593   end procedure.
     3594   procedure factord-to-date :
     3595     define input  parameter p-fact-order as decimal no-undo .
     3596     define output parameter p-fact-date  as date    no-undo .
     3597     define variable v-ref-date  as date      no-undo .
     3598     define variable v-ref-delta as integer   no-undo .
     3599     do
     3600     on error undo, return error return-value
     3601     :
     3602       if p-fact-order = ?
     3603       or p-fact-order = 0
     3604       then do:
     3605         return error "Не указан fact-order" .
     3606       end.
     3607       assign
     3608         v-ref-date  = date(1, 1, 2000)
     3609       .
     3610       assign
     3611         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     3612       .
     3613       assign
     3614         p-fact-date = v-ref-date + v-ref-delta
     3615       .
     3616     end.
     3617   end procedure.
     3618   procedure factord-to-fact-num :
     3619     define input  parameter p-fact-order as decimal no-undo .
     3620     define output parameter p-fact-num   as integer no-undo .
     3621     define variable v-fact-order-trunc as decimal no-undo .
     3622     do
     3623     on error undo, return error return-value
     3624     :
     3625       if p-fact-order = ?
     3626       or p-fact-order = 0
     3627       then do:
     3628         return error "Не указан fact-order" .
     3629       end.
     3630       assign
     3631        v-fact-order-trunc = truncate(p-fact-order, 2)
     3632       .
     3633       assign
     3634         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3635       .
     3636     end.
     3637   end procedure.
     3638   procedure factord-to-shift-num :
     3639     define input  parameter p-fact-order as decimal no-undo .
     3640     define output parameter p-shift-num   as integer no-undo .
     3641     define variable  p-shift-numd  as decimal   no-undo .
     3642     define variable v-fact-order-trunc as decimal no-undo .
     3643     do
     3644     on error undo, return error return-value
     3645     :
     3646       if p-fact-order = ?
     3647       or p-fact-order = 0
     3648       then do:
     3649         return error "Не указан fact-order" .
     3650       end.
     3651       assign
     3652        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3653       .
     3654       if v-fact-order-trunc < 0.5 then do:
     3655         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3656       end.
     3657       assign
     3658         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3659         .
     3660        assign
     3661         p-shift-num = truncate (p-shift-numd , 0)
     3662       .
     3663     end.
     3664   end procedure.
