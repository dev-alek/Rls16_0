     1342   define temp-table tt-clcparts no-undo like ub.parts
     1343   field part-cur-base like ub.gds-dtl.price-base
     1344   field part-cur-road-tax like ub.gds-dtl.price-base
     1345   field part-cur-excise like ub.gds-dtl.price-base
     1346   .
     1347   define variable v-calcbypart as log no-undo.
     1348   procedure clcprtsl_calc-parts :
     1349   define input parameter parrec-parts        as   recid                   no-undo.
     1350   define input parameter paris-doc           as   logical                 no-undo.
     1351   define input parameter paris-cur           as   logical                 no-undo.
     1352   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1353   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1354   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1355   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1356   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1357   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1358   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     1359   define input parameter parr-b              as   character               no-undo.
     1360   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     1361   define input parameter parcurroad-tax      like ub.doc-line.road-tax    no-undo.
     1362   define input parameter parcurexcise        like ub.doc-line.excise      no-undo.
