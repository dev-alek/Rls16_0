        1   block-level on error undo, throw.
        2   define input parameter pardoc-code               like ub.trn-doc.doc-code no-undo.
        3   define input parameter parcalc-sum-without-param as   logical             no-undo.
        4   define input parameter parcalc-wastage           as   logical             no-undo.
        5   define input parameter parcalc-cli               as   logical             no-undo.
        6   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: uaddsum.p $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: utl/uaddsum.p $":U .
       11   define variable vss-description as character no-undo initial "Утилита по расчету дополнительных сумм по документу":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable v-waitfram-action01         as character   no-undo .
       72   define variable v-waitfram-action02         as character   no-undo .
       73   define variable v-waitfram-action03         as character   no-undo .
       74   define variable mWaitFramTextBeg            as character   no-undo.
       75   define variable mWaitFramTextEnd            as character   no-undo.
       76   define variable mWaitFramView               as logical     no-undo.
       77   define variable mWaitProcEvent              as logical     no-undo init yes.
       78   define variable mWaitFramInterval           as integer     no-undo init 1 .
       79   define variable mWaitFramStop               as logical     no-undo.
       80   define variable mWaitFramStopUser           as logical     no-undo.
       81   define variable mWaitFramStopTimeOut        as logical     no-undo.
       82   define variable mWaitFramStartProc          as datetime-tz no-undo.
       83   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       84   define button B-WaitFramStop auto-end-key
       85        label "Стоп"
       86        size 10 by 1 tooltip "Остоновить процесс".
       87   define button B-viewProcInfo
       88        label "Информация"
       89        size 15 by 1 tooltip "Информация о процесс".
       90   define frame waitfram
       91     v-waitfram-action01 format "x(72)" no-label skip
       92     v-waitfram-action02 format "x(72)" no-label skip
       93     v-waitfram-action03 format "x(72)" no-label skip
       94     B-viewProcInfo
       95     B-WaitFramStop at row 4 col 30
       96     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       97     .
       98   define new global shared variable mBatchMode as logical no-undo init ?.
       99   define variable mFramBachModHandle as handle no-undo.
      100   mFramBachModHandle = frame waitfram:handle.
      101   define variable mFameOldVis as logical no-undo.
      102   define variable mVisCUrentVin as logical no-undo.
      103   if session:batch-mode
      104   then
      105      mBatchMode = yes.
      106   if mBatchMode = ? then do:
      107     mVisCUrentVin = current-window:visible.
      108     mFameOldVis = mFramBachModHandle:visible.
      109     mFramBachModHandle:visible  = yes.
      110     mBatchMode = mFramBachModHandle:visible ne yes.
      111     mFramBachModHandle:visible = mFameOldVis.
      112     current-window:visible = mVisCUrentVin.
      113   end.
      114    if  log-manager:logfile-name ne ?
      115     then DO:
      116         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      117         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      118         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      119     end.
      120   on choose of B-WaitFramStop in frame waitfram
      121   do:
      122     mWaitFramStop = yes.
      123     mWaitFramStopUser = yes.
      124   end.
      125   function waitfram-check-timeout returns logical():
      126      define variable vtime as int64 no-undo.
      127      if mWaitFramStopTimeOut
      128      then
      129         return yes.
      130      vtime = ( now - mWaitFramStartProc ) / 1000 .
      131      if     mWaitFramTimeOut ne ?
      132         and mWaitFramTimeOut ne 0
      133         and mWaitFramTimeOut lt vtime
      134      then do:
      135         mWaitFramStopTimeOut = yes.
      136      end.
      137      return mWaitFramStopTimeOut.
      138   end.
      139   procedure waitfram-hide :
      140     if not session:batch-mode
      141     then do
      142     on error undo, return error return-value
      143     :
      144       pause 0 before-hide .
      145       if not mBatchMode then
      146         hide frame waitfram .
      147     end.
      148   end procedure.
      149   procedure waitfram-show :
      150     define input  parameter p-message as character no-undo .
      151     define variable v-left-margin as integer   no-undo .
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       if length(p-message) <= 70 then do:
      157         assign
      158           v-left-margin = integer((70 - length(p-message)) / 2)
      159         .
      160         assign
      161           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      162         .
      163         assign
      164           v-waitfram-action01 = " "
      165           v-waitfram-action02 = " "
      166                                    + fill(" ", v-left-margin)
      167                                    + p-message
      168           v-waitfram-action03 = " "
      169         .
      170       end.
      171       else do:
      172         define variable vRindex1 as integer no-undo.
      173         define variable vRindex2 as integer no-undo.
      174         vRindex1 = r-index(p-message," ",70).
      175         if vRindex1 = 0
      176         then
      177            vRindex1 = 70.
      178         if length(p-message)  <= vRindex1 + 70 then do:
      179           assign
      180             v-waitfram-action01 = " "
      181             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      182             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      183           .
      184         end.
      185         else do:
      186           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      187           if vRindex2 <= vRindex1
      188           then
      189              vRindex2 = vRindex1 + 70.
      190           assign
      191             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      194           .
      195         end.
      196       end.
      197       B-viewProcInfo:visible   in frame waitfram = no.
      198       B-viewProcInfo:sensitive in frame waitfram = no.
      199       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       if  (   mWaitFramView
      202          or  mWaitProcEvent)
      203          and not mBatchMode
      204       then
      205          display
      206             v-waitfram-action01 skip
      207             v-waitfram-action02 skip
      208             v-waitfram-action03 skip
      209          with frame waitfram .
      210     end.
      211   end procedure.
      212      procedure waitfram-show-this:
      213         define input  parameter iInterval as int64 no-undo.
      214         define variable vtime as int64 no-undo.
      215         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      216         mWaitFramInterval = iInterval.
      217         run waitfram-show (substitute("&1&2 &3&4" ,
      218                                       mWaitFramTextBeg ,
      219                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      220                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      221                                       mWaitFramTextEnd
      222                                      )
      223                           ).
      224      end.
      225      procedure WaitFramRunPause:
      226         define input  parameter iInterval as dec no-undo.
      227         define variable vStart  as datetime-tz no-undo.
      228         define variable vend    as datetime-tz no-undo.
      229         define variable vint as int64 no-undo.
      230         define variable vOk as logical no-undo.
      231         vStart = now.
      232         vend   = vStart.
      233         publish "WaitFramPause" (iInterval,output vOk).
      234         vend   =  now.
      235         vint = vend - vStart.
      236         vint = iInterval - vint / 1000.
      237         if     not mWaitFramStop
      238            and (   vint > 0
      239                 or (    not vOk
      240                     and iInterval eq ?
      241                     )
      242                 )
      243         then
      244            run waitfram-show-this (iInterval).
      245         vend   =  now.
      246         vint = vend - vStart.
      247         vint = iInterval - vint / 1000.
      248         if     not mWaitFramStop
      249            and vint > 0
      250         then do:
      251            run gbl/pause.p (vint * 1000).
      252         end.
      253         if iInterval ne ?
      254         then
      255            publish "WaitFramStop".
      256         waitfram-check-timeout().
      257      end.
      258      procedure WaitFramWaitFor:
      259         define input  parameter iInterval as dec no-undo.
      260         assign
      261            mWaitFramStartProc   = now
      262            mWaitFramStopUser    = no
      263            mWaitFramStopTimeOut = no
      264         .
      265         block-wait:
      266         do while not mWaitFramStop:
      267            run WaitFramRunPause (iInterval).
      268            if  waitfram-check-timeout()
      269            then do:
      270               leave block-wait.
      271            end.
      272         end.
      273         run waitfram-hide.
      274      end.
      275   procedure waitfram-join :
      276     define input  parameter p-line-1  as character no-undo .
      277     define input  parameter p-line-2  as character no-undo .
      278     define input  parameter p-line-3  as character no-undo .
      279     define output parameter p-message as character no-undo .
      280     do
      281     on error undo, return error return-value
      282     :
      283       assign
      284         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      285                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      286                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      287       .
      288     end.
      289   end procedure.
      290   function waitfram-join-function returns character
      291     (input p-line-1 as character
      292     ,input p-line-2 as character
      293     ,input p-line-3 as character
      294     ).
      295     define variable v-message as character no-undo .
      296     run waitfram-join in this-procedure
      297       (input  p-line-1
      298       ,input  p-line-2
      299       ,input  p-line-3
      300       ,output v-message
      301       ) .
      302     return v-message .
      303   end function .
      304   function diff-list returns character (
      305     input parfirst-list  as character,
      306     input parsecond-list as character,
      307     input pardelim       as character).
      308     if pardelim = ""
      309     or pardelim = ?
      310     then do:
      311       assign
      312         pardelim = ","
      313       .
      314     end.
      315     def var ind as integer no-undo .
      316     def var v-elem as character no-undo .
      317     def var v-result-list as character no-undo init "".
      318     def var v-num-parfirst-list as integer no-undo .
      319     assign
      320       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      321     .
      322     do ind = 1 to v-num-parfirst-list
      323     :
      324       assign
      325         v-elem = entry(ind, parfirst-list, pardelim)
      326       .
      327       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      328         assign
      329           v-result-list = v-result-list
      330                         + (if v-result-list > "" then pardelim else "")
      331                         + v-elem
      332         .
      333       end.
      334     end.
      335     return v-result-list .
      336   end function.
      337   function add-list returns character (
      338    input parfirst-list  as character,
      339    input parsecond-list as character,
      340    input pardelim       as character).
      341     if pardelim = ""
      342     or pardelim = ?
      343     then do:
      344       assign
      345         pardelim = ","
      346       .
      347     end.
      348     def var ind as integer no-undo .
      349     def var v-elem as character no-undo .
      350     def var v-result-list as character no-undo init "".
      351     def var v-num-parfirst-list as integer no-undo .
      352     assign
      353       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      354     .
      355     do ind = 1 to v-num-parfirst-list
      356     :
      357       assign
      358         v-elem = entry(ind, parfirst-list, pardelim)
      359       .
      360       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      361         assign
      362           v-result-list = v-result-list
      363                         + (if v-result-list > "" then pardelim else "")
      364                         + v-elem
      365         .
      366       end.
      367     end.
      368     def var v-num-parsecond-list as integer no-undo .
      369     assign
      370       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      371     .
      372     do ind = 1 to v-num-parsecond-list
      373     :
      374       assign
      375         v-elem = entry(ind, parsecond-list, pardelim)
      376       .
      377       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      378         assign
      379           v-result-list = v-result-list
      380                         + (if v-result-list > "" then pardelim else "")
      381                         + v-elem
      382         .
      383       end.
      384     end.
      385     return v-result-list .
      386   end function.
      387   function cross-list returns character (
      388    input parfirst-list  as character,
      389    input parsecond-list as character,
      390    input pardelim       as character).
      391     if pardelim = ""
      392     or pardelim = ?
      393     then do:
      394       assign
      395         pardelim = ","
      396       .
      397     end.
      398     def var ind as integer no-undo .
      399     def var v-elem as character no-undo .
      400     def var v-result-list as character no-undo init "".
      401     def var v-num-parfirst-list as integer no-undo .
      402     assign
      403       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      404     .
      405     do ind = 1 to v-num-parfirst-list
      406     :
      407       assign
      408         v-elem = entry(ind, parfirst-list, pardelim)
      409       .
      410       if lookup(v-elem, v-result-list, pardelim) = 0
      411       and lookup(v-elem, parsecond-list, pardelim) > 0
      412       then do:
      413         assign
      414           v-result-list = v-result-list
      415                         + (if v-result-list > "" then pardelim else "")
      416                         + v-elem
      417         .
      418       end.
      419     end.
      420     return v-result-list .
      421   end function.
      422   function radio-label returns character (
      423    input par-rs-value  as character,
      424    input par-rs-radio-buttons as character)
      425    .
      426    DEFINE variable v-result-label as character no-undo.
      427    assign
      428    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      429                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      430                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      431                             ), par-rs-radio-buttons
      432                           )
      433    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      434    .
      435   return v-result-label.
      436   end function.
      437   function m-radio-label returns character (
      438    input par-rs-value  as character,
      439    input par-rs-radio-buttons as character,
      440    input par-delim as character
      441    )
      442    .
      443    DEFINE variable v-result-label as character no-undo.
      444    assign
      445    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      446                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      447                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      448                             ), par-rs-radio-buttons, par-delim
      449                           )
      450    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      451    .
      452   return v-result-label.
      453   end function.
      454   FUNCTION mixlist returns character
      455   (
      456    input parfirst-list  as character
      457    ,input parsecond-list as character
      458    ,input pardelim       as character
      459    ,input pardelim-result as character ) :
      460     if pardelim = ""
      461     or pardelim = ?
      462     then do:
      463       assign
      464         pardelim = ","
      465       .
      466     end.
      467     def var ind as integer no-undo .
      468     def var v-elem1 as character no-undo .
      469     def var v-elem2 as character no-undo .
      470     def var v-result-list as character no-undo init "".
      471     do ind = 1 to num-entries(parfirst-list, pardelim)
      472     :
      473       assign
      474         v-elem1 = entry(ind, parfirst-list, pardelim)
      475         v-elem2 = entry(ind, parsecond-list, pardelim)
      476       .
      477         assign
      478           v-result-list = v-result-list
      479                         + (if v-result-list > "" then pardelim-result else "")
      480                         + v-elem1 + pardelim-result + v-elem2
      481         .
      482     end.
      483     return v-result-list .
      484   END FUNCTION.
      485   define new global shared variable g#library  as handle no-undo .
      486   define new global shared variable g#library2 as handle no-undo .
      487   define new global shared variable g#lib-trn  as handle no-undo .
      488   define new global shared variable g#lib-trn2 as handle no-undo .
      489   define new global shared variable g#lib-trn3 as handle no-undo .
      490   define new global shared variable g#lib-trn4 as handle no-undo .
      491   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   define new global shared variable g#trdcalib as handle no-undo.
      493   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      495   procedure partslib-clear-temp-parts :
      496     define buffer buf_temp-parts for temp-parts .
      497     do
      498     on error undo, return error
      499     :
      500       for each buf_temp-parts
      501       on error undo, return error
      502       :
      503         delete buf_temp-parts .
      504       end.
      505     end.
      506   end procedure.
      507   procedure partslib-create-temp-parts :
      508     define parameter buffer buf_parts       for ub.parts .
      509     define parameter buffer buf_temp-parts  for temp-parts .
      510     define input  parameter p-goods-twounit as logical   no-undo .
      511     define variable v-base-part-code as character no-undo .
      512     do
      513     on error undo, return error
      514     :
      515       if p-goods-twounit = true
      516       then do:
      517         assign
      518           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      519         .
      520       end.
      521       else do:
      522         assign
      523           v-base-part-code = buf_parts.part-code
      524         .
      525       end.
      526       find first buf_temp-parts exclusive-lock
      527         where buf_temp-parts.obj-type  = buf_parts.obj-type
      528           and buf_temp-parts.obj-code  = buf_parts.obj-code
      529           and buf_temp-parts.artic     = buf_parts.artic
      530           and buf_temp-parts.prod-type = buf_parts.prod-type
      531           and buf_temp-parts.prod-code = buf_parts.prod-code
      532           and buf_temp-parts.in-code   = buf_parts.in-code
      533           and buf_temp-parts.out-code  = 'free-zone':U
      534           and buf_temp-parts.part-code = v-base-part-code
      535         no-error.
      536       if not available buf_temp-parts
      537       then do:
      538         create buf_temp-parts .
      539         buffer-copy buf_parts to buf_temp-parts
      540         assign
      541           buf_temp-parts.out-code  = 'free-zone':U
      542           buf_temp-parts.part-code = v-base-part-code
      543           buf_temp-parts.rsrv-free = yes
      544           buf_temp-parts.status_   = no
      545           buf_temp-parts.qnty      = 0
      546           buf_temp-parts.fact-qnty = 0
      547           buf_temp-parts.real-qnty = 0
      548           buf_temp-parts.cli-qnty  = 0
      549         .
      550       end.
      551     end.
      552   end procedure.
      553   procedure partslib-init-temp-parts :
      554     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      555     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      556     define input parameter p-artic           like ub.parts.artic     no-undo .
      557     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      558     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      559     define buffer buf_parts      for ub.parts .
      560     define buffer buf_temp-parts for temp-parts .
      561     define variable v-goods-twounit    as logical   no-undo .
      562     do
      563     on error undo, return error
      564     :
      565   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      567     (input  p-artic
      568     ,input  p-prod-type
      569     ,input  p-prod-code
      570     ,input  'twounit=request':u
      571     ,output v-goods-twounit
      572     ) no-error .
      573       if error-status :error
      574       then do:
      575         message
      576           vss-workfile vss-revision vss-description skip
      577           vss-include-info2 skip
      578           "Ошибка при определении атрибута товара" skip
      579           "Артикул" p-artic p-prod-type p-prod-code skip
      580           "twounit=request" skip
      581           error-status :get-message(1) skip
      582           return-value skip
      583           view-as alert-box error .
      584         undo, return error return-value .
      585       end.
      586       run partslib-clear-temp-parts in this-procedure .
      587       for each buf_parts
      588         where buf_parts.obj-type  = p-obj-type
      589           and buf_parts.obj-code  = p-obj-code
      590           and buf_parts.artic     = p-artic
      591           and buf_parts.prod-type = p-prod-type
      592           and buf_parts.prod-code = p-prod-code
      593           and buf_parts.rsrv-free = yes
      594           and buf_parts.status_   = no
      595           and buf_parts.in-code   <> buf_parts.out-code
      596       on error undo, return error
      597       :
      598         run partslib-create-temp-parts in this-procedure
      599           (buffer buf_parts
      600           ,buffer buf_temp-parts
      601           ,input  v-goods-twounit
      602           ) .
      603         define variable v-parts-qnty          as decimal   no-undo .
      604         define variable v-parts-cli-qnty      as decimal   no-undo .
      605         define variable v-parts-free-qnty     as decimal   no-undo .
      606         define variable v-parts-free-cli-qnty as decimal   no-undo .
      607         if buf_parts.out-code = 'free-zone':U
      608         then do:
      609           assign
      610             v-parts-qnty          = buf_parts.qnty
      611             v-parts-cli-qnty      = buf_parts.cli-qnty
      612             v-parts-free-qnty     = buf_parts.qnty
      613             v-parts-free-cli-qnty = buf_parts.cli-qnty
      614           .
      615         end.
      616         else do:
      617           assign
      618             v-parts-qnty          = abs(buf_parts.qnty)
      619             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      620             v-parts-free-qnty     = 0
      621             v-parts-free-cli-qnty = 0
      622           .
      623         end.
      624         assign
      625           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      626           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      627           buf_temp-parts.real-qnty     = 0
      628           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      629           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      630           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      631         .
      632       end.
      633     end.
      634   end procedure.
      635   procedure partslib-init-temp-parts-by-factord :
      636     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      637     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      638     define input parameter p-artic              like ub.parts.artic     no-undo .
      639     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      640     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      641     define input parameter p-fact-order         as decimal   no-undo .
      642     define input parameter p-include-fact-order as logical   no-undo .
      643     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      644     define buffer buf_gds-obj  for ub.gds-obj .
      645     do
      646     on error undo, return error
      647     :
      648       do transaction
      649       on error undo, return error
      650       :
      651   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      653     (input  p-obj-type
      654     ,input  p-obj-code
      655     ,input  p-artic
      656     ,input  p-prod-type
      657     ,input  p-prod-code
      658     ,buffer buf_gds-obj
      659     ) no-error .
      660         if error-status :error
      661         then do:
      662           message
      663             vss-workfile vss-revision vss-description skip
      664             vss-include-info2 skip
      665             "Невозможно найти товар на объекте" skip
      666             "Объект" p-obj-type p-obj-code skip
      667             "Артикул" p-artic p-prod-type p-prod-code skip
      668             error-status :get-message(1) skip
      669             return-value skip
      670             view-as alert-box error .
      671           undo, return error .
      672         end.
      673         find current buf_gds-obj exclusive-lock .
      674       end.
      675       run partslib-init-temp-parts in this-procedure
      676         (input p-obj-type
      677         ,input p-obj-code
      678         ,input p-artic
      679         ,input p-prod-type
      680         ,input p-prod-code
      681         ) no-error .
      682       if error-status :error
      683       then do:
      684         message
      685           vss-workfile vss-revision vss-description skip
      686           vss-include-info2 skip
      687           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      688           "Объект" p-obj-type p-obj-code skip
      689           "Артикул" p-artic p-prod-type p-prod-code skip
      690           "p-fact-order" p-fact-order skip
      691           view-as alert-box error .
      692         undo, return error .
      693       end.
      694       if p-include-fact-order = true
      695       then do:
      696         assign
      697           p-fact-order = p-fact-order - 0.0000000001
      698         .
      699       end.
      700       define variable v-max-fact-order as character no-undo .
      701       run factord-max-fact-order in this-procedure
      702         (output v-max-fact-order
      703         ) no-error .
      704       if error-status :error
      705       then do:
      706         message
      707           vss-workfile vss-revision vss-description skip
      708           vss-include-info2 skip
      709           "Ошибка при вызове процедуры factord-max-fact-order" skip
      710           "Объект" p-obj-type p-obj-code skip
      711           "Артикул" p-artic p-prod-type p-prod-code skip
      712           "p-fact-order" p-fact-order skip
      713           view-as alert-box error .
      714         undo, return error .
      715       end.
      716       run partslib-update-by-factord in this-procedure
      717         (input p-obj-type
      718         ,input p-obj-code
      719         ,input p-artic
      720         ,input p-prod-type
      721         ,input p-prod-code
      722         ,input p-fact-order
      723         ,input v-max-fact-order
      724         ,input false
      725         ) no-error .
      726       if error-status :error
      727       then do:
      728         message
      729           vss-workfile vss-revision vss-description skip
      730           vss-include-info2 skip
      731           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      732           "Объект" p-obj-type p-obj-code skip
      733           "Артикул" p-artic p-prod-type p-prod-code skip
      734           "p-fact-order" p-fact-order skip
      735           "v-max-fact-order" v-max-fact-order skip
      736           view-as alert-box error .
      737         undo, return error .
      738       end.
      739     end.
      740   end procedure.
      741   procedure partslib-update-by-factord :
      742     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      743     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      744     define input parameter p-artic              like ub.parts.artic     no-undo .
      745     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      746     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      747     define input parameter p-start-fact-order   as decimal   no-undo .
      748     define input parameter p-end-fact-order     as decimal   no-undo .
      749     define input parameter p-lock-gds-obj       as logical   no-undo .
      750     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      751     define buffer buf_gds-obj  for ub.gds-obj .
      752     define buffer buf_doc-line for ub.doc-line .
      753     define variable v-total-parts-qnty as decimal   no-undo .
      754     define variable v-goods-gds-goods  as logical   no-undo .
      755     define variable v-goods-twounit    as logical   no-undo .
      756     do
      757     on error undo, return error
      758     :
      759       if p-start-fact-order > p-end-fact-order
      760       then do:
      761         message
      762           vss-workfile vss-revision vss-description skip
      763           vss-include-info2 skip
      764           "Ошибка задания входных параметров" skip
      765           "Начало интервала превышает конец интервала" skip
      766           "Объект" p-obj-type p-obj-code skip
      767           "Артикул" p-artic p-prod-type p-prod-code skip
      768           "p-start-fact-order" p-start-fact-order skip
      769           "p-end-fact-order"   p-end-fact-order skip
      770           view-as alert-box error .
      771         undo, return error .
      772       end.
      773       if p-lock-gds-obj = true
      774       then do:
      775         do transaction
      776         on error undo, return error
      777         :
      778   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      780     (input  p-obj-type
      781     ,input  p-obj-code
      782     ,input  p-artic
      783     ,input  p-prod-type
      784     ,input  p-prod-code
      785     ,buffer buf_gds-obj
      786     ) no-error .
      787           if error-status :error
      788           then do:
      789             message
      790               vss-workfile vss-revision vss-description skip
      791               vss-include-info2 skip
      792               "Невозможно найти gds-obj" skip
      793               error-status :get-message(1) skip
      794               return-value skip
      795               view-as alert-box error .
      796             undo, return error .
      797           end.
      798           find current buf_gds-obj exclusive-lock .
      799         end.
      800       end.
      801   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      803     (input  p-artic
      804     ,input  p-prod-type
      805     ,input  p-prod-code
      806     ,input  'gds-goods=request':u
      807     ,output v-goods-gds-goods
      808     ) no-error .
      809       if error-status :error
      810       then do:
      811         message
      812           vss-workfile vss-revision vss-description skip
      813           vss-include-info2 skip
      814           "Ошибка при определении атрибута товара" skip
      815           "Артикул" p-artic p-prod-type p-prod-code skip
      816           "gds-goods=request" skip
      817           error-status :get-message(1) skip
      818           return-value skip
      819           view-as alert-box error .
      820         undo, return error return-value .
      821       end.
      822   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      824     (input  p-artic
      825     ,input  p-prod-type
      826     ,input  p-prod-code
      827     ,input  'twounit=request':u
      828     ,output v-goods-twounit
      829     ) no-error .
      830       if error-status :error
      831       then do:
      832         message
      833           vss-workfile vss-revision vss-description skip
      834           vss-include-info2 skip
      835           "Ошибка при определении атрибута товара" skip
      836           "Артикул" p-artic p-prod-type p-prod-code skip
      837           "twounit=request" skip
      838           error-status :get-message(1) skip
      839           return-value skip
      840           view-as alert-box error .
      841         undo, return error return-value .
      842       end.
      843       for each buf_doc-line no-lock
      844         where buf_doc-line.obj-type   = p-obj-type
      845           and buf_doc-line.obj-code   = p-obj-code
      846           and buf_doc-line.artic      = p-artic
      847           and buf_doc-line.prod-type  = p-prod-type
      848           and buf_doc-line.prod-code  = p-prod-code
      849           and buf_doc-line.status_    = 'факт':U
      850           and buf_doc-line.fact-order > p-start-fact-order
      851           and buf_doc-line.fact-order <= p-end-fact-order
      852       on error undo, return error
      853       :
      854         run partslib-process-document in this-procedure
      855           (input  buf_doc-line.doc-code
      856           ,input  p-obj-type
      857           ,input  p-obj-code
      858           ,input  p-artic
      859           ,input  p-prod-type
      860           ,input  p-prod-code
      861           ,input  v-goods-gds-goods
      862           ,input  v-goods-twounit
      863           ,output v-total-parts-qnty
      864           ) no-error .
      865         if error-status :error
      866         then do:
      867           message
      868             vss-workfile vss-revision vss-description skip
      869             vss-include-info2 skip
      870             "Ошибка при вызове процедуры partslib-process-document" skip
      871             "Документ" buf_doc-line.doc-code skip
      872             "Объект" p-obj-type p-obj-code skip
      873             "Артикул" p-artic p-prod-type p-prod-code skip
      874             "p-start-fact-order" p-start-fact-order skip
      875             "p-end-fact-order" p-end-fact-order skip
      876             error-status :get-message(1) skip
      877             return-value skip
      878             view-as alert-box error .
      879           undo, return error return-value .
      880         end.
      881       end.
      882     end.
      883   end procedure.
      884   procedure partslib-process-document :
      885     define input  parameter p-doc-code         as character no-undo .
      886     define input  parameter p-obj-type         as character no-undo .
      887     define input  parameter p-obj-code         as integer   no-undo .
      888     define input  parameter p-artic            as character no-undo .
      889     define input  parameter p-prod-type        as character no-undo .
      890     define input  parameter p-prod-code        as integer   no-undo .
      891     define input  parameter p-goods-gds-goods  as logical   no-undo .
      892     define input  parameter p-goods-twounit    as logical   no-undo .
      893     define output parameter p-total-parts-qnty as decimal   no-undo .
      894     define variable v-parts-sign as integer   no-undo .
      895     define buffer buf_trn-doc    for ub.trn-doc .
      896     define buffer buf_doc-line   for ub.doc-line .
      897     define buffer buf_parts      for ub.parts .
      898     define buffer buf_temp-parts for temp-parts .
      899     do
      900     on error undo, return error return-value
      901     :
      902       find first buf_trn-doc no-lock
      903         where buf_trn-doc.doc-code = p-doc-code
      904         no-error .
      905       if not available buf_trn-doc
      906       then do:
      907         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      908                                      ,p-doc-code
      909                                      ) .
      910       end.
      911       case buf_trn-doc.doc-type
      912       :
      913         when 'при':U or
      914         when 'возврат':U or
      915         when 'инв':U
      916         then do:
      917           assign
      918             v-parts-sign = -1
      919           .
      920         end.
      921         when 'рас':U or
      922         when 'спи':U
      923         then do:
      924           assign
      925             v-parts-sign = 1
      926           .
      927         end.
      928         otherwise do:
      929           undo, return error substitute("Неизвестный тип документа &1"
      930                                       ,buf_trn-doc.doc-type
      931                                       ) .
      932         end.
      933       end.
      934       find first buf_doc-line no-lock
      935         where buf_doc-line.doc-code  = p-doc-code
      936           and buf_doc-line.artic     = p-artic
      937           and buf_doc-line.prod-type = p-prod-type
      938           and buf_doc-line.prod-code = p-prod-code
      939         no-error .
      940       if not available buf_doc-line
      941       then do:
      942         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      943                                      ,p-doc-code
      944                                      ,artic
      945                                      ,prod-type
      946                                      ,prod-code
      947                                      ) .
      948       end.
      949       assign
      950         p-total-parts-qnty = 0
      951       .
      952       if p-goods-gds-goods = true
      953       then do:
      954         for each buf_parts no-lock
      955           where buf_parts.out-code  = p-doc-code
      956             and buf_parts.obj-type  = p-obj-type
      957             and buf_parts.obj-code  = p-obj-code
      958             and buf_parts.artic     = p-artic
      959             and buf_parts.prod-type = p-prod-type
      960             and buf_parts.prod-code = p-prod-code
      961         on error undo, return error
      962         :
      963           run partslib-create-temp-parts in this-procedure
      964             (buffer buf_parts
      965             ,buffer buf_temp-parts
      966             ,input  p-goods-twounit
      967             ) .
      968           assign
      969             p-total-parts-qnty        = p-total-parts-qnty
      970                                       + v-parts-sign * buf_parts.fact-qnty
      971             buf_temp-parts.qnty       = buf_temp-parts.qnty
      972                                       + v-parts-sign * buf_parts.fact-qnty
      973             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      974                                       + v-parts-sign * buf_parts.fact-qnty
      975             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      976                                       + v-parts-sign * buf_parts.cli-qnty
      977           .
      978           if buf_temp-parts.qnty = 0
      979           then do:
      980             delete buf_temp-parts .
      981           end.
      982         end.
      983       end.
      984       else do:
      985         assign
      986           p-total-parts-qnty = p-total-parts-qnty
      987                              + v-parts-sign * buf_doc-line.fact-qnty
      988         .
      989       end.
      990     end.
      991   end procedure.
      992   procedure partslib-init-temp-parts-by-date :
      993     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      994     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      995     define input parameter p-artic           like ub.parts.artic     no-undo .
      996     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      997     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      998     define input parameter p-fact-date       as date      no-undo .
      999     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1000     do
     1001     on error undo, return error
     1002     :
     1003       define variable v-fact-order                as decimal   no-undo .
     1004       define variable v-shift-end-fact-order      as decimal   no-undo .
     1005       define variable v-day-end-fact-order        as decimal   no-undo .
     1006       run factord in this-procedure
     1007         (input  p-fact-date
     1008         ,input  1
     1009         ,input  1
     1010         ,input  ?
     1011         ,input  0
     1012         ,input  false
     1013         ,output v-fact-order
     1014         ,output v-shift-end-fact-order
     1015         ,output v-day-end-fact-order
     1016         ) no-error .
     1017       if error-status :error
     1018       then do:
     1019         message
     1020           vss-workfile vss-revision vss-description skip
     1021           vss-include-info2 skip
     1022           "Ошибка при определении момента времени, на который требуется остаток" skip
     1023           "Объект" p-obj-type p-obj-code skip
     1024           "Артикул" p-artic p-prod-type p-prod-code skip
     1025           "Дата" p-fact-date skip
     1026           view-as alert-box error .
     1027         undo, return error .
     1028       end.
     1029       run partslib-init-temp-parts-by-factord in this-procedure
     1030         (input p-obj-type
     1031         ,input p-obj-code
     1032         ,input p-artic
     1033         ,input p-prod-type
     1034         ,input p-prod-code
     1035         ,input v-day-end-fact-order
     1036         ,input false
     1037         ) no-error .
     1038       if error-status :error
     1039       then do:
     1040         message
     1041           vss-workfile vss-revision vss-description skip
     1042           vss-include-info2 skip
     1043           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1044           "Объект" p-obj-type p-obj-code skip
     1045           "Артикул" p-artic p-prod-type p-prod-code skip
     1046           "Дата" p-fact-date skip
     1047           view-as alert-box error .
     1048         undo, return error .
     1049       end.
     1050     end.
     1051   end procedure.
     1052   procedure partslib-calc-cost :
     1053     define output parameter p-fact-qnty      as decimal   no-undo .
     1054     define output parameter p-vat-pc         as decimal   no-undo .
     1055     define output parameter p-slt-pc         as decimal   no-undo .
     1056     define output parameter p-sum-base       as decimal   no-undo .
     1057     define output parameter p-sum-rubl       as decimal   no-undo .
     1058     define output parameter p-vat-base       as decimal   no-undo .
     1059     define output parameter p-vat-rubl       as decimal   no-undo .
     1060     define output parameter p-slt-base       as decimal   no-undo .
     1061     define output parameter p-slt-rubl       as decimal   no-undo .
     1062     define output parameter p-road-tax-base  as decimal   no-undo .
     1063     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1064     define output parameter p-transport-base as decimal   no-undo .
     1065     define output parameter p-transport-rubl as decimal   no-undo .
     1066     define output parameter p-other-base     as decimal   no-undo .
     1067     define output parameter p-other-rubl     as decimal   no-undo .
     1068     define output parameter p-excise-base    as decimal   no-undo .
     1069     define output parameter p-excise-rubl    as decimal   no-undo .
     1070     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1071     do
     1072     on error undo, return error return-value
     1073     :
     1074       define buffer buf_temp-parts for temp-parts .
     1075       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1076       define buffer   in-vatp-parts    for ub.parts   .
     1077       define buffer   in-vatp-doc      for ub.trn-doc .
     1078       define buffer   in-vatp-goods    for ub.goods   .
     1079       define buffer   in-vatp-sysconf  for ub.sysconf .
     1080       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1081       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1082       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1083       define variable varinvprb                  as   character              no-undo.
     1084       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1085       define variable cli-base-rate              as   decimal                no-undo.
     1086       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1087       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1088       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1089       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1090       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1091       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1092       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1093       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1094       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1095       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1096       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1097       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1098       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1099       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1100       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1101       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1102       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1103       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1104       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1105       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1106       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1107       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1108       define variable varinvatp-envd             as   character              no-undo.
     1109       define variable varinvatp-type             as   character              no-undo.
     1110       for each buf_temp-parts
     1111       on error undo, return error
     1112       :
     1113   assign
     1114     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1115     price-base-with-tax-loc = buf_temp-parts.price-base
     1116   .
     1117   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1118   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1119     (output varinvprb
     1120     )  .
     1121     if buf_temp-parts.out-code = 'free-zone':U     or
     1122        buf_temp-parts.out-code = 'out-zone':U   or
     1123        buf_temp-parts.doc-type = 'акт':U then do:
     1124       assign
     1125         in-vatp-have-vat-slt = yes.
     1126     end.
     1127     else do:
     1128       find first in-vatp_doc-attr no-lock
     1129         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1130           and in-vatp_doc-attr.attr-code = 'envd':U
     1131         no-error .
     1132       if not available in-vatp_doc-attr then do:
     1133         assign
     1134           in-vatp-have-vat-slt = yes.
     1135       end.
     1136       else do:
     1137            in-vatp-have-vat-slt = no.
     1138       end.
     1139     end.
     1140     assign
     1141      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1142      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1143     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1144              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1145     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1146             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1147             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1148             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1149             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1150             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1151             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1152       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1153     assign
     1154       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1155     assign
     1156       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1157       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1158       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1159       transport-cli-loc  = 0
     1160       other-cli-loc      = 0
     1161     .
     1162   ASSIGN
     1163             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1164       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1165   .
     1166         assign
     1167           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1168           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1169           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1170           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1171           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1172           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1173           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1174           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1175           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1176           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1177           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1178           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1179           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1180           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1181           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1182           p-excise-base    = p-excise-base    + 0
     1183           p-excise-rubl    = p-excise-rubl    + 0
     1184         .
     1185       end.
     1186       if p-fact-qnty      = ?
     1187       or p-sum-base       = ?
     1188       or p-sum-rubl       = ?
     1189       or p-vat-base       = ?
     1190       or p-vat-rubl       = ?
     1191       or p-slt-base       = ?
     1192       or p-slt-rubl       = ?
     1193       or p-road-tax-base  = ?
     1194       or p-road-tax-rubl  = ?
     1195       or p-transport-base = ?
     1196       or p-transport-rubl = ?
     1197       or p-other-base     = ?
     1198       or p-other-rubl     = ?
     1199       or p-excise-base    = ?
     1200       or p-excise-rubl    = ?
     1201       then do:
     1202         message
     1203           vss-workfile vss-revision vss-description skip
     1204           vss-include-info2 skip
     1205           "Программа in-vatp.i вернула неопределенные значения" skip
     1206           "p-fact-qnty"      p-fact-qnty      skip
     1207           "p-sum-base"       p-sum-base       skip
     1208           "p-sum-rubl"       p-sum-rubl       skip
     1209           "p-vat-base"       p-vat-base       skip
     1210           "p-vat-rubl"       p-vat-rubl       skip
     1211           "p-slt-base"       p-slt-base       skip
     1212           "p-slt-rubl"       p-slt-rubl       skip
     1213           "p-road-tax-base"  p-road-tax-base  skip
     1214           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1215           "p-transport-base" p-transport-base skip
     1216           "p-transport-rubl" p-transport-rubl skip
     1217           "p-other-base"     p-other-base     skip
     1218           "p-other-rubl"     p-other-rubl     skip
     1219           "p-excise-base"    p-excise-base    skip
     1220           "p-excise-rubl"    p-excise-rubl    skip
     1221           view-as alert-box error .
     1222         undo, return error .
     1223       end.
     1224     end.
     1225   end procedure.
     1226   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1227   define temp-table tt-allsum-line      no-undo
     1228   field sum-type           as   character
     1229   field fact-qnty          like ub.doc-line.fact-qnty
     1230   field cli-qnty           like ub.doc-line.cli-qnty
     1231   field sum-dsc-base-doc   like ub.doc-line.price-base
     1232   field sum-dsc-rubl-doc   like ub.doc-line.price-base
     1233   field dsc-base-doc       like ub.doc-line.price-base
     1234   field dsc-rubl-doc       like ub.doc-line.price-base
     1235   field vat-base-doc       like ub.doc-line.price-base
     1236   field vat-rubl-doc       like ub.doc-line.price-base
     1237   field vat-base-buyer-doc like ub.doc-line.price-base
     1238   field vat-rubl-buyer-doc like ub.doc-line.price-base
