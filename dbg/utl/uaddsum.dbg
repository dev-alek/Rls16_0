     2673   procedure clcprtsl_calc-line :
     2674   define input  parameter parrec-line as recid no-undo.
     2675   define variable v-tax-date         as   date                     no-undo.
     2676   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2677   define variable varr-b             as   character                no-undo.
     2678   define variable varr-btype         as   character                no-undo.
     2679   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2680   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2681   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2682   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2683   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2684   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2685   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2686   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2687   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2688   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2689   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2690   define variable varexcise          like ub.price-list.excise     no-undo.
     2691   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2692   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2693   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2694   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2695   define variable v-varsum           as decimal                  no-undo.
     2696   define variable varprice-salef as decimal   no-undo .
     2697   define buffer bf_trn-doc             for ub.trn-doc.
     2698   define buffer bf_doc-line            for ub.doc-line.
     2699   define buffer bf_gds-dtl             for ub.gds-dtl.
     2700   define buffer bf_goods               for ub.goods.
     2701   define buffer bf_parts               for ub.parts.
     2702   define buffer bf_sysconf             for ub.sysconf.
     2703   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2704   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2705   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2706   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2707   define buffer buf_parts        for ub.parts.
     2708   v-calcbypart = no.
     2709   do on error undo, return error return-value :
     2710   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2711   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2712     (output varr-b
     2713     )  .
     2714     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2715     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2716     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2717                               bf_goods.prod-type = bf_doc-line.prod-type and
     2718                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2719     if bf_trn-doc.fact-date <> ?        then do:
     2720       assign v-tax-date = bf_trn-doc.fact-date.
     2721     end.
     2722     else do:
     2723       assign v-tax-date = ?.
     2724     end.
