     4262   end.
     4263   procedure local-create-sum :
     4264     define input parameter parsum-type as character no-undo.
     4265     define buffer bf_trn-doc-sum  for ub.trn-doc-sum.
     4266     define buffer bf_doc-line-sum for ub.doc-line-sum.
     4267     do on error undo, return error return-value :
     4268       find first bf_trn-doc-sum exclusive-lock where
     4269                  bf_trn-doc-sum.doc-code = bf_trn-doc.doc-code and
     4270                  bf_trn-doc-sum.sum-type = parsum-type         no-error.
     4271       if not available bf_trn-doc-sum then do:
     4272   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_crtrnsum in g#lib-rwds ( input bf_trn-doc.doc-code ,
     4273                          input parsum-type ) no-error .
     4274         if error-status :error then do:
     4275           return error substitute( "Ошибка при вызове процедуры lib-rwds_crtrnsum &1 &2."
     4276                                  , return-value
     4277                                  , error-status :get-message( 1 ) ).
     4278         end.
     4279       end.
     4280       else do:
     4281   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_cltrnsum in g#lib-rwds ( input bf_trn-doc.doc-code ,
     4282                          input parsum-type ) no-error .
     4283         if error-status :error then do:
     4284           return error substitute( "Ошибка при вызове процедуры lib-rwds_cltrnsum &1 &2."
     4285                                  , return-value
     4286                                  , error-status :get-message( 1 ) ).
     4287         end.
     4288         if lookup( parsum-type, varvalue ) = 0 then do:
     4289           assign
     4290             varvalue = varvalue + min( varvalue, "," ) + parsum-type.
     4291   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input bf_trn-doc.doc-code ,
     4292                          input 'addsum':U ,
     4293                          input varvalue ) no-error .
     4294           if error-status :error then do:
     4295             run waitfram-hide in this-procedure no-error.
     4296             undo, return error substitute( 'Ошибка &1 &2 на вызове программы tdat-wrt при расчете естественной убыли '
     4297                                          + 'по документу "&3".'
     4298                                          , return-value
     4299                                          , error-status :get-message( 1 )
     4300                                          , bf_trn-doc.doc-code ).
     4301           end.
     4302         end.
     4303       end.
     4304       if parsum-type <> 'ext':U     and
     4305          parsum-type <> 'extc':U and
     4306          parsum-type <> 'mis':U      and
     4307          parsum-type <> 'misc':U  then do:
     4308         assign
     4309           varcount = 0.
     4310         for each bf_doc-line where
     4311                  bf_doc-line.doc-code = bf_trn-doc.doc-code
     4312         on error undo, return error return-value :
     4313           assign
     4314             varcount = varcount + 1.
     4315           run waitfram-show in this-procedure (
     4316             input waitfram-join-function ( substitute( 'Создаем недостающие линии сумм типа "&1".', parsum-type ),
     4317                                            substitute( "Обработано строк: &1", varcount ),
     4318                                            substitute( "Время &1.", string( time - vartime, "hh:mm:ss":U ) )
     4319                                          )    ) no-error.
     4320           find first bf_goods no-lock where
     4321                      bf_goods.artic     = bf_doc-line.artic     and
     4322                      bf_goods.prod-type = bf_doc-line.prod-type and
     4323                      bf_goods.prod-code = bf_doc-line.prod-code.
     4324           find first bf_doc-line-sum exclusive-lock where
     4325                      bf_doc-line-sum.doc-code = bf_doc-line.doc-code and
     4326                      bf_doc-line-sum.gds-code = bf_goods.gds-code    and
     4327                      bf_doc-line-sum.sum-type = parsum-type          no-error.
     4328           if not available bf_doc-line-sum then do:
     4329   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_crlinsum in g#lib-rwds ( input bf_trn-doc.doc-code ,
     4330                          input parsum-type ,
     4331                          input bf_doc-line.artic ,
     4332                          input bf_doc-line.prod-type ,
     4333                          input bf_doc-line.prod-code ) no-error .
     4334             if error-status :error then do:
     4335               return error substitute( "Ошибка при вызове процедуры lib-rwds_crlinsum &1 &2."
     4336                                      , return-value
     4337                                      , error-status :get-message( 1 ) ).
     4338             end.
     4339           end.
     4340         end.
     4341       end.
     4342     end.
     4343   end procedure.
