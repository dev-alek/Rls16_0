        1   block-level on error undo, throw.
        2    define input-output parameter pFile as character no-undo.
        3   function objExists return character
        4   (input  ifolder as character,
        5    input  iType   as character  ):
        6       define variable vFileType as character no-undo init "D,F".
        7       define variable vi        as integer no-undo.
        8       define variable vtype as character no-undo.
        9       if iType ne ?
       10       then
       11          vFileType = iType.
       12       do vi = 1 to num-entries(vFileType):
       13          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       14          vtype = file-information:file-type.
       15          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       16             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       17             index(vtype , entry(vi,vFileType )) > 0
       18          then return file-information:full-pathname .
       19          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       20          vtype = file-information:file-type.
       21          if file-information:file-name <> "" and
       22             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       23             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       24             index( vtype, entry(vi,vFileType )) > 0
       25          then return file-information:full-pathname .
       26       end.
       27       return ? .
       28   end.
       29   function SearchFile return character
       30   (input  ifile as character):
       31      return objExists(ifile,?).
       32   end.
       33   function SearchPFile return character
       34   (input inFile as char):
       35        define variable oFile       as character no-undo.
       36        define variable vFileSearch as character no-undo.
       37        define variable vNumEntry   as integer no-undo.
       38        if inFile = "" then return ?.
       39        vNumEntry = num-entries(inFile,".").
       40        vFileSearch = inFile.
       41        if    vNumEntry > 0
       42           and (   entry(vNumEntry,inFile,".") eq "p"
       43                or entry(vNumEntry,inFile,".") eq "w")
       44        then do:
       45           entry(vNumEntry,vFileSearch, ".") = "r".
       46           oFile = search(vFileSearch ).
       47           if oFile eq ?
       48           then
       49              oFile = search(inFile).
       50        end.
       51        else
       52           oFile = search(vFileSearch).
       53        return oFile.
       54     end.
       55    define variable mFileR    as character no-undo.
       56    define variable mFileDBG  as character no-undo.
       57    define variable mFileRs as character no-undo.
       58    define variable mExt   as character no-undo.
       59    define variable mNum as integer no-undo.
       60    mNum = num-entries(pfile,".").
       61    mExt = entry(mnum,pfile,".").
       62    if    mExt eq "p"
       63       or mExt eq "w"
       64       or mExt eq "cls"
       65    then do:
       66       Pfile = SearchPFile(pfile).
       67       assign
       68          mFileR = Pfile
       69          entry(mnum,mFileR,".") = "r"
       70          mFileDBG= Pfile
       71          entry(mnum,mFileDBG,".") = "dbg"
       72          mFileR = replace (mFileR,"\","/")
       73          mNum = num-entries(mFileR,"/")
       74          mFileR = entry(mnum,mFileR,"/")
       75          mFileDBG = replace (mFileDBG,"\","/")
       76          mNum = num-entries(mFileDBG,"/")
       77          mFileDBG = "./" + entry(mnum,mFileDBG,"/")
       78       .
       79       mFileRs = search(mFileR).
       80       os-delete value( mFileRs ).
       81       compile
       82           value( Pfile )
       83           save into  "."
       84            DEBUG-LIST VALUE ( mFileDBG )
       85           min-size
       86         no-error .
       87        if error-status :error
       88        or compiler :error
       89        or compiler :warning
       90        then do:
       91          define variable v-counter as integer  no-undo.
       92          define variable v-compiler-error as character no-undo.
       93          define variable vRow             as integer init -10 no-undo.
       94          do v-counter = 1 to compiler :num-messages
       95          :
       96            if vRow ne compiler :get-error-row( v-counter )
       97            then do:
       98               v-compiler-error = substitute( "&2 &1 Cтрока &3":U
       99                                             , "~n":U
      100                                             , v-compiler-error
      101                                             , compiler :get-error-row( v-counter )
      102                                             )
      103               no-error.
      104               vRow = compiler :get-error-row( v-counter ).
      105            end.
      106            v-compiler-error = substitute( "&1 &2 &3":U
      107                                             , v-compiler-error
      108                                             , compiler :get-message( v-counter )
      109                                             , vRow
      110                                             )
      111            no-error.
      112          end.
      113          do v-counter = 1 to error-status :num-messages
      114          :
      115            assign
      116                v-compiler-error = substitute( "&2 &3 &1":U
      117                                             ,vRow
      118                                             , "~n":U
      119                                             , v-compiler-error
      120                                             , error-status :get-message( v-counter )
      121                                             )
      122            no-error.
      123          end.
      124          message v-compiler-error
      125          view-as alert-box.
      126        end.
      127    end.
      128    else if    mExt eq "r"
      129    then
      130      mFileR = pfile .
      131    pfile = SearchPFile(mFileR).
