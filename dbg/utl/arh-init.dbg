      599     .
      600   procedure userobjs_clear :
      601     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      602     do
      603     on error undo, return error return-value
      604     :
      605       for each buf_userobjs_temp-user-obj
      606       on error undo, return error return-value
      607       :
      608         delete buf_userobjs_temp-user-obj .
      609       end.
      610     end.
      611   end .
      612   procedure userobjs_object-count :
      613     define output parameter p-total-count as integer   no-undo .
      614     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      615     do
      616     on error undo, return error return-value
      617     :
      618       assign
      619         p-total-count = 0
      620       .
      621       for each buf_userobjs_temp-user-obj
      622       on error undo, return error return-value
      623       :
      624         assign
      625           p-total-count = p-total-count + 1
      626         .
      627       end.
      628     end.
      629   end.
      630   procedure userobjs_append :
      631      define input  parameter p-obj-type as character no-undo .
      632      define input  parameter p-obj-code as integer   no-undo .
      633     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      634     do
      635     on error undo, return error return-value
      636     :
      637       find first buf_userobjs_temp-user-obj
      638         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      639           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      640         no-error .
      641       if not available buf_userobjs_temp-user-obj
      642       then do:
      643         create buf_userobjs_temp-user-obj .
      644         assign
      645           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      646           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      647         .
      648       end.
      649     end.
      650   end.
      651   procedure userobjs_object-exist :
      652     define output parameter p-object-exist as logical   no-undo .
      653     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      654     do
      655     on error undo, return error return-value
      656     :
      657       find first buf_userobjs_temp-user-obj
      658         no-error .
      659       if not available buf_userobjs_temp-user-obj
      660       then do:
      661         assign
      662           p-object-exist = false
      663         .
      664       end.
      665       else do:
      666         assign
      667           p-object-exist = true
      668         .
      669       end.
      670     end.
      671   end.
      672   procedure userobjs_transfer :
      673     define input  parameter p-callback-handle as handle no-undo .
      674     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      675     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      676     do
      677     on error undo, return error return-value
      678     :
      679       if valid-handle(p-callback-handle) <> true
      680       then do:
      681         message
      682           vss-workfile vss-revision vss-description skip
      683           "Ошибка задания входных параметров" skip
      684           "Неизвестный указатель на процедуру" skip
      685           view-as alert-box error .
      686         undo, return error return-value .
      687       end.
      688       if p-callback-handle :get-signature("userobjs_append") = ""
      689       then do:
      690         message
      691           vss-workfile vss-revision vss-description skip
      692           "Ошибка задания входных параметров" skip
      693           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      694                     ,p-callback-handle :file-name
      695                     ) skip
      696           view-as alert-box error .
      697         undo, return error return-value .
      698       end.
      699       for each buf_userobjs_temp-user-obj
      700       on error undo, return error return-value
      701       :
      702         run userobjs_append in p-callback-handle
      703           (input  buf_userobjs_temp-user-obj.obj-type
      704           ,input  buf_userobjs_temp-user-obj.obj-code
      705           ) .
      706       end.
      707     end.
      708   end procedure.
      709   procedure userobjs_select-one :
      710      define input  parameter parparentproc     as widget-handle no-undo .
