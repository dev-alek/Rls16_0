      782   end.
      783   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   procedure factord :
      785     define input  parameter p-fact-date            as date    no-undo .
      786     define input  parameter p-fact-time            as integer no-undo .
      787     define input  parameter p-fact-num             as integer no-undo .
      788     define input  parameter p-shift-date           as date    no-undo .
      789     define input  parameter p-shift-num            as integer no-undo .
      790     define input  parameter p-shift-on             as logical no-undo .
      791     define output parameter p-fact-order           as decimal no-undo .
      792     define output parameter p-shift-end-fact-order as decimal no-undo .
      793     define output parameter p-day-end-fact-order   as decimal no-undo .
      794     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      795     if p-fact-date = ?
      796     then do:
      797       return error "Не указана фактическая дата" .
      798     end.
      799     define variable v-fact-date-num as integer no-undo .
      800     assign
      801       v-fact-date-num = integer(p-fact-date)
      802     .
      803     if p-fact-num = ?
      804     or p-fact-num = 0
      805     then do:
      806       return error "Не задан p-fact-num " + string(p-fact-num) .
      807     end.
      808     if p-fact-num < 0
      809     then do:
      810       return error "Отрицательный fact-num " + string(p-fact-num) .
      811     end.
      812     if p-fact-num >= 100000000
      813     then do:
      814       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      815     end.
      816     if p-shift-on = true
      817     then do:
      818       if p-shift-date = ?
      819       then do:
      820         return error "Не задана дата смены" .
      821       end.
      822       if p-shift-num = ?
      823       or p-shift-num = 0
      824       then do:
      825         return error "Не задан номер смены" .
      826       end.
      827     end.
      828     else do:
      829       assign
      830         p-shift-date = p-fact-date
      831         p-shift-num  = 24
      832       .
      833     end.
      834     define variable v-shift-offset as integer no-undo .
      835     if p-shift-date = p-fact-date
      836     then do:
      837       assign
      838         v-shift-offset = 1
      839       .
      840     end.
      841     if p-shift-date < p-fact-date
      842     then do:
      843       assign
      844         v-shift-offset = 0
      845       .
      846     end.
      847     if p-shift-date > p-fact-date
      848     then do:
      849       message
      850         vss-workfile vss-revision vss-description skip
      851         "Неправильная дата закрытия смены" skip
      852         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      853         view-as alert-box error .
      854       undo, return error
      855         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      856           ,string(p-fact-date, '99/99/9999':U)
      857           ,string(p-shift-date, '99/99/9999':U)
      858           )
      859       .
      860     end.
      861     if p-shift-num < 1
      862     or p-shift-num > 24
      863     then do:
      864       message
      865         vss-workfile vss-revision vss-description skip
      866         "Неправильный номер смены" skip
      867         "p-shift-num" p-shift-num skip
      868         view-as alert-box error .
      869       undo, return error return-value .
      870     end.
      871     assign
      872       p-fact-order           = v-fact-date-num
      873                              + v-shift-offset * 0.5
      874                              + p-shift-num    * 0.02 - 0.01
      875                              + p-fact-num     * 0.0000000001
      876       p-shift-end-fact-order = v-fact-date-num
      877                              + v-shift-offset * 0.5
      878                              + p-shift-num    * 0.02
      879       p-day-end-fact-order   = v-fact-date-num
      880                              + 0.99
      881     .
      882     if p-fact-order           <= v-fact-date-num
      883     or p-shift-end-fact-order <= v-fact-date-num
      884     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      885     or p-shift-end-fact-order >= p-day-end-fact-order
      886     then do:
      887       message
      888         vss-workfile vss-revision vss-description skip
      889         "Внутренняя ошибка при генерации фактического номера" skip
      890         "p-fact-date"            p-fact-date            skip
      891         "p-fact-time"            p-fact-time            skip
      892         "p-fact-num"             p-fact-num             skip
      893         "p-shift-date"           p-shift-date           skip
      894         "p-shift-num"            p-shift-num            skip
      895         "p-shift-on"             p-shift-on             skip
      896         "p-shift-end-fact-order" p-shift-end-fact-order skip
      897         "p-day-end-fact-order"   p-day-end-fact-order   skip
      898         "v-fact-date-num"        v-fact-date-num        skip
      899         view-as alert-box error .
      900       undo, return error return-value .
      901     end.
      902   end procedure.
      903   procedure day-begin-fact-order :
      904     define input  parameter p-fact-date            as date    no-undo .
      905     define output parameter p-day-begin-fact-order as decimal no-undo .
      906     do
      907     on error undo, return error return-value
      908     :
      909       if p-fact-date = ?
      910       then do:
      911         assign
      912           p-day-begin-fact-order = 0
      913         .
      914       end.
      915       else do:
      916         assign
      917           p-day-begin-fact-order = integer(p-fact-date)
      918         .
      919       end.
      920     end.
      921   end procedure.
      922   procedure factord-max-fact-order :
      923     define output parameter p-max-fact-order as decimal   no-undo .
      924     do
      925     on error undo, return error return-value
      926     :
      927       run day-begin-fact-order in this-procedure
      928         (input  date(1, 1, 5000)
      929         ,output p-max-fact-order
      930         ) .
      931     end.
      932   end procedure.
      933   procedure factord-cut-archive :
      934     define input  parameter p-obj-type             as character no-undo .
      935     define input  parameter p-obj-code             as integer   no-undo .
      936     define input  parameter p-fact-date            as date      no-undo .
      937     define output parameter p-shift-on             as logical   no-undo .
      938     define output parameter p-shift-date           as date      no-undo .
      939     define output parameter p-shift-num            as integer   no-undo .
      940     define output parameter p-day-end-fact-order   as decimal   no-undo .
      941     define output parameter p-shift-end-fact-order as decimal   no-undo .
      942     define variable v-fact-order as decimal   no-undo .
      943     define buffer buf_shift-obj for ub.shift-obj .
      944     do
      945     on error undo, return error return-value
      946     :
      947   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      949     (input  p-obj-type
      950     ,input  p-obj-code
      951     ,input  'shift-on=request'
      952     ,output p-shift-on
      953     ) no-error .
      954       if error-status :error
      955       then do:
      956         message
      957           vss-workfile vss-revision vss-description skip
      958           "Ошибка при определении атрибута объекта" skip
      959           "Объект" p-obj-type p-obj-code skip
      960           error-status :get-message(1) skip
      961           return-value skip
      962           view-as alert-box error .
      963         undo, return error return-value .
      964       end.
      965       if p-shift-on = false
      966       then do:
      967         assign
      968           p-shift-date               = ?
      969           p-shift-num                = 0
      970         .
      971       end.
      972       else do:
      973         find first buf_shift-obj share-lock
      974           where buf_shift-obj.obj-type   = p-obj-type
      975             and buf_shift-obj.obj-code   = p-obj-code
      976             and buf_shift-obj.shift-date > p-fact-date
      977           use-index pi
      978           no-error .
      979         if not available buf_shift-obj
      980         or buf_shift-obj.status_ <> 'зкр':U
      981         then do:
      982           message
      983             vss-workfile vss-revision vss-description skip
      984             "Невозможно вычислить последнюю смену" skip
      985             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      986             "Объект" p-obj-type p-obj-code skip
      987             "Дата" p-fact-date skip
      988             view-as alert-box error .
      989           undo, return error return-value .
      990         end.
      991         find last buf_shift-obj share-lock
      992           where buf_shift-obj.obj-type = p-obj-type
      993             and buf_shift-obj.obj-code = p-obj-code
      994             and buf_shift-obj.shift-date <= p-fact-date
      995           use-index pi
      996           no-error .
      997         if available buf_shift-obj
      998         then do:
      999           if  buf_shift-obj.status_ = 'зкр':U
     1000           then do:
     1001             assign
     1002               p-shift-date = buf_shift-obj.shift-date
     1003               p-shift-num  = buf_shift-obj.shift-num
     1004             .
     1005           end.
     1006           else do:
     1007             message
     1008               vss-workfile vss-revision vss-description skip
     1009               "Невозможно вычислить последнюю смену" skip
     1010               "Статус смены отличен от статуса" 'зкр':U skip
     1011               "Объект" p-obj-type p-obj-code skip
     1012               "Дата" p-fact-date skip
     1013               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1014               view-as alert-box error .
     1015             undo, return error return-value .
     1016           end.
     1017         end.
     1018         else do:
     1019           assign
     1020             p-shift-date = p-fact-date - 1
     1021             p-shift-num  = 1
     1022           .
     1023         end.
     1024       end.
     1025       run factord in this-procedure
     1026         (input  p-fact-date
     1027         ,input  1
     1028         ,input  1
     1029         ,input  p-shift-date
     1030         ,input  p-shift-num
     1031         ,input  p-shift-on
     1032         ,output v-fact-order
     1033         ,output p-shift-end-fact-order
     1034         ,output p-day-end-fact-order
     1035         ) no-error .
     1036       if error-status :error
     1037       then do:
     1038         message
     1039           vss-workfile vss-revision vss-description skip
     1040           "Ошибка при вызове процедуры factord"
     1041           error-status :get-message(1) skip
     1042           return-value skip
     1043           view-as alert-box error .
     1044         undo, return error return-value .
     1045       end.
     1046     end.
     1047   end procedure.
     1048   procedure factord-lock-shift :
     1049     define input  parameter p-obj-type  as character no-undo .
     1050     define input  parameter p-obj-code  as integer   no-undo .
     1051     define input  parameter p-fact-date as date      no-undo .
     1052     define parameter buffer buf_shift-obj for ub.shift-obj .
     1053     define variable v-shift-on      as logical   no-undo .
     1054     define variable v-extra-message as character no-undo .
     1055     define variable v-error as character no-undo .
     1056     do
     1057     on error undo, return error return-value
     1058     :
     1059   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1061     (input  p-obj-type
     1062     ,input  p-obj-code
     1063     ,input  'shift-on=request'
     1064     ,output v-shift-on
     1065     ) no-error .
     1066       if error-status :error
     1067       then do:
     1068         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1069         undo, return error v-error .
     1070       end.
     1071       if v-shift-on = true
     1072       then do:
     1073         find first buf_shift-obj share-lock
     1074           where buf_shift-obj.obj-type   = p-obj-type
     1075             and buf_shift-obj.obj-code   = p-obj-code
     1076             and buf_shift-obj.shift-date > p-fact-date
     1077           use-index pi
     1078           no-error .
     1079         if not available buf_shift-obj
     1080         or buf_shift-obj.status_ <> 'зкр':U
     1081         then do:
     1082           find last buf_shift-obj
     1083             where buf_shift-obj.obj-type = p-obj-type
     1084               and buf_shift-obj.obj-code = p-obj-code
     1085               and buf_shift-obj.status_  = 'зкр':U
     1086             use-index stts
     1087             no-error .
     1088           if available buf_shift-obj
     1089           then do:
     1090             assign
     1091               v-extra-message =
     1092                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1093                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1094                               )
     1095             .
     1096           end.
     1097           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1098           undo, return error v-error .
     1099         end.
     1100       end.
     1101     end.
     1102   end procedure.
     1103   procedure factord-end-day :
     1104     define input  parameter p-fact-date            as date    no-undo .
     1105     define output parameter p-day-end-fact-order   as decimal no-undo .
     1106     do
     1107     on error undo, return error return-value
     1108     :
     1109       if p-fact-date = ?
     1110       then do:
     1111         return error "Не указана фактическая дата" .
     1112       end.
     1113       assign
     1114         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1115       .
     1116     end.
     1117   end procedure.
     1118   procedure factord-to-date :
     1119     define input  parameter p-fact-order as decimal no-undo .
     1120     define output parameter p-fact-date  as date    no-undo .
     1121     define variable v-ref-date  as date      no-undo .
     1122     define variable v-ref-delta as integer   no-undo .
     1123     do
     1124     on error undo, return error return-value
     1125     :
     1126       if p-fact-order = ?
     1127       or p-fact-order = 0
     1128       then do:
     1129         return error "Не указан fact-order" .
     1130       end.
     1131       assign
     1132         v-ref-date  = date(1, 1, 2000)
     1133       .
     1134       assign
     1135         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1136       .
     1137       assign
     1138         p-fact-date = v-ref-date + v-ref-delta
     1139       .
     1140     end.
     1141   end procedure.
     1142   procedure factord-to-fact-num :
     1143     define input  parameter p-fact-order as decimal no-undo .
     1144     define output parameter p-fact-num   as integer no-undo .
     1145     define variable v-fact-order-trunc as decimal no-undo .
     1146     do
     1147     on error undo, return error return-value
     1148     :
     1149       if p-fact-order = ?
     1150       or p-fact-order = 0
     1151       then do:
     1152         return error "Не указан fact-order" .
     1153       end.
     1154       assign
     1155        v-fact-order-trunc = truncate(p-fact-order, 2)
     1156       .
     1157       assign
     1158         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1159       .
     1160     end.
     1161   end procedure.
     1162   procedure factord-to-shift-num :
     1163     define input  parameter p-fact-order as decimal no-undo .
     1164     define output parameter p-shift-num   as integer no-undo .
     1165     define variable  p-shift-numd  as decimal   no-undo .
     1166     define variable v-fact-order-trunc as decimal no-undo .
     1167     do
     1168     on error undo, return error return-value
     1169     :
     1170       if p-fact-order = ?
     1171       or p-fact-order = 0
     1172       then do:
     1173         return error "Не указан fact-order" .
     1174       end.
     1175       assign
     1176        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1177       .
     1178       if v-fact-order-trunc < 0.5 then do:
     1179         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1180       end.
     1181       assign
     1182         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1183         .
     1184        assign
     1185         p-shift-num = truncate (p-shift-numd , 0)
     1186       .
     1187     end.
     1188   end procedure.
     1189   define stream slog .
     1190   define variable v-total-err   as integer   no-undo .
     1191   define variable v-error-count as integer   no-undo .
     1192   do
     1193   on error undo, return error return-value
     1194   :
     1195     define variable v-cut-date                  as date      no-undo .
     1196     run select-cut-date in this-procedure
     1197       (output v-cut-date
     1198       ) .
     1199     if v-cut-date = ?
     1200     then do:
     1201       return .
     1202     end.
     1203     define variable v-num as integer no-undo .
     1204   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1205     run mainmenu_getcntxt in parparentproc
     1206       (output v-cntxt-db-num
     1207       ,output v-cntxt-userid
     1208       ,output v-cntxt-level
     1209       ,output v-cntxt-host-code-obj
     1210       ,output v-cntxt-obj-type
     1211       ,output v-cntxt-obj-code
     1212       ,output v-cntxt-db-num-obj
     1213       ,output v-cntxt-is-admin
     1214       ) .
     1215     run gbl/d-askw.w
     1216       (input "Вопрос"
     1217       ,input "Инициализация начальных остатков складского архива по товарам" + chr(10)
     1218              + substitute("на дату &1", string(v-cut-date, '99/99/9999':u)) + chr(10)
     1219              + "На сменных объектах смена должна быть открыта, иначе эти объекты не будут обработаны"
     1220       ,input "|^"
     1221       ,input "Все объекты^confirm|Выбрать объекты|Отмена"
     1222       ,input "|"
     1223           + "|"
     1224           + ""
     1225       ,input 1
     1226       ,input 3
     1227       ,output v-num
     1228       ).
     1229     case v-num :
     1230       when 1
     1231       then do:
     1232         define buffer buf_db for ub.db .
     1233         define buffer buf_clients for ub.clients .
     1234         define variable v-db-num as integer   no-undo .
     1235   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1237     (output v-db-num
     1238     )  .
     1239         for each buf_db no-lock
     1240           where v-db-num = 0
     1241              or (v-db-num <> 0
     1242                  and buf_db.db-num = v-db-num
     1243                 )
     1244         on error undo, return error return-value
     1245         :
     1246           for each buf_clients no-lock
     1247             where buf_clients.db-num = buf_db.db-num
     1248           on error undo, return error
     1249           :
     1250             define variable v-attr-arh-disable-chr  as character no-undo .
     1251             define variable v-attr-arh-disable-type as character no-undo .
     1252             define variable v-attr-arh-disable      as logical   no-undo .
     1253             run clntattr-value in this-procedure
     1254               (input  buf_clients.obj-type
     1255               ,input  buf_clients.obj-code
     1256               ,input  'arh-disable':U
     1257               ,output v-attr-arh-disable-chr
     1258               ,output v-attr-arh-disable-type
     1259               ).
     1260             assign
     1261               v-attr-arh-disable = lookup(v-attr-arh-disable-chr, "yes,true") > 0
     1262             .
     1263             if  v-attr-arh-disable <> true
     1264             and buf_clients.stts = 0
     1265             then do:
     1266               run utl/inobarh.p
     1267                 (input  buf_clients.obj-type
     1268                 ,input  buf_clients.obj-code
     1269                 ,input  v-cut-date
     1270                 ,output v-error-count
     1271                 ) no-error .
     1272                 if error-status :error then
     1273                   message
     1274                     error-status :get-message(1) skip
     1275                     return-value skip
     1276                     "Ошибка при инициализации на объекте"
     1277                     buf_clients.obj-type
     1278                     buf_clients.obj-code
     1279                     view-as alert-box error
     1280                   .
     1281               assign
     1282                 v-total-err = v-total-err
     1283                             + v-error-count
     1284               .
     1285             end.
     1286           end.
     1287         end.
     1288       end.
     1289       when 2
     1290       then do:
     1291         define variable v-user-select as logical   no-undo .
     1292   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   run userobjs_select-many in this-procedure
     1294     (input  parparentproc
     1295     ,input  v-cntxt-db-num
     1296     ,input  v-cntxt-userid
     1297     ,input  v-cntxt-host-code-obj
     1298     ,input  v-cntxt-obj-type
     1299     ,input  v-cntxt-obj-code
     1300     ,output v-user-select
     1301     )  .
     1302         if v-user-select <> true
     1303         then do:
     1304           message
     1305             "Объект не выбран"
     1306             view-as alert-box information .
     1307           return .
     1308         end.
     1309         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1310         for each buf_userobjs_temp-user-obj
     1311         on error undo, return error return-value
     1312         :
     1313           find first buf_clients no-lock
     1314             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     1315               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     1316             .
     1317           run clntattr-value in this-procedure
     1318             (input  buf_clients.obj-type
     1319             ,input  buf_clients.obj-code
     1320             ,input  'arh-disable':U
     1321             ,output v-attr-arh-disable-chr
     1322             ,output v-attr-arh-disable-type
     1323             ).
     1324           assign
     1325             v-attr-arh-disable = lookup(v-attr-arh-disable-chr, "yes,true") > 0
     1326           .
     1327           if  v-attr-arh-disable <> true
     1328           and buf_clients.stts   = 0
     1329           then do:
     1330             run utl/inobarh.p
     1331               (input  buf_clients.obj-type
     1332               ,input  buf_clients.obj-code
     1333               ,input  v-cut-date
     1334               ,output v-error-count
     1335                 ) no-error .
     1336                 if error-status :error then
     1337                   message
     1338                     error-status :get-message(1) skip
     1339                     return-value skip
     1340                     "Ошибка при инициализации на объекте"
     1341                     buf_clients.obj-type
     1342                     buf_clients.obj-code
     1343                     view-as alert-box error
     1344                   .
     1345             assign
     1346               v-total-err = v-total-err
     1347                           + v-error-count
     1348             .
     1349           end.
     1350         end.
     1351       end.
     1352       otherwise do:
     1353         return .
     1354       end.
     1355     end.
     1356     if v-total-err <> 0
     1357     then do:
     1358       message
     1359         "Инициализация начальных остатков завершена" skip
     1360         "При расчет были обнаружены ошибки" skip
     1361         "Всего ошибок" v-total-err skip
     1362         "Подробная информация об ошибках выведена в файлы в текущей рабочей директории" skip
     1363         view-as alert-box error .
     1364     end.
     1365     else do:
     1366       message
     1367         "Инициализация начальных остатков успешно завершена" skip
     1368         "Запустите расчет складского архива по товарам (objarh.p)" skip
     1369         view-as alert-box information .
     1370     end.
     1371   end.
     1372   procedure select-cut-date :
     1373     define output parameter p-cut-date as date      no-undo .
     1374     do
     1375     on error undo, return error return-value
     1376     :
     1377       define variable v-today as date      no-undo .
     1378       define variable v-time  as integer   no-undo .
     1379       run cur-time in this-procedure
     1380         (output v-today
     1381         ,output v-time
     1382         ) .
     1383       assign
     1384         p-cut-date     = v-today
     1385       .
     1386       define variable v-string-last-fact-date as character no-undo .
     1387       assign
     1388         v-string-last-fact-date = string(p-cut-date, '99/99/9999':u)
     1389       .
     1390       run gbl/d-prompt.w
     1391         ( 'title=':u + "Введите дату" + '\':u
     1392         + 'text1=':u + "Введите дату, за которую будет проинициализирован складской архив" + '\':u
     1393         + 'text2=':u + "Обычно это первый день года, квартала или месяца" + '\':u
     1394         + 'type=date\':u
     1395         ,input-output v-string-last-fact-date
     1396         ).
     1397       if return-value = 'false':u
     1398       then do:
     1399         undo, return error return-value .
     1400       end.
     1401       assign
     1402         p-cut-date = date(v-string-last-fact-date)
     1403       .
     1404       if p-cut-date = ?
     1405       then do:
     1406         undo, return error return-value .
     1407       end.
     1408       define variable lok as logical   no-undo .
     1409       assign
     1410         lok = false
     1411       .
     1412       message
     1413         "После инициализации складского архива" skip
     1414         "вы сможете закрывать документы в системе за дату" string(p-cut-date, "99/99/9999" ) skip
     1415         "В отчетах вы сможете запрашивать информацию только за более позднюю дату" skip
     1416         "При запрашивании информации об остатках, оборотах за более раннюю дату вы получите ноль" skip
     1417         "" skip
     1418         "ВНИМАНИЕ!!!!" skip
     1419         "Если у вас был рассчитанный складской архив, он будет удален" skip
     1420         "и вы сможете получить отчеты только после расчета складского архива при помощи программы" skip
     1421         "Расчет складского архива по товарам" skip
     1422         "" skip
     1423         "Продолжить?" skip
     1424         view-as alert-box question buttons yes-no update lok .
     1425       if lok <> true
     1426       then do:
     1427         undo, return error return-value .
     1428       end.
     1429       assign
     1430         lok = false
     1431       .
     1432       message
     1433         "У вас имеется работоспособная резервная копия вашей системы," skip
     1434         "которую вы сделали непосредственно перед запуском данной программы?" skip
     1435         view-as alert-box question buttons yes-no update lok .
     1436       if lok <> true
     1437       then do:
     1438         undo, return error return-value .
     1439       end.
     1440       if p-cut-date > v-today + 1
     1441       then do:
     1442         assign
     1443           lok = false
     1444         .
     1445         message
     1446           "Первый день работы системы," skip
     1447           "когда вы можете закрывать документы" p-cut-date skip
     1448           "Завтра" v-today + 1 skip
     1449           "Вы уверены, что не хотите закрывать документы завтра?"
     1450           "Продолжить инициализацию складского архива по товарам?" skip
     1451           view-as alert-box question buttons yes-no update lok .
     1452         if lok <> true
     1453         then do:
     1454           undo, return error return-value .
     1455         end.
     1456       end.
     1457     end.
     1458   end procedure.
