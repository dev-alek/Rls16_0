      765   procedure thobjs :
      766      define input        parameter parparentproc     as widget-handle no-undo .
      767      define input        parameter i-bttns           as character     no-undo .
      768      define input        parameter i-list-mode       as character     no-undo.
      769      define input        parameter i-obj-type        as character     no-undo.
      770      define input        parameter i-db-num          as integer       no-undo.
      771      define input        parameter i-host-code       as integer       no-undo.
