      422   on choose of btn-ok in frame f-dialog do:
      423     if NOT v-can-write THEN DO:
      424       message "Укажите путь для сохранения файлов." view-as alert-box error.
      425       apply "entry" to btn-dir in frame f-dialog.
      426       return no-apply.
      427     END.
      428     assign v-obj-code .
      429     if v-obj-code > 0 then . else do:
      430       message "Укажите код магазина, остатки которого требуется выгрузить." view-as alert-box error.
      431       apply "entry" to v-obj-code in frame f-dialog.
      432       return no-apply.
      433     end .
      434   end .
      435     do on end-key undo, return :
      436       v-can-write = false .
      437       c_cli-list = "":U .
      438       update
      439         v-obj-code
      440         c_cli-list
      441         btn-dir
      442         btn-ok
      443         btn-cancel
      444       with frame f-dialog.
      445     end .
      446     assign
      447       v-obj-type = 'маг':U
      448       c_cli-list = replace(c_cli-list, ' ', '')
      449       c_size     = num-entries(c_cli-list)
      450     .
      451     do c_ind = 1 to c_size :
      452       entry(c_ind, c_cli-list) = left-trim( entry(c_ind, c_cli-list), "0" ) .
      453     end .
      454   function fnamereplace returns character (input p-fname as character) :
      455   define variable v-fname as character no-undo .
      456     v-fname = replace(p-fname, '"', '') .
      457     v-fname = replace(v-fname, '\', '-') .
      458     v-fname = replace(v-fname, '/', '-') .
      459     v-fname = replace(v-fname, "'", "") .
      460     v-fname = replace(v-fname, ':', '') .
      461     v-fname = replace(v-fname, '?', '') .
      462     v-fname = replace(v-fname, '|', '') .
      463     v-fname = replace(v-fname, '>', '') .
      464     v-fname = replace(v-fname, '<', '') .
      465     return v-fname .
      466   end function .
      467       define buffer buf_stk-tot for ub.stk-tot .
      468       find last buf_stk-tot no-lock
      469           where buf_stk-tot.obj-type = v-obj-type
      470             and buf_stk-tot.obj-code = v-obj-code
      471             and buf_stk-tot.sum-type = 'crsa':U
      472             and buf_stk-tot.cat-id   = '##,##':U
      473       USE-INDEX Shift-num no-error .
      474       if available buf_stk-tot then v-start-fact-order = buf_stk-tot.Fact-order .
      475       else do:
      476         message
      477           substitute( "Для объекта &3&4 на сегодня отсуствуют предшествующие остатки"
      478                     , v-obj-type, v-obj-code
      479           )
      480         view-as alert-box error .
      481         return .
      482       end .
      483   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      485     (input  v-obj-type
      486     ,input  v-obj-code
      487     ,output v-host-code
      488     )  .
      489       assign
      490         v-wait-msg = "Сбор текущих остатков. Строк: &1"
      491         v-lines    = 0
      492         v-ln-prev  = v-lines + 100
      493         v-tm-prev  = time + 1
      494         v-now   = now
      495         v-mtime = mtime (v-now)
      496         v-stime = string (integer(truncate(v-mtime / 1000, 0)), "hh:mm")
      497         v-sdate = substitute(  "&1&2&3&4&5",
      498           string(year(v-now),"9999"),  string(month(v-now),"99"),  string(day(v-now),"99"),
      499           substring(v-stime, 1, 2),  substring(v-stime, 4, 2)
      500         )
      501       .
      502       run waitfram-show in this-procedure (substitute(v-wait-msg, v-lines)) .
      503       v-fpref = substitute("&1\&2&3_&4", v-dir-name, v-obj-type, v-obj-code, v-sdate) no-error .
      504   define stream f-log .
      505   define variable f-logname as character no-undo .
      506     f-logname = substitute("&1.log", v-fpref) no-error .
      507   output stream f-log to value(f-logname) .
      508       empty temp-table tt-rest.
      509       for each buf_gds-obj no-lock
      510          where buf_gds-obj.obj-type = v-obj-type
      511            and buf_gds-obj.obj-code = v-obj-code :
      512   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      513     (
      514        input buf_gds-obj.artic
      515     ,  input buf_gds-obj.prod-type
      516     ,  input buf_gds-obj.prod-code
      517     , output is-petrolium
      518     , output is-pieces
      519     ) .
      520         if is-petrolium then next .
      521   put stream f-log unformatted "01 товар " buf_gds-obj.artic " " buf_gds-obj.prod-type " " buf_gds-obj.prod-code skip .
      522         for each buf_parts no-lock
      523            where buf_parts.out-code  = 'free-zone':U
      524              and buf_parts.obj-type  = buf_gds-obj.obj-type
      525              and buf_parts.obj-code  = buf_gds-obj.obj-code
      526              and buf_parts.artic     = buf_gds-obj.artic
      527              and buf_parts.prod-type = buf_gds-obj.prod-type
      528              and buf_parts.prod-code = buf_gds-obj.prod-code
      529            :
      530           v-lines = v-lines + 1 .
      531           if v-lines > v-ln-prev then do:
      532             v-ln-prev = v-lines + 100.
      533             if v-tm-prev < time then do:
      534               v-tm-prev  = time + 1 .
      535               run waitfram-show in this-procedure (substitute(v-wait-msg, v-lines)) .
      536             end .
      537           end.
      538   put stream f-log unformatted "02 партия " buf_parts.supp-code " [" + left-trim( string(buf_parts.supp-code), "0") + "] " can-do (c_cli-list, left-trim( string(buf_parts.supp-code), "0")) skip .
      539           if c_cli-list <> "" then do:
      540             c_supp-code = left-trim( string(buf_parts.supp-code), "0") no-error .
      541             if not can-do (c_cli-list, c_supp-code) then next .
      542           end .
      543           assign
      544             v-supp-code = buf_parts.supp-code
      545             v-cont-code = buf_parts.contract-code
      546           .
      547   put stream f-log unformatted "03 выгрузка " v-supp-code skip .
      548           v-srok-god = trim(string(buf_parts.last-date, "99/99/9999")) no-error .
      549           create buf_tt-rest .
      550           assign
      551             buf_tt-rest.contract-code = v-cont-code
      552             buf_tt-rest.supp-code     = v-supp-code
      553             buf_tt-rest.gds-code      = buf_gds-obj.gds-code
      554             buf_tt-rest.artic     = buf_parts.artic
      555             buf_tt-rest.part-code = buf_parts.part-code
      556             buf_tt-rest.in-code   = buf_parts.in-code
      557             buf_tt-rest.fact-qnty = buf_parts.fact-qnty
      558             buf_tt-rest.prc_rubl  = buf_parts.price-rubl
      559             buf_tt-rest.sum_rubl  = buf_parts.fact-qnty * buf_parts.price-rubl
      560             buf_tt-rest.vat-tax-value = 0
      561             buf_tt-rest.supp-type = buf_parts.supp-type
      562             buf_tt-rest.name-gtd  = trim(buf_parts.cst-code)
      563             buf_tt-rest.srok-god  = if v-srok-god = ? then "" else v-srok-god
      564           .
      565         end .
      566       end .
      567       run waitfram-show in this-procedure (substitute(v-wait-msg, v-lines)) .
      568   output stream f-log close .
      569     v-wait-msg = "Проставление ставок налога" .
      570     run waitfram-show in this-procedure (v-wait-msg) .
      571     for each buf_tt-rest break by buf_tt-rest.gds-code :
      572       if first-of (buf_tt-rest.gds-code) then do :
      573         run найти_ставку_ндс in this-procedure
      574             ( buf_tt-rest.gds-code
      575             , v-host-code
      576             , v-obj-type
      577             , v-obj-code
      578             , v-start-fact-order
      579             , output v-vat-tax-value
      580             ) .
      581       end .
      582       buf_tt-rest.vat-tax-value = v-vat-tax-value .
      583     end .
      584     v-wait-msg = "Выгрузка в файл" .
      585     run waitfram-show in this-procedure (v-wait-msg) .
      586     f-name = substitute("&1.adb", v-fpref) no-error .
      587     output stream f-txt to value (f-name) .
      588     for each buf_tt-rest break by buf_tt-rest.supp-code by buf_tt-rest.contract-code :
      589       if first-of (buf_tt-rest.contract-code) then do :
      590         if buf_tt-rest.contract-code > 0 then do :
      591           find first buf_contract no-lock
      592                where  buf_contract.contract-code = buf_tt-rest.contract-code no-error .
      593           if available buf_contract then do:
      594                v-contn = buf_contract.contract-prn-code .
      595           end .
      596           else v-contn = "0" .
      597         end .
      598         else   v-contn = "0" .
      599       end .
      600       put stream f-txt unformatted
      601             substitute("PART: &1;", buf_tt-rest.artic)
      602             ";"
      603             substitute("&1;", buf_tt-rest.part-code)
      604             substitute("&1;", buf_tt-rest.in-code)
      605             buf_tt-rest.gds-code ";"
      606             buf_tt-rest.prc_rubl ";"
      607             buf_tt-rest.fact-qnty ";"
      608             ";"
      609             ";"
      610             ";"
      611             buf_tt-rest.vat-tax-value ";"
      612             ";"
      613             ";"
      614             buf_tt-rest.name-gtd ";"
      615             ";"
      616             ";"
      617             buf_tt-rest.srok-god ";"
      618             ";"
      619             ";"
      620             buf_tt-rest.supp-code ";"
      621             buf_tt-rest.supp-type  ";"
      622             v-contn skip
      623       .
      624     end .
      625     output stream f-txt close .
      626     run waitfram-hide in this-procedure .
      627   message "Выгрузка закончена." view-as alert-box information buttons ok.
      628   procedure найти_ставку_ндс private :
      629   define input parameter p-gds-code  as integer no-undo .
      630   define input parameter p-host-code as integer no-undo .
      631   define input parameter p-obj-type  as character no-undo .
      632   define input parameter p-obj-code  as integer no-undo .
      633   define input parameter p-start-fact-order as decimal no-undo .
      634   define output parameter p-vat-tax-value as decimal no-undo .
      635   define buffer buf_tax-rate-gds   for ub.tax-rate-gds .
      636   define buffer buf_tax-rate-value for ub.tax-rate-value .
      637         find last buf_tax-rate-gds no-lock
      638             where buf_tax-rate-gds.gds-code  = p-gds-code
      639               and buf_tax-rate-gds.tax-code  = 1
      640               and buf_tax-rate-gds.host-code = p-host-code
      641               and buf_tax-rate-gds.obj-type  = p-obj-type
      642               and buf_tax-rate-gds.obj-code  = p-obj-code
      643               and buf_tax-rate-gds.fact-order <= p-start-fact-order no-error .
      644         if not available buf_tax-rate-gds then
      645         find last buf_tax-rate-gds no-lock
      646             where buf_tax-rate-gds.gds-code  = p-gds-code
      647               and buf_tax-rate-gds.tax-code  = 1
      648               and buf_tax-rate-gds.host-code = 0
      649               and buf_tax-rate-gds.obj-type  = ''
      650               and buf_tax-rate-gds.obj-code  = 0
      651               and buf_tax-rate-gds.fact-order <= p-start-fact-order no-error.
      652         if available buf_tax-rate-gds then do:
      653           find last buf_tax-rate-value no-lock
      654               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      655                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      656                 and buf_tax-rate-value.host-code = p-host-code
      657                 and buf_tax-rate-value.obj-type  = p-obj-type
      658                 and buf_tax-rate-value.obj-code  = p-obj-code
      659                 and buf_tax-rate-value.fact-order <= p-start-fact-order
      660                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      661           if not available buf_tax-rate-value then
      662           find last buf_tax-rate-value no-lock
      663               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      664                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      665                 and buf_tax-rate-value.host-code = p-host-code
      666                 and buf_tax-rate-value.obj-type  = ""
      667                 and buf_tax-rate-value.obj-code  = 0
      668                 and buf_tax-rate-value.fact-order <= p-start-fact-order
      669                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      670           if not available buf_tax-rate-value then
      671           find last buf_tax-rate-value no-lock
      672               where buf_tax-rate-value.tax-code  = buf_tax-rate-gds.tax-code
      673                 and buf_tax-rate-value.rate-code = buf_tax-rate-gds.rate-code
      674                 and buf_tax-rate-value.host-code = 0
      675                 and buf_tax-rate-value.obj-type  = ""
      676                 and buf_tax-rate-value.obj-code  = 0
      677                 and buf_tax-rate-value.fact-order <= p-start-fact-order
      678                 and buf_tax-rate-value.status_   = 'тек':U no-error .
      679           p-vat-tax-value = if available buf_tax-rate-value then buf_tax-rate-value.rate-value else 0 .
      680         end .
      681         else p-vat-tax-value = 0 .
      682   end procedure.
