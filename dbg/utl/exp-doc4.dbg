      402   define frame f-dialog
      403             space(1) v-obj-code attr-space auto-return format ">>>>>>>>9" view-as fill-in native
      404                                 label "Введите код магазина для выгрузки остатков"
      405     skip(1)
      406             space(1) "Введите коды выгружаемых поставщиков (пусто - по всем поставщикам)"
      407     skip(0) space(1) c_cli-list attr-space auto-return format "x(320)" no-label view-as fill-in native size-chars 65 by 1
      408     skip(1) space(1) btn-dir    label "Выбрать директорию выгрузки"
      409                      v-dir-name format "x(20)" no-label view-as text
      410     skip(1) space(1) btn-ok     label "Продолжить"
      411             space(1) btn-cancel label "Отменить"
