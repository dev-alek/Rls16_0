        1   DEFINE BUFFER X_dis-time-rule FOR ub.dis-time-rule.
        2   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter bttns as character no-undo .
        4   define input-output parameter p-rid-list as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Список шаблонов правил расписаний".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   define variable v-waitfram-action01         as character   no-undo .
       67   define variable v-waitfram-action02         as character   no-undo .
       68   define variable v-waitfram-action03         as character   no-undo .
       69   define variable mWaitFramTextBeg            as character   no-undo.
       70   define variable mWaitFramTextEnd            as character   no-undo.
       71   define variable mWaitFramView               as logical     no-undo.
       72   define variable mWaitProcEvent              as logical     no-undo init yes.
       73   define variable mWaitFramInterval           as integer     no-undo init 1 .
       74   define variable mWaitFramStop               as logical     no-undo.
       75   define variable mWaitFramStopUser           as logical     no-undo.
       76   define variable mWaitFramStopTimeOut        as logical     no-undo.
       77   define variable mWaitFramStartProc          as datetime-tz no-undo.
       78   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       79   define button B-WaitFramStop auto-end-key
       80        label "Стоп"
       81        size 10 by 1 tooltip "Остоновить процесс".
       82   define button B-viewProcInfo
       83        label "Информация"
       84        size 15 by 1 tooltip "Информация о процесс".
       85   define frame waitfram
       86     v-waitfram-action01 format "x(72)" no-label skip
       87     v-waitfram-action02 format "x(72)" no-label skip
       88     v-waitfram-action03 format "x(72)" no-label skip
       89     B-viewProcInfo
       90     B-WaitFramStop at row 4 col 30
       91     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       92     .
       93   define new global shared variable mBatchMode as logical no-undo init ?.
       94   define variable mFramBachModHandle as handle no-undo.
       95   mFramBachModHandle = frame waitfram:handle.
       96   define variable mFameOldVis as logical no-undo.
       97   define variable mVisCUrentVin as logical no-undo.
       98   if session:batch-mode
       99   then
      100      mBatchMode = yes.
      101   if mBatchMode = ? then do:
      102     mVisCUrentVin = current-window:visible.
      103     mFameOldVis = mFramBachModHandle:visible.
      104     mFramBachModHandle:visible  = yes.
      105     mBatchMode = mFramBachModHandle:visible ne yes.
      106     mFramBachModHandle:visible = mFameOldVis.
      107     current-window:visible = mVisCUrentVin.
      108   end.
      109    if  log-manager:logfile-name ne ?
      110     then DO:
      111         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      112         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      113         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      114     end.
      115   on choose of B-WaitFramStop in frame waitfram
      116   do:
      117     mWaitFramStop = yes.
      118     mWaitFramStopUser = yes.
      119   end.
      120   function waitfram-check-timeout returns logical():
      121      define variable vtime as int64 no-undo.
      122      if mWaitFramStopTimeOut
      123      then
      124         return yes.
      125      vtime = ( now - mWaitFramStartProc ) / 1000 .
      126      if     mWaitFramTimeOut ne ?
      127         and mWaitFramTimeOut ne 0
      128         and mWaitFramTimeOut lt vtime
      129      then do:
      130         mWaitFramStopTimeOut = yes.
      131      end.
      132      return mWaitFramStopTimeOut.
      133   end.
      134   procedure waitfram-hide :
      135     if not session:batch-mode
      136     then do
      137     on error undo, return error return-value
      138     :
      139       pause 0 before-hide .
      140       if not mBatchMode then
      141         hide frame waitfram .
      142     if     not mWaitFramView
      143        and mWaitProcEvent
      144     then
      145       process events .
      146     end.
      147   end procedure.
      148   procedure waitfram-show :
      149     define input  parameter p-message as character no-undo .
      150     define variable v-left-margin as integer   no-undo .
      151     if not session:batch-mode
      152     then do
      153     on error undo, return error return-value
      154     :
      155       if length(p-message) <= 70 then do:
      156         assign
      157           v-left-margin = integer((70 - length(p-message)) / 2)
      158         .
      159         assign
      160           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      161         .
      162         assign
      163           v-waitfram-action01 = " "
      164           v-waitfram-action02 = " "
      165                                    + fill(" ", v-left-margin)
      166                                    + p-message
      167           v-waitfram-action03 = " "
      168         .
      169       end.
      170       else do:
      171         define variable vRindex1 as integer no-undo.
      172         define variable vRindex2 as integer no-undo.
      173         vRindex1 = r-index(p-message," ",70).
      174         if vRindex1 = 0
      175         then
      176            vRindex1 = 70.
      177         if length(p-message)  <= vRindex1 + 70 then do:
      178           assign
      179             v-waitfram-action01 = " "
      180             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      181             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      182           .
      183         end.
      184         else do:
      185           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      186           if vRindex2 <= vRindex1
      187           then
      188              vRindex2 = vRindex1 + 70.
      189           assign
      190             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      191             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      192             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      193           .
      194         end.
      195       end.
      196       B-viewProcInfo:visible   in frame waitfram = no.
      197       B-viewProcInfo:sensitive in frame waitfram = no.
      198       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       if  (   mWaitFramView
      201          or  mWaitProcEvent)
      202          and not mBatchMode
      203       then
      204          display
      205             v-waitfram-action01 skip
      206             v-waitfram-action02 skip
      207             v-waitfram-action03 skip
      208          with frame waitfram .
      209       if     mWaitFramView
      210          then do:
      211             if     mWaitFramInterval ne ?
      212                and not mBatchMode
      213             then
      214                wait-for go of frame waitfram pause mWaitFramInterval.
      215          end.
      216          else
      217             if     mWaitProcEvent
      218                and not mBatchMode
      219             then
      220                process events .
      221     end.
      222   end procedure.
      223      procedure waitfram-show-this:
      224         define input  parameter iInterval as int64 no-undo.
      225         define variable vtime as int64 no-undo.
      226         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      227         mWaitFramInterval = iInterval.
      228         run waitfram-show (substitute("&1&2 &3&4" ,
      229                                       mWaitFramTextBeg ,
      230                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      231                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      232                                       mWaitFramTextEnd
      233                                      )
      234                           ).
      235      end.
      236      procedure WaitFramRunPause:
      237         define input  parameter iInterval as dec no-undo.
      238         define variable vStart  as datetime-tz no-undo.
      239         define variable vend    as datetime-tz no-undo.
      240         define variable vint as int64 no-undo.
      241         define variable vOk as logical no-undo.
      242         vStart = now.
      243         vend   = vStart.
      244         publish "WaitFramPause" (iInterval,output vOk).
      245         vend   =  now.
      246         vint = vend - vStart.
      247         vint = iInterval - vint / 1000.
      248         if     not mWaitFramStop
      249            and (   vint > 0
      250                 or (    not vOk
      251                     and iInterval eq ?
      252                     )
      253                 )
      254         then
      255            run waitfram-show-this (iInterval).
      256         vend   =  now.
      257         vint = vend - vStart.
      258         vint = iInterval - vint / 1000.
      259         if     not mWaitFramStop
      260            and vint > 0
      261         then do:
      262            run gbl/pause.p (vint * 1000).
      263         end.
      264         if iInterval ne ?
      265         then
      266            publish "WaitFramStop".
      267         waitfram-check-timeout().
      268      end.
      269      procedure WaitFramWaitFor:
      270         define input  parameter iInterval as dec no-undo.
      271         assign
      272            mWaitFramStartProc   = now
      273            mWaitFramStopUser    = no
      274            mWaitFramStopTimeOut = no
      275         .
      276         block-wait:
      277         do while not mWaitFramStop:
      278            run WaitFramRunPause (iInterval).
      279            if  waitfram-check-timeout()
      280            then do:
      281               leave block-wait.
      282            end.
      283         end.
      284         run waitfram-hide.
      285      end.
      286   procedure waitfram-join :
      287     define input  parameter p-line-1  as character no-undo .
      288     define input  parameter p-line-2  as character no-undo .
      289     define input  parameter p-line-3  as character no-undo .
      290     define output parameter p-message as character no-undo .
      291     do
      292     on error undo, return error return-value
      293     :
      294       assign
      295         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      298       .
      299     end.
      300   end procedure.
      301   function waitfram-join-function returns character
      302     (input p-line-1 as character
      303     ,input p-line-2 as character
      304     ,input p-line-3 as character
      305     ).
      306     define variable v-message as character no-undo .
      307     run waitfram-join in this-procedure
      308       (input  p-line-1
      309       ,input  p-line-2
      310       ,input  p-line-3
      311       ,output v-message
      312       ) .
      313     return v-message .
      314   end function .
      315   define new global shared variable g#language as character no-undo .
      316   if g#language <> '' and g#language <> 'rus':U then do:
      317     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      318   end.
      319   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320     define variable v-cntxt-db-num        as integer   no-undo .
      321     define variable v-cntxt-userid        as character no-undo .
      322     define variable v-cntxt-level         as character no-undo .
      323     define variable v-cntxt-host-code-obj as integer   no-undo .
      324     define variable v-cntxt-obj-type      as character no-undo .
      325     define variable v-cntxt-obj-code      as integer   no-undo .
      326     define variable v-cntxt-db-num-obj    as integer   no-undo .
      327     define variable v-cntxt-is-admin      as logical   no-undo .
      328   define new global shared variable g#library  as handle no-undo .
      329   define new global shared variable g#library2 as handle no-undo .
      330   procedure proc-alt-shift-f2:
      331     if not ibs.th.gbl.gbl-var:rcode
      332   then
      333     run gbl\inidebug.p .
      334   end.
      335   procedure proc-alt-shift-f3:
      336     run gbl/prvssinf.p
      337       ( input this-procedure
      338       ) .
      339   end.
      340   define variable v-inform-launched as logical no-undo initial false .
      341   procedure proc-alt-shift-f4:
      342     define variable v-action as character no-undo .
      343     if v-inform-launched = false then do:
      344       assign
      345         v-inform-launched = true
      346       .
      347       run gbl/d-inform.w
      348         (  input self
      349         ,  input this-procedure
      350         , output v-action
      351         ) no-error .
      352       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      353       assign
      354         v-inform-launched = false
      355       .
      356     end.
      357   end.
      358   procedure proc-alt-f1:
      359     run gbl/corrhelp.p
      360       (input this-procedure
      361       ) .
      362   end .
      363   on alt-shift-f2 anywhere do:
      364     run proc-alt-shift-f2.
      365   end.
      366   on alt-shift-f3 anywhere do:
      367     run proc-alt-shift-f3 in this-procedure .
      368   end.
      369   on alt-shift-f4 anywhere do:
      370     run proc-alt-shift-f4 in this-procedure.
      371   end.
      372   on alt-f1 anywhere do:
      373     run proc-alt-f1 in this-procedure .
      374   end.
      375   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   define variable glog as logical no-undo .
      377   define variable v-rid-list as character no-undo .
      378   define variable v-templ-rl-root as integer no-undo .
      379   DEFINE BUFFER buf_file FOR dictdb._file.
      380   DEFINE BUTTON b-add
      381        LABEL "&Добавить"
      382        SIZE 10 BY 1.
      383   DEFINE BUTTON b-chg
      384        LABEL "&Изменить"
      385        SIZE 10 BY 1.
      386   DEFINE BUTTON b-copy
      387        LABEL "&Копировать"
      388        SIZE 10 BY 1.
      389   DEFINE BUTTON b-del
      390        LABEL "&Удалить"
      391        SIZE 10 BY 1.
      392   DEFINE BUTTON B-Help
      393        LABEL "Помо&щь"
      394        SIZE 3 BY 1
      395        BGCOLOR 8 .
      396   DEFINE BUTTON b-lkp
      397        LABEL "&Просмотр"
      398        SIZE 10 BY 1.
      399   DEFINE BUTTON b-mark
      400        LABEL "&*"
      401        SIZE 4 BY 1.
      402   DEFINE BUTTON b-quit AUTO-END-KEY
      403        LABEL "&Выход"
      404        SIZE 10 BY 1
      405        BGCOLOR 8 .
      406   DEFINE BUTTON b-sel AUTO-GO
      407        LABEL "Выбор"
      408        SIZE 10 BY 1.
      409   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      410         VIEW-AS TEXT
      411        SIZE 6 BY 1
      412        FGCOLOR 4  NO-UNDO.
      413   DEFINE QUERY br-dis-time-rule FOR
      414         X_dis-time-rule SCROLLING.
      415   DEFINE BROWSE br-dis-time-rule
      416     QUERY br-dis-time-rule NO-LOCK DISPLAY
      417         X_dis-time-rule.templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!шаблона"
      418   X_dis-time-rule.des FORMAT "X(255)":U WIDTH 85
      419       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.
      420   DEFINE FRAME Dialog-Frame
      421        b-quit AT ROW 1 COL 1
      422        b-mark AT ROW 1 COL 21 WIDGET-ID 32
      423        b-sel AT ROW 1 COL 25 WIDGET-ID 34
      424        b-add AT ROW 1 COL 35 WIDGET-ID 2
      425        b-copy AT ROW 1 COL 45 WIDGET-ID 30
      426        b-chg AT ROW 1 COL 55 WIDGET-ID 4
      427        b-del AT ROW 1 COL 65 WIDGET-ID 6
      428        b-lkp AT ROW 1 COL 75 WIDGET-ID 8
      429        B-Help AT ROW 1 COL 95
      430        br-dis-time-rule AT ROW 3 COL 1
      431        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      432        SPACE(78.50) SKIP(21.09)
      433       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      434            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      435            TITLE "ШАБЛОНЫ СКИДОК"
      436            CANCEL-BUTTON b-quit.
      437   ASSIGN
      438          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      439          FRAME Dialog-Frame:HIDDEN           = TRUE.
      440   ON GO OF FRAME Dialog-Frame
      441   DO:
      442     p-rid-list = v-rid-list.
      443   END.
      444   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      445   DO:
      446     APPLY "END-ERROR":U TO SELF.
      447   END.
      448   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      449   DO:
      450   define variable v-rec as recid no-undo .
      451     run utl/distrui0.w ( input parparentproc
      452                         ,INPUT 'ДОБАВЛЕНИЕ':U
      453                         ,INPUT 0
      454                         ,output v-rec
      455                         ) no-error .
      456     RUN openbr IN THIS-PROCEDURE  NO-ERROR.
      457     reposition br-dis-time-rule to recid(v-rec) no-error .
      458     APPLY "ENTRY" to br-dis-time-rule.
      459   END.
      460   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      461   DO:
      462   define variable v-rec   as recid no-undo .
      463   define variable v-rec2  as recid no-undo .
      464   v-rec = recid(X_dis-time-rule).
      465     if not available X_dis-time-rule then return no-apply.
      466     run utl/distrui0.w ( input parparentproc
      467                         ,INPUT 'ИЗМЕНЕНИЕ':U
      468                         ,INPUT X_dis-time-rule.templ-rl-root
      469                         ,output v-rec2
      470                         ) no-error .
      471     RUN openbr IN THIS-PROCEDURE  NO-ERROR.
      472     reposition br-dis-time-rule to recid(v-rec) no-error .
      473     APPLY "ENTRY" to br-dis-time-rule.
      474   END.
      475   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
      476   DO:
      477   define variable v-rec as recid no-undo .
      478   IF NOT AVAILABLE X_dis-time-rule THEN RETURN NO-APPLY.
      479     run utl/distrui0.w ( input parparentproc
      480                         ,INPUT 'КОПИРОВАНИЕ':U
      481                          ,INPUT X_dis-time-rule.templ-rl-root
      482                          ,output v-rec
      483                         ) no-error .
      484     RUN openbr IN THIS-PROCEDURE  NO-ERROR.
      485     reposition br-dis-time-rule to recid(v-rec) no-error .
      486     APPLY "ENTRY" to br-dis-time-rule.
      487   END.
      488   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      489   DO:
      490     message "b-del" VIEW-AS ALERT-BOX.
      491   END.
      492   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      493   DO:
      494    define variable v-rec as recid no-undo .
      495     if not available X_dis-time-rule then return no-apply.
      496     run utl/distrui0.w ( input parparentproc
      497                         ,INPUT 'ПРОСМОТР':U
      498                         ,INPUT X_dis-time-rule.templ-rl-root
      499                         ,output v-rec
      500                         ) no-error .
      501   END.
      502   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      503   DO:
      504     define variable glog as logical no-undo .
      505     if available X_dis-time-rule then do:
      506   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   define variable v-str-recid4 as character no-undo .
      508   define variable v-num-entry4 as integer   no-undo .
      509   assign
      510     v-str-recid4 = trim( string( recid( X_dis-time-rule ) , "->>>>>>>>>>>9":U ) )
      511     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      512   .
      513   if v-num-entry4 > 0 then do:
      514     assign
      515       entry( v-num-entry4, v-rid-list ) = "":U
      516       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      517     .
      518   end.
      519   else do:
      520     assign
      521       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      522     .
      523   end.
      524     glog = br-dis-time-rule:refresh() .
      525     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      526         glog = br-dis-time-rule:select-next-row ().
      527         apply "VALUE-CHANGED" to br-dis-time-rule in frame Dialog-Frame.
      528     end.
      529     if num-entries( v-rid-list ) = 0
      530     then
      531         hide mark-num in frame Dialog-Frame.
      532     else
      533         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      534   end.
      535   apply "entry" to br-dis-time-rule in frame Dialog-Frame.
      536   END.
      537   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      538   DO:
      539     if available X_dis-time-rule then do:
      540       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      541       then  v-rid-list = string( recid( X_dis-time-rule ) ) .
      542     end.
      543   END.
      544   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      545   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      546   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547   on help of frame Dialog-Frame
      548   do:
      549     run gbl/app_help.p
      550       (input this-procedure :file-name
      551       ,input ''
      552       ,input ?
      553       ) no-error.
      554     if error-status :error then do:
      555       message
      556         "Ошибка при вызове помощи"
      557         error-status :get-message(1)
      558         view-as alert-box .
      559     end.
      560   end.
      561   run minbtn-set in this-procedure .
      562   on choose of b-help in frame Dialog-Frame
      563   do:
      564     apply "help":u to frame Dialog-Frame .
      565   end.
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   procedure minbtn-set :
      568       do
      569           on error undo, return error return-value
      570           :
      571           define variable ii              as integer       no-undo .
      572           define variable fh              as widget-handle no-undo .
      573           define variable hh              as widget-handle no-undo .
      574           define variable v-h             as handle        extent 4 no-undo .
      575           define variable v-name-button   as character     no-undo .
      576           define variable v-help-old-x    as decimal       no-undo .
      577           define variable v-help-old-y    as decimal       no-undo .
      578           define variable v-help-old-size as decimal       no-undo .
      579           define variable v-frame-width   as decimal       no-undo .
      580           define variable jj              as integer       no-undo .
      581           do
      582               on error undo, return error
      583               :
      584               assign
      585                   v-frame-width = frame Dialog-Frame:width - 0.3
      586                   fh            = frame Dialog-Frame:first-child
      587                   hh            = fh:first-child
      588                   ii            = 1
      589                   .
      590               do while valid-handle(hh):
      591                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      592                   do:
      593                       case lc(hh:name) :
      594                           when "b-help" then
      595                               do:
      596                                   hh:load-image-up("cmp/b-help.bmp":u) .
      597                                   hh:load-image-down("cmp/b-help.bmp":u) .
      598                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      599                                   hh:TOOLTIP = "Помощь" .
      600                                   v-help-old-x = hh:column .
      601                                   v-help-old-y = hh:row    .
      602                                   v-help-old-size = hh:width .
      603                                   hh:width-chars = 2.5 .
      604                               end.
      605                           when "b-print" then
      606                               do:
      607                                   hh:load-image("cmp/b-print.bmp":u) .
      608                                   hh:TOOLTIP = "Печать" .
      609                                   v-h[ii] = hh:handle .
      610                                   ii = ii + 1 .
      611                                   hh:width-chars = 3 .
      612                               end.
      613                           when "b-history" or
      614                           when "b-hist" then
      615                               do:
      616                                   hh:load-image("cmp/b-hist.bmp":u) .
      617                                   hh:TOOLTIP = "История" .
      618                                   v-h[ii] = hh:handle .
      619                                   ii = ii + 1 .
      620                                   hh:width-chars = 3 .
      621                               end.
      622                           when "b-sch" then
      623                               do:
      624                                   hh:load-image("cmp/b-sch.bmp":u) .
      625                                   hh:TOOLTIP = "Установка Фильтра" .
      626                                   v-h[ii] = hh:handle .
      627                                   ii = ii + 1 .
      628                                   hh:width-chars = 3 .
      629                               end.
      630                           when "b-hist-user" then
      631                               do:
      632                                   hh:load-image("cmp/b-hist.bmp":u) .
      633                                   hh:TOOLTIP = "История пользователя" .
      634                                   ii = ii + 1 .
      635                               end.
      636                       end case.
      637                   end.
      638                   hh = hh:next-sibling.
      639               end.
      640               b-help:column = v-frame-width - b-help:width-chars.
      641               jj = 0.
      642               repeat ii = 4 to 1 by -1 :
      643                   if valid-handle (v-h[ii] ) then
      644                   do:
      645                       jj  = jj + 1 .
      646                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      647                       v-h[ii]:row    = v-help-old-y .
      648                   end.
      649               end.
      650           end.
      651       end.
      652   end procedure.
      653   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      654   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      655   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      656   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      657   define variable v-diasize-current-frame-width  as decimal   no-undo .
      658   define variable v-diasize-current-frame-height as decimal   no-undo .
      659   define variable v-diasize-change-size          as logical   no-undo .
      660   define variable v-diasize-resize-button        as handle    no-undo .
      661   define variable v-diasize-wndmax               as logical   no-undo .
      662   define variable v-diasize-wndstore             as logical   no-undo .
      663   define variable v-diasize-proc-name            as character no-undo .
      664   define variable v-diasize-browse-handle        as handle    no-undo .
      665   define variable v-diasize-browse-number        as integer   no-undo .
      666   define variable v-diasize-need-full-display    as logical   no-undo init false .
      667   define temp-table temp-diasize-handle no-undo
      668     field handle-value  as handle
      669     field save-position as decimal
      670     index xpk is primary unique handle-value
      671     .
      672   define temp-table temp-browse-handle no-undo
      673     field browse-type   as character
      674     field browse-number as integer
      675     field browse-handle as handle
      676     field original-size as decimal
      677     index xpk is primary unique browse-type browse-number
      678     index xie browse-type browse-handle
      679   .
      680   procedure diasize_change-height :
      681     define input  parameter p-change-value  as decimal   no-undo .
      682     define input  parameter p-move-resize   as logical   no-undo .
      683     define variable v-field-group-handle    as handle    no-undo .
      684     define variable v-object-handle         as handle    no-undo .
      685     define variable v-frame-height          as decimal   no-undo .
      686     define variable v-frame-virtual-height  as decimal   no-undo .
      687     define variable v-browse-height         as decimal   no-undo .
      688     define variable v-window-height         as decimal   no-undo .
      689     define variable v-window-virtual-height as decimal   no-undo .
      690     define variable v-change-sign           as integer   no-undo .
      691     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      692     define buffer buf_temp-browse-handle  for temp-browse-handle .
      693     if p-change-value > 0
      694     then do:
      695       if frame Dialog-Frame :height + p-change-value
      696           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      697       then do:
      698         assign
      699           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      700                           - (frame Dialog-Frame :height-chars)
      701         .
      702         if p-change-value <= 0
      703         then do:
      704           run diasize_position-resize-button in this-procedure .
      705           return .
      706         end.
      707       end.
      708     end.
      709     if p-change-value < 0
      710     then do:
      711       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      712       then do:
      713         assign
      714           p-change-value = v-diasize-orig-frame-height
      715                          - (frame Dialog-Frame :height-chars)
      716         .
      717         if p-change-value >= 0
      718         then do:
      719           run diasize_position-resize-button in this-procedure .
      720           return .
      721         end.
      722       end.
      723     end.
      724     if p-change-value >= 0
      725     then do:
      726       assign
      727         v-change-sign = 1
      728       .
      729     end.
      730     else do:
      731       assign
      732         v-change-sign = -1
      733       .
      734     end.
      735     assign
      736       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      737     .
      738     if p-change-value = 0
      739     then do:
      740       run diasize_position-resize-button in this-procedure .
      741       return .
      742     end.
      743     move_block:
      744     do
      745     on error undo move_block, retry move_block
      746     :
      747       if retry
      748       then do:
      749         do
      750         on error undo move_block, leave move_block
      751         :
      752           if p-change-value > 0
      753           then do:
      754             for each buf_temp-diasize-handle
      755             on error undo, next
      756             :
      757               assign
      758                 v-object-handle = buf_temp-diasize-handle.handle-value
      759               .
      760               if v-object-handle <> v-diasize-resize-button
      761               then do:
      762                 assign
      763                   v-object-handle :row = buf_temp-diasize-handle.save-position
      764                 .
      765               end.
      766             end.
      767             assign
      768               v-diasize-browse-handle :height = v-browse-height
      769             .
      770             for each buf_temp-browse-handle
      771               where buf_temp-browse-handle.browse-type = 'height':u
      772             on error undo, next
      773             :
      774               assign
      775                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      776               .
      777             end.
      778             assign
      779               frame Dialog-Frame :height = v-frame-height
      780             .
      781             if frame Dialog-Frame :scrollable = true
      782             then do:
      783               assign
      784                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      785               .
      786             end.
      787             run diasize_position-resize-button in this-procedure .
      788           end.
      789           else do:
      790             if frame Dialog-Frame :scrollable = true
      791             then do:
      792               assign
      793                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      794               .
      795             end.
      796             assign
      797               frame Dialog-Frame :height = v-frame-height
      798             .
      799             assign
      800               v-diasize-browse-handle :height = v-browse-height
      801             .
      802             for each buf_temp-browse-handle
      803               where buf_temp-browse-handle.browse-type = 'height':u
      804             on error undo, next
      805             :
      806               assign
      807                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      808               .
      809             end.
      810             for each buf_temp-diasize-handle
      811             on error undo, next
      812             :
      813               assign
      814                 v-object-handle = buf_temp-diasize-handle.handle-value
      815               .
      816               if v-object-handle <> v-diasize-resize-button
      817               then do:
      818                 assign
      819                   v-object-handle :row = buf_temp-diasize-handle.save-position
      820                 .
      821               end.
      822             end.
      823             run diasize_position-resize-button in this-procedure .
      824           end.
      825           assign
      826             v-diasize-change-size = false
      827           .
      828           leave move_block .
      829         end.
      830       end.
      831       assign
      832         v-diasize-need-full-display = true
      833       .
      834       if v-diasize-change-size = false
      835       then do:
      836         assign
      837           v-diasize-change-size = true
      838         .
      839       end.
      840       else do:
      841         return .
      842       end.
      843       assign
      844         v-frame-height = frame Dialog-Frame :height
      845         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      846         v-browse-height = v-diasize-browse-handle :height
      847       .
      848       for each buf_temp-browse-handle
      849         where buf_temp-browse-handle.browse-type = 'height':u
      850       :
      851         assign
      852           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      853         .
      854       end.
      855       for each buf_temp-diasize-handle
      856       :
      857         delete buf_temp-diasize-handle .
      858       end.
      859       assign
      860         v-field-group-handle = frame Dialog-Frame :first-child
      861       .
      862       do while valid-handle(v-field-group-handle)
      863       :
      864         assign
      865           v-object-handle = v-field-group-handle :first-child
      866         .
      867         do while valid-handle(v-object-handle)
      868         :
      869           if  v-object-handle <> v-diasize-browse-handle :handle
      870           and can-query(v-object-handle, "row")
      871           and can-query(v-object-handle, "height")
      872           and ( v-object-handle :row > v-diasize-browse-handle :row )
      873           then do:
      874             find first buf_temp-browse-handle
      875               where buf_temp-browse-handle.browse-type   = 'height':u
      876                 and buf_temp-browse-handle.browse-handle = v-object-handle
      877               no-error .
      878             if available buf_temp-browse-handle
      879             then do:
      880             end.
      881             else do:
      882               create buf_temp-diasize-handle .
      883               assign
      884                 buf_temp-diasize-handle.handle-value  = v-object-handle
      885                 buf_temp-diasize-handle.save-position = v-object-handle :row
      886               .
      887             end.
      888           end.
      889           assign
      890             v-object-handle = v-object-handle :next-sibling
      891           .
      892         end.
      893         assign
      894           v-field-group-handle = v-field-group-handle :next-sibling
      895         .
      896       end.
      897       do with frame Dialog-Frame
      898       :
      899         hide v-diasize-resize-button .
      900         assign
      901           v-diasize-resize-button :row    = 1
      902           v-diasize-resize-button :column = 1
      903         .
      904       end.
      905       if p-change-value > 0
      906       then do:
      907         if frame Dialog-Frame :scrollable = true
      908         then do:
      909           assign
      910             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      911             no-error .
      912           if error-status :error
      913           or error-status :get-message(1) <> ""
      914           then do:
      915             undo move_block, retry move_block .
      916           end.
      917         end.
      918         assign
      919           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      920           no-error .
      921         if error-status :error
      922         or error-status :get-message(1) <> ""
      923         then do:
      924           undo move_block, retry move_block .
      925         end.
      926         assign
      927           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      928           no-error .
      929         if error-status :error
      930         or error-status :get-message(1) <> ""
      931         then do:
      932           undo move_block, retry move_block .
      933         end.
      934         for each buf_temp-browse-handle
      935           where buf_temp-browse-handle.browse-type = 'height':u
      936         on error undo move_block, retry move_block
      937         :
      938           assign
      939             buf_temp-browse-handle.browse-handle :height
      940               = buf_temp-browse-handle.browse-handle :height + p-change-value
      941             no-error .
      942           if error-status :error
      943           or error-status :get-message(1) <> ""
      944           then do:
      945             undo move_block, retry move_block .
      946           end.
      947         end.
      948         for each buf_temp-diasize-handle
      949         on error undo move_block, retry move_block
      950         :
      951           assign
      952             v-object-handle = buf_temp-diasize-handle.handle-value
      953           .
      954           if v-object-handle <> v-diasize-resize-button
      955           then do:
      956             assign
      957               v-object-handle :row = v-object-handle :row + p-change-value
      958               no-error .
      959             if error-status :error
      960             or error-status :get-message(1) <> ""
      961             then do:
      962               undo move_block, retry move_block .
      963             end.
      964           end.
      965         end.
      966       end.
      967       else do:
      968         for each buf_temp-diasize-handle
      969         on error undo move_block, retry move_block
      970         :
      971           assign
      972             v-object-handle = buf_temp-diasize-handle.handle-value
      973           .
      974           if v-object-handle <> v-diasize-resize-button
      975           then do:
      976             assign
      977               v-object-handle :row = v-object-handle :row + p-change-value
      978               no-error .
      979             if error-status :error
      980             or error-status :get-message(1) <> ""
      981             then do:
      982               undo move_block, retry move_block .
      983             end.
      984           end.
      985         end.
      986         assign
      987           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      988           no-error .
      989         if error-status :error
      990         or error-status :get-message(1) <> ""
      991         then do:
      992           undo move_block, retry move_block .
      993         end.
      994         for each buf_temp-browse-handle
      995           where buf_temp-browse-handle.browse-type = 'height':u
      996         on error undo move_block, retry move_block
      997         :
      998           assign
      999             buf_temp-browse-handle.browse-handle :height
     1000               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1001             no-error .
     1002           if error-status :error
     1003           or error-status :get-message(1) <> ""
     1004           then do:
     1005             undo move_block, retry move_block .
     1006           end.
     1007         end.
     1008         assign
     1009           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1010           no-error .
     1011         if error-status :error
     1012         or error-status :get-message(1) <> ""
     1013         then do:
     1014           undo move_block, retry move_block .
     1015         end.
     1016         if frame Dialog-Frame :scrollable = true
     1017         then do:
     1018           assign
     1019             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1020             no-error .
     1021           if error-status :error
     1022           or error-status :get-message(1) <> ""
     1023           then do:
     1024             undo move_block, retry move_block .
     1025           end.
     1026         end.
     1027       end.
     1028       if p-move-resize = true
     1029       then do:
     1030         run diasize_position-resize-button in this-procedure .
     1031       end.
     1032       if v-diasize-wndstore = true
     1033       then do:
     1034         if connected("ub") = true
     1035         then do:
     1036           define variable v-cntxt-db-num        as integer   no-undo .
     1037           define variable v-cntxt-userid        as character no-undo .
     1038           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1039                                             , OUTPUT v-cntxt-userid
     1040                                             ) .
     1041           run gbl/wndsizew.p
     1042             (input  v-cntxt-db-num
     1043             ,input  v-cntxt-userid
     1044             ,input  v-diasize-proc-name
     1045             ,input  'height':u
     1046             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1047             ) .
     1048         end.
     1049       end.
     1050     end.
     1051     assign
     1052       v-diasize-change-size = false
     1053     .
     1054   end procedure.
     1055   procedure diasize_set-height :
     1056     define input  parameter p-new-height  as decimal   no-undo .
     1057     define input  parameter p-move-resize as logical   no-undo .
     1058     do
     1059     on error undo, return error return-value
     1060     :
     1061       run diasize_change-height in this-procedure
     1062         (input  (p-new-height - frame Dialog-Frame :height)
     1063         ,input  p-move-resize
     1064         ) .
     1065     end.
     1066   end procedure.
     1067   procedure diasize_change-width :
     1068     define input  parameter p-change-value as decimal   no-undo .
     1069     define input  parameter p-move-resize  as logical   no-undo .
     1070     define variable v-field-group-handle   as handle    no-undo .
     1071     define variable v-object-handle        as handle    no-undo .
     1072     define variable v-frame-width          as decimal   no-undo .
     1073     define variable v-frame-virtual-width  as decimal   no-undo .
     1074     define variable v-browse-width         as decimal   no-undo .
     1075     define variable v-window-width         as decimal   no-undo .
     1076     define variable v-window-virtual-width as decimal   no-undo .
     1077     define variable v-change-sign          as integer   no-undo .
     1078     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1079     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1080     if p-change-value > 0
     1081     then do:
     1082       if frame Dialog-Frame :width + p-change-value >
     1083           session :width-chars
     1084       then do:
     1085         assign
     1086           p-change-value = session :width-chars - frame Dialog-Frame :width
     1087         .
     1088         if p-change-value <= 0
     1089         then do:
     1090           run diasize_position-resize-button in this-procedure .
     1091           return .
     1092         end.
     1093       end.
     1094     end.
     1095     if p-change-value < 0
     1096     then do:
     1097       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1098       then do:
     1099         assign
     1100           p-change-value = v-diasize-orig-frame-width
     1101                          - frame Dialog-Frame :width
     1102         .
     1103         if p-change-value >= 0
     1104         then do:
     1105           run diasize_position-resize-button in this-procedure .
     1106           return .
     1107         end.
     1108       end.
     1109     end.
     1110     if p-change-value >= 0
     1111     then do:
     1112       assign
     1113         v-change-sign = 1
     1114       .
     1115     end.
     1116     else do:
     1117       assign
     1118         v-change-sign = -1
     1119       .
     1120     end.
     1121     assign
     1122       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1123     .
     1124     if p-change-value = 0
     1125     then do:
     1126       run diasize_position-resize-button in this-procedure .
     1127       return .
     1128     end.
     1129     move_block:
     1130     do
     1131     on error undo move_block, leave move_block
     1132     :
     1133       if retry
     1134       then do:
     1135         do
     1136         on error undo move_block, leave move_block
     1137         :
     1138           if p-change-value > 0
     1139           then do:
     1140             for each buf_temp-diasize-handle
     1141             on error undo, next
     1142             :
     1143               assign
     1144                 v-object-handle = buf_temp-diasize-handle.handle-value
     1145               .
     1146               if v-object-handle <> v-diasize-resize-button
     1147               then do:
     1148                 assign
     1149                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1150                 .
     1151               end.
     1152             end.
     1153             assign
     1154               v-diasize-browse-handle :width = v-browse-width
     1155             .
     1156             for each buf_temp-browse-handle
     1157               where buf_temp-browse-handle.browse-type = 'width':u
     1158             on error undo, next
     1159             :
     1160               assign
     1161                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1162               .
     1163             end.
     1164             assign
     1165               frame Dialog-Frame :width = v-frame-width
     1166             .
     1167             if frame Dialog-Frame :scrollable = true
     1168             then do:
     1169               assign
     1170                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1171               .
     1172             end.
     1173             run diasize_position-resize-button in this-procedure .
     1174           end.
     1175           else do:
     1176             if frame Dialog-Frame :scrollable = true
     1177             then do:
     1178               assign
     1179                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1180               .
     1181             end.
     1182             assign
     1183               frame Dialog-Frame :width = v-frame-width
     1184             .
     1185             for each buf_temp-browse-handle
     1186               where buf_temp-browse-handle.browse-type = 'width':u
     1187             on error undo, next
     1188             :
     1189               assign
     1190                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1191               .
     1192             end.
     1193             assign
     1194               v-diasize-browse-handle :width = v-browse-width
     1195             .
     1196             for each buf_temp-diasize-handle
     1197             on error undo, next
     1198             :
     1199               assign
     1200                 v-object-handle = buf_temp-diasize-handle.handle-value
     1201               .
     1202               if v-object-handle <> v-diasize-resize-button
     1203               then do:
     1204                 assign
     1205                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1206                 .
     1207               end.
     1208             end.
     1209             run diasize_position-resize-button in this-procedure .
     1210           end.
     1211           assign
     1212             v-diasize-change-size = false
     1213           .
     1214           leave move_block .
     1215         end.
     1216       end.
     1217       assign
     1218         v-diasize-need-full-display = true
     1219       .
     1220       if v-diasize-change-size = false
     1221       then do:
     1222         assign
     1223           v-diasize-change-size = true
     1224         .
     1225       end.
     1226       else do:
     1227         return .
     1228       end.
     1229       assign
     1230         v-frame-width = frame Dialog-Frame :width
     1231         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1232         v-browse-width = v-diasize-browse-handle :width
     1233       .
     1234       for each buf_temp-browse-handle
     1235         where buf_temp-browse-handle.browse-type = 'width':u
     1236       :
     1237         assign
     1238           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1239         .
     1240       end.
     1241       for each buf_temp-diasize-handle
     1242       :
     1243         delete buf_temp-diasize-handle .
     1244       end.
     1245       assign
     1246         v-field-group-handle = frame Dialog-Frame :first-child
     1247       .
     1248       do while valid-handle(v-field-group-handle)
     1249       :
     1250         assign
     1251           v-object-handle = v-field-group-handle :first-child
     1252         .
     1253         do while valid-handle(v-object-handle)
     1254         :
     1255           if  v-object-handle <> v-diasize-browse-handle :handle
     1256           and v-object-handle <> v-diasize-resize-button
     1257           and can-query(v-object-handle, "row")
     1258           and can-query(v-object-handle, "height")
     1259           and ( v-object-handle :col + v-object-handle :width
     1260                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1261               )
     1262           then do:
     1263             find first buf_temp-browse-handle
     1264               where buf_temp-browse-handle.browse-type   = 'width':u
     1265                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1266               no-error .
     1267             if available buf_temp-browse-handle
     1268             then do:
     1269             end.
     1270             else do:
     1271               create buf_temp-diasize-handle .
     1272               assign
     1273                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1274                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1275               .
     1276             end.
     1277           end.
     1278           assign
     1279             v-object-handle = v-object-handle :next-sibling
     1280           .
     1281         end.
     1282         assign
     1283           v-field-group-handle = v-field-group-handle :next-sibling
     1284         .
     1285       end.
     1286       do with frame Dialog-Frame
     1287       :
     1288         hide v-diasize-resize-button .
     1289         v-diasize-resize-button :row = 1.
     1290         v-diasize-resize-button :column = 1.
     1291       end.
     1292       if p-change-value > 0
     1293       then do:
     1294         if frame Dialog-Frame :scrollable = true
     1295         then do:
     1296           assign
     1297             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1298             no-error .
     1299           if error-status :error
     1300           or error-status :get-message(1) <> ""
     1301           then do:
     1302             undo move_block, retry move_block.
     1303           end.
     1304         end.
     1305         assign
     1306           frame Dialog-Frame :width = v-frame-width + p-change-value
     1307           no-error .
     1308         if error-status :error
     1309         or error-status :get-message(1) <> ""
     1310         then do:
     1311           undo move_block, retry move_block.
     1312         end.
     1313         assign
     1314           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1315         no-error .
     1316         if error-status :error
     1317         or error-status :get-message(1) <> ""
     1318         then do:
     1319           undo move_block, retry move_block.
     1320         end.
     1321         for each buf_temp-browse-handle
     1322           where buf_temp-browse-handle.browse-type = 'width':u
     1323         on error undo move_block, retry move_block
     1324         :
     1325           assign
     1326             buf_temp-browse-handle.browse-handle :width
     1327               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1328             no-error .
     1329           if error-status :error
     1330           or error-status :get-message(1) <> ""
     1331           then do:
     1332             undo move_block, retry move_block .
     1333           end.
     1334         end.
     1335         for each buf_temp-diasize-handle
     1336         on error undo move_block, retry move_block
     1337         :
     1338           assign
     1339             v-object-handle = buf_temp-diasize-handle.handle-value
     1340           .
     1341           if v-object-handle <> v-diasize-resize-button
     1342           then do:
     1343             assign
     1344               v-object-handle :col = v-object-handle :col + p-change-value
     1345               no-error .
     1346             if error-status :error
     1347             or error-status :get-message(1) <> ""
     1348             then do:
     1349               undo move_block, retry move_block .
     1350             end.
     1351           end.
     1352         end.
     1353       end.
     1354       else do:
     1355         for each buf_temp-diasize-handle
     1356         on error undo move_block, retry move_block
     1357         :
     1358           assign
     1359             v-object-handle = buf_temp-diasize-handle.handle-value
     1360           .
     1361           if v-object-handle <> v-diasize-resize-button
     1362           then do:
     1363             assign
     1364               v-object-handle :col = v-object-handle :col + p-change-value
     1365               no-error .
     1366             if error-status :error
     1367             or error-status :get-message(1) <> ""
     1368             then do:
     1369               undo move_block, retry move_block .
     1370             end.
     1371           end.
     1372         end.
     1373         for each buf_temp-browse-handle
     1374           where buf_temp-browse-handle.browse-type = 'width':u
     1375         on error undo move_block, retry move_block
     1376         :
     1377           assign
     1378             buf_temp-browse-handle.browse-handle :width
     1379               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1380             no-error .
     1381           if error-status :error
     1382           or error-status :get-message(1) <> ""
     1383           then do:
     1384             undo move_block, retry move_block .
     1385           end.
     1386         end.
     1387         assign
     1388           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1389           no-error .
     1390         if error-status :error
     1391         or error-status :get-message(1) <> ""
     1392         then do:
     1393           undo move_block, retry move_block.
     1394         end.
     1395         assign
     1396           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1397         no-error .
     1398         if error-status :error
     1399         or error-status :get-message(1) <> ""
     1400         then do:
     1401           undo move_block, retry move_block.
     1402         end.
     1403         if frame Dialog-Frame :scrollable = true
     1404         then do:
     1405           assign
     1406             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1407           no-error .
     1408           if error-status :error
     1409           or error-status :get-message(1) <> ""
     1410           then do:
     1411             undo move_block, retry move_block.
     1412           end.
     1413         end.
     1414       end.
     1415       if p-move-resize
     1416       then do:
     1417         run diasize_position-resize-button in this-procedure .
     1418       end.
     1419       if v-diasize-wndstore = true
     1420       then do:
     1421         if connected("ub") = true
     1422         then do:
     1423           define variable v-cntxt-db-num        as integer   no-undo .
     1424           define variable v-cntxt-userid        as character no-undo .
     1425           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1426                                             , OUTPUT v-cntxt-userid
     1427                                             ) .
     1428           run gbl/wndsizew.p
     1429             (input  v-cntxt-db-num
     1430             ,input  v-cntxt-userid
     1431             ,input  v-diasize-proc-name
     1432             ,input  'width':u
     1433             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1434             ) .
     1435         end.
     1436       end.
     1437     end.
     1438     assign
     1439       v-diasize-change-size = false
     1440     .
     1441   end procedure.
     1442   procedure diasize_set-width :
     1443     define input  parameter p-new-width  as decimal   no-undo .
     1444     define input  parameter p-move-resize as logical   no-undo .
     1445     do
     1446     on error undo, return error return-value
     1447     :
     1448       run diasize_change-width in this-procedure
     1449         (input  (p-new-width - frame Dialog-Frame :width)
     1450         ,input  p-move-resize
     1451         ) .
     1452     end.
     1453   end procedure.
     1454   procedure diasize_position-resize-button :
     1455     do with frame Dialog-Frame
     1456     :
     1457       hide v-diasize-resize-button .
     1458       assign
     1459         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1460                     - 1
     1461                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1462         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1463                     - 1
     1464                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1465       .
     1466       view v-diasize-resize-button .
     1467     end.
     1468   end procedure.
     1469   on alt-right anywhere
     1470   do:
     1471     run diasize_change-width in this-procedure
     1472       (input 1
     1473       ,input true
     1474       ) .
     1475     return no-apply .
     1476   end.
     1477   on alt-left anywhere
     1478   do:
     1479     run diasize_change-width in this-procedure
     1480       (input -1
     1481       ,input true
     1482       ) .
     1483     return no-apply .
     1484   end.
     1485   on alt-down anywhere
     1486   do:
     1487     run diasize_change-height in this-procedure
     1488       (input 1
     1489       ,input true
     1490       ) .
     1491     return no-apply .
     1492   end.
     1493   on alt-up anywhere
     1494   do:
     1495     run diasize_change-height in this-procedure
     1496       (input -1
     1497       ,input true
     1498       ) .
     1499     return no-apply .
     1500   end.
     1501   on alt-enter of frame Dialog-Frame
     1502   do:
     1503     run diasize_maximize in this-procedure
     1504       (input  ?
     1505       ).
     1506     return no-apply .
     1507   end.
     1508   procedure diasize_end-move :
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512       define variable v-row-delta as decimal   no-undo .
     1513       define variable v-col-delta as decimal   no-undo .
     1514       define variable v-new-row as decimal   no-undo .
     1515       define variable v-new-col as decimal   no-undo .
     1516       assign
     1517         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1518         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1519       .
     1520       assign
     1521         v-row-delta = v-new-row - frame Dialog-Frame :height
     1522         v-col-delta = v-new-col - frame Dialog-Frame :width
     1523       .
     1524       run diasize_change-height in this-procedure
     1525         (input v-row-delta
     1526         ,input true
     1527         ) .
     1528       run diasize_change-width in this-procedure
     1529         (input v-col-delta
     1530         ,input true
     1531         ) .
     1532     end.
     1533   end procedure.
     1534   procedure diasize_maximize :
     1535     define input  parameter p-action as logical   no-undo .
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       if p-action = ?
     1540       then do:
     1541         if v-diasize-need-maximize = true
     1542         then do:
     1543           assign
     1544             p-action = true
     1545           .
     1546         end.
     1547         else do:
     1548           assign
     1549             p-action = false
     1550           .
     1551         end.
     1552       end.
     1553       if p-action = true
     1554       then do:
     1555         run diasize_change-height in this-procedure
     1556           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1557               - frame Dialog-Frame :height-chars
     1558           ,input true
     1559           ) .
     1560         run diasize_change-width in this-procedure
     1561           (input session :width-chars
     1562               - frame Dialog-Frame :width-chars
     1563           ,input true
     1564           ) .
     1565         assign
     1566           v-diasize-need-maximize = false
     1567         .
     1568       end.
     1569       else do:
     1570         run diasize_change-width in this-procedure
     1571           (input v-diasize-orig-frame-width
     1572               - frame Dialog-Frame :width-chars
     1573           ,input true
     1574           ) .
     1575         run diasize_change-height in this-procedure
     1576           (input v-diasize-orig-frame-height
     1577               - frame Dialog-Frame :height-chars
     1578           ,input true
     1579           ) .
     1580         assign
     1581           v-diasize-need-maximize = true
     1582         .
     1583       end.
     1584     end.
     1585   end procedure.
     1586   procedure diasize_restore-orig-size :
     1587     do
     1588     on error undo, return error return-value
     1589     :
     1590       assign
     1591         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1592         v-diasize-current-frame-height = frame Dialog-Frame :height
     1593       .
     1594       run diasize_set-height in this-procedure
     1595         (input  v-diasize-orig-frame-height
     1596         ,input  true
     1597         ) .
     1598       run diasize_set-width in this-procedure
     1599         (input  v-diasize-orig-frame-width
     1600         ,input  true
     1601         ) .
     1602     end.
     1603   end procedure.
     1604   procedure diasize_restore-current-size :
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608       run diasize_set-height in this-procedure
     1609         (input  v-diasize-current-frame-height
     1610         ,input  true
     1611         ) .
     1612       run diasize_set-width in this-procedure
     1613         (input  v-diasize-current-frame-width
     1614         ,input  true
     1615         ) .
     1616     end.
     1617   end procedure.
     1618   procedure diasize_set-browse-handle :
     1619     define input  parameter p-browse-handle as handle   no-undo .
     1620     define buffer buf_temp-browse-handle for temp-browse-handle .
     1621     do
     1622     on error undo, return error return-value
     1623     :
     1624       assign
     1625         v-diasize-browse-handle = p-browse-handle
     1626       .
     1627       for each buf_temp-browse-handle
     1628       on error undo, return error return-value
     1629       :
     1630         delete buf_temp-browse-handle .
     1631       end.
     1632     end.
     1633   end procedure.
     1634   procedure diasize_add_browse :
     1635     define input  parameter p-browse-type   as character no-undo .
     1636     define input  parameter p-browse-handle as handle    no-undo .
     1637     define buffer buf_temp-browse-handle for temp-browse-handle .
     1638     do
     1639     on error undo, return error return-value
     1640     :
     1641       assign
     1642         v-diasize-browse-number = v-diasize-browse-number + 1
     1643       .
     1644       create buf_temp-browse-handle .
     1645       assign
     1646         buf_temp-browse-handle.browse-type   = p-browse-type
     1647         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1648         buf_temp-browse-handle.browse-handle = p-browse-handle
     1649       .
     1650     end.
     1651   end procedure.
     1652   procedure diasize_init :
     1653     define variable v-default-value    as logical   no-undo .
     1654     define variable v-restore-saved    as logical   no-undo .
     1655     define variable v-resize-value-str as character no-undo .
     1656     do
     1657     on error undo, return error return-value
     1658     :
     1659       do with frame Dialog-Frame
     1660       :
     1661         assign
     1662           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1663           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1664           v-diasize-browse-handle     = browse br-dis-time-rule :handle
     1665         .
     1666         create button v-diasize-resize-button
     1667         assign
     1668           parent        = frame Dialog-Frame :first-child
     1669           label         = "s"
     1670           height-pixels = 16
     1671           width-pixels  = 16
     1672           visible       = true
     1673           sensitive     = true
     1674           movable       = true
     1675           triggers:
     1676             on end-move persistent run diasize_end-move in this-procedure .
     1677           end triggers.
     1678         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1679         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1680         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1681         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1682         assign
     1683           v-diasize-wndmax = false
     1684         .
     1685         if connected("ub") = true
     1686         then do:
     1687           define variable v-cntxt-db-num        as integer   no-undo .
     1688           define variable v-cntxt-userid        as character no-undo .
     1689           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1690                                             , OUTPUT v-cntxt-userid
     1691                                             ) .
     1692           run gbl/wndpar_r.p
     1693             (input  v-cntxt-db-num
     1694             ,input  v-cntxt-userid
     1695             ,input  'wndmax':U
     1696             ,output v-diasize-wndmax
     1697             ,output v-default-value
     1698             ) .
     1699         end.
     1700         assign
     1701           v-diasize-wndstore = false
     1702         .
     1703         if connected("ub") = true
     1704         then do:
     1705           run gbl/wndpar_r.p
     1706             (input  v-cntxt-db-num
     1707             ,input  v-cntxt-userid
     1708             ,input  'wndstore':U
     1709             ,output v-diasize-wndstore
     1710             ,output v-default-value
     1711             ) .
     1712         end.
     1713         assign
     1714           v-diasize-proc-name = entry(1, program-name(2), '.')
     1715         .
     1716         if v-diasize-wndstore = true
     1717         then do:
     1718           assign
     1719             v-restore-saved = false
     1720           .
     1721           if connected("ub") = true
     1722           then do:
     1723             run gbl/wndsizer.p
     1724               (input  v-cntxt-db-num
     1725               ,input  v-cntxt-userid
     1726               ,input  v-diasize-proc-name
     1727               ,input  'height':u
     1728               ,output v-resize-value-str
     1729               ) .
     1730             if v-resize-value-str <> '':U
     1731             then do:
     1732               run diasize_change-height in this-procedure
     1733                 (input  integer(v-resize-value-str)
     1734                 ,input  true
     1735                 ) .
     1736               assign
     1737                 v-restore-saved = true
     1738               .
     1739             end.
     1740           end.
     1741           if connected("ub") = true
     1742           then do:
     1743             run gbl/wndsizer.p
     1744               (input  v-cntxt-db-num
     1745               ,input  v-cntxt-userid
     1746               ,input  v-diasize-proc-name
     1747               ,input  'width':u
     1748               ,output v-resize-value-str
     1749               ) .
     1750             if v-resize-value-str <> '':U
     1751             then do:
     1752               run diasize_change-width in this-procedure
     1753                 (input  integer(v-resize-value-str)
     1754                 ,input  true
     1755                 ) .
     1756               assign
     1757                 v-restore-saved = true
     1758               .
     1759             end.
     1760           end.
     1761           if v-restore-saved <> true
     1762           then do:
     1763             if v-diasize-wndmax = true
     1764             then do:
     1765               run diasize_maximize in this-procedure
     1766                 (input  true
     1767                 ) .
     1768             end.
     1769           end.
     1770         end.
     1771         else do:
     1772           if v-diasize-wndmax = true
     1773           then do:
     1774             run diasize_maximize in this-procedure
     1775               (input  true
     1776               ) .
     1777           end.
     1778         end.
     1779       end.
     1780     end.
     1781   end procedure.
     1782   procedure diasize_need-full-display :
     1783     define output parameter p-need-full-display as logical   no-undo .
     1784     do
     1785     on error undo, return error return-value
     1786     :
     1787       assign
     1788         p-need-full-display = v-diasize-need-full-display
     1789       .
     1790       assign
     1791         v-diasize-need-full-display = false
     1792       .
     1793     end.
     1794   end procedure.
     1795   procedure get-context :
     1796      define output parameter p-db-num as integer          no-undo.
     1797      define output parameter p-user-id as character        no-undo.
     1798      define variable v-login               as character    no-undo.
     1799      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1800      define buffer buf_user-login  for ub.user-login .
     1801      do
     1802      on error undo, return error
     1803      :
     1804            FIND FIRST buf_sys-ctrl no-lock.
     1805            ASSIGN
     1806               v-login = USERID("ub")
     1807               p-db-num = buf_sys-ctrl.db-num
     1808            .
     1809            FIND FIRST buf_user-login
     1810                 WHERE buf_user-login.db-num = p-db-num
     1811                   AND buf_user-login.user-login = v-login
     1812                 no-lock
     1813                 no-error
     1814                 .
     1815            IF AVAILABLE buf_user-login
     1816            THEN DO:
     1817               assign
     1818                  p-user-id = buf_user-login.user-id
     1819               .
     1820            END.
     1821      end.
     1822   end procedure.
     1823       run diasize_init in this-procedure .
     1824   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1825   on F2 of frame Dialog-Frame anywhere do:
     1826     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     1827     return no-apply.
     1828   end.
     1829   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1830   on F3 of frame Dialog-Frame anywhere do:
     1831     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1832     return no-apply.
     1833   end.
     1834   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1835   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1836     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     1837     return no-apply.
     1838   end.
     1839   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1840   on F4 of frame Dialog-Frame anywhere do:
     1841     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     1842     return no-apply.
     1843   end.
     1844   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1845   on F8 of frame Dialog-Frame anywhere do:
     1846     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     1847     return no-apply.
     1848   end.
     1849   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1850   on INS of frame Dialog-Frame anywhere do:
     1851     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1852     return no-apply.
     1853   end.
     1854   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1855   on F2 of frame Dialog-Frame anywhere do:
     1856     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1857     return no-apply.
     1858   end.
     1859   MAIN-BLOCK:
     1860   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1861      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1862   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1863     run mainmenu_getcntxt in parparentproc
     1864       (output v-cntxt-db-num
     1865       ,output v-cntxt-userid
     1866       ,output v-cntxt-level
     1867       ,output v-cntxt-host-code-obj
     1868       ,output v-cntxt-obj-type
     1869       ,output v-cntxt-obj-code
     1870       ,output v-cntxt-db-num-obj
     1871       ,output v-cntxt-is-admin
     1872       ) .
     1873     v-rid-list = p-rid-list.
     1874     RUN Myenable IN THIS-PROCEDURE .
     1875     run openbr in this-procedure .
     1876     APPLY "ENTRY" to br-dis-time-rule.
     1877     WAIT-FOR GO OF FRAME Dialog-Frame.
     1878   END.
     1879   RUN disable_UI.
     1880   PROCEDURE disable_UI :
     1881     HIDE FRAME Dialog-Frame.
     1882   END PROCEDURE.
     1883   PROCEDURE enable_UI :
     1884     DISPLAY mark-num
     1885         WITH FRAME Dialog-Frame.
     1886     ENABLE b-quit b-mark b-sel b-add b-copy b-chg b-del b-lkp B-Help
     1887            br-dis-time-rule mark-num
     1888         WITH FRAME Dialog-Frame.
     1889     VIEW FRAME Dialog-Frame.
     1890   END PROCEDURE.
     1891   PROCEDURE MyEnable :
     1892   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1893   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     1894   ch = br-dis-time-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     1895   DO ii = 1 TO br-dis-time-rule:NUM-COLUMNS IN FRAME Dialog-Frame:
     1896       ASSIGN
     1897       ch:RESIZABLE = YES.
     1898       ch = ch:NEXT-COLUMN.
     1899   END.
     1900   DISPLAY mark-num
     1901   WITH FRAME Dialog-Frame.
     1902   ENABLE
     1903   b-quit
     1904   B-add WHEn (v-cntxt-db-num = 0)
     1905   B-copy WHEn (v-cntxt-db-num = 0)
     1906   B-chg WHEn (v-cntxt-db-num = 0)
     1907   B-del WHEn (v-cntxt-db-num = 0)
     1908   B-mark WHEn LOOKUP("b-mark", bttns) > 0
     1909   B-sel WHEN LOOKUP("b-sel", bttns) > 0
     1910   B-Help
     1911   b-lkp
     1912   br-dis-time-rule
     1913   mark-num
     1914   WITH FRAME Dialog-Frame.
     1915   VIEW FRAME Dialog-Frame.
     1916   HIDE
     1917   mark-num
     1918   IN FRAME Dialog-Frame.
     1919   END PROCEDURE.
     1920   PROCEDURE openbr :
     1921   OPEN QUERY br-dis-time-rule
     1922   FOR EACH X_dis-time-rule NO-LOCK WHERE X_dis-time-rule.time-rule-num <= 99999 INDEXED-REPOSITION.
     1923   END PROCEDURE.
