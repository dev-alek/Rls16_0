        1   block-level on error undo, throw.
        2   class utl.gpwd:
        3      method public int64 gen-pwd(
        4         iObjNum as int64,
        5         iCashDesk as int64,
        6         iDate as date,
        7         iTimeBeg as char,
        8         iTimeEnd as char):
        9         def var vPass as char no-undo.
       10         def var vPass64 as int64 no-undo.
       11         def var vCryptoCode as char no-undo.
       12         def var vCryptoCode64 as int64 no-undo.
       13         assign
       14            vPass = this-object:get-char(iTimeBeg)
       15            vPass = substitute("&1&2",vPass,this-object:get-char(iTimeEnd))
       16            vPass = vPass + "1"
       17            vCryptoCode64 = this-object:generateCryptoCode(iObjNum, iCashDesk, iDate)
       18            vCryptoCode = string(vCryptoCode64)
       19            vPass = vPass + substring(vCryptoCode,length(vCryptoCode) - 2)
       20            vPass64 = int64(vPass)
       21            vPass64 = utl.math:ixor(vPass64  ,int64(vCryptoCode64 * 3 ) modulo 100000000)
       22         .
       23         return vPass64.
       24      end method.
       25      method public int64 generateCryptoCode(
       26         iObjNum as int64,
       27         iCashDesk as int64,
       28         iDate as date):
       29         def var vDate as char no-undo.
       30         def var vRes as int64 no-undo.
       31         def var vKey as int64 no-undo.
       32         assign
       33            vDate = string(iDate,"99/99/9999")
       34            vDate = replace(vDate,"/","")
       35            vRes = (int64(vDate) * iObjNum / iCashDesk)
       36            vRes = utl.math:ixor(int64(vRes * 2),vRes)
       37            vKey = vRes modulo 100000000
       38         .
       39         return vKey.
       40      end method.
       41      method public char get-char(iStr as char):
       42         def var vRet as char no-undo.
       43         case iStr:
       44            when "00:00" then vRet = "01".
       45            when "00:30" then vRet = "02".
       46            when "01:00" then vRet = "03".
       47            when "01:30" then vRet = "04".
       48            when "02:00" then vRet = "05".
       49            when "02:30" then vRet = "06".
       50            when "03:00" then vRet = "07".
       51            when "03:30" then vRet = "08".
       52            when "04:00" then vRet = "09".
       53            when "04:30" then vRet = "10".
       54            when "05:00" then vRet = "11".
       55            when "05:30" then vRet = "12".
       56            when "06:00" then vRet = "13".
       57            when "06:30" then vRet = "14".
       58            when "07:00" then vRet = "15".
       59            when "07:30" then vRet = "16".
       60            when "08:00" then vRet = "17".
       61            when "08:30" then vRet = "18".
       62            when "09:00" then vRet = "19".
       63            when "09:30" then vRet  = "20".
       64            when "10:00" then vRet = "21".
       65            when "10:30" then vRet = "22".
       66            when "11:00" then vRet = "23".
       67            when "11:30" then vRet = "24".
       68            when "12:00" then vRet = "25".
       69            when "12:30" then vRet = "26".
       70            when "13:00" then vRet = "27".
       71            when "13:30" then vRet = "28".
       72            when "14:00" then vRet = "29".
       73            when "14:30" then vRet = "30".
       74            when "15:00" then vRet = "31".
       75            when "15:30" then vRet = "32".
       76            when "16:00" then vRet = "33".
       77            when "16:30" then vRet = "34".
       78            when "17:00" then vRet = "35".
       79            when "17:30" then vRet = "36".
       80            when "18:00" then vRet = "37".
       81            when "18:30" then vRet = "38".
       82            when "19:00" then vRet = "39".
       83            when "19:30" then vRet = "40".
       84            when "20:00" then vRet = "41".
       85            when "20:30" then vRet = "42".
       86            when "21:00" then vRet = "43".
       87            when "21:30" then vRet = "44".
       88            when "22:00" then vRet = "45".
       89            when "22:30" then vRet = "46".
       90            when "23:00" then vRet = "47".
       91            when "23:30" then vRet = "48".
       92         end case.
       93         return vRet.
       94      end method.
       95   end class.
