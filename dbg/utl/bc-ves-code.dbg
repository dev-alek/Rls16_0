        1   block-level on error undo, throw.
        2   define input parameter p-min as integer.
        3   define input parameter p-max as integer.
        4   if p-min > p-max then
        5   do:
        6       message "Не правильно введен диапазон" view-as alert-box.
        7       return.
        8   end.
        9   define variable prod_i as integer.
       10   define new global shared variable g#language as character no-undo .
       11   if g#language <> '' and g#language <> 'rus':U then do:
       12     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       13   end.
       14   define new global shared variable g#library  as handle no-undo .
       15   define new global shared variable g#library2 as handle no-undo .
       16   define   shared variable g#auto as logical no-undo.
       17   define   shared variable g#news as logical no-undo.
       18   define   shared variable g#oxml as logical no-undo.
       19   define   shared variable g#esys as logical no-undo.
       20   define   shared variable g#news-source-db as integer no-undo.
       21   define   shared variable g#esys-source-esys as integer no-undo.
       22   define   shared variable g#db-num as integer   no-undo .
       23   define   shared variable g#userid as character no-undo .
       24   define   shared variable g#passwd as character no-undo .
       25   define temp-table tt-range like code-range.
       26   find first code-range where code-range.range-type =  'sclc':U and code-range.first-code =  p-min  no-error.
       27   if not available code-range then
       28   do:
       29       message "Диапазона для данных параметров не существует" view-as alert-box.
       30       return.
       31   end.
       32   find first code-range where code-range.range-type =  'sclc':U and code-range.last-code =  p-max  no-error.
       33   if not available code-range then
       34   do:
       35       message "Диапазона для данных параметров не существует" view-as alert-box.
       36       return.
       37   end.
       38   do prod_i  = p-min to p-max :
       39       find first  prod-bc no-lock where prod-bc.b-str = string(prod_i,"99999") no-error.
       40       find  first tt-range where tt-range.range-type =  'sclc':U and tt-range.last-code = prod_i - 1 no-error.
       41       if (available tt-range and tt-range.stts = "u")  and  available prod-bc then tt-range.last-code = prod_i .
       42       else   if ((available tt-range and tt-range.stts = "u") or not available tt-range) and not available prod-bc then
       43           do:
       44               create tt-range.
       45               assign
       46                   tt-range.stts       = "f"
       47                   tt-range.first-code = prod_i
       48                   tt-range.last-code  = prod_i
       49                   tt-range.range-type = 'sclc':U.
       50           end.
       51           else  if  (available tt-range and tt-range.stts = "f")  and not available prod-bc then tt-range.last-code = prod_i.
       52               else if ((available tt-range and tt-range.stts = "f") or not available tt-range) and  available prod-bc then
       53                   do:
       54                       create tt-range.
       55                       assign
       56                           tt-range.stts       = "u"
       57                           tt-range.first-code = prod_i
       58                           tt-range.last-code  = prod_i
       59                           tt-range.range-type = 'sclc':U.
       60                   end.
       61   end.
       62   disable triggers for load of code-range.
       63   output to c:/temp/code-range.txt.
       64   for each code-range where code-range.first-code >= p-min and code-range.last-code <= p-max and code-range.range-type = 'sclc':U  and  code-range.db-num = g#db-num :
       65       export code-range.
       66       delete code-range.
       67   end.
       68   output close.
       69   output to c:/temp/core-tt.txt.
       70   for each tt-range :
       71       create code-range.
       72       assign
       73           code-range.first-code = tt-range.first-code
       74           code-range.last-code  = tt-range.last-code
       75           code-range.db-num     = g#db-num
       76           code-range.beg-date   = today
       77           code-range.stts       = tt-range.stts
       78           code-range.range-type = tt-range.range-type.
       79       export tt-range.
       80   end.
       81   output close.
