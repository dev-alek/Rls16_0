        1   define input parameter iAreaNumber as integer no-undo.
        2   define temp-table ttObjects no-undo
        3     field fObjType as integer
        4     field fObjName as character
        5   .
        6   DEFINE BUTTON b-quit AUTO-END-KEY
        7        LABEL "&Выход"
        8        SIZE 10 BY 1
        9        BGCOLOR 8 .
       10   DEFINE VARIABLE viewIndex AS LOGICAL INITIAL no
       11        LABEL "показать индексы"
       12        VIEW-AS TOGGLE-BOX
       13        SIZE 23 BY .81 NO-UNDO.
       14   DEFINE QUERY br-list FOR
       15         ttObjects SCROLLING.
       16   DEFINE BROWSE br-list
       17     QUERY br-list DISPLAY
       18         (if ttObjects.fObjType = 1 then "table" else "index") format "X(6)"
       19      column-label "Тип объекта"
       20    ttObjects.fObjName format "X(25)" column-label "Имя объекта"
       21       WITH NO-ROW-MARKERS SEPARATORS SIZE 56.4 BY 10.95 FIT-LAST-COLUMN.
       22   DEFINE FRAME Dialog-Frame
       23        b-quit AT ROW 1.48 COL 3 WIDGET-ID 8
       24        viewIndex AT ROW 1.48 COL 34 WIDGET-ID 6
       25        br-list AT ROW 2.91 COL 2.6 WIDGET-ID 200
       26        SPACE(1.19) SKIP(0.75)
       27       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       28            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       29            TITLE "Состав области" WIDGET-ID 100.
       30   ASSIGN
       31          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       32          FRAME Dialog-Frame:HIDDEN           = TRUE.
       33   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       34   DO:
       35     APPLY "END-ERROR":U TO SELF.
       36   END.
       37   ON VALUE-CHANGED OF viewIndex IN FRAME Dialog-Frame
       38   DO:
       39     assign viewIndex.
       40    OPEN QUERY br-list FOR EACH ttObjects   where ttObjects.fObjType <= (if viewIndex then 2 else 1).
       41   END.
       42   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       43   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       44   MAIN-BLOCK:
       45   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       46      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       47     run getObjects in this-procedure.
       48     RUN enable_UI.
       49     WAIT-FOR GO OF FRAME Dialog-Frame.
       50   END.
       51   RUN disable_UI.
       52   PROCEDURE disable_UI :
       53     HIDE FRAME Dialog-Frame.
       54   END PROCEDURE.
       55   PROCEDURE enable_UI :
       56     DISPLAY viewIndex
       57         WITH FRAME Dialog-Frame.
       58     ENABLE b-quit viewIndex br-list
       59         WITH FRAME Dialog-Frame.
       60     VIEW FRAME Dialog-Frame.
       61     OPEN QUERY br-list FOR EACH ttObjects   where ttObjects.fObjType <= (if viewIndex then 2 else 1).
       62   END PROCEDURE.
       63   PROCEDURE getObjects :
       64   define buffer buf_StorageObject for ub._StorageObject.
       65   define buffer buf_file for ub._File.
       66   define buffer buf_index for ub._Index.
       67   define variable vObjName as character no-undo.
       68   for each buf_StorageObject no-lock where
       69            buf_StorageObject._Area-number = iAreaNumber
       70   :
       71     vObjName = "".
       72     case buf_StorageObject._Object-type:
       73       when 1 then
       74       do:
       75         find first buf_file no-lock where
       76                    buf_file._file-number = buf_StorageObject._Object-number
       77         no-error.
       78         if avail buf_file then
       79           vObjName = buf_file._file-name.
       80       end.
       81       when 2 then
       82       do:
       83         find first buf_index no-lock where
       84                    buf_index._idx-num = buf_StorageObject._Object-number
       85         no-error.
       86         if avail buf_index then
       87           vObjName = buf_index._index-name.
       88       end.
       89     end case.
       90     if vObjName <> "" then
       91     do:
       92       create ttObjects.
       93       assign
       94         ttObjects.fObjType = buf_StorageObject._Object-type
       95         ttObjects.fObjName = vObjName
       96       .
       97     end.
       98   end.
       99   END PROCEDURE.
