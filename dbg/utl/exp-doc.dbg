        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: exp-doc.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/exp-doc.p $":U .
        8   define variable vss-description as character no-undo init "Ёкспорт строк документа в текстовый файл в формате импорта".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68     define variable v-cntxt-db-num        as integer   no-undo .
       69     define variable v-cntxt-userid        as character no-undo .
       70     define variable v-cntxt-level         as character no-undo .
       71     define variable v-cntxt-host-code-obj as integer   no-undo .
       72     define variable v-cntxt-obj-type      as character no-undo .
       73     define variable v-cntxt-obj-code      as integer   no-undo .
       74     define variable v-cntxt-db-num-obj    as integer   no-undo .
       75     define variable v-cntxt-is-admin      as logical   no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77     run mainmenu_getcntxt in parparentproc
       78       (output v-cntxt-db-num
       79       ,output v-cntxt-userid
       80       ,output v-cntxt-level
       81       ,output v-cntxt-host-code-obj
       82       ,output v-cntxt-obj-type
       83       ,output v-cntxt-obj-code
       84       ,output v-cntxt-db-num-obj
       85       ,output v-cntxt-is-admin
       86       ) .
       87   define variable g-log        as logical no-undo.
       88   define variable loc-ref-list as character no-undo .
       89   define variable v-dir-name   as character no-undo .
       90   define variable v-type       as character no-undo .
       91   define variable v-can-write  as logical   no-undo .
       92   define variable num-rec as integer no-undo.
       93   define stream txt.
       94   define variable f-name as character no-undo.
       95   define variable prtroot as integer   no-undo .
       96   define variable name-item  as character no-undo .
       97   define variable name-scale as character no-undo .
       98   define variable name-bc    as character no-undo .
       99   define variable name-gtd as character no-undo .
      100   define variable srok-god as character no-undo .
      101   define buffer buf_gds-prt for ub.gds-prt  .
      102   define buffer buf_goods for ub.goods  .
      103   define buffer buf_bar-code for ub.bar-code  .
      104   define buffer buf_trn-doc for ub.trn-doc  .
      105   define buffer buf_doc-line for ub.doc-line  .
      106   define buffer buf_parts for ub.parts  .
      107   define buffer buf_gds-dtl for ub.gds-dtl  .
      108   g-log = no.
      109   message "Ёкспорт документов в файл, в формате импорта." skip (2)
      110           "ѕродолжать ?"
      111           view-as alert-box question buttons OK-Cancel update g-log.
      112   if not g-log then return.
      113   find first buf_gds-prt where buf_gds-prt.node-name = '_ѕуста€ шкала':U no-lock no-error.
      114   if available  buf_gds-prt then   prtroot = buf_gds-prt.prt-root.
      115                         else   prtroot = 0.
      116   run gbl/dir-sel.p
      117        ( output v-dir-name
      118         ,output v-type
      119         ,output v-can-write
      120         ).
      121   if NOT v-can-write THEN DO:
      122       message
      123         "ѕуть дл€ сохранени€ файлов не указан."
      124         view-as alert-box error.
      125       return no-apply.
      126   END.
      127   define variable ref-list as char no-undo.
      128     run str/all-docs.w
      129       (  input parparentproc
      130         ,input v-cntxt-host-code-obj
      131         ,input ?
      132         ,input ?
      133         ,input 'фирма':U
      134         ,input ?
      135         ,input ?
      136         ,input ?
      137         ,input ?
      138         ,input "b-sel,b-mark":U
      139         ,input ?
      140         ,input ?
      141         ,input ?
      142         ,output loc-ref-list ).
      143   if loc-ref-list = "" then do:
      144       message
      145        "ƒокументы не выбраны"
      146         view-as alert-box error.
      147       return no-apply.
      148   END.
      149   do num-rec = 1 to num-entries(loc-ref-list):
      150      find buf_trn-doc where recid ( buf_trn-doc) = integer(entry(num-rec, loc-ref-list)) no-lock no-error .
      151       f-name = v-dir-name + "\" + trim( buf_trn-doc.doc-code) + ".adb".
      152       output stream txt to value (f-name ).
      153       name-gtd = "" .
      154       srok-god = "" .
      155       for each buf_doc-line  no-lock where
      156                buf_doc-line.doc-code = buf_trn-doc.doc-code,
      157            first buf_goods no-lock where
      158                  buf_goods.artic     = buf_doc-line.artic   and
      159                  buf_goods.prod-type = buf_doc-line.prod-type  and
      160                  buf_goods.prod-code = buf_doc-line.prod-code
      161                   :
      162                   display
      163                     buf_goods.artic
      164                     with frame ff view-as dialog-box
      165                     title ": Ёкспорт ".
      166                     pause 0.
      167                     for each buf_parts no-lock where
      168                             buf_parts.out-code = buf_trn-doc.doc-code and
      169                             buf_parts.obj-type = buf_trn-doc.obj-type and
      170                             buf_parts.obj-code = buf_trn-doc.obj-code and
      171                             buf_parts.artic    = buf_doc-line.artic and
      172                             buf_parts.prod-type = buf_doc-line.prod-type and
      173                             buf_parts.prod-code = buf_doc-line.prod-code
      174                     :
      175                            name-gtd = trim(string(buf_parts.cst-code)) .
      176                            srok-god = trim(string(buf_parts.last-date, "99/99/9999")) .
      177                            if srok-god = ? then srok-god = "" .
      178                     end.
      179         for each buf_gds-dtl no-lock where
      180                  buf_gds-dtl.doc-code  = buf_trn-doc.doc-code  and
      181                  buf_gds-dtl.artic     = buf_doc-line.artic    and
      182                  buf_gds-dtl.prod-type = buf_doc-line.prod-type and
      183                  buf_gds-dtl.prod-code = buf_doc-line.prod-code
      184         :
      185           find first buf_bar-code no-lock where
      186                      buf_bar-code.node-code = buf_gds-dtl.prt-code and
      187                      buf_bar-code.gds-code  = buf_goods.gds-code    and
      188                      buf_bar-code.unit-cli  = buf_goods.unit-base   and
      189                      buf_bar-code.part-code = ""   and
      190                      buf_bar-code.in-code = ""   .
      191           IF buf_goods.prt-root <> prtroot then do:
      192              find first buf_gds-prt no-lock where
      193                         buf_gds-prt.node-code = buf_gds-dtl.prt-code no-error.
      194             assign
      195               name-item  = "SCALE:"
      196               name-scale = trim(string(buf_gds-prt.f-name))
      197               name-bc    = trim(string(buf_bar-code.b-code))
      198               .
      199           end.
      200           else do:
      201             assign
      202              name-item = "ITEM:"
      203              name-scale = ""
      204              name-bc    = trim(string(buf_bar-code.b-code))
      205              .
      206           end.
      207             put stream txt  unformatted
      208                 name-item +
      209                 buf_goods.artic + ";" +
      210                 trim(string(buf_goods.prod-code)) + ";" +
      211                 name-scale + ";;" +
      212                 name-bc    + ";" +
      213                 trim(string(buf_gds-dtl.price-base)) + ";" +
      214                 trim(string(buf_gds-dtl.fact-qnty)) + ";;;;;;;" +
      215                 name-gtd + ";;;" +
      216                 srok-god
      217                 SKIP.
      218         END.
      219         end.
      220         output close.
      221   end.
      222   message "Ёкспорт закончен."  view-as alert-box information buttons ok.
