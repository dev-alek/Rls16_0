        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: uchlinfx.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/uchlinfx.p $":U .
        7   define variable vss-description as character no-undo init "Заполнение номеров товарных строк и строк оплат по чекам, созданному в версиях TH < 11.1".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable v-num-ok as integer no-undo label "КОличество OK".
       67   define variable v-num-err as integer no-undo label "Количество ошибок".
       68   define variable v-num-old as integer no-undo  label "Количество найденных старых".
       69   define variable v-num-all as integer no-undo  label "Количество просмотренных".
       70   define variable v-gds-num-ok as integer no-undo label "КОличество стертых ошибок".
       71   define variable v-gds-num-err as integer no-undo label "Количество оставшихся ошибок".
       72   define variable v-gds-num-all as integer no-undo  label "Количество ошибочн товарн строк".
       73   define variable v-pay-num-ok as integer no-undo label "КОличество стертых ошибок".
       74   define variable v-pay-num-err as integer no-undo label "Количество оставшихся ошибок".
       75   define variable v-pay-num-all as integer no-undo  label "Количество ошибочн товарн строк".
       76   define variable v-ok as logical no-undo .
       77   define variable v-doc-code as character no-undo .
       78   define variable v-normal as logical no-undo .
       79   define buffer buf_chk-gds for ub.chk-gds.
       80   define buffer buf_chk-pay for ub.chk-pay.
       81   define buffer buf2_chk-gds for ub.chk-gds.
       82   define buffer buf2_chk-pay for ub.chk-pay.
       83   define buffer buf_chk-doc for ub.chk-doc.
       84   output to uchkinfx.txt append.
       85   put unformatted string(today, "99/99/9999") chr(32) string(time, "HH:MM:SS") skip.
       86   put unformatted
       87   substitute("Заполнение номеров строк старых чеков")
       88   skip.
       89   output close.
       90   define frame aa
       91   v-num-all skip
       92   v-num-old skip
       93   v-num-ok skip
       94   v-num-err
       95   WITH CENTERED ROW 3 TITLE "Заполнение номеров строк старых чеков" USE-TEXT.
       96   form with frame aa.
       97   _main:
       98   do:
       99     _for:
      100     for each buf_chk-doc no-lock,
      101         each buf_chk-gds no-lock where
      102               buf_chk-gds.doc-code = buf_chk-doc.doc-code
      103     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      104     on endkey undo, leave _main
      105     on stop undo, leave _main
      106     :
      107       if v-doc-code <> buf_chk-doc.doc-code then do:
      108         if v-num-all modulo 1000 = 0 then do:
      109           display
      110           v-num-all skip v-num-old skip v-num-ok skip v-num-err
      111           with frame aa.
      112         end.
      113         if v-num-all modulo 100 = 0 then do:
      114           process events.
      115         end.
      116         v-num-all = v-num-all + 1.
      117         v-doc-code = buf_chk-doc.doc-code.
      118         if buf_chk-gds.line-num = ? then do:
      119           if v-num-old modulo 10000 = 0 then do:
      120             display
      121             v-num-all skip v-num-old skip v-num-ok skip v-num-err
      122             with frame aa.
      123             output to uchkinfx.txt append.
      124             put unformatted string(today, "99/99/9999") chr(32) string(time, "HH:MM:SS") skip.
      125             put unformatted
      126             substitute("Кличество просмотренных &1, количество старых &2, количество OK &3, количество ошибок &4"
      127                       , v-num-all
      128                       , v-num-old
      129                       , v-num-ok
      130                       , v-num-err
      131                       )
      132             skip
      133             substitute("Номер текущего обрабатываемого чека &1", buf_chk-doc.doc-code )
      134             skip
      135             .
      136             output close.
      137           end.
      138           assign
      139           v-num-old = v-num-old + 1.
      140           run refill-line-num in this-procedure ( input buf_chk-doc.doc-cod, output v-ok) no-error .
      141           if error-status:error
      142           or not v-ok
      143           then do:
      144             output to uchkinfx.txt append.
      145             put unformatted string(today, "99/99/9999") chr(32) string(time, "HH:MM:SS") skip.
      146             put unformatted
      147             substitute("Ошибка при заполнении номеров строк по чеку &1 (&2) &3&4&5&6&5&7"
      148                       , buf_chk-doc.doc-code
      149                       , string(buf_chk-doc.chk-date, "99/99/9999")
      150                       , buf_chk-doc.obj-type
      151                       , buf_chk-doc.obj-code
      152                       , chr(10)
      153                       , error-status:get-message(1)
      154                       , return-value
      155                       )
      156             skip.
      157             output close.
      158             v-num-err = v-num-err + 1.
      159           end.
      160           else do:
      161             v-num-ok = v-num-ok + 1.
      162           end.
      163         end.
      164       end.
      165     end.
      166     v-normal = yes.
      167   end.
      168   if  v-normal then do:
      169     v-normal = no.
      170     define frame bb
      171     v-gds-num-all skip
      172     v-gds-num-ok skip
      173     v-gds-num-err
      174     WITH CENTERED ROW 3 TITLE "Заполнение номеров товарных строк" USE-TEXT.
      175     form with frame bb.
      176     _gds:
      177     do :
      178       _for:
      179       for each buf_chk-gds no-lock where
      180       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      181       on endkey undo, leave _gds
      182       on stop undo, leave _gds
      183       :
      184         if v-gds-num-all modulo 1000 = 0 then do:
      185           display
      186           v-gds-num-all skip v-gds-num-ok skip v-gds-num-err
      187           with frame bb.
      188         end.
      189         if v-gds-num-all modulo 100 = 0 then do:
      190           process events.
      191         end.
      192         v-gds-num-all = v-gds-num-all + 1.
      193         if buf_chk-gds.line-num = ? then do:
      194           find first buf_chk-doc no-lock where
      195                     buf_chk-doc.doc-code = buf_chk-gds.doc-code no-error.
      196           if not available buf_chk-doc
      197           and buf_chk-gds.out-code = ? then do:
      198             find first buf2_chk-gds where
      199                       recid(buf2_chk-gds) = recid(buf_chk-gds).
      200             delete buf2_chk-gds.
      201             assign
      202             v-gds-num-ok = v-gds-num-ok + 1.
      203           end.
      204           else do:
      205             assign
      206             v-gds-num-err = v-gds-num-err + 1
      207             .
      208           end.
      209         end.
      210       end.
      211       v-normal = yes.
      212     end.
      213   end.
      214   if v-normal then do:
      215     v-normal = no.
      216     define frame cc
      217     v-pay-num-all skip
      218     v-pay-num-ok skip
      219     v-pay-num-err
      220     WITH CENTERED ROW 3 TITLE "Заполнение номеров строк оплат" USE-TEXT.
      221     form with frame cc.
      222     _pay:
      223     do :
      224       _for:
      225       for each buf_chk-pay no-lock where
      226       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      227       on endkey undo, leave _pay
      228       on stop undo, leave _pay
      229       :
      230         if v-pay-num-all modulo 1000 = 0 then do:
      231           display
      232           v-pay-num-all skip v-pay-num-ok skip v-pay-num-err
      233           with frame cc.
      234         end.
      235         if v-pay-num-all modulo 100 = 0 then do:
      236           process events.
      237         end.
      238         v-pay-num-all = v-pay-num-all + 1.
      239         if buf_chk-pay.line-num = ? then do:
      240           find first buf_chk-doc no-lock where
      241                     buf_chk-doc.doc-code = buf_chk-pay.doc-code no-error.
      242           if not available buf_chk-doc
      243           and buf_chk-pay.out-code = ? then do:
      244             find first buf2_chk-pay where
      245                       recid(buf2_chk-pay) = recid(buf_chk-pay).
      246             delete buf2_chk-pay.
      247             assign
      248             v-pay-num-ok = v-pay-num-ok + 1.
      249           end.
      250           else do:
      251             assign
      252             v-pay-num-err = v-pay-num-err + 1
      253             .
      254           end.
      255         end.
      256       end.
      257       v-normal = yes.
      258     end.
      259   end.
      260   message "Завершено пользователем" view-as alert-box .
      261   output to uchkinfx.txt append.
      262   put unformatted string(today, "99/99/9999") chr(32) string(time, "HH:MM:SS") skip.
      263   put unformatted
      264   substitute("Кличество просмотренных &1, количество старых &2, количество OK &3, количество ошибок &4"
      265             , v-num-all
      266             , v-num-old
      267             , v-num-ok
      268             , v-num-err
      269             )
      270   skip
      271   substitute("Кличество просмотренных ошибочных товарн. строк &1, количество удаленных &2, количество оставшихся ошибок &4"
      272             , v-gds-num-all
      273             , v-gds-num-ok
      274             , v-gds-num-err
      275             )
      276   skip
      277   substitute("Кличество ошибочных просмотренных строк оплат &1, количество удаленных &2, количество оставшихся ошибок &4"
      278             , v-pay-num-all
      279             , v-pay-num-ok
      280             , v-pay-num-err
      281             )
      282   skip
      283   substitute("Заполнение закончено")
      284   skip
      285   .
      286   output close.
      287   display
      288   v-num-all skip v-num-old skip v-num-ok skip v-num-err
      289   with frame aa.
      290   procedure refill-line-num :
      291   define input parameter p-doc-code as character no-undo .
      292   define output parameter p-ok as logical no-undo .
      293   define variable ii as integer no-undo .
      294   define buffer buf_chk-gds for ub.chk-gds.
      295   define buffer buf_chk-pay for ub.chk-pay.
      296   main-block:
      297   do
      298   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      299   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      300   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      301   :
      302     find first buf_chk-doc exclusive-lock where
      303               buf_chk-doc.doc-code = p-doc-code no-wait no-error .
      304     if locked buf_chk-doc then do:
      305       undo, return error substitute("Запись чека с №1 занята", p-doc-code).
      306     end.
      307     if not available buf_chk-doc then undo, return error substitute("Не найден чек с №1", p-doc-code).
      308     for each buf_chk-gds where
      309             buf_chk-gds.doc-code = buf_chk-doc.doc-code
      310       on error undo, return error
      311             :
      312       assign
      313       ii = ii + 1
      314       buf_chk-gds.line-num = ii
      315       .
      316     end.
      317     ii = 0.
      318     for each buf_chk-pay where
      319             buf_chk-pay.doc-code = buf_chk-doc.doc-code
      320       on error undo, return error
      321             :
      322       assign
      323       ii = ii + 1
      324       buf_chk-pay.line-num = ii
      325       .
      326     end.
      327     assign
      328     p-ok = yes
      329     .
      330   end.
      331   end procedure.
