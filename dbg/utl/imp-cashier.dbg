        1    DEFINE VARIABLE chExcelApplication      AS COM-HANDLE no-undo .
        2   DEFINE VARIABLE chWorkbook              AS COM-HANDLE no-undo .
        3   DEFINE VARIABLE chWorksheet             AS COM-HANDLE no-undo .
        4   define input parameter parparentproc as widget-handle no-undo .
        5   DEFINE BUTTON B-file-2
        6        IMAGE-UP FILE "btn-down-arrow":U
        7        IMAGE-DOWN FILE "btn-down-arrow":U
        8        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
        9        LABEL ""
       10        SIZE 3 BY 1.
       11   DEFINE BUTTON B-quit AUTO-END-KEY
       12        LABEL "&Отмена"
       13        SIZE 10 BY 1
       14        BGCOLOR 8 .
       15   DEFINE BUTTON Btn_OK AUTO-GO
       16        LABEL "Ввод"
       17        SIZE 10 BY 1
       18        BGCOLOR 8 .
       19   DEFINE VARIABLE b-file AS CHARACTER FORMAT "X(256)":U
       20        LABEL "Файл"
       21        VIEW-AS FILL-IN
       22        SIZE 38 BY 1 NO-UNDO.
       23   DEFINE FRAME Dialog-Frame
       24        Btn_OK AT ROW 2 COL 6
       25        B-quit AT ROW 2 COL 16.5
       26        b-file AT ROW 5 COL 11 COLON-ALIGNED WIDGET-ID 2
       27        B-file-2 AT ROW 5 COL 52.5 WIDGET-ID 4
       28        SPACE(12.49) SKIP(5.16)
       29       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       30            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       31            TITLE "Импорт кассиров"
       32           DEFAULT-BUTTON Btn_OK CANCEL-BUTTON B-quit.
       33   ASSIGN
       34          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       35          FRAME Dialog-Frame:HIDDEN           = TRUE.
       36   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       37   DO:
       38     APPLY "END-ERROR":U TO SELF.
       39   END.
       40   ON CHOOSE OF B-file-2 IN FRAME Dialog-Frame
       41   DO:
       42         define variable ff as character no-undo.
       43       define variable v_os-file   AS CHAR NO-UNDO INIT "".
       44       define variable ll_commit AS LOG    NO-UNDO INIT NO.
       45       SYSTEM-DIALOG GET-FILE v_os-file
       46           TITLE "Выберите файл для импорта"
       47           FILTERS
       48           "excel (*.xls , *.xlsx)"   "*.xls, *.xlsx",
       49           " Все файлы (*.*) "                      "*.*"
       50           INITIAL-FILTER 1
       51           DEFAULT-EXTENSION ".xls , .xlsx"
       52           USE-FILENAME
       53           MUST-EXIST
       54           UPDATE ll_commit
       55           .
       56       IF ll_commit <> YES THEN do:
       57          RETURN NO-APPLY.
       58       end.
       59       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
       60           BELL.
       61           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
       62           RETURN NO-APPLY.
       63       END.
       64       ASSIGN b-file = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
       65       DISP b-file WITH FRAME Dialog-Frame.
       66   END.
       67   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
       68   DO:
       69   define variable firm-pairs as char no-undo.
       70   define variable person-pairs as char no-undo.
       71   define variable mydelimiter as char no-undo.
       72     assign
       73     b-file
       74     .
       75     if search(b-file) = ? then do:
       76       message "Не выбран файл импорта"
       77       view-as alert-box ERROR.
       78       return no-apply.
       79     end.
       80   run str/diallog.w (
       81                   input parparentproc
       82                 , input this-procedure
       83                 , input 'utl/in-imp-cashier.p':U
       84                 , input b-file
       85                 , INPUT no
       86                 , INPUT "&Стоп"
       87                 , INPUT 'Импорт кассиров') .
       88   END.
       89   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       90   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       91   MAIN-BLOCK:
       92   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       93      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       94     RUN enable_UI.
       95     WAIT-FOR GO OF FRAME Dialog-Frame.
       96   END.
       97   RUN disable_UI.
       98   PROCEDURE disable_UI :
       99     HIDE FRAME Dialog-Frame.
      100   END PROCEDURE.
      101   PROCEDURE enable_UI :
      102     DISPLAY b-file
      103         WITH FRAME Dialog-Frame.
      104     ENABLE Btn_OK b-file B-file-2 B-quit
      105         WITH FRAME Dialog-Frame.
      106     VIEW FRAME Dialog-Frame.
      107   END PROCEDURE.
