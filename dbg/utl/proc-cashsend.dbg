      541   define   shared variable g#esys-source-esys as integer no-undo.
      542   define   shared variable g#db-num as integer   no-undo .
      543   define   shared variable g#userid as character no-undo .
      544   define   shared variable g#passwd as character no-undo .
      545   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   define variable v-loc-counter as integer no-undo .
      547   define variable v-counter-visible as logical no-undo .
      548   define variable v-view-log as logical no-undo .
      549   define stream auto2dia.
      550   PROCEDURE write-log-and-file :
      551   do
      552   on error undo, return error
      553   :
      554     define input parameter p-tab-position   as integer   no-undo.
      555     define input parameter p-file-name      as character no-undo .
      556     define input parameter p-log-level      as integer   no-undo .
      557     define input parameter p-log-string     AS CHARacter NO-UNDO.
      558     define variable v-jj as integer   no-undo .
      559     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
      560     if p-file-name <> '':U then do:
      561       do v-jj = 1 to num-entries(p-file-name, chr(1)):
      562         run  auto2dia-writefile in this-procedure (
      563                                         input entry(v-jj, p-file-name, chr(1))
      564                                         ,input p-log-level
      565                                         ,input (p-log-string + chr(10))
      566                                       ) no-error .
      567       end.
      568     end.
      569     if writelogvalue eq "AsyncProc"
      570     then
      571        run write-to-log in this-procedure( p-log-string) .
      572   end.
      573   END PROCEDURE.
      574   PROCEDURE get-title :
      575   do
      576   on error undo, return error
      577   :
      578   define output parameter p-title     as character    no-undo.
      579   end.
      580   END PROCEDURE.
      581   PROCEDURE set-title :
      582   do
      583   on error undo, return error
      584   :
      585   define input parameter p-title     as character    no-undo.
      586   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
      587   end.
      588   END PROCEDURE.
      589   PROCEDURE get-counter-value :
      590   do
      591   on error undo, return error
      592   :
      593   define output parameter p-counter     as integer    no-undo.
      594       assign
      595       p-counter  = v-loc-counter
      596       .
      597   end.
      598   END PROCEDURE.
      599   PROCEDURE set-counter-value :
      600   do
      601   on error undo, return error
      602   :
      603   define input parameter p-counter     as integer    no-undo.
      604       assign
      605       v-loc-counter = p-counter
      606       .
      607   end.
      608   END PROCEDURE.
      609   PROCEDURE show-counter :
      610   do
      611   on error undo, return error
      612   :
      613       assign
      614       v-counter-visible = true
      615       .
      616       process events.
      617   end.
      618   END PROCEDURE.
      619   PROCEDURE hide-counter :
      620   do
      621   on error undo, return error
      622   :
      623       assign
      624       v-counter-visible = false
      625       .
      626       run hide-message in this-procedure .
      627       process events.
      628   end.
      629   END PROCEDURE.
      630   PROCEDURE write-counter :
      631   do
      632   on error undo, return error
      633   :
      634   define input parameter p-counter-string     as character    no-undo.
      635   if v-counter-visible then
      636   run write-message in this-procedure ( input p-counter-string) .
      637   process events.
      638   end.
      639   END PROCEDURE.
      640   PROCEDURE get-stop-state :
      641   do
      642   on error undo, return error
      643   :
      644   define output parameter p-stop-state    as logical      no-undo.
      645   end.
      646   END PROCEDURE.
      647   PROCEDURE set-view-log :
      648   do
      649   on error undo, return error
      650   :
      651   define input parameter p-view-log     as logical    no-undo.
      652       assign
      653       v-view-log = p-view-log
      654       .
      655   end.
      656   END PROCEDURE.
      657   PROCEDURE get-view-log :
      658   do
      659   on error undo, return error
      660   :
      661   define output parameter p-view-log     as logical    no-undo.
      662       assign
      663       p-view-log = v-view-log
      664       .
      665   end.
      666   END PROCEDURE.
      667   PROCEDURE write-log :
      668   do
      669   on error undo, return error
      670   :
      671   define input parameter p-tab-position   as integer      no-undo.
      672   define input parameter p-log-string     as character    no-undo.
      673   run write-to-log in this-procedure( input ( fill( chr(32), 1  * p-tab-position)  +
      674                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
      675                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      676                                       ELSE p-log-string))).
      677   end.
      678   END PROCEDURE.
      679   procedure writelog :
      680   do
      681   on error undo, return error
      682   :
      683   define input parameter p-file-name AS CHAR     NO-UNDO.
      684   define input parameter p-log-level AS INTEGER  NO-UNDO.
      685   define input parameter p-log-string  AS CHAR     NO-UNDO.
      686     if p-file-name <> "" then
      687     run  auto2dia-Writefile in this-procedure (
      688                                       input p-file-name
      689                                     ,input p-log-level
      690                                     ,input p-log-string
      691                                   ) no-error .
      692      process events.
      693   end.
      694   end procedure.
      695   PROCEDURE auto2dia-writefile:
      696     define input parameter sFileName AS CHAR     NO-UNDO.
      697     define input parameter iLogLevel AS INTEGER  NO-UNDO.
      698     define input parameter sToWrite  AS CHAR     NO-UNDO.
      699     define variable v-SlashPos  as integer no-undo .
      700     define variable v-lDirName  as character no-undo .
      701     define variable v-lDirName2 as character no-undo .
      702     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
      703     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
      704     FILE-INFO:FILE-NAME = v-lDirName .
      705     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
      706     if v-lDirName2 <> ? then do :
      707   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
      708       PUT STREAM auto2dia UNFORMATTED chr(10).
      709       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      710                                         OR sToWrite = "&Line") THEN "" ELSE
      711                                         cur-time-string-sec() + " ").
      712       PUT STREAM auto2dia UNFORMATTED
      713               (IF sToWrite = "&Line" THEN FILL("-", 80)
      714                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      715                ELSE sToWrite).
      716   OUTPUT STREAM auto2dia CLOSE.
      717     end .
      718   END PROCEDURE.
      719   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      720   define new shared temp-table gds-list no-undo like ub.goods
      721     field qnty   as decimal
      722     field to-del as logical
      723     field order-num as integer
      724     field to-sel as logical
      725     field promo-code as character
      726     field ActionId  as int64
      727     field db-num as integer
      728     index art  is primary unique artic prod-type prod-code
      729     index code is         unique gds-code
      730     index oi order-num
      731     index isel to-sel
      732     .
      733   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734   define  new shared  temp-table gds-list-hist no-undo
      735   field list-table as character
      736   field id as integer
      737   field line as integer
      738   field hist-mode as character
      739   field des as character
      740   field num-recs as integer
      741   field option_ as character
      742   field item_ as character
      743   field status_ as character
      744   field num-add as integer
      745   field num-ignored as integer
      746   field done as logical
      747   field err_ as logical
      748   field err-mes as character
      749   index pi is primary
      750   id
      751   line
      752   index isdone
      753   done
      754   .
      755   define variable mSocetLog as character no-undo.
      756   define variable mobjsend as character no-undo.
      757   define variable mshop as integer no-undo.
      758   define variable mcashnum as character no-undo init "?".
      759   define variable mMaxGoods as integer no-undo.
      760   mSocetLog = GetParamAsunc(1).
      761   mobjsend  =  GetParamAsunc(2).
      762   mshop     = int(GetParamAsunc(3)) no-error.
      763   if    error-status:error
      764      or mshop eq ?
      765   then do:
      766      run PutMesAsunc( "error  Не получен номер магазина" ).
      767      return.
      768   end.
      769   define variable mparam as character no-undo.
      770   mparam = GetParamAsunc(4).
      771   if     mparam ne ""
      772      and mparam ne ?
      773   then
      774      mCashNum  = mparam.
      775   mMaxGoods = int(GetParamAsunc(5)) no-error.
      776   if mobjsend eq "goods"
      777   then do:
      778      define variable mGoods as integer no-undo.
      779      block-Goods:
      780      for each goods no-lock:
      781         mGoods = mGoods + 1.
      782         if     mMaxGoods ne ?
      783            and mMaxGoods ne 0
      784            and mMaxGoods lt mGoods
      785         then
      786            leave block-Goods.
      787         create gds-list.
      788         buffer-copy goods to gds-list.
      789      end.
      790      run str/diallog.w (
      791                            input ?
      792                           ,input ?
      793                           ,input 'str/send-gds-onecash.p':U
      794                           ,input substitute ("&2&1&3&1&4&1&5",
      795                                              chr(4),
      796                                              mshop,
      797                                              yes,
      798                                              ?,
      799                                              mcashnum)
      800                           ,input yes
      801                           ,input '':U
      802                           ,input 'Отправка информации на кассу') no-error .
      803   end.
      804   else if mobjsend eq "gismt" or mobjsend eq "posonline" then do:
      805       run str/diallog.w (
      806           input ?
      807         , input ?
      808         , input "str/sendgismt.p":U
      809         , input substitute ("&2&1&3&1&4&1&5&1&6&1cash-send=&7,&8,&9",
      810                                      chr(4),
      811                                      'маг':U,
      812                                      mshop,
      813                                      'U':U,
      814                                      "gismt",
      815                                      'Передача настроек для проверки КМ':U,
      816                                      mCashNum,
      817                                      "SocetLog=" + mSocetLog,
      818                                      "cash-all=all"
      819                                      )
      820         , input ?
      821         , input "":U
      822         , input substitute("Отсылка настроек для проверки КМ")
      823     ) no-error.
      824   end.
      825   else
      826      run str/send-all.p(?,
      827                         this-procedure,
      828                         this-procedure,
      829                         substitute ("&2&1&3&1&4&1&5&1&6&1cash-send=&7,&8",
      830                                      chr(4),
      831                                      'маг':U,
      832                                      mshop,
      833                                      'U':U,
      834                                      mobjsend,
      835                                      'Получение параметров кассы':U,
      836                                      mCashNum,
      837                                      "SocetLog=" + mSocetLog
      838                                      )
      839                         )
      840      .
