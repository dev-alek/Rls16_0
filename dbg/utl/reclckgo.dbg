        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter parobj-type like ub.trn-doc.obj-type no-undo.
        4   define input parameter parobj-code like ub.trn-doc.obj-code no-undo.
        5   define input parameter p-action      as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: bf04b0e5cfa2, 2256, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: druban $":U .
        8   define variable vss-date        as character no-undo init "$Date: Wed Dec 25 15:24:01 2019 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: reclckgo.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/reclckgo.p $":U .
       11   define variable vss-description as character no-undo init "процедура импорта пакета".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define new global shared variable g#lib-trn  as handle no-undo .
       73   define new global shared variable g#lib-trn2 as handle no-undo .
       74   define new global shared variable g#lib-trn3 as handle no-undo .
       75   define new global shared variable g#lib-trn4 as handle no-undo .
       76   main_block:
       77   do
       78   on error  undo, return error substitute("&1. error main_block. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       79   on endkey undo, return error substitute("&1. endkey main_block")
       80   on stop   undo, return error substitute("&1. stop main_block")
       81   :
       82     define stream LogStream.
       83     define variable v-log-file-name as character no-undo .
       84     define variable v-pl-after-qnty  like ub.pl-gds.cli-fact-qnty    no-undo.
       85     define variable v-after-cli-qnty like ub.inv-line.after-cli-qnty no-undo.
       86     define variable v-qnty           like ub.doc-pl.fact-qnty        no-undo .
       87     define variable v-cli-qnty       like ub.doc-pl.cli-fact-qnty    no-undo .
       88     define variable v-crt-cli-qnty   like ub.doc-pl.cli-fact-qnty    no-undo .
       89     define variable v-new-cli-qnty   like ub.doc-pl.cli-fact-qnty    no-undo .
       90     define variable v-pl-qnty        as integer   no-undo .
       91     define variable v-correct-qnty   as decimal   no-undo .
       92     define variable v-recalc-doc-pl  as logical   no-undo .
       93     define variable v-sign           as decimal   no-undo .
       94     define variable v-free-qnty-pl   like ub.pl-gds.free-qnty        no-undo.
       95     define variable v-fact-qnty-pl   like ub.pl-gds.fact-qnty        no-undo.
       96     define variable v-free-qnty      like ub.gds-obj.free-qnty       no-undo.
       97     define variable v-fact-qnty      like ub.gds-obj.fact-qnty       no-undo.
       98     define variable varschartic      as character no-undo .
       99     define variable varnotes         as character no-undo.
      100     define variable varlns-cnt       as integer   no-undo.
      101     define variable varis-petrolium  as logical   no-undo.
      102     define variable varis-pieces     as logical   no-undo.
      103     define buffer buf_sys-ctrl       for ub.sys-ctrl .
      104     define buffer buf_goods          for ub.goods .
      105     define buffer buf_doc-line       for ub.doc-line .
      106     define buffer buf_inv-line       for ub.inv-line .
      107     define buffer buf-first_trn-doc  for ub.trn-doc .
      108     define buffer buf-first_doc-line for ub.doc-line .
      109     define buffer buf-first_inv-line for ub.inv-line .
      110     define buffer buf-prev_doc-line  for ub.doc-line .
      111     define buffer buf-prev_inv-line  for ub.inv-line .
      112     define buffer buf_trn-doc        for ub.trn-doc .
      113     define buffer buf-parts_trn-doc  for ub.trn-doc .
      114     define buffer buf-parts_doc-pl   for ub.doc-pl .
      115     define buffer buf_doc-pl         for ub.doc-pl .
      116     define buffer buf_gds-obj        for ub.gds-obj .
      117     define buffer buf_pl-gds         for ub.pl-gds .
      118     define buffer buf-all_pl-gds     for ub.pl-gds .
      119     define buffer buf_parts          for ub.parts .
      120     define frame d-info
      121       buf_goods.gds-code    label "Товар"    format ">>>>>>>>>9" skip
      122       buf_doc-line.doc-code label "Документ" format "x(50)" skip
      123       buf_trn-doc.fact-date label "Дата"     format "99/99/9999" skip
      124       with view-as dialog-box side-labels 1 columns three-d title "Пересчет топливного остатка"
      125     .
      126     find first buf_sys-ctrl no-lock .
      127     assign
      128       v-log-file-name = substitute( "reclckgo-&1.log":U, buf_sys-ctrl.db-num )
      129     .
      130     run str/chs-gds.w
      131       ( input parparentproc
      132        ,input parobj-type
      133        ,input parobj-code
      134        ,input '':U
      135        ,input '':U
      136        ,input "Утилита пересчета остатков в кг по топливным товарам"
      137        ,input 'все':U
      138        ,input ?
      139        ,input ?
      140        ,input ?
      141        ,input ?
      142        ,input-output varschartic
      143        ,output varnotes
      144       ) no-error.
      145     view frame d-info.
      146     output stream LogStream to value( v-log-file-name ) append.
      147     put stream LogStream unformatted
      148       skip(1)
      149       substitute( "&1 &2. Запуск &3 для объекта &4 &5"
      150                   ,string( today, "99/99/9999" )
      151                   ,string( time, "HH:MM:SS" )
      152                   ,(if p-action = "calc":U then "пересчета" else "проверки" )
      153                   ,parobj-type
      154                   ,parobj-code
      155                 )
      156       skip
      157       .
      158     output stream LogStream close.
      159     lns-cnt:
      160     do varlns-cnt = 1 to num-entries (varnotes)
      161     on error undo, return error return-value
      162     :
      163       find first buf_goods no-lock
      164         where recid(buf_goods) = integer (entry (varlns-cnt, varnotes))
      165       .
      166   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      167     (
      168        input buf_goods.artic
      169     ,  input buf_goods.prod-type
      170     ,  input buf_goods.prod-code
      171     , output varis-petrolium
      172     , output varis-pieces
      173     ) .
      174       if not( varis-petrolium = true
      175               and varis-pieces = false
      176             )
      177       then do:
      178         next lns-cnt.
      179       end.
      180       output stream LogStream to value( v-log-file-name ) append.
      181       put stream LogStream unformatted
      182         skip(1)
      183         substitute( "Товар: код &1, артикул &2, производитель &3 &4", buf_goods.gds-code, buf_goods.artic, buf_goods.prod-type, buf_goods.prod-code )
      184         skip(1)
      185         .
      186       output stream LogStream close.
      187       assign
      188         v-after-cli-qnty = 0.0
      189         v-qnty           = 0.0
      190         v-cli-qnty       = 0.0
      191       .
      192       find first buf_gds-obj exclusive-lock
      193         where buf_gds-obj.obj-type  = parobj-type
      194           and buf_gds-obj.obj-code  = parobj-code
      195           and buf_gds-obj.artic     = buf_goods.artic
      196           and buf_gds-obj.prod-type = buf_goods.prod-type
      197           and buf_gds-obj.prod-code = buf_goods.prod-code
      198         no-error .
      199       if not available buf_gds-obj then do:
      200         output stream LogStream to value( v-log-file-name ) append.
      201         put stream LogStream unformatted
      202           substitute( "Не было движения товара на объекте &1 &2 !", parobj-type, parobj-code )
      203           skip(1)
      204           .
      205         output stream LogStream close.
      206         next lns-cnt.
      207       end.
      208       find first buf-first_doc-line share-lock
      209         where buf-first_doc-line.obj-type   = parobj-type
      210           and buf-first_doc-line.obj-code   = parobj-code
      211           and buf-first_doc-line.prod-type  = buf_goods.prod-type
      212           and buf-first_doc-line.prod-code  = buf_goods.prod-code
      213           and buf-first_doc-line.artic      = buf_goods.artic
      214           and buf-first_doc-line.status_    = 'факт':U
      215           and buf-first_doc-line.fact-order > 0.0
      216         use-index fact-order
      217         no-error.
      218       if available buf-first_doc-line then do:
      219         find first buf-first_trn-doc share-lock
      220           where buf-first_trn-doc.doc-code = buf-first_doc-line.doc-code
      221           .
      222         find first buf-first_inv-line share-lock
      223           where buf-first_inv-line.doc-code  = buf-first_doc-line.doc-code
      224             and buf-first_inv-line.artic     = buf-first_doc-line.artic
      225             and buf-first_inv-line.prod-type = buf-first_doc-line.prod-type
      226             and buf-first_inv-line.prod-code = buf-first_doc-line.prod-code
      227           no-error.
      228         if available buf-first_inv-line then do:
      229           if lookup( buf-first_trn-doc.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then do:
      230             assign
      231               v-sign = -1.0
      232             .
      233           end.
      234           else do:
      235             assign
      236               v-sign = 1.0
      237             .
      238           end.
      239           for each buf_doc-pl exclusive-lock
      240             where buf_doc-pl.out-code = buf-first_doc-line.doc-code
      241               and buf_doc-pl.gds-code = buf_goods.gds-code
      242               and buf_doc-pl.obj-type = buf-first_doc-line.obj-type
      243               and buf_doc-pl.obj-code = buf-first_doc-line.obj-code
      244           on error undo, return error return-value
      245           :
      246             assign
      247               v-qnty     = v-qnty     + buf_doc-pl.fact-qnty * v-sign
      248               v-cli-qnty = v-cli-qnty + buf_doc-pl.cli-fact-qnty * v-sign
      249             .
      250           end.
      251           if buf-first_trn-doc.doc-type = 'инв':U then do:
      252             if buf-first_doc-line.cli-qnty <> v-cli-qnty * v-sign then do:
      253               output stream LogStream to value( v-log-file-name ) append.
      254               put stream LogStream unformatted
      255                 substitute("Ошибка в первом документе." ) skip
      256                 substitute("Документ &1 (&2)", buf-first_doc-line.doc-code, buf-first_trn-doc.doc-type) skip
      257                 substitute("Сумма по местам хранения &1 (&2)", v-cli-qnty * v-sign, buf_goods.unit-cli) skip
      258                 substitute("Сумма по строке &1 (&2)", buf-first_doc-line.cli-qnty, buf_goods.unit-cli) skip
      259                 substitute("Сумма по местам хранения &1 (&2)", v-qnty * v-sign, buf_goods.unit-base) skip
      260                 substitute("Сумма по строке &1 (&2)", buf-first_doc-line.fact-qnty, buf_goods.unit-base) skip
      261                 .
      262               output stream LogStream close.
      263               if p-action = "calc":U then do:
      264                 undo, next lns-cnt.
      265               end.
      266             end.
      267             else do:
      268               assign
      269                 v-after-cli-qnty = buf-first_inv-line.after-cli-qnty - buf-first_doc-line.cli-qnty
      270               .
      271             end.
      272           end.
      273           else do:
      274             if buf-first_inv-line.wast-cli-qnty <> v-cli-qnty * v-sign then do:
      275               output stream LogStream to value( v-log-file-name ) append.
      276               put stream LogStream unformatted
      277                 substitute("Ошибка в первом документе." ) skip
      278                 substitute("Документ &1 (&2)", buf-first_doc-line.doc-code, buf-first_trn-doc.doc-type) skip
      279                 substitute("Сумма по местам хранения &1 (&2)", v-cli-qnty * v-sign, buf_goods.unit-cli) skip
      280                 substitute("Сумма по строке &1 (&2)", buf-first_inv-line.wast-cli-qnty, buf_goods.unit-cli) skip
      281                 substitute("Сумма по местам хранения &1 (&2)", v-qnty * v-sign, buf_goods.unit-base) skip
      282                 substitute("Сумма по строке &1 (&2)", buf-first_doc-line.fact-qnty, buf_goods.unit-base) skip
      283                 substitute("Плотность &1", buf-first_doc-line.fact-density) skip
      284                 .
      285               output stream LogStream close.
      286               if p-action = "calc":U then do:
      287                 undo, next lns-cnt.
      288               end.
      289             end.
      290             else do:
      291               assign
      292                 v-after-cli-qnty = buf-first_inv-line.after-cli-qnty - buf-first_inv-line.wast-cli-qnty * v-sign
      293               .
      294             end.
      295           end.
      296         end.
      297       end.
      298       for each buf_doc-line exclusive-lock
      299         where buf_doc-line.obj-type  = parobj-type
      300           and buf_doc-line.obj-code  = parobj-code
      301           and buf_doc-line.prod-type = buf_goods.prod-type
      302           and buf_doc-line.prod-code = buf_goods.prod-code
      303           and buf_doc-line.artic     = buf_goods.artic
      304           and buf_doc-line.status_   = 'факт':U
      305         use-index fact-order
      306       on error undo, return error return-value
      307       :
      308         find first buf_trn-doc exclusive-lock
      309           where buf_trn-doc.doc-code = buf_doc-line.doc-code
      310         .
      311         display
      312           buf_goods.gds-code
      313           buf_doc-line.doc-code
      314           buf_trn-doc.fact-date
      315           with frame d-info
      316         .
      317         output stream LogStream to value( v-log-file-name ) append.
      318         put stream LogStream unformatted
      319           substitute( "Документ: &1", string( buf_trn-doc.doc-code, "X(25)") ) space(1)
      320           .
      321         output stream LogStream close.
      322         find first buf_inv-line exclusive-lock
      323           where buf_inv-line.doc-code  = buf_doc-line.doc-code
      324             and buf_inv-line.artic     = buf_doc-line.artic
      325             and buf_inv-line.prod-type = buf_doc-line.prod-type
      326             and buf_inv-line.prod-code = buf_doc-line.prod-code
      327           no-error.
      328         if not available buf_inv-line then do:
      329           output stream LogStream to value( v-log-file-name ) append.
      330           put stream LogStream unformatted
      331             skip
      332             substitute("Отсутствует информация о весовом кол-ве товара (not available inv-line)" ) space(1)
      333             .
      334           output stream LogStream close.
      335           if p-action = "calc":U then do:
      336             undo, next lns-cnt.
      337           end.
      338         end.
      339         else do:
      340           find last buf-prev_doc-line exclusive-lock
      341             where buf-prev_doc-line.obj-type   = buf_doc-line.obj-type
      342               and buf-prev_doc-line.obj-code   = buf_doc-line.obj-code
      343               and buf-prev_doc-line.prod-type  = buf_goods.prod-type
      344               and buf-prev_doc-line.prod-code  = buf_goods.prod-code
      345               and buf-prev_doc-line.artic      = buf_goods.artic
      346               and buf-prev_doc-line.status_    = 'факт':U
      347               and buf-prev_doc-line.fact-order < buf_doc-line.fact-order
      348             use-index fact-order
      349             no-error.
      350           if available buf-prev_doc-line then do:
      351             find first buf-prev_inv-line exclusive-lock
      352               where buf-prev_inv-line.doc-code  = buf-prev_doc-line.doc-code
      353                 and buf-prev_inv-line.artic     = buf-prev_doc-line.artic
      354                 and buf-prev_inv-line.prod-type = buf-prev_doc-line.prod-type
      355                 and buf-prev_inv-line.prod-code = buf-prev_doc-line.prod-code
      356               no-error.
      357             if available buf-prev_inv-line
      358               and p-action = "calc":U
      359               and absolute( v-after-cli-qnty - buf-prev_inv-line.after-cli-qnty ) > 0.001
      360             then do:
      361               output stream LogStream to value( v-log-file-name ) append.
      362               put stream LogStream unformatted
      363                 skip(1)
      364                 substitute("Ошибка расчета документа!!! Нарастающий итог (до документа) &1, а по предыдущему документу &2", v-after-cli-qnty, buf-prev_inv-line.after-cli-qnty ) skip
      365                 .
      366               output stream LogStream close.
      367               undo, next lns-cnt.
      368             end.
      369           end.
      370           output stream LogStream to value( v-log-file-name ) append.
      371           put stream LogStream unformatted
      372             skip
      373             substitute("перед док: &1 (&2)"
      374                        ,(if p-action = "calc":U then string(v-after-cli-qnty, "->,>>>,>>>,>>9.999" ) else string(buf_inv-line.before-cli-qnty, "->,>>>,>>>,>>9.999" ) )
      375                        ,buf_goods.unit-cli
      376                       ) space(1)
      377             .
      378           output stream LogStream close.
      379           if lookup( buf_trn-doc.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then do:
      380             assign
      381               v-sign = -1.0
      382             .
      383           end.
      384           else do:
      385             assign
      386               v-sign = 1.0
      387             .
      388           end.
      389           assign
      390             v-pl-qnty       = 0
      391             v-qnty          = 0.0
      392             v-cli-qnty      = 0.0
      393             v-recalc-doc-pl = false
      394           .
      395           for each buf_doc-pl exclusive-lock
      396             where buf_doc-pl.out-code = buf_doc-line.doc-code
      397               and buf_doc-pl.gds-code = buf_goods.gds-code
      398               and buf_doc-pl.obj-type = buf_doc-line.obj-type
      399               and buf_doc-pl.obj-code = buf_doc-line.obj-code
      400           on error undo, return error return-value
      401           :
      402             assign
      403               v-pl-qnty  = v-pl-qnty  + 1
      404               v-qnty     = v-qnty     + buf_doc-pl.fact-qnty * v-sign
      405               v-cli-qnty = v-cli-qnty + buf_doc-pl.cli-fact-qnty * v-sign
      406             .
      407           end.
      408           output stream LogStream to value( v-log-file-name ) append.
      409           put stream LogStream unformatted
      410             substitute( "мест хр.: &1"
      411                         , string( v-pl-qnty, ">>9")
      412                       )
      413             space(1)
      414             .
      415           output stream LogStream close.
      416           if absolute( buf_doc-line.fact-qnty - v-qnty * v-sign ) <= 0.001
      417             and v-cli-qnty = 0.0
      418           then do:
      419             case buf_trn-doc.doc-type :
      420               when 'инв':U then do:
      421                 if v-pl-qnty = 1
      422                   and absolute( buf_doc-line.cli-qnty - v-cli-qnty * v-sign ) > 0.001
      423                 then do:
      424                   assign
      425                     v-recalc-doc-pl = true
      426                     v-new-cli-qnty = buf_doc-line.cli-qnty * v-sign
      427                   .
      428                 end.
      429               end.
      430               otherwise do:
      431                 if absolute( buf_inv-line.wast-cli-qnty - v-cli-qnty * v-sign ) > 0.001
      432                 then do:
      433                   assign
      434                     v-recalc-doc-pl = true
      435                     v-new-cli-qnty = buf_inv-line.wast-cli-qnty * v-sign
      436                   .
      437                 end.
      438               end.
      439             end case.
      440           end.
      441           if p-action = "calc":U
      442             and v-recalc-doc-pl = true
      443           then do:
      444             block_correct-doc-pl:
      445             do
      446             on error  undo block_correct-doc-pl, leave block_correct-doc-pl
      447             on endkey undo block_correct-doc-pl, leave block_correct-doc-pl
      448             on stop   undo block_correct-doc-pl, leave block_correct-doc-pl
      449             :
      450               assign
      451                 v-crt-cli-qnty = 0.0
      452                 v-correct-qnty = v-new-cli-qnty * v-sign
      453               .
      454               for each buf_doc-pl exclusive-lock
      455                 where buf_doc-pl.out-code = buf_doc-line.doc-code
      456                   and buf_doc-pl.gds-code = buf_goods.gds-code
      457                   and buf_doc-pl.obj-type = buf_doc-line.obj-type
      458                   and buf_doc-pl.obj-code = buf_doc-line.obj-code
      459                 break by buf_doc-pl.pl-code
      460               on error  undo block_correct-doc-pl, leave block_correct-doc-pl
      461               on endkey undo block_correct-doc-pl, leave block_correct-doc-pl
      462               on stop   undo block_correct-doc-pl, leave block_correct-doc-pl
      463               :
      464                 if first( buf_doc-pl.pl-code )
      465                   and last( buf_doc-pl.pl-code )
      466                 then do:
      467                   assign
      468                     buf_doc-pl.cli-fact-qnty = v-new-cli-qnty * v-sign
      469                     v-correct-qnty = 0.0
      470                   .
      471                 end.
      472                 else do:
      473                   if v-qnty <> 0.0 then do:
      474                     assign
      475                       buf_doc-pl.cli-fact-qnty = v-new-cli-qnty * buf_doc-pl.fact-qnty / v-qnty
      476                       v-correct-qnty = v-correct-qnty - buf_doc-pl.cli-fact-qnty
      477                     .
      478                     if last( buf_doc-pl.pl-code )
      479                       and absolute( v-correct-qnty ) <= 0.001
      480                       and absolute( v-correct-qnty ) > 0.0
      481                     then do:
      482                       assign
      483                         buf_doc-pl.cli-fact-qnty = buf_doc-pl.cli-fact-qnty + v-correct-qnty
      484                         v-correct-qnty = 0.0
      485                       .
      486                     end.
      487                   end.
      488                   else do:
      489                     if v-new-cli-qnty = 0.0 then do:
      490                       assign
      491                         buf_doc-pl.cli-fact-qnty = 0.0
      492                         v-correct-qnty = 0.0
      493                       .
      494                     end.
      495                     else do:
      496                     end.
      497                   end.
      498                 end.
      499                 assign
      500                   v-crt-cli-qnty = v-crt-cli-qnty + buf_doc-pl.cli-fact-qnty * v-sign
      501                 .
      502               end.
      503               if v-correct-qnty <> 0.0
      504                 or v-crt-cli-qnty <> v-new-cli-qnty
      505               then do:
      506                 undo block_correct-doc-pl .
      507               end.
      508               else do:
      509                 assign
      510                   v-cli-qnty = v-crt-cli-qnty
      511                 .
      512               end.
      513             end.
      514           end.
      515           case buf_trn-doc.doc-type :
      516             when 'инв':U
      517             then do:
      518               if absolute( buf_doc-line.cli-qnty - v-cli-qnty * v-sign ) <= 0.001
      519                 and absolute( buf_doc-line.fact-qnty - v-qnty * v-sign ) <= 0.001
      520               then do:
      521                 if p-action = "calc":U then do:
      522                   assign
      523                     buf_doc-line.cli-qnty = v-cli-qnty * v-sign
      524                   .
      525                 end.
      526                 output stream LogStream to value( v-log-file-name ) append.
      527                 put stream LogStream unformatted
      528                   substitute("по инв: &1 (&2)"
      529                              ,string(buf_doc-line.cli-qnty, "->,>>>,>>>,>>9.999" )
      530                              ,buf_goods.unit-cli
      531                             )
      532                   space(1)
      533                   .
      534                 output stream LogStream close.
      535               end.
      536               else do:
      537                 output stream LogStream to value( v-log-file-name ) append.
      538                 put stream LogStream unformatted
      539                   skip(1)
      540                   substitute("Ошибка в строке инвентаризации. &1", (if v-recalc-doc-pl = true and p-action <> "calc":U then "(Возможно исправится при пересчете)" else "":U ) ) skip
      541                   substitute("Сумма по местам хранения &1 (&2)", v-cli-qnty * v-sign, buf_goods.unit-cli) skip
      542                   substitute("Сумма по строке &1 (&2)", buf_doc-line.cli-qnty, buf_goods.unit-cli) skip
      543                   substitute("Сумма по местам хранения &1 (&2)", v-qnty * v-sign, buf_goods.unit-base) skip
      544                   substitute("Сумма по строке &1 (&2)", buf_doc-line.fact-qnty, buf_goods.unit-base) skip
      545                   .
      546                 output stream LogStream close.
      547                 if p-action = "calc":U then do:
      548                   undo, next lns-cnt.
      549                 end.
      550               end.
      551             end.
      552             otherwise do:
      553               if absolute( buf_inv-line.wast-cli-qnty - v-cli-qnty * v-sign ) <= 0.001
      554                 and absolute( buf_doc-line.fact-qnty - v-qnty * v-sign ) <= 0.001
      555               then do:
      556                 if p-action = "calc":U then do:
      557                   assign
      558                     buf_inv-line.wast-cli-qnty = v-cli-qnty * v-sign
      559                   .
      560                 end.
      561                 output stream LogStream to value( v-log-file-name ) append.
      562                 put stream LogStream unformatted
      563                   substitute("по док: &1 (&2)"
      564                              ,string(buf_inv-line.wast-cli-qnty, "->,>>>,>>>,>>9.999" )
      565                              ,buf_goods.unit-cli
      566                             )
      567                   space(1)
      568                   .
      569                 output stream LogStream close.
      570               end.
      571               else do:
      572                 output stream LogStream to value( v-log-file-name ) append.
      573                 put stream LogStream unformatted
      574                   skip(1)
      575                   substitute("Ошибка в строке документа. &1", (if v-recalc-doc-pl = true and p-action <> "calc":U then "(Возможно исправится при пересчете)" else "":U ) ) skip
      576                   substitute("Сумма по местам хранения &1 (&2)", v-cli-qnty * v-sign, buf_goods.unit-cli) skip
      577                   substitute("Сумма по строке &1 (&2)", buf_inv-line.wast-cli-qnty, buf_goods.unit-cli) skip
      578                   substitute("Сумма по местам хранения &1 (&2)", v-qnty * v-sign, buf_goods.unit-base) skip
      579                   substitute("Сумма по строке &1 (&2)", buf_doc-line.fact-qnty, buf_goods.unit-base) skip
      580                   substitute("Плотность &1", buf_doc-line.fact-density) skip
      581                   .
      582                 output stream LogStream close.
      583                 if p-action = "calc":U then do:
      584                   undo, next lns-cnt.
      585                 end.
      586               end.
      587             end.
      588           end case.
      589           if p-action = "calc":U then do:
      590             assign
      591               buf_inv-line.before-cli-qnty = v-after-cli-qnty
      592               buf_inv-line.after-cli-qnty  = buf_inv-line.before-cli-qnty + v-cli-qnty
      593             .
      594             if buf_trn-doc.doc-type = 'инв':U then do:
      595               assign
      596                 buf_inv-line.wast-cli-qnty = buf_inv-line.after-cli-qnty
      597               .
      598             end.
      599           end.
      600           assign
      601             v-after-cli-qnty = v-after-cli-qnty + v-cli-qnty
      602           .
      603           output stream LogStream to value( v-log-file-name ) append.
      604           put stream LogStream unformatted
      605             substitute("после док: &1 (&2)"
      606                        ,string( buf_inv-line.after-cli-qnty, "->,>>>,>>>,>>9.999" )
      607                        ,buf_goods.unit-cli
      608                       )
      609             skip
      610             .
      611           output stream LogStream close.
      612           if available buf-prev_inv-line
      613             and absolute( buf_inv-line.before-cli-qnty - buf-prev_inv-line.after-cli-qnty ) > 0.001
      614           then do:
      615             output stream LogStream to value( v-log-file-name ) append.
      616             put stream LogStream unformatted
      617               skip(1)
      618               substitute("Ошибка между документами!!! Нарастающий итог (до док.) &1, а по предыдущему документу &2", buf_inv-line.before-cli-qnty, buf-prev_inv-line.after-cli-qnty ) skip
      619               .
      620             output stream LogStream close.
      621           end.
      622         end.
      623       end.
      624       assign
      625         v-free-qnty = 0.0
      626         v-fact-qnty = 0.0
      627       .
      628       for each buf_pl-gds exclusive-lock
      629         where buf_pl-gds.gds-code = buf_goods.gds-code
      630           and buf_pl-gds.obj-type = parobj-type
      631           and buf_pl-gds.obj-code = parobj-code
      632         break by buf_pl-gds.pl-code
      633       on error undo, return error return-value
      634       :
      635         if p-action = "calc":U then do:
      636           if buf_gds-obj.fact-qnty = 0.0 then do:
      637             assign
      638               buf_pl-gds.cli-fact-qnty = v-after-cli-qnty
      639             .
      640             if v-after-cli-qnty <> 0.0 then do:
      641               for each buf-all_pl-gds exclusive-lock
      642                 where buf-all_pl-gds.gds-code = buf_pl-gds.gds-code
      643                   and buf-all_pl-gds.obj-type = buf_pl-gds.obj-type
      644                   and buf-all_pl-gds.obj-code = buf_pl-gds.obj-code
      645               on error undo, return error return-value
      646               :
      647                 if buf-all_pl-gds.pl-code <> buf_pl-gds.pl-code then do:
      648                   assign
      649                     buf_pl-gds.cli-fact-qnty = buf_pl-gds.cli-fact-qnty - buf-all_pl-gds.cli-fact-qnty
      650                   .
      651                 end.
      652               end.
      653             end.
      654           end.
      655           else do:
      656             assign
      657               buf_pl-gds.cli-fact-qnty = v-after-cli-qnty / buf_gds-obj.fact-qnty * buf_pl-gds.fact-qnty
      658             .
      659           end.
      660         end.
      661         assign
      662           v-pl-after-qnty = v-pl-after-qnty + buf_pl-gds.cli-fact-qnty
      663         .
      664         if last( buf_pl-gds.pl-code ) then do:
      665           if p-action = "calc":U
      666             and absolute( v-after-cli-qnty - v-pl-after-qnty ) <= 0.001
      667           then do:
      668             assign
      669               buf_pl-gds.cli-fact-qnty = buf_pl-gds.cli-fact-qnty + v-after-cli-qnty - v-pl-after-qnty
      670             .
      671           end.
      672         end.
      673         if p-action = "calc":U then do:
      674           assign
      675             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
      676           .
      677         end.
      678         assign
      679           v-free-qnty-pl = 0.0
      680           v-fact-qnty-pl = 0.0
      681         .
      682         for each buf_parts share-lock
      683           where buf_parts.prod-type = buf_goods.prod-type
      684             and buf_parts.prod-code = buf_goods.prod-code
      685             and buf_parts.artic     = buf_goods.artic
      686             and buf_parts.obj-type  = buf_pl-gds.obj-type
      687             and buf_parts.obj-code  = buf_pl-gds.obj-code
      688             and buf_parts.status_   = no
      689             and buf_parts.rsrv-free = yes
      690             and buf_parts.obj-type  = buf_pl-gds.obj-type
      691             and buf_parts.obj-code  = buf_pl-gds.obj-code
      692             and buf_parts.pl-code   = buf_pl-gds.pl-code
      693           break by buf_parts.out-code
      694         on error undo, return error return-value
      695         :
      696           if buf_parts.out-code <> 'free-zone':U then do:
      697             find first buf-parts_trn-doc exclusive-lock
      698               where buf-parts_trn-doc.doc-code = buf_parts.out-code
      699               .
      700             if buf-parts_trn-doc.status_ <> 'факт':U then do:
      701               find first buf-parts_doc-pl exclusive-lock
      702                 where buf-parts_doc-pl.obj-type = buf_parts.obj-type
      703                   and buf-parts_doc-pl.obj-code = buf_parts.obj-code
      704                   and buf-parts_doc-pl.pl-code  = buf_parts.pl-code
      705                   and buf-parts_doc-pl.out-code = buf_parts.out-code
      706                   and buf-parts_doc-pl.gds-code = buf_goods.gds-code
      707                 .
      708               if buf-parts_trn-doc.doc-type = 'инв':U then do:
      709                 if buf_parts.in-code = buf_parts.out-code then do:
      710                   assign
      711                     v-fact-qnty-pl = v-fact-qnty-pl - absolute(buf_parts.qnty)
      712                   .
      713                   if p-action = "calc":U then do:
      714                     assign
      715                       buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty
      716                                                 + absolute(buf_parts.qnty) * (buf-parts_doc-pl.cli-rest-af-qnty - buf-parts_doc-pl.cli-rest-bf-qnty)
      717                                                                             / (buf-parts_doc-pl.rest-af-qnty - buf-parts_doc-pl.rest-bf-qnty)
      718                     .
      719                   end.
      720                 end.
      721               end.
      722               else do:
      723                 if buf_parts.in-code <> buf_parts.out-code then do:
      724                   assign
      725                     v-fact-qnty-pl = v-fact-qnty-pl + absolute(buf_parts.qnty)
      726                   .
      727                   if p-action = "calc":U then do:
      728                     assign
      729                       buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - absolute(buf_parts.qnty) * buf-parts_doc-pl.cli-fact-qnty / buf-parts_doc-pl.fact-qnty
      730                     .
      731                   end.
      732                 end.
      733               end.
      734             end.
      735           end.
      736           else do:
      737             assign
      738               v-free-qnty-pl = v-free-qnty-pl + absolute(buf_parts.qnty)
      739               v-fact-qnty-pl = v-fact-qnty-pl + absolute(buf_parts.qnty)
      740             .
      741           end.
      742         end.
      743         assign
      744           v-free-qnty = v-free-qnty + v-free-qnty-pl
      745           v-fact-qnty = v-fact-qnty + v-fact-qnty-pl
      746         .
      747         if v-free-qnty-pl <> buf_pl-gds.free-qnty then do:
      748           output stream LogStream to value( v-log-file-name ) append.
      749           put stream LogStream unformatted
      750             substitute('Кол-во "свободно" по партиям (&1 &2) не совпадает с кол-вом (&3 &2) на месте хранения &4'
      751                        ,v-free-qnty-pl
      752                        ,buf_goods.unit-base
      753                        ,buf_pl-gds.free-qnty
      754                        ,buf_pl-gds.pl-code
      755                       )
      756             skip
      757             .
      758           output stream LogStream close.
      759         end.
      760         if v-fact-qnty-pl <> buf_pl-gds.fact-qnty then do:
      761           output stream LogStream to value( v-log-file-name ) append.
      762           put stream LogStream unformatted
      763             substitute('Кол-во "факт" по партиям (&1 &2) не совпадает с кол-вом (&3 &2) на месте хранения &4'
      764                        ,v-fact-qnty-pl
      765                        ,buf_goods.unit-base
      766                        ,buf_pl-gds.fact-qnty
      767                        ,buf_pl-gds.pl-code
      768                       )
      769             skip
      770             .
      771           output stream LogStream close.
      772         end.
      773       end.
      774       if v-free-qnty <> buf_gds-obj.free-qnty then do:
      775         output stream LogStream to value( v-log-file-name ) append.
      776         put stream LogStream unformatted
      777           substitute('Кол-во "свободно" по товару (&1 &2) не совпадает с кол-вом (&3 &2) по партиям'
      778                      ,buf_gds-obj.free-qnty
      779                      ,buf_goods.unit-base
      780                      ,v-free-qnty
      781                     )
      782           skip
      783           .
      784         output stream LogStream close.
      785       end.
      786       if v-fact-qnty <> buf_gds-obj.fact-qnty then do:
      787         output stream LogStream to value( v-log-file-name ) append.
      788         put stream LogStream unformatted
      789           substitute('Кол-во "факт" по товару (&1 &2) не совпадает с кол-вом (&3 &2) по партиям'
      790                      ,buf_gds-obj.fact-qnty
      791                      ,buf_goods.unit-base
      792                      ,v-fact-qnty
      793                     )
      794           skip
      795           .
      796         output stream LogStream close.
      797       end.
      798     end.
      799   end.
      800   hide frame d-info.
      801   message
      802     "Расчет закончен" skip
      803     substitute( "Полная информация находится в файле: &1", search( v-log-file-name ) )
      804     view-as alert-box information.
      805   return .
