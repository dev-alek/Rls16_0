        1   block-level on error undo, throw.
        2   do
        3   on error undo, return error return-value :
        4     find first src.sys-ctrl.
        5     find first src.db
        6       where src.db.db-num = src.sys-ctrl.db-num
        7       .
        8     return string("db: " + string(src.db.db-num) + " db-name: " + src.db.db-name + " db-key: " + src.db.db-key ).
        9   end.
