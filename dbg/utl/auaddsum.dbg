        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: auaddsum.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/auaddsum.p $":U .
        7   define variable vss-description as character no-undo init "Утилита по расчету дополнительных сумм по документу".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define new global shared variable g#trdcalib as handle no-undo.
       68   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208     end.
      209   end procedure.
      210      procedure waitfram-show-this:
      211         define input  parameter iInterval as int64 no-undo.
      212         define variable vtime as int64 no-undo.
      213         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      214         mWaitFramInterval = iInterval.
      215         run waitfram-show (substitute("&1&2 &3&4" ,
      216                                       mWaitFramTextBeg ,
      217                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      218                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      219                                       mWaitFramTextEnd
      220                                      )
      221                           ).
      222      end.
      223      procedure WaitFramRunPause:
      224         define input  parameter iInterval as dec no-undo.
      225         define variable vStart  as datetime-tz no-undo.
      226         define variable vend    as datetime-tz no-undo.
      227         define variable vint as int64 no-undo.
      228         define variable vOk as logical no-undo.
      229         vStart = now.
      230         vend   = vStart.
      231         publish "WaitFramPause" (iInterval,output vOk).
      232         vend   =  now.
      233         vint = vend - vStart.
      234         vint = iInterval - vint / 1000.
      235         if     not mWaitFramStop
      236            and (   vint > 0
      237                 or (    not vOk
      238                     and iInterval eq ?
      239                     )
      240                 )
      241         then
      242            run waitfram-show-this (iInterval).
      243         vend   =  now.
      244         vint = vend - vStart.
      245         vint = iInterval - vint / 1000.
      246         if     not mWaitFramStop
      247            and vint > 0
      248         then do:
      249            run gbl/pause.p (vint * 1000).
      250         end.
      251         if iInterval ne ?
      252         then
      253            publish "WaitFramStop".
      254         waitfram-check-timeout().
      255      end.
      256      procedure WaitFramWaitFor:
      257         define input  parameter iInterval as dec no-undo.
      258         assign
      259            mWaitFramStartProc   = now
      260            mWaitFramStopUser    = no
      261            mWaitFramStopTimeOut = no
      262         .
      263         block-wait:
      264         do while not mWaitFramStop:
      265            run WaitFramRunPause (iInterval).
      266            if  waitfram-check-timeout()
      267            then do:
      268               leave block-wait.
      269            end.
      270         end.
      271         run waitfram-hide.
      272      end.
      273   procedure waitfram-join :
      274     define input  parameter p-line-1  as character no-undo .
      275     define input  parameter p-line-2  as character no-undo .
      276     define input  parameter p-line-3  as character no-undo .
      277     define output parameter p-message as character no-undo .
      278     do
      279     on error undo, return error return-value
      280     :
      281       assign
      282         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      283                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      284                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      285       .
      286     end.
      287   end procedure.
      288   function waitfram-join-function returns character
      289     (input p-line-1 as character
      290     ,input p-line-2 as character
      291     ,input p-line-3 as character
      292     ).
      293     define variable v-message as character no-undo .
      294     run waitfram-join in this-procedure
      295       (input  p-line-1
      296       ,input  p-line-2
      297       ,input  p-line-3
      298       ,output v-message
      299       ) .
      300     return v-message .
      301   end function .
      302   define buffer bf_trn-doc  for ub.trn-doc.
      303   define buffer bf_clients  for ub.clients.
      304   define buffer bf_db       for ub.db.
      305   define variable varvalue       like ub.doc-attr.attr-value no-undo.
      306   define variable vartype        as character                no-undo.
      307   do on error undo, return error return-value :
      308   run waitfram-show in this-procedure ("").
      309   for each bf_db on error undo, return error return-value :
      310     for each bf_clients where bf_clients.db-num = bf_db.db-num on error undo, return error return-value :
      311       for each bf_trn-doc where bf_trn-doc.obj-type = bf_clients.obj-type and
      312                                 bf_trn-doc.obj-code = bf_clients.obj-code and
      313                                 bf_trn-doc.internal = no                  and
      314                                 bf_trn-doc.doc-type = 'инв':U        and
      315                                 bf_trn-doc.status_  = 'факт':U             on error undo, return error return-value :
      316          run waitfram-show in this-procedure (substitute ("Объект: &1 &2. Документ &3.", bf_clients.obj-type, bf_clients.obj-code, bf_trn-doc.doc-code)).
      317   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf_trn-doc.doc-code ,
      318                           input 'addsum':U ,
      319                          output varvalue ,
      320                          output vartype ) no-error .
      321          if error-status:error then do:
      322            message "Ошибка при считывании атрибутов документа " bf_trn-doc.doc-code " ." skip
      323                    "Прерываем расчет сумм." skip
      324                    return-value skip
      325                    error-status:get-message(1)
      326            view-as alert-box.
      327            return error.
      328          end.
      329          if lookup ('bd':U,  varvalue) = 0 or
      330             lookup ('gen':U, varvalue) = 0 or
      331             lookup ('ad':U,   varvalue) = 0 then do:
      332             run utl/uaddsum.p (input bf_trn-doc.doc-code, no, ?, ?) no-error.
      333             if error-status:error then do:
      334               message "Ошибка при расчете сумм документа " bf_trn-doc.doc-code " ." skip
      335                       "Прерываем расчет сумм." skip
      336                       return-value skip
      337                       error-status:get-message(1)
      338               view-as alert-box.
      339               return error.
      340             end.
      341          end.
      342       end.
      343     end.
      344   end.
      345   run waitfram-hide in this-procedure.
      346   end.
