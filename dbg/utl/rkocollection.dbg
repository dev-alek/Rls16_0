     2557              "Ошибка при поиске текущей смены" skip
     2558               "Объект"  v-cntxt-obj-type v-cntxt-obj-code skip
     2559   view-as alert-box error .
     2560   undo, return return-value .
     2561   end.
     2562   if not this-procedure:persistent then do:
     2563     run proc-main in this-procedure no-error .
     2564     if error-status:error then do:
     2565       v-esm = error-status :get-message (1).
     2566       v-es = error-status:error .
     2567       v-rv = return-value .
     2568     end.
     2569     if v-es then do:
     2570         run garbcoll_clear in this-procedure .
     2571         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     2572     end.
     2573     run garbcoll_clear in this-procedure .
     2574   end.
     2575   DEFINE TEMP-TABLE tt-fin-doc NO-UNDO LIKE ub.fin-doc.
