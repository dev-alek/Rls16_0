     3100           undo _main, return error substitute("Ошибки при заполнении фин.док-та значениями по умолчанию:&1&2&1&3"                                    , chr(10)                                    , error-status:get-message(1)                                      , return-value ).
     3101         end.
     3102         find first tt-fin-doc.
     3103         define variable v-line-num as integer no-undo .
     3104         for each buf_temp-tax no-lock
