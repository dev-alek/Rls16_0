     2614   field tot-rubl as decimal
     2615   field tot-base as decimal
     2616   field tot-doc as decimal
     2617   field vat-base as decimal
     2618   field vat-rubl as decimal
     2619   field vat-doc as decimal
     2620   field curr-code as integer
     2621   field cash-desk  as integer
     2622   field is-petrol as logical
     2623   index pi is unique primary
     2624   cash-desk
     2625   b-code
     2626   doc-kind
     2627   curr-code
     2628   .
     2629   define temp-table temp-tax no-undo
