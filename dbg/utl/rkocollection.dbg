     2646   num-expense_cash
     2647   is-expense_cash
     2648   cash-desk
     2649   curr-code
     2650   vat-pc
     2651   slt-pc
     2652   is-petrol
     2653   cashbookId
     2654   .
     2655   define temp-table temp-z-number no-undo
