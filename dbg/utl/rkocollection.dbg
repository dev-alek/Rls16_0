     3038      v-naznach-plat = substitute("Z-отчет(ы) &1 от &2г.", v-naznach-plat, if v-uchet = "smen" then string(buf_shift-obj.shift-date, "99/99/99") else string(TODAY, "99/99/99")).
     3039      for each temp-z-number-list:
     3040        assign
     3041        temp-z-number-list.naznach-plat = substitute("Z-отчет(ы) &1 от &2г.", temp-z-number-list.naznach-plat, if v-uchet = "smen" then string(buf_shift-obj.shift-date, "99/99/99") else string(TODAY, "99/99/99")).
     3042      end.
     3043      v-naznach-plat2 = v-naznach-plat .
     3044      _temp-fin-sum:
     3045      for each buf_temp-fin-sum no-lock
     3046       by buf_temp-fin-sum.cashbookid desc
