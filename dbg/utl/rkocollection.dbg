        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: 12c0f79a3864, 3013, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        7   define variable vss-date        as character no-undo init "$Date: Ср апр 06 16:23:44 2022 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: rkocollection.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/rkocollection.p $":U .
       10   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 24, набор 1".
       11   define variable vi as integer no-undo.
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82     define variable v-cntxt-db-num        as integer   no-undo .
       83     define variable v-cntxt-userid        as character no-undo .
       84     define variable v-cntxt-level         as character no-undo .
       85     define variable v-cntxt-host-code-obj as integer   no-undo .
       86     define variable v-cntxt-obj-type      as character no-undo .
       87     define variable v-cntxt-obj-code      as integer   no-undo .
       88     define variable v-cntxt-db-num-obj    as integer   no-undo .
       89     define variable v-cntxt-is-admin      as logical   no-undo .
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91     run mainmenu_getcntxt in parparentproc
       92       (output v-cntxt-db-num
       93       ,output v-cntxt-userid
       94       ,output v-cntxt-level
       95       ,output v-cntxt-host-code-obj
       96       ,output v-cntxt-obj-type
       97       ,output v-cntxt-obj-code
       98       ,output v-cntxt-db-num-obj
       99       ,output v-cntxt-is-admin
      100       ) .
      101   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   define  variable garbcoll_ii as integer no-undo .
      103   define  temp-table temp-gc no-undo
      104   field ii as integer
      105   field obj-r as handle
      106   field cn as character
      107   index pi is unique primary
      108   ii
      109   index icn
      110   cn.
      111   procedure garbcoll_create-gc-entry :
      112   define input parameter p-cn as character no-undo .
      113   define input parameter p-obj-r as handle no-undo .
      114     do
      115     on error undo, return error
      116     :
      117       create temp-gc.
      118       assign
      119       temp-gc.ii = garbcoll_ii
      120       garbcoll_ii = garbcoll_ii + 1
      121       temp-gc.cn = p-cn
      122       temp-gc.obj-r = p-obj-r
      123       .
      124     end.
      125   end procedure.
      126   procedure garbcoll_clear :
      127     do
      128     on error undo, return error
      129     :
      130       for each temp-gc:
      131         delete object temp-gc.obj-r.
      132         delete temp-gc.
      133       end.
      134     end.
      135   end procedure.
      136   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   procedure cur-time :
      138      define output parameter p-today as date      no-undo .
      139      define output parameter p-time  as integer   no-undo .
      140     do
      141     on error undo, return error
      142     :
      143       define variable v-date1 as date      no-undo .
      144       define variable v-date2 as date      no-undo .
      145       define variable v-time  as integer   no-undo .
      146       assign
      147         v-date1 = today
      148         v-time  = time
      149         v-date2 = today
      150       .
      151       if v-date1 <> v-date2
      152       then do:
      153         assign
      154           v-date1 = today
      155           v-time  = v-time
      156         .
      157       end.
      158       assign
      159         p-today = v-date1
      160         p-time  = v-time
      161       .
      162     end.
      163   end.
      164   function cur-time-date returns character
      165   :
      166     return string(today, '99/99/9999':U) .
      167   end.
      168   function cur-time-mjd returns decimal
      169   :
      170     define variable v-date as date      no-undo .
      171     define variable v-time as integer   no-undo .
      172     run cur-time in this-procedure
      173       (output v-date
      174       ,output v-time
      175       ) .
      176     return integer(v-date) - 2400002 + (v-time / 86400) .
      177   end.
      178   function cur-time-get-ending-index returns integer
      179   (input p-number as integer
      180   )
      181   :
      182     if p-number < 0
      183     or p-number = ?
      184     then do:
      185       return 1 .
      186     end.
      187     define variable v-rest as integer   no-undo .
      188     assign
      189       p-number = p-number modulo 100
      190     .
      191     if p-number < 20
      192     then do:
      193       assign
      194         v-rest = p-number
      195       .
      196     end.
      197     else do:
      198       assign
      199         v-rest = p-number modulo 10
      200       .
      201     end.
      202     case v-rest :
      203       when 1
      204       then do:
      205         return 2 .
      206       end.
      207       when 2 or
      208       when 3 or
      209       when 4
      210       then do:
      211         return 3 .
      212       end.
      213       otherwise do:
      214         return 1 .
      215       end.
      216     end case .
      217   end.
      218   procedure cur-time-mjd-to-date :
      219      define input  parameter i-mjd-diff as decimal no-undo.
      220      define output parameter o-Date     as date    no-undo.
      221      define output parameter o-Time     as integer no-undo.
      222      define variable v-day-number as integer   no-undo .
      223      if    i-mjd-diff < 0
      224         or i-mjd-diff = ?
      225      then do:
      226         return "?" .
      227      end.
      228      assign
      229         v-day-number = truncate(i-mjd-diff,0).
      230         o-Date = date(v-day-number + 2400002).
      231         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      232     .
      233   end.
      234   function cur-time-mjd-to-string returns character
      235   (input p-mjd-diff as decimal
      236   )
      237   :
      238     define variable v-day-number as integer   no-undo .
      239     define variable v-seconds    as integer   no-undo .
      240     define variable v-hour       as integer   no-undo .
      241     define variable v-min        as integer   no-undo .
      242     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      243     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      244     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      245     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      246     if p-mjd-diff < 0
      247     or p-mjd-diff = ?
      248     then do:
      249       return "?" .
      250     end.
      251     assign
      252       v-day-number = integer(truncate(p-mjd-diff,0))
      253       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      254     .
      255     if v-seconds > 86400
      256     then do:
      257       assign
      258         v-seconds = 86400 - 1
      259       .
      260     end.
      261     if v-seconds < 0
      262     then do:
      263       assign
      264         v-seconds = 0
      265       .
      266     end.
      267     assign
      268       v-hour = truncate(v-seconds / 3600, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 3600
      272     .
      273     assign
      274       v-min = truncate(v-seconds / 60, 0)
      275     .
      276     assign
      277       v-seconds = v-seconds modulo 60
      278     .
      279     return
      280         (if v-day-number <> 0
      281           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0
      285           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      286           else ""
      287         )
      288       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      289           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      290           else ""
      291         )
      292       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      293       .
      294   end.
      295   function cur-time-string returns character
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      304   end.
      305   function cur-time-string-sec returns character
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      314   end.
      315   function cur-time-custom  returns character
      316   (input p-prefix as character
      317   ,input p-date-format as character
      318   ,input p-delimiter as character
      319   ,input p-time-format as character
      320   ,input p-suffix as character
      321   )
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return
      330       p-prefix
      331       + string(v-date, p-date-format)
      332       + p-delimiter
      333       + string(v-time, p-time-format)
      334       + p-suffix
      335       .
      336   end.
      337   function cur-time-print  returns character
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      346   end.
      347   function cur-time-datetime returns datetime
      348   :
      349     define variable v-char as character no-undo .
      350     define variable v-datetime as datetime no-undo .
      351     v-char = cur-time-string().
      352     v-datetime = datetime(v-char).
      353     return  v-datetime.
      354   end.
      355   function cur-time-string-msec returns character
      356   :
      357     define variable v-date as datetime  no-undo .
      358     v-date = now.
      359     return string(v-date) .
      360   end.
      361   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   procedure gen-key-rec :
      363     define input  parameter p-tbl-name    as character no-undo.
      364     define input  parameter p-bh_tbl-name as handle    no-undo.
      365     define output parameter p-key-rec     as character no-undo.
      366     do
      367     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      368     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      369     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      370     :
      371       define variable fh               as handle    no-undo .
      372       define variable v-ok             as logical   no-undo .
      373       define variable v-inform         as character no-undo .
      374       define variable v-ind            as integer   no-undo .
      375       define variable v-idx-field-qnty as integer   no-undo .
      376       if p-tbl-name = ?
      377         or p-tbl-name = "":U
      378       then do:
      379         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      380       end.
      381       if not p-bh_tbl-name:available then do:
      382         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      383       end.
      384       assign
      385         p-key-rec = p-tbl-name
      386         v-inform  = p-bh_tbl-name:index-information(1)
      387         v-ind     = 2
      388       .
      389       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      390       on error undo, return error
      391       :
      392         assign
      393           v-inform = p-bh_tbl-name:index-information( v-ind )
      394           v-ind    = v-ind + 1
      395         .
      396       end.
      397       if v-inform = ?
      398         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      399         or entry( 3, v-inform, ",":U ) <> "1":U
      400       then do:
      401         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      402       end.
      403       else do:
      404         assign
      405           v-idx-field-qnty = num-entries( v-inform ) - 4
      406         .
      407         if v-idx-field-qnty < 2 then do:
      408           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      409         end.
      410         do v-ind = 1 to v-idx-field-qnty by 2
      411         on error undo, return error
      412         :
      413           assign
      414             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      415             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      416           .
      417         end.
      418       end.
      419       if p-key-rec = ? then do:
      420         assign
      421           p-key-rec = "":U
      422         .
      423         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      424       end.
      425     end.
      426     return.
      427   end procedure.
      428   procedure gen-where-keyr-tab :
      429     define input  parameter i-tableSerach as character no-undo.
      430     define input  parameter i-tablekey   as character  no-undo.
      431     define input  parameter p-key-rec    as character  no-undo.
      432     define input  parameter p-key-handle as handle     no-undo .
      433     define input  parameter p-db-name    as character  no-undo .
      434     define input  parameter p-tt-handle  as handle     no-undo .
      435     define output parameter o-Where      as character  no-undo.
      436     do
      437     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      438     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      439     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      440     :
      441       define variable v-full-tbl-name  as character no-undo .
      442       define variable bh_tbl-name      as handle    no-undo .
      443       define variable fh_key           as handle    no-undo .
      444       define variable fh_search        as handle    no-undo .
      445       define variable v-field-num      as integer   no-undo .
      446       define variable v-count-fld      as integer   no-undo .
      447       define variable v-inform         as character no-undo .
      448       define variable v-ind            as integer   no-undo .
      449       define variable v-idx-field-qnty as integer   no-undo .
      450       define variable v-field-name     as character no-undo .
      451       define variable v-field-val      as character no-undo .
      452       define variable v-word-link      as character no-undo .
      453       define variable vTable           as character no-undo.
      454       define variable bh_tbl-key       as handle    no-undo .
      455       assign
      456         p-key-rec = trim( p-key-rec )
      457       .
      458       if p-key-handle <> ? then do:
      459         if not valid-handle(p-key-handle)
      460            or p-key-handle:type <> "buffer"
      461         then do:
      462           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      463         end.
      464         if num-entries( p-key-rec, chr(3) ) > 1
      465           or p-key-rec = ?
      466           or p-key-rec = "":U
      467         then do:
      468           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      469         end.
      470       end.
      471       else do:
      472         if p-key-rec = ?
      473           or p-key-rec = "":U
      474         then do:
      475           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      476         end.
      477       end.
      478       assign
      479         vTable = entry( 1 , p-key-rec, chr(3) )
      480       .
      481       if p-tt-handle <> ?
      482         and ( not valid-handle(p-tt-handle)
      483               or p-tt-handle:type <> "buffer"
      484             )
      485       then do:
      486         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      487       end.
      488       if p-tt-handle = ? then do:
      489         assign
      490           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      491         .
      492         create buffer bh_tbl-name for table v-full-tbl-name .
      493       end.
      494       else do:
      495         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      496       end.
      497       assign
      498         v-inform = bh_tbl-name:index-information(1)
      499         v-ind    = 2
      500       .
      501       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      502       on error undo, return error
      503       :
      504         assign
      505           v-inform = bh_tbl-name:index-information( v-ind )
      506           v-ind    = v-ind + 1
      507         .
      508       end.
      509       if v-inform = ?
      510         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      511         or entry( 3, v-inform, ",":U ) <> "1":U
      512       then do:
      513         delete object bh_tbl-name no-error.
      514         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      515       end.
      516       assign
      517         v-idx-field-qnty = num-entries( v-inform ) - 4
      518       .
      519       if v-idx-field-qnty < 2 then do:
      520         delete object bh_tbl-name no-error.
      521         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      522       end.
      523       assign
      524         o-where     = "where":U
      525         v-word-link = "":U
      526         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      527         v-count-fld = 0
      528       .
      529       if i-tablekey ne "" and i-tablekey ne ?
      530       then do:
      531         assign
      532           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      533         .
      534         create buffer bh_tbl-key for table v-full-tbl-name .
      535       end.
      536       if i-tableSerach ne "" and i-tableSerach ne ?
      537       then do:
      538         delete object bh_tbl-name no-error.
      539         assign
      540           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      541         .
      542         create buffer bh_tbl-name for table v-full-tbl-name .
      543       end.
      544       block_where:
      545       do v-ind = 1 to v-idx-field-qnty by 2
      546       on error undo, return error
      547       :
      548         assign
      549           v-count-fld = v-count-fld + 1
      550         .
      551         if p-key-handle = ?
      552           and v-count-fld > v-field-num
      553         then do:
      554           leave block_where.
      555         end.
      556         define variable VfieldKeyTable as handle no-undo.
      557         assign
      558           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      559           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      560         .
      561         if     bh_tbl-key ne ?
      562         then do:
      563            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      564            if VfieldKeyTable eq ?
      565            then next block_where.
      566         end.
      567         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      568         then
      569            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      570         else
      571            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      572         if p-key-handle = ? then do:
      573           assign
      574             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      575           .
      576         end.
      577         else do:
      578           assign
      579             fh_key = p-key-handle:buffer-field( v-field-name )
      580           .
      581           if fh_key = ?
      582             or not valid-handle( fh_key )
      583           then do:
      584             delete object bh_tbl-name.
      585             if     bh_tbl-key ne ?
      586             then
      587                delete object bh_tbl-key.
      588             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      589           end.
      590           assign
      591             v-field-val = fh_key:buffer-value
      592           .
      593         end.
      594         if fh_search:data-type ="character":U then do:
      595           assign
      596             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      597             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      598             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      599             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      600             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      601             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      602             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      603             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      604             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      605             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      606             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      607             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      608             v-field-val = substitute( '"&1"', v-field-val )
      609           .
      610         end.
      611         assign
      612           o-where = substitute( "&1 &2", o-where, v-field-val )
      613         .
      614         if v-word-link = "":U then do:
      615           assign
      616             v-word-link = "and":U
      617           .
      618         end.
      619       end.
      620       delete object bh_tbl-name.
      621       if     bh_tbl-key ne ?
      622       then
      623          delete object bh_tbl-key.
      624       if p-key-handle = ?
      625         and v-count-fld <> v-field-num
      626       then do:
      627         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      628       end.
      629     end.
      630   end procedure.
      631   procedure gen-hn-keyr-tab :
      632     define input  parameter i-tableSerach as character no-undo.
      633     define input  parameter i-tablekey   as character no-undo.
      634     define input  parameter p-key-rec    as character no-undo.
      635     define input  parameter p-key-handle as handle    no-undo .
      636     define input  parameter p-db-name    as character no-undo .
      637     define input  parameter p-tt-handle  as handle    no-undo .
      638     define input  parameter p-stts-lock  as integer   no-undo .
      639     define output parameter o-hn         as handle    no-undo.
      640     define variable v-full-tbl-name as character no-undo.
      641     define variable v-where         as character no-undo.
      642     define variable bh_tbl-name     as handle    no-undo.
      643     define variable vTable          as character no-undo.
      644     do
      645     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      646     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      647     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      648         run gen-where-keyr-tab(i-tableSerach,
      649                                i-tablekey,
      650                                p-key-rec,
      651                                p-key-handle,
      652                                p-db-name,
      653                                p-tt-handle,
      654                                output v-where).
      655         if i-tableSerach ne "" and i-tableSerach ne ?
      656         then do:
      657            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      658            create buffer bh_tbl-name for table v-full-tbl-name .
      659         end.
      660         else do:
      661            if p-tt-handle = ? then do:
      662               assign
      663                  vTable = entry( 1 , p-key-rec, chr(3) )
      664               .
      665               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      666               create buffer bh_tbl-name for table v-full-tbl-name .
      667            end.
      668            else do:
      669               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      670            end.
      671         end.
      672         if p-tt-handle = ? then do:
      673            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      674         end.
      675         else do:
      676            bh_tbl-name:find-first( v-where ) no-error .
      677         end.
      678         o-hn = bh_tbl-name.
      679      end.
      680   end procedure.
      681   procedure gen-hn-keyr :
      682     define input  parameter p-key-rec    as character no-undo.
      683     define input  parameter p-key-handle as handle    no-undo .
      684     define input  parameter p-db-name    as character no-undo .
      685     define input  parameter p-tt-handle  as handle    no-undo .
      686     define input  parameter p-stts-lock  as integer   no-undo .
      687     define output parameter o-hn         as handle    no-undo.
      688     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      689   end.
      690   procedure gen-row-keyr :
      691     define input  parameter p-key-rec    as character no-undo.
      692     define input  parameter p-key-handle as handle    no-undo .
      693     define input  parameter p-db-name    as character no-undo .
      694     define input  parameter p-tt-handle  as handle    no-undo .
      695     define input  parameter p-stts-lock  as integer   no-undo .
      696     define output parameter p-tbl-row    as rowid     no-undo.
      697     define output parameter p-tbl-name   as character no-undo.
      698     define variable vHn as handle no-undo.
      699       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      700       p-tbl-row = if vHn:available then vHn:rowid else ?.
      701       p-tbl-name =  vHn:table.
      702       delete object vHn no-error.
      703     if p-tbl-row = ? then do:
      704       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      705     end.
      706     else do:
      707       return.
      708     end.
      709   end procedure.
      710   procedure gen-key-fv :
      711     define input  parameter p-key-rec    as character no-undo .
      712     define output parameter p-field-list as character no-undo .
      713     define output parameter p-value-list as character no-undo.
      714     do
      715     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      716     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      717     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      718     :
      719       define variable v-full-tbl-name  as character no-undo .
      720       define variable bh_tbl-name      as handle    no-undo .
      721       define variable v-tbl-name       as character no-undo .
      722       define variable v-field-num      as integer   no-undo .
      723       define variable v-count-fld      as integer   no-undo .
      724       define variable v-inform         as character no-undo .
      725       define variable v-ind            as integer   no-undo .
      726       define variable v-idx-field-qnty as integer   no-undo .
      727       define variable v-delim-key      as character no-undo .
      728       if p-key-rec = ?
      729         or p-key-rec = "":U
      730       then do:
      731         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      732       end.
      733       assign
      734         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      735         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      736       .
      737       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      738       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      739       assign
      740         v-inform = bh_tbl-name:index-information(1)
      741         v-ind    = 2
      742       .
      743       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      744       on error undo, return error
      745       :
      746         assign
      747           v-inform = bh_tbl-name:index-information( v-ind )
      748           v-ind    = v-ind + 1
      749         .
      750       end.
      751       if v-inform = ?
      752         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      753         or entry( 3, v-inform, ",":U ) <> "1":U
      754       then do:
      755         delete object bh_tbl-name no-error.
      756         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      757       end.
      758       assign
      759         v-idx-field-qnty = num-entries( v-inform ) - 4
      760       .
      761       if v-idx-field-qnty < 2 then do:
      762         delete object bh_tbl-name no-error.
      763         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      764       end.
      765       assign
      766         p-field-list = "":U
      767         p-value-list = "":U
      768         v-delim-key  = "":U
      769         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      770         v-count-fld  = 0
      771       .
      772       block_where:
      773       do v-ind = 1 to v-idx-field-qnty by 2
      774       on error undo, return error
      775       :
      776         assign
      777           v-count-fld = v-count-fld + 1
      778         .
      779         if v-count-fld > v-field-num then do:
      780           leave block_where.
      781         end.
      782         assign
      783           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      784           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      785         .
      786         if v-ind = 1 then do:
      787           assign
      788             v-delim-key = chr(3)
      789           .
      790         end.
      791       end.
      792       delete object bh_tbl-name.
      793       if v-count-fld <> v-field-num then do:
      794         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      795       end.
      796     end.
      797   end procedure.
      798   procedure gen-key-field :
      799     define input  parameter p-table      as character no-undo .
      800     define output parameter p-field-list as character no-undo .
      801     do
      802     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      803     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      804     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      805     :
      806       define variable v-full-tbl-name  as character no-undo .
      807       define variable bh_tbl-name      as handle    no-undo .
      808       define variable v-tbl-name       as character no-undo .
      809       define variable v-field-num      as integer   no-undo .
      810       define variable v-count-fld      as integer   no-undo .
      811       define variable v-inform         as character no-undo .
      812       define variable v-ind            as integer   no-undo .
      813       define variable v-idx-field-qnty as integer   no-undo .
      814       define variable v-delim-key      as character no-undo .
      815       if p-table = ?
      816         or p-table = "":U
      817       then do:
      818         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      819       end.
      820       assign
      821         v-tbl-name      = p-table
      822         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      823       .
      824       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      825       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      826       assign
      827         v-inform = bh_tbl-name:index-information(1)
      828         v-ind    = 2
      829       .
      830       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      831       on error undo, return error
      832       :
      833         assign
      834           v-inform = bh_tbl-name:index-information( v-ind )
      835           v-ind    = v-ind + 1
      836         .
      837       end.
      838       if v-inform = ?
      839         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      840         or entry( 3, v-inform, ",":U ) <> "1":U
      841       then do:
      842         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      843       end.
      844       assign
      845         v-idx-field-qnty = num-entries( v-inform ) - 4
      846       .
      847       if v-idx-field-qnty < 2 then do:
      848         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      849       end.
      850       assign
      851         p-field-list = "":U
      852         v-delim-key  = "":U
      853         v-count-fld  = 0
      854       .
      855       block_where:
      856       do v-ind = 1 to v-idx-field-qnty by 2
      857       on error undo, return error
      858       :
      859         assign
      860           v-count-fld = v-count-fld + 1
      861         .
      862         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      863         if v-ind = 1 then do:
      864           assign
      865             v-delim-key = chr(3)
      866           .
      867         end.
      868       end.
      869       delete object bh_tbl-name.
      870     end.
      871   end procedure.
      872   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   def
      874   new shared
      875   temp-table  obj-list no-undo
      876     field obj-type like ub.clients.obj-type
      877     field obj-code like ub.clients.obj-code
      878     field obj-name like ub.clients.obj-name
      879     field obj-id   as integer
      880     field db-num   as integer
      881     index pi is primary unique obj-id
      882     index ie1 obj-type obj-code
      883     index ie2 obj-name
      884   .
      885   procedure create_obj-list :
      886      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      887      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      888      do
      889      on error undo, return error return-value
      890      :
      891         define buffer cli-obj for ub.clients .
      892         define variable p-var as integer no-undo .
      893         define buffer buf_obj-list for obj-list .
      894         find last buf_obj-list  use-index pi no-error .
      895         if available buf_obj-list
      896         then
      897            p-var = buf_obj-list.obj-id + 1.
      898         else
      899            p-var = 1.
      900         find first cli-obj where
      901                   cli-obj.obj-type = p-obj-type
      902               and cli-obj.obj-code = p-obj-code
      903         no-lock no-error.
      904         if available cli-obj
      905         then do:
      906            create buf_obj-list.
      907            assign
      908               buf_obj-list.obj-id   = p-var
      909               buf_obj-list.obj-code = cli-obj.obj-code
      910               buf_obj-list.obj-type = cli-obj.obj-type
      911               buf_obj-list.obj-name = cli-obj.obj-name
      912               buf_obj-list.db-num   = cli-obj.db-num
      913            .
      914         end.
      915      end.
      916   end.
      917   run create_obj-list(v-cntxt-obj-type, v-cntxt-obj-code).
      918   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   procedure factord :
      921     define input  parameter p-fact-date            as date    no-undo .
      922     define input  parameter p-fact-time            as integer no-undo .
      923     define input  parameter p-fact-num             as integer no-undo .
      924     define input  parameter p-shift-date           as date    no-undo .
      925     define input  parameter p-shift-num            as integer no-undo .
      926     define input  parameter p-shift-on             as logical no-undo .
      927     define output parameter p-fact-order           as decimal no-undo .
      928     define output parameter p-shift-end-fact-order as decimal no-undo .
      929     define output parameter p-day-end-fact-order   as decimal no-undo .
      930     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      931     if p-fact-date = ?
      932     then do:
      933       return error "Не указана фактическая дата" .
      934     end.
      935     define variable v-fact-date-num as integer no-undo .
      936     assign
      937       v-fact-date-num = integer(p-fact-date)
      938     .
      939     if p-fact-num = ?
      940     or p-fact-num = 0
      941     then do:
      942       return error "Не задан p-fact-num " + string(p-fact-num) .
      943     end.
      944     if p-fact-num < 0
      945     then do:
      946       return error "Отрицательный fact-num " + string(p-fact-num) .
      947     end.
      948     if p-fact-num >= 100000000
      949     then do:
      950       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      951     end.
      952     if p-shift-on = true
      953     then do:
      954       if p-shift-date = ?
      955       then do:
      956         return error "Не задана дата смены" .
      957       end.
      958       if p-shift-num = ?
      959       or p-shift-num = 0
      960       then do:
      961         return error "Не задан номер смены" .
      962       end.
      963     end.
      964     else do:
      965       assign
      966         p-shift-date = p-fact-date
      967         p-shift-num  = 24
      968       .
      969     end.
      970     define variable v-shift-offset as integer no-undo .
      971     if p-shift-date = p-fact-date
      972     then do:
      973       assign
      974         v-shift-offset = 1
      975       .
      976     end.
      977     if p-shift-date < p-fact-date
      978     then do:
      979       assign
      980         v-shift-offset = 0
      981       .
      982     end.
      983     if p-shift-date > p-fact-date
      984     then do:
      985       message
      986         vss-workfile vss-revision vss-description skip
      987         "Неправильная дата закрытия смены" skip
      988         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      989         view-as alert-box error .
      990       undo, return error
      991         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      992           ,string(p-fact-date, '99/99/9999':U)
      993           ,string(p-shift-date, '99/99/9999':U)
      994           )
      995       .
      996     end.
      997     if p-shift-num < 1
      998     or p-shift-num > 24
      999     then do:
     1000       message
     1001         vss-workfile vss-revision vss-description skip
     1002         "Неправильный номер смены" skip
     1003         "p-shift-num" p-shift-num skip
     1004         view-as alert-box error .
     1005       undo, return error return-value .
     1006     end.
     1007     assign
     1008       p-fact-order           = v-fact-date-num
     1009                              + v-shift-offset * 0.5
     1010                              + p-shift-num    * 0.02 - 0.01
     1011                              + p-fact-num     * 0.0000000001
     1012       p-shift-end-fact-order = v-fact-date-num
     1013                              + v-shift-offset * 0.5
     1014                              + p-shift-num    * 0.02
     1015       p-day-end-fact-order   = v-fact-date-num
     1016                              + 0.99
     1017     .
     1018     if p-fact-order           <= v-fact-date-num
     1019     or p-shift-end-fact-order <= v-fact-date-num
     1020     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1021     or p-shift-end-fact-order >= p-day-end-fact-order
     1022     then do:
     1023       message
     1024         vss-workfile vss-revision vss-description skip
     1025         "Внутренняя ошибка при генерации фактического номера" skip
     1026         "p-fact-date"            p-fact-date            skip
     1027         "p-fact-time"            p-fact-time            skip
     1028         "p-fact-num"             p-fact-num             skip
     1029         "p-shift-date"           p-shift-date           skip
     1030         "p-shift-num"            p-shift-num            skip
     1031         "p-shift-on"             p-shift-on             skip
     1032         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1033         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1034         "v-fact-date-num"        v-fact-date-num        skip
     1035         view-as alert-box error .
     1036       undo, return error return-value .
     1037     end.
     1038   end procedure.
     1039   procedure day-begin-fact-order :
     1040     define input  parameter p-fact-date            as date    no-undo .
     1041     define output parameter p-day-begin-fact-order as decimal no-undo .
     1042     do
     1043     on error undo, return error return-value
     1044     :
     1045       if p-fact-date = ?
     1046       then do:
     1047         assign
     1048           p-day-begin-fact-order = 0
     1049         .
     1050       end.
     1051       else do:
     1052         assign
     1053           p-day-begin-fact-order = integer(p-fact-date)
     1054         .
     1055       end.
     1056     end.
     1057   end procedure.
     1058   procedure factord-max-fact-order :
     1059     define output parameter p-max-fact-order as decimal   no-undo .
     1060     do
     1061     on error undo, return error return-value
     1062     :
     1063       run day-begin-fact-order in this-procedure
     1064         (input  date(1, 1, 5000)
     1065         ,output p-max-fact-order
     1066         ) .
     1067     end.
     1068   end procedure.
     1069   procedure factord-cut-archive :
     1070     define input  parameter p-obj-type             as character no-undo .
     1071     define input  parameter p-obj-code             as integer   no-undo .
     1072     define input  parameter p-fact-date            as date      no-undo .
     1073     define output parameter p-shift-on             as logical   no-undo .
     1074     define output parameter p-shift-date           as date      no-undo .
     1075     define output parameter p-shift-num            as integer   no-undo .
     1076     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1077     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1078     define variable v-fact-order as decimal   no-undo .
     1079     define buffer buf_shift-obj for ub.shift-obj .
     1080     do
     1081     on error undo, return error return-value
     1082     :
     1083   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1084   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1085     (input  p-obj-type
     1086     ,input  p-obj-code
     1087     ,input  'shift-on=request'
     1088     ,output p-shift-on
     1089     ) no-error .
     1090       if error-status :error
     1091       then do:
     1092         message
     1093           vss-workfile vss-revision vss-description skip
     1094           "Ошибка при определении атрибута объекта" skip
     1095           "Объект" p-obj-type p-obj-code skip
     1096           error-status :get-message(1) skip
     1097           return-value skip
     1098           view-as alert-box error .
     1099         undo, return error return-value .
     1100       end.
     1101       if p-shift-on = false
     1102       then do:
     1103         assign
     1104           p-shift-date               = ?
     1105           p-shift-num                = 0
     1106         .
     1107       end.
     1108       else do:
     1109         find first buf_shift-obj share-lock
     1110           where buf_shift-obj.obj-type   = p-obj-type
     1111             and buf_shift-obj.obj-code   = p-obj-code
     1112             and buf_shift-obj.shift-date > p-fact-date
     1113           use-index pi
     1114           no-error .
     1115         if not available buf_shift-obj
     1116         or buf_shift-obj.status_ <> 'зкр':U
     1117         then do:
     1118           message
     1119             vss-workfile vss-revision vss-description skip
     1120             "Невозможно вычислить последнюю смену" skip
     1121             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1122             "Объект" p-obj-type p-obj-code skip
     1123             "Дата" p-fact-date skip
     1124             view-as alert-box error .
     1125           undo, return error return-value .
     1126         end.
     1127         find last buf_shift-obj share-lock
     1128           where buf_shift-obj.obj-type = p-obj-type
     1129             and buf_shift-obj.obj-code = p-obj-code
     1130             and buf_shift-obj.shift-date <= p-fact-date
     1131           use-index pi
     1132           no-error .
     1133         if available buf_shift-obj
     1134         then do:
     1135           if  buf_shift-obj.status_ = 'зкр':U
     1136           then do:
     1137             assign
     1138               p-shift-date = buf_shift-obj.shift-date
     1139               p-shift-num  = buf_shift-obj.shift-num
     1140             .
     1141           end.
     1142           else do:
     1143             message
     1144               vss-workfile vss-revision vss-description skip
     1145               "Невозможно вычислить последнюю смену" skip
     1146               "Статус смены отличен от статуса" 'зкр':U skip
     1147               "Объект" p-obj-type p-obj-code skip
     1148               "Дата" p-fact-date skip
     1149               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1150               view-as alert-box error .
     1151             undo, return error return-value .
     1152           end.
     1153         end.
     1154         else do:
     1155           assign
     1156             p-shift-date = p-fact-date - 1
     1157             p-shift-num  = 1
     1158           .
     1159         end.
     1160       end.
     1161       run factord in this-procedure
     1162         (input  p-fact-date
     1163         ,input  1
     1164         ,input  1
     1165         ,input  p-shift-date
     1166         ,input  p-shift-num
     1167         ,input  p-shift-on
     1168         ,output v-fact-order
     1169         ,output p-shift-end-fact-order
     1170         ,output p-day-end-fact-order
     1171         ) no-error .
     1172       if error-status :error
     1173       then do:
     1174         message
     1175           vss-workfile vss-revision vss-description skip
     1176           "Ошибка при вызове процедуры factord"
     1177           error-status :get-message(1) skip
     1178           return-value skip
     1179           view-as alert-box error .
     1180         undo, return error return-value .
     1181       end.
     1182     end.
     1183   end procedure.
     1184   procedure factord-lock-shift :
     1185     define input  parameter p-obj-type  as character no-undo .
     1186     define input  parameter p-obj-code  as integer   no-undo .
     1187     define input  parameter p-fact-date as date      no-undo .
     1188     define parameter buffer buf_shift-obj for ub.shift-obj .
     1189     define variable v-shift-on      as logical   no-undo .
     1190     define variable v-extra-message as character no-undo .
     1191     define variable v-error as character no-undo .
     1192     do
     1193     on error undo, return error return-value
     1194     :
     1195   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1197     (input  p-obj-type
     1198     ,input  p-obj-code
     1199     ,input  'shift-on=request'
     1200     ,output v-shift-on
     1201     ) no-error .
     1202       if error-status :error
     1203       then do:
     1204         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1205         undo, return error v-error .
     1206       end.
     1207       if v-shift-on = true
     1208       then do:
     1209         find first buf_shift-obj share-lock
     1210           where buf_shift-obj.obj-type   = p-obj-type
     1211             and buf_shift-obj.obj-code   = p-obj-code
     1212             and buf_shift-obj.shift-date > p-fact-date
     1213           use-index pi
     1214           no-error .
     1215         if not available buf_shift-obj
     1216         or buf_shift-obj.status_ <> 'зкр':U
     1217         then do:
     1218           find last buf_shift-obj
     1219             where buf_shift-obj.obj-type = p-obj-type
     1220               and buf_shift-obj.obj-code = p-obj-code
     1221               and buf_shift-obj.status_  = 'зкр':U
     1222             use-index stts
     1223             no-error .
     1224           if available buf_shift-obj
     1225           then do:
     1226             assign
     1227               v-extra-message =
     1228                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1229                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1230                               )
     1231             .
     1232           end.
     1233           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1234           undo, return error v-error .
     1235         end.
     1236       end.
     1237     end.
     1238   end procedure.
     1239   procedure factord-end-day :
     1240     define input  parameter p-fact-date            as date    no-undo .
     1241     define output parameter p-day-end-fact-order   as decimal no-undo .
     1242     do
     1243     on error undo, return error return-value
     1244     :
     1245       if p-fact-date = ?
     1246       then do:
     1247         return error "Не указана фактическая дата" .
     1248       end.
     1249       assign
     1250         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1251       .
     1252     end.
     1253   end procedure.
     1254   procedure factord-to-date :
     1255     define input  parameter p-fact-order as decimal no-undo .
     1256     define output parameter p-fact-date  as date    no-undo .
     1257     define variable v-ref-date  as date      no-undo .
     1258     define variable v-ref-delta as integer   no-undo .
     1259     do
     1260     on error undo, return error return-value
     1261     :
     1262       if p-fact-order = ?
     1263       or p-fact-order = 0
     1264       then do:
     1265         return error "Не указан fact-order" .
     1266       end.
     1267       assign
     1268         v-ref-date  = date(1, 1, 2000)
     1269       .
     1270       assign
     1271         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1272       .
     1273       assign
     1274         p-fact-date = v-ref-date + v-ref-delta
     1275       .
     1276     end.
     1277   end procedure.
     1278   procedure factord-to-fact-num :
     1279     define input  parameter p-fact-order as decimal no-undo .
     1280     define output parameter p-fact-num   as integer no-undo .
     1281     define variable v-fact-order-trunc as decimal no-undo .
     1282     do
     1283     on error undo, return error return-value
     1284     :
     1285       if p-fact-order = ?
     1286       or p-fact-order = 0
     1287       then do:
     1288         return error "Не указан fact-order" .
     1289       end.
     1290       assign
     1291        v-fact-order-trunc = truncate(p-fact-order, 2)
     1292       .
     1293       assign
     1294         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1295       .
     1296     end.
     1297   end procedure.
     1298   procedure factord-to-shift-num :
     1299     define input  parameter p-fact-order as decimal no-undo .
     1300     define output parameter p-shift-num   as integer no-undo .
     1301     define variable  p-shift-numd  as decimal   no-undo .
     1302     define variable v-fact-order-trunc as decimal no-undo .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       if p-fact-order = ?
     1307       or p-fact-order = 0
     1308       then do:
     1309         return error "Не указан fact-order" .
     1310       end.
     1311       assign
     1312        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1313       .
     1314       if v-fact-order-trunc < 0.5 then do:
     1315         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1316       end.
     1317       assign
     1318         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1319         .
     1320        assign
     1321         p-shift-num = truncate (p-shift-numd , 0)
     1322       .
     1323     end.
     1324   end procedure.
     1325   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1326   PROCEDURE fostatok :
     1327   define input parameter p-host-code   as integer no-undo .
     1328   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1329   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1330   define input parameter x-tog-shift   as   logical             no-undo.
     1331   define input parameter x-date-start  as date        no-undo.
     1332   define input parameter x-date-end    as date        no-undo.
     1333   define input parameter x-shift-start as integer     no-undo.
     1334   define input parameter x-shift-end   as integer     no-undo.
     1335   define input parameter xTog-obj   as logical no-undo.
     1336   define input parameter p-curr-code as integer no-undo .
     1337   define input parameter p-cashbookid as integer  no-undo .
     1338   define output parameter sum       as decimal   no-undo.
     1339   define output parameter Fact-order  as decimal  no-undo.
     1340   define variable Fact-order#   as decimal  no-undo.
     1341   define variable Fact-orderS   as character  no-undo.
     1342   define variable x-date-start-t  as date   no-undo.
     1343   define variable x-sum-type as character no-undo .
     1344       if x-tog-shift then do:
     1345         assign
     1346         x-sum-type = 'shift-obj':U.
     1347       end.
     1348       else do:
     1349         x-sum-type = 'obj':U.
     1350       end.
     1351   Assign
     1352   Fact-order   = 0
     1353   sum     = 0
     1354   x-date-start-t  = x-date-start + 1 .
     1355   IF x-date-end = date('') then DO:
     1356     Fact-order = 0 .
     1357     For each obj-list no-lock
     1358         WHERE  (NOT xTog-obj OR
     1359                 (x-store-type = obj-list.obj-type
     1360                 AND
     1361                 x-store-code = obj-list.obj-code))
     1362     :
     1363      fact-order# = 0.
     1364      IF  x-TOG-Shift = False Then DO:
     1365         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1366             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     1367             USE-INDEX fact-date  no-error .
     1368        if Available arh-fin-doc-schet-nal-obj THEN  do:
     1369          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1370        end.
     1371      End.
     1372      Else  DO :
     1373         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1374              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     1375               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     1376               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     1377               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     1378               USE-INDEX Shift-num no-error .
     1379         if Available arh-fin-doc-schet-nal-obj THEN  do:
     1380           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1381         end.
     1382       END.
     1383       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1384     End.
     1385   End.
     1386   Else DO:
     1387     For each obj-list  no-lock WHERE
     1388        (NOT xTog-obj
     1389         OR
     1390         (x-store-type = obj-list.obj-type
     1391         AND
     1392         x-store-code = obj-list.obj-code))
     1393      :
     1394      IF  x-TOG-Shift = False Then DO:
     1395         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1396               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     1397               and arh-fin-doc-schet-nal-obj.shift-num = 0
     1398               USE-INDEX fact-date no-error.
     1399        if Available arh-fin-doc-schet-nal-obj THEN  do:
     1400          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1401        end.
     1402      END.
     1403      Else DO:
     1404         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1405               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     1406               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     1407               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     1408               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     1409         if Available arh-fin-doc-schet-nal-obj THEN  do:
     1410           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1411         end.
     1412       End.
     1413       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1414     End.
     1415   End.
     1416   END PROCEDURE.
     1417   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1418   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1419       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     1420       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     1421       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     1422       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     1423       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     1424       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     1425       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     1426       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
