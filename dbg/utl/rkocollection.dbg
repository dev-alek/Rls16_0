     3296                                             ,mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "SourceCode")
     3297                                             ,msumInc-save
     3298                                             ,mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BankRecip-acct")).
     3299         buf_fin-doc.enclosure     =  "№ сумки: " + entry(1,fin-doc-attr.attr-value,";") + " " + buf_fin-doc.enclosure.
     3300         define variable Vparentrec as character no-undo.
     3301         if Vparentrec eq ""
     3302         then
     3303            run gen-key-rec in this-procedure ("fin-doc",(buffer buf_fin-doc:handle),output Vparentrec ).
     3304         find first fin-doc-attr where fin-doc-attr.host-code       eq buf_fin-doc.host-code
     3305                                      and fin-doc-attr.fin-doc-code eq buf_fin-doc.fin-doc-code
     3306                                      and fin-doc-attr.attr-code    eq "ParentMoney"
     3307                                      exclusive-lock no-error.
     3308            if not available fin-doc-attr
     3309            then do:
     3310               create fin-doc-attr.
     3311               assign
     3312                  fin-doc-attr.host-code    = buf_fin-doc.host-code
     3313                  fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code
     3314                  fin-doc-attr.attr-code    = "ParentMoney"
     3315               .
     3316            end.
     3317            fin-doc-attr.attr-value = Vparentrec.
     3318         if mMoney ne ""
     3319         then do:
     3320            find first fin-doc-attr where fin-doc-attr.host-code eq buf_fin-doc.host-code
     3321                                      and fin-doc-attr.fin-doc-code eq buf_fin-doc.fin-doc-code
     3322                                      and fin-doc-attr.attr-code eq "cover_sheet"
     3323                                      exclusive-lock no-error.
     3324            if not available fin-doc-attr
     3325            then do:
     3326               create fin-doc-attr.
     3327               assign
     3328                  fin-doc-attr.host-code    = buf_fin-doc.host-code
     3329                  fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code
     3330                  fin-doc-attr.attr-code    = "cover_sheet"
     3331               .
     3332            end.
     3333            fin-doc-attr.attr-value = mMoney.
     3334            mMoney = "".
     3335         end.
     3336         run proc-close in this-procedure ( buffer buf_fin-doc) no-error.
     3337         if error-status :error then do:
     3338                   if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки при сохранении фин.док-та:&1&2&1&3"                                    , chr(10)                                    , error-status:get-message(1)                                      , return-value )).
     3339           undo _main, return error  substitute("Ошибки при сохранении фин.док-та:&1&2&1&3"                                    , chr(10)                                    , error-status:get-message(1)                                      , return-value ).
     3340          END.
     3341         if buf_fin-doc.status_ <> 'факт':U then do:
     3342           run proc-close in this-procedure ( buffer buf_fin-doc) NO-ERROR.
     3343           if error-status :error then do:
     3344                       if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось сменить статус фин.док-та:&1&2&1&3"                                      , chr(10)                                      , error-status:get-message(1)                                        , return-value )).
     3345             undo _main, return error  substitute("Не удалось сменить статус фин.док-та:&1&2&1&3"                                      , chr(10)                                      , error-status:get-message(1)                                        , return-value ).
     3346           END.
     3347         end.
     3348         if buf_fin-doc.status_ <> 'факт':U then do:
     3349           run proc-close in this-procedure ( buffer buf_fin-doc) no-error .
     3350           if error-status :error then do:
     3351                       if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось сменить статус фин.док-та:&1&2&1&3"                                      , chr(10)                                      , error-status:get-message(1)                                        , return-value )).
     3352             undo _main, return error  substitute("Не удалось сменить статус фин.док-та:&1&2&1&3"                                      , chr(10)                                      , error-status:get-message(1)                                        , return-value ).
     3353           END.
     3354        end.
     3355                 if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Создаю &1 для выручки по смене № &2 от &3 (П. &4)&8 для &5&6  по кассовой книге № &7 на сумму &8 &9"                                   , entry (lookup ((if buf_temp-fin-sum.tot-sum > 0 then 'пко':U else 'рко':U), 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U)                                    , buf_shift-obj.shift-name                                   , buf_shift-obj.shift-date                                   , buf_shift-obj.shift-nuM                                      , buf_shift-obj.obj-type                                   , buf_shift-obj.obj-code                                   , mCashbookName                                   , abs(buf_temp-fin-sum.tot-sum)                                   , chr(10)                                   )).
     3356       message substitute("Создаю &1 для выручки по смене № &2 от &3 (П. &4)&8 для &5&6  по кассовой книге № &7 на сумму &8 &9"                                   , entry (lookup ((if buf_temp-fin-sum.tot-sum > 0 then 'пко':U else 'рко':U), 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U)                                    , buf_shift-obj.shift-name                                   , buf_shift-obj.shift-date                                   , buf_shift-obj.shift-nuM                                      , buf_shift-obj.obj-type                                   , buf_shift-obj.obj-code                                   , mCashbookName                                   , abs(buf_temp-fin-sum.tot-sum)                                   , chr(10)                                   ) view-as alert-box.
     3357      end.
     3358     run rep/pre-vedom.p (
     3359                     INPUT parParentProc
     3360                   ,input buf_fin-doc.host-code
     3361                   ,input buf_fin-doc.fin-doc-code
     3362                 ) no-error.
     3363   end.
     3364   finally:
     3365       delete object mCashBook no-error .
     3366   end finally.
     3367   end procedure.
     3368   PROCEDURE StrTax :
     3369     do
     3370     on error undo, return error return-value
     3371     :
     3372       define input-output parameter str as character no-undo .
     3373       define variable v-envd as logical no-undo .
     3374       assign str = " В т.ч.: "  .
     3375       for each tt0-fin-doc-tax :
     3376         if str <> " В т.ч.: " then str = str + "," .
     3377         if not tt0-fin-doc-tax.with-vat then assign str = str + "без НДС - (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     3378         else do:
     3379         if tt-fin-doc.curr-code = 0 then do:
     3380           assign str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     3381         end.
     3382         else do:
     3383           assign str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     3384         end.
     3385       end.
     3386       if str = " В т.ч.: " then assign str = "" .
     3387     end.
     3388     end.
     3389   END PROCEDURE.
     3390   PROCEDURE RoundTax :
     3391     do
     3392     on error undo, return error return-value
     3393     :
     3394       for each tt0-fin-doc-tax :
     3395         assign
     3396           tt0-fin-doc-tax.sum-line-doc       =  ROUND( tt0-fin-doc-tax.sum-line-doc      , 2)
     3397           tt0-fin-doc-tax.sum-vat-line-doc   =  ROUND( tt0-fin-doc-tax.sum-vat-line-doc  , 2)
     3398           tt0-fin-doc-tax.sum-line-rubl      =  ROUND( tt0-fin-doc-tax.sum-line-rubl     , 2)
     3399           tt0-fin-doc-tax.sum-vat-line-rubl  =  ROUND( tt0-fin-doc-tax.sum-vat-line-rubl , 2)
     3400           tt0-fin-doc-tax.sum-line-base      =  ROUND( tt0-fin-doc-tax.sum-line-base     , 2)
     3401           tt0-fin-doc-tax.sum-vat-line-base  =  ROUND( tt0-fin-doc-tax.sum-vat-line-base , 2)
     3402         .
     3403       end.
     3404     end.
     3405   END PROCEDURE.
     3406   procedure proc-close :
     3407   define parameter buffer buf_fin-doc for ub.fin-doc.
     3408   define variable v-status_ as character no-undo .
     3409   define variable v-old-status_ as character no-undo .
     3410   define variable v-ask-date as logical no-undo .
     3411   define variable v-ask-message as character no-undo .
     3412   define variable v-status-date-chr as character no-undo.
     3413   define variable v-date1 as date no-undo .
     3414   assign
     3415   v-old-status_ = buf_fin-doc.status_
     3416   .
     3417   run trg/findgraf.p (
     3418                   input  buf_fin-doc.host-code
     3419                   ,input  buf_fin-doc.fin-doc-code
     3420                   ,input  '<закрытие документа>':U
     3421                   ,input  ''
     3422                   ,input  v-old-status_
     3423                   ,input  ?
     3424                   ,output v-status_
     3425                   ,output v-ask-date
     3426                   ,output v-ask-message
     3427                   ) no-error.
     3428   if error-status:error then do:
     3429     return error substitute("Ошибка при проверке возможности &1&2&3"
     3430                              ,'<закрытие документа>':U
     3431                              , chr(10)
     3432                              , return-value ).
     3433   end.
     3434   v-date1 = buf_fin-doc.doc-date.
     3435   run trg/findstat.p (
     3436                     input parparentproc
     3437                   ,input buf_fin-doc.host-code
     3438                   ,input buf_fin-doc.fin-doc-code
     3439                   ,input '<закрытие документа>':U
     3440                   ,input 'auto':U
     3441                   ,input v-status_
     3442                   ,input-output v-date1
     3443                   ,input no
     3444                   ) no-error .
     3445   if error-status:error then do:
     3446     return error substitute("Ошибка при переводе статуса финансового документа:&1&2&1&3"
     3447                              ,'<закрытие документа>':U
     3448                              , chr(10)
     3449                              , return-value ).
     3450   end.
     3451   end procedure.
     3452   procedure check-petrol :
     3453   define input  parameter p-b-code       like ub.chk-gds-pay.b-code no-undo.
     3454   define output parameter p-is-petrolium as logical                 no-undo.
     3455   define variable is-petrol    as logical   no-undo.
     3456   define variable is-pieces    as logical   no-undo.
     3457   define variable v-value      as character no-undo.
     3458   define variable v-type       as character no-undo.
     3459   define buffer buf_bar-code       for ub.bar-code.
     3460   define buffer buf_goods          for ub.goods.
     3461     find first buf_bar-code no-lock where
     3462             buf_bar-code.b-code = p-b-code no-error.
     3463     if available buf_bar-code then do:
     3464       find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error.
     3465       if available buf_goods then do:
     3466         assign p-is-petrolium = false .
     3467   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     3468     (
     3469        input buf_goods.artic
     3470     ,  input buf_goods.prod-type
     3471     ,  input buf_goods.prod-code
     3472     , output is-petrol
     3473     , output is-pieces
     3474     ) no-error.
     3475         if  is-petrol = yes
     3476         and is-pieces = no
     3477         then do :
     3478           run gds-attr-value in this-procedure (
     3479                                            input buf_goods.gds-code
     3480                                           ,input 'ptrl-as-good':U
     3481                                           ,output v-value
     3482                                           ,output v-type
     3483                                           ) no-error.
     3484           if NOT logical(v-value) = yes then do:
     3485             assign p-is-petrolium = yes.
     3486           end.
     3487         end.
     3488       end.
     3489     end.
     3490   end procedure.
