     2577   DEFINE TEMP-TABLE tt0-fin-doc-attr NO-UNDO LIKE ub.fin-doc-attr.
     2578   DEFINE TEMP-TABLE tt0-fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax.
     2579   DEFINE TEMP-TABLE tt0-payment NO-UNDO LIKE ub.payment.
     2580   define temp-table tt-cashBookOst no-undo
     2581   field chang      as logical
