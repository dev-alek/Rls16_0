     2600   num-expense_cash is-expense_cash cash-desk curr-code is-petrol cashbookid
     2601   .
     2602   define temp-table temp-gds no-undo
     2603   field with-vat as logical init yes
     2604   field b-code as integer
     2605   field node-code as integer
