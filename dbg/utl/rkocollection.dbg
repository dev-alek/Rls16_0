     3062            v-real-obj-type = mCashBook:getSinglRule(buf_temp-fin-sum.CashBookId, 'всем':U, 0, "CountCollect-type") .
     3063            v-real-obj-code = int(mCashBook:getSinglRule(buf_temp-fin-sum.CashBookId, 'всем':U, 0, "CountCollect-code") ).
