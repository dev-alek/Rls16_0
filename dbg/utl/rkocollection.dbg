     2673   procedure proc-main :
     2674   define variable v-count         as integer   no-undo .
     2675   define variable v-tot-r-b-chk   as decimal   no-undo .
     2676   define variable v-tot-r-b-inkas as decimal   no-undo .
     2677   define variable v-real-obj-type as character no-undo .
     2678   define variable v-real-obj-code as integer   no-undo .
     2679   define variable v-host-code     as integer   no-undo .
     2680   define variable v-host-name     as character no-undo .
     2681   define variable v-base-code     as integer   no-undo .
     2682   define variable v-param-type    as character no-undo .
     2683   define variable v-naznach-plat  as character no-undo .
     2684   define variable v-naznach-plat2 as character no-undo .
     2685   define variable cash-book       as integer   no-undo .
     2686   define variable v-value         as character no-undo .
     2687   define variable v-cashier       as character no-undo .
     2688   define variable v-limit-access  as integer   no-undo .
     2689   define variable v-obj-db-num    as integer   no-undo .
     2690   define variable v-vat-pc        as integer   no-undo .
     2691   define variable v-slt-pc        as integer   no-undo .
     2692   define variable fact-order      as decimal   no-undo .
     2693   define buffer buf_inkas          for ub.inkas.
     2694   define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     2695   define buffer buf_cash-pay       for ub.cash-pay.
     2696   define buffer buf_temp-fin-sum   for temp-fin-sum.
     2697   define buffer buf_temp-fin-sum-Pko for temp-fin-sum.
     2698   define buffer buf_chk-gds-pay    for ub.chk-gds-pay.
     2699   define buffer buf_chk-doc        for ub.chk-doc.
     2700   define buffer buf_chk-pay        for ub.chk-pay.
     2701   define buffer buf_chk-pay-attr   for ub.chk-pay-attr.
     2702   define buffer buf_temp-gds       for temp-gds.
     2703   define buffer buf_bar-code       for ub.bar-code.
     2704   define buffer buf_goods          for ub.goods.
     2705   define buffer buf_sale-doc       for ub.sale-doc.
     2706   define buffer buf_trn-doc        for ub.trn-doc.
     2707   define buffer buf_doc-line       for ub.doc-line.
     2708   define buffer buf_gds-dtl        for ub.gds-dtl.
     2709   define buffer buf_temp-tax       for temp-tax.
     2710   define buffer buf_fin-doc        for ub.fin-doc.
     2711   define buffer buf_sysconf        for ub.sysconf.
     2712   define buffer buf_shift-staff    for ub.shift-staff.
     2713   define buffer buf_chk-gds        for ub.chk-gds.
     2714   mCashBook = new ibs.th.ref.cashbookstorage () .
     2715   _main:
     2716   do
     2717   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2718   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2719   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2720   :
     2721   define variable v-err               as logical    no-undo .
     2722   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2723   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     2724     (input  buf_shift-obj.obj-type
     2725     ,input  buf_shift-obj.obj-code
     2726     ,output v-host-code
     2727     ,output v-host-name
     2728     )  .
     2729   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2731     (input  buf_shift-obj.obj-type
     2732     ,input  buf_shift-obj.obj-code
     2733     ,output v-obj-db-num
     2734     )  .
     2735   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2737     (input  v-host-code
     2738     ,output v-base-code
     2739     )  .
     2740       find first buf_sysconf no-lock where
     2741                 buf_sysconf.host-code = v-host-code.
     2742       find first buf_shift-staff no-lock
     2743            where buf_shift-staff.obj-type   = buf_shift-obj.obj-type
     2744              and buf_shift-staff.obj-code   = buf_shift-obj.obj-code
     2745              and buf_shift-staff.shift-date = buf_shift-obj.shift-date
     2746              and buf_shift-staff.shift-num  = buf_shift-obj.shift-num
     2747              no-error.
     2748       if not available buf_shift-staFF THEN DO:
     2749          if buf_shift-obj.status_ = 'зкр':U then do:
     2750             v-cashier = "адм".
     2751          end.
     2752          else do:
     2753                run gbl/d-prompt.w (
     2754               'title=':u + "Менеджер смены неопределен. Введите ФИО кассира," + '\':u
     2755             + 'text1=':u + "от имени которого будем оформлять Ордер на выручку" + '\':u
     2756             + 'format=' + "X(40)" + '\':u
     2757             + 'type=' + 'C':U + '\':u
     2758             + 'fillin_row=3\':u
     2759             + 'fillin_col=4\':u
     2760             + 'fillin_width=41\':u
     2761             + 'fillin_height=1\':u
     2762             + 'max-chars=5\':u
     2763             + 'readonly=no\':u
     2764             , input-output v-value
     2765             ).
     2766             if return-value = 'false':u then do:
     2767                                 if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Нельзя создать ордер на выручку, если кассир не определен")).
     2768                  undo, return error substitute("Нельзя создать ордер на выручку, если кассир не определен").
     2769             END.
     2770          end.
     2771         v-cashier = v-value.
     2772      end.
     2773      else do:
     2774         v-cashier = buf_shift-staff.name.
     2775      end.
     2776      define variable v-obj-date as date no-undo.
     2777   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2779     (input  buf_shift-obj.obj-type
     2780     ,input  buf_shift-obj.obj-code
     2781     ,output v-obj-date
     2782     )  .
     2783      block-chk:
     2784      for each chk-doc where(  chk-doc.obj-type   = buf_shift-obj.obj-type
     2785                         and chk-doc.obj-code     = buf_shift-obj.obj-code
     2786                         and chk-doc.shift-date   = buf_shift-obj.shift-date
     2787                         and chk-doc.shift-num    = buf_shift-obj.shift-num
     2788                         )
     2789                         or  (    chk-doc.obj-type eq buf_shift-obj.obj-type
     2790                              and chk-doc.obj-code eq buf_shift-obj.obj-code
     2791                              and chk-doc.out-code  = ?)
     2792       no-lock:
     2793          if     chk-doc.chk-type    ne integer('1':U)
     2794             and chk-doc.chk-type    ne integer('6':U)
     2795          then
     2796             next block-chk.
     2797          do vi = 1 to num-entries(chk-doc.office):
     2798             if can-do('0,сум-ош,сер-ош,при-ош,опл-ош,скидка-ош,тов-ош,кол-ош,прт-ош':U,entry(vi,chk-doc.office))
     2799             then do:
     2800                next block-chk.
     2801             end.
     2802          end.
     2803          run rep/r-pychone.p(parparentproc,chk-doc.doc-code).
     2804          for each buf_chk-gds-pay where
     2805              buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     2806           and buf_chk-gds-pay.algo-num = "1.8"
     2807           and buf_chk-gds-pay.pay-code eq 1
     2808          no-lock:
     2809             run gds-attr-value in this-procedure (
     2810                                            input buf_chk-gds-pay.gds-code
     2811                                           ,input "cash-book-id"
     2812                                           ,output mValue
     2813                                           ,output mType) no-error.
     2814             find first ub.CashBook no-lock where ub.CashBook.id = int64(mValue) no-error .
     2815             if not available ub.CashBook
     2816             then do :
     2817                find first ub.CashBook no-lock where ub.CashBook.id = 0 no-error .
     2818             end.
     2819             if available ub.CashBook
     2820             then do :
     2821                p-by-cash-desk = no .
     2822                p-by-petrol-goods = no .
     2823             end.
     2824             find first tt-cashBookOst where tt-cashBookOst.cashbookid eq CashBook.id
     2825             no-error.
     2826             if not available tt-cashBookOst
     2827             then do:
     2828                create tt-cashBookOst.
     2829                assign
     2830                   tt-cashBookOst.cashbookid   =  CashBook.id
     2831                   tt-cashBookOst.cashbookname =  CashBook.CashBookName
     2832                .
     2833                run fostatok in this-procedure (
     2834                    input   v-host-code
     2835                     ,input   buf_shift-obj.obj-code
     2836                     ,input   buf_shift-obj.obj-type
     2837                     ,input   yes
     2838                     ,input   buf_shift-obj.close-date - 1
     2839                     ,input   v-obj-date
     2840                     ,input   buf_shift-obj.shift-num
     2841                     ,input   buf_shift-obj.shift-num
     2842                     ,input   yes
     2843                     ,input   0
     2844                     ,input   CashBook.id
     2845                     ,output  tt-cashBookOst.ostrasch
     2846                     ,output  Fact-order)
     2847                    no-error .
     2848                    tt-cashBookOst.ost = tt-cashBookOst.ostrasch.
     2849                      output to "rkoincas.log" append.
     2850                      put unformatted "Кассовая книга " CashBook.id " остаток " tt-cashBookOst.ostrasch " статус " CashBook.Status_ skip.
     2851                      output close.
     2852             end.
     2853             define variable msum as decimal no-undo.
     2854             case buf_chk-gds-pay.curr-code:
     2855                when 0 then do:
     2856                   assign
     2857                      msum =  (if v-curr-r-b = 'rubl':U
     2858                                then buf_chk-gds-pay.tot-r-b
     2859                                else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate)
     2860                              )
     2861                    .
     2862                end.
     2863                when v-base-code then do:
     2864                     assign
     2865                        msum = (if v-curr-r-b = 'base':U
     2866                                then buf_chk-gds-pay.tot-r-b
     2867                                else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate)
     2868                               )
     2869                    .
     2870                end.
     2871             end case.
     2872             find first buf_temp-fin-sum
     2873                  where buf_temp-fin-sum.curr-code = buf_chk-gds-pay.curr-code
     2874                    and buf_temp-fin-sum.cashbookid = (if available ub.CashBook then ub.CashBook.id else 0)
     2875                    and buf_temp-fin-sum.is-expense_cash = no
     2876             no-error.
     2877             if not available buf_temp-fin-sum
     2878             then do:
     2879                create buf_temp-fin-sum.
     2880                assign
     2881                   buf_temp-fin-sum.curr-code = buf_chk-gds-pay.curr-code
     2882                   buf_temp-fin-sum.cash-desk = 0
     2883                   buf_temp-fin-sum.is-petrol = no
     2884                   buf_temp-fin-sum.cashbookid = (if available ub.CashBook then ub.CashBook.id else 0)
     2885                   buf_temp-fin-sum.is-expense_cash = no
     2886                   buf_temp-fin-sum.tot-rubl = tt-cashBookOst.ostrasch
     2887                   buf_temp-fin-sum.tot-base = tt-cashBookOst.ostrasch
     2888                   buf_temp-fin-sum.tot-sum =  tt-cashBookOst.ostrasch
     2889                .
     2890             end.
     2891             assign
     2892                buf_temp-fin-sum.tot-rubl = buf_temp-fin-sum.tot-rubl + (if v-curr-r-b = 'rubl':U
     2893                                                                       then buf_chk-gds-pay.tot-r-b
     2894                                                                        else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate)
     2895                                                                       )
     2896                 buf_temp-fin-sum.tot-base = buf_temp-fin-sum.tot-base + (if v-curr-r-b = 'base':U
     2897                                                                        then buf_chk-gds-pay.tot-r-b
     2898                                                                        else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate)
     2899                                                                           )
     2900                 buf_temp-fin-sum.tot-sum = buf_temp-fin-sum.tot-sum + msum
     2901                 tt-cashBookOst.ostrasch = + tt-cashBookOst.ostrasch + msum
     2902             .
     2903                      output to "rkoincas.log" append.
     2904                      put unformatted "Кассовая книга " CashBook.id " чек " chk-doc.doc-code " продажа " chk-doc.out-code " Товар " " - " " сумма " msum skip.
     2905                      output close.
     2906          end.
     2907          if ub.chk-doc.out-code eq ?
     2908          then
     2909             for each buf_chk-gds-pay where
     2910                 buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     2911              and buf_chk-gds-pay.algo-num = "1.8"
     2912             exclusive-lock:
     2913                delete buf_chk-gds-pay.
     2914             end.
     2915       end.
     2916       cashb:
     2917       for each cashbook no-lock:
     2918          find first tt-cashBookOst where tt-cashBookOst.cashbookid eq CashBook.id
     2919          no-error.
     2920          if not available tt-cashBookOst
     2921          then do:
     2922             create tt-cashBookOst.
     2923             assign
     2924                tt-cashBookOst.cashbookid   =  CashBook.id
     2925                tt-cashBookOst.cashbookname =  CashBook.CashBookName
     2926             .
     2927             run fostatok in this-procedure (
     2928                    input   v-host-code
     2929                     ,input   buf_shift-obj.obj-code
     2930                     ,input   buf_shift-obj.obj-type
     2931                     ,input   yes
     2932                     ,input   buf_shift-obj.close-date - 1
     2933                     ,input   v-obj-date
     2934                     ,input   buf_shift-obj.shift-num
     2935                     ,input   buf_shift-obj.shift-num
     2936                     ,input   yes
     2937                     ,input   0
     2938                     ,input   CashBook.id
     2939                     ,output  tt-cashBookOst.ostrasch
     2940                     ,output  Fact-order)
     2941                    no-error .
     2942             if ub.CashBook.Status_ = 1 and tt-cashBookOst.ostrasch = 0 then
     2943             do:
     2944                 delete tt-cashBookOst.
     2945                 next cashb.
     2946             end.
     2947             tt-cashBookOst.ost = tt-cashBookOst.ostrasch.
     2948             find first buf_temp-fin-sum
     2949                  where buf_temp-fin-sum.curr-code = 0
     2950                    and buf_temp-fin-sum.cashbookid = (if available ub.CashBook then ub.CashBook.id else 0)
     2951                    and buf_temp-fin-sum.is-expense_cash = no
     2952             no-error.
     2953             if not available buf_temp-fin-sum
     2954             then do:
     2955                create buf_temp-fin-sum.
     2956                assign
     2957                   buf_temp-fin-sum.curr-code = 0
     2958                   buf_temp-fin-sum.cash-desk = 0
     2959                   buf_temp-fin-sum.is-petrol = no
     2960                   buf_temp-fin-sum.cashbookid = (if available ub.CashBook then ub.CashBook.id else 0)
     2961                   buf_temp-fin-sum.is-expense_cash = no
     2962                    buf_temp-fin-sum.tot-rubl = tt-cashBookOst.ostrasch
     2963                 buf_temp-fin-sum.tot-base = tt-cashBookOst.ostrasch
     2964                 buf_temp-fin-sum.tot-sum = tt-cashBookOst.ostrasch
     2965                .
     2966             end.
     2967          end.
     2968          else
     2969             tt-cashBookOst.ostrasch = round(tt-cashBookOst.ostrasch,2).
     2970       end.
     2971       define variable mSumAll as decimal no-undo.
     2972       for each tt-cashBookOst where tt-cashBookOst.ostrasch > 0:
     2973          mSumAll = mSumAll + tt-cashBookOst.ostrasch.
     2974          tt-cashBookOst.chang = yes.
     2975       end.
     2976       for each tt-cashBookOst where tt-cashBookOst.cashbookid eq 0:
     2977          tt-cashBookOst.chang = yes.
     2978       end.
     2979       define variable msumInc as decimal no-undo.
     2980       define variable msumInc-save as decimal no-undo.
     2981       define variable mOsnbag as character no-undo.
     2982       define variable mMoney  as character no-undo.
     2983       define variable mOk     as logical no-undo.
     2984       run ref/incas.p (input-output table tt-cashBookOst
     2985                      ,  input  mSumAll
     2986                      , output msumInc
     2987                      , output mOsnbag
     2988                      , output mMoney
     2989                      , output mOk).
     2990       if not mOk then return.
     2991       msumInc-save = msumInc.
     2992       for each buf_temp-fin-sum where  buf_temp-fin-sum.num-expense_cash eq 0
     2993                                   and  buf_temp-fin-sum.is-expense_cash  eq no
     2994                                      by buf_temp-fin-sum.cashbookid desc:
     2995          find first tt-cashBookOst where tt-cashBookOst.cashbookid eq buf_temp-fin-sum.cashbookid and tt-cashBookOst.chang no-lock no-error.
     2996          if available tt-cashBookOst
     2997          then
     2998             buf_temp-fin-sum.tot-sum = -1 * min (if  buf_temp-fin-sum.cashbookid ne 0 then max(buf_temp-fin-sum.tot-sum,0) else msumInc,msumInc).
     2999          else
     3000             buf_temp-fin-sum.tot-sum = 0.
     3001          msumInc = msumInc + buf_temp-fin-sum.tot-sum.
     3002          if buf_temp-fin-sum.tot-sum eq 0
     3003          then delete buf_temp-fin-sum.
     3004          else do:
     3005             create buf_temp-tax.
