     2501   procedure ahrstutl-clear-aht :
     2502     define input  parameter p-obj-type         as character no-undo .
     2503     define input  parameter p-obj-code         as integer   no-undo .
     2504     define input  parameter p-fact-date        as date      no-undo .
     2505     define buffer buf_aht-ot-tot   for ub.aht-ot-tot .
     2506     define buffer buf_aht-ot-line  for ub.aht-ot-line .
     2507     define buffer buf_aht-stk-tot  for ub.aht-stk-tot .
     2508     define buffer buf_aht-stk-line for ub.aht-stk-line .
     2509     define variable v-shift-on                as logical   no-undo .
     2510     define variable v-shift-date              as date      no-undo .
     2511     define variable v-shift-num               as integer   no-undo .
     2512     define variable v-day-end-fact-order      as decimal   no-undo .
     2513     define variable v-shift-end-fact-order    as decimal   no-undo .
     2514     define variable v-ind as integer no-undo .
     2515     do
     2516     on error undo, return error return-value
     2517     :
     2518       run factord-cut-archive in this-procedure
     2519         (input  p-obj-type
     2520         ,input  p-obj-code
     2521         ,input  p-fact-date
     2522         ,output v-shift-on
     2523         ,output v-shift-date
     2524         ,output v-shift-num
     2525         ,output v-day-end-fact-order
     2526         ,output v-shift-end-fact-order
     2527         ) .
     2528       assign
     2529         v-day-end-fact-order   = v-day-end-fact-order   - 0.0000000001
     2530         v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     2531       .
     2532       run show-action in this-procedure
     2533         (input "Удаление оборота по документам"
     2534         ).
     2535       assign
     2536         v-ind = 0
     2537       .
     2538       for each buf_aht-ot-tot
     2539         where buf_aht-ot-tot.obj-type   = p-obj-type
     2540           and buf_aht-ot-tot.obj-code   = p-obj-code
     2541           and buf_aht-ot-tot.fact-order <= v-day-end-fact-order
     2542       on error undo, return error return-value
     2543       :
     2544         assign
     2545           v-ind = v-ind + 1
     2546         .
     2547         if v-ind modulo 10 = 0
     2548         then do:
     2549           run show-count in this-procedure
     2550             (input v-ind
     2551             ,input "Документ " + string(buf_aht-ot-tot.doc-code)
     2552             ).
     2553         end.
     2554         delete buf_aht-ot-tot .
     2555       end.
     2556       run show-action in this-procedure
     2557         (input "Удаление оборота по строкам документов"
     2558         ).
     2559       assign
     2560         v-ind = 0
     2561       .
     2562       for each buf_aht-ot-line
     2563         where buf_aht-ot-line.obj-type   = p-obj-type
     2564           and buf_aht-ot-line.obj-code   = p-obj-code
     2565           and buf_aht-ot-line.fact-order <= v-day-end-fact-order
     2566       on error undo, return error return-value
     2567       :
     2568         assign
     2569           v-ind = v-ind + 1
     2570         .
     2571         if v-ind modulo 10 = 0
     2572         then do:
     2573           run show-count in this-procedure
     2574             (input v-ind
     2575             ,input "Документ " + string(buf_aht-ot-line.doc-code)
     2576                     + " Код товара " + string(buf_aht-ot-line.gds-code)
     2577             ).
     2578         end.
     2579         delete buf_aht-ot-line .
     2580       end.
     2581       run show-action in this-procedure
     2582         (input "Удаление остатка по объекту"
     2583         ).
     2584       assign
     2585         v-ind = 0
     2586       .
     2587       for each buf_aht-stk-tot
     2588         where buf_aht-stk-tot.obj-type   = p-obj-type
     2589           and buf_aht-stk-tot.obj-code   = p-obj-code
     2590           and buf_aht-stk-tot.fact-order <= v-day-end-fact-order
     2591       on error undo, return error return-value
     2592       :
     2593         assign
     2594           v-ind = v-ind + 1
     2595         .
     2596         if v-ind modulo 10 = 0
     2597         then do:
     2598           define variable v-fact-date as date      no-undo .
     2599           run factord-to-date in this-procedure
     2600             (input  buf_aht-stk-tot.fact-order
     2601             ,output v-fact-date
     2602             ) .
     2603           run show-count in this-procedure
     2604             (input v-ind
     2605             ,input "Дата " + string(v-fact-date, '99/99/9999':U )
     2606             ).
     2607         end.
     2608         delete buf_aht-stk-tot .
     2609       end.
     2610       run show-action in this-procedure
     2611         (input "Удаление остатка по товарам на объекте"
     2612         ).
     2613       assign
     2614         v-ind = 0
     2615       .
     2616       for each buf_aht-stk-line
     2617         where buf_aht-stk-line.obj-type   = p-obj-type
     2618           and buf_aht-stk-line.obj-code   = p-obj-code
     2619           and buf_aht-stk-line.fact-order <= v-day-end-fact-order
     2620       on error undo, return error return-value
     2621       :
     2622         assign
     2623           v-ind = v-ind + 1
     2624         .
     2625         if v-ind modulo 10 = 0
     2626         then do:
     2627           run show-count in this-procedure
     2628             (input v-ind
     2629             ,input "Код товара " + string(buf_aht-stk-line.gds-code)
     2630             ).
     2631         end.
     2632         delete buf_aht-stk-line .
     2633       end.
     2634     end.
     2635   end procedure.
     2636   procedure ahrstutl-tot-sum-type-list :
     2637     define output parameter p-sum-type-list as character no-undo .
     2638     do
     2639     on error undo, return error return-value
     2640     :
     2641       define variable v-ind                    as integer   no-undo .
     2642       define variable v-num-entries-TDEDT_List as integer   no-undo .
     2643       assign
     2644         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2645       .
     2646       assign
     2647         p-sum-type-list =                 'r':U
     2648                         + chr(44) + 'c':U
     2649                         + chr(44) + 'b':U
     2650                         + chr(44) + 's':U
     2651                         + chr(44) + 'o':U
     2652                         + chr(44) + 'v':U
     2653       .
     2654       define variable v-ext-sum-type as character no-undo .
     2655       do v-ind = 1 to v-num-entries-TDEDT_List
     2656       :
     2657         run aht_get-stk-sum-type in this-procedure
     2658           (input  'r':U
     2659           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2660           ,output v-ext-sum-type
     2661           ) .
     2662         assign
     2663           p-sum-type-list = p-sum-type-list
     2664                           + chr(44)
     2665                           + v-ext-sum-type
     2666         .
     2667         run aht_get-stk-sum-type in this-procedure
     2668           (input  'c':U
     2669           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2670           ,output v-ext-sum-type
     2671           ) .
     2672         assign
     2673           p-sum-type-list = p-sum-type-list
     2674                           + chr(44)
     2675                           + v-ext-sum-type
     2676         .
     2677         run aht_get-stk-sum-type in this-procedure
     2678           (input  'b':U
     2679           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2680           ,output v-ext-sum-type
     2681           ) .
     2682         assign
     2683           p-sum-type-list = p-sum-type-list
     2684                           + chr(44)
     2685                           + v-ext-sum-type
     2686         .
     2687         run aht_get-stk-sum-type in this-procedure
     2688           (input  's':U
     2689           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2690           ,output v-ext-sum-type
     2691           ) .
     2692         assign
     2693           p-sum-type-list = p-sum-type-list
     2694                           + chr(44)
     2695                           + v-ext-sum-type
     2696         .
     2697         run aht_get-stk-sum-type in this-procedure
     2698           (input  'o':U
     2699           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2700           ,output v-ext-sum-type
     2701           ) .
     2702         assign
     2703           p-sum-type-list = p-sum-type-list
     2704                           + chr(44)
     2705                           + v-ext-sum-type
     2706         .
     2707         run aht_get-stk-sum-type in this-procedure
     2708           (input  'v':U
     2709           ,input  entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2710           ,output v-ext-sum-type
     2711           ) .
     2712         assign
     2713           p-sum-type-list = p-sum-type-list
     2714                           + chr(44)
     2715                           + v-ext-sum-type
     2716         .
     2717       end.
     2718     end.
     2719   end procedure.
     2720   procedure ahrstutl-line-sum-type-list :
     2721     define input  parameter p-gds-goods     as logical   no-undo .
     2722     define output parameter p-sum-type-list as character no-undo .
     2723     do
     2724     on error undo, return error return-value
     2725     :
     2726       define variable v-ind                    as integer   no-undo .
     2727       define variable v-num-entries-TDEDT_List as integer   no-undo .
     2728       assign
     2729         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2730       .
     2731       assign
     2732         p-sum-type-list =                 'r':U
