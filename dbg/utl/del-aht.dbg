     2805   procedure create-log-err :
     2806     define input  parameter p-obj-type  as character no-undo .
     2807     define input  parameter p-obj-code  as integer   no-undo .
     2808     define input  parameter p-file-name as character no-undo .
     2809     define input  parameter p-err       as character no-undo .
     2810     do
     2811     on error undo, return error
     2812     :
     2813       output stream slog to value(p-file-name) .
     2814       export stream slog 'archive-log-version':u '2.1':u .
     2815       export stream slog 'obj-type':u            p-obj-type .
     2816       export stream slog 'obj-code':u            string(p-obj-code) .
     2817       export stream slog  string(p-err) .
     2818       output stream slog close .
     2819     end.
     2820   end procedure.
