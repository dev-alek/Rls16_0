      865   procedure aht_update-ot-tot :
      866     define input  parameter p-obj-type            like ub.trn-doc.obj-type     no-undo .
      867     define input  parameter p-obj-code            like ub.trn-doc.obj-code     no-undo .
      868     define input  parameter p-fact-order          like ub.trn-doc.fact-order   no-undo .
      869     define input  parameter p-ext-doc-type        like ub.trn-doc.ext-doc-type no-undo .
      870     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      871     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
      872     do
      873     on error undo, return error
      874     :
      875       for each buf_temp-aht-ot-line
      876       on error undo, return error
      877       :
      878         find first buf_temp-aht-ot-tot
      879           where buf_temp-aht-ot-tot.doc-code = buf_temp-aht-ot-line.doc-code
      880             and buf_temp-aht-ot-tot.sum-type = buf_temp-aht-ot-line.sum-type
      881           no-error .
      882         if not available buf_temp-aht-ot-tot then do:
      883           create buf_temp-aht-ot-tot .
      884           assign
      885             buf_temp-aht-ot-tot.doc-code     = buf_temp-aht-ot-line.doc-code
      886             buf_temp-aht-ot-tot.sum-type     = buf_temp-aht-ot-line.sum-type
      887             buf_temp-aht-ot-tot.ext-doc-type = p-ext-doc-type
      888             buf_temp-aht-ot-tot.obj-type     = p-obj-type
      889             buf_temp-aht-ot-tot.obj-code     = p-obj-code
      890             buf_temp-aht-ot-tot.fact-order   = p-fact-order
      891           .
      892         end.
      893         assign
      894           buf_temp-aht-ot-tot.fact-qnty = buf_temp-aht-ot-tot.fact-qnty + buf_temp-aht-ot-line.fact-qnty
