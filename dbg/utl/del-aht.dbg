      902   procedure aht_update-stk-table :
      903     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
      904     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
      905     define input  parameter p-ext-doc-type   like ub.trn-doc.ext-doc-type no-undo .
      906     define input  parameter p-trn-doc        as logical   no-undo .
      907     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
      908     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      909     define variable v-stk-ext-sum-type as character no-undo .
      910     do
      911     on error undo, return error
      912     :
      913       for each buf_temp-aht-ot-tot
      914       on error undo, return error
      915       :
      916         run aht_get-stk-sum-type in this-procedure
      917           (input  buf_temp-aht-ot-tot.sum-type
      918           ,input  p-ext-doc-type
      919           ,output v-stk-ext-sum-type
      920           ) .
      921         run aht_store-stk-tot in this-procedure
      922           (buffer buf_temp-aht-ot-tot
      923           ,input buf_temp-aht-ot-tot.sum-type
      924           ,input p-fact-order
      925           ,input p-cut-fact-order
      926           ,input p-ext-doc-type
      927           ,input false
      928           ) .
      929         run aht_store-stk-tot in this-procedure
      930           (buffer buf_temp-aht-ot-tot
      931           ,input v-stk-ext-sum-type
      932           ,input p-fact-order
      933           ,input p-cut-fact-order
      934           ,input p-ext-doc-type
      935           ,input p-trn-doc
      936           ) .
      937       end.
      938       for each buf_temp-aht-ot-line
      939       on error undo, return error
      940       :
      941         run aht_get-stk-sum-type in this-procedure
      942           (input  buf_temp-aht-ot-line.sum-type
      943           ,input  p-ext-doc-type
      944           ,output v-stk-ext-sum-type
      945           ) .
      946         run aht_store-stk-line in this-procedure
      947           (buffer buf_temp-aht-ot-line
      948           ,input buf_temp-aht-ot-line.sum-type
      949           ,input p-fact-order
      950           ,input p-cut-fact-order
      951           ,input p-ext-doc-type
      952           ,input false
      953           ) .
      954         run aht_store-stk-line in this-procedure
      955           (buffer buf_temp-aht-ot-line
      956           ,input v-stk-ext-sum-type
      957           ,input p-fact-order
      958           ,input p-cut-fact-order
      959           ,input p-ext-doc-type
      960           ,input p-trn-doc
      961           ) .
      962       end.
      963     end.
      964   end procedure.
      965   procedure aht_store-stk-tot :
      966     define parameter buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
      967     define input  parameter p-stk-sum-type      as character no-undo .
      968     define input  parameter p-fact-order        like ub.trn-doc.fact-order   no-undo .
      969     define input  parameter p-cut-fact-order    like ub.trn-doc.fact-order   no-undo .
      970     define input  parameter p-ext-doc-type      like ub.trn-doc.ext-doc-type no-undo .
      971     define input  parameter p-update-sale       as logical   no-undo .
      972     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
      973     define buffer new-buf_aht-stk-tot for ub.aht-stk-tot .
      974     do
      975     on error undo, return error return-value
      976     :
      977       find last buf_aht-stk-tot exclusive-lock
      978         where buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
      979           and buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
      980           and buf_aht-stk-tot.sum-type   = p-stk-sum-type
      981           and buf_aht-stk-tot.fact-order <= p-fact-order
      982         use-index category
      983         no-error .
      984       if not available buf_aht-stk-tot
      985       or buf_aht-stk-tot.fact-order <> p-fact-order
      986       then do:
      987         create new-buf_aht-stk-tot .
      988         assign
      989           new-buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
      990           new-buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
      991           new-buf_aht-stk-tot.fact-order = p-fact-order
      992           new-buf_aht-stk-tot.sum-type   = p-stk-sum-type
      993         .
      994         if available buf_aht-stk-tot then do:
      995           assign
      996             new-buf_aht-stk-tot.fact-qnty = buf_aht-stk-tot.fact-qnty
