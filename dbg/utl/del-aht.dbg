     2422   procedure ahrstutl-store :
     2423     define input  parameter p-obj-type  as character no-undo .
     2424     define input  parameter p-obj-code  as integer   no-undo .
     2425     define input  parameter p-fact-date as date      no-undo .
     2426     define buffer buf_temp-aht-stk-tot  for temp-aht-stk-tot .
     2427     define buffer buf_temp-aht-stk-line for temp-aht-stk-line .
     2428     define buffer buf_aht-stk-tot       for ub.aht-stk-tot .
     2429     define buffer buf_aht-stk-line      for ub.aht-stk-line .
     2430     define variable v-shift-on             as logical   no-undo .
     2431     define variable v-shift-date           as date      no-undo .
     2432     define variable v-shift-num            as integer   no-undo .
     2433     define variable v-day-end-fact-order   as decimal   no-undo .
     2434     define variable v-shift-end-fact-order as decimal   no-undo .
     2435     do
     2436     on error undo, return error return-value
     2437     :
     2438       run factord-cut-archive in this-procedure
     2439         (input  p-obj-type
     2440         ,input  p-obj-code
     2441         ,input  p-fact-date
     2442         ,output v-shift-on
     2443         ,output v-shift-date
     2444         ,output v-shift-num
     2445         ,output v-day-end-fact-order
     2446         ,output v-shift-end-fact-order
     2447         ) .
     2448       run show-action in this-procedure
     2449         (input "Создание остатка"
     2450         ).
     2451       define variable v-total-count as integer   no-undo .
     2452       for each buf_temp-aht-stk-tot
     2453       on error undo, return error
     2454       :
     2455         assign
     2456           v-total-count = v-total-count + 1
     2457         .
     2458         if v-total-count modulo 10 = 0
     2459         then do:
     2460           run show-count in this-procedure
     2461             (input v-total-count
     2462             ,input "Остаток по объекту"
     2463             ).
     2464         end.
     2465          create buf_aht-stk-tot .
     2466         assign
     2467                           buf_aht-stk-tot.obj-type     = buf_temp-aht-stk-tot.obj-type     buf_aht-stk-tot.obj-code     = buf_temp-aht-stk-tot.obj-code     buf_aht-stk-tot.fact-order   = buf_temp-aht-stk-tot.fact-order   buf_aht-stk-tot.sum-type     = buf_temp-aht-stk-tot.sum-type
     2468           buf_aht-stk-tot.fact-qnty = buf_temp-aht-stk-tot.fact-qnty
