     1193   procedure aht_add-document :
     1194     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
     1195     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
     1196     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
     1197     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
     1198     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
     1199     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
     1200     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
     1201     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
     1202     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
     1203     define buffer buf_aht-doc for ub.aht-doc .
     1204     do
     1205     on error undo, return error return-value
     1206     :
     1207       find first buf_aht-doc exclusive-lock
     1208         where buf_aht-doc.doc-code = p-doc-code
     1209         no-error .
     1210       if available buf_aht-doc then do:
     1211         message
     1212           vss-workfile vss-revision vss-description skip
     1213           vss-include-info4 skip
     1214           "Попытка повторного создания записи" skip
     1215           "Документ" p-doc-code skip
     1216           view-as alert-box error .
     1217         undo, return error .
     1218       end.
     1219       if p-fact-order = ?
     1220       or p-fact-order = 0
     1221       then do:
     1222         message
     1223           vss-workfile vss-revision vss-description skip
     1224           vss-include-info4 skip
     1225           "Ошибка задания входных параметров" skip
     1226           "Не задан номер документа" skip
     1227           "Документ" p-doc-code skip
     1228           "Номер документа" p-fact-order skip
     1229           view-as alert-box error .
     1230         undo, return error .
     1231       end.
     1232       create buf_aht-doc .
     1233       assign
     1234         buf_aht-doc.doc-code     = p-doc-code
     1235         buf_aht-doc.obj-type     = p-obj-type
     1236         buf_aht-doc.obj-code     = p-obj-code
     1237         buf_aht-doc.ext-doc-type = p-ext-doc-type
     1238         buf_aht-doc.is-trn-doc   = p-is-trn-doc
     1239         buf_aht-doc.fact-order   = p-fact-order
     1240         buf_aht-doc.fact-date    = p-fact-date
     1241         buf_aht-doc.shift-date   = p-shift-date
     1242         buf_aht-doc.shift-num    = p-shift-num
     1243       .
     1244     end.
     1245   end procedure.
     1246   procedure aht_add-date :
     1247     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
     1248     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
     1249     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
     1250     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
     1251     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
     1252     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
     1253     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
     1254     define buffer buf_aht-stk for ub.aht-stk .
     1255     do
     1256     on error undo, return error return-value
     1257     :
     1258       find first buf_aht-stk no-lock
     1259         where buf_aht-stk.obj-type   = p-obj-type
     1260           and buf_aht-stk.obj-code   = p-obj-code
     1261           and buf_aht-stk.stk-type   = p-stk-type
     1262           and buf_aht-stk.fact-order = p-fact-order
     1263         no-error .
     1264       if not available buf_aht-stk then do:
     1265         create buf_aht-stk .
     1266         assign
     1267           buf_aht-stk.obj-type   = p-obj-type
     1268           buf_aht-stk.obj-code   = p-obj-code
     1269           buf_aht-stk.stk-type   = p-stk-type
     1270           buf_aht-stk.fact-order = p-fact-order
     1271           buf_aht-stk.fact-date  = p-fact-date
     1272           buf_aht-stk.shift-date = p-shift-date
     1273           buf_aht-stk.shift-num  = p-shift-num
     1274         .
     1275       end.
     1276     end.
     1277   end procedure.
     1278   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1279     define variable v-cntxt-db-num        as integer   no-undo .
     1280     define variable v-cntxt-userid        as character no-undo .
     1281     define variable v-cntxt-level         as character no-undo .
     1282     define variable v-cntxt-host-code-obj as integer   no-undo .
     1283     define variable v-cntxt-obj-type      as character no-undo .
     1284     define variable v-cntxt-obj-code      as integer   no-undo .
     1285     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1286     define variable v-cntxt-is-admin      as logical   no-undo .
     1287   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1288   define temp-table userobjs_temp-user-obj no-undo
     1289     field obj-type as character
     1290     field obj-code as integer
     1291     index xpk is primary unique obj-type obj-code
     1292     .
     1293   procedure userobjs_clear :
     1294     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1295     do
     1296     on error undo, return error return-value
     1297     :
     1298       for each buf_userobjs_temp-user-obj
     1299       on error undo, return error return-value
     1300       :
     1301         delete buf_userobjs_temp-user-obj .
     1302       end.
     1303     end.
     1304   end .
     1305   procedure userobjs_object-count :
     1306     define output parameter p-total-count as integer   no-undo .
     1307     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1308     do
     1309     on error undo, return error return-value
     1310     :
     1311       assign
     1312         p-total-count = 0
     1313       .
     1314       for each buf_userobjs_temp-user-obj
     1315       on error undo, return error return-value
     1316       :
     1317         assign
     1318           p-total-count = p-total-count + 1
     1319         .
     1320       end.
     1321     end.
     1322   end.
     1323   procedure userobjs_append :
     1324      define input  parameter p-obj-type as character no-undo .
     1325      define input  parameter p-obj-code as integer   no-undo .
     1326     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1327     do
     1328     on error undo, return error return-value
     1329     :
     1330       find first buf_userobjs_temp-user-obj
     1331         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1332           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1333         no-error .
     1334       if not available buf_userobjs_temp-user-obj
     1335       then do:
     1336         create buf_userobjs_temp-user-obj .
     1337         assign
     1338           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1339           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1340         .
     1341       end.
     1342     end.
     1343   end.
     1344   procedure userobjs_object-exist :
     1345     define output parameter p-object-exist as logical   no-undo .
     1346     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1347     do
     1348     on error undo, return error return-value
     1349     :
     1350       find first buf_userobjs_temp-user-obj
     1351         no-error .
     1352       if not available buf_userobjs_temp-user-obj
     1353       then do:
     1354         assign
     1355           p-object-exist = false
     1356         .
     1357       end.
     1358       else do:
     1359         assign
     1360           p-object-exist = true
     1361         .
     1362       end.
     1363     end.
     1364   end.
     1365   procedure userobjs_transfer :
     1366     define input  parameter p-callback-handle as handle no-undo .
     1367     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1368     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1369     do
     1370     on error undo, return error return-value
     1371     :
     1372       if valid-handle(p-callback-handle) <> true
     1373       then do:
     1374         message
     1375           vss-workfile vss-revision vss-description skip
     1376           "Ошибка задания входных параметров" skip
     1377           "Неизвестный указатель на процедуру" skip
     1378           view-as alert-box error .
     1379         undo, return error return-value .
     1380       end.
     1381       if p-callback-handle :get-signature("userobjs_append") = ""
     1382       then do:
     1383         message
     1384           vss-workfile vss-revision vss-description skip
     1385           "Ошибка задания входных параметров" skip
     1386           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1387                     ,p-callback-handle :file-name
     1388                     ) skip
     1389           view-as alert-box error .
     1390         undo, return error return-value .
     1391       end.
     1392       for each buf_userobjs_temp-user-obj
     1393       on error undo, return error return-value
     1394       :
     1395         run userobjs_append in p-callback-handle
     1396           (input  buf_userobjs_temp-user-obj.obj-type
     1397           ,input  buf_userobjs_temp-user-obj.obj-code
     1398           ) .
     1399       end.
     1400     end.
     1401   end procedure.
     1402   procedure userobjs_select-one :
     1403      define input  parameter parparentproc     as widget-handle no-undo .
     1404      define input  parameter p-db-num          as integer   no-undo .
     1405      define input  parameter p-user-id         as character no-undo .
     1406      define input  parameter p-host-code-obj   as integer   no-undo .
     1407      define input  parameter p-obj-type        as character no-undo .
     1408      define input  parameter p-obj-code        as integer   no-undo .
     1409      define output parameter p-user-select     as logical   no-undo .
     1410      define output parameter p-select-obj-type as character no-undo .
     1411      define output parameter p-select-obj-code as character no-undo .
     1412     do
     1413     on error undo, return error return-value
     1414     :
     1415       run gbl/userobjs.w
     1416         (input  parparentproc
     1417         ,input  this-procedure :handle
     1418         ,input  p-db-num
     1419         ,input  p-user-id
     1420         ,input  p-host-code-obj
     1421         ,input  p-obj-type
     1422         ,input  p-obj-code
     1423         ,INPUT  "b-sel"
     1424         ,output p-user-select
     1425         ,output p-select-obj-type
     1426         ,output p-select-obj-code
     1427         ) .
     1428     end.
     1429   end.
     1430   procedure userobjs_select-many :
     1431     define input  parameter parparentproc   as widget-handle no-undo .
     1432     define input  parameter p-db-num        as integer   no-undo .
     1433     define input  parameter p-user-id       as character no-undo .
     1434     define input  parameter p-host-code-obj as integer   no-undo .
     1435     define input  parameter p-obj-type      as character no-undo .
     1436     define input  parameter p-obj-code      as integer   no-undo .
     1437     define output parameter p-user-select   as logical   no-undo .
     1438     define variable v-select-obj-type as character no-undo .
     1439     define variable v-select-obj-code as integer   no-undo .
     1440     do
     1441     on error undo, return error return-value
     1442     :
     1443       run gbl/userobjs.w
     1444         (input  parparentproc
     1445         ,input  this-procedure :handle
     1446         ,input  p-db-num
     1447         ,input  p-user-id
     1448         ,input  p-host-code-obj
     1449         ,input  p-obj-type
     1450         ,input  p-obj-code
     1451         ,INPUT  "b-sel,b-mark"
     1452         ,output p-user-select
     1453         ,output v-select-obj-type
     1454         ,output v-select-obj-code
     1455         ) .
     1456     end.
     1457   end.
     1458   procedure thobjs :
     1459      define input        parameter parparentproc     as widget-handle no-undo .
     1460      define input        parameter i-bttns           as character     no-undo .
     1461      define input        parameter i-list-mode       as character     no-undo.
     1462      define input        parameter i-obj-type        as character     no-undo.
     1463      define input        parameter i-db-num          as integer       no-undo.
     1464      define input        parameter i-host-code       as integer       no-undo.
     1465      define input-output parameter p-rid-list        as character     no-undo .
     1466   run ref/thobjs.p
     1467           ( input parparentproc
     1468            ,input  this-procedure :handle
     1469           , input i-bttns
     1470           , input i-list-mode
     1471           , input i-obj-type
     1472           , input i-db-num
     1473           , input i-host-code
     1474           , input-output p-rid-list ) no-error .
     1475   end.
     1476   define stream slog .
     1477   define buffer calc-aht-lock_batchprocess for ub.batchprocess .
     1478   define variable v-obj-type        like ub.gds-obj.obj-type no-undo .
     1479   define variable v-obj-code        like ub.gds-obj.obj-code no-undo .
     1480   define variable v-clear-archive   as logical   no-undo .
     1481   define variable v-new-start-date  as date      no-undo .
     1482   define variable v-new-detail-date as date      no-undo .
     1483   define variable v-file-name       as character no-undo .
     1484   define variable v-today           as date      no-undo .
     1485   define variable v-ok              as logical   no-undo .
     1486   do
     1487   on error undo, return error
     1488   :
     1489     define variable v-user-select as logical   no-undo .
     1490   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1491     run mainmenu_getcntxt in parparentproc
     1492       (output v-cntxt-db-num
     1493       ,output v-cntxt-userid
     1494       ,output v-cntxt-level
     1495       ,output v-cntxt-host-code-obj
     1496       ,output v-cntxt-obj-type
     1497       ,output v-cntxt-obj-code
     1498       ,output v-cntxt-db-num-obj
     1499       ,output v-cntxt-is-admin
     1500       ) .
     1501   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1502   run userobjs_select-one in this-procedure
     1503     (input  parparentproc
     1504     ,input  v-cntxt-db-num
     1505     ,input  v-cntxt-userid
     1506     ,input  v-cntxt-host-code-obj
     1507     ,input  v-cntxt-obj-type
     1508     ,input  v-cntxt-obj-code
     1509     ,output v-user-select
     1510     ,output v-obj-type
     1511     ,output v-obj-code
     1512     )  .
     1513     if v-user-select <> true
     1514     then do:
     1515       message
     1516         "Объект не выбран"
     1517         view-as alert-box information .
     1518       return .
     1519     end.
     1520     define buffer restore-aht-lock_batchprocess for ub.batchprocess .
     1521     run gbl/lock-prc.p
     1522       (input 'rsat':U
     1523       ,input v-obj-code
     1524       ,input 0
     1525       ,input 0
     1526       ,input v-obj-type
     1527       ,input ""
     1528       ,input ""
     1529       ,input "Объект,,, ,,,Восстановление складского архива по типам приобретения"
     1530       ,input true
     1531       ,buffer restore-aht-lock_batchprocess
     1532       ) no-error .
     1533     if error-status :error
     1534     then do:
     1535       if error-status :get-message(1) <> ""
     1536       then do:
     1537         message
     1538           vss-workfile vss-revision vss-description skip
     1539           "В данный момент восстанавливается складской архив по типам приобретения" skip
     1540           "Невозможно произвести восстановление складского архива по типам приобретения" skip
     1541           view-as alert-box error .
     1542       end.
     1543       undo, return error "В данный момент восстанавливается складской архив по типам приобретения" .
     1544     end.
     1545     run gbl/lock-prc.p
     1546       (input 'ahtb':U
     1547       ,input v-obj-code
     1548       ,input 0
     1549       ,input 0
     1550       ,input v-obj-type
     1551       ,input ""
     1552       ,input ""
     1553       ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
     1554       ,input true
     1555       ,buffer calc-aht-lock_batchprocess
     1556       ) no-error .
     1557     if error-status :error
     1558     then do:
     1559       if error-status :get-message(1) <> ""
     1560       then do:
     1561         message
     1562           vss-workfile vss-revision vss-description skip
     1563           "В данный момент рассчитывается складской архив по типам приобретения" skip
     1564           "Невозможно произвести удаление складского архива по типам приобретения" skip
     1565           view-as alert-box error .
     1566       end.
     1567       undo, return error "В данный момент рассчитывается складской архив по типам приобретения" .
     1568     end.
     1569     define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1570     run gbl/lockrngd.p
     1571       (input  'grar':U
     1572       ,input  'disable':U
     1573       ,buffer buf_lock_gdsrenart_batchprocess
     1574       ) no-error .
     1575     if error-status :error
     1576     then do:
     1577       if error-status :get-message(1) <> ""
     1578       then do:
     1579         message
     1580           vss-workfile vss-revision vss-description skip
     1581           "Ошибка при блокировании функции переименования артикула товара" skip
     1582           error-status :get-message(1) skip
     1583           return-value skip
     1584           view-as alert-box error .
     1585       end.
     1586       undo, return error return-value .
     1587     end.
     1588     define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1589     run gbl/lockrngd.p
     1590       (input  'grgc':U
     1591       ,input  'disable':U
     1592       ,buffer buf_lock_gdsrengc_batchprocess
     1593       ) no-error .
     1594     if error-status :error
     1595     then do:
     1596       if error-status :get-message(1) <> ""
     1597       then do:
     1598         message
     1599           vss-workfile vss-revision vss-description skip
     1600           "Ошибка при блокировании функции переименования кода товара" skip
     1601           error-status :get-message(1) skip
     1602           return-value skip
     1603           view-as alert-box error .
     1604       end.
     1605       undo, return error return-value .
     1606     end.
     1607   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1609     (input  v-obj-type
     1610     ,input  v-obj-code
     1611     ,output v-today
     1612     )  .
     1613     define variable v-attr-value as character no-undo .
     1614     define variable v-attr-type  as character no-undo .
     1615     define variable v-aht-calc          as logical   no-undo .
     1616     define variable v-aht-del           as logical   no-undo .
     1617     define variable v-aht-start-date    as date      no-undo .
     1618     define variable v-aht-detail-date   as date      no-undo .
     1619     define variable v-aht-recalc-date   as date      no-undo .
     1620     run clntattr-value in this-procedure
     1621       (input  v-obj-type
     1622       ,input  v-obj-code
     1623       ,input  'aht-calc':U
     1624       ,output v-attr-value
     1625       ,output v-attr-type
     1626       ) .
     1627     assign
     1628       v-aht-calc = (lookup(v-attr-value, 'yes,true') > 0)
     1629     .
     1630     run clntattr-value in this-procedure
     1631       (input  v-obj-type
     1632       ,input  v-obj-code
     1633       ,input  'aht-del':U
     1634       ,output v-attr-value
     1635       ,output v-attr-type
     1636       ) .
     1637     assign
     1638       v-aht-del = (lookup(v-attr-value, 'yes,true') > 0)
     1639     .
     1640     run clntattr-value in this-procedure
     1641       (input  v-obj-type
     1642       ,input  v-obj-code
     1643       ,input  'aht-start':U
     1644       ,output v-attr-value
     1645       ,output v-attr-type
     1646       ) .
     1647     assign
     1648       v-aht-start-date = date(v-attr-value)
     1649     .
     1650     run clntattr-value in this-procedure
     1651       (input  v-obj-type
     1652       ,input  v-obj-code
     1653       ,input  'aht-detail':U
     1654       ,output v-attr-value
     1655       ,output v-attr-type
     1656       ) .
     1657     assign
     1658       v-aht-detail-date = date(v-attr-value)
     1659     .
     1660     run clntattr-value in this-procedure
     1661       (input  v-obj-type
     1662       ,input  v-obj-code
     1663       ,input  'aht-recalc':U
     1664       ,output v-attr-value
     1665       ,output v-attr-type
     1666       ) .
     1667     assign
     1668       v-aht-recalc-date = date(v-attr-value)
     1669     .
     1670     define variable v-month     as integer   no-undo .
     1671     define variable v-new-month as integer   no-undo .
     1672     define variable v-day       as integer   no-undo .
     1673     define variable v-year      as integer   no-undo .
     1674     assign
     1675       v-month = month(v-aht-detail-date)
     1676       v-year  = year(v-aht-detail-date)
     1677     .
     1678     assign
     1679       v-month = v-month + 1
     1680     .
     1681     if v-month > 12
     1682     then do:
     1683       assign
     1684         v-month = 1
     1685         v-year  = v-year + 1
     1686       .
     1687     end.
     1688     run gbl/d-inpmnt.w
     1689       (input        "Введите месяц и год"
     1690       ,input        ?
     1691       ,input-output v-month
     1692       ,input-output v-year
     1693       ,output       v-ok
     1694       ).
     1695     if v-ok <> true
     1696     then do:
     1697       message
     1698         "Дата очистки складского архива не задана" skip
     1699         view-as alert-box information .
     1700       undo, return error .
     1701     end.
     1702     assign
     1703       v-new-detail-date = date(v-month, 1, v-year)
     1704     .
     1705     define variable v-num as integer   no-undo .
     1706     run gbl/d-askw.w
     1707       (input "Вопрос"
     1708       ,input "Выберите способ удаления складского архива по типам приобретения." + chr(10)
     1709             + "Новая дата начала подробного складского архива по типам приобретения " + string(v-new-detail-date, '99/99/9999':u) + chr(10)
     1710             + "Сегодня " + string(v-today, '99/99/9999':u) + chr(10)
     1711       ,input "|^"
     1712       ,input "Удаление подробной информации" + '^confirm|':u
     1713           + "Полная очистка складского архива" + '^confirm|':u
     1714           + "Отказ"
     1715       ,input "" + '|':u
     1716           + "" + '|':u
     1717           + ""
     1718       ,input 1
     1719       ,input 3
     1720       ,output v-num
     1721       ).
     1722     case v-num :
     1723       when 1
     1724       then do:
     1725         assign
     1726           v-clear-archive = false
     1727         .
     1728       end.
     1729       when 2
     1730       then do:
     1731         assign
     1732           v-clear-archive = true
     1733         .
     1734       end.
     1735       when 3
     1736       then do:
     1737         return .
     1738       end.
     1739       otherwise do:
     1740         message
     1741           vss-workfile vss-revision vss-description skip
     1742           "Ошибка при выборе способа очистки складского архива" skip
     1743           view-as alert-box error .
     1744         undo, return error .
     1745       end.
     1746     end case .
     1747     if v-aht-calc = true
     1748     then do:
     1749       message
     1750         "Складкой архив по типам приобретения" skip
     1751         "Объект" v-obj-type v-obj-code skip
     1752         "Невозможно произвести удаление складского архива" skip
     1753         "Складской архив не рассчитан" skip
     1754         view-as alert-box error .
     1755       undo, return error return-value .
     1756     end.
     1757     if v-aht-del = true
     1758     then do:
     1759       message
     1760         "Складской архив по типам приобретения" skip
     1761         "Объект" v-obj-type v-obj-code skip
     1762         "Невозможно произвести удаление складского архива" skip
     1763         "Остатки имеют неопределенное значение" skip
     1764         "Возможные пути решения: повторная инициализация складского архива" skip
     1765         "или восстановление складского архива из файла в случае ошибки удаления" skip
     1766         view-as alert-box error .
     1767       undo, return error return-value .
     1768     end.
     1769     if (v-aht-start-date <> ?
     1770        and v-aht-detail-date = ?)
     1771     or (v-aht-start-date = ?
     1772        and v-aht-detail-date <> ?)
     1773     then do:
     1774       message
     1775         "Складской архив по типам приобретения" skip
     1776         "Объект" v-obj-type v-obj-code skip
     1777         "Невозможно произвести удаление складского архива" skip
     1778         "Противоречивая информация в датах инициализации складского архива" skip
     1779         "Дата начала складского архива по типам приобретения" string(v-aht-start-date, '99/99/9999':u) skip
     1780         "Дата начала подробного складского архива по типам приобретения" string(v-aht-detail-date, '99/99/9999':u) skip
     1781         view-as alert-box error .
     1782       undo, return error return-value .
     1783     end.
     1784     if  v-aht-recalc-date <> ?
     1785     and v-aht-detail-date <> ?
     1786     and v-aht-recalc-date < v-aht-detail-date
     1787     then do:
     1788       message
     1789         "Складской архив по типам приобретения" skip
     1790         "Объект" v-obj-type v-obj-code skip
     1791         "Невозможно произвести удаление складского архива" skip
     1792         "Дата перерасчета складского архива по товарам раньше, чем начало подробного складского архива" skip
     1793         "Возможные пути решения: повторная инициализация складского архива" skip
     1794         "Дата перерасчета складского архива по типам приобретения" string(v-aht-recalc-date, '99/99/9999':u) skip
     1795         "Дата начала подробного складского архива по типам приобретения" v-aht-detail-date skip
     1796         view-as alert-box error .
     1797       undo, return error return-value .
     1798     end.
     1799     if v-clear-archive = true
     1800     then do:
     1801       assign
     1802         v-new-start-date = v-new-detail-date
     1803       .
     1804     end.
     1805     else do:
     1806       if v-aht-start-date <> ?
     1807       then do:
     1808         assign
     1809           v-new-start-date = v-aht-start-date
     1810         .
     1811       end.
     1812       else do:
     1813         run find-aht-start-date in this-procedure
     1814           (input  v-obj-type
     1815           ,input  v-obj-code
     1816           ,input  v-new-detail-date
     1817           ,output v-new-start-date
     1818           ) .
     1819       end.
     1820     end.
     1821     run trg/bt_aht.p
     1822       (input v-obj-type
     1823       ,input v-obj-code
     1824       ,input v-new-detail-date
     1825       ,input true
     1826       ,input v-cntxt-db-num
     1827       ,input v-cntxt-userid
     1828       ) .
     1829     assign
     1830       v-year  = year(v-new-detail-date)
     1831       v-month = month(v-new-detail-date)
     1832       v-day   = day(v-new-detail-date)
     1833     .
     1834     assign
     1835       v-file-name = 'ahtdel':u
     1836                   + '_':u
     1837                   + (if v-obj-type = 'скл':U then 'stock':u else 'shop':u)
     1838                   + '_':u
     1839                   + string(v-obj-code)
     1840                   + '_':u
     1841                   + string(v-year, '9999':u)
     1842                   + string(v-month, '99':u)
     1843                   + string(v-day, '99':u)
     1844                   + '.txt'
     1845     .
     1846     assign
     1847       v-ok = false
     1848     .
     1849     message
     1850       "ВНИМАНИЕ!" skip
     1851       "Последнее предупреждение перед удалением складского архива по типам приобретения." skip
     1852       "" (if v-clear-archive = true then "ПОЛНАЯ ОЧИСТКА АРХИВОВ" else "УДАЛЕНИЕ ПОДРОБНОЙ ИНФОРМАЦИИ" ) skip
     1853       "Старая дата начала складского архива по типам приобретения" string(v-aht-start-date, '99/99/9999':u) skip
     1854       "Старая дата начала подробного складского архива по типам приобретения" string(v-aht-detail-date, '99/99/9999':u) skip
     1855       "" skip
     1856       "Новая дата начала складского архива по типам приобретения" string(v-new-start-date, '99/99/9999':u) skip
     1857       "Новая дата начала подробного складского архива по типам приобретения" string(v-new-detail-date, '99/99/9999':u) skip
     1858       "Сегодня" string(v-today, '99/99/9999':u) skip
     1859       "Удаленные данные будут сохранены в файле" v-file-name skip
     1860       "Продолжить?" skip
     1861       view-as alert-box question buttons yes-no update v-ok .
     1862     if v-ok <> true
     1863     then do:
     1864       return .
     1865     end.
     1866     define variable v-start-time     as integer   no-undo .
     1867     define variable v-current-time   as character no-undo .
     1868     define variable v-current-action as character no-undo .
     1869     define variable v-count          as integer   no-undo .
     1870     define variable v-sub-action     as character no-undo .
     1871     define frame a
     1872       v-obj-type       label "Объект"
     1873       v-obj-code       no-label skip
     1874       v-current-action format "x(40)" no-label skip
     1875       v-current-time   format "x(8)"  label "Время очистки складского архива" skip
     1876       v-count          format ">>>,>>>,>>9" no-label skip
     1877       v-sub-action     format "x(40)" no-label skip
     1878       with view-as dialog-box side-labels three-d
     1879       title "Удаление складского архива по типам приобретения"
     1880       .
     1881     assign
     1882       v-start-time = time
     1883     .
     1884     view frame a .
     1885     display
     1886       v-obj-type
     1887       v-obj-code
     1888       with frame a .
     1889     define variable v-fact-order           as decimal   no-undo .
     1890     define variable v-shift-end-fact-order as decimal   no-undo .
     1891     define variable v-day-end-fact-order   as decimal   no-undo .
     1892     define variable v-archive-date         as date      no-undo .
     1893     assign
     1894       v-archive-date = v-new-detail-date - 1
     1895     .
     1896     run factord in this-procedure
     1897       (input  v-archive-date
     1898       ,input  1
     1899       ,input  1
     1900       ,input  ?
     1901       ,input  0
     1902       ,input  false
     1903       ,output v-fact-order
     1904       ,output v-shift-end-fact-order
     1905       ,output v-day-end-fact-order
     1906       ) no-error .
     1907     if error-status :error
     1908     then do:
     1909       message
     1910         vss-workfile vss-revision vss-description skip
     1911         "Ошибка при вызове процедуры factord"
     1912         error-status :get-message(1) skip
     1913         return-value skip
     1914         view-as alert-box error .
     1915       undo, return error .
     1916     end.
     1917     run create-log-file in this-procedure
     1918       (input v-obj-type
     1919       ,input v-obj-code
     1920       ,input v-aht-start-date
     1921       ,input v-aht-detail-date
     1922       ,input v-new-start-date
     1923       ,input v-new-detail-date
     1924       ,input v-file-name
     1925       ) no-error .
     1926     if error-status :error
     1927     then do:
     1928       message
     1929         vss-workfile vss-revision vss-description skip
     1930         "Ошибка при создании файла архивации" skip
     1931         "Имя файла архивации" v-file-name skip
     1932         error-status :get-message(1) skip
     1933         return-value skip
     1934         view-as alert-box error .
     1935       undo, return error .
     1936     end.
     1937     run trg/ahtclr.p
     1938       (input v-obj-type
     1939       ,input v-obj-code
     1940       ,input 0
     1941       ,input v-day-end-fact-order
     1942       ,input v-file-name
     1943       ) no-error .
     1944     if error-status :error
     1945     then do:
     1946       message
     1947         vss-workfile vss-revision vss-description skip
     1948         "Ошибка при cохранении складского архива по типам приобретения"
     1949         error-status :get-message(1) skip
     1950         return-value skip
     1951         view-as alert-box error .
     1952       undo, return error .
     1953     end.
     1954     run close-log-file in this-procedure
     1955       (input v-obj-type
     1956       ,input v-obj-code
     1957       ,input v-aht-start-date
     1958       ,input v-aht-detail-date
     1959       ,input v-new-start-date
     1960       ,input v-new-detail-date
     1961       ,input v-file-name
     1962       ) no-error .
     1963     if error-status :error
     1964     then do:
     1965       message
     1966         vss-workfile vss-revision vss-description skip
     1967         "Ошибка при закрытии файла архивации" skip
     1968         "Имя файла архивации" v-file-name skip
     1969         error-status :get-message(1) skip
     1970         return-value skip
     1971         view-as alert-box error .
     1972       undo, return error .
     1973     end.
     1974     define variable v-md5-signature as character no-undo .
     1975     run gbl/md5.p
     1976       (input  v-file-name
     1977       ,output v-md5-signature
     1978       ) .
     1979     define variable v-create-chip-num as integer   no-undo .
     1980     define variable v-action-type     as character no-undo .
     1981     if v-clear-archive = true
     1982     then do:
     1983       assign
     1984         v-action-type = 'delall-start':U
     1985       .
     1986     end.
     1987     else do:
     1988       assign
     1989         v-action-type = 'deldet-start':U
     1990       .
     1991     end.
     1992     run utl/arhiscr.p
     1993       (input  v-obj-type
     1994       ,input  v-obj-code
     1995       ,input  'aht':U
     1996       ,input  v-action-type
     1997       ,input  v-file-name
     1998       ,input  v-md5-signature
     1999       ,input  0
     2000       ,input  ""
     2001       ,input  ""
     2002       ,input  v-new-detail-date
     2003       ,output v-create-chip-num
     2004       ) .
     2005     define buffer lock_shift-obj for ub.shift-obj .
     2006     run factord-lock-shift in this-procedure
     2007       (input  v-obj-type
     2008       ,input  v-obj-code
     2009       ,input  v-archive-date
     2010       ,buffer lock_shift-obj
     2011       ) no-error .
     2012     if error-status :error
     2013     then do:
     2014      define variable v-err as character no-undo .
     2015      v-err = substitute("Ошибка при блокировке смены на объекте &2&3 дата &1" , v-archive-date, v-obj-type , v-obj-code ) .
     2016      run create-log-err in this-procedure
     2017         ( v-obj-type  ,
     2018           v-obj-code  ,
     2019           v-file-name ,
     2020           v-err ).
     2021       undo, return error v-err .
     2022     end.
     2023     run ahrstutl-init in this-procedure
     2024       (input v-obj-type
     2025       ,input v-obj-code
     2026       ,input v-archive-date
     2027       ) .
     2028     run ahrstutl-store in this-procedure
     2029       (input v-obj-type
     2030       ,input v-obj-code
     2031       ,input v-archive-date
     2032       ) .
     2033     do transaction
     2034     on error undo, return error return-value
     2035     :
     2036       run clntattr-write in this-procedure
     2037         (input v-obj-type
     2038         ,input v-obj-code
     2039         ,input 'aht-start':U
     2040         ,input string(v-new-start-date, '99/99/9999':u)
     2041         ) no-error .
     2042       if error-status :error
     2043       then do:
     2044         message
     2045           vss-workfile vss-revision vss-description skip
     2046           "Ошибка при записи даты инициализации складского архива" skip
     2047           error-status :get-message(1) skip
     2048           return-value skip
     2049           view-as alert-box error .
     2050         undo, return error .
     2051       end.
     2052       run clntattr-write in this-procedure
     2053         (input v-obj-type
     2054         ,input v-obj-code
     2055         ,input 'aht-detail':U
     2056         ,input string(v-new-detail-date, '99/99/9999':u)
     2057         ) no-error .
     2058       if error-status :error
     2059       then do:
     2060         message
     2061           vss-workfile vss-revision vss-description skip
     2062           "Ошибка при записи даты инициализации складского архива" skip
     2063           error-status :get-message(1) skip
     2064           return-value skip
     2065           view-as alert-box error .
     2066         undo, return error .
     2067       end.
     2068       run clntattr-write in this-procedure
     2069         (input v-obj-type
     2070         ,input v-obj-code
     2071         ,input 'aht-rest':U
     2072         ,input 'true':u
     2073         ) .
     2074     end.
     2075     find current calc-aht-lock_batchprocess no-lock .
     2076     if v-clear-archive = true
     2077     then do:
     2078       run ahrstutl-clear-aht in this-procedure
     2079         (input  v-obj-type
     2080         ,input  v-obj-code
     2081         ,input  v-archive-date
     2082         ) .
     2083     end.
     2084     else do:
     2085       run utl/cmpraht.p
     2086         (input v-obj-type
     2087         ,input v-obj-code
     2088         ,input 0
     2089         ,input v-day-end-fact-order
     2090         ) no-error .
     2091       if error-status :error
     2092       then do:
     2093         message
     2094           vss-workfile vss-revision vss-description skip
     2095           "Ошибка при удалении складского архива по товару" skip
     2096           error-status :get-message(1) skip
     2097           return-value skip
     2098           view-as alert-box error .
     2099         undo, return error .
     2100       end.
     2101     end.
     2102     define variable v-delete-attr-aht-del as logical   no-undo .
     2103     run clntattr-delete in this-procedure
     2104       (input v-obj-type
     2105       ,input v-obj-code
     2106       ,input 'aht-rest':U
     2107       ,output v-delete-attr-aht-del
     2108       ) .
     2109     if v-clear-archive = true
     2110     then do:
     2111       assign
     2112         v-action-type = 'delall-stop':U
     2113       .
     2114     end.
     2115     else do:
     2116       assign
     2117         v-action-type = 'deldet-stop':U
     2118       .
     2119     end.
     2120     run utl/arhiscr.p
     2121       (input  v-obj-type
     2122       ,input  v-obj-code
     2123       ,input  'arh':U
     2124       ,input  v-action-type
     2125       ,input  ""
     2126       ,input  ""
     2127       ,input  0
     2128       ,input  ""
     2129       ,input  ""
     2130       ,input  v-new-detail-date
     2131       ,output v-create-chip-num
     2132       ) .
     2133     message
     2134       "Складской архив по типам приобретения" skip
     2135       "Объект" v-obj-type v-obj-code skip
     2136       "Удаление складского архива успешно закончилось" skip
     2137       "Сохраните файл" v-file-name "в надёжном месте" skip
     2138       "Затем вы можете восстановить складской архив на основании файла" skip
     2139       "На объекте существует складской архив по типам приобретения с даты" string(v-new-start-date, '99/99/9999':u) skip
     2140       "На объекте существуют подробный складской архив по типам приобретения с даты" string(v-new-detail-date, '99/99/9999':u) skip
     2141       view-as alert-box information .
     2142   end.
     2143   procedure create-log-file :
     2144     define input  parameter p-obj-type        as character no-undo .
     2145     define input  parameter p-obj-code        as integer   no-undo .
     2146     define input  parameter p-aht-start-date  as date      no-undo .
     2147     define input  parameter p-aht-detail-date as date      no-undo .
     2148     define input  parameter p-new-start-date  as date      no-undo .
     2149     define input  parameter p-new-detail-date as date      no-undo .
     2150     define input  parameter p-file-name       as character no-undo .
     2151     do
     2152     on error undo, return error
     2153     :
     2154       output stream slog to value(p-file-name) .
     2155       export stream slog 'archive-log-version':u '2.1':u .
     2156       export stream slog 'obj-type':u            p-obj-type .
     2157       export stream slog 'obj-code':u            string(p-obj-code) .
     2158       export stream slog 'old-start-date':u      string(p-aht-start-date, '99/99/9999':u ) .
     2159       export stream slog 'old-detail-date':u     string(p-aht-detail-date, '99/99/9999':u ) .
     2160       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     2161       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     2162       output stream slog close .
     2163     end.
     2164   end procedure.
     2165   procedure close-log-file :
     2166     define input  parameter p-obj-type        as character no-undo .
     2167     define input  parameter p-obj-code        as integer   no-undo .
     2168     define input  parameter p-aht-start-date  as date      no-undo .
     2169     define input  parameter p-aht-detail-date as date      no-undo .
     2170     define input  parameter p-new-start-date  as date      no-undo .
     2171     define input  parameter p-new-detail-date as date      no-undo .
     2172     define input  parameter p-file-name       as character no-undo .
     2173     do
     2174     on error undo, return error
     2175     :
     2176       output stream slog to value(p-file-name) append .
     2177       export stream slog 'end-of-log':u .
     2178       export stream slog 'archive-log-version':u '2.1':u .
     2179       export stream slog 'obj-type':u            p-obj-type .
     2180       export stream slog 'obj-code':u            string(p-obj-code) .
     2181       export stream slog 'old-start-date':u      string(p-aht-start-date, '99/99/9999':u ) .
     2182       export stream slog 'old-detail-date':u     string(p-aht-detail-date, '99/99/9999':u ) .
     2183       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     2184       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     2185       export stream slog '.':u                   .
     2186       output stream slog close .
     2187     end.
     2188   end procedure.
     2189   procedure find-aht-start-date :
     2190     define input  parameter p-obj-type        as character no-undo .
     2191     define input  parameter p-obj-code        as integer   no-undo .
     2192     define input  parameter p-new-detail-date as date      no-undo .
     2193     define output parameter p-new-start-date  as date      no-undo .
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       assign
     2198         p-new-start-date = p-new-detail-date
     2199       .
     2200       define buffer buf_aht-stk for ub.aht-stk .
     2201       find first buf_aht-stk no-lock
     2202         where buf_aht-stk.obj-type  = p-obj-type
     2203           and buf_aht-stk.obj-code  = p-obj-code
     2204           and buf_aht-stk.stk-type  = 'n':U
     2205         use-index pi
     2206         no-error .
     2207       if  available buf_aht-stk
     2208       and buf_aht-stk.fact-date < p-new-start-date
     2209       then do:
     2210         assign
     2211           p-new-start-date = buf_aht-stk.fact-date
     2212         .
     2213       end.
     2214     end.
     2215   end procedure.
     2216   procedure show-action :
     2217     do
     2218     on error undo, return error
     2219     :
     2220       define input parameter p-action as character no-undo .
     2221       assign
     2222         v-current-time = string(time - v-start-time, "HH:MM:SS")
     2223         v-current-action = p-action
     2224       .
     2225       display
     2226         v-current-time
     2227         v-current-action
     2228         with frame a.
     2229     end.
     2230   end procedure.
     2231   procedure show-count :
     2232     define input  parameter p-count      as integer   no-undo .
     2233     define input  parameter p-sub-action as character no-undo .
     2234     do
     2235     on error undo, return error
     2236     :
     2237       assign
     2238         v-current-time = string(time - v-start-time, "HH:MM:SS")
     2239         v-count        = p-count
     2240         v-sub-action   = p-sub-action
     2241       .
     2242       display
     2243         v-current-time
     2244         v-count
     2245         v-sub-action
     2246         with frame a.
     2247     end.
     2248   end procedure.
     2249   procedure ahrstutl-init :
     2250     define input  parameter p-obj-type  as character no-undo .
     2251     define input  parameter p-obj-code  as integer   no-undo .
     2252     define input  parameter p-fact-date as date      no-undo .
     2253     define buffer buf_gds-obj for ub.gds-obj .
     2254     define buffer buf_goods   for ub.goods .
     2255     define variable v-shift-on             as logical   no-undo .
     2256     define variable v-shift-date           as date      no-undo .
     2257     define variable v-shift-num            as integer   no-undo .
     2258     define variable v-day-end-fact-order   as decimal   no-undo .
     2259     define variable v-shift-end-fact-order as decimal   no-undo .
     2260     define variable v-sum-type-list as character no-undo .
     2261     do
     2262     on error undo, return error
     2263     :
     2264       run factord-cut-archive in this-procedure
     2265         (input  p-obj-type
     2266         ,input  p-obj-code
     2267         ,input  p-fact-date
     2268         ,output v-shift-on
     2269         ,output v-shift-date
     2270         ,output v-shift-num
     2271         ,output v-day-end-fact-order
     2272         ,output v-shift-end-fact-order
     2273         ) .
     2274       define variable v-ind as integer   no-undo .
     2275       run show-action in this-procedure
     2276         (input "Остаток по объекту"
     2277         ).
     2278       run ahrstutl-tot-sum-type-list in this-procedure
     2279         (output v-sum-type-list
     2280         ) .
     2281       do v-ind = 1 to num-entries(v-sum-type-list)
     2282       :
     2283         run ahrstutl-init-tot in this-procedure
     2284           (input p-obj-type
     2285           ,input p-obj-code
     2286           ,input entry(v-ind, v-sum-type-list)
     2287           ,input v-day-end-fact-order
     2288           ) .
     2289       end.
     2290       run show-action in this-procedure
     2291         (input "Остаток по товарам"
     2292         ).
     2293       define variable v-total-count as integer   no-undo .
     2294       for each buf_gds-obj no-lock
     2295         where buf_gds-obj.obj-type = p-obj-type
     2296           and buf_gds-obj.obj-code = p-obj-code
     2297       on error undo, return error
     2298       :
     2299         assign
     2300           v-total-count = v-total-count + 1
     2301         .
     2302         if v-total-count modulo 10 = 0
     2303         then do:
     2304           run show-count in this-procedure
     2305             (input v-total-count
     2306             ,input "Артикул " + string(buf_gds-obj.artic)
     2307             ).
     2308         end.
     2309         find first buf_goods no-lock
     2310           where buf_goods.artic     = buf_gds-obj.artic
     2311             and buf_goods.prod-type = buf_gds-obj.prod-type
     2312             and buf_goods.prod-code = buf_gds-obj.prod-code
     2313           .
     2314         run ahrstutl-line-sum-type-list in this-procedure
     2315           (input buf_goods.gds-type = 'т':U
     2316           ,output v-sum-type-list
     2317           ) .
     2318         do v-ind = 1 to num-entries(v-sum-type-list)
     2319         :
     2320           run ahrstutl-init-line in this-procedure
     2321             (input p-obj-type
     2322             ,input p-obj-code
     2323             ,input buf_gds-obj.gds-code
     2324             ,input entry(v-ind, v-sum-type-list)
     2325             ,input v-day-end-fact-order
     2326             ) .
     2327         end.
     2328       end.
     2329     end.
     2330   end procedure.
     2331   procedure ahrstutl-init-tot :
     2332     define input  parameter p-obj-type                 as character no-undo .
     2333     define input  parameter p-obj-code                 as integer   no-undo .
     2334     define input  parameter p-sum-type                 as character no-undo .
     2335     define input  parameter p-aht-stk-tot-fact-order   as decimal   no-undo .
     2336     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     2337     define buffer buf_temp-aht-stk-tot for temp-aht-stk-tot .
     2338     do
     2339     on error undo, return error return-value
     2340     :
     2341       find last buf_aht-stk-tot no-lock
     2342         where buf_aht-stk-tot.obj-type   = p-obj-type
     2343           and buf_aht-stk-tot.obj-code   = p-obj-code
     2344           and buf_aht-stk-tot.sum-type   = p-sum-type
     2345           and buf_aht-stk-tot.fact-order <= p-aht-stk-tot-fact-order
     2346         use-index category
     2347         no-error .
     2348       if available buf_aht-stk-tot
     2349       and buf_aht-stk-tot.fact-order <> p-aht-stk-tot-fact-order
     2350       then do:
     2351         find first buf_temp-aht-stk-tot
     2352           where buf_temp-aht-stk-tot.obj-type   = buf_aht-stk-tot.obj-type
     2353             and buf_temp-aht-stk-tot.obj-code   = buf_aht-stk-tot.obj-code
     2354             and buf_temp-aht-stk-tot.fact-order = p-aht-stk-tot-fact-order
     2355             and buf_temp-aht-stk-tot.sum-type   = buf_aht-stk-tot.sum-type
     2356           no-error .
