     2384     on error undo, return error return-value
     2385     :
     2386       find last buf_aht-stk-line no-lock
     2387         where buf_aht-stk-line.obj-type   = p-obj-type
     2388           and buf_aht-stk-line.obj-code   = p-obj-code
     2389           and buf_aht-stk-line.gds-code   = p-gds-code
     2390           and buf_aht-stk-line.sum-type   = p-sum-type
     2391           and buf_aht-stk-line.fact-order <= p-aht-stk-line-fact-order
     2392         use-index category
     2393         no-error .
     2394       if available buf_aht-stk-line
     2395       and buf_aht-stk-line.fact-order <> p-aht-stk-line-fact-order
     2396       then do:
     2397         find first buf_temp-aht-stk-line
     2398           where buf_temp-aht-stk-line.obj-type   = buf_aht-stk-line.obj-type
     2399             and buf_temp-aht-stk-line.obj-code   = buf_aht-stk-line.obj-code
     2400             and buf_temp-aht-stk-line.gds-code   = buf_aht-stk-line.gds-code
     2401             and buf_temp-aht-stk-line.fact-order = p-aht-stk-line-fact-order
     2402             and buf_temp-aht-stk-line.sum-type   = buf_aht-stk-line.sum-type
