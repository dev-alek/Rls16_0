     2375   procedure ahrstutl-init-line :
     2376     define input  parameter p-obj-type                as character no-undo .
     2377     define input  parameter p-obj-code                as integer   no-undo .
     2378     define input  parameter p-gds-code                as integer   no-undo .
     2379     define input  parameter p-sum-type                as character no-undo .
