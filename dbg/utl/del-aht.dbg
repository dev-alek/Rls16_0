      757   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   define stream ahtlog .
      759   define temp-table temp-aht-ot-tot no-undo like ub.aht-ot-tot .
      760   define temp-table temp-aht-ot-line no-undo like ub.aht-ot-line .
      761   define temp-table temp-aht-stk-tot no-undo like ub.aht-stk-tot .
      762   define temp-table temp-aht-stk-line no-undo like ub.aht-stk-line .
      763   procedure aht_get-sum-type :
      764     define input  parameter p-aht-type        as character no-undo .
      765     define output parameter p-allsum-sum-type as character no-undo .
      766     do
      767     on error undo, return error return-value
      768     :
      769       case p-aht-type :
      770         when 'r':U then do:
      771           assign
      772             p-allsum-sum-type = 'сумма_по_выкупу_со_знаком':U
      773           .
      774         end.
      775         when 'c':U then do:
      776           assign
      777             p-allsum-sum-type = 'сумма_по_консигнации_закупка_со_знаком':U
      778           .
      779         end.
      780         when 'b':U then do:
      781           assign
      782             p-allsum-sum-type = 'сумма_по_консигнации_выгода_со_знаком':U
      783           .
      784         end.
      785         when 's':U then do:
      786           assign
      787             p-allsum-sum-type = 'сумма_по_ответственному_хранению_со_знаком':U
      788           .
      789         end.
      790         when 'o':U then do:
      791           assign
      792             p-allsum-sum-type = 'сумма_по_старой_консигнации_со_знаком':U
      793           .
      794         end.
      795         when 'v':U then do:
      796           assign
      797             p-allsum-sum-type = 'сумма_по_услуге_со_знаком':U
      798           .
      799         end.
      800         otherwise do:
      801           message
      802             vss-workfile vss-revision vss-description skip
      803             vss-include-info4 skip
      804             "Неизвестное значение типа приобретения" skip
      805             "Тип приобретения" p-aht-type skip
      806             view-as alert-box error .
      807           undo, return error .
      808         end.
      809       end.
      810     end.
      811   end procedure.
      812   procedure aht_get-stk-sum-type :
      813     define input  parameter p-ot-sum-type      as character no-undo .
      814     define input  parameter p-ext-doc-type     as character no-undo .
      815     define output parameter p-stk-ext-sum-type as character no-undo .
      816     do
      817     on error undo, return error return-value
      818     :
      819       assign
      820         p-stk-ext-sum-type = p-ot-sum-type + p-ext-doc-type
      821       .
      822     end.
      823   end procedure.
      824   procedure aht_store-ot-line :
      825     define input  parameter p-doc-code       as character no-undo .
      826     define input  parameter p-gds-code       as integer   no-undo .
      827     define input  parameter p-sum-type       as character no-undo .
      828     define input  parameter p-ext-doc-type   as character no-undo .
      829     define input  parameter p-obj-type       as character no-undo .
      830     define input  parameter p-obj-code       as integer   no-undo .
      831     define input  parameter p-fact-order     as decimal   no-undo .
      832     define input  parameter p-fact-qnty      as decimal   no-undo .
      833             define input  parameter p-cost-sum-base       as decimal   no-undo .     define input  parameter p-cost-sum-rubl       as decimal   no-undo .     define input  parameter p-cost-vat-base       as decimal   no-undo .     define input  parameter p-cost-vat-rubl       as decimal   no-undo .     define input  parameter p-cost-slt-base       as decimal   no-undo .     define input  parameter p-cost-slt-rubl       as decimal   no-undo .     define input  parameter p-cost-road-tax-base  as decimal   no-undo .     define input  parameter p-cost-road-tax-rubl  as decimal   no-undo .     define input  parameter p-cost-excise-base    as decimal   no-undo .     define input  parameter p-cost-excise-rubl    as decimal   no-undo .     define input  parameter p-cost-transport-base as decimal   no-undo .     define input  parameter p-cost-transport-rubl as decimal   no-undo .     define input  parameter p-cost-other-base     as decimal   no-undo .     define input  parameter p-cost-other-rubl     as decimal   no-undo .     define input  parameter p-cost-discnt-base    as decimal   no-undo .     define input  parameter p-cost-discnt-rubl    as decimal   no-undo .
      834             define input  parameter p-crsa-sum-base       as decimal   no-undo .     define input  parameter p-crsa-sum-rubl       as decimal   no-undo .     define input  parameter p-crsa-vat-base       as decimal   no-undo .     define input  parameter p-crsa-vat-rubl       as decimal   no-undo .     define input  parameter p-crsa-slt-base       as decimal   no-undo .     define input  parameter p-crsa-slt-rubl       as decimal   no-undo .     define input  parameter p-crsa-road-tax-base  as decimal   no-undo .     define input  parameter p-crsa-road-tax-rubl  as decimal   no-undo .     define input  parameter p-crsa-excise-base    as decimal   no-undo .     define input  parameter p-crsa-excise-rubl    as decimal   no-undo .     define input  parameter p-crsa-transport-base as decimal   no-undo .     define input  parameter p-crsa-transport-rubl as decimal   no-undo .     define input  parameter p-crsa-other-base     as decimal   no-undo .     define input  parameter p-crsa-other-rubl     as decimal   no-undo .     define input  parameter p-crsa-discnt-base    as decimal   no-undo .     define input  parameter p-crsa-discnt-rubl    as decimal   no-undo .
      835             define input  parameter p-sale-sum-base       as decimal   no-undo .     define input  parameter p-sale-sum-rubl       as decimal   no-undo .     define input  parameter p-sale-vat-base       as decimal   no-undo .     define input  parameter p-sale-vat-rubl       as decimal   no-undo .     define input  parameter p-sale-slt-base       as decimal   no-undo .     define input  parameter p-sale-slt-rubl       as decimal   no-undo .     define input  parameter p-sale-road-tax-base  as decimal   no-undo .     define input  parameter p-sale-road-tax-rubl  as decimal   no-undo .     define input  parameter p-sale-excise-base    as decimal   no-undo .     define input  parameter p-sale-excise-rubl    as decimal   no-undo .     define input  parameter p-sale-transport-base as decimal   no-undo .     define input  parameter p-sale-transport-rubl as decimal   no-undo .     define input  parameter p-sale-other-base     as decimal   no-undo .     define input  parameter p-sale-other-rubl     as decimal   no-undo .     define input  parameter p-sale-discnt-base    as decimal   no-undo .     define input  parameter p-sale-discnt-rubl    as decimal   no-undo .
      836     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      837     do
      838     on error undo, return error return-value
      839     :
      840       find first buf_temp-aht-ot-line
      841         where buf_temp-aht-ot-line.doc-code  = p-doc-code
      842           and buf_temp-aht-ot-line.gds-code  = p-gds-code
      843           and buf_temp-aht-ot-line.sum-type  = p-sum-type
      844         no-error .
      845       if not available buf_temp-aht-ot-line then do:
      846         create buf_temp-aht-ot-line .
      847         assign
      848           buf_temp-aht-ot-line.doc-code     = p-doc-code
      849           buf_temp-aht-ot-line.gds-code     = p-gds-code
      850           buf_temp-aht-ot-line.sum-type     = p-sum-type
      851           buf_temp-aht-ot-line.ext-doc-type = p-ext-doc-type
      852           buf_temp-aht-ot-line.obj-type     = p-obj-type
      853           buf_temp-aht-ot-line.obj-code     = p-obj-code
      854           buf_temp-aht-ot-line.fact-order   = p-fact-order
      855         .
      856       end.
      857       assign
      858         buf_temp-aht-ot-line.fact-qnty = buf_temp-aht-ot-line.fact-qnty + p-fact-qnty
