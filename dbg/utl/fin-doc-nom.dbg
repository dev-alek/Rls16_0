        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo.
        3   define input  parameter ICashbook     as int64 no-undo.
        4   define input  parameter iBegDate      as date no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision:$":U .
        6   define variable vss-author      as character no-undo init "$Author:$":U .
        7   define variable vss-date        as character no-undo init "$Date:$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        9   define variable vss-archive     as character no-undo init "$Archive:$":U .
       10   define variable vss-description as character no-undo init "".
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78   define variable mFactOrder as decimal no-undo.
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80     run mainmenu_getcntxt in parparentproc
       81       (output v-cntxt-db-num
       82       ,output v-cntxt-userid
       83       ,output v-cntxt-level
       84       ,output v-cntxt-host-code-obj
       85       ,output v-cntxt-obj-type
       86       ,output v-cntxt-obj-code
       87       ,output v-cntxt-db-num-obj
       88       ,output v-cntxt-is-admin
       89       ) .
       90   define new global shared variable g#library  as handle no-undo .
       91   define new global shared variable g#library2 as handle no-undo .
       92   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   procedure factord :
       94     define input  parameter p-fact-date            as date    no-undo .
       95     define input  parameter p-fact-time            as integer no-undo .
       96     define input  parameter p-fact-num             as integer no-undo .
       97     define input  parameter p-shift-date           as date    no-undo .
       98     define input  parameter p-shift-num            as integer no-undo .
       99     define input  parameter p-shift-on             as logical no-undo .
      100     define output parameter p-fact-order           as decimal no-undo .
      101     define output parameter p-shift-end-fact-order as decimal no-undo .
      102     define output parameter p-day-end-fact-order   as decimal no-undo .
      103     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      104     if p-fact-date = ?
      105     then do:
      106       return error "Не указана фактическая дата" .
      107     end.
      108     define variable v-fact-date-num as integer no-undo .
      109     assign
      110       v-fact-date-num = integer(p-fact-date)
      111     .
      112     if p-fact-num = ?
      113     or p-fact-num = 0
      114     then do:
      115       return error "Не задан p-fact-num " + string(p-fact-num) .
      116     end.
      117     if p-fact-num < 0
      118     then do:
      119       return error "Отрицательный fact-num " + string(p-fact-num) .
      120     end.
      121     if p-fact-num >= 100000000
      122     then do:
      123       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      124     end.
      125     if p-shift-on = true
      126     then do:
      127       if p-shift-date = ?
      128       then do:
      129         return error "Не задана дата смены" .
      130       end.
      131       if p-shift-num = ?
      132       or p-shift-num = 0
      133       then do:
      134         return error "Не задан номер смены" .
      135       end.
      136     end.
      137     else do:
      138       assign
      139         p-shift-date = p-fact-date
      140         p-shift-num  = 24
      141       .
      142     end.
      143     define variable v-shift-offset as integer no-undo .
      144     if p-shift-date = p-fact-date
      145     then do:
      146       assign
      147         v-shift-offset = 1
      148       .
      149     end.
      150     if p-shift-date < p-fact-date
      151     then do:
      152       assign
      153         v-shift-offset = 0
      154       .
      155     end.
      156     if p-shift-date > p-fact-date
      157     then do:
      158       message
      159         vss-workfile vss-revision vss-description skip
      160         "Неправильная дата закрытия смены" skip
      161         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      162         view-as alert-box error .
      163       undo, return error
      164         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      165           ,string(p-fact-date, '99/99/9999':U)
      166           ,string(p-shift-date, '99/99/9999':U)
      167           )
      168       .
      169     end.
      170     if p-shift-num < 1
      171     or p-shift-num > 24
      172     then do:
      173       message
      174         vss-workfile vss-revision vss-description skip
      175         "Неправильный номер смены" skip
      176         "p-shift-num" p-shift-num skip
      177         view-as alert-box error .
      178       undo, return error return-value .
      179     end.
      180     assign
      181       p-fact-order           = v-fact-date-num
      182                              + v-shift-offset * 0.5
      183                              + p-shift-num    * 0.02 - 0.01
      184                              + p-fact-num     * 0.0000000001
      185       p-shift-end-fact-order = v-fact-date-num
      186                              + v-shift-offset * 0.5
      187                              + p-shift-num    * 0.02
      188       p-day-end-fact-order   = v-fact-date-num
      189                              + 0.99
      190     .
      191     if p-fact-order           <= v-fact-date-num
      192     or p-shift-end-fact-order <= v-fact-date-num
      193     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      194     or p-shift-end-fact-order >= p-day-end-fact-order
      195     then do:
      196       message
      197         vss-workfile vss-revision vss-description skip
      198         "Внутренняя ошибка при генерации фактического номера" skip
      199         "p-fact-date"            p-fact-date            skip
      200         "p-fact-time"            p-fact-time            skip
      201         "p-fact-num"             p-fact-num             skip
      202         "p-shift-date"           p-shift-date           skip
      203         "p-shift-num"            p-shift-num            skip
      204         "p-shift-on"             p-shift-on             skip
      205         "p-shift-end-fact-order" p-shift-end-fact-order skip
      206         "p-day-end-fact-order"   p-day-end-fact-order   skip
      207         "v-fact-date-num"        v-fact-date-num        skip
      208         view-as alert-box error .
      209       undo, return error return-value .
      210     end.
      211   end procedure.
      212   procedure day-begin-fact-order :
      213     define input  parameter p-fact-date            as date    no-undo .
      214     define output parameter p-day-begin-fact-order as decimal no-undo .
      215     do
      216     on error undo, return error return-value
      217     :
      218       if p-fact-date = ?
      219       then do:
      220         assign
      221           p-day-begin-fact-order = 0
      222         .
      223       end.
      224       else do:
      225         assign
      226           p-day-begin-fact-order = integer(p-fact-date)
      227         .
      228       end.
      229     end.
      230   end procedure.
      231   procedure factord-max-fact-order :
      232     define output parameter p-max-fact-order as decimal   no-undo .
      233     do
      234     on error undo, return error return-value
      235     :
      236       run day-begin-fact-order in this-procedure
      237         (input  date(1, 1, 5000)
      238         ,output p-max-fact-order
      239         ) .
      240     end.
      241   end procedure.
      242   procedure factord-cut-archive :
      243     define input  parameter p-obj-type             as character no-undo .
      244     define input  parameter p-obj-code             as integer   no-undo .
      245     define input  parameter p-fact-date            as date      no-undo .
      246     define output parameter p-shift-on             as logical   no-undo .
      247     define output parameter p-shift-date           as date      no-undo .
      248     define output parameter p-shift-num            as integer   no-undo .
      249     define output parameter p-day-end-fact-order   as decimal   no-undo .
      250     define output parameter p-shift-end-fact-order as decimal   no-undo .
      251     define variable v-fact-order as decimal   no-undo .
      252     define buffer buf_shift-obj for ub.shift-obj .
      253     do
      254     on error undo, return error return-value
      255     :
      256   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      258     (input  p-obj-type
      259     ,input  p-obj-code
      260     ,input  'shift-on=request'
      261     ,output p-shift-on
      262     ) no-error .
      263       if error-status :error
      264       then do:
      265         message
      266           vss-workfile vss-revision vss-description skip
      267           "Ошибка при определении атрибута объекта" skip
      268           "Объект" p-obj-type p-obj-code skip
      269           error-status :get-message(1) skip
      270           return-value skip
      271           view-as alert-box error .
      272         undo, return error return-value .
      273       end.
      274       if p-shift-on = false
      275       then do:
      276         assign
      277           p-shift-date               = ?
      278           p-shift-num                = 0
      279         .
      280       end.
      281       else do:
      282         find first buf_shift-obj share-lock
      283           where buf_shift-obj.obj-type   = p-obj-type
      284             and buf_shift-obj.obj-code   = p-obj-code
      285             and buf_shift-obj.shift-date > p-fact-date
      286           use-index pi
      287           no-error .
      288         if not available buf_shift-obj
      289         or buf_shift-obj.status_ <> 'зкр':U
      290         then do:
      291           message
      292             vss-workfile vss-revision vss-description skip
      293             "Невозможно вычислить последнюю смену" skip
      294             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      295             "Объект" p-obj-type p-obj-code skip
      296             "Дата" p-fact-date skip
      297             view-as alert-box error .
      298           undo, return error return-value .
      299         end.
      300         find last buf_shift-obj share-lock
      301           where buf_shift-obj.obj-type = p-obj-type
      302             and buf_shift-obj.obj-code = p-obj-code
      303             and buf_shift-obj.shift-date <= p-fact-date
      304           use-index pi
      305           no-error .
      306         if available buf_shift-obj
      307         then do:
      308           if  buf_shift-obj.status_ = 'зкр':U
      309           then do:
      310             assign
      311               p-shift-date = buf_shift-obj.shift-date
      312               p-shift-num  = buf_shift-obj.shift-num
      313             .
      314           end.
      315           else do:
      316             message
      317               vss-workfile vss-revision vss-description skip
      318               "Невозможно вычислить последнюю смену" skip
      319               "Статус смены отличен от статуса" 'зкр':U skip
      320               "Объект" p-obj-type p-obj-code skip
      321               "Дата" p-fact-date skip
      322               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      323               view-as alert-box error .
      324             undo, return error return-value .
      325           end.
      326         end.
      327         else do:
      328           assign
      329             p-shift-date = p-fact-date - 1
      330             p-shift-num  = 1
      331           .
      332         end.
      333       end.
      334       run factord in this-procedure
      335         (input  p-fact-date
      336         ,input  1
      337         ,input  1
      338         ,input  p-shift-date
      339         ,input  p-shift-num
      340         ,input  p-shift-on
      341         ,output v-fact-order
      342         ,output p-shift-end-fact-order
      343         ,output p-day-end-fact-order
      344         ) no-error .
      345       if error-status :error
      346       then do:
      347         message
      348           vss-workfile vss-revision vss-description skip
      349           "Ошибка при вызове процедуры factord"
      350           error-status :get-message(1) skip
      351           return-value skip
      352           view-as alert-box error .
      353         undo, return error return-value .
      354       end.
      355     end.
      356   end procedure.
      357   procedure factord-lock-shift :
      358     define input  parameter p-obj-type  as character no-undo .
      359     define input  parameter p-obj-code  as integer   no-undo .
      360     define input  parameter p-fact-date as date      no-undo .
      361     define parameter buffer buf_shift-obj for ub.shift-obj .
      362     define variable v-shift-on      as logical   no-undo .
      363     define variable v-extra-message as character no-undo .
      364     define variable v-error as character no-undo .
      365     do
      366     on error undo, return error return-value
      367     :
      368   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      370     (input  p-obj-type
      371     ,input  p-obj-code
      372     ,input  'shift-on=request'
      373     ,output v-shift-on
      374     ) no-error .
      375       if error-status :error
      376       then do:
      377         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      378         undo, return error v-error .
      379       end.
      380       if v-shift-on = true
      381       then do:
      382         find first buf_shift-obj share-lock
      383           where buf_shift-obj.obj-type   = p-obj-type
      384             and buf_shift-obj.obj-code   = p-obj-code
      385             and buf_shift-obj.shift-date > p-fact-date
      386           use-index pi
      387           no-error .
      388         if not available buf_shift-obj
      389         or buf_shift-obj.status_ <> 'зкр':U
      390         then do:
      391           find last buf_shift-obj
      392             where buf_shift-obj.obj-type = p-obj-type
      393               and buf_shift-obj.obj-code = p-obj-code
      394               and buf_shift-obj.status_  = 'зкр':U
      395             use-index stts
      396             no-error .
      397           if available buf_shift-obj
      398           then do:
      399             assign
      400               v-extra-message =
      401                     substitute("Дата начала последеней закрытой смены на объекте &1"
      402                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      403                               )
      404             .
      405           end.
      406           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      407           undo, return error v-error .
      408         end.
      409       end.
      410     end.
      411   end procedure.
      412   procedure factord-end-day :
      413     define input  parameter p-fact-date            as date    no-undo .
      414     define output parameter p-day-end-fact-order   as decimal no-undo .
      415     do
      416     on error undo, return error return-value
      417     :
      418       if p-fact-date = ?
      419       then do:
      420         return error "Не указана фактическая дата" .
      421       end.
      422       assign
      423         p-day-end-fact-order = integer(p-fact-date) + 0.99
      424       .
      425     end.
      426   end procedure.
      427   procedure factord-to-date :
      428     define input  parameter p-fact-order as decimal no-undo .
      429     define output parameter p-fact-date  as date    no-undo .
      430     define variable v-ref-date  as date      no-undo .
      431     define variable v-ref-delta as integer   no-undo .
      432     do
      433     on error undo, return error return-value
      434     :
      435       if p-fact-order = ?
      436       or p-fact-order = 0
      437       then do:
      438         return error "Не указан fact-order" .
      439       end.
      440       assign
      441         v-ref-date  = date(1, 1, 2000)
      442       .
      443       assign
      444         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      445       .
      446       assign
      447         p-fact-date = v-ref-date + v-ref-delta
      448       .
      449     end.
      450   end procedure.
      451   procedure factord-to-fact-num :
      452     define input  parameter p-fact-order as decimal no-undo .
      453     define output parameter p-fact-num   as integer no-undo .
      454     define variable v-fact-order-trunc as decimal no-undo .
      455     do
      456     on error undo, return error return-value
      457     :
      458       if p-fact-order = ?
      459       or p-fact-order = 0
      460       then do:
      461         return error "Не указан fact-order" .
      462       end.
      463       assign
      464        v-fact-order-trunc = truncate(p-fact-order, 2)
      465       .
      466       assign
      467         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      468       .
      469     end.
      470   end procedure.
      471   procedure factord-to-shift-num :
      472     define input  parameter p-fact-order as decimal no-undo .
      473     define output parameter p-shift-num   as integer no-undo .
      474     define variable  p-shift-numd  as decimal   no-undo .
      475     define variable v-fact-order-trunc as decimal no-undo .
      476     do
      477     on error undo, return error return-value
      478     :
      479       if p-fact-order = ?
      480       or p-fact-order = 0
      481       then do:
      482         return error "Не указан fact-order" .
      483       end.
      484       assign
      485        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      486       .
      487       if v-fact-order-trunc < 0.5 then do:
      488         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      489       end.
      490       assign
      491         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      492         .
      493        assign
      494         p-shift-num = truncate (p-shift-numd , 0)
      495       .
      496     end.
      497   end procedure.
      498   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   define new global shared variable g#attr-lib  as handle no-undo .
      500   define variable v-attr-lib-variable as handle no-undo .
      501   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      503   procedure thbjattr_code :
      504      define input  parameter p-upper-code     as character no-undo .
      505      define input  parameter p-code           as character no-undo .
      506      define output parameter p-label          as character no-undo .
      507      define output parameter p-user-can-edit  as logical   no-undo .
      508      define output parameter p-output-display as logical   no-undo .
      509      define output parameter p-other          as character no-undo .
      510      define output parameter p-prop-list      as character no-undo .
      511      define output parameter p-prop-type-list as character no-undo .
      512      define output parameter p-prop-label-list as character no-undo .
      513      define output parameter p-global          as logical no-undo .
      514      define output parameter p-host           as logical no-undo .
      515      define output parameter p-shop           as logical no-undo .
      516      define output parameter p-store          as logical no-undo .
      517      define output parameter p-db             as logical no-undo .
      518      define variable p-region as logical no-undo.
      519      run thbjattr_code_reg in this-procedure (
      520                                               p-upper-code,
      521                                               p-code,
      522                                               output p-label,
      523                                               output p-user-can-edit,
      524                                               output p-output-display,
      525                                               output p-other,
      526                                               output p-prop-list,
      527                                               output p-prop-type-list,
      528                                               output p-prop-label-list,
      529                                               output p-global,
      530                                               output p-host,
      531                                               output p-shop,
      532                                               output p-store,
      533                                               output p-db,
      534                                               output p-region
      535                                               ).
      536   end procedure.
