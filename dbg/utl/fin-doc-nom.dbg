      564       ,output p-prop-type-list
      565       ,output p-prop-label-list
      566       ,output p-global
      567       ,output p-host
      568       ,output p-shop
      569       ,output p-store
      570       ,output p-db
      571       ,output p-region
      572       ) no-error .
      573     if error-status :error
      574     then do:
      575       undo, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1)).
      576     end.
      577   end.
      578   end procedure.
