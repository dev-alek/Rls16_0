      789   run day-begin-fact-order in this-procedure
      790       ( input date (1,1,year(iBegDate))
      791        ,output mFactOrder
      792       ).
      793   define variable mlisttype as character no-undo.
      794   define variable mi as integer no-undo.
      795   define variable mOldYear as integer no-undo.
      796   define variable mcount as integer no-undo.
      797   define variable mValue as character no-undo.
      798   define variable mask as character no-undo.
      799   define variable v-cashbookrule-key-rec as character no-undo.
      800   define variable objKeyRec as ibs.th.gbl.keyrec no-undo.
      801   define variable objCount  as ibs.th.ref.counter.counterstorage no-undo.
      802   define buffer buf_fin-doc for fin-doc.
      803   define variable v-value-character like ub.thbj-attr.property-value-character no-undo .
      804   define variable v-value-date      like ub.thbj-attr.property-value-date no-undo .
      805   define variable v-value-decimal   like ub.thbj-attr.property-value-decimal no-undo .
      806   define variable v-value-logical   like ub.thbj-attr.property-value-logical no-undo .
      807   define variable v-value-integer   like ub.thbj-attr.property-value-integer no-undo .
      808   define variable v-recount         as logical   no-undo .
      809   define variable varcontract-type  as character no-undo .
      810   define variable v-mastc           as logical   no-undo init false .
      811       run adm/shattri.p (
      812         input "get":U
      813         ,input v-cntxt-obj-type
      814         ,input v-cntxt-obj-code
      815         ,input 'contr-in':U
      816         ,input  "contr-recount"
      817         ,output v-value-character
      818         ,output v-value-date
      819         ,output v-value-decimal
      820         ,output v-value-integer
      821         ,output v-recount
      822         ,output varcontract-type
      823         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      824         ) no-error .
      825         if error-status :error then
      826         message
      827           vss-workfile vss-revision vss-description skip
      828           error-status :get-message(1) skip
      829           return-value skip
      830           "adm/shattri.p"
      831           view-as alert-box error
      832         .
      833         if v-recount <> true then return no-apply .
      834   subscribe   to "getCounter" anywhere run-procedure "Mycounter".
      835   mlisttype = 'пко':U + "," + 'рко':U.
      836   define variable mCashBook as class ibs.th.ref.cashbookstorage no-undo.
      837   mCashBook = new ibs.th.ref.cashbookstorage () .
      838   objKeyRec = new ibs.th.gbl.keyrec().
      839   objCount  = new ibs.th.ref.counter.counterstorage().
      840   for each cashbook where CashBook.id eq ICashbook no-lock:
      841      do mi = 1 to num-entries (mlisttype):
      842         find first CashBookRule where CashBookRule.CashBookID eq cashbook.id
      843                                   and CashBookRule.Obj-type   eq v-cntxt-obj-type
      844                                   and CashBookRule.Obj-code   eq v-cntxt-obj-code
      845                                   and CashBookRule.Code       eq entry(mi,"PkoMask,RkoMask")
      846         no-lock no-error.
      847         if available CashBookRule
      848         then
      849            mask = CashBookRule.RuleValue.
      850         else
      851             mask = "[NNNN]/[obj-code]".
      852         mcount = 0.
      853         do trans:
      854            define variable mQuery as handle    no-undo.
      855            define variable vqry   as character no-undo.
      856            create query mQuery.
      857            mQuery:set-buffers(buffer fin-doc:HANDLE).
      858            define variable mShift as logical no-undo.
      859            mShift = mCashBook:getSinglRule(cashbook.id, v-cntxt-obj-type,v-cntxt-obj-code, "uchet") eq "1".
      860            if mShift
      861            then
      862               vqry = substitute("for each fin-doc where fin-doc.CashBookId   eq  &1 
      863                                                     and fin-doc.obj-type     eq '&2'
      864                                                     and fin-doc.obj-code     eq  &3
      865                                                     and fin-doc.fin-doc-type eq '&4'
      866                                                     and fin-doc.shift-date   ge  &5
      867               exclusive-lock" ,  CashBook.id ,v-cntxt-obj-type,v-cntxt-obj-code,entry(mi,mlisttype),date (1,1,year(iBegDate))).
      868            else
      869               vqry = substitute("for each fin-doc where fin-doc.CashBookId   eq  &1 
      870                                                     and fin-doc.obj-type     eq '&2'
      871                                                     and fin-doc.obj-code     eq  &3
      872                                                     and fin-doc.fin-doc-type eq '&4'
      873                                                     and fin-doc.fact-order   ge  &5
      874               exclusive-lock" ,  CashBook.id ,v-cntxt-obj-type,v-cntxt-obj-code,entry(mi,mlisttype),mFactOrder).
      875            mQuery:query-prepare(vqry).
      876            mQuery:query-open ().
      877            mQuery:get-first ().
      878            block-fin-doc:
      879            do while not mQuery:query-off-end:
      880                if not mShift
      881                then do:
      882                   if mOldYear ne year(fin-doc.fact-date)
      883                   then do:
      884                      assign
      885                         mOldYear =  year(fin-doc.fact-date)
      886                         mcount   = 0
      887                      .
      888                   end.
      889                end.
      890                else if fin-doc.shift-date eq ?
      891                then do:
      892                   next block-fin-doc.
      893                end.
      894                else if mOldYear ne year(fin-doc.shift-date)
      895                then do:
      896                   assign
      897                      mOldYear =  year(fin-doc.shift-date)
      898                      mcount   = 0
      899                   .
      900                end.
      901                run utl/maskproc.p(parparentproc, mask, "cashbook", fin-doc.CashBookId, output fin-doc.prn-doc-code).
      902               mQuery:get-next ().
      903            end.
      904            delete object mQuery.
      905            find first CashBookRule where CashBookRule.CashBookID eq cashbook.id
      906                                   and CashBookRule.Obj-type   eq v-cntxt-obj-type
      907                                   and CashBookRule.Obj-code   eq v-cntxt-obj-code
      908                                   and CashBookRule.Code       eq entry(mi,"currPko,currRko")
      909         no-lock no-error.
      910            objKeyRec:GenKeyRec ( input 'CashBookRule':U
      911                                               ,input buffer ub.cashbookrule:handle
      912                                               ,output v-cashbookrule-key-rec).
      913           find first clients where clients.obj-type eq cashbookrule.obj-type
      914                                and clients.obj-code eq cashbookrule.obj-code
      915                                no-lock no-error.
      916            if     available clients
      917               and clients.db-num ne ?
      918            then
      919               objcount:SetCountValue(clients.db-num,"cashbookrule",v-cashbookrule-key-rec,if mi eq 1 then "currPKO" else "currRKO",mcount).
      920         end.
      921      end.
      922   end.
      923   delete object objKeyRec.
      924   delete object objCount.
      925   delete object mCashBook.
      926   unsubscribe to "getCounter".
      927    procedure Mycounter:
      928   define input  parameter iFileName as character no-undo.
      929   define input  parameter ikey      as character no-undo.
      930   define input  parameter icode     as character no-undo.
      931   define output parameter oCount    as int64 no-undo.
      932   assign
      933      mcount = mcount + 1
      934      oCount = mcount
      935   .
      936   end procedure.
