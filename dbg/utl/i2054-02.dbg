       61   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       62   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       63   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       64   define variable vss-workfile    as character no-undo init "$Workfile: i2054-02.p $":U .
       65   define variable vss-archive     as character no-undo init "$Archive: utl/i2054-02.p $":U .
       66   define variable vss-description as character no-undo init "Импорт из внешней системы DKLink документов типа 2".
       67   procedure vss-get-info :
       68     define output parameter p-vss-revision    like vss-revision    no-undo .
       69     define output parameter p-vss-author      like vss-author      no-undo .
       70     define output parameter p-vss-date        like vss-date        no-undo .
       71     define output parameter p-vss-workfile    like vss-workfile    no-undo .
