      798   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   function octal-to-char return character
      800   ( p-string as character ) :
      801     def var v-asc     as integer no-undo .
      802     def var v-new-asc as integer no-undo .
      803     def var ind       as integer no-undo .
      804     if length(p-string) <> 3 then do:
      805       return ? .
      806     end.
      807     assign
      808       v-asc = 0
      809     .
      810     do ind = 1 to length(p-string)
      811     :
      812       assign
      813         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      814       .
      815       if v-new-asc < 0 or v-new-asc >= 8 then do:
      816         return ? .
      817       end.
      818       assign
      819         v-asc = v-asc * 8 + v-new-asc
      820       .
      821     end.
      822     return chr(v-asc) .
      823   end function .
      824   function char-to-octal return character
      825   ( p-chr as character ) :
      826     def var v-asc    as integer   no-undo .
      827     def var ind      as integer   no-undo .
      828     def var v-string as character no-undo .
      829     if length(p-chr) <> 1 then do:
      830       return ? .
      831     end.
      832     assign
      833       v-asc    = asc(p-chr)
      834       v-string = ""
      835     .
      836     do ind = 1 to 3
      837     :
      838       assign
      839         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      840       .
      841       assign
      842         v-asc = truncate(v-asc / 8, 0)
      843       .
      844     end.
      845     return v-string .
      846   end.
      847   function str-encode return character
      848   (   p-init-string       as character
      849     , p-encode-char       as character
      850     , p-special-char-list as character
      851   ) :
      852     def var p-encode-string as character no-undo .
      853     def var ind                as integer no-undo .
      854     def var v-num-special-char as integer no-undo .
      855     def var v-special-char     as character no-undo .
      856     if p-encode-char = ?
      857     or p-encode-char = "" then do:
      858       assign
      859         p-encode-char = "~~"
      860       .
      861     end.
      862     if p-init-string = ? then do:
      863       return "?" .
      864     end.
      865     if p-init-string = "?" then do:
      866       return p-encode-char + char-to-octal("?") .
      867     end.
      868     assign
      869       v-num-special-char = length(p-special-char-list)
      870       p-encode-string    = replace(p-init-string
      871                                   ,p-encode-char
      872                                   ,p-encode-char + char-to-octal(p-encode-char)
      873                                   )
      874     .
      875     do ind = 1 to v-num-special-char
      876     :
      877       assign
      878         v-special-char = substring(p-special-char-list, ind, 1)
      879       .
      880       if v-special-char <> p-encode-char then do:
      881         assign
      882           p-encode-string = replace (p-encode-string
      883                                     ,v-special-char
      884                                     ,p-encode-char + char-to-octal(v-special-char)
      885                                     )
      886         .
      887       end.
      888     end.
      889     return p-encode-string .
      890   end.
      891   function str-decode returns character
      892     (p-init-string   as character
      893     ,p-encode-char   as character
      894     ) :
      895     def var p-decode-string as character no-undo .
      896     def var ind                       as integer no-undo .
      897     def var v-num-entries-init-string as integer no-undo .
      898     def var v-sub-phrase              as character no-undo .
      899     def var v-special-char            as character no-undo .
      900     if p-encode-char = ?
      901     or p-encode-char = "" then do:
      902       assign
      903         p-encode-char = "~~"
      904       .
      905     end.
      906     if p-init-string = "?" then do:
      907       return ? .
      908     end.
      909     assign
      910       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      911     .
      912     if v-num-entries-init-string > 1 then do:
      913       assign
      914         p-decode-string = entry(1, p-init-string, p-encode-char)
      915       .
      916       do ind = 2 to v-num-entries-init-string
      917       :
      918         assign
      919           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      920         .
      921         assign
      922           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      923         .
      924         if v-special-char <> ? then do:
      925           assign
      926             p-decode-string = p-decode-string
      927                             + v-special-char
      928                             + substring(v-sub-phrase, 4)
      929           .
      930         end.
      931         else do:
      932           assign
      933             p-decode-string = p-decode-string
      934                             + p-encode-char
      935                             + v-sub-phrase
      936           .
      937         end.
      938       end.
      939     end.
      940     else do:
      941       assign
      942         p-decode-string = p-init-string
      943       .
      944     end.
      945     return p-decode-string .
      946   end.
      947   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      949   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      950     field cst-code                like ub.trn-doc.cst-code
      951     field part-code               like ub.parts.part-code
      952     .
      953   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      954   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      955   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      956   function hvrdtax return logical (input parrecid as recid):
      957   define variable varresult as logical no-undo.
      958   run hvrdtax-proc (input parrecid, output varresult).
      959   return varresult.
      960   end function.
      961   procedure hvrdtax-proc:
      962   define input  parameter parrecid  as recid   no-undo.
      963   define output parameter parresult as logical no-undo.
      964   define buffer bf_goods for ub.goods.
      965   define buffer bf_units for ub.units.
      966   define buffer rt_tax   for ub.tax.
      967   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      968   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      969   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      970   if available rt_tax and
      971       can-find(first ub.tax-units No-LOCK WHERE
      972                      ub.tax-units.tax-code = rt_tax.tax-code AND
      973                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      974                                                       else assign parresult = no.
      975   end procedure.
      976   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   define new global shared variable g#lib-calc as handle no-undo .
      978   procedure plgdsfnd :
      979     define input  parameter p-chk-and-chs    as logical               no-undo .
      980     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      981     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      982     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      983     define output parameter p-reserv-pl-code as   logical             no-undo .
      984     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      985     define buffer buf_goods         for ub.goods .
      986     define buffer buf_pl-gds        for ub.pl-gds .
      987     define buffer buf_second_pl-gds for ub.pl-gds .
      988     find first buf_goods no-lock where
      989                buf_goods.gds-code = p-gds-code no-error .
      990     if not available buf_goods
      991     then do:
      992       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      993     end.
      994   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      995   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      996     (input  p-obj-type
      997     ,input  p-obj-code
      998     ,input  buf_goods.artic
      999     ,input  buf_goods.prod-type
     1000     ,input  buf_goods.prod-code
     1001     ,input  'place-rsrv=request'
     1002     ,output p-reserv-pl-code
     1003     ) no-error .
     1004     if error-status :error
     1005     then do:
     1006       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1007     end.
     1008     if p-reserv-pl-code = no
     1009     then do:
     1010       return .
     1011     end.
     1012     if p-chk-and-chs <> yes
     1013     then do:
     1014       return .
     1015     end.
     1016     find first buf_pl-gds no-lock where
     1017                buf_pl-gds.obj-type = p-obj-type and
     1018                buf_pl-gds.obj-code = p-obj-code and
     1019                buf_pl-gds.gds-code = p-gds-code no-error .
     1020     if not available buf_pl-gds
     1021     then do:
     1022       return error "К товару не привязано ни одного места хранения" .
     1023     end.
     1024     find first buf_second_pl-gds no-lock where
     1025                buf_second_pl-gds.obj-type  = p-obj-type          and
     1026                buf_second_pl-gds.obj-code  = p-obj-code          and
     1027                buf_second_pl-gds.gds-code  = p-gds-code          and
     1028                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1029     if not available buf_second_pl-gds
     1030     then do:
     1031       assign
     1032         p-pl-code = buf_pl-gds.pl-code
     1033       .
     1034     end.
     1035     else do:
     1036       if not valid-handle( parparentproc )
     1037       then do:
     1038         return error "Не выбрано место хранения " + chr(10) .
     1039       end.
     1040       run str/plgdssel.p
     1041         (
     1042            input parparentproc
     1043         ,  input p-obj-type
     1044         ,  input p-obj-code
     1045         ,  input p-gds-code
     1046         , output p-pl-code
     1047         ) no-error .
     1048       if error-status :error
     1049       then do:
     1050         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1051                                , 'plgdssel.p':U
     1052                                , chr(10)
     1053                                , error-status :get-message( 1 )
     1054                                , return-value
     1055                                ) .
     1056       end.
     1057       if p-pl-code = ? or
     1058          p-pl-code = 0
     1059       then do:
     1060         return error "Не выбрано место хранения " + chr(10) .
     1061       end.
     1062     end.
     1063   end procedure.
     1064   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1066   define temp-table tt-doc-line no-undo like ub.doc-line
     1067   field cst-code like ub.trn-doc.cst-code
     1068   .
     1069   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1070   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1071   define temp-table tt-parts    no-undo like ub.parts.
     1072   procedure lib-trn_copy-inqu :
     1073   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1074   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1075   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1076   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1077   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1078   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1079   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1080   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1081   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1082   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1083   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1084   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1085   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1086   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1087   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1088   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1089   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1090   define input parameter parinp-discnt-type as   logical                no-undo.
     1091   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1092   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1093   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1094   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1095   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1096   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1097   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1098   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1099   define input parameter table for tt-doc-line.
     1100   define input parameter table for tt-gds-dtl.
     1101   define input parameter table for tt-parts.
     1102   define input parameter paruse-parts       as   logical                no-undo.
     1103   define input parameter parall-qnty        as   logical                no-undo.
     1104   define input parameter parfix-price       as   logical                no-undo.
     1105   define buffer crt_trn-doc  for ub.trn-doc.
     1106   define buffer crt_goods    for ub.goods.
     1107   define buffer crt_doc-line for ub.doc-line.
     1108   define buffer crt_gds-dtl  for ub.gds-dtl.
     1109   define variable end-price    as   logical              no-undo.
     1110   define variable real-type    like ub.goods.gds-type    no-undo.
     1111   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1112   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1113   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1114   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1115   define variable g-log        as   logical              no-undo.
     1116   define variable mem-qnty like chg-qnty no-undo.
     1117   define variable dflt-cd as character no-undo .
     1118   c-l:
     1119   do on error undo, return error return-value :
     1120   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1121   assign
     1122       paruse-parts = false
     1123       .
     1124   assign
     1125     end-price = no.
     1126   if parinp-discnt-type = yes and
     1127      parinp-discnt-pc   = 0   and
     1128      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1129      then do:
     1130     assign
     1131       crt_trn-doc.tot-calc    = partot-calc
     1132       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1133       crt_trn-doc.discnt-type = pardiscnt-type.
     1134   end.
     1135   if parinp-agnt = ? then do:
     1136     assign
     1137       crt_trn-doc.agnt = paragnt.
     1138   end.
     1139   if parinp-boss = ? then do:
     1140     assign
     1141       crt_trn-doc.boss = parboss.
     1142   end.
     1143   if parinp-wrkr = ? then do:
     1144     assign
     1145       crt_trn-doc.wrkr = parwrkr.
     1146   end.
     1147   if parinp-base-rate  = ? then do:
     1148     assign
     1149       crt_trn-doc.base-rate  = parbase-rate.
     1150   end.
     1151   if parinp-base-scale = ? then do:
     1152     assign
     1153       crt_trn-doc.base-scale = parbase-scale.
     1154   end.
     1155   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1156   if available tt-doc-line then do:
     1157     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1158                      and crt_goods.prod-type = tt-doc-line.prod-type
     1159                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1160     if crt_goods.gds-type = 'у':U and
     1161        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1162       return error "В данный документ нельзя копировать услуги.".
     1163     end.
     1164     assign
     1165       real-type = crt_goods.gds-type.
     1166     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1167     if available crt_doc-line then do:
     1168       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1169                        and crt_goods.prod-type = crt_doc-line.prod-type
     1170                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1171       if crt_goods.gds-type <> real-type then do:
     1172         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1173       end.
     1174     end.
     1175     else do:
     1176       assign
     1177         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1178     end.
     1179   end.
     1180   r-l:
     1181   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1182     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1183                      and crt_goods.prod-type = tt-doc-line.prod-type
     1184                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1185   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1186      (
     1187       input crt_trn-doc.doc-code
     1188      ,input crt_trn-doc.obj-type
     1189      ,input crt_trn-doc.obj-code
     1190      ,input crt_goods.artic
     1191      ,input crt_goods.prod-type
     1192      ,input crt_goods.prod-code
     1193      ,input crt_goods.gds-name
     1194      ,input crt_goods.prt-root
     1195      ,input ?
     1196      ,input ?
     1197      ,input parcash-pay      ) no-error.
     1198     if error-status:error then do:
     1199       undo c-l, return error return-value.
     1200     end.
     1201     if return-value = "next" then do:
     1202       next r-l.
     1203     end.
     1204     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1205                                   crt_doc-line.artic     = crt_goods.artic      and
     1206                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1207                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1208     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1209                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1210                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1211                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1212                               break by tt-gds-dtl.artic
     1213                                     by tt-gds-dtl.prod-type
     1214                                     by tt-gds-dtl.prod-code
     1215                               :
     1216   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1217     ( input  tt-gds-dtl.artic
     1218      ,input  tt-gds-dtl.prod-type
     1219      ,input  tt-gds-dtl.prod-code
     1220      ,input  tt-gds-dtl.prt-code
     1221      ,input  tt-doc-line.obj-type
     1222      ,input  tt-doc-line.obj-code
     1223      ,output legal-node
     1224     ) no-error .
     1225       if error-status:error then do:
     1226          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1227       end.
     1228   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1229     ( input crt_trn-doc.obj-code
     1230      ,input crt_trn-doc.obj-type
     1231      ,input crt_trn-doc.doc-code
     1232      ,input crt_goods.artic
     1233      ,input crt_goods.prod-code
     1234      ,input crt_goods.prod-type
     1235      ,input legal-node
     1236      ,input yes
     1237     ) no-error .
     1238        if error-status:error then do:
     1239           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1240        end.
     1241        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1242                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1243                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1244                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1245                                     crt_gds-dtl.prt-code  = legal-node.
     1246       assign
     1247         crt_gds-dtl.ov             = parfix-price
     1248         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1249         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1250         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1251         .
     1252       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1253         assign
     1254           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1255           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1256           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1257           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1258       end.
     1259       if end-price then do:
     1260         assign
     1261           crt_gds-dtl.ov             = yes
     1262           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1263           crt_gds-dtl.discnt-base    = 0
     1264           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1265           crt_gds-dtl.discnt-rubl    = 0
     1266           crt_gds-dtl.discnt-pc      = 0
     1267           crt_gds-dtl.discnt-type    = yes.
     1268       end.
     1269   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1270   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1271     ( input recid(crt_gds-dtl)
     1272     , input no
     1273     , input ?
     1274     ) no-error.
     1275           if error-status:error then do:
     1276             undo c-l, return error return-value.
     1277           end.
     1278       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1279          crt_gds-dtl.ov then do:
     1280         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1281       end.
     1282       if paruse-parts then do:
     1283          if first-of (tt-gds-dtl.prod-code) then do:
     1284            for each tt-parts :
     1285              assign
     1286                chg-qnty = tt-parts.fact-qnty
     1287                mem-qnty = chg-qnty.
     1288              assign
     1289              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1290              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1291            end.
     1292            assign
     1293              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1294              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1295            assign
     1296              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1297              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1298            if crt_gds-dtl.doc-qnty = 0 then do:
     1299              delete crt_gds-dtl.
     1300            end.
     1301          end.
     1302       end.
     1303       else do:
     1304         assign
     1305           chg-qnty = tt-gds-dtl.fact-qnty
     1306           mem-qnty = chg-qnty.
     1307         assign
     1308           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1309           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1310           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1311           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1312         assign
     1313         varchg-qnty  = varchg-qnty  + chg-qnty
     1314         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1315         if crt_gds-dtl.doc-qnty = 0 then do:
     1316           delete crt_gds-dtl.
     1317         end.
     1318       end.
     1319     end.
     1320     if crt_doc-line.doc-qnty = 0 then do:
     1321       delete crt_doc-line.
     1322     end.
     1323   end.
     1324   end.
     1325   end procedure.
     1326   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1327     define variable v-cntxt-db-num        as integer   no-undo .
     1328     define variable v-cntxt-userid        as character no-undo .
     1329     define variable v-cntxt-level         as character no-undo .
     1330     define variable v-cntxt-host-code-obj as integer   no-undo .
     1331     define variable v-cntxt-obj-type      as character no-undo .
     1332     define variable v-cntxt-obj-code      as integer   no-undo .
     1333     define variable v-cntxt-db-num-obj    as integer   no-undo .
