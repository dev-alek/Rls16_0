     3115                                   , input  buf_trn-doc.obj-code
     3116                                   , input  'rt-trn-doc':U
     3117                                   , input  'wrkr':U
     3118                                   , output v-value-character
     3119                                   , output v-value-date
     3120                                   , output v-value-decimal
     3121                                   , output v-value-integer
     3122                                   , output v-value-logical
     3123                                   , output v-param-type
     3124                                   , input-output table-handle v-tth
     3125                                   ) no-error .
     3126                 delete object v-tth.
     3127                 if  v-value-integer <> ?
     3128                 then do:
     3129                   assign
     3130                     buf_trn-doc.wrkr = v-value-integer
     3131                   .
     3132                 end.
     3133               end.
     3134               if buf_trn-doc.agnt = ?
     3135               then do:
     3136                 run adm/shattri.p ( input "get":U
     3137                                   , input  buf_trn-doc.obj-type
     3138                                   , input  buf_trn-doc.obj-code
     3139                                   , input  'rt-trn-doc':U
     3140                                   , input  'agnt':U
     3141                                   , output v-value-character
     3142                                   , output v-value-date
     3143                                   , output v-value-decimal
     3144                                   , output v-value-integer
     3145                                   , output v-value-logical
     3146                                   , output v-param-type
     3147                                   , input-output table-handle v-tth
     3148                                   ) no-error .
     3149                 delete object v-tth.
     3150                 if  v-value-integer <> ?
     3151                 then do:
     3152                   assign
     3153                     buf_trn-doc.agnt = v-value-integer
     3154                   .
     3155                 end.
     3156               end.
     3157               if buf_trn-doc.boss = ?
     3158               then do:
     3159                 run adm/shattri.p ( input "get":U
     3160                                   , input  buf_trn-doc.obj-type
     3161                                   , input  buf_trn-doc.obj-code
     3162                                   , input  'rt-trn-doc':U
     3163                                   , input  'boss':U
     3164                                   , output v-value-character
     3165                                   , output v-value-date
     3166                                   , output v-value-decimal
     3167                                   , output v-value-integer
     3168                                   , output v-value-logical
     3169                                   , output v-param-type
     3170                                   , input-output table-handle v-tth
     3171                                   ) no-error .
     3172                 delete object v-tth.
     3173                 if  v-value-integer <> ?
     3174                 then do:
     3175                   assign
     3176                     buf_trn-doc.boss = v-value-integer
     3177                   .
     3178                 end.
     3179               end.
     3180               run gbl/calc-trn.p ( input this-procedure
     3181                                  , input parrec-doc
     3182                                  ) no-error .
     3183               if error-status :error
     3184               then do:
     3185                 assign
     3186                   v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value)
     3187                 .
     3188                 run pcall-log-file in p-log-handle ( input v-end-message ) .
     3189                 undo _save-block, return error v-end-message .
     3190               end.
     3191               assign
     3192                 v-k = v-k + 1
     3193               .
     3194             end.
     3195             otherwise do:
     3196               assign
     3197                 v-end-message = substitute( "Документ &1 имеет недопустимый расширеный тип: &2"
     3198                                           , v-doc-code
     3199                                           , v-ext-doc-type
     3200                                           )
     3201               .
     3202               run pcall-log-file in p-log-handle ( input v-end-message ) .
     3203               undo _save-block, return error v-end-message.
     3204             end.
     3205           end case.
     3206         end.
     3207         otherwise do:
     3208           assign
     3209             v-end-message = substitute( "Документ &1 имеет недопустимый расширеный тип: &2"
     3210                                       , v-doc-code
     3211                                       , v-ext-doc-type
     3212                                       )
     3213           .
     3214           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3215           undo _save-block, return error v-end-message.
     3216         end.
     3217       end case.
     3218     end.
     3219     assign
     3220       p-ok-doc = p-ok-doc + v-k
     3221     .
     3222     run clear-tt in this-procedure .
     3223   end.
     3224   procedure clear-tt :
     3225     do
     3226     on error undo, return error return-value
     3227     :
     3228      for each tt-trn-doc:
     3229       delete tt-trn-doc.
     3230      end.
     3231       for each tt2-doc-line :
     3232           delete tt2-doc-line .
     3233       end.
     3234       for each tt-doc-line :
     3235           delete tt-doc-line .
     3236       end.
     3237       for each tt-gds-dtl :
     3238           delete tt-gds-dtl .
     3239       end.
     3240       for each tt-parts:
     3241           delete tt-parts .
     3242       end.
     3243       for each lib-trn_ret-doc :
     3244         delete lib-trn_ret-doc.
     3245       end.
     3246       for each lib-trn_ret-line :
     3247         delete lib-trn_ret-line      .
     3248       end.
     3249       for each lib-trn_ret-line-attr :
     3250         delete lib-trn_ret-line.
     3251       end.
     3252       for each lib-trn_ret-dtl :
     3253         delete lib-trn_ret-dtl.
     3254       end.
     3255       for each lib-trn_ret-parts :
     3256         delete lib-trn_ret-parts .
     3257       end.
     3258       empty temp-table tt-goods.
     3259    end.
     3260   end procedure.
     3261   procedure clos-trn :
     3262     do
     3263     on error undo, return error return-value
     3264     :
     3265   define input parameter p-trn-code as character no-undo .
     3266   define buffer buf_s-trn-doc for ub.trn-doc.
     3267   define variable varmode            as   character           no-undo.
     3268   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3269   define variable varflag            like ub.trn-doc.flag     no-undo.
     3270   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3271   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3272   define variable varcheck-return as logical no-undo .
     3273   define variable varchg-inv as logical no-undo .
     3274   assign
     3275     varmode         = '<закрытие документа>':U
     3276     varstatus       = 'запрос':U
     3277     varflag         = true
     3278     varcopystatus   = 'новый':U
     3279     varcopyflag     = false
     3280     varcheck-return = true
     3281     varchg-inv      = true
     3282     .
     3283   run str/trn-graf.p
     3284     ( input  p-trn-code ,
     3285       input  v-cntxt-db-num ,
     3286       input  varmode ,
     3287       output varstatus ,
     3288       output varflag ,
     3289       output varcopystatus ,
     3290       output varcopyflag
     3291     ) no-error .
     3292       if error-status:error then do :
     3293           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3294           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3295           undo, return error v-end-message.
     3296       end.
     3297   run str/trn-stat.p (
     3298       input  parparentproc ,
     3299       input  this-procedure ,
     3300       input  varmode,
     3301       input  p-trn-code,
     3302       input  varcheck-return,
     3303       input  v-cntxt-db-num,
     3304       input  v-cntxt-in-ov,
     3305       input  v-cntxt-rsrv-time,
     3306       input  v-cntxt-load-time,
     3307       input  v-cntxt-holidays,
     3308       input  NO,
     3309       output varchg-inv,
     3310       output table gds-list)
     3311       no-error.
     3312       if error-status:error then do :
     3313           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3314           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3315           undo, return error v-end-message.
     3316       end.
     3317     end.
     3318   end procedure.
     3319   procedure clos-trn2 :
     3320   define input parameter p-trn-code as character no-undo .
     3321     do
     3322     on error undo, return error return-value
     3323     :
     3324   define buffer buf_s-trn-doc for ub.trn-doc.
     3325   define variable varmode            as   character           no-undo.
     3326   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3327   define variable varflag            like ub.trn-doc.flag     no-undo.
     3328   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3329   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3330   define variable varcheck-return as logical no-undo .
