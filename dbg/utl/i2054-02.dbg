     1445   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1446   procedure thdl-prc_map-obj :
     1447     define input  parameter p-obj-type  as character no-undo .
     1448     define input  parameter p-obj-code  as integer   no-undo .
     1449     define output parameter p-code      as integer   no-undo .
     1450     define buffer buf_store   for ub.store.
     1451     define buffer buf_shop    for ub.shop.
     1452     define buffer buf_clients for ub.clients.
     1453   do for
     1454     buf_store
     1455   , buf_shop
     1456   , buf_clients
     1457   on error undo, return error return-value
     1458   :
     1459     assign
     1460       p-code = ?
     1461     .
     1462     case p-obj-type
     1463     :
     1464       when 'маг':U
     1465       then do:
     1466         find first buf_shop no-lock
     1467           where buf_shop.obj-code = p-obj-code
     1468         no-error .
     1469         if not available buf_shop
     1470         then do:
     1471           return error substitute( "Не найден магазин с кодом:&1":U , p-obj-code ) .
     1472         end.
     1473         assign
     1474           p-code = buf_shop.obj-code
     1475         .
     1476       end.
     1477       when 'скл':U
     1478       then do:
     1479         find first buf_store no-lock
     1480           where buf_store.obj-code = p-obj-code
     1481         no-error .
     1482         if not available buf_store
     1483         then do:
     1484           return error substitute( "Не найден склад с кодом:&1":U , p-obj-code ) .
     1485         end.
     1486         assign
     1487           p-code = 100000 + buf_store.obj-code
     1488         .
     1489       end.
     1490       when 'чел':U
     1491       then do:
     1492         find first buf_clients no-lock
     1493           where buf_clients.obj-type = p-obj-type
     1494             and buf_clients.obj-code = p-obj-code
     1495         no-error .
     1496         if not available buf_clients
     1497         then do:
     1498           return error substitute( "Не найден контрагент &1 &2" , p-obj-type, p-obj-code ) .
     1499         end.
     1500         assign
     1501           p-code = buf_clients.obj-code
     1502         .
     1503       end.
     1504       when 'орг':U
     1505       then do:
     1506         find first buf_clients no-lock
     1507           where buf_clients.obj-type = p-obj-type
     1508             and buf_clients.obj-code = p-obj-code
     1509         no-error .
     1510         if not available buf_clients
     1511         then do:
     1512           return error substitute( "Не найден контрагент &1 &2" , p-obj-type, p-obj-code ) .
     1513         end.
     1514         assign
     1515           p-code = 1000000000 + buf_clients.obj-code
     1516         .
     1517       end.
     1518       otherwise do:
     1519         return error substitute( "Недопустимый тип контрагента:&1":U , p-obj-type ).
     1520       end.
     1521     end case.
     1522   end.
     1523   end procedure.
     1524   procedure thdl-prc_unmap-store :
     1525     define input  parameter p-code      as integer   no-undo .
     1526     define output parameter p-obj-type  as character no-undo .
     1527     define output parameter p-obj-code  as integer   no-undo .
     1528     define buffer buf_store   for ub.store.
     1529     define buffer buf_shop    for ub.shop.
     1530     define variable v-code as integer   no-undo .
     1531   do for
     1532     buf_store
     1533   , buf_shop
     1534   on error undo, return error return-value
     1535   :
     1536     assign
     1537       p-obj-type = ?
     1538       p-obj-code = ?
     1539     .
     1540     if p-code > 100000
     1541     then do :
     1542       assign
     1543         v-code = p-code - 100000
     1544       .
     1545       find first buf_store no-lock
     1546         where buf_store.obj-code = v-code
     1547       no-error .
     1548       if not available buf_store
     1549       then do:
     1550         return .
     1551       end.
     1552       assign
     1553         p-obj-type = 'скл':U
     1554         p-obj-code = buf_store.obj-code
     1555       .
     1556     end.
     1557     else do:
     1558       find first buf_shop no-lock
     1559         where buf_shop.obj-code = p-code
     1560       no-error .
     1561       if not available buf_shop
     1562       then do:
     1563         return .
     1564       end.
     1565       assign
     1566         p-obj-type = 'маг':U
     1567         p-obj-code = buf_shop.obj-code
     1568       .
     1569     end.
     1570   end.
     1571   end procedure.
     1572   procedure thdl-prc_unmap-agent :
     1573     define input  parameter p-code      as integer   no-undo .
     1574     define output parameter p-obj-type  as character no-undo .
     1575     define output parameter p-obj-code  as integer   no-undo .
     1576     define variable v-code as integer   no-undo .
     1577     define buffer buf_clients for ub.clients.
     1578   do for
     1579     buf_clients
     1580   on error undo, return error return-value
     1581   :
     1582     assign
     1583       p-obj-type = ?
     1584       p-obj-code = ?
     1585     .
     1586     if p-code > 1000000000
     1587     then do:
     1588       assign
     1589         v-code = p-code - 1000000000
     1590       .
     1591       find first buf_clients no-lock
     1592         where buf_clients.obj-type = 'орг':U
     1593           and buf_clients.obj-code = v-code
     1594       no-error .
     1595       if not available buf_clients
     1596       then do:
     1597         return .
     1598       end.
     1599       assign
     1600         p-obj-type = 'орг':U
     1601         p-obj-code = buf_clients.obj-code
     1602       .
     1603     end.
     1604     else do:
     1605       find first buf_clients no-lock
     1606         where buf_clients.obj-type = 'чел':U
     1607           and buf_clients.obj-code = p-code
     1608       no-error .
     1609       if not available buf_clients
     1610       then do:
     1611         return .
     1612       end.
     1613       assign
     1614         p-obj-type = 'чел':U
     1615         p-obj-code = buf_clients.obj-code
     1616       .
     1617     end.
     1618   end.
     1619   end procedure.
     1620   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1621   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1622   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1623   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1624   ASSIGN
     1625      v-S_CONTRACT                = "Contract":U
     1626      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1627      v-DELIM_CHR_3               = ","
     1628      .
     1629   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1630   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1631   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1632   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1633      INPUT iHost-Code    AS INTEGER,
     1634      INPUT iContract-Num AS INTEGER,
     1635      INPUT iGds-Code     AS INTEGER ):
     1636      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1637      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1638      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1639      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1640      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1641      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1642          INPUT  iHost-Code,
     1643          INPUT  iContract-Num,
     1644          OUTPUT iTmp-Extent3
     1645          ).
     1646      IF iTmp-Extent3[1] = 2 THEN DO:
     1647         ASSIGN
     1648            iTmp-Host-Code      = iTmp-Extent3[2]
     1649            iTmp-Contract-Num   = iTmp-Extent3[3]
     1650            .
     1651      END. ELSE DO:
     1652         ASSIGN
     1653            iTmp-Host-Code      = iHost-Code
     1654            iTmp-Contract-Num   = iContract-Num
     1655            .
     1656      END.
     1657      IF iGds-Code = ? THEN DO:
     1658         ASSIGN
     1659            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1660                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1661                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1662                           ).
     1663      END. ELSE DO:
     1664            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1665                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1666                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1667                              AND buf_Spec.Gds-Code      = iGds-Code
     1668                            ).
     1669      END.
     1670      RETURN (lRet).
     1671   END FUNCTION.
     1672   PROCEDURE MS-Contract-EXTENT-3:
     1673      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1674      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1675      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1676      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1677      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1678      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1679      FIND FIRST buf_Cont-2 WHERE
     1680                 buf_Cont-2.Host-Code      = i-Host-Code
     1681             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1682           NO-LOCK NO-ERROR.
     1683      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1684         RETURN.
     1685      END.
     1686      FOR FIRST buf_Ext-Classif WHERE
     1687                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1688           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1689                                               STRING(i-Contract-code)
     1690           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1691          NO-LOCK,
     1692          EACH buf_Cont WHERE
     1693               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1694           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1695          NO-LOCK:
     1696          ASSIGN
     1697             i-Ret[1] = 1
     1698             i-Ret[2] = buf_Cont.Host-code
     1699             i-Ret[3] = buf_Cont.Contract-code
     1700             .
     1701          LEAVE.
     1702      END.
     1703      IF i-Ret[1] <> 1 THEN DO:
     1704         FOR FIRST buf_Ext-Classif WHERE
     1705                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1706              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1707                                                  STRING(i-Contract-code)
     1708              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1709             NO-LOCK,
     1710             EACH buf_Cont WHERE
     1711                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1712              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1713             NO-LOCK:
     1714             ASSIGN
     1715                i-Ret[1] = 2
     1716                i-Ret[2] = buf_Cont.Host-code
     1717                i-Ret[3] = buf_Cont.Contract-code
     1718                .
     1719             LEAVE.
     1720         END.
     1721      END.
     1722      RETURN.
     1723   END PROCEDURE.
