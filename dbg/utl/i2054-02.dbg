     3354   procedure mainmenu_getcntxt :
     3355   define output parameter p-cntxt-db-num                as integer   no-undo .
     3356   define output parameter p-cntxt-userid                as character no-undo .
     3357   define output parameter p-cntxt-level                 as character no-undo .
     3358   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
     3359   define output parameter p-cntxt-obj-type              as character no-undo .
     3360   define output parameter p-cntxt-obj-code              as integer   no-undo .
     3361   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
     3362   define output parameter p-cntxt-is-admin              as logical   no-undo .
     3363     do
     3364     on error undo, return error return-value
     3365     :
     3366   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3367   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3368     (input  vt-obj-type
     3369     ,input  vt-obj-code
     3370     ,output p-cntxt-db-num-obj
     3371     )  .
     3372     assign
     3373       p-cntxt-db-num          =  v-cntxt-db-num
     3374       p-cntxt-userid          =  v-cntxt-userid
     3375       p-cntxt-level           =  v-cntxt-level
     3376       p-cntxt-host-code-obj   =  vt-host-code
     3377       p-cntxt-obj-type        =  vt-obj-type
     3378       p-cntxt-obj-code        =  vt-obj-code
     3379       p-cntxt-is-admin        =  v-cntxt-is-admin
     3380     .
     3381     end.
     3382    end procedure.
     3383    procedure get-report-num :
     3384     define output parameter p-report-num as integer no-undo .
     3385      do
     3386      on error undo, return error return-value
     3387      :
     3388       assign
     3389         p-report-num = 1
     3390       .
     3391      end.
     3392    end procedure.
     3393   procedure add-nn1 :
     3394     define input  parameter p-doc-code as character no-undo .
     3395   do
     3396   on error undo, return error return-value
     3397   :
     3398     find first ub.doc-attr exclusive-lock
     3399       where ub.doc-attr.doc-code = p-doc-code
     3400         and ub.doc-attr.attr-code = 'clcasol':U
     3401     no-error .
     3402     if not available ub.doc-attr then create ub.doc-attr.
     3403     assign
     3404       ub.doc-attr.doc-code = p-doc-code
     3405       ub.doc-attr.attr-code = 'clcasol':U
     3406       ub.doc-attr.attr-value =  "yes"
     3407     .
     3408   end.
     3409   end procedure.
     3410   procedure cb_is-silent :
     3411   define output parameter p-silent as logical   no-undo .
     3412     do
     3413     on error undo, return error return-value
     3414     :
     3415      p-silent = true .
     3416     end.
     3417   end procedure.
