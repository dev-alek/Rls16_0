     3337       input  false  ,
     3338       input  v-cntxt-db-num,
     3339       input  false ,
     3340       input  v-cntxt-rsrv-time,
     3341       input  v-cntxt-load-time,
     3342       input  v-cntxt-holidays,
     3343       input  false ,
     3344       output varchg-inv ,
     3345       output table gds-list)
     3346       no-error.
     3347       if error-status:error then do :
     3348           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3349           run pcall-log-file in p-log-handle ( input v-end-message ) .
