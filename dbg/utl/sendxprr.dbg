        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: sendxprr.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/sendxprr.p $":U .
       11   define variable vss-description as character no-undo init "Пакет рассылки на кассы IBM-XML файла параметров".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   function prepare-path returns character ( input p-nonprepared-path as character ):
       83   define variable v-prepared-path as character no-undo .
       84   assign
       85   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
       86   v-prepared-path = right-trim(v-prepared-path, chr(47))
       87   .
       88   return v-prepared-path.
       89   END FUNCTION.
       90   function prepare-path2 returns character ( input p-nonprepared-path as character ):
       91   define variable v-prepared-path as character no-undo .
       92   assign
       93   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
       94   v-prepared-path = right-trim(v-prepared-path, chr(92))
       95   .
       96   return v-prepared-path.
       97   END FUNCTION.
       98   function quote-spaces returns character ( input p-full-path as character):
       99   define variable v-ii as integer no-undo .
      100   define variable v-result as character no-undo .
      101   do v-ii = 1 to num-entries(p-full-path, chr(92)):
      102     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
      103                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
      104                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
      105                else entry(v-ii, p-full-path, chr(92))
      106                )
      107     .
      108   end.
      109   return v-result.
      110   end function.
      111   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   procedure gen-key-rec :
      113     define input  parameter p-tbl-name    as character no-undo.
      114     define input  parameter p-bh_tbl-name as handle    no-undo.
      115     define output parameter p-key-rec     as character no-undo.
      116     do
      117     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      118     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      119     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      120     :
      121       define variable fh               as handle    no-undo .
      122       define variable v-ok             as logical   no-undo .
      123       define variable v-inform         as character no-undo .
      124       define variable v-ind            as integer   no-undo .
      125       define variable v-idx-field-qnty as integer   no-undo .
      126       if p-tbl-name = ?
      127         or p-tbl-name = "":U
      128       then do:
      129         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      130       end.
      131       if not p-bh_tbl-name:available then do:
      132         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      133       end.
      134       assign
      135         p-key-rec = p-tbl-name
      136         v-inform  = p-bh_tbl-name:index-information(1)
      137         v-ind     = 2
      138       .
      139       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      140       on error undo, return error
      141       :
      142         assign
      143           v-inform = p-bh_tbl-name:index-information( v-ind )
      144           v-ind    = v-ind + 1
      145         .
      146       end.
      147       if v-inform = ?
      148         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      149         or entry( 3, v-inform, ",":U ) <> "1":U
      150       then do:
      151         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      152       end.
      153       else do:
      154         assign
      155           v-idx-field-qnty = num-entries( v-inform ) - 4
      156         .
      157         if v-idx-field-qnty < 2 then do:
      158           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      159         end.
      160         do v-ind = 1 to v-idx-field-qnty by 2
      161         on error undo, return error
      162         :
      163           assign
      164             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      165             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      166           .
      167         end.
      168       end.
      169       if p-key-rec = ? then do:
      170         assign
      171           p-key-rec = "":U
      172         .
      173         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      174       end.
      175     end.
      176     return.
      177   end procedure.
      178   procedure gen-where-keyr-tab :
      179     define input  parameter i-tableSerach as character no-undo.
      180     define input  parameter i-tablekey   as character  no-undo.
      181     define input  parameter p-key-rec    as character  no-undo.
      182     define input  parameter p-key-handle as handle     no-undo .
      183     define input  parameter p-db-name    as character  no-undo .
      184     define input  parameter p-tt-handle  as handle     no-undo .
      185     define output parameter o-Where      as character  no-undo.
      186     do
      187     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      188     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      189     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      190     :
      191       define variable v-full-tbl-name  as character no-undo .
      192       define variable bh_tbl-name      as handle    no-undo .
      193       define variable fh_key           as handle    no-undo .
      194       define variable fh_search        as handle    no-undo .
      195       define variable v-field-num      as integer   no-undo .
      196       define variable v-count-fld      as integer   no-undo .
      197       define variable v-inform         as character no-undo .
      198       define variable v-ind            as integer   no-undo .
      199       define variable v-idx-field-qnty as integer   no-undo .
      200       define variable v-field-name     as character no-undo .
      201       define variable v-field-val      as character no-undo .
      202       define variable v-word-link      as character no-undo .
      203       define variable vTable           as character no-undo.
      204       define variable bh_tbl-key       as handle    no-undo .
      205       assign
      206         p-key-rec = trim( p-key-rec )
      207       .
      208       if p-key-handle <> ? then do:
      209         if not valid-handle(p-key-handle)
      210            or p-key-handle:type <> "buffer"
      211         then do:
      212           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      213         end.
      214         if num-entries( p-key-rec, chr(3) ) > 1
      215           or p-key-rec = ?
      216           or p-key-rec = "":U
      217         then do:
      218           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      219         end.
      220       end.
      221       else do:
      222         if p-key-rec = ?
      223           or p-key-rec = "":U
      224         then do:
      225           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      226         end.
      227       end.
      228       assign
      229         vTable = entry( 1 , p-key-rec, chr(3) )
      230       .
      231       if p-tt-handle <> ?
      232         and ( not valid-handle(p-tt-handle)
      233               or p-tt-handle:type <> "buffer"
      234             )
      235       then do:
      236         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      237       end.
      238       if p-tt-handle = ? then do:
      239         assign
      240           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      241         .
      242         create buffer bh_tbl-name for table v-full-tbl-name .
      243       end.
      244       else do:
      245         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      246       end.
      247       assign
      248         v-inform = bh_tbl-name:index-information(1)
      249         v-ind    = 2
      250       .
      251       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      252       on error undo, return error
      253       :
      254         assign
      255           v-inform = bh_tbl-name:index-information( v-ind )
      256           v-ind    = v-ind + 1
      257         .
      258       end.
      259       if v-inform = ?
      260         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      261         or entry( 3, v-inform, ",":U ) <> "1":U
      262       then do:
      263         delete object bh_tbl-name no-error.
      264         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      265       end.
      266       assign
      267         v-idx-field-qnty = num-entries( v-inform ) - 4
      268       .
      269       if v-idx-field-qnty < 2 then do:
      270         delete object bh_tbl-name no-error.
      271         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      272       end.
      273       assign
      274         o-where     = "where":U
      275         v-word-link = "":U
      276         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      277         v-count-fld = 0
      278       .
      279       if i-tablekey ne "" and i-tablekey ne ?
      280       then do:
      281         assign
      282           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      283         .
      284         create buffer bh_tbl-key for table v-full-tbl-name .
      285       end.
      286       if i-tableSerach ne "" and i-tableSerach ne ?
      287       then do:
      288         delete object bh_tbl-name no-error.
      289         assign
      290           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      291         .
      292         create buffer bh_tbl-name for table v-full-tbl-name .
      293       end.
      294       block_where:
      295       do v-ind = 1 to v-idx-field-qnty by 2
      296       on error undo, return error
      297       :
      298         assign
      299           v-count-fld = v-count-fld + 1
      300         .
      301         if p-key-handle = ?
      302           and v-count-fld > v-field-num
      303         then do:
      304           leave block_where.
      305         end.
      306         define variable VfieldKeyTable as handle no-undo.
      307         assign
      308           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      309           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      310         .
      311         if     bh_tbl-key ne ?
      312         then do:
      313            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      314            if VfieldKeyTable eq ?
      315            then next block_where.
      316         end.
      317         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      318         then
      319            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      320         else
      321            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      322         if p-key-handle = ? then do:
      323           assign
      324             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      325           .
      326         end.
      327         else do:
      328           assign
      329             fh_key = p-key-handle:buffer-field( v-field-name )
      330           .
      331           if fh_key = ?
      332             or not valid-handle( fh_key )
      333           then do:
      334             delete object bh_tbl-name.
      335             if     bh_tbl-key ne ?
      336             then
      337                delete object bh_tbl-key.
      338             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      339           end.
      340           assign
      341             v-field-val = fh_key:buffer-value
      342           .
      343         end.
      344         if fh_search:data-type ="character":U then do:
      345           assign
      346             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      347             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      348             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      349             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      350             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      351             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      352             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      353             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      354             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      355             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      356             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      357             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      358             v-field-val = substitute( '"&1"', v-field-val )
      359           .
      360         end.
      361         assign
      362           o-where = substitute( "&1 &2", o-where, v-field-val )
      363         .
      364         if v-word-link = "":U then do:
      365           assign
      366             v-word-link = "and":U
      367           .
      368         end.
      369       end.
      370       delete object bh_tbl-name.
      371       if     bh_tbl-key ne ?
      372       then
      373          delete object bh_tbl-key.
      374       if p-key-handle = ?
      375         and v-count-fld <> v-field-num
      376       then do:
      377         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      378       end.
      379     end.
      380   end procedure.
      381   procedure gen-hn-keyr-tab :
      382     define input  parameter i-tableSerach as character no-undo.
      383     define input  parameter i-tablekey   as character no-undo.
      384     define input  parameter p-key-rec    as character no-undo.
      385     define input  parameter p-key-handle as handle    no-undo .
      386     define input  parameter p-db-name    as character no-undo .
      387     define input  parameter p-tt-handle  as handle    no-undo .
      388     define input  parameter p-stts-lock  as integer   no-undo .
      389     define output parameter o-hn         as handle    no-undo.
      390     define variable v-full-tbl-name as character no-undo.
      391     define variable v-where         as character no-undo.
      392     define variable bh_tbl-name     as handle    no-undo.
      393     define variable vTable          as character no-undo.
      394     do
      395     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      396     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      397     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      398         run gen-where-keyr-tab(i-tableSerach,
      399                                i-tablekey,
      400                                p-key-rec,
      401                                p-key-handle,
      402                                p-db-name,
      403                                p-tt-handle,
      404                                output v-where).
      405         if i-tableSerach ne "" and i-tableSerach ne ?
      406         then do:
      407            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      408            create buffer bh_tbl-name for table v-full-tbl-name .
      409         end.
      410         else do:
      411            if p-tt-handle = ? then do:
      412               assign
      413                  vTable = entry( 1 , p-key-rec, chr(3) )
      414               .
      415               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      416               create buffer bh_tbl-name for table v-full-tbl-name .
      417            end.
      418            else do:
      419               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      420            end.
      421         end.
      422         if p-tt-handle = ? then do:
      423            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      424         end.
      425         else do:
      426            bh_tbl-name:find-first( v-where ) no-error .
      427         end.
      428         o-hn = bh_tbl-name.
      429      end.
      430   end procedure.
      431   procedure gen-hn-keyr :
      432     define input  parameter p-key-rec    as character no-undo.
      433     define input  parameter p-key-handle as handle    no-undo .
      434     define input  parameter p-db-name    as character no-undo .
      435     define input  parameter p-tt-handle  as handle    no-undo .
      436     define input  parameter p-stts-lock  as integer   no-undo .
      437     define output parameter o-hn         as handle    no-undo.
      438     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      439   end.
      440   procedure gen-row-keyr :
      441     define input  parameter p-key-rec    as character no-undo.
      442     define input  parameter p-key-handle as handle    no-undo .
      443     define input  parameter p-db-name    as character no-undo .
      444     define input  parameter p-tt-handle  as handle    no-undo .
      445     define input  parameter p-stts-lock  as integer   no-undo .
      446     define output parameter p-tbl-row    as rowid     no-undo.
      447     define output parameter p-tbl-name   as character no-undo.
      448     define variable vHn as handle no-undo.
      449       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      450       p-tbl-row = if vHn:available then vHn:rowid else ?.
      451       p-tbl-name =  vHn:table.
      452       delete object vHn no-error.
      453     if p-tbl-row = ? then do:
      454       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      455     end.
      456     else do:
      457       return.
      458     end.
      459   end procedure.
      460   procedure gen-key-fv :
      461     define input  parameter p-key-rec    as character no-undo .
      462     define output parameter p-field-list as character no-undo .
      463     define output parameter p-value-list as character no-undo.
      464     do
      465     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      466     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      467     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      468     :
      469       define variable v-full-tbl-name  as character no-undo .
      470       define variable bh_tbl-name      as handle    no-undo .
      471       define variable v-tbl-name       as character no-undo .
      472       define variable v-field-num      as integer   no-undo .
      473       define variable v-count-fld      as integer   no-undo .
      474       define variable v-inform         as character no-undo .
      475       define variable v-ind            as integer   no-undo .
      476       define variable v-idx-field-qnty as integer   no-undo .
      477       define variable v-delim-key      as character no-undo .
      478       if p-key-rec = ?
      479         or p-key-rec = "":U
      480       then do:
      481         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      482       end.
      483       assign
      484         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      485         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      486       .
      487       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      488       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      489       assign
      490         v-inform = bh_tbl-name:index-information(1)
      491         v-ind    = 2
      492       .
      493       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      494       on error undo, return error
      495       :
      496         assign
      497           v-inform = bh_tbl-name:index-information( v-ind )
      498           v-ind    = v-ind + 1
      499         .
      500       end.
      501       if v-inform = ?
      502         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      503         or entry( 3, v-inform, ",":U ) <> "1":U
      504       then do:
      505         delete object bh_tbl-name no-error.
      506         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      507       end.
      508       assign
      509         v-idx-field-qnty = num-entries( v-inform ) - 4
      510       .
      511       if v-idx-field-qnty < 2 then do:
      512         delete object bh_tbl-name no-error.
      513         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      514       end.
      515       assign
      516         p-field-list = "":U
      517         p-value-list = "":U
      518         v-delim-key  = "":U
      519         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      520         v-count-fld  = 0
      521       .
      522       block_where:
      523       do v-ind = 1 to v-idx-field-qnty by 2
      524       on error undo, return error
      525       :
      526         assign
      527           v-count-fld = v-count-fld + 1
      528         .
      529         if v-count-fld > v-field-num then do:
      530           leave block_where.
      531         end.
      532         assign
      533           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      534           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      535         .
      536         if v-ind = 1 then do:
      537           assign
      538             v-delim-key = chr(3)
      539           .
      540         end.
      541       end.
      542       delete object bh_tbl-name.
      543       if v-count-fld <> v-field-num then do:
      544         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      545       end.
      546     end.
      547   end procedure.
      548   procedure gen-key-field :
      549     define input  parameter p-table      as character no-undo .
      550     define output parameter p-field-list as character no-undo .
      551     do
      552     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      553     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      554     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      555     :
      556       define variable v-full-tbl-name  as character no-undo .
      557       define variable bh_tbl-name      as handle    no-undo .
      558       define variable v-tbl-name       as character no-undo .
      559       define variable v-field-num      as integer   no-undo .
      560       define variable v-count-fld      as integer   no-undo .
      561       define variable v-inform         as character no-undo .
      562       define variable v-ind            as integer   no-undo .
      563       define variable v-idx-field-qnty as integer   no-undo .
      564       define variable v-delim-key      as character no-undo .
      565       if p-table = ?
      566         or p-table = "":U
      567       then do:
      568         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      569       end.
      570       assign
      571         v-tbl-name      = p-table
      572         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      573       .
      574       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      575       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      576       assign
      577         v-inform = bh_tbl-name:index-information(1)
      578         v-ind    = 2
      579       .
      580       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      581       on error undo, return error
      582       :
      583         assign
      584           v-inform = bh_tbl-name:index-information( v-ind )
      585           v-ind    = v-ind + 1
      586         .
      587       end.
      588       if v-inform = ?
      589         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      590         or entry( 3, v-inform, ",":U ) <> "1":U
      591       then do:
      592         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      593       end.
      594       assign
      595         v-idx-field-qnty = num-entries( v-inform ) - 4
      596       .
      597       if v-idx-field-qnty < 2 then do:
      598         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      599       end.
      600       assign
      601         p-field-list = "":U
      602         v-delim-key  = "":U
      603         v-count-fld  = 0
      604       .
      605       block_where:
      606       do v-ind = 1 to v-idx-field-qnty by 2
      607       on error undo, return error
      608       :
      609         assign
      610           v-count-fld = v-count-fld + 1
      611         .
      612         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      613         if v-ind = 1 then do:
      614           assign
      615             v-delim-key = chr(3)
      616           .
      617         end.
      618       end.
      619       delete object bh_tbl-name.
      620     end.
      621   end procedure.
      622   define variable p-path as character no-undo .
      623   define variable v-view-log as logical no-undo .
      624   define variable log-file-name as character no-undo init "sendxprr.txt".
      625   define variable p-mode as character no-undo .
      626   define variable v-cash-desk-uniq-key-rec as character no-undo .
      627   define variable v-ext-file-uniq-key-rec as character no-undo .
      628   define variable v-parameter as character no-undo .
      629   define variable action as character no-undo .
      630   define temp-table tt-cash-desk no-undo like ub.cash-desk.
      631   define buffer buf_tt-cash-desk for tt-cash-desk.
      632   define buffer buf2_tt-cash-desk for tt-cash-desk.
      633   define new shared temp-table tt-ext-file no-undo like ub.ext-file.
      634   define new shared temp-table tt-db       no-undo like ub.db.
      635   define new shared temp-table tt-ext-file-par no-undo like ub.ext-file-par.
      636   define buffer buf_tt-db for tt-db.
      637   define buffer buf_tt-ext-file for tt-ext-file.
      638   define buffer buf_db for ub.db.
      639   define temp-table rtt-ext-file no-undo like ub.ext-file.
      640   define buffer buf_rtt-ext-file for rtt-ext-file.
      641   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      643   procedure cur-time :
      644      define output parameter p-today as date      no-undo .
      645      define output parameter p-time  as integer   no-undo .
      646     do
      647     on error undo, return error
      648     :
      649       define variable v-date1 as date      no-undo .
      650       define variable v-date2 as date      no-undo .
      651       define variable v-time  as integer   no-undo .
      652       assign
      653         v-date1 = today
      654         v-time  = time
      655         v-date2 = today
      656       .
      657       if v-date1 <> v-date2
      658       then do:
      659         assign
      660           v-date1 = today
      661           v-time  = v-time
      662         .
      663       end.
      664       assign
      665         p-today = v-date1
      666         p-time  = v-time
      667       .
      668     end.
      669   end.
      670   function cur-time-date returns character
      671   :
      672     return string(today, '99/99/9999':U) .
      673   end.
      674   function cur-time-mjd returns decimal
      675   :
      676     define variable v-date as date      no-undo .
      677     define variable v-time as integer   no-undo .
      678     run cur-time in this-procedure
      679       (output v-date
      680       ,output v-time
      681       ) .
      682     return integer(v-date) - 2400002 + (v-time / 86400) .
      683   end.
      684   function cur-time-get-ending-index returns integer
      685   (input p-number as integer
      686   )
      687   :
      688     if p-number < 0
      689     or p-number = ?
      690     then do:
      691       return 1 .
      692     end.
      693     define variable v-rest as integer   no-undo .
      694     assign
      695       p-number = p-number modulo 100
      696     .
      697     if p-number < 20
      698     then do:
      699       assign
      700         v-rest = p-number
      701       .
      702     end.
      703     else do:
      704       assign
      705         v-rest = p-number modulo 10
      706       .
      707     end.
      708     case v-rest :
      709       when 1
      710       then do:
      711         return 2 .
      712       end.
      713       when 2 or
      714       when 3 or
      715       when 4
      716       then do:
      717         return 3 .
      718       end.
      719       otherwise do:
      720         return 1 .
      721       end.
      722     end case .
      723   end.
      724   procedure cur-time-mjd-to-date :
      725      define input  parameter i-mjd-diff as decimal no-undo.
      726      define output parameter o-Date     as date    no-undo.
      727      define output parameter o-Time     as integer no-undo.
      728      define variable v-day-number as integer   no-undo .
      729      if    i-mjd-diff < 0
      730         or i-mjd-diff = ?
      731      then do:
      732         return "?" .
      733      end.
      734      assign
      735         v-day-number = truncate(i-mjd-diff,0).
      736         o-Date = date(v-day-number + 2400002).
      737         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      738     .
      739   end.
      740   function cur-time-mjd-to-string returns character
      741   (input p-mjd-diff as decimal
      742   )
      743   :
      744     define variable v-day-number as integer   no-undo .
      745     define variable v-seconds    as integer   no-undo .
      746     define variable v-hour       as integer   no-undo .
      747     define variable v-min        as integer   no-undo .
      748     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      749     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      750     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      751     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      752     if p-mjd-diff < 0
      753     or p-mjd-diff = ?
      754     then do:
      755       return "?" .
      756     end.
      757     assign
      758       v-day-number = integer(truncate(p-mjd-diff,0))
      759       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      760     .
      761     if v-seconds > 86400
      762     then do:
      763       assign
      764         v-seconds = 86400 - 1
      765       .
      766     end.
      767     if v-seconds < 0
      768     then do:
      769       assign
      770         v-seconds = 0
      771       .
      772     end.
      773     assign
      774       v-hour = truncate(v-seconds / 3600, 0)
      775     .
      776     assign
      777       v-seconds = v-seconds modulo 3600
      778     .
      779     assign
      780       v-min = truncate(v-seconds / 60, 0)
      781     .
      782     assign
      783       v-seconds = v-seconds modulo 60
      784     .
      785     return
      786         (if v-day-number <> 0
      787           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      788           else ""
      789         )
      790       + (if v-day-number <> 0 or v-hour <> 0
      791           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      792           else ""
      793         )
      794       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      795           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      796           else ""
      797         )
      798       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      799       .
      800   end.
      801   function cur-time-string returns character
      802   :
      803     define variable v-date as date      no-undo .
      804     define variable v-time as integer   no-undo .
      805     run cur-time in this-procedure
      806       (output v-date
      807       ,output v-time
      808       ) .
      809     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      810   end.
      811   function cur-time-string-sec returns character
      812   :
      813     define variable v-date as date      no-undo .
      814     define variable v-time as integer   no-undo .
      815     run cur-time in this-procedure
      816       (output v-date
      817       ,output v-time
      818       ) .
      819     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      820   end.
      821   function cur-time-custom  returns character
      822   (input p-prefix as character
      823   ,input p-date-format as character
      824   ,input p-delimiter as character
      825   ,input p-time-format as character
      826   ,input p-suffix as character
      827   )
      828   :
      829     define variable v-date as date      no-undo .
      830     define variable v-time as integer   no-undo .
      831     run cur-time in this-procedure
      832       (output v-date
      833       ,output v-time
      834       ) .
      835     return
      836       p-prefix
      837       + string(v-date, p-date-format)
      838       + p-delimiter
      839       + string(v-time, p-time-format)
      840       + p-suffix
      841       .
      842   end.
      843   function cur-time-print  returns character
      844   :
      845     define variable v-date as date      no-undo .
      846     define variable v-time as integer   no-undo .
      847     run cur-time in this-procedure
      848       (output v-date
      849       ,output v-time
      850       ) .
      851     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      852   end.
      853   function cur-time-datetime returns datetime
      854   :
      855     define variable v-char as character no-undo .
      856     define variable v-datetime as datetime no-undo .
      857     v-char = cur-time-string().
      858     v-datetime = datetime(v-char).
      859     return  v-datetime.
      860   end.
      861   function cur-time-string-msec returns character
      862   :
      863     define variable v-date as datetime  no-undo .
      864     v-date = now.
      865     return string(v-date) .
      866   end.
      867   procedure bintrn_create-file-record :
      868   define input parameter p-path as character no-undo .
      869   define input parameter p-file-type as character no-undo .
      870   define input parameter p-obj-type as character no-undo .
      871   define input parameter p-obj-code as integer no-undo .
      872   define output parameter p-full-name as character no-undo .
      873   define variable v-full-path        as character no-undo .
      874   define variable v-path             as character no-undo .
      875   define variable v-file-name        as character no-undo .
      876   define variable v-file-name-no-ext as character no-undo .
      877   define variable v-file-name-ext    as character no-undo .
      878   DEFINE VARIABLE v-md5-signature AS CHARACTER NO-undo.
      879   DEFINE VARIABLE v-today as date no-undo .
      880   DEFINE VARIABLE v-time as integer no-undo .
      881   define variable v-full-path2        as character no-undo .
      882   define buffer buf_tt-ext-file for tt-ext-file.
      883   do
      884   on error undo, return error
      885   :
      886     run gbl/filename.p (
      887                     input  p-path
      888                   ,output v-full-path
      889                   ,output v-path
      890                   ,output v-file-name
      891                   ,output v-file-name-no-ext
      892                   ,output v-file-name-ext
      893                   ) no-error .
      894     if error-status:error  = yes then do:
      895       undo, return  substitute("Ошибка при поиске файла &1:&2&3&2&4"
      896                                 , p-path
      897                                 , chr(10)
      898                                 , error-status:get-message(1)
      899                                 , return-value ).
      900     end.
      901     assign
      902     v-full-path = prepare-path(v-full-path).
      903     v-full-path2 = prepare-path2(v-full-path).
      904     define variable v-unc as character no-undo .
      905     run gbl/get-unc.p ( input v-full-path2, output v-unc) no-error.
      906     if not error-status :error then do:
      907       assign
      908       v-full-path2 = v-unc.
      909     end.
      910     file-info:FILE-NAME = v-full-path.
      911     run gbl/md5.p (
      912         input  v-full-path
      913       ,output v-md5-signature
      914       ) no-error.
      915     if error-status:error then do:
      916       undo, return substitute("Ошибка при выполнении подсчета КС файла &1&2" +
      917                   "&3&2&4"
      918                   , v-full-path
      919                   , chr(10)
      920                   , error-status:get-message(1)
      921                   , return-value ).
      922     end.
      923     run cur-time in this-procedure ( output v-today, output v-time).
      924     create buf_tt-ext-file.
      925     ASSIGN
      926     buf_tt-ext-file.FILE-NAME = v-full-path
      927     buf_tt-ext-file.FILE-NAME-exec = v-full-path2
      928     buf_tt-ext-file.file-num = 1
      929     buf_tt-ext-file.create-sys-date      = file-info:FILE-mod-DATE
      930     buf_tt-ext-file.create-sys-time      = STRING(file-info:FILE-mod-TIME, "HH:MM:SS")
      931     buf_tt-ext-file.create-sys-time-INT  = file-info:FILE-mod-TIME
      932     buf_tt-ext-file.update-sys-date      = v-today
      933     buf_tt-ext-file.update-sys-time      = STRING(v-time, "HH:MM:SS")
      934     buf_tt-ext-file.update-sys-time-INT  = v-time
      935     buf_tt-ext-file.file-size            = FILE-INFO:FILE-SIZE
      936     buf_tt-ext-file.crc-field            = v-md5-signature
      937     buf_tt-ext-file.file-type            = p-file-type
      938     .
      939     release buf_tt-ext-file.
      940     p-full-name = v-full-path.
      941   end.
      942   end procedure.
      943   assign
      944   p-path          = entry(1, p-parameter, chr(4))
      945   action          = entry(2, p-parameter, chr(4))
      946   no-error
      947   .
      948   if error-status:error then do:
      949     run write-log-and-file in p-log-handle (
      950           input 1
      951         , input log-file-name
      952         , input 1
      953         , input substitute("!!!Ошибка входных параметров &1:&2&3&4"
      954                            , p-parameter
      955                            , chr(10)
      956                            , error-status:get-message(1)
      957                            , return-value
      958                            )).
      959     assign
      960     v-view-log = yes.
      961   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962   if v-view-log
      963   and not g#news
      964   and not g#auto
      965   then do:
      966     message
      967     '!!!При пересылке/сохранении файлов произошли ошибки!!!'  skip
      968     "!!!Внимательно прочитайте Log-file!!"
      969     view-as alert-box error .
      970        define variable v-user-action5   as character no-undo .
      971     define variable v-printed5       as logical   no-undo .
      972     run gbl/prnfilen.w
      973       (input  ('!!!При пересылке/сохранении файлов произошли ошибки!!!')
      974       ,input  0
      975       ,input  (string("./":U) + log-file-name)
      976       ,input  7
      977       ,output v-user-action5
      978       ,output v-printed5
      979       ) .
      980   end.
      981   if v-view-log = true
      982   and (g#news
      983   or g#auto)
      984   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      985   then do:
      986      run cb_set-view-log in p-parent-handle ( input yes).
      987   end.
      988   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      989     OS-DELETE value(string("./":U) + log-file-name).
      990   end.
      991                           return.
      992   end.
      993   run cb_get-cash-desk-list in p-parent-handle ( input this-procedure:handle) no-error.
      994   if error-status:error then do:
      995     run write-log-and-file in p-log-handle (
      996           input 1
      997         , input log-file-name
      998         , input 1
      999         , input substitute("!!!Ошибка входных параметров &1:&2&3&4"
     1000                            , p-parameter
     1001                            , chr(10)
     1002                            , error-status:get-message(1)
     1003                            , return-value
     1004                            )).
     1005     assign
     1006     v-view-log = yes.
     1007   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   if v-view-log
     1009   and not g#news
     1010   and not g#auto
     1011   then do:
     1012     message
     1013     '!!!При пересылке/сохранении файлов произошли ошибки!!!'  skip
     1014     "!!!Внимательно прочитайте Log-file!!"
     1015     view-as alert-box error .
     1016        define variable v-user-action7   as character no-undo .
     1017     define variable v-printed7       as logical   no-undo .
     1018     run gbl/prnfilen.w
     1019       (input  ('!!!При пересылке/сохранении файлов произошли ошибки!!!')
     1020       ,input  0
     1021       ,input  (string("./":U) + log-file-name)
     1022       ,input  7
     1023       ,output v-user-action7
     1024       ,output v-printed7
     1025       ) .
     1026   end.
     1027   if v-view-log = true
     1028   and (g#news
     1029   or g#auto)
     1030   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1031   then do:
     1032      run cb_set-view-log in p-parent-handle ( input yes).
     1033   end.
     1034   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1035     OS-DELETE value(string("./":U) + log-file-name).
     1036   end.
     1037                           return.
     1038   end.
     1039   for each tt-db:
     1040    delete tt-db.
     1041   end.
     1042   for each tt-ext-file:
     1043     delete tt-ext-file.
     1044   end.
     1045   for each tt-ext-file-par:
     1046     delete tt-ext-file-par.
     1047   end.
     1048   define variable v-unc-file-name as character no-undo .
     1049   run bintrn_create-file-record in this-procedure ( input p-path
     1050                                                   , input 'cash-desk':U + chr(3)
     1051                                                   , input ''
     1052                                                   , input 0
     1053                                                   , output v-unc-file-name
     1054                                                   ) no-error.
     1055   if error-status:error then do:
     1056       return error.
     1057   end.
     1058   main-block:
     1059   for each buf_tt-cash-desk
     1060   break
     1061   by buf_tt-cash-desk.db-num
     1062   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1063   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1064   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1065   :
     1066     if first-of(buf_tt-cash-desk.db-num) then do:
     1067       find first buf_db no-lock where
     1068                 buf_db.db-num = buf_tt-cash-desk.db-num.
     1069       create buf_tt-db.
     1070       buffer-copy buf_db to buf_tt-db.
     1071       release buf_tt-db.
     1072       if buf_db.db-num = g#db-num then do:
     1073         p-mode = 'save-this-db':U.
     1074       end.
     1075       else do:
     1076         p-mode = 'save-db':U.
     1077       end.
     1078       run nws/sndfnwr.p ( input parparentproc
     1079                           ,input this-procedure:handle
     1080                           ,input p-log-handle
     1081                           ,input (p-mode + chr(4) +
     1082                                   string(0) + chr(4) +
     1083                                   p-path + chr(4) +
     1084                                   ''   )) no-error.
     1085       find first buf_tt-db where buf_tt-db.db-num = buf_tt-cash-desk.db-num.
     1086       delete buf_tt-db.
     1087     end.
     1088   end.
     1089   main-block:
     1090   for each buf_tt-cash-desk
     1091   break
     1092   by buf_tt-cash-desk.db-num
     1093   by buf_tt-cash-desk.obj-code
     1094   by buf_tt-cash-desk.pos-type
     1095   by buf_tt-cash-desk.cash-num
     1096   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1097   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1098   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1099   :
     1100     if first-of(buf_tt-cash-desk.db-num) then do:
     1101       find first buf_rtt-ext-file no-lock where
     1102                 buf_rtt-ext-file.db-num = buf_tt-cash-desk.db-num no-error.
     1103       if not available buf_rtt-ext-file then do:
     1104               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось отослать файл параметров &1 в БД &2", p-path, buf_tt-cash-desk.db-num)).
     1105       end.
     1106       else do:
     1107         assign
     1108         v-ext-file-uniq-key-rec = ''.
     1109           run gen-key-rec in this-procedure ( input 'ext-file':U
     1110                                             ,input (buffer buf_rtt-ext-file:handle)
     1111                                             ,output v-ext-file-uniq-key-rec) no-error.
     1112               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Отсылка файла параметров &1 на кассы БД &2", p-path, buf_tt-cash-desk.db-num)).
     1113         for each buf2_tt-cash-desk where
     1114                 buf2_tt-cash-desk.db-num = buf_tt-cash-desk.db-num
     1115         by buf2_tt-cash-desk.db-num
     1116         by buf2_tt-cash-desk.obj-code
     1117         by buf2_tt-cash-desk.pos-type
     1118         by buf2_tt-cash-desk.cash-num
     1119         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1120         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1121         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1122         :
     1123            assign
     1124            v-cash-desk-uniq-key-rec = ''.
     1125            run gen-key-rec in this-procedure ( input 'cash-desk':U
     1126                                               ,input (buffer buf2_tt-cash-desk:handle)
     1127                                               ,output v-cash-desk-uniq-key-rec) no-error.
     1128            assign
     1129            v-parameter = v-cash-desk-uniq-key-rec + chr(4) +
     1130                          v-ext-file-uniq-key-rec + chr(4) +
     1131                          action .
     1132            if buf2_tt-cash-desk.db-num = g#db-num then do:
     1133               run str/send-xpr.p ( input parparentproc
     1134                                   ,input this-procedure:handle
     1135                                   ,input p-log-handle
     1136                                   ,input v-parameter ) no-error.
     1137              if error-status:error then do:
     1138                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалась отсылка файла параметров &1 на касссу &2:&3&4&3&5"                                           , p-path                                           , v-cash-desk-uniq-key-rec                                           , chr(10)                                           , error-status:get-message(1)                                           , return-value )).
     1139              end.
     1140            end.
     1141            else do:
     1142               run nws/cr-route.p (
     1143                             input 'send-cmd':U
     1144                             ,input "command" + chr(1) +
     1145                                    "run-file" + chr(1) + "str/send-xpr.p" + chr(1) + v-parameter
     1146                             ,input ?
     1147                             ,input string(buf_tt-cash-desk.db-num)
     1148                             ) no-error .
     1149               if error-status:error then do:
     1150                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалась команда отсылки файла параметров &1 на касссу &2:&3&4&3&5"                                           , p-path                                           , v-cash-desk-uniq-key-rec                                           , chr(10)                                           , error-status:get-message(1)                                           , return-value )).
     1151               end.
     1152            end.
     1153         end.
     1154       end.
     1155     end.
     1156   end.
     1157   procedure cb_set-cash-desk-list :
     1158   define input parameter p-db-num as integer no-undo .
     1159   define input parameter p-obj-code as integer no-undo .
     1160   define input parameter p-pos-type as character no-undo .
     1161   define input parameter p-cash-num as integer no-undo .
     1162   define input parameter p-version as character no-undo .
     1163   define buffer buf_tt-cash-desk for tt-cash-desk.
     1164   do
     1165   on error undo, return error
     1166   :
     1167     find first buf_tt-cash-desk where
     1168               buf_tt-cash-desk.db-num = p-db-num
     1169          and  buf_tt-cash-desk.obj-code = p-obj-code
     1170          and  buf_tt-cash-desk.pos-type = p-pos-type
     1171          and  buf_tt-cash-desk.cash-num = p-cash-num no-error.
     1172     if not available buf_tt-cash-desk then do:
     1173       create buf_tt-cash-desk.
     1174       assign
     1175       buf_tt-cash-desk.db-num = p-db-num
     1176       buf_tt-cash-desk.obj-code = p-obj-code
     1177       buf_tt-cash-desk.pos-type = p-pos-type
     1178       buf_tt-cash-desk.cash-num = p-cash-num
     1179       buf_tt-cash-desk.version = p-version
     1180       .
     1181       release buf_tt-cash-desk.
     1182     end.
     1183   end.
     1184   end procedure.
     1185   procedure cb_set-ext-file_file-num :
     1186   define input parameter p-db-num as integer no-undo .
     1187   define input parameter p-from-db-num as integer no-undo .
     1188   define input parameter p-file-num as integer no-undo .
     1189   define buffer buf_tt-ext-file for tt-ext-file.
     1190   define buffer buf_rtt-ext-file for rtt-ext-file.
     1191   do
     1192   on error undo, return error
     1193   :
     1194     find first buf_tt-ext-file.
     1195     find first buf_rtt-ext-file where
     1196               buf_rtt-ext-file.db-num = p-db-num
     1197           and buf_rtt-ext-file.from-db-num = p-from-db-num
     1198           and buf_rtt-ext-file.file-num = p-file-num no-error.
     1199     if not available buf_rtt-ext-file then do:
     1200       create buf_rtt-ext-file.
     1201       buffer-copy buf_tt-ext-file
     1202       except db-num from-db-num file-num
     1203       to buf_rtt-ext-file
     1204       assign
     1205       buf_rtt-ext-file.db-num = p-db-num
     1206       buf_rtt-ext-file.from-db-num = p-from-db-num
     1207       buf_rtt-ext-file.file-num = p-file-num
     1208       .
     1209       release buf_rtt-ext-file.
     1210     end.
     1211   end.
     1212   end procedure.
