     4022           export stream sout "other-base"          buf_stk-line.other-base                        .
     4023           export stream sout "other-rubl"          buf_stk-line.other-rubl                        .
     4024           export stream sout "sub-fact-qnty"       v-fact-qnty                                    .
     4025           export stream sout "sub-sum-base"        v-sum-base                                     .
     4026           export stream sout "sub-sum-rubl"        v-sum-rubl                                     .
