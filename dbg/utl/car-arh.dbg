     1494   procedure partslib-update-by-factord :
     1495     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1496     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1497     define input parameter p-artic              like ub.parts.artic     no-undo .
     1498     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1499     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1500     define input parameter p-start-fact-order   as decimal   no-undo .
     1501     define input parameter p-end-fact-order     as decimal   no-undo .
     1502     define input parameter p-lock-gds-obj       as logical   no-undo .
     1503     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1504     define buffer buf_gds-obj  for ub.gds-obj .
     1505     define buffer buf_doc-line for ub.doc-line .
     1506     define variable v-total-parts-qnty as decimal   no-undo .
     1507     define variable v-goods-gds-goods  as logical   no-undo .
     1508     define variable v-goods-twounit    as logical   no-undo .
     1509     do
     1510     on error undo, return error
     1511     :
     1512       if p-start-fact-order > p-end-fact-order
     1513       then do:
     1514         message
     1515           vss-workfile vss-revision vss-description skip
     1516           vss-include-info6 skip
     1517           "Ошибка задания входных параметров" skip
     1518           "Начало интервала превышает конец интервала" skip
     1519           "Объект" p-obj-type p-obj-code skip
     1520           "Артикул" p-artic p-prod-type p-prod-code skip
     1521           "p-start-fact-order" p-start-fact-order skip
     1522           "p-end-fact-order"   p-end-fact-order skip
     1523           view-as alert-box error .
     1524         undo, return error .
     1525       end.
     1526       if p-lock-gds-obj = true
     1527       then do:
     1528         do transaction
     1529         on error undo, return error
     1530         :
     1531   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1533     (input  p-obj-type
     1534     ,input  p-obj-code
     1535     ,input  p-artic
     1536     ,input  p-prod-type
     1537     ,input  p-prod-code
     1538     ,buffer buf_gds-obj
     1539     ) no-error .
     1540           if error-status :error
     1541           then do:
     1542             message
     1543               vss-workfile vss-revision vss-description skip
     1544               vss-include-info6 skip
     1545               "Невозможно найти gds-obj" skip
     1546               error-status :get-message(1) skip
     1547               return-value skip
     1548               view-as alert-box error .
     1549             undo, return error .
     1550           end.
     1551           find current buf_gds-obj exclusive-lock .
     1552         end.
     1553       end.
     1554   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1556     (input  p-artic
     1557     ,input  p-prod-type
     1558     ,input  p-prod-code
     1559     ,input  'gds-goods=request':u
     1560     ,output v-goods-gds-goods
     1561     ) no-error .
     1562       if error-status :error
     1563       then do:
     1564         message
     1565           vss-workfile vss-revision vss-description skip
     1566           vss-include-info6 skip
     1567           "Ошибка при определении атрибута товара" skip
     1568           "Артикул" p-artic p-prod-type p-prod-code skip
     1569           "gds-goods=request" skip
     1570           error-status :get-message(1) skip
     1571           return-value skip
     1572           view-as alert-box error .
     1573         undo, return error return-value .
     1574       end.
     1575   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1577     (input  p-artic
     1578     ,input  p-prod-type
     1579     ,input  p-prod-code
     1580     ,input  'twounit=request':u
     1581     ,output v-goods-twounit
     1582     ) no-error .
     1583       if error-status :error
     1584       then do:
     1585         message
     1586           vss-workfile vss-revision vss-description skip
     1587           vss-include-info6 skip
     1588           "Ошибка при определении атрибута товара" skip
     1589           "Артикул" p-artic p-prod-type p-prod-code skip
     1590           "twounit=request" skip
     1591           error-status :get-message(1) skip
     1592           return-value skip
     1593           view-as alert-box error .
     1594         undo, return error return-value .
     1595       end.
     1596       for each buf_doc-line no-lock
     1597         where buf_doc-line.obj-type   = p-obj-type
     1598           and buf_doc-line.obj-code   = p-obj-code
     1599           and buf_doc-line.artic      = p-artic
     1600           and buf_doc-line.prod-type  = p-prod-type
     1601           and buf_doc-line.prod-code  = p-prod-code
     1602           and buf_doc-line.status_    = 'факт':U
     1603           and buf_doc-line.fact-order > p-start-fact-order
     1604           and buf_doc-line.fact-order <= p-end-fact-order
     1605       on error undo, return error
     1606       :
     1607         run partslib-process-document in this-procedure
     1608           (input  buf_doc-line.doc-code
     1609           ,input  p-obj-type
     1610           ,input  p-obj-code
     1611           ,input  p-artic
     1612           ,input  p-prod-type
     1613           ,input  p-prod-code
     1614           ,input  v-goods-gds-goods
     1615           ,input  v-goods-twounit
     1616           ,output v-total-parts-qnty
     1617           ) no-error .
     1618         if error-status :error
     1619         then do:
     1620           message
     1621             vss-workfile vss-revision vss-description skip
     1622             vss-include-info6 skip
     1623             "Ошибка при вызове процедуры partslib-process-document" skip
     1624             "Документ" buf_doc-line.doc-code skip
     1625             "Объект" p-obj-type p-obj-code skip
     1626             "Артикул" p-artic p-prod-type p-prod-code skip
     1627             "p-start-fact-order" p-start-fact-order skip
     1628             "p-end-fact-order" p-end-fact-order skip
     1629             error-status :get-message(1) skip
     1630             return-value skip
     1631             view-as alert-box error .
     1632           undo, return error return-value .
     1633         end.
     1634       end.
     1635     end.
     1636   end procedure.
     1637   procedure partslib-process-document :
     1638     define input  parameter p-doc-code         as character no-undo .
     1639     define input  parameter p-obj-type         as character no-undo .
     1640     define input  parameter p-obj-code         as integer   no-undo .
     1641     define input  parameter p-artic            as character no-undo .
     1642     define input  parameter p-prod-type        as character no-undo .
     1643     define input  parameter p-prod-code        as integer   no-undo .
     1644     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1645     define input  parameter p-goods-twounit    as logical   no-undo .
     1646     define output parameter p-total-parts-qnty as decimal   no-undo .
     1647     define variable v-parts-sign as integer   no-undo .
     1648     define buffer buf_trn-doc    for ub.trn-doc .
     1649     define buffer buf_doc-line   for ub.doc-line .
     1650     define buffer buf_parts      for ub.parts .
     1651     define buffer buf_temp-parts for temp-parts .
     1652     do
     1653     on error undo, return error return-value
     1654     :
     1655       find first buf_trn-doc no-lock
     1656         where buf_trn-doc.doc-code = p-doc-code
     1657         no-error .
     1658       if not available buf_trn-doc
     1659       then do:
     1660         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1661                                      ,p-doc-code
     1662                                      ) .
     1663       end.
     1664       case buf_trn-doc.doc-type
     1665       :
     1666         when 'при':U or
     1667         when 'возврат':U or
     1668         when 'инв':U
     1669         then do:
     1670           assign
     1671             v-parts-sign = -1
     1672           .
     1673         end.
     1674         when 'рас':U or
     1675         when 'спи':U
     1676         then do:
     1677           assign
     1678             v-parts-sign = 1
     1679           .
     1680         end.
     1681         otherwise do:
     1682           undo, return error substitute("Неизвестный тип документа &1"
     1683                                       ,buf_trn-doc.doc-type
     1684                                       ) .
     1685         end.
     1686       end.
     1687       find first buf_doc-line no-lock
     1688         where buf_doc-line.doc-code  = p-doc-code
     1689           and buf_doc-line.artic     = p-artic
     1690           and buf_doc-line.prod-type = p-prod-type
     1691           and buf_doc-line.prod-code = p-prod-code
     1692         no-error .
     1693       if not available buf_doc-line
     1694       then do:
     1695         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1696                                      ,p-doc-code
     1697                                      ,artic
     1698                                      ,prod-type
     1699                                      ,prod-code
     1700                                      ) .
     1701       end.
     1702       assign
     1703         p-total-parts-qnty = 0
     1704       .
     1705       if p-goods-gds-goods = true
     1706       then do:
     1707         for each buf_parts no-lock
     1708           where buf_parts.out-code  = p-doc-code
     1709             and buf_parts.obj-type  = p-obj-type
     1710             and buf_parts.obj-code  = p-obj-code
     1711             and buf_parts.artic     = p-artic
     1712             and buf_parts.prod-type = p-prod-type
     1713             and buf_parts.prod-code = p-prod-code
     1714         on error undo, return error
     1715         :
     1716           run partslib-create-temp-parts in this-procedure
     1717             (buffer buf_parts
     1718             ,buffer buf_temp-parts
     1719             ,input  p-goods-twounit
     1720             ) .
     1721           assign
     1722             p-total-parts-qnty        = p-total-parts-qnty
     1723                                       + v-parts-sign * buf_parts.fact-qnty
     1724             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1725                                       + v-parts-sign * buf_parts.fact-qnty
     1726             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1727                                       + v-parts-sign * buf_parts.fact-qnty
     1728             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1729                                       + v-parts-sign * buf_parts.cli-qnty
     1730           .
     1731           if buf_temp-parts.qnty = 0
     1732           then do:
     1733             delete buf_temp-parts .
     1734           end.
     1735         end.
     1736       end.
     1737       else do:
     1738         assign
     1739           p-total-parts-qnty = p-total-parts-qnty
     1740                              + v-parts-sign * buf_doc-line.fact-qnty
     1741         .
     1742       end.
     1743     end.
     1744   end procedure.
     1745   procedure partslib-init-temp-parts-by-date :
     1746     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1747     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1748     define input parameter p-artic           like ub.parts.artic     no-undo .
     1749     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1750     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1751     define input parameter p-fact-date       as date      no-undo .
     1752     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1753     do
     1754     on error undo, return error
     1755     :
     1756       define variable v-fact-order                as decimal   no-undo .
     1757       define variable v-shift-end-fact-order      as decimal   no-undo .
     1758       define variable v-day-end-fact-order        as decimal   no-undo .
     1759       run factord in this-procedure
     1760         (input  p-fact-date
     1761         ,input  1
     1762         ,input  1
     1763         ,input  ?
     1764         ,input  0
     1765         ,input  false
     1766         ,output v-fact-order
     1767         ,output v-shift-end-fact-order
     1768         ,output v-day-end-fact-order
     1769         ) no-error .
     1770       if error-status :error
     1771       then do:
     1772         message
     1773           vss-workfile vss-revision vss-description skip
     1774           vss-include-info6 skip
     1775           "Ошибка при определении момента времени, на который требуется остаток" skip
     1776           "Объект" p-obj-type p-obj-code skip
     1777           "Артикул" p-artic p-prod-type p-prod-code skip
     1778           "Дата" p-fact-date skip
     1779           view-as alert-box error .
     1780         undo, return error .
     1781       end.
     1782       run partslib-init-temp-parts-by-factord in this-procedure
     1783         (input p-obj-type
     1784         ,input p-obj-code
     1785         ,input p-artic
     1786         ,input p-prod-type
     1787         ,input p-prod-code
     1788         ,input v-day-end-fact-order
     1789         ,input false
     1790         ) no-error .
     1791       if error-status :error
     1792       then do:
     1793         message
     1794           vss-workfile vss-revision vss-description skip
     1795           vss-include-info6 skip
     1796           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1797           "Объект" p-obj-type p-obj-code skip
     1798           "Артикул" p-artic p-prod-type p-prod-code skip
     1799           "Дата" p-fact-date skip
     1800           view-as alert-box error .
     1801         undo, return error .
     1802       end.
     1803     end.
     1804   end procedure.
     1805   procedure partslib-calc-cost :
     1806     define output parameter p-fact-qnty      as decimal   no-undo .
     1807     define output parameter p-vat-pc         as decimal   no-undo .
     1808     define output parameter p-slt-pc         as decimal   no-undo .
     1809     define output parameter p-sum-base       as decimal   no-undo .
     1810     define output parameter p-sum-rubl       as decimal   no-undo .
     1811     define output parameter p-vat-base       as decimal   no-undo .
     1812     define output parameter p-vat-rubl       as decimal   no-undo .
     1813     define output parameter p-slt-base       as decimal   no-undo .
     1814     define output parameter p-slt-rubl       as decimal   no-undo .
     1815     define output parameter p-road-tax-base  as decimal   no-undo .
     1816     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1817     define output parameter p-transport-base as decimal   no-undo .
     1818     define output parameter p-transport-rubl as decimal   no-undo .
     1819     define output parameter p-other-base     as decimal   no-undo .
     1820     define output parameter p-other-rubl     as decimal   no-undo .
     1821     define output parameter p-excise-base    as decimal   no-undo .
     1822     define output parameter p-excise-rubl    as decimal   no-undo .
     1823     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1824     do
     1825     on error undo, return error return-value
     1826     :
     1827       define buffer buf_temp-parts for temp-parts .
     1828       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1829       define buffer   in-vatp-parts    for ub.parts   .
     1830       define buffer   in-vatp-doc      for ub.trn-doc .
     1831       define buffer   in-vatp-goods    for ub.goods   .
     1832       define buffer   in-vatp-sysconf  for ub.sysconf .
     1833       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1834       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1835       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1836       define variable varinvprb                  as   character              no-undo.
     1837       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1838       define variable cli-base-rate              as   decimal                no-undo.
     1839       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1840       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1841       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1842       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1843       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1844       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1845       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1846       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1847       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1848       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1849       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1850       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1851       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1852       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1853       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1854       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1855       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1856       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1857       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1858       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1859       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1860       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1861       define variable varinvatp-envd             as   character              no-undo.
     1862       define variable varinvatp-type             as   character              no-undo.
     1863       for each buf_temp-parts
     1864       on error undo, return error
     1865       :
     1866   assign
     1867     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1868     price-base-with-tax-loc = buf_temp-parts.price-base
     1869   .
     1870   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1871   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1872     (output varinvprb
     1873     )  .
     1874     if buf_temp-parts.out-code = 'free-zone':U     or
     1875        buf_temp-parts.out-code = 'out-zone':U   or
     1876        buf_temp-parts.doc-type = 'акт':U then do:
     1877       assign
     1878         in-vatp-have-vat-slt = yes.
     1879     end.
     1880     else do:
     1881       find first in-vatp_doc-attr no-lock
     1882         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1883           and in-vatp_doc-attr.attr-code = 'envd':U
     1884         no-error .
     1885       if not available in-vatp_doc-attr then do:
     1886         assign
     1887           in-vatp-have-vat-slt = yes.
     1888       end.
     1889       else do:
     1890            in-vatp-have-vat-slt = no.
     1891       end.
     1892     end.
     1893     assign
     1894      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1895      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1896     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1897              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1898     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1899             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1900             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1901             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1902             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1903             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1904             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1905       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1906     assign
     1907       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1908     assign
     1909       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1910       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1911       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1912       transport-cli-loc  = 0
     1913       other-cli-loc      = 0
     1914     .
     1915   ASSIGN
     1916             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1917       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1918   .
     1919         assign
     1920           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1921           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1922           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1923           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1924           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1925           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1926           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1927           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1928           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1929           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1930           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1931           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1932           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1933           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1934           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1935           p-excise-base    = p-excise-base    + 0
     1936           p-excise-rubl    = p-excise-rubl    + 0
     1937         .
     1938       end.
     1939       if p-fact-qnty      = ?
     1940       or p-sum-base       = ?
     1941       or p-sum-rubl       = ?
     1942       or p-vat-base       = ?
     1943       or p-vat-rubl       = ?
     1944       or p-slt-base       = ?
     1945       or p-slt-rubl       = ?
     1946       or p-road-tax-base  = ?
     1947       or p-road-tax-rubl  = ?
     1948       or p-transport-base = ?
     1949       or p-transport-rubl = ?
     1950       or p-other-base     = ?
     1951       or p-other-rubl     = ?
     1952       or p-excise-base    = ?
     1953       or p-excise-rubl    = ?
     1954       then do:
     1955         message
     1956           vss-workfile vss-revision vss-description skip
     1957           vss-include-info6 skip
     1958           "Программа in-vatp.i вернула неопределенные значения" skip
     1959           "p-fact-qnty"      p-fact-qnty      skip
     1960           "p-sum-base"       p-sum-base       skip
     1961           "p-sum-rubl"       p-sum-rubl       skip
     1962           "p-vat-base"       p-vat-base       skip
     1963           "p-vat-rubl"       p-vat-rubl       skip
     1964           "p-slt-base"       p-slt-base       skip
     1965           "p-slt-rubl"       p-slt-rubl       skip
     1966           "p-road-tax-base"  p-road-tax-base  skip
     1967           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1968           "p-transport-base" p-transport-base skip
     1969           "p-transport-rubl" p-transport-rubl skip
     1970           "p-other-base"     p-other-base     skip
     1971           "p-other-rubl"     p-other-rubl     skip
     1972           "p-excise-base"    p-excise-base    skip
     1973           "p-excise-rubl"    p-excise-rubl    skip
     1974           view-as alert-box error .
     1975         undo, return error .
     1976       end.
     1977     end.
     1978   end procedure.
     1979   define variable v-total-err      as integer   no-undo .
     1980   define variable v-today          as date      no-undo .
     1981   define variable v-time           as integer   no-undo .
     1982   define variable v-log-err-file   as character no-undo .
     1983   define stream sout .
     1984   define temp-table temp-date no-undo
     1985     field arch-date          as date    format '99/99/9999':u
     1986     field fact-ord-begin-day as decimal format '>>>,>>>,>>9.99':u
     1987     field fact-ord-end-day   as decimal format '>>>,>>>,>>9.99':u
     1988     field temp-date-ok       as logical
     1989     index xpk is primary unique arch-date
     1990       .
     1991   define temp-table temp-ot-day no-undo
     1992     field temp-gds-code       as integer
     1993     field temp-artic          as character
     1994     field temp-prod-type      as character
     1995     field temp-prod-code      as integer
     1996     field temp-sum-type       as character
     1997     field temp-cat-id         as character
     1998     field temp-fact-qnty      as decimal
     1999     field temp-sum-base       as decimal
     2000     field temp-sum-rubl       as decimal
     2001     field temp-VAT-base       as decimal
     2002     field temp-VAT-rubl       as decimal
     2003     field temp-SLT-base       as decimal
     2004     field temp-SLT-rubl       as decimal
     2005     field temp-road-tax-base  as decimal
     2006     field temp-road-tax-rubl  as decimal
     2007     field temp-excise-base    as decimal
     2008     field temp-excise-rubl    as decimal
     2009     field temp-transport-base as decimal
     2010     field temp-transport-rubl as decimal
     2011     field temp-other-base     as decimal
     2012     field temp-other-rubl     as decimal
     2013     index xpk is primary unique
     2014       temp-artic
     2015       temp-prod-type
     2016       temp-prod-code
     2017       temp-sum-type
     2018       temp-cat-id
     2019     index xie temp-sum-type temp-cat-id
     2020       .
     2021   define temp-table temp-stk-line no-undo
     2022     field temp-artic          as character
     2023     field temp-prod-type      as character
     2024     field temp-prod-code      as integer
     2025     field temp-fact-order     as decimal
     2026     field temp-gds-qnty       as decimal
     2027     field temp-fact-qnty      as decimal
     2028     index xpk is primary unique
     2029       temp-artic
     2030       temp-prod-type
     2031       temp-prod-code
     2032       .
     2033   define temp-table temp-gds no-undo
     2034     field temp-artic      as character
     2035     field temp-prod-type  as character
     2036     field temp-prod-code  as integer
     2037     index xpk is primary unique
     2038       temp-artic
     2039       temp-prod-type
     2040       temp-prod-code
     2041       .
     2042   do
     2043   on error undo, return error return-value
     2044   :
     2045     assign
     2046       v-log-err-file = substitute('car-arh-&1-&2.err':U
     2047                                  ,p-obj-type
     2048                                  ,p-obj-code
     2049                                  )
     2050       p-detail-error-file-name = v-log-err-file
     2051     .
     2052     os-delete value(v-log-err-file) .
     2053     run fill-temp-date in this-procedure .
     2054     run check-temp-date in this-procedure .
     2055     run clear-temp-date in this-procedure .
     2056     run clear-temp-ot-day in this-procedure .
     2057     run validate-free-zone in this-procedure .
     2058     run clear-temp-stk-line in this-procedure .
     2059     run check-fact-order in this-procedure .
     2060     run fill-temp-stk-line in this-procedure .
     2061     run check-free-zone-from-stk-line in this-procedure .
     2062     run check-sub-type-stk-line in this-procedure .
     2063     assign
     2064       p-err-num = v-total-err
     2065     .
     2066   end.
     2067   procedure clear-temp-date :
     2068     define buffer buf_temp-date for temp-date .
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       for each buf_temp-date
     2073       on error undo, return error return-value
     2074       :
     2075         delete buf_temp-date .
     2076       end.
     2077     end.
     2078   end procedure.
     2079   procedure fill-temp-date :
     2080     define variable v-attr-value          as character no-undo .
     2081     define variable v-attr-type           as character no-undo .
     2082     define variable v-arh-detail-date     as date      no-undo .
     2083     define variable v-fact-ord-begin-aht  as decimal   no-undo .
     2084     define variable v-fact-date           as date      no-undo .
     2085     define variable v-fact-ord-begin-day  as decimal   no-undo .
     2086     define variable v-fact-ord-end-day    as decimal   no-undo .
     2087     define buffer buf_temp-date for temp-date .
     2088     define buffer buf_ot-line for ub.ot-line .
     2089     define buffer buf_stk-line for ub.stk-line .
     2090     do
     2091     on error undo, return error return-value
     2092     :
     2093       run clntattr-value in this-procedure
     2094         (input  p-obj-type
     2095         ,input  p-obj-code
     2096         ,input  'arh-detail':U
     2097         ,output v-attr-value
     2098         ,output v-attr-type
     2099         ) .
     2100       assign
     2101         v-arh-detail-date = date(v-attr-value)
     2102       .
     2103       if v-arh-detail-date <> ?
     2104       then do:
     2105         run day-begin-fact-order in this-procedure
     2106           (input  v-arh-detail-date
     2107           ,output v-fact-ord-begin-aht
     2108           ) .
     2109       end.
     2110       else do:
     2111         assign
     2112           v-fact-ord-begin-aht = 0
     2113         .
     2114       end.
     2115       find first buf_ot-line no-lock
     2116         where buf_ot-line.obj-type   = p-obj-type
     2117           and buf_ot-line.obj-code   = p-obj-code
     2118           and buf_ot-line.fact-order > v-fact-ord-begin-aht
     2119         use-index fact-order
     2120         no-error .
     2121       do while available buf_ot-line
     2122       :
     2123         run factord-to-date in this-procedure
     2124           (input  buf_ot-line.fact-order
     2125           ,output v-fact-date
     2126           ) .
     2127         run day-begin-fact-order in this-procedure
     2128           (input  v-fact-date
     2129           ,output v-fact-ord-begin-day
     2130           ) .
     2131         run factord-end-day in this-procedure
     2132           (input  v-fact-date
     2133           ,output v-fact-ord-end-day
     2134           ) .
     2135         create buf_temp-date .
     2136         assign
     2137           buf_temp-date.arch-date          = v-fact-date
     2138           buf_temp-date.fact-ord-begin-day = v-fact-ord-begin-day
     2139           buf_temp-date.fact-ord-end-day   = v-fact-ord-end-day
     2140         .
     2141         find first buf_ot-line no-lock
     2142           where buf_ot-line.obj-type   = p-obj-type
     2143             and buf_ot-line.obj-code   = p-obj-code
     2144             and buf_ot-line.fact-order > v-fact-ord-end-day
     2145           use-index fact-order
     2146           no-error .
     2147       end.
     2148       find first buf_stk-line no-lock
     2149         where buf_stk-line.obj-type   = p-obj-type
     2150           and buf_stk-line.obj-code   = p-obj-code
     2151           and buf_stk-line.fact-order > v-fact-ord-begin-aht
     2152         use-index fact-order
     2153         no-error .
     2154       do while available buf_stk-line
     2155       :
     2156         run factord-to-date in this-procedure
     2157           (input  buf_stk-line.fact-order
     2158           ,output v-fact-date
     2159           ) .
     2160         run day-begin-fact-order in this-procedure
     2161           (input  v-fact-date
     2162           ,output v-fact-ord-begin-day
     2163           ) .
     2164         run factord-end-day in this-procedure
     2165           (input  v-fact-date
     2166           ,output v-fact-ord-end-day
     2167           ) .
     2168         find first buf_temp-date
     2169           where buf_temp-date.arch-date = v-fact-date
     2170           no-error .
     2171         if not available buf_temp-date
     2172         then do:
     2173           create buf_temp-date .
     2174           assign
     2175             buf_temp-date.arch-date          = v-fact-date
     2176             buf_temp-date.fact-ord-begin-day = v-fact-ord-begin-day
     2177             buf_temp-date.fact-ord-end-day   = v-fact-ord-end-day
     2178           .
     2179         end.
     2180         find first buf_stk-line no-lock
     2181           where buf_stk-line.obj-type   = p-obj-type
     2182             and buf_stk-line.obj-code   = p-obj-code
     2183             and buf_stk-line.fact-order > v-fact-ord-end-day
     2184           use-index fact-order
     2185           no-error .
     2186       end.
     2187     end.
     2188   end procedure.
     2189   procedure check-temp-date :
     2190     define buffer buf_temp-date for temp-date .
     2191     do
     2192     on error undo, return error return-value
     2193     :
     2194       define variable v-arh-detail-date as date      no-undo .
     2195       define variable v-attr-value      as character no-undo .
     2196       define variable v-attr-type       as character no-undo .
     2197       run clntattr-value in this-procedure
     2198         (input  p-obj-type
     2199         ,input  p-obj-code
     2200         ,input  'arh-detail':U
     2201         ,output v-attr-value
     2202         ,output v-attr-type
     2203         ) .
     2204       assign
     2205         v-arh-detail-date = date(v-attr-value)
     2206       .
     2207       for each buf_temp-date
     2208       on error undo, return error return-value
     2209       :
     2210         run waitfram-show in this-procedure
     2211           (input substitute("Анализ складского архива по товарам. Ошибок &1. Объект &2 &3. Дата &4."
     2212                           ,v-total-err
     2213                           ,p-obj-type
     2214                           ,p-obj-code
     2215                           ,string(buf_temp-date.arch-date, '99/99/9999':u)
     2216                           )
     2217           ).
     2218         run clear-temp-ot-day in this-procedure .
     2219         run fill-temp-ot-day in this-procedure
     2220           (input  buf_temp-date.arch-date
     2221           ,input  buf_temp-date.fact-ord-begin-day
     2222           ,input  buf_temp-date.fact-ord-end-day
     2223           ) .
     2224         run validate-ot-line-stk in this-procedure
     2225           (input  buf_temp-date.arch-date
     2226           ,input  buf_temp-date.fact-ord-begin-day
     2227           ,input  buf_temp-date.fact-ord-end-day
     2228           ) .
     2229         if v-arh-detail-date = ?
     2230         or (v-arh-detail-date <> ?
     2231             and buf_temp-date.arch-date >= v-arh-detail-date
     2232            )
     2233         then do:
     2234           run validate-stk-line in this-procedure
     2235             (input buf_temp-date.arch-date
     2236             ,input buf_temp-date.fact-ord-begin-day
     2237             ,input buf_temp-date.fact-ord-end-day
     2238             ) .
     2239         end.
     2240       end.
     2241     end.
     2242   end procedure.
     2243   procedure validate-ot-line-stk :
     2244     define input  parameter p-fact-date            as date      no-undo .
     2245     define input  parameter p-fact-order-begin-day as decimal   no-undo .
     2246     define input  parameter p-fact-order-end-day   as decimal   no-undo .
     2247     define variable v-fact-qnty      as decimal   no-undo .
     2248     define variable v-sum-base       as decimal   no-undo .
     2249     define variable v-sum-rubl       as decimal   no-undo .
     2250     define variable v-VAT-base       as decimal   no-undo .
     2251     define variable v-VAT-rubl       as decimal   no-undo .
     2252     define variable v-SLT-base       as decimal   no-undo .
     2253     define variable v-SLT-rubl       as decimal   no-undo .
     2254     define variable v-road-tax-base  as decimal   no-undo .
     2255     define variable v-road-tax-rubl  as decimal   no-undo .
     2256     define variable v-excise-base    as decimal   no-undo .
     2257     define variable v-excise-rubl    as decimal   no-undo .
     2258     define variable v-transport-base as decimal   no-undo .
     2259     define variable v-transport-rubl as decimal   no-undo .
     2260     define variable v-other-base     as decimal   no-undo .
     2261     define variable v-other-rubl     as decimal   no-undo .
     2262     define buffer buf_stk-line    for ub.stk-line .
     2263     define buffer buf_temp-ot-day for temp-ot-day .
     2264     do
     2265     on error undo, return error return-value
     2266     :
     2267       for each buf_temp-ot-day
     2268       on error undo, return error return-value
     2269       :
     2270         if buf_temp-ot-day.temp-sum-type begins 'cost':U
     2271         or buf_temp-ot-day.temp-sum-type begins 'csdt':U
     2272         or buf_temp-ot-day.temp-sum-type begins 'sadt':U
     2273         then do:
     2274           if buf_temp-ot-day.temp-sum-type begins 'cost':U
     2275           then do:
     2276             find last buf_stk-line no-lock
     2277               where buf_stk-line.obj-type   = p-obj-type
     2278                 and buf_stk-line.obj-code   = p-obj-code
     2279                 and buf_stk-line.artic      = buf_temp-ot-day.temp-artic
     2280                 and buf_stk-line.prod-type  = buf_temp-ot-day.temp-prod-type
     2281                 and buf_stk-line.prod-code  = buf_temp-ot-day.temp-prod-code
     2282                 and buf_stk-line.sum-type   = 'cost':U
     2283                 and buf_stk-line.cat-id     = '##,##':U
     2284                 and buf_stk-line.fact-order < p-fact-order-begin-day
     2285                 and buf_stk-line.shift-date = ?
     2286               use-index category
     2287               no-error .
     2288             if  available buf_stk-line
     2289             and buf_temp-ot-day.temp-sum-type <> 'cost':U
     2290             then do:
     2291               define variable v-sub-fact-order as decimal   no-undo .
     2292               assign
     2293                 v-sub-fact-order = buf_stk-line.fact-order
     2294               .
     2295               find last buf_stk-line no-lock
     2296                 where buf_stk-line.obj-type   = p-obj-type
     2297                   and buf_stk-line.obj-code   = p-obj-code
     2298                   and buf_stk-line.artic      = buf_temp-ot-day.temp-artic
     2299                   and buf_stk-line.prod-type  = buf_temp-ot-day.temp-prod-type
     2300                   and buf_stk-line.prod-code  = buf_temp-ot-day.temp-prod-code
     2301                   and buf_stk-line.sum-type   = buf_temp-ot-day.temp-sum-type
     2302                   and buf_stk-line.cat-id     = buf_temp-ot-day.temp-cat-id
     2303                   and buf_stk-line.fact-order = v-sub-fact-order
     2304                   and buf_stk-line.shift-date = ?
     2305                 use-index category
     2306                 no-error .
     2307             end.
     2308           end.
     2309           else do:
     2310             find last buf_stk-line no-lock
     2311               where buf_stk-line.obj-type   = p-obj-type
     2312                 and buf_stk-line.obj-code   = p-obj-code
     2313                 and buf_stk-line.artic      = buf_temp-ot-day.temp-artic
     2314                 and buf_stk-line.prod-type  = buf_temp-ot-day.temp-prod-type
     2315                 and buf_stk-line.prod-code  = buf_temp-ot-day.temp-prod-code
     2316                 and buf_stk-line.sum-type   = buf_temp-ot-day.temp-sum-type
     2317                 and buf_stk-line.cat-id     = buf_temp-ot-day.temp-cat-id
     2318                 and buf_stk-line.fact-order < p-fact-order-begin-day
     2319                 and buf_stk-line.shift-date = ?
     2320               use-index category
     2321               no-error .
     2322           end.
     2323           if available buf_stk-line
     2324           then do:
     2325             assign
     2326               v-fact-qnty      = - buf_stk-line.fact-qnty
     2327               v-sum-base       = - buf_stk-line.sum-base
     2328               v-sum-rubl       = - buf_stk-line.sum-rubl
     2329               v-VAT-base       = - buf_stk-line.VAT-base
     2330               v-VAT-rubl       = - buf_stk-line.VAT-rubl
     2331               v-SLT-base       = - buf_stk-line.SLT-base
     2332               v-SLT-rubl       = - buf_stk-line.SLT-rubl
     2333               v-road-tax-base  = - buf_stk-line.road-tax-base
     2334               v-road-tax-rubl  = - buf_stk-line.road-tax-rubl
     2335               v-excise-base    = - buf_stk-line.excise-base
     2336               v-excise-rubl    = - buf_stk-line.excise-rubl
     2337               v-transport-base = - buf_stk-line.transport-base
     2338               v-transport-rubl = - buf_stk-line.transport-rubl
     2339               v-other-base     = - buf_stk-line.other-base
     2340               v-other-rubl     = - buf_stk-line.other-rubl
     2341             .
     2342           end.
     2343           else do:
     2344             assign
     2345               v-fact-qnty      = 0
     2346               v-sum-base       = 0
     2347               v-sum-rubl       = 0
     2348               v-VAT-base       = 0
     2349               v-VAT-rubl       = 0
     2350               v-SLT-base       = 0
     2351               v-SLT-rubl       = 0
     2352               v-road-tax-base  = 0
     2353               v-road-tax-rubl  = 0
     2354               v-excise-base    = 0
     2355               v-excise-rubl    = 0
     2356               v-transport-base = 0
     2357               v-transport-rubl = 0
     2358               v-other-base     = 0
     2359               v-other-rubl     = 0
     2360             .
     2361           end.
     2362           assign
     2363             v-fact-qnty      = v-fact-qnty      - buf_temp-ot-day.temp-fact-qnty
     2364             v-sum-base       = v-sum-base       - buf_temp-ot-day.temp-sum-base
     2365             v-sum-rubl       = v-sum-rubl       - buf_temp-ot-day.temp-sum-rubl
     2366             v-VAT-base       = v-VAT-base       - buf_temp-ot-day.temp-VAT-base
     2367             v-VAT-rubl       = v-VAT-rubl       - buf_temp-ot-day.temp-VAT-rubl
     2368             v-SLT-base       = v-SLT-base       - buf_temp-ot-day.temp-SLT-base
     2369             v-SLT-rubl       = v-SLT-rubl       - buf_temp-ot-day.temp-SLT-rubl
     2370             v-road-tax-base  = v-road-tax-base  - buf_temp-ot-day.temp-road-tax-base
     2371             v-road-tax-rubl  = v-road-tax-rubl  - buf_temp-ot-day.temp-road-tax-rubl
     2372             v-excise-base    = v-excise-base    - buf_temp-ot-day.temp-excise-base
     2373             v-excise-rubl    = v-excise-rubl    - buf_temp-ot-day.temp-excise-rubl
     2374             v-transport-base = v-transport-base - buf_temp-ot-day.temp-transport-base
     2375             v-transport-rubl = v-transport-rubl - buf_temp-ot-day.temp-transport-rubl
     2376             v-other-base     = v-other-base     - buf_temp-ot-day.temp-other-base
     2377             v-other-rubl     = v-other-rubl     - buf_temp-ot-day.temp-other-rubl
     2378           .
     2379           find first buf_stk-line no-lock
     2380             where buf_stk-line.obj-type   = p-obj-type
     2381               and buf_stk-line.obj-code   = p-obj-code
     2382               and buf_stk-line.artic      = buf_temp-ot-day.temp-artic
     2383               and buf_stk-line.prod-type  = buf_temp-ot-day.temp-prod-type
     2384               and buf_stk-line.prod-code  = buf_temp-ot-day.temp-prod-code
     2385               and buf_stk-line.sum-type   = buf_temp-ot-day.temp-sum-type
     2386               and buf_stk-line.cat-id     = buf_temp-ot-day.temp-cat-id
     2387               and buf_stk-line.fact-order = p-fact-order-end-day
     2388             use-index category
     2389             no-error .
     2390           if available buf_stk-line
     2391           then do:
     2392             assign
     2393               v-fact-qnty      = v-fact-qnty      + buf_stk-line.fact-qnty
     2394               v-sum-base       = v-sum-base       + buf_stk-line.sum-base
     2395               v-sum-rubl       = v-sum-rubl       + buf_stk-line.sum-rubl
     2396               v-VAT-base       = v-VAT-base       + buf_stk-line.VAT-base
     2397               v-VAT-rubl       = v-VAT-rubl       + buf_stk-line.VAT-rubl
     2398               v-SLT-base       = v-SLT-base       + buf_stk-line.SLT-base
     2399               v-SLT-rubl       = v-SLT-rubl       + buf_stk-line.SLT-rubl
     2400               v-road-tax-base  = v-road-tax-base  + buf_stk-line.road-tax-base
     2401               v-road-tax-rubl  = v-road-tax-rubl  + buf_stk-line.road-tax-rubl
     2402               v-excise-base    = v-excise-base    + buf_stk-line.excise-base
     2403               v-excise-rubl    = v-excise-rubl    + buf_stk-line.excise-rubl
     2404               v-transport-base = v-transport-base + buf_stk-line.transport-base
     2405               v-transport-rubl = v-transport-rubl + buf_stk-line.transport-rubl
     2406               v-other-base     = v-other-base     + buf_stk-line.other-base
     2407               v-other-rubl     = v-other-rubl     + buf_stk-line.other-rubl
     2408             .
     2409           end.
     2410           else do:
     2411             if  buf_temp-ot-day.temp-sum-type begins 'cost':U
     2412             and buf_temp-ot-day.temp-sum-type <>     'cost':U
     2413             and v-fact-qnty       = 0
     2414             and v-sum-base        = 0
     2415             and v-sum-rubl        = 0
     2416             and v-VAT-base        = 0
     2417             and v-VAT-rubl        = 0
     2418             and v-SLT-base        = 0
     2419             and v-SLT-rubl        = 0
     2420             and v-road-tax-base   = 0
     2421             and v-road-tax-rubl   = 0
     2422             and v-excise-base     = 0
     2423             and v-excise-rubl     = 0
     2424             and v-transport-base  = 0
     2425             and v-transport-rubl  = 0
     2426             and v-other-base      = 0
     2427             and v-other-rubl      = 0
     2428             then do:
     2429             end.
     2430             else do:
     2431               assign
     2432                 v-total-err = v-total-err + 1
     2433               .
     2434               run cur-time in this-procedure
     2435                 (output v-today
     2436                 ,output v-time
     2437                 ) .
     2438               run update-last-date in this-procedure
     2439                 (input p-fact-date
     2440                 ) .
     2441               output stream sout to value(v-log-err-file) append .
     2442               export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     2443               export stream sout "error-01: stk-line not found" .
     2444               export stream sout "obj-type"       p-obj-type                     .
     2445               export stream sout "obj-code"       p-obj-code                     .
     2446               export stream sout "fact-date"      p-fact-date                    .
     2447               export stream sout "artic"          buf_temp-ot-day.temp-artic     .
     2448               export stream sout "prod-type"      buf_temp-ot-day.temp-prod-type .
     2449               export stream sout "prod-code"      buf_temp-ot-day.temp-prod-code .
     2450               export stream sout "sum-type"       buf_temp-ot-day.temp-sum-type  .
     2451               export stream sout "cat-id"         buf_temp-ot-day.temp-cat-id    .
     2452               export stream sout "fact-order"     p-fact-order-end-day           .
     2453               export stream sout "fact-qnty"      v-fact-qnty                    .
     2454               export stream sout "sum-base"       v-sum-base                     .
     2455               export stream sout "sum-rubl"       v-sum-rubl                     .
     2456               export stream sout "VAT-base"       v-VAT-base                     .
     2457               export stream sout "VAT-rubl"       v-VAT-rubl                     .
     2458               export stream sout "SLT-base"       v-SLT-base                     .
     2459               export stream sout "SLT-rubl"       v-SLT-rubl                     .
     2460               export stream sout "road-tax-base"  v-road-tax-base                .
     2461               export stream sout "road-tax-rubl"  v-road-tax-rubl                .
     2462               export stream sout "excise-base"    v-excise-base                  .
     2463               export stream sout "excise-rubl"    v-excise-rubl                  .
     2464               export stream sout "transport-base" v-transport-base               .
     2465               export stream sout "transport-rubl" v-transport-rubl               .
     2466               export stream sout "other-base"     v-other-base                   .
     2467               export stream sout "other-rubl"     v-other-rubl                   .
     2468               output stream sout close .
     2469             end.
     2470           end.
     2471           if v-fact-qnty      <> 0
     2472           or v-sum-base       <> 0
     2473           or v-sum-rubl       <> 0
     2474           or v-VAT-base       <> 0
     2475           or v-VAT-rubl       <> 0
     2476           or v-SLT-base       <> 0
     2477           or v-SLT-rubl       <> 0
     2478           or v-road-tax-base  <> 0
     2479           or v-road-tax-rubl  <> 0
     2480           or v-excise-base    <> 0
     2481           or v-excise-rubl    <> 0
     2482           or v-transport-base <> 0
     2483           or v-transport-rubl <> 0
     2484           or v-other-base     <> 0
     2485           or v-other-rubl     <> 0
     2486           then do:
     2487             assign
     2488               v-total-err = v-total-err + 1
     2489             .
     2490             run cur-time in this-procedure
     2491               (output v-today
     2492               ,output v-time
     2493               ) .
     2494             run update-last-date in this-procedure
     2495               (input p-fact-date
     2496               ) .
     2497             output stream sout to value(v-log-err-file) append .
     2498             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     2499             export stream sout "error-02: stk-line different quantity" .
     2500             export stream sout "obj-type"       p-obj-type                     .
     2501             export stream sout "obj-code"       p-obj-code                     .
     2502             export stream sout "fact-date"      p-fact-date                    .
     2503             export stream sout "artic"          buf_temp-ot-day.temp-artic     .
     2504             export stream sout "prod-type"      buf_temp-ot-day.temp-prod-type .
     2505             export stream sout "prod-code"      buf_temp-ot-day.temp-prod-code .
     2506             export stream sout "sum-type"       buf_temp-ot-day.temp-sum-type  .
     2507             export stream sout "cat-id"         buf_temp-ot-day.temp-cat-id    .
     2508             export stream sout "fact-order"     p-fact-order-end-day           .
     2509             export stream sout "fact-qnty"      v-fact-qnty                    .
     2510             export stream sout "sum-base"       v-sum-base                     .
     2511             export stream sout "sum-rubl"       v-sum-rubl                     .
     2512             export stream sout "VAT-base"       v-VAT-base                     .
     2513             export stream sout "VAT-rubl"       v-VAT-rubl                     .
     2514             export stream sout "SLT-base"       v-SLT-base                     .
     2515             export stream sout "SLT-rubl"       v-SLT-rubl                     .
     2516             export stream sout "road-tax-base"  v-road-tax-base                .
     2517             export stream sout "road-tax-rubl"  v-road-tax-rubl                .
     2518             export stream sout "excise-base"    v-excise-base                  .
     2519             export stream sout "excise-rubl"    v-excise-rubl                  .
     2520             export stream sout "transport-base" v-transport-base               .
     2521             export stream sout "transport-rubl" v-transport-rubl               .
     2522             export stream sout "other-base"     v-other-base                   .
     2523             export stream sout "other-rubl"     v-other-rubl                   .
     2524             output stream sout close .
     2525           end.
     2526         end.
     2527       end.
     2528     end.
     2529   end procedure.
     2530   procedure clear-temp-ot-day :
     2531     define buffer buf_temp-ot-day for temp-ot-day .
     2532     do
     2533     on error undo, return error return-value
     2534     :
     2535       for each buf_temp-ot-day
     2536       on error undo, return error return-value
     2537       :
     2538         delete buf_temp-ot-day .
     2539       end.
     2540     end.
     2541   end procedure.
     2542   procedure fill-temp-ot-day :
     2543     define input  parameter p-fact-date            as date      no-undo .
     2544     define input  parameter p-fact-order-begin-day as decimal   no-undo .
     2545     define input  parameter p-fact-order-end-day   as decimal   no-undo .
     2546     define buffer buf_temp-ot-day for temp-ot-day .
     2547     define buffer buf_ot-line     for ub.ot-line .
     2548     do
     2549     on error undo, return error return-value
     2550     :
     2551       for each buf_ot-line no-lock
     2552         where buf_ot-line.obj-type   = p-obj-type
     2553           and buf_ot-line.obj-code   = p-obj-code
     2554           and buf_ot-line.fact-order > p-fact-order-begin-day
     2555           and buf_ot-line.fact-order < p-fact-order-end-day
     2556       on error undo, return error return-value
     2557       :
     2558         find first buf_temp-ot-day
     2559           where buf_temp-ot-day.temp-artic     = buf_ot-line.artic
     2560             and buf_temp-ot-day.temp-prod-type = buf_ot-line.prod-type
     2561             and buf_temp-ot-day.temp-prod-code = buf_ot-line.prod-code
     2562             and buf_temp-ot-day.temp-sum-type  = buf_ot-line.sum-type
     2563             and buf_temp-ot-day.temp-cat-id    = buf_ot-line.cat-id
     2564           no-error .
     2565         if not available buf_temp-ot-day
     2566         then do:
     2567           create buf_temp-ot-day .
     2568           assign
     2569             buf_temp-ot-day.temp-artic     = buf_ot-line.artic
     2570             buf_temp-ot-day.temp-prod-type = buf_ot-line.prod-type
     2571             buf_temp-ot-day.temp-prod-code = buf_ot-line.prod-code
     2572             buf_temp-ot-day.temp-sum-type  = buf_ot-line.sum-type
     2573             buf_temp-ot-day.temp-cat-id    = buf_ot-line.cat-id
     2574           .
     2575         end.
     2576         assign
     2577           buf_temp-ot-day.temp-fact-qnty      = buf_temp-ot-day.temp-fact-qnty
     2578                                               + buf_ot-line.fact-qnty
     2579           buf_temp-ot-day.temp-sum-base       = buf_temp-ot-day.temp-sum-base
     2580                                               + buf_ot-line.sum-base
     2581           buf_temp-ot-day.temp-sum-rubl       = buf_temp-ot-day.temp-sum-rubl
     2582                                               + buf_ot-line.sum-rubl
     2583           buf_temp-ot-day.temp-VAT-base       = buf_temp-ot-day.temp-VAT-base
     2584                                               + buf_ot-line.VAT-base
     2585           buf_temp-ot-day.temp-VAT-rubl       = buf_temp-ot-day.temp-VAT-rubl
     2586                                               + buf_ot-line.VAT-rubl
     2587           buf_temp-ot-day.temp-SLT-base       = buf_temp-ot-day.temp-SLT-base
     2588                                               + buf_ot-line.SLT-base
     2589           buf_temp-ot-day.temp-SLT-rubl       = buf_temp-ot-day.temp-SLT-rubl
     2590                                               + buf_ot-line.SLT-rubl
     2591           buf_temp-ot-day.temp-road-tax-base  = buf_temp-ot-day.temp-road-tax-base
     2592                                               + buf_ot-line.road-tax-base
     2593           buf_temp-ot-day.temp-road-tax-rubl  = buf_temp-ot-day.temp-road-tax-rubl
     2594                                               + buf_ot-line.road-tax-rubl
     2595           buf_temp-ot-day.temp-excise-base    = buf_temp-ot-day.temp-excise-base
     2596                                               + buf_ot-line.excise-base
     2597           buf_temp-ot-day.temp-excise-rubl    = buf_temp-ot-day.temp-excise-rubl
     2598                                               + buf_ot-line.excise-rubl
     2599           buf_temp-ot-day.temp-transport-base = buf_temp-ot-day.temp-transport-base
     2600                                               + buf_ot-line.transport-base
     2601           buf_temp-ot-day.temp-transport-rubl = buf_temp-ot-day.temp-transport-rubl
     2602                                               + buf_ot-line.transport-rubl
     2603           buf_temp-ot-day.temp-other-base     = buf_temp-ot-day.temp-other-base
     2604                                               + buf_ot-line.other-base
     2605           buf_temp-ot-day.temp-other-rubl     = buf_temp-ot-day.temp-other-rubl
     2606                                               + buf_ot-line.other-rubl
     2607         .
     2608         if buf_ot-line.sum-type = 'cost':U
     2609         then do:
     2610           find first buf_temp-ot-day
     2611             where buf_temp-ot-day.temp-artic     = buf_ot-line.artic
     2612               and buf_temp-ot-day.temp-prod-type = buf_ot-line.prod-type
     2613               and buf_temp-ot-day.temp-prod-code = buf_ot-line.prod-code
     2614               and buf_temp-ot-day.temp-sum-type  = 'csdt':U + buf_ot-line.ext-doc-type
     2615               and buf_temp-ot-day.temp-cat-id    = '##,##':U
     2616             no-error .
     2617           if not available buf_temp-ot-day
     2618           then do:
     2619             create buf_temp-ot-day .
     2620             assign
     2621               buf_temp-ot-day.temp-artic     = buf_ot-line.artic
     2622               buf_temp-ot-day.temp-prod-type = buf_ot-line.prod-type
     2623               buf_temp-ot-day.temp-prod-code = buf_ot-line.prod-code
     2624               buf_temp-ot-day.temp-sum-type  = 'csdt':U + buf_ot-line.ext-doc-type
     2625               buf_temp-ot-day.temp-cat-id    = '##,##':U
     2626             .
     2627           end.
     2628           assign
     2629             buf_temp-ot-day.temp-fact-qnty      = buf_temp-ot-day.temp-fact-qnty
     2630                                                      + buf_ot-line.fact-qnty
     2631             buf_temp-ot-day.temp-sum-base       = buf_temp-ot-day.temp-sum-base
     2632                                                      + buf_ot-line.sum-base
     2633             buf_temp-ot-day.temp-sum-rubl       = buf_temp-ot-day.temp-sum-rubl
     2634                                                      + buf_ot-line.sum-rubl
     2635             buf_temp-ot-day.temp-VAT-base       = buf_temp-ot-day.temp-VAT-base
     2636                                                      + buf_ot-line.VAT-base
     2637             buf_temp-ot-day.temp-VAT-rubl       = buf_temp-ot-day.temp-VAT-rubl
     2638                                                      + buf_ot-line.VAT-rubl
     2639             buf_temp-ot-day.temp-SLT-base       = buf_temp-ot-day.temp-SLT-base
     2640                                                      + buf_ot-line.SLT-base
     2641             buf_temp-ot-day.temp-SLT-rubl       = buf_temp-ot-day.temp-SLT-rubl
     2642                                                      + buf_ot-line.SLT-rubl
     2643             buf_temp-ot-day.temp-road-tax-base  = buf_temp-ot-day.temp-road-tax-base
     2644                                                      + buf_ot-line.road-tax-base
     2645             buf_temp-ot-day.temp-road-tax-rubl  = buf_temp-ot-day.temp-road-tax-rubl
     2646                                                      + buf_ot-line.road-tax-rubl
     2647             buf_temp-ot-day.temp-excise-base    = buf_temp-ot-day.temp-excise-base
     2648                                                      + buf_ot-line.excise-base
     2649             buf_temp-ot-day.temp-excise-rubl    = buf_temp-ot-day.temp-excise-rubl
     2650                                                      + buf_ot-line.excise-rubl
     2651             buf_temp-ot-day.temp-transport-base = buf_temp-ot-day.temp-transport-base
     2652                                                      + buf_ot-line.transport-base
     2653             buf_temp-ot-day.temp-transport-rubl = buf_temp-ot-day.temp-transport-rubl
     2654                                                      + buf_ot-line.transport-rubl
     2655             buf_temp-ot-day.temp-other-base     = buf_temp-ot-day.temp-other-base
     2656                                                      + buf_ot-line.other-base
     2657             buf_temp-ot-day.temp-other-rubl     = buf_temp-ot-day.temp-other-rubl
     2658                                                      + buf_ot-line.other-rubl
     2659           .
     2660         end.
     2661         if buf_ot-line.sum-type = 'sale':U
     2662         then do:
     2663           find first buf_temp-ot-day
     2664             where buf_temp-ot-day.temp-artic     = buf_ot-line.artic
     2665               and buf_temp-ot-day.temp-prod-type = buf_ot-line.prod-type
     2666               and buf_temp-ot-day.temp-prod-code = buf_ot-line.prod-code
     2667               and buf_temp-ot-day.temp-sum-type  = 'sadt':U + buf_ot-line.ext-doc-type
     2668               and buf_temp-ot-day.temp-cat-id    = '##,##':U
     2669             no-error .
     2670           if not available buf_temp-ot-day
     2671           then do:
     2672             create buf_temp-ot-day .
     2673             assign
     2674               buf_temp-ot-day.temp-artic     = buf_ot-line.artic
     2675               buf_temp-ot-day.temp-prod-type = buf_ot-line.prod-type
     2676               buf_temp-ot-day.temp-prod-code = buf_ot-line.prod-code
     2677               buf_temp-ot-day.temp-sum-type  = 'sadt':U + buf_ot-line.ext-doc-type
     2678               buf_temp-ot-day.temp-cat-id    = '##,##':U
     2679             .
     2680           end.
     2681           assign
     2682             buf_temp-ot-day.temp-fact-qnty      = buf_temp-ot-day.temp-fact-qnty
     2683                                                      + buf_ot-line.fact-qnty
     2684             buf_temp-ot-day.temp-sum-base       = buf_temp-ot-day.temp-sum-base
     2685                                                      + buf_ot-line.sum-base
     2686             buf_temp-ot-day.temp-sum-rubl       = buf_temp-ot-day.temp-sum-rubl
     2687                                                      + buf_ot-line.sum-rubl
     2688             buf_temp-ot-day.temp-VAT-base       = buf_temp-ot-day.temp-VAT-base
     2689                                                      + buf_ot-line.VAT-base
     2690             buf_temp-ot-day.temp-VAT-rubl       = buf_temp-ot-day.temp-VAT-rubl
     2691                                                      + buf_ot-line.VAT-rubl
     2692             buf_temp-ot-day.temp-SLT-base       = buf_temp-ot-day.temp-SLT-base
     2693                                                      + buf_ot-line.SLT-base
     2694             buf_temp-ot-day.temp-SLT-rubl       = buf_temp-ot-day.temp-SLT-rubl
     2695                                                      + buf_ot-line.SLT-rubl
     2696             buf_temp-ot-day.temp-road-tax-base  = buf_temp-ot-day.temp-road-tax-base
     2697                                                      + buf_ot-line.road-tax-base
     2698             buf_temp-ot-day.temp-road-tax-rubl  = buf_temp-ot-day.temp-road-tax-rubl
     2699                                                      + buf_ot-line.road-tax-rubl
     2700             buf_temp-ot-day.temp-excise-base    = buf_temp-ot-day.temp-excise-base
     2701                                                      + buf_ot-line.excise-base
     2702             buf_temp-ot-day.temp-excise-rubl    = buf_temp-ot-day.temp-excise-rubl
     2703                                                      + buf_ot-line.excise-rubl
     2704             buf_temp-ot-day.temp-transport-base = buf_temp-ot-day.temp-transport-base
     2705                                                      + buf_ot-line.transport-base
     2706             buf_temp-ot-day.temp-transport-rubl = buf_temp-ot-day.temp-transport-rubl
     2707                                                      + buf_ot-line.transport-rubl
     2708             buf_temp-ot-day.temp-other-base     = buf_temp-ot-day.temp-other-base
     2709                                                      + buf_ot-line.other-base
     2710             buf_temp-ot-day.temp-other-rubl     = buf_temp-ot-day.temp-other-rubl
     2711                                                      + buf_ot-line.other-rubl
     2712           .
     2713         end.
     2714       end.
     2715     end.
     2716   end procedure.
     2717   procedure validate-stk-line :
     2718     define input  parameter p-fact-date            as date      no-undo .
     2719     define input  parameter p-fact-order-begin-day as decimal   no-undo .
     2720     define input  parameter p-fact-order-end-day   as decimal   no-undo .
     2721     define variable v-fact-qnty      as decimal   no-undo .
     2722     define variable v-sum-base       as decimal   no-undo .
     2723     define variable v-sum-rubl       as decimal   no-undo .
     2724     define variable v-VAT-base       as decimal   no-undo .
     2725     define variable v-VAT-rubl       as decimal   no-undo .
     2726     define variable v-SLT-base       as decimal   no-undo .
     2727     define variable v-SLT-rubl       as decimal   no-undo .
     2728     define variable v-road-tax-base  as decimal   no-undo .
     2729     define variable v-road-tax-rubl  as decimal   no-undo .
     2730     define variable v-excise-base    as decimal   no-undo .
     2731     define variable v-excise-rubl    as decimal   no-undo .
     2732     define variable v-transport-base as decimal   no-undo .
     2733     define variable v-transport-rubl as decimal   no-undo .
     2734     define variable v-other-base     as decimal   no-undo .
     2735     define variable v-other-rubl     as decimal   no-undo .
     2736     define buffer buf_stk-line for ub.stk-line .
     2737     define buffer buf_prev_stk-line for ub.stk-line .
     2738     define buffer buf_temp-ot-day for temp-ot-day .
     2739     do
     2740     on error undo, return error return-value
     2741     :
     2742       for each buf_stk-line no-lock
     2743         where buf_stk-line.obj-type   = p-obj-type
     2744           and buf_stk-line.obj-code   = p-obj-code
     2745           and buf_stk-line.fact-order = p-fact-order-end-day
     2746       on error undo, return error return-value
     2747       :
     2748         if buf_stk-line.sum-type = 'cost':U
     2749         then do:
     2750           assign
     2751             v-fact-qnty      = buf_stk-line.fact-qnty
     2752             v-sum-base       = buf_stk-line.sum-base
     2753             v-sum-rubl       = buf_stk-line.sum-rubl
     2754             v-VAT-base       = buf_stk-line.VAT-base
     2755             v-VAT-rubl       = buf_stk-line.VAT-rubl
     2756             v-SLT-base       = buf_stk-line.SLT-base
     2757             v-SLT-rubl       = buf_stk-line.SLT-rubl
     2758             v-road-tax-base  = buf_stk-line.road-tax-base
     2759             v-road-tax-rubl  = buf_stk-line.road-tax-rubl
     2760             v-excise-base    = buf_stk-line.excise-base
     2761             v-excise-rubl    = buf_stk-line.excise-rubl
     2762             v-transport-base = buf_stk-line.transport-base
     2763             v-transport-rubl = buf_stk-line.transport-rubl
     2764             v-other-base     = buf_stk-line.other-base
     2765             v-other-rubl     = buf_stk-line.other-rubl
     2766           .
     2767           find last buf_prev_stk-line no-lock
     2768             where buf_prev_stk-line.obj-type   = buf_stk-line.obj-type
     2769               and buf_prev_stk-line.obj-code   = buf_stk-line.obj-code
     2770               and buf_prev_stk-line.artic      = buf_stk-line.artic
     2771               and buf_prev_stk-line.prod-type  = buf_stk-line.prod-type
     2772               and buf_prev_stk-line.prod-code  = buf_stk-line.prod-code
     2773               and buf_prev_stk-line.sum-type   = 'cost':U
     2774               and buf_prev_stk-line.cat-id     = '##,##':U
     2775               and buf_prev_stk-line.fact-order < p-fact-order-begin-day
     2776               and buf_prev_stk-line.shift-date = ?
     2777             use-index category
     2778             no-error .
     2779           if  available buf_prev_stk-line
     2780           and buf_stk-line.sum-type <> 'cost':U
     2781           then do:
     2782             define variable v-prev-fact-order as decimal   no-undo .
     2783             assign
     2784               v-prev-fact-order = buf_prev_stk-line.fact-order
     2785             .
     2786             find last buf_prev_stk-line no-lock
     2787               where buf_prev_stk-line.obj-type   = buf_stk-line.obj-type
     2788                 and buf_prev_stk-line.obj-code   = buf_stk-line.obj-code
     2789                 and buf_prev_stk-line.artic      = buf_stk-line.artic
     2790                 and buf_prev_stk-line.prod-type  = buf_stk-line.prod-type
     2791                 and buf_prev_stk-line.prod-code  = buf_stk-line.prod-code
     2792                 and buf_prev_stk-line.sum-type   = buf_stk-line.sum-type
     2793                 and buf_prev_stk-line.cat-id     = buf_stk-line.cat-id
     2794                 and buf_prev_stk-line.fact-order = v-prev-fact-order
     2795                 and buf_prev_stk-line.shift-date = ?
     2796               use-index category
     2797               no-error .
     2798           end.
     2799           if available buf_prev_stk-line
     2800           then do:
     2801             assign
     2802               v-fact-qnty      = v-fact-qnty      - buf_prev_stk-line.fact-qnty
     2803               v-sum-base       = v-sum-base       - buf_prev_stk-line.sum-base
     2804               v-sum-rubl       = v-sum-rubl       - buf_prev_stk-line.sum-rubl
     2805               v-VAT-base       = v-VAT-base       - buf_prev_stk-line.VAT-base
     2806               v-VAT-rubl       = v-VAT-rubl       - buf_prev_stk-line.VAT-rubl
     2807               v-SLT-base       = v-SLT-base       - buf_prev_stk-line.SLT-base
     2808               v-SLT-rubl       = v-SLT-rubl       - buf_prev_stk-line.SLT-rubl
     2809               v-road-tax-base  = v-road-tax-base  - buf_prev_stk-line.road-tax-base
     2810               v-road-tax-rubl  = v-road-tax-rubl  - buf_prev_stk-line.road-tax-rubl
     2811               v-excise-base    = v-excise-base    - buf_prev_stk-line.excise-base
     2812               v-excise-rubl    = v-excise-rubl    - buf_prev_stk-line.excise-rubl
     2813               v-transport-base = v-transport-base - buf_prev_stk-line.transport-base
     2814               v-transport-rubl = v-transport-rubl - buf_prev_stk-line.transport-rubl
     2815               v-other-base     = v-other-base     - buf_prev_stk-line.other-base
     2816               v-other-rubl     = v-other-rubl     - buf_prev_stk-line.other-rubl
     2817             .
     2818           end.
     2819           find first buf_temp-ot-day
     2820             where buf_temp-ot-day.temp-artic     = buf_stk-line.artic
     2821               and buf_temp-ot-day.temp-prod-type = buf_stk-line.prod-type
     2822               and buf_temp-ot-day.temp-prod-code = buf_stk-line.prod-code
     2823               and buf_temp-ot-day.temp-sum-type  = buf_stk-line.sum-type
     2824               and buf_temp-ot-day.temp-cat-id    = buf_stk-line.cat-id
     2825             no-error .
     2826           if available buf_temp-ot-day
     2827           then do:
     2828             assign
     2829               v-fact-qnty      = v-fact-qnty      - buf_temp-ot-day.temp-fact-qnty
     2830               v-sum-base       = v-sum-base       - buf_temp-ot-day.temp-sum-base
     2831               v-sum-rubl       = v-sum-rubl       - buf_temp-ot-day.temp-sum-rubl
     2832               v-VAT-base       = v-VAT-base       - buf_temp-ot-day.temp-VAT-base
     2833               v-VAT-rubl       = v-VAT-rubl       - buf_temp-ot-day.temp-VAT-rubl
     2834               v-SLT-base       = v-SLT-base       - buf_temp-ot-day.temp-SLT-base
     2835               v-SLT-rubl       = v-SLT-rubl       - buf_temp-ot-day.temp-SLT-rubl
     2836               v-road-tax-base  = v-road-tax-base  - buf_temp-ot-day.temp-road-tax-base
     2837               v-road-tax-rubl  = v-road-tax-rubl  - buf_temp-ot-day.temp-road-tax-rubl
     2838               v-excise-base    = v-excise-base    - buf_temp-ot-day.temp-excise-base
     2839               v-excise-rubl    = v-excise-rubl    - buf_temp-ot-day.temp-excise-rubl
     2840               v-transport-base = v-transport-base - buf_temp-ot-day.temp-transport-base
     2841               v-transport-rubl = v-transport-rubl - buf_temp-ot-day.temp-transport-rubl
     2842               v-other-base     = v-other-base     - buf_temp-ot-day.temp-other-base
     2843               v-other-rubl     = v-other-rubl     - buf_temp-ot-day.temp-other-rubl
     2844             .
     2845           end.
     2846           if v-fact-qnty      <> 0
     2847           or v-sum-base       <> 0
     2848           or v-sum-rubl       <> 0
     2849           or v-VAT-base       <> 0
     2850           or v-VAT-rubl       <> 0
     2851           or v-SLT-base       <> 0
     2852           or v-SLT-rubl       <> 0
     2853           or v-road-tax-base  <> 0
     2854           or v-road-tax-rubl  <> 0
     2855           or v-excise-base    <> 0
     2856           or v-excise-rubl    <> 0
     2857           or v-transport-base <> 0
     2858           or v-transport-rubl <> 0
     2859           or v-other-base     <> 0
     2860           or v-other-rubl     <> 0
     2861           then do:
     2862             assign
     2863               v-total-err = v-total-err + 1
     2864             .
     2865             run cur-time in this-procedure
     2866               (output v-today
     2867               ,output v-time
     2868               ) .
     2869             run update-last-date in this-procedure
     2870               (input buf_stk-line.fact-date
     2871               ) .
     2872             output stream sout to value(v-log-err-file) append .
     2873             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     2874             export stream sout "error-03: stk-line record different quantity" .
     2875             export stream sout "obj-type"       buf_stk-line.obj-type       .
     2876             export stream sout "obj-code"       buf_stk-line.obj-code       .
     2877             export stream sout "fact-date"      buf_stk-line.fact-date      .
     2878             export stream sout "artic"          buf_stk-line.artic          .
     2879             export stream sout "prod-type"      buf_stk-line.prod-type      .
     2880             export stream sout "prod-code"      buf_stk-line.prod-code      .
     2881             export stream sout "sum-type"       buf_stk-line.sum-type       .
     2882             export stream sout "cat-id"         buf_stk-line.cat-id         .
     2883             export stream sout "fact-order"     buf_stk-line.fact-order     .
     2884             export stream sout "fact-qnty"      buf_stk-line.fact-qnty      .
     2885             export stream sout "sum-base"       buf_stk-line.sum-base       .
     2886             export stream sout "sum-rubl"       buf_stk-line.sum-rubl       .
     2887             export stream sout "VAT-base"       buf_stk-line.VAT-base       .
     2888             export stream sout "VAT-rubl"       buf_stk-line.VAT-rubl       .
     2889             export stream sout "SLT-base"       buf_stk-line.SLT-base       .
     2890             export stream sout "SLT-rubl"       buf_stk-line.SLT-rubl       .
     2891             export stream sout "road-tax-base"  buf_stk-line.road-tax-base  .
     2892             export stream sout "road-tax-rubl"  buf_stk-line.road-tax-rubl  .
     2893             export stream sout "excise-base"    buf_stk-line.excise-base    .
     2894             export stream sout "excise-rubl"    buf_stk-line.excise-rubl    .
     2895             export stream sout "transport-base" buf_stk-line.transport-base .
     2896             export stream sout "transport-rubl" buf_stk-line.transport-rubl .
     2897             export stream sout "other-base"     buf_stk-line.other-base     .
     2898             export stream sout "other-rubl"     buf_stk-line.other-rubl     .
     2899             output stream sout close .
     2900           end.
     2901         end.
     2902         if buf_stk-line.sum-type begins 'sadt':U
     2903         then do:
     2904           assign
     2905             v-fact-qnty      = buf_stk-line.fact-qnty
     2906             v-sum-base       = buf_stk-line.sum-base
     2907             v-sum-rubl       = buf_stk-line.sum-rubl
     2908             v-VAT-base       = buf_stk-line.VAT-base
     2909             v-VAT-rubl       = buf_stk-line.VAT-rubl
     2910             v-SLT-base       = buf_stk-line.SLT-base
     2911             v-SLT-rubl       = buf_stk-line.SLT-rubl
     2912             v-road-tax-base  = buf_stk-line.road-tax-base
     2913             v-road-tax-rubl  = buf_stk-line.road-tax-rubl
     2914             v-excise-base    = buf_stk-line.excise-base
     2915             v-excise-rubl    = buf_stk-line.excise-rubl
     2916             v-transport-base = buf_stk-line.transport-base
     2917             v-transport-rubl = buf_stk-line.transport-rubl
     2918             v-other-base     = buf_stk-line.other-base
     2919             v-other-rubl     = buf_stk-line.other-rubl
     2920           .
     2921           find last buf_prev_stk-line no-lock
     2922             where buf_prev_stk-line.obj-type   = buf_stk-line.obj-type
     2923               and buf_prev_stk-line.obj-code   = buf_stk-line.obj-code
     2924               and buf_prev_stk-line.artic      = buf_stk-line.artic
     2925               and buf_prev_stk-line.prod-type  = buf_stk-line.prod-type
     2926               and buf_prev_stk-line.prod-code  = buf_stk-line.prod-code
     2927               and buf_prev_stk-line.sum-type   = buf_stk-line.sum-type
     2928               and buf_prev_stk-line.cat-id     = buf_stk-line.cat-id
     2929               and buf_prev_stk-line.fact-order < p-fact-order-begin-day
     2930               and buf_prev_stk-line.shift-date = ?
     2931             use-index category
     2932             no-error .
     2933           if available buf_prev_stk-line
     2934           then do:
     2935             assign
     2936               v-fact-qnty      = v-fact-qnty      - buf_prev_stk-line.fact-qnty
     2937               v-sum-base       = v-sum-base       - buf_prev_stk-line.sum-base
     2938               v-sum-rubl       = v-sum-rubl       - buf_prev_stk-line.sum-rubl
     2939               v-VAT-base       = v-VAT-base       - buf_prev_stk-line.VAT-base
     2940               v-VAT-rubl       = v-VAT-rubl       - buf_prev_stk-line.VAT-rubl
     2941               v-SLT-base       = v-SLT-base       - buf_prev_stk-line.SLT-base
     2942               v-SLT-rubl       = v-SLT-rubl       - buf_prev_stk-line.SLT-rubl
     2943               v-road-tax-base  = v-road-tax-base  - buf_prev_stk-line.road-tax-base
     2944               v-road-tax-rubl  = v-road-tax-rubl  - buf_prev_stk-line.road-tax-rubl
     2945               v-excise-base    = v-excise-base    - buf_prev_stk-line.excise-base
     2946               v-excise-rubl    = v-excise-rubl    - buf_prev_stk-line.excise-rubl
     2947               v-transport-base = v-transport-base - buf_prev_stk-line.transport-base
     2948               v-transport-rubl = v-transport-rubl - buf_prev_stk-line.transport-rubl
     2949               v-other-base     = v-other-base     - buf_prev_stk-line.other-base
     2950               v-other-rubl     = v-other-rubl     - buf_prev_stk-line.other-rubl
     2951             .
     2952           end.
     2953           find first buf_temp-ot-day
     2954             where buf_temp-ot-day.temp-artic     = buf_stk-line.artic
     2955               and buf_temp-ot-day.temp-prod-type = buf_stk-line.prod-type
     2956               and buf_temp-ot-day.temp-prod-code = buf_stk-line.prod-code
     2957               and buf_temp-ot-day.temp-sum-type  = buf_stk-line.sum-type
     2958               and buf_temp-ot-day.temp-cat-id    = buf_stk-line.cat-id
     2959             no-error .
     2960           if available buf_temp-ot-day
     2961           then do:
     2962             assign
     2963               v-fact-qnty      = v-fact-qnty      - buf_temp-ot-day.temp-fact-qnty
     2964               v-sum-base       = v-sum-base       - buf_temp-ot-day.temp-sum-base
     2965               v-sum-rubl       = v-sum-rubl       - buf_temp-ot-day.temp-sum-rubl
     2966               v-VAT-base       = v-VAT-base       - buf_temp-ot-day.temp-VAT-base
     2967               v-VAT-rubl       = v-VAT-rubl       - buf_temp-ot-day.temp-VAT-rubl
     2968               v-SLT-base       = v-SLT-base       - buf_temp-ot-day.temp-SLT-base
     2969               v-SLT-rubl       = v-SLT-rubl       - buf_temp-ot-day.temp-SLT-rubl
     2970               v-road-tax-base  = v-road-tax-base  - buf_temp-ot-day.temp-road-tax-base
     2971               v-road-tax-rubl  = v-road-tax-rubl  - buf_temp-ot-day.temp-road-tax-rubl
     2972               v-excise-base    = v-excise-base    - buf_temp-ot-day.temp-excise-base
     2973               v-excise-rubl    = v-excise-rubl    - buf_temp-ot-day.temp-excise-rubl
     2974               v-transport-base = v-transport-base - buf_temp-ot-day.temp-transport-base
     2975               v-transport-rubl = v-transport-rubl - buf_temp-ot-day.temp-transport-rubl
     2976               v-other-base     = v-other-base     - buf_temp-ot-day.temp-other-base
     2977               v-other-rubl     = v-other-rubl     - buf_temp-ot-day.temp-other-rubl
     2978             .
     2979           end.
     2980           if v-fact-qnty      <> 0
     2981           or v-sum-base       <> 0
     2982           or v-sum-rubl       <> 0
     2983           or v-VAT-base       <> 0
     2984           or v-VAT-rubl       <> 0
     2985           or v-SLT-base       <> 0
     2986           or v-SLT-rubl       <> 0
     2987           or v-road-tax-base  <> 0
     2988           or v-road-tax-rubl  <> 0
     2989           or v-excise-base    <> 0
     2990           or v-excise-rubl    <> 0
     2991           or v-transport-base <> 0
     2992           or v-transport-rubl <> 0
     2993           or v-other-base     <> 0
     2994           or v-other-rubl     <> 0
     2995           then do:
     2996             assign
     2997               v-total-err = v-total-err + 1
     2998             .
     2999             run cur-time in this-procedure
     3000               (output v-today
     3001               ,output v-time
     3002               ) .
     3003             run update-last-date in this-procedure
     3004               (input buf_stk-line.fact-date
     3005               ) .
     3006             output stream sout to value(v-log-err-file) append .
     3007             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3008             export stream sout "error-04: stk-line record different quantity" .
     3009             export stream sout "obj-type"       buf_stk-line.obj-type       .
     3010             export stream sout "obj-code"       buf_stk-line.obj-code       .
     3011             export stream sout "fact-date"      buf_stk-line.fact-date      .
     3012             export stream sout "artic"          buf_stk-line.artic          .
     3013             export stream sout "prod-type"      buf_stk-line.prod-type      .
     3014             export stream sout "prod-code"      buf_stk-line.prod-code      .
     3015             export stream sout "sum-type"       buf_stk-line.sum-type       .
     3016             export stream sout "cat-id"         buf_stk-line.cat-id         .
     3017             export stream sout "fact-order"     buf_stk-line.fact-order     .
     3018             export stream sout "fact-qnty"      buf_stk-line.fact-qnty      .
     3019             export stream sout "sum-base"       buf_stk-line.sum-base       .
     3020             export stream sout "sum-rubl"       buf_stk-line.sum-rubl       .
     3021             export stream sout "VAT-base"       buf_stk-line.VAT-base       .
     3022             export stream sout "VAT-rubl"       buf_stk-line.VAT-rubl       .
     3023             export stream sout "SLT-base"       buf_stk-line.SLT-base       .
     3024             export stream sout "SLT-rubl"       buf_stk-line.SLT-rubl       .
     3025             export stream sout "road-tax-base"  buf_stk-line.road-tax-base  .
     3026             export stream sout "road-tax-rubl"  buf_stk-line.road-tax-rubl  .
     3027             export stream sout "excise-base"    buf_stk-line.excise-base    .
     3028             export stream sout "excise-rubl"    buf_stk-line.excise-rubl    .
     3029             export stream sout "transport-base" buf_stk-line.transport-base .
     3030             export stream sout "transport-rubl" buf_stk-line.transport-rubl .
     3031             export stream sout "other-base"     buf_stk-line.other-base     .
     3032             export stream sout "other-rubl"     buf_stk-line.other-rubl     .
     3033             output stream sout close .
     3034           end.
     3035         end.
     3036         if buf_stk-line.sum-type begins 'csdt':U
     3037         then do:
     3038           assign
     3039             v-fact-qnty      = buf_stk-line.fact-qnty
     3040             v-sum-base       = buf_stk-line.sum-base
     3041             v-sum-rubl       = buf_stk-line.sum-rubl
     3042             v-VAT-base       = buf_stk-line.VAT-base
     3043             v-VAT-rubl       = buf_stk-line.VAT-rubl
     3044             v-SLT-base       = buf_stk-line.SLT-base
     3045             v-SLT-rubl       = buf_stk-line.SLT-rubl
     3046             v-road-tax-base  = buf_stk-line.road-tax-base
     3047             v-road-tax-rubl  = buf_stk-line.road-tax-rubl
     3048             v-excise-base    = buf_stk-line.excise-base
     3049             v-excise-rubl    = buf_stk-line.excise-rubl
     3050             v-transport-base = buf_stk-line.transport-base
     3051             v-transport-rubl = buf_stk-line.transport-rubl
     3052             v-other-base     = buf_stk-line.other-base
     3053             v-other-rubl     = buf_stk-line.other-rubl
     3054           .
     3055           find last buf_prev_stk-line no-lock
     3056             where buf_prev_stk-line.obj-type   = buf_stk-line.obj-type
     3057               and buf_prev_stk-line.obj-code   = buf_stk-line.obj-code
     3058               and buf_prev_stk-line.artic      = buf_stk-line.artic
     3059               and buf_prev_stk-line.prod-type  = buf_stk-line.prod-type
     3060               and buf_prev_stk-line.prod-code  = buf_stk-line.prod-code
     3061               and buf_prev_stk-line.sum-type   = buf_stk-line.sum-type
     3062               and buf_prev_stk-line.cat-id     = buf_stk-line.cat-id
     3063               and buf_prev_stk-line.fact-order < p-fact-order-begin-day
     3064               and buf_prev_stk-line.shift-date = ?
     3065             use-index category
     3066             no-error .
     3067           if available buf_prev_stk-line
     3068           then do:
     3069             assign
     3070               v-fact-qnty      = v-fact-qnty      - buf_prev_stk-line.fact-qnty
     3071               v-sum-base       = v-sum-base       - buf_prev_stk-line.sum-base
     3072               v-sum-rubl       = v-sum-rubl       - buf_prev_stk-line.sum-rubl
     3073               v-VAT-base       = v-VAT-base       - buf_prev_stk-line.VAT-base
     3074               v-VAT-rubl       = v-VAT-rubl       - buf_prev_stk-line.VAT-rubl
     3075               v-SLT-base       = v-SLT-base       - buf_prev_stk-line.SLT-base
     3076               v-SLT-rubl       = v-SLT-rubl       - buf_prev_stk-line.SLT-rubl
     3077               v-road-tax-base  = v-road-tax-base  - buf_prev_stk-line.road-tax-base
     3078               v-road-tax-rubl  = v-road-tax-rubl  - buf_prev_stk-line.road-tax-rubl
     3079               v-excise-base    = v-excise-base    - buf_prev_stk-line.excise-base
     3080               v-excise-rubl    = v-excise-rubl    - buf_prev_stk-line.excise-rubl
     3081               v-transport-base = v-transport-base - buf_prev_stk-line.transport-base
     3082               v-transport-rubl = v-transport-rubl - buf_prev_stk-line.transport-rubl
     3083               v-other-base     = v-other-base     - buf_prev_stk-line.other-base
     3084               v-other-rubl     = v-other-rubl     - buf_prev_stk-line.other-rubl
     3085             .
     3086           end.
     3087           find first buf_temp-ot-day
     3088             where buf_temp-ot-day.temp-artic     = buf_stk-line.artic
     3089               and buf_temp-ot-day.temp-prod-type = buf_stk-line.prod-type
     3090               and buf_temp-ot-day.temp-prod-code = buf_stk-line.prod-code
     3091               and buf_temp-ot-day.temp-sum-type  = buf_stk-line.sum-type
     3092               and buf_temp-ot-day.temp-cat-id    = buf_stk-line.cat-id
     3093             no-error .
     3094           if available buf_temp-ot-day
     3095           then do:
     3096             assign
     3097               v-fact-qnty      = v-fact-qnty      - buf_temp-ot-day.temp-fact-qnty
     3098               v-sum-base       = v-sum-base       - buf_temp-ot-day.temp-sum-base
     3099               v-sum-rubl       = v-sum-rubl       - buf_temp-ot-day.temp-sum-rubl
     3100               v-VAT-base       = v-VAT-base       - buf_temp-ot-day.temp-VAT-base
     3101               v-VAT-rubl       = v-VAT-rubl       - buf_temp-ot-day.temp-VAT-rubl
     3102               v-SLT-base       = v-SLT-base       - buf_temp-ot-day.temp-SLT-base
     3103               v-SLT-rubl       = v-SLT-rubl       - buf_temp-ot-day.temp-SLT-rubl
     3104               v-road-tax-base  = v-road-tax-base  - buf_temp-ot-day.temp-road-tax-base
     3105               v-road-tax-rubl  = v-road-tax-rubl  - buf_temp-ot-day.temp-road-tax-rubl
     3106               v-excise-base    = v-excise-base    - buf_temp-ot-day.temp-excise-base
     3107               v-excise-rubl    = v-excise-rubl    - buf_temp-ot-day.temp-excise-rubl
     3108               v-transport-base = v-transport-base - buf_temp-ot-day.temp-transport-base
     3109               v-transport-rubl = v-transport-rubl - buf_temp-ot-day.temp-transport-rubl
     3110               v-other-base     = v-other-base     - buf_temp-ot-day.temp-other-base
     3111               v-other-rubl     = v-other-rubl     - buf_temp-ot-day.temp-other-rubl
     3112             .
     3113           end.
     3114           if v-fact-qnty      <> 0
     3115           or v-sum-base       <> 0
     3116           or v-sum-rubl       <> 0
     3117           or v-VAT-base       <> 0
     3118           or v-VAT-rubl       <> 0
     3119           or v-SLT-base       <> 0
     3120           or v-SLT-rubl       <> 0
     3121           or v-road-tax-base  <> 0
     3122           or v-road-tax-rubl  <> 0
     3123           or v-excise-base    <> 0
     3124           or v-excise-rubl    <> 0
     3125           or v-transport-base <> 0
     3126           or v-transport-rubl <> 0
     3127           or v-other-base     <> 0
     3128           or v-other-rubl     <> 0
     3129           then do:
     3130             assign
     3131               v-total-err = v-total-err + 1
     3132             .
     3133             run cur-time in this-procedure
     3134               (output v-today
     3135               ,output v-time
     3136               ) .
     3137             run update-last-date in this-procedure
     3138               (input buf_stk-line.fact-date
     3139               ) .
     3140             output stream sout to value(v-log-err-file) append .
     3141             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3142             export stream sout "error-05: stk-line record different quantity" .
     3143             export stream sout "obj-type"       buf_stk-line.obj-type       .
     3144             export stream sout "obj-code"       buf_stk-line.obj-code       .
     3145             export stream sout "fact-date"      buf_stk-line.fact-date      .
     3146             export stream sout "artic"          buf_stk-line.artic          .
     3147             export stream sout "prod-type"      buf_stk-line.prod-type      .
     3148             export stream sout "prod-code"      buf_stk-line.prod-code      .
     3149             export stream sout "sum-type"       buf_stk-line.sum-type       .
     3150             export stream sout "cat-id"         buf_stk-line.cat-id         .
     3151             export stream sout "fact-order"     buf_stk-line.fact-order     .
     3152             export stream sout "fact-qnty"      buf_stk-line.fact-qnty      .
     3153             export stream sout "sum-base"       buf_stk-line.sum-base       .
     3154             export stream sout "sum-rubl"       buf_stk-line.sum-rubl       .
     3155             export stream sout "VAT-base"       buf_stk-line.VAT-base       .
     3156             export stream sout "VAT-rubl"       buf_stk-line.VAT-rubl       .
     3157             export stream sout "SLT-base"       buf_stk-line.SLT-base       .
     3158             export stream sout "SLT-rubl"       buf_stk-line.SLT-rubl       .
     3159             export stream sout "road-tax-base"  buf_stk-line.road-tax-base  .
     3160             export stream sout "road-tax-rubl"  buf_stk-line.road-tax-rubl  .
     3161             export stream sout "excise-base"    buf_stk-line.excise-base    .
     3162             export stream sout "excise-rubl"    buf_stk-line.excise-rubl    .
     3163             export stream sout "transport-base" buf_stk-line.transport-base .
     3164             export stream sout "transport-rubl" buf_stk-line.transport-rubl .
     3165             export stream sout "other-base"     buf_stk-line.other-base     .
     3166             export stream sout "other-rubl"     buf_stk-line.other-rubl     .
     3167             output stream sout close .
     3168           end.
     3169         end.
     3170       end.
     3171     end.
     3172   end procedure.
     3173   procedure validate-free-zone :
     3174     define buffer buf_gds-obj for ub.gds-obj .
     3175     define buffer buf_lock_gds-obj for ub.gds-obj .
     3176     define buffer buf_stk-line for ub.stk-line .
     3177     define buffer buf_temp-stk-line for temp-stk-line .
     3178     define buffer buf_temp-parts for temp-parts .
     3179     define buffer buf_goods for ub.goods .
     3180     define variable v-ind as integer   no-undo .
     3181     do
     3182     on error undo, return error return-value
     3183     :
     3184       for each buf_gds-obj no-lock
     3185         where buf_gds-obj.obj-type = p-obj-type
     3186           and buf_gds-obj.obj-code = p-obj-code
     3187       on error undo, return error return-value
     3188       :
     3189         assign
     3190           v-ind = v-ind + 1
     3191         .
     3192         if v-ind modulo 10 = 0
     3193         then do:
     3194           run waitfram-show in this-procedure
     3195             (input substitute("Проверка 01. Ошибок &1. Объект &2 &3. Артикул &4 &5 &6."
     3196                             ,v-total-err
     3197                             ,p-obj-type
     3198                             ,p-obj-code
     3199                             ,buf_gds-obj.artic
     3200                             ,buf_gds-obj.prod-type
     3201                             ,buf_gds-obj.prod-code
     3202                             )
     3203             ).
     3204         end.
     3205         run clear-temp-stk-line in this-procedure .
     3206         run partslib-clear-temp-parts in this-procedure .
     3207         do transaction
     3208         on error undo, return error return-value
     3209         :
     3210           find buf_lock_gds-obj exclusive-lock
     3211             where rowid(buf_lock_gds-obj) = rowid(buf_gds-obj)
     3212             .
     3213           run partslib-init-temp-parts in this-procedure
     3214             (input  buf_gds-obj.obj-type
     3215             ,input  buf_gds-obj.obj-code
     3216             ,input  buf_gds-obj.artic
     3217             ,input  buf_gds-obj.prod-type
     3218             ,input  buf_gds-obj.prod-code
     3219             ) .
     3220         end.
     3221         define variable v-sum-type as character no-undo .
     3222         find first buf_goods no-lock
     3223           where buf_goods.gds-code = buf_gds-obj.gds-code
     3224           no-error .
     3225         if not available buf_goods
     3226         then do:
     3227           assign
     3228             v-total-err = v-total-err + 1
     3229           .
     3230           run cur-time in this-procedure
     3231             (output v-today
     3232             ,output v-time
     3233             ) .
     3234           run update-last-date in this-procedure
     3235             (input v-today
     3236             ) .
     3237           output stream sout to value(v-log-err-file) append .
     3238           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3239           export stream sout "error-06: ub.goods not found"      .
     3240           export stream sout "obj-type"  p-obj-type           .
     3241           export stream sout "obj-code"  p-obj-code           .
     3242           export stream sout "gds-code"  buf_gds-obj.gds-code .
     3243           output stream sout close .
     3244         end.
     3245         if buf_goods.gds-type = 'т':U
     3246         then do:
     3247           for each buf_temp-parts
     3248           on error undo, return error return-value
     3249           :
     3250             find first buf_temp-stk-line
     3251               where buf_temp-stk-line.temp-artic     = buf_gds-obj.artic
     3252                 and buf_temp-stk-line.temp-prod-type = buf_gds-obj.prod-type
     3253                 and buf_temp-stk-line.temp-prod-code = buf_gds-obj.prod-code
     3254               no-error .
     3255             if not available buf_temp-stk-line
     3256             then do:
     3257               create buf_temp-stk-line .
     3258               assign
     3259                 buf_temp-stk-line.temp-artic     = buf_gds-obj.artic
     3260                 buf_temp-stk-line.temp-prod-type = buf_gds-obj.prod-type
     3261                 buf_temp-stk-line.temp-prod-code = buf_gds-obj.prod-code
     3262               .
     3263             end.
     3264             assign
     3265               buf_temp-stk-line.temp-fact-qnty = buf_temp-stk-line.temp-fact-qnty
     3266                                                + buf_temp-parts.fact-qnty
     3267             .
     3268           end.
     3269         end.
     3270         else do:
     3271           find first buf_temp-stk-line
     3272             where buf_temp-stk-line.temp-artic     = buf_gds-obj.artic
     3273               and buf_temp-stk-line.temp-prod-type = buf_gds-obj.prod-type
     3274               and buf_temp-stk-line.temp-prod-code = buf_gds-obj.prod-code
     3275             no-error .
     3276           if not available buf_temp-stk-line
     3277           then do:
     3278             create buf_temp-stk-line .
     3279             assign
     3280               buf_temp-stk-line.temp-artic     = buf_gds-obj.artic
     3281               buf_temp-stk-line.temp-prod-type = buf_gds-obj.prod-type
     3282               buf_temp-stk-line.temp-prod-code = buf_gds-obj.prod-code
     3283             .
     3284           end.
     3285           assign
     3286             buf_temp-stk-line.temp-fact-qnty = buf_temp-stk-line.temp-fact-qnty
     3287                                              + buf_gds-obj.fact-qnty
     3288           .
     3289         end.
     3290         for each buf_temp-stk-line
     3291         on error undo, return error return-value
     3292         :
     3293           find last buf_stk-line no-lock
     3294             where buf_stk-line.obj-type   = p-obj-type
     3295               and buf_stk-line.obj-code   = p-obj-code
     3296               and buf_stk-line.artic      = buf_temp-stk-line.temp-artic
     3297               and buf_stk-line.prod-type  = buf_temp-stk-line.temp-prod-type
     3298               and buf_stk-line.prod-code  = buf_temp-stk-line.temp-prod-code
     3299               and buf_stk-line.sum-type   = 'cost':U
     3300               and buf_stk-line.cat-id     = '##,##':U
     3301               and buf_stk-line.shift-date = ?
     3302             use-index category
     3303             no-error .
     3304           if (available buf_stk-line
     3305               and buf_temp-stk-line.temp-fact-qnty <> buf_stk-line.fact-qnty
     3306              )
     3307           or (not available buf_stk-line
     3308               and buf_temp-stk-line.temp-fact-qnty <> 0
     3309              )
     3310           then do:
     3311             assign
     3312               v-total-err = v-total-err + 1
     3313             .
     3314             run cur-time in this-procedure
     3315               (output v-today
     3316               ,output v-time
     3317               ) .
     3318             run update-last-date in this-procedure
     3319               (input v-today
     3320               ) .
     3321             output stream sout to value(v-log-err-file) append .
     3322             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3323             export stream sout "error-07: gds-obj stk-line different fact-qnty"   .
     3324             export stream sout "obj-type"  p-obj-type                             .
     3325             export stream sout "obj-code"  p-obj-code                             .
     3326             export stream sout "fact-date" v-today                                .
     3327             export stream sout "artic"     buf_temp-stk-line.temp-artic           .
     3328             export stream sout "prod-type" buf_temp-stk-line.temp-prod-type       .
     3329             export stream sout "prod-code" buf_temp-stk-line.temp-prod-code       .
     3330             export stream sout "parts.fact-qnty" buf_temp-stk-line.temp-fact-qnty .
     3331             if available buf_stk-line
     3332             then do:
     3333               export stream sout "stk-line.fact-qnty" buf_stk-line.fact-qnty .
     3334             end.
     3335             output stream sout close .
     3336           end.
     3337         end.
     3338       end.
     3339     end.
     3340   end procedure.
     3341   procedure update-last-date :
     3342     define input  parameter p-update-date as date      no-undo .
     3343     do
     3344     on error undo, return error return-value
     3345     :
     3346       if p-last-date = ?
     3347       or p-last-date < p-update-date
     3348       then do:
     3349         assign
     3350           p-last-date = p-update-date
     3351         .
     3352       end.
     3353     end.
     3354   end procedure.
     3355   procedure clear-temp-stk-line :
     3356     define buffer buf_temp-stk-line for temp-stk-line .
     3357     do
     3358     on error undo, return error return-value
     3359     :
     3360       for each buf_temp-stk-line
     3361       on error undo, return error return-value
     3362       :
     3363         delete buf_temp-stk-line .
     3364       end.
     3365     end.
     3366   end procedure.
     3367   procedure check-fact-order :
     3368     define buffer buf_stk-line for ub.stk-line .
     3369     define variable v-ind as integer   no-undo .
     3370     do
     3371     on error undo, return error return-value
     3372     :
     3373       for each buf_stk-line no-lock
     3374         where buf_stk-line.obj-type = p-obj-type
     3375           and buf_stk-line.obj-code = p-obj-code
     3376       on error undo, return error return-value
     3377       :
     3378         assign
     3379           v-ind = v-ind + 1
     3380         .
     3381         if v-ind modulo 10 = 0
     3382         then do:
     3383           run waitfram-show in this-procedure
     3384             (input substitute("Проверка 02. Ошибок &1. Объект &2 &3. Записей &4."
     3385                             ,v-total-err
     3386                             ,p-obj-type
     3387                             ,p-obj-code
     3388                             ,v-ind
     3389                             )
     3390             ).
     3391         end.
     3392         define variable v-factord-date as date      no-undo .
     3393         run factord-to-date in this-procedure
     3394           (input  buf_stk-line.fact-order
     3395           ,output v-factord-date
     3396           ) .
     3397         if truncate(buf_stk-line.fact-order, 2) <> buf_stk-line.fact-order
     3398         or buf_stk-line.fact-date               <> v-factord-date
     3399         then do:
     3400           assign
     3401             v-total-err = v-total-err + 1
     3402           .
     3403           run update-last-date in this-procedure
     3404             (input buf_stk-line.fact-date
     3405             ) .
     3406           run update-last-date in this-procedure
     3407             (input v-factord-date
     3408             ) .
     3409           output stream sout to value(v-log-err-file) append .
     3410           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3411           export stream sout "error-08: fact-order"                .
     3412           export stream sout "obj-type"    buf_stk-line.obj-type   .
     3413           export stream sout "obj-code"    buf_stk-line.obj-code   .
     3414           export stream sout "artic"       buf_stk-line.artic      .
     3415           export stream sout "prod-type"   buf_stk-line.prod-type  .
     3416           export stream sout "prod-code"   buf_stk-line.prod-code  .
     3417           export stream sout "fact-order"  buf_stk-line.fact-order .
     3418           export stream sout "sum-type"    buf_stk-line.sum-type   .
     3419           export stream sout "cat-id"      buf_stk-line.cat-id     .
     3420           export stream sout "fact-date"   buf_stk-line.fact-date  .
     3421           export stream sout "v-factord-date" v-factord-date .
     3422           export stream sout "stk-line" .
     3423           export stream sout buf_stk-line .
     3424           output stream sout close .
     3425         end.
     3426       end.
     3427     end.
     3428   end procedure.
     3429   procedure fill-temp-stk-line :
     3430     define buffer buf_stk-line for ub.stk-line .
     3431     define buffer buf_temp-stk-line for temp-stk-line .
     3432     define buffer buf_temp-gds for temp-gds .
     3433     define variable v-ind as integer   no-undo .
     3434     do
     3435     on error undo, return error return-value
     3436     :
     3437       for each buf_stk-line no-lock
     3438         where buf_stk-line.obj-type = p-obj-type
     3439           and buf_stk-line.obj-code = p-obj-code
     3440           and buf_stk-line.sum-type = 'cost':U
     3441       on error undo, return error return-value
     3442       :
     3443         assign
     3444           v-ind = v-ind + 1
     3445         .
     3446         if v-ind modulo 10 = 0
     3447         then do:
     3448           run waitfram-show in this-procedure
     3449             (input substitute("Проверка 03. Ошибок &1. Объект &2 &3. Записей &4."
     3450                             ,v-total-err
     3451                             ,p-obj-type
     3452                             ,p-obj-code
     3453                             ,v-ind
     3454                             )
     3455             ).
     3456         end.
     3457         find first buf_temp-stk-line
     3458           where buf_temp-stk-line.temp-artic     = buf_stk-line.artic
     3459             and buf_temp-stk-line.temp-prod-type = buf_stk-line.prod-type
     3460             and buf_temp-stk-line.temp-prod-code = buf_stk-line.prod-code
     3461           no-error .
     3462         if not available buf_temp-stk-line
     3463         then do:
     3464           create buf_temp-stk-line .
     3465           assign
     3466             buf_temp-stk-line.temp-artic          = buf_stk-line.artic
     3467             buf_temp-stk-line.temp-prod-type      = buf_stk-line.prod-type
     3468             buf_temp-stk-line.temp-prod-code      = buf_stk-line.prod-code
     3469             buf_temp-stk-line.temp-fact-order     = buf_stk-line.fact-order
     3470             buf_temp-stk-line.temp-fact-qnty      = buf_stk-line.fact-qnty
     3471           .
     3472         end.
     3473         if buf_temp-stk-line.temp-fact-order < buf_stk-line.fact-order
     3474         then do:
     3475           assign
     3476             buf_temp-stk-line.temp-fact-order     = buf_stk-line.fact-order
     3477             buf_temp-stk-line.temp-fact-qnty      = buf_stk-line.fact-qnty
     3478           .
     3479         end.
     3480         find first buf_temp-gds
     3481           where buf_temp-gds.temp-artic      = buf_stk-line.artic
     3482             and buf_temp-gds.temp-prod-type  = buf_stk-line.prod-type
     3483             and buf_temp-gds.temp-prod-code  = buf_stk-line.prod-code
     3484           no-error .
     3485         if not available buf_temp-gds
     3486         then do:
     3487           create buf_temp-gds .
     3488           assign
     3489             buf_temp-gds.temp-artic      = buf_stk-line.artic
     3490             buf_temp-gds.temp-prod-type  = buf_stk-line.prod-type
     3491             buf_temp-gds.temp-prod-code  = buf_stk-line.prod-code
     3492           .
     3493         end.
     3494       end.
     3495     end.
     3496   end procedure.
     3497   procedure check-free-zone-from-stk-line :
     3498     define buffer buf_lock_gds-obj for ub.gds-obj .
     3499     define buffer buf_temp-gds for temp-gds .
     3500     define buffer buf_temp-stk-line for temp-stk-line .
     3501     define buffer buf_temp-parts for temp-parts .
     3502     define variable v-ind as integer   no-undo .
     3503     do
     3504     on error undo, return error return-value
     3505     :
     3506       for each buf_temp-gds
     3507       on error undo, return error return-value
     3508       :
     3509         assign
     3510           v-ind = v-ind + 1
     3511         .
     3512         if v-ind modulo 10 = 0
     3513         then do:
     3514           run waitfram-show in this-procedure
     3515             (input substitute("Проверка 04. Ошибок &1. Объект &2 &3. Артикул &4 &5 &6."
     3516                             ,v-total-err
     3517                             ,p-obj-type
     3518                             ,p-obj-code
     3519                             ,buf_temp-gds.temp-artic
     3520                             ,buf_temp-gds.temp-prod-type
     3521                             ,buf_temp-gds.temp-prod-code
     3522                             )
     3523             ).
     3524         end.
     3525         run partslib-clear-temp-parts in this-procedure .
     3526         do transaction
     3527         on error undo, return error return-value
     3528         :
     3529           find buf_lock_gds-obj exclusive-lock
     3530             where buf_lock_gds-obj.obj-type  = p-obj-type
     3531               and buf_lock_gds-obj.obj-code  = p-obj-code
     3532               and buf_lock_gds-obj.artic     = buf_temp-gds.temp-artic
     3533               and buf_lock_gds-obj.prod-type = buf_temp-gds.temp-prod-type
     3534               and buf_lock_gds-obj.prod-code = buf_temp-gds.temp-prod-code
     3535             no-error .
     3536           if not available buf_lock_gds-obj
     3537           then do:
     3538             assign
     3539               v-total-err = v-total-err + 1
     3540             .
     3541             run cur-time in this-procedure
     3542               (output v-today
     3543               ,output v-time
     3544               ) .
     3545             run update-last-date in this-procedure
     3546               (input v-today
     3547               ) .
     3548             output stream sout to value(v-log-err-file) append .
     3549             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3550             export stream sout "error-09: gds-obj not found"           .
     3551             export stream sout "obj-type"  p-obj-type                  .
     3552             export stream sout "obj-code"  p-obj-code                  .
     3553             export stream sout "artic"     buf_temp-gds.temp-artic     .
     3554             export stream sout "prod-type" buf_temp-gds.temp-prod-type .
     3555             export stream sout "prod-code" buf_temp-gds.temp-prod-code .
     3556             output stream sout close .
     3557           end.
     3558           else do:
     3559             run partslib-init-temp-parts in this-procedure
     3560               (input  p-obj-type
     3561               ,input  p-obj-code
     3562               ,input  buf_temp-gds.temp-artic
     3563               ,input  buf_temp-gds.temp-prod-type
     3564               ,input  buf_temp-gds.temp-prod-code
     3565               ) .
     3566           end.
     3567         end.
     3568         for each buf_temp-parts
     3569         on error undo, return error return-value
     3570         :
     3571           find first buf_temp-stk-line
     3572             where buf_temp-stk-line.temp-artic     = buf_temp-parts.artic
     3573               and buf_temp-stk-line.temp-prod-type = buf_temp-parts.prod-type
     3574               and buf_temp-stk-line.temp-prod-code = buf_temp-parts.prod-code
     3575             no-error .
     3576           if not available buf_temp-stk-line
     3577           then do:
     3578             create buf_temp-stk-line .
     3579             assign
     3580               buf_temp-stk-line.temp-artic     = buf_temp-parts.artic
     3581               buf_temp-stk-line.temp-prod-type = buf_temp-parts.prod-type
     3582               buf_temp-stk-line.temp-prod-code = buf_temp-parts.prod-code
     3583             .
     3584           end.
     3585           assign
     3586             buf_temp-stk-line.temp-gds-qnty = buf_temp-stk-line.temp-gds-qnty
     3587                                                   + buf_temp-parts.fact-qnty
     3588           .
     3589         end.
     3590       end.
     3591       for each buf_temp-stk-line
     3592       on error undo, return error return-value
     3593       :
     3594         assign
     3595           v-ind = v-ind + 1
     3596         .
     3597         if v-ind modulo 10 = 0
     3598         then do:
     3599           run waitfram-show in this-procedure
     3600             (input substitute("Проверка 05. Ошибок &1. Объект &2 &3. Записей &4."
     3601                             ,v-total-err
     3602                             ,p-obj-type
     3603                             ,p-obj-code
     3604                             ,v-ind
     3605                             )
     3606             ).
     3607         end.
     3608         if buf_temp-stk-line.temp-fact-qnty <> buf_temp-stk-line.temp-gds-qnty
     3609         then do:
     3610           assign
     3611             v-total-err = v-total-err + 1
     3612           .
     3613           run cur-time in this-procedure
     3614             (output v-today
     3615             ,output v-time
     3616             ) .
     3617           run update-last-date in this-procedure
     3618             (input v-today
     3619             ) .
     3620           output stream sout to value(v-log-err-file) append .
     3621           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3622           export stream sout "error-10: gds-obj stk-line different fact-qnty"      .
     3623           export stream sout "obj-type"  p-obj-type                                .
     3624           export stream sout "obj-code"  p-obj-code                                .
     3625           export stream sout "fact-date" v-today                                   .
     3626           export stream sout "artic"     buf_temp-stk-line.temp-artic              .
     3627           export stream sout "prod-type" buf_temp-stk-line.temp-prod-type          .
     3628           export stream sout "prod-code" buf_temp-stk-line.temp-prod-code          .
     3629           export stream sout "stk-line.fact-qnty" buf_temp-stk-line.temp-fact-qnty .
     3630           export stream sout "parts.fact-qnty" buf_temp-stk-line.temp-gds-qnty     .
     3631           output stream sout close .
     3632         end.
     3633       end.
     3634     end.
     3635   end procedure.
     3636   procedure check-sub-type-stk-line :
     3637     define buffer buf_temp-gds for temp-gds .
     3638     define buffer buf_stk-line for ub.stk-line .
     3639     define buffer buf_sub_stk-line for ub.stk-line .
     3640     define variable v-ind            as integer   no-undo .
     3641     define variable v-fact-qnty      as decimal   no-undo .
     3642     define variable v-sum-base       as decimal   no-undo .
     3643     define variable v-sum-rubl       as decimal   no-undo .
     3644     define variable v-VAT-base       as decimal   no-undo .
     3645     define variable v-VAT-rubl       as decimal   no-undo .
     3646     define variable v-SLT-base       as decimal   no-undo .
     3647     define variable v-SLT-rubl       as decimal   no-undo .
     3648     define variable v-road-tax-base  as decimal   no-undo .
     3649     define variable v-road-tax-rubl  as decimal   no-undo .
     3650     define variable v-excise-base    as decimal   no-undo .
     3651     define variable v-excise-rubl    as decimal   no-undo .
     3652     define variable v-transport-base as decimal   no-undo .
     3653     define variable v-transport-rubl as decimal   no-undo .
     3654     define variable v-other-base     as decimal   no-undo .
     3655     define variable v-other-rubl     as decimal   no-undo .
     3656     do
     3657     on error undo, return error return-value
     3658     :
     3659       for each buf_stk-line no-lock
     3660         where buf_stk-line.obj-type  = p-obj-type
     3661           and buf_stk-line.obj-code  = p-obj-code
     3662           and buf_stk-line.sum-type  = 'cost':U
     3663       on error undo, return error return-value
     3664       :
     3665         assign
     3666           v-ind = v-ind + 1
     3667         .
     3668         if v-ind modulo 10 = 0
     3669         then do:
     3670           run waitfram-show in this-procedure
     3671             (input substitute("Проверка 06. Ошибок &1. Объект &2 &3. Артикул &4 &5 &6."
     3672                             ,v-total-err
     3673                             ,p-obj-type
     3674                             ,p-obj-code
     3675                             ,buf_stk-line.artic
     3676                             ,buf_stk-line.prod-type
     3677                             ,buf_stk-line.prod-code
     3678                             )
     3679             ).
     3680         end.
     3681         assign
     3682           v-fact-qnty      = 0
     3683           v-sum-base       = 0
     3684           v-sum-rubl       = 0
     3685           v-VAT-base       = 0
     3686           v-VAT-rubl       = 0
     3687           v-SLT-base       = 0
     3688           v-SLT-rubl       = 0
     3689           v-road-tax-base  = 0
     3690           v-road-tax-rubl  = 0
     3691           v-excise-base    = 0
     3692           v-excise-rubl    = 0
     3693           v-transport-base = 0
     3694           v-transport-rubl = 0
     3695           v-other-base     = 0
     3696           v-other-rubl     = 0
     3697         .
     3698         for each buf_sub_stk-line no-lock
     3699           where buf_sub_stk-line.obj-type   = buf_stk-line.obj-type
     3700             and buf_sub_stk-line.obj-code   = buf_stk-line.obj-code
     3701             and buf_sub_stk-line.artic      = buf_stk-line.artic
     3702             and buf_sub_stk-line.prod-type  = buf_stk-line.prod-type
     3703             and buf_sub_stk-line.prod-code  = buf_stk-line.prod-code
     3704             and buf_sub_stk-line.fact-order = buf_stk-line.fact-order
     3705             and buf_sub_stk-line.sum-type   = 'cost':U + 'v':U
     3706         on error undo, return error return-value
     3707         :
     3708           assign
     3709             v-fact-qnty      = v-fact-qnty      + buf_sub_stk-line.fact-qnty
     3710             v-sum-base       = v-sum-base       + buf_sub_stk-line.sum-base
     3711             v-sum-rubl       = v-sum-rubl       + buf_sub_stk-line.sum-rubl
     3712             v-VAT-base       = v-VAT-base       + buf_sub_stk-line.VAT-base
     3713             v-VAT-rubl       = v-VAT-rubl       + buf_sub_stk-line.VAT-rubl
     3714             v-SLT-base       = v-SLT-base       + buf_sub_stk-line.SLT-base
     3715             v-SLT-rubl       = v-SLT-rubl       + buf_sub_stk-line.SLT-rubl
     3716             v-road-tax-base  = v-road-tax-base  + buf_sub_stk-line.road-tax-base
     3717             v-road-tax-rubl  = v-road-tax-rubl  + buf_sub_stk-line.road-tax-rubl
     3718             v-excise-base    = v-excise-base    + buf_sub_stk-line.excise-base
     3719             v-excise-rubl    = v-excise-rubl    + buf_sub_stk-line.excise-rubl
     3720             v-transport-base = v-transport-base + buf_sub_stk-line.transport-base
     3721             v-transport-rubl = v-transport-rubl + buf_sub_stk-line.transport-rubl
     3722             v-other-base     = v-other-base     + buf_sub_stk-line.other-base
     3723             v-other-rubl     = v-other-rubl     + buf_sub_stk-line.other-rubl
     3724           .
     3725         end.
     3726         if buf_stk-line.fact-qnty       <> v-fact-qnty
     3727         or buf_stk-line.sum-base        <> v-sum-base
     3728         or buf_stk-line.sum-rubl        <> v-sum-rubl
     3729         or buf_stk-line.VAT-base        <> v-VAT-base
     3730         or buf_stk-line.VAT-rubl        <> v-VAT-rubl
     3731         or buf_stk-line.SLT-base        <> v-SLT-base
     3732         or buf_stk-line.SLT-rubl        <> v-SLT-rubl
     3733         or buf_stk-line.road-tax-base   <> v-road-tax-base
     3734         or buf_stk-line.road-tax-rubl   <> v-road-tax-rubl
     3735         or buf_stk-line.excise-base     <> v-excise-base
     3736         or buf_stk-line.excise-rubl     <> v-excise-rubl
     3737         or buf_stk-line.transport-base  <> v-transport-base
     3738         or buf_stk-line.transport-rubl  <> v-transport-rubl
     3739         or buf_stk-line.other-base      <> v-other-base
     3740         or buf_stk-line.other-rubl      <> v-other-rubl
     3741         then do:
     3742           output stream sout to value(v-log-err-file) append .
     3743           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3744           export stream sout "error-11: sub_stk-line different qnty"                              .
     3745           export stream sout "obj-type"            p-obj-type                                     .
     3746           export stream sout "obj-code"            p-obj-code                                     .
     3747           export stream sout "obj-type"            buf_stk-line.obj-type                          .
     3748           export stream sout "obj-type"            buf_stk-line.obj-type                          .
     3749           export stream sout "artic"               buf_stk-line.artic                             .
     3750           export stream sout "prod-type"           buf_stk-line.prod-type                         .
     3751           export stream sout "prod-code"           buf_stk-line.prod-code                         .
     3752           export stream sout "fact-order"          buf_stk-line.fact-order                        .
     3753           export stream sout "diff-fact-qnty"      buf_stk-line.fact-qnty      - v-fact-qnty      .
     3754           export stream sout "diff-sum-base"       buf_stk-line.sum-base       - v-sum-base       .
     3755           export stream sout "diff-sum-rubl"       buf_stk-line.sum-rubl       - v-sum-rubl       .
     3756           export stream sout "diff-VAT-base"       buf_stk-line.VAT-base       - v-VAT-base       .
     3757           export stream sout "diff-VAT-rubl"       buf_stk-line.VAT-rubl       - v-VAT-rubl       .
     3758           export stream sout "diff-SLT-base"       buf_stk-line.SLT-base       - v-SLT-base       .
     3759           export stream sout "diff-SLT-rubl"       buf_stk-line.SLT-rubl       - v-SLT-rubl       .
     3760           export stream sout "diff-road-tax-base"  buf_stk-line.road-tax-base  - v-road-tax-base  .
     3761           export stream sout "diff-road-tax-rubl"  buf_stk-line.road-tax-rubl  - v-road-tax-rubl  .
     3762           export stream sout "diff-excise-base"    buf_stk-line.excise-base    - v-excise-base    .
     3763           export stream sout "diff-excise-rubl"    buf_stk-line.excise-rubl    - v-excise-rubl    .
     3764           export stream sout "diff-transport-base" buf_stk-line.transport-base - v-transport-base .
     3765           export stream sout "diff-transport-rubl" buf_stk-line.transport-rubl - v-transport-rubl .
     3766           export stream sout "diff-other-base"     buf_stk-line.other-base     - v-other-base     .
     3767           export stream sout "diff-other-rubl"     buf_stk-line.other-rubl     - v-other-rubl     .
     3768           export stream sout "sub-sum-type"        'cost':U + 'v':U                       .
     3769           export stream sout "fact-qnty"           buf_stk-line.fact-qnty                         .
     3770           export stream sout "sum-base"            buf_stk-line.sum-base                          .
     3771           export stream sout "sum-rubl"            buf_stk-line.sum-rubl                          .
     3772           export stream sout "VAT-base"            buf_stk-line.VAT-base                          .
     3773           export stream sout "VAT-rubl"            buf_stk-line.VAT-rubl                          .
     3774           export stream sout "SLT-base"            buf_stk-line.SLT-base                          .
     3775           export stream sout "SLT-rubl"            buf_stk-line.SLT-rubl                          .
     3776           export stream sout "road-tax-base"       buf_stk-line.road-tax-base                     .
     3777           export stream sout "road-tax-rubl"       buf_stk-line.road-tax-rubl                     .
     3778           export stream sout "excise-base"         buf_stk-line.excise-base                       .
     3779           export stream sout "excise-rubl"         buf_stk-line.excise-rubl                       .
     3780           export stream sout "transport-base"      buf_stk-line.transport-base                    .
     3781           export stream sout "transport-rubl"      buf_stk-line.transport-rubl                    .
     3782           export stream sout "other-base"          buf_stk-line.other-base                        .
     3783           export stream sout "other-rubl"          buf_stk-line.other-rubl                        .
     3784           export stream sout "sub-fact-qnty"       v-fact-qnty                                    .
     3785           export stream sout "sub-sum-base"        v-sum-base                                     .
     3786           export stream sout "sub-sum-rubl"        v-sum-rubl                                     .
     3787           export stream sout "sub-VAT-base"        v-VAT-base                                     .
     3788           export stream sout "sub-VAT-rubl"        v-VAT-rubl                                     .
     3789           export stream sout "sub-SLT-base"        v-SLT-base                                     .
     3790           export stream sout "sub-SLT-rubl"        v-SLT-rubl                                     .
     3791           export stream sout "sub-road-tax-base"   v-road-tax-base                                .
     3792           export stream sout "sub-road-tax-rubl"   v-road-tax-rubl                                .
     3793           export stream sout "sub-excise-base"     v-excise-base                                  .
     3794           export stream sout "sub-excise-rubl"     v-excise-rubl                                  .
     3795           export stream sout "sub-transport-base"  v-transport-base                               .
     3796           export stream sout "sub-transport-rubl"  v-transport-rubl                               .
     3797           export stream sout "sub-other-base"      v-other-base                                   .
     3798           export stream sout "sub-other-rubl"      v-other-rubl                                   .
     3799           output stream sout close .
     3800         end.
     3801         assign
     3802           v-fact-qnty      = 0
     3803           v-sum-base       = 0
     3804           v-sum-rubl       = 0
     3805           v-VAT-base       = 0
     3806           v-VAT-rubl       = 0
     3807           v-SLT-base       = 0
     3808           v-SLT-rubl       = 0
     3809           v-road-tax-base  = 0
     3810           v-road-tax-rubl  = 0
     3811           v-excise-base    = 0
     3812           v-excise-rubl    = 0
     3813           v-transport-base = 0
     3814           v-transport-rubl = 0
     3815           v-other-base     = 0
     3816           v-other-rubl     = 0
     3817         .
     3818         for each buf_sub_stk-line no-lock
     3819           where buf_sub_stk-line.obj-type   = buf_stk-line.obj-type
     3820             and buf_sub_stk-line.obj-code   = buf_stk-line.obj-code
     3821             and buf_sub_stk-line.artic      = buf_stk-line.artic
     3822             and buf_sub_stk-line.prod-type  = buf_stk-line.prod-type
     3823             and buf_sub_stk-line.prod-code  = buf_stk-line.prod-code
     3824             and buf_sub_stk-line.fact-order = buf_stk-line.fact-order
     3825             and buf_sub_stk-line.sum-type   = 'cost':U + 's':U
     3826         on error undo, return error return-value
     3827         :
     3828           assign
     3829             v-fact-qnty      = v-fact-qnty      + buf_sub_stk-line.fact-qnty
     3830             v-sum-base       = v-sum-base       + buf_sub_stk-line.sum-base
     3831             v-sum-rubl       = v-sum-rubl       + buf_sub_stk-line.sum-rubl
     3832             v-VAT-base       = v-VAT-base       + buf_sub_stk-line.VAT-base
     3833             v-VAT-rubl       = v-VAT-rubl       + buf_sub_stk-line.VAT-rubl
     3834             v-SLT-base       = v-SLT-base       + buf_sub_stk-line.SLT-base
     3835             v-SLT-rubl       = v-SLT-rubl       + buf_sub_stk-line.SLT-rubl
     3836             v-road-tax-base  = v-road-tax-base  + buf_sub_stk-line.road-tax-base
     3837             v-road-tax-rubl  = v-road-tax-rubl  + buf_sub_stk-line.road-tax-rubl
     3838             v-excise-base    = v-excise-base    + buf_sub_stk-line.excise-base
     3839             v-excise-rubl    = v-excise-rubl    + buf_sub_stk-line.excise-rubl
     3840             v-transport-base = v-transport-base + buf_sub_stk-line.transport-base
     3841             v-transport-rubl = v-transport-rubl + buf_sub_stk-line.transport-rubl
     3842             v-other-base     = v-other-base     + buf_sub_stk-line.other-base
     3843             v-other-rubl     = v-other-rubl     + buf_sub_stk-line.other-rubl
     3844           .
     3845         end.
     3846         if buf_stk-line.fact-qnty       <> v-fact-qnty
     3847         or buf_stk-line.sum-base        <> v-sum-base
     3848         or buf_stk-line.sum-rubl        <> v-sum-rubl
     3849         or buf_stk-line.VAT-base        <> v-VAT-base
     3850         or buf_stk-line.VAT-rubl        <> v-VAT-rubl
     3851         or buf_stk-line.SLT-base        <> v-SLT-base
     3852         or buf_stk-line.SLT-rubl        <> v-SLT-rubl
     3853         or buf_stk-line.road-tax-base   <> v-road-tax-base
     3854         or buf_stk-line.road-tax-rubl   <> v-road-tax-rubl
     3855         or buf_stk-line.excise-base     <> v-excise-base
     3856         or buf_stk-line.excise-rubl     <> v-excise-rubl
     3857         or buf_stk-line.transport-base  <> v-transport-base
     3858         or buf_stk-line.transport-rubl  <> v-transport-rubl
     3859         or buf_stk-line.other-base      <> v-other-base
     3860         or buf_stk-line.other-rubl      <> v-other-rubl
     3861         then do:
     3862           output stream sout to value(v-log-err-file) append .
     3863           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3864           export stream sout "error-12: sub_stk-line different qnty"                              .
     3865           export stream sout "obj-type"            p-obj-type                                     .
     3866           export stream sout "obj-code"            p-obj-code                                     .
     3867           export stream sout "obj-type"            buf_stk-line.obj-type                          .
     3868           export stream sout "obj-type"            buf_stk-line.obj-type                          .
     3869           export stream sout "artic"               buf_stk-line.artic                             .
     3870           export stream sout "prod-type"           buf_stk-line.prod-type                         .
     3871           export stream sout "prod-code"           buf_stk-line.prod-code                         .
     3872           export stream sout "fact-order"          buf_stk-line.fact-order                        .
     3873           export stream sout "diff-fact-qnty"      buf_stk-line.fact-qnty      - v-fact-qnty      .
     3874           export stream sout "diff-sum-base"       buf_stk-line.sum-base       - v-sum-base       .
     3875           export stream sout "diff-sum-rubl"       buf_stk-line.sum-rubl       - v-sum-rubl       .
     3876           export stream sout "diff-VAT-base"       buf_stk-line.VAT-base       - v-VAT-base       .
     3877           export stream sout "diff-VAT-rubl"       buf_stk-line.VAT-rubl       - v-VAT-rubl       .
