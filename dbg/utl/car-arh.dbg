     4037           export stream sout "sub-other-base"      v-other-base                                   .
     4038           export stream sout "sub-other-rubl"      v-other-rubl                                   .
     4039           output stream sout close .
     4040         end.
     4041       end.
     4042     end.
     4043   end procedure.
