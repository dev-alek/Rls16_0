     3882           export stream sout "diff-excise-base"    buf_stk-line.excise-base    - v-excise-base    .
     3883           export stream sout "diff-excise-rubl"    buf_stk-line.excise-rubl    - v-excise-rubl    .
     3884           export stream sout "diff-transport-base" buf_stk-line.transport-base - v-transport-base .
     3885           export stream sout "diff-transport-rubl" buf_stk-line.transport-rubl - v-transport-rubl .
     3886           export stream sout "diff-other-base"     buf_stk-line.other-base     - v-other-base     .
     3887           export stream sout "diff-other-rubl"     buf_stk-line.other-rubl     - v-other-rubl     .
     3888           export stream sout "sub-sum-type"        'cost':U + 's':U                       .
     3889           export stream sout "fact-qnty"           buf_stk-line.fact-qnty                         .
     3890           export stream sout "sum-base"            buf_stk-line.sum-base                          .
     3891           export stream sout "sum-rubl"            buf_stk-line.sum-rubl                          .
     3892           export stream sout "VAT-base"            buf_stk-line.VAT-base                          .
     3893           export stream sout "VAT-rubl"            buf_stk-line.VAT-rubl                          .
     3894           export stream sout "SLT-base"            buf_stk-line.SLT-base                          .
     3895           export stream sout "SLT-rubl"            buf_stk-line.SLT-rubl                          .
     3896           export stream sout "road-tax-base"       buf_stk-line.road-tax-base                     .
     3897           export stream sout "road-tax-rubl"       buf_stk-line.road-tax-rubl                     .
     3898           export stream sout "excise-base"         buf_stk-line.excise-base                       .
     3899           export stream sout "excise-rubl"         buf_stk-line.excise-rubl                       .
     3900           export stream sout "transport-base"      buf_stk-line.transport-base                    .
     3901           export stream sout "transport-rubl"      buf_stk-line.transport-rubl                    .
     3902           export stream sout "other-base"          buf_stk-line.other-base                        .
     3903           export stream sout "other-rubl"          buf_stk-line.other-rubl                        .
     3904           export stream sout "sub-fact-qnty"       v-fact-qnty                                    .
     3905           export stream sout "sub-sum-base"        v-sum-base                                     .
     3906           export stream sout "sub-sum-rubl"        v-sum-rubl                                     .
     3907           export stream sout "sub-VAT-base"        v-VAT-base                                     .
     3908           export stream sout "sub-VAT-rubl"        v-VAT-rubl                                     .
     3909           export stream sout "sub-SLT-base"        v-SLT-base                                     .
     3910           export stream sout "sub-SLT-rubl"        v-SLT-rubl                                     .
     3911           export stream sout "sub-road-tax-base"   v-road-tax-base                                .
     3912           export stream sout "sub-road-tax-rubl"   v-road-tax-rubl                                .
     3913           export stream sout "sub-excise-base"     v-excise-base                                  .
     3914           export stream sout "sub-excise-rubl"     v-excise-rubl                                  .
     3915           export stream sout "sub-transport-base"  v-transport-base                               .
     3916           export stream sout "sub-transport-rubl"  v-transport-rubl                               .
     3917           export stream sout "sub-other-base"      v-other-base                                   .
     3918           export stream sout "sub-other-rubl"      v-other-rubl                                   .
     3919           output stream sout close .
     3920         end.
     3921         assign
     3922           v-fact-qnty      = 0
     3923           v-sum-base       = 0
     3924           v-sum-rubl       = 0
     3925           v-VAT-base       = 0
     3926           v-VAT-rubl       = 0
     3927           v-SLT-base       = 0
     3928           v-SLT-rubl       = 0
     3929           v-road-tax-base  = 0
     3930           v-road-tax-rubl  = 0
     3931           v-excise-base    = 0
     3932           v-excise-rubl    = 0
     3933           v-transport-base = 0
     3934           v-transport-rubl = 0
     3935           v-other-base     = 0
     3936           v-other-rubl     = 0
     3937         .
     3938         for each buf_sub_stk-line no-lock
     3939           where buf_sub_stk-line.obj-type   = buf_stk-line.obj-type
     3940             and buf_sub_stk-line.obj-code   = buf_stk-line.obj-code
     3941             and buf_sub_stk-line.artic      = buf_stk-line.artic
     3942             and buf_sub_stk-line.prod-type  = buf_stk-line.prod-type
     3943             and buf_sub_stk-line.prod-code  = buf_stk-line.prod-code
     3944             and buf_sub_stk-line.fact-order = buf_stk-line.fact-order
     3945             and buf_sub_stk-line.sum-type   = 'cost':U + 'x':U
     3946         on error undo, return error return-value
     3947         :
     3948           assign
     3949             v-fact-qnty      = v-fact-qnty      + buf_sub_stk-line.fact-qnty
     3950             v-sum-base       = v-sum-base       + buf_sub_stk-line.sum-base
     3951             v-sum-rubl       = v-sum-rubl       + buf_sub_stk-line.sum-rubl
     3952             v-VAT-base       = v-VAT-base       + buf_sub_stk-line.VAT-base
     3953             v-VAT-rubl       = v-VAT-rubl       + buf_sub_stk-line.VAT-rubl
     3954             v-SLT-base       = v-SLT-base       + buf_sub_stk-line.SLT-base
     3955             v-SLT-rubl       = v-SLT-rubl       + buf_sub_stk-line.SLT-rubl
     3956             v-road-tax-base  = v-road-tax-base  + buf_sub_stk-line.road-tax-base
     3957             v-road-tax-rubl  = v-road-tax-rubl  + buf_sub_stk-line.road-tax-rubl
     3958             v-excise-base    = v-excise-base    + buf_sub_stk-line.excise-base
     3959             v-excise-rubl    = v-excise-rubl    + buf_sub_stk-line.excise-rubl
     3960             v-transport-base = v-transport-base + buf_sub_stk-line.transport-base
     3961             v-transport-rubl = v-transport-rubl + buf_sub_stk-line.transport-rubl
     3962             v-other-base     = v-other-base     + buf_sub_stk-line.other-base
     3963             v-other-rubl     = v-other-rubl     + buf_sub_stk-line.other-rubl
     3964           .
     3965         end.
     3966         if buf_stk-line.fact-qnty       <> v-fact-qnty
     3967         or buf_stk-line.sum-base        <> v-sum-base
     3968         or buf_stk-line.sum-rubl        <> v-sum-rubl
     3969         or buf_stk-line.VAT-base        <> v-VAT-base
     3970         or buf_stk-line.VAT-rubl        <> v-VAT-rubl
     3971         or buf_stk-line.SLT-base        <> v-SLT-base
     3972         or buf_stk-line.SLT-rubl        <> v-SLT-rubl
     3973         or buf_stk-line.road-tax-base   <> v-road-tax-base
     3974         or buf_stk-line.road-tax-rubl   <> v-road-tax-rubl
     3975         or buf_stk-line.excise-base     <> v-excise-base
     3976         or buf_stk-line.excise-rubl     <> v-excise-rubl
     3977         or buf_stk-line.transport-base  <> v-transport-base
     3978         or buf_stk-line.transport-rubl  <> v-transport-rubl
     3979         or buf_stk-line.other-base      <> v-other-base
     3980         or buf_stk-line.other-rubl      <> v-other-rubl
     3981         then do:
     3982           output stream sout to value(v-log-err-file) append .
     3983           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3984           export stream sout "error-13: sub_stk-line different qnty"                              .
     3985           export stream sout "obj-type"            p-obj-type                                     .
     3986           export stream sout "obj-code"            p-obj-code                                     .
     3987           export stream sout "obj-type"            buf_stk-line.obj-type                          .
     3988           export stream sout "obj-type"            buf_stk-line.obj-type                          .
     3989           export stream sout "artic"               buf_stk-line.artic                             .
     3990           export stream sout "prod-type"           buf_stk-line.prod-type                         .
     3991           export stream sout "prod-code"           buf_stk-line.prod-code                         .
     3992           export stream sout "fact-order"          buf_stk-line.fact-order                        .
     3993           export stream sout "diff-fact-qnty"      buf_stk-line.fact-qnty      - v-fact-qnty      .
     3994           export stream sout "diff-sum-base"       buf_stk-line.sum-base       - v-sum-base       .
     3995           export stream sout "diff-sum-rubl"       buf_stk-line.sum-rubl       - v-sum-rubl       .
     3996           export stream sout "diff-VAT-base"       buf_stk-line.VAT-base       - v-VAT-base       .
     3997           export stream sout "diff-VAT-rubl"       buf_stk-line.VAT-rubl       - v-VAT-rubl       .
     3998           export stream sout "diff-SLT-base"       buf_stk-line.SLT-base       - v-SLT-base       .
     3999           export stream sout "diff-SLT-rubl"       buf_stk-line.SLT-rubl       - v-SLT-rubl       .
     4000           export stream sout "diff-road-tax-base"  buf_stk-line.road-tax-base  - v-road-tax-base  .
     4001           export stream sout "diff-road-tax-rubl"  buf_stk-line.road-tax-rubl  - v-road-tax-rubl  .
     4002           export stream sout "diff-excise-base"    buf_stk-line.excise-base    - v-excise-base    .
     4003           export stream sout "diff-excise-rubl"    buf_stk-line.excise-rubl    - v-excise-rubl    .
     4004           export stream sout "diff-transport-base" buf_stk-line.transport-base - v-transport-base .
     4005           export stream sout "diff-transport-rubl" buf_stk-line.transport-rubl - v-transport-rubl .
     4006           export stream sout "diff-other-base"     buf_stk-line.other-base     - v-other-base     .
     4007           export stream sout "diff-other-rubl"     buf_stk-line.other-rubl     - v-other-rubl     .
     4008           export stream sout "sub-sum-type"        'cost':U + 'x':U                    .
     4009           export stream sout "fact-qnty"           buf_stk-line.fact-qnty                         .
     4010           export stream sout "sum-base"            buf_stk-line.sum-base                          .
     4011           export stream sout "sum-rubl"            buf_stk-line.sum-rubl                          .
     4012           export stream sout "VAT-base"            buf_stk-line.VAT-base                          .
     4013           export stream sout "VAT-rubl"            buf_stk-line.VAT-rubl                          .
     4014           export stream sout "SLT-base"            buf_stk-line.SLT-base                          .
     4015           export stream sout "SLT-rubl"            buf_stk-line.SLT-rubl                          .
     4016           export stream sout "road-tax-base"       buf_stk-line.road-tax-base                     .
