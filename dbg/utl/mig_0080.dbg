        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: mig_0080.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/mig_0080.p $":U .
        7   define variable vss-description as character no-undo init "Модификация тфблиц раздела Накладные".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input parameter parparentproc    as widget-handle no-undo .
       63   define input parameter p-parent-handle  as widget-handle no-undo .
       64   define input parameter p-log-handle     as handle no-undo .
       65   define input parameter p-parameter      as character no-undo .
       66   define input parameter p-db-num         as integer   no-undo .
       67   define input parameter p-cli-code       as integer   no-undo .
       68   define input parameter log-file-name   as character  no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   define new global shared variable g#library  as handle no-undo .
      300   define new global shared variable g#library2 as handle no-undo .
      301   run write-log-and-file in p-log-handle (
      302         input 1
      303       , input log-file-name
      304       , input 1
      305       , input substitute("Накладные") ).
      306   define buffer buf_clients for ub.clients  .
      307   on delete of ub.trn-doc       override do: end .
      308   on write  of ub.trn-doc       override do: end .
      309   on delete of ub.doc-line      override do: end .
      310   on write  of ub.doc-line      override do: end .
      311   on delete of ub.parts         override do: end .
      312   on write  of ub.parts         override do: end .
      313   on delete of ub.parts-attr    override do: end .
      314   on write  of ub.parts-attr    override do: end .
      315     do
      316     on error undo, return error return-value
      317     :
      318   for each ub.trn-doc exclusive-lock :
      319       if  ( ub.trn-doc.ext-doc-type = 'ie':U
      320             or ub.trn-doc.ext-doc-type = 'ee':U
      321             or ub.trn-doc.ext-doc-type = 'ep':U
      322             or ub.trn-doc.ext-doc-type = 're':U
      323           )
      324       and ( ( ub.trn-doc.hold-doc-code-child  <> ""
      325               and ub.trn-doc.hold-doc-code-child  <> "no-hold":u
      326             )
      327             or
      328             ( ub.trn-doc.hold-doc-code-parent <> ""
      329               and ub.trn-doc.hold-doc-code-parent <> "no-hold":u
      330             )
      331           )
      332       then do:
      333            assign
      334              ub.trn-doc.hold-doc-code-child  = ""
      335              ub.trn-doc.hold-doc-code-parent = ""
      336              ub.trn-doc.hold-obj-code = ?
      337              ub.trn-doc.hold-obj-type = ?
      338            .
      339        end.
      340        if   ub.trn-doc.internal = true  then do:
      341             find first ub.clients no-lock where
      342                        ub.clients.obj-type = ub.trn-doc.cli-type and
      343                        ub.clients.obj-code = ub.trn-doc.cli-code no-error .
      344            if error-status :error then do:
      345               assign
      346                 ub.trn-doc.cli-type = 'орг':U
      347                 ub.trn-doc.cli-code = p-cli-code
      348                 ub.trn-doc.internal = false
      349                .
      350               case ub.trn-doc.ext-doc-type :
      351                 when  'iv':U     then  ub.trn-doc.ext-doc-type = 'ie':U .
      352                 when  'ev':U     then  ub.trn-doc.ext-doc-type = 'ee':U .
      353                 when  'rv':U then  ub.trn-doc.ext-doc-type = 're':U .
      354               end case.
      355               for each ub.doc-line exclusive-lock where ub.doc-line.doc-code = ub.trn-doc.doc-code :
      356                        ub.doc-line.ext-doc-type = ub.trn-doc.ext-doc-type.
      357                        for each ub.parts exclusive-lock where
      358                                 ub.parts.out-code = ub.trn-doc.doc-code and
      359                                 ub.parts.obj-code = ub.trn-doc.obj-code and
      360                                 ub.parts.obj-type = ub.trn-doc.obj-type and
      361                                 ub.parts.artic    = ub.doc-line.artic and
      362                                 ub.parts.prod-type    = ub.doc-line.prod-type and
      363                                 ub.parts.prod-code    = ub.doc-line.prod-code :
      364                                      if ub.parts.supp-type <> "" then do:
      365                                         find first buf_clients no-lock where
      366                                                    buf_clients.obj-type = ub.parts.supp-type and
      367                                                    buf_clients.obj-code = ub.parts.supp-code no-error .
      368                                         if error-status :error then do:
      369                                             assign
      370                                               ub.parts.supp-type = 'орг':U
      371                                               ub.parts.supp-code = p-cli-code
      372                                               .
      373                                         end.
      374                                      end.
      375                                 find first ub.goods no-lock where
      376                                            ub.goods.artic    = ub.doc-line.artic and
      377                                            ub.goods.prod-type    = ub.doc-line.prod-type and
      378                                            ub.goods.prod-code    = ub.doc-line.prod-code .
      379                                 find first ub.parts-attr exclusive-lock where
      380                                            ub.parts-attr.in-code   = ub.parts.in-code  and
      381                                            ub.parts-attr.gds-code  = ub.goods.gds-code and
      382                                            ub.parts-attr.part-code = ub.parts.part-code no-error .
      383                                   if available ub.parts-attr then do:
      384                                      ub.parts-attr.ext-doc-type = ub.trn-doc.ext-doc-type.
      385                                      if ub.parts-attr.supp-type <> "" then do:
      386                                         find first buf_clients no-lock where
      387                                                    buf_clients.obj-type = ub.parts-attr.supp-type and
      388                                                    buf_clients.obj-code = ub.parts-attr.supp-code no-error .
      389                                         if error-status :error then do:
      390                                             assign
      391                                               ub.parts-attr.supp-type = 'орг':U
      392                                               ub.parts-attr.supp-code = p-cli-code
      393                                               .
      394                                         end.
      395                                      end.
      396                                   end.
      397                        end.
      398               end.
      399            end.
      400        end.
      401   end.
      402   end.
