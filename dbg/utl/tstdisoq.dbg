      802                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
      803                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
      804                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
      805                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
      806                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
      807                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
      808                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
      809                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
      810                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
      811                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
      812                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
      813               .
      814           end.
      815       end.
      816       assign
      817           p-transport-base      = 0
      818           p-transport-rubl      = 0
      819           p-vat-pc              = buf_doc-line.vat-pc
      820           p-slt-pc              = buf_doc-line.slt-pc
      821       .
      822     end.
      823     if p-fact-qnty      = ?
      824     or p-vat-pc         = ?
      825     or p-slt-pc         = ?
      826     or p-sum-base       = ?
      827     or p-sum-rubl       = ?
      828     or p-vat-base       = ?
      829     or p-vat-rubl       = ?
      830     or p-slt-base       = ?
      831     or p-slt-rubl       = ?
      832     or p-road-tax-base  = ?
      833     or p-road-tax-rubl  = ?
      834     or p-transport-base = ?
      835     or p-transport-rubl = ?
      836     or p-other-base     = ?
      837     or p-other-rubl     = ?
      838     or p-excise-base    = ?
      839     or p-excise-rubl    = ?
      840     then do:
      841       message
      842         vss-workfile vss-revision vss-description skip
      843         vss-include-info4 skip
