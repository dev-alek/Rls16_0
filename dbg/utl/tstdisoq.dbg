     2262           ub.clients.buy-serv = ub.clients.buy-serv OR buf_inkas.office
     2263         .
     2264         create temp-d-card.
     2265         assign
     2266         temp-d-card.d-card = ub.chk-doc.d-card
     2267         temp-d-card.pay-tot-base = 0
     2268         temp-d-card.pay-tot-rubl = 0
     2269         temp-d-card.gds-tot-b0 = 0
     2270         temp-d-card.gds-tot-r0 = 0
     2271         temp-d-card.first-main-card   = ub.dis-card.first-main-card
     2272         temp-d-card.main-card         = ub.dis-card.main-card
     2273         temp-d-card.first-card        = ub.dis-card.first-card
     2274         temp-d-card.cli-type          = ub.dis-card.cli-type
     2275         temp-d-card.cli-code          = ub.dis-card.cli-code
     2276         temp-d-card.card-num          = ub.dis-card.card-num
     2277         temp-d-card.emitent-host-code = ub.dis-card.emitent-host-code
     2278         temp-d-card.type              = ub.dis-card.type
     2279         temp-d-card.obj-type          = ub.chk-doc.obj-type
     2280         temp-d-card.obj-code          = ub.chk-doc.obj-code
     2281         temp-d-card.host-code         = buf_inkas.host-code
     2282         temp-d-card.sale-doc          = buf_inkas.inkas-code
     2283         temp-d-card.sale-type         = 'inkas':U
     2284         temp-d-card.doc-date          = ub.chk-doc.chk-date
     2285         temp-d-card.action            = sign
     2286         .
     2287       end.
     2288       FOR EACH ub.chk-gds WHERE
     2289                 ub.chk-gds.doc-code = ub.chk-doc.doc-code AND
     2290                 ub.chk-gds.b-code <> 0 NO-LOCK ,
     2291           FIRST ub.bar-code where
     2292                 ub.bar-code.b-code = ub.chk-gds.b-code No-LOCK,
     2293           FIRST ub.goods where
     2294                 ub.goods.gds-code = ub.bar-code.gds-code No-LOCK,
     2295           FIRST ub.doc-line WHERE
     2296                 ub.doc-line.doc-code = (if ub.chk-doc.netto >= 0 then buf_trn-doc.doc-code else ret-doc-code) AND
     2297                 ub.doc-line.prod-code = ub.goods.prod-code AND
     2298                 ub.doc-line.prod-type = ub.goods.prod-type AND
     2299                 ub.doc-line.artic = ub.goods.artic NO-LOCK
     2300                 On error undo _main, return error
     2301                 :
     2302         if ub.chk-gds.write-off-code <> ?
     2303         and ub.chk-gds.write-off-code > 0 then NEXT.
     2304         assign
     2305         temp-d-card.gds-tot-r0 = temp-d-card.gds-tot-r0 +  par-sign * ( ub.doc-line.price-rubl * ub.chk-gds.doc-qnty )
     2306         temp-d-card.gds-tot-b0 = temp-d-card.gds-tot-b0 +  par-sign * ( ub.doc-line.price-base * ub.chk-gds.doc-qnty )
     2307         .
     2308       END.
     2309       assign
     2310       accum-tot-base = 0
     2311       accum-tot-rubl = 0
     2312       accum-cre-pay-base =0
     2313       accum-cre-pay-rubl =0
     2314       .
     2315       FOR EACH ub.chk-pay WHERE
     2316                ub.chk-pay.doc-code = ub.chk-doc.doc-code NO-LOCK
     2317       On error undo _main, return error
     2318       :
     2319           if ub.chk-pay.pay-code = cre-pay
     2320             then
     2321           assign
     2322           cre-pay-base = ub.chk-pay.tot-base
     2323           cre-pay-rubl   = ub.chk-pay.tot-rubl .
     2324             else
     2325           assign
     2326           cre-pay-base = 0
     2327           cre-pay-rubl   = 0 .
     2328           Assign
     2329           accum-tot-rubl     = accum-tot-rubl +  ub.chk-pay.tot-rubl
     2330           accum-tot-base     = accum-tot-base +  ub.chk-pay.tot-base
     2331           accum-cre-pay-base = accum-cre-pay-base +  cre-pay-base
     2332           accum-cre-pay-rubl = accum-cre-pay-rubl +  cre-pay-rubl
     2333           .
     2334           if v-cntxt-db-num = 0 and ub.chk-pay.pay-code <> cre-pay then do:
     2335             FIND FIRST vchk-pay No-LOCK WHERE
     2336                         vchk-pay.d-card = ub.chk-doc.d-card AND
     2337                         vchk-pay.pay-code = ub.chk-pay.pay-code AND
     2338                         vchk-pay.curr-code = ub.chk-pay.curr-code AND
     2339                         vchk-pay.doc-date = ub.chk-pay.chk-date AND
     2340                         vchk-pay.cre-pay = (ub.chk-pay.pay-code = cre-pay) AND
     2341                         vchk-pay.exch-rate = (ub.chk-pay.tot-sum / chk-pay.tot-rubl) AND
     2342                       vchk-pay.base-rate = (ub.chk-pay.tot-rubl / chk-pay.tot-base ) No-ERROR.
     2343             IF NOT AVAIL vchk-pay then do:
     2344               create vchk-pay.
     2345               assign
     2346               vchk-pay.d-card   = ub.chk-doc.d-card
     2347               vchk-pay.doc-date = ub.chk-pay.chk-date
     2348               vchk-pay.pay-code = ub.chk-pay.pay-code
     2349               vchk-pay.curr-code = ub.chk-pay.curr-code
     2350               vchk-pay.cre-pay = (ub.chk-pay.pay-code = cre-pay)
     2351               vchk-pay.exch-rate =  (ub.chk-pay.tot-sum / ub.chk-pay.tot-rubl)
     2352               vchk-pay.base-rate = (ub.chk-pay.tot-rubl / ub.chk-pay.tot-base)
     2353               .
     2354             end.
     2355             assign
     2356             vchk-pay.tot-sum  = vchk-pay.tot-sum  + ub.chk-pay.tot-sum
     2357             vchk-pay.tot-base = vchk-pay.tot-base + ub.chk-pay.tot-base
     2358             vchk-pay.tot-rubl = vchk-pay.tot-rubl + ub.chk-pay.tot-rubl
     2359             .
     2360         END.
     2361       END .
     2362       assign
     2363       temp-d-card.pay-tot-base = temp-d-card.pay-tot-base + par-sign * (ACCUM-tot-base -  ACCUM-cre-pay-base)
     2364       temp-d-card.pay-tot-rubl = temp-d-card.pay-tot-rubl + par-sign * (ACCUM-tot-rubl -  ACCUM-cre-pay-rubl)
     2365       .
     2366       if v-base-code = 0 then
     2367       chk-exch =  1.
     2368       else do:
     2369         v-rate = ?.
     2370         if v-curr-r-b = 'base':U then do:
     2371           assign
     2372           v-rate = ub.chk-doc.cash-rate / ub.chk-doc.cash-scale
     2373           no-error
     2374           .
     2375           if v-rate <> 0
     2376           and v-rate <> ? then do:
     2377             chk-exch = v-rate.
     2378           end.
     2379           else do:
     2380             assign
     2381             v-rate = ACCUM-tot-rubl  / ACCUM-tot-base
     2382             no-error
     2383             .
     2384             if v-rate <> ?
     2385             and v-rate <> 0 then do:
     2386               chk-exch = v-rate.
     2387             end.
     2388             else do:
     2389                 undo _main, return error substitute("&1&2 Невозможно определить курс базовой валюты для чека &3 по ДК &4"
     2390                                                     , vss-description
     2391                                                     , chr(10)
     2392                                                     , chk-doc.doc-code
     2393                                                     , chk-doc.d-card).
     2394             end.
     2395           end.
     2396         end.
     2397         else do:
     2398           assign
     2399           v-rate = ACCUM-tot-rubl  / ACCUM-tot-base
     2400           no-error
     2401           .
     2402           if v-rate <> ?
     2403           and v-rate <> 0 then do:
     2404             chk-exch = v-rate.
     2405           end.
     2406           else do:
     2407             FIND LAST buf_curr-shop NO-LOCK WHERE
     2408                       buf_curr-shop.obj-type = ub.chk-doc.obj-type AND
     2409                       buf_curr-shop.obj-code = ub.chk-doc.obj-code AND
     2410                       buf_curr-shop.curr-code = v-base-code AND
     2411                       ( ( buf_curr-shop.exch-date = ub.chk-doc.chk-date AND
     2412                           buf_curr-shop.exch-time <= ub.chk-doc.chk-time ) OR
     2413                           buf_curr-shop.exch-date < ub.chk-doc.chk-date ) NO-ERROR .
     2414             if available buf_curr-shop then do:
     2415               assign
     2416               v-rate = buf_Curr-shop.exch-rate / buf_curr-shop.exch-scale
     2417               no-error .
     2418               if v-rate <> ?
     2419               and v-rate <> 0 then do:
     2420                 chk-exch = v-rate.
     2421               end.
     2422               else do:
     2423                   undo _main, return error substitute("&1&2 Невозможно определить курс базовой валюты для чека &3 по ДК &4"
     2424                                                       , vss-description
     2425                                                       , chr(10)
     2426                                                       , chk-doc.doc-code
     2427                                                       , chk-doc.d-card).
     2428               end.
     2429             end.
     2430           end.
     2431         end.
     2432       end.
     2433       assign
     2434       chk-exch-rubl = (if v-curr-r-b = 'rubl':U then 1 else chk-exch)
     2435       chk-exch-base = (if v-curr-r-b = 'base':U then 1 else chk-exch )
     2436       .
     2437       Assign
     2438       temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-r-b + 0
     2439       temp-d-card.sum-tot-rubl = temp-d-card.sum-tot-rubl + 0
     2440       temp-d-card.sum-tot-base = temp-d-card.sum-tot-base + 0
     2441       temp-d-card.gds-tot-r-b  = temp-d-card.gds-tot-r-b  + par-sign * ub.chk-doc.tot-doc
     2442       temp-d-card.gds-tot-rubl = temp-d-card.gds-tot-rubl + par-sign * ub.chk-doc.tot-doc * chk-exch-rubl
     2443       temp-d-card.gds-tot-base = temp-d-card.gds-tot-base + par-sign * ub.chk-doc.tot-doc / chk-exch-base
     2444       temp-d-card.gds-dis-r-b  = temp-d-card.gds-dis-r-b  + par-sign * ub.chk-doc.discnt
     2445       temp-d-card.gds-dis-rubl = temp-d-card.gds-dis-rubl + par-sign * ub.chk-doc.discnt * chk-exch-rubl
     2446       temp-d-card.gds-dis-base = temp-d-card.gds-dis-base + par-sign * ub.chk-doc.discnt / chk-exch-base
     2447       temp-d-card.num-chk      = temp-d-card.num-chk      + par-sign * 1
     2448       .
     2449       run ref/calctur4.p ( input ub.chk-doc.doc-code ) .
     2450    END.
     2451         FOR EACH buf_dis-card NO-LOCK where
     2452                 buf_dis-card.emitent-host-code = dctype,
     2453           first temp-d-card no-lock where
     2454               temp-d-card.d-card = buf_dis-card.d-card:
     2455           assign
     2456           p-pay-sum-rubl = 0
     2457           p-pay-sum-base = 0
     2458           .
     2459           for each buf_payment no-lock where
     2460                     buf_payment.host-code = buf_Inkas.host-code
     2461                 AND  buf_payment.d-card = temp-d-card.d-card
     2462                 and  buf_payment.status_ = 'факт':U
     2463                 and  buf_payment.source-type = 'касс':U
     2464                 and  buf_payment.source-ref = buf_inkas.inkas-code :
     2465             assign
     2466             p-pay-sum-rubl = p-pay-sum-rubl + buf_payment.tot-rubl
     2467             p-pay-sum-base = p-pay-sum-base + buf_payment.tot-base
     2468             .
     2469           end.
     2470           if p-view-mode = 1
     2471           or (p-pay-sum-base <> temp-d-card.pay-tot-base
     2472           or p-pay-sum-rubl <> temp-d-card.pay-tot-rubl) then
     2473           PUT STREAM TEST UNFORMATTED
     2474           temp-d-card.d-card format "X(16)" space(1)
     2475           buf_inkas.inkas-code space(1)
     2476           temp-d-card.pay-tot-rubl format "->>>,>>>,>>9.99" space(1)
     2477           temp-d-card.pay-tot-base format "->>>,>>>,>>9.99" space(1)
     2478           p-pay-sum-rubl  format "->>>,>>>,>>9.99" space(1)
     2479           p-pay-sum-base  format "->>>,>>>,>>9.99" space(1)
     2480           (temp-d-card.pay-tot-rubl - p-pay-sum-rubl) format "->>>,>>>,>>9.99" space(1)
     2481           (temp-d-card.pay-tot-base - p-pay-sum-base) format "->>>,>>>,>>9.99" space(1)
     2482           SKIP.
     2483         END.
     2484       end.
     2485       for each buf_sysconf no-lock,
     2486           each bf_trn-doc no-lock where
     2487               bf_trn-doc.host-code = buf_sysconf.host-code
     2488           AND bf_trn-doc.obj-type = p-obj-type
     2489           AND bf_trn-doc.obj-code = p-obj-code
     2490           AND bf_trn-doc.doc-date >= X_start-date
     2491           AND bf_trn-doc.doc-date <= X_end-date:
     2492         if bf_trn-doc.status_ <> 'факт':U then NEXT.
     2493         if bf_trn-doc.d-card = "":U then NEXT.
     2494         if bf_trn-doc.ext-doc-type = 'es':U then NEXT.
     2495         if not can-find(first buf_dis-card NO-LOCK where
     2496                 buf_dis-card.emitent-host-code = dctype ) then NEXT.
     2497         for each temp-d-card:
     2498           delete temp-d-card.
     2499         end.
     2500         for each vchk-pay:
     2501           delete vchk-pay.
     2502         end.
     2503         create temp-d-card.
     2504         assign
     2505         temp-d-card.d-card            = bf_trn-doc.d-card
     2506         temp-d-card.card-num          = temp-d-card.card-num
     2507         temp-d-card.emitent-host-code = temp-d-card.emitent-host-code
     2508         temp-d-card.type              = temp-d-card.type
     2509         temp-d-card.cli-type          = temp-d-card.cli-type
     2510         temp-d-card.cli-code          = temp-d-card.cli-code
     2511         .
     2512         assign
     2513         p-doc-code = bf_trn-doc.doc-code
     2514         .
     2515         assign
     2516         par-sign = 1
     2517         par-direction =  if bf_trn-doc.ext-doc-type = 're':U
     2518                       then -1
     2519                       else  1.
     2520   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2521   if v-cntxt-db-num = 0 then do:
     2522     FOR EACH buf_doc-line no-lock where
     2523             buf_doc-line.doc-code = p-doc-code
     2524        On error undo _main, return error:
     2525       run r-sale in this-procedure (
     2526                                       input p-doc-code
     2527                                      ,input buf_doc-line.artic
     2528                                      ,input buf_doc-line.prod-type
     2529                                      ,input buf_doc-line.prod-code
     2530                                      ,output v-fact-qnty
     2531                                      ,output v-vat-pc
     2532                                      ,output v-slt-pc
     2533                                      ,output v-sum-base
     2534                                      ,output v-sum-rubl
     2535                                      ,output v-vat-base
     2536                                      ,output v-vat-rubl
     2537                                      ,output v-slt-base
     2538                                      ,output v-slt-rubl
     2539                                      ,output v-road-tax-base
     2540                                      ,output v-road-tax-rubl
     2541                                      ,output v-transport-base
     2542                                      ,output v-transport-rubl
     2543                                      ,output v-other-base
     2544                                      ,output v-other-rubl
     2545                                      ,output v-excise-base
     2546                                      ,output v-excise-rubl
     2547                                       ) .
     2548         assign
     2549         temp-d-card.pay-tot-rubl = temp-d-card.pay-tot-rubl + par-direction * par-sign * abs( v-sum-rubl)
     2550         temp-d-card.pay-tot-base = temp-d-card.pay-tot-base + par-direction * par-sign * abs( v-sum-base)
     2551         temp-d-card.gds-tot-rubl = temp-d-card.gds-tot-rubl + par-direction * par-sign * abs( (v-sum-rubl + v-other-rubl))
     2552         temp-d-card.gds-tot-base = temp-d-card.gds-tot-base + par-direction * par-sign * abs( (v-sum-base + v-other-base))
     2553         temp-d-card.gds-dis-rubl = temp-d-card.gds-dis-rubl + par-direction * par-sign * abs( v-other-rubl)
     2554         temp-d-card.gds-dis-base = temp-d-card.gds-dis-base + par-direction * par-sign * abs( v-other-base)
     2555         .
     2556         run r-cost in this-procedure (
     2557                                       input p-doc-code
     2558                                      ,input buf_doc-line.artic
     2559                                      ,input buf_doc-line.prod-type
     2560                                      ,input buf_doc-line.prod-code
     2561                                      ,output v-fact-qnty
     2562                                      ,output v-vat-pc
     2563                                      ,output v-slt-pc
     2564                                      ,output v-sum-base
     2565                                      ,output v-sum-rubl
     2566                                      ,output v-vat-base
     2567                                      ,output v-vat-rubl
     2568                                      ,output v-slt-base
     2569                                      ,output v-slt-rubl
     2570                                      ,output v-road-tax-base
     2571                                      ,output v-road-tax-rubl
     2572                                      ,output v-transport-base
     2573                                      ,output v-transport-rubl
     2574                                      ,output v-other-base
     2575                                      ,output v-other-rubl
     2576                                      ,output v-excise-base
     2577                                      ,output v-excise-rubl
     2578                                       ) .
     2579       assign
     2580       temp-d-card.gds-tot-r0 = temp-d-card.gds-tot-r0 + par-direction * par-sign * abs( v-sum-rubl)
     2581       temp-d-card.gds-tot-b0 = temp-d-card.gds-tot-b0 + par-direction * par-sign * abs( v-sum-base)
     2582       .
     2583     END.
     2584   end.
     2585   if v-curr-r-b = 'base':U then
     2586   assign
     2587   temp-d-card.gds-tot-r-b = temp-d-card.gds-tot-base
     2588   temp-d-card.gds-dis-r-b = temp-d-card.gds-dis-base
     2589   temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-base
     2590   .
     2591   else
     2592   assign
     2593   temp-d-card.gds-tot-r-b = temp-d-card.gds-tot-rubl
     2594   temp-d-card.gds-dis-r-b = temp-d-card.gds-dis-rubl
     2595   temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-rubl
     2596   .
     2597     find first vchk-pay no-lock where
     2598               vchk-pay.d-card   = temp-d-card.d-card
     2599           AND vchk-pay.pay-code = bf_trn-doc.pay-code
     2600           AND vchk-pay.curr-code = bf_trn-doc.exch-code
     2601           AND vchk-pay.doc-date  = 01/01/1990
     2602           AND vchk-pay.cre-pay   = (cre-pay = bf_trn-doc.pay-code) no-error .
     2603     if not available vchk-pay then do:
     2604       create vchk-pay.
     2605       assign
     2606       vchk-pay.d-card   = temp-d-card.d-card
     2607       vchk-pay.doc-date = bf_trn-doc.exch-date
     2608       vchk-pay.pay-code = bf_trn-doc.pay-code
     2609       vchk-pay.curr-code = bf_trn-doc.exch-code
     2610       vchk-pay.cre-pay   =  no
     2611       vchk-pay.exch-rate = bf_trn-doc.exch-rate
     2612       vchk-pay.base-rate = bf_trn-doc.base-rate
     2613       vchk-pay.tot-base =  temp-d-card.pay-tot-base
     2614       vchk-pay.tot-rubl =  temp-d-card.pay-tot-rubl
     2615       vchk-pay.tot-sum =  (if bf_trn-doc.exch-code = 0 then temp-d-card.pay-tot-rubl else temp-d-card.pay-tot-base)
     2616       .
     2617     end.
     2618         assign
     2619         p-pay-sum-rubl = 0
     2620         p-pay-sum-base = 0
     2621         .
     2622         find first buf_payment no-lock where
     2623                   buf_payment.host-code = bf_trn-doc.host-code
     2624             AND  buf_payment.d-card = temp-d-card.d-card
     2625             and  buf_payment.status_ = 'факт':U
     2626             and  buf_payment.source-type = 'накл':U
     2627             and  buf_payment.source-ref = bf_trn-doc.doc-code  no-error .
     2628         if available buf_payment then
     2629         assign
     2630         p-pay-sum-rubl = buf_payment.tot-rubl
     2631         p-pay-sum-base = buf_payment.tot-base
     2632         .
     2633         if p-view-mode = 1
     2634         OR (p-pay-sum-base <> temp-d-card.pay-tot-base
     2635         or p-pay-sum-rubl <> temp-d-card.pay-tot-rubl) then
     2636         PUT STREAM TEST UNFORMATTED
     2637         temp-d-card.d-card format "X(16)" space(1)
     2638         bf_trn-doc.doc-code space(1)
     2639         temp-d-card.pay-tot-rubl format "->>>,>>>,>>9.99" space(1)
     2640         temp-d-card.pay-tot-base format "->>>,>>>,>>9.99" space(1)
     2641         p-pay-sum-rubl  format "->>>,>>>,>>9.99" space(1)
     2642         p-pay-sum-base  format "->>>,>>>,>>9.99" space(1)
     2643         (temp-d-card.pay-tot-rubl - p-pay-sum-rubl) format "->>>,>>>,>>9.99" space(1)
     2644         (temp-d-card.pay-tot-base - p-pay-sum-base) format "->>>,>>>,>>9.99" space(1)
     2645         SKIP.
     2646       end.
     2647     end.
     2648     when 3 then do:
     2649       FOR EACH ub.dis-host no-LOCK
     2650         WHERE ub.dis-host.host-code = v-host-code
     2651         AND ub.dis-host.host-code > 0
     2652         and ub.dis-host.dt-code = 0
     2653         BREAK
     2654         by ub.dis-host.d-card
     2655         by ub.dis-host.dt-code
     2656         by ub.dis-host.host-code:
     2657           assign
     2658           do-chk-num = 0
     2659           do-gds-sum-rubl = 0
     2660           do-disc-sum-rubl = 0
     2661           do-pay-sum-rubl = 0
     2662           do-gds-sum-base = 0
     2663           do-disc-sum-base = 0
     2664           do-pay-sum-base = 0
     2665           dh-chk-num = 0
     2666           dh-gds-sum-rubl = 0
     2667           dh-disc-sum-rubl = 0
     2668           dh-pay-sum-rubl = 0
     2669           dh-gds-sum-base = 0
     2670           dh-disc-sum-base = 0
     2671           dh-pay-sum-base = 0
     2672           p-pay-sum-rubl = 0
     2673           p-pay-sum-base = 0
     2674           dh-chk-num = dis-host.num-chk
     2675           dh-gds-sum-rubl = dis-host.gds-tot-rubl
     2676           dh-disc-sum-rubl = dis-host.gds-dis-rubl
     2677           dh-pay-sum-rubl = dis-host.pay-tot-rubl
     2678           dh-gds-sum-base = dis-host.gds-tot-base
     2679           dh-disc-sum-base =  dis-host.gds-dis-base
     2680           dh-pay-sum-base = dis-host.pay-tot-base
     2681           .
     2682           FOR EACH ub.payment no-lock where
     2683                    ub.payment.host-code = ub.dis-host.host-code AND
     2684                    ub.payment.d-card = ub.dis-host.d-card and
     2685                    ub.payment.status_ = 'факт':U:
     2686           if ub.payment.source-type = 'касс':U
     2687           or ub.payment.source-type = 'накл':U then next.
     2688           ASSIGN
     2689           p-pay-sum-rubl = p-pay-sum-rubl + ub.payment.tot-rubl
     2690           p-pay-sum-base = p-pay-sum-base + ub.payment.tot-base
     2691           .
     2692         end.
     2693         FOR  EACH ub.dis-obj no-lock where
     2694                ub.dis-obj.host-code = ub.dis-host.host-code
     2695            and ub.dis-obj.dt-code    = ub.dis-host.dt-code
     2696            and ub.dis-obj.d-card   = ub.dis-host.d-card
     2697            AND ub.dis-obj.obj-type = p-obj-type
     2698            AND ub.dis-obj.obj-code = p-obj-code
     2699            :
     2700         ii = ii + 1.
     2701         if ii MOD 100 = 0 then
     2702         run waitfram-show in this-procedure ("Обработано " + string(ii) + " итогов по дисконтным картам на объекте").
     2703         assign
     2704         do-chk-num = do-chk-num + ub.dis-obj.num-chk
     2705         do-gds-sum-rubl = do-gds-sum-rubl + ub.dis-obj.gds-tot-rubl + ub.dis-obj.sum-tot-rubl
     2706         do-disc-sum-rubl = do-disc-sum-rubl + ub.dis-obj.gds-dis-rubl + ub.dis-obj.sum-dis-rubl
     2707         do-pay-sum-rubl = do-pay-sum-rubl + ub.dis-obj.pay-tot-rubl
     2708         do-gds-sum-base = do-gds-sum-base + ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base
     2709         do-disc-sum-base = do-disc-sum-base + ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base
     2710         do-pay-sum-base = do-pay-sum-base + ub.dis-obj.pay-tot-base
     2711         .
     2712       END.
     2713       IF p-view-mode = 1
     2714       or (abs(dh-pay-sum-rubl - (do-pay-sum-rubl + p-pay-sum-rubl)) > 0.005
     2715       OR abs(dh-pay-sum-base - (do-pay-sum-base + p-pay-sum-base)) > 0.005)
     2716       then
     2717       PUT STREAM TEST UNFORMATTED
     2718       dis-host.d-card format "X(16)" space(1)
     2719       dis-host.host-code format "999999999" space(3)
     2720       do-chk-num format "999999999" space(1)
     2721       do-gds-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2722       do-gds-sum-base format "->>>,>>>,>>9.99" space(1)
     2723       do-disc-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2724       do-disc-sum-base format "->>>,>>>,>>9.99" space(1)
     2725       do-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2726       do-pay-sum-base format "->>>,>>>,>>9.99" space(1)
     2727       p-pay-sum-rubl  format "->>>,>>>,>>9.99" space(6)
     2728       p-pay-sum-base  format "->>>,>>>,>>9.99" space(6)
     2729       dh-chk-num format "999999999" space(1)
     2730       dh-gds-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2731       dh-gds-sum-base format "->>>,>>>,>>9.99" space(1)
     2732       dh-disc-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2733       dh-disc-sum-base format "->>>,>>>,>>9.99" space(1)
     2734       dh-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2735       dh-pay-sum-base format "->>>,>>>,>>9.99" space(1)
     2736       dh-pay-sum-rubl - (do-pay-sum-rubl + p-pay-sum-rubl) format "->>>,>>>,>>9.99" space(1)
     2737       dh-pay-sum-base - (do-pay-sum-base + p-pay-sum-base) format "->>>,>>>,>>9.99" space(1)
     2738       skip.
     2739     END.
     2740   end.
     2741   when 4 then do:
     2742     FOR EACH ub.dis-obj No-LOCK
     2743     BREAK
     2744     by ub.dis-obj.host-code
     2745     by ub.dis-obj.d-card:
     2746       ii = ii + 1.
     2747       if ii MOD 100 = 0 then
     2748       run waitfram-show in this-procedure ("Обработано " + string(ii) + " итогов по дисконтным картам на объекте").
     2749       IF FIRST-of(ub.dis-obj.d-card) then do:
     2750         assign
     2751         p-pay-sum-rubl = 0
     2752         p-pay-sum-base = 0
     2753         do-pay-sum-rubl = 0
     2754         do-pay-sum-base = 0
     2755         .
     2756       END.
     2757       if ub.dis-obj.dt-code = 0 then dO:
     2758         assign
     2759         do-pay-sum-rubl = do-pay-sum-rubl + ub.dis-obj.pay-tot-rubl
     2760         do-pay-sum-base = do-pay-sum-base + ub.dis-obj.pay-tot-base
     2761         .
     2762       end.
     2763       IF LAST-OF(ub.dis-obj.d-card) then do:
     2764         FOR EACH ub.payment no-lock where
     2765                 ub.payment.host-code = ub.dis-obj.host-code AND
     2766                 ub.payment.d-card = entry(1, ub.dis-obj.d-card, chr(4)) and
     2767                 ub.payment.status_ = 'факт':U and
     2768                 ub.payment.source-type = 'касс':U:
     2769           ASSIGN
     2770           p-pay-sum-rubl = p-pay-sum-rubl + if ub.payment.tot-rubl = ? then 0 else ub.payment.tot-rubl
     2771           p-pay-sum-base = p-pay-sum-base + if ub.payment.tot-base = ? then 0 else ub.payment.tot-base
     2772           .
     2773         end.
     2774         FOR EACH ub.payment no-lock where
     2775                 ub.payment.host-code = ub.dis-obj.host-code AND
     2776                 ub.payment.d-card = entry(1, dis-obj.d-card, chr(4)) and
     2777                 ub.payment.status_ = 'факт':U and
     2778                 ub.payment.source-type = 'касс':U + chr(44) + "data-import"  :
     2779           ASSIGN
     2780           p-pay-sum-rubl = p-pay-sum-rubl + if ub.payment.tot-rubl = ? then 0 else ub.payment.tot-rubl
     2781           p-pay-sum-base = p-pay-sum-base + if ub.payment.tot-base = ? then 0 else ub.payment.tot-base
     2782           .
     2783         end.
     2784         FOR EACH ub.payment no-lock where
     2785                 ub.payment.host-code = ub.dis-obj.host-code AND
     2786                 ub.payment.d-card = entry(1, ub.dis-obj.d-card, chr(4)) and
     2787                 ub.payment.status_ = 'факт':U and
     2788                 ub.payment.source-type = 'накл':U:
     2789           ASSIGN
     2790           p-pay-sum-rubl = p-pay-sum-rubl + ub.payment.tot-rubl
     2791           p-pay-sum-base = p-pay-sum-base + ub.payment.tot-base
     2792           .
     2793         end.
     2794         FOR EACH ub.payment no-lock where
     2795                 ub.payment.host-code = ub.dis-obj.host-code AND
     2796                 ub.payment.d-card = entry(1, ub.dis-obj.d-card, chr(4)) and
     2797                 ub.payment.status_ = 'факт':U and
     2798                 ub.payment.source-type = 'накл':U + chr(44) + "data-import":U:
     2799           ASSIGN
     2800           p-pay-sum-rubl = p-pay-sum-rubl + ub.payment.tot-rubl
     2801           p-pay-sum-base = p-pay-sum-base + ub.payment.tot-base
     2802           .
     2803         end.
     2804         if p-view-mode = 1
     2805         or ((do-pay-sum-rubl - p-pay-sum-rubl) <> 0
     2806         or (do-pay-sum-base - p-pay-sum-base) <> 0) then
     2807         PUT STREAM TEST UNFORMATTED
     2808         ub.dis-obj.d-card format "X(16)" space(1)
     2809         do-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2810         do-pay-sum-base format "->>>,>>>,>>9.99" space(1)
     2811         p-pay-sum-rubl  format "->>>,>>>,>>9.99" space(1)
     2812         p-pay-sum-base  format "->>>,>>>,>>9.99" space(1)
     2813         (do-pay-sum-rubl - p-pay-sum-rubl) format "->>>,>>>,>>9.99" space(1)
     2814         (do-pay-sum-base - p-pay-sum-base) format "->>>,>>>,>>9.99" space(1)
     2815         SKIP.
     2816       END.
     2817     end.
     2818   END.
     2819   WHEN 5 then do:
     2820     FOR EACH ub.dis-card No-LOCK
     2821     BREAK
     2822     by ub.dis-card.d-card:
     2823       ii = ii + 1.
     2824       if ii MOD 100 = 0 then
     2825       run waitfram-show in this-procedure ("Обработано " + string(ii) + " дисконтных карт").
     2826       IF FIRST-of(dis-card.d-card) then do:
     2827         assign
     2828         dh-gds-sum-rubl = 0
     2829         dh-disc-sum-rubl = 0
     2830         dh-pay-sum-rubl = 0
     2831         dh-gds-sum-base = 0
     2832         dh-disc-sum-base = 0
     2833         dh-pay-sum-base = 0
     2834         .
     2835         FOR EACH ub.dis-host No-LOCK
     2836            WHERE ub.dis-host.d-card = ub.dis-card.d-card
     2837                and ub.dis-host.host-code > 0
     2838                and ub.dis-host.dt-code = 0
     2839         break
     2840         by ub.dis-host.host-code:
     2841           assign
     2842           dh-gds-sum-rubl = dh-gds-sum-rubl + dis-host.gds-tot-rubl
     2843           dh-disc-sum-rubl = dh-disc-sum-rubl + dis-host.gds-dis-rubl
     2844           dh-pay-sum-rubl = dh-pay-sum-rubl + dis-host.pay-tot-rubl
     2845           dh-gds-sum-base = dh-gds-sum-base + dis-host.gds-tot-base
     2846           dh-disc-sum-base = dh-disc-sum-base + dis-host.gds-dis-base
     2847           dh-pay-sum-base = dh-pay-sum-base + dis-host.pay-tot-base
     2848           .
     2849           if dis-card.emitent-host-code = 0 and
     2850           (abs((dis-host.gds-tot-rubl - dis-host.gds-dis-rubl) - dis-host.pay-tot-rubl ) > 0.001 OR
     2851             abs((dis-host.gds-tot-base - dis-host.gds-dis-base) - dis-host.pay-tot-base) > 0.001
     2852           ) then do:
     2853             PUT stream test unformatted
     2854             dis-card.d-card format "X(16)" space(1)
     2855             dis-host.host-code format "999999999" space(3)
     2856             dis-host.gds-tot-rubl format "->>>,>>>,>>9.99" space(1)
     2857             dis-host.gds-tot-base format "->>>,>>>,>>9.99" space(1)
     2858             dis-host.gds-dis-rubl format "->>>,>>>,>>9.99" space(1)
     2859             dis-host.gds-dis-base format "->>>,>>>,>>9.99" space(1)
     2860             dis-host.pay-tot-rubl format "->>>,>>>,>>9.99" space(1)
     2861             dis-host.pay-tot-base format "->>>,>>>,>>9.99" space(3)
     2862             ((dis-host.gds-tot-rubl - dis-host.gds-dis-rubl) - dis-host.pay-tot-rubl) format "->>>,>>>,>>9.99" space(1)
     2863             ((dis-host.gds-tot-base - dis-host.gds-dis-base) - dis-host.pay-tot-base) format "->>>,>>>,>>9.99" space(1)
     2864             "ОШИБКА глобкарта" format "X(15)" space(1)
     2865             "!ненулевое сальдо" format "X(15)" space(3)
     2866             SKIP.
     2867           end.
     2868         END.
     2869         if p-view-mode = 1
     2870         or (((dh-gds-sum-rubl - dh-disc-sum-rubl) - dh-pay-sum-rubl -  dis-card.saldo-rubl) <> 0
     2871         OR ((dh-gds-sum-BASE - dh-disc-sum-base) - dh-pay-sum-base -  dis-card.saldo-base) <> 0)
     2872         then
     2873         PUT stream test unformatted
     2874         dis-card.d-card format "X(16)" space(1)
     2875         dis-card.emitent-host-code format "999999999" space(3)
     2876         dh-gds-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2877         dh-gds-sum-base format "->>>,>>>,>>9.99" space(1)
     2878         dh-disc-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2879         dh-disc-sum-base format "->>>,>>>,>>9.99" space(1)
     2880         dh-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2881         dh-pay-sum-base format "->>>,>>>,>>9.99" space(3)
     2882         (dh-gds-sum-rubl - dh-disc-sum-rubl) - dh-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2883         (dh-gds-sum-BASE - dh-disc-sum-base) - dh-pay-sum-base format "->>>,>>>,>>9.99" space(1)
     2884         dis-card.saldo-rubl format "->>>,>>>,>>9.99" space(1)
     2885         dis-card.saldo-base format "->>>,>>>,>>9.99" space(3)
     2886         ((dh-gds-sum-rubl - dh-disc-sum-rubl) - dh-pay-sum-rubl -  dis-card.saldo-rubl) format "->>>,>>>,>>9.99" space(1)
     2887         ((dh-gds-sum-BASE - dh-disc-sum-base) - dh-pay-sum-base -  dis-card.saldo-base) format "->>>,>>>,>>9.99" space(1)
     2888         SKIP.
     2889       END.
     2890     END.
     2891   END.
     2892   when 7 then do:
     2893     FOR EACH buf_dis-card No-LOCK where
     2894       buf_Dis-card.emitent-host-code = dctype
     2895   ,
     2896      first buf_dis-card-type no-lock where
     2897           buf_dis-card-type.type = buf_dis-card.type
     2898       AND buf_dis-card-type.emitent-host-code = buf_dis-card.emitent-host-code
     2899     :
     2900         if NOT new-d-pcnt = old-d-pcnt
     2901         or p-view-mode = 1 then do:
     2902           PUT stream test unformatted
     2903           buf_dis-card.d-card format "X(16)" space(1)
     2904           buf_dis-card.type   format "X(8)" space(1)
     2905           for-sum format "->>>,>>>,>>9.99" space(1)
     2906           buf_dis-card.d-pcnt format "->,>>9.99" space(1)
     2907           new-d-pcnt          format "->,>>9.99" space(1)
     2908           skip.
     2909         end.
     2910       END.
     2911     end.
     2912    when 8 then do:
     2913     run ref/proprefs.w (
     2914                      input parparentproc
     2915                     ,input 'b-sel'
     2916                     ,input "dis-tot"
     2917                     ,input 5
     2918                     ,input '':U
     2919                     ,input '':U
     2920                     ,input-output  v-ref-list) no-error.
     2921     if error-status:error or v-ref-list = '':u then do:
     2922       return.
     2923     end.
     2924     find first buf_prop-ref no-lock where
     2925              recid(buf_prop-ref) = integer(v-ref-list).
     2926     assign
     2927     v-dt-code = buf_prop-ref.dt-code
     2928     v-sum-id =  buf_prop-ref.sum-id
     2929     .
     2930     assign
     2931     v-date-from =  date(entry(1, buf_prop-ref.sum-id, "-"))
     2932     v-date-to =  date(entry(2, buf_prop-ref.sum-id, "-"))
     2933     .
     2934     PUT stream test unformatted
     2935     substitute("Идентификатор частного итога &1 Доп.идентификатор &2"
     2936                 ,v-sum-id
     2937                 ,buf_prop-ref.caller_id
     2938                 ) skip.
     2939     FOR EACH buf_dis-card No-LOCK where
     2940        true
     2941        :
     2942        for each buf_clients no-lock where
     2943               buf_clients.obj-type = 'маг':U
     2944          and buf_clients.obj-code = p-obj-code
     2945          and  (v-cntxt-db-num = 0 or buf_clients.db-num = v-cntxt-db-num):
     2946         assign
     2947         v-chk-num = 0
     2948         v-netto-sum = 0.
     2949           _buf_chk-doc:
     2950           for each buf_chk-doc no-lock where
     2951             buf_chk-doc.d-card = buf_dis-card.d-card
     2952             and buf_chk-doc.obj-type = buf_clients.obj-type
     2953             and buf_chk-doc.obj-code = buf_clients.obj-code
     2954             and buf_chk-doc.chk-date >= v-date-from
     2955             and buf_chk-doc.chk-date <= v-date-to
     2956             :
     2957             assign
     2958             v-chk-num = v-chk-num  + 1
     2959             v-netto-sum  = v-netto-sum + buf_chk-doc.netto
     2960             .
     2961           end.
     2962         find first buf_dis-obj no-lock where
     2963                   buf_dis-obj.obj-type = buf_clients.obj-type
     2964               and buf_dis-obj.obj-code = buf_clients.obj-code
     2965               and buf_dis-obj.d-card = buf_dis-card.d-card
     2966               and buf_dis-obj.dt-code = v-dt-code no-error .
     2967         if not available buf_dis-obj then do:
     2968           assign
     2969           v-chk-num-do = 0
     2970           v-netto-sum-do = 0
     2971           .
     2972         end.
     2973         else do:
     2974           assign
     2975           v-chk-num-do = buf_dis-obj.num-chk
     2976           v-netto-sum-do = (if v-curr-r-b = 'rubl':U
     2977                          then (buf_dis-obj.gds-tot-rubl - buf_dis-obj.gds-dis-rubl)
     2978                          else (buf_dis-obj.gds-tot-base - buf_dis-obj.gds-dis-base)
     2979                          )
     2980           .
     2981         end.
     2982         if v-chk-num <> v-chk-num-do
     2983         or p-view-mode = 1
     2984         then do:
     2985             PUT stream test unformatted
     2986             string(p-obj-type + string(buf_clients.obj-code), "X(20)") space(1)
     2987             buf_dis-card.d-card format "X(16)" space(1)
     2988             v-chk-num   format ">>>>>>>>>" space(10)
     2989             v-chk-num-do   format ">>>>>>>>>" space(10)
     2990             v-netto-sum    format ">>>,>>>,>>>,>>9.999" space(1)
     2991             v-netto-sum-do format ">>>,>>>,>>>,>>9.999" space(1)
     2992             skip.
     2993         end.
     2994       end.
     2995     end.
     2996   end.
     2997     when 99 then do:
     2998       FOR EACH buf_dis-card No-LOCK where
     2999       buf_Dis-card.emitent-host-code = dctype
     3000      AND buf_dis-card.d-card =  f-d-card
     3001        :
     3002         v-chk-num = 0.
     3003        for each buf_clients no-lock where
     3004               buf_clients.obj-type = 'маг':U
     3005          and buf_clients.obj-code = p-obj-code
     3006          and  (v-cntxt-db-num = 0 or buf_clients.db-num = v-cntxt-db-num):
     3007         for each buf_chk-doc no-lock where
     3008           buf_chk-doc.d-card = buf_dis-card.d-card
     3009           and buf_chk-doc.obj-type = buf_clients.obj-type
     3010           and buf_chk-doc.obj-code = buf_clients.obj-code:
     3011           assign
     3012           v-chk-num = v-chk-num  + 1
     3013           .
     3014         end.
     3015           find first buf_dis-obj no-lock where
     3016                     buf_dis-obj.obj-type = buf_clients.obj-type
     3017                 and buf_dis-obj.obj-code = buf_clients.obj-code
     3018                 and buf_dis-obj.d-card = buf_dis-card.d-card
     3019                 and buf_dis-obj.dt-code = 0  no-error .
     3020           if not available buf_dis-obj then do:
     3021             assign
     3022             v-chk-num-do = 0.
     3023           end.
     3024           else do:
     3025             assign
     3026             v-chk-num-do = buf_dis-obj.num-chk.
     3027           end.
     3028           if v-chk-num <> v-chk-num-do
     3029           or p-view-mode = 1
     3030           then do:
     3031             PUT stream test unformatted
     3032             string(buf_clients.obj-type + string(buf_clients.obj-code), "X(20)") space(1)
     3033             buf_dis-card.d-card format "X(16)" space(1)
     3034             v-chk-num   format ">>>>>>>>>" space(10)
     3035             v-chk-num-do   format ">>>>>>>>>" space(10)
     3036             skip.
     3037           end.
     3038         end.
     3039       end.
     3040     end.
     3041   END CASE.
     3042   end.
     3043   else do:
     3044   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3045   CASE test-number:
     3046     when 1 then do:
     3047   _chk-doc:
     3048       FOR EACH buf_dis-card NO-LOCK where
     3049               buf_dis-card.d-card = f-d-card,
     3050           EACH buf_shop no-lock,
     3051           EACH buf_chk-doc NO-LOCK where
     3052               buf_chk-doc.obj-type = 'маг':U AND
     3053               buf_chk-doc.obj-code = buf_shop.obj-code AND
     3054               buf_chk-doc.d-card = buf_dis-card.d-card
     3055           break by buf_chk-doc.obj-type
     3056                 by buf_chk-doc.obj-code
     3057                 by buf_chk-doc.d-card:
     3058           ii = ii + 1.
     3059           if ii MOD 100 = 0 then
     3060           run waitfram-show in this-procedure ("Обработано " + string(ii) + " чеков по дисконтным картам").
     3061           IF FIRST-OF(buf_chk-doc.obj-code) then do:
