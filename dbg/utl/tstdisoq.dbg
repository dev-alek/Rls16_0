     2091                AND  buf_dis-obj.obj-type = temp-d-card.obj-type
     2092                AND  buf_dis-obj.obj-code = temp-d-card.obj-code
     2093                AND  buf_dis-obj.dt-code = 0  No-ERROR.
     2094         IF NOT AVAIL buf_dis-obj then do:
