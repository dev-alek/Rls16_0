     3982                                      ,output v-sum-rubl
     3983                                      ,output v-vat-base
     3984                                      ,output v-vat-rubl
     3985                                      ,output v-slt-base
     3986                                      ,output v-slt-rubl
     3987                                      ,output v-road-tax-base
     3988                                      ,output v-road-tax-rubl
     3989                                      ,output v-transport-base
     3990                                      ,output v-transport-rubl
     3991                                      ,output v-other-base
     3992                                      ,output v-other-rubl
     3993                                      ,output v-excise-base
     3994                                      ,output v-excise-rubl
     3995                                       ) .
     3996       assign
     3997       temp-d-card.gds-tot-r0 = temp-d-card.gds-tot-r0 + par-direction * par-sign * abs( v-sum-rubl)
     3998       temp-d-card.gds-tot-b0 = temp-d-card.gds-tot-b0 + par-direction * par-sign * abs( v-sum-base)
     3999       .
     4000     END.
     4001   end.
     4002   if v-curr-r-b = 'base':U then
     4003   assign
     4004   temp-d-card.gds-tot-r-b = temp-d-card.gds-tot-base
     4005   temp-d-card.gds-dis-r-b = temp-d-card.gds-dis-base
     4006   temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-base
     4007   .
     4008   else
     4009   assign
     4010   temp-d-card.gds-tot-r-b = temp-d-card.gds-tot-rubl
     4011   temp-d-card.gds-dis-r-b = temp-d-card.gds-dis-rubl
     4012   temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-rubl
     4013   .
     4014     find first vchk-pay no-lock where
     4015               vchk-pay.d-card   = temp-d-card.d-card
     4016           AND vchk-pay.pay-code = bf_trn-doc.pay-code
     4017           AND vchk-pay.curr-code = bf_trn-doc.exch-code
     4018           AND vchk-pay.doc-date  = 01/01/1990
     4019           AND vchk-pay.cre-pay   = (cre-pay = bf_trn-doc.pay-code) no-error .
     4020     if not available vchk-pay then do:
     4021       create vchk-pay.
     4022       assign
     4023       vchk-pay.d-card   = temp-d-card.d-card
     4024       vchk-pay.doc-date = bf_trn-doc.exch-date
     4025       vchk-pay.pay-code = bf_trn-doc.pay-code
     4026       vchk-pay.curr-code = bf_trn-doc.exch-code
     4027       vchk-pay.cre-pay   =  no
     4028       vchk-pay.exch-rate = bf_trn-doc.exch-rate
     4029       vchk-pay.base-rate = bf_trn-doc.base-rate
     4030       vchk-pay.tot-base =  temp-d-card.pay-tot-base
     4031       vchk-pay.tot-rubl =  temp-d-card.pay-tot-rubl
     4032       vchk-pay.tot-sum =  (if bf_trn-doc.exch-code = 0 then temp-d-card.pay-tot-rubl else temp-d-card.pay-tot-base)
     4033       .
     4034     end.
     4035         assign
     4036         p-pay-sum-rubl = 0
     4037         p-pay-sum-base = 0
     4038         .
     4039         find first buf_payment no-lock where
     4040                   buf_payment.host-code = bf_trn-doc.host-code
     4041             AND  buf_payment.d-card = temp-d-card.d-card
     4042             and  buf_payment.status_ = 'факт':U
     4043             and  buf_payment.source-type = 'накл':U
     4044             and  buf_payment.source-ref = bf_trn-doc.doc-code  no-error .
     4045         if available buf_payment then
     4046         assign
     4047         p-pay-sum-rubl = buf_payment.tot-rubl
     4048         p-pay-sum-base = buf_payment.tot-base
     4049         .
     4050         if p-view-mode = 1
     4051         OR (p-pay-sum-base <> temp-d-card.pay-tot-base
     4052         or p-pay-sum-rubl <> temp-d-card.pay-tot-rubl) then
     4053         PUT STREAM TEST UNFORMATTED
     4054         temp-d-card.d-card format "X(16)" space(1)
     4055         bf_trn-doc.doc-code space(1)
     4056         temp-d-card.pay-tot-rubl format "->>>,>>>,>>9.99" space(1)
     4057         temp-d-card.pay-tot-base format "->>>,>>>,>>9.99" space(1)
     4058         p-pay-sum-rubl  format "->>>,>>>,>>9.99" space(1)
     4059         p-pay-sum-base  format "->>>,>>>,>>9.99" space(1)
     4060         (temp-d-card.pay-tot-rubl - p-pay-sum-rubl) format "->>>,>>>,>>9.99" space(1)
     4061         (temp-d-card.pay-tot-base - p-pay-sum-base) format "->>>,>>>,>>9.99" space(1)
     4062         SKIP.
     4063       end.
     4064         end.
     4065     end.
     4066     when 3 then do:
     4067       FOR EACH ub.dis-host no-LOCK
     4068         WHERE ub.dis-host.d-card =  f-d-card
     4069         AND ub.dis-host.host-code > 0
     4070         and ub.dis-host.dt-code = 0
     4071         BREAK
     4072         by ub.dis-host.d-card
     4073         by ub.dis-host.dt-code
     4074         by ub.dis-host.host-code:
     4075           assign
     4076           do-chk-num = 0
     4077           do-gds-sum-rubl = 0
     4078           do-disc-sum-rubl = 0
     4079           do-pay-sum-rubl = 0
     4080           do-gds-sum-base = 0
     4081           do-disc-sum-base = 0
     4082           do-pay-sum-base = 0
     4083           dh-chk-num = 0
     4084           dh-gds-sum-rubl = 0
     4085           dh-disc-sum-rubl = 0
     4086           dh-pay-sum-rubl = 0
     4087           dh-gds-sum-base = 0
     4088           dh-disc-sum-base = 0
     4089           dh-pay-sum-base = 0
     4090           p-pay-sum-rubl = 0
     4091           p-pay-sum-base = 0
     4092           dh-chk-num = dis-host.num-chk
     4093           dh-gds-sum-rubl = dis-host.gds-tot-rubl
     4094           dh-disc-sum-rubl = dis-host.gds-dis-rubl
     4095           dh-pay-sum-rubl = dis-host.pay-tot-rubl
     4096           dh-gds-sum-base = dis-host.gds-tot-base
     4097           dh-disc-sum-base =  dis-host.gds-dis-base
     4098           dh-pay-sum-base = dis-host.pay-tot-base
     4099           .
     4100           FOR EACH ub.payment no-lock where
     4101                    ub.payment.host-code = ub.dis-host.host-code AND
     4102                    ub.payment.d-card = ub.dis-host.d-card and
     4103                    ub.payment.status_ = 'факт':U:
     4104           if ub.payment.source-type = 'касс':U
     4105           or ub.payment.source-type = 'накл':U then next.
     4106           ASSIGN
     4107           p-pay-sum-rubl = p-pay-sum-rubl + ub.payment.tot-rubl
     4108           p-pay-sum-base = p-pay-sum-base + ub.payment.tot-base
     4109           .
     4110         end.
     4111         FOR  EACH ub.dis-obj no-lock where
     4112                ub.dis-obj.host-code = ub.dis-host.host-code
     4113            and ub.dis-obj.dt-code    = ub.dis-host.dt-code
     4114            and ub.dis-obj.d-card   = ub.dis-host.d-card
     4115            :
     4116         ii = ii + 1.
     4117         if ii MOD 100 = 0 then
     4118         run waitfram-show in this-procedure ("Обработано " + string(ii) + " итогов по дисконтным картам на объекте").
     4119         assign
     4120         do-chk-num = do-chk-num + ub.dis-obj.num-chk
     4121         do-gds-sum-rubl = do-gds-sum-rubl + ub.dis-obj.gds-tot-rubl + ub.dis-obj.sum-tot-rubl
     4122         do-disc-sum-rubl = do-disc-sum-rubl + ub.dis-obj.gds-dis-rubl + ub.dis-obj.sum-dis-rubl
     4123         do-pay-sum-rubl = do-pay-sum-rubl + ub.dis-obj.pay-tot-rubl
     4124         do-gds-sum-base = do-gds-sum-base + ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base
     4125         do-disc-sum-base = do-disc-sum-base + ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base
     4126         do-pay-sum-base = do-pay-sum-base + ub.dis-obj.pay-tot-base
     4127         .
     4128       END.
     4129       IF p-view-mode = 1
     4130       or (abs(dh-pay-sum-rubl - (do-pay-sum-rubl + p-pay-sum-rubl)) > 0.005
     4131       OR abs(dh-pay-sum-base - (do-pay-sum-base + p-pay-sum-base)) > 0.005)
     4132       then
     4133       PUT STREAM TEST UNFORMATTED
     4134       dis-host.d-card format "X(16)" space(1)
     4135       dis-host.host-code format "999999999" space(3)
     4136       do-chk-num format "999999999" space(1)
     4137       do-gds-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4138       do-gds-sum-base format "->>>,>>>,>>9.99" space(1)
     4139       do-disc-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4140       do-disc-sum-base format "->>>,>>>,>>9.99" space(1)
     4141       do-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4142       do-pay-sum-base format "->>>,>>>,>>9.99" space(1)
     4143       p-pay-sum-rubl  format "->>>,>>>,>>9.99" space(6)
     4144       p-pay-sum-base  format "->>>,>>>,>>9.99" space(6)
     4145       dh-chk-num format "999999999" space(1)
     4146       dh-gds-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4147       dh-gds-sum-base format "->>>,>>>,>>9.99" space(1)
     4148       dh-disc-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4149       dh-disc-sum-base format "->>>,>>>,>>9.99" space(1)
     4150       dh-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4151       dh-pay-sum-base format "->>>,>>>,>>9.99" space(1)
     4152       dh-pay-sum-rubl - (do-pay-sum-rubl + p-pay-sum-rubl) format "->>>,>>>,>>9.99" space(1)
     4153       dh-pay-sum-base - (do-pay-sum-base + p-pay-sum-base) format "->>>,>>>,>>9.99" space(1)
     4154       skip.
     4155     END.
     4156   end.
     4157   when 4 then do:
     4158     FOR EACH ub.dis-obj No-LOCK
     4159        WHERE ub.dis-obj.d-card =  f-d-card
     4160     BREAK
