     4207           p-pay-sum-rubl = p-pay-sum-rubl + ub.payment.tot-rubl
     4208           p-pay-sum-base = p-pay-sum-base + ub.payment.tot-base
     4209           .
     4210         end.
     4211         FOR EACH ub.payment no-lock where
     4212                 ub.payment.host-code = ub.dis-obj.host-code AND
