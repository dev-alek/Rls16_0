      849         "slt-pc        " p-slt-pc         skip
      850         "sum-base      " p-sum-base       skip
      851         "sum-rubl      " p-sum-rubl       skip
      852         "vat-base      " p-vat-base       skip
      853         "vat-rubl      " p-vat-rubl       skip
      854         "slt-base      " p-slt-base       skip
      855         "slt-rubl      " p-slt-rubl       skip
      856         "road-tax-base " p-road-tax-base  skip
      857         "road-tax-rubl " p-road-tax-rubl  skip
      858         "transport-base" p-transport-base skip
      859         "transport-rubl" p-transport-rubl skip
