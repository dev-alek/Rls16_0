     4168         p-pay-sum-rubl = 0
     4169         p-pay-sum-base = 0
     4170         do-pay-sum-rubl = 0
     4171         do-pay-sum-base = 0
     4172         .
     4173       END.
     4174       if ub.dis-obj.dt-code = 0 then dO:
     4175         assign
     4176         do-pay-sum-rubl = do-pay-sum-rubl + ub.dis-obj.pay-tot-rubl
     4177         do-pay-sum-base = do-pay-sum-base + ub.dis-obj.pay-tot-base
     4178         .
     4179       end.
     4180       IF LAST-OF(ub.dis-obj.d-card) then do:
     4181         FOR EACH ub.payment no-lock where
     4182                 ub.payment.host-code = ub.dis-obj.host-code AND
     4183                 ub.payment.d-card = entry(1, ub.dis-obj.d-card, chr(4)) and
     4184                 ub.payment.status_ = 'факт':U and
     4185                 ub.payment.source-type = 'касс':U:
     4186           ASSIGN
     4187           p-pay-sum-rubl = p-pay-sum-rubl + if ub.payment.tot-rubl = ? then 0 else ub.payment.tot-rubl
     4188           p-pay-sum-base = p-pay-sum-base + if ub.payment.tot-base = ? then 0 else ub.payment.tot-base
     4189           .
     4190         end.
     4191         FOR EACH ub.payment no-lock where
     4192                 ub.payment.host-code = ub.dis-obj.host-code AND
     4193                 ub.payment.d-card = entry(1, dis-obj.d-card, chr(4)) and
     4194                 ub.payment.status_ = 'факт':U and
     4195                 ub.payment.source-type = 'касс':U + chr(44) + "data-import"  :
     4196           ASSIGN
     4197           p-pay-sum-rubl = p-pay-sum-rubl + if ub.payment.tot-rubl = ? then 0 else ub.payment.tot-rubl
     4198           p-pay-sum-base = p-pay-sum-base + if ub.payment.tot-base = ? then 0 else ub.payment.tot-base
     4199           .
     4200         end.
     4201         FOR EACH ub.payment no-lock where
     4202                 ub.payment.host-code = ub.dis-obj.host-code AND
     4203                 ub.payment.d-card = entry(1, ub.dis-obj.d-card, chr(4)) and
     4204                 ub.payment.status_ = 'факт':U and
     4205                 ub.payment.source-type = 'накл':U:
