      867   end procedure.
      868   define variable vss-include-info8 as character format "X(65)" no-undo
      869   initial "@(#)$Workfile$ $Revision$".
      870   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      871   procedure r-cost :
      872     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      873     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      874     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      875     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      876     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      877     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      878     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      879     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      880     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      881     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      882     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      883     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      884     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      885     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      886     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      887     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      888     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      889     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      890     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      891     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      892     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      893     do
      894     on error undo, return error
      895     :
      896       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      897       define buffer   in-vatp-parts    for ub.parts   .
      898       define buffer   in-vatp-doc      for ub.trn-doc .
      899       define buffer   in-vatp-goods    for ub.goods   .
      900       define buffer   in-vatp-sysconf  for ub.sysconf .
      901       define buffer   in-vatp_doc-attr for ub.doc-attr.
      902       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      903       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
