      468       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
      469       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      470       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
      471       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
      472       define variable varis-one-gds-dtl        as   logical                             no-undo.
      473       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
      474       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
      475       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
      476       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
      477       define variable varoutvprb               as   character                           no-undo.
      478       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
      479       define buffer   in-vatp-trn-doco  for ub.trn-doc .
      480       define buffer   in-vatp-partso    for ub.parts   .
      481       define buffer   in-vatp-doco      for ub.trn-doc .
      482       define buffer   in-vatp-goodso    for ub.goods   .
      483       define buffer   in-vatp-sysconfo  for ub.sysconf .
      484       define buffer   in-vatp_doc-attro for ub.doc-attr.
      485       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
      486       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
      487       define variable varinvprbo                  as   character              no-undo.
      488       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
      489       define variable cli-base-rateo              as   decimal                no-undo.
      490       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
      491       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
      492       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
      493       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
      494       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
      495       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
      496       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
      497       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
      498       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
      499       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
      500       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
      501       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
      502       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
      503       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
      504       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
      505       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
      506       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
      507       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
      508       define variable other-base-loco             like ub.doc-line.price-base no-undo.
      509       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
      510       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
      511       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
      512       define variable varinvatp-envdo             as   character              no-undo.
      513       define variable varinvatp-typeo             as   character              no-undo.
      514       define variable v-gds-dtl-fact-qnty as decimal no-undo .
      515       define buffer buf_gds-dtl  for ub.gds-dtl .
      516       define buffer buf_goods    for ub.goods .
      517       define buffer buf_trn-doc  for ub.trn-doc .
      518       define buffer buf_doc-line for ub.doc-line .
      519       find first buf_doc-line no-lock
      520         where buf_doc-line.doc-code  = p-doc-code
      521           and buf_doc-line.artic     = p-artic
      522           and buf_doc-line.prod-type = p-prod-type
      523           and buf_doc-line.prod-code = p-prod-code
      524         no-error .
      525       if not available buf_doc-line then do:
      526         message
      527           vss-workfile vss-revision vss-description skip
      528           vss-include-info4 skip
      529           "Ошибка задания входных параметров" skip
      530           "Не найдена строка документа" skip
      531           "Документ" p-doc-code skip
      532           "Артикул" p-artic p-prod-type p-prod-code skip
      533           view-as alert-box error .
      534         undo, return error .
      535       end.
      536       find first buf_trn-doc no-lock
      537         where buf_trn-doc.doc-code = buf_doc-line.doc-code
      538         no-error .
      539       if not available buf_trn-doc then do:
      540         message
      541           vss-workfile vss-revision vss-description skip
      542           vss-include-info4 skip
      543           "Не найден документ" skip
      544           "Документ" p-doc-code skip
      545           "Артикул" p-artic p-prod-type p-prod-code skip
      546           view-as alert-box error .
      547         undo, return error .
      548       end.
      549       for each buf_gds-dtl no-lock
      550         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
      551           and buf_gds-dtl.artic     = buf_doc-line.artic
      552           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
      553           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
      554       on error undo, return error
      555       :
      556           if buf_trn-doc.doc-type <> 'инв':U
      557           then do:
      558               if buf_trn-doc.doc-type = 'при':U
      559               or buf_trn-doc.doc-type = 'возврат':U
      560               then do:
      561                   assign
      562                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
      563                   .
      564               end.
      565               else do:
      566                   assign
      567                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
      568                   .
      569               end.
      570           end.
      571           else do:
      572               assign
      573                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
      574               .
      575           end.
      576           if v-gds-dtl-fact-qnty <> 0
      577           then do:
      578   if buf_trn-doc.ext-doc-type = 'ot':U or
      579      buf_trn-doc.ext-doc-type = ?                 then do:
      580     assign
      581      out-vatp-have-vat-slt = yes.
      582   end.
      583   else do:
      584     find first out-vatp_doc-attr no-lock
      585       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      586         and out-vatp_doc-attr.attr-code = 'envd':U
      587         no-error .
      588     if not available out-vatp_doc-attr then do:
      589       assign
      590         out-vatp-have-vat-slt = yes.
      591     end.
      592     else do:
      593        out-vatp-have-vat-slt = no.
      594     end.
      595   end.
      596   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
      597                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
      598                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
      599   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      601     (input  buf_doc-line.artic
      602     ,input  buf_doc-line.prod-type
      603     ,input  buf_doc-line.prod-code
      604     ,output varroot-node
      605     ) no-error .
      606   if error-status :error then do:
      607     message
      608       vss-workfile vss-revision vss-description skip
      609       "Ошибка при определении корневого признака товара" skip
      610       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      611       error-status :get-message(1) skip
      612       return-value skip
      613       view-as alert-box error .
      614     undo, return error .
      615   end.
      616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      617     (input  varroot-node
      618     ,input  'empty-scale=request'
      619     ,output varempty-scale
      620     ) no-error .
      621   if error-status :error then do:
      622     message
      623       vss-workfile vss-revision vss-description skip
      624       "Ошибка при определении атрибута признака" skip
      625       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      626       "Признак" varroot-node skip
      627       "Запрашивался атрибут" "empty-scale=request" skip
      628       error-status :get-message(1) skip
      629       return-value skip
      630       view-as alert-box error .
      631     undo, return error .
      632   end.
      633   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      635     (output varoutvprb
      636     )  .
      637   if varoutvprb = "base":u then do:
      638     assign
      639           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
      640       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
      641     .
      642   end.
      643   else do:
      644     assign
      645           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
      646       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
      647     .
      648   end.
      649   if varoutvprb = "rubl":u then do:
      650     assign
      651           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
      652       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
      653   end.
      654   else do:
      655     assign
      656           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
      657       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
      658   end.
      659   assign
      660     varis-cons-parts-have =  no.
      661   assign
      662     varfact-qnty       = 0
      663     varcons-qnty       = 0
      664     varprice-base-cons = 0
      665     varprice-rubl-cons = 0.
      666   find first out-vatp_doc-line where
      667              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
      668          and out-vatp_doc-line.artic      = buf_doc-line.artic
      669          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
      670          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
      671   if available out-vatp_doc-line           and
      672     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
      673     assign
      674       varfact-qnty = out-vatp_doc-line.fact-qnty.
      675   end.
      676   else do:
      677     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
      678                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
      679                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
      680                                  and out-vatp_parts.artic      = buf_doc-line.artic
      681                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
      682                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
      683       if out-vatp_parts.purch-code = 2 then do:
      684   assign
      685     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
      686     price-base-with-tax-loco = out-vatp_parts.price-base
      687   .
      688   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      690     (output varinvprbo
      691     )  .
      692     if out-vatp_parts.out-code = 'free-zone':U     or
      693        out-vatp_parts.out-code = 'out-zone':U   or
      694        out-vatp_parts.doc-type = 'акт':U then do:
      695       assign
      696         in-vatp-have-vat-slto = yes.
      697     end.
      698     else do:
      699       find first in-vatp_doc-attro no-lock
      700         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
      701           and in-vatp_doc-attro.attr-code = 'envd':U
      702         no-error .
      703       if not available in-vatp_doc-attro then do:
      704         assign
      705           in-vatp-have-vat-slto = yes.
      706       end.
      707       else do:
      708            in-vatp-have-vat-slto = no.
      709       end.
      710     end.
      711     assign
      712      price-cli-with-tax-loco = out-vatp_parts.price-cli
      713      cli-base-rateo          = out-vatp_parts.cli-base-rate.
      714     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
      715              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
      716     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
      717             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
      718             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
      719             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
      720             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
      721             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
      722             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
      723       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
      724     assign
      725       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
      726     assign
      727       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
      728       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
      729       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
      730       transport-cli-loco  = 0
      731       other-cli-loco      = 0
      732     .
      733   ASSIGN
      734             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
      735       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
      736   .
      737         assign
      738           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
      739           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
      740         assign
      741           varis-cons-parts-have = yes
      742           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
      743       end.
      744       assign
      745         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
      746     end.
      747   end.
      748   assign
      749     varprice-base-cons = varprice-base-cons / varcons-qnty
      750     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
      751   if varprice-base-cons = ? then do:
      752     assign
      753       varprice-base-cons = 0.
      754   end.
      755   if varprice-rubl-cons = ? then do:
      756     assign
      757       varprice-rubl-cons = 0.
      758   end.
      759   assign
      760       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
      761     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
      762     discnt-base-sale            = buf_gds-dtl.discnt-base
      763     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
      764       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
      765     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
      766     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
      767     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
      768     .
      769   if buf_trn-doc.doc-type = 'инв':U then do:
      770     assign
      771       varfact-qnty = buf_gds-dtl.doc-qnty.
      772   end.
      773   else do:
      774     assign
      775       varfact-qnty = buf_gds-dtl.fact-qnty.
      776   end.
      777   if varis-cons-parts-have = no then do:
      778     assign
      779           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
      780           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
      781   end.
      782   else do:
      783     if buf_trn-doc.doc-type = 'инв':U then do:
      784       assign
      785               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      786               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      787        .
      788     end.
