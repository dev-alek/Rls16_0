      929       define variable varinvatp-envd             as   character              no-undo.
      930       define variable varinvatp-type             as   character              no-undo.
      931       def var v-parts-fact-qnty as decimal   no-undo .
      932       define buffer buf_parts    for ub.parts    .
      933       define buffer buf_goods    for ub.goods    .
      934       define buffer buf_trn-doc  for ub.trn-doc  .
      935       define buffer buf_doc-line for ub.doc-line .
      936       find first buf_doc-line no-lock
      937         where buf_doc-line.doc-code  = v-doc-code
      938           and buf_doc-line.artic     = v-artic
      939           and buf_doc-line.prod-type = v-prod-type
      940           and buf_doc-line.prod-code = v-prod-code
      941         no-error .
      942       if not available buf_doc-line then do:
      943         message
      944           vss-workfile vss-revision vss-description skip
      945           vss-include-info9 skip
      946           "Ошибка задания входных параметров" skip
      947           "Не найдена строка документа"  skip
      948           "Документ" v-doc-code skip
      949           "Артикул" v-artic v-prod-type v-prod-code skip
      950           view-as alert-box error .
      951         return error .
      952       end.
      953       find first buf_trn-doc no-lock
      954         where buf_trn-doc.doc-code = v-doc-code
      955         no-error .
      956       if not available buf_trn-doc then do:
      957         message
      958           vss-workfile vss-revision vss-description skip
      959           vss-include-info9 skip
      960           "Ошибка задания входных параметров" skip
      961           "Не найден документ" skip
      962           "Документ" v-doc-code skip
      963           "Артикул" v-artic v-prod-type v-prod-code skip
      964           view-as alert-box error .
      965         undo, return error .
      966       end.
      967       find first buf_goods no-lock
      968         where buf_goods.artic     = buf_doc-line.artic
      969           and buf_goods.prod-type = buf_doc-line.prod-type
      970           and buf_goods.prod-code = buf_doc-line.prod-code
      971         no-error .
      972       if not available buf_goods then do:
      973         message
      974           vss-workfile vss-revision vss-description skip
      975           vss-include-info9 skip
      976           "Ошибка задания входных параметров" skip
      977           "Не найден товар" skip
      978           "Документ" v-doc-code skip
      979           "Артикул" v-artic v-prod-type v-prod-code skip
      980           view-as alert-box error .
      981         undo, return error .
      982       end.
      983       if buf_goods.gds-type = 'т':U then do:
      984             for each buf_parts no-lock
      985               where buf_parts.out-code  = buf_trn-doc.doc-code
      986                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      987                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      988                 and buf_parts.artic     = buf_doc-line.artic
      989                 and buf_parts.prod-type = buf_doc-line.prod-type
      990                 and buf_parts.prod-code = buf_doc-line.prod-code
      991             on error undo, return error
      992             :
      993   assign
      994     price-rubl-with-tax-loc = buf_parts.price-rubl
      995     price-base-with-tax-loc = buf_parts.price-base
      996   .
      997   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      999     (output varinvprb
     1000     )  .
     1001     if buf_parts.out-code = 'free-zone':U     or
     1002        buf_parts.out-code = 'out-zone':U   or
     1003        buf_parts.doc-type = 'акт':U then do:
     1004       assign
     1005         in-vatp-have-vat-slt = yes.
     1006     end.
     1007     else do:
     1008       find first in-vatp_doc-attr no-lock
     1009         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1010           and in-vatp_doc-attr.attr-code = 'envd':U
     1011         no-error .
     1012       if not available in-vatp_doc-attr then do:
     1013         assign
     1014           in-vatp-have-vat-slt = yes.
     1015       end.
     1016       else do:
     1017            in-vatp-have-vat-slt = no.
     1018       end.
     1019     end.
     1020     assign
     1021      price-cli-with-tax-loc = buf_parts.price-cli
     1022      cli-base-rate          = buf_parts.cli-base-rate.
     1023     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1024              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1025     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1026             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1027             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1028             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1029             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1030             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1031             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1032       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1033     assign
     1034       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1035     assign
     1036       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1037       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1038       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1039       transport-cli-loc  = 0
     1040       other-cli-loc      = 0
     1041     .
