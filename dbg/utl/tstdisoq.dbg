     2109           do-chk-num       = buf_dis-obj.num-chk
     2110           do-gds-sum-rubl  = buf_dis-obj.gds-tot-rubl - buf_dis-obj.sum-tot-rubl
     2111           do-disc-sum-rubl = buf_dis-obj.gds-dis-rubl - buf_dis-obj.sum-dis-rubl
     2112           do-pay-sum-rubl  = buf_dis-obj.pay-tot-rubl
     2113           do-gds-sum-base  = buf_dis-obj.gds-tot-base - buf_dis-obj.sum-tot-base
     2114           do-disc-sum-base = buf_dis-obj.gds-dis-base - buf_dis-obj.sum-dis-base
