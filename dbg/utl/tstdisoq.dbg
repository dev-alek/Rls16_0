     2122         OR do-pay-sum-rubl <> temp-d-card.pay-tot-rubl
     2123         OR do-gds-sum-base <> temp-d-card.gds-tot-base
     2124         OR do-disc-sum-base <> temp-d-card.gds-dis-base
     2125         OR do-pay-sum-base <> temp-d-card.pay-tot-base)
     2126         then
     2127         PUT STREAM TEST UNFORMATTED
     2128         temp-d-card.d-card format "X(16)" space(1)
     2129         do-obj-code format ">>>>9" space(1)
     2130         do-chk-num format ">>>>>>>>>9" space(1)
     2131         do-gds-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2132         do-disc-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2133         do-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     2134         do-gds-sum-base format "->>>,>>>,>>9.99" space(1)
     2135         do-disc-sum-base format "->>>,>>>,>>9.99" space(1)
     2136         do-pay-sum-base format "->>>,>>>,>>9.99" skip(0)
     2137         "По чекам  и накладным"  format "X(22)" space(1)
     2138         temp-d-card.num-chk  format ">>>>>>>>>9" space(1)
     2139         temp-d-card.gds-tot-rubl format "->>>,>>>,>>9.99" space(1)
     2140         temp-d-card.gds-dis-rubl format "->>>,>>>,>>9.99" space(1)
     2141         temp-d-card.pay-tot-rubl format "->>>,>>>,>>9.99" space(1)
     2142         temp-d-card.gds-tot-base format "->>>,>>>,>>9.99" space(1)
     2143         temp-d-card.gds-dis-base format "->>>,>>>,>>9.99" space(1)
     2144         temp-d-card.pay-tot-base format "->>>,>>>,>>9.99" space(1)
     2145         skip(0)
     2146         .
     2147       end.
     2148     end.
     2149     when 6 then do:
     2150       run gbl/get-per.w (
     2151                       output v-ok
     2152                      ,input-output x_start-date
     2153                      ,input-output x_end-date
     2154                                         ) no-error .
