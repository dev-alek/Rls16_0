     4218           p-pay-sum-base = p-pay-sum-base + ub.payment.tot-base
     4219           .
     4220         end.
     4221         if p-view-mode = 1
     4222         or ((do-pay-sum-rubl - p-pay-sum-rubl) <> 0
     4223         or (do-pay-sum-base - p-pay-sum-base) <> 0) then
     4224         PUT STREAM TEST UNFORMATTED
     4225         ub.dis-obj.d-card format "X(16)" space(1)
     4226         do-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4227         do-pay-sum-base format "->>>,>>>,>>9.99" space(1)
     4228         p-pay-sum-rubl  format "->>>,>>>,>>9.99" space(1)
     4229         p-pay-sum-base  format "->>>,>>>,>>9.99" space(1)
     4230         (do-pay-sum-rubl - p-pay-sum-rubl) format "->>>,>>>,>>9.99" space(1)
     4231         (do-pay-sum-base - p-pay-sum-base) format "->>>,>>>,>>9.99" space(1)
     4232         SKIP.
     4233       END.
     4234     end.
     4235   END.
     4236   WHEN 5 then do:
     4237     FOR EACH ub.dis-card No-LOCK
     4238        WHERE ub.dis-card.d-card =  f-d-card
     4239     BREAK
     4240     by ub.dis-card.d-card:
     4241       ii = ii + 1.
     4242       if ii MOD 100 = 0 then
     4243       run waitfram-show in this-procedure ("Обработано " + string(ii) + " дисконтных карт").
     4244       IF FIRST-of(dis-card.d-card) then do:
     4245         assign
     4246         dh-gds-sum-rubl = 0
     4247         dh-disc-sum-rubl = 0
     4248         dh-pay-sum-rubl = 0
     4249         dh-gds-sum-base = 0
     4250         dh-disc-sum-base = 0
     4251         dh-pay-sum-base = 0
     4252         .
     4253         FOR EACH ub.dis-host No-LOCK
     4254            WHERE ub.dis-host.d-card = ub.dis-card.d-card
     4255                and ub.dis-host.host-code > 0
     4256                and ub.dis-host.dt-code = 0
     4257         break
     4258         by ub.dis-host.host-code:
     4259           assign
     4260           dh-gds-sum-rubl = dh-gds-sum-rubl + dis-host.gds-tot-rubl
     4261           dh-disc-sum-rubl = dh-disc-sum-rubl + dis-host.gds-dis-rubl
     4262           dh-pay-sum-rubl = dh-pay-sum-rubl + dis-host.pay-tot-rubl
     4263           dh-gds-sum-base = dh-gds-sum-base + dis-host.gds-tot-base
     4264           dh-disc-sum-base = dh-disc-sum-base + dis-host.gds-dis-base
     4265           dh-pay-sum-base = dh-pay-sum-base + dis-host.pay-tot-base
     4266           .
     4267           if dis-card.emitent-host-code = 0 and
     4268           (abs((dis-host.gds-tot-rubl - dis-host.gds-dis-rubl) - dis-host.pay-tot-rubl ) > 0.001 OR
     4269             abs((dis-host.gds-tot-base - dis-host.gds-dis-base) - dis-host.pay-tot-base) > 0.001
     4270           ) then do:
     4271             PUT stream test unformatted
     4272             dis-card.d-card format "X(16)" space(1)
     4273             dis-host.host-code format "999999999" space(3)
     4274             dis-host.gds-tot-rubl format "->>>,>>>,>>9.99" space(1)
     4275             dis-host.gds-tot-base format "->>>,>>>,>>9.99" space(1)
     4276             dis-host.gds-dis-rubl format "->>>,>>>,>>9.99" space(1)
     4277             dis-host.gds-dis-base format "->>>,>>>,>>9.99" space(1)
     4278             dis-host.pay-tot-rubl format "->>>,>>>,>>9.99" space(1)
     4279             dis-host.pay-tot-base format "->>>,>>>,>>9.99" space(3)
     4280             ((dis-host.gds-tot-rubl - dis-host.gds-dis-rubl) - dis-host.pay-tot-rubl) format "->>>,>>>,>>9.99" space(1)
     4281             ((dis-host.gds-tot-base - dis-host.gds-dis-base) - dis-host.pay-tot-base) format "->>>,>>>,>>9.99" space(1)
     4282             "ОШИБКА глобкарта" format "X(15)" space(1)
     4283             "!ненулевое сальдо" format "X(15)" space(3)
     4284             SKIP.
     4285           end.
     4286         END.
     4287         if p-view-mode = 1
     4288         or (((dh-gds-sum-rubl - dh-disc-sum-rubl) - dh-pay-sum-rubl -  dis-card.saldo-rubl) <> 0
     4289         OR ((dh-gds-sum-BASE - dh-disc-sum-base) - dh-pay-sum-base -  dis-card.saldo-base) <> 0)
     4290         then
     4291         PUT stream test unformatted
     4292         dis-card.d-card format "X(16)" space(1)
     4293         dis-card.emitent-host-code format "999999999" space(3)
     4294         dh-gds-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4295         dh-gds-sum-base format "->>>,>>>,>>9.99" space(1)
     4296         dh-disc-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4297         dh-disc-sum-base format "->>>,>>>,>>9.99" space(1)
     4298         dh-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4299         dh-pay-sum-base format "->>>,>>>,>>9.99" space(3)
     4300         (dh-gds-sum-rubl - dh-disc-sum-rubl) - dh-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     4301         (dh-gds-sum-BASE - dh-disc-sum-base) - dh-pay-sum-base format "->>>,>>>,>>9.99" space(1)
     4302         dis-card.saldo-rubl format "->>>,>>>,>>9.99" space(1)
     4303         dis-card.saldo-base format "->>>,>>>,>>9.99" space(3)
     4304         ((dh-gds-sum-rubl - dh-disc-sum-rubl) - dh-pay-sum-rubl -  dis-card.saldo-rubl) format "->>>,>>>,>>9.99" space(1)
     4305         ((dh-gds-sum-BASE - dh-disc-sum-base) - dh-pay-sum-base -  dis-card.saldo-base) format "->>>,>>>,>>9.99" space(1)
     4306         SKIP.
     4307       END.
     4308     END.
     4309   END.
     4310   when 7 then do:
     4311     FOR EACH buf_dis-card No-LOCK where
     4312       buf_Dis-card.emitent-host-code = dctype
     4313        AND buf_dis-card.d-card =  f-d-card
     4314   ,
     4315      first buf_dis-card-type no-lock where
     4316           buf_dis-card-type.type = buf_dis-card.type
     4317       AND buf_dis-card-type.emitent-host-code = buf_dis-card.emitent-host-code
     4318     :
     4319         if NOT new-d-pcnt = old-d-pcnt
     4320         or p-view-mode = 1 then do:
     4321           PUT stream test unformatted
     4322           buf_dis-card.d-card format "X(16)" space(1)
     4323           buf_dis-card.type   format "X(8)" space(1)
     4324           for-sum format "->>>,>>>,>>9.99" space(1)
     4325           buf_dis-card.d-pcnt format "->,>>9.99" space(1)
     4326           new-d-pcnt          format "->,>>9.99" space(1)
     4327           skip.
     4328         end.
     4329       END.
     4330     end.
     4331    when 8 then do:
     4332     run ref/proprefs.w (
     4333                      input parparentproc
     4334                     ,input 'b-sel'
     4335                     ,input "dis-tot"
     4336                     ,input 5
     4337                     ,input '':U
     4338                     ,input '':U
     4339                     ,input-output  v-ref-list) no-error.
     4340     if error-status:error or v-ref-list = '':u then do:
     4341       return.
     4342     end.
     4343     find first buf_prop-ref no-lock where
     4344              recid(buf_prop-ref) = integer(v-ref-list).
     4345     assign
     4346     v-dt-code = buf_prop-ref.dt-code
     4347     v-sum-id =  buf_prop-ref.sum-id
     4348     .
     4349     assign
     4350     v-date-from =  date(entry(1, buf_prop-ref.sum-id, "-"))
     4351     v-date-to =  date(entry(2, buf_prop-ref.sum-id, "-"))
     4352     .
     4353     PUT stream test unformatted
     4354     substitute("Идентификатор частного итога &1 Доп.идентификатор &2"
     4355                 ,v-sum-id
     4356                 ,buf_prop-ref.caller_id
     4357                 ) skip.
     4358     FOR EACH buf_dis-card No-LOCK where
     4359        buf_dis-card.d-card =  f-d-card
     4360        :
     4361        for each buf_clients no-lock where
     4362               buf_clients.obj-type = 'маг':U
     4363          and  (v-cntxt-db-num = 0 or buf_clients.db-num = v-cntxt-db-num):
     4364         assign
     4365         v-chk-num = 0
     4366         v-netto-sum = 0.
     4367           _buf_chk-doc:
     4368           for each buf_chk-doc no-lock where
     4369             buf_chk-doc.d-card = buf_dis-card.d-card
     4370             and buf_chk-doc.obj-type = buf_clients.obj-type
     4371             and buf_chk-doc.obj-code = buf_clients.obj-code
     4372             and buf_chk-doc.chk-date >= v-date-from
     4373             and buf_chk-doc.chk-date <= v-date-to
     4374             :
     4375             assign
     4376             v-chk-num = v-chk-num  + 1
     4377             v-netto-sum  = v-netto-sum + buf_chk-doc.netto
     4378             .
     4379           end.
     4380         find first buf_dis-obj no-lock where
     4381                   buf_dis-obj.obj-type = buf_clients.obj-type
     4382               and buf_dis-obj.obj-code = buf_clients.obj-code
     4383               and buf_dis-obj.d-card = buf_dis-card.d-card
     4384               and buf_dis-obj.dt-code = v-dt-code no-error .
     4385         if not available buf_dis-obj then do:
     4386           assign
     4387           v-chk-num-do = 0
     4388           v-netto-sum-do = 0
     4389           .
     4390         end.
     4391         else do:
     4392           assign
     4393           v-chk-num-do = buf_dis-obj.num-chk
     4394           v-netto-sum-do = (if v-curr-r-b = 'rubl':U
     4395                          then (buf_dis-obj.gds-tot-rubl - buf_dis-obj.gds-dis-rubl)
     4396                          else (buf_dis-obj.gds-tot-base - buf_dis-obj.gds-dis-base)
     4397                          )
     4398           .
     4399         end.
     4400         if v-chk-num <> v-chk-num-do
     4401         or p-view-mode = 1
     4402         then do:
     4403             PUT stream test unformatted
     4404             string(p-obj-type + string(buf_clients.obj-code), "X(20)") space(1)
     4405             buf_dis-card.d-card format "X(16)" space(1)
     4406             v-chk-num   format ">>>>>>>>>" space(10)
     4407             v-chk-num-do   format ">>>>>>>>>" space(10)
     4408             v-netto-sum    format ">>>,>>>,>>>,>>9.999" space(1)
     4409             v-netto-sum-do format ">>>,>>>,>>>,>>9.999" space(1)
     4410             skip.
     4411         end.
     4412       end.
     4413     end.
     4414   end.
     4415     when 99 then do:
     4416       FOR EACH buf_dis-card No-LOCK where
     4417       buf_Dis-card.emitent-host-code = dctype
     4418        :
     4419         v-chk-num = 0.
     4420        for each buf_clients no-lock where
     4421               buf_clients.obj-type = 'маг':U
     4422          and  (v-cntxt-db-num = 0 or buf_clients.db-num = v-cntxt-db-num):
     4423         for each buf_chk-doc no-lock where
     4424           buf_chk-doc.d-card = buf_dis-card.d-card
     4425           and buf_chk-doc.obj-type = buf_clients.obj-type
     4426           and buf_chk-doc.obj-code = buf_clients.obj-code:
     4427           assign
     4428           v-chk-num = v-chk-num  + 1
     4429           .
     4430         end.
     4431           find first buf_dis-obj no-lock where
     4432                     buf_dis-obj.obj-type = buf_clients.obj-type
     4433                 and buf_dis-obj.obj-code = buf_clients.obj-code
     4434                 and buf_dis-obj.d-card = buf_dis-card.d-card
     4435                 and buf_dis-obj.dt-code = 0  no-error .
     4436           if not available buf_dis-obj then do:
     4437             assign
     4438             v-chk-num-do = 0.
     4439           end.
     4440           else do:
     4441             assign
     4442             v-chk-num-do = buf_dis-obj.num-chk.
     4443           end.
     4444           if v-chk-num <> v-chk-num-do
     4445           or p-view-mode = 1
     4446           then do:
     4447             PUT stream test unformatted
     4448             string(buf_clients.obj-type + string(buf_clients.obj-code), "X(20)") space(1)
     4449             buf_dis-card.d-card format "X(16)" space(1)
     4450             v-chk-num   format ">>>>>>>>>" space(10)
     4451             v-chk-num-do   format ">>>>>>>>>" space(10)
     4452             skip.
     4453           end.
     4454         end.
     4455       end.
     4456     end.
     4457   END CASE.
     4458   end.
     4459   end.
