     1233             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1234         end.
     1235         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1236         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1237         assign
     1238           road-tax-cli-loc = ?.
     1239         ASSIGN
     1240           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1241           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1242           transport-cli-loc  = 0
     1243           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1244           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1245           other-cli-loc      = 0
     1246           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     1247           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     1248                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1249               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1250         assign
     1251           vat-cli-loc            = ?
     1252           slt-cli-loc            = ?
     1253           price-cli-with-tax-loc = ?.
     1254      end.
     1255      else do:
     1256                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     1257                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     1258                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     1259                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     1260                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     1261                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     1262                            use-index out-code no-lock:
     1263             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1264                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1265                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1266                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     1267                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     1268                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1269                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1270                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1271                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1272                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1273                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1274                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1275                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1276                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1277                         .
     1278         end.
     1279         ASSIGN
     1280           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1281           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1282           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1283           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1284           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1285           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1286                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1287           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1288                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1289           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1290           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1291           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1292         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1293         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1294         if transport-base-loc = ? then transport-base-loc = 0.
     1295         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1296         if other-base-loc     = ? then other-base-loc     = 0.
     1297         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1298         assign
     1299           transport-cli-loc      = 0
     1300           other-cli-loc          = 0
     1301           road-tax-cli-loc       = ?
     1302           vat-cli-loc            = ?
     1303           slt-cli-loc            = ?
     1304           price-cli-with-tax-loc = ?.
     1305      end.
     1306   ASSIGN
     1307             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1308       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1309   .
     1310             assign
     1311               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1312               v-vat-pc              = vat-pc-loc
     1313               v-slt-pc              = slt-pc-loc
     1314               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1315               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1316               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1317               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1318               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1319               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1320               v-road-tax-base       =  0
     1321               v-road-tax-rubl       =  0
     1322               v-excise-base         =  0
     1323               v-excise-rubl         =  0
     1324               v-transport-base      =  0
     1325               v-transport-rubl      =  0
     1326               v-other-base          =  0
     1327               v-other-rubl          =  0
     1328             .
     1329       end.
     1330     end.
     1331   end procedure.
     1332   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1333   FUNCTION calc-dcpc-1 RETURNS DECIMAL(input  for-sum as decimal,
     1334                                      input  n-d-pcnt as decimal,
     1335                                      input  sumdiscs as char,
     1336                                      output new-d-pcnt     as decimal):
     1337   define variable ii as integer no-undo.
     1338   ii = 1.
     1339   new-d-pcnt = n-d-pcnt.
     1340   REPEAT while (ii <= num-entries(sumdiscs, ";")):
     1341       IF for-sum >= DECIMAL(ENTRY(1,ENTRY(ii, sumdiscs, ";"), "=")) AND
     1342           (ii = NUM-ENTRIES(sumdiscs,";") OR
     1343           for-sum < DECIMAL(ENTRY(1,ENTRY(ii + 1, sumdiscs, ";"), "="))
     1344             ) THEN do:
     1345         assign
     1346         new-d-pcnt = decimal(ENTRY(2,ENTRY(ii, sumdiscs, ";"), "=")) NO-ERROR.
     1347           LEAVE.
     1348       END.
     1349       ii = ii + 1.
     1350   END.
     1351   RETURN new-d-pcnt.
     1352   END FUNCTION.
     1353   FUNCTION calc-dckat-1 RETURNS INTEGER(input  for-sum as decimal,
     1354                                      input  n-kat as integer,
     1355                                      input  sumdiscs as char,
     1356                                      output new-kat  as integer):
     1357   define variable ii as integer no-undo.
     1358   ii = 1.
     1359   new-kat = n-kat.
     1360   REPEAT while (ii <= num-entries(sumdiscs, ";")):
     1361       IF for-sum >= DECIMAL(ENTRY(1,ENTRY(ii, sumdiscs, ";"), "=")) AND
     1362           (ii = NUM-ENTRIES(sumdiscs,";") OR
     1363           for-sum < DECIMAL(ENTRY(1,ENTRY(ii + 1, sumdiscs, ";"), "="))
     1364             ) THEN do:
     1365         assign
     1366         new-kat = integer(ENTRY(2,ENTRY(ii, sumdiscs, ";"), "=")) NO-ERROR.
     1367           LEAVE.
     1368       END.
     1369       ii = ii + 1.
     1370   END.
     1371   RETURN new-kat.
     1372   END FUNCTION.
     1373   FUNCTION calc-dcpc-2 RETURNS DECIMAL(input  for-sum as decimal,
     1374                                       input  n-d-pcnt as decimal,
     1375                                      input  sumdiscs as char,
     1376                                      output new-d-pcnt     as decimal):
     1377   define variable ii as integer no-undo.
     1378   define variable v-new-ii as integer no-undo init -1.
     1379   define variable v-old-ii as integer no-undo init -1.
     1380   define variable no-support as logical no-undo .
     1381   new-d-pcnt = 0.
     1382   if n-d-pcnt = ? then do:
     1383     no-support = yes.
     1384     n-d-pcnt = 0.
     1385   end.
     1386   ii = 1.
     1387   REPEAT while (ii <= num-entries(sumdiscs, ";")):
     1388       if ii = 1 and
     1389       for-sum < DECIMAL(ENTRY(1, ENTRY(ii, sumdiscs, ";"), "=")) then do:
     1390          assign
     1391          v-new-ii = 0.
     1392       end.
     1393       if ii = 1
     1394       and  n-d-pcnt < DECIMAL(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) then do:
     1395          assign
     1396          v-old-ii = 0.
     1397       end.
     1398       IF for-sum >= DECIMAL(ENTRY(1, ENTRY(ii, sumdiscs, ";"), "=")) AND
     1399           (ii = NUM-ENTRIES(sumdiscs, ";") OR
     1400           for-sum < DECIMAL(ENTRY(1, ENTRY(ii + 1, sumdiscs, ";"), "="))
     1401             ) THEN do:
     1402         assign
     1403         new-d-pcnt = decimal(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) NO-ERROR.
     1404         v-new-ii = ii.
     1405       END.
     1406       IF n-d-pcnt >= DECIMAL(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) AND
     1407           (ii = NUM-ENTRIES(sumdiscs, ";") OR
     1408           n-d-pcnt < DECIMAL(ENTRY(2, ENTRY(ii + 1, sumdiscs, ";"), "="))
     1409             ) THEN do:
     1410         assign
     1411         v-old-ii = ii.
     1412       end.
     1413       if (v-new-ii <> - 1
     1414       AND V-OLD-II <>  -1)
     1415       and ((v-old-ii - v-new-ii) >= 1
     1416             or
     1417             new-d-pcnt > n-d-pcnt
     1418             or no-support
     1419             )
     1420       then leave.
     1421       ii = ii + 1.
     1422   END.
     1423   if new-d-pcnt < n-d-pcnt then
     1424   new-d-pcnt = decimal(ENTRY(2, ENTRY(v-old-ii - 1, sumdiscs, ";"), "=")) no-error .
     1425   RETURN new-d-pcnt.
     1426   END FUNCTION.
     1427   FUNCTION calc-dckat-2 RETURNS INTEGER(input  for-sum as decimal,
     1428                                      input  n-kat as integer,
     1429                                      input  sumdiscs as char,
     1430                                      output new-kat  as integer):
     1431   define variable ii as integer no-undo.
     1432   define variable v-new-ii as integer no-undo init -1.
     1433   define variable v-old-ii as integer no-undo init -1.
     1434   define variable no-support as logical no-undo .
     1435   if n-kat = ? then do:
     1436     no-support = yes.
     1437     n-kat = 0.
     1438   end.
     1439   ii = 1.
     1440   new-kat = 0.
     1441   REPEAT while (ii <= num-entries(sumdiscs, ";")):
     1442       if ii = 1
     1443       and for-sum < DECIMAL(ENTRY(1, ENTRY(ii, sumdiscs, ";"), "=")) then do:
     1444          assign
     1445          v-new-ii = 0.
     1446       end.
     1447       if ii = 1
     1448       and n-kat < integer(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) then do:
     1449          assign
     1450          v-old-ii = 0.
     1451       end.
     1452       IF for-sum >= DECIMAL(ENTRY(1,ENTRY(ii, sumdiscs, ";"), "=")) AND
     1453           (ii = NUM-ENTRIES(sumdiscs,";") OR
     1454           for-sum < DECIMAL(ENTRY(1,ENTRY(ii + 1, sumdiscs, ";"), "="))
     1455             ) THEN do:
     1456         assign
     1457         new-kat = integer(ENTRY(2,ENTRY(ii, sumdiscs, ";"), "=")) NO-ERROR.
     1458         v-new-ii = ii.
     1459       END.
     1460       IF n-kat >= integer(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) AND
     1461           (ii = NUM-ENTRIES(sumdiscs, ";") OR
     1462           n-kat < integer(ENTRY(2, ENTRY(ii + 1, sumdiscs, ";"), "="))
     1463             ) THEN do:
     1464         assign
     1465         v-old-ii = ii.
     1466       END.
     1467       if (v-new-ii <> - 1
     1468       AND V-OLD-II <>  -1)
     1469       and (abs(v-old-ii - v-new-ii) >= 1
     1470            or
     1471            no-support)
     1472       then leave.
     1473       ii = ii + 1.
     1474   END.
     1475   if v-new-ii < v-old-ii then
     1476   new-kat = integer(ENTRY(2, ENTRY(v-old-ii - 1, sumdiscs, ";"), "=")) no-error .
     1477   RETURN new-kat.
     1478   END FUNCTION.
