      905       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      906       define variable cli-base-rate              as   decimal                no-undo.
      907       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      908       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      909       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      910       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      911       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      912       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      913       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      914       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      915       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      916       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      917       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      918       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      919       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      920       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      921       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      922       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      923       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      924       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      925       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      926       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
