     3470   temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-base
     3471   .
     3472   else
     3473   assign
     3474   temp-d-card.gds-tot-r-b = temp-d-card.gds-tot-rubl
     3475   temp-d-card.gds-dis-r-b = temp-d-card.gds-dis-rubl
     3476   temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-rubl
     3477   .
     3478     find first vchk-pay no-lock where
     3479               vchk-pay.d-card   = temp-d-card.d-card
     3480           AND vchk-pay.pay-code = bf_trn-doc.pay-code
     3481           AND vchk-pay.curr-code = bf_trn-doc.exch-code
     3482           AND vchk-pay.doc-date  = 01/01/1990
     3483           AND vchk-pay.cre-pay   = (cre-pay = bf_trn-doc.pay-code) no-error .
     3484     if not available vchk-pay then do:
     3485       create vchk-pay.
     3486       assign
     3487       vchk-pay.d-card   = temp-d-card.d-card
     3488       vchk-pay.doc-date = bf_trn-doc.exch-date
     3489       vchk-pay.pay-code = bf_trn-doc.pay-code
     3490       vchk-pay.curr-code = bf_trn-doc.exch-code
     3491       vchk-pay.cre-pay   =  no
     3492       vchk-pay.exch-rate = bf_trn-doc.exch-rate
     3493       vchk-pay.base-rate = bf_trn-doc.base-rate
     3494       vchk-pay.tot-base =  temp-d-card.pay-tot-base
     3495       vchk-pay.tot-rubl =  temp-d-card.pay-tot-rubl
     3496       vchk-pay.tot-sum =  (if bf_trn-doc.exch-code = 0 then temp-d-card.pay-tot-rubl else temp-d-card.pay-tot-base)
     3497       .
     3498     end.
     3499         end.
     3500         end.
     3501       end.
     3502       for each temp-d-card
     3503       where temp-d-card.d-card = f-d-card
     3504       break
     3505       by temp-d-card.d-card
     3506       by temp-d-card.obj-type
     3507       by temp-d-card.obj-code:
     3508         run waitfram-show in this-procedure ( substitute( "Окончательная обработка результатов и вывод в файл - карта &1", temp-d-card.d-card )).
     3509           assign
     3510           do-obj-code = temp-d-card.obj-code
     3511           do-chk-num = 0
     3512           do-gds-sum-rubl = 0
     3513           do-disc-sum-rubl = 0
     3514           do-pay-sum-rubl = 0
     3515           do-gds-sum-base = 0
     3516           do-disc-sum-base = 0
     3517           do-pay-sum-base = 0
     3518           .
     3519         For each buf_dis-obj No-LOCK WHERE
     3520                     buf_dis-obj.d-card = temp-d-card.d-card
     3521                 AND buf_dis-obj.dt-code = 0
     3522                 and buf_dis-obj.obj-type = temp-d-card.obj-type
     3523                 and buf_dis-obj.obj-code = temp-d-card.obj-code:
     3524           assign
     3525           do-obj-code      = buf_dis-obj.obj-code
     3526           do-chk-num       = buf_dis-obj.num-chk
     3527           do-gds-sum-rubl  = buf_dis-obj.gds-tot-rubl - buf_dis-obj.sum-tot-rubl
     3528           do-disc-sum-rubl = buf_dis-obj.gds-dis-rubl - buf_dis-obj.sum-dis-rubl
     3529           do-pay-sum-rubl  = buf_dis-obj.pay-tot-rubl
     3530           do-gds-sum-base  = buf_dis-obj.gds-tot-base - buf_dis-obj.sum-tot-base
     3531           do-disc-sum-base = buf_dis-obj.gds-dis-base - buf_dis-obj.sum-dis-base
     3532           do-pay-sum-base  = buf_dis-obj.pay-tot-base
     3533           .
     3534         end.
     3535         if p-view-mode = 1
     3536         or (do-chk-num <> temp-d-card.num-chk
     3537         OR do-gds-sum-rubl <> temp-d-card.gds-tot-rubl
     3538         OR do-disc-sum-rubl <> temp-d-card.gds-dis-rubl
     3539         OR do-pay-sum-rubl <> temp-d-card.pay-tot-rubl
     3540         OR do-gds-sum-base <> temp-d-card.gds-tot-base
     3541         OR do-disc-sum-base <> temp-d-card.gds-dis-base
     3542         OR do-pay-sum-base <> temp-d-card.pay-tot-base)
     3543         then
     3544         PUT STREAM TEST UNFORMATTED
     3545         temp-d-card.d-card format "X(16)" space(1)
     3546         do-obj-code format ">>>>9" space(1)
     3547         do-chk-num format ">>>>>>>>>9" space(1)
     3548         do-gds-sum-rubl format "->>>,>>>,>>9.99" space(1)
     3549         do-disc-sum-rubl format "->>>,>>>,>>9.99" space(1)
     3550         do-pay-sum-rubl format "->>>,>>>,>>9.99" space(1)
     3551         do-gds-sum-base format "->>>,>>>,>>9.99" space(1)
     3552         do-disc-sum-base format "->>>,>>>,>>9.99" space(1)
     3553         do-pay-sum-base format "->>>,>>>,>>9.99" skip(0)
     3554         "По чекам  и накладным"  format "X(22)" space(1)
     3555         temp-d-card.num-chk  format ">>>>>>>>>9" space(1)
     3556         temp-d-card.gds-tot-rubl format "->>>,>>>,>>9.99" space(1)
     3557         temp-d-card.gds-dis-rubl format "->>>,>>>,>>9.99" space(1)
     3558         temp-d-card.pay-tot-rubl format "->>>,>>>,>>9.99" space(1)
     3559         temp-d-card.gds-tot-base format "->>>,>>>,>>9.99" space(1)
     3560         temp-d-card.gds-dis-base format "->>>,>>>,>>9.99" space(1)
     3561         temp-d-card.pay-tot-base format "->>>,>>>,>>9.99" space(1)
     3562         skip(0)
     3563         .
     3564       end.
     3565     end.
     3566     when 6 then do:
     3567       run gbl/get-per.w (
     3568                       output v-ok
     3569                      ,input-output x_start-date
     3570                      ,input-output x_end-date
     3571                                         ) no-error .
     3572       if not v-ok then return.
     3573       for each buf_sysconf,
     3574          each buf_inkas no-lock where
     3575               buf_Inkas.host-code = buf_sysconf.host-code
     3576           AND buf_Inkas.doc-date >= x_start-date
     3577           AND buf_Inkas.doc-date <= x_end-date
     3578           AND buf_Inkas.status_ = 'факт':U
     3579       break
     3580       by buf_inkas.obj-type
     3581       by buf_inkas.obj-code
     3582       :
     3583         IF FIRST-OF(buf_inkas.obj-code) then do:
     3584           find first buf_shop no-lock where
     3585                     buf_shop.obj-code = buf_inkas.obj-code No-ERROR.
     3586           if not avail buf_shop then do:
     3587             run waitfram-hide in this-procedure .
     3588             message "Не найдена запись о магазине номер " buf_inkas.obj-code view-as alert-box
     3589             ERROR.
     3590             return.
     3591           end.
     3592           find first buf_Cash-pay no-lock where
     3593                   buf_cash-pay.cdpay-code = buf_sysconf.credit-pay no-error.
     3594   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3595     (input  'iscredit'
     3596     ,input  0
     3597     ,input  ''
     3598     ,input  0
     3599     ,input  ''
     3600     ,input  ''
     3601     ,input  ''
     3602     ,input  no
     3603     ,output conf-par
     3604     ,output par-type
     3605     ) no-error .
     3606           if error-status:error
     3607           or not available buf_cash-pay
     3608           or buf_cash-pay.is-credit = no
     3609           or conf-par <> "yes"
     3610           then do:
     3611             assign
     3612             cre-pay = 0
     3613             .
     3614           end.
     3615           else do:
     3616             assign
     3617             cre-pay = buf_sysconf.credit-pay
     3618             .
     3619           end.
     3620           assign
     3621           v-base-code = buf_sysconf.base-code
     3622           .
     3623         end.
     3624         find first temp-inkas no-lock where
     3625                   temp-inkas.inkas-code = buf_Inkas.inkas-code no-error .
     3626         find first buf_trn-doc no-lock where
     3627                   buf_trn-doc.doc-code = buf_inkas.inkas-code no-error .
     3628         if not available buf_trn-doc
     3629         or buf_trn-doc.status_ = 'запрос':U
     3630         then do:
     3631           nExt .
     3632         end.
     3633         find first buf_ret-doc no-lock where
     3634                   buf_ret-doc.doc-code = buf_trn-doc.out-code no-error .
     3635         if not available buf_ret-doc then do:
     3636           nExt .
     3637         end.
     3638         ii = ii + 1.
     3639         run waitfram-show in this-procedure ("Обработано " + string(ii) + " продаж").
     3640         for each temp-d-card:
     3641           delete temp-d-card.
     3642         end.
     3643         for each vchk-pay:
     3644           delete vchk-pay.
     3645         end.
     3646         run waitfram-show in this-procedure ("Обработка отчета о продаже " + buf_inkas.inkas-code).
     3647         par-sign = 1.
     3648   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3649     _cards:
     3650     for each ub.chk-doc no-lock
     3651       where ub.chk-doc.obj-type = buf_inkas.obj-type
     3652         AND ub.chk-doc.obj-code = buf_inkas.obj-code
     3653         AND ub.chk-doc.out-code = buf_inkas.inkas-code
     3654         and ub.chk-doc.d-card > ""
     3655     on error undo _main, return error
     3656     :
     3657     if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _cards.
     3658       find first temp-d-card where
     3659                 temp-d-card.d-card = ub.chk-doc.d-card
     3660             AND temp-d-card.obj-type = ub.chk-doc.obj-type
     3661             AND temp-d-card.obj-code = ub.chk-doc.obj-code  no-error .
     3662       if not available temp-d-card then do:
     3663         find first ub.dis-card no-lock
     3664           where ub.dis-card.d-card = ub.chk-doc.d-card
     3665           no-error .
     3666         if not avail dis-card then do:
     3667           next _cards.
     3668         end.
     3669         FIND FIRST ub.clients WHERE
     3670                     ub.clients.obj-type = ub.dis-card.cli-type AND
     3671                     ub.clients.obj-code = ub.dis-card.cli-code No-ERROR.
     3672         if not avail ub.clients then do:
     3673           undo _main, return error "Не найден клиент для дисконтной карты " + ub.dis-card.d-card.
     3674         end.
     3675         assign
     3676           ub.clients.buy-gds = ub.clients.buy-gds OR ( NOT buf_inkas.office )
     3677           ub.clients.buy-serv = ub.clients.buy-serv OR buf_inkas.office
     3678         .
     3679         create temp-d-card.
     3680         assign
     3681         temp-d-card.d-card = ub.chk-doc.d-card
     3682         temp-d-card.pay-tot-base = 0
     3683         temp-d-card.pay-tot-rubl = 0
     3684         temp-d-card.gds-tot-b0 = 0
     3685         temp-d-card.gds-tot-r0 = 0
     3686         temp-d-card.first-main-card   = ub.dis-card.first-main-card
     3687         temp-d-card.main-card         = ub.dis-card.main-card
     3688         temp-d-card.first-card        = ub.dis-card.first-card
     3689         temp-d-card.cli-type          = ub.dis-card.cli-type
     3690         temp-d-card.cli-code          = ub.dis-card.cli-code
     3691         temp-d-card.card-num          = ub.dis-card.card-num
     3692         temp-d-card.emitent-host-code = ub.dis-card.emitent-host-code
     3693         temp-d-card.type              = ub.dis-card.type
     3694         temp-d-card.obj-type          = ub.chk-doc.obj-type
     3695         temp-d-card.obj-code          = ub.chk-doc.obj-code
     3696         temp-d-card.host-code         = buf_inkas.host-code
     3697         temp-d-card.sale-doc          = buf_inkas.inkas-code
     3698         temp-d-card.sale-type         = 'inkas':U
     3699         temp-d-card.doc-date          = ub.chk-doc.chk-date
     3700         temp-d-card.action            = sign
     3701         .
     3702       end.
     3703       FOR EACH ub.chk-gds WHERE
     3704                 ub.chk-gds.doc-code = ub.chk-doc.doc-code AND
     3705                 ub.chk-gds.b-code <> 0 NO-LOCK ,
     3706           FIRST ub.bar-code where
     3707                 ub.bar-code.b-code = ub.chk-gds.b-code No-LOCK,
     3708           FIRST ub.goods where
     3709                 ub.goods.gds-code = ub.bar-code.gds-code No-LOCK,
     3710           FIRST ub.doc-line WHERE
     3711                 ub.doc-line.doc-code = (if ub.chk-doc.netto >= 0 then buf_trn-doc.doc-code else ret-doc-code) AND
     3712                 ub.doc-line.prod-code = ub.goods.prod-code AND
     3713                 ub.doc-line.prod-type = ub.goods.prod-type AND
     3714                 ub.doc-line.artic = ub.goods.artic NO-LOCK
     3715                 On error undo _main, return error
     3716                 :
     3717         if ub.chk-gds.write-off-code <> ?
     3718         and ub.chk-gds.write-off-code > 0 then NEXT.
     3719         assign
     3720         temp-d-card.gds-tot-r0 = temp-d-card.gds-tot-r0 +  par-sign * ( ub.doc-line.price-rubl * ub.chk-gds.doc-qnty )
     3721         temp-d-card.gds-tot-b0 = temp-d-card.gds-tot-b0 +  par-sign * ( ub.doc-line.price-base * ub.chk-gds.doc-qnty )
     3722         .
     3723       END.
     3724       assign
     3725       accum-tot-base = 0
     3726       accum-tot-rubl = 0
     3727       accum-cre-pay-base =0
     3728       accum-cre-pay-rubl =0
     3729       .
     3730       FOR EACH ub.chk-pay WHERE
     3731                ub.chk-pay.doc-code = ub.chk-doc.doc-code NO-LOCK
     3732       On error undo _main, return error
     3733       :
     3734           if ub.chk-pay.pay-code = cre-pay
     3735             then
     3736           assign
     3737           cre-pay-base = ub.chk-pay.tot-base
     3738           cre-pay-rubl   = ub.chk-pay.tot-rubl .
     3739             else
     3740           assign
     3741           cre-pay-base = 0
     3742           cre-pay-rubl   = 0 .
     3743           Assign
     3744           accum-tot-rubl     = accum-tot-rubl +  ub.chk-pay.tot-rubl
     3745           accum-tot-base     = accum-tot-base +  ub.chk-pay.tot-base
     3746           accum-cre-pay-base = accum-cre-pay-base +  cre-pay-base
     3747           accum-cre-pay-rubl = accum-cre-pay-rubl +  cre-pay-rubl
     3748           .
     3749           if v-cntxt-db-num = 0 and ub.chk-pay.pay-code <> cre-pay then do:
     3750             FIND FIRST vchk-pay No-LOCK WHERE
     3751                         vchk-pay.d-card = ub.chk-doc.d-card AND
     3752                         vchk-pay.pay-code = ub.chk-pay.pay-code AND
     3753                         vchk-pay.curr-code = ub.chk-pay.curr-code AND
     3754                         vchk-pay.doc-date = ub.chk-pay.chk-date AND
     3755                         vchk-pay.cre-pay = (ub.chk-pay.pay-code = cre-pay) AND
     3756                         vchk-pay.exch-rate = (ub.chk-pay.tot-sum / chk-pay.tot-rubl) AND
     3757                       vchk-pay.base-rate = (ub.chk-pay.tot-rubl / chk-pay.tot-base ) No-ERROR.
     3758             IF NOT AVAIL vchk-pay then do:
     3759               create vchk-pay.
     3760               assign
     3761               vchk-pay.d-card   = ub.chk-doc.d-card
     3762               vchk-pay.doc-date = ub.chk-pay.chk-date
     3763               vchk-pay.pay-code = ub.chk-pay.pay-code
     3764               vchk-pay.curr-code = ub.chk-pay.curr-code
     3765               vchk-pay.cre-pay = (ub.chk-pay.pay-code = cre-pay)
     3766               vchk-pay.exch-rate =  (ub.chk-pay.tot-sum / ub.chk-pay.tot-rubl)
     3767               vchk-pay.base-rate = (ub.chk-pay.tot-rubl / ub.chk-pay.tot-base)
     3768               .
     3769             end.
     3770             assign
     3771             vchk-pay.tot-sum  = vchk-pay.tot-sum  + ub.chk-pay.tot-sum
     3772             vchk-pay.tot-base = vchk-pay.tot-base + ub.chk-pay.tot-base
     3773             vchk-pay.tot-rubl = vchk-pay.tot-rubl + ub.chk-pay.tot-rubl
     3774             .
     3775         END.
     3776       END .
     3777       assign
     3778       temp-d-card.pay-tot-base = temp-d-card.pay-tot-base + par-sign * (ACCUM-tot-base -  ACCUM-cre-pay-base)
     3779       temp-d-card.pay-tot-rubl = temp-d-card.pay-tot-rubl + par-sign * (ACCUM-tot-rubl -  ACCUM-cre-pay-rubl)
     3780       .
     3781       if v-base-code = 0 then
     3782       chk-exch =  1.
     3783       else do:
     3784         v-rate = ?.
     3785         if v-curr-r-b = 'base':U then do:
     3786           assign
     3787           v-rate = ub.chk-doc.cash-rate / ub.chk-doc.cash-scale
     3788           no-error
     3789           .
     3790           if v-rate <> 0
     3791           and v-rate <> ? then do:
     3792             chk-exch = v-rate.
     3793           end.
     3794           else do:
     3795             assign
     3796             v-rate = ACCUM-tot-rubl  / ACCUM-tot-base
     3797             no-error
     3798             .
     3799             if v-rate <> ?
     3800             and v-rate <> 0 then do:
     3801               chk-exch = v-rate.
     3802             end.
     3803             else do:
     3804                 undo _main, return error substitute("&1&2 Невозможно определить курс базовой валюты для чека &3 по ДК &4"
     3805                                                     , vss-description
     3806                                                     , chr(10)
     3807                                                     , chk-doc.doc-code
     3808                                                     , chk-doc.d-card).
     3809             end.
     3810           end.
     3811         end.
     3812         else do:
     3813           assign
     3814           v-rate = ACCUM-tot-rubl  / ACCUM-tot-base
     3815           no-error
     3816           .
     3817           if v-rate <> ?
     3818           and v-rate <> 0 then do:
     3819             chk-exch = v-rate.
     3820           end.
     3821           else do:
     3822             FIND LAST buf_curr-shop NO-LOCK WHERE
     3823                       buf_curr-shop.obj-type = ub.chk-doc.obj-type AND
     3824                       buf_curr-shop.obj-code = ub.chk-doc.obj-code AND
     3825                       buf_curr-shop.curr-code = v-base-code AND
     3826                       ( ( buf_curr-shop.exch-date = ub.chk-doc.chk-date AND
     3827                           buf_curr-shop.exch-time <= ub.chk-doc.chk-time ) OR
     3828                           buf_curr-shop.exch-date < ub.chk-doc.chk-date ) NO-ERROR .
     3829             if available buf_curr-shop then do:
     3830               assign
     3831               v-rate = buf_Curr-shop.exch-rate / buf_curr-shop.exch-scale
     3832               no-error .
     3833               if v-rate <> ?
     3834               and v-rate <> 0 then do:
     3835                 chk-exch = v-rate.
     3836               end.
     3837               else do:
     3838                   undo _main, return error substitute("&1&2 Невозможно определить курс базовой валюты для чека &3 по ДК &4"
     3839                                                       , vss-description
     3840                                                       , chr(10)
     3841                                                       , chk-doc.doc-code
     3842                                                       , chk-doc.d-card).
     3843               end.
     3844             end.
     3845           end.
     3846         end.
     3847       end.
     3848       assign
     3849       chk-exch-rubl = (if v-curr-r-b = 'rubl':U then 1 else chk-exch)
     3850       chk-exch-base = (if v-curr-r-b = 'base':U then 1 else chk-exch )
     3851       .
     3852       Assign
     3853       temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-r-b + 0
     3854       temp-d-card.sum-tot-rubl = temp-d-card.sum-tot-rubl + 0
     3855       temp-d-card.sum-tot-base = temp-d-card.sum-tot-base + 0
     3856       temp-d-card.gds-tot-r-b  = temp-d-card.gds-tot-r-b  + par-sign * ub.chk-doc.tot-doc
     3857       temp-d-card.gds-tot-rubl = temp-d-card.gds-tot-rubl + par-sign * ub.chk-doc.tot-doc * chk-exch-rubl
     3858       temp-d-card.gds-tot-base = temp-d-card.gds-tot-base + par-sign * ub.chk-doc.tot-doc / chk-exch-base
     3859       temp-d-card.gds-dis-r-b  = temp-d-card.gds-dis-r-b  + par-sign * ub.chk-doc.discnt
     3860       temp-d-card.gds-dis-rubl = temp-d-card.gds-dis-rubl + par-sign * ub.chk-doc.discnt * chk-exch-rubl
     3861       temp-d-card.gds-dis-base = temp-d-card.gds-dis-base + par-sign * ub.chk-doc.discnt / chk-exch-base
     3862       temp-d-card.num-chk      = temp-d-card.num-chk      + par-sign * 1
     3863       .
     3864       run ref/calctur4.p ( input ub.chk-doc.doc-code ) .
     3865    END.
     3866         FOR EACH buf_dis-card NO-LOCK where
     3867                 buf_dis-card.emitent-host-code = dctype AND
     3868                 buf_dis-card.d-card = f-d-card,
     3869           first temp-d-card no-lock where
     3870               temp-d-card.d-card = buf_dis-card.d-card:
     3871           assign
     3872           p-pay-sum-rubl = 0
     3873           p-pay-sum-base = 0
     3874           .
     3875           for each buf_payment no-lock where
     3876                     buf_payment.host-code = buf_Inkas.host-code
     3877                 AND  buf_payment.d-card = temp-d-card.d-card
     3878                 and  buf_payment.status_ = 'факт':U
     3879                 and  buf_payment.source-type = 'касс':U
     3880                 and  buf_payment.source-ref = buf_inkas.inkas-code :
     3881             assign
     3882             p-pay-sum-rubl = p-pay-sum-rubl + buf_payment.tot-rubl
     3883             p-pay-sum-base = p-pay-sum-base + buf_payment.tot-base
     3884             .
     3885           end.
     3886           if p-view-mode = 1
     3887           or (p-pay-sum-base <> temp-d-card.pay-tot-base
     3888           or p-pay-sum-rubl <> temp-d-card.pay-tot-rubl) then
     3889           PUT STREAM TEST UNFORMATTED
     3890           temp-d-card.d-card format "X(16)" space(1)
     3891           buf_inkas.inkas-code space(1)
     3892           temp-d-card.pay-tot-rubl format "->>>,>>>,>>9.99" space(1)
     3893           temp-d-card.pay-tot-base format "->>>,>>>,>>9.99" space(1)
     3894           p-pay-sum-rubl  format "->>>,>>>,>>9.99" space(1)
     3895           p-pay-sum-base  format "->>>,>>>,>>9.99" space(1)
     3896           (temp-d-card.pay-tot-rubl - p-pay-sum-rubl) format "->>>,>>>,>>9.99" space(1)
     3897           (temp-d-card.pay-tot-base - p-pay-sum-base) format "->>>,>>>,>>9.99" space(1)
     3898           SKIP.
     3899         END.
     3900       end.
     3901       find first buf_Dis-card where buf_Dis-card.d-card = f-d-card no-error .
     3902       if available buf_Dis-card then do:
     3903       for each buf_sysconf no-lock,
     3904           each bf_trn-doc no-lock where
     3905               bf_trn-doc.host-code = buf_sysconf.host-code
     3906           AND bf_trn-doc.cli-type = buf_Dis-card.cli-type
     3907           AND bf_trn-doc.cli-code = buf_Dis-card.cli-code
     3908           AND bf_trn-doc.doc-date >= X_start-date
     3909           AND bf_trn-doc.doc-date <= X_end-date:
     3910         if bf_trn-doc.status_ <> 'факт':U then NEXT.
     3911         if bf_trn-doc.d-card = "":U then NEXT.
     3912         if bf_trn-doc.d-card <> f-d-card then NEXT.
     3913         if bf_trn-doc.ext-doc-type = 'es':U then NEXT.
     3914         for each temp-d-card:
     3915           delete temp-d-card.
     3916         end.
     3917         for each vchk-pay:
     3918           delete vchk-pay.
     3919         end.
     3920         create temp-d-card.
     3921         assign
     3922         temp-d-card.d-card            = bf_trn-doc.d-card
     3923         temp-d-card.card-num          = temp-d-card.card-num
     3924         temp-d-card.emitent-host-code = temp-d-card.emitent-host-code
     3925         temp-d-card.type              = temp-d-card.type
     3926         temp-d-card.cli-type          = temp-d-card.cli-type
     3927         temp-d-card.cli-code          = temp-d-card.cli-code
     3928         .
     3929         assign
     3930         p-doc-code = bf_trn-doc.doc-code
     3931         .
     3932         assign
     3933         par-sign = 1
     3934         par-direction =  if bf_trn-doc.ext-doc-type = 're':U
     3935                       then -1
     3936                       else  1.
     3937   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3938   if v-cntxt-db-num = 0 then do:
     3939     FOR EACH buf_doc-line no-lock where
     3940             buf_doc-line.doc-code = p-doc-code
     3941        On error undo _main, return error:
     3942       run r-sale in this-procedure (
     3943                                       input p-doc-code
     3944                                      ,input buf_doc-line.artic
     3945                                      ,input buf_doc-line.prod-type
     3946                                      ,input buf_doc-line.prod-code
     3947                                      ,output v-fact-qnty
     3948                                      ,output v-vat-pc
     3949                                      ,output v-slt-pc
     3950                                      ,output v-sum-base
     3951                                      ,output v-sum-rubl
     3952                                      ,output v-vat-base
     3953                                      ,output v-vat-rubl
     3954                                      ,output v-slt-base
     3955                                      ,output v-slt-rubl
     3956                                      ,output v-road-tax-base
     3957                                      ,output v-road-tax-rubl
     3958                                      ,output v-transport-base
     3959                                      ,output v-transport-rubl
     3960                                      ,output v-other-base
     3961                                      ,output v-other-rubl
     3962                                      ,output v-excise-base
     3963                                      ,output v-excise-rubl
     3964                                       ) .
     3965         assign
     3966         temp-d-card.pay-tot-rubl = temp-d-card.pay-tot-rubl + par-direction * par-sign * abs( v-sum-rubl)
     3967         temp-d-card.pay-tot-base = temp-d-card.pay-tot-base + par-direction * par-sign * abs( v-sum-base)
     3968         temp-d-card.gds-tot-rubl = temp-d-card.gds-tot-rubl + par-direction * par-sign * abs( (v-sum-rubl + v-other-rubl))
     3969         temp-d-card.gds-tot-base = temp-d-card.gds-tot-base + par-direction * par-sign * abs( (v-sum-base + v-other-base))
     3970         temp-d-card.gds-dis-rubl = temp-d-card.gds-dis-rubl + par-direction * par-sign * abs( v-other-rubl)
     3971         temp-d-card.gds-dis-base = temp-d-card.gds-dis-base + par-direction * par-sign * abs( v-other-base)
     3972         .
     3973         run r-cost in this-procedure (
     3974                                       input p-doc-code
     3975                                      ,input buf_doc-line.artic
     3976                                      ,input buf_doc-line.prod-type
     3977                                      ,input buf_doc-line.prod-code
     3978                                      ,output v-fact-qnty
     3979                                      ,output v-vat-pc
     3980                                      ,output v-slt-pc
