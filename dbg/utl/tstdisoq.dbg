     1617   _main:
     1618   do
     1619   on error undo, return error
     1620   :
     1621   if p-mode = "all" then do:
     1622   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1623   CASE test-number:
     1624     when 1 then do:
     1625   _chk-doc:
     1626       for each buf_chk-doc no-lock where
     1627               buf_chk-doc.obj-type = p-obj-type
     1628           AND buf_chk-doc.obj-code = p-obj-code
     1629           and buf_chk-doc.d-card   > "":U  ,
     1630           first buf_dis-card NO-LOCK where
     1631               buf_dis-card.d-card = buf_chk-doc.d-card
     1632            AND buf_dis-card.emitent-host-code = dctype
     1633           break by buf_chk-doc.obj-type
     1634                 by buf_chk-doc.obj-code
     1635                 by buf_chk-doc.d-card:
     1636           ii = ii + 1.
     1637           if ii MOD 100 = 0 then
     1638           run waitfram-show in this-procedure ("Обработано " + string(ii) + " чеков по дисконтным картам").
     1639           IF FIRST-OF(buf_chk-doc.obj-code) then do:
     1640             find first buf_shop no-lock where
     1641                       buf_shop.obj-code = buf_chk-doc.obj-code No-ERROR.
     1642             if not avail buf_shop then do:
     1643               run waitfram-hide in this-procedure .
     1644               message "Не найдена запись о магазине номер " buf_chk-doc.obj-code view-as alert-box
     1645               ERROR.
     1646               return.
     1647             end.
     1648             find first buf_sysconf where
     1649                         buf_sysconf.host-code = buf_shop.host-code no-lock No-ERROR.
     1650             if not avail buf_sysconf then do:
     1651               run waitfram-hide in this-procedure .
     1652               message "Не найдена запись о фирме номер " buf_shop.host-code
     1653               view-as alert-box
     1654               ERROR.
     1655               return.
     1656             end.
     1657             find first buf_Cash-pay no-lock where
     1658                     buf_cash-pay.cdpay-code = buf_sysconf.credit-pay no-error.
     1659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1660     (input  'iscredit'
     1661     ,input  0
     1662     ,input  ''
     1663     ,input  0
     1664     ,input  ''
     1665     ,input  ''
     1666     ,input  ''
     1667     ,input  no
     1668     ,output conf-par
     1669     ,output par-type
     1670     ) no-error .
     1671             if error-status:error
     1672             or not available buf_cash-pay
     1673             or buf_cash-pay.is-credit = no
     1674             or conf-par <> "yes"
     1675             then do:
     1676               assign
     1677               cre-pay = 0
     1678               .
     1679             end.
     1680             else do:
     1681               assign
     1682               cre-pay = buf_sysconf.credit-pay
     1683               .
     1684             end.
     1685             assign
     1686             v-base-code = buf_sysconf.base-code
     1687             .
     1688           end.
     1689           if buf_chk-doc.out-code = ? then next.
     1690           if LOOKUP(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then NEXT.
     1691           FIND FIRST buf_inkas No-LOCK WHERE
     1692                       buf_inkas.inkas-code = buf_chk-doc.out-code No-ERROR.
     1693           if not avail buf_inkas then next.
     1694           find first temp-inkas no-lock where
     1695                     temp-inkas.inkas-code = buf_Inkas.inkas-code no-error .
     1696           find first buf_trn-doc no-lock where
     1697                     buf_trn-doc.doc-code = buf_inkas.inkas-code no-error .
     1698           if not available buf_trn-doc then do:
     1699           end.
     1700           find first buf_ret-doc no-lock where
     1701                     buf_ret-doc.doc-code = buf_trn-doc.out-code no-error .
     1702           if not available buf_ret-doc then do:
     1703           end.
     1704           if available buf_inkas
     1705           and buf_inkas.status_ = 'факт':U
     1706           and buf_inkas.obj-type = 'маг':U
     1707           and not available temp-inkas
     1708           then do:
     1709             create temp-inkas.
     1710             assign
     1711             temp-inkas.inkas-code = buf_inkas.inkas-code
     1712             rabota = yes.
     1713           end.
     1714           else do:
     1715             rabota = no.
     1716           end.
     1717           if rabota then do:
     1718               run waitfram-show in this-procedure ("Обработка отчета о продаже " + buf_inkas.inkas-code).
     1719             par-sign = 1.
     1720   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1721     _cards:
     1722     for each ub.chk-doc no-lock
     1723       where ub.chk-doc.obj-type = buf_inkas.obj-type
     1724         AND ub.chk-doc.obj-code = buf_inkas.obj-code
     1725         AND ub.chk-doc.out-code = buf_inkas.inkas-code
     1726         and ub.chk-doc.d-card > ""
     1727     on error undo _main, return error
     1728     :
     1729     if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _cards.
     1730       find first temp-d-card where
     1731                 temp-d-card.d-card = ub.chk-doc.d-card no-error .
     1732       if not available temp-d-card then do:
     1733         find first ub.dis-card no-lock
     1734           where ub.dis-card.d-card = ub.chk-doc.d-card
     1735           no-error .
     1736         if not avail dis-card then do:
     1737           next _cards.
     1738         end.
     1739         FIND FIRST ub.clients WHERE
     1740                     ub.clients.obj-type = ub.dis-card.cli-type AND
     1741                     ub.clients.obj-code = ub.dis-card.cli-code No-ERROR.
     1742         if not avail ub.clients then do:
     1743           undo _main, return error "Не найден клиент для дисконтной карты " + ub.dis-card.d-card.
     1744         end.
     1745         assign
     1746           ub.clients.buy-gds = ub.clients.buy-gds OR ( NOT buf_inkas.office )
     1747           ub.clients.buy-serv = ub.clients.buy-serv OR buf_inkas.office
     1748         .
     1749         create temp-d-card.
     1750         assign
     1751         temp-d-card.d-card = ub.chk-doc.d-card
     1752         temp-d-card.pay-tot-base = 0
     1753         temp-d-card.pay-tot-rubl = 0
     1754         temp-d-card.gds-tot-b0 = 0
     1755         temp-d-card.gds-tot-r0 = 0
     1756         temp-d-card.first-main-card   = ub.dis-card.first-main-card
     1757         temp-d-card.main-card         = ub.dis-card.main-card
     1758         temp-d-card.first-card        = ub.dis-card.first-card
     1759         temp-d-card.cli-type          = ub.dis-card.cli-type
     1760         temp-d-card.cli-code          = ub.dis-card.cli-code
     1761         temp-d-card.card-num          = ub.dis-card.card-num
     1762         temp-d-card.emitent-host-code = ub.dis-card.emitent-host-code
     1763         temp-d-card.type              = ub.dis-card.type
     1764         temp-d-card.obj-type          = ub.chk-doc.obj-type
     1765         temp-d-card.obj-code          = ub.chk-doc.obj-code
     1766         temp-d-card.host-code         = buf_inkas.host-code
     1767         temp-d-card.sale-doc          = buf_inkas.inkas-code
     1768         temp-d-card.sale-type         = 'inkas':U
     1769         temp-d-card.doc-date          = ub.chk-doc.chk-date
     1770         temp-d-card.action            = sign
     1771         .
     1772       end.
     1773       FOR EACH ub.chk-gds WHERE
     1774                 ub.chk-gds.doc-code = ub.chk-doc.doc-code AND
     1775                 ub.chk-gds.b-code <> 0 NO-LOCK ,
     1776           FIRST ub.bar-code where
     1777                 ub.bar-code.b-code = ub.chk-gds.b-code No-LOCK,
     1778           FIRST ub.goods where
     1779                 ub.goods.gds-code = ub.bar-code.gds-code No-LOCK,
     1780           FIRST ub.doc-line WHERE
     1781                 ub.doc-line.doc-code = (if ub.chk-doc.netto >= 0 then buf_trn-doc.doc-code else ret-doc-code) AND
     1782                 ub.doc-line.prod-code = ub.goods.prod-code AND
     1783                 ub.doc-line.prod-type = ub.goods.prod-type AND
     1784                 ub.doc-line.artic = ub.goods.artic NO-LOCK
     1785                 On error undo _main, return error
     1786                 :
     1787         if ub.chk-gds.write-off-code <> ?
     1788         and ub.chk-gds.write-off-code > 0 then NEXT.
     1789         assign
     1790         temp-d-card.gds-tot-r0 = temp-d-card.gds-tot-r0 +  par-sign * ( ub.doc-line.price-rubl * ub.chk-gds.doc-qnty )
     1791         temp-d-card.gds-tot-b0 = temp-d-card.gds-tot-b0 +  par-sign * ( ub.doc-line.price-base * ub.chk-gds.doc-qnty )
     1792         .
     1793       END.
     1794       assign
     1795       accum-tot-base = 0
     1796       accum-tot-rubl = 0
     1797       accum-cre-pay-base =0
     1798       accum-cre-pay-rubl =0
     1799       .
     1800       FOR EACH ub.chk-pay WHERE
     1801                ub.chk-pay.doc-code = ub.chk-doc.doc-code NO-LOCK
     1802       On error undo _main, return error
     1803       :
     1804           if ub.chk-pay.pay-code = cre-pay
     1805             then
     1806           assign
     1807           cre-pay-base = ub.chk-pay.tot-base
     1808           cre-pay-rubl   = ub.chk-pay.tot-rubl .
     1809             else
     1810           assign
     1811           cre-pay-base = 0
     1812           cre-pay-rubl   = 0 .
     1813           Assign
     1814           accum-tot-rubl     = accum-tot-rubl +  ub.chk-pay.tot-rubl
     1815           accum-tot-base     = accum-tot-base +  ub.chk-pay.tot-base
     1816           accum-cre-pay-base = accum-cre-pay-base +  cre-pay-base
     1817           accum-cre-pay-rubl = accum-cre-pay-rubl +  cre-pay-rubl
     1818           .
     1819           if v-cntxt-db-num = 0 and ub.chk-pay.pay-code <> cre-pay then do:
     1820             FIND FIRST vchk-pay No-LOCK WHERE
     1821                         vchk-pay.d-card = ub.chk-doc.d-card AND
     1822                         vchk-pay.pay-code = ub.chk-pay.pay-code AND
     1823                         vchk-pay.curr-code = ub.chk-pay.curr-code AND
     1824                         vchk-pay.doc-date = ub.chk-pay.chk-date AND
     1825                         vchk-pay.cre-pay = (ub.chk-pay.pay-code = cre-pay) AND
     1826                         vchk-pay.exch-rate = (ub.chk-pay.tot-sum / chk-pay.tot-rubl) AND
     1827                       vchk-pay.base-rate = (ub.chk-pay.tot-rubl / chk-pay.tot-base ) No-ERROR.
     1828             IF NOT AVAIL vchk-pay then do:
     1829               create vchk-pay.
     1830               assign
     1831               vchk-pay.d-card   = ub.chk-doc.d-card
     1832               vchk-pay.doc-date = ub.chk-pay.chk-date
     1833               vchk-pay.pay-code = ub.chk-pay.pay-code
     1834               vchk-pay.curr-code = ub.chk-pay.curr-code
     1835               vchk-pay.cre-pay = (ub.chk-pay.pay-code = cre-pay)
     1836               vchk-pay.exch-rate =  (ub.chk-pay.tot-sum / ub.chk-pay.tot-rubl)
     1837               vchk-pay.base-rate = (ub.chk-pay.tot-rubl / ub.chk-pay.tot-base)
     1838               .
     1839             end.
     1840             assign
     1841             vchk-pay.tot-sum  = vchk-pay.tot-sum  + ub.chk-pay.tot-sum
     1842             vchk-pay.tot-base = vchk-pay.tot-base + ub.chk-pay.tot-base
     1843             vchk-pay.tot-rubl = vchk-pay.tot-rubl + ub.chk-pay.tot-rubl
     1844             .
     1845         END.
     1846       END .
     1847       assign
     1848       temp-d-card.pay-tot-base = temp-d-card.pay-tot-base + par-sign * (ACCUM-tot-base -  ACCUM-cre-pay-base)
     1849       temp-d-card.pay-tot-rubl = temp-d-card.pay-tot-rubl + par-sign * (ACCUM-tot-rubl -  ACCUM-cre-pay-rubl)
     1850       .
     1851       if v-base-code = 0 then
     1852       chk-exch =  1.
     1853       else do:
     1854         v-rate = ?.
     1855         if v-curr-r-b = 'base':U then do:
     1856           assign
     1857           v-rate = ub.chk-doc.cash-rate / ub.chk-doc.cash-scale
     1858           no-error
     1859           .
     1860           if v-rate <> 0
     1861           and v-rate <> ? then do:
     1862             chk-exch = v-rate.
     1863           end.
     1864           else do:
     1865             assign
     1866             v-rate = ACCUM-tot-rubl  / ACCUM-tot-base
     1867             no-error
     1868             .
     1869             if v-rate <> ?
     1870             and v-rate <> 0 then do:
     1871               chk-exch = v-rate.
     1872             end.
     1873             else do:
     1874                 undo _main, return error substitute("&1&2 Невозможно определить курс базовой валюты для чека &3 по ДК &4"
     1875                                                     , vss-description
     1876                                                     , chr(10)
     1877                                                     , chk-doc.doc-code
     1878                                                     , chk-doc.d-card).
     1879             end.
     1880           end.
     1881         end.
     1882         else do:
     1883           assign
     1884           v-rate = ACCUM-tot-rubl  / ACCUM-tot-base
     1885           no-error
     1886           .
     1887           if v-rate <> ?
     1888           and v-rate <> 0 then do:
     1889             chk-exch = v-rate.
     1890           end.
     1891           else do:
     1892             FIND LAST buf_curr-shop NO-LOCK WHERE
     1893                       buf_curr-shop.obj-type = ub.chk-doc.obj-type AND
     1894                       buf_curr-shop.obj-code = ub.chk-doc.obj-code AND
     1895                       buf_curr-shop.curr-code = v-base-code AND
     1896                       ( ( buf_curr-shop.exch-date = ub.chk-doc.chk-date AND
     1897                           buf_curr-shop.exch-time <= ub.chk-doc.chk-time ) OR
     1898                           buf_curr-shop.exch-date < ub.chk-doc.chk-date ) NO-ERROR .
     1899             if available buf_curr-shop then do:
     1900               assign
     1901               v-rate = buf_Curr-shop.exch-rate / buf_curr-shop.exch-scale
     1902               no-error .
     1903               if v-rate <> ?
     1904               and v-rate <> 0 then do:
     1905                 chk-exch = v-rate.
     1906               end.
     1907               else do:
     1908                   undo _main, return error substitute("&1&2 Невозможно определить курс базовой валюты для чека &3 по ДК &4"
     1909                                                       , vss-description
     1910                                                       , chr(10)
     1911                                                       , chk-doc.doc-code
     1912                                                       , chk-doc.d-card).
     1913               end.
     1914             end.
     1915           end.
     1916         end.
     1917       end.
     1918       assign
     1919       chk-exch-rubl = (if v-curr-r-b = 'rubl':U then 1 else chk-exch)
     1920       chk-exch-base = (if v-curr-r-b = 'base':U then 1 else chk-exch )
     1921       .
     1922       Assign
     1923       temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-r-b + 0
     1924       temp-d-card.sum-tot-rubl = temp-d-card.sum-tot-rubl + 0
     1925       temp-d-card.sum-tot-base = temp-d-card.sum-tot-base + 0
     1926       temp-d-card.gds-tot-r-b  = temp-d-card.gds-tot-r-b  + par-sign * ub.chk-doc.tot-doc
     1927       temp-d-card.gds-tot-rubl = temp-d-card.gds-tot-rubl + par-sign * ub.chk-doc.tot-doc * chk-exch-rubl
     1928       temp-d-card.gds-tot-base = temp-d-card.gds-tot-base + par-sign * ub.chk-doc.tot-doc / chk-exch-base
     1929       temp-d-card.gds-dis-r-b  = temp-d-card.gds-dis-r-b  + par-sign * ub.chk-doc.discnt
     1930       temp-d-card.gds-dis-rubl = temp-d-card.gds-dis-rubl + par-sign * ub.chk-doc.discnt * chk-exch-rubl
     1931       temp-d-card.gds-dis-base = temp-d-card.gds-dis-base + par-sign * ub.chk-doc.discnt / chk-exch-base
     1932       temp-d-card.num-chk      = temp-d-card.num-chk      + par-sign * 1
     1933       .
     1934       run ref/calctur4.p ( input ub.chk-doc.doc-code ) .
     1935    END.
     1936           end.
     1937       END.
     1938       for each buf_Dis-obj no-lock where
     1939               buf_dis-obj.obj-type = p-obj-type
     1940           AND buf_dis-obj.obj-code = p-obj-code
     1941           and buf_dis-obj.dt-code = 0,
     1942          first buf_dis-card no-lock where
     1943               buf_dis-card.d-card = buf_dis-obj.d-card
