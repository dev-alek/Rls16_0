     2232         par-sign = 1.
     2233   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2234     _cards:
     2235     for each ub.chk-doc no-lock
     2236       where ub.chk-doc.obj-type = buf_inkas.obj-type
     2237         AND ub.chk-doc.obj-code = buf_inkas.obj-code
     2238         AND ub.chk-doc.out-code = buf_inkas.inkas-code
     2239         and ub.chk-doc.d-card > ""
     2240     on error undo _main, return error
     2241     :
     2242     if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _cards.
     2243       find first temp-d-card where
