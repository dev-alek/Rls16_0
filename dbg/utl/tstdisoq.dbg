     2254         FIND FIRST ub.clients WHERE
     2255                     ub.clients.obj-type = ub.dis-card.cli-type AND
     2256                     ub.clients.obj-code = ub.dis-card.cli-code No-ERROR.
     2257         if not avail ub.clients then do:
