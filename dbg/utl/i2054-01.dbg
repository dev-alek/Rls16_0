     5025   end procedure.
     5026   procedure mainmenu_getcntxt :
     5027   define output parameter p-cntxt-db-num                as integer   no-undo .
     5028   define output parameter p-cntxt-userid                as character no-undo .
     5029   define output parameter p-cntxt-level                 as character no-undo .
     5030   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
     5031   define output parameter p-cntxt-obj-type              as character no-undo .
     5032   define output parameter p-cntxt-obj-code              as integer   no-undo .
     5033   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
     5034   define output parameter p-cntxt-is-admin              as logical   no-undo .
     5035     do
     5036     on error undo, return error return-value
     5037     :
     5038   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5039   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5040     (input  vt-obj-type
     5041     ,input  vt-obj-code
     5042     ,output p-cntxt-db-num-obj
     5043     )  .
     5044     assign
     5045       p-cntxt-db-num          =  v-cntxt-db-num
     5046       p-cntxt-userid          =  v-cntxt-userid
     5047       p-cntxt-level           =  v-cntxt-level
     5048       p-cntxt-host-code-obj   =  vt-host-code
     5049       p-cntxt-obj-type        =  vt-obj-type
     5050       p-cntxt-obj-code        =  vt-obj-code
     5051       p-cntxt-is-admin        =  v-cntxt-is-admin
     5052     .
     5053     end.
     5054    end procedure.
     5055    procedure get-report-num :
     5056     define output parameter p-report-num as integer no-undo .
     5057      do
     5058      on error undo, return error return-value
     5059      :
     5060       assign
     5061         p-report-num = 1
     5062       .
     5063      end.
     5064    end procedure.
