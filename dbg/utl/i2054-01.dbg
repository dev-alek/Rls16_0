     1621   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1622   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1623   define variable par-type          as character no-undo.
     1624   define variable v-value-character as character no-undo .
     1625   define variable v-value-date      as date      no-undo .
     1626   define variable v-value-decimal   as decimal   no-undo .
     1627   define variable v-value-integer   as integer   no-undo .
     1628   define variable v-value-logical   as logical   no-undo .
     1629   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1630   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1631   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1632   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1633   ASSIGN
     1634      v-S_CONTRACT                = "Contract":U
     1635      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1636      v-DELIM_CHR_3               = ","
     1637      .
     1638   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1639   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1640   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1641   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1642      INPUT iHost-Code    AS INTEGER,
     1643      INPUT iContract-Num AS INTEGER,
     1644      INPUT iGds-Code     AS INTEGER ):
     1645      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1646      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1647      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1648      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1649      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1650      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1651          INPUT  iHost-Code,
     1652          INPUT  iContract-Num,
     1653          OUTPUT iTmp-Extent3
     1654          ).
     1655      IF iTmp-Extent3[1] = 2 THEN DO:
     1656         ASSIGN
     1657            iTmp-Host-Code      = iTmp-Extent3[2]
     1658            iTmp-Contract-Num   = iTmp-Extent3[3]
     1659            .
     1660      END. ELSE DO:
     1661         ASSIGN
     1662            iTmp-Host-Code      = iHost-Code
     1663            iTmp-Contract-Num   = iContract-Num
     1664            .
     1665      END.
     1666      IF iGds-Code = ? THEN DO:
     1667         ASSIGN
     1668            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1669                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1670                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1671                           ).
     1672      END. ELSE DO:
     1673            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1674                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1675                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1676                              AND buf_Spec.Gds-Code      = iGds-Code
     1677                            ).
     1678      END.
     1679      RETURN (lRet).
     1680   END FUNCTION.
     1681   PROCEDURE MS-Contract-EXTENT-3:
     1682      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1683      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1684      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1685      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1686      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1687      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1688      FIND FIRST buf_Cont-2 WHERE
     1689                 buf_Cont-2.Host-Code      = i-Host-Code
     1690             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1691           NO-LOCK NO-ERROR.
     1692      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1693         RETURN.
     1694      END.
     1695      FOR FIRST buf_Ext-Classif WHERE
     1696                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1697           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1698                                               STRING(i-Contract-code)
     1699           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1700          NO-LOCK,
     1701          EACH buf_Cont WHERE
     1702               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1703           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1704          NO-LOCK:
     1705          ASSIGN
     1706             i-Ret[1] = 1
     1707             i-Ret[2] = buf_Cont.Host-code
     1708             i-Ret[3] = buf_Cont.Contract-code
     1709             .
     1710          LEAVE.
     1711      END.
     1712      IF i-Ret[1] <> 1 THEN DO:
     1713         FOR FIRST buf_Ext-Classif WHERE
     1714                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1715              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1716                                                  STRING(i-Contract-code)
     1717              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1718             NO-LOCK,
     1719             EACH buf_Cont WHERE
     1720                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1721              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1722             NO-LOCK:
     1723             ASSIGN
     1724                i-Ret[1] = 2
     1725                i-Ret[2] = buf_Cont.Host-code
     1726                i-Ret[3] = buf_Cont.Contract-code
     1727                .
     1728             LEAVE.
     1729         END.
     1730      END.
     1731      RETURN.
     1732   END PROCEDURE.
