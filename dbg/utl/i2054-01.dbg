       83   procedure vss-get-parameters :
       84     define output parameter p-vss-parameters as character no-undo .
       85   end procedure.
       86   define new global shared variable g#vssrevis-logger as handle    no-undo .
       87   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       88   define variable v-vssrevis-logger                   as handle    no-undo .
       89   procedure vss-logevent :
       90     define input  parameter p-extra-paramters as character no-undo .
       91     define variable v-vssrevis-parameters as character no-undo .
       92     do
       93     on error undo, return error return-value
       94     :
       95       if  valid-handle(v-vssrevis-logger)
       96       and v-vssrevis-logger :get-signature("logevent") <> ""
       97       then do:
       98         run vss-get-parameters in this-procedure
       99           (output v-vssrevis-parameters
      100           ).
      101         run logevent in v-vssrevis-logger
      102           (input vss-workfile
      103           ,input vss-revision
      104           ,input v-vssrevis-parameters
      105           ,input p-extra-paramters
      106           ).
      107       end.
      108     end.
      109   end procedure.
      110   assign
      111     v-vssrevis-logger = g#vssrevis-logger
      112   .
      113   if  valid-handle(v-vssrevis-logger)
      114   and v-vssrevis-logger :get-signature("logevent") <> ""
      115   then do:
      116     assign
      117       v-vssrevis-logevent = true
      118     .
      119     run vss-logevent in this-procedure (input vss-description) .
      120   end.
      121   define new global shared variable g#language as character no-undo .
      122   if g#language <> '' and g#language <> 'rus':U then do:
      123     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      124   end.
      125   define new global shared variable g#library  as handle no-undo .
      126   define new global shared variable g#library2 as handle no-undo .
      127   define new global shared variable g#lib-trn  as handle no-undo .
      128   define new global shared variable g#lib-trn2 as handle no-undo .
      129   define new global shared variable g#lib-trn3 as handle no-undo .
      130   define new global shared variable g#lib-trn4 as handle no-undo .
      131   define new global shared variable g#libbcrcn as handle no-undo .
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define variable to-day       as date no-undo .
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure doc-code:
      136   define input  parameter parmode          as   character           no-undo.
      137   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      138   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      139   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      140   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      141   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      142   define variable vardb-remote     as   logical             no-undo.
      143   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      144   define variable v-delimiter as character no-undo .
      145   do
      146   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      147   :
      148   find first buf_sys-ctrl no-lock .
      149   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      150     CASE parmode:
      151       when "main":u then do:
      152         if vardb-remote then do:
      153           assign
      154             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      155         end.
      156         else do:
      157           assign
      158             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      159         end.
      160       end.
      161       when "trio" then do:
      162         assign
      163           pardoc-code = replace (parroot-doc-code, "=", "*").
      164       end.
      165       otherwise do:
      166         assign
      167         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      168         no-error
      169         .
      170         if error-status:error  then do:
      171           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      172                                         ,chr(10)
      173                                         ,parmode
      174                                         ).
      175         end.
      176         if num-entries(parmode) = 1
      177         and parmode <> "chip":U
      178         and parmode <> "chip_s":U
      179         then do:
      180           assign
      181           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      182         end.
      183         else if (lookup("chip":U, parmode) > 0
      184                  or
      185                  lookup("chip_s":U, parmode) > 0) then do:
      186           assign
      187             vartemp-doc-code = parroot-doc-code.
      188           do while true:
      189             if index (vartemp-doc-code , ".") = 0 then
      190               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      191             else
      192               vartemp-doc-code  =
      193               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      194               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      195               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      196             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      197           end.
      198           assign
      199             pardoc-code = vartemp-doc-code.
      200         end.
      201       end.
      202     end CASE.
      203     if pardoc-code = '':U
      204     or (parroot-doc-code <> '':U
      205     and pardoc-code = parroot-doc-code) then do:
      206       undo, return error substitute("Ошибка при генерации номера документа&1"
      207                                     ,chr(10)).
      208     end.
      209   end.
      210   end. // procedure/method
      211   function get-doc-code-int64 returns int64
      212     ( input p-doc-code as character ) :
      213     define variable v-ind              as integer   no-undo .
      214     define variable v-num-entries      as integer   no-undo .
      215     define variable v-doc-code-int64   as int64     no-undo .
      216     define variable v-canonic-doc-code as character no-undo .
      217     assign
      218       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      219       v-canonic-doc-code = p-doc-code
      220     .
      221     do v-ind = 1 to v-num-entries
      222     :
      223       assign
      224         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      225       .
      226     end.
      227     assign
      228       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      229     .
      230     return v-doc-code-int64 .
      231   end. // function/method
      232   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233   define variable v-waitfram-action01         as character   no-undo .
      234   define variable v-waitfram-action02         as character   no-undo .
      235   define variable v-waitfram-action03         as character   no-undo .
      236   define variable mWaitFramTextBeg            as character   no-undo.
      237   define variable mWaitFramTextEnd            as character   no-undo.
      238   define variable mWaitFramView               as logical     no-undo.
      239   define variable mWaitProcEvent              as logical     no-undo init yes.
      240   define variable mWaitFramInterval           as integer     no-undo init 1 .
      241   define variable mWaitFramStop               as logical     no-undo.
      242   define variable mWaitFramStopUser           as logical     no-undo.
      243   define variable mWaitFramStopTimeOut        as logical     no-undo.
      244   define variable mWaitFramStartProc          as datetime-tz no-undo.
      245   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      246   define button B-WaitFramStop auto-end-key
      247        label "Стоп"
      248        size 10 by 1 tooltip "Остоновить процесс".
      249   define button B-viewProcInfo
      250        label "Информация"
      251        size 15 by 1 tooltip "Информация о процесс".
      252   define frame waitfram
      253     v-waitfram-action01 format "x(72)" no-label skip
      254     v-waitfram-action02 format "x(72)" no-label skip
      255     v-waitfram-action03 format "x(72)" no-label skip
      256     B-viewProcInfo
      257     B-WaitFramStop at row 4 col 30
      258     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      259     .
      260   define new global shared variable mBatchMode as logical no-undo init ?.
      261   define variable mFramBachModHandle as handle no-undo.
      262   mFramBachModHandle = frame waitfram:handle.
      263   define variable mFameOldVis as logical no-undo.
      264   define variable mVisCUrentVin as logical no-undo.
      265   if session:batch-mode
      266   then
      267      mBatchMode = yes.
      268   if mBatchMode = ? then do:
      269     mVisCUrentVin = current-window:visible.
      270     mFameOldVis = mFramBachModHandle:visible.
      271     mFramBachModHandle:visible  = yes.
      272     mBatchMode = mFramBachModHandle:visible ne yes.
      273     mFramBachModHandle:visible = mFameOldVis.
      274     current-window:visible = mVisCUrentVin.
      275   end.
      276    if  log-manager:logfile-name ne ?
      277     then DO:
      278         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      279         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      280         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      281     end.
      282   on choose of B-WaitFramStop in frame waitfram
      283   do:
      284     mWaitFramStop = yes.
      285     mWaitFramStopUser = yes.
      286   end.
      287   function waitfram-check-timeout returns logical():
      288      define variable vtime as int64 no-undo.
      289      if mWaitFramStopTimeOut
      290      then
      291         return yes.
      292      vtime = ( now - mWaitFramStartProc ) / 1000 .
      293      if     mWaitFramTimeOut ne ?
      294         and mWaitFramTimeOut ne 0
      295         and mWaitFramTimeOut lt vtime
      296      then do:
      297         mWaitFramStopTimeOut = yes.
      298      end.
      299      return mWaitFramStopTimeOut.
      300   end.
      301   procedure waitfram-hide :
      302     if not session:batch-mode
      303     then do
      304     on error undo, return error return-value
      305     :
      306       pause 0 before-hide .
      307       if not mBatchMode then
      308         hide frame waitfram .
      309     if     not mWaitFramView
      310        and mWaitProcEvent
      311     then
      312       process events .
      313     end.
      314   end procedure.
      315   procedure waitfram-show :
      316     define input  parameter p-message as character no-undo .
      317     define variable v-left-margin as integer   no-undo .
      318     if not session:batch-mode
      319     then do
      320     on error undo, return error return-value
      321     :
      322       if length(p-message) <= 70 then do:
      323         assign
      324           v-left-margin = integer((70 - length(p-message)) / 2)
      325         .
      326         assign
      327           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      328         .
      329         assign
      330           v-waitfram-action01 = " "
      331           v-waitfram-action02 = " "
      332                                    + fill(" ", v-left-margin)
      333                                    + p-message
      334           v-waitfram-action03 = " "
      335         .
      336       end.
      337       else do:
      338         define variable vRindex1 as integer no-undo.
      339         define variable vRindex2 as integer no-undo.
      340         vRindex1 = r-index(p-message," ",70).
      341         if vRindex1 = 0
      342         then
      343            vRindex1 = 70.
      344         if length(p-message)  <= vRindex1 + 70 then do:
      345           assign
      346             v-waitfram-action01 = " "
      347             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      348             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      349           .
      350         end.
      351         else do:
      352           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      353           if vRindex2 <= vRindex1
      354           then
      355              vRindex2 = vRindex1 + 70.
      356           assign
      357             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      358             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      359             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      360           .
      361         end.
      362       end.
      363       B-viewProcInfo:visible   in frame waitfram = no.
      364       B-viewProcInfo:sensitive in frame waitfram = no.
      365       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      366       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      367       if  (   mWaitFramView
      368          or  mWaitProcEvent)
      369          and not mBatchMode
      370       then
      371          display
      372             v-waitfram-action01 skip
      373             v-waitfram-action02 skip
      374             v-waitfram-action03 skip
      375          with frame waitfram .
      376       if     mWaitFramView
      377          then do:
      378             if     mWaitFramInterval ne ?
      379                and not mBatchMode
      380             then
      381                wait-for go of frame waitfram pause mWaitFramInterval.
      382          end.
      383          else
      384             if     mWaitProcEvent
      385                and not mBatchMode
      386             then
      387                process events .
      388     end.
      389   end procedure.
      390      procedure waitfram-show-this:
      391         define input  parameter iInterval as int64 no-undo.
      392         define variable vtime as int64 no-undo.
      393         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      394         mWaitFramInterval = iInterval.
      395         run waitfram-show (substitute("&1&2 &3&4" ,
      396                                       mWaitFramTextBeg ,
      397                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      398                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      399                                       mWaitFramTextEnd
      400                                      )
      401                           ).
      402      end.
      403      procedure WaitFramRunPause:
      404         define input  parameter iInterval as dec no-undo.
      405         define variable vStart  as datetime-tz no-undo.
      406         define variable vend    as datetime-tz no-undo.
      407         define variable vint as int64 no-undo.
      408         define variable vOk as logical no-undo.
      409         vStart = now.
      410         vend   = vStart.
      411         publish "WaitFramPause" (iInterval,output vOk).
      412         vend   =  now.
      413         vint = vend - vStart.
      414         vint = iInterval - vint / 1000.
      415         if     not mWaitFramStop
      416            and (   vint > 0
      417                 or (    not vOk
      418                     and iInterval eq ?
      419                     )
      420                 )
      421         then
      422            run waitfram-show-this (iInterval).
      423         vend   =  now.
      424         vint = vend - vStart.
      425         vint = iInterval - vint / 1000.
      426         if     not mWaitFramStop
      427            and vint > 0
      428         then do:
      429            run gbl/pause.p (vint * 1000).
      430         end.
      431         if iInterval ne ?
      432         then
      433            publish "WaitFramStop".
      434         waitfram-check-timeout().
      435      end.
      436      procedure WaitFramWaitFor:
      437         define input  parameter iInterval as dec no-undo.
      438         assign
      439            mWaitFramStartProc   = now
      440            mWaitFramStopUser    = no
      441            mWaitFramStopTimeOut = no
      442         .
      443         block-wait:
      444         do while not mWaitFramStop:
      445            run WaitFramRunPause (iInterval).
      446            if  waitfram-check-timeout()
      447            then do:
      448               leave block-wait.
      449            end.
      450         end.
      451         run waitfram-hide.
      452      end.
      453   procedure waitfram-join :
      454     define input  parameter p-line-1  as character no-undo .
      455     define input  parameter p-line-2  as character no-undo .
      456     define input  parameter p-line-3  as character no-undo .
      457     define output parameter p-message as character no-undo .
      458     do
      459     on error undo, return error return-value
      460     :
      461       assign
      462         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      463                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      464                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      465       .
      466     end.
      467   end procedure.
      468   function waitfram-join-function returns character
      469     (input p-line-1 as character
      470     ,input p-line-2 as character
      471     ,input p-line-3 as character
      472     ).
      473     define variable v-message as character no-undo .
      474     run waitfram-join in this-procedure
      475       (input  p-line-1
      476       ,input  p-line-2
      477       ,input  p-line-3
      478       ,output v-message
      479       ) .
      480     return v-message .
      481   end function .
      482   function cross-list returns logical (
      483     input parfirst-stream  as character,
      484     input parsecond-stream as character,
      485     input pardelim         as character).
      486     if pardelim = ""
      487     or pardelim = ?
      488     then do:
      489       assign
      490         pardelim = ","
      491       .
      492     end.
      493     define variable vari            as integer no-undo .
      494     define variable varresult-cross as logical no-undo .
      495     assign
      496       varresult-cross = no
      497     .
      498     def var v-num-parfirst-stream as integer no-undo .
      499     assign
      500       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      501     .
      502     do vari = 1 to v-num-parfirst-stream
      503     :
      504       if lookup(entry(vari, parfirst-stream, pardelim)
      505                ,parsecond-stream
      506                ,pardelim
      507                ) > 0 then do:
      508         assign
      509           varresult-cross = yes
      510         .
      511         leave.
      512       end.
      513     end.
      514     return varresult-cross .
      515   end function.
      516   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      517   define new global shared variable g#attr-lib  as handle no-undo .
      518   define variable v-attr-lib-variable as handle no-undo .
      519   procedure clntattr-code :
      520     define input  parameter p-code           as character no-undo .
      521     define output parameter p-type           as character no-undo .
      522     define output parameter p-format         as character no-undo .
      523     define output parameter p-label          as character no-undo .
      524     define output parameter p-user-can-edit  as logical   no-undo .
      525     define output parameter p-output-display as logical   no-undo .
      526     define output parameter p-other          as character no-undo .
      527     do
