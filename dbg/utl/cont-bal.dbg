        1   block-level on error undo, throw.
        2   define input parameter parParentProc as handle           no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: 026c675a5513, 352, rls $":u .
        4   define variable vss-author      as character no-undo init "$Author: EShklyar $":u .
        5   define variable vss-date        as character no-undo init "$Date: Thu Dec 17 17:50:47 2015 +0300 $":u .
        6   define variable vss-workfile    as character no-undo init "$Workfile: cont-bal.p $":u .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/cont-bal.p $":u .
        8   define variable vss-description as character no-undo init "утилита Пересчет баланса ФО и платежей к договору" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure cur-time :
       71      define output parameter p-today as date      no-undo .
       72      define output parameter p-time  as integer   no-undo .
       73     do
       74     on error undo, return error
       75     :
       76       define variable v-date1 as date      no-undo .
       77       define variable v-date2 as date      no-undo .
       78       define variable v-time  as integer   no-undo .
       79       assign
       80         v-date1 = today
       81         v-time  = time
       82         v-date2 = today
       83       .
       84       if v-date1 <> v-date2
       85       then do:
       86         assign
       87           v-date1 = today
       88           v-time  = v-time
       89         .
       90       end.
       91       assign
       92         p-today = v-date1
       93         p-time  = v-time
       94       .
       95     end.
       96   end.
       97   function cur-time-date returns character
       98   :
       99     return string(today, '99/99/9999':U) .
      100   end.
      101   function cur-time-mjd returns decimal
      102   :
      103     define variable v-date as date      no-undo .
      104     define variable v-time as integer   no-undo .
      105     run cur-time in this-procedure
      106       (output v-date
      107       ,output v-time
      108       ) .
      109     return integer(v-date) - 2400002 + (v-time / 86400) .
      110   end.
      111   function cur-time-get-ending-index returns integer
      112   (input p-number as integer
      113   )
      114   :
      115     if p-number < 0
      116     or p-number = ?
      117     then do:
      118       return 1 .
      119     end.
      120     define variable v-rest as integer   no-undo .
      121     assign
      122       p-number = p-number modulo 100
      123     .
      124     if p-number < 20
      125     then do:
      126       assign
      127         v-rest = p-number
      128       .
      129     end.
      130     else do:
      131       assign
      132         v-rest = p-number modulo 10
      133       .
      134     end.
      135     case v-rest :
      136       when 1
      137       then do:
      138         return 2 .
      139       end.
      140       when 2 or
      141       when 3 or
      142       when 4
      143       then do:
      144         return 3 .
      145       end.
      146       otherwise do:
      147         return 1 .
      148       end.
      149     end case .
      150   end.
      151   procedure cur-time-mjd-to-date :
      152      define input  parameter i-mjd-diff as decimal no-undo.
      153      define output parameter o-Date     as date    no-undo.
      154      define output parameter o-Time     as integer no-undo.
      155      define variable v-day-number as integer   no-undo .
      156      if    i-mjd-diff < 0
      157         or i-mjd-diff = ?
      158      then do:
      159         return "?" .
      160      end.
      161      assign
      162         v-day-number = truncate(i-mjd-diff,0).
      163         o-Date = date(v-day-number + 2400002).
      164         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      165     .
      166   end.
      167   function cur-time-mjd-to-string returns character
      168   (input p-mjd-diff as decimal
      169   )
      170   :
      171     define variable v-day-number as integer   no-undo .
      172     define variable v-seconds    as integer   no-undo .
      173     define variable v-hour       as integer   no-undo .
      174     define variable v-min        as integer   no-undo .
      175     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      176     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      177     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      178     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      179     if p-mjd-diff < 0
      180     or p-mjd-diff = ?
      181     then do:
      182       return "?" .
      183     end.
      184     assign
      185       v-day-number = integer(truncate(p-mjd-diff,0))
      186       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188     if v-seconds > 86400
      189     then do:
      190       assign
      191         v-seconds = 86400 - 1
      192       .
      193     end.
      194     if v-seconds < 0
      195     then do:
      196       assign
      197         v-seconds = 0
      198       .
      199     end.
      200     assign
      201       v-hour = truncate(v-seconds / 3600, 0)
      202     .
      203     assign
      204       v-seconds = v-seconds modulo 3600
      205     .
      206     assign
      207       v-min = truncate(v-seconds / 60, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 60
      211     .
      212     return
      213         (if v-day-number <> 0
      214           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0
      218           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      222           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      223           else ""
      224         )
      225       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      226       .
      227   end.
      228   function cur-time-string returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-string-sec returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      247   end.
      248   function cur-time-custom  returns character
      249   (input p-prefix as character
      250   ,input p-date-format as character
      251   ,input p-delimiter as character
      252   ,input p-time-format as character
      253   ,input p-suffix as character
      254   )
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return
      263       p-prefix
      264       + string(v-date, p-date-format)
      265       + p-delimiter
      266       + string(v-time, p-time-format)
      267       + p-suffix
      268       .
      269   end.
      270   function cur-time-print  returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-datetime returns datetime
      281   :
      282     define variable v-char as character no-undo .
      283     define variable v-datetime as datetime no-undo .
      284     v-char = cur-time-string().
      285     v-datetime = datetime(v-char).
      286     return  v-datetime.
      287   end.
      288   function cur-time-string-msec returns character
      289   :
      290     define variable v-date as datetime  no-undo .
      291     v-date = now.
      292     return string(v-date) .
      293   end.
      294   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295     define variable v-cntxt-db-num        as integer   no-undo .
      296     define variable v-cntxt-userid        as character no-undo .
      297     define variable v-cntxt-level         as character no-undo .
      298     define variable v-cntxt-host-code-obj as integer   no-undo .
      299     define variable v-cntxt-obj-type      as character no-undo .
      300     define variable v-cntxt-obj-code      as integer   no-undo .
      301     define variable v-cntxt-db-num-obj    as integer   no-undo .
      302     define variable v-cntxt-is-admin      as logical   no-undo .
      303   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304     run mainmenu_getcntxt in parparentproc
      305       (output v-cntxt-db-num
      306       ,output v-cntxt-userid
      307       ,output v-cntxt-level
      308       ,output v-cntxt-host-code-obj
      309       ,output v-cntxt-obj-type
      310       ,output v-cntxt-obj-code
      311       ,output v-cntxt-db-num-obj
      312       ,output v-cntxt-is-admin
      313       ) .
      314     define variable v-choice as integer   no-undo .
      315     define variable doc-list as character no-undo .
      316     define variable v-num    as integer   no-undo .
      317     define variable ii as integer   no-undo .
      318     define variable Counter1 as integer   no-undo .
      319     define buffer buf_contract for contract .
      320     define buffer buf_clients for clients .
      321     define buffer buf_fin-ob for fin-ob .
      322     define buffer buf_fin-doc for fin-doc .
      323     run gbl/d-askw.w (input "Расчет баланса",
      324                   input ("Пересчет баланса ФО и платежей к договору:"  ),
      325                   input "|",
      326                   input ("По договору|" +  "По контрагенту|" + "Все|" + "Выход"),
      327                   input "|||",
      328                   input 1,
      329                   input 4,
      330                   output v-choice).
      331     if v-choice <> 4 then do:
      332       os-delete 'cont-bal.log' .
      333   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334       def var log-file-name as char no-undo.
      335       assign
      336           log-file-name = 'cont-bal.log'
      337       .
      338       if log-file-name <> "":U
      339       then do:
      340           if search( 'cont-bal.log' ) = ?
      341           then do:
      342               output to value( 'cont-bal.log' ).
      343               output close.
      344           end.
      345       end.
      346       DEF STREAM stm-log.
      347       PROCEDURE writelog:
      348       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      349       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      350       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      351       if p-file-name <> ""
      352       then do:
      353       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      354           PUT STREAM stm-log UNFORMATTED chr(10).
      355           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      356                                           OR p-log-string = "&Line") THEN "" ELSE
      357                                           cur-time-string-sec() + " ").
      358           PUT STREAM stm-log UNFORMATTED
      359                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      360                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      361                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      362       OUTPUT STREAM stm-log CLOSE.
      363       end.
      364       END PROCEDURE.
      365       assign  Counter1 = 0 .
      366   define variable v-account as integer init 0 no-undo .
      367   define variable v-account-lavel as character no-undo .
      368   define variable v-button-stop as logical no-undo .
      369   define variable v-kol-spice as integer no-undo .
      370   define variable v-kol-spice2 as integer no-undo .
      371   define variable v-kol-spice3 as integer no-undo .
      372   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      373   DEFINE BUTTON StopBtn AUTO-END-KEY
      374        LABEL "Стоп"
      375        SIZE 10 BY 1.
      376   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      377        LABEL "Обработано записей"
      378         VIEW-AS TEXT
      379        SIZE 14 BY .67 NO-UNDO.
      380   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      381         VIEW-AS TEXT
      382        SIZE 53.25 BY .67
      383        FGCOLOR 1  NO-UNDO.
      384   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      385         VIEW-AS TEXT
      386        SIZE 53.25 BY .67
      387        FGCOLOR 1  NO-UNDO.
      388   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      389         VIEW-AS TEXT
      390        SIZE 53.25 BY .67
      391        FGCOLOR 1  NO-UNDO.
      392   DEFINE RECTANGLE RECT-1
      393        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      394        SIZE 55.13 BY 4.46.
      395   DEFINE FRAME InfoFrame
      396        StopBtn AT ROW 4.25 COL 21.75
      397        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      398        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      399        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      400        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      401        RECT-1 AT ROW 1 COL 1
      402       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      403            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      404            TITLE "Процесс"
      405            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      406   define variable mFrameView      as logical   no-undo init yes.
      407     define variable mFramHandle as handle no-undo.
      408     mFramHandle = frame InfoFrame:handle.
      409     if  log-manager:logfile-name ne ?
      410     then DO:
      411         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      412         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      413         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      414     end.
      415     mFrameView = not session:batch-mode and mFramHandle:visible.
      416     if mFrameView
      417     then do:
      418       ASSIGN
      419          FRAME InfoFrame:HIDDEN                           = TRUE
      420          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      421     end.
      422   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      423   DO:
      424     IF not StopProcessing THEN
      425       Message "Вы действительно хотите прервать" SKIP
      426               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      427                 UPDATE StopProcessing.
      428     IF StopProcessing THEN do:
      429        if mFrameView
      430        then do:
      431           HIDE FRAME InfoFrame.
      432        end.
      433     End.
      434   END.
      435   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
      436     if  log-manager:logfile-name ne ?
      437     then DO:
      438         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      439     end.
      440     if not session:batch-mode then
      441     do:
      442       VIEW FRAME InfoFrame.
      443       mFrameView = true.
      444     end.
      445      v-button-stop = false .
      446         if mFrameView
      447         then do:
      448         if v-button-stop then view STOPBTN in frame InfoFrame.
      449                          else Hide STOPBTN in frame InfoFrame.
      450         end.
      451       case v-choice :
      452         when 1 then do:
      453           run str/cont-all.w (input ParParentProc, input v-cntxt-host-code-obj, input "b-sel,b-mark", input 'все':U, input ?,
      454                     input ?, input ?, input ?, input "current":u, input "all":u, input-output doc-list).
      455           if doc-list <> "" then do:
      456             assign v-num = num-entries(doc-list) .
      457             do ii = 1 to v-num:
      458               find first buf_contract no-lock where RECID(buf_contract) = int (doc-list) no-error .
      459               if available buf_contract then do:
      460                 run CalcContr in this-procedure  .
      461               end.
      462             end.
      463           end.
      464         end.
      465         when 2 then do:
      466           run ref/cli-all.w ( parParentProc, "b-sel,b-mark", 'орг':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, ?, output doc-list ) .
      467           if doc-list <> "" then do:
      468             assign v-num = num-entries(doc-list) .
      469             do ii = 1 to v-num:
      470               find first buf_clients no-lock where RECID(buf_clients) = integer(entry(ii, doc-list)) no-error.
      471               run writelog ( "cont-bal.log", 0, "Контрагент: " + buf_clients.obj-name ) .
      472               for each buf_contract no-lock
      473                 where buf_contract.cli-type = buf_clients.obj-type
      474                   and buf_contract.cli-code = buf_clients.obj-code
      475                   and buf_contract.db-num   = v-cntxt-db-num
      476                 :
      477                 run CalcContr in this-procedure  .
      478               end.
      479             end.
      480           end.
      481         end.
      482         when 3 then do:
      483           for each buf_contract no-lock
      484             where buf_contract.db-num   = v-cntxt-db-num :
      485             run CalcContr in this-procedure  .
      486           end.
      487         end.
      488       end.
      489   if mFrameView
      490   then do:
      491      HIDE FRAME InfoFrame.
      492   end.
      493       define variable g#log as logical   no-undo .
      494       define variable s-list as character no-undo .
      495       run gbl/prnfilen.w ( input  "Результат работы утилиты", input  0, input  'cont-bal.log', input 7, output s-list, output g#log ).
      496     end.
      497   procedure CalcContr :
      498     do on error undo, return error return-value :
      499       assign Counter1 = Counter1 + 1.
      500   IF ( Counter1 modulo v-account = 0 )  then DO:
      501             if  log-manager:logfile-name ne ?
      502             then DO:
      503                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      504             end.
      505              if mFrameView
      506              then do:
      507               DISPLAY
      508                 Counter1 @ RecordsDone
      509                 WITH FRAME InfoFrame.
      510              end.
      511   End.
      512      if v-button-stop then  DO:
      513            if mFrameView
      514            then
      515               PROCESS EVENTS.
      516            IF StopProcessing THEN DO:
      517            RETURN error.
      518            End.
      519      end.
      520       define variable fin-ob-sum       as decimal   no-undo .
      521       define variable fin-ob-sum-rubl  as decimal   no-undo .
      522       define variable fin-ob-sum-base  as decimal   no-undo .
      523       define variable fin-doc-sum      as decimal   no-undo .
      524       define variable fin-doc-sum-rubl as decimal   no-undo .
      525       define variable fin-doc-sum-base as decimal   no-undo .
      526       assign
      527         fin-ob-sum       = 0
      528         fin-ob-sum-rubl  = 0
      529         fin-ob-sum-base  = 0
      530         fin-doc-sum      = 0
      531         fin-doc-sum-rubl = 0
      532         fin-doc-sum-base = 0
      533       .
      534       for each buf_fin-ob no-lock
      535         where buf_fin-ob.host-code     = buf_contract.host-code
      536           and buf_fin-ob.contract-code = buf_contract.contract-code
      537           and buf_fin-ob.status_       = 'факт':U
      538         :
      539         assign
      540           fin-ob-sum      = fin-ob-sum      + buf_fin-ob.sum-contract
      541           fin-ob-sum-rubl = fin-ob-sum-rubl + buf_fin-ob.sum-rubl
      542           fin-ob-sum-base = fin-ob-sum-base + buf_fin-ob.sum-base
      543         .
      544       end.
      545       for each buf_fin-doc no-lock
      546         where buf_fin-doc.host-code     = buf_contract.host-code
      547           and buf_fin-doc.contract-code = buf_contract.contract-code
      548           and buf_fin-doc.status_       = 'факт':U
      549         :
      550         if buf_fin-doc.fin-doc-type = 'ппп':U or buf_fin-doc.fin-doc-type = 'пко':U or buf_fin-doc.fin-doc-type = 'апп':U  then do:
      551           assign
      552             fin-doc-sum      = fin-doc-sum      + buf_fin-doc.sum-contr
      553             fin-doc-sum-rubl = fin-doc-sum-rubl + buf_fin-doc.sum-rubl
      554             fin-doc-sum-base = fin-doc-sum-base + buf_fin-doc.sum-base
      555           .
      556         end.
      557         else do:
      558           assign
      559             fin-doc-sum      = fin-doc-sum      - buf_fin-doc.sum-contr
      560             fin-doc-sum-rubl = fin-doc-sum-rubl - buf_fin-doc.sum-rubl
      561             fin-doc-sum-base = fin-doc-sum-base - buf_fin-doc.sum-base
      562           .
      563         end.
      564       end.
      565       if buf_contract.doc-type = 'при':U then do:
      566         assign
      567           fin-doc-sum      = - fin-doc-sum
      568           fin-doc-sum-rubl = - fin-doc-sum-rubl
      569           fin-doc-sum-base = - fin-doc-sum-base
      570         .
      571       end.
      572       find first contract exclusive-lock where recid(contract) = recid(buf_contract) .
      573       assign
      574         contract.balance-fo        = fin-ob-sum
      575         contract.balance-plat      = fin-doc-sum
      576         contract.balance-fo-rubl   = fin-ob-sum-rubl
      577         contract.balance-plat-rubl = fin-doc-sum-rubl
      578         contract.balance-fo-base   = fin-ob-sum-base
      579         contract.balance-plat-base = fin-doc-sum-base
      580       .
      581       if v-choice = 3 then find first buf_clients no-lock where buf_clients.obj-type = buf_contract.cli-type and buf_clients.obj-code = buf_contract.cli-code  no-error.
      582       if available buf_clients then run writelog ( "cont-bal.log", 0, string("Контрагент: " + buf_clients.obj-type + string(buf_clients.obj-code) + " Договор (вн. №): " + string(buf_contract.contract-code) + " Баланс ФО: " + string(contract.balance-fo) + " Баланс плат.: " + string(contract.balance-plat)) ) .
      583     end.
      584   end procedure.
