      426         ,input v-cntxt-obj-type
      427         ,input v-cntxt-obj-code
      428         ,input 'Ass-obj':U
      429         ,input 'ass-srokiztdel':U
      430         ,output v-value-character
      431         ,output v-value-date
      432         ,output v-value-decimal
      433         ,output v-srok
      434         ,output v-value-logical
      435         ,output v-value-type
      436         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      437         ) no-error .
      438      l-exist-iztdel = false   .
      439      v-kol = 0 .
      440      if not ( v-srok = 0  or v-srok = ? ) then do:
      441      for each buf_assortment-matrix no-lock where
      442               buf_assortment-matrix.asmt-status = 0 and
      443               buf_assortment-matrix.asmt-type = 'Объект':U ,
      444      each buf_assortment-matrix-goods no-lock where
      445           buf_assortment-matrix-goods.asmg-status = 0 and
      446           buf_assortment-matrix-goods.asmt-id = buf_assortment-matrix.asmt-id and
      447           buf_assortment-matrix-goods.db-num  = buf_assortment-matrix.db-num ,
      448          first buf_gds-obj-prop no-lock WHERE
      449                buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code  AND
      450                buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U AND
      451                buf_gds-obj-prop.obj-code = buf_assortment-matrix.obj-code  AND
      452                buf_gds-obj-prop.obj-type = buf_assortment-matrix.obj-type  ,
      453                   EACH buf_gds-obj-prop-attr no-lock WHERE
      454                        buf_gds-obj-prop-attr.gds-code = buf_gds-obj-prop.gds-code AND
      455                        buf_gds-obj-prop-attr.obj-code = buf_gds-obj-prop.obj-code AND
      456                        buf_gds-obj-prop-attr.obj-type = buf_gds-obj-prop.obj-type and
      457                        buf_gds-obj-prop-attr.attr-code = 'CorrIztDel':U
      458                        :
      459               v-date-corr = date(int(substring(buf_gds-obj-prop-attr.attr-value,4,2)) , int(substring(buf_gds-obj-prop-attr.attr-value,1,2)),int(substring(buf_gds-obj-prop-attr.attr-value,7,4))) no-error .
      460               if v-date-corr = ? then v-date-corr = today .
      461               if today - v-date-corr >= v-srok then do:
      462                 v-sts = ? .
      463   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
      464    (input this-procedure
      465    ,input recid(buf_assortment-matrix-goods)
      466    ,input-output v-sts
      467    ,input false
      468     ) no-error .
      469                   v-kol = v-kol + 1.
      470                   find first buf_goods no-lock where
      471                              buf_goods.gds-code = buf_assortment-matrix-goods.gds-code no-error .
      472                   output stream str-err to value( "autodelAM.txt" ) append.
      473                   put    stream str-err unformatted
      474                          string(today , "99/99/9999")     chr(9)
      475                          string(time , "hh:mm:ss")        chr(9)
      476                          buf_assortment-matrix.obj-type
      477                          buf_assortment-matrix.obj-code   chr(9)
      478                          buf_assortment-matrix-goods.gds-code   chr(9)
      479                          string (v-date-corr , "99/99/9999" )   chr(9)
      480                          buf_goods.gds-name  chr(9)
      481                          return-value  chr(9)
      482                          error-status :get-message(1)
      483                          chr(10).
      484                   output stream str-err close.
      485               end.
      486       end.
      487       end.
      488    end.
      489   if v-kol > 0 then do:
      490       run gbl/prnfilen.w
      491         (input  substitute(" Удалены из АМ товары, срок ИЖТ превысил &1 дней" , v-srok)
      492         ,input  0
      493         ,input  "autodelAM.txt"
      494         ,input  7
      495         ,output v-user-action
      496         ,output v-printed
      497         ).
      498   end.
