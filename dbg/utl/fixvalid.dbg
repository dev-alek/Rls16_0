        1   block-level on error undo, throw.
        2   define input parameter p-sources-full-path as character no-undo .
        3   define output parameter p-correct as logical no-undo .
        4   define output parameter p-message as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: fixvalid.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/fixvalid.p $":U .
       10   define variable vss-description as character no-undo init "".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define stream instream.
       70   define variable v-txt-file-list as character no-undo init "~
       71   cmp/fixattrp.txt~
       72   ,cmp/fixdr.txt~
       73   ,cmp/fixrum.txt~
       74   ,cmp/fixcstml.txt~
       75   ,cmp/fix-gate.txt~
       76   ,cmp/fix-lay.txt~
       77   ".
       78   define variable v-ver-file-list as character no-undo init "~
       79   gbl/attrprps.i~
       80   ,gbl/disrules.i~
       81   ,gbl/rumconf.i~
       82   ,gbl/cstmlabs.i~
       83   ,gbl/gateconf.i~
       84   ,gbl/layconf.i~
       85   ".
       86   define variable v-ver-var-list as character no-undo init "~
       87   ap-revision~
       88   ,rule-revision~
       89   ,rum-revision~
       90   ,cl-revision~
       91   ,gate-revision~
       92   ,layout-revision~
       93   ".
       94   define variable v-ver-record-num-list as character no-undo init "~
       95   first~
       96   ,first~
       97   ,last~
       98   ,first~
       99   ,last~
      100   ,last~
      101   ".
      102   define variable v-ver-record-field-list as character no-undo init "~
      103   property-value~
      104   ,des~
      105   ,documentation~
      106   ,custom-tooltip~
      107   ,descr~
      108   ,layout-name~
      109   ".
      110   define variable v-description-list as character no-undo init "~
      111   ÊÎÍÔÈÃÓĞÀÖÈß ÀÒĞÈÁÓÒÎÂ~
      112   ,ÊÎÍÔÈÃÓĞÀÖÈß ÏĞÀÂÈË ÑÊÈÄÎÊ È ĞÀÑÏÈÑÀÍÈÉ~
      113   ,ÊÎÍÔÈÃÓĞÀÖÈß ÌÀØÈÍÛ ÏĞÀÂÈË (RUM)~
      114   ,ÊÎÍÔÈÃÓĞÀÖÈß ÍÀÑÒĞÀÈÂÀÅÌÛÕ ÏÎËÅÉ~
      115   ,ÊÎÍÔÈÃÓĞÀÖÈß ÃÅÉÒÎÂ~
      116   ,ÊÎÍÔÈÃÓĞÀÖÈß ĞÀÑÊËÀÄÎÊ~
      117   ".
      118   define variable ss as character no-undo .
      119   define variable ss1 as character no-undo .
      120   define variable rev-string as character no-undo .
      121   define variable v-ii as integer no-undo .
      122   define variable v-num-rec as integer no-undo .
      123   define variable v-index as integer no-undo .
      124   define variable v-txt-revis as character no-undo .
      125   define variable v-gbl-revis as character no-undo .
      126   define variable v-path-txt as character no-undo .
      127   define variable v-path-gbl as character no-undo .
      128   do v-ii = 1 to num-entries(v-txt-file-list):
      129     rev-string = ''.
      130     v-num-rec = 0.
      131     v-path-txt = p-sources-full-path  + entry(v-ii, v-txt-file-list).
      132     if search(v-path-txt) = ? then do:
      133       return error substitute("Â èñõîäíèêàõ íå íàéäåí ôàéë &1", entry(v-ii, v-txt-file-list)).
      134     end.
      135     v-path-gbl = p-sources-full-path + entry(v-ii, v-ver-file-list).
      136     if search(v-path-gbl) = ? then do:
      137       return error substitute("Â èñõîäíèêàõ íå íàéäåí ôàéë &1", entry(v-ii, v-ver-file-list)).
      138     end.
      139     input stream instream from value(search(v-path-txt)).
      140     _repeat1:
      141     repeat:
      142       import stream instream unformatted ss.
      143       v-num-rec = v-num-rec + 1.
      144       if ss <> '"**END OF PACKET**"' then do:
      145         ss1 = ss.
      146       end.
      147       if entry(v-ii, v-ver-record-num-list) = "first" then do:
      148         if v-num-rec = 2 then leave _repeat1.
      149       end.
      150     end.
      151     input stream instream close.
      152     case entry(v-ii, v-ver-record-num-list):
      153       when "first" then do:
      154         rev-string = ss.
      155       end.
      156       when "last" then do:
      157         rev-string = ss1.
      158       end.
      159     end case.
      160     v-index = index(rev-string, substitute("&2<&3>&2&1"
      161                                           ,chr(32)
      162                                            ,chr(34)
      163                                            ,entry(v-ii, v-ver-record-field-list))).
      164     rev-string = substring(rev-string, v-index).
      165     rev-string = substring(rev-string,
      166                                       length(substitute("&2<&3>&2&1"
      167                                           ,chr(32)
      168                                            ,chr(34)
      169                                            ,entry(v-ii, v-ver-record-field-list))) + 1).
      170     v-txt-revis = entry(2, rev-string, chr(34)).
      171     input stream instream from value(search(v-path-gbl)).
      172     _repeat2:
      173     repeat:
      174       import stream instream unformatted ss.
      175       if index(ss, substitute("&1&2", chr(32), entry(v-ii, v-ver-var-list))) > 0 then do:
      176         v-gbl-revis = trim(trim(trim(entry( num-entries(ss, chr(32)), ss, chr(32)), chr(39)), chr(34)), chr(39)).
      177         leave _repeat2.
      178       end.
      179     end.
      180     input stream instream close.
      181     if v-txt-revis <> v-gbl-revis then do:
      182       p-message = p-message + chr(10) +
      183                   substitute("Íå ñîâïàäàşò âåğñèè äëÿ &1 â ôàéëå &2 è ôàéëå &3&4ÑÂÅĞÜÒÅ ÂÅĞÑÈÈ Ñ VSS!!!!!"
      184                              ,entry(v-ii, v-description-list)
      185                              ,entry(v-ii, v-txt-file-list)
      186                              ,entry(v-ii, v-ver-file-list)
      187                              ,chr(10)).
      188     end.
      189   end.
      190   if trim(p-message, chr(10)) = '':U then do:
      191     p-correct = yes.
      192   end.
