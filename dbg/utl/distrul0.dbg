        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-templ-rl-root as integer no-undo .
        6   define input parameter        p-des as character no-undo .
        7   define input parameter        p-other-inf as character no-undo .
        8   define input parameter        p-uniq-field as character no-undo .
        9   define input parameter        p-value-type as character no-undo .
       10   define input parameter        p-sts as integer no-undo .
       11   define input parameter        p-level-1 as character no-undo .
       12   define input parameter        p-level-2 as character no-undo .
       13   define temp-table tt-drt-prop no-undo like ub.drt-prop
       14   field full-prop-name as character
       15   .
       16   DEFINE INPUT PARAMETER TABLE FOR tt-drt-prop.
       17   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       18   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       19   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile: distrul0.p $":U .
       21   define variable vss-archive     as character no-undo init "$Archive: utl/distrul0.p $":U .
       22   define variable vss-description as character no-undo init "Сохранение записи конфигурации правила скидки".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       94   procedure disrules-fill-properties:
       95   define input  parameter p-templ-rl-root as integer   no-undo .
       96   define buffer buf_drt-prop for ub.drt-prop.
       97   define buffer buf_temp-drt-prop for temp-drt-prop.
       98   do
       99   on error undo, return error return-value
      100   :
      101     for each buf_temp-drt-prop:
      102       delete buf_temp-drt-prop.
      103     end.
      104     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      105       create buf_temp-drt-prop.
      106       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      107     end.
      108   end.
      109   end procedure.
      110   ~
      111   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   define variable v-discnt-role-list as character no-undo .
      113   define variable v-mess as character no-undo .
      114   define variable v-ii as integer no-undo .
      115   define variable v-several-weekday as logical no-undo .
      116   define buffer buf_dis-time-rule for ub.dis-time-rule.
      117   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      118   define buffer buf_file  for ub._file.
      119   define buffer buf_field  for ub._field.
      120   define buffer buf_drt-prop for ub.drt-prop.
      121   if p-mode <> 'ДОБАВЛЕНИЕ':U
      122   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      123     message vss-workfile vss-revision vss-description skip
      124             "Неверный параметр p-mode - " p-mode
      125     view-as alert-box error .
      126     return error '':u.
      127   end.
      128   if g#db-num <> 0 then do:
      129     message vss-workfile vss-revision vss-description skip
      130             "Запрещено вызывать процедуру в УБД"
      131     view-as alert-box error .
      132     return error '':u.
      133   end.
      134   FUNCTION has-several-weekday returns logical ( input p-string as character):
      135   define variable v-first as integer no-undo .
      136   define variable v-last as integer no-undo .
      137   assign
      138   v-first = index(p-string, "week-day":U)
      139   v-last = r-index(p-string, "week-day":U)
      140   .
      141   if v-first > 0
      142   and v-last <> 0
      143   and v-first <> v-last then return yes.
      144   return no.
      145   end function.
      146   _main:
      147   do for buf_dis-time-rule
      148   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      149   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      150   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      151   :
      152     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      153       find first buf_dis-time-rule no-lock where
      154                buf_dis-time-rule.time-rule-num = p-templ-rl-root
      155                  no-error.
      156       if available buf_dis-time-rule then do:
      157         assign
      158         v-mess = "Уже существует такая запись template".
      159         run err-mess in this-procedure ( input-output v-mess).
      160         return error (if p-silent = yes then v-mess else '':U).
      161       end.
      162       if p-templ-rl-root > 99999  then do:
      163         assign
      164         v-mess = substitute("Неверный номер template = &1", p-templ-rl-root).
      165         run err-mess in this-procedure ( input-output v-mess).
      166         return error (if p-silent = yes then v-mess else 'templ-rl-root':U).
      167       end.
      168       create buf_dis-time-rule.
      169       assign
      170       buf_dis-time-rule.templ-rl-root = p-templ-rl-root
      171       buf_dis-time-rule.time-rule-num = p-templ-rl-root
      172       buf_dis-time-rule.rl-root = p-templ-rl-root
      173       buf_dis-time-rule.root = yes
      174       buf_dis-time-rule.is-term = yes
      175       buf_dis-time-rule.lvl-num  = 0
      176       buf_dis-time-rule.sts      = 0
      177       .
      178       create buf_dis-cfg-rule.
      179       assign
      180       buf_dis-cfg-rule.templ-rl-root = 0
      181       buf_dis-cfg-rule.pos-type = '':U
      182       buf_dis-cfg-rule.discnt-role = '':U
      183       buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      184       .
      185     end.
      186     do v-ii = 1 to num-entries(p-value-type):
      187       if lookup(entry(v-ii, p-value-type), '0,1,2,4,8,16':U) = 0 then do:
      188         assign
      189         v-mess = substitute("Неверное значение поля value-type &1", p-value-type).
      190         run err-mess in this-procedure ( input-output v-mess).
      191         return error (if p-silent = yes then v-mess else 'value-type':U).
      192       end.
      193     end.
      194     if p-des = '':U
      195     then do:
      196       assign
      197       v-mess = substitute("Пустое значение поля des &1", p-des).
      198       run err-mess in this-procedure ( input-output v-mess).
      199       return error (if p-silent = yes then v-mess else 'des':U).
      200     end.
      201     if p-sts <> integer('0':U)
      202     and p-sts <> integer('1':U) then do:
      203       assign
      204       v-mess = substitute("Неверное значение поля статус &1", p-sts).
      205       run err-mess in this-procedure ( input-output v-mess).
      206       return error (if p-silent = yes then v-mess else 'sts':U).
      207     end.
      208     if p-uniq-field <> '':U then do:
      209       find first buf_file no-lock where
      210                 buf_file._file-name = 'dis-time-rule':U .
      211       do v-ii = 1 to num-entries(p-uniq-field):
      212         if entry(v-ii, p-uniq-field) = "week-day-a":U
      213         or entry(v-ii, p-uniq-field) = "week-day-b":U
      214         or entry(v-ii, p-uniq-field) = "week-day-c":U
      215         or entry(v-ii, p-uniq-field) = "time-period":U then do:
      216           next.
      217         end.
      218         find first buf_field no-lock where
      219                   buf_field._field-name = entry(v-ii, p-uniq-field)
      220               and buf_field._file-recid = recid(buf_file) no-error .
      221         if not available buf_field then do:
      222           assign
      223           v-mess = substitute("Неверное значение поля uniq &1", p-uniq-field).
      224           run err-mess in this-procedure ( input-output v-mess).
      225           return error (if p-silent = yes then v-mess else 'uniq':U).
      226         end.
      227       end.
      228     end.
      229     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      230       find first buf_dis-time-rule exclusive-lock where
      231               buf_dis-time-rule.time-rule-num = p-templ-rl-root
      232                  no-error.
      233       find first buf_Dis-cfg-rule exclusive-lock where
      234                 buf_Dis-cfg-rule.table-name = '':U
      235             and buf_Dis-cfg-rule.pos-type = '':U
      236             and buf_Dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      237             and buf_dis-cfg-rule.templ-rl-root = 0
      238             and buf_dis-cfg-rule.self-nonunique = '':U
      239             no-error.
      240     end.
      241     assign
      242     v-several-weekday =  has-several-weekday(p-level-1) or has-several-weekday(p-level-2)
      243     .
      244     assign
      245     buf_dis-time-rule.des       = p-des
      246     buf_dis-time-rule.date-from = (if lookup("date-from", p-level-1) > 0
      247                                   or lookup("date-from", p-level-2) > 0
      248                                   then 01/01/1990
      249                                   else 12/31/1989)
      250     buf_dis-time-rule.date-to   = (if lookup("date-to", p-level-1) > 0
      251                                   or lookup("date-to", p-level-2) > 0
      252                                   then 01/01/1990
      253                                   else 12/31/1989)
      254     buf_dis-time-rule.month-day = (if lookup("month-day", p-level-1) > 0
      255                                   or lookup("month-day", p-level-2) > 0
      256                                   then 0
      257                                   else -1)
      258     buf_dis-time-rule.time-from = (if lookup("time-from", p-level-1) > 0
      259                                   or lookup("time-from", p-level-2) > 0
      260                                   then 0
      261                                   else -1)
      262     buf_dis-time-rule.time-to   = (if lookup("time-to", p-level-1) > 0
      263                                   or lookup("time-to", p-level-2) > 0
      264                                   then 86399
      265                                   else -1)
      266     buf_dis-time-rule.week-day-0 = (if lookup("week-day-0", p-level-1) > 0
      267                                   or lookup("week-day-0", p-level-2) > 0
      268                                   then (if v-several-weekday
      269                                         then  false
      270                                         else true)
      271                                   else ?)
      272     buf_dis-time-rule.week-day-1 = (if lookup("week-day-1", p-level-1) > 0
      273                                   or lookup("week-day-1", p-level-2) > 0
      274                                   then (if v-several-weekday
      275                                         then  false
      276                                         else true)
      277                                                                   else ?)
      278     buf_dis-time-rule.week-day-2 = (if lookup("week-day-2", p-level-1) > 0
      279                                   or lookup("week-day-2", p-level-2) > 0
      280                                   then (if v-several-weekday
      281                                         then  false
      282                                         else true)
      283                                   else ?)
      284     buf_dis-time-rule.week-day-3 = (if lookup("week-day-3", p-level-1) > 0
      285                                   or lookup("week-day-3", p-level-2) > 0
      286                                   then (if v-several-weekday
      287                                         then  false
      288                                         else true)
      289                                   else ?)
      290     buf_dis-time-rule.week-day-4 = (if lookup("week-day-4", p-level-1) > 0
      291                                   or lookup("week-day-4", p-level-2) > 0
      292                                   then (if v-several-weekday
      293                                         then  false
      294                                         else true)
      295                                   else ?)
      296     buf_dis-time-rule.week-day-5 = (if lookup("week-day-5", p-level-1) > 0
      297                                   or lookup("week-day-5", p-level-2) > 0
      298                                   then (if v-several-weekday
      299                                         then  false
      300                                         else true)
      301                                   else ?)
      302     buf_dis-time-rule.week-day-6 = (if lookup("week-day-6", p-level-1) > 0
      303                                   or lookup("week-day-6", p-level-2) > 0
      304                                   then (if v-several-weekday
      305                                         then  false
      306                                         else true)
      307                                   else ?)
      308     buf_dis-time-rule.week-day-7 = (if lookup("week-day-7", p-level-1) > 0
      309                                   or lookup("week-day-7", p-level-2) > 0
      310                                   then (if v-several-weekday
      311                                         then  false
      312                                         else true)
      313                                   else ?)
      314     buf_dis-time-rule.other-inf   = p-other-inf
      315     buf_dis-time-rule.uniq-field   = p-uniq-field
      316     buf_dis-time-rule.value-type   = p-value-type
      317     buf_dis-time-rule.sts          = p-sts
      318     buf_dis-cfg-rule.other-inf = (p-level-1 + ";":U + p-level-2)
      319     p-rec = recid(buf_dis-time-rule)
      320     .
      321     release buf_dis-time-rule no-error.
      322     if error-status:error then do:
      323       assign
      324       v-mess = substitute("Ошибка при сохранении записи правила скидки &1&2&3"
      325                          , error-status:get-message(1)
      326                          , chr(10)
      327                          , return-value
      328                          ).
      329       run err-mess in this-procedure ( input-output v-mess).
      330       return error (if p-silent = yes then v-mess else '':U).
      331     end.
      332     for each tt-drt-prop
      333     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      334     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      335     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      336     :
      337       if tt-drt-prop.prop-code = '':u then next.
      338       find first buf_drt-prop where
      339                 buf_drt-prop.templ-rl-root = tt-drt-prop.templ-rl-root
      340             and buf_drt-prop.node-code = tt-drt-prop.node-code no-error .
      341       if not available buf_drt-prop then do:
      342          create buf_drt-prop.
      343          assign
      344          buf_drt-prop.templ-rl-root = tt-drt-prop.templ-rl-root
      345          buf_drt-prop.prop-code = tt-drt-prop.prop-code
      346          buf_drt-prop.upper-prop-code = tt-drt-prop.upper-prop-code
      347          buf_drt-prop.node-code = tt-drt-prop.node-code
      348          buf_drt-prop.upper-node-code = tt-drt-prop.upper-node-code no-error .
      349          .
      350       end.
      351       assign
      352       buf_drt-prop.property-value = tt-drt-prop.property-value.
      353     end.
      354     for each buf_drt-prop
      355     where buf_drt-prop.templ-rl-root = p-templ-rl-root
      356     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      357     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      358     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      359     :
      360       find first tt-drt-prop where
      361                 tt-drt-prop.templ-rl-root = buf_drt-prop.templ-rl-root
      362             and tt-drt-prop.node-code = buf_drt-prop.node-code  no-error .
      363       if not available tt-drt-prop then do:
      364         delete buf_drt-prop.
      365       end.
      366     end.
      367   end.
      368   PROCEDURE err-mess:
      369     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      370     CASE p-silent:
      371       when yes then do:
      372         assign
      373         p-mess = substitute("Запись template правил расписаний:&1" +
      374                             "Шаблон расписания &2&1&3"
      375                             ,chr(10)
      376                             ,p-templ-rl-root
      377                             ,p-mess).
      378       end.
      379       when no then do:
      380         message
      381         p-mess
      382         view-as alert-box error .
      383       end.
      384     end.
      385   END PROCEDURE.
