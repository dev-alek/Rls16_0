        1   block-level on error undo, throw.
        2   DEFINE TEMP-TABLE x_parts LIKE ub.parts.
        3   define input  parameter ParParentProc as handle no-undo .
        4   define input  parameter p-doc-code as character no-undo .
        5   define input  parameter table for x_parts.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: 2014/01/27 14:27:46 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: trnfactb.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/trnfactb.p $":U .
       11   define variable vss-description as character no-undo init "Корректировка партий внешнего прихода закрытого на факт".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure partrqst :
       83     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
       84     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
       85     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
       86     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
       87     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
       88     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
       89     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
       90     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
       91     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
       92     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
       93     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
       94     define output parameter p-total-parts-price-base     as decimal                 no-undo .
       95     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
       96     define output parameter p-total-parts-transport-base as decimal                 no-undo .
       97     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
       98     define output parameter p-total-parts-other-base     as decimal                 no-undo .
       99     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
      100     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
      101     do
      102     on error undo, return error return-value
      103     :
      104       assign
      105         p-total-parts-qnty           = 0
      106         p-total-parts-fact-qnty      = 0
      107         p-total-parts-cli-qnty       = 0
      108         p-total-parts-fact-cli-qnty  = 0
      109         p-total-parts-price-cli      = 0
      110         p-total-parts-price-base     = 0
      111         p-total-parts-price-rubl     = 0
      112         p-total-parts-transport-base = 0
      113         p-total-parts-transport-rubl = 0
      114         p-total-parts-other-base     = 0
      115         p-total-parts-other-rubl     = 0
      116       .
      117       define buffer buf_parts for ub.parts .
      118       for each buf_parts no-lock
      119         where buf_parts.out-code  = p-doc-code
      120           and buf_parts.obj-type  = p-obj-type
      121           and buf_parts.obj-code  = p-obj-code
      122           and buf_parts.artic     = p-artic
      123           and buf_parts.prod-type = p-prod-type
      124           and buf_parts.prod-code = p-prod-code
      125       on error undo, return error return-value
      126       :
      127         define variable v-parts-fact-multiplier as decimal   no-undo .
      128         assign
      129           v-parts-fact-multiplier = 1
      130         .
      131         if buf_parts.qnty <> 0 then do:
      132           assign
      133             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      134           .
      135         end.
      136         assign
      137           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      138           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      139           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      140           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      141                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      142           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      143           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      144           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      145           p-total-parts-transport-base  = p-total-parts-transport-base
      146                                         + buf_parts.fact-qnty
      147                                           * (if   buf_parts.transport-base <> ?
      148                                             then buf_parts.transport-base
      149                                             else 0
      150                                             )
      151           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      152                                         + buf_parts.fact-qnty
      153                                           * (if   buf_parts.transport-rubl <> ?
      154                                             then buf_parts.transport-rubl
      155                                             else 0
      156                                             )
      157           p-total-parts-other-base      = p-total-parts-other-base
      158                                         + buf_parts.fact-qnty
      159                                           * (if   buf_parts.other-base <> ?
      160                                             then buf_parts.other-base
      161                                             else 0
      162                                             )
      163           p-total-parts-other-rubl      = p-total-parts-other-rubl
      164                                         + buf_parts.fact-qnty
      165                                           * (if   buf_parts.other-rubl <> ?
      166                                             then buf_parts.other-rubl
      167                                             else 0
      168                                             )
      169         .
      170       end.
      171     end.
      172   end procedure.
      173   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   procedure gdsobjcl :
      175     define input parameter p-gds-obj-recid    as recid no-undo .
      176     define input parameter p-update-fact-qnty as logical   no-undo .
      177     define variable vss-description as character no-undo init "$Workfile$ gdsobjcl: расчет записи товар на объекте ".
      178     define buffer buf_parts for ub.parts .
      179     define variable v-total-avrg-base as decimal no-undo .
      180     define variable v-total-avrg-rubl as decimal no-undo .
      181     define variable v-total-avrg-qnty as decimal no-undo .
      182     define variable v-parts-avrg-qnty as decimal no-undo .
      183     define variable v-total-fact-base as decimal no-undo .
      184     define variable v-total-fact-rubl as decimal no-undo .
      185     define variable v-total-fact-qnty as decimal no-undo .
      186     define variable v-parts-fact-qnty as decimal   no-undo .
      187     define buffer buf_gds-obj for ub.gds-obj .
      188     define buffer buf_prt-obj for ub.prt-obj .
      189     define buffer buf_gds-prt for ub.gds-prt .
      190     do
      191     on error undo, return error return-value
      192     :
      193       find first buf_gds-obj exclusive-lock
      194         where recid(buf_gds-obj) = p-gds-obj-recid
      195         no-error .
      196       if not available buf_gds-obj
      197       then do:
      198         message
      199           vss-workfile vss-revision vss-description skip
      200           "Ошибка задания входных параметров" skip
      201           "Не найдена запись товар на объекте" skip
      202           "Код записи (recid)" p-gds-obj-recid skip
      203           view-as alert-box error .
      204         undo, return error return-value .
      205       end.
      206       assign
      207         v-total-avrg-base = 0
      208         v-total-avrg-rubl = 0
      209         v-total-avrg-qnty = 0
      210         v-total-fact-base = 0
      211         v-total-fact-rubl = 0
      212         v-total-fact-qnty = 0
      213       .
      214       for each buf_parts no-lock
      215         where buf_parts.obj-type  = buf_gds-obj.obj-type
      216           and buf_parts.obj-code  = buf_gds-obj.obj-code
      217           and buf_parts.artic     = buf_gds-obj.artic
      218           and buf_parts.prod-type = buf_gds-obj.prod-type
      219           and buf_parts.prod-code = buf_gds-obj.prod-code
      220           and buf_parts.status_   = no
      221           and buf_parts.rsrv-free = yes
      222           and buf_parts.in-code   <> buf_parts.out-code
      223           and buf_parts.doc-type  <> 'акт':U
      224       on error undo, return error return-value
      225       :
      226         assign
      227           v-parts-avrg-qnty = 0
      228           v-parts-fact-qnty = 0
      229         .
      230         if buf_parts.out-code = 'free-zone':U
      231         then do:
      232           if buf_parts.fact-qnty > 0
      233           then do:
      234             assign
      235               v-parts-avrg-qnty = buf_parts.qnty
      236             .
      237           end.
      238           assign
      239             v-parts-fact-qnty = buf_parts.qnty
      240           .
      241         end.
      242         else do:
      243           assign
      244             v-parts-avrg-qnty = abs(buf_parts.qnty)
      245             v-parts-fact-qnty = abs(buf_parts.qnty)
      246           .
      247         end.
      248         assign
      249           v-total-avrg-base = v-total-avrg-base
      250                             + (buf_parts.price-base * v-parts-avrg-qnty)
      251           v-total-avrg-rubl = v-total-avrg-rubl
      252                             + (buf_parts.price-rubl * v-parts-avrg-qnty)
      253           v-total-avrg-qnty = v-total-avrg-qnty
      254                             + v-parts-avrg-qnty
      255           v-total-fact-base = v-total-fact-base
      256                             + (buf_parts.price-base * v-parts-fact-qnty)
      257           v-total-fact-rubl = v-total-fact-rubl
      258                             + (buf_parts.price-rubl * v-parts-fact-qnty)
      259           v-total-fact-qnty = v-total-fact-qnty
      260                             + v-parts-fact-qnty
      261         .
      262       end.
      263       if v-total-avrg-qnty < 0
      264       or v-total-avrg-qnty = ?
      265       then do:
      266         undo, return error
      267           vss-description + chr(10)
      268           + "Количество положительных партий в свободной зоне не может быть отрицательным или неопределенным" + chr(10)
      269           + "v-total-avrg-qnty " + (if v-total-avrg-qnty <> ? then string(v-total-avrg-qnty) else "?")
      270           .
      271       end.
      272       if v-total-fact-base = ?
      273       or v-total-fact-rubl = ?
      274       then do:
      275         undo, return error
      276           vss-description + chr(10)
      277           + "Сумма учетных цен по товару на объекте не может иметь неопределенное значение" + chr(10)
      278           + "v-total-fact-base " + (if v-total-fact-base <> ? then string(v-total-fact-base) else "?") + chr(10)
      279           + "v-total-fact-rubl " + (if v-total-fact-rubl <> ? then string(v-total-fact-rubl) else "?") + chr(10)
      280           .
      281       end.
      282       assign
      283         buf_gds-obj.avrg-qnty = v-total-avrg-qnty
      284         buf_gds-obj.fact-base = v-total-fact-base
      285         buf_gds-obj.fact-rubl = v-total-fact-rubl
      286       .
      287       if p-update-fact-qnty
      288       then do:
      289         message
      290           vss-workfile vss-revision vss-description skip
      291           "Ошибка задания входных параметров"
      292           "В данной версии обновление фактического количества не реализовано" skip
      293           "p-update-fact-qnty" p-update-fact-qnty skip
      294           view-as alert-box error .
      295         undo, return error return-value .
      296       end.
      297       if buf_gds-obj.fact-qnty <> v-total-fact-qnty
      298       then do:
      299         undo, return error
      300           vss-description + chr(10)
      301           + "Не совпадает общее количество по партиям и фактическое количество по товару на объекте" + chr(10)
      302           + "buf_gds-obj.fact-qnty " + (if buf_gds-obj.fact-qnty <> ? then string(buf_gds-obj.fact-qnty) else "?") + chr(10)
      303           + "v-total-fact-qnty "     + (if v-total-fact-qnty     <> ? then string(v-total-fact-qnty)     else "?") + chr(10)
      304           .
      305       end.
      306       if v-total-avrg-qnty > 0
      307       then do:
      308         assign
      309           buf_gds-obj.avrg-base = v-total-avrg-base / v-total-avrg-qnty
      310           buf_gds-obj.avrg-rubl = v-total-avrg-rubl / v-total-avrg-qnty
      311         .
      312       end.
      313       else do:
      314         if  buf_gds-obj.last-base > 0
      315         and buf_gds-obj.last-rubl > 0
      316         then do:
      317           assign
      318             buf_gds-obj.avrg-base = buf_gds-obj.last-base
      319             buf_gds-obj.avrg-rubl = buf_gds-obj.last-rubl
      320           .
      321         end.
      322       end.
      323       define variable v-total-sale-fact-qnty as decimal   no-undo .
      324       define variable v-total-fact-sale      as decimal   no-undo .
      325       assign
      326         v-total-sale-fact-qnty = 0
      327         v-total-fact-sale      = 0
      328       .
      329       for each buf_prt-obj
      330         where buf_prt-obj.obj-type  = buf_gds-obj.obj-type
      331           and buf_prt-obj.obj-code  = buf_gds-obj.obj-code
      332           and buf_prt-obj.artic     = buf_gds-obj.artic
      333           and buf_prt-obj.prod-type = buf_gds-obj.prod-type
      334           and buf_prt-obj.prod-code = buf_gds-obj.prod-code
      335           and buf_prt-obj.is-term   = true
      336       on error undo, return error return-value
      337       :
      338         assign
      339           v-total-sale-fact-qnty  = v-total-sale-fact-qnty
      340                                   + buf_prt-obj.fact-qnty
      341           v-total-fact-sale       = v-total-fact-sale
      342                                   + buf_prt-obj.fact-qnty * buf_prt-obj.price-sale
      343         .
      344       end.
      345       if v-total-fact-sale = ?
      346       then do:
      347         undo, return error
      348           vss-description + chr(10)
      349           + "Сумма продажных цен по товару на объекте не может иметь неопределенное значение" + chr(10)
      350           + "v-total-fact-sale " + (if v-total-fact-sale <> ? then string(v-total-fact-sale) else "?") + chr(10)
      351           .
      352       end.
      353       if buf_gds-obj.fact-qnty <> v-total-sale-fact-qnty
      354       then do:
      355         undo, return error
      356           vss-description + chr(10)
      357           + "Не совпадает общее количество по признакам и фактическое количество по товару на объекте" + chr(10)
      358           + "buf_gds-obj.fact-qnty "  + (if buf_gds-obj.fact-qnty <> ?  then string(buf_gds-obj.fact-qnty)  else "?") + chr(10)
      359           + "v-total-sale-fact-qnty " + (if v-total-sale-fact-qnty <> ? then string(v-total-sale-fact-qnty) else "?") + chr(10)
      360           .
      361       end.
      362       assign
      363         buf_gds-obj.fact-sale = v-total-fact-sale
      364       .
      365     end.
      366   end procedure .
      367   procedure gdsobjcl-calc-goods :
      368     define input parameter p-artic     like ub.goods.artic     no-undo .
      369     define input parameter p-prod-type like ub.goods.prod-type no-undo .
      370     define input parameter p-prod-code like ub.goods.prod-code no-undo .
      371     define variable vss-description as character no-undo init "$Workfile$ gdsobjcl-calc-goods".
      372     do
      373     on error undo, return error return-value
      374     :
      375       define buffer buf_gds-obj for ub.gds-obj .
      376       define buffer buf_prt-obj for ub.prt-obj .
      377       do
      378       on error undo, return error return-value
      379       :
      380         for each buf_prt-obj
      381           where buf_prt-obj.artic     = p-artic
      382             and buf_prt-obj.prod-type = p-prod-type
      383             and buf_prt-obj.prod-code = p-prod-code
      384         on error undo, return error return-value
      385         :
      386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjup in g#library
      387     (buffer buf_prt-obj
      388     ) no-error .
      389           if error-status :error
      390           then do:
      391             undo, return error
      392               "объект "  + string(buf_prt-obj.obj-type) + " " + string(buf_prt-obj.obj-code) + chr(10)
      393               + "артикул " + string(buf_prt-obj.artic) + " " + string(buf_prt-obj.prod-type) + " " + string(buf_prt-obj.prod-code) + chr(10)
      394               + "признак " + string(buf_prt-obj.prt-code) + chr(10)
      395               + return-value .
      396           end.
      397         end.
      398         for each buf_gds-obj
      399           where buf_gds-obj.artic     = p-artic
      400             and buf_gds-obj.prod-type = p-prod-type
      401             and buf_gds-obj.prod-code = p-prod-code
      402         on error undo, return error return-value
      403         :
      404           run gdsobjcl in this-procedure
      405             (input recid(buf_gds-obj)
      406             ,input false
      407             ) no-error .
      408           if error-status :error
      409           then do:
      410             undo, return error
      411               "объект " + string(buf_gds-obj.obj-type) + " " + string(buf_gds-obj.obj-code) + chr(10)
      412               + return-value .
      413           end.
      414         end.
      415       end.
      416     end.
      417   end procedure.
      418       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      419       define buffer   in-vatp-parts    for ub.parts   .
      420       define buffer   in-vatp-doc      for ub.trn-doc .
      421       define buffer   in-vatp-goods    for ub.goods   .
      422       define buffer   in-vatp-sysconf  for ub.sysconf .
      423       define buffer   in-vatp_doc-attr for ub.doc-attr.
      424       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      425       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      426       define variable varinvprb                  as   character              no-undo.
      427       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      428       define variable cli-base-rate              as   decimal                no-undo.
      429       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      430       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      431       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      432       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      433       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      434       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      435       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      436       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      437       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      438       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      439       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      440       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      441       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      442       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      443       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      444       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      445       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      446       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      447       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      448       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      449       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      450       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      451       define variable varinvatp-envd             as   character              no-undo.
      452       define variable varinvatp-type             as   character              no-undo.
      453   define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
      454   define buffer buf_trn-doc    for ub.trn-doc  .
      455   define buffer oth_trn-doc    for ub.trn-doc  .
      456   define buffer buf_doc-line   for ub.doc-line .
      457   define buffer buf_parts      for ub.parts    .
      458   define buffer all_parts      for ub.parts    .
      459   define buffer free_parts     for ub.parts    .
      460   define buffer buf_parts-attr for ub.parts-attr  .
      461   define buffer buf_goods      for ub.goods   .
      462   define variable v-doc-line-VAT-pc   as decimal   no-undo .
      463   define variable v-rash-cli          as decimal   no-undo .
      464   define variable v-rash-qnty         as decimal   no-undo .
      465   define variable v-delta-qnty        as decimal   no-undo .
      466   define variable v-delta-cli-qnty    as decimal   no-undo .
      467   define variable v-root-node         like ub.gds-prt.node-code no-undo .
      468   find first buf_trn-doc exclusive-lock where
      469              buf_trn-doc.doc-code = p-doc-code
      470              no-error .
      471   if available buf_trn-doc then
      472       run str/trn-hist.p
      473           ( buffer buf_trn-doc ,
      474             input  buf_trn-doc.obj-type ,
      475             input  buf_trn-doc.obj-code ,
      476             input  "Корр. закрытого на ФАКТ"
      477           ) .
      478   do :
      479   for each x_parts break by x_parts.prod-type
      480                          by x_parts.prod-code
      481                          by x_parts.artic
      482                          :
      483     find first buf_goods no-lock where
      484                buf_goods.artic      = x_parts.artic     and
      485                buf_goods.prod-type  = x_parts.prod-type and
      486                buf_goods.prod-code  = x_parts.prod-code no-error .
      487       find first free_parts exclusive-lock where
      488                  free_parts.obj-type   = x_parts.obj-type  and
      489                  free_parts.obj-code   = x_parts.obj-code  and
      490                  free_parts.out-code   = 'free-zone':U      and
      491                  free_parts.part-code  = x_parts.part-code and
      492                  free_parts.in-code    = x_parts.in-code   and
      493                  free_parts.artic      = x_parts.artic     and
      494                  free_parts.prod-type  = x_parts.prod-type and
      495                  free_parts.prod-code  = x_parts.prod-code
      496                  no-error .
      497          if available free_parts then do:
      498            run calc-rash-part in this-procedure (
      499               input  x_parts.artic    ,
      500               input  x_parts.prod-type,
      501               input  x_parts.prod-code,
      502               input  x_parts.obj-type ,
      503               input  x_parts.obj-code ,
      504               input  x_parts.in-code  ,
      505               input  x_parts.part-code  ,
      506               output v-rash-cli ,
      507               output v-rash-qnty
      508               ) .
      509            assign
      510              free_parts.cli-qnty   = x_parts.cli-qnty  - v-rash-cli
      511              free_parts.qnty       = x_parts.qnty      - v-rash-qnty
      512              free_parts.fact-qnty  = x_parts.fact-qnty - v-rash-qnty
      513            .
      514          end.
      515          else do:
      516          end.
      517       find first buf_parts exclusive-lock where
      518                  buf_parts.obj-type   = x_parts.obj-type  and
      519                  buf_parts.obj-code   = x_parts.obj-code  and
      520                  buf_parts.out-code   = x_parts.out-code  and
      521                  buf_parts.part-code  = x_parts.part-code and
      522                  buf_parts.in-code    = x_parts.in-code   and
      523                  buf_parts.artic      = x_parts.artic     and
      524                  buf_parts.prod-type  = x_parts.prod-type and
      525                  buf_parts.prod-code  = x_parts.prod-code
      526                  no-error .
      527       If available buf_parts then  do:
      528          buffer-copy x_parts to buf_parts .
      529       end.
      530       for each  buf_parts-attr exclusive-lock where
      531                 buf_parts-attr.gds-code   = buf_goods.gds-code and
      532                 buf_parts-attr.in-code    = x_parts.in-code and
      533                 buf_parts-attr.part-code  = x_parts.part-code :
      534           assign
      535             buf_parts-attr.alc-bottling-date       = x_parts.alc-bottling-date
      536             buf_parts-attr.alc-certif-path         = x_parts.alc-certif-path
      537             buf_parts-attr.alc-quality-certif-path = x_parts.alc-quality-certif-path
      538             buf_parts-attr.alc-ref-ab-path         = x_parts.alc-ref-ab-path
      539             buf_parts-attr.cli-qnty                = x_parts.cli-qnty
      540             buf_parts-attr.cst-code                = x_parts.cst-code
      541             buf_parts-attr.doc-qnty                = x_parts.qnty
      542             buf_parts-attr.fact-qnty               = x_parts.fact-qnty
      543             buf_parts-attr.last-date               = x_parts.last-date
      544             buf_parts-attr.mark-code               = x_parts.mark-code
      545             buf_parts-attr.mark-db-num             = x_parts.mark-db-num
      546             buf_parts-attr.price-base              = x_parts.price-base
      547             buf_parts-attr.price-cli               = x_parts.price-cli
      548             buf_parts-attr.price-rubl              = x_parts.price-rubl
      549             buf_parts-attr.road-tax-base           = x_parts.road-tax-base
      550             buf_parts-attr.road-tax-rubl           = x_parts.road-tax-rubl
      551             buf_parts-attr.transport-base          = x_parts.transport-base
      552             buf_parts-attr.transport-rubl          = x_parts.transport-rubl
      553             buf_parts-attr.vat-pc                  = x_parts.vat-pc
      554             .
      555             v-doc-line-VAT-pc =  x_parts.vat-pc .
      556   assign
      557     price-rubl-with-tax-loc = x_parts.price-rubl
      558     price-base-with-tax-loc = x_parts.price-base
      559   .
      560   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      562     (output varinvprb
      563     )  .
      564     if x_parts.out-code = 'free-zone':U     or
      565        x_parts.out-code = 'out-zone':U   or
      566        x_parts.doc-type = 'акт':U then do:
      567       assign
      568         in-vatp-have-vat-slt = yes.
      569     end.
      570     else do:
      571       find first in-vatp_doc-attr no-lock
      572         where in-vatp_doc-attr.doc-code  = x_parts.out-code
      573           and in-vatp_doc-attr.attr-code = 'envd':U
      574         no-error .
      575       if not available in-vatp_doc-attr then do:
      576         assign
      577           in-vatp-have-vat-slt = yes.
      578       end.
      579       else do:
      580            in-vatp-have-vat-slt = no.
      581       end.
      582     end.
      583     assign
      584      price-cli-with-tax-loc = x_parts.price-cli
      585      cli-base-rate          = x_parts.cli-base-rate.
      586     ASSIGN   road-tax-base-loc  = (if x_parts.road-tax-base  = ? then 0 else x_parts.road-tax-base)
      587              road-tax-rubl-loc  = (if x_parts.road-tax-rubl  = ? then 0 else x_parts.road-tax-rubl).
      588     ASSIGN  transport-base-loc = (if x_parts.transport-base = ? then 0 else x_parts.transport-base)
      589             transport-rubl-loc = (if x_parts.transport-rubl = ? then 0 else x_parts.transport-rubl)
      590             other-base-loc     = (if x_parts.other-base     = ? then 0 else x_parts.other-base)
      591             other-rubl-loc     = (if x_parts.other-rubl     = ? then 0 else x_parts.other-rubl)
      592             vat-pc-loc         = (if x_parts.vat-pc         = ? then 0 else x_parts.vat-pc)
      593             slt-pc-loc         = (if x_parts.slt-pc         = ? then 0 else x_parts.slt-pc).
      594             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      595       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      596     assign
      597       exch-rate-cli-loc = (x_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if x_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if x_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / x_parts.price-cli .
      598     assign
      599       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      600       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      601       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      602       transport-cli-loc  = 0
      603       other-cli-loc      = 0
      604     .
      605   ASSIGN
      606             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      607       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      608   .
      609             assign
      610               buf_parts-attr.vat-base     = vat-base-loc
      611               buf_parts-attr.vat-rubl     = vat-rubl-loc
      612               buf_parts-attr.slt-base     = slt-base-loc
      613               buf_parts-attr.slt-rubl     = slt-rubl-loc
      614               buf_parts-attr.discnt-base  = 0
      615               buf_parts-attr.discnt-rubl  = 0
      616             .
      617       end.
      618       for each all_parts exclusive-lock where
      619                all_parts.artic     = x_parts.artic      and
      620                all_parts.prod-type = x_parts.prod-type  and
      621                all_parts.prod-code = x_parts.prod-code  and
      622                all_parts.in-code   = p-doc-code and
      623                all_parts.out-code  <> x_parts.out-code
      624                :
      625        assign
      626           all_parts.price-cli  = x_parts.price-cli
      627           all_parts.price-base = x_parts.price-base
      628           all_parts.price-rubl = x_parts.price-rubl
      629           all_parts.vat-pc     = x_parts.vat-pc
      630           all_parts.cst-code   = x_parts.cst-code
      631           all_parts.last-date  = x_parts.last-date
      632        .
      633       end.
      634       if last-of(x_parts.artic) then do:
      635           find first buf_doc-line exclusive-lock where
      636                      buf_doc-line.doc-code  = p-doc-code and
      637                      buf_doc-line.artic     = x_parts.artic     and
      638                      buf_doc-line.prod-type = x_parts.prod-type and
      639                      buf_doc-line.prod-code = x_parts.prod-code
      640                      no-error .
      641           if available buf_doc-line then do:
      642           run partrqst in this-procedure
      643             (input  buf_doc-line.doc-code
      644             ,input  buf_doc-line.obj-type
      645             ,input  buf_doc-line.obj-code
      646             ,input  buf_doc-line.artic
      647             ,input  buf_doc-line.prod-type
      648             ,input  buf_doc-line.prod-code
      649                       ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
      650             ).
      651           assign
      652             buf_doc-line.price-cli  = v-total-parts-price-cli / v-total-parts-cli-qnty
      653             buf_doc-line.doc-qnty   = v-total-parts-qnty
      654             buf_doc-line.fact-qnty  = v-total-parts-fact-qnty
      655             buf_doc-line.cli-qnty   = v-total-parts-cli-qnty
      656             buf_doc-line.price-base = v-total-parts-price-base   / v-total-parts-fact-qnty
      657             buf_doc-line.price-rubl = v-total-parts-price-rubl   / v-total-parts-fact-qnty
      658             buf_doc-line.transport-base  = v-total-parts-transport-base / v-total-parts-fact-qnty
      659             buf_doc-line.transport-rubl  = v-total-parts-transport-rubl / v-total-parts-fact-qnty
      660             buf_doc-line.other-base      = v-total-parts-other-base     / v-total-parts-fact-qnty
      661             buf_doc-line.other-rubl      = v-total-parts-other-rubl     / v-total-parts-fact-qnty
      662             buf_doc-line.vat-pc          = vat-pc-loc
      663           .
      664            find first ub.gds-obj exclusive-lock where
      665                       ub.gds-obj.gds-code = buf_goods.gds-code and
      666                       ub.gds-obj.obj-code = buf_doc-line.obj-code and
      667                       ub.gds-obj.obj-type = buf_doc-line.obj-type no-error .
      668           if available ub.gds-obj then do :
      669             run utl/par2gds.p (
      670                 input ub.gds-obj.artic,
      671                 input ub.gds-obj.prod-type,
      672                 input ub.gds-obj.prod-code,
      673                 input ub.gds-obj.obj-type,
      674                 input ub.gds-obj.obj-code
      675                 ) .
      676               run gdsobjcl in this-procedure (recid(ub.gds-obj), false ).
      677           end.
      678          end.
      679       end.
      680       find first oth_trn-doc no-lock where
      681                  oth_trn-doc.doc-code = buf_parts.out-code no-error .
      682       if available oth_trn-doc and oth_trn-doc.status_ = 'факт':U then do:
      683           run str/calc-hd.p (input oth_trn-doc.doc-code) .
      684           run str/vtrecalc.p ( input parparentproc , input recid (oth_trn-doc)).
      685            find first ub.gds-obj exclusive-lock where
      686                       ub.gds-obj.gds-code = buf_goods.gds-code and
      687                       ub.gds-obj.obj-code = oth_trn-doc.obj-code and
      688                       ub.gds-obj.obj-type = oth_trn-doc.obj-type no-error .
      689           if available ub.gds-obj then run gdsobjcl in this-procedure (recid(ub.gds-obj), false ).
      690           run trg/markdoc.p
      691             ( input oth_trn-doc.doc-code
      692              ,input 'doc-change':u
      693             ) .
      694           find current oth_trn-doc exclusive-lock .
      695                        oth_trn-doc.bge-date = ? .
      696       end.
      697   end.
      698   if available buf_trn-doc then do:
      699       run str/calc-hd.p  ( input buf_trn-doc.doc-code ) .
      700       run str/vtrecalc.p ( input parparentproc , input recid (buf_trn-doc) ).
      701       run trg/markdoc.p
      702         ( input buf_trn-doc.doc-code
      703         , input 'doc-change':u
      704         ) .
      705       find current buf_trn-doc exclusive-lock .
      706                    buf_trn-doc.bge-date = ? .
      707   end.
      708   define variable v-remote-db-list as character no-undo .
      709   define buffer buf_db for ub.db  .
      710     v-remote-db-list = "":U .
      711     for each buf_db where buf_db.db-num > 0 no-lock :
      712       assign
      713         v-remote-db-list = (if v-remote-db-list <> "":U then v-remote-db-list + chr(1)
      714                                                         else ""
      715                             ) + string(buf_db.db-num)
      716       .
      717     end.
      718    if ( g#db-num > 0 and g#news = false ) or g#db-num = 0 then do:
      719           run trg/cmd-corr.p
      720             ( input p-doc-code ,
      721               input table x_parts ,
      722               input 'cmd-parts-fact-corr':U ,
      723               input ( if g#db-num = 0 then v-remote-db-list else "0" )
      724               ) .
      725    end.
      726   end.
      727   procedure calc-rash-part :
      728   define input  parameter p-artic       as character no-undo .
      729   define input  parameter p-prod-type   as character no-undo .
      730   define input  parameter p-prod-code   as integer   no-undo .
      731   define input  parameter p-obj-type    as character no-undo .
      732   define input  parameter p-obj-code    as integer   no-undo .
      733   define input  parameter p-in-code     as character no-undo .
      734   define input  parameter p-part-code   as character no-undo .
      735   define output parameter p-rash-cli    as decimal   no-undo .
      736   define output parameter p-rash-qnty   as decimal   no-undo .
      737   define buffer r_parts   for ub.parts  .
      738   define buffer rez_parts for ub.parts  .
      739     do
      740     on error undo, return error return-value
      741     :
      742     p-rash-cli  = 0 .
      743     p-rash-qnty = 0 .
      744     for each r_parts no-lock where
      745              r_parts.artic      =  p-artic and
      746              r_parts.prod-type  =  p-prod-type and
      747              r_parts.prod-code  =  p-prod-code and
      748              r_parts.obj-type   =  p-obj-type  and
      749              r_parts.obj-code   =  p-obj-code  and
      750              r_parts.part-code  =  p-part-code  and
      751              r_parts.out-code   = 'out-zone':U and
      752              r_parts.rsrv-free  = no :
      753         assign
      754           p-rash-cli  = p-rash-cli  + r_parts.cli-qnty
      755           p-rash-qnty = p-rash-qnty + r_parts.fact-qnty
      756         .
      757     end.
      758     for each rez_parts no-lock where
      759             rez_parts.artic       =  p-artic      and
      760             rez_parts.prod-type   =  p-prod-type  and
      761             rez_parts.prod-code   =  p-prod-code  and
      762             rez_parts.part-code   =  p-part-code  and
      763             rez_parts.in-code     =  p-in-code    and
      764             rez_parts.out-code    <> p-in-code    and
      765             rez_parts.out-code    <> 'free-zone':U and
      766             rez_parts.status_     =  false        and
      767             rez_parts.rsrv-free   =  true
      768             :
      769             assign
      770                 p-rash-cli  = p-rash-cli  + rez_parts.cli-qnty
      771                 p-rash-qnty = p-rash-qnty + rez_parts.fact-qnty
      772               .
      773       end.
      774    end.
      775   end procedure.
