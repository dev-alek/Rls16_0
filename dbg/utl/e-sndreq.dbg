      574   define variable var-report-r-b as character no-undo .
      575   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      576   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      577     (output var-report-r-b
      578     )  .
      579   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   define variable v-waitfram-action01         as character   no-undo .
      581   define variable v-waitfram-action02         as character   no-undo .
      582   define variable v-waitfram-action03         as character   no-undo .
      583   define variable mWaitFramTextBeg            as character   no-undo.
      584   define variable mWaitFramTextEnd            as character   no-undo.
      585   define variable mWaitFramView               as logical     no-undo.
      586   define variable mWaitProcEvent              as logical     no-undo init yes.
      587   define variable mWaitFramInterval           as integer     no-undo init 1 .
      588   define variable mWaitFramStop               as logical     no-undo.
      589   define variable mWaitFramStopUser           as logical     no-undo.
      590   define variable mWaitFramStopTimeOut        as logical     no-undo.
      591   define variable mWaitFramStartProc          as datetime-tz no-undo.
      592   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      593   define button B-WaitFramStop auto-end-key
      594        label "Стоп"
      595        size 10 by 1 tooltip "Остоновить процесс".
      596   define button B-viewProcInfo
      597        label "Информация"
      598        size 15 by 1 tooltip "Информация о процесс".
      599   define frame waitfram
      600     v-waitfram-action01 format "x(72)" no-label skip
      601     v-waitfram-action02 format "x(72)" no-label skip
      602     v-waitfram-action03 format "x(72)" no-label skip
      603     B-viewProcInfo
      604     B-WaitFramStop at row 4 col 30
      605     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      606     .
      607   define new global shared variable mBatchMode as logical no-undo init ?.
      608   define variable mFramBachModHandle as handle no-undo.
      609   mFramBachModHandle = frame waitfram:handle.
      610   define variable mFameOldVis as logical no-undo.
      611   define variable mVisCUrentVin as logical no-undo.
      612   if session:batch-mode
      613   then
      614      mBatchMode = yes.
      615   if mBatchMode = ? then do:
      616     mVisCUrentVin = current-window:visible.
      617     mFameOldVis = mFramBachModHandle:visible.
      618     mFramBachModHandle:visible  = yes.
      619     mBatchMode = mFramBachModHandle:visible ne yes.
      620     mFramBachModHandle:visible = mFameOldVis.
      621     current-window:visible = mVisCUrentVin.
      622   end.
      623    if  log-manager:logfile-name ne ?
      624     then DO:
      625         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      626         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      627         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      628     end.
      629   on choose of B-WaitFramStop in frame waitfram
      630   do:
      631     mWaitFramStop = yes.
      632     mWaitFramStopUser = yes.
      633   end.
      634   function waitfram-check-timeout returns logical():
      635      define variable vtime as int64 no-undo.
      636      if mWaitFramStopTimeOut
      637      then
      638         return yes.
      639      vtime = ( now - mWaitFramStartProc ) / 1000 .
      640      if     mWaitFramTimeOut ne ?
      641         and mWaitFramTimeOut ne 0
      642         and mWaitFramTimeOut lt vtime
      643      then do:
      644         mWaitFramStopTimeOut = yes.
      645      end.
      646      return mWaitFramStopTimeOut.
      647   end.
      648   procedure waitfram-hide :
      649     if not session:batch-mode
      650     then do
      651     on error undo, return error return-value
      652     :
      653       pause 0 before-hide .
      654       if not mBatchMode then
      655         hide frame waitfram .
      656     if     not mWaitFramView
      657        and mWaitProcEvent
      658     then
      659       process events .
      660     end.
      661   end procedure.
      662   procedure waitfram-show :
      663     define input  parameter p-message as character no-undo .
      664     define variable v-left-margin as integer   no-undo .
      665     if not session:batch-mode
      666     then do
      667     on error undo, return error return-value
      668     :
      669       if length(p-message) <= 70 then do:
      670         assign
      671           v-left-margin = integer((70 - length(p-message)) / 2)
      672         .
      673         assign
      674           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      675         .
      676         assign
      677           v-waitfram-action01 = " "
      678           v-waitfram-action02 = " "
      679                                    + fill(" ", v-left-margin)
      680                                    + p-message
      681           v-waitfram-action03 = " "
      682         .
      683       end.
      684       else do:
      685         define variable vRindex1 as integer no-undo.
      686         define variable vRindex2 as integer no-undo.
      687         vRindex1 = r-index(p-message," ",70).
      688         if vRindex1 = 0
      689         then
      690            vRindex1 = 70.
      691         if length(p-message)  <= vRindex1 + 70 then do:
      692           assign
      693             v-waitfram-action01 = " "
      694             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      695             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      696           .
      697         end.
      698         else do:
      699           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      700           if vRindex2 <= vRindex1
      701           then
      702              vRindex2 = vRindex1 + 70.
      703           assign
      704             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      705             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      706             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      707           .
      708         end.
      709       end.
      710       B-viewProcInfo:visible   in frame waitfram = no.
      711       B-viewProcInfo:sensitive in frame waitfram = no.
      712       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      713       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      714       if  (   mWaitFramView
      715          or  mWaitProcEvent)
      716          and not mBatchMode
      717       then
      718          display
      719             v-waitfram-action01 skip
      720             v-waitfram-action02 skip
      721             v-waitfram-action03 skip
      722          with frame waitfram .
      723       if     mWaitFramView
      724          then do:
      725             if     mWaitFramInterval ne ?
      726                and not mBatchMode
      727             then
      728                wait-for go of frame waitfram pause mWaitFramInterval.
      729          end.
      730          else
      731             if     mWaitProcEvent
      732                and not mBatchMode
      733             then
      734                process events .
      735     end.
      736   end procedure.
      737      procedure waitfram-show-this:
      738         define input  parameter iInterval as int64 no-undo.
      739         define variable vtime as int64 no-undo.
      740         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      741         mWaitFramInterval = iInterval.
      742         run waitfram-show (substitute("&1&2 &3&4" ,
      743                                       mWaitFramTextBeg ,
      744                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      745                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      746                                       mWaitFramTextEnd
      747                                      )
      748                           ).
      749      end.
      750      procedure WaitFramRunPause:
      751         define input  parameter iInterval as dec no-undo.
      752         define variable vStart  as datetime-tz no-undo.
      753         define variable vend    as datetime-tz no-undo.
      754         define variable vint as int64 no-undo.
      755         define variable vOk as logical no-undo.
      756         vStart = now.
      757         vend   = vStart.
      758         publish "WaitFramPause" (iInterval,output vOk).
      759         vend   =  now.
      760         vint = vend - vStart.
      761         vint = iInterval - vint / 1000.
      762         if     not mWaitFramStop
      763            and (   vint > 0
      764                 or (    not vOk
      765                     and iInterval eq ?
      766                     )
      767                 )
      768         then
      769            run waitfram-show-this (iInterval).
      770         vend   =  now.
      771         vint = vend - vStart.
      772         vint = iInterval - vint / 1000.
      773         if     not mWaitFramStop
      774            and vint > 0
      775         then do:
      776            run gbl/pause.p (vint * 1000).
      777         end.
      778         if iInterval ne ?
      779         then
      780            publish "WaitFramStop".
      781         waitfram-check-timeout().
      782      end.
      783      procedure WaitFramWaitFor:
      784         define input  parameter iInterval as dec no-undo.
      785         assign
      786            mWaitFramStartProc   = now
      787            mWaitFramStopUser    = no
      788            mWaitFramStopTimeOut = no
      789         .
      790         block-wait:
      791         do while not mWaitFramStop:
      792            run WaitFramRunPause (iInterval).
      793            if  waitfram-check-timeout()
      794            then do:
      795               leave block-wait.
      796            end.
      797         end.
      798         run waitfram-hide.
      799      end.
      800   procedure waitfram-join :
      801     define input  parameter p-line-1  as character no-undo .
      802     define input  parameter p-line-2  as character no-undo .
      803     define input  parameter p-line-3  as character no-undo .
      804     define output parameter p-message as character no-undo .
      805     do
      806     on error undo, return error return-value
      807     :
      808       assign
      809         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      810                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      811                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      812       .
      813     end.
      814   end procedure.
      815   function waitfram-join-function returns character
      816     (input p-line-1 as character
      817     ,input p-line-2 as character
      818     ,input p-line-3 as character
      819     ).
      820     define variable v-message as character no-undo .
      821     run waitfram-join in this-procedure
      822       (input  p-line-1
      823       ,input  p-line-2
      824       ,input  p-line-3
      825       ,output v-message
      826       ) .
      827     return v-message .
      828   end function .
      829   define variable v-total-count  as integer   no-undo .
      830   define variable v-select-count as integer   no-undo .
      831   define variable v-db-num       as integer   no-undo .
      832   define variable v-ok           as logical   no-undo .
      833   define temp-table temp-object no-undo
      834     field obj-type as character
      835     field obj-code as integer
      836     index xpk is primary unique obj-type obj-code
      837     .
      838   define buffer buf_obj-list for obj-list .
      839   define buffer buf_temp-object for temp-object .
      840   do
      841   on error undo, return error return-value
      842   :
      843     assign
      844       v-total-count  = 0
      845       v-select-count = 0
      846     .
      847     for each buf_obj-list
      848     on error undo, return error return-value
      849     :
      850       assign
      851         v-total-count = v-total-count + 1
      852       .
      853   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      855     (input  buf_obj-list.obj-type
      856     ,input  buf_obj-list.obj-code
      857     ,output v-db-num
      858     )  .
      859       if v-db-num <> 0
      860       then do:
      861         assign
      862           v-select-count = v-select-count + 1
      863         .
      864         create buf_temp-object .
      865         assign
      866           buf_temp-object.obj-type = buf_obj-list.obj-type
      867           buf_temp-object.obj-code = buf_obj-list.obj-code
      868         .
      869       end.
      870     end.
      871     if v-total-count = 0
      872     then do:
      873       message
      874         "Не выбрано ни одного объекта" skip
      875         "Запрос распределённой проверки целостности не может быть сформирован" skip
      876         view-as alert-box error .
      877       undo, return error return-value .
      878     end.
      879     if v-select-count = 0
      880     then do:
      881       message
      882         "Было выбрано объектов" v-total-count skip
      883         "Запрос распределённой проверки целостности может быть сформирован" skip
      884         "только для объектов из УБД" skip
      885         "Объектов из УБД - " v-select-count skip
      886         "Запрос распределённой проверки целостности не может быть сформирован" skip
      887         view-as alert-box error .
      888       undo, return error return-value .
      889     end.
      890     assign
      891       v-ok = false
      892     .
      893     message
      894       "Было выбрано объектов" v-total-count skip
      895       "Запрос распределённой проверки целостности может быть сформирован" skip
      896       "только для объектов из УБД" skip
      897       "Объектов из УБД - " v-select-count skip
      898       "Отправить запрос распеределённой проверки целостности для объектов УБД?" skip
      899       view-as alert-box question buttons yes-no update v-ok .
      900     if v-ok = true
      901     then do:
      902       for each buf_temp-object
      903       on error undo, return error return-value
      904       :
      905         run waitfram-show in this-procedure
      906           (input  substitute("Отправка запроса информации о текущих остатках товара на объекте &1 &2"
      907                             ,buf_temp-object.obj-type
      908                             ,buf_temp-object.obj-code
      909                             )
      910           ) .
      911         run nws/cmdreqgd.p
      912           (input  buf_temp-object.obj-type
      913           ,input  buf_temp-object.obj-code
      914           ) .
      915       end.
      916       run waitfram-hide in this-procedure .
      917       message
      918         "Завершена отправка запроса распределённой проверки целостности для объектов УБД" skip
      919         "Объектов из УБД - " v-select-count skip
      920         "По завершении обмена новостями информацию о результатах проверки" skip
      921         "можно будет посмотреть в файлах" 'cmdcmpgd.err':u 'cmdcmpgd.log':u skip
      922         "в текущей директории системы обмена новостями" skip
      923         view-as alert-box information .
      924     end.
      925   end.
