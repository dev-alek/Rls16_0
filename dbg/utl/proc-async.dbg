        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define new shared variable g#auto-pid           as integer   no-undo .
        4   define new shared variable conn-par             as character no-undo .
        5   define new shared variable g#auto-user-id       as character no-undo .
        6   define new shared variable g#auto-user-login    as character no-undo .
        7   define new shared variable g#auto-user-password as character no-undo .
        8   define new shared variable v-socket             as logical   no-undo .
        9   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       10   define new shared variable auto-window-h     as handle    no-undo .
       11   define new shared variable auto-log-msg-h    as handle    no-undo .
       12   define new shared variable hand-log-msg-h    as handle    no-undo .
       13   define new shared variable log-file-name     as character no-undo initial ? .
       14   define new shared variable add-log-file-name as character no-undo initial ? .
       15   define new shared variable writelogvalue     as character no-undo initial ? .
       16   define new global shared variable g#language as character no-undo .
       17   if g#language <> '' and g#language <> 'rus':U then do:
       18     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       19   end.
       20   define new global shared variable g#library  as handle no-undo .
       21   define new global shared variable g#library2 as handle no-undo .
       22   define new  shared variable g#auto as logical no-undo.
       23   define new  shared variable g#news as logical no-undo.
       24   define new  shared variable g#oxml as logical no-undo.
       25   define new  shared variable g#esys as logical no-undo.
       26   define new  shared variable g#news-source-db as integer no-undo.
       27   define new  shared variable g#esys-source-esys as integer no-undo.
       28   define new  shared variable g#db-num as integer   no-undo .
       29   define new  shared variable g#userid as character no-undo .
       30   define new  shared variable g#passwd as character no-undo .
       31   define variable mAsyncProc as class ibs.th.file.AsyncProc.
       32   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       33   define variable mstopAsunc as logical no-undo.
       34   function StopCheck returns logical:
       35      define variable oFlag as logical no-undo.
       36      run StopCheckAsync (output oFlag).
       37      return oFlag.
       38   end.
       39   procedure StopCheckAsync:
       40       define output  parameter oFlag as logical no-undo.
       41       if mstopAsunc
       42       then
       43          oFlag = mstopAsunc.
       44       else do:
       45          oFlag = mAsyncProc:CheckStop().
       46          mstopAsunc = oFlag.
       47       end.
       48   end.
       49   function GetParamAsunc returns character
       50   (input iNumPar as integer  ):
       51      return mAsyncProc:GetPARAM(iNumPar).
       52   end.
       53   function GetParamAsuncStr returns ibs.th.file.asyncparam
       54   (input iParamName as character ):
       55      return mAsyncProc:GetPARAM(iParamName).
       56   end.
       57   procedure PutMesAsunc:
       58       define input  parameter Itext as character no-undo.
       59       define variable vflag as logical no-undo.
       60       Publish "WriteLogAsunc" (Itext, yes)  .
       61   end.
       62   procedure PutMesAsuncNoTime:
       63       define input  parameter Itext as character no-undo.
       64       define variable vflag as logical no-undo.
       65       Publish "WriteLogAsunc" (Itext,no)  .
       66   end.
       67   procedure PutStatAsunc:
       68       define input  parameter Itext as character no-undo.
       69       Publish "PutStatAsunc" (Itext,no) .
       70        run
       71       PutMesAsunc (itext).
       72   end.
       73   procedure PutStatAsuncNoTime:
       74       define input  parameter Itext as character no-undo.
       75       Publish "PutStatAsunc" (Itext,no)  .
       76        run
       77       PutMesAsuncNoTime (itext).
       78   end.
       79   procedure PutStatAsuncAdd:
       80       define input  parameter Itext as character no-undo.
       81       Publish "PutStatAsunc" (Itext,yes)  .
       82   end.
       83   procedure PutFileLogAsunc:
       84       define input  parameter IFile as character no-undo.
       85       Publish "PutFileLogAsunc" (ifile)  .
       86   end.
       87          mAsyncProc:mProcPublish = this-procedure.
       88   define variable mAsuncStopUser as logical no-undo.
       89   procedure WriteLogAsunc:
       90       define input  parameter Itext as character no-undo.
       91       define input  parameter IFlag as logical   no-undo.
       92       define variable vflag as logical no-undo.
       93       mAsyncProc:PutMes(input Itext, input IFlag).
       94       run StopCheckAsync(output vflag).
       95       if vflag
       96       then do:
       97          mAsuncStopUser = yes.
       98          stop.
       99       end.
      100   end.
      101   procedure SetGblError:
      102      define input  parameter Itext as character no-undo.
      103      define variable vtext as character no-undo.
      104      if mAsuncStopUser
      105      then do:
      106         vtext = "Error Операция прервана пользователем.".
      107         mAsyncProc:PutMes(vtext).
      108      end.
      109      else do:
      110         if Itext eq ?
      111         then
      112            vtext = "Error Ошибка при выполнениее асинхроного процесса".
      113         else
      114            vtext = "Error " + vtext.
      115         mAsyncProc:SetGblError(input Itext).
      116      end.
      117   end.
      118   function objExists return character
      119   (input  ifolder as character,
      120    input  iType   as character  ):
      121       define variable vFileType as character no-undo init "D,F".
      122       define variable vi        as integer no-undo.
      123       define variable vtype as character no-undo.
      124       if iType ne ?
      125       then
      126          vFileType = iType.
      127       do vi = 1 to num-entries(vFileType):
      128          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      129          vtype = file-information:file-type.
      130          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      131             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      132             index(vtype , entry(vi,vFileType )) > 0
      133          then return file-information:full-pathname .
      134          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      135          vtype = file-information:file-type.
      136          if file-information:file-name <> "" and
      137             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      138             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      139             index( vtype, entry(vi,vFileType )) > 0
      140          then return file-information:full-pathname .
      141       end.
      142       return ? .
      143   end.
      144   function SearchFile return character
      145   (input  ifile as character):
      146      return objExists(ifile,?).
      147   end.
      148   function SearchPFile return character
      149   (input inFile as char):
      150        define variable oFile       as character no-undo.
      151        define variable vFileSearch as character no-undo.
      152        define variable vNumEntry   as integer no-undo.
      153        if inFile = "" then return ?.
      154        vNumEntry = num-entries(inFile,".").
      155        vFileSearch = inFile.
      156        if    vNumEntry > 0
      157           and (   entry(vNumEntry,inFile,".") eq "p"
      158                or entry(vNumEntry,inFile,".") eq "w")
      159        then do:
      160           entry(vNumEntry,vFileSearch, ".") = "r".
      161           oFile = search(vFileSearch ).
      162           if oFile eq ?
      163           then
      164              oFile = search(inFile).
      165        end.
      166        else
      167           oFile = search(vFileSearch).
      168        return oFile.
      169     end.
      170   procedure writeFileLogAsunc:
      171       define input  parameter IFile as character no-undo.
      172       ifile = searchfile(ifile).
      173       if ifile ne ?
      174       then
      175          mAsyncProc:Nextlog(ifile).
      176   end.
      177   procedure WriteStatAsunc:
      178       define input  parameter IText    as character no-undo.
      179       define input  parameter IFlagAdd as logical no-undo.
      180      mAsyncProc:putStatus (Itext,IFlagAdd).
      181   end.
      182   procedure IsAsyncProc:
      183      define output parameter oIsAsync as logical no-undo.
      184      oIsAsync = yes.
      185   end.
      186   define variable mnum   as integer no-undo.
      187   define variable mCount as integer no-undo.
      188   subscribe "StopProc"           anywhere run-procedure "StopCheckAsync".
      189   subscribe "WriteLogAsunc"      anywhere.
      190   subscribe "PutStatAsunc"       anywhere run-procedure "WriteStatAsunc".
      191   subscribe "PutFileLogAsunc"    anywhere run-procedure "writeFileLogAsunc" .
      192   subscribe "IsAsyncProc"        anywhere .
      193   output to "errorasync.log".
      194   mAsyncProc:BegRec () .
      195   mNum   = int(mAsyncProc:GetPARAM("numSession"):valueparam).
      196   mCount = int(mAsyncProc:GetPARAM("countSession"):valueparam).
      197   mAsyncProc:creatProcInfo(1,mNum,mCount).
      198   mAsyncProc:WritelogInter = decimal (mAsyncProc:GetPARAM("WritelogInter"):valueparam).
      199   define variable mDbConnect as logical no-undo.
      200   define variable mName as character  no-undo.
      201   define variable mpassword as character  no-undo.
      202   MAIN-BLOCK:
      203   do on error   undo MAIN-BLOCK, retry MAIN-BLOCK
      204      on end-key undo MAIN-BLOCK, retry MAIN-BLOCK
      205      on stop    undo MAIN-BLOCK, retry MAIN-BLOCK:
      206      if retry
      207      then do:
      208         run SetGblError(?).
      209         leave MAIN-BLOCK.
      210      end.
      211   writelogvalue = "AsyncProc".
      212   define variable mProc       as char no-undo.
      213   define variable mParam      as character no-undo.
      214   define variable mParamName  as character no-undo.
      215   define variable mParamValue as character no-undo.
      216   define variable mNumEntries as integer no-undo.
      217   define variable mI          as integer no-undo.
      218   define variable mSetGblPar  as logical no-undo.
      219   mname = GetParamAsuncStr("User"):valueparam.
      220   mpassword = GetParamAsuncStr("password"):valueparam.
      221   mProc = GetParamAsuncStr("procedure"):valueparam.
      222   mDbConnect = logical(GetParamAsuncStr("DbConnect"):valueparam).
      223   mSetGblPar = logical(GetParamAsuncStr("SetGblPar"):valueparam).
      224   if mSetGblPar eq ?
      225   then
      226      mSetGblPar = true.
      227   if     mProc ne ?
      228      and mProc ne ""
      229   then do:
      230         run adm/autoinit.p ( input mname
      231                                ,input mpassword
      232                        ) no-error.
      233         if error-status :error then do:
      234            run PutMesAsunc ("Error " + error-status:get-message (1)).
      235         end.
      236         else do:
      237            if mDbConnect
      238            then do:
      239               run adm/autoconn.p no-error.
      240               if error-status :error
      241               then do:
      242                  run PutMesAsunc ("Error Не удалось подключиться к БД: " + return-value) .
      243               end.
      244               else do:
      245                  if     mname ne ""
      246                     and mSetGblPar
      247                  then
      248                  run gbl/set-gbl-async.p
      249                     (input  true
      250                     ,input  mName
      251                     ,input  mpassword
      252                     ).
      253                  if search(mProc) ne ?
      254                  then do:
      255                     run value(mProc) no-error.
      256                     if error-status :error
      257                     then do:
      258                        run PutMesAsunc (substitute ("Error Ошибка запуска процедуры &1 : &2 ",mProc, return-value)) .
      259                     end.
      260                  end.
      261               end.
      262            end.
      263            else do:
      264               if search(mProc) ne ?
      265               then do:
      266                  run value(mProc) no-error.
      267                  if error-status :error
      268                  then do:
      269                     run PutMesAsunc (substitute ("Error Ошибка запуска процедуры &1 : &2 ",mProc, return-value)) .
      270                  end.
      271               end.
      272            end.
      273         end.
      274      end.
      275   else
      276      run PutMesAsunc ("Error Не переданы параметры.") .
      277   end.
      278   finally:
      279      mAsyncProc:EndRec ()  .
      280      unsubscribe "StopProc".
      281      unsubscribe "WriteLogAsunc".
      282      unsubscribe "PutStatAsunc".
      283      unsubscribe "PutFileLogAsunc".
      284      unsubscribe "IsAsyncProc".
      285      delete object mAsyncProc.
      286      output close.
      287      output to "endproc.txt".
      288      output close.
      289      quit.
      290   end.
