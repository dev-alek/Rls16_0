       99   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define variable v-waitfram-action01         as character   no-undo .
      101   define variable v-waitfram-action02         as character   no-undo .
      102   define variable v-waitfram-action03         as character   no-undo .
      103   define variable mWaitFramTextBeg            as character   no-undo.
      104   define variable mWaitFramTextEnd            as character   no-undo.
      105   define variable mWaitFramView               as logical     no-undo.
      106   define variable mWaitProcEvent              as logical     no-undo init yes.
      107   define variable mWaitFramInterval           as integer     no-undo init 1 .
      108   define variable mWaitFramStop               as logical     no-undo.
      109   define variable mWaitFramStopUser           as logical     no-undo.
      110   define variable mWaitFramStopTimeOut        as logical     no-undo.
      111   define variable mWaitFramStartProc          as datetime-tz no-undo.
      112   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      113   define button B-WaitFramStop auto-end-key
      114        label "Стоп"
      115        size 10 by 1 tooltip "Остоновить процесс".
      116   define button B-viewProcInfo
      117        label "Информация"
      118        size 15 by 1 tooltip "Информация о процесс".
      119   define frame waitfram
      120     v-waitfram-action01 format "x(72)" no-label skip
      121     v-waitfram-action02 format "x(72)" no-label skip
      122     v-waitfram-action03 format "x(72)" no-label skip
      123     B-viewProcInfo
      124     B-WaitFramStop at row 4 col 30
      125     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      126     .
      127   define new global shared variable mBatchMode as logical no-undo init ?.
      128   define variable mFramBachModHandle as handle no-undo.
      129   mFramBachModHandle = frame waitfram:handle.
      130   define variable mFameOldVis as logical no-undo.
      131   define variable mVisCUrentVin as logical no-undo.
      132   if session:batch-mode
      133   then
      134      mBatchMode = yes.
      135   if mBatchMode = ? then do:
      136     mVisCUrentVin = current-window:visible.
      137     mFameOldVis = mFramBachModHandle:visible.
      138     mFramBachModHandle:visible  = yes.
      139     mBatchMode = mFramBachModHandle:visible ne yes.
      140     mFramBachModHandle:visible = mFameOldVis.
      141     current-window:visible = mVisCUrentVin.
      142   end.
      143    if  log-manager:logfile-name ne ?
      144     then DO:
      145         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      146         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      147         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      148     end.
      149   on choose of B-WaitFramStop in frame waitfram
      150   do:
      151     mWaitFramStop = yes.
      152     mWaitFramStopUser = yes.
      153   end.
      154   function waitfram-check-timeout returns logical():
      155      define variable vtime as int64 no-undo.
      156      if mWaitFramStopTimeOut
      157      then
      158         return yes.
      159      vtime = ( now - mWaitFramStartProc ) / 1000 .
      160      if     mWaitFramTimeOut ne ?
      161         and mWaitFramTimeOut ne 0
      162         and mWaitFramTimeOut lt vtime
      163      then do:
      164         mWaitFramStopTimeOut = yes.
      165      end.
      166      return mWaitFramStopTimeOut.
      167   end.
      168   procedure waitfram-hide :
      169     if not session:batch-mode
      170     then do
      171     on error undo, return error return-value
      172     :
      173       pause 0 before-hide .
      174       if not mBatchMode then
      175         hide frame waitfram .
      176     if     not mWaitFramView
      177        and mWaitProcEvent
      178     then
      179       process events .
      180     end.
      181   end procedure.
      182   procedure waitfram-show :
      183     define input  parameter p-message as character no-undo .
      184     define variable v-left-margin as integer   no-undo .
      185     if not session:batch-mode
      186     then do
      187     on error undo, return error return-value
      188     :
      189       if length(p-message) <= 70 then do:
      190         assign
      191           v-left-margin = integer((70 - length(p-message)) / 2)
      192         .
      193         assign
      194           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      195         .
      196         assign
      197           v-waitfram-action01 = " "
      198           v-waitfram-action02 = " "
      199                                    + fill(" ", v-left-margin)
      200                                    + p-message
      201           v-waitfram-action03 = " "
      202         .
      203       end.
      204       else do:
      205         define variable vRindex1 as integer no-undo.
      206         define variable vRindex2 as integer no-undo.
      207         vRindex1 = r-index(p-message," ",70).
      208         if vRindex1 = 0
      209         then
      210            vRindex1 = 70.
      211         if length(p-message)  <= vRindex1 + 70 then do:
      212           assign
      213             v-waitfram-action01 = " "
      214             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      215             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      216           .
      217         end.
      218         else do:
      219           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      220           if vRindex2 <= vRindex1
      221           then
      222              vRindex2 = vRindex1 + 70.
      223           assign
      224             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      225             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      226             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      227           .
      228         end.
      229       end.
      230       B-viewProcInfo:visible   in frame waitfram = no.
      231       B-viewProcInfo:sensitive in frame waitfram = no.
      232       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      233       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      234       if  (   mWaitFramView
      235          or  mWaitProcEvent)
      236          and not mBatchMode
      237       then
      238          display
      239             v-waitfram-action01 skip
      240             v-waitfram-action02 skip
      241             v-waitfram-action03 skip
      242          with frame waitfram .
      243       if     mWaitFramView
      244          then do:
      245             if     mWaitFramInterval ne ?
      246                and not mBatchMode
      247             then
      248                wait-for go of frame waitfram pause mWaitFramInterval.
      249          end.
      250          else
      251             if     mWaitProcEvent
      252                and not mBatchMode
      253             then
      254                process events .
      255     end.
      256   end procedure.
      257      procedure waitfram-show-this:
      258         define input  parameter iInterval as int64 no-undo.
      259         define variable vtime as int64 no-undo.
      260         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      261         mWaitFramInterval = iInterval.
      262         run waitfram-show (substitute("&1&2 &3&4" ,
      263                                       mWaitFramTextBeg ,
      264                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      265                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      266                                       mWaitFramTextEnd
      267                                      )
      268                           ).
      269      end.
      270      procedure WaitFramRunPause:
      271         define input  parameter iInterval as dec no-undo.
      272         define variable vStart  as datetime-tz no-undo.
      273         define variable vend    as datetime-tz no-undo.
      274         define variable vint as int64 no-undo.
      275         define variable vOk as logical no-undo.
      276         vStart = now.
      277         vend   = vStart.
      278         publish "WaitFramPause" (iInterval,output vOk).
      279         vend   =  now.
      280         vint = vend - vStart.
      281         vint = iInterval - vint / 1000.
      282         if     not mWaitFramStop
      283            and (   vint > 0
      284                 or (    not vOk
      285                     and iInterval eq ?
      286                     )
      287                 )
      288         then
      289            run waitfram-show-this (iInterval).
      290         vend   =  now.
      291         vint = vend - vStart.
      292         vint = iInterval - vint / 1000.
      293         if     not mWaitFramStop
      294            and vint > 0
      295         then do:
      296            run gbl/pause.p (vint * 1000).
      297         end.
      298         if iInterval ne ?
      299         then
      300            publish "WaitFramStop".
      301         waitfram-check-timeout().
      302      end.
      303      procedure WaitFramWaitFor:
      304         define input  parameter iInterval as dec no-undo.
      305         assign
      306            mWaitFramStartProc   = now
      307            mWaitFramStopUser    = no
      308            mWaitFramStopTimeOut = no
      309         .
      310         block-wait:
      311         do while not mWaitFramStop:
      312            run WaitFramRunPause (iInterval).
      313            if  waitfram-check-timeout()
      314            then do:
      315               leave block-wait.
      316            end.
      317         end.
      318         run waitfram-hide.
      319      end.
      320   procedure waitfram-join :
      321     define input  parameter p-line-1  as character no-undo .
      322     define input  parameter p-line-2  as character no-undo .
      323     define input  parameter p-line-3  as character no-undo .
      324     define output parameter p-message as character no-undo .
      325     do
      326     on error undo, return error return-value
      327     :
      328       assign
      329         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      330                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      331                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      332       .
      333     end.
      334   end procedure.
      335   function waitfram-join-function returns character
      336     (input p-line-1 as character
      337     ,input p-line-2 as character
      338     ,input p-line-3 as character
      339     ).
      340     define variable v-message as character no-undo .
      341     run waitfram-join in this-procedure
      342       (input  p-line-1
      343       ,input  p-line-2
      344       ,input  p-line-3
      345       ,output v-message
      346       ) .
      347     return v-message .
      348   end function .
      349   define new global shared variable g#lib-Matrix  as handle no-undo .
      350   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   procedure gds-ind1 :
      352   main-block:
      353     do
      354   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      355   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      356   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      357     :
      358   define input-output parameter p-doc-rec  as recid no-undo.
      359   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      360   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      361   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      362   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      363   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      364   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      365   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      366   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      367   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      368   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      369   define variable v-db-num like ub.db.db-num no-undo .
      370   define variable v-db-num-obj like ub.db.db-num no-undo .
      371   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      373     (output v-db-num
      374     )  .
      375   define variable v-date as date no-undo .
      376   define variable v-time as integer no-undo .
      377   run cur-time in this-procedure(output v-date, output v-time).
      378     find first bufs_gds-obj-prop exclusive-lock where
      379               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      380               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      381               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      382       if not available bufs_gds-obj-prop then do:
      383           create bufs_gds-obj-prop.
      384           assign
      385               bufs_gds-obj-prop.gds-code           = p-gds-code
      386               bufs_gds-obj-prop.grop-date-update   = v-date
      387               bufs_gds-obj-prop.grop-time-update   = v-time
      388               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      389               bufs_gds-obj-prop.obj-type           = p-obj-type
      390               bufs_gds-obj-prop.obj-code           = p-obj-code
      391           no-error .
      392           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      393       end.
      394   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      395   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      396   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      397   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      398   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      399   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      400         p-doc-rec = recid(bufs_gds-obj-prop)    .
      401   end.
      402   end procedure.
      403   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      404   define variable v-longchar-asstro  as longchar no-undo .
      405   define temp-table temp-goods no-undo
      406     field gds-code as integer
      407     field status_  as integer
      408     index pi gds-code
      409   .
      410   PROCEDURE translate-to-other :
      411   define input  parameter p-asmt-id as integer   no-undo .
      412   define input  parameter p-db-num  as integer   no-undo .
      413     do
      414     on error undo, return error return-value
      415     :
      416   define variable v-recid as recid no-undo .
      417   define buffer Oth_assortment-matrix-goods for ub.assortment-matrix-goods  .
      418   define buffer obj_assortment-matrix for ub.assortment-matrix  .
      419   define buffer sh_assortment-matrix for ub.assortment-matrix  .
      420   define buffer bufs_gds-obj-prop for ub.gds-obj-prop  .
      421     find first  sh_assortment-matrix no-lock where
      422                 sh_assortment-matrix.asmt-id = p-asmt-id and
      423                 sh_assortment-matrix.db-num  = p-db-num  and
      424                 sh_assortment-matrix.asmt-status = 0 and
      425                 sh_assortment-matrix.asmt-type = 'Шаблон':U no-error .
      426   if not available sh_assortment-matrix then return .
      427   define variable v-doc-rec as recid no-undo .
      428   define variable v-gds-prop-recid as recid no-undo .
      429   define variable v-stt as integer   no-undo .
      430   v-longchar-asstro = "".
      431      run waitfram-show in this-procedure  ("Передача изменений в связанные матрицы ... " ) .
      432      for each obj_assortment-matrix no-lock where
      433               obj_assortment-matrix.asmt-status = 0 and
      434               obj_assortment-matrix.asmt-type = 'Объект':U ,
      435         first ub.assortment-matrix-attr no-lock where
      436               ub.assortment-matrix-attr.asmt-id    = obj_assortment-matrix.asmt-id and
      437               ub.assortment-matrix-attr.db-num     = obj_assortment-matrix.db-num and
      438               ub.assortment-matrix-attr.attr-code  = 'RootShablon':U and
      439               ub.assortment-matrix-attr.attr-value = substitute("&1&3&2" , p-asmt-id, p-db-num,chr(4))
      440               :
      441           run waitfram-show in this-procedure ( substitute(" Передаю изменения в Матрицу: &1" ,obj_assortment-matrix.asmt-name )) .
      442           for each temp-goods :
      443              if temp-goods.status_ = 0 then do:
      444                   find first Oth_assortment-matrix-goods no-lock where
      445                               Oth_assortment-matrix-goods.asmt-id  = ub.assortment-matrix-attr.asmt-id and
      446                               Oth_assortment-matrix-goods.db-num   = ub.assortment-matrix-attr.db-num  and
      447                               Oth_assortment-matrix-goods.gds-code = temp-goods.gds-code and
      448                               Oth_assortment-matrix-goods.asmg-status = 0 no-error .
      449                       if not available Oth_assortment-matrix-goods then do:
      450   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
      451    (input this-procedure
      452    ,input-output v-doc-rec
      453    ,input 'ДОБАВЛЕНИЕ':U
      454    ,input ub.assortment-matrix-attr.asmt-id
      455    ,input ub.assortment-matrix-attr.db-num
      456    ,input temp-goods.gds-code
      457    ,input ''
      458     ) no-error .
      459                           if error-status :error then do:
      460                             v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      461                             next.
      462                           end.
      463                       end.
      464                 end.
      465                 else do:
      466                   v-stt = 1.
      467                   find first Oth_assortment-matrix-goods no-lock where
      468                               Oth_assortment-matrix-goods.asmt-id  = ub.assortment-matrix-attr.asmt-id and
      469                               Oth_assortment-matrix-goods.db-num   = ub.assortment-matrix-attr.db-num  and
      470                               Oth_assortment-matrix-goods.gds-code = temp-goods.gds-code and
      471                               Oth_assortment-matrix-goods.asmg-status = 0 no-error .
      472                       if available Oth_assortment-matrix-goods then do:
      473                           v-recid = recid(Oth_assortment-matrix-goods).
      474                           find first bufs_gds-obj-prop exclusive-lock where
      475                                      bufs_gds-obj-prop.gds-code = Oth_assortment-matrix-goods.gds-code   and
      476                                      bufs_gds-obj-prop.obj-type = Oth_assortment-matrix-goods.obj-type   and
      477                                      bufs_gds-obj-prop.obj-code = Oth_assortment-matrix-goods.obj-code  no-error .
      478                           if not available bufs_gds-obj-prop
      479                             or not (bufs_gds-obj-prop.gdop-igt = 'Пусто':U or
      480                                     bufs_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U ) then do:
      481                           v-longchar-asstro = v-longchar-asstro +
      482                           substitute("Принудительная смена ИЖТ_ товара &1  на ПУСТО на объекте &2&3&4" ,
      483                               Oth_assortment-matrix-goods.gds-code ,
      484                               Oth_assortment-matrix-goods.obj-type ,
      485                               Oth_assortment-matrix-goods.obj-code ,
      486                               chr(10)) .
      487                           run gds-ind1
      488                               (input-output v-gds-prop-recid
      489                               ,Oth_assortment-matrix-goods.gds-code
      490                               ,Oth_assortment-matrix-goods.obj-type
      491                               ,Oth_assortment-matrix-goods.obj-code
      492                               ,'Пусто':U
      493                               ,?
      494                               ,?
      495                               ,?
      496                               ,?
      497                               ,?
      498                               ) no-error  .
      499                             end.
      500                             if not error-status :error then do:
      501   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
      502    (input this-procedure
      503    ,input v-recid
      504    ,input-output v-stt
      505    ,input no
      506     ) no-error .
      507                                   if error-status :error then do:
      508                                      v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      509                                   end.
      510                              end.
      511                              else do:
      512                                 v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      513                              end.
      514                       end.
      515                  end.
      516           end.
      517      end.
      518      run waitfram-hide in this-procedure.
      519   end.
      520   END PROCEDURE.
      521   PROCEDURE translate-to-other-gds :
      522   define input  parameter p-asmt-id  as integer   no-undo .
      523   define input  parameter p-db-num   as integer   no-undo .
      524   define input  parameter p-gds-code as integer   no-undo .
      525   define input  parameter p-status_  as integer   no-undo .
      526     do
      527     on error undo, return error return-value
      528     :
      529   define buffer Oth_assortment-matrix-goods for ub.assortment-matrix-goods  .
      530   define buffer obj_assortment-matrix for ub.assortment-matrix  .
      531   define buffer sh_assortment-matrix for ub.assortment-matrix  .
      532   define buffer bufs_gds-obj-prop for ub.gds-obj-prop  .
      533     find first  sh_assortment-matrix no-lock where
      534                 sh_assortment-matrix.asmt-id = p-asmt-id and
      535                 sh_assortment-matrix.db-num  = p-db-num  and
      536                 sh_assortment-matrix.asmt-status = 0 and
      537                 sh_assortment-matrix.asmt-type = 'Шаблон':U no-error .
      538   if not available sh_assortment-matrix then return .
      539   define variable v-doc-rec as recid no-undo .
      540   define variable v-gds-prop-recid as recid no-undo .
      541   define variable v-stt as integer   no-undo .
      542   define variable v-recid as recid no-undo .
      543    v-longchar-asstro = "" .
      544      for each obj_assortment-matrix no-lock where
      545               obj_assortment-matrix.asmt-status = 0 and
      546               obj_assortment-matrix.asmt-type = 'Объект':U ,
      547         first ub.assortment-matrix-attr no-lock where
      548               ub.assortment-matrix-attr.asmt-id    = obj_assortment-matrix.asmt-id and
      549               ub.assortment-matrix-attr.db-num     = obj_assortment-matrix.db-num and
      550               ub.assortment-matrix-attr.attr-code  = 'RootShablon':U and
      551               ub.assortment-matrix-attr.attr-value = substitute("&1&3&2" , p-asmt-id, p-db-num,chr(4))
      552               :
      553              if p-status_ = 0 then do:
      554                   find first Oth_assortment-matrix-goods no-lock where
      555                               Oth_assortment-matrix-goods.asmt-id  = ub.assortment-matrix-attr.asmt-id and
      556                               Oth_assortment-matrix-goods.db-num   = ub.assortment-matrix-attr.db-num  and
      557                               Oth_assortment-matrix-goods.gds-code = p-gds-code and
      558                               Oth_assortment-matrix-goods.asmg-status = 0 no-error .
      559                       if not available Oth_assortment-matrix-goods then do:
      560   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
      561    (input this-procedure
      562    ,input-output v-doc-rec
      563    ,input 'ДОБАВЛЕНИЕ':U
      564    ,input ub.assortment-matrix-attr.asmt-id
      565    ,input ub.assortment-matrix-attr.db-num
      566    ,input p-gds-code
      567    ,input ''
      568     ) no-error .
      569                           if error-status :error then do:
      570                              v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      571                              next.
      572                           end.
      573                       end.
      574                 end.
      575                 else do:
      576                   v-stt = 1.
      577                   find first Oth_assortment-matrix-goods no-lock where
      578                               Oth_assortment-matrix-goods.asmt-id  = ub.assortment-matrix-attr.asmt-id and
      579                               Oth_assortment-matrix-goods.db-num   = ub.assortment-matrix-attr.db-num  and
      580                               Oth_assortment-matrix-goods.gds-code = p-gds-code and
      581                               Oth_assortment-matrix-goods.asmg-status = 0 no-error .
      582                       if available Oth_assortment-matrix-goods then do:
      583                           v-recid = recid(Oth_assortment-matrix-goods) .
      584                           find first bufs_gds-obj-prop exclusive-lock where
      585                                      bufs_gds-obj-prop.gds-code = Oth_assortment-matrix-goods.gds-code   and
      586                                      bufs_gds-obj-prop.obj-type = Oth_assortment-matrix-goods.obj-type   and
      587                                      bufs_gds-obj-prop.obj-code = Oth_assortment-matrix-goods.obj-code  no-error .
      588                           if not available bufs_gds-obj-prop
      589                             or not (bufs_gds-obj-prop.gdop-igt = 'Пусто':U or
      590                                     bufs_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U ) then do:
      591                           v-longchar-asstro = v-longchar-asstro +
      592                           substitute("Принудительная смена ИЖТ. товара &1  на ПУСТО на объекте &2&3&4" ,
      593                               Oth_assortment-matrix-goods.gds-code ,
      594                               Oth_assortment-matrix-goods.obj-type ,
      595                               Oth_assortment-matrix-goods.obj-code ,
      596                               chr(10)) .
      597                           run gds-ind1
      598                               (input-output v-gds-prop-recid
      599                               ,Oth_assortment-matrix-goods.gds-code
      600                               ,Oth_assortment-matrix-goods.obj-type
      601                               ,Oth_assortment-matrix-goods.obj-code
      602                               ,'Пусто':U
      603                               ,?
      604                               ,?
      605                               ,?
      606                               ,?
      607                               ,?
      608                               ) no-error  .
      609                              end.
      610                              if not error-status :error then do:
      611   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
      612    (input this-procedure
      613    ,input v-recid
      614    ,input-output v-stt
      615    ,input no
      616     ) no-error .
      617                                   if error-status :error then do:
      618                                      v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      619                                   end.
      620                              end.
      621                              else do:
      622                                v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      623                              end.
      624                       end.
      625                  end.
      626      end.
      627   end.
      628   END PROCEDURE.
      629   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      630   procedure correct-message :
      631   define input  parameter p-longchar as longchar no-undo .
      632   define variable v-longchar as longchar no-undo .
      633   define variable v-err-ext  as logical  no-undo .
      634     do
      635     on error undo, return error return-value
      636     :
      637      run get-long-message in this-procedure  (output v-longchar ).
      638       v-longchar = v-longchar + p-longchar.
      639       v-err-ext  = true .
      640       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
      641     end.
      642   end procedure.
      643   define variable v-longchar as longchar no-undo .
      644   define variable v-err-ext as logical   no-undo .
      645   procedure get-long-message  :
      646   define output parameter p-longchar  as longchar no-undo .
      647     do
      648     on error undo, return error return-value
      649     :
      650        p-longchar = v-longchar .
      651     end.
      652   end procedure.
      653   procedure set-long-message :
      654   define input  parameter  p-longchar as longchar   no-undo .
      655   define input  parameter  p-err-ext as logical   no-undo .
      656     do
      657     on error undo, return error return-value
      658     :
      659       v-longchar  =  p-longchar .
      660       v-err-ext   =  p-err-ext  .
      661     end.
      662   end procedure.
      663   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664   procedure cur-time :
      665      define output parameter p-today as date      no-undo .
      666      define output parameter p-time  as integer   no-undo .
      667     do
      668     on error undo, return error
      669     :
      670       define variable v-date1 as date      no-undo .
      671       define variable v-date2 as date      no-undo .
      672       define variable v-time  as integer   no-undo .
      673       assign
      674         v-date1 = today
      675         v-time  = time
      676         v-date2 = today
      677       .
      678       if v-date1 <> v-date2
      679       then do:
      680         assign
      681           v-date1 = today
      682           v-time  = v-time
      683         .
      684       end.
      685       assign
      686         p-today = v-date1
      687         p-time  = v-time
      688       .
      689     end.
      690   end.
      691   function cur-time-date returns character
      692   :
      693     return string(today, '99/99/9999':U) .
      694   end.
      695   function cur-time-mjd returns decimal
      696   :
      697     define variable v-date as date      no-undo .
      698     define variable v-time as integer   no-undo .
      699     run cur-time in this-procedure
      700       (output v-date
      701       ,output v-time
      702       ) .
      703     return integer(v-date) - 2400002 + (v-time / 86400) .
      704   end.
      705   function cur-time-get-ending-index returns integer
      706   (input p-number as integer
      707   )
      708   :
      709     if p-number < 0
      710     or p-number = ?
      711     then do:
      712       return 1 .
      713     end.
      714     define variable v-rest as integer   no-undo .
      715     assign
      716       p-number = p-number modulo 100
      717     .
      718     if p-number < 20
      719     then do:
      720       assign
      721         v-rest = p-number
      722       .
      723     end.
      724     else do:
      725       assign
      726         v-rest = p-number modulo 10
      727       .
      728     end.
      729     case v-rest :
      730       when 1
      731       then do:
      732         return 2 .
      733       end.
      734       when 2 or
      735       when 3 or
      736       when 4
      737       then do:
      738         return 3 .
      739       end.
      740       otherwise do:
      741         return 1 .
      742       end.
      743     end case .
      744   end.
      745   procedure cur-time-mjd-to-date :
      746      define input  parameter i-mjd-diff as decimal no-undo.
      747      define output parameter o-Date     as date    no-undo.
      748      define output parameter o-Time     as integer no-undo.
      749      define variable v-day-number as integer   no-undo .
      750      if    i-mjd-diff < 0
      751         or i-mjd-diff = ?
      752      then do:
      753         return "?" .
      754      end.
      755      assign
      756         v-day-number = truncate(i-mjd-diff,0).
      757         o-Date = date(v-day-number + 2400002).
      758         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      759     .
      760   end.
      761   function cur-time-mjd-to-string returns character
      762   (input p-mjd-diff as decimal
      763   )
      764   :
      765     define variable v-day-number as integer   no-undo .
      766     define variable v-seconds    as integer   no-undo .
      767     define variable v-hour       as integer   no-undo .
      768     define variable v-min        as integer   no-undo .
      769     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      770     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      771     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      772     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      773     if p-mjd-diff < 0
      774     or p-mjd-diff = ?
      775     then do:
      776       return "?" .
      777     end.
      778     assign
      779       v-day-number = integer(truncate(p-mjd-diff,0))
      780       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      781     .
      782     if v-seconds > 86400
      783     then do:
      784       assign
      785         v-seconds = 86400 - 1
      786       .
      787     end.
      788     if v-seconds < 0
      789     then do:
      790       assign
      791         v-seconds = 0
      792       .
      793     end.
      794     assign
      795       v-hour = truncate(v-seconds / 3600, 0)
      796     .
      797     assign
      798       v-seconds = v-seconds modulo 3600
      799     .
      800     assign
      801       v-min = truncate(v-seconds / 60, 0)
      802     .
      803     assign
      804       v-seconds = v-seconds modulo 60
      805     .
      806     return
      807         (if v-day-number <> 0
      808           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      809           else ""
      810         )
      811       + (if v-day-number <> 0 or v-hour <> 0
      812           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      813           else ""
      814         )
      815       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      816           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      817           else ""
      818         )
      819       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      820       .
      821   end.
      822   function cur-time-string returns character
      823   :
      824     define variable v-date as date      no-undo .
      825     define variable v-time as integer   no-undo .
      826     run cur-time in this-procedure
      827       (output v-date
      828       ,output v-time
      829       ) .
      830     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      831   end.
      832   function cur-time-string-sec returns character
      833   :
      834     define variable v-date as date      no-undo .
      835     define variable v-time as integer   no-undo .
      836     run cur-time in this-procedure
      837       (output v-date
      838       ,output v-time
      839       ) .
      840     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      841   end.
      842   function cur-time-custom  returns character
      843   (input p-prefix as character
      844   ,input p-date-format as character
      845   ,input p-delimiter as character
      846   ,input p-time-format as character
      847   ,input p-suffix as character
      848   )
      849   :
      850     define variable v-date as date      no-undo .
      851     define variable v-time as integer   no-undo .
      852     run cur-time in this-procedure
      853       (output v-date
      854       ,output v-time
      855       ) .
      856     return
      857       p-prefix
      858       + string(v-date, p-date-format)
      859       + p-delimiter
      860       + string(v-time, p-time-format)
      861       + p-suffix
      862       .
      863   end.
      864   function cur-time-print  returns character
      865   :
      866     define variable v-date as date      no-undo .
      867     define variable v-time as integer   no-undo .
      868     run cur-time in this-procedure
      869       (output v-date
      870       ,output v-time
      871       ) .
      872     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      873   end.
      874   function cur-time-datetime returns datetime
      875   :
      876     define variable v-char as character no-undo .
      877     define variable v-datetime as datetime no-undo .
      878     v-char = cur-time-string().
      879     v-datetime = datetime(v-char).
      880     return  v-datetime.
      881   end.
      882   function cur-time-string-msec returns character
      883   :
      884     define variable v-date as datetime  no-undo .
      885     v-date = now.
      886     return string(v-date) .
      887   end.
      888   define variable v-rid-list as character no-undo .
      889   define buffer buf_assort-matrix for ub.assortment-matrix  .
      890   define buffer buf_assort-matrix-goods for ub.assortment-matrix-goods  .
      891   v-rid-list  = "".
      892     v-longchar-asstro = "" .
      893   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
      894      .
      895       run ref/assmatr.w (
      896           input parParentProc   ,
      897           input "b-sel"         ,
      898           input v-cntxt-obj-type ,
      899           input v-cntxt-obj-code ,
      900           input 'Шаблон':U  ,
      901           input 0               ,
      902           input-output v-rid-list ) .
      903     if num-entries(v-rid-list) <> 1 then return.
      904     find first buf_assort-matrix exclusive-lock where  recid(buf_assort-matrix) = int(v-rid-list) no-error .
      905     for each  buf_assort-matrix-goods no-lock where
      906               buf_assort-matrix-goods.asmt-id = buf_assort-matrix.asmt-id and
      907               buf_assort-matrix-goods.db-num  = buf_assort-matrix.db-num :
      908               create temp-goods.
      909               assign
      910                 temp-goods.gds-code = buf_assort-matrix-goods.gds-code
      911                 temp-goods.status_  = buf_assort-matrix-goods.asmg-status
      912               .
      913     end.
      914       run translate-to-other ( buf_assort-matrix.asmt-id, buf_assort-matrix.db-num ).
      915       if v-longchar-asstro <> ""  then do:
      916       define variable v-ok as logical   no-undo .
      917       run gbl/d-longchar.w (
      918               ?,
      919               'Editor_row=2\':u
      920             + 'title=При транслировании в Ассортиментные матрицы\':u
      921             + 'Editor_col=1\':u
      922             + 'Editor_width=96\':u
      923             + 'Editor_height=21\':u
      924             + 'readonly=yes\':u
      925           ,input-output v-longchar-asstro
      926           ,output v-ok ) no-error .
      927           v-longchar-asstro = "" .
