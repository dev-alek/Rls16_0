        1   block-level on error undo, throw.
        2   define input parameter parparentproc AS  WIDGET-HANDLE       NO-UNDO.
        3   define input parameter p-artic      like ub.parts.artic      no-undo .
        4   define input parameter p-prod-type  like ub.parts.prod-type  no-undo .
        5   define input parameter p-prod-code  like ub.parts.prod-code  no-undo .
        6   define input parameter p-in-code    like ub.parts.in-code    no-undo .
        7   define input parameter p-part-code  like ub.parts.part-code  no-undo .
        8   define input parameter p-price-base like ub.parts.price-base no-undo .
        9   define input parameter p-price-rubl like ub.parts.price-rubl no-undo .
       10   define input parameter p-vat-pc     like ub.parts.vat-pc     no-undo .
       11   define input parameter p-slt-pc     like ub.parts.slt-pc     no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: partbase.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: utl/partbase.p $":U .
       17   define variable vss-description as character no-undo init "Программа изменения учетной цены партии".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
       89     field prt-code         like ub.gds-dtl.prt-code
       90     field rsrv-qnty        like ub.gds-dtl.fact-qnty
       91     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
       92     index xpk is primary unique prt-code
       93   .
       94   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
       95     field pl-code          like ub.pl-gds.pl-code
       96     field rsrv-qnty        like ub.pl-gds.free-qnty
       97     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
       98     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
       99     field before-free-qnty like ub.pl-gds.fact-qnty
      100     field before-out-qnty  like ub.pl-gds.fact-qnty
      101     field after-free-qnty  like ub.pl-gds.fact-qnty
      102     field after-out-qnty   like ub.pl-gds.fact-qnty
      103     field fact-qnty        like ub.pl-gds.fact-qnty
      104     field cli-qnty         like ub.pl-gds.cli-qnty
      105     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
      106     index xpk is primary unique pl-code
      107   .
      108   procedure trndocrs-gds-dtl-clear :
      109     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      110     do
      111     on error undo, return error return-value
      112     :
      113       for each buf_temp-trndocrs-gds-dtl-rsrv
      114       on error undo, return error return-value
      115       :
      116         delete buf_temp-trndocrs-gds-dtl-rsrv .
      117       end.
      118     end.
      119   end procedure.
      120   procedure trndocrs-pl-gds-clear :
      121     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      122     do
      123     on error undo, return error return-value
      124     :
      125       for each buf_temp-trndocrs-pl-gds-rsrv
      126       on error undo, return error return-value
      127       :
      128         delete buf_temp-trndocrs-pl-gds-rsrv .
      129       end.
      130     end.
      131   end procedure.
      132   procedure trndocrs-clear :
      133     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      134     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      135     do
      136     on error undo, return error return-value
      137     :
      138       for each buf_temp-trndocrs-gds-dtl-rsrv
      139       on error undo, return error return-value
      140       :
      141         delete buf_temp-trndocrs-gds-dtl-rsrv .
      142       end.
      143       for each buf_temp-trndocrs-pl-gds-rsrv
      144       on error undo, return error return-value
      145       :
      146         delete buf_temp-trndocrs-pl-gds-rsrv .
      147       end.
      148     end.
      149   end procedure.
      150   procedure trndocrs-pl-gds-accum :
      151     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
      152     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
      153     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
      154     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
      155     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
      156     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      157     do
      158     on error undo, return error return-value
      159     :
      160       find first buf_temp-trndocrs-pl-gds-rsrv
      161         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      162         no-error .
      163       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      164         create buf_temp-trndocrs-pl-gds-rsrv .
      165         assign
      166           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      167         .
      168       end.
      169       assign
      170         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
      171         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
      172         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
      173         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
      174       .
      175     end.
      176   end procedure.
      177   procedure trndocrs-gds-dtl-accum :
      178     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
      179     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
      180     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
      181     do
      182     on error undo, return error return-value
      183     :
      184       find first buf_temp-trndocrs-gds-dtl-rsrv
      185         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      186         no-error .
      187       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
      188         create buf_temp-trndocrs-gds-dtl-rsrv .
      189         assign
      190           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      191         .
      192       end.
      193       assign
      194         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      195                                                + p-rsrv-qnty
      196       .
      197     end.
      198   end procedure.
      199   procedure trndocrs-pl-gds-request :
      200     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      201     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      202     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      203     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      204     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
      205     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      206     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      207     define input parameter p-field-accum            as character no-undo .
      208     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
      209     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      210     do
      211     on error undo, return error return-value
      212     :
      213       if lookup(p-field-accum, "before,after":u ) = 0 then do:
      214         message
      215           vss-workfile vss-revision vss-description skip
      216           vss-include-info0 skip
      217           "Ошибка задания входных параметров параметров" skip
      218           "Неизвестное значение параметра" skip
      219           "p-field-accum" p-field-accum skip
      220           view-as alert-box error .
      221         undo, return error return-value .
      222       end.
      223       case p-field-accum :
      224         when "before":u then do:
      225           for each buf_temp-trndocrs-pl-gds-rsrv
      226           on error undo, return error return-value
      227           :
      228             assign
      229               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
      230               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
      231             .
      232           end.
      233         end.
      234         when "after":u then do:
      235           for each buf_temp-trndocrs-pl-gds-rsrv
      236           on error undo, return error return-value
      237           :
      238             assign
      239               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
      240               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
      241             .
      242           end.
      243         end.
      244         otherwise do:
      245           message
      246             vss-workfile vss-revision vss-description skip
      247             vss-include-info0 skip
      248             "Ошибка задания входных параметров параметров" skip
      249             "Неизвестное значение параметра" skip
      250             "p-field-accum" p-field-accum skip
      251             view-as alert-box error .
      252           undo, return error return-value .
      253         end.
      254       end.
      255       define buffer buf_parts for ub.parts.
      256       for each buf_parts no-lock
      257         where buf_parts.out-code  = p-doc-code
      258           and buf_parts.obj-type  = p-obj-type
      259           and buf_parts.obj-code  = p-obj-code
      260           and buf_parts.artic     = p-artic
      261           and buf_parts.prod-type = p-prod-type
      262           and buf_parts.prod-code = p-prod-code
      263       on error undo, return error return-value
      264       :
      265         find first buf_temp-trndocrs-pl-gds-rsrv
      266           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      267           no-error .
      268         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      269           create buf_temp-trndocrs-pl-gds-rsrv .
      270           assign
      271             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      272           .
      273         end.
      274         if can-do('при,рас,спи':U, p-doc-type)
      275         or (p-doc-type = 'инв':U
      276             and buf_parts.fact-qnty < 0)
      277         then do:
      278           case p-field-accum :
      279             when "before":u then do:
      280               assign
      281                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      282                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      283                   + abs(buf_parts.fact-qnty)
      284               .
      285             end.
      286             when "after":u then do:
      287               assign
      288                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      289                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      290                   + abs(buf_parts.fact-qnty)
      291               .
      292             end.
      293             otherwise do:
      294               message
      295                 vss-workfile vss-revision vss-description skip
      296                 vss-include-info0 skip
      297                 "Ошибка задания входных параметров параметров" skip
      298                 "Неизвестное значение параметра" skip
      299                 "p-field-accum" p-field-accum skip
      300                 view-as alert-box error .
      301               undo, return error return-value .
      302             end.
      303           end.
      304         end.
      305         else do:
      306           case p-field-accum :
      307             when "before":u then do:
      308               assign
      309                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      310                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      311                   + abs(buf_parts.fact-qnty)
      312               .
      313             end.
      314             when "after":u then do:
      315               assign
      316                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      317                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      318                   + abs(buf_parts.fact-qnty)
      319               .
      320             end.
      321             otherwise do:
      322               message
      323                 vss-workfile vss-revision vss-description skip
      324                 vss-include-info0 skip
      325                 "Ошибка задания входных параметров параметров" skip
      326                 "Неизвестное значение параметра" skip
      327                 "p-field-accum" p-field-accum skip
      328                 view-as alert-box error .
      329               undo, return error return-value .
      330             end.
      331           end.
      332         end.
      333       end.
      334     end.
      335   end procedure.
      336   procedure trndocrs-pl-gds-calc-rsrv :
      337     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
      338     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      339     do
      340     on error undo, return error return-value
      341     :
      342       for each buf_temp-trndocrs-pl-gds-rsrv
      343       on error undo, return error return-value
      344       :
      345         assign
      346           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      347             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      348             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      349           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
      350             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      351             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      352         .
      353       end.
      354     end.
      355   end procedure.
      356   procedure trndocrs-need-rsrv :
      357     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
      358     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
      359     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
      360     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
      361     define output parameter p-need-rsrv    as logical   no-undo .
      362     define buffer buf_goods   for ub.goods .
      363     do
      364     on error undo, return error return-value
      365     :
      366       find first buf_goods no-lock
      367         where buf_goods.artic     = p-artic
      368           and buf_goods.prod-type = p-prod-type
      369           and buf_goods.prod-code = p-prod-code
      370         .
      371       if buf_goods.gds-type = 'т':U
      372       and ( p-doc-type = 'рас':U
      373             or p-doc-type = 'спи':U
      374           )
      375       then do:
      376         assign
      377           p-need-rsrv = true
      378         .
      379       end.
      380       else do:
      381         assign
      382           p-need-rsrv = false
      383         .
      384       end.
      385     end.
      386   end procedure.
      387   procedure trndocrs-need-create-doc-pl :
      388     define input  parameter p-extended-doc-type  as character no-undo .
      389     define input  parameter p-news               as logical   no-undo .
      390     define input  parameter p-sale-auto          as logical   no-undo .
      391     define output parameter p-need-create-doc-pl as logical   no-undo .
      392     do
      393     on error undo, return error return-value
      394     :
      395       if  not p-news
      396       and p-extended-doc-type <> 'ie':U
      397       and p-extended-doc-type <> 'es':U
      398       and p-extended-doc-type <> 'rs':U
      399       and not p-sale-auto
      400       then do:
      401         assign
      402           p-need-create-doc-pl = true
      403         .
      404       end.
      405       else do:
      406         assign
      407           p-need-create-doc-pl = false
      408         .
      409       end.
      410     end.
      411   end procedure.
      412   procedure trndocrs-validate :
      413     define input parameter p-place-rsrv as logical no-undo .
      414     define input parameter p-chg-qnty   as decimal no-undo .
      415     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      416     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      417     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
      418     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
      419     assign
      420       v-total-gds-dtl-rsrv-qnty = 0
      421       v-total-pl-gds-rsrv-qnty  = 0
      422     .
      423     do
      424     on error undo, return error return-value
      425     :
      426       for each buf_temp-trndocrs-gds-dtl-rsrv
      427       on error undo, return error return-value
      428       :
      429         assign
      430           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
      431                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      432         .
      433       end.
      434       for each buf_temp-trndocrs-pl-gds-rsrv
      435       on error undo, return error return-value
      436       :
      437         assign
      438           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
      439                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      440         .
      441       end.
      442       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      443         message
      444           vss-workfile vss-revision vss-description skip
      445           vss-include-info0 skip
      446           "Ошибка при резервировании свободных количеств" skip
      447           "Запрошено резервирование:" skip
      448           "По товару" p-chg-qnty skip
      449           "По признакам" v-total-gds-dtl-rsrv-qnty skip
      450           "По складским местам" v-total-pl-gds-rsrv-qnty skip
      451           view-as alert-box error .
      452         undo, return error return-value .
      453       end.
      454       if p-place-rsrv then do:
      455         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      456           message
      457             vss-workfile vss-revision vss-description skip
      458             vss-include-info0 skip
      459             "Ошибка при резервировании свободных количеств" skip
      460             "Запрошено резервирование:" skip
      461             "По товару" p-chg-qnty skip
      462             "По признакам" v-total-gds-dtl-rsrv-qnty skip
      463             "По складским местам" v-total-pl-gds-rsrv-qnty skip
      464             view-as alert-box error .
      465           undo, return error return-value .
      466         end.
      467       end.
      468     end.
      469   end procedure.
      470   procedure trndocrs :
      471     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
      472     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
      473     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
      474     define input parameter p-artic      like ub.doc-line.artic     no-undo .
      475     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
      476     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
      477     define input parameter p-chg-qnty   as decimal no-undo .
      478     define buffer buf_db         for ub.db .
      479     define buffer buf_gds-obj    for ub.gds-obj .
      480     define buffer buf_prt-obj    for ub.prt-obj .
      481     define buffer buf_gds-prt    for ub.gds-prt .
      482     define buffer buf_goods      for ub.goods .
      483     define buffer buf_pl-gds     for ub.pl-gds .
      484     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      485     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      486     define variable v-node-code   like ub.gds-prt.node-code no-undo .
      487     define variable v-curr-db-num like ub.db.db-num         no-undo .
      488     define variable v-cmd         as   character            no-undo .
      489     do
      490     on error undo, return error return-value
      491     :
      492   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      493   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      494     (input  p-obj-type
      495     ,input  p-obj-code
      496     ,input  p-artic
      497     ,input  p-prod-type
      498     ,input  p-prod-code
      499     ,buffer buf_gds-obj
      500     ) no-error .
      501       if error-status :error then do:
      502         message
      503           vss-workfile vss-revision vss-description skip
      504           vss-include-info0 skip
      505           "Ошибка при поиске товара на объекте" skip
      506           "p-obj-type"  p-obj-type  skip
      507           "p-obj-code"  p-obj-code  skip
      508           "p-artic"     p-artic     skip
      509           "p-prod-type" p-prod-type skip
      510           "p-prod-code" p-prod-code skip
      511           error-status :get-message(1) skip
      512           return-value skip
      513           view-as alert-box error .
      514         undo, return error return-value .
      515       end.
      516       find current buf_gds-obj exclusive-lock .
      517       run trndocrs-validate in this-procedure
      518         (input buf_gds-obj.place-rsrv
      519         ,input p-chg-qnty
      520         ) no-error .
      521       if error-status :error then do:
      522         message
      523           vss-workfile vss-revision vss-description skip
      524           vss-include-info0 skip
      525           "Противоречивые данные для резервирования" skip
      526           error-status :get-message(1) skip
      527           return-value skip
      528           view-as alert-box error .
      529         undo, return error return-value .
      530       end.
      531       assign
      532         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
      533         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
      534       .
      535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      536     (input ?
      537     ,input this-procedure:handle
      538     ,input ?
      539     ,input  'rest-update':U
      540     ,input ?
      541     ,input  buffer buf_gds-obj:handle
      542     ,input 'fact-qnty,free-qnty'
      543     ,input ''
      544     ) no-error .
      545   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      547     (output v-curr-db-num
      548     )  .
      549       find first buf_db no-lock
      550         where buf_db.db-num = v-curr-db-num
      551         .
      552       if buf_db.db-num <> 0
      553         and buf_db.on-line-rest = true
      554       then do:
      555         assign
      556           v-cmd = "command":U + chr(1)
      557                   + "create":U + chr(1)
      558                   + "on-line-rest":U + chr(1)
      559                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
      560                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
      561                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
      562                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
      563                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
      564                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
      565         .
      566         run nws/cr-route.p
      567           ( input 'send-cmd':U
      568             ,input v-cmd
      569             ,input ?
      570             ,input "0":U
      571           ).
      572       end.
      573       if buf_gds-obj.place-rsrv = true then do:
      574         for each buf_temp-trndocrs-pl-gds-rsrv
      575         on error undo, return error return-value
      576         :
      577           find first buf_goods no-lock
      578             where buf_goods.artic     = p-artic
      579               and buf_goods.prod-type = p-prod-type
      580               and buf_goods.prod-code = p-prod-code
      581             no-error .
      582           if not available buf_goods then do:
      583             message
      584               vss-workfile vss-revision vss-description skip
      585               vss-include-info0 skip
      586               "Не найдена товар" skip
      587               "Артикул" p-artic p-prod-type p-prod-code skip
      588               view-as alert-box error .
      589             undo, return error return-value .
      590           end.
      591           find first buf_pl-gds exclusive-lock
      592             where buf_pl-gds.obj-type = p-obj-type
      593               and buf_pl-gds.obj-code = p-obj-code
      594               and buf_pl-gds.gds-code = buf_goods.gds-code
      595               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
      596             no-error .
      597           if not available buf_pl-gds then do:
      598             message
      599               vss-workfile vss-revision vss-description skip
      600               vss-include-info0 skip
      601               "Не найдена привязка товара к складскому месту" skip
      602               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
      603               view-as alert-box error .
      604             undo, return error return-value .
      605           end.
      606           assign
      607             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      608             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
      609           .
      610           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
      611             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
      612           then do:
      613             assign
      614               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
      615             .
      616           end.
      617         end.
      618       end.
      619       for each buf_temp-trndocrs-gds-dtl-rsrv
      620       on error undo, return error return-value
      621       :
      622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
      623     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
      624     ,output v-node-code
      625     ) no-error .
      626         if error-status :error then do:
      627           message
      628             vss-workfile vss-revision vss-description skip
      629             vss-include-info0 skip
      630             "Ошибка при определении первого терминального признака" skip
      631             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
      632             view-as alert-box error .
      633           undo, return error return-value .
      634         end.
      635         find first buf_gds-prt no-lock
      636           where buf_gds-prt.node-code = v-node-code
      637           .
      638         do while available buf_gds-prt
      639         on error undo, return error return-value
      640         :
      641   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
      643     (input  p-obj-type
      644     ,input  p-obj-code
      645     ,input  p-artic
      646     ,input  p-prod-type
      647     ,input  p-prod-code
      648     ,input  buf_gds-prt.node-code
      649     ,buffer buf_prt-obj
      650     )  .
      651           find current buf_prt-obj exclusive-lock .
      652           assign
      653             buf_prt-obj.free-qnty = buf_prt-obj.free-qnty - buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      654           .
      655           assign
      656             v-node-code = buf_gds-prt.upper-code
      657           .
      658           find first buf_gds-prt no-lock
      659             where buf_gds-prt.node-code = v-node-code
      660             no-error .
      661         end.
      662       end.
      663     end.
      664   end procedure.
      665   main-block :
      666   do transaction
      667   on error undo, return error
      668   :
      669     output to partbase.txt append .
      670     export
      671       p-artic
      672       p-prod-type
      673       p-prod-code
      674       p-in-code
      675       p-part-code
      676       p-price-base
      677       p-price-rubl
      678       .
      679     output close .
      680     run trg/nu_trnhd.p
      681       (input p-in-code
      682       ) no-error .
      683     if error-status :error then do:
      684       message
      685         vss-workfile vss-revision vss-description skip
      686         "Ошибка при выполнении процедуры nu_trnhd.p" skip
      687         view-as alert-box .
      688       undo main-block, return error .
      689     end.
      690     for each ub.parts exclusive-lock
      691       where ub.parts.artic     = p-artic
      692         and ub.parts.prod-type = p-prod-type
      693         and ub.parts.prod-code = p-prod-code
      694         and ub.parts.in-code   = p-in-code
      695         and ub.parts.part-code = p-part-code
      696     on error undo, return error return-value
      697     :
      698       output to partbase.fix append .
      699       export parts .
      700       output close .
      701       assign
      702         ub.parts.price-base = p-price-base
      703         ub.parts.price-rubl = p-price-rubl
      704       .
      705       if ub.parts.vat-type = 'в т. ч.':U or
      706          ub.parts.vat-type = 'нет':U  then do:
      707          assign
      708            ub.parts.vat-pc = p-vat-pc.
      709       end.
      710       if ub.parts.slt-type = 'в т. ч.':U or
      711          ub.parts.slt-type = 'нет':U  then do:
      712          assign
      713            ub.parts.slt-pc = p-slt-pc.
      714       end.
      715       if  ub.parts.out-code <> 'free-zone':U
      716       and ub.parts.out-code <> 'out-zone':U
      717       then do:
      718         find first ub.doc-line exclusive-lock
      719           where ub.doc-line.doc-code  = ub.parts.out-code
      720             and ub.doc-line.artic     = ub.parts.artic
      721             and ub.doc-line.prod-type = ub.parts.prod-type
      722             and ub.doc-line.prod-code = ub.parts.prod-code
      723           no-error.
      724         if available ub.doc-line then do:
      725           run trg/rsrv-gds.p
      726             (input parparentproc
      727             ,buffer ub.doc-line
      728             ,input  0
      729             ,input  0
      730             ,input table temp-trndocrs-gds-dtl-rsrv
      731             ,input table temp-trndocrs-pl-gds-rsrv
      732             ).
      733           run trg/nu_trnhd.p
      734             (input ub.parts.out-code
      735             ) no-error .
      736           if error-status :error then do:
      737             message
      738               vss-workfile vss-revision vss-description skip
      739               "Ошибка при выполнении процедуры nu_trnhd.p" skip
      740               "p-doc-code" ub.parts.out-code skip
      741               view-as alert-box .
      742             undo main-block, return error .
      743           end.
      744         end.
      745         else do:
      746           find first ub.price-list where ub.price-list.doc-num = ub.parts.out-code exclusive-lock .
      747           run trg/nu_prc.p
      748           (input ub.price-list.doc-num
      749           ,input 'price-doc':U
      750           ,input ub.price-list.obj-type
      751           ,input ub.price-list.obj-code
      752           ) no-error .
      753         end.
      754       end.
      755     end.
      756   end.
