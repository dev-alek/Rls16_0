        1   define variable vss-revision    as character no-undo initial "$Revision$":U .
        2   define variable vss-author      as character no-undo initial "$Author$":U .
        3   define variable vss-date        as character no-undo initial "$Date$":U .
        4   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        5   define variable vss-archive     as character no-undo initial "$Archive$":U .
        6   define variable vss-description as character no-undo initial "Выбор шкалы для сортировки признаков".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define   shared variable g#auto as logical no-undo.
       68   define   shared variable g#news as logical no-undo.
       69   define   shared variable g#oxml as logical no-undo.
       70   define   shared variable g#esys as logical no-undo.
       71   define   shared variable g#news-source-db as integer no-undo.
       72   define   shared variable g#esys-source-esys as integer no-undo.
       73   define   shared variable g#db-num as integer   no-undo .
       74   define   shared variable g#userid as character no-undo .
       75   define   shared variable g#passwd as character no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define temp-table temp-prt-root no-undo     field node-code  as integer label 'Код'     field node-name like gds-prt.node-name format 'x(40)' label 'Название'     index pk is primary unique node-code     index ie1 node-name     .
      122   define variable v-node-code as integer   no-undo .
      123   define variable v-level     as integer   no-undo .
      124   define query temp-prt-root for temp-prt-root .
      125   define browse temp-prt-root query temp-prt-root
      126          display temp-prt-root.node-name
      127          with size 45 by 13.7 no-labels separators .
      128   define button b-exit auto-go default
      129        LABEL "&Выход"
      130        SIZE 10 BY 1.
      131   define button b-sel
      132        LABEL "Вы&бор"
      133        SIZE 10 BY 1.
      134   define button b-help
      135       label "Помо&щь"
      136        SIZE 10 BY 1.
      137   define FRAME f-rengd
      138     b-exit        AT ROW  1   COL  1
      139     b-sel         AT ROW  1   COL 11
      140     b-help        AT ROW  1   COL 21
      141     "Редактирование названий признаков шкалы"  AT ROW  2   COL 1
      142     temp-prt-root AT ROW  4   COL  1
      143   WITH VIEW-AS DIALOG-BOX SCROLLABLE SIDE-LABELS THREE-D DEFAULT-BUTTON b-exit TITLE "".
      144   on choose of b-sel
      145   or return of temp-prt-root
      146   or default-action of temp-prt-root
      147   do:
      148     if available temp-prt-root
      149     then do:
      150       run utl/ren-grp.w
      151         (input temp-prt-root.node-code
      152         ) .
      153     end.
      154   end.
      155   do
      156   on error undo, return error return-value
      157   :
      158     define buffer buf_sys-ctrl for ub.sys-ctrl .
      159     find first buf_sys-ctrl no-lock .
      160     if buf_sys-ctrl.db-num <> 0
      161     then do:
      162       message
      163         vss-workfile vss-revision vss-description skip
      164         "Процедура переименования признака шкалы может запускаться только в ГБД"
      165         view-as alert-box error .
      166       undo, return error .
      167     end.
      168     run fill-temp-table in this-procedure .
      169     open query temp-prt-root for each temp-prt-root .
      170     enable
      171       temp-prt-root b-exit b-sel b-help
      172       with frame f-rengd.
      173     apply 'entry':u to temp-prt-root .
      174     wait-for go of frame f-rengd.
      175   end.
      176   procedure fill-temp-table :
      177     define buffer buf_gds-prt for ub.gds-prt .
      178     define buffer buf_temp-prt-root for temp-prt-root .
      179     do
      180     on error undo, return error return-value
      181     :
      182       define variable v-prt-level as integer   no-undo .
      183       for each buf_gds-prt no-lock
      184         where buf_gds-prt.root = true
      185           and buf_gds-prt.node-name <> '_Пустая шкала':U
      186       on error undo, return error
      187       :
      188         create buf_temp-prt-root .
      189         assign
      190           buf_temp-prt-root.node-code = buf_gds-prt.node-code
      191           buf_temp-prt-root.node-name = buf_gds-prt.node-name
      192         .
      193       end.
      194     end.
      195   end procedure.
