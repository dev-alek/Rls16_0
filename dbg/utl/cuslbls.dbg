        1   DEFINE BUFFER X_custom-labels FOR ub.custom-labels.
        2   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   DEFINE INPUT PARAMETER bttns AS character NO-UNDO.
        4   DEFINE INPUT PARAMETER p-list-mode AS character NO-UNDO.
        5   DEFINE INPUT-OUTPUT PARAMETER p-rid-list AS character NO-UNDO.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Список настраиваемых полей".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define new global shared variable g#language as character no-undo .
      319   if g#language <> '' and g#language <> 'rus':U then do:
      320     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      321   end.
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368     define variable v-cntxt-db-num        as integer   no-undo .
      369     define variable v-cntxt-userid        as character no-undo .
      370     define variable v-cntxt-level         as character no-undo .
      371     define variable v-cntxt-host-code-obj as integer   no-undo .
      372     define variable v-cntxt-obj-type      as character no-undo .
      373     define variable v-cntxt-obj-code      as integer   no-undo .
      374     define variable v-cntxt-db-num-obj    as integer   no-undo .
      375     define variable v-cntxt-is-admin      as logical   no-undo .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   procedure cur-time :
      378      define output parameter p-today as date      no-undo .
      379      define output parameter p-time  as integer   no-undo .
      380     do
      381     on error undo, return error
      382     :
      383       define variable v-date1 as date      no-undo .
      384       define variable v-date2 as date      no-undo .
      385       define variable v-time  as integer   no-undo .
      386       assign
      387         v-date1 = today
      388         v-time  = time
      389         v-date2 = today
      390       .
      391       if v-date1 <> v-date2
      392       then do:
      393         assign
      394           v-date1 = today
      395           v-time  = v-time
      396         .
      397       end.
      398       assign
      399         p-today = v-date1
      400         p-time  = v-time
      401       .
      402     end.
      403   end.
      404   function cur-time-date returns character
      405   :
      406     return string(today, '99/99/9999':U) .
      407   end.
      408   function cur-time-mjd returns decimal
      409   :
      410     define variable v-date as date      no-undo .
      411     define variable v-time as integer   no-undo .
      412     run cur-time in this-procedure
      413       (output v-date
      414       ,output v-time
      415       ) .
      416     return integer(v-date) - 2400002 + (v-time / 86400) .
      417   end.
      418   function cur-time-get-ending-index returns integer
      419   (input p-number as integer
      420   )
      421   :
      422     if p-number < 0
      423     or p-number = ?
      424     then do:
      425       return 1 .
      426     end.
      427     define variable v-rest as integer   no-undo .
      428     assign
      429       p-number = p-number modulo 100
      430     .
      431     if p-number < 20
      432     then do:
      433       assign
      434         v-rest = p-number
      435       .
      436     end.
      437     else do:
      438       assign
      439         v-rest = p-number modulo 10
      440       .
      441     end.
      442     case v-rest :
      443       when 1
      444       then do:
      445         return 2 .
      446       end.
      447       when 2 or
      448       when 3 or
      449       when 4
      450       then do:
      451         return 3 .
      452       end.
      453       otherwise do:
      454         return 1 .
      455       end.
      456     end case .
      457   end.
      458   procedure cur-time-mjd-to-date :
      459      define input  parameter i-mjd-diff as decimal no-undo.
      460      define output parameter o-Date     as date    no-undo.
      461      define output parameter o-Time     as integer no-undo.
      462      define variable v-day-number as integer   no-undo .
      463      if    i-mjd-diff < 0
      464         or i-mjd-diff = ?
      465      then do:
      466         return "?" .
      467      end.
      468      assign
      469         v-day-number = truncate(i-mjd-diff,0).
      470         o-Date = date(v-day-number + 2400002).
      471         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      472     .
      473   end.
      474   function cur-time-mjd-to-string returns character
      475   (input p-mjd-diff as decimal
      476   )
      477   :
      478     define variable v-day-number as integer   no-undo .
      479     define variable v-seconds    as integer   no-undo .
      480     define variable v-hour       as integer   no-undo .
      481     define variable v-min        as integer   no-undo .
      482     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      483     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      484     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      485     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      486     if p-mjd-diff < 0
      487     or p-mjd-diff = ?
      488     then do:
      489       return "?" .
      490     end.
      491     assign
      492       v-day-number = integer(truncate(p-mjd-diff,0))
      493       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      494     .
      495     if v-seconds > 86400
      496     then do:
      497       assign
      498         v-seconds = 86400 - 1
      499       .
      500     end.
      501     if v-seconds < 0
      502     then do:
      503       assign
      504         v-seconds = 0
      505       .
      506     end.
      507     assign
      508       v-hour = truncate(v-seconds / 3600, 0)
      509     .
      510     assign
      511       v-seconds = v-seconds modulo 3600
      512     .
      513     assign
      514       v-min = truncate(v-seconds / 60, 0)
      515     .
      516     assign
      517       v-seconds = v-seconds modulo 60
      518     .
      519     return
      520         (if v-day-number <> 0
      521           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      522           else ""
      523         )
      524       + (if v-day-number <> 0 or v-hour <> 0
      525           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      526           else ""
      527         )
      528       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      529           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      530           else ""
      531         )
      532       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      533       .
      534   end.
      535   function cur-time-string returns character
      536   :
      537     define variable v-date as date      no-undo .
      538     define variable v-time as integer   no-undo .
      539     run cur-time in this-procedure
      540       (output v-date
      541       ,output v-time
      542       ) .
      543     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      544   end.
      545   function cur-time-string-sec returns character
      546   :
      547     define variable v-date as date      no-undo .
      548     define variable v-time as integer   no-undo .
      549     run cur-time in this-procedure
      550       (output v-date
      551       ,output v-time
      552       ) .
      553     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      554   end.
      555   function cur-time-custom  returns character
      556   (input p-prefix as character
      557   ,input p-date-format as character
      558   ,input p-delimiter as character
      559   ,input p-time-format as character
      560   ,input p-suffix as character
      561   )
      562   :
      563     define variable v-date as date      no-undo .
      564     define variable v-time as integer   no-undo .
      565     run cur-time in this-procedure
      566       (output v-date
      567       ,output v-time
      568       ) .
      569     return
      570       p-prefix
      571       + string(v-date, p-date-format)
      572       + p-delimiter
      573       + string(v-time, p-time-format)
      574       + p-suffix
      575       .
      576   end.
      577   function cur-time-print  returns character
      578   :
      579     define variable v-date as date      no-undo .
      580     define variable v-time as integer   no-undo .
      581     run cur-time in this-procedure
      582       (output v-date
      583       ,output v-time
      584       ) .
      585     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      586   end.
      587   function cur-time-datetime returns datetime
      588   :
      589     define variable v-char as character no-undo .
      590     define variable v-datetime as datetime no-undo .
      591     v-char = cur-time-string().
      592     v-datetime = datetime(v-char).
      593     return  v-datetime.
      594   end.
      595   function cur-time-string-msec returns character
      596   :
      597     define variable v-date as datetime  no-undo .
      598     v-date = now.
      599     return string(v-date) .
      600   end.
      601   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      602   define variable v-sys-key as character no-undo .
      603   define variable v-ibs as logical no-undo .
      604   define variable glog as logical no-undo .
      605   DEFINE BUTTON b-add
      606        LABEL "&Добавить"
      607        SIZE 10 BY 1.
      608   DEFINE BUTTON b-chg
      609        LABEL "&Изменить"
      610        SIZE 10 BY 1.
      611   DEFINE BUTTON b-copy
      612        LABEL "&Копировать"
      613        SIZE 10 BY 1.
      614   DEFINE BUTTON b-del
      615        LABEL "&Удалить"
      616        SIZE 10 BY 1.
      617   DEFINE BUTTON b-export
      618        LABEL "&Экспорт"
      619        SIZE 10 BY 1.
      620   DEFINE BUTTON B-Help
      621        LABEL "Помо&щь"
      622        SIZE 3 BY 1
      623        BGCOLOR 8 .
      624   DEFINE BUTTON b-lkp
      625        LABEL "&Просмотр"
      626        SIZE 10 BY 1.
      627   DEFINE BUTTON b-mark
      628        LABEL "&*"
      629        SIZE 4 BY 1.
      630   DEFINE BUTTON b-quit AUTO-END-KEY
      631        LABEL "&Выход"
      632        SIZE 10 BY 1
      633        BGCOLOR 8 .
      634   DEFINE BUTTON b-sel AUTO-GO
      635        LABEL "Выбор"
      636        SIZE 10 BY 1.
      637   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      638         VIEW-AS TEXT
      639        SIZE 9 BY .67
      640        FGCOLOR 10  NO-UNDO.
      641   DEFINE QUERY br-custom-labels FOR
      642         X_custom-labels SCROLLING.
      643   DEFINE BROWSE br-custom-labels
      644     QUERY br-custom-labels NO-LOCK DISPLAY
      645         X_custom-labels.CALL-TYPE FORMAT "X(20)"
      646   X_custom-labels.CALL-point FORMAT "X(20)"
      647   X_custom-labels.tbl-name FORMAT "X(20)"
      648   X_custom-labels.fld-name FORMAT "X(20)"
      649   X_custom-labels.LANGUAGE FORMAT "X(3)"
      650       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.3 BY 20.5 FIT-LAST-COLUMN.
      651   DEFINE FRAME Dialog-Frame
      652        b-quit AT ROW 1 COL 1
      653        b-mark AT ROW 1 COL 21 WIDGET-ID 12
      654        b-sel AT ROW 1 COL 25 WIDGET-ID 10
      655        b-add AT ROW 1 COL 35 WIDGET-ID 2
      656        b-copy AT ROW 1 COL 45 WIDGET-ID 18
      657        b-chg AT ROW 1 COL 55 WIDGET-ID 4
      658        b-lkp AT ROW 1 COL 65 WIDGET-ID 6
      659        b-del AT ROW 1 COL 75 WIDGET-ID 16
      660        b-export AT ROW 1 COL 85 WIDGET-ID 22
      661        B-Help AT ROW 1 COL 95
      662        br-custom-labels AT ROW 2.5 COL 1.5 WIDGET-ID 100
      663        mark-num AT ROW 1 COL 11 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      664        SPACE(77.75) SKIP(21.53)
      665       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      666            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      667            TITLE ""
      668            CANCEL-BUTTON b-quit.
      669   ASSIGN
      670          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      671          FRAME Dialog-Frame:HIDDEN           = TRUE.
      672   ON GO OF FRAME Dialog-Frame
      673   DO:
      674     p-rid-list = v-rid-list.
      675   END.
      676   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      677   DO:
      678     APPLY "END-ERROR":U TO SELF.
      679   END.
      680   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      681   DO:
      682   DEFINE VARIABLE v-rec AS RECID no-unDO.
      683      run utl/cuslabli.w ( input parparentproc
      684                          ,input 'ДОБАВЛЕНИЕ':U
      685                          ,input '':U
      686                          ,input '':U
      687                          ,input '':U
      688                          ,input '':U
      689                          ,input '':U
      690                          ,input-output v-rec) no-error.
      691     if v-rec <> ? then do:
      692       OPEN QUERY br-custom-labels FOR EACH X_custom-labels NO-LOCK INDEXED-REPOSITION.
      693       REPOSITION br-custom-labels TO RECID v-rec NO-ERROR.
      694       APPLY "value-changed" to br-custom-labels.
      695     end.
      696   END.
      697   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      698   DO:
      699   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      700    IF NOT AVAILABLE X_custom-labels THEN RETURN NO-APPLY.
      701     v-rec = recid(X_custom-labels).
      702     run utl/cuslabli.w ( input parparentproc
      703                          ,input 'ИЗМЕНЕНИЕ':U
      704                          ,input X_custom-labels.tbl-name
      705                          ,input X_custom-labels.fld-name
      706                          ,input X_custom-labels.CALL-TYPE
      707                          ,input X_custom-labels.call-point
      708                          ,input X_custom-labels.LANGUAGE
      709                          ,input-output v-rec) no-error.
      710     if v-rec <> ? then do:
      711       OPEN QUERY br-custom-labels FOR EACH X_custom-labels NO-LOCK INDEXED-REPOSITION.
      712       REPOSITION br-custom-labels TO RECID v-rec NO-ERROR.
      713       APPLY "value-changed" to br-custom-labels.
      714     end.
      715   END.
      716   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
      717   DO:
      718   DEFINE VARIABLE v-rec AS RECID no-unDO.
      719   IF NOT available X_custom-labels THEN RETURN NO-APPLY.
      720      run utl/cuslabli.w ( input parparentproc
      721                          ,input 'КОПИРОВАНИЕ':U
      722                          ,input X_custom-labels.tbl-name
      723                          ,input X_custom-labels.fld-name
      724                          ,input X_custom-labels.call-type
      725                          ,input X_custom-labels.call-point
      726                          ,input X_custom-labels.language
      727                          ,input-output v-rec) no-error.
      728     if v-rec <> ? then do:
      729       OPEN QUERY br-custom-labels FOR EACH X_custom-labels NO-LOCK INDEXED-REPOSITION.
      730       REPOSITION br-custom-labels TO RECID v-rec NO-ERROR.
      731       APPLY "value-changed" to br-custom-labels.
      732     end.
      733   END.
      734   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      735   DO:
      736     define variable v-rec as recid no-undo.
      737     define variable glog as logical no-undo.
      738     if not available X_custom-labels then return no-apply.
      739     v-rec = recid(X_custom-labels).
      740     message "Вы уверены, что хотите удалить поле?"
      741     view-as alert-box question buttons yes-no update glog.
      742     if not glog then return no-apply.
      743    run utl/cuslabl3.p ( input no
      744                          ,input v-rec) no-error.
      745    if error-status:error then return no-apply.
      746    OPEN QUERY br-custom-labels FOR EACH X_custom-labels NO-LOCK INDEXED-REPOSITION.
      747    REPOSITION br-custom-labels TO ROW 1 NO-ERROR.
      748    APPLY "value-changed" to br-custom-labels.
      749   END.
      750   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      751   DO:
      752   define variable v-file-name as character no-undo .
      753   define variable v-old-file-name as character no-undo .
      754   define variable v-dir-name as character no-undo .
      755   define variable v-yesno as logical no-undo .
      756   define variable v-mode-log as logical no-undo .
      757   define variable v-mode as character no-undo .
      758   message
      759   "Хотите экспортировать уникальное имя каждой записи (uniq-key-rec)?"
      760   view-as alert-box question buttons yes-no-cancel update v-mode-log.
      761   if v-mode-log = ? then return no-apply.
      762   if v-mode-log then do:
      763     v-mode = "full".
      764   end.
      765   message
      766   "Хотите экспортировать ПОЛНУЮ конфигурацию правил НАСТРАИВАЕМЫХ ПОЛЕЙк" skip
      767   "или только измененные записи?"
      768   view-as alert-box question buttons yes-no-cancel update v-yesno.
      769   if v-yesno = ? then return no-apply.
      770   if v-yesno = no then do:
      771     run gbl/d-file.p (
      772           input-output v-old-file-name
      773         , input-output v-dir-name
      774         , input  (" Все файлы txt (*.txt) ")
      775         , input  ("*.txt":U)
      776         , input  chr(44)
      777         , input  (".txt":U)
      778         , input  yes
      779         , input  no
      780         , input  yes
      781         , input  "Введите имя старого файла (для сравнения)"
      782         , output v-yesno
      783     ) no-error.
      784     if error-status:error
      785     or v-yesno = no then return no-apply.
      786   end.
      787   v-yesno = no.
      788     run gbl/d-file.p (
      789           input-output v-file-name
      790         , input-output v-dir-name
      791         , input  (" Все файлы txt (*.txt) ")
      792         , input  ("*.txt":U)
      793         , input  chr(44)
      794         , input  (".txt":U)
      795         , input  no
      796         , input  yes
      797         , input  yes
      798         , input  "Введите имя файла для экспорта"
      799         , output v-yesno
      800     ) no-error.
      801     if error-status:error
      802     or v-yesno = no then return no-apply.
      803     run utl/excuslab.p (
      804                                    input v-file-name
      805                                   ,input v-old-file-name
      806                                   ,input v-mode
      807                                  ) NO-ERROR.
      808     IF ERROR-STATUS:ERROR THEN DO:
      809        MESSAGE
      810        ERROR-STATUS:GET-MESSAGE(1) SKIP
      811        RETURN-VALUE
      812        VIEW-AS ALERT-BOX.
      813        RETURN NO-APPLY.
      814     END.
      815     define variable v-md5-signature as character no-undo .
      816     define variable v-full-file-name          as character                no-undo .
      817     define variable v-path                    as character                no-undo .
      818     DEFINE VARIABLE v-full-path               as character                no-undo .
      819     DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      820     DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      821     run gbl/md5.p ( input v-file-name
      822                    ,output v-md5-signature ) .
      823     run gbl/filename.p (
      824                    input v-file-name
      825                   ,output v-full-path
      826                   ,output v-path
      827                   ,output v-full-file-name
      828                   ,output v-file-name-no-ext
      829                   ,output v-file-name-ext
      830                   ) no-error .
      831     if error-status:error then do:
      832       message
      833       return-value
      834       view-as alert-box ERROR.
      835       return.
      836     end.
      837     output to value(v-path + chr(47) + v-file-name-no-ext + ".md5").
      838     put unformatted v-md5-signature skip.
      839     output close.
      840   END.
      841   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      842   DO:
      843       DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      844      IF NOT AVAILABLE X_custom-labels THEN RETURN NO-APPLY.
      845       v-rec = recid(X_custom-labels).
      846       run utl/cuslabli.w ( input parparentproc
      847                            ,input 'ПРОСМОТР':U
      848                            ,input X_custom-labels.tbl-name
      849                            ,input X_custom-labels.fld-name
      850                            ,input X_custom-labels.CALL-TYPE
      851                            ,input X_custom-labels.call-point
      852                            ,input X_custom-labels.LANGUAGE
      853                            ,input-output v-rec) no-error.
      854   END.
      855   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      856   DO:
      857     define variable glog as logical no-undo .
      858     if available X_custom-labels then do:
      859   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      860   define variable v-str-recid4 as character no-undo .
      861   define variable v-num-entry4 as integer   no-undo .
      862   assign
      863     v-str-recid4 = trim( string( recid( X_custom-labels ) , "->>>>>>>>>>>9":U ) )
      864     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      865   .
      866   if v-num-entry4 > 0 then do:
      867     assign
      868       entry( v-num-entry4, v-rid-list ) = "":U
      869       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      870     .
      871   end.
      872   else do:
      873     assign
      874       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      875     .
      876   end.
      877     glog = br-custom-labels:refresh() .
      878     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      879         glog = br-custom-labels:select-next-row ().
      880         apply "VALUE-CHANGED" to br-custom-labels in frame Dialog-Frame.
      881     end.
      882     if num-entries( v-rid-list ) = 0
      883     then
      884         hide mark-num in frame Dialog-Frame.
      885     else
      886         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      887   end.
      888   apply "entry" to br-custom-labels in frame Dialog-Frame.
      889   END.
      890   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      891   DO:
      892     if available X_custom-labels then do:
      893       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      894       then  v-rid-list = string( recid( X_custom-labels ) ) .
      895     end.
      896   END.
      897   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      898   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      899   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   on help of frame Dialog-Frame
      901   do:
      902     run gbl/app_help.p
      903       (input this-procedure :file-name
      904       ,input ''
      905       ,input ?
      906       ) no-error.
      907     if error-status :error then do:
      908       message
      909         "Ошибка при вызове помощи"
      910         error-status :get-message(1)
      911         view-as alert-box .
      912     end.
      913   end.
      914   run minbtn-set in this-procedure .
      915   on choose of b-help in frame Dialog-Frame
      916   do:
      917     apply "help":u to frame Dialog-Frame .
      918   end.
      919   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   procedure minbtn-set :
      921       do
      922           on error undo, return error return-value
      923           :
      924           define variable ii              as integer       no-undo .
      925           define variable fh              as widget-handle no-undo .
      926           define variable hh              as widget-handle no-undo .
      927           define variable v-h             as handle        extent 4 no-undo .
      928           define variable v-name-button   as character     no-undo .
      929           define variable v-help-old-x    as decimal       no-undo .
      930           define variable v-help-old-y    as decimal       no-undo .
      931           define variable v-help-old-size as decimal       no-undo .
      932           define variable v-frame-width   as decimal       no-undo .
      933           define variable jj              as integer       no-undo .
      934           do
      935               on error undo, return error
      936               :
      937               assign
      938                   v-frame-width = frame Dialog-Frame:width - 0.3
      939                   fh            = frame Dialog-Frame:first-child
      940                   hh            = fh:first-child
      941                   ii            = 1
      942                   .
      943               do while valid-handle(hh):
      944                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      945                   do:
      946                       case lc(hh:name) :
      947                           when "b-help" then
      948                               do:
      949                                   hh:load-image-up("cmp/b-help.bmp":u) .
      950                                   hh:load-image-down("cmp/b-help.bmp":u) .
      951                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      952                                   hh:TOOLTIP = "Помощь" .
      953                                   v-help-old-x = hh:column .
      954                                   v-help-old-y = hh:row    .
      955                                   v-help-old-size = hh:width .
      956                                   hh:width-chars = 2.5 .
      957                               end.
      958                           when "b-print" then
      959                               do:
      960                                   hh:load-image("cmp/b-print.bmp":u) .
      961                                   hh:TOOLTIP = "Печать" .
      962                                   v-h[ii] = hh:handle .
      963                                   ii = ii + 1 .
      964                                   hh:width-chars = 3 .
      965                               end.
      966                           when "b-history" or
      967                           when "b-hist" then
      968                               do:
      969                                   hh:load-image("cmp/b-hist.bmp":u) .
      970                                   hh:TOOLTIP = "История" .
      971                                   v-h[ii] = hh:handle .
      972                                   ii = ii + 1 .
      973                                   hh:width-chars = 3 .
      974                               end.
      975                           when "b-sch" then
      976                               do:
      977                                   hh:load-image("cmp/b-sch.bmp":u) .
      978                                   hh:TOOLTIP = "Установка Фильтра" .
      979                                   v-h[ii] = hh:handle .
      980                                   ii = ii + 1 .
      981                                   hh:width-chars = 3 .
      982                               end.
      983                           when "b-hist-user" then
      984                               do:
      985                                   hh:load-image("cmp/b-hist.bmp":u) .
      986                                   hh:TOOLTIP = "История пользователя" .
      987                                   ii = ii + 1 .
      988                               end.
      989                       end case.
      990                   end.
      991                   hh = hh:next-sibling.
      992               end.
      993               b-help:column = v-frame-width - b-help:width-chars.
      994               jj = 0.
      995               repeat ii = 4 to 1 by -1 :
      996                   if valid-handle (v-h[ii] ) then
      997                   do:
      998                       jj  = jj + 1 .
      999                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1000                       v-h[ii]:row    = v-help-old-y .
     1001                   end.
     1002               end.
     1003           end.
     1004       end.
     1005   end procedure.
     1006   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1007   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1008   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1009   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1010   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1011   define variable v-diasize-current-frame-height as decimal   no-undo .
     1012   define variable v-diasize-change-size          as logical   no-undo .
     1013   define variable v-diasize-resize-button        as handle    no-undo .
     1014   define variable v-diasize-wndmax               as logical   no-undo .
     1015   define variable v-diasize-wndstore             as logical   no-undo .
     1016   define variable v-diasize-proc-name            as character no-undo .
     1017   define variable v-diasize-browse-handle        as handle    no-undo .
     1018   define variable v-diasize-browse-number        as integer   no-undo .
     1019   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1020   define temp-table temp-diasize-handle no-undo
     1021     field handle-value  as handle
     1022     field save-position as decimal
     1023     index xpk is primary unique handle-value
     1024     .
     1025   define temp-table temp-browse-handle no-undo
     1026     field browse-type   as character
     1027     field browse-number as integer
     1028     field browse-handle as handle
     1029     field original-size as decimal
     1030     index xpk is primary unique browse-type browse-number
     1031     index xie browse-type browse-handle
     1032   .
     1033   procedure diasize_change-height :
     1034     define input  parameter p-change-value  as decimal   no-undo .
     1035     define input  parameter p-move-resize   as logical   no-undo .
     1036     define variable v-field-group-handle    as handle    no-undo .
     1037     define variable v-object-handle         as handle    no-undo .
     1038     define variable v-frame-height          as decimal   no-undo .
     1039     define variable v-frame-virtual-height  as decimal   no-undo .
     1040     define variable v-browse-height         as decimal   no-undo .
     1041     define variable v-window-height         as decimal   no-undo .
     1042     define variable v-window-virtual-height as decimal   no-undo .
     1043     define variable v-change-sign           as integer   no-undo .
     1044     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1045     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1046     if p-change-value > 0
     1047     then do:
     1048       if frame Dialog-Frame :height + p-change-value
     1049           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1050       then do:
     1051         assign
     1052           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1053                           - (frame Dialog-Frame :height-chars)
     1054         .
     1055         if p-change-value <= 0
     1056         then do:
     1057           run diasize_position-resize-button in this-procedure .
     1058           return .
     1059         end.
     1060       end.
     1061     end.
     1062     if p-change-value < 0
     1063     then do:
     1064       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1065       then do:
     1066         assign
     1067           p-change-value = v-diasize-orig-frame-height
     1068                          - (frame Dialog-Frame :height-chars)
     1069         .
     1070         if p-change-value >= 0
     1071         then do:
     1072           run diasize_position-resize-button in this-procedure .
     1073           return .
     1074         end.
     1075       end.
     1076     end.
     1077     if p-change-value >= 0
     1078     then do:
     1079       assign
     1080         v-change-sign = 1
     1081       .
     1082     end.
     1083     else do:
     1084       assign
     1085         v-change-sign = -1
     1086       .
     1087     end.
     1088     assign
     1089       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1090     .
     1091     if p-change-value = 0
     1092     then do:
     1093       run diasize_position-resize-button in this-procedure .
     1094       return .
     1095     end.
     1096     move_block:
     1097     do
     1098     on error undo move_block, retry move_block
