     1416         ,input  p-move-resize
     1417         ) .
     1418     end.
     1419   end procedure.
     1420   procedure diasize_change-width :
     1421     define input  parameter p-change-value as decimal   no-undo .
     1422     define input  parameter p-move-resize  as logical   no-undo .
     1423     define variable v-field-group-handle   as handle    no-undo .
