     1429     define variable v-window-virtual-width as decimal   no-undo .
     1430     define variable v-change-sign          as integer   no-undo .
     1431     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1432     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1433     if p-change-value > 0
     1434     then do:
     1435       if frame Dialog-Frame :width + p-change-value >
     1436           session :width-chars
     1437       then do:
     1438         assign
     1439           p-change-value = session :width-chars - frame Dialog-Frame :width
     1440         .
     1441         if p-change-value <= 0
     1442         then do:
     1443           run diasize_position-resize-button in this-procedure .
     1444           return .
     1445         end.
     1446       end.
     1447     end.
     1448     if p-change-value < 0
     1449     then do:
     1450       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1451       then do:
     1452         assign
     1453           p-change-value = v-diasize-orig-frame-width
     1454                          - frame Dialog-Frame :width
     1455         .
     1456         if p-change-value >= 0
     1457         then do:
     1458           run diasize_position-resize-button in this-procedure .
     1459           return .
     1460         end.
     1461       end.
     1462     end.
     1463     if p-change-value >= 0
     1464     then do:
     1465       assign
     1466         v-change-sign = 1
     1467       .
     1468     end.
     1469     else do:
     1470       assign
     1471         v-change-sign = -1
     1472       .
     1473     end.
     1474     assign
     1475       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1476     .
     1477     if p-change-value = 0
     1478     then do:
     1479       run diasize_position-resize-button in this-procedure .
     1480       return .
     1481     end.
