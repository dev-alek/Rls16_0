        1   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        2   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":u .
        4   define variable vss-author      as character no-undo init "$Author$":u .
        5   define variable vss-date        as character no-undo init "$Date$":u .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        7   define variable vss-archive     as character no-undo init "$Archive$":u .
        8   define variable vss-description as character no-undo init "Утилита копирования чеков с имеющейся закрытой продажи" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   define variable v-waitfram-action01         as character   no-undo .
      114   define variable v-waitfram-action02         as character   no-undo .
      115   define variable v-waitfram-action03         as character   no-undo .
      116   define variable mWaitFramTextBeg            as character   no-undo.
      117   define variable mWaitFramTextEnd            as character   no-undo.
      118   define variable mWaitFramView               as logical     no-undo.
      119   define variable mWaitProcEvent              as logical     no-undo init yes.
      120   define variable mWaitFramInterval           as integer     no-undo init 1 .
      121   define variable mWaitFramStop               as logical     no-undo.
      122   define variable mWaitFramStopUser           as logical     no-undo.
      123   define variable mWaitFramStopTimeOut        as logical     no-undo.
      124   define variable mWaitFramStartProc          as datetime-tz no-undo.
      125   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      126   define button B-WaitFramStop auto-end-key
      127        label "Стоп"
      128        size 10 by 1 tooltip "Остоновить процесс".
      129   define button B-viewProcInfo
      130        label "Информация"
      131        size 15 by 1 tooltip "Информация о процесс".
      132   define frame waitfram
      133     v-waitfram-action01 format "x(72)" no-label skip
      134     v-waitfram-action02 format "x(72)" no-label skip
      135     v-waitfram-action03 format "x(72)" no-label skip
      136     B-viewProcInfo
      137     B-WaitFramStop at row 4 col 30
      138     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      139     .
      140   define new global shared variable mBatchMode as logical no-undo init ?.
      141   define variable mFramBachModHandle as handle no-undo.
      142   mFramBachModHandle = frame waitfram:handle.
      143   define variable mFameOldVis as logical no-undo.
      144   define variable mVisCUrentVin as logical no-undo.
      145   if session:batch-mode
      146   then
      147      mBatchMode = yes.
      148   if mBatchMode = ? then do:
      149     mVisCUrentVin = current-window:visible.
      150     mFameOldVis = mFramBachModHandle:visible.
      151     mFramBachModHandle:visible  = yes.
      152     mBatchMode = mFramBachModHandle:visible ne yes.
      153     mFramBachModHandle:visible = mFameOldVis.
      154     current-window:visible = mVisCUrentVin.
      155   end.
      156    if  log-manager:logfile-name ne ?
      157     then DO:
      158         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      159         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      160         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      161     end.
      162   on choose of B-WaitFramStop in frame waitfram
      163   do:
      164     mWaitFramStop = yes.
      165     mWaitFramStopUser = yes.
      166   end.
      167   function waitfram-check-timeout returns logical():
      168      define variable vtime as int64 no-undo.
      169      if mWaitFramStopTimeOut
      170      then
      171         return yes.
      172      vtime = ( now - mWaitFramStartProc ) / 1000 .
      173      if     mWaitFramTimeOut ne ?
      174         and mWaitFramTimeOut ne 0
      175         and mWaitFramTimeOut lt vtime
      176      then do:
      177         mWaitFramStopTimeOut = yes.
      178      end.
      179      return mWaitFramStopTimeOut.
      180   end.
      181   procedure waitfram-hide :
      182     if not session:batch-mode
      183     then do
      184     on error undo, return error return-value
      185     :
      186       pause 0 before-hide .
      187       if not mBatchMode then
      188         hide frame waitfram .
      189     if     not mWaitFramView
      190        and mWaitProcEvent
      191     then
      192       process events .
      193     end.
      194   end procedure.
      195   procedure waitfram-show :
      196     define input  parameter p-message as character no-undo .
      197     define variable v-left-margin as integer   no-undo .
      198     if not session:batch-mode
      199     then do
      200     on error undo, return error return-value
      201     :
      202       if length(p-message) <= 70 then do:
      203         assign
      204           v-left-margin = integer((70 - length(p-message)) / 2)
      205         .
      206         assign
      207           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      208         .
      209         assign
      210           v-waitfram-action01 = " "
      211           v-waitfram-action02 = " "
      212                                    + fill(" ", v-left-margin)
      213                                    + p-message
      214           v-waitfram-action03 = " "
      215         .
      216       end.
      217       else do:
      218         define variable vRindex1 as integer no-undo.
      219         define variable vRindex2 as integer no-undo.
      220         vRindex1 = r-index(p-message," ",70).
      221         if vRindex1 = 0
      222         then
      223            vRindex1 = 70.
      224         if length(p-message)  <= vRindex1 + 70 then do:
      225           assign
      226             v-waitfram-action01 = " "
      227             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      228             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      229           .
      230         end.
      231         else do:
      232           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      233           if vRindex2 <= vRindex1
      234           then
      235              vRindex2 = vRindex1 + 70.
      236           assign
      237             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      238             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      239             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      240           .
      241         end.
      242       end.
      243       B-viewProcInfo:visible   in frame waitfram = no.
      244       B-viewProcInfo:sensitive in frame waitfram = no.
      245       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      246       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      247       if  (   mWaitFramView
      248          or  mWaitProcEvent)
      249          and not mBatchMode
      250       then
      251          display
      252             v-waitfram-action01 skip
      253             v-waitfram-action02 skip
      254             v-waitfram-action03 skip
      255          with frame waitfram .
      256       if     mWaitFramView
      257          then do:
      258             if     mWaitFramInterval ne ?
      259                and not mBatchMode
      260             then
      261                wait-for go of frame waitfram pause mWaitFramInterval.
      262          end.
      263          else
      264             if     mWaitProcEvent
      265                and not mBatchMode
      266             then
      267                process events .
      268     end.
      269   end procedure.
      270      procedure waitfram-show-this:
      271         define input  parameter iInterval as int64 no-undo.
      272         define variable vtime as int64 no-undo.
      273         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      274         mWaitFramInterval = iInterval.
      275         run waitfram-show (substitute("&1&2 &3&4" ,
      276                                       mWaitFramTextBeg ,
      277                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      278                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      279                                       mWaitFramTextEnd
      280                                      )
      281                           ).
      282      end.
      283      procedure WaitFramRunPause:
      284         define input  parameter iInterval as dec no-undo.
      285         define variable vStart  as datetime-tz no-undo.
      286         define variable vend    as datetime-tz no-undo.
      287         define variable vint as int64 no-undo.
      288         define variable vOk as logical no-undo.
      289         vStart = now.
      290         vend   = vStart.
      291         publish "WaitFramPause" (iInterval,output vOk).
      292         vend   =  now.
      293         vint = vend - vStart.
      294         vint = iInterval - vint / 1000.
      295         if     not mWaitFramStop
      296            and (   vint > 0
      297                 or (    not vOk
      298                     and iInterval eq ?
      299                     )
      300                 )
      301         then
      302            run waitfram-show-this (iInterval).
      303         vend   =  now.
      304         vint = vend - vStart.
      305         vint = iInterval - vint / 1000.
      306         if     not mWaitFramStop
      307            and vint > 0
      308         then do:
      309            run gbl/pause.p (vint * 1000).
      310         end.
      311         if iInterval ne ?
      312         then
      313            publish "WaitFramStop".
      314         waitfram-check-timeout().
      315      end.
      316      procedure WaitFramWaitFor:
      317         define input  parameter iInterval as dec no-undo.
      318         assign
      319            mWaitFramStartProc   = now
      320            mWaitFramStopUser    = no
      321            mWaitFramStopTimeOut = no
      322         .
      323         block-wait:
      324         do while not mWaitFramStop:
      325            run WaitFramRunPause (iInterval).
      326            if  waitfram-check-timeout()
      327            then do:
      328               leave block-wait.
      329            end.
      330         end.
      331         run waitfram-hide.
      332      end.
      333   procedure waitfram-join :
      334     define input  parameter p-line-1  as character no-undo .
      335     define input  parameter p-line-2  as character no-undo .
      336     define input  parameter p-line-3  as character no-undo .
      337     define output parameter p-message as character no-undo .
      338     do
      339     on error undo, return error return-value
      340     :
      341       assign
      342         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      343                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      344                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      345       .
      346     end.
      347   end procedure.
      348   function waitfram-join-function returns character
      349     (input p-line-1 as character
      350     ,input p-line-2 as character
      351     ,input p-line-3 as character
      352     ).
      353     define variable v-message as character no-undo .
      354     run waitfram-join in this-procedure
      355       (input  p-line-1
      356       ,input  p-line-2
      357       ,input  p-line-3
      358       ,output v-message
      359       ) .
      360     return v-message .
      361   end function .
      362   DEFINE buffer for-doc for ub.chk-doc.
      363   DEFINE buffer for-pay for ub.chk-pay.
      364   DEFINE buffer for-gds for ub.chk-gds.
      365   DEFINE buffer for-discnt for ub.chk-discnt.
      366   DEFINE buffer for-attr for ub.chk-doc-attr.
      367   define variable glog as logical no-undo .
      368   DEFINE BUTTON B-exit AUTO-GO
      369        LABEL "&Ввод"
      370        SIZE 10 BY 1
      371        BGCOLOR 8 .
      372   DEFINE BUTTON B-Help
      373        LABEL "Помо&щь"
      374        SIZE 10 BY 1
      375        BGCOLOR 8 .
      376   DEFINE BUTTON b-quit AUTO-END-KEY
      377        LABEL "&Отмена"
      378        SIZE 10 BY 1
      379        BGCOLOR 8 .
      380   DEFINE VARIABLE Fdate AS DATE FORMAT "99/99/9999":U
      381        LABEL "с датой"
      382        VIEW-AS FILL-IN
      383        SIZE 13.63 BY .92 NO-UNDO.
      384   DEFINE VARIABLE my-chk-doc AS CHARACTER FORMAT "X(256)":U
      385        LABEL "Копировать чеки с чека  N"
      386        VIEW-AS FILL-IN
      387        SIZE 13.88 BY 1
      388        BGCOLOR 15  NO-UNDO.
      389   DEFINE VARIABLE my-inkas AS CHARACTER FORMAT "X(256)":U
      390        LABEL "Копировать чеки по продаже N"
      391        VIEW-AS FILL-IN
      392        SIZE 13.88 BY 1
      393        BGCOLOR 15  NO-UNDO.
      394   DEFINE VARIABLE RADIO-SET-1 AS CHARACTER
      395        VIEW-AS RADIO-SET HORIZONTAL
      396        RADIO-BUTTONS
      397             "Продажа", "inkas",
      398   "Чек", "chk-doc"
      399        SIZE 21.63 BY 1.08 NO-UNDO.
      400   DEFINE FRAME Dialog-Frame
      401        B-exit AT ROW 1 COL 1.13
      402        b-quit AT ROW 1 COL 11.13
      403        B-Help AT ROW 1 COL 54.88
      404        my-inkas AT ROW 3.17 COL 31.63 COLON-ALIGNED
      405        Fdate AT ROW 4.88 COL 31.75 COLON-ALIGNED
      406        RADIO-SET-1 AT ROW 6.17 COL 7.88 NO-LABEL
      407        my-chk-doc AT ROW 7.42 COL 31.88 COLON-ALIGNED
      408        SPACE(17.12) SKIP(3.94)
      409       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      410            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      411            TITLE "Утилита копирования чеков с имеющейся закрытой продажи"
      412            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      413   ASSIGN
      414          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      415          FRAME Dialog-Frame:HIDDEN           = TRUE.
      416   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      417   DO:
      418     APPLY "END-ERROR":U TO SELF.
      419   END.
      420   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      421   DO:
      422     assign
      423     RADIO-SET-1
      424     my-inkas
      425     my-chk-doc
      426     fdate.
      427     if fdate = ? then return no-apply.
      428     CASE radio-set-1:
      429       when "inkas" then do:
      430         FIND FIRST ub.inkas No-LOCK WHERE ub.inkas.inkas-code = my-inkas No-ERROR.
      431     IF not avail ub.inkas then do:
      432       message "Не найдена продажа с номером " my-inkas.
      433       return no-apply.
      434     end.
      435     message "Вы действительно хотите скопировать все чеки продажи " my-inkas  skip
      436             "(полученные чеки будут непривязаны ни к одной продаже и" skip
      437             string(" лягут с датой " + string(fdate, "99/99/99999") + "на текущий магазин) ?") view-as alert-box QUESTION
      438             buttons YES-NO update glog.
      439       end.
      440       when "chk-doc" then do:
      441         FIND FIRST ub.chk-doc No-LOCK WHERE ub.chk-doc.doc-code = my-chk-doc No-ERROR.
      442     IF not avail ub.chk-doc then do:
      443       message "Не найден чек с номером " my-chk-doc.
      444       return no-apply.
      445     end.
      446     message "Вы действительно хотите скопировать чеки " my-chk-doc  skip
      447             "(полученный чек будет непривязан ни к одной продаже и" skip
      448             string(" ляжет с датой " + string(fdate, "99/99/99999") + "на текущий магазин) ?") view-as alert-box QUESTION
      449             buttons YES-NO update glog.
      450       end.
      451     end case.
      452       if glog then do:
      453         run waitfram-show in this-procedure ("Ждите ..").
      454   for each chk-doc where
      455   (chk-doc.out-code = my-inkas AND radio-set-1 = "inkas") OR
      456   (chk-doc.doc-code = my-chk-doc AND radio-set-1 = "chk-doc")
      457   no-lock:
      458       create for-doc.
      459       buffer-copy chk-doc  except doc-code out-code chk-date shift-date src-shift-date to for-doc
      460       assign for-doc.cashier =  chk-doc.cashier
      461                   for-doc.doc-code =  string(chk-doc.obj-code) + chr(47) + string( next-value( s-chk, ub ) )
      462                   for-doc.chk-date        =         fdate
      463                   for-doc.shift-date = chk-doc.shift-date + (fdate - chk-doc.chk-date)
      464                           for-doc.src-shift-date = chk-doc.src-shift-date + (fdate - chk-doc.chk-date)
      465                   .
      466      for each ub.chk-pay where ub.chk-pay.doc-code = ub.chk-doc.doc-code no-lock:
      467       create for-pay.
      468       buffer-copy ub.chk-pay to for-pay
      469       assign
      470       for-pay.chk-date  =   for-doc.chk-date
      471       for-pay.doc-code  = for-doc.doc-code
      472       for-pay.out-code = ?
      473       .
      474     end.
      475     for each ub.chk-gds where ub.chk-gds.doc-code = ub.chk-doc.doc-code no-LOCK:
      476       create for-gds.
      477       buffer-copy ub.chk-gds to for-gds
      478       assign
      479       for-gds.chk-date  =   for-doc.chk-date
      480       for-gds.doc-code  =  for-doc.doc-code
      481       for-gds.out-code = ?
      482       .
      483     end.
      484     for each ub.chk-discnt where ub.chk-discnt.doc-code = ub.chk-doc.doc-code no-LOCK:
      485       create for-discnt.
      486       buffer-copy ub.chk-discnt to for-discnt
      487       assign
      488       for-discnt.doc-code  = for-doc.doc-code
      489       for-discnt.chk-date  =   for-doc.chk-date
      490       for-discnt.out-code = ?
      491       .
      492     end.
      493     for each ub.chk-doc-attr where ub.chk-doc-attr.doc-code = ub.chk-doc.doc-code no-LOCK:
      494       create for-attr.
      495       buffer-copy ub.chk-doc-attr to for-attr
      496       assign
      497       for-attr.doc-code  = for-doc.doc-code
      498       for-attr.out-code = ?
      499       .
      500     end.
      501   end.
      502       end.
      503       run waitfram-hide in this-procedure .
      504   END.
      505   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      506   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      507   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   on help of frame Dialog-Frame
      509   do:
      510     run gbl/app_help.p
      511       (input this-procedure :file-name
      512       ,input ''
      513       ,input ?
      514       ) no-error.
      515     if error-status :error then do:
      516       message
      517         "Ошибка при вызове помощи"
      518         error-status :get-message(1)
      519         view-as alert-box .
      520     end.
      521   end.
      522   run minbtn-set in this-procedure .
      523   on choose of b-help in frame Dialog-Frame
      524   do:
      525     apply "help":u to frame Dialog-Frame .
      526   end.
      527   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528   procedure minbtn-set :
      529       do
      530           on error undo, return error return-value
      531           :
      532           define variable ii              as integer       no-undo .
      533           define variable fh              as widget-handle no-undo .
      534           define variable hh              as widget-handle no-undo .
      535           define variable v-h             as handle        extent 4 no-undo .
      536           define variable v-name-button   as character     no-undo .
      537           define variable v-help-old-x    as decimal       no-undo .
      538           define variable v-help-old-y    as decimal       no-undo .
      539           define variable v-help-old-size as decimal       no-undo .
      540           define variable v-frame-width   as decimal       no-undo .
      541           define variable jj              as integer       no-undo .
      542           do
      543               on error undo, return error
      544               :
      545               assign
      546                   v-frame-width = frame Dialog-Frame:width - 0.3
      547                   fh            = frame Dialog-Frame:first-child
      548                   hh            = fh:first-child
      549                   ii            = 1
      550                   .
      551               do while valid-handle(hh):
      552                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      553                   do:
      554                       case lc(hh:name) :
      555                           when "b-help" then
      556                               do:
      557                                   hh:load-image-up("cmp/b-help.bmp":u) .
      558                                   hh:load-image-down("cmp/b-help.bmp":u) .
      559                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      560                                   hh:TOOLTIP = "Помощь" .
      561                                   v-help-old-x = hh:column .
      562                                   v-help-old-y = hh:row    .
      563                                   v-help-old-size = hh:width .
      564                                   hh:width-chars = 2.5 .
      565                               end.
      566                           when "b-print" then
      567                               do:
      568                                   hh:load-image("cmp/b-print.bmp":u) .
      569                                   hh:TOOLTIP = "Печать" .
      570                                   v-h[ii] = hh:handle .
      571                                   ii = ii + 1 .
      572                                   hh:width-chars = 3 .
      573                               end.
      574                           when "b-history" or
      575                           when "b-hist" then
      576                               do:
      577                                   hh:load-image("cmp/b-hist.bmp":u) .
      578                                   hh:TOOLTIP = "История" .
      579                                   v-h[ii] = hh:handle .
      580                                   ii = ii + 1 .
      581                                   hh:width-chars = 3 .
      582                               end.
      583                           when "b-sch" then
      584                               do:
      585                                   hh:load-image("cmp/b-sch.bmp":u) .
      586                                   hh:TOOLTIP = "Установка Фильтра" .
      587                                   v-h[ii] = hh:handle .
      588                                   ii = ii + 1 .
      589                                   hh:width-chars = 3 .
      590                               end.
      591                           when "b-hist-user" then
      592                               do:
      593                                   hh:load-image("cmp/b-hist.bmp":u) .
      594                                   hh:TOOLTIP = "История пользователя" .
      595                                   ii = ii + 1 .
      596                               end.
      597                       end case.
      598                   end.
      599                   hh = hh:next-sibling.
      600               end.
      601               b-help:column = v-frame-width - b-help:width-chars.
      602               jj = 0.
      603               repeat ii = 4 to 1 by -1 :
      604                   if valid-handle (v-h[ii] ) then
      605                   do:
      606                       jj  = jj + 1 .
      607                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      608                       v-h[ii]:row    = v-help-old-y .
      609                   end.
      610               end.
      611           end.
      612       end.
      613   end procedure.
      614   MAIN-BLOCK:
      615   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      616      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      617     if p-curr-obj-type = 'скл':U then do:
      618       message
      619       "Данную утилиту можно запускать только на объекте типа МАГАЗИН!"
      620       view-as alert-box ERROR.
      621       return.
      622     end.
      623     RUN enable_UI.
      624     WAIT-FOR GO OF FRAME Dialog-Frame.
      625   END.
      626   RUN disable_UI.
      627   PROCEDURE disable_UI :
      628     HIDE FRAME Dialog-Frame.
      629   END PROCEDURE.
      630   PROCEDURE enable_UI :
      631     DISPLAY my-inkas Fdate RADIO-SET-1 my-chk-doc
      632         WITH FRAME Dialog-Frame.
      633     ENABLE B-exit b-quit B-Help my-inkas Fdate RADIO-SET-1 my-chk-doc
      634         WITH FRAME Dialog-Frame.
      635     VIEW FRAME Dialog-Frame.
      636   END PROCEDURE.
