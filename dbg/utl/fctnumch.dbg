        1   block-level on error undo, throw.
        2   define input parameter p-doc-code     as character no-undo .
        3   define input parameter p-doc-type     as character no-undo .
        4   define input parameter p-new-fact-num as integer   no-undo .
        5   define input parameter p-log-change   as logical   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: fctnumch.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/fctnumch.p $":U .
       11   define variable vss-description as character no-undo init "Изменить фактический номер закрытия накладной или переоценки".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure factord :
       74     define input  parameter p-fact-date            as date    no-undo .
       75     define input  parameter p-fact-time            as integer no-undo .
       76     define input  parameter p-fact-num             as integer no-undo .
       77     define input  parameter p-shift-date           as date    no-undo .
       78     define input  parameter p-shift-num            as integer no-undo .
       79     define input  parameter p-shift-on             as logical no-undo .
       80     define output parameter p-fact-order           as decimal no-undo .
       81     define output parameter p-shift-end-fact-order as decimal no-undo .
       82     define output parameter p-day-end-fact-order   as decimal no-undo .
       83     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       84     if p-fact-date = ?
       85     then do:
       86       return error "Не указана фактическая дата" .
       87     end.
       88     define variable v-fact-date-num as integer no-undo .
       89     assign
       90       v-fact-date-num = integer(p-fact-date)
       91     .
       92     if p-fact-num = ?
       93     or p-fact-num = 0
       94     then do:
       95       return error "Не задан p-fact-num " + string(p-fact-num) .
       96     end.
       97     if p-fact-num < 0
       98     then do:
       99       return error "Отрицательный fact-num " + string(p-fact-num) .
      100     end.
      101     if p-fact-num >= 100000000
      102     then do:
      103       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      104     end.
      105     if p-shift-on = true
      106     then do:
      107       if p-shift-date = ?
      108       then do:
      109         return error "Не задана дата смены" .
      110       end.
      111       if p-shift-num = ?
      112       or p-shift-num = 0
      113       then do:
      114         return error "Не задан номер смены" .
      115       end.
      116     end.
      117     else do:
      118       assign
      119         p-shift-date = p-fact-date
      120         p-shift-num  = 24
      121       .
      122     end.
      123     define variable v-shift-offset as integer no-undo .
      124     if p-shift-date = p-fact-date
      125     then do:
      126       assign
      127         v-shift-offset = 1
      128       .
      129     end.
      130     if p-shift-date < p-fact-date
      131     then do:
      132       assign
      133         v-shift-offset = 0
      134       .
      135     end.
      136     if p-shift-date > p-fact-date
      137     then do:
      138       message
      139         vss-workfile vss-revision vss-description skip
      140         "Неправильная дата закрытия смены" skip
      141         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      142         view-as alert-box error .
      143       undo, return error
      144         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      145           ,string(p-fact-date, '99/99/9999':U)
      146           ,string(p-shift-date, '99/99/9999':U)
      147           )
      148       .
      149     end.
      150     if p-shift-num < 1
      151     or p-shift-num > 24
      152     then do:
      153       message
      154         vss-workfile vss-revision vss-description skip
      155         "Неправильный номер смены" skip
      156         "p-shift-num" p-shift-num skip
      157         view-as alert-box error .
      158       undo, return error return-value .
      159     end.
      160     assign
      161       p-fact-order           = v-fact-date-num
      162                              + v-shift-offset * 0.5
      163                              + p-shift-num    * 0.02 - 0.01
      164                              + p-fact-num     * 0.0000000001
      165       p-shift-end-fact-order = v-fact-date-num
      166                              + v-shift-offset * 0.5
      167                              + p-shift-num    * 0.02
      168       p-day-end-fact-order   = v-fact-date-num
      169                              + 0.99
      170     .
      171     if p-fact-order           <= v-fact-date-num
      172     or p-shift-end-fact-order <= v-fact-date-num
      173     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      174     or p-shift-end-fact-order >= p-day-end-fact-order
      175     then do:
      176       message
      177         vss-workfile vss-revision vss-description skip
      178         "Внутренняя ошибка при генерации фактического номера" skip
      179         "p-fact-date"            p-fact-date            skip
      180         "p-fact-time"            p-fact-time            skip
      181         "p-fact-num"             p-fact-num             skip
      182         "p-shift-date"           p-shift-date           skip
      183         "p-shift-num"            p-shift-num            skip
      184         "p-shift-on"             p-shift-on             skip
      185         "p-shift-end-fact-order" p-shift-end-fact-order skip
      186         "p-day-end-fact-order"   p-day-end-fact-order   skip
      187         "v-fact-date-num"        v-fact-date-num        skip
      188         view-as alert-box error .
      189       undo, return error return-value .
      190     end.
      191   end procedure.
      192   procedure day-begin-fact-order :
      193     define input  parameter p-fact-date            as date    no-undo .
      194     define output parameter p-day-begin-fact-order as decimal no-undo .
      195     do
      196     on error undo, return error return-value
      197     :
      198       if p-fact-date = ?
      199       then do:
      200         assign
      201           p-day-begin-fact-order = 0
      202         .
      203       end.
      204       else do:
      205         assign
      206           p-day-begin-fact-order = integer(p-fact-date)
      207         .
      208       end.
      209     end.
      210   end procedure.
      211   procedure factord-max-fact-order :
      212     define output parameter p-max-fact-order as decimal   no-undo .
      213     do
      214     on error undo, return error return-value
      215     :
      216       run day-begin-fact-order in this-procedure
      217         (input  date(1, 1, 5000)
      218         ,output p-max-fact-order
      219         ) .
      220     end.
      221   end procedure.
      222   procedure factord-cut-archive :
      223     define input  parameter p-obj-type             as character no-undo .
      224     define input  parameter p-obj-code             as integer   no-undo .
      225     define input  parameter p-fact-date            as date      no-undo .
      226     define output parameter p-shift-on             as logical   no-undo .
      227     define output parameter p-shift-date           as date      no-undo .
      228     define output parameter p-shift-num            as integer   no-undo .
      229     define output parameter p-day-end-fact-order   as decimal   no-undo .
      230     define output parameter p-shift-end-fact-order as decimal   no-undo .
      231     define variable v-fact-order as decimal   no-undo .
      232     define buffer buf_shift-obj for ub.shift-obj .
      233     do
      234     on error undo, return error return-value
      235     :
      236   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      238     (input  p-obj-type
      239     ,input  p-obj-code
      240     ,input  'shift-on=request'
      241     ,output p-shift-on
      242     ) no-error .
      243       if error-status :error
      244       then do:
      245         message
      246           vss-workfile vss-revision vss-description skip
      247           "Ошибка при определении атрибута объекта" skip
      248           "Объект" p-obj-type p-obj-code skip
      249           error-status :get-message(1) skip
      250           return-value skip
      251           view-as alert-box error .
      252         undo, return error return-value .
      253       end.
      254       if p-shift-on = false
      255       then do:
      256         assign
      257           p-shift-date               = ?
      258           p-shift-num                = 0
      259         .
      260       end.
      261       else do:
      262         find first buf_shift-obj share-lock
      263           where buf_shift-obj.obj-type   = p-obj-type
      264             and buf_shift-obj.obj-code   = p-obj-code
      265             and buf_shift-obj.shift-date > p-fact-date
      266           use-index pi
      267           no-error .
      268         if not available buf_shift-obj
      269         or buf_shift-obj.status_ <> 'зкр':U
      270         then do:
      271           message
      272             vss-workfile vss-revision vss-description skip
      273             "Невозможно вычислить последнюю смену" skip
      274             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      275             "Объект" p-obj-type p-obj-code skip
      276             "Дата" p-fact-date skip
      277             view-as alert-box error .
      278           undo, return error return-value .
      279         end.
      280         find last buf_shift-obj share-lock
      281           where buf_shift-obj.obj-type = p-obj-type
      282             and buf_shift-obj.obj-code = p-obj-code
      283             and buf_shift-obj.shift-date <= p-fact-date
      284           use-index pi
      285           no-error .
      286         if available buf_shift-obj
      287         then do:
      288           if  buf_shift-obj.status_ = 'зкр':U
      289           then do:
      290             assign
      291               p-shift-date = buf_shift-obj.shift-date
      292               p-shift-num  = buf_shift-obj.shift-num
      293             .
      294           end.
      295           else do:
      296             message
      297               vss-workfile vss-revision vss-description skip
      298               "Невозможно вычислить последнюю смену" skip
      299               "Статус смены отличен от статуса" 'зкр':U skip
      300               "Объект" p-obj-type p-obj-code skip
      301               "Дата" p-fact-date skip
      302               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      303               view-as alert-box error .
      304             undo, return error return-value .
      305           end.
      306         end.
      307         else do:
      308           assign
      309             p-shift-date = p-fact-date - 1
      310             p-shift-num  = 1
      311           .
      312         end.
      313       end.
      314       run factord in this-procedure
      315         (input  p-fact-date
      316         ,input  1
      317         ,input  1
      318         ,input  p-shift-date
      319         ,input  p-shift-num
      320         ,input  p-shift-on
      321         ,output v-fact-order
      322         ,output p-shift-end-fact-order
      323         ,output p-day-end-fact-order
      324         ) no-error .
      325       if error-status :error
      326       then do:
      327         message
      328           vss-workfile vss-revision vss-description skip
      329           "Ошибка при вызове процедуры factord"
      330           error-status :get-message(1) skip
      331           return-value skip
      332           view-as alert-box error .
      333         undo, return error return-value .
      334       end.
      335     end.
      336   end procedure.
      337   procedure factord-lock-shift :
      338     define input  parameter p-obj-type  as character no-undo .
      339     define input  parameter p-obj-code  as integer   no-undo .
      340     define input  parameter p-fact-date as date      no-undo .
      341     define parameter buffer buf_shift-obj for ub.shift-obj .
      342     define variable v-shift-on      as logical   no-undo .
      343     define variable v-extra-message as character no-undo .
      344     define variable v-error as character no-undo .
      345     do
      346     on error undo, return error return-value
      347     :
      348   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      350     (input  p-obj-type
      351     ,input  p-obj-code
      352     ,input  'shift-on=request'
      353     ,output v-shift-on
      354     ) no-error .
      355       if error-status :error
      356       then do:
      357         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      358         undo, return error v-error .
      359       end.
      360       if v-shift-on = true
      361       then do:
      362         find first buf_shift-obj share-lock
      363           where buf_shift-obj.obj-type   = p-obj-type
      364             and buf_shift-obj.obj-code   = p-obj-code
      365             and buf_shift-obj.shift-date > p-fact-date
      366           use-index pi
      367           no-error .
      368         if not available buf_shift-obj
      369         or buf_shift-obj.status_ <> 'зкр':U
      370         then do:
      371           find last buf_shift-obj
      372             where buf_shift-obj.obj-type = p-obj-type
      373               and buf_shift-obj.obj-code = p-obj-code
      374               and buf_shift-obj.status_  = 'зкр':U
      375             use-index stts
      376             no-error .
      377           if available buf_shift-obj
      378           then do:
      379             assign
      380               v-extra-message =
      381                     substitute("Дата начала последеней закрытой смены на объекте &1"
      382                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      383                               )
      384             .
      385           end.
      386           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      387           undo, return error v-error .
      388         end.
      389       end.
      390     end.
      391   end procedure.
      392   procedure factord-end-day :
      393     define input  parameter p-fact-date            as date    no-undo .
      394     define output parameter p-day-end-fact-order   as decimal no-undo .
      395     do
      396     on error undo, return error return-value
      397     :
      398       if p-fact-date = ?
      399       then do:
      400         return error "Не указана фактическая дата" .
      401       end.
      402       assign
      403         p-day-end-fact-order = integer(p-fact-date) + 0.99
      404       .
      405     end.
      406   end procedure.
      407   procedure factord-to-date :
      408     define input  parameter p-fact-order as decimal no-undo .
      409     define output parameter p-fact-date  as date    no-undo .
      410     define variable v-ref-date  as date      no-undo .
      411     define variable v-ref-delta as integer   no-undo .
      412     do
      413     on error undo, return error return-value
      414     :
      415       if p-fact-order = ?
      416       or p-fact-order = 0
      417       then do:
      418         return error "Не указан fact-order" .
      419       end.
      420       assign
      421         v-ref-date  = date(1, 1, 2000)
      422       .
      423       assign
      424         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      425       .
      426       assign
      427         p-fact-date = v-ref-date + v-ref-delta
      428       .
      429     end.
      430   end procedure.
      431   procedure factord-to-fact-num :
      432     define input  parameter p-fact-order as decimal no-undo .
      433     define output parameter p-fact-num   as integer no-undo .
      434     define variable v-fact-order-trunc as decimal no-undo .
      435     do
      436     on error undo, return error return-value
      437     :
      438       if p-fact-order = ?
      439       or p-fact-order = 0
      440       then do:
      441         return error "Не указан fact-order" .
      442       end.
      443       assign
      444        v-fact-order-trunc = truncate(p-fact-order, 2)
      445       .
      446       assign
      447         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      448       .
      449     end.
      450   end procedure.
      451   procedure factord-to-shift-num :
      452     define input  parameter p-fact-order as decimal no-undo .
      453     define output parameter p-shift-num   as integer no-undo .
      454     define variable  p-shift-numd  as decimal   no-undo .
      455     define variable v-fact-order-trunc as decimal no-undo .
      456     do
      457     on error undo, return error return-value
      458     :
      459       if p-fact-order = ?
      460       or p-fact-order = 0
      461       then do:
      462         return error "Не указан fact-order" .
      463       end.
      464       assign
      465        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      466       .
      467       if v-fact-order-trunc < 0.5 then do:
      468         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      469       end.
      470       assign
      471         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      472         .
      473        assign
      474         p-shift-num = truncate (p-shift-numd , 0)
      475       .
      476     end.
      477   end procedure.
      478   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   procedure cur-time :
      480      define output parameter p-today as date      no-undo .
      481      define output parameter p-time  as integer   no-undo .
      482     do
      483     on error undo, return error
      484     :
      485       define variable v-date1 as date      no-undo .
      486       define variable v-date2 as date      no-undo .
      487       define variable v-time  as integer   no-undo .
      488       assign
      489         v-date1 = today
      490         v-time  = time
      491         v-date2 = today
      492       .
      493       if v-date1 <> v-date2
      494       then do:
      495         assign
      496           v-date1 = today
      497           v-time  = v-time
      498         .
      499       end.
      500       assign
      501         p-today = v-date1
      502         p-time  = v-time
      503       .
      504     end.
      505   end.
      506   function cur-time-date returns character
      507   :
      508     return string(today, '99/99/9999':U) .
      509   end.
      510   function cur-time-mjd returns decimal
      511   :
      512     define variable v-date as date      no-undo .
      513     define variable v-time as integer   no-undo .
      514     run cur-time in this-procedure
      515       (output v-date
      516       ,output v-time
      517       ) .
      518     return integer(v-date) - 2400002 + (v-time / 86400) .
      519   end.
      520   function cur-time-get-ending-index returns integer
      521   (input p-number as integer
      522   )
      523   :
      524     if p-number < 0
      525     or p-number = ?
      526     then do:
      527       return 1 .
      528     end.
      529     define variable v-rest as integer   no-undo .
      530     assign
      531       p-number = p-number modulo 100
      532     .
      533     if p-number < 20
      534     then do:
      535       assign
      536         v-rest = p-number
      537       .
      538     end.
      539     else do:
      540       assign
      541         v-rest = p-number modulo 10
      542       .
      543     end.
      544     case v-rest :
      545       when 1
      546       then do:
      547         return 2 .
      548       end.
      549       when 2 or
      550       when 3 or
      551       when 4
      552       then do:
      553         return 3 .
      554       end.
      555       otherwise do:
      556         return 1 .
      557       end.
      558     end case .
      559   end.
      560   procedure cur-time-mjd-to-date :
      561      define input  parameter i-mjd-diff as decimal no-undo.
      562      define output parameter o-Date     as date    no-undo.
      563      define output parameter o-Time     as integer no-undo.
      564      define variable v-day-number as integer   no-undo .
      565      if    i-mjd-diff < 0
      566         or i-mjd-diff = ?
      567      then do:
      568         return "?" .
      569      end.
      570      assign
      571         v-day-number = truncate(i-mjd-diff,0).
      572         o-Date = date(v-day-number + 2400002).
      573         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      574     .
      575   end.
      576   function cur-time-mjd-to-string returns character
      577   (input p-mjd-diff as decimal
      578   )
      579   :
      580     define variable v-day-number as integer   no-undo .
      581     define variable v-seconds    as integer   no-undo .
      582     define variable v-hour       as integer   no-undo .
      583     define variable v-min        as integer   no-undo .
      584     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      585     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      586     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      587     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      588     if p-mjd-diff < 0
      589     or p-mjd-diff = ?
      590     then do:
      591       return "?" .
      592     end.
      593     assign
      594       v-day-number = integer(truncate(p-mjd-diff,0))
      595       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      596     .
      597     if v-seconds > 86400
      598     then do:
      599       assign
      600         v-seconds = 86400 - 1
      601       .
      602     end.
      603     if v-seconds < 0
      604     then do:
      605       assign
      606         v-seconds = 0
      607       .
      608     end.
      609     assign
      610       v-hour = truncate(v-seconds / 3600, 0)
      611     .
      612     assign
      613       v-seconds = v-seconds modulo 3600
      614     .
      615     assign
      616       v-min = truncate(v-seconds / 60, 0)
      617     .
      618     assign
      619       v-seconds = v-seconds modulo 60
      620     .
      621     return
      622         (if v-day-number <> 0
      623           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      624           else ""
      625         )
      626       + (if v-day-number <> 0 or v-hour <> 0
      627           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      628           else ""
      629         )
      630       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      631           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      632           else ""
      633         )
      634       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      635       .
      636   end.
      637   function cur-time-string returns character
      638   :
      639     define variable v-date as date      no-undo .
      640     define variable v-time as integer   no-undo .
      641     run cur-time in this-procedure
      642       (output v-date
      643       ,output v-time
      644       ) .
      645     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      646   end.
      647   function cur-time-string-sec returns character
      648   :
      649     define variable v-date as date      no-undo .
      650     define variable v-time as integer   no-undo .
      651     run cur-time in this-procedure
      652       (output v-date
      653       ,output v-time
      654       ) .
      655     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      656   end.
      657   function cur-time-custom  returns character
      658   (input p-prefix as character
      659   ,input p-date-format as character
      660   ,input p-delimiter as character
      661   ,input p-time-format as character
      662   ,input p-suffix as character
      663   )
      664   :
      665     define variable v-date as date      no-undo .
      666     define variable v-time as integer   no-undo .
      667     run cur-time in this-procedure
      668       (output v-date
      669       ,output v-time
      670       ) .
      671     return
      672       p-prefix
      673       + string(v-date, p-date-format)
      674       + p-delimiter
      675       + string(v-time, p-time-format)
      676       + p-suffix
      677       .
      678   end.
      679   function cur-time-print  returns character
      680   :
      681     define variable v-date as date      no-undo .
      682     define variable v-time as integer   no-undo .
      683     run cur-time in this-procedure
      684       (output v-date
      685       ,output v-time
      686       ) .
      687     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      688   end.
      689   function cur-time-datetime returns datetime
      690   :
      691     define variable v-char as character no-undo .
      692     define variable v-datetime as datetime no-undo .
      693     v-char = cur-time-string().
      694     v-datetime = datetime(v-char).
      695     return  v-datetime.
      696   end.
      697   function cur-time-string-msec returns character
      698   :
      699     define variable v-date as datetime  no-undo .
      700     v-date = now.
      701     return string(v-date) .
      702   end.
      703   on write of ub.trn-doc   override do: end.
      704   on write of ub.price-doc override do: end.
      705   do
      706   on error undo, return error
      707   :
      708     case p-doc-type :
      709       when 'trn-doc':U then do:
      710         run trn-doc-fact-num in this-procedure
      711           (input p-doc-code
      712           ,input p-new-fact-num
      713           ).
      714       end.
      715       when 'price-doc':U then do:
      716         run price-doc-fact-num in this-procedure
      717           (input p-doc-code
      718           ,input p-new-fact-num
      719           ).
      720       end.
      721       otherwise do:
      722         message
      723           vss-workfile vss-revision vss-description skip
      724           view-as alert-box error .
      725         undo, return error .
      726       end.
      727     end case.
      728   end.
      729   procedure trn-doc-fact-num :
      730     define input parameter p-doc-code as character no-undo .
      731     define input parameter p-new-fact-num as integer no-undo .
      732     do
      733     on error undo, return error
      734     :
      735       define variable v-today as date      no-undo.
      736       define variable v-time  as integer   no-undo.
      737       find first ub.trn-doc exclusive-lock
      738         where ub.trn-doc.doc-code = p-doc-code
      739         .
      740       if p-log-change <> false then do:
      741         output to fctnumch.txt append .
      742         run cur-time in this-procedure ( output v-today
      743                                        , output v-time
      744                                        ).
      745         export
      746           ub.trn-doc.obj-type
      747           ub.trn-doc.obj-code
      748           "trn-doc_old-fact-num_new-fact-num"
      749           string(v-today, '99/99/9999')
      750           string(v-time, 'HH:MM')
      751           ub.trn-doc.doc-code
      752           ub.trn-doc.fact-num
      753           p-new-fact-num
      754           .
      755         output close .
      756       end.
      757       assign
      758         ub.trn-doc.fact-num = p-new-fact-num
      759       .
      760       define variable l-shift-on as logical no-undo .
      761   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      763     (input  ub.trn-doc.obj-type
      764     ,input  ub.trn-doc.obj-code
      765     ,input  'shift-on=request'
      766     ,output l-shift-on
      767     )  .
      768       define variable v-fact-order           as decimal no-undo .
      769       define variable v-shift-end-fact-order as decimal no-undo .
      770       define variable v-day-end-fact-order   as decimal no-undo .
      771       run factord in this-procedure
      772         (input  trn-doc.fact-date
      773         ,input  trn-doc.fact-time
      774         ,input  trn-doc.fact-num
      775         ,input  trn-doc.shift-date
      776         ,input  trn-doc.shift-num
      777         ,input  l-shift-on
      778         ,output v-fact-order
      779         ,output v-shift-end-fact-order
      780         ,output v-day-end-fact-order
      781         ) .
      782       assign
      783         trn-doc.fact-order = v-fact-order
      784       .
      785       for each doc-line exclusive-lock
      786         where doc-line.doc-code = ub.trn-doc.doc-code
      787       on error undo, return error
      788       :
      789         assign
      790           doc-line.fact-order = ub.trn-doc.fact-order
      791         .
      792       end.
      793     end.
      794   end procedure.
      795   procedure price-doc-fact-num :
      796     define input parameter p-doc-code as character no-undo .
      797     define input parameter p-new-fact-num as integer no-undo .
      798     do
      799     on error undo, return error
      800     :
      801       define variable v-today as date      no-undo.
      802       define variable v-time  as integer   no-undo.
      803       find first ub.price-doc exclusive-lock
      804         where ub.price-doc.doc-num = p-doc-code
      805         .
      806       if p-log-change <> false then do:
      807         output to fctnumch.txt append .
      808         run cur-time in this-procedure ( output v-today
      809                                        , output v-time
      810                                        ).
      811         export
      812           ub.price-doc.obj-type
      813           ub.price-doc.obj-code
      814           "price-doc_old-fact-num_new-fact-num"
      815           string(v-today, '99/99/9999')
      816           string(v-time, 'HH:MM')
      817           ub.price-doc.doc-num
      818           ub.price-doc.fact-num
      819           p-new-fact-num
      820           .
      821         output close .
      822       end.
      823       assign
      824         ub.price-doc.fact-num = p-new-fact-num
      825       .
      826       define variable l-shift-on as logical no-undo .
      827   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      829     (input  ub.price-doc.obj-type
      830     ,input  ub.price-doc.obj-code
      831     ,input  'shift-on=request'
      832     ,output l-shift-on
      833     )  .
      834       define variable v-fact-order           as decimal no-undo .
      835       define variable v-shift-end-fact-order as decimal no-undo .
      836       define variable v-day-end-fact-order   as decimal no-undo .
      837       run factord in this-procedure
      838         (input  price-doc.fact-date
      839         ,input  price-doc.fact-time
      840         ,input  price-doc.fact-num
      841         ,input  price-doc.shift-date
      842         ,input  price-doc.shift-num
      843         ,input  l-shift-on
      844         ,output v-fact-order
      845         ,output v-shift-end-fact-order
      846         ,output v-day-end-fact-order
      847         ) .
      848       assign
      849         price-doc.fact-order = v-fact-order
      850       .
      851       for each price-list exclusive-lock
      852         where price-list.doc-num = ub.price-doc.doc-num
      853       on error undo, return error
      854       :
      855         assign
      856           price-list.fact-order = ub.price-doc.fact-order
      857         .
      858       end.
      859     end.
      860   end procedure.
