        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   define variable mError as logical no-undo.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   function objExists return character
       68   (input  ifolder as character,
       69    input  iType   as character  ):
       70       define variable vFileType as character no-undo init "D,F".
       71       define variable vi        as integer no-undo.
       72       define variable vtype as character no-undo.
       73       if iType ne ?
       74       then
       75          vFileType = iType.
       76       do vi = 1 to num-entries(vFileType):
       77          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       78          vtype = file-information:file-type.
       79          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       80             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       81             index(vtype , entry(vi,vFileType )) > 0
       82          then return file-information:full-pathname .
       83          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       84          vtype = file-information:file-type.
       85          if file-information:file-name <> "" and
       86             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       87             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       88             index( vtype, entry(vi,vFileType )) > 0
       89          then return file-information:full-pathname .
       90       end.
       91       return ? .
       92   end.
       93   function SearchFile return character
       94   (input  ifile as character):
       95      return objExists(ifile,?).
       96   end.
       97   function SearchPFile return character
       98   (input inFile as char):
       99        define variable oFile       as character no-undo.
      100        define variable vFileSearch as character no-undo.
      101        define variable vNumEntry   as integer no-undo.
      102        if inFile = "" then return ?.
      103        vNumEntry = num-entries(inFile,".").
      104        vFileSearch = inFile.
      105        if    vNumEntry > 0
      106           and (   entry(vNumEntry,inFile,".") eq "p"
      107                or entry(vNumEntry,inFile,".") eq "w")
      108        then do:
      109           entry(vNumEntry,vFileSearch, ".") = "r".
      110           oFile = search(vFileSearch ).
      111           if oFile eq ?
      112           then
      113              oFile = search(inFile).
      114        end.
      115        else
      116           oFile = search(vFileSearch).
      117        return oFile.
      118     end.
      119   define stream Ostream.
      120   define variable mAsyncProc as class ibs.th.file.AsyncProc.
      121   run ibs\th\file\getasyncproc.p (output mAsyncProc).
      122   define variable mstopAsunc as logical no-undo.
      123   function StopCheck returns logical:
      124      define variable oFlag as logical no-undo.
      125      run StopCheckAsync (output oFlag).
      126      return oFlag.
      127   end.
      128   procedure StopCheckAsync:
      129       define output  parameter oFlag as logical no-undo.
      130       if mstopAsunc
      131       then
      132          oFlag = mstopAsunc.
      133       else do:
      134          oFlag = mAsyncProc:CheckStop().
      135          mstopAsunc = oFlag.
      136       end.
      137   end.
      138   function GetParamAsunc returns character
      139   (input iNumPar as integer  ):
      140      return mAsyncProc:GetPARAM(iNumPar).
      141   end.
      142   function GetParamAsuncStr returns ibs.th.file.asyncparam
      143   (input iParamName as character ):
      144      return mAsyncProc:GetPARAM(iParamName).
      145   end.
      146   procedure PutMesAsunc:
      147       define input  parameter Itext as character no-undo.
      148       define variable vflag as logical no-undo.
      149       Publish "WriteLogAsunc" (Itext, yes)  .
      150   end.
      151   procedure PutMesAsuncNoTime:
      152       define input  parameter Itext as character no-undo.
      153       define variable vflag as logical no-undo.
      154       Publish "WriteLogAsunc" (Itext,no)  .
      155   end.
      156   procedure PutStatAsunc:
      157       define input  parameter Itext as character no-undo.
      158       Publish "PutStatAsunc" (Itext,no) .
      159        run
      160       PutMesAsunc (itext).
      161   end.
      162   procedure PutStatAsuncNoTime:
      163       define input  parameter Itext as character no-undo.
      164       Publish "PutStatAsunc" (Itext,no)  .
      165        run
      166       PutMesAsuncNoTime (itext).
      167   end.
      168   procedure PutStatAsuncAdd:
      169       define input  parameter Itext as character no-undo.
      170       Publish "PutStatAsunc" (Itext,yes)  .
      171   end.
      172   procedure PutFileLogAsunc:
      173       define input  parameter IFile as character no-undo.
      174       Publish "PutFileLogAsunc" (ifile)  .
      175   end.
      176          mAsyncProc:mProcPublish = this-procedure.
      177   run PutStatAsunc (substitute("Запущен процесс обновления")).
      178   define variable mCommand as character no-undo.
      179   define variable m7z as character no-undo.
      180   define variable mUbexe as character no-undo.
      181   define variable mDirUb as character no-undo.
      182   define variable mDbConnet as character no-undo.
      183   define variable mVer      as character no-undo.
      184   session:system-alert-boxes = yes.
      185   run gbl/getvers.p (OUTPUT mVer).
      186   mVer = replace(mVer,".","_").
      187   m7z    = search("exe\7z.exe").
      188   mUbexe = search("exe\ub" + mVer + ".exe").
      189   os-create-dir value("ub" + mVer) .
      190   if os-error <> 0 then do:
      191      run PutStatAsunc (substitute("Невозможно создать директорию ub&1",mVer)).
      192   end.
      193   else do:
      194      mDirUb = objExists ("ub" + mVer,"d").
      195      mCommand = substitute('&1 x &2 -o"&3" -y &4 rem del &2',m7z ,mubexe, mdirub, chr(38)).
      196      if session:system-alert-boxes
      197      then do:
      198         output stream Ostream to "1extr.bat".
      199         put stream Ostream unformatted replace (mCommand,chr(38),chr(13) + chr(10)).
      200         output stream Ostream close.
      201      end.
      202      run PutStatAsunc (substitute("Распаковываем болванку ")).
      203      os-command silent value (mCommand).
      204      mDbConnet = substitute("-db &1\ub.db -ld zub -1 -U sysadm -P sysadm ", mdirub).
      205      run PutStatAsunc (substitute("Распаковка болванки завершена.")).
      206      define variable mOrigdb as character no-undo.
      207      define variable mProwin as character no-undo.
      208      mProwin = search("bin/prowin32.exe").
      209      mOrigdb = GetParamAsunc(1).
      210      run PutStatAsunc (substitute("Сравниваем БД с болванкой ")).
      211      mCommand = substitute ("set DUMP_INC_INDEXMODE=active &4 set DUMP_INC_DEBUG=0 &4 &1 -b &2 &3 -p prodict/dump_inc.p &4 exit",
      212      mProwin, mDbConnet,mOrigdb ,chr(38)).
      213      if session:system-alert-boxes
      214      then do:
      215         output stream Ostream to "2Compare.bat".
      216         put stream Ostream unformatted replace (mCommand,chr(38),chr(13) + chr(10)).
      217         output stream Ostream close.
      218      end.
      219      os-command silent value (mCommand).
      220      run PutStatAsunc (substitute("Выгружен результат сравнения БД и Болванки ")).
      221      define variable mDFDelta as character no-undo.
      222      mDFDelta = searchFile("delta.df").
      223      if mDFDelta ne ?
      224      then do:
      225         run PutFileLogAsunc(mDFDelta).
      226         define stream  sReadfile.
      227         define variable mText as character no-undo.
      228         input  stream sReadfile FROM  VALUE(mDFDelta ).
      229         import stream sReadfile unformatted mText.
      230         input  stream sReadfile close.
      231         if mText begins "."
      232         then
      233            run PutStatAsunc (substitute("Error Базы равны ")).
      234         else do:
      235            if index(GetPARAMAsunc(2),"UpdateDB=yes") eq 0
      236            then
      237               run PutStatAsunc (substitute('Error В базах есть расхождения, для обновляния базы по полванке запустите сесию с параметром -param "UpdateDB=yes" ')).
      238            else do:
      239               connect value(mOrigdb) no-error.
      240               if error-status:error
      241               then do:
      242                 def var vtext as char no-undo.
      243                 vtext =  substitute( "Не удалось подключиться к основной БД с параметрами: &1  Ошибка &2"
      244                                      ,mDbConnet
      245                                      ,error-status :get-message(1)
      246                                       ).
      247                  run PutStatAsunc ("Error " + vtext).
      248               end.
      249               else do:
      250                  run utl\upddbfromexedb.p (this-procedure,mOrigdb,mDFDelta) no-error.
      251                  if error-status:error
      252                  then do:
      253                     vtext =  substitute( "Ошибка при обновлении БД &1"
      254                                      ,error-status :get-message(1)
      255                                       ).
      256                     run PutStatAsunc ("Error " + vtext).
      257                  end.
      258                  disconnect ub no-error .
      259               end.
      260            end.
      261         end.
      262      end.
      263      else
      264         run PutStatAsunc (substitute("Error Не удалось создать файл расхождений ")).
      265   end.
