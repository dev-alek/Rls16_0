        1   block-level on error undo, throw.
        2   define input parameter p-host-sour     as integer   no-undo .
        3   define input parameter p-host-dest     as integer   no-undo .
        4   define input parameter p-is-cel-nazn   as logical   no-undo .
        5   define input parameter p-is-an-uchet   as logical   no-undo .
        6   define input parameter p-is-cor-acc    as logical   no-undo .
        7   define input parameter p-is-bank       as logical   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: fin-init.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: utl/fin-init.p $":U .
       13   define variable vss-description as character no-undo init "Копирование финанс. настроек по фирме".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   do
       73   on error undo, return error
       74   :
       75     define buffer buf_sysconf           for sysconf.
       76     find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-sour no-error .
       77     if not available buf_sysconf then do:
       78       message "не найдена фирма-источник " p-host-sour " ."   view-as alert-box error.
       79       return error.
       80     end.
       81     find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-dest no-error .
       82     if not available buf_sysconf then do:
       83       message "не найдена фирма-копия " p-host-dest " ."   view-as alert-box error.
       84       return error.
       85     end.
       86     define stream slog .
       87     define stream serr .
       88     define buffer buf_fin-code-cel-nazn for fin-code-cel-nazn.
       89     define buffer buf_fin-code-an-uchet for fin-code-an-uchet.
       90     define buffer buf_fin-code-cor-acc  for fin-code-cor-acc.
       91     define buffer buf_fin-bank          for fin-bank.
       92     define buffer buf_fin-schet         for fin-schet.
       93     output stream slog to value("fin-init.log") .
       94     output stream serr to value("fin-init.err") .
       95     export stream slog "код фирмы-источника " p-host-sour " код фирмы-копии " p-host-dest chr(10) .
       96     if p-is-cel-nazn then do:
       97       export stream slog "копирование записи fin-code-cel-nazn" chr(10) .
       98       for each fin-code-cel-nazn no-lock
       99         where fin-code-cel-nazn.host-code = p-host-sour
      100         :
      101         find first buf_fin-code-cel-nazn no-lock
      102           where buf_fin-code-cel-nazn.host-code = p-host-dest
      103             and buf_fin-code-cel-nazn.fin-code  = fin-code-cel-nazn.fin-code
      104           no-error .
      105         if not available buf_fin-code-cel-nazn then do:
      106           create buf_fin-code-cel-nazn .
      107           BUFFER-COPY fin-code-cel-nazn EXCEPT host-code TO buf_fin-code-cel-nazn .
      108           assign buf_fin-code-cel-nazn.host-code = p-host-dest .
      109           export stream slog "скопирован " fin-code-cel-nazn.code-value fin-code-cel-nazn.descr chr(10)  .
      110         end.
      111         else do:
      112           export stream slog "не могу скопировать " fin-code-cel-nazn.code-value fin-code-cel-nazn.descr chr(10)  .
      113           export stream serr "не могу скопировать " fin-code-cel-nazn.code-value fin-code-cel-nazn.descr chr(10)  .
      114         end.
      115       end.
      116     end.
      117     if p-is-an-uchet then do:
      118       export stream slog "копирование записи fin-code-an-uchet" chr(10) .
      119       for each fin-code-an-uchet no-lock
      120         where fin-code-an-uchet.host-code = p-host-sour
      121         :
      122         find first buf_fin-code-an-uchet no-lock
      123           where buf_fin-code-an-uchet.host-code = p-host-dest
      124             and buf_fin-code-an-uchet.fin-code  = fin-code-an-uchet.fin-code
      125           no-error .
      126         if not available buf_fin-code-an-uchet then do:
      127           create buf_fin-code-an-uchet .
      128           BUFFER-COPY fin-code-an-uchet EXCEPT host-code TO buf_fin-code-an-uchet .
      129           assign buf_fin-code-an-uchet.host-code = p-host-dest .
      130           export stream slog "скопирован " fin-code-an-uchet.code-value fin-code-an-uchet.descr chr(10)  .
      131         end.
      132         else do:
      133           export stream slog "не могу скопировать " fin-code-an-uchet.code-value fin-code-an-uchet.descr chr(10)  .
      134           export stream serr "не могу скопировать " fin-code-an-uchet.code-value fin-code-an-uchet.descr chr(10)  .
      135         end.
      136       end.
      137     end.
      138     if p-is-cor-acc then do:
      139       export stream slog "копирование записи fin-code-cor-acc" chr(10) .
      140       for each fin-code-cor-acc no-lock
      141         where fin-code-cor-acc.host-code = p-host-sour
      142         :
      143         find first buf_fin-code-cor-acc no-lock
      144           where buf_fin-code-cor-acc.host-code = p-host-dest
      145             and buf_fin-code-cor-acc.fin-code  = fin-code-cor-acc.fin-code
      146           no-error .
      147         if not available buf_fin-code-cor-acc then do:
      148           create buf_fin-code-cor-acc .
      149           BUFFER-COPY fin-code-cor-acc EXCEPT host-code TO buf_fin-code-cor-acc .
      150           assign buf_fin-code-cor-acc.host-code = p-host-dest .
      151           export stream slog "скопирован " fin-code-cor-acc.code-value fin-code-cor-acc.descr chr(10)  .
      152         end.
      153         else do:
      154           export stream slog "не могу скопировать " fin-code-cor-acc.code-value fin-code-cor-acc.descr chr(10)  .
      155           export stream serr "не могу скопировать " fin-code-cor-acc.code-value fin-code-cor-acc.descr chr(10)  .
      156         end.
      157       end.
      158     end.
      159     if p-is-bank then do:
      160       export stream slog "копирование записи fin-bank и fin-schet" chr(10) .
      161       for each fin-bank no-lock
      162         where fin-bank.host-code = p-host-sour
      163         :
      164         find first buf_fin-bank no-lock
      165           where buf_fin-bank.host-code = p-host-dest
      166             and buf_fin-bank.code-bank = fin-bank.code-bank
      167           no-error .
      168         if not available buf_fin-bank then do:
      169           find first buf_fin-bank no-lock
      170             where buf_fin-bank.host-code = p-host-dest
      171               and buf_fin-bank.bik = fin-bank.bik
      172             no-error .
      173           if not available buf_fin-bank then do:
      174             create buf_fin-bank .
      175             BUFFER-COPY fin-bank EXCEPT host-code TO buf_fin-bank .
      176             assign buf_fin-bank.host-code = p-host-dest .
      177             export stream slog "скопирован банк " fin-bank.bank-name " БИК " fin-bank.bik chr(10) .
      178             for each fin-schet no-lock
      179               where fin-schet.host-code = p-host-sour
      180                 and fin-schet.code-bank = fin-bank.code-bank
      181               :
      182               find first buf_fin-schet no-lock
      183                 where buf_fin-schet.host-code  = p-host-dest
      184                   and buf_fin-schet.code-schet = fin-schet.code-schet
      185               no-error .
      186               if not available buf_fin-schet then do:
      187                 create buf_fin-schet .
      188                 BUFFER-COPY fin-schet EXCEPT host-code TO buf_fin-schet .
      189                 assign buf_fin-schet.host-code = p-host-dest .
      190                 export stream slog "скопирован р.счет " fin-schet.r-schet " в банке " fin-bank.bank-name " БИК " fin-bank.bik chr(10) .
      191               end.
      192               else do:
      193                 export stream slog "не могу скопировать р.счет " fin-schet.r-schet " в банке " fin-bank.bank-name " БИК " fin-bank.bik chr(10) .
      194                 export stream serr "не могу скопировать р.счет " fin-schet.r-schet " в банке " fin-bank.bank-name " БИК " fin-bank.bik chr(10).
      195               end.
      196             end.
      197           end.
      198           else do:
      199             export stream slog "не могу скопировать банк " fin-bank.bank-name " - уже имеется БИК " fin-bank.bik chr(10) .
      200             export stream serr "не могу скопировать банк " fin-bank.bank-name " - уже имеется БИК " fin-bank.bik chr(10) .
      201           end.
      202         end.
      203         else do:
      204           export stream slog "не могу скопировать банк " fin-bank.bank-name " - уже имеется ID " chr(10) .
      205           export stream serr "не могу скопировать банк " fin-bank.bank-name " - уже имеется ID " chr(10) .
      206         end.
      207       end.
      208     end.
      209     output stream slog close .
      210     output stream serr close .
      211   end.
