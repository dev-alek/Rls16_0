        1   block-level on error undo, throw.
        2   define input  parameter  p-doc-code as character no-undo .
        3   on write of ub.trn-doc         override do: end.
        4   find first ub.trn-doc exclusive-lock
        5        where ub.trn-doc.doc-code = p-doc-code no-error .
        6        if error-status :error then do:
        7            message
        8              error-status :get-message(1) skip
        9              return-value skip
       10              ""
       11              view-as alert-box error
       12            .
       13            return .
       14        end.
       15     assign
       16       ub.trn-doc.hold-doc-code-child = "no-hold"
       17       ub.trn-doc.hold-doc-code-parent = "no-hold"
       18     .
       19    message 'все' view-as alert-box information .
