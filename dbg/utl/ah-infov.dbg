      511        SIZE 6.5 BY 1 NO-UNDO.
      512   DEFINE VARIABLE fi-search-description AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по номеру объекта:"
      513         VIEW-AS TEXT
      514        SIZE 25.13 BY .67 NO-UNDO.
      515   DEFINE VARIABLE fi-start-date AS DATE FORMAT "99/99/9999":U
      516        LABEL "Начало сжатого"
      517         VIEW-AS TEXT
      518        SIZE 14 BY .67
      519        FGCOLOR 4  NO-UNDO.
      520   DEFINE VARIABLE rs-archive-type AS INTEGER
      521        VIEW-AS RADIO-SET HORIZONTAL
      522        RADIO-BUTTONS
      523             "&Все", 1,
      524   "По &товарам", 2,
      525   "По &поставщикам", 3,
      526   "По типам приоб&ретения", 4
      527        SIZE 61.25 BY .67
      528        FGCOLOR 4  NO-UNDO.
      529   DEFINE VARIABLE rs-bad-archive AS INTEGER
      530        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      531        RADIO-BUTTONS
      532             "Все", 1,
      533   "Не рассчитанные", 2,
      534   "Рассчитанные", 3,
      535   "Отключенные", 4
      536        SIZE 78 BY .67
      537        FGCOLOR 4  NO-UNDO.
      538   DEFINE VARIABLE rs-batch-process AS INTEGER
      539        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      540        RADIO-BUTTONS
      541             "Все", 1,
      542   "С заданиями", 2,
      543   "Без заданий", 3
      544        SIZE 59 BY .67
      545        FGCOLOR 4  NO-UNDO.
      546   DEFINE VARIABLE rs-deleted AS INTEGER
      547        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      548        RADIO-BUTTONS
      549             "Текущие&+", 1,
      550   "Все&!", 2,
      551   "Удалённые&-", 3
      552        SIZE 59 BY .67
      553        FGCOLOR 4  NO-UNDO.
      554   DEFINE VARIABLE rs-process AS INTEGER
      555        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      556        RADIO-BUTTONS
      557             "Все", 1,
      558   "Не рассчитываются", 2,
      559   "Рассчитываются", 3
      560        SIZE 59 BY .67
      561        FGCOLOR 4  NO-UNDO.
      562   DEFINE RECTANGLE RECT-1
      563        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      564        SIZE 49 BY 3.75.
      565   DEFINE RECTANGLE RECT-2
      566        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      567        SIZE 23.13 BY 3.75.
      568   DEFINE RECTANGLE RECT-3
      569        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      570        SIZE 23.13 BY 3.75.
      571   DEFINE QUERY BR-obj FOR
      572         temp-obj-arh SCROLLING.
      573   DEFINE BROWSE BR-obj
      574     QUERY BR-obj DISPLAY
      575         temp-obj-arh.db-num format ">>>>9"
      576         (temp-obj-arh.obj-type + ' ' + string(temp-obj-arh.obj-code)) @ v-object
      577         temp-obj-arh.obj-deleted
      578         archive-type-name(temp-obj-arh.archive-type) @ v-archive-type
      579         temp-obj-arh.archive-detail-date
      580         temp-obj-arh.archive-start-date
      581         temp-obj-arh.archive-recalc-date
      582         temp-obj-arh.archive-calc    format "*/ " column-label "Оборот"
      583         temp-obj-arh.archive-del     format "*/ " column-label "Остат"
      584         temp-obj-arh.archive-disable format "*/ " column-label "Запрщ"
      585         temp-obj-arh.archive-rest    format "*/ " column-label "Восст"
      586         temp-obj-arh.archive-bpexist format "*/ " column-label "Задания"
      587         temp-obj-arh.archive-execuser
      588         temp-obj-arh.archive-execsysdate
      589         temp-obj-arh.archive-execsystime
      590       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.63 BY 10.71.
      591   DEFINE FRAME Dialog-Frame
      592        b-exit AT ROW 1 COL 1
      593        b-hist AT ROW 1 COL 11
      594        b-refresh AT ROW 1 COL 21
      595        b-print AT ROW 1 COL 31
      596        b-excel AT ROW 1 COL 41
      597        b-calc AT ROW 1 COL 51
      598        b-calc-all AT ROW 1 COL 63
      599        B-Help AT ROW 1 COL 79
      600        rs-archive-type AT ROW 2.92 COL 21.13 NO-LABEL
      601        rs-bad-archive AT ROW 3.71 COL 21.13 NO-LABEL
      602        rs-process AT ROW 4.5 COL 21.13 NO-LABEL
      603        rs-batch-process AT ROW 5.33 COL 21.13 NO-LABEL
      604        rs-deleted AT ROW 6.13 COL 21.13 NO-LABEL
      605        cb-db AT ROW 6.92 COL 19.13 COLON-ALIGNED NO-LABEL
      606        fi-search AT ROW 6.92 COL 73.5 COLON-ALIGNED NO-LABEL
      607        BR-obj AT ROW 8.04 COL 1.25
      608        fi-date-time AT ROW 2.04 COL 1 NO-LABEL
      609        fi-description-1 AT ROW 2.92 COL 1 NO-LABEL
      610        fi-description-2 AT ROW 3.71 COL 1 NO-LABEL
      611        fi-description-3 AT ROW 4.5 COL 1 NO-LABEL
      612        fi-description-4 AT ROW 5.33 COL 1 NO-LABEL
      613        fi-description-5 AT ROW 6.13 COL 1 NO-LABEL
      614        fi-description-6 AT ROW 7.13 COL 1 NO-LABEL
      615        fi-search-description AT ROW 7.13 COL 47.75 COLON-ALIGNED NO-LABEL
      616        fi-obj-name AT ROW 18.85 COL 1 NO-LABEL
      617        fi-label-1 AT ROW 19.42 COL 7.88 COLON-ALIGNED NO-LABEL
      618        fi-label-2 AT ROW 19.5 COL 55.5 COLON-ALIGNED NO-LABEL
      619        fi-label-3 AT ROW 19.5 COL 79 COLON-ALIGNED NO-LABEL
      620        fi-description AT ROW 20.21 COL 2.63 NO-LABEL
      621        fi-calc-execuser AT ROW 20.5 COL 59.5 COLON-ALIGNED
      622        fi-rest-execuser AT ROW 20.5 COL 84.5 COLON-ALIGNED
      623        fi-detail-date AT ROW 21.25 COL 6.5
      624        fi-calc-execsysdate AT ROW 21.38 COL 59.5 COLON-ALIGNED
      625        fi-rest-execsysdate AT ROW 21.38 COL 84.5 COLON-ALIGNED
      626        fi-start-date AT ROW 22.25 COL 9.5
      627        fi-calc-execsystime AT ROW 22.46 COL 59.5 COLON-ALIGNED
      628        fi-rest-execsystime AT ROW 22.46 COL 84.5 COLON-ALIGNED
      629        RECT-1 AT ROW 19.75 COL 1
      630        RECT-2 AT ROW 19.75 COL 76.5
      631        RECT-3 AT ROW 19.75 COL 51
      632        SPACE(25.75) SKIP(0.07)
      633       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      634            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      635            TITLE "Складские архивы на объектах"
      636            DEFAULT-BUTTON b-exit.
      637   ASSIGN
      638          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      639          FRAME Dialog-Frame:HIDDEN           = TRUE.
      640   ASSIGN
      641          BR-obj:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 4.
      642   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      643   DO:
      644     APPLY "END-ERROR":U TO SELF.
      645   END.
      646   ON CHOOSE OF b-calc IN FRAME Dialog-Frame
      647   DO:
      648   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649   if lookup(self :type
      650            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      651            ) = 0
      652   then do:
      653     message
      654       "$Workfile$"
      655       "Указанному интерфейсному элементу фокус не может быть передан" skip
      656       "Интерфейсный элемент" self :name  skip
      657       "Тип" self :type  skip
      658       "Процедура" this-procedure :file-name skip
      659       view-as alert-box .
      660   end.
      661   else do:
      662     apply "entry":u to self  .
      663     if focus :handle <> self :handle  then do:
      664       return no-apply .
      665     end.
      666   end.
      667     run calc-archive in this-procedure .
      668   END.
      669   ON CHOOSE OF b-calc-all IN FRAME Dialog-Frame
      670   DO:
      671   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      672   if lookup(self :type
      673            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      674            ) = 0
      675   then do:
      676     message
      677       "$Workfile$"
      678       "Указанному интерфейсному элементу фокус не может быть передан" skip
      679       "Интерфейсный элемент" self :name  skip
      680       "Тип" self :type  skip
      681       "Процедура" this-procedure :file-name skip
      682       view-as alert-box .
      683   end.
      684   else do:
      685     apply "entry":u to self  .
      686     if focus :handle <> self :handle  then do:
      687       return no-apply .
      688     end.
      689   end.
      690     define variable v-ok as logical   no-undo .
      691     if available temp-obj-arh
      692     then do:
      693       message
      694         "Рассчитать архив для всех показанных объектов" skip
      695         "Продолжить?" skip
      696         view-as alert-box question buttons yes-no update v-ok .
      697       if v-ok <> true
      698       then do:
      699         return no-apply .
      700       end.
      701       run calc-all-temp-obj-arh in this-procedure
      702         no-error .
      703       if error-status :error
      704       then do:
      705         message
      706           "Ошибка при расчете архива" skip
      707           "Объект" temp-obj-arh.obj-type temp-obj-arh.obj-code skip
      708           "Складской архив" archive-type-name(temp-obj-arh.archive-type) skip
      709           error-status :get-message(1) skip
      710           return-value skip
      711           view-as alert-box error .
      712         return no-apply .
      713       end.
      714       else do:
      715         message
      716           "Рассчет архивов закончен" skip
      717           view-as alert-box information .
      718       end.
      719     end.
      720     run openbr in this-procedure
      721       (input true
      722       ).
      723   END.
