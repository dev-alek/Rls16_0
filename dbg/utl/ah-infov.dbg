       76     field archive-calc             as logical   format "+/-":U         label 'Не рассчитан оборот'
       77     field archive-del              as logical   format "+/-":U         label 'Не рассчитан нач.остаток'
       78     field archive-disable          as logical   format "+/-":U         label 'Расчет архива запрещен'
       79     field archive-rest             as logical   format "+/-":U         label 'Сбой удал./восст.'
       80     field archive-bpexist          as logical   format "+/-":U         label 'Имеются задания на расчет'
       81     field archive-detail-date      as date      format '99/99/9999':u  label 'Подробный'
       82     field archive-start-date       as date      format '99/99/9999':u  label 'Сжатый'
       83     field archive-recalc-date      as date      format '99/99/9999':u  label 'Перерасчёт'
       84     field archive-lock-prc         as logical                          label 'Расчёт'
       85     field archive-execuser         like ub.batchprocess.bp_execuser_id label 'Пользователь' column-label 'Пользователь'
