     2749       assign
     2750         v-curr-rowid = rowid(temp-obj-arh)
     2751       .
     2752       run ah-infov_get-first in this-procedure .
     2753       do while true
     2754       :
     2755         define variable v-available                as logical   no-undo .
     2756         define variable v-db-num                   as integer   no-undo .
     2757         define variable v-obj-type                 as character no-undo .
     2758         define variable v-obj-code                 as integer   no-undo .
     2759         define variable v-archive-type             as character no-undo .
     2760         define variable v-deleted                  as logical   no-undo .
     2761         define variable v-archive-calc             as logical   no-undo .
     2762         define variable v-archive-del              as logical   no-undo .
     2763         define variable v-archive-disable          as logical   no-undo .
     2764         define variable v-archive-rest             as logical   no-undo .
     2765         define variable v-archive-bpexist          as logical   no-undo .
     2766         define variable v-archive-detail-date      as date      no-undo .
     2767         define variable v-archive-start-date       as date      no-undo .
     2768         define variable v-archive-lock-prc         as logical   no-undo .
     2769         define variable v-archive-execuser         as character no-undo .
     2770         define variable v-archive-execsysdate      as date      no-undo .
     2771         define variable v-archive-execsystime      as character no-undo .
     2772         define variable v-archive-rest-lock-prc    as logical   no-undo .
     2773         define variable v-archive-rest-execuser    as character no-undo .
     2774         define variable v-archive-rest-execsysdate as date      no-undo .
     2775         define variable v-archive-rest-execsystime as character no-undo .
     2776         define variable v-archive-date-recalc      as date      no-undo .
     2777         run ah-infov_get-current in this-procedure
     2778           (output v-available
     2779           ,output v-db-num
     2780           ,output v-obj-type
     2781           ,output v-obj-code
     2782           ,output v-archive-type
     2783           ,output v-deleted
     2784           ,output v-archive-calc
     2785           ,output v-archive-del
     2786           ,output v-archive-disable
     2787           ,output v-archive-rest
     2788           ,output v-archive-bpexist
     2789           ,output v-archive-detail-date
     2790           ,output v-archive-start-date
     2791           ,output v-archive-date-recalc
     2792           ,output v-archive-lock-prc
     2793           ,output v-archive-execuser
     2794           ,output v-archive-execsysdate
     2795           ,output v-archive-execsystime
     2796           ,output v-archive-rest-lock-prc
     2797           ,output v-archive-rest-execuser
     2798           ,output v-archive-rest-execsysdate
     2799           ,output v-archive-rest-execsystime
     2800           ) .
     2801         if v-available <> true
     2802         then do:
     2803           leave .
     2804         end.
     2805         run calc-temp-obj-arh in this-procedure
     2806           (input  v-obj-type
     2807           ,input  v-obj-code
     2808           ,input  v-archive-type
     2809           ) no-error .
     2810         if error-status :error
     2811         then do:
     2812           undo, return error return-value .
     2813         end.
     2814         run ah-infov_get-next in this-procedure .
     2815       end.
     2816       reposition BR-obj to rowid v-curr-rowid no-error .
     2817       if error-status :error
     2818       then do:
     2819         reposition BR-obj to row 1 .
     2820       end.
     2821     end.
     2822   END PROCEDURE.
     2823   PROCEDURE calc-archive :
     2824     if available temp-obj-arh
     2825     then do:
     2826       define variable v-ok as logical   no-undo .
     2827       message
     2828         "Объект" temp-obj-arh.obj-type temp-obj-arh.obj-code skip
     2829         "Рассчитать складской архив" archive-type-name(temp-obj-arh.archive-type) skip
     2830         "Продолжить?" skip
     2831         view-as alert-box question buttons yes-no update v-ok .
     2832       if v-ok <> true
     2833       then do:
     2834         return .
     2835       end.
     2836       run calc-temp-obj-arh in this-procedure
     2837         (input  temp-obj-arh.obj-type
     2838         ,input  temp-obj-arh.obj-code
     2839         ,input  temp-obj-arh.archive-type
     2840         ) no-error .
     2841       if error-status :error
     2842       then do:
     2843         message
     2844           "Объект" temp-obj-arh.obj-type temp-obj-arh.obj-code skip
     2845           "Складской архив" archive-type-name(temp-obj-arh.archive-type) skip
     2846           error-status :get-message(1) skip
     2847           return-value skip
     2848           view-as alert-box error .
     2849       end.
     2850       else do:
     2851         message
     2852           "Объект" temp-obj-arh.obj-type temp-obj-arh.obj-code skip
     2853           "Рассчет складского архива" archive-type-name(temp-obj-arh.archive-type) "закончен" skip
     2854           view-as alert-box information .
     2855       end.
     2856     end.
     2857     run openbr in this-procedure
     2858       (input true
     2859       ).
     2860   END PROCEDURE.
     2861   PROCEDURE calc-temp-obj-arh :
     2862     define input  parameter p-obj-type     as character no-undo .
     2863     define input  parameter p-obj-code     as integer   no-undo .
     2864     define input  parameter p-archive-type as character no-undo .
     2865     do
     2866     on error undo, return error return-value
     2867     :
     2868       case p-archive-type
     2869       :
     2870         when 'arh':U
     2871         then do:
     2872           run trg/bt_arh.p
     2873             (input p-obj-type
     2874             ,input p-obj-code
     2875             ,input ?
     2876             ,input true
     2877             ,input v-cntxt-db-num
     2878             ,input v-cntxt-userid
     2879             ) no-error .
     2880           if error-status :error
     2881           then do:
     2882             undo, return error return-value .
     2883           end.
     2884         end.
     2885         when 'ahsp':U
     2886         then do:
     2887           run trg/bt_ahsp.p
     2888             (input p-obj-type
     2889             ,input p-obj-code
     2890             ,input ?
     2891             ,input true
     2892             ,input v-cntxt-db-num
     2893             ,input v-cntxt-userid
     2894             ) no-error .
     2895           if error-status :error
     2896           then do:
     2897             undo, return error return-value .
     2898           end.
     2899         end.
     2900         when 'aht':U
     2901         then do:
     2902           run trg/bt_aht.p
     2903             (input p-obj-type
     2904             ,input p-obj-code
     2905             ,input ?
     2906             ,input true
     2907             ,input v-cntxt-db-num
     2908             ,input v-cntxt-userid
     2909             ) no-error .
     2910           if error-status :error
     2911           then do:
     2912             undo, return error return-value .
     2913           end.
     2914         end.
     2915       end case .
     2916     end.
     2917   END PROCEDURE.
     2918   PROCEDURE disable_UI :
     2919     HIDE FRAME Dialog-Frame.
     2920   END PROCEDURE.
     2921   PROCEDURE display-history :
     2922     define variable v-curr-rowid as rowid     no-undo .
     2923     if available temp-obj-arh
     2924     then do:
     2925       run utl/histarhv.w
     2926         (input this-procedure :handle
     2927         ) .
     2928       if available temp-obj-arh
     2929       then do:
     2930         assign
     2931           v-curr-rowid = rowid(temp-obj-arh)
     2932         .
     2933         reposition BR-obj to rowid v-curr-rowid no-error .
     2934         if error-status :error
     2935         then do:
     2936           reposition BR-obj to row 1 .
     2937         end.
     2938       end.
     2939       else do:
     2940         reposition BR-obj to row 1 .
     2941       end.
     2942     end.
     2943   END PROCEDURE.
     2944   PROCEDURE enable_UI :
     2945     DISPLAY rs-archive-type rs-bad-archive rs-process rs-batch-process rs-deleted
     2946             cb-db fi-search fi-date-time fi-description-1 fi-description-2
     2947             fi-description-3 fi-description-4 fi-description-5 fi-description-6
     2948             fi-search-description fi-obj-name fi-label-1 fi-label-2 fi-label-3
     2949             fi-description fi-calc-execuser fi-rest-execuser fi-detail-date
     2950             fi-calc-execsysdate fi-rest-execsysdate fi-start-date
     2951             fi-calc-execsystime fi-rest-execsystime
     2952         WITH FRAME Dialog-Frame.
     2953     ENABLE b-exit b-hist b-refresh b-print b-excel b-calc b-calc-all B-Help
     2954            RECT-1 RECT-2 RECT-3 rs-archive-type rs-bad-archive rs-process
     2955            rs-batch-process rs-deleted cb-db fi-search BR-obj fi-date-time
     2956            fi-description-1 fi-description-2 fi-description-3 fi-description-4
     2957            fi-description-5 fi-description-6 fi-search-description fi-obj-name
     2958            fi-label-1 fi-label-2 fi-label-3 fi-description fi-calc-execuser
     2959            fi-rest-execuser fi-detail-date fi-start-date
     2960         WITH FRAME Dialog-Frame.
     2961     VIEW FRAME Dialog-Frame.
     2962   END PROCEDURE.
     2963   PROCEDURE OpenBr :
     2964     define input  parameter p-refresh-query as logical   no-undo .
     2965     define variable v-cur-obj-type     as character no-undo .
     2966     define variable v-cur-obj-code     as integer   no-undo .
     2967     define variable v-cur-archive-type as character no-undo .
     2968     do
     2969     on error undo, return error return-value
     2970     :
     2971       if available temp-obj-arh
     2972       then do:
     2973         assign
     2974           v-cur-obj-type     = temp-obj-arh.obj-type
     2975           v-cur-obj-code     = temp-obj-arh.obj-code
     2976           v-cur-archive-type = temp-obj-arh.archive-type
     2977         .
     2978       end.
     2979       if p-refresh-query = true
     2980       then do:
     2981         do with frame Dialog-Frame:
     2982           assign
     2983             fi-date-time :screen-value = "*** запрос информации ***"
     2984           .
     2985         end.
     2986         run cur-time in this-procedure
     2987           (output v-today
     2988           ,output v-time
     2989           ).
     2990         run utl/ah-info.p
     2991           (output table temp-obj-arh
     2992           ).
     2993         assign
     2994           frame Dialog-Frame :title = "Архивы на объектах: Состояние на " + string( v-today, "99/99/9999" ) + chr(32) + string( v-time, "HH:MM:SS" ).
     2995         .
     2996         do with frame Dialog-Frame:
     2997           assign
     2998             fi-date-time :screen-value = "Состояние на" + chr(32) + string( v-today, "99/99/9999" ) + chr(32) + string( v-time, "HH:MM:SS" )
     2999           .
     3000         end.
     3001       end.
     3002       open query br-obj for each temp-obj-arh no-lock
     3003         where ( rs-archive-type = 1
     3004                 or
     3005                 ( rs-archive-type = 2
     3006                   and
     3007                   temp-obj-arh.archive-type = 'arh':U
     3008                 )
     3009                 or
     3010                 ( rs-archive-type = 3
     3011                   and
     3012                   temp-obj-arh.archive-type = 'ahsp':U
     3013                 )
     3014                 or
     3015                 ( rs-archive-type = 4
     3016                   and
     3017                   temp-obj-arh.archive-type = 'aht':U
     3018                 )
     3019               )
     3020           and ( rs-bad-archive = 1
     3021                 or
     3022                 ( rs-bad-archive = 2
     3023                   and
     3024                   ( temp-obj-arh.archive-calc = true
     3025                     or
     3026                     temp-obj-arh.archive-del  = true
     3027                     or
     3028                     temp-obj-arh.archive-rest = true
     3029                   )
     3030                   and
     3031                   temp-obj-arh.archive-disable <> true
     3032                 )
     3033                 or
     3034                 ( rs-bad-archive = 3
     3035                   and
     3036                   ( temp-obj-arh.archive-calc <> true
     3037                     and
     3038                     temp-obj-arh.archive-del  <> true
     3039                     and
     3040                     temp-obj-arh.archive-rest <> true
     3041                   )
     3042                 )
     3043                 or
     3044                 ( rs-bad-archive = 4
     3045                   and
     3046                   ( temp-obj-arh.archive-calc = true
     3047                     or
     3048                     temp-obj-arh.archive-del  = true
     3049                     or
     3050                     temp-obj-arh.archive-rest = true
     3051                   )
     3052                   and
     3053                   temp-obj-arh.archive-disable = true
     3054                 )
     3055               )
     3056           and ( rs-batch-process = 1
     3057                 or
     3058                 ( rs-batch-process = 2
     3059                   and
     3060                   ( temp-obj-arh.archive-bpexist = true
     3061                     or
     3062                     temp-obj-arh.archive-recalc-date <> ?
     3063                   )
     3064                 )
     3065                 or
     3066                 ( rs-batch-process = 3
     3067                   and
     3068                   ( temp-obj-arh.archive-bpexist = false
     3069                     and
     3070                     temp-obj-arh.archive-recalc-date = ?
     3071                   )
     3072                 )
     3073               )
     3074           and ( ( rs-deleted = 1
     3075                   and
     3076                   temp-obj-arh.obj-deleted <> true
     3077                 )
     3078                 or
     3079                 rs-deleted = 2
     3080                 or
     3081                 ( rs-deleted = 3
     3082                   and
     3083                   temp-obj-arh.obj-deleted = true
     3084                 )
     3085               )
     3086           and ( rs-process = 1
     3087                 or
     3088                 ( rs-process = 2
     3089                   and
     3090                   temp-obj-arh.archive-lock-prc <> true
     3091                 )
     3092                 or
     3093                 ( rs-process = 3
     3094                   and
     3095                   temp-obj-arh.archive-lock-prc = true
     3096                 )
     3097               )
     3098           and ( v-filter-db <> true
     3099                 or
     3100                 ( v-filter-db = true
     3101                   and
     3102                   ( cb-db = v-all-db
     3103                     or
     3104                     ( cb-db <> v-all-db
     3105                       and
     3106                       temp-obj-arh.db-num = integer(cb-db)
     3107                     )
     3108                   )
     3109                 )
     3110               )
     3111         by temp-obj-arh.db-num
     3112         by temp-obj-arh.obj-type
     3113         by temp-obj-arh.obj-code
     3114         by temp-obj-arh.sort-code
     3115         .
     3116       define buffer buf_temp-obj-arh for temp-obj-arh .
     3117       find first buf_temp-obj-arh
     3118         where buf_temp-obj-arh.obj-type     = v-cur-obj-type
     3119           and buf_temp-obj-arh.obj-code     = v-cur-obj-code
     3120           and buf_temp-obj-arh.archive-type = v-cur-archive-type
     3121         no-error .
     3122       if available buf_temp-obj-arh
     3123       then do:
     3124         reposition br-obj to recid recid(buf_temp-obj-arh) no-error .
     3125         if error-status :error
     3126         then do:
     3127           reposition br-obj to row 1 .
     3128         end.
     3129       end.
     3130       run proc-display-fields in this-procedure .
     3131       APPLY "ENTRY" TO BR-obj.
     3132     end.
     3133   END PROCEDURE.
     3134   PROCEDURE print-all-to-excel :
     3135     define variable v-curr-rowid as rowid no-undo .
     3136     assign
     3137       v-curr-rowid = rowid(temp-obj-arh)
     3138     .
     3139     run utl/ahinfxls.p
     3140       (input this-procedure :handle
     3141       ) .
     3142     reposition BR-obj to rowid v-curr-rowid no-error .
     3143     if error-status :error
     3144     then do:
     3145       reposition BR-obj to row 1 .
     3146     end.
     3147   END PROCEDURE.
     3148   PROCEDURE print-temp-obj-arh :
     3149     define variable v-curr-rowid as rowid no-undo .
     3150     assign
     3151       v-curr-rowid = rowid(temp-obj-arh)
     3152     .
     3153     if available temp-obj-arh
     3154     then do:
     3155       run utl/ahinfprn.p
     3156         (input parparentproc
     3157         ,input this-procedure :handle
     3158         ) .
     3159     end.
     3160     reposition BR-obj to rowid v-curr-rowid no-error .
     3161     if error-status :error
     3162     then do:
     3163       reposition BR-obj to row 1 .
     3164     end.
     3165   END PROCEDURE.
     3166   PROCEDURE Proc-display-fields :
     3167     define buffer buf_clients for ub.clients .
     3168     if available temp-obj-arh
     3169     then do:
     3170       find first buf_clients no-lock
     3171         where buf_clients.obj-type = temp-obj-arh.obj-type
     3172           and buf_clients.obj-code = temp-obj-arh.obj-code
     3173         no-error .
     3174       if available buf_clients
     3175       then do:
     3176         assign
     3177           fi-obj-name = substitute("&1 &2  &3  &4"
     3178                        ,temp-obj-arh.obj-type
     3179                        ,temp-obj-arh.obj-code
     3180                        ,buf_clients.obj-name
     3181                        ,archive-type-name(temp-obj-arh.archive-type)
     3182                        )
     3183         .
     3184       end.
     3185       else do:
     3186         assign
     3187           fi-obj-name = substitute("&1 &2  &3  &4"
     3188                        ,temp-obj-arh.obj-type
     3189                        ,temp-obj-arh.obj-code
     3190                        ,""
     3191                        ,archive-type-name(temp-obj-arh.archive-type)
     3192                        )
     3193         .
     3194       end.
     3195       do with frame Dialog-Frame:
     3196         assign
     3197           fi-description             = ""
     3198           fi-detail-date      = ?
     3199           fi-start-date       = ?
     3200           fi-calc-execuser         = ""
     3201           fi-calc-execsysdate      = ?
     3202           fi-calc-execsystime      = ""
     3203           fi-rest-execuser    = ""
     3204           fi-rest-execsysdate = ?
     3205           fi-rest-execsystime = ""
     3206         .
     3207         assign
     3208           fi-description   = (if temp-obj-arh.archive-disable = true
     3209                               then "Расчет архива отключен"
     3210                               else (if temp-obj-arh.archive-del = true
     3211                                     then (if temp-obj-arh.archive-lock-prc = true
     3212                                           then "Расчёт начальных остатков"
     3213                                           else "Не рассчитаны начальные остатки"
     3214                                          )
     3215                                     else (if temp-obj-arh.archive-calc = true
     3216                                           then (if temp-obj-arh.archive-lock-prc = true
     3217                                                 then "Расчёт оборотов"
     3218                                                 else "Не рассчитаны обороты"
     3219                                                 )
     3220                                           else (if temp-obj-arh.archive-rest = true
     3221                                                 then (if temp-obj-arh.archive-lock-prc = true
     3222                                                       then "Удаление/восстановление"
     3223                                                       else "Сбой удаления восстановления"
     3224                                                       )
     3225                                                 else (if temp-obj-arh.archive-recalc-date <> ?
     3226                                                       then (if temp-obj-arh.archive-calc = true
     3227                                                             then substitute("Перерасчет с даты &1"
     3228                                                                            ,string(temp-obj-arh.archive-recalc-date, '99/99/9999':u)
     3229                                                                            )
     3230                                                             else substitute("Требуется перерасчет с даты &1"
     3231                                                                            ,string(temp-obj-arh.archive-recalc-date, '99/99/9999':u)
     3232                                                                            )
     3233                                                            )
     3234                                                       else (if temp-obj-arh.archive-bpexist = true
     3235                                                             then (if temp-obj-arh.archive-calc = true
     3236                                                                   then "Обработка заданий на расчет архива"
     3237                                                                   else "Имеются задания на расчет архива"
     3238                                                                 )
     3239                                                             else ""
     3240                                                            )
     3241                                                      )
     3242                                                )
     3243                                          )
     3244                                    )
     3245                              )
     3246           fi-detail-date   = temp-obj-arh.archive-detail-date
     3247           fi-start-date    = temp-obj-arh.archive-start-date
     3248         .
     3249         if temp-obj-arh.archive-lock-prc = true
     3250         then do:
     3251           assign
     3252             fi-calc-execuser    = temp-obj-arh.archive-execuser
     3253             fi-calc-execsysdate = temp-obj-arh.archive-execsysdate
     3254             fi-calc-execsystime = temp-obj-arh.archive-execsystime
     3255           .
     3256         end.
     3257         if temp-obj-arh.archive-rest-lock-prc = true
     3258         then do:
     3259           assign
     3260             fi-rest-execuser    = temp-obj-arh.archive-rest-execuser
     3261             fi-rest-execsysdate = temp-obj-arh.archive-rest-execsysdate
     3262             fi-rest-execsystime = temp-obj-arh.archive-rest-execsystime
     3263           .
     3264         end.
     3265       end.
     3266       display
     3267         fi-obj-name
     3268         fi-description
     3269         fi-detail-date
     3270         fi-start-date
     3271         fi-calc-execuser
     3272         fi-calc-execsysdate
     3273         fi-calc-execsystime
     3274         fi-rest-execuser
     3275         fi-rest-execsysdate
     3276         fi-rest-execsystime
     3277         with frame Dialog-Frame.
     3278     end.
     3279   END PROCEDURE.
     3280   PROCEDURE setup-initial-values :
     3281     define buffer buf_sys-ctrl for ub.sys-ctrl .
     3282     define buffer buf_db       for ub.db .
     3283     do with frame Dialog-Frame:
     3284       assign
     3285         rs-archive-type  = 1
     3286         rs-bad-archive   = 1
     3287         rs-batch-process = 1
     3288         rs-deleted       = 1
     3289         rs-process       = 1
     3290       .
     3291       display
     3292         rs-archive-type
     3293         rs-bad-archive
     3294         rs-batch-process
     3295         rs-deleted
     3296         rs-process
     3297         with frame Dialog-Frame .
     3298       find buf_sys-ctrl .
     3299       if buf_sys-ctrl.db-num = 0
     3300       then do:
     3301         assign
     3302           v-filter-db = true
     3303         .
     3304       end.
     3305       else do:
     3306         assign
     3307           v-filter-db = false
     3308         .
     3309       end.
     3310       if v-filter-db = true
     3311       then do:
     3312         define variable v-db-list as character no-undo .
     3313         assign
     3314           v-db-list = v-all-db
     3315         .
     3316         for each buf_db no-lock
     3317           by buf_db.db-num
     3318         on error undo, return error return-value
     3319         :
     3320           assign
     3321             v-db-list = v-db-list
     3322                       + (if v-db-list <> '':u then ',':u else '':u)
     3323                       + string(buf_db.db-num)
     3324           .
     3325         end.
     3326         assign
     3327           cb-db :list-items = v-db-list
     3328         .
     3329         assign
     3330           cb-db = v-all-db
     3331         .
     3332         display
     3333           cb-db
     3334           with frame Dialog-Frame .
     3335         enable
     3336           cb-db
     3337           with frame Dialog-Frame .
     3338       end.
     3339       else do:
     3340         disable
     3341           cb-db
     3342           with frame Dialog-Frame .
     3343       end.
     3344     end.
     3345   END PROCEDURE.
     3346   FUNCTION archive-type-name RETURNS CHARACTER
     3347     ( input p-archive-type as character ) :
     3348     define variable v-archive-type-name as character no-undo .
