      347   procedure proc-alt-shift-f2:
      348     if not ibs.th.gbl.gbl-var:rcode
      349   then
      350     run gbl\inidebug.p .
      351   end.
      352   procedure proc-alt-shift-f3:
      353     run gbl/prvssinf.p
      354       ( input this-procedure
      355       ) .
      356   end.
      357   define variable v-inform-launched as logical no-undo initial false .
      358   procedure proc-alt-shift-f4:
      359     define variable v-action as character no-undo .
      360     if v-inform-launched = false then do:
      361       assign
      362         v-inform-launched = true
      363       .
      364       run gbl/d-inform.w
      365         (  input self
      366         ,  input this-procedure
      367         , output v-action
      368         ) no-error .
      369       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      370       assign
      371         v-inform-launched = false
      372       .
      373     end.
      374   end.
      375   procedure proc-alt-f1:
      376     run gbl/corrhelp.p
      377       (input this-procedure
      378       ) .
      379   end .
