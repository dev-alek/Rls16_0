     2597         then do:
     2598           assign
     2599             p-history-description = "расчёт-начало"
     2600           .
     2601         end.
     2602         when 'calc-stop':U
     2603         then do:
     2604           assign
     2605             p-history-description = "расчёт-окончание"
     2606           .
     2607         end.
     2608         when 'set-calc':U
     2609         then do:
     2610           assign
     2611             p-history-description = "пометить-нерассчитанные"
     2612           .
     2613         end.
     2614         when 'set-del':U
     2615         then do:
     2616           assign
     2617             p-history-description = "пометить-удалённые"
     2618           .
     2619         end.
     2620         when 'set-disable':U
     2621         then do:
     2622           assign
     2623             p-history-description = "пометить-запретить"
     2624           .
     2625         end.
     2626         when 'clear-disable':U
     2627         then do:
     2628           assign
     2629             p-history-description = "пометить-разрешить"
     2630           .
     2631         end.
     2632         when 'set-recalc':U
     2633         then do:
     2634           assign
     2635             p-history-description = "пометить-перерассчитать"
     2636           .
     2637         end.
     2638         when 'init-start':U
     2639         then do:
     2640           assign
     2641             p-history-description = "инициализация-начало"
     2642           .
     2643         end.
     2644         when 'init-stop':U
     2645         then do:
     2646           assign
     2647             p-history-description = "инициализация-окончание"
     2648           .
     2649         end.
     2650         when 'delall-start':U
     2651         then do:
     2652           assign
     2653             p-history-description = "удаление-начало"
     2654           .
     2655         end.
     2656         when 'delall-stop':U
     2657         then do:
     2658           assign
     2659             p-history-description = "удаление-окончание"
     2660           .
     2661         end.
     2662         when 'deldet-start':U
     2663         then do:
     2664           assign
     2665             p-history-description = "сжатие-начало"
     2666           .
     2667         end.
     2668         when 'deldet-stop':U
     2669         then do:
     2670           assign
     2671             p-history-description = "сжатие-окончание"
     2672           .
     2673         end.
     2674         when 'rstfil-start':U
     2675         then do:
     2676           assign
     2677             p-history-description = "восстановление-начало"
     2678           .
     2679         end.
     2680         when 'rstfil-stop':U
     2681         then do:
     2682           assign
     2683             p-history-description = "восстановление-окончание"
     2684           .
     2685         end.
     2686         when 'rstdoc-start':U
     2687         then do:
     2688           assign
     2689             p-history-description = "расчет-назад-начало"
     2690           .
     2691         end.
     2692         when 'rstdoc-stop':U
     2693         then do:
     2694           assign
     2695             p-history-description = "расчет-назад-окончание"
     2696           .
     2697         end.
     2698         when 'ren-gds-code':U
     2699         then do:
