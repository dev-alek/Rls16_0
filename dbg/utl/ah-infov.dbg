     1031       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1032       "Интерфейсный элемент" self :name  skip
     1033       "Тип" self :type  skip
     1034       "Процедура" this-procedure :file-name skip
     1035       view-as alert-box .
     1036   end.
     1037   else do:
     1038     apply "entry":u to self  .
     1039     if focus :handle <> self :handle  then do:
     1040       return no-apply .
     1041     end.
     1042   end.
     1043     assign
     1044       rs-deleted
     1045       .
     1046     run openbr in this-procedure
     1047       (input false
     1048       ) .
     1049   END.
     1050   ON VALUE-CHANGED OF rs-process IN FRAME Dialog-Frame
     1051   DO:
     1052   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   if lookup(self :type
     1054            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1055            ) = 0
     1056   then do:
     1057     message
     1058       "$Workfile$"
     1059       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1060       "Интерфейсный элемент" self :name  skip
     1061       "Тип" self :type  skip
     1062       "Процедура" this-procedure :file-name skip
     1063       view-as alert-box .
     1064   end.
     1065   else do:
     1066     apply "entry":u to self  .
     1067     if focus :handle <> self :handle  then do:
     1068       return no-apply .
     1069     end.
     1070   end.
     1071     assign
     1072       rs-process
     1073       .
     1074     run openbr in this-procedure
     1075       (input false
     1076       ) .
     1077   END.
     1078   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1079   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1080   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081   on help of frame Dialog-Frame
     1082   do:
     1083     run gbl/app_help.p
     1084       (input this-procedure :file-name
     1085       ,input ''
     1086       ,input ?
     1087       ) no-error.
     1088     if error-status :error then do:
     1089       message
     1090         "Ошибка при вызове помощи"
     1091         error-status :get-message(1)
     1092         view-as alert-box .
     1093     end.
     1094   end.
     1095   run minbtn-set in this-procedure .
     1096   on choose of b-help in frame Dialog-Frame
     1097   do:
     1098     apply "help":u to frame Dialog-Frame .
     1099   end.
     1100   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1101   procedure minbtn-set :
     1102       do
     1103           on error undo, return error return-value
     1104           :
     1105           define variable ii              as integer       no-undo .
     1106           define variable fh              as widget-handle no-undo .
     1107           define variable hh              as widget-handle no-undo .
     1108           define variable v-h             as handle        extent 4 no-undo .
     1109           define variable v-name-button   as character     no-undo .
     1110           define variable v-help-old-x    as decimal       no-undo .
     1111           define variable v-help-old-y    as decimal       no-undo .
     1112           define variable v-help-old-size as decimal       no-undo .
     1113           define variable v-frame-width   as decimal       no-undo .
     1114           define variable jj              as integer       no-undo .
     1115           do
     1116               on error undo, return error
     1117               :
     1118               assign
     1119                   v-frame-width = frame Dialog-Frame:width - 0.3
     1120                   fh            = frame Dialog-Frame:first-child
     1121                   hh            = fh:first-child
     1122                   ii            = 1
     1123                   .
     1124               do while valid-handle(hh):
     1125                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1126                   do:
     1127                       case lc(hh:name) :
     1128                           when "b-help" then
     1129                               do:
     1130                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1131                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1132                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1133                                   hh:TOOLTIP = "Помощь" .
     1134                                   v-help-old-x = hh:column .
     1135                                   v-help-old-y = hh:row    .
     1136                                   v-help-old-size = hh:width .
     1137                                   hh:width-chars = 2.5 .
     1138                               end.
     1139                           when "b-print" then
     1140                               do:
     1141                                   hh:load-image("cmp/b-print.bmp":u) .
     1142                                   hh:TOOLTIP = "Печать" .
     1143                                   v-h[ii] = hh:handle .
     1144                                   ii = ii + 1 .
     1145                                   hh:width-chars = 3 .
     1146                               end.
     1147                           when "b-history" or
     1148                           when "b-hist" then
     1149                               do:
     1150                                   hh:load-image("cmp/b-hist.bmp":u) .
     1151                                   hh:TOOLTIP = "История" .
     1152                                   v-h[ii] = hh:handle .
     1153                                   ii = ii + 1 .
     1154                                   hh:width-chars = 3 .
     1155                               end.
     1156                           when "b-sch" then
     1157                               do:
     1158                                   hh:load-image("cmp/b-sch.bmp":u) .
     1159                                   hh:TOOLTIP = "Установка Фильтра" .
     1160                                   v-h[ii] = hh:handle .
     1161                                   ii = ii + 1 .
     1162                                   hh:width-chars = 3 .
     1163                               end.
     1164                           when "b-hist-user" then
     1165                               do:
     1166                                   hh:load-image("cmp/b-hist.bmp":u) .
     1167                                   hh:TOOLTIP = "История пользователя" .
     1168                                   ii = ii + 1 .
     1169                               end.
     1170                       end case.
     1171                   end.
     1172                   hh = hh:next-sibling.
     1173               end.
     1174               b-help:column = v-frame-width - b-help:width-chars.
     1175               jj = 0.
     1176               repeat ii = 4 to 1 by -1 :
     1177                   if valid-handle (v-h[ii] ) then
     1178                   do:
     1179                       jj  = jj + 1 .
     1180                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1181                       v-h[ii]:row    = v-help-old-y .
     1182                   end.
     1183               end.
     1184           end.
     1185       end.
     1186   end procedure.
     1187   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1188   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1189   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1190   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1191   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1192   define variable v-diasize-current-frame-height as decimal   no-undo .
     1193   define variable v-diasize-change-size          as logical   no-undo .
     1194   define variable v-diasize-resize-button        as handle    no-undo .
     1195   define variable v-diasize-wndmax               as logical   no-undo .
     1196   define variable v-diasize-wndstore             as logical   no-undo .
     1197   define variable v-diasize-proc-name            as character no-undo .
     1198   define variable v-diasize-browse-handle        as handle    no-undo .
     1199   define variable v-diasize-browse-number        as integer   no-undo .
     1200   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1201   define temp-table temp-diasize-handle no-undo
     1202     field handle-value  as handle
     1203     field save-position as decimal
     1204     index xpk is primary unique handle-value
     1205     .
     1206   define temp-table temp-browse-handle no-undo
     1207     field browse-type   as character
     1208     field browse-number as integer
     1209     field browse-handle as handle
     1210     field original-size as decimal
     1211     index xpk is primary unique browse-type browse-number
     1212     index xie browse-type browse-handle
     1213   .
     1214   procedure diasize_change-height :
     1215     define input  parameter p-change-value  as decimal   no-undo .
     1216     define input  parameter p-move-resize   as logical   no-undo .
     1217     define variable v-field-group-handle    as handle    no-undo .
     1218     define variable v-object-handle         as handle    no-undo .
     1219     define variable v-frame-height          as decimal   no-undo .
     1220     define variable v-frame-virtual-height  as decimal   no-undo .
     1221     define variable v-browse-height         as decimal   no-undo .
     1222     define variable v-window-height         as decimal   no-undo .
     1223     define variable v-window-virtual-height as decimal   no-undo .
     1224     define variable v-change-sign           as integer   no-undo .
     1225     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1226     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1227     if p-change-value > 0
     1228     then do:
     1229       if frame Dialog-Frame :height + p-change-value
     1230           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1231       then do:
     1232         assign
     1233           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1234                           - (frame Dialog-Frame :height-chars)
     1235         .
     1236         if p-change-value <= 0
     1237         then do:
     1238           run diasize_position-resize-button in this-procedure .
     1239           return .
     1240         end.
     1241       end.
     1242     end.
     1243     if p-change-value < 0
     1244     then do:
     1245       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1246       then do:
     1247         assign
     1248           p-change-value = v-diasize-orig-frame-height
     1249                          - (frame Dialog-Frame :height-chars)
     1250         .
     1251         if p-change-value >= 0
     1252         then do:
     1253           run diasize_position-resize-button in this-procedure .
     1254           return .
     1255         end.
     1256       end.
     1257     end.
     1258     if p-change-value >= 0
     1259     then do:
     1260       assign
     1261         v-change-sign = 1
     1262       .
     1263     end.
     1264     else do:
     1265       assign
     1266         v-change-sign = -1
     1267       .
     1268     end.
     1269     assign
     1270       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1271     .
     1272     if p-change-value = 0
     1273     then do:
     1274       run diasize_position-resize-button in this-procedure .
     1275       return .
     1276     end.
     1277     move_block:
     1278     do
     1279     on error undo move_block, retry move_block
     1280     :
     1281       if retry
     1282       then do:
     1283         do
     1284         on error undo move_block, leave move_block
     1285         :
     1286           if p-change-value > 0
     1287           then do:
     1288             for each buf_temp-diasize-handle
     1289             on error undo, next
     1290             :
     1291               assign
     1292                 v-object-handle = buf_temp-diasize-handle.handle-value
     1293               .
     1294               if v-object-handle <> v-diasize-resize-button
     1295               then do:
     1296                 assign
     1297                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1298                 .
     1299               end.
     1300             end.
     1301             assign
     1302               v-diasize-browse-handle :height = v-browse-height
     1303             .
     1304             for each buf_temp-browse-handle
     1305               where buf_temp-browse-handle.browse-type = 'height':u
     1306             on error undo, next
     1307             :
     1308               assign
     1309                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1310               .
     1311             end.
     1312             assign
     1313               frame Dialog-Frame :height = v-frame-height
     1314             .
     1315             if frame Dialog-Frame :scrollable = true
     1316             then do:
     1317               assign
     1318                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1319               .
     1320             end.
     1321             run diasize_position-resize-button in this-procedure .
     1322           end.
     1323           else do:
     1324             if frame Dialog-Frame :scrollable = true
     1325             then do:
     1326               assign
     1327                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1328               .
     1329             end.
     1330             assign
     1331               frame Dialog-Frame :height = v-frame-height
     1332             .
     1333             assign
     1334               v-diasize-browse-handle :height = v-browse-height
     1335             .
     1336             for each buf_temp-browse-handle
     1337               where buf_temp-browse-handle.browse-type = 'height':u
     1338             on error undo, next
     1339             :
     1340               assign
     1341                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1342               .
     1343             end.
     1344             for each buf_temp-diasize-handle
     1345             on error undo, next
     1346             :
     1347               assign
     1348                 v-object-handle = buf_temp-diasize-handle.handle-value
     1349               .
     1350               if v-object-handle <> v-diasize-resize-button
     1351               then do:
     1352                 assign
     1353                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1354                 .
     1355               end.
     1356             end.
     1357             run diasize_position-resize-button in this-procedure .
     1358           end.
     1359           assign
     1360             v-diasize-change-size = false
     1361           .
     1362           leave move_block .
     1363         end.
     1364       end.
     1365       assign
     1366         v-diasize-need-full-display = true
     1367       .
     1368       if v-diasize-change-size = false
     1369       then do:
     1370         assign
     1371           v-diasize-change-size = true
     1372         .
     1373       end.
     1374       else do:
     1375         return .
     1376       end.
     1377       assign
     1378         v-frame-height = frame Dialog-Frame :height
     1379         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1380         v-browse-height = v-diasize-browse-handle :height
     1381       .
     1382       for each buf_temp-browse-handle
     1383         where buf_temp-browse-handle.browse-type = 'height':u
     1384       :
     1385         assign
     1386           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1387         .
     1388       end.
     1389       for each buf_temp-diasize-handle
     1390       :
     1391         delete buf_temp-diasize-handle .
     1392       end.
     1393       assign
     1394         v-field-group-handle = frame Dialog-Frame :first-child
     1395       .
     1396       do while valid-handle(v-field-group-handle)
     1397       :
     1398         assign
     1399           v-object-handle = v-field-group-handle :first-child
     1400         .
     1401         do while valid-handle(v-object-handle)
     1402         :
     1403           if  v-object-handle <> v-diasize-browse-handle :handle
     1404           and can-query(v-object-handle, "row")
     1405           and can-query(v-object-handle, "height")
     1406           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1407           then do:
     1408             find first buf_temp-browse-handle
     1409               where buf_temp-browse-handle.browse-type   = 'height':u
     1410                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1411               no-error .
     1412             if available buf_temp-browse-handle
     1413             then do:
     1414             end.
     1415             else do:
     1416               create buf_temp-diasize-handle .
     1417               assign
     1418                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1419                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1420               .
     1421             end.
     1422           end.
     1423           assign
     1424             v-object-handle = v-object-handle :next-sibling
     1425           .
     1426         end.
     1427         assign
     1428           v-field-group-handle = v-field-group-handle :next-sibling
     1429         .
     1430       end.
     1431       do with frame Dialog-Frame
     1432       :
     1433         hide v-diasize-resize-button .
     1434         assign
     1435           v-diasize-resize-button :row    = 1
     1436           v-diasize-resize-button :column = 1
     1437         .
     1438       end.
     1439       if p-change-value > 0
     1440       then do:
     1441         if frame Dialog-Frame :scrollable = true
     1442         then do:
     1443           assign
     1444             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1445             no-error .
     1446           if error-status :error
     1447           or error-status :get-message(1) <> ""
     1448           then do:
     1449             undo move_block, retry move_block .
     1450           end.
     1451         end.
     1452         assign
     1453           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1454           no-error .
     1455         if error-status :error
     1456         or error-status :get-message(1) <> ""
     1457         then do:
     1458           undo move_block, retry move_block .
     1459         end.
     1460         assign
     1461           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1462           no-error .
     1463         if error-status :error
     1464         or error-status :get-message(1) <> ""
     1465         then do:
     1466           undo move_block, retry move_block .
     1467         end.
     1468         for each buf_temp-browse-handle
     1469           where buf_temp-browse-handle.browse-type = 'height':u
     1470         on error undo move_block, retry move_block
     1471         :
     1472           assign
     1473             buf_temp-browse-handle.browse-handle :height
     1474               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1475             no-error .
     1476           if error-status :error
     1477           or error-status :get-message(1) <> ""
     1478           then do:
     1479             undo move_block, retry move_block .
     1480           end.
     1481         end.
     1482         for each buf_temp-diasize-handle
     1483         on error undo move_block, retry move_block
     1484         :
     1485           assign
     1486             v-object-handle = buf_temp-diasize-handle.handle-value
     1487           .
     1488           if v-object-handle <> v-diasize-resize-button
     1489           then do:
     1490             assign
     1491               v-object-handle :row = v-object-handle :row + p-change-value
     1492               no-error .
     1493             if error-status :error
     1494             or error-status :get-message(1) <> ""
     1495             then do:
     1496               undo move_block, retry move_block .
     1497             end.
     1498           end.
     1499         end.
     1500       end.
     1501       else do:
     1502         for each buf_temp-diasize-handle
     1503         on error undo move_block, retry move_block
     1504         :
     1505           assign
     1506             v-object-handle = buf_temp-diasize-handle.handle-value
     1507           .
     1508           if v-object-handle <> v-diasize-resize-button
     1509           then do:
     1510             assign
     1511               v-object-handle :row = v-object-handle :row + p-change-value
     1512               no-error .
     1513             if error-status :error
     1514             or error-status :get-message(1) <> ""
     1515             then do:
     1516               undo move_block, retry move_block .
     1517             end.
     1518           end.
     1519         end.
     1520         assign
     1521           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1522           no-error .
     1523         if error-status :error
     1524         or error-status :get-message(1) <> ""
     1525         then do:
     1526           undo move_block, retry move_block .
     1527         end.
     1528         for each buf_temp-browse-handle
     1529           where buf_temp-browse-handle.browse-type = 'height':u
     1530         on error undo move_block, retry move_block
     1531         :
     1532           assign
     1533             buf_temp-browse-handle.browse-handle :height
     1534               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1535             no-error .
     1536           if error-status :error
     1537           or error-status :get-message(1) <> ""
     1538           then do:
     1539             undo move_block, retry move_block .
     1540           end.
     1541         end.
     1542         assign
     1543           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1544           no-error .
     1545         if error-status :error
     1546         or error-status :get-message(1) <> ""
     1547         then do:
     1548           undo move_block, retry move_block .
     1549         end.
     1550         if frame Dialog-Frame :scrollable = true
     1551         then do:
     1552           assign
     1553             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1554             no-error .
     1555           if error-status :error
     1556           or error-status :get-message(1) <> ""
     1557           then do:
     1558             undo move_block, retry move_block .
     1559           end.
     1560         end.
     1561       end.
     1562       if p-move-resize = true
     1563       then do:
     1564         run diasize_position-resize-button in this-procedure .
     1565       end.
     1566       if v-diasize-wndstore = true
     1567       then do:
     1568         if connected("ub") = true
     1569         then do:
     1570           define variable v-cntxt-db-num        as integer   no-undo .
     1571           define variable v-cntxt-userid        as character no-undo .
     1572           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1573                                             , OUTPUT v-cntxt-userid
     1574                                             ) .
     1575           run gbl/wndsizew.p
     1576             (input  v-cntxt-db-num
     1577             ,input  v-cntxt-userid
     1578             ,input  v-diasize-proc-name
     1579             ,input  'height':u
     1580             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1581             ) .
     1582         end.
     1583       end.
     1584     end.
     1585     assign
     1586       v-diasize-change-size = false
     1587     .
     1588   end procedure.
     1589   procedure diasize_set-height :
     1590     define input  parameter p-new-height  as decimal   no-undo .
     1591     define input  parameter p-move-resize as logical   no-undo .
     1592     do
     1593     on error undo, return error return-value
     1594     :
     1595       run diasize_change-height in this-procedure
     1596         (input  (p-new-height - frame Dialog-Frame :height)
     1597         ,input  p-move-resize
     1598         ) .
     1599     end.
     1600   end procedure.
     1601   procedure diasize_change-width :
     1602     define input  parameter p-change-value as decimal   no-undo .
     1603     define input  parameter p-move-resize  as logical   no-undo .
     1604     define variable v-field-group-handle   as handle    no-undo .
     1605     define variable v-object-handle        as handle    no-undo .
     1606     define variable v-frame-width          as decimal   no-undo .
     1607     define variable v-frame-virtual-width  as decimal   no-undo .
     1608     define variable v-browse-width         as decimal   no-undo .
     1609     define variable v-window-width         as decimal   no-undo .
     1610     define variable v-window-virtual-width as decimal   no-undo .
     1611     define variable v-change-sign          as integer   no-undo .
     1612     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1613     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1614     if p-change-value > 0
     1615     then do:
     1616       if frame Dialog-Frame :width + p-change-value >
     1617           session :width-chars
     1618       then do:
     1619         assign
     1620           p-change-value = session :width-chars - frame Dialog-Frame :width
     1621         .
     1622         if p-change-value <= 0
     1623         then do:
     1624           run diasize_position-resize-button in this-procedure .
     1625           return .
     1626         end.
     1627       end.
     1628     end.
     1629     if p-change-value < 0
     1630     then do:
     1631       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1632       then do:
     1633         assign
     1634           p-change-value = v-diasize-orig-frame-width
     1635                          - frame Dialog-Frame :width
     1636         .
     1637         if p-change-value >= 0
     1638         then do:
     1639           run diasize_position-resize-button in this-procedure .
     1640           return .
     1641         end.
     1642       end.
     1643     end.
     1644     if p-change-value >= 0
     1645     then do:
     1646       assign
     1647         v-change-sign = 1
     1648       .
     1649     end.
     1650     else do:
     1651       assign
     1652         v-change-sign = -1
     1653       .
     1654     end.
     1655     assign
     1656       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1657     .
     1658     if p-change-value = 0
     1659     then do:
     1660       run diasize_position-resize-button in this-procedure .
     1661       return .
     1662     end.
     1663     move_block:
     1664     do
     1665     on error undo move_block, leave move_block
     1666     :
     1667       if retry
     1668       then do:
     1669         do
     1670         on error undo move_block, leave move_block
     1671         :
     1672           if p-change-value > 0
     1673           then do:
     1674             for each buf_temp-diasize-handle
     1675             on error undo, next
     1676             :
     1677               assign
     1678                 v-object-handle = buf_temp-diasize-handle.handle-value
     1679               .
     1680               if v-object-handle <> v-diasize-resize-button
     1681               then do:
     1682                 assign
     1683                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1684                 .
     1685               end.
     1686             end.
     1687             assign
     1688               v-diasize-browse-handle :width = v-browse-width
     1689             .
     1690             for each buf_temp-browse-handle
     1691               where buf_temp-browse-handle.browse-type = 'width':u
     1692             on error undo, next
     1693             :
     1694               assign
     1695                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1696               .
     1697             end.
     1698             assign
     1699               frame Dialog-Frame :width = v-frame-width
     1700             .
     1701             if frame Dialog-Frame :scrollable = true
     1702             then do:
     1703               assign
     1704                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1705               .
     1706             end.
     1707             run diasize_position-resize-button in this-procedure .
     1708           end.
     1709           else do:
     1710             if frame Dialog-Frame :scrollable = true
     1711             then do:
     1712               assign
     1713                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1714               .
     1715             end.
     1716             assign
     1717               frame Dialog-Frame :width = v-frame-width
     1718             .
     1719             for each buf_temp-browse-handle
     1720               where buf_temp-browse-handle.browse-type = 'width':u
     1721             on error undo, next
     1722             :
     1723               assign
     1724                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1725               .
     1726             end.
     1727             assign
     1728               v-diasize-browse-handle :width = v-browse-width
     1729             .
     1730             for each buf_temp-diasize-handle
     1731             on error undo, next
     1732             :
     1733               assign
     1734                 v-object-handle = buf_temp-diasize-handle.handle-value
     1735               .
     1736               if v-object-handle <> v-diasize-resize-button
     1737               then do:
     1738                 assign
     1739                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1740                 .
     1741               end.
     1742             end.
     1743             run diasize_position-resize-button in this-procedure .
     1744           end.
     1745           assign
     1746             v-diasize-change-size = false
     1747           .
     1748           leave move_block .
     1749         end.
     1750       end.
     1751       assign
     1752         v-diasize-need-full-display = true
     1753       .
     1754       if v-diasize-change-size = false
     1755       then do:
     1756         assign
     1757           v-diasize-change-size = true
     1758         .
     1759       end.
     1760       else do:
     1761         return .
     1762       end.
     1763       assign
     1764         v-frame-width = frame Dialog-Frame :width
     1765         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1766         v-browse-width = v-diasize-browse-handle :width
     1767       .
     1768       for each buf_temp-browse-handle
     1769         where buf_temp-browse-handle.browse-type = 'width':u
     1770       :
     1771         assign
     1772           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1773         .
     1774       end.
     1775       for each buf_temp-diasize-handle
     1776       :
     1777         delete buf_temp-diasize-handle .
     1778       end.
     1779       assign
     1780         v-field-group-handle = frame Dialog-Frame :first-child
     1781       .
     1782       do while valid-handle(v-field-group-handle)
     1783       :
     1784         assign
     1785           v-object-handle = v-field-group-handle :first-child
     1786         .
     1787         do while valid-handle(v-object-handle)
     1788         :
     1789           if  v-object-handle <> v-diasize-browse-handle :handle
     1790           and v-object-handle <> v-diasize-resize-button
     1791           and can-query(v-object-handle, "row")
     1792           and can-query(v-object-handle, "height")
     1793           and ( v-object-handle :col + v-object-handle :width
     1794                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1795               )
     1796           then do:
     1797             find first buf_temp-browse-handle
     1798               where buf_temp-browse-handle.browse-type   = 'width':u
     1799                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1800               no-error .
     1801             if available buf_temp-browse-handle
     1802             then do:
     1803             end.
     1804             else do:
     1805               create buf_temp-diasize-handle .
     1806               assign
     1807                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1808                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1809               .
     1810             end.
     1811           end.
     1812           assign
     1813             v-object-handle = v-object-handle :next-sibling
     1814           .
     1815         end.
     1816         assign
     1817           v-field-group-handle = v-field-group-handle :next-sibling
     1818         .
     1819       end.
     1820       do with frame Dialog-Frame
     1821       :
     1822         hide v-diasize-resize-button .
     1823         v-diasize-resize-button :row = 1.
     1824         v-diasize-resize-button :column = 1.
     1825       end.
     1826       if p-change-value > 0
     1827       then do:
     1828         if frame Dialog-Frame :scrollable = true
     1829         then do:
     1830           assign
     1831             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1832             no-error .
     1833           if error-status :error
     1834           or error-status :get-message(1) <> ""
     1835           then do:
     1836             undo move_block, retry move_block.
     1837           end.
     1838         end.
     1839         assign
     1840           frame Dialog-Frame :width = v-frame-width + p-change-value
     1841           no-error .
     1842         if error-status :error
     1843         or error-status :get-message(1) <> ""
     1844         then do:
     1845           undo move_block, retry move_block.
     1846         end.
     1847         assign
     1848           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1849         no-error .
     1850         if error-status :error
     1851         or error-status :get-message(1) <> ""
     1852         then do:
     1853           undo move_block, retry move_block.
     1854         end.
     1855         for each buf_temp-browse-handle
     1856           where buf_temp-browse-handle.browse-type = 'width':u
     1857         on error undo move_block, retry move_block
     1858         :
     1859           assign
     1860             buf_temp-browse-handle.browse-handle :width
     1861               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1862             no-error .
     1863           if error-status :error
     1864           or error-status :get-message(1) <> ""
     1865           then do:
     1866             undo move_block, retry move_block .
     1867           end.
     1868         end.
     1869         for each buf_temp-diasize-handle
     1870         on error undo move_block, retry move_block
     1871         :
     1872           assign
     1873             v-object-handle = buf_temp-diasize-handle.handle-value
     1874           .
     1875           if v-object-handle <> v-diasize-resize-button
     1876           then do:
     1877             assign
     1878               v-object-handle :col = v-object-handle :col + p-change-value
     1879               no-error .
     1880             if error-status :error
     1881             or error-status :get-message(1) <> ""
     1882             then do:
     1883               undo move_block, retry move_block .
     1884             end.
     1885           end.
     1886         end.
     1887       end.
     1888       else do:
     1889         for each buf_temp-diasize-handle
     1890         on error undo move_block, retry move_block
     1891         :
     1892           assign
     1893             v-object-handle = buf_temp-diasize-handle.handle-value
     1894           .
     1895           if v-object-handle <> v-diasize-resize-button
     1896           then do:
     1897             assign
     1898               v-object-handle :col = v-object-handle :col + p-change-value
     1899               no-error .
     1900             if error-status :error
     1901             or error-status :get-message(1) <> ""
     1902             then do:
     1903               undo move_block, retry move_block .
     1904             end.
     1905           end.
     1906         end.
     1907         for each buf_temp-browse-handle
     1908           where buf_temp-browse-handle.browse-type = 'width':u
     1909         on error undo move_block, retry move_block
     1910         :
     1911           assign
     1912             buf_temp-browse-handle.browse-handle :width
     1913               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1914             no-error .
     1915           if error-status :error
     1916           or error-status :get-message(1) <> ""
     1917           then do:
     1918             undo move_block, retry move_block .
     1919           end.
     1920         end.
     1921         assign
     1922           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1923           no-error .
     1924         if error-status :error
     1925         or error-status :get-message(1) <> ""
     1926         then do:
     1927           undo move_block, retry move_block.
     1928         end.
     1929         assign
     1930           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1931         no-error .
     1932         if error-status :error
     1933         or error-status :get-message(1) <> ""
     1934         then do:
     1935           undo move_block, retry move_block.
     1936         end.
     1937         if frame Dialog-Frame :scrollable = true
     1938         then do:
     1939           assign
     1940             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1941           no-error .
     1942           if error-status :error
     1943           or error-status :get-message(1) <> ""
     1944           then do:
     1945             undo move_block, retry move_block.
     1946           end.
     1947         end.
     1948       end.
     1949       if p-move-resize
     1950       then do:
     1951         run diasize_position-resize-button in this-procedure .
     1952       end.
     1953       if v-diasize-wndstore = true
     1954       then do:
     1955         if connected("ub") = true
     1956         then do:
     1957           define variable v-cntxt-db-num        as integer   no-undo .
     1958           define variable v-cntxt-userid        as character no-undo .
     1959           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1960                                             , OUTPUT v-cntxt-userid
     1961                                             ) .
     1962           run gbl/wndsizew.p
     1963             (input  v-cntxt-db-num
     1964             ,input  v-cntxt-userid
     1965             ,input  v-diasize-proc-name
     1966             ,input  'width':u
     1967             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1968             ) .
     1969         end.
     1970       end.
     1971     end.
     1972     assign
     1973       v-diasize-change-size = false
     1974     .
     1975   end procedure.
     1976   procedure diasize_set-width :
     1977     define input  parameter p-new-width  as decimal   no-undo .
     1978     define input  parameter p-move-resize as logical   no-undo .
     1979     do
     1980     on error undo, return error return-value
     1981     :
     1982       run diasize_change-width in this-procedure
     1983         (input  (p-new-width - frame Dialog-Frame :width)
     1984         ,input  p-move-resize
     1985         ) .
     1986     end.
     1987   end procedure.
     1988   procedure diasize_position-resize-button :
     1989     do with frame Dialog-Frame
     1990     :
     1991       hide v-diasize-resize-button .
     1992       assign
     1993         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1994                     - 1
     1995                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1996         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1997                     - 1
     1998                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1999       .
     2000       view v-diasize-resize-button .
     2001     end.
     2002   end procedure.
     2003   on alt-right anywhere
     2004   do:
     2005     run diasize_change-width in this-procedure
     2006       (input 1
     2007       ,input true
     2008       ) .
     2009     return no-apply .
     2010   end.
     2011   on alt-left anywhere
     2012   do:
     2013     run diasize_change-width in this-procedure
     2014       (input -1
     2015       ,input true
     2016       ) .
     2017     return no-apply .
     2018   end.
     2019   on alt-down anywhere
     2020   do:
     2021     run diasize_change-height in this-procedure
     2022       (input 1
     2023       ,input true
     2024       ) .
     2025     return no-apply .
     2026   end.
     2027   on alt-up anywhere
     2028   do:
     2029     run diasize_change-height in this-procedure
     2030       (input -1
     2031       ,input true
     2032       ) .
     2033     return no-apply .
     2034   end.
     2035   on alt-enter of frame Dialog-Frame
     2036   do:
     2037     run diasize_maximize in this-procedure
     2038       (input  ?
     2039       ).
     2040     return no-apply .
     2041   end.
     2042   procedure diasize_end-move :
     2043     do
     2044     on error undo, return error return-value
     2045     :
     2046       define variable v-row-delta as decimal   no-undo .
     2047       define variable v-col-delta as decimal   no-undo .
     2048       define variable v-new-row as decimal   no-undo .
     2049       define variable v-new-col as decimal   no-undo .
     2050       assign
     2051         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2052         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2053       .
     2054       assign
     2055         v-row-delta = v-new-row - frame Dialog-Frame :height
     2056         v-col-delta = v-new-col - frame Dialog-Frame :width
     2057       .
     2058       run diasize_change-height in this-procedure
     2059         (input v-row-delta
     2060         ,input true
     2061         ) .
     2062       run diasize_change-width in this-procedure
     2063         (input v-col-delta
     2064         ,input true
     2065         ) .
     2066     end.
     2067   end procedure.
     2068   procedure diasize_maximize :
     2069     define input  parameter p-action as logical   no-undo .
     2070     do
     2071     on error undo, return error return-value
     2072     :
     2073       if p-action = ?
     2074       then do:
     2075         if v-diasize-need-maximize = true
     2076         then do:
     2077           assign
     2078             p-action = true
     2079           .
     2080         end.
     2081         else do:
     2082           assign
     2083             p-action = false
     2084           .
     2085         end.
     2086       end.
     2087       if p-action = true
     2088       then do:
     2089         run diasize_change-height in this-procedure
     2090           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2091               - frame Dialog-Frame :height-chars
     2092           ,input true
     2093           ) .
     2094         run diasize_change-width in this-procedure
     2095           (input session :width-chars
     2096               - frame Dialog-Frame :width-chars
     2097           ,input true
     2098           ) .
     2099         assign
     2100           v-diasize-need-maximize = false
     2101         .
     2102       end.
     2103       else do:
     2104         run diasize_change-width in this-procedure
     2105           (input v-diasize-orig-frame-width
     2106               - frame Dialog-Frame :width-chars
     2107           ,input true
     2108           ) .
     2109         run diasize_change-height in this-procedure
     2110           (input v-diasize-orig-frame-height
     2111               - frame Dialog-Frame :height-chars
     2112           ,input true
     2113           ) .
     2114         assign
     2115           v-diasize-need-maximize = true
     2116         .
     2117       end.
     2118     end.
     2119   end procedure.
     2120   procedure diasize_restore-orig-size :
     2121     do
     2122     on error undo, return error return-value
     2123     :
     2124       assign
     2125         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2126         v-diasize-current-frame-height = frame Dialog-Frame :height
     2127       .
     2128       run diasize_set-height in this-procedure
     2129         (input  v-diasize-orig-frame-height
     2130         ,input  true
     2131         ) .
     2132       run diasize_set-width in this-procedure
     2133         (input  v-diasize-orig-frame-width
     2134         ,input  true
     2135         ) .
     2136     end.
     2137   end procedure.
     2138   procedure diasize_restore-current-size :
     2139     do
     2140     on error undo, return error return-value
     2141     :
     2142       run diasize_set-height in this-procedure
     2143         (input  v-diasize-current-frame-height
     2144         ,input  true
     2145         ) .
     2146       run diasize_set-width in this-procedure
     2147         (input  v-diasize-current-frame-width
     2148         ,input  true
     2149         ) .
     2150     end.
     2151   end procedure.
     2152   procedure diasize_set-browse-handle :
     2153     define input  parameter p-browse-handle as handle   no-undo .
     2154     define buffer buf_temp-browse-handle for temp-browse-handle .
     2155     do
     2156     on error undo, return error return-value
     2157     :
     2158       assign
     2159         v-diasize-browse-handle = p-browse-handle
     2160       .
     2161       for each buf_temp-browse-handle
     2162       on error undo, return error return-value
     2163       :
     2164         delete buf_temp-browse-handle .
     2165       end.
     2166     end.
     2167   end procedure.
     2168   procedure diasize_add_browse :
     2169     define input  parameter p-browse-type   as character no-undo .
     2170     define input  parameter p-browse-handle as handle    no-undo .
     2171     define buffer buf_temp-browse-handle for temp-browse-handle .
     2172     do
     2173     on error undo, return error return-value
     2174     :
     2175       assign
     2176         v-diasize-browse-number = v-diasize-browse-number + 1
     2177       .
     2178       create buf_temp-browse-handle .
     2179       assign
     2180         buf_temp-browse-handle.browse-type   = p-browse-type
     2181         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2182         buf_temp-browse-handle.browse-handle = p-browse-handle
     2183       .
     2184     end.
     2185   end procedure.
     2186   procedure diasize_init :
     2187     define variable v-default-value    as logical   no-undo .
     2188     define variable v-restore-saved    as logical   no-undo .
     2189     define variable v-resize-value-str as character no-undo .
     2190     do
     2191     on error undo, return error return-value
     2192     :
     2193       do with frame Dialog-Frame
     2194       :
     2195         assign
     2196           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2197           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2198           v-diasize-browse-handle     = browse BR-obj :handle
     2199         .
     2200         create button v-diasize-resize-button
     2201         assign
     2202           parent        = frame Dialog-Frame :first-child
     2203           label         = "s"
     2204           height-pixels = 16
     2205           width-pixels  = 16
     2206           visible       = true
     2207           sensitive     = true
     2208           movable       = true
     2209           triggers:
     2210             on end-move persistent run diasize_end-move in this-procedure .
     2211           end triggers.
     2212         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2213         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2214         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2215         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2216         assign
     2217           v-diasize-wndmax = false
     2218         .
     2219         if connected("ub") = true
     2220         then do:
     2221           define variable v-cntxt-db-num        as integer   no-undo .
     2222           define variable v-cntxt-userid        as character no-undo .
     2223           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2224                                             , OUTPUT v-cntxt-userid
     2225                                             ) .
     2226           run gbl/wndpar_r.p
     2227             (input  v-cntxt-db-num
     2228             ,input  v-cntxt-userid
     2229             ,input  'wndmax':U
     2230             ,output v-diasize-wndmax
     2231             ,output v-default-value
     2232             ) .
     2233         end.
     2234         assign
     2235           v-diasize-wndstore = false
     2236         .
     2237         if connected("ub") = true
     2238         then do:
     2239           run gbl/wndpar_r.p
     2240             (input  v-cntxt-db-num
     2241             ,input  v-cntxt-userid
     2242             ,input  'wndstore':U
     2243             ,output v-diasize-wndstore
     2244             ,output v-default-value
     2245             ) .
     2246         end.
     2247         assign
     2248           v-diasize-proc-name = entry(1, program-name(2), '.')
     2249         .
     2250         if v-diasize-wndstore = true
     2251         then do:
     2252           assign
     2253             v-restore-saved = false
     2254           .
     2255           if connected("ub") = true
     2256           then do:
     2257             run gbl/wndsizer.p
     2258               (input  v-cntxt-db-num
     2259               ,input  v-cntxt-userid
     2260               ,input  v-diasize-proc-name
     2261               ,input  'height':u
     2262               ,output v-resize-value-str
     2263               ) .
     2264             if v-resize-value-str <> '':U
     2265             then do:
     2266               run diasize_change-height in this-procedure
     2267                 (input  integer(v-resize-value-str)
     2268                 ,input  true
     2269                 ) .
     2270               assign
     2271                 v-restore-saved = true
     2272               .
     2273             end.
     2274           end.
     2275           if connected("ub") = true
     2276           then do:
     2277             run gbl/wndsizer.p
     2278               (input  v-cntxt-db-num
     2279               ,input  v-cntxt-userid
     2280               ,input  v-diasize-proc-name
     2281               ,input  'width':u
     2282               ,output v-resize-value-str
     2283               ) .
     2284             if v-resize-value-str <> '':U
     2285             then do:
     2286               run diasize_change-width in this-procedure
     2287                 (input  integer(v-resize-value-str)
     2288                 ,input  true
     2289                 ) .
     2290               assign
     2291                 v-restore-saved = true
     2292               .
     2293             end.
     2294           end.
     2295           if v-restore-saved <> true
     2296           then do:
     2297             if v-diasize-wndmax = true
     2298             then do:
     2299               run diasize_maximize in this-procedure
     2300                 (input  true
     2301                 ) .
     2302             end.
     2303           end.
     2304         end.
     2305         else do:
     2306           if v-diasize-wndmax = true
     2307           then do:
     2308             run diasize_maximize in this-procedure
     2309               (input  true
     2310               ) .
     2311           end.
     2312         end.
     2313       end.
     2314     end.
     2315   end procedure.
     2316   procedure diasize_need-full-display :
     2317     define output parameter p-need-full-display as logical   no-undo .
     2318     do
     2319     on error undo, return error return-value
     2320     :
     2321       assign
     2322         p-need-full-display = v-diasize-need-full-display
     2323       .
     2324       assign
     2325         v-diasize-need-full-display = false
     2326       .
     2327     end.
     2328   end procedure.
     2329   procedure get-context :
     2330      define output parameter p-db-num as integer          no-undo.
     2331      define output parameter p-user-id as character        no-undo.
     2332      define variable v-login               as character    no-undo.
     2333      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2334      define buffer buf_user-login  for ub.user-login .
     2335      do
     2336      on error undo, return error
     2337      :
     2338            FIND FIRST buf_sys-ctrl no-lock.
     2339            ASSIGN
     2340               v-login = USERID("ub")
     2341               p-db-num = buf_sys-ctrl.db-num
     2342            .
     2343            FIND FIRST buf_user-login
     2344                 WHERE buf_user-login.db-num = p-db-num
     2345                   AND buf_user-login.user-login = v-login
     2346                 no-lock
     2347                 no-error
     2348                 .
     2349            IF AVAILABLE buf_user-login
     2350            THEN DO:
     2351               assign
     2352                  p-user-id = buf_user-login.user-id
     2353               .
     2354            END.
     2355      end.
     2356   end procedure.
     2357       run diasize_init in this-procedure .
     2358   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2359   DEF VAR cur-clmn-numbr-obj as INT EXTENT 26 no-undo.
     2360   DEF VAR varmvibr-obj       as INT no-undo.
     2361   DEF VAR varmvjbr-obj       as INT no-undo.
     2362   DEF VAR varmvkbr-obj       as INT no-undo.
     2363   DEF VAR varmvlbr-obj       as INT no-undo.
     2364   DEF VAR move-elementbr-obj as INT no-undo.
     2365   def var jjbr-obj           as int no-undo.
     2366   do varmvibr-obj = 1 to EXTENT(cur-clmn-numbr-obj):
     2367     ASSIGN cur-clmn-numbr-obj[varmvibr-obj] = varmvibr-obj.
     2368   END.
     2369   RUN start-mv-clmnbr-obj.
     2370   PROCEDURE start-mv-clmnbr-obj:
     2371   def var old-session as logical no-undo.
     2372      old-session = SESSION:IMMEDIATE-DISPLAY.
     2373      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2374      SESSION:IMMEDIATE-DISPLAY = old-session.
     2375   END.
     2376   ON ctrl-cursor-right OF BROWSE br-obj do:
     2377     RUN re-move-clmnbr-obj ( 4, 26).
     2378   END.
     2379   ON ctrl-cursor-left OF BROWSE br-obj do:
     2380     RUN re-move-clmnbr-obj (26, 4).
     2381   END.
     2382   PROCEDURE re-move-clmnbr-obj:
     2383     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2384     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2385     DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2386       if cur-clmn-numbr-obj[varmvibr-obj] = source-column THEN cur-clmn-numbr-obj[varmvibr-obj] = -1.
     2387     END.
     2388     if br-obj:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2389     if source-column > target-column THEN
     2390     DO varmvjbr-obj = source-column - 1 to target-column BY -1:
     2391       DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2392           if cur-clmn-numbr-obj[varmvibr-obj] = varmvjbr-obj THEN DO:
     2393             cur-clmn-numbr-obj[varmvibr-obj] = cur-clmn-numbr-obj[varmvibr-obj] + 1.
     2394           END.
     2395       END.
     2396     END.
     2397     ELSE
     2398     DO varmvjbr-obj = source-column + 1 to target-column:
     2399       DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2400         if cur-clmn-numbr-obj[varmvibr-obj] = varmvjbr-obj THEN DO:
     2401           cur-clmn-numbr-obj[varmvibr-obj] = cur-clmn-numbr-obj[varmvibr-obj] - 1.
     2402         END.
     2403       END.
     2404     END.
     2405     DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2406       if cur-clmn-numbr-obj[varmvibr-obj] = -1 THEN cur-clmn-numbr-obj[varmvibr-obj] = target-column.
     2407     END.
     2408   END PROCEDURE.
     2409   PROCEDURE ch-clmnbr-obj:
     2410     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2411     if cur-clmn-loc <= 4 then do:
     2412       return .
     2413     end.
     2414     DO varmvibr-obj = 1 TO EXTENT(cur-clmn-numbr-obj):
     2415       if cur-clmn-numbr-obj[varmvibr-obj] = cur-clmn-loc THEN move-elementbr-obj = varmvibr-obj.
     2416     END.
     2417     RUN re-move-clmnbr-obj (cur-clmn-loc, 4).
     2418   END PROCEDURE.
     2419   PROCEDURE mv-brw-defaultbr-obj:
     2420   def var old-session as logical no-undo.
     2421     old-session = SESSION:IMMEDIATE-DISPLAY.
     2422     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2423     do varmvlbr-obj = 4 to EXTENT(cur-clmn-numbr-obj):
     2424       RUN re-move-clmnbr-obj (cur-clmn-numbr-obj[varmvlbr-obj], varmvlbr-obj).
     2425     END.
     2426     RUN start-mv-clmnbr-obj.
     2427     SESSION:IMMEDIATE-DISPLAY = old-session.
     2428   END PROCEDURE.
     2429   .
