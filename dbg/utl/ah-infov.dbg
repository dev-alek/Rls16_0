     2722   PROCEDURE ah-infov_reposition-to-current :
     2723     define variable v-curr-rowid as rowid     no-undo .
     2724     do
     2725     on error undo, return error return-value
     2726     :
     2727       if available temp-obj-arh
     2728       then do:
     2729         assign
     2730           v-curr-rowid = rowid(temp-obj-arh)
     2731         .
     2732         reposition BR-obj to rowid v-curr-rowid no-error .
     2733         if error-status :error
     2734         then do:
     2735           reposition BR-obj to row 1 .
     2736         end.
     2737       end.
     2738       else do:
     2739         reposition BR-obj to row 1 .
     2740       end.
     2741     end.
     2742   END PROCEDURE.
     2743   PROCEDURE calc-all-temp-obj-arh :
     2744     define buffer buf_temp-obj-arh for temp-obj-arh .
     2745     do
