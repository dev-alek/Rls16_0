      873   ON RETURN OF fi-search IN FRAME Dialog-Frame
      874   DO:
      875     define variable v-curr-rowid as rowid     no-undo .
      876     if available temp-obj-arh
      877     then do:
      878       assign
      879         v-curr-rowid = rowid(temp-obj-arh)
      880       .
      881       if fi-search <> input frame Dialog-Frame fi-search
      882       then do:
      883         assign
      884           fi-search
      885           .
      886         run ah-infov_get-first in this-procedure .
      887         if available temp-obj-arh
      888         and temp-obj-arh.obj-code = fi-search
      889         then do:
      890           assign
      891             v-curr-rowid = rowid(temp-obj-arh)
      892           .
      893           reposition BR-obj to rowid v-curr-rowid no-error .
      894           if error-status :error
      895           then do:
      896             reposition BR-obj to row 1 .
      897           end.
      898           return no-apply .
      899         end.
      900       end.
      901       define variable v-get-first-count as integer   no-undo .
      902       assign
      903         v-get-first-count = 0
      904       .
      905       do while true
      906       :
      907         run ah-infov_get-next in this-procedure .
      908         if available temp-obj-arh
      909         then do:
      910           if temp-obj-arh.obj-code = fi-search
      911           then do:
      912             assign
      913               v-curr-rowid = rowid(temp-obj-arh)
      914             .
      915             reposition BR-obj to rowid v-curr-rowid no-error .
      916             if error-status :error
      917             then do:
      918               reposition BR-obj to row 1 .
      919             end.
      920             return no-apply .
      921           end.
      922         end.
      923         else do:
      924           if v-get-first-count = 0
      925           then do:
      926             run ah-infov_get-first in this-procedure .
      927             assign
      928               v-get-first-count = v-get-first-count + 1
      929             .
      930           end.
      931           else do:
      932             leave .
      933           end.
      934         end.
      935       end.
      936     end.
      937   END.
