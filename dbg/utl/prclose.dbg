        1   block-level on error undo, throw.
        2   define input  parameter parParentProc as handle  no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: prclose.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/prclose.p $":U .
        8   define variable vss-description as character no-undo init " Закрытие всех новых переоценок по всем неудаленным объектам.   ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#lib-log as handle no-undo .
       68   define variable p-log-handle as handle  no-undo .
       69   if (valid-handle(g#lib-log) <> true) then do:   run gbl/lib-log.p persistent no-error .   if error-status :error or (valid-handle(g#lib-log) <> true) then do:     message       "Error starting gbl/lib-log.p" skip       g#lib-log skip       g#lib-log :type skip       g#lib-log :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-log_get-log-handle in g#lib-log
       70     (output  p-log-handle
       71     )  .
       72   define buffer buf_db        for ub.db .
       73   define buffer buf_clients   for ub.clients .
       74   define buffer buf_sys-ctrl  for ub.sys-ctrl .
       75   define buffer buf-price-doc for ub.price-doc.
       76   define buffer buf-shift-obj for ub.shift-obj.
       77   MESSAGE
       78     "Вы уверены, что хотите начать работу утилиты ?"
       79   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO
       80           TITLE " Закрытие всех новых переоценок" UPDATE answer AS LOG.
       81   IF answer <> YES THEN RETURN.
       82   find first buf_sys-ctrl no-lock no-error .
       83     for each buf_db no-lock where buf_db.db-num = buf_sys-ctrl.db-num  ,
       84      each buf_clients no-lock  where buf_clients.db-num = buf_db.db-num
       85                                  and buf_clients.stts = 0 ,
       86      each buf-price-doc no-lock where  buf-price-doc.obj-code = buf_clients.obj-code
       87                                    and buf-price-doc.obj-type = buf_clients.obj-type
       88                                    and buf-price-doc.status_ =  'новый':U
       89                                       on error undo, return error  :
       90           if can-find (first buf-shift-obj   where     buf-shift-obj.obj-code = buf_clients.obj-code
       91                                                   and buf-shift-obj.obj-type = buf_clients.obj-type no-lock )
       92           Then message "На объекте " buf_clients.obj-type buf_clients.obj-code  " есть смены . Автоматически закрыть до состояния АКТ нельзя, закройте документ переоценки № "
       93                        buf-price-doc.doc-num  " в ручную!" .
       94           Else
       95             run str/pr-stat.p (  input parParentProc
       96                                , input p-log-handle
       97                                , input "close-act"
       98                                , input buf-price-doc.doc-num
       99                                , input ?
      100                                , input true
      101                                , input true ) no-error .
      102     end.
      103    Message "Процесс закрытия переоценок по базе данных № " buf_sys-ctrl.db-num " завершен !" view-as alert-box information .
