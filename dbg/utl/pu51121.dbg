      687   ON CHOOSE OF r-cst IN FRAME DLGOKCAN
      688   DO:
      689   define variable ref-rec as recid no-undo .
      690       run ref/units.w ( input parparentproc, input yes, output ref-rec ).
      691       if ref-rec = ? then do:
      692         apply "entry" to r-cst in frame DLGOKCAN.
      693         return no-apply.
      694       end.
      695       FIND ub.units WHERE recid (ub.units) = ref-rec NO-LOCK.
      696       DISPLAY ub.units.unit-name @ unit-cst with frame DLGOKCAN.
      697   END.
      698   ON RIGHT-MOUSE-CLICK OF Sert IN FRAME DLGOKCAN
      699   DO:
      700       assign
      701       n-sert:fgcolor = 15
      702       sert = ""
      703       l-sert:visible = true.
      704       display sert with frame DLGOKCAN.
      705       disable sert with frame DLGOKCAN.
      706   END.
      707   ON RIGHT-MOUSE-CLICK OF Sort IN FRAME DLGOKCAN
      708   DO:
      709       assign
      710       n-sort:fgcolor = 15
      711       sort = ""
      712       l-sort:visible = true.
      713       display sort with frame DLGOKCAN.
      714       disable sort with frame DLGOKCAN.
      715   END.
      716   ON RIGHT-MOUSE-CLICK OF Struct IN FRAME DLGOKCAN
      717   DO:
      718       assign
      719       n-struct:fgcolor = 15
      720       struct = ""
      721       l-struct:visible = true.
      722       display struct with frame DLGOKCAN.
      723       disable struct with frame DLGOKCAN.
      724   END.
      725   ON LEAVE OF TNVED IN FRAME DLGOKCAN
      726   DO:
      727       FIND FIRST TT-tnved WHERE TT-tnved.tnved = input frame DLGOKCAN tnved no-error.
      728     if not available TT-tnved then do:
      729       message "Код ТНВЭД не найден в справочнике." view-as alert-box error.
      730       display ? @ tnved with frame DLGOKCAN.
      731       run ch-tnved.
      732       return no-apply.
      733     end.
      734     else
      735     if length(trim(input frame DLGOKCAN tnved)) <> 10 then do:
      736        message "Код ТНВЭД привязки к товару должен быть 10-ти символьный." view-as alert-box error.
      737        display ? @ tnved with frame DLGOKCAN.
      738        run ch-tnved.
      739        return no-apply.
      740      end.
      741     else
      742     display TT-tnved.f-name @ tnved-name with frame DLGOKCAN.
      743   END.
      744   ON RIGHT-MOUSE-CLICK OF TNVED IN FRAME DLGOKCAN
      745   DO:
      746       assign
      747       n-tnved:fgcolor = 15
      748       tnved = ""
      749       l-tnved:visible = true.
      750       display tnved with frame DLGOKCAN.
      751       disable tnved with frame DLGOKCAN.
      752   END.
      753   ON LEAVE OF unit-cst IN FRAME DLGOKCAN
      754   DO:
      755     APPLY "RETURN" to unit-cst.
      756   END.
      757   ON RETURN OF unit-cst IN FRAME DLGOKCAN
      758   DO:
      759   define variable ref-rec as recid no-undo .
      760     if not can-find( ub.units where
      761                              ub.units.unit-name = input frame DLGOKCAN unit-cst ) then do:
      762         run ref/units.w ( input parparentproc, input yes, output ref-rec ).
      763       if ref-rec = ? then  do:
      764               apply "entry" to unit-cst in frame DLGOKCAN.
      765               return no-apply.
      766       end.
      767       FIND ub.units WHERE recid (ub.units) = ref-rec NO-LOCK.
      768       DISPLAY ub.units.unit-name @ unit-cst with frame DLGOKCAN.
      769   end.
      770   END.
      771   ON RIGHT-MOUSE-CLICK OF unit-cst IN FRAME DLGOKCAN
      772   DO:
      773       assign
      774       n-unit-cst:fgcolor = 15
      775       unit-cst = ""
      776       l-unit-cst:visible = true.
      777       display unit-cst with frame DLGOKCAN.
      778       disable unit-cst with frame DLGOKCAN.
      779       disable r-cst with frame DLGOKCAN.
      780   END.
      781   ON RIGHT-MOUSE-CLICK OF UserRule IN FRAME DLGOKCAN
      782   DO:
      783       assign
      784       n-userrule:fgcolor = 15
      785       userrule = ""
      786       l-userrule:visible = true.
      787       display userrule with frame DLGOKCAN.
      788       disable userrule with frame DLGOKCAN.
      789   END.
      790   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      791   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      792   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   on help of frame DLGOKCAN
      794   do:
      795     run gbl/app_help.p
      796       (input this-procedure :file-name
      797       ,input ''
      798       ,input ?
      799       ) no-error.
      800     if error-status :error then do:
      801       message
      802         "Ошибка при вызове помощи"
      803         error-status :get-message(1)
      804         view-as alert-box .
      805     end.
      806   end.
      807   run minbtn-set in this-procedure .
      808   on choose of b-help in frame DLGOKCAN
      809   do:
      810     apply "help":u to frame DLGOKCAN .
      811   end.
      812   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      813   procedure minbtn-set :
      814       do
      815           on error undo, return error return-value
      816           :
      817           define variable ii              as integer       no-undo .
      818           define variable fh              as widget-handle no-undo .
      819           define variable hh              as widget-handle no-undo .
      820           define variable v-h             as handle        extent 4 no-undo .
      821           define variable v-name-button   as character     no-undo .
      822           define variable v-help-old-x    as decimal       no-undo .
      823           define variable v-help-old-y    as decimal       no-undo .
      824           define variable v-help-old-size as decimal       no-undo .
      825           define variable v-frame-width   as decimal       no-undo .
      826           define variable jj              as integer       no-undo .
      827           do
      828               on error undo, return error
      829               :
      830               assign
      831                   v-frame-width = frame DLGOKCAN:width - 0.3
      832                   fh            = frame DLGOKCAN:first-child
      833                   hh            = fh:first-child
      834                   ii            = 1
      835                   .
      836               do while valid-handle(hh):
      837                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      838                   do:
      839                       case lc(hh:name) :
      840                           when "b-help" then
      841                               do:
      842                                   hh:load-image-up("cmp/b-help.bmp":u) .
      843                                   hh:load-image-down("cmp/b-help.bmp":u) .
      844                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      845                                   hh:TOOLTIP = "Помощь" .
      846                                   v-help-old-x = hh:column .
      847                                   v-help-old-y = hh:row    .
      848                                   v-help-old-size = hh:width .
      849                                   hh:width-chars = 2.5 .
      850                               end.
      851                           when "b-print" then
      852                               do:
      853                                   hh:load-image("cmp/b-print.bmp":u) .
      854                                   hh:TOOLTIP = "Печать" .
      855                                   v-h[ii] = hh:handle .
      856                                   ii = ii + 1 .
      857                                   hh:width-chars = 3 .
      858                               end.
      859                           when "b-history" or
      860                           when "b-hist" then
      861                               do:
      862                                   hh:load-image("cmp/b-hist.bmp":u) .
      863                                   hh:TOOLTIP = "История" .
      864                                   v-h[ii] = hh:handle .
      865                                   ii = ii + 1 .
      866                                   hh:width-chars = 3 .
      867                               end.
      868                           when "b-sch" then
      869                               do:
      870                                   hh:load-image("cmp/b-sch.bmp":u) .
      871                                   hh:TOOLTIP = "Установка Фильтра" .
      872                                   v-h[ii] = hh:handle .
      873                                   ii = ii + 1 .
      874                                   hh:width-chars = 3 .
      875                               end.
      876                           when "b-hist-user" then
      877                               do:
      878                                   hh:load-image("cmp/b-hist.bmp":u) .
      879                                   hh:TOOLTIP = "История пользователя" .
      880                                   ii = ii + 1 .
      881                               end.
      882                       end case.
      883                   end.
      884                   hh = hh:next-sibling.
      885               end.
      886               b-help:column = v-frame-width - b-help:width-chars.
      887               jj = 0.
      888               repeat ii = 4 to 1 by -1 :
      889                   if valid-handle (v-h[ii] ) then
      890                   do:
      891                       jj  = jj + 1 .
      892                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      893                       v-h[ii]:row    = v-help-old-y .
      894                   end.
      895               end.
      896           end.
      897       end.
      898   end procedure.
      899   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
      900   MAIN-BLOCK:
      901   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      902      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      903   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      904     run mainmenu_getcntxt in parparentproc
      905       (output v-cntxt-db-num
      906       ,output v-cntxt-userid
      907       ,output v-cntxt-level
      908       ,output v-cntxt-host-code-obj
      909       ,output v-cntxt-obj-type
      910       ,output v-cntxt-obj-code
      911       ,output v-cntxt-db-num-obj
      912       ,output v-cntxt-is-admin
      913       ) .
      914       RUN enable_UI.
      915       WAIT-FOR GO OF FRAME DLGOKCAN.
      916   END.
      917   RUN disable_UI.
      918   PROCEDURE ch-tnved :
      919     run ref/t-tnved.w (yes, output rid-tnved).
      920     find first tt-tnved where RECID(tt-tnved) = rid-tnved no-lock no-error.
      921     if available tt-tnved then disp tt-tnved.tnved @ tnved
      922                                     tt-tnved.f-name @ tnved-name with frame DLGOKCAN.
      923   END PROCEDURE.
      924   PROCEDURE disable_UI :
      925     HIDE FRAME DLGOKCAN.
      926   END PROCEDURE.
      927   PROCEDURE enable_UI :
      928     DISPLAY       n-attrib n-cst-base-rate n-deadline
      929                   n-deadline-2 n-destin n-nationality
      930                   n-sert n-sort n-struct
      931                   n-tnved n-unit-cst n-userrule n-normal-wastage n-normal-waste n-cond-keep-code proof
      932       with frame DLGOKCAN.
      933     ENABLE        Btn_OK Btn_Cancel b-help
      934                   n-attrib n-cst-base-rate n-deadline
      935                   n-deadline-2 n-destin n-nationality
      936                   n-sert n-sort n-struct
      937                   n-tnved n-unit-cst n-userrule
      938                   l-attrib l-cst-base-rate l-deadline
      939                   l-destin l-nationality
      940                   l-sert l-sort l-struct
      941                   l-tnved l-unit-cst l-userrule l-normal-wastage l-normal-waste l-cond-keep-code l-proof
      942         WITH FRAME DLGOKCAN.
      943   END PROCEDURE.
      944   PROCEDURE proc-b-cond-keep-code :
      945   define variable v-rid-list as character no-undo.
      946   define variable v-sts as integer no-undo.
      947   define variable v-cond-keep-code like ub.condition-keeping.cond-keep-code no-undo.
      948   DEFINE BUFFER buf_condition-keeping FOR ub.condition-keeping.
      949   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      950   if lookup(self :type
      951            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      952            ) = 0
      953   then do:
      954     message
      955       "$Workfile$"
      956       "Указанному интерфейсному элементу фокус не может быть передан" skip
      957       "Интерфейсный элемент" self :name  skip
      958       "Тип" self :type  skip
      959       "Процедура" this-procedure :file-name skip
      960       view-as alert-box .
      961   end.
      962   else do:
      963     apply "entry":u to self  .
      964     if focus :handle <> self :handle  then do:
      965       return no-apply .
      966     end.
      967   end.
      968   assign
      969   v-cond-keep-code = FRAME DLGOKCAN cond-keep-code
      970   cond-keep-code
      971   v-sts = INTEGER('0':U)
      972       .
      973   IF available X_condition-keeping THEN v-rid-list = string(RECID(X_condition-keeping)) .
      974   run ref/cndkeeps.w (
      975                   INPUT parParentProc
      976                  ,input p-curr-obj-type
      977                  ,input p-curr-obj-code
      978                  ,input "b-sel":U
      979                  ,input 'все':U
      980                  ,input-output v-sts
      981                  ,input-output v-rid-list).
      982       if v-rid-list <> "":U then do:
      983           FIND FIRST buf_condition-keeping WHERE
      984                recid( buf_condition-keeping ) = integer(v-rid-list) NO-LOCK .
      985           FIND FIRST X_condition-keeping WHERE
      986           RECID(X_condition-keeping) = RECID(buf_condition-keeping).
      987           assign
      988           cond-keep-code = buf_condition-keeping.cond-keep-code
      989           cond-keep-name = buf_condition-keeping.cond-keep-name
      990                  .
      991           DISPLAY
      992           cond-keep-code
      993           cond-keep-name
      994           with frame DLGOKCAN .
      995           RETURN.
      996       end.
      997       IF v-cond-keep-code = ? THEN DO:
      998          ASSIGN
      999          cond-keep-code = v-cond-keep-code
     1000          cond-keep-name = "":U
     1001          .
     1002          RELEASE X_condition-keeping.
     1003          DISPLAY
     1004          cond-keep-code
     1005          cond-keep-name
     1006          with frame DLGOKCAN .
     1007       END.
     1008   END PROCEDURE.
     1009   PROCEDURE proc-leave-cond-keep-code :
     1010   DEFINE INPUT PARAMETER p-lastkey AS integer NO-UNDO.
     1011   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   if lookup(self :type
     1013            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1014            ) = 0
     1015   then do:
     1016     message
     1017       "$Workfile$"
     1018       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1019       "Интерфейсный элемент" self :name  skip
     1020       "Тип" self :type  skip
     1021       "Процедура" this-procedure :file-name skip
     1022       view-as alert-box .
     1023   end.
     1024   else do:
     1025     apply "entry":u to self  .
     1026     if focus :handle <> self :handle  then do:
     1027       return no-apply .
     1028     end.
     1029   end.
     1030   define variable v-cond-keep-code like ub.condition-keeping.cond-keep-code no-undo.
     1031   DEFINE BUFFER buf_condition-keeping FOR ub.condition-keeping.
     1032   ASSIGN
     1033   v-cond-keep-code = FRAME DLGOKCAN cond-keep-code
     1034   cond-keep-code.
     1035   FIND FIRST buf_condition-keeping WHERE
     1036    buf_condition-keeping.cond-keep-code = cond-keep-code NO-LOCK NO-error.
     1037   if not available buf_condition-keeping then do:
     1038       IF v-cond-keep-code <> ? THEN DO:
     1039           MESSAGE
     1040           "Нет условий хранения с кодом" cond-keep-code
     1041           VIEW-AS ALERT-BOX ERROR.
     1042           IF LASTKEY = KEYCODE("return") THEN DO:
     1043               RUN proc-b-cond-keep-code  IN THIS-PROCEDURE NO-error.
     1044               RETURN NO-APPLY.
     1045           END.
     1046           ELSE DO:
     1047               assign
     1048               cond-keep-code = v-cond-keep-code.
     1049           END.
     1050       END.
     1051       ELSE DO:
     1052         IF p-LASTKEY = KEYCODE("return") THEN DO:
     1053               MESSAGE
     1054            "Нет условий хранения с кодом" cond-keep-code
     1055            VIEW-AS ALERT-BOX ERROR.
     1056         END.
     1057       END.
     1058       ASSIGN
     1059       cond-keep-code = ?
     1060       cond-keep-name = "":U
     1061       .
     1062       display
     1063       cond-keep-code
     1064       cond-keep-name
     1065       with frame DLGOKCAN.
     1066       IF p-LASTKEY = KEYCODE("return") THEN DO:
     1067         RUN proc-b-cond-keep-code  IN THIS-PROCEDURE NO-error.
     1068         IF ERROR-STATUS:ERROR THEN RETURN error.
     1069       END.
     1070   end.
     1071   else do:
     1072     FIND FIRST X_condition-keeping NO-LOCK WHERE
     1073               recid(X_condition-keeping) = RECID(buf_condition-keeping).
     1074     assign
     1075     cond-keep-name = buf_condition-keeping.cond-keep-name
     1076     .
     1077       display
     1078       cond-keep-name
     1079       cond-keep-code
     1080       with frame DLGOKCAN.
     1081       .
     1082   END.
     1083   END PROCEDURE.
