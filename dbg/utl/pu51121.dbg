      412       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      413            SIDE-LABELS THREE-D  SCROLLABLE
      414            BGCOLOR 8 FGCOLOR 0
      415            TITLE BGCOLOR 8 FGCOLOR 1 "Введите изменения атрибутов товара для пакетной обработки":L
      416            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      417   ASSIGN
      418          FRAME DLGOKCAN:SCROLLABLE       = FALSE.
      419   ON RIGHT-MOUSE-CLICK OF Attrib IN FRAME DLGOKCAN
      420   DO:
      421       assign
      422       n-attrib:fgcolor = 15
      423       attrib = ""
      424       l-attrib:visible = true.
      425       display attrib with frame DLGOKCAN.
      426       disable attrib with frame DLGOKCAN.
      427   END.
      428   ON CHOOSE OF Btn_Cancel IN FRAME DLGOKCAN
      429   DO:
      430       return "отказ" .
      431   END.
      432   ON CHOOSE OF Btn_OK IN FRAME DLGOKCAN
      433   DO:
      434   define variable choice as log no-undo .
      435               assign
      436                   Destin
      437                   Attrib
      438                   UserRule
      439                   Sert
      440                   Struct
      441                   DeadLine
      442                   Sort
      443                   cst-base-rate
      444                   NATIONALITY = IF NATIONALITY:SCREEN-VALUE = ? THEN "Российский" else
      445                                    NATIONALITY:SCREEN-VALUE
      446                   TNVED
      447                   unit-cst
      448                   normal-wastage
      449                   normal-waste
      450                   cond-keep-code
      451                   proof
      452                   .
      453               assign
      454               destin_ = (if destin:sensitive  then Destin else ?)
      455               attrib_ = if Attrib:sensitive then Attrib else ?
      456               user-rule_ = if userrule:sensitive  then userrule else ?
      457               sert_ = if sert:sensitive then Sert else ?
      458               struct_ = if struct:sensitive then Struct else ?
      459               deadline_ = if Deadline:sensitive then Deadline else ?
      460               sort_ = if Sort:sensitive then Sort else ?
      461               cst-base-rate_ = if Cst-base-rate:sensitive  then cst-base-rate else ?
      462               NATIONALITY_ = if Nationality:sensitive then nationality else ?
      463               TNVED_ = if tnved:sensitive then tnved else ?
      464               unit-cst_ = if unit-cst:sensitive then unit-cst else ?
      465               normal-wastage_ = if normal-wastage:sensitive then normal-wastage else ?
      466               normal-waste_ = if normal-waste:sensitive then normal-waste else ?
      467               cond-keep-code_ = if cond-keep-code:sensitive then cond-keep-code else ?
      468               proof_ = if proof:sensitive then proof else ?
      469               .
      470   END.
      471   ON LEAVE OF cond-keep-code IN FRAME DLGOKCAN
      472   DO:
      473         RUN proc-leave-cond-keep-code IN THIS-PROCEDURE (INPUT LASTKEY) NO-ERROR.
      474       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      475   END.
      476   ON RIGHT-MOUSE-CLICK OF cond-keep-code IN FRAME DLGOKCAN
      477   DO:
      478     assign
      479       n-cond-keep-code:fgcolor = 15
      480       cond-keep-code = ?
      481       l-cond-keep-code:visible = true.
      482       display cond-keep-code with frame DLGOKCAN.
