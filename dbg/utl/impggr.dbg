        1   DEFINE VARIABLE p-install as logical no-undo init false .
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Импорт групп товаров ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define stream sinp .
       78   define stream slog.
       79   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
       80        LABEL "Отмена"
       81        SIZE 15 BY 1.13
       82        BGCOLOR 8 .
       83   DEFINE BUTTON Btn_OK AUTO-GO
       84        LABEL "Ввод"
       85        SIZE 15 BY 1.13
       86        BGCOLOR 8 .
       87   DEFINE BUTTON r-currency
       88        IMAGE-UP FILE "btn-down-arrow":U
       89        IMAGE-DOWN FILE "btn-down-arrow":U
       90        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       91        LABEL ""
       92        SIZE 3 BY 1.
       93   DEFINE VARIABLE f-name AS CHARACTER FORMAT "X(256)":U
       94        LABEL "Файл"
       95        VIEW-AS FILL-IN
       96        SIZE 42 BY 1 NO-UNDO.
       97   DEFINE VARIABLE rs-format AS INTEGER
       98        VIEW-AS RADIO-SET VERTICAL
       99        RADIO-BUTTONS
      100             "Имя группы", 1,
      101   "Имя группы,код группы,код родительской группы", 2
      102        SIZE 52 BY 2.5 NO-UNDO.
      103   DEFINE FRAME Dialog-Frame
      104        rs-format AT ROW 2.21 COL 3.38 NO-LABEL WIDGET-ID 2
      105        f-name AT ROW 5.04 COL 7.25 COLON-ALIGNED WIDGET-ID 8
      106        r-currency AT ROW 5.08 COL 51.25 WIDGET-ID 52
      107        Btn_OK AT ROW 7.21 COL 9
      108        Btn_Cancel AT ROW 7.25 COL 26.63
      109        "Выберите формат:" VIEW-AS TEXT
      110             SIZE 19.5 BY .67 AT ROW 1.25 COL 3.5 WIDGET-ID 6
      111        SPACE(36.37) SKIP(7.99)
      112       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      113            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      114            TITLE "Импорт групп товаров"
      115            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      116   ASSIGN
      117          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      118          FRAME Dialog-Frame:HIDDEN           = TRUE.
      119   ASSIGN
      120          r-currency:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      121   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      122   DO:
      123     APPLY "END-ERROR":U TO SELF.
      124   END.
      125   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      126   DO:
      127   define variable v-ok   as logical   no-undo .
      128   DEFINE VARIABLE v-level-name as character no-undo .
      129   DEFINE VARIABLE v-level-num as integer no-undo .
      130   DEFINE VARIABLE v-full-level-name as character no-undo .
      131   DEFINE VARIABLE v-node-code like ub.gds-grp.node-code no-undo .
      132   DEFINE VARIABLE v-upper-code like ub.gds-grp.upper-code no-undo .
      133   DEFINE VARIABLE v-calc-method like ub.gds-grp.calc-method no-undo .
      134   DEFINE VARIABLE v-increase-pc like ub.gds-grp.increase-pc no-undo .
      135   DEFINE VARIABLE v-print-code  like ub.gds-grp.print-code  no-undo .
      136   DEFINE VARIABLE v-d-pcnt like ub.gds-grp.d-pcnt no-undo .
      137   DEFINE VARIABLE v-new-node-code like ub.gds-grp.node-code no-undo .
      138   DEFINE VARIABLE v-rid as recid no-undo.
      139   DEFINE VARIABLE v-ask as logical no-undo init yes.
      140   DEFINE VARIABLE choice as integer no-undo .
      141   define buffer buf_gds-grp for ub.gds-grp.
      142   do
      143   on error undo, return
      144   :
      145     assign
      146       v-ok = false
      147     .
      148   assign     frame Dialog-Frame f-name  rs-format.
      149   f-name = search(f-name).
      150   if f-name = ? then do:
      151       message "Не указан файл" view-as alert-box.
      152       return no-apply.
      153   end.
      154     input stream sinp from value (f-name).
      155     define variable v-file-format as character no-undo .
      156     find first ub.sys-ctrl no-lock .
      157     if ub.sys-ctrl.db-num <> 0 then do:
      158       if not p-install then do:
      159         message
      160         "Утилиту импорта групп товаров можно запускать только в ГБД"
      161         view-as alert-box error .
      162       end.
      163       return .
      164     end.
      165     import stream sinp v-file-format .
      166     if rs-format = 1 and v-file-format <> "GOODS_GRP_1_0"
      167        or rs-format = 2 and v-file-format <> "GOODS_GRP_2_0" then do:
      168       input stream sinp close.
      169       message
      170         "Неправильный формат файла" skip
      171         "Первая строка файла" v-file-format skip
      172         "Файл" f-name skip
      173         view-as alert-box error .
      174       undo, return no-apply .
      175     end.
      176     run write-to-log in this-procedure(chr(10) + string(today, "99/99/9999") + chr(32) +
      177                                        string(time, "HH:MM:SS") + chr(32) +
      178                                        g#userid) .
      179     define variable v-full-name as character no-undo .
      180     repeat
      181     :
      182      if rs-format = 1  then import stream sinp unformatted v-full-name.
      183      else  import stream sinp delimiter ','  v-full-name  v-node-code    v-upper-code.
      184       assign
      185         v-ok = true
      186       .
      187       v-full-name = trim(v-full-name,'"').
      188       if v-ask then
      189       run gbl/d-askw.w (input "Создание групп товаров",
      190                 input "Группа" + chr(10) + v-full-name,
      191                 input "|",
      192                 input "Создать|Не создавать|Создать все|Отмена",
      193                 input "Создать группу (если такой еще нет)|Не создавать группу|Перестать спрашивать и по возможности создать все|Прекратить загрузку групп товаров",
      194                 input 1,
      195                 input 4,
      196                 output choice).
      197      CASE choice:
      198       when 1 then do:
      199         assign
      200         v-ok = yes.
      201       end.
      202       when 2 then do:
      203         assign
      204         v-ok = no
      205         .
      206       end.
      207       when 3 then do:
      208         assign
      209         v-ok = yes
      210         v-ask = no
      211         .
      212       end.
      213       when 4 then do:
      214         leave.
      215       end.
      216      END CASE.
      217      if v-ok = true  and rs-format = 1 then do:
      218         assign
      219         v-full-name = trim(v-full-name, chr(47))
      220         v-full-level-name = "":U
      221         .
      222         find first buf_gds-grp no-lock where
      223                    buf_gds-grp.upper-code = 0 no-error .
      224         assign
      225         v-node-code = buf_gds-grp.node-code
      226         v-calc-method = buf_gds-grp.calc-method
      227         v-increase-pc = buf_gds-grp.increase-pc
      228         v-print-code  = buf_gds-grp.print-code
      229         v-d-pcnt = buf_gds-grp.d-pcnt
      230         .
      231         _cycle:
      232         do v-level-num = 1 to num-entries(v-full-name, chr(47)):
      233           assign
      234           v-level-name =  entry(v-level-num, v-full-name, chr(47))
      235           v-full-level-name = v-full-level-name + v-level-name + chr(47)
      236           .
      237           find first buf_gds-grp no-lock where
      238                      buf_gds-grp.upper-code = v-node-code
      239                  and buf_gds-grp.node-name = v-level-name no-error .
      240           if not avail buf_gds-grp then do:
      241            run ref/gdsgrp01.p (
      242                            input 'ДОБАВЛЕНИЕ':U
      243                           ,input p-install
      244                           ,input no
      245                           ,input yes
      246                           ,input-output v-new-node-code
      247                           ,input-output v-node-code
      248                           ,input v-level-name
      249                           ,input v-calc-method
      250                           ,input v-increase-pc
      251                           ,input v-print-code
      252                           ,input 'Отключено':U
      253                           ,input 0
      254                           ,output v-rid
      255                           ) no-error.
      256             if error-status:error then do:
      257               run write-to-log in this-procedure("error in creating group" + chr(32) + v-full-level-name) .
      258               next _cycle.
      259             end.
      260             if error-status:error then do:
      261               run write-to-log in this-procedure("error in creating group" + chr(32) + v-full-level-name) .
      262             end.
      263             else do:
      264               run write-to-log in this-procedure("new group" + chr(32) + v-full-level-name) .
      265             end.
      266             assign
      267             v-node-code = v-new-node-code
      268             .
      269           end.
      270           else do:
      271             run write-to-log in this-procedure("exists group" + chr(32) + v-full-level-name) .
      272             assign
      273             v-node-code = buf_gds-grp.node-code
      274             v-calc-method = buf_gds-grp.calc-method
      275             v-increase-pc = buf_gds-grp.increase-pc
      276             v-print-code  = buf_gds-grp.print-code
      277             v-d-pcnt = buf_gds-grp.d-pcnt
      278             .
      279             next _cycle.
      280           end.
      281         end.
      282       end.
      283       else if v-ok and rs-format = 2 then do:
      284         assign
      285         v-full-level-name = "":U
      286         .
      287         if num-entries(v-full-name,chr(47)) > 1 then do:
      288               run write-to-log in this-procedure("Не верно задано имя группы. Следует указывать только имя самой группы, без полного пути" + chr(32) + v-full-name) .
      289               next .
      290         end.
      291         find first buf_gds-grp no-lock where
      292                    buf_gds-grp.node-code = v-upper-code no-error .
      293         if not available buf_gds-grp then do:
      294               run write-to-log in this-procedure("Не найдена родительская группа с кодом" + chr(32) + string(v-upper-code)) .
      295               next .
      296         end.
      297         if can-find (first ub.goods where ub.goods.grp-code = buf_gds-grp.node-code no-lock ) then do:
      298              run write-to-log in this-procedure("Группа с кодом" + chr(32) + string(v-upper-code) + " содержит товары. Добавление в нее подгрупп запрещено!") .
      299              next .
      300         end.
      301         assign
      302         v-calc-method = buf_gds-grp.calc-method
      303         v-increase-pc = buf_gds-grp.increase-pc
      304         v-print-code  = buf_gds-grp.print-code
      305         v-d-pcnt = buf_gds-grp.d-pcnt
      306         .
      307         find first buf_gds-grp no-lock where
      308                    buf_gds-grp.node-code = v-node-code no-error .
      309           if not avail buf_gds-grp then do:
      310            run ref/gdsgrp01.p (
      311                            input 'ДОБАВЛЕНИЕ':U
      312                           ,input p-install
      313                           ,input yes
      314                           ,input yes
      315                           ,input-output v-node-code
      316                           ,input-output v-upper-code
      317                           ,input v-full-name
      318                           ,input v-calc-method
      319                           ,input v-increase-pc
      320                           ,input v-print-code
      321                           ,input 'Отключено':U
      322                           ,input 0
      323                           ,output v-rid
      324                           ) no-error.
      325             if error-status:error then do:
      326               run write-to-log in this-procedure("error in creating group" + chr(32) + v-full-level-name) .
      327               next .
      328             end.
      329             if error-status:error then do:
      330               run write-to-log in this-procedure("error in creating group" + chr(32) + v-full-level-name) .
      331             end.
      332             else do:
      333               run write-to-log in this-procedure("new group" + chr(32) + v-full-level-name) .
      334             end.
      335             assign
      336             v-node-code = v-new-node-code
      337             .
      338           end.
      339           else do:
      340             run write-to-log in this-procedure("exists group" + chr(32) + v-full-level-name) .
      341             assign
      342             v-node-code = buf_gds-grp.node-code
      343             v-calc-method = buf_gds-grp.calc-method
      344             v-increase-pc = buf_gds-grp.increase-pc
      345             v-print-code  = buf_gds-grp.print-code
      346             v-d-pcnt = buf_gds-grp.d-pcnt
      347             .
      348             next .
      349           end.
      350         end.
      351       end.
      352   if session :set-wait-state( "" ) then.
      353     end.
      354     input stream sinp close.
      355   message "Импорт завершен".
      356   END.
      357   ON CHOOSE OF r-currency IN FRAME Dialog-Frame
      358   DO:
      359   def var v-ok as log.
      360         system-dialog get-file f-name
      361         title "Выберите файл с группами товаров"
      362         filters "Файлы групп товаров *.ggr" "*.ggr",
      363                   "Все файлы  *.*" "*.*"
      364         INITIAL-DIR "."
      365         return-to-start-dir
      366         must-exist
      367         update v-ok
      368         default-extension "ggr".
      369       if v-ok <> true then do:
      370         return .
      371       end.
      372   f-name:screen-value = search(f-name).
      373   END.
      374   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      375   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      376   MAIN-BLOCK:
      377   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      378      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      379     RUN enable_UI.
      380     WAIT-FOR GO OF FRAME Dialog-Frame.
      381   END.
      382   RUN disable_UI.
      383   PROCEDURE disable_UI :
      384     HIDE FRAME Dialog-Frame.
      385   END PROCEDURE.
      386   PROCEDURE enable_UI :
      387     DISPLAY rs-format f-name
      388         WITH FRAME Dialog-Frame.
      389     ENABLE rs-format f-name r-currency Btn_OK Btn_Cancel
      390         WITH FRAME Dialog-Frame.
      391     VIEW FRAME Dialog-Frame.
      392   END PROCEDURE.
      393   PROCEDURE write-to-log :
      394   define input parameter P-MESSAGE as character no-undo .
      395     do
      396     on error undo, return error
      397     :
      398       output STREAM SLOG TO imp-ggr.log append.
      399       put STREAM SLOG unformatted
      400       P-MESSAGE SKIP.
      401       OUTPUT STREAM SLOG CLOSE.
      402     end.
      403   END PROCEDURE.
