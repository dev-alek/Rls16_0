      446   procedure userobjs_select-many :
      447     define input  parameter parparentproc   as widget-handle no-undo .
      448     define input  parameter p-db-num        as integer   no-undo .
      449     define input  parameter p-user-id       as character no-undo .
      450     define input  parameter p-host-code-obj as integer   no-undo .
      451     define input  parameter p-obj-type      as character no-undo .
      452     define input  parameter p-obj-code      as integer   no-undo .
      453     define output parameter p-user-select   as logical   no-undo .
