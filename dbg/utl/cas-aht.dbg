      474   procedure thobjs :
      475      define input        parameter parparentproc     as widget-handle no-undo .
      476      define input        parameter i-bttns           as character     no-undo .
      477      define input        parameter i-list-mode       as character     no-undo.
      478      define input        parameter i-obj-type        as character     no-undo.
      479      define input        parameter i-db-num          as integer       no-undo.
      480      define input        parameter i-host-code       as integer       no-undo.
      481      define input-output parameter p-rid-list        as character     no-undo .
      482   run ref/thobjs.p
      483           ( input parparentproc
      484            ,input  this-procedure :handle
      485           , input i-bttns
      486           , input i-list-mode
      487           , input i-obj-type
      488           , input i-db-num
      489           , input i-host-code
      490           , input-output p-rid-list ) no-error .
      491   end.
      492   define variable v-today           as date      no-undo .
      493   define variable v-time            as integer   no-undo .
      494   define variable v-total-err-obj   as integer   no-undo .
      495   define variable v-total-ind       as integer   no-undo .
      496   define variable v-grand-total-err as integer   no-undo .
      497   define variable v-last-obj-type   as character no-undo .
      498   define variable v-last-obj-code   as integer   no-undo .
      499   define variable v-last-err-date   as date      no-undo .
      500   define variable v-log-file-name   as character no-undo .
      501   define variable v-error-file-name as character no-undo .
      502   define stream sout .
      503   define variable v-object  as character no-undo .
      504   define frame a
      505     v-object        format "x(40)"       label "Объект" skip
      506     v-total-ind     format ">>>,>>>,>>9" label "Проверено объектов" skip
      507     v-total-err-obj format ">>>,>>>,>>9" label "Объектов с ошибками" skip
      508     with view-as dialog-box side-labels three-d
      509     title "Проверка складского архива по типам приобретения"
      510     .
      511   do
      512   on error undo, return error return-value
      513   :
      514     assign
      515       v-log-file-name   = 'cas-aht.log':U
      516       v-error-file-name = 'cas-aht.txt':U
      517     .
      518     define variable v-num as integer no-undo .
      519   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      520     run mainmenu_getcntxt in parparentproc
      521       (output v-cntxt-db-num
      522       ,output v-cntxt-userid
      523       ,output v-cntxt-level
      524       ,output v-cntxt-host-code-obj
      525       ,output v-cntxt-obj-type
      526       ,output v-cntxt-obj-code
      527       ,output v-cntxt-db-num-obj
      528       ,output v-cntxt-is-admin
      529       ) .
      530     run gbl/d-askw.w
      531       (input "Вопрос"
      532       ,input "Проверка целостности складского архива по типам приобретения" + chr(10)
      533       ,input "|^"
      534       ,input "Все объекты^confirm|Выбрать объекты|Отмена"
      535       ,input "|"
      536           + "|"
      537           + ""
      538       ,input 1
      539       ,input 3
      540       ,output v-num
      541       ).
      542     case v-num :
      543       when 1
      544       then do:
      545         define buffer buf_db for ub.db .
      546         define buffer buf_clients for ub.clients .
      547         for each buf_db no-lock
      548         ,each buf_clients no-lock
      549           where buf_clients.db-num = buf_db.db-num
      550         on error undo, return error return-value
      551         :
      552           if buf_clients.stts = 0
      553           then do:
      554             run check-archive-aht in this-procedure
      555               (input buf_clients.obj-type
      556               ,input buf_clients.obj-code
      557               ).
      558           end.
      559         end.
      560       end.
      561       when 2
      562       then do:
      563         define variable v-user-select as logical   no-undo .
      564   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   run userobjs_select-many in this-procedure
      566     (input  parparentproc
      567     ,input  v-cntxt-db-num
      568     ,input  v-cntxt-userid
      569     ,input  v-cntxt-host-code-obj
      570     ,input  v-cntxt-obj-type
      571     ,input  v-cntxt-obj-code
      572     ,output v-user-select
      573     )  .
      574         if v-user-select <> true
      575         then do:
      576           message
      577             "Объект не выбран"
      578             view-as alert-box information .
      579           return .
      580         end.
      581         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      582         for each buf_userobjs_temp-user-obj
      583         on error undo, return error return-value
      584         :
      585           run check-archive-aht in this-procedure
      586             (input buf_userobjs_temp-user-obj.obj-type
      587             ,input buf_userobjs_temp-user-obj.obj-code
      588             ).
      589         end.
      590       end.
      591       otherwise do:
      592         return .
      593       end.
      594     end.
      595     if v-total-err-obj <> 0
      596     then do:
      597       message
      598         "Проверка складского архива по типам приобретения закончена" skip
      599         "" skip
      600         "Обнаружены ошибки в складском архиве по типам приобретения" skip
      601         "Проверено объектов" v-total-ind skip
      602         "Всего объектов с ошибками" v-total-err-obj skip
      603         "Всего элементарных ошибок" v-grand-total-err skip
      604         "Список проверенных объектов выведен в файл" v-log-file-name skip
      605         "Список объектов с ошибками выведен в файл" v-error-file-name skip
      606         view-as alert-box error .
      607     end.
      608     else do:
      609       message
      610         "Проверка складского архива по типам приобретения закончена" skip
      611         "" skip
      612         "Ошибок не обнаружено" skip
      613         "Проверено объектов" v-total-ind skip
      614         "Список проверенных объектов выведен в файл" v-log-file-name skip
      615         view-as alert-box information .
      616     end.
      617   end.
      618   procedure check-archive-aht :
      619     define input  parameter p-obj-type as character no-undo .
      620     define input  parameter p-obj-code as integer   no-undo .
      621     define variable v-create-chip-num        as integer   no-undo .
      622     define variable v-err-count              as integer   no-undo .
      623     define variable v-last-date              as date      no-undo .
      624     define variable v-error-description      as character no-undo .
      625     define variable v-detail-error-file-name as character no-undo .
      626     do
      627     on error undo, return error return-value
      628     :
      629       assign
      630         v-total-ind     = v-total-ind + 1
      631         v-last-obj-type = p-obj-type
      632         v-last-obj-code = p-obj-code
      633       .
      634       run utl/arhichk.p
      635         (input  p-obj-type
      636         ,input  p-obj-code
      637         ,input  'aht':U
      638         ,input  'check-start':U
      639         ,input  ?
      640         ,input  0
      641         ,input  ''
      642         ,output v-create-chip-num
      643         ) .
      644       output stream sout to value(v-log-file-name) append .
      645       export stream sout '###':U string(v-today, '99/99/9999':U) string(v-time, 'HH:MM:SS':U) .
      646       export stream sout "Начало проверки целостности складского архива по типам приобретения" .
      647       export stream sout "Объект" p-obj-type p-obj-code .
      648       output stream sout close .
      649       view frame a .
      650       display
      651         substitute('&1 &2', p-obj-type, p-obj-code) @ v-object
      652         v-total-err-obj       @ v-total-err-obj
      653         with frame a .
      654       run utl/car-aht.p
      655         (input  p-obj-type
      656         ,input  p-obj-code
      657         ,output v-err-count
      658         ,output v-last-date
      659         ,output v-error-description
      660         ,output v-detail-error-file-name
      661         ) .
      662       if v-err-count <> 0
      663       then do:
      664         assign
      665           v-total-err-obj = v-total-err-obj + 1
      666         .
      667         assign
      668           v-grand-total-err = v-grand-total-err + v-err-count
      669         .
      670         run cur-time in this-procedure
      671           (output v-today
      672           ,output v-time
      673           ) .
      674         output stream sout to value(v-error-file-name) append .
      675         export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
      676         export stream sout "Завершена проверка складского архива по типам приобретения" .
      677         export stream sout "Объект" p-obj-type p-obj-code .
      678         export stream sout "Ошибок" v-err-count .
      679         export stream sout "Последняя ошибочная дата" string(v-last-date, '99/99/9999':u) .
      680         export stream sout "Подробная информация об ошибках выведена в файл" v-detail-error-file-name .
      681         export stream sout v-error-description .
      682         output stream sout close .
      683         assign
      684           v-last-err-date = v-last-date
      685         .
      686       end.
      687       else do:
      688         assign
      689           v-last-err-date = ?
      690         .
      691       end.
      692       output stream sout to value(v-log-file-name) append .
      693       export stream sout '###':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
      694       export stream sout "Завершена проверка складского архива по типам приобретени " .
      695       export stream sout "Объект" p-obj-type p-obj-code .
      696       export stream sout "Ошибок" v-err-count .
      697       export stream sout "Последняя ошибочная дата" string(v-last-date, '99/99/9999':u) .
      698       export stream sout "Подробная информация об ошибках выведена в файл" v-detail-error-file-name .
      699       export stream sout v-error-description .
      700       output stream sout close .
      701       run utl/arhichk.p
      702         (input  p-obj-type
      703         ,input  p-obj-code
      704         ,input  'arh':U
      705         ,input  'check-stop':U
      706         ,input  ?
      707         ,input  v-err-count
      708         ,input  v-error-description
      709         ,output v-create-chip-num
      710         ) .
      711       hide frame a .
      712     end.
      713   end procedure.
