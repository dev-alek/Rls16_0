        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Просмотр признаков строки документа".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE QUERY external_tables FOR doc-line.
      108   RUN set-attribute-list (
      109       'Keys-Accepted = ,
      110        Keys-Supplied = "obj-code,doc-code"':U).
      111   RUN set-attribute-list (
      112       'SortBy-Options = ""':U).
      113   DEFINE QUERY br_table FOR
      114         gds-dtl SCROLLING.
      115   DEFINE BROWSE br_table
      116     QUERY br_table NO-LOCK DISPLAY
      117         gds-dtl.doc-qnty      COLUMN-LABEL "doc-qnty"
      118         gds-dtl.fact-qnty     COLUMN-LABEL "fact-qnty"
      119         gds-dtl.price-base    COLUMN-LABEL "price-base"
      120         gds-dtl.price-rubl    COLUMN-LABEL "price-rubl"
      121         gds-dtl.discnt-pc     COLUMN-LABEL "discnt-pc"
      122         gds-dtl.discnt-base   COLUMN-LABEL "discnt-base"
      123         gds-dtl.discnt-rubl   COLUMN-LABEL "discnt-rubl"
      124         gds-dtl.discnt-type   COLUMN-LABEL "discnt-type"
      125         gds-dtl.cur-base      COLUMN-LABEL "cur-base"
      126         gds-dtl.prt-code      COLUMN-LABEL "prt-code"
      127         gds-dtl.ov            COLUMN-LABEL "ov"
      128       WITH NO-ASSIGN SEPARATORS SIZE 97.63 BY 6.71.
      129   DEFINE FRAME F-Main
      130        br_table AT ROW 1 COL 1
      131       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      132            SIDE-LABELS NO-UNDERLINE THREE-D
      133            AT COL 1 ROW 1 SCROLLABLE
      134            BGCOLOR 8 FGCOLOR 0 .
      135   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      136   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      137   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      138   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      139   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      140   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      141   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      142   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      143   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      144   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      145   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      146         adm-object-hdl = FRAME F-Main:HANDLE.
      147   RUN ensure-broker.
      148   THIS-PROCEDURE:ADM-DATA =
      149        'ADM1.1~`':U +
      150        'SmartObject~`':U +
      151        '~`':U +
      152        'YES~`':U +
      153        'doc-line~`':U +
      154        'gds-dtl~`':U +
      155        '~`':U +
      156        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      157           + "~`":U +
      158        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      159        'Record-Source,Record-Target,TableIO-Target~`':U +
      160        '~`':U +
      161        '~`~`~`~`~`~`~`~`~`~`~`':U +
      162        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      163            THEN "^^":U
      164        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      165             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      166   PROCEDURE adm-apply-entry :
      167     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      168   END PROCEDURE.
      169   PROCEDURE adm-destroy :
      170    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      171   END PROCEDURE.
      172   PROCEDURE adm-disable :
      173       DISABLE br_table WITH FRAME F-Main.
      174       RUN dispatch ('disable-fields':U).
      175       RUN set-attribute-list ('ENABLED=no':U).
      176       RETURN.
      177   END PROCEDURE.
      178   PROCEDURE adm-edit-attribute-list :
      179         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      180         RETURN.
      181   END PROCEDURE.
      182   PROCEDURE adm-enable :
      183       ENABLE UNLESS-HIDDEN br_table WITH FRAME F-Main.
      184       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      185       RUN set-attribute-list ('ENABLED=yes':U).
      186       RETURN.
      187   END PROCEDURE.
      188   PROCEDURE adm-exit :
      189        RUN notify ('exit':U).
      190     RETURN.
      191   END PROCEDURE.
      192   PROCEDURE adm-hide :
      193     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      194   END PROCEDURE.
      195   PROCEDURE adm-initialize :
      196     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      197   END PROCEDURE.
      198   PROCEDURE adm-show-errors :
      199       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      200       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      201           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      202       END.
      203       RETURN.
      204   END PROCEDURE.
      205   PROCEDURE adm-UIB-mode :
      206     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      207   END PROCEDURE.
      208   PROCEDURE adm-view :
      209     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      210   END PROCEDURE.
      211   PROCEDURE dispatch :
      212       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      213       RUN broker-dispatch IN adm-broker-hdl
      214           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      215       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      216   END PROCEDURE.
      217   PROCEDURE ensure-broker :
      218   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      219   IF RETURN-VALUE NE "ADM-Broker":U THEN
      220   DO:
      221       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      222       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      223   END.
      224   END PROCEDURE.
      225   PROCEDURE get-attribute :
      226     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      227     RUN broker-get-attribute IN adm-broker-hdl
      228         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      229     RETURN RETURN-VALUE.
      230   END PROCEDURE.
      231   PROCEDURE get-attribute-list :
      232     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      233     RUN broker-get-attribute-list IN adm-broker-hdl
      234         (INPUT THIS-PROCEDURE,
      235          INPUT ?,
      236          OUTPUT p-attr-list) NO-ERROR.
      237     RETURN.
      238   END PROCEDURE.
      239   PROCEDURE new-state :
      240     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      241     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      242     RETURN.
      243   END PROCEDURE.
      244   PROCEDURE notify :
      245     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      246     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      247     IF RETURN-VALUE = "ADM-ERROR":U THEN
      248         RETURN "ADM-ERROR":U.
      249     RETURN.
      250   END PROCEDURE.
      251   PROCEDURE set-attribute-list :
      252     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      253     RUN ensure-broker.
      254     RUN broker-set-attribute-list IN adm-broker-hdl
      255         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      256     RETURN.
      257   END PROCEDURE.
      258   PROCEDURE set-position :
      259       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      260       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      261       IF VALID-HANDLE(adm-object-hdl) THEN
      262       DO:
      263         ASSIGN adm-object-hdl:ROW    =   p-row
      264                adm-object-hdl:COLUMN =   p-col.
      265       END.
      266       RETURN.
      267   END PROCEDURE.
      268     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      269     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      270     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      271     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      272     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      273     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      274     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      275     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      276     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      277     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      278     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      279     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      280     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      281     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      282     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      283     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      284     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      285     IF "":U = "":U THEN
      286       RUN modify-list-attribute IN adm-broker-hdl
      287         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      288     RUN use-create-on-add(?).
      289   PROCEDURE adm-add-record :
      290       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      291          "must have at least one Enabled Table to perform Add.":U
      292          VIEW-AS ALERT-BOX ERROR.
      293       RETURN.
      294   END PROCEDURE.
      295   PROCEDURE adm-assign-record :
      296    MESSAGE
      297          "Object ":U THIS-PROCEDURE:FILE-NAME
      298            "must have at least one Enabled Table to perform Assign.":U
      299              VIEW-AS ALERT-BOX ERROR.
      300      RETURN.
      301     END PROCEDURE.
      302   PROCEDURE adm-assign-statement :
      303     RETURN.
      304   END PROCEDURE.
      305   PROCEDURE adm-cancel-record :
      306      RETURN.
      307     END PROCEDURE.
      308   PROCEDURE adm-copy-record :
      309       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      310        "must have at least one Enabled Table to perform Copy.":U
      311          VIEW-AS ALERT-BOX ERROR.
      312       RETURN.
      313   END PROCEDURE.
      314   PROCEDURE adm-create-record :
      315      RETURN.
      316   END PROCEDURE.
      317   PROCEDURE adm-current-changed :
      318     RETURN.
      319   END PROCEDURE.
      320   PROCEDURE adm-delete-record :
      321    MESSAGE
      322          "Object ":U THIS-PROCEDURE:FILE-NAME
      323            "must have at least one Enabled Table to perform Delete.":U
      324              VIEW-AS ALERT-BOX ERROR.
      325       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      326       RETURN.
      327   END PROCEDURE.
      328   PROCEDURE adm-disable-fields :
      329         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      330       RETURN.
      331   END PROCEDURE.
      332   PROCEDURE adm-enable-fields :
      333       RETURN.
      334   END PROCEDURE.
      335   PROCEDURE adm-end-update :
      336     RETURN.
      337   END PROCEDURE.
      338   PROCEDURE adm-reset-record :
      339       RETURN.
      340   END PROCEDURE.
      341   PROCEDURE adm-update-record :
      342       MESSAGE
      343         "Object ":U THIS-PROCEDURE:FILE-NAME
      344           "must have at least one Enabled Table to perform Update.":U
      345             VIEW-AS ALERT-BOX ERROR.
      346      RETURN.
      347   END PROCEDURE.
      348   PROCEDURE check-modified :
      349   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      350   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      351   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      352   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      353     IF check-state = "check":U THEN
      354     DO:
      355       RUN get-link-handle IN adm-broker-hdl
      356         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      357            OUTPUT group-target-list).
      358       IF group-target-list NE "":U THEN
      359       DO i = 1 TO NUM-ENTRIES(group-target-list):
      360         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      361         RUN check-modified IN curr-widget ('group-check':U).
      362         IF RETURN-VALUE NE "":U THEN
      363         DO:
      364           RUN check-modified-message(RETURN-VALUE).
      365           RETURN "":U.
      366         END.
      367       END.
      368     END.
      369     RETURN "":U.
      370   END PROCEDURE.
      371   PROCEDURE check-modified-message :
      372     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      373        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      374           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      375        IF RETURN-VALUE = "YES":U THEN
      376           RUN notify ('view,CONTAINER-SOURCE':U).
      377        MESSAGE IF p-changed-table NE ? THEN
      378           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      379           ELSE "Current values have been changed."
      380           SKIP "  Do you wish to save those changes?"
      381           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      382        IF ANS THEN
      383        DO:
      384           IF group-assign-target THEN
      385             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      386           ELSE RUN dispatch('update-record':U).
      387           IF RETURN-VALUE = "ADM-ERROR":U THEN
      388           DO:
      389               MESSAGE "Changes to the previous record were not saved."
      390                 VIEW-AS ALERT-BOX ERROR.
      391               IF group-assign-target THEN
      392                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      393               ELSE RUN dispatch ('cancel-record':U).
      394           END.
      395        END.
      396        ELSE DO:
      397          IF group-assign-target THEN
      398             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      399          ELSE RUN dispatch('cancel-record':U).
      400        END.
      401        RETURN.
      402   END PROCEDURE.
      403   PROCEDURE get-rowid :
      404       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      405       ASSIGN
      406       p-table   =   adm-first-table.
      407       RETURN.
      408   END PROCEDURE.
      409   PROCEDURE init-group-assign :
      410       RUN request-attribute IN adm-broker-hdl
      411         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      412       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      413         group-assign-target = yes.
      414       ELSE group-assign-target = no.
      415       RETURN.
      416   END PROCEDURE.
      417   PROCEDURE set-editors :
      418       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      419       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      420       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      421       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      422       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      423       DO WHILE VALID-HANDLE (curr-widget):
      424           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      425              curr-widget:HIDDEN = no THEN DO:
      426             CASE p-field-setting:
      427               WHEN "INITIALIZE":U THEN
      428               DO:
      429                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      430                     read-only-list +
      431                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      432                        STRING(curr-widget).
      433               END.
      434               WHEN "DISABLE":U OR
      435               WHEN "ENABLE":U THEN
      436               DO:
      437                   curr-widget:SENSITIVE = yes.
      438                   RUN get-attribute ('Read-Only-Editors':U).
      439                   IF RETURN-VALUE = ? OR
      440                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      441                       curr-widget:READ-ONLY =
      442                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      443               END.
      444               WHEN "CLEAR":U THEN
      445                   curr-widget:SCREEN-VALUE = "":U.
      446             END CASE.
      447           END.
      448           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      449       END.
      450       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      451         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      452           + '"':U).
      453       RETURN.
      454   END PROCEDURE.
      455   PROCEDURE use-check-modified-all :
      456    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      457     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      458     RETURN.
      459   END PROCEDURE.
      460   PROCEDURE use-create-on-add :
      461   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      462      RETURN.
      463   END PROCEDURE.
      464   PROCEDURE use-initial-lock :
      465     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      466     ASSIGN adm-initial-lock = p-attr-value.
      467     RETURN.
      468   END PROCEDURE.
      469   PROCEDURE adm-display-fields :
      470         IF AVAILABLE gds-dtl THEN
      471             DISPLAY gds-dtl.doc-qnty gds-dtl.fact-qnty gds-dtl.price-base gds-dtl.price-rubl gds-dtl.discnt-pc gds-dtl.discnt-base gds-dtl.discnt-rubl gds-dtl.discnt-type gds-dtl.cur-base gds-dtl.prt-code gds-dtl.ov WITH BROWSE br_table
      472               NO-ERROR.
      473       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      474       RETURN.
      475   END PROCEDURE.
      476   PROCEDURE adm-open-query :
      477       IF AVAILABLE(doc-line) THEN DO:
      478               RUN dispatch ('open-query-cases':U).
      479           adm-query-opened = yes.
      480           IF NUM-RESULTS("br_table":U) = 0 THEN
      481               RUN new-state ('no-record-available,SELF':U).
      482           ELSE DO:
      483               RUN new-state ('record-available,SELF':U).
      484               RUN new-state ('first-record,SELF':U).
      485           END.
      486       END.
      487       ELSE
      488       DO:
      489           CLOSE QUERY br_table.
      490           RELEASE gds-dtl NO-ERROR.
      491           RUN new-state ('no-external-record-available,SELF':U).
      492       END.
      493           IF NOT adm-updating-record THEN
      494               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      495     RETURN.
      496   END PROCEDURE.
      497   PROCEDURE adm-row-changed :
      498         IF VALID-HANDLE(adm-object-hdl) THEN
      499           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      500         RUN notify ('row-available':U).
      501         RETURN.
      502   END PROCEDURE.
      503   PROCEDURE reposition-query :
      504       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      505       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      506       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      507       IF table-name <> ? THEN
      508           REPOSITION br_table TO ROWID table-name NO-ERROR.
      509       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      510       RETURN.
      511   END PROCEDURE.
      512     adm-sts = br_table:SET-REPOSITIONED-ROW
      513       (br_table:DOWN,"CONDITIONAL":U).
      514     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      515   PROCEDURE set-size :
      516     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      517     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      518     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      519     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      520     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      521     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      522     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      523     ASSIGN pd_height = MAX(pd_height, 2.0)
      524            pd_width  = MAX(pd_width, 2.0)
      525            hBrowse     = br_table:HANDLE IN FRAME F-Main
      526            hFieldGroup = hBrowse:PARENT
      527            htmpWidget  = hFieldGroup:FIRST-CHILD
      528            hFrame      = hFieldGroup:PARENT.
      529     Search-For-Siblings:
      530     REPEAT WHILE VALID-HANDLE(htmpWidget):
      531       IF htmpWidget NE hBrowse THEN DO:
      532         IF htmpWidget:TYPE NE "BUTTON" OR
      533            htmpWidget:X    NE 4 OR
      534            htmpWidget:Y    NE 4 THEN DO:
      535           RETURN.
      536         END.
      537       END.
      538       htmpWidget = htmpWidget:NEXT-SIBLING.
      539     END.
      540     IF pd_width < hBrowse:WIDTH THEN
      541       ASSIGN hBrowse:WIDTH = pd_width
      542              hFrame:WIDTH  = pd_width     NO-ERROR.
      543     ELSE
      544       ASSIGN hFrame:WIDTH  = pd_width
      545              hBrowse:WIDTH = pd_width     NO-ERROR.
      546     IF pd_height < hBrowse:HEIGHT THEN
      547       ASSIGN hBrowse:HEIGHT = pd_height
      548              hFrame:HEIGHT  = pd_height     NO-ERROR.
      549     ELSE
      550       ASSIGN hFrame:HEIGHT  = pd_height
      551              hBrowse:HEIGHT = pd_height     NO-ERROR.
      552   END PROCEDURE.
      553   ASSIGN
      554          FRAME F-Main:SCROLLABLE       = FALSE
      555          FRAME F-Main:HIDDEN           = TRUE.
      556   ON ROW-ENTRY OF br_table IN FRAME F-Main
      557   DO:
      558   END.
      559   ON ROW-LEAVE OF br_table IN FRAME F-Main
      560   DO:
      561   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      562   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      563   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      564     widget-enter = last-event:widget-enter.
      565     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      566     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      567       THEN widget-frame = widget-enter:FRAME.
      568     IF ((NOT VALID-HANDLE(widget-enter)) OR
      569         (widget-parent:TYPE = "BROWSE":U) OR
      570         (NOT VALID-HANDLE(widget-frame)) OR
      571         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      572     THEN DO:
      573         IF adm-brs-in-update THEN
      574         DO:
      575           MESSAGE
      576           "You must complete or cancel the update before leaving the current row."
      577               VIEW-AS ALERT-BOX WARNING.
      578           RETURN NO-APPLY.
      579         END.
      580         IF br_table:CURRENT-ROW-MODIFIED  OR
      581           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      582         DO:
      583           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      584           THEN DO:
      585             MESSAGE
      586             "Current record has been changed. " SKIP
      587             "Do you wish to save those changes?"
      588               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      589             IF l-save THEN
      590             DO:
      591                RUN dispatch('update-record':U).
      592                IF RETURN-VALUE = "ADM-ERROR":U THEN
      593                    RETURN NO-APPLY.
      594             END.
      595             ELSE RUN dispatch ('cancel-record':U).
      596           END.
      597           ELSE DO:
      598             RUN dispatch('update-record':U).
      599             IF RETURN-VALUE = "ADM-ERROR":U THEN
      600                 RETURN NO-APPLY.
      601           END.
      602         END.
      603     END.
      604   END.
      605   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      606   DO:
      607   RUN get-attribute('ADM-NEW-RECORD':U).
      608   IF RETURN-VALUE NE "YES":U THEN
      609     RUN notify ('row-available':U).
      610   END.
      611   if not this-procedure :persistent
      612   then do:
      613     message
      614       vss-workfile vss-revision vss-description skip
      615       "Ошибка при запуске процедуры" skip
      616       "Данную процедуру следует запускать только с параметром persistent" skip
      617       view-as alert-box error .
      618     undo, return error .
      619   end.
      620   PROCEDURE adm-open-query-cases :
      621     OPEN QUERY br_table FOR EACH gds-dtl WHERE gds-dtl.doc-code  = doc-line.doc-code    and                                                gds-dtl.artic     = doc-line.artic       and                                                gds-dtl.prod-type = doc-line.prod-type  and                                                gds-dtl.prod-code = doc-line.prod-code  NO-LOCK     .
      622   END PROCEDURE.
      623   PROCEDURE adm-row-available :
      624     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      625     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      626     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      627     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      628     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      629     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      630     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      631     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      632     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      633     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      634     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      635     IF adm-updating-record THEN RETURN.
      636     RUN get-attribute ('FIELDS-ENABLED':U).
      637     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      638     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      639         OUTPUT link-handle) NO-ERROR.
      640     IF link-handle = "":U THEN
      641         RETURN.
      642     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      643     IF NUM-ENTRIES(link-handle) > 1 THEN
      644         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      645             "encountered more than one RECORD-SOURCE.":U SKIP
      646             "The first - ":U record-source-hdl:file-name " - will be used.":U
      647                VIEW-AS ALERT-BOX ERROR.
      648     RUN get-attribute ('Key-Name':U).
      649     key-name = RETURN-VALUE.
      650     IF key-name = "":U THEN key-name = ?.
      651     IF key-name NE ? THEN DO:
      652       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      653         NO-ERROR.
      654       IF key-value NE ? THEN
      655         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      656     END.
      657     IF key-name eq ? THEN tbl-list = "doc-line":U.
      658         RUN send-records IN record-source-hdl
      659             (INPUT tbl-list, OUTPUT rowid-list) NO-ERROR.
      660         IF ERROR-STATUS:ERROR THEN RETURN.
      661     IF key-name ne ?
      662     THEN DO:
      663       RUN dispatch ('find-using-key':U).
      664       IF RETURN-VALUE eq "ADM-ERROR":U THEN RETURN RETURN-VALUE.
      665     END.
      666     ELSE
      667     DO:
      668       row-avail-cntr = row-avail-cntr + 1.
      669       row-avail-rowid = TO-ROWID(ENTRY(row-avail-cntr,rowid-list)).
      670       IF row-avail-rowid NE ROWID(doc-line) THEN different-row = yes.
      671       IF row-avail-rowid ne ? THEN DO:
      672          DO:
      673            IF row-avail-enabled AND
      674               (adm-initial-lock = "SHARE-LOCK":U OR
      675                adm-initial-lock = "EXCLUSIVE-LOCK":U) THEN
      676            DO:
      677              IF adm-initial-lock = "SHARE-LOCK":U
      678              THEN FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid SHARE-LOCK NO-ERROR.
      679              ELSE DO TRANSACTION:
      680                FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid EXCLUSIVE-LOCK NO-ERROR.
      681              END.
      682            END.
      683            ELSE FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid  NO-LOCK NO-ERROR.
      684            IF ERROR-STATUS:ERROR THEN DO:
      685              RUN dispatch ('show-errors':U).
      686              RETURN "ADM-ERROR":U.
      687            END.
      688          END.
      689       END.
      690       ELSE DO:
      691            IF AVAILABLE doc-line THEN RELEASE doc-line.
      692              IF NOT different-row THEN
      693                RUN dispatch('open-query').
      694        END.
      695     END.
      696   IF VALID-HANDLE (adm-object-hdl) THEN
      697       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      698     IF key-name ne ? OR different-row
      699     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      700     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
      701   END PROCEDURE.
      702   PROCEDURE disable_UI :
      703     HIDE FRAME F-Main.
      704     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      705   END PROCEDURE.
      706   PROCEDURE send-key :
      707     DEFINE INPUT  PARAMETER pc_key-name   AS CHARACTER NO-UNDO.
      708     DEFINE OUTPUT PARAMETER pc_key-value  AS CHARACTER NO-UNDO INITIAL ?.
      709     CASE pc_key-name:
      710       WHEN "obj-code" THEN
      711         pc_key-value = IF AVAILABLE gds-dtl THEN STRING(gds-dtl.obj-code) ELSE ?.
      712       WHEN "doc-code" THEN
      713         pc_key-value = IF AVAILABLE gds-dtl THEN STRING(gds-dtl.doc-code) ELSE ?.
      714         WHEN "":U THEN .
      715         OTHERWISE MESSAGE "Entry ":U pc_key-name
      716                           " was not found in the send-key cases in ":U
      717                           THIS-PROCEDURE:FILE-NAME
      718                         VIEW-AS ALERT-BOX ERROR.
      719     END CASE.
      720   END PROCEDURE.
      721   PROCEDURE send-records :
      722     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
      723     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
      724     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
      725     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
      726     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
      727     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
      728         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
      729         CASE ENTRY(i, p-tbl-list):
      730       WHEN "doc-line":U THEN p-rowid-list = p-rowid-list +
      731           IF AVAILABLE doc-line THEN STRING(ROWID(doc-line))
      732           ELSE "?":U.
      733       WHEN "gds-dtl":U THEN p-rowid-list = p-rowid-list +
      734           IF AVAILABLE gds-dtl THEN STRING(ROWID(gds-dtl))
      735           ELSE "?":U.
      736           OTHERWISE
      737           DO:
      738               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      739                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
      740               IF link-handle NE "":U THEN
      741               DO:
      742                   IF NUM-ENTRIES(link-handle) > 1 THEN
      743                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
      744                               "encountered more than one RECORD-SOURCE.":U SKIP
      745                               "The first will be used.":U
      746                               VIEW-AS ALERT-BOX ERROR.
      747                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
      748                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
      749                   p-rowid-list = p-rowid-list + rowid-string.
      750               END.
      751               ELSE
      752               DO:
      753                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
      754                           "does not match tables in send-records":U
      755                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
      756                           "Check that objects are linked properly and that":U
      757                           "database qualification is consistent.":U
      758                       VIEW-AS ALERT-BOX ERROR.
      759                   RETURN ERROR.
      760               END.
      761           END.
      762           END CASE.
      763       END.
      764   END PROCEDURE.
      765   PROCEDURE state-changed :
      766     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      767     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      768     CASE p-state:
      769       WHEN "update-begin":U THEN
      770       DO:
      771           adm-brs-in-update = yes.
      772           RUN dispatch ('enable-fields':U).
      773           IF RETURN-VALUE = "ADM-ERROR":U THEN
      774           DO:
      775             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      776             RUN new-state('update-complete':U).
      777           END.
      778           ELSE DO:
      779             RUN dispatch ('apply-entry':U).
      780             RUN new-state('update':U).
      781           END.
      782       END.
      783       WHEN "update":U THEN
      784         DO:
      785           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
      786           RUN get-link-handle IN adm-broker-hdl
      787               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
      788                   NO-ERROR.
      789           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
      790             br_table:SENSITIVE IN FRAME F-Main = no.
      791         END.
      792       WHEN "update-complete":U THEN DO:
      793           br_table:SENSITIVE IN FRAME F-Main = yes.
      794           adm-brs-in-update = no.
      795           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
      796           IF RETURN-VALUE NE "YES":U THEN
      797           DO:
      798             IF NUM-RESULTS("br_table":U) NE ? AND
      799                NUM-RESULTS("br_table":U) NE 0
      800             THEN DO:
      801               GET CURRENT br_table.
      802               RUN dispatch ('row-changed':U).
      803             END.
      804           END.
      805           RUN new-state ('update-complete':U).
      806       END.
      807       WHEN "delete-complete":U THEN DO:
      808          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
      809          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
      810          IF NUM-RESULTS("br_table":U) = 0 THEN
      811            RUN notify('row-available':U).
      812       END.
      813       WHEN   'first-record':U        OR
      814         WHEN 'last-record':U         OR
      815         WHEN 'only-record':U         OR
      816         WHEN 'not-first-or-last':U   OR
      817         WHEN 'no-record-available':U OR
      818         WHEN 'no-external-record-available':U THEN
      819           RUN set-attribute-list('Query-Position=':U + p-state).
      820     END CASE.
      821   END PROCEDURE.
