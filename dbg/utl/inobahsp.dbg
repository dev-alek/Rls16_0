     2681       end.
     2682       find first buf_gds-obj no-lock
     2683         where buf_gds-obj.gds-code = buf_goods.gds-code
     2684           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     2685           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     2686         no-error .
     2687         if not available buf_gds-obj then do:
     2688   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2690     (input  buf_main_price-list.obj-type
     2691     ,input  buf_main_price-list.obj-code
     2692     ,input  buf_goods.artic
     2693     ,input  buf_goods.prod-type
     2694     ,input  buf_goods.prod-code
     2695     ,buffer buf_gds-obj
     2696     ) no-error .
     2697           if error-status :error then do:
     2698              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2699           end.
     2700         end.
     2701       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2702       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2703       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2704       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2705       define variable vat-base-sale-prl               as decimal   no-undo .
     2706       define variable vat-rubl-sale-prl               as decimal   no-undo .
     2707       define variable vat-base-buyer-prl              as decimal   no-undo .
     2708       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2709       define variable slt-base-sale-prl               as decimal   no-undo .
     2710       define variable slt-rubl-sale-prl               as decimal   no-undo .
     2711       define variable road-tax-base-sale-prl          as decimal   no-undo .
     2712       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2713       define variable excise-base-sale-prl            as decimal   no-undo .
     2714       define variable excise-rubl-sale-prl            as decimal   no-undo .
     2715       define variable discnt-base-sale-prl            as decimal   no-undo .
     2716       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2717       if buf_main_price-list.doc-qnty <> 0
     2718       then do:
     2719         run prl-vat in this-procedure
     2720           (input  recid(buf_main_price-list)
     2721           ,output price-rubl-with-tax-sale-prl
     2722           ,output price-base-with-tax-sale-prl
     2723           ,output price-rubl-without-tax-sale-prl
     2724           ,output price-base-without-tax-sale-prl
     2725           ,output vat-base-sale-prl
     2726           ,output vat-rubl-sale-prl
     2727           ,output vat-base-buyer-prl
     2728           ,output vat-rubl-buyer-prl
     2729           ,output slt-base-sale-prl
     2730           ,output slt-rubl-sale-prl
     2731           ,output road-tax-base-sale-prl
     2732           ,output road-tax-rubl-sale-prl
     2733           ,output excise-base-sale-prl
     2734           ,output excise-rubl-sale-prl
     2735           ,output discnt-base-sale-prl
     2736           ,output discnt-rubl-sale-prl
     2737           ) no-error .
     2738         if error-status :error
     2739         then do:
     2740           message
     2741             vss-workfile vss-revision vss-description skip
     2742             vss-include-info9 skip
     2743             "Ошибка при вызове процеды prl-vat" skip
     2744             "Документ" buf_main_price-list.doc-num skip
     2745             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2746             error-status :get-message(1) skip
     2747             return-value skip
     2748             view-as alert-box error .
     2749           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2750         end.
     2751       end.
     2752       else do:
     2753         assign
     2754           price-rubl-with-tax-sale-prl    = 0
     2755           price-base-with-tax-sale-prl    = 0
     2756           price-rubl-without-tax-sale-prl = 0
     2757           price-base-without-tax-sale-prl = 0
     2758           vat-base-sale-prl               = 0
     2759           vat-rubl-sale-prl               = 0
     2760           vat-base-buyer-prl              = 0
     2761           vat-rubl-buyer-prl              = 0
     2762           slt-base-sale-prl               = 0
     2763           slt-rubl-sale-prl               = 0
     2764           road-tax-base-sale-prl          = 0
     2765           road-tax-rubl-sale-prl          = 0
     2766           excise-base-sale-prl            = 0
     2767           excise-rubl-sale-prl            = 0
     2768           discnt-base-sale-prl            = 0
     2769           discnt-rubl-sale-prl            = 0
     2770         .
     2771       end.
     2772       define variable v-curr-r-b as character no-undo .
     2773   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2774   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2775     (output v-curr-r-b
     2776     )  .
     2777       if v-curr-r-b = 'base':U
     2778       then do:
     2779         assign
     2780           p-fact-qnty         = buf_main_price-list.doc-qnty
     2781           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     2782           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     2783           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     2784           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     2785           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     2786         .
     2787       end.
     2788       else do:
     2789         assign
     2790           p-fact-qnty         = buf_main_price-list.doc-qnty
     2791           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     2792           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     2793           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     2794           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     2795           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     2796         .
     2797       end.
     2798         define variable v-unit-base like ub.goods.unit-base no-undo .
     2799   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2801     (input  buf_goods.gds-code
     2802     ,output v-unit-base
     2803     ) no-error .
     2804         if error-status :error
     2805         then do:
     2806           message
     2807             vss-workfile vss-revision vss-description skip
     2808             vss-include-info9 skip
     2809             "Ошибка при определении базовой единицы измерения товара" skip
     2810             "Код товара" buf_goods.gds-code skip
     2811             error-status :get-message(1) skip
     2812             return-value skip
     2813             view-as alert-box error .
     2814           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2815         end.
     2816         for each buf_price-list no-lock
     2817           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     2818             and buf_price-list.main-price = false
     2819             and buf_price-list.artic      = buf_main_price-list.artic
     2820             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     2821             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     2822         :
     2823           if buf_price-list.doc-qnty = ?
     2824           then do:
     2825             find first buf_bar-code no-lock
     2826               where buf_bar-code.b-code = buf_price-list.b-code
     2827               no-error .
     2828             if available buf_bar-code
     2829             and buf_bar-code.unit-cli = v-unit-base
     2830             then do:
     2831               message
     2832                 vss-workfile vss-revision vss-description skip
     2833                 vss-include-info9 skip
     2834                 "Ошибка при закрытии переоценки" skip
     2835                 "Не задано количество для бар-кода с основной единицей измерения" skip
     2836                 "Переоценка" buf_main_price-list.doc-num skip
     2837                 "Бар-код" buf_price-list.b-code skip
     2838                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2839                 "Количество" buf_price-list.doc-qnty skip
     2840                 "Основная единица измерения" v-unit-base skip
     2841                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     2842                 view-as alert-box error .
     2843               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2844             end.
     2845             next .
     2846           end.
     2847           if not can-find
     2848             (first buf_bar-code
     2849             where buf_bar-code.b-code = buf_price-list.b-code
     2850             )
     2851           then do:
     2852             message
     2853               vss-workfile vss-revision vss-description skip
     2854               vss-include-info9 skip
     2855               "В переоценке задан несуществующий бар-код" skip
     2856               "Переоценка" buf_price-list.doc-num skip
     2857               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2858               "Бар-код" buf_price-list.b-code skip
     2859               view-as alert-box error .
     2860             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2861           end.
     2862           if buf_price-list.doc-qnty <> 0
     2863           then do:
     2864             run prl-vat in this-procedure
     2865               (input  recid(buf_price-list)
     2866               ,output price-rubl-with-tax-sale-prl
     2867               ,output price-base-with-tax-sale-prl
     2868               ,output price-rubl-without-tax-sale-prl
     2869               ,output price-base-without-tax-sale-prl
     2870               ,output vat-base-sale-prl
     2871               ,output vat-rubl-sale-prl
     2872               ,output vat-base-buyer-prl
     2873               ,output vat-rubl-buyer-prl
     2874               ,output slt-base-sale-prl
     2875               ,output slt-rubl-sale-prl
     2876               ,output road-tax-base-sale-prl
     2877               ,output road-tax-rubl-sale-prl
     2878               ,output excise-base-sale-prl
     2879               ,output excise-rubl-sale-prl
     2880               ,output discnt-base-sale-prl
     2881               ,output discnt-rubl-sale-prl
     2882               ) no-error .
     2883             if error-status :error
     2884             then do:
     2885               message
     2886                 vss-workfile vss-revision vss-description skip
     2887                 vss-include-info9 skip
     2888                 "Ошибка при вызове процеды prl-vat" skip
     2889                 "Документ" buf_price-list.doc-num skip
     2890                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2891                 error-status :get-message(1) skip
     2892                 return-value skip
     2893                 view-as alert-box error .
     2894               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2895             end.
     2896           end.
     2897           else do:
     2898             assign
     2899               price-rubl-with-tax-sale-prl    = 0
     2900               price-base-with-tax-sale-prl    = 0
     2901               price-rubl-without-tax-sale-prl = 0
     2902               price-base-without-tax-sale-prl = 0
     2903               vat-base-sale-prl               = 0
     2904               vat-rubl-sale-prl               = 0
     2905               vat-base-buyer-prl              = 0
     2906               vat-rubl-buyer-prl              = 0
     2907               slt-base-sale-prl               = 0
     2908               slt-rubl-sale-prl               = 0
     2909               road-tax-base-sale-prl          = 0
     2910               road-tax-rubl-sale-prl          = 0
     2911               excise-base-sale-prl            = 0
     2912               excise-rubl-sale-prl            = 0
     2913               discnt-base-sale-prl            = 0
     2914               discnt-rubl-sale-prl            = 0
     2915             .
     2916           end.
     2917           if v-curr-r-b = 'base':U
     2918           then do:
     2919             assign
     2920               p-fact-qnty         = p-fact-qnty
     2921                                   + buf_price-list.doc-qnty
     2922               p-cur-base          = p-cur-base
     2923                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     2924               p-cur-VAT-base      = p-cur-VAT-base
     2925                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     2926               p-cur-SLT-base      = p-cur-SLT-base
     2927                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     2928               p-cur-road-tax-base = p-cur-road-tax-base
     2929                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     2930               p-cur-excise-base   = p-cur-excise-base
     2931                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     2932             .
     2933           end.
     2934           else do:
     2935             assign
     2936               p-fact-qnty         = p-fact-qnty
     2937                                   + buf_price-list.doc-qnty
     2938               p-cur-base          = p-cur-base
     2939                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     2940               p-cur-VAT-base      = p-cur-VAT-base
     2941                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     2942               p-cur-SLT-base      = p-cur-SLT-base
     2943                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     2944               p-cur-road-tax-base = p-cur-road-tax-base
     2945                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     2946               p-cur-excise-base   = p-cur-excise-base
     2947                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     2948             .
     2949           end.
     2950         end.
     2951     end.
     2952   end procedure.
     2953   procedure prdoclib-calc-prc :
     2954     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2955     define input  parameter p-cons-pay        as   integer                no-undo.
     2956     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2957     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2958     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2959     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2960     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2961     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2962     do
     2963     on error undo, return error return-value
     2964     :
     2965       define buffer buf_price-doc       for ub.price-doc .
     2966       define buffer buf_price-list      for ub.price-list .
     2967       define buffer buf_parts           for ub.parts .
     2968       define variable v-ov-qnty     as decimal   no-undo .
     2969       define variable v-ov-base     as decimal   no-undo .
     2970       define variable v-ov-VAT-base as decimal   no-undo .
     2971       define variable v-ov-SLT-base as decimal   no-undo .
     2972       define variable v-cons-qnty   as decimal   no-undo .
     2973       define variable v-prch-qnty   as decimal   no-undo .
     2974       define variable v-cons-mult   as decimal   no-undo .
     2975       define variable v-prch-mult   as decimal   no-undo .
     2976       find first buf_price-doc no-lock
     2977         where recid(buf_price-doc) = p-price-doc-recid
     2978         no-error .
     2979       if not available buf_price-doc
     2980       then do:
     2981         message
     2982           vss-workfile vss-revision vss-description skip
     2983           vss-include-info9 skip
     2984           "Ошибка задания входных параметров" skip
     2985           "Не найден документ переоценки" skip
     2986           "Код записи (recid)" p-price-doc-recid skip
     2987           view-as alert-box error .
     2988         undo, return error .
     2989       end.
     2990       for each buf_price-list no-lock
     2991         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2992           and buf_price-list.main-price = true
     2993       on error undo, return error return-value
     2994       :
     2995         run prdoclib-calc-ov
     2996           (input recid(buf_price-list)
     2997           ,output v-ov-qnty
     2998           ,output v-ov-base
     2999           ,output v-ov-VAT-base
     3000           ,output v-ov-SLT-base
     3001           ) no-error .
     3002         if error-status :error
     3003         then do:
     3004           if error-status :get-message(1) <> ""
     3005           then do:
     3006             message
     3007               vss-workfile vss-revision vss-description skip
     3008               vss-include-info9 skip
     3009               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     3010               error-status :get-message(1) skip
     3011               return-value skip
     3012               view-as alert-box error .
     3013           end.
     3014           undo, return error return-value .
     3015         end.
     3016         assign
     3017           v-cons-qnty = 0
     3018           v-prch-qnty = 0
     3019         .
     3020         for each buf_parts no-lock
     3021           where buf_parts.out-code  = buf_price-list.doc-num
     3022             and buf_parts.obj-type  = buf_price-list.obj-type
     3023             and buf_parts.obj-code  = buf_price-list.obj-code
     3024             and buf_parts.artic     = buf_price-list.artic
     3025             and buf_parts.prod-type = buf_price-list.prod-type
     3026             and buf_parts.prod-code = buf_price-list.prod-code
     3027         on error undo, return error return-value
     3028         :
     3029           if buf_parts.pay-code = p-cons-pay
     3030           then do:
     3031             assign
     3032               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     3033             .
     3034           end.
     3035           else do:
     3036             assign
     3037               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     3038             .
     3039           end.
     3040         end.
     3041         if (v-cons-qnty + v-prch-qnty) = 0
     3042         then do:
     3043           assign
     3044             v-cons-mult = 0
     3045             v-prch-mult = 1
     3046           .
     3047         end.
     3048         else do:
     3049           assign
     3050             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     3051             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     3052           .
     3053         end.
     3054         assign
     3055           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     3056           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     3057           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     3058           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     3059           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     3060           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     3061         .
     3062       end.
     3063     end.
     3064   end procedure.
     3065   procedure prdoclib-calc-ov :
     3066     define input  parameter p-price-list-recid as recid     no-undo .
     3067     define output parameter p-fact-qnty        as decimal   no-undo .
     3068     define output parameter p-ov-base          as decimal   no-undo .
     3069     define output parameter p-ov-VAT-base      as decimal   no-undo .
     3070     define output parameter p-ov-SLT-base      as decimal   no-undo .
     3071     do
     3072     on error undo, return error return-value
     3073     :
     3074       define buffer buf_main_price-list    for ub.price-list .
     3075       define buffer buf_prev_price-list    for ub.price-list .
     3076       define buffer buf_special_price-list for ub.price-list .
     3077       define buffer buf_goods              for ub.goods .
     3078       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     3079       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     3080       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     3081       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     3082       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     3083       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     3084       define variable v-prev-price-list-recid as   recid                  no-undo.
     3085       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     3086       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     3087       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     3088       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     3089       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     3090       find first buf_main_price-list no-lock
     3091         where recid(buf_main_price-list) = p-price-list-recid
     3092         no-error .
     3093       if not available buf_main_price-list
     3094       then do:
     3095         message
     3096           vss-workfile vss-revision vss-description skip
     3097           vss-include-info9 skip
     3098           "Ошибка задания входных параметров" skip
     3099           "Не найдена строка переоценки" skip
     3100           "Код записи (recid)" p-price-list-recid skip
     3101           view-as alert-box error .
     3102         undo, return error .
     3103       end.
     3104       if buf_main_price-list.main-price <> true
     3105       then do:
     3106         message
     3107           vss-workfile vss-revision vss-description skip
     3108           vss-include-info9 skip
     3109           "Ошибка задания входных параметров" skip
     3110           "Строка переоценки не является основной" skip
     3111           "Код записи (recid)" p-price-list-recid skip
     3112           "Переоценка" buf_main_price-list.doc-num skip
     3113           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3114           "Бар-код" buf_main_price-list.b-code skip
     3115           view-as alert-box error .
     3116         undo, return error .
     3117       end.
     3118       run prdoclib-calc-fact-sale in this-procedure
     3119         (input  recid(buf_main_price-list)
     3120         ,output v-fact-qnty
     3121         ,output v-cur-base
     3122         ,output v-cur-VAT-base
     3123         ,output v-cur-SLT-base
     3124         ,output v-cur-road-tax-base
     3125         ,output v-cur-excise-base
     3126         ) no-error.
     3127       if error-status :error
     3128       then do:
     3129         message
     3130           vss-workfile vss-revision vss-description skip
     3131           vss-include-info9 skip
     3132           "Ошибка при расчете сумм переоценки." skip
     3133           "Документ переоценки" buf_main_price-list.doc-num skip
     3134           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3135           error-status :get-message(1) skip
     3136           return-value skip
     3137           view-as alert-box error .
     3138         undo, return error .
     3139       end.
     3140   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3141   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3142     (input  buf_main_price-list.obj-type
     3143     ,input  buf_main_price-list.obj-code
     3144     ,input  buf_main_price-list.b-code
     3145     ,input  buf_main_price-list.b-code
     3146     ,input  buf_main_price-list.fact-order
     3147     ,output v-prev-price-list-recid
     3148     ,output v-prev-cli-base-rate
     3149     ) no-error .
     3150       if error-status :error
     3151       then do:
     3152         message
     3153           vss-workfile vss-revision vss-description skip
     3154           vss-include-info9 skip
     3155           "Ошибка при поиске предыдущей переоценки." skip
     3156           "Документ переоценки " buf_main_price-list.doc-num skip
     3157           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3158           error-status :get-message(1) skip
     3159           return-value skip
     3160           view-as alert-box error .
     3161         undo, return error .
     3162       end.
     3163       if v-prev-price-list-recid <> ?
     3164       then do:
     3165         find first buf_prev_price-list no-lock
     3166           where recid(buf_prev_price-list) = v-prev-price-list-recid
     3167           .
     3168         find first buf_special_price-list no-lock
     3169           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     3170             and buf_special_price-list.main-price = false
     3171             and buf_special_price-list.artic      = buf_prev_price-list.artic
     3172             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     3173             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     3174             and buf_special_price-list.doc-qnty   <> ?
     3175           no-error .
     3176         if available buf_special_price-list
     3177         then do:
     3178           message
     3179             "Товар имеет специальные цены на признаки" skip
     3180             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3181             "Переоценка" buf_prev_price-list.doc-num skip
     3182             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3183             view-as alert-box error .
     3184           undo, return error .
     3185         end.
     3186         find first buf_goods no-lock
     3187           where buf_goods.artic     = buf_main_price-list.artic
     3188             and buf_goods.prod-type = buf_main_price-list.prod-type
     3189             and buf_goods.prod-code = buf_main_price-list.prod-code
     3190           no-error .
     3191         if not available buf_goods
     3192         then do:
     3193           message
     3194             vss-workfile vss-revision vss-description skip
     3195             vss-include-info9 skip
     3196             "Не найден товар" skip
     3197             "Переоценка" buf_main_price-list.doc-num skip
     3198             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3199             view-as alert-box error .
     3200           undo, return error .
     3201         end.
     3202         if buf_prev_price-list.vat-pc = ?
     3203         or buf_prev_price-list.slt-pc = ?
     3204         then do:
     3205           message
     3206             "В переоценке не заданы налоги товара" skip
     3207             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3208             "Переоценка" buf_prev_price-list.doc-num skip
     3209             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3210             "НДС" buf_prev_price-list.vat-pc skip
     3211             "НП" buf_prev_price-list.slt-pc skip
     3212             view-as alert-box error .
     3213           undo, return error return-value .
     3214         end.
     3215         define variable v-prev-cur-SLT-pc as decimal no-undo .
     3216         assign
     3217           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     3218         .
     3219         assign
     3220           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     3221           v-prev-cur-VAT-base = v-fact-qnty
     3222                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     3223                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     3224           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     3225         .
     3226         assign
     3227           p-fact-qnty   = v-fact-qnty
     3228           p-ov-base     = v-cur-base     - v-prev-cur-base
     3229           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3230           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3231         .
     3232       end.
     3233       else do:
     3234         assign
     3235           v-prev-cur-base     = 0
     3236           v-prev-cur-VAT-base = 0
     3237           v-prev-cur-SLT-base = 0
     3238           .
     3239         assign
     3240           p-fact-qnty   = v-fact-qnty
     3241           p-ov-base     = v-cur-base     - v-prev-cur-base
     3242           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3243           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3244         .
     3245       end.
     3246     end.
     3247   end procedure.
     3248   procedure prdoclib-init-prt-obj-by-factord :
     3249     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3250     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3251     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3252     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3253     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3254     define input parameter p-fact-order         as decimal   no-undo .
     3255     define input parameter p-include-fact-order as logical   no-undo .
     3256     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3257     define buffer buf_gds-obj      for ub.gds-obj .
     3258     define buffer buf_doc-line     for ub.doc-line .
     3259     define buffer buf_temp-prt-obj for temp-prt-obj .
     3260     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3261     do
     3262     on error undo, return error return-value
     3263     :
     3264       do transaction
     3265       on error undo, return error return-value
     3266       :
     3267   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3268   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3269     (input  p-obj-type
     3270     ,input  p-obj-code
     3271     ,input  p-artic
     3272     ,input  p-prod-type
     3273     ,input  p-prod-code
     3274     ,buffer buf_gds-obj
     3275     ) no-error .
     3276         if error-status :error
     3277         then do:
     3278           message
     3279             vss-workfile vss-revision vss-description skip
     3280             vss-include-info9 skip
     3281             "Невозможно найти gds-obj" skip
     3282             error-status :get-message(1) skip
     3283             return-value skip
     3284             view-as alert-box error .
     3285           undo, return error .
     3286         end.
     3287         find current buf_gds-obj exclusive-lock .
     3288       end.
     3289       run prdoclib-init-temp-prt-obj in this-procedure
     3290         (input p-obj-type
     3291         ,input p-obj-code
     3292         ,input p-artic
     3293         ,input p-prod-type
     3294         ,input p-prod-code
     3295         ,input 0
     3296         ) .
     3297       for each buf_temp-prt-obj
     3298         where buf_temp-prt-obj.is-term <> true
     3299       on error undo, return error return-value
     3300       :
     3301         delete buf_temp-prt-obj .
     3302       end.
     3303       if p-include-fact-order = true
     3304       then do:
     3305         assign
     3306          p-fact-order = p-fact-order - 0.0000000001
     3307         .
     3308       end.
     3309       for each buf_doc-line no-lock
     3310         where buf_doc-line.obj-type   = p-obj-type
     3311           and buf_doc-line.obj-code   = p-obj-code
     3312           and buf_doc-line.artic      = p-artic
     3313           and buf_doc-line.prod-type  = p-prod-type
     3314           and buf_doc-line.prod-code  = p-prod-code
     3315           and buf_doc-line.status_    = 'факт':U
     3316           and buf_doc-line.fact-order >= p-fact-order
     3317       on error undo, return error return-value
     3318       :
     3319         run prdoclib-process-document in this-procedure
     3320           (input  buf_doc-line.doc-code
     3321           ,input  p-obj-type
     3322           ,input  p-obj-code
     3323           ,input  p-artic
     3324           ,input  p-prod-type
     3325           ,input  p-prod-code
     3326           ,output v-total-gds-dtl-qnty
     3327           ) .
     3328       end.
     3329     end.
     3330   end procedure.
     3331   procedure prdoclib-process-document :
     3332     define input  parameter p-doc-code           as character no-undo .
     3333     define input  parameter p-obj-type           as character no-undo .
     3334     define input  parameter p-obj-code           as integer   no-undo .
     3335     define input  parameter p-artic              as character no-undo .
     3336     define input  parameter p-prod-type          as character no-undo .
     3337     define input  parameter p-prod-code          as integer   no-undo .
     3338     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3339     define buffer buf_trn-doc      for ub.trn-doc .
     3340     define buffer buf_gds-dtl      for ub.gds-dtl .
     3341     define buffer buf_temp-prt-obj for temp-prt-obj .
     3342     do
     3343     on error undo, return error return-value
     3344     :
     3345       find first buf_trn-doc no-lock
     3346         where buf_trn-doc.doc-code = p-doc-code
     3347         no-error .
     3348       if not available buf_trn-doc then do:
     3349         message
     3350           vss-workfile vss-revision vss-description skip
     3351           vss-include-info9 skip
     3352           "Ошибка при поиске документа" skip
     3353           "Документ" p-doc-code skip
     3354           "Объект" p-obj-type p-obj-code skip
     3355           "Артикул" p-artic p-prod-type p-prod-code skip
     3356           view-as alert-box error .
     3357         undo, return error .
     3358       end.
     3359       assign
     3360         p-total-gds-dtl-qnty = 0
     3361       .
     3362       for each buf_gds-dtl no-lock
     3363         where buf_gds-dtl.doc-code  = p-doc-code
     3364           and buf_gds-dtl.artic     = p-artic
     3365           and buf_gds-dtl.prod-type = p-prod-type
     3366           and buf_gds-dtl.prod-code = p-prod-code
     3367       on error undo, return error
     3368       :
     3369         define variable v-term-node as integer   no-undo .
     3370   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3371     (input  buf_gds-dtl.prt-code
     3372     ,output v-term-node
     3373     )  .
     3374         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3375           (input  v-term-node
     3376           ,buffer buf_temp-prt-obj
     3377           ) .
     3378         if buf_temp-prt-obj.is-term <> true then do:
     3379           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3380                                        ,buf_gds-dtl.prt-code
     3381                                        ) .
     3382         end.
     3383         case buf_trn-doc.doc-type :
     3384           when 'при':U or
     3385           when 'возврат':U
     3386           then do:
     3387             assign
     3388               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3389                                           - buf_gds-dtl.fact-qnty
     3390               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3391                                           - buf_gds-dtl.fact-qnty
     3392             .
     3393           end.
     3394           when 'рас':U or
     3395           when 'спи':U
     3396           then do:
     3397             assign
     3398               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3399                                           + buf_gds-dtl.fact-qnty
     3400               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3401                                           + buf_gds-dtl.fact-qnty
     3402             .
     3403           end.
     3404           when 'инв':U
     3405           then do:
     3406             assign
     3407               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3408                                           - buf_gds-dtl.doc-qnty
     3409               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3410                                           - buf_gds-dtl.doc-qnty
     3411             .
     3412           end.
     3413           otherwise do:
     3414             undo, return error substitute("Неизвестный тип документа &1"
     3415                                          ,buf_trn-doc.doc-type
     3416                                          ) .
     3417           end.
     3418         end.
     3419       end.
     3420     end.
     3421   end procedure.
     3422   procedure prdoclib-prc-pl-document :
     3423     define input  parameter p-doc-code              as character no-undo .
     3424     define input  parameter p-obj-type              as character no-undo .
     3425     define input  parameter p-obj-code              as integer   no-undo .
     3426     define input  parameter p-gds-code              as integer   no-undo .
     3427     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3428     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3429     do
     3430     on error undo, return error return-value
     3431     :
     3432       define buffer buf_trn-doc      for ub.trn-doc .
     3433       define buffer buf_doc-pl       for ub.doc-pl .
     3434       define buffer buf_temp-pl-gds for temp-pl-gds .
     3435       define variable v-sign as decimal   no-undo .
     3436       find first buf_trn-doc no-lock
     3437         where buf_trn-doc.doc-code = p-doc-code
     3438         no-error .
     3439       if not available buf_trn-doc then do:
     3440         message
     3441           vss-workfile vss-revision vss-description skip
     3442           vss-include-info9 skip
     3443           "Ошибка при поиске документа" skip
     3444           "Документ" p-doc-code skip
     3445           "Объект" p-obj-type p-obj-code skip
     3446           "Товар" p-gds-code skip
     3447           view-as alert-box error .
     3448         undo, return error .
     3449       end.
     3450       assign
     3451         p-total-pl-gds-qnty     = 0
     3452         p-total-pl-gds-cli-qnty = 0
     3453       .
     3454       for each buf_doc-pl no-lock
     3455         where buf_doc-pl.out-code  = p-doc-code
     3456           and buf_doc-pl.gds-code  = p-gds-code
     3457       on error undo, return error return-value
     3458       :
     3459         find first buf_temp-pl-gds
     3460           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3461             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3462             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3463           .
     3464         case buf_trn-doc.doc-type :
     3465           when 'при':U
     3466           or when 'возврат':U
     3467           or when 'инв':U
     3468           then do:
     3469             assign
     3470               v-sign = -1.0
     3471             .
     3472           end.
     3473           when 'рас':U or
     3474           when 'спи':U
     3475           then do:
     3476             assign
     3477               v-sign = 1.0
     3478             .
     3479           end.
     3480           otherwise do:
     3481             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3482           end.
     3483         end case.
     3484         assign
     3485           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3486           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3487           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3488           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3489         .
     3490       end.
     3491     end.
     3492   end procedure.
     3493   procedure prdoclib-init-prt-obj-by-date :
     3494     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3495     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3496     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3497     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3498     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3499     define input parameter p-fact-date  as date      no-undo .
     3500     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3501     do
     3502     on error undo, return error return-value
     3503     :
     3504       define variable v-fact-order                as decimal   no-undo .
     3505       define variable v-shift-end-fact-order      as decimal   no-undo .
     3506       define variable v-day-end-fact-order        as decimal   no-undo .
     3507       run factord in this-procedure
     3508         (input  p-fact-date
     3509         ,input  1
     3510         ,input  1
     3511         ,input  ?
     3512         ,input  0
     3513         ,input  false
     3514         ,output v-fact-order
     3515         ,output v-shift-end-fact-order
     3516         ,output v-day-end-fact-order
     3517         ) no-error .
     3518       if error-status :error
     3519       then do:
     3520         message
     3521           vss-workfile vss-revision vss-description skip
     3522           vss-include-info9 skip
     3523           "Ошибка при определении момента времени, на который требуется остаток" skip
     3524           "Объект" p-obj-type p-obj-code skip
     3525           "Артикул" p-artic p-prod-type p-prod-code skip
     3526           "Дата" p-fact-date skip
     3527           view-as alert-box error .
     3528         undo, return error .
     3529       end.
     3530       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3531         (input p-obj-type
     3532         ,input p-obj-code
     3533         ,input p-artic
     3534         ,input p-prod-type
     3535         ,input p-prod-code
     3536         ,input v-day-end-fact-order
     3537         ,input false
     3538         ) no-error .
     3539       if error-status :error
     3540       then do:
     3541         message
     3542           vss-workfile vss-revision vss-description skip
     3543           vss-include-info9 skip
     3544           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3545           "Объект" p-obj-type p-obj-code skip
     3546           "Артикул" p-artic p-prod-type p-prod-code skip
     3547           "Дата" p-fact-date skip
     3548           view-as alert-box error .
     3549         undo, return error .
     3550       end.
     3551     end.
     3552   end procedure.
     3553   procedure prdoclib-calc-temp-fact-sale :
     3554     define input  parameter p-obj-type           as character no-undo .
     3555     define input  parameter p-obj-code           as integer   no-undo .
     3556     define input  parameter p-gds-code           as integer   no-undo .
     3557     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3558     define input  parameter p-curr-r-b           as character no-undo .
     3559     define output parameter p-fact-qnty          as decimal   no-undo .
     3560     define output parameter p-cur-base           as decimal   no-undo .
     3561     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3562     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3563     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3564     define output parameter p-cur-excise-base    as decimal   no-undo .
     3565     define buffer buf_temp-prt-obj for temp-prt-obj .
     3566     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3567     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3568     define variable parrecid-prl        as recid     no-undo .
     3569     define variable v-fact-qnty         as decimal   no-undo .
     3570     define variable v-cur-base          as decimal   no-undo .
     3571     define variable v-cur-VAT-base      as decimal   no-undo .
     3572     define variable v-cur-SLT-base      as decimal   no-undo .
     3573     define variable v-cur-road-tax-base as decimal   no-undo .
     3574     define variable v-cur-excise-base   as decimal   no-undo .
     3575     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3576     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3577     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3578     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3579     define variable vat-base-sale-prl               as decimal   no-undo .
     3580     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3581     define variable vat-base-buyer-prl              as decimal   no-undo .
     3582     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3583     define variable slt-base-sale-prl               as decimal   no-undo .
     3584     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3585     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3586     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3587     define variable excise-base-sale-prl            as decimal   no-undo .
     3588     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3589     define variable discnt-base-sale-prl            as decimal   no-undo .
     3590     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3591     do
     3592     on error undo, return error return-value
     3593     :
     3594       for each buf_temp-prt-obj no-lock
     3595       on error undo, return error return-value
     3596       :
     3597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3598     (input  p-gds-code
     3599     ,input  buf_temp-prt-obj.prt-code
     3600     ,output v-prt-b-code
     3601     ) no-error .
     3602         if error-status :error
     3603         then do:
     3604           message
     3605             vss-workfile vss-revision vss-description skip
     3606             "Ошибка при определении бар-кода признака" skip
     3607             "Код товара"   p-gds-code skip
     3608             "Код признака" buf_temp-prt-obj.prt-code skip
     3609             error-status :get-message(1) skip
     3610             return-value skip
     3611             view-as alert-box error .
     3612           undo, return error .
     3613         end.
     3614   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3615   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3616     (input  p-obj-type
     3617     ,input  p-obj-code
     3618     ,input  v-prt-b-code
     3619     ,input  0
     3620     ,input  p-day-end-fact-order
     3621     ,output parrecid-prl
     3622     ,output v-cli-base-rate
     3623     ) no-error .
     3624         if error-status :error
     3625         then do:
     3626           message
     3627             vss-workfile vss-revision vss-description skip
     3628             "Ошибка при определении цены бар-кода" skip
     3629             "Объект" p-obj-type p-obj-code skip
     3630             "Бар-код" v-prt-b-code skip
     3631             "fact-order" p-day-end-fact-order skip
     3632             error-status :get-message(1) skip
     3633             return-value skip
     3634             view-as alert-box error .
     3635           undo, return error .
     3636         end.
     3637         if parrecid-prl <> ?
     3638         then do:
     3639           run prl-vat in this-procedure
     3640             (input  parrecid-prl
     3641             ,output price-rubl-with-tax-sale-prl
     3642             ,output price-base-with-tax-sale-prl
     3643             ,output price-rubl-without-tax-sale-prl
     3644             ,output price-base-without-tax-sale-prl
     3645             ,output vat-base-sale-prl
     3646             ,output vat-rubl-sale-prl
     3647             ,output vat-base-buyer-prl
     3648             ,output vat-rubl-buyer-prl
     3649             ,output slt-base-sale-prl
     3650             ,output slt-rubl-sale-prl
     3651             ,output road-tax-base-sale-prl
     3652             ,output road-tax-rubl-sale-prl
     3653             ,output excise-base-sale-prl
     3654             ,output excise-rubl-sale-prl
     3655             ,output discnt-base-sale-prl
     3656             ,output discnt-rubl-sale-prl
     3657             ) no-error .
     3658           if error-status :error
     3659           then do:
     3660             message
     3661               vss-workfile vss-revision vss-description skip
     3662               "Ошибка при вызове процеды prl-vat" skip
     3663               "Объект" p-obj-type p-obj-code skip
     3664               "Код товара" p-gds-code skip
     3665               "Указатель на запись переоценки" parrecid-prl skip
     3666               error-status :get-message(1) skip
     3667               return-value skip
     3668               view-as alert-box error .
     3669             undo, return error .
     3670           end.
     3671         end.
     3672         else do:
     3673           assign
     3674             price-rubl-with-tax-sale-prl    = 0
     3675             price-base-with-tax-sale-prl    = 0
     3676             price-rubl-without-tax-sale-prl = 0
     3677             price-base-without-tax-sale-prl = 0
     3678             vat-base-sale-prl               = 0
     3679             vat-rubl-sale-prl               = 0
     3680             slt-base-sale-prl               = 0
     3681             slt-rubl-sale-prl               = 0
     3682             road-tax-base-sale-prl          = 0
     3683             road-tax-rubl-sale-prl          = 0
     3684             excise-base-sale-prl            = 0
     3685             excise-rubl-sale-prl            = 0
     3686             discnt-base-sale-prl            = 0
     3687             discnt-rubl-sale-prl            = 0
     3688           .
     3689         end.
     3690         assign
     3691           v-fact-qnty         = v-fact-qnty
     3692                               + buf_temp-prt-obj.fact-qnty
     3693           v-cur-base          = v-cur-base
     3694                               + (if p-curr-r-b = 'base':U
     3695                                   then price-base-with-tax-sale-prl
     3696                                   else price-rubl-with-tax-sale-prl
     3697                                 )
     3698                               * buf_temp-prt-obj.fact-qnty
     3699           v-cur-VAT-base      = v-cur-VAT-base
     3700                               + (if p-curr-r-b = 'base':U
     3701                                   then vat-base-sale-prl
     3702                                   else vat-rubl-sale-prl
     3703                                 )
     3704                               * buf_temp-prt-obj.fact-qnty
     3705           v-cur-SLT-base      = v-cur-SLT-base
     3706                               + (if p-curr-r-b = 'base':U
     3707                                   then slt-base-sale-prl
     3708                                   else slt-rubl-sale-prl
     3709                                 )
     3710                               * buf_temp-prt-obj.fact-qnty
     3711           v-cur-road-tax-base = v-cur-road-tax-base
     3712                               + (if p-curr-r-b = 'base':U
     3713                                   then road-tax-base-sale-prl
     3714                                   else road-tax-rubl-sale-prl
     3715                                 )
     3716                               * buf_temp-prt-obj.fact-qnty
     3717           v-cur-excise-base   = v-cur-excise-base
     3718                               + (if p-curr-r-b = 'base':U
     3719                                   then excise-base-sale-prl
     3720                                   else excise-rubl-sale-prl
     3721                                 )
     3722                               * buf_temp-prt-obj.fact-qnty
     3723         .
     3724       end.
     3725       assign
     3726         p-fact-qnty         = v-fact-qnty
     3727         p-cur-base          = v-cur-base
     3728         p-cur-VAT-base      = v-cur-VAT-base
     3729         p-cur-SLT-base      = v-cur-SLT-base
     3730         p-cur-road-tax-base = v-cur-road-tax-base
     3731         p-cur-excise-base   = v-cur-excise-base
     3732       .
     3733     end.
     3734   end procedure.
     3735   procedure prdoclib-clear-temp-pl-gds :
     3736     define buffer buf_temp-pl-gds for temp-pl-gds .
     3737     do
     3738     on error undo, return error return-value
     3739     :
     3740       for each buf_temp-pl-gds
     3741       on error undo, return error return-value
     3742       :
     3743         delete buf_temp-pl-gds .
     3744       end.
     3745     end.
     3746   end procedure.
     3747   procedure prdoclib-init-temp-pl-gds :
     3748     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3749     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3750     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3751     define buffer buf_pl-gds      for ub.pl-gds .
     3752     define buffer buf_temp-pl-gds for temp-pl-gds .
     3753     do
     3754     on error undo, return error return-value
     3755     :
     3756       run prdoclib-clear-temp-pl-gds in this-procedure .
     3757       for each buf_pl-gds
     3758         where buf_pl-gds.obj-type = p-obj-type
     3759           and buf_pl-gds.obj-code = p-obj-code
     3760           and buf_pl-gds.gds-code = p-gds-code
     3761       on error undo, return error return-value
     3762       :
     3763         create buf_temp-pl-gds .
     3764         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3765       end.
     3766     end.
     3767   end procedure.
     3768   procedure prdoclib-init-pl-gds-by-factord :
     3769     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3770     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3771     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3772     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3773     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3774     define input parameter p-fact-order         as decimal   no-undo .
     3775     define input parameter p-include-fact-order as logical   no-undo .
     3776     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3777     define buffer buf_goods       for ub.goods .
     3778     define buffer buf_gds-obj     for ub.gds-obj .
     3779     define buffer buf_doc-line    for ub.doc-line .
     3780     define buffer buf_temp-pl-gds for temp-pl-gds .
     3781     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3782     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3783     do
     3784     on error undo, return error return-value
     3785     :
     3786       do transaction
     3787       on error undo, return error return-value
     3788       :
     3789   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3791     (input  p-obj-type
     3792     ,input  p-obj-code
     3793     ,input  p-artic
     3794     ,input  p-prod-type
     3795     ,input  p-prod-code
     3796     ,buffer buf_gds-obj
     3797     ) no-error .
     3798         if error-status :error
     3799         then do:
     3800           message
     3801             vss-workfile vss-revision vss-description skip
     3802             vss-include-info9 skip
     3803             "Невозможно найти gds-obj" skip
     3804             error-status :get-message(1) skip
     3805             return-value skip
     3806             view-as alert-box error .
     3807           undo, return error return-value .
     3808         end.
     3809         find current buf_gds-obj exclusive-lock .
     3810       end.
     3811       find first buf_goods no-lock
     3812         where buf_goods.artic     = p-artic
     3813           and buf_goods.prod-type = p-prod-type
     3814           and buf_goods.prod-code = p-prod-code
     3815         .
     3816       run prdoclib-init-temp-pl-gds in this-procedure
     3817         (input p-obj-type
     3818         ,input p-obj-code
     3819         ,input buf_goods.gds-code
     3820         ) .
     3821       if p-include-fact-order = true
     3822       then do:
     3823         assign
     3824          p-fact-order = p-fact-order - 0.0000000001
     3825         .
     3826       end.
     3827       for each buf_doc-line no-lock
     3828         where buf_doc-line.obj-type   = p-obj-type
     3829           and buf_doc-line.obj-code   = p-obj-code
     3830           and buf_doc-line.artic      = p-artic
     3831           and buf_doc-line.prod-type  = p-prod-type
     3832           and buf_doc-line.prod-code  = p-prod-code
     3833           and buf_doc-line.status_    = 'факт':U
     3834           and buf_doc-line.fact-order >= p-fact-order
     3835       on error undo, return error return-value
     3836       :
     3837         run prdoclib-prc-pl-document in this-procedure
     3838           ( input  buf_doc-line.doc-code
     3839            ,input  p-obj-type
     3840            ,input  p-obj-code
     3841            ,input  buf_goods.gds-code
     3842            ,output v-total-pl-gds-qnty
     3843            ,output v-total-pl-gds-cli-qnty
     3844           ) .
     3845       end.
     3846     end.
     3847   end procedure.
     3848   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3849   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     3850   procedure partslib-clear-temp-parts :
     3851     define buffer buf_temp-parts for temp-parts .
     3852     do
     3853     on error undo, return error
     3854     :
     3855       for each buf_temp-parts
     3856       on error undo, return error
     3857       :
     3858         delete buf_temp-parts .
     3859       end.
     3860     end.
     3861   end procedure.
     3862   procedure partslib-create-temp-parts :
     3863     define parameter buffer buf_parts       for ub.parts .
     3864     define parameter buffer buf_temp-parts  for temp-parts .
     3865     define input  parameter p-goods-twounit as logical   no-undo .
     3866     define variable v-base-part-code as character no-undo .
     3867     do
     3868     on error undo, return error
     3869     :
     3870       if p-goods-twounit = true
     3871       then do:
     3872         assign
     3873           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     3874         .
     3875       end.
     3876       else do:
     3877         assign
     3878           v-base-part-code = buf_parts.part-code
     3879         .
     3880       end.
     3881       find first buf_temp-parts exclusive-lock
     3882         where buf_temp-parts.obj-type  = buf_parts.obj-type
     3883           and buf_temp-parts.obj-code  = buf_parts.obj-code
     3884           and buf_temp-parts.artic     = buf_parts.artic
     3885           and buf_temp-parts.prod-type = buf_parts.prod-type
     3886           and buf_temp-parts.prod-code = buf_parts.prod-code
     3887           and buf_temp-parts.in-code   = buf_parts.in-code
     3888           and buf_temp-parts.out-code  = 'free-zone':U
     3889           and buf_temp-parts.part-code = v-base-part-code
     3890         no-error.
     3891       if not available buf_temp-parts
     3892       then do:
     3893         create buf_temp-parts .
     3894         buffer-copy buf_parts to buf_temp-parts
     3895         assign
     3896           buf_temp-parts.out-code  = 'free-zone':U
     3897           buf_temp-parts.part-code = v-base-part-code
     3898           buf_temp-parts.rsrv-free = yes
     3899           buf_temp-parts.status_   = no
     3900           buf_temp-parts.qnty      = 0
     3901           buf_temp-parts.fact-qnty = 0
     3902           buf_temp-parts.real-qnty = 0
     3903           buf_temp-parts.cli-qnty  = 0
     3904         .
     3905       end.
     3906     end.
     3907   end procedure.
     3908   procedure partslib-init-temp-parts :
     3909     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     3910     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     3911     define input parameter p-artic           like ub.parts.artic     no-undo .
     3912     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     3913     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     3914     define buffer buf_parts      for ub.parts .
     3915     define buffer buf_temp-parts for temp-parts .
     3916     define variable v-goods-twounit    as logical   no-undo .
     3917     do
     3918     on error undo, return error
     3919     :
     3920   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     3922     (input  p-artic
     3923     ,input  p-prod-type
     3924     ,input  p-prod-code
     3925     ,input  'twounit=request':u
     3926     ,output v-goods-twounit
     3927     ) no-error .
     3928       if error-status :error
     3929       then do:
     3930         message
     3931           vss-workfile vss-revision vss-description skip
     3932           vss-include-info26 skip
     3933           "Ошибка при определении атрибута товара" skip
     3934           "Артикул" p-artic p-prod-type p-prod-code skip
     3935           "twounit=request" skip
     3936           error-status :get-message(1) skip
     3937           return-value skip
     3938           view-as alert-box error .
     3939         undo, return error return-value .
     3940       end.
     3941       run partslib-clear-temp-parts in this-procedure .
     3942       for each buf_parts
     3943         where buf_parts.obj-type  = p-obj-type
     3944           and buf_parts.obj-code  = p-obj-code
     3945           and buf_parts.artic     = p-artic
     3946           and buf_parts.prod-type = p-prod-type
     3947           and buf_parts.prod-code = p-prod-code
     3948           and buf_parts.rsrv-free = yes
     3949           and buf_parts.status_   = no
     3950           and buf_parts.in-code   <> buf_parts.out-code
     3951       on error undo, return error
     3952       :
     3953         run partslib-create-temp-parts in this-procedure
     3954           (buffer buf_parts
     3955           ,buffer buf_temp-parts
     3956           ,input  v-goods-twounit
     3957           ) .
     3958         define variable v-parts-qnty          as decimal   no-undo .
     3959         define variable v-parts-cli-qnty      as decimal   no-undo .
     3960         define variable v-parts-free-qnty     as decimal   no-undo .
     3961         define variable v-parts-free-cli-qnty as decimal   no-undo .
     3962         if buf_parts.out-code = 'free-zone':U
     3963         then do:
     3964           assign
     3965             v-parts-qnty          = buf_parts.qnty
     3966             v-parts-cli-qnty      = buf_parts.cli-qnty
     3967             v-parts-free-qnty     = buf_parts.qnty
     3968             v-parts-free-cli-qnty = buf_parts.cli-qnty
     3969           .
     3970         end.
     3971         else do:
     3972           assign
     3973             v-parts-qnty          = abs(buf_parts.qnty)
     3974             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     3975             v-parts-free-qnty     = 0
     3976             v-parts-free-cli-qnty = 0
     3977           .
     3978         end.
     3979         assign
     3980           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     3981           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     3982           buf_temp-parts.real-qnty     = 0
     3983           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     3984           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     3985           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     3986         .
     3987       end.
     3988     end.
     3989   end procedure.
