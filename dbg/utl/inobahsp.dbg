     2484   procedure prdoclib-clear-temp-prt-obj :
     2485     define buffer buf_temp-prt-obj for temp-prt-obj .
     2486     do
     2487     on error undo, return error return-value
     2488     :
     2489       for each buf_temp-prt-obj
     2490       on error undo, return error return-value
     2491       :
     2492         delete buf_temp-prt-obj .
     2493       end.
     2494     end.
     2495   end procedure.
     2496   procedure prdoclib-create-temp-prt-obj :
     2497     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2498     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2499     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2500     define buffer buf_gds-prt for ub.gds-prt .
     2501     do
     2502     on error undo, return error return-value
     2503     :
     2504       find first buf_temp-prt-obj
     2505         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2506         no-error .
     2507       if not available buf_temp-prt-obj
     2508       then do:
     2509         create buf_temp-prt-obj .
     2510         assign
     2511           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2512           buf_temp-prt-obj.price-sale       = ?
     2513           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2514           buf_temp-prt-obj.price-list-qnty  = ?
     2515           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2516           buf_temp-prt-obj.price-list-recid = ?
     2517         .
     2518         find first buf_gds-prt no-lock
     2519           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2520           .
     2521         assign
     2522           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2523         .
     2524         if buf_temp-prt-obj.is-term
     2525         then do:
     2526           assign
     2527             buf_temp-prt-obj.price-sale = p-root-price-sale
     2528           .
     2529         end.
     2530       end.
     2531     end.
     2532   end procedure.
     2533   procedure prdoclib-temp-prt-obj-by-prt-root :
     2534     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2535     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2536     define buffer buf_gds-prt for ub.gds-prt .
     2537     do
     2538     on error undo, return error return-value
     2539     :
     2540       find first buf_temp-prt-obj
     2541         where buf_temp-prt-obj.prt-code = p-prt-code
     2542         no-error .
     2543       if not available buf_temp-prt-obj
     2544       then do:
     2545         create buf_temp-prt-obj .
     2546         assign
     2547           buf_temp-prt-obj.prt-code         = p-prt-code
     2548           buf_temp-prt-obj.price-sale       = ?
     2549           buf_temp-prt-obj.fact-qnty        = 0
     2550           buf_temp-prt-obj.price-list-qnty  = ?
     2551           buf_temp-prt-obj.prt-obj-recid    = ?
     2552           buf_temp-prt-obj.price-list-recid = ?
     2553         .
     2554         find first buf_gds-prt no-lock
     2555           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2556           .
     2557         assign
     2558           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2559         .
     2560         if buf_temp-prt-obj.is-term
     2561         then do:
     2562           assign
     2563             buf_temp-prt-obj.price-sale = 0
     2564           .
     2565         end.
     2566       end.
     2567     end.
     2568   end procedure.
     2569   procedure prdoclib-init-temp-prt-obj :
     2570     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2571     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2572     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2573     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2574     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2575     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2576     define buffer buf_prt-obj      for ub.prt-obj .
     2577     define buffer buf_temp-prt-obj for temp-prt-obj .
     2578     do
     2579     on error undo, return error return-value
     2580     :
     2581       run prdoclib-clear-temp-prt-obj in this-procedure .
     2582       for each buf_prt-obj
     2583         where buf_prt-obj.obj-type  = p-obj-type
     2584           and buf_prt-obj.obj-code  = p-obj-code
     2585           and buf_prt-obj.artic     = p-artic
     2586           and buf_prt-obj.prod-type = p-prod-type
     2587           and buf_prt-obj.prod-code = p-prod-code
     2588       on error undo, return error return-value
     2589       :
     2590         run prdoclib-create-temp-prt-obj in this-procedure
     2591           (input  p-root-price-sale
     2592           ,buffer buf_prt-obj
     2593           ,buffer buf_temp-prt-obj
     2594           ).
     2595       end.
     2596     end.
     2597   end procedure.
     2598   procedure prdoclib-calc-fact-sale :
     2599     define input  parameter p-price-list-recid   as recid     no-undo .
     2600     define output parameter p-fact-qnty          as decimal   no-undo .
     2601     define output parameter p-cur-base           as decimal   no-undo .
     2602     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2603     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2604     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2605     define output parameter p-cur-excise-base    as decimal   no-undo .
     2606     define buffer buf_main_price-list for ub.price-list .
     2607     define buffer buf_price-list      for ub.price-list .
     2608     define buffer buf_goods           for ub.goods .
     2609     define buffer buf_gds-obj         for ub.gds-obj .
     2610     define buffer buf_bar-code        for ub.bar-code .
     2611     define variable l-empty-scale   as logical   no-undo .
     2612     do
     2613     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     2614     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2615     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2616     :
     2617       find first buf_main_price-list no-lock
     2618         where recid(buf_main_price-list) = p-price-list-recid
     2619         no-error .
     2620       if not available buf_main_price-list
     2621       then do:
     2622         message
     2623           vss-workfile vss-revision vss-description skip
     2624           vss-include-info9 skip
     2625           "Ошибка задания входных параметров" skip
     2626           "Не найдена строка переоценки" skip
     2627           "Код записи (recid)" p-price-list-recid skip
     2628           view-as alert-box error .
     2629         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2630       end.
     2631       if buf_main_price-list.main-price <> true
     2632       then do:
     2633         message
     2634           vss-workfile vss-revision vss-description skip
     2635           vss-include-info9 skip
     2636           "Ошибка задания входных параметров" skip
     2637           "Строка переоценки не является основной" skip
     2638           "Код записи (recid)" p-price-list-recid skip
     2639           "Переоценка" buf_main_price-list.doc-num skip
     2640           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2641           "Бар-код" buf_main_price-list.b-code skip
     2642           view-as alert-box error .
     2643         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2644       end.
     2645       find first buf_goods no-lock
     2646         where buf_goods.artic     = buf_main_price-list.artic
     2647           and buf_goods.prod-type = buf_main_price-list.prod-type
     2648           and buf_goods.prod-code = buf_main_price-list.prod-code
     2649         no-error .
     2650       if not available buf_goods
     2651       then do:
     2652         message
     2653           vss-workfile vss-revision vss-description skip
     2654           vss-include-info9 skip
     2655           "Не найден товар" skip
     2656           "Переоценка" buf_main_price-list.doc-num skip
     2657           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2658           view-as alert-box error .
     2659         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2660       end.
     2661   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2663     (input  buf_main_price-list.artic
     2664     ,input  buf_main_price-list.prod-type
     2665     ,input  buf_main_price-list.prod-code
     2666     ,input  'empty-scale=request':u
     2667     ,output l-empty-scale
     2668     ) no-error .
     2669       if error-status :error
     2670       then do:
     2671         message
     2672           vss-workfile vss-revision vss-description skip
