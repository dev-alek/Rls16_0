     7061     .
     7062     define variable v-curr-r-b as character no-undo .
     7063   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7065     (output v-curr-r-b
     7066     )  .
     7067       define buffer lock_shift-obj for ub.shift-obj .
     7068       run factord-lock-shift in this-procedure
     7069         (input  p-obj-type
     7070         ,input  p-obj-code
     7071         ,input  p-cut-date
     7072         ,buffer lock_shift-obj
     7073         ) no-error .
     7074       if error-status :error
     7075       then do:
     7076         run log-information in this-procedure
     7077           (input p-obj-type
     7078           ,input p-obj-code
     7079           ,input substitute("Процесс остановлен:  &1" , return-value  )
     7080           ) .
     7081         run clntattr-write in this-procedure
     7082           (input  p-obj-type
     7083           ,input  p-obj-code
     7084           ,input  'ahsp-del':U
     7085           ,input  "yes"
     7086           ) no-error .
     7087         run clntattr-write in this-procedure
     7088           (input  p-obj-type
     7089           ,input  p-obj-code
     7090           ,input  'ahsp-calc':U
     7091           ,input  "yes"
     7092           ) no-error .
     7093           p-error-count = 1 .
     7094     end.
     7095     else do:
     7096         run process-object in this-procedure
     7097           (input  p-obj-type
     7098           ,input  p-obj-code
     7099           ,input  p-cut-date
     7100           ) .
     7101         assign
     7102           p-error-count = 0
     7103         .
     7104     end.
     7105   end.
     7106   procedure process-object :
     7107     define input  parameter p-obj-type as character no-undo .
     7108     define input  parameter p-obj-code as integer   no-undo .
     7109     define input  parameter p-cut-date as date      no-undo .
     7110     do
     7111     on error undo, return error return-value
     7112     :
     7113       define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
     7114       run gbl/lock-prc.p
     7115         (input 'ahsp':U
     7116         ,input p-obj-code
     7117         ,input 0
     7118         ,input 0
     7119         ,input p-obj-type
     7120         ,input ""
     7121         ,input ""
     7122         ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
     7123         ,input true
     7124         ,buffer calc-supp-arh-lock_batchprocess
     7125         ) no-error .
     7126       if error-status :error
     7127       then do:
     7128         message
     7129           vss-workfile vss-revision vss-description skip
     7130           "В данный момент рассчитываются складского архив по поставщикам" skip
     7131           "Невозможно произвести инициализацию складского архива по поставщикам" skip
     7132           view-as alert-box error .
     7133         undo, return error .
     7134       end.
     7135       define buffer restore-ahsp-lock_batchprocess for ub.batchprocess .
     7136       run gbl/lock-prc.p
     7137         (input 'rsas':U
     7138         ,input p-obj-code
     7139         ,input 0
     7140         ,input 0
     7141         ,input p-obj-type
     7142         ,input ""
     7143         ,input ""
     7144         ,input "Объект,,, ,,,Восстановление складского складского архива по поставщикам"
     7145         ,input true
     7146         ,buffer restore-ahsp-lock_batchprocess
     7147         ) no-error .
     7148       if error-status :error
     7149       then do:
     7150         if error-status :get-message(1) <> ""
     7151         then do:
     7152           message
     7153             vss-workfile vss-revision vss-description skip
     7154             "Ошибка при вызове процедуры блокировки восстановления складского архива по поставщикам" skip
     7155             "Объект" p-obj-type p-obj-code skip
     7156             error-status :get-message(1) skip
     7157             return-value skip
     7158             view-as alert-box error .
     7159         end.
     7160         undo, return error return-value .
     7161       end.
     7162       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     7163       run gbl/lockrngd.p
     7164         (input  'grar':U
     7165         ,input  'disable':U
     7166         ,buffer buf_lock_gdsrenart_batchprocess
     7167         ) no-error .
     7168       if error-status :error
     7169       then do:
     7170         if error-status :get-message(1) <> ""
     7171         then do:
     7172           message
     7173             vss-workfile vss-revision vss-description skip
     7174             "Ошибка при блокировании функции переименования артикула товара" skip
     7175             error-status :get-message(1) skip
     7176             return-value skip
     7177             view-as alert-box error .
     7178         end.
     7179         undo, return error return-value .
     7180       end.
     7181       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     7182       run gbl/lockrngd.p
     7183         (input  'grgc':U
     7184         ,input  'disable':U
     7185         ,buffer buf_lock_gdsrengc_batchprocess
     7186         ) no-error .
     7187       if error-status :error
     7188       then do:
     7189         if error-status :get-message(1) <> ""
     7190         then do:
     7191           message
     7192             vss-workfile vss-revision vss-description skip
     7193             "Ошибка при блокировании функции переименования кода товара" skip
     7194             error-status :get-message(1) skip
     7195             return-value skip
     7196             view-as alert-box error .
     7197         end.
     7198         undo, return error return-value .
     7199       end.
     7200       do transaction
     7201       on error undo, return error return-value
     7202       :
     7203         run utl/arhiclr.p
     7204           (input  p-obj-type
     7205           ,input  p-obj-code
     7206           ,input  'ahsp':U
     7207           ) .
     7208         define variable v-create-chip-num as integer   no-undo .
     7209         run utl/arhiscr.p
     7210           (input  p-obj-type
     7211           ,input  p-obj-code
     7212           ,input  'ahsp':U
     7213           ,input  'init-start':U
     7214           ,input  ""
     7215           ,input  ""
     7216           ,input  0
     7217           ,input  ""
     7218           ,input  ""
     7219           ,input  p-cut-date
     7220           ,output v-create-chip-num
     7221           ) .
     7222       end.
     7223       run invalidate-md5-signature in this-procedure
     7224         (input  p-obj-type
     7225         ,input  p-obj-code
     7226         ,input  'arh':U
     7227         ,input  v-create-chip-num
     7228         ) .
     7229       define variable v-delete-ind       as integer   no-undo .
     7230       define variable v-delete-attr-list as character no-undo .
     7231       define variable v-attr-delete      as logical   no-undo .
     7232       assign
     7233         v-delete-attr-list  = 'ahsp-detail':U
     7234             + chr(44) + 'ahsp-start':U
     7235             + chr(44) + 'ahsp-del':U
     7236             + chr(44) + 'ahsp-disable':U
     7237             + chr(44) + 'ahsp-calc':U
     7238             + chr(44) + 'ahsp-recalc':U
     7239       .
     7240       do v-delete-ind = 1 to num-entries(v-delete-attr-list, chr(44))
     7241       :
     7242         run clntattr-delete in this-procedure
     7243           (input p-obj-type
     7244           ,input p-obj-code
     7245           ,input entry(v-delete-ind, v-delete-attr-list, chr(44))
     7246           ,output v-attr-delete
     7247           ) .
     7248       end.
     7249       run clntattr-write in this-procedure
     7250         (input p-obj-type
     7251         ,input p-obj-code
     7252         ,input 'ahsp-calc':U
     7253         ,input true
     7254         ) .
     7255       run clntattr-write in this-procedure
     7256         (input p-obj-type
     7257         ,input p-obj-code
     7258         ,input 'ahsp-del':U
     7259         ,input true
     7260         ) .
     7261       os-delete value(v-error-file-name) .
     7262       run log-clear in this-procedure
     7263         .
     7264       run log-information in this-procedure
     7265         (input p-obj-type
     7266         ,input p-obj-code
     7267         ,input "Начало инициализации"
     7268         ) .
     7269       define variable v-archive-date         as date      no-undo .
     7270       define variable v-shift-on             as logical   no-undo .
     7271       define variable v-shift-date           as date      no-undo .
     7272       define variable v-shift-num            as integer   no-undo .
     7273       define variable v-fact-order           as decimal   no-undo .
     7274       define variable v-shift-end-fact-order as decimal   no-undo .
     7275       define variable v-day-end-fact-order   as decimal   no-undo .
     7276       assign
     7277         v-archive-date = p-cut-date - 1
     7278       .
     7279       define buffer lock_shift-obj for ub.shift-obj .
     7280       run factord-lock-shift in this-procedure
     7281         (input  p-obj-type
     7282         ,input  p-obj-code
     7283         ,input  v-archive-date
     7284         ,buffer lock_shift-obj
     7285         ) no-error .
     7286       if error-status :error
     7287       then do:
     7288         run log-information in this-procedure
     7289           (input p-obj-type
     7290           ,input p-obj-code
     7291           ,input substitute("Процесс прерван:  &1" , return-value )
     7292           ) .
     7293           undo, return.
     7294       end.
     7295       run factord-cut-archive in this-procedure
     7296         (input  p-obj-type
     7297         ,input  p-obj-code
     7298         ,input  v-archive-date
     7299         ,output v-shift-on
     7300         ,output v-shift-date
     7301         ,output v-shift-num
     7302         ,output v-day-end-fact-order
     7303         ,output v-shift-end-fact-order
     7304         ) .
     7305       run log-information in this-procedure
     7306         (input p-obj-type
     7307         ,input p-obj-code
     7308         ,input "Составление списка документов"
     7309         ) .
     7310       run doclslib-clear-doc-list in this-procedure .
     7311       run doclslib-init-trn-doc in this-procedure
     7312         (input p-obj-type
     7313         ,input p-obj-code
     7314         ,input p-cut-date
     7315         ) no-error .
     7316       if error-status :error
     7317       then do:
     7318         message
     7319           vss-workfile vss-revision vss-description skip
     7320           "Ошибка при вызове процедуры doclslib-init-trn-doc" skip
     7321           error-status :get-message(1) skip
     7322           return-value skip
     7323           view-as alert-box error .
     7324         undo, return error .
     7325       end.
     7326       run log-information in this-procedure
     7327         (input p-obj-type
     7328         ,input p-obj-code
     7329         ,input "Удаление заданий на обработку складских документов"
     7330         ) .
     7331       run clear-batch-ahsp in this-procedure
     7332         (input p-obj-type
     7333         ,input p-obj-code
     7334         ,input today
     7335         ) no-error .
     7336       if error-status :error
     7337       then do:
     7338         message
     7339           vss-workfile vss-revision vss-description skip
     7340           "Ошибка при вызове процедуры clear-batch-ahsp" skip
     7341           error-status :get-message(1) skip
     7342           return-value skip
     7343           view-as alert-box error .
     7344         undo, return error .
     7345       end.
     7346       run doclslib-export-doc-list in this-procedure
     7347         (input p-obj-type
     7348         ,input p-obj-code
     7349         ,input v-list-file-name
     7350         ,input "Инициализация складского архива по поставщикам"
     7351         ) .
     7352       define variable v-total-ind as integer   no-undo .
     7353       run log-information in this-procedure
     7354         (input p-obj-type
     7355         ,input p-obj-code
     7356         ,input "Очистка архива"
     7357         ) .
     7358       run clear-db in this-procedure
     7359         (input p-obj-type
     7360         ,input p-obj-code
     7361         ) .
     7362       run clntattr-write in this-procedure
     7363         (input p-obj-type
     7364         ,input p-obj-code
     7365         ,input 'ahsp-start':U
     7366         ,input string(p-cut-date, '99/99/9999')
     7367         ) .
     7368       run clntattr-write in this-procedure
     7369         (input p-obj-type
     7370         ,input p-obj-code
     7371         ,input 'ahsp-detail':U
     7372         ,input string(p-cut-date, '99/99/9999')
     7373         ) .
     7374       run clear-tot in this-procedure .
     7375       define buffer buf_gds-obj for ub.gds-obj .
     7376       define variable v-host-code  as integer   no-undo .
     7377       define variable v-base-rate  like ub.curr-accnt.exch-rate no-undo .
     7378       define variable v-base-scale like ub.curr-accnt.exch-scale no-undo .
     7379       define variable v-ind        as integer   no-undo .
     7380       define variable v-cons-pay   as integer   no-undo .
     7381       define variable v-cons-type  as character no-undo .
     7382   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7384     (input  p-obj-type
     7385     ,input  p-obj-code
     7386     ,output v-host-code
     7387     )  .
     7388   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7389   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objatext in g#library
     7390     (input  p-obj-type
     7391     ,input  p-obj-code
     7392     ,input  'cons-pay=request'
     7393     ,output v-cons-pay
     7394     ,output v-cons-type
     7395     )  .
     7396   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7397   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     7398     (input  v-host-code
     7399     ,input  v-archive-date
     7400     ,output v-base-rate
     7401     ,output v-base-scale
     7402     ) no-error .
     7403       define variable v-base-rate-reason as character no-undo .
     7404       assign
     7405         v-base-rate-reason = return-value
     7406       .
     7407       form
     7408         p-obj-type label "Объект" p-obj-code no-label skip
     7409         v-ind      label "Обработано" skip
     7410         buf_gds-obj.artic label "Артикул" skip
     7411         with frame a view-as dialog-box side-labels three-d
     7412         title "Обработка товаров" .
     7413       display
     7414         p-obj-type p-obj-code
     7415         with frame a .
     7416       run log-information in this-procedure
     7417         (input p-obj-type
     7418         ,input p-obj-code
     7419         ,input "Обработка товаров"
     7420         ) .
     7421       for each buf_gds-obj no-lock
     7422         where buf_gds-obj.obj-type = p-obj-type
     7423           and buf_gds-obj.obj-code = p-obj-code
     7424       on error undo, return error return-value
     7425       :
     7426         assign
     7427           v-ind = v-ind + 1
     7428         .
     7429         if v-ind mod 10 = 0
     7430         then do:
     7431           display
     7432             v-ind skip
     7433             buf_gds-obj.artic skip
     7434             with frame a .
     7435         end.
     7436         run process-gds-obj in this-procedure
     7437           (input buf_gds-obj.obj-type
     7438           ,input buf_gds-obj.obj-code
     7439           ,input buf_gds-obj.artic
     7440           ,input buf_gds-obj.prod-type
     7441           ,input buf_gds-obj.prod-code
     7442           ,input v-cons-pay
     7443           ,input v-base-rate
     7444           ,input v-base-scale
     7445           ,input v-base-rate-reason
     7446           ,input v-archive-date
     7447           ,input v-shift-on
     7448           ,input v-shift-date
     7449           ,input v-shift-num
     7450           ,input v-day-end-fact-order
     7451           ,input v-shift-end-fact-order
     7452           ) .
     7453       end.
     7454       run store-tot in this-procedure
     7455         (input v-archive-date
     7456         ,input v-shift-on
     7457         ,input v-shift-date
     7458         ,input v-shift-num
     7459         ,input v-day-end-fact-order
     7460         ,input v-shift-end-fact-order
     7461         ) .
     7462       run clntattr-delete in this-procedure
     7463         (input p-obj-type
     7464         ,input p-obj-code
     7465         ,input 'ahsp-del':U
     7466         ,output v-attr-delete
     7467         ) .
     7468       run log-information in this-procedure
     7469         (input p-obj-type
     7470         ,input p-obj-code
     7471         ,input "Инициализация завершена. Обработано товаров " + string(v-ind)
     7472         ) .
     7473       run utl/arhiscr.p
     7474         (input  p-obj-type
     7475         ,input  p-obj-code
     7476         ,input  'ahsp':U
     7477         ,input  'init-stop':U
     7478         ,input  ""
     7479         ,input  ""
     7480         ,input  0
     7481         ,input  ""
     7482         ,input  ""
     7483         ,input  p-cut-date
     7484         ,output v-create-chip-num
     7485         ) .
     7486     end.
     7487   end procedure.
     7488   procedure process-gds-obj :
     7489     define input  parameter p-obj-type             like ub.gds-obj.obj-type  no-undo .
     7490     define input  parameter p-obj-code             like ub.gds-obj.obj-code  no-undo .
     7491     define input  parameter p-artic                like ub.gds-obj.artic     no-undo .
     7492     define input  parameter p-prod-type            like ub.gds-obj.prod-type no-undo .
     7493     define input  parameter p-prod-code            like ub.gds-obj.prod-code no-undo .
     7494     define input  parameter p-cons-pay             as integer   no-undo .
     7495     define input  parameter p-base-rate            like ub.curr-accnt.exch-rate no-undo .
     7496     define input  parameter p-base-scale           like ub.curr-accnt.exch-scale no-undo .
     7497     define input  parameter p-base-rate-reason     as character no-undo .
     7498     define input  parameter p-archive-date         as date      no-undo .
     7499     define input  parameter p-shift-on             as logical   no-undo .
     7500     define input  parameter p-shift-date           as date      no-undo .
     7501     define input  parameter p-shift-num            as integer   no-undo .
     7502     define input  parameter p-day-end-fact-order   as decimal   no-undo .
     7503     define input  parameter p-shift-end-fact-order as decimal   no-undo .
     7504     define buffer buf_goods              for ub.goods .
     7505     define buffer buf_temp-parts         for temp-parts .
     7506     define buffer buf_tt-clcparts        for tt-clcparts .
     7507     define buffer buf_tt-allsum-line     for tt-allsum-line .
     7508     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     7509     define buffer buf_temp-stk-supp-tot  for temp-stk-supp-tot .
     7510     do
     7511     on error undo, return error return-value
     7512     :
     7513       find first buf_goods no-lock
     7514         where buf_goods.artic     = p-artic
     7515           and buf_goods.prod-type = p-prod-type
     7516           and buf_goods.prod-code = p-prod-code
     7517         no-error .
     7518       if not available buf_goods
     7519       then do:
     7520         message
     7521           vss-workfile vss-revision vss-description skip
     7522           "Ошибка при поиске товара" skip
     7523           "Объект" p-obj-type p-obj-code skip
     7524           "Артикул" p-artic p-prod-type p-prod-code skip
     7525           view-as alert-box error .
     7526         undo, return error .
     7527       end.
     7528       if buf_goods.gds-type = 'т':U
     7529       then do:
     7530         run clear-line in this-procedure .
     7531         define variable v-vat-pc            as decimal   no-undo .
     7532         define variable v-slt-pc            as decimal   no-undo .
     7533         run partslib-init-temp-parts-by-factord in this-procedure
     7534           (input p-obj-type
     7535           ,input p-obj-code
     7536           ,input p-artic
     7537           ,input p-prod-type
     7538           ,input p-prod-code
     7539           ,input p-day-end-fact-order
     7540           ,input false
     7541           ) .
     7542         for each buf_temp-parts
     7543         on error undo, return error return-value
     7544         :
     7545           for each buf_tt-clcparts
     7546           on error undo, return error return-value
     7547           :
     7548             delete buf_tt-clcparts .
     7549           end.
     7550           create buf_tt-clcparts .
     7551           buffer-copy buf_temp-parts to buf_tt-clcparts .
     7552           run clcprtsl_calc-ttable in this-procedure
     7553             (input false
     7554             ,input false
     7555             ,input ?
     7556             ,input ?
     7557             ,input ?
     7558             ,input ?
     7559             ,input ?
     7560             ,input ?
     7561             ,input ?
     7562             ,input ?
     7563             ,input ?
     7564             ,input ?
     7565             ,input ?
     7566             ,input ?
     7567             ,input ?
     7568             ,input ?
     7569             ) no-error .
     7570           if error-status :error
     7571           then do:
     7572             message
     7573               vss-workfile vss-revision vss-description skip
     7574               "Ошибка при вызове процедуры clcprtsl_calc-ttable" skip
     7575               error-status :get-message(1) skip
     7576               return-value skip
     7577               view-as alert-box error .
     7578             undo, return error return-value .
     7579           end.
     7580           assign
     7581             v-vat-pc         = buf_temp-parts.vat-pc
     7582             v-slt-pc         = buf_temp-parts.slt-pc
     7583           .
     7584           find first buf_tt-allsum-line
     7585             where buf_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U
     7586             no-error .
     7587           if available buf_tt-allsum-line
     7588           then do:
     7589             assign
     7590               v-fact-qnty      = - buf_tt-allsum-line.fact-qnty
     7591               v-sum-base       = - buf_tt-allsum-line.sum-dsc-base-acc
     7592               v-sum-rubl       = - buf_tt-allsum-line.sum-dsc-rubl-acc
     7593               v-vat-base       = - buf_tt-allsum-line.vat-base-acc
     7594               v-vat-rubl       = - buf_tt-allsum-line.vat-rubl-acc
     7595               v-slt-base       = - buf_tt-allsum-line.slt-base-acc
     7596               v-slt-rubl       = - buf_tt-allsum-line.slt-rubl-acc
     7597               v-road-tax-base  = - buf_tt-allsum-line.road-tax-base-acc
     7598               v-road-tax-rubl  = - buf_tt-allsum-line.road-tax-rubl-acc
     7599               v-excise-base    = - buf_tt-allsum-line.excise-base-acc
     7600               v-excise-rubl    = - buf_tt-allsum-line.excise-rubl-acc
     7601               v-transport-base = - buf_tt-allsum-line.transport-base-acc
     7602               v-transport-rubl = - buf_tt-allsum-line.transport-rubl-acc
     7603               v-other-base     = - buf_tt-allsum-line.other-base-acc
     7604               v-other-rubl     = - buf_tt-allsum-line.other-rubl-acc
     7605             .
     7606           end.
     7607           else do:
     7608             assign
     7609               v-fact-qnty      = 0
     7610               v-sum-base       = 0
     7611               v-sum-rubl       = 0
     7612               v-vat-base       = 0
     7613               v-vat-rubl       = 0
     7614               v-slt-base       = 0
     7615               v-slt-rubl       = 0
     7616               v-road-tax-base  = 0
     7617               v-road-tax-rubl  = 0
     7618               v-excise-base    = 0
     7619               v-excise-rubl    = 0
     7620               v-transport-base = 0
     7621               v-transport-rubl = 0
     7622               v-other-base     = 0
     7623               v-other-rubl     = 0
     7624             .
     7625           end.
     7626           if
     7627                                           v-fact-qnty      = ? or    v-sum-base       = ? or    v-sum-rubl       = ? or    v-vat-base       = ? or    v-vat-rubl       = ? or    v-slt-base       = ? or    v-slt-rubl       = ? or    v-road-tax-base  = ? or    v-road-tax-rubl  = ? or    v-excise-base    = ? or    v-excise-rubl    = ? or    v-transport-base = ? or    v-transport-rubl = ? or    v-other-base     = ? or    v-other-rubl     = ?
     7628           then do:
     7629             message
     7630               vss-workfile vss-revision vss-description skip
     7631               "Программа clcprtsl_calc-ttable вернула неопределенные значения" skip
     7632               "Расчет складского архива по поставщикам невозможен" skip
     7633               "Объект" p-obj-type p-obj-code skip
     7634               "Артикул" p-artic p-prod-type p-prod-code skip
     7635               "Тип суммы" 'основная_сумма_со_знаком':U skip
     7636                                                                                       "v-fact-qnty"      v-fact-qnty        skip    "v-sum-base"       v-sum-base         skip    "v-sum-rubl"       v-sum-rubl         skip    "v-vat-base"       v-vat-base         skip    "v-vat-rubl"       v-vat-rubl         skip    "v-slt-base"       v-slt-base         skip    "v-slt-rubl"       v-slt-rubl         skip    "v-road-tax-base"  v-road-tax-base    skip    "v-road-tax-rubl"  v-road-tax-rubl    skip    "v-excise-base"    v-excise-base      skip    "v-excise-rubl"    v-excise-rubl      skip    "v-transport-base" v-transport-base   skip    "v-transport-rubl" v-transport-rubl   skip    "v-other-base"     v-other-base       skip    "v-other-rubl"     v-other-rubl
     7637               view-as alert-box error .
     7638             undo, return error .
     7639           end.
     7640           define variable v-ahsp-type-ind        as integer   no-undo .
     7641           define variable v-ahsp-type-list       as character extent 5 no-undo
     7642             initial ['prch':U, 'cacc':U, 'benf':U, 'stor':U, 'cons':U] .
     7643           define variable v-allsum-sum-type-list as character extent 5 no-undo
     7644             initial ['сумма_по_выкупу_со_знаком':U, 'сумма_по_консигнации_закупка_со_знаком':U, 'сумма_по_консигнации_выгода_со_знаком':U, 'сумма_по_ответственному_хранению_со_знаком':U, 'сумма_по_старой_консигнации_со_знаком':U] .
     7645           define variable v-ahsp-type            as character no-undo .
     7646           define variable v-allsum-sum-type      as character no-undo .
     7647           do v-ahsp-type-ind = 1 to extent(v-ahsp-type-list)
     7648           :
     7649             assign
     7650               v-ahsp-type       = v-ahsp-type-list[v-ahsp-type-ind]
     7651               v-allsum-sum-type = v-allsum-sum-type-list[v-ahsp-type-ind]
     7652             .
     7653             find first buf_tt-allsum-line
     7654               where buf_tt-allsum-line.sum-type = v-allsum-sum-type
     7655               no-error .
     7656             if available buf_tt-allsum-line
     7657             then do:
     7658               assign
     7659                 v-fact-qnty      = - buf_tt-allsum-line.fact-qnty
     7660                 v-sum-base       = - buf_tt-allsum-line.sum-dsc-base-acc
     7661                 v-sum-rubl       = - buf_tt-allsum-line.sum-dsc-rubl-acc
     7662                 v-vat-base       = - buf_tt-allsum-line.vat-base-acc
     7663                 v-vat-rubl       = - buf_tt-allsum-line.vat-rubl-acc
     7664                 v-slt-base       = - buf_tt-allsum-line.slt-base-acc
     7665                 v-slt-rubl       = - buf_tt-allsum-line.slt-rubl-acc
     7666                 v-road-tax-base  = - buf_tt-allsum-line.road-tax-base-acc
     7667                 v-road-tax-rubl  = - buf_tt-allsum-line.road-tax-rubl-acc
     7668                 v-excise-base    = - buf_tt-allsum-line.excise-base-acc
     7669                 v-excise-rubl    = - buf_tt-allsum-line.excise-rubl-acc
     7670                 v-transport-base = - buf_tt-allsum-line.transport-base-acc
     7671                 v-transport-rubl = - buf_tt-allsum-line.transport-rubl-acc
     7672                 v-other-base     = - buf_tt-allsum-line.other-base-acc
     7673                 v-other-rubl     = - buf_tt-allsum-line.other-rubl-acc
     7674               .
     7675             end.
     7676             else do:
     7677               assign
     7678                 v-fact-qnty      = 0
     7679                 v-sum-base       = 0
     7680                 v-sum-rubl       = 0
     7681                 v-vat-base       = 0
     7682                 v-vat-rubl       = 0
     7683                 v-slt-base       = 0
     7684                 v-slt-rubl       = 0
     7685                 v-road-tax-base  = 0
     7686                 v-road-tax-rubl  = 0
     7687                 v-excise-base    = 0
     7688                 v-excise-rubl    = 0
     7689                 v-transport-base = 0
     7690                 v-transport-rubl = 0
     7691                 v-other-base     = 0
     7692                 v-other-rubl     = 0
     7693               .
     7694             end.
     7695             if v-ahsp-type = 'benf':U
     7696             then do:
     7697               assign
     7698                 v-fact-qnty = 0
     7699               .
     7700             end.
     7701             if
     7702                                                     v-fact-qnty      = ? or    v-sum-base       = ? or    v-sum-rubl       = ? or    v-vat-base       = ? or    v-vat-rubl       = ? or    v-slt-base       = ? or    v-slt-rubl       = ? or    v-road-tax-base  = ? or    v-road-tax-rubl  = ? or    v-excise-base    = ? or    v-excise-rubl    = ? or    v-transport-base = ? or    v-transport-rubl = ? or    v-other-base     = ? or    v-other-rubl     = ?
     7703             then do:
     7704               message
     7705                 vss-workfile vss-revision vss-description skip
     7706                 "Программа clcprtsl_calc-ttable вернула неопределенные значения" skip
     7707                 "Расчет складского архива по поставщикам невозможен" skip
     7708                 "Объект" p-obj-type p-obj-code skip
     7709                 "Артикул" p-artic p-prod-type p-prod-code skip
     7710                 "Тип суммы" v-allsum-sum-type skip
     7711                                                                                                     "v-fact-qnty"      v-fact-qnty        skip    "v-sum-base"       v-sum-base         skip    "v-sum-rubl"       v-sum-rubl         skip    "v-vat-base"       v-vat-base         skip    "v-vat-rubl"       v-vat-rubl         skip    "v-slt-base"       v-slt-base         skip    "v-slt-rubl"       v-slt-rubl         skip    "v-road-tax-base"  v-road-tax-base    skip    "v-road-tax-rubl"  v-road-tax-rubl    skip    "v-excise-base"    v-excise-base      skip    "v-excise-rubl"    v-excise-rubl      skip    "v-transport-base" v-transport-base   skip    "v-transport-rubl" v-transport-rubl   skip    "v-other-base"     v-other-base       skip    "v-other-rubl"     v-other-rubl
     7712                 view-as alert-box error .
     7713               undo, return error .
     7714             end.
     7715             define variable ind-ext    as integer no-undo .
     7716             define variable v-cat-id   as character no-undo extent 4 .
     7717             define variable v-sum-type as character no-undo extent 4 .
     7718             assign
     7719               v-sum-type[1] = 'cost':U
     7720               v-cat-id[1]   = '##':U
     7721               v-sum-type[2] = 'cost':U + 'p':U
     7722               v-cat-id[2]   = v-ahsp-type
     7723             .
     7724             do ind-ext = 1 to 2
     7725             :
     7726               find first buf_temp-stk-supp-line
     7727                 where buf_temp-stk-supp-line.obj-type   = p-obj-type
     7728                   and buf_temp-stk-supp-line.obj-code   = p-obj-code
     7729                   and buf_temp-stk-supp-line.cli-type   = buf_temp-parts.supp-type
     7730                   and buf_temp-stk-supp-line.cli-code   = buf_temp-parts.supp-code
     7731                   and buf_temp-stk-supp-line.artic      = p-artic
     7732                   and buf_temp-stk-supp-line.prod-type  = p-prod-type
     7733                   and buf_temp-stk-supp-line.prod-code  = p-prod-code
     7734                   and buf_temp-stk-supp-line.fact-order = p-day-end-fact-order
     7735                   and buf_temp-stk-supp-line.sum-type   = v-sum-type[ind-ext]
     7736                   and buf_temp-stk-supp-line.cat-id     = v-cat-id[ind-ext]
     7737                 no-error .
     7738               if not available buf_temp-stk-supp-line
     7739               then do:
     7740                 create buf_temp-stk-supp-line .
     7741                 assign
