     7040   define variable v-fact-qnty      like ub.ot-supp-tot.fact-qnty       no-undo .     define variable v-sum-base       like ub.ot-supp-tot.sum-base        no-undo .     define variable v-sum-rubl       like ub.ot-supp-tot.sum-rubl        no-undo .     define variable v-vat-base       like ub.ot-supp-tot.vat-base        no-undo .     define variable v-vat-rubl       like ub.ot-supp-tot.vat-rubl        no-undo .     define variable v-slt-base       like ub.ot-supp-tot.slt-base        no-undo .     define variable v-slt-rubl       like ub.ot-supp-tot.slt-rubl        no-undo .     define variable v-road-tax-base  like ub.ot-supp-tot.road-tax-base   no-undo .     define variable v-road-tax-rubl  like ub.ot-supp-tot.road-tax-rubl   no-undo .     define variable v-excise-base    like ub.ot-supp-tot.excise-base     no-undo .     define variable v-excise-rubl    like ub.ot-supp-tot.excise-rubl     no-undo .     define variable v-transport-base like ub.ot-supp-tot.transport-base  no-undo .     define variable v-transport-rubl like ub.ot-supp-tot.transport-rubl  no-undo .     define variable v-other-base     like ub.ot-supp-tot.other-base      no-undo .     define variable v-other-rubl     like ub.ot-supp-tot.other-rubl      no-undo .
     7041   define stream slog .
     7042   define variable v-log-file-name   as character no-undo .
     7043   define variable v-error-file-name as character no-undo .
     7044   define variable v-list-file-name  as character no-undo .
     7045   do
     7046   on error undo, return error return-value
     7047   :
     7048     assign
     7049       v-log-file-name   = substitute('inobahsp_&1_&2.txt':U
     7050                                     ,p-obj-type
     7051                                     ,p-obj-code
     7052                                     )
     7053       v-error-file-name = substitute('inobahsp_&1_&2.err':U
