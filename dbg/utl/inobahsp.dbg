     6802         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     6803       end.
     6804       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     6805       assign
