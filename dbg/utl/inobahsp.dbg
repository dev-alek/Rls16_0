     2380         end.
     2381       end.
     2382       assign
     2383         v-total-fact-sale = v-total-fact-sale
     2384                           + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
     2385       .
     2386       if v-total-fact-sale = ?
     2387       then do:
     2388         message
     2389           vss-workfile vss-revision vss-description skip
     2390           vss-include-info9 skip
     2391           "Ошибка при вычислении суммы в продажных ценах" skip
     2392           "Получено неопределенное значение" skip
     2393           "Переоценка" v-doc-num skip
     2394           "Артикул" p-artic p-prod-type p-prod-code skip
     2395           "Код признака" buf_temp-prt-obj.prt-code skip
     2396           "Сумма в продажных ценах" v-total-fact-sale skip
     2397           view-as alert-box error .
     2398         undo, return error .
     2399       end.
     2400       define variable v-old-fact-qnty     as decimal   no-undo .
     2401       define variable v-old-fact-cli-qnty as decimal   no-undo .
     2402       define variable v-old-fact-base     as decimal   no-undo .
     2403       define variable v-old-fact-rubl     as decimal   no-undo .
     2404       define variable v-old-fact-sale     as decimal   no-undo .
     2405       assign
     2406         v-old-fact-qnty     = buf_gds-obj.fact-qnty
