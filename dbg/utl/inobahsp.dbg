      995   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   define temp-table doc-list no-undo
      997     field doc-code         like ub.trn-doc.doc-code
      998     field obj-type         like ub.trn-doc.obj-type
      999     field obj-code         like ub.trn-doc.obj-code
     1000     field fact-date        like ub.trn-doc.fact-date
     1001     field shift-date       like ub.trn-doc.shift-date
     1002     field shift-num        like ub.trn-doc.shift-num
     1003     field shift-name       like ub.trn-doc.shift-name
     1004     field fact-order       as decimal
     1005     field is-trn-doc       as logical
     1006     field doc-type         like ub.trn-doc.doc-type
     1007     field is-archive-exist as logical
     1008     index xpk is primary unique doc-code doc-type
     1009     index xfact-order fact-order
     1010     index xfact-date  fact-date
     1011     .
     1012   define temp-table doclslib-goods no-undo
     1013     field gds-code  as integer
     1014     field artic     as character
     1015     field prod-type as character
     1016     field prod-code as integer
     1017     index xpk is primary unique gds-code
     1018     index xie1 artic prod-type prod-code
     1019     .
     1020   define buffer inkas_trn-doc for ub.trn-doc .
     1021   define stream doclsliblog .
     1022   procedure doclslib-clear-doc-list :
     1023     define buffer buf_doc-list for doc-list .
     1024     do
     1025     on error undo, return error
     1026     :
     1027       for each buf_doc-list
     1028       on error undo, return error
     1029       :
     1030         delete buf_doc-list .
     1031       end.
     1032     end.
     1033   end procedure.
     1034   procedure doclslib-init-trn-doc :
     1035     define input parameter p-obj-type      as character no-undo .
     1036     define input parameter p-obj-code      as integer   no-undo .
     1037     define input parameter p-cut-date      as date      no-undo .
     1038     define buffer buf_trn-doc for ub.trn-doc .
     1039     define buffer buf_doc-list for doc-list .
     1040     do
     1041     on error undo, return error
     1042     :
     1043       if p-cut-date = ?
     1044       then do:
     1045         for each buf_trn-doc no-lock
     1046           where buf_trn-doc.obj-type = p-obj-type
     1047             and buf_trn-doc.obj-code = p-obj-code
     1048             and buf_trn-doc.status_  = 'факт':U
     1049         on error undo, return error
     1050         :
     1051           create buf_doc-list .
     1052           assign
     1053             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1054             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1055             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1056             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1057             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1058             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1059             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1060             buf_doc-list.is-trn-doc = true
     1061           .
     1062         end.
     1063       end.
     1064       else do:
     1065         for each buf_trn-doc no-lock
     1066           where buf_trn-doc.obj-type  = p-obj-type
     1067             and buf_trn-doc.obj-code  = p-obj-code
     1068             and buf_trn-doc.status_   = 'факт':U
     1069             and buf_trn-doc.fact-date >= p-cut-date
     1070         on error undo, return error
     1071         :
     1072           create buf_doc-list .
     1073           assign
     1074             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1075             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1076             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1077             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1078             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1079             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1080             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1081             buf_doc-list.is-trn-doc = true
     1082           .
     1083         end.
     1084       end.
     1085     end.
     1086   end procedure.
     1087   procedure doclslib-init-price-doc :
     1088     define input parameter p-obj-type      as character no-undo .
     1089     define input parameter p-obj-code      as integer   no-undo .
     1090     define input parameter p-cut-date      as date      no-undo .
     1091     define buffer buf_price-doc for ub.price-doc .
     1092     define buffer buf_doc-list for doc-list .
     1093     do
     1094     on error undo, return error
     1095     :
     1096       if p-cut-date = ?
     1097       then do:
     1098         for each buf_price-doc no-lock
     1099           where buf_price-doc.obj-type = p-obj-type
     1100             and buf_price-doc.obj-code = p-obj-code
     1101             and buf_price-doc.status_  = 'акт':U
     1102         on error undo, return error
     1103         :
     1104           create buf_doc-list .
     1105           assign
     1106             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1107             buf_doc-list.doc-type   = ''
     1108             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1109             buf_doc-list.shift-date = buf_price-doc.shift-date
     1110             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1111             buf_doc-list.shift-name = buf_price-doc.shift-name
     1112             buf_doc-list.fact-order = buf_price-doc.fact-order
     1113             buf_doc-list.is-trn-doc = false
     1114           .
     1115         end.
     1116       end.
     1117       else do:
     1118         for each buf_price-doc no-lock
     1119           where buf_price-doc.obj-type = p-obj-type
     1120             and buf_price-doc.obj-code = p-obj-code
     1121             and buf_price-doc.status_  = 'акт':U
     1122             and ub.buf_price-doc.fact-date >= p-cut-date
     1123         on error undo, return error
     1124         :
     1125           create buf_doc-list .
     1126           assign
     1127             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1128             buf_doc-list.doc-type   = ''
     1129             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1130             buf_doc-list.shift-date = buf_price-doc.shift-date
     1131             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1132             buf_doc-list.shift-name = buf_price-doc.shift-name
     1133             buf_doc-list.fact-order = buf_price-doc.fact-order
     1134             buf_doc-list.is-trn-doc = false
     1135           .
     1136         end.
     1137       end.
     1138     end.
     1139   end procedure.
     1140   procedure doclslib-clear-bydate-doc-list :
     1141     define input parameter p-fact-date as date no-undo .
     1142     define buffer buf_doc-list for doc-list .
     1143     do
     1144     on error undo, return error
     1145     :
     1146       if p-fact-date <> ?
     1147       then do:
     1148         for each buf_doc-list
     1149           where buf_doc-list.fact-date < p-fact-date
     1150         on error undo, return error
     1151         :
     1152           delete buf_doc-list .
     1153         end.
     1154       end.
     1155     end.
     1156   end procedure.
     1157   procedure doclslib-clear-rst :
     1158     define input parameter p-fact-date as date no-undo .
     1159     define buffer buf_doc-list for doc-list .
     1160     do
     1161     on error undo, return error
     1162     :
     1163       if p-fact-date <> ?
     1164       then do:
     1165         for each buf_doc-list
     1166           where buf_doc-list.fact-date >= p-fact-date
     1167         on error undo, return error
     1168         :
     1169           delete buf_doc-list .
     1170         end.
     1171       end.
     1172     end.
     1173   end procedure.
     1174   procedure doclslib-export-doc-list :
     1175     define input  parameter p-obj-type      as character no-undo .
     1176     define input  parameter p-obj-code      as integer no-undo .
     1177     define input  parameter p-log-file-name as character no-undo .
     1178     define input  parameter p-description   as character no-undo .
     1179     define buffer buf_doc-list for doc-list .
     1180     do
     1181     on error undo, return error
     1182     :
     1183       output stream doclsliblog to value(p-log-file-name) .
     1184       export stream doclsliblog "#############################################################" .
     1185       export stream doclsliblog "Список документов" .
     1186       export stream doclsliblog p-description .
     1187       export stream doclsliblog "Объект" p-obj-type p-obj-code .
     1188       export stream doclsliblog "Дата" string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     1189       for each buf_doc-list
     1190       by buf_doc-list.fact-order
     1191       on error undo, return error
     1192       :
     1193         export stream doclsliblog buf_doc-list .
     1194       end.
     1195       export stream doclsliblog "#############################################################" .
     1196       output stream doclsliblog close .
     1197     end.
     1198   end procedure.
     1199   procedure doclslib-clear-batch-process :
     1200     define input parameter p-bp_type like ub.batchprocess.bp_type no-undo .
     1201     define buffer buf_batchprocess        for ub.batchprocess .
     1202     define buffer execdelete_batchprocess for ub.batchprocess .
     1203     define buffer buf_doc-list            for doc-list .
     1204     for each buf_doc-list
     1205     on end-key undo, return error substitute( "doclslib-clear-batch-process. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1206     on error   undo, return error substitute( "doclslib-clear-batch-process. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1207     on stop    undo, return error substitute( "doclslib-clear-batch-process. STOP      &2"
     1208                                    + "bp_type &3&2"
     1209                                    + "Документ &4"
     1210                                    , chr(10)
     1211                                    , p-bp_type
     1212                                    , buf_doc-list.doc-code
     1213                                   )
     1214     :
     1215       find first buf_batchprocess exclusive-lock
     1216         where buf_BatchProcess.BP_Status   = 'N':U
     1217           and buf_batchprocess.bp_type     = p-bp_type
     1218           and buf_batchprocess.charkey_one = buf_doc-list.doc-code
     1219         no-error .
     1220       if available buf_batchprocess
     1221       then do:
     1222         delete buf_batchprocess .
     1223       end.
     1224     end.
     1225   end procedure.
     1226   procedure doclslib-calc-arh :
     1227     define input  parameter p-log-handle     as handle    no-undo .
     1228     define input  parameter p-obj-type       as character no-undo .
     1229     define input  parameter p-obj-code       as integer   no-undo .
     1230     define input  parameter p-cut-date       as date      no-undo .
     1231     define input  parameter p-update-recalc  as logical   no-undo .
     1232     define variable v-prev-fact-date as date      no-undo .
     1233     define buffer buf_doc-list for doc-list .
     1234     define buffer stop-arh-restore-lock_btpr for ub.batchprocess .
     1235     define buffer stop-arh-news-lock_btpr    for ub.batchprocess .
     1236     do
     1237     on stop    undo, return error substitute( "doclslib-calc-arh. stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1238     on end-key undo, return error substitute( "doclslib-calc-arh. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1239     on error   undo, return error substitute( "doclslib-calc-arh. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1240     :
     1241       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1242       run gbl/lockrngd.p
     1243         (input  'grar':U
     1244         ,input  'disable':U
     1245         ,buffer buf_lock_gdsrenart_batchprocess
     1246         ) no-error .
     1247       if error-status :error
     1248       then do:
     1249         if error-status :get-message(1) <> ""
     1250         then do:
     1251           message
     1252             vss-workfile vss-revision vss-description skip
     1253             "Ошибка при блокировании функции переименования артикула товара" skip
     1254             error-status :get-message(1) skip
     1255             return-value skip
     1256             view-as alert-box error .
     1257         end.
     1258         undo, return error return-value .
     1259       end.
     1260       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1261       run gbl/lockrngd.p
     1262         (input  'grgc':U
     1263         ,input  'disable':U
     1264         ,buffer buf_lock_gdsrengc_batchprocess
     1265         ) no-error .
     1266       if error-status :error
     1267       then do:
     1268         if error-status :get-message(1) <> ""
     1269         then do:
     1270           message
     1271             vss-workfile vss-revision vss-description skip
     1272             "Ошибка при блокировании функции переименования кода товара" skip
     1273             error-status :get-message(1) skip
     1274             return-value skip
     1275             view-as alert-box error .
     1276         end.
     1277         undo, return error return-value .
     1278       end.
     1279       for each buf_doc-list
     1280       by buf_doc-list.fact-order
     1281       on stop    undo, return error substitute( "f e . stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1282       on end-key undo, return error substitute( "f e . end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1283       on error   undo, return error substitute( "f e . error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1284       :
     1285         find first stop-arh-restore-lock_btpr no-lock
     1286           where stop-arh-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
     1287             and stop-arh-restore-lock_btpr.bp_status     = 'N':U
     1288             and stop-arh-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1289             and stop-arh-restore-lock_btpr.Key#_Two      = 0
     1290             and stop-arh-restore-lock_btpr.Key#_Three    = 0
     1291             and stop-arh-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1292             and stop-arh-restore-lock_btpr.CharKey_Two   = ""
     1293             and stop-arh-restore-lock_btpr.CharKey_Three = ""
     1294           no-error .
     1295         if available stop-arh-restore-lock_btpr
     1296         then do:
     1297           run doclslib-log-information in this-procedure
     1298             (input p-log-handle
     1299             ,input "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива"
     1300             ) .
     1301           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1302         end.
     1303         find first stop-arh-news-lock_btpr no-lock
     1304           where stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
     1305             and stop-arh-news-lock_btpr.bp_status     = 'N':U
     1306             and stop-arh-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1307             and stop-arh-news-lock_btpr.Key#_Two      = 0
     1308             and stop-arh-news-lock_btpr.Key#_Three    = 0
     1309             and stop-arh-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1310             and stop-arh-news-lock_btpr.CharKey_Three = ""
     1311           no-error .
     1312         if available stop-arh-news-lock_btpr
     1313         then do:
     1314           run doclslib-log-information in this-procedure
     1315             (input p-log-handle
     1316             ,input "Система новостей запросила остановку процедуры расчета складского архива"
     1317             ) .
     1318           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1319         end.
     1320         if buf_doc-list.is-trn-doc
     1321         then do:
     1322           run doclslib-log-information in this-procedure
     1323             (input p-log-handle
     1324             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1325                              ,buf_doc-list.doc-code
     1326                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1327                              ,buf_doc-list.fact-order
     1328                              )
     1329             ) .
     1330           run trg/calc-arh.p
     1331             (input buf_doc-list.doc-code
     1332             ,input p-cut-date
     1333             ).
     1334           run doclslib-log-information in this-procedure
     1335             (input p-log-handle
     1336             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1337                              ,buf_doc-list.doc-code
     1338                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1339                              ,buf_doc-list.fact-order
     1340                              )
     1341             ) .
     1342         end.
     1343         else do:
     1344           run doclslib-log-information in this-procedure
     1345             (input p-log-handle
     1346             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1347                              ,buf_doc-list.doc-code
     1348                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1349                              ,buf_doc-list.fact-order
     1350                              )
     1351             ) .
     1352           run trg/calc-apc.p
     1353             (input buf_doc-list.doc-code
     1354             ,input p-cut-date
     1355             ).
     1356           run doclslib-log-information in this-procedure
     1357             (input p-log-handle
     1358             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1359                              ,buf_doc-list.doc-code
     1360                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1361                              ,buf_doc-list.fact-order
     1362                              )
     1363             ) .
     1364         end.
     1365         if  p-update-recalc  = true
     1366         and v-prev-fact-date <> ?
     1367         and buf_doc-list.fact-date > v-prev-fact-date
     1368         then do:
     1369           run gbl/clntat-w.p
     1370             (input p-obj-type
     1371             ,input p-obj-code
     1372             ,input 'arh-recalc':U
     1373             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1374             ) .
     1375           run doclslib-log-information in this-procedure
     1376             (input p-log-handle
     1377             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1378                              ,string(v-prev-fact-date, '99/99/9999':u)
     1379                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1380                              )
     1381             ) .
     1382         end.
     1383         assign
     1384           v-prev-fact-date = buf_doc-list.fact-date
     1385         .
     1386       end.
     1387     end.
     1388   end procedure.
     1389   procedure doclslib-calc-aht :
     1390     define input  parameter p-log-handle    as handle    no-undo .
     1391     define input  parameter p-obj-type      as character no-undo .
     1392     define input  parameter p-obj-code      as integer   no-undo .
     1393     define input  parameter p-cut-date      as date      no-undo .
     1394     define input  parameter p-update-recalc as logical   no-undo .
     1395     define variable v-prev-fact-date as date      no-undo .
     1396     define buffer buf_doc-list for doc-list .
     1397     define buffer stop-aht-restore-lock_btpr for ub.batchprocess .
     1398     define buffer stop-aht-news-lock_btpr    for ub.batchprocess .
     1399     do
     1400     on error undo, return error return-value
     1401     :
     1402       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1403       run gbl/lockrngd.p
     1404         (input  'grar':U
     1405         ,input  'disable':U
     1406         ,buffer buf_lock_gdsrenart_batchprocess
     1407         ) no-error .
     1408       if error-status :error
     1409       then do:
     1410         if error-status :get-message(1) <> ""
     1411         then do:
     1412           message
     1413             vss-workfile vss-revision vss-description skip
     1414             "Ошибка при блокировании функции переименования артикула товара" skip
     1415             error-status :get-message(1) skip
     1416             return-value skip
     1417             view-as alert-box error .
     1418         end.
     1419         undo, return error return-value .
     1420       end.
     1421       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1422       run gbl/lockrngd.p
     1423         (input  'grgc':U
     1424         ,input  'disable':U
     1425         ,buffer buf_lock_gdsrengc_batchprocess
     1426         ) no-error .
     1427       if error-status :error
     1428       then do:
     1429         if error-status :get-message(1) <> ""
     1430         then do:
     1431           message
     1432             vss-workfile vss-revision vss-description skip
     1433             "Ошибка при блокировании функции переименования кода товара" skip
     1434             error-status :get-message(1) skip
     1435             return-value skip
     1436             view-as alert-box error .
     1437         end.
     1438         undo, return error return-value .
     1439       end.
     1440       for each buf_doc-list
     1441       by buf_doc-list.fact-order
     1442       on error undo, return error
     1443       :
     1444         find first stop-aht-restore-lock_btpr no-lock
     1445           where stop-aht-restore-lock_btpr.bp_type       = 'lock':U + 'rsts':U
     1446             and stop-aht-restore-lock_btpr.bp_status     = 'N':U
     1447             and stop-aht-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1448             and stop-aht-restore-lock_btpr.Key#_Two      = 0
     1449             and stop-aht-restore-lock_btpr.Key#_Three    = 0
     1450             and stop-aht-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1451             and stop-aht-restore-lock_btpr.CharKey_Two   = ""
     1452             and stop-aht-restore-lock_btpr.CharKey_Three = ""
     1453           no-error .
     1454         if available stop-aht-restore-lock_btpr
     1455         then do:
     1456           undo, return error "Процедура восстановления складского архива запросила остановку процедуры автоматического расчета складского архива" .
     1457         end.
     1458         find first stop-aht-news-lock_btpr no-lock
     1459           where stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
     1460             and stop-aht-news-lock_btpr.bp_status     = 'N':U
     1461             and stop-aht-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1462             and stop-aht-news-lock_btpr.Key#_Two      = 0
     1463             and stop-aht-news-lock_btpr.Key#_Three    = 0
     1464             and stop-aht-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1465             and stop-aht-news-lock_btpr.CharKey_Three = ""
     1466           no-error .
     1467         if available stop-aht-news-lock_btpr
     1468         then do:
     1469           undo, return error "Система новостей запросила остановку процедуры автоматического расчета складского архива" .
     1470         end.
     1471         if buf_doc-list.is-trn-doc
     1472         then do:
     1473           run doclslib-log-information in this-procedure
     1474             (input p-log-handle
     1475             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1476                              ,buf_doc-list.doc-code
     1477                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1478                              ,buf_doc-list.fact-order
     1479                              )
     1480             ) .
     1481           run trg/aht-doc.p
     1482             (input buf_doc-list.doc-code
     1483             ,input p-cut-date
     1484             ).
     1485           run doclslib-log-information in this-procedure
     1486             (input p-log-handle
     1487             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1488                              ,buf_doc-list.doc-code
     1489                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1490                              ,buf_doc-list.fact-order
     1491                              )
     1492             ) .
     1493         end.
     1494         else do:
     1495           run doclslib-log-information in this-procedure
     1496             (input p-log-handle
     1497             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1498                              ,buf_doc-list.doc-code
     1499                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1500                              ,buf_doc-list.fact-order
     1501                              )
     1502             ) .
     1503           run trg/aht-prc.p
     1504             (input buf_doc-list.doc-code
     1505             ,input p-cut-date
     1506             ).
     1507           run doclslib-log-information in this-procedure
     1508             (input p-log-handle
     1509             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1510                              ,buf_doc-list.doc-code
     1511                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1512                              ,buf_doc-list.fact-order
     1513                              )
     1514             ) .
     1515         end.
     1516         if  p-update-recalc  = true
     1517         and v-prev-fact-date <> ?
     1518         and buf_doc-list.fact-date > v-prev-fact-date
     1519         then do:
     1520           run gbl/clntat-w.p
     1521             (input p-obj-type
     1522             ,input p-obj-code
     1523             ,input 'aht-recalc':U
     1524             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1525             ) .
     1526           run doclslib-log-information in this-procedure
     1527             (input p-log-handle
     1528             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1529                              ,string(v-prev-fact-date, '99/99/9999':u)
     1530                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1531                              )
     1532             ) .
     1533         end.
     1534         assign
     1535           v-prev-fact-date = buf_doc-list.fact-date
     1536         .
     1537       end.
     1538     end.
     1539   end procedure.
     1540   procedure doclslib-calc-ahsp :
     1541     define input  parameter p-log-handle    as handle    no-undo .
     1542     define input  parameter p-obj-type      as character no-undo .
     1543     define input  parameter p-obj-code      as integer   no-undo .
     1544     define input  parameter p-cut-date      as date      no-undo .
     1545     define input  parameter p-update-recalc as logical   no-undo .
     1546     define variable v-prev-fact-date as date      no-undo .
     1547     define buffer buf_doc-list for doc-list .
     1548     define buffer stop-ahsp-restore-lock_btpr for ub.batchprocess .
     1549     define buffer stop-ahsp-news-lock_btpr    for ub.batchprocess .
     1550     do
     1551     on error undo, return error return-value
     1552     :
     1553       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1554       run gbl/lockrngd.p
     1555         (input  'grar':U
     1556         ,input  'disable':U
     1557         ,buffer buf_lock_gdsrenart_batchprocess
     1558         ) no-error .
     1559       if error-status :error
     1560       then do:
     1561         if error-status :get-message(1) <> ""
     1562         then do:
     1563           message
     1564             vss-workfile vss-revision vss-description skip
     1565             "Ошибка при блокировании функции переименования артикула товара" skip
     1566             error-status :get-message(1) skip
     1567             return-value skip
     1568             view-as alert-box error .
     1569         end.
     1570         undo, return error return-value .
     1571       end.
     1572       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1573       run gbl/lockrngd.p
     1574         (input  'grgc':U
     1575         ,input  'disable':U
     1576         ,buffer buf_lock_gdsrengc_batchprocess
     1577         ) no-error .
     1578       if error-status :error
     1579       then do:
     1580         if error-status :get-message(1) <> ""
     1581         then do:
     1582           message
     1583             vss-workfile vss-revision vss-description skip
     1584             "Ошибка при блокировании функции переименования кода товара" skip
     1585             error-status :get-message(1) skip
     1586             return-value skip
     1587             view-as alert-box error .
     1588         end.
     1589         undo, return error return-value .
     1590       end.
     1591       for each buf_doc-list
     1592         where buf_doc-list.is-trn-doc = true
     1593       by buf_doc-list.fact-order
     1594       on error undo, return error
     1595       :
     1596         find first stop-ahsp-restore-lock_btpr no-lock
     1597           where stop-ahsp-restore-lock_btpr.bp_type       = 'lock':U + 'rsss':U
     1598             and stop-ahsp-restore-lock_btpr.bp_status     = 'N':U
     1599             and stop-ahsp-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1600             and stop-ahsp-restore-lock_btpr.Key#_Two      = 0
     1601             and stop-ahsp-restore-lock_btpr.Key#_Three    = 0
     1602             and stop-ahsp-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1603             and stop-ahsp-restore-lock_btpr.CharKey_Two   = ""
     1604             and stop-ahsp-restore-lock_btpr.CharKey_Three = ""
     1605           no-error .
     1606         if available stop-ahsp-restore-lock_btpr
     1607         then do:
     1608           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1609         end.
     1610         find first stop-ahsp-news-lock_btpr no-lock
     1611           where stop-ahsp-news-lock_btpr.bp_type       = 'lock':U + 'rssn':U
     1612             and stop-ahsp-news-lock_btpr.bp_status     = 'N':U
     1613             and stop-ahsp-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1614             and stop-ahsp-news-lock_btpr.Key#_Two      = 0
     1615             and stop-ahsp-news-lock_btpr.Key#_Three    = 0
     1616             and stop-ahsp-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1617             and stop-ahsp-news-lock_btpr.CharKey_Three = ""
     1618           no-error .
     1619         if available stop-ahsp-news-lock_btpr
     1620         then do:
     1621           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1622         end.
     1623         run doclslib-log-information in this-procedure
     1624           (input p-log-handle
     1625           ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1626                             ,buf_doc-list.doc-code
     1627                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1628                             ,buf_doc-list.fact-order
     1629                             )
     1630           ) .
     1631         define variable v-need-process as logical   no-undo .
     1632         run trg/ah-csptr.p
     1633           (input  buf_doc-list.doc-code
     1634           ,input  p-cut-date
     1635           ,input  false
     1636           ,output v-need-process
     1637           ).
     1638         run doclslib-log-information in this-procedure
     1639           (input p-log-handle
     1640           ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1641                             ,buf_doc-list.doc-code
     1642                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1643                             ,buf_doc-list.fact-order
     1644                             )
     1645           ) .
     1646         if  p-update-recalc  = true
     1647         and v-prev-fact-date <> ?
     1648         and buf_doc-list.fact-date > v-prev-fact-date
     1649         then do:
     1650           run gbl/clntat-w.p
     1651             (input p-obj-type
     1652             ,input p-obj-code
     1653             ,input 'ahsp-recalc':U
     1654             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1655             ) .
     1656           run doclslib-log-information in this-procedure
     1657             (input p-log-handle
     1658             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1659                              ,string(v-prev-fact-date, '99/99/9999':u)
     1660                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1661                              )
     1662             ) .
     1663         end.
     1664         assign
     1665           v-prev-fact-date = buf_doc-list.fact-date
     1666         .
     1667       end.
     1668     end.
     1669   end procedure.
     1670   procedure doclslib-log-information :
     1671     define input  parameter p-log-handle as handle    no-undo .
     1672     define input  parameter p-message    as character no-undo .
     1673     do
     1674     on error undo, return error return-value
     1675     :
     1676       define variable v-log-procedure-name as character no-undo .
     1677       assign
     1678         v-log-procedure-name = "cb-doclslib-log"
     1679       .
     1680       if valid-handle(p-log-handle)
     1681       and p-log-handle :get-signature(v-log-procedure-name) <> ""
     1682       then do:
     1683         run value(v-log-procedure-name) in p-log-handle
     1684           (input p-message
     1685           ) no-error .
     1686       end.
     1687     end.
     1688   end procedure.
     1689   procedure doclslib-find-last-fact-date :
     1690     define output parameter p-last-fact-date  as date      no-undo .
     1691     define output parameter p-reason          as character no-undo .
     1692     do
     1693     on error undo, return error
     1694     :
     1695       define variable v-last-fact-date    as date      no-undo .
     1696       define buffer buf_doc-list for doc-list .
     1697       assign
     1698         v-last-fact-date    = ?
     1699       .
     1700       for each buf_doc-list
     1701       by buf_doc-list.fact-order
     1702       on error undo, return error
     1703       :
     1704         if buf_doc-list.is-archive-exist = false
     1705         or buf_doc-list.fact-date = ?
     1706         then do:
     1707           assign
     1708             p-reason = p-reason + substitute("По документу &1 отсутствует рассчитанный складской архив"
     1709                                             ,buf_doc-list.doc-code
     1710                                             )
     1711           .
     1712           leave .
     1713         end.
     1714         if buf_doc-list.fact-date = ?
     1715         then do:
     1716           assign
     1717             p-reason = p-reason + substitute("Документ &1 имеет не заданную фактическую дату "
     1718                                             ,buf_doc-list.doc-code
     1719                                             )
     1720           .
     1721           leave .
     1722         end.
     1723         if v-last-fact-date = ?
     1724         or (v-last-fact-date <> ?
     1725             and v-last-fact-date < buf_doc-list.fact-date
     1726            )
     1727         then do:
     1728           assign
     1729             v-last-fact-date = buf_doc-list.fact-date
     1730             p-reason         = substitute("Последний рассчитанный документ &1" + chr(10)
     1731                                          ,buf_doc-list.doc-code
     1732                                          )
     1733           .
     1734         end.
     1735       end.
     1736       assign
     1737         p-last-fact-date = v-last-fact-date
     1738       .
     1739     end.
     1740   end procedure.
     1741   procedure doclslib-check-arh-exist :
     1742     define input parameter  p-obj-type       as character no-undo .
     1743     define input parameter  p-obj-code       as integer   no-undo .
     1744     define input parameter  p-cut-fact-order as decimal   no-undo .
     1745     define output parameter p-archive-exist  as logical   no-undo .
     1746     define buffer buf_stk-tot for ub.stk-tot .
     1747     do
     1748     on error undo, return error
     1749     :
     1750       find first buf_stk-tot no-lock
     1751         where buf_stk-tot.obj-type   = p-obj-type
     1752           and buf_stk-tot.obj-code   = p-obj-code
     1753           and buf_stk-tot.fact-order > p-cut-fact-order
     1754         no-error .
     1755       assign
     1756         p-archive-exist = (available buf_stk-tot)
     1757       .
     1758     end.
     1759   end procedure.
     1760   procedure doclslib-check-aht-exist :
     1761     define input parameter  p-obj-type       as character no-undo .
     1762     define input parameter  p-obj-code       as integer   no-undo .
     1763     define input parameter  p-cut-fact-order as decimal   no-undo .
     1764     define output parameter p-archive-exist  as logical   no-undo .
     1765     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     1766     do
     1767     on error undo, return error
     1768     :
     1769       find first buf_aht-stk-tot no-lock
     1770         where buf_aht-stk-tot.obj-type   = p-obj-type
     1771           and buf_aht-stk-tot.obj-code   = p-obj-code
     1772           and buf_aht-stk-tot.fact-order > p-cut-fact-order
     1773         no-error .
     1774       assign
     1775         p-archive-exist = (available buf_aht-stk-tot)
     1776       .
     1777     end.
     1778   end procedure.
     1779   procedure doclslib-check-ahsp-exist :
     1780     define input parameter  p-obj-type       as character no-undo .
     1781     define input parameter  p-obj-code       as integer   no-undo .
     1782     define input parameter  p-cut-fact-order as decimal   no-undo .
     1783     define output parameter p-archive-exist  as logical   no-undo .
     1784     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     1785     do
     1786     on error undo, return error
     1787     :
     1788       find first buf_stk-supp-tot no-lock
     1789         where buf_stk-supp-tot.obj-type   = p-obj-type
     1790           and buf_stk-supp-tot.obj-code   = p-obj-code
     1791           and buf_stk-supp-tot.fact-order > p-cut-fact-order
     1792         no-error .
     1793       assign
     1794         p-archive-exist = (available buf_stk-supp-tot)
     1795       .
     1796     end.
     1797   end procedure.
     1798   procedure doclslib-check-doc-arh-exist :
     1799     define buffer buf_doc-list for doc-list .
     1800     define buffer buf_ot-tot for ub.ot-tot .
     1801     do
     1802     on error undo, return error return-value
     1803     :
     1804       for each buf_doc-list
     1805       on error undo, return error
     1806       :
     1807         find first buf_ot-tot no-lock
     1808           where buf_ot-tot.doc-code = buf_doc-list.doc-code
     1809           no-error .
     1810         if available buf_ot-tot
     1811         then do:
     1812           assign
     1813             buf_doc-list.is-archive-exist = true
     1814           .
     1815         end.
     1816         else do:
     1817           assign
     1818             buf_doc-list.is-archive-exist = false
     1819           .
     1820         end.
     1821       end.
     1822     end.
     1823   end procedure.
     1824   procedure doclslib-check-doc-aht-exist :
     1825     define buffer buf_doc-list for doc-list .
     1826     define buffer buf_aht-doc for ub.aht-doc .
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       for each buf_doc-list
     1831       on error undo, return error
     1832       :
     1833         find first buf_aht-doc no-lock
     1834           where buf_aht-doc.doc-code = buf_doc-list.doc-code
     1835           no-error .
     1836         if available buf_aht-doc
     1837         then do:
     1838           assign
     1839             buf_doc-list.is-archive-exist = true
     1840           .
     1841         end.
     1842         else do:
     1843           assign
     1844             buf_doc-list.is-archive-exist = false
     1845           .
     1846         end.
     1847       end.
     1848     end.
     1849   end procedure.
     1850   procedure doclslib-check-doc-ahsp-exist :
     1851     define buffer buf_doc-list for doc-list .
     1852     define buffer buf_ot-supp-line for ub.ot-supp-tot .
     1853     do
     1854     on error undo, return error return-value
     1855     :
     1856       for each buf_doc-list
     1857       on error undo, return error
     1858       :
     1859         find first buf_ot-supp-line no-lock
     1860           where buf_ot-supp-line.doc-code = buf_doc-list.doc-code
     1861           no-error .
     1862         if available buf_ot-supp-line
     1863         then do:
     1864           assign
     1865             buf_doc-list.is-archive-exist = true
     1866           .
     1867         end.
     1868         else do:
     1869           if buf_doc-list.doc-type = 'инв':U
     1870           then do:
     1871             define variable v-need-process as logical   no-undo .
     1872             run trg/ah-csptr.p
     1873               (input  buf_doc-list.doc-code
     1874               ,input  0
     1875               ,input  true
     1876               ,output v-need-process
     1877               ).
     1878             if v-need-process = true
     1879             then do:
     1880               assign
     1881                 buf_doc-list.is-archive-exist = false
     1882               .
     1883             end.
     1884             else do:
     1885               assign
     1886                 buf_doc-list.is-archive-exist = true
     1887               .
     1888             end.
     1889           end.
     1890           else do:
     1891             assign
     1892               buf_doc-list.is-archive-exist = false
     1893             .
     1894           end.
     1895         end.
     1896       end.
     1897     end.
     1898   end procedure.
     1899   procedure doclslib-clear-ahsp-doc-list :
     1900     define buffer buf_doc-list for doc-list .
     1901     define buffer buf_trn-doc  for ub.trn-doc .
     1902     define buffer buf_doc-line for ub.doc-line .
     1903     define buffer buf_parts    for ub.parts .
     1904     do
     1905     on error undo, return error return-value
     1906     :
     1907       check-doc-list :
     1908       for each buf_doc-list
     1909       on error undo, return error return-value
     1910       :
     1911         find first buf_trn-doc no-lock
     1912           where buf_trn-doc.doc-code = buf_doc-list.doc-code
     1913           .
     1914         if buf_trn-doc.office = true
     1915         then do:
     1916           delete buf_doc-list .
     1917           next check-doc-list .
     1918         end.
     1919         find first buf_doc-line no-lock
     1920           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1921           no-error .
     1922         if not available buf_doc-line
     1923         then do:
     1924           delete buf_doc-list .
     1925           next check-doc-list .
     1926         end.
     1927         find first buf_parts no-lock
     1928           where buf_parts.out-code = buf_trn-doc.doc-code
     1929             and buf_parts.fact-qnty <> 0
     1930           no-error .
     1931         if not available buf_parts
     1932         then do:
     1933           delete buf_doc-list .
     1934           next check-doc-list .
     1935         end.
     1936       end.
     1937     end.
     1938   end procedure.
     1939   procedure doclslib-init-goods :
     1940     define buffer buf_doclslib-goods for doclslib-goods .
     1941     define buffer buf_doc-list       for doc-list .
     1942     define buffer buf_trn-doc        for ub.trn-doc .
     1943     define buffer buf_price-doc      for ub.price-doc .
     1944     define buffer buf_doc-line       for ub.doc-line .
     1945     define buffer buf_price-list     for ub.price-list .
     1946     define variable v-gds-code as integer   no-undo .
     1947     do
     1948     on error undo, return error return-value
     1949     :
     1950       for each buf_doclslib-goods
     1951       on error undo, return error return-value
     1952       :
     1953         delete buf_doclslib-goods .
     1954       end.
     1955       for each buf_doc-list
     1956       on error undo, return error return-value
     1957       :
     1958         if buf_doc-list.is-trn-doc
     1959         then do:
     1960           find first buf_trn-doc no-lock
     1961             where buf_trn-doc.doc-code = buf_doc-list.doc-code
     1962             .
     1963           for each buf_doc-line no-lock
     1964             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1965           on error undo, return error return-value
     1966           :
     1967   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1968   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1969     (input  buf_doc-line.artic
     1970     ,input  buf_doc-line.prod-type
     1971     ,input  buf_doc-line.prod-code
     1972     ,output v-gds-code
     1973     )  .
     1974             find first buf_doclslib-goods
