     2410         v-old-fact-sale     = buf_gds-obj.fact-sale
     2411       .
     2412       assign
     2413         buf_gds-obj.price-sale = v-price-sale
     2414         buf_gds-obj.fact-sale  = v-total-fact-sale
     2415       .
