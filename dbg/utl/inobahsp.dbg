     7935                                                                                                                                                                             buf_temp-stk-supp-tot.new-fact-qnty      <> 0 or    buf_temp-stk-supp-tot.new-sum-base       <> 0 or    buf_temp-stk-supp-tot.new-sum-rubl       <> 0 or    buf_temp-stk-supp-tot.new-vat-base       <> 0 or    buf_temp-stk-supp-tot.new-vat-rubl       <> 0 or    buf_temp-stk-supp-tot.new-slt-base       <> 0 or    buf_temp-stk-supp-tot.new-slt-rubl       <> 0 or    buf_temp-stk-supp-tot.new-road-tax-base  <> 0 or    buf_temp-stk-supp-tot.new-road-tax-rubl  <> 0 or    buf_temp-stk-supp-tot.new-excise-base    <> 0 or    buf_temp-stk-supp-tot.new-excise-rubl    <> 0 or    buf_temp-stk-supp-tot.new-transport-base <> 0 or    buf_temp-stk-supp-tot.new-transport-rubl <> 0 or    buf_temp-stk-supp-tot.new-other-base     <> 0 or    buf_temp-stk-supp-tot.new-other-rubl     <> 0
     7936                                 or ( buf_temp-stk-supp-tot.cat-id = '##':U )
     7937           .
     7938           find first buf_stk-supp-tot exclusive-lock
     7939             where buf_stk-supp-tot.obj-type   = buf_temp-stk-supp-tot.obj-type
     7940               and buf_stk-supp-tot.obj-code   = buf_temp-stk-supp-tot.obj-code
     7941               and buf_stk-supp-tot.cli-type   = buf_temp-stk-supp-tot.cli-type
     7942               and buf_stk-supp-tot.cli-code   = buf_temp-stk-supp-tot.cli-code
     7943               and buf_stk-supp-tot.fact-order = buf_temp-stk-supp-tot.fact-order
     7944               and buf_stk-supp-tot.sum-type   = buf_temp-stk-supp-tot.sum-type
     7945               and buf_stk-supp-tot.cat-id     = buf_temp-stk-supp-tot.cat-id
     7946             no-error .
     7947           if l-need-create-record
     7948           then do:
     7949             if not available buf_stk-supp-tot
     7950             then do:
     7951               create buf_stk-supp-tot .
     7952             end.
     7953             buffer-copy buf_temp-stk-supp-tot to buf_stk-supp-tot
     7954             assign
     7955                                                                                       buf_stk-supp-tot.fact-qnty      = buf_temp-stk-supp-tot.new-fact-qnty            buf_stk-supp-tot.sum-base       = buf_temp-stk-supp-tot.new-sum-base             buf_stk-supp-tot.sum-rubl       = buf_temp-stk-supp-tot.new-sum-rubl             buf_stk-supp-tot.vat-base       = buf_temp-stk-supp-tot.new-vat-base             buf_stk-supp-tot.vat-rubl       = buf_temp-stk-supp-tot.new-vat-rubl             buf_stk-supp-tot.slt-base       = buf_temp-stk-supp-tot.new-slt-base             buf_stk-supp-tot.slt-rubl       = buf_temp-stk-supp-tot.new-slt-rubl             buf_stk-supp-tot.road-tax-base  = buf_temp-stk-supp-tot.new-road-tax-base        buf_stk-supp-tot.road-tax-rubl  = buf_temp-stk-supp-tot.new-road-tax-rubl        buf_stk-supp-tot.excise-base    = buf_temp-stk-supp-tot.new-excise-base          buf_stk-supp-tot.excise-rubl    = buf_temp-stk-supp-tot.new-excise-rubl          buf_stk-supp-tot.transport-base = buf_temp-stk-supp-tot.new-transport-base       buf_stk-supp-tot.transport-rubl = buf_temp-stk-supp-tot.new-transport-rubl       buf_stk-supp-tot.other-base     = buf_temp-stk-supp-tot.new-other-base           buf_stk-supp-tot.other-rubl     = buf_temp-stk-supp-tot.new-other-rubl
     7956             .
     7957           end.
     7958           else do:
     7959             if available buf_stk-supp-tot
     7960             then do:
     7961               delete buf_stk-supp-tot .
     7962             end.
     7963           end.
     7964         end.
     7965       end.
     7966       if p-shift-on
     7967       then do:
     7968         for each buf_temp-stk-supp-tot
     7969         on error undo, return error return-value
     7970         :
     7971           if
     7972                                                           buf_temp-stk-supp-tot.fact-qnty      <> buf_temp-stk-supp-tot.new-fact-qnty        or    buf_temp-stk-supp-tot.sum-base       <> buf_temp-stk-supp-tot.new-sum-base         or    buf_temp-stk-supp-tot.sum-rubl       <> buf_temp-stk-supp-tot.new-sum-rubl         or    buf_temp-stk-supp-tot.vat-base       <> buf_temp-stk-supp-tot.new-vat-base         or    buf_temp-stk-supp-tot.vat-rubl       <> buf_temp-stk-supp-tot.new-vat-rubl         or    buf_temp-stk-supp-tot.slt-base       <> buf_temp-stk-supp-tot.new-slt-base         or    buf_temp-stk-supp-tot.slt-rubl       <> buf_temp-stk-supp-tot.new-slt-rubl         or    buf_temp-stk-supp-tot.road-tax-base  <> buf_temp-stk-supp-tot.new-road-tax-base    or    buf_temp-stk-supp-tot.road-tax-rubl  <> buf_temp-stk-supp-tot.new-road-tax-rubl    or    buf_temp-stk-supp-tot.excise-base    <> buf_temp-stk-supp-tot.new-excise-base      or    buf_temp-stk-supp-tot.excise-rubl    <> buf_temp-stk-supp-tot.new-excise-rubl      or    buf_temp-stk-supp-tot.transport-base <> buf_temp-stk-supp-tot.new-transport-base   or    buf_temp-stk-supp-tot.transport-rubl <> buf_temp-stk-supp-tot.new-transport-rubl   or    buf_temp-stk-supp-tot.other-base     <> buf_temp-stk-supp-tot.new-other-base       or    buf_temp-stk-supp-tot.other-rubl     <> buf_temp-stk-supp-tot.new-other-rubl
     7973           or ( buf_temp-stk-supp-tot.cat-id = '##':U )
     7974           then do:
     7975             assign
     7976               l-need-create-record =
     7977                                                                                                                                                                                       buf_temp-stk-supp-tot.new-fact-qnty      <> 0 or    buf_temp-stk-supp-tot.new-sum-base       <> 0 or    buf_temp-stk-supp-tot.new-sum-rubl       <> 0 or    buf_temp-stk-supp-tot.new-vat-base       <> 0 or    buf_temp-stk-supp-tot.new-vat-rubl       <> 0 or    buf_temp-stk-supp-tot.new-slt-base       <> 0 or    buf_temp-stk-supp-tot.new-slt-rubl       <> 0 or    buf_temp-stk-supp-tot.new-road-tax-base  <> 0 or    buf_temp-stk-supp-tot.new-road-tax-rubl  <> 0 or    buf_temp-stk-supp-tot.new-excise-base    <> 0 or    buf_temp-stk-supp-tot.new-excise-rubl    <> 0 or    buf_temp-stk-supp-tot.new-transport-base <> 0 or    buf_temp-stk-supp-tot.new-transport-rubl <> 0 or    buf_temp-stk-supp-tot.new-other-base     <> 0 or    buf_temp-stk-supp-tot.new-other-rubl     <> 0
     7978                                   or ( buf_temp-stk-supp-tot.cat-id = '##':U )
     7979             .
     7980             find first buf_stk-supp-tot exclusive-lock
     7981               where buf_stk-supp-tot.obj-type   = buf_temp-stk-supp-tot.obj-type
     7982                 and buf_stk-supp-tot.obj-code   = buf_temp-stk-supp-tot.obj-code
     7983                 and buf_stk-supp-tot.cli-type   = buf_temp-stk-supp-tot.cli-type
     7984                 and buf_stk-supp-tot.cli-code   = buf_temp-stk-supp-tot.cli-code
     7985                 and buf_stk-supp-tot.fact-order = p-shift-end-fact-order
     7986                 and buf_stk-supp-tot.sum-type   = buf_temp-stk-supp-tot.sum-type
     7987                 and buf_stk-supp-tot.cat-id     = buf_temp-stk-supp-tot.cat-id
     7988               no-error .
     7989             if l-need-create-record
     7990             then do:
     7991               if not available buf_stk-supp-tot
     7992               then do:
     7993                 create buf_stk-supp-tot .
     7994               end.
     7995               buffer-copy buf_temp-stk-supp-tot to buf_stk-supp-tot
     7996               assign
     7997                 buf_stk-supp-tot.fact-order = p-shift-end-fact-order
     7998                 buf_stk-supp-tot.shift-date = p-shift-date
     7999                 buf_stk-supp-tot.shift-num  = p-shift-num
     8000                                                                                                     buf_stk-supp-tot.fact-qnty      = buf_temp-stk-supp-tot.new-fact-qnty            buf_stk-supp-tot.sum-base       = buf_temp-stk-supp-tot.new-sum-base             buf_stk-supp-tot.sum-rubl       = buf_temp-stk-supp-tot.new-sum-rubl             buf_stk-supp-tot.vat-base       = buf_temp-stk-supp-tot.new-vat-base             buf_stk-supp-tot.vat-rubl       = buf_temp-stk-supp-tot.new-vat-rubl             buf_stk-supp-tot.slt-base       = buf_temp-stk-supp-tot.new-slt-base             buf_stk-supp-tot.slt-rubl       = buf_temp-stk-supp-tot.new-slt-rubl             buf_stk-supp-tot.road-tax-base  = buf_temp-stk-supp-tot.new-road-tax-base        buf_stk-supp-tot.road-tax-rubl  = buf_temp-stk-supp-tot.new-road-tax-rubl        buf_stk-supp-tot.excise-base    = buf_temp-stk-supp-tot.new-excise-base          buf_stk-supp-tot.excise-rubl    = buf_temp-stk-supp-tot.new-excise-rubl          buf_stk-supp-tot.transport-base = buf_temp-stk-supp-tot.new-transport-base       buf_stk-supp-tot.transport-rubl = buf_temp-stk-supp-tot.new-transport-rubl       buf_stk-supp-tot.other-base     = buf_temp-stk-supp-tot.new-other-base           buf_stk-supp-tot.other-rubl     = buf_temp-stk-supp-tot.new-other-rubl
     8001               .
     8002             end.
     8003             else do:
     8004               if available buf_stk-supp-tot
     8005               then do:
     8006                 delete buf_stk-supp-tot .
     8007               end.
     8008             end.
     8009           end.
     8010         end.
     8011       end.
     8012     end.
     8013   end procedure.
     8014   procedure clear-tot :
     8015     define buffer buf_temp-stk-supp-tot for temp-stk-supp-tot .
     8016     do
     8017     on error undo, return error return-value
     8018     :
     8019       for each buf_temp-stk-supp-tot
     8020       on error undo, return error return-value
     8021       :
     8022         delete buf_temp-stk-supp-tot .
     8023       end.
     8024     end.
     8025   end procedure.
     8026   procedure clear-line :
     8027     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     8028     do
     8029     on error undo, return error return-value
     8030     :
     8031       for each buf_temp-stk-supp-line
     8032       on error undo, return error return-value
     8033       :
     8034         delete buf_temp-stk-supp-line .
     8035       end.
     8036     end.
     8037   end procedure.
     8038   procedure clear-db :
     8039     define buffer buf_stk-supp-line for ub.stk-supp-line .
     8040     define buffer buf_stk-supp-tot  for ub.stk-supp-tot .
     8041     define buffer buf_ot-supp-line  for ub.ot-supp-line .
     8042     define buffer buf_ot-supp-tot   for ub.ot-supp-tot .
     8043     do
     8044     on error undo, return error return-value
     8045     :
     8046       define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
     8047       define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
     8048       define variable v-ind as integer   no-undo .
     8049       form
     8050         p-obj-type p-obj-code skip
     8051         v-ind skip
     8052         with frame a view-as dialog-box side-labels three-d
     8053         title "Удаление складского архива по поставщикам" .
     8054       display
     8055         p-obj-type p-obj-code
     8056         v-ind
     8057         with frame a .
     8058       for each buf_stk-supp-line exclusive-lock
     8059         where buf_stk-supp-line.obj-type = p-obj-type
     8060           and buf_stk-supp-line.obj-code = p-obj-code
     8061       on error undo, return error return-value
     8062       :
     8063         assign
     8064           v-ind = v-ind + 1
     8065         .
     8066         if v-ind mod 10 = 0
     8067         then do:
     8068           display
     8069             v-ind skip
     8070             with frame a .
     8071         end.
     8072         delete buf_stk-supp-line .
     8073       end.
     8074       for each buf_stk-supp-tot exclusive-lock
     8075         where buf_stk-supp-tot.obj-type = p-obj-type
     8076           and buf_stk-supp-tot.obj-code = p-obj-code
     8077       on error undo, return error return-value
     8078       :
     8079         assign
     8080           v-ind = v-ind + 1
     8081         .
     8082         if v-ind mod 10 = 0
     8083         then do:
     8084           display
     8085             v-ind skip
     8086             with frame a .
     8087         end.
     8088         delete buf_stk-supp-tot .
     8089       end.
     8090       for each buf_ot-supp-line exclusive-lock
     8091         where buf_ot-supp-line.obj-type = p-obj-type
     8092           and buf_ot-supp-line.obj-code = p-obj-code
     8093       on error undo, return error return-value
     8094       :
     8095         assign
     8096           v-ind = v-ind + 1
     8097         .
     8098         if v-ind mod 10 = 0
     8099         then do:
     8100           display
     8101             v-ind skip
     8102             with frame a .
     8103         end.
     8104         delete buf_ot-supp-line .
     8105       end.
     8106       for each buf_ot-supp-tot exclusive-lock
     8107         where buf_ot-supp-tot.obj-type = p-obj-type
     8108           and buf_ot-supp-tot.obj-code = p-obj-code
     8109       on error undo, return error return-value
     8110       :
     8111         assign
     8112           v-ind = v-ind + 1
     8113         .
     8114         if v-ind mod 10 = 0
     8115         then do:
     8116           display
     8117             v-ind skip
     8118             with frame a .
     8119         end.
     8120         delete buf_ot-supp-tot .
     8121       end.
     8122     end.
     8123   end procedure.
     8124   procedure log-clear :
     8125     do
     8126     on error undo, return error return-value
     8127     :
     8128       output stream slog to value(v-log-file-name) .
     8129       output stream slog close .
     8130     end.
     8131   end procedure.
     8132   procedure log-information :
     8133     do
     8134     on error undo, return error return-value
     8135     :
     8136       define input parameter p-obj-type as character no-undo .
     8137       define input parameter p-obj-code as integer   no-undo .
     8138       define input parameter p-message  as character no-undo .
     8139       output stream slog to value(v-log-file-name) append .
     8140       export stream slog
     8141         p-obj-type
     8142         p-obj-code
     8143         cur-time-string()
     8144         p-message .
     8145       output stream slog close .
     8146     end.
     8147   end procedure.
     8148   procedure clear-batch-ahsp :
     8149     define input parameter p-obj-type as character no-undo .
     8150     define input parameter p-obj-code as integer   no-undo .
     8151     define input parameter p-cut-date as date      no-undo .
     8152     do
     8153     on error undo, return error return-value
     8154     :
     8155       define buffer buf_batchprocess for ub.batchprocess .
     8156       define buffer delete_batchprocess for ub.batchprocess .
     8157       define buffer buf_trn-doc for ub.trn-doc .
     8158       for each buf_batchprocess no-lock
     8159         where buf_batchprocess.bp_type = 'ahsp':U
     8160       on error undo, return error return-value
     8161       :
     8162         case buf_batchprocess.charkey_two :
     8163           when 'trn-doc':U
     8164           then do:
     8165             find first buf_trn-doc no-lock
     8166               where buf_trn-doc.doc-code = buf_batchprocess.charkey_one
     8167               no-error .
     8168             if (available buf_trn-doc
     8169             and buf_trn-doc.obj-type  = p-obj-type
     8170             and buf_trn-doc.obj-code  = p-obj-code
     8171             and buf_trn-doc.fact-date < p-cut-date
     8172                )
     8173             or not available buf_trn-doc
     8174             then do:
     8175               find delete_batchprocess exclusive-lock
     8176                 where recid(delete_batchprocess) = recid(buf_batchprocess)
     8177                 no-error .
     8178               delete delete_batchprocess .
     8179             end.
     8180           end.
     8181           otherwise do:
     8182             message
     8183               vss-workfile vss-revision vss-description skip
     8184               "Неизвестный тип таблицы" skip
     8185               "charkey_one"  buf_batchprocess.charkey_one skip
     8186               "charkey_two"  buf_batchprocess.charkey_two skip
     8187               view-as alert-box error .
     8188             undo, return error .
     8189           end.
     8190         end case .
     8191       end.
     8192     end.
     8193   end procedure.
     8194   procedure invalidate-md5-signature :
     8195     define input  parameter p-obj-type     as character no-undo .
     8196     define input  parameter p-obj-code     as integer   no-undo .
     8197     define input  parameter p-archive-type as character no-undo .
     8198     define input  parameter p-chip-num     as integer   no-undo .
     8199     define buffer buf_archive-history for ub.archive-history .
     8200     do
     8201     on error undo, return error return-value
     8202     :
     8203       for each buf_archive-history exclusive-lock
     8204         where buf_archive-history.obj-type     = p-obj-type
     8205           and buf_archive-history.obj-code     = p-obj-code
     8206           and buf_archive-history.archive-type = p-archive-type
     8207           and buf_archive-history.file-valid   = true
     8208       on error undo, return error return-value
     8209       :
     8210         assign
     8211           buf_archive-history.file-valid            = false
     8212           buf_archive-history.file-invalid-chip-num = p-chip-num
     8213         .
     8214       end.
     8215     end.
     8216   end procedure.
