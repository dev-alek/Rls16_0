     6149       bfs_tt-allsum.slt-rubl-doc        =  - bf_tt-allsum.slt-rubl-doc
     6150       bfs_tt-allsum.road-tax-base-doc   =  - bf_tt-allsum.road-tax-base-doc
     6151       bfs_tt-allsum.road-tax-rubl-doc   =  - bf_tt-allsum.road-tax-rubl-doc
     6152       bfs_tt-allsum.excise-base-doc     =  - bf_tt-allsum.excise-base-doc
     6153       bfs_tt-allsum.excise-rubl-doc     =  - bf_tt-allsum.excise-rubl-doc
     6154       bfs_tt-allsum.sum-dsc-base-cur    =  - bf_tt-allsum.sum-dsc-base-cur
     6155       bfs_tt-allsum.sum-dsc-rubl-cur    =  - bf_tt-allsum.sum-dsc-rubl-cur
     6156       bfs_tt-allsum.dsc-base-cur        =  - bf_tt-allsum.dsc-base-cur
     6157       bfs_tt-allsum.dsc-rubl-cur        =  - bf_tt-allsum.dsc-rubl-cur
     6158       bfs_tt-allsum.vat-base-cur        =  - bf_tt-allsum.vat-base-cur
     6159       bfs_tt-allsum.vat-rubl-cur        =  - bf_tt-allsum.vat-rubl-cur
     6160       bfs_tt-allsum.vat-base-buyer-cur  =  - bf_tt-allsum.vat-base-buyer-cur
     6161       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
     6162       bfs_tt-allsum.slt-base-cur        =  - bf_tt-allsum.slt-base-cur
     6163       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     6164       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     6165       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     6166       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     6167       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     6168       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     6169       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     6170       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     6171       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     6172       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     6173       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     6174       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     6175       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     6176       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     6177       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     6178       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     6179       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     6180       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
