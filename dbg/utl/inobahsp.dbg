     4096   procedure partslib-update-by-factord :
     4097     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     4098     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     4099     define input parameter p-artic              like ub.parts.artic     no-undo .
     4100     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     4101     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     4102     define input parameter p-start-fact-order   as decimal   no-undo .
     4103     define input parameter p-end-fact-order     as decimal   no-undo .
     4104     define input parameter p-lock-gds-obj       as logical   no-undo .
     4105     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     4106     define buffer buf_gds-obj  for ub.gds-obj .
     4107     define buffer buf_doc-line for ub.doc-line .
     4108     define variable v-total-parts-qnty as decimal   no-undo .
     4109     define variable v-goods-gds-goods  as logical   no-undo .
     4110     define variable v-goods-twounit    as logical   no-undo .
     4111     do
     4112     on error undo, return error
     4113     :
     4114       if p-start-fact-order > p-end-fact-order
     4115       then do:
     4116         message
     4117           vss-workfile vss-revision vss-description skip
     4118           vss-include-info26 skip
     4119           "Ошибка задания входных параметров" skip
     4120           "Начало интервала превышает конец интервала" skip
     4121           "Объект" p-obj-type p-obj-code skip
     4122           "Артикул" p-artic p-prod-type p-prod-code skip
     4123           "p-start-fact-order" p-start-fact-order skip
     4124           "p-end-fact-order"   p-end-fact-order skip
     4125           view-as alert-box error .
     4126         undo, return error .
     4127       end.
     4128       if p-lock-gds-obj = true
     4129       then do:
     4130         do transaction
     4131         on error undo, return error
     4132         :
     4133   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4135     (input  p-obj-type
     4136     ,input  p-obj-code
     4137     ,input  p-artic
     4138     ,input  p-prod-type
     4139     ,input  p-prod-code
     4140     ,buffer buf_gds-obj
     4141     ) no-error .
     4142           if error-status :error
     4143           then do:
     4144             message
     4145               vss-workfile vss-revision vss-description skip
     4146               vss-include-info26 skip
     4147               "Невозможно найти gds-obj" skip
     4148               error-status :get-message(1) skip
     4149               return-value skip
     4150               view-as alert-box error .
     4151             undo, return error .
     4152           end.
     4153           find current buf_gds-obj exclusive-lock .
     4154         end.
     4155       end.
     4156   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4157   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4158     (input  p-artic
     4159     ,input  p-prod-type
     4160     ,input  p-prod-code
     4161     ,input  'gds-goods=request':u
     4162     ,output v-goods-gds-goods
     4163     ) no-error .
     4164       if error-status :error
     4165       then do:
     4166         message
     4167           vss-workfile vss-revision vss-description skip
     4168           vss-include-info26 skip
     4169           "Ошибка при определении атрибута товара" skip
     4170           "Артикул" p-artic p-prod-type p-prod-code skip
     4171           "gds-goods=request" skip
     4172           error-status :get-message(1) skip
     4173           return-value skip
     4174           view-as alert-box error .
     4175         undo, return error return-value .
     4176       end.
     4177   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4178   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4179     (input  p-artic
     4180     ,input  p-prod-type
     4181     ,input  p-prod-code
     4182     ,input  'twounit=request':u
     4183     ,output v-goods-twounit
     4184     ) no-error .
     4185       if error-status :error
     4186       then do:
     4187         message
     4188           vss-workfile vss-revision vss-description skip
     4189           vss-include-info26 skip
     4190           "Ошибка при определении атрибута товара" skip
     4191           "Артикул" p-artic p-prod-type p-prod-code skip
     4192           "twounit=request" skip
     4193           error-status :get-message(1) skip
     4194           return-value skip
     4195           view-as alert-box error .
     4196         undo, return error return-value .
     4197       end.
     4198       for each buf_doc-line no-lock
     4199         where buf_doc-line.obj-type   = p-obj-type
     4200           and buf_doc-line.obj-code   = p-obj-code
     4201           and buf_doc-line.artic      = p-artic
     4202           and buf_doc-line.prod-type  = p-prod-type
     4203           and buf_doc-line.prod-code  = p-prod-code
     4204           and buf_doc-line.status_    = 'факт':U
     4205           and buf_doc-line.fact-order > p-start-fact-order
     4206           and buf_doc-line.fact-order <= p-end-fact-order
     4207       on error undo, return error
     4208       :
     4209         run partslib-process-document in this-procedure
     4210           (input  buf_doc-line.doc-code
     4211           ,input  p-obj-type
     4212           ,input  p-obj-code
     4213           ,input  p-artic
     4214           ,input  p-prod-type
     4215           ,input  p-prod-code
     4216           ,input  v-goods-gds-goods
     4217           ,input  v-goods-twounit
     4218           ,output v-total-parts-qnty
     4219           ) no-error .
     4220         if error-status :error
     4221         then do:
     4222           message
     4223             vss-workfile vss-revision vss-description skip
     4224             vss-include-info26 skip
     4225             "Ошибка при вызове процедуры partslib-process-document" skip
     4226             "Документ" buf_doc-line.doc-code skip
     4227             "Объект" p-obj-type p-obj-code skip
     4228             "Артикул" p-artic p-prod-type p-prod-code skip
     4229             "p-start-fact-order" p-start-fact-order skip
     4230             "p-end-fact-order" p-end-fact-order skip
     4231             error-status :get-message(1) skip
     4232             return-value skip
     4233             view-as alert-box error .
     4234           undo, return error return-value .
     4235         end.
     4236       end.
     4237     end.
     4238   end procedure.
     4239   procedure partslib-process-document :
     4240     define input  parameter p-doc-code         as character no-undo .
     4241     define input  parameter p-obj-type         as character no-undo .
     4242     define input  parameter p-obj-code         as integer   no-undo .
     4243     define input  parameter p-artic            as character no-undo .
     4244     define input  parameter p-prod-type        as character no-undo .
     4245     define input  parameter p-prod-code        as integer   no-undo .
     4246     define input  parameter p-goods-gds-goods  as logical   no-undo .
     4247     define input  parameter p-goods-twounit    as logical   no-undo .
     4248     define output parameter p-total-parts-qnty as decimal   no-undo .
     4249     define variable v-parts-sign as integer   no-undo .
     4250     define buffer buf_trn-doc    for ub.trn-doc .
     4251     define buffer buf_doc-line   for ub.doc-line .
     4252     define buffer buf_parts      for ub.parts .
     4253     define buffer buf_temp-parts for temp-parts .
     4254     do
     4255     on error undo, return error return-value
     4256     :
     4257       find first buf_trn-doc no-lock
     4258         where buf_trn-doc.doc-code = p-doc-code
     4259         no-error .
     4260       if not available buf_trn-doc
     4261       then do:
     4262         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     4263                                      ,p-doc-code
     4264                                      ) .
     4265       end.
     4266       case buf_trn-doc.doc-type
     4267       :
     4268         when 'при':U or
     4269         when 'возврат':U or
     4270         when 'инв':U
     4271         then do:
     4272           assign
     4273             v-parts-sign = -1
     4274           .
     4275         end.
     4276         when 'рас':U or
     4277         when 'спи':U
     4278         then do:
     4279           assign
     4280             v-parts-sign = 1
     4281           .
     4282         end.
     4283         otherwise do:
     4284           undo, return error substitute("Неизвестный тип документа &1"
     4285                                       ,buf_trn-doc.doc-type
     4286                                       ) .
     4287         end.
     4288       end.
     4289       find first buf_doc-line no-lock
     4290         where buf_doc-line.doc-code  = p-doc-code
     4291           and buf_doc-line.artic     = p-artic
     4292           and buf_doc-line.prod-type = p-prod-type
     4293           and buf_doc-line.prod-code = p-prod-code
     4294         no-error .
     4295       if not available buf_doc-line
     4296       then do:
     4297         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     4298                                      ,p-doc-code
     4299                                      ,artic
     4300                                      ,prod-type
     4301                                      ,prod-code
     4302                                      ) .
     4303       end.
     4304       assign
     4305         p-total-parts-qnty = 0
     4306       .
     4307       if p-goods-gds-goods = true
     4308       then do:
     4309         for each buf_parts no-lock
     4310           where buf_parts.out-code  = p-doc-code
     4311             and buf_parts.obj-type  = p-obj-type
     4312             and buf_parts.obj-code  = p-obj-code
     4313             and buf_parts.artic     = p-artic
     4314             and buf_parts.prod-type = p-prod-type
     4315             and buf_parts.prod-code = p-prod-code
     4316         on error undo, return error
     4317         :
     4318           run partslib-create-temp-parts in this-procedure
     4319             (buffer buf_parts
     4320             ,buffer buf_temp-parts
     4321             ,input  p-goods-twounit
     4322             ) .
     4323           assign
     4324             p-total-parts-qnty        = p-total-parts-qnty
     4325                                       + v-parts-sign * buf_parts.fact-qnty
     4326             buf_temp-parts.qnty       = buf_temp-parts.qnty
     4327                                       + v-parts-sign * buf_parts.fact-qnty
     4328             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     4329                                       + v-parts-sign * buf_parts.fact-qnty
     4330             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     4331                                       + v-parts-sign * buf_parts.cli-qnty
     4332           .
     4333           if buf_temp-parts.qnty = 0
     4334           then do:
     4335             delete buf_temp-parts .
     4336           end.
     4337         end.
     4338       end.
     4339       else do:
     4340         assign
     4341           p-total-parts-qnty = p-total-parts-qnty
     4342                              + v-parts-sign * buf_doc-line.fact-qnty
     4343         .
     4344       end.
     4345     end.
     4346   end procedure.
     4347   procedure partslib-init-temp-parts-by-date :
     4348     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     4349     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     4350     define input parameter p-artic           like ub.parts.artic     no-undo .
     4351     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     4352     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     4353     define input parameter p-fact-date       as date      no-undo .
     4354     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     4355     do
     4356     on error undo, return error
     4357     :
     4358       define variable v-fact-order                as decimal   no-undo .
     4359       define variable v-shift-end-fact-order      as decimal   no-undo .
     4360       define variable v-day-end-fact-order        as decimal   no-undo .
     4361       run factord in this-procedure
     4362         (input  p-fact-date
     4363         ,input  1
     4364         ,input  1
     4365         ,input  ?
     4366         ,input  0
     4367         ,input  false
     4368         ,output v-fact-order
     4369         ,output v-shift-end-fact-order
     4370         ,output v-day-end-fact-order
     4371         ) no-error .
     4372       if error-status :error
     4373       then do:
     4374         message
     4375           vss-workfile vss-revision vss-description skip
     4376           vss-include-info26 skip
     4377           "Ошибка при определении момента времени, на который требуется остаток" skip
     4378           "Объект" p-obj-type p-obj-code skip
     4379           "Артикул" p-artic p-prod-type p-prod-code skip
     4380           "Дата" p-fact-date skip
     4381           view-as alert-box error .
     4382         undo, return error .
     4383       end.
     4384       run partslib-init-temp-parts-by-factord in this-procedure
     4385         (input p-obj-type
     4386         ,input p-obj-code
     4387         ,input p-artic
     4388         ,input p-prod-type
     4389         ,input p-prod-code
     4390         ,input v-day-end-fact-order
     4391         ,input false
     4392         ) no-error .
     4393       if error-status :error
     4394       then do:
     4395         message
     4396           vss-workfile vss-revision vss-description skip
     4397           vss-include-info26 skip
     4398           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     4399           "Объект" p-obj-type p-obj-code skip
     4400           "Артикул" p-artic p-prod-type p-prod-code skip
     4401           "Дата" p-fact-date skip
     4402           view-as alert-box error .
     4403         undo, return error .
     4404       end.
     4405     end.
     4406   end procedure.
     4407   procedure partslib-calc-cost :
     4408     define output parameter p-fact-qnty      as decimal   no-undo .
     4409     define output parameter p-vat-pc         as decimal   no-undo .
     4410     define output parameter p-slt-pc         as decimal   no-undo .
     4411     define output parameter p-sum-base       as decimal   no-undo .
     4412     define output parameter p-sum-rubl       as decimal   no-undo .
     4413     define output parameter p-vat-base       as decimal   no-undo .
     4414     define output parameter p-vat-rubl       as decimal   no-undo .
     4415     define output parameter p-slt-base       as decimal   no-undo .
     4416     define output parameter p-slt-rubl       as decimal   no-undo .
     4417     define output parameter p-road-tax-base  as decimal   no-undo .
     4418     define output parameter p-road-tax-rubl  as decimal   no-undo .
     4419     define output parameter p-transport-base as decimal   no-undo .
     4420     define output parameter p-transport-rubl as decimal   no-undo .
     4421     define output parameter p-other-base     as decimal   no-undo .
     4422     define output parameter p-other-rubl     as decimal   no-undo .
     4423     define output parameter p-excise-base    as decimal   no-undo .
     4424     define output parameter p-excise-rubl    as decimal   no-undo .
     4425     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     4426     do
     4427     on error undo, return error return-value
     4428     :
     4429       define buffer buf_temp-parts for temp-parts .
     4430       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     4431       define buffer   in-vatp-parts    for ub.parts   .
     4432       define buffer   in-vatp-doc      for ub.trn-doc .
     4433       define buffer   in-vatp-goods    for ub.goods   .
     4434       define buffer   in-vatp-sysconf  for ub.sysconf .
     4435       define buffer   in-vatp_doc-attr for ub.doc-attr.
     4436       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     4437       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     4438       define variable varinvprb                  as   character              no-undo.
     4439       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     4440       define variable cli-base-rate              as   decimal                no-undo.
     4441       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     4442       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     4443       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     4444       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     4445       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     4446       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     4447       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     4448       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4449       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     4450       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     4451       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4452       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     4453       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     4454       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     4455       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     4456       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     4457       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     4458       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     4459       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     4460       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     4461       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     4462       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     4463       define variable varinvatp-envd             as   character              no-undo.
     4464       define variable varinvatp-type             as   character              no-undo.
     4465       for each buf_temp-parts
     4466       on error undo, return error
     4467       :
     4468   assign
     4469     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     4470     price-base-with-tax-loc = buf_temp-parts.price-base
     4471   .
     4472   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4473   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4474     (output varinvprb
     4475     )  .
     4476     if buf_temp-parts.out-code = 'free-zone':U     or
     4477        buf_temp-parts.out-code = 'out-zone':U   or
     4478        buf_temp-parts.doc-type = 'акт':U then do:
     4479       assign
     4480         in-vatp-have-vat-slt = yes.
     4481     end.
     4482     else do:
     4483       find first in-vatp_doc-attr no-lock
     4484         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     4485           and in-vatp_doc-attr.attr-code = 'envd':U
     4486         no-error .
     4487       if not available in-vatp_doc-attr then do:
     4488         assign
     4489           in-vatp-have-vat-slt = yes.
     4490       end.
     4491       else do:
     4492            in-vatp-have-vat-slt = no.
     4493       end.
     4494     end.
     4495     assign
     4496      price-cli-with-tax-loc = buf_temp-parts.price-cli
     4497      cli-base-rate          = buf_temp-parts.cli-base-rate.
     4498     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     4499              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     4500     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     4501             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     4502             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     4503             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     4504             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     4505             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     4506             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4507       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4508     assign
     4509       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     4510     assign
     4511       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     4512       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     4513       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     4514       transport-cli-loc  = 0
     4515       other-cli-loc      = 0
     4516     .
     4517   ASSIGN
     4518             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4519       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4520   .
     4521         assign
     4522           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     4523           p-vat-pc         = p-vat-pc         + vat-pc-loc
     4524           p-slt-pc         = p-slt-pc         + slt-pc-loc
     4525           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     4526           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     4527           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     4528           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     4529           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     4530           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     4531           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     4532           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     4533           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     4534           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     4535           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     4536           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     4537           p-excise-base    = p-excise-base    + 0
     4538           p-excise-rubl    = p-excise-rubl    + 0
     4539         .
     4540       end.
     4541       if p-fact-qnty      = ?
     4542       or p-sum-base       = ?
     4543       or p-sum-rubl       = ?
     4544       or p-vat-base       = ?
     4545       or p-vat-rubl       = ?
     4546       or p-slt-base       = ?
     4547       or p-slt-rubl       = ?
     4548       or p-road-tax-base  = ?
     4549       or p-road-tax-rubl  = ?
     4550       or p-transport-base = ?
     4551       or p-transport-rubl = ?
     4552       or p-other-base     = ?
     4553       or p-other-rubl     = ?
     4554       or p-excise-base    = ?
     4555       or p-excise-rubl    = ?
     4556       then do:
     4557         message
     4558           vss-workfile vss-revision vss-description skip
     4559           vss-include-info26 skip
     4560           "Программа in-vatp.i вернула неопределенные значения" skip
     4561           "p-fact-qnty"      p-fact-qnty      skip
     4562           "p-sum-base"       p-sum-base       skip
     4563           "p-sum-rubl"       p-sum-rubl       skip
     4564           "p-vat-base"       p-vat-base       skip
     4565           "p-vat-rubl"       p-vat-rubl       skip
     4566           "p-slt-base"       p-slt-base       skip
     4567           "p-slt-rubl"       p-slt-rubl       skip
     4568           "p-road-tax-base"  p-road-tax-base  skip
     4569           "p-road-tax-rubl"  p-road-tax-rubl  skip
     4570           "p-transport-base" p-transport-base skip
     4571           "p-transport-rubl" p-transport-rubl skip
     4572           "p-other-base"     p-other-base     skip
     4573           "p-other-rubl"     p-other-rubl     skip
     4574           "p-excise-base"    p-excise-base    skip
     4575           "p-excise-rubl"    p-excise-rubl    skip
     4576           view-as alert-box error .
     4577         undo, return error .
     4578       end.
     4579     end.
     4580   end procedure.
     4581   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4582   procedure prl-vat:
     4583     define input parameter parrecid as recid no-undo.
     4584       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     4585       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     4586       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     4587       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     4588       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     4589       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     4590       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     4591       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     4592       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     4593       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     4594       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     4595       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     4596       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
     4597       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
     4598       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
     4599       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
     4600       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
     4601       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
     4602       define buffer out-vatp_partsprl       for ub.parts.
     4603       define buffer out-vatp_sysconfprl     for ub.sysconf.
     4604       define buffer out-vatp_doc-lineprl    for ub.doc-line.
     4605       define buffer out-vatp_goodsprl       for ub.goods.
     4606       define buffer out-vatp_trn-docprl     for ub.trn-doc.
     4607       define buffer out-vatp_doc-attrprl    for ub.doc-attr.
     4608       define variable varprice-base-consprl      like ub.doc-line.price-base initial 0.00 no-undo.
     4609       define variable varprice-rubl-consprl      like ub.doc-line.price-rubl initial 0.00 no-undo.
     4610       define variable varfrm-cnsv-typeprl         as   character                           no-undo.
     4611       define variable varfrm-cnsvprl              as   character                           no-undo.
     4612       define variable varroot-nodeprl             as   integer                             no-undo.
     4613       define variable varempty-scaleprl           as   logical                             no-undo.
     4614       define variable varis-cons-parts-haveprl    as   logical                             no-undo.
     4615       define variable varsum-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4616       define variable varslt-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4617       define variable varvat-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4618       define variable varvatcons-base-factovpprl  like ub.gds-dtl.price-base               no-undo.
     4619       define variable vardsc-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4620       define variable varsum-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4621       define variable varslt-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4622       define variable varvat-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4623       define variable varvatcons-base-docovpprl   like ub.gds-dtl.price-base               no-undo.
     4624       define variable vardsc-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4625       define variable varsum-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4626       define variable varslt-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4627       define variable varvat-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4628       define variable varvatcons-rubl-factovpprl  like ub.gds-dtl.price-base               no-undo.
     4629       define variable vardsc-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4630       define variable varsum-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4631       define variable varslt-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4632       define variable varvat-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4633       define variable varvatcons-rubl-docovpprl   like ub.gds-dtl.price-base               no-undo.
     4634       define variable vardsc-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4635       define variable varfact-qntyprl             like ub.parts.fact-qnty                  no-undo.
     4636       define variable varcons-qntyprl             like ub.parts.fact-qnty                  no-undo.
     4637       define variable varis-one-gds-dtlprl        as   logical                             no-undo.
     4638       define variable varcurprlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     4639       define variable varcurprlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     4640       define variable varcurprldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     4641       define variable varcurprldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     4642       define variable varoutvprbprl               as   character                           no-undo.
     4643       define variable out-vatp-have-vat-sltprl    as   logical initial yes                 no-undo.
     4644       define buffer   in-vatp-trn-docoprl  for ub.trn-doc .
     4645       define buffer   in-vatp-partsoprl    for ub.parts   .
     4646       define buffer   in-vatp-docoprl      for ub.trn-doc .
     4647       define buffer   in-vatp-goodsoprl    for ub.goods   .
     4648       define buffer   in-vatp-sysconfoprl  for ub.sysconf .
     4649       define buffer   in-vatp_doc-attroprl for ub.doc-attr.
     4650       define variable in-vatp-have-vat-sltoprl       as   logical initial yes    no-undo.
     4651       define variable vat-pc-locoprl                 like ub.doc-line.vat-pc     no-undo.
     4652       define variable varinvprboprl                  as   character              no-undo.
     4653       define variable slt-pc-locoprl                 like ub.doc-line.slt-pc     no-undo.
     4654       define variable cli-base-rateoprl              as   decimal                no-undo.
     4655       define variable price-rubl-with-tax-locoprl    like ub.doc-line.price-rubl no-undo.
     4656       define variable price-base-with-tax-locoprl    like ub.doc-line.price-base no-undo.
     4657       define variable price-cli-with-tax-locoprl     like ub.doc-line.price-cli  no-undo.
     4658       define variable price-rubl-without-tax-locoprl like ub.doc-line.price-rubl no-undo.
     4659       define variable price-base-without-tax-locoprl like ub.doc-line.price-base no-undo.
     4660       define variable price-cli-without-tax-locoprl  like ub.doc-line.price-base no-undo.
     4661       define variable vat-base-locoprl               like ub.doc-line.price-base no-undo.
     4662       define variable vat-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     4663       define variable vat-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     4664       define variable slt-base-locoprl               like ub.doc-line.price-base no-undo.
     4665       define variable slt-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     4666       define variable slt-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     4667       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
     4668       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     4669       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
     4670       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
     4671       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
     4672       define variable transport-cli-locoprl          like ub.doc-line.price-rubl no-undo.
     4673       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
     4674       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
     4675       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     4676       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     4677       define variable varinvatp-envdoprl             as   character              no-undo.
     4678       define variable varinvatp-typeoprl             as   character              no-undo.
     4679     define buffer bf_price-list for ub.price-list.
     4680     define buffer bf_goods      for ub.goods.
     4681     define buffer bf_sysconf    for ub.sysconf.
     4682     define buffer bf_parts      for ub.parts.
     4683     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     4684     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     4685     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     4686     define variable varexcise      like ub.price-list.excise     no-undo.
     4687     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     4688     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     4689     define variable varprice-base  like ub.price-list.price-sale no-undo.
     4690     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     4691     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     4692     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     4693     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     4694     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     4695     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     4696     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     4697     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     4698     define variable varartic       like ub.price-list.artic      no-undo.
     4699     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     4700     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     4701     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     4702     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     4703     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     4704     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     4705     define variable vardoc-type     as   character              no-undo.
     4706     do
     4707     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     4708     :
     4709       find first bf_price-list no-lock
     4710         where recid(bf_price-list) = parrecid
     4711         no-error .
     4712       if not available bf_price-list
     4713       then do:
     4714         return error "Ошибка во входящих параметрах prl-vat.i" .
     4715       end.
     4716       find first bf_goods no-lock
     4717         where bf_goods.artic     = bf_price-list.artic
     4718           and bf_goods.prod-type = bf_price-list.prod-type
     4719           and bf_goods.prod-code = bf_price-list.prod-code
     4720         no-error .
     4721       if not available bf_goods
     4722       then do:
     4723         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     4724       end.
     4725       assign
     4726         varvat-pc = bf_price-list.vat-pc
     4727         varslt-pc = bf_price-list.slt-pc
     4728       .
     4729       if varvat-pc = ?
     4730       then do:
     4731         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     4732       end.
     4733       if varslt-pc = ?
     4734       then do:
     4735         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     4736       end.
     4737       assign
     4738         varbase-rate   = 1
     4739         varbase-scale  = 1
     4740         varroad-tax    = bf_price-list.road-tax
     4741         varexcise      = bf_price-list.excise
     4742         varprice-base  = bf_price-list.price-sale
     4743         varprice-rubl  = bf_price-list.price-sale
     4744         vardiscnt-base = 0
     4745         vardiscnt-rubl = 0
     4746       .
     4747       assign
     4748         varfact-qnty = 0
     4749       .
     4750       for each bf_parts no-lock
     4751         where bf_parts.out-code   = bf_price-list.doc-num
     4752           and bf_parts.obj-type   = bf_price-list.obj-type
     4753           and bf_parts.obj-code   = bf_price-list.obj-code
     4754           and bf_parts.artic      = bf_price-list.artic
     4755           and bf_parts.prod-type  = bf_price-list.prod-type
     4756           and bf_parts.prod-code  = bf_price-list.prod-code
     4757       :
     4758         assign
     4759           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     4760         .
     4761       end.
     4762       assign
     4763         vardoc-num   = bf_price-list.doc-num
     4764         vardoc-code  = bf_price-list.doc-num
     4765         varobj-type  = bf_price-list.obj-type
     4766         varobj-code  = bf_price-list.obj-code
     4767         varartic     = bf_price-list.artic
     4768         varprod-type = bf_price-list.prod-type
     4769         varprod-code = bf_price-list.prod-code
     4770         vardoc-qnty  = varfact-qnty
     4771         varext-doc-type = 'ot':U
     4772       .
     4773   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4774   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4775     (input  bf_price-list.obj-type
     4776     ,input  bf_price-list.obj-code
     4777     ,output v-host-code
     4778     )  .
     4779       find first bf_sysconf no-lock
     4780         where bf_sysconf.host-code = v-host-code
     4781         .
     4782       if bf_sysconf.cons-vat-pc = ?
     4783       then do:
     4784         return error "Не задан консигнационный НДС по фирме." .
     4785       end.
     4786       else do:
     4787         assign
     4788           varcons-vat-pc = bf_sysconf.cons-vat-pc
     4789         .
     4790       end.
     4791   if varext-doc-type = 'ot':U or
     4792      varext-doc-type = ?                 then do:
     4793     assign
     4794      out-vatp-have-vat-sltprl = yes.
     4795   end.
     4796   else do:
     4797     find first out-vatp_doc-attrprl no-lock
     4798       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     4799         and out-vatp_doc-attrprl.attr-code = 'envd':U
     4800         no-error .
     4801     if not available out-vatp_doc-attrprl then do:
     4802       assign
     4803         out-vatp-have-vat-sltprl = yes.
     4804     end.
     4805     else do:
     4806        out-vatp-have-vat-sltprl = no.
     4807     end.
