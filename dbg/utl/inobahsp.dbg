     6892   procedure clcprtsl_calc-ttable :
     6893   define input parameter paris-doc           as   logical                 no-undo.
     6894   define input parameter paris-cur           as   logical                 no-undo.
     6895   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     6896   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     6897   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     6898   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     6899   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     6900   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     6901   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     6902   define input parameter parr-b              as   character               no-undo.
     6903   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     6904   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     6905   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     6906   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     6907   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     6908   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     6909   define buffer bf_tt-allsum      for tt-allsum.
     6910   define buffer bf_tt-clcparts    for tt-clcparts.
     6911   define buffer bf_tt-allsum-line for tt-allsum-line.
     6912   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6913   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6914   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6915   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6916   define variable varexcise          like ub.price-list.excise     no-undo.
     6917   do on error undo, return error return-value :
     6918   for each bf_tt-allsum-line
     6919   on error undo, return error return-value
     6920    :
     6921     delete bf_tt-allsum-line.
     6922   end.
     6923   for each bf_tt-allsum
     6924   on error undo, return error return-value
     6925   :
     6926     delete bf_tt-allsum.
     6927   end.
     6928   for each bf_tt-clcparts
     6929   on error undo, return error return-value
     6930   :
     6931   if v-calcbypart then do:
     6932             assign
     6933             parcur-base =   bf_tt-clcparts.part-cur-base
     6934             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     6935             parcur-excise =   bf_tt-clcparts.part-cur-excise
     6936             .
     6937   end.
     6938      run clcprtsl_calc-parts in this-procedure (
     6939        input recid(bf_tt-clcparts),
     6940        input paris-doc,
     6941        input paris-cur,
     6942        input parroad-tax,
     6943        input parexcise,
     6944        input parvat-pc,
     6945        input parcons-vat-pc,
     6946        input parslt-pc,
     6947        input parbase-rate,
     6948        input parbase-scale,
     6949        input parr-b,
     6950        input parcur-base,
     6951        input parcur-road-tax,
     6952        input parcur-excise,
     6953        input parcur-vat-pc,
     6954        input parcurcons-vat-pc,
     6955        input parcurslt-pc
     6956        ) no-error.
     6957     if error-status:error then do:
     6958       message
     6959         vss-workfile vss-revision vss-description skip
     6960         vss-include-info38 skip
     6961         "Ошибка при обсчете партии" skip
     6962         "Документ партии " bf_tt-clcparts.out-code skip
     6963         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     6964         return-value skip
     6965         error-status:get-message(1) skip
     6966         error-status:get-message(2) skip
     6967         error-status:get-message(3) skip
     6968         view-as alert-box error .
     6969       undo, return error .
     6970     end.
     6971     for each bf_tt-allsum on error undo, return error return-value :
     6972       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     6973       if not available bf_tt-allsum-line then do:
