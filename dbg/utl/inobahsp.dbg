     6753     (input  bf_trn-doc.obj-type
     6754     ,input  bf_trn-doc.obj-code
     6755     ,input  varb-code
     6756     ,input  0
     6757     ,input  bf_trn-doc.fact-order
     6758     ,output vardoc-num
     6759     ,output varprice-sale
     6760     ,output varroad-tax
     6761     ,output varexcise
     6762     )  .
     6763             if varprice-sale = ?
     6764             then do:
     6765               assign
     6766                 varprice-sale = 0
     6767                 varroad-tax   = 0
     6768                 varexcise     = 0
     6769               .
     6770             end.
     6771             assign
     6772               varlastcur-base     = varprice-sale
     6773               varlastcur-road-tax = varroad-tax
     6774               varlastcur-excise   = varexcise
     6775               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     6776               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     6777               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     6778               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     6779             .
     6780         end.
     6781       end.
     6782       if varcur-fact-qnty = 0 then do:
     6783         assign
     6784           varcur-base      = varlastcur-base
     6785           varcur-road-tax  = varlastcur-road-tax
     6786           varcur-excise    = varlastcur-excise
     6787         .
     6788       end.
     6789       else do:
     6790         assign
     6791           varcur-base      = varcur-base      / varcur-fact-qnty
     6792           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     6793           varcur-excise    = varcur-excise    / varcur-fact-qnty
     6794         .
     6795       end.
     6796       if varcur-vat-pc = ?
     6797       then do:
     6798         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     6799       end.
     6800       if varcur-slt-pc = ?
