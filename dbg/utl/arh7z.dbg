        1   block-level on error undo, throw.
        2   define input  parameter iFilearh as character no-undo.
        3   define input  parameter iFileSourse as character no-undo.
        4   define variable m-arh-name as character no-undo.
        5   m-arh-name = search('exe/7z.exe':U).
        6   if m-arh-name = ?
        7   then do:
        8      m-arh-name = search('exe/7za.exe':U).
        9   end.
       10   os-command silent
       11       value( substitute( "&1 a -tzip -y &2 &3":U, m-arh-name, iFilearh, iFileSourse ) )
