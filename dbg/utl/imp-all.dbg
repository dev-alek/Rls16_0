        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as handle              no-undo.
        3   define input parameter parchoice        as integer             no-undo.
        4   define input parameter parInputFileName as character           no-undo.
        5   define input parameter parInputCoding   as character           no-undo.
        6   define input parameter pare-code        like ub.trn-doc.exch-code no-undo.
        7   define input parameter pardoc-code      like ub.trn-doc.doc-code  no-undo.
        8   define input parameter parcli-type      like ub.trn-doc.cli-type  no-undo.
        9   define input parameter parcli-code      like ub.trn-doc.cli-code  no-undo.
       10   define input parameter parhost-code     like ub.trn-doc.host-code no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision: f5e72f13272f, 2363, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: druban $":U .
       13   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:42 2020 +0300 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: imp-all.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: utl/imp-all.p $":U .
       16   define variable vss-description as character no-undo init "Импорт доп. БК, внеш. ПН, Документ назначения цены из текстового файла".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301     define variable v-cntxt-db-num        as integer   no-undo .
      302     define variable v-cntxt-userid        as character no-undo .
      303     define variable v-cntxt-level         as character no-undo .
      304     define variable v-cntxt-host-code-obj as integer   no-undo .
      305     define variable v-cntxt-obj-type      as character no-undo .
      306     define variable v-cntxt-obj-code      as integer   no-undo .
      307     define variable v-cntxt-db-num-obj    as integer   no-undo .
      308     define variable v-cntxt-is-admin      as logical   no-undo .
      309   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310     run mainmenu_getcntxt in parparentproc
      311       (output v-cntxt-db-num
      312       ,output v-cntxt-userid
      313       ,output v-cntxt-level
      314       ,output v-cntxt-host-code-obj
      315       ,output v-cntxt-obj-type
      316       ,output v-cntxt-obj-code
      317       ,output v-cntxt-db-num-obj
      318       ,output v-cntxt-is-admin
      319       ) .
      320   define new shared stream inp.
      321   define new shared stream err.
      322   define new shared stream wrn.
      323   define variable InputFileName  as character         no-undo.
      324   define variable InputCoding    as character         no-undo.
      325   define variable InputMode      as character         no-undo.
      326   define variable v-message-text as character         no-undo.
      327   define variable choice         as integer           no-undo.
      328   define variable e-code         like      ub.trn-doc.exch-code no-undo.
      329   define variable dfc-recid   as recid     no-undo .
      330   define variable vartemp-ext as character no-undo.
      331   define variable varlog      as logical   no-undo.
      332   define variable ref-rec     as recid     no-undo.
      333   define variable doc-rec     as recid     no-undo.
      334   define variable mark-list       as   character            no-undo.
      335   define buffer buf_trn-doc for ub.trn-doc  .
      336   v-message-text =
      337       "Форматы файла импорта <параметр в угловых скобках требуется не во всех импортах>[параметр в квадратных скобках может быть опущен][[параметр обязателен при условии импорта в определенную цель]]:" + chr(10)
      338     + chr(10)
      339     + "ITEM: артикул;[код-производителя];;;              [[доп-бар-код]];<цена>;<количество>;[едизм];[коэффициент];[скидка];[НДС];[НСП];[[включен/выключен(yes/no)]];[ГТД][;[вес одного места];[количество мест];[срок годности];[цена производителя без НДС];[цена производителя с НДС]]" + chr(10)
      340     + "SCALE:артикул;[код-производителя];признак;;       [[доп-бар-код]];<цена>;<количество>;[едизм];[коэффициент];[скидка];[НДС];[НСП];[[включен/выключен(yes/no)]];[ГТД][;[вес одного места];[количество мест];[срок годности];[цена производителя без НДС];[цена производителя с НДС]]" + chr(10)
      341     + "PART: артикул;[код-производителя];документ;партия;[[доп-бар-код]];<цена>;<количество>;[едизм];[коэффициент];[скидка];[НДС];[НСП];[[включен/выключен(yes/no)]];[ГТД][;[вес одного места];[количество мест];[срок годности];[цена производителя без НДС];[цена производителя с НДС]]" + chr(10)
      342     + "CODE: код;;;;                                     доп-бар-код;цена;количество;[едизм];[коэффициент];[скидка];[НДС];[НСП];[[включен/выключен(yes/no)]];[Тип маркировки]"
      343     + chr(10)
      344     + "Описание параметров:"                                                                                                     + chr(10)
      345     + "ITEM - товар, SCALE - признак, PART - партию, CODE - на любое из перечисленного по коду."                                 + chr(10)
      346     + "Если код-производителя не указан, будет взят ПЕРВЫЙ попавшийся товар с данным артикулом."                                 + chr(10)
      347     + "Артикул - артикул товара."                                                                                                + chr(10)
      348     + "Код - любой собственный или дополнительный бар-код или код товара, признака, партии, для которой импортируется доп. БК."  + chr(10)
      349     + "Код производителя - числовой код производителя из справочника клиентов (до 9 разрядов). Тип подразумевается 'орг'."       + chr(10)
      350     + "Признак - полный путь к терминальному признаку, узлы перечислены сверху вниз без корневого через '/'."                    + chr(10)
      351     + "Документ - номер складского документа, создавшего партию (обычно номер ПН)."                                              + chr(10)
      352     + "Партия - номер партии."                                                                                                   + chr(10)
      353     + "Доп-бар-код - импортируемый доп. БК. Должен быть длиннее 5 разрядов, или импорт 1,2-разрядных топливных кодов."           + chr(10)
      354     + "НДС, НСП - проценты НДС и налога с продаж поставщика."                                                                    + chr(10)
      355     + "включен/выключен(yes/no) - включен или выключен дополнительный бар-код (необходим при импорте доп. бар-кодов)"            + chr(10)
      356     + "После последней строки требуется Enter."                                                                                  + chr(10)
      357     + "Тип маркировки (0 - Тип неопределен, 1 - Табак,2 - Обувь)."                                                               + chr(10)
      358     + chr(10)
      359     + "Импорт дополнительных БК: Параметры для режима: Доп-бар-код, едизм, коэффициент, скидка, включен/выключен."               + chr(10)
      360     + "Если данный доп. БК уже есть в БД, то будут переписаны новыми значениями: едизм, коэффициент, скидка, если они указаны."  + chr(10)
      361     + chr(10)
      362     + "Импорт внешней ПН (запроса): Параметры для режима: Цена, количество, едизм, коэффициент, НДС, НСП."                       + chr(10)
      363     + "Если едизм не указан, будут использованы едизм и коэффициент из бар-кода (только с типом CODE)."                          + chr(10)
      364     + "Если данный товар (признак, партия) уже есть в ПН, то будут переписаны заново: цена, едизм, коэффициент, НДС, НСП."       + chr(10)
      365     + "Количество в этом случае суммируется."                                                                                    + chr(10)
      366     + chr(10)
      367     + "Примеры :"                                                                                                                + chr(10)
      368     + "ITEM:арт-1;118;;;3249443208100;;;;;;;yes"                                                                                           + chr(10)
      369     + "ITEM:арт-1;118;;;3249443208100;;;уп;12;5;;yes"                                                                                   + chr(10)
      370     + "ITEM:арт-1;;;;3249443208100;;;уп;12;5;;yes"                                                                                      + chr(10)
      371     + "SCALE:арт-1;118;синий;;3249443208100;;;уп;12;5;;yes"                                                                             + chr(10)
      372     + "SCALE:арт-1;118;синий/54;;3249443208100;;;уп;12;5;;yes"                                                                          + chr(10)
      373     + "PART:арт-1;118;4657-500с;777;3249443208100;;;уп;12;5;;yes"                                                                       + chr(10)
      374     + "CODE:8901055006042;;;;3249443208100;;;уп;12;5;;yes;1"                                                                            + chr(10)
      375     .
      376   if parInputFileName <> ? then do:
      377     assign InputFileName = parInputFileName.
      378   end.
      379   else do:
      380      run gbl/d-prompt.w (
      381          'title=Импорт доп. БК из внешнего текстового файла для товаров, признаков, партий\'
      382        + 'type=editor\'
      383        + 'fillin_width=96\'
      384        + 'fillin_height=15\'
      385        + 'readonly=yes\'
      386        , input-output v-message-text).
      387      if return-value = 'false':u then do:
      388        return error.
      389      end.
      390      SYSTEM-DIALOG GET-FILE InputFileName
      391                    TITLE   "Файл с Доп. бар-кодами"
      392                    FILTERS "Текстовый файл (*.adb)"   "*.adb",
      393                            "Текстовый файл (*.txt)"   "*.txt",
      394                            "Все файлы (*.*)"          "*.*"
      395                    MUST-EXIST
      396                    USE-FILENAME
      397                    default-extension ".txt"
      398                    UPDATE varlog.
      399      if not varlog then return error.
      400   end.
      401   InputFileName = trim (string (InputFileName)) .
      402   assign
      403   vartemp-ext = entry (2, InputFileName, ".") no-error.
      404   if error-status:error then do:
      405     message "Файл без расширения не может быть обработан. Переименуйте его."
      406             view-as alert-box error.
      407     return error.
      408   end.
      409   if entry (2, InputFileName, ".") = "err" then do:
      410     message "Файл с расширением '.err' не может быть обработан. Переименуйте его."
      411             view-as alert-box error.
      412     return error.
      413   end.
      414   if entry (2, InputFileName, ".") = "wrn" then do:
      415     message "Файл с расширением '.wrn' не может быть обработан. Переименуйте его."
      416             view-as alert-box error.
      417     return error.
      418   end.
      419   if parInputCoding <> ? then do:
      420      if parInputCoding <> "1251"   and
      421         parInputCoding <> "KOI8-R" then do:
      422         message "Указан неверный формат файла: " parInputCoding " ." view-as alert-box.
      423         return error.
      424      end.
      425      assign InputCoding = parInputCoding.
      426   end.
      427   else do:
      428      varlog = yes.
      429      message "Выберите входной формат файла: YES - 1251, NO - KOI8-R" view-as alert-box question
      430              buttons YES-NO update varlog.
      431      if varlog then
      432         InputCoding = "1251".
      433      else
      434         InputCoding = "KOI8-R".
      435   end.
      436   if parchoice <> ? then do:
      437      if parchoice < 1 or
      438         parchoice > 4 then do:
      439         message "Неверно выбран параметр информации для импорта: " parchoice " ."
      440         view-as alert-box error.
      441         return error.
      442      end.
      443      assign choice = parchoice.
      444   end.
      445   else do:
      446      run gbl/d-askw.w (input "Что импортируем",
      447                    input "Выберите, какую информацию нужно импортировать из выбранного файла",
      448                    input "|",
      449                    input "Доп. БК|Внешняя ПН|ДНЦ|Все",
      450                    input "|||",
      451                    input 1,
      452                    input 4,
      453                    output choice).
      454   end.
      455   define variable mFileName as character no-undo.
      456   define variable vi as integer no-undo.
      457   do vi = 1 to Num-entries(InputFileName,".") - 1:
      458   mFilename = mFilename + "." + entry(vi,InputFileName,".").
      459   end.
      460   mFilename = substring(mFilename,2).
      461   output stream err TO value (mFilename + ".err").
      462   output stream wrn TO value (mFilename + ".wrn").
      463   if choice = 4 then do:
      464     run run-choice (1) no-error.
      465     if error-status:error then
      466       return error.
      467     run run-choice (2) no-error.
      468     if error-status:error then
      469       return error.
      470     run run-choice (3) no-error.
      471     if error-status:error then
      472       return error.
      473     message
      474       "Работа утилиты закончена."
      475       view-as alert-box.
      476   end.
      477   else do:
      478     run run-choice (choice) no-error.
      479     if error-status:error then
      480       return error.
      481   end.
      482   output stream err close.
      483   output stream wrn close.
      484   procedure run-choice:
      485   define input parameter choice-num as integer no-undo.
      486   define variable frame-title as character          no-undo.
      487   define variable count-upd   as integer init 0     no-undo.
      488   define variable counter     as integer init 0     no-undo.
      489   define variable count-all   as integer init 0     no-undo.
      490   DEFINE VARIABLE loc-ref-list as character no-undo .
      491   case InputCoding :
      492     when "1251" then
      493       input stream inp FROM value (InputFileName) convert source "1251".
      494     when "KOI8-R" then
      495       input stream inp FROM value (InputFileName) convert source "KOI8-R".
      496     otherwise
      497       return error.
      498   end case.
      499   case choice-num:
      500     when 1 then
      501       assign
      502         InputMode = "prod-bc"
      503         frame-title = "доп. БК"
      504         .
      505     when 2 then do:
      506       assign
      507         InputMode = "input-way-bill"
      508         frame-title = "внешней ПН (запроса)"
      509         .
      510       if pare-code <> ? then do:
      511          find first currency where currency.curr-code = pare-code no-lock no-error.
      512          if not available currency then do:
      513             message "Задан неверный код валюты: " pare-code " ." view-as alert-box error.
      514             return error.
      515          end.
      516          assign e-code = pare-code.
      517       end.
      518       else do:
      519          assign
      520          ref-rec = ?.
      521          run ref/currency.w (input parparentproc, "b-sel", input-output ref-rec).
      522          if ref-rec = ? then
      523            return error.
      524          find currency where recid (currency) = ref-rec no-lock.
      525          e-code = currency.curr-code.
      526       end.
      527     end.
      528     when 3 then do:
      529       assign
      530         InputMode = "overvalue"
      531         frame-title = "Документ назначения цены"
      532         .
      533       run str/docsprls.w
      534        (input parparentproc ,
      535         input "all":U ,
      536         input ?,
      537         input ?,
      538         input "b-sel,b-add":U ,
      539         input-output loc-ref-list
      540         ) .
      541       doc-rec = integer (loc-ref-list) .
      542       find first  price-doc-forming  where recid (price-doc-forming) = doc-rec no-error .
      543       if not available price-doc-forming then do:
      544         message "Документ назначения цены не выбран."
      545                 view-as alert-box error.
      546         return error.
      547       end.
      548       if price-doc-forming.stts <> integer('0':U) then do:
      549         message "Статус Документа назначения цены должен быть 'новый'."
      550                 view-as alert-box error.
      551         return error.
      552       end.
      553       dfc-recid = recid(price-doc-forming).
      554     end.
      555   end case.
      556   frame-title = "Импорт "      + frame-title +
      557                 " из файла: "  + InputFileName +
      558                 " Кодировка: " + InputCoding +
      559                 " Дата: "      + cur-time-string()
      560                 .
      561   run utl/imd-all.p
      562       ( input  parparentproc,
      563         input  InputMode,
      564         input  frame-title,
      565         input  dfc-recid,
      566         input  e-code,
      567         input  (if pardoc-code = ? then "import" else pardoc-code),
      568         input  parcli-type,
      569         input  parcli-code,
      570         input  parhost-code,
      571         output count-upd,
      572         output counter,
      573         output count-all) no-error.
      574   if error-status:error then
      575     return error.
      576   input  stream inp close.
      577   output stream err close.
      578   output stream wrn close.
      579   if parInputFileName = ? then do:
      580     message frame-title skip (2)
      581             "Просмотрено :" count-all skip
      582             "Закачано :"    counter skip
      583             "Изменено :"    count-upd skip (2)
      584             "Информация об ошибках находится в файле :" entry (1, InputFileName, ".") + ".err"
      585             "Информация о предупреждениях находится в файле :" entry (1, InputFileName, ".") + ".wrn"
      586             view-as alert-box .
      587     define variable varuser-action as character no-undo.
      588     define variable varis-printed  as logical   no-undo.
      589     run gbl/prnfilen.w
      590       (input  "Ошибки"
      591       ,input  0
      592       ,input  mFilename + ".err"
      593       ,input  7
      594       ,output varuser-action
      595       ,output varis-printed
      596       ).
      597     run gbl/prnfilen.w
      598       (input  "Замечания"
      599       ,input  0
      600       ,input  mFilename + ".wrn"
      601       ,input  7
      602       ,output varuser-action
      603       ,output varis-printed
      604       ).
      605   end.
      606   end procedure.
