        1   USING Progress.Lang.*.
        2   USING Progress.Lang.AppError.
        3   BLOCK-LEVEL ON ERROR UNDO, THROW.
        4   CLASS utl.ValidateError INHERITS AppError:
        5      CONSTRUCTOR PUBLIC ValidateError (  ):
        6         SUPER ().
        7      END CONSTRUCTOR.
        8      CONSTRUCTOR PUBLIC ValidateError (INPUT ReturnValue AS CHARACTER):
        9         SUPER (ReturnValue).
       10      END CONSTRUCTOR.
       11      CONSTRUCTOR PUBLIC ValidateError (
       12         INPUT ErrorMessage   AS CHARACTER,
       13         INPUT MessageNumber AS INTEGER):
       14         SUPER (ErrorMessage,MessageNumber).
       15      END CONSTRUCTOR.
       16   END CLASS.
