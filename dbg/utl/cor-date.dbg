      162        VIEW-AS FILL-IN
      163        SIZE 9 BY 1
      164        FGCOLOR 4  NO-UNDO.
      165   DEFINE VARIABLE fi-close-time-hms-opn AS CHARACTER FORMAT "X(8)":U
      166        VIEW-AS FILL-IN
      167        SIZE 9 BY 1
      168        FGCOLOR 4  NO-UNDO.
      169   DEFINE VARIABLE fi-close-time-opn AS INTEGER FORMAT ">>>>>>9":U INITIAL ?
      170        LABEL "Закрыта"
      171        VIEW-AS FILL-IN
      172        SIZE 14 BY 1
      173        FGCOLOR 4  NO-UNDO.
