        1   DEFINE BUFFER buf_clients FOR clients.
        2   DEFINE BUFFER buf_sys-ctrl FOR sys-ctrl.
        3   define input  parameter parparentproc as handle    no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Утилита коррекции даты на объекте".
       10   define new global shared variable g#language as character no-undo .
       11   if g#language <> '' and g#language <> 'rus':U then do:
       12     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       13   end.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   function usrfulnf returns character ( input p-user-id as character):
      117   define variable v-user-name as character no-undo .
      118   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      120     (input  p-user-id
      121     ,output v-user-name
      122     ) no-error .
      123   if error-status:error
      124   or v-user-name = ""
      125   then do:
      126     return p-user-id.
      127   end.
      128   else do:
      129     return v-user-name.
      130   end.
      131   end function.
      132   DEFINE BUTTON b-exit AUTO-GO
      133        LABEL "&Выход"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-help
      137        LABEL "Помо&щь"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON b-rollback
      141        LABEL "Откатить"
      142        SIZE 10 BY 1.
      143   DEFINE BUTTON b-sel-obj
      144        LABEL ">"
      145        SIZE 3 BY 1.
      146   DEFINE VARIABLE fi-close-id-cls AS CHARACTER FORMAT "X(256)":U
      147        LABEL "Закрыл"
      148        VIEW-AS FILL-IN
      149        SIZE 25.5 BY 1
      150        FGCOLOR 4  NO-UNDO.
      151   DEFINE VARIABLE fi-close-id-opn AS CHARACTER FORMAT "X(256)":U
      152        LABEL "Закрыл"
      153        VIEW-AS FILL-IN
      154        SIZE 25.5 BY 1
      155        FGCOLOR 4  NO-UNDO.
      156   DEFINE VARIABLE fi-close-time-cls AS INTEGER FORMAT ">>>>>>9":U INITIAL ?
      157        LABEL "Закрыта"
      158        VIEW-AS FILL-IN
      159        SIZE 14 BY 1
      160        FGCOLOR 4  NO-UNDO.
