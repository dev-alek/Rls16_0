      196   DEFINE VARIABLE fi-open-id-cls AS CHARACTER FORMAT "X(256)":U
      197        LABEL "Открыл"
      198        VIEW-AS FILL-IN
      199        SIZE 25.5 BY 1
      200        FGCOLOR 4  NO-UNDO.
      201   DEFINE VARIABLE fi-open-id-opn AS CHARACTER FORMAT "X(256)":U
      202        LABEL "Открыл"
      203        VIEW-AS FILL-IN
      204        SIZE 25.5 BY 1
      205        FGCOLOR 4  NO-UNDO.
