      234   DEFINE RECTANGLE RECT-1
      235        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      236        SIZE 35.5 BY 7.25.
      237   DEFINE RECTANGLE RECT-2
      238        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      239        SIZE 35 BY 7.25.
      240   DEFINE FRAME Dialog-Frame
      241        b-exit AT ROW 1 COL 1
      242        b-rollback AT ROW 1 COL 11
      243        b-help AT ROW 1 COL 61
      244        fi-obj-type AT ROW 2 COL 24 COLON-ALIGNED
      245        fi-obj-code AT ROW 2 COL 29 COLON-ALIGNED NO-LABEL
      246        b-sel-obj AT ROW 2 COL 37.5
      247        fi-sys-date-cls AT ROW 5 COL 6.63 COLON-ALIGNED
      248        fi-sys-date-opn AT ROW 5 COL 42.38 COLON-ALIGNED
      249        fi-open-time-cls AT ROW 6 COL 9.5 COLON-ALIGNED
      250        fi-open-time-hms-cls AT ROW 6 COL 24 COLON-ALIGNED NO-LABEL
      251        fi-open-time-opn AT ROW 6 COL 45.38 COLON-ALIGNED
      252        fi-open-time-hms-opn AT ROW 6 COL 59.88 COLON-ALIGNED NO-LABEL
      253        fi-close-time-cls AT ROW 7 COL 9.5 COLON-ALIGNED
      254        fi-close-time-hms-cls AT ROW 7 COL 24 COLON-ALIGNED NO-LABEL
      255        fi-close-time-opn AT ROW 7 COL 45.38 COLON-ALIGNED
      256        fi-close-time-hms-opn AT ROW 7 COL 59.88 COLON-ALIGNED NO-LABEL
      257        fi-fo-cls AT ROW 8 COL 4.5 COLON-ALIGNED
      258        fi-fo-opn AT ROW 8 COL 40.38 COLON-ALIGNED
      259        fi-open-id-cls AT ROW 9 COL 8.5 COLON-ALIGNED
      260        fi-open-id-opn AT ROW 9 COL 44.38 COLON-ALIGNED
      261        fi-close-id-cls AT ROW 10 COL 8.5 COLON-ALIGNED
      262        fi-close-id-opn AT ROW 10 COL 44.38 COLON-ALIGNED
      263        fi-db-num AT ROW 2.25 COL 4 COLON-ALIGNED
      264        "Текущая дата на объекте" VIEW-AS TEXT
      265             SIZE 29.5 BY .67 AT ROW 4 COL 37
      266             FGCOLOR 4
      267        "Последняя закрытая дата" VIEW-AS TEXT
      268             SIZE 29.5 BY .67 AT ROW 4 COL 2
      269             FGCOLOR 4
      270        RECT-1 AT ROW 4.75 COL 1.5
      271        RECT-2 AT ROW 4.75 COL 37.5
      272        SPACE(0.49) SKIP(0.28)
      273       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      274            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      275            TITLE "Откат даты на объекте"
      276            DEFAULT-BUTTON b-exit.
      277   ASSIGN
      278          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      279          FRAME Dialog-Frame:HIDDEN           = TRUE.
      280   ASSIGN
      281          fi-close-id-cls:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      282   ASSIGN
      283          fi-close-id-opn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      284   ASSIGN
      285          fi-close-time-cls:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      286   ASSIGN
      287          fi-close-time-hms-cls:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      288   ASSIGN
      289          fi-close-time-hms-opn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      290   ASSIGN
      291          fi-close-time-opn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      292   ASSIGN
      293          fi-fo-cls:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      294   ASSIGN
      295          fi-fo-opn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      296   ASSIGN
      297          fi-open-id-cls:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      298   ASSIGN
      299          fi-open-id-opn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      300   ASSIGN
      301          fi-open-time-cls:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      302   ASSIGN
      303          fi-open-time-hms-cls:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      304   ASSIGN
      305          fi-open-time-hms-opn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      306   ASSIGN
      307          fi-open-time-opn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      308   ASSIGN
      309          fi-sys-date-cls:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      310   ASSIGN
      311          fi-sys-date-opn:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      312   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      313   DO:
      314     APPLY "END-ERROR":U TO SELF.
      315   END.
      316   ON CHOOSE OF b-rollback IN FRAME Dialog-Frame
      317   DO:
      318   run  proc-sel-doc in this-procedure no-error .
      319     if error-status :error = yes
      320     then do:
      321       message
      322         return-value skip
      323         error-status :get-message(1) skip
      324         error-status :get-message(2) skip
      325       view-as alert-box error.
      326       run proc-clr-info in this-procedure .
      327     end.
      328   END.
      329   ON CHOOSE OF b-sel-obj IN FRAME Dialog-Frame
      330   DO:
      331     run proc-sel-obj in this-procedure no-error .
      332     if error-status :error
      333     then do:
      334       message
      335         return-value skip
      336         error-status :get-message(1) skip
      337         error-status :get-message(2) skip
      338       view-as alert-box error.
      339       run proc-clr-info in this-procedure .
      340       return no-apply.
      341     end.
      342   END.
      343   ON LEAVE OF fi-obj-code IN FRAME Dialog-Frame
      344   DO:
      345   END.
      346   ON RETURN OF fi-obj-code IN FRAME Dialog-Frame
      347   DO:
      348     run proc-sel-obj in this-procedure no-error .
      349     if error-status :error
      350     then do:
      351       message
      352         return-value skip
      353         error-status :get-message(1) skip
      354         error-status :get-message(2) skip
      355       view-as alert-box error.
      356       run proc-clr-info in this-procedure .
      357       return no-apply.
      358     end.
      359   END.
      360   ON LEAVE OF fi-obj-type IN FRAME Dialog-Frame
      361   DO:
      362   END.
      363   ON RETURN OF fi-obj-type IN FRAME Dialog-Frame
      364   DO:
      365   END.
      366   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      367   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      368   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   on help of frame Dialog-Frame
      370   do:
      371     run gbl/app_help.p
      372       (input this-procedure :file-name
      373       ,input ''
      374       ,input ?
      375       ) no-error.
      376     if error-status :error then do:
      377       message
      378         "Ошибка при вызове помощи"
      379         error-status :get-message(1)
      380         view-as alert-box .
      381     end.
      382   end.
      383   run minbtn-set in this-procedure .
      384   on choose of b-help in frame Dialog-Frame
      385   do:
      386     apply "help":u to frame Dialog-Frame .
      387   end.
      388   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      389   procedure minbtn-set :
      390       do
      391           on error undo, return error return-value
      392           :
      393           define variable ii              as integer       no-undo .
      394           define variable fh              as widget-handle no-undo .
      395           define variable hh              as widget-handle no-undo .
      396           define variable v-h             as handle        extent 4 no-undo .
      397           define variable v-name-button   as character     no-undo .
      398           define variable v-help-old-x    as decimal       no-undo .
      399           define variable v-help-old-y    as decimal       no-undo .
      400           define variable v-help-old-size as decimal       no-undo .
      401           define variable v-frame-width   as decimal       no-undo .
      402           define variable jj              as integer       no-undo .
      403           do
      404               on error undo, return error
      405               :
      406               assign
      407                   v-frame-width = frame Dialog-Frame:width - 0.3
      408                   fh            = frame Dialog-Frame:first-child
      409                   hh            = fh:first-child
      410                   ii            = 1
      411                   .
      412               do while valid-handle(hh):
      413                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      414                   do:
      415                       case lc(hh:name) :
      416                           when "b-help" then
      417                               do:
      418                                   hh:load-image-up("cmp/b-help.bmp":u) .
      419                                   hh:load-image-down("cmp/b-help.bmp":u) .
      420                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      421                                   hh:TOOLTIP = "Помощь" .
      422                                   v-help-old-x = hh:column .
      423                                   v-help-old-y = hh:row    .
      424                                   v-help-old-size = hh:width .
      425                                   hh:width-chars = 2.5 .
      426                               end.
      427                           when "b-print" then
      428                               do:
      429                                   hh:load-image("cmp/b-print.bmp":u) .
      430                                   hh:TOOLTIP = "Печать" .
      431                                   v-h[ii] = hh:handle .
      432                                   ii = ii + 1 .
      433                                   hh:width-chars = 3 .
      434                               end.
      435                           when "b-history" or
      436                           when "b-hist" then
      437                               do:
      438                                   hh:load-image("cmp/b-hist.bmp":u) .
      439                                   hh:TOOLTIP = "История" .
      440                                   v-h[ii] = hh:handle .
      441                                   ii = ii + 1 .
      442                                   hh:width-chars = 3 .
      443                               end.
      444                           when "b-sch" then
      445                               do:
      446                                   hh:load-image("cmp/b-sch.bmp":u) .
      447                                   hh:TOOLTIP = "Установка Фильтра" .
      448                                   v-h[ii] = hh:handle .
      449                                   ii = ii + 1 .
      450                                   hh:width-chars = 3 .
      451                               end.
      452                           when "b-hist-user" then
      453                               do:
      454                                   hh:load-image("cmp/b-hist.bmp":u) .
      455                                   hh:TOOLTIP = "История пользователя" .
      456                                   ii = ii + 1 .
      457                               end.
      458                       end case.
      459                   end.
      460                   hh = hh:next-sibling.
      461               end.
      462               b-help:column = v-frame-width - b-help:width-chars.
      463               jj = 0.
      464               repeat ii = 4 to 1 by -1 :
      465                   if valid-handle (v-h[ii] ) then
      466                   do:
      467                       jj  = jj + 1 .
      468                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      469                       v-h[ii]:row    = v-help-old-y .
      470                   end.
      471               end.
      472           end.
      473       end.
      474   end procedure.
      475   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   on F2 of frame Dialog-Frame anywhere do:
      477     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
      478     return no-apply.
      479   end.
      480   MAIN-BLOCK:
      481   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      482      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      483     RUN my-enable in this-procedure .
      484     WAIT-FOR GO OF FRAME Dialog-Frame.
      485   END.
      486   RUN disable_UI.
      487   PROCEDURE disable_UI :
      488     HIDE FRAME Dialog-Frame.
      489   END PROCEDURE.
      490   PROCEDURE enable_UI :
      491     DISPLAY fi-obj-type fi-obj-code fi-sys-date-cls fi-sys-date-opn
      492             fi-open-time-cls fi-open-time-hms-cls fi-open-time-opn
      493             fi-open-time-hms-opn fi-close-time-cls fi-close-time-hms-cls
      494             fi-close-time-opn fi-close-time-hms-opn fi-fo-cls fi-fo-opn
      495             fi-open-id-cls fi-open-id-opn fi-close-id-cls fi-close-id-opn
      496             fi-db-num
      497         WITH FRAME Dialog-Frame.
      498     ENABLE b-exit RECT-1 RECT-2 b-help fi-obj-type fi-obj-code b-sel-obj
      499            fi-sys-date-cls fi-sys-date-opn fi-open-time-cls fi-open-time-hms-cls
      500            fi-open-time-opn fi-open-time-hms-opn fi-close-time-cls
      501            fi-close-time-hms-cls fi-close-time-opn fi-close-time-hms-opn
      502            fi-fo-cls fi-fo-opn fi-open-id-cls fi-open-id-opn fi-close-id-cls
      503            fi-close-id-opn
      504         WITH FRAME Dialog-Frame.
      505     VIEW FRAME Dialog-Frame.
      506   END PROCEDURE.
      507   PROCEDURE my-disable :
      508   END PROCEDURE.
      509   PROCEDURE my-enable :
      510     find first buf_sys-ctrl no-lock .
      511     assign
      512       fi-db-num   = buf_sys-ctrl.db-num
      513       fi-obj-type = 'маг':U
      514     .
      515     display
      516       fi-obj-type
      517       fi-obj-code
      518       fi-sys-date-cls
      519       fi-sys-date-opn
      520       fi-open-time-cls
      521       fi-open-time-hms-cls
      522       fi-open-time-opn
      523       fi-open-time-hms-opn
      524       fi-close-time-cls
      525       fi-close-time-hms-cls
      526       fi-close-time-opn
      527       fi-close-time-hms-opn
      528       fi-fo-cls
      529       fi-fo-opn
      530       fi-db-num
      531       fi-open-id-cls
      532       fi-close-id-cls
      533       fi-open-id-opn
      534       fi-close-id-opn
      535     with frame Dialog-Frame.
      536     enable
      537       b-exit
      538       b-help
      539       b-sel-obj
      540       fi-obj-type fi-obj-code
      541     with frame Dialog-Frame.
      542     view frame Dialog-Frame.
      543   END PROCEDURE.
      544   PROCEDURE proc-clr-info :
      545     assign
      546       fi-sys-date-cls       = ?
      547       fi-open-time-cls      = ?
      548       fi-open-time-hms-cls  = ?
      549       fi-close-time-cls     = ?
      550       fi-close-time-hms-cls = ?
      551       fi-fo-cls             = ?
      552       fi-sys-date-opn       = ?
      553       fi-open-time-opn      = ?
      554       fi-open-time-hms-opn  = ?
      555       fi-close-time-opn     = ?
      556       fi-close-time-hms-opn = ?
      557       fi-fo-opn             = ?
      558       fi-open-id-cls        = ?
      559       fi-close-id-cls       = ?
      560       fi-open-id-opn        = ?
      561       fi-close-id-opn       = ?
      562     .
      563     display
      564       fi-sys-date-cls
      565       fi-open-time-cls
      566       fi-open-time-hms-cls
      567       fi-close-time-cls
      568       fi-close-time-hms-cls
      569       fi-fo-cls
      570       fi-sys-date-opn
      571       fi-open-time-opn
      572       fi-open-time-hms-opn
      573       fi-close-time-opn
      574       fi-close-time-hms-opn
      575       fi-fo-opn
      576       fi-open-id-cls
      577       fi-close-id-cls
      578       fi-open-id-opn
      579       fi-close-id-opn
      580     with frame Dialog-Frame .
      581     disable
      582       b-rollback
      583     with frame Dialog-Frame.
      584   END PROCEDURE.
      585   PROCEDURE proc-cor-date :
      586     define buffer cor_obj-date for ub.obj-date.
      587     define buffer buf_obj-date for ub.obj-date.
      588     define variable v-log as logical   no-undo .
      589   do
      590   on error undo, return error return-value
      591   :
      592     message
      593       substitute("Откатить дату с &1 на &2 ?" , fi-sys-date-opn, fi-sys-date-cls) skip
      594       "Внимательно проверьте дату перед тем как произвести откат!"
      595     view-as alert-box question buttons yes-no update v-log.
      596     if v-log <> yes then do:
      597       return .
      598     end.
      599     find first buf_obj-date no-lock
      600       where buf_obj-date.obj-type   = fi-obj-type
      601         and buf_obj-date.obj-code   = fi-obj-code
      602         and buf_obj-date.sys-date   = fi-sys-date-cls
      603         and buf_obj-date.status_    = 'зкр':U
      604         and buf_obj-date.fact-order = fi-fo-cls
      605     no-error.
      606     if not available buf_obj-date
      607     then do:
      608       return error substitute( "Утилита не может быть запущена: Не прошла проверка предыдущей даты.&1&2&1&3&1&4&1&5&1&6"
      609                              , chr(10)
      610                              , fi-obj-type
      611                              , fi-obj-code
      612                              , fi-sys-date-cls
      613                              , 'зкр':U
      614                              , fi-fo-cls
      615                              ) .
      616     end.
      617     if buf_obj-date.open-time  <> fi-open-time-cls
      618     or buf_obj-date.close-time <> fi-close-time-cls
      619     then do:
      620       return error substitute( "Утилита не может быть запущена: Не прошла проверка предыдущей даты. Время открытия/закрытия не совпадают!&1&2&1&3"
      621                              , chr(10)
      622                              , fi-open-time-cls
      623                              , fi-close-time-cls
      624                              ) .
      625     end.
      626     on delete of ub.obj-date override do: end.
      627     on write of ub.obj-date override do: end.
      628     _rollback:
      629     do transaction
      630     on error undo _rollback, return error return-value
      631     on endkey undo _rollback, return error return-value
      632     :
      633       find first cor_obj-date exclusive-lock
      634         where cor_obj-date.obj-type   = fi-obj-type
      635           and cor_obj-date.obj-code   = fi-obj-code
      636           and cor_obj-date.sys-date   = fi-sys-date-opn
      637           and cor_obj-date.status_    = 'тек':U
      638       no-error.
      639       if not available cor_obj-date
      640       then do:
      641         return error substitute( "Невозможно удалить несуществующую запись.&1&2&1&3&1&4&1&5"
      642                                , chr(10)
      643                                , fi-obj-type
      644                                , fi-obj-code
      645                                , fi-sys-date-opn
      646                                , 'тек':U
      647                                ) .
      648       end.
      649       delete cor_obj-date.
      650       find current buf_obj-date exclusive-lock .
      651       assign
      652           buf_obj-date.status_    = 'тек':U
      653           buf_obj-date.close-date = ?
      654           buf_obj-date.close-time = 0
      655           buf_obj-date.close-id   = ""
      656           buf_obj-date.fact-order = 0
      657       .
      658     end.
      659     on delete of ub.obj-date revert.
      660     on write of ub.obj-date revert.
      661     run proc-obj-dates in this-procedure ( input fi-obj-type
      662                                          , input fi-obj-code
      663                                          ) .
      664   end.
      665   END PROCEDURE.
      666   PROCEDURE proc-obj-dates :
      667   define input  parameter p-obj-type as character no-undo .
      668   define input  parameter p-obj-code as integer   no-undo .
      669   define buffer buf_obj-date  for ub.obj-date.
      670   define buffer sch_obj-date  for ub.obj-date.
      671   do
      672   on error undo, return error return-value
      673   :
      674     find last buf_obj-date
      675       where buf_obj-date.obj-type   = p-obj-type
      676         and buf_obj-date.obj-code   = p-obj-code
      677         and buf_obj-date.status_    = 'зкр':U
      678     no-error .
      679     if not available buf_obj-date
      680     then do:
      681       return error substitute( "На объекте &1 &2 не найдено закрытых дат."
      682                              , p-obj-type
      683                              , p-obj-code
      684                              ) .
      685     end.
      686     assign
      687       fi-sys-date-cls       = buf_obj-date.sys-date
      688       fi-open-time-cls      = buf_obj-date.open-time
      689       fi-open-time-hms-cls  = string( buf_obj-date.open-time , "hh:mm:ss" )
      690       fi-close-time-cls     = buf_obj-date.close-time
      691       fi-close-time-hms-cls = string(buf_obj-date.close-time , "hh:mm:ss" )
      692       fi-fo-cls             = buf_obj-date.fact-order
      693       fi-open-id-cls        = usrfulnf(buf_obj-date.open-id)
      694       fi-close-id-cls       = usrfulnf(buf_obj-date.close-id)
      695     .
      696     find first buf_obj-date no-lock
      697       where buf_obj-date.obj-type   = p-obj-type
      698         and buf_obj-date.obj-code   = p-obj-code
      699         and buf_obj-date.status_    = 'тек':U
      700     no-error.
      701     if not available buf_obj-date
      702     then do:
      703       return error substitute( "На объекте &1 &2 не найдена дата в статусе &3."
      704                              , p-obj-type
      705                              , p-obj-code
      706                              , 'тек':U
      707                              ) .
      708     end.
      709     find first sch_obj-date no-lock
      710       where sch_obj-date.obj-type   = buf_obj-date.obj-type
      711         and sch_obj-date.obj-code   = buf_obj-date.obj-code
      712         and sch_obj-date.status_    = buf_obj-date.status_
      713         and recid(sch_obj-date)    <> recid(buf_obj-date)
      714     no-error .
      715     if available sch_obj-date
      716     then do:
      717       return error substitute( "На объекте &1 &2 найдено две даты в статусе &3."
      718                              , p-obj-type
      719                              , p-obj-code
      720                              , 'тек':U
      721                              ) .
      722     end.
      723     assign
      724       fi-sys-date-opn       = buf_obj-date.sys-date
      725       fi-open-time-opn      = buf_obj-date.open-time
      726       fi-open-time-hms-opn  = string( buf_obj-date.open-time , "hh:mm:ss" )
      727       fi-close-time-opn     = buf_obj-date.close-time
      728       fi-close-time-hms-opn = string(buf_obj-date.close-time , "hh:mm:ss" )
      729       fi-fo-opn             = buf_obj-date.fact-order
      730       fi-open-id-opn        = usrfulnf(buf_obj-date.open-id)
      731       fi-close-id-opn       = usrfulnf(buf_obj-date.close-id)
      732     .
      733     display
      734       fi-sys-date-cls
      735       fi-open-time-cls
      736       fi-open-time-hms-cls
      737       fi-close-time-cls
      738       fi-close-time-hms-cls
      739       fi-fo-cls
      740       fi-sys-date-opn
      741       fi-open-time-opn
      742       fi-open-time-hms-opn
      743       fi-close-time-opn
      744       fi-close-time-hms-opn
      745       fi-fo-opn
      746       fi-open-id-cls
      747       fi-close-id-cls
      748       fi-open-id-opn
      749       fi-close-id-opn
      750     with frame Dialog-Frame .
      751     enable
      752       b-rollback
      753     with frame Dialog-Frame.
      754   end.
      755   END PROCEDURE.
      756   PROCEDURE proc-sel-doc :
      757       define buffer buf_trn-doc  for trn-doc.
      758       define buffer buf_obj-date for obj-date.
      759       define buffer buf_rvs-doc  for rvs-doc.
      760       define buffer buf_price-doc for price-doc.
      761       do
      762           on error undo, return error return-value
      763           :
      764             find first buf_price-doc where
      765             buf_price-doc.obj-code = fi-obj-code
      766             and
      767             buf_price-doc.obj-type = fi-obj-type
      768             and
      769             buf_price-doc.fact-order > fi-fo-cls
      770             no-error.
      771             if available buf_price-doc
      772             then do:
      773                 return error substitute ("На объекте, на котором коректируется дата ,существуют документы с fact-order больше, чем дата которую делаем текущей "     ).
      774           end.
      775           find first buf_rvs-doc where
      776           buf_rvs-doc.obj-code = fi-obj-code
      777               and
      778               buf_rvs-doc.obj-type = fi-obj-type
      779               and
      780               buf_rvs-doc.fact-order > fi-fo-cls
      781               no-error.
      782           if available buf_rvs-doc
      783               then
      784           do:
      785               return error substitute ("На объекте, на котором коректируется дата ,существуют документы с fact-order больше, чем дата которую делаем текущей "     ).
      786           end.
      787           find first buf_trn-doc
      788               where
      789               buf_trn-doc.obj-code = fi-obj-code
      790               and
      791               buf_trn-doc.obj-type = fi-obj-type
      792               and buf_trn-doc.fact-order > fi-fo-cls
      793               no-error.
      794           if available buf_trn-doc
      795               then
      796           do:
      797               return error substitute ("На объекте, на котором коректируется дата ,существуют документы с fact-order больше, чем дата которую делаем текущей "     ).
      798           end.
      799       end.
      800       run proc-cor-date in this-procedure no-error .
      801   END PROCEDURE.
      802   PROCEDURE proc-sel-obj :
      803   define variable v-obj-type-list as character no-undo .
      804   do
      805   on error undo, return error return-value
      806   :
      807    assign frame Dialog-Frame
      808     fi-obj-type
      809     fi-obj-code
      810    .
      811    assign
      812     v-obj-type-list = 'скл':U + ',' + 'маг':U
      813    .
      814    if lookup(fi-obj-type , v-obj-type-list ) > 0
      815    then do:
      816     find first buf_clients no-lock
      817       where buf_clients.obj-type = fi-obj-type
      818         and buf_clients.obj-code = fi-obj-code
      819     no-error .
      820    end.
      821    if not available buf_clients
      822    then do:
      823     return error substitute( "Объект &1 &2 не найден"
      824                            , fi-obj-type
      825                            , fi-obj-code
      826                            ) .
      827    end.
      828    run proc-obj-dates in this-procedure ( input buf_clients.obj-type
      829                                         , input buf_clients.obj-code
      830                                         ) .
      831   end.
      832   END PROCEDURE.
