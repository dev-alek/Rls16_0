      420        SIZE 10 BY 1.
      421   DEFINE VARIABLE dir-name AS CHARACTER FORMAT "X(256)":U
      422         VIEW-AS TEXT
      423        SIZE 49.6 BY 1 NO-UNDO.
      424   DEFINE VARIABLE F-flt AS CHARACTER FORMAT "X(256)":U
      425         VIEW-AS TEXT
