      487        T-gen AT ROW 7 COL 3
      488        T-flt AT ROW 8.27 COL 3
      489        T-pbc AT ROW 9.5 COL 3
      490        T-glb AT ROW 9.5 COL 61 WIDGET-ID 2
      491        T-scl AT ROW 10.77 COL 3
      492        T-usr AT ROW 12 COL 3
      493        T-seq AT ROW 13.27 COL 3
      494        dir-name AT ROW 2.43 COL 28.6 COLON-ALIGNED NO-LABEL
      495        F-rht AT ROW 5.77 COL 27 COLON-ALIGNED NO-LABEL
      496        F-gen AT ROW 7 COL 27 COLON-ALIGNED NO-LABEL
      497        F-flt AT ROW 8.27 COL 27 COLON-ALIGNED NO-LABEL
      498        F-pbc AT ROW 9.5 COL 27 COLON-ALIGNED NO-LABEL
      499        F-scl AT ROW 10.77 COL 27 COLON-ALIGNED NO-LABEL
      500        F-usr AT ROW 12 COL 27 COLON-ALIGNED NO-LABEL
      501        F-seq AT ROW 13.27 COL 27 COLON-ALIGNED NO-LABEL
      502        "Название файла экспорта-импорта" VIEW-AS TEXT
      503             SIZE 33.5 BY .8 AT ROW 4.43 COL 29.6
      504             FGCOLOR 4
      505        "Группы данных" VIEW-AS TEXT
      506             SIZE 20.1 BY .8 AT ROW 4.43 COL 3.4
      507             FGCOLOR 4
      508        "Директория экспорта/импорта" VIEW-AS TEXT
      509             SIZE 27.9 BY 1 AT ROW 2.37 COL 2
      510             FGCOLOR 4
      511        RECT-groups AT ROW 3.87 COL 1.8
      512        SPACE(0.49) SKIP(0.25)
      513       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      514            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      515            TITLE "Экспорт-импорт локальных таблиц УБД"
      516            DEFAULT-BUTTON B-exit.
      517   ASSIGN
      518          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      519          FRAME Dialog-Frame:HIDDEN           = TRUE.
      520   ASSIGN
      521          F-seq:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      522   ASSIGN
      523          T-seq:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      524   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      525   DO:
      526     APPLY "END-ERROR":U TO SELF.
      527   END.
      528   ON CHOOSE OF B-dir IN FRAME Dialog-Frame
      529   DO:
      530       run gbl/dir-sel.p (output v_os-dir,
      531                   output v_os-dir-type,
      532                   output v_can-write) no-error.
      533       if error-status:error then return no-apply.
      534       dir-name = v_os-dir.
      535       display
      536       dir-name
      537       with frame Dialog-Frame.
      538   END.
      539   ON CHOOSE OF B-export IN FRAME Dialog-Frame
      540   DO:
      541     if NOT v_can-write then do:
      542       message "Данная директория доступна только для чтения"
      543       view-as alert-box ERROR.
      544       return no-apply.
      545     end.
      546     run waitfram-show in this-procedure ( input "Ждите..." ).
      547     run proc-b-ie in this-procedure ( input "export":U).
      548     run waitfram-hide in this-procedure .
      549   END.
      550   ON CHOOSE OF B-import IN FRAME Dialog-Frame
      551   DO:
      552    run waitfram-show in this-procedure ( input "Ждите..." ).
      553    run proc-b-ie in this-procedure ( input "import":U).
      554    run waitfram-hide in this-procedure .
      555   END.
      556   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      557   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      558   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      559   on help of frame Dialog-Frame
      560   do:
      561     run gbl/app_help.p
      562       (input this-procedure :file-name
      563       ,input ''
      564       ,input ?
      565       ) no-error.
      566     if error-status :error then do:
      567       message
      568         "Ошибка при вызове помощи"
      569         error-status :get-message(1)
      570         view-as alert-box .
      571     end.
      572   end.
      573   run minbtn-set in this-procedure .
      574   on choose of b-help in frame Dialog-Frame
      575   do:
      576     apply "help":u to frame Dialog-Frame .
      577   end.
      578   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   procedure minbtn-set :
      580       do
      581           on error undo, return error return-value
      582           :
      583           define variable ii              as integer       no-undo .
      584           define variable fh              as widget-handle no-undo .
      585           define variable hh              as widget-handle no-undo .
      586           define variable v-h             as handle        extent 4 no-undo .
      587           define variable v-name-button   as character     no-undo .
      588           define variable v-help-old-x    as decimal       no-undo .
      589           define variable v-help-old-y    as decimal       no-undo .
      590           define variable v-help-old-size as decimal       no-undo .
      591           define variable v-frame-width   as decimal       no-undo .
      592           define variable jj              as integer       no-undo .
      593           do
      594               on error undo, return error
      595               :
      596               assign
      597                   v-frame-width = frame Dialog-Frame:width - 0.3
      598                   fh            = frame Dialog-Frame:first-child
      599                   hh            = fh:first-child
      600                   ii            = 1
      601                   .
      602               do while valid-handle(hh):
      603                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      604                   do:
      605                       case lc(hh:name) :
      606                           when "b-help" then
      607                               do:
      608                                   hh:load-image-up("cmp/b-help.bmp":u) .
      609                                   hh:load-image-down("cmp/b-help.bmp":u) .
      610                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      611                                   hh:TOOLTIP = "Помощь" .
      612                                   v-help-old-x = hh:column .
      613                                   v-help-old-y = hh:row    .
      614                                   v-help-old-size = hh:width .
      615                                   hh:width-chars = 2.5 .
      616                               end.
      617                           when "b-print" then
      618                               do:
      619                                   hh:load-image("cmp/b-print.bmp":u) .
      620                                   hh:TOOLTIP = "Печать" .
      621                                   v-h[ii] = hh:handle .
      622                                   ii = ii + 1 .
      623                                   hh:width-chars = 3 .
      624                               end.
      625                           when "b-history" or
      626                           when "b-hist" then
      627                               do:
      628                                   hh:load-image("cmp/b-hist.bmp":u) .
      629                                   hh:TOOLTIP = "История" .
      630                                   v-h[ii] = hh:handle .
      631                                   ii = ii + 1 .
      632                                   hh:width-chars = 3 .
      633                               end.
      634                           when "b-sch" then
      635                               do:
      636                                   hh:load-image("cmp/b-sch.bmp":u) .
      637                                   hh:TOOLTIP = "Установка Фильтра" .
      638                                   v-h[ii] = hh:handle .
      639                                   ii = ii + 1 .
      640                                   hh:width-chars = 3 .
      641                               end.
      642                           when "b-hist-user" then
      643                               do:
      644                                   hh:load-image("cmp/b-hist.bmp":u) .
      645                                   hh:TOOLTIP = "История пользователя" .
      646                                   ii = ii + 1 .
      647                               end.
      648                       end case.
      649                   end.
      650                   hh = hh:next-sibling.
      651               end.
      652               b-help:column = v-frame-width - b-help:width-chars.
      653               jj = 0.
      654               repeat ii = 4 to 1 by -1 :
      655                   if valid-handle (v-h[ii] ) then
      656                   do:
      657                       jj  = jj + 1 .
      658                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      659                       v-h[ii]:row    = v-help-old-y .
      660                   end.
      661               end.
      662           end.
      663       end.
      664   end procedure.
      665   MAIN-BLOCK:
      666   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      667      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      668       file-info:file-name = ".".
      669       assign
      670       dir-name = file-info:full-pathname
      671       v_os-dir-type = file-info :file-type
      672       v_can-write = (index(v_os-dir-type, "W") > 0)
      673      .
      674     FIND FIRST ub.sys-ctrl No-LOCK.
      675     FIND FIRST ub.db no-LOCK where
      676                ub.db.db-num = sys-ctrl.db-num.
      677       assign
      678       f-rht = corr-file-name(db.db-key) + ".":U +   "rht"
      679       F-flt = corr-file-name(db.db-key) + ".":U +   "flt"
      680       F-pbc = corr-file-name(db.db-key) + ".":U +   "pbc"
      681       F-scl = corr-file-name(db.db-key) + ".":U +   "scl"
      682       F-usr = corr-file-name(db.db-key) + ".":U +   "usr"
      683       F-gen = corr-file-name(db.db-key) + ".":U +   "gen"
      684       F-seq = corr-file-name(db.db-key) + ".":U +   "seq"
      685       .
      686     RUN enable_UI.
      687     WAIT-FOR GO OF FRAME Dialog-Frame.
      688   END.
      689   RUN disable_UI.
      690   PROCEDURE check-iefile :
      691   DEFINE INPUT PARAMETER p-dir-name as character no-undo.
      692   DEFINE INPUT PARAMETER p-file-extension as character no-undo.
      693   DEFINE INPUT PARAMETER p-mode as character no-undo.
      694   define output parameter p-ok as logical no-undo.
      695   define variable full_name as character no-undo.
      696   FIND FIRST ub.sys-ctrl No-LOCK.
      697   FIND FIRST ub.db no-LOCK where
      698               ub.db.db-num = ub.sys-ctrl.db-num.
      699   if not avail ub.db then do:
      700       message "Отсутствует информация в таблице db"
      701       view-as alert-box ERROR.
      702       return error.
      703   end.
      704   full_name = dir-name + "\":U + corr-file-name(ub.db.db-key) + "." + p-file-extension.
      705   if p-mode = "import":U then do:
      706       if search(full_name) = ? then do:
      707       message "Не найден файл данных" full_name  skip
      708                           "для импорта"
      709           view-as alert-box ERROR.
      710           p-ok = no.
      711           return.
      712       end.
      713       p-ok = yes.
      714       return.
      715   end.
      716   if p-mode = "export":U then do:
      717       if search(full_name) <> ? then do:
      718       message "Уже имеется в выбранной директории файл с именем" full_name  skip
      719               "совпадающим с именем одного из файлов экспорта" skip
      720               "Перезаписывать?"
      721       view-as alert-box QUESTION buttons YES-NO update p-ok.
      722       return.
      723     end.
      724     p-ok = yes.
      725     return.
      726   end.
      727   END PROCEDURE.
      728   PROCEDURE disable_UI :
      729     HIDE FRAME Dialog-Frame.
      730   END PROCEDURE.
      731   PROCEDURE enable_UI :
      732     DISPLAY T-rht T-gen T-flt T-pbc T-glb T-scl T-usr dir-name F-rht F-gen F-flt
      733             F-pbc F-scl F-usr
      734         WITH FRAME Dialog-Frame.
      735     ENABLE RECT-groups B-exit B-export B-import B-Help B-dir T-rht T-gen T-flt
      736            T-pbc T-glb T-scl T-usr dir-name F-rht F-gen F-flt F-pbc F-scl F-usr
      737         WITH FRAME Dialog-Frame.
      738     VIEW FRAME Dialog-Frame.
      739   END PROCEDURE.
      740   PROCEDURE proc-b-ie :
      741   define input parameter p-mode as character no-undo.
      742    define variable ii as integer no-undo.
      743    define variable loc#log as logical no-undo.
      744    define variable file-extensions as char format "X(3)" no-undo init "rht,gen,flt,pbc,scl,usr,seq,cdr,cdk,thb,pet":U.
      745    define variable t-vals as logical no-undo extent 11.
      746    define variable v-proc-name as character no-undo .
      747    define variable v-proc-title as character no-undo .
      748    define variable v-param as character no-undo .
      749    define variable v-choice as integer no-undo .
      750    assign
      751    dir-name
      752    T-gen frame Dialog-Frame
      753    T-flt
      754    T-rht
      755    T-pbc
      756    T-scl
      757    T-usr
      758    T-seq = no
      759    t-glb
      760    .
      761    assign
      762    t-vals[2] = t-gen
      763    t-vals[3] = t-flt
      764    t-vals[1] = t-rht
      765    t-vals[4] = t-pbc
      766    t-vals[5] = t-scl
      767    t-vals[6] = t-usr
      768    t-vals[7] = t-seq
      769    .
      770    if dir-name = "" then do:
      771       message "Не задана директория для файлов экспорта/импорат"
      772       view-as alert-box ERROR.
      773       return error.
      774    end.
      775    DO ii = 1 to num-entries(file-extensions):
      776       if t-vals[ii] then do:
      777           run check-iefile in this-procedure (
      778                                              input dir-name
      779                                              ,input entry(ii, file-extensions)
      780                                              ,input p-mode
      781                                              ,output loc#log).
      782           if not loc#log then  return no-apply.
      783       end.
      784     end.
      785     assign
      786     v-param = string(T-vals[1])  + chr(4) +
      787               string(T-vals[2])  + chr(4) +
      788               string(T-vals[3])  + chr(4) +
      789               string(T-vals[4])  + chr(4) +
      790               string(T-vals[5])  + chr(4) +
      791               string(T-vals[6])  + chr(4) +
      792               string(T-vals[7])  + chr(4) +
      793               corr-file-name(ub.db.db-key) + chr(4) +
      794               dir-name + chr(4) +
      795               string(T-glb)
      796               .
      797     if p-mode = "export":U then do:
      798       assign
      799       v-proc-name = "utl/imp-expe.p"
      800       v-proc-title = "Экспорт локальных таблиц БД"
      801       .
      802     end.
      803     else do:
      804       run gbl/d-askw.w ( input "Версия файлов импорта"
      805                   ,input "Для корректного импорта данных необходимо знать, в какой версии IBS TH они были экспортированы"
      806                   ,input "|"
      807                   ,input ("12.3|" +
      808                          "14.1|" +
      809                          "15.0|" +
      810                          "Отказ")
      811                   ,input "|||"
      812                   ,input 3
      813                   ,input 4
      814                   ,output v-choice).
      815       if v-choice = 4 then do:
      816         undo, return error .
      817       end.
      818       assign
      819       v-param = v-param + chr(4) + (if v-choice = 1
      820                                           then "12.3"
      821                                           else (if v-choice = 2
      822                                                 then "14.1"
      823                                                 else "15.0"
      824                                                )
      825                                          )
      826       v-proc-name = "utl/imp-expi.p"
      827       v-proc-title = "Импорт локальных таблиц БД"
      828       .
      829     end.
      830     run str/diallog.w (
      831             input parparentproc
      832           , input this-procedure
      833           , input v-proc-name
      834           , input v-param
      835           , input no
      836           , input "":U
      837           , input v-proc-title
      838       ) no-error.
      839     if error-status:error then do:
      840       message
      841       error-status:get-message(1) skip
      842       return-value
      843       view-as alert-box error.
      844     end.
      845   END PROCEDURE.
