      430   DEFINE VARIABLE F-pbc AS CHARACTER FORMAT "X(256)":U
      431         VIEW-AS TEXT
      432        SIZE 29.4 BY .8 NO-UNDO.
      433   DEFINE VARIABLE F-rht AS CHARACTER FORMAT "X(256)":U
      434         VIEW-AS TEXT
      435        SIZE 29.4 BY .8 NO-UNDO.
      436   DEFINE VARIABLE F-scl AS CHARACTER FORMAT "X(256)":U
