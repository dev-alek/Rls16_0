        1   block-level on error undo, throw.
        2   define input parameter par-fill-method as character no-undo .
        3   define input parameter par-groups as character no-undo .
        4   define input parameter par-values as character no-undo .
        5   define input parameter par-rid-list as character no-undo .
        6     define shared temp-table  tt-tax no-undo
        7   field tax-code    like ub.tax.tax-code
        8   FIELD individual  like ub.tax.individual
        9   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       10   field rate-code   like ub.tax-rate.rate-code
       11   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       12   FIELD tax-type    like ub.tax.tax-type
       13   field rate-value  like ub.tax-rate-value.rate-value
       14   FIELD tax-rate-gds-rc  as recid
       15   FIELD to-cashdesk like ub.tax.to-cashdesk
       16   index tax-code is unique primary tax-code.
       17     define temp-table  loc-tt-tax no-undo
       18   field tax-code    like ub.tax.tax-code
       19   FIELD individual  like ub.tax.individual
       20   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       21   field rate-code   like ub.tax-rate.rate-code
       22   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       23   FIELD tax-type    like ub.tax.tax-type
       24   field rate-value  like ub.tax-rate-value.rate-value
       25   FIELD tax-rate-gds-rc  as recid
       26   FIELD to-cashdesk like ub.tax.to-cashdesk
       27   index tax-code is unique primary tax-code.
       28     define temp-table  v-tt-tax no-undo
       29   field tax-code    like ub.tax.tax-code
       30   FIELD individual  like ub.tax.individual
       31   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       32   field rate-code   like ub.tax-rate.rate-code
       33   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       34   FIELD tax-type    like ub.tax.tax-type
       35   field rate-value  like ub.tax-rate-value.rate-value
       36   FIELD tax-rate-gds-rc  as recid
       37   FIELD to-cashdesk like ub.tax.to-cashdesk
       38   index tax-code is unique primary tax-code.
       39   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       40   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       41   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       42   define variable vss-workfile    as character no-undo init "$Workfile: in-grptx.p $":U .
       43   define variable vss-archive     as character no-undo init "$Archive: utl/in-grptx.p $":U .
       44   define variable vss-description as character no-undo init "Инициализация налогов в группах товаров".
       45   procedure vss-get-info :
       46     define output parameter p-vss-revision    like vss-revision    no-undo .
       47     define output parameter p-vss-author      like vss-author      no-undo .
       48     define output parameter p-vss-date        like vss-date        no-undo .
       49     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       50     define output parameter p-vss-archive     like vss-archive     no-undo .
       51     define output parameter p-vss-description like vss-description no-undo .
       52     assign
       53       p-vss-revision    = vss-revision
       54       p-vss-author      = vss-author
       55       p-vss-date        = vss-date
       56       p-vss-workfile    = vss-workfile
       57       p-vss-archive     = vss-archive
       58       p-vss-description = vss-description
       59     .
       60   end procedure.
       61   procedure vss-get-parameters :
       62     define output parameter p-vss-parameters as character no-undo .
       63   end procedure.
       64   define new global shared variable g#vssrevis-logger as handle    no-undo .
       65   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       66   define variable v-vssrevis-logger                   as handle    no-undo .
       67   procedure vss-logevent :
       68     define input  parameter p-extra-paramters as character no-undo .
       69     define variable v-vssrevis-parameters as character no-undo .
       70     do
       71     on error undo, return error return-value
       72     :
       73       if  valid-handle(v-vssrevis-logger)
       74       and v-vssrevis-logger :get-signature("logevent") <> ""
       75       then do:
       76         run vss-get-parameters in this-procedure
       77           (output v-vssrevis-parameters
       78           ).
       79         run logevent in v-vssrevis-logger
       80           (input vss-workfile
       81           ,input vss-revision
       82           ,input v-vssrevis-parameters
       83           ,input p-extra-paramters
       84           ).
       85       end.
       86     end.
       87   end procedure.
       88   assign
       89     v-vssrevis-logger = g#vssrevis-logger
       90   .
       91   if  valid-handle(v-vssrevis-logger)
       92   and v-vssrevis-logger :get-signature("logevent") <> ""
       93   then do:
       94     assign
       95       v-vssrevis-logevent = true
       96     .
       97     run vss-logevent in this-procedure (input vss-description) .
       98   end.
       99   define new global shared variable g#language as character no-undo .
      100   if g#language <> '' and g#language <> 'rus':U then do:
      101     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      102   end.
      103   define new global shared variable g#library  as handle no-undo .
      104   define new global shared variable g#library2 as handle no-undo .
      105   define   shared variable g#auto as logical no-undo.
      106   define   shared variable g#news as logical no-undo.
      107   define   shared variable g#oxml as logical no-undo.
      108   define   shared variable g#esys as logical no-undo.
      109   define   shared variable g#news-source-db as integer no-undo.
      110   define   shared variable g#esys-source-esys as integer no-undo.
      111   define   shared variable g#db-num as integer   no-undo .
      112   define   shared variable g#userid as character no-undo .
      113   define   shared variable g#passwd as character no-undo .
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   define variable v-waitfram-action01         as character   no-undo .
      116   define variable v-waitfram-action02         as character   no-undo .
      117   define variable v-waitfram-action03         as character   no-undo .
      118   define variable mWaitFramTextBeg            as character   no-undo.
      119   define variable mWaitFramTextEnd            as character   no-undo.
      120   define variable mWaitFramView               as logical     no-undo.
      121   define variable mWaitProcEvent              as logical     no-undo init yes.
      122   define variable mWaitFramInterval           as integer     no-undo init 1 .
      123   define variable mWaitFramStop               as logical     no-undo.
      124   define variable mWaitFramStopUser           as logical     no-undo.
      125   define variable mWaitFramStopTimeOut        as logical     no-undo.
      126   define variable mWaitFramStartProc          as datetime-tz no-undo.
      127   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      128   define button B-WaitFramStop auto-end-key
      129        label "Стоп"
      130        size 10 by 1 tooltip "Остоновить процесс".
      131   define button B-viewProcInfo
      132        label "Информация"
      133        size 15 by 1 tooltip "Информация о процесс".
      134   define frame waitfram
      135     v-waitfram-action01 format "x(72)" no-label skip
      136     v-waitfram-action02 format "x(72)" no-label skip
      137     v-waitfram-action03 format "x(72)" no-label skip
      138     B-viewProcInfo
      139     B-WaitFramStop at row 4 col 30
      140     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      141     .
      142   define new global shared variable mBatchMode as logical no-undo init ?.
      143   define variable mFramBachModHandle as handle no-undo.
      144   mFramBachModHandle = frame waitfram:handle.
      145   define variable mFameOldVis as logical no-undo.
      146   define variable mVisCUrentVin as logical no-undo.
      147   if session:batch-mode
      148   then
      149      mBatchMode = yes.
      150   if mBatchMode = ? then do:
      151     mVisCUrentVin = current-window:visible.
      152     mFameOldVis = mFramBachModHandle:visible.
      153     mFramBachModHandle:visible  = yes.
      154     mBatchMode = mFramBachModHandle:visible ne yes.
      155     mFramBachModHandle:visible = mFameOldVis.
      156     current-window:visible = mVisCUrentVin.
      157   end.
      158    if  log-manager:logfile-name ne ?
      159     then DO:
      160         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      161         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      162         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      163     end.
      164   on choose of B-WaitFramStop in frame waitfram
      165   do:
      166     mWaitFramStop = yes.
      167     mWaitFramStopUser = yes.
      168   end.
      169   function waitfram-check-timeout returns logical():
      170      define variable vtime as int64 no-undo.
      171      if mWaitFramStopTimeOut
      172      then
      173         return yes.
      174      vtime = ( now - mWaitFramStartProc ) / 1000 .
      175      if     mWaitFramTimeOut ne ?
      176         and mWaitFramTimeOut ne 0
      177         and mWaitFramTimeOut lt vtime
      178      then do:
      179         mWaitFramStopTimeOut = yes.
      180      end.
      181      return mWaitFramStopTimeOut.
      182   end.
      183   procedure waitfram-hide :
      184     if not session:batch-mode
      185     then do
      186     on error undo, return error return-value
      187     :
      188       pause 0 before-hide .
      189       if not mBatchMode then
      190         hide frame waitfram .
      191     if     not mWaitFramView
      192        and mWaitProcEvent
      193     then
      194       process events .
      195     end.
      196   end procedure.
      197   procedure waitfram-show :
      198     define input  parameter p-message as character no-undo .
      199     define variable v-left-margin as integer   no-undo .
      200     if not session:batch-mode
      201     then do
      202     on error undo, return error return-value
      203     :
      204       if length(p-message) <= 70 then do:
      205         assign
      206           v-left-margin = integer((70 - length(p-message)) / 2)
      207         .
      208         assign
      209           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      210         .
      211         assign
      212           v-waitfram-action01 = " "
      213           v-waitfram-action02 = " "
      214                                    + fill(" ", v-left-margin)
      215                                    + p-message
      216           v-waitfram-action03 = " "
      217         .
      218       end.
      219       else do:
      220         define variable vRindex1 as integer no-undo.
      221         define variable vRindex2 as integer no-undo.
      222         vRindex1 = r-index(p-message," ",70).
      223         if vRindex1 = 0
      224         then
      225            vRindex1 = 70.
      226         if length(p-message)  <= vRindex1 + 70 then do:
      227           assign
      228             v-waitfram-action01 = " "
      229             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      230             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      231           .
      232         end.
      233         else do:
      234           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      235           if vRindex2 <= vRindex1
      236           then
      237              vRindex2 = vRindex1 + 70.
      238           assign
      239             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      242           .
      243         end.
      244       end.
      245       B-viewProcInfo:visible   in frame waitfram = no.
      246       B-viewProcInfo:sensitive in frame waitfram = no.
      247       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      248       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      249       if  (   mWaitFramView
      250          or  mWaitProcEvent)
      251          and not mBatchMode
      252       then
      253          display
      254             v-waitfram-action01 skip
      255             v-waitfram-action02 skip
      256             v-waitfram-action03 skip
      257          with frame waitfram .
      258       if     mWaitFramView
      259          then do:
      260             if     mWaitFramInterval ne ?
      261                and not mBatchMode
      262             then
      263                wait-for go of frame waitfram pause mWaitFramInterval.
      264          end.
      265          else
      266             if     mWaitProcEvent
      267                and not mBatchMode
      268             then
      269                process events .
      270     end.
      271   end procedure.
      272      procedure waitfram-show-this:
      273         define input  parameter iInterval as int64 no-undo.
      274         define variable vtime as int64 no-undo.
      275         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      276         mWaitFramInterval = iInterval.
      277         run waitfram-show (substitute("&1&2 &3&4" ,
      278                                       mWaitFramTextBeg ,
      279                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      280                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      281                                       mWaitFramTextEnd
      282                                      )
      283                           ).
      284      end.
      285      procedure WaitFramRunPause:
      286         define input  parameter iInterval as dec no-undo.
      287         define variable vStart  as datetime-tz no-undo.
      288         define variable vend    as datetime-tz no-undo.
      289         define variable vint as int64 no-undo.
      290         define variable vOk as logical no-undo.
      291         vStart = now.
      292         vend   = vStart.
      293         publish "WaitFramPause" (iInterval,output vOk).
      294         vend   =  now.
      295         vint = vend - vStart.
      296         vint = iInterval - vint / 1000.
      297         if     not mWaitFramStop
      298            and (   vint > 0
      299                 or (    not vOk
      300                     and iInterval eq ?
      301                     )
      302                 )
      303         then
      304            run waitfram-show-this (iInterval).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and vint > 0
      310         then do:
      311            run gbl/pause.p (vint * 1000).
      312         end.
      313         if iInterval ne ?
      314         then
      315            publish "WaitFramStop".
      316         waitfram-check-timeout().
      317      end.
      318      procedure WaitFramWaitFor:
      319         define input  parameter iInterval as dec no-undo.
      320         assign
      321            mWaitFramStartProc   = now
      322            mWaitFramStopUser    = no
      323            mWaitFramStopTimeOut = no
      324         .
      325         block-wait:
      326         do while not mWaitFramStop:
      327            run WaitFramRunPause (iInterval).
      328            if  waitfram-check-timeout()
      329            then do:
      330               leave block-wait.
      331            end.
      332         end.
      333         run waitfram-hide.
      334      end.
      335   procedure waitfram-join :
      336     define input  parameter p-line-1  as character no-undo .
      337     define input  parameter p-line-2  as character no-undo .
      338     define input  parameter p-line-3  as character no-undo .
      339     define output parameter p-message as character no-undo .
      340     do
      341     on error undo, return error return-value
      342     :
      343       assign
      344         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      345                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      346                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      347       .
      348     end.
      349   end procedure.
      350   function waitfram-join-function returns character
      351     (input p-line-1 as character
      352     ,input p-line-2 as character
      353     ,input p-line-3 as character
      354     ).
      355     define variable v-message as character no-undo .
      356     run waitfram-join in this-procedure
      357       (input  p-line-1
      358       ,input  p-line-2
      359       ,input  p-line-3
      360       ,output v-message
      361       ) .
      362     return v-message .
      363   end function .
      364   DEFINE VARIABLE ii as integer no-undo .
      365   DEFINE VARIABLE jj as integer no-undo .
      366   DEFINE VARIABLE kk as integer no-undo .
      367   define variable v-process as logical no-undo .
      368   define variable v-contin as logical no-undo .
      369   define variable v-node-code like ub.gds-grp.node-code no-undo .
      370   define variable v-lvl-num as integer no-undo .
      371   define variable glog as logical no-undo .
      372   define buffer upper_gds-grp for ub.gds-grp.
      373   if ( g#db-num > 0 ) then do:
      374     message vss-workfile vss-revision vss-description skip
      375     "Утилиту можно запустить только в ГБД"
      376     view-as alert-box error .
      377     return error .
      378   end.
      379   message
      380   "Инициализация налогов в ГРУППАХ ТОВАРОВ ?   Вы уверены ?"
      381   view-as alert-box question buttons OK-Cancel update glog.
      382   if glog <> true then return.
      383   for each tt-tax no-lock:
      384     find first loc-tt-tax where
      385               loc-tt-tax.tax-code = tt-tax.tax-code no-error .
      386     if not available loc-tt-tax then do:
      387       create loc-tt-tax.
      388       buffer-copy tt-tax to loc-tt-tax.
      389     end.
      390   end.
      391   CASE par-values:
      392     when "default":U then do:
      393       _group:
      394       for each ub.gds-grp
      395       on error undo, next:
      396         CASE par-groups:
      397           when "select":U then do:
      398              if lookup(string(recid(ub.gds-grp)), par-rid-list) = 0 then NEXT _group.
      399           end.
      400           when "select-tree" then do:
      401             assign
      402             v-contin = yes
      403             v-node-code = ub.gds-grp.node-code
      404             .
      405             do while v-contin:
      406               run tree-up in this-procedure (input-output v-node-code, output v-contin, output v-process).
      407             end.
      408             if not v-process then NEXT _group.
      409           end.
      410         END CASE.
      411         ii = ii + 1.
      412         run proc-assign in this-procedure
      413                         (buffer ub.gds-grp
      414                           ) no-error .
      415         if not error-status:error and return-value <> "error":U then
      416         jj = jj + 1.
      417         run waitfram-show in this-procedure ("Обработано" + chr(32) +
      418                        string(ii) + chr(32) +
      419                        "записей - успешно" + chr(32) +
      420                        string(jj)).
      421       END.
      422     end.
      423     when "group":U then do:
      424       CASE par-groups:
      425         when "all":U or when "select-tree":U then do:
      426           find first upper_gds-grp No-LOCK where upper_gds-grp.upper-code = 0.
      427           assign
      428           v-lvl-num = upper_gds-grp.lvl-num
      429           v-node-code= upper_gds-grp.node-code
      430           .
      431           do while available upper_gds-grp:
      432             if upper_gds-grp.upper-code <> 0 then
      433             run ini-tree in this-procedure
      434                             (
      435                             input upper_gds-grp.node-code
      436                             ,input (upper_gds-grp.lvl-num + 1)
      437                         ).
      438             find first upper_gds-grp NO-LOCK where
      439                        upper_gds-grp.lvl-num = v-lvl-num
      440                    AND upper_gds-grp.node-code > v-node-code no-error .
      441             if not avail upper_gds-grp then do:
      442               assign
      443               v-lvl-num = v-lvl-num + 1
      444               v-node-code = 0
      445               .
      446             end.
      447             find first upper_gds-grp NO-LOCK where
      448                        upper_gds-grp.lvl-num = v-lvl-num
      449                    AND upper_gds-grp.node-code > v-node-code no-error .
      450             if avail upper_gds-grp then do:
      451               assign
      452               v-lvl-num = upper_gds-grp.lvl-num
      453               v-node-code = upper_gds-grp.node-code
      454               .
      455             end.
      456           end.
      457         end.
      458         when "select":U then do:
      459           do kk = 1 to num-entries(par-rid-list):
      460             find first ub.gds-grp where
      461                       recid(ub.gds-grp) = integer(entry(kk, par-rid-list)) no-error .
      462             if avail ub.gds-grp then do:
      463               find first upper_gds-grp where
      464                          upper_gds-grp.node-code = ub.gds-grp.upper-code no-error .
      465                if avail upper_gds-grp then
      466                 run ini-tree  in this-procedure
      467                               (
      468                               input upper_gds-grp.node-code
      469                               ,input (upper_gds-grp.lvl-num + 1)
      470                           ).
      471             end.
      472           end.
      473         end.
      474       END CASE.
      475     end.
      476   END CASE.
      477   run waitfram-hide in this-procedure .
      478   message
      479   "Работа утилиты завершена" skip
      480   "Обработано" ii "записей"  skip
      481   "успешно" jj
      482   view-as alert-box .
      483   procedure proc-assign :
      484   define parameter buffer buf_gds-grp for ub.gds-grp.
      485   define variable v-value as integer no-undo .
      486   define variable v-type as character no-undo .
      487   define variable ll as integer no-undo .
      488   define variable v-error as logical no-undo .
      489   define buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp .
      490   define buffer buf_tax-rate for ub.tax-rate.
      491     do
      492     on error undo, return error
      493     :
      494       for each loc-tt-tax no-lock:
      495         find first buf_tax-rate-gds-grp where
      496                    buf_tax-rate-gds-grp.node-code = buf_gds-grp.node-code
      497               AND buf_tax-rate-gds-grp.tax-code = loc-tt-tax.tax-code
      498               AND buf_tax-rate-gds-grp.host-code = 0
      499               AND buf_tax-rate-gds-grp.obj-type = "":U
      500               AND buf_tax-rate-gds-grp.obj-code = 0 no-error .
      501         if available buf_tax-rate-gds-grp then do:
      502           find first buf_tax-rate no-lock where
      503                      buf_tax-rate.tax-code = buf_tax-rate-gds-grp.tax-code
      504                  AND buf_tax-rate.rate-code = buf_tax-rate-gds-grp.rate-code no-error .
      505           if not available buf_tax-rate then do:
      506             v-value = ?
      507             .
      508           end.
      509           else do:
      510             assign
      511             v-value = buf_tax-rate-gds-grp.rate-code
      512             .
      513           end.
      514         end.
      515         else do:
      516           assign
      517           v-value = ?
      518           .
      519         end.
      520         find first v-tt-tax where
      521                   v-tt-tax.tax-code = loc-tt-tax.tax-code no-error .
      522         if not available v-tt-tax then
      523         create v-tt-tax.
      524         buffer-copy loc-tt-tax except rate-code to v-tt-tax
      525         assign
      526         v-tt-tax.rate-code = v-value
      527         .
      528         CASE par-fill-method:
      529           when "all":U then do:
      530             assign
      531             v-tt-tax.rate-code = loc-tt-tax.rate-code
      532             .
      533           end.
      534           when "error-or-space":U then do:
      535             if v-tt-tax.rate-code = ? then do:
      536               assign
      537               v-tt-tax.rate-code = loc-tt-tax.rate-code
      538               .
      539             end.
      540           end.
      541         END CASE.
      542         if not available buf_tax-rate-gds-grp
      543         or buf_tax-rate-gds-grp.rate-code <> v-tt-tax.rate-code then do:
      544           if not available buf_tax-rate-gds-grp then do:
      545             create buf_tax-rate-gds-grp.
      546             assign
      547             buf_tax-rate-gds-grp.node-code = buf_gds-grp.node-code
      548             buf_tax-rate-gds-grp.host-code = 0
      549             buf_tax-rate-gds-grp.obj-type = "":U
      550             buf_tax-rate-gds-grp.obj-code = 0
      551             .
      552           end.
      553           assign
      554           buf_tax-rate-gds-grp.tax-code = v-tt-tax.tax-code
      555           buf_tax-rate-gds-grp.rate-code = v-tt-tax.rate-code
      556           .
      557         end.
      558       end.
      559     end.
      560   end procedure.
      561   procedure ini-tree :
      562   define input parameter par-node-code like ub.gds-grp.node-code no-undo .
      563   define input parameter par-lvl-num   like ub.gds-grp.lvl-num no-undo .
      564   define variable v-value as character no-undo .
      565   define variable v-type as character no-undo .
      566   define variable v-rid as recid no-undo .
      567   DEFINE VARIABLE v-contin as logical no-undo .
      568   define variable v-process as logical no-undo .
      569   define variable v-nc like ub.gds-grp.node-code no-undo .
      570   define buffer buf_gds-grp for ub.gds-grp.
      571   define buffer new_gds-grp for ub.gds-grp.
      572   define buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp.
      573   define buffer buf_tax-rate for ub.tax-rate.
      574     do
      575     on error undo, return error
      576     :
      577       for each tt-tax no-lock
      578         , first loc-tt-tax where loc-tt-tax.tax-code = tt-tax.tax-code
      579       :
      580         find first buf_tax-rate-gds-grp no-lock where
      581                   buf_tax-rate-gds-grp.node-code = par-node-code
      582               AND buf_tax-rate-gds-grp.tax-code = tt-tax.tax-code
      583               AND buf_tax-rate-gds-grp.host-code = 0
      584               AND buf_tax-rate-gds-grp.obj-type = "":U
      585               AND buf_tax-rate-gds-grp.obj-code = 0 no-error .
      586         if available buf_tax-rate-gds-grp then do:
      587           find first buf_tax-rate no-lock where
      588                      buf_tax-rate.tax-code = buf_tax-rate-gds-grp.tax-code
      589                  AND buf_tax-rate.rate-code = buf_tax-rate-gds-grp.rate-code no-error .
      590           if not available buf_tax-rate then do:
      591             assign
      592             loc-tt-tax.rate-code =tt-tax.rate-code
      593             .
      594           end.
      595           else do:
      596             assign
      597             loc-tt-tax.rate-code = buf_tax-rate-gds-grp.rate-code
      598             .
      599           end.
      600         end.
      601         else do:
      602           assign
      603           loc-tt-tax.rate-code = tt-tax.rate-code
      604           .
      605         end.
      606       end.
      607       _buf_gds-grp:
      608       for each  buf_gds-grp where
      609                 buf_gds-grp.upper-code = par-node-code AND
      610                 buf_gds-grp.lvl-num = par-lvl-num:
      611         if par-groups = "select-tree":U then do:
      612           assign
      613           v-contin = yes
      614           v-nc = buf_gds-grp.node-code
      615           .
      616           do while v-contin:
      617             run tree-up in this-procedure (input-output v-nc, output v-contin, output v-process).
      618           end.
      619         end.
      620         else v-process = yes
      621         .
      622         if not v-process then do:
      623           next _buf_gds-grp.
      624         end.
      625         assign
      626         ii = ii + 1
      627         .
      628         run proc-assign in this-procedure (
      629                                             buffer buf_gds-grp
      630                                             ) no-error .
      631         if not error-status:error and return-value <> "error":U then
      632         jj = jj + 1.
      633         release buf_gds-grp no-error .
      634         run waitfram-show in this-procedure ("Обработано" + chr(32) +
      635                       string(jj) + chr(32) +
      636                       "записей - успешно" + chr(32) +
      637                       string(ii)).
      638       end.
      639     end.
      640   end procedure.
      641   procedure tree-up :
      642   define input-output parameter p-node-code like ub.gds-grp.node-code no-undo .
      643   define output parameter p-contin as logical no-undo init yes.
      644   define output parameter p-process as logical no-undo init yes.
      645   define buffer buf_gds-grp for ub.gds-grp.
      646     do
      647     on error undo, return error
      648     :
      649       find first buf_gds-grp no-lock where
      650                  buf_gds-grp.node-code = p-node-code no-error .
      651       if not avail buf_gds-grp then do:
      652         assign
      653         p-process = no
      654         p-contin = no
      655         .
      656         return.
      657       end.
      658       if lookup(string(recid(buf_gds-grp)), par-rid-list) > 0 then do:
      659         assign
      660         p-process = yes
      661         p-contin = no
      662         .
      663         return.
      664       end.
      665       else do:
      666         assign
      667         p-process = no
      668         p-contin = yes
      669         p-node-code = buf_gds-grp.upper-code
      670         .
      671         return.
      672       end.
      673     end.
      674   end procedure.
