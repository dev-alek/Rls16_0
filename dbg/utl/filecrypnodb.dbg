        1   block-level on error undo, throw.
        2   block-level on error undo, throw.
        3   define input parameter p-infile  as character no-undo.
        4   define input parameter p-pasword as character no-undo.
        5   define input parameter p-encrypt as logical   no-undo.
        6   define input parameter p-outfile as character no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: 15ea7233baa8, 1928, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: obrezanova $":U .
        9   define variable vss-date        as character no-undo init "$Date: Fri Jul 12 15:10:05 2019 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: filecryp.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: utl/filecryp.p $":U .
       12   define variable vss-description as character no-undo init "шифрование файла".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vss-include-info0 as character format "X(65)" no-undo
       72   initial "@(#)$Workfile$ $Revision$".
       73   procedure pencrypt :
       74          define input parameter ip-value-to-enc as character no-undo.
       75          define output parameter op-char-value  as character no-undo.
       76     define variable crypto-value           as raw       no-undo.
       77     do
       78     on error undo, return error return-value
       79     :
       80      assign
       81         crypto-value  = encrypt(ip-value-to-enc)
       82         op-char-value = base64-encode(crypto-value)
       83      no-error.
       84      if error-status:error then op-char-value = ? .
       85      end.
       86   end procedure.
       87   define variable vss-include-info1 as character format "X(65)" no-undo
       88   initial "@(#)$Workfile$ $Revision$".
       89   procedure pdecrypt :
       90        define input  parameter ip-value-to-dec as character no-undo.
       91        define output parameter op-char-value   as character no-undo.
       92     define variable decrypt-value          as raw       no-undo.
       93     define variable long-char-value        as longchar  no-undo.
       94     do
       95     on error undo, return error return-value
       96     :
       97      assign
       98         long-char-value = ip-value-to-dec
       99         op-char-value   = get-string(decrypt(base64-decode(long-char-value)),1)
      100         long-char-value = ""
      101      no-error.
      102      if error-status:error then op-char-value = ? .
      103      end.
      104   end procedure.
      105   DEFINE STREAM st-in.
      106   DEFINE STREAM st-out.
      107   DEFINE VARIABLE v-in-string  AS CHARACTER NO-UNDO .
      108   DEFINE VARIABLE v-out-string AS CHARACTER NO-UNDO .
      109   DEFINE VARIABLE v-file-name  AS CHARACTER NO-UNDO .
      110   DEFINE VARIABLE v-count      AS INTEGER   NO-UNDO .
      111   DO
      112   ON ERROR UNDO, RETURN ERROR
      113   :
      114      v-file-name = SEARCH(p-infile).
      115      IF p-encrypt = ? THEN DO:
      116         RETURN ERROR "Не опредлено дейcтвие".
      117      END.
      118      IF p-infile = p-outfile THEN DO:
      119         RETURN ERROR "Нельзя выходным файлом указывать входной".
      120      END.
      121      INPUT  STREAM st-in  FROM VALUE(v-file-name) .
      122      OUTPUT STREAM st-out TO   VALUE(p-outfile) .
      123      SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY(p-pasword).
      124      REPEAT:
      125         ASSIGN
      126            v-out-string = ""
      127            v-in-string  = ""
      128         .
      129         IMPORT STREAM st-in UNFORMATTED
      130            v-in-string
      131            .
      132         if p-encrypt THEN DO:
      133   define variable vss-include-info2 as character format "X(65)" no-undo
      134   initial "@(#)$Workfile$ $Revision$".
      135   run pencrypt in this-procedure (input  v-in-string
      136     ,output v-out-string
      137     )  .
      138         END.
      139         ELSE DO:
      140   define variable vss-include-info3 as character format "X(65)" no-undo
      141   initial "@(#)$Workfile$ $Revision$".
      142   run pdecrypt in this-procedure (input  v-in-string
      143     ,output v-out-string
      144     )  .
      145         END.
      146         PUT STREAM st-out UNFORMATTED
      147            v-out-string SKIP
      148            .
      149      END.
      150      INPUT  STREAM st-in  CLOSE.
      151      OUTPUT STREAM st-out CLOSE.
      152   END.
