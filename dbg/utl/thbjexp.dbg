        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: thbjexp.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/thbjexp.p $":U .
        8   define variable vss-description as character no-undo init "Экспорт настроек объектов TH, лежащих в THBJ-ATTR".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable v-file-name as character no-undo .
       68   define variable v-old-file-name as character no-undo .
       69   define variable v-dir-name as character no-undo .
       70   define variable v-yesno as logical no-undo .
       71   define variable v-mode-log as logical no-undo .
       72   define variable v-mode as character no-undo .
       73   message
       74   "Хотите экспортировать уникальное имя каждой записи (uniq-key-rec)?"
       75   view-as alert-box question buttons yes-no-cancel update v-mode-log.
       76   if v-mode-log = ? then return no-apply.
       77   if v-mode-log then do:
       78     v-mode = "full".
       79   end.
       80   v-yesno = no.
       81     run gbl/d-file.p (
       82           input-output v-file-name
       83         , input-output v-dir-name
       84         , input  (" Все файлы txt (*.txt) ")
       85         , input  ("*.txt":U)
       86         , input  chr(44)
       87         , input  (".txt":U)
       88         , input  no
       89         , input  yes
       90         , input  yes
       91         , input  "Введите имя файла для экспорта"
       92         , output v-yesno
       93     ) no-error.
       94     if error-status:error
       95     or v-yesno = no then return no-apply.
       96     run export-thbj in this-procedure  (
       97                                    input v-file-name
       98                                   ,input v-mode
       99                                  ) NO-ERROR.
      100     IF ERROR-STATUS:ERROR THEN DO:
      101        MESSAGE
      102        ERROR-STATUS:GET-MESSAGE(1) SKIP
      103        RETURN-VALUE
      104        VIEW-AS ALERT-BOX.
      105        RETURN NO-APPLY.
      106     END.
      107     define variable v-md5-signature as character no-undo .
      108     define variable v-full-file-name          as character                no-undo .
      109     define variable v-path                    as character                no-undo .
      110     DEFINE VARIABLE v-full-path               as character                no-undo .
      111     DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      112     DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      113     run gbl/md5.p ( input v-file-name
      114                    ,output v-md5-signature ) .
      115     run gbl/filename.p (
      116                    input v-file-name
      117                   ,output v-full-path
      118                   ,output v-path
      119                   ,output v-full-file-name
      120                   ,output v-file-name-no-ext
      121                   ,output v-file-name-ext
      122                   ) no-error .
      123     if error-status:error then do:
      124       message
      125       return-value
      126       view-as alert-box ERROR.
      127       return.
      128     end.
      129     output to value(v-path + chr(47) + v-file-name-no-ext + ".md5").
      130     put unformatted v-md5-signature skip.
      131     output close.
      132   procedure export-thbj :
      133   define input parameter p-file-name as character no-undo .
      134   define input parameter p-mode as character no-undo .
      135   do
      136   on error undo, return error
      137   :
      138   define variable v-thbj-exp-tables as character no-undo .
      139   define variable v-thbj-exp-table-names as character no-undo .
      140   define variable err-count as integer no-undo .
      141   define variable rec-count as integer no-undo .
      142   define variable v-ii as integer no-undo .
      143   define variable v-prepare-phrase as character no-undo .
      144   define variable num-rec as integer no-undo .
      145   define variable num-err as integer no-undo .
      146   assign
      147   v-thbj-exp-tables =  'thbj-attr':U
      148                       .
      149   assign
      150   v-thbj-exp-table-names = 'Параметры объекта TH':U
      151                           .
      152   do v-ii = 1 to num-entries( v-thbj-exp-tables, ";"):
      153     CASE entry(v-ii, v-thbj-exp-tables, ";"):
      154       otherwise do:
      155         v-prepare-phrase = substitute(" for each &1 ", entry(v-ii, v-thbj-exp-tables, ";")).
      156       end.
      157    END CASE.
      158     rec-count = num-rec.
      159     err-count = num-err.
      160     run utl/upg-exp.p ( input p-file-name
      161                        ,input ''
      162                        ,input p-mode
      163                        ,input (if v-ii = 1 then no else yes)
      164                        ,input (if v-ii = 1 then yes else no)
      165                        ,input ( if v-ii = num-entries(v-thbj-exp-tables, ";") then yes else no)
      166                        ,input entry(v-ii, v-thbj-exp-tables, ";")
      167                        ,input (if num-entries(entry(v-ii, v-thbj-exp-tables, ";")) > 1
      168                                then num-entries(entry(v-ii, v-thbj-exp-tables, ";"))
      169                                else 1)
      170                        ,input v-prepare-phrase
      171                        ,input-output rec-count
      172                        ,input-output err-count
      173                        ) no-error.
      174     if not error-status:error then do:
      175       num-rec = rec-count.
      176       num-err = err-count.
      177     end.
      178   end.
      179   end.
      180   end procedure.
