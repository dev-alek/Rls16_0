      278   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      279   procedure cur-time :
      280      define output parameter p-today as date      no-undo .
      281      define output parameter p-time  as integer   no-undo .
      282     do
      283     on error undo, return error
      284     :
      285       define variable v-date1 as date      no-undo .
      286       define variable v-date2 as date      no-undo .
      287       define variable v-time  as integer   no-undo .
      288       assign
      289         v-date1 = today
      290         v-time  = time
      291         v-date2 = today
      292       .
      293       if v-date1 <> v-date2
      294       then do:
      295         assign
      296           v-date1 = today
      297           v-time  = v-time
      298         .
      299       end.
      300       assign
      301         p-today = v-date1
      302         p-time  = v-time
      303       .
      304     end.
      305   end.
      306   function cur-time-date returns character
      307   :
      308     return string(today, '99/99/9999':U) .
      309   end.
      310   function cur-time-mjd returns decimal
      311   :
      312     define variable v-date as date      no-undo .
      313     define variable v-time as integer   no-undo .
      314     run cur-time in this-procedure
      315       (output v-date
      316       ,output v-time
      317       ) .
      318     return integer(v-date) - 2400002 + (v-time / 86400) .
      319   end.
      320   function cur-time-get-ending-index returns integer
      321   (input p-number as integer
      322   )
      323   :
      324     if p-number < 0
      325     or p-number = ?
      326     then do:
      327       return 1 .
      328     end.
      329     define variable v-rest as integer   no-undo .
      330     assign
      331       p-number = p-number modulo 100
      332     .
      333     if p-number < 20
      334     then do:
      335       assign
      336         v-rest = p-number
      337       .
      338     end.
      339     else do:
      340       assign
      341         v-rest = p-number modulo 10
      342       .
      343     end.
      344     case v-rest :
      345       when 1
      346       then do:
      347         return 2 .
      348       end.
      349       when 2 or
      350       when 3 or
      351       when 4
      352       then do:
      353         return 3 .
      354       end.
      355       otherwise do:
      356         return 1 .
      357       end.
      358     end case .
      359   end.
      360   procedure cur-time-mjd-to-date :
      361      define input  parameter i-mjd-diff as decimal no-undo.
      362      define output parameter o-Date     as date    no-undo.
      363      define output parameter o-Time     as integer no-undo.
      364      define variable v-day-number as integer   no-undo .
      365      if    i-mjd-diff < 0
      366         or i-mjd-diff = ?
      367      then do:
      368         return "?" .
      369      end.
      370      assign
      371         v-day-number = truncate(i-mjd-diff,0).
      372         o-Date = date(v-day-number + 2400002).
      373         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      374     .
      375   end.
      376   function cur-time-mjd-to-string returns character
      377   (input p-mjd-diff as decimal
      378   )
      379   :
      380     define variable v-day-number as integer   no-undo .
      381     define variable v-seconds    as integer   no-undo .
      382     define variable v-hour       as integer   no-undo .
      383     define variable v-min        as integer   no-undo .
      384     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      385     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      386     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      387     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      388     if p-mjd-diff < 0
      389     or p-mjd-diff = ?
      390     then do:
      391       return "?" .
      392     end.
      393     assign
      394       v-day-number = integer(truncate(p-mjd-diff,0))
      395       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      396     .
      397     if v-seconds > 86400
      398     then do:
      399       assign
      400         v-seconds = 86400 - 1
      401       .
      402     end.
      403     if v-seconds < 0
      404     then do:
      405       assign
      406         v-seconds = 0
      407       .
      408     end.
      409     assign
      410       v-hour = truncate(v-seconds / 3600, 0)
      411     .
      412     assign
      413       v-seconds = v-seconds modulo 3600
      414     .
      415     assign
      416       v-min = truncate(v-seconds / 60, 0)
      417     .
      418     assign
      419       v-seconds = v-seconds modulo 60
      420     .
      421     return
      422         (if v-day-number <> 0
      423           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      424           else ""
      425         )
      426       + (if v-day-number <> 0 or v-hour <> 0
      427           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      428           else ""
      429         )
      430       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      431           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      432           else ""
      433         )
      434       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      435       .
      436   end.
      437   function cur-time-string returns character
      438   :
      439     define variable v-date as date      no-undo .
      440     define variable v-time as integer   no-undo .
      441     run cur-time in this-procedure
      442       (output v-date
      443       ,output v-time
      444       ) .
      445     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      446   end.
      447   function cur-time-string-sec returns character
      448   :
      449     define variable v-date as date      no-undo .
      450     define variable v-time as integer   no-undo .
      451     run cur-time in this-procedure
      452       (output v-date
      453       ,output v-time
      454       ) .
      455     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      456   end.
      457   function cur-time-custom  returns character
      458   (input p-prefix as character
      459   ,input p-date-format as character
      460   ,input p-delimiter as character
      461   ,input p-time-format as character
      462   ,input p-suffix as character
      463   )
      464   :
      465     define variable v-date as date      no-undo .
      466     define variable v-time as integer   no-undo .
      467     run cur-time in this-procedure
      468       (output v-date
      469       ,output v-time
      470       ) .
      471     return
      472       p-prefix
      473       + string(v-date, p-date-format)
      474       + p-delimiter
      475       + string(v-time, p-time-format)
      476       + p-suffix
      477       .
      478   end.
      479   function cur-time-print  returns character
      480   :
      481     define variable v-date as date      no-undo .
      482     define variable v-time as integer   no-undo .
      483     run cur-time in this-procedure
      484       (output v-date
      485       ,output v-time
      486       ) .
      487     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      488   end.
      489   function cur-time-datetime returns datetime
      490   :
      491     define variable v-char as character no-undo .
      492     define variable v-datetime as datetime no-undo .
      493     v-char = cur-time-string().
      494     v-datetime = datetime(v-char).
      495     return  v-datetime.
      496   end.
      497   function cur-time-string-msec returns character
      498   :
      499     define variable v-date as datetime  no-undo .
      500     v-date = now.
      501     return string(v-date) .
      502   end.
      503   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      504   procedure gen-key-rec :
      505     define input  parameter p-tbl-name    as character no-undo.
      506     define input  parameter p-bh_tbl-name as handle    no-undo.
      507     define output parameter p-key-rec     as character no-undo.
      508     do
      509     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      510     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      511     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      512     :
      513       define variable fh               as handle    no-undo .
      514       define variable v-ok             as logical   no-undo .
      515       define variable v-inform         as character no-undo .
      516       define variable v-ind            as integer   no-undo .
      517       define variable v-idx-field-qnty as integer   no-undo .
      518       if p-tbl-name = ?
      519         or p-tbl-name = "":U
      520       then do:
      521         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      522       end.
      523       if not p-bh_tbl-name:available then do:
      524         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      525       end.
      526       assign
      527         p-key-rec = p-tbl-name
      528         v-inform  = p-bh_tbl-name:index-information(1)
      529         v-ind     = 2
      530       .
      531       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      532       on error undo, return error
      533       :
      534         assign
      535           v-inform = p-bh_tbl-name:index-information( v-ind )
      536           v-ind    = v-ind + 1
      537         .
      538       end.
      539       if v-inform = ?
      540         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      541         or entry( 3, v-inform, ",":U ) <> "1":U
      542       then do:
      543         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      544       end.
      545       else do:
      546         assign
      547           v-idx-field-qnty = num-entries( v-inform ) - 4
      548         .
      549         if v-idx-field-qnty < 2 then do:
      550           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      551         end.
      552         do v-ind = 1 to v-idx-field-qnty by 2
      553         on error undo, return error
      554         :
      555           assign
      556             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      557             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      558           .
      559         end.
      560       end.
      561       if p-key-rec = ? then do:
      562         assign
      563           p-key-rec = "":U
      564         .
      565         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      566       end.
      567     end.
      568     return.
      569   end procedure.
      570   procedure gen-where-keyr-tab :
      571     define input  parameter i-tableSerach as character no-undo.
      572     define input  parameter i-tablekey   as character  no-undo.
      573     define input  parameter p-key-rec    as character  no-undo.
      574     define input  parameter p-key-handle as handle     no-undo .
      575     define input  parameter p-db-name    as character  no-undo .
      576     define input  parameter p-tt-handle  as handle     no-undo .
      577     define output parameter o-Where      as character  no-undo.
      578     do
      579     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      580     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      581     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      582     :
      583       define variable v-full-tbl-name  as character no-undo .
      584       define variable bh_tbl-name      as handle    no-undo .
      585       define variable fh_key           as handle    no-undo .
      586       define variable fh_search        as handle    no-undo .
      587       define variable v-field-num      as integer   no-undo .
      588       define variable v-count-fld      as integer   no-undo .
      589       define variable v-inform         as character no-undo .
      590       define variable v-ind            as integer   no-undo .
      591       define variable v-idx-field-qnty as integer   no-undo .
      592       define variable v-field-name     as character no-undo .
      593       define variable v-field-val      as character no-undo .
      594       define variable v-word-link      as character no-undo .
      595       define variable vTable           as character no-undo.
      596       define variable bh_tbl-key       as handle    no-undo .
      597       assign
      598         p-key-rec = trim( p-key-rec )
      599       .
      600       if p-key-handle <> ? then do:
      601         if not valid-handle(p-key-handle)
      602            or p-key-handle:type <> "buffer"
      603         then do:
      604           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      605         end.
      606         if num-entries( p-key-rec, chr(3) ) > 1
      607           or p-key-rec = ?
      608           or p-key-rec = "":U
      609         then do:
      610           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      611         end.
      612       end.
      613       else do:
      614         if p-key-rec = ?
      615           or p-key-rec = "":U
      616         then do:
      617           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      618         end.
      619       end.
      620       assign
      621         vTable = entry( 1 , p-key-rec, chr(3) )
      622       .
      623       if p-tt-handle <> ?
      624         and ( not valid-handle(p-tt-handle)
      625               or p-tt-handle:type <> "buffer"
      626             )
      627       then do:
      628         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      629       end.
      630       if p-tt-handle = ? then do:
      631         assign
      632           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      633         .
      634         create buffer bh_tbl-name for table v-full-tbl-name .
      635       end.
      636       else do:
      637         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      638       end.
      639       assign
      640         v-inform = bh_tbl-name:index-information(1)
      641         v-ind    = 2
      642       .
      643       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      644       on error undo, return error
      645       :
      646         assign
      647           v-inform = bh_tbl-name:index-information( v-ind )
      648           v-ind    = v-ind + 1
      649         .
      650       end.
      651       if v-inform = ?
      652         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      653         or entry( 3, v-inform, ",":U ) <> "1":U
      654       then do:
      655         delete object bh_tbl-name no-error.
      656         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      657       end.
      658       assign
      659         v-idx-field-qnty = num-entries( v-inform ) - 4
      660       .
      661       if v-idx-field-qnty < 2 then do:
      662         delete object bh_tbl-name no-error.
      663         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      664       end.
      665       assign
      666         o-where     = "where":U
      667         v-word-link = "":U
      668         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      669         v-count-fld = 0
      670       .
      671       if i-tablekey ne "" and i-tablekey ne ?
      672       then do:
      673         assign
      674           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      675         .
      676         create buffer bh_tbl-key for table v-full-tbl-name .
      677       end.
      678       if i-tableSerach ne "" and i-tableSerach ne ?
      679       then do:
      680         delete object bh_tbl-name no-error.
      681         assign
      682           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      683         .
      684         create buffer bh_tbl-name for table v-full-tbl-name .
      685       end.
      686       block_where:
      687       do v-ind = 1 to v-idx-field-qnty by 2
      688       on error undo, return error
      689       :
      690         assign
      691           v-count-fld = v-count-fld + 1
      692         .
      693         if p-key-handle = ?
      694           and v-count-fld > v-field-num
      695         then do:
      696           leave block_where.
      697         end.
      698         define variable VfieldKeyTable as handle no-undo.
      699         assign
      700           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      701           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      702         .
      703         if     bh_tbl-key ne ?
      704         then do:
      705            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      706            if VfieldKeyTable eq ?
      707            then next block_where.
      708         end.
      709         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      710         then
      711            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      712         else
      713            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      714         if p-key-handle = ? then do:
      715           assign
      716             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      717           .
      718         end.
      719         else do:
      720           assign
      721             fh_key = p-key-handle:buffer-field( v-field-name )
      722           .
      723           if fh_key = ?
      724             or not valid-handle( fh_key )
      725           then do:
      726             delete object bh_tbl-name.
      727             if     bh_tbl-key ne ?
      728             then
      729                delete object bh_tbl-key.
      730             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      731           end.
      732           assign
      733             v-field-val = fh_key:buffer-value
      734           .
      735         end.
      736         if fh_search:data-type ="character":U then do:
      737           assign
      738             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      739             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      740             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      741             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      742             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      743             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      744             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      745             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      746             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      747             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      748             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      749             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      750             v-field-val = substitute( '"&1"', v-field-val )
      751           .
      752         end.
      753         assign
      754           o-where = substitute( "&1 &2", o-where, v-field-val )
      755         .
      756         if v-word-link = "":U then do:
      757           assign
      758             v-word-link = "and":U
      759           .
      760         end.
      761       end.
      762       delete object bh_tbl-name.
      763       if     bh_tbl-key ne ?
      764       then
      765          delete object bh_tbl-key.
      766       if p-key-handle = ?
      767         and v-count-fld <> v-field-num
      768       then do:
      769         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      770       end.
      771     end.
      772   end procedure.
      773   procedure gen-hn-keyr-tab :
      774     define input  parameter i-tableSerach as character no-undo.
      775     define input  parameter i-tablekey   as character no-undo.
      776     define input  parameter p-key-rec    as character no-undo.
      777     define input  parameter p-key-handle as handle    no-undo .
      778     define input  parameter p-db-name    as character no-undo .
      779     define input  parameter p-tt-handle  as handle    no-undo .
      780     define input  parameter p-stts-lock  as integer   no-undo .
      781     define output parameter o-hn         as handle    no-undo.
      782     define variable v-full-tbl-name as character no-undo.
      783     define variable v-where         as character no-undo.
      784     define variable bh_tbl-name     as handle    no-undo.
      785     define variable vTable          as character no-undo.
      786     do
      787     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      788     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      789     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      790         run gen-where-keyr-tab(i-tableSerach,
      791                                i-tablekey,
      792                                p-key-rec,
      793                                p-key-handle,
      794                                p-db-name,
      795                                p-tt-handle,
      796                                output v-where).
      797         if i-tableSerach ne "" and i-tableSerach ne ?
      798         then do:
      799            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      800            create buffer bh_tbl-name for table v-full-tbl-name .
      801         end.
      802         else do:
      803            if p-tt-handle = ? then do:
      804               assign
      805                  vTable = entry( 1 , p-key-rec, chr(3) )
      806               .
      807               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      808               create buffer bh_tbl-name for table v-full-tbl-name .
      809            end.
      810            else do:
      811               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      812            end.
      813         end.
      814         if p-tt-handle = ? then do:
      815            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      816         end.
      817         else do:
      818            bh_tbl-name:find-first( v-where ) no-error .
      819         end.
      820         o-hn = bh_tbl-name.
      821      end.
      822   end procedure.
      823   procedure gen-hn-keyr :
      824     define input  parameter p-key-rec    as character no-undo.
      825     define input  parameter p-key-handle as handle    no-undo .
      826     define input  parameter p-db-name    as character no-undo .
      827     define input  parameter p-tt-handle  as handle    no-undo .
      828     define input  parameter p-stts-lock  as integer   no-undo .
      829     define output parameter o-hn         as handle    no-undo.
      830     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      831   end.
      832   procedure gen-row-keyr :
      833     define input  parameter p-key-rec    as character no-undo.
      834     define input  parameter p-key-handle as handle    no-undo .
      835     define input  parameter p-db-name    as character no-undo .
      836     define input  parameter p-tt-handle  as handle    no-undo .
      837     define input  parameter p-stts-lock  as integer   no-undo .
      838     define output parameter p-tbl-row    as rowid     no-undo.
      839     define output parameter p-tbl-name   as character no-undo.
      840     define variable vHn as handle no-undo.
      841       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      842       p-tbl-row = if vHn:available then vHn:rowid else ?.
      843       p-tbl-name =  vHn:table.
      844       delete object vHn no-error.
      845     if p-tbl-row = ? then do:
      846       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      847     end.
      848     else do:
      849       return.
      850     end.
      851   end procedure.
      852   procedure gen-key-fv :
      853     define input  parameter p-key-rec    as character no-undo .
      854     define output parameter p-field-list as character no-undo .
      855     define output parameter p-value-list as character no-undo.
      856     do
      857     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      858     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      859     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      860     :
      861       define variable v-full-tbl-name  as character no-undo .
      862       define variable bh_tbl-name      as handle    no-undo .
      863       define variable v-tbl-name       as character no-undo .
      864       define variable v-field-num      as integer   no-undo .
      865       define variable v-count-fld      as integer   no-undo .
      866       define variable v-inform         as character no-undo .
      867       define variable v-ind            as integer   no-undo .
      868       define variable v-idx-field-qnty as integer   no-undo .
      869       define variable v-delim-key      as character no-undo .
      870       if p-key-rec = ?
      871         or p-key-rec = "":U
      872       then do:
      873         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      874       end.
      875       assign
      876         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      877         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      878       .
      879       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      880       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      881       assign
      882         v-inform = bh_tbl-name:index-information(1)
      883         v-ind    = 2
      884       .
      885       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      886       on error undo, return error
      887       :
      888         assign
      889           v-inform = bh_tbl-name:index-information( v-ind )
      890           v-ind    = v-ind + 1
      891         .
      892       end.
      893       if v-inform = ?
      894         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      895         or entry( 3, v-inform, ",":U ) <> "1":U
      896       then do:
      897         delete object bh_tbl-name no-error.
      898         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      899       end.
      900       assign
      901         v-idx-field-qnty = num-entries( v-inform ) - 4
      902       .
      903       if v-idx-field-qnty < 2 then do:
      904         delete object bh_tbl-name no-error.
      905         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      906       end.
      907       assign
      908         p-field-list = "":U
      909         p-value-list = "":U
      910         v-delim-key  = "":U
      911         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      912         v-count-fld  = 0
      913       .
      914       block_where:
      915       do v-ind = 1 to v-idx-field-qnty by 2
      916       on error undo, return error
      917       :
      918         assign
      919           v-count-fld = v-count-fld + 1
      920         .
      921         if v-count-fld > v-field-num then do:
      922           leave block_where.
      923         end.
      924         assign
      925           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      926           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      927         .
      928         if v-ind = 1 then do:
      929           assign
      930             v-delim-key = chr(3)
      931           .
      932         end.
      933       end.
      934       delete object bh_tbl-name.
      935       if v-count-fld <> v-field-num then do:
      936         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      937       end.
      938     end.
      939   end procedure.
      940   procedure gen-key-field :
      941     define input  parameter p-table      as character no-undo .
      942     define output parameter p-field-list as character no-undo .
      943     do
      944     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      945     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      946     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      947     :
      948       define variable v-full-tbl-name  as character no-undo .
      949       define variable bh_tbl-name      as handle    no-undo .
      950       define variable v-tbl-name       as character no-undo .
      951       define variable v-field-num      as integer   no-undo .
      952       define variable v-count-fld      as integer   no-undo .
      953       define variable v-inform         as character no-undo .
      954       define variable v-ind            as integer   no-undo .
      955       define variable v-idx-field-qnty as integer   no-undo .
      956       define variable v-delim-key      as character no-undo .
      957       if p-table = ?
      958         or p-table = "":U
      959       then do:
      960         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      961       end.
      962       assign
      963         v-tbl-name      = p-table
      964         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      965       .
      966       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      967       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      968       assign
      969         v-inform = bh_tbl-name:index-information(1)
      970         v-ind    = 2
      971       .
      972       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      973       on error undo, return error
      974       :
      975         assign
      976           v-inform = bh_tbl-name:index-information( v-ind )
      977           v-ind    = v-ind + 1
      978         .
      979       end.
      980       if v-inform = ?
      981         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      982         or entry( 3, v-inform, ",":U ) <> "1":U
      983       then do:
      984         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      985       end.
      986       assign
      987         v-idx-field-qnty = num-entries( v-inform ) - 4
      988       .
      989       if v-idx-field-qnty < 2 then do:
      990         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      991       end.
      992       assign
      993         p-field-list = "":U
      994         v-delim-key  = "":U
      995         v-count-fld  = 0
      996       .
      997       block_where:
      998       do v-ind = 1 to v-idx-field-qnty by 2
      999       on error undo, return error
     1000       :
     1001         assign
     1002           v-count-fld = v-count-fld + 1
     1003         .
     1004         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1005         if v-ind = 1 then do:
     1006           assign
     1007             v-delim-key = chr(3)
     1008           .
     1009         end.
     1010       end.
     1011       delete object bh_tbl-name.
     1012     end.
     1013   end procedure.
     1014   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1015   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   FUNCTION get-region RETURNS CHARACTER
     1018     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1019     define variable par-region as character no-undo.
     1020     if parhost-code = 0 and
     1021          parobj-type = "":U and
     1022          parobj-code = 0 then do:
     1023          par-region = "Глобально".
     1024          return par-region.
     1025       end.
     1026       if parobj-type = 'орг':U then do:
     1027          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1028          return par-region.
     1029       end.
     1030       if parobj-type = 'регион':U
     1031       then do:
     1032          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1033          return par-region.
     1034       end.
     1035       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1036       return par-region.
     1037   END FUNCTION.
     1038   FUNCTION get-objregion RETURNS CHARACTER
     1039     (  input parobj-type as character, input parobj-code as integer ) :
     1040     define variable par-region as character no-undo.
     1041     if  parobj-type = "":U and
     1042         parobj-code = 0
     1043     then do:
     1044        par-region = "Глобально".
     1045     end.
     1046     else if parobj-type = 'орг':U
     1047     then do:
     1048        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1049     end.
     1050     else if parobj-type = 'регион':U
     1051     then do:
     1052        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1053     end.
     1054     else
     1055        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1056     return par-region.
     1057   END FUNCTION.
     1058   FUNCTION calldscr returns character ( input p-call-id as character):
     1059   define variable v-descr as character no-undo .
     1060   define variable v-field-list as character no-undo .
     1061   define variable v-value-list as character no-undo.
     1062   define variable v-prop-label as character no-undo .
     1063   define variable v-node-label as character no-undo .
     1064   define variable v-dt-code as integer no-undo .
     1065   define variable v-host-code as integer no-undo .
     1066   define variable v-obj-type as character no-undo .
     1067   define variable v-obj-code as integer no-undo .
     1068   define variable v-label as character no-undo .
     1069   define variable v-node-code as integer no-undo .
     1070   define buffer buf_prop-head for ub.prop-head.
     1071   define buffer buf_prop-ref for ub.prop-ref.
     1072   define buffer buf_prop-map for ub.prop-map.
     1073   run gen-key-fv in this-procedure ( input p-call-id
     1074                                     ,output v-field-list
     1075                                     ,output v-value-list) no-error .
     1076   if error-status:error then return p-call-id.
     1077   CASE entry(1, p-call-id, chr(3)):
     1078     when 'dis-card-type':U then do:
     1079       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1080                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1081                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1082                            ).
     1083     end.
     1084     when 'dis-card':U then do:
     1085       v-descr = substitute("ДК: № &1"
     1086                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1087                            ).
     1088     end.
     1089     when 'dis-card-property':U then do:
     1090       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1091       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1092       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1093       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1094       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1095       find first buf_prop-ref no-lock where
     1096                 buf_prop-ref.dt-code = v-dt-code no-error .
     1097       if available buf_prop-ref then do:
     1098         find first buf_prop-head no-lock where
     1099                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1100         v-prop-label = buf_prop-head.prop-label.
     1101         find first buf_prop-map no-lock where
     1102                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1103               and buf_prop-map.node-code = v-node-code no-error .
     1104         if available buf_prop-map then do:
     1105           v-label = buf_prop-map.node-label.
     1106         end.
     1107       end.
     1108       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1109                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1110                            ,v-prop-label
     1111                            ,v-label
     1112                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1113                            ).
     1114     end.
     1115     when 'clients':U then do:
     1116       v-descr = substitute("&1&2"
     1117                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1118                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1119                            ).
     1120     end.
     1121     when 'ext-system':U then do:
     1122       v-descr = substitute("Внешняя система &1"
     1123                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1124                            ).
     1125     end.
     1126     WHEN 'thbj-attr':U then do:
     1127       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1128       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1129       then do:
     1130         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1131           v-descr = "Операции с товарами".
     1132         end.
     1133         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1134           v-descr = "Операции с клиентами".
     1135         end.
     1136         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1137           v-descr = "Операции с группами товаров".
     1138         end.
     1139         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1140           v-descr = "Операции с группами клиентов".
     1141         end.
     1142         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1143           v-descr = "Операции с чеками на POS IBS-TH".
     1144         end.
     1145         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1146           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1147         end.
     1148         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1149           v-descr = "Операции в системе электронного документооборота".
     1150         end.
     1151         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1152           v-descr = "Операции со справочниками".
     1153         end.
     1154         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1155           v-descr = "Операции с ДНЦ и переоценками".
     1156         end.
     1157         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1158           v-descr = "Отчеты".
     1159         end.
     1160         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1161           v-descr = "Операции с заказами".
     1162         end.
     1163       end.
     1164     end.
     1165     when 'cash-desk':U then do:
     1166       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1167                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1168                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1169                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1170                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1171                            ).
     1172     end.
     1173     when 'ext-file':U then do:
     1174       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1175                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1176                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1177                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1178                            ).
     1179     end.
     1180   end case.
     1181   return v-descr.
     1182   end function.
     1183   define variable dops0 as character no-undo format "X(8)".
     1184   define variable dops as character no-undo format "X(250)".
     1185   define variable dopst as character no-undo format "X(1)".
     1186   define variable dopsp as character no-undo format "X(10)".
     1187   define variable v-is-dc as character no-undo .
     1188   define variable v-conf-type as character no-undo .
     1189   define variable v-run as logical no-undo .
     1190   DEFINE BUTTON b-exit AUTO-GO
     1191        LABEL "&Ввод"
     1192        SIZE 10 BY 1
     1193        BGCOLOR 8 .
     1194   DEFINE BUTTON B-file
     1195        IMAGE-UP FILE "btn-down-arrow":U
     1196        IMAGE-DOWN FILE "btn-down-arrow":U
     1197        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1198        LABEL ""
     1199        SIZE 3 BY 1.
     1200   DEFINE BUTTON B-help
     1201        LABEL "Помо&щь"
     1202        SIZE 3 BY 1
     1203        BGCOLOR 8 .
     1204   DEFINE BUTTON b-param
     1205        LABEL "&Параметры"
     1206        SIZE 10 BY 1.
     1207   DEFINE BUTTON B-profile
     1208        IMAGE-UP FILE "btn-down-arrow":U
     1209        IMAGE-DOWN FILE "btn-down-arrow":U
     1210        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1211        LABEL ""
     1212        SIZE 3 BY 1.
     1213   DEFINE BUTTON B-quit AUTO-END-KEY
     1214        LABEL "&Отмена"
     1215        SIZE 10 BY 1
     1216        BGCOLOR 8 .
     1217   DEFINE BUTTON B-type
     1218        IMAGE-UP FILE "btn-down-arrow":U
     1219        IMAGE-DOWN FILE "btn-down-arrow":U
     1220        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1221        LABEL ""
     1222        SIZE 3 BY 1.
     1223   DEFINE VARIABLE emitent-name AS CHARACTER FORMAT "X(256)":U
     1224         VIEW-AS TEXT
     1225        SIZE 42 BY .67 NO-UNDO.
     1226   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
     1227        LABEL "Файл импорта"
     1228        VIEW-AS FILL-IN
     1229        SIZE 78.5 BY 1 NO-UNDO.
     1230   DEFINE VARIABLE T-tocd AS LOGICAL INITIAL no
     1231        LABEL "Отправить на кассу по окончании импорта"
     1232        VIEW-AS TOGGLE-BOX
     1233        SIZE 46.5 BY 1 NO-UNDO.
     1234   DEFINE QUERY Dialog-Frame FOR
     1235         X_rule-profile,
     1236         X_dis-card-type SCROLLING.
     1237   DEFINE FRAME Dialog-Frame
     1238        b-exit AT ROW 1 COL 1
     1239        B-quit AT ROW 1 COL 11
     1240        B-help AT ROW 1 COL 95
     1241        X_rule-profile.name AT ROW 2 COL 14 COLON-ALIGNED WIDGET-ID 10
     1242             LABEL "Профайл"
     1243             VIEW-AS FILL-IN
     1244             SIZE 79 BY 1
     1245        B-profile AT ROW 2 COL 95 WIDGET-ID 12
     1246        X_rule.name AT ROW 3 COL 16 NO-LABEL WIDGET-ID 18
     1247             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1248             SIZE 79.5 BY 2
     1249        B-type AT ROW 5 COL 24
     1250        b-param AT ROW 5 COL 88 WIDGET-ID 14
     1251        file-name AT ROW 6 COL 2
     1252        B-file AT ROW 6 COL 95
     1253        T-tocd AT ROW 7 COL 5
     1254        X_dis-card-type.type AT ROW 5 COL 7 COLON-ALIGNED
     1255             LABEL "Тип ДК"
     1256              VIEW-AS TEXT
     1257             SIZE 14.8 BY .67
     1258        X_dis-card-type.emitent-host-code AT ROW 5 COL 34 COLON-ALIGNED
     1259             LABEL "Эмитент"
     1260              VIEW-AS TEXT
     1261             SIZE 6 BY .67
     1262        emitent-name AT ROW 5 COL 41 COLON-ALIGNED NO-LABEL
     1263        "Правило:" VIEW-AS TEXT
     1264             SIZE 8.5 BY 1 AT ROW 3 COL 7 WIDGET-ID 20
     1265        SPACE(84.29) SKIP(19.12)
     1266       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1267            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1268            TITLE "Импорт данных по ДК"
     1269            DEFAULT-BUTTON b-exit CANCEL-BUTTON B-quit.
     1270   ASSIGN
     1271          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1272          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1273   ASSIGN
     1274          X_rule.name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1275   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1276   DO:
     1277     APPLY "END-ERROR":U TO SELF.
     1278   END.
     1279   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1280   DO:
     1281     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1282     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1283     v-run = yes.
     1284   END.
     1285   ON CHOOSE OF B-file IN FRAME Dialog-Frame
     1286   DO:
     1287   define variable v_os-file   AS CHAR NO-UNDO INIT "".
     1288   define variable ll_commit AS LOG    NO-UNDO INIT NO.
     1289   define variable v-full-path        as character no-undo .
     1290   define variable v-path             as character no-undo .
     1291   define variable v-file-name        as character no-undo .
     1292   define variable v-file-name-no-ext as character no-undo .
     1293   define variable v-file-name-ext    as character no-undo .
     1294       SYSTEM-DIALOG GET-FILE v_os-file
     1295           TITLE "Выберите файл для импорта"
     1296           FILTERS
     1297             " Все текстовые файлы (*.txt) " "*.txt",
     1298             " Все файлы (*.*) "                      "*.*"
     1299           INITIAL-FILTER 1
     1300           DEFAULT-EXTENSION ".txt"
     1301           USE-FILENAME
     1302           MUST-EXIST
     1303           UPDATE ll_commit
     1304           .
     1305       IF ll_commit <> YES THEN do:
     1306          RETURN NO-APPLY.
     1307       end.
     1308       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
     1309           BELL.
     1310           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1311           RETURN NO-APPLY.
     1312       END.
     1313       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
     1314       run gbl/filename.p (
     1315                       input  v_os-file
     1316                       ,output v-full-path
     1317                       ,output v-path
     1318                       ,output v-file-name
     1319                       ,output v-file-name-no-ext
     1320                       ,output v-file-name-ext
     1321                       ) no-error .
     1322       if error-status:error  = ? then do:
     1323         return no-apply.
     1324       end.
     1325       assign
     1326       file-name = v-full-path.
     1327       DISP file-name WITH FRAME Dialog-Frame.
     1328   END.
     1329   ON CHOOSE OF b-param IN FRAME Dialog-Frame
     1330   DO:
     1331       RUN proc-b-param IN THIS-PROCEDURE NO-ERROR.
     1332       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1333   END.
     1334   ON CHOOSE OF B-profile IN FRAME Dialog-Frame
     1335   DO:
     1336   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1337   IF AVAILABLE X_rule-by-profile THEN DO:
     1338      ASSIGN
     1339      v-rid-list = STRING(RECID(X_rule-by-profile)).
     1340   END.
     1341    run rul/rule-by-profile-s.w ( INPUT parparentproc
     1342                                 ,INPUT "b-sel":u
     1343                                 ,INPUT "ruleset"
     1344                                 ,INPUT 0
     1345                                 ,INPUT 4
     1346                                 ,INPUT 1
     1347                                 ,INPUT 0
     1348                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1349   if v-rid-list = '':U then RETURN NO-APPLY.
     1350   find first X_rule-by-profile no-lock where
     1351             recid(X_rule-by-profile) = integer(v-rid-list).
     1352   FIND FIRST X_rule-profile NO-LOCK WHERE
     1353           X_rule-profile.profile_id = X_rule-by-profile.profile_id.
     1354   FIND FIRST X_rule NO-LOCK WHERE
     1355           X_rule.rule_id = X_rule-by-profile.rule_id.
     1356   DISPLAY
     1357   X_rule-profile.NAME
     1358   X_rule.NAME
     1359   WITH FRAME Dialog-Frame.
     1360   ENABLE
     1361   b-type
     1362   b-param
     1363   WITH FRAME Dialog-Frame.
     1364   END.
     1365   ON CHOOSE OF B-type IN FRAME Dialog-Frame
     1366   DO:
     1367    run proc-b-type in this-procedure no-error.
     1368    if error-status:error then return no-apply.
     1369   END.
     1370   ON LEAVE OF file-name IN FRAME Dialog-Frame
     1371   DO:
     1372       ASSIGN file-name.
     1373       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
     1374           ASSIGN FILE-INFO:FILE-NAME = file-name.
     1375           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
     1376           DISP file-name WITH FRAME Dialog-Frame.
     1377       END.
     1378       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
     1379   END.
     1380   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1381   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1382   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1383   on help of frame Dialog-Frame
     1384   do:
     1385     run gbl/app_help.p
     1386       (input this-procedure :file-name
     1387       ,input ''
     1388       ,input ?
     1389       ) no-error.
     1390     if error-status :error then do:
     1391       message
     1392         "Ошибка при вызове помощи"
     1393         error-status :get-message(1)
     1394         view-as alert-box .
     1395     end.
     1396   end.
     1397   run minbtn-set in this-procedure .
     1398   on choose of b-help in frame Dialog-Frame
     1399   do:
     1400     apply "help":u to frame Dialog-Frame .
     1401   end.
     1402   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1403   procedure minbtn-set :
     1404       do
     1405           on error undo, return error return-value
     1406           :
     1407           define variable ii              as integer       no-undo .
     1408           define variable fh              as widget-handle no-undo .
     1409           define variable hh              as widget-handle no-undo .
     1410           define variable v-h             as handle        extent 4 no-undo .
     1411           define variable v-name-button   as character     no-undo .
     1412           define variable v-help-old-x    as decimal       no-undo .
     1413           define variable v-help-old-y    as decimal       no-undo .
     1414           define variable v-help-old-size as decimal       no-undo .
     1415           define variable v-frame-width   as decimal       no-undo .
     1416           define variable jj              as integer       no-undo .
     1417           do
     1418               on error undo, return error
     1419               :
     1420               assign
     1421                   v-frame-width = frame Dialog-Frame:width - 0.3
     1422                   fh            = frame Dialog-Frame:first-child
     1423                   hh            = fh:first-child
     1424                   ii            = 1
     1425                   .
     1426               do while valid-handle(hh):
     1427                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1428                   do:
     1429                       case lc(hh:name) :
     1430                           when "b-help" then
     1431                               do:
     1432                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1433                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1434                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1435                                   hh:TOOLTIP = "Помощь" .
     1436                                   v-help-old-x = hh:column .
     1437                                   v-help-old-y = hh:row    .
     1438                                   v-help-old-size = hh:width .
     1439                                   hh:width-chars = 2.5 .
     1440                               end.
     1441                           when "b-print" then
     1442                               do:
     1443                                   hh:load-image("cmp/b-print.bmp":u) .
     1444                                   hh:TOOLTIP = "Печать" .
     1445                                   v-h[ii] = hh:handle .
     1446                                   ii = ii + 1 .
     1447                                   hh:width-chars = 3 .
     1448                               end.
     1449                           when "b-history" or
     1450                           when "b-hist" then
     1451                               do:
     1452                                   hh:load-image("cmp/b-hist.bmp":u) .
     1453                                   hh:TOOLTIP = "История" .
     1454                                   v-h[ii] = hh:handle .
     1455                                   ii = ii + 1 .
     1456                                   hh:width-chars = 3 .
     1457                               end.
     1458                           when "b-sch" then
     1459                               do:
     1460                                   hh:load-image("cmp/b-sch.bmp":u) .
     1461                                   hh:TOOLTIP = "Установка Фильтра" .
     1462                                   v-h[ii] = hh:handle .
     1463                                   ii = ii + 1 .
     1464                                   hh:width-chars = 3 .
     1465                               end.
     1466                           when "b-hist-user" then
     1467                               do:
     1468                                   hh:load-image("cmp/b-hist.bmp":u) .
     1469                                   hh:TOOLTIP = "История пользователя" .
     1470                                   ii = ii + 1 .
     1471                               end.
     1472                       end case.
     1473                   end.
     1474                   hh = hh:next-sibling.
     1475               end.
     1476               b-help:column = v-frame-width - b-help:width-chars.
     1477               jj = 0.
     1478               repeat ii = 4 to 1 by -1 :
     1479                   if valid-handle (v-h[ii] ) then
     1480                   do:
     1481                       jj  = jj + 1 .
     1482                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1483                       v-h[ii]:row    = v-help-old-y .
     1484                   end.
     1485               end.
     1486           end.
     1487       end.
     1488   end procedure.
     1489   MAIN-BLOCK:
     1490   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1491      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1492   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1493     run mainmenu_getcntxt in parparentproc
     1494       (output v-cntxt-db-num
     1495       ,output v-cntxt-userid
     1496       ,output v-cntxt-level
     1497       ,output v-cntxt-host-code-obj
     1498       ,output v-cntxt-obj-type
     1499       ,output v-cntxt-obj-code
     1500       ,output v-cntxt-db-num-obj
     1501       ,output v-cntxt-is-admin
     1502       ) .
     1503     if NOT v-cntxt-db-num = 0 then do:
     1504         message "Импорт клиентов и их дисконтных карт возможен только в ГБД"
     1505         view-as alert-box ERROR.
     1506       undo main-block, return error .
     1507     end.
     1508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1509     (input  'is-dc'
     1510     ,input  0
     1511     ,input  '':U
     1512     ,input  0
     1513     ,input  '':U
     1514     ,input  '':U
     1515     ,input  '':U
     1516     ,input  NO
     1517     ,output v-is-dc
     1518     ,output v-conf-type
     1519     ) NO-ERROR .
     1520     IF ERROR-STATUS:ERROR OR
     1521       v-conf-type <> 'L':U THEN
     1522       v-is-dc = "no".
     1523     if logical(v-is-dc) = no then do:
     1524       message
     1525       "В Вашей системе недоступна функциональность работы с дисконтными картами"
     1526       view-as alert-box WARNING.
     1527       undo main-block, return error .
     1528     end.
     1529     run Myenable in this-procedure .
     1530     WAIT-FOR GO OF FRAME Dialog-Frame.
     1531   END.
     1532   run disable_UI in this-procedure .
     1533   if v-run then do:
     1534     run str/saledc.p
     1535       (
     1536         input parparentproc
     1537       ,input this-procedure :handle
     1538       ,input p-log-handle
     1539       ,input 'text-import':U
     1540       ,input X_dis-card-type.emitent-host-code
     1541       ,input X_dis-card-type.type
     1542       ,input X_rule-by-profile.profile_id
     1543       ,input 0
     1544       ,input 0
     1545       ,input v-cntxt-db-num
     1546       ,input ( string(next-value(s-v-doc, ub)) + chr(4) +
     1547                     file-name
     1548               )
     1549       ,input ?
     1550       ,input ?
     1551       ,input ?
     1552       ,input 1
     1553       ,input 1
     1554       ,input yes
     1555       ) no-error .
     1556     if error-status:error then do:
     1557       undo, return error return-value .
     1558     end.
     1559     if can-find(first dc-list NO-LOCK)
     1560     and t-tocd
     1561     then do:
     1562       run str/diallog.w (
     1563                           input parparentproc
     1564                           ,input this-procedure
     1565                           ,input 'sendclia.p':U
     1566                           ,input (string(v-cntxt-db-num) + chr(4) +  chr(4) + "no":U + chr(4) + "O":U)
     1567                           ,input yes
     1568                           ,input '':U
     1569                           ,input 'Отправка информации по клиентским картам на кассу') no-error .
     1570     end.
     1571   end.
     1572   PROCEDURE disable_UI :
     1573     HIDE FRAME Dialog-Frame.
     1574   END PROCEDURE.
     1575   PROCEDURE enable_UI :
     1576     OPEN QUERY Dialog-Frame FOR EACH X_rule-profile SHARE-LOCK,       EACH X_dis-card-type WHERE TRUE  SHARE-LOCK.
     1577     GET FIRST Dialog-Frame.
     1578     DISPLAY file-name T-tocd emitent-name
     1579         WITH FRAME Dialog-Frame.
     1580     IF AVAILABLE X_dis-card-type THEN
     1581       DISPLAY X_dis-card-type.type X_dis-card-type.emitent-host-code
     1582         WITH FRAME Dialog-Frame.
     1583     IF AVAILABLE X_rule THEN
     1584       DISPLAY X_rule.name
     1585         WITH FRAME Dialog-Frame.
     1586     IF AVAILABLE X_rule-profile THEN
     1587       DISPLAY X_rule-profile.name
     1588         WITH FRAME Dialog-Frame.
     1589     ENABLE b-exit B-quit B-help X_rule-profile.name B-profile X_rule.name B-type
     1590            b-param file-name B-file T-tocd X_dis-card-type.type
     1591            X_dis-card-type.emitent-host-code emitent-name
     1592         WITH FRAME Dialog-Frame.
     1593     VIEW FRAME Dialog-Frame.
     1594   END PROCEDURE.
     1595   PROCEDURE MyEnable :
     1596   DISPLAY
     1597   file-name
     1598   T-tocd
     1599   emitent-name
     1600   WITH FRAME Dialog-Frame .
     1601   ENABLE
     1602   b-exit
     1603   B-quit
     1604   B-help
     1605   file-name
     1606   B-file
     1607   T-tocd
     1608   b-profile
     1609   WITH FRAME Dialog-Frame .
     1610   VIEW FRAME Dialog-Frame .
     1611   END PROCEDURE.
     1612   PROCEDURE proc-b-param :
     1613   if not available X_rule-by-profile then do:
     1614     message
     1615     "Сначала необходимо определить тип ДК, для которой вызывается импорт"
     1616     view-as alert-box error .
     1617     return error.
     1618   end.
     1619   define variable v-param-form as character no-undo .
     1620   define variable v-list-mode as character no-undo .
     1621   define buffer buf_rule-profile for ub.rule-profile.
     1622   find first buf_rule-profile no-lock where
     1623             buf_rule-profile.profile_id = X_rule-by-profile.profile_id.
     1624   assign
     1625   v-param-form = (if buf_rule-profile.custom-param-form > 0
     1626                   then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     1627                   else "ref/rulercps.w")
     1628   v-list-mode = (if buf_rule-profile.custom-param-form > 0
     1629                  then 'rp-rule-param':U
     1630                  else 'rule-call-param':U)
     1631   .
     1632   run value(v-param-form) (
     1633                        input parparentproc
     1634                       ,input this-procedure:handle
     1635                       ,input "b-chg":U
     1636                       ,input 'ИЗМЕНЕНИЕ':U
     1637                       ,input v-list-mode
     1638                       ,input buf_rule-profile.profile_id
     1639                       ,input X_rp-by-call.once-more
     1640                       ,input X_rp-by-call.call_id
     1641                       ,input X_rule-by-profile.codex_id
     1642                       ,input X_rule-by-profile.ruleset_id
     1643                       ,input ?
     1644                       ,input X_rule-by-profile.RULE_id
     1645                       ,INput substitute("Правило &1 &2"
     1646                                         , X_rule-by-profile.RULE_id, calldscr(X_rp-by-call.call_id))
     1647                       ,input-output table tt0-rule-call-param  ) no-error.
     1648   END PROCEDURE.
     1649   PROCEDURE proc-b-type :
     1650   define variable v-rid-list as character no-undo.
     1651   DEFINE VARIABLE v-today as date no-undo .
     1652   DEFINE VARIABLE v-time as integer no-undo .
     1653   define buffer buf_clients for ub.clients.
     1654   DEFINE BUFFER buf_rp-by-call FOR ub.rp-by-call.
     1655   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     1656   define buffer buf_rule for ub.rule.
     1657   define buffer buf_ruledict for ub.ruledict.
     1658   define buffer buf_rule-call-param for ub.rule-call-param.
     1659   define buffer buf_ruledict-param for ub.ruledict-param.
     1660   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1661   IF NOT AVAILABLE X_rule-by-profile THEN DO:
     1662     MESSAGE
     1663     "Сначала необходимо определить правило импорта"
     1664     VIEW-AS ALERT-BOX.
     1665     disable b-param
     1666     with frame Dialog-Frame .
     1667     RETURN ERROR.
     1668   END.
     1669   IF AVAILABLE X_rp-by-call THEN DO:
     1670      ASSIGN
     1671      v-rid-list = STRING(RECID(X_rp-by-call)).
     1672   END.
     1673   run rul/rp-by-call-s.w ( INPUT parparentproc
     1674                           ,INPUT "b-sel":U
     1675                           ,INPUT "profile-id"
     1676                           ,INPUT X_rule-by-profile.profile_id
     1677                           ,INPUT '':U
     1678                           ,input ''
     1679                           ,input 0
     1680                           ,input 0
     1681                           ,INPUT-OUTPUT v-rid-list
     1682                           ) NO-ERROR.
     1683   if v-rid-list = "" then return error.
     1684   find first buf_rp-by-call no-lock where
     1685             recid(buf_rp-by-call) = integer(v-rid-list) no-error.
     1686   if not available buf_rp-by-call then do:
     1687     message
     1688     substitute("Не найдена привязка правила rp-by-call с recid &1" , v-rid-list)
     1689     view-as alert-box error .
     1690     return.
     1691   end.
     1692   FIND FIRST X_rp-by-call WHERE RECID(X_rp-by-call) = RECID(buf_rp-by-call).
     1693   FIND FIRST X_dis-card-type WHERE
     1694           X_dis-card-type.uniq-key-rec = buf_rp-by-call.call_id.
     1695   display
     1696   X_dis-card-type.type
     1697   X_dis-card-type.emitent-host-code
     1698   with frame Dialog-Frame.
     1699   FOR EACH buf_tt0-rule-call-param:
     1700      DELETE buf_tt0-rule-call-param.
     1701   END.
     1702   if X_rule-by-profile.profile_id = 1
     1703   and not can-find(first buf_Rule-call-param no-lock where
     1704             buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     1705        and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     1706        and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     1707        and  buf_rule-call-param.rule_id = X_rule-by-profile.rule_id)
     1708   then do:
     1709     find first buf_rule no-lock where
     1710               buf_rule.rule_id = X_rule-by-profile.rule_id.
     1711     find first buf_ruledict where
     1712               buf_ruledict.entry-type = 'rule':U
     1713           and buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec.
     1714     for each buf_ruledict-param no-lock where
     1715           buf_ruledict-param.entry-id = buf_ruledict.entry-id:
     1716       create buf_tt0-rule-call-param.
     1717       assign
     1718       buf_tt0-rule-call-param.codex_id              = X_rule-by-profile.codex_id
     1719       buf_tt0-rule-call-param.ruleset_id            = X_rule-by-profile.ruleset_id
     1720       buf_tt0-rule-call-param.call_id               = X_rp-by-call.call_id
     1721       buf_tt0-rule-call-param.call#_id              = X_rp-by-call.call#_id
     1722       buf_tt0-rule-call-param.order_id              = 0
     1723       buf_tt0-rule-call-param.rule_id               = buf_rule.rule_id
     1724       buf_tt0-rule-call-param.param-name            = buf_ruledict-param.param-name
     1725       buf_tt0-rule-call-param.p-index               = 0
     1726       buf_tt0-rule-call-param.param-des             = buf_ruledict-param.documentation
     1727       buf_tt0-rule-call-param.param-num             = buf_ruledict-param.param-num
     1728       buf_tt0-rule-call-param.param-label           = buf_ruledict-param.param-label
     1729       buf_tt0-rule-call-param.param-mode            = buf_ruledict-param.param-mode
     1730       buf_tt0-rule-call-param.param-data-type       = buf_ruledict-param.param-data-type
     1731       buf_tt0-rule-call-param.param-2-data-type       = buf_ruledict-param.param-2-data-type
     1732       buf_tt0-rule-call-param.param-3-data-type       = buf_ruledict-param.param-3-data-type
     1733       buf_tt0-rule-call-param.param-value-character = buf_ruledict-param.init-value-character
     1734       buf_tt0-rule-call-param.param-value-date      = buf_ruledict-param.init-value-date
     1735       buf_tt0-rule-call-param.param-value-decimal   = buf_ruledict-param.init-value-decimal
     1736       buf_tt0-rule-call-param.param-value-integer   = buf_ruledict-param.init-value-integer
     1737       buf_tt0-rule-call-param.param-value-logical   = buf_ruledict-param.init-value-logical
     1738       buf_tt0-rule-call-param.once-more             = 1
     1739       buf_tt0-rule-call-param.profile_id   = 1
     1740       .
     1741       if buf_ruledict-param.param-name = "p-dis-tot-obj-code" then do:
     1742         assign
     1743         buf_tt0-rule-call-param.param-value-integer = 0.
     1744       end.
     1745       if buf_ruledict-param.param-name = "p-issue-code" then do:
     1746         assign
     1747         buf_tt0-rule-call-param.param-value-integer = 0.
     1748       end.
     1749       if buf_ruledict-param.param-name = "p-issue-date" then do:
     1750         run cur-time in this-procedure ( output v-today, output v-time).
     1751         assign
     1752         buf_tt0-rule-call-param.param-value-date = v-today.
     1753       end.
     1754       if buf_ruledict-param.param-name = "p-valid-date" then do:
     1755         assign
     1756         buf_tt0-rule-call-param.param-value-date = ?.
     1757       end.
     1758       if buf_ruledict-param.param-name = "p-cli-grp-code" then do:
     1759         assign
     1760         buf_tt0-rule-call-param.param-value-integer = 0.
     1761       end.
     1762       if buf_ruledict-param.param-name = "p-lim-cr" then do:
     1763         assign
     1764         buf_tt0-rule-call-param.param-value-decimal = 0.0.
     1765       end.
     1766       if buf_ruledict-param.param-name = "p-category" then do:
     1767         assign
     1768         buf_tt0-rule-call-param.param-value-integer = 0.
     1769       end.
     1770     end.
     1771   end.
     1772   else do:
     1773     find X_rule-by-call where
     1774         X_rule-by-call.call#_id = X_rp-by-call.call#_id
     1775       and X_rule-by-call.rule_id = X_rule-by-profile.rule_id
     1776       and X_rule-by-call.profile_id = X_rule-by-profile.profile_id no-error .
     1777     if ambiguous X_rule-by-call then do:
     1778       message
     1779       "Выберите какой вызов правила Вас необходим"
     1780       view-as alert-box .
     1781       run rul/rule-by-call-s.w ( input parparentproc
     1782                                 ,input "b-sel"
     1783                                 ,input "call_id"
     1784                                 ,input X_rp-by-call.call_id
     1785                                 ,input X_rule-by-profile.codex_id
     1786                                 ,input X_rule-by-profile.ruleset_id
     1787                                 ,input X_rule-by-profile.rule_id
     1788                                 ,input-output v-rid-list) no-error .
     1789       if v-rid-list = '':u then do:
     1790         UNDO, RETURN ERROR.
     1791       end.
     1792       find first X_rule-by-call no-lock where
     1793                 recid(X_rule-by-call) = integer(v-rid-list) no-error .
     1794       if not available X_rule-by-call then do:
     1795         UNDO, RETURN ERROR.
     1796       end.
     1797     end.
     1798     for each buf_Rule-call-param no-lock where
     1799             buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     1800        and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     1801        and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     1802        and  buf_rule-call-param.rule_id = X_rule-by-profile.rule_id
     1803        and  buf_rule-call-param.profile_id = X_rule-by-profile.profile_id
     1804        and  buf_rule-call-param.once-more = X_rp-by-call.once-more
     1805        :
     1806       create buf_tt0-rule-call-param.
     1807       buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     1808     end.
     1809   end.
     1810   RUN proc-b-param IN THIS-PROCEDURE NO-ERROR.
     1811   END PROCEDURE.
     1812   PROCEDURE proc-save :
     1813   define variable v-full-path        as character no-undo .
     1814   define variable v-path             as character no-undo .
     1815   define variable v-file-name        as character no-undo .
     1816   define variable v-file-name-no-ext as character no-undo .
     1817   define variable v-file-name-ext    as character no-undo .
     1818   if not available X_dis-card-type then do:
     1819     message
     1820     "Вы не выбрали тип ДК"
     1821     view-as alert-box error .
     1822     undo, return error .
     1823   end.
     1824   ASSIGN FRAME Dialog-Frame
     1825   file-name
     1826   t-tocd
     1827   .
     1828   if file-name = '':u
     1829   or file-name = ?
     1830   then do:
     1831     message
     1832     "Не выбран файл для импорта"
     1833     view-as alert-box error .
     1834     undo, return error .
     1835   end.
     1836   run gbl/filename.p (
     1837                    input  file-name
     1838                   ,output v-full-path
     1839                   ,output v-path
     1840                   ,output v-file-name
     1841                   ,output v-file-name-no-ext
     1842                   ,output v-file-name-ext
     1843                   ) no-error .
     1844   if error-status:error then do:
     1845     message
     1846     "Не найден файл, выбранный в качестве файла для импорта"
     1847     view-as alert-box error .
     1848     undo, return error .
     1849   end.
     1850   FOR EACH dc-list:
     1851     DELETE dc-list.
     1852   END.
     1853   run rul/ruprcall.p ( input 'dis-card-type':U
     1854                       ,input X_dis-card-type.uniq-key-rec
     1855                       ,input 'rule-call-param':U
     1856                       ,input ?
     1857                       ,input 0
     1858                       ,INPUT TABLE tt0-rp-by-call
     1859                       ,INPUT TABLE tt0-rule-by-call
     1860                       ,INPUT TABLE tt0-rule-call-param) no-error .
     1861   if error-status:error then do:
     1862     message
     1863     "Ошибка при сохранении параметров правила импорта" skip
     1864     error-status:get-message(1) skip
     1865     return-value
     1866     view-as alert-box error .
     1867     undo, return error .
     1868   end.
     1869   END PROCEDURE.
