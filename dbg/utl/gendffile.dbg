        1   using ibs.th.adm.upd.*.
        2   define variable vss-revision    as character no-undo init "$Revision: $":U .
        3   define variable vss-author      as character no-undo init "$Author: $":U .
        4   define variable vss-date        as character no-undo init "$Date: $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: $":U .
        7   define variable vss-description as character no-undo init "Процедура просмотра объектов зарегистрированых в ObjSRV".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      112   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      113   define variable analisDfObj as class analisdf no-undo.
      114   analisDfObj = new analisdf ().
      115   DEFINE BUTTON bCreate
      116        LABEL "Создать"
      117        SIZE 15 BY 1.14.
      118   DEFINE BUTTON bExit
      119        LABEL "Выход"
      120        SIZE 15 BY 1.14.
      121   DEFINE BUTTON bHelpAttr
      122        IMAGE-UP FILE "cmp/b-help.bmp":U
      123        IMAGE-DOWN FILE "cmp/b-help.bmp":U
      124        IMAGE-INSENSITIVE FILE "cmp/b-help.bmp":U
      125        LABEL ""
      126        SIZE 3.8 BY 1.
      127   DEFINE BUTTON bHelpHead
      128        IMAGE-UP FILE "cmp/b-help.bmp":U
      129        IMAGE-DOWN FILE "cmp/b-help.bmp":U
      130        IMAGE-INSENSITIVE FILE "cmp/b-help.bmp":U
      131        LABEL ""
      132        SIZE 3.8 BY 1.
      133   DEFINE BUTTON bHelpHist
      134        IMAGE-UP FILE "cmp/b-help.bmp":U
      135        IMAGE-DOWN FILE "cmp/b-help.bmp":U
      136        IMAGE-INSENSITIVE FILE "cmp/b-help.bmp":U
      137        LABEL ""
      138        SIZE 3.8 BY 1.
      139   DEFINE VARIABLE fAttrTables AS CHARACTER FORMAT "X(256)":U
      140        LABEL "Список таблиц"
      141        VIEW-AS FILL-IN
      142        SIZE 87 BY 1 TOOLTIP "Список таблиц через ~",~", по которым генерировать таблицы атибутов" NO-UNDO.
      143   DEFINE VARIABLE fHeadSequence AS CHARACTER FORMAT "X(20)":U
      144        LABEL "Head-последовательность"
      145        VIEW-AS FILL-IN
      146        SIZE 27 BY 1 TOOLTIP "Имя последовательности для головной таблицы" NO-UNDO.
      147   DEFINE VARIABLE fHeadTable AS CHARACTER FORMAT "X(20)":U
      148        LABEL "Head-таблица"
      149        VIEW-AS FILL-IN
      150        SIZE 40 BY 1 TOOLTIP "Имя головной таблицы" NO-UNDO.
      151   DEFINE VARIABLE fTableForHead AS CHARACTER FORMAT "X(20)":U
      152        LABEL "из таблицы"
      153        VIEW-AS FILL-IN
      154        SIZE 30 BY 1 TOOLTIP "по какой таблице генерируется головная таблица" NO-UNDO.
      155   DEFINE VARIABLE fTables AS CHARACTER FORMAT "X(256)":U
      156        LABEL "Список таблиц"
      157        VIEW-AS FILL-IN
      158        SIZE 87 BY 1 TOOLTIP "Список таблиц через ~",~", по которым генерировать таблицы истории" NO-UNDO.
      159   DEFINE VARIABLE fTriggerAttr AS CHARACTER FORMAT "X(20)":U
      160        LABEL "Триггер-файлы"
      161        VIEW-AS FILL-IN
      162        SIZE 87 BY 1 TOOLTIP "Имя триггер-файлов для таблиц атрибутов" NO-UNDO.
      163   DEFINE VARIABLE fTriggerAttrHist AS CHARACTER FORMAT "X(20)":U
      164        LABEL "Триггеры истории"
      165        VIEW-AS FILL-IN
      166        SIZE 87 BY 1 TOOLTIP "Имя триггер-файлов для таблиц истории по атрибутам" NO-UNDO.
      167   DEFINE VARIABLE fTriggerFile AS CHARACTER FORMAT "X(7)":U
      168        LABEL "Триггер-файл"
      169        VIEW-AS FILL-IN
      170        SIZE 27 BY 1 TOOLTIP "Имя триггер-файла для головной таблицы" NO-UNDO.
      171   DEFINE VARIABLE fTriggerHist AS CHARACTER FORMAT "X(20)":U
      172        LABEL "Триггер-файлы"
      173        VIEW-AS FILL-IN
      174        SIZE 87 BY 1 TOOLTIP "Имя триггер-файлов для таблицы истории" NO-UNDO.
      175   DEFINE VARIABLE textAttr AS CHARACTER FORMAT "X(50)":U INITIAL "Таблицы атрибутов"
      176         VIEW-AS TEXT
      177        SIZE 19 BY .62 NO-UNDO.
      178   DEFINE VARIABLE textHeadHist AS CHARACTER FORMAT "X(50)":U INITIAL "Для головной таблицы истории"
      179         VIEW-AS TEXT
      180        SIZE 28.8 BY .62 NO-UNDO.
      181   DEFINE VARIABLE textHistory AS CHARACTER FORMAT "X(50)":U INITIAL " Основные таблицы истории"
      182         VIEW-AS TEXT
      183        SIZE 26 BY .95 NO-UNDO.
      184   DEFINE RECTANGLE fAttrTriggers
      185        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      186        SIZE 109 BY 6.86.
      187   DEFINE RECTANGLE RECT-1
      188        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      189        SIZE 109 BY 4.05.
      190   DEFINE RECTANGLE RECT-2
      191        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      192        SIZE 109 BY 5.24.
      193   DEFINE VARIABLE fCrHistAttr AS LOGICAL INITIAL no
      194        LABEL "создать таблицы истории по атрибутам"
      195        VIEW-AS TOGGLE-BOX
      196        SIZE 48 BY .81 NO-UNDO.
      197   DEFINE FRAME Dialog-Frame
      198        bExit AT ROW 1.48 COL 6 WIDGET-ID 14
      199        bCreate AT ROW 1.48 COL 27 WIDGET-ID 16
      200        bHelpHead AT ROW 2.71 COL 35 WIDGET-ID 42
      201        fTableForHead AT ROW 4.1 COL 66.2 WIDGET-ID 6
      202        fHeadTable AT ROW 4.14 COL 9 WIDGET-ID 4
      203        fHeadSequence AT ROW 5.57 COL 9 WIDGET-ID 8
      204        fTriggerFile AT ROW 7 COL 22 WIDGET-ID 10
      205        bHelpHist AT ROW 8.71 COL 31 WIDGET-ID 44
      206        fTables AT ROW 10.19 COL 6.6 WIDGET-ID 2
      207        fTriggerHist AT ROW 11.52 COL 6.6 WIDGET-ID 32
      208        bHelpAttr AT ROW 13.67 COL 25 WIDGET-ID 46
      209        fAttrTables AT ROW 15.05 COL 6.6 WIDGET-ID 30
      210        fTriggerAttr AT ROW 16.48 COL 6.6 WIDGET-ID 34
      211        fCrHistAttr AT ROW 17.91 COL 23 WIDGET-ID 48
      212        fTriggerAttrHist AT ROW 19.1 COL 3.2 WIDGET-ID 52
      213        textHeadHist AT ROW 2.91 COL 4.2 COLON-ALIGNED NO-LABEL WIDGET-ID 40
      214        textHistory AT ROW 8.71 COL 3.4 COLON-ALIGNED NO-LABEL WIDGET-ID 38
      215        textAttr AT ROW 13.86 COL 4.2 COLON-ALIGNED NO-LABEL WIDGET-ID 36
      216        RECT-1 AT ROW 9.19 COL 3 WIDGET-ID 18
      217        RECT-2 AT ROW 3.19 COL 3 WIDGET-ID 20
      218        fAttrTriggers AT ROW 14.14 COL 3 WIDGET-ID 26
      219        SPACE(0.99) SKIP(0.47)
      220       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      221            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      222            TITLE "Генерация df-файла таблиц истории" WIDGET-ID 100.
      223   ASSIGN
      224          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      225          FRAME Dialog-Frame:HIDDEN           = TRUE.
      226   ASSIGN
      227          fTriggerAttrHist:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      228   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      229   DO:
      230     APPLY "END-ERROR":U TO SELF.
      231   END.
      232   ON CHOOSE OF bCreate IN FRAME Dialog-Frame
      233   DO:
      234   define variable vFileErr as character no-undo.
      235   define variable vMsg     as character no-undo.
      236   vFileErr              = substitute("&1&2.err",session:temp-directory,"history").
      237   analisDfObj:fileDF    = substitute("&1&2.df",session:temp-directory,"history").
      238   analisDfObj:noMessage = true.
      239   if search(analisDfObj:fileDF) <> ? then
      240     os-delete value(analisDfObj:fileDF).
      241     assign fTableForHead fHeadTable fHeadSequence fTriggerFile fTables fTriggerHist fAttrTables fTriggerAttr fCrHistAttr fTriggerAttrHist.
      242   do transaction:
      243     output to value(vFileErr).
      244     run genAttrTablesDF in this-procedure.
      245     if fHeadTable <> "" then
      246     do:
      247       run genHeadTableDF in this-procedure.
      248     end.
      249     run genHistTablesDF in this-procedure.
      250     catch exProErrors as class Progress.Lang.ProError :
      251       vMsg = exProErrors:GetMessage(1) + "~nСмотрите лог " + vFileErr + ".".
      252     end catch .
      253     catch exAnyErrors as class Progress.Lang.Error:
      254       vMsg = "Неизвестная ошибка~nСмотрите лог " + vFileErr + "." .
      255     end catch .
      256     finally :
      257       if vMsg <> "" then
      258         message vMsg view-as alert-box error.
      259       output close.
      260     end finally .
      261   end.
      262   if search(analisDfObj:fileDF) <> ? then
      263   do:
      264     file-info:file-name = analisDfObj:fileDF.
      265     if file-info:file-size <> 0 then do:
      266       output to value(analisDfObj:fileDF) append.
      267       put unformatted "." skip "PSC" skip "cpstream=1251" skip "." skip .
      268       output close.
      269       message "Создан DF-файл" analisDfObj:fileDF view-as alert-box.
      270     end.
      271     else do:
      272       os-delete value(analisDfObj:fileDF).
      273       message "DF-файл не создан~nСмотрите лог " + vFileErr + "." view-as alert-box error.
      274     end.
      275   end.
      276   else
      277     message "DF-файл не создан~nСмотрите лог " + vFileErr + "." view-as alert-box error.
      278   END.
      279   ON CHOOSE OF bExit IN FRAME Dialog-Frame
      280   DO:
      281     APPLY "END-ERROR":U.
      282   END.
      283   ON CHOOSE OF bHelpAttr IN FRAME Dialog-Frame
      284   DO:
      285     message
      286       "Заполняется для создания структуры таблиц атрибутов из списка." skip
      287       "~"Список таблиц~" - список таблиц через ~",~", для которых генерируется структура таблиц атрибутов" skip
      288       "~"Триггер-файлы~" - список имен файлов триггера через ~",~" для каждой таблицы из списка. ~
      289   Будут сгенерированы файлы-триггеры с соответствующим именем на WRITE и DELETE и расширением p для каждой таблицы списка. ~
      290   Для WRITE в конце имени добавится ~"w~", для DELETE - ~"d~".~
      291   Если поле не заполнено, то триггеры сгенерированы не будут для всех таблиц списка. ~
      292   Если для какой-то таблицы из списка не нужны триггеры, то эту позицию оставляем не заполненной." skip
      293     view-as alert-box.
      294   END.
      295   ON CHOOSE OF bHelpHead IN FRAME Dialog-Frame
      296   DO:
      297     message
      298       "Заполняется для создания структуры головной таблицы истории. Необязательный" skip
      299       "~"Head-таблица~" - имя головной таблицы истории" skip
      300       "~"из таблицы~" - имя таблицы, по которой создается головная таблица истории" skip
      301       "~"Head-последовательность~" - имя последовательности chip-num для головной таблицы" skip
      302       "~"Триггер-файл~" - имя файла триггера, для головной таблицы (max 7 знаков, необязательный).~
      303   Будут сгенерированы файлы-триггеры с таким именем на WRITE и DELETE и расширением p. ~
      304   Для WRITE в конце имени добавится ~"w~", для DELETE - ~"d~"." skip
      305     view-as alert-box.
      306   END.
      307   ON CHOOSE OF bHelpHist IN FRAME Dialog-Frame
      308   DO:
      309     message
      310       "Заполняется для создания структуры таблицы истории из списка." skip
      311       "~"Список таблиц~" - список таблиц через ~",~", для которых генерируется структура таблиц истории" skip
      312       "~"Триггер-файлы~" - список имен файлов триггера через ~",~" для каждой таблицы из списка. ~
      313   Будут сгенерированы файлы-триггеры с соответствующим именем на WRITE и DELETE и расширением p для каждой таблицы списка. ~
      314   Для WRITE в конце имени добавится ~"w~", для DELETE - ~"d~".~
      315   Если поле не заполнено, то триггеры сгенерированы не будут для всех таблиц списка. ~
      316   Если для какой-то таблицы из списка не нужны триггеры, то эту позицию оставляем не заполненной." skip
      317     view-as alert-box.
      318   END.
      319   ON VALUE-CHANGED OF fCrHistAttr IN FRAME Dialog-Frame
      320   DO:
      321   do with frame Dialog-Frame:
      322     assign fCrHistAttr.
      323     if fCrHistAttr then
      324       view fTriggerAttrHist.
      325     else
      326       hide fTriggerAttrHist.
      327   end.
      328   END.
      329   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      330   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      331   MAIN-BLOCK:
      332   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      333      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      334     RUN enable_UI.
      335     hide fTriggerAttrHist.
      336     WAIT-FOR GO OF FRAME Dialog-Frame.
      337   END.
      338   RUN disable_UI.
      339   PROCEDURE disable_UI :
      340     HIDE FRAME Dialog-Frame.
      341   END PROCEDURE.
      342   PROCEDURE enable_UI :
      343     DISPLAY fTableForHead fHeadTable fHeadSequence fTriggerFile fTables
      344             fTriggerHist fAttrTables fTriggerAttr fCrHistAttr fTriggerAttrHist
      345             textHeadHist textHistory textAttr
      346         WITH FRAME Dialog-Frame.
      347     ENABLE RECT-1 RECT-2 fAttrTriggers bExit bCreate bHelpHead fTableForHead
      348            fHeadTable fHeadSequence fTriggerFile bHelpHist fTables fTriggerHist
      349            bHelpAttr fAttrTables fTriggerAttr fCrHistAttr fTriggerAttrHist
      350            textHeadHist textHistory textAttr
      351         WITH FRAME Dialog-Frame.
      352     VIEW FRAME Dialog-Frame.
      353   END PROCEDURE.
      354   PROCEDURE genAttrTablesDF :
      355     define variable vCount       as integer   no-undo.
      356     define variable vTable       as character no-undo.
      357     define variable vTrigger     as character no-undo.
      358     define variable vTriggerHist as character no-undo.
      359     define buffer bFile for ub._file.
      360   do with frame Dialog-Frame:
      361     if fAttrTables <> "" and fTriggerAttr <> "" and
      362        num-entries(fAttrTables) <> num-entries(fTriggerAttr ) then
      363     do:
      364       message "Ошибка в секции ~"" trim(textAttr) "~"." skip
      365               substitute("Количество имен таблиц в поле ~"&1~" должно совпадать с количеством имен файлов в поле ~"&2~".",fAttrTables:label,fTriggerAttr :label) skip
      366               "Структуры для таблиц атрибутов не будут сгененрирована."
      367               view-as alert-box.
      368       return.
      369     end.
      370     if fAttrTables <> "" and fCrHistAttr and fTriggerAttrHist <> "" and
      371        num-entries(fAttrTables) <> num-entries(fTriggerAttrHist) then
      372     do:
      373       message "Ошибка в секции ~"" trim(textAttr) "~"." skip
      374               substitute("Количество имен таблиц в поле ~"&1~" должно совпадать с количеством имен файлов в поле ~"&2~".",
      375                          fAttrTables:label,fTriggerAttrHist:label) skip
      376               "Структуры для таблиц атрибутов не будут сгененрирована."
      377               view-as alert-box.
      378       return.
      379     end.
      380     do vCount = 1 to num-entries(fAttrTables):
      381       assign
      382         vTable       = entry(vCount,fAttrTables)
      383         vTrigger     = if fTriggerAttr <> "" then entry(vCount,fTriggerAttr) else ""
      384         vTriggerHist = if fCrHistAttr and fTriggerAttrHist <> "" then entry(vCount,fTriggerAttrHist) else ""
      385       .
      386       find first bFile where bFile._file-name = vTable no-lock no-error.
      387       if avail bFile then
      388       do:
      389         analisDfObj:crTableAttr(vTable, vTrigger, fCrHistAttr, vTriggerHist ).
      390       end.
      391       else
      392       do:
      393         message
      394           substitute("Таблица &1 не найдена в БД.~nСтруктура таблицы атрибутов для нее не сгененрирована.", vTable)
      395           view-as alert-box.
      396       end.
      397     end.
      398   end.
      399   END PROCEDURE.
      400   PROCEDURE genHeadTableDF :
      401     define buffer bFile for ub._file.
      402     if fTableForHead <> "" then
      403     do:
      404       find first bFile where bFile._file-name = fTableForHead no-lock no-error.
      405       if avail bFile then
      406       do:
      407         analisDfObj:crTableHeadHist(fTableForHead, fHeadTable, fHeadSequence, fTriggerFile) no-error.
      408         if error-status:error then do:
      409           message
      410             "Ошибка при генерации Головной таблицы истории." skip
      411             error-status:get-message(1) skip
      412             "Структура Головной таблица истории не сгенерирована."
      413             view-as alert-box.
      414         end.
      415       end.
      416       else
      417       do:
      418         message
      419           substitute("Таблица &1 не найдена в БД.~nСтруктура головной таблицы истории для нее не сгененрирована.", fTableForHead )
      420           view-as alert-box.
      421       end.
      422     end.
      423     else
      424     do:
      425       message
      426         "Ошибка в секции ~"" trim(textHeadHist) "~"." skip
      427         "Не заполнено поле ~"из таблицы~", для которой табицы должна быть создана головная таблица истории" skip
      428         "Структура Головной таблица истории не сгенерирована."
      429         view-as alert-box.
      430     end.
      431   END PROCEDURE.
      432   PROCEDURE genHistTablesDF :
      433   DO WITH FRAME Dialog-Frame:
      434     define variable vCount    as integer   no-undo.
      435     define variable vTable    as character no-undo.
      436     define variable vTrigger  as character no-undo.
      437     define buffer bFile for ub._file.
      438     if fTables <> "" and fTriggerHist <> "" and
      439        num-entries(fTables) <> num-entries(fTriggerHist) then
      440     do:
      441       message "Ошибка в секции ~"" trim(textHistory) "~"." skip
      442               substitute("Количество имен таблиц в поле ~"&1~" должно совпадать с количеством имен файлов в поле ~"&2~".",fTables:label,fTriggerHist:label) skip
      443               "Структура для таблиц истории не будут сгененрирована."
      444               view-as alert-box.
      445       return.
      446     end.
      447     do vCount = 1 to num-entries(fTables):
      448       assign
      449         vTable    = entry(vCount,fTables)
      450         vTrigger  = entry(vCount,fTriggerHist)
      451       no-error.
      452       find first bFile where bFile._file-name = vTable no-lock no-error.
      453       if avail bFile then
      454       do:
      455         analisDfObj:crTableHist(vTable, if fHeadTable <> "" then no else yes, vTrigger).
      456       end.
      457       else
      458       do:
      459         message
      460           substitute("Таблица &1 не найдена в БД.~nСтруктура таблицы истории для нее не будет сгенерирована.", vTable)
      461           view-as alert-box.
      462       end.
      463     end.
      464   END.
      465   END PROCEDURE.
