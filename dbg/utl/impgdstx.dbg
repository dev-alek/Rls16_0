        1   block-level on error undo, throw.
        2   define input parameter par-mode             as character no-undo .
        3   define input parameter p-vat-rate-code      as integer  no-undo.
        4   define input parameter p-slt-rate-code      as integer  no-undo.
        5   define input parameter par-copymode         as logical no-undo .
        6   define input parameter par-alt-bc-mode      as integer no-undo .
        7   define input parameter par-manual           as logical no-undo .
        8   define input parameter par-silence          as logical no-undo .
        9   define input parameter par-file             as logical no-undo .
       10   define input parameter par-single-record    as logical no-undo .
       11   define input parameter par-host-code        like ub.sysconf.host-code no-undo .
       12   define input parameter par-obj-type         like ub.clients.obj-type no-undo .
       13   define input parameter par-obj-code         like ub.clients.obj-code no-undo .
       14   define input parameter is-goods             as logical no-undo .
       15   define input parameter par-copy-rec         as recid no-undo.
       16   define input parameter par-gds-code         like ub.goods.gds-code no-undo .
       17   define input parameter par-artic            like ub.goods.artic no-undo .
       18   define input parameter par-prod-type        like ub.goods.prod-type no-undo .
       19   define input parameter par-prod-code        like ub.goods.prod-code no-undo .
       20   define input parameter par-node-code        like ub.gds-prt.node-code no-undo .
       21   define input parameter par-grp-code         like ub.gds-grp.node-code no-undo .
       22   define input parameter par-gds-name         like ub.goods.gds-name no-undo .
       23   define input parameter par-saved-name       like ub.goods.gds-name no-undo .
       24   define input parameter par-engl-name        like ub.goods.engl-name no-undo .
       25   define input parameter par-label-name       like ub.goods.label-name no-undo .
       26   define input parameter par-chk-name         like ub.goods.chk-name no-undo .
       27   define input parameter par-alpha1           like ub.goods.alpha1 no-undo .
       28   define input parameter par-unit-base        like ub.goods.unit-base no-undo .
       29   define input parameter par-unit-cli         like ub.goods.unit-cli no-undo .
       30   define input parameter par-max-rate         like ub.goods.max-rate no-undo .
       31   define input parameter par-min-rate         like ub.goods.min-rate no-undo .
       32   define input parameter par-cli-base-rate    like ub.goods.cli-base-rate no-undo .
       33   define input parameter par-qnty-cart        like ub.goods.qnty-cart no-undo .
       34   define input parameter par-ms-cart          like ub.goods.ms-cart no-undo .
       35   define input parameter par-wt-cart          like ub.goods.wt-cart no-undo .
       36   define input parameter par-calc-method      like ub.goods.calc-method no-undo .
       37   define input parameter par-increase-pc      like ub.goods.increase-pc no-undo .
       38   define input parameter par-NegRest          as logical no-undo .
       39   define input parameter par-obj-price-base   like ub.gds-obj.price-base no-undo .
       40   define input parameter par-obj-price-rubl   like ub.gds-obj.price-rubl no-undo .
       41   define input parameter par-okdp             like ub.goods.okdp no-undo .
       42   define input parameter par-destin           like ub.goods.destin no-undo .
       43   define input parameter par-attrib           like ub.goods.attrib  no-undo .
       44   define input parameter par-user-rule        like ub.goods.user-rule no-undo .
       45   define input parameter par-sert             like ub.goods.sert no-undo .
       46   define input parameter par-struct           like ub.goods.struct no-undo .
       47   define input parameter par-deadline         like ub.goods.deadline no-undo .
       48   define input parameter par-sort             like ub.goods.sort no-undo .
       49   define input parameter par-proof            like ub.goods.proof no-undo .
       50   define input parameter par-normal-wastage   like ub.goods.normal-wastage no-undo .
       51   define input parameter par-normal-waste     like ub.goods.normal-waste no-undo .
       52   define input parameter par-tnved            like ub.goods.tnved no-undo .
       53   define input parameter par-nationality      like ub.goods.nationality no-undo .
       54   define input parameter par-unit-cst         like ub.goods.unit-cst no-undo .
       55   define input parameter par-cst-base-rate    like ub.goods.cst-base-rate no-undo .
       56   define input parameter par-PS               like ub.goods.ps no-undo .
       57   define input parameter par-unq-artc         as logical no-undo .
       58   define input parameter par-is-jwlr          as logical no-undo .
       59   define input parameter par-is-bttl          as logical no-undo .
       60   define input parameter par-is-ptrl          as logical no-undo .
       61   define input parameter par-custvalue        as character no-undo .
       62   define input parameter par-dif-nam1         as logical no-undo .
       63   define input parameter par-dif-nam2         as logical no-undo .
       64   define input parameter par-ArtDis           as logical no-undo .
       65   define input parameter par-BarDis           as integer no-undo .
       66   define input-output parameter par-rec       as recid no-undo .
       67   define output parameter par-nbc             like ub.bar-code.b-code no-undo .
       68   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       69   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       70   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       71   define variable vss-workfile    as character no-undo init "$Workfile: impgdstx.p $":U .
       72   define variable vss-archive     as character no-undo init "$Archive: utl/impgdstx.p $":U .
       73   define variable vss-description as character no-undo init "Создание или изменение карточки товара.".
       74   procedure vss-get-info :
       75     define output parameter p-vss-revision    like vss-revision    no-undo .
       76     define output parameter p-vss-author      like vss-author      no-undo .
       77     define output parameter p-vss-date        like vss-date        no-undo .
       78     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       79     define output parameter p-vss-archive     like vss-archive     no-undo .
       80     define output parameter p-vss-description like vss-description no-undo .
       81     assign
       82       p-vss-revision    = vss-revision
       83       p-vss-author      = vss-author
       84       p-vss-date        = vss-date
       85       p-vss-workfile    = vss-workfile
       86       p-vss-archive     = vss-archive
       87       p-vss-description = vss-description
       88     .
       89   end procedure.
       90   procedure vss-get-parameters :
       91     define output parameter p-vss-parameters as character no-undo .
       92   end procedure.
       93   define new global shared variable g#vssrevis-logger as handle    no-undo .
       94   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       95   define variable v-vssrevis-logger                   as handle    no-undo .
       96   procedure vss-logevent :
       97     define input  parameter p-extra-paramters as character no-undo .
       98     define variable v-vssrevis-parameters as character no-undo .
       99     do
      100     on error undo, return error return-value
      101     :
      102       if  valid-handle(v-vssrevis-logger)
      103       and v-vssrevis-logger :get-signature("logevent") <> ""
      104       then do:
      105         run vss-get-parameters in this-procedure
      106           (output v-vssrevis-parameters
      107           ).
      108         run logevent in v-vssrevis-logger
      109           (input vss-workfile
      110           ,input vss-revision
      111           ,input v-vssrevis-parameters
      112           ,input p-extra-paramters
      113           ).
      114       end.
      115     end.
      116   end procedure.
      117   assign
      118     v-vssrevis-logger = g#vssrevis-logger
      119   .
      120   if  valid-handle(v-vssrevis-logger)
      121   and v-vssrevis-logger :get-signature("logevent") <> ""
      122   then do:
      123     assign
      124       v-vssrevis-logevent = true
      125     .
      126     run vss-logevent in this-procedure (input vss-description) .
      127   end.
      128   define new global shared variable g#language as character no-undo .
      129   if g#language <> '' and g#language <> 'rus':U then do:
      130     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      131   end.
      132     define new shared temp-table  tt-tax no-undo
      133   field tax-code    like ub.tax.tax-code
      134   FIELD individual  like ub.tax.individual
      135   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      136   field rate-code   like ub.tax-rate.rate-code
      137   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      138   FIELD tax-type    like ub.tax.tax-type
      139   field rate-value  like ub.tax-rate-value.rate-value
      140   FIELD tax-rate-gds-rc  as recid
      141   FIELD to-cashdesk like ub.tax.to-cashdesk
      142   FIELD fact-date like ub.tax-rate-value.fact-date
      143   FIELD fact-order like ub.tax-rate-value.fact-order
      144   FIELD next-order like ub.tax-rate-value.fact-order
      145   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      146   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      147   FIELD corr-date like ub.tax-rate-gds.corr-date
      148   FIELD corr-time like ub.tax-rate-gds.corr-time
      149   index tax-code is unique primary tax-code fact-order descending rate-code.
      150   define new shared buffer goods for ub.goods.
      151   do
      152   on error undo, return error
      153   :
      154               if par-mode = 'ДОБАВЛЕНИЕ':U
      155               then do:
      156                   run ref/dtaxgdss.p (
      157                         input no
      158                       , input par-unit-base
      159                       , input par-node-code
      160                       , input ?
      161                       , input ?
      162                       , input par-host-code
      163                       , input par-obj-type
      164                       , input par-obj-code
      165                   ).
      166                   find first tt-tax
      167                        where tt-tax.tax-code = integer( '1':U )
      168                   no-error.
      169                   if available tt-tax
      170                   then do:
      171                       assign
      172                           tt-tax.rate-code = p-vat-rate-code
      173                       .
      174                   end.
      175                   find first tt-tax
      176                        where tt-tax.tax-code = integer( '2':U )
      177                   no-error.
      178                   if available tt-tax
      179                   then do:
      180                       assign
      181                           tt-tax.rate-code = p-slt-rate-code
      182                       .
      183                   end.
      184               end.
      185               else do:
      186                   for each tt-tax:
      187                       delete tt-tax.
      188                   end.
      189               end.
      190               run ref/goods01.p (
      191                     input ?
      192                   , input par-mode
      193                   , input par-copymode
      194                   , input par-alt-bc-mode
      195                   , input par-manual
      196                   , input par-silence
      197                   , input yes
      198                   , input par-file
      199                   , input par-single-record
      200                   , input par-host-code
      201                   , input par-obj-type
      202                   , input par-obj-code
      203                   , input is-goods
      204                   , input par-copy-rec
      205                   , input par-gds-code
      206                   , input par-artic
      207                   , input par-prod-type
      208                   , input par-prod-code
      209                   , input par-node-code
      210                   , input par-grp-code
      211                   , input par-gds-name
      212                   , input par-saved-name
      213                   , input par-engl-name
      214                   , input par-label-name
      215                   , input par-chk-name
      216                   , input par-alpha1
      217                   , input par-unit-base
      218                   , input par-unit-cli
      219                   , input par-max-rate
      220                   , input par-min-rate
      221                   , input par-cli-base-rate
      222                   , input par-qnty-cart
      223                   , input 0
      224                   , input 0
      225                   , input par-ms-cart
      226                   , input par-wt-cart
      227                   , input par-calc-method
      228                   , input par-increase-pc
      229                   , input par-NegRest
      230                   , input par-obj-price-base
      231                   , input par-obj-price-rubl
      232                   , input par-okdp
      233                   , input par-destin
      234                   , input par-attrib
      235                   , input par-user-rule
      236                   , input par-sert
      237                   , input par-struct
      238                   , input par-deadline
      239                   , input 0
      240                   , input par-sort
      241                   , input par-proof
      242                   , input par-normal-wastage
      243                   , input par-normal-waste
      244                   , input par-tnved
      245                   , input par-nationality
      246                   , input par-unit-cst
      247                   , input par-cst-base-rate
      248                   , input ?
      249                   , input par-PS
      250                   , input par-unq-artc
      251                   , input par-is-jwlr
      252                   , input par-is-bttl
      253                   , input par-is-ptrl
      254                   , input par-custvalue
      255                   , input par-dif-nam1
      256                   , input par-dif-nam2
      257                   , input par-ArtDis
      258                   , input par-BarDis
      259                   , input-output par-rec
      260                   , output par-nbc
      261               ) no-error .
      262               if error-status :error
      263               then do:
      264                   message
      265                            vss-workfile vss-revision vss-description
      266                       skip "Ошибка создания или изменения карточки товара."
      267                       skip return-value
      268                       skip par-artic
      269                       skip trim(error-status :get-message(1))
      270                            trim(error-status :get-message(2))
      271                            trim(error-status :get-message(3))
      272                   view-as alert-box error.
      273                   undo, return error .
      274               end.
      275   end.
