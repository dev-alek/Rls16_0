        1   block-level on error undo, throw.
        2   define input  parameter p-old-grp as integer   no-undo .
        3   define input  parameter p-new-grp as integer   no-undo .
        4   define input  parameter p-id     as integer   no-undo .
        5   define input  parameter p-db-num as integer   no-undo .
        6   define output parameter p-ok      as logical  no-undo init yes.
        7   define variable vss-revision    as character no-undo init "$Revision: 02c26e32e5c9, 891, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        9   define variable vss-date        as character no-undo init "$Date: Thu Dec 01 17:04:29 2016 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: uassmgrp.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: utl/uassmgrp.p $":U .
       12   define variable vss-description as character no-undo init "Пересчет По группам товара + Ассортиментная матрица".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable v-waitfram-action01         as character   no-undo .
       73   define variable v-waitfram-action02         as character   no-undo .
       74   define variable v-waitfram-action03         as character   no-undo .
       75   define variable mWaitFramTextBeg            as character   no-undo.
       76   define variable mWaitFramTextEnd            as character   no-undo.
       77   define variable mWaitFramView               as logical     no-undo.
       78   define variable mWaitProcEvent              as logical     no-undo init yes.
       79   define variable mWaitFramInterval           as integer     no-undo init 1 .
       80   define variable mWaitFramStop               as logical     no-undo.
       81   define variable mWaitFramStopUser           as logical     no-undo.
       82   define variable mWaitFramStopTimeOut        as logical     no-undo.
       83   define variable mWaitFramStartProc          as datetime-tz no-undo.
       84   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       85   define button B-WaitFramStop auto-end-key
       86        label "Стоп"
       87        size 10 by 1 tooltip "Остоновить процесс".
       88   define button B-viewProcInfo
       89        label "Информация"
       90        size 15 by 1 tooltip "Информация о процесс".
       91   define frame waitfram
       92     v-waitfram-action01 format "x(72)" no-label skip
       93     v-waitfram-action02 format "x(72)" no-label skip
       94     v-waitfram-action03 format "x(72)" no-label skip
       95     B-viewProcInfo
       96     B-WaitFramStop at row 4 col 30
       97     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       98     .
       99   define new global shared variable mBatchMode as logical no-undo init ?.
      100   define variable mFramBachModHandle as handle no-undo.
      101   mFramBachModHandle = frame waitfram:handle.
      102   define variable mFameOldVis as logical no-undo.
      103   define variable mVisCUrentVin as logical no-undo.
      104   if session:batch-mode
      105   then
      106      mBatchMode = yes.
      107   if mBatchMode = ? then do:
      108     mVisCUrentVin = current-window:visible.
      109     mFameOldVis = mFramBachModHandle:visible.
      110     mFramBachModHandle:visible  = yes.
      111     mBatchMode = mFramBachModHandle:visible ne yes.
      112     mFramBachModHandle:visible = mFameOldVis.
      113     current-window:visible = mVisCUrentVin.
      114   end.
      115    if  log-manager:logfile-name ne ?
      116     then DO:
      117         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      118         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      119         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      120     end.
      121   on choose of B-WaitFramStop in frame waitfram
      122   do:
      123     mWaitFramStop = yes.
      124     mWaitFramStopUser = yes.
      125   end.
      126   function waitfram-check-timeout returns logical():
      127      define variable vtime as int64 no-undo.
      128      if mWaitFramStopTimeOut
      129      then
      130         return yes.
      131      vtime = ( now - mWaitFramStartProc ) / 1000 .
      132      if     mWaitFramTimeOut ne ?
      133         and mWaitFramTimeOut ne 0
      134         and mWaitFramTimeOut lt vtime
      135      then do:
      136         mWaitFramStopTimeOut = yes.
      137      end.
      138      return mWaitFramStopTimeOut.
      139   end.
      140   procedure waitfram-hide :
      141     if not session:batch-mode
      142     then do
      143     on error undo, return error return-value
      144     :
      145       pause 0 before-hide .
      146       if not mBatchMode then
      147         hide frame waitfram .
      148     if     not mWaitFramView
      149        and mWaitProcEvent
      150     then
      151       process events .
      152     end.
      153   end procedure.
      154   procedure waitfram-show :
      155     define input  parameter p-message as character no-undo .
      156     define variable v-left-margin as integer   no-undo .
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       if length(p-message) <= 70 then do:
      162         assign
      163           v-left-margin = integer((70 - length(p-message)) / 2)
      164         .
      165         assign
      166           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      167         .
      168         assign
      169           v-waitfram-action01 = " "
      170           v-waitfram-action02 = " "
      171                                    + fill(" ", v-left-margin)
      172                                    + p-message
      173           v-waitfram-action03 = " "
      174         .
      175       end.
      176       else do:
      177         define variable vRindex1 as integer no-undo.
      178         define variable vRindex2 as integer no-undo.
      179         vRindex1 = r-index(p-message," ",70).
      180         if vRindex1 = 0
      181         then
      182            vRindex1 = 70.
      183         if length(p-message)  <= vRindex1 + 70 then do:
      184           assign
      185             v-waitfram-action01 = " "
      186             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      188           .
      189         end.
      190         else do:
      191           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      192           if vRindex2 <= vRindex1
      193           then
      194              vRindex2 = vRindex1 + 70.
      195           assign
      196             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      199           .
      200         end.
      201       end.
      202       B-viewProcInfo:visible   in frame waitfram = no.
      203       B-viewProcInfo:sensitive in frame waitfram = no.
      204       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       if  (   mWaitFramView
      207          or  mWaitProcEvent)
      208          and not mBatchMode
      209       then
      210          display
      211             v-waitfram-action01 skip
      212             v-waitfram-action02 skip
      213             v-waitfram-action03 skip
      214          with frame waitfram .
      215       if     mWaitFramView
      216          then do:
      217             if     mWaitFramInterval ne ?
      218                and not mBatchMode
      219             then
      220                wait-for go of frame waitfram pause mWaitFramInterval.
      221          end.
      222          else
      223             if     mWaitProcEvent
      224                and not mBatchMode
      225             then
      226                process events .
      227     end.
      228   end procedure.
      229      procedure waitfram-show-this:
      230         define input  parameter iInterval as int64 no-undo.
      231         define variable vtime as int64 no-undo.
      232         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      233         mWaitFramInterval = iInterval.
      234         run waitfram-show (substitute("&1&2 &3&4" ,
      235                                       mWaitFramTextBeg ,
      236                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      237                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      238                                       mWaitFramTextEnd
      239                                      )
      240                           ).
      241      end.
      242      procedure WaitFramRunPause:
      243         define input  parameter iInterval as dec no-undo.
      244         define variable vStart  as datetime-tz no-undo.
      245         define variable vend    as datetime-tz no-undo.
      246         define variable vint as int64 no-undo.
      247         define variable vOk as logical no-undo.
      248         vStart = now.
      249         vend   = vStart.
      250         publish "WaitFramPause" (iInterval,output vOk).
      251         vend   =  now.
      252         vint = vend - vStart.
      253         vint = iInterval - vint / 1000.
      254         if     not mWaitFramStop
      255            and (   vint > 0
      256                 or (    not vOk
      257                     and iInterval eq ?
      258                     )
      259                 )
      260         then
      261            run waitfram-show-this (iInterval).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and vint > 0
      267         then do:
      268            run gbl/pause.p (vint * 1000).
      269         end.
      270         if iInterval ne ?
      271         then
      272            publish "WaitFramStop".
      273         waitfram-check-timeout().
      274      end.
      275      procedure WaitFramWaitFor:
      276         define input  parameter iInterval as dec no-undo.
      277         assign
      278            mWaitFramStartProc   = now
      279            mWaitFramStopUser    = no
      280            mWaitFramStopTimeOut = no
      281         .
      282         block-wait:
      283         do while not mWaitFramStop:
      284            run WaitFramRunPause (iInterval).
      285            if  waitfram-check-timeout()
      286            then do:
      287               leave block-wait.
      288            end.
      289         end.
      290         run waitfram-hide.
      291      end.
      292   procedure waitfram-join :
      293     define input  parameter p-line-1  as character no-undo .
      294     define input  parameter p-line-2  as character no-undo .
      295     define input  parameter p-line-3  as character no-undo .
      296     define output parameter p-message as character no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       assign
      301         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      304       .
      305     end.
      306   end procedure.
      307   function waitfram-join-function returns character
      308     (input p-line-1 as character
      309     ,input p-line-2 as character
      310     ,input p-line-3 as character
      311     ).
      312     define variable v-message as character no-undo .
      313     run waitfram-join in this-procedure
      314       (input  p-line-1
      315       ,input  p-line-2
      316       ,input  p-line-3
      317       ,output v-message
      318       ) .
      319     return v-message .
      320   end function .
      321   define variable vss-include-info1 as character format "X(65)" no-undo
      322   initial "@(#)$Workfile$ $Revision$".
      323   define temp-table temp_grplib_grp no-undo
      324       field sel           as character
      325       field nabor         as character
      326       field full-name     as character
      327       field print-code    as character
      328       field sort-name     as character
      329       field node-code     as integer
      330       field upper-code    as integer
      331       field calc-method   as character
      332       field round-method  as character
      333       field increase-pc   as decimal
      334       field min-marg      as character
      335       field max-marg      as character
      336       field cli-type      as character
      337       field cli-code      as integer
      338       field notcorr      as character
      339       field name          as character
      340       field level         as integer
      341       field mark          as character
      342       index pi is primary unique sort-name
      343       index fn full-name
      344       index nc is unique node-code
      345       index sl sel
      346       index uc upper-code
      347   .
      348   define temp-table temp_grplib_found-grp no-undo
      349       field full-name   as character
      350       field sort-name   as character
      351       field node-code   as integer
      352       field level       as integer
      353       field is-terminal as logical
      354       index pi is primary unique sort-name
      355       index fn full-name
      356       index lv level
      357       index it is-terminal
      358   .
      359   define temp-table temp_found-result-nodelist no-undo
      360       field node-code     as recid
      361       field processed     as logical
      362       field sort-name     as character
      363       field full-name     as character
      364       index pi is primary unique node-code
      365       index ps processed
      366   .
      367   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      368   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      369   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      370   procedure grplib-get-parameters :
      371   define input parameter p-store-type     as character        no-undo.
      372   define input parameter p-store-code     as integer          no-undo.
      373   do
      374   on error undo, return error
      375   :
      376       assign
      377           v-grplib-not-fill-extra-info = no
      378       .
      379   end.
      380   end procedure.
      381   procedure grplib-get-sort-name :
      382   do
      383   on error undo, return error
      384   :
      385   define input parameter p-node-code  as integer      no-undo.
      386   define output parameter p-sort-name as character    no-undo.
      387       define variable v-upper-code    as integer           no-undo.
      388       define buffer buf_gds-grp       for ub.gds-grp.
      389       define buffer buf_upper_gds-grp for ub.gds-grp.
      390       find first buf_gds-grp no-lock
      391            where buf_gds-grp.node-code = p-node-code
      392       no-error.
      393       if not available buf_gds-grp
      394       then do:
      395           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      396       end.
      397       assign
      398           p-sort-name  = ""
      399           v-upper-code = 1
      400       .
      401       do while buf_gds-grp.upper-code <> 0
      402       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      403       :
      404           assign
      405               p-sort-name  = buf_gds-grp.node-name
      406                            + (if p-sort-name <> "" then chr(2) else "")
      407                            + p-sort-name
      408               v-upper-code = buf_gds-grp.upper-code
      409           .
      410           find first buf_gds-grp no-lock
      411                where buf_gds-grp.node-code = v-upper-code
      412           no-error.
      413           if not available buf_gds-grp
      414           then do:
      415               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      416                                   + string( v-upper-code )
      417                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      418           end.
      419       end.
      420   end.
      421   end procedure.
      422   define variable vss-include-info2 as character format "X(65)" no-undo
      423   initial "@(#)$Workfile$ $Revision$".
      424   procedure grplib-get-full-name :
      425      define input parameter p-node-code  as integer      no-undo.
      426      define output parameter p-full-name as character    no-undo.
      427      do
      428   on error undo, return error
      429   :
      430       define variable v-upper-code    as integer           no-undo.
      431       define buffer buf_gds-grp       for ub.gds-grp.
      432       define buffer buf_upper_gds-grp for ub.gds-grp.
      433       find first buf_gds-grp no-lock
      434            where buf_gds-grp.node-code = p-node-code
      435       no-error.
      436       if not available buf_gds-grp
      437       then do:
      438           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      439       end.
      440       assign
      441           p-full-name  = ""
      442           v-upper-code = 1
      443       .
      444       do while buf_gds-grp.upper-code <> 0
      445       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      446       :
      447           assign
      448               p-full-name  = buf_gds-grp.node-name
      449                            + (if p-full-name <> "" then chr(47) else "")
      450                            + p-full-name
      451               v-upper-code = buf_gds-grp.upper-code
      452           .
      453           find first buf_gds-grp no-lock
      454                where buf_gds-grp.node-code = v-upper-code
      455           no-error.
      456           if not available buf_gds-grp
      457           then do:
      458               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      459                                   + string( v-upper-code )
      460                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      461           end.
      462       end.
      463       assign
      464       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      465       .
      466   end.
      467   end .
      468   procedure grplib-get-node-from-full-name :
      469   define input parameter p-full-name as character no-undo .
      470   define output parameter p-node-code as integer no-undo .
      471   define variable v-ii as integer no-undo .
      472   define variable v-upper-code as integer no-undo .
      473   define variable v-root-code as integer no-undo .
      474   define variable v-entry as character no-undo .
      475   define buffer buf_gds-grp       for ub.gds-grp.
      476   do
      477   on error undo, return error
      478   :
      479     find first buf_gds-grp no-lock
      480         where buf_gds-grp.upper-code = 0
      481     no-error .
      482     if not available buf_gds-grp
      483     then do:
      484         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      485     end.
      486     else do:
      487       assign
      488       v-root-code = buf_gds-grp.node-code
      489       .
      490     end.
      491     v-upper-code = v-root-code.
      492     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      493       assign
      494       v-entry = entry(v-ii, p-full-name, chr(47)).
      495       if v-entry = '' then leave.
      496       find first buf_gds-grp no-lock where
      497                 buf_gds-grp.node-name = v-entry
      498             and buf_gds-grp.upper-code = v-upper-code
      499             no-error.
      500       if not available buf_gds-grp then do:
      501         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      502       end.
      503       else do:
      504         p-node-code = buf_gds-grp.node-code.
      505         v-upper-code = buf_gds-grp.node-code.
      506       end.
      507     end.
      508   end.
      509   end .
      510   procedure grplib-get-root-code :
      511   do
      512   on error undo, return error
      513   :
      514   define output parameter p-root-code as integer      no-undo.
      515       define buffer buf_gds-grp       for ub.gds-grp.
      516       find first buf_gds-grp no-lock
      517           where buf_gds-grp.upper-code = 0
      518       no-error .
      519       if not available buf_gds-grp
      520       then do:
      521           undo, return error .
      522       end.
      523       else do:
      524           assign
      525               p-root-code = buf_gds-grp.node-code
      526           .
      527       end.
      528   end.
      529   end procedure.
      530   procedure grplib-find-grp-by-full-name :
      531   do
      532   on error undo, return error
      533   :
      534   define input parameter p-search-name  as character    no-undo.
      535   define input parameter p-fill-path    as logical      no-undo.
      536   define output parameter p-found       as logical      no-undo.
      537       define variable v-upper-code    as integer          no-undo.
      538       define variable v-counter       as integer           no-undo.
      539       define variable v-level         as integer           no-undo.
      540       define variable v-full-name     as character         no-undo.
      541       define variable v-sort-name     as character         no-undo.
      542       define buffer buf_gds-grp       for ub.gds-grp.
      543       assign
      544           p-search-name = replace( p-search-name, chr(47), chr(2) )
      545       .
      546       run grplib-get-root-code ( output v-upper-code ) no-error .
      547       if error-status :error
      548       then do:
      549           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      550       end.
      551       assign
      552           v-full-name  = ""
      553           v-level      = num-entries( p-search-name, chr(2) )
      554       .
      555       for each temp_grplib_found-grp
      556       :
      557           delete temp_grplib_found-grp.
      558       end.
      559       start-name-analyze:
      560       do v-counter = 1 to v-level
      561       :
      562           if v-counter < v-level
      563           then do:
      564               find first buf_gds-grp no-lock
      565                    where buf_gds-grp.upper-code = v-upper-code
      566                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      567               no-error .
      568               if not available buf_gds-grp
      569               then do:
      570                   assign
      571                       v-full-name  = p-search-name
      572                       v-sort-name  = p-search-name
      573                   .
      574                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      575               end.
      576               else do:
      577                   assign
      578                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      579                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      580                       v-upper-code = buf_gds-grp.node-code
      581                   .
      582                   if p-fill-path = yes
      583                   then do:
      584                       create temp_grplib_found-grp.
      585                       assign
      586                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      587                           temp_grplib_found-grp.sort-name = v-sort-name
      588                           temp_grplib_found-grp.node-code = v-upper-code
      589                           temp_grplib_found-grp.level     = v-counter
      590                       .
      591                   end.
      592               end.
      593           end.
      594           else do:
      595               for each buf_gds-grp no-lock
      596                  where buf_gds-grp.upper-code = v-upper-code
      597                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      598               :
      599                   assign
      600                       p-found = yes
      601                   .
      602                   create temp_grplib_found-grp.
      603                   assign
      604                       temp_grplib_found-grp.full-name = v-full-name
      605                                                           + (if v-full-name = "" then "" else chr(47) )
      606                                                           + buf_gds-grp.node-name + chr(47)
      607                       temp_grplib_found-grp.sort-name = v-sort-name
      608                                                           + ( if v-sort-name = "" then "" else chr(2) )
      609                                                           + buf_gds-grp.node-name
      610                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      611                       temp_grplib_found-grp.level     = v-level
      612                   .
      613               end.
      614               if p-found = no
      615               then do:
      616                   assign
      617                       v-full-name  = p-search-name
      618                       v-sort-name  = p-search-name
      619                   .
      620                   for each temp_grplib_found-grp
      621                   :
      622                       delete temp_grplib_found-grp.
      623                   end.
      624                   assign
      625                       p-found = no
      626                   .
      627               end.
      628           end.
      629       end.
      630   end.
      631   end procedure.
      632   procedure grplib-find-all-subgroup :
      633   do
      634   on error undo, return error
      635   :
      636   define input parameter p-start-node-code    as integer      no-undo.
      637   define input parameter p-terminal-only      as logical      no-undo.
      638       define variable v-start-full-name   as character     no-undo.
      639       define variable v-start-sort-name   as character     no-undo.
      640       define variable v-not-found         as logical       no-undo.
      641       define variable v-is-terminal       as logical       no-undo.
      642       define buffer buf_gds-grp           for ub.gds-grp.
      643       create temp_found-result-nodelist.
      644       assign
      645           temp_found-result-nodelist.node-code = p-start-node-code
      646           temp_found-result-nodelist.processed = no
      647       .
      648       run grplib-get-full-name in this-procedure (
      649             input p-start-node-code
      650           , output v-start-full-name
      651       ).
      652       run grplib-get-full-name in this-procedure (
      653             input p-start-node-code
      654           , output v-start-sort-name
      655       ).
      656       process-nodes:
      657       do while yes
      658       :
      659           find first temp_found-result-nodelist
      660                where temp_found-result-nodelist.node-code = p-start-node-code
      661           .
      662           assign
      663               temp_found-result-nodelist.processed = yes
      664           .
      665           for each buf_gds-grp no-lock
      666              where buf_gds-grp.upper-code = p-start-node-code
      667           on error undo, return error
      668           :
      669               run grplib-is-terminal in this-procedure (
      670                     input buf_gds-grp.node-code
      671                   , output v-is-terminal
      672               ).
      673               if v-is-terminal = yes
      674               then do:
      675                   create temp_grplib_found-grp.
      676                   assign
      677                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      678                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      679                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      680                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      681                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      682                       temp_grplib_found-grp.is-terminal = yes
      683                   .
      684               end.
      685               else do:
      686                   create temp_found-result-nodelist.
      687                   assign
      688                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      689                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      690                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      691                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      692                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      693                       temp_found-result-nodelist.processed = no
      694                   .
      695                   if p-terminal-only = no
      696                   then do:
      697                       create temp_grplib_found-grp.
      698                       assign
      699                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      700                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      701                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      702                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      703                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      704                           temp_grplib_found-grp.is-terminal = no
      705                       .
      706                   end.
      707               end.
      708           end.
      709           find first temp_found-result-nodelist
      710                where temp_found-result-nodelist.processed = no
      711           no-error.
      712           if not available temp_found-result-nodelist
      713           then do:
      714               leave process-nodes.
      715           end.
      716           else do:
      717               assign
      718                   p-start-node-code = temp_found-result-nodelist.node-code
      719                   v-start-full-name = temp_found-result-nodelist.full-name
      720                   v-start-sort-name = temp_found-result-nodelist.sort-name
      721               .
      722           end.
      723       end.
      724   end.
      725   end procedure.
      726   procedure grplib-expand-name :
      727   define input parameter p-start-name as character        no-undo.
      728   define output parameter p-end-name  as character        no-undo.
      729       define variable v-is-terminal   as logical      no-undo.
      730       define variable v-found         as character    no-undo.
      731       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      732   do
      733   for buf_temp_grplib_found-grp
      734   on error undo, return error
      735   :
      736       run grplib-find-grp-by-full-name in this-procedure (
      737             input p-start-name
      738           , input no
      739           , output v-found
      740       ) no-error.
      741       run grplib-get-max-substring in this-procedure (
      742                   input length( p-start-name )
      743                 , output p-end-name
      744       ) no-error .
      745       if error-status :error
      746       then do:
      747           assign
      748               p-end-name = ""
      749           .
      750       end.
      751       else do:
      752           find first temp_grplib_found-grp
      753               where temp_grplib_found-grp.full-name = p-end-name
      754           no-error.
      755           if available temp_grplib_found-grp
      756           then do:
      757               find first buf_temp_grplib_found-grp
      758                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      759                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      760               no-error.
      761               if not available buf_temp_grplib_found-grp
      762               then do:
      763                   run grplib-is-terminal in this-procedure (
      764                       input temp_grplib_found-grp.node-code
      765                       , output v-is-terminal
      766                   ).
      767               end.
      768           end.
      769       end.
      770   end.
      771   end procedure.
      772   procedure grplib-get-max-substring :
      773   do
      774   on error undo, return error
      775   :
      776   define input parameter p-min-substring-length   as integer      no-undo.
      777   define output parameter p-substring             as character    no-undo.
      778           define variable v-char-counter  as integer           no-undo.
      779           define variable v-current-char  as character         no-undo.
      780           define variable v-names-counter  as integer           no-undo.
      781           define variable v-base-string   as character         no-undo.
      782           assign
      783               v-char-counter  = p-min-substring-length
      784           .
      785           find first temp_grplib_found-grp no-error.
      786           if not available temp_grplib_found-grp
      787           then do:
      788               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      789           end.
      790           else do:
      791               assign
      792                   v-base-string  = temp_grplib_found-grp.full-name
      793                   v-char-counter = 0
      794               .
      795               counter-block:
      796               do while yes
      797               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      798               :
      799                   assign
      800                       v-char-counter  = v-char-counter + 1
      801                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      802                       v-names-counter = 0
      803                   .
      804                   compare-block:
      805                   for each temp_grplib_found-grp
      806                   :
      807                       assign
      808                           v-names-counter = v-names-counter + 1
      809                       .
      810                       if v-names-counter = 1
      811                       then do:
      812                           next compare-block.
      813                       end.
      814                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      815                       then do:
      816                           leave counter-block.
      817                       end.
      818                   end.
      819                   if v-names-counter = 1
      820                   then do:
      821                       assign
      822                           p-substring = v-base-string
      823                       .
      824                       return.
      825                   end.
      826               end.
      827               assign
      828                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      829               .
      830           end.
      831   end.
      832   end procedure.
      833   procedure grplib-is-terminal :
      834   do
      835   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      836   :
      837   define input parameter p-node-code      as integer      no-undo.
      838   define output parameter p-is-terminal   as logical      no-undo.
      839       define buffer buf_gds-grp       for ub.gds-grp.
      840       find first buf_gds-grp no-lock
      841           where buf_gds-grp.upper-code = p-node-code
      842       no-error .
      843       if not available buf_gds-grp
      844       then do:
      845           assign
      846               p-is-terminal = yes
      847           .
      848       end.
      849       else do:
      850           assign
      851               p-is-terminal = no
      852           .
      853       end.
      854   end.
      855   end procedure.
      856   procedure grplib-have-goods :
      857   do
      858   on error undo, return error
      859   :
      860   define input parameter p-node-code      as integer      no-undo.
      861   define output parameter p-have-goods   as logical      no-undo.
      862       define buffer buf_goods         for ub.goods.
      863       find first buf_goods no-lock
      864            where buf_goods.grp-code = p-node-code
      865       no-error .
      866       if available buf_goods
      867       then do:
      868           assign
      869               p-have-goods = yes
      870           .
      871       end.
      872       else do:
      873           assign
      874               p-have-goods = no
      875           .
      876       end.
      877   end.
      878   end procedure.
      879   procedure grplib-find-by-substring :
      880   do
      881   on error undo, return error
      882   :
      883   define input parameter p-start-code         as integer      no-undo.
      884   define input parameter p-full-search-string as character    no-undo.
      885   define output parameter p-found-code        as integer      no-undo.
      886   define output parameter p-full-name         as character    no-undo.
      887       define variable v-start-code     as integer           no-undo.
      888       define variable v-found          as logical  init no  no-undo.
      889       define buffer buf_gds-grp       for ub.gds-grp.
      890       search-grp:
      891       for each buf_gds-grp no-lock
      892           where buf_gds-grp.node-code > p-start-code
      893       :
      894           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      895           then do:
      896               assign
      897                   p-found-code = buf_gds-grp.node-code
      898                   v-found      = yes
      899               .
      900               run grplib-get-full-name in this-procedure (
      901                     input p-found-code
      902                   , output p-full-name
      903               ) no-error .
      904               if error-status :error
      905               then do:
      906                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      907               end.
      908               leave search-grp.
      909           end.
      910       end.
      911       if v-found = yes
      912       then do:
      913       end.
      914       else do:
      915           assign
      916               p-full-name  = ""
      917               p-found-code = 0
      918           .
      919       end.
      920   end.
      921   end procedure.
      922   procedure grplib-analyze-grp-name :
      923   do
      924   on error undo, return error
      925   :
      926   define input parameter p-grp-name       as character            no-undo.
      927   define input parameter p-upper-code     as integer              no-undo.
      928   define output parameter p-error-message as character init ""    no-undo.
      929       define variable v-char-list     as character    no-undo.
      930       define variable v-char-counter  as integer      no-undo.
      931       define variable v-full-name     as character    no-undo.
      932       if p-grp-name = "" then do:
      933           assign
      934               p-error-message = "Название группы не может быть пустым.".
      935           .
      936       end.
      937       else do:
      938           assign
      939               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      940           .
      941           do v-char-counter = 1 to num-entries( v-char-list )
      942           :
      943               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      944               then do:
      945                   assign
      946                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      947                   .
      948                   return.
      949               end.
      950           end.
      951           if p-upper-code > 0
      952           then do:
      953               run grplib-get-full-name in this-procedure (
      954                     input p-upper-code
      955                   , output v-full-name
      956               ) no-error .
      957               if error-status :error
      958               then do:
      959                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      960               end.
      961               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      962               then do:
      963                   assign
      964                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      965                   .
      966               end.
      967           end.
      968       end.
      969   end.
      970   end procedure.
      971   procedure grplib-get-lvl-num :
      972   define input parameter p-node-code  as integer      no-undo.
      973   define output parameter p-lvl-num   as integer      no-undo.
      974       define variable v-full-name    as character    no-undo.
      975   do
      976   on error undo, return error
      977   :
      978       run grplib-get-full-name in this-procedure (
      979             input p-node-code
      980           , output v-full-name
      981       ).
      982       assign
      983           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      984       .
      985       if p-lvl-num = -1
      986       then do:
      987           assign
      988               p-lvl-num = 0
      989           .
      990       end.
      991   end.
      992   end procedure.
      993   define variable  v-str as character no-undo .
      994   find first  ub.assortment-matrix no-lock where
      995               ub.assortment-matrix.asmt-id  = p-id and
      996               ub.assortment-matrix.db-num   = p-db-num and
      997               ub.assortment-matrix.asmt-type =  'Шаблон':U
      998               no-error .
      999       if available ub.assortment-matrix then do:
     1000         return .
     1001       end.
     1002   run waitfram-show in this-procedure (substitute("Ждите. Идет пересчет ассортимента по группам в АссМатрице &1" , p-id)).
     1003   define buffer buf_gds-grp for ub.gds-grp  .
     1004   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
     1005   define buffer buf_goods for ub.goods  .
     1006   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1007   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
     1008   define temp-table tt_gds-grp-obj-attr no-undo like ub.gds-grp-obj-attr  .
     1009   define variable kk as integer   no-undo .
     1010   define variable v-full-name as character no-undo .
     1011   if p-old-grp = 0 or p-new-grp = 0 then do:
     1012   for each buf_gds-grp no-lock :
     1013         kk = 0 .
     1014         if buf_gds-grp.lvl-num = 0 then do:
     1015           for each buf_assortment-matrix-goods no-lock where
     1016                    buf_assortment-matrix-goods.asmg-status  = 0 and
     1017                    buf_assortment-matrix-goods.db-num = p-db-num and
     1018                    buf_assortment-matrix-goods.asmt-id = p-id :
     1019                     find first buf_gds-obj-prop no-lock where
     1020                               buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code and
     1021                               buf_gds-obj-prop.obj-type = buf_assortment-matrix-goods.obj-type and
     1022                               buf_gds-obj-prop.obj-code = buf_assortment-matrix-goods.obj-code and
     1023                               buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U no-error .
     1024                     if not available buf_gds-obj-prop then do:
     1025                         kk = kk + 1 .
     1026                     end.
     1027           end.
     1028         end.
     1029         else do:
     1030             run grplib-get-full-name ( input buf_gds-grp.node-code , output v-full-name).
     1031             run waitfram-show in this-procedure (substitute("Ждите. Идет пересчет ассортимента по группам в АссМатрице &1" , v-full-name)).
     1032             for each buf_assortment-matrix-goods no-lock where
     1033                      buf_assortment-matrix-goods.asmg-status  = 0 and
     1034                      buf_assortment-matrix-goods.db-num = p-db-num and
     1035                      buf_assortment-matrix-goods.asmt-id = p-id ,
     1036                first buf_goods no-lock where
     1037                      buf_goods.gds-code = buf_assortment-matrix-goods.gds-code and
     1038                    ( buf_goods.grp-name begins v-full-name )
     1039                     :
     1040                 find first buf_gds-obj-prop no-lock where
     1041                           buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code and
     1042                           buf_gds-obj-prop.obj-type = buf_assortment-matrix-goods.obj-type and
     1043                           buf_gds-obj-prop.obj-code = buf_assortment-matrix-goods.obj-code and
     1044                           buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U no-error .
     1045                 if not available buf_gds-obj-prop then do:
     1046                     kk = kk + 1 .
     1047                 end.
     1048             end.
     1049         end.
     1050         find first tt_gds-grp-obj-attr exclusive-lock where
     1051                     tt_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     1052                     tt_gds-grp-obj-attr.obj-type  = string(p-id) and
     1053                     tt_gds-grp-obj-attr.obj-code  = p-db-num and
     1054                     tt_gds-grp-obj-attr.host-code = 0 and
     1055                     tt_gds-grp-obj-attr.node-code = buf_gds-grp.node-code no-error .
     1056         if not available tt_gds-grp-obj-attr then do:
     1057             create tt_gds-grp-obj-attr.
     1058                  assign
     1059                     tt_gds-grp-obj-attr.attr-code = 'QntyAssMat':U
     1060                     tt_gds-grp-obj-attr.obj-type  = string(p-id)
     1061                     tt_gds-grp-obj-attr.obj-code  = p-db-num
     1062                     tt_gds-grp-obj-attr.host-code = 0
     1063                     tt_gds-grp-obj-attr.node-code = buf_gds-grp.node-code
     1064                     tt_gds-grp-obj-attr.attr-value = string(kk)
     1065             .
     1066         end.
     1067         else do:
     1068             if int(tt_gds-grp-obj-attr.attr-value) <> kk then tt_gds-grp-obj-attr.attr-value = string(kk) .
     1069         end.
     1070   end.
     1071   end.
     1072   if p-old-grp <> 0 or p-new-grp <> 0 then do:
     1073   for each buf_gds-grp where buf_gds-grp.node-code = p-old-grp or buf_gds-grp.node-code = p-new-grp no-lock :
     1074         kk = 0 .
     1075         if buf_gds-grp.lvl-num = 0 then do:
     1076           for each buf_assortment-matrix-goods no-lock where
     1077                    buf_assortment-matrix-goods.asmg-status  = 0 and
     1078                    buf_assortment-matrix-goods.db-num = p-db-num and
     1079                    buf_assortment-matrix-goods.asmt-id = p-id :
     1080                     find first buf_gds-obj-prop no-lock where
     1081                               buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code and
     1082                               buf_gds-obj-prop.obj-type = buf_assortment-matrix-goods.obj-type and
     1083                               buf_gds-obj-prop.obj-code = buf_assortment-matrix-goods.obj-code and
     1084                               buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U no-error .
     1085                     if not available buf_gds-obj-prop then do:
     1086                         kk = kk + 1 .
     1087                     end.
     1088           end.
     1089         end.
     1090         else do:
     1091             run grplib-get-full-name ( input buf_gds-grp.node-code , output v-full-name).
     1092             run waitfram-show in this-procedure (substitute("Ждите. Идет пересчет ассортимента по группам в АссМатрице &1" , v-full-name)).
     1093             for each buf_assortment-matrix-goods no-lock where
     1094                      buf_assortment-matrix-goods.asmg-status  = 0 and
     1095                      buf_assortment-matrix-goods.db-num = p-db-num and
     1096                      buf_assortment-matrix-goods.asmt-id = p-id ,
     1097                first buf_goods no-lock where
     1098                      buf_goods.gds-code = buf_assortment-matrix-goods.gds-code and
     1099                    ( buf_goods.grp-name begins v-full-name )
     1100                     :
     1101                 find first buf_gds-obj-prop no-lock where
     1102                           buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code and
     1103                           buf_gds-obj-prop.obj-type = buf_assortment-matrix-goods.obj-type and
     1104                           buf_gds-obj-prop.obj-code = buf_assortment-matrix-goods.obj-code and
     1105                           buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U no-error .
     1106                 if not available buf_gds-obj-prop then do:
     1107                     kk = kk + 1 .
     1108                 end.
     1109             end.
     1110         end.
     1111         find first tt_gds-grp-obj-attr exclusive-lock where
     1112                     tt_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     1113                     tt_gds-grp-obj-attr.obj-type  = string(p-id) and
     1114                     tt_gds-grp-obj-attr.obj-code  = p-db-num and
     1115                     tt_gds-grp-obj-attr.host-code = 0 and
     1116                     tt_gds-grp-obj-attr.node-code = buf_gds-grp.node-code no-error .
     1117         if not available tt_gds-grp-obj-attr then do:
     1118             create tt_gds-grp-obj-attr.
     1119                  assign
     1120                     tt_gds-grp-obj-attr.attr-code = 'QntyAssMat':U
     1121                     tt_gds-grp-obj-attr.obj-type  = string(p-id)
     1122                     tt_gds-grp-obj-attr.obj-code  = p-db-num
     1123                     tt_gds-grp-obj-attr.host-code = 0
     1124                     tt_gds-grp-obj-attr.node-code = buf_gds-grp.node-code
     1125                     tt_gds-grp-obj-attr.attr-value = string(kk)
     1126             .
     1127         end.
     1128         else do:
     1129             if int(tt_gds-grp-obj-attr.attr-value) <> kk then tt_gds-grp-obj-attr.attr-value = string(kk) .
     1130         end.
     1131   end.
     1132   end.
     1133   run waitfram-show in this-procedure (substitute("Запись ограничений в БД"  )).
     1134         for each buf_gds-grp-obj-attr exclusive-lock where
     1135                     buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U and
     1136                     buf_gds-grp-obj-attr.obj-type  = tt_gds-grp-obj-attr.obj-type and
     1137                     buf_gds-grp-obj-attr.obj-code  = tt_gds-grp-obj-attr.obj-code and
     1138                     buf_gds-grp-obj-attr.host-code = tt_gds-grp-obj-attr.host-code and
     1139                     buf_gds-grp-obj-attr.node-code = tt_gds-grp-obj-attr.node-code and
     1140                     buf_gds-grp-obj-attr.attr-value <> "0" and
     1141                     buf_gds-grp-obj-attr.attr-value <> "" and
     1142                     integer(buf_gds-grp-obj-attr.attr-value) <= integer(tt_gds-grp-obj-attr.attr-value):
     1143                           find first buf_gds-grp where buf_gds-grp.node-code = buf_gds-grp-obj-attr.node-code no-lock no-error .
     1144                           v-str = v-str + (buf_gds-grp.node-name) + ": ограничение-" + buf_gds-grp-obj-attr.attr-value + ", а товара в группе-" + tt_gds-grp-obj-attr.attr-value + "." + chr(10) .
     1145                           message substitute("Внимание ! Ограничения по Матрице назначены некорректно !!!") view-as alert-box error .
     1146                           run gbl/notes.w ('ПРОСМОТР':U,input-output v-str) .
     1147                           p-ok = no .
     1148                           return no-apply .
     1149         end.
     1150   for each tt_gds-grp-obj-attr:
     1151      find first buf_gds-grp-obj-attr exclusive-lock where
     1152                 buf_gds-grp-obj-attr.node-code = tt_gds-grp-obj-attr.node-code and
     1153                 buf_gds-grp-obj-attr.host-code = tt_gds-grp-obj-attr.host-code and
     1154                 buf_gds-grp-obj-attr.obj-type  = tt_gds-grp-obj-attr.obj-type  and
     1155                 buf_gds-grp-obj-attr.obj-code  = tt_gds-grp-obj-attr.obj-code  and
     1156                 buf_gds-grp-obj-attr.attr-code = tt_gds-grp-obj-attr.attr-code  no-error .
     1157           if not available buf_gds-grp-obj-attr then do:
     1158              create buf_gds-grp-obj-attr.
     1159              buffer-copy tt_gds-grp-obj-attr to buf_gds-grp-obj-attr .
     1160           end.
     1161           else do:
     1162              if buf_gds-grp-obj-attr.attr-value <> tt_gds-grp-obj-attr.attr-value then do:
     1163                 buf_gds-grp-obj-attr.attr-value  = tt_gds-grp-obj-attr.attr-value .
     1164               end.
     1165           end.
     1166   end.
     1167   run waitfram-hide in this-procedure .
