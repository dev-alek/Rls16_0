        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp_contract no-undo
        4   field contract-code as integer
        5   field exch-code     as integer
        6   field contract-date as date
        7   field contract-type as character
        8   field host-code     as integer
        9   field cli-type      as character
       10   field cli-code      as integer
       11   field status_       as character
       12   index pi
       13   contract-code
       14   .
       15   define temp-table temp_contract-specif no-undo
       16   field line-num as integer
       17   field contract-code as integer
       18   field exch-code     as integer
       19   field gds-code      as integer
       20   field vat-pc        as decimal
       21   field vat-type      as character
       22   field prc           as decimal
       23   field price-cli     as decimal
       24   field status_       as character
       25   index pi
       26   line-num
       27   contract-code
       28   gds-code
       29   index pi2
       30   contract-code
       31   line-num
       32   gds-code
       33     .
       34   define input  parameter parparentproc as widget-handle no-undo .
       35   define input  parameter p-log-handle  as handle no-undo .
       36   define input  PARAMETER TABLE FOR  temp_contract.
       37   define input  PARAMETER TABLE FOR  temp_contract-specif.
       38   define output parameter p-ok-doc as integer   no-undo .
       39   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       40   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       41   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       42   define variable vss-workfile    as character no-undo init "$Workfile: ora-i405.p $":U .
       43   define variable vss-archive     as character no-undo init "$Archive: utl/ora-i405.p $":U .
       44   define variable vss-description as character no-undo init "Импорт Договора и спецификации из временной таблицы".
       45   procedure vss-get-info :
       46     define output parameter p-vss-revision    like vss-revision    no-undo .
       47     define output parameter p-vss-author      like vss-author      no-undo .
       48     define output parameter p-vss-date        like vss-date        no-undo .
       49     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       50     define output parameter p-vss-archive     like vss-archive     no-undo .
       51     define output parameter p-vss-description like vss-description no-undo .
       52     assign
       53       p-vss-revision    = vss-revision
       54       p-vss-author      = vss-author
       55       p-vss-date        = vss-date
       56       p-vss-workfile    = vss-workfile
       57       p-vss-archive     = vss-archive
       58       p-vss-description = vss-description
       59     .
       60   end procedure.
       61   procedure vss-get-parameters :
       62     define output parameter p-vss-parameters as character no-undo .
       63   end procedure.
       64   define new global shared variable g#vssrevis-logger as handle    no-undo .
       65   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       66   define variable v-vssrevis-logger                   as handle    no-undo .
       67   procedure vss-logevent :
       68     define input  parameter p-extra-paramters as character no-undo .
       69     define variable v-vssrevis-parameters as character no-undo .
       70     do
       71     on error undo, return error return-value
       72     :
       73       if  valid-handle(v-vssrevis-logger)
       74       and v-vssrevis-logger :get-signature("logevent") <> ""
       75       then do:
       76         run vss-get-parameters in this-procedure
       77           (output v-vssrevis-parameters
       78           ).
       79         run logevent in v-vssrevis-logger
       80           (input vss-workfile
       81           ,input vss-revision
       82           ,input v-vssrevis-parameters
       83           ,input p-extra-paramters
       84           ).
       85       end.
       86     end.
       87   end procedure.
       88   assign
       89     v-vssrevis-logger = g#vssrevis-logger
       90   .
       91   if  valid-handle(v-vssrevis-logger)
       92   and v-vssrevis-logger :get-signature("logevent") <> ""
       93   then do:
       94     assign
       95       v-vssrevis-logevent = true
       96     .
       97     run vss-logevent in this-procedure (input vss-description) .
       98   end.
       99   define new global shared variable g#language as character no-undo .
      100   if g#language <> '' and g#language <> 'rus':U then do:
      101     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      102   end.
      103   define new global shared variable g#library  as handle no-undo .
      104   define new global shared variable g#library2 as handle no-undo .
      105   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106     define variable v-cntxt-db-num        as integer   no-undo .
      107     define variable v-cntxt-userid        as character no-undo .
      108     define variable v-cntxt-level         as character no-undo .
      109     define variable v-cntxt-host-code-obj as integer   no-undo .
      110     define variable v-cntxt-obj-type      as character no-undo .
      111     define variable v-cntxt-obj-code      as integer   no-undo .
      112     define variable v-cntxt-db-num-obj    as integer   no-undo .
      113     define variable v-cntxt-is-admin      as logical   no-undo .
      114   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
      115   procedure who-cli-ora :
      116   define input  parameter p-cli-code-ora as integer   no-undo .
      117   define output parameter p-cli-type as character no-undo .
      118   define output parameter p-cli-code as integer   no-undo .
      119     do
      120     on error undo, return error return-value
      121     :
      122     if length (string(p-cli-code-ora))  <> 9 then do:
      123        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
      124     end.
      125     if string(p-cli-code-ora) begins "1" or
      126        string(p-cli-code-ora) begins "2" or
      127        string(p-cli-code-ora) begins "4" then do:
      128         p-cli-type = 'орг':U .
      129         p-cli-code = p-cli-code-ora  .
      130     end.
      131     else do:
      132       if string(p-cli-code-ora) begins "3" then do:
      133         p-cli-type = 'чел':U .
      134         p-cli-code = p-cli-code-ora  .
      135       end.
      136       else do:
      137          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
      138       end.
      139     end.
      140     define buffer buf_clients for ub.clients  .
      141     find first buf_clients no-lock where
      142                buf_clients.obj-type = p-cli-type and
      143                buf_clients.obj-code = p-cli-code
      144                no-error .
      145         if error-status :error then do:
      146             return error substitute
      147             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
      148                 p-cli-code-ora ,
      149                 p-cli-type ,
      150                 p-cli-code ) .
      151         end.
      152         if ora-icli_ver-stts-client then do:
      153             if buf_clients.stts > 0 then do:
      154                 return error substitute
      155                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
      156                     p-cli-code-ora ,
      157                     p-cli-type ,
      158                     p-cli-code ) .
      159             end.
      160         end.
      161     end.
      162   end procedure.
      163   procedure ora-ver-goods :
      164   define input  parameter p-gds-code as integer   no-undo .
      165   define buffer buf_goods for ub.goods  .
      166   define variable my-message as character no-undo .
      167     do
      168     on error undo, return error return-value
      169     :
      170           find first buf_goods no-lock where
      171                      buf_goods.gds-code = p-gds-code no-error .
      172               if error-status :error then do:
      173                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
      174                   undo, return error my-message.
      175               end.
      176             if buf_goods.stts > 0 then do:
      177               assign
      178                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
      179                 undo, return error my-message.
      180             end.
      181     end.
      182   end procedure.
      183   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   define buffer new_contract        for ub.contract  .
      185   define buffer new_contract-specif for ub.contract-specif  .
      186   define buffer buf_goods           for ub.goods  .
      187   define buffer buf_clients         for ub.clients  .
      188   define buffer own_clients         for ub.clients  .
      189   define buffer buf_firm            for ub.firm  .
      190   define buffer buf_contract-specif for ub.contract-specif  .
      191   define variable my-message as character no-undo .
      192   define variable k as integer   no-undo .
      193     do
      194     on error undo, return error return-value
      195     :
      196   run get-db-num in parparentproc (output v-cntxt-db-num ) .
      197   run get-userid in parparentproc (output v-cntxt-userid ) .
      198   p-ok-doc = 0 .
      199   for each temp_contract-specif break by temp_contract-specif.contract-code :
      200      if first-of(temp_contract-specif.contract-code) then do:
      201       create temp_contract.
      202       assign
      203         temp_contract.contract-code = temp_contract-specif.contract-code
      204         temp_contract.contract-date = today
      205         temp_contract.exch-code = temp_contract-specif.exch-code
      206       .
      207       end.
      208   end.
      209   for each ub.sysconf no-lock :
      210     for each temp_contract :
      211       k = 0.
      212       find first buf_clients no-lock where
      213                  buf_clients.obj-type = 'орг':U and
      214                  buf_clients.obj-code = ub.sysconf.host-code
      215                  no-error.
      216           if not available buf_clients then do:
      217             my-message = substitute("Не верный код фирмы: &2   -  &1" , return-value, ub.sysconf.host-code )  .
      218             run pcall-log-file in p-log-handle (input my-message ) .
      219             undo, return error my-message.
      220           end.
      221         temp_contract.host-code = ub.sysconf.host-code  .
      222         ora-icli_ver-stts-client = false .
      223         run who-cli-ora in this-procedure (
      224             input  temp_contract.contract-code ,
      225             output temp_contract.cli-type ,
      226             output temp_contract.cli-code
      227             ) no-error .
      228             if error-status :error then return error return-value .
      229         for each temp_contract-specif where
      230                  temp_contract-specif.contract-code = temp_contract.contract-code
      231                  :
      232           run ora-ver-goods ( temp_contract-specif.gds-code )  no-error .
      233             if error-status :error then do:
      234                 my-message = return-value .
      235                 run pcall-log-file in p-log-handle ( input my-message ) .
      236                 undo, return error my-message.
      237             end.
      238           find first buf_goods no-lock where
      239                      buf_goods.gds-code = temp_contract-specif.gds-code no-error .
      240             k = k + 1.
      241             find first new_contract-specif where
      242                 new_contract-specif.gds-code      = temp_contract-specif.gds-code and
      243                 new_contract-specif.contract-num  = temp_contract.contract-code and
      244                 new_contract-specif.host-code     = temp_contract.host-code     no-error .
      245              case caps(trim(temp_contract-specif.status_)) :
      246               when 'U' or when 'N' then do:
      247                   if temp_contract-specif.vat-pc = ? then do:
      248                       my-message = substitute("Не задан НДС  по товару &1 &2 (в спецификации контрагента &3&4)" ,
      249                           buf_goods.artic ,
      250                           buf_goods.prod-type ,
      251                           buf_goods.prod-code ,
      252                           buf_goods.gds-name  ,
      253                           temp_contract.cli-type ,
      254                           temp_contract.cli-code
      255                           ) .
      256                       run pcall-log-file in p-log-handle (input my-message) .
      257                       undo, return error my-message.
      258                   end.
      259                  if not available new_contract-specif then create new_contract-specif.
      260                   buffer-copy temp_contract-specif to new_contract-specif
      261                   assign
      262                     new_contract-specif.gds-code      = temp_contract-specif.gds-code
      263                     new_contract-specif.contract-num  = temp_contract.contract-code
      264                     new_contract-specif.host-code     = temp_contract.host-code
      265                     new_contract-specif.gds-code      = buf_goods.gds-code
      266                     new_contract-specif.gds-name      = buf_goods.gds-name
      267                     new_contract-specif.artic         = buf_goods.artic
      268                     new_contract-specif.prod-type     = buf_goods.prod-type
      269                     new_contract-specif.prod-code     = buf_goods.prod-code
      270                     new_contract-specif.cli-base-rate = 1
      271                     new_contract-specif.unit-base     = buf_goods.unit-base
      272                     new_contract-specif.VAT-type      = temp_contract-specif.vat-type
      273                     new_contract-specif.VAT-pc        = temp_contract-specif.vat-pc
      274                     new_contract-specif.db-num        = v-cntxt-db-num
      275                     new_contract-specif.price-cli     = temp_contract-specif.price-cli
      276                   .
      277               end.
      278               when 'D' then do:
      279                   if available new_contract-specif then do:
      280                      delete new_contract-specif.
      281                      next.
      282                   end.
      283               end.
      284               otherwise do:
      285                   my-message = substitute("ошибка значения поля статус = &2 код товара &1" ,  temp_contract-specif.gds-code, temp_contract-specif.status_ ) .
      286                   run pcall-log-file in p-log-handle (input my-message) .
      287                   undo, return error my-message.
      288               end.
      289             end case.
      290         end.
      291         find first buf_clients no-lock where
      292                   buf_clients.obj-type = temp_contract.cli-type and
      293                   buf_clients.obj-code = temp_contract.cli-code no-error .
      294           if error-status :error then do:
      295               my-message = substitute("Нет такого Контрагента &3 &4 &1 &2" , error-status :get-message(1) , return-value ,
      296                             temp_contract.cli-type, temp_contract.cli-code       ) .
      297               run pcall-log-file in p-log-handle (input my-message) .
      298               undo, return error my-message.
      299           end.
      300         find first own_clients no-lock where
      301                   own_clients.obj-type = 'орг':U and
      302                   own_clients.obj-code = temp_contract.host-code no-error .
      303           if error-status :error then do:
      304               my-message = substitute("Нет такого Контрагента &3 &4 &1 &2" , error-status :get-message(1) , return-value ,
      305                             'орг':U, temp_contract.host-code       ) .
      306               run pcall-log-file in p-log-handle (input my-message) .
      307               undo, return error my-message.
      308           end.
      309        find first new_contract no-lock where
      310                   new_contract.contract-code = temp_contract.contract-code and
      311                   new_contract.host-code     = temp_contract.host-code     no-error .
      312         if not available new_contract then do:
      313         create new_contract.
      314         assign
      315           new_contract.curr-code     = temp_contract.exch-code
      316           new_contract.contract-code = temp_contract.contract-code
      317           new_contract.host-code     = temp_contract.host-code
      318           new_contract.contract-prn-code = ""
      319           new_contract.contract-name = buf_clients.obj-name
      320           new_contract.contract-date = temp_contract.contract-date
      321           new_contract.contract-type = temp_contract.contract-type
      322           new_contract.doc-type      = 'при':U
      323           new_contract.status_       = 'тек':U
      324           new_contract.own-name      = own_clients.obj-name
      325           new_contract.cli-type      = temp_contract.cli-type
      326           new_contract.cli-code      = temp_contract.cli-code
      327           new_contract.cli-name      = buf_clients.obj-name
      328           new_contract.db-num        = v-cntxt-db-num
      329           new_contract.user-db-num   = v-cntxt-db-num
      330           new_contract.user-name     = v-cntxt-userid
      331         .
      332           assign
      333             new_contract.an-uchet-code-out          = ub.sysconf.an-uchet-code-out
      334             new_contract.cel-nazn-code-out          = ub.sysconf.cel-nazn-code-out
      335             new_contract.cor-acc-out                = ub.sysconf.cor-acc-out
      336             new_contract.cor-acc1-out               = ub.sysconf.cor-acc1-out
      337             new_contract.an-uchet-code-in           = ub.sysconf.an-uchet-code-in
      338             new_contract.cel-nazn-code-in           = ub.sysconf.cel-nazn-code-in
      339             new_contract.cor-acc-in                 = ub.sysconf.cor-acc-in
      340             new_contract.cor-acc1-in                = ub.sysconf.cor-acc1-in
      341             new_contract.an-uchet-code-out-cash     = ub.sysconf.an-uchet-code-out-cash
      342             new_contract.cel-nazn-code-out-cash     = ub.sysconf.cel-nazn-code-out-cash
      343             new_contract.cor-acc-out-cash           = ub.sysconf.cor-acc-out-cash
      344             new_contract.cor-acc1-out-cash          = ub.sysconf.cor-acc1-out-cash
      345             new_contract.an-uchet-code-in-cash      = ub.sysconf.an-uchet-code-in-cash
      346             new_contract.cel-nazn-code-in-cash      = ub.sysconf.cel-nazn-code-in-cash
      347             new_contract.cor-acc-in-cash            = ub.sysconf.cor-acc-in-cash
      348             new_contract.cor-acc1-in-cash           = ub.sysconf.cor-acc1-in-cash
      349             new_contract.an-uchet-code-out-payoff   = ub.sysconf.an-uchet-code-out-payoff
      350             new_contract.cel-nazn-code-out-payoff   = ub.sysconf.cel-nazn-code-out-payoff
      351             new_contract.cor-acc-out-payoff         = ub.sysconf.cor-acc-out-payoff
      352             new_contract.cor-acc1-out-payoff        = ub.sysconf.cor-acc1-out-payoff
      353             new_contract.an-uchet-code-in-payoff    = ub.sysconf.an-uchet-code-in-payoff
      354             new_contract.cel-nazn-code-in-payoff    = ub.sysconf.cel-nazn-code-in-payoff
      355             new_contract.cor-acc-in-payoff          = ub.sysconf.cor-acc-in-payoff
      356             new_contract.cor-acc1-in-payoff         = ub.sysconf.cor-acc1-in-payoff
      357             new_contract.transport-cli-type         = ub.sysconf.transport-cli-type
      358             new_contract.transport-cli-code         = ub.sysconf.transport-cli-code
      359             new_contract.transport-host             = ub.sysconf.transport-host
      360             new_contract.transport-contract         = ub.sysconf.transport-contract
      361             new_contract.transport-uslov            = ub.sysconf.transport-uslov
      362             new_contract.transport-value            = ub.sysconf.transport-value
      363             new_contract.agnt-type                  = ""
      364             new_contract.posr-type                  = ""
      365           .
      366           if ub.sysconf.pay-code-schet-rubl > 0 then
      367             assign
      368               new_contract.own-code-schet = ub.sysconf.pay-code-schet-rubl
      369             .
      370           find first buf_firm no-lock where buf_firm.firm-code = temp_contract.host-code no-error .
      371           if error-status :error then do:
      372               my-message = substitute("Нет фирмы &3 &4 &1 &2" , error-status :get-message(1) , return-value ,
      373                             'орг':U, temp_contract.host-code       ) .
      374               run pcall-log-file in p-log-handle (input my-message) .
      375               undo, return error my-message.
      376           end.
      377           assign
      378             new_contract.own-kpp           = buf_firm.kpp
      379             new_contract.own-inn           = buf_firm.inn
      380             new_contract.own-addres        = buf_firm.addres1
      381             new_contract.contract-city     = ub.sysconf.contract-city
      382             new_contract.own-sign-post     = ub.sysconf.pay-sign-post
      383             new_contract.own-sign          = ub.sysconf.pay-sign
      384             new_contract.contract-date     = today
      385             new_contract.contract-date-beg = today
      386             new_contract.contract-date-end = date('')
      387             new_contract.fin-vat-pc        = ub.sysconf.fin-vat-pc
      388             new_contract.srok-opl          = ub.sysconf.srok-opl
      389             new_contract.gen-factur-srok   = ub.sysconf.srok-opl-sf
      390           .
      391       case ub.sysconf.usl-opl-sf  :
      392         when 'Не определено':U  or
      393         when  "" or
      394         when ?      then do:
      395         assign  new_contract.gen-factur = 0 .
      396         end.
      397         when 'По приходной накладной':U        then assign   new_contract.gen-factur = 1 .
      398         when 'По фин. обязательству':U        then assign   new_contract.gen-factur = 2 .
      399         when 'По платежу':U       then assign   new_contract.gen-factur = 3 .
      400         when 'По накл. смены типа преобр.':U      then assign   new_contract.gen-factur = 4 .
      401         when 'По расходной накладной':U       then assign   new_contract.gen-factur = 5 .
      402       end.
      403       if ub.sysconf.contract-type <> "" and ub.sysconf.contract-type <> ?  and ub.sysconf.contract-type <> "Не задан" then
      404         new_contract.contract-type = ub.sysconf.contract-type .
      405       else new_contract.contract-type = 'Купли-продажи':U .
      406       if ub.sysconf.usl-opl <> "" and   ub.sysconf.usl-opl <> ? then
      407           new_contract.usl-opl =  ub.sysconf.usl-opl .
      408       else new_contract.usl-opl    = 'Не определено':U .
      409         new_contract.auto-pay = ub.sysconf.auto-pay .
      410       if ub.sysconf.pay-code-schet-rubl <> ? then do:
      411         find first ub.fin-schet no-lock where
      412             ub.fin-schet.host-code  = new_contract.host-code and
      413             ub.fin-schet.code-schet = ub.sysconf.pay-code-schet-rubl no-error .
      414         if available ub.fin-schet then do:
      415           find first ub.fin-bank no-lock where
      416                       ub.fin-bank.host-code = new_contract.host-code and
      417                       ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
      418           assign
      419             new_contract.own-bank-name = ub.fin-bank.bank-name
      420             new_contract.own-bik       = ub.fin-bank.bik
      421             new_contract.own-r-schet   = ub.fin-schet.r-schet
      422             new_contract.own-c-schet   = ub.fin-schet.c-schet
      423           .
      424           release new_contract no-error .
      425           if error-status :error then do:
      426               message
      427                 vss-workfile vss-revision vss-description skip
      428                 error-status :get-message(1) skip
      429                 return-value skip
      430                 "Ошибка сохранения договора"
      431                 view-as alert-box error
      432               .
      433             my-message = substitute("Ошибка сохранения договора по фирме &2 - &1" , return-value, ub.sysconf.host-code )  .
      434             run pcall-log-file in p-log-handle (input my-message ) .
      435             undo, return error my-message.
      436           end.
      437         end.
      438       end.
      439       end.
      440        find first new_contract exclusive-lock where
      441           new_contract.contract-code = temp_contract.contract-code and
      442           new_contract.host-code     = temp_contract.host-code     no-error .
      443         if available new_contract then do:
      444           new_contract.contract-name = buf_clients.obj-name .
      445           new_contract.contract-prn-code = "".
      446         if not can-find ( first buf_contract-specif no-lock where
      447            buf_contract-specif.host-code = new_contract.host-code  and
      448            buf_contract-specif.contract-num = new_contract.contract-code       ) then
      449            do:
      450              if new_contract.status_ <> 'зкр':U  then do:
      451                 new_contract.status_  = 'зкр':U  .
      452                 new_contract.contract-date-end = today .
      453              end.
      454            end.
      455            else do:
      456                new_contract.status_ = 'тек':U .
      457                if new_contract.contract-date-end <> date('') then do:
      458                   new_contract.contract-date-beg = today    .
      459                   new_contract.contract-date-end = date('') .
      460                end.
      461            end.
      462         end.
      463       my-message =  substitute(" &3&4 Договор: &1 фирма &5 товаров: &2 " ,
      464                                     temp_contract.contract-code    ,
      465                                     k ,
      466                                     temp_contract.cli-type ,
      467                                     temp_contract.cli-code ,
      468                                     temp_contract.host-code
      469                                     ).
      470       run pcall-log-file in p-log-handle (input my-message) .
      471       p-ok-doc = p-ok-doc + 1.
      472     end.
      473     end.
      474    end.
