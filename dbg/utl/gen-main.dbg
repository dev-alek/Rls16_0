        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 47c30cad4995, 3593, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        4   define variable vss-date        as character no-undo init "$Date: 2023/12/28 12:56:36 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: gen-main.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/gen-main.p $":U .
        7   define variable vss-description as character no-undo init "Генерация файлов по структуре БД".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66     define temp-table temp_vss-dir no-undo
       67       field vsd-key   as integer
       68       field dir-name  as character
       69       field file-list as character
       70       index pi is primary unique
       71           vsd-key
       72     .
       73     define variable gen-dir         as character no-undo .
       74     define variable gen-file-list   as character no-undo .
       75     define variable v-work-dir      as character no-undo .
       76     define variable v-gen-file-name as character no-undo .
       77     define variable v-dir-name    as character    no-undo.
       78     define variable v-file-name   as character    no-undo.
       79     define variable v-vsd-key     as integer      no-undo.
       80     define stream OutStream.
       81     define variable v-ind         as integer no-undo .
       82     define variable v-num-entries as integer no-undo .
       83   do
       84   on error undo, return error
       85   :
       86     assign
       87       file-info :file-name = ".":U
       88     .
       89     if file-info :full-pathname = ""
       90     or file-info :full-pathname = ?  then do:
       91       message
       92         "Рабочий каталог не найден"
       93         view-as alert-box error .
       94       undo, return error .
       95     end.
       96     assign
       97       v-work-dir = file-info :full-pathname + chr(92)
       98     .
       99     if     entry(1,propath) ne "."
      100        and entry(1,propath) ne file-info :full-pathname
      101     then
      102        gen-dir = entry(1,propath).
      103     else
      104        gen-dir = entry(2,propath) no-error.
      105     run gbl/d-prompt.w (
      106         'title=':u + "Введите имя директории" + '\':u
      107       + 'text1=':u + "Введите имя директории" + '\':u
      108       + 'text2=':u + "где будут созданы файлы по структуре БД" + '\':u
      109       + 'format=x(256)\':u
      110       + 'type=char\':u
      111       ,input-output gen-dir
      112       ).
      113     if return-value = 'false':u then do:
      114       return .
      115     end.
      116     if gen-dir = "" then do:
      117       assign
      118         gen-dir = v-work-dir
      119       .
      120     end.
      121     else do:
      122       assign
      123         file-info :file-name = gen-dir
      124       .
      125       if file-info :full-pathname = ""
      126       or file-info :full-pathname = ?  then do:
      127         message
      128           "Указаный каталог не найден" skip
      129           gen-dir
      130           view-as alert-box error .
      131         undo, return error .
      132       end.
      133       assign
      134         gen-dir = file-info :full-pathname + chr(92)
      135       .
      136     end.
      137     run utl/gen-tbln.p
      138       (input        gen-dir
      139       ,input-output gen-file-list
      140       ) .
      141     run utl/gen-imp.p
      142       (input        gen-dir
      143       ,input-output gen-file-list
      144       ) .
      145     assign
      146       v-gen-file-name = v-work-dir + "gen-file.txt":U
      147     .
      148     output stream OutStream to value( v-gen-file-name ) .
      149     put stream OutStream unformatted
      150       "Список файлов сгенерированых в каталоге" space(1) '"' gen-dir '"' skip
      151       today space(1) string( time, "HH:MM:SS":U ) skip(1)
      152     .
      153     assign
      154       v-num-entries = num-entries( gen-file-list, ",":U )
      155     .
      156     do v-ind = 1 to v-num-entries
      157     :
      158       put stream OutStream unformatted
      159         entry( v-ind, gen-file-list, ",":U ) skip
      160       .
      161     end.
      162     put stream OutStream
      163           skip(2)
      164     .
      165     do v-ind = 1 to v-num-entries
      166     :
      167       if num-entries( entry( v-ind, gen-file-list, ",":U ), "/":U ) = 2
      168       then do:
      169           assign
      170               v-dir-name = entry( 1, entry( v-ind, gen-file-list, ",":U ), "/":U )
      171               v-file-name = entry( 2, entry( v-ind, gen-file-list, ",":U ), "/":U )
      172           .
      173           find last temp_vss-dir
      174               where temp_vss-dir.dir-name = v-dir-name
      175           no-error.
      176           if not available temp_vss-dir
      177           then do:
      178               assign
      179                   v-vsd-key = v-vsd-key + 1
      180               .
      181               create temp_vss-dir.
      182               assign
      183                   temp_vss-dir.vsd-key   = v-vsd-key
      184                   temp_vss-dir.dir-name  = v-dir-name
      185                   temp_vss-dir.file-list = v-file-name
      186               .
      187           end.
      188           else do:
      189               if length( temp_vss-dir.file-list ) + 1 + length( v-file-name ) > 255
      190               then do:
      191                   assign
      192                       v-vsd-key = v-vsd-key + 1
      193                   .
      194                   create temp_vss-dir.
      195                   assign
      196                       temp_vss-dir.vsd-key   = v-vsd-key
      197                       temp_vss-dir.dir-name  = v-dir-name
      198                       temp_vss-dir.file-list = v-file-name
      199                   .
      200               end.
      201               else do:
      202                 assign
      203                     temp_vss-dir.file-list = substitute( "&1;&2", temp_vss-dir.file-list, v-file-name )
      204                 .
      205               end.
      206           end.
      207       end.
      208     end.
      209     for each temp_vss-dir
      210     :
      211       put stream OutStream unformatted
      212           substitute( "&1Каталог VSS: &2&1--------------------------&1&3&1", chr(10), temp_vss-dir.dir-name, temp_vss-dir.file-list )
      213       .
      214     end.
      215     output stream OutStream close.
      216     assign
      217       file-info :file-name = v-gen-file-name
      218     .
      219     if file-info :full-pathname = ""
      220     or file-info :full-pathname = ?  then do:
      221       message
      222         "Файл gen-file.txt не найден"
      223         view-as alert-box error .
      224       undo, return error .
      225     end.
      226     assign
      227       v-gen-file-name = file-info :full-pathname
      228     .
      229     os-command no-wait value( substitute( "start &1", v-gen-file-name ) ).
      230   end.
