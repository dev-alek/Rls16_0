      477   procedure uf-get :
      478     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      479     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      480     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      481     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      482     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      483     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      484     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      485     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      486     do
      487     on error undo, return error
      488     :
      489       define buffer buf_usr-flt for ubflt.usr-flt .
      490       define variable v-use-List_     as logical   no-undo .
      491       define variable v-type-List_     as character no-undo .
      492       define variable v-format-List_   as character no-undo .
      493       define variable v-use-Naim      as logical   no-undo .
      494       define variable v-type-Naim      as character no-undo .
      495       define variable v-format-Naim    as character no-undo .
      496       define variable v-use-print-graft as logical   no-undo .
      497       define variable v-use-sort-gr     as logical   no-undo .
      498       define variable v-use-type-price  as logical   no-undo .
      499       define variable v-use-type-val    as logical   no-undo .
      500       define variable v-label          as character no-undo .
      501       define variable v-tooltip        as character no-undo .
      502       define variable v-user-can-edit  as logical   no-undo .
      503       define variable v-output-display as logical   no-undo .
      504       define variable v-other          as character no-undo .
      505       run uf-name in this-procedure
      506          (input  entry(1, p-code, chr(4))
      507         ,output v-use-List_
      508         ,output v-type-List_
      509         ,output v-format-List_
      510         ,output v-use-Naim
      511         ,output v-type-Naim
      512         ,output v-format-Naim
      513         ,output v-use-print-graft
      514         ,output v-use-sort-gr
      515         ,output v-use-type-price
      516         ,output v-use-type-val
      517         ,output v-label
      518         ,output v-tooltip
      519         ,output v-user-can-edit
      520         ,output v-output-display
      521         ,output v-other
      522         ) no-error .
      523       if error-status :error then do:
      524         undo, return error return-value .
      525       end.
      526       find first buf_usr-flt no-lock where
      527                  buf_usr-flt.Call-point     = p-code AND
      528                  buf_usr-flt.user-name       = p-user-name
      529         no-error .
      530       if avail buf_usr-flt then do:
      531         assign
      532         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      533         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      534         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      535         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      536         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      537         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      538         .
      539       end.
      540       else do:
      541         assign
      542         p-List_        = (if v-use-List_       then "":U                    else ?)
      543         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      544         p-print-graft  = (if v-use-print-graft then no                      else ?)
      545         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      546         p-type-price   = (if v-use-type-price  then no                      else ?)
      547         p-type-val     = (if v-use-List_       then no                      else ?)
      548         .
      549       end.
      550     end.
      551   end procedure.
      552   procedure uf-set :
      553     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      554     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      555     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      556     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      557     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      558     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      559     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      560     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      561     do
      562     on error undo, return error
      563     :
      564       define buffer buf_usr-flt for ubflt.usr-flt .
      565       define variable v-use-List_     as logical   no-undo .
      566       define variable v-type-List_     as character no-undo .
      567       define variable v-format-List_   as character no-undo .
      568       define variable v-use-Naim      as logical   no-undo .
      569       define variable v-type-Naim      as character no-undo .
      570       define variable v-format-Naim    as character no-undo .
      571       define variable v-use-print-graft as logical   no-undo .
      572       define variable v-use-sort-gr   as logical   no-undo .
      573       define variable v-use-type-price as logical   no-undo .
      574       define variable v-use-type-val  as logical   no-undo .
      575       define variable v-tooltip        as character no-undo .
      576       define variable v-label          as character no-undo .
      577       define variable v-user-can-edit  as logical   no-undo .
      578       define variable v-output-display as logical   no-undo .
      579       define variable v-other          as character no-undo .
      580       run uf-name in this-procedure
      581         (input  entry(1, p-code, chr(4))
      582         ,output v-use-List_
      583         ,output v-type-List_
      584         ,output v-format-List_
      585         ,output v-use-Naim
      586         ,output v-type-Naim
      587         ,output v-format-Naim
      588         ,output v-use-print-graft
      589         ,output v-use-sort-gr
      590         ,output v-use-type-price
      591         ,output v-use-type-val
      592         ,output v-label
      593         ,output v-tooltip
      594         ,output v-user-can-edit
      595         ,output v-output-display
      596         ,output v-other
      597         ) no-error .
      598       if error-status :error then do:
      599         undo, return error return-value .
      600       end.
      601       find first buf_usr-flt where
      602                  buf_usr-flt.Call-point     = p-code AND
      603                  buf_usr-flt.user-name       = p-user-name
      604         no-error .
      605       if not avail buf_usr-flt then do:
      606           create buf_usr-flt .
      607           assign
      608           buf_usr-flt.call-point = p-code
      609           buf_usr-flt.user-name  = p-user-name
      610           .
      611       end.
      612       if avail buf_usr-flt then do:
      613        assign
      614        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      615        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      616        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      617        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      618        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      619        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      620       .
      621       release buf_usr-flt.
      622       end.
      623       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      624     end.
      625   end procedure.
      626   DEFINE BUTTON b-exit AUTO-GO
      627        LABEL "&Выход"
      628        SIZE 10 BY 1
      629        BGCOLOR 8 .
      630   DEFINE BUTTON b-help
      631        LABEL "Помо&щь"
      632        SIZE 10 BY 1
      633        BGCOLOR 8 .
      634   DEFINE BUTTON b-imp
      635        LABEL "&Импорт"
      636        SIZE 10 BY 1
      637        BGCOLOR 8 .
