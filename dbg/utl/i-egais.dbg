      639        IMAGE-UP FILE "btn-down-arrow":U
      640        IMAGE-DOWN FILE "btn-down-arrow":U
      641        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      642        LABEL "":L
      643        size 2.5 by 1.08.
      644   DEFINE BUTTON b-sel-sup-codes DEFAULT
      645        IMAGE-UP FILE "btn-down-arrow":U
      646        IMAGE-DOWN FILE "btn-down-arrow":U
      647        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      648        LABEL "":L
      649        size 2.5 by 1.08.
      650   DEFINE VARIABLE v-alc-codes-filename AS CHARACTER FORMAT "X(256)":U
      651        LABEL "Справочник товаров"
      652        VIEW-AS FILL-IN
      653        SIZE 40 BY 1
      654        FGCOLOR 4  NO-UNDO.
      655   DEFINE VARIABLE v-sup-codes-filename AS CHARACTER FORMAT "X(256)":U
      656        LABEL "Справочник поставщиков"
      657        VIEW-AS FILL-IN
      658        SIZE 40 BY 1
      659        FGCOLOR 4  NO-UNDO.
      660   DEFINE FRAME Dialog-Frame
      661        b-exit AT ROW 1 COL 1
      662        b-imp AT ROW 1 COL 11
      663        b-help AT ROW 1 COL 56
      664        v-alc-codes-filename AT ROW 3 COL 23 COLON-ALIGNED
      665        b-sel-alc-codes at row 3 col 66
      666        v-sup-codes-filename AT ROW 4 COL 23 COLON-ALIGNED
      667        b-sel-sup-codes at row 4 col 66
      668        SPACE(2.62) SKIP(1.99)
      669       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      670            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      671            TITLE "Импорт классификатора ЕГАИС"
      672            DEFAULT-BUTTON b-exit.
      673   ASSIGN
      674          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      675          FRAME Dialog-Frame:HIDDEN           = TRUE.
      676   ASSIGN
      677          v-alc-codes-filename:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      678   ASSIGN
      679          v-sup-codes-filename:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      680   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      681   DO:
      682     APPLY "END-ERROR":U TO SELF.
      683   END.
      684   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      685   OR HELP OF FRAME Dialog-Frame
      686   DO:
      687     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\i-egais.w" VIEW-AS ALERT-BOX INFORMATION.
      688   END.
      689   ON CHOOSE OF b-imp IN FRAME Dialog-Frame
      690   DO:
      691     assign
      692       v-alc-codes-filename
      693       v-sup-codes-filename
      694     .
      695     if v-alc-codes-filename = "" or
      696        v-sup-codes-filename = ""
      697     then do:
      698       message
      699         "Не задан один из файлов. Импорт невозможен."
      700       view-as alert-box error.
      701       return no-apply.
      702     end.
      703     if ( v-sup-codes-filename = v-alc-codes-filename )
      704     then do:
      705       message
      706         "Имена файлов совпадают, импорт невозможен."
      707       view-as alert-box error.
      708       return no-apply.
      709     end.
      710     run proc-import in this-procedure .
      711   END.
      712   ON CHOOSE OF b-sel-alc-codes IN FRAME Dialog-Frame
      713   DO:
      714     define variable v-filename as character no-undo .
      715     run choose-file in this-procedure ( output v-filename ) no-error .
      716     if error-status :error then do:
      717       message
      718         "Ошибка выбора файла."
      719       view-as alert-box error.
      720       return no-apply.
      721     end.
      722     assign
      723       v-alc-codes-filename = v-filename
      724     .
      725     display
      726       v-alc-codes-filename
      727     with frame Dialog-Frame.
      728   END.
      729   ON CHOOSE OF b-sel-sup-codes IN FRAME Dialog-Frame
      730   DO:
      731     define variable v-filename as character no-undo .
      732     run choose-file in this-procedure ( output v-filename ) no-error .
      733     if error-status :error then do:
      734       message
      735         "Ошибка выбора файла."
      736       view-as alert-box error.
      737       return no-apply.
      738     end.
      739     assign
      740       v-sup-codes-filename = v-filename
      741     .
      742     display
      743       v-sup-codes-filename
      744     with frame Dialog-Frame.
      745   END.
      746   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      747   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      748   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      749   on help of frame Dialog-Frame
      750   do:
      751     run gbl/app_help.p
      752       (input this-procedure :file-name
      753       ,input ''
      754       ,input ?
      755       ) no-error.
      756     if error-status :error then do:
      757       message
      758         "Ошибка при вызове помощи"
      759         error-status :get-message(1)
      760         view-as alert-box .
      761     end.
      762   end.
      763   run minbtn-set in this-procedure .
      764   on choose of b-help in frame Dialog-Frame
      765   do:
      766     apply "help":u to frame Dialog-Frame .
      767   end.
      768   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   procedure minbtn-set :
      770       do
      771           on error undo, return error return-value
      772           :
      773           define variable ii              as integer       no-undo .
      774           define variable fh              as widget-handle no-undo .
      775           define variable hh              as widget-handle no-undo .
      776           define variable v-h             as handle        extent 4 no-undo .
      777           define variable v-name-button   as character     no-undo .
      778           define variable v-help-old-x    as decimal       no-undo .
      779           define variable v-help-old-y    as decimal       no-undo .
      780           define variable v-help-old-size as decimal       no-undo .
      781           define variable v-frame-width   as decimal       no-undo .
      782           define variable jj              as integer       no-undo .
      783           do
      784               on error undo, return error
      785               :
      786               assign
      787                   v-frame-width = frame Dialog-Frame:width - 0.3
      788                   fh            = frame Dialog-Frame:first-child
      789                   hh            = fh:first-child
      790                   ii            = 1
      791                   .
      792               do while valid-handle(hh):
      793                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      794                   do:
      795                       case lc(hh:name) :
      796                           when "b-help" then
      797                               do:
      798                                   hh:load-image-up("cmp/b-help.bmp":u) .
      799                                   hh:load-image-down("cmp/b-help.bmp":u) .
      800                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      801                                   hh:TOOLTIP = "Помощь" .
      802                                   v-help-old-x = hh:column .
      803                                   v-help-old-y = hh:row    .
      804                                   v-help-old-size = hh:width .
      805                                   hh:width-chars = 2.5 .
      806                               end.
      807                           when "b-print" then
      808                               do:
      809                                   hh:load-image("cmp/b-print.bmp":u) .
      810                                   hh:TOOLTIP = "Печать" .
      811                                   v-h[ii] = hh:handle .
      812                                   ii = ii + 1 .
      813                                   hh:width-chars = 3 .
      814                               end.
      815                           when "b-history" or
      816                           when "b-hist" then
      817                               do:
      818                                   hh:load-image("cmp/b-hist.bmp":u) .
      819                                   hh:TOOLTIP = "История" .
      820                                   v-h[ii] = hh:handle .
      821                                   ii = ii + 1 .
      822                                   hh:width-chars = 3 .
      823                               end.
      824                           when "b-sch" then
      825                               do:
      826                                   hh:load-image("cmp/b-sch.bmp":u) .
      827                                   hh:TOOLTIP = "Установка Фильтра" .
      828                                   v-h[ii] = hh:handle .
      829                                   ii = ii + 1 .
      830                                   hh:width-chars = 3 .
      831                               end.
      832                           when "b-hist-user" then
      833                               do:
      834                                   hh:load-image("cmp/b-hist.bmp":u) .
      835                                   hh:TOOLTIP = "История пользователя" .
      836                                   ii = ii + 1 .
      837                               end.
      838                       end case.
      839                   end.
      840                   hh = hh:next-sibling.
      841               end.
      842               b-help:column = v-frame-width - b-help:width-chars.
      843               jj = 0.
      844               repeat ii = 4 to 1 by -1 :
      845                   if valid-handle (v-h[ii] ) then
      846                   do:
      847                       jj  = jj + 1 .
      848                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      849                       v-h[ii]:row    = v-help-old-y .
      850                   end.
      851               end.
      852           end.
      853       end.
      854   end procedure.
      855   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      856   on F2 of frame Dialog-Frame anywhere do:
      857     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
      858     return no-apply.
      859   end.
      860   MAIN-BLOCK:
      861   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      862      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      863     RUN my-enable in this-procedure .
      864     WAIT-FOR GO OF FRAME Dialog-Frame.
      865   END.
      866   RUN disable_UI.
      867   PROCEDURE choose-file :
      868   define output parameter p-filename as character no-undo .
      869   define variable v-filename as character no-undo.
      870   define variable v-log as logical no-undo.
      871     SYSTEM-DIALOG GET-FILE v-filename
      872                   TITLE   "Файл импорта"
      873                   FILTERS "XML файл (*.xml)"   "*.xml",
      874                           "Все файлы (*.*)"    "*.*"
      875                   MUST-EXIST
      876                   USE-FILENAME
      877                   default-extension ".xml"
      878                   UPDATE v-log.
      879     if not v-log then do:
      880       return error.
      881     end.
      882     else do:
      883       assign
      884         p-filename = v-filename
      885       .
      886     end.
      887   END PROCEDURE.
      888   PROCEDURE disable_UI :
      889     HIDE FRAME Dialog-Frame.
      890   END PROCEDURE.
      891   PROCEDURE enable_UI :
      892     DISPLAY v-alc-codes-filename v-sup-codes-filename
      893         WITH FRAME Dialog-Frame.
      894     ENABLE b-exit b-imp b-help v-alc-codes-filename b-sel-alc-codes
      895            v-sup-codes-filename b-sel-sup-codes
      896         WITH FRAME Dialog-Frame.
      897     VIEW FRAME Dialog-Frame.
      898   END PROCEDURE.
      899   PROCEDURE my-enable :
      900     define variable v-naim          as character        no-undo.
      901     define variable v-list          as character        no-undo.
      902     define variable v-print-graft   as logical          no-undo.
      903     define variable v-sort-gr       as logical          no-undo.
      904     define variable v-type-price    as logical          no-undo.
      905     define variable v-type-val      as logical          no-undo.
      906     define variable v-found         as logical          no-undo.
      907   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908     run mainmenu_getcntxt in parparentproc
      909       (output v-cntxt-db-num
      910       ,output v-cntxt-userid
      911       ,output v-cntxt-level
      912       ,output v-cntxt-host-code-obj
      913       ,output v-cntxt-obj-type
      914       ,output v-cntxt-obj-code
      915       ,output v-cntxt-db-num-obj
      916       ,output v-cntxt-is-admin
      917       ) .
      918     run uf-get ( input  'cus/i-egais.w':U
      919                       , input v-cntxt-userid
      920                       , output v-list
      921                       , output v-naim
      922                       , output v-print-graft
      923                       , output v-sort-gr
      924                       , output v-type-price
      925                       , output v-type-val
      926                       ).
      927     if num-entries(v-list) >= 2 then do:
      928       assign
      929         v-alc-codes-filename = entry( 1 , v-list )
      930         v-sup-codes-filename = entry( 2 , v-list )
      931       .
      932     end.
      933     display
      934       v-alc-codes-filename
      935       v-sup-codes-filename
      936     with frame Dialog-Frame.
      937     enable
      938       b-exit
      939       b-imp
      940       b-help
      941       b-sel-alc-codes
      942       b-sel-sup-codes
      943       v-alc-codes-filename
      944       v-sup-codes-filename
      945     with frame Dialog-Frame.
      946     view frame Dialog-Frame.
      947   END PROCEDURE.
      948   PROCEDURE proc-import :
      949     define variable v-log as logical   no-undo .
      950     define variable v-naim          as character        no-undo.
      951     define variable v-list          as character        no-undo.
      952     define variable v-print-graft   as logical          no-undo.
      953     define variable v-sort-gr       as logical          no-undo.
      954     define variable v-type-price    as logical          no-undo.
      955     define variable v-type-val      as logical          no-undo.
      956     define variable v-found         as logical          no-undo.
      957     message
      958       "Ипорт классификатора ЕГАИС." skip
      959       "Начать импорт?"
      960     view-as alert-box question buttons yes-no update v-log.
      961     if v-log <> yes then return.
      962     assign
      963       v-list = substitute( "&1,&2"
      964                          , v-alc-codes-filename
      965                          , v-sup-codes-filename
      966                          )
      967     .
      968     run uf-set ( input 'cus/i-egais.w':U
      969                , input  v-cntxt-userid
      970                , input v-list
      971                , input v-naim
      972                , input v-print-graft
      973                , input v-sort-gr
      974                , input v-type-price
      975                , input v-type-val
      976                ) .
      977     run utl/impegais.p ( input parparentproc
      978                        , input v-alc-codes-filename
      979                        , input v-sup-codes-filename
      980                        ) no-error .
      981     if error-status :error then do:
      982       message
      983         "Ошибка импорта классификатора ЕГАИС." skip
      984         trim( return-value ) skip
      985         trim( error-status :get-message(1) ) skip
      986         trim( error-status :get-message(2) ) skip
      987         trim( error-status :get-message(3) ) skip
      988       view-as alert-box error.
      989     end.
      990   END PROCEDURE.
