        1   block-level on error undo, throw.
        2   using ibs.th.str.marking.sts.*.
        3   define variable vss-revision as character no-undo init "$Revision: f29df1d5f130, 3104, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        5   define variable vss-date        as character no-undo init "$Date: Вт авг 09 09:15:01 2022 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: rollback-mark.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/rollback-mark.p $":U .
        8   define variable vss-description as character no-undo init "Утилита отката помарочного учета".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable vss-include-info1 as character format "X(65)" no-undo
       69   initial "@(#)$Workfile$ $Revision$".
       70   procedure xmlchar-test :
       71   define input parameter p-in-string          as character        no-undo.
       72   define output parameter p-out-string-enc    as character        no-undo.
       73   define output parameter p-out-string-dec    as character        no-undo.
       74   do
       75   on error undo, return error
       76   :
       77          run xmlchar-encode in this-procedure
       78       (
       79             input p-in-string
       80           , output p-out-string-enc
       81       ).
       82          run xmlchar-decode in this-procedure
       83       (
       84             input p-out-string-enc
       85           , output p-out-string-dec
       86       ).
       87   end.
       88   end .
       89   procedure xmlchar-encode :
       90   define input parameter p-in-string      as character        no-undo.
       91   define output parameter p-out-string    as character        no-undo.
       92       define variable v-position      as integer      no-undo.
       93       define variable v-current-char  as character    no-undo.
       94   do
       95   on error undo, return error
       96   :
       97       assign
       98           p-out-string = "":U
       99       .
      100       case p-in-string
      101       :
      102           when ?
      103           then do:
      104               assign
      105                   p-out-string = "?":U
      106               .
      107           end.
      108           when "?":U
      109           then do:
      110               assign
      111                   p-out-string = "&#63;":U
      112               .
      113           end.
      114           otherwise do:
      115               do v-position = 1 to length( p-in-string )
      116               :
      117                   assign
      118                       v-current-char = substring( p-in-string, v-position, 1 )
      119                   .
      120                   case v-current-char
      121                   :
      122                       when "&":U
      123                       then do:
      124                           assign
      125                               p-out-string = p-out-string + "&amp;":U
      126                           .
      127                       end.
      128                       when ">":U
      129                       then do:
      130                           assign
      131                               p-out-string = p-out-string + "&gt;":U
      132                           .
      133                       end.
      134                       when "<":U
      135                       then do:
      136                           assign
      137                               p-out-string = p-out-string + "&lt;":U
      138                           .
      139                       end.
      140                       when "'":U
      141                       then do:
      142                           assign
      143                               p-out-string = p-out-string + "&apos;":U
      144                           .
      145                       end.
      146                       when '"':U
      147                       then do:
      148                           assign
      149                               p-out-string = p-out-string + "&quot;":U
      150                           .
      151                       end.
      152                       when chr(1)
      153                       then do:
      154                           assign
      155                               p-out-string = p-out-string + "":U
      156                           .
      157                       end.
      158                       when chr(2)
      159                       then do:
      160                           assign
      161                               p-out-string = p-out-string + "":U
      162                           .
      163                       end.
      164                       when chr(3)
      165                       then do:
      166                           assign
      167                               p-out-string = p-out-string + "":U
      168                           .
      169                       end.
      170                       when chr(4)
      171                       then do:
      172                           assign
      173                               p-out-string = p-out-string + "":U
      174                           .
      175                       end.
      176                       when chr(5)
      177                       then do:
      178                           assign
      179                               p-out-string = p-out-string + "":U
      180                           .
      181                       end.
      182                       when chr(6)
      183                       then do:
      184                           assign
      185                               p-out-string = p-out-string + "":U
      186                           .
      187                       end.
      188                       when chr(7)
      189                       then do:
      190                           assign
      191                               p-out-string = p-out-string + "":U
      192                           .
      193                       end.
      194                       when chr(8)
      195                       then do:
      196                           assign
      197                               p-out-string = p-out-string + "":U
      198                           .
      199                       end.
      200                       when chr(9)
      201                       then do:
      202                           assign
      203                               p-out-string = p-out-string + "":U
      204                           .
      205                       end.
      206                       when chr(29)
      207                       then do:
      208                           assign
      209                               p-out-string = p-out-string + "":U
      210                           .
      211                       end.
      212                       when chr(10)
      213                       then do:
      214                           assign
      215                               p-out-string = p-out-string + "&#10;":U
      216                           .
      217                       end.
      218                       when chr(13)
      219                       then do:
      220                           assign
      221                               p-out-string = p-out-string + "&#13;":U
      222                           .
      223                       end.
      224                       otherwise do:
      225                           assign
      226                               p-out-string = p-out-string + v-current-char
      227                           .
      228                       end.
      229                   end case.
      230               end.
      231           end.
      232       end case.
      233   end.
      234   end .
      235   procedure xmlchar-encode-1c :
      236   define input parameter p-in-string      as character        no-undo.
      237   define output parameter p-out-string    as character        no-undo.
      238       define variable v-position      as integer      no-undo.
      239       define variable v-current-char  as character    no-undo.
      240   do
      241   on error undo, return error
      242   :
      243       assign
      244           p-out-string = "":U
      245       .
      246       case p-in-string
      247       :
      248           when ?
      249           then do:
      250               assign
      251                   p-out-string = "?":U
      252               .
      253           end.
      254           otherwise do:
      255               do v-position = 1 to length( p-in-string )
      256               :
      257                   assign
      258                       v-current-char = substring( p-in-string, v-position, 1 )
      259                   .
      260                   case v-current-char
      261                   :
      262                       when chr(1)
      263                       then do:
      264                           assign
      265                               p-out-string = p-out-string + " ":U
      266                           .
      267                       end.
      268                       when chr(2)
      269                       then do:
      270                           assign
      271                               p-out-string = p-out-string + " ":U
      272                           .
      273                       end.
      274                       when chr(3)
      275                       then do:
      276                           assign
      277                               p-out-string = p-out-string + " ":U
      278                           .
      279                       end.
      280                       when chr(4)
      281                       then do:
      282                           assign
      283                               p-out-string = p-out-string + " ":U
      284                           .
      285                       end.
      286                       when chr(5)
      287                       then do:
      288                           assign
      289                               p-out-string = p-out-string + " ":U
      290                           .
      291                       end.
      292                       when chr(6)
      293                       then do:
      294                           assign
      295                               p-out-string = p-out-string + " ":U
      296                           .
      297                       end.
      298                       when chr(7)
      299                       then do:
      300                           assign
      301                               p-out-string = p-out-string + " ":U
      302                           .
      303                       end.
      304                       when chr(8)
      305                       then do:
      306                           assign
      307                               p-out-string = p-out-string + " ":U
      308                           .
      309                       end.
      310                       when chr(9)
      311                       then do:
      312                           assign
      313                               p-out-string = p-out-string + " ":U
      314                           .
      315                       end.
      316                       when chr(29)
      317                       then do:
      318                           assign
      319                               p-out-string = p-out-string + " ":U
      320                           .
      321                       end.
      322                       when chr(10)
      323                       then do:
      324                           assign
      325                               p-out-string = p-out-string + " ":U
      326                           .
      327                       end.
      328                       when chr(13)
      329                       then do:
      330                           assign
      331                               p-out-string = p-out-string + " ":U
