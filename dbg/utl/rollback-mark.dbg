      334                       otherwise do:
      335                           assign
      336                               p-out-string = p-out-string + v-current-char
      337                           .
      338                       end.
      339                   end case.
      340               end.
      341           end.
      342       end case.
      343   end.
      344   end .
      345   procedure xmlchar-decode :
      346   define input parameter p-in-string      as character        no-undo.
      347   define output parameter p-out-string    as character        no-undo.
      348       define variable v-position      as integer      no-undo.
      349       define variable v-last-position as integer      no-undo.
      350       define variable v-temp-integer  as integer      no-undo.
      351       define variable v-current-char  as character    no-undo.
      352       define variable v-next-char     as character    no-undo.
      353       define variable v-success       as logical      no-undo.
      354   do
      355   on error undo, return error
      356   :
      357       assign
      358           p-out-string = "":U
      359           v-position   = 0
      360       .
      361       replace-cycle:
      362       do while yes
      363       on error undo, return error
      364       :
      365           assign
      366               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      367           .
      368           if v-last-position <= v-position
      369           then do:
      370               if v-position = 0
      371               then do:
      372                   assign
      373                       p-out-string = p-in-string
      374                   .
      375               end.
      376               else do:
      377                   assign
      378                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      379                   .
      380               end.
      381               leave replace-cycle.
      382           end.
      383           else do:
      384               assign
      385                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      386                   v-position      = v-last-position
      387                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      388               .
      389               if v-current-char = "#":U
      390               then do:
      391                   assign
      392                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      393                   .
      394                   if v-last-position > 0
      395                   then do:
      396                       run xmlchar-read-integer in this-procedure
      397                        (
      398                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      399                           , output v-temp-integer
      400                           , output v-success
      401                       ).
      402                       if v-success = yes
      403                       and v-temp-integer >= 1
      404                       and v-temp-integer <= 255
      405                       then do:
      406                           assign
      407                               p-out-string = p-out-string + chr( v-temp-integer )
      408                               v-position   = v-last-position + 1
      409                           .
      410                       end.
      411                       else do:
      412                           assign
      413                               p-out-string = p-out-string + "&":U
      414                               v-position   = v-position   + 1
      415                           .
      416                       end.
      417                   end.
      418                   else do:
      419                       assign
      420                           p-out-string = p-out-string + "&":U
      421                           v-position   = v-position   + 1
      422                       .
      423                   end.
      424               end.
      425               else do:
      426                   case substring( p-in-string, v-position + 1, 3 )
      427                   :
      428                       when "lt;":U
      429                       then do:
      430                           assign
      431                               p-out-string = p-out-string + "<":U
      432                               v-position   = v-position   + 3
      433                           .
      434                       end.
      435                       when "gt;":U
      436                       then do:
      437                           assign
      438                               p-out-string = p-out-string + ">":U
      439                               v-position   = v-position   + 3
      440                           .
      441                       end.
      442                       otherwise do:
      443                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      444                           then do:
      445                               assign
      446                                   p-out-string = p-out-string + "&":U
      447                                   v-position   = v-position   + 4
      448                               .
      449                           end.
      450                           else do:
      451                               case substring( p-in-string, v-position + 1, 5 )
      452                               :
      453                                   when "quot;":U
      454                                   then do:
      455                                       assign
      456                                           p-out-string = p-out-string + '"':U
      457                                           v-position   = v-position   + 5
      458                                       .
      459                                   end.
      460                                   when "apos;":U
      461                                   then do:
      462                                       assign
      463                                           p-out-string = p-out-string + "'":U
      464                                           v-position   = v-position   + 5
      465                                       .
      466                                   end.
      467                                   otherwise do:
      468                                       assign
      469                                           p-out-string = p-out-string + "&":U
      470                                       .
      471                                   end.
      472                               end case.
      473                           end.
      474                       end.
      475                   end case.
      476               end.
      477           end.
      478       end.
      479   end.
      480   end .
      481   procedure xmlchar-read-integer :
      482   define input parameter p-input-string      as character        no-undo.
      483   define output parameter p-output-integer   as integer          no-undo.
      484   define output parameter p-success       as logical          no-undo.
      485   do
      486   on error undo, return error
      487   :
      488       assign
      489           p-output-integer = integer( p-input-string )
      490       no-error.
      491       if error-status :error
      492       then do:
      493           assign
      494               p-success           = no
      495               p-output-integer    = 0
      496           .
      497       end.
      498       else do:
      499           assign
      500               p-success           = yes
      501           .
      502       end.
      503   end.
      504   end.
      505   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      506   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      507   define new global shared variable g#attr-lib  as handle no-undo .
      508   define variable v-attr-lib-variable as handle no-undo .
      509   define variable mMRCCode  as logical    no-undo.
      510   define variable mTypeMark as character  no-undo.
      511   function IS-NeedMark returns logical
      512   ( input ib-code as integer  ,
      513     input ib-str as character ):
      514      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      515      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      516                                    and buf_prod-bc-attr.b-str  eq ib-str
      517                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      518        no-lock no-error.
      519      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      520   end.
      521   function repTegforDm return char
      522   (iDM as char ):
      523       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      524       define variable vteg as character no-undo.
      525       define variable oDM as character no-undo.
      526       define variable vi as integer no-undo.
      527       oDM = iDm.
      528       do vi = 1 to num-entries(vTeglist):
      529          vTeg = entry(vi,vTeglist).
      530          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      531       end.
      532       return oDM.
      533   end.
      534   function repSpecSimbforDm return char
      535   (iDM as char ):
      536       define variable oDM as character no-undo.
      537     run
      538       xmlchar-decode(iDM, output oDM).
      539     return repTegforDm (oDM).
      540   end.
      541   function CheckGtin return logical
      542   (iGtin as char):
      543      define variable bar_code as character no-undo.
      544      define variable vGtin as logical no-undo init "yes".
      545      if length(iGtin) eq 14
      546      then do:
      547         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      548         run str/chk-sum.p
      549          (input-output bar_code ) no-error .
      550         if iGtin ne  bar_code
      551         then
      552            vGtin = no.
      553      end.
      554      else
      555         vGtin = no.
      556      return vgtin.
      557   end.
      558   function repSpecSimbforXlm return char
      559   (iDM as char ):
      560       iDM = replace(iDM,chr(29),"").
      561       return iDM.
      562   end.
      563   function getGtinByDM return char
      564   (IDM as char):
      565      define variable VTXT as char no-undo.
      566      define variable vGtin as char no-undo.
      567      vTXt = IdM.
      568      vGtin = IDM.
      569      if    length(vtxt) > 14
      570      then do:
      571         if   vtxt begins "(01)"
      572                or vtxt begins "(02)"
      573         then
      574            vGtin = substring(vtxt,5,14).
      575         else if   (vtxt begins "01"
      576                or vtxt begins "02" )
      577                and (   (    substring(iDm,17,2) eq "21"
      578                         and length(vtxt) >= 21)
      579                     or substring(iDm,17,2) eq "37"
      580                     or substring(iDm,17,4) eq "(37)" )
      581         then do:
      582            vGtin = substring(vtxt,3,14).
      583            if not checkGtin(vGtin)
      584            then
      585               vGtin = substring(vtxt,1,14).
      586         end.
      587         else if     length(vtxt) eq 14 + 7 + 4 + 4
      588             or length(vtxt) eq 14 + 7 + 4
      589             or length(vtxt) eq 14 + 7
      590         then
      591            vGtin = substring(vtxt,1,14).
      592      end.
      593      if not checkGtin(vGtin)
      594      then
      595         vGtin = "".
      596      return vgtin.
      597   end.
      598   function getGdsCodeByGtin return int
      599   (iGtin as char):
      600      define buffer prod-bc  for ub.prod-bc.
      601      define buffer bar-code for ub.bar-code.
      602      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      603      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      604      return if avail bar-code then bar-code.gds-code else ?.
      605   end.
      606   function getQntyCodeByGtin return decimal
      607   (iGtin as char):
      608      define buffer prod-bc  for ub.prod-bc.
      609      define buffer bar-code for ub.bar-code.
      610      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      611      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      612      return if avail bar-code then bar-code.cli-base-rate else ?.
      613   end.
      614   function getGdsCodeByDM return int
      615   (iDm as char):
      616      define variable vGtin as char no-undo.
      617      define buffer prod-bc for ub.prod-bc.
      618      vGtin  = getGtinByDM (IDM ).
      619      return getGdsCodeByGtin (vGtin).
      620   end.
      621   function ChekTypeMarkByGds return logical
      622   (iGds-code as integer ):
      623      define buffer goods-attr for ub.goods-attr.
      624      find first goods-attr where goods-attr.gds-code   = iGds-code
      625                              and goods-attr.attr-code  = 'mark-type':U
      626      no-lock no-error.
      627      if available goods-attr
      628      then do:
      629         mTypeMark = goods-attr.attr-value.
      630         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      631           .
      632      end.
      633      else
      634         return no.
      635   end.
      636   function ChekTypeMarkByDm return logical
      637   (iDM as char ):
      638      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      639   end.
      640   function ChekTypeMarkByGtin return logical
      641   (iGtin as char ):
      642      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      643   end.
      644   function GetNextElement return character
      645     (input iAllTeg        as logical
      646     ,output oteg          as character
      647     ,output otegval       as character
      648     ,input-output pstr    as character
      649      ):
      650        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      651        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      652        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      653        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      654        define variable vTeg as character no-undo.
      655        define variable vLength as integer no-undo.
      656        define variable vi as integer no-undo.
      657        define variable vj as integer no-undo.
      658        define buffer code for ub.code.
      659        find first code where Code.parent eq "MarkType"
      660                          and Code.CodeValue   eq mTypeMark
      661                          no-lock no-error.
      662        if     available code
      663           and Code.misc1 ne ""
      664           and Code.misc1 ne ?
      665        then do:
      666           integer (Code.misc1) no-error.
      667           if not error-status:error
      668           then
      669             entry (4,vlistleng) = Code.misc1.
      670        end.
      671        if iAllTeg
      672        then
      673           assign
      674              vlistElem     = vlistElem    + vlistElemDop
      675              vlistleng     = vlistleng    + vlistlengDop
      676           .
      677        else if mMRCCode
      678        then
      679           assign
      680              vlistElem     = vlistElem    + ",(8005),8005"
      681              vlistleng     = vlistleng    + ",000006,0006"
      682           .
      683       block-elem:
      684       do vi = 1 to num-entries(vlistElem):
      685          vTeg = entry(vi,vlistElem).
      686          if pstr begins vTeg
      687          then do:
      688             if    vTeg eq "21"
      689             then
      690                vLength = index(pstr,chr(29)) - 2 no-error.
      691             if vLength  <= 0
      692             then
      693                vLength = int(entry(vi,vlistleng)).
      694             otegval = substring (pstr,length(vteg) + 1, vLength).
      695             oteg = replace(replace(vteg,")",""),"(","").
      696             vTeg = vteg + otegval.
      697             otegval = replace(otegval,chr(29),"").
      698             oteg = replace(replace(oteg,")",""),"(","").
      699             pstr = substring (pstr,length(vTeg)+ 1).
      700             vTeg = replace(vTeg,chr(29),"").
      701             leave block-elem.
      702          end.
      703          else
      704             vTeg = "".
      705       end.
      706       return vteg.
      707   end.
      708   function GetCodeIdent return character
      709   (iDm as char):
      710      define variable Velement   as character no-undo init "first".
      711      define variable oCodeIdent as character no-undo.
      712      define variable vteg as character no-undo.
      713      define variable vtegval as character no-undo.
      714      define variable vGtin as character no-undo.
      715      define buffer marking for ub.marking.
      716      for first marking no-lock where
      717                marking.mark eq iDm
      718            and marking.unit-ext = "LEVEL2"
      719      :
      720        return iDm.
      721      end.
      722      vGtin  = getGtinByDM (iDm ).
      723      ChekTypeMarkByDm(idm).
      724      if iDm begins 'tech_':U
      725      then
      726         oCodeIdent = iDm.
      727      else if length(iDm) < 21
      728      then do:
      729         find first marking where marking.mark eq idm
      730         no-lock no-error.
      731         oCodeIdent = if available marking then marking.mark else  ?.
      732      end.
      733      else if     length(iDm) eq 29
      734         and not iDm begins "01"
      735         and not iDm begins "02"
      736      then
      737         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      738      else  if     length(iDm) >= 24
      739               and (  iDm begins "01"
      740                   or iDm begins "02")
      741               and  substring(iDm,17,2) ne "21"
      742      then do:
      743         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      744                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      745         then
      746            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      747         else
      748            oCodeIdent = iDM.
      749      end.
      750      else  if     (   length(iDm) eq 25
      751                    or length(iDm) eq 21)
      752               and (not iDm begins "01"
      753               and  not iDm begins "02")
      754      then
      755         oCodeIdent = substring(iDm,1,21).
      756      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      757      then
      758         oCodeIdent = substring(iDm,1,21).
      759      else do while Velement ne "" and idm ne "":
      760         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      761         oCodeIdent = oCodeIdent + Velement.
      762      end.
      763      return oCodeIdent.
      764   end.
      765   function GetTegCod return character
      766   (icodeIdent as char, iTeg as char):
      767      define variable Velement   as character no-undo init "first".
      768      define variable oTeg as character no-undo init ?.
      769      define variable vteg as character no-undo.
      770      define variable vtegval as character no-undo.
      771      if     ((length(icodeIdent) eq 21
      772         and not icodeIdent begins "01"
      773         and not icodeIdent begins "02")
      774         or
      775             ( length(icodeIdent) eq 25
      776               and not icodeIdent begins "01"
      777               and not icodeIdent begins "02"))
      778      then do:
      779         if iTeg eq "01" or iTeg eq "02"
      780         then
      781            oTeg = substring(icodeIdent,1,21).
      782         else  if  iTeg eq "21"
      783         then
      784            oTeg = substring(icodeIdent,15,7).
      785      end.
      786      else do:
      787         ChekTypeMarkByDm(icodeIdent).
      788         block-teg:
      789            do while Velement ne "" and icodeIdent ne "":
      790            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      791            if    Velement begins iTeg
      792               or Velement begins "(" + iTeg + ")"
      793            then do:
      794               oTeg = vtegval.
      795               leave block-teg.
      796            end.
      797         end.
      798      end.
      799      return oTeg.
      800   end.
      801   function isOAD return logical
      802   (icodeIdent as character):
      803      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      804   end.
      805   function isMark return logical
      806   (icodeIdent as character):
      807      define buffer buf_marking for ub.marking.
      808      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      809             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      810   end.
      811   function addBracketForCode return character
      812   (icodeIdent as char):
      813      define variable Velement   as character no-undo init "first".
      814      define variable oTeg as character no-undo.
      815      define variable vteg as character no-undo.
      816      define variable vtegval as character no-undo.
      817      define buffer marking for ub.marking.
      818      find first marking no-lock where
      819                 marking.mark begins icodeIdent no-error.
      820      if    not ChekTypeMarkByDm(icodeIdent)
      821         or length(icodeIdent) le 24
      822         or (avail marking and marking.unit-ext = "LEVEL2")
      823      then
      824         oTeg = icodeIdent.
      825      else do:
      826         if (  icodeIdent begins "01"
      827            or icodeIdent begins "02"
      828            ) and CheckGtin(substring (icodeIdent,3,14))
      829            and substring (icodeIdent,17,2) eq "21"
      830         then do:
      831            mMRCCode = yes.
      832            ChekTypeMarkByDm(icodeIdent).
      833            block-teg:
      834            do while Velement ne "" and icodeIdent ne "":
      835               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      836               if vteg ne ""
      837               then
      838                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      839            end.
      840            mMRCCode = no.
      841         end.
      842         else do:
      843            oTeg = icodeIdent.
      844         end.
      845      end.
      846      return oTeg.
      847   end.
      848   function getlevelByCodId return int
      849   (iCode as char):
      850      define variable vLength as int no-undo.
      851      define variable vLevel  as int no-undo.
      852      if not ChekTypeMarkByDM (icode) then return ?.
      853      vLength = length(iCode).
      854      if    vLength eq 18
      855         or vLength eq 20
      856      then
      857         Vlevel = 4.
      858      else if vLength eq 21
      859      then
      860         Vlevel = 1.
      861      else if vLength eq 25
      862      then do:
      863         if  iCode begins "01"
      864         then
      865            Vlevel = 3.
      866         else
      867            Vlevel = 1.
      868      end.
      869      else if     vLength >= 26
      870              and vLength <= 46
      871      then do:
      872         if    substring(iCode,17,2) eq "11"
      873            or substring(iCode,17,2) eq "13"
      874            or (    substring(iCode,17,2) eq "21"
      875                and vLength >= 33
      876                and substring(iCode,26,4) ne "8005")
      877         then
      878            Vlevel = 4.
      879         else if    vLength eq 31
      880                 or vLength eq 38
      881                 or vLength eq 39
      882                 or vLength eq 45
      883         then
      884            Vlevel = 1.
      885         else if    vLength eq 35
      886                 or vLength eq 43
      887         then
      888            Vlevel = 3.
      889         else
      890            Vlevel = ?.
      891      end.
      892      else
      893         Vlevel = ?.
      894      return Vlevel.
      895   end.
      896   function getLevelMotpBycodid return character
      897   (iDm as char):
      898      define variable vLevel as integer no-undo.
      899      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      900      vLevel = getlevelByCodId(iDm).
      901      if    vLevel eq ?
      902         or vLevel < 1
      903         or vLevel > 6
      904      then
      905         return ?.
      906      else
      907         return entry(vlevel,vList).
      908   end.
      909   function getLevelUTDByLevelMotp return character
      910   (iUnit as char):
      911      define variable vLevel as integer no-undo.
      912      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      913      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      914      vLevel = lookup(iUnit,vListMOTP).
      915      if    vLevel eq ?
      916         or vLevel < 1
      917         or vLevel > 4
      918      then
      919         return ?.
      920      else
      921         return entry(vlevel,vListutd).
      922   end.
      923   function getLevelMotpByDM return character
      924   (iDm as char):
      925      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      926   end.
      927   function getLevelUTDByCodId return character
      928   (iDm as char):
      929      define variable vLevel as integer no-undo.
      930      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      931      vLevel = getlevelByCodId(iDm).
      932      if    vLevel eq ?
      933         or vLevel < 1
      934         or vLevel > 4
      935      then
      936         return ?.
      937      else
      938         return entry(vlevel,vList).
      939   end.
      940   function getLevelUTDByDM return character
      941   (iDm as char):
      942      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      943   end.
      944   define variable mNotMarkQnty as logical no-undo.
      945   function getQntyUTDByCodId return decimal
      946   (iDM as char):
      947      define variable vLevel as integer no-undo.
      948      define variable vList as character no-undo init "1,5,10,500".
      949      define variable vGtin as character no-undo.
      950      define variable vqnty as decimal no-undo init ?.
      951      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      952      if vqnty eq ?
      953      then do:
      954         if not mNotMarkQnty
      955         then do:
      956            define buffer marking for ub.marking.
      957            define variable vCodident as character no-undo.
      958            vCodident = GetCodeIdent(idm).
      959            find first marking where marking.mark begins vCodident no-lock no-error.
      960            if     available marking
      961               and marking.box-qnty ne ?
      962            then
      963               return marking.box-qnty.
      964         end.
      965         vGtin = getGtinByDm(iDM).
      966         if ChekTypeMarkByGtin (vGtin)
      967         then do:
      968            vLevel = getlevelByCodId(iDM).
      969            if     vLevel >= 1
      970               and vLevel <= 4
      971            then
      972               vqnty = int(entry(vlevel,vList)).
      973         end.
      974         else
      975            vqnty = getQntyCodeByGtin(vgtin).
      976      end.
      977      return vqnty.
      978   end.
      979   function getQntyUTDByDM return decimal
      980   (iDm as char):
      981      define variable vDM as character no-undo.
      982      if     length (iDm) ne 25
      983         and length (iDm) ne 29
      984         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      985      then
      986         vDM = substring (iDm,1,length (iDm) - 6 ).
      987      else
      988         vDM = substring (iDm,1,length (iDm) - 4 ).
      989      return getQntyUTDByCodId(vDM).
      990   end.
      991   function getMRC4 return decimal
      992   (iMRC as char):
      993      define variable oMrc     as decimal no-undo init ?.
      994      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      995      define variable vi       as integer no-undo.
      996      define variable vfound   as integer no-undo.
      997      define variable vposStart   as integer no-undo.
      998      do:
      999      OMRc = 0.
     1000      do vi = 1 to 4:
     1001         define variable vsimb as character no-undo.
     1002         vsimb = substring(iMRC,vi,1).
     1003         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1004         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1005         if vfound > 0
     1006         then
     1007            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1008         end.
     1009         OMRc = OMRc / 100.
     1010      end.
     1011      return OMRc.
     1012   end.
     1013   function getMRCByDM return decimal
     1014   (iDm as char):
     1015      define variable vMRC     as character no-undo.
     1016      define variable oMrc     as decimal no-undo init ?.
     1017      define variable Velement as character no-undo init "empty".
     1018      define variable vteg as character no-undo.
     1019      define variable vtegval as character no-undo.
     1020      if    length(idm) eq 14 + 7 + 4 + 4
     1021         or length(idm) eq 14 + 7 + 4
     1022      then do:
     1023         vMRC = substring(idm,22,4).
     1024         omrc = getMRC4(vMRC).
     1025      end.
     1026      else do:
     1027          ChekTypeMarkByDm(iDm).
     1028          block-mrc:
     1029          do while Velement ne "" and idm ne "":
     1030             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1031             if Velement begins "8005"
     1032             then do:
     1033                vMRC = substring(Velement,5,6).
     1034                leave block-mrc.
     1035             end.
     1036             else if Velement begins "(8005)"
     1037             then do:
     1038                vMRC = substring(Velement,7,6).
     1039                leave block-mrc.
     1040             end.
     1041          end.
     1042          if vMRC ne ""
     1043          then
     1044             OMRc = dec(vmrc) / 100 no-error.
     1045      end.
     1046      return OMRc.
     1047   end.
     1048   function MoveDate return Date
     1049   (idate as date,
     1050    iMonth as int64):
     1051      define variable vMonth   as int64 no-undo.
     1052      define variable vYear    as int64 no-undo.
     1053      define variable vDateNew as date  no-undo.
     1054       define variable vDay     as int64 no-undo.
     1055       vMonth = month(iDate) + iMonth.
     1056       vYear =  year(iDate).
     1057       if vMonth <= 0
     1058       then assign
     1059          vMonth = vMonth + 12
     1060           vYear  = vYear - 1
     1061       .
     1062       else if vMonth > 12
     1063       then assign
     1064          vMonth = vMonth - 12
     1065           vYear  = vYear + 1
     1066       .
     1067       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1068       do while error-status:error eq yes:
     1069          VDay = vDay + 1.
     1070          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1071       end.
     1072       if VDay > 0
     1073       then
     1074          vDateNew + 1.
     1075       return vDateNew.
     1076   end.
     1077   procedure checkEMRC:
     1078   define input  parameter iDm as character no-undo.
     1079   define output parameter vok as logical   no-undo init yes.
     1080      define variable v-value-emrc as character no-undo.
     1081      define variable v-type-emrc  as character no-undo.
     1082      define variable vDateIso     as character no-undo.
     1083      define variable vMRC         as decimal no-undo.
     1084      define variable vqnty        as decimal no-undo.
     1085      define variable vPrice       as decimal no-undo.
     1086      define variable vparent      as character no-undo.
     1087      define variable vgds-code    as integer no-undo.
     1088      define buffer code for ub.code.
     1089      vMRC = getMRCByDM(iDm).
     1090      if vMRC > 0
     1091      then do:
     1092         vgds-code = getGdsCodeByDM(iDm).
     1093         vqnty     = getQntyUTDByDM(iDm).
     1094               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1095            (
     1096             input   vgds-code
     1097            ,input   'emrc-type':U
     1098            ,output   v-value-emrc
     1099            ,output   v-type-emrc
     1100          ) no-error.
     1101          if     v-value-emrc ne ""
     1102             and v-value-emrc ne ?
     1103          then do:
     1104             vDateIso = iso-date(today).
     1105             vPrice = vMRC / vqnty.
     1106             vparent ="emc" + chr(4) + v-value-emrc.
     1107             find last code where Code.parent      eq vparent
     1108                              and Code.code        le vDateIso
     1109                              and code.status_  eq 0
     1110             no-lock no-error.
     1111             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1112             then
     1113                vOk = true .
     1114             else do:
     1115                 define variable vText      as character no-undo.
     1116                 define variable vDate      as date no-undo.
     1117                 define variable vDateLast  as character no-undo.
     1118                 define variable vDateFirst as character no-undo.
     1119                 define variable vDate3     as date no-undo.
     1120                 vdate = date(code.misc1).
     1121                 vDateLast = code.misc1.
     1122                 vDate3 = MoveDate(today, - 3 ).
     1123                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1124                                      string(vDate3  , "99/99/9999"),
     1125                                      string(vDate   , "99/99/9999")
     1126                                      ).
     1127                 vdateIso = iso-date(vdate3).
     1128                 find last code  where Code.parent      eq vparent
     1129                                   and Code.code        le vDateIso
     1130                                   and code.status_  eq 0 no-lock no-error.
     1131                 if available code
     1132                 then
     1133                    vDateIso = code.code.
     1134                 vDateFirst = vDateIso.
     1135                 vDateLast = iso-date(vdate).
     1136                 define variable vGood as logical no-undo.
     1137                 define variable vDateSale as date no-undo.
     1138                 define buffer bcode for code.
     1139                 for last code where Code.parent   eq vparent
     1140                                 and code.status_  eq 0
     1141                                 and code.code     < vDateLast
     1142                                 and code.code     >= vDateFirst
     1143                 no-lock:
     1144                    find first bcode where bCode.parent   eq vparent
     1145                                       and bcode.status_  eq 0
     1146                                       and bcode.code     > code.code no-lock no-error.
     1147                    if available bcode
     1148                    then do:
     1149                       if vPrice < dec(Code.CodeValue)
     1150                       then
     1151                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1152                                                     chr(10),
     1153                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1154                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1155                                                     ).
     1156                       else do:
     1157                          vGood = yes.
     1158                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1159                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1160                                                     chr(10),
     1161                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1162                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1163                                                     string(         vDateSale            ,"99/99/9999"),
     1164                                                     string(vDateSale - today)
     1165                                                     ).
     1166                       end.
     1167                    end.
     1168                 end.
     1169                 if vgood
     1170                 then do:
     1171                    define variable choice as integer no-undo .
     1172                    run gbl/d-askw.w (input "Уточнение"
     1173                           ,input  vText
     1174                           ,input "|"
     1175                           ,input "Принять|Вернуть"
     1176                           ,input "Принять данный товар|Вернуть товар постащику"
     1177                           ,input 1
     1178                           ,input 2
     1179                           ,output choice) no-error.
     1180                    vok = choice eq 1.
     1181                 end.
     1182                 else
     1183                    vok =false.
     1184             end.
     1185          end.
     1186      end.
     1187   end.
     1188   function addGs2Mark return character
     1189   (iMark as char):
     1190      define variable vDM   as character no-undo.
     1191      define variable vIdx  as integer   no-undo.
     1192      if index(iMark,chr(29),1) > 0
     1193      then return iMark.
     1194      if substring(iMark,26,4) = "8005" then
     1195      do:
     1196        vIdx = index(iMark,"93",26 + 4 + 5).
     1197        if vIdx > 1 then do:
     1198          vDM = substitute("&1&4&2&4&3",
     1199                           substring(iMark,1,25),
     1200                           substring(iMark,26,vIdx - 25 - 1),
     1201                           substring(iMark,vIdx),
     1202                           chr(29)) no-error.
     1203          vIdx = index(vDm,"240",vIdx + 4).
     1204          if vIdx > 0 then
     1205          do:
     1206            vDM = substitute("&1&3&2",
     1207                             substring(vDm,1,vIdx - 1),
     1208                             substring(vDm,vIdx),
     1209                             chr(29)) no-error.
     1210          end.
     1211        end.
     1212        else
     1213          vDM = substitute("&1&3&2",
     1214                           substring(iMark,1,25),
     1215                           substring(iMark,26),
     1216                           chr(29)) no-error.
     1217      end.
     1218      else if substring(iMark,32,2) = "91" then
     1219      do:
     1220        vIdx = index(iMark,"92",32).
     1221        if vIdx > 1 then
     1222          vDM = substitute("&1&4&2&4&3",
     1223                           substring(iMark,1,31),
     1224                           substring(iMark,32,vIdx - 31 - 1),
     1225                           substring(iMark,vIdx),
     1226                           chr(29)) no-error.
     1227        else
     1228          vDM = substitute("&1&3&2",
     1229                           substring(iMark,1,31),
     1230                           substring(iMark,32),
     1231                           chr(29)) no-error.
     1232      end.
     1233      else if substring(iMark,39,2) = "91" then
     1234      do:
     1235        vIdx = index(iMark,"92",38).
     1236        if vIdx > 1 then
     1237          vDM = substitute("&1&4&2&4&3",
     1238                           substring(iMark,1,38),
     1239                           substring(iMark,39,vIdx - 38 - 1),
     1240                           substring(iMark,vIdx),
     1241                           chr(29)) no-error.
     1242        else
     1243          vDM = substitute("&1&3&2",
     1244                           substring(iMark,1,38),
     1245                           substring(iMark,39),
     1246                           chr(29)) no-error.
     1247      end.
     1248      else if substring(iMark,25,2) = "93" then
     1249      do:
     1250        vIdx = index(iMark,"92",25).
     1251        if vIdx > 1 then
     1252          vDM = substitute("&1&4&2&4&3",
     1253                           substring(iMark,1,24),
     1254                           substring(iMark,25,vIdx - 24 - 1),
     1255                           substring(iMark,vIdx),
     1256                           chr(29)) no-error.
     1257        else
     1258          vIdx = index(iMark,"3103",25).
     1259          if vIdx > 0 then
     1260          vDM = substitute("&1&4&2&4&3",
     1261                           substring(iMark,1,24),
     1262                           substring(iMark,25,vIdx - 24 - 1),
     1263                           substring(iMark,vIdx),
     1264                           chr(29)) no-error.
     1265          else
     1266            vDM = substitute("&1&3&2",
     1267                             substring(iMark,1,24),
     1268                             substring(iMark,25),
     1269                             chr(29)) no-error.
     1270      end.
     1271      else if substring(iMark,32,2) = "93" then
     1272      do:
     1273        vDM = substitute("&1&3&2",
     1274              substring(iMark,1,31),
     1275              substring(iMark,32),
     1276              chr(29)) no-error.
     1277      end.
     1278      return if vDM <> "" then vDm else iMark.
     1279   end.
     1280   define buffer buf_marking-lines for ub.marking-lines .
     1281   define buffer buf_marking       for ub.marking .
     1282   define variable ungroup as logical   no-undo .
     1283   define variable v-marking as character no-undo .
     1284   define variable v-message as character no-undo .
     1285   define var      v-mark  as character no-undo .
     1286   def var Marking as class mark no-undo .
     1287   Marking = ObjSrv:Env:Marking:Sts:Mark .
     1288   run gbl/d-prompt.w (
     1289     'title=':u + "Ввод марок" + '\':u
     1290     + 'text1=':u + "Введите марку:" + '\':u
     1291     + 'format=' + "X(50)" + '\':u
     1292     + 'type=' + 'C':U + '\':u
     1293     + 'fillin_row=3\':u
     1294     + 'fillin_col=6\':u
     1295     + 'fillin_width=50\':u
     1296     + 'fillin_height=1\':u
     1297     + 'max-chars=50\':u
     1298     + 'readonly=no\':u
     1299     , input-output v-mark
     1300     ).
     1301   if v-mark = "" then
     1302   do:
     1303     message "По всем маркам запустить утилиту?"
     1304       view-as alert-box question buttons yes-no update ungroup.
     1305     if not ungroup then
     1306     do:
     1307     return .
     1308     end.
     1309   end.
     1310   if v-mark <> "" then do:
     1311   v-marking = GetCodeIdent(v-mark) .
     1312   end.
     1313       for each buf_marking exclusive-lock where buf_marking.sts = Marking:FreeZone:KeyIntDB and buf_marking.mark begins v-marking:
     1314       for each buf_marking-lines exclusive-lock where buf_marking-lines.mark begins v-marking and buf_marking-lines.out-code = 'free-zone':U:
     1315          run nws/cmd-del.p
     1316         ( input "marking-lines":U
     1317         ,input (buffer buf_marking-lines:handle)
     1318         ,input ""
     1319         ) no-error .
     1320      if error-status :error
     1321      then do:
     1322         assign
     1323            v-message = substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) )
     1324         .
     1325         return error v-message .
     1326      end.
     1327      delete buf_marking-lines .
     1328       end.
     1329       for each buf_marking-lines exclusive-lock where buf_marking-lines.mark begins v-marking and buf_marking-lines.out-code = 'out-zone':U:
     1330          run nws/cmd-del.p
     1331         ( input "marking-lines":U
     1332         ,input (buffer buf_marking-lines:handle)
     1333         ,input ""
     1334         ) no-error .
     1335      if error-status :error
     1336      then do:
     1337         assign
     1338            v-message = substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) )
     1339         .
     1340         return error v-message .
     1341      end.
     1342     delete buf_marking-lines .
     1343       end.
     1344       buf_marking.sts = Marking:Checked_:KeyIntDB .
     1345       end.
     1346       message "Утилита отработала"
     1347         view-as alert-box.
