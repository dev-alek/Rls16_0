        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input  parameter iKey     as integer no-undo.
       63   define output parameter oChekSum as character no-undo.
       64   if userid("ub") eq ""
       65   then do:
       66      oChekSum = encode(string(iKey * 13)) + string(index(encode(string(iKey)), "k"))
       67    .
       68      return.
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable mParent    as character no-undo.
       86   define variable mCodeValue as character no-undo.
       87   define buffer   buf_code for ub.code.
       88   define buffer   buf_code_parent for ub.code.
       89      mParent = substitute("Versions&1&2",chr(4),0).
       90      find first buf_code where
       91                 buf_code.parent = mParent
       92             and buf_code.code = "MarkType"
       93           no-lock no-error.
       94      if avail buf_code then
       95      do:
       96         mCodeValue = buf_code.codevalue.
       97         find first buf_code where
       98                    buf_code.parent = "Versions"
       99                and buf_code.code = string(g#db-num)
      100              no-error.
      101         if not avail buf_code then
      102         do:
      103            create buf_code.
      104            assign
      105               buf_code.parent    = "Versions"
      106               buf_code.code      = string(g#db-num)
      107               buf_code.CodeName  = substitute("Версии справочников на БД &1",g#db-num)
      108               buf_code.export_   = yes
      109               buf_code.status_   = 0
      110               buf_code.nwsubd    = yes
      111            .
      112            validate buf_code no-error.
      113            if error-status:error
      114              then return error error-status :get-message(1).
      115            run nws/cr-route.p (
      116               input 'send-tbl':U,
      117               input 'Code':U,
      118               input (buffer buf_code:handle),
      119               input "0" ) no-error.
      120            if error-status :error
      121              then return error error-status :get-message(1).
      122         end.
      123         mParent = substitute("Versions&1&2",chr(4),g#db-num).
      124         find first buf_code where
      125                    buf_code.parent = mParent
      126                and buf_code.code = "MarkType"
      127              no-error.
      128         if not avail buf_code then
      129         do:
      130            find first buf_code_parent where
      131                       buf_code_parent.parent = ""
      132                   and buf_code_parent.code = "MarkType"
      133                 no-error.
      134            create buf_code.
      135            assign
      136               buf_code.parent    = mParent
      137               buf_code.code      = "MarkType"
      138               buf_code.CodeName  = buf_code_parent.codename
      139               buf_code.export_   = yes
      140               buf_code.status_   = 0
      141               buf_code.nwsubd    = yes
      142            .
      143         end.
      144         if buf_code.codevalue <> mCodeValue then
      145         do:
      146            buf_code.codevalue = mCodeValue.
      147            validate buf_code no-error.
      148            if error-status:error
      149              then return error error-status :get-message(1).
      150            run nws/cr-route.p (
      151               input 'send-tbl':U,
      152               input 'Code':U,
      153               input (buffer buf_code:handle),
      154               input "0" ) no-error.
      155            if error-status :error
      156              then return error error-status :get-message(1).
      157         end.
      158      end.
      159   message "Успешно!" view-as alert-box.
