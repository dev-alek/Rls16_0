        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Запуск процедуры удаления неиспользуемых бар-кодов на признаки и партии".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     define variable v-cntxt-db-num        as integer   no-undo .
      115     define variable v-cntxt-userid        as character no-undo .
      116     define variable v-cntxt-level         as character no-undo .
      117     define variable v-cntxt-host-code-obj as integer   no-undo .
      118     define variable v-cntxt-obj-type      as character no-undo .
      119     define variable v-cntxt-obj-code      as integer   no-undo .
      120     define variable v-cntxt-db-num-obj    as integer   no-undo .
      121     define variable v-cntxt-is-admin      as logical   no-undo .
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define new shared temp-table gds-list no-undo like ub.goods
      124     field qnty   as decimal
      125     field to-del as logical
      126     field order-num as integer
      127     field to-sel as logical
      128     field promo-code as character
      129     field ActionId  as int64
      130     field db-num as integer
      131     index art  is primary unique artic prod-type prod-code
      132     index code is         unique gds-code
      133     index oi order-num
      134     index isel to-sel
      135     .
      136   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define  new shared  temp-table gds-list-hist no-undo
      138   field list-table as character
      139   field id as integer
      140   field line as integer
      141   field hist-mode as character
      142   field des as character
      143   field num-recs as integer
      144   field option_ as character
      145   field item_ as character
      146   field status_ as character
      147   field num-add as integer
      148   field num-ignored as integer
      149   field done as logical
      150   field err_ as logical
      151   field err-mes as character
      152   index pi is primary
      153   id
      154   line
      155   index isdone
      156   done
      157   .
      158   DEFINE BUTTON B-exit AUTO-GO
      159        LABEL "&Ввод"
      160        SIZE 10 BY 1
      161        BGCOLOR 8 .
      162   DEFINE BUTTON B-Help
      163        LABEL "Помо&щь"
      164        SIZE 10 BY 1
      165        BGCOLOR 8 .
      166   DEFINE BUTTON B-list
      167        LABEL "&Список"
      168        SIZE 10 BY 1.
      169   DEFINE BUTTON b-quit AUTO-END-KEY
      170        LABEL "&Отмена"
      171        SIZE 10 BY 1
      172        BGCOLOR 8 .
      173   DEFINE VARIABLE T-part AS LOGICAL INITIAL no
      174        LABEL "Удалять неиспользуемые бар-коды партий"
      175        VIEW-AS TOGGLE-BOX
      176        SIZE 51.25 BY 1 NO-UNDO.
      177   DEFINE VARIABLE T-prt AS LOGICAL INITIAL no
      178        LABEL "Удалять неиспользуемые бар-коды признаков"
      179        VIEW-AS TOGGLE-BOX
      180        SIZE 51.25 BY 1 NO-UNDO.
      181   DEFINE FRAME Dialog-Frame
      182        b-quit AT ROW 1 COL 1
      183        B-exit AT ROW 1 COL 11
      184        B-list AT ROW 1 COL 31
      185        B-Help AT ROW 1 COL 54.88
      186        T-prt AT ROW 2.79 COL 3.5
      187        T-part AT ROW 4.46 COL 2.88
      188        SPACE(11.61) SKIP(1.36)
      189       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      190            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      191            TITLE "Удаление неипользумых бар-кодов признаков и партий"
      192            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      193   ASSIGN
      194          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      195          FRAME Dialog-Frame:HIDDEN           = TRUE.
      196   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      197   DO:
      198     APPLY "END-ERROR":U TO SELF.
      199   END.
      200   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      201   DO:
      202   define variable loc#log as logical no-undo.
      203     assign
      204       T-part T-prt.
      205       if not T-part and not T-prt then do:
      206           message
      207           "Вы не выбрали ни одной опции"
      208           view-as alert-box ERROR.
      209           return no-apply.
      210       end.
      211       if not can-find(first gds-list no-lock) then do:
      212               message
      213           "Вы не выбрали ни одного товара"
      214           view-as alert-box ERROR.
      215           return no-apply.
      216       end.
      217       message
      218       "ВНИМАНИЕ!!!!" skip
      219       "Для всех выбранных Вами товаров будет запущена утилита распределенного (по всем БД) удаления" skip
      220       "неиспользуемых бар-кодов признаков И/ИЛИ партий" skip
      221        "Все БД будут опрошены на предмет возможности удаления бар-кодов для выбранных Вами товаров" skip
      222        "После получения положительного ответа на вопрос о возможности удаления бар-кодов от ВСЕХ БД" skip
      223        "Бар-коды будут удалены во всех БД" skip(2)
      224        "Продолжить?"
      225        view-as alert-box QUESTION buttons YES-NO update loc#log.
      226        if not loc#log then return no-apply.
      227      run utl/prtbcdel.p ( T-prt, T-part).
      228   END.
      229   ON CHOOSE OF B-list IN FRAME Dialog-Frame
      230   DO:
      231     run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
      232   END.
      233   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      234   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      235   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      236   on help of frame Dialog-Frame
      237   do:
      238     run gbl/app_help.p
      239       (input this-procedure :file-name
      240       ,input ''
      241       ,input ?
      242       ) no-error.
      243     if error-status :error then do:
      244       message
      245         "Ошибка при вызове помощи"
      246         error-status :get-message(1)
      247         view-as alert-box .
      248     end.
      249   end.
      250   run minbtn-set in this-procedure .
      251   on choose of b-help in frame Dialog-Frame
      252   do:
      253     apply "help":u to frame Dialog-Frame .
      254   end.
      255   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   procedure minbtn-set :
      257       do
      258           on error undo, return error return-value
      259           :
      260           define variable ii              as integer       no-undo .
      261           define variable fh              as widget-handle no-undo .
      262           define variable hh              as widget-handle no-undo .
      263           define variable v-h             as handle        extent 4 no-undo .
      264           define variable v-name-button   as character     no-undo .
      265           define variable v-help-old-x    as decimal       no-undo .
      266           define variable v-help-old-y    as decimal       no-undo .
      267           define variable v-help-old-size as decimal       no-undo .
      268           define variable v-frame-width   as decimal       no-undo .
      269           define variable jj              as integer       no-undo .
      270           do
      271               on error undo, return error
      272               :
      273               assign
      274                   v-frame-width = frame Dialog-Frame:width - 0.3
      275                   fh            = frame Dialog-Frame:first-child
      276                   hh            = fh:first-child
      277                   ii            = 1
      278                   .
      279               do while valid-handle(hh):
      280                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      281                   do:
      282                       case lc(hh:name) :
      283                           when "b-help" then
      284                               do:
      285                                   hh:load-image-up("cmp/b-help.bmp":u) .
      286                                   hh:load-image-down("cmp/b-help.bmp":u) .
      287                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      288                                   hh:TOOLTIP = "Помощь" .
      289                                   v-help-old-x = hh:column .
      290                                   v-help-old-y = hh:row    .
      291                                   v-help-old-size = hh:width .
      292                                   hh:width-chars = 2.5 .
      293                               end.
      294                           when "b-print" then
      295                               do:
      296                                   hh:load-image("cmp/b-print.bmp":u) .
      297                                   hh:TOOLTIP = "Печать" .
      298                                   v-h[ii] = hh:handle .
      299                                   ii = ii + 1 .
      300                                   hh:width-chars = 3 .
      301                               end.
      302                           when "b-history" or
      303                           when "b-hist" then
      304                               do:
      305                                   hh:load-image("cmp/b-hist.bmp":u) .
      306                                   hh:TOOLTIP = "История" .
      307                                   v-h[ii] = hh:handle .
      308                                   ii = ii + 1 .
      309                                   hh:width-chars = 3 .
      310                               end.
      311                           when "b-sch" then
      312                               do:
      313                                   hh:load-image("cmp/b-sch.bmp":u) .
      314                                   hh:TOOLTIP = "Установка Фильтра" .
      315                                   v-h[ii] = hh:handle .
      316                                   ii = ii + 1 .
      317                                   hh:width-chars = 3 .
      318                               end.
      319                           when "b-hist-user" then
      320                               do:
      321                                   hh:load-image("cmp/b-hist.bmp":u) .
      322                                   hh:TOOLTIP = "История пользователя" .
      323                                   ii = ii + 1 .
      324                               end.
      325                       end case.
      326                   end.
      327                   hh = hh:next-sibling.
      328               end.
      329               b-help:column = v-frame-width - b-help:width-chars.
      330               jj = 0.
      331               repeat ii = 4 to 1 by -1 :
      332                   if valid-handle (v-h[ii] ) then
      333                   do:
      334                       jj  = jj + 1 .
      335                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      336                       v-h[ii]:row    = v-help-old-y .
      337                   end.
      338               end.
      339           end.
      340       end.
      341   end procedure.
      342   MAIN-BLOCK:
      343   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      344      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      345   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346     run mainmenu_getcntxt in parparentproc
      347       (output v-cntxt-db-num
      348       ,output v-cntxt-userid
      349       ,output v-cntxt-level
      350       ,output v-cntxt-host-code-obj
      351       ,output v-cntxt-obj-type
      352       ,output v-cntxt-obj-code
      353       ,output v-cntxt-db-num-obj
      354       ,output v-cntxt-is-admin
      355       ) .
      356     RUN enable_UI.
      357     WAIT-FOR GO OF FRAME Dialog-Frame.
      358   END.
      359   RUN disable_UI.
      360   PROCEDURE disable_UI :
      361     HIDE FRAME Dialog-Frame.
      362   END PROCEDURE.
      363   PROCEDURE enable_UI :
      364     DISPLAY T-prt T-part
      365         WITH FRAME Dialog-Frame.
      366     ENABLE b-quit B-exit B-list B-Help T-prt T-part
      367         WITH FRAME Dialog-Frame.
      368     VIEW FRAME Dialog-Frame.
      369   END PROCEDURE.
