     7978           then do:
     7979             if error-status :get-message(1) <> ""
     7980             then do:
     7981               message
     7982                 vss-workfile vss-revision vss-description skip
     7983                 "Невозможно зарезервировать товар по признакам" skip
     7984                 "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     7985                 "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     7986                 error-status :get-message(1) skip
     7987                 return-value skip
     7988                 view-as alert-box .
     7989             end.
     7990             undo, return error .
     7991           end.
     7992           for each tt-marks where tt-marks.rowid-part = tt-parts-marks.rowid-part:
     7993             excisemarksObj:RestoreMarkToFreeZone(buffer buf_parts, tt-marks.exciseMark).
     7994           end.
     7995         end.
     7996         for each buf_doc-line where
     7997           buf_doc-line.doc-code = new_trn-doc.doc-code:
     7998           for each buf_parts_free where
     7999                 buf_parts_free.obj-type = buf_doc-line.obj-type
     8000             and buf_parts_free.obj-code = buf_doc-line.obj-code
     8001             and buf_parts_free.artic = buf_doc-line.artic
     8002             and buf_parts_free.prod-type = buf_doc-line.prod-type
     8003             and buf_parts_free.prod-code = buf_doc-line.prod-code
     8004             and buf_parts_free.out-code = 'free-zone':U:
     8005             excisemarksObj:keyRecObj:GenKeyRec ("parts", buffer buf_parts_free:handle, output key-rec-parts).
     8006             find first tt-parts-marks where tt-parts-marks.rowid-part = rowid (buf_parts_free) no-error.
     8007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     8008     (input  tt-parts-marks.gds-code
     8009     ,input  'serial=request':u
     8010     ,output v-goods-serial
     8011     ) no-error .
     8012   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     8013     (input  tt-parts-marks.gds-code
     8014     ,input  'twounit=request':u
     8015     ,output v-goods-twounit
     8016     ) no-error .
     8017             run partrsrv in this-procedure
     8018               (input  if available (tt-parts-marks) then tt-parts-marks.qnty - buf_parts_free.qnty else - buf_parts_free.qnty
     8019               ,input  v-goods-serial
     8020               ,input  v-goods-twounit
     8021               ,input  false
     8022               ,buffer buf_parts_free
     8023               ,buffer new_trn-doc
     8024               ,output v-real-chg-qnty
     8025               ,output v-parts-recid
     8026               ) no-error .
     8027             if error-status :error
     8028               then
     8029             do:
     8030               message
     8031                 vss-workfile vss-revision vss-description skip
     8032                 "Ошибка при резервировании партии" skip
     8033                 error-status :get-message(1) skip
     8034                 return-value skip
     8035                 view-as alert-box error .
     8036               undo, return error .
     8037             end.
     8038             if available (buf_parts_free)
     8039             then do:
     8040   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitqnty in g#library
     8042     (input buf_goods.unit-base
     8043     ,input buf_parts_free.artic
     8044     ,input buf_parts_free.prod-type
     8045     ,input buf_parts_free.prod-code
     8046     ,input ''
     8047     ,input buf_parts_free.fact-qnty
     8048     ) no-error .
     8049               if error-status :error
     8050                 then
     8051               do:
     8052                 message
     8053                   "Не прошел контроль количества товара" skip
     8054                   "Попробуйте ввести другое количество" skip
     8055                   view-as alert-box information .
     8056                 undo, return error .
     8057               end.
     8058             end.
     8059             run trg/rsrv-gds.p
     8060               (input parparentproc
     8061               ,buffer buf_doc-line
     8062               ,input v-real-chg-qnty
     8063               ,input 0
     8064               ,input table temp-trndocrs-gds-dtl-rsrv
     8065               ,input table temp-trndocrs-pl-gds-rsrv
     8066               ) no-error.
     8067             if error-status :error
     8068             then do:
     8069               if error-status :get-message(1) <> ""
     8070               then do:
     8071                 message
     8072                   vss-workfile vss-revision vss-description skip
     8073                   "Невозможно зарезервировать товар по признакам" skip
     8074                   "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     8075                   "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8076                   error-status :get-message(1) skip
     8077                   return-value skip
     8078                   view-as alert-box .
     8079               end.
     8080               undo, return error .
     8081             end.
     8082             excisemarksObj:GetTableMarksForParts(key-rec-parts, input-output table tt-marks-forParts).
     8083             if excisemarksObj:StatusErr
     8084               then
     8085             do:
     8086               v-end-message = substitute(" Ошибка &1", excisemarksObj:ReturnMsg ) .
     8087               run pcall-log-file in p-log-handle ( input v-end-message ) .
     8088               undo, return error v-end-message.
     8089             end.
     8090             for each tt-marks-forParts :
     8091               find first tt-marks where tt-marks.isCurr and tt-marks.exciseMark = tt-marks-forParts.exciseMark no-lock no-error.
     8092               if available (tt-marks)
     8093                 then next.
     8094               excisemarksObj:RemoveMarkFromFreeZoneToInvMinus(key-rec-parts, tt-marks-forParts.exciseMark, new_trn-doc.doc-code).
     8095               if excisemarksObj:StatusErr
     8096                 then
     8097               do:
     8098                 v-end-message = substitute(" Ошибка &1", excisemarksObj:ReturnMsg ) .
     8099                 run pcall-log-file in p-log-handle ( input v-end-message ) .
     8100                 undo, return error v-end-message.
     8101               end.
     8102             end.
     8103           end.
     8104         end.
     8105         for each tt-marks where tt-marks.rowid-part = ?:
     8106           excisemarksObj:CrMarkForInvDoc(buffer new_trn-doc, string (tt-marks.gds-code) + "," + tt-marks.exciseMark ).
     8107           if excisemarksObj:StatusErr
     8108             then
     8109           do:
     8110             v-end-message = substitute(" Ошибка &1", excisemarksObj:ReturnMsg ) .
     8111             run pcall-log-file in p-log-handle ( input v-end-message ) .
     8112             undo, return error v-end-message.
     8113           end.
     8114         end.
     8115         run gbl/calc-trn.p (  this-procedure , recid(new_trn-doc)) no-error .
     8116         if error-status :error then
     8117         do:
     8118           v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     8119           run pcall-log-file in p-log-handle ( input v-end-message ) .
     8120           undo, return error v-end-message.
     8121         end.
     8122       end.
     8123     end case.
     8124      assign
     8125           v-end-message =  string(temp_trn-doc.obj-type) + string(temp_trn-doc.obj-code)
     8126                       + chr(9) + "Документ инвентаризации:" + string(new_trn-doc.doc-code) + " / " + string(temp_trn-doc.doc-code) + chr(9) + string( k ) + " товаров" + chr(10)
     8127                       .
     8128        run pcall-log-file in p-log-handle (input v-end-message) .
     8129        p-ok-doc = p-ok-doc + 1.
     8130   end.
     8131   end.
     8132   procedure clos-trn2 :
     8133   define input parameter p-trn-code as character no-undo .
     8134     do
     8135       on error undo, return error return-value
     8136       :
     8137       define buffer buf_s-trn-doc for ub.trn-doc.
     8138       define variable varmode         as character no-undo.
     8139       define variable varstatus       like ub.trn-doc.status_ no-undo.
     8140       define variable varflag         like ub.trn-doc.flag no-undo.
     8141       define variable varcopystatus   like ub.trn-doc.status_ no-undo.
     8142       define variable varcopyflag     like ub.trn-doc.flag no-undo.
     8143       define variable varcheck-return as logical   no-undo .
     8144       define variable varchg-inv      as logical   no-undo .
     8145       run str/trn-stat.p (
     8146         input  parparentproc ,
     8147         input  this-procedure ,
     8148         input  '<закрытие документа>':U ,
     8149         input  p-trn-code,
     8150         input  false  ,
     8151         input  v-cntxt-db-num,
     8152         input  false ,
     8153         input  v-cntxt-rsrv-time,
     8154         input  v-cntxt-load-time,
     8155         input  v-cntxt-holidays,
     8156         input  false ,
     8157         output varchg-inv ,
     8158         output table gds-list)
     8159         no-error.
     8160       if error-status:error then
     8161       do :
     8162         v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     8163         run pcall-log-file in p-log-handle ( input v-end-message ) .
     8164         undo, return error v-end-message.
     8165       end.
     8166       if is-tsd then
     8167       do:
     8168         run str/trn-stat.p (
     8169           input  parparentproc ,
     8170           input  this-procedure ,
     8171           input  '<закрытие документа>':U ,
     8172           input  p-trn-code,
     8173           input  false  ,
     8174           input  v-cntxt-db-num,
     8175           input  false ,
     8176           input  v-cntxt-rsrv-time,
     8177           input  v-cntxt-load-time,
     8178           input  v-cntxt-holidays,
     8179           input  false ,
     8180           output varchg-inv ,
     8181           output table gds-list)
     8182           no-error.
     8183         if error-status:error then
     8184         do :
     8185           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     8186           run pcall-log-file in p-log-handle ( input v-end-message ) .
     8187           undo, return error v-end-message.
     8188         end.
     8189       end.
     8190     end.
     8191   end procedure.
     8192   procedure mainmenu_getcntxt :
     8193   define output parameter p-cntxt-db-num                as integer   no-undo .
     8194   define output parameter p-cntxt-userid                as character no-undo .
     8195   define output parameter p-cntxt-level                 as character no-undo .
     8196   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
     8197   define output parameter p-cntxt-obj-type              as character no-undo .
     8198   define output parameter p-cntxt-obj-code              as integer   no-undo .
     8199   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
     8200   define output parameter p-cntxt-is-admin              as logical   no-undo .
     8201     do
     8202     on error undo, return error return-value
     8203     :
     8204   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     8206     (input  vt-obj-type
     8207     ,input  vt-obj-code
     8208     ,output p-cntxt-db-num-obj
     8209     )  .
     8210     assign
     8211       p-cntxt-db-num          =  v-cntxt-db-num
     8212       p-cntxt-userid          =  v-cntxt-userid
     8213       p-cntxt-level           =  v-cntxt-level
     8214       p-cntxt-host-code-obj   =  vt-host-code
     8215       p-cntxt-obj-type        =  vt-obj-type
     8216       p-cntxt-obj-code        =  vt-obj-code
     8217       p-cntxt-is-admin        =  v-cntxt-is-admin
     8218     .
     8219     end.
     8220    end procedure.
     8221    procedure get-report-num :
     8222     define output parameter p-report-num as integer no-undo .
     8223      do
     8224      on error undo, return error return-value
     8225      :
     8226       assign
     8227         p-report-num = 1
     8228       .
     8229      end.
     8230    end procedure.
     8231   procedure clear-tt :
     8232     do
     8233     on error undo, return error return-value
     8234     :
     8235      for each tt-trn-doc:
     8236       delete tt-trn-doc.
     8237      end.
     8238       for each tt2-doc-line :
     8239           delete tt2-doc-line .
     8240       end.
     8241       for each tt-doc-line :
     8242           delete tt-doc-line .
     8243       end.
     8244       for each tt-gds-dtl :
     8245           delete tt-gds-dtl .
     8246       end.
     8247       for each tt-parts:
     8248           delete tt-parts .
     8249       end.
     8250       for each lib-trn_ret-doc :
     8251         delete lib-trn_ret-doc.
     8252       end.
     8253       for each lib-trn_ret-line :
     8254         delete lib-trn_ret-line      .
     8255       end.
     8256       for each lib-trn_ret-line-attr :
     8257         delete lib-trn_ret-line.
     8258       end.
     8259       for each lib-trn_ret-dtl :
     8260         delete lib-trn_ret-dtl.
     8261       end.
     8262       for each lib-trn_ret-parts :
     8263         delete lib-trn_ret-parts .
     8264       end.
     8265    end.
     8266   end procedure.
     8267   procedure add-nn :
     8268   define input  parameter p-doc-code as character no-undo .
     8269   define input  parameter p-doc-out as character no-undo .
     8270   define input  parameter p-date-inv as character no-undo .
     8271     do
     8272     on error undo, return error return-value
     8273     :
     8274     find first ub.doc-attr exclusive-lock where
     8275              ub.doc-attr.doc-code = p-doc-code and
     8276              ub.doc-attr.attr-code = 'nids':U no-error .
     8277     if not available ub.doc-attr then create ub.doc-attr.
     8278     assign
     8279       ub.doc-attr.doc-code = p-doc-code
     8280       ub.doc-attr.attr-code = 'nids':U
     8281       ub.doc-attr.attr-value = if is-tsd then "tsd," + p-doc-out else p-doc-out
     8282     .
     8283     find first ub.doc-attr exclusive-lock where
     8284                ub.doc-attr.doc-code = p-doc-code and
     8285                ub.doc-attr.attr-code = 'dateinv':U no-error .
     8286     if not available ub.doc-attr then create ub.doc-attr.
     8287     assign
     8288       ub.doc-attr.doc-code = p-doc-code
     8289       ub.doc-attr.attr-code = 'dateinv':U
     8290       ub.doc-attr.attr-value =  p-date-inv
     8291     .
     8292     end.
     8293   end procedure.
     8294   procedure add-nn1 :
     8295   define input  parameter p-doc-code as character no-undo .
     8296     do
     8297     on error undo, return error return-value
     8298     :
     8299     find first ub.doc-attr exclusive-lock where
     8300                ub.doc-attr.doc-code = p-doc-code and
     8301                ub.doc-attr.attr-code = 'clcasol':U no-error .
     8302     if not available ub.doc-attr then create ub.doc-attr.
     8303     assign
     8304       ub.doc-attr.doc-code = p-doc-code
     8305       ub.doc-attr.attr-code = 'clcasol':U
     8306       ub.doc-attr.attr-value =  "yes"
     8307     .
     8308     end.
     8309   end procedure.
