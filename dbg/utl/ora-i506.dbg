     2013     field rsrv-qnty        like ub.pl-gds.free-qnty
     2014     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
     2015     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
     2016     field before-free-qnty like ub.pl-gds.fact-qnty
     2017     field before-out-qnty  like ub.pl-gds.fact-qnty
     2018     field after-free-qnty  like ub.pl-gds.fact-qnty
     2019     field after-out-qnty   like ub.pl-gds.fact-qnty
     2020     field fact-qnty        like ub.pl-gds.fact-qnty
     2021     field cli-qnty         like ub.pl-gds.cli-qnty
     2022     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
     2023     index xpk is primary unique pl-code
     2024   .
     2025   procedure trndocrs-gds-dtl-clear :
     2026     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     2027     do
     2028     on error undo, return error return-value
     2029     :
     2030       for each buf_temp-trndocrs-gds-dtl-rsrv
     2031       on error undo, return error return-value
     2032       :
     2033         delete buf_temp-trndocrs-gds-dtl-rsrv .
     2034       end.
     2035     end.
     2036   end procedure.
     2037   procedure trndocrs-pl-gds-clear :
     2038     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     2039     do
     2040     on error undo, return error return-value
     2041     :
     2042       for each buf_temp-trndocrs-pl-gds-rsrv
     2043       on error undo, return error return-value
     2044       :
     2045         delete buf_temp-trndocrs-pl-gds-rsrv .
     2046       end.
     2047     end.
     2048   end procedure.
     2049   procedure trndocrs-clear :
     2050     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     2051     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     2052     do
     2053     on error undo, return error return-value
     2054     :
     2055       for each buf_temp-trndocrs-gds-dtl-rsrv
     2056       on error undo, return error return-value
     2057       :
     2058         delete buf_temp-trndocrs-gds-dtl-rsrv .
     2059       end.
     2060       for each buf_temp-trndocrs-pl-gds-rsrv
     2061       on error undo, return error return-value
     2062       :
     2063         delete buf_temp-trndocrs-pl-gds-rsrv .
     2064       end.
     2065     end.
     2066   end procedure.
     2067   procedure trndocrs-pl-gds-accum :
     2068     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
     2069     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
     2070     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
     2071     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
     2072     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
     2073     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     2074     do
     2075     on error undo, return error return-value
     2076     :
     2077       find first buf_temp-trndocrs-pl-gds-rsrv
     2078         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
     2079         no-error .
     2080       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
     2081         create buf_temp-trndocrs-pl-gds-rsrv .
     2082         assign
     2083           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
     2084         .
     2085       end.
     2086       assign
     2087         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
     2088         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
     2089         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
     2090         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
     2091       .
     2092     end.
     2093   end procedure.
     2094   procedure trndocrs-gds-dtl-accum :
     2095     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
     2096     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
     2097     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
     2098     do
     2099     on error undo, return error return-value
     2100     :
     2101       find first buf_temp-trndocrs-gds-dtl-rsrv
     2102         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
     2103         no-error .
     2104       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
     2105         create buf_temp-trndocrs-gds-dtl-rsrv .
     2106         assign
     2107           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
     2108         .
     2109       end.
     2110       assign
     2111         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     2112                                                + p-rsrv-qnty
     2113       .
     2114     end.
     2115   end procedure.
     2116   procedure trndocrs-pl-gds-request :
     2117     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
     2118     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
     2119     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
     2120     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
     2121     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
     2122     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
     2123     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
     2124     define input parameter p-field-accum            as character no-undo .
     2125     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
     2126     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     2127     do
     2128     on error undo, return error return-value
     2129     :
     2130       if lookup(p-field-accum, "before,after":u ) = 0 then do:
     2131         message
     2132           vss-workfile vss-revision vss-description skip
     2133           vss-include-info17 skip
     2134           "Ошибка задания входных параметров параметров" skip
     2135           "Неизвестное значение параметра" skip
     2136           "p-field-accum" p-field-accum skip
     2137           view-as alert-box error .
     2138         undo, return error return-value .
     2139       end.
     2140       case p-field-accum :
     2141         when "before":u then do:
     2142           for each buf_temp-trndocrs-pl-gds-rsrv
     2143           on error undo, return error return-value
     2144           :
     2145             assign
     2146               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
     2147               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
     2148             .
     2149           end.
     2150         end.
     2151         when "after":u then do:
     2152           for each buf_temp-trndocrs-pl-gds-rsrv
     2153           on error undo, return error return-value
     2154           :
     2155             assign
     2156               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
     2157               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
     2158             .
     2159           end.
     2160         end.
     2161         otherwise do:
     2162           message
     2163             vss-workfile vss-revision vss-description skip
     2164             vss-include-info17 skip
     2165             "Ошибка задания входных параметров параметров" skip
     2166             "Неизвестное значение параметра" skip
     2167             "p-field-accum" p-field-accum skip
     2168             view-as alert-box error .
     2169           undo, return error return-value .
     2170         end.
     2171       end.
     2172       define buffer buf_parts for ub.parts.
     2173       for each buf_parts no-lock
     2174         where buf_parts.out-code  = p-doc-code
     2175           and buf_parts.obj-type  = p-obj-type
     2176           and buf_parts.obj-code  = p-obj-code
     2177           and buf_parts.artic     = p-artic
     2178           and buf_parts.prod-type = p-prod-type
     2179           and buf_parts.prod-code = p-prod-code
     2180       on error undo, return error return-value
     2181       :
     2182         find first buf_temp-trndocrs-pl-gds-rsrv
     2183           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
     2184           no-error .
     2185         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
     2186           create buf_temp-trndocrs-pl-gds-rsrv .
     2187           assign
     2188             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
     2189           .
     2190         end.
     2191         if can-do('при,рас,спи':U, p-doc-type)
     2192         or (p-doc-type = 'инв':U
     2193             and buf_parts.fact-qnty < 0)
     2194         then do:
     2195           case p-field-accum :
     2196             when "before":u then do:
     2197               assign
     2198                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     2199                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     2200                   + abs(buf_parts.fact-qnty)
     2201               .
     2202             end.
     2203             when "after":u then do:
     2204               assign
     2205                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     2206                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     2207                   + abs(buf_parts.fact-qnty)
     2208               .
     2209             end.
     2210             otherwise do:
     2211               message
     2212                 vss-workfile vss-revision vss-description skip
     2213                 vss-include-info17 skip
     2214                 "Ошибка задания входных параметров параметров" skip
     2215                 "Неизвестное значение параметра" skip
     2216                 "p-field-accum" p-field-accum skip
     2217                 view-as alert-box error .
     2218               undo, return error return-value .
     2219             end.
     2220           end.
     2221         end.
     2222         else do:
     2223           case p-field-accum :
     2224             when "before":u then do:
     2225               assign
     2226                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     2227                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     2228                   + abs(buf_parts.fact-qnty)
     2229               .
     2230             end.
     2231             when "after":u then do:
     2232               assign
     2233                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     2234                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     2235                   + abs(buf_parts.fact-qnty)
     2236               .
     2237             end.
     2238             otherwise do:
     2239               message
     2240                 vss-workfile vss-revision vss-description skip
     2241                 vss-include-info17 skip
     2242                 "Ошибка задания входных параметров параметров" skip
     2243                 "Неизвестное значение параметра" skip
     2244                 "p-field-accum" p-field-accum skip
     2245                 view-as alert-box error .
     2246               undo, return error return-value .
     2247             end.
     2248           end.
     2249         end.
     2250       end.
     2251     end.
     2252   end procedure.
     2253   procedure trndocrs-pl-gds-calc-rsrv :
     2254     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
     2255     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     2256     do
     2257     on error undo, return error return-value
     2258     :
     2259       for each buf_temp-trndocrs-pl-gds-rsrv
     2260       on error undo, return error return-value
     2261       :
     2262         assign
     2263           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     2264             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     2265             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     2266           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
     2267             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     2268             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     2269         .
     2270       end.
     2271     end.
     2272   end procedure.
     2273   procedure trndocrs-need-rsrv :
     2274     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
     2275     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
     2276     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
     2277     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
     2278     define output parameter p-need-rsrv    as logical   no-undo .
     2279     define buffer buf_goods   for ub.goods .
     2280     do
     2281     on error undo, return error return-value
     2282     :
     2283       find first buf_goods no-lock
     2284         where buf_goods.artic     = p-artic
     2285           and buf_goods.prod-type = p-prod-type
     2286           and buf_goods.prod-code = p-prod-code
     2287         .
     2288       if buf_goods.gds-type = 'т':U
     2289       and ( p-doc-type = 'рас':U
     2290             or p-doc-type = 'спи':U
     2291           )
     2292       then do:
     2293         assign
     2294           p-need-rsrv = true
     2295         .
     2296       end.
     2297       else do:
     2298         assign
     2299           p-need-rsrv = false
     2300         .
     2301       end.
     2302     end.
     2303   end procedure.
     2304   procedure trndocrs-need-create-doc-pl :
     2305     define input  parameter p-extended-doc-type  as character no-undo .
     2306     define input  parameter p-news               as logical   no-undo .
     2307     define input  parameter p-sale-auto          as logical   no-undo .
     2308     define output parameter p-need-create-doc-pl as logical   no-undo .
     2309     do
     2310     on error undo, return error return-value
     2311     :
     2312       if  not p-news
     2313       and p-extended-doc-type <> 'ie':U
     2314       and p-extended-doc-type <> 'es':U
     2315       and p-extended-doc-type <> 'rs':U
     2316       and not p-sale-auto
     2317       then do:
     2318         assign
     2319           p-need-create-doc-pl = true
     2320         .
     2321       end.
     2322       else do:
     2323         assign
     2324           p-need-create-doc-pl = false
     2325         .
     2326       end.
     2327     end.
     2328   end procedure.
     2329   procedure trndocrs-validate :
     2330     define input parameter p-place-rsrv as logical no-undo .
     2331     define input parameter p-chg-qnty   as decimal no-undo .
     2332     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     2333     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     2334     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
     2335     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
     2336     assign
     2337       v-total-gds-dtl-rsrv-qnty = 0
     2338       v-total-pl-gds-rsrv-qnty  = 0
     2339     .
     2340     do
     2341     on error undo, return error return-value
     2342     :
     2343       for each buf_temp-trndocrs-gds-dtl-rsrv
     2344       on error undo, return error return-value
     2345       :
     2346         assign
     2347           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
     2348                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     2349         .
     2350       end.
     2351       for each buf_temp-trndocrs-pl-gds-rsrv
     2352       on error undo, return error return-value
     2353       :
     2354         assign
     2355           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
     2356                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     2357         .
     2358       end.
     2359       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     2360         message
     2361           vss-workfile vss-revision vss-description skip
     2362           vss-include-info17 skip
     2363           "Ошибка при резервировании свободных количеств" skip
     2364           "Запрошено резервирование:" skip
     2365           "По товару" p-chg-qnty skip
     2366           "По признакам" v-total-gds-dtl-rsrv-qnty skip
     2367           "По складским местам" v-total-pl-gds-rsrv-qnty skip
     2368           view-as alert-box error .
     2369         undo, return error return-value .
     2370       end.
     2371       if p-place-rsrv then do:
     2372         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     2373           message
     2374             vss-workfile vss-revision vss-description skip
     2375             vss-include-info17 skip
     2376             "Ошибка при резервировании свободных количеств" skip
     2377             "Запрошено резервирование:" skip
     2378             "По товару" p-chg-qnty skip
     2379             "По признакам" v-total-gds-dtl-rsrv-qnty skip
     2380             "По складским местам" v-total-pl-gds-rsrv-qnty skip
     2381             view-as alert-box error .
     2382           undo, return error return-value .
     2383         end.
     2384       end.
     2385     end.
     2386   end procedure.
     2387   procedure trndocrs :
     2388     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
     2389     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
     2390     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
     2391     define input parameter p-artic      like ub.doc-line.artic     no-undo .
     2392     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
     2393     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
     2394     define input parameter p-chg-qnty   as decimal no-undo .
     2395     define buffer buf_db         for ub.db .
     2396     define buffer buf_gds-obj    for ub.gds-obj .
     2397     define buffer buf_prt-obj    for ub.prt-obj .
     2398     define buffer buf_gds-prt    for ub.gds-prt .
     2399     define buffer buf_goods      for ub.goods .
     2400     define buffer buf_pl-gds     for ub.pl-gds .
     2401     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     2402     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     2403     define variable v-node-code   like ub.gds-prt.node-code no-undo .
     2404     define variable v-curr-db-num like ub.db.db-num         no-undo .
     2405     define variable v-cmd         as   character            no-undo .
     2406     do
     2407     on error undo, return error return-value
     2408     :
     2409   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2410   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2411     (input  p-obj-type
     2412     ,input  p-obj-code
     2413     ,input  p-artic
     2414     ,input  p-prod-type
     2415     ,input  p-prod-code
     2416     ,buffer buf_gds-obj
     2417     ) no-error .
     2418       if error-status :error then do:
     2419         message
     2420           vss-workfile vss-revision vss-description skip
     2421           vss-include-info17 skip
     2422           "Ошибка при поиске товара на объекте" skip
     2423           "p-obj-type"  p-obj-type  skip
     2424           "p-obj-code"  p-obj-code  skip
     2425           "p-artic"     p-artic     skip
     2426           "p-prod-type" p-prod-type skip
     2427           "p-prod-code" p-prod-code skip
     2428           error-status :get-message(1) skip
     2429           return-value skip
     2430           view-as alert-box error .
     2431         undo, return error return-value .
     2432       end.
     2433       find current buf_gds-obj exclusive-lock .
     2434       run trndocrs-validate in this-procedure
     2435         (input buf_gds-obj.place-rsrv
     2436         ,input p-chg-qnty
     2437         ) no-error .
     2438       if error-status :error then do:
     2439         message
     2440           vss-workfile vss-revision vss-description skip
     2441           vss-include-info17 skip
     2442           "Противоречивые данные для резервирования" skip
     2443           error-status :get-message(1) skip
     2444           return-value skip
     2445           view-as alert-box error .
     2446         undo, return error return-value .
     2447       end.
     2448       assign
     2449         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
     2450         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
     2451       .
     2452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     2453     (input ?
     2454     ,input this-procedure:handle
     2455     ,input ?
     2456     ,input  'rest-update':U
     2457     ,input ?
     2458     ,input  buffer buf_gds-obj:handle
     2459     ,input 'fact-qnty,free-qnty'
     2460     ,input ''
     2461     ) no-error .
     2462   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2463   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2464     (output v-curr-db-num
     2465     )  .
     2466       find first buf_db no-lock
     2467         where buf_db.db-num = v-curr-db-num
     2468         .
     2469       if buf_db.db-num <> 0
     2470         and buf_db.on-line-rest = true
     2471       then do:
     2472         assign
     2473           v-cmd = "command":U + chr(1)
     2474                   + "create":U + chr(1)
     2475                   + "on-line-rest":U + chr(1)
     2476                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
     2477                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
     2478                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
     2479                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
     2480                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
     2481                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
     2482         .
     2483         run nws/cr-route.p
     2484           ( input 'send-cmd':U
     2485             ,input v-cmd
     2486             ,input ?
     2487             ,input "0":U
     2488           ).
     2489       end.
     2490       if buf_gds-obj.place-rsrv = true then do:
     2491         for each buf_temp-trndocrs-pl-gds-rsrv
     2492         on error undo, return error return-value
     2493         :
     2494           find first buf_goods no-lock
     2495             where buf_goods.artic     = p-artic
     2496               and buf_goods.prod-type = p-prod-type
     2497               and buf_goods.prod-code = p-prod-code
     2498             no-error .
     2499           if not available buf_goods then do:
     2500             message
     2501               vss-workfile vss-revision vss-description skip
     2502               vss-include-info17 skip
     2503               "Не найдена товар" skip
     2504               "Артикул" p-artic p-prod-type p-prod-code skip
     2505               view-as alert-box error .
     2506             undo, return error return-value .
     2507           end.
     2508           find first buf_pl-gds exclusive-lock
     2509             where buf_pl-gds.obj-type = p-obj-type
     2510               and buf_pl-gds.obj-code = p-obj-code
     2511               and buf_pl-gds.gds-code = buf_goods.gds-code
     2512               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
     2513             no-error .
     2514           if not available buf_pl-gds then do:
     2515             message
     2516               vss-workfile vss-revision vss-description skip
     2517               vss-include-info17 skip
     2518               "Не найдена привязка товара к складскому месту" skip
     2519               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
     2520               view-as alert-box error .
     2521             undo, return error return-value .
     2522           end.
     2523           assign
     2524             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     2525             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
     2526           .
     2527           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
     2528             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
     2529           then do:
     2530             assign
     2531               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
     2532             .
     2533           end.
     2534         end.
     2535       end.
     2536       for each buf_temp-trndocrs-gds-dtl-rsrv
     2537       on error undo, return error return-value
     2538       :
     2539   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2540     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
     2541     ,output v-node-code
     2542     ) no-error .
     2543         if error-status :error then do:
     2544           message
     2545             vss-workfile vss-revision vss-description skip
     2546             vss-include-info17 skip
     2547             "Ошибка при определении первого терминального признака" skip
     2548             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
     2549             view-as alert-box error .
     2550           undo, return error return-value .
     2551         end.
     2552         find first buf_gds-prt no-lock
     2553           where buf_gds-prt.node-code = v-node-code
     2554           .
     2555         do while available buf_gds-prt
     2556         on error undo, return error return-value
     2557         :
     2558   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
     2560     (input  p-obj-type
     2561     ,input  p-obj-code
     2562     ,input  p-artic
     2563     ,input  p-prod-type
     2564     ,input  p-prod-code
     2565     ,input  buf_gds-prt.node-code
     2566     ,buffer buf_prt-obj
     2567     )  .
     2568           find current buf_prt-obj exclusive-lock .
     2569           assign
     2570             buf_prt-obj.free-qnty = buf_prt-obj.free-qnty - buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     2571           .
     2572           assign
     2573             v-node-code = buf_gds-prt.upper-code
     2574           .
     2575           find first buf_gds-prt no-lock
     2576             where buf_gds-prt.node-code = v-node-code
     2577             no-error .
     2578         end.
     2579       end.
     2580     end.
     2581   end procedure.
     2582   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2583   procedure partrqst :
     2584     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
     2585     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
     2586     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
     2587     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
     2588     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
     2589     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
     2590     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
     2591     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
     2592     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
     2593     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
     2594     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
     2595     define output parameter p-total-parts-price-base     as decimal                 no-undo .
     2596     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
     2597     define output parameter p-total-parts-transport-base as decimal                 no-undo .
     2598     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
     2599     define output parameter p-total-parts-other-base     as decimal                 no-undo .
     2600     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
     2601     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
     2602     do
     2603     on error undo, return error return-value
     2604     :
     2605       assign
     2606         p-total-parts-qnty           = 0
     2607         p-total-parts-fact-qnty      = 0
     2608         p-total-parts-cli-qnty       = 0
     2609         p-total-parts-fact-cli-qnty  = 0
     2610         p-total-parts-price-cli      = 0
     2611         p-total-parts-price-base     = 0
     2612         p-total-parts-price-rubl     = 0
     2613         p-total-parts-transport-base = 0
     2614         p-total-parts-transport-rubl = 0
     2615         p-total-parts-other-base     = 0
     2616         p-total-parts-other-rubl     = 0
     2617       .
     2618       define buffer buf_parts for ub.parts .
     2619       for each buf_parts no-lock
     2620         where buf_parts.out-code  = p-doc-code
     2621           and buf_parts.obj-type  = p-obj-type
     2622           and buf_parts.obj-code  = p-obj-code
     2623           and buf_parts.artic     = p-artic
     2624           and buf_parts.prod-type = p-prod-type
     2625           and buf_parts.prod-code = p-prod-code
     2626       on error undo, return error return-value
     2627       :
     2628         define variable v-parts-fact-multiplier as decimal   no-undo .
     2629         assign
     2630           v-parts-fact-multiplier = 1
     2631         .
     2632         if buf_parts.qnty <> 0 then do:
     2633           assign
     2634             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
     2635           .
     2636         end.
     2637         assign
     2638           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
     2639           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
     2640           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
     2641           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
     2642                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
     2643           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
     2644           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
     2645           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
     2646           p-total-parts-transport-base  = p-total-parts-transport-base
     2647                                         + buf_parts.fact-qnty
     2648                                           * (if   buf_parts.transport-base <> ?
     2649                                             then buf_parts.transport-base
     2650                                             else 0
     2651                                             )
     2652           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
     2653                                         + buf_parts.fact-qnty
     2654                                           * (if   buf_parts.transport-rubl <> ?
     2655                                             then buf_parts.transport-rubl
     2656                                             else 0
     2657                                             )
     2658           p-total-parts-other-base      = p-total-parts-other-base
     2659                                         + buf_parts.fact-qnty
     2660                                           * (if   buf_parts.other-base <> ?
     2661                                             then buf_parts.other-base
     2662                                             else 0
     2663                                             )
     2664           p-total-parts-other-rubl      = p-total-parts-other-rubl
     2665                                         + buf_parts.fact-qnty
     2666                                           * (if   buf_parts.other-rubl <> ?
     2667                                             then buf_parts.other-rubl
     2668                                             else 0
     2669                                             )
     2670         .
     2671       end.
     2672     end.
     2673   end procedure.
     2674   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2675   define variable vss-include-info23 as character format "X(65)" no-undo
     2676   initial "@(#)$Workfile$ $Revision$".
     2677   procedure xmlchar-test :
     2678   define input parameter p-in-string          as character        no-undo.
     2679   define output parameter p-out-string-enc    as character        no-undo.
     2680   define output parameter p-out-string-dec    as character        no-undo.
     2681   do
     2682   on error undo, return error
     2683   :
     2684          run xmlchar-encode in this-procedure
     2685       (
     2686             input p-in-string
     2687           , output p-out-string-enc
     2688       ).
     2689          run xmlchar-decode in this-procedure
     2690       (
     2691             input p-out-string-enc
     2692           , output p-out-string-dec
     2693       ).
     2694   end.
     2695   end .
     2696   procedure xmlchar-encode :
     2697   define input parameter p-in-string      as character        no-undo.
     2698   define output parameter p-out-string    as character        no-undo.
     2699       define variable v-position      as integer      no-undo.
     2700       define variable v-current-char  as character    no-undo.
     2701   do
     2702   on error undo, return error
     2703   :
     2704       assign
     2705           p-out-string = "":U
     2706       .
     2707       case p-in-string
     2708       :
     2709           when ?
     2710           then do:
     2711               assign
     2712                   p-out-string = "?":U
     2713               .
     2714           end.
     2715           when "?":U
     2716           then do:
     2717               assign
     2718                   p-out-string = "&#63;":U
     2719               .
     2720           end.
     2721           otherwise do:
     2722               do v-position = 1 to length( p-in-string )
     2723               :
     2724                   assign
     2725                       v-current-char = substring( p-in-string, v-position, 1 )
     2726                   .
     2727                   case v-current-char
     2728                   :
     2729                       when "&":U
     2730                       then do:
     2731                           assign
     2732                               p-out-string = p-out-string + "&amp;":U
     2733                           .
     2734                       end.
     2735                       when ">":U
     2736                       then do:
     2737                           assign
     2738                               p-out-string = p-out-string + "&gt;":U
     2739                           .
     2740                       end.
     2741                       when "<":U
     2742                       then do:
     2743                           assign
     2744                               p-out-string = p-out-string + "&lt;":U
     2745                           .
     2746                       end.
     2747                       when "'":U
     2748                       then do:
     2749                           assign
     2750                               p-out-string = p-out-string + "&apos;":U
     2751                           .
     2752                       end.
     2753                       when '"':U
     2754                       then do:
     2755                           assign
     2756                               p-out-string = p-out-string + "&quot;":U
     2757                           .
     2758                       end.
     2759                       when chr(1)
     2760                       then do:
     2761                           assign
     2762                               p-out-string = p-out-string + "":U
     2763                           .
     2764                       end.
     2765                       when chr(2)
     2766                       then do:
     2767                           assign
     2768                               p-out-string = p-out-string + "":U
     2769                           .
     2770                       end.
     2771                       when chr(3)
     2772                       then do:
     2773                           assign
     2774                               p-out-string = p-out-string + "":U
     2775                           .
     2776                       end.
     2777                       when chr(4)
     2778                       then do:
     2779                           assign
     2780                               p-out-string = p-out-string + "":U
     2781                           .
     2782                       end.
     2783                       when chr(5)
     2784                       then do:
     2785                           assign
     2786                               p-out-string = p-out-string + "":U
     2787                           .
     2788                       end.
     2789                       when chr(6)
     2790                       then do:
     2791                           assign
     2792                               p-out-string = p-out-string + "":U
     2793                           .
     2794                       end.
     2795                       when chr(7)
     2796                       then do:
     2797                           assign
     2798                               p-out-string = p-out-string + "":U
     2799                           .
     2800                       end.
     2801                       when chr(8)
     2802                       then do:
     2803                           assign
     2804                               p-out-string = p-out-string + "":U
     2805                           .
     2806                       end.
     2807                       when chr(9)
     2808                       then do:
     2809                           assign
     2810                               p-out-string = p-out-string + "":U
     2811                           .
     2812                       end.
     2813                       when chr(29)
     2814                       then do:
     2815                           assign
     2816                               p-out-string = p-out-string + "":U
     2817                           .
     2818                       end.
     2819                       when chr(10)
     2820                       then do:
     2821                           assign
     2822                               p-out-string = p-out-string + "&#10;":U
     2823                           .
     2824                       end.
     2825                       when chr(13)
     2826                       then do:
     2827                           assign
     2828                               p-out-string = p-out-string + "&#13;":U
     2829                           .
     2830                       end.
     2831                       otherwise do:
     2832                           assign
     2833                               p-out-string = p-out-string + v-current-char
     2834                           .
     2835                       end.
     2836                   end case.
     2837               end.
     2838           end.
     2839       end case.
     2840   end.
     2841   end .
     2842   procedure xmlchar-encode-1c :
     2843   define input parameter p-in-string      as character        no-undo.
     2844   define output parameter p-out-string    as character        no-undo.
     2845       define variable v-position      as integer      no-undo.
     2846       define variable v-current-char  as character    no-undo.
     2847   do
     2848   on error undo, return error
     2849   :
     2850       assign
     2851           p-out-string = "":U
     2852       .
     2853       case p-in-string
     2854       :
     2855           when ?
     2856           then do:
     2857               assign
     2858                   p-out-string = "?":U
     2859               .
     2860           end.
     2861           otherwise do:
     2862               do v-position = 1 to length( p-in-string )
     2863               :
     2864                   assign
     2865                       v-current-char = substring( p-in-string, v-position, 1 )
     2866                   .
     2867                   case v-current-char
     2868                   :
     2869                       when chr(1)
     2870                       then do:
     2871                           assign
     2872                               p-out-string = p-out-string + " ":U
     2873                           .
     2874                       end.
     2875                       when chr(2)
     2876                       then do:
     2877                           assign
     2878                               p-out-string = p-out-string + " ":U
     2879                           .
     2880                       end.
     2881                       when chr(3)
     2882                       then do:
     2883                           assign
     2884                               p-out-string = p-out-string + " ":U
     2885                           .
     2886                       end.
     2887                       when chr(4)
     2888                       then do:
     2889                           assign
     2890                               p-out-string = p-out-string + " ":U
     2891                           .
     2892                       end.
     2893                       when chr(5)
     2894                       then do:
     2895                           assign
     2896                               p-out-string = p-out-string + " ":U
     2897                           .
     2898                       end.
     2899                       when chr(6)
     2900                       then do:
     2901                           assign
     2902                               p-out-string = p-out-string + " ":U
     2903                           .
     2904                       end.
     2905                       when chr(7)
     2906                       then do:
     2907                           assign
     2908                               p-out-string = p-out-string + " ":U
     2909                           .
     2910                       end.
     2911                       when chr(8)
     2912                       then do:
     2913                           assign
     2914                               p-out-string = p-out-string + " ":U
     2915                           .
     2916                       end.
     2917                       when chr(9)
     2918                       then do:
     2919                           assign
     2920                               p-out-string = p-out-string + " ":U
     2921                           .
     2922                       end.
     2923                       when chr(29)
     2924                       then do:
     2925                           assign
     2926                               p-out-string = p-out-string + " ":U
     2927                           .
     2928                       end.
     2929                       when chr(10)
     2930                       then do:
     2931                           assign
     2932                               p-out-string = p-out-string + " ":U
     2933                           .
     2934                       end.
     2935                       when chr(13)
     2936                       then do:
     2937                           assign
     2938                               p-out-string = p-out-string + " ":U
     2939                           .
     2940                       end.
     2941                       otherwise do:
     2942                           assign
     2943                               p-out-string = p-out-string + v-current-char
     2944                           .
     2945                       end.
     2946                   end case.
     2947               end.
     2948           end.
     2949       end case.
     2950   end.
     2951   end .
     2952   procedure xmlchar-decode :
     2953   define input parameter p-in-string      as character        no-undo.
     2954   define output parameter p-out-string    as character        no-undo.
     2955       define variable v-position      as integer      no-undo.
     2956       define variable v-last-position as integer      no-undo.
     2957       define variable v-temp-integer  as integer      no-undo.
     2958       define variable v-current-char  as character    no-undo.
     2959       define variable v-next-char     as character    no-undo.
     2960       define variable v-success       as logical      no-undo.
     2961   do
     2962   on error undo, return error
     2963   :
     2964       assign
     2965           p-out-string = "":U
     2966           v-position   = 0
     2967       .
     2968       replace-cycle:
     2969       do while yes
     2970       on error undo, return error
     2971       :
     2972           assign
     2973               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2974           .
     2975           if v-last-position <= v-position
     2976           then do:
     2977               if v-position = 0
     2978               then do:
     2979                   assign
     2980                       p-out-string = p-in-string
     2981                   .
     2982               end.
     2983               else do:
     2984                   assign
     2985                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2986                   .
     2987               end.
     2988               leave replace-cycle.
     2989           end.
     2990           else do:
     2991               assign
     2992                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2993                   v-position      = v-last-position
     2994                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2995               .
     2996               if v-current-char = "#":U
     2997               then do:
     2998                   assign
     2999                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3000                   .
     3001                   if v-last-position > 0
     3002                   then do:
     3003                       run xmlchar-read-integer in this-procedure
     3004                        (
     3005                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3006                           , output v-temp-integer
     3007                           , output v-success
     3008                       ).
     3009                       if v-success = yes
     3010                       and v-temp-integer >= 1
     3011                       and v-temp-integer <= 255
     3012                       then do:
     3013                           assign
     3014                               p-out-string = p-out-string + chr( v-temp-integer )
     3015                               v-position   = v-last-position + 1
     3016                           .
     3017                       end.
     3018                       else do:
     3019                           assign
     3020                               p-out-string = p-out-string + "&":U
     3021                               v-position   = v-position   + 1
     3022                           .
     3023                       end.
     3024                   end.
     3025                   else do:
     3026                       assign
     3027                           p-out-string = p-out-string + "&":U
     3028                           v-position   = v-position   + 1
     3029                       .
     3030                   end.
     3031               end.
     3032               else do:
     3033                   case substring( p-in-string, v-position + 1, 3 )
     3034                   :
     3035                       when "lt;":U
     3036                       then do:
     3037                           assign
     3038                               p-out-string = p-out-string + "<":U
     3039                               v-position   = v-position   + 3
     3040                           .
     3041                       end.
     3042                       when "gt;":U
     3043                       then do:
     3044                           assign
     3045                               p-out-string = p-out-string + ">":U
     3046                               v-position   = v-position   + 3
     3047                           .
     3048                       end.
     3049                       otherwise do:
     3050                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3051                           then do:
     3052                               assign
     3053                                   p-out-string = p-out-string + "&":U
     3054                                   v-position   = v-position   + 4
     3055                               .
     3056                           end.
     3057                           else do:
     3058                               case substring( p-in-string, v-position + 1, 5 )
     3059                               :
     3060                                   when "quot;":U
     3061                                   then do:
     3062                                       assign
     3063                                           p-out-string = p-out-string + '"':U
     3064                                           v-position   = v-position   + 5
     3065                                       .
     3066                                   end.
     3067                                   when "apos;":U
     3068                                   then do:
     3069                                       assign
     3070                                           p-out-string = p-out-string + "'":U
     3071                                           v-position   = v-position   + 5
     3072                                       .
     3073                                   end.
     3074                                   otherwise do:
     3075                                       assign
     3076                                           p-out-string = p-out-string + "&":U
     3077                                       .
     3078                                   end.
     3079                               end case.
     3080                           end.
     3081                       end.
     3082                   end case.
     3083               end.
     3084           end.
     3085       end.
     3086   end.
     3087   end .
     3088   procedure xmlchar-read-integer :
     3089   define input parameter p-input-string      as character        no-undo.
     3090   define output parameter p-output-integer   as integer          no-undo.
     3091   define output parameter p-success       as logical          no-undo.
     3092   do
     3093   on error undo, return error
     3094   :
     3095       assign
     3096           p-output-integer = integer( p-input-string )
     3097       no-error.
     3098       if error-status :error
     3099       then do:
     3100           assign
     3101               p-success           = no
     3102               p-output-integer    = 0
     3103           .
     3104       end.
     3105       else do:
     3106           assign
     3107               p-success           = yes
     3108           .
     3109       end.
     3110   end.
     3111   end.
     3112   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     3113   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     3114   define variable mMRCCode  as logical    no-undo.
     3115   define variable mTypeMark as character  no-undo.
     3116   function IS-NeedMark returns logical
     3117   ( input ib-code as integer  ,
     3118     input ib-str as character ):
     3119      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     3120      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     3121                                    and buf_prod-bc-attr.b-str  eq ib-str
     3122                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     3123        no-lock no-error.
     3124      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     3125   end.
     3126   function repTegforDm return char
     3127   (iDM as char ):
     3128       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     3129       define variable vteg as character no-undo.
     3130       define variable oDM as character no-undo.
     3131       define variable vi as integer no-undo.
     3132       oDM = iDm.
     3133       do vi = 1 to num-entries(vTeglist):
     3134          vTeg = entry(vi,vTeglist).
     3135          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     3136       end.
     3137       return oDM.
     3138   end.
     3139   function repSpecSimbforDm return char
     3140   (iDM as char ):
     3141       define variable oDM as character no-undo.
     3142     run
     3143       xmlchar-decode(iDM, output oDM).
     3144     return repTegforDm (oDM).
     3145   end.
     3146   function CheckGtin return logical
     3147   (iGtin as char):
     3148      define variable bar_code as character no-undo.
     3149      define variable vGtin as logical no-undo init "yes".
     3150      if length(iGtin) eq 14
     3151      then do:
     3152         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     3153         run str/chk-sum.p
     3154          (input-output bar_code ) no-error .
     3155         if iGtin ne  bar_code
     3156         then
     3157            vGtin = no.
     3158      end.
     3159      else
     3160         vGtin = no.
     3161      return vgtin.
     3162   end.
     3163   function repSpecSimbforXlm return char
     3164   (iDM as char ):
     3165       iDM = replace(iDM,chr(29),"").
     3166       return iDM.
     3167   end.
     3168   function getGtinByDM return char
     3169   (IDM as char):
     3170      define variable VTXT as char no-undo.
     3171      define variable vGtin as char no-undo.
     3172      vTXt = IdM.
     3173      vGtin = IDM.
     3174      if    length(vtxt) > 14
     3175      then do:
     3176         if   vtxt begins "(01)"
     3177                or vtxt begins "(02)"
     3178         then
     3179            vGtin = substring(vtxt,5,14).
     3180         else if   (vtxt begins "01"
     3181                or vtxt begins "02" )
     3182                and (   (    substring(iDm,17,2) eq "21"
     3183                         and length(vtxt) >= 21)
     3184                     or substring(iDm,17,2) eq "37"
     3185                     or substring(iDm,17,4) eq "(37)" )
     3186         then do:
     3187            vGtin = substring(vtxt,3,14).
     3188            if not checkGtin(vGtin)
     3189            then
     3190               vGtin = substring(vtxt,1,14).
     3191         end.
     3192         else if     length(vtxt) eq 14 + 7 + 4 + 4
     3193             or length(vtxt) eq 14 + 7 + 4
     3194             or length(vtxt) eq 14 + 7
     3195         then
     3196            vGtin = substring(vtxt,1,14).
     3197      end.
     3198      if not checkGtin(vGtin)
     3199      then
     3200         vGtin = "".
     3201      return vgtin.
     3202   end.
     3203   function getGdsCodeByGtin return int
     3204   (iGtin as char):
     3205      define buffer prod-bc  for ub.prod-bc.
     3206      define buffer bar-code for ub.bar-code.
     3207      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     3208      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3209      return if avail bar-code then bar-code.gds-code else ?.
     3210   end.
     3211   function getQntyCodeByGtin return decimal
     3212   (iGtin as char):
     3213      define buffer prod-bc  for ub.prod-bc.
     3214      define buffer bar-code for ub.bar-code.
     3215      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     3216      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3217      return if avail bar-code then bar-code.cli-base-rate else ?.
     3218   end.
     3219   function getGdsCodeByDM return int
     3220   (iDm as char):
     3221      define variable vGtin as char no-undo.
     3222      define buffer prod-bc for ub.prod-bc.
     3223      vGtin  = getGtinByDM (IDM ).
     3224      return getGdsCodeByGtin (vGtin).
     3225   end.
     3226   function ChekTypeMarkByGds return logical
     3227   (iGds-code as integer ):
     3228      define buffer goods-attr for ub.goods-attr.
     3229      find first goods-attr where goods-attr.gds-code   = iGds-code
     3230                              and goods-attr.attr-code  = 'mark-type':U
     3231      no-lock no-error.
     3232      if available goods-attr
     3233      then do:
     3234         mTypeMark = goods-attr.attr-value.
     3235         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     3236           .
     3237      end.
     3238      else
     3239         return no.
     3240   end.
     3241   function ChekTypeMarkByDm return logical
     3242   (iDM as char ):
     3243      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     3244   end.
     3245   function ChekTypeMarkByGtin return logical
     3246   (iGtin as char ):
     3247      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     3248   end.
     3249   function GetNextElement return character
     3250     (input iAllTeg        as logical
     3251     ,output oteg          as character
     3252     ,output otegval       as character
     3253     ,input-output pstr    as character
     3254      ):
     3255        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3256        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3257        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3258        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3259        define variable vTeg as character no-undo.
     3260        define variable vLength as integer no-undo.
     3261        define variable vi as integer no-undo.
     3262        define variable vj as integer no-undo.
     3263        define buffer code for ub.code.
     3264        find first code where Code.parent eq "MarkType"
     3265                          and Code.CodeValue   eq mTypeMark
     3266                          no-lock no-error.
     3267        if     available code
     3268           and Code.misc1 ne ""
     3269           and Code.misc1 ne ?
     3270        then do:
     3271           integer (Code.misc1) no-error.
     3272           if not error-status:error
     3273           then
     3274             entry (4,vlistleng) = Code.misc1.
     3275        end.
     3276        if iAllTeg
     3277        then
     3278           assign
     3279              vlistElem     = vlistElem    + vlistElemDop
     3280              vlistleng     = vlistleng    + vlistlengDop
     3281           .
     3282        else if mMRCCode
     3283        then
     3284           assign
     3285              vlistElem     = vlistElem    + ",(8005),8005"
     3286              vlistleng     = vlistleng    + ",000006,0006"
     3287           .
     3288       block-elem:
     3289       do vi = 1 to num-entries(vlistElem):
     3290          vTeg = entry(vi,vlistElem).
     3291          if pstr begins vTeg
     3292          then do:
     3293             if    vTeg eq "21"
     3294             then
     3295                vLength = index(pstr,chr(29)) - 2 no-error.
     3296             if vLength  <= 0
     3297             then
     3298                vLength = int(entry(vi,vlistleng)).
     3299             otegval = substring (pstr,length(vteg) + 1, vLength).
     3300             oteg = replace(replace(vteg,")",""),"(","").
     3301             vTeg = vteg + otegval.
     3302             otegval = replace(otegval,chr(29),"").
     3303             oteg = replace(replace(oteg,")",""),"(","").
     3304             pstr = substring (pstr,length(vTeg)+ 1).
     3305             vTeg = replace(vTeg,chr(29),"").
     3306             leave block-elem.
     3307          end.
     3308          else
     3309             vTeg = "".
     3310       end.
     3311       return vteg.
     3312   end.
     3313   function GetCodeIdent return character
     3314   (iDm as char):
     3315      define variable Velement   as character no-undo init "first".
     3316      define variable oCodeIdent as character no-undo.
     3317      define variable vteg as character no-undo.
     3318      define variable vtegval as character no-undo.
     3319      define variable vGtin as character no-undo.
     3320      define buffer marking for ub.marking.
     3321      for first marking no-lock where
     3322                marking.mark eq iDm
     3323            and marking.unit-ext = "LEVEL2"
     3324      :
     3325        return iDm.
     3326      end.
     3327      vGtin  = getGtinByDM (iDm ).
     3328      ChekTypeMarkByDm(idm).
     3329      if iDm begins 'tech_':U
     3330      then
     3331         oCodeIdent = iDm.
     3332      else if length(iDm) < 21
     3333      then do:
     3334         find first marking where marking.mark eq idm
     3335         no-lock no-error.
     3336         oCodeIdent = if available marking then marking.mark else  ?.
     3337      end.
     3338      else if     length(iDm) eq 29
     3339         and not iDm begins "01"
     3340         and not iDm begins "02"
     3341      then
     3342         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3343      else  if     length(iDm) >= 24
     3344               and (  iDm begins "01"
     3345                   or iDm begins "02")
     3346               and  substring(iDm,17,2) ne "21"
     3347      then do:
     3348         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3349                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3350         then
     3351            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3352         else
     3353            oCodeIdent = iDM.
     3354      end.
     3355      else  if     (   length(iDm) eq 25
     3356                    or length(iDm) eq 21)
     3357               and (not iDm begins "01"
     3358               and  not iDm begins "02")
     3359      then
     3360         oCodeIdent = substring(iDm,1,21).
     3361      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3362      then
     3363         oCodeIdent = substring(iDm,1,21).
     3364      else do while Velement ne "" and idm ne "":
     3365         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3366         oCodeIdent = oCodeIdent + Velement.
     3367      end.
     3368      return oCodeIdent.
     3369   end.
     3370   function GetTegCod return character
     3371   (icodeIdent as char, iTeg as char):
     3372      define variable Velement   as character no-undo init "first".
     3373      define variable oTeg as character no-undo init ?.
     3374      define variable vteg as character no-undo.
     3375      define variable vtegval as character no-undo.
     3376      if     ((length(icodeIdent) eq 21
     3377         and not icodeIdent begins "01"
     3378         and not icodeIdent begins "02")
     3379         or
     3380             ( length(icodeIdent) eq 25
     3381               and not icodeIdent begins "01"
     3382               and not icodeIdent begins "02"))
     3383      then do:
     3384         if iTeg eq "01" or iTeg eq "02"
     3385         then
     3386            oTeg = substring(icodeIdent,1,21).
     3387         else  if  iTeg eq "21"
     3388         then
     3389            oTeg = substring(icodeIdent,15,7).
     3390      end.
     3391      else do:
     3392         ChekTypeMarkByDm(icodeIdent).
     3393         block-teg:
     3394            do while Velement ne "" and icodeIdent ne "":
     3395            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3396            if    Velement begins iTeg
     3397               or Velement begins "(" + iTeg + ")"
     3398            then do:
     3399               oTeg = vtegval.
     3400               leave block-teg.
     3401            end.
     3402         end.
     3403      end.
     3404      return oTeg.
     3405   end.
     3406   function isOAD return logical
     3407   (icodeIdent as character):
     3408      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3409   end.
     3410   function isMark return logical
     3411   (icodeIdent as character):
     3412      define buffer buf_marking for ub.marking.
     3413      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3414             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3415   end.
     3416   function addBracketForCode return character
     3417   (icodeIdent as char):
     3418      define variable Velement   as character no-undo init "first".
     3419      define variable oTeg as character no-undo.
     3420      define variable vteg as character no-undo.
     3421      define variable vtegval as character no-undo.
     3422      define buffer marking for ub.marking.
     3423      find first marking no-lock where
     3424                 marking.mark begins icodeIdent no-error.
     3425      if    not ChekTypeMarkByDm(icodeIdent)
     3426         or length(icodeIdent) le 24
     3427         or (avail marking and marking.unit-ext = "LEVEL2")
     3428      then
     3429         oTeg = icodeIdent.
     3430      else do:
     3431         if (  icodeIdent begins "01"
     3432            or icodeIdent begins "02"
     3433            ) and CheckGtin(substring (icodeIdent,3,14))
     3434            and substring (icodeIdent,17,2) eq "21"
     3435         then do:
     3436            mMRCCode = yes.
     3437            ChekTypeMarkByDm(icodeIdent).
     3438            block-teg:
     3439            do while Velement ne "" and icodeIdent ne "":
     3440               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3441               if vteg ne ""
     3442               then
     3443                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3444            end.
     3445            mMRCCode = no.
     3446         end.
     3447         else do:
     3448            oTeg = icodeIdent.
     3449         end.
     3450      end.
     3451      return oTeg.
     3452   end.
     3453   function getlevelByCodId return int
     3454   (iCode as char):
     3455      define variable vLength as int no-undo.
     3456      define variable vLevel  as int no-undo.
     3457      if not ChekTypeMarkByDM (icode) then return ?.
     3458      vLength = length(iCode).
     3459      if    vLength eq 18
     3460         or vLength eq 20
     3461      then
     3462         Vlevel = 4.
     3463      else if vLength eq 21
     3464      then
     3465         Vlevel = 1.
     3466      else if vLength eq 25
     3467      then do:
     3468         if  iCode begins "01"
     3469         then
     3470            Vlevel = 3.
     3471         else
     3472            Vlevel = 1.
     3473      end.
     3474      else if     vLength >= 26
     3475              and vLength <= 46
     3476      then do:
     3477         if    substring(iCode,17,2) eq "11"
     3478            or substring(iCode,17,2) eq "13"
     3479            or (    substring(iCode,17,2) eq "21"
     3480                and vLength >= 33
     3481                and substring(iCode,26,4) ne "8005")
     3482         then
     3483            Vlevel = 4.
     3484         else if    vLength eq 31
     3485                 or vLength eq 38
     3486                 or vLength eq 39
     3487                 or vLength eq 45
     3488         then
     3489            Vlevel = 1.
     3490         else if    vLength eq 35
     3491                 or vLength eq 43
     3492         then
     3493            Vlevel = 3.
     3494         else
     3495            Vlevel = ?.
     3496      end.
     3497      else
     3498         Vlevel = ?.
     3499      return Vlevel.
     3500   end.
     3501   function getLevelMotpBycodid return character
     3502   (iDm as char):
     3503      define variable vLevel as integer no-undo.
     3504      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3505      vLevel = getlevelByCodId(iDm).
     3506      if    vLevel eq ?
     3507         or vLevel < 1
     3508         or vLevel > 6
     3509      then
     3510         return ?.
     3511      else
     3512         return entry(vlevel,vList).
     3513   end.
     3514   function getLevelUTDByLevelMotp return character
     3515   (iUnit as char):
     3516      define variable vLevel as integer no-undo.
     3517      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3518      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3519      vLevel = lookup(iUnit,vListMOTP).
     3520      if    vLevel eq ?
     3521         or vLevel < 1
     3522         or vLevel > 4
     3523      then
     3524         return ?.
     3525      else
     3526         return entry(vlevel,vListutd).
     3527   end.
     3528   function getLevelMotpByDM return character
     3529   (iDm as char):
     3530      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3531   end.
     3532   function getLevelUTDByCodId return character
     3533   (iDm as char):
     3534      define variable vLevel as integer no-undo.
     3535      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3536      vLevel = getlevelByCodId(iDm).
     3537      if    vLevel eq ?
     3538         or vLevel < 1
     3539         or vLevel > 4
     3540      then
     3541         return ?.
     3542      else
     3543         return entry(vlevel,vList).
     3544   end.
     3545   function getLevelUTDByDM return character
     3546   (iDm as char):
     3547      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3548   end.
     3549   define variable mNotMarkQnty as logical no-undo.
     3550   function getQntyUTDByCodId return decimal
     3551   (iDM as char):
     3552      define variable vLevel as integer no-undo.
     3553      define variable vList as character no-undo init "1,5,10,500".
     3554      define variable vGtin as character no-undo.
     3555      define variable vqnty as decimal no-undo init ?.
     3556      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3557      if vqnty eq ?
     3558      then do:
     3559         if not mNotMarkQnty
     3560         then do:
     3561            define buffer marking for ub.marking.
     3562            define variable vCodident as character no-undo.
     3563            vCodident = GetCodeIdent(idm).
     3564            find first marking where marking.mark begins vCodident no-lock no-error.
     3565            if     available marking
     3566               and marking.box-qnty ne ?
     3567            then
     3568               return marking.box-qnty.
     3569         end.
     3570         vGtin = getGtinByDm(iDM).
     3571         if ChekTypeMarkByGtin (vGtin)
     3572         then do:
     3573            vLevel = getlevelByCodId(iDM).
     3574            if     vLevel >= 1
     3575               and vLevel <= 4
     3576            then
     3577               vqnty = int(entry(vlevel,vList)).
     3578         end.
     3579         else
     3580            vqnty = getQntyCodeByGtin(vgtin).
     3581      end.
     3582      return vqnty.
     3583   end.
     3584   function getQntyUTDByDM return decimal
     3585   (iDm as char):
     3586      define variable vDM as character no-undo.
     3587      if     length (iDm) ne 25
     3588         and length (iDm) ne 29
     3589         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3590      then
     3591         vDM = substring (iDm,1,length (iDm) - 6 ).
     3592      else
     3593         vDM = substring (iDm,1,length (iDm) - 4 ).
     3594      return getQntyUTDByCodId(vDM).
     3595   end.
     3596   function getMRC4 return decimal
     3597   (iMRC as char):
     3598      define variable oMrc     as decimal no-undo init ?.
     3599      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3600      define variable vi       as integer no-undo.
     3601      define variable vfound   as integer no-undo.
     3602      define variable vposStart   as integer no-undo.
     3603      do:
     3604      OMRc = 0.
     3605      do vi = 1 to 4:
     3606         define variable vsimb as character no-undo.
     3607         vsimb = substring(iMRC,vi,1).
     3608         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3609         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3610         if vfound > 0
     3611         then
     3612            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3613         end.
     3614         OMRc = OMRc / 100.
     3615      end.
     3616      return OMRc.
     3617   end.
     3618   function getMRCByDM return decimal
     3619   (iDm as char):
     3620      define variable vMRC     as character no-undo.
     3621      define variable oMrc     as decimal no-undo init ?.
     3622      define variable Velement as character no-undo init "empty".
     3623      define variable vteg as character no-undo.
     3624      define variable vtegval as character no-undo.
     3625      if    length(idm) eq 14 + 7 + 4 + 4
     3626         or length(idm) eq 14 + 7 + 4
     3627      then do:
     3628         vMRC = substring(idm,22,4).
     3629         omrc = getMRC4(vMRC).
     3630      end.
     3631      else do:
     3632          ChekTypeMarkByDm(iDm).
     3633          block-mrc:
     3634          do while Velement ne "" and idm ne "":
     3635             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3636             if Velement begins "8005"
     3637             then do:
     3638                vMRC = substring(Velement,5,6).
     3639                leave block-mrc.
     3640             end.
     3641             else if Velement begins "(8005)"
     3642             then do:
     3643                vMRC = substring(Velement,7,6).
     3644                leave block-mrc.
     3645             end.
     3646          end.
     3647          if vMRC ne ""
     3648          then
     3649             OMRc = dec(vmrc) / 100 no-error.
     3650      end.
     3651      return OMRc.
     3652   end.
     3653   function MoveDate return Date
     3654   (idate as date,
     3655    iMonth as int64):
     3656      define variable vMonth   as int64 no-undo.
     3657      define variable vYear    as int64 no-undo.
     3658      define variable vDateNew as date  no-undo.
     3659       define variable vDay     as int64 no-undo.
     3660       vMonth = month(iDate) + iMonth.
     3661       vYear =  year(iDate).
     3662       if vMonth <= 0
     3663       then assign
     3664          vMonth = vMonth + 12
     3665           vYear  = vYear - 1
     3666       .
     3667       else if vMonth > 12
     3668       then assign
     3669          vMonth = vMonth - 12
     3670           vYear  = vYear + 1
     3671       .
     3672       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3673       do while error-status:error eq yes:
     3674          VDay = vDay + 1.
     3675          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3676       end.
     3677       if VDay > 0
     3678       then
     3679          vDateNew + 1.
     3680       return vDateNew.
     3681   end.
     3682   procedure checkEMRC:
     3683   define input  parameter iDm as character no-undo.
     3684   define output parameter vok as logical   no-undo init yes.
     3685      define variable v-value-emrc as character no-undo.
     3686      define variable v-type-emrc  as character no-undo.
     3687      define variable vDateIso     as character no-undo.
     3688      define variable vMRC         as decimal no-undo.
     3689      define variable vqnty        as decimal no-undo.
     3690      define variable vPrice       as decimal no-undo.
     3691      define variable vparent      as character no-undo.
     3692      define variable vgds-code    as integer no-undo.
     3693      define buffer code for ub.code.
     3694      vMRC = getMRCByDM(iDm).
     3695      if vMRC > 0
     3696      then do:
     3697         vgds-code = getGdsCodeByDM(iDm).
     3698         vqnty     = getQntyUTDByDM(iDm).
     3699               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3700            (
     3701             input   vgds-code
     3702            ,input   'emrc-type':U
     3703            ,output   v-value-emrc
     3704            ,output   v-type-emrc
     3705          ) no-error.
     3706          if     v-value-emrc ne ""
     3707             and v-value-emrc ne ?
     3708          then do:
     3709             vDateIso = iso-date(today).
     3710             vPrice = vMRC / vqnty.
     3711             vparent ="emc" + chr(4) + v-value-emrc.
     3712             find last code where Code.parent      eq vparent
     3713                              and Code.code        le vDateIso
     3714                              and code.status_  eq 0
     3715             no-lock no-error.
     3716             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3717             then
     3718                vOk = true .
     3719             else do:
     3720                 define variable vText      as character no-undo.
     3721                 define variable vDate      as date no-undo.
     3722                 define variable vDateLast  as character no-undo.
     3723                 define variable vDateFirst as character no-undo.
     3724                 define variable vDate3     as date no-undo.
     3725                 vdate = date(code.misc1).
     3726                 vDateLast = code.misc1.
     3727                 vDate3 = MoveDate(today, - 3 ).
     3728                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3729                                      string(vDate3  , "99/99/9999"),
     3730                                      string(vDate   , "99/99/9999")
     3731                                      ).
     3732                 vdateIso = iso-date(vdate3).
     3733                 find last code  where Code.parent      eq vparent
     3734                                   and Code.code        le vDateIso
     3735                                   and code.status_  eq 0 no-lock no-error.
     3736                 if available code
     3737                 then
     3738                    vDateIso = code.code.
     3739                 vDateFirst = vDateIso.
     3740                 vDateLast = iso-date(vdate).
     3741                 define variable vGood as logical no-undo.
     3742                 define variable vDateSale as date no-undo.
     3743                 define buffer bcode for code.
     3744                 for last code where Code.parent   eq vparent
     3745                                 and code.status_  eq 0
     3746                                 and code.code     < vDateLast
     3747                                 and code.code     >= vDateFirst
     3748                 no-lock:
     3749                    find first bcode where bCode.parent   eq vparent
     3750                                       and bcode.status_  eq 0
     3751                                       and bcode.code     > code.code no-lock no-error.
     3752                    if available bcode
     3753                    then do:
     3754                       if vPrice < dec(Code.CodeValue)
     3755                       then
     3756                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     3757                                                     chr(10),
     3758                                                     string(    date( code.misc1)       ,"99/99/9999"),
     3759                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     3760                                                     ).
     3761                       else do:
     3762                          vGood = yes.
     3763                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     3764                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     3765                                                     chr(10),
     3766                                                     string(    date( code.misc1)         ,"99/99/9999"),
     3767                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     3768                                                     string(         vDateSale            ,"99/99/9999"),
     3769                                                     string(vDateSale - today)
     3770                                                     ).
     3771                       end.
     3772                    end.
     3773                 end.
     3774                 if vgood
     3775                 then do:
     3776                    define variable choice as integer no-undo .
     3777                    run gbl/d-askw.w (input "Уточнение"
     3778                           ,input  vText
     3779                           ,input "|"
     3780                           ,input "Принять|Вернуть"
     3781                           ,input "Принять данный товар|Вернуть товар постащику"
     3782                           ,input 1
     3783                           ,input 2
     3784                           ,output choice) no-error.
     3785                    vok = choice eq 1.
     3786                 end.
     3787                 else
     3788                    vok =false.
     3789             end.
     3790          end.
     3791      end.
     3792   end.
     3793   function addGs2Mark return character
     3794   (iMark as char):
     3795      define variable vDM   as character no-undo.
     3796      define variable vIdx  as integer   no-undo.
     3797      if index(iMark,chr(29),1) > 0
     3798      then return iMark.
     3799      if substring(iMark,26,4) = "8005" then
     3800      do:
     3801        vIdx = index(iMark,"93",26 + 4 + 5).
     3802        if vIdx > 1 then do:
     3803          vDM = substitute("&1&4&2&4&3",
     3804                           substring(iMark,1,25),
     3805                           substring(iMark,26,vIdx - 25 - 1),
     3806                           substring(iMark,vIdx),
     3807                           chr(29)) no-error.
     3808          vIdx = index(vDm,"240",vIdx + 4).
     3809          if vIdx > 0 then
     3810          do:
     3811            vDM = substitute("&1&3&2",
     3812                             substring(vDm,1,vIdx - 1),
     3813                             substring(vDm,vIdx),
     3814                             chr(29)) no-error.
     3815          end.
     3816        end.
     3817        else
     3818          vDM = substitute("&1&3&2",
     3819                           substring(iMark,1,25),
     3820                           substring(iMark,26),
     3821                           chr(29)) no-error.
     3822      end.
     3823      else if substring(iMark,32,2) = "91" then
     3824      do:
     3825        vIdx = index(iMark,"92",32).
     3826        if vIdx > 1 then
     3827          vDM = substitute("&1&4&2&4&3",
     3828                           substring(iMark,1,31),
     3829                           substring(iMark,32,vIdx - 31 - 1),
     3830                           substring(iMark,vIdx),
     3831                           chr(29)) no-error.
     3832        else
     3833          vDM = substitute("&1&3&2",
     3834                           substring(iMark,1,31),
     3835                           substring(iMark,32),
     3836                           chr(29)) no-error.
     3837      end.
     3838      else if substring(iMark,39,2) = "91" then
     3839      do:
     3840        vIdx = index(iMark,"92",38).
     3841        if vIdx > 1 then
     3842          vDM = substitute("&1&4&2&4&3",
     3843                           substring(iMark,1,38),
     3844                           substring(iMark,39,vIdx - 38 - 1),
     3845                           substring(iMark,vIdx),
     3846                           chr(29)) no-error.
     3847        else
     3848          vDM = substitute("&1&3&2",
     3849                           substring(iMark,1,38),
     3850                           substring(iMark,39),
     3851                           chr(29)) no-error.
     3852      end.
     3853      else if substring(iMark,25,2) = "93" then
     3854      do:
     3855        vIdx = index(iMark,"92",25).
     3856        if vIdx > 1 then
     3857          vDM = substitute("&1&4&2&4&3",
     3858                           substring(iMark,1,24),
     3859                           substring(iMark,25,vIdx - 24 - 1),
     3860                           substring(iMark,vIdx),
     3861                           chr(29)) no-error.
     3862        else
     3863          vIdx = index(iMark,"3103",25).
     3864          if vIdx > 0 then
     3865          vDM = substitute("&1&4&2&4&3",
     3866                           substring(iMark,1,24),
     3867                           substring(iMark,25,vIdx - 24 - 1),
     3868                           substring(iMark,vIdx),
     3869                           chr(29)) no-error.
     3870          else
     3871            vDM = substitute("&1&3&2",
     3872                             substring(iMark,1,24),
     3873                             substring(iMark,25),
     3874                             chr(29)) no-error.
     3875      end.
     3876      else if substring(iMark,32,2) = "93" then
     3877      do:
     3878        vDM = substitute("&1&3&2",
     3879              substring(iMark,1,31),
     3880              substring(iMark,32),
     3881              chr(29)) no-error.
     3882      end.
     3883      return if vDM <> "" then vDm else iMark.
     3884   end.
     3885   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3886   procedure partcopy :
     3887     define input parameter  p-free-output-copy as logical   no-undo .
     3888     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     3889     define parameter buffer buf_orig_parts     for ub.parts .
     3890     define parameter buffer buf_parts          for ub.parts .
     3891     define input parameter  p-mark             as character no-undo .
     3892     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     3893     define variable v-value-character as character no-undo .
     3894     define variable v-value-date      as date no-undo .
     3895     define variable v-value-decimal   as decimal no-undo .
     3896     define variable v-value-integer   as integer no-undo .
     3897     define variable v-izlcstpr        as logical no-undo .
     3898     define variable v-tth             as handle no-undo .
     3899     define variable v-type            as character no-undo .
     3900     define variable part-key-rec      as character no-undo .
     3901     define variable orig-part-key-rec as character no-undo .
     3902     define variable del-part-key-rec  as character no-undo .
     3903     define variable objMarks as class excisemarks  no-undo .
     3904     define variable v-parent-mark-sts as integer   no-undo .
     3905     define variable v-mark-sts-list   as character no-undo .
     3906     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     3907     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     3908     define buffer buf_gen-attr for ub.gen-attr .
     3909     define buffer buf1_gen-attr for ub.gen-attr .
     3910     define buffer buf_doc-line  for ub.doc-line .
     3911     define buffer buf_marking for ub.marking .
     3912     define buffer buf_marking-childs for ub.marking .
     3913     define buffer orig_marking-lines for ub.marking-lines .
     3914     define buffer orig_marking-lines-childs for ub.marking-lines .
     3915     define buffer buf_marking-lines for ub.marking-lines .
     3916     define buffer buf_marking-lines-childs for ub.marking-lines .
     3917     define buffer buf_marking-pack for ub.marking .
     3918     define buffer buf_marking-chk for ub.marking-chk .
     3919     define buffer buf_goods for ub.goods .
     3920     define buffer buf_trn-doc for ub.trn-doc .
     3921     define buffer pri_trn-doc for ub.trn-doc .
     3922     define buffer buf_chk-doc for ub.chk-doc .
     3923     do
     3924     on error undo, return error return-value
     3925     :
     3926       if p-free-output-copy = true
     3927       then do:
     3928         if  p-out-code <> 'free-zone':U
     3929         and p-out-code <> 'out-zone':U
     3930         then do:
     3931           message
     3932             vss-workfile vss-revision vss-description skip
     3933             vss-include-info24 skip
     3934             "Ошибка задания входных параметров процедуры partcopy" skip
     3935             "p-free-output-copy" p-free-output-copy skip
     3936             "p-out-code" p-out-code skip
     3937             view-as alert-box error .
     3938           undo, return error .
     3939         end.
     3940       end.
     3941       if buf_orig_parts.out-code <> p-out-code
     3942       then do:
     3943         find first buf_parts exclusive-lock
     3944           where buf_parts.obj-type  = buf_orig_parts.obj-type
     3945             and buf_parts.obj-code  = buf_orig_parts.obj-code
     3946             and buf_parts.artic     = buf_orig_parts.artic
     3947             and buf_parts.prod-type = buf_orig_parts.prod-type
     3948             and buf_parts.prod-code = buf_orig_parts.prod-code
     3949             and buf_parts.in-code   = buf_orig_parts.in-code
     3950             and buf_parts.out-code  = p-out-code
     3951             and buf_parts.part-code = buf_orig_parts.part-code
     3952           no-error.
     3953         if not available buf_parts
     3954         then do:
     3955           define variable v-rsrv-free as logical   no-undo .
     3956           if p-out-code = 'free-zone':U
     3957           or p-out-code = 'out-zone':U
     3958           then do:
     3959             assign
     3960               v-rsrv-free =
     3961          (if p-out-code = 'free-zone':U then yes else no)
     3962             .
     3963           end.
     3964           else do:
     3965             assign
     3966               v-rsrv-free = ?
     3967             .
     3968           end.
     3969           create buf_parts .
     3970           buffer-copy buf_orig_parts to buf_parts
     3971           assign
     3972             buf_parts.out-code  = p-out-code
     3973             buf_parts.status_   = no
     3974             buf_parts.rsrv-free = v-rsrv-free
     3975             buf_parts.qnty      = 0
     3976             buf_parts.fact-qnty = 0
     3977             buf_parts.real-qnty = 0
     3978             buf_parts.cli-qnty  = 0
     3979           .
     3980           validate buf_parts .
     3981         end.
     3982         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3983                                           ,input (buffer buf_orig_parts:handle)
     3984                                           ,output orig-part-key-rec).
     3985         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3986                                           ,input (buffer buf_parts:handle)
     3987                                           ,output part-key-rec).
     3988         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     3989               and ub.gen-attr.p-key =  orig-part-key-rec:
     3990             if not valid-object (objMarks)
     3991               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     3992               if p-out-code = 'free-zone':U
     3993               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     3994                then
     3995               do:
     3996                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     3997                   if objMarks:StatusErr
     3998                       then
     3999                   do:
     4000                       message objMarks:ReturnMsg view-as alert-box error.
     4001                       delete object objMarks no-error.
     4002                       undo, return error.
     4003                   end.
     4004               end.
     4005             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     4006             do:
     4007                 if p-mark <> "" then do:
     4008                 if p-out-code = 'free-zone':U then do:
     4009                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     4010                 end.
     4011                 else do:
     4012                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     4013                 end.
     4014                 if objMarks:StatusErr
     4015                   then
     4016                 do:
     4017                   message objMarks:ReturnMsg view-as alert-box error.
     4018                   delete object objMarks no-error.
     4019                   undo, return error.
     4020                 end.
     4021               end.
     4022             end.
     4023             if p-out-code = 'out-zone':U then
     4024             do:
     4025                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     4026                 if objMarks:StatusErr
     4027                     then
     4028                 do:
     4029                     message objMarks:ReturnMsg view-as alert-box error.
     4030                     delete object objMarks no-error.
     4031                     undo, return error.
     4032                 end.
     4033             end.
     4034         end.
     4035         delete object objMarks no-error.
     4036         if p-mark = "news" then return .
     4037         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     4038         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     4039         if not available buf_trn-doc
     4040         then
     4041            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     4042         if (
     4043             p-out-code = 'free-zone':U
     4044             and buf_orig_parts.in-code = buf_orig_parts.out-code
     4045            )
     4046         or
     4047            (
     4048             p-out-code = 'free-zone':U
     4049             and available pri_trn-doc
     4050             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     4051            )
     4052         or
     4053            (
     4054             available buf_trn-doc
     4055             and p-out-code = buf_trn-doc.doc-code
     4056             and buf_trn-doc.ext-doc-type = 'vt':U
     4057            )
     4058         or
     4059            (
     4060             p-mark = ""
     4061             and available buf_trn-doc
     4062             and p-out-code = 'free-zone':U
     4063             and buf_trn-doc.ext-doc-type = 'vt':U
     4064            )
     4065         or
     4066            (
     4067             p-mark = ""
     4068             and available buf_trn-doc
     4069             and p-out-code = 'free-zone':U
     4070             and buf_trn-doc.ext-doc-type = 'rs':U
     4071            )
     4072         then do :
     4073           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     4074             and ub.goods.prod-type = buf_parts.prod-type
     4075             and ub.goods.prod-code = buf_parts.prod-code.
     4076           def buffer buf_orig_ml for ub.marking-lines.
     4077           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     4078             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     4079             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     4080             and buf_orig_ml.in-code = buf_orig_parts.in-code
     4081             and buf_orig_ml.out-code = buf_orig_parts.out-code
     4082             and buf_orig_ml.part-code = buf_orig_parts.part-code
     4083             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     4084             if available pri_trn-doc
     4085             and pri_trn-doc.ext-doc-type = 'iv':U
     4086             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4087             then do :
     4088               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     4089                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     4090               end .
     4091               next .
     4092             end .
     4093             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     4094                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     4095                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     4096                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     4097                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     4098                                                   and ub.marking-lines.out-code = p-out-code
     4099                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     4100                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     4101                                                   no-error .
     4102             if not available ub.marking-lines
     4103             then do :
     4104               create ub.marking-lines.
     4105               buffer-copy buf_orig_ml to ub.marking-lines
     4106               assign
     4107                 ub.marking-lines.out-code  = p-out-code
     4108                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     4109               .
     4110               validate ub.marking-lines.
     4111             end .
     4112             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     4113             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     4114               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     4115               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     4116                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     4117                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     4118                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     4119                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     4120               then do:
     4121                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4122                 validate buf_marking.
     4123               end.
     4124             end .
     4125           end .
     4126           end.
     4127         end .
     4128         define variable v-doc-type  as character no-undo .
     4129         define variable   v-status    as character no-undo .
     4130         define variable v-fact-qnty   as  decimal no-undo .
     4131         define variable ii    as integer no-undo .
     4132         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     4133                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     4134                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     4135                                        .
     4136         if available pri_trn-doc
     4137         and pri_trn-doc.ext-doc-type = 'rs':U
     4138         then do :
     4139           if p-mark <> ""
     4140           then do :
     4141           end .
     4142           else do :
     4143           end .
     4144         end .
     4145         else do :
     4146           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     4147           and p-mark <> ""
     4148           then do :
     4149             if p-out-code = 'free-zone':U
     4150             then do:
     4151                 if chg-qnty < 0
     4152                 then do :
     4153                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     4154                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     4155                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4156                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4157                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4158                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4159                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4160                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4161                                                           no-error .
     4162                   if available orig_marking-lines
     4163                   then do :
     4164                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     4165                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     4166                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     4167                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     4168                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     4169                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     4170                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     4171                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     4172                                                            no-error .
     4173                     if not available buf_marking-lines
     4174                     then do :
     4175                       create buf_marking-lines .
     4176                       assign
     4177                         buf_marking-lines.mark       = p-mark
     4178                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4179                         buf_marking-lines.gds-code   = buf_goods.gds-code
     4180                         buf_marking-lines.obj-type   = buf_parts.obj-type
     4181                         buf_marking-lines.obj-code   = buf_parts.obj-code
     4182                         buf_marking-lines.in-code    = buf_parts.in-code
     4183                         buf_marking-lines.out-code   = buf_parts.out-code
     4184                         buf_marking-lines.part-code  = buf_parts.part-code
     4185                         buf_marking-lines.prt-code   = buf_parts.prt-code
     4186                       .
     4187                       validate buf_marking-lines.
     4188                     end .
     4189                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     4190                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4191                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     4192                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     4193                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     4194                                                         :
     4195                           assign buf_marking-chk.sts = 0 .
     4196                           validate buf_marking-chk.
     4197                         end .
     4198                       end .
     4199                       if buf_marking.unit-ext <> "UNIT" or
     4200                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     4201                       then do :
     4202                         run addChildMarkingLines in this-procedure (
     4203                           buf_marking.mark,
     4204                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     4205                           buffer buf_marking-lines,
     4206                           buffer buf_parts,
     4207                           buffer orig_marking-lines,
     4208                           buffer buf_orig_parts,
     4209                           buffer buf_goods
     4210                         ).
     4211                       end .
     4212                     end.
     4213                     find current orig_marking-lines exclusive-lock .
     4214                     delete orig_marking-lines .
     4215                   end .
     4216                 end .
     4217             end.
     4218             else do:
     4219               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     4220                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     4221                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4222                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4223                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4224                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4225                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4226                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4227                                                              no-error .
     4228                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     4229                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     4230                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     4231                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     4232                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     4233                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     4234                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     4235                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     4236                                                         no-error .
     4237                 if not available buf_marking-lines
     4238                 then do :
     4239                   create buf_marking-lines .
     4240                   assign
     4241                     buf_marking-lines.mark       = p-mark
     4242                     buf_marking-lines.doc-level  = 1
     4243                     buf_marking-lines.gds-code   = buf_goods.gds-code
     4244                     buf_marking-lines.obj-type   = buf_parts.obj-type
     4245                     buf_marking-lines.obj-code   = buf_parts.obj-code
     4246                     buf_marking-lines.in-code    = buf_parts.in-code
     4247                     buf_marking-lines.out-code   = buf_parts.out-code
     4248                     buf_marking-lines.part-code  = buf_parts.part-code
     4249                     buf_marking-lines.prt-code   = buf_parts.prt-code
     4250                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     4251                   .
     4252                   validate buf_marking-lines.
     4253                 end .
     4254                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     4255                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     4256                   validate buf_marking.
     4257                   for first buf_marking-childs exclusive-lock where
     4258                             buf_marking-childs.mark = buf_marking.mark-parent:
     4259                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     4260                     validate buf_marking-childs.
     4261                   end.
     4262                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     4263                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     4264                                                     and buf_chk-doc.out-code = buf_parts.out-code
     4265                                                     :
     4266                       if buf_marking-chk.sts <> 2 then
     4267                       do:
     4268                          assign buf_marking-chk.sts = 1 .
     4269                          validate buf_marking-chk.
     4270                       end.
     4271                     end .
     4272                   end .
     4273                   if buf_marking.unit-ext <> "UNIT" or
     4274                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     4275                   then do :
     4276                     run addChildMarkingLines in this-procedure (
     4277                       buf_marking.mark,
     4278                       buf_marking.sts,
     4279                       buffer buf_marking-lines,
     4280                       buffer buf_parts,
     4281                       buffer orig_marking-lines,
     4282                       buffer buf_orig_parts,
     4283                       buffer buf_goods
     4284                     ).
     4285                   end .
     4286                 end.
     4287                 if available orig_marking-lines then
     4288                   delete orig_marking-lines .
     4289             end.
     4290           end.
     4291         end .
     4292         if p-out-code = 'out-zone':U
     4293         and trim(p-mark) = ""
     4294         then do :
     4295           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4296                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4297                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4298                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4299                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4300                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4301                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4302                                                 :
     4303             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     4304                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     4305                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     4306                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     4307                                                     and buf_marking-lines.out-code   = p-out-code
     4308                                                     no-error .
     4309             if available buf_marking-lines
     4310             then do :
     4311               find current buf_marking-lines exclusive-lock .
     4312               delete buf_marking-lines .
     4313               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4314                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     4315                 then do :
     4316                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4317                   validate buf_marking.
     4318                 end.
     4319               end .
     4320             end .
     4321             else do :
     4322               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     4323               create buf_marking-lines .
     4324               assign
     4325                 buf_marking-lines.mark       = orig_marking-lines.mark
     4326                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4327                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4328                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4329                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4330                 buf_marking-lines.in-code    = buf_parts.in-code
     4331                 buf_marking-lines.out-code   = buf_parts.out-code
     4332                 buf_marking-lines.part-code  = buf_parts.part-code
     4333                 buf_marking-lines.prt-code   = buf_parts.prt-code
     4334               .
     4335               validate buf_marking-lines.
     4336               if buf_parts.out-code <> buf_parts.in-code
     4337               and buf_parts.out-code <> 'free-zone':U
     4338               and buf_parts.out-code <> 'out-zone':U
     4339               then do :
     4340                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4341                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4342               end .
     4343               end.
     4344             end .
     4345             release buf_marking-lines no-error .
     4346           end.
     4347         end .
     4348         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     4349         then do:
     4350           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     4351                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     4352                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4353                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4354                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4355                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4356                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4357                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4358                                                   .
     4359             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     4360                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     4361                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     4362                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     4363                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     4364                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     4365                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     4366                                                    no-error .
     4367             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     4368               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4369                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     4370               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4371                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     4372               validate ub.marking.
     4373             end.
     4374             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     4375             if available (buf_marking-lines)
     4376             then do:
     4377               assign
     4378                 buf_marking-lines.mark       = p-mark
     4379                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4380                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4381                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4382                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4383                 buf_marking-lines.in-code    = buf_parts.in-code
     4384                 buf_marking-lines.out-code   = buf_parts.out-code
     4385                 buf_marking-lines.part-code  = buf_parts.part-code
     4386               .
     4387               validate buf_marking-lines.
     4388             end.
     4389           end.
     4390         end.
     4391       end.
     4392       else do:
     4393         find first buf_parts exclusive-lock
     4394           where recid(buf_parts) = recid(buf_orig_parts)
     4395           .
     4396       end.
     4397       if p-out-code = 'free-zone':U
     4398       or p-out-code = 'out-zone':U
     4399       then do:
     4400         if buf_parts.rsrv-free <>
     4401          (if buf_parts.out-code = 'free-zone':U then yes else no)
     4402         then do:
     4403           message
     4404             vss-workfile vss-revision vss-description skip
     4405             vss-include-info24 skip
     4406             "Ошибка типа резерва партии" skip
     4407             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     4408             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4409             "Партия" buf_parts.in-code buf_parts.part-code skip
     4410             "Резерв" buf_parts.out-code skip
     4411             "Статус" buf_parts.status_ skip
     4412             "Тип резерва" buf_parts.rsrv-free skip
     4413             view-as alert-box error .
     4414           undo, return error .
     4415         end.
     4416       end.
     4417     end.
     4418   end procedure.
     4419   procedure partcopy-to-childs-mark :
     4420     define parameter buffer buf_ml for ub.marking-lines .
     4421     define parameter buffer buf_orig-ml for ub.marking-lines .
     4422     define input parameter p-out-code as character no-undo .
     4423     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     4424     define buffer buf_ml-childs for ub.marking-lines .
     4425     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     4426       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4427         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     4428       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4429         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     4430       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     4431         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     4432         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     4433         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     4434         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     4435         and buf_ml-childs.part-code = buf_orig-ml.part-code
     4436         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     4437         :
     4438         assign
     4439           buf_ml-childs.out-code  = p-out-code
     4440         .
     4441         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     4442       end.
     4443     end.
     4444   end.
     4445   procedure partcopy-update-parts :
     4446     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4447     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     4448     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     4449     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4450     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4451     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4452     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     4453     define buffer buf_trn-doc for ub.trn-doc .
     4454     define buffer archive_parts for ub.parts .
     4455     define buffer buf_parts   for ub.parts .
     4456     define buffer orig_marking-lines for ub.marking-lines .
     4457     define buffer buf_marking for ub.marking .
     4458     define buffer buf_goods for ub.goods .
     4459     define variable v-rsrv-code     as character no-undo .
     4460     define variable v-goods-twounit as logical   no-undo .
     4461     define variable v-value-character as character no-undo .
     4462     define variable v-value-date      as date no-undo .
     4463     define variable v-value-decimal   as decimal no-undo .
     4464     define variable v-value-integer   as integer no-undo .
     4465     define variable v-izlcstpr        as logical no-undo .
     4466     define variable v-tth             as handle no-undo .
     4467     define variable v-type            as character no-undo .
     4468     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     4469     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     4470     do
     4471     on error undo, return error return-value
     4472     :
     4473       find first buf_trn-doc no-lock
     4474         where buf_trn-doc.doc-code = p-doc-code
     4475         no-error .
     4476       if not available buf_trn-doc
     4477       then do:
     4478         message
     4479           vss-workfile vss-revision vss-description skip
     4480           vss-include-info24 skip
     4481           "Ошибка задания входных параметров" skip
     4482           "Не найден документ" skip
     4483           "Документ" p-doc-code skip
     4484           "Объект" p-obj-type p-obj-code skip
     4485           "Артикул" p-artic p-prod-type p-prod-code skip
     4486           error-status :get-message(1) skip
     4487           return-value skip
     4488           view-as alert-box error .
     4489         undo, return error .
     4490       end.
     4491       find first buf_goods no-lock where buf_goods.artic = p-artic
     4492                                      and buf_goods.prod-type = p-prod-type
     4493                                      and buf_goods.prod-code = p-prod-code
     4494                                      no-error .
     4495       if not available buf_goods
     4496       then do:
     4497         message
     4498           vss-workfile vss-revision vss-description skip
     4499           vss-include-info24 skip
     4500           "Ошибка задания входных параметров" skip
     4501           "Не найден товар" skip
     4502           "Документ" p-doc-code skip
     4503           "Объект" p-obj-type p-obj-code skip
     4504           "Артикул" p-artic p-prod-type p-prod-code skip
     4505           error-status :get-message(1) skip
     4506           return-value skip
     4507           view-as alert-box error .
     4508         undo, return error .
     4509       end.
     4510       if buf_trn-doc.ext-doc-type = 'vt':U
     4511       then do :
     4512           delete object v-tth no-error.
     4513           run adm/shattri.p (
     4514              input "get":U
     4515             ,input buf_trn-doc.obj-type
     4516             ,input buf_trn-doc.obj-code
     4517             ,input 'inv-obj':U
     4518             ,input  "izlcstpr"
     4519             ,output v-value-character
     4520             ,output v-value-date
     4521             ,output v-value-decimal
     4522             ,output v-value-integer
     4523             ,output v-izlcstpr
     4524             ,output v-type
     4525             ,INPUT-OUTPUT table-handle v-tth
     4526             ) no-error .
     4527             delete object v-tth no-error.
     4528           if error-status:error then do:
     4529             v-izlcstpr = false .
     4530           end.
     4531       end.
     4532       else do :
     4533           v-izlcstpr = false .
     4534       end.
     4535   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4536   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4537     (input  p-artic
     4538     ,input  p-prod-type
     4539     ,input  p-prod-code
     4540     ,input  'twounit=request':u
     4541     ,output v-goods-twounit
     4542     ) no-error .
     4543       if error-status :error
     4544       then do:
     4545         message
     4546           vss-workfile vss-revision vss-description skip
     4547           vss-include-info24 skip
     4548           "Ошибка при определении атрибута товара" skip
     4549           "Артикул" p-artic p-prod-type p-prod-code skip
     4550           error-status :get-message(1) skip
     4551           return-value skip
     4552           view-as alert-box error .
     4553         undo, return error .
     4554       end.
     4555       define query partcopy-select-parts for archive_parts .
     4556       open query partcopy-select-parts preselect each archive_parts
     4557         where archive_parts.obj-type  = p-obj-type
     4558           and archive_parts.obj-code  = p-obj-code
     4559           and archive_parts.artic     = p-artic
     4560           and archive_parts.prod-type = p-prod-type
     4561           and archive_parts.prod-code = p-prod-code
     4562           and archive_parts.out-code  = p-doc-code
     4563         .
     4564       get first partcopy-select-parts .
     4565       if buf_trn-doc.doc-type = 'при':U
     4566       then do:
     4567         do while available archive_parts
     4568         on error undo, return error return-value
     4569         :
     4570           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     4571           or (buf_trn-doc.doc-type = 'инв':U
     4572               and archive_parts.fact-qnty < 0)
     4573           then do:
     4574             assign
     4575               v-rsrv-code = 'out-zone':U
     4576             .
     4577           end.
     4578           else do:
     4579             assign
     4580               v-rsrv-code = 'free-zone':U
     4581             .
     4582           end.
     4583           assign
     4584             archive_parts.status_   = yes
     4585             archive_parts.rsrv-free = ?
     4586           .
     4587           if archive_parts.in-code = p-doc-code
     4588           then do:
     4589             assign
     4590               archive_parts.fact-num  = buf_trn-doc.fact-num
     4591               archive_parts.fact-date = buf_trn-doc.fact-date
     4592               archive_parts.doc-type  = buf_trn-doc.doc-type
     4593             .
     4594           end.
     4595           if archive_parts.fact-qnty <> 0
     4596           then do:
     4597             run partcopy in this-procedure
     4598               (input  true
     4599               ,input  v-rsrv-code
     4600               ,buffer archive_parts
     4601               ,buffer buf_parts
     4602               ,input  ""
     4603               ) no-error .
     4604             if error-status :error
     4605             then do:
     4606               message
     4607                 vss-workfile vss-revision vss-description skip
     4608                 vss-include-info24 skip
     4609                 "Ошибка при создании партии" skip
     4610                 "Документ" p-doc-code skip
     4611                 "Объект" p-obj-type p-obj-code skip
     4612                 "Артикул" p-artic p-prod-type p-prod-code skip
     4613                 "Партия" archive_parts.in-code archive_parts.part-code skip
     4614                 "Резерв" v-rsrv-code skip
     4615                 error-status :get-message(1) skip
     4616                 return-value skip
     4617                 view-as alert-box error .
     4618               undo, return error .
     4619             end.
     4620             assign
     4621               buf_parts.qnty      = buf_parts.qnty     + archive_parts.fact-qnty
     4622               buf_parts.fact-qnty = buf_parts.qnty
     4623             .
     4624             if v-goods-twounit = true
     4625             then do:
     4626               assign
     4627                 buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     4628               .
     4629               case buf_trn-doc.ext-doc-type :
     4630                 when 'ie':U
     4631                 then do:
     4632                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     4633                   then do:
     4634                     message
     4635                       vss-workfile vss-revision vss-description skip
     4636                       vss-include-info24 skip
     4637                       "Клиентское количество для товара," skip
     4638                       "который учитывается по двум единицам измерения" skip
     4639                       "должно равняться единице" skip
     4640                       "Документ" p-doc-code skip
     4641                       "Объект" p-obj-type p-obj-code skip
     4642                       "Артикул" p-artic p-prod-type p-prod-code skip
     4643                       "Партия" archive_parts.in-code archive_parts.part-code skip
     4644                       "Количество по документу" archive_parts.qnty skip
     4645                       "Фактическое количество" archive_parts.fact-qnty skip
     4646                       "Клиентское количество" archive_parts.cli-qnty skip
     4647                       view-as alert-box error .
     4648                     undo, return error .
     4649                   end.
     4650                 end.
     4651                 when 'iv':U
     4652                 then do:
     4653                   if archive_parts.cli-qnty <> 1
     4654                   then do:
     4655                     message
     4656                       vss-workfile vss-revision vss-description skip
     4657                       vss-include-info24 skip
     4658                       "Клиентское количество для товара," skip
     4659                       "который учитывается по двум единицам измерения" skip
     4660                       "должно равняться единице" skip
     4661                       "Документ" p-doc-code skip
