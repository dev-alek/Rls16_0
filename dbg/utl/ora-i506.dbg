     7075     ) no-error .
     7076         for each ub.marking-lines where ub.marking-lines.gds-code = v-gds-code
     7077           and ub.marking-lines.obj-type = buf_parts.obj-type
     7078           and ub.marking-lines.obj-code = buf_parts.obj-code
     7079           and ub.marking-lines.in-code = buf_parts.in-code
     7080           and ub.marking-lines.out-code = buf_parts.out-code
     7081           and ub.marking-lines.part-code = buf_parts.part-code
     7082           and ub.marking-lines.prt-code = buf_parts.prt-code:
     7083             if chg-qnty < 0
     7084             then do :
     7085               for first ub.marking exclusive-lock where ub.marking.mark = ub.marking-lines.mark :
