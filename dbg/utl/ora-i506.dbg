     5266           error-status :get-message(1) skip
     5267           return-value skip
     5268           view-as alert-box error .
     5269         undo, return error .
     5270       end.
     5271       if buf_trn-doc.ext-doc-type = 'vt':U
     5272       then do :
     5273           delete object v-tth no-error.
     5274           run adm/shattri.p (
     5275              input "get":U
     5276             ,input buf_trn-doc.obj-type
     5277             ,input buf_trn-doc.obj-code
     5278             ,input 'inv-obj':U
     5279             ,input  "izlcstpr"
     5280             ,output v-value-character
