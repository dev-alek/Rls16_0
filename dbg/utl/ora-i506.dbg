     7040         end.
     7041         define variable part-key-rec_free as character no-undo .
     7042         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     7043                                           ,input (buffer buf_parts:handle)
     7044                                           ,output part-key-rec).
     7045         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     7046                                               and ub.gen-attr.p-key =  part-key-rec :
     7047           if (entry (8,part-key-rec,chr(3)) <> 'free-zone':U) and (entry (8,part-key-rec,chr(3)) <> entry (7,part-key-rec,chr(3))) then do:
     7048           part-key-rec_free = part-key-rec .
     7049           entry (8,part-key-rec_free,chr(3)) = 'free-zone':U .
     7050           find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     7051                       and buf_gen-attr.attr-code = ub.gen-attr.attr-code
     7052                       and num-entries (buf_gen-attr.p-key, chr(3)) >= 8
     7053                       and entry(8, buf_gen-attr.p-key, chr(3)) = 'free-zone':U
     7054                       no-error .
     7055                   if not available (buf_gen-attr) then
     7056                   do:
     7057                       create buf_gen-attr.
     7058                       buffer-copy ub.gen-attr except ub.gen-attr.p-key to buf_gen-attr .
     7059                       assign
     7060                           buf_gen-attr.p-key = part-key-rec_free
     7061                           .
     7062                   end.
     7063           end.
     7064           find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
