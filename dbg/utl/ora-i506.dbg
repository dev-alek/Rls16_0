       77   define output parameter p-ok-doc as integer   no-undo .
       78   define variable vss-revision    as character no-undo init "$Revision: 220955104cd9, 2417, rls $":U .
       79   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       80   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:46 2020 +0300 $":U .
       81   define variable vss-workfile    as character no-undo init "$Workfile: ora-i506.p $":U .
       82   define variable vss-archive     as character no-undo init "$Archive: utl/ora-i506.p $":U .
