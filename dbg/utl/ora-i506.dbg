     7087                                                         and free_marking-lines.gds-code   = ub.marking-lines.gds-code
     7088                                                         and free_marking-lines.obj-type   = ub.marking-lines.obj-type
     7089                                                         and free_marking-lines.obj-code   = ub.marking-lines.obj-code
     7090                                                         and free_marking-lines.in-code    = ub.marking-lines.in-code
     7091                                                         and free_marking-lines.out-code   = 'free-zone':U
     7092                                                         and free_marking-lines.part-code  = ub.marking-lines.part-code
     7093                                                         and free_marking-lines.prt-code   = ub.marking-lines.prt-code
     7094                                                         no-error .
     7095                 if not available free_marking-lines
     7096                 then do :
     7097                   create free_marking-lines .
