      101   procedure vss-get-parameters :
      102     define output parameter p-vss-parameters as character no-undo .
      103   end procedure.
      104   define new global shared variable g#vssrevis-logger as handle    no-undo .
      105   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      106   define variable v-vssrevis-logger                   as handle    no-undo .
      107   procedure vss-logevent :
      108     define input  parameter p-extra-paramters as character no-undo .
      109     define variable v-vssrevis-parameters as character no-undo .
      110     do
      111     on error undo, return error return-value
      112     :
      113       if  valid-handle(v-vssrevis-logger)
      114       and v-vssrevis-logger :get-signature("logevent") <> ""
      115       then do:
      116         run vss-get-parameters in this-procedure
      117           (output v-vssrevis-parameters
      118           ).
      119         run logevent in v-vssrevis-logger
      120           (input vss-workfile
      121           ,input vss-revision
      122           ,input v-vssrevis-parameters
      123           ,input p-extra-paramters
      124           ).
      125       end.
      126     end.
      127   end procedure.
      128   assign
      129     v-vssrevis-logger = g#vssrevis-logger
      130   .
      131   if  valid-handle(v-vssrevis-logger)
      132   and v-vssrevis-logger :get-signature("logevent") <> ""
      133   then do:
      134     assign
      135       v-vssrevis-logevent = true
      136     .
      137     run vss-logevent in this-procedure (input vss-description) .
      138   end.
      139   define new global shared variable g#language as character no-undo .
      140   if g#language <> '' and g#language <> 'rus':U then do:
      141     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      142   end.
      143   define new global shared variable g#library  as handle no-undo .
      144   define new global shared variable g#library2 as handle no-undo .
      145   define new global shared variable g#lib-trn  as handle no-undo .
      146   define new global shared variable g#lib-trn2 as handle no-undo .
      147   define new global shared variable g#lib-trn3 as handle no-undo .
      148   define new global shared variable g#lib-trn4 as handle no-undo .
      149   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      150   define variable to-day       as date no-undo .
      151   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   procedure doc-code:
      153   define input  parameter parmode          as   character           no-undo.
      154   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      155   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      156   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      157   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      158   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      159   define variable vardb-remote     as   logical             no-undo.
      160   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      161   define variable v-delimiter as character no-undo .
      162   do
      163   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      164   :
      165   find first buf_sys-ctrl no-lock .
      166   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      167     CASE parmode:
      168       when "main":u then do:
      169         if vardb-remote then do:
      170           assign
      171             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      172         end.
      173         else do:
      174           assign
      175             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      176         end.
      177       end.
      178       when "trio" then do:
      179         assign
      180           pardoc-code = replace (parroot-doc-code, "=", "*").
      181       end.
      182       otherwise do:
      183         assign
      184         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      185         no-error
      186         .
      187         if error-status:error  then do:
      188           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      189                                         ,chr(10)
      190                                         ,parmode
      191                                         ).
      192         end.
      193         if num-entries(parmode) = 1
      194         and parmode <> "chip":U
      195         and parmode <> "chip_s":U
      196         then do:
      197           assign
      198           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      199         end.
      200         else if (lookup("chip":U, parmode) > 0
      201                  or
      202                  lookup("chip_s":U, parmode) > 0) then do:
      203           assign
      204             vartemp-doc-code = parroot-doc-code.
      205           do while true:
      206             if index (vartemp-doc-code , ".") = 0 then
      207               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      208             else
      209               vartemp-doc-code  =
      210               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      211               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      212               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      213             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      214           end.
      215           assign
      216             pardoc-code = vartemp-doc-code.
      217         end.
      218       end.
      219     end CASE.
      220     if pardoc-code = '':U
      221     or (parroot-doc-code <> '':U
      222     and pardoc-code = parroot-doc-code) then do:
      223       undo, return error substitute("Ошибка при генерации номера документа&1"
      224                                     ,chr(10)).
      225     end.
      226   end.
      227   end. // procedure/method
      228   function get-doc-code-int64 returns int64
      229     ( input p-doc-code as character ) :
      230     define variable v-ind              as integer   no-undo .
      231     define variable v-num-entries      as integer   no-undo .
      232     define variable v-doc-code-int64   as int64     no-undo .
      233     define variable v-canonic-doc-code as character no-undo .
      234     assign
      235       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      236       v-canonic-doc-code = p-doc-code
      237     .
      238     do v-ind = 1 to v-num-entries
      239     :
      240       assign
      241         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      242       .
      243     end.
      244     assign
      245       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      246     .
      247     return v-doc-code-int64 .
      248   end. // function/method
      249   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   define variable v-waitfram-action01         as character   no-undo .
      251   define variable v-waitfram-action02         as character   no-undo .
      252   define variable v-waitfram-action03         as character   no-undo .
      253   define variable mWaitFramTextBeg            as character   no-undo.
      254   define variable mWaitFramTextEnd            as character   no-undo.
      255   define variable mWaitFramView               as logical     no-undo.
      256   define variable mWaitProcEvent              as logical     no-undo init yes.
      257   define variable mWaitFramInterval           as integer     no-undo init 1 .
      258   define variable mWaitFramStop               as logical     no-undo.
      259   define variable mWaitFramStopUser           as logical     no-undo.
      260   define variable mWaitFramStopTimeOut        as logical     no-undo.
      261   define variable mWaitFramStartProc          as datetime-tz no-undo.
      262   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      263   define button B-WaitFramStop auto-end-key
      264        label "Стоп"
      265        size 10 by 1 tooltip "Остоновить процесс".
      266   define button B-viewProcInfo
      267        label "Информация"
      268        size 15 by 1 tooltip "Информация о процесс".
      269   define frame waitfram
      270     v-waitfram-action01 format "x(72)" no-label skip
      271     v-waitfram-action02 format "x(72)" no-label skip
      272     v-waitfram-action03 format "x(72)" no-label skip
      273     B-viewProcInfo
      274     B-WaitFramStop at row 4 col 30
      275     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      276     .
      277   define new global shared variable mBatchMode as logical no-undo init ?.
      278   define variable mFramBachModHandle as handle no-undo.
      279   mFramBachModHandle = frame waitfram:handle.
      280   define variable mFameOldVis as logical no-undo.
      281   define variable mVisCUrentVin as logical no-undo.
      282   if session:batch-mode
      283   then
      284      mBatchMode = yes.
      285   if mBatchMode = ? then do:
      286     mVisCUrentVin = current-window:visible.
      287     mFameOldVis = mFramBachModHandle:visible.
      288     mFramBachModHandle:visible  = yes.
      289     mBatchMode = mFramBachModHandle:visible ne yes.
      290     mFramBachModHandle:visible = mFameOldVis.
      291     current-window:visible = mVisCUrentVin.
      292   end.
      293    if  log-manager:logfile-name ne ?
      294     then DO:
      295         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      296         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      297         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      298     end.
      299   on choose of B-WaitFramStop in frame waitfram
      300   do:
      301     mWaitFramStop = yes.
      302     mWaitFramStopUser = yes.
      303   end.
      304   function waitfram-check-timeout returns logical():
      305      define variable vtime as int64 no-undo.
      306      if mWaitFramStopTimeOut
      307      then
      308         return yes.
      309      vtime = ( now - mWaitFramStartProc ) / 1000 .
      310      if     mWaitFramTimeOut ne ?
      311         and mWaitFramTimeOut ne 0
      312         and mWaitFramTimeOut lt vtime
      313      then do:
      314         mWaitFramStopTimeOut = yes.
      315      end.
      316      return mWaitFramStopTimeOut.
      317   end.
      318   procedure waitfram-hide :
      319     if not session:batch-mode
      320     then do
      321     on error undo, return error return-value
      322     :
      323       pause 0 before-hide .
      324       if not mBatchMode then
      325         hide frame waitfram .
      326     if     not mWaitFramView
      327        and mWaitProcEvent
      328     then
      329       process events .
      330     end.
      331   end procedure.
      332   procedure waitfram-show :
      333     define input  parameter p-message as character no-undo .
      334     define variable v-left-margin as integer   no-undo .
      335     if not session:batch-mode
      336     then do
      337     on error undo, return error return-value
      338     :
      339       if length(p-message) <= 70 then do:
      340         assign
      341           v-left-margin = integer((70 - length(p-message)) / 2)
      342         .
      343         assign
      344           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      345         .
      346         assign
      347           v-waitfram-action01 = " "
      348           v-waitfram-action02 = " "
      349                                    + fill(" ", v-left-margin)
      350                                    + p-message
      351           v-waitfram-action03 = " "
      352         .
      353       end.
      354       else do:
      355         define variable vRindex1 as integer no-undo.
      356         define variable vRindex2 as integer no-undo.
      357         vRindex1 = r-index(p-message," ",70).
      358         if vRindex1 = 0
      359         then
      360            vRindex1 = 70.
      361         if length(p-message)  <= vRindex1 + 70 then do:
      362           assign
      363             v-waitfram-action01 = " "
      364             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      365             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      366           .
      367         end.
      368         else do:
      369           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      370           if vRindex2 <= vRindex1
      371           then
      372              vRindex2 = vRindex1 + 70.
      373           assign
      374             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      375             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      376             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      377           .
      378         end.
      379       end.
      380       B-viewProcInfo:visible   in frame waitfram = no.
      381       B-viewProcInfo:sensitive in frame waitfram = no.
      382       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      383       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      384       if  (   mWaitFramView
      385          or  mWaitProcEvent)
      386          and not mBatchMode
      387       then
      388          display
      389             v-waitfram-action01 skip
      390             v-waitfram-action02 skip
      391             v-waitfram-action03 skip
      392          with frame waitfram .
      393       if     mWaitFramView
      394          then do:
      395             if     mWaitFramInterval ne ?
      396                and not mBatchMode
      397             then
      398                wait-for go of frame waitfram pause mWaitFramInterval.
      399          end.
      400          else
      401             if     mWaitProcEvent
      402                and not mBatchMode
      403             then
      404                process events .
      405     end.
      406   end procedure.
      407      procedure waitfram-show-this:
      408         define input  parameter iInterval as int64 no-undo.
      409         define variable vtime as int64 no-undo.
      410         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      411         mWaitFramInterval = iInterval.
      412         run waitfram-show (substitute("&1&2 &3&4" ,
      413                                       mWaitFramTextBeg ,
      414                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      415                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      416                                       mWaitFramTextEnd
      417                                      )
      418                           ).
      419      end.
      420      procedure WaitFramRunPause:
      421         define input  parameter iInterval as dec no-undo.
      422         define variable vStart  as datetime-tz no-undo.
      423         define variable vend    as datetime-tz no-undo.
      424         define variable vint as int64 no-undo.
      425         define variable vOk as logical no-undo.
      426         vStart = now.
      427         vend   = vStart.
      428         publish "WaitFramPause" (iInterval,output vOk).
      429         vend   =  now.
      430         vint = vend - vStart.
      431         vint = iInterval - vint / 1000.
      432         if     not mWaitFramStop
      433            and (   vint > 0
      434                 or (    not vOk
      435                     and iInterval eq ?
      436                     )
      437                 )
      438         then
      439            run waitfram-show-this (iInterval).
      440         vend   =  now.
      441         vint = vend - vStart.
      442         vint = iInterval - vint / 1000.
      443         if     not mWaitFramStop
      444            and vint > 0
      445         then do:
      446            run gbl/pause.p (vint * 1000).
      447         end.
      448         if iInterval ne ?
      449         then
      450            publish "WaitFramStop".
      451         waitfram-check-timeout().
      452      end.
      453      procedure WaitFramWaitFor:
      454         define input  parameter iInterval as dec no-undo.
      455         assign
      456            mWaitFramStartProc   = now
      457            mWaitFramStopUser    = no
      458            mWaitFramStopTimeOut = no
      459         .
      460         block-wait:
      461         do while not mWaitFramStop:
      462            run WaitFramRunPause (iInterval).
      463            if  waitfram-check-timeout()
      464            then do:
      465               leave block-wait.
      466            end.
      467         end.
      468         run waitfram-hide.
      469      end.
      470   procedure waitfram-join :
      471     define input  parameter p-line-1  as character no-undo .
      472     define input  parameter p-line-2  as character no-undo .
      473     define input  parameter p-line-3  as character no-undo .
      474     define output parameter p-message as character no-undo .
      475     do
      476     on error undo, return error return-value
      477     :
      478       assign
      479         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      480                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      481                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      482       .
      483     end.
      484   end procedure.
      485   function waitfram-join-function returns character
      486     (input p-line-1 as character
      487     ,input p-line-2 as character
      488     ,input p-line-3 as character
      489     ).
      490     define variable v-message as character no-undo .
      491     run waitfram-join in this-procedure
      492       (input  p-line-1
      493       ,input  p-line-2
      494       ,input  p-line-3
      495       ,output v-message
      496       ) .
      497     return v-message .
      498   end function .
      499   function cross-list returns logical (
      500     input parfirst-stream  as character,
      501     input parsecond-stream as character,
      502     input pardelim         as character).
      503     if pardelim = ""
      504     or pardelim = ?
      505     then do:
      506       assign
      507         pardelim = ","
      508       .
      509     end.
      510     define variable vari            as integer no-undo .
      511     define variable varresult-cross as logical no-undo .
      512     assign
      513       varresult-cross = no
      514     .
      515     def var v-num-parfirst-stream as integer no-undo .
      516     assign
      517       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      518     .
      519     do vari = 1 to v-num-parfirst-stream
      520     :
      521       if lookup(entry(vari, parfirst-stream, pardelim)
      522                ,parsecond-stream
      523                ,pardelim
      524                ) > 0 then do:
      525         assign
      526           varresult-cross = yes
      527         .
      528         leave.
      529       end.
      530     end.
      531     return varresult-cross .
      532   end function.
