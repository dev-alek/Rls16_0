     7248   MAIN-BLOCK:
     7249   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     7250      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     7251      for each  temp_trn-doc :
     7252          if temp_trn-doc.cli-code = - 1
     7253           then is-tsd = true.
     7254          if temp_trn-doc.cli-code = - 2
     7255           then is-egais = true.
     7256          for each temp_gds-line where
     7257                   temp_gds-line.line-num = temp_trn-doc.line-num :
     7258              if temp_gds-line.doc-code <> temp_trn-doc.doc-code then do:
     7259                 assign
     7260                     v-end-message =  substitute("Не верно указан doc-code &1 &2  товар &3" ,
     7261                     temp_gds-line.doc-code ,
     7262                     temp_trn-doc.doc-code ,
     7263                     temp_gds-line.gds-code
     7264                     ).
     7265                 run pcall-log-file in p-log-handle (input v-end-message) .
     7266                 undo, return error v-end-message.
     7267              end.
     7268          end.
     7269          for each temp_grp-line where
     7270                   temp_grp-line.line-num = temp_trn-doc.line-num :
