     5283             ,output v-value-integer
     5284             ,output v-izlcstpr
     5285             ,output v-type
     5286             ,INPUT-OUTPUT table-handle v-tth
     5287             ) no-error .
     5288             delete object v-tth no-error.
     5289           if error-status:error then do:
     5290             v-izlcstpr = false .
     5291           end.
     5292       end.
     5293       else do :
     5294           v-izlcstpr = false .
     5295       end.
