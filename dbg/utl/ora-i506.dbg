     5137                   (input  true
     5138                   ,input  v-rsrv-code
     5139                   ,buffer archive_parts
     5140                   ,buffer buf_parts
     5141                   ,input  ""
     5142                   ) no-error .
     5143                 if error-status :error
     5144                 then do:
     5145                   message
     5146                     vss-workfile vss-revision vss-description skip
     5147                     vss-include-info24 skip
     5148                     "Ошибка при создании партии" skip
     5149                     "Документ" p-doc-code skip
     5150                     "Объект" p-obj-type p-obj-code skip
     5151                     "Артикул" p-artic p-prod-type p-prod-code skip
     5152                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5153                     "Резерв" v-rsrv-code skip
     5154                     error-status :get-message(1) skip
     5155                     return-value skip
     5156                     view-as alert-box error .
     5157                   undo, return error .
     5158                 end.
     5159                 assign
     5160                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
     5161                   buf_parts.fact-qnty = buf_parts.qnty
     5162                 .
     5163                 if buf_trn-doc.ext-doc-type = 'rv':U
     5164                 then
     5165                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5166                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     5167                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     5168                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     5169                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     5170                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     5171                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     5172                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5173                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     5174                   then
     5175                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5176                 end .
     5177                 if v-goods-twounit = true
     5178                 then do:
     5179                   message
     5180                     vss-workfile vss-revision vss-description skip
     5181                     vss-include-info24 skip
     5182                     "Запрещено порождение партий," skip
     5183                     "который учитывается по двум единицам измерения" skip
     5184                     "Документ" p-doc-code skip
     5185                     "Объект" p-obj-type p-obj-code skip
     5186                     "Артикул" p-artic p-prod-type p-prod-code skip
     5187                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5188                     "Количество по документу" archive_parts.qnty skip
     5189                     "Фактическое количество" archive_parts.fact-qnty skip
     5190                     "Клиентское количество" archive_parts.cli-qnty skip
     5191                     view-as alert-box error .
     5192                   undo, return error .
     5193                 end.
     5194                 else do:
     5195                   if buf_parts.cli-base-rate <> 0
     5196                   then do:
     5197                     assign
     5198                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5199                     .
     5200                   end.
     5201                   else do:
     5202                     assign
     5203                       buf_parts.cli-qnty = 0
     5204                     .
     5205                   end.
     5206                 end.
     5207             end.
     5208           end.
     5209           get next partcopy-select-parts .
     5210         end.
     5211       end.
     5212     end.
     5213   end procedure.
     5214   procedure partcopy-update-parts-delete :
     5215     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     5216     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
