     5952   procedure partcopy-rsrv-parts :
     5953     define input  parameter p-doc-code-rowid as rowid no-undo .
     5954     define input  parameter p-parts-rowid    as rowid no-undo .
     5955     define input  parameter p-rsrv-direction as logical   no-undo .
     5956     define input  parameter p-goods-twounit  as logical   no-undo .
     5957     define input  parameter p-is-hold        as logical   no-undo .
     5958     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     5959     define buffer buf_trn-doc for ub.trn-doc .
     5960     define buffer archive_parts for ub.parts .
     5961     define buffer buf_parts   for ub.parts .
     5962     define buffer orig_marking-lines for ub.marking-lines .
     5963     define buffer buf_marking-lines for ub.marking-lines .
     5964     define buffer buf_marking   for ub.marking .
     5965     define buffer buf_goods for ub.goods .
     5966     define variable v-rsrv-code as character no-undo .
     5967     do
     5968     on error undo, return error return-value
     5969     :
     5970       find first buf_trn-doc no-lock
     5971         where rowid(buf_trn-doc) = p-doc-code-rowid
     5972         no-error .
     5973       if not available buf_trn-doc
     5974       then do:
     5975         message
     5976           vss-workfile vss-revision vss-description skip
     5977           vss-include-info24 skip
     5978           "Ошибка задания входных параметров" skip
     5979           "Не найден документ" skip
     5980           "Документ" string(p-doc-code-rowid) skip
     5981           "Партия" string(p-parts-rowid) skip
     5982           error-status :get-message(1) skip
     5983           return-value skip
     5984           view-as alert-box error .
     5985         undo, return error .
     5986       end.
     5987       find first archive_parts
     5988         where rowid(archive_parts) = p-parts-rowid
     5989         no-error .
     5990       if not available archive_parts
     5991       then do:
     5992         message
     5993           vss-workfile vss-revision vss-description skip
     5994           vss-include-info24 skip
     5995           "Ошибка задания входных параметров" skip
     5996           "Не найдена партия" skip
     5997           "Документ" string(p-doc-code-rowid) skip
     5998           "Партия" string(p-parts-rowid) skip
     5999           error-status :get-message(1) skip
     6000           return-value skip
     6001           view-as alert-box error .
     6002         undo, return error .
     6003       end.
     6004       if  archive_parts.out-code <> archive_parts.in-code
     6005       and archive_parts.qnty <> 0
     6006       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     6007       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     6008       then do:
     6009         assign
     6010           v-rsrv-code =
     6011           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     6012         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     6013         then 'free-zone':U
     6014         else 'out-zone':U )
     6015         .
     6016         run partcopy in this-procedure
     6017           (input  true
     6018           ,input  v-rsrv-code
     6019           ,buffer archive_parts
     6020           ,buffer buf_parts
     6021           ,input  "news"
     6022           ) no-error .
     6023         if error-status :error
     6024         then do:
     6025           message
     6026             vss-workfile vss-revision vss-description skip
     6027             vss-include-info24 skip
     6028             "Ошибка при создании партии" skip
     6029             "Документ" buf_trn-doc.doc-code skip
     6030             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     6031             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     6032             "Партия" archive_parts.in-code archive_parts.part-code skip
     6033             "Количество" archive_parts.qnty skip
     6034             "Резерв" v-rsrv-code skip
     6035             error-status :get-message(1) skip
     6036             return-value skip
     6037             view-as alert-box error .
     6038           undo, return error .
     6039         end.
     6040         assign
     6041           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     6042                                                     * (if p-rsrv-direction = true
     6043                                                       then 1
     6044                                                       else -1
     6045                                                       )
     6046           buf_parts.fact-qnty = buf_parts.qnty
     6047         .
     6048         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     6049                                        and buf_goods.prod-type = archive_parts.prod-type
     6050                                        and buf_goods.prod-code = archive_parts.prod-code
     6051                                        .
     6052         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     6053                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     6054                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     6055                                               and orig_marking-lines.in-code    = archive_parts.in-code
     6056                                               and orig_marking-lines.out-code   = archive_parts.out-code
     6057                                               and orig_marking-lines.part-code  = archive_parts.part-code
     6058                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     6059                                               :
     6060           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     6061                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     6062                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     6063                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     6064                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     6065                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     6066                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     6067                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     6068                                                   no-error .
     6069           if available buf_marking-lines
     6070           then do :
     6071             find current buf_marking-lines exclusive-lock .
     6072             delete buf_marking-lines .
     6073             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6074               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     6075             end .
     6076           end .
     6077           else do :
     6078             create buf_marking-lines .
     6079             assign
     6080               buf_marking-lines.mark       = orig_marking-lines.mark
     6081               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     6082               buf_marking-lines.gds-code   = buf_goods.gds-code
     6083               buf_marking-lines.obj-type   = buf_parts.obj-type
     6084               buf_marking-lines.obj-code   = buf_parts.obj-code
     6085               buf_marking-lines.in-code    = buf_parts.in-code
     6086               buf_marking-lines.out-code   = buf_parts.out-code
     6087               buf_marking-lines.part-code  = buf_parts.part-code
     6088               buf_marking-lines.prt-code   = buf_parts.prt-code
     6089             .
     6090             if buf_parts.out-code <> buf_parts.in-code
     6091             and buf_parts.out-code <> 'free-zone':U
     6092             and buf_parts.out-code <> 'out-zone':U
     6093             then do :
     6094               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     6095               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     6096             end .
     6097             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6098               assign
     6099                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     6100                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     6101               .
     6102             end .
     6103           end .
     6104           release buf_marking-lines no-error .
     6105         end.
     6106         if p-goods-twounit = true
     6107         then do:
     6108           assign
     6109             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     6110                                                     * (if p-rsrv-direction = true
     6111                                                       then 1
     6112                                                       else -1
     6113                                                       )
     6114           .
     6115         end.
     6116         if  buf_parts.qnty      = 0
     6117         and buf_parts.fact-qnty = 0
     6118         then do:
     6119           if p-goods-twounit = true
     6120           then do:
     6121             if buf_parts.cli-qnty <> 0
     6122             then do:
     6123               message
     6124                 vss-workfile vss-revision vss-description skip
     6125                 vss-include-info24 skip
     6126                 "Ошибка при удалении партии" skip
     6127                 "Документ" buf_trn-doc.doc-code skip
     6128                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6129                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6130                 "Партия" buf_parts.in-code buf_parts.part-code skip
     6131                 "Резерв" buf_parts.out-code skip
     6132                 "qnty" buf_parts.qnty skip
     6133                 "fact-qnty" buf_parts.fact-qnty skip
     6134                 "cli-qnty" buf_parts.cli-qnty skip
     6135                 view-as alert-box error .
     6136               undo, return error .
     6137             end.
     6138           end.
     6139           delete buf_parts .
     6140         end.
     6141       end.
     6142     end.
     6143   end procedure.
     6144   procedure partcopy-update-doc-line-tot-fact :
     6145     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     6146     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     6147     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     6148     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     6149     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     6150       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     6151     define buffer buf_doc-line for ub.doc-line .
     6152     do
     6153     on error undo, return error return-value
     6154     :
     6155       find first buf_doc-line exclusive-lock
     6156         where buf_doc-line.doc-code  = p-doc-code
     6157           and buf_doc-line.artic     = p-artic
     6158           and buf_doc-line.prod-type = p-prod-type
     6159           and buf_doc-line.prod-code = p-prod-code
     6160         no-error .
     6161       if error-status :error
     6162       then do:
     6163         message
     6164           vss-workfile vss-revision vss-description skip
     6165           vss-include-info24 skip
     6166           "Ошибка задания входных параметров" skip
     6167           "Не найдена строка документа" skip
     6168           "Документ" p-doc-code skip
     6169           "Артикул" p-artic p-prod-type p-prod-code skip
     6170           error-status :get-message(1) skip
     6171           return-value skip
     6172           view-as alert-box error .
     6173         undo, return error .
     6174       end.
     6175       run partrqst in this-procedure
     6176         (input buf_doc-line.doc-code
     6177         ,input buf_doc-line.obj-type
     6178         ,input buf_doc-line.obj-code
     6179         ,input buf_doc-line.artic
     6180         ,input buf_doc-line.prod-type
     6181         ,input buf_doc-line.prod-code
     6182               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     6183         ) no-error .
     6184       if error-status :error
     6185       then do:
     6186         message
     6187           vss-workfile vss-revision vss-description skip
     6188           vss-include-info24 skip
     6189           "Ошибка при сборе информации по партиям" skip
     6190           "Документ" p-doc-code skip
     6191           "Артикул" p-artic p-prod-type p-prod-code skip
     6192           view-as alert-box error .
     6193         undo, return error .
     6194       end.
     6195       if v-total-parts-fact-qnty <> 0
     6196       then do:
     6197         assign
     6198           buf_doc-line.price-base      = v-total-parts-price-base
     6199                                        / v-total-parts-fact-qnty
     6200           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     6201                                        / v-total-parts-fact-qnty
     6202           buf_doc-line.transport-base  = v-total-parts-transport-base
     6203                                        / v-total-parts-fact-qnty
     6204           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     6205                                        / v-total-parts-fact-qnty
     6206           buf_doc-line.other-base      = v-total-parts-other-base
     6207                                        / v-total-parts-fact-qnty
     6208           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     6209                                        / v-total-parts-fact-qnty
     6210         .
     6211       end.
     6212       else do:
     6213       end.
     6214     end.
     6215   end procedure.
     6216   procedure partcopy-change-purch-code :
     6217     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     6218     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     6219     define parameter buffer buf_orig_parts     for ub.parts .
     6220     define parameter buffer buf1_parts         for ub.parts .
     6221     define parameter buffer buf2_parts         for ub.parts .
     6222     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     6223     define variable var-out-code  like ub.parts.out-code no-undo .
     6224     define variable var-part-code like ub.parts.part-code no-undo .
     6225     define buffer buf_goods        for ub.goods .
     6226     define buffer buf_parts-root   for ub.parts-root.
     6227     define buffer buf_trn-doc      for ub.trn-doc.
     6228     define buffer buf-orig_trn-doc for ub.trn-doc.
     6229     define buffer buf_units        for ub.units .
     6230     do
     6231     on error undo, return error return-value
     6232     :
     6233       if buf_orig_parts.out-code = p-in-code
     6234       then do:
     6235         message
     6236           vss-workfile vss-revision vss-description skip
     6237           vss-include-info24 skip
     6238           "Ошибка задания входных параметров процедуры partcopy" skip
     6239           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     6240           "p-in-code" p-in-code skip
     6241           view-as alert-box error .
     6242         undo, return error .
     6243       end.
     6244       find first buf_trn-doc no-lock
     6245         where buf_trn-doc.doc-code = p-in-code
     6246         .
     6247       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     6248       find first buf_goods no-lock
     6249         where buf_goods.artic = buf_orig_parts.artic
     6250           and buf_goods.prod-type = buf_orig_parts.prod-type
     6251           and buf_goods.prod-code = buf_orig_parts.prod-code
     6252         .
     6253       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     6254       find first buf1_parts exclusive-lock
     6255         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     6256           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     6257           and buf1_parts.artic     = buf_orig_parts.artic
     6258           and buf1_parts.prod-type = buf_orig_parts.prod-type
     6259           and buf1_parts.prod-code = buf_orig_parts.prod-code
     6260           and buf1_parts.in-code   = buf_orig_parts.in-code
     6261           and buf1_parts.out-code  = p-in-code
     6262           and buf1_parts.part-code = buf_orig_parts.part-code
     6263         no-error.
     6264       if not available buf1_parts
     6265       then do:
     6266         create buf1_parts .
     6267         buffer-copy buf_orig_parts to buf1_parts
     6268         assign
     6269           buf1_parts.in-code    = buf_orig_parts.in-code
     6270           buf1_parts.out-code   = p-in-code
     6271           buf1_parts.status_    = no
     6272           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6273           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6274           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     6275           buf1_parts.purch-code = buf_orig_parts.purch-code
     6276           buf1_parts.rsrv-free  = ?
     6277           buf1_parts.status_    = yes
     6278         .
     6279         validate buf1_parts .
     6280       end.
     6281       if  lookup('сер':U, buf_units.type) > 0
     6282       then do:
     6283          var-part-code = buf_orig_parts.part-code.
     6284       end.
     6285       else do:
     6286           run holdprts-get-part-code in this-procedure
     6287             (input  p-in-code
     6288             ,output var-part-code
     6289             ) no-error .
     6290           if error-status :error
     6291           then dO:
     6292             undo, return error return-value.
     6293           end.
     6294       end.
     6295       find first buf2_parts exclusive-lock
     6296         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     6297           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     6298           and buf2_parts.artic     = buf_orig_parts.artic
     6299           and buf2_parts.prod-type = buf_orig_parts.prod-type
     6300           and buf2_parts.prod-code = buf_orig_parts.prod-code
     6301           and buf2_parts.in-code   = p-in-code
     6302           and buf2_parts.out-code  = p-in-code
     6303           and buf2_parts.part-code = var-part-code
     6304         no-error.
     6305       if not available buf2_parts
     6306       then do:
     6307         create buf2_parts .
     6308         buffer-copy buf_orig_parts to buf2_parts
     6309         assign
     6310           buf2_parts.in-code   = p-in-code
     6311           buf2_parts.out-code  = p-in-code
     6312           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6313           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6314           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     6315           buf2_parts.purch-code = p-dest-purch-code
     6316           buf2_parts.part-code  = var-part-code
     6317           buf2_parts.rsrv-free  = ?
     6318           buf2_parts.status_    = yes
     6319         .
     6320         validate buf2_parts .
     6321       end.
     6322       assign
     6323         buf_orig_parts.in-code    = p-in-code
     6324         buf_orig_parts.part-code  = buf2_parts.part-code
     6325         buf_orig_parts.purch-code = buf2_parts.purch-code
     6326       .
     6327       find first buf_parts-root
     6328         where buf_parts-root.doc-code       = p-in-code
     6329           and buf_parts-root.in-code        = p-in-code
     6330           and buf_parts-root.gds-code       = buf_goods.gds-code
     6331           and buf_parts-root.part-code      = buf2_parts.part-code
     6332           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     6333           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6334           and buf_parts-root.orig-part-code = buf1_parts.part-code
     6335         no-error .
     6336       if not available buf_parts-root
     6337       then do:
     6338         create buf_parts-root.
     6339         assign
     6340         buf_parts-root.doc-code       = p-in-code
     6341         buf_parts-root.in-code        = p-in-code
     6342         buf_parts-root.gds-code       = buf_goods.gds-code
     6343         buf_parts-root.part-code      = buf2_parts.part-code
     6344         buf_parts-root.orig-in-code   = buf1_parts.in-code
     6345         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6346         buf_parts-root.orig-part-code = buf1_parts.part-code
     6347         .
     6348       end.
     6349     end.
     6350   end procedure.
     6351   procedure addChildMarkingLines:
     6352     define input parameter iMark as character no-undo.
     6353     define input parameter iSts  as integer   no-undo.
     6354     define parameter buffer buf_marking-lines  for ub.marking-lines.
     6355     define parameter buffer buf_parts          for ub.parts.
     6356     define parameter buffer orig_marking-lines for ub.marking-lines.
     6357     define parameter buffer buf_orig_parts     for ub.parts.
     6358     define parameter buffer buf_goods          for ub.goods.
     6359     define buffer buf_marking-childs        for ub.marking.
     6360     define buffer buf_marking-lines-childs  for ub.marking-lines.
     6361     define buffer buf_marking-chk           for ub.marking-chk.
     6362     define buffer buf_chk-doc               for ub.chk-doc.
     6363     define buffer orig_marking-lines-childs for ub.marking-lines.
     6364     for each buf_marking-childs exclusive-lock where
     6365              buf_marking-childs.mark-parent = iMark :
     6366         find first buf_marking-lines-childs no-lock where
     6367                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6368                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6369                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6370                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6371                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6372                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6373                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6374                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6375         no-error .
     6376         if not available buf_marking-lines-childs then
     6377         do:
     6378           create buf_marking-lines-childs .
     6379           assign
     6380             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6381             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6382             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6383             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6384             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6385             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6386             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6387             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6388             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     6389             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     6390           .
     6391           validate buf_marking-childs.
     6392         end .
     6393         buf_marking-childs.sts = iSts .
     6394         for each buf_marking-chk exclusive-lock where
     6395                  buf_marking-chk.mark begins buf_marking-childs.mark
     6396         :
     6397           for first buf_chk-doc no-lock where
     6398                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     6399                 and buf_chk-doc.out-code = buf_parts.out-code
     6400           :
     6401             buf_marking-chk.sts = 0 .
     6402             validate buf_marking-chk.
     6403           end .
     6404         end .
     6405         if available orig_marking-lines
     6406         then do :
     6407           find first orig_marking-lines-childs exclusive-lock where
     6408                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     6409                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     6410                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     6411                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     6412                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     6413                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     6414                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     6415                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     6416           no-error .
     6417           if available orig_marking-lines-childs then
     6418             delete orig_marking-lines-childs .
     6419         end.
     6420         run addChildMarkingLines in this-procedure (
     6421           buf_marking-childs.mark,
     6422           iSts,
     6423           buffer buf_marking-lines,
     6424           buffer buf_parts,
     6425           buffer orig_marking-lines,
     6426           buffer buf_orig_parts,
     6427           buffer buf_goods
     6428         ).
     6429     end .
     6430   end.
     6431   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6432   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6433   define new global shared variable g#trdcalib as handle no-undo.
     6434   function stsMarkWhenDeleteGoods returns integer
     6435       (input iDocCode as character,
     6436        input iMark as character):
     6437     define variable vValue as character no-undo.
     6438     define variable vType as character no-undo.
     6439     define buffer buf_trn-doc for ub.trn-doc.
     6440     define buffer buf_c-marking for ub.c-marking.
     6441     if iDocCode <> ? then
     6442     do:
     6443         find first buf_trn-doc no-lock where
     6444                    buf_trn-doc.doc-code = iDocCode no-error.
     6445         if avail buf_trn-doc then
     6446         do:
     6447   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6448                           input 'is-return':U ,
     6449                          output vValue ,
     6450                          output vType ) no-error .
     6451            if buf_trn-doc.ext-doc-type = 'we':U or
     6452               buf_trn-doc.ext-doc-type = 'ev':U or
     6453               vValue = "yes" then
     6454            do:
     6455              find last buf_c-marking no-lock where
     6456                        buf_c-marking.mark = iMark
     6457                   use-index pi-2 no-error.
     6458              if avail buf_c-marking and
     6459                      (buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB or
     6460                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB or
     6461                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB or
     6462                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:Moved:KeyIntDB or
     6463                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB) then
     6464                return buf_c-marking.sts .
     6465            end.
     6466         end.
     6467     end.
     6468     return objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     6469   end function.
     6470   procedure partrsrv :
     6471     define input parameter  p-chg-qnty      as decimal   no-undo .
     6472     define input parameter  p-goods-serial  as logical   no-undo .
     6473     define input parameter  p-goods-twounit as logical   no-undo .
     6474     define input parameter  p-unreserv-only as logical   no-undo .
     6475     define parameter buffer buf_orig_parts  for ub.parts .
     6476     define parameter buffer buf_trn-doc     for ub.trn-doc .
     6477     define output parameter p-real-chg-qnty as decimal   no-undo .
     6478     define output parameter p-parts-recid   as recid     no-undo .
     6479     define input  parameter p-mark          as character  no-undo .
     6480     define variable vss-description as character no-undo init "$Workfile$ Резервирование и снятие резервов по одной партии".
     6481     define buffer buf_parts  for ub.parts .
     6482     define buffer rsrv-parts for ub.parts .
     6483     define buffer unrsrv-parts for ub.parts .
     6484     define buffer buf_parts-attr for ub.parts-attr .
     6485     define buffer free_marking-lines for ub.marking-lines .
     6486     define variable lok                as logical   no-undo .
     6487     define variable v-sign-chg-qnty    as integer   no-undo .
     6488     define variable v-sign-rsrv-qnty   as integer   no-undo .
     6489     define variable v-rsrv-qnty        as decimal   no-undo .
     6490     define variable v-orig-unrsrv-code as character no-undo .
     6491     define variable v-new-rsrv-code    as character no-undo .
     6492     define variable v-new-unrsrv-code  as character no-undo .
     6493     define variable v-unrsrv-qnty      as decimal   no-undo .
     6494     define variable v-value-character as character no-undo .
     6495     define variable v-value-date      as date no-undo .
     6496     define variable v-value-decimal   as decimal no-undo .
     6497     define variable v-value-integer   as integer no-undo .
     6498     define variable v-izlcstpr        as logical no-undo .
     6499     define variable v-tth             as handle no-undo .
     6500     define variable v-type            as character no-undo .
     6501     define variable part-key-rec      as character no-undo .
     6502     define variable v-part-code-int   as integer no-undo .
     6503     define variable v-old-part-code   as character no-undo .
     6504     define variable v-part-gds-code   as integer   no-undo .
     6505     do transaction
     6506     on error undo, return error
     6507     :
     6508       if buf_trn-doc.ext-doc-type = 'vt':U
     6509       then do :
     6510           delete object v-tth no-error.
     6511           run adm/shattri.p (
     6512              input "get":U
     6513             ,input buf_orig_parts.obj-type
     6514             ,input buf_orig_parts.obj-code
     6515             ,input 'inv-obj':U
     6516             ,input  "izlcstpr"
     6517             ,output v-value-character
     6518             ,output v-value-date
     6519             ,output v-value-decimal
     6520             ,output v-value-integer
     6521             ,output v-izlcstpr
     6522             ,output v-type
     6523             ,INPUT-OUTPUT table-handle v-tth
     6524             ) no-error .
     6525             delete object v-tth no-error.
     6526           if error-status:error then do:
     6527             v-izlcstpr = false .
     6528           end.
     6529       end.
     6530       else do :
     6531           v-izlcstpr = false .
     6532       end.
     6533       assign
     6534         p-parts-recid = ?
     6535       .
     6536       if p-chg-qnty = 0 then do:
     6537         assign
     6538           p-parts-recid = recid(buf_orig_parts)
     6539         .
     6540         return .
     6541       end.
     6542       assign
     6543         v-sign-chg-qnty = 0
     6544       .
     6545       if p-chg-qnty < 0 then do:
     6546         assign
     6547           v-sign-chg-qnty = -1
     6548         .
     6549       end.
     6550       if p-chg-qnty > 0 then do:
     6551         assign
     6552           v-sign-chg-qnty = 1
     6553         .
     6554       end.
     6555       assign
     6556         v-sign-rsrv-qnty = v-sign-chg-qnty
     6557       .
     6558       if lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 then do:
     6559         assign
     6560           v-sign-rsrv-qnty = - v-sign-chg-qnty
     6561         .
     6562       end.
     6563       run partcopy in this-procedure
     6564         (input  false
     6565         ,input  buf_trn-doc.doc-code
     6566         ,buffer buf_orig_parts
     6567         ,buffer buf_parts
     6568         ,input  p-mark
     6569         ) no-error .
     6570       if error-status :error then do:
     6571         message
     6572           vss-workfile vss-revision vss-description skip
     6573           "Ошибка при создании партии" skip
     6574           "Объект" buf_orig_parts.obj-type buf_orig_parts.obj-code skip
     6575           "Артикул" buf_orig_parts.artic buf_orig_parts.prod-type buf_orig_parts.prod-code skip
     6576           "Партия" buf_orig_parts.in-code buf_orig_parts.part-code skip
     6577           "Резерв" buf_trn-doc.doc-code skip
     6578           error-status :get-message(1) skip
     6579           return-value skip
     6580           view-as alert-box error .
     6581         undo, return error .
     6582       end.
     6583       if buf_parts.in-code = buf_parts.out-code then do:
     6584         assign
     6585           v-rsrv-qnty = abs(p-chg-qnty)
     6586         .
     6587         if buf_trn-doc.doc-type <> 'инв':U then do:
     6588           if buf_parts.qnty < 0
     6589           or buf_parts.fact-qnty < 0 then do:
     6590             message
     6591               vss-workfile vss-revision vss-description skip
     6592               "Резервирование невозможно" skip
     6593               "Партия зарезервированная за обычным документом имеет отрицательное количество" skip
     6594               view-as alert-box error .
     6595             undo, return error .
     6596           end.
     6597           if v-sign-rsrv-qnty < 0 then do:
     6598             assign
     6599               v-rsrv-qnty = min(abs(buf_parts.qnty), v-rsrv-qnty)
     6600             .
     6601           end.
     6602         end.
     6603         assign
     6604           buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     6605           buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     6606         .
     6607         if p-goods-twounit = true
     6608         then do:
     6609           if buf_parts.qnty < 0 then do:
     6610             message
     6611               "Порожденная партия ювелирных изделий не может иметь отрицательное количество" skip
     6612               "Количество" buf_parts.qnty skip
     6613               view-as alert-box error .
     6614             undo, return error .
     6615           end.
     6616           if buf_parts.qnty = 0 then do:
     6617             assign
     6618               buf_parts.cli-qnty = 0
     6619             .
     6620           end.
     6621           if  buf_parts.qnty <> 0
     6622           and buf_parts.cli-qnty <> 1
     6623           then do:
     6624             message
     6625               vss-workfile vss-revision vss-description skip
     6626               "Порожденная партия ювелирных изделий должна иметь определенное клиентское количество" skip
     6627               "qnty" buf_parts.qnty skip
     6628               "cli-qnty" buf_parts.cli-qnty skip
     6629               view-as alert-box error .
     6630             undo, return error .
     6631           end.
     6632         end.
     6633         else do:
     6634           if buf_parts.cli-base-rate <> 0
     6635           then do:
     6636             assign
     6637               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6638             .
     6639           end.
     6640           else do:
     6641             assign
     6642               buf_parts.cli-qnty = 0
     6643             .
     6644           end.
     6645         end.
     6646         assign
     6647           p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     6648           p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     6649         .
     6650       end.
     6651       else do:
     6652         assign
     6653           v-orig-unrsrv-code =
     6654           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     6655         or (buf_trn-doc.doc-type = 'инв':U and buf_parts.qnty < 0)
     6656         then 'free-zone':U
     6657         else 'out-zone':U )
     6658           v-new-rsrv-code    =  ( if p-chg-qnty > 0
     6659                                   then 'free-zone':U
     6660                                   else 'out-zone':U
     6661                                 )
     6662           v-new-unrsrv-code  =  ( if p-chg-qnty > 0
     6663                                   then 'out-zone':U
     6664                                   else 'free-zone':U
     6665                                 )
     6666         .
     6667         if v-new-rsrv-code = v-orig-unrsrv-code then do:
     6668           assign
     6669             v-rsrv-qnty = min(abs(buf_parts.qnty), abs(p-chg-qnty) )
     6670           .
     6671           if v-izlcstpr and buf_parts.out-code <> v-new-rsrv-code and p-chg-qnty > 0
     6672           then do :
     6673               find first rsrv-parts exclusive-lock
     6674                   where rsrv-parts.obj-type  = buf_parts.obj-type
     6675                     and rsrv-parts.obj-code  = buf_parts.obj-code
     6676                     and rsrv-parts.artic     = buf_parts.artic
     6677                     and rsrv-parts.prod-type = buf_parts.prod-type
     6678                     and rsrv-parts.prod-code = buf_parts.prod-code
     6679                     and rsrv-parts.in-code   = buf_parts.out-code
     6680                     and rsrv-parts.out-code  = v-new-rsrv-code
     6681                     and rsrv-parts.part-code = buf_parts.part-code
     6682                   no-error.
     6683           end.
     6684           if not available rsrv-parts
     6685           then do :
     6686               run partcopy in this-procedure
     6687                 (input  true
     6688                 ,input  v-new-rsrv-code
     6689                 ,buffer buf_parts
     6690                 ,buffer rsrv-parts
     6691                 ,input p-mark
     6692                 ) no-error .
     6693               if error-status :error then do:
     6694                 message
     6695                   vss-workfile vss-revision vss-description skip
     6696                   "Ошибка при создании партии" skip
     6697                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6698                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6699                   "Партия" buf_parts.in-code buf_parts.part-code skip
     6700                   "Резерв" v-new-rsrv-code skip
     6701                   error-status :get-message(1) skip
     6702                   return-value skip
     6703                   view-as alert-box error .
     6704                 undo, return error .
     6705               end.
     6706           end.
     6707           if not v-izlcstpr or (v-izlcstpr and p-chg-qnty > 0)
     6708           then
     6709           assign
     6710             rsrv-parts.qnty      = rsrv-parts.qnty      + v-rsrv-qnty
     6711             rsrv-parts.fact-qnty = rsrv-parts.fact-qnty + v-rsrv-qnty
     6712           .
     6713           if p-goods-twounit = true then do:
     6714             assign
     6715               rsrv-parts.cli-qnty = rsrv-parts.cli-qnty + abs(buf_parts.cli-qnty)
     6716             .
     6717           end.
     6718           else do:
     6719             if rsrv-parts.cli-base-rate <> 0
     6720             then do:
     6721               assign
     6722                 rsrv-parts.cli-qnty = rsrv-parts.fact-qnty / rsrv-parts.cli-base-rate
     6723               .
     6724             end.
     6725             else do:
     6726               assign
     6727                 rsrv-parts.cli-qnty = 0
     6728               .
     6729             end.
     6730           end.
     6731           assign
     6732             buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     6733             buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     6734           .
     6735           if p-goods-twounit = true then do:
     6736             assign
     6737               buf_parts.cli-qnty = 0
     6738             .
     6739           end.
     6740           else do:
     6741             if buf_parts.cli-base-rate <> 0
     6742             then do:
     6743               assign
     6744                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6745               .
     6746             end.
     6747             else do:
     6748               assign
     6749                 buf_parts.cli-qnty = 0
     6750               .
     6751             end.
     6752           end.
     6753           assign
     6754             p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     6755             p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     6756           .
     6757         end.
     6758         if p-chg-qnty <> 0
     6759         and (
     6760              (buf_trn-doc.doc-type = 'инв':U
     6761              and p-unreserv-only = false
     6762              )
     6763             or v-new-unrsrv-code = v-orig-unrsrv-code
     6764             )
     6765         then do:
     6766           if v-izlcstpr and buf_parts.out-code <> v-new-unrsrv-code and p-chg-qnty < 0
     6767           then do :
     6768               find first unrsrv-parts exclusive-lock
     6769                   where unrsrv-parts.obj-type  = buf_parts.obj-type
     6770                     and unrsrv-parts.obj-code  = buf_parts.obj-code
     6771                     and unrsrv-parts.artic     = buf_parts.artic
     6772                     and unrsrv-parts.prod-type = buf_parts.prod-type
     6773                     and unrsrv-parts.prod-code = buf_parts.prod-code
     6774                     and unrsrv-parts.in-code   = buf_parts.in-code
     6775                     and unrsrv-parts.out-code  = v-new-unrsrv-code
     6776                     and unrsrv-parts.part-code = buf_parts.part-code
     6777                   no-error.
     6778           end.
     6779           if not available unrsrv-parts
     6780           then do :
     6781               run partcopy in this-procedure
     6782                 (input  true
     6783                 ,input  v-new-unrsrv-code
     6784                 ,buffer buf_parts
     6785                 ,buffer unrsrv-parts
     6786                 ,input  p-mark
     6787                 ) no-error .
     6788               if error-status :error then do:
     6789                 message
     6790                   vss-workfile vss-revision vss-description skip
     6791                   "Ошибка при создании партии" skip
     6792                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6793                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6794                   "Партия" buf_parts.in-code buf_parts.part-code skip
     6795                   "Резерв" v-new-rsrv-code skip
     6796                   error-status :get-message(1) skip
     6797                   return-value skip
     6798                   view-as alert-box error .
     6799                 undo, return error .
     6800               end.
     6801           end.
     6802           assign
     6803             v-unrsrv-qnty = min( (if unrsrv-parts.qnty > 0
     6804                                   then unrsrv-parts.qnty
     6805                                   else 0
     6806                                   )
     6807                             , abs(p-chg-qnty))
     6808           .
     6809           assign
     6810             buf_parts.qnty      = buf_parts.qnty      + v-unrsrv-qnty * v-sign-rsrv-qnty
     6811             buf_parts.fact-qnty = buf_parts.fact-qnty + v-unrsrv-qnty * v-sign-rsrv-qnty
     6812           .
     6813           if p-goods-twounit = true then do:
     6814             assign
     6815               buf_parts.cli-qnty = buf_parts.cli-qnty + unrsrv-parts.cli-qnty * v-sign-rsrv-qnty
     6816             .
     6817           end.
     6818           else do:
     6819             if buf_parts.cli-base-rate <> 0
     6820             then do:
     6821               assign
     6822                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6823               .
     6824             end.
     6825             else do:
     6826               assign
     6827                 buf_parts.cli-qnty = 0
     6828               .
     6829             end.
     6830           end.
     6831           if num-entries(buf_parts.part-code, "_") = 2
     6832           and buf_parts.qnty > 0
     6833           and buf_parts.out-code <> 'free-zone':U
     6834           and buf_parts.out-code <> 'out-zone':U
     6835           and buf_trn-doc.ext-doc-type = 'vt':U
     6836           then do :
     6837             v-old-part-code = buf_parts.part-code .
     6838             v-part-code-int = 0 .
     6839             buf_parts.part-code = entry(2, buf_parts.part-code, "_") no-error .
     6840             do while error-status:error :
     6841               v-part-code-int = v-part-code-int + 1 .
     6842               buf_parts.part-code = string(integer(entry(2, buf_parts.part-code, "_")) + v-part-code-int) no-error .
     6843             end .
     6844   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6846     (input  buf_parts.artic
     6847     ,input  buf_parts.prod-type
     6848     ,input  buf_parts.prod-code
     6849     ,output v-part-gds-code
     6850     )  .
     6851             find first buf_parts-attr exclusive-lock where buf_parts-attr.in-code   = buf_parts.in-code
     6852                                                        and buf_parts-attr.gds-code  = v-part-gds-code
     6853                                                        and buf_parts-attr.part-code = buf_parts.part-code
     6854                                                        no-error.
     6855             if not available buf_parts-attr then do:
     6856               find first ub.parts-attr no-lock where ub.parts-attr.in-code   = buf_parts.in-code
     6857                                                  and ub.parts-attr.gds-code  = v-part-gds-code
     6858                                                  and ub.parts-attr.part-code = v-old-part-code
     6859                                                  no-error.
     6860               if available ub.parts-attr then do:
     6861                 create buf_parts-attr.
     6862                 buffer-copy ub.parts-attr to buf_parts-attr
     6863                 assign
     6864                   buf_parts-attr.part-code = buf_parts.part-code
     6865                 .
     6866               end.
     6867             end.
     6868           end .
     6869           if not v-izlcstpr or (v-izlcstpr and p-chg-qnty < 0)
     6870           then
     6871           assign
     6872             unrsrv-parts.qnty      = unrsrv-parts.qnty      - v-unrsrv-qnty
     6873             unrsrv-parts.fact-qnty = unrsrv-parts.fact-qnty - v-unrsrv-qnty
     6874           .
     6875           if p-goods-twounit = true
     6876           then do:
     6877             assign
     6878               unrsrv-parts.cli-qnty = 0
     6879             .
     6880           end.
     6881           else do:
     6882             if unrsrv-parts.cli-base-rate <> 0
     6883             then do:
     6884               assign
     6885                 unrsrv-parts.cli-qnty = unrsrv-parts.fact-qnty / unrsrv-parts.cli-base-rate
     6886               .
     6887             end.
     6888             else do:
     6889               assign
     6890                 unrsrv-parts.cli-qnty = 0
     6891               .
     6892             end.
     6893           end.
     6894           assign
     6895             p-chg-qnty      = p-chg-qnty      - v-unrsrv-qnty * v-sign-chg-qnty
     6896             p-real-chg-qnty = p-real-chg-qnty + v-unrsrv-qnty * v-sign-chg-qnty
     6897           .
     6898         end.
     6899       end.
     6900       if available unrsrv-parts
     6901       and unrsrv-parts.qnty      = 0
     6902       and unrsrv-parts.fact-qnty = 0
     6903       then do:
     6904         if p-goods-twounit = true then do:
     6905           if unrsrv-parts.cli-qnty <> 0 then do:
     6906             message
     6907               vss-workfile vss-revision vss-description skip
     6908               "Ошибка при удалении партии" skip
     6909               "Объект" unrsrv-parts.obj-type unrsrv-parts.obj-code skip
     6910               "Артикул" unrsrv-parts.artic unrsrv-parts.prod-type unrsrv-parts.prod-code skip
     6911               "Партия" unrsrv-parts.in-code unrsrv-parts.part-code skip
     6912               "Резерв" unrsrv-parts.out-code skip
     6913               "qnty" unrsrv-parts.qnty skip
     6914               "fact-qnty" unrsrv-parts.fact-qnty skip
     6915               "cli-qnty" unrsrv-parts.cli-qnty skip
     6916               view-as alert-box error .
     6917             undo, return error .
     6918           end.
     6919         end.
     6920         define variable origpart-key-rec as character no-undo .
     6921         define buffer buf_gen-attr for ub.gen-attr .
     6922         define buffer buf1_gen-attr for ub.gen-attr .
     6923         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     6924                                           ,input (buffer unrsrv-parts:handle)
     6925                                           ,output part-key-rec).
     6926         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     6927                                           ,input (buffer buf_parts:handle)
     6928                                           ,output origpart-key-rec).
     6929         if  v-new-rsrv-code <> 'out-zone':U then do:
     6930           for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     6931                                               and ub.gen-attr.p-key =  part-key-rec :
     6932             find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     6933                                               and buf_gen-attr.p-key =  origpart-key-rec
     6934                                               and buf_gen-attr.attr-code = ub.gen-attr.attr-code no-error .
     6935           if not available (buf_gen-attr) then do:
