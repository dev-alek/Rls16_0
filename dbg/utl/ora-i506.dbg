     5219     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     5220     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     5221     define variable objMarks as class excisemarks no-undo.
     5222     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     5223     define buffer buf_trn-doc    for ub.trn-doc .
