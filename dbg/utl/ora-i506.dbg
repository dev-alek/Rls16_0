     2003   .
     2004   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2005   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
     2006     field prt-code         like ub.gds-dtl.prt-code
     2007     field rsrv-qnty        like ub.gds-dtl.fact-qnty
     2008     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
     2009     index xpk is primary unique prt-code
     2010   .
     2011   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
