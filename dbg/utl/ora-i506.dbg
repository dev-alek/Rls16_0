      815   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   function octal-to-char return character
      817   ( p-string as character ) :
      818     def var v-asc     as integer no-undo .
      819     def var v-new-asc as integer no-undo .
      820     def var ind       as integer no-undo .
      821     if length(p-string) <> 3 then do:
      822       return ? .
      823     end.
      824     assign
      825       v-asc = 0
      826     .
      827     do ind = 1 to length(p-string)
      828     :
      829       assign
      830         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      831       .
      832       if v-new-asc < 0 or v-new-asc >= 8 then do:
      833         return ? .
      834       end.
      835       assign
      836         v-asc = v-asc * 8 + v-new-asc
      837       .
      838     end.
      839     return chr(v-asc) .
      840   end function .
      841   function char-to-octal return character
      842   ( p-chr as character ) :
      843     def var v-asc    as integer   no-undo .
      844     def var ind      as integer   no-undo .
      845     def var v-string as character no-undo .
      846     if length(p-chr) <> 1 then do:
      847       return ? .
      848     end.
      849     assign
      850       v-asc    = asc(p-chr)
      851       v-string = ""
      852     .
      853     do ind = 1 to 3
      854     :
      855       assign
      856         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      857       .
      858       assign
      859         v-asc = truncate(v-asc / 8, 0)
      860       .
      861     end.
      862     return v-string .
      863   end.
      864   function str-encode return character
      865   (   p-init-string       as character
      866     , p-encode-char       as character
      867     , p-special-char-list as character
      868   ) :
      869     def var p-encode-string as character no-undo .
      870     def var ind                as integer no-undo .
      871     def var v-num-special-char as integer no-undo .
      872     def var v-special-char     as character no-undo .
      873     if p-encode-char = ?
      874     or p-encode-char = "" then do:
      875       assign
      876         p-encode-char = "~~"
      877       .
      878     end.
      879     if p-init-string = ? then do:
      880       return "?" .
      881     end.
      882     if p-init-string = "?" then do:
      883       return p-encode-char + char-to-octal("?") .
      884     end.
      885     assign
      886       v-num-special-char = length(p-special-char-list)
      887       p-encode-string    = replace(p-init-string
      888                                   ,p-encode-char
      889                                   ,p-encode-char + char-to-octal(p-encode-char)
      890                                   )
      891     .
      892     do ind = 1 to v-num-special-char
      893     :
      894       assign
      895         v-special-char = substring(p-special-char-list, ind, 1)
      896       .
      897       if v-special-char <> p-encode-char then do:
      898         assign
      899           p-encode-string = replace (p-encode-string
      900                                     ,v-special-char
      901                                     ,p-encode-char + char-to-octal(v-special-char)
      902                                     )
      903         .
      904       end.
      905     end.
      906     return p-encode-string .
      907   end.
      908   function str-decode returns character
      909     (p-init-string   as character
      910     ,p-encode-char   as character
      911     ) :
      912     def var p-decode-string as character no-undo .
      913     def var ind                       as integer no-undo .
      914     def var v-num-entries-init-string as integer no-undo .
      915     def var v-sub-phrase              as character no-undo .
      916     def var v-special-char            as character no-undo .
      917     if p-encode-char = ?
      918     or p-encode-char = "" then do:
      919       assign
      920         p-encode-char = "~~"
      921       .
      922     end.
      923     if p-init-string = "?" then do:
      924       return ? .
      925     end.
      926     assign
      927       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      928     .
      929     if v-num-entries-init-string > 1 then do:
      930       assign
      931         p-decode-string = entry(1, p-init-string, p-encode-char)
      932       .
      933       do ind = 2 to v-num-entries-init-string
      934       :
      935         assign
      936           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      937         .
      938         assign
      939           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      940         .
      941         if v-special-char <> ? then do:
      942           assign
      943             p-decode-string = p-decode-string
      944                             + v-special-char
      945                             + substring(v-sub-phrase, 4)
      946           .
      947         end.
      948         else do:
      949           assign
      950             p-decode-string = p-decode-string
      951                             + p-encode-char
      952                             + v-sub-phrase
      953           .
      954         end.
      955       end.
      956     end.
      957     else do:
      958       assign
      959         p-decode-string = p-init-string
      960       .
      961     end.
      962     return p-decode-string .
      963   end.
      964   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      965   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      966   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      967     field cst-code                like ub.trn-doc.cst-code
      968     field part-code               like ub.parts.part-code
      969     .
      970   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      971   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      972   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      973   function hvrdtax return logical (input parrecid as recid):
      974   define variable varresult as logical no-undo.
      975   run hvrdtax-proc (input parrecid, output varresult).
      976   return varresult.
      977   end function.
      978   procedure hvrdtax-proc:
      979   define input  parameter parrecid  as recid   no-undo.
      980   define output parameter parresult as logical no-undo.
      981   define buffer bf_goods for ub.goods.
      982   define buffer bf_units for ub.units.
      983   define buffer rt_tax   for ub.tax.
      984   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      985   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      986   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      987   if available rt_tax and
      988       can-find(first ub.tax-units No-LOCK WHERE
      989                      ub.tax-units.tax-code = rt_tax.tax-code AND
      990                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      991                                                       else assign parresult = no.
      992   end procedure.
      993   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   define new global shared variable g#lib-calc as handle no-undo .
      995   procedure plgdsfnd :
      996     define input  parameter p-chk-and-chs    as logical               no-undo .
      997     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      998     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      999     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1000     define output parameter p-reserv-pl-code as   logical             no-undo .
     1001     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1002     define buffer buf_goods         for ub.goods .
     1003     define buffer buf_pl-gds        for ub.pl-gds .
     1004     define buffer buf_second_pl-gds for ub.pl-gds .
     1005     find first buf_goods no-lock where
     1006                buf_goods.gds-code = p-gds-code no-error .
     1007     if not available buf_goods
     1008     then do:
     1009       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1010     end.
     1011   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1013     (input  p-obj-type
     1014     ,input  p-obj-code
     1015     ,input  buf_goods.artic
     1016     ,input  buf_goods.prod-type
     1017     ,input  buf_goods.prod-code
     1018     ,input  'place-rsrv=request'
     1019     ,output p-reserv-pl-code
     1020     ) no-error .
     1021     if error-status :error
     1022     then do:
     1023       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1024     end.
     1025     if p-reserv-pl-code = no
     1026     then do:
     1027       return .
     1028     end.
     1029     if p-chk-and-chs <> yes
     1030     then do:
     1031       return .
     1032     end.
     1033     find first buf_pl-gds no-lock where
     1034                buf_pl-gds.obj-type = p-obj-type and
     1035                buf_pl-gds.obj-code = p-obj-code and
     1036                buf_pl-gds.gds-code = p-gds-code no-error .
     1037     if not available buf_pl-gds
     1038     then do:
     1039       return error "К товару не привязано ни одного места хранения" .
     1040     end.
     1041     find first buf_second_pl-gds no-lock where
     1042                buf_second_pl-gds.obj-type  = p-obj-type          and
     1043                buf_second_pl-gds.obj-code  = p-obj-code          and
     1044                buf_second_pl-gds.gds-code  = p-gds-code          and
     1045                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1046     if not available buf_second_pl-gds
     1047     then do:
     1048       assign
     1049         p-pl-code = buf_pl-gds.pl-code
     1050       .
     1051     end.
     1052     else do:
     1053       if not valid-handle( parparentproc )
     1054       then do:
     1055         return error "Не выбрано место хранения " + chr(10) .
     1056       end.
     1057       run str/plgdssel.p
     1058         (
     1059            input parparentproc
     1060         ,  input p-obj-type
     1061         ,  input p-obj-code
     1062         ,  input p-gds-code
     1063         , output p-pl-code
     1064         ) no-error .
     1065       if error-status :error
     1066       then do:
     1067         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1068                                , 'plgdssel.p':U
     1069                                , chr(10)
     1070                                , error-status :get-message( 1 )
     1071                                , return-value
     1072                                ) .
     1073       end.
     1074       if p-pl-code = ? or
     1075          p-pl-code = 0
     1076       then do:
     1077         return error "Не выбрано место хранения " + chr(10) .
     1078       end.
     1079     end.
     1080   end procedure.
     1081   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1082   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1083   define temp-table tt-doc-line no-undo like ub.doc-line
     1084   field cst-code like ub.trn-doc.cst-code
     1085   .
     1086   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1087   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1088   define temp-table tt-parts    no-undo like ub.parts.
     1089   procedure lib-trn_copy-inqu :
     1090   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1091   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1092   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1093   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1094   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1095   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1096   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1097   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1098   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1099   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1100   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1101   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1102   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1103   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1104   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1105   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1106   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1107   define input parameter parinp-discnt-type as   logical                no-undo.
     1108   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1109   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1110   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1111   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1112   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1113   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1114   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1115   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1116   define input parameter table for tt-doc-line.
     1117   define input parameter table for tt-gds-dtl.
     1118   define input parameter table for tt-parts.
     1119   define input parameter paruse-parts       as   logical                no-undo.
     1120   define input parameter parall-qnty        as   logical                no-undo.
     1121   define input parameter parfix-price       as   logical                no-undo.
     1122   define buffer crt_trn-doc  for ub.trn-doc.
     1123   define buffer crt_goods    for ub.goods.
     1124   define buffer crt_doc-line for ub.doc-line.
     1125   define buffer crt_gds-dtl  for ub.gds-dtl.
     1126   define variable end-price    as   logical              no-undo.
     1127   define variable real-type    like ub.goods.gds-type    no-undo.
     1128   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1129   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1130   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1131   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1132   define variable g-log        as   logical              no-undo.
     1133   define variable mem-qnty like chg-qnty no-undo.
     1134   define variable dflt-cd as character no-undo .
     1135   c-l:
     1136   do on error undo, return error return-value :
     1137   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1138   assign
     1139       paruse-parts = false
     1140       .
     1141   assign
     1142     end-price = no.
     1143   if parinp-discnt-type = yes and
     1144      parinp-discnt-pc   = 0   and
     1145      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1146      then do:
     1147     assign
     1148       crt_trn-doc.tot-calc    = partot-calc
     1149       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1150       crt_trn-doc.discnt-type = pardiscnt-type.
     1151   end.
     1152   if parinp-agnt = ? then do:
     1153     assign
     1154       crt_trn-doc.agnt = paragnt.
     1155   end.
     1156   if parinp-boss = ? then do:
     1157     assign
     1158       crt_trn-doc.boss = parboss.
     1159   end.
     1160   if parinp-wrkr = ? then do:
     1161     assign
     1162       crt_trn-doc.wrkr = parwrkr.
     1163   end.
     1164   if parinp-base-rate  = ? then do:
     1165     assign
     1166       crt_trn-doc.base-rate  = parbase-rate.
     1167   end.
     1168   if parinp-base-scale = ? then do:
     1169     assign
     1170       crt_trn-doc.base-scale = parbase-scale.
     1171   end.
     1172   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1173   if available tt-doc-line then do:
     1174     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1175                      and crt_goods.prod-type = tt-doc-line.prod-type
     1176                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1177     if crt_goods.gds-type = 'у':U and
     1178        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1179       return error "В данный документ нельзя копировать услуги.".
     1180     end.
     1181     assign
     1182       real-type = crt_goods.gds-type.
     1183     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1184     if available crt_doc-line then do:
     1185       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1186                        and crt_goods.prod-type = crt_doc-line.prod-type
     1187                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1188       if crt_goods.gds-type <> real-type then do:
     1189         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1190       end.
     1191     end.
     1192     else do:
     1193       assign
     1194         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1195     end.
     1196   end.
     1197   r-l:
     1198   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1199     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1200                      and crt_goods.prod-type = tt-doc-line.prod-type
     1201                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1202   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1203      (
     1204       input crt_trn-doc.doc-code
     1205      ,input crt_trn-doc.obj-type
     1206      ,input crt_trn-doc.obj-code
     1207      ,input crt_goods.artic
     1208      ,input crt_goods.prod-type
     1209      ,input crt_goods.prod-code
     1210      ,input crt_goods.gds-name
     1211      ,input crt_goods.prt-root
     1212      ,input ?
     1213      ,input ?
     1214      ,input parcash-pay      ) no-error.
     1215     if error-status:error then do:
     1216       undo c-l, return error return-value.
     1217     end.
     1218     if return-value = "next" then do:
     1219       next r-l.
     1220     end.
     1221     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1222                                   crt_doc-line.artic     = crt_goods.artic      and
     1223                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1224                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1225     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1226                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1227                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1228                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1229                               break by tt-gds-dtl.artic
     1230                                     by tt-gds-dtl.prod-type
     1231                                     by tt-gds-dtl.prod-code
     1232                               :
     1233   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1234     ( input  tt-gds-dtl.artic
     1235      ,input  tt-gds-dtl.prod-type
     1236      ,input  tt-gds-dtl.prod-code
     1237      ,input  tt-gds-dtl.prt-code
     1238      ,input  tt-doc-line.obj-type
     1239      ,input  tt-doc-line.obj-code
     1240      ,output legal-node
     1241     ) no-error .
     1242       if error-status:error then do:
     1243          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1244       end.
     1245   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1246     ( input crt_trn-doc.obj-code
     1247      ,input crt_trn-doc.obj-type
     1248      ,input crt_trn-doc.doc-code
     1249      ,input crt_goods.artic
     1250      ,input crt_goods.prod-code
     1251      ,input crt_goods.prod-type
     1252      ,input legal-node
     1253      ,input yes
     1254     ) no-error .
     1255        if error-status:error then do:
     1256           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1257        end.
     1258        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1259                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1260                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1261                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1262                                     crt_gds-dtl.prt-code  = legal-node.
     1263       assign
     1264         crt_gds-dtl.ov             = parfix-price
     1265         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1266         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1267         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1268         .
     1269       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1270         assign
     1271           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1272           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1273           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1274           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1275       end.
     1276       if end-price then do:
     1277         assign
     1278           crt_gds-dtl.ov             = yes
     1279           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1280           crt_gds-dtl.discnt-base    = 0
     1281           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1282           crt_gds-dtl.discnt-rubl    = 0
     1283           crt_gds-dtl.discnt-pc      = 0
     1284           crt_gds-dtl.discnt-type    = yes.
     1285       end.
     1286   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1288     ( input recid(crt_gds-dtl)
     1289     , input no
     1290     , input ?
     1291     ) no-error.
     1292           if error-status:error then do:
     1293             undo c-l, return error return-value.
     1294           end.
     1295       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1296          crt_gds-dtl.ov then do:
     1297         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1298       end.
     1299       if paruse-parts then do:
     1300          if first-of (tt-gds-dtl.prod-code) then do:
     1301            for each tt-parts :
     1302              assign
     1303                chg-qnty = tt-parts.fact-qnty
     1304                mem-qnty = chg-qnty.
     1305              assign
     1306              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1307              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1308            end.
     1309            assign
     1310              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1311              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1312            assign
     1313              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1314              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1315            if crt_gds-dtl.doc-qnty = 0 then do:
     1316              delete crt_gds-dtl.
     1317            end.
     1318          end.
     1319       end.
     1320       else do:
     1321         assign
     1322           chg-qnty = tt-gds-dtl.fact-qnty
     1323           mem-qnty = chg-qnty.
     1324         assign
     1325           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1326           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1327           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1328           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1329         assign
     1330         varchg-qnty  = varchg-qnty  + chg-qnty
     1331         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1332         if crt_gds-dtl.doc-qnty = 0 then do:
     1333           delete crt_gds-dtl.
     1334         end.
     1335       end.
     1336     end.
     1337     if crt_doc-line.doc-qnty = 0 then do:
     1338       delete crt_doc-line.
     1339     end.
     1340   end.
     1341   end.
     1342   end procedure.
     1343   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344     define variable v-cntxt-db-num        as integer   no-undo .
     1345     define variable v-cntxt-userid        as character no-undo .
     1346     define variable v-cntxt-level         as character no-undo .
     1347     define variable v-cntxt-host-code-obj as integer   no-undo .
     1348     define variable v-cntxt-obj-type      as character no-undo .
     1349     define variable v-cntxt-obj-code      as integer   no-undo .
     1350     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1351     define variable v-cntxt-is-admin      as logical   no-undo .
     1352   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1353     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     1354     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     1355     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     1356     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     1357     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     1358     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     1359     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     1360     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     1361     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     1362     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     1363     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     1364     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     1365     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     1366     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     1367     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     1368     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     1369     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     1370     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     1371     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     1372     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     1373     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     1374     define variable v-cntxp-conf-par        as   character                no-undo.
     1375     define variable v-cntxp-par-type        as   character                no-undo.
     1376     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     1377     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     1378     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     1379     define variable v-cntxp-db-num          as integer   no-undo .
     1380     define variable v-cntxp-userid          as character no-undo .
     1381     define variable v-cntxp-level           as character no-undo .
     1382     define variable v-cntxp-db-num-obj      as integer   no-undo .
     1383     define variable v-cntxp-is-admin        as logical   no-undo .
     1384     define buffer bf-cntxp_store for ub.store.
     1385     define buffer bf-cntxp_shop  for ub.shop.
     1386     define buffer bf-cntxp_sysconf for ub.sysconf.
     1387   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
     1388   procedure who-cli-ora :
     1389   define input  parameter p-cli-code-ora as integer   no-undo .
     1390   define output parameter p-cli-type as character no-undo .
     1391   define output parameter p-cli-code as integer   no-undo .
     1392     do
     1393     on error undo, return error return-value
     1394     :
     1395     if length (string(p-cli-code-ora))  <> 9 then do:
     1396        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
     1397     end.
     1398     if string(p-cli-code-ora) begins "1" or
     1399        string(p-cli-code-ora) begins "2" or
     1400        string(p-cli-code-ora) begins "4" then do:
     1401         p-cli-type = 'орг':U .
     1402         p-cli-code = p-cli-code-ora  .
     1403     end.
     1404     else do:
     1405       if string(p-cli-code-ora) begins "3" then do:
     1406         p-cli-type = 'чел':U .
     1407         p-cli-code = p-cli-code-ora  .
     1408       end.
     1409       else do:
     1410          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
     1411       end.
     1412     end.
     1413     define buffer buf_clients for ub.clients  .
     1414     find first buf_clients no-lock where
     1415                buf_clients.obj-type = p-cli-type and
     1416                buf_clients.obj-code = p-cli-code
     1417                no-error .
     1418         if error-status :error then do:
     1419             return error substitute
     1420             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
     1421                 p-cli-code-ora ,
     1422                 p-cli-type ,
     1423                 p-cli-code ) .
     1424         end.
     1425         if ora-icli_ver-stts-client then do:
     1426             if buf_clients.stts > 0 then do:
     1427                 return error substitute
     1428                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
     1429                     p-cli-code-ora ,
     1430                     p-cli-type ,
     1431                     p-cli-code ) .
     1432             end.
     1433         end.
     1434     end.
     1435   end procedure.
     1436   procedure ora-ver-goods :
     1437   define input  parameter p-gds-code as integer   no-undo .
     1438   define buffer buf_goods for ub.goods  .
     1439   define variable my-message as character no-undo .
     1440     do
     1441     on error undo, return error return-value
     1442     :
     1443           find first buf_goods no-lock where
     1444                      buf_goods.gds-code = p-gds-code no-error .
     1445               if error-status :error then do:
     1446                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
     1447                   undo, return error my-message.
     1448               end.
     1449             if buf_goods.stts > 0 then do:
     1450               assign
     1451                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
     1452                 undo, return error my-message.
     1453             end.
     1454     end.
     1455   end procedure.
     1456   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1457   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   procedure gen-key-rec :
     1459     define input  parameter p-tbl-name    as character no-undo.
     1460     define input  parameter p-bh_tbl-name as handle    no-undo.
     1461     define output parameter p-key-rec     as character no-undo.
     1462     do
     1463     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1464     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1465     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1466     :
     1467       define variable fh               as handle    no-undo .
     1468       define variable v-ok             as logical   no-undo .
     1469       define variable v-inform         as character no-undo .
     1470       define variable v-ind            as integer   no-undo .
     1471       define variable v-idx-field-qnty as integer   no-undo .
     1472       if p-tbl-name = ?
     1473         or p-tbl-name = "":U
     1474       then do:
     1475         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info14 ).
     1476       end.
     1477       if not p-bh_tbl-name:available then do:
     1478         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info14, p-tbl-name ).
     1479       end.
     1480       assign
     1481         p-key-rec = p-tbl-name
     1482         v-inform  = p-bh_tbl-name:index-information(1)
     1483         v-ind     = 2
     1484       .
     1485       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1486       on error undo, return error
     1487       :
     1488         assign
     1489           v-inform = p-bh_tbl-name:index-information( v-ind )
     1490           v-ind    = v-ind + 1
     1491         .
     1492       end.
     1493       if v-inform = ?
     1494         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1495         or entry( 3, v-inform, ",":U ) <> "1":U
     1496       then do:
     1497         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, p-tbl-name ).
     1498       end.
     1499       else do:
     1500         assign
     1501           v-idx-field-qnty = num-entries( v-inform ) - 4
     1502         .
     1503         if v-idx-field-qnty < 2 then do:
     1504           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, p-tbl-name ).
     1505         end.
     1506         do v-ind = 1 to v-idx-field-qnty by 2
     1507         on error undo, return error
     1508         :
     1509           assign
     1510             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1511             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1512           .
     1513         end.
     1514       end.
     1515       if p-key-rec = ? then do:
     1516         assign
     1517           p-key-rec = "":U
     1518         .
     1519         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info14, p-tbl-name ).
     1520       end.
     1521     end.
     1522     return.
     1523   end procedure.
     1524   procedure gen-where-keyr-tab :
     1525     define input  parameter i-tableSerach as character no-undo.
     1526     define input  parameter i-tablekey   as character  no-undo.
     1527     define input  parameter p-key-rec    as character  no-undo.
     1528     define input  parameter p-key-handle as handle     no-undo .
     1529     define input  parameter p-db-name    as character  no-undo .
     1530     define input  parameter p-tt-handle  as handle     no-undo .
     1531     define output parameter o-Where      as character  no-undo.
     1532     do
     1533     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1534     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1535     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1536     :
     1537       define variable v-full-tbl-name  as character no-undo .
     1538       define variable bh_tbl-name      as handle    no-undo .
     1539       define variable fh_key           as handle    no-undo .
     1540       define variable fh_search        as handle    no-undo .
     1541       define variable v-field-num      as integer   no-undo .
     1542       define variable v-count-fld      as integer   no-undo .
     1543       define variable v-inform         as character no-undo .
     1544       define variable v-ind            as integer   no-undo .
     1545       define variable v-idx-field-qnty as integer   no-undo .
     1546       define variable v-field-name     as character no-undo .
     1547       define variable v-field-val      as character no-undo .
     1548       define variable v-word-link      as character no-undo .
     1549       define variable vTable           as character no-undo.
     1550       define variable bh_tbl-key       as handle    no-undo .
     1551       assign
     1552         p-key-rec = trim( p-key-rec )
     1553       .
     1554       if p-key-handle <> ? then do:
     1555         if not valid-handle(p-key-handle)
     1556            or p-key-handle:type <> "buffer"
     1557         then do:
     1558           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info14 ).
     1559         end.
     1560         if num-entries( p-key-rec, chr(3) ) > 1
     1561           or p-key-rec = ?
     1562           or p-key-rec = "":U
     1563         then do:
     1564           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info14, p-key-rec ).
     1565         end.
     1566       end.
     1567       else do:
     1568         if p-key-rec = ?
     1569           or p-key-rec = "":U
     1570         then do:
     1571           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1572         end.
     1573       end.
     1574       assign
     1575         vTable = entry( 1 , p-key-rec, chr(3) )
     1576       .
     1577       if p-tt-handle <> ?
     1578         and ( not valid-handle(p-tt-handle)
     1579               or p-tt-handle:type <> "buffer"
     1580             )
     1581       then do:
     1582         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info14, vTable, chr(10) ).
     1583       end.
     1584       if p-tt-handle = ? then do:
     1585         assign
     1586           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1587         .
     1588         create buffer bh_tbl-name for table v-full-tbl-name .
     1589       end.
     1590       else do:
     1591         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1592       end.
     1593       assign
     1594         v-inform = bh_tbl-name:index-information(1)
     1595         v-ind    = 2
     1596       .
     1597       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1598       on error undo, return error
     1599       :
     1600         assign
     1601           v-inform = bh_tbl-name:index-information( v-ind )
     1602           v-ind    = v-ind + 1
     1603         .
     1604       end.
     1605       if v-inform = ?
     1606         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1607         or entry( 3, v-inform, ",":U ) <> "1":U
     1608       then do:
     1609         delete object bh_tbl-name no-error.
     1610         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info14, vTable ).
     1611       end.
     1612       assign
     1613         v-idx-field-qnty = num-entries( v-inform ) - 4
     1614       .
     1615       if v-idx-field-qnty < 2 then do:
     1616         delete object bh_tbl-name no-error.
     1617         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, vTable ).
     1618       end.
     1619       assign
     1620         o-where     = "where":U
     1621         v-word-link = "":U
     1622         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1623         v-count-fld = 0
     1624       .
     1625       if i-tablekey ne "" and i-tablekey ne ?
     1626       then do:
     1627         assign
     1628           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1629         .
     1630         create buffer bh_tbl-key for table v-full-tbl-name .
     1631       end.
     1632       if i-tableSerach ne "" and i-tableSerach ne ?
     1633       then do:
     1634         delete object bh_tbl-name no-error.
     1635         assign
     1636           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1637         .
     1638         create buffer bh_tbl-name for table v-full-tbl-name .
     1639       end.
     1640       block_where:
     1641       do v-ind = 1 to v-idx-field-qnty by 2
     1642       on error undo, return error
     1643       :
     1644         assign
     1645           v-count-fld = v-count-fld + 1
     1646         .
     1647         if p-key-handle = ?
     1648           and v-count-fld > v-field-num
     1649         then do:
     1650           leave block_where.
     1651         end.
     1652         define variable VfieldKeyTable as handle no-undo.
     1653         assign
     1654           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1655           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1656         .
     1657         if     bh_tbl-key ne ?
     1658         then do:
     1659            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1660            if VfieldKeyTable eq ?
     1661            then next block_where.
     1662         end.
     1663         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1664         then
     1665            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1666         else
     1667            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1668         if p-key-handle = ? then do:
     1669           assign
     1670             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1671           .
     1672         end.
     1673         else do:
     1674           assign
     1675             fh_key = p-key-handle:buffer-field( v-field-name )
     1676           .
     1677           if fh_key = ?
     1678             or not valid-handle( fh_key )
     1679           then do:
     1680             delete object bh_tbl-name.
     1681             if     bh_tbl-key ne ?
     1682             then
     1683                delete object bh_tbl-key.
     1684             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info14, p-key-handle:name, v-field-name ).
     1685           end.
     1686           assign
     1687             v-field-val = fh_key:buffer-value
     1688           .
     1689         end.
     1690         if fh_search:data-type ="character":U then do:
     1691           assign
     1692             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1693             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1694             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1695             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1696             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1697             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1698             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1699             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1700             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1701             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1702             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1703             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1704             v-field-val = substitute( '"&1"', v-field-val )
     1705           .
     1706         end.
     1707         assign
     1708           o-where = substitute( "&1 &2", o-where, v-field-val )
     1709         .
     1710         if v-word-link = "":U then do:
     1711           assign
     1712             v-word-link = "and":U
     1713           .
     1714         end.
     1715       end.
     1716       delete object bh_tbl-name.
     1717       if     bh_tbl-key ne ?
     1718       then
     1719          delete object bh_tbl-key.
     1720       if p-key-handle = ?
     1721         and v-count-fld <> v-field-num
     1722       then do:
     1723         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info14, vTable ).
     1724       end.
     1725     end.
     1726   end procedure.
     1727   procedure gen-hn-keyr-tab :
     1728     define input  parameter i-tableSerach as character no-undo.
     1729     define input  parameter i-tablekey   as character no-undo.
     1730     define input  parameter p-key-rec    as character no-undo.
     1731     define input  parameter p-key-handle as handle    no-undo .
     1732     define input  parameter p-db-name    as character no-undo .
     1733     define input  parameter p-tt-handle  as handle    no-undo .
     1734     define input  parameter p-stts-lock  as integer   no-undo .
     1735     define output parameter o-hn         as handle    no-undo.
     1736     define variable v-full-tbl-name as character no-undo.
     1737     define variable v-where         as character no-undo.
     1738     define variable bh_tbl-name     as handle    no-undo.
     1739     define variable vTable          as character no-undo.
     1740     do
     1741     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1742     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1743     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1744         run gen-where-keyr-tab(i-tableSerach,
     1745                                i-tablekey,
     1746                                p-key-rec,
     1747                                p-key-handle,
     1748                                p-db-name,
     1749                                p-tt-handle,
     1750                                output v-where).
     1751         if i-tableSerach ne "" and i-tableSerach ne ?
     1752         then do:
     1753            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1754            create buffer bh_tbl-name for table v-full-tbl-name .
     1755         end.
     1756         else do:
     1757            if p-tt-handle = ? then do:
     1758               assign
     1759                  vTable = entry( 1 , p-key-rec, chr(3) )
     1760               .
     1761               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1762               create buffer bh_tbl-name for table v-full-tbl-name .
     1763            end.
     1764            else do:
     1765               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1766            end.
     1767         end.
     1768         if p-tt-handle = ? then do:
     1769            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1770         end.
     1771         else do:
     1772            bh_tbl-name:find-first( v-where ) no-error .
     1773         end.
     1774         o-hn = bh_tbl-name.
     1775      end.
     1776   end procedure.
     1777   procedure gen-hn-keyr :
     1778     define input  parameter p-key-rec    as character no-undo.
     1779     define input  parameter p-key-handle as handle    no-undo .
     1780     define input  parameter p-db-name    as character no-undo .
     1781     define input  parameter p-tt-handle  as handle    no-undo .
     1782     define input  parameter p-stts-lock  as integer   no-undo .
     1783     define output parameter o-hn         as handle    no-undo.
     1784     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1785   end.
     1786   procedure gen-row-keyr :
     1787     define input  parameter p-key-rec    as character no-undo.
     1788     define input  parameter p-key-handle as handle    no-undo .
     1789     define input  parameter p-db-name    as character no-undo .
     1790     define input  parameter p-tt-handle  as handle    no-undo .
     1791     define input  parameter p-stts-lock  as integer   no-undo .
     1792     define output parameter p-tbl-row    as rowid     no-undo.
     1793     define output parameter p-tbl-name   as character no-undo.
     1794     define variable vHn as handle no-undo.
     1795       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1796       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1797       p-tbl-name =  vHn:table.
     1798       delete object vHn no-error.
     1799     if p-tbl-row = ? then do:
     1800       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info14, p-tbl-name, p-key-rec ).
     1801     end.
     1802     else do:
     1803       return.
     1804     end.
     1805   end procedure.
     1806   procedure gen-key-fv :
     1807     define input  parameter p-key-rec    as character no-undo .
     1808     define output parameter p-field-list as character no-undo .
     1809     define output parameter p-value-list as character no-undo.
     1810     do
     1811     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1812     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1813     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1814     :
     1815       define variable v-full-tbl-name  as character no-undo .
     1816       define variable bh_tbl-name      as handle    no-undo .
     1817       define variable v-tbl-name       as character no-undo .
     1818       define variable v-field-num      as integer   no-undo .
     1819       define variable v-count-fld      as integer   no-undo .
     1820       define variable v-inform         as character no-undo .
     1821       define variable v-ind            as integer   no-undo .
     1822       define variable v-idx-field-qnty as integer   no-undo .
     1823       define variable v-delim-key      as character no-undo .
     1824       if p-key-rec = ?
     1825         or p-key-rec = "":U
     1826       then do:
     1827         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1828       end.
     1829       assign
     1830         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1831         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1832       .
     1833       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1834       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info14 ).
     1835       assign
     1836         v-inform = bh_tbl-name:index-information(1)
     1837         v-ind    = 2
     1838       .
     1839       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1840       on error undo, return error
     1841       :
     1842         assign
     1843           v-inform = bh_tbl-name:index-information( v-ind )
     1844           v-ind    = v-ind + 1
     1845         .
     1846       end.
     1847       if v-inform = ?
     1848         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1849         or entry( 3, v-inform, ",":U ) <> "1":U
     1850       then do:
     1851         delete object bh_tbl-name no-error.
     1852         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1853       end.
     1854       assign
     1855         v-idx-field-qnty = num-entries( v-inform ) - 4
     1856       .
     1857       if v-idx-field-qnty < 2 then do:
     1858         delete object bh_tbl-name no-error.
     1859         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1860       end.
     1861       assign
     1862         p-field-list = "":U
     1863         p-value-list = "":U
     1864         v-delim-key  = "":U
     1865         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1866         v-count-fld  = 0
     1867       .
     1868       block_where:
     1869       do v-ind = 1 to v-idx-field-qnty by 2
     1870       on error undo, return error
     1871       :
     1872         assign
     1873           v-count-fld = v-count-fld + 1
     1874         .
     1875         if v-count-fld > v-field-num then do:
     1876           leave block_where.
     1877         end.
     1878         assign
     1879           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1880           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1881         .
     1882         if v-ind = 1 then do:
     1883           assign
     1884             v-delim-key = chr(3)
     1885           .
     1886         end.
     1887       end.
     1888       delete object bh_tbl-name.
     1889       if v-count-fld <> v-field-num then do:
     1890         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info14, v-tbl-name ).
     1891       end.
     1892     end.
     1893   end procedure.
     1894   procedure gen-key-field :
     1895     define input  parameter p-table      as character no-undo .
     1896     define output parameter p-field-list as character no-undo .
     1897     do
     1898     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1899     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1900     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1901     :
     1902       define variable v-full-tbl-name  as character no-undo .
     1903       define variable bh_tbl-name      as handle    no-undo .
     1904       define variable v-tbl-name       as character no-undo .
     1905       define variable v-field-num      as integer   no-undo .
     1906       define variable v-count-fld      as integer   no-undo .
     1907       define variable v-inform         as character no-undo .
     1908       define variable v-ind            as integer   no-undo .
     1909       define variable v-idx-field-qnty as integer   no-undo .
     1910       define variable v-delim-key      as character no-undo .
     1911       if p-table = ?
     1912         or p-table = "":U
     1913       then do:
     1914         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info14 ).
     1915       end.
     1916       assign
     1917         v-tbl-name      = p-table
     1918         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1919       .
     1920       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1921       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info14 ).
     1922       assign
     1923         v-inform = bh_tbl-name:index-information(1)
     1924         v-ind    = 2
     1925       .
     1926       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1927       on error undo, return error
     1928       :
     1929         assign
     1930           v-inform = bh_tbl-name:index-information( v-ind )
     1931           v-ind    = v-ind + 1
     1932         .
     1933       end.
     1934       if v-inform = ?
     1935         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1936         or entry( 3, v-inform, ",":U ) <> "1":U
     1937       then do:
     1938         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1939       end.
     1940       assign
     1941         v-idx-field-qnty = num-entries( v-inform ) - 4
     1942       .
     1943       if v-idx-field-qnty < 2 then do:
     1944         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1945       end.
     1946       assign
     1947         p-field-list = "":U
     1948         v-delim-key  = "":U
     1949         v-count-fld  = 0
     1950       .
     1951       block_where:
     1952       do v-ind = 1 to v-idx-field-qnty by 2
     1953       on error undo, return error
     1954       :
     1955         assign
     1956           v-count-fld = v-count-fld + 1
     1957         .
     1958         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1959         if v-ind = 1 then do:
     1960           assign
     1961             v-delim-key = chr(3)
     1962           .
     1963         end.
     1964       end.
     1965       delete object bh_tbl-name.
     1966     end.
     1967   end procedure.
     1968   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1969   define new shared temp-table gds-list no-undo like ub.goods
