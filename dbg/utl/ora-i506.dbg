     7147   end procedure.
     7148   procedure partrsrv-need-rsrv :
     7149     define input  parameter p-parts-in-code   as character no-undo .
     7150     define input  parameter p-parts-out-code  as character no-undo .
     7151     define output parameter p-need-rsrv-parts as logical   no-undo .
     7152     do
     7153     on error undo, return error return-value
     7154     :
     7155       if p-parts-out-code <> p-parts-in-code
     7156       then do:
     7157         assign
     7158           p-need-rsrv-parts = true
     7159         .
     7160       end.
     7161       else do:
     7162         assign
     7163           p-need-rsrv-parts = false
     7164         .
     7165       end.
     7166     end.
     7167   end procedure.
