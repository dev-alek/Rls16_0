     5249     define buffer buf1_gen-attr for ub.gen-attr .
     5250     do
     5251     on error undo, return error return-value
     5252     :
     5253       find first buf_trn-doc no-lock
     5254         where buf_trn-doc.doc-code = p-doc-code
     5255         no-error .
