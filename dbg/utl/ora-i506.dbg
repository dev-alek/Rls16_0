     6938               assign
     6939                   buf_gen-attr.p-key = origpart-key-rec
     6940               no-error .
     6941           end.
     6942             find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     6943             find current buf1_gen-attr exclusive-lock.
     6944             delete buf1_gen-attr .
     6945         end.
     6946         end.
     6947         define variable v-gds-code as integer   no-undo .
     6948   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6949   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6950     (input  unrsrv-parts.artic
