     1328   procedure prn-lib-reportviewer :
     1329     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1330     define input parameter p-report-name-html as character no-undo .
     1331     define input parameter p-param        as character no-undo .
     1332     define variable v-excel           as character no-undo init 'TRUE' .
     1333     define variable v-value-character as character no-undo .
     1334     define variable v-value-integer   as character no-undo .
     1335     define variable v-value-date      as date      no-undo .
     1336     define variable v-value-decimal   as decimal   no-undo .
     1337     define variable rep-excel         as logical   no-undo .
     1338     define variable excel-string      as character no-undo .
     1339     define variable v-param-type      as character no-undo .
     1340     define variable v-tth             as handle    no-undo .
     1341     run adm/shattri.p (
     1342       input "get":U
     1343       ,input  ""
     1344       ,input  0
     1345       ,input  'report-glob':U
     1346       ,input  'rep-excel':U
     1347       ,output v-value-character
     1348       ,output v-value-date
     1349       ,output v-value-decimal
     1350       ,output v-value-integer
     1351       ,output rep-excel
     1352       ,output v-param-type
     1353       ,INPUT-OUTPUT table-handle v-tth
     1354       )  .
     1355     if rep-excel then v-excel = "TRUE" .
     1356     else v-excel = "FALSE" .
     1357     if p-param eq ""
     1358     then
     1359        p-param = "EXCEL:" + v-excel.
     1360     else
     1361        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1362     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1363   end procedure.
     1364   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1365   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1366   procedure fltopend_fltopend :
     1367   define input parameter p-parent-handle as handle no-undo .
     1368   define input parameter p-qh as handle no-undo .
     1369   define input parameter p-flt-open-open-query  as character no-undo .
     1370   define input parameter p-where-cond as character no-undo .
     1371   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1372   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1373   define input parameter p-indexed-reposition as character no-undo .
     1374     do
     1375     on error undo, return error
     1376     :
     1377   define variable v-prepare-string as character no-undo .
     1378   define variable glog as logical no-undo .
     1379   assign
     1380   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1381                      p-where-cond + chr(32)  +
     1382                      p-use-indFIRST-query-tail + chr(32) +
     1383                      p-use-ind-sort-clmn-by + chr(32) +
     1384                      p-indexed-reposition
     1385   .
     1386   assign
     1387   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1388   if not glog
     1389   or error-status:error then do:
     1390     message error-status:get-message(1) view-as alert-box .
     1391     undo, return error .
     1392   end.
     1393   assign
     1394   glog = p-qh:query-open no-error .
     1395   if not glog
     1396   or error-status:error then do:
     1397     message error-status:get-message(1) view-as alert-box .
     1398     undo, return error .
     1399   end.
     1400     end.
     1401   end procedure.
     1402   procedure fltopend_fltfindd :
     1403   define input parameter p-parent-handle as handle no-undo .
     1404   define input parameter p-qh as handle no-undo .
     1405   define input parameter p-rowid as rowid no-undo .
     1406   define input parameter p-next as logical no-undo .
     1407   define input parameter p-lock as integer no-undo .
     1408   define input parameter p-bh as handle no-undo .
     1409   define input parameter p-where-cond as character no-undo .
     1410   define input parameter p-use-index-phrase as character no-undo .
     1411   define variable glog as logical no-undo .
     1412   define variable v-qh as handle no-undo .
     1413   define variable v-bh as handle no-undo .
     1414   define variable v-recid as recid no-undo .
     1415   define variable v-prepare-string as character no-undo .
     1416   do
     1417   on error undo, return error
     1418   on stop undo, return error
     1419   :
     1420     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1421     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1422     create query v-qh.
     1423     v-qh:set-buffers(v-bh).
     1424     v-prepare-string = substitute("for each &1 &2 &3"
     1425                                     ,v-bh:name
     1426                                     ,p-where-cond
     1427                                     ,p-use-index-phrase).
     1428     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1429     if not glog then do:
     1430       delete object v-qh.
     1431       delete object v-bh.
     1432       undo, return error .
     1433     end.
     1434     glog = v-qh:query-open no-error .
     1435     if not glog then do:
     1436       delete object v-qh.
     1437       delete object v-bh.
     1438       undo, return error .
     1439     end.
     1440     if p-next then do:
     1441       v-qh:reposition-to-rowid(p-rowid) no-error .
     1442       glog = v-qh:get-next( p-lock) no-error .
     1443       glog = v-qh:get-next( p-lock) no-error .
     1444       if not glog or v-qh:query-off-end = yes then do:
     1445         glog = v-qh:get-first( p-lock) no-error .
     1446       end.
     1447     end.
     1448     else do:
     1449       glog = v-qh:get-first( p-lock) no-error .
     1450     end.
     1451     v-recid = v-bh:recid no-error .
     1452     delete object v-qh.
     1453     delete object v-bh.
     1454     return string(v-recid) .
     1455   end.
     1456   end procedure.
     1457   procedure fltopend_fltfindq :
     1458   define input parameter p-parent-handle as handle no-undo .
     1459   define input parameter p-qh as handle no-undo .
     1460   define input parameter p-next as logical no-undo .
     1461   define input parameter p-lock as integer no-undo .
     1462   define input parameter p-flt-open-open-query  as character no-undo .
     1463   define input parameter p-where-cond as character no-undo .
     1464   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1465   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1466   define input parameter p-indexed-reposition as character no-undo .
     1467   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1468   define variable glog as logical no-undo .
     1469   define variable v-qh as handle no-undo .
     1470   define variable v-bh as handle no-undo extent 18.
     1471   define variable v-rowid as rowid no-undo extent 18.
     1472   define variable v-ii as integer no-undo .
     1473   define variable v-prepare-string as character no-undo .
     1474   do
     1475   on error undo, return error
     1476   on stop undo, return error
     1477   :
     1478     create query v-qh.
     1479     do v-ii = 1 to p-qh:num-buffers:
     1480       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1481       assign
     1482       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1483       no-error.
     1484       v-qh:add-buffer(v-bh[v-ii]).
     1485     end.
     1486     assign
     1487     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1488                       p-where-cond + chr(32)  +
     1489                       p-use-indFIRST-query-tail + chr(32) +
     1490                       p-use-ind-sort-clmn-by + chr(32) +
     1491                       p-indexed-reposition
     1492     .
     1493     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1494     if not glog then do:
     1495       delete object v-qh.
     1496       do v-ii = 1 to p-qh:num-buffers:
     1497         delete object v-bh[v-ii].
     1498       end.
     1499       undo, return error .
     1500     end.
     1501     glog = v-qh:query-open no-error .
     1502     if not glog then do:
     1503       delete object v-qh.
     1504       do v-ii = 1 to p-qh:num-buffers:
     1505         delete object v-bh[v-ii].
     1506       end.
     1507       undo, return error .
     1508     end.
     1509     if p-next then do:
     1510       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1511       glog = v-qh:get-next( p-lock) no-error .
     1512       glog = v-qh:get-next( p-lock) no-error .
     1513       if not glog or v-qh:query-off-end = yes then do:
     1514         glog = v-qh:get-first( p-lock) no-error .
     1515       end.
     1516     end.
     1517     else do:
     1518       glog = v-qh:get-first( p-lock) no-error .
     1519     end.
     1520     do v-ii = 1 to p-qh:num-buffers:
     1521       assign
     1522       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1523       no-error.
     1524     end.
     1525     delete object v-qh.
     1526     do v-ii = 1 to p-qh:num-buffers:
     1527       delete object v-bh[v-ii].
