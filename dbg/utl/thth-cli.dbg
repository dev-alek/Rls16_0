     4268   PROCEDURE proc-b-print :
     4269   DEFINE VARIABLE date_string              as   character no-undo .
     4270   DEFINE VARIABLE Line                     as   character no-undo .
     4271   DEFINE VARIABLE for-time                 as   character no-undo .
     4272   DEFINE VARIABLE accum-count              as   integer   no-undo .
     4273   DEFINE VARIABLE accum-count2             as   integer   no-undo .
     4274   define variable v-rid                    as   recid no-undo .
     4275   define variable v-self-objtypecode as character no-undo .
     4276   define variable v-alien-objtypecode as character no-undo .
     4277   define variable v-self-cli-name as character no-undo .
     4278   define variable v-old-client as logical no-undo .
     4279   DEFINE FRAME list1
     4280   v-self-objtypecode COLUMN-LABEL "КЛИЕНТ!v16.0" FORMAT "X(12)"
     4281   v-self-cli-name COLUMN-LABEL "НАЗВАНИЕ КЛИЕНТА!v16.0" FORMAT "X(60)"
     4282   X_ext-classif.charkey_two COLUMN-LABEL "ИНН" FORMAT "X(12)"
     4283   v-old-client column-label "До upg" FORMAT "+/"
     4284   v-alien-objtypecode COLUMN-LABEL "КЛИЕНТ!старой версии" FORMAT "X(12)"
     4285   X_ext-classif.charkey_three COLUMN-LABEL "Название клиента старой версии" FORMAT "X(60)"
     4286   HEADER  date_string AT 5 format "X(35)"
     4287   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     4288   Line format "X(198)" AT 1
     4289   with width 232 down stream-io use-text    .
     4290   Line = fill("-", 198).
     4291   date_string = cur-time-print() .
     4292   run prn-lib-open-stream  in this-procedure (
     4293                                                input parParentProc
     4294                                               ,input 43
     4295                                               ,input yes
     4296                                               ,input no
     4297                                               ).
     4298   PUT  STREAM PrnLibStream
     4299   SPACE(25) ( frame Dialog-Frame:title )
     4300   format "x(90)" SKIP(1) .
     4301   FORM HEADER
     4302   Line format "X(198)" AT 1 SKIP
     4303   "Продолжение - на следующей странице" AT 30 SKIP
     4304   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4305   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4306   v-rid = recid(X_ext-classif).
     4307   FORM with FRAME List1.
     4308   run waitfram-show in this-procedure ( input "Ждите...").
     4309   DO WHILE available X_ext-classif :
     4310      GET prev br-clients.
     4311   END.
     4312   GET next br-clients.
     4313   DO WHILE available X_ext-classif :
     4314     Display STREAM PrnLibStream
     4315     (if X_ext-classif.uniq-key-rec BEGINS 'clients':U
     4316     then (entry(2, X_ext-classif.uniq-key-rec, chr(3)) +
     4317           entry(3, X_ext-classif.uniq-key-rec, chr(3)))
     4318     else '') @ v-self-objtypecode
     4319     (if X_ext-classif.uniq-key-rec BEGINS 'clients':U
     4320     THEN get-cli-name(X_ext-classif.uniq-key-rec)
     4321     ELSE '') @ v-self-cli-name
     4322     (X_Ext-classif.key#_three = 1 ) @ v-old-client
     4323     X_Ext-classif.charkey_two
     4324     (X_ext-classif.charkey_one + string(X_ext-classif.key#_one)) @ v-alien-objtypecode
     4325     X_Ext-classif.charkey_three
     4326     with FRAME List1.
     4327     DOWN STREAM PrnLibStream
     4328     1
     4329     with FRAME List1.
     4330     assign
     4331     accum-count = accum-count + 1
     4332     .
     4333     if X_ext-classif.uniq-key-rec <> '' then do:
     4334       accum-count2 = accum-count2 + 1.
     4335     end.
     4336     GET next br-clients.
     4337   END.
     4338   UNDERLINE  STREAM PrnLibStream
     4339   v-self-objtypecode
     4340   v-alien-objtypecode
     4341   with FRAME List1.
     4342   DISPLAY STREAM PrnLibStream
     4343   accum-count2 @ v-self-objtypecode
     4344   accum-count @ v-alien-objtypecode
     4345   with frame List1.
     4346   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4347   HIDE  STREAM PrnLibStream FRAME List1.
     4348   output  STREAM PrnLibStream CLOSE.
     4349   reposition br-clients to recid v-rid no-error .
     4350   apply "ENTRY" to br-clients in frame Dialog-Frame .
     4351   run waitfram-hide in this-procedure .
     4352   run prn-lib-prn-file in this-procedure (
     4353                                             input parParentProc
     4354                                             ,input 0
     4355                                             ).
     4356   END PROCEDURE.
     4357   PROCEDURE proc-b-sch :
     4358   define variable v-ri as recid no-undo .
     4359   assign
     4360   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     4361   .
     4362   assign
     4363   tbl = 'ext-classif':U
     4364   join-tbl = 'X_ext-classif'
     4365   fld = ""
     4366   lab = ""
     4367   spr = ""
     4368   dim = '0'
     4369   .
     4370   run fltfield-add in this-procedure('charkey_one', substitute('Тип клиента &1', p-from-version), '',
     4371   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4372   run fltfield-add in this-procedure('key#_one', substitute('Код клиента &1', p-from-version), '',
     4373   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4374   run fltfield-add in this-procedure('charkey_two', "ИНН", '',
     4375   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4376   run fltfield-add in this-procedure('charkey_three', substitute('Название клиента &1', p-from-version), '',
     4377   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4378   run fltfield-add in this-procedure('uniq-key-rec', 'Уникальный ключ записи в БД v16.0', '',
     4379   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4380   DO on stop undo, leave:
     4381       run gbl/filter.w ( INPUT parparentproc
     4382                    ,INPUT filter-point + chr(4) + filter-label
     4383                    ,INPUT tbl
     4384                    ,INPUT join-tbl
     4385                    ,INPUT fld
     4386                    ,INput lab
     4387                    ,INPUT spr
     4388                    ,INPUT  dim).
     4389       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     4390       if v-ri <> ? then do:
     4391         reposition br-clients to recid v-ri no-error.
     4392       end.
     4393       APPLY "ENTRY" to br-clients in frame Dialog-Frame .
     4394       APPLY "VALUE-CHANGED" to br-clients.
     4395   END .
     4396   END PROCEDURE.
     4397   PROCEDURE proc-b-tie :
     4398   define variable v-rid-list as character no-undo .
     4399   define variable glog as logical no-undo .
     4400   define variable v-rec as recid no-undo .
     4401   define variable v-uniq-key-rec as character no-undo .
     4402   define variable v-recid as recid  no-undo .
     4403   define buffer buf_clients for ub.clients.
     4404   define buffer buf_ext-classif for ub.ext-classif.
     4405   define buffer buf_sysconf for ub.sysconf.
     4406   if X_ext-classif.uniq-key-rec <> ''
     4407   and X_ext-classif.key#_three = 1
     4408   then do:
     4409     message
     4410     "Данное соответствие установлено в процессе upgrade - КЛИЕНТ ССЫЛАЕТСЯ САМ НА СЕБЯ - перепривязать НЕВОЗМОЖНО"
     4411     view-as alert-box error .
     4412     undo, return error .
     4413   end.
     4414   if X_ext-classif.uniq-key-rec <> ''
     4415   and X_ext-classif.key#_three = 2
     4416   then do:
     4417     message
     4418     "Данное соответствие установлено в процессе сведения объектов РАНЕЕ - перепривязать НЕВОЗМОЖНО"
     4419     view-as alert-box error .
     4420     undo, return error .
     4421   end.
     4422   if X_ext-classif.uniq-key-rec <> '' then do:
     4423   message
     4424   substitute("Уже есть соответствие  между данные клиента &1&2 в БД &4 и в БД v16.0&3" +
     4425              "Вы УВЕРЕНЫ, что хотите их изменить?"
     4426              , entry(2, X_ext-classif.uniq-key-rec, chr(3))
     4427              , entry(3, X_ext-classif.uniq-key-rec, chr(3))
     4428              , chr(10)
     4429              , p-from-version
     4430              )
     4431   view-as alert-box question buttons yes-no update glog.
     4432   if not glog then return no-apply.
     4433   find first buf_clients no-lock where
     4434           buf_clients.obj-type = entry(2, X_ext-classif.uniq-key-rec, chr(3))
     4435       and buf_clients.obj-code = integer(entry(3, X_ext-classif.uniq-key-rec, chr(3))).
     4436   v-rid-list = string(recid(buf_clients)).
     4437   end.
     4438   run ref/cli-all.w (   input parparentproc
     4439                   ,input "b-sel"
     4440                   ,input (if p-list-mode = 'объект':U then 'объект':U else X_ext-classif.charkey_one)
     4441                   ,input 'все':U
     4442                   ,input 'текущие':U
     4443                   ,input ?
     4444                   ,input ",,,,,,NO,,"
     4445                   ,input (if p-list-mode = 'объект':U then "lock-cli-type" else '')
     4446                   ,output v-rid-list) no-error.
     4447   if v-rid-list = '':U then return no-apply.
     4448   find first buf_clients where recid (buf_clients) = integer (v-rid-list) no-lock no-error.
     4449   if p-list-mode = 'объект':U then do:
     4450     if not (buf_clients.obj-type = 'маг':U
     4451         or
     4452         buf_clients.obj-type = 'скл':U) then do:
     4453       message
     4454       "Можно выбрать только ОРГАНИЗАЦИЮ или ФИЗ.ЛИЦО"
     4455       view-as alert-box error .
     4456       undo, return no-apply .
     4457     end.
     4458   end.
     4459   else do:
     4460     if not (buf_clients.obj-type = 'орг':U
     4461         or
     4462         buf_clients.obj-type = 'чел':U) then do:
     4463       message
     4464       "Можно выбрать только ОРГАНИЗАЦИЮ или ФИЗ.ЛИЦО"
     4465       view-as alert-box error .
     4466       undo, return no-apply .
     4467     end.
     4468   end.
     4469   run gen-key-rec in this-procedure ( input 'clients':U
     4470                                   ,input (buffer buf_clients:handle)
     4471                                   ,output v-uniq-key-rec).
     4472   v-rec = recid(X_ext-classif).
     4473   find first buf_ext-classif no-lock where
     4474             buf_ext-classif.classif-subject = 'clients':U
     4475         and buf_ext-classif.classif-name = v-cli-classif-name
     4476         and buf_ext-classif.uniq-key-rec = v-uniq-key-rec no-error.
     4477   if available buf_ext-classif then do:
     4478     message
     4479     substitute('Клиент &1&2 в БД v16.0 уже привязан к клиенту в БД &5 (&3&4)'
     4480                                   , buf_clients.obj-type
     4481                                   , buf_clients.obj-code
     4482                                   , buf_ext-classif.charkey_One
     4483                                   , buf_ext-classif.key#_one
     4484                                   , p-from-version
     4485                                   )
     4486     view-as alert-box error .
     4487     undo, return no-apply.
     4488   end.
     4489   if X_ext-classif.key#_two = 1
     4490   and p-list-mode <> 'объект':U
     4491   then do:
     4492     if buf_clients.obj-type <> 'орг':U
     4493     or not can-find(ub.sysconf no-lock where
     4494                     ub.sysconf.host-code = buf_clients.obj-code)
     4495     then do:
     4496       if buf_clients.obj-type <> 'орг':U then do:
     4497         message
     4498         substitute('Клиент &1&2 в БД &4 является СВОЕЙ ФИРМОЙ - соответствующий клиент в БД v16.0 должен быть типа &3 и СВОЕЙ ФИРМОЙ'
     4499                   , X_ext-classif.charkey_One
     4500                   , X_ext-classif.key#_one
     4501                   , 'орг':U
     4502                   ,p-from-version
     4503                   )
     4504         view-as alert-box error .
     4505         undo, return no-apply.
     4506       end.
     4507       else do:
     4508         message
     4509         substitute('Клиент &1&2 в БД &4 является СВОЕЙ ФИРМОЙ - соответствующий клиент в БД v16.0 должен быть СВОЕЙ ФИРМОЙ&3' +
     4510                    "Сделать клиента &1&2 БД v16.0 СВОЕЙ ФИРМОЙ?"
     4511                   , X_ext-classif.charkey_One
     4512                   , X_ext-classif.key#_one
     4513                   , chr(10)
     4514                   , p-from-version
     4515                   )
     4516         view-as alert-box question buttons yes-no update glog .
     4517         if not glog then do:
     4518           undo, return no-apply.
     4519         end.
     4520         else do:
     4521           run adm/config.w ( input parparentproc
     4522                               , input buf_clients.obj-code
     4523                               , input 'ДОБАВЛЕНИЕ':U
     4524                               , input yes
     4525                               )  no-error.
     4526           if error-status:error then do:
     4527             message
     4528             substitute("Ошибка при создании СВОЕЙ ФИРМЫ из &1&2&3&4&3&5"
     4529                        ,buf_clients.obj-type
     4530                        ,buf_clients.obj-code
     4531                        , chr(10)
     4532                        , error-status:get-message(1)
     4533                        , return-value )
     4534            view-as alert-box error .
     4535            undo, return no-apply.
     4536           end.
     4537           else do:
     4538             find first buf_sysconf no-lock where
     4539                       buf_sysconf.host-code = buf_clients.obj-code no-error.
     4540             if not available buf_sysconf then do:
     4541               message
     4542               substitute("Не найдена СВОЯ ФИРМА с кодом &1, видимо попытка создания СВОЕЙ ФИРМЫ из &2&1 НЕ УДАЛАСЬ"
     4543                          , buf_clients.obj-code
     4544                          , buf_clients.obj-type
     4545                          )
     4546               view-as alert-box error .
     4547               undo, return no-apply.
     4548             end.
     4549             else do:
     4550               message
     4551               substitute("Успешно создана СВОЯ ФИРМА с кодом &1, теперь будем связывать"
     4552                          , buf_clients.obj-code
     4553                          , chr(10)
     4554                          )
     4555               view-as alert-box WARNING.
     4556             end.
     4557           end.
     4558         end.
     4559       end.
     4560     end.
     4561   end.
     4562   if p-list-mode = 'объект':U then do:
     4563     define buffer sysconf_ext-classif for ub.ext-classif.
     4564     find first sysconf_ext-classif no-lock where
     4565               sysconf_ext-classif.classif-subject = 'clients':U
     4566           and sysconf_ext-classif.classif-name = v-cli-classif-name
     4567           and sysconf_ext-classif.charkey_one = 'орг':U
     4568           and sysconf_ext-classif.key#_one = X_ext-classif.key#_two  no-error.
     4569     if not available sysconf_ext-classif then do:
     4570         message
     4571         substitute("Не найдена запись соответствия для СВОЕЙ ФИРМЫ &3 объекта &1&2 БД &4"
     4572                     , X_ext-classif.charkey_one
     4573                     , X_ext-classif.key#_one
     4574                     , X_ext-classif.key#_two
     4575                     , p-from-version
     4576                     )
     4577         view-as alert-box error .
     4578         undo, return no-apply.
     4579     end.
     4580     DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     4581     DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     4582     define buffer sysconf_clients for ub.clients.
     4583     RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT sysconf_ext-classif.uniq-key-rec
     4584                                         ,input ?
     4585                                         ,INPUT "ub"
     4586                                         ,INPUT ?
     4587                                         ,INPUT NO-LOCK
     4588                                         ,OUTPUT v-rowid
     4589                                         ,OUTPUT v-tbl-name) no-error.
     4590     if error-status:error then do:
     4591         message
     4592         substitute("Ошибка при поиcке записи соответствия с уникальным ключом записи <&4> для СВОЕЙ ФИРМЫ &3 объекта &1&2 БД &5"
     4593                     , X_ext-classif.charkey_one
     4594                     , X_ext-classif.key#_one
     4595                     , X_ext-classif.key#_two
     4596                     , sysconf_ext-classif.uniq-key-rec
     4597                     , p-from-version
     4598                     )
     4599         view-as alert-box error .
     4600         undo, return no-apply.
     4601     end.
     4602     find first sysconf_clients where
     4603             rowid(sysconf_clients) = v-rowid no-error.
     4604     if not available sysconf_clients then do:
     4605       message
     4606       substitute("Не найдена для СВОЕЙ ФИРМЫ &3 объекта &1&2 БД &4 не найдена соответствующая запись в БД v16.0"
     4607                   , X_ext-classif.charkey_one
     4608                   , X_ext-classif.key#_one
     4609                   , X_ext-classif.key#_two
     4610                   , p-from-version
     4611                   )
     4612       view-as alert-box error .
     4613       undo, return no-apply.
     4614     end.
     4615     if not can-find( first ub.sysconf no-lock where ub.sysconf.host-code = sysconf_clients.obj-code) then do:
     4616         message
     4617         substitute("СВОЯ ФИРМА &3 объекта &1&2 БД &4 в БД v16.0 НЕ ЯВЛЯЕТСЯ СВОЕЙ ФИРМОЙ"
     4618                     , X_ext-classif.charkey_one
     4619                     , X_ext-classif.key#_one
     4620                     , X_ext-classif.key#_two
     4621                     , p-from-version
     4622                     )
     4623         view-as alert-box error .
     4624         undo, return no-apply.
     4625     end.
     4626     if not (buf_clients.host-code = sysconf_clients.obj-code)
     4627     then do:
     4628         message
     4629         substitute("Для того чтобы связать объект &1&2 БД &5 и объект БД v16.0 &3&4 их СВОИ ФИРМЫ тоже должны быть СВЯЗАНЫ"
     4630                     , X_ext-classif.charkey_one
     4631                     , X_ext-classif.key#_one
     4632                     , buf_clients.obj-type
     4633                     , buf_clients.obj-code
     4634                     , p-from-version
     4635                     )
     4636         view-as alert-box error .
     4637         undo, return no-apply.
     4638     end.
     4639   end.
     4640   run ref/extclas1.p (
     4641                         input 'ИЗМЕНЕНИЕ':U
     4642                       ,input yes
     4643                       ,input-output v-rec
     4644                       ,input 'clients':U
     4645                       ,input v-cli-classif-name
     4646                       ,input X_ext-classif.db-num
     4647                       ,input X_ext-classif.Key#_One
     4648                       ,input X_ext-classif.Key#_two
     4649                       ,input X_ext-classif.Key#_three
     4650                       ,input X_ext-classif.charkey_One
     4651                       ,input X_ext-classif.charkey_two
     4652                       ,input X_ext-classif.charkey_three
     4653                       ,input X_ext-classif.nonunique
     4654                       ,input v-uniq-key-rec
     4655                       ) no-error.
     4656   if error-status:error then do:
     4657     message
     4658     substitute('Ошибка при сохранении записи по клиенту &6 &1&2&3:&4&3&5'
     4659                                   , X_ext-classif.charkey_One
     4660                                   , X_ext-classif.key#_One
     4661                                   ,chr(10)
     4662                                   , error-status:get-message(1)
     4663                                   , return-value
     4664                                   , p-from-version
     4665                                   )
     4666     view-as alert-box error .
     4667     undo, return no-apply.
     4668   end.
     4669   assign
     4670   v-recid = recid(X_ext-classif).
     4671   run Openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U).
     4672   reposition  br-clients to recid v-recid no-error.
     4673   APPLY "entry" to br-clients in frame Dialog-Frame .
     4674   apply "value-changed" to br-clients.
     4675   END PROCEDURE.
     4676   PROCEDURE proc-close :
     4677   define variable v-loc-closed as character no-undo .
     4678   define variable glog as logical no-undo .
     4679   define buffer buf_ext-classif for ub.ext-classif.
     4680   case p-from-version:
     4681     when 'v15_0000':U then do:
     4682       run thth150-db-attr-value in this-procedure ( input g#db-num
     4683                                                 ,input v-attr-code
     4684                                                 ,output v-loc-closed
     4685                                                 ,output v-type) .
     4686     end.
     4687     when 'v14_0':U then do:
     4688       run thth14-db-attr-value in this-procedure ( input g#db-num
     4689                                                 ,input v-attr-code
     4690                                                 ,output v-loc-closed
     4691                                                 ,output v-type) .
     4692     end.
     4693   end case.
     4694   if logical(v-loc-closed) then do:
     4695     if p-list-mode = 'объект':U then do:
     4696       message
     4697       "Уже завершен этап УСТАНОВКИ СООТВЕТСТВИЯ ДАННЫХ ПО ОБЪЕКТАМ в разных системах IBS TH"
     4698       view-as alert-box error .
     4699       undo, return error .
     4700     end.
     4701     else do:
     4702       message
     4703       "Уже завершен этап УСТАНОВКИ СООТВЕТСТВИЯ ДАННЫХ ПО КЛИЕНТОВ в разных системах IBS TH"
     4704       view-as alert-box error .
     4705       undo, return error .
     4706     end.
     4707   end.
     4708   if p-list-mode = 'объект':U then do:
     4709     message
     4710     "Вы уверены, что Вы полностью установили СООТВЕТСТВИЕ ДАННЫХ ПО ОБЪЕКТАМ в разных системах IBS TH?"
     4711     view-as alert-box question buttons yes-no update glog.
     4712   end.
     4713   else do:
     4714     message
     4715     "Вы уверены, что Вы полностью установили СООТВЕТСТВИЕ ДАННЫХ ПО КЛИЕНТАМ в разных системах IBS TH?"
     4716     view-as alert-box question buttons yes-no update glog.
     4717   end.
     4718   if not glog then undo, return .
     4719   find first buf_ext-classif no-lock where
     4720             buf_ext-classif.classif-subject = 'clients':U
     4721         and buf_ext-classif.classif-name = v-cli-classif-name
     4722         AND buf_ext-classif.db-num = - 1
     4723         AND (((buf_ext-classif.charkey_One = 'орг':U or buf_ext-classif.charkey_One = 'чел':U)
     4724              and p-list-mode = '')
     4725              or
     4726              ((buf_ext-classif.charkey_One = 'маг':U or buf_ext-classif.charkey_One = 'скл':U)
     4727              and p-list-mode = 'объект':U)
     4728              )
     4729         and buf_ext-classif.uniq-key-rec = '' no-error.
     4730   if available buf_ext-classif then do:
     4731     if p-list-mode = 'объект':U then do:
     4732       message
     4733       substitute("ИМЕЕТСЯ запись по объекту в БД &1, которой не соответствует ни один ОБЪЕКТ БД v16.0", p-from-version) skip
     4734       "Вы уверены, что хотите закрыть этап?"
     4735       view-as alert-box question buttons YES-NO update glog .
     4736       if not glog then undo, return error .
     4737     end.
     4738     else do:
     4739       message
     4740       substitute("ИМЕЕТСЯ запись по клиенту в БД &1, которой не соответствует ни один КЛИЕНТ БД v16.0", p-from-version) skip
     4741       "Закрытие этапа НЕВОЗМОЖНО"
     4742       view-as alert-box error .
     4743       undo, return error .
     4744     end.
     4745   end.
     4746   main-block:
     4747   do transaction:
     4748     for each buf_ext-classif where
     4749             buf_ext-classif.classif-subject = 'clients':U
     4750         and buf_ext-classif.classif-name = v-cli-classif-name
     4751         AND buf_ext-classif.db-num = - 1
     4752         AND buf_ext-classif.key#_three = 0
     4753         and buf_ext-classif.uniq-key-rec > ''
     4754         and (
     4755               ( (buf_ext-classif.charkey_one = 'скл':U
     4756                   or buf_ext-classif.charkey_one = 'маг':U)
     4757                   and p-list-mode = 'объект':U
     4758               )
     4759               or
     4760                 ( (buf_ext-classif.charkey_one = 'орг':U
     4761                   or buf_ext-classif.charkey_one = 'чел':U)
     4762                   and p-list-mode = ""
     4763                 )
     4764              )
     4765     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4766     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4767     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4768     :
     4769       assign
     4770       buf_ext-classif.key#_three = 2
     4771       .
     4772     end.
     4773   case p-from-version:
     4774     when 'v15_0000':U then do:
     4775       run thth150-db-attr-write in this-procedure (
     4776                                                 input g#db-num
     4777                                                 ,input v-attr-code
     4778                                                 ,input string(yes)).
     4779     end.
     4780     when 'v14_0':U then do:
     4781       run thth14-db-attr-write in this-procedure (
     4782                                                 input g#db-num
     4783                                                 ,input v-attr-code
     4784                                                 ,input string(yes)).
     4785     end.
     4786   end case.
     4787   end.
     4788   v-loc-closed = ''.
     4789   case p-from-version:
     4790     when 'v15_0000':U then do:
     4791       run thth150-db-attr-value in this-procedure ( input g#db-num
     4792                                                 ,input v-attr-code
     4793                                                 ,output v-loc-closed
     4794                                                 ,output v-type) .
     4795     end.
     4796     when 'v14_0':U then do:
     4797       run thth14-db-attr-value in this-procedure ( input g#db-num
     4798                                                 ,input v-attr-code
     4799                                                 ,output v-loc-closed
     4800                                                 ,output v-type) .
     4801     end.
     4802   end case.
     4803   if logical(v-loc-closed) = yes then do:
     4804     disable
     4805     b-close
     4806     with frame Dialog-Frame .
     4807     if available X_ext-classif then v-doc-rec = recid(X_ext-classif).
     4808     run openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U) no-error.
     4809     reposition br-clients to recid(v-doc-rec) no-error. APPLy 'ENTRY' to br-clients .
     4810   end.
     4811   END PROCEDURE.
     4812   PROCEDURE proc-copy :
     4813   DEFINE INPUT PARAMETER p-copy-option AS CHARACTER NO-UNDO.
     4814   define variable v-ok as logical no-undo .
     4815   define variable v-recid as recid no-undo .
     4816   run cmp/upg-conn.p ( input "connect"
     4817                       ,input p-from-version
     4818                       ,output v-ok) no-error.
     4819   if not v-ok then do:
     4820     message
     4821     substitute("Ошибка при подключении к БД &4 TH&1&2&1&3"
     4822                , chr(10)
     4823                , error-status:get-message(1)
     4824                , return-value
     4825                , p-from-version
     4826                )
     4827     view-as alert-box error .
     4828     return error .
     4829   end.
     4830   run str/diallog.w ( input parparentproc
     4831             , input this-procedure
     4832             , input 'cmp/ththclit.p':U
     4833             , input (p-copy-option + chr(4) +
     4834                     (if p-copy-option = 'one'
     4835                     then X_ext-classif.charkey_one
     4836                     else '') + chr(4) +
     4837                     (if p-copy-option = 'one'
     4838                     then string(X_ext-classif.key#_one)
     4839                     else '0') + chr(4) +
     4840                     (if p-copy-option = 'list'
     4841                     then v-rid-list
     4842                     else '') + chr(4) +
     4843                     p-from-version
     4844                     )
     4845             , input yes
     4846             , input ''
     4847             , input substitute('Копирование данных по клиентам из БД &1 во временную таблицу', p-from-version)) no-error .
     4848   if connected ("src") then do:
     4849     disconnect src.
     4850   end.
     4851   if can-find (first clients-01) then do:
     4852     run str/diallog.w ( input parparentproc
     4853               , input this-procedure
     4854               , input 'cmp/ththclis.p':U
     4855               , input p-from-version
     4856               , input no
     4857               , input ''
     4858               , input 'Сохранение данных по клиентам в БД v16.0') no-error .
     4859   end.
     4860   else do:
     4861     message
     4862     "Нет записей во временной таблице - НЕЧЕГО СОХРАНЯТЬ"
     4863     view-as alert-box .
     4864   end.
     4865   assign
     4866   v-recid = recid(X_ext-classif).
     4867   run Openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U).
     4868   reposition  br-clients to recid v-recid no-error.
     4869   APPLY "entry" to br-clients in frame Dialog-Frame .
     4870   apply "value-changed" to br-clients.
     4871   END PROCEDURE.
     4872   PROCEDURE proc-find-old-code :
     4873   define input parameter p-next as logical no-undo.
     4874   define input parameter p-old-code AS INTEGER no-undo.
     4875   DEFINE VARIABLE v-old-code AS CHARACTER NO-UNDO.
     4876   assign
     4877   sch-self-code = 0
     4878   .
     4879   display
     4880   0 @ sch-self-code
     4881   with frame Dialog-Frame.
     4882   assign
     4883   v-old-code = string(p-old-code).
     4884   run OpenBr in this-procedure
     4885       (input false
     4886       ,input p-next
     4887       ,input substitute(" and X_ext-classif.key#_one = &1 and X_ext-classif.charkey_one = &2&3&2"
     4888         , v-old-code
     4889         , chr(34)
     4890         , rs-cli-type)
     4891       ).
     4892   apply "entry":u to sch-self-code in frame Dialog-Frame .
     4893   END PROCEDURE.
     4894   PROCEDURE proc-find-self-code :
     4895   define input parameter p-next as logical no-undo.
     4896   define input parameter p-self-code AS INTEGER no-undo.
     4897   assign
     4898   sch-old-code = 0
     4899   .
     4900   display
     4901   0 @ sch-old-code
     4902   with frame Dialog-Frame.
     4903   run OpenBr in this-procedure
     4904       (input false
     4905       ,input p-next
     4906       ,input substitute(" and X_ext-classif.uniq-key-rec = &1&2&3&4&3&5&1 "
     4907                         , chr(34)
     4908                         , 'clients':U
     4909                         , chr(3)
     4910                         , rs-cli-type
     4911                         , p-self-code)
     4912       ).
     4913   END PROCEDURE.
     4914   PROCEDURE proc-imp :
     4915   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     4916   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     4917   DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     4918   if p-list-mode = 'объект':U then do:
     4919     FIND FIRST buf_ext-classif NO-LOCK WHERE
     4920             buf_ext-classif.classif-subject = 'clients':U
     4921         and buf_ext-classif.classif-name = v-cli-classif-name
     4922         AND buf_ext-classif.db-num = - 1
     4923         and (buf_ext-classif.charkey_one = 'маг':U
     4924             or
     4925             buf_ext-classif.charkey_one = 'скл':U
     4926             )
     4927         and buf_ext-classif.key#_three = 0
     4928         NO-ERROR.
     4929   end.
     4930   else do:
     4931     FIND FIRST buf_ext-classif NO-LOCK WHERE
     4932             buf_ext-classif.classif-subject = 'clients':U
     4933         and buf_ext-classif.classif-name = v-cli-classif-name
     4934         AND buf_ext-classif.db-num = - 1
     4935         and (buf_ext-classif.charkey_one = 'орг':U
     4936             or
     4937             buf_ext-classif.charkey_one = 'чел':U
     4938             )
     4939         and buf_ext-classif.key#_three = 0
     4940         NO-ERROR.
     4941   end.
     4942   IF NOT AVAILABLE buf_ext-classif THEN DO:
     4943     if p-list-mode = 'объект':U then do:
     4944       MESSAGE
     4945       substitute("Вы действительно хотите получить данные по объектам системы TH &1?", p-from-version)
     4946       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     4947     end.
     4948     else do:
     4949       MESSAGE
     4950       substitute("Вы действительно хотите получить соответствие данных по клиентам системы TH &1?", p-from-version)
     4951       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     4952     end.
     4953     IF NOT glog  THEN RETURN NO-APPLY.
     4954   END.
     4955   ELSE DO:
     4956     if p-list-mode = 'объект':U then do:
     4957       MESSAGE
     4958       substitute("У Вас уже есть закачанные данные по объектам системы TH &1", p-from-version) SKIP
     4959       "Повторный импорт УНИЧТОЖИТ ВСЕ СООТВЕТСТВИЕ УСТАНОВЛЕННЫЕ ПОСЛЕ upgrade и предыдущих сведений" SKIP
     4960       substitute("Вы действительно хотите вкачать данные по клиентам системы TH &1?", p-from-version)
     4961       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     4962     end.
     4963     else do:
     4964       MESSAGE
     4965       substitute("У Вас уже есть закачанные соответствия по клиентам системы TH &1", p-from-version) SKIP
     4966       "Повторный импорт УНИЧТОЖИТ ВСЕ СООТВЕТСТВИЕ УСТАНОВЛЕННЫЕ ПОСЛЕ upgrade и предыдущих сведений" SKIP
     4967       substitute("Вы действительно хотите вкачать соответствия по клиентам системы TH &1?", p-from-version)
     4968       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     4969     end.
     4970     IF NOT glog  THEN RETURN NO-APPLY.
     4971   END.
     4972   run cmp/upg-conn.p ( input "connect"
     4973                       ,input p-from-version
     4974                       ,output v-ok) no-error.
     4975   if not v-ok then do:
     4976     message
     4977     substitute("Ошибка при подключении к БД &4TH&1&2&1&3"
     4978                , chr(10)
     4979                , error-status:get-message(1)
     4980                , return-value
     4981                , p-from-version
     4982                )
     4983     view-as alert-box error .
     4984     return error .
     4985   end.
     4986   run str/diallog.w ( input parparentproc
     4987             , input this-procedure
     4988             , input (if p-list-mode = 'объект':U
     4989                      then 'cmp/ththshpi.p':U
     4990                      else 'cmp/ththclii.p':U)
     4991             , input p-from-version
     4992             , input no
     4993             , input ''
     4994             , input substitute('Закачка соответствий по клиентам БД &1', p-from-version)) no-error .
     4995   if connected ("src") then do:
     4996     disconnect src.
     4997   end.
     4998   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     4999   APPLY "entry" TO br-clients in frame Dialog-Frame .
     5000   END PROCEDURE.
     5001   PROCEDURE proc-imp-gds :
     5002   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     5003   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     5004   DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     5005   FIND FIRST buf_ext-classif NO-LOCK WHERE
     5006           buf_ext-classif.classif-subject = 'clients':U
     5007       and buf_ext-classif.classif-name = v-cli-classif-name
     5008       AND buf_ext-classif.db-num = - 1
     5009       and (buf_ext-classif.charkey_one = 'орг':U
     5010           or
     5011           buf_ext-classif.charkey_one = 'чел':U
     5012           )
     5013       and buf_ext-classif.key#_three = 0
     5014       NO-ERROR.
     5015   IF AVAILABLE buf_ext-classif THEN DO:
     5016     MESSAGE
     5017     "Вы действительно хотите начать процесс ИНТЕРАКТИВНОГО СВЕДЕНИЯ клиентов-производителей по их ТОВАРАМ(ДопБК)?"
     5018     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     5019     IF NOT glog  THEN RETURN NO-APPLY.
     5020   END.
     5021   ELSE DO:
     5022     if p-list-mode = 'объект':U then do:
     5023     end.
     5024     else do:
     5025       glog = no.
     5026       MESSAGE
     5027       substitute("ЕЩЕ НЕТ закачанных сведений по клиентам системы TH &1,", p-from-version) SKIP
     5028       "(кнопка ПОЛУЧИТЬ СООТВЕТСТВИЯ)"
     5029       VIEW-AS ALERT-BOX .
     5030     end.
     5031     IF NOT glog  THEN RETURN NO-APPLY.
     5032   END.
     5033   run cmp/upg-conn.p ( input "connect"
     5034                       ,input p-from-version
     5035                       ,output v-ok) no-error.
     5036   if not v-ok then do:
     5037     message
     5038     substitute("Ошибка при подключении к БД TH &4&1&2&1&3"
     5039                , chr(10)
     5040                , error-status:get-message(1)
     5041                , return-value
     5042                , p-from-version
     5043                )
     5044     view-as alert-box error .
     5045     return error .
     5046   end.
     5047   run str/diallog.w ( input parparentproc
     5048             , input this-procedure
     5049             , input 'cmp/ththclig.p':U
     5050             , input p-from-version
     5051             , input no
     5052             , input ''
     5053             , input 'Интерактивное сведение по товарам клиентов-производителей') no-error .
     5054   if connected ("src") then do:
     5055     disconnect src.
     5056   end.
     5057   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     5058   APPLY "entry" TO br-clients in frame Dialog-Frame .
     5059   END PROCEDURE.
     5060   PROCEDURE set-row-color :
     5061   DEF VAR iFGColor AS INTEGER NO-UNDO.
     5062   DEF VAR iBGColor AS INTEGER NO-UNDO.
     5063     IF X_ext-classif.uniq-key-rec = "":U THEN DO:
     5064         ASSIGN
     5065           iFGColor = WHITE_COLOR
     5066           iBGColor = RED_COLOR
     5067         .
     5068       end.
     5069       ELSE do:
     5070         ASSIGN
     5071           iFGColor = Black_COLOR
     5072           iBGColor = White_COLOR
     5073         .
     5074       end.
     5075       ASSIGN
     5076        X_ext-classif.charkey_three:FGCOLOR  in BROWSE br-clients = iFGColor
     5077        X_ext-classif.charkey_three:BGCOLOR  in BROWSE br-clients = iBGColor
     5078       .
     5079   END PROCEDURE.
     5080   FUNCTION get-cli-name RETURNS CHARACTER
     5081     ( INPUT p-uniq-key-rec AS character ) :
     5082   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     5083   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     5084   DEFINE BUFFER buf_clients FOR ub.clients.
     5085   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     5086                                       ,input ?
     5087                                       ,INPUT "ub"
     5088                                       ,INPUT ?
     5089                                       ,INPUT NO-LOCK
     5090                                       ,OUTPUT v-rowid
     5091                                       ,OUTPUT v-tbl-name) no-error.
     5092   if error-status :error then do:
     5093     message
     5094       vss-workfile vss-revision vss-description skip
     5095       error-status :get-message(1)
     5096       error-status :get-message(2)
     5097     view-as alert-box error.
     5098     undo, return error.
     5099   end.
     5100   IF v-rowid = ? THEN RETURN 'НЕИЗВЕСТНЫЙ КЛИЕНТ'.
     5101   FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     5102   RETURN buf_clients.obj-name.
     5103   END FUNCTION.
