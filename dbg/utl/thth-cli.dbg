     3667       else do:
     3668         assign
     3669           b-sch :tooltip = ""
     3670         .
     3671       end.
     3672     end.
     3673   end procedure.
     3674   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3675   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3676     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3677     return no-apply.
     3678   end.
     3679   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3680   on INS of frame Dialog-Frame anywhere do:
