     1624   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1625   procedure thth150-db-attr-code :
     1626     do
     1627     on error undo, return error
     1628     :
     1629       define input  parameter p-code           as character no-undo .
     1630       define output parameter p-type           as character no-undo .
     1631       define output parameter p-format         as character no-undo .
     1632       define output parameter p-label          as character no-undo .
     1633       define output parameter p-user-can-edit  as logical   no-undo .
     1634       define output parameter p-output-display as logical   no-undo .
     1635       define output parameter p-other          as character no-undo .
     1636       case p-code :
     1637               when 'thth150-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1638               when 'thth150-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1639               when 'thth150-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1640               when 'thth150-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1641               when 'thth150-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1642               when 'thth150-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1643               when 'thth150-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1644               when 'thth150-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1645               when 'thth150-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1646               when 'thth150-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1647         otherwise do:
     1648           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     1649         end.
     1650       end.
     1651     end.
     1652   end procedure.
     1653   procedure thth150-db-attr-tooltip :
     1654     do
     1655     on error undo, return error
     1656     :
     1657       define input  parameter p-code    as character no-undo .
     1658       define output parameter p-tooltip as character no-undo .
     1659       define output parameter p-label   as character no-undo .
     1660       case p-code :
     1661               when 'thth150-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
     1662               when 'thth150-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
     1663               when 'thth150-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
     1664               when 'thth150-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
     1665               when 'thth150-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
     1666               when 'thth150-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
     1667               when 'thth150-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
     1668               when 'thth150-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
     1669               when 'thth150-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
     1670               when 'thth150-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
     1671         otherwise do:
     1672           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     1673         end.
     1674       end.
     1675     end.
     1676   end procedure.
     1677   procedure thth150-db-attr-value :
     1678     do
     1679     on error undo, return error
     1680     :
     1681       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     1682       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     1683       define output parameter p-value     like ub.db-attr.attr-value no-undo .
     1684       define output parameter p-type      as character no-undo .
     1685       define buffer buf_db-attr for ub.db-attr .
     1686       define variable v-format         as character no-undo .
     1687       define variable v-label          as character no-undo .
     1688       define variable v-user-can-edit  as logical   no-undo .
     1689       define variable v-output-display as logical   no-undo .
     1690       define variable v-other          as character no-undo .
     1691       run thth150-db-attr-code in this-procedure
     1692         (input  p-code
     1693         ,output p-type
     1694         ,output v-format
     1695         ,output v-label
     1696         ,output v-user-can-edit
     1697         ,output v-output-display
     1698         ,output v-other
     1699         ) no-error .
     1700       if error-status :error then do:
     1701         undo, return error return-value .
     1702       end.
     1703       find first buf_db-attr no-lock
     1704         where buf_db-attr.db-num    = p-db-num
     1705           and buf_db-attr.attr-code = p-code
     1706         no-error .
     1707       if avail buf_db-attr then do:
     1708         assign
     1709           p-value =  buf_db-attr.attr-value
     1710         .
     1711       end.
     1712       else do:
     1713         assign
     1714           p-value = if p-type = 'L':U then "no":U else ""
     1715         .
     1716       end.
     1717     end.
     1718   end procedure.
     1719   procedure thth150-db-attr-write :
     1720     do
     1721     on error undo, return error
     1722     :
     1723       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     1724       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     1725       define input parameter p-value     like ub.db-attr.attr-value no-undo .
     1726       define buffer buf_db-attr for ub.db-attr .
     1727       define variable v-type           as character no-undo .
     1728       define variable v-format         as character no-undo .
     1729       define variable v-label          as character no-undo .
     1730       define variable v-user-can-edit  as logical   no-undo .
     1731       define variable v-output-display as logical   no-undo .
     1732       define variable v-other          as character no-undo .
     1733       run thth150-db-attr-code in this-procedure
     1734         (input  p-code
     1735         ,output v-type
     1736         ,output v-format
     1737         ,output v-label
     1738         ,output v-user-can-edit
     1739         ,output v-output-display
     1740         ,output v-other
     1741         ) no-error .
     1742       if error-status :error then do:
     1743         undo, return error return-value .
     1744       end.
     1745       find first buf_db-attr exclusive-lock
     1746         where buf_db-attr.db-num    = p-db-num
     1747           and buf_db-attr.attr-code = p-code
     1748         no-error .
     1749       if not available buf_db-attr then do:
     1750         create buf_db-attr .
     1751         assign
     1752           buf_db-attr.db-num    = p-db-num
     1753           buf_db-attr.attr-code = p-code
     1754         .
     1755       end.
     1756       assign
     1757         buf_db-attr.attr-value = p-value
     1758       .
     1759     end.
     1760   end procedure.
     1761   procedure thth150-db-attr-exist :
     1762     do
     1763     on error undo, return error
     1764     :
     1765       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     1766       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     1767       define output parameter p-exist    as logical  no-undo .
     1768       define buffer buf_db-attr for ub.db-attr .
     1769       define variable v-type           as character no-undo .
     1770       define variable v-format         as character no-undo .
     1771       define variable v-label          as character no-undo .
     1772       define variable v-user-can-edit  as logical   no-undo .
     1773       define variable v-output-display as logical   no-undo .
     1774       define variable v-other          as character no-undo .
     1775       run thth150-db-attr-code in this-procedure
     1776         (input  p-code
     1777         ,output v-type
     1778         ,output v-format
     1779         ,output v-label
     1780         ,output v-user-can-edit
     1781         ,output v-output-display
     1782         ,output v-other
     1783         ) no-error .
     1784       if error-status :error then do:
     1785         undo, return error return-value .
     1786       end.
     1787       find first buf_db-attr no-lock
     1788         where buf_db-attr.db-num    = p-db-num
     1789           and buf_db-attr.attr-code = p-code
     1790         no-error .
     1791       if  available buf_db-attr then do:
     1792         p-exist = yes.
     1793       end.
     1794     end.
     1795   end procedure.
     1796   procedure thth150-db-attr-delete :
     1797     do
     1798     on error undo, return error
     1799     :
     1800       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
     1801       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     1802       define output parameter p-deleted  as logical no-undo.
     1803       define buffer buf_db-attr for ub.db-attr .
     1804       define variable v-type           as character no-undo .
     1805       define variable v-format         as character no-undo .
     1806       define variable v-label          as character no-undo .
     1807       define variable v-user-can-edit  as logical   no-undo .
     1808       define variable v-output-display as logical   no-undo .
     1809       define variable v-other          as character no-undo .
     1810       run thth150-db-attr-code in this-procedure
     1811         (input  p-code
     1812         ,output v-type
     1813         ,output v-format
     1814         ,output v-label
     1815         ,output v-user-can-edit
     1816         ,output v-output-display
     1817         ,output v-other
     1818         ) no-error .
     1819       if error-status :error then do:
     1820         undo, return error return-value .
     1821       end.
     1822       find first buf_db-attr exclusive-lock
     1823         where buf_db-attr.db-num    = p-db-num
     1824           and buf_db-attr.attr-code = p-code
     1825         no-error NO-WAIT.
     1826       if not available buf_db-attr then do:
     1827         p-deleted = no.
     1828       end.
     1829       else do:
     1830         delete buf_db-attr.
     1831         p-deleted = yes.
     1832       end.
     1833     end.
     1834   end procedure.
     1835   procedure thth150-db-attr-news :
     1836     do
     1837     on error undo, return error
     1838     :
     1839       define input  parameter p-code           as character no-undo .
     1840       define output parameter p-news           as logical   no-undo .
     1841       case p-code :
     1842               when 'thth150-cli-grp':U then do:     assign     p-news = no.   end.
     1843               when 'thth150-gds-grp':U then do:     assign     p-news = no.   end.
     1844               when 'thth150-clients':U then do:     assign     p-news = no.   end.
     1845               when 'thth150-goods':U then do:     assign     p-news = no.   end.
     1846               when 'thth150-dis-card':U then do:     assign     p-news = no.   end.
     1847               when 'thth150-qnty-dis-card':U then do:     assign     p-news = no.   end.
     1848               when 'thth150-shop':U then do:     assign     p-news = no.   end.
     1849               when 'thth150-contract':U then do:     assign     p-news = no.   end.
     1850               when 'thth150-price-doc':U then do:     assign     p-news = no.   end.
     1851               when 'thth150-trn-doc':U then do:     assign     p-news = no.   end.
     1852         otherwise do:
     1853           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     1854         end.
     1855       end.
     1856     end.
     1857   end procedure.
