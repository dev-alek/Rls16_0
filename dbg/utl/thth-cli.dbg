        1   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
        2   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   DEFINE INPUT PARAMETER bttns AS character NO-UNDO.
        4   define input parameter p-from-version as character no-undo .
        5   DEFINE INPUT PARAMETER p-list-mode AS character NO-UNDO.
        6   DEFINE INPUT-OUTPUT PARAMETER p-rid-list AS character NO-UNDO.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Соответствие клиентов в разных TH".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   define new global shared variable g#library  as handle no-undo .
      322   define new global shared variable g#library2 as handle no-undo .
      323   define   shared variable g#auto as logical no-undo.
      324   define   shared variable g#news as logical no-undo.
      325   define   shared variable g#oxml as logical no-undo.
      326   define   shared variable g#esys as logical no-undo.
      327   define   shared variable g#news-source-db as integer no-undo.
      328   define   shared variable g#esys-source-esys as integer no-undo.
      329   define   shared variable g#db-num as integer   no-undo .
      330   define   shared variable g#userid as character no-undo .
      331   define   shared variable g#passwd as character no-undo .
      332   procedure proc-alt-shift-f2:
      333     if not ibs.th.gbl.gbl-var:rcode
      334   then
      335     run gbl\inidebug.p .
      336   end.
      337   procedure proc-alt-shift-f3:
      338     run gbl/prvssinf.p
      339       ( input this-procedure
      340       ) .
      341   end.
      342   define variable v-inform-launched as logical no-undo initial false .
      343   procedure proc-alt-shift-f4:
      344     define variable v-action as character no-undo .
      345     if v-inform-launched = false then do:
      346       assign
      347         v-inform-launched = true
      348       .
      349       run gbl/d-inform.w
      350         (  input self
      351         ,  input this-procedure
      352         , output v-action
      353         ) no-error .
      354       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      355       assign
      356         v-inform-launched = false
      357       .
      358     end.
      359   end.
      360   procedure proc-alt-f1:
      361     run gbl/corrhelp.p
      362       (input this-procedure
      363       ) .
      364   end .
      365   on alt-shift-f2 anywhere do:
      366     run proc-alt-shift-f2.
      367   end.
      368   on alt-shift-f3 anywhere do:
      369     run proc-alt-shift-f3 in this-procedure .
      370   end.
      371   on alt-shift-f4 anywhere do:
      372     run proc-alt-shift-f4 in this-procedure.
      373   end.
      374   on alt-f1 anywhere do:
      375     run proc-alt-f1 in this-procedure .
      376   end.
      377   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378     define variable v-cntxt-db-num        as integer   no-undo .
      379     define variable v-cntxt-userid        as character no-undo .
      380     define variable v-cntxt-level         as character no-undo .
      381     define variable v-cntxt-host-code-obj as integer   no-undo .
      382     define variable v-cntxt-obj-type      as character no-undo .
      383     define variable v-cntxt-obj-code      as integer   no-undo .
      384     define variable v-cntxt-db-num-obj    as integer   no-undo .
      385     define variable v-cntxt-is-admin      as logical   no-undo .
      386   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   procedure gen-key-rec :
      388     define input  parameter p-tbl-name    as character no-undo.
      389     define input  parameter p-bh_tbl-name as handle    no-undo.
      390     define output parameter p-key-rec     as character no-undo.
      391     do
      392     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      393     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      394     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      395     :
      396       define variable fh               as handle    no-undo .
      397       define variable v-ok             as logical   no-undo .
      398       define variable v-inform         as character no-undo .
      399       define variable v-ind            as integer   no-undo .
      400       define variable v-idx-field-qnty as integer   no-undo .
      401       if p-tbl-name = ?
      402         or p-tbl-name = "":U
      403       then do:
      404         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      405       end.
      406       if not p-bh_tbl-name:available then do:
      407         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      408       end.
      409       assign
      410         p-key-rec = p-tbl-name
      411         v-inform  = p-bh_tbl-name:index-information(1)
      412         v-ind     = 2
      413       .
      414       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      415       on error undo, return error
      416       :
      417         assign
      418           v-inform = p-bh_tbl-name:index-information( v-ind )
      419           v-ind    = v-ind + 1
      420         .
      421       end.
      422       if v-inform = ?
      423         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      424         or entry( 3, v-inform, ",":U ) <> "1":U
      425       then do:
      426         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      427       end.
      428       else do:
      429         assign
      430           v-idx-field-qnty = num-entries( v-inform ) - 4
      431         .
      432         if v-idx-field-qnty < 2 then do:
      433           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      434         end.
      435         do v-ind = 1 to v-idx-field-qnty by 2
      436         on error undo, return error
      437         :
      438           assign
      439             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      440             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      441           .
      442         end.
      443       end.
      444       if p-key-rec = ? then do:
      445         assign
      446           p-key-rec = "":U
      447         .
      448         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      449       end.
      450     end.
      451     return.
      452   end procedure.
      453   procedure gen-where-keyr-tab :
      454     define input  parameter i-tableSerach as character no-undo.
      455     define input  parameter i-tablekey   as character  no-undo.
      456     define input  parameter p-key-rec    as character  no-undo.
      457     define input  parameter p-key-handle as handle     no-undo .
      458     define input  parameter p-db-name    as character  no-undo .
      459     define input  parameter p-tt-handle  as handle     no-undo .
      460     define output parameter o-Where      as character  no-undo.
      461     do
      462     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      463     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      464     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      465     :
      466       define variable v-full-tbl-name  as character no-undo .
      467       define variable bh_tbl-name      as handle    no-undo .
      468       define variable fh_key           as handle    no-undo .
      469       define variable fh_search        as handle    no-undo .
      470       define variable v-field-num      as integer   no-undo .
      471       define variable v-count-fld      as integer   no-undo .
      472       define variable v-inform         as character no-undo .
      473       define variable v-ind            as integer   no-undo .
      474       define variable v-idx-field-qnty as integer   no-undo .
      475       define variable v-field-name     as character no-undo .
      476       define variable v-field-val      as character no-undo .
      477       define variable v-word-link      as character no-undo .
      478       define variable vTable           as character no-undo.
      479       define variable bh_tbl-key       as handle    no-undo .
      480       assign
      481         p-key-rec = trim( p-key-rec )
      482       .
      483       if p-key-handle <> ? then do:
      484         if not valid-handle(p-key-handle)
      485            or p-key-handle:type <> "buffer"
      486         then do:
      487           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      488         end.
      489         if num-entries( p-key-rec, chr(3) ) > 1
      490           or p-key-rec = ?
      491           or p-key-rec = "":U
      492         then do:
      493           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      494         end.
      495       end.
      496       else do:
      497         if p-key-rec = ?
      498           or p-key-rec = "":U
      499         then do:
      500           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      501         end.
      502       end.
      503       assign
      504         vTable = entry( 1 , p-key-rec, chr(3) )
      505       .
      506       if p-tt-handle <> ?
      507         and ( not valid-handle(p-tt-handle)
      508               or p-tt-handle:type <> "buffer"
      509             )
      510       then do:
      511         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      512       end.
      513       if p-tt-handle = ? then do:
      514         assign
      515           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      516         .
      517         create buffer bh_tbl-name for table v-full-tbl-name .
      518       end.
      519       else do:
      520         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      521       end.
      522       assign
      523         v-inform = bh_tbl-name:index-information(1)
      524         v-ind    = 2
      525       .
      526       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      527       on error undo, return error
      528       :
      529         assign
      530           v-inform = bh_tbl-name:index-information( v-ind )
      531           v-ind    = v-ind + 1
      532         .
      533       end.
      534       if v-inform = ?
      535         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      536         or entry( 3, v-inform, ",":U ) <> "1":U
      537       then do:
      538         delete object bh_tbl-name no-error.
      539         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      540       end.
      541       assign
      542         v-idx-field-qnty = num-entries( v-inform ) - 4
      543       .
      544       if v-idx-field-qnty < 2 then do:
      545         delete object bh_tbl-name no-error.
      546         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      547       end.
      548       assign
      549         o-where     = "where":U
      550         v-word-link = "":U
      551         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      552         v-count-fld = 0
      553       .
      554       if i-tablekey ne "" and i-tablekey ne ?
      555       then do:
      556         assign
      557           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      558         .
      559         create buffer bh_tbl-key for table v-full-tbl-name .
      560       end.
      561       if i-tableSerach ne "" and i-tableSerach ne ?
      562       then do:
      563         delete object bh_tbl-name no-error.
      564         assign
      565           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      566         .
      567         create buffer bh_tbl-name for table v-full-tbl-name .
      568       end.
      569       block_where:
      570       do v-ind = 1 to v-idx-field-qnty by 2
      571       on error undo, return error
      572       :
      573         assign
      574           v-count-fld = v-count-fld + 1
      575         .
      576         if p-key-handle = ?
      577           and v-count-fld > v-field-num
      578         then do:
      579           leave block_where.
      580         end.
      581         define variable VfieldKeyTable as handle no-undo.
      582         assign
      583           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      584           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      585         .
      586         if     bh_tbl-key ne ?
      587         then do:
      588            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      589            if VfieldKeyTable eq ?
      590            then next block_where.
      591         end.
      592         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      593         then
      594            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      595         else
      596            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      597         if p-key-handle = ? then do:
      598           assign
      599             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      600           .
      601         end.
      602         else do:
      603           assign
      604             fh_key = p-key-handle:buffer-field( v-field-name )
      605           .
      606           if fh_key = ?
      607             or not valid-handle( fh_key )
      608           then do:
      609             delete object bh_tbl-name.
      610             if     bh_tbl-key ne ?
      611             then
      612                delete object bh_tbl-key.
      613             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      614           end.
      615           assign
      616             v-field-val = fh_key:buffer-value
      617           .
      618         end.
      619         if fh_search:data-type ="character":U then do:
      620           assign
      621             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      622             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      623             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      624             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      625             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      626             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      627             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      628             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      629             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      630             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      631             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      632             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      633             v-field-val = substitute( '"&1"', v-field-val )
      634           .
      635         end.
      636         assign
      637           o-where = substitute( "&1 &2", o-where, v-field-val )
      638         .
      639         if v-word-link = "":U then do:
      640           assign
      641             v-word-link = "and":U
      642           .
      643         end.
      644       end.
      645       delete object bh_tbl-name.
      646       if     bh_tbl-key ne ?
      647       then
      648          delete object bh_tbl-key.
      649       if p-key-handle = ?
      650         and v-count-fld <> v-field-num
      651       then do:
      652         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      653       end.
      654     end.
      655   end procedure.
      656   procedure gen-hn-keyr-tab :
      657     define input  parameter i-tableSerach as character no-undo.
      658     define input  parameter i-tablekey   as character no-undo.
      659     define input  parameter p-key-rec    as character no-undo.
      660     define input  parameter p-key-handle as handle    no-undo .
      661     define input  parameter p-db-name    as character no-undo .
      662     define input  parameter p-tt-handle  as handle    no-undo .
      663     define input  parameter p-stts-lock  as integer   no-undo .
      664     define output parameter o-hn         as handle    no-undo.
      665     define variable v-full-tbl-name as character no-undo.
      666     define variable v-where         as character no-undo.
      667     define variable bh_tbl-name     as handle    no-undo.
      668     define variable vTable          as character no-undo.
      669     do
      670     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      671     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      672     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      673         run gen-where-keyr-tab(i-tableSerach,
      674                                i-tablekey,
      675                                p-key-rec,
      676                                p-key-handle,
      677                                p-db-name,
      678                                p-tt-handle,
      679                                output v-where).
      680         if i-tableSerach ne "" and i-tableSerach ne ?
      681         then do:
      682            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      683            create buffer bh_tbl-name for table v-full-tbl-name .
      684         end.
      685         else do:
      686            if p-tt-handle = ? then do:
      687               assign
      688                  vTable = entry( 1 , p-key-rec, chr(3) )
      689               .
      690               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      691               create buffer bh_tbl-name for table v-full-tbl-name .
      692            end.
      693            else do:
      694               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      695            end.
      696         end.
      697         if p-tt-handle = ? then do:
      698            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      699         end.
      700         else do:
      701            bh_tbl-name:find-first( v-where ) no-error .
      702         end.
      703         o-hn = bh_tbl-name.
      704      end.
      705   end procedure.
      706   procedure gen-hn-keyr :
      707     define input  parameter p-key-rec    as character no-undo.
      708     define input  parameter p-key-handle as handle    no-undo .
      709     define input  parameter p-db-name    as character no-undo .
      710     define input  parameter p-tt-handle  as handle    no-undo .
      711     define input  parameter p-stts-lock  as integer   no-undo .
      712     define output parameter o-hn         as handle    no-undo.
      713     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      714   end.
      715   procedure gen-row-keyr :
      716     define input  parameter p-key-rec    as character no-undo.
      717     define input  parameter p-key-handle as handle    no-undo .
      718     define input  parameter p-db-name    as character no-undo .
      719     define input  parameter p-tt-handle  as handle    no-undo .
      720     define input  parameter p-stts-lock  as integer   no-undo .
      721     define output parameter p-tbl-row    as rowid     no-undo.
      722     define output parameter p-tbl-name   as character no-undo.
      723     define variable vHn as handle no-undo.
      724       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      725       p-tbl-row = if vHn:available then vHn:rowid else ?.
      726       p-tbl-name =  vHn:table.
      727       delete object vHn no-error.
      728     if p-tbl-row = ? then do:
      729       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      730     end.
      731     else do:
      732       return.
      733     end.
      734   end procedure.
      735   procedure gen-key-fv :
      736     define input  parameter p-key-rec    as character no-undo .
      737     define output parameter p-field-list as character no-undo .
      738     define output parameter p-value-list as character no-undo.
      739     do
      740     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      741     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      742     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      743     :
      744       define variable v-full-tbl-name  as character no-undo .
      745       define variable bh_tbl-name      as handle    no-undo .
      746       define variable v-tbl-name       as character no-undo .
      747       define variable v-field-num      as integer   no-undo .
      748       define variable v-count-fld      as integer   no-undo .
      749       define variable v-inform         as character no-undo .
      750       define variable v-ind            as integer   no-undo .
      751       define variable v-idx-field-qnty as integer   no-undo .
      752       define variable v-delim-key      as character no-undo .
      753       if p-key-rec = ?
      754         or p-key-rec = "":U
      755       then do:
      756         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      757       end.
      758       assign
      759         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      760         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      761       .
      762       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      763       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      764       assign
      765         v-inform = bh_tbl-name:index-information(1)
      766         v-ind    = 2
      767       .
      768       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      769       on error undo, return error
      770       :
      771         assign
      772           v-inform = bh_tbl-name:index-information( v-ind )
      773           v-ind    = v-ind + 1
      774         .
      775       end.
      776       if v-inform = ?
      777         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      778         or entry( 3, v-inform, ",":U ) <> "1":U
      779       then do:
      780         delete object bh_tbl-name no-error.
      781         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      782       end.
      783       assign
      784         v-idx-field-qnty = num-entries( v-inform ) - 4
      785       .
      786       if v-idx-field-qnty < 2 then do:
      787         delete object bh_tbl-name no-error.
      788         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      789       end.
      790       assign
      791         p-field-list = "":U
      792         p-value-list = "":U
      793         v-delim-key  = "":U
      794         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      795         v-count-fld  = 0
      796       .
      797       block_where:
      798       do v-ind = 1 to v-idx-field-qnty by 2
      799       on error undo, return error
      800       :
      801         assign
      802           v-count-fld = v-count-fld + 1
      803         .
      804         if v-count-fld > v-field-num then do:
      805           leave block_where.
      806         end.
      807         assign
      808           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      809           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      810         .
      811         if v-ind = 1 then do:
      812           assign
      813             v-delim-key = chr(3)
      814           .
      815         end.
      816       end.
      817       delete object bh_tbl-name.
      818       if v-count-fld <> v-field-num then do:
      819         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      820       end.
      821     end.
      822   end procedure.
      823   procedure gen-key-field :
      824     define input  parameter p-table      as character no-undo .
      825     define output parameter p-field-list as character no-undo .
      826     do
      827     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      828     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      829     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      830     :
      831       define variable v-full-tbl-name  as character no-undo .
      832       define variable bh_tbl-name      as handle    no-undo .
      833       define variable v-tbl-name       as character no-undo .
      834       define variable v-field-num      as integer   no-undo .
      835       define variable v-count-fld      as integer   no-undo .
      836       define variable v-inform         as character no-undo .
      837       define variable v-ind            as integer   no-undo .
      838       define variable v-idx-field-qnty as integer   no-undo .
      839       define variable v-delim-key      as character no-undo .
      840       if p-table = ?
      841         or p-table = "":U
      842       then do:
      843         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      844       end.
      845       assign
      846         v-tbl-name      = p-table
      847         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      848       .
      849       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      850       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      851       assign
      852         v-inform = bh_tbl-name:index-information(1)
      853         v-ind    = 2
      854       .
      855       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      856       on error undo, return error
      857       :
      858         assign
      859           v-inform = bh_tbl-name:index-information( v-ind )
      860           v-ind    = v-ind + 1
      861         .
      862       end.
      863       if v-inform = ?
      864         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      865         or entry( 3, v-inform, ",":U ) <> "1":U
      866       then do:
      867         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      868       end.
      869       assign
      870         v-idx-field-qnty = num-entries( v-inform ) - 4
      871       .
      872       if v-idx-field-qnty < 2 then do:
      873         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      874       end.
      875       assign
      876         p-field-list = "":U
      877         v-delim-key  = "":U
      878         v-count-fld  = 0
      879       .
      880       block_where:
      881       do v-ind = 1 to v-idx-field-qnty by 2
      882       on error undo, return error
      883       :
      884         assign
      885           v-count-fld = v-count-fld + 1
      886         .
      887         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      888         if v-ind = 1 then do:
      889           assign
      890             v-delim-key = chr(3)
      891           .
      892         end.
      893       end.
      894       delete object bh_tbl-name.
      895     end.
      896   end procedure.
      897   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   define variable c-point  as character no-undo .
      899   define variable tbl      as character no-undo .
      900   define variable join-tbl as character no-undo .
      901   define variable fld      as character no-undo .
      902   define variable lab      as character no-undo .
      903   define variable spr      as character no-undo .
      904   define variable dim      as character no-undo .
      905   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      906   procedure fltfield-clear :
      907     define output parameter loc-fld as character no-undo.
      908     define output parameter loc-lab as character no-undo .
      909     define output parameter loc-spr as character no-undo .
      910     define output parameter loc-dim as character no-undo .
      911     assign
      912       loc-fld = ""
      913       loc-lab = ""
      914       loc-spr = ""
      915       loc-dim = "0"
      916     .
      917   end procedure .
      918   procedure fltfield-add :
      919     define input        parameter par-fld as character no-undo.
      920     define input        parameter par-lab as character no-undo .
      921     define input        parameter par-spr as character no-undo .
      922     define input-output parameter loc-fld as character no-undo.
      923     define input-output parameter loc-lab as character no-undo .
      924     define input-output parameter loc-spr as character no-undo .
      925     define input-output parameter loc-dim as character no-undo .
      926     do
      927     on error undo, return error
      928     :
      929       assign
      930       loc-fld = if loc-dim = '0'
      931                 then par-fld
      932                 else (loc-fld + chr(44) + par-fld)
      933       loc-lab = if loc-dim = '0'
      934                 then par-lab
      935                 else (loc-lab + chr(44) + par-lab)
      936       loc-spr = if loc-dim = '0'
      937                 then par-spr
      938                 else (loc-spr + chr(44) + par-spr)
      939       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      940                 string(integer(if num-entries(loc-dim) > 1
      941                               then entry(2, loc-dim)
      942                               else entry(1, loc-dim)
      943                               ) + 1)
      944       no-error
      945       .
      946     end.
      947   end procedure.
      948   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   FUNCTION mark-string RETURNS CHARACTER
      950     ( input p-recid as recid, input mark-list as character  ) :
      951     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      952   END FUNCTION.
      953   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      954   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   procedure cur-time :
      956      define output parameter p-today as date      no-undo .
      957      define output parameter p-time  as integer   no-undo .
      958     do
      959     on error undo, return error
      960     :
      961       define variable v-date1 as date      no-undo .
      962       define variable v-date2 as date      no-undo .
      963       define variable v-time  as integer   no-undo .
      964       assign
      965         v-date1 = today
      966         v-time  = time
      967         v-date2 = today
      968       .
      969       if v-date1 <> v-date2
      970       then do:
      971         assign
      972           v-date1 = today
      973           v-time  = v-time
      974         .
      975       end.
      976       assign
      977         p-today = v-date1
      978         p-time  = v-time
      979       .
      980     end.
      981   end.
      982   function cur-time-date returns character
      983   :
      984     return string(today, '99/99/9999':U) .
      985   end.
      986   function cur-time-mjd returns decimal
      987   :
      988     define variable v-date as date      no-undo .
      989     define variable v-time as integer   no-undo .
      990     run cur-time in this-procedure
      991       (output v-date
      992       ,output v-time
      993       ) .
      994     return integer(v-date) - 2400002 + (v-time / 86400) .
      995   end.
      996   function cur-time-get-ending-index returns integer
      997   (input p-number as integer
      998   )
      999   :
     1000     if p-number < 0
     1001     or p-number = ?
     1002     then do:
     1003       return 1 .
     1004     end.
     1005     define variable v-rest as integer   no-undo .
     1006     assign
     1007       p-number = p-number modulo 100
     1008     .
     1009     if p-number < 20
     1010     then do:
     1011       assign
     1012         v-rest = p-number
     1013       .
     1014     end.
     1015     else do:
     1016       assign
     1017         v-rest = p-number modulo 10
     1018       .
     1019     end.
     1020     case v-rest :
     1021       when 1
     1022       then do:
     1023         return 2 .
     1024       end.
     1025       when 2 or
     1026       when 3 or
     1027       when 4
     1028       then do:
     1029         return 3 .
     1030       end.
     1031       otherwise do:
     1032         return 1 .
     1033       end.
     1034     end case .
     1035   end.
     1036   procedure cur-time-mjd-to-date :
     1037      define input  parameter i-mjd-diff as decimal no-undo.
     1038      define output parameter o-Date     as date    no-undo.
     1039      define output parameter o-Time     as integer no-undo.
     1040      define variable v-day-number as integer   no-undo .
     1041      if    i-mjd-diff < 0
     1042         or i-mjd-diff = ?
     1043      then do:
     1044         return "?" .
     1045      end.
     1046      assign
     1047         v-day-number = truncate(i-mjd-diff,0).
     1048         o-Date = date(v-day-number + 2400002).
     1049         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1050     .
     1051   end.
     1052   function cur-time-mjd-to-string returns character
     1053   (input p-mjd-diff as decimal
     1054   )
     1055   :
     1056     define variable v-day-number as integer   no-undo .
     1057     define variable v-seconds    as integer   no-undo .
     1058     define variable v-hour       as integer   no-undo .
     1059     define variable v-min        as integer   no-undo .
     1060     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1061     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1062     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1063     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1064     if p-mjd-diff < 0
     1065     or p-mjd-diff = ?
     1066     then do:
     1067       return "?" .
     1068     end.
     1069     assign
     1070       v-day-number = integer(truncate(p-mjd-diff,0))
     1071       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1072     .
     1073     if v-seconds > 86400
     1074     then do:
     1075       assign
     1076         v-seconds = 86400 - 1
     1077       .
     1078     end.
     1079     if v-seconds < 0
     1080     then do:
     1081       assign
     1082         v-seconds = 0
     1083       .
     1084     end.
     1085     assign
     1086       v-hour = truncate(v-seconds / 3600, 0)
     1087     .
     1088     assign
     1089       v-seconds = v-seconds modulo 3600
     1090     .
     1091     assign
     1092       v-min = truncate(v-seconds / 60, 0)
     1093     .
     1094     assign
     1095       v-seconds = v-seconds modulo 60
     1096     .
     1097     return
     1098         (if v-day-number <> 0
     1099           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1100           else ""
     1101         )
     1102       + (if v-day-number <> 0 or v-hour <> 0
     1103           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1104           else ""
     1105         )
     1106       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1107           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1108           else ""
     1109         )
     1110       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1111       .
     1112   end.
     1113   function cur-time-string returns character
     1114   :
     1115     define variable v-date as date      no-undo .
     1116     define variable v-time as integer   no-undo .
     1117     run cur-time in this-procedure
     1118       (output v-date
     1119       ,output v-time
     1120       ) .
     1121     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1122   end.
     1123   function cur-time-string-sec returns character
     1124   :
     1125     define variable v-date as date      no-undo .
     1126     define variable v-time as integer   no-undo .
     1127     run cur-time in this-procedure
     1128       (output v-date
     1129       ,output v-time
     1130       ) .
     1131     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1132   end.
     1133   function cur-time-custom  returns character
     1134   (input p-prefix as character
     1135   ,input p-date-format as character
     1136   ,input p-delimiter as character
     1137   ,input p-time-format as character
     1138   ,input p-suffix as character
     1139   )
     1140   :
     1141     define variable v-date as date      no-undo .
     1142     define variable v-time as integer   no-undo .
     1143     run cur-time in this-procedure
     1144       (output v-date
     1145       ,output v-time
     1146       ) .
     1147     return
     1148       p-prefix
     1149       + string(v-date, p-date-format)
     1150       + p-delimiter
     1151       + string(v-time, p-time-format)
     1152       + p-suffix
     1153       .
     1154   end.
     1155   function cur-time-print  returns character
     1156   :
     1157     define variable v-date as date      no-undo .
     1158     define variable v-time as integer   no-undo .
     1159     run cur-time in this-procedure
     1160       (output v-date
     1161       ,output v-time
     1162       ) .
     1163     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1164   end.
     1165   function cur-time-datetime returns datetime
     1166   :
     1167     define variable v-char as character no-undo .
     1168     define variable v-datetime as datetime no-undo .
     1169     v-char = cur-time-string().
     1170     v-datetime = datetime(v-char).
     1171     return  v-datetime.
     1172   end.
     1173   function cur-time-string-msec returns character
     1174   :
     1175     define variable v-date as datetime  no-undo .
     1176     v-date = now.
     1177     return string(v-date) .
     1178   end.
     1179   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1181   define  shared variable RepPathName        as character no-undo .
     1182   define  shared variable PrintRubl          as logical   no-undo .
     1183   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   define  stream PrnLibStream.
     1185   procedure prn-lib-prn-file :
     1186     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1187     define input parameter p-DIsabledoptions as integer no-undo .
     1188     define variable v-report-name as character no-undo .
     1189     define variable v-user-action as character no-undo .
     1190     define variable v-printed     as logical   no-undo .
     1191     define variable v-exist       as logical   no-undo .
     1192     do
     1193       on error undo, return error
     1194       :
     1195       run prn-lib-get-report-name  in this-procedure (
     1196         input parParentProc
     1197         ,output v-report-name
     1198         ).
     1199   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1201     (input  v-report-name
     1202     ,input  2
     1203     ,output v-exist
     1204     )  .
     1205       if NOT v-exist then
     1206       DO:
     1207         Message
     1208           "Нет заданий на печать ! "
     1209           view-as alert-box .
     1210         Return  .
     1211       End.
     1212       run gbl/prnfilen.w
     1213         (input  ""
     1214         ,input  p-DisabledOptions
     1215         ,input  string(v-report-name )
     1216         ,input  7
     1217         ,output v-user-action
     1218         ,output v-printed
     1219         ) .
     1220       if v-printed then
     1221       do:
     1222         return "YES" .
     1223       end.
     1224       else
     1225       do:
     1226         return "NO" .
     1227       end.
     1228     end.
     1229   end procedure.
     1230   procedure prn-lib-open-stream :
     1231     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1232     define input parameter p-page-size    as integer no-undo .
     1233     define input parameter p-is-stream    as logical no-undo .
     1234     define input parameter p-append       as logical no-undo .
     1235     define variable v-report-name as character no-undo .
     1236     do
     1237       on error undo, return error
     1238       :
     1239       run prn-lib-get-report-name  in this-procedure (
     1240         input parParentProc
     1241         ,output v-report-name
     1242         ).
     1243       if p-is-stream then
     1244       do:
     1245         if p-append then
     1246         do:
     1247           output stream PrnLibStream to value( v-report-name )
     1248             page-size value(p-page-size) append .
     1249         end.
     1250         if not p-append then
     1251         do:
     1252           output stream PrnLibStream to value( v-report-name )
     1253             page-size value(p-page-size) .
     1254         end.
     1255       end.
     1256       if not p-is-stream then
     1257       do:
     1258         if p-append then
     1259         do:
     1260           output to value( v-report-name )
     1261             page-size value(p-page-size) append .
     1262         end.
     1263         if not p-append then
     1264         do:
     1265           output to value( v-report-name )
     1266             page-size value(p-page-size) .
     1267         end.
     1268       end.
     1269     end.
     1270   end procedure.
     1271   procedure prn-lib-open-exp :
     1272     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1273     define input parameter p-is-stream    as logical no-undo .
     1274     define input parameter p-is-append    as logical no-undo .
     1275     define output parameter p-ReportFileName as char init "report" no-undo.
     1276     define output parameter p-process as logical no-undo .
     1277     define variable glog as logical no-undo .
     1278     do
     1279       on error undo, return error
     1280       :
     1281       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1282         TITLE      "Укажите путь"
     1283         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1284         ASK-OVERWRITE
     1285         CREATE-TEST-FILE
     1286         SAVE-AS
     1287         USE-FILENAME
     1288         DEFAULT-EXTENSION "txt"
     1289         UPDATE glog
     1290         .
     1291       if not glog then  return.
     1292       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1293       if p-is-stream then
     1294       do:
     1295         if p-is-append then
     1296         do:
     1297           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1298         end.
     1299         else
     1300         do:
     1301           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1302         end.
     1303       end.
     1304       else
     1305       do:
     1306         if p-is-append then
     1307         do:
     1308           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1309         end.
     1310         else
     1311         do:
     1312           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1313         end.
     1314       end.
     1315       p-process = yes.
     1316     end.
     1317   end procedure.
     1318   procedure prn-lib-get-report-name :
     1319     define input parameter parParentProc  as widget-handle no-undo.
     1320     define output parameter p-report-name as character no-undo .
     1321     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1322   end procedure.
     1323   procedure prn-lib-reportviewer-report-name :
     1324     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1325     define input parameter p-report-name-html as character no-undo .
     1326     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
