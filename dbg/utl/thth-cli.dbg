     3687     return no-apply.
     3688   end.
     3689   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3690   on F2 of frame Dialog-Frame anywhere do:
     3691     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3692     return no-apply.
     3693   end.
     3694   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3695   on f5 of frame Dialog-Frame anywhere
     3696   do:
     3697     if available X_ext-classif then v-doc-rec = recid(X_ext-classif). run openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U) no-error. reposition br-clients to recid(v-doc-rec) no-error. APPLy 'ENTRY' to br-clients .
     3698       apply "VALUE-CHANGED" to br-clients.
     3699   end.
     3700   ON ROW-DISPLAY OF br-clients IN frame Dialog-Frame
     3701   DO:
     3702     IF AVAIL X_ext-classif THEN DO:
     3703       RUN set-row-color.
     3704     END.
     3705   END.
     3706   MAIN-BLOCK:
     3707   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3708      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3709   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3710     run mainmenu_getcntxt in parparentproc
     3711       (output v-cntxt-db-num
     3712       ,output v-cntxt-userid
     3713       ,output v-cntxt-level
     3714       ,output v-cntxt-host-code-obj
     3715       ,output v-cntxt-obj-type
     3716       ,output v-cntxt-obj-code
     3717       ,output v-cntxt-db-num-obj
     3718       ,output v-cntxt-is-admin
     3719       ) .
     3720     v-rid-list = p-rid-list.
     3721     case p-from-version:
     3722       when 'v15_0000':U then do:
     3723         v-cli-classif-name = 'th-th150_clients':U.
     3724         if p-list-mode = 'объект':U then do:
     3725           v-attr-code = 'thth150-shop':U.
     3726         end.
     3727         else do:
     3728           v-attr-code = 'thth150-clients':U.
     3729         end.
     3730         run thth150-db-attr-value in this-procedure ( input g#db-num
     3731                                                   ,input v-attr-code
     3732                                                   ,output v-closed
     3733                                                   ,output v-type) .
     3734       end.
     3735       when 'v14_0':U then do:
     3736         v-cli-classif-name = 'th-th14_clients':U.
     3737         if p-list-mode = 'объект':U then do:
     3738           v-attr-code = 'thth14-shop':U.
     3739         end.
     3740         else do:
     3741           v-attr-code = 'thth14-clients':U.
     3742         end.
     3743         run thth14-db-attr-value in this-procedure ( input g#db-num
     3744                                                   ,input v-attr-code
     3745                                                   ,output v-closed
     3746                                                   ,output v-type) .
     3747       end.
     3748       otherwise do:
     3749         message
     3750         substitute("Неверное значение параметра p-from-version=&1", p-from-version)
     3751         view-as alert-box error .
     3752         undo main-block, return error .
     3753       end.
     3754     end case.
     3755     RUN Myenable.
     3756     WAIT-FOR GO OF FRAME Dialog-Frame.
     3757   END.
     3758   RUN disable_UI.
     3759   PROCEDURE disable_UI :
     3760     HIDE FRAME Dialog-Frame.
     3761   END PROCEDURE.
     3762   PROCEDURE enable_UI :
     3763     DISPLAY rs-key#_three sch-old-code rs-cli-type sch-self-code f-cli-name
     3764             mark-num
     3765         WITH FRAME Dialog-Frame.
     3766     ENABLE b-quit B-mark B-sel b-tie b-copy b-imp b-close b-sch b-print B-Help
     3767            rs-key#_three b-imp-gds sch-old-code rs-cli-type sch-self-code
     3768            br-clients f-cli-name mark-num
     3769         WITH FRAME Dialog-Frame.
     3770     VIEW FRAME Dialog-Frame.
     3771     OPEN QUERY br-clients FOR EACH X_ext-classif NO-LOCK OUTER-JOIN INDEXED-REPOSITION.
     3772   END PROCEDURE.
     3773   PROCEDURE MyEnable :
     3774   define variable v-cli-type-code-h as handle no-undo .
     3775   v-cli-type-code-h = br-clients:FIRST-COLUMN IN FRAME Dialog-Frame.
     3776   DO while valid-handle(v-cli-type-code-h) :
     3777     if v-cli-type-code-h:LABEL = "КЛИЕНТ!" then do:
     3778       leave.
     3779     end.
     3780     ELSE DO:
     3781       v-cli-type-code-h = v-cli-type-code-h:NEXT-COLUMN.
     3782     END.
     3783   END.
     3784   assign
     3785   b-copy:label in frame Dialog-Frame = substitute("&1 &2"
     3786                                                     , b-copy:label in frame Dialog-Frame
     3787                                                     , p-from-version)
     3788   b-imp:tooltip in frame Dialog-Frame = substitute("&1 &2"
     3789                                                     , b-imp:tooltip in frame Dialog-Frame
     3790                                                     , p-from-version)
     3791   b-imp-gds:tooltip in frame Dialog-Frame = substitute("&1 &2"
     3792                                                     , b-imp-gds:tooltip in frame Dialog-Frame
     3793                                                     , p-from-version)
     3794   sch-old-code:label in frame Dialog-Frame = substitute("&1 &2"
     3795                                                     , sch-old-code:label in frame Dialog-Frame
     3796                                                     , p-from-version)
     3797   X_ext-classif.charkey_three:LABEL  in browse br-clients = substitute("&1 &2"
     3798                                                               , X_ext-classif.charKEY_three:LABEL  in browse br-clients
     3799                                                               ,p-from-version)
     3800   v-cli-type-code-h:label  = substitute("&1 &2"
     3801                                       , v-cli-type-code-h:label
     3802                                       , p-from-version)
     3803   .
     3804   assign
     3805   b-copy:menu-mouse in frame Dialog-Frame = 1
     3806   X_ext-classif.charkey_two:visible in browse br-clients = (p-list-mode <> 'объект':U)
     3807   X_ext-classif.charkey_three:resizable in browse br-clients = yes
     3808   rs-key#_three = 0
     3809   .
     3810   if p-list-mode = 'объект':U then do:
     3811     b-imp:label in frame Dialog-Frame = "Получение данных".
     3812   end.
     3813   rs-cli-type:radio-buttons in frame Dialog-Frame = 'орг':U + chr(44) + 'орг':U + chr(44) +
     3814                                                      'чел':U + chr(44) + 'чел':U.
     3815   rs-cli-type = 'орг':U.
     3816   display
     3817   rs-key#_three
     3818   rs-cli-type
     3819   with frame Dialog-Frame .
     3820   ENABLE
     3821   b-mark
     3822   b-quit
     3823   b-print
     3824   b-imp when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction and logical(v-closed) = no)
     3825   b-imp-gds when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction and logical(v-closed) = no
     3826                   AND p-list-mode <> 'объект':U)
     3827   b-tie when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction and logical(v-closed) = no)
     3828   b-copy when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction and p-list-mode <> 'объект':U and logical(v-closed) = no)
     3829   b-sch
     3830   B-Help
     3831   b-close when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction and logical(v-closed) = no)
     3832   br-clients
     3833   rs-cli-type
     3834   rs-key#_three
     3835   sch-old-code
     3836   sch-self-code
     3837   b-sel  when lookup("b-sel", bttns) > 0
     3838   WITH FRAME Dialog-Frame.
     3839   VIEW FRAME Dialog-Frame.
     3840   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3841   APPLy "entry" to br-clients.
     3842   apply "value-changed" to br-clients.
     3843   END PROCEDURE.
     3844   PROCEDURE OpenBr :
     3845   define input  parameter p-open-query     as logical   no-undo .
     3846   define input  parameter p-find-next      as logical   no-undo .
     3847   define input  parameter p-find-condition as character no-undo .
     3848   define variable sort-column-phrase as character no-undo .
     3849   define variable l-query-was-opened as logical no-undo .
     3850   define variable title0 as character no-undo .
     3851   case sort-column-name :
     3852     when "" then do:
     3853       assign
     3854         sort-column-phrase = ""
     3855       .
     3856     end.
     3857     otherwise do:
     3858       assign
     3859         sort-column-phrase = "by " + sort-column-name
     3860       .
     3861     end.
     3862   end case.
     3863   filter-point = filter-point0 + p-list-mode .
     3864   case p-list-mode:
     3865     when '' then do:
     3866        title0 = "Соответствие клиентов в разных системах TH".
     3867       ASSIGN
     3868       frame Dialog-Frame:title = substitute("&1", title0)
     3869       filter-label = SUBSTITUTE("&1"
     3870                                 , frame Dialog-Frame:title
     3871                                 )
     3872       .
     3873   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3874   define variable  l-disable-where-30  as logical   no-undo .
     3875   define variable  l-filter-open-30    as logical   .
     3876   define variable  flt-rec-30       as recid     no-undo .
     3877   define variable  filter-name-30      as character no-undo .
     3878   define variable  where-phrase-30     as character no-undo .
     3879   define variable  sort-phrase-30      as character no-undo .
     3880   define variable  where-phrase-rus-30 as character no-undo .
     3881   define variable  sort-phrase-rus-30  as character no-undo .
     3882     run waitfram-show in this-procedure
     3883       (input "ЖДИТЕ ..."
     3884       ).
     3885   run gbl/flt-get.p
     3886     (input filter-point
     3887     ,output flt-rec-30
     3888     ,output filter-name-30
     3889     ,output where-phrase-30
     3890     ,output sort-phrase-30
     3891     ,output where-phrase-rus-30
     3892     ,output sort-phrase-rus-30
     3893     ).
     3894   if p-open-query then do:
     3895       run set-filter-name in this-procedure
     3896         (INPUT filter-name-30
     3897         ) no-error .
     3898     assign
     3899       l-filter-open-30 = false
     3900     .
     3901     if flt-rec-30 <> ?
     3902       or sort-column-phrase > ""
     3903     then do:
     3904       define variable  parameter-2-30 as character no-undo .
     3905       define variable  parameter-3-30 as character no-undo .
     3906       define variable  parameter-4-30 as character no-undo .
     3907       define variable  parameter-5-30 as character no-undo .
     3908       define variable  parameter-6-30 as character no-undo .
     3909       define variable  parameter-7-30 as character no-undo .
     3910         assign
     3911         parameter-3-30 =
     3912                                 "FOR EACH X_ext-classif no-lock"
     3913         parameter-4-30 =
     3914           (
     3915             if (" X_ext-classif.classif-subject = 'clients':U                             and X_ext-classif.classif-name = v-cli-classif-name                             AND X_ext-classif.db-num = - 1                             and (rs-key#_three = -1  or X_ext-classif.key#_three = rs-key#_three)                             AND (X_ext-classif.charkey_One = 'орг':U or X_ext-classif.charkey_One = 'чел':U) " + " " + where-phrase-30) <> ""
     3916             then  substitute('X_ext-classif.classif-subject = &1&2&1                             and X_ext-classif.classif-name = &1&3&1                             and (&6 = -1  or X_ext-classif.key#_three = &6)                             AND X_ext-classif.db-num = - 1 AND (X_ext-classif.charkey_One = &1&4&1 or X_ext-classif.charkey_One = &1&5&1) '                             , chr(34), 'clients':U, v-cli-classif-name, 'орг':U, 'чел':U, rs-key#_three )  + " " + where-phrase-30
     3917             else "true"
     3918           )
     3919         parameter-5-30 = (" " + "" + " " + "")
     3920         parameter-6-30 = if sort-phrase-30 = ''
     3921                              then
     3922           (
     3923           " " + "  " +
     3924             " " + sort-column-phrase +
     3925           " " + " BY X_ext-classif.charkey_three "
     3926           )
     3927                              else
     3928           (
     3929           " " + "  " +
     3930             " " + sort-column-phrase +
     3931           " " + sort-phrase-30
     3932           )
     3933         parameter-7-30 =
     3934           " INDEXED-REPOSITION  "
     3935       .
     3936       do
     3937       on stop undo, leave
     3938       on error undo, leave
     3939       :
     3940         assign
     3941           l-disable-where-30 =
     3942             (" X_ext-classif.classif-subject = 'clients':U                             and X_ext-classif.classif-name = v-cli-classif-name                             AND X_ext-classif.db-num = - 1                             and (rs-key#_three = -1  or X_ext-classif.key#_three = rs-key#_three)                             AND (X_ext-classif.charkey_One = 'орг':U or X_ext-classif.charkey_One = 'чел':U) " + " " + where-phrase-30 = "")
     3943         .
     3944         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3945                             ,input QUERY br-clients:handle
     3946                             ,input parameter-3-30
     3947                             ,input parameter-4-30
     3948                             ,input parameter-5-30
     3949                             ,input parameter-6-30
     3950                             ,input parameter-7-30
     3951                             )
     3952         .
     3953         assign
     3954           l-filter-open-30 = true
     3955         .
     3956       end.
     3957       if l-filter-open-30 = false then do:
     3958         message
     3959           "Ошибка при фильтрации / сортировке" skip
     3960           "Будут показаны записи без учета фильтра" skip
     3961           view-as alert-box .
     3962       end.
     3963       else do:
     3964           assign
     3965             l-query-was-opened = true
     3966           .
     3967       end.
