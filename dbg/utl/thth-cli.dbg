     1878               when 'thth14-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1879               when 'thth14-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1880               when 'thth14-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1881         otherwise do:
     1882           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     1883         end.
     1884       end.
     1885     end.
     1886   end procedure.
     1887   procedure thth14-db-attr-tooltip :
     1888     do
     1889     on error undo, return error
     1890     :
     1891       define input  parameter p-code    as character no-undo .
     1892       define output parameter p-tooltip as character no-undo .
     1893       define output parameter p-label   as character no-undo .
     1894       case p-code :
     1895               when 'thth14-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
     1896               when 'thth14-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
     1897               when 'thth14-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
     1898               when 'thth14-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
     1899               when 'thth14-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
     1900               when 'thth14-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
     1901               when 'thth14-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
     1902               when 'thth14-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
     1903               when 'thth14-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
     1904               when 'thth14-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
     1905         otherwise do:
     1906           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     1907         end.
     1908       end.
     1909     end.
     1910   end procedure.
     1911   procedure thth14-db-attr-value :
     1912     do
     1913     on error undo, return error
     1914     :
     1915       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     1916       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     1917       define output parameter p-value     like ub.db-attr.attr-value no-undo .
     1918       define output parameter p-type      as character no-undo .
     1919       define buffer buf_db-attr for ub.db-attr .
     1920       define variable v-format         as character no-undo .
     1921       define variable v-label          as character no-undo .
     1922       define variable v-user-can-edit  as logical   no-undo .
     1923       define variable v-output-display as logical   no-undo .
     1924       define variable v-other          as character no-undo .
     1925       run thth14-db-attr-code in this-procedure
     1926         (input  p-code
     1927         ,output p-type
     1928         ,output v-format
     1929         ,output v-label
     1930         ,output v-user-can-edit
     1931         ,output v-output-display
     1932         ,output v-other
     1933         ) no-error .
     1934       if error-status :error then do:
     1935         undo, return error return-value .
     1936       end.
     1937       find first buf_db-attr no-lock
     1938         where buf_db-attr.db-num    = p-db-num
     1939           and buf_db-attr.attr-code = p-code
     1940         no-error .
     1941       if avail buf_db-attr then do:
     1942         assign
     1943           p-value =  buf_db-attr.attr-value
     1944         .
     1945       end.
     1946       else do:
     1947         assign
     1948           p-value = if p-type = 'L':U then "no":U else ""
     1949         .
     1950       end.
     1951     end.
     1952   end procedure.
     1953   procedure thth14-db-attr-write :
     1954     do
     1955     on error undo, return error
     1956     :
     1957       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     1958       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     1959       define input parameter p-value     like ub.db-attr.attr-value no-undo .
     1960       define buffer buf_db-attr for ub.db-attr .
     1961       define variable v-type           as character no-undo .
     1962       define variable v-format         as character no-undo .
     1963       define variable v-label          as character no-undo .
     1964       define variable v-user-can-edit  as logical   no-undo .
     1965       define variable v-output-display as logical   no-undo .
     1966       define variable v-other          as character no-undo .
     1967       run thth14-db-attr-code in this-procedure
     1968         (input  p-code
     1969         ,output v-type
     1970         ,output v-format
     1971         ,output v-label
     1972         ,output v-user-can-edit
     1973         ,output v-output-display
     1974         ,output v-other
     1975         ) no-error .
     1976       if error-status :error then do:
     1977         undo, return error return-value .
     1978       end.
     1979       find first buf_db-attr exclusive-lock
     1980         where buf_db-attr.db-num    = p-db-num
     1981           and buf_db-attr.attr-code = p-code
     1982         no-error .
     1983       if not available buf_db-attr then do:
     1984         create buf_db-attr .
     1985         assign
     1986           buf_db-attr.db-num    = p-db-num
     1987           buf_db-attr.attr-code = p-code
     1988         .
     1989       end.
     1990       assign
     1991         buf_db-attr.attr-value = p-value
     1992       .
     1993     end.
     1994   end procedure.
     1995   procedure thth14-db-attr-exist :
     1996     do
     1997     on error undo, return error
     1998     :
     1999       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     2000       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     2001       define output parameter p-exist    as logical  no-undo .
     2002       define buffer buf_db-attr for ub.db-attr .
     2003       define variable v-type           as character no-undo .
     2004       define variable v-format         as character no-undo .
     2005       define variable v-label          as character no-undo .
     2006       define variable v-user-can-edit  as logical   no-undo .
     2007       define variable v-output-display as logical   no-undo .
     2008       define variable v-other          as character no-undo .
     2009       run thth14-db-attr-code in this-procedure
     2010         (input  p-code
     2011         ,output v-type
     2012         ,output v-format
     2013         ,output v-label
     2014         ,output v-user-can-edit
     2015         ,output v-output-display
     2016         ,output v-other
     2017         ) no-error .
     2018       if error-status :error then do:
     2019         undo, return error return-value .
     2020       end.
     2021       find first buf_db-attr no-lock
     2022         where buf_db-attr.db-num    = p-db-num
     2023           and buf_db-attr.attr-code = p-code
     2024         no-error .
     2025       if  available buf_db-attr then do:
     2026         p-exist = yes.
     2027       end.
     2028     end.
     2029   end procedure.
     2030   procedure thth14-db-attr-delete :
     2031     do
     2032     on error undo, return error
     2033     :
     2034       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
     2035       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     2036       define output parameter p-deleted  as logical no-undo.
     2037       define buffer buf_db-attr for ub.db-attr .
     2038       define variable v-type           as character no-undo .
     2039       define variable v-format         as character no-undo .
     2040       define variable v-label          as character no-undo .
     2041       define variable v-user-can-edit  as logical   no-undo .
     2042       define variable v-output-display as logical   no-undo .
     2043       define variable v-other          as character no-undo .
     2044       run thth14-db-attr-code in this-procedure
     2045         (input  p-code
     2046         ,output v-type
     2047         ,output v-format
     2048         ,output v-label
     2049         ,output v-user-can-edit
     2050         ,output v-output-display
     2051         ,output v-other
     2052         ) no-error .
     2053       if error-status :error then do:
     2054         undo, return error return-value .
     2055       end.
     2056       find first buf_db-attr exclusive-lock
     2057         where buf_db-attr.db-num    = p-db-num
     2058           and buf_db-attr.attr-code = p-code
     2059         no-error NO-WAIT.
     2060       if not available buf_db-attr then do:
     2061         p-deleted = no.
     2062       end.
     2063       else do:
     2064         delete buf_db-attr.
     2065         p-deleted = yes.
     2066       end.
     2067     end.
     2068   end procedure.
     2069   procedure thth14-db-attr-news :
     2070     do
     2071     on error undo, return error
     2072     :
     2073       define input  parameter p-code           as character no-undo .
     2074       define output parameter p-news           as logical   no-undo .
     2075       case p-code :
     2076               when 'thth14-cli-grp':U then do:     assign     p-news = no.   end.
     2077               when 'thth14-gds-grp':U then do:     assign     p-news = no.   end.
     2078               when 'thth14-clients':U then do:     assign     p-news = no.   end.
     2079               when 'thth14-goods':U then do:     assign     p-news = no.   end.
     2080               when 'thth14-dis-card':U then do:     assign     p-news = no.   end.
     2081               when 'thth14-qnty-dis-card':U then do:     assign     p-news = no.   end.
     2082               when 'thth14-shop':U then do:     assign     p-news = no.   end.
     2083               when 'thth14-contract':U then do:     assign     p-news = no.   end.
     2084               when 'thth14-price-doc':U then do:     assign     p-news = no.   end.
     2085               when 'thth14-trn-doc':U then do:     assign     p-news = no.   end.
     2086         otherwise do:
     2087           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     2088         end.
     2089       end.
     2090     end.
     2091   end procedure.
     2092   define variable sort-column-name as character no-undo.
     2093   define variable filter-point     as character NO-UNDO INIT "thth-cli".
     2094   define variable filter-label     as character NO-UNDO INIT "Соответствие клиентов в разных TH".
     2095   define variable filter-point0     as character NO-UNDO INIT "thth-cli".
     2096   define variable filter-label0     as character NO-UNDO INIT "Соответствие клиентов в разных TH".
     2097   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2098   DEFINE VARIABLE copy-option  AS CHARACTER NO-UNDO.
     2099   define variable v-doc-rec as recid no-undo .
     2100   define variable v-closed as character no-undo .
     2101   define variable v-type as character no-undo .
     2102   define variable v-attr-code as character no-undo .
     2103   define variable v-cli-classif-name as character no-undo .
     2104   FUNCTION get-cli-name RETURNS CHARACTER
     2105     ( INPUT p-uniq-key-rec AS character )  FORWARD.
     2106   DEFINE MENU MENU-b-copy
     2107          MENU-ITEM m_one          LABEL "Текущий"
     2108          MENU-ITEM m_list         LABEL "Отмеченные (только без соответствия)"
     2109          MENU-ITEM m_all          LABEL "ВСЕ (только без соответствия)".
     2110   DEFINE BUTTON b-close
     2111        LABEL "Закр"
     2112        SIZE 8 BY 1.
     2113   DEFINE BUTTON b-copy
     2114        LABEL "Копировать из"
     2115        SIZE 20 BY 1.
     2116   DEFINE BUTTON B-Help
     2117        LABEL "Помо&щь"
     2118        SIZE 3 BY 1
     2119        BGCOLOR 8 .
     2120   DEFINE BUTTON b-imp
     2121        LABEL "Получ.соответствие"
     2122        SIZE 20 BY 1 TOOLTIP "Получение соответствия данных по клиентам системы TH".
     2123   DEFINE BUTTON b-imp-gds
     2124        LABEL "Сведение по товарам"
     2125        SIZE 20 BY 1 TOOLTIP "Получение соответствия данных по клиентам системы TH".
     2126   DEFINE BUTTON B-mark
     2127        LABEL "&*"
     2128        SIZE 3 BY 1.
     2129   DEFINE BUTTON b-print
     2130        LABEL "&Печать"
     2131        SIZE 3 BY 1.
     2132   DEFINE BUTTON b-quit AUTO-END-KEY
     2133        LABEL "&Выход"
     2134        SIZE 10 BY 1
     2135        BGCOLOR 8 .
     2136   DEFINE BUTTON b-sch
     2137        LABEL "Фильтр"
     2138        SIZE 3 BY 1.
     2139   DEFINE BUTTON B-sel AUTO-GO
     2140        LABEL "Вы&бор"
     2141        SIZE 10 BY 1.
     2142   DEFINE BUTTON b-tie
     2143        LABEL "Связать"
     2144        SIZE 10 BY 1.
     2145   DEFINE VARIABLE f-cli-name AS CHARACTER FORMAT "X(256)":U
     2146        VIEW-AS FILL-IN
     2147        SIZE 98 BY .93
     2148        FGCOLOR 4  NO-UNDO.
     2149   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     2150         VIEW-AS TEXT
     2151        SIZE 6 BY 1
     2152        FGCOLOR 4  NO-UNDO.
     2153   DEFINE VARIABLE sch-old-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     2154        LABEL "Поиск по коду"
     2155        VIEW-AS FILL-IN
     2156        SIZE 10 BY 1 NO-UNDO.
     2157   DEFINE VARIABLE sch-self-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     2158        LABEL "Поиск по коду v16.0"
     2159        VIEW-AS FILL-IN
     2160        SIZE 10 BY 1 NO-UNDO.
     2161   DEFINE VARIABLE rs-cli-type AS CHARACTER
     2162        VIEW-AS RADIO-SET HORIZONTAL
     2163        RADIO-BUTTONS
     2164             "Item 1", "1"
     2165        SIZE 13.5 BY .8 NO-UNDO.
     2166   DEFINE VARIABLE rs-key#_three AS INTEGER
     2167        VIEW-AS RADIO-SET HORIZONTAL
     2168        RADIO-BUTTONS
     2169             "Все", -1,
     2170   "В работе", 0,
     2171   "Сведенные ранее", 2,
     2172   "Были уже до upgrade", 1
     2173        SIZE 59 BY 1 NO-UNDO.
     2174   DEFINE QUERY br-clients FOR X_ext-classif SCROLLING.
     2175   DEFINE BROWSE br-clients
     2176     QUERY br-clients NO-LOCK DISPLAY
     2177         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     2178   (X_ext-classif.key#_three = 1) COLUMN-LABEL "До upg" FORMAT "+/"
     2179   (IF X_ext-classif.uniq-key-rec BEGINS 'clients':U
     2180    THEN (entry(2, X_ext-classif.uniq-key-rec, chr(3)) +
     2181          entry(3, X_ext-classif.uniq-key-rec, chr(3))
     2182          )
     2183   ELSE ''
     2184       ) COLUMN-LABEL "КЛИЕНТ!v16.0" FORMAT "X(12)"
     2185   (X_ext-classif.charkey_one + string(X_ext-classif.KEY#_one))  COLUMN-LABEL "КЛИЕНТ!" FORMAT "X(12)"
     2186   X_ext-classif.charkey_two COLUMN-LABEL "ИНН" FORMAT "X(12)"
     2187   X_ext-classif.charkey_three COLUMN-LABEL "Название КЛИЕНТА в" FORMAT "X(60)"
     2188       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.43 FIT-LAST-COLUMN.
     2189   DEFINE FRAME Dialog-Frame
     2190        b-quit AT ROW 1 COL 1
     2191        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     2192        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     2193        b-tie AT ROW 1 COL 31 WIDGET-ID 20
     2194        b-copy AT ROW 1 COL 41 WIDGET-ID 22
     2195        b-imp AT ROW 1 COL 61 WIDGET-ID 18
     2196        b-close AT ROW 1 COL 81 WIDGET-ID 26
     2197        b-sch AT ROW 1 COL 89 WIDGET-ID 12
     2198        b-print AT ROW 1 COL 92 WIDGET-ID 10
     2199        B-Help AT ROW 1 COL 95
     2200        rs-key#_three AT ROW 2 COL 1.5 NO-LABEL WIDGET-ID 30
     2201        b-imp-gds AT ROW 2 COL 61 WIDGET-ID 28
     2202        sch-old-code AT ROW 3 COL 22 COLON-ALIGNED WIDGET-ID 38
     2203        rs-cli-type AT ROW 3 COL 34.5 NO-LABEL WIDGET-ID 36
     2204        sch-self-code AT ROW 3 COL 70 COLON-ALIGNED WIDGET-ID 40
     2205        br-clients AT ROW 4 COL 1 WIDGET-ID 100
     2206        f-cli-name AT ROW 22.33 COL 1 NO-LABEL WIDGET-ID 24
     2207        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     2208        SPACE(79.30) SKIP(21.26)
     2209       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2210            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2211            TITLE ""
     2212            CANCEL-BUTTON b-quit.
     2213   ASSIGN
     2214          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2215          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2216   ASSIGN
     2217          b-copy:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-copy:HANDLE.
     2218   ON GO OF FRAME Dialog-Frame
     2219   DO:
     2220     p-rid-list = v-rid-list.
     2221   END.
     2222   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2223   DO:
     2224     APPLY "END-ERROR":U TO SELF.
     2225   END.
     2226   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     2227   DO:
     2228     RUN proc-close IN THIS-PROCEDURE NO-ERROR.
     2229     IF ERROR-STATUS:ERROR THEN UNDO, RETURN NO-APPLY.
     2230   END.
     2231   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
     2232   DO:
     2233     if copy-option = "":U then do:
     2234       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     2235       if error-status :error then do: return no-apply. end.
     2236     end.
     2237     if copy-option = "":U then do:
     2238         return no-apply.
     2239     end.
     2240     RUN proc-copy IN THIS-PROCEDURE ( INPUT copy-option) NO-ERROR.
     2241     copy-option = ''.
     2242     APPLY "entry" TO br-clients.
     2243   END.
     2244   ON CHOOSE OF b-imp IN FRAME Dialog-Frame
     2245   DO:
     2246     RUN proc-imp IN THIS-PROCEDURE NO-ERROR.
     2247     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2248   END.
     2249   ON CHOOSE OF b-imp-gds IN FRAME Dialog-Frame
     2250   DO:
     2251     RUN proc-imp-gds IN THIS-PROCEDURE NO-ERROR.
     2252     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2253   END.
     2254   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2255   DO:
     2256     define variable loc#log as logical no-undo .
     2257     if available X_ext-classif then do:
     2258   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2259   define variable v-str-recid18 as character no-undo .
     2260   define variable v-num-entry18 as integer   no-undo .
     2261   assign
     2262     v-str-recid18 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     2263     v-num-entry18 = lookup( v-str-recid18 , v-rid-list )
     2264   .
     2265   if v-num-entry18 > 0 then do:
     2266     assign
     2267       entry( v-num-entry18, v-rid-list ) = "":U
     2268       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2269     .
     2270   end.
     2271   else do:
     2272     assign
     2273       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid18
     2274     .
     2275   end.
     2276       loc#log = br-clients:refresh() .
     2277       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2278           loc#log = br-clients:select-next-row ().
     2279           apply "VALUE-CHANGED" to br-clients in frame Dialog-Frame.
     2280       end.
     2281       if num-entries( v-rid-list ) = 0
     2282       then
     2283           hide mark-num in frame Dialog-Frame.
     2284       else
     2285           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2286     end.
     2287     apply "entry" to br-clients in frame Dialog-Frame.
     2288   END.
     2289   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     2290   DO:
     2291     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     2292     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2293   END.
     2294   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     2295   DO:
     2296     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     2297     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2298   END.
     2299   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     2300   DO:
     2301       if ( available X_ext-classif ) then do:
     2302       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     2303       then
     2304       v-rid-list = string( recid( X_ext-classif ) ) .
     2305     end.
     2306   END.
     2307   ON CHOOSE OF b-tie IN FRAME Dialog-Frame
     2308   DO:
     2309     if not available X_ext-classif then return no-apply.
     2310     RUN proc-b-tie IN THIS-PROCEDURE NO-ERROR.
     2311     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2312   END.
     2313   ON VALUE-CHANGED OF br-clients IN FRAME Dialog-Frame
     2314   DO:
     2315    DEFINE VARIABLE v-cli-name AS CHARACTER NO-UNDO.
     2316    IF AVAILABLE X_ext-classif
     2317    and X_ext-classif.uniq-key-rec <> ''
     2318    THEN DO:
     2319        v-cli-name = get-cli-name (INPUT X_ext-classif.uniq-key-rec ) .
     2320     END.
     2321     ELSE DO:
     2322        v-cli-name = ''.
     2323     END.
     2324     f-cli-name:SCREEN-VALUE = v-cli-name.
     2325   END.
     2326   ON CHOOSE OF MENU-ITEM m_all
     2327   DO:
     2328     ASSIGN
     2329     copy-option = "all".
     2330     APPLY "CHOOSE" TO b-copy IN FRAME Dialog-Frame.
     2331   END.
     2332   ON CHOOSE OF MENU-ITEM m_list
     2333   DO:
     2334     IF v-rid-list = '' THEN do:
     2335        MESSAGE
     2336        "Нет выбранных записей"
     2337        VIEW-AS ALERT-BOX .
     2338        RETURN NO-APPLY.
     2339     END.
     2340     ASSIGN
     2341     copy-option = "list".
     2342     APPLY "choose" TO b-copy IN FRAME Dialog-Frame.
     2343   END.
     2344   ON CHOOSE OF MENU-ITEM m_one
     2345   DO:
     2346     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     2347     ASSIGN
     2348     copy-option = "one".
     2349     APPLY "CHOOSE" TO b-copy IN FRAME Dialog-Frame.
     2350   END.
     2351   ON VALUE-CHANGED OF rs-cli-type IN FRAME Dialog-Frame
     2352   DO:
     2353     ASSIGN
     2354     rs-cli-type.
     2355   END.
     2356   ON VALUE-CHANGED OF rs-key#_three IN FRAME Dialog-Frame
     2357   DO:
     2358     ASSIGN
     2359     rs-key#_three .
     2360     if available X_ext-classif then v-doc-rec = recid(X_ext-classif).
     2361     run openbr in this-procedure ( INPUT YES, INPUT NO, INPUT '':U) no-error.
     2362     reposition br-clients to recid(v-doc-rec) no-error. APPLy 'ENTRY' to br-clients .
     2363   END.
     2364   ON RETURN OF sch-old-code IN FRAME Dialog-Frame
     2365   DO:
     2366     run proc-find-old-code in this-procedure ( input no, input frame Dialog-Frame sch-old-code) no-error.
     2367     if error-status:error then return no-apply.
     2368   END.
     2369   ON RETURN OF sch-self-code IN FRAME Dialog-Frame
     2370   DO:
     2371     run proc-find-self-code in this-procedure ( input no, input frame Dialog-Frame sch-self-code) no-error.
     2372     if error-status:error then return no-apply.
     2373   END.
     2374   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2375   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2376   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2377   on help of frame Dialog-Frame
     2378   do:
     2379     run gbl/app_help.p
     2380       (input this-procedure :file-name
     2381       ,input ''
     2382       ,input ?
     2383       ) no-error.
     2384     if error-status :error then do:
     2385       message
     2386         "Ошибка при вызове помощи"
     2387         error-status :get-message(1)
     2388         view-as alert-box .
     2389     end.
     2390   end.
     2391   run minbtn-set in this-procedure .
     2392   on choose of b-help in frame Dialog-Frame
     2393   do:
     2394     apply "help":u to frame Dialog-Frame .
     2395   end.
     2396   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2397   procedure minbtn-set :
     2398       do
     2399           on error undo, return error return-value
     2400           :
     2401           define variable ii              as integer       no-undo .
     2402           define variable fh              as widget-handle no-undo .
     2403           define variable hh              as widget-handle no-undo .
     2404           define variable v-h             as handle        extent 4 no-undo .
     2405           define variable v-name-button   as character     no-undo .
     2406           define variable v-help-old-x    as decimal       no-undo .
     2407           define variable v-help-old-y    as decimal       no-undo .
     2408           define variable v-help-old-size as decimal       no-undo .
     2409           define variable v-frame-width   as decimal       no-undo .
     2410           define variable jj              as integer       no-undo .
     2411           do
     2412               on error undo, return error
     2413               :
     2414               assign
     2415                   v-frame-width = frame Dialog-Frame:width - 0.3
     2416                   fh            = frame Dialog-Frame:first-child
     2417                   hh            = fh:first-child
     2418                   ii            = 1
     2419                   .
     2420               do while valid-handle(hh):
     2421                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2422                   do:
     2423                       case lc(hh:name) :
     2424                           when "b-help" then
     2425                               do:
     2426                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2427                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2428                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2429                                   hh:TOOLTIP = "Помощь" .
     2430                                   v-help-old-x = hh:column .
     2431                                   v-help-old-y = hh:row    .
     2432                                   v-help-old-size = hh:width .
     2433                                   hh:width-chars = 2.5 .
     2434                               end.
     2435                           when "b-print" then
     2436                               do:
     2437                                   hh:load-image("cmp/b-print.bmp":u) .
     2438                                   hh:TOOLTIP = "Печать" .
     2439                                   v-h[ii] = hh:handle .
     2440                                   ii = ii + 1 .
     2441                                   hh:width-chars = 3 .
     2442                               end.
     2443                           when "b-history" or
     2444                           when "b-hist" then
     2445                               do:
     2446                                   hh:load-image("cmp/b-hist.bmp":u) .
     2447                                   hh:TOOLTIP = "История" .
     2448                                   v-h[ii] = hh:handle .
     2449                                   ii = ii + 1 .
     2450                                   hh:width-chars = 3 .
     2451                               end.
     2452                           when "b-sch" then
     2453                               do:
     2454                                   hh:load-image("cmp/b-sch.bmp":u) .
     2455                                   hh:TOOLTIP = "Установка Фильтра" .
     2456                                   v-h[ii] = hh:handle .
     2457                                   ii = ii + 1 .
     2458                                   hh:width-chars = 3 .
     2459                               end.
     2460                           when "b-hist-user" then
     2461                               do:
     2462                                   hh:load-image("cmp/b-hist.bmp":u) .
     2463                                   hh:TOOLTIP = "История пользователя" .
     2464                                   ii = ii + 1 .
     2465                               end.
     2466                       end case.
     2467                   end.
     2468                   hh = hh:next-sibling.
     2469               end.
     2470               b-help:column = v-frame-width - b-help:width-chars.
     2471               jj = 0.
     2472               repeat ii = 4 to 1 by -1 :
     2473                   if valid-handle (v-h[ii] ) then
     2474                   do:
     2475                       jj  = jj + 1 .
     2476                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2477                       v-h[ii]:row    = v-help-old-y .
     2478                   end.
     2479               end.
     2480           end.
     2481       end.
     2482   end procedure.
     2483   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2484   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2485   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2486   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2487   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2488   define variable v-diasize-current-frame-height as decimal   no-undo .
     2489   define variable v-diasize-change-size          as logical   no-undo .
     2490   define variable v-diasize-resize-button        as handle    no-undo .
     2491   define variable v-diasize-wndmax               as logical   no-undo .
     2492   define variable v-diasize-wndstore             as logical   no-undo .
     2493   define variable v-diasize-proc-name            as character no-undo .
     2494   define variable v-diasize-browse-handle        as handle    no-undo .
     2495   define variable v-diasize-browse-number        as integer   no-undo .
     2496   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2497   define temp-table temp-diasize-handle no-undo
     2498     field handle-value  as handle
     2499     field save-position as decimal
     2500     index xpk is primary unique handle-value
     2501     .
     2502   define temp-table temp-browse-handle no-undo
     2503     field browse-type   as character
     2504     field browse-number as integer
     2505     field browse-handle as handle
     2506     field original-size as decimal
     2507     index xpk is primary unique browse-type browse-number
     2508     index xie browse-type browse-handle
     2509   .
     2510   procedure diasize_change-height :
     2511     define input  parameter p-change-value  as decimal   no-undo .
     2512     define input  parameter p-move-resize   as logical   no-undo .
     2513     define variable v-field-group-handle    as handle    no-undo .
     2514     define variable v-object-handle         as handle    no-undo .
     2515     define variable v-frame-height          as decimal   no-undo .
     2516     define variable v-frame-virtual-height  as decimal   no-undo .
     2517     define variable v-browse-height         as decimal   no-undo .
     2518     define variable v-window-height         as decimal   no-undo .
     2519     define variable v-window-virtual-height as decimal   no-undo .
     2520     define variable v-change-sign           as integer   no-undo .
     2521     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2522     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2523     if p-change-value > 0
     2524     then do:
     2525       if frame Dialog-Frame :height + p-change-value
     2526           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2527       then do:
     2528         assign
     2529           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2530                           - (frame Dialog-Frame :height-chars)
     2531         .
     2532         if p-change-value <= 0
     2533         then do:
     2534           run diasize_position-resize-button in this-procedure .
     2535           return .
     2536         end.
     2537       end.
     2538     end.
     2539     if p-change-value < 0
     2540     then do:
     2541       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2542       then do:
     2543         assign
     2544           p-change-value = v-diasize-orig-frame-height
     2545                          - (frame Dialog-Frame :height-chars)
     2546         .
     2547         if p-change-value >= 0
     2548         then do:
     2549           run diasize_position-resize-button in this-procedure .
     2550           return .
     2551         end.
     2552       end.
     2553     end.
     2554     if p-change-value >= 0
     2555     then do:
     2556       assign
     2557         v-change-sign = 1
     2558       .
     2559     end.
     2560     else do:
     2561       assign
     2562         v-change-sign = -1
     2563       .
     2564     end.
     2565     assign
     2566       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2567     .
     2568     if p-change-value = 0
     2569     then do:
     2570       run diasize_position-resize-button in this-procedure .
     2571       return .
     2572     end.
     2573     move_block:
     2574     do
     2575     on error undo move_block, retry move_block
     2576     :
     2577       if retry
     2578       then do:
     2579         do
     2580         on error undo move_block, leave move_block
     2581         :
     2582           if p-change-value > 0
     2583           then do:
     2584             for each buf_temp-diasize-handle
     2585             on error undo, next
     2586             :
     2587               assign
     2588                 v-object-handle = buf_temp-diasize-handle.handle-value
     2589               .
     2590               if v-object-handle <> v-diasize-resize-button
     2591               then do:
     2592                 assign
     2593                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2594                 .
     2595               end.
     2596             end.
     2597             assign
     2598               v-diasize-browse-handle :height = v-browse-height
     2599             .
     2600             for each buf_temp-browse-handle
     2601               where buf_temp-browse-handle.browse-type = 'height':u
     2602             on error undo, next
     2603             :
     2604               assign
     2605                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2606               .
     2607             end.
     2608             assign
     2609               frame Dialog-Frame :height = v-frame-height
     2610             .
     2611             if frame Dialog-Frame :scrollable = true
     2612             then do:
     2613               assign
     2614                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2615               .
     2616             end.
     2617             run diasize_position-resize-button in this-procedure .
     2618           end.
     2619           else do:
     2620             if frame Dialog-Frame :scrollable = true
     2621             then do:
     2622               assign
     2623                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2624               .
     2625             end.
     2626             assign
     2627               frame Dialog-Frame :height = v-frame-height
     2628             .
     2629             assign
     2630               v-diasize-browse-handle :height = v-browse-height
     2631             .
     2632             for each buf_temp-browse-handle
     2633               where buf_temp-browse-handle.browse-type = 'height':u
     2634             on error undo, next
     2635             :
     2636               assign
     2637                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2638               .
     2639             end.
     2640             for each buf_temp-diasize-handle
     2641             on error undo, next
     2642             :
     2643               assign
     2644                 v-object-handle = buf_temp-diasize-handle.handle-value
     2645               .
     2646               if v-object-handle <> v-diasize-resize-button
     2647               then do:
     2648                 assign
     2649                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2650                 .
     2651               end.
     2652             end.
     2653             run diasize_position-resize-button in this-procedure .
     2654           end.
     2655           assign
     2656             v-diasize-change-size = false
     2657           .
     2658           leave move_block .
     2659         end.
     2660       end.
     2661       assign
     2662         v-diasize-need-full-display = true
     2663       .
     2664       if v-diasize-change-size = false
     2665       then do:
     2666         assign
     2667           v-diasize-change-size = true
     2668         .
     2669       end.
     2670       else do:
     2671         return .
     2672       end.
     2673       assign
     2674         v-frame-height = frame Dialog-Frame :height
     2675         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2676         v-browse-height = v-diasize-browse-handle :height
     2677       .
     2678       for each buf_temp-browse-handle
     2679         where buf_temp-browse-handle.browse-type = 'height':u
     2680       :
     2681         assign
     2682           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2683         .
     2684       end.
     2685       for each buf_temp-diasize-handle
     2686       :
     2687         delete buf_temp-diasize-handle .
     2688       end.
     2689       assign
     2690         v-field-group-handle = frame Dialog-Frame :first-child
     2691       .
     2692       do while valid-handle(v-field-group-handle)
     2693       :
     2694         assign
     2695           v-object-handle = v-field-group-handle :first-child
     2696         .
     2697         do while valid-handle(v-object-handle)
     2698         :
     2699           if  v-object-handle <> v-diasize-browse-handle :handle
     2700           and can-query(v-object-handle, "row")
     2701           and can-query(v-object-handle, "height")
     2702           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2703           then do:
     2704             find first buf_temp-browse-handle
     2705               where buf_temp-browse-handle.browse-type   = 'height':u
     2706                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2707               no-error .
     2708             if available buf_temp-browse-handle
     2709             then do:
     2710             end.
     2711             else do:
     2712               create buf_temp-diasize-handle .
     2713               assign
     2714                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2715                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2716               .
     2717             end.
     2718           end.
     2719           assign
     2720             v-object-handle = v-object-handle :next-sibling
     2721           .
     2722         end.
     2723         assign
     2724           v-field-group-handle = v-field-group-handle :next-sibling
     2725         .
     2726       end.
     2727       do with frame Dialog-Frame
     2728       :
     2729         hide v-diasize-resize-button .
     2730         assign
     2731           v-diasize-resize-button :row    = 1
     2732           v-diasize-resize-button :column = 1
     2733         .
     2734       end.
     2735       if p-change-value > 0
     2736       then do:
     2737         if frame Dialog-Frame :scrollable = true
     2738         then do:
     2739           assign
     2740             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2741             no-error .
     2742           if error-status :error
     2743           or error-status :get-message(1) <> ""
     2744           then do:
     2745             undo move_block, retry move_block .
     2746           end.
     2747         end.
     2748         assign
     2749           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2750           no-error .
     2751         if error-status :error
     2752         or error-status :get-message(1) <> ""
     2753         then do:
     2754           undo move_block, retry move_block .
     2755         end.
     2756         assign
     2757           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2758           no-error .
     2759         if error-status :error
     2760         or error-status :get-message(1) <> ""
     2761         then do:
     2762           undo move_block, retry move_block .
     2763         end.
     2764         for each buf_temp-browse-handle
     2765           where buf_temp-browse-handle.browse-type = 'height':u
     2766         on error undo move_block, retry move_block
     2767         :
     2768           assign
     2769             buf_temp-browse-handle.browse-handle :height
     2770               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2771             no-error .
     2772           if error-status :error
     2773           or error-status :get-message(1) <> ""
     2774           then do:
     2775             undo move_block, retry move_block .
     2776           end.
     2777         end.
     2778         for each buf_temp-diasize-handle
     2779         on error undo move_block, retry move_block
     2780         :
     2781           assign
     2782             v-object-handle = buf_temp-diasize-handle.handle-value
     2783           .
     2784           if v-object-handle <> v-diasize-resize-button
     2785           then do:
     2786             assign
     2787               v-object-handle :row = v-object-handle :row + p-change-value
     2788               no-error .
     2789             if error-status :error
     2790             or error-status :get-message(1) <> ""
     2791             then do:
     2792               undo move_block, retry move_block .
     2793             end.
     2794           end.
     2795         end.
     2796       end.
     2797       else do:
     2798         for each buf_temp-diasize-handle
     2799         on error undo move_block, retry move_block
     2800         :
     2801           assign
     2802             v-object-handle = buf_temp-diasize-handle.handle-value
     2803           .
     2804           if v-object-handle <> v-diasize-resize-button
     2805           then do:
     2806             assign
     2807               v-object-handle :row = v-object-handle :row + p-change-value
     2808               no-error .
     2809             if error-status :error
     2810             or error-status :get-message(1) <> ""
     2811             then do:
     2812               undo move_block, retry move_block .
     2813             end.
     2814           end.
     2815         end.
     2816         assign
     2817           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2818           no-error .
     2819         if error-status :error
     2820         or error-status :get-message(1) <> ""
     2821         then do:
     2822           undo move_block, retry move_block .
     2823         end.
     2824         for each buf_temp-browse-handle
     2825           where buf_temp-browse-handle.browse-type = 'height':u
     2826         on error undo move_block, retry move_block
     2827         :
     2828           assign
     2829             buf_temp-browse-handle.browse-handle :height
     2830               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2831             no-error .
     2832           if error-status :error
     2833           or error-status :get-message(1) <> ""
     2834           then do:
     2835             undo move_block, retry move_block .
     2836           end.
     2837         end.
     2838         assign
     2839           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2840           no-error .
     2841         if error-status :error
     2842         or error-status :get-message(1) <> ""
     2843         then do:
     2844           undo move_block, retry move_block .
     2845         end.
     2846         if frame Dialog-Frame :scrollable = true
     2847         then do:
     2848           assign
     2849             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2850             no-error .
     2851           if error-status :error
     2852           or error-status :get-message(1) <> ""
     2853           then do:
     2854             undo move_block, retry move_block .
     2855           end.
     2856         end.
     2857       end.
     2858       if p-move-resize = true
     2859       then do:
     2860         run diasize_position-resize-button in this-procedure .
     2861       end.
     2862       if v-diasize-wndstore = true
     2863       then do:
     2864         if connected("ub") = true
     2865         then do:
     2866           define variable v-cntxt-db-num        as integer   no-undo .
     2867           define variable v-cntxt-userid        as character no-undo .
     2868           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2869                                             , OUTPUT v-cntxt-userid
     2870                                             ) .
     2871           run gbl/wndsizew.p
     2872             (input  v-cntxt-db-num
     2873             ,input  v-cntxt-userid
     2874             ,input  v-diasize-proc-name
     2875             ,input  'height':u
     2876             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2877             ) .
     2878         end.
     2879       end.
     2880     end.
     2881     assign
     2882       v-diasize-change-size = false
     2883     .
     2884   end procedure.
     2885   procedure diasize_set-height :
     2886     define input  parameter p-new-height  as decimal   no-undo .
     2887     define input  parameter p-move-resize as logical   no-undo .
     2888     do
     2889     on error undo, return error return-value
     2890     :
     2891       run diasize_change-height in this-procedure
     2892         (input  (p-new-height - frame Dialog-Frame :height)
     2893         ,input  p-move-resize
     2894         ) .
     2895     end.
     2896   end procedure.
     2897   procedure diasize_change-width :
     2898     define input  parameter p-change-value as decimal   no-undo .
     2899     define input  parameter p-move-resize  as logical   no-undo .
     2900     define variable v-field-group-handle   as handle    no-undo .
     2901     define variable v-object-handle        as handle    no-undo .
     2902     define variable v-frame-width          as decimal   no-undo .
     2903     define variable v-frame-virtual-width  as decimal   no-undo .
     2904     define variable v-browse-width         as decimal   no-undo .
     2905     define variable v-window-width         as decimal   no-undo .
     2906     define variable v-window-virtual-width as decimal   no-undo .
     2907     define variable v-change-sign          as integer   no-undo .
     2908     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2909     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2910     if p-change-value > 0
     2911     then do:
     2912       if frame Dialog-Frame :width + p-change-value >
     2913           session :width-chars
     2914       then do:
     2915         assign
     2916           p-change-value = session :width-chars - frame Dialog-Frame :width
     2917         .
     2918         if p-change-value <= 0
     2919         then do:
     2920           run diasize_position-resize-button in this-procedure .
     2921           return .
     2922         end.
     2923       end.
     2924     end.
     2925     if p-change-value < 0
     2926     then do:
     2927       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2928       then do:
     2929         assign
     2930           p-change-value = v-diasize-orig-frame-width
     2931                          - frame Dialog-Frame :width
     2932         .
     2933         if p-change-value >= 0
     2934         then do:
     2935           run diasize_position-resize-button in this-procedure .
     2936           return .
     2937         end.
     2938       end.
     2939     end.
     2940     if p-change-value >= 0
     2941     then do:
     2942       assign
     2943         v-change-sign = 1
     2944       .
     2945     end.
     2946     else do:
     2947       assign
     2948         v-change-sign = -1
     2949       .
     2950     end.
     2951     assign
     2952       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2953     .
     2954     if p-change-value = 0
     2955     then do:
     2956       run diasize_position-resize-button in this-procedure .
     2957       return .
     2958     end.
     2959     move_block:
     2960     do
     2961     on error undo move_block, leave move_block
     2962     :
     2963       if retry
     2964       then do:
     2965         do
     2966         on error undo move_block, leave move_block
     2967         :
     2968           if p-change-value > 0
     2969           then do:
     2970             for each buf_temp-diasize-handle
     2971             on error undo, next
     2972             :
     2973               assign
     2974                 v-object-handle = buf_temp-diasize-handle.handle-value
     2975               .
     2976               if v-object-handle <> v-diasize-resize-button
     2977               then do:
     2978                 assign
     2979                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2980                 .
     2981               end.
     2982             end.
     2983             assign
     2984               v-diasize-browse-handle :width = v-browse-width
     2985             .
     2986             for each buf_temp-browse-handle
     2987               where buf_temp-browse-handle.browse-type = 'width':u
     2988             on error undo, next
     2989             :
     2990               assign
     2991                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2992               .
     2993             end.
     2994             assign
     2995               frame Dialog-Frame :width = v-frame-width
     2996             .
     2997             if frame Dialog-Frame :scrollable = true
     2998             then do:
     2999               assign
     3000                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3001               .
     3002             end.
     3003             run diasize_position-resize-button in this-procedure .
     3004           end.
     3005           else do:
     3006             if frame Dialog-Frame :scrollable = true
     3007             then do:
     3008               assign
     3009                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3010               .
     3011             end.
     3012             assign
     3013               frame Dialog-Frame :width = v-frame-width
     3014             .
     3015             for each buf_temp-browse-handle
     3016               where buf_temp-browse-handle.browse-type = 'width':u
     3017             on error undo, next
     3018             :
     3019               assign
     3020                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3021               .
     3022             end.
     3023             assign
     3024               v-diasize-browse-handle :width = v-browse-width
     3025             .
     3026             for each buf_temp-diasize-handle
     3027             on error undo, next
     3028             :
     3029               assign
     3030                 v-object-handle = buf_temp-diasize-handle.handle-value
     3031               .
     3032               if v-object-handle <> v-diasize-resize-button
     3033               then do:
     3034                 assign
     3035                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3036                 .
     3037               end.
     3038             end.
     3039             run diasize_position-resize-button in this-procedure .
     3040           end.
     3041           assign
     3042             v-diasize-change-size = false
     3043           .
     3044           leave move_block .
     3045         end.
     3046       end.
     3047       assign
     3048         v-diasize-need-full-display = true
     3049       .
     3050       if v-diasize-change-size = false
     3051       then do:
     3052         assign
     3053           v-diasize-change-size = true
     3054         .
     3055       end.
     3056       else do:
     3057         return .
     3058       end.
     3059       assign
     3060         v-frame-width = frame Dialog-Frame :width
     3061         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3062         v-browse-width = v-diasize-browse-handle :width
     3063       .
     3064       for each buf_temp-browse-handle
     3065         where buf_temp-browse-handle.browse-type = 'width':u
     3066       :
     3067         assign
     3068           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3069         .
     3070       end.
     3071       for each buf_temp-diasize-handle
     3072       :
     3073         delete buf_temp-diasize-handle .
     3074       end.
     3075       assign
     3076         v-field-group-handle = frame Dialog-Frame :first-child
     3077       .
     3078       do while valid-handle(v-field-group-handle)
     3079       :
     3080         assign
     3081           v-object-handle = v-field-group-handle :first-child
     3082         .
     3083         do while valid-handle(v-object-handle)
     3084         :
     3085           if  v-object-handle <> v-diasize-browse-handle :handle
     3086           and v-object-handle <> v-diasize-resize-button
     3087           and can-query(v-object-handle, "row")
     3088           and can-query(v-object-handle, "height")
     3089           and ( v-object-handle :col + v-object-handle :width
     3090                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3091               )
     3092           then do:
     3093             find first buf_temp-browse-handle
     3094               where buf_temp-browse-handle.browse-type   = 'width':u
     3095                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3096               no-error .
     3097             if available buf_temp-browse-handle
     3098             then do:
     3099             end.
     3100             else do:
     3101               create buf_temp-diasize-handle .
     3102               assign
     3103                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3104                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3105               .
     3106             end.
     3107           end.
     3108           assign
     3109             v-object-handle = v-object-handle :next-sibling
     3110           .
     3111         end.
     3112         assign
     3113           v-field-group-handle = v-field-group-handle :next-sibling
     3114         .
     3115       end.
     3116       do with frame Dialog-Frame
     3117       :
     3118         hide v-diasize-resize-button .
     3119         v-diasize-resize-button :row = 1.
     3120         v-diasize-resize-button :column = 1.
     3121       end.
     3122       if p-change-value > 0
     3123       then do:
     3124         if frame Dialog-Frame :scrollable = true
     3125         then do:
     3126           assign
     3127             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3128             no-error .
     3129           if error-status :error
     3130           or error-status :get-message(1) <> ""
     3131           then do:
     3132             undo move_block, retry move_block.
     3133           end.
     3134         end.
     3135         assign
     3136           frame Dialog-Frame :width = v-frame-width + p-change-value
     3137           no-error .
     3138         if error-status :error
     3139         or error-status :get-message(1) <> ""
     3140         then do:
     3141           undo move_block, retry move_block.
     3142         end.
     3143         assign
     3144           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3145         no-error .
     3146         if error-status :error
     3147         or error-status :get-message(1) <> ""
     3148         then do:
     3149           undo move_block, retry move_block.
     3150         end.
     3151         for each buf_temp-browse-handle
     3152           where buf_temp-browse-handle.browse-type = 'width':u
     3153         on error undo move_block, retry move_block
     3154         :
     3155           assign
     3156             buf_temp-browse-handle.browse-handle :width
     3157               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3158             no-error .
     3159           if error-status :error
     3160           or error-status :get-message(1) <> ""
     3161           then do:
     3162             undo move_block, retry move_block .
     3163           end.
     3164         end.
     3165         for each buf_temp-diasize-handle
     3166         on error undo move_block, retry move_block
     3167         :
     3168           assign
     3169             v-object-handle = buf_temp-diasize-handle.handle-value
     3170           .
     3171           if v-object-handle <> v-diasize-resize-button
     3172           then do:
     3173             assign
     3174               v-object-handle :col = v-object-handle :col + p-change-value
     3175               no-error .
     3176             if error-status :error
     3177             or error-status :get-message(1) <> ""
     3178             then do:
     3179               undo move_block, retry move_block .
     3180             end.
     3181           end.
     3182         end.
     3183       end.
     3184       else do:
     3185         for each buf_temp-diasize-handle
     3186         on error undo move_block, retry move_block
     3187         :
     3188           assign
     3189             v-object-handle = buf_temp-diasize-handle.handle-value
     3190           .
     3191           if v-object-handle <> v-diasize-resize-button
     3192           then do:
     3193             assign
     3194               v-object-handle :col = v-object-handle :col + p-change-value
     3195               no-error .
     3196             if error-status :error
     3197             or error-status :get-message(1) <> ""
     3198             then do:
     3199               undo move_block, retry move_block .
     3200             end.
     3201           end.
     3202         end.
     3203         for each buf_temp-browse-handle
     3204           where buf_temp-browse-handle.browse-type = 'width':u
     3205         on error undo move_block, retry move_block
     3206         :
     3207           assign
     3208             buf_temp-browse-handle.browse-handle :width
     3209               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3210             no-error .
     3211           if error-status :error
     3212           or error-status :get-message(1) <> ""
     3213           then do:
     3214             undo move_block, retry move_block .
     3215           end.
     3216         end.
     3217         assign
     3218           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3219           no-error .
     3220         if error-status :error
     3221         or error-status :get-message(1) <> ""
     3222         then do:
     3223           undo move_block, retry move_block.
     3224         end.
     3225         assign
     3226           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3227         no-error .
     3228         if error-status :error
     3229         or error-status :get-message(1) <> ""
     3230         then do:
     3231           undo move_block, retry move_block.
     3232         end.
     3233         if frame Dialog-Frame :scrollable = true
     3234         then do:
     3235           assign
     3236             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3237           no-error .
     3238           if error-status :error
     3239           or error-status :get-message(1) <> ""
     3240           then do:
     3241             undo move_block, retry move_block.
     3242           end.
     3243         end.
     3244       end.
     3245       if p-move-resize
     3246       then do:
     3247         run diasize_position-resize-button in this-procedure .
     3248       end.
     3249       if v-diasize-wndstore = true
     3250       then do:
     3251         if connected("ub") = true
     3252         then do:
     3253           define variable v-cntxt-db-num        as integer   no-undo .
     3254           define variable v-cntxt-userid        as character no-undo .
     3255           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3256                                             , OUTPUT v-cntxt-userid
     3257                                             ) .
     3258           run gbl/wndsizew.p
     3259             (input  v-cntxt-db-num
     3260             ,input  v-cntxt-userid
     3261             ,input  v-diasize-proc-name
     3262             ,input  'width':u
     3263             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3264             ) .
     3265         end.
     3266       end.
     3267     end.
     3268     assign
     3269       v-diasize-change-size = false
     3270     .
     3271   end procedure.
     3272   procedure diasize_set-width :
     3273     define input  parameter p-new-width  as decimal   no-undo .
     3274     define input  parameter p-move-resize as logical   no-undo .
     3275     do
     3276     on error undo, return error return-value
     3277     :
     3278       run diasize_change-width in this-procedure
     3279         (input  (p-new-width - frame Dialog-Frame :width)
     3280         ,input  p-move-resize
     3281         ) .
     3282     end.
     3283   end procedure.
     3284   procedure diasize_position-resize-button :
     3285     do with frame Dialog-Frame
     3286     :
     3287       hide v-diasize-resize-button .
     3288       assign
     3289         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3290                     - 1
     3291                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3292         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3293                     - 1
     3294                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3295       .
     3296       view v-diasize-resize-button .
     3297     end.
     3298   end procedure.
     3299   on alt-right anywhere
     3300   do:
     3301     run diasize_change-width in this-procedure
     3302       (input 1
     3303       ,input true
     3304       ) .
     3305     return no-apply .
     3306   end.
     3307   on alt-left anywhere
     3308   do:
     3309     run diasize_change-width in this-procedure
     3310       (input -1
     3311       ,input true
     3312       ) .
     3313     return no-apply .
     3314   end.
     3315   on alt-down anywhere
     3316   do:
     3317     run diasize_change-height in this-procedure
     3318       (input 1
     3319       ,input true
     3320       ) .
     3321     return no-apply .
     3322   end.
     3323   on alt-up anywhere
     3324   do:
     3325     run diasize_change-height in this-procedure
     3326       (input -1
     3327       ,input true
     3328       ) .
     3329     return no-apply .
     3330   end.
     3331   on alt-enter of frame Dialog-Frame
     3332   do:
     3333     run diasize_maximize in this-procedure
     3334       (input  ?
     3335       ).
     3336     return no-apply .
     3337   end.
     3338   procedure diasize_end-move :
     3339     do
     3340     on error undo, return error return-value
     3341     :
     3342       define variable v-row-delta as decimal   no-undo .
     3343       define variable v-col-delta as decimal   no-undo .
     3344       define variable v-new-row as decimal   no-undo .
     3345       define variable v-new-col as decimal   no-undo .
     3346       assign
     3347         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3348         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3349       .
     3350       assign
     3351         v-row-delta = v-new-row - frame Dialog-Frame :height
     3352         v-col-delta = v-new-col - frame Dialog-Frame :width
     3353       .
     3354       run diasize_change-height in this-procedure
     3355         (input v-row-delta
     3356         ,input true
     3357         ) .
     3358       run diasize_change-width in this-procedure
     3359         (input v-col-delta
     3360         ,input true
     3361         ) .
     3362     end.
     3363   end procedure.
     3364   procedure diasize_maximize :
     3365     define input  parameter p-action as logical   no-undo .
     3366     do
     3367     on error undo, return error return-value
     3368     :
     3369       if p-action = ?
     3370       then do:
     3371         if v-diasize-need-maximize = true
     3372         then do:
     3373           assign
     3374             p-action = true
     3375           .
     3376         end.
     3377         else do:
     3378           assign
     3379             p-action = false
     3380           .
     3381         end.
     3382       end.
     3383       if p-action = true
     3384       then do:
     3385         run diasize_change-height in this-procedure
     3386           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3387               - frame Dialog-Frame :height-chars
     3388           ,input true
     3389           ) .
     3390         run diasize_change-width in this-procedure
     3391           (input session :width-chars
     3392               - frame Dialog-Frame :width-chars
     3393           ,input true
     3394           ) .
     3395         assign
     3396           v-diasize-need-maximize = false
     3397         .
     3398       end.
     3399       else do:
     3400         run diasize_change-width in this-procedure
     3401           (input v-diasize-orig-frame-width
     3402               - frame Dialog-Frame :width-chars
     3403           ,input true
     3404           ) .
     3405         run diasize_change-height in this-procedure
     3406           (input v-diasize-orig-frame-height
     3407               - frame Dialog-Frame :height-chars
     3408           ,input true
     3409           ) .
     3410         assign
     3411           v-diasize-need-maximize = true
     3412         .
     3413       end.
     3414     end.
     3415   end procedure.
     3416   procedure diasize_restore-orig-size :
     3417     do
     3418     on error undo, return error return-value
     3419     :
     3420       assign
     3421         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3422         v-diasize-current-frame-height = frame Dialog-Frame :height
     3423       .
     3424       run diasize_set-height in this-procedure
     3425         (input  v-diasize-orig-frame-height
     3426         ,input  true
     3427         ) .
     3428       run diasize_set-width in this-procedure
     3429         (input  v-diasize-orig-frame-width
     3430         ,input  true
     3431         ) .
     3432     end.
     3433   end procedure.
     3434   procedure diasize_restore-current-size :
     3435     do
     3436     on error undo, return error return-value
     3437     :
     3438       run diasize_set-height in this-procedure
     3439         (input  v-diasize-current-frame-height
     3440         ,input  true
     3441         ) .
     3442       run diasize_set-width in this-procedure
     3443         (input  v-diasize-current-frame-width
     3444         ,input  true
     3445         ) .
     3446     end.
     3447   end procedure.
     3448   procedure diasize_set-browse-handle :
     3449     define input  parameter p-browse-handle as handle   no-undo .
     3450     define buffer buf_temp-browse-handle for temp-browse-handle .
     3451     do
     3452     on error undo, return error return-value
     3453     :
     3454       assign
     3455         v-diasize-browse-handle = p-browse-handle
     3456       .
     3457       for each buf_temp-browse-handle
     3458       on error undo, return error return-value
     3459       :
     3460         delete buf_temp-browse-handle .
     3461       end.
     3462     end.
     3463   end procedure.
     3464   procedure diasize_add_browse :
     3465     define input  parameter p-browse-type   as character no-undo .
     3466     define input  parameter p-browse-handle as handle    no-undo .
     3467     define buffer buf_temp-browse-handle for temp-browse-handle .
     3468     do
     3469     on error undo, return error return-value
     3470     :
     3471       assign
     3472         v-diasize-browse-number = v-diasize-browse-number + 1
     3473       .
     3474       create buf_temp-browse-handle .
     3475       assign
     3476         buf_temp-browse-handle.browse-type   = p-browse-type
     3477         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3478         buf_temp-browse-handle.browse-handle = p-browse-handle
     3479       .
     3480     end.
     3481   end procedure.
     3482   procedure diasize_init :
     3483     define variable v-default-value    as logical   no-undo .
     3484     define variable v-restore-saved    as logical   no-undo .
     3485     define variable v-resize-value-str as character no-undo .
     3486     do
     3487     on error undo, return error return-value
     3488     :
     3489       do with frame Dialog-Frame
     3490       :
     3491         assign
     3492           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3493           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3494           v-diasize-browse-handle     = browse br-clients :handle
     3495         .
     3496         create button v-diasize-resize-button
     3497         assign
     3498           parent        = frame Dialog-Frame :first-child
     3499           label         = "s"
     3500           height-pixels = 16
     3501           width-pixels  = 16
     3502           visible       = true
     3503           sensitive     = true
     3504           movable       = true
     3505           triggers:
     3506             on end-move persistent run diasize_end-move in this-procedure .
     3507           end triggers.
     3508         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3509         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3510         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3511         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3512         assign
     3513           v-diasize-wndmax = false
     3514         .
     3515         if connected("ub") = true
     3516         then do:
     3517           define variable v-cntxt-db-num        as integer   no-undo .
     3518           define variable v-cntxt-userid        as character no-undo .
     3519           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3520                                             , OUTPUT v-cntxt-userid
     3521                                             ) .
     3522           run gbl/wndpar_r.p
     3523             (input  v-cntxt-db-num
     3524             ,input  v-cntxt-userid
     3525             ,input  'wndmax':U
     3526             ,output v-diasize-wndmax
     3527             ,output v-default-value
     3528             ) .
     3529         end.
     3530         assign
     3531           v-diasize-wndstore = false
     3532         .
     3533         if connected("ub") = true
     3534         then do:
     3535           run gbl/wndpar_r.p
     3536             (input  v-cntxt-db-num
     3537             ,input  v-cntxt-userid
     3538             ,input  'wndstore':U
     3539             ,output v-diasize-wndstore
     3540             ,output v-default-value
     3541             ) .
     3542         end.
     3543         assign
     3544           v-diasize-proc-name = entry(1, program-name(2), '.')
     3545         .
     3546         if v-diasize-wndstore = true
     3547         then do:
     3548           assign
     3549             v-restore-saved = false
     3550           .
     3551           if connected("ub") = true
     3552           then do:
     3553             run gbl/wndsizer.p
     3554               (input  v-cntxt-db-num
     3555               ,input  v-cntxt-userid
     3556               ,input  v-diasize-proc-name
     3557               ,input  'height':u
     3558               ,output v-resize-value-str
     3559               ) .
     3560             if v-resize-value-str <> '':U
     3561             then do:
     3562               run diasize_change-height in this-procedure
     3563                 (input  integer(v-resize-value-str)
     3564                 ,input  true
     3565                 ) .
     3566               assign
     3567                 v-restore-saved = true
     3568               .
     3569             end.
     3570           end.
     3571           if connected("ub") = true
     3572           then do:
     3573             run gbl/wndsizer.p
     3574               (input  v-cntxt-db-num
     3575               ,input  v-cntxt-userid
     3576               ,input  v-diasize-proc-name
     3577               ,input  'width':u
     3578               ,output v-resize-value-str
     3579               ) .
     3580             if v-resize-value-str <> '':U
     3581             then do:
     3582               run diasize_change-width in this-procedure
     3583                 (input  integer(v-resize-value-str)
     3584                 ,input  true
     3585                 ) .
     3586               assign
     3587                 v-restore-saved = true
     3588               .
     3589             end.
     3590           end.
     3591           if v-restore-saved <> true
     3592           then do:
     3593             if v-diasize-wndmax = true
     3594             then do:
     3595               run diasize_maximize in this-procedure
     3596                 (input  true
     3597                 ) .
     3598             end.
     3599           end.
     3600         end.
     3601         else do:
     3602           if v-diasize-wndmax = true
     3603           then do:
     3604             run diasize_maximize in this-procedure
     3605               (input  true
     3606               ) .
     3607           end.
     3608         end.
     3609       end.
     3610     end.
     3611   end procedure.
     3612   procedure diasize_need-full-display :
     3613     define output parameter p-need-full-display as logical   no-undo .
     3614     do
     3615     on error undo, return error return-value
     3616     :
     3617       assign
     3618         p-need-full-display = v-diasize-need-full-display
     3619       .
     3620       assign
     3621         v-diasize-need-full-display = false
     3622       .
     3623     end.
     3624   end procedure.
     3625   procedure get-context :
     3626      define output parameter p-db-num as integer          no-undo.
     3627      define output parameter p-user-id as character        no-undo.
     3628      define variable v-login               as character    no-undo.
     3629      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3630      define buffer buf_user-login  for ub.user-login .
     3631      do
     3632      on error undo, return error
     3633      :
     3634            FIND FIRST buf_sys-ctrl no-lock.
     3635            ASSIGN
     3636               v-login = USERID("ub")
     3637               p-db-num = buf_sys-ctrl.db-num
     3638            .
     3639            FIND FIRST buf_user-login
     3640                 WHERE buf_user-login.db-num = p-db-num
     3641                   AND buf_user-login.user-login = v-login
     3642                 no-lock
     3643                 no-error
     3644                 .
     3645            IF AVAILABLE buf_user-login
     3646            THEN DO:
     3647               assign
     3648                  p-user-id = buf_user-login.user-id
     3649               .
     3650            END.
     3651      end.
     3652   end procedure.
     3653       run diasize_init in this-procedure .
     3654   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3655   procedure set-filter-name :
     3656   define input parameter p-filter-name as character no-undo .
