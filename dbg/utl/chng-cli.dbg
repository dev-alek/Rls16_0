        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-install as logical no-undo init no .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: chng-cli.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/chng-cli.p $":U .
        9   define variable vss-description as character no-undo init "Установка признаков клиентов: поставщик, производитель и др.".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define  temp-table temp-host no-undo
       81     field host-code like ub.store.host-code
       82     index xpk host-code
       83   .
       84   define  temp-table temp-obj no-undo
       85     field obj-type  like ub.clients.obj-type
       86     field obj-code  like ub.clients.obj-code
       87     field host-code like ub.store.host-code
       88     field db-num    like ub.clients.db-num
       89     index xpk  obj-type obj-code
       90     index xie1 host-code
       91     index xie2 db-num host-code
       92   .
       93   procedure init-temphost:
       94     define buffer buf_store   for ub.store .
       95     define buffer buf_shop    for ub.shop .
       96     define buffer buf_clients for ub.clients .
       97     define buffer buf_db for ub.db .
       98     define buffer buf_temp-host for temp-host .
       99     define buffer buf_temp-obj for temp-obj .
      100     do
      101     on error undo, return error return-value
      102     :
      103       for each buf_store
      104       on error undo, return error
      105       :
      106         find first buf_temp-host
      107           where buf_temp-host.host-code = buf_store.host-code
      108           no-error .
      109         if not available buf_temp-host
      110         then do:
      111           create buf_temp-host .
      112           assign
      113             buf_temp-host.host-code = buf_store.host-code
      114           .
      115         end.
      116         find first buf_clients no-lock
      117           where buf_clients.obj-type = 'скл':U
      118             and buf_clients.obj-code = buf_store.obj-code
      119           no-error .
      120         if not available buf_clients
      121         then do:
      122           message
      123             "Ошибка при поиске клиента" skip
      124             "Клиент" 'скл':U buf_store.obj-code skip
      125             view-as alert-box error .
      126           undo, return error .
      127         end.
      128         create buf_temp-obj .
      129         assign
      130           buf_temp-obj.obj-type  = 'скл':U
      131           buf_temp-obj.obj-code  = buf_store.obj-code
      132           buf_temp-obj.host-code = buf_store.host-code
      133           buf_temp-obj.db-num    = buf_clients.db-num
      134         .
      135       end.
      136       for each buf_shop
      137       on error undo, return error
      138       :
      139         find first buf_temp-host
      140           where buf_temp-host.host-code = buf_shop.host-code
      141           no-error .
      142         if not available buf_temp-host
      143         then do:
      144           create buf_temp-host .
      145           assign
      146             buf_temp-host.host-code = buf_shop.host-code
      147           .
      148         end.
      149         find first buf_clients no-lock
      150           where buf_clients.obj-type = 'маг':U
      151             and buf_clients.obj-code = buf_shop.obj-code
      152           no-error .
      153         if not available buf_clients then do:
      154           message
      155             "Ошибка при поиске клиента" skip
      156             "Клиент" 'маг':U buf_shop.obj-code skip
      157             view-as alert-box error .
      158           undo, return error .
      159         end.
      160         create buf_temp-obj .
      161         assign
      162           buf_temp-obj.obj-type  = 'маг':U
      163           buf_temp-obj.obj-code  = buf_shop.obj-code
      164           buf_temp-obj.host-code = buf_shop.host-code
      165           buf_temp-obj.db-num    = buf_clients.db-num
      166         .
      167       end.
      168     end.
      169   end.
      170   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   procedure cur-time :
      172      define output parameter p-today as date      no-undo .
      173      define output parameter p-time  as integer   no-undo .
      174     do
      175     on error undo, return error
      176     :
      177       define variable v-date1 as date      no-undo .
      178       define variable v-date2 as date      no-undo .
      179       define variable v-time  as integer   no-undo .
      180       assign
      181         v-date1 = today
      182         v-time  = time
      183         v-date2 = today
      184       .
      185       if v-date1 <> v-date2
      186       then do:
      187         assign
      188           v-date1 = today
      189           v-time  = v-time
      190         .
      191       end.
      192       assign
      193         p-today = v-date1
      194         p-time  = v-time
      195       .
      196     end.
      197   end.
      198   function cur-time-date returns character
      199   :
      200     return string(today, '99/99/9999':U) .
      201   end.
      202   function cur-time-mjd returns decimal
      203   :
      204     define variable v-date as date      no-undo .
      205     define variable v-time as integer   no-undo .
      206     run cur-time in this-procedure
      207       (output v-date
      208       ,output v-time
      209       ) .
      210     return integer(v-date) - 2400002 + (v-time / 86400) .
      211   end.
      212   function cur-time-get-ending-index returns integer
      213   (input p-number as integer
      214   )
      215   :
      216     if p-number < 0
      217     or p-number = ?
      218     then do:
      219       return 1 .
      220     end.
      221     define variable v-rest as integer   no-undo .
      222     assign
      223       p-number = p-number modulo 100
      224     .
      225     if p-number < 20
      226     then do:
      227       assign
      228         v-rest = p-number
      229       .
      230     end.
      231     else do:
      232       assign
      233         v-rest = p-number modulo 10
      234       .
      235     end.
      236     case v-rest :
      237       when 1
      238       then do:
      239         return 2 .
      240       end.
      241       when 2 or
      242       when 3 or
      243       when 4
      244       then do:
      245         return 3 .
      246       end.
      247       otherwise do:
      248         return 1 .
      249       end.
      250     end case .
      251   end.
      252   procedure cur-time-mjd-to-date :
      253      define input  parameter i-mjd-diff as decimal no-undo.
      254      define output parameter o-Date     as date    no-undo.
      255      define output parameter o-Time     as integer no-undo.
      256      define variable v-day-number as integer   no-undo .
      257      if    i-mjd-diff < 0
      258         or i-mjd-diff = ?
      259      then do:
      260         return "?" .
      261      end.
      262      assign
      263         v-day-number = truncate(i-mjd-diff,0).
      264         o-Date = date(v-day-number + 2400002).
      265         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      266     .
      267   end.
      268   function cur-time-mjd-to-string returns character
      269   (input p-mjd-diff as decimal
      270   )
      271   :
      272     define variable v-day-number as integer   no-undo .
      273     define variable v-seconds    as integer   no-undo .
      274     define variable v-hour       as integer   no-undo .
      275     define variable v-min        as integer   no-undo .
      276     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      277     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      278     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      279     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      280     if p-mjd-diff < 0
      281     or p-mjd-diff = ?
      282     then do:
      283       return "?" .
      284     end.
      285     assign
      286       v-day-number = integer(truncate(p-mjd-diff,0))
      287       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      288     .
      289     if v-seconds > 86400
      290     then do:
      291       assign
      292         v-seconds = 86400 - 1
      293       .
      294     end.
      295     if v-seconds < 0
      296     then do:
      297       assign
      298         v-seconds = 0
      299       .
      300     end.
      301     assign
      302       v-hour = truncate(v-seconds / 3600, 0)
      303     .
      304     assign
      305       v-seconds = v-seconds modulo 3600
      306     .
      307     assign
      308       v-min = truncate(v-seconds / 60, 0)
      309     .
      310     assign
      311       v-seconds = v-seconds modulo 60
      312     .
      313     return
      314         (if v-day-number <> 0
      315           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      316           else ""
      317         )
      318       + (if v-day-number <> 0 or v-hour <> 0
      319           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      320           else ""
      321         )
      322       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      323           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      324           else ""
      325         )
      326       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      327       .
      328   end.
      329   function cur-time-string returns character
      330   :
      331     define variable v-date as date      no-undo .
      332     define variable v-time as integer   no-undo .
      333     run cur-time in this-procedure
      334       (output v-date
      335       ,output v-time
      336       ) .
      337     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      338   end.
      339   function cur-time-string-sec returns character
      340   :
      341     define variable v-date as date      no-undo .
      342     define variable v-time as integer   no-undo .
      343     run cur-time in this-procedure
      344       (output v-date
      345       ,output v-time
      346       ) .
      347     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      348   end.
      349   function cur-time-custom  returns character
      350   (input p-prefix as character
      351   ,input p-date-format as character
      352   ,input p-delimiter as character
      353   ,input p-time-format as character
      354   ,input p-suffix as character
      355   )
      356   :
      357     define variable v-date as date      no-undo .
      358     define variable v-time as integer   no-undo .
      359     run cur-time in this-procedure
      360       (output v-date
      361       ,output v-time
      362       ) .
      363     return
      364       p-prefix
      365       + string(v-date, p-date-format)
      366       + p-delimiter
      367       + string(v-time, p-time-format)
      368       + p-suffix
      369       .
      370   end.
      371   function cur-time-print  returns character
      372   :
      373     define variable v-date as date      no-undo .
      374     define variable v-time as integer   no-undo .
      375     run cur-time in this-procedure
      376       (output v-date
      377       ,output v-time
      378       ) .
      379     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      380   end.
      381   function cur-time-datetime returns datetime
      382   :
      383     define variable v-char as character no-undo .
      384     define variable v-datetime as datetime no-undo .
      385     v-char = cur-time-string().
      386     v-datetime = datetime(v-char).
      387     return  v-datetime.
      388   end.
      389   function cur-time-string-msec returns character
      390   :
      391     define variable v-date as datetime  no-undo .
      392     v-date = now.
      393     return string(v-date) .
      394   end.
      395   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   define new global shared variable g#lib-nws as handle no-undo .
      398   procedure clientsh_write-clients-proc  :
      399   define parameter buffer buf_clients for ub.clients .
      400   define input parameter p-source-type like ub.c-cli-hist.source-type no-undo .
      401   define input parameter p-source-ref  like ub.c-cli-hist.source-ref no-undo .
      402   define variable v-date as date      no-undo.
      403   define variable v-time  as integer   no-undo.
      404   define buffer buf_c-cli-hist for ub.c-cli-hist.
      405   define buffer buf_c-clients for ub.c-clients.
      406     do
      407     on error undo, return error
      408     :
      409       if not available buf_clients then do:
      410         message
      411           vss-workfile vss-revision vss-description skip
      412           "Ошибка задания входных параметров" skip
      413           "Не определен контрагент" skip
      414           view-as alert-box error .
      415         undo, return error .
      416       end.
      417       if g#news then do:
      418         define variable v-send as integer no-undo .
      419         define variable v-subject as character no-undo .
      420         case buf_clients.obj-type:
      421           when 'орг':U then v-subject =  'firm':U.
      422           when 'чел':U then v-subject =  'person':U.
      423           when 'маг':U then v-subject =  'shop':U.
      424           when 'скл':U then v-subject =  'store':U.
      425         end case.
      426         v-send = integer('0':U).
      427   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      429     (input  g#db-num
      430     ,input  v-subject
      431     ,input  0
      432     ,input  '':U
      433     ,input  0
      434     ,input  '':U
      435     ,input  '':U
      436     ,input  '':U
      437     ,input  0
      438     ,input  0
      439     ,input  0
      440     ,input  'nws-to-hist'
      441     ,output v-send
      442     ) no-error .
      443         if v-send < 0 then return.
      444       end.
      445       run cur-time in this-procedure(output v-date, output v-time).
      446       create buf_c-clients.
      447       buffer-copy buf_clients to buf_c-clients
      448       assign
      449       buf_c-clients.obj-code           = buf_clients.obj-code
      450       buf_c-clients.obj-type           = buf_clients.obj-type
      451       buf_c-clients.chip-num           = next-value (s-cli-chip, ub)
      452       buf_c-clients.corr-time          = v-time
      453       buf_c-clients.corr-user-db-num   = g#db-num
      454       buf_c-clients.corr-user-name     = (if g#news
      455                                           then (chr(4) +  'СПН':U)
      456                                           else (if g#esys
      457                                                 then (chr(4) +  'ВС':U)
      458                                                 else g#userid)
      459                                           )
      460       buf_c-clients.corr-date          = v-date
      461       .
      462       create buf_c-cli-hist.
      463       buffer-copy buf_c-clients to buf_c-cli-hist
      464       assign
      465       buf_c-cli-hist.action =  integer('2':U)
      466       buf_c-cli-hist.subject = 'clients':U
      467       buf_c-cli-hist.host-code = (if buf_clients.obj-type = 'орг':U
      468                                   and
      469                                   can-find(first ub.sysconf no-lock where
      470                                                     ub.sysconf.host-code = buf_clients.obj-code)
      471                                   then buf_clients.obj-code
      472                                   else 0)
      473       buf_c-cli-hist.is-news = g#news
      474       buf_c-cli-hist.source-type = p-source-type
      475       buf_c-cli-hist.source-ref = p-source-ref
      476       .
      477     end.
      478   end procedure.
      479   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   procedure set-cli :
      481     do
      482     on error undo, return error return-value
      483     :
      484       define input parameter p-trn-doc-recid as recid no-undo .
      485       define variable vss-description as character no-undo init "$Workfile$ Установка признаков клиента при закрытии документов" .
      486       define buffer buf_trn-doc for ub.trn-doc .
      487       define buffer buf_clients for ub.clients .
      488       define variable v-cons-pay like ub.trn-doc.pay-code no-undo .
      489       find first buf_trn-doc no-lock
      490         where recid(buf_trn-doc) = p-trn-doc-recid
      491         no-error .
      492       if not available buf_trn-doc then do:
      493         message
      494           vss-workfile vss-revision vss-description skip
      495           "Ошибка задания входных параметров" skip
      496           "Не найден документ" skip
      497           "Код записи документ (recid)" p-trn-doc-recid skip
      498           view-as alert-box error .
      499         undo, return error .
      500       end.
      501       define variable v-at-value as character no-undo .
      502       define variable v-at-type  as character no-undo .
      503   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      504   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objatext in g#library
      505     (input  buf_trn-doc.obj-type
      506     ,input  buf_trn-doc.obj-code
      507     ,input  'cons-pay=request':u
      508     ,output v-at-value
      509     ,output v-at-type
      510     ) no-error .
      511       if error-status :error
      512       or v-at-type <> 'I':U then do:
      513         message
      514           vss-workfile vss-revision vss-description skip
      515           "Ошибка при определении расширенного атрибута объекта" skip
      516           "Документ" buf_trn-doc.doc-code skip
      517           "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
      518           error-status :get-message(1) skip
      519           return-value skip
      520           view-as alert-box error .
      521         undo, return error .
      522       end.
      523       assign
      524         v-cons-pay = integer(v-at-value)
      525       .
      526       define variable l-sup as logical no-undo .
      527       define variable l-buy as logical no-undo .
      528       assign
      529         l-sup = (lookup(buf_trn-doc.ext-doc-type, 'ie':U ) > 0)
      530         l-buy = (lookup(buf_trn-doc.ext-doc-type, 'ee':U ) > 0)
      531       .
      532       if l-sup = true
      533       or l-buy = true
      534       then do:
      535         find buf_clients no-lock
      536           where buf_clients.obj-type = buf_trn-doc.cli-type
      537             and buf_clients.obj-code = buf_trn-doc.cli-code
      538           no-error .
      539         if error-status :error then do:
      540           message
      541             vss-workfile vss-revision vss-description skip
      542             "Не найден контрагент" skip
      543             "Документ" buf_trn-doc.cli-type buf_trn-doc.cli-code skip
      544             view-as alert-box error .
      545           undo, return error .
      546         end.
      547         define variable l-gds  as logical   no-undo .
      548         define variable l-cons as logical   no-undo .
      549         define variable l-serv as logical   no-undo .
      550         assign
      551           l-gds  = false
      552           l-cons = false
      553           l-serv = false
      554         .
      555         if buf_trn-doc.office = true then do:
      556           assign
      557             l-serv = true
      558           .
      559         end.
      560         else do:
      561           if buf_trn-doc.purch-code = v-cons-pay then do:
      562             assign
      563               l-cons = true
      564             .
      565           end.
      566           else do:
      567             assign
      568               l-gds = true
      569             .
      570           end.
      571         end.
      572         if l-sup then do:
      573           if (l-gds  = true and (buf_clients.sup-gds  <> true) )
      574           or (l-cons = true and (buf_clients.sup-cons <> true) )
      575           or (l-serv = true and (buf_clients.sup-serv <> true) )
      576           then
      577           do transaction
      578           on error undo, return error return-value
      579           :
      580             find current buf_clients exclusive-lock .
      581             run clientsh_write-clients-proc in this-procedure  (
      582                                                          buffer buf_clients
      583                                                         ,input (if g#news then 'db':U else 'trn-doc':U)
      584                                                         ,input (if g#news then string(g#news-source-db) else buf_trn-doc.doc-code)
      585                                                         ) .
      586             assign
      587               buf_clients.sup-gds  = buf_clients.sup-gds  or l-gds
      588               buf_clients.sup-cons = buf_clients.sup-cons or l-cons
      589               buf_clients.sup-serv = buf_clients.sup-serv or l-serv
      590             .
      591           end.
      592         end.
      593         if l-buy then do:
      594           if (l-gds  = true and (buf_clients.buy-gds  <> true) )
      595           or (l-cons = true and (buf_clients.buy-cons <> true) )
      596           or (l-serv = true and (buf_clients.buy-serv <> true) )
      597           then
      598           do transaction
      599           on error undo, return error return-value
      600           :
      601             find current buf_clients exclusive-lock .
      602             run clientsh_write-clients-proc in this-procedure  (
      603                                                          buffer buf_clients
      604                                                         ,input (if g#news then 'db':U else 'trn-doc':U)
      605                                                         ,input (if g#news then string(g#news-source-db) else buf_trn-doc.doc-code)
      606                                                         ) .
      607             assign
      608               buf_clients.buy-gds  = buf_clients.buy-gds  or l-gds
      609               buf_clients.buy-cons = buf_clients.buy-cons or l-cons
      610               buf_clients.buy-serv = buf_clients.buy-serv or l-serv
      611             .
      612           end.
      613         end.
      614       end.
      615     end.
      616   end procedure.
      617   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618     define variable v-cntxt-db-num        as integer   no-undo .
      619     define variable v-cntxt-userid        as character no-undo .
      620     define variable v-cntxt-level         as character no-undo .
      621     define variable v-cntxt-host-code-obj as integer   no-undo .
      622     define variable v-cntxt-obj-type      as character no-undo .
      623     define variable v-cntxt-obj-code      as integer   no-undo .
      624     define variable v-cntxt-db-num-obj    as integer   no-undo .
      625     define variable v-cntxt-is-admin      as logical   no-undo .
      626   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      627   define variable v-waitfram-action01         as character   no-undo .
      628   define variable v-waitfram-action02         as character   no-undo .
      629   define variable v-waitfram-action03         as character   no-undo .
      630   define variable mWaitFramTextBeg            as character   no-undo.
      631   define variable mWaitFramTextEnd            as character   no-undo.
      632   define variable mWaitFramView               as logical     no-undo.
      633   define variable mWaitProcEvent              as logical     no-undo init yes.
      634   define variable mWaitFramInterval           as integer     no-undo init 1 .
      635   define variable mWaitFramStop               as logical     no-undo.
      636   define variable mWaitFramStopUser           as logical     no-undo.
      637   define variable mWaitFramStopTimeOut        as logical     no-undo.
      638   define variable mWaitFramStartProc          as datetime-tz no-undo.
      639   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      640   define button B-WaitFramStop auto-end-key
      641        label "Стоп"
      642        size 10 by 1 tooltip "Остоновить процесс".
      643   define button B-viewProcInfo
      644        label "Информация"
      645        size 15 by 1 tooltip "Информация о процесс".
      646   define frame waitfram
      647     v-waitfram-action01 format "x(72)" no-label skip
      648     v-waitfram-action02 format "x(72)" no-label skip
      649     v-waitfram-action03 format "x(72)" no-label skip
      650     B-viewProcInfo
      651     B-WaitFramStop at row 4 col 30
      652     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      653     .
      654   define new global shared variable mBatchMode as logical no-undo init ?.
      655   define variable mFramBachModHandle as handle no-undo.
      656   mFramBachModHandle = frame waitfram:handle.
      657   define variable mFameOldVis as logical no-undo.
      658   define variable mVisCUrentVin as logical no-undo.
      659   if session:batch-mode
      660   then
      661      mBatchMode = yes.
      662   if mBatchMode = ? then do:
      663     mVisCUrentVin = current-window:visible.
      664     mFameOldVis = mFramBachModHandle:visible.
      665     mFramBachModHandle:visible  = yes.
      666     mBatchMode = mFramBachModHandle:visible ne yes.
      667     mFramBachModHandle:visible = mFameOldVis.
      668     current-window:visible = mVisCUrentVin.
      669   end.
      670    if  log-manager:logfile-name ne ?
      671     then DO:
      672         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      673         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      674         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      675     end.
      676   on choose of B-WaitFramStop in frame waitfram
      677   do:
      678     mWaitFramStop = yes.
      679     mWaitFramStopUser = yes.
      680   end.
      681   function waitfram-check-timeout returns logical():
      682      define variable vtime as int64 no-undo.
      683      if mWaitFramStopTimeOut
      684      then
      685         return yes.
      686      vtime = ( now - mWaitFramStartProc ) / 1000 .
      687      if     mWaitFramTimeOut ne ?
      688         and mWaitFramTimeOut ne 0
      689         and mWaitFramTimeOut lt vtime
      690      then do:
      691         mWaitFramStopTimeOut = yes.
      692      end.
      693      return mWaitFramStopTimeOut.
      694   end.
      695   procedure waitfram-hide :
      696     if not session:batch-mode
      697     then do
      698     on error undo, return error return-value
      699     :
      700       pause 0 before-hide .
      701       if not mBatchMode then
      702         hide frame waitfram .
      703     if     not mWaitFramView
      704        and mWaitProcEvent
      705     then
      706       process events .
      707     end.
      708   end procedure.
      709   procedure waitfram-show :
      710     define input  parameter p-message as character no-undo .
      711     define variable v-left-margin as integer   no-undo .
      712     if not session:batch-mode
      713     then do
      714     on error undo, return error return-value
      715     :
      716       if length(p-message) <= 70 then do:
      717         assign
      718           v-left-margin = integer((70 - length(p-message)) / 2)
      719         .
      720         assign
      721           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      722         .
      723         assign
      724           v-waitfram-action01 = " "
      725           v-waitfram-action02 = " "
      726                                    + fill(" ", v-left-margin)
      727                                    + p-message
      728           v-waitfram-action03 = " "
      729         .
      730       end.
      731       else do:
      732         define variable vRindex1 as integer no-undo.
      733         define variable vRindex2 as integer no-undo.
      734         vRindex1 = r-index(p-message," ",70).
      735         if vRindex1 = 0
      736         then
      737            vRindex1 = 70.
      738         if length(p-message)  <= vRindex1 + 70 then do:
      739           assign
      740             v-waitfram-action01 = " "
      741             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      742             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      743           .
      744         end.
      745         else do:
      746           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      747           if vRindex2 <= vRindex1
      748           then
      749              vRindex2 = vRindex1 + 70.
      750           assign
      751             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      752             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      753             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      754           .
      755         end.
      756       end.
      757       B-viewProcInfo:visible   in frame waitfram = no.
      758       B-viewProcInfo:sensitive in frame waitfram = no.
      759       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      760       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      761       if  (   mWaitFramView
      762          or  mWaitProcEvent)
      763          and not mBatchMode
      764       then
      765          display
      766             v-waitfram-action01 skip
      767             v-waitfram-action02 skip
      768             v-waitfram-action03 skip
      769          with frame waitfram .
      770       if     mWaitFramView
      771          then do:
      772             if     mWaitFramInterval ne ?
      773                and not mBatchMode
      774             then
      775                wait-for go of frame waitfram pause mWaitFramInterval.
      776          end.
      777          else
      778             if     mWaitProcEvent
      779                and not mBatchMode
      780             then
      781                process events .
      782     end.
      783   end procedure.
      784      procedure waitfram-show-this:
      785         define input  parameter iInterval as int64 no-undo.
      786         define variable vtime as int64 no-undo.
      787         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      788         mWaitFramInterval = iInterval.
      789         run waitfram-show (substitute("&1&2 &3&4" ,
      790                                       mWaitFramTextBeg ,
      791                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      792                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      793                                       mWaitFramTextEnd
      794                                      )
      795                           ).
      796      end.
      797      procedure WaitFramRunPause:
      798         define input  parameter iInterval as dec no-undo.
      799         define variable vStart  as datetime-tz no-undo.
      800         define variable vend    as datetime-tz no-undo.
      801         define variable vint as int64 no-undo.
      802         define variable vOk as logical no-undo.
      803         vStart = now.
      804         vend   = vStart.
      805         publish "WaitFramPause" (iInterval,output vOk).
      806         vend   =  now.
      807         vint = vend - vStart.
      808         vint = iInterval - vint / 1000.
      809         if     not mWaitFramStop
      810            and (   vint > 0
      811                 or (    not vOk
      812                     and iInterval eq ?
      813                     )
      814                 )
      815         then
      816            run waitfram-show-this (iInterval).
      817         vend   =  now.
      818         vint = vend - vStart.
      819         vint = iInterval - vint / 1000.
      820         if     not mWaitFramStop
      821            and vint > 0
      822         then do:
      823            run gbl/pause.p (vint * 1000).
      824         end.
      825         if iInterval ne ?
      826         then
      827            publish "WaitFramStop".
      828         waitfram-check-timeout().
      829      end.
      830      procedure WaitFramWaitFor:
      831         define input  parameter iInterval as dec no-undo.
      832         assign
      833            mWaitFramStartProc   = now
      834            mWaitFramStopUser    = no
      835            mWaitFramStopTimeOut = no
      836         .
      837         block-wait:
      838         do while not mWaitFramStop:
      839            run WaitFramRunPause (iInterval).
      840            if  waitfram-check-timeout()
      841            then do:
      842               leave block-wait.
      843            end.
      844         end.
      845         run waitfram-hide.
      846      end.
      847   procedure waitfram-join :
      848     define input  parameter p-line-1  as character no-undo .
      849     define input  parameter p-line-2  as character no-undo .
      850     define input  parameter p-line-3  as character no-undo .
      851     define output parameter p-message as character no-undo .
      852     do
      853     on error undo, return error return-value
      854     :
      855       assign
      856         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      857                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      858                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      859       .
      860     end.
      861   end procedure.
      862   function waitfram-join-function returns character
      863     (input p-line-1 as character
      864     ,input p-line-2 as character
      865     ,input p-line-3 as character
      866     ).
      867     define variable v-message as character no-undo .
      868     run waitfram-join in this-procedure
      869       (input  p-line-1
      870       ,input  p-line-2
      871       ,input  p-line-3
      872       ,output v-message
      873       ) .
      874     return v-message .
      875   end function .
      876   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      877   define temp-table userobjs_temp-user-obj no-undo
      878     field obj-type as character
      879     field obj-code as integer
      880     index xpk is primary unique obj-type obj-code
      881     .
      882   procedure userobjs_clear :
      883     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      884     do
      885     on error undo, return error return-value
      886     :
      887       for each buf_userobjs_temp-user-obj
      888       on error undo, return error return-value
      889       :
      890         delete buf_userobjs_temp-user-obj .
      891       end.
      892     end.
      893   end .
      894   procedure userobjs_object-count :
      895     define output parameter p-total-count as integer   no-undo .
      896     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      897     do
      898     on error undo, return error return-value
      899     :
      900       assign
      901         p-total-count = 0
      902       .
      903       for each buf_userobjs_temp-user-obj
      904       on error undo, return error return-value
      905       :
      906         assign
      907           p-total-count = p-total-count + 1
      908         .
      909       end.
      910     end.
      911   end.
      912   procedure userobjs_append :
      913      define input  parameter p-obj-type as character no-undo .
      914      define input  parameter p-obj-code as integer   no-undo .
      915     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      916     do
      917     on error undo, return error return-value
      918     :
      919       find first buf_userobjs_temp-user-obj
      920         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      921           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      922         no-error .
      923       if not available buf_userobjs_temp-user-obj
      924       then do:
      925         create buf_userobjs_temp-user-obj .
      926         assign
      927           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      928           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      929         .
      930       end.
      931     end.
      932   end.
      933   procedure userobjs_object-exist :
      934     define output parameter p-object-exist as logical   no-undo .
      935     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      936     do
      937     on error undo, return error return-value
      938     :
      939       find first buf_userobjs_temp-user-obj
      940         no-error .
      941       if not available buf_userobjs_temp-user-obj
      942       then do:
      943         assign
      944           p-object-exist = false
      945         .
      946       end.
      947       else do:
      948         assign
      949           p-object-exist = true
      950         .
      951       end.
      952     end.
      953   end.
      954   procedure userobjs_transfer :
      955     define input  parameter p-callback-handle as handle no-undo .
      956     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      957     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      958     do
      959     on error undo, return error return-value
      960     :
      961       if valid-handle(p-callback-handle) <> true
      962       then do:
      963         message
      964           vss-workfile vss-revision vss-description skip
      965           "Ошибка задания входных параметров" skip
      966           "Неизвестный указатель на процедуру" skip
      967           view-as alert-box error .
      968         undo, return error return-value .
      969       end.
      970       if p-callback-handle :get-signature("userobjs_append") = ""
      971       then do:
      972         message
      973           vss-workfile vss-revision vss-description skip
      974           "Ошибка задания входных параметров" skip
      975           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      976                     ,p-callback-handle :file-name
      977                     ) skip
      978           view-as alert-box error .
      979         undo, return error return-value .
      980       end.
      981       for each buf_userobjs_temp-user-obj
      982       on error undo, return error return-value
      983       :
      984         run userobjs_append in p-callback-handle
      985           (input  buf_userobjs_temp-user-obj.obj-type
      986           ,input  buf_userobjs_temp-user-obj.obj-code
      987           ) .
      988       end.
      989     end.
      990   end procedure.
      991   procedure userobjs_select-one :
      992      define input  parameter parparentproc     as widget-handle no-undo .
      993      define input  parameter p-db-num          as integer   no-undo .
      994      define input  parameter p-user-id         as character no-undo .
      995      define input  parameter p-host-code-obj   as integer   no-undo .
      996      define input  parameter p-obj-type        as character no-undo .
      997      define input  parameter p-obj-code        as integer   no-undo .
      998      define output parameter p-user-select     as logical   no-undo .
      999      define output parameter p-select-obj-type as character no-undo .
     1000      define output parameter p-select-obj-code as character no-undo .
