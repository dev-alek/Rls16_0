     1007         ,input  p-db-num
     1008         ,input  p-user-id
     1009         ,input  p-host-code-obj
     1010         ,input  p-obj-type
     1011         ,input  p-obj-code
     1012         ,INPUT  "b-sel"
     1013         ,output p-user-select
     1014         ,output p-select-obj-type
     1015         ,output p-select-obj-code
     1016         ) .
     1017     end.
     1018   end.
     1019   procedure userobjs_select-many :
     1020     define input  parameter parparentproc   as widget-handle no-undo .
     1021     define input  parameter p-db-num        as integer   no-undo .
     1022     define input  parameter p-user-id       as character no-undo .
     1023     define input  parameter p-host-code-obj as integer   no-undo .
     1024     define input  parameter p-obj-type      as character no-undo .
     1025     define input  parameter p-obj-code      as integer   no-undo .
     1026     define output parameter p-user-select   as logical   no-undo .
