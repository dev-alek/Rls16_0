     1047   procedure thobjs :
     1048      define input        parameter parparentproc     as widget-handle no-undo .
     1049      define input        parameter i-bttns           as character     no-undo .
     1050      define input        parameter i-list-mode       as character     no-undo.
     1051      define input        parameter i-obj-type        as character     no-undo.
     1052      define input        parameter i-db-num          as integer       no-undo.
     1053      define input        parameter i-host-code       as integer       no-undo.
     1054      define input-output parameter p-rid-list        as character     no-undo .
     1055   run ref/thobjs.p
     1056           ( input parparentproc
     1057            ,input  this-procedure :handle
     1058           , input i-bttns
     1059           , input i-list-mode
     1060           , input i-obj-type
     1061           , input i-db-num
     1062           , input i-host-code
     1063           , input-output p-rid-list ) no-error .
     1064   end.
     1065   define variable v-ind as integer no-undo .
     1066   define variable v-num as integer no-undo .
     1067   do
     1068   on error undo, return error
     1069   :
     1070     run init-temphost in this-procedure  .
     1071   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1072     run mainmenu_getcntxt in parparentproc
     1073       (output v-cntxt-db-num
     1074       ,output v-cntxt-userid
     1075       ,output v-cntxt-level
     1076       ,output v-cntxt-host-code-obj
     1077       ,output v-cntxt-obj-type
     1078       ,output v-cntxt-obj-code
     1079       ,output v-cntxt-db-num-obj
     1080       ,output v-cntxt-is-admin
     1081       ) .
     1082     if p-install = true then do:
     1083       assign
     1084         v-num = 1
     1085       .
     1086     end.
     1087     else do:
     1088       run gbl/d-askw.w
     1089         (input "Вопрос"
     1090         ,input "Установка признаков клиентов: поставщик, производитель и др." + chr(10)
     1091                + "на основании складских документов" + chr(10)
     1092                + "trn-doc.ret-supp" + chr(10)
     1093         ,input "|^"
     1094         ,input "Все объекты^confirm|Выбрать объекты|Отмена"
     1095         ,input "|"
     1096             + "|"
     1097             + ""
     1098         ,input 1
     1099         ,input 3
     1100         ,output v-num
     1101         ).
     1102     end.
     1103     case v-num :
     1104       when 1 then do:
     1105         for each temp-obj
     1106         on error undo, return error
     1107         :
     1108           run process-object in this-procedure
     1109             (input temp-obj.obj-type
     1110             ,input temp-obj.obj-code
     1111             ).
     1112         end.
     1113       end.
     1114       when 2 then do:
     1115         define variable rid-list as character no-undo .
     1116         define variable ind      as integer   no-undo .
     1117         define variable v-user-select as logical   no-undo .
     1118   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   run userobjs_select-many in this-procedure
     1120     (input  parparentproc
     1121     ,input  v-cntxt-db-num
     1122     ,input  v-cntxt-userid
     1123     ,input  v-cntxt-host-code-obj
     1124     ,input  v-cntxt-obj-type
     1125     ,input  v-cntxt-obj-code
     1126     ,output v-user-select
     1127     )  .
     1128         if v-user-select <> true
     1129         then do:
     1130           message
     1131             "Объект не выбран"
     1132             view-as alert-box information .
     1133           return .
     1134         end.
     1135         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1136         for each buf_userobjs_temp-user-obj
     1137         on error undo, return error return-value
     1138         :
     1139           run process-object in this-procedure
     1140             (input buf_userobjs_temp-user-obj.obj-type
     1141             ,input buf_userobjs_temp-user-obj.obj-code
     1142             ).
     1143         end.
     1144       end.
     1145       when 3 then do:
     1146         return .
     1147       end.
     1148     end.
     1149     if p-install = false then do:
     1150       message
     1151         "Обработка документов закончена" skip
     1152         "Просмотрено" v-ind "документов" skip
     1153         view-as alert-box information .
     1154     end.
     1155   end.
     1156   procedure process-object :
     1157     define input parameter p-obj-type as character no-undo .
     1158     define input parameter p-obj-code as integer no-undo .
     1159     define variable v-type        as character no-undo .
     1160     do
     1161     on error undo, return error
     1162     :
     1163       run waitfram-show in this-procedure (input "Обработка складских документов. "
     1164         + "Объект " + string(p-obj-type) + " " + string(p-obj-code)
     1165         ).
     1166       for each ub.trn-doc
     1167         where ub.trn-doc.obj-type = p-obj-type
     1168           and ub.trn-doc.obj-code = p-obj-code
     1169       :
     1170         assign
     1171           v-ind = v-ind + 1
     1172         .
     1173         if v-ind mod 10 = 0 then do:
     1174           run waitfram-show in this-procedure (input "Обработка складских документов."
     1175             + " Объект " + string(p-obj-type) + " " + string(p-obj-code)
     1176             + " Обработано " + string(v-ind)
     1177             ).
     1178           process events .
     1179         end.
     1180         run set-cli in this-procedure
     1181           (input recid(ub.trn-doc)
     1182           ) .
     1183       end.
     1184       run waitfram-hide in this-procedure .
     1185     end.
     1186   end.
