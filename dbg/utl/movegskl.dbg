        1   block-level on error undo, throw.
        2   define input parameter p-install as logical no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: movegskl.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/movegskl.p $":U .
        8   define variable vss-description as character no-undo init "Перенос конф.параметров из ub.config в ub.thbj-attr.".
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   define new global shared variable g#library  as handle no-undo .
       14   define new global shared variable g#library2 as handle no-undo .
       15   define   shared variable g#auto as logical no-undo.
       16   define   shared variable g#news as logical no-undo.
       17   define   shared variable g#oxml as logical no-undo.
       18   define   shared variable g#esys as logical no-undo.
       19   define   shared variable g#news-source-db as integer no-undo.
       20   define   shared variable g#esys-source-esys as integer no-undo.
       21   define   shared variable g#db-num as integer   no-undo .
       22   define   shared variable g#userid as character no-undo .
       23   define   shared variable g#passwd as character no-undo .
       24   define variable start-time     as integer   no-undo .
       25   define variable current-time   as integer   no-undo .
       26   define variable v-ind          as integer no-undo .
       27   define variable v-err-count    as integer no-undo .
       28   define variable v-file-name    as char no-undo init "07121306.txt".
       29   def frame a
       30     "Перенос параметров "
       31     v-ind        format "->>>>>>>>9" label "Количество записей" skip
       32     current-time format "->>>>>>>>9" label "Время" skip
       33     with view-as dialog-box side-labels three-d
       34     title "Работа с параметрами"
       35     .
       36   if p-install = false then do:
       37     define variable lok as logical no-undo .
       38     message
       39       vss-description
       40       "Перенос конф.параметров из ub.config в ub.thbj-attr. ( Параметры Складских документов )"
       41        skip
       42       "Продолжить?"
       43       view-as alert-box question buttons yes-no update lok .
       44     if lok <> true then do:
       45       return .
       46     end.
       47   end.
       48   do
       49   on error undo, return error
       50   :
       51   on write of ub.thbj-attr   override do: end.
       52   on delete of ub.thbj-attr  override do: end.
       53   on delete of ub.config     override do: end.
       54     assign
       55       start-time = time
       56     .
       57     view frame a .
       58     for each ub.thbj-attr exclusive-lock where
       59               ub.thbj-attr.upper-prop-code = 'nakl_par':U :
       60         delete ub.thbj-attr .
       61     end.
       62     run cr-proc  (input  'stfactdt':U) .
       63     display v-ind time @ current-time with frame a .
       64     run cr-proc  (input  'type-vat':U) .
       65     display v-ind time @ current-time with frame a .
       66     run cr-proc  (input  'type-slt':U) .
       67     display v-ind time @ current-time with frame a .
       68     run cr-proc  (input  'intprmvq':U) .
       69     display v-ind time @ current-time with frame a .
       70     run cr-proc  (input  'minusprt':U) .
       71     display v-ind time @ current-time with frame a .
       72   end.
       73   if p-install = false then do:
       74       message
       75       vss-description skip
       76       "Утилита завершила работу" skip
       77       "Перенесено параметров" v-ind
       78       view-as alert-box information .
       79     end.
       80   return substitute("Перенесено параметров &1 "
       81                      , v-ind
       82                      ).
       83   procedure cr-proc :
       84   define input  parameter p-code as character no-undo .
       85   define variable v-tmp as logical   no-undo .
       86   define variable v-tmp-int  as integer   no-undo .
       87     do
       88     on error undo, return error return-value
       89     :
       90     for each  ub.config  exclusive-lock where ub.config.param-code  = p-code  and
       91                                        ub.config.db-num = g#db-num
       92                                        :
       93     if ub.config.param-type = 'I'  then do:
       94     assign
       95        v-tmp     = false
       96        v-tmp-int = integer(ub.config.param-value)
       97     .
       98     end.
       99     else do:
      100     assign
      101        v-tmp = logical(ub.config.param-value)
      102        v-tmp-int = 0
      103     .
      104     end.
      105       assign
      106         v-ind        = v-ind + 1
      107         current-time = time - start-time
      108         .
      109          find first ub.thbj-attr exclusive-lock where
      110               ub.thbj-attr.obj-code                    = ub.config.obj-code  and
      111               ub.thbj-attr.obj-type                    = ub.config.obj-type  and
      112               ub.thbj-attr.prop-code                   = "" and
      113               ub.thbj-attr.upper-prop-code             = 'nakl_par':U no-error .
      114               if not available ub.thbj-attr then do:
      115                   create ub.thbj-attr.
      116                   assign
      117                     ub.thbj-attr.obj-code                    = ub.config.obj-code
      118                     ub.thbj-attr.obj-type                    = ub.config.obj-type
      119                     ub.thbj-attr.prop-code                   = ""
      120                     ub.thbj-attr.upper-prop-code             = 'nakl_par':U
      121                     .
      122               end.
      123     find first ub.thbj-attr exclusive-lock where
      124          ub.thbj-attr.obj-code                    = ub.config.obj-code and
      125          ub.thbj-attr.obj-type                    = ub.config.obj-type and
      126          ub.thbj-attr.prop-code                   = p-code             and
      127          ub.thbj-attr.upper-prop-code             = 'nakl_par':U   no-error .
      128      if not available ub.thbj-attr then do:
      129         create ub.thbj-attr.
      130      end.
      131       assign
      132          ub.thbj-attr.obj-code                    = ub.config.obj-code
      133          ub.thbj-attr.obj-type                    = ub.config.obj-type
      134          ub.thbj-attr.prop-code                   = p-code
      135          ub.thbj-attr.upper-prop-code             = 'nakl_par':U
      136          ub.thbj-attr.prop-value-type             = if ub.config.param-type = 'I' then 'integer' else 'logical'
      137          ub.thbj-attr.property-value-logical      = v-tmp
      138          ub.thbj-attr.property-value-integer      = v-tmp-int
      139       .
      140     delete ub.config .
      141     end.
      142     end.
      143   end procedure.
