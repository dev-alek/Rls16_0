        1   block-level on error undo, throw.
        2   define input        parameter parparentproc as widget-handle  no-undo .
        3   define input-output parameter p-version as integer          no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: cdvddown.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/cdvddown.p $":U .
        9   define variable vss-description as character no-undo init "Выгрузка связок событий на кассе с СВ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define buffer bf_cd-video-link      for ub.cd-video-link .
      116   define buffer buf_cd-video-link      for ub.cd-video-link .
      117   define stream st-out .
      118   DEFINE STREAM st-in .
      119   define variable v-str      as character    no-undo.
      120   define variable v-str-enc  as character    no-undo.
      121   define variable v-version    as integer      no-undo.
      122   DEFINE VARIABLE v-count      AS INTEGER   NO-UNDO .
      123   do
      124   on error undo, return error
      125   :
      126      FIND FIRST buf_cd-video-link
      127           EXCLUSIVE-LOCK
      128           NO-ERROR
      129           .
      130      IF NOT AVAILABLE buf_cd-video-link
      131      AND LOCKED buf_cd-video-link
      132      THEN DO:
      133          RETURN ERROR "Список событий в данный момент выгружает другой пользователь".
      134      END.
      135      IMPORT STREAM st-in UNFORMATTED
      136         v-str-enc
      137         .
      138   define variable vss-include-info0 as character format "X(65)" no-undo
      139   initial "@(#)$Workfile$ $Revision$".
      140   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      141     (input  v-str-enc
      142     ,output v-str
      143     )  .
      144      ASSIGN
      145         v-version = INTEGER(v-str)
      146      NO-ERROR.
      147      IF ERROR-STATUS:ERROR
      148      THEN DO:
      149         RETURN ERROR SUBSTITUTE( "Не верный номер версии &1&2&3" , v-str, chr(10), ERROR-STATUS:GET-MESSAGE (1)) .
      150      END.
      151      IF v-version > p-version
      152      THEN DO:
      153         RETURN ERROR SUBSTITUTE( "В файле номер версии №&1 больше текущей №&2", v-version, p-version) .
      154      END.
      155      output stream st-out to "cmp/cd-video.enc" .
      156      ASSIGN
      157         p-version = p-version + 1
      158         v-str = STRING(p-version)
      159      .
      160   define variable vss-include-info1 as character format "X(65)" no-undo
      161   initial "@(#)$Workfile$ $Revision$".
      162     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
      163     (input  v-str
      164     ,output v-str-enc
      165     )  .
      166      PUT stream st-out
      167            UNFORMATTED v-str-enc .
      168      ASSIGN
      169         v-count = 0
      170      .
      171      FOR EACH bf_cd-video-link
      172          no-lock
      173          :
      174            ASSIGN
      175               v-str = SUBSTITUTE( "&1&2&3&4&5"
      176                                 , bf_cd-video-link.event-id
      177                                 , chr(4)
      178                                 , bf_cd-video-link.video-id
      179                                 , chr(4)
      180                                 , bf_cd-video-link.video-event-id
      181                                 )
      182            .
      183   define variable vss-include-info2 as character format "X(65)" no-undo
      184   initial "@(#)$Workfile$ $Revision$".
      185     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
      186     (input  v-str
      187     ,output v-str-enc
      188     )  .
      189            PUT stream st-out
      190                  UNFORMATTED v-str-enc .
      191            ASSIGN
      192               v-count = v-count + 1
      193            .
      194      END.
      195      ASSIGN
      196         v-str = STRING(v-count)
      197      .
      198   define variable vss-include-info3 as character format "X(65)" no-undo
      199   initial "@(#)$Workfile$ $Revision$".
      200     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
      201     (input  v-str
      202     ,output v-str-enc
      203     )  .
      204      PUT stream st-out
      205            UNFORMATTED v-str-enc .
      206   end.
