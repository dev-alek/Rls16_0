        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Интерфейс очистки пользовательских фильтров".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111     define variable v-cntxt-db-num        as integer   no-undo .
      112     define variable v-cntxt-userid        as character no-undo .
      113     define variable v-cntxt-level         as character no-undo .
      114     define variable v-cntxt-host-code-obj as integer   no-undo .
      115     define variable v-cntxt-obj-type      as character no-undo .
      116     define variable v-cntxt-obj-code      as integer   no-undo .
      117     define variable v-cntxt-db-num-obj    as integer   no-undo .
      118     define variable v-cntxt-is-admin      as logical   no-undo .
      119   define input  parameter parparentproc  as handle no-undo .
      120   define variable v-userid as character no-undo .
      121   DEFINE BUTTON b-del
      122        LABEL "&Удалить"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE BUTTON b-exit AUTO-GO
      126        LABEL "&Выход"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE BUTTON B-help
      130        LABEL "Помо&щь"
      131        SIZE 10 BY 1
      132        BGCOLOR 8 .
      133   DEFINE BUTTON b-imp-exp
      134        LABEL "&Имп/Эксп"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON b-sel-user DEFAULT
      138        IMAGE-UP FILE "btn-down-arrow":U
      139        IMAGE-DOWN FILE "btn-down-arrow":U
      140        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      141        LABEL "":L
      142        size 2.5 by 1.08.
      143   DEFINE VARIABLE fi-nik AS CHARACTER FORMAT "X(256)":U
      144        LABEL "Пользователь"
      145        VIEW-AS FILL-IN
      146        SIZE 31 BY 1
      147        FGCOLOR 4  NO-UNDO.
      148   DEFINE VARIABLE tg-filters AS LOGICAL INITIAL no
      149        LABEL "Фильтры"
      150        VIEW-AS TOGGLE-BOX
      151        SIZE 11.13 BY .83 NO-UNDO.
      152   DEFINE VARIABLE tg-usr-flt AS LOGICAL INITIAL no
      153        LABEL "Настройки"
      154        VIEW-AS TOGGLE-BOX
      155        SIZE 11.13 BY .83 NO-UNDO.
      156   DEFINE FRAME Dialog-Frame
      157        b-exit AT ROW 1 COL 1 WIDGET-ID 2
      158        b-imp-exp AT ROW 1 COL 11 WIDGET-ID 6
      159        b-del AT ROW 1 COL 21 WIDGET-ID 16
      160        B-help AT ROW 1 COL 51 WIDGET-ID 12
      161        tg-filters AT ROW 3 COL 2 WIDGET-ID 18
      162        fi-nik AT ROW 4 COL 28 COLON-ALIGNED WIDGET-ID 22
      163        b-sel-user at row 4 col 61.5 WIDGET-ID 24
      164        tg-usr-flt AT ROW 4.17 COL 2 WIDGET-ID 20
      165        SPACE(53.36) SKIP(1.45)
      166       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      167            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      168            TITLE "Удаление фильтров" WIDGET-ID 100.
      169   ASSIGN
      170          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      171          FRAME Dialog-Frame:HIDDEN           = TRUE.
      172   ASSIGN
      173          fi-nik:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      174   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      175   DO:
      176     APPLY "END-ERROR":U TO SELF.
      177   END.
      178   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      179   DO:
      180     assign
      181       tg-filters
      182       tg-usr-flt
      183     .
      184     run proc-delete in this-procedure no-error .
      185     if error-status :error then do:
      186       message
      187         "Ошибка при вызове процедуры удаления фильтров." skip
      188         error-status :get-message(1) skip
      189         error-status :get-message(2) skip
      190         return-value
      191       view-as alert-box information.
      192       return no-apply.
      193     end.
      194   END.
      195   ON CHOOSE OF b-imp-exp IN FRAME Dialog-Frame
      196   DO:
      197     run proc-import-export in this-procedure no-error .
      198     if error-status :error then do:
      199       message
      200         "Ошибка при вызове утилиты импорта-экспорта." skip
      201         error-status :get-message(1) skip
      202         error-status :get-message(2) skip
      203         return-value
      204       view-as alert-box information.
      205       return no-apply.
      206     end.
      207   END.
      208   ON CHOOSE OF b-sel-user IN FRAME Dialog-Frame
      209   DO:
      210     run proc-sel-user in this-procedure no-error .
      211     if error-status :error then do:
      212       assign
      213         fi-nik = ""
      214         fi-nik:private-data = ""
      215       .
      216       return no-apply.
      217     end.
      218   END.
      219   ON VALUE-CHANGED OF tg-usr-flt IN FRAME Dialog-Frame
      220   DO:
      221     assign
      222       tg-usr-flt
      223     .
      224     if tg-usr-flt = yes
      225     then do :
      226       display
      227         fi-nik
      228         b-sel-user
      229       with frame Dialog-Frame.
      230     end.
      231     else do:
      232       hide
      233         fi-nik
      234         b-sel-user
      235       .
      236       assign
      237         fi-nik = ""
      238         fi-nik:private-data = ""
      239       .
      240     end.
      241   END.
      242   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      243   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      244   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      245   on help of frame Dialog-Frame
      246   do:
      247     run gbl/app_help.p
      248       (input this-procedure :file-name
      249       ,input ''
      250       ,input ?
      251       ) no-error.
      252     if error-status :error then do:
      253       message
      254         "Ошибка при вызове помощи"
      255         error-status :get-message(1)
      256         view-as alert-box .
      257     end.
      258   end.
      259   run minbtn-set in this-procedure .
      260   on choose of b-help in frame Dialog-Frame
      261   do:
      262     apply "help":u to frame Dialog-Frame .
      263   end.
      264   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      265   procedure minbtn-set :
      266       do
      267           on error undo, return error return-value
      268           :
      269           define variable ii              as integer       no-undo .
      270           define variable fh              as widget-handle no-undo .
      271           define variable hh              as widget-handle no-undo .
      272           define variable v-h             as handle        extent 4 no-undo .
      273           define variable v-name-button   as character     no-undo .
      274           define variable v-help-old-x    as decimal       no-undo .
      275           define variable v-help-old-y    as decimal       no-undo .
      276           define variable v-help-old-size as decimal       no-undo .
      277           define variable v-frame-width   as decimal       no-undo .
      278           define variable jj              as integer       no-undo .
      279           do
      280               on error undo, return error
      281               :
      282               assign
      283                   v-frame-width = frame Dialog-Frame:width - 0.3
      284                   fh            = frame Dialog-Frame:first-child
      285                   hh            = fh:first-child
      286                   ii            = 1
      287                   .
      288               do while valid-handle(hh):
      289                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      290                   do:
      291                       case lc(hh:name) :
      292                           when "b-help" then
      293                               do:
      294                                   hh:load-image-up("cmp/b-help.bmp":u) .
      295                                   hh:load-image-down("cmp/b-help.bmp":u) .
      296                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      297                                   hh:TOOLTIP = "Помощь" .
      298                                   v-help-old-x = hh:column .
      299                                   v-help-old-y = hh:row    .
      300                                   v-help-old-size = hh:width .
      301                                   hh:width-chars = 2.5 .
      302                               end.
      303                           when "b-print" then
      304                               do:
      305                                   hh:load-image("cmp/b-print.bmp":u) .
      306                                   hh:TOOLTIP = "Печать" .
      307                                   v-h[ii] = hh:handle .
      308                                   ii = ii + 1 .
      309                                   hh:width-chars = 3 .
      310                               end.
      311                           when "b-history" or
      312                           when "b-hist" then
      313                               do:
      314                                   hh:load-image("cmp/b-hist.bmp":u) .
      315                                   hh:TOOLTIP = "История" .
      316                                   v-h[ii] = hh:handle .
      317                                   ii = ii + 1 .
      318                                   hh:width-chars = 3 .
      319                               end.
      320                           when "b-sch" then
      321                               do:
      322                                   hh:load-image("cmp/b-sch.bmp":u) .
      323                                   hh:TOOLTIP = "Установка Фильтра" .
      324                                   v-h[ii] = hh:handle .
      325                                   ii = ii + 1 .
      326                                   hh:width-chars = 3 .
      327                               end.
      328                           when "b-hist-user" then
      329                               do:
      330                                   hh:load-image("cmp/b-hist.bmp":u) .
      331                                   hh:TOOLTIP = "История пользователя" .
      332                                   ii = ii + 1 .
      333                               end.
      334                       end case.
      335                   end.
      336                   hh = hh:next-sibling.
      337               end.
      338               b-help:column = v-frame-width - b-help:width-chars.
      339               jj = 0.
      340               repeat ii = 4 to 1 by -1 :
      341                   if valid-handle (v-h[ii] ) then
      342                   do:
      343                       jj  = jj + 1 .
      344                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      345                       v-h[ii]:row    = v-help-old-y .
      346                   end.
      347               end.
      348           end.
      349       end.
      350   end procedure.
      351   MAIN-BLOCK:
      352   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      353      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      354     RUN my-enable in this-procedure .
      355     WAIT-FOR GO OF FRAME Dialog-Frame.
      356   END.
      357   RUN my-disable.
      358   PROCEDURE disable_UI :
      359     HIDE FRAME Dialog-Frame.
      360   END PROCEDURE.
      361   PROCEDURE enable_UI :
      362     DISPLAY tg-filters fi-nik tg-usr-flt
      363         WITH FRAME Dialog-Frame.
      364     ENABLE b-exit b-del B-help tg-filters fi-nik b-sel-user tg-usr-flt
      365         WITH FRAME Dialog-Frame.
      366     VIEW FRAME Dialog-Frame.
      367   END PROCEDURE.
      368   PROCEDURE my-disable :
      369     run disable_UI in this-procedure .
      370   END PROCEDURE.
      371   PROCEDURE my-enable :
      372     display
      373       tg-filters
      374       tg-usr-flt
      375     with frame Dialog-Frame.
      376     enable
      377       b-exit
      378       b-imp-exp
      379       b-del
      380       b-help
      381       b-sel-user
      382       tg-filters
      383       tg-usr-flt
      384     with frame Dialog-Frame.
      385     hide
      386       fi-nik
      387       b-sel-user
      388     .
      389     view frame Dialog-Frame.
      390   END PROCEDURE.
      391   PROCEDURE proc-delete :
      392   do
      393   on error undo, return error return-value
      394   :
      395     define buffer buf_filter  for ubflt.filter.
      396     define buffer buf_usr-flt for ubflt.usr-flt.
      397     define variable v-i           as integer   no-undo .
      398     define variable v-j           as integer   no-undo .
      399     define variable v-log         as logical   no-undo .
      400     define variable v-user-id     as character no-undo .
      401     define variable v-old-user-id as character no-undo .
      402     define variable v-str         as character no-undo .
      403     if ( tg-filters = no ) and ( tg-usr-flt = no)
      404     then do:
      405       return.
      406     end.
      407     message
      408       "Удалить?" skip
      409       "ВНИМАНИЕ! Предварительно рекомендуется экспортировать фильтры (Имп/Эксп)."
      410     view-as alert-box question buttons yes-no update v-log.
      411     if( v-log = no ) then do:
      412       return.
      413     end.
      414     if ( tg-usr-flt = yes ) then do:
      415       if fi-nik <> "" then do:
      416         message
      417           substitute( "Удалить все настройки для пользователя &1 ?" , fi-nik )
      418         view-as alert-box question buttons yes-no update v-log.
      419       end.
      420       else do:
      421         message
      422           "Пользователь не выбран. Удалить настройки для ВСЕХ пользователей?":U
      423         view-as alert-box question buttons yes-no update v-log.
      424       end.
      425       if( v-log = no ) then do:
      426         return.
      427       end.
      428     end.
      429   if session :set-wait-state( "compiler" ) then.
      430     del-block:
      431     do on error undo del-block, return error return-value
      432     :
      433       for each buf_filter exclusive-lock
      434       :
      435         assign
      436           v-i = v-i + 1
      437         .
      438         delete buf_filter.
      439       end.
      440       if( tg-usr-flt = yes )
      441       then do:
      442         if( fi-nik <> "" ) then do:
      443           assign
      444             v-str = fi-nik:private-data in frame Dialog-Frame
      445           .
      446           if num-entries( v-str , chr(4) ) > 1
      447           then do:
      448             assign
      449               v-user-id     = entry( 1 , v-str , chr(4) )
      450               v-old-user-id = entry( 2 , v-str , chr(4) )
      451             .
      452           end.
      453           for each buf_usr-flt exclusive-lock
      454             where ( buf_usr-flt.user-name = v-user-id ) or
      455                   ( buf_usr-flt.user-name = v-old-user-id and v-old-user-id <> "" )
      456           :
      457             assign
      458               v-j = v-j + 1
      459             .
      460             delete buf_usr-flt.
      461           end.
      462         end.
      463         else do:
      464           for each buf_usr-flt exclusive-lock
      465           :
      466             assign
      467               v-j = v-j + 1
      468             .
      469             delete buf_usr-flt.
      470           end.
      471         end.
      472       end.
      473     end.
      474   if session :set-wait-state( "" ) then.
      475     message
      476       substitute("Фильтров удалено: &1.&2Настроек удалено: &3" , v-i , chr(10), v-j )
      477     view-as alert-box information.
      478   end.
      479   END PROCEDURE.
      480   PROCEDURE proc-import-export :
      481   do
      482   on error undo, return error return-value
      483   :
      484     run utl/exp-imp.w ( input parparentproc ) .
      485   end.
      486   END PROCEDURE.
      487   PROCEDURE proc-sel-user :
      488   do
      489   on error undo, return error return-value
      490   :
      491     define buffer buf_user-account for ub.user-account.
      492     define variable v-user-nik    as character no-undo .
      493     define variable v-selected-userid like ub.user-account.user-id        no-undo .
      494     define variable v-old-userid      like ub.user-account.parent-user-id no-undo .
      495   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      496     run mainmenu_getcntxt in parparentproc
      497       (output v-cntxt-db-num
      498       ,output v-cntxt-userid
      499       ,output v-cntxt-level
      500       ,output v-cntxt-host-code-obj
      501       ,output v-cntxt-obj-type
      502       ,output v-cntxt-obj-code
      503       ,output v-cntxt-db-num-obj
      504       ,output v-cntxt-is-admin
      505       ) .
      506     run str/usersel.p ( input parparentproc
      507                       , input v-cntxt-userid
      508                       , output v-selected-userid
      509                       , output v-old-userid
      510                       ).
      511     find buf_user-account no-lock
      512       where buf_user-account.user-id = v-selected-userid
      513     no-error .
      514     if available buf_user-account then do:
      515       assign
      516         fi-nik = buf_user-account.nik
      517         fi-nik:private-data in frame Dialog-Frame = buf_user-account.user-id + chr(4) + v-old-userid
      518       .
      519       display
      520         fi-nik
      521       with frame Dialog-Frame.
      522     end.
      523   end.
      524   END PROCEDURE.
