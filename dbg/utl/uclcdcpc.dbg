      447   procedure schedule-attr-name :
      448   do
      449     on error undo, return error
      450     :
      451     define input  parameter p-code           as character no-undo .
      452     define output parameter p-type           as character no-undo .
      453     define output parameter p-format         as character no-undo .
      454     define output parameter p-label          as character no-undo .
      455     define output parameter p-user-can-edit  as logical   no-undo .
      456     define output parameter p-output-display as logical   no-undo .
      457     define output parameter p-other          as character no-undo .
      458       if index(p-code, chr(4)) > 0 then do:
      459         p-code = entry(1, p-code, chr(4)).
      460       end.
      461       case p-code :
      462               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      463               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      464               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      465               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      466               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      467               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      468               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      469               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      470               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      471         otherwise do:
      472           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      473         end.
      474       end.
      475     end.
      476   end procedure.
      477   procedure schedule-attr-tooltip :
      478   do
      479     on error undo, return error
      480     :
      481       define input  parameter p-code    as character no-undo .
      482       define output parameter p-tooltip as character no-undo .
      483       define output parameter p-label   as character no-undo .
      484       if index(p-code, chr(4)) > 0 then do:
      485         p-code = entry(1, p-code, chr(4)).
      486       end.
      487       case p-code :
      488               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      489               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      490               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      491               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      492               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      493               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      494               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      495               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      496               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      497         otherwise do:
      498               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      499         end.
      500       end.
      501     end.
      502   end procedure.
      503   procedure schedule-attr-value :
      504   do
      505   on error undo, return error return-value
      506   :
      507   define input parameter  p-cre-db-num as integer    no-undo.
      508   define input parameter  p-task-type  as character  no-undo.
      509   define input parameter  p-task-num   as integer    no-undo.
      510   define input parameter  p-code       as character  no-undo.
      511   define output parameter p-value      as character  no-undo.
      512   define output parameter p-type       as character  no-undo.
      513       define variable v-format         as character no-undo .
      514       define variable v-label          as character no-undo .
      515       define variable v-user-can-edit  as logical   no-undo .
      516       define variable v-output-display as logical   no-undo .
      517       define variable v-other          as character no-undo .
      518       define buffer buf_schedule-attr for ub.schedule-attr.
      519       run schedule-attr-name in this-procedure (
      520             input  p-code
      521           , output p-type
      522           , output v-format
      523           , output v-label
      524           , output v-user-can-edit
      525           , output v-output-display
      526           , output v-other
      527       ) no-error .
      528       if error-status :error
      529       then do:
      530           undo, return error return-value .
      531       end.
      532       if p-code begins ('schd-free-id':U + chr(4))
      533       and entry(2, p-code, chr(4)) = '':U then do:
      534         find first buf_schedule-attr no-lock
      535             where buf_schedule-attr.cre-db-num = p-cre-db-num
      536               and buf_schedule-attr.task-type  = p-task-type
      537               and buf_schedule-attr.task-num   = p-task-num
      538               and buf_schedule-attr.attr-code  begins p-code
      539         no-error .
      540       end.
      541       else do:
      542         find first buf_schedule-attr no-lock
      543             where buf_schedule-attr.cre-db-num = p-cre-db-num
      544               and buf_schedule-attr.task-type  = p-task-type
      545               and buf_schedule-attr.task-num   = p-task-num
      546               and buf_schedule-attr.attr-code  = p-code
      547         no-error .
      548       end.
      549       if available buf_schedule-attr
      550       then do:
      551           assign
      552               p-value = buf_schedule-attr.attr-value
      553           .
      554       end.
      555       else do:
      556         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      557            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      558         end.
      559         else do:
      560           assign
      561               p-value = if p-type = 'L':U then "no":U else ""
      562           .
      563         end.
      564       end.
      565   end.
      566   end procedure.
      567   procedure schedule-attr-write :
      568   do
      569   on error undo, return error
      570   :
      571   define input parameter p-cre-db-num  as integer   no-undo.
      572   define input parameter p-task-type   as character no-undo.
      573   define input parameter p-task-num    as integer   no-undo.
      574   define input parameter p-code        as character no-undo.
      575   define input parameter p-value       as character no-undo.
      576       define variable v-type              as character                no-undo.
      577       define variable v-format            as character                no-undo.
      578       define variable v-label             as character                no-undo.
      579       define variable v-user-can-edit     as logical                  no-undo.
      580       define variable v-output-display    as logical                  no-undo.
      581       define variable v-other             as character                no-undo.
      582       define buffer buf_schedule-attr for ub.schedule-attr .
      583       run schedule-attr-name in this-procedure (
      584             input  p-code
      585           , output v-type
      586           , output v-format
      587           , output v-label
      588           , output v-user-can-edit
      589           , output v-output-display
      590           , output v-other
      591       ) no-error.
      592       if error-status :error
      593       then do:
      594           undo, return error return-value.
      595       end.
      596       find first buf_schedule-attr exclusive-lock
      597            where buf_schedule-attr.cre-db-num = p-cre-db-num
      598              and buf_schedule-attr.task-type  = p-task-type
      599              and buf_schedule-attr.task-num   = p-task-num
      600              and buf_schedule-attr.attr-code  = p-code
      601       no-error.
      602       if not available buf_schedule-attr
      603       then do:
      604           create buf_schedule-attr.
      605           assign
      606             buf_schedule-attr.cre-db-num = p-cre-db-num
      607             buf_schedule-attr.task-type  = p-task-type
      608             buf_schedule-attr.task-num   = p-task-num
      609             buf_schedule-attr.attr-code  = p-code
      610             buf_schedule-attr.attr-value = p-value
      611           .
      612       end.
      613       else do:
      614           assign
      615               buf_schedule-attr.attr-value = p-value
      616           .
      617       end.
      618   end.
      619   end procedure.
      620   procedure schedule-attr-delete :
      621   do
      622   on error undo, return error
      623   :
      624   define input  parameter p-cre-db-num  as integer   no-undo.
      625   define input  parameter p-task-type   as character no-undo.
      626   define input  parameter p-task-num    as integer   no-undo.
      627   define input  parameter p-code        as character no-undo.
      628   define output parameter p-deleted     as logical   no-undo.
      629       define buffer buf_schedule-attr for ub.schedule-attr .
      630       define variable v-type              as character                no-undo.
      631       define variable v-format            as character                no-undo.
      632       define variable v-label             as character                no-undo.
      633       define variable v-user-can-edit     as logical                  no-undo.
      634       define variable v-output-display    as logical                  no-undo.
      635       define variable v-other             as character                no-undo.
      636       run schedule-attr-name in this-procedure (
      637             input p-code
      638           , output v-type
      639           , output v-format
      640           , output v-label
      641           , output v-user-can-edit
      642           , output v-output-display
      643           , output v-other
      644       ) no-error .
      645       if error-status :error
      646       then do:
      647           undo, return error return-value .
      648       end.
      649       find first buf_schedule-attr exclusive-lock
      650            where buf_schedule-attr.cre-db-num = p-cre-db-num
      651              and buf_schedule-attr.task-type  = p-task-type
      652              and buf_schedule-attr.task-num   = p-task-num
      653              and buf_schedule-attr.attr-code  = p-code
      654       no-error.
      655       if not available buf_schedule-attr
      656       then do:
      657           assign
      658               p-deleted = no
      659           .
      660       end.
      661       else do:
      662           delete buf_schedule-attr.
      663           assign
      664               p-deleted = yes
      665           .
      666       end.
      667   end.
      668   end procedure.
      669   procedure schedule-attr-news :
      670   do
      671   on error undo, return error
      672   :
      673       define input  parameter p-code           as character no-undo .
      674       define output parameter p-news           as logical   no-undo .
      675       if index(p-code, chr(4)) > 0 then do:
      676         p-code = entry(1, p-code, chr(4)).
      677       end.
      678       case p-code :
      679               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      680               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      681               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      682               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      683               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      684               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      685               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      686               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      687               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      688         otherwise do:
      689           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      690         end.
      691       end.
      692   end.
      693   end procedure.
      694   procedure schedule-attr-extract-logical :
      695   do
      696   on error undo, return error
      697   :
      698   define input  parameter p-parameter-number   as integer      no-undo.
      699   define input  parameter p-parameter-list     as character    no-undo.
      700   define output parameter p-parameter-value   as logical      no-undo.
      701       if num-entries( p-parameter-list ) > p-parameter-number - 1
      702       then do:
      703           assign
      704               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      705           .
      706       end.
      707       else do:
      708           assign
      709               p-parameter-value   = no
      710           .
      711       end.
      712   end.
      713   end procedure.
      714   procedure schedule-attr-get-free-id :
      715   do
      716   on error undo, return error return-value
      717   :
      718     define input  parameter p-cre-db-num  as integer   no-undo.
      719     define input  parameter p-task-type   as character no-undo.
      720     define input  parameter p-task-num    as integer   no-undo.
      721     define output parameter p-free-id     as character no-undo.
      722     define buffer buf_schedule-attr for ub.schedule-attr.
      723     find first buf_schedule-attr no-lock
      724         where buf_schedule-attr.cre-db-num = p-cre-db-num
      725           and buf_schedule-attr.task-type  = p-task-type
      726           and buf_schedule-attr.task-num   = p-task-num
      727           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      728     no-error .
      729     if available buf_schedule-attr then
      730     assign
      731     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      732     no-error
      733     .
      734   end.
      735   end procedure.
      736   procedure schedule-attr-get-free-props :
      737     define input parameter p-free-id as character no-undo .
      738     define output parameter p-value as character no-undo .
      739     define buffer buf_temp-schedule-free for temp-schedule-free.
      740     do
      741     on error undo, return error return-value
      742     :
      743       find first buf_temp-schedule-free no-lock no-error .
      744       if not available buf_temp-schedule-free then do:
      745         run schedule-attr-fill-free-props in this-procedure .
      746       end.
      747       find first buf_temp-schedule-free where
      748               buf_temp-schedule-free.free-id = p-free-id no-error.
      749       if available buf_temp-schedule-free then do:
      750         assign
      751         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      752                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      753                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      754                   buf_temp-schedule-free.conf-param           + chr(4) +
      755                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      756                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      757                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      758                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      759                   buf_temp-schedule-free.other-info
      760         .
      761       end.
      762       else do:
      763        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      764                              "id произвольной задачи - &5"
      765                              ,vss-workfile
      766                              ,vss-revision
      767                              ,vss-description
      768                              ,chr(10)
      769                              ,p-free-id).
      770       end.
      771     end.
      772   end procedure.
      773   procedure schedule-attr-is-rum-free-id :
      774   define input parameter p-free-id as character no-undo .
      775   define output parameter p-is-rum as logical no-undo .
      776   define buffer buf_temp-schedule-free for temp-schedule-free.
      777   do
      778   on error undo, return error
      779   :
      780       find first buf_temp-schedule-free no-lock no-error .
      781       if not available buf_temp-schedule-free then do:
      782         run schedule-attr-fill-free-props in this-procedure .
      783       end.
      784       find first buf_temp-schedule-free where
      785               buf_temp-schedule-free.free-id = p-free-id no-error.
      786       if available buf_temp-schedule-free
      787       and buf_temp-schedule-free.is-rum
      788       then do:
      789         p-is-rum = yes.
      790       end.
      791   end.
      792   end procedure.
      793   procedure schedule-attr-fill-free-props :
      794   define variable v-path                    as character                no-undo .
      795   DEFINE VARIABLE v-full-path               as character                no-undo .
      796   DEFINE VARIABLE v-file-name               as character                no-undo .
      797   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      798   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      799   define buffer buf_temp-schedule-free for temp-schedule-free.
      800   define variable v-answer as logical no-undo .
      801     do
      802     on error undo, return error substitute("&1 &2 &3&4&5&4"
      803                                           ,vss-workfile
      804                                           ,vss-revision
      805                                           ,vss-description
      806                                           ,chr(10)
      807                                           ,error-status:get-message(1) )
      808     :
      809       run gbl/filename.p (
      810                       input 'cmp/shd-free.d'
      811                     ,output v-full-path
      812                     ,output v-path
      813                     ,output v-file-name
      814                     ,output v-file-name-no-ext
      815                     ,output v-file-name-ext
      816                     ) .
      817       input from value(v-full-path).
      818       repeat :
      819         create buf_temp-schedule-free.
      820         import buf_temp-schedule-free.
      821       END.
      822       input close.
      823       _ff:
      824       for each buf_temp-schedule-free :
      825         if buf_temp-schedule-free.free-id = '':U then do:
      826            delete buf_temp-schedule-free.
      827            next _ff.
      828          end.
      829          run schedule-attr-check-enc in this-procedure (
      830                                                       input  buf_temp-schedule-free.free-id
      831                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      832                                                               buf_temp-schedule-free.proc-param-edit-name +
      833                                                               buf_temp-schedule-free.conf-param +
      834                                                               string(buf_temp-schedule-free.is-gbd) +
      835                                                               string(buf_temp-schedule-free.is-ubd) +
      836                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      837                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      838                                                               string(buf_temp-schedule-free.other-info)
      839                                                               )
      840                                                       ,input  buf_temp-schedule-free.enc-key
      841                                                       ,output v-answer    ) no-error .
      842          if error-status:error
      843          or not v-answer then delete buf_temp-schedule-free.
      844        end.
      845     end.
      846   end procedure.
      847   Function schedule-attr-reverse returns character (str as character).
      848      define variable rev_incl_s as character init "" no-undo .
      849      define variable rev_incl_i as integer no-undo .
      850      define variable rev_incl_l as integer no-undo .
      851      rev_incl_l = length(str).
      852      do rev_incl_i = 1 to rev_incl_l:
      853         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      854      end.
      855      return rev_incl_s.
      856   end.
      857   procedure schedule-attr-check-enc.
      858     define input  parameter p-free-id   as character no-undo .
      859     define input  parameter p-value     as character no-undo .
      860     define input  parameter p-enc-value as character no-undo .
      861     define output parameter p-answer    as logical   no-undo .
      862     define variable tmp         as character no-undo .
      863     define variable v-enc-value as character no-undo .
      864     assign
      865     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      866     .
      867     run schedule-attr-pswd-enc in this-procedure
      868       ( input tmp
      869        ,output v-enc-value
      870       ) no-error .
      871     if error-status:error then do:
      872       message
      873         vss-workfile vss-revision vss-description skip
      874         "Ошибка при вызове процедуры pswd-enc" skip
      875         return-value skip
      876         error-status :get-message(1) skip
      877         view-as alert-box error .
      878       undo, return error .
      879     end.
      880     if v-enc-value = p-enc-value then do:
      881       assign
      882         p-answer = true
      883       .
      884     end.
      885     else do:
      886       assign
      887         p-answer = false
      888       .
      889     end.
      890   end.
      891   procedure schedule-attr-conf-enc.
      892     define input  parameter p-free-id   as character no-undo .
      893     define input  parameter p-value     as character no-undo .
      894     define output parameter p-enc-value as character no-undo .
      895     define variable tmp         as character no-undo .
      896     assign
      897       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      898     .
      899     run schedule-attr-pswd-enc in this-procedure
      900       ( input tmp
      901        ,output p-enc-value
      902       ) no-error .
      903     if error-status:error then do:
      904       message
      905         vss-workfile vss-revision vss-description skip
      906         "Ошибка при вызове процедуры pswd-enc" skip
      907         return-value skip
      908         error-status :get-message(1) skip
      909         view-as alert-box error .
      910       undo, return error .
      911     end.
      912   end procedure.
      913   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      914   procedure schedule-attr-pswd-enc :
      915     define input parameter  pswd     as character no-undo .
      916     define output parameter enc-pswd as character no-undo .
      917     do
      918     on error undo, return error return-value
      919     :
      920       assign
      921         enc-pswd = encode(pswd + string(index(pswd, "k")))
      922       .
      923     end.
      924   end procedure.
      925   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      926   procedure cur-time :
      927      define output parameter p-today as date      no-undo .
      928      define output parameter p-time  as integer   no-undo .
      929     do
      930     on error undo, return error
      931     :
      932       define variable v-date1 as date      no-undo .
      933       define variable v-date2 as date      no-undo .
      934       define variable v-time  as integer   no-undo .
      935       assign
      936         v-date1 = today
      937         v-time  = time
      938         v-date2 = today
      939       .
      940       if v-date1 <> v-date2
      941       then do:
      942         assign
      943           v-date1 = today
      944           v-time  = v-time
      945         .
      946       end.
      947       assign
      948         p-today = v-date1
      949         p-time  = v-time
      950       .
      951     end.
      952   end.
      953   function cur-time-date returns character
      954   :
      955     return string(today, '99/99/9999':U) .
      956   end.
      957   function cur-time-mjd returns decimal
      958   :
      959     define variable v-date as date      no-undo .
      960     define variable v-time as integer   no-undo .
      961     run cur-time in this-procedure
      962       (output v-date
      963       ,output v-time
      964       ) .
      965     return integer(v-date) - 2400002 + (v-time / 86400) .
      966   end.
      967   function cur-time-get-ending-index returns integer
      968   (input p-number as integer
      969   )
      970   :
      971     if p-number < 0
      972     or p-number = ?
      973     then do:
      974       return 1 .
      975     end.
      976     define variable v-rest as integer   no-undo .
      977     assign
      978       p-number = p-number modulo 100
      979     .
      980     if p-number < 20
      981     then do:
      982       assign
      983         v-rest = p-number
      984       .
      985     end.
      986     else do:
      987       assign
      988         v-rest = p-number modulo 10
      989       .
      990     end.
      991     case v-rest :
      992       when 1
      993       then do:
      994         return 2 .
      995       end.
      996       when 2 or
      997       when 3 or
      998       when 4
      999       then do:
     1000         return 3 .
     1001       end.
     1002       otherwise do:
     1003         return 1 .
     1004       end.
     1005     end case .
     1006   end.
     1007   procedure cur-time-mjd-to-date :
     1008      define input  parameter i-mjd-diff as decimal no-undo.
     1009      define output parameter o-Date     as date    no-undo.
     1010      define output parameter o-Time     as integer no-undo.
     1011      define variable v-day-number as integer   no-undo .
     1012      if    i-mjd-diff < 0
     1013         or i-mjd-diff = ?
     1014      then do:
     1015         return "?" .
     1016      end.
     1017      assign
     1018         v-day-number = truncate(i-mjd-diff,0).
     1019         o-Date = date(v-day-number + 2400002).
     1020         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1021     .
     1022   end.
     1023   function cur-time-mjd-to-string returns character
     1024   (input p-mjd-diff as decimal
     1025   )
     1026   :
     1027     define variable v-day-number as integer   no-undo .
     1028     define variable v-seconds    as integer   no-undo .
     1029     define variable v-hour       as integer   no-undo .
     1030     define variable v-min        as integer   no-undo .
     1031     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1032     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1033     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1034     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1035     if p-mjd-diff < 0
     1036     or p-mjd-diff = ?
     1037     then do:
     1038       return "?" .
     1039     end.
     1040     assign
     1041       v-day-number = integer(truncate(p-mjd-diff,0))
     1042       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1043     .
     1044     if v-seconds > 86400
     1045     then do:
     1046       assign
     1047         v-seconds = 86400 - 1
     1048       .
     1049     end.
     1050     if v-seconds < 0
     1051     then do:
     1052       assign
     1053         v-seconds = 0
     1054       .
     1055     end.
     1056     assign
     1057       v-hour = truncate(v-seconds / 3600, 0)
     1058     .
     1059     assign
     1060       v-seconds = v-seconds modulo 3600
     1061     .
     1062     assign
     1063       v-min = truncate(v-seconds / 60, 0)
     1064     .
     1065     assign
     1066       v-seconds = v-seconds modulo 60
     1067     .
     1068     return
     1069         (if v-day-number <> 0
     1070           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1071           else ""
     1072         )
     1073       + (if v-day-number <> 0 or v-hour <> 0
     1074           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1075           else ""
     1076         )
     1077       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1078           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1079           else ""
     1080         )
     1081       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1082       .
     1083   end.
     1084   function cur-time-string returns character
     1085   :
     1086     define variable v-date as date      no-undo .
     1087     define variable v-time as integer   no-undo .
     1088     run cur-time in this-procedure
     1089       (output v-date
     1090       ,output v-time
     1091       ) .
     1092     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1093   end.
     1094   function cur-time-string-sec returns character
     1095   :
     1096     define variable v-date as date      no-undo .
     1097     define variable v-time as integer   no-undo .
     1098     run cur-time in this-procedure
     1099       (output v-date
     1100       ,output v-time
     1101       ) .
     1102     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1103   end.
     1104   function cur-time-custom  returns character
     1105   (input p-prefix as character
     1106   ,input p-date-format as character
     1107   ,input p-delimiter as character
     1108   ,input p-time-format as character
     1109   ,input p-suffix as character
     1110   )
     1111   :
     1112     define variable v-date as date      no-undo .
     1113     define variable v-time as integer   no-undo .
     1114     run cur-time in this-procedure
     1115       (output v-date
     1116       ,output v-time
     1117       ) .
     1118     return
     1119       p-prefix
     1120       + string(v-date, p-date-format)
     1121       + p-delimiter
     1122       + string(v-time, p-time-format)
     1123       + p-suffix
     1124       .
     1125   end.
     1126   function cur-time-print  returns character
     1127   :
     1128     define variable v-date as date      no-undo .
     1129     define variable v-time as integer   no-undo .
     1130     run cur-time in this-procedure
     1131       (output v-date
     1132       ,output v-time
     1133       ) .
     1134     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1135   end.
     1136   function cur-time-datetime returns datetime
     1137   :
     1138     define variable v-char as character no-undo .
     1139     define variable v-datetime as datetime no-undo .
     1140     v-char = cur-time-string().
     1141     v-datetime = datetime(v-char).
     1142     return  v-datetime.
     1143   end.
     1144   function cur-time-string-msec returns character
     1145   :
     1146     define variable v-date as datetime  no-undo .
     1147     v-date = now.
     1148     return string(v-date) .
     1149   end.
     1150   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1151   procedure gen-key-rec :
     1152     define input  parameter p-tbl-name    as character no-undo.
     1153     define input  parameter p-bh_tbl-name as handle    no-undo.
     1154     define output parameter p-key-rec     as character no-undo.
     1155     do
     1156     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1157     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1158     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1159     :
     1160       define variable fh               as handle    no-undo .
     1161       define variable v-ok             as logical   no-undo .
     1162       define variable v-inform         as character no-undo .
     1163       define variable v-ind            as integer   no-undo .
     1164       define variable v-idx-field-qnty as integer   no-undo .
     1165       if p-tbl-name = ?
     1166         or p-tbl-name = "":U
     1167       then do:
     1168         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
     1169       end.
     1170       if not p-bh_tbl-name:available then do:
     1171         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
     1172       end.
     1173       assign
     1174         p-key-rec = p-tbl-name
     1175         v-inform  = p-bh_tbl-name:index-information(1)
     1176         v-ind     = 2
     1177       .
     1178       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1179       on error undo, return error
     1180       :
     1181         assign
     1182           v-inform = p-bh_tbl-name:index-information( v-ind )
     1183           v-ind    = v-ind + 1
     1184         .
     1185       end.
     1186       if v-inform = ?
     1187         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1188         or entry( 3, v-inform, ",":U ) <> "1":U
     1189       then do:
     1190         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
     1191       end.
     1192       else do:
     1193         assign
     1194           v-idx-field-qnty = num-entries( v-inform ) - 4
     1195         .
     1196         if v-idx-field-qnty < 2 then do:
     1197           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
     1198         end.
     1199         do v-ind = 1 to v-idx-field-qnty by 2
     1200         on error undo, return error
     1201         :
     1202           assign
     1203             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1204             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1205           .
     1206         end.
     1207       end.
     1208       if p-key-rec = ? then do:
     1209         assign
     1210           p-key-rec = "":U
     1211         .
     1212         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
     1213       end.
     1214     end.
     1215     return.
     1216   end procedure.
     1217   procedure gen-where-keyr-tab :
     1218     define input  parameter i-tableSerach as character no-undo.
     1219     define input  parameter i-tablekey   as character  no-undo.
     1220     define input  parameter p-key-rec    as character  no-undo.
     1221     define input  parameter p-key-handle as handle     no-undo .
     1222     define input  parameter p-db-name    as character  no-undo .
     1223     define input  parameter p-tt-handle  as handle     no-undo .
     1224     define output parameter o-Where      as character  no-undo.
     1225     do
     1226     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1227     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1228     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1229     :
     1230       define variable v-full-tbl-name  as character no-undo .
     1231       define variable bh_tbl-name      as handle    no-undo .
     1232       define variable fh_key           as handle    no-undo .
     1233       define variable fh_search        as handle    no-undo .
     1234       define variable v-field-num      as integer   no-undo .
     1235       define variable v-count-fld      as integer   no-undo .
     1236       define variable v-inform         as character no-undo .
     1237       define variable v-ind            as integer   no-undo .
     1238       define variable v-idx-field-qnty as integer   no-undo .
     1239       define variable v-field-name     as character no-undo .
     1240       define variable v-field-val      as character no-undo .
     1241       define variable v-word-link      as character no-undo .
     1242       define variable vTable           as character no-undo.
     1243       define variable bh_tbl-key       as handle    no-undo .
     1244       assign
     1245         p-key-rec = trim( p-key-rec )
     1246       .
     1247       if p-key-handle <> ? then do:
     1248         if not valid-handle(p-key-handle)
     1249            or p-key-handle:type <> "buffer"
     1250         then do:
     1251           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1252         end.
     1253         if num-entries( p-key-rec, chr(3) ) > 1
     1254           or p-key-rec = ?
     1255           or p-key-rec = "":U
     1256         then do:
     1257           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1258         end.
     1259       end.
     1260       else do:
     1261         if p-key-rec = ?
     1262           or p-key-rec = "":U
     1263         then do:
     1264           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1265         end.
     1266       end.
     1267       assign
     1268         vTable = entry( 1 , p-key-rec, chr(3) )
     1269       .
     1270       if p-tt-handle <> ?
     1271         and ( not valid-handle(p-tt-handle)
     1272               or p-tt-handle:type <> "buffer"
     1273             )
     1274       then do:
     1275         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1276       end.
     1277       if p-tt-handle = ? then do:
     1278         assign
     1279           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1280         .
     1281         create buffer bh_tbl-name for table v-full-tbl-name .
     1282       end.
     1283       else do:
     1284         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1285       end.
     1286       assign
     1287         v-inform = bh_tbl-name:index-information(1)
     1288         v-ind    = 2
     1289       .
     1290       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1291       on error undo, return error
     1292       :
     1293         assign
     1294           v-inform = bh_tbl-name:index-information( v-ind )
     1295           v-ind    = v-ind + 1
     1296         .
     1297       end.
     1298       if v-inform = ?
     1299         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1300         or entry( 3, v-inform, ",":U ) <> "1":U
     1301       then do:
     1302         delete object bh_tbl-name no-error.
     1303         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1304       end.
     1305       assign
     1306         v-idx-field-qnty = num-entries( v-inform ) - 4
     1307       .
     1308       if v-idx-field-qnty < 2 then do:
     1309         delete object bh_tbl-name no-error.
     1310         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1311       end.
     1312       assign
     1313         o-where     = "where":U
     1314         v-word-link = "":U
     1315         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1316         v-count-fld = 0
     1317       .
     1318       if i-tablekey ne "" and i-tablekey ne ?
     1319       then do:
     1320         assign
     1321           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1322         .
     1323         create buffer bh_tbl-key for table v-full-tbl-name .
     1324       end.
     1325       if i-tableSerach ne "" and i-tableSerach ne ?
     1326       then do:
     1327         delete object bh_tbl-name no-error.
     1328         assign
     1329           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1330         .
     1331         create buffer bh_tbl-name for table v-full-tbl-name .
     1332       end.
     1333       block_where:
     1334       do v-ind = 1 to v-idx-field-qnty by 2
     1335       on error undo, return error
     1336       :
     1337         assign
     1338           v-count-fld = v-count-fld + 1
     1339         .
     1340         if p-key-handle = ?
     1341           and v-count-fld > v-field-num
     1342         then do:
     1343           leave block_where.
     1344         end.
     1345         define variable VfieldKeyTable as handle no-undo.
     1346         assign
     1347           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1348           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1349         .
     1350         if     bh_tbl-key ne ?
     1351         then do:
     1352            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1353            if VfieldKeyTable eq ?
     1354            then next block_where.
     1355         end.
     1356         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1357         then
     1358            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1359         else
     1360            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1361         if p-key-handle = ? then do:
     1362           assign
     1363             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1364           .
     1365         end.
     1366         else do:
     1367           assign
     1368             fh_key = p-key-handle:buffer-field( v-field-name )
     1369           .
     1370           if fh_key = ?
     1371             or not valid-handle( fh_key )
     1372           then do:
     1373             delete object bh_tbl-name.
     1374             if     bh_tbl-key ne ?
     1375             then
     1376                delete object bh_tbl-key.
     1377             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1378           end.
     1379           assign
     1380             v-field-val = fh_key:buffer-value
     1381           .
     1382         end.
     1383         if fh_search:data-type ="character":U then do:
     1384           assign
     1385             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1386             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1387             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1388             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1389             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1390             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1391             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1392             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1393             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1394             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1395             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1396             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1397             v-field-val = substitute( '"&1"', v-field-val )
     1398           .
     1399         end.
     1400         assign
     1401           o-where = substitute( "&1 &2", o-where, v-field-val )
     1402         .
     1403         if v-word-link = "":U then do:
     1404           assign
     1405             v-word-link = "and":U
     1406           .
     1407         end.
     1408       end.
     1409       delete object bh_tbl-name.
     1410       if     bh_tbl-key ne ?
     1411       then
     1412          delete object bh_tbl-key.
     1413       if p-key-handle = ?
     1414         and v-count-fld <> v-field-num
     1415       then do:
     1416         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1417       end.
     1418     end.
     1419   end procedure.
     1420   procedure gen-hn-keyr-tab :
     1421     define input  parameter i-tableSerach as character no-undo.
     1422     define input  parameter i-tablekey   as character no-undo.
     1423     define input  parameter p-key-rec    as character no-undo.
     1424     define input  parameter p-key-handle as handle    no-undo .
     1425     define input  parameter p-db-name    as character no-undo .
     1426     define input  parameter p-tt-handle  as handle    no-undo .
     1427     define input  parameter p-stts-lock  as integer   no-undo .
     1428     define output parameter o-hn         as handle    no-undo.
     1429     define variable v-full-tbl-name as character no-undo.
     1430     define variable v-where         as character no-undo.
     1431     define variable bh_tbl-name     as handle    no-undo.
     1432     define variable vTable          as character no-undo.
     1433     do
     1434     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1435     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1436     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1437         run gen-where-keyr-tab(i-tableSerach,
     1438                                i-tablekey,
     1439                                p-key-rec,
     1440                                p-key-handle,
     1441                                p-db-name,
     1442                                p-tt-handle,
     1443                                output v-where).
     1444         if i-tableSerach ne "" and i-tableSerach ne ?
     1445         then do:
     1446            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1447            create buffer bh_tbl-name for table v-full-tbl-name .
     1448         end.
     1449         else do:
     1450            if p-tt-handle = ? then do:
     1451               assign
     1452                  vTable = entry( 1 , p-key-rec, chr(3) )
     1453               .
     1454               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1455               create buffer bh_tbl-name for table v-full-tbl-name .
     1456            end.
     1457            else do:
     1458               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1459            end.
     1460         end.
     1461         if p-tt-handle = ? then do:
     1462            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1463         end.
     1464         else do:
     1465            bh_tbl-name:find-first( v-where ) no-error .
     1466         end.
     1467         o-hn = bh_tbl-name.
     1468      end.
     1469   end procedure.
     1470   procedure gen-hn-keyr :
     1471     define input  parameter p-key-rec    as character no-undo.
     1472     define input  parameter p-key-handle as handle    no-undo .
     1473     define input  parameter p-db-name    as character no-undo .
     1474     define input  parameter p-tt-handle  as handle    no-undo .
     1475     define input  parameter p-stts-lock  as integer   no-undo .
     1476     define output parameter o-hn         as handle    no-undo.
     1477     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1478   end.
     1479   procedure gen-row-keyr :
     1480     define input  parameter p-key-rec    as character no-undo.
     1481     define input  parameter p-key-handle as handle    no-undo .
     1482     define input  parameter p-db-name    as character no-undo .
     1483     define input  parameter p-tt-handle  as handle    no-undo .
     1484     define input  parameter p-stts-lock  as integer   no-undo .
     1485     define output parameter p-tbl-row    as rowid     no-undo.
     1486     define output parameter p-tbl-name   as character no-undo.
     1487     define variable vHn as handle no-undo.
     1488       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1489       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1490       p-tbl-name =  vHn:table.
     1491       delete object vHn no-error.
     1492     if p-tbl-row = ? then do:
     1493       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1494     end.
     1495     else do:
     1496       return.
     1497     end.
     1498   end procedure.
     1499   procedure gen-key-fv :
     1500     define input  parameter p-key-rec    as character no-undo .
     1501     define output parameter p-field-list as character no-undo .
     1502     define output parameter p-value-list as character no-undo.
     1503     do
     1504     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1505     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1506     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1507     :
     1508       define variable v-full-tbl-name  as character no-undo .
     1509       define variable bh_tbl-name      as handle    no-undo .
     1510       define variable v-tbl-name       as character no-undo .
     1511       define variable v-field-num      as integer   no-undo .
     1512       define variable v-count-fld      as integer   no-undo .
     1513       define variable v-inform         as character no-undo .
     1514       define variable v-ind            as integer   no-undo .
     1515       define variable v-idx-field-qnty as integer   no-undo .
     1516       define variable v-delim-key      as character no-undo .
     1517       if p-key-rec = ?
     1518         or p-key-rec = "":U
     1519       then do:
     1520         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1521       end.
     1522       assign
     1523         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1524         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1525       .
     1526       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1527       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1528       assign
     1529         v-inform = bh_tbl-name:index-information(1)
     1530         v-ind    = 2
     1531       .
     1532       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1533       on error undo, return error
     1534       :
     1535         assign
     1536           v-inform = bh_tbl-name:index-information( v-ind )
     1537           v-ind    = v-ind + 1
     1538         .
     1539       end.
     1540       if v-inform = ?
     1541         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1542         or entry( 3, v-inform, ",":U ) <> "1":U
     1543       then do:
     1544         delete object bh_tbl-name no-error.
     1545         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1546       end.
     1547       assign
     1548         v-idx-field-qnty = num-entries( v-inform ) - 4
     1549       .
     1550       if v-idx-field-qnty < 2 then do:
     1551         delete object bh_tbl-name no-error.
     1552         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1553       end.
     1554       assign
     1555         p-field-list = "":U
     1556         p-value-list = "":U
     1557         v-delim-key  = "":U
     1558         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1559         v-count-fld  = 0
     1560       .
     1561       block_where:
     1562       do v-ind = 1 to v-idx-field-qnty by 2
     1563       on error undo, return error
     1564       :
     1565         assign
     1566           v-count-fld = v-count-fld + 1
     1567         .
     1568         if v-count-fld > v-field-num then do:
     1569           leave block_where.
     1570         end.
     1571         assign
     1572           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1573           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1574         .
     1575         if v-ind = 1 then do:
     1576           assign
     1577             v-delim-key = chr(3)
     1578           .
     1579         end.
     1580       end.
     1581       delete object bh_tbl-name.
     1582       if v-count-fld <> v-field-num then do:
     1583         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1584       end.
     1585     end.
     1586   end procedure.
     1587   procedure gen-key-field :
     1588     define input  parameter p-table      as character no-undo .
     1589     define output parameter p-field-list as character no-undo .
     1590     do
     1591     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1592     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1593     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1594     :
     1595       define variable v-full-tbl-name  as character no-undo .
     1596       define variable bh_tbl-name      as handle    no-undo .
     1597       define variable v-tbl-name       as character no-undo .
     1598       define variable v-field-num      as integer   no-undo .
     1599       define variable v-count-fld      as integer   no-undo .
     1600       define variable v-inform         as character no-undo .
     1601       define variable v-ind            as integer   no-undo .
     1602       define variable v-idx-field-qnty as integer   no-undo .
     1603       define variable v-delim-key      as character no-undo .
     1604       if p-table = ?
     1605         or p-table = "":U
     1606       then do:
     1607         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1608       end.
     1609       assign
     1610         v-tbl-name      = p-table
     1611         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1612       .
     1613       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1614       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1615       assign
     1616         v-inform = bh_tbl-name:index-information(1)
     1617         v-ind    = 2
     1618       .
     1619       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1620       on error undo, return error
     1621       :
     1622         assign
     1623           v-inform = bh_tbl-name:index-information( v-ind )
     1624           v-ind    = v-ind + 1
     1625         .
     1626       end.
     1627       if v-inform = ?
     1628         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1629         or entry( 3, v-inform, ",":U ) <> "1":U
     1630       then do:
     1631         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1632       end.
     1633       assign
     1634         v-idx-field-qnty = num-entries( v-inform ) - 4
     1635       .
     1636       if v-idx-field-qnty < 2 then do:
     1637         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1638       end.
     1639       assign
     1640         p-field-list = "":U
     1641         v-delim-key  = "":U
     1642         v-count-fld  = 0
     1643       .
     1644       block_where:
     1645       do v-ind = 1 to v-idx-field-qnty by 2
     1646       on error undo, return error
     1647       :
     1648         assign
     1649           v-count-fld = v-count-fld + 1
     1650         .
     1651         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1652         if v-ind = 1 then do:
     1653           assign
     1654             v-delim-key = chr(3)
     1655           .
     1656         end.
     1657       end.
     1658       delete object bh_tbl-name.
     1659     end.
     1660   end procedure.
     1661   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1662   define  temp-table temp-update-rule no-undo
     1663   field table-name as character
     1664   field table-id as integer
     1665   field field-name as character
     1666   field bh as handle
     1667   field pk as character
     1668   field gen-id as integer
     1669   field action as character
     1670   field table-name-s as character
     1671   field table-id-s as integer
     1672   field field-name-s as character
     1673   field bh-s as handle
     1674   field type_ as integer
     1675   index pi is unique primary
     1676   gen-id
     1677   table-name
     1678   field-name
     1679   type_
     1680   table-name-s
     1681   field-name-s
     1682   index ps
     1683   gen-id
     1684   table-name-s
     1685   field-name-s
     1686   index itype
     1687   type_
     1688   .
     1689   procedure gen-temp-row-keyr :
     1690     define input  parameter p-key-rec  as character no-undo.
     1691     define input  parameter p-prefix   as character no-undo .
     1692     define output parameter p-tbl-row  as rowid     no-undo.
     1693     do
     1694     on error  undo, return error substitute( "&1 (gen-temp-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1695     on stop   undo, return error substitute( "&1 (gen-temp-row-keyr). stop", vss-workfile )
     1696     on endkey undo, return error substitute( "&1 (gen-temp-row-keyr). endkey", vss-workfile )
     1697     :
     1698       define variable v-tbl-name as character no-undo.
     1699       define variable v-full-tbl-name as character no-undo .
     1700       define variable bh_tbl-name     as handle    no-undo .
     1701       define variable fh              as handle    no-undo .
     1702       define variable v-ok            as logical   no-undo .
     1703       define variable v-where         as character no-undo .
     1704       define variable v-field-num     as integer   no-undo .
     1705       define variable v-count-fld     as integer   no-undo .
     1706       if p-key-rec = ?
     1707         or p-key-rec = "":U
     1708       then do:
     1709         return error substitute( "&1 (gen-temp-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1710       end.
     1711       assign
     1712         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1713         v-full-tbl-name = 'ub.' + v-tbl-name
     1714         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
     1715         v-where         = "":U
     1716         v-count-fld     = 0
     1717       .
     1718       find ub._file
     1719         where ub._file._file-name = v-tbl-name
     1720         no-error.
     1721       if not available ub._file then do:
     1722         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info8, v-tbl-name ).
     1723       end.
     1724       find ub._index
     1725         where recid( ub._index  ) = ub._file._prime-index
     1726         no-error.
     1727       if not available ub._index
     1728         or LC( ub._index._index-name ) = "default":U
     1729       then do:
     1730         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1731       end.
     1732       block_where :
     1733       for each ub._index-field of ub._index  ,
     1734           each ub._field of _index-field
     1735           break by _index-seq
     1736       on error undo, return error
     1737       :
     1738         assign
     1739           v-count-fld = v-count-fld + 1
     1740         .
     1741         if v-count-fld > v-field-num then do:
     1742           leave block_where.
     1743         end.
     1744         if v-where = "":U then do:
     1745           assign
     1746             v-where = "where":U
     1747           .
     1748         end.
     1749         else do:
     1750           assign
     1751             v-where = v-where + chr(32) + "and":U
     1752           .
     1753         end.
     1754         if ub._field._Data-Type ="character":U then do:
     1755           assign
     1756             v-where = v-where + chr(32) + substitute( "&1 = '&2'":U, ub._field._field-name, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     1757           .
     1758         end.
     1759         else do:
     1760           assign
     1761             v-where = v-where + chr(32) + substitute( "&1 = &2":U, ub._field._field-name, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     1762           .
     1763         end.
     1764       end.
     1765       if v-count-fld <> v-field-num then do:
     1766         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     1767       end.
     1768       create buffer bh_tbl-name for table (p-prefix  + v-tbl-name) .
     1769       bh_tbl-name:find-first( v-where, share-lock ) no-error .
     1770       if bh_tbl-name:available then do:
     1771         assign
     1772           p-tbl-row = bh_tbl-name:rowid
     1773         .
     1774       end.
     1775       else do:
     1776         assign
     1777           p-tbl-row = ?
     1778         .
     1779       end.
     1780       delete object bh_tbl-name.
     1781     end.
     1782     if p-tbl-row = ? then do:
     1783       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, v-tbl-name, p-key-rec ).
     1784     end.
     1785     else do:
     1786       return.
     1787     end.
     1788   end procedure.
     1789   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1790   FUNCTION mark-string RETURNS CHARACTER
     1791     ( input p-rowid as rowid, input mark-list as character  ) :
     1792     RETURN ( IF LOOKUP( STRING( p-rowid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1793   END FUNCTION.
     1794                                                                                                                           define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1795   PROCEDURE fill-table :
     1796   define input parameter p-dc-type-list-mode as character no-undo .
     1797   define input parameter p-dc-type-list as character no-undo .
     1798   define input parameter p-calc-only as logical no-undo .
     1799   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     1800   DEFINE BUFFER buf_rule-by-call FOR ub.rule-by-call.
     1801   DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     1802   _buf_dis-card-type:
     1803   FOR EACH buf_dis-card-type:
     1804     IF p-dc-type-list-mode = "*":U THEN.
     1805     ELSE DO:
     1806         IF not lookup(buf_dis-card-type.type, p-dc-type-list) > 0 then next _buf_dis-card-type.
     1807     END.
     1808     for each buf_rule-by-call no-lock where
     1809             buf_rule-by-call.call_id = buf_dis-card-type.uniq-key-rec
     1810         AND buf_rule-by-call.codex_id = 2
     1811         AND buf_rule-by-call.ruleset_id = 5:
     1812       if p-calc-only and buf_rule-by-call.can-calc = no then NEXT.
     1813       find first buf_tt0-rule-by-call no-lock where
     1814                 buf_tt0-rule-by-call.call_id = buf_rule-by-call.call_id
     1815             and buf_tt0-rule-by-call.ruleset_id = buf_rule-by-call.ruleset_id
     1816             and buf_tt0-rule-by-call.order_id = buf_rule-by-call.order_id no-error.
     1817       if not available buf_tt0-rule-by-call then do:
     1818         create buf_tt0-rule-by-call.
     1819         buffer-copy buf_rule-by-call to buf_tt0-rule-by-call.
     1820       end.
     1821     end.
     1822   END.
     1823   END PROCEDURE.
     1824   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1825   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1826   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1827   FUNCTION get-region RETURNS CHARACTER
     1828     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1829     define variable par-region as character no-undo.
     1830     if parhost-code = 0 and
     1831          parobj-type = "":U and
     1832          parobj-code = 0 then do:
     1833          par-region = "Глобально".
     1834          return par-region.
     1835       end.
     1836       if parobj-type = 'орг':U then do:
     1837          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1838          return par-region.
     1839       end.
     1840       if parobj-type = 'регион':U
     1841       then do:
     1842          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1843          return par-region.
     1844       end.
     1845       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1846       return par-region.
     1847   END FUNCTION.
     1848   FUNCTION get-objregion RETURNS CHARACTER
     1849     (  input parobj-type as character, input parobj-code as integer ) :
     1850     define variable par-region as character no-undo.
     1851     if  parobj-type = "":U and
     1852         parobj-code = 0
     1853     then do:
     1854        par-region = "Глобально".
     1855     end.
     1856     else if parobj-type = 'орг':U
     1857     then do:
     1858        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1859     end.
     1860     else if parobj-type = 'регион':U
     1861     then do:
     1862        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1863     end.
     1864     else
     1865        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1866     return par-region.
     1867   END FUNCTION.
     1868   FUNCTION calldscr returns character ( input p-call-id as character):
     1869   define variable v-descr as character no-undo .
     1870   define variable v-field-list as character no-undo .
     1871   define variable v-value-list as character no-undo.
     1872   define variable v-prop-label as character no-undo .
     1873   define variable v-node-label as character no-undo .
     1874   define variable v-dt-code as integer no-undo .
     1875   define variable v-host-code as integer no-undo .
     1876   define variable v-obj-type as character no-undo .
     1877   define variable v-obj-code as integer no-undo .
     1878   define variable v-label as character no-undo .
     1879   define variable v-node-code as integer no-undo .
     1880   define buffer buf_prop-head for ub.prop-head.
     1881   define buffer buf_prop-ref for ub.prop-ref.
     1882   define buffer buf_prop-map for ub.prop-map.
     1883   run gen-key-fv in this-procedure ( input p-call-id
     1884                                     ,output v-field-list
     1885                                     ,output v-value-list) no-error .
     1886   if error-status:error then return p-call-id.
     1887   CASE entry(1, p-call-id, chr(3)):
     1888     when 'dis-card-type':U then do:
     1889       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1890                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1891                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1892                            ).
     1893     end.
     1894     when 'dis-card':U then do:
     1895       v-descr = substitute("ДК: № &1"
     1896                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1897                            ).
     1898     end.
     1899     when 'dis-card-property':U then do:
     1900       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1901       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1902       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1903       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1904       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1905       find first buf_prop-ref no-lock where
     1906                 buf_prop-ref.dt-code = v-dt-code no-error .
     1907       if available buf_prop-ref then do:
     1908         find first buf_prop-head no-lock where
     1909                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1910         v-prop-label = buf_prop-head.prop-label.
     1911         find first buf_prop-map no-lock where
     1912                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1913               and buf_prop-map.node-code = v-node-code no-error .
     1914         if available buf_prop-map then do:
     1915           v-label = buf_prop-map.node-label.
     1916         end.
     1917       end.
     1918       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1919                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1920                            ,v-prop-label
     1921                            ,v-label
     1922                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1923                            ).
     1924     end.
     1925     when 'clients':U then do:
     1926       v-descr = substitute("&1&2"
     1927                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1928                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1929                            ).
     1930     end.
     1931     when 'ext-system':U then do:
     1932       v-descr = substitute("Внешняя система &1"
     1933                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1934                            ).
     1935     end.
     1936     WHEN 'thbj-attr':U then do:
     1937       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1938       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1939       then do:
     1940         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1941           v-descr = "Операции с товарами".
     1942         end.
     1943         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1944           v-descr = "Операции с клиентами".
     1945         end.
     1946         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1947           v-descr = "Операции с группами товаров".
     1948         end.
     1949         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1950           v-descr = "Операции с группами клиентов".
     1951         end.
     1952         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1953           v-descr = "Операции с чеками на POS IBS-TH".
     1954         end.
     1955         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1956           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1957         end.
     1958         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1959           v-descr = "Операции в системе электронного документооборота".
     1960         end.
     1961         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1962           v-descr = "Операции со справочниками".
     1963         end.
     1964         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1965           v-descr = "Операции с ДНЦ и переоценками".
     1966         end.
     1967         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1968           v-descr = "Отчеты".
     1969         end.
     1970         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1971           v-descr = "Операции с заказами".
     1972         end.
     1973       end.
     1974     end.
     1975     when 'cash-desk':U then do:
     1976       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1977                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1978                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1979                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1980                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1981                            ).
     1982     end.
     1983     when 'ext-file':U then do:
     1984       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1985                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1986                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1987                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1988                            ).
     1989     end.
     1990   end case.
     1991   return v-descr.
     1992   end function.
     1993   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1994   DEFINE VARIABLE v-algo-field-list AS CHARACTER NO-UNDO.
     1995   DEFINE VARIABLE v-update-mode AS CHARACTER NO-UNDO.
     1996   DEFINE VARIABLE v-dc-list-mode AS CHARACTER NO-UNDO.
     1997   DEFINE VARIABLE v-dc-type-list-mode AS CHARACTER NO-UNDO.
     1998   DEFINE VARIABLE v-dc-type-list AS CHARACTER NO-UNDO.
     1999   DEFINE VARIABLE v-dc-type-algo-list AS CHARACTER NO-UNDO.
     2000   DEFINE VARIABLE v-param-list AS CHARACTER NO-UNDO.
     2001   DEFINE BUTTON b-dc-type
     2002        IMAGE-UP FILE "btn-down-arrow":U
     2003        IMAGE-DOWN FILE "btn-down-arrow":U
     2004        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     2005        LABEL "..."
     2006        SIZE 3.6 BY 1.03.
     2007   DEFINE BUTTON B-exit AUTO-GO
     2008        LABEL "&Ввод"
     2009        SIZE 10 BY 1
     2010        BGCOLOR 8 .
     2011   DEFINE BUTTON B-Help
     2012        LABEL "Помо&щь"
     2013        SIZE 3 BY 1
     2014        BGCOLOR 8 .
     2015   DEFINE BUTTON b-lst
     2016        LABEL "Список ДК"
     2017        SIZE 10 BY 1.
     2018   DEFINE BUTTON B-mark
     2019        LABEL "&*"
     2020        SIZE 3 BY 1.
     2021   DEFINE BUTTON b-quit AUTO-END-KEY
     2022        LABEL "&Отмена"
     2023        SIZE 10 BY 1
     2024        BGCOLOR 8 .
     2025   DEFINE VARIABLE E-dc-type AS CHARACTER
     2026        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2027        SIZE 18.5 BY 5.27 NO-UNDO.
     2028   DEFINE VARIABLE editor-1 AS CHARACTER
     2029        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2030        SIZE 98 BY 2.4 NO-UNDO.
     2031   DEFINE VARIABLE f-dc-type-label AS CHARACTER FORMAT "X(256)":U INITIAL "Список типов ДК"
     2032         VIEW-AS TEXT
     2033        SIZE 15.5 BY .67
     2034        FGCOLOR 4  NO-UNDO.
     2035   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     2036         VIEW-AS TEXT
     2037        SIZE 13 BY .67
     2038        FGCOLOR 10  NO-UNDO.
     2039   DEFINE VARIABLE RS-dc-list-mode AS CHARACTER
     2040        VIEW-AS RADIO-SET VERTICAL
     2041        RADIO-BUTTONS
     2042             "По списку ДК", "LIST",
     2043   "Все карты, подлежащ.расчету", "ALL"
     2044        SIZE 30.5 BY 2 NO-UNDO.
     2045   DEFINE VARIABLE RS-dc-type-list-mode AS CHARACTER INITIAL "*"
     2046        VIEW-AS RADIO-SET HORIZONTAL
     2047        RADIO-BUTTONS
     2048             "Все типы", "*",
     2049   "Список", "list"
     2050        SIZE 19 BY 1 NO-UNDO.
     2051   DEFINE VARIABLE Rs-update-mode AS CHARACTER
     2052        VIEW-AS RADIO-SET VERTICAL
     2053        RADIO-BUTTONS
     2054             "Проверка-0 (по итогу по ВСЕМ фирмам)", "check-0",
     2055   "Расчет (с сохранением)", "update",
     2056   "Проверка-1 (по сумме итогов по фирмам)", "check-1",
     2057   "Проверка-2 (по суммам итогов по объектам)", "check-2",
     2058   "Проверка-3 (по платежам)", "check-3",
     2059   "Проверка-4 (по документам)", "check-4"
     2060        SIZE 43.5 BY 5.27 NO-UNDO.
     2061   DEFINE QUERY BR-rule-by-call FOR
     2062         tt0-rule-by-call SCROLLING.
     2063   DEFINE BROWSE BR-rule-by-call
     2064     QUERY BR-rule-by-call NO-LOCK DISPLAY
     2065         mark-string(ROWID(tt0-rule-by-call), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U WIDTH 2
     2066   calldscr(tt0-rule-by-call.call_id) COLUMN-LABEL "Место вызова обсчета" FORMAT "X(60)":U WIDTH 28
     2067   tt0-rule-by-call.can-calc COLUMN-LABEL "Включен?" FORMAT "+/":U
     2068   tt0-rule-by-call.is_dynamic COLUMN-LABEL "Отклю!чаемый" FORMAT "+/":U
     2069   tt0-rule-by-call.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>9":U WIDTH 7
     2070   tt0-rule-by-call.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>9":U width 7
     2071   tt0-rule-by-call.order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>9":U WIDTH 9
     2072   tt0-rule-by-call.rule_id COLUMN-LABEL "Код!правила" FORMAT ">>>>>>>>9":U WIDTH 9
     2073       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11
     2074            TITLE "Алгоритмы для расчета" FIT-LAST-COLUMN.
     2075   DEFINE FRAME Dialog-Frame
     2076        B-exit AT ROW 1 COL 1.1
     2077        b-quit AT ROW 1 COL 11.1
     2078        b-lst AT ROW 1 COL 80
     2079        B-Help AT ROW 1 COL 95
     2080        RS-dc-list-mode AT ROW 2 COL 46.5 NO-LABEL
     2081        RS-dc-type-list-mode AT ROW 2 COL 79.5 NO-LABEL
     2082        b-dc-type AT ROW 3 COL 95.5
     2083        Rs-update-mode AT ROW 3.07 COL 2 NO-LABEL
     2084        E-dc-type AT ROW 4 COL 80 NO-LABEL
     2085        B-mark AT ROW 8.5 COL 1
     2086        BR-rule-by-call AT ROW 9.5 COL 1
     2087        editor-1 AT ROW 20.73 COL 1 NO-LABEL WIDGET-ID 4
     2088        f-dc-type-label AT ROW 3.27 COL 80 NO-LABEL
     2089        mark-num AT ROW 8.5 COL 3 COLON-ALIGNED NO-LABEL
     2090        "Отбор карт" VIEW-AS TEXT
     2091             SIZE 15 BY 1 AT ROW 1 COL 46 WIDGET-ID 2
     2092             FGCOLOR 4
     2093        "Режим работы" VIEW-AS TEXT
     2094             SIZE 35 BY 1 AT ROW 2.07 COL 2
     2095             FGCOLOR 4
     2096        SPACE(62.25) SKIP(20.17)
     2097       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2098            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2099            TITLE "Пересчет скидки/категории ДК в соответствии алгоритмами, заданными для типов ДК"
     2100            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2101   ASSIGN
     2102          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2103          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2104   ASSIGN
     2105          E-dc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2106   ASSIGN
     2107          editor-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2108   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2109   DO:
     2110     APPLY "END-ERROR":U TO SELF.
     2111   END.
     2112   ON CHOOSE OF b-dc-type IN FRAME Dialog-Frame
     2113   DO:
     2114     define variable var-rid-str  as character no-undo.
     2115     DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2116     DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     2117     DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     2118   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2119   if lookup(self :type
     2120            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2121            ) = 0
     2122   then do:
     2123     message
     2124       "$Workfile$"
     2125       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2126       "Интерфейсный элемент" self :name  skip
     2127       "Тип" self :type  skip
     2128       "Процедура" this-procedure :file-name skip
     2129       view-as alert-box .
     2130   end.
     2131   else do:
     2132     apply "entry":u to self  .
     2133     if focus :handle <> self :handle  then do:
     2134       return no-apply .
     2135     end.
     2136   end.
     2137     run ref/dc-types.w (
     2138                  input parparentproc
     2139                 ,input "":U
     2140                 ,INPUT "b-sel,b-mark":U
     2141                 ,INPUT 0
     2142                 ,INPUT 0
     2143                 ,INPUT '':U
     2144                 ,INPUT 0
     2145                 ,input-output var-rid-str) .
     2146     IF var-rid-str = '':u  THEN RETURN NO-APPLY.
     2147    e-dc-type:SCREEN-VALUE = '':U.
     2148    v-dc-type-list = ''.
     2149    FOR EACH buf_tt0-rule-by-call:
     2150        DELETE buf_tt0-rule-by-call.
     2151    END.
     2152     DO ii = 1 TO NUM-ENTRIES(var-rid-str):
     2153       FIND FIRST buf_dis-card-type NO-LOCK WHERE
     2154                   recid(buf_dis-card-type) = INTEGER(ENTRY(ii, var-rid-str)) NO-ERROR.
     2155        IF NOT AVAILABLE buf_dis-card-type THEN DO:
     2156            RETURN NO-APPLY.
     2157        END.
     2158        e-dc-type:SCREEN-VALUE = e-dc-type:SCREEN-VALUE + (IF ii = 1 THEN '':U ELSE chr(10)) +
     2159                                 buf_dis-card-type.TYPE.
     2160         v-dc-type-list = v-dc-type-list + (IF v-dc-type-list = '':U THEN '' ELSE chr(44)) + buf_dis-card-type.TYPE.
     2161     END.
     2162     RUN fill-table IN THIS-PROCEDURE (  input v-dc-type-list-mode
     2163                                        ,input v-dc-type-list
     2164                                        ,input yes ).
     2165     RUN openbr IN THIS-PROCEDURE.
     2166   END.
     2167   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2168   DO:
     2169     DEFINE VARIABLE num-rec as integer no-undo.
     2170     define VARIABLE num-rec-ok as integer no-undo.
     2171     DEFine VARIABLE II AS INTEGER NO-UNDO.
     2172     define variable glog as logical no-undo .
     2173     define variable v-curr-r-b as character no-undo .
     2174   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2175   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2176     (output v-curr-r-b
     2177     )  .
     2178     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     2179     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2180     IF p-mode = "run" THEN DO:
     2181         message
     2182           "В выбранных соглано уловиям дисконтных картах будут пересчитаны скидки/категории"
     2183           "в соответствии с алгоритмом, заданным по типу карты" SKIP
     2184           "Продолжать?"
     2185           view-as alert-box QUESTION buttons YES-NO update glog.
     2186           IF not glog then return no-apply.
     2187           run str/diallog.w ( INPUT parparentproc
     2188                       , INPUT this-procedure
     2189                       , INPUT 'utl/dcpcuq1.p':U
     2190                       , INPUT v-param-list
     2191                       , INPUT  no
     2192                       , INPUT "&Стоп"
     2193                       , INPUT 'Пересчет скидки/категории ДК в соответствии алгоритмами, заданными для типов ДК') .
     2194     END.
     2195     END.
     2196   ON CHOOSE OF b-lst IN FRAME Dialog-Frame
     2197   DO:
     2198      run str/dc-list.w ( input parparentproc
     2199                        , input v-cntxt-host-code-obj
     2200                        , input v-cntxt-obj-type
     2201                        , input v-cntxt-obj-code).
     2202   END.
     2203   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2204   DO:
     2205     define variable loc#log as logical no-undo .
     2206     if available tt0-rule-by-call then do:
     2207   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2208   define variable v-str-recid17 as character no-undo .
     2209   define variable v-num-entry17 as integer   no-undo .
     2210   assign
     2211     v-str-recid17 = trim( string( ROWID(TT0-rule-by-call) , "->>>>>>>>>>>9":U ) )
     2212     v-num-entry17 = lookup( v-str-recid17 , v-rid-list )
     2213   .
     2214   if v-num-entry17 > 0 then do:
     2215     assign
     2216       entry( v-num-entry17, v-rid-list ) = "":U
     2217       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2218     .
     2219   end.
     2220   else do:
     2221     assign
     2222       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     2223     .
     2224   end.
     2225       loc#log = br-rule-by-call:refresh() .
     2226       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2227           loc#log = br-rule-by-call:select-next-row ().
     2228           apply "VALUE-CHANGED" to br-rule-by-call in frame Dialog-Frame.
     2229       end.
     2230       if num-entries( v-rid-list ) = 0
     2231       then
     2232           hide mark-num in frame Dialog-Frame.
     2233       else
     2234           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2235     end.
     2236     apply "entry" to br-rule-by-call in frame Dialog-Frame.
     2237   END.
     2238   ON VALUE-CHANGED OF BR-rule-by-call IN FRAME Dialog-Frame
     2239   DO:
     2240   DEFINE VARIABLE v-dop AS CHARACTER NO-UNDO.
     2241   IF AVAILABLE tt0-rule-by-call THEN DO:
     2242      editor-1:SCREEN-VALUE = tt0-rule-by-call.algo-des.
     2243   END.
     2244   ELSE DO:
     2245      editor-1:SCREEN-VALUE  = '':U.
     2246   END.
     2247   END.
     2248   ON VALUE-CHANGED OF RS-dc-list-mode IN FRAME Dialog-Frame
     2249   DO:
     2250     ASSIGN
     2251      rs-dc-list-mode.
     2252     CASE rs-dc-list-mode:
     2253         WHEN 'list' THEN DO:
     2254            ENABLE
     2255            b-lst
     2256            WITH FRAME Dialog-Frame.
     2257         END.
     2258         WHEN 'all' THEN DO:
     2259             disable
     2260             b-lst
     2261             WITH FRAME Dialog-Frame.
     2262         END.
     2263     END CASE.
     2264   END.
     2265   ON VALUE-CHANGED OF RS-dc-type-list-mode IN FRAME Dialog-Frame
     2266   DO:
     2267   define BUFFER BUF_TT0-rule-by-call for tt0-rule-by-call.
     2268     ASSIGN
     2269     rs-dc-type-list-mode
     2270     v-dc-type-list-mode = rs-dc-type-list-mode
     2271     .
     2272     CASE rs-dc-type-LIST-MODE:
     2273         WHEN "*":U THEN DO:
     2274           e-dc-type:SCREEN-VALUE = '':U.
     2275           DISABLE
     2276           b-dc-type
     2277           WITH FRAME Dialog-Frame.
     2278           RUN fill-table IN THIS-PROCEDURE (  input v-dc-type-list-mode
     2279                                             ,input v-dc-type-list
     2280                                             ,input yes ).
     2281         END.
     2282         WHEN "list" THEN DO:
     2283             ENABLE
     2284             b-dc-type
     2285             WITH FRAME Dialog-Frame.
     2286             FOR EACH buf_tt0-rule-by-call :
     2287                 DELETE buf_tt0-rule-by-call.
     2288             END.
     2289       END.
     2290     END CASE.
     2291     RUN openbr IN THIS-PROCEDURE .
     2292   END.
     2293   ON VALUE-CHANGED OF Rs-update-mode IN FRAME Dialog-Frame
     2294   DO:
     2295     ASSIGN
     2296     rs-update-mode.
     2297   END.
     2298   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2299   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2300   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2301   on help of frame Dialog-Frame
     2302   do:
     2303     run gbl/app_help.p
     2304       (input this-procedure :file-name
     2305       ,input ''
     2306       ,input ?
     2307       ) no-error.
     2308     if error-status :error then do:
     2309       message
     2310         "Ошибка при вызове помощи"
     2311         error-status :get-message(1)
     2312         view-as alert-box .
     2313     end.
     2314   end.
     2315   run minbtn-set in this-procedure .
     2316   on choose of b-help in frame Dialog-Frame
     2317   do:
     2318     apply "help":u to frame Dialog-Frame .
     2319   end.
     2320   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2321   procedure minbtn-set :
     2322       do
     2323           on error undo, return error return-value
     2324           :
     2325           define variable ii              as integer       no-undo .
     2326           define variable fh              as widget-handle no-undo .
     2327           define variable hh              as widget-handle no-undo .
     2328           define variable v-h             as handle        extent 4 no-undo .
     2329           define variable v-name-button   as character     no-undo .
     2330           define variable v-help-old-x    as decimal       no-undo .
     2331           define variable v-help-old-y    as decimal       no-undo .
     2332           define variable v-help-old-size as decimal       no-undo .
     2333           define variable v-frame-width   as decimal       no-undo .
     2334           define variable jj              as integer       no-undo .
     2335           do
     2336               on error undo, return error
     2337               :
     2338               assign
     2339                   v-frame-width = frame Dialog-Frame:width - 0.3
     2340                   fh            = frame Dialog-Frame:first-child
     2341                   hh            = fh:first-child
     2342                   ii            = 1
     2343                   .
     2344               do while valid-handle(hh):
     2345                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2346                   do:
     2347                       case lc(hh:name) :
     2348                           when "b-help" then
     2349                               do:
     2350                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2351                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2352                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2353                                   hh:TOOLTIP = "Помощь" .
     2354                                   v-help-old-x = hh:column .
     2355                                   v-help-old-y = hh:row    .
     2356                                   v-help-old-size = hh:width .
     2357                                   hh:width-chars = 2.5 .
     2358                               end.
     2359                           when "b-print" then
     2360                               do:
     2361                                   hh:load-image("cmp/b-print.bmp":u) .
     2362                                   hh:TOOLTIP = "Печать" .
     2363                                   v-h[ii] = hh:handle .
     2364                                   ii = ii + 1 .
     2365                                   hh:width-chars = 3 .
     2366                               end.
     2367                           when "b-history" or
     2368                           when "b-hist" then
     2369                               do:
     2370                                   hh:load-image("cmp/b-hist.bmp":u) .
     2371                                   hh:TOOLTIP = "История" .
     2372                                   v-h[ii] = hh:handle .
     2373                                   ii = ii + 1 .
     2374                                   hh:width-chars = 3 .
     2375                               end.
     2376                           when "b-sch" then
     2377                               do:
     2378                                   hh:load-image("cmp/b-sch.bmp":u) .
     2379                                   hh:TOOLTIP = "Установка Фильтра" .
     2380                                   v-h[ii] = hh:handle .
     2381                                   ii = ii + 1 .
     2382                                   hh:width-chars = 3 .
     2383                               end.
     2384                           when "b-hist-user" then
     2385                               do:
     2386                                   hh:load-image("cmp/b-hist.bmp":u) .
     2387                                   hh:TOOLTIP = "История пользователя" .
     2388                                   ii = ii + 1 .
     2389                               end.
     2390                       end case.
     2391                   end.
     2392                   hh = hh:next-sibling.
     2393               end.
     2394               b-help:column = v-frame-width - b-help:width-chars.
     2395               jj = 0.
     2396               repeat ii = 4 to 1 by -1 :
     2397                   if valid-handle (v-h[ii] ) then
     2398                   do:
     2399                       jj  = jj + 1 .
     2400                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2401                       v-h[ii]:row    = v-help-old-y .
     2402                   end.
     2403               end.
     2404           end.
     2405       end.
     2406   end procedure.
     2407   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2408   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2409   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2410   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2411   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2412   define variable v-diasize-current-frame-height as decimal   no-undo .
     2413   define variable v-diasize-change-size          as logical   no-undo .
     2414   define variable v-diasize-resize-button        as handle    no-undo .
     2415   define variable v-diasize-wndmax               as logical   no-undo .
     2416   define variable v-diasize-wndstore             as logical   no-undo .
     2417   define variable v-diasize-proc-name            as character no-undo .
     2418   define variable v-diasize-browse-handle        as handle    no-undo .
     2419   define variable v-diasize-browse-number        as integer   no-undo .
     2420   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2421   define temp-table temp-diasize-handle no-undo
     2422     field handle-value  as handle
     2423     field save-position as decimal
     2424     index xpk is primary unique handle-value
     2425     .
     2426   define temp-table temp-browse-handle no-undo
     2427     field browse-type   as character
     2428     field browse-number as integer
     2429     field browse-handle as handle
     2430     field original-size as decimal
     2431     index xpk is primary unique browse-type browse-number
     2432     index xie browse-type browse-handle
     2433   .
     2434   procedure diasize_change-height :
     2435     define input  parameter p-change-value  as decimal   no-undo .
     2436     define input  parameter p-move-resize   as logical   no-undo .
     2437     define variable v-field-group-handle    as handle    no-undo .
     2438     define variable v-object-handle         as handle    no-undo .
     2439     define variable v-frame-height          as decimal   no-undo .
     2440     define variable v-frame-virtual-height  as decimal   no-undo .
     2441     define variable v-browse-height         as decimal   no-undo .
     2442     define variable v-window-height         as decimal   no-undo .
     2443     define variable v-window-virtual-height as decimal   no-undo .
     2444     define variable v-change-sign           as integer   no-undo .
     2445     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2446     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2447     if p-change-value > 0
     2448     then do:
     2449       if frame Dialog-Frame :height + p-change-value
     2450           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2451       then do:
     2452         assign
     2453           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2454                           - (frame Dialog-Frame :height-chars)
     2455         .
     2456         if p-change-value <= 0
     2457         then do:
     2458           run diasize_position-resize-button in this-procedure .
     2459           return .
     2460         end.
     2461       end.
     2462     end.
     2463     if p-change-value < 0
     2464     then do:
     2465       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2466       then do:
     2467         assign
     2468           p-change-value = v-diasize-orig-frame-height
     2469                          - (frame Dialog-Frame :height-chars)
     2470         .
     2471         if p-change-value >= 0
     2472         then do:
     2473           run diasize_position-resize-button in this-procedure .
     2474           return .
     2475         end.
     2476       end.
     2477     end.
     2478     if p-change-value >= 0
     2479     then do:
     2480       assign
     2481         v-change-sign = 1
     2482       .
     2483     end.
     2484     else do:
     2485       assign
     2486         v-change-sign = -1
     2487       .
     2488     end.
     2489     assign
     2490       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2491     .
     2492     if p-change-value = 0
     2493     then do:
     2494       run diasize_position-resize-button in this-procedure .
     2495       return .
     2496     end.
     2497     move_block:
     2498     do
     2499     on error undo move_block, retry move_block
     2500     :
     2501       if retry
     2502       then do:
     2503         do
     2504         on error undo move_block, leave move_block
     2505         :
     2506           if p-change-value > 0
     2507           then do:
     2508             for each buf_temp-diasize-handle
     2509             on error undo, next
     2510             :
     2511               assign
     2512                 v-object-handle = buf_temp-diasize-handle.handle-value
     2513               .
     2514               if v-object-handle <> v-diasize-resize-button
     2515               then do:
     2516                 assign
     2517                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2518                 .
     2519               end.
     2520             end.
     2521             assign
     2522               v-diasize-browse-handle :height = v-browse-height
     2523             .
     2524             for each buf_temp-browse-handle
     2525               where buf_temp-browse-handle.browse-type = 'height':u
     2526             on error undo, next
     2527             :
     2528               assign
     2529                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2530               .
     2531             end.
     2532             assign
     2533               frame Dialog-Frame :height = v-frame-height
     2534             .
     2535             if frame Dialog-Frame :scrollable = true
     2536             then do:
     2537               assign
     2538                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2539               .
     2540             end.
     2541             run diasize_position-resize-button in this-procedure .
     2542           end.
     2543           else do:
     2544             if frame Dialog-Frame :scrollable = true
     2545             then do:
     2546               assign
     2547                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2548               .
     2549             end.
     2550             assign
     2551               frame Dialog-Frame :height = v-frame-height
     2552             .
     2553             assign
     2554               v-diasize-browse-handle :height = v-browse-height
     2555             .
     2556             for each buf_temp-browse-handle
     2557               where buf_temp-browse-handle.browse-type = 'height':u
     2558             on error undo, next
     2559             :
     2560               assign
     2561                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2562               .
     2563             end.
     2564             for each buf_temp-diasize-handle
     2565             on error undo, next
     2566             :
     2567               assign
     2568                 v-object-handle = buf_temp-diasize-handle.handle-value
     2569               .
     2570               if v-object-handle <> v-diasize-resize-button
     2571               then do:
     2572                 assign
     2573                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2574                 .
     2575               end.
     2576             end.
     2577             run diasize_position-resize-button in this-procedure .
     2578           end.
     2579           assign
     2580             v-diasize-change-size = false
     2581           .
     2582           leave move_block .
     2583         end.
     2584       end.
     2585       assign
     2586         v-diasize-need-full-display = true
     2587       .
     2588       if v-diasize-change-size = false
     2589       then do:
     2590         assign
     2591           v-diasize-change-size = true
     2592         .
     2593       end.
     2594       else do:
     2595         return .
     2596       end.
     2597       assign
     2598         v-frame-height = frame Dialog-Frame :height
     2599         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2600         v-browse-height = v-diasize-browse-handle :height
     2601       .
     2602       for each buf_temp-browse-handle
     2603         where buf_temp-browse-handle.browse-type = 'height':u
     2604       :
     2605         assign
     2606           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2607         .
     2608       end.
     2609       for each buf_temp-diasize-handle
     2610       :
     2611         delete buf_temp-diasize-handle .
     2612       end.
     2613       assign
     2614         v-field-group-handle = frame Dialog-Frame :first-child
     2615       .
     2616       do while valid-handle(v-field-group-handle)
     2617       :
     2618         assign
     2619           v-object-handle = v-field-group-handle :first-child
     2620         .
     2621         do while valid-handle(v-object-handle)
     2622         :
     2623           if  v-object-handle <> v-diasize-browse-handle :handle
     2624           and can-query(v-object-handle, "row")
     2625           and can-query(v-object-handle, "height")
     2626           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2627           then do:
     2628             find first buf_temp-browse-handle
     2629               where buf_temp-browse-handle.browse-type   = 'height':u
     2630                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2631               no-error .
     2632             if available buf_temp-browse-handle
     2633             then do:
     2634             end.
     2635             else do:
     2636               create buf_temp-diasize-handle .
     2637               assign
     2638                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2639                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2640               .
     2641             end.
     2642           end.
     2643           assign
     2644             v-object-handle = v-object-handle :next-sibling
     2645           .
     2646         end.
     2647         assign
     2648           v-field-group-handle = v-field-group-handle :next-sibling
     2649         .
     2650       end.
     2651       do with frame Dialog-Frame
     2652       :
     2653         hide v-diasize-resize-button .
     2654         assign
     2655           v-diasize-resize-button :row    = 1
     2656           v-diasize-resize-button :column = 1
     2657         .
     2658       end.
     2659       if p-change-value > 0
     2660       then do:
     2661         if frame Dialog-Frame :scrollable = true
     2662         then do:
     2663           assign
     2664             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2665             no-error .
     2666           if error-status :error
     2667           or error-status :get-message(1) <> ""
     2668           then do:
     2669             undo move_block, retry move_block .
     2670           end.
     2671         end.
     2672         assign
     2673           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2674           no-error .
     2675         if error-status :error
     2676         or error-status :get-message(1) <> ""
     2677         then do:
     2678           undo move_block, retry move_block .
     2679         end.
     2680         assign
     2681           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2682           no-error .
     2683         if error-status :error
     2684         or error-status :get-message(1) <> ""
     2685         then do:
     2686           undo move_block, retry move_block .
     2687         end.
     2688         for each buf_temp-browse-handle
     2689           where buf_temp-browse-handle.browse-type = 'height':u
     2690         on error undo move_block, retry move_block
     2691         :
     2692           assign
     2693             buf_temp-browse-handle.browse-handle :height
     2694               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2695             no-error .
     2696           if error-status :error
     2697           or error-status :get-message(1) <> ""
     2698           then do:
     2699             undo move_block, retry move_block .
     2700           end.
     2701         end.
     2702         for each buf_temp-diasize-handle
     2703         on error undo move_block, retry move_block
     2704         :
     2705           assign
     2706             v-object-handle = buf_temp-diasize-handle.handle-value
     2707           .
     2708           if v-object-handle <> v-diasize-resize-button
     2709           then do:
     2710             assign
     2711               v-object-handle :row = v-object-handle :row + p-change-value
     2712               no-error .
     2713             if error-status :error
     2714             or error-status :get-message(1) <> ""
     2715             then do:
     2716               undo move_block, retry move_block .
     2717             end.
     2718           end.
     2719         end.
     2720       end.
     2721       else do:
     2722         for each buf_temp-diasize-handle
     2723         on error undo move_block, retry move_block
     2724         :
     2725           assign
     2726             v-object-handle = buf_temp-diasize-handle.handle-value
     2727           .
     2728           if v-object-handle <> v-diasize-resize-button
     2729           then do:
     2730             assign
     2731               v-object-handle :row = v-object-handle :row + p-change-value
     2732               no-error .
     2733             if error-status :error
     2734             or error-status :get-message(1) <> ""
     2735             then do:
     2736               undo move_block, retry move_block .
     2737             end.
     2738           end.
     2739         end.
     2740         assign
     2741           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2742           no-error .
     2743         if error-status :error
     2744         or error-status :get-message(1) <> ""
     2745         then do:
     2746           undo move_block, retry move_block .
     2747         end.
     2748         for each buf_temp-browse-handle
     2749           where buf_temp-browse-handle.browse-type = 'height':u
     2750         on error undo move_block, retry move_block
     2751         :
     2752           assign
     2753             buf_temp-browse-handle.browse-handle :height
     2754               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2755             no-error .
     2756           if error-status :error
     2757           or error-status :get-message(1) <> ""
     2758           then do:
     2759             undo move_block, retry move_block .
     2760           end.
     2761         end.
     2762         assign
     2763           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2764           no-error .
     2765         if error-status :error
     2766         or error-status :get-message(1) <> ""
     2767         then do:
     2768           undo move_block, retry move_block .
     2769         end.
     2770         if frame Dialog-Frame :scrollable = true
     2771         then do:
     2772           assign
     2773             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2774             no-error .
     2775           if error-status :error
     2776           or error-status :get-message(1) <> ""
     2777           then do:
     2778             undo move_block, retry move_block .
     2779           end.
     2780         end.
     2781       end.
     2782       if p-move-resize = true
     2783       then do:
     2784         run diasize_position-resize-button in this-procedure .
     2785       end.
     2786       if v-diasize-wndstore = true
     2787       then do:
     2788         if connected("ub") = true
     2789         then do:
     2790           define variable v-cntxt-db-num        as integer   no-undo .
     2791           define variable v-cntxt-userid        as character no-undo .
     2792           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2793                                             , OUTPUT v-cntxt-userid
     2794                                             ) .
     2795           run gbl/wndsizew.p
     2796             (input  v-cntxt-db-num
     2797             ,input  v-cntxt-userid
     2798             ,input  v-diasize-proc-name
     2799             ,input  'height':u
     2800             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2801             ) .
     2802         end.
     2803       end.
     2804     end.
     2805     assign
     2806       v-diasize-change-size = false
     2807     .
     2808   end procedure.
     2809   procedure diasize_set-height :
     2810     define input  parameter p-new-height  as decimal   no-undo .
     2811     define input  parameter p-move-resize as logical   no-undo .
     2812     do
     2813     on error undo, return error return-value
     2814     :
     2815       run diasize_change-height in this-procedure
     2816         (input  (p-new-height - frame Dialog-Frame :height)
     2817         ,input  p-move-resize
     2818         ) .
     2819     end.
     2820   end procedure.
     2821   procedure diasize_change-width :
     2822     define input  parameter p-change-value as decimal   no-undo .
     2823     define input  parameter p-move-resize  as logical   no-undo .
     2824     define variable v-field-group-handle   as handle    no-undo .
     2825     define variable v-object-handle        as handle    no-undo .
     2826     define variable v-frame-width          as decimal   no-undo .
     2827     define variable v-frame-virtual-width  as decimal   no-undo .
     2828     define variable v-browse-width         as decimal   no-undo .
     2829     define variable v-window-width         as decimal   no-undo .
     2830     define variable v-window-virtual-width as decimal   no-undo .
     2831     define variable v-change-sign          as integer   no-undo .
     2832     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2833     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2834     if p-change-value > 0
     2835     then do:
     2836       if frame Dialog-Frame :width + p-change-value >
     2837           session :width-chars
     2838       then do:
     2839         assign
     2840           p-change-value = session :width-chars - frame Dialog-Frame :width
     2841         .
     2842         if p-change-value <= 0
     2843         then do:
     2844           run diasize_position-resize-button in this-procedure .
     2845           return .
     2846         end.
     2847       end.
     2848     end.
     2849     if p-change-value < 0
     2850     then do:
     2851       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2852       then do:
     2853         assign
     2854           p-change-value = v-diasize-orig-frame-width
     2855                          - frame Dialog-Frame :width
     2856         .
     2857         if p-change-value >= 0
     2858         then do:
     2859           run diasize_position-resize-button in this-procedure .
     2860           return .
     2861         end.
     2862       end.
     2863     end.
     2864     if p-change-value >= 0
     2865     then do:
     2866       assign
     2867         v-change-sign = 1
     2868       .
     2869     end.
     2870     else do:
     2871       assign
     2872         v-change-sign = -1
     2873       .
     2874     end.
     2875     assign
     2876       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2877     .
     2878     if p-change-value = 0
     2879     then do:
     2880       run diasize_position-resize-button in this-procedure .
     2881       return .
     2882     end.
     2883     move_block:
     2884     do
     2885     on error undo move_block, leave move_block
     2886     :
     2887       if retry
     2888       then do:
     2889         do
     2890         on error undo move_block, leave move_block
     2891         :
     2892           if p-change-value > 0
     2893           then do:
     2894             for each buf_temp-diasize-handle
     2895             on error undo, next
     2896             :
     2897               assign
     2898                 v-object-handle = buf_temp-diasize-handle.handle-value
     2899               .
     2900               if v-object-handle <> v-diasize-resize-button
     2901               then do:
     2902                 assign
     2903                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2904                 .
     2905               end.
     2906             end.
     2907             assign
     2908               v-diasize-browse-handle :width = v-browse-width
     2909             .
     2910             for each buf_temp-browse-handle
     2911               where buf_temp-browse-handle.browse-type = 'width':u
     2912             on error undo, next
     2913             :
     2914               assign
     2915                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2916               .
     2917             end.
     2918             assign
     2919               frame Dialog-Frame :width = v-frame-width
     2920             .
     2921             if frame Dialog-Frame :scrollable = true
     2922             then do:
     2923               assign
     2924                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2925               .
     2926             end.
     2927             run diasize_position-resize-button in this-procedure .
     2928           end.
     2929           else do:
     2930             if frame Dialog-Frame :scrollable = true
     2931             then do:
     2932               assign
     2933                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2934               .
     2935             end.
     2936             assign
     2937               frame Dialog-Frame :width = v-frame-width
     2938             .
     2939             for each buf_temp-browse-handle
     2940               where buf_temp-browse-handle.browse-type = 'width':u
     2941             on error undo, next
     2942             :
     2943               assign
     2944                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2945               .
     2946             end.
     2947             assign
     2948               v-diasize-browse-handle :width = v-browse-width
     2949             .
     2950             for each buf_temp-diasize-handle
     2951             on error undo, next
     2952             :
     2953               assign
     2954                 v-object-handle = buf_temp-diasize-handle.handle-value
     2955               .
     2956               if v-object-handle <> v-diasize-resize-button
     2957               then do:
     2958                 assign
     2959                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2960                 .
     2961               end.
     2962             end.
     2963             run diasize_position-resize-button in this-procedure .
     2964           end.
     2965           assign
     2966             v-diasize-change-size = false
     2967           .
     2968           leave move_block .
     2969         end.
     2970       end.
     2971       assign
     2972         v-diasize-need-full-display = true
     2973       .
     2974       if v-diasize-change-size = false
     2975       then do:
     2976         assign
     2977           v-diasize-change-size = true
     2978         .
     2979       end.
     2980       else do:
     2981         return .
     2982       end.
     2983       assign
     2984         v-frame-width = frame Dialog-Frame :width
     2985         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2986         v-browse-width = v-diasize-browse-handle :width
     2987       .
     2988       for each buf_temp-browse-handle
     2989         where buf_temp-browse-handle.browse-type = 'width':u
     2990       :
     2991         assign
     2992           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2993         .
     2994       end.
     2995       for each buf_temp-diasize-handle
     2996       :
     2997         delete buf_temp-diasize-handle .
     2998       end.
     2999       assign
     3000         v-field-group-handle = frame Dialog-Frame :first-child
     3001       .
     3002       do while valid-handle(v-field-group-handle)
     3003       :
     3004         assign
     3005           v-object-handle = v-field-group-handle :first-child
     3006         .
     3007         do while valid-handle(v-object-handle)
     3008         :
     3009           if  v-object-handle <> v-diasize-browse-handle :handle
     3010           and v-object-handle <> v-diasize-resize-button
     3011           and can-query(v-object-handle, "row")
     3012           and can-query(v-object-handle, "height")
     3013           and ( v-object-handle :col + v-object-handle :width
     3014                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3015               )
     3016           then do:
     3017             find first buf_temp-browse-handle
     3018               where buf_temp-browse-handle.browse-type   = 'width':u
     3019                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3020               no-error .
     3021             if available buf_temp-browse-handle
     3022             then do:
     3023             end.
     3024             else do:
     3025               create buf_temp-diasize-handle .
     3026               assign
     3027                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3028                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3029               .
     3030             end.
     3031           end.
     3032           assign
     3033             v-object-handle = v-object-handle :next-sibling
     3034           .
     3035         end.
     3036         assign
     3037           v-field-group-handle = v-field-group-handle :next-sibling
     3038         .
     3039       end.
     3040       do with frame Dialog-Frame
     3041       :
     3042         hide v-diasize-resize-button .
     3043         v-diasize-resize-button :row = 1.
     3044         v-diasize-resize-button :column = 1.
     3045       end.
     3046       if p-change-value > 0
     3047       then do:
     3048         if frame Dialog-Frame :scrollable = true
     3049         then do:
     3050           assign
     3051             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3052             no-error .
     3053           if error-status :error
     3054           or error-status :get-message(1) <> ""
     3055           then do:
     3056             undo move_block, retry move_block.
     3057           end.
     3058         end.
     3059         assign
     3060           frame Dialog-Frame :width = v-frame-width + p-change-value
     3061           no-error .
     3062         if error-status :error
     3063         or error-status :get-message(1) <> ""
     3064         then do:
     3065           undo move_block, retry move_block.
     3066         end.
     3067         assign
     3068           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3069         no-error .
     3070         if error-status :error
     3071         or error-status :get-message(1) <> ""
     3072         then do:
     3073           undo move_block, retry move_block.
     3074         end.
     3075         for each buf_temp-browse-handle
     3076           where buf_temp-browse-handle.browse-type = 'width':u
     3077         on error undo move_block, retry move_block
     3078         :
     3079           assign
     3080             buf_temp-browse-handle.browse-handle :width
     3081               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3082             no-error .
     3083           if error-status :error
     3084           or error-status :get-message(1) <> ""
     3085           then do:
     3086             undo move_block, retry move_block .
     3087           end.
     3088         end.
     3089         for each buf_temp-diasize-handle
     3090         on error undo move_block, retry move_block
     3091         :
     3092           assign
     3093             v-object-handle = buf_temp-diasize-handle.handle-value
     3094           .
     3095           if v-object-handle <> v-diasize-resize-button
     3096           then do:
     3097             assign
     3098               v-object-handle :col = v-object-handle :col + p-change-value
     3099               no-error .
     3100             if error-status :error
     3101             or error-status :get-message(1) <> ""
     3102             then do:
     3103               undo move_block, retry move_block .
     3104             end.
     3105           end.
     3106         end.
     3107       end.
     3108       else do:
     3109         for each buf_temp-diasize-handle
     3110         on error undo move_block, retry move_block
     3111         :
     3112           assign
     3113             v-object-handle = buf_temp-diasize-handle.handle-value
     3114           .
     3115           if v-object-handle <> v-diasize-resize-button
     3116           then do:
     3117             assign
     3118               v-object-handle :col = v-object-handle :col + p-change-value
     3119               no-error .
     3120             if error-status :error
     3121             or error-status :get-message(1) <> ""
     3122             then do:
     3123               undo move_block, retry move_block .
     3124             end.
     3125           end.
     3126         end.
     3127         for each buf_temp-browse-handle
     3128           where buf_temp-browse-handle.browse-type = 'width':u
     3129         on error undo move_block, retry move_block
     3130         :
     3131           assign
     3132             buf_temp-browse-handle.browse-handle :width
     3133               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3134             no-error .
     3135           if error-status :error
     3136           or error-status :get-message(1) <> ""
     3137           then do:
     3138             undo move_block, retry move_block .
     3139           end.
     3140         end.
     3141         assign
     3142           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3143           no-error .
     3144         if error-status :error
     3145         or error-status :get-message(1) <> ""
     3146         then do:
     3147           undo move_block, retry move_block.
     3148         end.
     3149         assign
     3150           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3151         no-error .
     3152         if error-status :error
     3153         or error-status :get-message(1) <> ""
     3154         then do:
     3155           undo move_block, retry move_block.
     3156         end.
     3157         if frame Dialog-Frame :scrollable = true
     3158         then do:
     3159           assign
     3160             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3161           no-error .
     3162           if error-status :error
     3163           or error-status :get-message(1) <> ""
     3164           then do:
     3165             undo move_block, retry move_block.
     3166           end.
     3167         end.
     3168       end.
     3169       if p-move-resize
     3170       then do:
     3171         run diasize_position-resize-button in this-procedure .
     3172       end.
     3173       if v-diasize-wndstore = true
     3174       then do:
     3175         if connected("ub") = true
     3176         then do:
     3177           define variable v-cntxt-db-num        as integer   no-undo .
     3178           define variable v-cntxt-userid        as character no-undo .
     3179           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3180                                             , OUTPUT v-cntxt-userid
     3181                                             ) .
     3182           run gbl/wndsizew.p
     3183             (input  v-cntxt-db-num
     3184             ,input  v-cntxt-userid
     3185             ,input  v-diasize-proc-name
     3186             ,input  'width':u
     3187             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3188             ) .
     3189         end.
     3190       end.
     3191     end.
     3192     assign
     3193       v-diasize-change-size = false
     3194     .
     3195   end procedure.
     3196   procedure diasize_set-width :
     3197     define input  parameter p-new-width  as decimal   no-undo .
     3198     define input  parameter p-move-resize as logical   no-undo .
     3199     do
     3200     on error undo, return error return-value
     3201     :
     3202       run diasize_change-width in this-procedure
     3203         (input  (p-new-width - frame Dialog-Frame :width)
     3204         ,input  p-move-resize
     3205         ) .
     3206     end.
     3207   end procedure.
     3208   procedure diasize_position-resize-button :
     3209     do with frame Dialog-Frame
     3210     :
     3211       hide v-diasize-resize-button .
     3212       assign
     3213         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3214                     - 1
     3215                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3216         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3217                     - 1
     3218                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3219       .
     3220       view v-diasize-resize-button .
     3221     end.
     3222   end procedure.
     3223   on alt-right anywhere
     3224   do:
     3225     run diasize_change-width in this-procedure
     3226       (input 1
     3227       ,input true
     3228       ) .
     3229     return no-apply .
     3230   end.
     3231   on alt-left anywhere
     3232   do:
     3233     run diasize_change-width in this-procedure
     3234       (input -1
     3235       ,input true
     3236       ) .
     3237     return no-apply .
     3238   end.
     3239   on alt-down anywhere
     3240   do:
     3241     run diasize_change-height in this-procedure
     3242       (input 1
     3243       ,input true
     3244       ) .
     3245     return no-apply .
     3246   end.
     3247   on alt-up anywhere
     3248   do:
     3249     run diasize_change-height in this-procedure
     3250       (input -1
     3251       ,input true
     3252       ) .
     3253     return no-apply .
     3254   end.
     3255   on alt-enter of frame Dialog-Frame
     3256   do:
     3257     run diasize_maximize in this-procedure
     3258       (input  ?
     3259       ).
     3260     return no-apply .
     3261   end.
     3262   procedure diasize_end-move :
     3263     do
     3264     on error undo, return error return-value
     3265     :
     3266       define variable v-row-delta as decimal   no-undo .
     3267       define variable v-col-delta as decimal   no-undo .
     3268       define variable v-new-row as decimal   no-undo .
     3269       define variable v-new-col as decimal   no-undo .
     3270       assign
     3271         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3272         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3273       .
     3274       assign
     3275         v-row-delta = v-new-row - frame Dialog-Frame :height
     3276         v-col-delta = v-new-col - frame Dialog-Frame :width
     3277       .
     3278       run diasize_change-height in this-procedure
     3279         (input v-row-delta
     3280         ,input true
     3281         ) .
     3282       run diasize_change-width in this-procedure
     3283         (input v-col-delta
     3284         ,input true
     3285         ) .
     3286     end.
     3287   end procedure.
     3288   procedure diasize_maximize :
     3289     define input  parameter p-action as logical   no-undo .
     3290     do
     3291     on error undo, return error return-value
     3292     :
     3293       if p-action = ?
     3294       then do:
     3295         if v-diasize-need-maximize = true
     3296         then do:
     3297           assign
     3298             p-action = true
     3299           .
     3300         end.
     3301         else do:
     3302           assign
     3303             p-action = false
     3304           .
     3305         end.
     3306       end.
     3307       if p-action = true
     3308       then do:
     3309         run diasize_change-height in this-procedure
     3310           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3311               - frame Dialog-Frame :height-chars
     3312           ,input true
     3313           ) .
     3314         run diasize_change-width in this-procedure
     3315           (input session :width-chars
     3316               - frame Dialog-Frame :width-chars
     3317           ,input true
     3318           ) .
     3319         assign
     3320           v-diasize-need-maximize = false
     3321         .
     3322       end.
     3323       else do:
     3324         run diasize_change-width in this-procedure
     3325           (input v-diasize-orig-frame-width
     3326               - frame Dialog-Frame :width-chars
     3327           ,input true
     3328           ) .
     3329         run diasize_change-height in this-procedure
     3330           (input v-diasize-orig-frame-height
     3331               - frame Dialog-Frame :height-chars
     3332           ,input true
     3333           ) .
     3334         assign
     3335           v-diasize-need-maximize = true
     3336         .
     3337       end.
     3338     end.
     3339   end procedure.
     3340   procedure diasize_restore-orig-size :
     3341     do
     3342     on error undo, return error return-value
     3343     :
     3344       assign
     3345         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3346         v-diasize-current-frame-height = frame Dialog-Frame :height
     3347       .
     3348       run diasize_set-height in this-procedure
     3349         (input  v-diasize-orig-frame-height
     3350         ,input  true
     3351         ) .
     3352       run diasize_set-width in this-procedure
     3353         (input  v-diasize-orig-frame-width
     3354         ,input  true
     3355         ) .
     3356     end.
     3357   end procedure.
     3358   procedure diasize_restore-current-size :
     3359     do
     3360     on error undo, return error return-value
     3361     :
     3362       run diasize_set-height in this-procedure
     3363         (input  v-diasize-current-frame-height
     3364         ,input  true
     3365         ) .
     3366       run diasize_set-width in this-procedure
     3367         (input  v-diasize-current-frame-width
     3368         ,input  true
     3369         ) .
     3370     end.
     3371   end procedure.
     3372   procedure diasize_set-browse-handle :
     3373     define input  parameter p-browse-handle as handle   no-undo .
     3374     define buffer buf_temp-browse-handle for temp-browse-handle .
     3375     do
     3376     on error undo, return error return-value
     3377     :
     3378       assign
     3379         v-diasize-browse-handle = p-browse-handle
     3380       .
     3381       for each buf_temp-browse-handle
     3382       on error undo, return error return-value
     3383       :
     3384         delete buf_temp-browse-handle .
     3385       end.
     3386     end.
     3387   end procedure.
     3388   procedure diasize_add_browse :
     3389     define input  parameter p-browse-type   as character no-undo .
     3390     define input  parameter p-browse-handle as handle    no-undo .
     3391     define buffer buf_temp-browse-handle for temp-browse-handle .
     3392     do
     3393     on error undo, return error return-value
     3394     :
     3395       assign
     3396         v-diasize-browse-number = v-diasize-browse-number + 1
     3397       .
     3398       create buf_temp-browse-handle .
     3399       assign
     3400         buf_temp-browse-handle.browse-type   = p-browse-type
     3401         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3402         buf_temp-browse-handle.browse-handle = p-browse-handle
     3403       .
     3404     end.
     3405   end procedure.
     3406   procedure diasize_init :
     3407     define variable v-default-value    as logical   no-undo .
     3408     define variable v-restore-saved    as logical   no-undo .
     3409     define variable v-resize-value-str as character no-undo .
     3410     do
     3411     on error undo, return error return-value
     3412     :
     3413       do with frame Dialog-Frame
     3414       :
     3415         assign
     3416           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3417           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3418           v-diasize-browse-handle     = browse BR-rule-by-call :handle
     3419         .
     3420         create button v-diasize-resize-button
     3421         assign
     3422           parent        = frame Dialog-Frame :first-child
     3423           label         = "s"
     3424           height-pixels = 16
     3425           width-pixels  = 16
     3426           visible       = true
     3427           sensitive     = true
     3428           movable       = true
     3429           triggers:
     3430             on end-move persistent run diasize_end-move in this-procedure .
     3431           end triggers.
     3432         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3433         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3434         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3435         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3436         assign
     3437           v-diasize-wndmax = false
     3438         .
     3439         if connected("ub") = true
     3440         then do:
     3441           define variable v-cntxt-db-num        as integer   no-undo .
     3442           define variable v-cntxt-userid        as character no-undo .
     3443           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3444                                             , OUTPUT v-cntxt-userid
     3445                                             ) .
     3446           run gbl/wndpar_r.p
     3447             (input  v-cntxt-db-num
     3448             ,input  v-cntxt-userid
     3449             ,input  'wndmax':U
     3450             ,output v-diasize-wndmax
     3451             ,output v-default-value
     3452             ) .
     3453         end.
     3454         assign
     3455           v-diasize-wndstore = false
     3456         .
     3457         if connected("ub") = true
     3458         then do:
     3459           run gbl/wndpar_r.p
     3460             (input  v-cntxt-db-num
     3461             ,input  v-cntxt-userid
     3462             ,input  'wndstore':U
     3463             ,output v-diasize-wndstore
     3464             ,output v-default-value
     3465             ) .
     3466         end.
     3467         assign
     3468           v-diasize-proc-name = entry(1, program-name(2), '.')
     3469         .
     3470         if v-diasize-wndstore = true
     3471         then do:
     3472           assign
     3473             v-restore-saved = false
     3474           .
     3475           if connected("ub") = true
     3476           then do:
     3477             run gbl/wndsizer.p
     3478               (input  v-cntxt-db-num
     3479               ,input  v-cntxt-userid
     3480               ,input  v-diasize-proc-name
     3481               ,input  'height':u
     3482               ,output v-resize-value-str
     3483               ) .
     3484             if v-resize-value-str <> '':U
     3485             then do:
     3486               run diasize_change-height in this-procedure
     3487                 (input  integer(v-resize-value-str)
     3488                 ,input  true
     3489                 ) .
     3490               assign
     3491                 v-restore-saved = true
     3492               .
     3493             end.
     3494           end.
     3495           if connected("ub") = true
     3496           then do:
     3497             run gbl/wndsizer.p
     3498               (input  v-cntxt-db-num
     3499               ,input  v-cntxt-userid
     3500               ,input  v-diasize-proc-name
     3501               ,input  'width':u
     3502               ,output v-resize-value-str
     3503               ) .
     3504             if v-resize-value-str <> '':U
     3505             then do:
     3506               run diasize_change-width in this-procedure
     3507                 (input  integer(v-resize-value-str)
     3508                 ,input  true
     3509                 ) .
     3510               assign
     3511                 v-restore-saved = true
     3512               .
     3513             end.
     3514           end.
     3515           if v-restore-saved <> true
     3516           then do:
     3517             if v-diasize-wndmax = true
     3518             then do:
     3519               run diasize_maximize in this-procedure
     3520                 (input  true
     3521                 ) .
     3522             end.
     3523           end.
     3524         end.
     3525         else do:
     3526           if v-diasize-wndmax = true
     3527           then do:
     3528             run diasize_maximize in this-procedure
     3529               (input  true
     3530               ) .
     3531           end.
     3532         end.
     3533       end.
     3534     end.
     3535   end procedure.
     3536   procedure diasize_need-full-display :
     3537     define output parameter p-need-full-display as logical   no-undo .
     3538     do
     3539     on error undo, return error return-value
     3540     :
     3541       assign
     3542         p-need-full-display = v-diasize-need-full-display
     3543       .
     3544       assign
     3545         v-diasize-need-full-display = false
     3546       .
     3547     end.
     3548   end procedure.
     3549   procedure get-context :
     3550      define output parameter p-db-num as integer          no-undo.
     3551      define output parameter p-user-id as character        no-undo.
     3552      define variable v-login               as character    no-undo.
     3553      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3554      define buffer buf_user-login  for ub.user-login .
     3555      do
     3556      on error undo, return error
     3557      :
     3558            FIND FIRST buf_sys-ctrl no-lock.
     3559            ASSIGN
     3560               v-login = USERID("ub")
     3561               p-db-num = buf_sys-ctrl.db-num
     3562            .
     3563            FIND FIRST buf_user-login
     3564                 WHERE buf_user-login.db-num = p-db-num
     3565                   AND buf_user-login.user-login = v-login
     3566                 no-lock
     3567                 no-error
     3568                 .
     3569            IF AVAILABLE buf_user-login
     3570            THEN DO:
     3571               assign
     3572                  p-user-id = buf_user-login.user-id
     3573               .
     3574            END.
     3575      end.
     3576   end procedure.
     3577       run diasize_init in this-procedure .
     3578   MAIN-BLOCK:
     3579   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3580      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3581   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3582     run mainmenu_getcntxt in parparentproc
     3583       (output v-cntxt-db-num
     3584       ,output v-cntxt-userid
     3585       ,output v-cntxt-level
     3586       ,output v-cntxt-host-code-obj
     3587       ,output v-cntxt-obj-type
     3588       ,output v-cntxt-obj-code
     3589       ,output v-cntxt-db-num-obj
     3590       ,output v-cntxt-is-admin
     3591       ) .
     3592     if p-mode = 'shd':U then do:
     3593       assign
     3594       frame Dialog-Frame :title = frame Dialog-Frame :title +
     3595                         substitute(". &1: Задача номер &2"
     3596                         , p-task-type
     3597                         , p-task-num )
     3598       .
     3599     end.
     3600     run init-param-values in this-procedure (
     3601         input p-cre-db-num
     3602       , input p-task-type
     3603       , input p-task-num
     3604       , OUTPUT v-param-list).
     3605     RUN init-fields in this-procedure .
     3606     FOR EACH tt0-rule-by-call:
     3607       DELETE tt0-rule-by-call.
     3608     END.
     3609     RUN fill-table IN THIS-PROCEDURE (  input v-dc-type-list-mode
     3610                                        ,input v-dc-type-list
     3611                                        ,input yes ).
     3612     RUN Myenable in this-procedure .
     3613     WAIT-FOR GO OF FRAME Dialog-Frame.
     3614   END.
     3615   RUN disable_UI.
     3616   PROCEDURE attach-attr-to-schedule-line :
     3617   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     3618   define buffer buf_schedule      for ub.schedule.
     3619   define buffer buf_schedule-attr for ub.schedule-attr.
     3620   CASE p-mode:
     3621     when 'shd':U then do:
     3622         FIND FIRST buf_schedule-attr NO-LOCK WHERE
     3623                    buf_schedule-attr.cre-db-num = p-cre-db-num
     3624                and buf_schedule-attr.task-type  = p-task-type
     3625                and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'uclcdcpc') NO-ERROR.
     3626         find first buf_schedule no-lock
     3627              where buf_schedule.cre-db-num = p-cre-db-num
     3628                and buf_schedule.task-type  = p-task-type
     3629                and buf_schedule.task-num   = p-task-num
     3630         no-error.
     3631         if not available buf_schedule
     3632         and (  p-task-type   <> 'autofree':U
     3633             or p-task-num    <> -1 )
     3634         then do:
     3635             message
     3636               vss-workfile vss-revision vss-description
     3637               skip "Не найдена строка расписания."
     3638               skip return-value
     3639               skip trim(error-status :get-message(1))
     3640                    trim(error-status :get-message(2))
     3641                    trim(error-status :get-message(3))
     3642             view-as alert-box error.
     3643             undo, return error .
     3644         end.
     3645       run schedule-attr-write in this-procedure (
     3646             input p-cre-db-num
     3647           , input p-task-type
     3648           , input p-task-num
     3649           , input 'schedule-param-list':U
     3650           , input p-param-list
     3651       ).
     3652     end.
     3653     when 'run':U then do:
     3654       p-params = p-param-list.
     3655     end.
     3656   END CASE.
     3657   END PROCEDURE.
     3658   PROCEDURE disable_UI :
     3659     HIDE FRAME Dialog-Frame.
     3660   END PROCEDURE.
     3661   PROCEDURE enable_UI :
     3662     DISPLAY RS-dc-list-mode RS-dc-type-list-mode Rs-update-mode E-dc-type editor-1
     3663             f-dc-type-label mark-num
     3664         WITH FRAME Dialog-Frame.
     3665     ENABLE B-exit b-quit b-lst B-Help RS-dc-list-mode RS-dc-type-list-mode
     3666            Rs-update-mode E-dc-type B-mark BR-rule-by-call editor-1 mark-num
     3667         WITH FRAME Dialog-Frame.
     3668     VIEW FRAME Dialog-Frame.
     3669     OPEN QUERY BR-rule-by-call FOR EACH tt0-rule-by-call NO-LOCK WHERE         tt0-rule-by-call.codex_id = 2      AND tt0-rule-by-call.ruleset_id = 5      AND tt0-rule-by-call.can-calc = YES INDEXED-REPOSITION.
     3670   END PROCEDURE.
     3671   PROCEDURE init-fields :
     3672   DEFINE VARIABLE v-out AS CHARACTER NO-UNDO.
     3673   define variable ii as integer no-undo .
     3674   DEFINE VARIABLE glog AS logical NO-UNDO.
     3675   define variable v-tbl-row as rowid no-undo .
     3676   ASSIGN
     3677   rs-update-mode = v-update-mode
     3678   rs-dc-list-mode = v-dc-list-mode
     3679   rs-dc-type-list-mode = v-dc-type-list-mode
     3680   e-dc-type   = replace(v-dc-type-list, chr(44), chr(10))
     3681   .
     3682   DO ii = 1 TO NUM-ENTRIES(v-dc-type-algo-list):
     3683     RUN gen-temp-row-keyr IN THIS-PROCEDURE (
     3684                                              INPUT ENTRY(ii, v-dc-type-algo-list)
     3685                                             ,INPUT "tt0-"
     3686                                             ,OUTPUT v-tbl-row).
     3687     ASSIGN
     3688     v-rid-list = v-rid-list + (IF ii = 1 THEN '':U ELSE chr(44)) + string(v-tbl-row).
     3689   END.
     3690   END PROCEDURE.
     3691   PROCEDURE init-param-values :
     3692   do
     3693   on error undo, return error
     3694   :
     3695   define input parameter p-cre-db-num     as integer      no-undo .
     3696   define input parameter p-task-type      as character    no-undo.
     3697   define input parameter p-task-num       as integer      no-undo.
     3698   define output parameter p-dir                   as character    no-undo.
     3699   define variable v-param-list    as character     no-undo.
     3700   define variable v-param-type    as character     no-undo.
     3701   define variable ii as integer   no-undo .
     3702   define variable v-entry  as character no-undo .
     3703   define variable v-task-num as integer   no-undo .
     3704   define buffer buf_schedule for ub.schedule.
     3705   define buffer buf_schedule-attr for ub.schedule-attr.
     3706     CASE p-mode:
     3707       when 'shd':U then do:
     3708         if p-task-num > 0 then do:
     3709           v-task-num = p-task-num.
     3710         end.
     3711         else do:
     3712           for each buf_schedule no-lock where
     3713                   buf_schedule.cre-db-num = p-cre-db-num
     3714               AND buf_schedule.task-type  = p-task-type,
     3715               first buf_schedule-attr no-lock where
     3716                     buf_schedule-attr.cre-db-num = p-cre-db-num
     3717                 AND buf_schedule-attr.task-type  = p-task-type
     3718                 AND buf_schedule-attr.task-num = buf_schedule.task-num
     3719                 AND buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'uclcdcpc') :
     3720              v-task-num = buf_schedule.task-num.
     3721              leave .
     3722           end.
     3723         end.
     3724         if v-task-num > 0 then do:
     3725           run schedule-attr-value in this-procedure (
     3726                 input p-cre-db-num
     3727               , input p-task-type
     3728               , input v-task-num
     3729               , input 'schedule-param-list':U
     3730               , output v-param-list
     3731               , output v-param-type
     3732           ) NO-ERROR.
     3733         end.
     3734         if v-param-list = '':U then
     3735         assign
     3736         v-param-list = "ALL" + chr(4)   +
     3737                        "update" + chr(4) +
     3738                        "*" + chr(4) +
     3739                        '':U + chr(4) +
     3740                        ''.
     3741       END.
     3742       WHEN 'run' THEN DO:
     3743         assign
     3744         v-param-list = "ALL" + chr(4)  +
     3745                        "check-0" + chr(4) +
     3746                        "LIST" + chr(4) +
     3747                        '':U + chr(4) +
     3748                        ''.
     3749       END.
     3750     END CASE.
     3751     ASSIGN
     3752     v-dc-list-mode = entry(1, v-param-list, chr(4))
     3753     v-update-mode = entry(2, v-param-list, chr(4))
     3754     v-dc-type-list-mode = entry(3, v-param-list, chr(4))
     3755     v-dc-type-list = replace(entry(4, v-param-list, chr(4)), chr(10), chr(44))
     3756     v-dc-type-algo-list = entry(5, v-param-list, chr(4))
     3757     .
     3758   END.
     3759   END PROCEDURE.
     3760   PROCEDURE MyEnable :
     3761   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3762   v-h = br-rule-by-call:FIRST-COLUMN IN FRAME Dialog-Frame.
     3763   DO while valid-handle(v-h) :
     3764     if v-h:LABEL = "Место вызова обсчета" then do:
     3765       v-h:RESIZABLE = YES.
     3766       leave.
     3767     end.
     3768     ELSE DO:
     3769       v-h = v-h:NEXT-COLUMN.
     3770     END.
     3771   END.
     3772   rs-update-mode:RADIO-BUTTONS IN FRAME Dialog-Frame =
     3773       "Проверка" + chr(44) +
     3774     "check-0" + chr(44) +
     3775     "Расчет (с сохранением)" + chr(44) +
     3776     "update".
     3777   DISPLAY
     3778   RS-dc-list-mode
     3779   RS-dc-type-list-mode
     3780   Rs-update-mode
     3781   E-dc-type
     3782   mark-num
     3783   editor-1
     3784   WITH FRAME Dialog-Frame.
     3785   ENABLE
     3786   B-exit
     3787   b-quit
     3788   RS-dc-list-mode when p-mode = "run"
     3789   b-lst
     3790   B-Help
     3791   RS-dc-type-list-mode
     3792   Rs-update-mode
     3793   E-dc-type
     3794   B-mark when p-mode = "run"
     3795   BR-rule-by-call
     3796   mark-num
     3797   editor-1
     3798   WITH FRAME Dialog-Frame.
     3799   VIEW FRAME Dialog-Frame.
     3800   IF v-rid-list = '':U THEN DO:
     3801       HIDE
     3802       mark-num
     3803       IN FRAME Dialog-Frame.
     3804   END.
     3805   ELSE DO:
     3806       DISPLAY
     3807       NUM-ENTRIES(v-rid-list) @ mark-num
     3808       with FRAME Dialog-Frame.
     3809   END.
     3810   RUN openbr IN THIS-PROCEDURE.
     3811   APPLY "VALUE-CHANGED" TO rs-dc-list-mode.
     3812   APPLY "VALUE-CHANGED" TO br-rule-by-call.
     3813   END PROCEDURE.
     3814   PROCEDURE Openbr :
     3815   OPEN QUERY BR-rule-by-call FOR EACH tt0-rule-by-call.
     3816   END PROCEDURE.
     3817   PROCEDURE proc-save :
     3818   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3819   define variable ii as integer   no-undo .
     3820   define variable v-exists as logical no-undo .
     3821   DEFINE VARIABLE v-key-rec AS CHARACTER NO-UNDO.
     3822   DEFINE buffer buf_tt0-rule-by-call FOR tt0-rule-by-call.
     3823   IF rs-dc-type-list-mode = "LIST"
     3824   AND e-dc-type:screen-value in frame Dialog-Frame = '':u  then do:
     3825    message
     3826    "Не задан список типов ДК"
     3827    view-as alert-box error .
     3828    return error.
     3829   end.
     3830   IF rs-dc-type-list-mode = "*"
     3831   AND v-rid-list = '':u
     3832   and p-mode = "run"
     3833   then do:
     3834    message
     3835    "Не задан список алгоритмов для расчета"
     3836    view-as alert-box error .
     3837    return error.
     3838   end.
     3839   IF rs-dc-list-mode = "LIST"
     3840   AND NOT CAN-FIND(FIRST dc-list)
     3841   AND p-mode = "run" THEN DO:
     3842     message
     3843    "Не задан список ДК"
     3844    view-as alert-box error .
     3845    return error.
     3846   END.
     3847   if v-rid-list <> '':U then do:
     3848     DO ii =1 TO NUM-ENTRIES(v-rid-list):
     3849     FIND first buf_tt0-rule-by-call NO-LOCK WHERE
     3850               rowid(buf_tt0-rule-by-call) = TO-ROWID(entry(ii, v-rid-list)) NO-ERROR.
     3851     IF AVAILABLE buf_tt0-rule-by-call THEN DO:
     3852     ASSIGN
     3853     v-dc-type-algo-list = (IF ii = 1 THEN '':U ELSE chr(44)) +
     3854                            buf_tt0-rule-by-call.uniq-key-rec.
     3855     END.
     3856     END.
     3857   end.
     3858   ASSIGN
     3859   v-param-list =  rs-dc-list-mode + chr(4) +
     3860                   rs-update-mode + chr(4) +
     3861                   rs-dc-type-list-mode + chr(4) +
     3862                   replace(e-dc-type:SCREEN-VALUE, chr(10), chr(44)) + chr(4) +
     3863                   v-dc-type-algo-list.
     3864   IF p-mode = 'shd' THEN DO:
     3865       run attach-attr-to-schedule-line in this-procedure (
     3866             INPUT v-param-list
     3867       ) NO-ERROR.
     3868     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3869   END.
     3870   END PROCEDURE.
