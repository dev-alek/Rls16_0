      159   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   define  new shared  temp-table dc-list-hist no-undo
      161   field list-table as character
      162   field id as integer
      163   field line as integer
      164   field hist-mode as character
      165   field des as character
      166   field num-recs as integer
      167   field option_ as character
      168   field item_ as character
