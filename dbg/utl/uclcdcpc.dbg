      127     run proc-alt-shift-f3 in this-procedure .
      128   end.
      129   on alt-shift-f4 anywhere do:
      130     run proc-alt-shift-f4 in this-procedure.
      131   end.
      132   on alt-f1 anywhere do:
      133     run proc-alt-f1 in this-procedure .
      134   end.
      135   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136     define variable v-cntxt-db-num        as integer   no-undo .
      137     define variable v-cntxt-userid        as character no-undo .
      138     define variable v-cntxt-level         as character no-undo .
      139     define variable v-cntxt-host-code-obj as integer   no-undo .
      140     define variable v-cntxt-obj-type      as character no-undo .
      141     define variable v-cntxt-obj-code      as integer   no-undo .
      142     define variable v-cntxt-db-num-obj    as integer   no-undo .
      143     define variable v-cntxt-is-admin      as logical   no-undo .
      144   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   define new shared temp-table dc-list no-undo like ub.dis-card
      146     field to-del as logical
      147     field order-num as integer
      148     field fdec as decimal
      149     field fint as integer
      150     field flog as logical
