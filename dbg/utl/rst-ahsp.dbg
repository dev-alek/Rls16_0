     2347   procedure userobjs_transfer :
     2348     define input  parameter p-callback-handle as handle no-undo .
     2349     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     2350     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2351     do
     2352     on error undo, return error return-value
     2353     :
     2354       if valid-handle(p-callback-handle) <> true
     2355       then do:
     2356         message
     2357           vss-workfile vss-revision vss-description skip
     2358           "Ошибка задания входных параметров" skip
     2359           "Неизвестный указатель на процедуру" skip
     2360           view-as alert-box error .
     2361         undo, return error return-value .
     2362       end.
     2363       if p-callback-handle :get-signature("userobjs_append") = ""
     2364       then do:
     2365         message
     2366           vss-workfile vss-revision vss-description skip
     2367           "Ошибка задания входных параметров" skip
     2368           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     2369                     ,p-callback-handle :file-name
     2370                     ) skip
     2371           view-as alert-box error .
     2372         undo, return error return-value .
     2373       end.
     2374       for each buf_userobjs_temp-user-obj
     2375       on error undo, return error return-value
     2376       :
     2377         run userobjs_append in p-callback-handle
     2378           (input  buf_userobjs_temp-user-obj.obj-type
     2379           ,input  buf_userobjs_temp-user-obj.obj-code
     2380           ) .
     2381       end.
     2382     end.
     2383   end procedure.
