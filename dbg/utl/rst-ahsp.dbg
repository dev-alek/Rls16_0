     3319           error-status :get-message(1) skip
     3320           return-value skip
     3321           view-as alert-box error .
     3322         undo, return error return-value .
     3323       end.
     3324       input stream sinp from value(v-file-name) .
     3325       run validate-file-name in this-procedure
     3326         (input  v-obj-type
     3327         ,input  v-obj-code
     3328         ,input  v-ahsp-detail-date
     3329         ,input  v-file-name
     3330         ,output v-restore-start-date
     3331         ,output v-restore-detail-date
     3332         ) no-error .
     3333       if error-status :error
     3334       then do:
     3335         message
     3336           vss-workfile vss-revision vss-description skip
     3337           "Складской архив по поставщикам" skip
     3338           "Объект" v-obj-type v-obj-code skip
     3339           "Ошибка при закрытии файла архивации" skip
     3340           "Имя файла архивации" v-file-name skip
     3341           error-status :get-message(1) skip
     3342           return-value skip
     3343           view-as alert-box error .
     3344         undo, return error return-value .
     3345       end.
     3346       run restore-from-file in this-procedure .
     3347       define variable v-close-restore-start-date  as date      no-undo .
     3348       define variable v-close-restore-detail-date as date      no-undo .
     3349       run validate-file-name in this-procedure
     3350         (input  v-obj-type
     3351         ,input  v-obj-code
     3352         ,input  v-ahsp-detail-date
     3353         ,input  v-file-name
     3354         ,output v-close-restore-start-date
     3355         ,output v-close-restore-detail-date
     3356         ) no-error .
     3357       if error-status :error
     3358       then do:
     3359         message
     3360           vss-workfile vss-revision vss-description skip
     3361           "Складской архив по поставщикам" skip
     3362           "Объект" v-obj-type v-obj-code skip
     3363           "Ошибка при закрытии файла архивации" skip
     3364           "Имя файла архивации" v-file-name skip
     3365           error-status :get-message(1) skip
     3366           return-value skip
     3367           view-as alert-box error .
     3368         undo, return error return-value .
     3369       end.
     3370       if v-close-restore-start-date  <> v-restore-start-date
     3371       or v-close-restore-detail-date <> v-restore-detail-date
     3372       then do:
     3373         message
     3374           vss-workfile vss-revision vss-description skip
     3375           "Складской архив по поставщикам" skip
     3376           "Объект" v-obj-type v-obj-code skip
     3377           "Ошибка при закрытии файла архивации" skip
     3378           "Не соответствие дат начала архива и начала подробнго архива в конце и в начала файла" skip
     3379           "Дата начала архива в начале файла" v-restore-start-date skip
     3380           "Дата начала подробного архива в началей файла" v-restore-detail-date skip
     3381           "Дата начала архива в конце файла" v-close-restore-start-date skip
     3382           "Дата начала подробного архива в конца файла" v-close-restore-detail-date skip
     3383           view-as alert-box error .
     3384         undo, return error return-value .
     3385       end.
     3386       input stream sinp close .
     3387       run clntattr-write in this-procedure
     3388         (input v-obj-type
     3389         ,input v-obj-code
     3390         ,input 'ahsp-start':U
     3391         ,input string(v-restore-start-date, '99/99/9999':u)
     3392         ) no-error .
     3393       if error-status :error
     3394       then do:
     3395         message
     3396           vss-workfile vss-revision vss-description skip
     3397           "Ошибка при записи даты начала складского архива по поставщикам" skip
     3398           error-status :get-message(1) skip
     3399           return-value skip
     3400           view-as alert-box error .
     3401         undo, return error return-value .
     3402       end.
     3403       run clntattr-write in this-procedure
     3404         (input v-obj-type
     3405         ,input v-obj-code
     3406         ,input 'ahsp-detail':U
     3407         ,input string(v-restore-detail-date, '99/99/9999':u)
     3408         ) no-error .
     3409       if error-status :error
     3410       then do:
     3411         message
     3412           vss-workfile vss-revision vss-description skip
     3413           "Ошибка при записи даты начала подробного складского архива по поставщикам" skip
     3414           error-status :get-message(1) skip
     3415           return-value skip
     3416           view-as alert-box error .
     3417         undo, return error return-value .
     3418       end.
