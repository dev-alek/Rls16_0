     2568     )  .
     2569     define buffer restore-ahsp-lock_batchprocess for ub.batchprocess .
     2570     run gbl/lock-prc.p
     2571       (input 'rsas':U
     2572       ,input v-obj-code
     2573       ,input 0
     2574       ,input 0
     2575       ,input v-obj-type
     2576       ,input ""
     2577       ,input ""
     2578       ,input "Объект,,, ,,,Восстановление складского архива по поставщикам"
     2579       ,input true
     2580       ,buffer restore-ahsp-lock_batchprocess
     2581       ) no-error .
     2582     if error-status :error
     2583     then do:
     2584       if error-status :get-message(1) <> ""
     2585       then do:
     2586         message
     2587           vss-workfile vss-revision vss-description skip
     2588           "В данный момент восстанавливается складской архив по поставщикам" skip
     2589           "Невозможно произвести восстановлением складского архива по поставщикам" skip
     2590           view-as alert-box error .
     2591       end.
     2592       undo, return error "В данный момент восстанавливается складской архив по поставщикам" .
     2593     end.
     2594     run gbl/lock-prc.p
     2595       (input 'ahsp':U
     2596       ,input v-obj-code
     2597       ,input 0
     2598       ,input 0
     2599       ,input v-obj-type
     2600       ,input ""
     2601       ,input ""
     2602       ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
     2603       ,input true
     2604       ,buffer calc-supp-arh-lock_batchprocess
     2605       ) no-error .
     2606     if error-status :error
     2607     then do:
     2608       if error-status :get-message(1) <> ""
     2609       then do:
     2610         message
     2611           vss-workfile vss-revision vss-description skip
     2612           "В данный момент рассчитывается складской архив по поставщикам" skip
     2613           "Невозможно произвести расчёт складского архива по поставщикам" skip
     2614           view-as alert-box error .
     2615       end.
     2616       undo, return error "В данный момент рассчитывается складской архив по поставщикам" .
     2617     end.
     2618     define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     2619     run gbl/lockrngd.p
     2620       (input  'grar':U
     2621       ,input  'disable':U
     2622       ,buffer buf_lock_gdsrenart_batchprocess
     2623       ) no-error .
     2624     if error-status :error
     2625     then do:
     2626       if error-status :get-message(1) <> ""
     2627       then do:
     2628         message
     2629           vss-workfile vss-revision vss-description skip
     2630           "Ошибка при блокировании функции переименования артикула товара" skip
     2631           error-status :get-message(1) skip
     2632           return-value skip
     2633           view-as alert-box error .
     2634       end.
     2635       undo, return error return-value .
     2636     end.
     2637     define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     2638     run gbl/lockrngd.p
     2639       (input  'grgc':U
     2640       ,input  'disable':U
     2641       ,buffer buf_lock_gdsrengc_batchprocess
     2642       ) no-error .
     2643     if error-status :error
     2644     then do:
     2645       if error-status :get-message(1) <> ""
     2646       then do:
     2647         message
     2648           vss-workfile vss-revision vss-description skip
     2649           "Ошибка при блокировании функции переименования кода товара" skip
     2650           error-status :get-message(1) skip
     2651           return-value skip
     2652           view-as alert-box error .
     2653       end.
     2654       undo, return error return-value .
     2655     end.
     2656     define variable v-attr-value as character no-undo .
     2657     define variable v-attr-type  as character no-undo .
     2658     define variable v-ahsp-calc          as logical   no-undo .
     2659     define variable v-ahsp-del           as logical   no-undo .
     2660     define variable v-ahsp-start-date    as date      no-undo .
     2661     define variable v-ahsp-detail-date   as date      no-undo .
     2662     define variable v-ahsp-recalc-date   as date      no-undo .
     2663     run clntattr-value in this-procedure
     2664       (input  v-obj-type
     2665       ,input  v-obj-code
     2666       ,input  'ahsp-calc':U
     2667       ,output v-attr-value
     2668       ,output v-attr-type
     2669       ) .
     2670     assign
     2671       v-ahsp-calc = (lookup(v-attr-value, 'yes,true') > 0)
     2672     .
     2673     run clntattr-value in this-procedure
     2674       (input  v-obj-type
     2675       ,input  v-obj-code
     2676       ,input  'ahsp-del':U
     2677       ,output v-attr-value
     2678       ,output v-attr-type
     2679       ) .
     2680     assign
     2681       v-ahsp-del = (lookup(v-attr-value, 'yes,true') > 0)
     2682     .
     2683     run clntattr-value in this-procedure
     2684       (input  v-obj-type
     2685       ,input  v-obj-code
     2686       ,input  'ahsp-start':U
     2687       ,output v-attr-value
     2688       ,output v-attr-type
     2689       ) .
     2690     assign
     2691       v-ahsp-start-date = date(v-attr-value)
     2692     .
     2693     run clntattr-value in this-procedure
     2694       (input  v-obj-type
     2695       ,input  v-obj-code
     2696       ,input  'ahsp-detail':U
     2697       ,output v-attr-value
     2698       ,output v-attr-type
     2699       ) .
     2700     assign
     2701       v-ahsp-detail-date = date(v-attr-value)
     2702     .
     2703     run clntattr-value in this-procedure
     2704       (input  v-obj-type
     2705       ,input  v-obj-code
     2706       ,input  'ahsp-recalc':U
     2707       ,output v-attr-value
     2708       ,output v-attr-type
     2709       ) .
     2710     assign
     2711       v-ahsp-recalc-date = date(v-attr-value)
     2712     .
     2713     if (v-ahsp-start-date <> ?
     2714        and v-ahsp-detail-date = ?)
     2715     or (v-ahsp-start-date = ?
     2716        and v-ahsp-detail-date <> ?)
     2717     then do:
     2718       message
     2719         "Складской архив по поставщикам" skip
     2720         "Объект" v-obj-type v-obj-code skip
     2721         "Невозможно произвести восстановление складского архива по поставщикам" skip
     2722         "Противоречивая информация в датах инициализации складского архива по поставщикам" skip
     2723         "Дата начала складского архива по поставщикам" string(v-ahsp-start-date, '99/99/9999':u) skip
     2724         "Дата начала подробного складского архива по поставщикам" string(v-ahsp-detail-date, '99/99/9999':u) skip
     2725         view-as alert-box error .
     2726       undo, return error return-value .
     2727     end.
     2728     if v-ahsp-detail-date = ?
     2729     then do:
     2730       message
     2731         "Складской архив по поставщикам" skip
     2732         "Объект" v-obj-type v-obj-code skip
     2733         "На объекте рассчитан складской архив по поставщикам за все даты" skip
     2734         "Операция восстановления не может быть произведена" skip
     2735         view-as alert-box information .
     2736       return .
     2737     end.
     2738     define variable v-year  as integer   no-undo .
     2739     define variable v-month as integer   no-undo .
     2740     define variable v-day   as integer   no-undo .
     2741     assign
     2742       v-year  = year(v-ahsp-detail-date)
     2743       v-month = month(v-ahsp-detail-date)
     2744       v-day   = day(v-ahsp-detail-date)
     2745     .
     2746     assign
     2747       v-file-name = 'ahspdel':u
     2748                   + '_':u
     2749                   + (if v-obj-type = 'скл':U then 'stock':u else 'shop':u)
     2750                   + '_':u
     2751                   + string(v-obj-code)
     2752                   + '_':u
     2753                   + string(v-year, '9999':u)
     2754                   + string(v-month, '99':u)
     2755                   + string(v-day, '99':u)
     2756                   + '.txt'
     2757     .
     2758     assign
     2759       v-backup-file-name = entry(1, v-file-name, '.') + '.rst':u
     2760     .
     2761     define variable v-full-file-name as character no-undo .
     2762     define variable v-full-backup-name  as character no-undo .
     2763     define variable v-restore-from-file as logical   no-undo .
     2764     define variable v-restore-backup    as logical   no-undo .
     2765     assign
     2766       v-full-file-name = search(v-file-name)
     2767     .
     2768     if v-full-file-name = ?
     2769     or v-full-file-name = ""
     2770     then do:
     2771       assign
     2772         v-restore-from-file = false
     2773       .
     2774     end.
     2775     else do:
     2776       assign
     2777         v-restore-from-file = true
     2778       .
     2779     end.
     2780     assign
     2781       v-full-backup-name = search(v-backup-file-name)
     2782     .
     2783     if v-full-backup-name = ?
     2784     or v-full-backup-name = ""
     2785     then do:
     2786       assign
     2787         v-restore-backup = false
     2788       .
     2789     end.
     2790     else do:
     2791       assign
     2792         v-restore-backup = true
     2793       .
     2794     end.
     2795     define variable v-num as integer   no-undo .
     2796     run gbl/d-askw.w
     2797       (input "Вопрос"
     2798       ,input substitute("Объект &1 &2", v-obj-type, v-obj-code) + chr(10)
     2799              + "Произвести восстановление подробного складского архива по поставщикам" + chr(10)
     2800              + "Дата начала подробного складского архива по поставщикам " + string(v-ahsp-detail-date, '99/99/9999':U) + chr(10)
     2801              + "Сегодня " + string(v-today, '99/99/9999':U) + chr(10)
     2802       ,input '|^':u
     2803       ,input "Из файла" + '^confirm':u + (if v-restore-from-file = true then '':u else '^disable':u)
     2804       + '|':u + "Резервная копия" + '^confirm':u + (if v-restore-backup = true then '':u else '^disable':u)
     2805       + '|':u + "Документы" + '^confirm':u + (if v-ahsp-del = true then '^disable':u else '':u)
     2806       + '|':u + "Отказ"
