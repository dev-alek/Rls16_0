     3462       run doclslib-init-price-doc in this-procedure
     3463         (input  v-obj-type
     3464         ,input  v-obj-code
     3465         ,input  v-restore-detail-date
     3466         ) no-error .
     3467       if error-status :error
     3468       then do:
     3469         message
     3470           vss-workfile vss-revision vss-description skip
     3471           "Ошибка при заполнении списка переоценок" skip
     3472           "Объект" v-obj-type v-obj-code skip
     3473           "Дата" v-restore-detail-date skip
     3474           view-as alert-box error .
     3475         undo, return error return-value .
     3476       end.
     3477       run doclslib-clear-rst in this-procedure
     3478         (input v-ahsp-detail-date
     3479         ) .
     3480       run doclslib-init-goods in this-procedure .
     3481       run rst-ahsp-init-clients-goods in this-procedure .
     3482       run rst-ahsp-init-clients in this-procedure .
     3483       run clntattr-write in this-procedure
     3484         (input v-obj-type
     3485         ,input v-obj-code
     3486         ,input 'ahsp-rest':U
     3487         ,input 'true':u
     3488         ) .
     3489       run temp-supp-gds-fill in this-procedure
     3490         (input v-obj-type
     3491         ,input v-obj-code
     3492         ,input v-day-end-fact-order
     3493         ) .
     3494       run temp-supp-gds-from-doclslib in this-procedure .
     3495       run ahrstutl-init in this-procedure
     3496         (input  v-obj-type
     3497         ,input  v-obj-code
     3498         ,input  v-ahsp-detail-date - 1
     3499         ,input  false
     3500         ) .
     3501       run ahrstutl-create-stk in this-procedure
     3502         (input  v-obj-type
     3503         ,input  v-obj-code
     3504         ,input  v-ahsp-detail-date - 1
     3505         ) .
     3506       run ahrstutl-clear-ahsp in this-procedure
     3507         (input  v-obj-type
     3508         ,input  v-obj-code
     3509         ,input  v-start-day-end-fact-order
     3510         ,input  v-ahsp-detail-date - 1
     3511         ) .
     3512       find current calc-supp-arh-lock_batchprocess no-lock .
     3513       if v-clear-start = true
     3514       then do:
     3515         run show-action in this-procedure
     3516           (input "Инициализация остатка на дату нового начала складского архива"
     3517           ).
     3518         run trg/inahsp.p
     3519           (input  this-procedure :handle
     3520           ,input  v-obj-type
     3521           ,input  v-obj-code
     3522           ,input  v-restore-start-date - 1
     3523           ,input  v-ahsp-detail-date - 1
     3524           ) .
     3525       end.
     3526       run show-action in this-procedure
     3527         (input "Расчёт складского архива по поставщикам"
     3528         ).
     3529       run doclslib-calc-ahsp in this-procedure
     3530         (input this-procedure
     3531         ,input v-obj-type
     3532         ,input v-obj-code
     3533         ,input v-ahsp-detail-date - 1
     3534         ,input false
     3535         ) .
     3536       if v-clear-start = true
     3537       then do:
     3538         run show-action in this-procedure
     3539           (input "Обновление накопительных остатков"
     3540           ).
     3541         run ahrstutl-init in this-procedure
     3542           (input v-obj-type
     3543           ,input v-obj-code
     3544           ,input v-ahsp-detail-date - 1
     3545           ,input true
     3546           ) .
     3547         run ahrstutl-update in this-procedure
     3548           (input v-obj-type
     3549           ,input v-obj-code
     3550           ,input v-restore-detail-date - 1
     3551           ,input v-ahsp-detail-date - 1
     3552           ) .
     3553       end.
     3554       run show-action in this-procedure
     3555         (input "Блокировка расчёта складского архива по поставщикам"
     3556         ).
     3557       define variable v-need-stop-ahsp as logical   no-undo .
     3558       assign
     3559         v-need-stop-ahsp = false
     3560       .
     3561       run gbl/lock-prc.p
     3562         (input 'ahsp':U
     3563         ,input v-obj-code
     3564         ,input 0
     3565         ,input 0
     3566         ,input v-obj-type
     3567         ,input ""
     3568         ,input ""
     3569         ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
     3570         ,input false
     3571         ,buffer calc-supp-arh-lock_batchprocess
     3572         ) no-error .
     3573       if error-status :error
     3574       then do:
     3575         if error-status :get-message(1) <> ""
     3576         then do:
     3577           message
     3578             vss-workfile vss-revision vss-description skip
     3579             "Ошибка при вызове процедуры блокировки расчета складского архива по поставщикам" skip
     3580             "Невозможно продолжить восстановление складского архива по поставщикам" skip
     3581             error-status :get-message(1) skip
     3582             return-value skip
     3583             view-as alert-box error .
     3584           undo, return error "Ошибка при вызове процедуры блокировки расчёта складского архива по поставщикам" .
     3585         end.
     3586         assign
     3587           v-need-stop-ahsp = true
     3588         .
     3589       end.
     3590       define buffer stop-ahsp-restore-lock_btpr for batchprocess .
     3591       if v-need-stop-ahsp = true
     3592       then do:
     3593         do transaction
     3594         on error undo, return error return-value
     3595         :
     3596           create stop-ahsp-restore-lock_btpr .
     3597           assign
     3598             stop-ahsp-restore-lock_btpr.bp_type       = 'lock':U + 'rsss':U
     3599             stop-ahsp-restore-lock_btpr.bp_status     = 'N':U
     3600             stop-ahsp-restore-lock_btpr.Key#_One      = v-obj-code
     3601             stop-ahsp-restore-lock_btpr.Key#_Two      = 0
     3602             stop-ahsp-restore-lock_btpr.Key#_Three    = 0
     3603             stop-ahsp-restore-lock_btpr.CharKey_One   = v-obj-type
     3604             stop-ahsp-restore-lock_btpr.CharKey_Two   = ""
     3605             stop-ahsp-restore-lock_btpr.CharKey_Three = ""
     3606           .
     3607           define variable v-start-lock-time   as int64     no-undo .
     3608           define variable v-start-lock-second as integer   no-undo .
     3609           assign
     3610             v-start-lock-time = etime
     3611           .
     3612           wait_block:
     3613           do while true
     3614           :
     3615             assign
     3616               v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
     3617             .
     3618             run waitfram-show in this-procedure
     3619               (input waitfram-join-function("Складской архив рассчитывается на другой машине"
     3620                                            ,"Отправлено сообщение о необходимости остановки расчёта складского архива"
     3621                                            ,substitute("Ожидание освобождения ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
     3622                                            )
     3623               ) .
     3624             run gbl/lock-prc.p
     3625               (input 'ahsp':U
     3626               ,input v-obj-code
     3627               ,input 0
     3628               ,input 0
     3629               ,input v-obj-type
     3630               ,input ""
     3631               ,input ""
     3632               ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
     3633               ,input false
     3634               ,buffer calc-supp-arh-lock_batchprocess
     3635               ) no-error .
     3636             if error-status :error
     3637             then do:
     3638               if error-status :get-message(1) <> ""
     3639               then do:
     3640                 message
     3641                   vss-workfile vss-revision vss-description skip
     3642                   "Ошибка при вызове процедуры блокировки расчета складского архива по поставщикам" skip
     3643                   "Невозможно продолжить восстановление складского архива по поставщикам" skip
     3644                   view-as alert-box error .
     3645                 undo, return error "В данный момент рассчитывается складской архив по поставщикам" .
     3646               end.
     3647             end.
     3648             else do:
     3649               run waitfram-hide in this-procedure .
     3650               leave wait_block .
     3651             end.
     3652             pause 1 no-message .
     3653           end.
     3654           delete stop-ahsp-restore-lock_btpr .
     3655         end.
     3656       end.
     3657       run show-action in this-procedure
     3658         (input "Удаление повторных записей остатков"
     3659         ).
     3660       run ahrstutl-delete-copy in this-procedure
     3661         (input v-obj-type
     3662         ,input v-obj-code
     3663         ,input v-ahsp-detail-date - 1
     3664         ) .
     3665       run show-action in this-procedure
     3666         (input "Обновление атрибутов складского архива"
     3667         ).
     3668       run clntattr-write in this-procedure
     3669         (input v-obj-type
     3670         ,input v-obj-code
     3671         ,input 'ahsp-start':U
     3672         ,input string(v-restore-start-date, '99/99/9999':u)
     3673         ) no-error .
     3674       if error-status :error
     3675       then do:
     3676         message
     3677           vss-workfile vss-revision vss-description skip
     3678           "Ошибка при записи даты начала складского архива по поставщикам" skip
     3679           error-status :get-message(1) skip
     3680           return-value skip
     3681           view-as alert-box error .
     3682         undo, return error return-value .
     3683       end.
     3684       run clntattr-write in this-procedure
     3685         (input v-obj-type
     3686         ,input v-obj-code
     3687         ,input 'ahsp-detail':U
     3688         ,input string(v-restore-detail-date, '99/99/9999':u)
     3689         ) no-error .
     3690       if error-status :error
     3691       then do:
     3692         message
     3693           vss-workfile vss-revision vss-description skip
     3694           "Ошибка при записи даты начала подробного складского архива по поставщикам" skip
     3695           error-status :get-message(1) skip
     3696           return-value skip
     3697           view-as alert-box error .
     3698         undo, return error return-value .
     3699       end.
     3700       define variable v-delete-ahsp-rest as logical   no-undo .
     3701       run clntattr-delete in this-procedure
     3702         (input  v-obj-type
     3703         ,input  v-obj-code
     3704         ,input  'ahsp-rest':U
     3705         ,output v-delete-ahsp-rest
     3706         ) .
     3707     end.
     3708     if v-restore-from-file = true
     3709     then do:
     3710       assign
     3711         v-action-type = 'rstfil-stop':U
     3712       .
     3713     end.
     3714     else do:
     3715       assign
     3716         v-action-type = 'rstfil-stop':U
     3717       .
     3718     end.
     3719     run utl/arhiscr.p
     3720       (input  v-obj-type
     3721       ,input  v-obj-code
     3722       ,input  'ahsp':U
     3723       ,input  v-action-type
     3724       ,input  ""
     3725       ,input  ""
     3726       ,input  0
     3727       ,input  ""
     3728       ,input  ""
     3729       ,input  v-restore-detail-date
     3730       ,output v-create-chip-num
     3731       ) .
     3732     run invalidate-md5-signature in this-procedure
     3733       (input  v-obj-type
     3734       ,input  v-obj-code
     3735       ,input  'ahsp':U
     3736       ,input  v-file-name
     3737       ,input  v-create-chip-num
     3738       ) .
     3739     run invalidate-md5-signature in this-procedure
     3740       (input  v-obj-type
     3741       ,input  v-obj-code
     3742       ,input  'ahsp':U
     3743       ,input  v-backup-file-name
     3744       ,input  v-create-chip-num
     3745       ) .
     3746     message
     3747       "Восстановление складского архива по поставщикам успешно закончилось" skip
     3748       "Объект" v-obj-type v-obj-code skip
     3749       "" + (if v-restore-detail-date <> ?
     3750            then substitute("На объекте существуют подробный складской архив с даты &1", string(v-restore-detail-date, '99/99/9999':u))
     3751            else "На объекте существует складской архив с даты открытия объекта"
     3752            ) skip
     3753       view-as alert-box information .
     3754   end.
     3755   procedure restore-from-file :
     3756     do
     3757     on error undo, return error return-value
     3758     :
     3759       define variable v-key-value as character no-undo .
     3760       run show-action in this-procedure
     3761         (input "Импорт данных из файла " + v-file-name
     3762         ) .
     3763       define variable v-data-finished as logical   no-undo .
     3764       assign
     3765         v-data-finished = false
     3766       .
     3767       assign
     3768         v-line-num = 0
     3769       .
     3770       define variable v-total-count as integer   no-undo .
     3771       assign
     3772         v-total-count = 0
     3773       .
     3774       repeat
     3775       :
     3776         import stream sinp v-key-value .
     3777         assign
     3778           v-line-num = v-line-num + 1
     3779         .
     3780         assign
     3781           v-total-count = v-total-count + 1
     3782         .
     3783         if v-total-count modulo 10 = 0
     3784         then do:
     3785           run show-count in this-procedure
     3786             (input v-total-count
     3787             ,input "Чтение файла"
     3788             ) .
     3789         end.
     3790         case v-key-value :
     3791           when 'ot-supp-tot':U
     3792           then do:
     3793             define buffer buf_temp-import-ot-supp-tot for temp-import-ot-supp-tot .
     3794             create buf_temp-import-ot-supp-tot .
     3795             import stream sinp buf_temp-import-ot-supp-tot no-error .
     3796             if error-status :error
     3797             then do:
     3798               message
     3799                 vss-workfile vss-revision vss-description skip
     3800                 "Ошибка при импорте таблицы temp-import-ot-supp-tot" skip
     3801                 "Строка" v-line-num skip
     3802                 error-status :get-message(1) skip
     3803                 view-as alert-box error .
     3804               undo, return error return-value .
     3805             end.
     3806             assign
     3807               v-line-num = v-line-num + 1
     3808             .
     3809             define buffer buf_ot-supp-tot for ub.ot-supp-tot .
     3810             create buf_ot-supp-tot .
     3811             buffer-copy buf_temp-import-ot-supp-tot to buf_ot-supp-tot .
     3812             delete buf_temp-import-ot-supp-tot .
     3813           end.
     3814           when 'ot-supp-line':U
     3815           then do:
     3816             define buffer buf_temp-import-ot-supp-line for temp-import-ot-supp-line .
     3817             create buf_temp-import-ot-supp-line .
     3818             import stream sinp buf_temp-import-ot-supp-line except artic prod-type prod-code
     3819               no-error .
     3820             if error-status :error
     3821             then do:
     3822               message
     3823                 vss-workfile vss-revision vss-description skip
     3824                 "Ошибка при импорте таблицы temp-import-ot-supp-line" skip
     3825                 "Строка" v-line-num skip
     3826                 error-status :get-message(1) skip
     3827                 view-as alert-box error .
     3828               undo, return error return-value .
     3829             end.
     3830             assign
     3831               v-line-num = v-line-num + 1
     3832             .
     3833             run fill-artic in this-procedure
     3834               (input  buf_temp-import-ot-supp-line.gds-code
     3835               ,output buf_temp-import-ot-supp-line.artic
     3836               ,output buf_temp-import-ot-supp-line.prod-type
     3837               ,output buf_temp-import-ot-supp-line.prod-code
     3838               ) .
     3839             define buffer buf_ot-supp-line for ub.ot-supp-line .
     3840             create buf_ot-supp-line .
     3841             buffer-copy buf_temp-import-ot-supp-line to buf_ot-supp-line .
     3842             delete buf_temp-import-ot-supp-line .
     3843           end.
     3844           when 'stk-supp-tot':U
     3845           then do:
     3846             define buffer buf_temp-import-stk-supp-tot for temp-import-stk-supp-tot .
     3847             create buf_temp-import-stk-supp-tot .
     3848             import stream sinp buf_temp-import-stk-supp-tot no-error .
     3849             if error-status :error
     3850             then do:
     3851               message
     3852                 vss-workfile vss-revision vss-description skip
     3853                 "Ошибка при импорте таблицы temp-import-stk-supp-tot" skip
     3854                 "Строка" v-line-num skip
     3855                 error-status :get-message(1) skip
     3856                 view-as alert-box error .
     3857               undo, return error return-value .
     3858             end.
     3859             assign
     3860               v-line-num = v-line-num + 1
     3861             .
     3862             define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     3863             create buf_stk-supp-tot .
     3864             buffer-copy buf_temp-import-stk-supp-tot to buf_stk-supp-tot .
     3865             delete buf_temp-import-stk-supp-tot .
     3866           end.
     3867           when 'stk-supp-line':U
     3868           then do:
     3869             define buffer buf_temp-import-stk-supp-line for temp-import-stk-supp-line .
     3870             create buf_temp-import-stk-supp-line .
     3871             import stream sinp buf_temp-import-stk-supp-line except artic prod-type prod-code
     3872               no-error .
     3873             if error-status :error
     3874             then do:
     3875               message
     3876                 vss-workfile vss-revision vss-description skip
     3877                 "Ошибка при импорте таблицы temp-import-stk-supp-line" skip
     3878                 "Строка" v-line-num skip
     3879                 error-status :get-message(1) skip
     3880                 view-as alert-box error .
     3881               undo, return error return-value .
     3882             end.
     3883             assign
     3884               v-line-num = v-line-num + 1
     3885             .
     3886             run fill-artic in this-procedure
     3887               (input  buf_temp-import-stk-supp-line.gds-code
     3888               ,output buf_temp-import-stk-supp-line.artic
     3889               ,output buf_temp-import-stk-supp-line.prod-type
     3890               ,output buf_temp-import-stk-supp-line.prod-code
     3891               ) .
     3892             define buffer buf_stk-supp-line for ub.stk-supp-line .
     3893             create buf_stk-supp-line .
     3894             buffer-copy buf_temp-import-stk-supp-line to buf_stk-supp-line .
     3895             delete buf_temp-import-stk-supp-line .
     3896           end.
     3897           when 'end-of-log':u
     3898           then do:
     3899             assign
     3900               v-data-finished = true
     3901             .
     3902             leave .
     3903           end.
     3904           otherwise do:
     3905             message
     3906               vss-workfile vss-revision vss-description skip
     3907               "Складской архив по поставщикам" skip
     3908               "Объект" v-obj-type v-obj-code skip
     3909               "Неизвестный код таблицы" v-key-value skip
     3910               "Строка" v-line-num skip
     3911               view-as alert-box error .
     3912             undo, return error return-value .
     3913           end.
     3914         end case .
     3915       end.
     3916       if v-data-finished = false
     3917       then do:
     3918         message
     3919           vss-workfile vss-revision vss-description skip
     3920           "Складской архив по поставщикам" skip
     3921           "Объект" v-obj-type v-obj-code skip
     3922           "Не найден признак окончания данных" skip
     3923           "Неправильный формат файла" v-file-name skip
     3924           "Строка" v-line-num skip
     3925           view-as alert-box error .
     3926         undo, return error return-value .
     3927       end.
     3928     end.
     3929   end procedure.
     3930   procedure validate-file-name :
     3931     define input parameter  p-obj-type            as character no-undo .
     3932     define input parameter  p-obj-code            as integer   no-undo .
     3933     define input parameter  v-ahsp-detail-date     as date      no-undo .
     3934     define input parameter  p-file-name           as character no-undo .
     3935     define output parameter p-restore-start-date  as date      no-undo .
     3936     define output parameter p-restore-detail-date as date      no-undo .
     3937     do
     3938     on error undo, return error return-value
     3939     :
     3940       define variable v-param-code  as character no-undo .
     3941       define variable v-param-value as character no-undo .
     3942       import stream sinp v-param-code v-param-value .
     3943       assign
     3944         v-line-num = v-line-num + 1
     3945       .
     3946       if v-param-code <> 'archive-log-version':u
     3947       or v-param-value <> '2.1':u
     3948       then do:
     3949         message
     3950           "Складской архив по поставщикам" skip
     3951           "Объект" p-obj-type p-obj-code skip
     3952           "Неправильный формат файла" p-file-name skip
     3953           "Строка" v-line-num skip
     3954           "Значения" v-param-code v-param-value skip
     3955           view-as alert-box error .
     3956         undo, return error return-value .
     3957       end.
     3958       import stream sinp v-param-code v-param-value .
     3959       assign
     3960         v-line-num = v-line-num + 1
     3961       .
     3962       if v-param-code <> 'obj-type':u
     3963       or v-param-value <> p-obj-type
     3964       then do:
     3965         message
     3966           "Складской архив по поставщикам" skip
     3967           "Объект" p-obj-type p-obj-code skip
     3968           "Неправильный формат файла" p-file-name skip
     3969           "Строка" v-line-num skip
     3970           "Значения" v-param-code v-param-value skip
     3971           view-as alert-box error .
     3972         undo, return error return-value .
     3973       end.
     3974       import stream sinp v-param-code v-param-value .
     3975       assign
     3976         v-line-num = v-line-num + 1
     3977       .
     3978       if v-param-code <> 'obj-code':u
     3979       or v-param-value <> string(p-obj-code)
     3980       then do:
     3981         message
     3982           "Складской архив по поставщикам" skip
     3983           "Объект" p-obj-type p-obj-code skip
     3984           "Неправильный формат файла" p-file-name skip
     3985           "Строка" v-line-num skip
     3986           "Значения" v-param-code v-param-value skip
     3987           view-as alert-box error .
     3988         undo, return error return-value .
     3989       end.
     3990       import stream sinp v-param-code v-param-value .
     3991       assign
     3992         v-line-num = v-line-num + 1
     3993       .
     3994       if v-param-code <> 'old-start-date':u
     3995       then do:
     3996         message
     3997           "Складской архив по поставщикам" skip
     3998           "Объект" p-obj-type p-obj-code skip
     3999           "Неправильный формат файла" p-file-name skip
     4000           "Строка" v-line-num skip
     4001           "Значения" v-param-code v-param-value skip
     4002           view-as alert-box error .
     4003         undo, return error return-value .
     4004       end.
     4005       assign
     4006         p-restore-start-date = date(v-param-value)
     4007       .
     4008       import stream sinp v-param-code v-param-value .
     4009       assign
     4010         v-line-num = v-line-num + 1
     4011       .
     4012       if v-param-code <> 'old-detail-date':u
     4013       then do:
     4014         message
     4015           "Складской архив по поставщикам" skip
     4016           "Объект" p-obj-type p-obj-code skip
     4017           "Неправильный формат файла" p-file-name skip
     4018           "Строка" v-line-num skip
     4019           "Значения" v-param-code v-param-value skip
     4020           view-as alert-box error .
     4021         undo, return error return-value .
     4022       end.
     4023       assign
     4024         p-restore-detail-date = date(v-param-value)
     4025       .
     4026       import stream sinp v-param-code v-param-value .
     4027       assign
     4028         v-line-num = v-line-num + 1
     4029       .
     4030       if v-param-code <> 'new-start-date':u
     4031       then do:
     4032         message
     4033           "Складской архив по поставщикам" skip
     4034           "Объект" p-obj-type p-obj-code skip
     4035           "Неправильный формат файла" p-file-name skip
     4036           "Строка" v-line-num skip
     4037           "Значения" v-param-code v-param-value skip
     4038           view-as alert-box error .
     4039         undo, return error return-value .
     4040       end.
     4041       import stream sinp v-param-code v-param-value .
     4042       assign
     4043         v-line-num = v-line-num + 1
     4044       .
     4045       if v-param-code <> 'new-detail-date':u
     4046       then do:
     4047         message
     4048           "Складской архив по поставщикам" skip
     4049           "Объект" p-obj-type p-obj-code skip
     4050           "Неправильный формат файла" p-file-name skip
     4051           "Строка" v-line-num skip
     4052           "Значения" v-param-code v-param-value skip
     4053           view-as alert-box error .
     4054         undo, return error return-value .
     4055       end.
     4056       if v-ahsp-detail-date <> date(v-param-value)
     4057       then do:
     4058         message
     4059           "Складской архив по поставщикам" skip
     4060           "Объект" p-obj-type p-obj-code skip
     4061           "Несоответствие текущей даты начала подробного складского архива по поставщикам" skip
     4062           "и даты начала подробного архива в файле" p-file-name skip
     4063           "Строка" v-line-num skip
     4064           "Текущая дата начала подробного архива" string(v-ahsp-detail-date) skip
     4065           "Дата начала подробного архива в файле" v-param-value skip
     4066           "Восстановление складского архива по поставщикам невозможно" skip
     4067           view-as alert-box error .
     4068         undo, return error return-value .
     4069       end.
     4070     end.
     4071   end procedure.
     4072   procedure show-action :
     4073     do
     4074     on error undo, return error return-value
     4075     :
     4076       define input parameter p-action as character no-undo .
     4077       assign
     4078         v-current-time = string(time - v-start-time, "HH:MM:SS")
     4079         v-current-action = p-action
     4080       .
     4081       display
     4082         v-current-time
     4083         v-current-action
     4084         with frame a.
     4085     end.
     4086   end procedure.
     4087   procedure show-count :
     4088     define input  parameter p-count      as integer   no-undo .
     4089     define input  parameter p-sub-action as character no-undo .
     4090     do
     4091     on error undo, return error return-value
     4092     :
     4093       assign
     4094         v-current-time = string(time - v-start-time, "HH:MM:SS")
     4095         v-count        = p-count
     4096         v-sub-action   = p-sub-action
     4097       .
     4098       display
     4099         v-current-time
     4100         v-count
     4101         v-sub-action
     4102         with frame a.
     4103     end.
     4104   end procedure.
     4105   procedure create-log-file :
     4106     define input  parameter p-obj-type        as character no-undo .
     4107     define input  parameter p-obj-code        as integer   no-undo .
     4108     define input  parameter p-old-start-date  as date      no-undo .
     4109     define input  parameter p-old-detail-date as date      no-undo .
     4110     define input  parameter p-new-start-date  as date      no-undo .
     4111     define input  parameter p-new-detail-date as date      no-undo .
     4112     define input  parameter p-file-name       as character no-undo .
     4113     do
     4114     on error undo, return error return-value
     4115     :
     4116       if search('.' + '/':u + p-file-name) <> ?
     4117       then do:
     4118         define variable v-ok as logical   no-undo .
     4119         message
     4120           "ВНИМАНИЕ!" skip
     4121           "Файл" p-file-name "существует и будет перезаписан" skip
     4122           "Продолжить?"
     4123           view-as alert-box question buttons yes-no update v-ok .
     4124         if v-ok <> true
     4125         then do:
     4126           undo, return error return-value .
     4127         end.
     4128       end.
     4129       output stream slog to value(p-file-name) .
     4130       export stream slog 'archive-log-version':u '2.1':u .
     4131       export stream slog 'obj-type':u            p-obj-type .
     4132       export stream slog 'obj-code':u            string(p-obj-code) .
     4133       export stream slog 'old-start-date':u      string(p-old-start-date, '99/99/9999':u ) .
     4134       export stream slog 'old-detail-date':u     string(p-old-detail-date, '99/99/9999':u ) .
     4135       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     4136       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     4137       output stream slog close .
     4138     end.
     4139   end procedure.
     4140   procedure close-log-file :
     4141     define input  parameter p-obj-type        as character no-undo .
     4142     define input  parameter p-obj-code        as integer   no-undo .
     4143     define input  parameter p-old-start-date  as date      no-undo .
     4144     define input  parameter p-old-detail-date as date      no-undo .
     4145     define input  parameter p-new-start-date  as date      no-undo .
     4146     define input  parameter p-new-detail-date as date      no-undo .
     4147     define input  parameter p-file-name       as character no-undo .
     4148     do
     4149     on error undo, return error return-value
     4150     :
     4151       output stream slog to value(p-file-name) append .
     4152       export stream slog 'end-of-log':u .
     4153       export stream slog 'archive-log-version':u '2.1':u .
     4154       export stream slog 'obj-type':u            p-obj-type .
     4155       export stream slog 'obj-code':u            string(p-obj-code) .
     4156       export stream slog 'old-start-date':u      string(p-old-start-date, '99/99/9999':u ) .
     4157       export stream slog 'old-detail-date':u     string(p-old-detail-date, '99/99/9999':u ) .
     4158       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     4159       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     4160       export stream slog '.':u                   .
     4161       output stream slog close .
     4162     end.
     4163   end procedure.
     4164   define temp-table temp-supp no-undo
     4165     field cli-type as character
     4166     field cli-code as integer
     4167     index xpk is primary unique cli-type cli-code
     4168     .
     4169   define temp-table temp-supp-gds no-undo
     4170     field cli-type  as character
     4171     field cli-code  as integer
     4172     field artic     as character
     4173     field prod-type as character
     4174     field prod-code as integer
     4175     index xpk is primary unique cli-type cli-code artic prod-type prod-code
     4176     .
     4177   procedure store-temp :
     4178     define buffer buf_temp-stk-supp-tot         for temp-stk-supp-tot .
     4179     define buffer buf_temp-stk-supp-line        for temp-stk-supp-line .
     4180     define buffer buf_temp-shift-stk-supp-tot   for temp-shift-stk-supp-tot .
     4181     define buffer buf_temp-shift-stk-supp-line  for temp-shift-stk-supp-line .
     4182     define buffer buf_temp-supp                 for temp-supp .
     4183     define buffer buf_temp-supp-gds             for temp-supp-gds .
     4184     define buffer buf_temp-create-stk-supp-tot  for temp-create-stk-supp-tot .
     4185     define buffer buf_temp-create-stk-supp-line for temp-create-stk-supp-line .
     4186     define buffer buf_doclslib-clients          for doclslib-clients .
     4187     define buffer buf_doclslib-clients-goods    for doclslib-clients-goods .
     4188     define buffer buf_doclslib-goods            for doclslib-goods .
     4189     do
     4190     on error undo, return error return-value
     4191     :
     4192       output stream sout to value ("rst-ahsp.txt") append .
     4193       export stream sout 'export':u string(today, '99/99/9999':u) string(time, 'hh:mm:ss':u) .
     4194       for each buf_temp-stk-supp-tot
     4195       on error undo, return error return-value
     4196       :
     4197         export stream sout 'temp-stk-supp-tot':u .
     4198         export stream sout buf_temp-stk-supp-tot .
     4199       end.
     4200       for each buf_temp-stk-supp-line
     4201       on error undo, return error return-value
     4202       :
     4203         export stream sout 'temp-stk-supp-line':u .
     4204         export stream sout buf_temp-stk-supp-line .
     4205       end.
     4206       for each buf_temp-shift-stk-supp-tot
     4207       on error undo, return error return-value
     4208       :
     4209         export stream sout 'temp-shift-stk-supp-tot':u .
     4210         export stream sout buf_temp-shift-stk-supp-tot .
     4211       end.
     4212       for each buf_temp-shift-stk-supp-line
     4213       on error undo, return error return-value
     4214       :
     4215         export stream sout 'temp-shift-stk-supp-line':u .
     4216         export stream sout buf_temp-shift-stk-supp-line .
     4217       end.
     4218       for each buf_temp-supp
     4219       on error undo, return error return-value
     4220       :
     4221         export stream sout 'temp-supp':u .
     4222         export stream sout buf_temp-supp .
     4223       end.
     4224       for each buf_temp-supp-gds
     4225       on error undo, return error return-value
     4226       :
     4227         export stream sout 'temp-supp-gds':u .
     4228         export stream sout buf_temp-supp-gds .
     4229       end.
     4230       for each buf_temp-create-stk-supp-tot
     4231       on error undo, return error return-value
     4232       :
     4233         export stream sout 'temp-create-stk-supp-tot':u .
     4234         export stream sout buf_temp-create-stk-supp-tot .
     4235       end.
     4236       for each buf_temp-create-stk-supp-line
     4237       on error undo, return error return-value
     4238       :
     4239         export stream sout 'temp-create-stk-supp-line':u .
     4240         export stream sout buf_temp-create-stk-supp-line .
     4241       end.
     4242       for each buf_doclslib-clients
     4243       on error undo, return error return-value
     4244       :
     4245         export stream sout 'doclslib-clients':u .
     4246         export stream sout buf_doclslib-clients.
     4247       end.
     4248       for each buf_doclslib-clients-goods
     4249       on error undo, return error return-value
     4250       :
     4251         export stream sout 'doclslib-clients-goods':u .
     4252         export stream sout buf_doclslib-clients-goods.
     4253       end.
     4254       for each buf_doclslib-goods
     4255       on error undo, return error return-value
     4256       :
     4257         export stream sout 'doclslib-goods':u .
     4258         export stream sout buf_doclslib-goods.
     4259       end.
     4260       output stream sout close .
     4261     end.
     4262   end procedure.
     4263   procedure temp-supp-clear :
     4264     define buffer buf_temp-supp for temp-supp .
     4265     do
     4266     on error undo, return error return-value
     4267     :
     4268       for each buf_temp-supp
     4269       on error undo, return error return-value
     4270       :
     4271         delete buf_temp-supp .
     4272       end.
     4273     end.
     4274   end procedure.
     4275   procedure temp-supp-create :
     4276     define input  parameter p-cli-type                  like ub.stk-supp-line.cli-type  no-undo .
     4277     define input  parameter p-cli-code                  like ub.stk-supp-line.cli-code  no-undo .
     4278     define buffer buf_temp-supp for temp-supp .
     4279     do
     4280     on error undo, return error return-value
     4281     :
     4282       find first buf_temp-supp
     4283         where buf_temp-supp.cli-type  = p-cli-type
     4284           and buf_temp-supp.cli-code  = p-cli-code
     4285         no-error .
     4286       if not available buf_temp-supp
     4287       then do:
     4288         create buf_temp-supp .
     4289         assign
     4290           buf_temp-supp.cli-type  = p-cli-type
     4291           buf_temp-supp.cli-code  = p-cli-code
     4292         .
     4293       end.
     4294     end.
     4295   end procedure.
     4296   procedure temp-supp-gds-clear :
     4297     define buffer buf_temp-supp-gds for temp-supp-gds .
     4298     do
     4299     on error undo, return error return-value
     4300     :
     4301       for each buf_temp-supp-gds
     4302       on error undo, return error return-value
     4303       :
     4304         delete buf_temp-supp-gds .
     4305       end.
     4306     end.
     4307   end procedure.
     4308   procedure temp-supp-gds-create :
     4309     define input  parameter p-cli-type                  like ub.stk-supp-line.cli-type  no-undo .
     4310     define input  parameter p-cli-code                  like ub.stk-supp-line.cli-code  no-undo .
     4311     define input  parameter p-artic                     like ub.stk-supp-line.artic     no-undo .
     4312     define input  parameter p-prod-type                 like ub.stk-supp-line.prod-type no-undo .
     4313     define input  parameter p-prod-code                 like ub.stk-supp-line.prod-code no-undo .
     4314     define buffer buf_temp-supp-gds for temp-supp-gds .
     4315     do
     4316     on error undo, return error return-value
     4317     :
     4318       find first buf_temp-supp-gds
     4319         where buf_temp-supp-gds.cli-type  = p-cli-type
     4320           and buf_temp-supp-gds.cli-code  = p-cli-code
     4321           and buf_temp-supp-gds.artic     = p-artic
     4322           and buf_temp-supp-gds.prod-type = p-prod-type
     4323           and buf_temp-supp-gds.prod-code = p-prod-code
     4324         no-error .
     4325       if not available buf_temp-supp-gds
     4326       then do:
     4327         create buf_temp-supp-gds .
     4328         assign
     4329           buf_temp-supp-gds.cli-type  = p-cli-type
     4330           buf_temp-supp-gds.cli-code  = p-cli-code
     4331           buf_temp-supp-gds.artic     = p-artic
     4332           buf_temp-supp-gds.prod-type = p-prod-type
     4333           buf_temp-supp-gds.prod-code = p-prod-code
     4334         .
     4335       end.
     4336     end.
     4337   end procedure.
     4338   procedure temp-supp-gds-fill :
     4339     define input  parameter p-obj-type   as character no-undo .
     4340     define input  parameter p-obj-code   as integer   no-undo .
     4341     define input  parameter p-fact-order as decimal   no-undo .
     4342     define buffer buf_stk-supp-line for ub.stk-supp-line .
     4343     do
     4344     on error undo, return error return-value
     4345     :
     4346       for each buf_stk-supp-line no-lock
     4347         where buf_stk-supp-line.obj-type   = p-obj-type
     4348           and buf_stk-supp-line.obj-code   = p-obj-code
     4349           and buf_stk-supp-line.fact-order <= p-fact-order
     4350       on error undo, return error return-value
     4351       :
     4352         run temp-supp-create in this-procedure
     4353           (input buf_stk-supp-line.cli-type
     4354           ,input buf_stk-supp-line.cli-code
     4355           ) .
     4356         run temp-supp-gds-create in this-procedure
     4357           (input buf_stk-supp-line.cli-type
     4358           ,input buf_stk-supp-line.cli-code
     4359           ,input buf_stk-supp-line.artic
     4360           ,input buf_stk-supp-line.prod-type
     4361           ,input buf_stk-supp-line.prod-code
     4362           ) .
     4363       end.
     4364     end.
     4365   end procedure.
     4366   procedure temp-supp-gds-from-doclslib :
     4367     define buffer buf_doclslib-clients for doclslib-clients .
     4368     define buffer buf_doclslib-clients-goods for doclslib-clients-goods .
     4369     define buffer buf_temp-supp for temp-supp .
     4370     define buffer buf_temp-supp-gds for temp-supp-gds .
     4371     do
     4372     on error undo, return error return-value
     4373     :
     4374       for each buf_doclslib-clients
     4375       on error undo, return error return-value
     4376       :
     4377         run temp-supp-create in this-procedure
     4378           (input buf_doclslib-clients.cli-type
     4379           ,input buf_doclslib-clients.cli-code
     4380           ) .
     4381       end.
     4382       for each buf_doclslib-clients-goods
     4383       on error undo, return error return-value
     4384       :
     4385         run temp-supp-gds-create in this-procedure
     4386           (input buf_doclslib-clients-goods.cli-type
     4387           ,input buf_doclslib-clients-goods.cli-code
     4388           ,input buf_doclslib-clients-goods.artic
     4389           ,input buf_doclslib-clients-goods.prod-type
     4390           ,input buf_doclslib-clients-goods.prod-code
     4391           ) .
     4392       end.
     4393     end.
     4394   end procedure.
     4395   procedure ahrstutl-init :
     4396     define input  parameter p-obj-type           as character no-undo .
     4397     define input  parameter p-obj-code           as integer   no-undo .
     4398     define input  parameter p-fact-date          as date      no-undo .
     4399     define input  parameter p-save-new           as logical   no-undo .
     4400     define buffer buf_doclslib-clients for doclslib-clients .
     4401     define buffer buf_doclslib-clients-goods for doclslib-clients-goods .
     4402     define variable v-shift-on                as logical   no-undo .
     4403     define variable v-shift-date              as date      no-undo .
     4404     define variable v-shift-num               as integer   no-undo .
     4405     define variable v-day-end-fact-order      as decimal   no-undo .
     4406     define variable v-shift-end-fact-order    as decimal   no-undo .
     4407     define variable v-create-fact-order       as decimal   no-undo .
     4408     define variable v-shift-create-fact-order as decimal   no-undo .
     4409     define variable v-sum-type-list as character no-undo .
     4410     do
     4411     on error undo, return error return-value
     4412     :
     4413       run factord-cut-archive in this-procedure
     4414         (input  p-obj-type
     4415         ,input  p-obj-code
     4416         ,input  p-fact-date
     4417         ,output v-shift-on
     4418         ,output v-shift-date
     4419         ,output v-shift-num
     4420         ,output v-day-end-fact-order
     4421         ,output v-shift-end-fact-order
     4422         ) .
     4423       assign
     4424         v-create-fact-order       = v-day-end-fact-order
     4425         v-shift-create-fact-order = v-shift-end-fact-order
     4426       .
     4427       if p-save-new = true
     4428       then do:
     4429         assign
     4430           v-day-end-fact-order   = v-day-end-fact-order - 0.0000000001
     4431           v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     4432         .
     4433       end.
     4434       run ahrstutl-supp-tot-sum-type-list in this-procedure
     4435         (output v-sum-type-list
     4436         ) .
     4437       run show-action in this-procedure
     4438         (input "Остаток по поставщикам. Считывание"
     4439         ).
     4440       define variable v-ind as integer   no-undo .
     4441       do v-ind = 1 to num-entries(v-sum-type-list)
     4442       :
     4443         for each buf_doclslib-clients
     4444         on error undo, return error return-value
     4445         :
     4446           run ahrstutl-init-supp-tot in this-procedure
     4447             (input p-obj-type
     4448             ,input p-obj-code
     4449             ,input buf_doclslib-clients.cli-type
     4450             ,input buf_doclslib-clients.cli-code
     4451             ,input entry(v-ind, v-sum-type-list)
     4452             ,input p-fact-date
     4453             ,input v-day-end-fact-order
     4454             ,input v-create-fact-order
     4455             ,input v-shift-on
     4456             ,input v-shift-date
     4457             ,input v-shift-num
     4458             ,input v-shift-end-fact-order
     4459             ,input v-shift-create-fact-order
     4460             ,input p-save-new
     4461             ) .
     4462         end.
     4463       end.
     4464       run ahrstutl-supp-line-sum-type-list in this-procedure
     4465         (output v-sum-type-list
     4466         ) .
     4467       run show-action in this-procedure
     4468         (input "Остаток по поставщикам и товарам. Считывание"
     4469         ).
     4470       define variable v-total-count as integer   no-undo .
     4471       for each buf_doclslib-clients-goods
     4472       on error undo, return error return-value
     4473       :
     4474         assign
     4475           v-total-count = v-total-count + 1
     4476         .
     4477         if v-total-count modulo 10 = 0
     4478         then do:
     4479           run show-count in this-procedure
     4480             (input v-total-count
     4481             ,input "Артикул " + string(buf_doclslib-clients-goods.artic)
     4482             ).
     4483         end.
     4484         do v-ind = 1 to num-entries(v-sum-type-list)
     4485         :
     4486           run ahrstutl-init-supp-line in this-procedure
     4487             (input p-obj-type
     4488             ,input p-obj-code
     4489             ,input buf_doclslib-clients-goods.cli-type
     4490             ,input buf_doclslib-clients-goods.cli-code
     4491             ,input buf_doclslib-clients-goods.artic
     4492             ,input buf_doclslib-clients-goods.prod-type
     4493             ,input buf_doclslib-clients-goods.prod-code
     4494             ,input entry(v-ind, v-sum-type-list)
     4495             ,input p-fact-date
     4496             ,input v-day-end-fact-order
     4497             ,input v-create-fact-order
     4498             ,input v-shift-on
     4499             ,input v-shift-date
     4500             ,input v-shift-num
     4501             ,input v-shift-end-fact-order
     4502             ,input v-shift-create-fact-order
     4503             ,input p-save-new
     4504             ) .
     4505         end.
     4506       end.
     4507     end.
     4508   end procedure.
     4509   procedure ahrstutl-init-supp-tot :
     4510     define input  parameter p-obj-type                      as character no-undo .
     4511     define input  parameter p-obj-code                      as integer   no-undo .
     4512     define input  parameter p-cli-type                      as character no-undo .
     4513     define input  parameter p-cli-code                      as integer   no-undo .
     4514     define input  parameter p-root-sum-type                 as character no-undo .
     4515     define input  parameter p-fact-date                     as date      no-undo .
     4516     define input  parameter p-stk-supp-tot-fact-order       as decimal   no-undo .
     4517     define input  parameter p-create-tot-fact-order         as decimal   no-undo .
     4518     define input  parameter p-shift-on                      as logical   no-undo .
     4519     define input  parameter p-shift-date                    as date      no-undo .
     4520     define input  parameter p-shift-num                     as integer   no-undo .
     4521     define input  parameter p-shift-stk-supp-tot-fact-order as decimal   no-undo .
     4522     define input  parameter p-shift-create-tot-fact-order   as decimal   no-undo .
     4523     define input  parameter p-save-new                      as logical   no-undo .
     4524     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     4525     define buffer buf_temp-stk-supp-tot for temp-stk-supp-tot .
     4526     define buffer buf_temp-shift-stk-supp-tot for temp-shift-stk-supp-tot .
     4527     define buffer buf_temp-create-stk-supp-tot for temp-create-stk-supp-tot .
     4528     define variable v-prev-stk-supp-tot-fact-order  like ub.stk-supp-tot.fact-order no-undo .
     4529     define variable v-create-stk as logical   no-undo .
     4530     do
     4531     on error undo, return error return-value
     4532     :
     4533       find last buf_stk-supp-tot no-lock
     4534         where buf_stk-supp-tot.obj-type   = p-obj-type
     4535           and buf_stk-supp-tot.obj-code   = p-obj-code
     4536           and buf_stk-supp-tot.cli-type   = p-cli-type
     4537           and buf_stk-supp-tot.cli-code   = p-cli-code
     4538           and buf_stk-supp-tot.sum-type   = p-root-sum-type
     4539           and buf_stk-supp-tot.cat-id     = '##':U
     4540           and buf_stk-supp-tot.fact-order <= p-stk-supp-tot-fact-order
     4541         use-index category
     4542         no-error .
     4543       if available buf_stk-supp-tot
     4544       then do:
     4545         assign
     4546           v-prev-stk-supp-tot-fact-order = buf_stk-supp-tot.fact-order
     4547         .
     4548         if v-prev-stk-supp-tot-fact-order <> p-stk-supp-tot-fact-order
     4549         then do:
     4550           assign
     4551             v-create-stk = true
     4552           .
     4553         end.
     4554         else do:
     4555           assign
     4556             v-create-stk = false
     4557           .
     4558         end.
     4559         for each buf_stk-supp-tot no-lock
     4560           where buf_stk-supp-tot.obj-type   = p-obj-type
     4561             and buf_stk-supp-tot.obj-code   = p-obj-code
     4562             and buf_stk-supp-tot.cli-type   = p-cli-type
     4563             and buf_stk-supp-tot.cli-code   = p-cli-code
     4564             and buf_stk-supp-tot.fact-order = v-prev-stk-supp-tot-fact-order
     4565             and buf_stk-supp-tot.sum-type   begins p-root-sum-type
     4566         on error undo, return error return-value
     4567         :
     4568           find first buf_temp-stk-supp-tot
     4569             where buf_temp-stk-supp-tot.obj-type   = buf_stk-supp-tot.obj-type
     4570               and buf_temp-stk-supp-tot.obj-code   = buf_stk-supp-tot.obj-code
     4571               and buf_temp-stk-supp-tot.cli-type   = buf_stk-supp-tot.cli-type
     4572               and buf_temp-stk-supp-tot.cli-code   = buf_stk-supp-tot.cli-code
     4573               and buf_temp-stk-supp-tot.fact-order = p-create-tot-fact-order
     4574               and buf_temp-stk-supp-tot.sum-type   = buf_stk-supp-tot.sum-type
     4575               and buf_temp-stk-supp-tot.cat-id     = buf_stk-supp-tot.cat-id
     4576             no-error .
     4577           if not available buf_temp-stk-supp-tot
     4578           then do:
     4579             create buf_temp-stk-supp-tot .
     4580             assign
     4581                                       buf_temp-stk-supp-tot.obj-type     = buf_stk-supp-tot.obj-type     buf_temp-stk-supp-tot.obj-code     = buf_stk-supp-tot.obj-code     buf_temp-stk-supp-tot.cli-type     = buf_stk-supp-tot.cli-type     buf_temp-stk-supp-tot.cli-code     = buf_stk-supp-tot.cli-code     buf_temp-stk-supp-tot.fact-order   = buf_stk-supp-tot.fact-order   buf_temp-stk-supp-tot.sum-type     = buf_stk-supp-tot.sum-type     buf_temp-stk-supp-tot.cat-id       = buf_stk-supp-tot.cat-id       buf_temp-stk-supp-tot.fact-date    = buf_stk-supp-tot.fact-date    buf_temp-stk-supp-tot.shift-num    = buf_stk-supp-tot.shift-num    buf_temp-stk-supp-tot.shift-date   = buf_stk-supp-tot.shift-date
     4582               buf_temp-stk-supp-tot.fact-order = p-create-tot-fact-order
     4583               buf_temp-stk-supp-tot.fact-date  = p-fact-date
     4584               buf_temp-stk-supp-tot.shift-num  = 0
     4585               buf_temp-stk-supp-tot.shift-date = ?
     4586             .
     4587           end.
     4588           if p-save-new = true
     4589           then do:
     4590             assign
     4591                                                                                       buf_temp-stk-supp-tot.new-fact-qnty      = buf_stk-supp-tot.fact-qnty            buf_temp-stk-supp-tot.new-sum-base       = buf_stk-supp-tot.sum-base             buf_temp-stk-supp-tot.new-sum-rubl       = buf_stk-supp-tot.sum-rubl             buf_temp-stk-supp-tot.new-vat-base       = buf_stk-supp-tot.vat-base             buf_temp-stk-supp-tot.new-vat-rubl       = buf_stk-supp-tot.vat-rubl             buf_temp-stk-supp-tot.new-slt-base       = buf_stk-supp-tot.slt-base             buf_temp-stk-supp-tot.new-slt-rubl       = buf_stk-supp-tot.slt-rubl             buf_temp-stk-supp-tot.new-road-tax-base  = buf_stk-supp-tot.road-tax-base        buf_temp-stk-supp-tot.new-road-tax-rubl  = buf_stk-supp-tot.road-tax-rubl        buf_temp-stk-supp-tot.new-excise-base    = buf_stk-supp-tot.excise-base          buf_temp-stk-supp-tot.new-excise-rubl    = buf_stk-supp-tot.excise-rubl          buf_temp-stk-supp-tot.new-transport-base = buf_stk-supp-tot.transport-base       buf_temp-stk-supp-tot.new-transport-rubl = buf_stk-supp-tot.transport-rubl       buf_temp-stk-supp-tot.new-other-base     = buf_stk-supp-tot.other-base           buf_temp-stk-supp-tot.new-other-rubl     = buf_stk-supp-tot.other-rubl
     4592             .
     4593           end.
     4594           else do:
     4595             assign
     4596                                                                                       buf_temp-stk-supp-tot.fact-qnty      = buf_stk-supp-tot.fact-qnty            buf_temp-stk-supp-tot.sum-base       = buf_stk-supp-tot.sum-base             buf_temp-stk-supp-tot.sum-rubl       = buf_stk-supp-tot.sum-rubl             buf_temp-stk-supp-tot.vat-base       = buf_stk-supp-tot.vat-base             buf_temp-stk-supp-tot.vat-rubl       = buf_stk-supp-tot.vat-rubl             buf_temp-stk-supp-tot.slt-base       = buf_stk-supp-tot.slt-base             buf_temp-stk-supp-tot.slt-rubl       = buf_stk-supp-tot.slt-rubl             buf_temp-stk-supp-tot.road-tax-base  = buf_stk-supp-tot.road-tax-base        buf_temp-stk-supp-tot.road-tax-rubl  = buf_stk-supp-tot.road-tax-rubl        buf_temp-stk-supp-tot.excise-base    = buf_stk-supp-tot.excise-base          buf_temp-stk-supp-tot.excise-rubl    = buf_stk-supp-tot.excise-rubl          buf_temp-stk-supp-tot.transport-base = buf_stk-supp-tot.transport-base       buf_temp-stk-supp-tot.transport-rubl = buf_stk-supp-tot.transport-rubl       buf_temp-stk-supp-tot.other-base     = buf_stk-supp-tot.other-base           buf_temp-stk-supp-tot.other-rubl     = buf_stk-supp-tot.other-rubl
     4597             .
     4598           end.
     4599           if p-shift-on
     4600           then do:
     4601             find first buf_temp-shift-stk-supp-tot
     4602               where buf_temp-shift-stk-supp-tot.obj-type   = buf_stk-supp-tot.obj-type
     4603                 and buf_temp-shift-stk-supp-tot.obj-code   = buf_stk-supp-tot.obj-code
     4604                 and buf_temp-shift-stk-supp-tot.cli-type   = buf_stk-supp-tot.cli-type
     4605                 and buf_temp-shift-stk-supp-tot.cli-code   = buf_stk-supp-tot.cli-code
     4606                 and buf_temp-shift-stk-supp-tot.fact-order = p-shift-create-tot-fact-order
     4607                 and buf_temp-shift-stk-supp-tot.sum-type   = buf_stk-supp-tot.sum-type
     4608                 and buf_temp-shift-stk-supp-tot.cat-id     = buf_stk-supp-tot.cat-id
     4609               no-error .
     4610             if not available buf_temp-shift-stk-supp-tot
     4611             then do:
     4612               create buf_temp-shift-stk-supp-tot .
     4613               assign
     4614                                             buf_temp-shift-stk-supp-tot.obj-type     = buf_stk-supp-tot.obj-type     buf_temp-shift-stk-supp-tot.obj-code     = buf_stk-supp-tot.obj-code     buf_temp-shift-stk-supp-tot.cli-type     = buf_stk-supp-tot.cli-type     buf_temp-shift-stk-supp-tot.cli-code     = buf_stk-supp-tot.cli-code     buf_temp-shift-stk-supp-tot.fact-order   = buf_stk-supp-tot.fact-order   buf_temp-shift-stk-supp-tot.sum-type     = buf_stk-supp-tot.sum-type     buf_temp-shift-stk-supp-tot.cat-id       = buf_stk-supp-tot.cat-id       buf_temp-shift-stk-supp-tot.fact-date    = buf_stk-supp-tot.fact-date    buf_temp-shift-stk-supp-tot.shift-num    = buf_stk-supp-tot.shift-num    buf_temp-shift-stk-supp-tot.shift-date   = buf_stk-supp-tot.shift-date
     4615                 buf_temp-shift-stk-supp-tot.fact-order = p-shift-create-tot-fact-order
     4616                 buf_temp-shift-stk-supp-tot.fact-date  = p-fact-date
     4617                 buf_temp-shift-stk-supp-tot.shift-date = p-shift-date
     4618                 buf_temp-shift-stk-supp-tot.shift-num  = p-shift-num
     4619               .
     4620             end.
     4621             if p-save-new = true
     4622             then do:
     4623               assign
     4624                                                                                                     buf_temp-shift-stk-supp-tot.new-fact-qnty      = buf_stk-supp-tot.fact-qnty            buf_temp-shift-stk-supp-tot.new-sum-base       = buf_stk-supp-tot.sum-base             buf_temp-shift-stk-supp-tot.new-sum-rubl       = buf_stk-supp-tot.sum-rubl             buf_temp-shift-stk-supp-tot.new-vat-base       = buf_stk-supp-tot.vat-base             buf_temp-shift-stk-supp-tot.new-vat-rubl       = buf_stk-supp-tot.vat-rubl             buf_temp-shift-stk-supp-tot.new-slt-base       = buf_stk-supp-tot.slt-base             buf_temp-shift-stk-supp-tot.new-slt-rubl       = buf_stk-supp-tot.slt-rubl             buf_temp-shift-stk-supp-tot.new-road-tax-base  = buf_stk-supp-tot.road-tax-base        buf_temp-shift-stk-supp-tot.new-road-tax-rubl  = buf_stk-supp-tot.road-tax-rubl        buf_temp-shift-stk-supp-tot.new-excise-base    = buf_stk-supp-tot.excise-base          buf_temp-shift-stk-supp-tot.new-excise-rubl    = buf_stk-supp-tot.excise-rubl          buf_temp-shift-stk-supp-tot.new-transport-base = buf_stk-supp-tot.transport-base       buf_temp-shift-stk-supp-tot.new-transport-rubl = buf_stk-supp-tot.transport-rubl       buf_temp-shift-stk-supp-tot.new-other-base     = buf_stk-supp-tot.other-base           buf_temp-shift-stk-supp-tot.new-other-rubl     = buf_stk-supp-tot.other-rubl
     4625               .
     4626             end.
     4627             else do:
     4628               assign
     4629                                                                                                     buf_temp-shift-stk-supp-tot.fact-qnty      = buf_stk-supp-tot.fact-qnty            buf_temp-shift-stk-supp-tot.sum-base       = buf_stk-supp-tot.sum-base             buf_temp-shift-stk-supp-tot.sum-rubl       = buf_stk-supp-tot.sum-rubl             buf_temp-shift-stk-supp-tot.vat-base       = buf_stk-supp-tot.vat-base             buf_temp-shift-stk-supp-tot.vat-rubl       = buf_stk-supp-tot.vat-rubl             buf_temp-shift-stk-supp-tot.slt-base       = buf_stk-supp-tot.slt-base             buf_temp-shift-stk-supp-tot.slt-rubl       = buf_stk-supp-tot.slt-rubl             buf_temp-shift-stk-supp-tot.road-tax-base  = buf_stk-supp-tot.road-tax-base        buf_temp-shift-stk-supp-tot.road-tax-rubl  = buf_stk-supp-tot.road-tax-rubl        buf_temp-shift-stk-supp-tot.excise-base    = buf_stk-supp-tot.excise-base          buf_temp-shift-stk-supp-tot.excise-rubl    = buf_stk-supp-tot.excise-rubl          buf_temp-shift-stk-supp-tot.transport-base = buf_stk-supp-tot.transport-base       buf_temp-shift-stk-supp-tot.transport-rubl = buf_stk-supp-tot.transport-rubl       buf_temp-shift-stk-supp-tot.other-base     = buf_stk-supp-tot.other-base           buf_temp-shift-stk-supp-tot.other-rubl     = buf_stk-supp-tot.other-rubl
     4630               .
     4631             end.
     4632           end.
     4633         end.
     4634       end.
     4635       else do:
     4636         assign
     4637           v-create-stk = true
     4638         .
     4639         find first buf_temp-stk-supp-tot
     4640           where buf_temp-stk-supp-tot.obj-type   = p-obj-type
     4641             and buf_temp-stk-supp-tot.obj-code   = p-obj-code
     4642             and buf_temp-stk-supp-tot.cli-type   = p-cli-type
     4643             and buf_temp-stk-supp-tot.cli-code   = p-cli-code
     4644             and buf_temp-stk-supp-tot.fact-order = p-create-tot-fact-order
     4645             and buf_temp-stk-supp-tot.sum-type   = p-root-sum-type
     4646             and buf_temp-stk-supp-tot.cat-id     = '##':U
     4647           no-error .
