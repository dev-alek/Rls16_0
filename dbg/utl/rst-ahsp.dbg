     5910                                                                                                                                                                                                         sub_stk-supp-tot.fact-qnty      = sub_stk-supp-tot.fact-qnty      + sub_temp-shift-stk-supp-tot.fact-qnty      - sub_temp-shift-stk-supp-tot.new-fact-qnty           sub_stk-supp-tot.sum-base       = sub_stk-supp-tot.sum-base       + sub_temp-shift-stk-supp-tot.sum-base       - sub_temp-shift-stk-supp-tot.new-sum-base            sub_stk-supp-tot.sum-rubl       = sub_stk-supp-tot.sum-rubl       + sub_temp-shift-stk-supp-tot.sum-rubl       - sub_temp-shift-stk-supp-tot.new-sum-rubl            sub_stk-supp-tot.vat-base       = sub_stk-supp-tot.vat-base       + sub_temp-shift-stk-supp-tot.vat-base       - sub_temp-shift-stk-supp-tot.new-vat-base            sub_stk-supp-tot.vat-rubl       = sub_stk-supp-tot.vat-rubl       + sub_temp-shift-stk-supp-tot.vat-rubl       - sub_temp-shift-stk-supp-tot.new-vat-rubl            sub_stk-supp-tot.slt-base       = sub_stk-supp-tot.slt-base       + sub_temp-shift-stk-supp-tot.slt-base       - sub_temp-shift-stk-supp-tot.new-slt-base            sub_stk-supp-tot.slt-rubl       = sub_stk-supp-tot.slt-rubl       + sub_temp-shift-stk-supp-tot.slt-rubl       - sub_temp-shift-stk-supp-tot.new-slt-rubl            sub_stk-supp-tot.road-tax-base  = sub_stk-supp-tot.road-tax-base  + sub_temp-shift-stk-supp-tot.road-tax-base  - sub_temp-shift-stk-supp-tot.new-road-tax-base       sub_stk-supp-tot.road-tax-rubl  = sub_stk-supp-tot.road-tax-rubl  + sub_temp-shift-stk-supp-tot.road-tax-rubl  - sub_temp-shift-stk-supp-tot.new-road-tax-rubl       sub_stk-supp-tot.excise-base    = sub_stk-supp-tot.excise-base    + sub_temp-shift-stk-supp-tot.excise-base    - sub_temp-shift-stk-supp-tot.new-excise-base         sub_stk-supp-tot.excise-rubl    = sub_stk-supp-tot.excise-rubl    + sub_temp-shift-stk-supp-tot.excise-rubl    - sub_temp-shift-stk-supp-tot.new-excise-rubl         sub_stk-supp-tot.transport-base = sub_stk-supp-tot.transport-base + sub_temp-shift-stk-supp-tot.transport-base - sub_temp-shift-stk-supp-tot.new-transport-base      sub_stk-supp-tot.transport-rubl = sub_stk-supp-tot.transport-rubl + sub_temp-shift-stk-supp-tot.transport-rubl - sub_temp-shift-stk-supp-tot.new-transport-rubl      sub_stk-supp-tot.other-base     = sub_stk-supp-tot.other-base     + sub_temp-shift-stk-supp-tot.other-base     - sub_temp-shift-stk-supp-tot.new-other-base          sub_stk-supp-tot.other-rubl     = sub_stk-supp-tot.other-rubl     + sub_temp-shift-stk-supp-tot.other-rubl     - sub_temp-shift-stk-supp-tot.new-other-rubl
     5911                   .
     5912                 end.
     5913               end.
     5914             end.
     5915           end.
     5916         end.
     5917       end.
     5918     end.
     5919   end procedure.
     5920   procedure ahrstutl-store-supp-line :
     5921     define input  parameter p-obj-type                   as character no-undo .
     5922     define input  parameter p-obj-code                   as integer   no-undo .
     5923     define input  parameter p-cli-type                   as character no-undo .
     5924     define input  parameter p-cli-code                   as integer   no-undo .
     5925     define input  parameter p-artic                      as character no-undo .
     5926     define input  parameter p-prod-type                  as character no-undo .
     5927     define input  parameter p-prod-code                  as integer   no-undo .
     5928     define input  parameter p-sum-type                   as character no-undo .
     5929     define input  parameter p-shift-on                   as logical   no-undo .
     5930     define input  parameter p-first-cut-date             as date      no-undo .
     5931     define input  parameter p-last-cut-date              as date      no-undo .
     5932     define input  parameter p-first-day-end-fact-order   as decimal   no-undo .
     5933     define input  parameter p-first-shift-end-fact-order as decimal   no-undo .
     5934     define input  parameter p-first-shift-date           as date      no-undo .
     5935     define input  parameter p-first-shift-num            as integer   no-undo .
     5936     define input  parameter p-last-day-end-fact-order    as decimal   no-undo .
     5937     define input  parameter p-last-shift-end-fact-order  as decimal   no-undo .
     5938     define input  parameter p-last-shift-date            as date      no-undo .
     5939     define input  parameter p-last-shift-num             as integer   no-undo .
     5940     define buffer buf_stk-supp-line for ub.stk-supp-line .
     5941     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     5942     define buffer buf_temp-shift-stk-supp-line for temp-shift-stk-supp-line .
     5943     define buffer sub_temp-stk-supp-line for temp-stk-supp-line .
     5944     define buffer sub_stk-supp-line for ub.stk-supp-line .
     5945     define buffer sub_temp-shift-stk-supp-line for temp-shift-stk-supp-line .
     5946     do
     5947     on error undo, return error return-value
     5948     :
     5949       for each buf_temp-stk-supp-line
     5950         where buf_temp-stk-supp-line.obj-type   = p-obj-type
     5951           and buf_temp-stk-supp-line.obj-code   = p-obj-code
     5952           and buf_temp-stk-supp-line.cli-type   = p-cli-type
     5953           and buf_temp-stk-supp-line.cli-code   = p-cli-code
     5954           and buf_temp-stk-supp-line.artic      = p-artic
     5955           and buf_temp-stk-supp-line.prod-type  = p-prod-type
     5956           and buf_temp-stk-supp-line.prod-code  = p-prod-code
     5957           and buf_temp-stk-supp-line.sum-type   = p-sum-type
     5958       on error undo, return error return-value
     5959       :
     5960         if
     5961                                             buf_temp-stk-supp-line.fact-qnty      <> buf_temp-stk-supp-line.new-fact-qnty        or    buf_temp-stk-supp-line.sum-base       <> buf_temp-stk-supp-line.new-sum-base         or    buf_temp-stk-supp-line.sum-rubl       <> buf_temp-stk-supp-line.new-sum-rubl         or    buf_temp-stk-supp-line.vat-base       <> buf_temp-stk-supp-line.new-vat-base         or    buf_temp-stk-supp-line.vat-rubl       <> buf_temp-stk-supp-line.new-vat-rubl         or    buf_temp-stk-supp-line.slt-base       <> buf_temp-stk-supp-line.new-slt-base         or    buf_temp-stk-supp-line.slt-rubl       <> buf_temp-stk-supp-line.new-slt-rubl         or    buf_temp-stk-supp-line.road-tax-base  <> buf_temp-stk-supp-line.new-road-tax-base    or    buf_temp-stk-supp-line.road-tax-rubl  <> buf_temp-stk-supp-line.new-road-tax-rubl    or    buf_temp-stk-supp-line.excise-base    <> buf_temp-stk-supp-line.new-excise-base      or    buf_temp-stk-supp-line.excise-rubl    <> buf_temp-stk-supp-line.new-excise-rubl      or    buf_temp-stk-supp-line.transport-base <> buf_temp-stk-supp-line.new-transport-base   or    buf_temp-stk-supp-line.transport-rubl <> buf_temp-stk-supp-line.new-transport-rubl   or    buf_temp-stk-supp-line.other-base     <> buf_temp-stk-supp-line.new-other-base       or    buf_temp-stk-supp-line.other-rubl     <> buf_temp-stk-supp-line.new-other-rubl
     5962         then do:
     5963           find first buf_stk-supp-line exclusive-lock
     5964             where buf_stk-supp-line.obj-type   = buf_temp-stk-supp-line.obj-type
     5965               and buf_stk-supp-line.obj-code   = buf_temp-stk-supp-line.obj-code
     5966               and buf_stk-supp-line.cli-type   = buf_temp-stk-supp-line.cli-type
     5967               and buf_stk-supp-line.cli-code   = buf_temp-stk-supp-line.cli-code
     5968               and buf_stk-supp-line.artic      = buf_temp-stk-supp-line.artic
     5969               and buf_stk-supp-line.prod-type  = buf_temp-stk-supp-line.prod-type
     5970               and buf_stk-supp-line.prod-code  = buf_temp-stk-supp-line.prod-code
     5971               and buf_stk-supp-line.sum-type   = buf_temp-stk-supp-line.sum-type
     5972               and buf_stk-supp-line.cat-id     = buf_temp-stk-supp-line.cat-id
     5973               and buf_stk-supp-line.fact-order <= p-first-day-end-fact-order
     5974               and buf_stk-supp-line.shift-date = ?
     5975             no-error .
     5976           if not available buf_stk-supp-line
     5977           then do:
     5978             create buf_stk-supp-line .
     5979             assign
     5980               buf_stk-supp-line.obj-type   = buf_temp-stk-supp-line.obj-type
     5981               buf_stk-supp-line.obj-code   = buf_temp-stk-supp-line.obj-code
     5982               buf_stk-supp-line.cli-type   = buf_temp-stk-supp-line.cli-type
     5983               buf_stk-supp-line.cli-code   = buf_temp-stk-supp-line.cli-code
     5984               buf_stk-supp-line.artic      = buf_temp-stk-supp-line.artic
     5985               buf_stk-supp-line.prod-type  = buf_temp-stk-supp-line.prod-type
     5986               buf_stk-supp-line.prod-code  = buf_temp-stk-supp-line.prod-code
     5987               buf_stk-supp-line.fact-order = p-first-day-end-fact-order
     5988               buf_stk-supp-line.sum-type   = buf_temp-stk-supp-line.sum-type
     5989               buf_stk-supp-line.cat-id     = buf_temp-stk-supp-line.cat-id
     5990               buf_stk-supp-line.fact-date  = p-first-cut-date
     5991               buf_stk-supp-line.shift-num  = 0
     5992               buf_stk-supp-line.shift-date = ?
     5993             .
     5994           end.
     5995           for each buf_stk-supp-line exclusive-lock
     5996             where buf_stk-supp-line.obj-type   = buf_temp-stk-supp-line.obj-type
     5997               and buf_stk-supp-line.obj-code   = buf_temp-stk-supp-line.obj-code
     5998               and buf_stk-supp-line.cli-type   = buf_temp-stk-supp-line.cli-type
     5999               and buf_stk-supp-line.cli-code   = buf_temp-stk-supp-line.cli-code
     6000               and buf_stk-supp-line.artic      = buf_temp-stk-supp-line.artic
     6001               and buf_stk-supp-line.prod-type  = buf_temp-stk-supp-line.prod-type
     6002               and buf_stk-supp-line.prod-code  = buf_temp-stk-supp-line.prod-code
     6003               and buf_stk-supp-line.sum-type   = buf_temp-stk-supp-line.sum-type
     6004               and buf_stk-supp-line.cat-id     = buf_temp-stk-supp-line.cat-id
     6005               and buf_stk-supp-line.fact-order <= p-last-day-end-fact-order - 0.0000000001
     6006               and buf_stk-supp-line.shift-date = ?
     6007           on error undo, return error return-value
     6008           :
     6009             for each sub_temp-stk-supp-line
     6010               where sub_temp-stk-supp-line.obj-type   = buf_temp-stk-supp-line.obj-type
     6011                 and sub_temp-stk-supp-line.obj-code   = buf_temp-stk-supp-line.obj-code
     6012                 and sub_temp-stk-supp-line.cli-type   = buf_temp-stk-supp-line.cli-type
     6013                 and sub_temp-stk-supp-line.cli-code   = buf_temp-stk-supp-line.cli-code
     6014                 and sub_temp-stk-supp-line.artic      = buf_temp-stk-supp-line.artic
     6015                 and sub_temp-stk-supp-line.prod-type  = buf_temp-stk-supp-line.prod-type
     6016                 and sub_temp-stk-supp-line.prod-code  = buf_temp-stk-supp-line.prod-code
     6017                 and sub_temp-stk-supp-line.fact-order = buf_temp-stk-supp-line.fact-order
     6018                 and sub_temp-stk-supp-line.sum-type   begins buf_temp-stk-supp-line.sum-type
     6019             on error undo, return error return-value
     6020             :
     6021               if
     6022                                                                                       sub_temp-stk-supp-line.fact-qnty      <> sub_temp-stk-supp-line.new-fact-qnty        or    sub_temp-stk-supp-line.sum-base       <> sub_temp-stk-supp-line.new-sum-base         or    sub_temp-stk-supp-line.sum-rubl       <> sub_temp-stk-supp-line.new-sum-rubl         or    sub_temp-stk-supp-line.vat-base       <> sub_temp-stk-supp-line.new-vat-base         or    sub_temp-stk-supp-line.vat-rubl       <> sub_temp-stk-supp-line.new-vat-rubl         or    sub_temp-stk-supp-line.slt-base       <> sub_temp-stk-supp-line.new-slt-base         or    sub_temp-stk-supp-line.slt-rubl       <> sub_temp-stk-supp-line.new-slt-rubl         or    sub_temp-stk-supp-line.road-tax-base  <> sub_temp-stk-supp-line.new-road-tax-base    or    sub_temp-stk-supp-line.road-tax-rubl  <> sub_temp-stk-supp-line.new-road-tax-rubl    or    sub_temp-stk-supp-line.excise-base    <> sub_temp-stk-supp-line.new-excise-base      or    sub_temp-stk-supp-line.excise-rubl    <> sub_temp-stk-supp-line.new-excise-rubl      or    sub_temp-stk-supp-line.transport-base <> sub_temp-stk-supp-line.new-transport-base   or    sub_temp-stk-supp-line.transport-rubl <> sub_temp-stk-supp-line.new-transport-rubl   or    sub_temp-stk-supp-line.other-base     <> sub_temp-stk-supp-line.new-other-base       or    sub_temp-stk-supp-line.other-rubl     <> sub_temp-stk-supp-line.new-other-rubl
     6023               then do:
     6024                 find first sub_stk-supp-line exclusive-lock
     6025                   where sub_stk-supp-line.obj-type   = buf_stk-supp-line.obj-type
     6026                     and sub_stk-supp-line.obj-code   = buf_stk-supp-line.obj-code
     6027                     and sub_stk-supp-line.cli-type   = buf_stk-supp-line.cli-type
     6028                     and sub_stk-supp-line.cli-code   = buf_stk-supp-line.cli-code
     6029                     and sub_stk-supp-line.artic      = buf_stk-supp-line.artic
     6030                     and sub_stk-supp-line.prod-type  = buf_stk-supp-line.prod-type
     6031                     and sub_stk-supp-line.prod-code  = buf_stk-supp-line.prod-code
     6032                     and sub_stk-supp-line.fact-order = buf_stk-supp-line.fact-order
     6033                     and sub_stk-supp-line.sum-type   = sub_temp-stk-supp-line.sum-type
     6034                     and sub_stk-supp-line.cat-id     = sub_temp-stk-supp-line.cat-id
     6035                   no-error .
     6036                 if not available sub_stk-supp-line
     6037                 then do:
     6038                   create sub_stk-supp-line .
     6039                   assign
     6040                     sub_stk-supp-line.obj-type   = buf_stk-supp-line.obj-type
     6041                     sub_stk-supp-line.obj-code   = buf_stk-supp-line.obj-code
     6042                     sub_stk-supp-line.cli-type   = buf_stk-supp-line.cli-type
     6043                     sub_stk-supp-line.cli-code   = buf_stk-supp-line.cli-code
     6044                     sub_stk-supp-line.artic      = buf_stk-supp-line.artic
     6045                     sub_stk-supp-line.prod-type  = buf_stk-supp-line.prod-type
     6046                     sub_stk-supp-line.prod-code  = buf_stk-supp-line.prod-code
     6047                     sub_stk-supp-line.fact-order = buf_stk-supp-line.fact-order
     6048                     sub_stk-supp-line.sum-type   = sub_temp-stk-supp-line.sum-type
     6049                     sub_stk-supp-line.cat-id     = sub_temp-stk-supp-line.cat-id
     6050                     sub_stk-supp-line.fact-date  = buf_stk-supp-line.fact-date
     6051                     sub_stk-supp-line.shift-num  = buf_stk-supp-line.shift-num
     6052                     sub_stk-supp-line.shift-date = buf_stk-supp-line.shift-date
     6053                   .
     6054                 end.
     6055                 assign
     6056                                                                                                                                                                                   sub_stk-supp-line.fact-qnty      = sub_stk-supp-line.fact-qnty      + sub_temp-stk-supp-line.fact-qnty      - sub_temp-stk-supp-line.new-fact-qnty           sub_stk-supp-line.sum-base       = sub_stk-supp-line.sum-base       + sub_temp-stk-supp-line.sum-base       - sub_temp-stk-supp-line.new-sum-base            sub_stk-supp-line.sum-rubl       = sub_stk-supp-line.sum-rubl       + sub_temp-stk-supp-line.sum-rubl       - sub_temp-stk-supp-line.new-sum-rubl            sub_stk-supp-line.vat-base       = sub_stk-supp-line.vat-base       + sub_temp-stk-supp-line.vat-base       - sub_temp-stk-supp-line.new-vat-base            sub_stk-supp-line.vat-rubl       = sub_stk-supp-line.vat-rubl       + sub_temp-stk-supp-line.vat-rubl       - sub_temp-stk-supp-line.new-vat-rubl            sub_stk-supp-line.slt-base       = sub_stk-supp-line.slt-base       + sub_temp-stk-supp-line.slt-base       - sub_temp-stk-supp-line.new-slt-base            sub_stk-supp-line.slt-rubl       = sub_stk-supp-line.slt-rubl       + sub_temp-stk-supp-line.slt-rubl       - sub_temp-stk-supp-line.new-slt-rubl            sub_stk-supp-line.road-tax-base  = sub_stk-supp-line.road-tax-base  + sub_temp-stk-supp-line.road-tax-base  - sub_temp-stk-supp-line.new-road-tax-base       sub_stk-supp-line.road-tax-rubl  = sub_stk-supp-line.road-tax-rubl  + sub_temp-stk-supp-line.road-tax-rubl  - sub_temp-stk-supp-line.new-road-tax-rubl       sub_stk-supp-line.excise-base    = sub_stk-supp-line.excise-base    + sub_temp-stk-supp-line.excise-base    - sub_temp-stk-supp-line.new-excise-base         sub_stk-supp-line.excise-rubl    = sub_stk-supp-line.excise-rubl    + sub_temp-stk-supp-line.excise-rubl    - sub_temp-stk-supp-line.new-excise-rubl         sub_stk-supp-line.transport-base = sub_stk-supp-line.transport-base + sub_temp-stk-supp-line.transport-base - sub_temp-stk-supp-line.new-transport-base      sub_stk-supp-line.transport-rubl = sub_stk-supp-line.transport-rubl + sub_temp-stk-supp-line.transport-rubl - sub_temp-stk-supp-line.new-transport-rubl      sub_stk-supp-line.other-base     = sub_stk-supp-line.other-base     + sub_temp-stk-supp-line.other-base     - sub_temp-stk-supp-line.new-other-base          sub_stk-supp-line.other-rubl     = sub_stk-supp-line.other-rubl     + sub_temp-stk-supp-line.other-rubl     - sub_temp-stk-supp-line.new-other-rubl
     6057                 .
     6058               end.
     6059             end.
     6060           end.
     6061         end.
     6062       end.
     6063       if p-shift-on = true
     6064       then do:
     6065         for each buf_temp-shift-stk-supp-line
     6066           where buf_temp-shift-stk-supp-line.obj-type  = p-obj-type
     6067             and buf_temp-shift-stk-supp-line.obj-code  = p-obj-code
     6068             and buf_temp-shift-stk-supp-line.cli-type  = p-cli-type
     6069             and buf_temp-shift-stk-supp-line.cli-code  = p-cli-code
     6070             and buf_temp-shift-stk-supp-line.artic     = p-artic
     6071             and buf_temp-shift-stk-supp-line.prod-type = p-prod-type
     6072             and buf_temp-shift-stk-supp-line.prod-code = p-prod-code
     6073             and buf_temp-shift-stk-supp-line.sum-type  = p-sum-type
     6074         on error undo, return error return-value
     6075         :
     6076           if
     6077                                                           buf_temp-shift-stk-supp-line.fact-qnty      <> buf_temp-shift-stk-supp-line.new-fact-qnty        or    buf_temp-shift-stk-supp-line.sum-base       <> buf_temp-shift-stk-supp-line.new-sum-base         or    buf_temp-shift-stk-supp-line.sum-rubl       <> buf_temp-shift-stk-supp-line.new-sum-rubl         or    buf_temp-shift-stk-supp-line.vat-base       <> buf_temp-shift-stk-supp-line.new-vat-base         or    buf_temp-shift-stk-supp-line.vat-rubl       <> buf_temp-shift-stk-supp-line.new-vat-rubl         or    buf_temp-shift-stk-supp-line.slt-base       <> buf_temp-shift-stk-supp-line.new-slt-base         or    buf_temp-shift-stk-supp-line.slt-rubl       <> buf_temp-shift-stk-supp-line.new-slt-rubl         or    buf_temp-shift-stk-supp-line.road-tax-base  <> buf_temp-shift-stk-supp-line.new-road-tax-base    or    buf_temp-shift-stk-supp-line.road-tax-rubl  <> buf_temp-shift-stk-supp-line.new-road-tax-rubl    or    buf_temp-shift-stk-supp-line.excise-base    <> buf_temp-shift-stk-supp-line.new-excise-base      or    buf_temp-shift-stk-supp-line.excise-rubl    <> buf_temp-shift-stk-supp-line.new-excise-rubl      or    buf_temp-shift-stk-supp-line.transport-base <> buf_temp-shift-stk-supp-line.new-transport-base   or    buf_temp-shift-stk-supp-line.transport-rubl <> buf_temp-shift-stk-supp-line.new-transport-rubl   or    buf_temp-shift-stk-supp-line.other-base     <> buf_temp-shift-stk-supp-line.new-other-base       or    buf_temp-shift-stk-supp-line.other-rubl     <> buf_temp-shift-stk-supp-line.new-other-rubl
     6078           then do:
     6079             find first buf_stk-supp-line exclusive-lock
     6080               where buf_stk-supp-line.obj-type   = buf_temp-shift-stk-supp-line.obj-type
     6081                 and buf_stk-supp-line.obj-code   = buf_temp-shift-stk-supp-line.obj-code
     6082                 and buf_stk-supp-line.cli-type   = buf_temp-shift-stk-supp-line.cli-type
     6083                 and buf_stk-supp-line.cli-code   = buf_temp-shift-stk-supp-line.cli-code
     6084                 and buf_stk-supp-line.artic      = buf_temp-shift-stk-supp-line.artic
     6085                 and buf_stk-supp-line.prod-type  = buf_temp-shift-stk-supp-line.prod-type
     6086                 and buf_stk-supp-line.prod-code  = buf_temp-shift-stk-supp-line.prod-code
     6087                 and buf_stk-supp-line.sum-type   = buf_temp-shift-stk-supp-line.sum-type
     6088                 and buf_stk-supp-line.cat-id     = buf_temp-shift-stk-supp-line.cat-id
     6089                 and buf_stk-supp-line.fact-order <= p-first-shift-end-fact-order
     6090                 and buf_stk-supp-line.shift-date <> ?
     6091               no-error .
     6092             if not available buf_stk-supp-line
     6093             then do:
     6094               create buf_stk-supp-line .
     6095               assign
     6096                 buf_stk-supp-line.obj-type   = buf_temp-shift-stk-supp-line.obj-type
     6097                 buf_stk-supp-line.obj-code   = buf_temp-shift-stk-supp-line.obj-code
     6098                 buf_stk-supp-line.cli-type   = buf_temp-shift-stk-supp-line.cli-type
     6099                 buf_stk-supp-line.cli-code   = buf_temp-shift-stk-supp-line.cli-code
     6100                 buf_stk-supp-line.artic      = buf_temp-shift-stk-supp-line.artic
     6101                 buf_stk-supp-line.prod-type  = buf_temp-shift-stk-supp-line.prod-type
     6102                 buf_stk-supp-line.prod-code  = buf_temp-shift-stk-supp-line.prod-code
     6103                 buf_stk-supp-line.fact-order = p-first-shift-end-fact-order
     6104                 buf_stk-supp-line.sum-type   = buf_temp-shift-stk-supp-line.sum-type
     6105                 buf_stk-supp-line.cat-id     = buf_temp-shift-stk-supp-line.cat-id
     6106                 buf_stk-supp-line.fact-date  = p-first-cut-date
     6107                 buf_stk-supp-line.shift-num  = p-first-shift-num
     6108                 buf_stk-supp-line.shift-date = p-first-shift-date
     6109               .
     6110             end.
     6111             for each buf_stk-supp-line exclusive-lock
     6112               where buf_stk-supp-line.obj-type   = buf_temp-shift-stk-supp-line.obj-type
     6113                 and buf_stk-supp-line.obj-code   = buf_temp-shift-stk-supp-line.obj-code
     6114                 and buf_stk-supp-line.cli-type   = buf_temp-shift-stk-supp-line.cli-type
     6115                 and buf_stk-supp-line.cli-code   = buf_temp-shift-stk-supp-line.cli-code
     6116                 and buf_stk-supp-line.artic      = buf_temp-shift-stk-supp-line.artic
     6117                 and buf_stk-supp-line.prod-type  = buf_temp-shift-stk-supp-line.prod-type
     6118                 and buf_stk-supp-line.prod-code  = buf_temp-shift-stk-supp-line.prod-code
     6119                 and buf_stk-supp-line.sum-type   = buf_temp-shift-stk-supp-line.sum-type
     6120                 and buf_stk-supp-line.cat-id     = buf_temp-shift-stk-supp-line.cat-id
     6121                 and buf_stk-supp-line.fact-order <= p-last-shift-end-fact-order - 0.0000000001
     6122                 and buf_stk-supp-line.shift-date <> ?
     6123             on error undo, return error return-value
     6124             :
     6125               for each sub_temp-shift-stk-supp-line
     6126                 where sub_temp-shift-stk-supp-line.obj-type   = buf_temp-shift-stk-supp-line.obj-type
     6127                   and sub_temp-shift-stk-supp-line.obj-code   = buf_temp-shift-stk-supp-line.obj-code
     6128                   and sub_temp-shift-stk-supp-line.cli-type   = buf_temp-shift-stk-supp-line.cli-type
     6129                   and sub_temp-shift-stk-supp-line.cli-code   = buf_temp-shift-stk-supp-line.cli-code
     6130                   and sub_temp-shift-stk-supp-line.artic      = buf_temp-shift-stk-supp-line.artic
     6131                   and sub_temp-shift-stk-supp-line.prod-type  = buf_temp-shift-stk-supp-line.prod-type
     6132                   and sub_temp-shift-stk-supp-line.prod-code  = buf_temp-shift-stk-supp-line.prod-code
     6133                   and sub_temp-shift-stk-supp-line.fact-order = buf_temp-shift-stk-supp-line.fact-order
     6134                   and sub_temp-shift-stk-supp-line.sum-type   begins buf_temp-shift-stk-supp-line.sum-type
     6135               on error undo, return error return-value
     6136               :
     6137                 if
     6138                                                                                                     sub_temp-shift-stk-supp-line.fact-qnty      <> sub_temp-shift-stk-supp-line.new-fact-qnty        or    sub_temp-shift-stk-supp-line.sum-base       <> sub_temp-shift-stk-supp-line.new-sum-base         or    sub_temp-shift-stk-supp-line.sum-rubl       <> sub_temp-shift-stk-supp-line.new-sum-rubl         or    sub_temp-shift-stk-supp-line.vat-base       <> sub_temp-shift-stk-supp-line.new-vat-base         or    sub_temp-shift-stk-supp-line.vat-rubl       <> sub_temp-shift-stk-supp-line.new-vat-rubl         or    sub_temp-shift-stk-supp-line.slt-base       <> sub_temp-shift-stk-supp-line.new-slt-base         or    sub_temp-shift-stk-supp-line.slt-rubl       <> sub_temp-shift-stk-supp-line.new-slt-rubl         or    sub_temp-shift-stk-supp-line.road-tax-base  <> sub_temp-shift-stk-supp-line.new-road-tax-base    or    sub_temp-shift-stk-supp-line.road-tax-rubl  <> sub_temp-shift-stk-supp-line.new-road-tax-rubl    or    sub_temp-shift-stk-supp-line.excise-base    <> sub_temp-shift-stk-supp-line.new-excise-base      or    sub_temp-shift-stk-supp-line.excise-rubl    <> sub_temp-shift-stk-supp-line.new-excise-rubl      or    sub_temp-shift-stk-supp-line.transport-base <> sub_temp-shift-stk-supp-line.new-transport-base   or    sub_temp-shift-stk-supp-line.transport-rubl <> sub_temp-shift-stk-supp-line.new-transport-rubl   or    sub_temp-shift-stk-supp-line.other-base     <> sub_temp-shift-stk-supp-line.new-other-base       or    sub_temp-shift-stk-supp-line.other-rubl     <> sub_temp-shift-stk-supp-line.new-other-rubl
     6139                 then do:
     6140                   find first sub_stk-supp-line exclusive-lock
     6141                     where sub_stk-supp-line.obj-type   = buf_stk-supp-line.obj-type
     6142                       and sub_stk-supp-line.obj-code   = buf_stk-supp-line.obj-code
     6143                       and sub_stk-supp-line.cli-type   = buf_stk-supp-line.cli-type
     6144                       and sub_stk-supp-line.cli-code   = buf_stk-supp-line.cli-code
     6145                       and sub_stk-supp-line.artic      = buf_stk-supp-line.artic
     6146                       and sub_stk-supp-line.prod-type  = buf_stk-supp-line.prod-type
     6147                       and sub_stk-supp-line.prod-code  = buf_stk-supp-line.prod-code
     6148                       and sub_stk-supp-line.fact-order = buf_stk-supp-line.fact-order
     6149                       and sub_stk-supp-line.sum-type   = sub_temp-shift-stk-supp-line.sum-type
     6150                       and sub_stk-supp-line.cat-id     = sub_temp-shift-stk-supp-line.cat-id
     6151                     no-error .
     6152                   if not available sub_stk-supp-line
     6153                   then do:
     6154                     create sub_stk-supp-line .
     6155                     assign
     6156                       sub_stk-supp-line.obj-type   = buf_stk-supp-line.obj-type
     6157                       sub_stk-supp-line.obj-code   = buf_stk-supp-line.obj-code
     6158                       sub_stk-supp-line.cli-type   = buf_stk-supp-line.cli-type
     6159                       sub_stk-supp-line.cli-code   = buf_stk-supp-line.cli-code
     6160                       sub_stk-supp-line.artic      = buf_stk-supp-line.artic
     6161                       sub_stk-supp-line.prod-type  = buf_stk-supp-line.prod-type
     6162                       sub_stk-supp-line.prod-code  = buf_stk-supp-line.prod-code
     6163                       sub_stk-supp-line.fact-order = buf_stk-supp-line.fact-order
     6164                       sub_stk-supp-line.sum-type   = sub_temp-shift-stk-supp-line.sum-type
     6165                       sub_stk-supp-line.cat-id     = sub_temp-shift-stk-supp-line.cat-id
     6166                       sub_stk-supp-line.fact-date  = buf_stk-supp-line.fact-date
     6167                       sub_stk-supp-line.shift-num  = buf_stk-supp-line.shift-num
     6168                       sub_stk-supp-line.shift-date = buf_stk-supp-line.shift-date
     6169                     .
     6170                   end.
     6171                   assign
     6172                                                                                                                                                                                                         sub_stk-supp-line.fact-qnty      = sub_stk-supp-line.fact-qnty      + sub_temp-shift-stk-supp-line.fact-qnty      - sub_temp-shift-stk-supp-line.new-fact-qnty           sub_stk-supp-line.sum-base       = sub_stk-supp-line.sum-base       + sub_temp-shift-stk-supp-line.sum-base       - sub_temp-shift-stk-supp-line.new-sum-base            sub_stk-supp-line.sum-rubl       = sub_stk-supp-line.sum-rubl       + sub_temp-shift-stk-supp-line.sum-rubl       - sub_temp-shift-stk-supp-line.new-sum-rubl            sub_stk-supp-line.vat-base       = sub_stk-supp-line.vat-base       + sub_temp-shift-stk-supp-line.vat-base       - sub_temp-shift-stk-supp-line.new-vat-base            sub_stk-supp-line.vat-rubl       = sub_stk-supp-line.vat-rubl       + sub_temp-shift-stk-supp-line.vat-rubl       - sub_temp-shift-stk-supp-line.new-vat-rubl            sub_stk-supp-line.slt-base       = sub_stk-supp-line.slt-base       + sub_temp-shift-stk-supp-line.slt-base       - sub_temp-shift-stk-supp-line.new-slt-base            sub_stk-supp-line.slt-rubl       = sub_stk-supp-line.slt-rubl       + sub_temp-shift-stk-supp-line.slt-rubl       - sub_temp-shift-stk-supp-line.new-slt-rubl            sub_stk-supp-line.road-tax-base  = sub_stk-supp-line.road-tax-base  + sub_temp-shift-stk-supp-line.road-tax-base  - sub_temp-shift-stk-supp-line.new-road-tax-base       sub_stk-supp-line.road-tax-rubl  = sub_stk-supp-line.road-tax-rubl  + sub_temp-shift-stk-supp-line.road-tax-rubl  - sub_temp-shift-stk-supp-line.new-road-tax-rubl       sub_stk-supp-line.excise-base    = sub_stk-supp-line.excise-base    + sub_temp-shift-stk-supp-line.excise-base    - sub_temp-shift-stk-supp-line.new-excise-base         sub_stk-supp-line.excise-rubl    = sub_stk-supp-line.excise-rubl    + sub_temp-shift-stk-supp-line.excise-rubl    - sub_temp-shift-stk-supp-line.new-excise-rubl         sub_stk-supp-line.transport-base = sub_stk-supp-line.transport-base + sub_temp-shift-stk-supp-line.transport-base - sub_temp-shift-stk-supp-line.new-transport-base      sub_stk-supp-line.transport-rubl = sub_stk-supp-line.transport-rubl + sub_temp-shift-stk-supp-line.transport-rubl - sub_temp-shift-stk-supp-line.new-transport-rubl      sub_stk-supp-line.other-base     = sub_stk-supp-line.other-base     + sub_temp-shift-stk-supp-line.other-base     - sub_temp-shift-stk-supp-line.new-other-base          sub_stk-supp-line.other-rubl     = sub_stk-supp-line.other-rubl     + sub_temp-shift-stk-supp-line.other-rubl     - sub_temp-shift-stk-supp-line.new-other-rubl
     6173                   .
     6174                 end.
     6175               end.
     6176             end.
     6177           end.
     6178         end.
     6179       end.
     6180     end.
     6181   end procedure.
     6182   procedure cb_rst-ahsp_overturn-exist :
     6183     define input  parameter p-artic          as character no-undo .
     6184     define input  parameter p-prod-type      as character no-undo .
     6185     define input  parameter p-prod-code      as integer   no-undo .
     6186     define output parameter p-overturn-exist as logical   no-undo .
     6187     define buffer buf_doclslib-goods for doclslib-goods .
     6188     do
     6189     on error undo, return error return-value
     6190     :
     6191       find first buf_doclslib-goods
     6192         where buf_doclslib-goods.artic     = p-artic
     6193           and buf_doclslib-goods.prod-type = p-prod-type
     6194           and buf_doclslib-goods.prod-code = p-prod-code
     6195         no-error .
     6196       if available buf_doclslib-goods
     6197       then do:
     6198         assign
     6199           p-overturn-exist = true
     6200         .
     6201       end.
     6202       else do:
     6203         assign
     6204           p-overturn-exist = false
     6205         .
     6206       end.
     6207     end.
     6208   end procedure.
     6209   procedure cb_rst-ahsp_get-temp-supp-gds :
     6210     define input  parameter p-callback-handle as handle    no-undo .
     6211     define input  parameter p-procedure-name  as character no-undo .
     6212     define buffer buf_temp-supp-gds for temp-supp-gds .
     6213     do
     6214     on error undo, return error return-value
     6215     :
     6216       for each buf_temp-supp-gds
     6217       on error undo, return error return-value
     6218       :
     6219         run value(p-procedure-name) in p-callback-handle
     6220           (input  buf_temp-supp-gds.cli-type
     6221           ,input  buf_temp-supp-gds.cli-code
     6222           ,input  buf_temp-supp-gds.artic
     6223           ,input  buf_temp-supp-gds.prod-type
     6224           ,input  buf_temp-supp-gds.prod-code
     6225           ) .
     6226       end.
     6227     end.
     6228   end procedure.
     6229   procedure rst-ahsp-init-clients :
     6230     define buffer buf_doclslib-clients for doclslib-clients .
     6231     define buffer buf_doclslib-clients-goods for doclslib-clients-goods .
     6232     do
     6233     on error undo, return error return-value
     6234     :
     6235       for each buf_doclslib-clients
     6236       on error undo, return error return-value
     6237       :
     6238         delete buf_doclslib-clients .
     6239       end.
     6240       for each buf_doclslib-clients-goods
     6241       on error undo, return error return-value
     6242       :
     6243         find first buf_doclslib-clients
     6244           where buf_doclslib-clients.cli-type = buf_doclslib-clients-goods.cli-type
     6245             and buf_doclslib-clients.cli-code = buf_doclslib-clients-goods.cli-code
     6246           no-error .
     6247         if not available buf_doclslib-clients
     6248         then do:
     6249           create buf_doclslib-clients .
     6250           assign
     6251             buf_doclslib-clients.cli-type = buf_doclslib-clients-goods.cli-type
     6252             buf_doclslib-clients.cli-code = buf_doclslib-clients-goods.cli-code
     6253           .
     6254         end.
     6255       end.
     6256     end.
     6257   end procedure.
     6258   procedure rst-ahsp-init-clients-goods :
     6259     define buffer buf_doclslib-clients-goods for doclslib-clients-goods .
     6260     define buffer buf_doc-list       for doc-list .
     6261     define buffer buf_parts          for ub.parts .
     6262     define variable v-gds-code as integer   no-undo .
     6263     do
     6264     on error undo, return error return-value
     6265     :
     6266       for each buf_doclslib-clients-goods
     6267       on error undo, return error return-value
     6268       :
     6269         delete buf_doclslib-clients-goods .
     6270       end.
     6271       for each buf_doc-list
     6272       on error undo, return error return-value
     6273       :
     6274         for each buf_parts no-lock
     6275           where buf_parts.out-code = buf_doc-list.doc-code
     6276         on error undo, return error return-value
     6277         :
     6278   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6280     (input  buf_parts.artic
     6281     ,input  buf_parts.prod-type
     6282     ,input  buf_parts.prod-code
     6283     ,output v-gds-code
     6284     )  .
     6285           find first buf_doclslib-clients-goods
     6286             where buf_doclslib-clients-goods.cli-type  = buf_parts.supp-type
     6287               and buf_doclslib-clients-goods.cli-code  = buf_parts.supp-code
     6288               and buf_doclslib-clients-goods.artic     = buf_parts.artic
     6289               and buf_doclslib-clients-goods.prod-type = buf_parts.prod-type
     6290               and buf_doclslib-clients-goods.prod-code = buf_parts.prod-code
     6291             no-error .
     6292           if not available buf_doclslib-clients-goods
     6293           then do:
     6294             create buf_doclslib-clients-goods .
     6295             assign
     6296               buf_doclslib-clients-goods.cli-type  = buf_parts.supp-type
     6297               buf_doclslib-clients-goods.cli-code  = buf_parts.supp-code
     6298               buf_doclslib-clients-goods.artic     = buf_parts.artic
     6299               buf_doclslib-clients-goods.prod-type = buf_parts.prod-type
     6300               buf_doclslib-clients-goods.prod-code = buf_parts.prod-code
     6301             .
     6302           end.
     6303         end.
     6304       end.
     6305     end.
     6306   end procedure.
     6307   procedure check-md5-signature :
     6308     define input  parameter p-obj-type     as character no-undo .
     6309     define input  parameter p-obj-code     as integer   no-undo .
     6310     define input  parameter p-archive-type as character no-undo .
     6311     define input  parameter p-file-name    as character no-undo .
     6312     define buffer buf_archive-history for ub.archive-history .
     6313     do
     6314     on error undo, return error return-value
     6315     :
     6316       find first buf_archive-history exclusive-lock
     6317         where buf_archive-history.obj-type     = p-obj-type
     6318           and buf_archive-history.obj-code     = p-obj-code
     6319           and buf_archive-history.archive-type = p-archive-type
     6320           and buf_archive-history.file-valid   = true
     6321           and buf_archive-history.file-name    = p-file-name
     6322         no-error .
     6323       if not available buf_archive-history
     6324       then do:
     6325         message
     6326           "Складской архив по поставщикам" skip
     6327           "Объект" p-obj-type p-obj-code skip
     6328           "Отсутствует информация о выгрузке файла" skip
     6329           "Файл" p-file-name skip
     6330           view-as alert-box error .
     6331         undo, return error return-value .
     6332       end.
     6333       define variable v-md5-signature as character no-undo .
     6334       run gbl/md5.p
     6335         (input  p-file-name
     6336         ,output v-md5-signature
     6337         ) .
     6338       if v-md5-signature <> buf_archive-history.file-md5
     6339       then do:
     6340         message
     6341           "Складской архив по поставщикам" skip
     6342           "Объект" p-obj-type p-obj-code skip
     6343           "Контрольная сумма файла не совпадает с информацией о выгрузке файла" skip
     6344           "Файл" p-file-name skip
     6345           "Контрольная сумма" v-md5-signature skip
     6346           "Информация о выгрузке файла" buf_archive-history.file-md5 skip
     6347           view-as alert-box error .
     6348         undo, return error return-value .
     6349       end.
     6350     end.
     6351   end procedure.
     6352   procedure invalidate-md5-signature :
     6353     define input  parameter p-obj-type     as character no-undo .
     6354     define input  parameter p-obj-code     as integer   no-undo .
     6355     define input  parameter p-archive-type as character no-undo .
     6356     define input  parameter p-file-name    as character no-undo .
     6357     define input  parameter p-chip-num     as integer   no-undo .
     6358     define buffer buf_archive-history for ub.archive-history .
     6359     do
     6360     on error undo, return error return-value
     6361     :
     6362       find first buf_archive-history exclusive-lock
     6363         where buf_archive-history.obj-type     = p-obj-type
     6364           and buf_archive-history.obj-code     = p-obj-code
     6365           and buf_archive-history.archive-type = p-archive-type
     6366           and buf_archive-history.file-valid   = true
     6367           and buf_archive-history.file-name    = p-file-name
     6368         no-error .
     6369       if available buf_archive-history
     6370       then do:
     6371         assign
     6372           buf_archive-history.file-valid            = false
     6373           buf_archive-history.file-invalid-chip-num = p-chip-num
     6374         .
     6375       end.
     6376     end.
     6377   end procedure.
     6378   procedure fill-artic :
     6379     define input  parameter p-gds-code  as integer   no-undo .
     6380     define output parameter p-artic     as character no-undo .
     6381     define output parameter p-prod-type as character no-undo .
     6382     define output parameter p-prod-code as integer   no-undo .
     6383     define buffer buf_temp-goods for temp-goods .
     6384     define buffer buf_goods for ub.goods .
     6385     do
     6386     on error undo, return error return-value
     6387     :
     6388       find first buf_temp-goods
     6389         where buf_temp-goods.gds-code = p-gds-code
     6390         no-error .
     6391       if not available buf_temp-goods
     6392       then do:
     6393         find first buf_goods no-lock
     6394           where buf_goods.gds-code = p-gds-code
     6395           no-error .
     6396         if not available buf_goods
     6397         then do:
     6398           message
     6399             vss-workfile vss-revision vss-description skip
     6400             "Не найден товар" skip
     6401             "Код товара" p-gds-code skip
     6402             view-as alert-box error .
     6403           undo, return error return-value .
     6404         end.
     6405         create buf_temp-goods .
     6406         assign
     6407           buf_temp-goods.gds-code  = p-gds-code
     6408           buf_temp-goods.artic     = buf_goods.artic
     6409           buf_temp-goods.prod-type = buf_goods.prod-type
     6410           buf_temp-goods.prod-code = buf_goods.prod-code
     6411         .
     6412       end.
     6413       assign
     6414         p-artic     = buf_temp-goods.artic
     6415         p-prod-type = buf_temp-goods.prod-type
     6416         p-prod-code = buf_temp-goods.prod-code
     6417       .
     6418     end.
     6419   end procedure.
