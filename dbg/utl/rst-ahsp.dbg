     2544       ,output v-cntxt-db-num-obj
     2545       ,output v-cntxt-is-admin
     2546       ) .
     2547   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2548   run userobjs_select-one in this-procedure
     2549     (input  parparentproc
     2550     ,input  v-cntxt-db-num
     2551     ,input  v-cntxt-userid
     2552     ,input  v-cntxt-host-code-obj
     2553     ,input  v-cntxt-obj-type
     2554     ,input  v-cntxt-obj-code
     2555     ,output v-user-select
     2556     ,output v-obj-type
     2557     ,output v-obj-code
     2558     )  .
     2559     if v-user-select <> true
     2560     then do:
