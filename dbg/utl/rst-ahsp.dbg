     5703   procedure ahrstutl-store-supp-tot :
     5704     define input  parameter p-obj-type                   as character no-undo .
     5705     define input  parameter p-obj-code                   as integer   no-undo .
     5706     define input  parameter p-cli-type                   as character no-undo .
     5707     define input  parameter p-cli-code                   as integer   no-undo .
     5708     define input  parameter p-sum-type                   as character no-undo .
     5709     define input  parameter p-shift-on                   as logical   no-undo .
     5710     define input  parameter p-first-cut-date             as date      no-undo .
     5711     define input  parameter p-last-cut-date              as date      no-undo .
     5712     define input  parameter p-first-day-end-fact-order   as decimal   no-undo .
     5713     define input  parameter p-first-shift-end-fact-order as decimal   no-undo .
     5714     define input  parameter p-first-shift-date           as date      no-undo .
     5715     define input  parameter p-first-shift-num            as integer   no-undo .
     5716     define input  parameter p-last-day-end-fact-order    as decimal   no-undo .
     5717     define input  parameter p-last-shift-end-fact-order  as decimal   no-undo .
     5718     define input  parameter p-last-shift-date            as date      no-undo .
     5719     define input  parameter p-last-shift-num             as integer   no-undo .
     5720     define buffer buf_stk-supp-tot            for ub.stk-supp-tot .
     5721     define buffer buf_temp-stk-supp-tot       for temp-stk-supp-tot .
     5722     define buffer buf_temp-shift-stk-supp-tot for temp-shift-stk-supp-tot .
     5723     define buffer sub_temp-stk-supp-tot       for temp-stk-supp-tot .
     5724     define buffer sub_stk-supp-tot            for ub.stk-supp-tot .
     5725     define buffer sub_temp-shift-stk-supp-tot for temp-stk-supp-tot .
     5726     do
     5727     on error undo, return error return-value
     5728     :
     5729       for each buf_temp-stk-supp-tot
     5730         where buf_temp-stk-supp-tot.obj-type = p-obj-type
     5731           and buf_temp-stk-supp-tot.obj-code = p-obj-code
     5732           and buf_temp-stk-supp-tot.cli-type = p-cli-type
     5733           and buf_temp-stk-supp-tot.cli-code = p-cli-code
     5734           and buf_temp-stk-supp-tot.sum-type = p-sum-type
     5735       on error undo, return error return-value
