     3420       run clntattr-delete in this-procedure
     3421         (input  v-obj-type
     3422         ,input  v-obj-code
     3423         ,input  'ahsp-del':U
     3424         ,output v-delete-ahsp-del
     3425         ) .
     3426     end.
     3427     else do:
     3428       define buffer lock_shift-obj for ub.shift-obj .
     3429       run factord-lock-shift in this-procedure
     3430         (input  v-obj-type
     3431         ,input  v-obj-code
     3432         ,input  v-restore-start-date - 1
     3433         ,buffer lock_shift-obj
     3434         ) no-error .
     3435       if error-status :error
     3436       then do:
