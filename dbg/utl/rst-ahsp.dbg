     2530   define variable v-ok                  as logical   no-undo .
     2531   define variable v-line-num            as integer   no-undo .
     2532   do
     2533   on error undo, return error return-value
     2534   :
     2535     define variable rid-list as character no-undo .
     2536   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2537     run mainmenu_getcntxt in parparentproc
     2538       (output v-cntxt-db-num
     2539       ,output v-cntxt-userid
     2540       ,output v-cntxt-level
     2541       ,output v-cntxt-host-code-obj
