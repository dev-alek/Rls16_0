     4907               buf_temp-shift-stk-supp-line.artic      = p-artic
     4908               buf_temp-shift-stk-supp-line.prod-type  = p-prod-type
     4909               buf_temp-shift-stk-supp-line.prod-code  = p-prod-code
     4910               buf_temp-shift-stk-supp-line.sum-type   = p-root-sum-type
     4911               buf_temp-shift-stk-supp-line.cat-id     = '##':U
     4912               buf_temp-shift-stk-supp-line.fact-order = p-shift-create-line-fact-order
     4913               buf_temp-shift-stk-supp-line.fact-date  = p-fact-date
     4914               buf_temp-shift-stk-supp-line.shift-date = p-shift-date
     4915               buf_temp-shift-stk-supp-line.shift-num  = p-shift-num
     4916             .
     4917           end.
     4918         end.
     4919       end.
     4920       if p-save-new = false
     4921       then do:
     4922         create buf_temp-create-stk-supp-line .
     4923         assign
     4924           buf_temp-create-stk-supp-line.obj-type    = p-obj-type
     4925           buf_temp-create-stk-supp-line.obj-code    = p-obj-code
     4926           buf_temp-create-stk-supp-line.cli-type    = p-cli-type
     4927           buf_temp-create-stk-supp-line.cli-code    = p-cli-code
     4928           buf_temp-create-stk-supp-line.artic       = p-artic
     4929           buf_temp-create-stk-supp-line.prod-type   = p-prod-type
     4930           buf_temp-create-stk-supp-line.prod-code   = p-prod-code
     4931           buf_temp-create-stk-supp-line.sum-type    = p-root-sum-type
     4932           buf_temp-create-stk-supp-line.need-create = v-create-stk
     4933         .
     4934       end.
     4935     end.
     4936   end procedure.
     4937   procedure ahrstutl-create-stk :
     4938     define input  parameter p-obj-type  as character no-undo .
     4939     define input  parameter p-obj-code  as integer   no-undo .
     4940     define input  parameter p-fact-date as date      no-undo .
     4941     define variable v-shift-on                as logical   no-undo .
     4942     define variable v-shift-date              as date      no-undo .
     4943     define variable v-shift-num               as integer   no-undo .
     4944     define variable v-day-end-fact-order      as decimal   no-undo .
     4945     define variable v-shift-end-fact-order    as decimal   no-undo .
     4946     define buffer buf_temp-create-stk-supp-tot  for temp-create-stk-supp-tot .
     4947     define buffer buf_temp-create-stk-supp-line for temp-create-stk-supp-line .
     4948     define buffer buf_temp-stk-supp-tot for temp-stk-supp-tot .
     4949     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     4950     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     4951     define buffer buf_stk-supp-line for ub.stk-supp-line .
     4952     do
     4953     on error undo, return error return-value
     4954     :
     4955       run factord-cut-archive in this-procedure
     4956         (input  p-obj-type
     4957         ,input  p-obj-code
     4958         ,input  p-fact-date
     4959         ,output v-shift-on
     4960         ,output v-shift-date
     4961         ,output v-shift-num
     4962         ,output v-day-end-fact-order
     4963         ,output v-shift-end-fact-order
     4964         ) .
     4965       run show-action in this-procedure
     4966         (input "Создание остатка на текущую дату"
     4967         ).
     4968       define variable v-total-count as integer   no-undo .
     4969       for each buf_temp-create-stk-supp-tot
     4970         where buf_temp-create-stk-supp-tot.need-create = true
     4971       on error undo, return error return-value
     4972       :
     4973         assign
     4974           v-total-count = v-total-count + 1
     4975         .
     4976         if v-total-count modulo 10 = 0
     4977         then do:
     4978           run show-count in this-procedure
     4979             (input v-total-count
     4980             ,input ""
     4981             ).
     4982         end.
     4983         for each buf_temp-stk-supp-tot
     4984           where buf_temp-stk-supp-tot.obj-type   = buf_temp-create-stk-supp-tot.obj-type
     4985             and buf_temp-stk-supp-tot.obj-code   = buf_temp-create-stk-supp-tot.obj-code
     4986             and buf_temp-stk-supp-tot.cli-type   = buf_temp-create-stk-supp-tot.cli-type
     4987             and buf_temp-stk-supp-tot.cli-code   = buf_temp-create-stk-supp-tot.cli-code
     4988             and buf_temp-stk-supp-tot.fact-order = v-day-end-fact-order
     4989             and buf_temp-stk-supp-tot.sum-type   begins buf_temp-create-stk-supp-tot.sum-type
     4990         on error undo, return error return-value
     4991         :
     4992           create buf_stk-supp-tot .
     4993           buffer-copy buf_temp-stk-supp-tot to buf_stk-supp-tot
     4994           .
     4995         end.
     4996         if v-shift-on = true
     4997         then do:
     4998           for each buf_temp-stk-supp-tot
     4999             where buf_temp-stk-supp-tot.obj-type   = buf_temp-create-stk-supp-tot.obj-type
     5000               and buf_temp-stk-supp-tot.obj-code   = buf_temp-create-stk-supp-tot.obj-code
     5001               and buf_temp-stk-supp-tot.cli-type   = buf_temp-create-stk-supp-tot.cli-type
     5002               and buf_temp-stk-supp-tot.cli-code   = buf_temp-create-stk-supp-tot.cli-code
     5003               and buf_temp-stk-supp-tot.fact-order = v-shift-end-fact-order
     5004               and buf_temp-stk-supp-tot.sum-type   begins buf_temp-create-stk-supp-tot.sum-type
     5005           on error undo, return error return-value
     5006           :
     5007             create buf_stk-supp-tot .
     5008             buffer-copy buf_temp-stk-supp-tot to buf_stk-supp-tot
     5009             .
     5010           end.
     5011         end.
     5012       end.
     5013       assign
     5014         v-total-count = 0
     5015       .
     5016       for each buf_temp-create-stk-supp-line
     5017         where buf_temp-create-stk-supp-line.need-create = true
     5018       on error undo, return error return-value
     5019       :
     5020         assign
     5021           v-total-count = v-total-count + 1
     5022         .
     5023         if v-total-count modulo 10 = 0
     5024         then do:
     5025           run show-count in this-procedure
     5026             (input v-total-count
     5027             ,input "Артикул " + buf_temp-create-stk-supp-line.artic
     5028             ).
     5029         end.
     5030         for each buf_temp-stk-supp-line
     5031           where buf_temp-stk-supp-line.obj-type   = buf_temp-create-stk-supp-line.obj-type
     5032             and buf_temp-stk-supp-line.obj-code   = buf_temp-create-stk-supp-line.obj-code
     5033             and buf_temp-stk-supp-line.cli-type   = buf_temp-create-stk-supp-line.cli-type
     5034             and buf_temp-stk-supp-line.cli-code   = buf_temp-create-stk-supp-line.cli-code
     5035             and buf_temp-stk-supp-line.artic      = buf_temp-create-stk-supp-line.artic
     5036             and buf_temp-stk-supp-line.prod-type  = buf_temp-create-stk-supp-line.prod-type
     5037             and buf_temp-stk-supp-line.prod-code  = buf_temp-create-stk-supp-line.prod-code
     5038             and buf_temp-stk-supp-line.fact-order = v-day-end-fact-order
     5039             and buf_temp-stk-supp-line.sum-type   begins buf_temp-create-stk-supp-line.sum-type
     5040         on error undo, return error return-value
     5041         :
     5042           create buf_stk-supp-line .
     5043           buffer-copy buf_temp-stk-supp-line to buf_stk-supp-line
     5044           .
     5045         end.
     5046         if v-shift-on = true
     5047         then do:
     5048           for each buf_temp-stk-supp-line
     5049             where buf_temp-stk-supp-line.obj-type   = buf_temp-create-stk-supp-line.obj-type
     5050               and buf_temp-stk-supp-line.obj-code   = buf_temp-create-stk-supp-line.obj-code
     5051               and buf_temp-stk-supp-line.cli-type   = buf_temp-create-stk-supp-line.cli-type
     5052               and buf_temp-stk-supp-line.cli-code   = buf_temp-create-stk-supp-line.cli-code
     5053               and buf_temp-stk-supp-line.artic      = buf_temp-create-stk-supp-line.artic
     5054               and buf_temp-stk-supp-line.prod-type  = buf_temp-create-stk-supp-line.prod-type
     5055               and buf_temp-stk-supp-line.prod-code  = buf_temp-create-stk-supp-line.prod-code
     5056               and buf_temp-stk-supp-line.fact-order = v-shift-end-fact-order
     5057               and buf_temp-stk-supp-line.sum-type   begins buf_temp-create-stk-supp-line.sum-type
     5058           on error undo, return error return-value
     5059           :
     5060             create buf_stk-supp-line .
     5061             buffer-copy buf_temp-stk-supp-line to buf_stk-supp-line
     5062             .
     5063           end.
     5064         end.
     5065       end.
     5066     end.
     5067   end procedure.
     5068   procedure ahrstutl-clear-ahsp :
     5069     define input  parameter p-obj-type         as character no-undo .
     5070     define input  parameter p-obj-code         as integer   no-undo .
     5071     define input  parameter p-start-fact-order as decimal   no-undo .
     5072     define input  parameter p-fact-date        as date      no-undo .
     5073     define buffer buf_ot-supp-tot   for ub.ot-supp-tot .
     5074     define buffer buf_ot-supp-line  for ub.ot-supp-line .
     5075     define buffer buf_stk-supp-tot  for ub.stk-supp-tot .
     5076     define buffer buf_stk-supp-line for ub.stk-supp-line .
     5077     define variable v-shift-on                as logical   no-undo .
     5078     define variable v-shift-date              as date      no-undo .
     5079     define variable v-shift-num               as integer   no-undo .
     5080     define variable v-day-end-fact-order      as decimal   no-undo .
     5081     define variable v-shift-end-fact-order    as decimal   no-undo .
     5082     define variable v-ind as integer no-undo .
     5083     do
     5084     on error undo, return error return-value
     5085     :
     5086       run factord-cut-archive in this-procedure
     5087         (input  p-obj-type
     5088         ,input  p-obj-code
     5089         ,input  p-fact-date
     5090         ,output v-shift-on
     5091         ,output v-shift-date
     5092         ,output v-shift-num
     5093         ,output v-day-end-fact-order
     5094         ,output v-shift-end-fact-order
     5095         ) .
     5096       assign
     5097         v-day-end-fact-order   = v-day-end-fact-order   - 0.0000000001
     5098         v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     5099       .
     5100       run show-action in this-procedure
     5101         (input "Удаление оборота по документам"
     5102         ).
     5103       assign
     5104         v-ind = 0
     5105       .
     5106       for each buf_ot-supp-tot
     5107         where buf_ot-supp-tot.obj-type   = p-obj-type
     5108           and buf_ot-supp-tot.obj-code   = p-obj-code
     5109           and buf_ot-supp-tot.fact-order > p-start-fact-order
     5110           and buf_ot-supp-tot.fact-order <= v-day-end-fact-order
     5111       on error undo, return error return-value
     5112       :
     5113         assign
     5114           v-ind = v-ind + 1
     5115         .
     5116         if v-ind modulo 10 = 0
     5117         then do:
     5118           run show-count in this-procedure
     5119             (input v-ind
     5120             ,input "Документ " + string(buf_ot-supp-tot.doc-code)
     5121             ).
     5122         end.
     5123         delete buf_ot-supp-tot .
     5124       end.
     5125       run show-action in this-procedure
     5126         (input "Удаление оборота по строкам документов"
     5127         ).
     5128       assign
     5129         v-ind = 0
     5130       .
     5131       for each buf_ot-supp-line
     5132         where buf_ot-supp-line.obj-type   = p-obj-type
     5133           and buf_ot-supp-line.obj-code   = p-obj-code
     5134           and buf_ot-supp-line.fact-order > p-start-fact-order
     5135           and buf_ot-supp-line.fact-order <= v-day-end-fact-order
     5136       on error undo, return error return-value
     5137       :
     5138         assign
     5139           v-ind = v-ind + 1
     5140         .
     5141         if v-ind modulo 10 = 0
     5142         then do:
     5143           run show-count in this-procedure
     5144             (input v-ind
     5145             ,input "Документ " + string(buf_ot-supp-line.doc-code)
     5146                     + " Артикул " + string(buf_ot-supp-line.artic)
     5147             ).
     5148         end.
     5149         delete buf_ot-supp-line .
     5150       end.
     5151       run show-action in this-procedure
     5152         (input "Удаление остатка по объекту"
     5153         ).
     5154       assign
     5155         v-ind = 0
     5156       .
     5157       for each buf_stk-supp-tot
     5158         where buf_stk-supp-tot.obj-type   = p-obj-type
     5159           and buf_stk-supp-tot.obj-code   = p-obj-code
     5160           and buf_stk-supp-tot.fact-order > p-start-fact-order
     5161           and buf_stk-supp-tot.fact-order <= v-day-end-fact-order
     5162       on error undo, return error return-value
     5163       :
     5164         assign
     5165           v-ind = v-ind + 1
     5166         .
     5167         if v-ind modulo 10 = 0
     5168         then do:
     5169           run show-count in this-procedure
     5170             (input v-ind
     5171             ,input "Дата " + string(buf_stk-supp-tot.fact-date, '99/99/9999':U )
     5172             ).
     5173         end.
     5174         if buf_stk-supp-tot.shift-date = ?
     5175         or (buf_stk-supp-tot.shift-date <> ?
     5176             and
     5177             buf_stk-supp-tot.fact-order <= v-shift-end-fact-order
     5178            )
     5179         then do:
     5180           delete buf_stk-supp-tot .
     5181         end.
     5182       end.
     5183       run show-action in this-procedure
     5184         (input "Удаление остатка по товарам на объекте"
     5185         ).
     5186       assign
     5187         v-ind = 0
     5188       .
     5189       for each buf_stk-supp-line
     5190         where buf_stk-supp-line.obj-type   = p-obj-type
     5191           and buf_stk-supp-line.obj-code   = p-obj-code
     5192           and buf_stk-supp-line.fact-order > p-start-fact-order
     5193           and buf_stk-supp-line.fact-order <= v-day-end-fact-order
     5194       on error undo, return error return-value
     5195       :
     5196         assign
     5197           v-ind = v-ind + 1
     5198         .
     5199         if v-ind modulo 10 = 0
     5200         then do:
     5201           run show-count in this-procedure
     5202             (input v-ind
     5203             ,input "Артикул " + string(buf_stk-supp-line.artic)
     5204             ).
     5205         end.
     5206         if buf_stk-supp-line.shift-date = ?
     5207         or (buf_stk-supp-line.shift-date <> ?
     5208             and
     5209             buf_stk-supp-line.fact-order <= v-shift-end-fact-order
     5210            )
     5211         then do:
     5212           delete buf_stk-supp-line .
     5213         end.
     5214       end.
     5215     end.
     5216   end procedure.
     5217   procedure ahrstutl-delete-copy :
     5218     define input  parameter p-obj-type  as character no-undo .
     5219     define input  parameter p-obj-code  as integer   no-undo .
     5220     define input  parameter p-fact-date as date      no-undo .
     5221     define buffer buf_stk-supp-tot  for ub.stk-supp-tot .
     5222     define buffer buf_stk-supp-line for ub.stk-supp-line .
     5223     define buffer buf_temp-create-stk-supp-tot for temp-create-stk-supp-tot .
     5224     define buffer buf_temp-create-stk-supp-line for temp-create-stk-supp-line .
     5225     define variable v-shift-on                as logical   no-undo .
     5226     define variable v-shift-date              as date      no-undo .
     5227     define variable v-shift-num               as integer   no-undo .
     5228     define variable v-day-end-fact-order      as decimal   no-undo .
     5229     define variable v-shift-end-fact-order    as decimal   no-undo .
     5230     define variable v-ind as integer no-undo .
     5231     do
     5232     on error undo, return error return-value
     5233     :
     5234       run factord-cut-archive in this-procedure
     5235         (input  p-obj-type
     5236         ,input  p-obj-code
     5237         ,input  p-fact-date
     5238         ,output v-shift-on
     5239         ,output v-shift-date
     5240         ,output v-shift-num
     5241         ,output v-day-end-fact-order
     5242         ,output v-shift-end-fact-order
     5243         ) .
     5244       run show-action in this-procedure
     5245         (input "Удаление повторных остатков"
     5246         ).
     5247       define variable v-total-count as integer   no-undo .
     5248       assign
     5249         v-total-count = 0
     5250       .
     5251       for each buf_temp-create-stk-supp-tot
     5252       on error undo, return error return-value
     5253       :
     5254         assign
     5255           v-total-count = v-total-count + 1
     5256         .
     5257         if v-ind modulo 10 = 0
     5258         then do:
     5259           run show-count in this-procedure
     5260             (input v-total-count
     5261             ,input "Остатки по объекту"
     5262             ).
     5263         end.
     5264         find last buf_stk-supp-tot no-lock
     5265           where buf_stk-supp-tot.obj-type   = buf_temp-create-stk-supp-tot.obj-type
     5266             and buf_stk-supp-tot.obj-code   = buf_temp-create-stk-supp-tot.obj-code
     5267             and buf_stk-supp-tot.cli-type   = buf_temp-create-stk-supp-tot.cli-type
     5268             and buf_stk-supp-tot.cli-code   = buf_temp-create-stk-supp-tot.cli-code
     5269             and buf_stk-supp-tot.fact-order = v-day-end-fact-order - 0.0000000001
     5270             and buf_stk-supp-tot.sum-type   = buf_temp-create-stk-supp-tot.sum-type
     5271             and buf_stk-supp-tot.cat-id     = '##':U
     5272           no-error .
     5273         if available buf_stk-supp-tot
     5274         then do:
     5275           for each buf_stk-supp-tot exclusive-lock
     5276             where buf_stk-supp-tot.obj-type   = buf_temp-create-stk-supp-tot.obj-type
     5277               and buf_stk-supp-tot.obj-code   = buf_temp-create-stk-supp-tot.obj-code
     5278               and buf_stk-supp-tot.cli-type   = buf_temp-create-stk-supp-tot.cli-type
     5279               and buf_stk-supp-tot.cli-code   = buf_temp-create-stk-supp-tot.cli-code
     5280               and buf_stk-supp-tot.fact-order = v-day-end-fact-order - 0.0000000001
     5281               and buf_stk-supp-tot.sum-type   begins buf_temp-create-stk-supp-tot.sum-type
     5282           on error undo, return error return-value
     5283           :
     5284             delete buf_stk-supp-tot .
     5285           end.
     5286         end.
     5287         else do:
     5288           for each buf_stk-supp-tot exclusive-lock
     5289             where buf_stk-supp-tot.obj-type   = buf_temp-create-stk-supp-tot.obj-type
     5290               and buf_stk-supp-tot.obj-code   = buf_temp-create-stk-supp-tot.obj-code
     5291               and buf_stk-supp-tot.cli-type   = buf_temp-create-stk-supp-tot.cli-type
     5292               and buf_stk-supp-tot.cli-code   = buf_temp-create-stk-supp-tot.cli-code
     5293               and buf_stk-supp-tot.fact-order = v-day-end-fact-order
     5294               and buf_stk-supp-tot.sum-type   begins buf_temp-create-stk-supp-tot.sum-type
     5295           on error undo, return error return-value
     5296           :
     5297             delete buf_stk-supp-tot .
     5298           end.
     5299         end.
     5300         if v-shift-on = true
     5301         then do:
     5302           find last buf_stk-supp-tot no-lock
     5303             where buf_stk-supp-tot.obj-type   = buf_temp-create-stk-supp-tot.obj-type
     5304               and buf_stk-supp-tot.obj-code   = buf_temp-create-stk-supp-tot.obj-code
     5305               and buf_stk-supp-tot.cli-type   = buf_temp-create-stk-supp-tot.cli-type
     5306               and buf_stk-supp-tot.cli-code   = buf_temp-create-stk-supp-tot.cli-code
     5307               and buf_stk-supp-tot.fact-order = v-shift-end-fact-order - 0.0000000001
     5308               and buf_stk-supp-tot.sum-type   = buf_temp-create-stk-supp-tot.sum-type
     5309               and buf_stk-supp-tot.cat-id     = '##':U
     5310             no-error .
     5311           if available buf_stk-supp-tot
     5312           then do:
     5313             for each buf_stk-supp-tot exclusive-lock
     5314               where buf_stk-supp-tot.obj-type   = buf_temp-create-stk-supp-tot.obj-type
     5315                 and buf_stk-supp-tot.obj-code   = buf_temp-create-stk-supp-tot.obj-code
     5316                 and buf_stk-supp-tot.cli-type   = buf_temp-create-stk-supp-tot.cli-type
     5317                 and buf_stk-supp-tot.cli-code   = buf_temp-create-stk-supp-tot.cli-code
     5318                 and buf_stk-supp-tot.fact-order = v-shift-end-fact-order - 0.0000000001
     5319                 and buf_stk-supp-tot.sum-type   begins buf_temp-create-stk-supp-tot.sum-type
     5320             on error undo, return error return-value
     5321             :
     5322               delete buf_stk-supp-tot .
     5323             end.
     5324           end.
     5325           else do:
     5326             for each buf_stk-supp-tot exclusive-lock
     5327               where buf_stk-supp-tot.obj-type   = buf_temp-create-stk-supp-tot.obj-type
     5328                 and buf_stk-supp-tot.obj-code   = buf_temp-create-stk-supp-tot.obj-code
     5329                 and buf_stk-supp-tot.cli-type   = buf_temp-create-stk-supp-tot.cli-type
     5330                 and buf_stk-supp-tot.cli-code   = buf_temp-create-stk-supp-tot.cli-code
     5331                 and buf_stk-supp-tot.fact-order = v-shift-end-fact-order
     5332                 and buf_stk-supp-tot.sum-type   begins buf_temp-create-stk-supp-tot.sum-type
     5333             on error undo, return error return-value
     5334             :
     5335               delete buf_stk-supp-tot .
     5336             end.
     5337           end.
     5338         end.
     5339       end.
     5340       assign
