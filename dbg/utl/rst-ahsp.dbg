     5496   procedure ahrstutl-update :
     5497     define input  parameter p-obj-type           as character no-undo .
     5498     define input  parameter p-obj-code           as integer   no-undo .
     5499     define input  parameter p-first-cut-date     as date      no-undo .
     5500     define input  parameter p-last-cut-date      as date      no-undo .
     5501     define buffer buf_temp-supp for temp-supp .
     5502     define buffer buf_temp-supp-gds for temp-supp-gds .
     5503     define variable v-shift-on                   as logical   no-undo .
     5504     define variable v-first-shift-date           as date      no-undo .
     5505     define variable v-first-shift-num            as integer   no-undo .
     5506     define variable v-first-day-end-fact-order   as decimal   no-undo .
     5507     define variable v-first-shift-end-fact-order as decimal   no-undo .
     5508     define variable v-last-shift-date            as date      no-undo .
     5509     define variable v-last-shift-num             as integer   no-undo .
     5510     define variable v-last-day-end-fact-order    as decimal   no-undo .
     5511     define variable v-last-shift-end-fact-order  as decimal   no-undo .
     5512     define variable v-sum-type-list as character no-undo .
     5513     define variable v-ind as integer   no-undo .
     5514     do
     5515     on error undo, return error return-value
     5516     :
     5517       run factord-cut-archive in this-procedure
     5518         (input  p-obj-type
     5519         ,input  p-obj-code
     5520         ,input  p-first-cut-date
     5521         ,output v-shift-on
     5522         ,output v-first-shift-date
     5523         ,output v-first-shift-num
     5524         ,output v-first-day-end-fact-order
     5525         ,output v-first-shift-end-fact-order
     5526         ) .
     5527       run factord-cut-archive in this-procedure
     5528         (input  p-obj-type
     5529         ,input  p-obj-code
     5530         ,input  p-last-cut-date
     5531         ,output v-shift-on
     5532         ,output v-last-shift-date
     5533         ,output v-last-shift-num
     5534         ,output v-last-day-end-fact-order
     5535         ,output v-last-shift-end-fact-order
     5536         ) .
     5537       run show-action in this-procedure
     5538         (input "Пересчитываем остаток по поставщикам"
     5539         ).
     5540       run ahrstutl-supp-tot-sum-type-list in this-procedure
     5541         (output v-sum-type-list
     5542         ) .
     5543       do v-ind = 1 to num-entries(v-sum-type-list)
     5544       :
     5545         for each buf_temp-supp
     5546         on error undo, return error return-value
     5547         :
     5548           run ahrstutl-store-supp-tot in this-procedure
     5549             (input p-obj-type
     5550             ,input p-obj-code
     5551             ,input buf_temp-supp.cli-type
     5552             ,input buf_temp-supp.cli-code
     5553             ,input entry(v-ind, v-sum-type-list)
     5554             ,input v-shift-on
     5555             ,input p-first-cut-date
     5556             ,input p-last-cut-date
     5557             ,input v-first-day-end-fact-order
     5558             ,input v-first-shift-end-fact-order
     5559             ,input v-first-shift-date
     5560             ,input v-first-shift-num
     5561             ,input v-last-day-end-fact-order
     5562             ,input v-last-shift-end-fact-order
     5563             ,input v-last-shift-date
     5564             ,input v-last-shift-num
     5565             ) no-error .
     5566           if error-status :error
     5567           then do:
     5568             message
     5569               vss-workfile vss-revision vss-description skip
     5570               "Ошибка при вызове процедуры" 'ahrstutl-store-supp-tot':u skip
     5571               "Клиент" buf_temp-supp.cli-type buf_temp-supp.cli-code skip
     5572               "v-ind" v-ind skip
     5573               "sum-type" entry(v-ind, v-sum-type-list) skip
     5574               return-value skip
     5575               error-status :get-message(1) skip
     5576               view-as alert-box error .
     5577             undo, return error return-value .
     5578           end.
     5579         end.
     5580       end.
     5581       run show-action in this-procedure
     5582         (input "Пересчитываем остаток по поставщикам, товарам"
     5583         ).
     5584       run ahrstutl-supp-line-sum-type-list in this-procedure
     5585         (output v-sum-type-list
     5586         ) .
     5587       define variable v-total-count as integer   no-undo .
     5588       for each buf_temp-supp-gds
     5589       on error undo, return error return-value
     5590       :
     5591         assign
     5592           v-total-count = v-total-count + 1
     5593         .
     5594         if v-total-count modulo 10 = 0
     5595         then do:
     5596           run show-count in this-procedure
     5597             (input v-total-count
     5598             ,input "Артикул " + string(buf_temp-supp-gds.artic)
     5599             ).
     5600         end.
     5601         do v-ind = 1 to num-entries(v-sum-type-list)
     5602         :
     5603           run ahrstutl-store-supp-line in this-procedure
     5604             (input p-obj-type
     5605             ,input p-obj-code
     5606             ,input buf_temp-supp-gds.cli-type
     5607             ,input buf_temp-supp-gds.cli-code
     5608             ,input buf_temp-supp-gds.artic
     5609             ,input buf_temp-supp-gds.prod-type
     5610             ,input buf_temp-supp-gds.prod-code
     5611             ,input entry(v-ind, v-sum-type-list)
     5612             ,input v-shift-on
     5613             ,input p-first-cut-date
     5614             ,input p-last-cut-date
     5615             ,input v-first-day-end-fact-order
     5616             ,input v-first-shift-end-fact-order
     5617             ,input v-first-shift-date
     5618             ,input v-first-shift-num
     5619             ,input v-last-day-end-fact-order
     5620             ,input v-last-shift-end-fact-order
     5621             ,input v-last-shift-date
     5622             ,input v-last-shift-num
     5623             ) no-error .
     5624           if error-status :error
     5625           then do:
     5626             message
     5627               vss-workfile vss-revision vss-description skip
     5628               "Ошибка при вызове процедуры" 'ahrstutl-store-supp-line':u skip
     5629               "Объект" p-obj-type p-obj-code skip
     5630               "Клиент" buf_temp-supp-gds.cli-type buf_temp-supp-gds.cli-code skip
     5631               "Артикул" buf_temp-supp-gds.artic buf_temp-supp-gds.prod-type buf_temp-supp-gds.prod-code skip
     5632               return-value skip
     5633               error-status :get-message(1) skip
     5634               view-as alert-box error .
     5635             undo, return error return-value .
     5636           end.
     5637         end.
     5638       end.
     5639     end.
     5640   end procedure.
     5641   procedure ahrstutl-supp-tot-sum-type-list :
     5642     define output parameter p-sum-type-list as character no-undo .
     5643     do
     5644     on error undo, return error return-value
     5645     :
     5646       define variable v-ind                    as integer   no-undo .
     5647       define variable v-num-entries-TDEDT_List as integer   no-undo .
     5648       assign
     5649         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5650       .
     5651       assign
     5652         p-sum-type-list = 'cost':U
     5653       .
     5654       do v-ind = 1 to v-num-entries-TDEDT_List
     5655       :
     5656         assign
     5657           p-sum-type-list = p-sum-type-list
     5658                           + chr(44)
     5659                           + 'sadt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5660         .
     5661       end.
     5662       do v-ind = 1 to v-num-entries-TDEDT_List
     5663       :
     5664         assign
     5665           p-sum-type-list = p-sum-type-list
     5666                           + chr(44)
     5667                           + 'csdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5668         .
     5669       end.
     5670     end.
     5671   end procedure.
