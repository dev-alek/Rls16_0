     2521   define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
     2522   define variable v-user-select         as logical   no-undo .
     2523   define variable v-obj-type            as character no-undo .
     2524   define variable v-obj-code            as integer   no-undo .
     2525   define variable v-file-name           as character no-undo .
     2526   define variable v-backup-file-name    as character no-undo .
     2527   define variable v-today               as date      no-undo .
     2528   define variable v-restore-start-date  as date      no-undo .
