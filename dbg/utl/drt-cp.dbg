        1   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        2   DEFINE INPUT PARAMETER p-param-num AS CHARACTER NO-UNDO.
        3   DEFINE INPUT-output PARAMETER p-param-value AS CHARACTER NO-UNDO.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Редактирование свойства Run-params".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65   define variable v-waitfram-action01         as character   no-undo .
       66   define variable v-waitfram-action02         as character   no-undo .
       67   define variable v-waitfram-action03         as character   no-undo .
       68   define variable mWaitFramTextBeg            as character   no-undo.
       69   define variable mWaitFramTextEnd            as character   no-undo.
       70   define variable mWaitFramView               as logical     no-undo.
       71   define variable mWaitProcEvent              as logical     no-undo init yes.
       72   define variable mWaitFramInterval           as integer     no-undo init 1 .
       73   define variable mWaitFramStop               as logical     no-undo.
       74   define variable mWaitFramStopUser           as logical     no-undo.
       75   define variable mWaitFramStopTimeOut        as logical     no-undo.
       76   define variable mWaitFramStartProc          as datetime-tz no-undo.
       77   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       78   define button B-WaitFramStop auto-end-key
       79        label "Стоп"
       80        size 10 by 1 tooltip "Остоновить процесс".
       81   define button B-viewProcInfo
       82        label "Информация"
       83        size 15 by 1 tooltip "Информация о процесс".
       84   define frame waitfram
       85     v-waitfram-action01 format "x(72)" no-label skip
       86     v-waitfram-action02 format "x(72)" no-label skip
       87     v-waitfram-action03 format "x(72)" no-label skip
       88     B-viewProcInfo
       89     B-WaitFramStop at row 4 col 30
       90     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       91     .
       92   define new global shared variable mBatchMode as logical no-undo init ?.
       93   define variable mFramBachModHandle as handle no-undo.
       94   mFramBachModHandle = frame waitfram:handle.
       95   define variable mFameOldVis as logical no-undo.
       96   define variable mVisCUrentVin as logical no-undo.
       97   if session:batch-mode
       98   then
       99      mBatchMode = yes.
      100   if mBatchMode = ? then do:
      101     mVisCUrentVin = current-window:visible.
      102     mFameOldVis = mFramBachModHandle:visible.
      103     mFramBachModHandle:visible  = yes.
      104     mBatchMode = mFramBachModHandle:visible ne yes.
      105     mFramBachModHandle:visible = mFameOldVis.
      106     current-window:visible = mVisCUrentVin.
      107   end.
      108    if  log-manager:logfile-name ne ?
      109     then DO:
      110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      112         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      113     end.
      114   on choose of B-WaitFramStop in frame waitfram
      115   do:
      116     mWaitFramStop = yes.
      117     mWaitFramStopUser = yes.
      118   end.
      119   function waitfram-check-timeout returns logical():
      120      define variable vtime as int64 no-undo.
      121      if mWaitFramStopTimeOut
      122      then
      123         return yes.
      124      vtime = ( now - mWaitFramStartProc ) / 1000 .
      125      if     mWaitFramTimeOut ne ?
      126         and mWaitFramTimeOut ne 0
      127         and mWaitFramTimeOut lt vtime
      128      then do:
      129         mWaitFramStopTimeOut = yes.
      130      end.
      131      return mWaitFramStopTimeOut.
      132   end.
      133   procedure waitfram-hide :
      134     if not session:batch-mode
      135     then do
      136     on error undo, return error return-value
      137     :
      138       pause 0 before-hide .
      139       if not mBatchMode then
      140         hide frame waitfram .
      141     if     not mWaitFramView
      142        and mWaitProcEvent
      143     then
      144       process events .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208       if     mWaitFramView
      209          then do:
      210             if     mWaitFramInterval ne ?
      211                and not mBatchMode
      212             then
      213                wait-for go of frame waitfram pause mWaitFramInterval.
      214          end.
      215          else
      216             if     mWaitProcEvent
      217                and not mBatchMode
      218             then
      219                process events .
      220     end.
      221   end procedure.
      222      procedure waitfram-show-this:
      223         define input  parameter iInterval as int64 no-undo.
      224         define variable vtime as int64 no-undo.
      225         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      226         mWaitFramInterval = iInterval.
      227         run waitfram-show (substitute("&1&2 &3&4" ,
      228                                       mWaitFramTextBeg ,
      229                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      230                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      231                                       mWaitFramTextEnd
      232                                      )
      233                           ).
      234      end.
      235      procedure WaitFramRunPause:
      236         define input  parameter iInterval as dec no-undo.
      237         define variable vStart  as datetime-tz no-undo.
      238         define variable vend    as datetime-tz no-undo.
      239         define variable vint as int64 no-undo.
      240         define variable vOk as logical no-undo.
      241         vStart = now.
      242         vend   = vStart.
      243         publish "WaitFramPause" (iInterval,output vOk).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and (   vint > 0
      249                 or (    not vOk
      250                     and iInterval eq ?
      251                     )
      252                 )
      253         then
      254            run waitfram-show-this (iInterval).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and vint > 0
      260         then do:
      261            run gbl/pause.p (vint * 1000).
      262         end.
      263         if iInterval ne ?
      264         then
      265            publish "WaitFramStop".
      266         waitfram-check-timeout().
      267      end.
      268      procedure WaitFramWaitFor:
      269         define input  parameter iInterval as dec no-undo.
      270         assign
      271            mWaitFramStartProc   = now
      272            mWaitFramStopUser    = no
      273            mWaitFramStopTimeOut = no
      274         .
      275         block-wait:
      276         do while not mWaitFramStop:
      277            run WaitFramRunPause (iInterval).
      278            if  waitfram-check-timeout()
      279            then do:
      280               leave block-wait.
      281            end.
      282         end.
      283         run waitfram-hide.
      284      end.
      285   procedure waitfram-join :
      286     define input  parameter p-line-1  as character no-undo .
      287     define input  parameter p-line-2  as character no-undo .
      288     define input  parameter p-line-3  as character no-undo .
      289     define output parameter p-message as character no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       assign
      294         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      297       .
      298     end.
      299   end procedure.
      300   function waitfram-join-function returns character
      301     (input p-line-1 as character
      302     ,input p-line-2 as character
      303     ,input p-line-3 as character
      304     ).
      305     define variable v-message as character no-undo .
      306     run waitfram-join in this-procedure
      307       (input  p-line-1
      308       ,input  p-line-2
      309       ,input  p-line-3
      310       ,output v-message
      311       ) .
      312     return v-message .
      313   end function .
      314   define new global shared variable g#language as character no-undo .
      315   if g#language <> '' and g#language <> 'rus':U then do:
      316     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      317   end.
      318   procedure proc-alt-shift-f2:
      319     if not ibs.th.gbl.gbl-var:rcode
      320   then
      321     run gbl\inidebug.p .
      322   end.
      323   procedure proc-alt-shift-f3:
      324     run gbl/prvssinf.p
      325       ( input this-procedure
      326       ) .
      327   end.
      328   define variable v-inform-launched as logical no-undo initial false .
      329   procedure proc-alt-shift-f4:
      330     define variable v-action as character no-undo .
      331     if v-inform-launched = false then do:
      332       assign
      333         v-inform-launched = true
      334       .
      335       run gbl/d-inform.w
      336         (  input self
      337         ,  input this-procedure
      338         , output v-action
      339         ) no-error .
      340       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      341       assign
      342         v-inform-launched = false
      343       .
      344     end.
      345   end.
      346   procedure proc-alt-f1:
      347     run gbl/corrhelp.p
      348       (input this-procedure
      349       ) .
      350   end .
      351   on alt-shift-f2 anywhere do:
      352     run proc-alt-shift-f2.
      353   end.
      354   on alt-shift-f3 anywhere do:
      355     run proc-alt-shift-f3 in this-procedure .
      356   end.
      357   on alt-shift-f4 anywhere do:
      358     run proc-alt-shift-f4 in this-procedure.
      359   end.
      360   on alt-f1 anywhere do:
      361     run proc-alt-f1 in this-procedure .
      362   end.
      363   if g#language <> '' and g#language <> 'rus':U then do:
      364     undo, return error substitute( '&1. incorrect language&2dr-flddf: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      365   end.
      366   DEFINE VARIABLE v-param-value AS character NO-UNDO.
      367   DEFINE BUTTON B-exit AUTO-GO
      368        LABEL "&Ввод"
      369        SIZE 10 BY 1
      370        BGCOLOR 8 .
      371   DEFINE BUTTON B-Help
      372        LABEL "Помо&щь"
      373        SIZE 3 BY 1
      374        BGCOLOR 8 .
      375   DEFINE BUTTON b-quit AUTO-END-KEY
      376        LABEL "&Отмена"
      377        SIZE 10 BY 1
      378        BGCOLOR 8 .
      379   DEFINE VARIABLE cb-data-type AS CHARACTER FORMAT "X(256)":U
      380        LABEL "Тип данных параметра"
      381        VIEW-AS COMBO-BOX INNER-LINES 5
      382        LIST-ITEMS "Item 1"
      383        DROP-DOWN-LIST
      384        SIZE 24.5 BY 1 NO-UNDO.
      385   DEFINE VARIABLE cb-fields AS CHARACTER FORMAT "X(256)":U
      386        LABEL "Поле привязки"
      387        VIEW-AS COMBO-BOX INNER-LINES 5
      388        LIST-ITEMS "Item 1"
      389        DROP-DOWN-LIST
      390        SIZE 25 BY 1 NO-UNDO.
      391   DEFINE VARIABLE Cb-param-mode AS CHARACTER FORMAT "X(256)":U
      392        LABEL "Мода параметра"
      393        VIEW-AS COMBO-BOX INNER-LINES 5
      394        LIST-ITEMS "Item 1"
      395        DROP-DOWN-LIST
      396        SIZE 24.5 BY 1 NO-UNDO.
      397   DEFINE VARIABLE f-param-descr AS CHARACTER FORMAT "X(256)":U
      398        LABEL "Описание"
      399        VIEW-AS FILL-IN
      400        SIZE 37 BY 1.07 NO-UNDO.
      401   DEFINE VARIABLE f-param-name AS CHARACTER FORMAT "X(256)":U
      402        LABEL "Название параметра"
      403        VIEW-AS FILL-IN
      404        SIZE 24.5 BY 1 NO-UNDO.
      405   DEFINE VARIABLE f-param-num AS INTEGER FORMAT ">9":U INITIAL 0
      406        LABEL "№ параметра"
      407        VIEW-AS FILL-IN
      408        SIZE 8 BY 1 NO-UNDO.
      409   DEFINE FRAME Dialog-Frame
      410        B-exit AT ROW 1 COL 1
      411        b-quit AT ROW 1 COL 11
      412        B-Help AT ROW 1 COL 95
      413        f-param-num AT ROW 3 COL 22 COLON-ALIGNED WIDGET-ID 4
      414        f-param-name AT ROW 5 COL 22 COLON-ALIGNED WIDGET-ID 2
      415        cb-data-type AT ROW 7.13 COL 22 COLON-ALIGNED WIDGET-ID 6
      416        Cb-param-mode AT ROW 9.53 COL 22 COLON-ALIGNED WIDGET-ID 10
      417        f-param-descr AT ROW 11.67 COL 22 COLON-ALIGNED WIDGET-ID 12
      418        cb-fields AT ROW 13.53 COL 22 COLON-ALIGNED WIDGET-ID 16
      419        SPACE(50.70) SKIP(9.02)
      420       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      421            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      422            TITLE "Свойства параметра правила скидки или расписания"
      423            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      424   ASSIGN
      425          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      426          FRAME Dialog-Frame:HIDDEN           = TRUE.
      427   ON GO OF FRAME Dialog-Frame
      428   DO:
      429     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      430     IF ERROR-STATUS:ERROR THEN UNDO, RETURN NO-APPLY.
      431     ASSIGN
      432     p-param-value = v-param-value.
      433   END.
      434   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      435   DO:
      436     APPLY "END-ERROR":U TO SELF.
      437   END.
      438   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      439   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      440   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   on help of frame Dialog-Frame
      442   do:
      443     run gbl/app_help.p
      444       (input this-procedure :file-name
      445       ,input ''
      446       ,input ?
      447       ) no-error.
      448     if error-status :error then do:
      449       message
      450         "Ошибка при вызове помощи"
      451         error-status :get-message(1)
      452         view-as alert-box .
      453     end.
      454   end.
      455   run minbtn-set in this-procedure .
      456   on choose of b-help in frame Dialog-Frame
      457   do:
      458     apply "help":u to frame Dialog-Frame .
      459   end.
      460   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      461   procedure minbtn-set :
      462       do
      463           on error undo, return error return-value
      464           :
      465           define variable ii              as integer       no-undo .
      466           define variable fh              as widget-handle no-undo .
      467           define variable hh              as widget-handle no-undo .
      468           define variable v-h             as handle        extent 4 no-undo .
      469           define variable v-name-button   as character     no-undo .
      470           define variable v-help-old-x    as decimal       no-undo .
      471           define variable v-help-old-y    as decimal       no-undo .
      472           define variable v-help-old-size as decimal       no-undo .
      473           define variable v-frame-width   as decimal       no-undo .
      474           define variable jj              as integer       no-undo .
      475           do
      476               on error undo, return error
      477               :
      478               assign
      479                   v-frame-width = frame Dialog-Frame:width - 0.3
      480                   fh            = frame Dialog-Frame:first-child
      481                   hh            = fh:first-child
      482                   ii            = 1
      483                   .
      484               do while valid-handle(hh):
      485                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      486                   do:
      487                       case lc(hh:name) :
      488                           when "b-help" then
      489                               do:
      490                                   hh:load-image-up("cmp/b-help.bmp":u) .
      491                                   hh:load-image-down("cmp/b-help.bmp":u) .
      492                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      493                                   hh:TOOLTIP = "Помощь" .
      494                                   v-help-old-x = hh:column .
      495                                   v-help-old-y = hh:row    .
      496                                   v-help-old-size = hh:width .
      497                                   hh:width-chars = 2.5 .
      498                               end.
      499                           when "b-print" then
      500                               do:
      501                                   hh:load-image("cmp/b-print.bmp":u) .
      502                                   hh:TOOLTIP = "Печать" .
      503                                   v-h[ii] = hh:handle .
      504                                   ii = ii + 1 .
      505                                   hh:width-chars = 3 .
      506                               end.
      507                           when "b-history" or
      508                           when "b-hist" then
      509                               do:
      510                                   hh:load-image("cmp/b-hist.bmp":u) .
      511                                   hh:TOOLTIP = "История" .
      512                                   v-h[ii] = hh:handle .
      513                                   ii = ii + 1 .
      514                                   hh:width-chars = 3 .
      515                               end.
      516                           when "b-sch" then
      517                               do:
      518                                   hh:load-image("cmp/b-sch.bmp":u) .
      519                                   hh:TOOLTIP = "Установка Фильтра" .
      520                                   v-h[ii] = hh:handle .
      521                                   ii = ii + 1 .
      522                                   hh:width-chars = 3 .
      523                               end.
      524                           when "b-hist-user" then
      525                               do:
      526                                   hh:load-image("cmp/b-hist.bmp":u) .
      527                                   hh:TOOLTIP = "История пользователя" .
      528                                   ii = ii + 1 .
      529                               end.
      530                       end case.
      531                   end.
      532                   hh = hh:next-sibling.
      533               end.
      534               b-help:column = v-frame-width - b-help:width-chars.
      535               jj = 0.
      536               repeat ii = 4 to 1 by -1 :
      537                   if valid-handle (v-h[ii] ) then
      538                   do:
      539                       jj  = jj + 1 .
      540                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      541                       v-h[ii]:row    = v-help-old-y .
      542                   end.
      543               end.
      544           end.
      545       end.
      546   end procedure.
      547   MAIN-BLOCK:
      548   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      549      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      550     IF NOT (p-mode = 'ПРОСМОТР':U
      551             OR p-mode = 'ДОБАВЛЕНИЕ':U
      552             OR p-mode = 'ИЗМЕНЕНИЕ':U) THEN DO:
      553        MESSAGE
      554        substitute("Неверное значение параметра p-mode = &1", p-mode)
      555        VIEW-AS ALERT-BOX ERROR.
      556        UNDO, RETURN ERROR.
      557     END.
      558     IF p-mode <> 'ДОБАВЛЕНИЕ':U
      559     AND NUM-ENTRIES(p-param-value) < 5 THEN DO:
      560        MESSAGE
      561        "Не все поля определены!"
      562        VIEW-AS ALERT-BOX ERROR.
      563     END.
      564     v-param-value = p-param-value.
      565     RUN Myenable.
      566     WAIT-FOR GO OF FRAME Dialog-Frame.
      567   END.
      568   RUN disable_UI.
      569   PROCEDURE disable_UI :
      570     HIDE FRAME Dialog-Frame.
      571   END PROCEDURE.
      572   PROCEDURE enable_UI :
      573     DISPLAY f-param-num f-param-name cb-data-type Cb-param-mode f-param-descr
      574             cb-fields
      575         WITH FRAME Dialog-Frame.
      576     ENABLE B-exit b-quit B-Help f-param-num f-param-name cb-data-type
      577            Cb-param-mode f-param-descr cb-fields
      578         WITH FRAME Dialog-Frame.
      579     VIEW FRAME Dialog-Frame.
      580   END PROCEDURE.
      581   PROCEDURE MyEnable :
      582   ASSIGN
      583   cb-data-type:LIST-ITEMS IN FRAME Dialog-Frame = 'character,date,decimal,integer,logical':U + chr(44) + 'handle':U
      584   cb-param-mode:LIST-ITEMS IN FRAME Dialog-Frame = 'input,output,input-output,buffer,input table,output table,input-output table':u .
      585   cb-fields:LIST-ITEMS IN FRAME Dialog-Frame = 'doc_chk-date,doc_chk-time,doc_dc-category,doc_dc-d-pcnt,doc_dc-cash-d-pcnt,doc_recalc-gline-num,doc_recalc-pline-num,doc_st-for-discnt-r-b,doc_to-pay-r-b,doc_base-rate,doc_obj-code':U + chr(44) +
      586                                                 'gline_line-num,gline_src-discnt,gline_src-code,gline_src-price,gline_start-src-price,gline_price-base,gline_src-qnty,gline_doc-qnty,gline_b-code,gline_gds-code,gline_sum-grp-code,gline_src-price-netto,gline_price-base-netto,gline_without-gds-discnt,gline_without-subtotal-discnt,gline_cli-base-rate,gline_recalc-line-num':U + chr(44) +
      587                                                 'dline_discnt-value-abs,dline_discnt-value-pcnt,dline_rule-num,dline_nonunique,dline_templ-rl-root,dline_value-type,dline_delta-discnt,dline_discnt-role,dline_charkey,dline_intended,dline_object-sum,dline_not-found':U + chr(44) +
      588                                                 'cntxt_chk-discnt-table,cntxt_chk-gds-table,cntxt_chk-pay-table':U + chr(44) +
      589                                                 'pline_line-num,pline_exch-rate,pline_exch-scale,pline_tot-sum,pline_recalc-line-num':U
      590   .
      591   ASSIGN
      592   f-param-num = INTEGER(p-param-num)
      593   f-param-name = ENTRY(1, p-param-value)
      594   cb-data-type = (IF NUM-ENTRIES(p-param-value) > 1
      595                     THEN ENTRY(2, p-param-value)
      596                     ELSE '')
      597   cb-param-mode = (IF NUM-ENTRIES(p-param-value) > 2
      598                    THEN ENTRY(3, p-param-value)
      599                    ELSE '')
      600   f-param-descr = (IF NUM-ENTRIES(p-param-value) > 3
      601                   THEN ENTRY(4, p-param-value)
      602                   ELSE '')
      603   cb-fields = (IF NUM-ENTRIES(p-param-value) > 4
      604                   THEN ENTRY(5, p-param-value)
      605                   ELSE '')
      606   .
      607   DISPLAY
      608   f-param-num
      609   f-param-name
      610   cb-data-type
      611   Cb-param-mode
      612   f-param-descr
      613   cb-fields
      614   WITH FRAME Dialog-Frame.
      615   ENABLE
      616   B-exit WHEN p-mode <> 'ПРОСМОТР':U
      617   b-quit
      618   B-Help
      619   f-param-num WHEN p-mode <> 'ПРОСМОТР':U
      620   f-param-name WHEN p-mode <> 'ПРОСМОТР':U
      621   cb-data-type WHEN p-mode <> 'ПРОСМОТР':U
      622   Cb-param-mode WHEN p-mode <> 'ПРОСМОТР':U
      623   f-param-descr WHEN p-mode <> 'ПРОСМОТР':U
      624   cb-fields WHEN p-mode <> 'ПРОСМОТР':U
      625   WITH FRAME Dialog-Frame.
      626   VIEW FRAME Dialog-Frame.
      627   if p-mode = 'ПРОСМОТР':U then do:
      628     assign
      629     b-quit:column = 1
      630     .
      631     hide
      632     b-exit in frame Dialog-Frame .
      633   end.
      634   END PROCEDURE.
      635   PROCEDURE proc-save :
      636   IF p-mode = 'ПРОСМОТР':U THEN UNDO, RETURN ERROR.
      637   ASSIGN frame Dialog-Frame
      638   f-param-name
      639   cb-data-type
      640   Cb-param-mode
      641   f-param-descr
      642   cb-fields
      643   v-param-value = f-param-name + chr(44) +
      644                   cb-data-type + chr(44) +
      645                   cb-param-mode + chr(44) +
      646                   f-param-descr + chr(44) +
      647                   cb-fields.
      648   END PROCEDURE.
