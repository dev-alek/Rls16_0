        1   using Progress.Lang.*.
        2   using utl.*.
        3   block-level on error undo, throw.
        4   class utl.repoPwd inherits repository:
        5      define public property Obj as class tech-prol-pwd no-undo
        6      get.
        7      set.
        8      constructor public repoPwd (iObj as class tech-prol-pwd):
        9         super ().
       10         this-object:Obj = iObj.
       11      end constructor.
       12      method override public void Refresh(  ):
       13         define buffer btech-prol-pwd for ub.tech-prol-pwd.
       14         if Obj:Id > 0 then
       15         do:
       16            find first btech-prol-pwd where
       17                       btech-prol-pwd.Id = Obj:Id
       18            no-lock no-error.
       19            if avail btech-prol-pwd then
       20            do:
       21               assign
       22                  Obj:f-date         = btech-prol-pwd.f-date
       23                  Obj:f-time         = btech-prol-pwd.f-time
       24                  Obj:f-user         = btech-prol-pwd.f-user
       25                  Obj:f-host         = btech-prol-pwd.f-host
       26                  Obj:f-pwd-type     = btech-prol-pwd.f-pwd-type
       27                  Obj:f-pwd          = btech-prol-pwd.f-pwd
       28                  Obj:f-fio          = btech-prol-pwd.f-fio
       29                  Obj:f-beg-time     = btech-prol-pwd.f-beg-time
       30                  Obj:f-end-time     = btech-prol-pwd.f-end-time
       31                  Obj:cash-desk-surr = btech-prol-pwd.cash-desk-surr
       32                  Obj:shop-surr      = btech-prol-pwd.shop-surr
       33               .
       34            end.
       35         end.
       36      end method.
       37      method override public void Save(  ):
       38         define buffer btech-prol-pwd for tech-prol-pwd.
       39         def var vId as int64 no-undo.
       40         tr:
       41         do transaction:
       42            vId = GetId().
       43            create btech-prol-pwd.
       44            assign
       45               btech-prol-pwd.id = vId
       46               btech-prol-pwd.f-date         = Obj:f-date
       47               btech-prol-pwd.f-time         = Obj:f-time
       48               btech-prol-pwd.f-user         = Obj:f-user
       49               btech-prol-pwd.f-host         = Obj:f-host
       50               btech-prol-pwd.f-pwd-type     = Obj:f-pwd-type
       51               btech-prol-pwd.f-pwd          = Obj:f-pwd
       52               btech-prol-pwd.f-fio          = Obj:f-fio
       53               btech-prol-pwd.f-beg-time     = Obj:f-beg-time
       54               btech-prol-pwd.f-end-time     = Obj:f-end-time
       55               btech-prol-pwd.cash-desk-surr = Obj:cash-desk-surr
       56               btech-prol-pwd.shop-surr      = Obj:shop-surr
       57               btech-prol-pwd.f-object-num   = INT(ENTRY(2,btech-prol-pwd.shop-surr))
       58               btech-prol-pwd.f-cash-num     = INT(ENTRY(4,btech-prol-pwd.cash-desk-surr))
       59            .
       60            run trg/userlog.p (
       61               input 'tech-prol-pwd'
       62             , input ("Генерация пароля " + chr(3) + string(vId) )
       63             , input ?
       64             , input ?
       65             , input "") no-error.
       66         end.
       67         Obj:Id = vId.
       68      end method.
       69      method private int64 GetId(  ):
       70         define buffer btech-prol-pwd for tech-prol-pwd.
       71         def var vId as int64 no-undo.
       72         vId = next-value(s-tech-prol-pwd).
       73         find first btech-prol-pwd where
       74                    btech-prol-pwd.id = vId
       75         no-lock no-error.
       76         cl:
       77         do while avail btech-prol-pwd:
       78            vId = next-value(s-tech-prol-pwd).
       79            find first btech-prol-pwd where
       80                       btech-prol-pwd.id = vId
       81            no-lock no-error.
       82         end.
       83         return vId.
       84      end method.
       85   end class.
