        1   block-level on error undo, throw.
        2   define input  parameter parparentproc  as widget-handle no-undo .
        3   define input  parameter p-install      as logical   no-undo init no .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: allbccr.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/allbccr.p $":U .
        9   define variable vss-description as character no-undo init "Программа создания бар-кодов для всех партий свободной зоны товаров, которые продаются по партиям".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define  temp-table temp-host no-undo
       72     field host-code like ub.store.host-code
       73     index xpk host-code
       74   .
       75   define  temp-table temp-obj no-undo
       76     field obj-type  like ub.clients.obj-type
       77     field obj-code  like ub.clients.obj-code
       78     field host-code like ub.store.host-code
       79     field db-num    like ub.clients.db-num
       80     index xpk  obj-type obj-code
       81     index xie1 host-code
       82     index xie2 db-num host-code
       83   .
       84   procedure init-temphost:
       85     define buffer buf_store   for ub.store .
       86     define buffer buf_shop    for ub.shop .
       87     define buffer buf_clients for ub.clients .
       88     define buffer buf_db for ub.db .
       89     define buffer buf_temp-host for temp-host .
       90     define buffer buf_temp-obj for temp-obj .
       91     do
       92     on error undo, return error return-value
       93     :
       94       for each buf_store
       95       on error undo, return error
       96       :
       97         find first buf_temp-host
       98           where buf_temp-host.host-code = buf_store.host-code
       99           no-error .
      100         if not available buf_temp-host
      101         then do:
      102           create buf_temp-host .
      103           assign
      104             buf_temp-host.host-code = buf_store.host-code
      105           .
      106         end.
      107         find first buf_clients no-lock
      108           where buf_clients.obj-type = 'скл':U
      109             and buf_clients.obj-code = buf_store.obj-code
      110           no-error .
      111         if not available buf_clients
      112         then do:
      113           message
      114             "Ошибка при поиске клиента" skip
      115             "Клиент" 'скл':U buf_store.obj-code skip
      116             view-as alert-box error .
      117           undo, return error .
      118         end.
      119         create buf_temp-obj .
      120         assign
      121           buf_temp-obj.obj-type  = 'скл':U
      122           buf_temp-obj.obj-code  = buf_store.obj-code
      123           buf_temp-obj.host-code = buf_store.host-code
      124           buf_temp-obj.db-num    = buf_clients.db-num
      125         .
      126       end.
      127       for each buf_shop
      128       on error undo, return error
      129       :
      130         find first buf_temp-host
      131           where buf_temp-host.host-code = buf_shop.host-code
      132           no-error .
      133         if not available buf_temp-host
      134         then do:
      135           create buf_temp-host .
      136           assign
      137             buf_temp-host.host-code = buf_shop.host-code
      138           .
      139         end.
      140         find first buf_clients no-lock
      141           where buf_clients.obj-type = 'маг':U
      142             and buf_clients.obj-code = buf_shop.obj-code
      143           no-error .
      144         if not available buf_clients then do:
      145           message
      146             "Ошибка при поиске клиента" skip
      147             "Клиент" 'маг':U buf_shop.obj-code skip
      148             view-as alert-box error .
      149           undo, return error .
      150         end.
      151         create buf_temp-obj .
      152         assign
      153           buf_temp-obj.obj-type  = 'маг':U
      154           buf_temp-obj.obj-code  = buf_shop.obj-code
      155           buf_temp-obj.host-code = buf_shop.host-code
      156           buf_temp-obj.db-num    = buf_clients.db-num
      157         .
      158       end.
      159     end.
      160   end.
      161   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162   procedure cur-time :
      163      define output parameter p-today as date      no-undo .
      164      define output parameter p-time  as integer   no-undo .
      165     do
      166     on error undo, return error
      167     :
      168       define variable v-date1 as date      no-undo .
      169       define variable v-date2 as date      no-undo .
      170       define variable v-time  as integer   no-undo .
      171       assign
      172         v-date1 = today
      173         v-time  = time
      174         v-date2 = today
      175       .
      176       if v-date1 <> v-date2
      177       then do:
      178         assign
      179           v-date1 = today
      180           v-time  = v-time
      181         .
      182       end.
      183       assign
      184         p-today = v-date1
      185         p-time  = v-time
      186       .
      187     end.
      188   end.
      189   function cur-time-date returns character
      190   :
      191     return string(today, '99/99/9999':U) .
      192   end.
      193   function cur-time-mjd returns decimal
      194   :
      195     define variable v-date as date      no-undo .
      196     define variable v-time as integer   no-undo .
      197     run cur-time in this-procedure
      198       (output v-date
      199       ,output v-time
      200       ) .
      201     return integer(v-date) - 2400002 + (v-time / 86400) .
      202   end.
      203   function cur-time-get-ending-index returns integer
      204   (input p-number as integer
      205   )
      206   :
      207     if p-number < 0
      208     or p-number = ?
      209     then do:
      210       return 1 .
      211     end.
      212     define variable v-rest as integer   no-undo .
      213     assign
      214       p-number = p-number modulo 100
      215     .
      216     if p-number < 20
      217     then do:
      218       assign
      219         v-rest = p-number
      220       .
      221     end.
      222     else do:
      223       assign
      224         v-rest = p-number modulo 10
      225       .
      226     end.
      227     case v-rest :
      228       when 1
      229       then do:
      230         return 2 .
      231       end.
      232       when 2 or
      233       when 3 or
      234       when 4
      235       then do:
      236         return 3 .
      237       end.
      238       otherwise do:
      239         return 1 .
      240       end.
      241     end case .
      242   end.
      243   procedure cur-time-mjd-to-date :
      244      define input  parameter i-mjd-diff as decimal no-undo.
      245      define output parameter o-Date     as date    no-undo.
      246      define output parameter o-Time     as integer no-undo.
      247      define variable v-day-number as integer   no-undo .
      248      if    i-mjd-diff < 0
      249         or i-mjd-diff = ?
      250      then do:
      251         return "?" .
      252      end.
      253      assign
      254         v-day-number = truncate(i-mjd-diff,0).
      255         o-Date = date(v-day-number + 2400002).
      256         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      257     .
      258   end.
      259   function cur-time-mjd-to-string returns character
      260   (input p-mjd-diff as decimal
      261   )
      262   :
      263     define variable v-day-number as integer   no-undo .
      264     define variable v-seconds    as integer   no-undo .
      265     define variable v-hour       as integer   no-undo .
      266     define variable v-min        as integer   no-undo .
      267     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      268     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      269     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      270     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      271     if p-mjd-diff < 0
      272     or p-mjd-diff = ?
      273     then do:
      274       return "?" .
      275     end.
      276     assign
      277       v-day-number = integer(truncate(p-mjd-diff,0))
      278       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      279     .
      280     if v-seconds > 86400
      281     then do:
      282       assign
      283         v-seconds = 86400 - 1
      284       .
      285     end.
      286     if v-seconds < 0
      287     then do:
      288       assign
      289         v-seconds = 0
      290       .
      291     end.
      292     assign
      293       v-hour = truncate(v-seconds / 3600, 0)
      294     .
      295     assign
      296       v-seconds = v-seconds modulo 3600
      297     .
      298     assign
      299       v-min = truncate(v-seconds / 60, 0)
      300     .
      301     assign
      302       v-seconds = v-seconds modulo 60
      303     .
      304     return
      305         (if v-day-number <> 0
      306           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      307           else ""
      308         )
      309       + (if v-day-number <> 0 or v-hour <> 0
      310           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      311           else ""
      312         )
      313       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      314           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      315           else ""
      316         )
      317       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      318       .
      319   end.
      320   function cur-time-string returns character
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      329   end.
      330   function cur-time-string-sec returns character
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      339   end.
      340   function cur-time-custom  returns character
      341   (input p-prefix as character
      342   ,input p-date-format as character
      343   ,input p-delimiter as character
      344   ,input p-time-format as character
      345   ,input p-suffix as character
      346   )
      347   :
      348     define variable v-date as date      no-undo .
      349     define variable v-time as integer   no-undo .
      350     run cur-time in this-procedure
      351       (output v-date
      352       ,output v-time
      353       ) .
      354     return
      355       p-prefix
      356       + string(v-date, p-date-format)
      357       + p-delimiter
      358       + string(v-time, p-time-format)
      359       + p-suffix
      360       .
      361   end.
      362   function cur-time-print  returns character
      363   :
      364     define variable v-date as date      no-undo .
      365     define variable v-time as integer   no-undo .
      366     run cur-time in this-procedure
      367       (output v-date
      368       ,output v-time
      369       ) .
      370     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      371   end.
      372   function cur-time-datetime returns datetime
      373   :
      374     define variable v-char as character no-undo .
      375     define variable v-datetime as datetime no-undo .
      376     v-char = cur-time-string().
      377     v-datetime = datetime(v-char).
      378     return  v-datetime.
      379   end.
      380   function cur-time-string-msec returns character
      381   :
      382     define variable v-date as datetime  no-undo .
      383     v-date = now.
      384     return string(v-date) .
      385   end.
      386   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387     define variable v-cntxt-db-num        as integer   no-undo .
      388     define variable v-cntxt-userid        as character no-undo .
      389     define variable v-cntxt-level         as character no-undo .
      390     define variable v-cntxt-host-code-obj as integer   no-undo .
      391     define variable v-cntxt-obj-type      as character no-undo .
      392     define variable v-cntxt-obj-code      as integer   no-undo .
      393     define variable v-cntxt-db-num-obj    as integer   no-undo .
      394     define variable v-cntxt-is-admin      as logical   no-undo .
      395   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   define variable v-waitfram-action01         as character   no-undo .
      397   define variable v-waitfram-action02         as character   no-undo .
      398   define variable v-waitfram-action03         as character   no-undo .
      399   define variable mWaitFramTextBeg            as character   no-undo.
      400   define variable mWaitFramTextEnd            as character   no-undo.
      401   define variable mWaitFramView               as logical     no-undo.
      402   define variable mWaitProcEvent              as logical     no-undo init yes.
      403   define variable mWaitFramInterval           as integer     no-undo init 1 .
      404   define variable mWaitFramStop               as logical     no-undo.
      405   define variable mWaitFramStopUser           as logical     no-undo.
      406   define variable mWaitFramStopTimeOut        as logical     no-undo.
      407   define variable mWaitFramStartProc          as datetime-tz no-undo.
      408   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      409   define button B-WaitFramStop auto-end-key
      410        label "Стоп"
      411        size 10 by 1 tooltip "Остоновить процесс".
      412   define button B-viewProcInfo
      413        label "Информация"
      414        size 15 by 1 tooltip "Информация о процесс".
      415   define frame waitfram
      416     v-waitfram-action01 format "x(72)" no-label skip
      417     v-waitfram-action02 format "x(72)" no-label skip
      418     v-waitfram-action03 format "x(72)" no-label skip
      419     B-viewProcInfo
      420     B-WaitFramStop at row 4 col 30
      421     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      422     .
      423   define new global shared variable mBatchMode as logical no-undo init ?.
      424   define variable mFramBachModHandle as handle no-undo.
      425   mFramBachModHandle = frame waitfram:handle.
      426   define variable mFameOldVis as logical no-undo.
      427   define variable mVisCUrentVin as logical no-undo.
      428   if session:batch-mode
      429   then
      430      mBatchMode = yes.
      431   if mBatchMode = ? then do:
      432     mVisCUrentVin = current-window:visible.
      433     mFameOldVis = mFramBachModHandle:visible.
      434     mFramBachModHandle:visible  = yes.
      435     mBatchMode = mFramBachModHandle:visible ne yes.
      436     mFramBachModHandle:visible = mFameOldVis.
      437     current-window:visible = mVisCUrentVin.
      438   end.
      439    if  log-manager:logfile-name ne ?
      440     then DO:
      441         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      442         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      443         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      444     end.
      445   on choose of B-WaitFramStop in frame waitfram
      446   do:
      447     mWaitFramStop = yes.
      448     mWaitFramStopUser = yes.
      449   end.
      450   function waitfram-check-timeout returns logical():
      451      define variable vtime as int64 no-undo.
      452      if mWaitFramStopTimeOut
      453      then
      454         return yes.
      455      vtime = ( now - mWaitFramStartProc ) / 1000 .
      456      if     mWaitFramTimeOut ne ?
      457         and mWaitFramTimeOut ne 0
      458         and mWaitFramTimeOut lt vtime
      459      then do:
      460         mWaitFramStopTimeOut = yes.
      461      end.
      462      return mWaitFramStopTimeOut.
      463   end.
      464   procedure waitfram-hide :
      465     if not session:batch-mode
      466     then do
      467     on error undo, return error return-value
      468     :
      469       pause 0 before-hide .
      470       if not mBatchMode then
      471         hide frame waitfram .
      472     if     not mWaitFramView
      473        and mWaitProcEvent
      474     then
      475       process events .
      476     end.
      477   end procedure.
      478   procedure waitfram-show :
      479     define input  parameter p-message as character no-undo .
      480     define variable v-left-margin as integer   no-undo .
      481     if not session:batch-mode
      482     then do
      483     on error undo, return error return-value
      484     :
      485       if length(p-message) <= 70 then do:
      486         assign
      487           v-left-margin = integer((70 - length(p-message)) / 2)
      488         .
      489         assign
      490           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      491         .
      492         assign
      493           v-waitfram-action01 = " "
      494           v-waitfram-action02 = " "
      495                                    + fill(" ", v-left-margin)
      496                                    + p-message
      497           v-waitfram-action03 = " "
      498         .
      499       end.
      500       else do:
      501         define variable vRindex1 as integer no-undo.
      502         define variable vRindex2 as integer no-undo.
      503         vRindex1 = r-index(p-message," ",70).
      504         if vRindex1 = 0
      505         then
      506            vRindex1 = 70.
      507         if length(p-message)  <= vRindex1 + 70 then do:
      508           assign
      509             v-waitfram-action01 = " "
      510             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      511             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      512           .
      513         end.
      514         else do:
      515           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      516           if vRindex2 <= vRindex1
      517           then
      518              vRindex2 = vRindex1 + 70.
      519           assign
      520             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      521             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      522             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      523           .
      524         end.
      525       end.
      526       B-viewProcInfo:visible   in frame waitfram = no.
      527       B-viewProcInfo:sensitive in frame waitfram = no.
      528       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      529       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      530       if  (   mWaitFramView
      531          or  mWaitProcEvent)
      532          and not mBatchMode
      533       then
      534          display
      535             v-waitfram-action01 skip
      536             v-waitfram-action02 skip
      537             v-waitfram-action03 skip
      538          with frame waitfram .
      539       if     mWaitFramView
      540          then do:
      541             if     mWaitFramInterval ne ?
      542                and not mBatchMode
      543             then
      544                wait-for go of frame waitfram pause mWaitFramInterval.
      545          end.
      546          else
      547             if     mWaitProcEvent
      548                and not mBatchMode
      549             then
      550                process events .
      551     end.
      552   end procedure.
      553      procedure waitfram-show-this:
      554         define input  parameter iInterval as int64 no-undo.
      555         define variable vtime as int64 no-undo.
      556         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      557         mWaitFramInterval = iInterval.
      558         run waitfram-show (substitute("&1&2 &3&4" ,
      559                                       mWaitFramTextBeg ,
      560                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      561                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      562                                       mWaitFramTextEnd
      563                                      )
      564                           ).
      565      end.
      566      procedure WaitFramRunPause:
      567         define input  parameter iInterval as dec no-undo.
      568         define variable vStart  as datetime-tz no-undo.
      569         define variable vend    as datetime-tz no-undo.
      570         define variable vint as int64 no-undo.
      571         define variable vOk as logical no-undo.
      572         vStart = now.
      573         vend   = vStart.
      574         publish "WaitFramPause" (iInterval,output vOk).
      575         vend   =  now.
      576         vint = vend - vStart.
      577         vint = iInterval - vint / 1000.
      578         if     not mWaitFramStop
      579            and (   vint > 0
      580                 or (    not vOk
      581                     and iInterval eq ?
      582                     )
      583                 )
      584         then
      585            run waitfram-show-this (iInterval).
      586         vend   =  now.
      587         vint = vend - vStart.
      588         vint = iInterval - vint / 1000.
      589         if     not mWaitFramStop
      590            and vint > 0
      591         then do:
      592            run gbl/pause.p (vint * 1000).
      593         end.
      594         if iInterval ne ?
      595         then
      596            publish "WaitFramStop".
      597         waitfram-check-timeout().
      598      end.
      599      procedure WaitFramWaitFor:
      600         define input  parameter iInterval as dec no-undo.
      601         assign
      602            mWaitFramStartProc   = now
      603            mWaitFramStopUser    = no
      604            mWaitFramStopTimeOut = no
      605         .
      606         block-wait:
      607         do while not mWaitFramStop:
      608            run WaitFramRunPause (iInterval).
      609            if  waitfram-check-timeout()
      610            then do:
      611               leave block-wait.
      612            end.
      613         end.
      614         run waitfram-hide.
      615      end.
      616   procedure waitfram-join :
      617     define input  parameter p-line-1  as character no-undo .
      618     define input  parameter p-line-2  as character no-undo .
      619     define input  parameter p-line-3  as character no-undo .
      620     define output parameter p-message as character no-undo .
      621     do
      622     on error undo, return error return-value
      623     :
      624       assign
      625         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      626                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      627                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      628       .
      629     end.
      630   end procedure.
      631   function waitfram-join-function returns character
      632     (input p-line-1 as character
      633     ,input p-line-2 as character
      634     ,input p-line-3 as character
      635     ).
      636     define variable v-message as character no-undo .
      637     run waitfram-join in this-procedure
      638       (input  p-line-1
      639       ,input  p-line-2
      640       ,input  p-line-3
      641       ,output v-message
      642       ) .
      643     return v-message .
      644   end function .
      645   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      646   define temp-table userobjs_temp-user-obj no-undo
      647     field obj-type as character
      648     field obj-code as integer
      649     index xpk is primary unique obj-type obj-code
      650     .
      651   procedure userobjs_clear :
      652     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      653     do
      654     on error undo, return error return-value
      655     :
      656       for each buf_userobjs_temp-user-obj
      657       on error undo, return error return-value
      658       :
      659         delete buf_userobjs_temp-user-obj .
      660       end.
      661     end.
      662   end .
      663   procedure userobjs_object-count :
      664     define output parameter p-total-count as integer   no-undo .
      665     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      666     do
      667     on error undo, return error return-value
      668     :
      669       assign
      670         p-total-count = 0
      671       .
      672       for each buf_userobjs_temp-user-obj
      673       on error undo, return error return-value
      674       :
      675         assign
      676           p-total-count = p-total-count + 1
      677         .
      678       end.
      679     end.
      680   end.
      681   procedure userobjs_append :
      682      define input  parameter p-obj-type as character no-undo .
      683      define input  parameter p-obj-code as integer   no-undo .
      684     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      685     do
      686     on error undo, return error return-value
      687     :
      688       find first buf_userobjs_temp-user-obj
      689         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      690           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      691         no-error .
      692       if not available buf_userobjs_temp-user-obj
      693       then do:
      694         create buf_userobjs_temp-user-obj .
      695         assign
      696           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      697           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      698         .
      699       end.
      700     end.
      701   end.
      702   procedure userobjs_object-exist :
      703     define output parameter p-object-exist as logical   no-undo .
      704     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      705     do
      706     on error undo, return error return-value
      707     :
      708       find first buf_userobjs_temp-user-obj
      709         no-error .
      710       if not available buf_userobjs_temp-user-obj
      711       then do:
      712         assign
      713           p-object-exist = false
      714         .
      715       end.
      716       else do:
      717         assign
      718           p-object-exist = true
      719         .
      720       end.
      721     end.
      722   end.
      723   procedure userobjs_transfer :
      724     define input  parameter p-callback-handle as handle no-undo .
      725     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      726     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      727     do
      728     on error undo, return error return-value
      729     :
      730       if valid-handle(p-callback-handle) <> true
      731       then do:
      732         message
      733           vss-workfile vss-revision vss-description skip
      734           "Ошибка задания входных параметров" skip
      735           "Неизвестный указатель на процедуру" skip
      736           view-as alert-box error .
      737         undo, return error return-value .
      738       end.
      739       if p-callback-handle :get-signature("userobjs_append") = ""
      740       then do:
      741         message
      742           vss-workfile vss-revision vss-description skip
      743           "Ошибка задания входных параметров" skip
      744           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      745                     ,p-callback-handle :file-name
      746                     ) skip
      747           view-as alert-box error .
      748         undo, return error return-value .
      749       end.
      750       for each buf_userobjs_temp-user-obj
      751       on error undo, return error return-value
      752       :
      753         run userobjs_append in p-callback-handle
      754           (input  buf_userobjs_temp-user-obj.obj-type
      755           ,input  buf_userobjs_temp-user-obj.obj-code
      756           ) .
      757       end.
      758     end.
      759   end procedure.
      760   procedure userobjs_select-one :
      761      define input  parameter parparentproc     as widget-handle no-undo .
      762      define input  parameter p-db-num          as integer   no-undo .
      763      define input  parameter p-user-id         as character no-undo .
      764      define input  parameter p-host-code-obj   as integer   no-undo .
      765      define input  parameter p-obj-type        as character no-undo .
      766      define input  parameter p-obj-code        as integer   no-undo .
      767      define output parameter p-user-select     as logical   no-undo .
      768      define output parameter p-select-obj-type as character no-undo .
      769      define output parameter p-select-obj-code as character no-undo .
      770     do
      771     on error undo, return error return-value
      772     :
      773       run gbl/userobjs.w
      774         (input  parparentproc
      775         ,input  this-procedure :handle
      776         ,input  p-db-num
      777         ,input  p-user-id
      778         ,input  p-host-code-obj
      779         ,input  p-obj-type
      780         ,input  p-obj-code
      781         ,INPUT  "b-sel"
      782         ,output p-user-select
      783         ,output p-select-obj-type
      784         ,output p-select-obj-code
      785         ) .
      786     end.
      787   end.
      788   procedure userobjs_select-many :
      789     define input  parameter parparentproc   as widget-handle no-undo .
      790     define input  parameter p-db-num        as integer   no-undo .
      791     define input  parameter p-user-id       as character no-undo .
      792     define input  parameter p-host-code-obj as integer   no-undo .
      793     define input  parameter p-obj-type      as character no-undo .
      794     define input  parameter p-obj-code      as integer   no-undo .
      795     define output parameter p-user-select   as logical   no-undo .
      796     define variable v-select-obj-type as character no-undo .
      797     define variable v-select-obj-code as integer   no-undo .
      798     do
      799     on error undo, return error return-value
      800     :
      801       run gbl/userobjs.w
      802         (input  parparentproc
      803         ,input  this-procedure :handle
      804         ,input  p-db-num
      805         ,input  p-user-id
      806         ,input  p-host-code-obj
      807         ,input  p-obj-type
      808         ,input  p-obj-code
      809         ,INPUT  "b-sel,b-mark"
      810         ,output p-user-select
      811         ,output v-select-obj-type
      812         ,output v-select-obj-code
      813         ) .
      814     end.
      815   end.
      816   procedure thobjs :
      817      define input        parameter parparentproc     as widget-handle no-undo .
      818      define input        parameter i-bttns           as character     no-undo .
      819      define input        parameter i-list-mode       as character     no-undo.
      820      define input        parameter i-obj-type        as character     no-undo.
      821      define input        parameter i-db-num          as integer       no-undo.
      822      define input        parameter i-host-code       as integer       no-undo.
      823      define input-output parameter p-rid-list        as character     no-undo .
      824   run ref/thobjs.p
      825           ( input parparentproc
      826            ,input  this-procedure :handle
      827           , input i-bttns
      828           , input i-list-mode
      829           , input i-obj-type
      830           , input i-db-num
      831           , input i-host-code
      832           , input-output p-rid-list ) no-error .
      833   end.
      834   run init-temphost .
      835   define variable v-num as integer no-undo .
      836   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      837     run mainmenu_getcntxt in parparentproc
      838       (output v-cntxt-db-num
      839       ,output v-cntxt-userid
      840       ,output v-cntxt-level
      841       ,output v-cntxt-host-code-obj
      842       ,output v-cntxt-obj-type
      843       ,output v-cntxt-obj-code
      844       ,output v-cntxt-db-num-obj
      845       ,output v-cntxt-is-admin
      846       ) .
      847   if p-install
      848   then do:
      849     assign
      850       v-num = 1
      851     .
      852   end.
      853   else do:
      854     run gbl/d-askw.w
      855       (input "Вопрос"
      856       ,input "Создание бар-кодов для партий товаров," + chr(10)
      857         + "Которые продаются по партиям"
      858       ,input "|^"
      859       ,input "Все объекты^confirm|Выбрать объекты|Отмена"
      860       ,input "|"
      861           + "|"
      862           + ""
      863       ,input 1
      864       ,input 3
      865       ,output v-num
      866       ).
      867   end.
      868   case v-num :
      869     when 1
      870     then do:
      871       for each temp-obj
      872       :
      873         run process-object in this-procedure
      874           (input temp-obj.obj-type
      875           ,input temp-obj.obj-code
      876           ).
      877       end.
      878     end.
      879     when 2
      880     then do:
      881       define variable v-user-select as logical   no-undo .
      882   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      883   run userobjs_select-many in this-procedure
      884     (input  parparentproc
      885     ,input  v-cntxt-db-num
      886     ,input  v-cntxt-userid
      887     ,input  v-cntxt-host-code-obj
      888     ,input  v-cntxt-obj-type
      889     ,input  v-cntxt-obj-code
      890     ,output v-user-select
      891     )  .
      892       if v-user-select <> true
      893       then do:
      894         message
      895           "Объекты не выбраны"
      896           view-as alert-box information .
      897         return .
      898       end.
      899       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      900       for each buf_userobjs_temp-user-obj
      901       on error undo, return error return-value
      902       :
      903         run process-object in this-procedure
      904           (input buf_userobjs_temp-user-obj.obj-type
      905           ,input buf_userobjs_temp-user-obj.obj-code
      906           ).
      907       end.
      908     end.
      909     when 3
      910     then do:
      911       return .
      912     end.
      913   end case .
      914   if p-install = false
      915   then do:
      916     message
      917       "Создание бар-кодов партий закончено" skip
      918       view-as alert-box information .
      919   end.
      920   return .
      921   procedure process-object :
      922     define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
      923     define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
      924     define variable v-today as date      no-undo.
      925     define variable v-time  as integer   no-undo.
      926     output to allbccr.txt append .
      927     run cur-time in this-procedure ( output v-today
      928                                    , output v-time
      929                                    ).
      930     export
      931       string(v-today, "99/99/9999":u)  string(v-time, "hh:mm":u ) skip
      932       p-obj-type skip
      933       p-obj-code skip
      934       .
      935     output close .
      936     if p-install = false
      937     then do:
      938       run waitfram-show in this-procedure
      939         (input "Объект " + string(p-obj-type) + " " + string(p-obj-code)
      940         ).
      941     end.
      942     define variable v-ind as integer   no-undo .
      943     for each ub.gds-obj no-lock
      944       where ub.gds-obj.obj-type = p-obj-type
      945         and ub.gds-obj.obj-code = p-obj-code
      946     :
      947       if p-install = false
      948       then do:
      949         assign
      950           v-ind = v-ind + 1
      951         .
      952         if v-ind modulo 10 = 0
      953         then do:
      954           run waitfram-show in this-procedure
      955             (input "Объект " + string(p-obj-type) + " " + string(p-obj-code) + ". "
      956             + "Обработано " + string(v-ind) + ". "
      957             ).
      958         end.
      959       end.
      960       if ub.gds-obj.cash-parts = true
      961       then do:
      962         run str/gdsbccr.p
      963           (input gds-obj.obj-type
      964           ,input gds-obj.obj-code
      965           ,input gds-obj.artic
      966           ,input gds-obj.prod-type
      967           ,input gds-obj.prod-code
      968           ).
      969       end.
      970     end.
      971     if p-install = false
      972     then do:
      973       run waitfram-hide in this-procedure .
      974     end.
      975   end procedure.
