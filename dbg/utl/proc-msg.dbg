        1   block-level on error undo, throw.
        2   define input parameter p-msg as character no-undo.
        3   def var v-file-name as character no-undo.
        4   def var v-full-proc-name as character no-undo.
        5   def stream sBat.
        6   v-full-proc-name = search ("exe/msg.exe").
        7   if search (v-full-proc-name) <> ? then do:
        8      if num-entries(p-msg,"~n") > 1 then
        9      do:
       10        run sendMultilineMessage in this-procedure.
       11      end.
       12      else
       13      do:
       14             os-command no-wait value (search ("exe/msg.exe") + " *  /TIME:0" +  p-msg).
       15       end.
       16   end.
       17   else do:
       18   v-file-name = string (guid(generate-uuid)) + ".txt".
       19   output to value (v-file-name).
       20   export p-msg.
       21   output close.
       22   file-info:file-name = (v-file-name).
       23   if search ("utl/w-msg.r") <> ?
       24   then do:
       25     v-full-proc-name = search ("utl/w-msg.r").
       26   end.
       27   else do:
       28     v-full-proc-name = search ("utl/w-msg.w").
       29   end.
       30   if v-full-proc-name = ?
       31   then do:
       32     message "Файл не найден - utl/w-msg.w" view-as alert-box.
       33   end.
       34   os-command no-wait value (search ("bin/prowin32.exe") + " -p " + v-full-proc-name + ' -param "FullFileName?' + file-info:full-pathname + '"').
       35   end.
       36   procedure sendMultilineMessage:
       37      define variable vCount as integer no-undo.
       38      define variable vNumberMsg as integer no-undo.
       39      define variable vPos   as integer no-undo.
       40      define variable vMsg   as character no-undo.
       41      define variable vBatFile as character no-undo.
       42      assign
       43        vMsg = p-msg
       44        vNumberMsg = 1
       45      .
       46      do while num-entries(vMsg,"~n") > 20:
       47         do vCount = 1 to 20:
       48            vPos = index(vMsg, "~n", vPos + 1).
       49            if vPos = length(vMsg) then leave.
       50         end.
       51         run runBatFile in this-procedure (substring(vMsg, 1, vPos - 1), vNumberMsg).
       52         assign
       53           vNumberMsg = vNumberMsg + 1
       54           vMsg = substring(vMsg,vPos + 1)
       55           vPos = 0
       56         .
       57      end.
       58      run runBatFile in this-procedure (vMsg, vNumberMsg).
       59   end procedure.
       60   procedure runBatFile:
       61      define input parameter iMsg as character no-undo.
       62      define input parameter iNumber as integer no-undo.
       63      define variable vBatFile     as character no-undo.
       64      define variable vBatFileFull as character no-undo.
       65      define variable vCount   as integer   no-undo.
       66      vBatFile = substitute("orderstat&1.bat", iNumber).
       67      output stream sBat to value (vBatFile).
       68      put stream sBat unformatted "(".
       69      do vCount = 1 to num-entries(iMsg, "~n"):
       70         if entry(vCount, iMsg, "~n") <> "" then
       71           put stream sBat unformatted
       72             " echo " entry(vCount, iMsg, "~n").
       73         if vCount <> num-entries(iMsg, "~n") and
       74            entry(vCount + 1, iMsg, "~n") <> "" then
       75           put stream sBat unformatted "&".
       76      end.
       77      put stream sBat unformatted
       78        ")|" v-full-proc-name " * /TIME:0"
       79      .
       80      output stream sBat close.
       81      vBatFileFull = search(vBatFile).
       82      if vBatFileFull <> ? then
       83      do:
       84        os-command no-wait value (vBatFileFull).
       85      end.
       86   end procedure.
