        1   block-level on error undo, throw.
        2   define input parameter p-install as logical no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: frcnwpbd.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/frcnwpbd.p $":U .
        8   define variable vss-description as character no-undo init "Форсированная передача prod-bc-db".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   procedure scl-attr-code :
      305     do
      306     on error undo, return error
      307     :
      308       define input  parameter p-code           as character no-undo .
      309       define output parameter p-type           as character no-undo .
      310       define output parameter p-format         as character no-undo .
      311       define output parameter p-label          as character no-undo .
      312       define output parameter p-user-can-edit  as logical   no-undo .
      313       define output parameter p-output-display as logical   no-undo .
      314       define output parameter p-other          as character no-undo .
      315       case p-code :
      316               when 'tare-weight':U then do:     assign     p-label = "Веса и коды тары"     p-type = 'C':U      p-format = "X(32)"     p-label = "Веса и коды тары"     p-user-can-edit  = yes     p-output-display = true     p-other = 'scl=TIGER,MIRA,TIGER2,TIGER-SPCT2/spr=scl-attr-tare-weight':u      .   end.
      317         otherwise do:
      318           undo, return error "неизвестный атрибут весов" + " " + p-code .
      319         end.
      320       end.
      321     end.
      322   end procedure.
      323   procedure scl-attr-tooltip :
      324     do
      325     on error undo, return error
      326     :
      327       define input  parameter p-code    as character no-undo .
      328       define output parameter p-tooltip as character no-undo .
      329       define output parameter p-label   as character no-undo .
      330       case p-code :
      331               when 'tare-weight':U then do:     assign     p-tooltip = "Веса и коды тары"     p-label = "Веса и коды тары" .   end.
      332         otherwise do:
      333           undo, return error "неизвестный атрибут весов" + " " + p-code .
      334         end.
      335       end.
      336     end.
      337   end procedure.
      338   procedure scl-attr-value :
      339     do
      340     on error undo, return error
      341     :
      342       define input  parameter p-db-num   like ub.scales-attr.db-num        no-undo .
      343       define input  parameter p-scales-num like ub.scales-attr.scales-num      no-undo .
      344       define input  parameter p-code     like ub.scales-attr.attr-code      no-undo .
      345       define output parameter p-value    like ub.scales-attr.attr-value    no-undo .
      346       define output parameter p-type     as character no-undo .
      347       define buffer buf_scales-attr for ub.scales-attr .
      348       define variable v-format         as character no-undo .
      349       define variable v-label          as character no-undo .
      350       define variable v-user-can-edit  as logical   no-undo .
      351       define variable v-output-display as logical   no-undo .
      352       define variable v-other          as character no-undo .
      353       run scl-attr-code in this-procedure
      354         (input  p-code
      355         ,output p-type
      356         ,output v-format
      357         ,output v-label
      358         ,output v-user-can-edit
      359         ,output v-output-display
      360         ,output v-other
      361         ) no-error .
      362       if error-status :error then do:
      363         undo, return error return-value .
      364       end.
      365       find first buf_scales-attr no-lock
      366         where buf_scales-attr.db-num    = p-db-num
      367           and buf_scales-attr.scales-num  = p-scales-num
      368           and buf_scales-attr.attr-code = p-code
      369         no-error .
      370       if avail buf_scales-attr then do:
      371         assign
      372           p-value =  buf_scales-attr.attr-value
      373         .
      374       end.
      375       else do:
      376         assign
      377           p-value = if p-type = 'L':U then "no":U else ""
      378         .
      379       end.
      380     end.
      381   end procedure.
      382   procedure scl-attr-write :
      383     do
      384     on error undo, return error
      385     :
      386       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      387       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      388       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      389       define input parameter p-value    like ub.scales-attr.attr-value no-undo .
      390       define buffer buf_scales-attr for ub.scales-attr .
      391       define variable v-type           as character no-undo .
      392       define variable v-format         as character no-undo .
      393       define variable v-label          as character no-undo .
      394       define variable v-user-can-edit  as logical   no-undo .
      395       define variable v-output-display as logical   no-undo .
      396       define variable v-other          as character no-undo .
      397       run scl-attr-code in this-procedure
      398         (input  p-code
      399         ,output v-type
      400         ,output v-format
      401         ,output v-label
      402         ,output v-user-can-edit
      403         ,output v-output-display
      404         ,output v-other
      405         ) no-error .
      406       if error-status :error then do:
      407         undo, return error return-value .
      408       end.
      409       find first buf_scales-attr exclusive-lock
      410         where buf_scales-attr.db-num  = p-db-num
      411           and buf_scales-attr.scales-num  = p-scales-num
      412           and buf_scales-attr.attr-code = p-code
      413         no-error .
      414       if not available buf_scales-attr then do:
      415         create buf_scales-attr .
      416         assign
      417           buf_scales-attr.db-num    = p-db-num
      418           buf_scales-attr.scales-num  = p-scales-num
      419           buf_scales-attr.attr-code = p-code
      420         .
      421       end.
      422       assign
      423         buf_scales-attr.attr-value = p-value
      424       .
      425       release buf_scales-attr no-error .
      426       if error-status:error then do:
      427         undo, return error return-value .
      428       end.
      429     end.
      430   end procedure.
      431   procedure scl-attr-exist :
      432     do
      433     on error undo, return error
      434     :
      435       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      436       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      437       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      438       define output parameter p-exist   as logical  no-undo .
      439       define buffer buf_scales-attr for ub.scales-attr .
      440       define variable v-type           as character no-undo .
      441       define variable v-format         as character no-undo .
      442       define variable v-label          as character no-undo .
      443       define variable v-user-can-edit  as logical   no-undo .
      444       define variable v-output-display as logical   no-undo .
      445       define variable v-other          as character no-undo .
      446       run scl-attr-code in this-procedure
      447         (input  p-code
      448         ,output v-type
      449         ,output v-format
      450         ,output v-label
      451         ,output v-user-can-edit
      452         ,output v-output-display
      453         ,output v-other
      454         ) no-error .
      455       if error-status :error then do:
      456         undo, return error return-value .
      457       end.
      458       find first buf_scales-attr exclusive-lock
      459         where buf_scales-attr.db-num  = p-db-num
      460           and buf_scales-attr.scales-num  = p-scales-num
      461           and buf_scales-attr.attr-code = p-code
      462         no-error .
      463       if  available buf_scales-attr then do:
      464         p-exist = yes.
      465       end.
      466     end.
      467   end procedure.
      468   procedure scl-attr-delete :
      469     do
      470     on error undo, return error
      471     :
      472       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      473       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      474       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      475       define output parameter p-deleted  as logical no-undo.
      476       define buffer buf_scales-attr for ub.scales-attr .
      477       define variable v-type           as character no-undo .
      478       define variable v-format         as character no-undo .
      479       define variable v-label          as character no-undo .
      480       define variable v-user-can-edit  as logical   no-undo .
      481       define variable v-output-display as logical   no-undo .
      482       define variable v-other          as character no-undo .
      483       run scl-attr-code in this-procedure
      484         (input  p-code
      485         ,output v-type
      486         ,output v-format
      487         ,output v-label
      488         ,output v-user-can-edit
      489         ,output v-output-display
      490         ,output v-other
      491         ) no-error .
      492       if error-status :error then do:
      493         undo, return error return-value .
      494       end.
      495       find first buf_scales-attr exclusive-lock
      496         where buf_scales-attr.db-num  = p-db-num
      497           and buf_scales-attr.scales-num  = p-scales-num
      498           and buf_scales-attr.attr-code = p-code
      499         no-error NO-WAIT.
      500       if not available buf_scales-attr then do:
      501         p-deleted = no.
      502       end.
      503       else do:
      504         delete buf_scales-attr no-error .
      505         if error-status:error then do:
      506           undo, return error return-value .
      507         end.
      508         p-deleted = yes.
      509       end.
      510     end.
      511   end procedure.
      512   procedure scl-attr-news :
      513     do
      514     on error undo, return error
      515     :
      516       define input  parameter p-code           as character no-undo .
      517       define output parameter p-news           as logical   no-undo .
      518       case p-code :
      519               when 'tare-weight':U then do:     assign     p-news = yes.   end.
      520         otherwise do:
      521           p-news = no.
      522         end.
      523       end.
      524     end.
      525   end procedure.
      526   procedure scl-attr-hist :
      527     do
      528     on error undo, return error
      529     :
      530       define input  parameter p-code           as character no-undo .
      531       define output parameter p-hist           as logical   no-undo .
      532       case p-code :
      533               when 'tare-weight':U then do:     assign     p-hist = yes.   end.
      534         otherwise do:
      535           p-hist = no.
      536         end.
      537       end.
      538     end.
      539   end procedure.
      540   define variable p-news as logical no-undo .
      541   if not p-install then do:
      542     message vss-workfile vss-revision vss-description skip
      543     "Вы уверены, что хотите запустить пересылку prod-bc-db по новостям"
      544     view-as alert-box question buttons yes-no update loc#log as logical  .
      545     if not loc#log then return.
      546   end.
      547   main-block:
      548   do on error undo, return error
      549   :
      550     for each ub.prod-bc-db no-lock
      551     where ub.prod-bc-db.db-num = g#db-num
      552     on error undo, return error
      553     :
      554       run str/callnews.p
      555         (input "prod-bc-db"
      556         ,input (buffer ub.prod-bc-db:handle)
      557         ) no-error .
      558       if error-status:error then do:
      559         undo main-block,  return error return-value .
      560       end.
      561     end.
      562   end.
      563   if not p-install then do:
      564     message
      565     "Завершилась утилита пересылки prod-bc-db по новостям"
      566     view-as alert-box .
      567   end.
