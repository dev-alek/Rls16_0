      309   procedure cur-time :
      310      define output parameter p-today as date      no-undo .
      311      define output parameter p-time  as integer   no-undo .
      312     do
      313     on error undo, return error
      314     :
      315       define variable v-date1 as date      no-undo .
      316       define variable v-date2 as date      no-undo .
      317       define variable v-time  as integer   no-undo .
      318       assign
      319         v-date1 = today
      320         v-time  = time
      321         v-date2 = today
      322       .
      323       if v-date1 <> v-date2
      324       then do:
      325         assign
      326           v-date1 = today
      327           v-time  = v-time
      328         .
      329       end.
      330       assign
      331         p-today = v-date1
      332         p-time  = v-time
      333       .
      334     end.
      335   end.
      336   function cur-time-date returns character
      337   :
      338     return string(today, '99/99/9999':U) .
      339   end.
      340   function cur-time-mjd returns decimal
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return integer(v-date) - 2400002 + (v-time / 86400) .
      349   end.
      350   function cur-time-get-ending-index returns integer
      351   (input p-number as integer
      352   )
      353   :
      354     if p-number < 0
      355     or p-number = ?
      356     then do:
      357       return 1 .
      358     end.
      359     define variable v-rest as integer   no-undo .
      360     assign
      361       p-number = p-number modulo 100
      362     .
      363     if p-number < 20
      364     then do:
      365       assign
      366         v-rest = p-number
      367       .
      368     end.
      369     else do:
      370       assign
      371         v-rest = p-number modulo 10
      372       .
      373     end.
      374     case v-rest :
      375       when 1
      376       then do:
      377         return 2 .
      378       end.
      379       when 2 or
      380       when 3 or
      381       when 4
      382       then do:
      383         return 3 .
      384       end.
      385       otherwise do:
      386         return 1 .
      387       end.
      388     end case .
      389   end.
      390   procedure cur-time-mjd-to-date :
      391      define input  parameter i-mjd-diff as decimal no-undo.
      392      define output parameter o-Date     as date    no-undo.
      393      define output parameter o-Time     as integer no-undo.
      394      define variable v-day-number as integer   no-undo .
      395      if    i-mjd-diff < 0
      396         or i-mjd-diff = ?
      397      then do:
      398         return "?" .
      399      end.
      400      assign
      401         v-day-number = truncate(i-mjd-diff,0).
      402         o-Date = date(v-day-number + 2400002).
      403         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      404     .
      405   end.
      406   function cur-time-mjd-to-string returns character
      407   (input p-mjd-diff as decimal
      408   )
      409   :
      410     define variable v-day-number as integer   no-undo .
      411     define variable v-seconds    as integer   no-undo .
      412     define variable v-hour       as integer   no-undo .
      413     define variable v-min        as integer   no-undo .
      414     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      415     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      416     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      417     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      418     if p-mjd-diff < 0
      419     or p-mjd-diff = ?
      420     then do:
      421       return "?" .
      422     end.
      423     assign
      424       v-day-number = integer(truncate(p-mjd-diff,0))
      425       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      426     .
      427     if v-seconds > 86400
      428     then do:
      429       assign
      430         v-seconds = 86400 - 1
      431       .
      432     end.
      433     if v-seconds < 0
      434     then do:
      435       assign
      436         v-seconds = 0
      437       .
      438     end.
      439     assign
      440       v-hour = truncate(v-seconds / 3600, 0)
      441     .
      442     assign
      443       v-seconds = v-seconds modulo 3600
      444     .
      445     assign
      446       v-min = truncate(v-seconds / 60, 0)
      447     .
      448     assign
      449       v-seconds = v-seconds modulo 60
      450     .
      451     return
      452         (if v-day-number <> 0
      453           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      454           else ""
      455         )
      456       + (if v-day-number <> 0 or v-hour <> 0
      457           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      458           else ""
      459         )
      460       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      461           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      462           else ""
      463         )
      464       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      465       .
      466   end.
      467   function cur-time-string returns character
      468   :
      469     define variable v-date as date      no-undo .
      470     define variable v-time as integer   no-undo .
      471     run cur-time in this-procedure
      472       (output v-date
      473       ,output v-time
      474       ) .
      475     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      476   end.
      477   function cur-time-string-sec returns character
      478   :
      479     define variable v-date as date      no-undo .
      480     define variable v-time as integer   no-undo .
      481     run cur-time in this-procedure
      482       (output v-date
      483       ,output v-time
      484       ) .
      485     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      486   end.
      487   function cur-time-custom  returns character
      488   (input p-prefix as character
      489   ,input p-date-format as character
      490   ,input p-delimiter as character
      491   ,input p-time-format as character
      492   ,input p-suffix as character
      493   )
      494   :
      495     define variable v-date as date      no-undo .
      496     define variable v-time as integer   no-undo .
      497     run cur-time in this-procedure
      498       (output v-date
      499       ,output v-time
      500       ) .
      501     return
      502       p-prefix
      503       + string(v-date, p-date-format)
      504       + p-delimiter
      505       + string(v-time, p-time-format)
      506       + p-suffix
      507       .
      508   end.
      509   function cur-time-print  returns character
      510   :
      511     define variable v-date as date      no-undo .
      512     define variable v-time as integer   no-undo .
      513     run cur-time in this-procedure
      514       (output v-date
      515       ,output v-time
      516       ) .
      517     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      518   end.
      519   function cur-time-datetime returns datetime
      520   :
      521     define variable v-char as character no-undo .
      522     define variable v-datetime as datetime no-undo .
      523     v-char = cur-time-string().
      524     v-datetime = datetime(v-char).
      525     return  v-datetime.
      526   end.
      527   function cur-time-string-msec returns character
      528   :
      529     define variable v-date as datetime  no-undo .
      530     v-date = now.
      531     return string(v-date) .
      532   end.
      533   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      534   define new global shared variable g#lib-nws as handle no-undo .
      535   define variable v-value-character   as character no-undo .
      536   define variable v-value-decimal     as decimal   no-undo .
      537   define variable v-value-integer     as integer   no-undo .
      538   define variable v-value-logical     as logical   no-undo .
      539   define variable v-value-type        as character no-undo .
      540   define variable v-value-date        as date      no-undo .
      541   define variable v-ext-sys           as integer   no-undo .
      542   define variable v-recid as recid no-undo .
      543   define variable v-recid-list as longchar no-undo .
      544   define variable v-prod  as character no-undo .
      545   define stream str-ext .
      546   define temp-table tt-ext-classif like ub.ext-classif .
      547   run adm/shattri.p (
      548          input "get":U
      549         ,input '':U
      550         ,input 0
      551         ,input 'egais':U
      552         ,input 'egais-exsys':U
      553         ,output v-value-character
      554         ,output v-value-date
      555         ,output v-value-decimal
      556         ,output v-value-integer
      557         ,output v-value-logical
      558         ,output v-value-type
      559         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      560         ) no-error .
      561   assign v-ext-sys = v-value-integer .
      562   output stream str-ext to value ("ext-classif_egais_backup_.d") append .
      563   put stream str-ext unformatted "Начало выгрузки - " string(today) + "   " + string(time, "hh:mm:ss") skip .
      564   for each  ext-classif exclusive-lock
      565       where ext-classif.classif-subject = 'goods'
      566         and ext-classif.classif-name = 'exp-esys-gds-code'
      567         and ext-classif.db-num = 0
      568         and ext-classif.key#_two = v-ext-sys
      569         and ext-classif.charkey_two <> ""
      570         and ext-classif.charkey_three <> "" :
      571       export stream str-ext delimiter ';' ext-classif .
      572       find first ext-classif-attr no-lock where ext-classif-attr.classif-subject = ext-classif.classif-subject
      573         and ext-classif-attr.classif-name = ext-classif.classif-name
      574         and ext-classif-attr.db-num = ext-classif.db-num
      575         and ext-classif-attr.Key#_One = ext-classif.key#_one
      576         and ext-classif-attr.Key#_two = ext-classif.key#_two
      577         and ext-classif-attr.Key#_three = ext-classif.key#_three
      578         and ext-classif-attr.CharKey_One = ext-classif.charkey_one
      579         and ext-classif-attr.CharKey_two = ext-classif.charkey_two
      580         and ext-classif-attr.CharKey_three = ext-classif.charkey_three
      581         and ext-classif-attr.nonunique = ext-classif.nonunique
      582         and ext-classif-attr.attr-code = 'egais-info'
      583         no-error .
      584       if available  ext-classif-attr then do :
      585           export stream str-ext delimiter ';' ext-classif-attr .
      586           assign
      587               ext-classif.charkey_two = ""
      588               ext-classif.charkey_three = ""
      589           no-error .
      590       end.
      591       else put stream str-ext unformatted skip .
      592   end.
      593   put stream str-ext unformatted "Конец выгрузки - " string(today) + "   " + string(time, "hh:mm:ss") skip skip .
      594   output stream str-ext close .
      595   output stream str-ext to value ("ext-classif_egais_backup.d") append .
      596   put stream str-ext unformatted "Начало выгрузки - " string(today) + "   " + string(time, "hh:mm:ss") skip .
      597   for each  ext-classif no-lock
      598       where ext-classif.classif-subject = 'goods'
      599         and ext-classif.classif-name = 'exp-esys-gds-code'
      600         and ext-classif.db-num = 0
      601         and ext-classif.key#_two = v-ext-sys :
      602       export stream str-ext delimiter ';' ext-classif .
      603       find first ext-classif-attr no-lock where ext-classif-attr.classif-subject = ext-classif.classif-subject
      604         and ext-classif-attr.classif-name = ext-classif.classif-name
      605         and ext-classif-attr.db-num = ext-classif.db-num
      606         and ext-classif-attr.Key#_One = ext-classif.key#_one
      607         and ext-classif-attr.Key#_two = ext-classif.key#_two
      608         and ext-classif-attr.Key#_three = ext-classif.key#_three
      609         and ext-classif-attr.CharKey_One = ext-classif.charkey_one
      610         and ext-classif-attr.CharKey_two = ext-classif.charkey_two
      611         and ext-classif-attr.CharKey_three = ext-classif.charkey_three
      612         and ext-classif-attr.nonunique = ext-classif.nonunique
      613         and ext-classif-attr.attr-code = 'egais-info'
      614         no-error .
      615       if available  ext-classif-attr then next .
      616       create tt-ext-classif .
      617       buffer-copy ext-classif to tt-ext-classif
      618       assign tt-ext-classif.charkey_three = "" no-error .
      619   end.
      620   put stream str-ext unformatted "Конец выгрузки - " string(today) + "   " + string(time, "hh:mm:ss") skip skip .
      621   output stream str-ext close .
      622   .
      623   for each  ext-classif exclusive-lock
      624       where ext-classif.classif-subject = 'goods'
      625         and ext-classif.classif-name = 'exp-esys-gds-code'
      626         and ext-classif.db-num = 0
      627         and ext-classif.key#_two = v-ext-sys :
      628       find first ext-classif-attr exclusive-lock where ext-classif-attr.classif-subject = ext-classif.classif-subject
      629         and ext-classif-attr.classif-name = ext-classif.classif-name
      630         and ext-classif-attr.db-num = ext-classif.db-num
      631         and ext-classif-attr.Key#_One = ext-classif.key#_one
      632         and ext-classif-attr.Key#_two = ext-classif.key#_two
      633         and ext-classif-attr.Key#_three = ext-classif.key#_three
      634         and ext-classif-attr.CharKey_One = ext-classif.charkey_one
      635         and ext-classif-attr.CharKey_two = ext-classif.charkey_two
      636         and ext-classif-attr.CharKey_three = ext-classif.charkey_three
      637         and ext-classif-attr.nonunique = ext-classif.nonunique
      638         and ext-classif-attr.attr-code = 'egais-info'
      639         no-error .
      640       if available  ext-classif-attr then do :
      641           run str/callnews.p
      642             ( input 'ext-classif':U
      643               ,input (buffer ext-classif:handle )
      644             ) .
      645           run str/callnews.p
      646             ( input 'ext-classif-attr':U
      647               ,input (buffer ext-classif-attr:handle )
      648             ) .
      649           next .
      650       end.
      651       delete ext-classif .
      652   end.
      653   for each tt-ext-classif no-lock
      654           break by tt-ext-classif.key#_one by tt-ext-classif.charkey_one :
      655       if num-entries(tt-ext-classif.charkey_two, chr(4)) = 3
      656       and num-entries(entry(1,tt-ext-classif.charkey_two, chr(4)), chr(5)) = 6
      657       and num-entries(entry(2,tt-ext-classif.charkey_two, chr(4)), chr(5)) = 6
      658       then do :
      659           v-recid = recid(tt-ext-classif) .
      660       end.
      661       if not (num-entries(tt-ext-classif.charkey_two, chr(4)) = 3
      662       and num-entries(entry(1,tt-ext-classif.charkey_two, chr(4)), chr(5)) = 6
      663       and num-entries(entry(2,tt-ext-classif.charkey_two, chr(4)), chr(5)) = 6)
      664       and v-recid = ?
      665       then do :
      666           v-recid = recid(tt-ext-classif) .
      667       end.
      668       if last-of (tt-ext-classif.charkey_one) then do :
      669           v-recid-list = v-recid-list + chr(5) + string (v-recid).
      670           v-recid = ?.
      671       end.
      672   end.
      673   for each tt-ext-classif no-lock
      674           break by tt-ext-classif.key#_one by tt-ext-classif.charkey_one :
      675       if lookup (string(recid(tt-ext-classif)), v-recid-list, chr(5)) > 0 then do :
      676           create ext-classif.
      677           buffer-copy tt-ext-classif to ext-classif
      678           assign ext-classif.charkey_two = "" no-error .
      679           if error-status:error then next .
      680           create ext-classif-attr.
      681           buffer-copy ext-classif to ext-classif-attr
      682           assign ext-classif-attr.attr-code = 'egais-info' .
      683           if tt-ext-classif.charkey_two = ""
      684           then
      685           assign
      686               ext-classif-attr.attr-value = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) +
      687                                             chr(4) +
      688                                             chr(5) + chr(5) + chr(5) + chr(5) + chr(5) +
      689                                             chr(4)
      690           .
      691           else if num-entries(tt-ext-classif.charkey_two, chr(4)) = 3
      692           and num-entries(entry(1,tt-ext-classif.charkey_two, chr(4)), chr(5)) = 6
      693           and num-entries(entry(2,tt-ext-classif.charkey_two, chr(4)), chr(5)) = 6
      694           then
      695           assign ext-classif-attr.attr-value = tt-ext-classif.charkey_two .
      696           else do :
      697               assign
      698                   ext-classif-attr.attr-value = chr(4) + chr(4)
      699               .
      700               v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) .
      701               assign
      702                  entry(1, v-prod, chr(5)) = entry(1, (entry(1, tt-ext-classif.charkey_two, chr(4))), chr(5))
      703               no-error.
      704               assign
      705                  entry(4, v-prod, chr(5)) = entry(2, (entry(1, tt-ext-classif.charkey_two, chr(4))), chr(5))
      706               no-error.
      707               assign
      708                  entry(5, v-prod, chr(5)) = entry(3, (entry(1, tt-ext-classif.charkey_two, chr(4))), chr(5))
      709               no-error.
      710               assign
      711                  entry(6, v-prod, chr(5)) = entry(4, (entry(1, tt-ext-classif.charkey_two, chr(4))), chr(5))
      712               no-error.
      713               assign
      714                   entry(1, ext-classif-attr.attr-value, chr(4)) = v-prod
      715               no-error.
      716               assign
      717                   entry(2, ext-classif-attr.attr-value, chr(4)) = entry(2, tt-ext-classif.charkey_two, chr(4))
      718               no-error.
      719               assign
      720                   entry(3, ext-classif-attr.attr-value, chr(4)) = entry(3, tt-ext-classif.charkey_two, chr(4))
      721               no-error.
      722           end.
      723       end.
      724   end.
      725   message "Готово" view-as alert-box .
