      504                 input 1
      505               , input substitute( "Ошибка преобразования поля в десятичный тип. Строка &1. Поле &2. Значение '&3'"
      506                                   , p-file-line-num
      507                                   , p-field-name
      508                                   , p-input-string
      509                                 )
      510           ).
      511           run impgds-write-log in this-procedure (
      512                 input 1
      513               , input substitute( "Ошибка преобразования поля в десятичный тип. Строка &1. Поле &2. Значение '&3'"
      514                                   , p-file-line-num
      515                                   , p-field-name
      516                                   , p-input-string
      517                                 )
      518           ).
      519           run impgds-write-edt in this-procedure (
      520                 input p-log-handle
      521               , input 0
      522               , input substitute( "Ошибка преобразования поля в десятичный тип. Строка &1. Поле &2. Значение '&3'"
      523                                   , p-file-line-num
      524                                   , p-field-name
      525                                   , p-input-string
      526                                 )
      527           ).
      528           undo, return error.
      529       end.
      530   end.
      531   end procedure.
      532   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533   function is-numeral return logical
      534     (input p-string   as character ,
      535      input char-avail as character) :
      536     define variable p-replace-string as character no-undo .
      537     define variable log-result       as logical  no-undo .
      538     if p-string = ? then
      539       return false .
      540     p-replace-string = p-string.
      541     if lookup ("*", char-avail) > 0 then
      542         p-replace-string = replace (p-replace-string, '*', '9').
      543     if lookup ("digit", char-avail) > 0 then
      544       assign
      545         p-replace-string = replace (p-replace-string, '0', '9')
      546         p-replace-string = replace (p-replace-string, '1', '9')
      547         p-replace-string = replace (p-replace-string, '2', '9')
      548         p-replace-string = replace (p-replace-string, '3', '9')
      549         p-replace-string = replace (p-replace-string, '4', '9')
      550         p-replace-string = replace (p-replace-string, '5', '9')
      551         p-replace-string = replace (p-replace-string, '6', '9')
      552         p-replace-string = replace (p-replace-string, '7', '9')
      553         p-replace-string = replace (p-replace-string, '8', '9')
      554         .
      555     else
      556        p-replace-string = replace (p-replace-string, '9', chr(15))
      557         .
      558     if lookup ("letter", char-avail) > 0 then
      559       assign
      560         p-replace-string = replace (p-replace-string, 'A', '9')
      561         p-replace-string = replace (p-replace-string, 'B', '9')
      562         p-replace-string = replace (p-replace-string, 'C', '9')
      563         p-replace-string = replace (p-replace-string, 'D', '9')
      564         p-replace-string = replace (p-replace-string, 'E', '9')
      565         p-replace-string = replace (p-replace-string, 'F', '9')
      566         p-replace-string = replace (p-replace-string, 'G', '9')
      567         p-replace-string = replace (p-replace-string, 'H', '9')
      568         p-replace-string = replace (p-replace-string, 'I', '9')
      569         p-replace-string = replace (p-replace-string, 'J', '9')
      570         p-replace-string = replace (p-replace-string, 'K', '9')
      571         p-replace-string = replace (p-replace-string, 'L', '9')
      572         p-replace-string = replace (p-replace-string, 'M', '9')
      573         p-replace-string = replace (p-replace-string, 'N', '9')
      574         p-replace-string = replace (p-replace-string, 'O', '9')
      575         p-replace-string = replace (p-replace-string, 'P', '9')
      576         p-replace-string = replace (p-replace-string, 'Q', '9')
      577         p-replace-string = replace (p-replace-string, 'R', '9')
      578         p-replace-string = replace (p-replace-string, 'S', '9')
      579         p-replace-string = replace (p-replace-string, 'T', '9')
      580         p-replace-string = replace (p-replace-string, 'U', '9')
      581         p-replace-string = replace (p-replace-string, 'V', '9')
      582         p-replace-string = replace (p-replace-string, 'W', '9')
      583         p-replace-string = replace (p-replace-string, 'X', '9')
      584         p-replace-string = replace (p-replace-string, 'Y', '9')
      585         p-replace-string = replace (p-replace-string, 'Z', '9')
      586         p-replace-string = replace (p-replace-string, '_', '9')
      587         .
      588     return p-replace-string = fill ('9', length (p-string)).
      589   end.
      590   define variable vss-include-info3 as character format "X(65)" no-undo
      591   initial "@(#)$Workfile$ $Revision$".
      592   define temp-table temp_grplib_grp no-undo
      593       field sel           as character
      594       field nabor         as character
      595       field full-name     as character
      596       field print-code    as character
      597       field sort-name     as character
      598       field node-code     as integer
      599       field upper-code    as integer
      600       field calc-method   as character
      601       field round-method  as character
      602       field increase-pc   as decimal
      603       field min-marg      as character
      604       field max-marg      as character
      605       field cli-type      as character
      606       field cli-code      as integer
      607       field notcorr      as character
      608       field name          as character
      609       field level         as integer
      610       field mark          as character
      611       index pi is primary unique sort-name
      612       index fn full-name
      613       index nc is unique node-code
      614       index sl sel
      615       index uc upper-code
      616   .
      617   define temp-table temp_grplib_found-grp no-undo
      618       field full-name   as character
      619       field sort-name   as character
      620       field node-code   as integer
      621       field level       as integer
      622       field is-terminal as logical
      623       index pi is primary unique sort-name
      624       index fn full-name
      625       index lv level
      626       index it is-terminal
      627   .
      628   define temp-table temp_found-result-nodelist no-undo
      629       field node-code     as recid
      630       field processed     as logical
      631       field sort-name     as character
      632       field full-name     as character
      633       index pi is primary unique node-code
      634       index ps processed
      635   .
      636   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      637   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      638   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      639   procedure grplib-get-parameters :
      640   define input parameter p-store-type     as character        no-undo.
      641   define input parameter p-store-code     as integer          no-undo.
      642   do
      643   on error undo, return error
      644   :
      645       assign
      646           v-grplib-not-fill-extra-info = no
      647       .
      648   end.
      649   end procedure.
      650   procedure grplib-get-sort-name :
      651   do
      652   on error undo, return error
      653   :
      654   define input parameter p-node-code  as integer      no-undo.
      655   define output parameter p-sort-name as character    no-undo.
      656       define variable v-upper-code    as integer           no-undo.
      657       define buffer buf_gds-grp       for ub.gds-grp.
      658       define buffer buf_upper_gds-grp for ub.gds-grp.
      659       find first buf_gds-grp no-lock
      660            where buf_gds-grp.node-code = p-node-code
      661       no-error.
      662       if not available buf_gds-grp
      663       then do:
      664           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      665       end.
      666       assign
      667           p-sort-name  = ""
      668           v-upper-code = 1
      669       .
      670       do while buf_gds-grp.upper-code <> 0
      671       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      672       :
      673           assign
      674               p-sort-name  = buf_gds-grp.node-name
      675                            + (if p-sort-name <> "" then chr(2) else "")
      676                            + p-sort-name
      677               v-upper-code = buf_gds-grp.upper-code
      678           .
      679           find first buf_gds-grp no-lock
      680                where buf_gds-grp.node-code = v-upper-code
      681           no-error.
      682           if not available buf_gds-grp
      683           then do:
      684               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      685                                   + string( v-upper-code )
      686                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      687           end.
      688       end.
      689   end.
      690   end procedure.
      691   define variable vss-include-info4 as character format "X(65)" no-undo
      692   initial "@(#)$Workfile$ $Revision$".
      693   procedure grplib-get-full-name :
      694      define input parameter p-node-code  as integer      no-undo.
      695      define output parameter p-full-name as character    no-undo.
      696      do
      697   on error undo, return error
      698   :
      699       define variable v-upper-code    as integer           no-undo.
      700       define buffer buf_gds-grp       for ub.gds-grp.
      701       define buffer buf_upper_gds-grp for ub.gds-grp.
      702       find first buf_gds-grp no-lock
      703            where buf_gds-grp.node-code = p-node-code
      704       no-error.
      705       if not available buf_gds-grp
      706       then do:
      707           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      708       end.
      709       assign
      710           p-full-name  = ""
      711           v-upper-code = 1
      712       .
      713       do while buf_gds-grp.upper-code <> 0
      714       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      715       :
      716           assign
      717               p-full-name  = buf_gds-grp.node-name
      718                            + (if p-full-name <> "" then chr(47) else "")
      719                            + p-full-name
      720               v-upper-code = buf_gds-grp.upper-code
      721           .
      722           find first buf_gds-grp no-lock
      723                where buf_gds-grp.node-code = v-upper-code
      724           no-error.
      725           if not available buf_gds-grp
      726           then do:
      727               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      728                                   + string( v-upper-code )
      729                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      730           end.
      731       end.
      732       assign
      733       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      734       .
      735   end.
      736   end .
      737   procedure grplib-get-node-from-full-name :
      738   define input parameter p-full-name as character no-undo .
      739   define output parameter p-node-code as integer no-undo .
      740   define variable v-ii as integer no-undo .
      741   define variable v-upper-code as integer no-undo .
      742   define variable v-root-code as integer no-undo .
      743   define variable v-entry as character no-undo .
      744   define buffer buf_gds-grp       for ub.gds-grp.
      745   do
      746   on error undo, return error
      747   :
      748     find first buf_gds-grp no-lock
      749         where buf_gds-grp.upper-code = 0
      750     no-error .
      751     if not available buf_gds-grp
      752     then do:
      753         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      754     end.
      755     else do:
      756       assign
      757       v-root-code = buf_gds-grp.node-code
      758       .
      759     end.
      760     v-upper-code = v-root-code.
      761     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      762       assign
      763       v-entry = entry(v-ii, p-full-name, chr(47)).
      764       if v-entry = '' then leave.
      765       find first buf_gds-grp no-lock where
      766                 buf_gds-grp.node-name = v-entry
      767             and buf_gds-grp.upper-code = v-upper-code
      768             no-error.
      769       if not available buf_gds-grp then do:
      770         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      771       end.
      772       else do:
      773         p-node-code = buf_gds-grp.node-code.
      774         v-upper-code = buf_gds-grp.node-code.
      775       end.
      776     end.
      777   end.
      778   end .
      779   procedure grplib-get-root-code :
      780   do
      781   on error undo, return error
      782   :
      783   define output parameter p-root-code as integer      no-undo.
      784       define buffer buf_gds-grp       for ub.gds-grp.
      785       find first buf_gds-grp no-lock
      786           where buf_gds-grp.upper-code = 0
      787       no-error .
      788       if not available buf_gds-grp
      789       then do:
      790           undo, return error .
      791       end.
      792       else do:
      793           assign
      794               p-root-code = buf_gds-grp.node-code
      795           .
      796       end.
      797   end.
      798   end procedure.
      799   procedure grplib-find-grp-by-full-name :
      800   do
      801   on error undo, return error
      802   :
      803   define input parameter p-search-name  as character    no-undo.
      804   define input parameter p-fill-path    as logical      no-undo.
      805   define output parameter p-found       as logical      no-undo.
      806       define variable v-upper-code    as integer          no-undo.
      807       define variable v-counter       as integer           no-undo.
      808       define variable v-level         as integer           no-undo.
      809       define variable v-full-name     as character         no-undo.
      810       define variable v-sort-name     as character         no-undo.
      811       define buffer buf_gds-grp       for ub.gds-grp.
      812       assign
      813           p-search-name = replace( p-search-name, chr(47), chr(2) )
      814       .
      815       run grplib-get-root-code ( output v-upper-code ) no-error .
      816       if error-status :error
      817       then do:
      818           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      819       end.
      820       assign
      821           v-full-name  = ""
      822           v-level      = num-entries( p-search-name, chr(2) )
      823       .
      824       for each temp_grplib_found-grp
      825       :
      826           delete temp_grplib_found-grp.
      827       end.
      828       start-name-analyze:
      829       do v-counter = 1 to v-level
      830       :
      831           if v-counter < v-level
      832           then do:
      833               find first buf_gds-grp no-lock
      834                    where buf_gds-grp.upper-code = v-upper-code
      835                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      836               no-error .
      837               if not available buf_gds-grp
      838               then do:
      839                   assign
      840                       v-full-name  = p-search-name
      841                       v-sort-name  = p-search-name
      842                   .
      843                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      844               end.
      845               else do:
      846                   assign
      847                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      848                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      849                       v-upper-code = buf_gds-grp.node-code
      850                   .
      851                   if p-fill-path = yes
      852                   then do:
      853                       create temp_grplib_found-grp.
      854                       assign
      855                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      856                           temp_grplib_found-grp.sort-name = v-sort-name
      857                           temp_grplib_found-grp.node-code = v-upper-code
      858                           temp_grplib_found-grp.level     = v-counter
      859                       .
      860                   end.
      861               end.
      862           end.
      863           else do:
      864               for each buf_gds-grp no-lock
      865                  where buf_gds-grp.upper-code = v-upper-code
      866                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      867               :
      868                   assign
      869                       p-found = yes
      870                   .
      871                   create temp_grplib_found-grp.
      872                   assign
      873                       temp_grplib_found-grp.full-name = v-full-name
      874                                                           + (if v-full-name = "" then "" else chr(47) )
      875                                                           + buf_gds-grp.node-name + chr(47)
      876                       temp_grplib_found-grp.sort-name = v-sort-name
      877                                                           + ( if v-sort-name = "" then "" else chr(2) )
      878                                                           + buf_gds-grp.node-name
      879                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      880                       temp_grplib_found-grp.level     = v-level
      881                   .
      882               end.
      883               if p-found = no
      884               then do:
      885                   assign
      886                       v-full-name  = p-search-name
      887                       v-sort-name  = p-search-name
      888                   .
      889                   for each temp_grplib_found-grp
      890                   :
      891                       delete temp_grplib_found-grp.
      892                   end.
      893                   assign
      894                       p-found = no
      895                   .
      896               end.
      897           end.
      898       end.
      899   end.
      900   end procedure.
      901   procedure grplib-find-all-subgroup :
      902   do
      903   on error undo, return error
      904   :
      905   define input parameter p-start-node-code    as integer      no-undo.
      906   define input parameter p-terminal-only      as logical      no-undo.
      907       define variable v-start-full-name   as character     no-undo.
      908       define variable v-start-sort-name   as character     no-undo.
      909       define variable v-not-found         as logical       no-undo.
      910       define variable v-is-terminal       as logical       no-undo.
      911       define buffer buf_gds-grp           for ub.gds-grp.
      912       create temp_found-result-nodelist.
      913       assign
      914           temp_found-result-nodelist.node-code = p-start-node-code
      915           temp_found-result-nodelist.processed = no
      916       .
      917       run grplib-get-full-name in this-procedure (
      918             input p-start-node-code
      919           , output v-start-full-name
      920       ).
      921       run grplib-get-full-name in this-procedure (
      922             input p-start-node-code
      923           , output v-start-sort-name
      924       ).
      925       process-nodes:
      926       do while yes
      927       :
      928           find first temp_found-result-nodelist
      929                where temp_found-result-nodelist.node-code = p-start-node-code
      930           .
      931           assign
      932               temp_found-result-nodelist.processed = yes
      933           .
      934           for each buf_gds-grp no-lock
      935              where buf_gds-grp.upper-code = p-start-node-code
      936           on error undo, return error
      937           :
      938               run grplib-is-terminal in this-procedure (
      939                     input buf_gds-grp.node-code
      940                   , output v-is-terminal
      941               ).
      942               if v-is-terminal = yes
      943               then do:
      944                   create temp_grplib_found-grp.
      945                   assign
      946                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      947                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      948                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      949                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      950                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      951                       temp_grplib_found-grp.is-terminal = yes
      952                   .
      953               end.
      954               else do:
      955                   create temp_found-result-nodelist.
      956                   assign
      957                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      958                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      959                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      960                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      961                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      962                       temp_found-result-nodelist.processed = no
      963                   .
      964                   if p-terminal-only = no
      965                   then do:
      966                       create temp_grplib_found-grp.
      967                       assign
      968                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      969                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      970                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      971                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      972                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      973                           temp_grplib_found-grp.is-terminal = no
      974                       .
      975                   end.
      976               end.
      977           end.
      978           find first temp_found-result-nodelist
      979                where temp_found-result-nodelist.processed = no
      980           no-error.
      981           if not available temp_found-result-nodelist
      982           then do:
      983               leave process-nodes.
      984           end.
      985           else do:
      986               assign
      987                   p-start-node-code = temp_found-result-nodelist.node-code
      988                   v-start-full-name = temp_found-result-nodelist.full-name
      989                   v-start-sort-name = temp_found-result-nodelist.sort-name
      990               .
      991           end.
      992       end.
      993   end.
      994   end procedure.
      995   procedure grplib-expand-name :
      996   define input parameter p-start-name as character        no-undo.
      997   define output parameter p-end-name  as character        no-undo.
      998       define variable v-is-terminal   as logical      no-undo.
      999       define variable v-found         as character    no-undo.
     1000       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1001   do
     1002   for buf_temp_grplib_found-grp
     1003   on error undo, return error
     1004   :
     1005       run grplib-find-grp-by-full-name in this-procedure (
     1006             input p-start-name
     1007           , input no
     1008           , output v-found
     1009       ) no-error.
     1010       run grplib-get-max-substring in this-procedure (
     1011                   input length( p-start-name )
     1012                 , output p-end-name
     1013       ) no-error .
     1014       if error-status :error
     1015       then do:
     1016           assign
     1017               p-end-name = ""
     1018           .
     1019       end.
     1020       else do:
     1021           find first temp_grplib_found-grp
     1022               where temp_grplib_found-grp.full-name = p-end-name
     1023           no-error.
     1024           if available temp_grplib_found-grp
     1025           then do:
     1026               find first buf_temp_grplib_found-grp
     1027                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1028                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1029               no-error.
     1030               if not available buf_temp_grplib_found-grp
     1031               then do:
     1032                   run grplib-is-terminal in this-procedure (
     1033                       input temp_grplib_found-grp.node-code
     1034                       , output v-is-terminal
     1035                   ).
     1036               end.
     1037           end.
     1038       end.
     1039   end.
     1040   end procedure.
     1041   procedure grplib-get-max-substring :
     1042   do
     1043   on error undo, return error
     1044   :
     1045   define input parameter p-min-substring-length   as integer      no-undo.
     1046   define output parameter p-substring             as character    no-undo.
     1047           define variable v-char-counter  as integer           no-undo.
     1048           define variable v-current-char  as character         no-undo.
     1049           define variable v-names-counter  as integer           no-undo.
     1050           define variable v-base-string   as character         no-undo.
     1051           assign
     1052               v-char-counter  = p-min-substring-length
     1053           .
     1054           find first temp_grplib_found-grp no-error.
     1055           if not available temp_grplib_found-grp
     1056           then do:
     1057               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1058           end.
     1059           else do:
     1060               assign
     1061                   v-base-string  = temp_grplib_found-grp.full-name
     1062                   v-char-counter = 0
     1063               .
     1064               counter-block:
     1065               do while yes
     1066               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1067               :
     1068                   assign
     1069                       v-char-counter  = v-char-counter + 1
     1070                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1071                       v-names-counter = 0
     1072                   .
     1073                   compare-block:
     1074                   for each temp_grplib_found-grp
     1075                   :
     1076                       assign
     1077                           v-names-counter = v-names-counter + 1
     1078                       .
     1079                       if v-names-counter = 1
     1080                       then do:
     1081                           next compare-block.
     1082                       end.
     1083                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1084                       then do:
     1085                           leave counter-block.
     1086                       end.
     1087                   end.
     1088                   if v-names-counter = 1
     1089                   then do:
     1090                       assign
     1091                           p-substring = v-base-string
     1092                       .
     1093                       return.
     1094                   end.
     1095               end.
     1096               assign
     1097                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1098               .
     1099           end.
     1100   end.
     1101   end procedure.
     1102   procedure grplib-is-terminal :
     1103   do
     1104   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1105   :
     1106   define input parameter p-node-code      as integer      no-undo.
     1107   define output parameter p-is-terminal   as logical      no-undo.
     1108       define buffer buf_gds-grp       for ub.gds-grp.
     1109       find first buf_gds-grp no-lock
     1110           where buf_gds-grp.upper-code = p-node-code
     1111       no-error .
     1112       if not available buf_gds-grp
     1113       then do:
     1114           assign
     1115               p-is-terminal = yes
     1116           .
     1117       end.
     1118       else do:
     1119           assign
     1120               p-is-terminal = no
     1121           .
     1122       end.
     1123   end.
     1124   end procedure.
     1125   procedure grplib-have-goods :
     1126   do
     1127   on error undo, return error
     1128   :
     1129   define input parameter p-node-code      as integer      no-undo.
     1130   define output parameter p-have-goods   as logical      no-undo.
     1131       define buffer buf_goods         for ub.goods.
     1132       find first buf_goods no-lock
     1133            where buf_goods.grp-code = p-node-code
     1134       no-error .
     1135       if available buf_goods
     1136       then do:
     1137           assign
     1138               p-have-goods = yes
     1139           .
     1140       end.
     1141       else do:
     1142           assign
     1143               p-have-goods = no
     1144           .
     1145       end.
     1146   end.
     1147   end procedure.
     1148   procedure grplib-find-by-substring :
     1149   do
     1150   on error undo, return error
     1151   :
     1152   define input parameter p-start-code         as integer      no-undo.
     1153   define input parameter p-full-search-string as character    no-undo.
     1154   define output parameter p-found-code        as integer      no-undo.
     1155   define output parameter p-full-name         as character    no-undo.
     1156       define variable v-start-code     as integer           no-undo.
     1157       define variable v-found          as logical  init no  no-undo.
     1158       define buffer buf_gds-grp       for ub.gds-grp.
     1159       search-grp:
     1160       for each buf_gds-grp no-lock
     1161           where buf_gds-grp.node-code > p-start-code
     1162       :
     1163           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1164           then do:
     1165               assign
     1166                   p-found-code = buf_gds-grp.node-code
     1167                   v-found      = yes
     1168               .
     1169               run grplib-get-full-name in this-procedure (
     1170                     input p-found-code
     1171                   , output p-full-name
     1172               ) no-error .
     1173               if error-status :error
     1174               then do:
     1175                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1176               end.
     1177               leave search-grp.
     1178           end.
     1179       end.
     1180       if v-found = yes
     1181       then do:
     1182       end.
     1183       else do:
     1184           assign
     1185               p-full-name  = ""
     1186               p-found-code = 0
     1187           .
     1188       end.
     1189   end.
     1190   end procedure.
     1191   procedure grplib-analyze-grp-name :
     1192   do
     1193   on error undo, return error
     1194   :
     1195   define input parameter p-grp-name       as character            no-undo.
     1196   define input parameter p-upper-code     as integer              no-undo.
     1197   define output parameter p-error-message as character init ""    no-undo.
     1198       define variable v-char-list     as character    no-undo.
     1199       define variable v-char-counter  as integer      no-undo.
     1200       define variable v-full-name     as character    no-undo.
     1201       if p-grp-name = "" then do:
     1202           assign
     1203               p-error-message = "Название группы не может быть пустым.".
     1204           .
     1205       end.
     1206       else do:
     1207           assign
     1208               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1209           .
     1210           do v-char-counter = 1 to num-entries( v-char-list )
     1211           :
     1212               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1213               then do:
     1214                   assign
     1215                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1216                   .
     1217                   return.
     1218               end.
     1219           end.
     1220           if p-upper-code > 0
     1221           then do:
     1222               run grplib-get-full-name in this-procedure (
     1223                     input p-upper-code
     1224                   , output v-full-name
     1225               ) no-error .
     1226               if error-status :error
     1227               then do:
     1228                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1229               end.
     1230               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1231               then do:
     1232                   assign
     1233                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1234                   .
     1235               end.
     1236           end.
     1237       end.
     1238   end.
     1239   end procedure.
     1240   procedure grplib-get-lvl-num :
     1241   define input parameter p-node-code  as integer      no-undo.
     1242   define output parameter p-lvl-num   as integer      no-undo.
     1243       define variable v-full-name    as character    no-undo.
     1244   do
     1245   on error undo, return error
     1246   :
     1247       run grplib-get-full-name in this-procedure (
     1248             input p-node-code
     1249           , output v-full-name
     1250       ).
     1251       assign
     1252           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1253       .
     1254       if p-lvl-num = -1
     1255       then do:
     1256           assign
     1257               p-lvl-num = 0
     1258           .
     1259       end.
     1260   end.
     1261   end procedure.
     1262   procedure proc-alt-shift-f2:
     1263     if not ibs.th.gbl.gbl-var:rcode
     1264   then
     1265     run gbl\inidebug.p .
     1266   end.
     1267   procedure proc-alt-shift-f3:
     1268     run gbl/prvssinf.p
     1269       ( input this-procedure
     1270       ) .
     1271   end.
     1272   define variable v-inform-launched as logical no-undo initial false .
     1273   procedure proc-alt-shift-f4:
     1274     define variable v-action as character no-undo .
     1275     if v-inform-launched = false then do:
     1276       assign
     1277         v-inform-launched = true
     1278       .
     1279       run gbl/d-inform.w
     1280         (  input self
     1281         ,  input this-procedure
     1282         , output v-action
     1283         ) no-error .
     1284       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1285       assign
     1286         v-inform-launched = false
     1287       .
     1288     end.
     1289   end.
     1290   procedure proc-alt-f1:
     1291     run gbl/corrhelp.p
     1292       (input this-procedure
     1293       ) .
     1294   end .
     1295   on alt-shift-f2 anywhere do:
     1296     run proc-alt-shift-f2.
     1297   end.
     1298   on alt-shift-f3 anywhere do:
     1299     run proc-alt-shift-f3 in this-procedure .
     1300   end.
     1301   on alt-shift-f4 anywhere do:
     1302     run proc-alt-shift-f4 in this-procedure.
     1303   end.
     1304   on alt-f1 anywhere do:
     1305     run proc-alt-f1 in this-procedure .
     1306   end.
     1307   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1308     define variable v-cntxt-db-num        as integer   no-undo .
     1309     define variable v-cntxt-userid        as character no-undo .
     1310     define variable v-cntxt-level         as character no-undo .
     1311     define variable v-cntxt-host-code-obj as integer   no-undo .
     1312     define variable v-cntxt-obj-type      as character no-undo .
     1313     define variable v-cntxt-obj-code      as integer   no-undo .
     1314     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1315     define variable v-cntxt-is-admin      as logical   no-undo .
     1316   define variable v-store-type    as character    no-undo.
     1317   define variable v-store-code    as integer      no-undo.
     1318   define variable v-host-code     as integer      no-undo.
     1319   define variable v-db-num        as integer      no-undo.
     1320   define variable v-today         as date         no-undo.
     1321   define variable v-time          as integer      no-undo.
     1322   define variable dif-pdbc as logical no-undo initial no.
     1323   define variable pbc-veto  as logical no-undo.
     1324   define variable v-impgds-last-rate-code    as integer      no-undo.
     1325   DEFINE BUTTON b-exit
     1326        LABEL "&Выход"
     1327        SIZE 10 BY 1
     1328        BGCOLOR 8 .
     1329   DEFINE BUTTON b-help
     1330        LABEL "Помощ&ь"
     1331        SIZE 10 BY 1
     1332        BGCOLOR 8 .
     1333   DEFINE BUTTON bt-import
     1334        LABEL "&Импорт"
     1335        SIZE 10 BY 1.
     1336   DEFINE BUTTON bt-read
     1337        LABEL "&Чтение"
     1338        SIZE 10 BY 1.
     1339   DEFINE VARIABLE ed-log AS CHARACTER
     1340        VIEW-AS EDITOR LARGE
     1341        SIZE 97.88 BY 19.79
     1342        FGCOLOR 1  NO-UNDO.
     1343   DEFINE VARIABLE fi-log AS CHARACTER FORMAT "X(256)":U
     1344         VIEW-AS TEXT
     1345        SIZE 97.75 BY .79
     1346        FGCOLOR 9  NO-UNDO.
     1347   DEFINE FRAME Dialog-Frame
     1348        b-exit AT ROW 1 COL 1
     1349        bt-read AT ROW 1 COL 11
     1350        bt-import AT ROW 1 COL 21
     1351        b-help AT ROW 1 COL 89 WIDGET-ID 2
     1352        ed-log AT ROW 3.21 COL 1.13 NO-LABEL
     1353        fi-log AT ROW 2.29 COL 1.38 NO-LABEL
     1354        SPACE(0.74) SKIP(20.54)
     1355       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1356            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1357            TITLE "Импорт товаров".
     1358   ASSIGN
     1359          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1360          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1361   ASSIGN
     1362          ed-log:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1363   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1364   DO:
     1365     APPLY "END-ERROR":U TO SELF.
     1366   END.
     1367   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1368   DO:
     1369       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
     1370   END.
     1371   ON CHOOSE OF bt-import IN FRAME Dialog-Frame
     1372   DO:
     1373       output stream impgds-log to "impgds.log" append .
     1374       disable
     1375           bt-import
     1376       with frame Dialog-Frame .
     1377       run import-data in this-procedure (
     1378             input fi-log :handle in frame Dialog-Frame
     1379           , input ed-log :handle
     1380       ) no-error.
     1381       if error-status :error
     1382       then do:
     1383           message
     1384                    vss-workfile vss-revision vss-description
     1385               skip(1)
     1386               skip "Ошибка импорта."
     1387               skip return-value
     1388               skip trim(error-status :get-message(1))
     1389                    trim(error-status :get-message(2))
     1390                    trim(error-status :get-message(3))
     1391           view-as alert-box error.
     1392           undo, return no-apply .
     1393       end.
     1394       output stream impgds-log close.
     1395   END.
     1396   ON CHOOSE OF bt-read IN FRAME Dialog-Frame
     1397   DO:
     1398       define variable v-import-available    as logical      no-undo.
     1399       output stream impgds-log to "impgds.log" .
     1400       run read-data in this-procedure (
     1401             input fi-log :handle in frame Dialog-Frame
     1402           , input ed-log :handle
     1403           , output v-import-available
     1404       ) no-error.
     1405       if error-status :error
     1406       then do:
     1407           message
     1408                    vss-workfile vss-revision vss-description
     1409               skip(1)
     1410               skip "Ошибка чтения данных."
     1411               skip return-value
     1412               skip trim(error-status :get-message(1))
     1413                    trim(error-status :get-message(2))
     1414                    trim(error-status :get-message(3))
     1415           view-as alert-box error.
     1416           undo, return no-apply .
     1417       end.
     1418       output stream impgds-log close.
     1419       if v-import-available = yes
     1420       then do:
     1421           enable
     1422               bt-import
     1423           with frame Dialog-Frame .
     1424       end.
     1425       else do:
     1426           message
     1427               "Были ошибки при проверке считанных данных."
     1428               skip(1)
     1429               skip "Импорт невозможен."
     1430           view-as alert-box error.
     1431           undo, return no-apply .
     1432       end.
     1433   END.
     1434   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1435   on help of frame Dialog-Frame
     1436   do:
     1437     run gbl/app_help.p
     1438       (input this-procedure :file-name
     1439       ,input ''
     1440       ,input ?
     1441       ) no-error.
     1442     if error-status :error then do:
     1443       message
     1444         "Ошибка при вызове помощи"
     1445         error-status :get-message(1)
     1446         view-as alert-box .
     1447     end.
     1448   end.
     1449   run minbtn-set in this-procedure .
     1450   on choose of b-help in frame Dialog-Frame
     1451   do:
     1452     apply "help":u to frame Dialog-Frame .
     1453   end.
     1454   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1455   procedure minbtn-set :
     1456       do
     1457           on error undo, return error return-value
     1458           :
     1459           define variable ii              as integer       no-undo .
     1460           define variable fh              as widget-handle no-undo .
     1461           define variable hh              as widget-handle no-undo .
     1462           define variable v-h             as handle        extent 4 no-undo .
     1463           define variable v-name-button   as character     no-undo .
     1464           define variable v-help-old-x    as decimal       no-undo .
     1465           define variable v-help-old-y    as decimal       no-undo .
     1466           define variable v-help-old-size as decimal       no-undo .
     1467           define variable v-frame-width   as decimal       no-undo .
     1468           define variable jj              as integer       no-undo .
     1469           do
     1470               on error undo, return error
     1471               :
     1472               assign
     1473                   v-frame-width = frame Dialog-Frame:width - 0.3
     1474                   fh            = frame Dialog-Frame:first-child
     1475                   hh            = fh:first-child
     1476                   ii            = 1
     1477                   .
     1478               do while valid-handle(hh):
     1479                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1480                   do:
     1481                       case lc(hh:name) :
     1482                           when "b-help" then
     1483                               do:
     1484                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1485                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1486                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1487                                   hh:TOOLTIP = "Помощь" .
     1488                                   v-help-old-x = hh:column .
     1489                                   v-help-old-y = hh:row    .
     1490                                   v-help-old-size = hh:width .
     1491                                   hh:width-chars = 2.5 .
     1492                               end.
     1493                           when "b-print" then
     1494                               do:
     1495                                   hh:load-image("cmp/b-print.bmp":u) .
     1496                                   hh:TOOLTIP = "Печать" .
     1497                                   v-h[ii] = hh:handle .
     1498                                   ii = ii + 1 .
     1499                                   hh:width-chars = 3 .
     1500                               end.
     1501                           when "b-history" or
     1502                           when "b-hist" then
     1503                               do:
     1504                                   hh:load-image("cmp/b-hist.bmp":u) .
     1505                                   hh:TOOLTIP = "История" .
     1506                                   v-h[ii] = hh:handle .
     1507                                   ii = ii + 1 .
     1508                                   hh:width-chars = 3 .
     1509                               end.
     1510                           when "b-sch" then
     1511                               do:
     1512                                   hh:load-image("cmp/b-sch.bmp":u) .
     1513                                   hh:TOOLTIP = "Установка Фильтра" .
     1514                                   v-h[ii] = hh:handle .
     1515                                   ii = ii + 1 .
     1516                                   hh:width-chars = 3 .
     1517                               end.
     1518                           when "b-hist-user" then
     1519                               do:
     1520                                   hh:load-image("cmp/b-hist.bmp":u) .
     1521                                   hh:TOOLTIP = "История пользователя" .
     1522                                   ii = ii + 1 .
     1523                               end.
     1524                       end case.
     1525                   end.
     1526                   hh = hh:next-sibling.
     1527               end.
     1528               b-help:column = v-frame-width - b-help:width-chars.
     1529               jj = 0.
     1530               repeat ii = 4 to 1 by -1 :
     1531                   if valid-handle (v-h[ii] ) then
     1532                   do:
     1533                       jj  = jj + 1 .
     1534                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1535                       v-h[ii]:row    = v-help-old-y .
     1536                   end.
     1537               end.
     1538           end.
     1539       end.
     1540   end procedure.
     1541   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1542   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1543   MAIN-BLOCK:
     1544   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1545      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1546     run init-fields in this-procedure .
     1547     RUN enable_UI.
     1548     disable all with frame Dialog-Frame .
     1549     run init-enable in this-procedure .
     1550     WAIT-FOR GO OF FRAME Dialog-Frame.
     1551   END.
     1552   RUN disable_UI.
     1553   PROCEDURE check-gds :
     1554   define input parameter p-gds-code       as character        no-undo.
     1555   define input parameter p-gds-name       as character        no-undo.
     1556   define output parameter p-have-error    as logical          no-undo.
     1557   define output parameter p-error-text    as character        no-undo.
     1558       define variable v-temp-integer    as integer      no-undo.
     1559   do
     1560   on error undo, return error
     1561   :
     1562       if p-gds-name = ""
     1563       then do:
     1564           assign
     1565               p-have-error = yes
     1566               p-error-text = "Название товара пусто."
     1567           .
     1568       end.
     1569       if index( p-gds-name, chr(34)) > 0
     1570       and r-index( p-gds-name, chr(34) ) = index( p-gds-name, chr(34) )
     1571       then do:
     1572           assign
     1573               p-have-error = yes
     1574               p-error-text = "Название товара содержит непарную кавычку."
     1575           .
     1576       end.
     1577       assign
     1578           v-temp-integer = integer( p-gds-code )
     1579       no-error.
     1580       if error-status :error
     1581       then do:
     1582           assign
     1583               p-have-error = yes
     1584               p-error-text = "Код товара не может быть преобразован в число."
     1585           .
     1586       end.
     1587       else do:
     1588           if v-temp-integer <= 0
     1589           then do:
     1590               assign
     1591                   p-have-error = yes
     1592                   p-error-text = "Код товара меньше или равен 0."
     1593               .
     1594           end.
     1595       end.
     1596   end.
     1597   END PROCEDURE.
     1598   PROCEDURE disable_UI :
     1599     HIDE FRAME Dialog-Frame.
     1600   END PROCEDURE.
     1601   PROCEDURE enable_UI :
     1602     DISPLAY ed-log fi-log
     1603         WITH FRAME Dialog-Frame.
     1604     ENABLE b-exit bt-read bt-import b-help ed-log fi-log
     1605         WITH FRAME Dialog-Frame.
     1606     VIEW FRAME Dialog-Frame.
     1607   END PROCEDURE.
     1608   PROCEDURE import-barcodes-for-goods :
     1609   define input parameter p-temp-goods-gds-code  as integer        no-undo.
     1610   define input parameter p-temp-goods-unit-cli  as character      no-undo.
     1611   define input parameter p-gds-prt-node-code    as integer        no-undo.
     1612       define variable v-is-new    as logical      no-undo.
     1613       define variable l-is-weight as logical no-undo .
     1614       define variable l-is-pgweight as logical no-undo .
     1615       define variable l-is-petrolium as logical no-undo .
     1616       define buffer buf_bar-code          for ub.bar-code.
     1617       define buffer buf_temp_bar-codes    for temp_bar-codes.
     1618       define buffer buf_prod-bc           for ub.prod-bc.
     1619       define buffer buf_goods             for ub.goods.
     1620   do
     1621   for buf_bar-code
     1622     , buf_temp_bar-codes
     1623     , buf_prod-bc
     1624     , buf_goods
     1625   on error undo, return error
     1626   :
     1627       find first buf_bar-code no-lock
     1628            where buf_bar-code.b-code   = p-temp-goods-gds-code
     1629       no-error.
     1630       if not available buf_bar-code
     1631       then do:
     1632           find first buf_goods no-lock
     1633                where buf_goods.gds-code = p-temp-goods-gds-code
     1634           .
     1635   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1636   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1637     (input  p-temp-goods-gds-code
     1638     ,input  p-gds-prt-node-code
     1639     ,input  ''
     1640     ,input  ''
     1641     ,input  buf_goods.unit-cli
     1642     ,input  buf_goods.cli-base-rate
     1643     ,output v-is-new
     1644     ,buffer buf_bar-code
     1645     )  .
     1646       end.
     1647       _buf_temp-bar-codes:
     1648       for each buf_temp_bar-codes
     1649          where buf_temp_bar-codes.gds-code = p-temp-goods-gds-code
     1650       :
     1651   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     1653     (input buf_temp_bar-codes.b-str
     1654     ,input  buf_bar-code.unit-cli
     1655     ,input  buf_goods.unit-base
     1656     ,input  'weight=request':u
     1657     ,output l-is-weight
     1658     )  .
     1659   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1660   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     1661     (input buf_temp_bar-codes.b-str
     1662     ,input  buf_bar-code.unit-cli
     1663     ,input  buf_goods.unit-base
     1664     ,input  'pgweight=request':u
     1665     ,output l-is-pgweight
     1666     )  .
     1667   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     1669     (input buf_temp_bar-codes.b-str
     1670     ,input  buf_bar-code.unit-cli
     1671     ,input  buf_goods.unit-base
     1672     ,input  'petrolium=request':u
     1673     ,output l-is-petrolium
     1674     )  .
     1675           if (l-is-weight
     1676           or l-is-pgweight
     1677           or l-is-petrolium
     1678           ) then do:
     1679             next _buf_temp-bar-codes.
     1680           end.
     1681           find first buf_prod-bc no-lock
     1682                where buf_prod-bc.b-code   = p-temp-goods-gds-code
     1683                  and buf_prod-bc.b-str    = buf_temp_bar-codes.b-str
     1684           no-error.
     1685           if not available buf_prod-bc
     1686           then do:
     1687             define variable v-b-str as character no-undo .
     1688             define variable rid as recid no-undo .
     1689             v-b-str = buf_temp_bar-codes.b-str.
     1690             rid = ?.
     1691             run trg/prod-bc1.p (
     1692                                 input  parparentproc
     1693                                 ,input yes
     1694                                 ,input dif-pdbc
     1695                                 ,input pbc-veto
     1696                                 ,input no
     1697                                 ,input ''
     1698                                 ,input ""
     1699                                 ,buffer buf_goods
     1700                                 ,input p-temp-goods-gds-code
     1701                                 ,input-output v-b-str
     1702                                 ,output rid
     1703                                 ) no-error.
     1704            if error-status :error
     1705            then do:
     1706               run impgds-write-log in this-procedure (
     1707                     input 1
     1708                   , input substitute( "Fatal err: Ошибка при сохраненеии ДопБК: &1 для товара:&2&3"
     1709                                       , buf_temp_bar-codes.b-str
     1710                                       , error-status:get-message(1)
     1711                                       , return-value
     1712                                     )
     1713               ).
     1714            end.
     1715            else if rid = ? then do:
     1716               run impgds-write-log in this-procedure (
     1717                     input 1
     1718                   , input substitute( "No-fatal err: Не удалось сохранить ДОпБК: &1 для товара: &2"
     1719                                       , buf_temp_bar-codes.b-str
     1720                                       , return-value
     1721                                     )
     1722               ).
     1723            end.
     1724           end.
     1725           else do:
     1726               run impgds-write-log in this-procedure (
     1727                     input 1
     1728                   , input substitute( "No-fatal err: Дополнительный бар-код: &1 для товара: &2 уже есть."
     1729                                       , buf_temp_bar-codes.b-str
     1730                                       , p-temp-goods-gds-code
     1731                                     )
     1732               ).
     1733           end.
     1734       end.
     1735   end.
     1736   END PROCEDURE.
     1737   PROCEDURE import-clients :
     1738       define input parameter p-cnt-handle as handle           no-undo.
     1739       define variable v-group-code    as integer      no-undo.
     1740       define variable v-clients-recid as recid        no-undo.
     1741       define buffer buf_cli-grp       for ub.cli-grp.
     1742       define buffer buf_clients       for ub.clients.
     1743       define buffer buf_temp_clients  for temp_clients.
     1744       define buffer buf_firm          for ub.firm.
     1745   do
     1746   for buf_clients
     1747     , buf_temp_clients
     1748     , buf_firm
     1749   on error undo, return error
     1750   :
     1751       find first buf_cli-grp no-lock
     1752            where buf_cli-grp.node-name = 'Внешние':U
     1753       no-error.
     1754       if error-status :error
     1755       then do:
     1756           message
     1757               substitute( "Не найдена группа клиентов '&2'.&1Импорт контрагентов невозможен."
     1758                           , chr(10)
     1759                           , 'Внешние':U
     1760                         )
     1761           view-as alert-box error
     1762           title "Импорт товаров из Trade в Trade House"
     1763           .
     1764           undo, return error.
     1765       end.
     1766       else do:
     1767           assign
     1768               v-group-code = buf_cli-grp.node-code
     1769           .
     1770       end.
     1771       for each buf_temp_clients
     1772       on error undo, return error
     1773       :
     1774           find first buf_clients no-lock
     1775                where buf_clients.obj-type = 'орг':U
     1776                  and buf_clients.obj-code = buf_temp_clients.obj-code
     1777           no-error.
     1778           if not available buf_clients
     1779           then do:
     1780               run ref/firm1.p (
     1781                     input parparentproc
     1782                   , input-output v-clients-recid
     1783                   , input 'ДОБАВЛЕНИЕ':U
     1784                   , input "":U
     1785                   , input no
     1786                   , input ( - abs(buf_temp_clients.obj-code))
     1787                   , input 0
     1788                   , input buf_temp_clients.obj-name
     1789                   , input "":U
     1790                   , input buf_temp_clients.ps
     1791                   , input v-group-code
     1792                   , input substring( buf_temp_clients.address, 1, 50 )
     1793                           + substring( buf_temp_clients.address, 101, 50 )
     1794                           + substring( buf_temp_clients.address, 151 )
     1795                   , input substring( buf_temp_clients.address, 51, 50 )
     1796                   , input "":U
     1797                   , input "":U
     1798                   , input buf_temp_clients.director
     1799                   , input buf_temp_clients.email
     1800                   , input "":U
     1801                   , input buf_temp_clients.fax
     1802                   , input "":U
     1803                   , input "":U
     1804                   , input buf_temp_clients.inn
     1805                   , input no
     1806                   , input no
     1807                   , input buf_temp_clients.kpp
     1808                   , input buf_temp_clients.okonh
     1809                   , input buf_temp_clients.okpo
     1810                   , input "":U
     1811                   , input "":U
     1812                   , input buf_temp_clients.phone
     1813                   , input "":U
     1814                   , input "":U
     1815                   , input "":U
     1816                   , input "":U
     1817                   , input 0
     1818                   , input 0
     1819                   , input "":U
     1820                   , input 0
     1821                   , input no
     1822                   , input no
     1823               ).
     1824           end.
     1825           else do:
     1826               undo, return error
     1827                       substitute( "Err: Попытка повторного импорта объекта: &1 &2"
     1828                                   , buf_clients.obj-code
     1829                                   , buf_clients.obj-name )
     1830               .
     1831           end.
     1832           if buf_temp_clients.obj-code < 9999990
     1833           and current-value( s-fmgb-code, ub ) < buf_temp_clients.obj-code
     1834           then do:
     1835               assign
     1836                   current-value( s-fmgb-code, ub ) = buf_temp_clients.obj-code
     1837               .
     1838           end.
     1839           run impgds-write-cnt in this-procedure (
     1840                 input p-cnt-handle
     1841               , input substitute( "Импортирован объект: &1 &2 &3"
     1842                                   , 'орг':U
     1843                                   , buf_temp_clients.obj-code
     1844                                   , buf_temp_clients.obj-name )
     1845           ).
     1846       end.
     1847   end.
     1848   END PROCEDURE.
     1849   PROCEDURE import-data :
     1850   define input parameter p-cnt-handle     as handle           no-undo.
     1851   define input parameter p-log-handle     as handle           no-undo.
     1852   do
     1853   on error undo, return error
     1854   :
     1855       run impgds-write-cnt in this-procedure (
     1856             input p-cnt-handle
     1857           , input " ":U
     1858       ).
     1859       run impgds-write-edt in this-procedure (
     1860             input p-log-handle
     1861           , input 1
     1862           , input "Импорт контрагентов..."
     1863       ).
     1864       run import-clients  in this-procedure (
     1865           input p-cnt-handle
     1866       ) no-error.
     1867       if error-status :error
     1868       then do:
     1869           message
     1870                    vss-workfile vss-revision vss-description
     1871               skip(1)
     1872               skip "Ошибка импорта контрагентов."
     1873               skip return-value
     1874               skip trim(error-status :get-message(1))
     1875                    trim(error-status :get-message(2))
     1876                    trim(error-status :get-message(3))
     1877           view-as alert-box error.
     1878           undo, return error .
     1879       end.
     1880       run impgds-write-edt in this-procedure (
     1881             input p-log-handle
     1882           , input 1
     1883           , input "Импорт контрагентов завершен."
     1884       ).
     1885       run impgds-write-cnt in this-procedure (
     1886             input p-cnt-handle
     1887           , input " ":U
     1888       ).
     1889       run impgds-write-cnt in this-procedure (
     1890             input p-cnt-handle
     1891           , input " ":U
     1892       ).
     1893       run impgds-write-edt in this-procedure (
     1894             input p-log-handle
     1895           , input 1
     1896           , input "Импорт групп товаров..."
     1897       ).
     1898       run import-gds-grp  in this-procedure (
     1899           input p-cnt-handle
     1900       ) no-error.
     1901       if error-status :error
     1902       then do:
     1903           message
     1904                    vss-workfile vss-revision vss-description
     1905               skip(1)
     1906               skip "Ошибка импорта групп товаров."
     1907               skip return-value
     1908               skip trim(error-status :get-message(1))
     1909                    trim(error-status :get-message(2))
     1910                    trim(error-status :get-message(3))
     1911           view-as alert-box error.
     1912           undo, return error .
     1913       end.
     1914       run impgds-write-edt in this-procedure (
     1915             input p-log-handle
     1916           , input 1
     1917           , input "Импорт групп товаров завершен."
     1918       ).
     1919       run impgds-write-cnt in this-procedure (
     1920             input p-cnt-handle
     1921           , input " ":U
     1922       ).
     1923       run impgds-write-edt in this-procedure (
     1924             input p-log-handle
     1925           , input 1
     1926           , input "Импорт карточек товаров..."
     1927       ).
     1928       run import-goods in this-procedure (
     1929           input p-cnt-handle
     1930       ) no-error.
     1931       if error-status :error
     1932       then do:
     1933           message
     1934                    vss-workfile vss-revision vss-description
     1935               skip(1)
     1936               skip "Ошибка импорта товаров."
     1937               skip return-value
     1938               skip trim(error-status :get-message(1))
     1939                    trim(error-status :get-message(2))
     1940                    trim(error-status :get-message(3))
     1941           view-as alert-box error.
     1942           undo, return error .
     1943       end.
     1944       run impgds-write-edt in this-procedure (
     1945             input p-log-handle
     1946           , input 1
     1947           , input "Импорт карточек товаров завершен."
     1948       ).
     1949       run impgds-write-cnt in this-procedure (
     1950             input p-cnt-handle
     1951           , input " ":U
     1952       ).
     1953   end.
     1954   END PROCEDURE.
     1955   PROCEDURE import-gds-grp :
     1956       define input parameter p-cnt-handle as handle           no-undo.
     1957       define buffer buf_gds-grp           for ub.gds-grp.
     1958       define buffer buf_temp_gds-grp      for temp_gds-grp.
     1959   do
     1960   for buf_gds-grp
     1961     , buf_temp_gds-grp
     1962   on error undo, return error
     1963   :
     1964       for each buf_temp_gds-grp
     1965       by buf_temp_gds-grp.upper-code
     1966       on error undo, return error
     1967       :
     1968           find first buf_gds-grp no-lock
     1969                where buf_gds-grp.node-code = buf_temp_gds-grp.node-code
     1970           no-error.
     1971           if not available buf_gds-grp
     1972           then do:
     1973               run utl/impgrptx.p (
     1974                     input 'ДОБАВЛЕНИЕ':U
     1975                   , input buf_temp_gds-grp.node-code
     1976                   , input buf_temp_gds-grp.upper-code
     1977                   , input buf_temp_gds-grp.node-name
     1978                   , input v-host-code
     1979                   , input v-store-type
     1980                   , input v-store-code
     1981               ) no-error.
     1982               if error-status :error
     1983               then do:
     1984                   message
     1985                            vss-workfile vss-revision vss-description
     1986                       skip(1)
     1987                       skip "Ошибка создания группы товаров."
     1988                       skip(1)
     1989                       skip "Код группы:" buf_temp_gds-grp.node-code
     1990                       skip "Имя группы:" buf_temp_gds-grp.node-name
     1991                       skip return-value
     1992                       skip trim(error-status :get-message(1))
     1993                            trim(error-status :get-message(2))
     1994                            trim(error-status :get-message(3))
     1995                   view-as alert-box error.
     1996                   undo, return error .
     1997               end.
     1998               else do:
     1999                   if current-value( s-gds-grp, ub ) < buf_temp_gds-grp.node-code
     2000                   then do:
     2001                       assign
     2002                           current-value( s-gds-grp, ub ) = buf_temp_gds-grp.node-code
     2003                       .
     2004                   end.
     2005                   run impgds-write-cnt in this-procedure (
     2006                         input p-cnt-handle
     2007                       , input substitute( "Импортирована группа: &1 &2"
     2008                                           , buf_temp_gds-grp.node-code
     2009                                           , buf_temp_gds-grp.node-name )
     2010                   ).
     2011               end.
     2012           end.
     2013           else do:
     2014               undo, return error
     2015                       substitute( "Err: Попытка повторного импорта группы: &1 &2"
     2016                                   , buf_temp_gds-grp.node-code
     2017                                   , buf_temp_gds-grp.node-name )
     2018               .
     2019           end.
     2020       end.
     2021   end.
     2022   END PROCEDURE.
     2023   PROCEDURE import-goods :
     2024   define input parameter p-cnt-handle     as handle           no-undo.
     2025       define variable v-goods-parameter-dif-nam1  as logical      init yes    no-undo.
     2026       define variable v-goods-parameter-dif-nam2  as logical      init no     no-undo.
     2027       define variable v-par-value                 as character                no-undo.
     2028       define variable v-par-type                  as character                no-undo.
     2029       define variable v-vat-rate-code             as integer                  no-undo.
     2030       define variable v-slt-rate-code             as integer                  no-undo.
     2031       define variable v-goods-recid               as recid                    no-undo.
     2032       define variable v-gds-code                  as integer                  no-undo.
     2033       define variable v-last-gds-code             as integer                  no-undo.
     2034       define variable v-tax-rate-recid            as recid                    no-undo.
     2035       define variable v-tax-rate-value-recid      as recid                    no-undo.
     2036       define variable v-goods-unit-cli            as character                no-undo.
     2037       define variable v-param-type                as character                no-undo.
     2038       define variable v-value-character           as character                no-undo.
     2039       define variable v-value-date                as date                     no-undo.
     2040       define variable v-value-decimal             as decimal                  no-undo.
     2041       define variable v-value-integer             as INTEGER                  no-undo.
     2042       define variable v-value-logical             AS LOGICAL                  no-undo.
     2043       define variable v-tth                       as handle                   no-undo.
     2044       define buffer buf_goods         for ub.goods.
     2045       define buffer buf_units         for ub.units.
     2046       define buffer buf_temp_goods    for temp_goods.
     2047       define buffer buf_gds-prt       for ub.gds-prt.
     2048       define buffer buf_temp_tax      for temp_tax.
     2049   do
     2050   for buf_goods
     2051     , buf_units
     2052     , buf_temp_goods
     2053     , buf_gds-prt
     2054     , buf_temp_tax
     2055   on error undo, return error
     2056   :
     2057   if session :set-wait-state( "compiler" ) then.
     2058       for each buf_temp_goods
     2059       by buf_temp_goods.gds-code descending
     2060       :
     2061           assign
     2062               v-last-gds-code = buf_temp_goods.gds-code
     2063           .
     2064           leave.
     2065       end.
     2066       if v-last-gds-code >= current-value( s-bcgb-code, ub )
     2067       then do:
     2068           assign
     2069               current-value( s-bcgb-code, ub ) = v-last-gds-code + 1
     2070           .
     2071       end.
     2072       import-goods:
     2073       for each buf_temp_goods
     2074       on error undo, return error
     2075       :
     2076           find first buf_goods no-lock
     2077                where buf_goods.gds-code = buf_temp_goods.gds-code
     2078           no-error.
     2079           if available buf_goods
     2080           then do:
     2081               run impgds-write-log in this-procedure (
     2082                     input 1
     2083                   , input substitute( "Невозможно создать товар с кодом, который есть у товара в БД: &1"
     2084                           , buf_temp_goods.gds-code )
     2085               ).
     2086               next import-goods.
     2087           end.
     2088           find first buf_units no-lock
     2089                where buf_units.unit-name = buf_temp_goods.unit-base
     2090           .
     2091           find first buf_gds-prt no-lock
     2092                where buf_gds-prt.node-name = '_Пустая шкала':U
     2093           no-error.
     2094           if not available buf_gds-prt
     2095           then do:
     2096               undo, return error "import-product: Не найден код пустой шкалы для товара." + chr(10) + return-value.
     2097           end.
     2098           run adm/shattri.p (
     2099               input "get":U
     2100               ,input  '':U
     2101               ,input  0
     2102               ,input  'gds-ref':U
     2103               ,input  'dif-nam1':U
     2104               ,output v-value-character
     2105               ,output v-value-date
     2106               ,output v-value-decimal
     2107               ,output v-value-integer
     2108               ,output v-goods-parameter-dif-nam1
     2109               ,output v-param-type
     2110               ,INPUT-OUTPUT table-handle v-tth
     2111               ) no-error.
     2112           delete object v-tth.
     2113           run adm/shattri.p (
     2114               input "get":U
     2115               ,input  '':U
     2116               ,input  0
     2117               ,input  'gds-ref':U
     2118               ,input  'dif-nam2':U
     2119               ,output v-value-character
     2120               ,output v-value-date
     2121               ,output v-value-decimal
     2122               ,output v-value-integer
     2123               ,output v-goods-parameter-dif-nam2
     2124               ,output v-param-type
     2125               ,INPUT-OUTPUT table-handle v-tth
     2126               ) no-error.
     2127           delete object v-tth.
     2128           find first buf_temp_tax
     2129                where buf_temp_tax.tax-code   = integer( '1':U )
     2130                  and buf_temp_tax.rate-value = buf_temp_goods.VAT-pc
     2131           no-error.
     2132           if not available buf_temp_tax
     2133           then do:
     2134               assign
     2135                   v-impgds-last-rate-code = v-impgds-last-rate-code + 1
     2136               .
     2137               create buf_temp_tax.
     2138               assign
     2139                   buf_temp_tax.tax-code       = integer( '1':U )
     2140                   buf_temp_tax.rate-value     = buf_temp_goods.VAT-pc
     2141                   buf_temp_tax.rate-code      = v-impgds-last-rate-code
     2142               .
     2143               run ref/taxrati1.p (
     2144                     input-output v-tax-rate-recid
     2145                   , input 'ДОБАВЛЕНИЕ':U
     2146                   , input yes
     2147                   , input integer( '1':U )
     2148                   , input v-impgds-last-rate-code
     2149                   , input substitute( "НДС &1", buf_temp_goods.VAT-pc  )
     2150                   , input 'тек':U
     2151               ) no-error .
     2152               if error-status :error
     2153               then do:
     2154                   run impgds-write-log in this-procedure (
     2155                         input 1
     2156                       , input substitute( "Fatal err: Ошибка при сохраненеии ставки налога для товара.&1&2&1&3"
     2157                                           , chr(10)
     2158                                           , error-status:get-message(1)
     2159                                           , return-value
     2160                                         )
     2161               ).
     2162               end.
     2163               run ref/taxvali1.p (
     2164                     input-output v-tax-rate-value-recid
     2165                   , input 'ДОБАВЛЕНИЕ':U
     2166                   , input yes
     2167                   , input integer( '1':U )
     2168                   , input v-impgds-last-rate-code
     2169                   , input buf_temp_tax.rate-value
     2170                   , input v-today
     2171                   , input 0
     2172                   , input "":U
     2173                   , input 0
     2174                   , input 'тек':U
     2175               ).
     2176           end.
     2177           assign
     2178               v-vat-rate-code = buf_temp_tax.rate-code
     2179           .
     2180           find first buf_temp_tax
     2181                where buf_temp_tax.tax-code   = integer( '2':U )
     2182                  and buf_temp_tax.rate-value = buf_temp_goods.SLT-pc
     2183           no-error.
     2184           if not available buf_temp_tax
     2185           then do:
     2186               assign
     2187                   v-impgds-last-rate-code = v-impgds-last-rate-code + 1
     2188               .
     2189               create buf_temp_tax.
     2190               assign
     2191                   buf_temp_tax.tax-code       = integer( '2':U )
     2192                   buf_temp_tax.rate-value     = buf_temp_goods.SLT-pc
     2193                   buf_temp_tax.rate-code      = v-impgds-last-rate-code
     2194               .
     2195               run ref/taxrati1.p (
     2196                     input-output v-tax-rate-recid
     2197                   , input 'ДОБАВЛЕНИЕ':U
     2198                   , input yes
     2199                   , input integer( '2':U )
     2200                   , input v-impgds-last-rate-code
     2201                   , input substitute( "НП &1", buf_temp_goods.SLT-pc  )
     2202                   , input 'тек':U
     2203               ) no-error .
     2204               if error-status :error
     2205               then do:
     2206                   run impgds-write-log in this-procedure (
     2207                         input 1
     2208                       , input substitute( "Fatal err: Ошибка при сохраненеии ставки налога для товара.&1&2&1&3"
     2209                                           , chr(10)
     2210                                           , error-status:get-message(1)
     2211                                           , return-value
     2212                                         )
     2213               ).
     2214               end.
     2215               run ref/taxvali1.p (
     2216                     input-output v-tax-rate-value-recid
     2217                   , input 'ДОБАВЛЕНИЕ':U
     2218                   , input yes
     2219                   , input integer( '2':U )
     2220                   , input v-impgds-last-rate-code
     2221                   , input buf_temp_tax.rate-value
     2222                   , input v-today
     2223                   , input 0
     2224                   , input "":U
     2225                   , input 0
     2226                   , input 'тек':U
     2227               ).
     2228           end.
     2229           assign
     2230               v-slt-rate-code = buf_temp_tax.rate-code
     2231           .
     2232           run utl/impgdstx.p (
     2233                 input 'ДОБАВЛЕНИЕ':U
     2234               , input v-vat-rate-code
     2235               , input v-slt-rate-code
     2236               , input no
     2237               , input 0
     2238               , input no
     2239               , input yes
     2240               , input no
     2241               , input yes
     2242               , input v-host-code
     2243               , input v-store-type
     2244               , input v-store-code
     2245               , input yes
     2246               , input 0
     2247               , input buf_temp_goods.gds-code
     2248               , input buf_temp_goods.artic
     2249               , input 'орг':U
     2250               , input buf_temp_goods.prod-code
     2251               , input buf_gds-prt.node-code
     2252               , input buf_temp_goods.grp-code
     2253               , input buf_temp_goods.gds-name
     2254               , input ""
     2255               , input buf_temp_goods.engl-name
     2256               , input buf_temp_goods.gds-name
     2257               , input replace( replace( buf_temp_goods.gds-name, chr( 39 ), "" ), chr( 34 ), "" )
     2258               , input "XX":U
     2259               , input buf_units.unit-name
     2260               , input buf_units.unit-name
     2261               , input 0.0
     2262               , input 0.0
     2263               , input 1
     2264               , input 1
     2265               , input 0
     2266               , input 0
     2267               , input 'Группа':U
     2268               , input 0
     2269               , input no
     2270               , input 0
     2271               , input 0
     2272               , input ""
     2273               , input ""
     2274               , input ""
     2275               , input ""
     2276               , input ""
     2277               , input ""
     2278               , input 0
     2279               , input ""
     2280               , input 0.0
     2281               , input 0
     2282               , input 0
     2283               , input ""
     2284               , input ""
     2285               , input ""
     2286               , input 0
     2287               , input ""
     2288               , input no
     2289               , input no
     2290               , input no
     2291               , input no
     2292               , input "no"
     2293               , input v-goods-parameter-dif-nam1
     2294               , input v-goods-parameter-dif-nam2
     2295               , input no
     2296               , input 2
     2297               , input-output v-goods-recid
     2298               , output v-gds-code
     2299           ) no-error .
     2300           if error-status :error
     2301           then do:
     2302               message
     2303                   vss-workfile vss-revision vss-description
     2304                   skip "Ошибка создания карточки товара."
     2305                   skip return-value
     2306                   skip trim(error-status :get-message(1))
     2307                       trim(error-status :get-message(2))
     2308                       trim(error-status :get-message(3))
     2309                       trim(error-status :get-message(4))
     2310                       trim(error-status :get-message(5))
     2311               view-as alert-box error.
     2312               undo, return error "Err: Ошибка создания товара в базе данных."
     2313                                   + chr(10) + "Код товара: " + string( buf_temp_goods.gds-code )
     2314                                   + chr(10) + trim(error-status :get-message(1))
     2315                                   + chr(10) + return-value
     2316               .
     2317           end.
     2318           assign
     2319               v-goods-unit-cli = ( if buf_temp_goods.unit-base = 'лт':U
     2320                                    then 'кгт':U
     2321                                    else buf_temp_goods.unit-base )
     2322           .
     2323           find first buf_gds-prt no-lock
     2324                where buf_gds-prt.node-name = '_Пустая шкала':U
     2325           no-error.
     2326           if error-status :error
     2327           then do:
     2328               message
     2329                   "Err: Не найден корневой узел для шкалы товаров. Импорт товаров невозможен."
     2330               view-as alert-box.
     2331               undo, return error.
     2332           end.
     2333           run import-barcodes-for-goods in this-procedure (
     2334                 input buf_temp_goods.gds-code
     2335               , input v-goods-unit-cli
     2336               , input buf_gds-prt.node-code
     2337           ) no-error.
     2338           if error-status :error
     2339           then do:
     2340               undo, return error "Err: Ошибка при создании бар-кодов для товара: "
     2341                           + " " + string( buf_temp_goods.gds-code )
     2342                           + " " + string( buf_temp_goods.gds-name )
     2343                           + chr(10)
     2344               .
     2345           end.
     2346           else do:
     2347               run impgds-write-log in this-procedure (
     2348                     input 1
     2349                   , input substitute( "OK: Товар &1. Бар-коды созданы."
     2350                                       , buf_temp_goods.gds-code
     2351                                     )
     2352               ).
     2353           end.
     2354           run impgds-write-cnt in this-procedure (
     2355                 input p-cnt-handle
     2356               , input substitute( "Импортирован товар: &1 &2", buf_temp_goods.gds-code, buf_temp_goods.gds-name )
     2357           ).
     2358       end.
     2359       run impgds-write-cnt in this-procedure (
     2360             input p-cnt-handle
     2361           , input substitute( " ":U )
     2362       ).
     2363   if session :set-wait-state( "" ) then.
     2364     run adm/restseqr.p
     2365         ( input "rest-no-msg":U
     2366          ,input "":U
     2367          ,input yes
     2368       ) no-error .
     2369     if error-status :error then do:
     2370       return error return-value .
     2371     end.
     2372   end.
     2373   END PROCEDURE.
     2374   PROCEDURE init-enable :
     2375   do
     2376   on error undo, return error
     2377   :
     2378       enable
     2379           b-exit
     2380           bt-read
     2381           ed-log
     2382       with frame Dialog-Frame .
     2383   end.
     2384   END PROCEDURE.
     2385   PROCEDURE init-fields :
     2386   define variable v-param-type                as character                no-undo.
     2387   define variable v-value-character           as character                no-undo.
     2388   define variable v-value-date                as date                     no-undo.
     2389   define variable v-value-decimal             as decimal                  no-undo.
     2390   define variable v-value-integer             as INTEGER                  no-undo.
     2391   define variable v-value-logical             AS LOGICAL                  no-undo.
     2392   define variable v-tth                       as handle                   no-undo.
     2393   do
     2394   on error undo, return error
     2395   :
     2396   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2397     run mainmenu_getcntxt in parparentproc
     2398       (output v-cntxt-db-num
     2399       ,output v-cntxt-userid
     2400       ,output v-cntxt-level
     2401       ,output v-cntxt-host-code-obj
     2402       ,output v-cntxt-obj-type
     2403       ,output v-cntxt-obj-code
     2404       ,output v-cntxt-db-num-obj
     2405       ,output v-cntxt-is-admin
     2406       ) .
     2407       assign
     2408           v-store-type = v-cntxt-obj-type
     2409           v-store-code = v-cntxt-obj-code
     2410       .
     2411   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2413     (input  v-store-type
     2414     ,input  v-store-code
     2415     ,output v-host-code
     2416     )  .
     2417   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2419     (output v-db-num
     2420     )  .
     2421     run adm/shattri.p (
     2422         input "get":U
     2423         ,input  '':U
     2424         ,input  0
     2425         ,input  'gds-ref':U
     2426         ,input  'dif-pdbc':U
     2427         ,output v-value-character
     2428         ,output v-value-date
     2429         ,output v-value-decimal
     2430         ,output v-value-integer
     2431         ,output dif-pdbc
     2432         ,output v-param-type
     2433         ,INPUT-OUTPUT table-handle v-tth
     2434         ) no-error.
     2435     delete object v-tth.
     2436     run adm/shattri.p (
     2437         input "get":U
     2438         ,input  '':U
     2439         ,input  0
     2440         ,input  'gds-ref':U
     2441         ,input  'dif-pdbc':U
     2442         ,output v-value-character
     2443         ,output v-value-date
     2444         ,output v-value-decimal
     2445         ,output v-value-integer
     2446         ,output pbc-veto
     2447         ,output v-param-type
     2448         ,INPUT-OUTPUT table-handle v-tth
     2449         ) no-error.
     2450     delete object v-tth.
     2451       run cur-time in this-procedure (
     2452             output v-today
     2453           , output v-time
     2454       ).
     2455   end.
     2456   END PROCEDURE.
     2457   PROCEDURE read-bcodes-file :
     2458       define variable v-gds-code      as character    no-undo.
     2459       define variable v-b-str         as character    no-undo.
     2460       define variable v-temp-integer  as integer      no-undo.
     2461       define buffer buf_temp_bar-codes    for temp_bar-codes.
     2462       define buffer buf_prod-bc           for ub.prod-bc.
     2463   do
     2464   for buf_temp_bar-codes
     2465     , buf_prod-bc
     2466   on error undo, return error
     2467   :
     2468   if session :set-wait-state( "compiler" ) then.
     2469       run impgds-write-log in this-procedure (
     2470             input 0
     2471           , input fill( "=", 80 )
     2472       ).
     2473       run impgds-write-log in this-procedure (
     2474             input 1
     2475           , input substitute( "Чтение бар-кодов из файла &1"
     2476                           , "bcode.txt" )
     2477       ).
     2478       input stream impgds-in from "bcode.txt" .
     2479       import-clients-string:
     2480       repeat
     2481       :
     2482           assign
     2483               v-gds-code      = "":U
     2484               v-b-str         = "":U
     2485           .
     2486           import stream impgds-in
     2487               v-gds-code
     2488               v-b-str
     2489           .
     2490           if v-gds-code = "":U
     2491           then do:
     2492               next import-clients-string.
     2493           end.
     2494           run impgds-assign-integer in this-procedure (
     2495                 input ed-log :handle in frame Dialog-Frame
     2496               , input v-impgds-last-rec-no + 1
     2497               , input "gds-code":U
     2498               , input v-gds-code
     2499               , output v-temp-integer
     2500           ).
     2501           find first buf_temp_bar-codes no-lock
     2502                where buf_temp_bar-codes.gds-code = v-temp-integer
     2503                  and buf_temp_bar-codes.b-str    = v-b-str
     2504           no-error.
     2505           if available buf_temp_bar-codes
     2506           then do:
     2507               run impgds-write-log in this-procedure (
     2508                     input 1
     2509                   , input substitute( "Повторное чтение бар-кода &2 для товара с кодом &1", v-temp-integer, v-b-str )
     2510               ).
     2511               assign
     2512                   v-impgds-repeated-records = v-impgds-repeated-records + 1
     2513               .
     2514               next import-clients-string.
     2515           end.
     2516           find first buf_prod-bc no-lock
     2517                where buf_prod-bc.b-code   = v-temp-integer
     2518                  and buf_prod-bc.b-str    = v-b-str
     2519           no-error.
     2520           if available buf_prod-bc
     2521           then do:
     2522               run impgds-write-log in this-procedure (
     2523                     input 1
     2524                   , input substitute( "Чтение бар-кода &2, который есть у товара &1 в БД."
     2525                           , v-temp-integer, v-b-str )
     2526               ).
     2527               assign
     2528                   v-impgds-existed-records  = v-impgds-existed-records + 1
     2529               .
     2530               next import-clients-string.
     2531           end.
     2532           create buf_temp_bar-codes.
     2533           assign
     2534               v-impgds-last-rec-no    = v-impgds-last-rec-no + 1
     2535           .
     2536           assign
     2537               buf_temp_bar-codes.rec-no           = v-impgds-last-rec-no
     2538               buf_temp_bar-codes.gds-code         = v-temp-integer
     2539               buf_temp_bar-codes.b-str            = v-b-str
     2540           .
     2541       end.
     2542       input stream impgds-in close.
     2543   if session :set-wait-state( "" ) then.
     2544   end.
     2545   END PROCEDURE.
     2546   PROCEDURE read-clients-file :
     2547       define variable v-obj-code      as character    no-undo.
     2548       define variable v-obj-name      as character    no-undo.
     2549       define variable v-address       as character    no-undo.
     2550       define variable v-phone         as character    no-undo.
     2551       define variable v-fax           as character    no-undo.
     2552       define variable v-director      as character    no-undo.
     2553       define variable v-email         as character    no-undo.
     2554       define variable v-okonh         as character    no-undo.
     2555       define variable v-okpo          as character    no-undo.
     2556       define variable v-inn           as character    no-undo.
     2557       define variable v-kpp           as character    no-undo.
     2558       define variable v-ps            as character    no-undo.
     2559       define variable v-temp-integer     as integer      no-undo.
     2560       define buffer buf_temp_clients  for temp_clients.
     2561       define buffer buf_clients       for ub.clients.
     2562   do
     2563   for buf_temp_clients
     2564     , buf_clients
     2565   on error undo, return error
     2566   :
     2567   if session :set-wait-state( "compiler" ) then.
     2568       run impgds-write-log in this-procedure (
     2569             input 0
     2570           , input fill( "=", 80 )
     2571       ).
     2572       run impgds-write-log in this-procedure (
     2573             input 1
     2574           , input substitute( "Чтение контрагентов из файла &1"
     2575                           , "client.txt" )
     2576       ).
     2577       input stream impgds-in from "client.txt" .
     2578       import-clients-string:
     2579       repeat
     2580       :
     2581           assign
     2582               v-obj-code      = "":U
     2583               v-obj-name      = "":U
     2584           .
     2585           import stream impgds-in
     2586               v-obj-code
     2587               v-obj-name
     2588               v-address
     2589               v-phone
     2590               v-fax
     2591               v-director
     2592               v-email
     2593               v-okonh
     2594               v-okpo
     2595               v-inn
     2596               v-kpp
     2597               v-ps
     2598           .
     2599           if v-obj-code = "":U
     2600           then do:
     2601               next import-clients-string.
     2602           end.
     2603           run impgds-assign-integer in this-procedure (
     2604                 input ed-log :handle in frame Dialog-Frame
     2605               , input v-impgds-last-rec-no + 1
     2606               , input "obj-code":U
     2607               , input v-obj-code
     2608               , output v-temp-integer
     2609           ).
     2610           find first buf_temp_clients
     2611                where buf_temp_clients.obj-code = v-temp-integer
     2612           no-error.
     2613           if available buf_temp_clients
     2614           then do:
     2615               run impgds-write-log in this-procedure (
     2616                     input 1
     2617                   , input substitute( "Повторное чтение объекта с кодом &1", v-temp-integer )
     2618               ).
     2619               assign
     2620                   v-impgds-repeated-records = v-impgds-repeated-records + 1
     2621               .
     2622               next import-clients-string.
     2623           end.
     2624           find first buf_clients no-lock
     2625                where buf_clients.obj-type = 'орг':U
     2626                  and buf_clients.obj-code = v-temp-integer
     2627           no-error.
     2628           if available buf_clients
     2629           then do:
     2630               run impgds-write-log in this-procedure (
     2631                     input 1
     2632                   , input substitute( "Чтение объекта с кодом, который есть у объекта в БД: &1"
     2633                           , v-temp-integer )
     2634               ).
     2635               assign
     2636                   v-impgds-existed-records  = v-impgds-existed-records + 1
     2637               .
     2638               next import-clients-string.
     2639           end.
     2640           create buf_temp_clients.
     2641           assign
     2642               v-impgds-last-rec-no    = v-impgds-last-rec-no + 1
     2643           .
     2644           assign
     2645               buf_temp_clients.rec-no           = v-impgds-last-rec-no
     2646               buf_temp_clients.obj-code         = v-temp-integer
     2647               buf_temp_clients.obj-name         = v-obj-name
     2648               buf_temp_clients.address          = v-address
     2649               buf_temp_clients.phone            = v-phone
     2650               buf_temp_clients.fax              = v-fax
     2651               buf_temp_clients.director         = v-director
     2652               buf_temp_clients.email            = v-email
     2653               buf_temp_clients.okonh            = v-okonh
     2654               buf_temp_clients.okpo             = v-okpo
     2655               buf_temp_clients.inn              = v-inn
     2656               buf_temp_clients.kpp              = v-kpp
     2657               buf_temp_clients.ps               = v-ps
     2658           .
     2659       end.
     2660       input stream impgds-in close.
     2661   if session :set-wait-state( "" ) then.
     2662   end.
     2663   END PROCEDURE.
     2664   PROCEDURE read-data :
     2665   define input parameter p-cnt-handle         as handle           no-undo.
     2666   define input parameter p-log-handle         as handle           no-undo.
     2667   define output parameter p-import-available  as logical          no-undo.
     2668   do
     2669   on error undo, return error
     2670   :
     2671       define variable v-data-have-error    as logical      no-undo.
     2672       assign
     2673           v-data-have-error = no
     2674       .
     2675       run impgds-write-edt in this-procedure (
     2676             input p-log-handle
     2677           , input 1
     2678           , input "Чтение данных для импорта."
     2679       ).
     2680       run impgds-write-edt in this-procedure (
     2681             input p-log-handle
     2682           , input 1
     2683           , input substitute( "Лог-файл:      &1", "impgds.log" )
     2684       ).
     2685       run impgds-write-edt in this-procedure (
     2686             input p-log-handle
     2687           , input 1
     2688           , input substitute( "Файл ошибок:   &1", "impgds.err" )
     2689       ).
     2690       assign
     2691           v-impgds-last-rec-no        = 0
     2692           v-impgds-repeated-records   = 0
     2693           v-impgds-existed-records    = 0
     2694           v-impgds-error-records      = 0
     2695       .
     2696       run impgds-write-edt in this-procedure (
     2697             input p-log-handle
     2698           , input 2
     2699           , input substitute( "Чтение файла контрагентов &1...", "client.txt"  )
     2700       ).
     2701       disable
     2702           bt-read
     2703       with frame Dialog-Frame .
     2704       run read-clients-file in this-procedure
     2705       no-error.
     2706       if error-status :error
     2707       then do:
     2708           message
     2709                    vss-workfile vss-revision vss-description
     2710               skip(1)
     2711               skip "Ошибка чтения файла контрагентов."
     2712               skip return-value
     2713               skip trim(error-status :get-message(1))
     2714                    trim(error-status :get-message(2))
     2715                    trim(error-status :get-message(3))
     2716           view-as alert-box error.
     2717           undo, return error .
     2718       end.
     2719       run impgds-write-edt in this-procedure (
     2720             input p-log-handle
     2721           , input 2
     2722           , input substitute( "Чтение файла контрагентов завершено." )
     2723       ).
     2724       run impgds-write-edt in this-procedure (
     2725             input p-log-handle
     2726           , input 2
     2727           , input substitute( "Считано &1 записей.", v-impgds-last-rec-no )
     2728       ).
     2729       if v-impgds-repeated-records <> 0
     2730       then do:
     2731           run impgds-write-edt in this-procedure (
     2732                 input p-log-handle
     2733               , input 2
     2734               , input substitute( "Повторно считано &1 контрагентов (вторая запись не будет импортирована).", v-impgds-repeated-records )
     2735           ).
     2736       end.
     2737       if v-impgds-existed-records <> 0
     2738       then do:
     2739           run impgds-write-edt in this-procedure (
     2740                 input p-log-handle
     2741               , input 2
     2742               , input substitute( "Считано &1 контрагентов, уже существующих в базе данных (не будут импортированы).", v-impgds-existed-records )
     2743           ).
     2744       end.
     2745       if v-impgds-error-records <> 0
     2746       then do:
     2747           run impgds-write-edt in this-procedure (
     2748                 input p-log-handle
     2749               , input 2
     2750               , input substitute( "Считано &1 контрагентов с ошибками. Импорт невозможен.", v-impgds-error-records )
     2751           ).
     2752           assign
     2753               v-data-have-error = yes
     2754           .
     2755       end.
     2756       assign
     2757           v-impgds-last-rec-no        = 0
     2758           v-impgds-repeated-records   = 0
     2759           v-impgds-existed-records    = 0
     2760           v-impgds-error-records      = 0
     2761       .
     2762       run impgds-write-edt in this-procedure (
     2763             input p-log-handle
     2764           , input 2
     2765           , input substitute( "Чтение файла групп товаров &1...", "group.txt"  )
     2766       ).
     2767       run read-gds-grp-file in this-procedure (
     2768           input p-log-handle
     2769       ) no-error.
     2770       if error-status :error
     2771       then do:
     2772           message
     2773                    vss-workfile vss-revision vss-description
     2774               skip(1)
     2775               skip "Ошибка чтения файла групп товаров."
     2776               skip return-value
     2777               skip trim(error-status :get-message(1))
     2778                    trim(error-status :get-message(2))
     2779                    trim(error-status :get-message(3))
     2780           view-as alert-box error.
     2781           undo, return error .
     2782       end.
     2783       run impgds-write-edt in this-procedure (
     2784             input p-log-handle
     2785           , input 2
     2786           , input substitute( "Чтение файла групп товаров завершено." )
     2787       ).
     2788       run impgds-write-edt in this-procedure (
     2789             input p-log-handle
     2790           , input 2
     2791           , input substitute( "Считано &1 записей.", v-impgds-last-rec-no )
     2792       ).
     2793       if v-impgds-repeated-records <> 0
     2794       then do:
     2795           run impgds-write-edt in this-procedure (
     2796                 input p-log-handle
     2797               , input 2
     2798               , input substitute( "Повторно считано &1 групп товаров (вторая запись не будет импортирована).", v-impgds-repeated-records )
     2799           ).
     2800       end.
     2801       if v-impgds-existed-records <> 0
     2802       then do:
     2803           run impgds-write-edt in this-procedure (
     2804                 input p-log-handle
     2805               , input 2
     2806               , input substitute( "Считано &1 групп товаров, уже существующих в базе данных (не будут импортированы).", v-impgds-existed-records )
     2807           ).
     2808       end.
     2809       if v-impgds-error-records <> 0
     2810       then do:
     2811           run impgds-write-edt in this-procedure (
     2812                 input p-log-handle
     2813               , input 2
     2814               , input substitute( "Считано &1 групп товаров с ошибками. Импорт невозможен.", v-impgds-error-records )
     2815           ).
     2816           assign
     2817               v-data-have-error = yes
     2818           .
     2819       end.
     2820       run impgds-write-edt in this-procedure (
     2821             input p-log-handle
     2822           , input 2
     2823           , input "Чтение таблицы налогов из базы данных..."
     2824       ).
     2825       run read-tax-in-base in this-procedure
     2826       no-error.
     2827       if error-status :error
     2828       then do:
     2829           message
     2830                    vss-workfile vss-revision vss-description
     2831               skip(1)
     2832               skip "Ошибка чтения ставок налогов."
     2833               skip return-value
     2834               skip trim(error-status :get-message(1))
     2835                    trim(error-status :get-message(2))
     2836                    trim(error-status :get-message(3))
     2837           view-as alert-box error.
     2838           undo, return error .
     2839       end.
     2840       run impgds-write-edt in this-procedure (
     2841             input p-log-handle
     2842           , input 2
     2843           , input "Чтение таблицы налогов из базы данных завершено."
     2844       ).
     2845       assign
     2846           v-impgds-last-rec-no        = 0
     2847           v-impgds-repeated-records   = 0
     2848           v-impgds-existed-records    = 0
     2849           v-impgds-error-records      = 0
     2850       .
     2851       run impgds-write-edt in this-procedure (
     2852             input p-log-handle
     2853           , input 2
     2854           , input substitute( "Чтение файла товаров &1...", "good.txt"  )
     2855       ).
     2856       run read-goods-file in this-procedure (
     2857             input p-cnt-handle
     2858           , input p-log-handle
     2859       ) no-error.
     2860       if error-status :error
     2861       then do:
     2862           message
     2863                    vss-workfile vss-revision vss-description
     2864               skip(1)
     2865               skip "Ошибка чтения файла товаров."
     2866               skip return-value
     2867               skip trim(error-status :get-message(1))
     2868                    trim(error-status :get-message(2))
     2869                    trim(error-status :get-message(3))
     2870           view-as alert-box error.
     2871           undo, return error .
     2872       end.
     2873       run impgds-write-edt in this-procedure (
     2874             input p-log-handle
     2875           , input 2
     2876           , input substitute( "Чтение файла товаров завершено." )
     2877       ).
     2878       run impgds-write-edt in this-procedure (
     2879             input p-log-handle
     2880           , input 2
     2881           , input substitute( "Считано &1 записей.", v-impgds-last-rec-no )
     2882       ).
     2883       if v-impgds-repeated-records <> 0
     2884       then do:
     2885           run impgds-write-edt in this-procedure (
     2886                 input p-log-handle
     2887               , input 2
     2888               , input substitute( "Повторно считано &1 кодов товаров (вторая запись не будет импортирована).", v-impgds-repeated-records )
     2889           ).
     2890       end.
     2891       if v-impgds-existed-records <> 0
     2892       then do:
     2893           run impgds-write-edt in this-procedure (
     2894                 input p-log-handle
     2895               , input 2
     2896               , input substitute( "Считано &1 кодов товаров, уже существующих в базе данных (не будут импортированы).", v-impgds-existed-records )
     2897           ).
     2898       end.
     2899       if v-impgds-error-records <> 0
     2900       then do:
     2901           run impgds-write-edt in this-procedure (
     2902                 input p-log-handle
     2903               , input 2
     2904               , input substitute( "Считано &1 товаров с ошибками. Импорт невозможен.", v-impgds-error-records )
     2905           ).
     2906           assign
     2907               v-data-have-error = yes
     2908           .
     2909       end.
     2910       assign
     2911           v-impgds-last-rec-no        = 0
     2912           v-impgds-repeated-records   = 0
     2913           v-impgds-existed-records    = 0
     2914           v-impgds-error-records      = 0
     2915       .
     2916       run impgds-write-edt in this-procedure (
     2917             input p-log-handle
     2918           , input 2
     2919           , input substitute( "Чтение файла бар-кодов &1...", "bcode.txt"  )
     2920       ).
     2921       run read-bcodes-file in this-procedure
     2922       no-error.
     2923       if error-status :error
     2924       then do:
     2925           message
     2926                    vss-workfile vss-revision vss-description
     2927               skip(1)
     2928               skip "Ошибка чтения файла бар-кодов."
     2929               skip return-value
     2930               skip trim(error-status :get-message(1))
     2931                    trim(error-status :get-message(2))
     2932                    trim(error-status :get-message(3))
     2933           view-as alert-box error.
     2934           undo, return error .
     2935       end.
     2936       run impgds-write-edt in this-procedure (
     2937             input p-log-handle
     2938           , input 2
     2939           , input substitute( "Чтение файла бар-кодов завершено." )
     2940       ).
     2941       run impgds-write-edt in this-procedure (
     2942             input p-log-handle
     2943           , input 2
     2944           , input substitute( "Считано &1 записей.", v-impgds-last-rec-no )
     2945       ).
     2946       if v-impgds-repeated-records <> 0
     2947       then do:
     2948           run impgds-write-edt in this-procedure (
     2949                 input p-log-handle
     2950               , input 2
     2951               , input substitute( "Повторно считано &1 бар-кодов (вторая запись не будет импортирована).", v-impgds-repeated-records )
     2952           ).
     2953       end.
     2954       if v-impgds-existed-records <> 0
     2955       then do:
     2956           run impgds-write-edt in this-procedure (
     2957                 input p-log-handle
     2958               , input 2
     2959               , input substitute( "Считано &1 бар-кодов, уже существующих в базе данных (не будут импортированы).", v-impgds-existed-records )
     2960           ).
     2961       end.
     2962       if v-impgds-error-records <> 0
     2963       then do:
     2964           run impgds-write-edt in this-procedure (
     2965                 input p-log-handle
     2966               , input 2
     2967               , input substitute( "Считано &1 бар-кодов с ошибками. Импорт невозможен.", v-impgds-error-records )
     2968           ).
     2969           assign
     2970               v-data-have-error = yes
     2971           .
     2972       end.
     2973       if v-data-have-error = no
     2974       then do:
     2975           assign
     2976               p-import-available = yes
     2977           .
     2978       end.
     2979   end.
     2980   END PROCEDURE.
     2981   PROCEDURE read-gds-grp-file :
     2982   define input parameter p-edt-handle     as handle           no-undo.
     2983       define variable v-node-code       as character    no-undo.
     2984       define variable v-upper-code      as character    no-undo.
     2985       define variable v-node-name       as character    no-undo.
     2986       define variable v-temp-integer     as integer      no-undo.
     2987       define variable v-temp-decimal     as decimal      no-undo.
     2988       define variable v-error-message    as character    no-undo.
     2989       define buffer buf_temp_gds-grp  for temp_gds-grp.
     2990       define buffer buf_gds-grp       for ub.gds-grp.
     2991   do
     2992   for buf_temp_gds-grp
     2993     , buf_gds-grp
     2994   on error undo, return error
     2995   :
     2996   if session :set-wait-state( "compiler" ) then.
     2997       run impgds-write-log in this-procedure (
     2998             input 0
     2999           , input fill( "=", 80 )
     3000       ).
     3001       run impgds-write-log in this-procedure (
     3002             input 1
     3003           , input substitute( "Чтение групп товаров из файла &1"
     3004                           , "group.txt" )
     3005       ).
     3006       input stream impgds-in from "group.txt" .
     3007       import-gds-grp-string:
     3008       repeat
     3009       :
     3010           assign
     3011               v-node-code      = "":U
     3012               v-upper-code     = "":U
     3013               v-node-name      = "":U
     3014           .
     3015           import stream impgds-in
     3016               v-node-code
     3017               v-upper-code
     3018               v-node-name
     3019           .
     3020           if v-node-code = "":U
     3021           then do:
     3022               next import-gds-grp-string.
     3023           end.
     3024           run impgds-assign-integer in this-procedure (
     3025                 input ed-log :handle in frame Dialog-Frame
     3026               , input v-impgds-last-rec-no + 1
     3027               , input "node-code":U
     3028               , input v-node-code
     3029               , output v-temp-integer
     3030           ).
     3031           find first buf_temp_gds-grp no-lock
     3032                where buf_temp_gds-grp.node-code = v-temp-integer
     3033           no-error.
     3034           if available buf_temp_gds-grp
     3035           then do:
     3036               run impgds-write-log in this-procedure (
     3037                     input 1
     3038                   , input substitute( "Повторное чтение группы товара с кодом &1", v-temp-integer )
     3039               ).
     3040               assign
     3041                   v-impgds-repeated-records = v-impgds-repeated-records + 1
     3042               .
     3043               next import-gds-grp-string.
     3044           end.
     3045           find first buf_gds-grp no-lock
     3046                where buf_gds-grp.node-code = v-temp-integer
     3047           no-error.
     3048           if available buf_gds-grp
     3049           then do:
     3050               run impgds-write-log in this-procedure (
     3051                     input 1
     3052                   , input substitute( "Чтение группы товара с кодом, который есть у группы в БД: &1"
     3053                           , v-temp-integer )
     3054               ).
     3055               assign
     3056                   v-impgds-existed-records  = v-impgds-existed-records + 1
     3057               .
     3058               next import-gds-grp-string.
     3059           end.
     3060           create buf_temp_gds-grp.
     3061           assign
     3062               v-impgds-last-rec-no    = v-impgds-last-rec-no + 1
     3063           .
     3064           assign
     3065               buf_temp_gds-grp.rec-no           = v-impgds-last-rec-no
     3066               buf_temp_gds-grp.node-code        = v-temp-integer
     3067               buf_temp_gds-grp.node-name        = v-node-name
     3068           .
     3069           run impgds-assign-integer in this-procedure (
     3070                 input ed-log :handle in frame Dialog-Frame
     3071               , input v-impgds-last-rec-no + 1
     3072               , input "upper-code":U
     3073               , input v-upper-code
     3074               , output buf_temp_gds-grp.upper-code
     3075           ).
     3076           run grplib-analyze-grp-name in this-procedure (
     3077                 input v-node-name
     3078               , input buf_temp_gds-grp.upper-code
     3079               , output v-error-message
     3080           ).
     3081           if v-error-message <> "":U
     3082           then do:
     3083               run impgds-write-error in this-procedure (
     3084                     input 1
     3085                   , input substitute( "Ошибка в имени группы товара &1: &2", buf_temp_gds-grp.node-code, v-error-message )
     3086               ).
     3087               run impgds-write-edt in this-procedure (
     3088                     input ed-log :handle in frame Dialog-Frame
     3089                   , input 1
     3090                   , input substitute( "Ошибка в имени группы &1: &2", buf_temp_gds-grp.node-code, v-error-message )
     3091               ).
     3092               assign
     3093                   v-impgds-error-records  = v-impgds-error-records + 1
     3094               .
     3095           end.
     3096       end.
     3097       input stream impgds-in close.
     3098   if session :set-wait-state( "" ) then.
     3099   end.
     3100   END PROCEDURE.
     3101   PROCEDURE read-goods-file :
     3102   define input parameter p-cnt-handle     as handle           no-undo.
     3103   define input parameter p-log-handle     as handle           no-undo.
     3104       define variable v-gds-code          as character   no-undo.
     3105       define variable v-artic             as character   no-undo.
     3106       define variable v-prod-code         as character   no-undo.
     3107       define variable v-grp-code          as character   no-undo.
     3108       define variable v-unit-base         as character   no-undo.
     3109       define variable v-unit-base-type    as character   no-undo.
     3110       define variable v-gds-type          as character   no-undo.
     3111       define variable v-gds-name          as character   no-undo.
     3112       define variable v-engl-name         as character   no-undo.
     3113       define variable v-VAT-pc            as character   no-undo.
     3114       define variable v-SLT-pc            as character   no-undo.
     3115       define variable v-deadline          as character   no-undo.
     3116       define variable v-have-error        as logical      no-undo.
     3117       define variable v-error-message     as character    no-undo.
     3118       define variable v-temp-integer      as integer      no-undo.
     3119       define variable v-temp-decimal      as decimal      no-undo.
     3120       define buffer buf_temp_goods        for temp_goods.
     3121       define buffer buf_rep_temp_goods    for temp_goods.
     3122       define buffer buf_goods             for ub.goods.
     3123   do
     3124   for buf_temp_goods
     3125     , buf_rep_temp_goods
     3126     , buf_goods
     3127   on error undo, return error
     3128   :
     3129   if session :set-wait-state( "compiler" ) then.
     3130       run impgds-write-log in this-procedure (
     3131             input 0
     3132           , input fill( "=", 80 )
     3133       ).
     3134       run impgds-write-log in this-procedure (
     3135             input 1
     3136           , input substitute( "Чтение товаров из файла &1"
     3137                           , "good.txt" )
     3138       ).
     3139       input stream impgds-in from "good.txt" .
     3140       import-goods-string:
     3141       repeat
     3142       :
     3143           assign
     3144               v-gds-code       = "":U
     3145               v-artic          = "":U
     3146               v-prod-code      = "":U
     3147               v-grp-code       = "":U
     3148               v-unit-base      = "":U
     3149               v-unit-base-type = "":U
     3150               v-gds-type       = "":U
     3151               v-gds-name       = "":U
     3152               v-engl-name      = "":U
     3153               v-VAT-pc         = "":U
     3154               v-SLT-pc         = "":U
     3155               v-deadline       = "":U
     3156           .
     3157           import stream impgds-in
     3158               v-gds-code
     3159               v-artic
     3160               v-prod-code
     3161               v-grp-code
     3162               v-unit-base
     3163               v-unit-base-type
     3164               v-gds-type
     3165               v-gds-name
     3166               v-engl-name
     3167               v-VAT-pc
     3168               v-SLT-pc
     3169               v-deadline
     3170           .
     3171           if v-gds-code = "":U
     3172           then do:
     3173               next import-goods-string.
     3174           end.
     3175           run check-gds in this-procedure (
     3176                 input v-gds-code
     3177               , input v-gds-name
     3178               , output v-have-error
     3179               , output v-error-message
     3180           ).
     3181           if v-have-error = yes
     3182           then do:
     3183               run impgds-write-error in this-procedure (
     3184                     input 1
     3185                   , input substitute( "Не прошла проверка товара с кодом &1. &2" , v-gds-code, v-error-message )
     3186               ).
     3187               run impgds-write-log in this-procedure (
     3188                     input 1
     3189                   , input substitute( "*** Ошибка: Не прошла проверка товара с кодом &1. &2" , v-gds-code, v-error-message )
     3190               ).
     3191               run impgds-write-edt in this-procedure (
     3192                     input ed-log :handle in frame Dialog-Frame
     3193                   , input 1
     3194                   , input substitute( "Ошибка товара &1. &2" , v-gds-code, v-error-message )
     3195               ).
     3196               assign
     3197                   v-impgds-error-records  = v-impgds-error-records + 1
     3198               .
     3199           end.
     3200           if v-artic = "":U
     3201           then do:
     3202               assign
     3203                   v-artic = v-gds-code
     3204               .
     3205           end.
     3206           run impgds-assign-integer in this-procedure (
     3207                 input ed-log :handle in frame Dialog-Frame
     3208               , input v-impgds-last-rec-no + 1
     3209               , input "gds-code":U
     3210               , input v-gds-code
     3211               , output v-temp-integer
     3212           ).
     3213           find first buf_temp_goods no-lock
     3214                where buf_temp_goods.gds-code = v-temp-integer
     3215           no-error.
     3216           if available buf_temp_goods
     3217           then do:
     3218               run impgds-write-log in this-procedure (
     3219                     input 1
     3220                   , input substitute( "Повторное чтение товара с кодом &1", v-temp-integer )
     3221               ).
     3222               assign
     3223                   v-impgds-repeated-records = v-impgds-repeated-records + 1
     3224               .
     3225               next import-goods-string.
     3226           end.
     3227           find first buf_goods no-lock
     3228                where buf_goods.gds-code = v-temp-integer
     3229           no-error.
     3230           if available buf_goods
     3231           then do:
     3232               run impgds-write-log in this-procedure (
     3233                     input 1
     3234                   , input substitute( "Чтение товара с кодом, который есть у товара в БД: &1"
     3235                           , v-temp-integer )
     3236               ).
     3237               assign
     3238                   v-impgds-existed-records  = v-impgds-existed-records + 1
     3239               .
     3240               next import-goods-string.
     3241           end.
     3242           create buf_temp_goods.
     3243           assign
     3244               v-impgds-last-rec-no    = v-impgds-last-rec-no + 1
     3245           .
     3246           assign
     3247               buf_temp_goods.rec-no           = v-impgds-last-rec-no
     3248               buf_temp_goods.gds-code         = v-temp-integer
     3249               buf_temp_goods.artic            = v-artic
     3250           .
     3251           run impgds-assign-integer in this-procedure (
     3252                 input ed-log :handle in frame Dialog-Frame
     3253               , input v-impgds-last-rec-no + 1
     3254               , input "prod-code":U
     3255               , input v-prod-code
     3256               , output buf_temp_goods.prod-code
     3257           ).
     3258           run impgds-assign-integer in this-procedure (
     3259                 input ed-log :handle in frame Dialog-Frame
     3260               , input v-impgds-last-rec-no + 1
     3261               , input "grp-code":U
     3262               , input v-grp-code
     3263               , output buf_temp_goods.grp-code
     3264           ).
     3265           assign
     3266               buf_temp_goods.unit-base        = v-unit-base
     3267               buf_temp_goods.unit-base-type   = v-unit-base-type
     3268               buf_temp_goods.gds-type         = v-gds-type
     3269               buf_temp_goods.gds-name         = v-gds-name
     3270               buf_temp_goods.engl-name        = v-engl-name
     3271           .
     3272           run impgds-assign-decimal in this-procedure (
     3273                 input ed-log :handle in frame Dialog-Frame
     3274               , input v-impgds-last-rec-no
     3275               , input "VAT-pc":U
     3276               , input v-VAT-pc
     3277               , output buf_temp_goods.VAT-pc
     3278           ).
     3279           run impgds-assign-decimal in this-procedure (
     3280                 input ed-log :handle in frame Dialog-Frame
     3281               , input v-impgds-last-rec-no
     3282               , input "SLT-pc":U
     3283               , input v-SLT-pc
     3284               , output buf_temp_goods.SLT-pc
     3285           ).
     3286           run impgds-assign-integer in this-procedure (
     3287                 input ed-log :handle in frame Dialog-Frame
     3288               , input v-impgds-last-rec-no
     3289               , input "deadline":U
     3290               , input v-deadline
     3291               , output buf_temp_goods.deadline
     3292           ).
     3293           run impgds-write-cnt in this-procedure (
     3294                 input p-cnt-handle
     3295               , input substitute( "Считан товар: &1 &2", buf_temp_goods.gds-code, buf_temp_goods.gds-name )
     3296           ).
     3297       end.
     3298       input stream impgds-in close.
     3299   if session :set-wait-state( "" ) then.
     3300   end.
     3301   END PROCEDURE.
     3302   PROCEDURE read-tax-in-base :
     3303       define variable v-tax-value    as decimal      no-undo.
     3304       define buffer buf_tax-rate-value    for ub.tax-rate-value.
     3305       define buffer buf_temp_tax          for temp_tax.
     3306   do
     3307   for buf_tax-rate-value
     3308     , buf_temp_tax
     3309   on error undo, return error
     3310   :
     3311       for each buf_temp_tax
     3312       :
     3313           delete buf_temp_tax.
     3314       end.
     3315       tax-rate-value-string:
     3316       for each buf_tax-rate-value
     3317          where buf_tax-rate-value.tax-code = integer( '1':U )
     3318       :
     3319           if buf_tax-rate-value.status_ <> 'тек':U
     3320           then do:
     3321               if v-impgds-last-rate-code < buf_tax-rate-value.rate-code
     3322               then do:
     3323                   assign
     3324                       v-impgds-last-rate-code = buf_tax-rate-value.rate-code
     3325                   .
     3326               end.
     3327               next tax-rate-value-string.
     3328           end.
     3329   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3330   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     3331     (input  recid(buf_tax-rate-value)
     3332     ,input  buf_tax-rate-value.tax-code
     3333     ,input  buf_tax-rate-value.rate-code
     3334     ,input  ?
     3335     ,input  0
     3336     ,input  ''
     3337     ,input  0
     3338     ,output v-tax-value
     3339     )  .
     3340           find first buf_temp_tax
     3341                where buf_temp_tax.tax-code            = buf_tax-rate-value.tax-code
     3342                  and buf_temp_tax.rate-code           = buf_tax-rate-value.rate-code
     3343                  and buf_tax-rate-value.rate-value    = v-tax-value
     3344           no-error.
     3345           if not available buf_temp_tax
     3346           then do:
     3347               create buf_temp_tax.
     3348               assign
     3349                   buf_temp_tax.tax-code       = buf_tax-rate-value.tax-code
     3350                   buf_temp_tax.rate-code      = buf_tax-rate-value.rate-code
     3351                   buf_temp_tax.rate-value     = v-tax-value
     3352               .
     3353               if v-impgds-last-rate-code < buf_tax-rate-value.rate-code
     3354               then do:
     3355                   assign
     3356                       v-impgds-last-rate-code = buf_tax-rate-value.rate-code
     3357                   .
     3358               end.
     3359           end.
     3360       end.
     3361       for each buf_tax-rate-value
     3362          where buf_tax-rate-value.tax-code = integer( '2':U )
     3363       :
     3364   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3365   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     3366     (input  recid(buf_tax-rate-value)
     3367     ,input  buf_tax-rate-value.tax-code
     3368     ,input  buf_tax-rate-value.rate-code
     3369     ,input  ?
     3370     ,input  0
     3371     ,input  ''
     3372     ,input  0
     3373     ,output v-tax-value
     3374     )  .
     3375           find first buf_temp_tax
     3376                where buf_temp_tax.tax-code            = buf_tax-rate-value.tax-code
     3377                  and buf_temp_tax.rate-code           = buf_tax-rate-value.rate-code
     3378                  and buf_tax-rate-value.rate-value    = v-tax-value
     3379           no-error.
     3380           if not available buf_temp_tax
     3381           then do:
     3382               create buf_temp_tax.
     3383               assign
     3384                   buf_temp_tax.tax-code       = buf_tax-rate-value.tax-code
     3385                   buf_temp_tax.rate-code      = buf_tax-rate-value.rate-code
     3386                   buf_temp_tax.rate-value     = v-tax-value
     3387               .
     3388           end.
     3389       end.
     3390   end.
     3391   END PROCEDURE.
