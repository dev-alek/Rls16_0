      351   define variable v-impgds-last-rec-no        as integer      no-undo.
      352   define variable v-impgds-repeated-records   as integer      no-undo.
      353   define variable v-impgds-existed-records    as integer      no-undo.
      354   define variable v-impgds-error-records      as integer      no-undo.
      355   define stream impgds-in.
      356   define stream impgds-err.
      357   define stream impgds-log.
      358   procedure impgds-write-log :
      359   define input parameter p-tab-position   as integer          no-undo.
      360   define input parameter p-log-text       as character        no-undo.
      361   do
      362   on error undo, return error
      363   :
      364       put stream impgds-log unformatted
      365           skip
      366       .
      367       if p-tab-position <> 0
      368       then do:
      369           put stream impgds-log unformatted
      370               cur-time-string-sec()
      371           .
      372           put stream impgds-log unformatted
      373               space( p-tab-position * 4 )
      374           .
      375       end.
      376       put stream impgds-log unformatted
      377           p-log-text
      378       .
      379   end.
      380   end procedure.
      381   procedure impgds-write-error :
      382   define input parameter p-tab-position   as integer          no-undo.
      383   define input parameter p-err-text       as character        no-undo.
      384   do
      385   on error undo, return error
      386   :
      387       output stream impgds-err to "impgds.err" append .
      388       put stream impgds-err unformatted
      389           chr(10)
      390       .
      391       if p-tab-position <> 0
      392       then do:
      393           put stream impgds-err unformatted
      394               cur-time-string-sec()
      395           .
      396           put stream impgds-err unformatted
      397               space( p-tab-position * 4 )
      398           .
      399       end.
      400       put stream impgds-err unformatted
      401           p-err-text
      402       .
      403       output stream impgds-err close.
      404   end.
      405   end procedure.
      406   procedure impgds-write-edt :
      407   define input parameter p-edt-handle     as handle           no-undo.
      408   define input parameter p-log-level      as integer          no-undo.
      409   define input parameter p-output-string  as character        no-undo.
      410   do
      411   on error undo, return error
      412   :
      413       if valid-handle ( p-edt-handle )
      414       then do:
      415           p-edt-handle :move-to-eof().
      416           p-edt-handle :insert-string(
      417               if( p-log-level = 0
      418                   or p-output-string = "&DLine"
      419                   or p-output-string = "&Line" )
      420               then ""
      421               else cur-time-string-sec() + " " ).
      422           p-edt-handle :insert-string(
      423               if p-output-string = "&Line"
      424               then fill( "-", 80 )
      425               else if p-output-string = "&DLine"
      426                    then fill( "=", 80 )
      427                    else fill( " ", p-log-level ) + p-output-string ).
      428           p-edt-handle :insert-string( chr(10) ).
      429       end.
      430       process events.
      431   end.
      432   end procedure.
      433   procedure impgds-write-cnt :
      434   define input parameter p-cnt-handle     as handle           no-undo.
      435   define input parameter p-output-string  as character        no-undo.
      436   do
      437   on error undo, return error
      438   :
      439       if valid-handle( p-cnt-handle )
      440       then do:
      441           assign p-cnt-handle :screen-value = p-output-string.
      442       end.
      443       process events.
      444   end.
      445   end procedure.
      446   procedure impgds-assign-integer :
      447   define input parameter p-log-handle         as handle           no-undo.
      448   define input parameter p-file-line-num      as integer          no-undo.
      449   define input parameter p-field-name         as character        no-undo.
      450   define input parameter p-input-string       as character        no-undo.
      451   define output parameter p-output-integer    as integer          no-undo.
      452   do
      453   on error undo, return error
      454   :
      455       assign
      456           p-output-integer = integer( p-input-string )
      457       no-error.
      458       if error-status :error
      459       then do:
      460           run impgds-write-error in this-procedure (
      461                 input 1
      462               , input substitute( "Ошибка преобразования поля в десятичный тип. Строка &1. Поле &2. Значение '&3'"
      463                                   , p-file-line-num
      464                                   , p-field-name
      465                                   , p-input-string
      466                                 )
      467           ).
      468           run impgds-write-log in this-procedure (
      469                 input 1
      470               , input substitute( "Ошибка преобразования поля в десятичный тип. Строка &1. Поле &2. Значение '&3'"
      471                                   , p-file-line-num
      472                                   , p-field-name
      473                                   , p-input-string
      474                                 )
      475           ).
      476           run impgds-write-edt in this-procedure (
      477                 input p-log-handle
      478               , input 0
      479               , input substitute( "Ошибка преобразования поля в десятичный тип. Строка &1. Поле &2. Значение '&3'"
      480                                   , p-file-line-num
      481                                   , p-field-name
      482                                   , p-input-string
      483                                 )
      484           ).
      485           undo, return error.
      486       end.
      487   end.
      488   end procedure.
      489   procedure impgds-assign-decimal :
      490   define input parameter p-log-handle         as handle           no-undo.
      491   define input parameter p-file-line-num      as integer          no-undo.
      492   define input parameter p-field-name         as character        no-undo.
      493   define input parameter p-input-string       as character        no-undo.
      494   define output parameter p-output-decimal    as decimal          no-undo.
      495   do
      496   on error undo, return error
      497   :
      498       assign
      499           p-output-decimal = decimal( p-input-string )
      500       no-error.
