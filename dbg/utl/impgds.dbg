        1   define input parameter parparentproc    as handle           no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Импорт карточек товаров".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure cur-time :
       70      define output parameter p-today as date      no-undo .
       71      define output parameter p-time  as integer   no-undo .
       72     do
       73     on error undo, return error
       74     :
       75       define variable v-date1 as date      no-undo .
       76       define variable v-date2 as date      no-undo .
       77       define variable v-time  as integer   no-undo .
       78       assign
       79         v-date1 = today
       80         v-time  = time
       81         v-date2 = today
       82       .
       83       if v-date1 <> v-date2
       84       then do:
       85         assign
       86           v-date1 = today
       87           v-time  = v-time
       88         .
       89       end.
       90       assign
       91         p-today = v-date1
       92         p-time  = v-time
       93       .
       94     end.
       95   end.
       96   function cur-time-date returns character
       97   :
       98     return string(today, '99/99/9999':U) .
       99   end.
      100   function cur-time-mjd returns decimal
      101   :
      102     define variable v-date as date      no-undo .
      103     define variable v-time as integer   no-undo .
      104     run cur-time in this-procedure
      105       (output v-date
      106       ,output v-time
      107       ) .
      108     return integer(v-date) - 2400002 + (v-time / 86400) .
      109   end.
      110   function cur-time-get-ending-index returns integer
      111   (input p-number as integer
      112   )
      113   :
      114     if p-number < 0
      115     or p-number = ?
      116     then do:
      117       return 1 .
      118     end.
      119     define variable v-rest as integer   no-undo .
      120     assign
      121       p-number = p-number modulo 100
      122     .
      123     if p-number < 20
      124     then do:
      125       assign
      126         v-rest = p-number
      127       .
      128     end.
      129     else do:
      130       assign
      131         v-rest = p-number modulo 10
      132       .
      133     end.
      134     case v-rest :
      135       when 1
      136       then do:
      137         return 2 .
      138       end.
      139       when 2 or
      140       when 3 or
      141       when 4
      142       then do:
      143         return 3 .
      144       end.
      145       otherwise do:
      146         return 1 .
      147       end.
      148     end case .
      149   end.
      150   procedure cur-time-mjd-to-date :
      151      define input  parameter i-mjd-diff as decimal no-undo.
      152      define output parameter o-Date     as date    no-undo.
      153      define output parameter o-Time     as integer no-undo.
      154      define variable v-day-number as integer   no-undo .
      155      if    i-mjd-diff < 0
      156         or i-mjd-diff = ?
      157      then do:
      158         return "?" .
      159      end.
      160      assign
      161         v-day-number = truncate(i-mjd-diff,0).
      162         o-Date = date(v-day-number + 2400002).
      163         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      164     .
      165   end.
      166   function cur-time-mjd-to-string returns character
      167   (input p-mjd-diff as decimal
      168   )
      169   :
      170     define variable v-day-number as integer   no-undo .
      171     define variable v-seconds    as integer   no-undo .
      172     define variable v-hour       as integer   no-undo .
      173     define variable v-min        as integer   no-undo .
      174     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      175     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      176     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      177     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      178     if p-mjd-diff < 0
      179     or p-mjd-diff = ?
      180     then do:
      181       return "?" .
      182     end.
      183     assign
      184       v-day-number = integer(truncate(p-mjd-diff,0))
      185       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187     if v-seconds > 86400
      188     then do:
      189       assign
      190         v-seconds = 86400 - 1
      191       .
      192     end.
      193     if v-seconds < 0
      194     then do:
      195       assign
      196         v-seconds = 0
      197       .
      198     end.
      199     assign
      200       v-hour = truncate(v-seconds / 3600, 0)
      201     .
      202     assign
      203       v-seconds = v-seconds modulo 3600
      204     .
      205     assign
      206       v-min = truncate(v-seconds / 60, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 60
      210     .
      211     return
      212         (if v-day-number <> 0
      213           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      214           else ""
      215         )
      216       + (if v-day-number <> 0 or v-hour <> 0
      217           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      221           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      222           else ""
      223         )
      224       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      225       .
      226   end.
      227   function cur-time-string returns character
      228   :
      229     define variable v-date as date      no-undo .
      230     define variable v-time as integer   no-undo .
      231     run cur-time in this-procedure
      232       (output v-date
      233       ,output v-time
      234       ) .
      235     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      236   end.
      237   function cur-time-string-sec returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      246   end.
      247   function cur-time-custom  returns character
      248   (input p-prefix as character
      249   ,input p-date-format as character
      250   ,input p-delimiter as character
      251   ,input p-time-format as character
      252   ,input p-suffix as character
      253   )
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return
      262       p-prefix
      263       + string(v-date, p-date-format)
      264       + p-delimiter
      265       + string(v-time, p-time-format)
      266       + p-suffix
      267       .
      268   end.
      269   function cur-time-print  returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-datetime returns datetime
      280   :
      281     define variable v-char as character no-undo .
      282     define variable v-datetime as datetime no-undo .
      283     v-char = cur-time-string().
      284     v-datetime = datetime(v-char).
      285     return  v-datetime.
      286   end.
      287   function cur-time-string-msec returns character
      288   :
      289     define variable v-date as datetime  no-undo .
      290     v-date = now.
      291     return string(v-date) .
      292   end.
      293   define variable vss-include-info1 as character format "X(65)" no-undo
      294   initial "@(#)$Workfile$ $Revision$".
      295   define temp-table temp_goods no-undo
      296       field rec-no            as integer
      297       field gds-code          as integer
      298       field artic             as character
      299       field prod-code         as integer
      300       field grp-code          as integer
      301       field unit-base         as character
      302       field unit-base-type    as character
      303       field gds-type          as character
      304       field gds-name          as character
      305       field engl-name         as character
      306       field VAT-pc            as decimal
      307       field SLT-pc            as decimal
      308       field deadline          as integer
      309       index pi is primary unique rec-no
      310       index gc gds-code
      311   .
