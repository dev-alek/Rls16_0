      321       field node-code     as integer
      322       field upper-code    as integer
      323       field node-name     as character
      324       index pi is primary unique rec-no
      325       index nc node-code
      326       index uc upper-code
      327   .
      328   define temp-table temp_clients no-undo
      329       field rec-no    as integer
      330       field obj-code  as integer
      331       field obj-name  as character
      332       field address   as character
      333       field phone     as character
      334       field fax       as character
      335       field director  as character
      336       field email     as character
      337       field okonh     as character
      338       field okpo      as character
      339       field inn       as character
      340       field kpp       as character
      341       field ps        as character
      342       index pi is primary unique rec-no
