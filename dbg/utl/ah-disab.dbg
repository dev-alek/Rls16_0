      791   procedure thobjs :
      792      define input        parameter parparentproc     as widget-handle no-undo .
      793      define input        parameter i-bttns           as character     no-undo .
      794      define input        parameter i-list-mode       as character     no-undo.
      795      define input        parameter i-obj-type        as character     no-undo.
      796      define input        parameter i-db-num          as integer       no-undo.
      797      define input        parameter i-host-code       as integer       no-undo.
      798      define input-output parameter p-rid-list        as character     no-undo .
      799   run ref/thobjs.p
      800           ( input parparentproc
      801            ,input  this-procedure :handle
      802           , input i-bttns
      803           , input i-list-mode
      804           , input i-obj-type
      805           , input i-db-num
      806           , input i-host-code
      807           , input-output p-rid-list ) no-error .
