      361   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define variable v-waitfram-action01         as character   no-undo .
      363   define variable v-waitfram-action02         as character   no-undo .
      364   define variable v-waitfram-action03         as character   no-undo .
      365   define variable mWaitFramTextBeg            as character   no-undo.
      366   define variable mWaitFramTextEnd            as character   no-undo.
      367   define variable mWaitFramView               as logical     no-undo.
      368   define variable mWaitProcEvent              as logical     no-undo init yes.
      369   define variable mWaitFramInterval           as integer     no-undo init 1 .
      370   define variable mWaitFramStop               as logical     no-undo.
      371   define variable mWaitFramStopUser           as logical     no-undo.
      372   define variable mWaitFramStopTimeOut        as logical     no-undo.
      373   define variable mWaitFramStartProc          as datetime-tz no-undo.
      374   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      375   define button B-WaitFramStop auto-end-key
      376        label "Стоп"
      377        size 10 by 1 tooltip "Остоновить процесс".
      378   define button B-viewProcInfo
      379        label "Информация"
      380        size 15 by 1 tooltip "Информация о процесс".
      381   define frame waitfram
      382     v-waitfram-action01 format "x(72)" no-label skip
      383     v-waitfram-action02 format "x(72)" no-label skip
      384     v-waitfram-action03 format "x(72)" no-label skip
      385     B-viewProcInfo
      386     B-WaitFramStop at row 4 col 30
      387     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      388     .
      389   define new global shared variable mBatchMode as logical no-undo init ?.
      390   define variable mFramBachModHandle as handle no-undo.
      391   mFramBachModHandle = frame waitfram:handle.
      392   define variable mFameOldVis as logical no-undo.
      393   define variable mVisCUrentVin as logical no-undo.
      394   if session:batch-mode
      395   then
      396      mBatchMode = yes.
      397   if mBatchMode = ? then do:
      398     mVisCUrentVin = current-window:visible.
      399     mFameOldVis = mFramBachModHandle:visible.
      400     mFramBachModHandle:visible  = yes.
      401     mBatchMode = mFramBachModHandle:visible ne yes.
      402     mFramBachModHandle:visible = mFameOldVis.
      403     current-window:visible = mVisCUrentVin.
      404   end.
      405    if  log-manager:logfile-name ne ?
      406     then DO:
      407         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      408         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      409         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      410     end.
      411   on choose of B-WaitFramStop in frame waitfram
      412   do:
      413     mWaitFramStop = yes.
      414     mWaitFramStopUser = yes.
      415   end.
      416   function waitfram-check-timeout returns logical():
      417      define variable vtime as int64 no-undo.
      418      if mWaitFramStopTimeOut
      419      then
      420         return yes.
      421      vtime = ( now - mWaitFramStartProc ) / 1000 .
      422      if     mWaitFramTimeOut ne ?
      423         and mWaitFramTimeOut ne 0
      424         and mWaitFramTimeOut lt vtime
      425      then do:
      426         mWaitFramStopTimeOut = yes.
      427      end.
      428      return mWaitFramStopTimeOut.
      429   end.
      430   procedure waitfram-hide :
      431     if not session:batch-mode
      432     then do
      433     on error undo, return error return-value
      434     :
      435       pause 0 before-hide .
      436       if not mBatchMode then
      437         hide frame waitfram .
      438     if     not mWaitFramView
      439        and mWaitProcEvent
      440     then
      441       process events .
      442     end.
      443   end procedure.
      444   procedure waitfram-show :
      445     define input  parameter p-message as character no-undo .
      446     define variable v-left-margin as integer   no-undo .
      447     if not session:batch-mode
      448     then do
      449     on error undo, return error return-value
      450     :
      451       if length(p-message) <= 70 then do:
      452         assign
      453           v-left-margin = integer((70 - length(p-message)) / 2)
      454         .
      455         assign
      456           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      457         .
      458         assign
      459           v-waitfram-action01 = " "
      460           v-waitfram-action02 = " "
      461                                    + fill(" ", v-left-margin)
      462                                    + p-message
      463           v-waitfram-action03 = " "
      464         .
      465       end.
      466       else do:
      467         define variable vRindex1 as integer no-undo.
      468         define variable vRindex2 as integer no-undo.
      469         vRindex1 = r-index(p-message," ",70).
      470         if vRindex1 = 0
      471         then
      472            vRindex1 = 70.
      473         if length(p-message)  <= vRindex1 + 70 then do:
      474           assign
      475             v-waitfram-action01 = " "
      476             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      477             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      478           .
      479         end.
      480         else do:
      481           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      482           if vRindex2 <= vRindex1
      483           then
      484              vRindex2 = vRindex1 + 70.
      485           assign
      486             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      487             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      488             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      489           .
      490         end.
      491       end.
      492       B-viewProcInfo:visible   in frame waitfram = no.
      493       B-viewProcInfo:sensitive in frame waitfram = no.
      494       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      495       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      496       if  (   mWaitFramView
      497          or  mWaitProcEvent)
      498          and not mBatchMode
      499       then
      500          display
      501             v-waitfram-action01 skip
      502             v-waitfram-action02 skip
      503             v-waitfram-action03 skip
      504          with frame waitfram .
      505       if     mWaitFramView
      506          then do:
      507             if     mWaitFramInterval ne ?
      508                and not mBatchMode
      509             then
      510                wait-for go of frame waitfram pause mWaitFramInterval.
      511          end.
      512          else
      513             if     mWaitProcEvent
      514                and not mBatchMode
      515             then
      516                process events .
      517     end.
      518   end procedure.
      519      procedure waitfram-show-this:
      520         define input  parameter iInterval as int64 no-undo.
      521         define variable vtime as int64 no-undo.
      522         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      523         mWaitFramInterval = iInterval.
      524         run waitfram-show (substitute("&1&2 &3&4" ,
      525                                       mWaitFramTextBeg ,
      526                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      527                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      528                                       mWaitFramTextEnd
      529                                      )
      530                           ).
      531      end.
      532      procedure WaitFramRunPause:
      533         define input  parameter iInterval as dec no-undo.
      534         define variable vStart  as datetime-tz no-undo.
      535         define variable vend    as datetime-tz no-undo.
      536         define variable vint as int64 no-undo.
      537         define variable vOk as logical no-undo.
      538         vStart = now.
      539         vend   = vStart.
      540         publish "WaitFramPause" (iInterval,output vOk).
      541         vend   =  now.
      542         vint = vend - vStart.
      543         vint = iInterval - vint / 1000.
      544         if     not mWaitFramStop
      545            and (   vint > 0
      546                 or (    not vOk
      547                     and iInterval eq ?
      548                     )
      549                 )
      550         then
      551            run waitfram-show-this (iInterval).
      552         vend   =  now.
      553         vint = vend - vStart.
      554         vint = iInterval - vint / 1000.
      555         if     not mWaitFramStop
      556            and vint > 0
      557         then do:
      558            run gbl/pause.p (vint * 1000).
      559         end.
      560         if iInterval ne ?
      561         then
      562            publish "WaitFramStop".
      563         waitfram-check-timeout().
      564      end.
      565      procedure WaitFramWaitFor:
      566         define input  parameter iInterval as dec no-undo.
      567         assign
      568            mWaitFramStartProc   = now
      569            mWaitFramStopUser    = no
      570            mWaitFramStopTimeOut = no
      571         .
      572         block-wait:
      573         do while not mWaitFramStop:
      574            run WaitFramRunPause (iInterval).
      575            if  waitfram-check-timeout()
      576            then do:
      577               leave block-wait.
      578            end.
      579         end.
      580         run waitfram-hide.
      581      end.
      582   procedure waitfram-join :
      583     define input  parameter p-line-1  as character no-undo .
      584     define input  parameter p-line-2  as character no-undo .
      585     define input  parameter p-line-3  as character no-undo .
      586     define output parameter p-message as character no-undo .
      587     do
      588     on error undo, return error return-value
      589     :
      590       assign
      591         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      592                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      593                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      594       .
      595     end.
      596   end procedure.
      597   function waitfram-join-function returns character
      598     (input p-line-1 as character
      599     ,input p-line-2 as character
      600     ,input p-line-3 as character
      601     ).
      602     define variable v-message as character no-undo .
      603     run waitfram-join in this-procedure
      604       (input  p-line-1
      605       ,input  p-line-2
      606       ,input  p-line-3
      607       ,output v-message
      608       ) .
      609     return v-message .
      610   end function .
      611   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612     define variable v-cntxt-db-num        as integer   no-undo .
      613     define variable v-cntxt-userid        as character no-undo .
      614     define variable v-cntxt-level         as character no-undo .
      615     define variable v-cntxt-host-code-obj as integer   no-undo .
      616     define variable v-cntxt-obj-type      as character no-undo .
      617     define variable v-cntxt-obj-code      as integer   no-undo .
      618     define variable v-cntxt-db-num-obj    as integer   no-undo .
      619     define variable v-cntxt-is-admin      as logical   no-undo .
      620   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      621   define temp-table userobjs_temp-user-obj no-undo
      622     field obj-type as character
      623     field obj-code as integer
      624     index xpk is primary unique obj-type obj-code
      625     .
      626   procedure userobjs_clear :
      627     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      628     do
      629     on error undo, return error return-value
      630     :
      631       for each buf_userobjs_temp-user-obj
      632       on error undo, return error return-value
      633       :
      634         delete buf_userobjs_temp-user-obj .
      635       end.
      636     end.
      637   end .
      638   procedure userobjs_object-count :
      639     define output parameter p-total-count as integer   no-undo .
      640     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      641     do
      642     on error undo, return error return-value
      643     :
      644       assign
      645         p-total-count = 0
      646       .
      647       for each buf_userobjs_temp-user-obj
      648       on error undo, return error return-value
      649       :
      650         assign
      651           p-total-count = p-total-count + 1
      652         .
      653       end.
      654     end.
      655   end.
      656   procedure userobjs_append :
      657      define input  parameter p-obj-type as character no-undo .
      658      define input  parameter p-obj-code as integer   no-undo .
      659     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      660     do
      661     on error undo, return error return-value
      662     :
      663       find first buf_userobjs_temp-user-obj
      664         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      665           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      666         no-error .
      667       if not available buf_userobjs_temp-user-obj
      668       then do:
      669         create buf_userobjs_temp-user-obj .
      670         assign
      671           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      672           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      673         .
      674       end.
      675     end.
      676   end.
      677   procedure userobjs_object-exist :
      678     define output parameter p-object-exist as logical   no-undo .
      679     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      680     do
      681     on error undo, return error return-value
      682     :
      683       find first buf_userobjs_temp-user-obj
      684         no-error .
      685       if not available buf_userobjs_temp-user-obj
      686       then do:
      687         assign
      688           p-object-exist = false
      689         .
      690       end.
      691       else do:
      692         assign
      693           p-object-exist = true
      694         .
      695       end.
      696     end.
      697   end.
      698   procedure userobjs_transfer :
      699     define input  parameter p-callback-handle as handle no-undo .
      700     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      701     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      702     do
      703     on error undo, return error return-value
      704     :
      705       if valid-handle(p-callback-handle) <> true
      706       then do:
      707         message
      708           vss-workfile vss-revision vss-description skip
      709           "Ошибка задания входных параметров" skip
      710           "Неизвестный указатель на процедуру" skip
      711           view-as alert-box error .
      712         undo, return error return-value .
      713       end.
      714       if p-callback-handle :get-signature("userobjs_append") = ""
      715       then do:
      716         message
      717           vss-workfile vss-revision vss-description skip
      718           "Ошибка задания входных параметров" skip
      719           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      720                     ,p-callback-handle :file-name
      721                     ) skip
      722           view-as alert-box error .
      723         undo, return error return-value .
      724       end.
      725       for each buf_userobjs_temp-user-obj
      726       on error undo, return error return-value
      727       :
      728         run userobjs_append in p-callback-handle
      729           (input  buf_userobjs_temp-user-obj.obj-type
      730           ,input  buf_userobjs_temp-user-obj.obj-code
      731           ) .
      732       end.
      733     end.
      734   end procedure.
      735   procedure userobjs_select-one :
      736      define input  parameter parparentproc     as widget-handle no-undo .
