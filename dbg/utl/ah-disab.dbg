      809   define buffer buf_sys-ctrl for ub.sys-ctrl .
      810   define buffer buf_db for ub.db .
      811   define buffer buf_clients  for ub.clients .
      812   define variable v-num                        as integer   no-undo .
      813   define variable v-action-disable             as logical   no-undo .
      814   define variable v-action-label               as character no-undo .
      815   define variable v-db-list                    as character no-undo .
      816   define variable v-db-label-list              as character no-undo .
      817   define variable v-archive-type               as character no-undo .
      818   define variable v-entity-type                as character no-undo .
      819   define variable v-ind                        as integer   no-undo .
      820   define variable v-num-entries-select-db-list as integer   no-undo .
      821   define variable v-select-db-list             as character no-undo .
      822   define variable v-all-object                 as logical   no-undo .
      823   define variable v-ok                         as logical   no-undo .
      824   do
      825   on error undo, return error
      826   :
      827   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828     run mainmenu_getcntxt in parparentproc
      829       (output v-cntxt-db-num
      830       ,output v-cntxt-userid
      831       ,output v-cntxt-level
      832       ,output v-cntxt-host-code-obj
      833       ,output v-cntxt-obj-type
      834       ,output v-cntxt-obj-code
      835       ,output v-cntxt-db-num-obj
      836       ,output v-cntxt-is-admin
      837       ) .
      838     run gbl/d-askw.w
      839       (input "Вопрос 1 из 4"
      840       ,input "Выберите действие" + chr(10)
      841       ,input "|^"
      842       ,input "Запретить расчет архивов|Разрешить расчет архивов|Отмена"
      843       ,input "|"
      844           + "|"
      845           + ""
      846       ,input 1
      847       ,input 3
      848       ,output v-num
      849       ).
      850     case v-num :
      851       when 1
      852       then do:
      853         assign
      854           v-action-disable = true
      855           v-action-label   = "Запретить расчет складского архива"
      856         .
      857       end.
      858       when 2
      859       then do:
      860         assign
      861           v-action-disable = false
      862           v-action-label   = "Разрешить расчет складского архива"
      863         .
      864       end.
      865       when 3
      866       then do:
      867         return .
      868       end.
      869       otherwise do:
      870         message
      871           vss-workfile vss-revision vss-description skip
      872           "Неизвестное значение ответа на вопрос 1" skip
      873           "" v-num skip
      874           view-as alert-box error .
      875         undo, return error return-value .
      876       end.
      877     end case .
      878     run gbl/d-askw.w
      879       (input "Вопрос 2 из 4"
      880       ,input v-action-label
      881       ,input "|^"
      882       ,input "Складской архив по товарам" + '|':u
      883         + "Складской архив по поставщикам" + '|':u
      884         + "Складской архив по типам приобретения" + '|':u
      885         + "Отказ"
      886       ,input '|':u
      887         + '|':u
      888         + '|':u
      889         + ''
      890       ,input 1
      891       ,input 4
      892       ,output v-num
      893       ).
      894     case v-num :
      895       when 1
      896       then do:
      897         assign
      898           v-archive-type = 'arh':U
      899           v-action-label = v-action-label + " по товарам"
      900         .
      901       end.
      902       when 2
      903       then do:
      904         assign
      905           v-archive-type = 'ahsp':U
      906           v-action-label = v-action-label + " по поставщикам"
      907         .
      908       end.
      909       when 3
      910       then do:
      911         assign
      912           v-archive-type = 'aht':U
      913           v-action-label = v-action-label + " по типам приобретения"
      914         .
      915       end.
      916       when 4
      917       then do:
      918         return .
      919       end.
      920       otherwise do:
      921         message
      922           vss-workfile vss-revision vss-description skip
      923           "Неизвестное значение ответа на вопрос 2" skip
      924           "" v-num skip
      925           view-as alert-box error .
      926         undo, return error .
      927       end.
      928     end case .
      929     run gbl/d-askw.w
      930       (input "Вопрос 3 из 4"
      931       ,input v-action-label + chr(10)
      932              + "Выберите способ разрешения/запрещения"
      933       ,input "|^"
      934       ,input "Для базы данных|Для объектов|Отмена"
      935       ,input "|"
      936           + "|"
      937           + ""
      938       ,input 1
      939       ,input 3
      940       ,output v-num
      941       ).
      942     case v-num :
      943       when 1
      944       then do:
      945         assign
      946           v-entity-type  = 'db':u
      947         .
      948       end.
      949       when 2
      950       then do:
      951         assign
      952           v-entity-type  = 'object':u
      953         .
      954       end.
      955       when 3
      956       then do:
      957         return .
      958       end.
      959       otherwise do:
      960         message
      961           vss-workfile vss-revision vss-description skip
      962           "Неизвестное значение ответа на вопрос 3" skip
      963           "" v-num skip
      964           view-as alert-box error .
      965         undo, return error .
      966       end.
      967     end.
      968     find first buf_sys-ctrl .
      969     case v-entity-type
      970     :
      971       when 'db':u
      972       then do:
      973         run gbl/d-askw.w
      974           (input "Вопрос 4 из 4"
      975           ,input v-action-label + chr(10)
      976           ,input "|^"
      977           ,input "Все базы данных^confirm|Выбрать базу данных|Отмена"
      978           ,input "|"
      979               + "|"
      980               + ""
      981           ,input 1
      982           ,input 3
      983           ,output v-num
      984           ).
      985         assign
      986           v-db-list       = ''
      987           v-db-label-list = ''
      988         .
      989         for each buf_db no-lock
      990           where (buf_sys-ctrl.db-num = 0
      991                 or
      992                 buf_db.db-num = buf_sys-ctrl.db-num
      993                 )
      994           by buf_db.db-num
      995         :
      996           assign
      997             v-db-list       = v-db-list
      998                             + (if v-db-list <> '':u then chr(44) else '':u )
      999                             + string(buf_db.db-num)
     1000             v-db-label-list = v-db-label-list
     1001                             + (if v-db-label-list <> '':u then chr(44) else '':u )
     1002                             + buf_db.db-name
     1003           .
     1004         end.
     1005         case v-num :
     1006           when 1
     1007           then do:
     1008             assign
     1009               v-select-db-list = v-db-list
     1010               v-action-label   = v-action-label
     1011                                + " по всем базам данных"
     1012             .
     1013           end.
     1014           when 2
     1015           then do:
     1016             run gbl/d-list.w
     1017               (input  "b-sel,b-mark":u
     1018               ,input  "Выберите базы данных"
     1019               ,input  v-db-list
     1020               ,input  v-db-label-list
     1021               ,input  chr(44)
     1022               ,input  "":u
     1023               ,output v-select-db-list
     1024               ).
     1025             if v-select-db-list = '':u
     1026             then do:
     1027               message
     1028                 "База данных не выбрана" skip
     1029                 view-as alert-box information .
     1030               return .
     1031             end.
     1032             assign
     1033               v-action-label   = v-action-label
     1034                                + " по списку баз данных "
     1035                                + v-select-db-list
     1036             .
     1037           end.
     1038           otherwise do:
     1039             return .
     1040           end.
     1041         end.
     1042         message
     1043           "Внимание!" skip
     1044           "Это последний вопрос перед выполнением операции над архивами" skip
     1045           "" skip
     1046           "" v-action-label skip
     1047           "" skip
     1048           "Продолжить?" skip
     1049           view-as alert-box question buttons yes-no update v-ok .
     1050         if v-ok <> true
     1051         then do:
     1052           return .
     1053         end.
     1054         assign
     1055           v-num-entries-select-db-list = num-entries(v-select-db-list, chr(44))
     1056         .
     1057         do v-ind = 1 to v-num-entries-select-db-list
     1058         :
     1059           run waitfram-show in this-procedure
     1060             (input substitute("Обработка базы данных &1"
     1061                              ,integer(entry(v-ind, v-select-db-list, chr(44)))
     1062                              )
     1063             ) .
     1064           run trg/ahdbdis.p
     1065             (input v-archive-type
     1066             ,input integer(entry(v-ind, v-select-db-list, chr(44)))
     1067             ,input v-action-disable
     1068             ) .
     1069         end.
     1070       end.
     1071       when 'object':u
     1072       then do:
     1073         run gbl/d-askw.w
     1074           (input "Вопрос 4 из 4"
     1075           ,input v-action-label + chr(10)
     1076           ,input "|^"
     1077           ,input "Все объекты^confirm|Выбрать объекты|Отмена"
     1078           ,input "|"
     1079               + "|"
     1080               + ""
     1081           ,input 1
     1082           ,input 3
     1083           ,output v-num
     1084           ).
     1085         case v-num :
     1086           when 1
     1087           then do:
     1088             assign
     1089               v-all-object   = true
     1090               v-action-label = v-action-label
     1091                              + " по всем объектам"
     1092             .
     1093           end.
     1094           when 2
     1095           then do:
     1096             define variable v-user-select as logical   no-undo .
     1097   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   run userobjs_select-many in this-procedure
     1099     (input  parparentproc
     1100     ,input  v-cntxt-db-num
     1101     ,input  v-cntxt-userid
     1102     ,input  v-cntxt-host-code-obj
     1103     ,input  v-cntxt-obj-type
     1104     ,input  v-cntxt-obj-code
     1105     ,output v-user-select
     1106     )  .
     1107             if v-user-select <> true
     1108             then do:
     1109               message
     1110                 "Объект не выбран"
     1111                 view-as alert-box information .
     1112               return .
     1113             end.
     1114             assign
     1115               v-all-object   = false
     1116               v-action-label = v-action-label
     1117                              + " по списку объектов"
     1118             .
     1119           end.
     1120           otherwise do:
     1121             return .
     1122           end.
     1123         end.
     1124         message
     1125           "Внимание!" skip
     1126           "Это последний вопрос перед выполнением операции над архивами" skip
     1127           "" skip
     1128           "" v-action-label skip
     1129           "" skip
     1130           "Продолжить?" skip
     1131           view-as alert-box question buttons yes-no update v-ok .
     1132         if v-ok <> true
     1133         then do:
     1134           return .
     1135         end.
     1136         if v-all-object = true
     1137         then do:
     1138           for each buf_db
     1139             where (buf_sys-ctrl.db-num = 0
     1140                   or
     1141                   buf_db.db-num = buf_sys-ctrl.db-num
     1142                   )
     1143           ,each buf_clients no-lock
     1144             where buf_clients.db-num = buf_db.db-num
     1145           on error undo, return error
     1146           :
     1147             run waitfram-show in this-procedure
     1148               (input substitute("Обработка объекта &1 &2"
     1149                                 ,buf_clients.obj-type
     1150                                 ,buf_clients.obj-code
     1151                                 )
     1152               ) .
     1153             run trg/ahobjdis.p
     1154               (input  v-archive-type
     1155               ,input  buf_clients.obj-type
     1156               ,input  buf_clients.obj-code
     1157               ,input  v-action-disable
     1158               ) .
     1159           end.
     1160         end.
     1161         else do:
     1162           define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1163           for each buf_userobjs_temp-user-obj
     1164           on error undo, return error return-value
     1165           :
     1166             find first buf_clients no-lock
     1167               where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     1168                 and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     1169               .
     1170             if buf_sys-ctrl.db-num = 0
     1171             or buf_clients.db-num = buf_sys-ctrl.db-num
     1172             then do:
     1173               run waitfram-show in this-procedure
     1174                 (input substitute("Обработка объекта &1 &2"
     1175                                   ,buf_clients.obj-type
     1176                                   ,buf_clients.obj-code
     1177                                   )
     1178                 ) .
     1179               run trg/ahobjdis.p
     1180                 (input  v-archive-type
     1181                 ,input  buf_clients.obj-type
     1182                 ,input  buf_clients.obj-code
     1183                 ,input  v-action-disable
     1184                 ) .
     1185             end.
     1186           end.
     1187         end.
     1188       end.
     1189       otherwise do:
     1190         message
     1191           vss-workfile vss-revision vss-description skip
     1192           "Внутренняя ошибка" skip
     1193           "Неизвестное значение переменной v-entity-type" skip
     1194           "" v-entity-type skip
     1195           view-as alert-box error .
     1196         undo, return error return-value .
     1197       end.
     1198     end case .
     1199     run waitfram-hide in this-procedure .
     1200     message
     1201       "Утилита успешно завершила работу" skip
     1202       view-as alert-box information .
     1203   end.
