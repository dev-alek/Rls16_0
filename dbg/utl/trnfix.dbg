        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER  v-doc-code  like ub.trn-doc.doc-code no-undo.
        3   DEFINE OUTPUT PARAMETER i-err-count as   integer             no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: trnfix.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/trnfix.p $":U .
        9   define variable vss-description as character no-undo init "Утилита проверки и коррекции документа".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define temp-table temp-doc-pl no-undo
       81     field pl-code          like ub.doc-pl.pl-code
       82     field cli-qnty         like ub.doc-pl.cli-qnty
       83     field cli-doc-qnty     like ub.doc-pl.cli-doc-qnty
       84     field cli-fact-qnty    like ub.doc-pl.cli-fact-qnty
       85     field doc-qnty         like ub.doc-pl.doc-qnty
       86     field fact-qnty        like ub.doc-pl.fact-qnty
       87     field db-cli-qnty      like ub.doc-pl.cli-qnty
       88     field db-cli-doc-qnty  like ub.doc-pl.cli-doc-qnty
       89     field db-cli-fact-qnty like ub.doc-pl.cli-fact-qnty
       90     field db-doc-qnty      like ub.doc-pl.doc-qnty
       91     field db-fact-qnty     like ub.doc-pl.fact-qnty
       92     index xpk is primary pl-code
       93   .
       94   procedure temp-doc-pl-clear :
       95     define buffer buf_temp-doc-pl for temp-doc-pl .
       96     do
       97     on error undo, return error return-value
       98     :
       99       for each buf_temp-doc-pl
      100       on error undo, return error return-value
      101       :
      102         delete buf_temp-doc-pl .
      103       end.
      104     end.
      105   end procedure.
      106   procedure temp-doc-pl-init :
      107     define input parameter p-out-code like ub.doc-pl.out-code no-undo .
      108     define input parameter p-gds-code like ub.doc-pl.gds-code no-undo .
      109     define buffer buf_doc-pl for ub.doc-pl .
      110     define buffer buf_temp-doc-pl for temp-doc-pl .
      111     do
      112     on error undo, return error return-value
      113     :
      114       for each buf_doc-pl share-lock
      115         where buf_doc-pl.out-code = p-out-code
      116           and buf_doc-pl.gds-code = p-gds-code
      117       on error undo, return error return-value
      118       :
      119         create buf_temp-doc-pl .
      120         assign
      121           buf_temp-doc-pl.pl-code          = buf_doc-pl.pl-code
      122           buf_temp-doc-pl.db-cli-qnty      = buf_doc-pl.cli-qnty
      123           buf_temp-doc-pl.db-cli-doc-qnty  = buf_doc-pl.cli-doc-qnty
      124           buf_temp-doc-pl.db-cli-fact-qnty = buf_doc-pl.cli-fact-qnty
      125           buf_temp-doc-pl.db-doc-qnty      = buf_doc-pl.doc-qnty
      126           buf_temp-doc-pl.db-fact-qnty     = buf_doc-pl.fact-qnty
      127         .
      128       end.
      129     end.
      130   end procedure.
      131   procedure temp-doc-pl-accum :
      132     define input parameter p-pl-code       like ub.doc-pl.pl-code      no-undo .
      133     define input parameter p-cli-qnty      like ub.doc-pl.cli-qnty     no-undo .
      134     define input parameter p-doc-qnty      like ub.doc-pl.doc-qnty     no-undo .
      135     define input parameter p-fact-qnty     like ub.doc-pl.fact-qnty    no-undo .
      136     define input parameter p-cli-base-rate like ub.parts.cli-base-rate no-undo .
      137     define buffer buf_temp-doc-pl for temp-doc-pl .
      138     do
      139     on error undo, return error return-value
      140     :
      141       find first buf_temp-doc-pl
      142         where buf_temp-doc-pl.pl-code = p-pl-code
      143         no-error .
      144       if not available buf_temp-doc-pl then do:
      145         create buf_temp-doc-pl .
      146         assign
      147           buf_temp-doc-pl.pl-code = p-pl-code
      148         .
      149       end.
      150       assign
      151         buf_temp-doc-pl.cli-qnty      = buf_temp-doc-pl.cli-qnty      + p-cli-qnty
      152         buf_temp-doc-pl.cli-doc-qnty  = buf_temp-doc-pl.cli-doc-qnty  + p-doc-qnty  / p-cli-base-rate
      153         buf_temp-doc-pl.cli-fact-qnty = buf_temp-doc-pl.cli-fact-qnty + p-fact-qnty / p-cli-base-rate
      154         buf_temp-doc-pl.doc-qnty      = buf_temp-doc-pl.doc-qnty      + p-doc-qnty
      155         buf_temp-doc-pl.fact-qnty     = buf_temp-doc-pl.fact-qnty     + p-fact-qnty
      156       .
      157     end.
      158   end procedure.
      159   define variable v-root-node   as integer   no-undo .
      160   define variable l-empty-scale as logical   no-undo .
      161   find first ub.trn-doc no-lock
      162     where ub.trn-doc.doc-code = v-doc-code
      163     no-error .
      164   if not available ub.trn-doc then do:
      165     message
      166       "Документ не найден" v-doc-code skip
      167       view-as alert-box error .
      168     undo, return error .
      169   end.
      170   if (ub.trn-doc.status_ = 'накл':U and ub.trn-doc.flag_  = no)
      171   or (ub.trn-doc.status_ = 'касс':U)
      172   then do:
      173   end.
      174   else do:
      175     define variable lok as logical no-undo .
      176     message
      177       "Статус документа" ub.trn-doc.status_ ub.trn-doc.flag_ skip
      178       "Вы хотите ввести системный пароль и продолжить работу программы" skip
      179       "Коррекция признаков возможна только для товаров, имеющих пустую шкалу" skip
      180       view-as alert-box question buttons yes-no update lok.
      181     if lok <> true then do:
      182       undo, return error .
      183     end.
      184     else do:
      185       run gbl/authoriz.p
      186         (input  "checkdoc.p:fix"
      187         ,output lok
      188         ) .
      189       if lok <> true then do:
      190         message
      191           "Пароль введен неправильно." skip
      192           "Исправление документа невозможно" skip
      193           view-as alert-box information .
      194         undo, return error .
      195       end.
      196     end.
      197   end.
      198   for each doc-line
      199     where doc-line.doc-code = v-doc-code
      200   on error undo, return error
      201   :
      202     find first ub.goods no-lock
      203       where ub.goods.artic     = ub.doc-line.artic
      204         and ub.goods.prod-type = ub.doc-line.prod-type
      205         and ub.goods.prod-code = ub.doc-line.prod-code
      206       .
      207   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      208   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      209     (input  doc-line.artic
      210     ,input  doc-line.prod-type
      211     ,input  doc-line.prod-code
      212     ,output v-root-node
      213     )  .
      214   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      215     (input  v-root-node
      216     ,input  'empty-scale=request'
      217     ,output l-empty-scale
      218     )  .
      219     if l-empty-scale = false then do:
      220       next .
      221     end.
      222     if ub.goods.gds-type = 'т':U then do:
      223       define variable l-reserv-pl-code         as logical no-undo .
      224   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      226     (input  ub.doc-line.obj-type
      227     ,input  ub.doc-line.obj-code
      228     ,input  ub.doc-line.artic
      229     ,input  ub.doc-line.prod-type
      230     ,input  ub.doc-line.prod-code
      231     ,input  'place-rsrv=request'
      232     ,output l-reserv-pl-code
      233     ) no-error .
      234       if error-status :error then do:
      235         message
      236           vss-workfile vss-revision vss-description skip
      237           "Документ" ub.doc-line.doc-code skip
      238           "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
      239           "Ошибка при определении признака товара на объекте" skip
      240           error-status :get-message(1) skip
      241           return-value skip
      242           view-as alert-box error .
      243         undo, return error .
      244       end.
      245       if l-reserv-pl-code then do:
      246         run temp-doc-pl-clear in this-procedure .
      247         run temp-doc-pl-init  in this-procedure
      248           (input ub.doc-line.doc-code
      249           ,input ub.goods.gds-code
      250           ).
      251       end.
      252       define variable v-qnty      as decimal no-undo .
      253       define variable v-fact-qnty as decimal no-undo .
      254       assign
      255         v-qnty      = 0
      256         v-fact-qnty = 0
      257       .
      258       for each parts no-lock
      259         where parts.out-code  = doc-line.doc-code
      260           and parts.obj-type  = trn-doc.obj-type
      261           and parts.obj-code  = trn-doc.obj-code
      262           and parts.artic     = doc-line.artic
      263           and parts.prod-type = doc-line.prod-type
      264           and parts.prod-code = doc-line.prod-code
      265       :
      266         assign
      267           v-qnty      = v-qnty      + parts.qnty
      268           v-fact-qnty = v-fact-qnty + parts.fact-qnty
      269         .
      270         run temp-doc-pl-accum in this-procedure
      271           (input ub.parts.pl-code
      272           ,input ub.parts.cli-qnty
      273           ,input ub.parts.qnty
      274           ,input ub.parts.fact-qnty
      275           ,input ub.parts.cli-base-rate
      276           ) .
      277       end.
      278       if l-reserv-pl-code then do:
      279         for each temp-doc-pl
      280           where temp-doc-pl.db-doc-qnty  <> temp-doc-pl.doc-qnty
      281              or temp-doc-pl.db-fact-qnty <> temp-doc-pl.fact-qnty
      282         on error undo, return error
      283         :
      284           find first ub.doc-pl exclusive-lock
      285             where ub.doc-pl.obj-type = ub.doc-line.obj-type
      286               and ub.doc-pl.obj-code = ub.doc-line.obj-code
      287               and ub.doc-pl.pl-code  = temp-doc-pl.pl-code
      288               and ub.doc-pl.out-code = ub.doc-line.doc-code
      289               and ub.doc-pl.gds-code = ub.goods.gds-code
      290             no-error .
      291           if  temp-doc-pl.doc-qnty  = 0
      292           and temp-doc-pl.fact-qnty = 0
      293           then do:
      294             if available ub.doc-pl then do:
      295               output to checkdoc.txt append .
      296               export "fix_doc-pl_delete" temp-doc-pl.doc-qnty temp-doc-pl.fact-qnty .
      297               export "doc-pl_old_qnty" ub.doc-pl.doc-qnty ub.doc-pl.fact-qnty .
      298               export ub.doc-pl .
      299               output close .
      300               assign
      301                 i-err-count = i-err-count + 1
      302               .
      303               delete ub.doc-pl .
      304             end.
      305           end.
      306           else do:
      307             if not available ub.doc-pl then do:
      308               create ub.doc-pl .
      309               assign
      310                 ub.doc-pl.obj-type = ub.doc-line.obj-type
      311                 ub.doc-pl.obj-code = ub.doc-line.obj-code
      312                 ub.doc-pl.pl-code  = temp-doc-pl.pl-code
      313                 ub.doc-pl.out-code = ub.doc-line.doc-code
      314                 ub.doc-pl.gds-code = ub.goods.gds-code
      315               .
      316             end.
      317             output to checkdoc.txt append .
      318             export "fix_doc-pl_new_qnty" temp-doc-pl.doc-qnty temp-doc-pl.fact-qnty .
      319             export "doc-pl_old_qnty" ub.doc-pl.doc-qnty ub.doc-pl.fact-qnty .
      320             export ub.doc-pl .
      321             output close .
      322             assign
      323               i-err-count = i-err-count + 1
      324             .
      325             assign
      326               ub.doc-pl.doc-qnty  = temp-doc-pl.doc-qnty
      327               ub.doc-pl.fact-qnty = temp-doc-pl.fact-qnty
      328             .
      329           end.
      330         end.
      331       end.
      332       if doc-line.doc-qnty  <> v-qnty
      333       or doc-line.fact-qnty <> v-fact-qnty
      334       then do:
      335         output to checkdoc.txt append .
      336         export "fix_doc-line_new_qnty " v-qnty v-fact-qnty .
      337         export "doc-line_old_qnty" doc-line.doc-qnty doc-line.fact-qnty .
      338         export doc-line .
      339         output close .
      340         output to badartic.txt append .
      341         export
      342           doc-line.obj-type doc-line.obj-code
      343           doc-line.artic doc-line.prod-type doc-line.prod-code
      344           .
      345         output close .
      346         assign
      347           i-err-count = i-err-count + 1
      348         .
      349         assign
      350           doc-line.doc-qnty  = v-qnty
      351           doc-line.fact-qnty = v-fact-qnty
      352         .
      353       end.
      354       find first gds-dtl
      355         where gds-dtl.doc-code  = doc-line.doc-code
      356           and gds-dtl.artic     = doc-line.artic
      357           and gds-dtl.prod-type = doc-line.prod-type
      358           and gds-dtl.prod-code = doc-line.prod-code
      359           and gds-dtl.prt-code  = v-root-node
      360         no-error .
      361       if available gds-dtl then do:
      362         if gds-dtl.doc-qnty  <> v-qnty
      363         or gds-dtl.fact-qnty <> v-fact-qnty
      364         then do:
      365           output to checkdoc.txt append .
      366           export "fix_gds-dtl_new_qnty " v-qnty v-fact-qnty .
      367           export "gds-dtl_old_qnty " gds-dtl.doc-qnty gds-dtl.fact-qnty .
      368           export gds-dtl .
      369           output close .
      370           output to badartic.txt append .
      371           export
      372             doc-line.obj-type doc-line.obj-code
      373             doc-line.artic doc-line.prod-type doc-line.prod-code
      374             .
      375           output close .
      376           assign
      377             i-err-count = i-err-count + 1
      378           .
      379           assign
      380             gds-dtl.doc-qnty  = v-qnty
      381             gds-dtl.fact-qnty = v-fact-qnty
      382           .
      383         end.
      384       end.
      385     end.
      386   end.
