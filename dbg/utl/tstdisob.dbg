     1024           "Тип"   FORMAT "X(8)"   space(1)
     1025           "Сумма оплаченного" format "X(15)" space(1)
     1026           "% скидки" format "X(9)" space(1)
     1027           "Верный %" format "X(9)" space(1)
     1028           SKIP
     1029           .
     1030      END.
     1031       WHEN 8 then do:
     1032          OUTPUT stream test to test1dc.txt.
     1033          PUT STREAM test UNFORMATTED
     1034          "ДИСКОНТНЫЕ КАРТЫ " f-d-card " Фильтр - " filter-name
     1035          SKIP
     1036          "НОМЕР КАРТЫ" format "X(16)" space(1)
     1037          "М-н"    format "X(5)" space(1)
     1038          "Кол. чеков в БД" format "X(19)" space(1)
     1039          "Кол. чеков объект" format "X(19)" space(1)
     1040          "Сумма нетто руб чеков" format "X(19)" space(1)
     1041          "Сумма нетто руб объект" format "X(19)" space(1)
     1042          SKIP
     1043          .
     1044       END.
     1045       WHEN 99 THEN DO:
     1046           OUTPUT stream test to test99dc.txt.
     1047           PUT STREAM test UNFORMATTED
     1048           "ДИСКОНТНЫЕ КАРТЫ " f-d-card " Фильтр - " filter-name
     1049           SKIP
     1050           FILL(chr(32), 20)
     1051           "НОМЕР КАРТЫ" format "X(16)" space(1)
     1052           "Тип"   FORMAT "X(8)"   space(1)
     1053           "Кол-во чеков в БД"   format "X(19)" space(1)
     1054           "Кол-во чеков расчет" format "X(19)" space(1)
     1055           SKIP
     1056           .
     1057      END.
     1058   END CASE.
     1059     if f-d-card = "all" or f-d-card = "ALL" THEN DO:
     1060      run utl/tstdisoq.p (
     1061                    input parparentproc
     1062                   ,input "ALL":U
     1063                   ,input test-number
     1064                   ,input f-d-card
     1065                   ,input (if RS-dctype = 'фирма':U then v-cntxt-host-code-obj else 0)
     1066                   ,INPUT rs-view-mode
     1067                   ,input v-cntxt-obj-type
     1068                   ,input v-cntxt-obj-code
     1069                    )
     1070     .
     1071     END.
     1072     ELSE DO:
     1073      run utl/tstdisoq.p (
     1074                    input parparentproc
     1075                   ,input "":U
     1076                   ,input test-number
     1077                   ,input f-d-card
     1078                   ,input (if RS-dctype = 'фирма':U then v-cntxt-host-code-obj else 0)
     1079                   ,INPUT rs-view-mode
     1080                   ,input "":U
     1081                   ,input 0
     1082                    )
     1083     .
     1084     END.
     1085   run waitfram-hide in this-procedure .
     1086   OUTPUT STREAM test close.
     1087   END PROCEDURE.
