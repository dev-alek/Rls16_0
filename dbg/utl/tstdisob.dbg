      625   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      626   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      627   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      628   on help of frame Dialog-Frame
      629   do:
      630     run gbl/app_help.p
      631       (input this-procedure :file-name
      632       ,input ''
      633       ,input ?
      634       ) no-error.
      635     if error-status :error then do:
      636       message
      637         "Ошибка при вызове помощи"
      638         error-status :get-message(1)
      639         view-as alert-box .
      640     end.
      641   end.
      642   run minbtn-set in this-procedure .
      643   on choose of b-help in frame Dialog-Frame
      644   do:
      645     apply "help":u to frame Dialog-Frame .
      646   end.
      647   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648   procedure minbtn-set :
      649       do
      650           on error undo, return error return-value
      651           :
      652           define variable ii              as integer       no-undo .
      653           define variable fh              as widget-handle no-undo .
      654           define variable hh              as widget-handle no-undo .
      655           define variable v-h             as handle        extent 4 no-undo .
      656           define variable v-name-button   as character     no-undo .
      657           define variable v-help-old-x    as decimal       no-undo .
      658           define variable v-help-old-y    as decimal       no-undo .
      659           define variable v-help-old-size as decimal       no-undo .
      660           define variable v-frame-width   as decimal       no-undo .
      661           define variable jj              as integer       no-undo .
      662           do
      663               on error undo, return error
      664               :
      665               assign
      666                   v-frame-width = frame Dialog-Frame:width - 0.3
      667                   fh            = frame Dialog-Frame:first-child
      668                   hh            = fh:first-child
      669                   ii            = 1
      670                   .
      671               do while valid-handle(hh):
      672                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      673                   do:
      674                       case lc(hh:name) :
      675                           when "b-help" then
      676                               do:
      677                                   hh:load-image-up("cmp/b-help.bmp":u) .
      678                                   hh:load-image-down("cmp/b-help.bmp":u) .
      679                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      680                                   hh:TOOLTIP = "Помощь" .
      681                                   v-help-old-x = hh:column .
      682                                   v-help-old-y = hh:row    .
      683                                   v-help-old-size = hh:width .
      684                                   hh:width-chars = 2.5 .
      685                               end.
      686                           when "b-print" then
      687                               do:
      688                                   hh:load-image("cmp/b-print.bmp":u) .
      689                                   hh:TOOLTIP = "Печать" .
      690                                   v-h[ii] = hh:handle .
      691                                   ii = ii + 1 .
      692                                   hh:width-chars = 3 .
      693                               end.
      694                           when "b-history" or
      695                           when "b-hist" then
      696                               do:
      697                                   hh:load-image("cmp/b-hist.bmp":u) .
      698                                   hh:TOOLTIP = "История" .
      699                                   v-h[ii] = hh:handle .
      700                                   ii = ii + 1 .
      701                                   hh:width-chars = 3 .
      702                               end.
      703                           when "b-sch" then
      704                               do:
      705                                   hh:load-image("cmp/b-sch.bmp":u) .
      706                                   hh:TOOLTIP = "Установка Фильтра" .
      707                                   v-h[ii] = hh:handle .
      708                                   ii = ii + 1 .
      709                                   hh:width-chars = 3 .
      710                               end.
      711                           when "b-hist-user" then
      712                               do:
      713                                   hh:load-image("cmp/b-hist.bmp":u) .
      714                                   hh:TOOLTIP = "История пользователя" .
      715                                   ii = ii + 1 .
      716                               end.
      717                       end case.
      718                   end.
      719                   hh = hh:next-sibling.
      720               end.
      721               b-help:column = v-frame-width - b-help:width-chars.
      722               jj = 0.
      723               repeat ii = 4 to 1 by -1 :
      724                   if valid-handle (v-h[ii] ) then
      725                   do:
      726                       jj  = jj + 1 .
      727                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      728                       v-h[ii]:row    = v-help-old-y .
      729                   end.
      730               end.
      731           end.
      732       end.
      733   end procedure.
      734   MAIN-BLOCK:
      735   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      736      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      737   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738     run mainmenu_getcntxt in parparentproc
      739       (output v-cntxt-db-num
      740       ,output v-cntxt-userid
      741       ,output v-cntxt-level
      742       ,output v-cntxt-host-code-obj
      743       ,output v-cntxt-obj-type
      744       ,output v-cntxt-obj-code
      745       ,output v-cntxt-db-num-obj
      746       ,output v-cntxt-is-admin
      747       ) .
      748     RS-dctype:RADIO-Buttons =  "Глобальные" + chr(44) +  'все':U + chr(44) +
      749                                "По фирме" + chr(44) + 'фирма':U
      750                                .
      751     rs-dctype = 'все':U.
      752     RUN enable_UI.
      753     ASSIGN
      754     f-mess = f-mess + chr(32) + v-cntxt-obj-type + STRING(v-cntxt-obj-code).
      755     DISPLAY
      756     f-mess
      757     WITH FRAME Dialog-Frame.
      758     WAIT-FOR GO OF FRAME Dialog-Frame.
      759   END.
      760   RUN disable_UI.
      761   PROCEDURE disable_UI :
      762     HIDE FRAME Dialog-Frame.
      763   END PROCEDURE.
      764   PROCEDURE enable_UI :
      765     DISPLAY Rs-dctype RS-view-mode F-d-card F-sch F-mess
      766         WITH FRAME Dialog-Frame.
      767     ENABLE B-exit B-Help Rs-dctype RS-view-mode F-d-card B-1 B-2 B-3 B-4 B-5 B-6
      768            B-7 B-8 B-99 F-sch F-mess
      769         WITH FRAME Dialog-Frame.
      770     VIEW FRAME Dialog-Frame.
      771   END PROCEDURE.
      772   PROCEDURE test0 :
      773     IF F-d-card <> "all" AND
      774     F-sch = "" then do:
      775       FIND FIRST ub.dis-card No-LOCK WHERE ub.dis-card.d-card = f-d-card No-ERROR.
      776       IF NOT AVAIL ub.dis-card then do:
      777           message "Не найдена карта с номером " f-d-card
      778           view-as alert-box ERROR.
      779           return no-apply.
      780       end.
      781       if RS-dctype = 'фирма':U AND ub.dis-card.emitent-host-code = 0 OR
      782          RS-dctype = 'все':U and ub.dis-card.emitent-host-code <> 0 then do:
      783          message "Дисконтная карта не "
      784          (if RS-dctype = 'все':U then " глобальна!" else " по фирме!")
      785          view-as alert-box ERROR.
      786          return no-apply.
      787       end.
      788       if dis-card.emitent-host-code > 0 and dis-card.emitent-host-code <> v-cntxt-host-code-obj then do:
      789           message "Дисконтная карта не принадлежит текущей фирме!"
      790           view-as alert-box ERROR.
      791           return no-apply.
      792       end.
      793     end.
      794   assign
      795   ff = 0
      796   gg = 0
      797   accum1 = 0
      798   accum2 = 0
