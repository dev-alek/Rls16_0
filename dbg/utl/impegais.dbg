     2956         where buf_rec-fld.rec-key = p-rec-key
     2957     on error undo, return error
     2958     :
     2959       case buf_rec-fld.fldName :
     2960         when "VOLF_ID":U        then do:
     2961           assign
     2962             v-volf_id = decimal( buf_rec-fld.fldValue )
     2963           no-error .
     2964         end.
     2965         when "VOLF_CODE":U      then do:
