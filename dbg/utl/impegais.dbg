     2968           .
     2969         end.
     2970         when "VOLF_VOLUME":U    then do:
     2971           assign
     2972             v-volf_volume = decimal( buf_rec-fld.fldValue )
     2973           no-error .
     2974         end.
     2975         when "VLF_DATE_BG_NW":U then do:
     2976           assign
     2977             v-vlf_date_bg_nw = get-date( buf_rec-fld.fldValue )
     2978           no-error .
     2979         end.
     2980         when "VLF_DATE_END_NW":U then do:
     2981           assign
     2982             v-vlf_date_end_nw = get-date( buf_rec-fld.fldValue )
     2983           no-error .
     2984         end.
     2985         when "VLF_DATE_NW":U    then do:
     2986           assign
     2987             v-vlf_date_nw = get-date( buf_rec-fld.fldValue )
     2988           no-error .
     2989         end.
     2990         when "VLF_AKTL":U       then do:
     2991           assign
     2992             v-vlf_aktl = decimal( buf_rec-fld.fldValue )
     2993           no-error .
     2994         end.
     2995       end case.
     2996     end.
     2997     if v-volf_id = ? then return.
     2998     find first tt-alc-volume
     2999       where tt-alc-volume.volf_id = v-volf_id
     3000     no-error .
     3001     if not available tt-alc-volume then do:
     3002       create tt-alc-volume.
     3003       assign
     3004         tt-alc-volume.volf_id         = v-volf_id
     3005         tt-alc-volume.volf_code       = v-volf_code
     3006         tt-alc-volume.volf_volume     = v-volf_volume
     3007         tt-alc-volume.vlf_date_bg_nw  = v-vlf_date_bg_nw
     3008         tt-alc-volume.vlf_date_end_nw = v-vlf_date_end_nw
     3009         tt-alc-volume.vlf_date_nw     = v-vlf_date_nw
     3010         tt-alc-volume.vlf_aktl        = v-vlf_aktl
     3011       .
     3012     end.
     3013   end.
     3014   end procedure.
     3015   procedure parse-territorys :
