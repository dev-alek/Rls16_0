      899   define variable vss-include-info5 as character format "X(65)" no-undo
      900   initial "@(#)$Workfile$ $Revision$".
      901   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      902   define stream stmXMLOut.
      903   define stream stmXMLLog.
      904   define stream strXMLIn.
      905   define temp-table temp_xmllib_rec-list no-undo
      906       field recName       as character
      907       field recLevel      as integer
      908       field recOpenLine   as integer
      909       field recCloseLine  as integer
      910       field closed        as logical
      911       index pi is primary unique
      912           recName
      913           recLevel
      914       index cl
      915           closed
      916   .
      917   define temp-table temp_xmllib_rec-fld-list no-undo
      918       field recName       as character
      919       field recLevel      as integer
      920       field fldName       as character
      921       field fldOpenLine   as integer
      922       field fldCloseLine  as integer
      923       field closed        as logical
      924       index pi is primary unique
      925           recName
      926           recLevel
      927           fldName
      928       index fn
      929           fldName
      930       index cl
      931           closed
      932   .
      933   define temp-table temp_xmllib_rec no-undo
      934       field rec-key       as integer
      935       field recLevel      as integer
      936       field recOpenLine   as integer
      937       field recCloseLine  as integer
      938       field recName       as character
      939       field closed        as logical
      940       index pi is primary unique
      941           rec-key
      942       index nm
      943           recName
      944           closed
      945           rec-key
      946       index cl
      947           closed
      948       index rlv
      949           recName
      950           recLevel
      951           closed
      952           rec-key
      953   .
      954   define temp-table temp_xmllib_rec-fld no-undo
      955       field fld-key       as integer
      956       field rec-key       as integer
      957       field fldOpenLine   as integer
      958       field fldCloseLine  as integer
      959       field fldName       as character
      960       field fldValue      as character
      961       field closed        as logical
      962       index pi is primary unique
      963           fld-key
      964       index nm
      965           rec-key
      966           fldName
      967           closed
      968           fld-key
      969       index cl
      970           closed
      971   .
      972   define variable v-xmllib-rec-key            as integer      no-undo .
      973   define variable v-xmllib-rec-fld-key        as integer      no-undo .
      974   define variable v-xmllib-dirname            as character    no-undo .
      975   define variable v-xmllib-filename           as character    no-undo .
      976   define variable v-xmllib-log-filename       as character    no-undo .
      977   define variable v-xmllib-log-handle         as handle       no-undo .
      978   define variable v-xmllib-log-proc-name      as character    no-undo .
      979   define variable v-xmllib-error-status       as logical      no-undo .
      980   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
      981   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
      982   define variable v-xmllib-codepage-convert   as logical      no-undo .
      983   define variable v-xmllib-codepage-source    as character    no-undo .
      984   define variable v-xmllib-codepage-target    as character    no-undo .
      985   procedure xmllib-clear-parse-data :
      986   do
      987   on error undo, return error
      988   :
      989       empty temp-table temp_xmllib_rec-list.
      990       empty temp-table temp_xmllib_rec-fld-list.
      991       empty temp-table temp_xmllib_rec.
      992       empty temp-table temp_xmllib_rec-fld.
      993   end.
      994   end procedure.
      995   procedure xmllib-add-rec-fld :
      996   define input parameter p-rec-name       as character        no-undo.
      997   define input parameter p-rec-fld-name   as character        no-undo.
      998       define buffer buf_rec-list        for temp_xmllib_rec-list.
      999       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1000   do
     1001   for buf_rec-list
     1002     , buf_rec-fld-list
     1003   on error undo, return error
     1004   :
     1005       find first buf_rec-list
     1006            where buf_rec-list.recName = p-rec-name
     1007       no-error.
     1008       if not available buf_rec-list
     1009       then do:
     1010           create buf_rec-list.
     1011           assign
     1012               buf_rec-list.recName        = p-rec-name
     1013               buf_rec-list.recOpenLine    = 0
     1014               buf_rec-list.recCloseLine   = 0
     1015               buf_rec-list.closed         = yes
     1016           .
     1017       end.
     1018       find first buf_rec-fld-list
     1019            where buf_rec-fld-list.recName = p-rec-name
     1020              and buf_rec-fld-list.fldName = p-rec-fld-name
     1021       no-error.
     1022       if not available buf_rec-fld-list
     1023       then do:
     1024           create buf_rec-fld-list.
     1025           assign
     1026               buf_rec-fld-list.recName        = p-rec-name
     1027               buf_rec-fld-list.fldName        = p-rec-fld-name
     1028               buf_rec-fld-list.fldOpenLine    = 0
     1029               buf_rec-fld-list.fldCloseLine   = 0
     1030               buf_rec-fld-list.closed         = yes
     1031           .
     1032       end.
     1033   end.
     1034   end procedure.
     1035   procedure xmllib-tag-open:
     1036   define input parameter v-tag-level  as integer      no-undo.
     1037   define input parameter v-tag-name   as character    no-undo.
     1038   define input parameter v-tag-value  as character    no-undo.
     1039   do
     1040   on error undo, return error
     1041   :
     1042       assign
     1043           v-tag-name = trim( v-tag-name )
     1044       .
     1045       put stream stmXMLOut unformatted
     1046           substitute( "&1&2<&3&4&5>"
     1047               , chr(10)
     1048               , fill(" ", 4 * v-tag-level)
     1049               , v-tag-name
     1050               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     1051               , v-tag-value
     1052           )
     1053       .
     1054   end.
     1055   end procedure.
     1056   procedure xmllib-tag-put:
     1057   define input parameter v-tag-level      as integer      no-undo.
     1058   define input parameter v-tag-name       as character    no-undo.
     1059   define input parameter v-tag-value      as character    no-undo.
     1060   define input parameter v-empty-mode     as integer      no-undo.
     1061   do
     1062   on error undo, return error
     1063   :
     1064       assign
     1065           v-tag-name = trim( v-tag-name )
     1066       .
     1067       if  v-empty-mode = 1
     1068       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     1069       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     1070       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     1071       then do:
     1072           run xmlchar-encode in this-procedure (
     1073                 input v-tag-value
     1074               , output v-tag-value
     1075           ).
     1076           put stream stmXMLOut unformatted
     1077               substitute( "&1&2<&3>&4</&3>"
     1078                   , chr(10)
     1079                   , fill(" ":U, 4 * v-tag-level)
     1080                   , v-tag-name
     1081                   , v-tag-value
     1082               )
     1083           .
     1084       end.
     1085   end.
     1086   end procedure.
     1087   procedure xmllib-tag-put-null :
     1088   define input parameter p-tag-level  as integer      no-undo.
     1089   define input parameter p-tag-name   as character    no-undo.
     1090   do
     1091   on error undo, return error
     1092   :
     1093       assign
     1094           p-tag-name = trim( p-tag-name )
     1095       .
     1096       put stream stmXMLOut unformatted
     1097           substitute( '&1&2<&3 nil="true" /&3>'
     1098               , chr(10)
     1099               , fill(" ":U, 4 * p-tag-level)
     1100               , p-tag-name
     1101           )
     1102       .
     1103   end.
     1104   end procedure.
     1105   procedure xmllib-tag-close:
     1106   define input parameter v-tag-level as integer      no-undo.
     1107   define input parameter v-tag-name  as character    no-undo.
     1108   do
     1109   on error undo, return error
     1110   :
     1111       assign
     1112           v-tag-name = trim( v-tag-name )
     1113       .
     1114       put stream stmXMLOut unformatted
     1115           substitute( "&1&2</&3>"
     1116               , chr(10)
     1117               , fill( " ":U, 4 * v-tag-level)
     1118               , v-tag-name
     1119           )
     1120       .
     1121   end.
     1122   end procedure.
     1123   procedure xmllib-write-log:
     1124   define input parameter v-filename   as character    no-undo.
     1125   define input parameter v-log-level  as integer      no-undo.
     1126   define input parameter v-out-string as character    no-undo.
     1127   do
     1128   on error undo, return error
     1129   :
     1130       output stream stmXMLLog to value( v-filename ) append.
     1131       put stream stmXMLLog unformatted
     1132           chr(10)
     1133       .
     1134       put stream stmXMLLog unformatted
     1135           ( if v-log-level = 0
     1136             or v-out-string = "&DLine":U
     1137             or v-out-string = "&Line":U
     1138             then "":U
     1139             else cur-time-string-sec() + " ":U )
     1140       .
     1141       put stream stmXMLLog unformatted
     1142           ( if v-out-string = "&Line":U
     1143             then fill( "-":U, 80 )
     1144             else if v-out-string = "&DLine":U
     1145                  then fill( "=":U, 80 )
     1146                  else v-out-string )
     1147       .
     1148       output stream stmXMLLog close.
     1149   end.
     1150   end procedure.
     1151   procedure xmllib-write-edt:
     1152   define input parameter v-editor-handle    as handle       no-undo.
     1153   define input parameter v-log-level        as integer      no-undo.
     1154   define input parameter v-out-string       as character    no-undo.
     1155   do
     1156   on error undo, return error
     1157   :
     1158       if valid-handle ( v-editor-handle )
     1159       then do:
     1160           v-editor-handle :move-to-eof().
     1161           v-editor-handle :insert-string( ( if v-log-level = 0
     1162                                             or v-out-string = "&DLine":U
     1163                                             or v-out-string = "&Line":U
     1164                                             then "":U
     1165                                             else cur-time-string-sec() + " ":U
     1166                                         ) ).
     1167           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1168                                             then fill( "-":U, 80 )
     1169                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1170                                             else fill( " ":U, v-log-level) + v-out-string
     1171                                         ) ).
     1172           v-editor-handle :insert-string( chr(10) ).
     1173       end.
     1174   end.
     1175   end procedure.
     1176   procedure xmllib-show-cnt:
     1177   define input parameter v-fillin-handle     as handle   no-undo.
     1178   do
     1179   on error undo, return error
     1180   :
     1181       if valid-handle( v-fillin-handle )
     1182       then do:
     1183           assign
     1184               v-fillin-handle :visible = true
     1185           .
     1186       end.
     1187   end.
     1188   end procedure.
     1189   procedure xmllib-hide-cnt:
     1190   define input parameter v-fillin-handle     as handle   no-undo.
     1191   do
     1192   on error undo, return error
     1193   :
     1194       if valid-handle( v-fillin-handle )
     1195       then do:
     1196           assign v-fillin-handle :visible = false.
     1197       end.
     1198   end.
     1199   end procedure.
     1200   procedure xmllib-write-cnt:
     1201   define input parameter v-fillin-handle    as handle       no-undo.
     1202   define input parameter v-fillin-string    as character    no-undo.
     1203   do
     1204   on error undo, return error
     1205   :
     1206       if valid-handle( v-fillin-handle )
     1207       then do:
     1208           assign
     1209               v-fillin-handle :SCREEN-value = v-fillin-string
     1210           .
     1211       end.
     1212   end.
     1213   end procedure.
     1214   procedure xmllib-write-header:
     1215   define input parameter p-first-file     as logical      no-undo.
     1216   define input parameter p-xml-file-name  as character    no-undo.
     1217   define input parameter p-list-file-name as character    no-undo.
     1218   define input parameter p-file-number    as integer      no-undo.
     1219   define input parameter p-have-prev      as logical      no-undo.
     1220   define input parameter p-prev-filename  as character    no-undo.
     1221   define input parameter p-parameter-list as character    no-undo.
     1222       define variable v-counter    as integer        no-undo.
     1223   do
     1224   on error undo, return error
     1225   :
     1226       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1227       put stream stmXMLOut unformatted
     1228           "<?xml version='1.0' encoding='windows-1251'?>"
     1229       .
     1230       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     1231       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     1232       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     1233       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     1234       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     1235       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     1236       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1237       :
     1238           run xmllib-tag-put(
     1239                 input 1
     1240               , input entry( 2 * v-counter, p-parameter-list )
     1241               , input entry( 2 * v-counter + 1, p-parameter-list )
     1242               , input 0
     1243           ).
     1244       end.
     1245       run xmllib-tag-close( input 0, input "THheader" ).
     1246       output stream stmXMLOut close.
     1247       if p-list-file-name <> "":U
     1248       then do:
     1249           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1250           if p-first-file = yes
     1251           then do:
     1252               put stream stmXMLOut unformatted
     1253                   "<?xml version='1.0' encoding='windows-1251'?>"
     1254               .
     1255               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     1256           end.
     1257           run xmllib-tag-open( input 1, input "THfile", input "" ).
     1258           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1259           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     1260           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     1261           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     1262           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1263           :
     1264               run xmllib-tag-put(
     1265                   input 2
     1266                   , input entry( 2 * v-counter, p-parameter-list )
     1267                   , input entry( 2 * v-counter + 1, p-parameter-list )
     1268                   , input 0
     1269               ).
     1270           end.
     1271           run xmllib-tag-close( input 1, input "THfile" ).
     1272           output stream stmXMLOut close.
     1273       end.
     1274   end.
     1275   end procedure.
     1276   procedure xmllib-write-footer:
     1277   define input parameter p-last-file      as logical      no-undo.
     1278   define input parameter p-xml-file-name  as character    no-undo.
     1279   define input parameter p-list-file-name as character    no-undo.
     1280   define input parameter p-have-next      as logical      no-undo.
     1281   define input parameter p-next-file-name as character    no-undo.
     1282       define variable v-error-num     as integer           no-undo.
     1283   do
     1284   on error undo, return error
     1285   :
     1286       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1287       if p-have-next = yes
     1288       then do:
     1289           run xmllib-tag-open( input 0, input "footer", "" ).
     1290           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1291           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1292           run xmllib-tag-close( input 0, input "footer" ).
     1293       end.
     1294       run xmllib-tag-close( input 0, input "root" ).
     1295       output stream stmXMLOut close.
     1296       run bge/os_copy.p (
     1297             input "M"
     1298           , input p-xml-file-name + "tmp"
     1299           , input p-xml-file-name + "xml"
     1300           , output v-error-num
     1301       ).
     1302       if p-last-file = yes
     1303       and p-list-file-name <> "":U
     1304       then do:
     1305           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1306               run xmllib-tag-close( input 0, input "OpenXML" ).
     1307           output stream stmXMLOut close.
     1308           run bge/os_copy.p (
     1309                 input "M"
     1310               , input p-list-file-name + "tmp"
     1311               , input p-list-file-name + "xml":U
     1312               , output v-error-num
     1313           ).
     1314       end.
     1315   end.
     1316   end procedure.
     1317   procedure xmllib-filename :
     1318   define input parameter p-subdir             as character        no-undo.
     1319   define input parameter p-prefix             as character    no-undo.
     1320   define output parameter p-xml-file-name     as character    no-undo.
     1321   define output parameter p-log-file-name     as character    no-undo.
     1322   define output parameter p-list-file-name    as character    no-undo.
     1323       define variable v-home-dir  as character    no-undo.
     1324       define variable v-error-num as integer      no-undo.
     1325   do
     1326   on error undo, return error
     1327   :
     1328       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     1329       if v-home-dir = ?
     1330       then do:
     1331           message
     1332             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1333             skip "Нет параметра oxml-dir в секции [OXML]."
     1334             skip(1)
     1335             skip "Обратитесь к администратору."
     1336           view-as alert-box error.
     1337           undo, return error .
     1338       end.
     1339       if p-subdir <> "":U
     1340       then do:
     1341           assign
     1342               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     1343           .
     1344       end.
     1345       run gbl/dir-cre.p (
     1346           input v-home-dir
     1347       ) no-error.
     1348       if error-status :error
     1349       then do:
     1350           message
     1351             skip "Неверно задан каталог экспорта в ini-файле."
     1352             skip "Не удаётся создать каталог, указанный параметром"
     1353             skip "oxml-dir в секции [OXML]."
     1354             skip(1)
     1355             skip "Обратитесь к администратору."
     1356           view-as alert-box error.
     1357           undo, return error .
     1358       end.
     1359       run bge/genfname.p (
     1360             input v-home-dir
     1361           , input p-prefix
     1362           , input ""
     1363           , input "xml"
     1364           , input "tmp"
     1365           , output p-xml-file-name
     1366       ).
     1367       assign
     1368           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1369           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1370           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1371       .
     1372   end.
     1373   end procedure.
     1374   procedure xmllib-check-file-size :
     1375   define input parameter p-out-filename   as character    no-undo.
     1376   define output parameter p-is-big        as logical      no-undo.
     1377       define variable v-current-position    as integer        no-undo.
     1378   do
     1379   on error undo, return error
     1380   :
     1381       assign
     1382           v-current-position = seek( stmXMLOut )
     1383       .
     1384       if v-current-position / 1024 / 1024  >= 100
     1385       then do:
     1386           assign
     1387               p-is-big = yes
     1388           .
     1389       end.
     1390   end.
     1391   end procedure.
     1392   procedure xmllib-parse-file :
     1393   define input parameter p-full-filename      as character        no-undo.
     1394       define variable v-num-dirs              as integer      no-undo .
     1395       define variable v-str                   as character    no-undo .
     1396       define variable v-str-count             as int64        no-undo .
     1397   do
     1398   on error undo, return error
     1399   :
     1400       assign
     1401           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1402           v-xmllib-error-status   = no
     1403       .
     1404       if v-num-dirs > 1
     1405       then do:
     1406           assign
     1407               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1408               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1409           .
     1410       end.
     1411       else do:
     1412           assign
     1413               v-xmllib-filename = p-full-filename
     1414               v-xmllib-dirname  = "":U
     1415           .
     1416       end.
     1417       if valid-handle(v-xmllib-prg-bar-handle)
     1418       then do:
     1419   if session :set-wait-state( "compiler" ) then.
     1420         input stream strXMLIn from value(p-full-filename) .
     1421         repeat
     1422         :
     1423           import stream strXMLIn unformatted v-str no-error .
     1424           assign
     1425             v-str-count = v-str-count + 1
     1426           .
     1427         end.
     1428         input stream strXMLIn close .
     1429   if session :set-wait-state( "" ) then.
     1430         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     1431         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     1432         run prg-bar_show in this-procedure .
     1433       end.
     1434       create sax-reader v-xmllib-sax-reader-handle.
     1435       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     1436       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     1437       if error-status :error
     1438       then do:
     1439           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1440                                                                       ,vss-workfile
     1441                                                                       ,vss-revision
     1442                                                                       ,vss-description
     1443                                                                       ,chr(10)
     1444                                                                       ,return-value
     1445                                                                       ,trim(error-status :get-message(1))
     1446                                                                       ,trim(error-status :get-message(2))
     1447                                                                       ,trim(error-status :get-message(3)))
     1448                                                     ).
     1449           undo, return error .
     1450       end.
     1451       if v-xmllib-error-status <> no
     1452       then do:
     1453           run xmllib-parse-error in this-procedure (
     1454               input "*** При обработке XML файла были ошибки."
     1455           ).
     1456           delete object v-xmllib-sax-reader-handle.
     1457       end.
     1458       delete object v-xmllib-sax-reader-handle.
     1459       if valid-handle(v-xmllib-prg-bar-handle)
     1460       then do:
     1461         run prg-bar_delete in this-procedure .
     1462       end.
     1463   end.
     1464   end procedure.
     1465   procedure xmllib-parse-progressive :
     1466   define input parameter p-full-filename      as character no-undo .
     1467   define input parameter p-pack-data          as memptr no-undo .
     1468   define input parameter p-parse-first        as logical no-undo .
     1469   define input parameter p-first-err          as logical no-undo .
     1470   define output parameter p-parse-status as integer no-undo .
     1471   define variable v-num-dirs              as integer no-undo .
     1472   define variable glog                    as logical no-undo .
     1473   define variable v-pack-size             as int64 no-undo .
     1474   do
     1475   on error undo, return error
     1476   :
     1477     if p-parse-first then do:
     1478       if valid-handle(v-xmllib-sax-reader-handle)
     1479       then do:
     1480       end.
     1481       assign
     1482           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1483           v-xmllib-error-status   = no
     1484       .
     1485       if v-num-dirs > 1
     1486       then do:
     1487           assign
     1488               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1489               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1490           .
     1491       end.
     1492       else do:
     1493           assign
     1494               v-xmllib-filename = p-full-filename
     1495               v-xmllib-dirname  = "":U
     1496           .
     1497       end.
     1498       create sax-reader v-xmllib-sax-reader-handle.
     1499       v-pack-size = get-size (p-pack-data) .
     1500       if v-pack-size > 0 then
     1501         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     1502       else
     1503         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     1504       if error-status :error
     1505       or not glog
     1506       then do:
     1507         delete object v-xmllib-sax-reader-handle.
     1508         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1509                                                                     ,vss-workfile
     1510                                                                     ,vss-revision
     1511                                                                     ,vss-description
     1512                                                                     ,chr(10)
     1513                                                                     ,return-value
     1514                                                                     ,trim(error-status :get-message(1))
     1515                                                                     ,trim(error-status :get-message(2))
     1516                                                                     ,trim(error-status :get-message(3)) )
     1517                                                   ).
     1518         undo, return error .
     1519       end.
     1520       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     1521     end.
     1522     else do:
     1523       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     1524     end.
     1525     if error-status :error
     1526     then do:
     1527       delete object v-xmllib-sax-reader-handle.
     1528       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1529                                                                   ,vss-workfile
     1530                                                                   ,vss-revision
     1531                                                                   ,vss-description
     1532                                                                   ,chr(10)
     1533                                                                   ,return-value
     1534                                                                   ,trim(error-status :get-message(1))
     1535                                                                   ,trim(error-status :get-message(2))
     1536                                                                   ,trim(error-status :get-message(3)) )
     1537                                                 ).
     1538       undo, return error .
     1539     end.
     1540     if v-xmllib-error-status <> no
     1541     then do:
     1542       run xmllib-parse-error in this-procedure (
     1543           input "*** При обработке XML файла были ошибки."
     1544       ).
     1545       if p-first-err then do:
     1546         delete object v-xmllib-sax-reader-handle.
     1547       end.
     1548       else do:
     1549         v-xmllib-error-status = no.
     1550       end.
     1551     end.
     1552     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     1553       p-parse-status = SAX-COMPLETE.
     1554       delete object v-xmllib-sax-reader-handle.
     1555       return '':U.
     1556     end.
     1557     else do:
     1558       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     1559       return '':U.
     1560     end.
     1561   end.
     1562   end procedure.
     1563   procedure StartElement :
     1564   define input parameter p-name-space     as character        no-undo.
     1565   define input parameter p-local-name     as character        no-undo.
     1566   define input parameter p-q-name         as character        no-undo.
     1567   define input parameter p-attributes     as handle           no-undo.
     1568       define buffer buf_rec             for temp_xmllib_rec.
     1569       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1570       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1571       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1572   do
     1573   for buf_rec
     1574     , buf_rec-fld
     1575     , buf_rec-list
     1576     , buf_rec-fld-list
     1577   on error undo, return error
     1578   :
     1579       if valid-handle(v-xmllib-prg-bar-handle)
     1580       then do:
     1581         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     1582       end.
     1583       find first buf_rec-list
     1584            where buf_rec-list.recName = p-q-name
     1585       no-error.
     1586       if available buf_rec-list
     1587       then do:
     1588           if buf_rec-list.closed = no
     1589           then do:
     1590               find first buf_rec-fld-list
     1591                    where buf_rec-fld-list.recName = buf_rec-list.recName
     1592                      and buf_rec-fld-list.fldName = p-q-name
     1593               no-error.
     1594               if available buf_rec-fld-list
     1595               and buf_rec-list.recName = buf_rec-fld-list.recName
     1596               then do:
     1597                   if buf_rec-fld-list.closed = no
     1598                   then do:
     1599                       run xmllib-parse-error in this-procedure (
     1600                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     1601                                           , p-q-name
     1602                                           , p-q-name
     1603                                           , buf_rec-fld-list.fldOpenLine
     1604                                           )
     1605                       ).
     1606                   end.
     1607                   else do:
     1608                       run xmllib-parse-rec-fld-open in this-procedure (
     1609                             input buf_rec-list.recName
     1610                           , input buf_rec-list.recLevel
     1611                           , input buf_rec-fld-list.fldName
     1612                       ).
     1613                       assign
     1614                           buf_rec-fld-list.closed         = no
     1615                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1616                           buf_rec-fld-list.fldCloseLine   = 0
     1617                       .
     1618                   end.
     1619               end.
     1620               else do:
     1621                   assign
     1622                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     1623                   .
     1624                   run xmllib-parse-rec-open in this-procedure (
     1625                         input buf_rec-list.recName
     1626                       , input buf_rec-list.recLevel
     1627                   ).
     1628                   assign
     1629                       buf_rec-list.closed         = no
     1630                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1631                       buf_rec-list.recCloseLine   = 0
     1632                   .
     1633               end.
     1634           end.
     1635           else do:
     1636               run xmllib-parse-rec-open in this-procedure (
     1637                     input buf_rec-list.recName
     1638                   , input buf_rec-list.recLevel
     1639               ).
     1640               assign
     1641                   buf_rec-list.closed         = no
     1642                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1643                   buf_rec-list.recCloseLine   = 0
     1644               .
     1645           end.
     1646       end.
     1647       else do:
     1648           open-record:
     1649           for each buf_rec-fld-list
     1650              where buf_rec-fld-list.fldName = p-q-name
     1651           :
     1652               find first buf_rec-list
     1653                    where buf_rec-list.recName = buf_rec-fld-list.recName
     1654                      and buf_rec-list.closed  = no
     1655               no-error.
     1656               if available buf_rec-list
     1657               then do:
     1658                   run xmllib-parse-rec-fld-open in this-procedure (
     1659                         input buf_rec-list.recName
     1660                       , input buf_rec-list.recLevel
     1661                       , input buf_rec-fld-list.fldName
     1662                   ).
     1663                   assign
     1664                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     1665                       buf_rec-fld-list.closed         = no
     1666                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1667                       buf_rec-fld-list.fldCloseLine   = 0
     1668                   .
     1669                   leave open-record.
     1670               end.
     1671           end.
     1672       end.
     1673   end.
     1674   end procedure.
     1675   procedure Characters :
     1676   define input parameter p-char-data  as memptr.
     1677   define input parameter p-numchars   as integer.
     1678       define variable v-data-string    as character    no-undo.
     1679       define variable v-cp-utf8           as integer no-undo init 65001 .
     1680       define variable v-cp-windows1251    as integer no-undo init 1251 .
     1681       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     1682       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     1683       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     1684       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     1685   do
     1686   for buf_xmllib_rec
     1687     , buf_xmllib_rec-fld
     1688     , buf_xmllib_rec-list
     1689     , buf_xmllib_rec-fld-list
     1690   on error undo, return error
     1691   :
     1692       find first buf_xmllib_rec-list
     1693            where buf_xmllib_rec-list.closed = no
     1694       no-error.
     1695       if available buf_xmllib_rec-list
     1696       then do:
     1697           find first buf_xmllib_rec-fld-list
     1698                where buf_xmllib_rec-fld-list.closed = no
     1699           no-error.
     1700           if available buf_xmllib_rec-fld-list
     1701           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     1702           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     1703           then do:
     1704               find last buf_xmllib_rec
     1705                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     1706                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     1707                     and buf_xmllib_rec.closed   = no
     1708               use-index nm
     1709               no-error.
     1710               if available buf_xmllib_rec
     1711               then do:
     1712                   find last buf_xmllib_rec-fld
     1713                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     1714                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     1715                         and buf_xmllib_rec-fld.closed = no
     1716                   use-index nm
     1717                   no-error.
     1718                   if available buf_xmllib_rec-fld
     1719                   then do:
     1720                       assign
     1721                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     1722                       .
     1723                       if v-xmllib-codepage-convert = yes
     1724                       then do:
     1725                         assign
     1726                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     1727                         .
     1728                       end.
     1729                       run xmlchar-decode in this-procedure (
     1730                           input v-data-string
     1731                           , output v-data-string
     1732                       ).
     1733                       assign
     1734                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     1735                       .
     1736                   end.
     1737               end.
     1738           end.
     1739       end.
     1740   end.
     1741   end procedure.
     1742   procedure EndElement :
     1743   define input parameter p-name-space     as character        no-undo.
     1744   define input parameter p-local-name     as character        no-undo.
     1745   define input parameter p-q-name         as character        no-undo.
     1746       define buffer buf_rec             for temp_xmllib_rec.
     1747       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1748       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1749       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1750   do
     1751   for buf_rec
     1752     , buf_rec-fld
     1753     , buf_rec-list
     1754     , buf_rec-fld-list
     1755   on error undo, return error
     1756   :
     1757       find last buf_rec-list
     1758           where buf_rec-list.recName = p-q-name
     1759       use-index pi
     1760       no-error.
     1761       if available buf_rec-list
     1762       then do:
     1763           if buf_rec-list.closed = yes
     1764           then do:
     1765               run xmllib-parse-error in this-procedure (
     1766                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     1767                                   , p-q-name
     1768                                   )
     1769               ).
     1770           end.
     1771           else do:
     1772               find last buf_rec
     1773                   where buf_rec.recName  = buf_rec-list.recName
     1774                     and buf_rec.recLevel = buf_rec-list.recLevel
     1775                     and buf_rec.closed   = no
     1776               use-index nm
     1777               no-error.
     1778               if not available buf_rec
     1779               then do:
     1780                   run xmllib-parse-error in this-procedure (
     1781                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     1782                                       , p-q-name
     1783                                       , buf_rec-list.recLevel
     1784                                       )
     1785                   ).
     1786               end.
     1787               else do:
     1788                   find first buf_rec-fld-list
     1789                        where buf_rec-fld-list.recName  = buf_rec.recName
     1790                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     1791                          and buf_rec-fld-list.fldName  = p-q-name
     1792                          and buf_rec-fld-list.closed   = no
     1793                   no-error.
     1794                   if not available buf_rec-fld-list
     1795                   then do:
     1796                       if buf_rec.recName <> p-q-name
     1797                       then do:
     1798                           run xmllib-parse-error in this-procedure (
     1799                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     1800                                               , buf_rec.recName
     1801                                               )
     1802                           ).
     1803                       end.
     1804                       else do:
     1805                           assign
     1806                               buf_rec.closed              = yes
     1807                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1808                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1809                           .
     1810                           if buf_rec-list.recLevel > 0
     1811                           then do:
     1812                               assign
     1813                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     1814                               .
     1815                               for each buf_rec-fld-list
     1816                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     1817                               :
     1818                                   assign
     1819                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     1820                                   .
     1821                               end.
     1822                           end.
     1823                           else do:
     1824                               assign
     1825                                   buf_rec-list.closed         = yes
     1826                               .
     1827                           end.
     1828                       end.
     1829                   end.
     1830                   else do:
     1831                       find last buf_rec-fld
     1832                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1833                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1834                             and buf_rec-fld.closed  = no
     1835                       use-index nm
     1836                       no-error.
     1837                       if not available buf_rec-fld
     1838                       then do:
     1839                           run xmllib-parse-error in this-procedure (
     1840                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1841                                               , buf_rec-fld-list.fldName
     1842                                               , buf_rec.recName
     1843                                               , buf_rec.recLevel
     1844                                               )
     1845                           ).
     1846                       end.
     1847                       else do:
     1848                           assign
     1849                               buf_rec-fld.closed              = yes
     1850                               buf_rec-fld-list.closed         = yes
     1851                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1852                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1853                           .
     1854                       end.
     1855                   end.
     1856               end.
     1857           end.
     1858       end.
     1859       else do:
     1860           close-field-rec:
     1861           for each buf_rec-fld-list
     1862              where buf_rec-fld-list.fldName = p-q-name
     1863           :
     1864               find first buf_rec-list
     1865                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     1866                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     1867                      and buf_rec-list.closed   = no
     1868               no-error.
     1869               if available buf_rec-list
     1870               then do:
     1871                   find last buf_rec
     1872                       where buf_rec.recName  = buf_rec-list.recName
     1873                         and buf_rec.recLevel = buf_rec-list.recLevel
     1874                         and buf_rec.closed   = no
     1875                   use-index nm
     1876                   no-error.
     1877                   if not available buf_rec
     1878                   then do:
     1879                       run xmllib-parse-error in this-procedure (
     1880                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     1881                                           , p-q-name
     1882                                           )
     1883                       ).
     1884                   end.
     1885                   else do:
     1886                       find last buf_rec-fld
     1887                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1888                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1889                             and buf_rec-fld.closed  = no
     1890                       use-index nm
     1891                       no-error.
     1892                       if not available buf_rec-fld
     1893                       then do:
     1894                           run xmllib-parse-error in this-procedure (
     1895                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1896                                               , buf_rec-fld-list.fldName
     1897                                               , buf_rec.recName
     1898                                               , buf_rec.recLevel
     1899                                               )
     1900                           ).
     1901                       end.
     1902                       else do:
     1903                           assign
     1904                               buf_rec-fld.closed              = yes
     1905                               buf_rec-fld-list.closed         = yes
     1906                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1907                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1908                           .
     1909                       end.
     1910                   end.
     1911                   leave close-field-rec.
     1912               end.
     1913           end.
     1914       end.
     1915   end.
     1916   end procedure.
     1917   procedure Error :
     1918   define input parameter p-error-message     as character        no-undo.
     1919   do
     1920   on error undo, return error
     1921   :
     1922       run xmllib-parse-error in this-procedure (
     1923           input p-error-message
     1924       ).
     1925       assign
     1926           v-xmllib-error-status = yes
     1927       .
     1928   end.
     1929   end procedure.
     1930   procedure xmllib-parse-error :
     1931   define input parameter p-err-message    as character        no-undo.
     1932   do
     1933   on error undo, return error
     1934   :
     1935       if valid-handle(v-xmllib-log-handle) then do:
     1936         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     1937                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     1938                                    ,chr(10)
     1939                                    ,v-xmllib-dirname
     1940                                    ,v-xmllib-filename
     1941                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     1942                                      then v-xmllib-sax-reader-handle :locator-line-number
     1943                                      else ?)
     1944                                    ,p-err-message)).
     1945       end.
     1946       else do:
     1947         if v-xmllib-log-filename = "":U
     1948         then do:
     1949             message
     1950                     vss-workfile vss-revision vss-description
     1951                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     1952                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     1953                                  then v-xmllib-sax-reader-handle :locator-line-number
     1954                                  else ?)
     1955                 skip(1)
     1956                 skip p-err-message
     1957                 skip return-value
     1958                 skip trim( error-status :get-message( 1 ) )
     1959                     trim( error-status :get-message( 2 ) )
     1960                     trim( error-status :get-message( 3 ) )
     1961             view-as alert-box error.
     1962             undo, return error.
     1963         end.
     1964         else do:
     1965           output to value( v-xmllib-log-filename ).
     1966           put unformatted
     1967               substitute( "&1&2", chr(10), p-err-message )
     1968           .
     1969           output close.
     1970         end.
     1971       end.
     1972   end.
     1973   end procedure.
     1974   procedure xmllib-set-log-filename :
     1975   define input parameter p-log-filename   as character        no-undo.
     1976   do
     1977   on error undo, return error
     1978   :
     1979       run gbl/fileapnd.p (
     1980             input p-log-filename
     1981           , input "":U
     1982           , input 10
     1983       ) no-error.
     1984       if error-status :error
     1985       then do:
     1986           assign
     1987               v-xmllib-log-filename = "":U
     1988           .
     1989       end.
     1990       else do:
     1991           assign
     1992               v-xmllib-log-filename = p-log-filename
     1993           .
     1994       end.
     1995   end.
     1996   end procedure.
     1997   procedure xmllib-set-log-handle :
     1998   define input parameter p-log-handle    as handle        no-undo.
     1999   define input parameter p-log-proc-name as character no-undo .
     2000   do
     2001   on error undo, return error
     2002   :
     2003       if valid-handle(p-log-handle)
     2004       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     2005       then do:
     2006         assign
     2007         v-xmllib-log-handle    = p-log-handle
     2008         v-xmllib-log-proc-name = p-log-proc-name
     2009         .
     2010       end.
     2011       else do:
     2012         assign
     2013         v-xmllib-log-handle    = ?
     2014         v-xmllib-log-proc-name = '':U
     2015         .
     2016       end.
     2017   end.
     2018   end procedure.
     2019   procedure xmllib-set-prg-bar-handle :
     2020   define input parameter p-handle    as handle        no-undo.
     2021   do
     2022   on error undo, return error
     2023   :
     2024       if valid-handle(p-handle)
     2025       then do:
     2026         assign
     2027           v-xmllib-prg-bar-handle = p-handle
     2028         .
     2029       end.
     2030       else do:
     2031         assign
     2032           v-xmllib-prg-bar-handle = ?
     2033         .
     2034       end.
     2035   end.
     2036   end procedure.
     2037   procedure xmllib-set-codepage-convert :
     2038     define input  parameter p-codepage-source as character no-undo .
     2039     define input  parameter p-codepage-target as character no-undo .
     2040   do
     2041   on error undo, return error return-value
     2042   :
     2043     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     2044     then do:
     2045       assign
     2046         v-xmllib-codepage-convert = yes
     2047         v-xmllib-codepage-source  = p-codepage-source
     2048         v-xmllib-codepage-target  = p-codepage-target
     2049       .
     2050     end.
     2051     else do:
     2052       assign
     2053         v-xmllib-codepage-convert = no
     2054         v-xmllib-codepage-source  = ""
     2055         v-xmllib-codepage-target  = ""
     2056       .
     2057     end.
     2058   end.
     2059   end procedure.
     2060   procedure xmllib-parse-rec-open :
     2061   define input parameter p-rec-name   as character        no-undo.
     2062   define input parameter p-rec-level  as integer          no-undo.
     2063       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2064   do
     2065   for buf_temp_xmllib_rec
     2066   on error undo, return error
     2067   :
     2068        find first buf_temp_xmllib_rec
     2069            where buf_temp_xmllib_rec.recName = p-rec-name
     2070              and buf_temp_xmllib_rec.recLevel = p-rec-level
     2071              and buf_temp_xmllib_rec.closed  = no
     2072       use-index nm
     2073       no-error.
     2074       if available buf_temp_xmllib_rec
     2075       then do:
     2076           run xmllib-parse-error in this-procedure (
     2077               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     2078                               , p-rec-name
     2079                               , p-rec-level
     2080                               , buf_temp_xmllib_rec.recOpenLine
     2081                               )
     2082           ).
     2083       end.
     2084       else do:
     2085           assign
     2086               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     2087           .
     2088           create buf_temp_xmllib_rec.
     2089           assign
     2090               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     2091               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2092               buf_temp_xmllib_rec.recCloseLine    = 0
     2093               buf_temp_xmllib_rec.recName         = p-rec-name
     2094               buf_temp_xmllib_rec.recLevel        = p-rec-level
     2095               buf_temp_xmllib_rec.closed          = no
     2096           .
     2097       end.
     2098   end.
     2099   end procedure.
     2100   procedure xmllib-parse-rec-fld-open :
     2101   define input parameter p-rec-name   as character        no-undo.
     2102   define input parameter p-rec-level  as integer          no-undo.
     2103   define input parameter p-fld-name   as character        no-undo.
     2104       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2105       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     2106   do
     2107   for buf_temp_xmllib_rec
     2108     , buf_temp_xmllib_rec-fld
     2109   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     2110                                           , return-value
     2111                                           , trim( error-status :get-message( 1 ) )
     2112                                           , trim( error-status :get-message( 2 ) ) )
     2113   :
     2114       find last buf_temp_xmllib_rec
     2115           where buf_temp_xmllib_rec.recName   = p-rec-name
     2116             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     2117             and buf_temp_xmllib_rec.closed    = no
     2118       use-index nm
     2119       no-error.
     2120       if not available buf_temp_xmllib_rec
     2121       then do:
     2122           run xmllib-parse-error in this-procedure (
     2123               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     2124                               , p-rec-name
     2125                               , p-fld-name
     2126                               , p-rec-level
     2127                               )
     2128           ).
     2129       end.
     2130       else do:
     2131           find last buf_temp_xmllib_rec-fld
     2132               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     2133                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     2134                 and buf_temp_xmllib_rec-fld.closed   = no
     2135           use-index nm
     2136           no-error.
     2137           if available buf_temp_xmllib_rec-fld
     2138           then do:
     2139               run xmllib-parse-error in this-procedure (
     2140                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     2141                                   , p-rec-name
     2142                                   , p-fld-name
     2143                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     2144                                   )
     2145               ).
     2146           end.
     2147           else do:
     2148               assign
     2149                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     2150               .
     2151               create buf_temp_xmllib_rec-fld.
     2152               assign
     2153                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     2154                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     2155                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2156                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     2157                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     2158                   buf_temp_xmllib_rec-fld.closed          = no
     2159               .
     2160           end.
     2161       end.
     2162   end.
     2163   end procedure.
     2164   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2165   define variable v-waitfram-action01         as character   no-undo .
     2166   define variable v-waitfram-action02         as character   no-undo .
     2167   define variable v-waitfram-action03         as character   no-undo .
     2168   define variable mWaitFramTextBeg            as character   no-undo.
     2169   define variable mWaitFramTextEnd            as character   no-undo.
     2170   define variable mWaitFramView               as logical     no-undo.
     2171   define variable mWaitProcEvent              as logical     no-undo init yes.
     2172   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2173   define variable mWaitFramStop               as logical     no-undo.
     2174   define variable mWaitFramStopUser           as logical     no-undo.
     2175   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2176   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2177   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2178   define button B-WaitFramStop auto-end-key
     2179        label "Стоп"
     2180        size 10 by 1 tooltip "Остоновить процесс".
     2181   define button B-viewProcInfo
     2182        label "Информация"
     2183        size 15 by 1 tooltip "Информация о процесс".
     2184   define frame waitfram
     2185     v-waitfram-action01 format "x(72)" no-label skip
     2186     v-waitfram-action02 format "x(72)" no-label skip
     2187     v-waitfram-action03 format "x(72)" no-label skip
     2188     B-viewProcInfo
     2189     B-WaitFramStop at row 4 col 30
     2190     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2191     .
     2192   define new global shared variable mBatchMode as logical no-undo init ?.
     2193   define variable mFramBachModHandle as handle no-undo.
     2194   mFramBachModHandle = frame waitfram:handle.
     2195   define variable mFameOldVis as logical no-undo.
     2196   define variable mVisCUrentVin as logical no-undo.
     2197   if session:batch-mode
     2198   then
     2199      mBatchMode = yes.
     2200   if mBatchMode = ? then do:
     2201     mVisCUrentVin = current-window:visible.
     2202     mFameOldVis = mFramBachModHandle:visible.
     2203     mFramBachModHandle:visible  = yes.
     2204     mBatchMode = mFramBachModHandle:visible ne yes.
     2205     mFramBachModHandle:visible = mFameOldVis.
     2206     current-window:visible = mVisCUrentVin.
     2207   end.
     2208    if  log-manager:logfile-name ne ?
     2209     then DO:
     2210         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2211         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2212         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2213     end.
     2214   on choose of B-WaitFramStop in frame waitfram
     2215   do:
     2216     mWaitFramStop = yes.
     2217     mWaitFramStopUser = yes.
     2218   end.
     2219   function waitfram-check-timeout returns logical():
     2220      define variable vtime as int64 no-undo.
     2221      if mWaitFramStopTimeOut
     2222      then
     2223         return yes.
     2224      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2225      if     mWaitFramTimeOut ne ?
     2226         and mWaitFramTimeOut ne 0
     2227         and mWaitFramTimeOut lt vtime
     2228      then do:
     2229         mWaitFramStopTimeOut = yes.
     2230      end.
     2231      return mWaitFramStopTimeOut.
     2232   end.
     2233   procedure waitfram-hide :
     2234     if not session:batch-mode
     2235     then do
     2236     on error undo, return error return-value
     2237     :
     2238       pause 0 before-hide .
     2239       if not mBatchMode then
     2240         hide frame waitfram .
     2241     if     not mWaitFramView
     2242        and mWaitProcEvent
     2243     then
     2244       process events .
     2245     end.
     2246   end procedure.
     2247   procedure waitfram-show :
     2248     define input  parameter p-message as character no-undo .
     2249     define variable v-left-margin as integer   no-undo .
     2250     if not session:batch-mode
     2251     then do
     2252     on error undo, return error return-value
     2253     :
     2254       if length(p-message) <= 70 then do:
     2255         assign
     2256           v-left-margin = integer((70 - length(p-message)) / 2)
     2257         .
     2258         assign
     2259           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2260         .
     2261         assign
     2262           v-waitfram-action01 = " "
     2263           v-waitfram-action02 = " "
     2264                                    + fill(" ", v-left-margin)
     2265                                    + p-message
     2266           v-waitfram-action03 = " "
     2267         .
     2268       end.
     2269       else do:
     2270         define variable vRindex1 as integer no-undo.
     2271         define variable vRindex2 as integer no-undo.
     2272         vRindex1 = r-index(p-message," ",70).
     2273         if vRindex1 = 0
     2274         then
     2275            vRindex1 = 70.
     2276         if length(p-message)  <= vRindex1 + 70 then do:
     2277           assign
     2278             v-waitfram-action01 = " "
     2279             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2280             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2281           .
     2282         end.
     2283         else do:
     2284           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2285           if vRindex2 <= vRindex1
     2286           then
     2287              vRindex2 = vRindex1 + 70.
     2288           assign
     2289             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2290             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2291             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2292           .
     2293         end.
     2294       end.
     2295       B-viewProcInfo:visible   in frame waitfram = no.
     2296       B-viewProcInfo:sensitive in frame waitfram = no.
     2297       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2298       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2299       if  (   mWaitFramView
     2300          or  mWaitProcEvent)
     2301          and not mBatchMode
     2302       then
     2303          display
     2304             v-waitfram-action01 skip
     2305             v-waitfram-action02 skip
     2306             v-waitfram-action03 skip
     2307          with frame waitfram .
     2308       if     mWaitFramView
     2309          then do:
     2310             if     mWaitFramInterval ne ?
     2311                and not mBatchMode
     2312             then
     2313                wait-for go of frame waitfram pause mWaitFramInterval.
     2314          end.
     2315          else
     2316             if     mWaitProcEvent
     2317                and not mBatchMode
     2318             then
     2319                process events .
     2320     end.
     2321   end procedure.
     2322      procedure waitfram-show-this:
     2323         define input  parameter iInterval as int64 no-undo.
     2324         define variable vtime as int64 no-undo.
     2325         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2326         mWaitFramInterval = iInterval.
     2327         run waitfram-show (substitute("&1&2 &3&4" ,
     2328                                       mWaitFramTextBeg ,
     2329                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2330                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2331                                       mWaitFramTextEnd
     2332                                      )
     2333                           ).
     2334      end.
     2335      procedure WaitFramRunPause:
     2336         define input  parameter iInterval as dec no-undo.
     2337         define variable vStart  as datetime-tz no-undo.
     2338         define variable vend    as datetime-tz no-undo.
     2339         define variable vint as int64 no-undo.
     2340         define variable vOk as logical no-undo.
     2341         vStart = now.
     2342         vend   = vStart.
     2343         publish "WaitFramPause" (iInterval,output vOk).
     2344         vend   =  now.
     2345         vint = vend - vStart.
     2346         vint = iInterval - vint / 1000.
     2347         if     not mWaitFramStop
     2348            and (   vint > 0
     2349                 or (    not vOk
     2350                     and iInterval eq ?
     2351                     )
     2352                 )
     2353         then
     2354            run waitfram-show-this (iInterval).
     2355         vend   =  now.
     2356         vint = vend - vStart.
     2357         vint = iInterval - vint / 1000.
     2358         if     not mWaitFramStop
     2359            and vint > 0
     2360         then do:
     2361            run gbl/pause.p (vint * 1000).
     2362         end.
     2363         if iInterval ne ?
     2364         then
     2365            publish "WaitFramStop".
     2366         waitfram-check-timeout().
     2367      end.
     2368      procedure WaitFramWaitFor:
     2369         define input  parameter iInterval as dec no-undo.
     2370         assign
     2371            mWaitFramStartProc   = now
     2372            mWaitFramStopUser    = no
     2373            mWaitFramStopTimeOut = no
     2374         .
     2375         block-wait:
     2376         do while not mWaitFramStop:
     2377            run WaitFramRunPause (iInterval).
     2378            if  waitfram-check-timeout()
     2379            then do:
     2380               leave block-wait.
     2381            end.
     2382         end.
     2383         run waitfram-hide.
     2384      end.
     2385   procedure waitfram-join :
     2386     define input  parameter p-line-1  as character no-undo .
     2387     define input  parameter p-line-2  as character no-undo .
     2388     define input  parameter p-line-3  as character no-undo .
     2389     define output parameter p-message as character no-undo .
     2390     do
     2391     on error undo, return error return-value
     2392     :
     2393       assign
     2394         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2395                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2396                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2397       .
     2398     end.
     2399   end procedure.
     2400   function waitfram-join-function returns character
     2401     (input p-line-1 as character
     2402     ,input p-line-2 as character
     2403     ,input p-line-3 as character
     2404     ).
     2405     define variable v-message as character no-undo .
     2406     run waitfram-join in this-procedure
     2407       (input  p-line-1
     2408       ,input  p-line-2
     2409       ,input  p-line-3
     2410       ,output v-message
     2411       ) .
     2412     return v-message .
     2413   end function .
     2414   define variable v-account as integer init 0 no-undo .
     2415   define variable v-account-lavel as character no-undo .
     2416   define variable v-button-stop as logical no-undo .
     2417   define variable v-kol-spice as integer no-undo .
     2418   define variable v-kol-spice2 as integer no-undo .
     2419   define variable v-kol-spice3 as integer no-undo .
     2420   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     2421   DEFINE BUTTON StopBtn AUTO-END-KEY
     2422        LABEL "Стоп"
     2423        SIZE 10 BY 1.
     2424   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     2425        LABEL "Обработано записей"
     2426         VIEW-AS TEXT
     2427        SIZE 14 BY .67 NO-UNDO.
     2428   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     2429         VIEW-AS TEXT
     2430        SIZE 53.25 BY .67
     2431        FGCOLOR 1  NO-UNDO.
     2432   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     2433         VIEW-AS TEXT
     2434        SIZE 53.25 BY .67
     2435        FGCOLOR 1  NO-UNDO.
     2436   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     2437         VIEW-AS TEXT
     2438        SIZE 53.25 BY .67
     2439        FGCOLOR 1  NO-UNDO.
     2440   DEFINE RECTANGLE RECT-1
     2441        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2442        SIZE 55.13 BY 4.46.
     2443   DEFINE FRAME InfoFrame
     2444        StopBtn AT ROW 4.25 COL 21.75
     2445        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2446        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2447        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2448        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2449        RECT-1 AT ROW 1 COL 1
     2450       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2451            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2452            TITLE "Процесс"
     2453            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2454   define variable mFrameView      as logical   no-undo init yes.
     2455     define variable mFramHandle as handle no-undo.
     2456     mFramHandle = frame InfoFrame:handle.
     2457     if  log-manager:logfile-name ne ?
     2458     then DO:
     2459         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2460         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2461         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2462     end.
     2463     mFrameView = not session:batch-mode and mFramHandle:visible.
     2464     if mFrameView
     2465     then do:
     2466       ASSIGN
     2467          FRAME InfoFrame:HIDDEN                           = TRUE
     2468          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2469     end.
     2470   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2471   DO:
     2472     IF not StopProcessing THEN
     2473       Message "Вы действительно хотите прервать" SKIP
     2474               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2475                 UPDATE StopProcessing.
     2476     IF StopProcessing THEN do:
     2477        if mFrameView
     2478        then do:
     2479           HIDE FRAME InfoFrame.
     2480        end.
     2481     End.
     2482   END.
     2483   define variable v-i           as integer   no-undo .
     2484   define variable v-is-error    as logical   no-undo .
     2485   define variable v-err-count   as integer   no-undo .
     2486   define variable v-frame-label as character no-undo .
     2487   define variable v-today       as date      no-undo .
     2488   define variable v-time        as integer   no-undo .
     2489   define variable v-time-start  as integer   no-undo .
     2490   define variable v-time-finish as integer   no-undo .
     2491   define variable v-alc-count-l as integer format ">>>,>>>,>>>,>>9" no-undo .
     2492   define variable v-alc-count-t as integer format ">>>,>>>,>>>,>>9" no-undo .
     2493   define variable v-alc-count-b as integer format ">>>,>>>,>>>,>>9" no-undo .
     2494   define variable v-sup-count-l as integer format ">>>,>>>,>>>,>>9" no-undo .
     2495   define variable v-sup-count-t as integer format ">>>,>>>,>>>,>>9" no-undo .
     2496   define variable v-sup-count-b as integer format ">>>,>>>,>>>,>>9" no-undo .
     2497   function get-date return date (input p-str as character) forward.
     2498   define stream sinp.
     2499   define stream serr.
