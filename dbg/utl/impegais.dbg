     2583   do on error undo, return error return-value
     2584   :
     2585   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2586     run mainmenu_getcntxt in parparentproc
     2587       (output v-cntxt-db-num
     2588       ,output v-cntxt-userid
     2589       ,output v-cntxt-level
     2590       ,output v-cntxt-host-code-obj
     2591       ,output v-cntxt-obj-type
     2592       ,output v-cntxt-obj-code
     2593       ,output v-cntxt-db-num-obj
     2594       ,output v-cntxt-is-admin
     2595       ) .
     2596     run clear-tt in this-procedure .
     2597     assign
     2598       v-time-start = time
     2599     .
     2600     run xmllib-set-prg-bar-handle in this-procedure ( input this-procedure ) .
     2601     run load-xml-alcohol in this-procedure .
     2602     run proc-xml-alcohol in this-procedure .
     2603     run load-xml-supplier in this-procedure .
     2604     run proc-xml-supplier in this-procedure .
     2605     run fill-alcohol in this-procedure .
     2606     run fill-suppliers in this-procedure .
     2607     run clear-tt in this-procedure .
     2608     run xmllib-clear-parse-data in this-procedure.
     2609     assign
     2610       v-time-finish = time - v-time-start
     2611     .
     2612     run calc-egais-gds in this-procedure ( output v-alc-count-b ) .
     2613     run calc-egais-clients in this-procedure ( output v-sup-count-b ) .
     2614     message
     2615       "Импорт завершен!":U skip
     2616       "Время импорта: ":U string( v-time-finish , "HH:MM:SS" ) skip(2)
     2617       "Разобрано записей алкогольной продукции: ":U  v-alc-count-t skip
     2618       "Загружено новых записей: ":U v-alc-count-l skip
     2619       "Записей в БД: ":U v-alc-count-b skip(1)
     2620       "Разобрано записей поставщиков: ":U  v-sup-count-t skip
     2621       "Загружено новых записей: ":U v-sup-count-l skip
     2622       "Записей в БД: ":U v-sup-count-b
     2623     view-as alert-box information.
     2624     if v-is-error = yes then do:
     2625       message
     2626         "Во время импорта были обнаружены ошибки." skip
     2627         "Количество ошибок: " v-err-count skip
     2628         "Отчет выведен в файл impegais.err"
     2629       view-as alert-box warning.
     2630     end.
     2631   end.
     2632   procedure put-error :
     2633   define input  parameter p-message as character no-undo .
     2634   do
     2635   on error undo, return error return-value
     2636   :
     2637     assign
     2638       v-is-error  = yes
     2639       v-err-count = v-err-count + 1
     2640     .
     2641     output stream serr to "impegais.err" append.
     2642     put stream serr unformatted string( today , "99/99/99") + " " + string( time , "hh:mm:ss") + " " + p-message + chr(10) .
     2643     output stream serr close.
     2644   end.
     2645   end procedure.
     2646   procedure clear-tt :
     2647   do
     2648   on error undo, return error return-value
     2649   :
     2650     empty temp-table tt-alc-container .
     2651     empty temp-table tt-alc-volume .
     2652     empty temp-table tt-territory .
     2653     empty temp-table tt-alc-manufacturer .
     2654     empty temp-table tt-alc-products .
     2655     empty temp-table tt-alc-supplier .
     2656   end.
     2657   end procedure.
     2658   procedure find-client :
     2659   define input  parameter p-inn as character no-undo .
     2660   define output parameter p-obj-type  like ub.clients.obj-type no-undo .
     2661   define output parameter p-obj-code  like ub.clients.obj-code no-undo .
     2662   do
     2663   on error undo, return error return-value
     2664   :
     2665     define buffer buf_firm    for ub.firm.
     2666     define buffer buf_person  for ub.person.
     2667     find first buf_firm no-lock
     2668       where buf_firm.inn = p-inn
     2669     no-error .
     2670     if available buf_firm then do:
     2671       assign
     2672         p-obj-type = 'орг':U
     2673         p-obj-code = buf_firm.firm-code
     2674       .
     2675       return.
     2676     end.
     2677     find first buf_person no-lock
     2678       where buf_person.inn = p-inn
     2679     no-error .
     2680     if available buf_person then do:
     2681       assign
     2682         p-obj-type = 'чел':U
     2683         p-obj-code = buf_person.psn-code
     2684       .
     2685       return.
     2686     end.
     2687   end.
     2688   end procedure.
     2689   procedure load-xml-alcohol :
     2690   do
     2691   on error undo, return error return-value
     2692   :
     2693     define variable v-full-filename as character  no-undo.
     2694     define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     2695     define buffer buf_rec          for temp_xmllib_rec.
     2696   do
     2697   for buf_rec-fld
     2698     , buf_rec
     2699   on error undo, return error
     2700   :
     2701       assign
     2702           v-full-filename   = search( p-alc-codes-filename )
     2703       .
     2704       if v-full-filename <> ?
     2705       then do:
     2706           run xmllib-clear-parse-data in this-procedure.
     2707           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_ID":U           ) .
     2708           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_NAME":U         ) .
     2709           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_ADDRESS":U      ) .
     2710           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_EGAIS":U        ) .
     2711           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_INN":U          ) .
     2712           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_DATE_BG_NW":U   ) .
     2713           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_DATE_END_NW":U  ) .
     2714           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_AKTL":U         ) .
     2715           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_MANUFACTURER":U, input "MANF_DATE_NW":U      ) .
     2716           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "ALPR_ID":U        ) .
     2717           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "KALPR_ID":U       ) .
     2718           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "KCONT_ID":U       ) .
     2719           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "VOLF_ID":U        ) .
     2720           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "MANF_ID":U        ) .
     2721           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "ALPR_EGAIS":U     ) .
     2722           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "ALPR_CODE":U      ) .
     2723           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "ALPR_NAME":U      ) .
     2724           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "ALPR_SCAN_CODE":U ) .
     2725           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "ALPR_FRTR":U      ) .
     2726           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_PRODUCT":U, input "ALPR_STATUS":U    ) .
     2727           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_CONTAINER":U, input "KCONT_ID":U           ) .
     2728           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_CONTAINER":U, input "KCONT_CODE":U         ) .
     2729           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_CONTAINER":U, input "KCONT_NAME":U         ) .
     2730           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_CONTAINER":U, input "RCONT_DATE_BG_NW":U   ) .
     2731           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_CONTAINER":U, input "RCONT_DATE_END_NW":U  ) .
     2732           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_CONTAINER":U, input "RCONT_DATE_NW":U      ) .
     2733           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_CONTAINER":U, input "RCONT_AKTL":U         ) .
     2734           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_VOLUME":U, input "VOLF_ID":U         ) .
     2735           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_VOLUME":U, input "VOLF_CODE":U       ) .
     2736           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_VOLUME":U, input "VOLF_VOLUME":U     ) .
     2737           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_VOLUME":U, input "VLF_DATE_BG_NW":U  ) .
     2738           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_VOLUME":U, input "VLF_DATE_END_NW":U ) .
     2739           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_VOLUME":U, input "VLF_DATE_NW":U     ) .
     2740           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_VOLUME":U, input "VLF_AKTL":U        ) .
     2741           run xmllib-add-rec-fld in this-procedure ( input "MD_TERRITORY":U, input "TERR_ID":U          ) .
     2742           run xmllib-add-rec-fld in this-procedure ( input "MD_TERRITORY":U, input "TERR_CODE":U        ) .
     2743           run xmllib-add-rec-fld in this-procedure ( input "MD_TERRITORY":U, input "TERR_NAME":U        ) .
     2744           run xmllib-add-rec-fld in this-procedure ( input "MD_TERRITORY":U, input "TERR_DATE_BG_NW":U  ) .
     2745           run xmllib-add-rec-fld in this-procedure ( input "MD_TERRITORY":U, input "TERR_DATE_END_NW":U ) .
     2746           run xmllib-add-rec-fld in this-procedure ( input "MD_TERRITORY":U, input "TERR_DATE_NW":U     ) .
     2747           run xmllib-add-rec-fld in this-procedure ( input "MD_TERRITORY":U, input "TERR_COUNTR":U      ) .
     2748           run xmllib-parse-file in this-procedure (
     2749               input v-full-filename
     2750           ) no-error.
     2751           if error-status :error
     2752           then do:
     2753               message
     2754                        vss-workfile vss-revision vss-description
     2755                   skip(1)
     2756                   skip substitute( "Ошибка разбора файла &1", v-full-filename )
     2757                   skip return-value
     2758                   skip trim(error-status :get-message(1))
     2759                        trim(error-status :get-message(2))
     2760                        trim(error-status :get-message(3))
     2761               view-as alert-box error.
     2762               undo, return error .
     2763           end.
     2764       end.
     2765   end.
     2766   run waitfram-hide in this-procedure .
     2767   end.
     2768   end procedure.
     2769   procedure load-xml-supplier :
     2770   do
     2771   on error undo, return error return-value
     2772   :
     2773     define variable v-full-filename as character  no-undo.
     2774     define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     2775     define buffer buf_rec          for temp_xmllib_rec.
     2776   do
     2777   for buf_rec-fld
     2778     , buf_rec
     2779   on error undo, return error
     2780   :
     2781       assign
     2782           v-full-filename   = search( p-sup-codes-filename )
     2783       .
     2784       if v-full-filename <> ?
     2785       then do:
     2786           run xmllib-clear-parse-data in this-procedure.
     2787           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_ID":U               ) .
     2788           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_NAME":U             ) .
     2789           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_ADR_UR":U           ) .
     2790           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_HEAD_FIO":U         ) .
     2791           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_INN":U              ) .
     2792           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_CODE_REAS_STATE":U  ) .
     2793           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_CODE_EGAIS":U       ) .
     2794           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_DATE_BG_NW":U       ) .
     2795           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_DATE_END_NW":U      ) .
     2796           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_DATE_NW":U          ) .
     2797           run xmllib-add-rec-fld in this-procedure ( input "MD_ALC_SUPPLIER":U, input "SUPP_PRZ_AKTL":U         ) .
     2798           run xmllib-parse-file in this-procedure (
     2799               input v-full-filename
     2800           ) no-error.
     2801           if error-status :error
     2802           then do:
     2803               message
     2804                        vss-workfile vss-revision vss-description
     2805                   skip(1)
     2806                   skip substitute( "Ошибка разбора файла &1", v-full-filename )
     2807                   skip return-value
     2808                   skip trim(error-status :get-message(1))
     2809                        trim(error-status :get-message(2))
     2810                        trim(error-status :get-message(3))
     2811               view-as alert-box error.
     2812               undo, return error .
     2813           end.
     2814       end.
     2815   end.
     2816   run waitfram-hide in this-procedure .
     2817   end.
     2818   end procedure.
     2819   procedure proc-xml-alcohol :
     2820       define buffer buf_rec          for temp_xmllib_rec.
     2821       define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     2822   do
     2823   on error undo, return error return-value
     2824   :
     2825     run waitfram-show in this-procedure ( "Разбор товаров...":U ) .
     2826     for each buf_rec
     2827     on error undo, return error
     2828     :
     2829       case buf_rec.recName :
     2830         when "MD_ALC_CONTAINER":U then do:
     2831           run parse-alc-containers in this-procedure ( input buf_rec.rec-key ) .
     2832         end.
     2833         when "MD_ALC_VOLUME":U then do:
     2834           run parse-alc-volumes in this-procedure ( input buf_rec.rec-key ) .
     2835         end.
     2836         when "MD_TERRITORY":U then do:
     2837           run parse-territorys in this-procedure ( input buf_rec.rec-key ) .
     2838         end.
     2839         when "MD_ALC_MANUFACTURER":U then do:
     2840           run parse-alc-manufacturers in this-procedure ( input buf_rec.rec-key ) .
     2841         end.
     2842         when "MD_ALC_PRODUCT":U then do:
     2843           run parse-alc-products in this-procedure ( input buf_rec.rec-key) .
     2844         end.
     2845       end case.
     2846     end.
     2847     run waitfram-hide in this-procedure .
     2848   end.
     2849   end procedure.
     2850   procedure proc-xml-supplier :
     2851       define buffer buf_rec          for temp_xmllib_rec.
     2852       define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     2853   do
     2854   on error undo, return error return-value
     2855   :
     2856     run waitfram-show in this-procedure ( "Разбор поставщиков...":U ) .
     2857     for each buf_rec
     2858     on error undo, return error
     2859     :
     2860       case buf_rec.recName :
     2861         when "MD_ALC_SUPPLIER":U then do:
     2862           run parse-alc-suppliers in this-procedure ( input buf_rec.rec-key ) .
     2863         end.
     2864       end case.
     2865     end.
     2866     run waitfram-hide in this-procedure .
     2867   end.
     2868   end procedure.
     2869   procedure parse-alc-containers :
     2870     define input  parameter p-rec-key as integer   no-undo .
     2871     define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     2872     define variable v-kcont_id          as decimal   no-undo .
     2873     define variable v-kcont_code        as character no-undo .
     2874     define variable v-kcont_name        as character no-undo .
     2875     define variable v-rcont_date_bg_nw  as date      no-undo .
     2876     define variable v-rcont_date_end_nw as date      no-undo .
     2877     define variable v-rcont_date_nw     as date      no-undo .
     2878     define variable v-rcont_aktl        as decimal   no-undo .
     2879   do
     2880   on error undo, return error return-value
     2881   :
     2882     for each buf_rec-fld
     2883         where buf_rec-fld.rec-key = p-rec-key
     2884     on error undo, return error
     2885     :
     2886       case buf_rec-fld.fldName :
     2887         when "KCONT_ID":U then do:
     2888           assign
     2889             v-kcont_id = decimal(buf_rec-fld.fldValue)
     2890           no-error .
     2891         end.
     2892         when "KCONT_CODE":U then do:
     2893           assign
     2894             v-kcont_code = buf_rec-fld.fldValue
     2895           .
     2896         end.
     2897         when "KCONT_NAME":U then do:
     2898           assign
     2899             v-kcont_name = buf_rec-fld.fldValue
     2900           .
     2901         end.
     2902         when "RCONT_DATE_BG_NW":U then do:
     2903           assign
     2904             v-rcont_date_bg_nw = get-date( buf_rec-fld.fldValue )
     2905           no-error .
     2906         end.
     2907         when "RCONT_DATE_END_NW":U then do:
     2908           assign
     2909             v-rcont_date_end_nw = get-date( buf_rec-fld.fldValue )
     2910           no-error .
     2911         end.
     2912         when "RCONT_DATE_NW":U then do:
     2913           assign
     2914             v-rcont_date_nw = get-date( buf_rec-fld.fldValue )
     2915           no-error .
     2916         end.
     2917         when "RCONT_AKTL":U then do:
     2918           assign
     2919             v-rcont_aktl = decimal( buf_rec-fld.fldValue )
     2920           no-error .
     2921         end.
     2922       end case.
     2923     end.
     2924     if v-kcont_id = ? then return.
     2925     find first tt-alc-container
     2926       where tt-alc-container.kcont_id = v-kcont_id
     2927     no-error .
     2928     if not available tt-alc-container then do:
     2929       create tt-alc-container.
     2930       assign
     2931         tt-alc-container.kcont_id           = v-kcont_id
     2932         tt-alc-container.kcont_code         = v-kcont_code
     2933         tt-alc-container.kcont_name         = v-kcont_name
     2934         tt-alc-container.rcont_date_bg_nw   = v-rcont_date_bg_nw
     2935         tt-alc-container.rcont_date_end_nw  = v-rcont_date_end_nw
     2936         tt-alc-container.rcont_date_nw      = v-rcont_date_nw
     2937         tt-alc-container.rcont_aktl         = v-rcont_aktl
     2938       .
     2939     end.
     2940   end.
     2941   end procedure.
     2942   procedure parse-alc-volumes :
     2943     define input  parameter p-rec-key as integer   no-undo .
     2944     define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     2945     define variable v-volf_id         as decimal    no-undo .
     2946     define variable v-volf_code       as character  no-undo .
     2947     define variable v-volf_volume     as decimal    no-undo .
     2948     define variable v-vlf_date_bg_nw  as date       no-undo .
     2949     define variable v-vlf_date_end_nw as date       no-undo .
     2950     define variable v-vlf_date_nw     as date       no-undo .
     2951     define variable v-vlf_aktl        as decimal    no-undo .
