      885       end.
      886     end.
      887     end procedure.
      888     procedure prg-bar_stepto :
      889       define input  parameter p-val as integer   no-undo .
      890     do
      891     on error undo, return error return-value
      892     :
      893       if valid-handle(v-prg-bar_cb-handle)
      894       then do:
