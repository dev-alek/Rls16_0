      583   procedure xmlchar-decode :
      584   define input parameter p-in-string      as character        no-undo.
      585   define output parameter p-out-string    as character        no-undo.
      586       define variable v-position      as integer      no-undo.
      587       define variable v-last-position as integer      no-undo.
      588       define variable v-temp-integer  as integer      no-undo.
      589       define variable v-current-char  as character    no-undo.
      590       define variable v-next-char     as character    no-undo.
      591       define variable v-success       as logical      no-undo.
      592   do
      593   on error undo, return error
      594   :
      595       assign
      596           p-out-string = "":U
      597           v-position   = 0
      598       .
      599       replace-cycle:
      600       do while yes
      601       on error undo, return error
      602       :
      603           assign
      604               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      605           .
      606           if v-last-position <= v-position
      607           then do:
      608               if v-position = 0
      609               then do:
      610                   assign
      611                       p-out-string = p-in-string
      612                   .
      613               end.
      614               else do:
      615                   assign
      616                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      617                   .
      618               end.
      619               leave replace-cycle.
      620           end.
      621           else do:
      622               assign
      623                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      624                   v-position      = v-last-position
      625                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      626               .
      627               if v-current-char = "#":U
      628               then do:
      629                   assign
      630                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      631                   .
      632                   if v-last-position > 0
      633                   then do:
      634                       run xmlchar-read-integer in this-procedure
      635                        (
      636                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      637                           , output v-temp-integer
      638                           , output v-success
      639                       ).
      640                       if v-success = yes
      641                       and v-temp-integer >= 1
      642                       and v-temp-integer <= 255
      643                       then do:
      644                           assign
      645                               p-out-string = p-out-string + chr( v-temp-integer )
      646                               v-position   = v-last-position + 1
      647                           .
      648                       end.
      649                       else do:
      650                           assign
      651                               p-out-string = p-out-string + "&":U
      652                               v-position   = v-position   + 1
      653                           .
      654                       end.
      655                   end.
      656                   else do:
      657                       assign
      658                           p-out-string = p-out-string + "&":U
      659                           v-position   = v-position   + 1
      660                       .
      661                   end.
      662               end.
      663               else do:
      664                   case substring( p-in-string, v-position + 1, 3 )
      665                   :
      666                       when "lt;":U
      667                       then do:
      668                           assign
      669                               p-out-string = p-out-string + "<":U
      670                               v-position   = v-position   + 3
      671                           .
      672                       end.
      673                       when "gt;":U
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + ">":U
      677                               v-position   = v-position   + 3
      678                           .
      679                       end.
      680                       otherwise do:
      681                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      682                           then do:
      683                               assign
      684                                   p-out-string = p-out-string + "&":U
      685                                   v-position   = v-position   + 4
      686                               .
      687                           end.
      688                           else do:
      689                               case substring( p-in-string, v-position + 1, 5 )
      690                               :
      691                                   when "quot;":U
      692                                   then do:
      693                                       assign
      694                                           p-out-string = p-out-string + '"':U
      695                                           v-position   = v-position   + 5
      696                                       .
      697                                   end.
      698                                   when "apos;":U
      699                                   then do:
      700                                       assign
      701                                           p-out-string = p-out-string + "'":U
      702                                           v-position   = v-position   + 5
      703                                       .
      704                                   end.
      705                                   otherwise do:
      706                                       assign
      707                                           p-out-string = p-out-string + "&":U
      708                                       .
      709                                   end.
      710                               end case.
      711                           end.
      712                       end.
      713                   end case.
      714               end.
      715           end.
      716       end.
      717   end.
      718   end .
      719   procedure xmlchar-read-integer :
      720   define input parameter p-input-string      as character        no-undo.
      721   define output parameter p-output-integer   as integer          no-undo.
      722   define output parameter p-success       as logical          no-undo.
      723   do
      724   on error undo, return error
      725   :
      726       assign
      727           p-output-integer = integer( p-input-string )
      728       no-error.
      729       if error-status :error
      730       then do:
      731           assign
      732               p-success           = no
      733               p-output-integer    = 0
      734           .
      735       end.
      736       else do:
      737           assign
      738               p-success           = yes
      739           .
      740       end.
      741   end.
      742   end.
      743   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744     define variable v-prg-bar_progress-bar  as class ProgressBar  no-undo .
      745     procedure prg-bar_new-progress-bar :
      746       define input  parameter p-min as int64   no-undo .
      747       define input  parameter p-max as int64   no-undo .
      748     do
      749     on error undo, return error return-value
      750     :
      751       if v-prg-bar_progress-bar <> ?
      752       then do:
      753         run prg-bar_delete-progress-bar in this-procedure .
      754       end.
      755       v-prg-bar_progress-bar = new progressbar( p-min , p-max ).
      756     end.
      757     end procedure.
      758     procedure prg-bar_delete-progress-bar :
      759     do
      760     on error undo, return error return-value
      761     :
      762       if v-prg-bar_progress-bar <> ?
      763       then do:
      764         delete object v-prg-bar_progress-bar.
      765         assign
      766           v-prg-bar_progress-bar = ?
      767         .
      768       end.
      769     end.
      770     end procedure.
      771     procedure prg-bar_show-progress-bar :
      772     do
      773     on error undo, return error return-value
      774     :
      775       if v-prg-bar_progress-bar <> ?
      776       then do:
      777         v-prg-bar_progress-bar :show-bar() .
      778       end.
      779     end.
      780     end procedure.
      781     procedure prg-bar_increment-progress-bar :
      782     do
      783     on error undo, return error return-value
      784     :
      785       if v-prg-bar_progress-bar <> ?
      786       then do:
      787         v-prg-bar_progress-bar :increment() .
      788       end.
      789     end.
      790     end procedure.
      791     procedure prg-bar_title-progress-bar :
      792       define input  parameter p-str as character no-undo .
      793     do
      794     on error undo, return error return-value
      795     :
      796       if v-prg-bar_progress-bar <> ?
      797       then do:
      798         assign
      799           v-prg-bar_progress-bar :frame-title = p-str
      800         .
      801       end.
      802     end.
      803     end procedure.
      804     procedure prg-bar_stepto-progress-bar :
      805       define input  parameter p-val as integer   no-undo .
      806     do
      807     on error undo, return error return-value
      808     :
      809       if v-prg-bar_progress-bar <> ?
      810       then do:
      811           v-prg-bar_progress-bar :stepto( p-val ) .
      812       end.
