     3046           .
     3047         end.
     3048         when "TERR_DATE_BG_NW":U then do:
     3049           assign
     3050             v-terr_date_bg_nw = get-date( buf_rec-fld.fldValue )
     3051           no-error .
     3052         end.
     3053         when "TERR_DATE_END_NW":U then do:
     3054           assign
     3055             v-terr_date_end_nw = get-date( buf_rec-fld.fldValue )
     3056           no-error .
     3057         end.
     3058         when "TERR_DATE_NW":U    then do:
