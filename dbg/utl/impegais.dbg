     3066           no-error .
     3067         end.
     3068       end case.
     3069     end.
     3070     if v-terr_id = ? then return .
     3071     find first tt-territory
     3072       where tt-territory.terr_id = v-terr_id
     3073     no-error .
     3074     if not available tt-territory then do:
