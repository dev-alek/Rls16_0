      814     end procedure.
      815   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816     define variable v-prg-bar_cb-handle     as handle             no-undo .
      817     procedure prg-bar_init-cb-handle :
      818       define input  parameter p-cb-handle as handle    no-undo .
      819     do
      820     on error undo, return error return-value
      821     :
      822       if valid-handle( p-cb-handle )
      823       then do:
      824         assign
      825           v-prg-bar_cb-handle = p-cb-handle
      826         .
      827       end.
      828       else do:
      829         assign
      830           v-prg-bar_cb-handle = ?
      831         .
      832       end.
      833     end.
      834     end procedure.
      835     procedure prg-bar_new :
      836       define input  parameter p-min as int64   no-undo .
      837       define input  parameter p-max as int64   no-undo .
      838     do
      839     on error undo, return error return-value
      840     :
      841       if valid-handle(v-prg-bar_cb-handle)
      842       then do:
      843         run prg-bar_new-progress-bar in v-prg-bar_cb-handle ( input p-min , input p-max ).
      844       end.
      845     end.
      846     end procedure.
      847     procedure prg-bar_delete :
      848     do
      849     on error undo, return error return-value
      850     :
      851       if valid-handle(v-prg-bar_cb-handle)
      852       then do:
      853         run prg-bar_delete-progress-bar in v-prg-bar_cb-handle .
      854       end.
      855     end.
      856     end procedure.
      857     procedure prg-bar_show :
      858     do
      859     on error undo, return error return-value
      860     :
      861       if valid-handle(v-prg-bar_cb-handle)
      862       then do:
      863         run prg-bar_show-progress-bar in v-prg-bar_cb-handle .
      864       end.
      865     end.
      866     end procedure.
      867     procedure prg-bar_increment :
      868     do
      869     on error undo, return error return-value
      870     :
      871       if valid-handle(v-prg-bar_cb-handle)
      872       then do:
      873         run prg-bar_increment-progress-bar in v-prg-bar_cb-handle.
      874       end.
      875     end.
      876     end procedure.
      877     procedure prg-bar_title :
