     3078         tt-territory.terr_code        = v-terr_code
     3079         tt-territory.terr_name        = v-terr_name
     3080         tt-territory.terr_date_bg_nw  = v-terr_date_bg_nw
     3081         tt-territory.terr_date_end_nw = v-terr_date_end_nw
     3082         tt-territory.terr_date_nw     = v-terr_date_nw
     3083         tt-territory.terr_countr      = v-terr_countr
     3084       .
     3085     end.
     3086   end.
     3087   end procedure.
     3088   procedure parse-alc-manufacturers :
     3089     define input  parameter p-rec-key as integer   no-undo .
     3090     define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     3091     define variable v-manf_id          as decimal    no-undo .
     3092     define variable v-manf_name        as character  no-undo .
     3093     define variable v-manf_address     as character  no-undo .
     3094     define variable v-manf_egais       as character  no-undo .
     3095     define variable v-manf_inn         as character  no-undo .
     3096     define variable v-manf_date_bg_nw  as date       no-undo .
     3097     define variable v-manf_date_end_nw as date       no-undo .
     3098     define variable v-manf_aktl        as decimal    no-undo .
     3099     define variable v-manf_date_nw     as date       no-undo .
     3100   do
     3101   on error undo, return error return-value
     3102   :
     3103     for each buf_rec-fld
     3104         where buf_rec-fld.rec-key = p-rec-key
     3105     on error undo, return error
     3106     :
     3107       case buf_rec-fld.fldName :
     3108         when "MANF_ID":U         then do:
     3109           assign
     3110             v-manf_id = decimal(buf_rec-fld.fldValue)
     3111           no-error .
     3112         end.
     3113         when "MANF_NAME":U       then do:
     3114           assign
     3115             v-manf_name = buf_rec-fld.fldValue
     3116           .
     3117         end.
     3118         when "MANF_ADDRESS":U    then do:
     3119           assign
     3120             v-manf_address = buf_rec-fld.fldValue
     3121           .
     3122         end.
     3123         when "MANF_EGAIS":U      then do:
     3124           assign
     3125             v-manf_egais = buf_rec-fld.fldValue
     3126           .
     3127         end.
     3128         when "MANF_INN":U        then do:
     3129           assign
     3130             v-manf_inn =  buf_rec-fld.fldValue
     3131           no-error .
     3132         end.
     3133         when "MANF_DATE_BG_NW":U then do:
     3134           assign
     3135             v-manf_date_bg_nw = get-date( buf_rec-fld.fldValue )
     3136           no-error .
     3137         end.
     3138         when "MANF_DATE_END_NW":U then do:
     3139           assign
     3140             v-manf_date_end_nw = get-date( buf_rec-fld.fldValue )
     3141           no-error .
     3142         end.
     3143         when "MANF_AKTL":U       then do:
     3144           assign
     3145             v-manf_aktl = decimal(buf_rec-fld.fldValue)
     3146           no-error .
     3147         end.
     3148         when "MANF_DATE_NW":U    then do:
     3149           assign
     3150             v-manf_date_nw = get-date( buf_rec-fld.fldValue )
     3151           no-error .
     3152         end.
     3153       end case.
     3154     end.
     3155     if v-manf_id = ? then return .
     3156     find first tt-alc-manufacturer
     3157       where tt-alc-manufacturer.manf_id = v-manf_id
     3158     no-error .
     3159     if not available tt-alc-manufacturer then do:
     3160       create tt-alc-manufacturer.
     3161       assign
     3162         tt-alc-manufacturer.manf_id          = v-manf_id
     3163         tt-alc-manufacturer.manf_name        = v-manf_name
     3164         tt-alc-manufacturer.manf_address     = v-manf_address
     3165         tt-alc-manufacturer.manf_egais       = v-manf_egais
     3166         tt-alc-manufacturer.manf_inn         = v-manf_inn
     3167         tt-alc-manufacturer.manf_date_bg_nw  = v-manf_date_bg_nw
     3168         tt-alc-manufacturer.manf_date_end_nw = v-manf_date_end_nw
     3169         tt-alc-manufacturer.manf_aktl        = v-manf_aktl
     3170         tt-alc-manufacturer.manf_date_nw     = v-manf_date_nw
     3171       .
     3172     end.
     3173   end.
     3174   end procedure.
     3175   procedure parse-alc-products :
     3176     define input  parameter p-rec-key as integer   no-undo .
     3177     define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     3178     define variable v-alpr_id        as decimal   no-undo .
     3179     define variable v-kalpr_id       as decimal   no-undo .
     3180     define variable v-kcont_id       as decimal   no-undo .
     3181     define variable v-volf_id        as decimal   no-undo .
     3182     define variable v-manf_id        as decimal   no-undo .
     3183     define variable v-alpr_egais     as character no-undo .
     3184     define variable v-alpr_code      as character no-undo .
     3185     define variable v-alpr_name      as character no-undo .
     3186     define variable v-alpr_scan_code as character no-undo .
     3187     define variable v-alpr_frtr      as decimal   no-undo .
     3188     define variable v-alpr_status    as character no-undo .
     3189   do
     3190   on error undo, return error return-value
     3191   :
     3192     for each buf_rec-fld
     3193         where buf_rec-fld.rec-key = p-rec-key
     3194     on error undo, return error
     3195     :
     3196       case buf_rec-fld.fldName :
     3197         when "ALPR_ID":U       then do:
     3198           assign
     3199             v-alpr_id =  decimal( buf_rec-fld.fldValue )
     3200           no-error .
     3201         end.
     3202         when "KALPR_ID":U      then do:
     3203           assign
     3204             v-kalpr_id = decimal( buf_rec-fld.fldValue )
     3205           no-error .
     3206         end.
     3207         when "KCONT_ID":U      then do:
     3208           assign
     3209             v-kcont_id = decimal( buf_rec-fld.fldValue )
     3210           no-error .
     3211         end.
     3212         when "VOLF_ID":U       then do:
     3213           assign
     3214             v-volf_id =  decimal( buf_rec-fld.fldValue )
     3215           no-error .
     3216         end.
     3217         when "MANF_ID":U       then do:
     3218           assign
     3219             v-manf_id = decimal( buf_rec-fld.fldValue )
     3220           no-error .
     3221         end.
     3222         when "ALPR_EGAIS":U    then do:
     3223           assign
     3224             v-alpr_egais =  buf_rec-fld.fldValue
     3225           .
     3226         end.
     3227         when "ALPR_CODE":U     then do:
     3228           assign
     3229             v-alpr_code =  buf_rec-fld.fldValue
     3230           .
     3231         end.
     3232         when "ALPR_NAME":U     then do:
     3233           assign
     3234             v-alpr_name =  buf_rec-fld.fldValue
     3235           .
     3236         end.
     3237         when "ALPR_SCAN_CODE":U then do:
     3238           assign
     3239             v-alpr_scan_code =  buf_rec-fld.fldValue
     3240           .
     3241         end.
     3242         when "ALPR_FRTR":U     then do:
     3243           assign
     3244             v-alpr_frtr = decimal( buf_rec-fld.fldValue )
     3245           no-error .
     3246         end.
     3247         when "ALPR_STATUS":U   then do:
     3248           assign
     3249             v-alpr_status = buf_rec-fld.fldValue
     3250           no-error .
     3251         end.
     3252       end case.
     3253     end.
     3254     if v-alpr_id = ? then return .
     3255     find first tt-alc-products
     3256       where tt-alc-products.alpr_id = v-alpr_id
     3257     no-error .
     3258     if not available tt-alc-products then do:
     3259       create tt-alc-products .
     3260       assign
     3261         tt-alc-products.alpr_id         = v-alpr_id
     3262         tt-alc-products.kalpr_id        = v-kalpr_id
     3263         tt-alc-products.kcont_id        = v-kcont_id
     3264         tt-alc-products.volf_id         = v-volf_id
     3265         tt-alc-products.manf_id         = v-manf_id
     3266         tt-alc-products.alpr_egais      = v-alpr_egais
     3267         tt-alc-products.alpr_code       = v-alpr_code
     3268         tt-alc-products.alpr_name       = v-alpr_name
     3269         tt-alc-products.alpr_scan_code  = v-alpr_scan_code
     3270         tt-alc-products.alpr_frtr       = v-alpr_frtr
     3271         tt-alc-products.alpr_status     = v-alpr_status
     3272       .
     3273     end.
     3274   end.
     3275   end procedure.
     3276   procedure parse-alc-suppliers :
     3277     define input  parameter p-rec-key as integer   no-undo .
     3278     define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     3279     define variable v-supp_id               as decimal    no-undo .
     3280     define variable v-supp_name             as character  no-undo .
     3281     define variable v-supp_adr_ur           as character  no-undo .
     3282     define variable v-supp_head_fio         as character  no-undo .
     3283     define variable v-supp_inn              as character  no-undo .
     3284     define variable v-supp_code_reas_state  as character  no-undo .
     3285     define variable v-supp_code_egais       as character  no-undo .
     3286     define variable v-supp_date_bg_nw       as date       no-undo .
     3287     define variable v-supp_date_end_nw      as date       no-undo .
     3288     define variable v-supp_date_nw          as date       no-undo .
     3289     define variable v-supp_prz_aktl         as decimal    no-undo .
     3290   do
     3291   on error undo, return error return-value
     3292   :
     3293     for each buf_rec-fld
     3294         where buf_rec-fld.rec-key = p-rec-key
     3295     on error undo, return error
     3296     :
     3297       case buf_rec-fld.fldName :
     3298         when "SUPP_ID":U              then do:
     3299           assign
     3300             v-supp_id = decimal( buf_rec-fld.fldValue )
     3301           no-error .
     3302         end.
     3303         when "SUPP_NAME":U            then do:
     3304           assign
     3305             v-supp_name = buf_rec-fld.fldValue
     3306           .
     3307         end.
     3308         when "SUPP_ADR_UR":U          then do:
     3309           assign
     3310             v-supp_adr_ur = buf_rec-fld.fldValue
     3311           .
     3312         end.
     3313         when "SUPP_HEAD_FIO":U        then do:
     3314           assign
     3315             v-supp_head_fio = buf_rec-fld.fldValue
     3316           .
     3317         end.
     3318         when "SUPP_INN":U             then do:
     3319           assign
     3320             v-supp_inn = buf_rec-fld.fldValue
     3321           .
     3322         end.
     3323         when "SUPP_CODE_REAS_STATE":U then do:
     3324           assign
     3325             v-supp_code_reas_state = buf_rec-fld.fldValue
     3326           .
     3327         end.
     3328         when "SUPP_CODE_EGAIS":U      then do:
     3329           assign
     3330             v-supp_code_egais = buf_rec-fld.fldValue
     3331           .
     3332         end.
     3333         when "SUPP_DATE_BG_NW":U      then do:
     3334           assign
     3335             v-supp_date_bg_nw = get-date( buf_rec-fld.fldValue )
     3336           no-error .
     3337         end.
     3338         when "SUPP_DATE_END_NW":U     then do:
     3339           assign
     3340             v-supp_date_end_nw = get-date( buf_rec-fld.fldValue )
     3341           no-error .
     3342         end.
     3343         when "SUPP_DATE_NW":U         then do:
     3344           assign
     3345             v-supp_date_nw = get-date( buf_rec-fld.fldValue )
     3346           no-error .
     3347         end.
     3348         when "SUPP_PRZ_AKTL":U        then do:
     3349           assign
     3350             v-supp_prz_aktl = decimal( buf_rec-fld.fldValue )
     3351           no-error .
     3352         end.
     3353       end case.
     3354     end.
     3355     if v-supp_id = ? then return .
     3356     find first tt-alc-supplier
     3357       where tt-alc-supplier.supp_id = v-supp_id
     3358     no-error .
     3359     if not available tt-alc-supplier then do:
     3360       create tt-alc-supplier.
     3361       assign
     3362         tt-alc-supplier.supp_id               = v-supp_id
     3363         tt-alc-supplier.supp_name             = v-supp_name
     3364         tt-alc-supplier.supp_adr_ur           = v-supp_adr_ur
     3365         tt-alc-supplier.supp_head_fio         = v-supp_head_fio
     3366         tt-alc-supplier.supp_inn              = v-supp_inn
     3367         tt-alc-supplier.supp_code_reas_state  = v-supp_code_reas_state
     3368         tt-alc-supplier.supp_code_egais       = v-supp_code_egais
     3369         tt-alc-supplier.supp_date_bg_nw       = v-supp_date_bg_nw
     3370         tt-alc-supplier.supp_date_end_nw      = v-supp_date_end_nw
     3371         tt-alc-supplier.supp_date_nw          = v-supp_date_nw
     3372         tt-alc-supplier.supp_prz_aktl         = v-supp_prz_aktl
     3373       .
     3374     end.
     3375   end.
     3376   end procedure.
     3377   procedure fill-alcohol :
     3378     define buffer buf_egais-gds for ub.egais-gds.
     3379   do
     3380   on error undo, return error return-value
     3381   :
     3382   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     3383     if  log-manager:logfile-name ne ?
     3384     then DO:
     3385         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3386     end.
     3387     if not session:batch-mode then
     3388     do:
     3389       VIEW FRAME InfoFrame.
     3390       mFrameView = true.
     3391     end.
     3392      v-button-stop = false .
     3393         if mFrameView
     3394         then do:
     3395         if v-button-stop then view STOPBTN in frame InfoFrame.
     3396                          else Hide STOPBTN in frame InfoFrame.
     3397         end.
     3398     assign
     3399       v-i = 0
     3400     .
     3401     _alc-product:
     3402     for each tt-alc-products :
     3403       assign
     3404         v-i = v-i + 1
     3405         v-alc-count-t = v-alc-count-t + 1
     3406       .
     3407   IF ( v-i modulo v-account = 0 )  then DO:
     3408    Assign
     3409       v-kol-spice = (50 - LENGTH('Запись в БД алкогольных товаров...')) / 2
     3410       RecordsString = fill(' ',v-kol-spice) + string('Запись в БД алкогольных товаров...')
     3411       .
     3412             if  log-manager:logfile-name ne ?
     3413             then DO:
     3414                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3415             end.
     3416              if mFrameView
     3417              then do:
     3418               DISPLAY
     3419                 v-i @ RecordsDone
     3420                 RecordsString   @ RecordsString
     3421                 WITH FRAME InfoFrame.
     3422              end.
     3423   End.
     3424      if v-button-stop then  DO:
     3425            if mFrameView
     3426            then
     3427               PROCESS EVENTS.
     3428            IF StopProcessing THEN DO:
     3429            RETURN error.
     3430            End.
     3431      end.
     3432       find first tt-alc-container
     3433         where tt-alc-container.kcont_id = tt-alc-products.kcont_id
     3434       no-error .
     3435       if not available tt-alc-container then do:
     3436         run put-error in this-procedure ( substitute( "В записи товара &1 неизвестный код тары &2 . Товар не импортирован."
     3437                                                     , tt-alc-products.alpr_id
     3438                                                     , tt-alc-products.kcont_id
     3439                                                     )
     3440                                         ) .
     3441         next _alc-product.
     3442       end.
     3443       find first tt-alc-volume
     3444         where tt-alc-volume.volf_id = tt-alc-products.volf_id
     3445       no-error .
     3446       if not available tt-alc-volume then do :
     3447         run put-error in this-procedure ( substitute( "В записи товара &1 неизвестный код объема &2 . Товар не импортирован."
     3448                                                     , tt-alc-products.alpr_id
     3449                                                     , tt-alc-products.volf_id
     3450                                                     )
     3451                                         ) .
     3452         next _alc-product.
     3453       end.
     3454       find first tt-alc-manufacturer
     3455         where tt-alc-manufacturer.manf_id = tt-alc-products.manf_id
     3456       no-error .
     3457       if not available tt-alc-manufacturer then do:
     3458         run put-error in this-procedure ( substitute( "В записи товара &1 неизвестный код производителя &2 . Товар не импортирован."
     3459                                                     , tt-alc-products.alpr_id
     3460                                                     , tt-alc-products.manf_id
     3461                                                     )
     3462                                         ) .
     3463         next _alc-product.
     3464       end.
     3465       find first buf_egais-gds no-lock
     3466         where buf_egais-gds.alpr-id = tt-alc-products.alpr_id
     3467       no-error .
     3468       if not available buf_egais-gds
     3469       then do:
     3470         run cur-time in this-procedure ( output v-today
     3471                                        , output v-time
     3472                                        ).
     3473         create buf_egais-gds.
     3474         assign
     3475           buf_egais-gds.alpr-id         = tt-alc-products.alpr_id
     3476           buf_egais-gds.alpr-code-egais = tt-alc-products.alpr_egais
     3477           buf_egais-gds.alpr-code       = tt-alc-products.alpr_code
     3478           buf_egais-gds.alpr-frtr       = tt-alc-products.alpr_frtr
     3479           buf_egais-gds.alpr-name       = tt-alc-products.alpr_name
     3480           buf_egais-gds.alpr-scan-code  = tt-alc-products.alpr_scan_code
     3481           buf_egais-gds.alpr-status     = tt-alc-products.alpr_status
     3482           buf_egais-gds.kalpr-id        = tt-alc-products.kalpr_id
     3483           buf_egais-gds.kcont-id        = tt-alc-products.kcont_id
     3484           buf_egais-gds.manf-id         = tt-alc-products.manf_id
     3485           buf_egais-gds.producer-name   = tt-alc-manufacturer.manf_name
     3486           buf_egais-gds.tare            = tt-alc-container.kcont_name
     3487           buf_egais-gds.volf-id         = tt-alc-products.volf_id
     3488           buf_egais-gds.volume          = tt-alc-volume.volf_volume
     3489           buf_egais-gds.imp-date        = v-today
     3490           buf_egais-gds.imp-time        = v-time
     3491           buf_egais-gds.imp-user-id     = v-cntxt-userid
     3492         .
     3493         release buf_egais-gds no-error .
     3494         if error-status :error
     3495         then do:
     3496           run put-error in this-procedure ( substitute( "Ошибка записи в БД товара с кодом : &1 - &2. Товар не импортирован. &3&4&3&5&3&6"
     3497                                                       , tt-alc-products.alpr_id
     3498                                                       , tt-alc-products.alpr_name
     3499                                                       , chr(10)
     3500                                                       , error-status :get-message(1)
     3501                                                       , error-status :get-message(2)
     3502                                                       , error-status :get-message(3)
     3503                                                       )
     3504                                           ) .
     3505           next _alc-product.
     3506         end.
     3507         else do:
     3508            assign
     3509              v-alc-count-l = v-alc-count-l + 1
     3510            .
     3511         end.
     3512       end.
     3513       else do:
     3514         run put-error in this-procedure ( substitute( "Уже есть запись товара с кодом : &1 - &2. Товар не импортирован. "
     3515                                                     , tt-alc-products.alpr_id
     3516                                                     , tt-alc-products.alpr_name
     3517                                                     )
     3518                                         ) .
     3519       end.
     3520     end.
     3521   if mFrameView
     3522   then do:
     3523      HIDE FRAME InfoFrame.
     3524   end.
     3525   end.
     3526   end procedure.
     3527   procedure fill-suppliers :
     3528     define buffer buf_egais-clients for ub.egais-clients.
     3529     define variable v-obj-type like ub.clients.obj-type no-undo .
     3530     define variable v-obj-code like ub.clients.obj-code no-undo .
     3531   do
     3532   on error undo, return error return-value
     3533   :
     3534   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     3535     if  log-manager:logfile-name ne ?
     3536     then DO:
     3537         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3538     end.
     3539     if not session:batch-mode then
     3540     do:
     3541       VIEW FRAME InfoFrame.
     3542       mFrameView = true.
     3543     end.
     3544      v-button-stop = false .
     3545         if mFrameView
     3546         then do:
     3547         if v-button-stop then view STOPBTN in frame InfoFrame.
     3548                          else Hide STOPBTN in frame InfoFrame.
     3549         end.
     3550     assign
     3551       v-i = 0
     3552     .
     3553     _alc-supplier :
     3554     for each tt-alc-supplier :
     3555       assign
     3556         v-obj-type  = "":U
     3557         v-obj-code  = 0
     3558         v-i           = v-i + 1
     3559         v-sup-count-t = v-sup-count-t + 1
     3560       .
     3561   IF ( v-i modulo v-account = 0 )  then DO:
     3562    Assign
     3563       v-kol-spice = (50 - LENGTH('Запись в БД поставщиков...')) / 2
     3564       RecordsString = fill(' ',v-kol-spice) + string('Запись в БД поставщиков...')
     3565       .
     3566             if  log-manager:logfile-name ne ?
     3567             then DO:
     3568                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3569             end.
     3570              if mFrameView
     3571              then do:
     3572               DISPLAY
     3573                 v-i @ RecordsDone
     3574                 RecordsString   @ RecordsString
     3575                 WITH FRAME InfoFrame.
     3576              end.
     3577   End.
     3578      if v-button-stop then  DO:
     3579            if mFrameView
     3580            then
     3581               PROCESS EVENTS.
     3582            IF StopProcessing THEN DO:
     3583            RETURN error.
     3584            End.
     3585      end.
     3586       find first buf_egais-clients no-lock
     3587         where buf_egais-clients.supp-id = tt-alc-supplier.supp_id
     3588       no-error .
     3589       if not available buf_egais-clients
     3590       then do:
     3591         if tt-alc-supplier.supp_inn <> "":U then do :
     3592           run find-client in this-procedure ( input tt-alc-supplier.supp_inn
     3593                                             , output v-obj-type
     3594                                             , output v-obj-code
     3595                                             ) .
     3596         end.
     3597         run cur-time in this-procedure ( output v-today
     3598                                        , output v-time
     3599                                        ) .
     3600         create buf_egais-clients.
     3601         assign
     3602           buf_egais-clients.supp-id               = tt-alc-supplier.supp_id
     3603           buf_egais-clients.obj-code              = v-obj-code
     3604           buf_egais-clients.obj-type              = v-obj-type
     3605           buf_egais-clients.supp-adr-ur           = tt-alc-supplier.supp_adr_ur
     3606           buf_egais-clients.supp-code-egais       = tt-alc-supplier.supp_code_egais
     3607           buf_egais-clients.supp-code-reas-state  = tt-alc-supplier.supp_code_reas_state
     3608           buf_egais-clients.supp-head-fio         = tt-alc-supplier.supp_head_fio
     3609           buf_egais-clients.supp-inn              = tt-alc-supplier.supp_inn
     3610           buf_egais-clients.supp-name             = tt-alc-supplier.supp_name
     3611           buf_egais-clients.imp-date              = v-today
     3612           buf_egais-clients.imp-time              = v-time
     3613           buf_egais-clients.imp-user-id           = v-cntxt-userid
     3614         .
     3615         release buf_egais-clients no-error .
     3616         if error-status :error
     3617         then do:
     3618           run put-error in this-procedure ( substitute( "Ошибка при записи в БД поставщика с кодом : &1  - &2. Поставщик не импортирован. &3&4&3&5&3&6"
     3619                                                       , tt-alc-supplier.supp_id
     3620                                                       , tt-alc-supplier.supp_name
     3621                                                       , chr(10)
     3622                                                       , error-status :get-message(1)
     3623                                                       , error-status :get-message(2)
     3624                                                       , error-status :get-message(3)
     3625                                                       )
     3626                                           ) .
     3627           next _alc-supplier.
     3628         end.
     3629         else do:
     3630            assign
     3631              v-sup-count-l = v-sup-count-l + 1
     3632            .
     3633         end.
     3634       end.
     3635       else do:
     3636         run put-error in this-procedure ( substitute( "Уже есть запись поставщика с кодом : &1  - &2. Поставщик не импортирован. "
     3637                                                     , tt-alc-supplier.supp_id
     3638                                                     , tt-alc-supplier.supp_name
     3639                                                     )
     3640                                         ) .
     3641       end.
     3642     end.
     3643   if mFrameView
     3644   then do:
     3645      HIDE FRAME InfoFrame.
     3646   end.
     3647   end.
     3648   end procedure.
     3649   procedure calc-egais-gds :
     3650     define output parameter p-tot-records as integer   no-undo .
     3651     define buffer buf_egais-gds for ub.egais-gds.
     3652     define variable v-i as integer   no-undo .
     3653   do
     3654   on error undo, return error return-value
     3655   :
     3656     for each buf_egais-gds no-lock
     3657     :
     3658       assign
     3659         v-i = v-i + 1
     3660       .
     3661     end.
     3662     assign
     3663       p-tot-records = v-i
     3664     .
     3665   end.
     3666   end procedure.
     3667   procedure calc-egais-clients :
     3668     define output parameter p-tot-records as integer   no-undo .
     3669     define buffer buf_egais-clients for ub.egais-clients.
     3670     define variable v-i as integer   no-undo .
     3671   do
     3672   on error undo, return error return-value
     3673   :
     3674     for each buf_egais-clients no-lock
     3675     :
     3676       assign
     3677         v-i = v-i + 1
     3678       .
     3679     end.
     3680     assign
     3681       p-tot-records = v-i
     3682     .
     3683   end.
     3684   end procedure.
     3685   function get-date return date (input p-str as character) .
     3686     define variable v-year  as integer   no-undo .
     3687     define variable v-month as integer   no-undo .
     3688     define variable v-day   as integer   no-undo .
     3689     define variable v-date  as date      no-undo .
     3690     define variable v-count as integer   no-undo .
     3691     assign
     3692       v-count = num-entries( p-str , '-' )
     3693     .
     3694     if v-count <> 3 then return ?.
     3695     assign
     3696       v-year  = integer( entry( 1 , p-str , '-' ) )
     3697       v-month = integer( entry( 2 , p-str , '-' ) )
     3698       v-day   = integer( entry( 3 , p-str , '-' ) )
     3699       v-date  = date( v-month , v-day , v-year )
     3700     no-error
     3701     .
     3702     return v-date.
     3703   end function.
