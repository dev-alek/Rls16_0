        1   DEFINE TEMP-TABLE temp-clients NO-UNDO LIKE ub.clients.
        2   DEFINE TEMP-TABLE temp-dis-rule NO-UNDO LIKE ub.dis-rule
        3          field old-des as character.
        4   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter p-list-mode as character no-undo .
        6   define input parameter p-rule-num as integer no-undo .
        7   define input parameter p-obj-type as character no-undo .
        8   define input parameter p-obj-code as integer no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Процедура копирования скидок типа 22 в тип 8".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define new global shared variable g#language as character no-undo .
      320   if g#language <> '' and g#language <> 'rus':U then do:
      321     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      322   end.
      323   define new global shared variable g#library  as handle no-undo .
      324   define new global shared variable g#library2 as handle no-undo .
      325   define   shared variable g#auto as logical no-undo.
      326   define   shared variable g#news as logical no-undo.
      327   define   shared variable g#oxml as logical no-undo.
      328   define   shared variable g#esys as logical no-undo.
      329   define   shared variable g#news-source-db as integer no-undo.
      330   define   shared variable g#esys-source-esys as integer no-undo.
      331   define   shared variable g#db-num as integer   no-undo .
      332   define   shared variable g#userid as character no-undo .
      333   define   shared variable g#passwd as character no-undo .
      334   procedure proc-alt-shift-f2:
      335     if not ibs.th.gbl.gbl-var:rcode
      336   then
      337     run gbl\inidebug.p .
      338   end.
      339   procedure proc-alt-shift-f3:
      340     run gbl/prvssinf.p
      341       ( input this-procedure
      342       ) .
      343   end.
      344   define variable v-inform-launched as logical no-undo initial false .
      345   procedure proc-alt-shift-f4:
      346     define variable v-action as character no-undo .
      347     if v-inform-launched = false then do:
      348       assign
      349         v-inform-launched = true
      350       .
      351       run gbl/d-inform.w
      352         (  input self
      353         ,  input this-procedure
      354         , output v-action
      355         ) no-error .
      356       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      357       assign
      358         v-inform-launched = false
      359       .
      360     end.
      361   end.
      362   procedure proc-alt-f1:
      363     run gbl/corrhelp.p
      364       (input this-procedure
      365       ) .
      366   end .
      367   on alt-shift-f2 anywhere do:
      368     run proc-alt-shift-f2.
      369   end.
      370   on alt-shift-f3 anywhere do:
      371     run proc-alt-shift-f3 in this-procedure .
      372   end.
      373   on alt-shift-f4 anywhere do:
      374     run proc-alt-shift-f4 in this-procedure.
      375   end.
      376   on alt-f1 anywhere do:
      377     run proc-alt-f1 in this-procedure .
      378   end.
      379   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380     define variable v-cntxt-db-num        as integer   no-undo .
      381     define variable v-cntxt-userid        as character no-undo .
      382     define variable v-cntxt-level         as character no-undo .
      383     define variable v-cntxt-host-code-obj as integer   no-undo .
      384     define variable v-cntxt-obj-type      as character no-undo .
      385     define variable v-cntxt-obj-code      as integer   no-undo .
      386     define variable v-cntxt-db-num-obj    as integer   no-undo .
      387     define variable v-cntxt-is-admin      as logical   no-undo .
      388   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      389   define temp-table userobjs_temp-user-obj no-undo
      390     field obj-type as character
      391     field obj-code as integer
      392     index xpk is primary unique obj-type obj-code
      393     .
      394   procedure userobjs_clear :
      395     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      396     do
      397     on error undo, return error return-value
      398     :
      399       for each buf_userobjs_temp-user-obj
      400       on error undo, return error return-value
      401       :
      402         delete buf_userobjs_temp-user-obj .
      403       end.
      404     end.
      405   end .
      406   procedure userobjs_object-count :
      407     define output parameter p-total-count as integer   no-undo .
      408     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      409     do
      410     on error undo, return error return-value
      411     :
      412       assign
      413         p-total-count = 0
      414       .
      415       for each buf_userobjs_temp-user-obj
      416       on error undo, return error return-value
      417       :
      418         assign
      419           p-total-count = p-total-count + 1
      420         .
      421       end.
      422     end.
      423   end.
      424   procedure userobjs_append :
      425      define input  parameter p-obj-type as character no-undo .
      426      define input  parameter p-obj-code as integer   no-undo .
      427     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      428     do
      429     on error undo, return error return-value
      430     :
      431       find first buf_userobjs_temp-user-obj
      432         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      433           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      434         no-error .
      435       if not available buf_userobjs_temp-user-obj
      436       then do:
      437         create buf_userobjs_temp-user-obj .
      438         assign
      439           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      440           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      441         .
      442       end.
      443     end.
      444   end.
      445   procedure userobjs_object-exist :
      446     define output parameter p-object-exist as logical   no-undo .
      447     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      448     do
      449     on error undo, return error return-value
      450     :
      451       find first buf_userobjs_temp-user-obj
      452         no-error .
      453       if not available buf_userobjs_temp-user-obj
      454       then do:
      455         assign
      456           p-object-exist = false
      457         .
      458       end.
      459       else do:
      460         assign
      461           p-object-exist = true
      462         .
      463       end.
      464     end.
      465   end.
      466   procedure userobjs_transfer :
      467     define input  parameter p-callback-handle as handle no-undo .
      468     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      469     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      470     do
      471     on error undo, return error return-value
      472     :
      473       if valid-handle(p-callback-handle) <> true
      474       then do:
      475         message
      476           vss-workfile vss-revision vss-description skip
      477           "Ошибка задания входных параметров" skip
      478           "Неизвестный указатель на процедуру" skip
      479           view-as alert-box error .
      480         undo, return error return-value .
      481       end.
      482       if p-callback-handle :get-signature("userobjs_append") = ""
      483       then do:
      484         message
      485           vss-workfile vss-revision vss-description skip
      486           "Ошибка задания входных параметров" skip
      487           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      488                     ,p-callback-handle :file-name
      489                     ) skip
      490           view-as alert-box error .
      491         undo, return error return-value .
      492       end.
      493       for each buf_userobjs_temp-user-obj
      494       on error undo, return error return-value
      495       :
      496         run userobjs_append in p-callback-handle
      497           (input  buf_userobjs_temp-user-obj.obj-type
      498           ,input  buf_userobjs_temp-user-obj.obj-code
      499           ) .
      500       end.
      501     end.
      502   end procedure.
      503   procedure userobjs_select-one :
      504      define input  parameter parparentproc     as widget-handle no-undo .
      505      define input  parameter p-db-num          as integer   no-undo .
      506      define input  parameter p-user-id         as character no-undo .
      507      define input  parameter p-host-code-obj   as integer   no-undo .
      508      define input  parameter p-obj-type        as character no-undo .
      509      define input  parameter p-obj-code        as integer   no-undo .
      510      define output parameter p-user-select     as logical   no-undo .
      511      define output parameter p-select-obj-type as character no-undo .
      512      define output parameter p-select-obj-code as character no-undo .
      513     do
      514     on error undo, return error return-value
      515     :
      516       run gbl/userobjs.w
      517         (input  parparentproc
      518         ,input  this-procedure :handle
      519         ,input  p-db-num
      520         ,input  p-user-id
      521         ,input  p-host-code-obj
      522         ,input  p-obj-type
      523         ,input  p-obj-code
      524         ,INPUT  "b-sel"
      525         ,output p-user-select
      526         ,output p-select-obj-type
      527         ,output p-select-obj-code
      528         ) .
      529     end.
      530   end.
      531   procedure userobjs_select-many :
      532     define input  parameter parparentproc   as widget-handle no-undo .
      533     define input  parameter p-db-num        as integer   no-undo .
      534     define input  parameter p-user-id       as character no-undo .
      535     define input  parameter p-host-code-obj as integer   no-undo .
      536     define input  parameter p-obj-type      as character no-undo .
      537     define input  parameter p-obj-code      as integer   no-undo .
      538     define output parameter p-user-select   as logical   no-undo .
      539     define variable v-select-obj-type as character no-undo .
      540     define variable v-select-obj-code as integer   no-undo .
      541     do
      542     on error undo, return error return-value
      543     :
      544       run gbl/userobjs.w
      545         (input  parparentproc
      546         ,input  this-procedure :handle
      547         ,input  p-db-num
      548         ,input  p-user-id
      549         ,input  p-host-code-obj
      550         ,input  p-obj-type
      551         ,input  p-obj-code
      552         ,INPUT  "b-sel,b-mark"
      553         ,output p-user-select
      554         ,output v-select-obj-type
      555         ,output v-select-obj-code
      556         ) .
      557     end.
      558   end.
      559   procedure thobjs :
      560      define input        parameter parparentproc     as widget-handle no-undo .
      561      define input        parameter i-bttns           as character     no-undo .
      562      define input        parameter i-list-mode       as character     no-undo.
      563      define input        parameter i-obj-type        as character     no-undo.
      564      define input        parameter i-db-num          as integer       no-undo.
      565      define input        parameter i-host-code       as integer       no-undo.
      566      define input-output parameter p-rid-list        as character     no-undo .
