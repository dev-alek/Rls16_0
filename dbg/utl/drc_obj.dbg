     1851               where buf_temp-browse-handle.browse-type = 'width':u
     1852             on error undo, next
     1853             :
     1854               assign
     1855                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1856               .
     1857             end.
     1858             assign
     1859               v-diasize-browse-handle :width = v-browse-width
     1860             .
     1861             for each buf_temp-diasize-handle
     1862             on error undo, next
     1863             :
