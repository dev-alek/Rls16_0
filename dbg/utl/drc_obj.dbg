     1919         :
     1920           if  v-object-handle <> v-diasize-browse-handle :handle
     1921           and v-object-handle <> v-diasize-resize-button
     1922           and can-query(v-object-handle, "row")
     1923           and can-query(v-object-handle, "height")
     1924           and ( v-object-handle :col + v-object-handle :width
     1925                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1926               )
     1927           then do:
     1928             find first buf_temp-browse-handle
     1929               where buf_temp-browse-handle.browse-type   = 'width':u
     1930                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1931               no-error .
     1932             if available buf_temp-browse-handle
     1933             then do:
     1934             end.
     1935             else do:
     1936               create buf_temp-diasize-handle .
     1937               assign
     1938                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1939                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1940               .
     1941             end.
     1942           end.
     1943           assign
     1944             v-object-handle = v-object-handle :next-sibling
     1945           .
     1946         end.
     1947         assign
     1948           v-field-group-handle = v-field-group-handle :next-sibling
     1949         .
     1950       end.
     1951       do with frame Dialog-Frame
     1952       :
     1953         hide v-diasize-resize-button .
     1954         v-diasize-resize-button :row = 1.
     1955         v-diasize-resize-button :column = 1.
     1956       end.
     1957       if p-change-value > 0
     1958       then do:
     1959         if frame Dialog-Frame :scrollable = true
     1960         then do:
     1961           assign
     1962             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1963             no-error .
     1964           if error-status :error
     1965           or error-status :get-message(1) <> ""
     1966           then do:
     1967             undo move_block, retry move_block.
     1968           end.
     1969         end.
     1970         assign
     1971           frame Dialog-Frame :width = v-frame-width + p-change-value
     1972           no-error .
     1973         if error-status :error
     1974         or error-status :get-message(1) <> ""
     1975         then do:
     1976           undo move_block, retry move_block.
     1977         end.
     1978         assign
     1979           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1980         no-error .
     1981         if error-status :error
     1982         or error-status :get-message(1) <> ""
     1983         then do:
     1984           undo move_block, retry move_block.
     1985         end.
     1986         for each buf_temp-browse-handle
     1987           where buf_temp-browse-handle.browse-type = 'width':u
     1988         on error undo move_block, retry move_block
     1989         :
     1990           assign
     1991             buf_temp-browse-handle.browse-handle :width
     1992               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1993             no-error .
     1994           if error-status :error
     1995           or error-status :get-message(1) <> ""
     1996           then do:
     1997             undo move_block, retry move_block .
     1998           end.
     1999         end.
     2000         for each buf_temp-diasize-handle
     2001         on error undo move_block, retry move_block
     2002         :
     2003           assign
     2004             v-object-handle = buf_temp-diasize-handle.handle-value
     2005           .
     2006           if v-object-handle <> v-diasize-resize-button
     2007           then do:
     2008             assign
     2009               v-object-handle :col = v-object-handle :col + p-change-value
     2010               no-error .
     2011             if error-status :error
     2012             or error-status :get-message(1) <> ""
     2013             then do:
     2014               undo move_block, retry move_block .
     2015             end.
     2016           end.
     2017         end.
     2018       end.
     2019       else do:
     2020         for each buf_temp-diasize-handle
     2021         on error undo move_block, retry move_block
     2022         :
     2023           assign
     2024             v-object-handle = buf_temp-diasize-handle.handle-value
     2025           .
     2026           if v-object-handle <> v-diasize-resize-button
     2027           then do:
     2028             assign
     2029               v-object-handle :col = v-object-handle :col + p-change-value
     2030               no-error .
     2031             if error-status :error
     2032             or error-status :get-message(1) <> ""
     2033             then do:
     2034               undo move_block, retry move_block .
     2035             end.
     2036           end.
     2037         end.
     2038         for each buf_temp-browse-handle
     2039           where buf_temp-browse-handle.browse-type = 'width':u
     2040         on error undo move_block, retry move_block
     2041         :
     2042           assign
     2043             buf_temp-browse-handle.browse-handle :width
     2044               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2045             no-error .
     2046           if error-status :error
     2047           or error-status :get-message(1) <> ""
     2048           then do:
     2049             undo move_block, retry move_block .
     2050           end.
     2051         end.
     2052         assign
     2053           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2054           no-error .
     2055         if error-status :error
     2056         or error-status :get-message(1) <> ""
     2057         then do:
     2058           undo move_block, retry move_block.
     2059         end.
     2060         assign
     2061           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2062         no-error .
     2063         if error-status :error
     2064         or error-status :get-message(1) <> ""
     2065         then do:
     2066           undo move_block, retry move_block.
     2067         end.
     2068         if frame Dialog-Frame :scrollable = true
     2069         then do:
     2070           assign
     2071             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2072           no-error .
     2073           if error-status :error
     2074           or error-status :get-message(1) <> ""
     2075           then do:
     2076             undo move_block, retry move_block.
     2077           end.
     2078         end.
     2079       end.
     2080       if p-move-resize
     2081       then do:
     2082         run diasize_position-resize-button in this-procedure .
     2083       end.
     2084       if v-diasize-wndstore = true
     2085       then do:
     2086         if connected("ub") = true
     2087         then do:
     2088           define variable v-cntxt-db-num        as integer   no-undo .
     2089           define variable v-cntxt-userid        as character no-undo .
     2090           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2091                                             , OUTPUT v-cntxt-userid
     2092                                             ) .
     2093           run gbl/wndsizew.p
     2094             (input  v-cntxt-db-num
     2095             ,input  v-cntxt-userid
     2096             ,input  v-diasize-proc-name
     2097             ,input  'width':u
     2098             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2099             ) .
     2100         end.
     2101       end.
     2102     end.
     2103     assign
     2104       v-diasize-change-size = false
     2105     .
     2106   end procedure.
     2107   procedure diasize_set-width :
     2108     define input  parameter p-new-width  as decimal   no-undo .
     2109     define input  parameter p-move-resize as logical   no-undo .
     2110     do
     2111     on error undo, return error return-value
     2112     :
     2113       run diasize_change-width in this-procedure
     2114         (input  (p-new-width - frame Dialog-Frame :width)
     2115         ,input  p-move-resize
     2116         ) .
     2117     end.
     2118   end procedure.
     2119   procedure diasize_position-resize-button :
     2120     do with frame Dialog-Frame
     2121     :
     2122       hide v-diasize-resize-button .
     2123       assign
     2124         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2125                     - 1
     2126                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2127         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2128                     - 1
     2129                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2130       .
     2131       view v-diasize-resize-button .
     2132     end.
     2133   end procedure.
     2134   on alt-right anywhere
     2135   do:
     2136     run diasize_change-width in this-procedure
     2137       (input 1
     2138       ,input true
     2139       ) .
     2140     return no-apply .
     2141   end.
     2142   on alt-left anywhere
     2143   do:
     2144     run diasize_change-width in this-procedure
     2145       (input -1
     2146       ,input true
     2147       ) .
     2148     return no-apply .
     2149   end.
     2150   on alt-down anywhere
     2151   do:
     2152     run diasize_change-height in this-procedure
     2153       (input 1
     2154       ,input true
     2155       ) .
     2156     return no-apply .
     2157   end.
     2158   on alt-up anywhere
     2159   do:
     2160     run diasize_change-height in this-procedure
     2161       (input -1
     2162       ,input true
     2163       ) .
     2164     return no-apply .
     2165   end.
     2166   on alt-enter of frame Dialog-Frame
     2167   do:
     2168     run diasize_maximize in this-procedure
     2169       (input  ?
     2170       ).
     2171     return no-apply .
     2172   end.
     2173   procedure diasize_end-move :
     2174     do
     2175     on error undo, return error return-value
     2176     :
     2177       define variable v-row-delta as decimal   no-undo .
     2178       define variable v-col-delta as decimal   no-undo .
     2179       define variable v-new-row as decimal   no-undo .
     2180       define variable v-new-col as decimal   no-undo .
     2181       assign
     2182         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2183         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2184       .
     2185       assign
     2186         v-row-delta = v-new-row - frame Dialog-Frame :height
     2187         v-col-delta = v-new-col - frame Dialog-Frame :width
     2188       .
     2189       run diasize_change-height in this-procedure
     2190         (input v-row-delta
     2191         ,input true
     2192         ) .
     2193       run diasize_change-width in this-procedure
     2194         (input v-col-delta
     2195         ,input true
     2196         ) .
     2197     end.
     2198   end procedure.
     2199   procedure diasize_maximize :
     2200     define input  parameter p-action as logical   no-undo .
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       if p-action = ?
     2205       then do:
     2206         if v-diasize-need-maximize = true
     2207         then do:
     2208           assign
     2209             p-action = true
     2210           .
     2211         end.
     2212         else do:
     2213           assign
     2214             p-action = false
     2215           .
     2216         end.
     2217       end.
     2218       if p-action = true
     2219       then do:
     2220         run diasize_change-height in this-procedure
     2221           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2222               - frame Dialog-Frame :height-chars
     2223           ,input true
     2224           ) .
     2225         run diasize_change-width in this-procedure
     2226           (input session :width-chars
     2227               - frame Dialog-Frame :width-chars
     2228           ,input true
     2229           ) .
     2230         assign
     2231           v-diasize-need-maximize = false
     2232         .
     2233       end.
     2234       else do:
     2235         run diasize_change-width in this-procedure
     2236           (input v-diasize-orig-frame-width
     2237               - frame Dialog-Frame :width-chars
     2238           ,input true
     2239           ) .
     2240         run diasize_change-height in this-procedure
     2241           (input v-diasize-orig-frame-height
     2242               - frame Dialog-Frame :height-chars
     2243           ,input true
     2244           ) .
     2245         assign
     2246           v-diasize-need-maximize = true
     2247         .
     2248       end.
     2249     end.
     2250   end procedure.
     2251   procedure diasize_restore-orig-size :
     2252     do
     2253     on error undo, return error return-value
     2254     :
     2255       assign
     2256         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2257         v-diasize-current-frame-height = frame Dialog-Frame :height
     2258       .
     2259       run diasize_set-height in this-procedure
     2260         (input  v-diasize-orig-frame-height
     2261         ,input  true
     2262         ) .
     2263       run diasize_set-width in this-procedure
     2264         (input  v-diasize-orig-frame-width
     2265         ,input  true
     2266         ) .
     2267     end.
     2268   end procedure.
     2269   procedure diasize_restore-current-size :
     2270     do
     2271     on error undo, return error return-value
     2272     :
     2273       run diasize_set-height in this-procedure
     2274         (input  v-diasize-current-frame-height
     2275         ,input  true
     2276         ) .
     2277       run diasize_set-width in this-procedure
     2278         (input  v-diasize-current-frame-width
     2279         ,input  true
     2280         ) .
     2281     end.
     2282   end procedure.
     2283   procedure diasize_set-browse-handle :
     2284     define input  parameter p-browse-handle as handle   no-undo .
     2285     define buffer buf_temp-browse-handle for temp-browse-handle .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       assign
     2290         v-diasize-browse-handle = p-browse-handle
     2291       .
     2292       for each buf_temp-browse-handle
     2293       on error undo, return error return-value
     2294       :
     2295         delete buf_temp-browse-handle .
     2296       end.
     2297     end.
     2298   end procedure.
     2299   procedure diasize_add_browse :
     2300     define input  parameter p-browse-type   as character no-undo .
     2301     define input  parameter p-browse-handle as handle    no-undo .
     2302     define buffer buf_temp-browse-handle for temp-browse-handle .
     2303     do
     2304     on error undo, return error return-value
     2305     :
     2306       assign
     2307         v-diasize-browse-number = v-diasize-browse-number + 1
     2308       .
     2309       create buf_temp-browse-handle .
     2310       assign
     2311         buf_temp-browse-handle.browse-type   = p-browse-type
     2312         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2313         buf_temp-browse-handle.browse-handle = p-browse-handle
     2314       .
     2315     end.
     2316   end procedure.
     2317   procedure diasize_init :
     2318     define variable v-default-value    as logical   no-undo .
     2319     define variable v-restore-saved    as logical   no-undo .
     2320     define variable v-resize-value-str as character no-undo .
     2321     do
     2322     on error undo, return error return-value
     2323     :
     2324       do with frame Dialog-Frame
     2325       :
     2326         assign
     2327           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2328           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2329           v-diasize-browse-handle     = browse BR-dis-rule :handle
     2330         .
     2331         create button v-diasize-resize-button
     2332         assign
     2333           parent        = frame Dialog-Frame :first-child
     2334           label         = "s"
     2335           height-pixels = 16
     2336           width-pixels  = 16
     2337           visible       = true
     2338           sensitive     = true
     2339           movable       = true
     2340           triggers:
     2341             on end-move persistent run diasize_end-move in this-procedure .
     2342           end triggers.
     2343         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2344         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2345         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2346         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2347         assign
     2348           v-diasize-wndmax = false
     2349         .
     2350         if connected("ub") = true
     2351         then do:
     2352           define variable v-cntxt-db-num        as integer   no-undo .
     2353           define variable v-cntxt-userid        as character no-undo .
     2354           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2355                                             , OUTPUT v-cntxt-userid
     2356                                             ) .
     2357           run gbl/wndpar_r.p
     2358             (input  v-cntxt-db-num
     2359             ,input  v-cntxt-userid
     2360             ,input  'wndmax':U
     2361             ,output v-diasize-wndmax
     2362             ,output v-default-value
     2363             ) .
     2364         end.
     2365         assign
     2366           v-diasize-wndstore = false
     2367         .
     2368         if connected("ub") = true
     2369         then do:
     2370           run gbl/wndpar_r.p
     2371             (input  v-cntxt-db-num
     2372             ,input  v-cntxt-userid
     2373             ,input  'wndstore':U
     2374             ,output v-diasize-wndstore
     2375             ,output v-default-value
     2376             ) .
     2377         end.
     2378         assign
     2379           v-diasize-proc-name = entry(1, program-name(2), '.')
     2380         .
     2381         if v-diasize-wndstore = true
     2382         then do:
     2383           assign
     2384             v-restore-saved = false
     2385           .
     2386           if connected("ub") = true
     2387           then do:
     2388             run gbl/wndsizer.p
     2389               (input  v-cntxt-db-num
     2390               ,input  v-cntxt-userid
     2391               ,input  v-diasize-proc-name
     2392               ,input  'height':u
     2393               ,output v-resize-value-str
     2394               ) .
     2395             if v-resize-value-str <> '':U
     2396             then do:
     2397               run diasize_change-height in this-procedure
     2398                 (input  integer(v-resize-value-str)
     2399                 ,input  true
     2400                 ) .
     2401               assign
     2402                 v-restore-saved = true
     2403               .
     2404             end.
     2405           end.
     2406           if connected("ub") = true
     2407           then do:
     2408             run gbl/wndsizer.p
     2409               (input  v-cntxt-db-num
     2410               ,input  v-cntxt-userid
     2411               ,input  v-diasize-proc-name
     2412               ,input  'width':u
     2413               ,output v-resize-value-str
     2414               ) .
     2415             if v-resize-value-str <> '':U
     2416             then do:
     2417               run diasize_change-width in this-procedure
     2418                 (input  integer(v-resize-value-str)
     2419                 ,input  true
     2420                 ) .
     2421               assign
     2422                 v-restore-saved = true
     2423               .
     2424             end.
     2425           end.
     2426           if v-restore-saved <> true
     2427           then do:
     2428             if v-diasize-wndmax = true
     2429             then do:
     2430               run diasize_maximize in this-procedure
     2431                 (input  true
     2432                 ) .
     2433             end.
     2434           end.
     2435         end.
     2436         else do:
     2437           if v-diasize-wndmax = true
     2438           then do:
     2439             run diasize_maximize in this-procedure
     2440               (input  true
     2441               ) .
     2442           end.
     2443         end.
     2444       end.
     2445     end.
     2446   end procedure.
     2447   procedure diasize_need-full-display :
     2448     define output parameter p-need-full-display as logical   no-undo .
     2449     do
     2450     on error undo, return error return-value
     2451     :
     2452       assign
     2453         p-need-full-display = v-diasize-need-full-display
     2454       .
     2455       assign
     2456         v-diasize-need-full-display = false
     2457       .
     2458     end.
     2459   end procedure.
     2460   procedure get-context :
     2461      define output parameter p-db-num as integer          no-undo.
     2462      define output parameter p-user-id as character        no-undo.
     2463      define variable v-login               as character    no-undo.
     2464      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2465      define buffer buf_user-login  for ub.user-login .
     2466      do
     2467      on error undo, return error
     2468      :
     2469            FIND FIRST buf_sys-ctrl no-lock.
     2470            ASSIGN
     2471               v-login = USERID("ub")
     2472               p-db-num = buf_sys-ctrl.db-num
     2473            .
     2474            FIND FIRST buf_user-login
     2475                 WHERE buf_user-login.db-num = p-db-num
     2476                   AND buf_user-login.user-login = v-login
     2477                 no-lock
     2478                 no-error
     2479                 .
     2480            IF AVAILABLE buf_user-login
     2481            THEN DO:
     2482               assign
     2483                  p-user-id = buf_user-login.user-id
     2484               .
     2485            END.
     2486      end.
     2487   end procedure.
     2488       run diasize_init in this-procedure .
     2489   MAIN-BLOCK:
     2490   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2491      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2492     assign
     2493       v-start-level = 2
     2494     .
     2495     assign
     2496       level = v-start-level
     2497     .
     2498     repeat while program-name(level) <> ?:
     2499       if program-name(level) = this-procedure:file-name then do:
     2500         message
     2501         "Вы уже находитесь в режиме копирования скидок"
     2502         view-as alert-box error .
     2503         undo, return error .
     2504       end.
     2505       assign
     2506       level = level + 1
     2507       .
     2508     end.
     2509   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2510     run mainmenu_getcntxt in parparentproc
     2511       (output v-cntxt-db-num
     2512       ,output v-cntxt-userid
     2513       ,output v-cntxt-level
     2514       ,output v-cntxt-host-code-obj
     2515       ,output v-cntxt-obj-type
     2516       ,output v-cntxt-obj-code
     2517       ,output v-cntxt-db-num-obj
     2518       ,output v-cntxt-is-admin
     2519       ) .
     2520     if lookup(p-list-mode, "template" + chr(44) +
     2521                             "rule-num" + chr(44) +
     2522                             'объект':U) = 0 then do:
     2523       message
     2524       substitute("Неверное значение параметра вызова p-list-mode = &1", p-list-mode)
     2525       view-as alert-box error .
     2526       undo main-block, return error .
     2527     end.
     2528     case p-list-mode:
     2529        when "template" then do:
     2530          v-templ-rl-root = p-rule-num.
     2531        end.
     2532        when "rule-num" then do:
     2533          find first loc_dis-rule no-lock where
     2534                     loc_dis-rule.rule-num = p-rule-num no-error.
     2535          if not available loc_dis-rule then do:
     2536             message
     2537             substitute("Неверное значение параметра вызова p-rule-num = &1", p-rule-num)
     2538             view-as alert-box error .
     2539             undo main-block, return error .
     2540          end.
     2541         if loc_dis-rule.sts <> integer('0':U) then do:
     2542                   message
     2543           substitute("Правило &1 находится в статусе &2, поэтому не может быть скопировано на другие объекты!"
     2544                     , loc_dis-rule.rule-num
     2545                     , entry (lookup (string(loc_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U))
     2546           view-as alert-box error .
     2547           undo main-block, return error .
     2548         end.
     2549          create temp-dis-rule.
     2550          buffer-copy loc_dis-rule to temp-dis-rule
     2551          assign
     2552          temp-dis-rule.old-des = loc_dis-rule.des
     2553          .
     2554          release temp-dis-rule.
     2555        end.
     2556        when 'объект':U then do:
     2557          find first loc_clients no-lock where
     2558                     loc_clients.obj-type = p-obj-type
     2559                  and loc_clients.obj-code = p-obj-code no-error.
     2560          if not available loc_clients then do:
     2561             message
     2562             substitute("Неверное значение параметра вызова p-obj-type = &1 и/или p-obj-code = &2", p-obj-type, p-obj-code)
     2563             view-as alert-box error .
     2564             undo main-block, return error .
     2565          end.
     2566        end.
     2567     end case.
     2568     RUN Myenable.
     2569     WAIT-FOR GO OF FRAME Dialog-Frame.
     2570   END.
     2571   RUN disable_UI.
     2572   PROCEDURE disable_UI :
     2573     HIDE FRAME Dialog-Frame.
     2574   END PROCEDURE.
     2575   PROCEDURE enable_UI :
     2576     DISPLAY T-dis-gds-rule cb-pos-type f-old-des
     2577         WITH FRAME Dialog-Frame.
     2578     ENABLE b-quit T-dis-gds-rule B-Help cb-pos-type B-dis-rule-add
     2579            B-dis-rule-del b-lkp B-run BR-dis-rule B-objects-add
     2580            B-objects-delete BR-objects
     2581         WITH FRAME Dialog-Frame.
     2582     VIEW FRAME Dialog-Frame.
     2583     OPEN QUERY BR-dis-rule FOR EACH temp-dis-rule NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BR-objects FOR EACH temp-clients NO-LOCK INDEXED-REPOSITION.
     2584   END PROCEDURE.
     2585   PROCEDURE MyEnable :
     2586   DEFINE VARIABLE v-list-items AS CHARACTER NO-UNDO.
     2587   DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
     2588   define variable v-jj as integer no-undo .
     2589   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2590   DO v-ii = 1 TO NUM-ENTRIES('IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U):
     2591     if p-list-mode = "template" then do:
     2592       find first buf_dis-cfg-rule no-lock where
     2593                 buf_dis-cfg-rule.templ-rl-root =  p-rule-num
     2594             and buf_dis-cfg-rule.pos-type =  ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U)
     2595                 no-error.
     2596       if not available buf_dis-cfg-rule then next.
     2597     end.
     2598     if p-list-mode = "rule-num" then do:
     2599       find first temp-dis-rule.
     2600       find first buf_dis-cfg-rule no-lock where
     2601                 buf_dis-cfg-rule.templ-rl-root = temp-dis-rule.templ-rl-root
     2602             and buf_dis-cfg-rule.pos-type =  ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U)
     2603                 no-error.
     2604       if not available buf_dis-cfg-rule then next.
     2605     end.
     2606     v-jj = v-jj + 1.
     2607     ASSIGN
     2608     v-list-items = v-list-items + (IF v-jj > 1 THEN  chr(44) ELSE "":U) +
     2609                     ENTRY(v-ii, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) + chr(44) +
     2610                     ENTRY(v-ii, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U).
     2611   END.
     2612   assign
     2613   cb-pos-type:list-item-pairs in frame Dialog-Frame = v-list-items
     2614   temp-dis-rule.des:RESIZABLE IN BROWSE br-dis-rule = YES
     2615   .
     2616   DISPLAY
     2617   T-dis-gds-rule
     2618   WITH FRAME Dialog-Frame.
     2619   ENABLE
     2620   b-quit
     2621   T-dis-gds-rule
     2622   B-run
     2623   B-Help
     2624   B-dis-rule-add
     2625   B-dis-rule-del
     2626   cb-pos-type
     2627   BR-dis-rule
     2628   B-objects-add
     2629   B-objects-delete
     2630   b-lkp
     2631   BR-objects
     2632   WITH FRAME Dialog-Frame.
     2633   case p-list-mode:
     2634     when 'объект':U then do:
     2635       assign
     2636       frame Dialog-Frame:title = substitute("Копирование скидок, действующих на &1&2 на другие объекты по списку"
     2637                                              , p-obj-type
     2638                                              , p-obj-code).
     2639     end.
     2640     when "rule-num" then do:
     2641       assign
     2642       frame Dialog-Frame:title = substitute("Копирование скидки &1 на другие объекты по списку"
     2643                                              , p-rule-num
     2644                                              ).
     2645     end.
     2646     when "template" then do:
     2647       assign
     2648       frame Dialog-Frame:title = substitute("Копирование скидок  по шаблону &1 на другие объекты по списку"
     2649                                              , p-rule-num
     2650                                              ).
     2651     end.
     2652   end case.
     2653   VIEW FRAME Dialog-Frame.
     2654   if p-list-mode = "template" then do:
     2655     find first buf_dis-cfg-rule no-lock where
     2656               buf_dis-cfg-rule.templ-rl-root =  p-rule-num
     2657           and buf_dis-cfg-rule.table-name =  'dis-gds-rule':U
     2658               no-error.
     2659     if not available buf_dis-cfg-rule then do:
     2660       hide
     2661       t-dis-gds-rule
     2662       in frame Dialog-Frame .
     2663     end.
     2664   end.
     2665   if p-list-mode = "rule-num" then do:
     2666     find first temp-dis-rule.
     2667     find first buf_dis-cfg-rule no-lock where
     2668               buf_dis-cfg-rule.templ-rl-root = temp-dis-rule.templ-rl-root
     2669            and buf_dis-cfg-rule.table-name =  'dis-gds-rule':U
     2670               no-error.
     2671     if not available buf_dis-cfg-rule then do:
     2672       hide
     2673       t-dis-gds-rule
     2674       in frame Dialog-Frame .
     2675     end.
     2676   end.
     2677   OPEN QUERY BR-dis-rule FOR EACH temp-dis-rule NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BR-objects FOR EACH temp-clients NO-LOCK INDEXED-REPOSITION.
     2678   APPLY "ENTRY" TO br-dis-rule.
     2679   APPLY "value-changed" TO br-dis-rule.
     2680   END PROCEDURE.
     2681   PROCEDURE proc-b-dis-rule-add :
     2682   DEFINE VARIABLE v-sts AS INTEGER NO-UNDO.
     2683   DEFINE VARIABLE v-rid-list as character NO-UNDO.
     2684   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2685   define variable v-host-code as integer no-undo .
     2686   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     2687   DEFINE BUFFER buf_temp-dis-rule FOR temp-dis-rule.
     2688   if p-list-mode = 'объект':U then do:
     2689   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2690   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2691     (input  p-obj-type
     2692     ,input  p-obj-code
     2693     ,output v-host-code
     2694     )  .
     2695     run ref/dis-ruls.w (
     2696                   input parparentproc
     2697                 , input v-host-code
     2698                 , input p-obj-type
     2699                 , input p-obj-code
     2700                 , input "b-sel,b-mark":U
     2701                 , input 'объект':U
     2702                 , input 0
     2703                 , input -1
     2704                 , input 0
     2705                 , input-output v-sts
     2706                 , input-output v-rid-list ) no-error .
     2707   end.
     2708   if p-list-mode = "template" then do:
     2709     run ref/dis-ruls.w (
     2710                 input parparentproc
     2711                 ,input v-cntxt-host-code-obj
     2712                 ,input v-cntxt-obj-type
     2713                 ,input v-cntxt-obj-code
     2714                 ,input "b-sel,b-mark":U
     2715                 ,input "upper-rule-num":U
     2716                 ,input v-templ-rl-root
     2717                 ,input -1
     2718                 ,input 0
     2719                 ,input-output v-sts
     2720                 ,input-output v-rid-list ) no-error .
     2721   end.
     2722   IF ERROR-STATUS:ERROR OR v-rid-list = '' THEN UNDO, RETURN ERROR.
     2723   _do:
     2724   DO v-ii = 1 TO NUM-ENTRIES(v-rid-list):
     2725      FIND FIRST buf_dis-rule NO-LOCK WHERE
     2726               RECID(buf_dis-rule) = INTEGER(ENTRY(v-ii, v-rid-list)) NO-ERROR.
     2727      IF AVAILABLE buf_dis-rule THEN DO:
     2728        if not (buf_dis-rule.obj-type = 'скл':U
     2729                or
     2730                buf_dis-rule.obj-type = 'маг':U) then do:
     2731          message
     2732          substitute("Правило &1 не привязано к объекту, поэтому не может быть скопировано на другие объекты!", buf_dis-rule.rule-num)
     2733          view-as alert-box error .
     2734          next _do.
     2735        end.
     2736       if buf_dis-rule.sts <> integer('0':U) then do:
     2737                 message
     2738          substitute("Правило &1 находится в статусе &2, поэтому не может быть скопировано на другие объекты!"
     2739                   , buf_dis-rule.rule-num
     2740                   , entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U))
     2741          view-as alert-box error .
     2742          next _do.
     2743        end.
     2744        FIND FIRST buf_temp-dis-rule NO-LOCK WHERE
     2745                     buf_temp-dis-rule.rule-num = buf_dis-rule.rule-num NO-ERROR.
     2746         IF NOT AVAILABLE buf_temp-dis-rule THEN DO:
     2747             CREATE buf_temp-dis-rule.
     2748             BUFFER-COPY buf_dis-rule TO buf_temp-dis-rule
     2749             ASSIGN
     2750             buf_temp-dis-rule.old-des = buf_dis-rule.des
     2751                 .
     2752       END.
     2753     END.
     2754   END.
     2755   OPEN QUERY BR-dis-rule FOR EACH temp-dis-rule NO-LOCK INDEXED-REPOSITION.
     2756   APPLY "ENTRY" TO br-dis-rule IN FRAME Dialog-Frame.
     2757   APPLY "value-changed" TO br-dis-rule.
     2758   END PROCEDURE.
     2759   PROCEDURE proc-b-dis-rule-del :
     2760   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2761   DEFINE BUFFER buf_temp-dis-rule FOR temp-dis-rule.
     2762   IF NOT AVAILABLE temp-dis-rule THEN RETURN .
     2763   MESSAGE
     2764   "Вы действительно хотите удалить правило скидки из списка??"
     2765   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     2766   IF NOT glog THEN UNDO, RETURN.
     2767   FIND FIRST buf_temp-dis-rule WHERE
     2768              recid(buf_temp-dis-rule) = RECID(temp-dis-rule) .
     2769   DELETE buf_temp-dis-rule.
     2770   OPEN QUERY BR-dis-rule FOR EACH temp-dis-rule NO-LOCK INDEXED-REPOSITION.
     2771   APPLY "ENTRY" TO br-dis-rule IN FRAME Dialog-Frame.
     2772   APPLY "value-changed" TO br-dis-rule.
     2773   END PROCEDURE.
     2774   PROCEDURE proc-b-objects-add :
     2775   DEFINE VARIABLE v-rid-list as character NO-UNDO.
     2776   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2777   define variable v-user-select as logical   no-undo .
     2778   DEFINE BUFFER buf_temp-clients FOR temp-clients.
     2779   define buffer buf_clients for ub.clients.
     2780   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2781   run userobjs_clear in this-procedure  .
     2782   for each buf_temp-clients:
     2783   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2784   run userobjs_append in this-procedure
     2785     (input  buf_temp-clients.obj-type
     2786     ,input  buf_temp-clients.obj-code
     2787     )  .
     2788   end.
     2789   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790   run userobjs_select-many in this-procedure
     2791     (input  parparentproc
     2792     ,input  v-cntxt-db-num
     2793     ,input  v-cntxt-userid
     2794     ,input  v-cntxt-host-code-obj
     2795     ,input  v-cntxt-obj-type
     2796     ,input  v-cntxt-obj-code
     2797     ,output v-user-select
     2798     )  .
     2799   if v-user-select <> true
     2800   then do:
     2801     message
     2802       "Объекты не выбраны"
     2803       view-as alert-box information .
     2804     return NO-APPLY .
     2805   end.
     2806   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2807   for each buf_userobjs_temp-user-obj
     2808   on error undo, return no-apply
     2809   :
     2810     find first buf_temp-clients  where
     2811                buf_temp-clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     2812            and buf_temp-clients.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
     2813     if not available buf_temp-clients then do:
     2814       find first buf_clients no-lock where
     2815                 buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     2816              and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code .
     2817       create buf_temp-clients.
     2818       buffer-copy buf_clients to buf_temp-clients.
     2819     end.
     2820   end.
     2821   OPEN QUERY BR-objects FOR EACH temp-clients NO-LOCK INDEXED-REPOSITION.
     2822   END PROCEDURE.
     2823   PROCEDURE proc-b-objects-delete :
     2824   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2825   DEFINE BUFFER buf_temp-clients FOR temp-clients.
     2826   IF NOT AVAILABLE temp-clients THEN RETURN .
     2827   MESSAGE
     2828   "Вы действительно хотите удалить объект из списка??"
     2829   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     2830   IF NOT glog THEN UNDO, RETURN.
     2831   FIND FIRST buf_temp-clients WHERE
     2832              recid(buf_temp-clients) = RECID(temp-clients) .
     2833   DELETE buf_temp-clients.
     2834   OPEN QUERY BR-objects FOR EACH temp-clients NO-LOCK INDEXED-REPOSITION.
     2835   END PROCEDURE.
     2836   PROCEDURE proc-b-run :
     2837   DEFINE VARIABLE v-parameter AS CHARACTER NO-UNDO.
     2838   define  BUFFER buf_temp-dis-rule FOR temp-dis-rule.
     2839   define  BUFFER buf_temp-clients FOR temp-clients.
     2840   FIND FIRST buf_temp-dis-rule NO-ERROR.
     2841   IF NOT AVAILABLE buf_temp-dis-rule THEN DO:
     2842     MESSAGE
     2843     "Не выбрано ни одного правила скидки-оригинала для копирования"
     2844      VIEW-AS ALERT-BOX ERROR.
     2845     UNDO, RETURN.
     2846   END.
     2847   FIND FIRST buf_temp-clients NO-ERROR.
     2848   IF NOT AVAILABLE buf_temp-clients THEN DO:
     2849     MESSAGE
     2850     "Не выбрано ни одного объекта-назначения для копирования"
     2851      VIEW-AS ALERT-BOX ERROR.
     2852     UNDO, RETURN.
     2853   END.
     2854   ASSIGN
     2855   v-parameter = STRING(t-dis-gds-rule) + chr(4) +
     2856                 cb-pos-type
     2857                 .
     2858   run str/diallog.w ( input parparentproc
     2859               , input this-procedure
     2860               , input ('proc-copy':U + chr(4) +
     2861                       "1" + chr(4) +
     2862                       "0" + chr(4) +
     2863                       "1" + chr(4) +
     2864                       "1" + chr(4) +
     2865                       "yes")
     2866               , input v-parameter
     2867               , input NO
     2868               , input 'Прервать'
     2869               , input 'Копирование скидок') no-error .
     2870   END PROCEDURE.
     2871   PROCEDURE proc-copy :
     2872   define input parameter parparentproc    as widget-handle    no-undo.
     2873   define input parameter p-parent-handle  as widget-handle no-undo .
     2874   define input parameter p-log-handle     as handle no-undo .
     2875   define input parameter p-parameter      as character        no-undo.
     2876   DEFINE VARIABLE V-DIS-GDS-RULE   AS LOGICAL   NO-UNDO.
     2877   define variable v-cd-type        as character no-undo .
     2878   define variable LOG-FILE-NAME    as character no-undo .
     2879   define variable v-dr-ii          as integer   no-undo .
     2880   define variable v-dr-ii-ok       as integer   no-undo .
     2881   define variable v-dgr-ii         as integer   no-undo .
     2882   define variable v-dgr-ii-ok      as integer   no-undo .
     2883   define variable v-loc-dgr-ii     as integer   no-undo .
     2884   define variable v-loc-dgr-ii-ok  as integer   no-undo .
     2885   define variable v-rule-num-count as integer   no-undo .
     2886   define variable v-rule-num       as integer   no-undo .
     2887   define variable v-upper-rule-num as integer   no-undo .
     2888   define variable v-err-cnt        as integer   no-undo init 0 .
     2889   define variable v-recid as recid     no-undo .
     2890   define variable glog    as logical   no-undo .
     2891   define variable dflt-cd as character no-undo .
     2892   define variable v-add-upd as logical no-undo .
     2893   define variable v-do-it   as logical no-undo init yes .
     2894   define buffer buf_temp-dis-rule for temp-dis-rule .
     2895   define buffer buf_temp-clients  for temp-clients .
     2896   define buffer term_dis-rule     for ub.dis-rule .
     2897   define buffer trg_dis-rule      for ub.dis-rule .
     2898   define buffer src_dis-rule      for ub.dis-rule .
     2899   define buffer src_dis-gds-rule  for ub.dis-gds-rule .
     2900   define buffer buf_dis-cfg-rule  for ub.dis-cfg-rule .
     2901   define buffer buf_dis-rule      for ub.dis-rule .
     2902   define buffer buf_tt0           for tt0-term_dis-rule .
     2903   define buffer src_dis-gds-rule-attr for ub.dis-gds-rule-attr .
     2904   define buffer trg_dis-gds-rule-attr for ub.dis-gds-rule-attr .
     2905   if num-entries(p-parameter, chr(4)) <> 2
     2906   then do:
     2907     MESSAGE substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 2"
     2908                                , num-entries(p-parameter, chr(4)))
     2909     VIEW-AS ALERT-BOX ERROR
     2910     .
     2911     RETURN error.
     2912   end.
     2913   ASSIGN
     2914   V-DIS-GDS-RULE = LOGICAL(ENTRY(1, P-PARAMETER, chr(4) ))
     2915   v-cd-type = entry(2, p-parameter, chr(4) )
     2916   .
     2917   LOG-file-name = substitute("&1.txt", entry(1, this-procedure:file-name, ".")).
     2918   log-file-name = entry( num-entries(log-file-name, chr(47)), log-file-name, chr(47)).
     2919   for each tt0-term_dis-rule:
     2920     delete tt0-term_dis-rule.
     2921   end.
     2922   for each tt-dis-rule:
     2923     delete tt-dis-rule.
     2924   end.
     2925   create tt0-term_dis-rule.
     2926   _temp-dis-rule:
     2927   for each buf_temp-dis-rule:
     2928     if buf_temp-dis-rule.sts <> integer('0':U) then do:
     2929                  run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Нельзя копировать правило в статусе &1", entry (lookup (string(buf_temp-dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U))                                       ).
     2930        assign
     2931          v-dr-ii = v-dr-ii + 1
     2932          v-err-cnt = v-err-cnt + 1 .
     2933     end.
     2934     run disrules-fill-properties in this-procedure ( input buf_temp-dis-rule.templ-rl-root).
     2935     FIND FIRST buf_dis-cfg-rule NO-LOCK where
     2936               buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     2937           and buf_dis-cfg-rule.templ-rl-root = buf_temp-dis-rule.templ-rl-root
     2938           and buf_dis-cfg-rule.time-templ-rl-root = buf_temp-dis-rule.time-templ-rl-root
     2939           and buf_dis-cfg-rule.pos-type = v-cd-type
     2940           no-error
     2941            .
     2942     _temp-clients:
     2943     for each buf_temp-clients :
     2944       if not (v-cd-type = 'bo':U or v-cd-type = '-':U) and
     2945          not buf_temp-clients.obj-type = 'орг':U
     2946       then do:
     2947         if buf_temp-clients.obj-type = 'скл':U then do:
     2948                   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Нельзя скопировать правила скидки на объект &1&2"                                      , buf_temp-clients.obj-type                                     , buf_temp-clients.obj-code                                     )                                       ).
     2949           assign
     2950             v-dr-ii = v-dr-ii + 1
     2951             v-err-cnt = v-err-cnt + 1 .
     2952           next _temp-clients.
     2953         end.
     2954         dflt-cd = ''.
     2955   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2956   define variable v-param-type20 as character no-undo .
     2957   define variable v-value-date20 as date no-undo .
     2958   define variable v-value-decimal20 as decimal no-undo .
     2959   define variable v-value-integer20 as INTEGER no-undo .
     2960   define variable v-value-logical20 AS LOGICAL no-undo .
     2961   define variable v-tth20 as handle no-undo .
     2962   run adm/shattri.p (
     2963       input "get":U
     2964       ,input  buf_temp-clients.obj-type
     2965       ,input  buf_temp-clients.obj-code
     2966       ,input  'cd-sending':U
     2967       ,input  'dflt-cd':U
     2968       ,output dflt-cd
     2969       ,output v-value-date20
     2970       ,output v-value-decimal20
     2971       ,output v-value-integer20
     2972       ,output v-value-logical20
     2973       ,output v-param-type20
     2974       ,INPUT-OUTPUT table-handle v-tth20
     2975       )  .
     2976   delete object v-tth20 no-error.
     2977         if dflt-cd <> v-cd-type then do:
     2978                   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Нельзя скопировать правила скидки на объект &1&2&3" +                                     "На нем работает POS типа &4"                                     , buf_temp-clients.obj-type                                     , buf_temp-clients.obj-code                                     , chr(10)                                     , dflt-cd)                                       ).
     2979           assign
     2980             v-dr-ii = v-dr-ii + 1
     2981             v-err-cnt = v-err-cnt + 1 .
     2982           next _temp-clients.
     2983         end.
     2984       end.
     2985       for each tt-dis-rule:
     2986         delete tt-dis-rule.
     2987       end.
     2988       create tt-dis-rule.
     2989       assign
     2990       tt-dis-rule.des = buf_temp-dis-rule.des
     2991       tt-dis-rule.host-code          = ( if buf_temp-clients.host-code = ? then buf_temp-clients.obj-code  else buf_temp-clients.host-code )
     2992       tt-dis-rule.obj-type           = ( if buf_temp-clients.host-code = ? then buf_temp-dis-rule.obj-type else buf_temp-clients.obj-type )
     2993       tt-dis-rule.obj-code           = ( if buf_temp-clients.host-code = ? then buf_temp-dis-rule.obj-code else buf_temp-clients.obj-code )
     2994       tt-dis-rule.discnt-type        = buf_temp-dis-rule.discnt-type
     2995       tt-dis-rule.discnt-value       = buf_temp-dis-rule.discnt-value
     2996       tt-dis-rule.time-rule-num      = buf_temp-dis-rule.time-rule-num
     2997       tt-dis-rule.time-templ-rl-root = buf_temp-dis-rule.time-templ-rl-root
     2998       tt-dis-rule.tot-sum            = buf_temp-dis-rule.tot-sum
     2999       tt-dis-rule.sts                = buf_temp-dis-rule.sts
     3000       tt-dis-rule.doc-qnty           = buf_temp-dis-rule.doc-qnty
     3001       .
     3002       find first buf_dis-rule no-lock where
     3003                 buf_dis-rule.discnt-type        = tt-dis-rule.discnt-type
     3004             and buf_dis-rule.discnt-value       = tt-dis-rule.discnt-value
     3005             and buf_dis-rule.time-rule-num      = tt-dis-rule.time-rule-num
     3006             and buf_dis-rule.time-templ-rl-root = tt-dis-rule.time-templ-rl-root
     3007             and buf_dis-rule.tot-sum            = tt-dis-rule.tot-sum
     3008             and buf_dis-rule.sts                = tt-dis-rule.sts
     3009             and buf_dis-rule.doc-qnty           = tt-dis-rule.doc-qnty
     3010             and buf_dis-rule.host-code = tt-dis-rule.host-code
     3011             and buf_dis-rule.obj-type = tt-dis-rule.obj-type
     3012             and buf_dis-rule.obj-code = tt-dis-rule.obj-code
     3013             and buf_dis-rule.templ-rl-root = buf_temp-dis-rule.templ-rl-root
     3014             and buf_dis-rule.root = yes no-error.
     3015       if available buf_dis-rule then do:
     3016         assign
     3017           v-add-upd = false
     3018           v-upper-rule-num = buf_dis-rule.rule-num
     3019           v-recid = recid(buf_dis-rule)
     3020         .
     3021       end.
     3022       else do:
     3023         v-add-upd = true .
     3024       end.
     3025       buffer-copy buf_temp-dis-rule
     3026       except des
     3027       host-code
     3028       obj-type
     3029       obj-code
     3030       to tt-dis-rule .
     3031       for each tt0-term_dis-rule:
     3032           delete tt0-term_dis-rule .
     3033       end.
     3034       v-rule-num-count = 0 .
     3035       for each term_dis-rule no-lock
     3036       where term_dis-rule.upper-rule-num = buf_temp-dis-rule.rule-num :
     3037           v-rule-num-count = v-rule-num-count + 1.
     3038           create tt0-term_dis-rule.
     3039           buffer-copy term_dis-rule
     3040           except host-code obj-type obj-code
     3041           rule-num upper-rule-num rl-root
     3042           to tt0-term_dis-rule
     3043           assign
     3044           tt0-term_dis-rule.host-code      = buf_temp-clients.host-code
     3045           tt0-term_dis-rule.obj-type       = buf_temp-clients.obj-type
     3046           tt0-term_dis-rule.obj-code       = buf_temp-clients.obj-code
     3047           tt0-term_dis-rule.rule-num       = v-rule-num-count
     3048           tt0-term_dis-rule.upper-rule-num = (if v-add-upd then buf_temp-dis-rule.templ-rl-root else v-upper-rule-num)
     3049           tt0-term_dis-rule.rl-root        = buf_temp-dis-rule.templ-rl-root
     3050           .
     3051           release tt0-term_dis-rule.
     3052       end.
     3053       if not v-add-upd then do:
     3054         find first tt0-term_dis-rule no-lock no-error .
     3055         find first buf_dis-rule no-lock where
     3056                 buf_dis-rule.host-code      = tt0-term_dis-rule.host-code
     3057             and buf_dis-rule.obj-type       = tt0-term_dis-rule.obj-type
     3058             and buf_dis-rule.obj-code       = tt0-term_dis-rule.obj-code
     3059             and buf_dis-rule.templ-rl-root  = tt0-term_dis-rule.templ-rl-root
     3060             and buf_dis-rule.root           = false
     3061             and buf_dis-rule.upper-rule-num = tt0-term_dis-rule.upper-rule-num
     3062         no-error.
     3063         if avail buf_dis-rule then do:
     3064             assign
     3065               tt0-term_dis-rule.rule-num = buf_dis-rule.rule-num
     3066             .
     3067         end.
     3068         else do:
     3069            run gen-b-code in this-procedure ( input 'drgb':U, output v-rule-num) no-error .
     3070            if error-status:error then do:
     3071                               run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Не удалось скопировать правило скидки &1 (gen-b-code) на &2&3&4&5&4&6"                                             , buf_temp-dis-rule.rule-num                                             , buf_temp-clients.obj-type                                             , buf_temp-clients.obj-code                                              , chr(10)                                             , error-status:get-message(1)                                              , return-value )                                       ).
     3072                 assign
     3073                   v-dr-ii = v-dr-ii + 1
     3074                   v-err-cnt = v-err-cnt + 1 .
     3075                 next _temp-clients.
     3076            end.
     3077            find first buf_tt0 no-lock no-error.
     3078            if avail buf_tt0 then do:
     3079                create buf_dis-rule.
     3080                buffer-copy buf_tt0
     3081                except rule-num
     3082                to buf_dis-rule
     3083                assign
     3084                buf_dis-rule.rule-num = v-rule-num
     3085                buf_tt0.rule-num = v-rule-num
     3086                .
     3087            end.
     3088            else do:
     3089               v-do-it = false .
     3090            end.
     3091         end.
     3092       end.
     3093       find first buf_tt0 no-lock no-error.
     3094       if avail buf_tt0 and buf_tt0.time-templ-rl-root > 0 then do:
     3095         assign
     3096           tt-dis-rule.time-rule-num = buf_tt0.time-rule-num
     3097         .
     3098       end.
     3099       v-dr-ii = v-dr-ii + 1.
     3100       if v-do-it then do:
     3101           run ref/dis-rul1.p (
     3102           input (if v-add-upd then ? else v-upper-rule-num)
     3103           ,input v-cd-type
     3104           ,input buf_temp-dis-rule.templ-rl-root
     3105           ,input buf_temp-dis-rule.templ-rl-root
     3106           ,input buf_temp-dis-rule.des
     3107           ,input tt-dis-rule.dis-kat
     3108           ,input tt-dis-rule.discnt-type
     3109           ,input tt-dis-rule.doc-qnty
     3110           ,input tt-dis-rule.tot-sum
     3111           ,input tt-dis-rule.charkey_one
     3112           ,input tt-dis-rule.charkey_two
     3113           ,input tt-dis-rule.charkey_three
     3114           ,input tt-dis-rule.deckey_one
     3115           ,input tt-dis-rule.deckey_two
     3116           ,input tt-dis-rule.deckey_three
     3117           ,input tt-dis-rule.key#_one
     3118           ,input tt-dis-rule.key#_two
     3119           ,input tt-dis-rule.key#_three
     3120           ,input tt-dis-rule.subject-type
     3121           ,input tt-dis-rule.time-templ-rl-root
     3122           ,input (if tt-dis-rule.time-templ-rl-root = 0 then 0 else tt-dis-rule.time-rule-num)
     3123           ,input tt-dis-rule.upper-rule-num
     3124           ,input tt-dis-rule.value-type
     3125           ,input tt-dis-rule.host-code
     3126           ,INPUT tt-dis-rule.obj-type
     3127           ,INPUT tt-dis-rule.obj-code
     3128           ,INPUT tt-dis-rule.discnt-value
     3129           ,input table tt0-term_dis-rule
     3130           ,input-output v-recid
     3131           ,input (if v-add-upd then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3132           ,input yes
     3133           ) NO-ERROR.
     3134           if error-status:error then do:
     3135                       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Не удалось скопировать правило скидки &1 на &2&3&4&5&4&6"                                         , buf_temp-dis-rule.rule-num                                         , buf_temp-clients.obj-type                                         , buf_temp-clients.obj-code                                          , chr(10)                                         , error-status:get-message(1)                                          , return-value )                                       ).
     3136             assign
     3137               v-dr-ii = v-dr-ii + 1
     3138               v-err-cnt = v-err-cnt + 1
     3139             .
     3140             next _temp-clients.
     3141           end.
     3142       end.
     3143       assign
     3144         v-do-it = true
     3145         v-dr-ii-ok = v-dr-ii-ok + 1
     3146       .
     3147       if v-dis-gds-rule then do:
     3148           assign
     3149             v-loc-dgr-ii = 0
     3150             v-loc-dgr-ii-ok = 0
     3151           .
     3152           find first trg_dis-rule no-lock
     3153           where recid(trg_dis-rule) = v-recid no-error.
     3154           if available buf_dis-cfg-rule then do:
     3155               for each src_dis-gds-rule no-lock
     3156               where src_dis-gds-rule.obj-type = ( if buf_temp-clients.host-code = ? then 'орг':U                      else buf_temp-dis-rule.obj-type )
     3157                 and src_dis-gds-rule.obj-code = ( if buf_temp-clients.host-code = ? then buf_temp-dis-rule.host-code else buf_temp-dis-rule.obj-code )
     3158                 and src_dis-gds-rule.rule-num = buf_temp-dis-rule.rule-num
     3159                 and src_dis-gds-rule.pos-type = v-cd-type :
     3160                   assign
     3161                     v-dgr-ii = v-dgr-ii + 1
     3162                     v-loc-dgr-ii = v-loc-dgr-ii + 1
     3163                   .
     3164                   if buf_temp-clients.host-code = ? then do:
     3165                       run cmp-disgdsru-write in this-procedure (
     3166                                                            input src_dis-gds-rule.gds-code
     3167                                                           ,input 'орг':U
     3168                                                           ,input trg_dis-rule.host-code
     3169                                                           ,input v-cd-type
     3170                                                           ,input trg_dis-rule.templ-rl-root
     3171                                                           ,input src_dis-gds-rule.time-templ-rl-root
     3172                                                           ,input buf_dis-cfg-rule.discnt-role
     3173                                                           ,input trg_dis-rule.rule-num
     3174                                                           ,input src_dis-gds-rule.nonunique
     3175                                                          )  no-error.
     3176                   end.
     3177                   else do:
     3178                   run disgdsru-write in this-procedure ( input buf_temp-clients.obj-type
     3179                                                         ,input buf_temp-clients.obj-code
     3180                                                         ,input src_dis-gds-rule.gds-code
     3181                                                         ,input v-cd-type
     3182                                                         ,input buf_dis-cfg-rule.discnt-role
     3183                                                         ,input trg_dis-rule.templ-rl-root
     3184                                                         ,input src_dis-gds-rule.time-templ-rl-root
     3185                                                         ,input trg_dis-rule.rule-num
     3186                                                         ,input src_dis-gds-rule.nonunique
     3187                   )  no-error.
     3188                   end.
     3189                   if error-status :error then do:
     3190                       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Не удалось привязать правило скидки &1 к товару с кодом &2 на &3&4&5&6&5&7"                         , trg_dis-rule.rule-num                         , src_dis-gds-rule.gds-code                         , buf_temp-clients.obj-type                         , buf_temp-clients.obj-code                          , chr(10)                         , error-status:get-message(1)                          , return-value )                                       ) .
     3191                       assign
     3192                         v-dr-ii = v-dr-ii + 1
     3193                         v-err-cnt = v-err-cnt + 1
     3194                       .
     3195                   end.
     3196                   else do:
     3197                       if buf_dis-cfg-rule.discnt-role = 'bonus-qnty' and
     3198                          buf_dis-cfg-rule.nonunique   = 'bar-code.b-code'
     3199                       then do:
     3200                           for each src_dis-gds-rule-attr no-lock
     3201                           where src_dis-gds-rule-attr.gds-code    = src_dis-gds-rule.gds-code
     3202                             and src_dis-gds-rule-attr.obj-type    = src_dis-gds-rule.obj-type
     3203                             and src_dis-gds-rule-attr.obj-code    = src_dis-gds-rule.obj-code
     3204                             and src_dis-gds-rule-attr.pos-type    = v-cd-type
     3205                             and src_dis-gds-rule-attr.discnt-role = buf_dis-cfg-rule.discnt-role
     3206                             and src_dis-gds-rule-attr.nonunique   = src_dis-gds-rule.nonunique
     3207                           :
     3208                               find first trg_dis-gds-rule-attr exclusive-lock
     3209                               where trg_dis-gds-rule-attr.gds-code    = src_dis-gds-rule.gds-code
     3210                                 and trg_dis-gds-rule-attr.obj-type    = ( if buf_temp-clients.host-code = ? then 'орг':U                 else buf_temp-clients.obj-type )
     3211                                 and trg_dis-gds-rule-attr.obj-code    = ( if buf_temp-clients.host-code = ? then trg_dis-rule.host-code else buf_temp-clients.obj-code )
     3212                                 and trg_dis-gds-rule-attr.pos-type    = v-cd-type
     3213                                 and trg_dis-gds-rule-attr.discnt-role = buf_dis-cfg-rule.discnt-role
     3214                                 and trg_dis-gds-rule-attr.nonunique   = src_dis-gds-rule.nonunique
     3215                                 and trg_dis-gds-rule-attr.attr-value  = src_dis-gds-rule-attr.attr-value
     3216                               no-error.
     3217                               if not avail trg_dis-gds-rule-attr then do:
     3218                                   create trg_dis-gds-rule-attr .
     3219                                   buffer-copy src_dis-gds-rule-attr
     3220                                   except obj-type obj-code
     3221                                   to trg_dis-gds-rule-attr
     3222                                   assign
     3223                                     trg_dis-gds-rule-attr.obj-type = ( if buf_temp-clients.host-code = ? then 'орг':U                 else buf_temp-clients.obj-type )
     3224                                     trg_dis-gds-rule-attr.obj-code = ( if buf_temp-clients.host-code = ? then trg_dis-rule.host-code else buf_temp-clients.obj-code )
     3225                                   .
     3226                               end.
     3227                           end.
     3228                       end.
     3229                       assign
     3230                         v-dgr-ii-ok = v-dgr-ii-ok + 1
     3231                         v-loc-dgr-ii-ok = v-loc-dgr-ii-ok + 1
     3232                       .
     3233                   end.
     3234               end.
     3235           end.
     3236       end.
     3237       if v-dis-gds-rule then do:
     3238               run write-counter in p-log-handle (input substitute("Пр. скидок: OK &1 из &2, привязки: OK &3 из &4", v-dr-ii-ok, v-dr-ii, v-dgr-ii-ok, v-dgr-ii)) .
     3239       end.
     3240       else do:
     3241               run write-counter in p-log-handle (input substitute("Пр. скидок: OK &1 из &2", v-dr-ii-ok, v-dr-ii)) .
     3242       end.
     3243     end.
     3244     if v-dis-gds-rule  then do:
     3245           run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("привязки Правила &1: OK &2 из &3", buf_temp-dis-rule.rule-num, v-loc-dgr-ii, v-loc-dgr-ii-ok)                                       ).
     3246     end.
     3247     end.
     3248   if v-dis-gds-rule then do:
     3249       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Пр. скидок: OK &1 из &2, привязки: OK &3 из &4", v-dr-ii-ok, v-dr-ii, v-dgr-ii-ok, v-dgr-ii)                                       ).
     3250   end.
     3251   else do:
     3252       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Пр. скидок: OK &1 из &2", v-dr-ii-ok, v-dr-ii)                                       ).
     3253   end.
     3254   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Копирование закончено")                                       ).
     3255   run write-counter in p-log-handle (input substitute("Пр. скидок: OK &1 из &2", v-dr-ii-ok, v-dr-ii)).
     3256   if v-err-cnt > 0 then do:
     3257       return error.
     3258   end.
     3259   END PROCEDURE.
