      577   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   procedure dr-code :
      579     do
      580     on error undo, return error
      581     :
      582       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      583       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      584       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      585       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      586       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      587       define output parameter  p-level-1           as character no-undo .
      588       define output parameter  p-level-2           as character no-undo .
      589       define output parameter  p-global             as integer no-undo .
      590       define output parameter  p-host               as integer no-undo .
      591       define output parameter  p-object             as integer no-undo .
      592       define output parameter  p-output-display as logical   no-undo .
      593       define output parameter  p-tree           as char  no-undo .
      594       define output parameter  p-other          as character no-undo .
      595       define variable v-other as character no-undo .
      596       define buffer buf_dis-rule for ub.dis-rule .
      597       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      598       find first buf_dis-rule no-lock where
      599                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      600       find first buf_dis-cfg-rule no-lock where
      601               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      602           and buf_dis-cfg-rule.pos-type = '':U
      603           and buf_dis-cfg-rule.table-name = '':U
      604           and buf_dis-cfg-rule.discnt-role = '':U
      605           and buf_dis-cfg-rule.self-nonunique = '':U
      606               no-error.
      607       if not available buf_Dis-cfg-rule then do:
      608           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      609       end.
      610       assign
      611       p-des = buf_dis-rule.des
      612       p-discnt-type = buf_dis-rule.discnt-type
      613       p-subject-type = buf_dis-rule.subject-type
      614       p-value-type = buf_dis-rule.value-type
      615       p-global = (if available buf_dis-cfg-rule
      616                   then buf_dis-cfg-rule.has-global
      617                   else 0)
      618       p-host = (if available buf_dis-cfg-rule
      619                 then buf_dis-cfg-rule.has-host
      620                 else 0)
      621       p-object = (if available buf_dis-cfg-rule
      622                 then buf_dis-cfg-rule.has-obj
      623                 else 0)
      624       p-output-display = (buf_dis-rule.sts = integer('0':U))
      625       p-tree = buf_Dis-rule.uniq-field
      626       p-other = buf_dis-rule.other-inf
      627       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      628       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      629                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      630                    else '')
      631       .
      632     end.
      633   end procedure.
      634   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      635   procedure disrules-fill-properties:
      636   define input  parameter p-templ-rl-root as integer   no-undo .
      637   define buffer buf_drt-prop for ub.drt-prop.
      638   define buffer buf_temp-drt-prop for temp-drt-prop.
      639   do
      640   on error undo, return error return-value
      641   :
      642     for each buf_temp-drt-prop:
      643       delete buf_temp-drt-prop.
      644     end.
      645     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      646       create buf_temp-drt-prop.
      647       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      648     end.
      649   end.
      650   end procedure.
      651   procedure disrules-get-interface-form :
      652   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      653   define output parameter p-form-name as character no-undo .
      654   define buffer buf_temp-drt-prop for temp-drt-prop.
      655   define buffer buf_drt-prop for ub.drt-prop.
      656   find first buf_temp-drt-prop where
      657             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      658         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      659         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      660   if not available buf_temp-drt-prop then do:
      661     find first buf_drt-prop where
      662               buf_drt-prop.templ-rl-root = p-templ-rl-root
      663           and buf_drt-prop.upper-prop-code = "InputForm"
      664           and buf_drt-prop.prop-code = "FormName" no-error.
      665     if available buf_drt-prop then do:
      666       p-form-name = buf_drt-prop.property-value.
      667     end.
      668     else do:
      669       p-form-name = "ref/dis-ruli.w".
      670     end.
      671   end.
      672   else do:
      673     p-form-name = buf_temp-drt-prop.property-value.
      674   end.
      675   end procedure.
      676   ~
      677   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   ~
      680   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   procedure discfgru-check :
      682   define input parameter p-table-name as character no-undo .
      683   define input parameter p-templ-rl-root as integer no-undo .
      684   define input parameter p-time-templ-rl-root as integer no-undo .
      685   define input parameter p-pos-type as character no-undo .
      686   define output parameter p-disnct-role as character no-undo .
      687   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      688     do
      689     on error undo, return error return-value
      690     :
      691       find first buf_dis-cfg-rule no-lock where
      692               buf_dis-cfg-rule.table-name = p-table-name
      693           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      694           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      695           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      696       if not available buf_dis-cfg-rule
      697       or p-pos-type = "":U
      698       then do:
      699          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      700                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      701                                  , p-templ-rl-root
      702                                  , (if p-time-templ-rl-root = ?
      703                                     then '':U
      704                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      705                                     )
      706                                  ).
      707       end.
      708       assign
      709       p-disnct-role = buf_dis-cfg-rule.discnt-role
      710       .
      711     end.
      712   end procedure.
      713   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      714   FUNCTION get-region RETURNS CHARACTER
      715     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      716     define variable par-region as character no-undo.
      717     if parhost-code = 0 and
      718          parobj-type = "":U and
      719          parobj-code = 0 then do:
      720          par-region = "Глобально".
      721          return par-region.
      722       end.
      723       if parobj-type = 'орг':U then do:
      724          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      725          return par-region.
      726       end.
      727       if parobj-type = 'регион':U
      728       then do:
      729          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      730          return par-region.
      731       end.
      732       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      733       return par-region.
      734   END FUNCTION.
      735   FUNCTION get-objregion RETURNS CHARACTER
      736     (  input parobj-type as character, input parobj-code as integer ) :
      737     define variable par-region as character no-undo.
      738     if  parobj-type = "":U and
      739         parobj-code = 0
      740     then do:
      741        par-region = "Глобально".
      742     end.
      743     else if parobj-type = 'орг':U
      744     then do:
      745        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      746     end.
      747     else if parobj-type = 'регион':U
      748     then do:
      749        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      750     end.
      751     else
      752        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      753     return par-region.
      754   END FUNCTION.
      755   procedure disgdsru-name :
      756   define buffer buf_dis-rule for ub.dis-rule.
      757   do
      758     on error undo, return error
      759     :
      760     define input  parameter p-templ-rl-root  as integer no-undo .
      761     define output parameter p-label          as character no-undo .
      762     find first buf_dis-rule no-lock where
      763               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      764     if available buf_dis-rule
      765     then do:
      766       if buf_dis-rule.rule-num > 0 then
      767       p-label = buf_dis-rule.des.
      768     end.
      769     else do:
      770       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      771     end.
      772   end.
      773   end procedure.
      774   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
      775   define variable v-rule-label as character no-undo .
      776   run disgdsru-name in this-procedure ( input p-templ-rl-root
      777                                        ,output v-rule-label) no-error.
      778   return v-rule-label.
      779   end function.
      780   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
      781   define variable v-rule-label as character no-undo .
      782   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
      783   end function.
      784   procedure disgdsru-write :
      785     do
      786     on error undo, return error
      787     :
      788       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
      789       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
      790       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
      791       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
      792       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
      793       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
      794       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      795       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
      796       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
      797       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
      798       define buffer buf_dis-rule for ub.dis-rule.
      799       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
      800       define variable v-label          as character no-undo .
      801       define variable v-discnt-role as character no-undo .
      802       run discfgru-check in this-procedure (
      803                                             input 'dis-gds-rule':U
      804                                            ,input p-templ-rl-root
      805                                            ,input p-time-templ-rl-root
      806                                            ,input p-pos-type
      807                                            ,output v-discnt-role
      808                                             ) no-error .
      809       if error-status :error then do:
      810         undo, return error return-value .
      811       end.
      812       if p-discnt-role = ? then do:
      813         p-discnt-role = v-discnt-role.
      814       end.
      815       if p-discnt-role <> v-discnt-role then do:
      816         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
      817                                 ,p-gds-code
      818                                 ,p-obj-type
      819                                 ,p-obj-code
      820                                 ,p-pos-type
      821                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      822                                 ,chr(10)
      823                                 ,p-templ-rl-root
      824                                 ,p-rule-num).
      825       end.
      826       if p-pos-type = ? then do:
      827   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   define variable v-param-type8 as character no-undo .
      829   define variable v-value-date8 as date no-undo .
      830   define variable v-value-decimal8 as decimal no-undo .
      831   define variable v-value-integer8 as INTEGER no-undo .
      832   define variable v-value-logical8 AS LOGICAL no-undo .
      833   define variable v-tth8 as handle no-undo .
      834   run adm/shattri.p (
      835       input "get":U
      836       ,input  p-obj-type
      837       ,input  p-obj-code
      838       ,input  'cd-sending':U
      839       ,input  'dflt-cd':U
      840       ,output p-pos-type
      841       ,output v-value-date8
      842       ,output v-value-decimal8
      843       ,output v-value-integer8
      844       ,output v-value-logical8
      845       ,output v-param-type8
      846       ,INPUT-OUTPUT table-handle v-tth8
      847       )  .
      848   delete object v-tth8 no-error.
      849       end.
      850       find first buf_dis-rule no-lock where
      851                 buf_dis-rule.rule-num = p-rule-num no-error.
      852       if not available buf_Dis-rule then do:
      853         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
      854                                 ,p-gds-code
      855                                 ,p-obj-type
      856                                 ,p-obj-code
      857                                 ,p-pos-type
      858                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      859                                 ,chr(10)
      860                                 ,p-rule-num).
      861       end.
      862       if buf_dis-rule.root <> yes then do:
      863         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
      864                                 ,p-gds-code
      865                                 ,p-obj-type
      866                                 ,p-obj-code
      867                                 ,p-pos-type
      868                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      869                                 ,chr(10)
      870                                 ,p-rule-num).
      871       end.
      872       if not (p-obj-type = buf_dis-rule.obj-type
      873           and p-obj-code = buf_dis-rule.obj-code)
      874       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
      875                and
      876                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
      877        then do:
      878         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
      879                                 ,p-gds-code
      880                                 ,p-obj-type
      881                                 ,p-obj-code
      882                                 ,p-pos-type
      883                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      884                                 ,chr(10)
      885                                 ) +
      886                             substitute("Правило скидки &1 определено для &2&3" +
      887                                        "а привязка к товару для &4"
      888                                        ,buf_dis-rule.rule-num
      889                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      890                                        ,chr(10)
      891                                        ,get-objregion( p-obj-type, p-obj-code)
      892                                        ))
      893                                 .
      894       end.
      895       find first buf_dis-gds-rule exclusive-lock where
      896                  buf_dis-gds-rule.gds-code  = p-gds-code
      897              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      898              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      899              AND buf_dis-gds-rule.pos-type  = p-pos-type
      900              AND buf_dis-gds-rule.discnt-role = p-discnt-role
      901              and buf_dis-gds-rule.nonunique = p-nonunique
      902              no-error .
      903       if not available buf_dis-gds-rule then do:
      904         find first buf_dis-gds-rule exclusive-lock where
      905                   buf_dis-gds-rule.gds-code  = p-gds-code
      906               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      907               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      908               AND buf_dis-gds-rule.pos-type  = p-pos-type
      909               AND buf_dis-gds-rule.discnt-role = p-discnt-role
      910               no-error .
      911         if available buf_Dis-gds-rule then do:
      912           if p-nonunique = ''
      913           and available buf_dis-gds-rule
      914           then do:
      915             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
      916                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      917                                      , p-gds-code
      918                                      , buf_Dis-rule.obj-type
      919                                      , buf_Dis-rule.obj-code
      920                                      , p-nonunique
      921                                     ).
      922           end.
      923           if available buf_dis-gds-rule
      924           and buf_dis-gds-rule.nonunique = ''
      925           and p-nonunique <> ''then do:
      926             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
      927                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      928                                      , p-gds-code
      929                                      , buf_Dis-rule.obj-type
      930                                      , buf_Dis-rule.obj-code
      931                                     ).
      932           end.
      933         end.
      934         create buf_dis-gds-rule .
      935         assign
      936         buf_dis-gds-rule.gds-code  = p-gds-code
      937         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      938         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      939         buf_dis-gds-rule.pos-type = p-pos-type
      940         buf_dis-gds-rule.discnt-role = v-discnt-role
      941         buf_dis-gds-rule.rule-num = p-rule-num
      942         buf_dis-gds-rule.nonunique = p-nonunique
      943         no-error
      944         .
      945       end.
      946       ASSIGN
      947       buf_dis-gds-rule.rule-num = p-rule-num
      948       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      949       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      950       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
      951       buf_dis-gds-rule.nonunique = p-nonunique
      952       no-error.
      953     end.
      954   end procedure.
      955   PROCEDURE cmp-disgdsru-write :
      956   do
      957   on error undo, return error
      958   :
      959     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
      960     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
      961     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
      962     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
      963     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
      964     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      965     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
      966     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
      967     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
      968     define variable v-rule-label          as character no-undo .
      969     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
      970     define buffer buf_dis-rule     for ub.dis-rule.
      971     run disgdsru-name in this-procedure (
      972                                         input  p-templ-rl-root
      973                                         ,output v-rule-label
      974                                         ) no-error .
      975     if error-status :error then do:
      976       undo, return error return-value .
      977     end.
      978     find first buf_tt0-dis-gds-rule exclusive-lock where
      979                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      980             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      981             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      982             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      983             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      984             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
      985             no-error .
      986     if not available buf_tt0-dis-gds-rule then do:
      987       create buf_tt0-dis-gds-rule .
      988       assign
      989       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      990       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      991       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      992       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      993       buf_tt0-dis-gds-rule.nonunique = p-nonunique
      994       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      995       no-error
      996       .
      997     end.
      998     find first buf_dis-rule no-lock where
      999               buf_dis-rule.rule-num = p-rule-num.
     1000     ASSIGN
     1001     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1002     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1003     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1004     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1005     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1006     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1007     no-error.
     1008     release buf_tt0-dis-gds-rule no-error .
     1009     if error-status:error then do:
     1010       undo, return error return-value .
     1011     end.
     1012   end.
     1013   END PROCEDURE.
     1014   DEFINE VARIABLE v-templ-rl-root AS INTEGER NO-UNDO.
     1015   define temp-table tt-dis-rule no-undo like ub.dis-rule.
     1016   define temp-table tt0-term_dis-rule no-undo like ub.dis-rule.
     1017   define variable  v-des               like ub.dis-rule.des               no-undo .
     1018   define variable  v-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     1019   define variable  v-subject-type      like ub.dis-rule.subject-type      no-undo .
     1020   define variable  v-level-1           as character no-undo .
     1021   define variable  v-level-2           as character no-undo .
     1022   define variable  v-value-type        like ub.dis-rule.value-type        no-undo .
     1023   define variable  v-term-value-type   like ub.dis-rule.value-type        no-undo .
     1024   define variable  v-output-display as logical   no-undo .
     1025   define variable  v-global         as integer no-undo .
     1026   define variable  v-host           as integer no-undo .
     1027   define variable  v-object         as integer no-undo .
     1028   define variable  v-tree              as character no-undo .
     1029   define variable  v-other          as character no-undo .
     1030   define variable level as integer no-undo .
     1031   define variable v-start-level as integer   no-undo .
     1032   DEFINE VARIABLE lookup-option AS CHARACTER NO-UNDO.
     1033   define buffer loc_dis-rule for ub.dis-rule.
     1034   define buffer loc_clients for ub.clients.
     1035   DEFINE BUTTON B-dis-rule-add
     1036        LABEL "Добавить"
     1037        SIZE 10 BY 1.
     1038   DEFINE BUTTON B-dis-rule-del
     1039        LABEL "Удалить"
     1040        SIZE 10 BY 1.
     1041   DEFINE BUTTON B-Help
     1042        LABEL "Помо&щь"
     1043        SIZE 3 BY 1
     1044        BGCOLOR 8 .
     1045   DEFINE BUTTON b-lkp
     1046        LABEL "&Просмотр"
     1047        SIZE 10 BY 1.
     1048   DEFINE BUTTON B-objects-add
     1049        LABEL "Добавить"
     1050        SIZE 10 BY 1.
     1051   DEFINE BUTTON B-objects-delete
     1052        LABEL "Удалить"
     1053        SIZE 10 BY 1.
     1054   DEFINE BUTTON b-quit AUTO-GO
     1055        LABEL "&Выход"
     1056        SIZE 10 BY 1
     1057        BGCOLOR 8 .
     1058   DEFINE BUTTON B-run
     1059        LABEL "&КОПИРОВАТЬ"
     1060        SIZE 30 BY 1
     1061        BGCOLOR 8 .
     1062   DEFINE VARIABLE cb-pos-type AS CHARACTER FORMAT "X(256)":U
     1063        LABEL "Место примен."
     1064        VIEW-AS COMBO-BOX INNER-LINES 5
     1065        LIST-ITEMS "Item 1"
     1066        DROP-DOWN-LIST
     1067        SIZE 20.5 BY 1 NO-UNDO.
     1068   DEFINE VARIABLE f-old-des AS CHARACTER FORMAT "X(256)":U
     1069        LABEL "Ориг.опис-е"
     1070        VIEW-AS FILL-IN NATIVE
     1071        SIZE 85 BY .67
     1072        FGCOLOR 4  NO-UNDO.
     1073   DEFINE VARIABLE T-dis-gds-rule AS LOGICAL INITIAL no
     1074        LABEL "Копировать привязку скидки на товар"
     1075        VIEW-AS TOGGLE-BOX
     1076        SIZE 40 BY 1 NO-UNDO.
     1077   DEFINE QUERY BR-dis-rule FOR
     1078         temp-dis-rule SCROLLING.
     1079   DEFINE QUERY BR-objects FOR
     1080         temp-clients SCROLLING.
     1081   DEFINE BROWSE BR-dis-rule
     1082     QUERY BR-dis-rule NO-LOCK DISPLAY
     1083         temp-dis-rule.des FORMAT "X(255)":U WIDTH 60
     1084         temp-dis-rule.rule-num FORMAT ">>>>>>>>9":U
     1085         temp-dis-rule.templ-rl-root FORMAT ">,>>>,>>9":U
     1086         temp-dis-rule.obj-type FORMAT "X(3)":U
     1087         temp-dis-rule.obj-code FORMAT ">>>>>>>>9":U
     1088     ENABLE
     1089         temp-dis-rule.des
     1090       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.77
     1091            TITLE "Правила скидок, с которых копируем (ОПИСАНИЯ МОЖНО ПОМЕНЯТЬ!!!)" FIT-LAST-COLUMN.
     1092   DEFINE BROWSE BR-objects
     1093     QUERY BR-objects NO-LOCK DISPLAY
     1094         temp-clients.obj-type FORMAT "X(3)":U
     1095         temp-clients.obj-code COLUMN-LABEL "Код" FORMAT ">>>>>>>>9":U
     1096         temp-clients.obj-name COLUMN-LABEL "Название" FORMAT "X(40)":U
     1097       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9
     1098            TITLE "Объекты, на которые копируем" FIT-LAST-COLUMN.
     1099   DEFINE FRAME Dialog-Frame
     1100        b-quit AT ROW 1 COL 1
     1101        T-dis-gds-rule AT ROW 1 COL 24 WIDGET-ID 6
     1102        B-Help AT ROW 1 COL 95
     1103        cb-pos-type AT ROW 2.07 COL 76 COLON-ALIGNED WIDGET-ID 18
     1104        B-dis-rule-add AT ROW 3 COL 1 WIDGET-ID 2
     1105        B-dis-rule-del AT ROW 3 COL 11 WIDGET-ID 8
     1106        b-lkp AT ROW 3 COL 21 WIDGET-ID 22
     1107        B-run AT ROW 3 COL 31 WIDGET-ID 14
     1108        BR-dis-rule AT ROW 4 COL 1 WIDGET-ID 100
     1109        f-old-des AT ROW 12 COL 1 WIDGET-ID 20
     1110        B-objects-add AT ROW 13 COL 1 WIDGET-ID 4
     1111        B-objects-delete AT ROW 13 COL 11 WIDGET-ID 10
     1112        BR-objects AT ROW 14 COL 1 WIDGET-ID 200
     1113        SPACE(0.69) SKIP(0.22)
     1114       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1115            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1116            TITLE "Копирование скидок".
     1117   ASSIGN
     1118          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1119          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1120   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1121   DO:
     1122     APPLY "END-ERROR":U TO SELF.
     1123   END.
     1124   ON CHOOSE OF B-dis-rule-add IN FRAME Dialog-Frame
     1125   DO:
     1126     RUN proc-b-dis-rule-add IN THIS-PROCEDURE NO-ERROR.
     1127     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1128   END.
     1129   ON CHOOSE OF B-dis-rule-del IN FRAME Dialog-Frame
     1130   DO:
     1131     RUN proc-b-dis-rule-del IN THIS-PROCEDURE NO-ERROR.
     1132     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1133   END.
     1134   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1135   DO:
     1136     IF NOT AVAILABLE temp-dis-rule THEN DO:
     1137       BELL.
     1138       RETURN NO-APPLY.
     1139     END.
     1140     run ref/show-dr.p ( input parparentproc
     1141                       ,INPUT temp-dis-rule.rule-num) NO-ERROR.
     1142   END.
     1143   ON CHOOSE OF B-objects-add IN FRAME Dialog-Frame
     1144   DO:
     1145       RUN proc-b-objects-add IN THIS-PROCEDURE NO-ERROR.
     1146     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1147   END.
     1148   ON CHOOSE OF B-objects-delete IN FRAME Dialog-Frame
     1149   DO:
     1150       RUN proc-b-objects-delete IN THIS-PROCEDURE NO-ERROR.
     1151     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1152   END.
     1153   ON CHOOSE OF B-run IN FRAME Dialog-Frame
     1154   DO:
     1155       ASSIGN
     1156       t-dis-gds-rule
     1157       cb-pos-type
     1158       .
     1159       if lookup(cb-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U) = 0
     1160       then do:
     1161         message
     1162         "Не заполнено место применения скидок"
     1163         view-as alert-box error .
     1164         undo, return no-apply.
     1165       end.
     1166       RUN proc-b-run IN THIS-PROCEDURE NO-ERROR.
     1167   END.
     1168   ON VALUE-CHANGED OF BR-dis-rule IN FRAME Dialog-Frame
     1169   DO:
     1170     IF AVAILABLE temp-dis-rule THEN DO:
     1171         DISPLAY
     1172         temp-dis-rule.old-des @ f-old-des
     1173         WITH FRAME Dialog-Frame.
     1174     END.
     1175     ELSE DO:
     1176         DISPLAY
     1177         '' @ f-old-des
     1178         WITH FRAME Dialog-Frame.
     1179     END.
     1180   END.
     1181   ON leave OF temp-dis-rule.des IN BROWSE br-dis-rule
     1182   DO:
     1183      IF AVAILABLE temp-dis-rule  THEN DO:
     1184          DEFINE BUFFER buf_temp-dis-rule FOR temp-dis-rule.
     1185          FIND FIRST buf_temp-dis-rule WHERE
     1186                   RECID(buf_temp-dis-rule) = RECID(temp-dis-rule).
     1187          ASSIGN
     1188          buf_temp-dis-rule.des = temp-dis-rule.des:SCREEN-VALUE IN BROWSE br-dis-rule.
     1189          OPEN QUERY BR-dis-rule FOR EACH temp-dis-rule NO-LOCK INDEXED-REPOSITION.
     1190          REPOSITION br-dis-rule TO RECID RECID(buf_temp-dis-rule).
     1191          APPLY "entry" to BROWSE br-dis-rule.
     1192      END.
     1193   END.
     1194   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1195   on F3 of frame Dialog-Frame anywhere do:
     1196     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1197     return no-apply.
     1198   end.
     1199   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1201     if b-dis-rule-add :sensitive then DO: apply "CHOOSE":U to b-dis-rule-add in frame Dialog-Frame. END.
     1202     return no-apply.
     1203   end.
     1204   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1205   on F8 of frame Dialog-Frame anywhere do:
     1206     if b-dis-rule-del :sensitive then DO: apply "CHOOSE":U to b-dis-rule-del in frame Dialog-Frame. END.
     1207     return no-apply.
     1208   end.
     1209   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1210   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1211   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1212   on help of frame Dialog-Frame
     1213   do:
     1214     run gbl/app_help.p
     1215       (input this-procedure :file-name
     1216       ,input ''
     1217       ,input ?
     1218       ) no-error.
     1219     if error-status :error then do:
     1220       message
     1221         "Ошибка при вызове помощи"
     1222         error-status :get-message(1)
     1223         view-as alert-box .
     1224     end.
     1225   end.
     1226   run minbtn-set in this-procedure .
     1227   on choose of b-help in frame Dialog-Frame
     1228   do:
     1229     apply "help":u to frame Dialog-Frame .
     1230   end.
     1231   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1232   procedure minbtn-set :
     1233       do
     1234           on error undo, return error return-value
     1235           :
     1236           define variable ii              as integer       no-undo .
     1237           define variable fh              as widget-handle no-undo .
     1238           define variable hh              as widget-handle no-undo .
     1239           define variable v-h             as handle        extent 4 no-undo .
     1240           define variable v-name-button   as character     no-undo .
     1241           define variable v-help-old-x    as decimal       no-undo .
     1242           define variable v-help-old-y    as decimal       no-undo .
     1243           define variable v-help-old-size as decimal       no-undo .
     1244           define variable v-frame-width   as decimal       no-undo .
     1245           define variable jj              as integer       no-undo .
     1246           do
     1247               on error undo, return error
     1248               :
     1249               assign
     1250                   v-frame-width = frame Dialog-Frame:width - 0.3
     1251                   fh            = frame Dialog-Frame:first-child
     1252                   hh            = fh:first-child
     1253                   ii            = 1
     1254                   .
     1255               do while valid-handle(hh):
     1256                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1257                   do:
     1258                       case lc(hh:name) :
     1259                           when "b-help" then
     1260                               do:
     1261                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1262                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1263                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1264                                   hh:TOOLTIP = "Помощь" .
     1265                                   v-help-old-x = hh:column .
     1266                                   v-help-old-y = hh:row    .
     1267                                   v-help-old-size = hh:width .
     1268                                   hh:width-chars = 2.5 .
     1269                               end.
     1270                           when "b-print" then
     1271                               do:
     1272                                   hh:load-image("cmp/b-print.bmp":u) .
     1273                                   hh:TOOLTIP = "Печать" .
     1274                                   v-h[ii] = hh:handle .
     1275                                   ii = ii + 1 .
     1276                                   hh:width-chars = 3 .
     1277                               end.
     1278                           when "b-history" or
     1279                           when "b-hist" then
     1280                               do:
     1281                                   hh:load-image("cmp/b-hist.bmp":u) .
     1282                                   hh:TOOLTIP = "История" .
     1283                                   v-h[ii] = hh:handle .
     1284                                   ii = ii + 1 .
     1285                                   hh:width-chars = 3 .
     1286                               end.
     1287                           when "b-sch" then
     1288                               do:
     1289                                   hh:load-image("cmp/b-sch.bmp":u) .
     1290                                   hh:TOOLTIP = "Установка Фильтра" .
     1291                                   v-h[ii] = hh:handle .
     1292                                   ii = ii + 1 .
     1293                                   hh:width-chars = 3 .
     1294                               end.
     1295                           when "b-hist-user" then
     1296                               do:
     1297                                   hh:load-image("cmp/b-hist.bmp":u) .
     1298                                   hh:TOOLTIP = "История пользователя" .
     1299                                   ii = ii + 1 .
     1300                               end.
     1301                       end case.
     1302                   end.
     1303                   hh = hh:next-sibling.
     1304               end.
     1305               b-help:column = v-frame-width - b-help:width-chars.
     1306               jj = 0.
     1307               repeat ii = 4 to 1 by -1 :
     1308                   if valid-handle (v-h[ii] ) then
     1309                   do:
     1310                       jj  = jj + 1 .
     1311                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1312                       v-h[ii]:row    = v-help-old-y .
     1313                   end.
     1314               end.
     1315           end.
     1316       end.
     1317   end procedure.
     1318   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1319   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1320   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1321   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1322   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1323   define variable v-diasize-current-frame-height as decimal   no-undo .
     1324   define variable v-diasize-change-size          as logical   no-undo .
     1325   define variable v-diasize-resize-button        as handle    no-undo .
     1326   define variable v-diasize-wndmax               as logical   no-undo .
     1327   define variable v-diasize-wndstore             as logical   no-undo .
     1328   define variable v-diasize-proc-name            as character no-undo .
     1329   define variable v-diasize-browse-handle        as handle    no-undo .
     1330   define variable v-diasize-browse-number        as integer   no-undo .
     1331   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1332   define temp-table temp-diasize-handle no-undo
     1333     field handle-value  as handle
     1334     field save-position as decimal
     1335     index xpk is primary unique handle-value
     1336     .
