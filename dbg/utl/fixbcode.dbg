     2126                           ,p-first-code
     2127                           ,p-last-code)
     2128                           ).
     2129         q_h9:QUERY-OPEN.
     2130         REPEAT while  q_h9:get-next().
     2131           assign
     2132             v-code_9 = buf_h9:buffer-field(v-field-name9):buffer-value
     2133           .
     2134           leave .
     2135         END.
     2136         q_h9:QUERY-CLOSE().
     2137         delete object q_h9.
     2138         delete object buf_h9.
     2139         v-b-code = max(v-code_9, v-b-code).
     2140       end.
     2141     end.
     2142     when "f-u":U then do:
     2143       for each buf_code-range share-lock
     2144           where ( buf_code-range.range-type = p-curr-type-cdrg
     2145                   and buf_code-range.db-num = p-db-num
     2146                   and buf_code-range.stts = "f":U
     2147                 ) or
     2148                 ( buf_code-range.range-type = p-curr-type-cdrg
     2149                   and buf_code-range.db-num = p-db-num
     2150                   and buf_code-range.stts = "u":U
     2151                 )
     2152       on error undo, return error
     2153       :
     2154         v-avail9 = 0.
     2155         do v-ii9 = 1 to num-entries('ub.bar-code,ub.place'):
     2156           assign
     2157           v-table-name9 = entry(v-ii9, 'ub.bar-code,ub.place')
     2158           v-field-name9 = entry(v-ii9, 'b-code,pl-code')
     2159           .
     2160           create buffer buf_h9 for table v-table-name9.
     2161           glog9 = buf_h9:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
     2162                                   , v-table-name9
     2163                                   , v-field-name9
     2164                                   , buf_code-range.first-code
     2165                                   , buf_code-range.last-code)
     2166                                   ) no-error .
     2167           if buf_h9:available then do:
     2168             assign
     2169             v-avail9 = v-avail9 + 1
     2170             .
     2171             if v-avail9 = 1 then do:
     2172               v-code-mess9 = string(buf_h9:buffer-field(v-field-name9):buffer-value)
     2173               .
     2174             end.
     2175           end.
     2176           delete object buf_h9.
     2177        end.
     2178        if v-avail9 > 0
     2179           and buf_code-range.stts = "f":U
     2180         then do:
     2181           assign
     2182             buf_code-range.stts = "u":U
     2183             v-b-code            = v-b-code + 1
     2184             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     2185                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     2186                                               , chr(10)
     2187                                               , buf_code-range.first-code
     2188                                               , buf_code-range.last-code
     2189                                               , v-code-mess9
     2190                                             )
     2191           .
     2192           if p-view-mess = true then do:
     2193             message
     2194               v-msg
     2195               view-as alert-box information.
     2196           end.
     2197           else do:
     2198             output stream getmc-stream to "getmc.log" append.
     2199             put stream getmc-stream unformatted
     2200               string( today, "99/99/9999" ) space(1)
     2201               string( time, "HH:MM:SS" ) space(1)
     2202               v-msg skip
     2203             .
     2204             output stream getmc-stream close.
     2205           end.
     2206         end.
     2207         if v-avail9 = 0
     2208           and buf_code-range.stts = "u":U
     2209         then do:
     2210           find first buf-c_code-range exclusive-lock
     2211             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     2212           .
     2213           assign
     2214             buf-c_code-range.stts = "c":U
     2215           .
     2216           release buf-c_code-range .
     2217           assign
     2218             buf_code-range.stts = "f":U
     2219             v-b-code            = v-b-code + 1
     2220             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     2221                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     2222                                               , chr(10)
     2223                                               , buf_code-range.first-code
     2224                                               , buf_code-range.last-code
     2225                                             )
     2226           .
     2227           if p-view-mess = true then do:
     2228             message
     2229               v-msg
     2230               view-as alert-box information.
     2231           end.
     2232           else do:
     2233             output stream getmc-stream to "getmc.log" append.
     2234             put stream getmc-stream unformatted
     2235               string( today, "99/99/9999" ) space(1)
     2236               string( time, "HH:MM:SS" ) space(1)
     2237               v-msg skip
     2238             .
     2239             output stream getmc-stream close.
     2240           end.
     2241         end.
     2242       end.
     2243     end.
     2244   end case.
     2245         end.
     2246         when 'scgb':U
     2247         or when 'sclc':U
     2248         then do:
     2249           case p-action :
     2250             when "get-m-code":U then do:
     2251               assign
     2252                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     2253               .
     2254             end.
     2255             when "f-u":U then do:
     2256               assign
     2257                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     2258               .
     2259               run mark-all-used-as-free in this-procedure (
     2260                                          input  p-db-num
     2261                                         ,input  p-curr-type-cdrg
     2262                                         ,output str-u-f
     2263                                         ,output str-u-f-rng
     2264                                       ).
     2265             end.
     2266           end case.
     2267           view frame get-max-code-inf.
     2268           assign
     2269             rec-cnt = 0
     2270           .
     2271           display
     2272             rec-cnt
     2273             with frame get-max-code-inf
     2274           .
     2275           for each buf_units no-lock
     2276               where lookup('вес':U, buf_units.type) > 0
     2277           on error undo, return error
     2278           :
     2279             for each buf_goods no-lock
     2280               where buf_goods.unit-base = buf_units.unit-name
     2281             on error undo, return error
     2282             :
     2283               assign
     2284                 rec-cnt = rec-cnt + 1
     2285               .
     2286               if ( rec-cnt modulo 10 ) = 0 then do:
     2287                 display
     2288                   rec-cnt
     2289                   with frame get-max-code-inf
     2290                 .
     2291               end.
     2292               run mc_gdsbcode in this-procedure (
     2293                                input  buf_goods.gds-code
     2294                               ,input  ?
     2295                               ,output v-main-bcode
     2296                             ) no-error .
     2297               if error-status :error then do:
     2298                 message
     2299                   vss-workfile vss-revision vss-description skip
     2300                   "Ошибка при поиске корневого бар-кода" skip
     2301                   "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2302                   error-status :get-message(1) skip
     2303                   return-value skip
     2304                   view-as alert-box error .
     2305                 undo, return error .
     2306               end.
     2307               for each buf_prod-bc no-lock
     2308                   where buf_prod-bc.b-code = v-main-bcode
     2309               on error undo, return error
     2310               :
     2311                 if p-curr-type-cdrg = 'sclc':U
     2312                   and buf_prod-bc.bc-on = FALSE
     2313                 then do:
     2314                   next.
     2315                 end.
     2316                 run mc_prodbcat in this-procedure (
     2317                                  buffer buf_prod-bc
     2318                                 ,input  'global=request':u
     2319                                 ,output l-prod-bc-global
     2320                               ) no-error .
     2321                 if error-status :error then do:
     2322                   message
     2323                     vss-workfile vss-revision vss-description skip
     2324                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     2325                     "Основной бар-код" buf_prod-bc.b-code skip
     2326                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     2327                     "Действие global=request" skip
     2328                     error-status :get-message(1) skip
     2329                     return-value skip
     2330                     view-as alert-box error .
     2331                   undo, return error .
     2332                 end.
     2333                 run mc_prodbcat in this-procedure (
     2334                                  buffer buf_prod-bc
     2335                                 ,input  'weight=request':u
     2336                                 ,output l-prod-bc-weight
     2337                               ) no-error .
     2338                 if error-status :error then do:
     2339                   message
     2340                     vss-workfile vss-revision vss-description skip
     2341                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     2342                     "Основной бар-код" buf_prod-bc.b-code skip
     2343                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     2344                     "Действие weight=request" skip
     2345                     error-status :get-message(1) skip
     2346                     return-value skip
     2347                     view-as alert-box error .
     2348                   undo, return error .
     2349                 end.
     2350                 if l-prod-bc-weight
     2351                   and ( ( l-prod-bc-global
     2352                           and p-curr-type-cdrg = 'scgb':U
     2353                         )
     2354                         or
     2355                         ( not l-prod-bc-global
     2356                           and p-curr-type-cdrg = 'sclc':U
     2357                         )
     2358                       )
     2359                 then do:
     2360                   case p-action :
     2361                     when "get-m-code":U then do:
     2362                       if integer( buf_prod-bc.b-str ) >= p-first-code
     2363                         and integer( buf_prod-bc.b-str ) <= p-last-code
     2364                         and integer( buf_prod-bc.b-str ) > v-b-code
     2365                       then do:
     2366                         assign
     2367                           v-b-code = integer( buf_prod-bc.b-str )
     2368                         .
     2369                       end.
     2370                     end.
     2371                     when "f-u":U then do:
     2372                       for each buf_code-range
     2373                         where buf_code-range.db-num     = p-db-num
     2374                           and buf_code-range.range-type = p-curr-type-cdrg
     2375                           and buf_code-range.stts       = "f":U
     2376                           and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     2377                           and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     2378                       on error undo, return error
     2379                       :
     2380                         assign
     2381                           buf_code-range.stts = "u":U
     2382                         .
     2383                         if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     2384                           assign
     2385                             str-u-f-rng = diff-list( str-u-f-rng
     2386                                                     ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     2387                                                     ,",":U
     2388                                                     )
     2389                           .
     2390                         end.
     2391                         if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     2392                           assign
     2393                             v-b-code = v-b-code + 1
     2394                             v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     2395                                                     + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     2396                                                     , chr(10)
     2397                                                     , buf_code-range.first-code
     2398                                                     , buf_code-range.last-code
     2399                                                     , buf_prod-bc.b-str
     2400                                                   )
     2401                             v-ret-msg = v-ret-msg + v-msg
     2402                           .
     2403                           if p-view-mess = true then do:
     2404                             message
     2405                               v-msg
     2406                               view-as alert-box information.
     2407                           end.
     2408                         end.
     2409                       end.
     2410                     end.
     2411                   end case.
     2412                 end.
     2413               end.
     2414             end.
     2415           end.
     2416           if p-action = "f-u":U then do:
     2417             do ind = 1 to num-entries( str-u-f-rng ):
     2418               assign
     2419                 v-b-code  = v-b-code + 1
     2420                 v-msg     = substitute( "Диапазон кодов &2&1"
     2421                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     2422                                         , chr(10)
     2423                                         , entry( ind, str-u-f-rng )
     2424                                       )
     2425                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     2426               .
     2427               if p-view-mess = true then do:
     2428                 message
     2429                   v-msg
     2430                   view-as alert-box information.
     2431               end.
     2432             end.
     2433           end.
     2434           hide frame get-max-code-inf no-pause .
     2435         end.
     2436         when 'pglc':U
     2437         then do:
     2438           case p-action :
     2439             when "get-m-code":U then do:
     2440               assign
     2441                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     2442               .
     2443             end.
     2444             when "f-u":U then do:
     2445               assign
     2446                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     2447               .
     2448               run mark-all-used-as-free in this-procedure (
     2449                                          input  p-db-num
     2450                                         ,input  p-curr-type-cdrg
     2451                                         ,output str-u-f
     2452                                         ,output str-u-f-rng
     2453                                       ).
     2454             end.
     2455           end case.
     2456           view frame get-max-code-inf.
     2457           assign
     2458             rec-cnt = 0
     2459           .
     2460           display
     2461             rec-cnt
     2462             with frame get-max-code-inf
     2463           .
     2464           for each buf_prod-bc no-lock where
     2465                   buf_prod-bc.b-str >= "00100"
     2466               and buf_prod-bc.b-str <= "99999"
     2467               and buf_prod-bc.bc-on-type = 'pglc':U
     2468               and length(buf_prod-bc.b-str) = 5
     2469           on error undo, return error
     2470           :
     2471               assign
     2472                 rec-cnt = rec-cnt + 1
     2473               .
     2474               if ( rec-cnt modulo 10 ) = 0 then do:
     2475                 display
     2476                   rec-cnt
     2477                   with frame get-max-code-inf
     2478                 .
     2479               end.
     2480               if p-curr-type-cdrg = 'pglc':U
     2481                 and buf_prod-bc.bc-on = FALSE
     2482               then do:
     2483                 next.
     2484               end.
     2485               run mc_prodbcat in this-procedure (
     2486                                 buffer buf_prod-bc
     2487                               ,input  'pgweight=request':u
     2488                               ,output l-prod-bc-pgweight
     2489                             ) no-error .
     2490               if error-status :error then do:
     2491                 message
     2492                   vss-workfile vss-revision vss-description skip
     2493                   "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     2494                   "Основной бар-код" buf_prod-bc.b-code skip
     2495                   "Дополнительный бар-код" buf_prod-bc.b-str skip
     2496                   "Действие weight=request" skip
     2497                   error-status :get-message(1) skip
     2498                   return-value skip
     2499                   view-as alert-box error .
     2500                 undo, return error .
     2501               end.
     2502               if l-prod-bc-pgweight
     2503               and p-curr-type-cdrg = 'pglc':U
     2504               then do:
     2505                 case p-action :
     2506                   when "get-m-code":U then do:
     2507                     if integer( buf_prod-bc.b-str ) >= p-first-code
     2508                       and integer( buf_prod-bc.b-str ) <= p-last-code
     2509                       and integer( buf_prod-bc.b-str ) > v-b-code
     2510                     then do:
     2511                       assign
     2512                         v-b-code = integer( buf_prod-bc.b-str )
     2513                       .
     2514                     end.
     2515                   end.
     2516                   when "f-u":U then do:
     2517                     for each buf_code-range
     2518                       where buf_code-range.db-num     = p-db-num
     2519                         and buf_code-range.range-type = p-curr-type-cdrg
     2520                         and buf_code-range.stts       = "f":U
     2521                         and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     2522                         and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     2523                     on error undo, return error
     2524                     :
     2525                     assign
     2526                     buf_code-range.stts = "u":U
     2527                       .
     2528                     if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     2529                         assign
     2530                           str-u-f-rng = diff-list( str-u-f-rng
     2531                                                   ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     2532                                                   ,",":U
     2533                                                   )
     2534                         .
     2535                     end.
     2536                     if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     2537                         assign
     2538                           v-b-code = v-b-code + 1
     2539                           v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     2540                                                   + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     2541                                                   , chr(10)
     2542                                                   , buf_code-range.first-code
     2543                                                   , buf_code-range.last-code
     2544                                                   , buf_prod-bc.b-str
     2545                                                 )
     2546                           v-ret-msg = v-ret-msg + v-msg
     2547                         .
     2548                       if p-view-mess = true then do:
     2549                         message
     2550                           v-msg
     2551                           view-as alert-box information.
     2552                       end.
     2553                     end.
     2554                   end.
     2555                 end.
     2556               end case.
     2557             end.
     2558           end.
     2559           if p-action = "f-u":U then do:
     2560             do ind = 1 to num-entries( str-u-f-rng ):
     2561               assign
     2562                 v-b-code = v-b-code + 1
     2563                 v-msg     = substitute( "Диапазон кодов &2&1"
     2564                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     2565                                         , chr(10)
     2566                                         , entry( ind, str-u-f-rng )
     2567                                       )
     2568                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     2569               .
     2570               if p-view-mess = true then do:
     2571                 message
     2572                   v-msg
     2573                   view-as alert-box information.
     2574               end.
     2575             end.
     2576           end.
     2577           hide frame get-max-code-inf no-pause .
     2578         end.
     2579         otherwise do:
     2580           message
     2581             vss-workfile vss-revision vss-description skip
     2582             "get-max-code" skip
     2583             "Непредусмотрена обработка диапазона кодов " p-curr-type-cdrg
     2584             view-as alert-box error.
     2585           return error.
     2586         end.
     2587       end case.
     2588     end.
     2589     return v-ret-msg.
     2590   end procedure.
     2591   procedure mark-all-used-as-free :
     2592     define input  parameter p-db-num         like ub.db.db-num             no-undo .
     2593     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
     2594     define output parameter p-str-u-f        as   character                 no-undo .
     2595     define output parameter p-str-u-f-rng    as   character                 no-undo .
     2596     do
     2597     on error undo, return error
     2598     :
     2599       define buffer buf_code-range   for ub.code-range.
     2600       define buffer buf-c_code-range for ub.code-range .
     2601       assign
     2602         p-str-u-f     = "":U
     2603         p-str-u-f-rng = "":U
     2604       .
     2605       for each buf_code-range share-lock
     2606           where buf_code-range.db-num     = p-db-num
     2607             and buf_code-range.range-type = p-curr-type-cdrg
     2608             and buf_code-range.stts       = "u":U
     2609       on error undo, return error
     2610       :
     2611         find first buf-c_code-range exclusive-lock
     2612           where rowid( buf-c_code-range ) = rowid( buf_code-range )
     2613         .
     2614         assign
     2615           buf-c_code-range.stts = "c":U
     2616         .
     2617         release buf-c_code-range .
     2618         assign
     2619           buf_code-range.stts = "f":U
     2620           p-str-u-f     = p-str-u-f + ",":U + buf_code-range.range-type + chr(3) + string( buf_code-range.first-code )
     2621           p-str-u-f-rng = p-str-u-f-rng + ",":U + string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     2622         .
     2623       end.
     2624       assign
     2625         p-str-u-f     = substring( p-str-u-f, 2, length( p-str-u-f ) - 1 )
     2626         p-str-u-f-rng = substring( p-str-u-f-rng, 2, length( p-str-u-f-rng ) - 1 )
     2627       .
     2628     end.
     2629   end procedure.
     2630   procedure mc_prodbcat :
     2631     do
     2632     on error undo, return error
     2633     :
     2634       define parameter buffer buf_prod-bc  for ub.prod-bc .
     2635       define input  parameter p-action           as character no-undo .
     2636       define output parameter p-return-attribute as logical no-undo .
     2637       def var vss-description as character no-undo init "prodbcat-01: определение параметров дополнительного бар-кода".
     2638       define buffer buf_bar-code   for ub.bar-code   .
     2639       define buffer buf_units      for ub.units      .
     2640       define buffer buf_code-range for ub.code-range .
     2641       define variable p-code-int as integer no-undo .
     2642       define variable v-cdrg-type as character no-undo .
     2643       if not available buf_prod-bc then do:
     2644         message
     2645           vss-workfile vss-revision vss-description skip
     2646           "Ошибка задания входных параметров" skip
     2647           "Не задан дополнительный бар-код" skip
     2648           view-as alert-box error .
     2649         undo, return error .
     2650       end.
     2651       find first buf_bar-code no-lock
     2652         where buf_bar-code.b-code = buf_prod-bc.b-code
     2653         no-error .
     2654       if not available buf_bar-code then do:
     2655         message
     2656           vss-workfile vss-revision vss-description skip
     2657           "Неправильная ссылка на основной бар-код" skip
     2658           "Основной бар-код" buf_prod-bc.b-code skip
     2659           "Дополнительный бар-код" buf_prod-bc.b-str skip
     2660           view-as alert-box error .
     2661         undo, return error .
     2662       end.
     2663       find first buf_units no-lock
     2664         where buf_units.unit-name = buf_bar-code.unit-cli
     2665         no-error .
     2666       if not available buf_units then do:
     2667         message
     2668           vss-workfile vss-revision vss-description skip
     2669           "Не найдена единица измерения основного бар-кода" skip
     2670           "Основной бар-код" buf_bar-code.b-code skip
     2671           "Единица измерения" buf_bar-code.unit-cli skip
     2672           view-as alert-box error .
     2673         undo, return error .
     2674       end.
     2675       def var ind                    as integer   no-undo .
     2676       def var v-num-entries-p-action as integer   no-undo .
     2677       def var v-action               as character no-undo .
     2678       assign
     2679         v-num-entries-p-action = num-entries(p-action)
     2680       .
     2681       assign
     2682         p-return-attribute = true
     2683       .
     2684       _ind:
     2685       do ind = 1 to v-num-entries-p-action
     2686       :
     2687        if ind > 1 and p-return-attribute = false then return.
     2688         assign
     2689           v-action = entry(ind, p-action)
     2690         .
     2691         case v-action :
     2692           when "global=request":u
     2693           then do:
     2694             if not (buf_prod-bc.bc-on-type = ''
     2695             or buf_prod-bc.bc-on-type = 'scgb':U
     2696             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2697               assign
     2698                 p-return-attribute = false
     2699               .
     2700             end.
     2701           end.
     2702           when "weight=request":u
     2703           then do:
     2704             if not (buf_prod-bc.bc-on-type = 'sclc':U
     2705             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     2706               assign
     2707                 p-return-attribute = false.
     2708             end.
     2709           end.
     2710           when "pgweight=request":u
     2711           then do:
     2712             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     2713               assign
     2714                 p-return-attribute = false.
     2715             end.
     2716           end.
     2717           when "petrolium=request":u
     2718           then do:
     2719             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     2720               assign
     2721                 p-return-attribute = false.
     2722             end.
     2723           end.
     2724           when "scaleable=request":u
     2725           then do:
     2726             if not (buf_prod-bc.bc-on-type = 'sslc':U
     2727             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2728               assign
     2729                 p-return-attribute = false.
     2730             end.
     2731           end.
     2732           otherwise do:
     2733             message
     2734               vss-workfile vss-revision vss-description skip
     2735               "Неизвестное значение параметра v-action " skip
     2736               "v-action" v-action skip
     2737               "p-action" p-action skip
     2738               view-as alert-box error .
     2739             undo, return error .
     2740           end.
     2741         end case.
     2742       end.
     2743     end.
     2744   end procedure.
     2745   procedure mc_gdsbcode :
     2746     define input  parameter p-gds-code  like ub.bar-code.gds-code  no-undo .
     2747     define input  parameter p-node-code like ub.bar-code.node-code no-undo .
     2748     define output parameter p-b-code    like ub.bar-code.b-code    no-undo .
     2749     def var vss-description as character no-undo init "gdsbcode-01: определение первичного бар-кода признака".
     2750     def var vss-proc-revision as character no-undo init "library.p gdsbcode-01" .
     2751     define buffer buf_bar-code for ub.bar-code .
     2752     def var v-unit-base like ub.goods.unit-base no-undo .
     2753     do
     2754     on error undo, return error
     2755     :
     2756       if p-node-code = ? then do:
     2757         run mc_gdsrootnode in this-procedure (
     2758            input  p-gds-code
     2759           ,output p-node-code
     2760           ) no-error .
     2761         if error-status :error then do:
     2762           message
     2763             vss-workfile vss-revision vss-description skip
     2764             "Ошибка при определении корневого признака товара" skip
     2765             "Код товара" p-gds-code skip
     2766             error-status :get-message(1) skip
     2767             return-value skip
     2768             view-as alert-box error .
     2769           undo, return error .
     2770         end.
     2771       end.
     2772       run mc_unitbase in this-procedure (
     2773          input  p-gds-code
     2774         ,output v-unit-base
     2775         ) no-error .
     2776       if error-status :error then do:
     2777         message
     2778           vss-workfile vss-revision vss-description skip
     2779           "Ошибка определения базовой единицы измерения товара" skip
     2780           "Код товара" p-gds-code skip
     2781           view-as alert-box error .
     2782         undo, return error .
     2783       end.
     2784       find first buf_bar-code no-lock
     2785         where buf_bar-code.gds-code  = p-gds-code
     2786           and buf_bar-code.node-code = p-node-code
     2787           and buf_bar-code.part-code = ""
     2788           and buf_bar-code.in-code   = ""
     2789           and buf_bar-code.unit-cli  = v-unit-base
     2790         no-error .
     2791       if not available buf_bar-code then do:
     2792         undo, return error vss-proc-revision + ":" + chr(10)
     2793           + "Не найден первичный бар-кода признака " + chr(10)
     2794           + "Код товара " + string(p-gds-code) + chr(10)
     2795           + "Код признака " + string(p-node-code) + chr(10)
     2796           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     2797           .
     2798       end.
     2799       assign
     2800         p-b-code = buf_bar-code.b-code
     2801       .
     2802     end.
     2803   end procedure.
     2804   procedure mc_gdsrootnode :
     2805     define input  parameter p-gds-code  like ub.goods.gds-code no-undo .
     2806     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2807     def var vss-description as character no-undo init "gdsrootnode-01: определение корневого признака товара по коду товара".
     2808     define buffer buf_goods   for ub.goods .
     2809     do
     2810     on error undo, return error
     2811     :
     2812       find first buf_goods no-lock
     2813         where buf_goods.gds-code  = p-gds-code
     2814         no-error .
     2815       if not available buf_goods then do:
     2816         message
     2817           vss-workfile vss-revision vss-description skip
     2818           "Не найден товар" skip
     2819           "Код товара" p-gds-code skip
     2820           view-as alert-box error .
     2821         undo, return error .
     2822       end.
     2823       run mc_prt-root-to-node-code in this-procedure (
     2824          input  buf_goods.prt-root
     2825         ,output p-root-node
     2826         ) no-error .
     2827       if error-status :error then do:
     2828         message
     2829           vss-workfile vss-revision vss-description skip
     2830           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     2831           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2832           "Указатель на корень шкалы" buf_goods.prt-root skip
     2833           error-status :get-message(1) skip
     2834           return-value skip
     2835           view-as alert-box error .
     2836         undo, return error .
     2837       end.
     2838     end.
     2839   end procedure.
     2840   procedure mc_prt-root-to-node-code :
     2841     define input  parameter p-prt-root  like ub.goods.prt-root no-undo .
     2842     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2843     def var vss-description as character no-undo init "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     2844     define buffer buf_gds-prt for ub.gds-prt .
     2845     do
     2846     on error undo, return error
     2847     :
     2848       find buf_gds-prt no-lock
     2849         where buf_gds-prt.upper-code = p-prt-root
     2850         no-error .
     2851       if not available buf_gds-prt then do:
     2852         message
     2853           vss-workfile vss-revision vss-description skip
     2854           "Не найден корень шкалы" skip
     2855           "Указатель на корень шкалы" p-prt-root skip
     2856           view-as alert-box error .
     2857         undo, return error .
     2858       end.
     2859       assign
     2860         p-root-node = buf_gds-prt.node-code
     2861       .
     2862     end.
     2863   end procedure.
     2864   procedure mc_unitbase :
     2865     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
     2866     define output parameter p-unit-base like ub.goods.unit-base no-undo .
     2867     def var vss-description as character no-undo init "unitbase-01: определение базовой единицы измерения товара".
     2868     define buffer buf_goods for ub.goods .
     2869     do
     2870     on error undo, return error
     2871     :
     2872       find first buf_goods no-lock
     2873         where buf_goods.gds-code = p-gds-code
     2874         no-error .
     2875       if not available buf_goods then do:
     2876         message
     2877           vss-workfile vss-revision vss-description skip
     2878           "Не найден товар" skip
     2879           "Код товара" p-gds-code skip
     2880           view-as alert-box error .
     2881         undo, return error .
     2882       end.
     2883       assign
     2884         p-unit-base = buf_goods.unit-base
     2885       .
     2886     end.
     2887   end procedure.
     2888   define variable v-curr-db-num    like ub.db.db-num             no-undo .
     2889   define variable v-curr-type-cdrg like ub.code-range.range-type no-undo .
     2890   define temp-table temp-b-code-info no-undo
     2891     field db-num            like ub.db.db-num
     2892     field curr-value-seq    as integer format ">>>>>>>>>>>>9" column-label "Текущее значение кода"
     2893     field active-exist      as logical format "yes/no"    column-label "Активный"
     2894     field active-first-code like ub.code-range.first-code column-label "Активный c"
     2895     field active-last-code  like ub.code-range.last-code  column-label "Активный по"
     2896     field active-b-code     like ub.bar-code.b-code format ">>>>>>>>>>>>9"
     2897     field free-exist        as logical format "yes/no"    column-label "Свободный"
     2898     field free-first-code   like ub.code-range.first-code column-label "Свободный c"
     2899     field free-last-code    like ub.code-range.last-code  column-label "Свободный по"
     2900     field free-b-code       like ub.bar-code.b-code
     2901     field error-message     as character
     2902     index xpk is primary unique db-num
     2903   .
     2904   DEFINE BUTTON b-active DEFAULT
     2905        LABEL "Активн."
     2906        SIZE 10 BY 1.
     2907   DEFINE BUTTON b-coderg DEFAULT
     2908        LABEL "Детально"
     2909        SIZE 10 BY 1.
     2910   DEFINE BUTTON b-exit AUTO-END-KEY DEFAULT
     2911        LABEL "&Выход"
     2912        SIZE 10 BY 1
     2913        BGCOLOR 8 .
     2914   DEFINE BUTTON b-f-u DEFAULT
     2915        LABEL "Использ."
     2916        SIZE 10 BY 1.
     2917   DEFINE BUTTON b-gen-free DEFAULT
     2918        LABEL "Свободн."
     2919        SIZE 10 BY 1.
     2920   DEFINE BUTTON b-help DEFAULT
     2921        LABEL "Помо&щь"
     2922        SIZE 10 BY 1
     2923        BGCOLOR 8 .
     2924   DEFINE VARIABLE sel-type-code-range AS CHARACTER FORMAT "X(45)":U INITIAL "глобальных собственных кодов"
     2925        LABEL "Диапазоны"
     2926        VIEW-AS COMBO-BOX INNER-LINES 11
     2927        LIST-ITEM-PAIRS "1","1",
     2928                        "2","2",
     2929                        "3","3",
     2930                        "4","4",
     2931                        "5","5",
     2932                        "6","6",
     2933                        "7","7",
     2934                        "8","8",
     2935                        "9","9",
     2936                        "10","10",
     2937                        "11","11"
     2938        DROP-DOWN-LIST
     2939        SIZE 52.5 BY 1 NO-UNDO.
     2940   DEFINE VARIABLE EDITOR-error-message AS CHARACTER
     2941        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2942        SIZE 84.5 BY 2.83
     2943        BGCOLOR 15  NO-UNDO.
     2944   DEFINE QUERY BROWSE-1 FOR
     2945         temp-b-code-info SCROLLING.
     2946   DEFINE BROWSE BROWSE-1
     2947     QUERY BROWSE-1 DISPLAY
     2948         db-num
     2949           curr-value-seq
     2950           active-exist
     2951           active-first-code
     2952           active-last-code
     2953           active-b-code
     2954           free-exist
     2955           free-first-code
     2956           free-last-code
     2957           free-b-code
     2958           error-message
     2959       WITH NO-ROW-MARKERS SEPARATORS SIZE 84.5 BY 11.58
     2960            BGCOLOR 15 .
     2961   DEFINE FRAME D-Dialog
     2962        b-exit AT ROW 1.17 COL 2
     2963        b-gen-free AT ROW 1.17 COL 12
     2964        b-active AT ROW 1.17 COL 22
     2965        b-f-u AT ROW 1.17 COL 32
     2966        b-coderg AT ROW 1.17 COL 42
     2967        b-help AT ROW 1.17 COL 76.5
     2968        sel-type-code-range AT ROW 2.5 COL 1.13
     2969        BROWSE-1 AT ROW 4 COL 2
     2970        EDITOR-error-message AT ROW 15.75 COL 2 NO-LABEL
     2971        SPACE(0.99) SKIP(0.29)
     2972       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2973            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2974            TITLE "Диапазоны кодов"
     2975            CANCEL-BUTTON b-exit.
     2976   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     2977   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     2978   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     2979   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     2980   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     2981   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     2982   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     2983   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     2984       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
     2985   RUN ensure-broker.
     2986   THIS-PROCEDURE:ADM-DATA =
     2987        'ADM1.1~`':U +
     2988        'SmartDialog~`':U +
     2989        'DIALOG-BOX~`':U +
     2990        'NO ~`':U +
     2991        '~`':U +
     2992        'temp-b-code-info~`':U +
     2993        '~`':U +
     2994        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     2995           + "~`":U +
     2996        'Layout,Hide-on-Init~`':U +
     2997        '~`':U +
     2998        '~`':U +
     2999        '~`~`~`~`~`~`~`~`~`~`~`':U +
     3000        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     3001            THEN "^^":U
     3002        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     3003             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     3004   PROCEDURE adm-apply-entry :
     3005     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3006   END PROCEDURE.
     3007   PROCEDURE adm-destroy :
     3008    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3009   END PROCEDURE.
     3010   PROCEDURE adm-disable :
     3011       DISABLE b-exit b-gen-free b-active b-f-u b-coderg b-help sel-type-code-range BROWSE-1 EDITOR-error-message WITH FRAME D-Dialog.
     3012       RUN dispatch ('disable-fields':U).
     3013       RUN set-attribute-list ('ENABLED=no':U).
     3014       RETURN.
     3015   END PROCEDURE.
     3016   PROCEDURE adm-edit-attribute-list :
     3017         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     3018         RETURN.
     3019   END PROCEDURE.
     3020   PROCEDURE adm-enable :
     3021       ENABLE UNLESS-HIDDEN b-exit b-gen-free b-active b-f-u b-coderg b-help sel-type-code-range BROWSE-1 EDITOR-error-message WITH FRAME D-Dialog.
     3022       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     3023       RUN set-attribute-list ('ENABLED=yes':U).
     3024       RETURN.
     3025   END PROCEDURE.
     3026   PROCEDURE adm-exit :
     3027        RUN notify ('exit':U).
     3028     RETURN.
     3029   END PROCEDURE.
     3030   PROCEDURE adm-hide :
     3031     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3032   END PROCEDURE.
     3033   PROCEDURE adm-initialize :
     3034     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3035   END PROCEDURE.
     3036   PROCEDURE adm-show-errors :
     3037       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     3038       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3039           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     3040       END.
     3041       RETURN.
     3042   END PROCEDURE.
     3043   PROCEDURE adm-UIB-mode :
     3044     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3045   END PROCEDURE.
     3046   PROCEDURE adm-view :
     3047     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3048   END PROCEDURE.
     3049   PROCEDURE dispatch :
     3050       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     3051       RUN broker-dispatch IN adm-broker-hdl
     3052           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     3053       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     3054   END PROCEDURE.
     3055   PROCEDURE ensure-broker :
     3056   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     3057   IF RETURN-VALUE NE "ADM-Broker":U THEN
     3058   DO:
     3059       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     3060       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     3061   END.
     3062   END PROCEDURE.
     3063   PROCEDURE get-attribute :
     3064     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     3065     RUN broker-get-attribute IN adm-broker-hdl
     3066         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     3067     RETURN RETURN-VALUE.
     3068   END PROCEDURE.
     3069   PROCEDURE get-attribute-list :
     3070     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     3071     RUN broker-get-attribute-list IN adm-broker-hdl
     3072         (INPUT THIS-PROCEDURE,
     3073          INPUT ?,
     3074          OUTPUT p-attr-list) NO-ERROR.
     3075     RETURN.
     3076   END PROCEDURE.
     3077   PROCEDURE new-state :
     3078     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3079     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     3080     RETURN.
     3081   END PROCEDURE.
     3082   PROCEDURE notify :
     3083     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     3084     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     3085     IF RETURN-VALUE = "ADM-ERROR":U THEN
     3086         RETURN "ADM-ERROR":U.
     3087     RETURN.
     3088   END PROCEDURE.
     3089   PROCEDURE set-attribute-list :
     3090     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     3091     RUN ensure-broker.
     3092     RUN broker-set-attribute-list IN adm-broker-hdl
     3093         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     3094     RETURN.
     3095   END PROCEDURE.
     3096   PROCEDURE set-position :
     3097       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     3098       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     3099       IF VALID-HANDLE(adm-object-hdl) THEN
     3100       DO:
     3101           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     3102           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     3103           DO:
     3104             IF p-row = 0 THEN p-row =
     3105               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     3106             IF p-col = 0 THEN p-col =
     3107               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     3108           END.
     3109           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     3110           DO:
     3111             parent-hdl = adm-object-hdl:PARENT.
     3112             IF p-row = 0 THEN p-row =
     3113               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     3114                 parent-hdl:ROW.
     3115             IF p-col = 0 THEN p-col =
     3116               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     3117                 parent-hdl:COL.
     3118           END.
     3119           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     3120           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     3121         ASSIGN adm-object-hdl:ROW    =   p-row
     3122                adm-object-hdl:COLUMN =   p-col.
     3123       END.
     3124       RETURN.
     3125   END PROCEDURE.
     3126   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     3127       STRING(adm-object-hdl)).
     3128   PAUSE 0 BEFORE-HIDE.
     3129   PROCEDURE adm-change-page :
     3130     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     3131     END PROCEDURE.
     3132   PROCEDURE delete-page :
     3133     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     3134     RUN broker-delete-page IN adm-broker-hdl
     3135         (INPUT THIS-PROCEDURE, INPUT p-page#).
     3136     END PROCEDURE.
     3137   PROCEDURE init-object :
     3138     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     3139     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     3140     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     3141     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     3142     RUN broker-init-object IN adm-broker-hdl
     3143         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     3144          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     3145     RETURN.
     3146   END PROCEDURE.
     3147   PROCEDURE init-pages :
     3148     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     3149     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3150         INPUT p-page-list) NO-ERROR.
     3151     END PROCEDURE.
     3152   PROCEDURE select-page :
     3153     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     3154     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3155         INPUT p-page#) NO-ERROR.
     3156     END PROCEDURE.
     3157   PROCEDURE view-page :
     3158     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     3159     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3160         INPUT p-page#).
     3161     END PROCEDURE.
     3162   ASSIGN
     3163          FRAME D-Dialog:SCROLLABLE       = FALSE
     3164          FRAME D-Dialog:HIDDEN           = TRUE.
     3165   ASSIGN
     3166          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME D-Dialog     = 1.
     3167   ASSIGN
     3168          EDITOR-error-message:READ-ONLY IN FRAME D-Dialog        = TRUE.
     3169   ON WINDOW-CLOSE OF FRAME D-Dialog
     3170   DO:
     3171     APPLY "END-ERROR":U TO SELF.
     3172   END.
     3173   ON CHOOSE OF b-active IN FRAME D-Dialog
     3174   DO:
     3175   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3176   if lookup(self :type
     3177            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3178            ) = 0
     3179   then do:
     3180     message
     3181       "$Workfile$"
     3182       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3183       "Интерфейсный элемент" self :name  skip
     3184       "Тип" self :type  skip
     3185       "Процедура" this-procedure :file-name skip
     3186       view-as alert-box .
     3187   end.
     3188   else do:
     3189     apply "entry":u to self  .
     3190     if focus :handle <> self :handle  then do:
     3191       return no-apply .
     3192     end.
     3193   end.
     3194     if available temp-b-code-info then do:
     3195       if v-curr-type-cdrg = 'sslc':U
     3196       or v-curr-type-cdrg = 'ssgb':U
     3197       then do:
     3198         message
     3199           "Текущее значение sequence" skip
     3200           "для диапазона взвешиваемых кодов задавать нельзя." skip
     3201           view-as alert-box information .
     3202         return no-apply.
     3203       end.
     3204       if temp-b-code-info.db-num <> v-curr-db-num
     3205         and v-curr-type-cdrg <> 'sclc':U
     3206         and v-curr-type-cdrg <> 'sslc':U
     3207         and v-curr-type-cdrg <> 'ssgb':U
     3208         and v-curr-type-cdrg <> 'pglc':U
     3209       then do:
     3210         message
     3211           "Текущее значение sequence можно задавать только для текущей базы данных" skip
     3212           "Текущая база данных" v-curr-db-num skip
     3213           "Выбрана база данных" temp-b-code-info.db-num skip
     3214           view-as alert-box information .
     3215         return no-apply.
     3216       end.
     3217       run put-into-active in this-procedure
     3218         (input temp-b-code-info.db-num
     3219         ) .
     3220       run reopen-query in this-procedure .
     3221     end.
     3222   END.
     3223   ON CHOOSE OF b-coderg IN FRAME D-Dialog
     3224   DO:
     3225   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3226   if lookup(self :type
     3227            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3228            ) = 0
     3229   then do:
     3230     message
     3231       "$Workfile$"
     3232       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3233       "Интерфейсный элемент" self :name  skip
     3234       "Тип" self :type  skip
     3235       "Процедура" this-procedure :file-name skip
     3236       view-as alert-box .
     3237   end.
     3238   else do:
     3239     apply "entry":u to self  .
     3240     if focus :handle <> self :handle  then do:
     3241       return no-apply .
     3242     end.
     3243   end.
     3244     define variable v-db-num as integer no-undo.
     3245     if available temp-b-code-info then do:
     3246       if v-curr-type-cdrg = 'sslc':U
     3247         or v-curr-type-cdrg = 'sclc':U
     3248       or v-curr-type-cdrg = 'pglc':U
     3249       then do:
     3250         assign
     3251           v-db-num = ?
     3252         .
     3253       end.
     3254       else do:
