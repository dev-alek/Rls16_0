     4251         then do:
     4252           assign
     4253             frame D-Dialog :virtual-width = frame D-Dialog :virtual-width + p-change-value
     4254           no-error .
     4255           if error-status :error
     4256           or error-status :get-message(1) <> ""
     4257           then do:
     4258             undo move_block, retry move_block.
     4259           end.
     4260         end.
     4261       end.
     4262       if p-move-resize
     4263       then do:
     4264         run diasize_position-resize-button in this-procedure .
     4265       end.
     4266       if v-diasize-wndstore = true
     4267       then do:
     4268         if connected("ub") = true
     4269         then do:
     4270           define variable v-cntxt-db-num        as integer   no-undo .
     4271           define variable v-cntxt-userid        as character no-undo .
     4272           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4273                                             , OUTPUT v-cntxt-userid
     4274                                             ) .
     4275           run gbl/wndsizew.p
     4276             (input  v-cntxt-db-num
     4277             ,input  v-cntxt-userid
     4278             ,input  v-diasize-proc-name
     4279             ,input  'width':u
     4280             ,input  string(frame D-Dialog :width - v-diasize-orig-frame-width)
     4281             ) .
     4282         end.
     4283       end.
     4284     end.
     4285     assign
     4286       v-diasize-change-size = false
     4287     .
     4288   end procedure.
     4289   procedure diasize_set-width :
     4290     define input  parameter p-new-width  as decimal   no-undo .
     4291     define input  parameter p-move-resize as logical   no-undo .
     4292     do
     4293     on error undo, return error return-value
     4294     :
     4295       run diasize_change-width in this-procedure
     4296         (input  (p-new-width - frame D-Dialog :width)
     4297         ,input  p-move-resize
     4298         ) .
     4299     end.
     4300   end procedure.
     4301   procedure diasize_position-resize-button :
     4302     do with frame D-Dialog
     4303     :
     4304       hide v-diasize-resize-button .
     4305       assign
     4306         v-diasize-resize-button :row = frame D-Dialog :height - v-diasize-resize-button :height
     4307                     - 1
     4308                     - (frame D-Dialog :border-bottom-pixels / session :pixels-per-row)
     4309         v-diasize-resize-button :col = frame D-Dialog :width - v-diasize-resize-button :width
     4310                     - 1
     4311                     - (frame D-Dialog :border-right-pixels / session :pixels-per-column)
     4312       .
     4313       view v-diasize-resize-button .
     4314     end.
     4315   end procedure.
     4316   on alt-right anywhere
     4317   do:
     4318     run diasize_change-width in this-procedure
     4319       (input 1
     4320       ,input true
     4321       ) .
     4322     return no-apply .
     4323   end.
     4324   on alt-left anywhere
     4325   do:
     4326     run diasize_change-width in this-procedure
     4327       (input -1
     4328       ,input true
     4329       ) .
     4330     return no-apply .
     4331   end.
     4332   on alt-down anywhere
     4333   do:
     4334     run diasize_change-height in this-procedure
     4335       (input 1
     4336       ,input true
     4337       ) .
     4338     return no-apply .
     4339   end.
     4340   on alt-up anywhere
     4341   do:
     4342     run diasize_change-height in this-procedure
     4343       (input -1
     4344       ,input true
     4345       ) .
     4346     return no-apply .
     4347   end.
     4348   on alt-enter of frame D-Dialog
     4349   do:
     4350     run diasize_maximize in this-procedure
     4351       (input  ?
     4352       ).
     4353     return no-apply .
     4354   end.
     4355   procedure diasize_end-move :
     4356     do
     4357     on error undo, return error return-value
     4358     :
     4359       define variable v-row-delta as decimal   no-undo .
     4360       define variable v-col-delta as decimal   no-undo .
     4361       define variable v-new-row as decimal   no-undo .
     4362       define variable v-new-col as decimal   no-undo .
     4363       assign
     4364         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4365         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4366       .
     4367       assign
     4368         v-row-delta = v-new-row - frame D-Dialog :height
     4369         v-col-delta = v-new-col - frame D-Dialog :width
     4370       .
     4371       run diasize_change-height in this-procedure
     4372         (input v-row-delta
     4373         ,input true
     4374         ) .
     4375       run diasize_change-width in this-procedure
     4376         (input v-col-delta
     4377         ,input true
     4378         ) .
     4379     end.
     4380   end procedure.
     4381   procedure diasize_maximize :
     4382     define input  parameter p-action as logical   no-undo .
     4383     do
     4384     on error undo, return error return-value
     4385     :
     4386       if p-action = ?
     4387       then do:
     4388         if v-diasize-need-maximize = true
     4389         then do:
     4390           assign
     4391             p-action = true
     4392           .
     4393         end.
     4394         else do:
     4395           assign
     4396             p-action = false
     4397           .
     4398         end.
     4399       end.
     4400       if p-action = true
     4401       then do:
     4402         run diasize_change-height in this-procedure
     4403           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4404               - frame D-Dialog :height-chars
     4405           ,input true
     4406           ) .
     4407         run diasize_change-width in this-procedure
     4408           (input session :width-chars
     4409               - frame D-Dialog :width-chars
     4410           ,input true
     4411           ) .
     4412         assign
     4413           v-diasize-need-maximize = false
     4414         .
     4415       end.
     4416       else do:
     4417         run diasize_change-width in this-procedure
     4418           (input v-diasize-orig-frame-width
     4419               - frame D-Dialog :width-chars
     4420           ,input true
     4421           ) .
     4422         run diasize_change-height in this-procedure
     4423           (input v-diasize-orig-frame-height
     4424               - frame D-Dialog :height-chars
     4425           ,input true
     4426           ) .
     4427         assign
     4428           v-diasize-need-maximize = true
     4429         .
     4430       end.
     4431     end.
     4432   end procedure.
     4433   procedure diasize_restore-orig-size :
     4434     do
     4435     on error undo, return error return-value
     4436     :
     4437       assign
     4438         v-diasize-current-frame-width  = frame D-Dialog :width
     4439         v-diasize-current-frame-height = frame D-Dialog :height
     4440       .
     4441       run diasize_set-height in this-procedure
     4442         (input  v-diasize-orig-frame-height
     4443         ,input  true
     4444         ) .
     4445       run diasize_set-width in this-procedure
     4446         (input  v-diasize-orig-frame-width
     4447         ,input  true
     4448         ) .
     4449     end.
     4450   end procedure.
     4451   procedure diasize_restore-current-size :
     4452     do
     4453     on error undo, return error return-value
     4454     :
     4455       run diasize_set-height in this-procedure
     4456         (input  v-diasize-current-frame-height
     4457         ,input  true
     4458         ) .
     4459       run diasize_set-width in this-procedure
     4460         (input  v-diasize-current-frame-width
     4461         ,input  true
     4462         ) .
     4463     end.
     4464   end procedure.
     4465   procedure diasize_set-browse-handle :
     4466     define input  parameter p-browse-handle as handle   no-undo .
     4467     define buffer buf_temp-browse-handle for temp-browse-handle .
     4468     do
     4469     on error undo, return error return-value
     4470     :
     4471       assign
     4472         v-diasize-browse-handle = p-browse-handle
     4473       .
     4474       for each buf_temp-browse-handle
     4475       on error undo, return error return-value
     4476       :
     4477         delete buf_temp-browse-handle .
     4478       end.
     4479     end.
     4480   end procedure.
     4481   procedure diasize_add_browse :
     4482     define input  parameter p-browse-type   as character no-undo .
     4483     define input  parameter p-browse-handle as handle    no-undo .
     4484     define buffer buf_temp-browse-handle for temp-browse-handle .
     4485     do
     4486     on error undo, return error return-value
     4487     :
     4488       assign
     4489         v-diasize-browse-number = v-diasize-browse-number + 1
     4490       .
     4491       create buf_temp-browse-handle .
     4492       assign
     4493         buf_temp-browse-handle.browse-type   = p-browse-type
     4494         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4495         buf_temp-browse-handle.browse-handle = p-browse-handle
     4496       .
     4497     end.
     4498   end procedure.
     4499   procedure diasize_init :
     4500     define variable v-default-value    as logical   no-undo .
     4501     define variable v-restore-saved    as logical   no-undo .
     4502     define variable v-resize-value-str as character no-undo .
     4503     do
     4504     on error undo, return error return-value
     4505     :
     4506       do with frame D-Dialog
     4507       :
     4508         assign
     4509           v-diasize-orig-frame-height = frame D-Dialog :height
     4510           v-diasize-orig-frame-width  = frame D-Dialog :width
     4511           v-diasize-browse-handle     = browse BROWSE-1 :handle
     4512         .
     4513         create button v-diasize-resize-button
     4514         assign
     4515           parent        = frame D-Dialog :first-child
     4516           label         = "s"
     4517           height-pixels = 16
     4518           width-pixels  = 16
     4519           visible       = true
     4520           sensitive     = true
     4521           movable       = true
     4522           triggers:
     4523             on end-move persistent run diasize_end-move in this-procedure .
     4524           end triggers.
     4525         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4526         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4527         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4528         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4529         assign
     4530           v-diasize-wndmax = false
     4531         .
     4532         if connected("ub") = true
     4533         then do:
     4534           define variable v-cntxt-db-num        as integer   no-undo .
     4535           define variable v-cntxt-userid        as character no-undo .
     4536           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4537                                             , OUTPUT v-cntxt-userid
     4538                                             ) .
     4539           run gbl/wndpar_r.p
     4540             (input  v-cntxt-db-num
     4541             ,input  v-cntxt-userid
     4542             ,input  'wndmax':U
     4543             ,output v-diasize-wndmax
     4544             ,output v-default-value
     4545             ) .
     4546         end.
     4547         assign
     4548           v-diasize-wndstore = false
     4549         .
     4550         if connected("ub") = true
     4551         then do:
     4552           run gbl/wndpar_r.p
     4553             (input  v-cntxt-db-num
     4554             ,input  v-cntxt-userid
     4555             ,input  'wndstore':U
     4556             ,output v-diasize-wndstore
     4557             ,output v-default-value
     4558             ) .
     4559         end.
     4560         assign
     4561           v-diasize-proc-name = entry(1, program-name(2), '.')
     4562         .
     4563         if v-diasize-wndstore = true
     4564         then do:
     4565           assign
     4566             v-restore-saved = false
     4567           .
     4568           if connected("ub") = true
     4569           then do:
     4570             run gbl/wndsizer.p
     4571               (input  v-cntxt-db-num
     4572               ,input  v-cntxt-userid
     4573               ,input  v-diasize-proc-name
     4574               ,input  'height':u
     4575               ,output v-resize-value-str
     4576               ) .
     4577             if v-resize-value-str <> '':U
     4578             then do:
     4579               run diasize_change-height in this-procedure
     4580                 (input  integer(v-resize-value-str)
     4581                 ,input  true
     4582                 ) .
     4583               assign
     4584                 v-restore-saved = true
     4585               .
     4586             end.
     4587           end.
     4588           if connected("ub") = true
     4589           then do:
     4590             run gbl/wndsizer.p
     4591               (input  v-cntxt-db-num
     4592               ,input  v-cntxt-userid
     4593               ,input  v-diasize-proc-name
     4594               ,input  'width':u
     4595               ,output v-resize-value-str
     4596               ) .
     4597             if v-resize-value-str <> '':U
     4598             then do:
     4599               run diasize_change-width in this-procedure
     4600                 (input  integer(v-resize-value-str)
     4601                 ,input  true
     4602                 ) .
     4603               assign
     4604                 v-restore-saved = true
     4605               .
     4606             end.
     4607           end.
     4608           if v-restore-saved <> true
     4609           then do:
     4610             if v-diasize-wndmax = true
     4611             then do:
     4612               run diasize_maximize in this-procedure
     4613                 (input  true
     4614                 ) .
     4615             end.
     4616           end.
     4617         end.
     4618         else do:
     4619           if v-diasize-wndmax = true
     4620           then do:
     4621             run diasize_maximize in this-procedure
     4622               (input  true
     4623               ) .
     4624           end.
     4625         end.
     4626       end.
     4627     end.
     4628   end procedure.
     4629   procedure diasize_need-full-display :
     4630     define output parameter p-need-full-display as logical   no-undo .
     4631     do
     4632     on error undo, return error return-value
     4633     :
     4634       assign
     4635         p-need-full-display = v-diasize-need-full-display
     4636       .
     4637       assign
     4638         v-diasize-need-full-display = false
     4639       .
     4640     end.
     4641   end procedure.
     4642   procedure get-context :
     4643      define output parameter p-db-num as integer          no-undo.
     4644      define output parameter p-user-id as character        no-undo.
     4645      define variable v-login               as character    no-undo.
     4646      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4647      define buffer buf_user-login  for ub.user-login .
     4648      do
     4649      on error undo, return error
     4650      :
     4651            FIND FIRST buf_sys-ctrl no-lock.
     4652            ASSIGN
     4653               v-login = USERID("ub")
     4654               p-db-num = buf_sys-ctrl.db-num
     4655            .
     4656            FIND FIRST buf_user-login
     4657                 WHERE buf_user-login.db-num = p-db-num
     4658                   AND buf_user-login.user-login = v-login
     4659                 no-lock
     4660                 no-error
     4661                 .
     4662            IF AVAILABLE buf_user-login
     4663            THEN DO:
     4664               assign
     4665                  p-user-id = buf_user-login.user-id
     4666               .
     4667            END.
     4668      end.
     4669   end procedure.
     4670       run diasize_init in this-procedure .
     4671   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4672     (input  'is-erpRN'
     4673     ,input  0
     4674     ,input  ''
     4675     ,input  0
     4676     ,input  ''
     4677     ,input  ''
     4678     ,input  ''
     4679     ,input  NO
     4680     ,output conf-par
     4681     ,output par-type
     4682     ) no-error .
     4683             if not error-status:error and conf-par = "yes":U then mode-erprn = yes.
     4684             else mode-erprn = no.
     4685   define buffer buf_sys-ctrl for ub.sys-ctrl .
     4686   assign
     4687     sel-type-code-range:list-item-pairs  in frame D-Dialog =
     4688     "глобальных собственных кодов" + chr(44) + 'bcgb':U + chr(44) +
     4689     "глобальных весовых кодов" + chr(44) + 'scgb':U  + chr(44) +
     4690     "локальных весовых кодов" + chr(44) + 'sclc':U + chr(44) +
     4691     "локальных штучных кодов для весов" + chr(44) + 'pglc':U + chr(44) +
     4692     "глобальных взвешиваемых кодов" + chr(44) + 'ssgb':U + chr(44) +
     4693     "локальных взвешиваемых кодов" + chr(44) + 'sslc':U + chr(44) +
     4694     "глобальных кодов правил скидок и расписаний" + chr(44) + 'drgb':U + chr(44) +
     4695     "внутренних кодов дисконтных карт" + chr(44) +  'dcgb':U + chr(44) +
     4696     "глобальных кодов организаций" + chr(44) +  'fmgb':U + chr(44) +
     4697     "глобальных кодов физ.лиц" + chr(44) + 'pngb':U + chr(44) +
     4698     "глобальных кодов договоров" + chr(44) + 'ctgb':U + chr(44) +
     4699     "глобальных кодов точек привязки" + chr(44) + 'cagb':U + chr(44) +
     4700     "глобальных кодов фин.документов" + chr(44) + 'fdgb':U
     4701   .
     4702   assign
     4703     sel-type-code-range = 'bcgb':U
     4704     sel-type-code-range:screen-value = 'bcgb':U
     4705   .
     4706   do:
     4707     browse BROWSE-1 :set-repositioned-row( 5, "conditional" ) .
     4708   end.
     4709   apply "value-changed" to sel-type-code-range in frame D-Dialog .
     4710   find first buf_sys-ctrl no-lock .
     4711   assign
     4712     frame D-Dialog:title = frame D-Dialog:title + chr(32) + substitute( "(БД &1)", buf_sys-ctrl.db-num )
     4713   .
     4714   IF THIS-PROCEDURE:PERSISTENT THEN DO:
     4715       MESSAGE "A SmartDialog is not intended ":U SKIP
     4716               "to be run Persistent or to be placed ":U SKIP
     4717               "in another SmartObject at UIB design time.":U
     4718               VIEW-AS ALERT-BOX ERROR.
     4719       RUN disable_UI.
     4720       DELETE PROCEDURE THIS-PROCEDURE.
     4721       RETURN.
     4722   END.
     4723   RUN dispatch ('create-objects':U).
     4724   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
     4725   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
     4726   MAIN-BLOCK:
     4727   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4728      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4729     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
     4730     WAIT-FOR GO OF FRAME D-Dialog.
     4731   END.
     4732   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
     4733   PROCEDURE adm-create-objects :
     4734   END PROCEDURE.
     4735   PROCEDURE adm-row-available :
     4736     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     4737     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     4738     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     4739     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     4740     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     4741     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     4742     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     4743     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     4744     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     4745     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     4746     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     4747     IF adm-updating-record THEN RETURN.
     4748     RUN get-attribute ('FIELDS-ENABLED':U).
     4749     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     4750     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     4751         OUTPUT link-handle) NO-ERROR.
     4752     IF link-handle = "":U THEN
     4753         RETURN.
     4754     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     4755     IF NUM-ENTRIES(link-handle) > 1 THEN
     4756         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     4757             "encountered more than one RECORD-SOURCE.":U SKIP
     4758             "The first - ":U record-source-hdl:file-name " - will be used.":U
     4759                VIEW-AS ALERT-BOX ERROR.
     4760     RUN get-attribute ('Key-Name':U).
     4761     key-name = RETURN-VALUE.
     4762     IF key-name = "":U THEN key-name = ?.
     4763     IF key-name NE ? THEN DO:
     4764       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     4765         NO-ERROR.
     4766       IF key-value NE ? THEN
     4767         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     4768     END.
     4769   IF VALID-HANDLE (adm-object-hdl) THEN
     4770       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     4771   RUN notify IN THIS-PROCEDURE ('row-available':U).
     4772   END PROCEDURE.
     4773   PROCEDURE disable_UI :
     4774     HIDE FRAME D-Dialog.
     4775   END PROCEDURE.
     4776   PROCEDURE display-dependent-info :
     4777     do
     4778     on error undo, return error
     4779     :
     4780       if available temp-b-code-info then do:
     4781         do with frame D-Dialog
     4782         :
     4783           assign
     4784             editor-error-message :screen-value = temp-b-code-info.error-message
     4785           .
     4786         end.
     4787       end.
     4788     end.
     4789   END PROCEDURE.
     4790   PROCEDURE enable_UI :
     4791     DISPLAY sel-type-code-range EDITOR-error-message
     4792         WITH FRAME D-Dialog.
     4793     ENABLE b-exit b-gen-free b-active b-f-u b-coderg b-help sel-type-code-range
     4794            BROWSE-1 EDITOR-error-message
     4795         WITH FRAME D-Dialog.
     4796     VIEW FRAME D-Dialog.
     4797     run reopen-query in this-procedure .
     4798   END PROCEDURE.
     4799   PROCEDURE fill-temp-b-code-info :
     4800     do
     4801     on error undo, return error
     4802     :
     4803       define buffer buf_temp-b-code-info for temp-b-code-info .
     4804       define buffer buf_db               for ub.db .
     4805       define buffer buf_code-range       for ub.code-range .
     4806       define buffer buf_bar-code         for ub.bar-code .
     4807       define buffer buf_dis-card         for ub.dis-card.
     4808       define buffer buf_dis-rule         for ub.dis-rule.
     4809       define buffer buf_dis-time-rule    for ub.dis-time-rule.
     4810       define buffer buf_clients          for ub.clients.
     4811       define buffer buf_contract         for ub.contract.
     4812       define buffer buf_rule-by-call     for ub.rule-by-call.
     4813       define buffer buf_sysconf          for ub.sysconf.
     4814       define buffer buf_fin-doc          for ub.fin-doc.
     4815       define variable v-code-1           as integer no-undo .
     4816       define variable v-code-2           as integer no-undo .
     4817       define buffer buf_sys-ctrl for ub.sys-ctrl .
     4818       find first buf_sys-ctrl no-lock .
     4819       assign
     4820         v-curr-db-num = buf_sys-ctrl.db-num
     4821       .
     4822       for each buf_temp-b-code-info
     4823       :
     4824         delete buf_temp-b-code-info .
     4825       end.
     4826       for each buf_db
     4827             by buf_db.db-num
     4828       on error undo, return error
     4829       :
     4830         create buf_temp-b-code-info .
     4831         assign
     4832           buf_temp-b-code-info.db-num = buf_db.db-num
     4833         .
     4834         if buf_db.db-num = v-curr-db-num
     4835            or v-curr-type-cdrg = 'sclc':U
     4836            or v-curr-type-cdrg = 'pglc':U
     4837            or v-curr-type-cdrg = 'sslc':U
     4838         then do:
     4839           case v-curr-type-cdrg:
     4840             when 'bcgb':U then do:
     4841               assign
     4842                 buf_temp-b-code-info.curr-value-seq = current-value(s-bcgb-code, ub)
     4843               .
     4844             end.
     4845             when 'scgb':U then do:
     4846               assign
     4847                 buf_temp-b-code-info.curr-value-seq = current-value(s-scgb-code, ub)
     4848               .
     4849             end.
     4850             when 'sclc':U then do:
     4851               assign
     4852                 buf_temp-b-code-info.curr-value-seq = current-value(s-sclc-code, ub)
     4853               .
     4854             end.
     4855             when 'pglc':U then do:
     4856               assign
     4857                 buf_temp-b-code-info.curr-value-seq = current-value(s-pglc-code, ub)
     4858               .
     4859             end.
     4860             when 'ssgb':U then do:
     4861               assign
     4862                 buf_temp-b-code-info.curr-value-seq = ?
     4863               .
     4864             end.
     4865             when 'sslc':U then do:
     4866               assign
     4867                 buf_temp-b-code-info.curr-value-seq = ?
     4868               .
     4869             end.
     4870             when 'fmgb':U then do:
     4871               assign
     4872                 buf_temp-b-code-info.curr-value-seq = current-value(s-fmgb-code, ub)
     4873               .
     4874             end.
     4875             when 'pngb':U then do:
     4876               assign
     4877                 buf_temp-b-code-info.curr-value-seq = current-value(s-pngb-code, ub)
     4878               .
     4879             end.
     4880             when 'drgb':U then do:
     4881               assign
     4882                 buf_temp-b-code-info.curr-value-seq = current-value(s-drgb-code, ub)
     4883               .
     4884             end.
     4885             when 'dcgb':U then do:
     4886               assign
     4887                 buf_temp-b-code-info.curr-value-seq = current-value(s-dcgb-code, ub)
     4888               .
     4889             end.
     4890             when 'ctgb':U then do:
     4891               assign
     4892                 buf_temp-b-code-info.curr-value-seq = current-value(s-ctgb-code, ub)
     4893               .
     4894             end.
     4895             when 'cagb':U then do:
     4896               assign
     4897                 buf_temp-b-code-info.curr-value-seq = current-value(s-cagb-code, ub)
     4898               .
     4899             end.
     4900             when 'fdgb':U then do:
     4901               assign
     4902                 buf_temp-b-code-info.curr-value-seq = current-value(s-fin-doc, ub)
     4903               .
     4904             end.
     4905           end case.
     4906         end.
     4907         else do:
     4908           assign
     4909             buf_temp-b-code-info.curr-value-seq = ?
     4910           .
     4911         end.
     4912         find first buf_code-range no-lock
     4913           where buf_code-range.db-num     = buf_db.db-num
     4914             and buf_code-range.range-type = v-curr-type-cdrg
     4915             and buf_code-range.stts       = "a"
     4916           no-error .
     4917         if available buf_code-range then do:
     4918           assign
     4919             buf_temp-b-code-info.active-exist      = true
     4920             buf_temp-b-code-info.active-first-code = buf_code-range.first-code
     4921             buf_temp-b-code-info.active-last-code  = buf_code-range.last-code
     4922             buf_temp-b-code-info.active-b-code = ?
     4923             v-code-1 = 0
     4924             v-code-2 = 0
     4925           .
     4926           case v-curr-type-cdrg:
     4927             when 'bcgb':U then do:
     4928               for each buf_bar-code no-lock
     4929                 where buf_bar-code.b-code >= buf_code-range.first-code
     4930                   and buf_bar-code.b-code <= buf_code-range.last-code
     4931               by buf_bar-code.b-code descending
     4932               :
     4933                 assign
     4934                   buf_temp-b-code-info.active-b-code = buf_bar-code.b-code
     4935                 .
     4936                 leave .
     4937               end.
     4938             end.
     4939             when 'dcgb':U then do:
     4940               for each buf_dis-card no-lock
     4941                 where buf_dis-card.card-num >= buf_code-range.first-code
     4942                   and buf_dis-card.card-num <= buf_code-range.last-code
     4943               by buf_dis-card.card-num descending
     4944               :
     4945                 assign
     4946                   buf_temp-b-code-info.active-b-code = buf_dis-card.card-num
     4947                 .
     4948                 leave .
     4949               end.
     4950             end.
     4951             when 'fmgb':U
     4952             or
     4953             when 'pngb':U
     4954             then do:
     4955               for each buf_clients no-lock
     4956                 where buf_clients.obj-type = (if v-curr-type-cdrg = 'fmgb':U then 'орг':U else 'чел':U)
     4957                   and buf_clients.obj-code >= buf_code-range.first-code
     4958                   and buf_clients.obj-code <= buf_code-range.last-code
     4959               by buf_clients.obj-code descending
     4960               :
     4961                 assign
     4962                   buf_temp-b-code-info.active-b-code = buf_clients.obj-code
     4963                 .
     4964                 leave .
     4965               end.
     4966             end.
     4967             when 'drgb':U then do:
     4968               for each buf_dis-rule no-lock
     4969                 where buf_dis-rule.rule-num >= buf_code-range.first-code
     4970                   and buf_dis-rule.rule-num <= buf_code-range.last-code
     4971               by buf_dis-rule.rule-num descending
     4972               :
     4973                 assign
     4974                   v-code-1 = buf_dis-rule.rule-num
     4975                 .
     4976                 leave .
     4977               end.
     4978               for each buf_dis-time-rule no-lock
     4979                 where buf_dis-time-rule.time-rule-num >= buf_code-range.first-code
     4980                   and buf_dis-time-rule.time-rule-num <= buf_code-range.last-code
     4981               by buf_dis-time-rule.time-rule-num descending
     4982               :
     4983                 assign
     4984                 v-code-2 = buf_dis-time-rule.time-rule-num
     4985                 .
     4986                 leave .
     4987               end.
     4988               assign
     4989                 buf_temp-b-code-info.active-b-code = maximum (v-code-1, v-code-2)
     4990               .
     4991             end.
     4992             when 'sclc':U then do:
     4993             end.
     4994             when 'pglc':U then do:
     4995             end.
     4996             when 'ctgb':U then do:
     4997               for each buf_contract no-lock
     4998                 where buf_contract.contract-code >= buf_code-range.first-code
     4999                   and buf_contract.contract-code <= buf_code-range.last-code
     5000               by buf_contract.contract-code descending
     5001               :
     5002                 assign
     5003                   buf_temp-b-code-info.active-b-code = buf_contract.contract-code
     5004                 .
     5005                 leave .
     5006               end.
     5007             end.
     5008             when 'cagb':U then do:
     5009               for each buf_rule-by-call no-lock
     5010                 where buf_rule-by-call.call#_id >= buf_code-range.first-code
     5011                   and buf_rule-by-call.call#_id <= buf_code-range.last-code
     5012               by buf_rule-by-call.call#_id descending
     5013               :
     5014                 assign
     5015                   buf_temp-b-code-info.active-b-code = buf_rule-by-call.call#_id
     5016                 .
     5017                 leave .
     5018               end.
     5019             end.
     5020             when 'fdgb':U then do:
     5021               for each buf_sysconf no-lock:
     5022                 _fin-doc:
     5023                 for each buf_fin-doc no-lock
     5024                 where buf_fin-doc.host-code = buf_sysconf.host-code
     5025                   and buf_fin-doc.fin-doc-code >= buf_code-range.first-code
     5026                   and buf_fin-doc.fin-doc-code <= buf_code-range.last-code
     5027                 by buf_fin-doc.fin-doc-code descending
     5028                 :
     5029                   if buf_fin-doc.fin-doc-code > buf_temp-b-code-info.active-b-code then do:
     5030                     assign
     5031                       buf_temp-b-code-info.active-b-code = buf_fin-doc.fin-doc-code
     5032                     .
     5033                     leave _fin-doc.
     5034                   end.
     5035                   if buf_fin-doc.fin-doc-code <= buf_temp-b-code-info.active-b-code then do:
     5036                     leave _fin-doc.
     5037                   end.
     5038                 end.
     5039               end.
     5040             end.
     5041           END CASE.
     5042         end.
     5043         find first buf_code-range no-lock
     5044           where buf_code-range.db-num     = buf_db.db-num
     5045             and buf_code-range.range-type = v-curr-type-cdrg
     5046             and buf_code-range.stts       = "f"
     5047           no-error .
     5048         if available buf_code-range then do:
     5049           assign
     5050             buf_temp-b-code-info.free-exist      = true
     5051             buf_temp-b-code-info.free-first-code = buf_code-range.first-code
     5052             buf_temp-b-code-info.free-last-code  = buf_code-range.last-code
     5053           .
     5054           for each buf_bar-code no-lock
     5055             where buf_bar-code.b-code >= buf_code-range.first-code
     5056               and buf_bar-code.b-code <= buf_code-range.last-code
     5057           by buf_bar-code.b-code descending
     5058           :
     5059             assign
     5060               buf_temp-b-code-info.free-b-code = buf_bar-code.b-code
     5061             .
     5062             leave .
     5063           end.
     5064         end.
     5065         assign
     5066           buf_temp-b-code-info.error-message
     5067             = "База данных " + string(buf_temp-b-code-info.db-num)
     5068         .
     5069         if  buf_temp-b-code-info.active-exist = false
     5070         and buf_temp-b-code-info.free-exist   = false then do:
     5071           assign
     5072             buf_temp-b-code-info.error-message
     5073               = buf_temp-b-code-info.error-message
     5074               + chr(10)
     5075               + "У базы отсутствуют активный и свободные диапазоны"
     5076           .
     5077         end.
     5078         if  buf_temp-b-code-info.active-exist = true
     5079         and buf_temp-b-code-info.db-num = v-curr-db-num
     5080         and buf_temp-b-code-info.curr-value-seq > ( buf_temp-b-code-info.active-first
     5081                                               + buf_temp-b-code-info.active-last ) / 2
     5082         and buf_temp-b-code-info.free-exist   = false
     5083         then do:
     5084           assign
     5085             buf_temp-b-code-info.error-message
     5086               = buf_temp-b-code-info.error-message
     5087               + chr(10)
     5088               + "Текущее значение sequence превышает середину активного диапазона "
     5089               + "и не создан свободный диапазон"
     5090               + (if   buf_temp-b-code-info.db-num <> 0
     5091                  then chr(10) + "Для удаленной базы данных это может быть вызвано "
     5092                   + "задержкой передачи информации по новостям"
     5093                  else ""
     5094                 )
     5095           .
     5096         end.
     5097         if v-curr-type-cdrg = 'sclc':U
     5098            or v-curr-type-cdrg = 'sslc':U
     5099            or v-curr-type-cdrg = 'pglc':U
     5100         then do:
     5101           leave.
     5102         end.
     5103       end.
     5104     end.
     5105   END PROCEDURE.
     5106   PROCEDURE gen-free-code-range :
     5107     do
     5108     on error undo, return error
     5109     :
     5110       define input parameter p-db-num like ub.db.db-num no-undo .
     5111       define buffer buf_temp-b-code-info for temp-b-code-info .
     5112       define variable lok as logical   no-undo .
     5113       find first buf_temp-b-code-info
     5114         where buf_temp-b-code-info.db-num = p-db-num
     5115         no-error .
     5116       if buf_temp-b-code-info.free-exist then do:
     5117         assign
     5118           lok = false
     5119         .
     5120         message
     5121           "Для базы данных уже существует свободный диапазон." skip
     5122           "База данных" p-db-num skip
     5123           "Вы уверены, что хотите сгенерировать ЕЩЕ ОДИН свободный диапазон?" skip
     5124           view-as alert-box question buttons yes-no update lok .
     5125         if lok <> true then do:
     5126           return .
     5127         end.
     5128       end.
     5129       else do:
     5130         assign
     5131           lok = false
     5132         .
     5133         message
     5134           "База данных" p-db-num skip
     5135           "Вы хотите сгенерировать свободный диапазон?" skip
     5136           view-as alert-box question buttons yes-no update lok .
     5137         if lok <> true then do:
     5138           return .
     5139         end.
     5140       end.
     5141       run new-bcod-gen-code-range in this-procedure
     5142         (input p-db-num,
     5143          input v-curr-type-cdrg
     5144         ) no-error .
     5145       if error-status :error then do:
     5146         message
     5147           vss-workfile vss-revision vss-description skip
     5148           "Ошибка при создании нового свободного диапазона" skip
     5149           "База данных" p-db-num skip
     5150           error-status :get-message(1) skip
     5151           return-value skip
     5152           view-as alert-box error .
     5153         undo, return error .
     5154       end.
     5155       else do:
     5156         message
     5157           return-value skip
     5158           "База данных" p-db-num skip
     5159           view-as alert-box information .
     5160       end.
     5161     end.
     5162   END PROCEDURE.
     5163   PROCEDURE put-into-active :
     5164     do
     5165     on error undo, return error
     5166     :
     5167       define input parameter p-db-num like ub.db.db-num no-undo .
     5168       define variable v-b-code         like ub.bar-code.b-code no-undo .
     5169       define variable v-old-value      as integer              no-undo .
     5170       define variable v-new-value      as integer              no-undo .
     5171       define variable lok              as logical              no-undo .
     5172       define buffer buf_code-range for ub.code-range .
     5173       define buffer buf_bar-code   for ub.bar-code .
     5174       find first buf_code-range no-lock
     5175         where buf_code-range.db-num     = p-db-num
     5176           and buf_code-range.range-type = v-curr-type-cdrg
     5177           and buf_code-range.stts       = "a":U
     5178         no-error .
     5179       if not available buf_code-range then do:
     5180         message
     5181           "Отсутствует активный диапазон" skip
     5182           "Невозможно установить значение sequence внутрь активного диапазона" skip
     5183           "База данных" p-db-num skip
     5184           view-as alert-box information .
     5185         return .
     5186       end.
     5187       else do:
     5188         run get-max-code ( input "get-m-code":U
     5189                           ,input buf_code-range.db-num
     5190                           ,input buf_code-range.range-type
     5191                           ,input buf_code-range.first-code
     5192                           ,input buf_code-range.last-code
     5193                           ,input TRUE
     5194                           ,output v-b-code
     5195                          ).
     5196         if v-b-code <= buf_code-range.last-code then do:
     5197           case v-curr-type-cdrg:
     5198             when 'bcgb':U then do:
     5199   assign
     5200     v-old-value = current-value(s-bcgb-code, ub)
     5201     v-new-value = max(buf_code-range.first-code, v-b-code)
     5202   .
     5203   if v-new-value = v-old-value then do:
     5204     message
     5205       "Значение sequence s-bcgb-code находится внутри активного диапазона" skip
     5206       "и не требует коррекции" skip
     5207       "Текущее значение" v-old-value skip
     5208       "Новое значение" v-new-value skip
     5209       view-as alert-box information .
     5210   end.
     5211   else do:
     5212     message
     5213       "Вы хотите откорректировать значение sequence s-bcgb-code?" skip
     5214       "Текущее значение" v-old-value skip
     5215       "Новое значение" v-new-value skip
     5216       view-as alert-box question buttons yes-no update lok .
     5217     if lok = true then do:
     5218       assign
     5219         current-value(s-bcgb-code, ub) = v-new-value
     5220       .
     5221     end.
     5222   end.
     5223             end.
     5224             when 'scgb':U then do:
     5225   assign
     5226     v-old-value = current-value(s-scgb-code, ub)
     5227     v-new-value = max(buf_code-range.first-code, v-b-code)
     5228   .
     5229   if v-new-value = v-old-value then do:
     5230     message
     5231       "Значение sequence s-scgb-code находится внутри активного диапазона" skip
     5232       "и не требует коррекции" skip
     5233       "Текущее значение" v-old-value skip
     5234       "Новое значение" v-new-value skip
     5235       view-as alert-box information .
     5236   end.
     5237   else do:
     5238     message
     5239       "Вы хотите откорректировать значение sequence s-scgb-code?" skip
     5240       "Текущее значение" v-old-value skip
     5241       "Новое значение" v-new-value skip
     5242       view-as alert-box question buttons yes-no update lok .
     5243     if lok = true then do:
     5244       assign
     5245         current-value(s-scgb-code, ub) = v-new-value
     5246       .
     5247     end.
     5248   end.
     5249             end.
     5250             when 'sclc':U then do:
     5251   assign
     5252     v-old-value = current-value(s-sclc-code, ub)
     5253     v-new-value = max(buf_code-range.first-code, v-b-code)
     5254   .
     5255   if v-new-value = v-old-value then do:
     5256     message
     5257       "Значение sequence s-sclc-code находится внутри активного диапазона" skip
     5258       "и не требует коррекции" skip
     5259       "Текущее значение" v-old-value skip
     5260       "Новое значение" v-new-value skip
     5261       view-as alert-box information .
     5262   end.
     5263   else do:
     5264     message
     5265       "Вы хотите откорректировать значение sequence s-sclc-code?" skip
     5266       "Текущее значение" v-old-value skip
     5267       "Новое значение" v-new-value skip
     5268       view-as alert-box question buttons yes-no update lok .
     5269     if lok = true then do:
     5270       assign
     5271         current-value(s-sclc-code, ub) = v-new-value
     5272       .
     5273     end.
     5274   end.
     5275             end.
     5276             when 'pglc':U then do:
     5277   assign
     5278     v-old-value = current-value(s-pglc-code, ub)
     5279     v-new-value = max(buf_code-range.first-code, v-b-code)
     5280   .
     5281   if v-new-value = v-old-value then do:
     5282     message
     5283       "Значение sequence s-pglc-code находится внутри активного диапазона" skip
     5284       "и не требует коррекции" skip
     5285       "Текущее значение" v-old-value skip
     5286       "Новое значение" v-new-value skip
     5287       view-as alert-box information .
     5288   end.
     5289   else do:
     5290     message
     5291       "Вы хотите откорректировать значение sequence s-pglc-code?" skip
     5292       "Текущее значение" v-old-value skip
     5293       "Новое значение" v-new-value skip
     5294       view-as alert-box question buttons yes-no update lok .
     5295     if lok = true then do:
     5296       assign
     5297         current-value(s-pglc-code, ub) = v-new-value
     5298       .
     5299     end.
     5300   end.
     5301             end.
     5302             when 'drgb':U then do:
     5303   assign
     5304     v-old-value = current-value(s-drgb-code, ub)
     5305     v-new-value = max(buf_code-range.first-code, v-b-code)
     5306   .
     5307   if v-new-value = v-old-value then do:
     5308     message
     5309       "Значение sequence s-drgb-code находится внутри активного диапазона" skip
     5310       "и не требует коррекции" skip
     5311       "Текущее значение" v-old-value skip
     5312       "Новое значение" v-new-value skip
     5313       view-as alert-box information .
     5314   end.
     5315   else do:
     5316     message
     5317       "Вы хотите откорректировать значение sequence s-drgb-code?" skip
     5318       "Текущее значение" v-old-value skip
     5319       "Новое значение" v-new-value skip
     5320       view-as alert-box question buttons yes-no update lok .
