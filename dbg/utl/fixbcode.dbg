     3356   ON VALUE-CHANGED OF BROWSE-1 IN FRAME D-Dialog
     3357   DO:
     3358     run display-dependent-info in this-procedure .
     3359   END.
     3360   ON VALUE-CHANGED OF sel-type-code-range IN FRAME D-Dialog
     3361   DO:
     3362     assign sel-type-code-range .
     3363     if mode-erprn
     3364        and can-do("bcgb,fmgb,pngb,fdgb,ctgb,drgb,sclc,sslc,pglc,cagb",sel-type-code-range)
     3365     then do:
     3366        if sel-type-code-range = 'cagb':U then
     3367        enable
     3368        b-active
     3369        b-gen-free
     3370        b-f-u
     3371        b-coderg
     3372        with frame D-Dialog .
     3373        else
     3374        disable
     3375        b-active
     3376        b-gen-free
     3377        b-f-u
     3378        b-coderg
     3379        with frame D-Dialog .
     3380     end.
     3381     else
     3382        assign
     3383           b-active:SENSITIVE = yes
     3384           b-gen-free:SENSITIVE = yes
     3385           b-f-u:SENSITIVE = yes
     3386           b-coderg:SENSITIVE = yes
     3387        .
     3388     assign
     3389     v-curr-type-cdrg = sel-type-code-range .
     3390     run fill-temp-b-code-info .
     3391     run reopen-query in this-procedure .
     3392   END.
     3393   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3394   on help of frame D-Dialog
     3395   do:
     3396     run gbl/app_help.p
     3397       (input this-procedure :file-name
     3398       ,input ''
     3399       ,input ?
     3400       ) no-error.
     3401     if error-status :error then do:
     3402       message
     3403         "Ошибка при вызове помощи"
     3404         error-status :get-message(1)
     3405         view-as alert-box .
     3406     end.
     3407   end.
     3408   run minbtn-set in this-procedure .
     3409   on choose of b-help in frame D-Dialog
     3410   do:
     3411     apply "help":u to frame D-Dialog .
     3412   end.
     3413   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3414   procedure minbtn-set :
     3415       do
     3416           on error undo, return error return-value
     3417           :
     3418           define variable ii              as integer       no-undo .
     3419           define variable fh              as widget-handle no-undo .
     3420           define variable hh              as widget-handle no-undo .
     3421           define variable v-h             as handle        extent 4 no-undo .
     3422           define variable v-name-button   as character     no-undo .
     3423           define variable v-help-old-x    as decimal       no-undo .
     3424           define variable v-help-old-y    as decimal       no-undo .
     3425           define variable v-help-old-size as decimal       no-undo .
     3426           define variable v-frame-width   as decimal       no-undo .
     3427           define variable jj              as integer       no-undo .
     3428           do
     3429               on error undo, return error
     3430               :
     3431               assign
     3432                   v-frame-width = frame D-Dialog:width - 0.3
     3433                   fh            = frame D-Dialog:first-child
     3434                   hh            = fh:first-child
     3435                   ii            = 1
     3436                   .
     3437               do while valid-handle(hh):
     3438                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3439                   do:
     3440                       case lc(hh:name) :
     3441                           when "b-help" then
     3442                               do:
     3443                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3444                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3445                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3446                                   hh:TOOLTIP = "Помощь" .
     3447                                   v-help-old-x = hh:column .
     3448                                   v-help-old-y = hh:row    .
     3449                                   v-help-old-size = hh:width .
     3450                                   hh:width-chars = 2.5 .
     3451                               end.
     3452                           when "b-print" then
     3453                               do:
     3454                                   hh:load-image("cmp/b-print.bmp":u) .
     3455                                   hh:TOOLTIP = "Печать" .
     3456                                   v-h[ii] = hh:handle .
     3457                                   ii = ii + 1 .
     3458                                   hh:width-chars = 3 .
     3459                               end.
     3460                           when "b-history" or
     3461                           when "b-hist" then
     3462                               do:
     3463                                   hh:load-image("cmp/b-hist.bmp":u) .
     3464                                   hh:TOOLTIP = "История" .
     3465                                   v-h[ii] = hh:handle .
     3466                                   ii = ii + 1 .
     3467                                   hh:width-chars = 3 .
     3468                               end.
     3469                           when "b-sch" then
     3470                               do:
     3471                                   hh:load-image("cmp/b-sch.bmp":u) .
     3472                                   hh:TOOLTIP = "Установка Фильтра" .
     3473                                   v-h[ii] = hh:handle .
     3474                                   ii = ii + 1 .
     3475                                   hh:width-chars = 3 .
     3476                               end.
     3477                           when "b-hist-user" then
     3478                               do:
     3479                                   hh:load-image("cmp/b-hist.bmp":u) .
     3480                                   hh:TOOLTIP = "История пользователя" .
     3481                                   ii = ii + 1 .
     3482                               end.
     3483                       end case.
     3484                   end.
     3485                   hh = hh:next-sibling.
     3486               end.
     3487               b-help:column = v-frame-width - b-help:width-chars.
     3488               jj = 0.
     3489               repeat ii = 4 to 1 by -1 :
     3490                   if valid-handle (v-h[ii] ) then
     3491                   do:
     3492                       jj  = jj + 1 .
     3493                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3494                       v-h[ii]:row    = v-help-old-y .
     3495                   end.
     3496               end.
     3497           end.
     3498       end.
     3499   end procedure.
     3500   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3501   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3502   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3503   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3504   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3505   define variable v-diasize-current-frame-height as decimal   no-undo .
     3506   define variable v-diasize-change-size          as logical   no-undo .
     3507   define variable v-diasize-resize-button        as handle    no-undo .
     3508   define variable v-diasize-wndmax               as logical   no-undo .
     3509   define variable v-diasize-wndstore             as logical   no-undo .
     3510   define variable v-diasize-proc-name            as character no-undo .
     3511   define variable v-diasize-browse-handle        as handle    no-undo .
     3512   define variable v-diasize-browse-number        as integer   no-undo .
     3513   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3514   define temp-table temp-diasize-handle no-undo
     3515     field handle-value  as handle
     3516     field save-position as decimal
     3517     index xpk is primary unique handle-value
     3518     .
     3519   define temp-table temp-browse-handle no-undo
     3520     field browse-type   as character
     3521     field browse-number as integer
     3522     field browse-handle as handle
     3523     field original-size as decimal
     3524     index xpk is primary unique browse-type browse-number
     3525     index xie browse-type browse-handle
     3526   .
     3527   procedure diasize_change-height :
     3528     define input  parameter p-change-value  as decimal   no-undo .
     3529     define input  parameter p-move-resize   as logical   no-undo .
     3530     define variable v-field-group-handle    as handle    no-undo .
     3531     define variable v-object-handle         as handle    no-undo .
     3532     define variable v-frame-height          as decimal   no-undo .
     3533     define variable v-frame-virtual-height  as decimal   no-undo .
     3534     define variable v-browse-height         as decimal   no-undo .
     3535     define variable v-window-height         as decimal   no-undo .
     3536     define variable v-window-virtual-height as decimal   no-undo .
     3537     define variable v-change-sign           as integer   no-undo .
     3538     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3539     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3540     if p-change-value > 0
     3541     then do:
     3542       if frame D-Dialog :height + p-change-value
     3543           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3544       then do:
     3545         assign
     3546           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3547                           - (frame D-Dialog :height-chars)
     3548         .
     3549         if p-change-value <= 0
     3550         then do:
     3551           run diasize_position-resize-button in this-procedure .
     3552           return .
     3553         end.
     3554       end.
     3555     end.
     3556     if p-change-value < 0
     3557     then do:
     3558       if frame D-Dialog :height + p-change-value < v-diasize-orig-frame-height
     3559       then do:
     3560         assign
     3561           p-change-value = v-diasize-orig-frame-height
     3562                          - (frame D-Dialog :height-chars)
     3563         .
     3564         if p-change-value >= 0
     3565         then do:
     3566           run diasize_position-resize-button in this-procedure .
     3567           return .
     3568         end.
     3569       end.
     3570     end.
     3571     if p-change-value >= 0
     3572     then do:
     3573       assign
     3574         v-change-sign = 1
     3575       .
     3576     end.
     3577     else do:
     3578       assign
     3579         v-change-sign = -1
     3580       .
     3581     end.
     3582     assign
     3583       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3584     .
     3585     if p-change-value = 0
     3586     then do:
     3587       run diasize_position-resize-button in this-procedure .
     3588       return .
     3589     end.
     3590     move_block:
     3591     do
     3592     on error undo move_block, retry move_block
     3593     :
     3594       if retry
     3595       then do:
     3596         do
     3597         on error undo move_block, leave move_block
     3598         :
     3599           if p-change-value > 0
     3600           then do:
     3601             for each buf_temp-diasize-handle
     3602             on error undo, next
     3603             :
     3604               assign
     3605                 v-object-handle = buf_temp-diasize-handle.handle-value
     3606               .
     3607               if v-object-handle <> v-diasize-resize-button
     3608               then do:
     3609                 assign
     3610                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3611                 .
     3612               end.
     3613             end.
     3614             assign
     3615               v-diasize-browse-handle :height = v-browse-height
     3616             .
     3617             for each buf_temp-browse-handle
     3618               where buf_temp-browse-handle.browse-type = 'height':u
     3619             on error undo, next
     3620             :
     3621               assign
     3622                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3623               .
     3624             end.
     3625             assign
     3626               frame D-Dialog :height = v-frame-height
     3627             .
     3628             if frame D-Dialog :scrollable = true
     3629             then do:
     3630               assign
     3631                 frame D-Dialog :virtual-height = v-frame-virtual-height
     3632               .
     3633             end.
     3634             run diasize_position-resize-button in this-procedure .
     3635           end.
     3636           else do:
     3637             if frame D-Dialog :scrollable = true
     3638             then do:
     3639               assign
     3640                 frame D-Dialog :virtual-height = v-frame-virtual-height
