     3909         (input  (p-new-height - frame D-Dialog :height)
     3910         ,input  p-move-resize
     3911         ) .
     3912     end.
     3913   end procedure.
     3914   procedure diasize_change-width :
     3915     define input  parameter p-change-value as decimal   no-undo .
     3916     define input  parameter p-move-resize  as logical   no-undo .
