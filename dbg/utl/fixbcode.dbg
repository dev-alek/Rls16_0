     5488   END PROCEDURE.
     5489   PROCEDURE reopen-query :
     5490     do
     5491     on error undo, return error
     5492     :
     5493       define buffer buf_temp-b-code-info for temp-b-code-info .
     5494       define variable v-reposition-db-num like ub.db.db-num no-undo .
     5495       if available temp-b-code-info then do:
     5496         assign
     5497           v-reposition-db-num = temp-b-code-info.db-num
     5498         .
     5499       end.
     5500       run fill-temp-b-code-info in this-procedure .
     5501       OPEN QUERY BROWSE-1 FOR EACH temp-b-code-info .
     5502       if v-reposition-db-num <> 0 then do:
     5503         find first buf_temp-b-code-info
     5504           where buf_temp-b-code-info.db-num = v-reposition-db-num
     5505           no-error .
     5506         if available buf_temp-b-code-info then do:
     5507           reposition BROWSE-1 to rowid rowid(buf_temp-b-code-info) no-error .
     5508         end.
     5509       end.
     5510       run display-dependent-info in this-procedure .
     5511     end.
     5512   END PROCEDURE.
     5513   PROCEDURE send-records :
     5514     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     5515     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     5516     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     5517     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     5518     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     5519     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     5520         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     5521         CASE ENTRY(i, p-tbl-list):
     5522       WHEN "temp-b-code-info":U THEN p-rowid-list = p-rowid-list +
     5523           IF AVAILABLE temp-b-code-info THEN STRING(ROWID(temp-b-code-info))
     5524           ELSE "?":U.
     5525           OTHERWISE
     5526           DO:
     5527               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     5528                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     5529               IF link-handle NE "":U THEN
     5530               DO:
     5531                   IF NUM-ENTRIES(link-handle) > 1 THEN
     5532                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     5533                               "encountered more than one RECORD-SOURCE.":U SKIP
     5534                               "The first will be used.":U
     5535                               VIEW-AS ALERT-BOX ERROR.
     5536                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     5537                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     5538                   p-rowid-list = p-rowid-list + rowid-string.
     5539               END.
     5540               ELSE
     5541               DO:
     5542                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     5543                           "does not match tables in send-records":U
     5544                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     5545                           "Check that objects are linked properly and that":U
     5546                           "database qualification is consistent.":U
     5547                       VIEW-AS ALERT-BOX ERROR.
     5548                   RETURN ERROR.
     5549               END.
     5550           END.
     5551           END CASE.
     5552       END.
     5553   END PROCEDURE.
     5554   PROCEDURE state-changed :
     5555     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     5556     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     5557   END PROCEDURE.
