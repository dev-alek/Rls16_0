     3259       run utl/v-coderg.w ( input v-db-num
     3260                      ,input v-curr-type-cdrg
     3261                      ,input sel-type-code-range
     3262                     ).
     3263       run reopen-query in this-procedure .
     3264     end.
     3265   END.
     3266   ON CHOOSE OF b-f-u IN FRAME D-Dialog
     3267   DO:
     3268   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3269   if lookup(self :type
     3270            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3271            ) = 0
     3272   then do:
     3273     message
     3274       "$Workfile$"
     3275       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3276       "Интерфейсный элемент" self :name  skip
     3277       "Тип" self :type  skip
     3278       "Процедура" this-procedure :file-name skip
     3279       view-as alert-box .
     3280   end.
     3281   else do:
     3282     apply "entry":u to self  .
     3283     if focus :handle <> self :handle  then do:
     3284       return no-apply .
     3285     end.
     3286   end.
     3287     define variable v-b-code         like ub.bar-code.b-code no-undo .
     3288     if available temp-b-code-info then do:
     3289       if v-curr-type-cdrg = 'sslc':U
     3290       or v-curr-type-cdrg = 'ssgb':U
     3291       then do:
     3292         message
     3293           "Помечать свободный диапазон как использованный" skip
     3294           "для диапазона взвешиваемых кодов нельзя." skip
     3295           view-as alert-box information .
     3296         return no-apply.
     3297       end.
     3298       if temp-b-code-info.db-num <> v-curr-db-num
     3299         and v-curr-type-cdrg <> 'sclc':U
     3300         and v-curr-type-cdrg <> 'pglc':U
     3301       then do:
     3302         message
     3303           "Помечать свободный диапазон как использованный," skip
     3304           "если есть хоть один код внутри этого диапазона," skip
     3305           "можно только для текущей базы данных" skip
     3306           "Текущая база данных" v-curr-db-num skip
     3307           "Выбрана база данных" temp-b-code-info.db-num skip
     3308           view-as alert-box information .
     3309         return no-apply.
     3310       end.
     3311       run get-max-code in this-procedure
     3312         ( input "f-u":U
     3313          ,input v-curr-db-num
     3314          ,input v-curr-type-cdrg
     3315          ,input ?
     3316          ,input ?
     3317          ,input TRUE
     3318          ,output v-b-code
     3319         ).
     3320       message
     3321         "Просмотр окончен." skip
     3322         "Исправлено статусов диапазонов" v-b-code
     3323         view-as alert-box information
     3324       .
     3325       run reopen-query in this-procedure .
     3326     end.
     3327   END.
