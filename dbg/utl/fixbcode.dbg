     3925     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3926     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3927     if p-change-value > 0
     3928     then do:
     3929       if frame D-Dialog :width + p-change-value >
     3930           session :width-chars
     3931       then do:
     3932         assign
     3933           p-change-value = session :width-chars - frame D-Dialog :width
     3934         .
     3935         if p-change-value <= 0
     3936         then do:
     3937           run diasize_position-resize-button in this-procedure .
     3938           return .
     3939         end.
     3940       end.
     3941     end.
     3942     if p-change-value < 0
     3943     then do:
     3944       if frame D-Dialog :width + p-change-value < v-diasize-orig-frame-width
     3945       then do:
     3946         assign
     3947           p-change-value = v-diasize-orig-frame-width
     3948                          - frame D-Dialog :width
     3949         .
     3950         if p-change-value >= 0
     3951         then do:
     3952           run diasize_position-resize-button in this-procedure .
     3953           return .
     3954         end.
     3955       end.
     3956     end.
     3957     if p-change-value >= 0
     3958     then do:
     3959       assign
     3960         v-change-sign = 1
     3961       .
     3962     end.
     3963     else do:
     3964       assign
     3965         v-change-sign = -1
     3966       .
     3967     end.
     3968     assign
     3969       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3970     .
     3971     if p-change-value = 0
     3972     then do:
     3973       run diasize_position-resize-button in this-procedure .
     3974       return .
     3975     end.
