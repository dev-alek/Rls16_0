        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Просмотр и изменение диапазонов кодов".
        8   define variable conf-par as character no-undo.
        9   define variable mode-erprn as logical no-undo.
       10   define variable par-type as character no-undo.
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define new global shared variable g#language as character no-undo .
      111   if g#language <> '' and g#language <> 'rus':U then do:
      112     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      113   end.
      114   define new global shared variable g#library  as handle no-undo .
      115   define new global shared variable g#library2 as handle no-undo .
      116   define   shared variable g#auto as logical no-undo.
      117   define   shared variable g#news as logical no-undo.
      118   define   shared variable g#oxml as logical no-undo.
      119   define   shared variable g#esys as logical no-undo.
      120   define   shared variable g#news-source-db as integer no-undo.
      121   define   shared variable g#esys-source-esys as integer no-undo.
      122   define   shared variable g#db-num as integer   no-undo .
      123   define   shared variable g#userid as character no-undo .
      124   define   shared variable g#passwd as character no-undo .
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   procedure gen-b-code :
      127     define input  parameter type-code like ub.code-range.range-type no-undo .
      128     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      129     do
      130     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      131     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      132     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      133     :
      134       define buffer buf_thbj-attr     for ub.thbj-attr .
      135       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      136       define buffer buf_code-range for ub.code-range .
      137       define variable l-code         as   integer              no-undo .
      138       define variable v-db-num       like ub.db.db-num         no-undo .
      139       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      140       if type-code = 'sslc':U
      141       or type-code = 'ssgb':U
      142       then do:
      143         message
      144           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      145           "Обратитесь к администратору системы."
      146           view-as alert-box error .
      147         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      148       end.
      149       run trg/getpcode.p ( input  type-code
      150                      ,output cfg-param-code
      151                     ).
      152       run get-next-seq( input  type-code,
      153                         output l-code
      154                       ).
      155       find first buf_sys-ctrl no-lock.
      156       if type-code = 'sclc':U
      157       or type-code = 'pglc':U
      158       then do:
      159         assign
      160           v-db-num = 0
      161         .
      162       end.
      163       else do:
      164         assign
      165           v-db-num = buf_sys-ctrl.db-num
      166         .
      167       end.
      168       find first buf_code-range no-lock
      169         where buf_code-range.db-num     = v-db-num
      170           and buf_code-range.range-type = type-code
      171           and buf_code-range.stts       = "a"
      172         use-index stts
      173         no-error .
      174       if available buf_code-range
      175          and l-code <= buf_code-range.last-code
      176          and l-code >= buf_code-range.first-code then do:
      177         assign
      178           p-b-code = l-code
      179         .
      180       end.
      181       else do:
      182         if available buf_code-range
      183            and l-code < buf_code-range.last-code then do:
      184           message
      185             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      186             "Обратитесь к администратору системы."
      187             view-as alert-box error .
      188           undo, return error "sequence":U .
      189         end.
      190         do transaction
      191         on error undo, return error
      192         :
      193           find first buf_thbj-attr exclusive-lock
      194             where buf_thbj-attr.upper-prop-code = 'code-range':U
      195               and buf_thbj-attr.prop-code = cfg-param-code
      196               and buf_thbj-attr.obj-type   = 'БД':U
      197               and buf_thbj-attr.obj-code   = v-db-num
      198             no-error .
      199           if not available buf_thbj-attr then do:
      200             find first buf_thbj-attr exclusive-lock
      201               where buf_thbj-attr.upper-prop-code = 'code-range':U
      202                 and buf_thbj-attr.prop-code = cfg-param-code
      203                 and buf_thbj-attr.obj-type   = ''
      204                 and buf_thbj-attr.obj-code   = 0
      205               no-error .
      206             if not available buf_thbj-attr then do:
      207               if not locked buf_thbj-attr then do:
      208                 message
      209                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      210                   "Обратитесь к администратору системы."
      211                   view-as alert-box error .
      212               end.
      213               undo, return error "config":U .
      214             end.
      215           end.
      216           run get-next-seq( input type-code,
      217                             output l-code
      218                           ).
      219           find first buf_code-range
      220             where buf_code-range.db-num     = v-db-num
      221               and buf_code-range.range-type = type-code
      222               and buf_code-range.stts       = "a"
      223             use-index stts
      224             no-error .
      225           if available buf_code-range
      226           and l-code <= buf_code-range.last-code
      227           and l-code >= buf_code-range.first-code
      228           then do:
      229             assign
      230               p-b-code = l-code
      231             .
      232           end.
      233           else do:
      234             if available buf_code-range then do:
      235               assign
      236                 buf_code-range.stts = "u"
      237               .
      238             end.
      239             find first buf_code-range
      240               where buf_code-range.db-num     = v-db-num
      241                 and buf_code-range.range-type = type-code
      242                 and buf_code-range.stts       = "f"
      243               use-index stts
      244               no-error .
      245             if not available buf_code-range then do:
      246               message
      247                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      248                 "Обратитесь к администратору системы"
      249                 view-as alert-box error .
      250               undo, return error "code-range":U .
      251             end.
      252             assign
      253               buf_code-range.stts           = "a"
      254             .
      255             if buf_code-range.first-code = 1 then do:
      256               run set-seq-cr( input type-code,
      257                               input buf_code-range.first-code
      258                             ).
      259               assign
      260                 p-b-code = 1
      261               .
      262             end.
      263             else do:
      264               run set-seq-cr( input type-code,
      265                               input ( buf_code-range.first-code - 1 )
      266                             ).
      267               run get-next-seq( input type-code,
      268                                 output p-b-code
      269                               ).
      270             end.
      271           end.
      272         end.
      273       end.
      274     end.
      275   end procedure.
      276   procedure get-next-seq :
      277     define input  parameter type-code like ub.code-range.range-type no-undo .
      278     define output parameter next-seq  as   integer                  no-undo .
      279     do
      280     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      281     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      282     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      283     :
      284       case type-code:
      285         when 'bcgb':U then do:
      286           assign
      287             next-seq = next-value(s-bcgb-code, ub)
      288           .
      289         end.
      290         when 'scgb':U then do:
      291           assign
      292             next-seq = next-value(s-scgb-code, ub)
      293           .
      294         end.
      295         when 'sclc':U then do:
      296           assign
      297             next-seq = next-value(s-sclc-code, ub)
      298           .
      299         end.
      300         when 'pglc':U then do:
      301           assign
      302             next-seq = next-value(s-pglc-code, ub)
      303           .
      304         end.
      305         when 'dcgb':U then do:
      306           assign
      307             next-seq = next-value(s-dcgb-code, ub)
      308           .
      309         end.
      310         when 'ctgb':U then do:
      311           assign
      312             next-seq = next-value(s-ctgb-code, ub)
      313           .
      314         end.
      315         when 'drgb':U then do:
      316           assign
      317             next-seq = next-value(s-drgb-code, ub)
      318           .
      319         end.
      320         when 'fmgb':U then do:
      321           assign
      322             next-seq = next-value(s-fmgb-code, ub)
      323           .
      324         end.
      325         when 'pngb':U then do:
      326           assign
      327             next-seq = next-value(s-pngb-code, ub)
      328           .
      329         end.
      330         when 'cagb':U then do:
      331           assign
      332             next-seq = next-value(s-cagb-code, ub)
      333           .
      334         end.
      335         when 'fdgb':U then do:
      336           assign
      337             next-seq = next-value(s-fin-doc, ub)
      338           .
      339         end.
      340       end case.
      341     end.
      342   end procedure.
      343   procedure set-seq-cr :
      344     define input parameter type-code like ub.code-range.range-type no-undo .
      345     define input parameter set-val   like ub.code-range.first-code no-undo .
      346     do
      347     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      348     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      349     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      350     :
      351       case type-code:
      352         when 'bcgb':U then do:
      353           assign
      354             current-value(s-bcgb-code, ub) = set-val
      355           .
      356         end.
      357         when 'scgb':U then do:
      358           assign
      359             current-value(s-scgb-code, ub) = set-val
      360           .
      361         end.
      362         when 'sclc':U then do:
      363           assign
      364             current-value(s-sclc-code, ub) = set-val
      365           .
      366         end.
      367         when 'pglc':U then do:
      368           assign
      369             current-value(s-pglc-code, ub) = set-val
      370           .
      371         end.
      372         when 'dcgb':U then do:
      373           assign
      374             current-value(s-dcgb-code, ub) = set-val
      375           .
      376         end.
      377         when 'ctgb':U then do:
      378           assign
      379             current-value(s-ctgb-code, ub) = set-val
      380           .
      381         end.
      382         when 'drgb':U then do:
      383           assign
      384             current-value(s-drgb-code, ub) = set-val
      385           .
      386         end.
      387         when 'fmgb':U then do:
      388           assign
      389             current-value(s-fmgb-code, ub) = set-val
      390           .
      391         end.
      392         when 'pngb':U then do:
      393           assign
      394             current-value(s-pngb-code, ub) = set-val
      395           .
      396         end.
      397         when 'cagb':U then do:
      398           assign
      399             current-value(s-cagb-code, ub) = set-val
      400           .
      401         end.
      402         when 'fdgb':U then do:
      403           assign
      404             current-value(s-fin-doc, ub) = set-val
      405           .
      406         end.
      407       end case.
      408     end.
      409   end procedure.
      410   procedure new-bcod-gen-code-range :
      411     do
      412     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      413     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      414     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      415     :
      416       define input parameter p-db-num  like ub.db.db-num             no-undo .
      417       define input parameter type-code like ub.code-range.range-type no-undo .
      418       define buffer buf_code-range      for ub.code-range .
      419       define buffer last_code-range     for ub.code-range .
      420       define buffer last-1_code-range   for ub.code-range .
      421       define buffer last-2_code-range   for ub.code-range .
      422       define buffer last-3_code-range   for ub.code-range .
      423       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      424       define variable conf-par       as character no-undo .
      425       define variable par-type       as character no-undo .
      426       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      427       define variable v-cre-cdrg as logical   no-undo .
      428       define variable v-cre-str  as character no-undo .
      429       define variable v-cr1      as integer no-undo .
      430       define variable v-cr2      as integer no-undo .
      431       define variable v-cr3      as integer no-undo .
      432       define variable v-cmax     as integer no-undo .
      433       find first buf_sys-ctrl no-lock .
      434       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      435         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      436                                       ,vss-workfile
      437                                       ,vss-revision
      438                                       ,vss-description
      439                                       ,chr(10)
      440                                       , p-db-num
      441                                      ).
      442       end.
      443       run trg/getpcode.p ( input  type-code
      444                      ,output cfg-param-code
      445                     ).
      446       for each buf_code-range
      447         where buf_code-range.db-num     = -1
      448           and buf_code-range.range-type = type-code
      449           and buf_code-range.stts       = "f"
      450       by buf_code-range.first-code
      451       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      452       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      453       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      454       :
      455         assign
      456           buf_code-range.db-num = p-db-num
      457         .
      458         return .
      459       end.
      460       assign
      461         v-cre-cdrg = TRUE
      462       .
      463       case type-code:
      464         when 'sclc':U
      465         or when 'scgb':U
      466         or when 'pglc':U
      467         then do:
      468           find last last-1_code-range no-lock
      469             where last-1_code-range.range-type = 'sclc':U
      470             no-error .
      471           if available last-1_code-range then do:
      472             v-cr1 = last-1_code-range.last-code.
      473           end.
      474           find last last-2_code-range no-lock
      475             where last-2_code-range.range-type = 'scgb':U
      476             no-error .
      477           if available last-2_code-range then do:
      478             v-cr2 = last-2_code-range.last-code.
      479             end.
      480           find last last-3_code-range no-lock
      481             where last-3_code-range.range-type = 'pglc':U
      482             no-error .
      483           if available last-3_code-range then do:
      484             v-cr3 = last-3_code-range.last-code.
      485           end.
      486           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      487           .
      488           if v-cmax = v-cr1  then do:
      489               find last last_code-range no-lock
      490                 where recid( last_code-range ) = recid( last-1_code-range )
      491                 .
      492             end.
      493           if v-cmax = v-cr2  then do:
      494               find last last_code-range no-lock
      495                 where recid( last_code-range ) = recid( last-2_code-range )
      496                 .
      497             end.
      498           if v-cmax = v-cr3  then do:
      499             find last last_code-range no-lock
      500               where recid( last_code-range ) = recid( last-3_code-range )
      501               .
      502           end.
      503           if last_code-range.last-code + 1 > 99999 then do:
      504             assign
      505               v-cre-cdrg = FALSE
      506             .
      507           end.
      508         end.
      509         when 'bcgb':U
      510         or when 'sslc':U
      511         or when 'ssgb':U
      512         then do:
      513           find last last-1_code-range no-lock
      514             where last-1_code-range.range-type = 'sslc':U
      515             no-error .
      516           if available last-1_code-range then do:
      517             v-cr1 = last-1_code-range.last-code.
      518           end.
      519           find last last-2_code-range no-lock
      520             where last-2_code-range.range-type = 'bcgb':U
      521             no-error .
      522           if available last-2_code-range then do:
      523             v-cr2 = last-2_code-range.last-code.
      524             end.
      525           find last last-3_code-range no-lock
      526             where last-3_code-range.range-type = 'ssgb':U
      527             no-error .
      528           if available last-3_code-range then do:
      529             v-cr3 = last-3_code-range.last-code.
      530           end.
      531           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      532           .
      533           if v-cmax = v-cr1  then do:
      534               find last last_code-range no-lock
      535                 where recid( last_code-range ) = recid( last-1_code-range )
      536                 .
      537             end.
      538           if v-cmax = v-cr2  then do:
      539               find last last_code-range no-lock
      540                 where recid( last_code-range ) = recid( last-2_code-range )
      541                 .
      542             end.
      543           if v-cmax = v-cr3  then do:
      544             find last last_code-range no-lock
      545               where recid( last_code-range ) = recid( last-3_code-range )
      546               .
      547           end.
      548         end.
      549         otherwise do:
      550           find last last_code-range no-lock
      551             where last_code-range.range-type = type-code
      552             no-error .
      553         end.
      554       end case.
      555       if not available last_code-range then do:
      556         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      557                                       ,vss-workfile
      558                                       ,vss-revision
      559                                       ,vss-description
      560                                       , chr(10)
      561                                       , type-code
      562                                      ) .
      563       end.
      564       define variable v-mes0 as character no-undo .
      565       define variable v-param-type0 as character no-undo .
      566       define variable v-value-character0 as INTEGER no-undo .
      567       define variable v-value-date0 as date no-undo .
      568       define variable v-value-decimal0 as decimal no-undo .
      569       define variable v-value-integer0 AS integer no-undo .
      570       define variable v-value-logical0 AS LOGICAL no-undo .
      571       define variable v-tth0 as handle no-undo .
      572       run adm/shattri.p (
      573           input "get":U
      574           ,input  'БД':U
      575           ,input  p-db-num
      576           ,input  'code-range':U
      577           ,input  cfg-param-code
      578           ,output v-value-character0
      579           ,output v-value-date0
      580           ,output v-value-decimal0
      581           ,output v-value-integer0
      582           ,output v-value-logical0
      583           ,output v-param-type0
      584           ,INPUT-OUTPUT table-handle v-tth0
      585           ) no-error .
      586       if error-status :error then do:
      587         delete object v-tth0.
      588         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      589                            , error-status:get-message(1)
      590                            , chr(10)
      591                            , return-value ).
      592         undo, return error v-mes0.
      593       end.
      594       delete object v-tth0.
      595       if v-cre-cdrg = TRUE then do:
      596         create buf_code-range .
      597         assign
      598           buf_code-range.db-num     = p-db-num
      599           buf_code-range.range-type = type-code
      600           buf_code-range.stts       = "f"
      601           buf_code-range.first-code = last_code-range.last-code + 1
      602           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      603           v-cre-str = "Свободный диапазон успешно создан"
      604         .
      605       end.
      606       else do:
      607         assign
      608           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      609                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      610         .
      611       end.
      612     end.
      613     return v-cre-str .
      614   end procedure.
      615   procedure gen-new-code-range-if-neces :
      616     define input parameter v-db-num           like ub.db.db-num             no-undo .
      617     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      618     define input parameter v-cur-code         as   integer                  no-undo .
      619     define input parameter v-g#news           as   logical                  no-undo .
      620     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      621     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      622     do
      623     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      624     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      625     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      626     :
      627       define variable l-code-range-exist as logical   no-undo init false .
      628       define variable v-db-for-send      as character no-undo .
      629       define buffer buf_code-range  for ub.code-range .
      630       define buffer buf1_code-range for ub.code-range .
      631       define buffer buf_db          for ub.db .
      632       find first buf_code-range
      633         where buf_code-range.range-type = v-range-type
      634           and buf_code-range.last-code >= v-cur-code
      635         use-index last-codei
      636         no-error .
      637       if
      638       (
      639          available buf_code-range
      640          and
      641         (buf_code-range.db-num = v-db-num
      642           and
      643         buf_code-range.first-code <= v-cur-code
      644         )
      645       or
      646         (
      647           v-range-type = 'drgb':U
      648           AND
      649           v-cur-code = 0
      650         )
      651      )
      652      then do:
      653         assign
      654           l-code-range-exist = true
      655         .
      656         if v-g#news
      657         and buf_code-range.stts = "f" then do:
      658           assign
      659             buf_code-range.stts = "u"
      660           .
      661         end.
      662       end.
      663       if not l-code-range-exist
      664          and v-g#news-source-db <> 0
      665       then do:
      666         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      667                                       ,vss-workfile
      668                                       ,vss-revision
      669                                       ,vss-description
      670                                       ,chr(10)
      671                                       ,v-db-num
      672                                       ,v-range-type
      673                                       ,v-cur-code
      674                                      ).
      675       end.
      676       if (not l-code-range-exist
      677           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      678          )
      679       and ( not can-find (first buf1_code-range no-lock
      680                           where buf1_code-range.db-num = v-db-num
      681                             and buf1_code-range.range-type = v-range-type
      682                             and buf1_code-range.stts = "f"
      683                          )
      684           )
      685       then do:
      686         if v-g#db-num = 0 then do:
      687           run new-bcod-gen-code-range in this-procedure
      688             (input v-db-num,
      689              input v-range-type
      690             ) no-error .
      691           if error-status :error then do:
      692             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      693                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      694                                           ,v-db-num
      695                                           ,v-range-type
      696                                           ,v-cur-code
      697                                           ,chr(10)
      698                                           ,error-status:get-message(1)
      699                                           ,return-value
      700                                          ).
      701           end.
      702         end.
      703         else do:
      704           if v-range-type = 'sclc':U
      705           or v-range-type = 'pglc':U
      706           then do:
      707             assign
      708               v-db-for-send = "":U
      709             .
      710             if v-g#db-num = 0 then do:
      711               for each buf_db no-lock
      712                 where buf_db.db-num > 0
      713                   and buf_db.db-num <> v-g#news-source-db
      714               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      715               :
      716                 assign
      717                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      718                 .
      719               end.
      720               assign
      721                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      722               .
      723             end.
      724             else do:
      725               if not v-g#news then do:
      726                 assign
      727                   v-db-for-send = "0":U
      728                 .
      729               end.
      730             end.
      731             run nws/cr-route.p ( input 'send-cmd':U
      732                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      733                                  "code-range":U + chr(1) +
      734                                  (if v-range-type = 'sclc':U
      735                                   then string( current-value(s-sclc-code, ub))
      736                                   else string( current-value(s-pglc-code, ub))
      737                                   ) + chr(1) +
      738                                   v-range-type)
      739                           ,input ?
      740                           ,input v-db-for-send
      741                           ) no-error .
      742             if error-status :error then do:
      743               undo, return error return-value.
      744             end.
      745           end.
      746         end.
      747       end.
      748     end.
      749   end procedure.
      750   procedure cre-loc-sc-code-range :
      751     define input parameter v-cur-code as integer no-undo .
      752   define input parameter p-cdrg-type as character no-undo .
      753     do
      754     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      755     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      756     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      757     :
      758       define buffer buf_code-range for ub.code-range .
      759       find first buf_code-range
      760            where buf_code-range.range-type = p-cdrg-type
      761              and buf_code-range.first-code >= v-cur-code
      762            no-error .
      763       if not available buf_code-range then do:
      764         run new-bcod-gen-code-range in this-procedure
      765           ( input 0,
      766             input p-cdrg-type
      767           ) no-error .
      768         if error-status :error then do:
      769           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      770                                          + "Код &2&1&3 &4"
      771                                         , chr(10)
      772                                         , v-cur-code
      773                                         , error-status:get-message(1)
      774                                         , return-value
      775                                        ) .
      776         end.
      777       end.
      778     end.
      779   end procedure.
      780   procedure mark-used-if-need :
      781   define input parameter p-cur-code as integer no-undo .
      782   define input parameter p-range-type like ub.code-range.range-type no-undo .
      783   define input parameter p-db-num like ub.code-range.db-num no-undo .
      784     do
      785     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      786     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      787     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      788     :
      789       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      790       define buffer buf_code-range for ub.code-range .
      791       assign
      792       v-db-num = if p-range-type = 'sclc':U
      793                  then 0
      794                  else p-db-num
      795       .
      796   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   define buffer locK-batchprocess1 for ub.batchprocess.
      798   run gbl/lock-prc.p
      799       (input 'lscc':U
      800       ,input 0
      801       ,input 0
      802       ,input 0
      803       ,input ""
      804       ,input ""
      805       ,input ""
      806       ,input (
      807               ",,,Вкл/выкл лок. вес. кодов"
      808              )
      809       ,input true
      810       ,buffer lock-batchprocess1
      811       ) no-error .
      812     if error-status :error then do:
      813       message
      814         vss-workfile vss-revision vss-description skip
      815         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      816         view-as alert-box error .
      817       undo, return error .
      818     end.
      819       find first buf_code-range
      820            where buf_code-range.range-type = p-range-type
      821              and buf_code-range.first-code >= p-cur-code
      822              and buf_code-range.last-code <= p-cur-code
      823              and buf_code-range.db-num = v-db-num
      824            no-error .
      825       if not available buf_code-range then do:
      826         message
      827           vss-workfile vss-revision vss-description skip
      828           "Ошибка при создании поиске диапазона" skip
      829           "База данных" p-db-num skip
      830           "Код" p-cur-code skip
      831           "Тип" p-range-type
      832           error-status :get-message(1) skip
      833           return-value skip
      834           view-as alert-box error .
      835         undo, return error .
      836       end.
      837       if buf_code-range.stts = "f":U then do:
      838         assign
      839         buf_code-range.stts = "u":U
      840         .
      841       end.
      842     end.
      843   end procedure.
      844   function diff-list returns character (
      845     input parfirst-list  as character,
      846     input parsecond-list as character,
      847     input pardelim       as character).
      848     if pardelim = ""
      849     or pardelim = ?
      850     then do:
      851       assign
      852         pardelim = ","
      853       .
      854     end.
      855     def var ind as integer no-undo .
      856     def var v-elem as character no-undo .
      857     def var v-result-list as character no-undo init "".
      858     def var v-num-parfirst-list as integer no-undo .
      859     assign
      860       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      861     .
      862     do ind = 1 to v-num-parfirst-list
      863     :
      864       assign
      865         v-elem = entry(ind, parfirst-list, pardelim)
      866       .
      867       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      868         assign
      869           v-result-list = v-result-list
      870                         + (if v-result-list > "" then pardelim else "")
      871                         + v-elem
      872         .
      873       end.
      874     end.
      875     return v-result-list .
      876   end function.
      877   function add-list returns character (
      878    input parfirst-list  as character,
      879    input parsecond-list as character,
      880    input pardelim       as character).
      881     if pardelim = ""
      882     or pardelim = ?
      883     then do:
      884       assign
      885         pardelim = ","
      886       .
      887     end.
      888     def var ind as integer no-undo .
      889     def var v-elem as character no-undo .
      890     def var v-result-list as character no-undo init "".
      891     def var v-num-parfirst-list as integer no-undo .
      892     assign
      893       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      894     .
      895     do ind = 1 to v-num-parfirst-list
      896     :
      897       assign
      898         v-elem = entry(ind, parfirst-list, pardelim)
      899       .
      900       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      901         assign
      902           v-result-list = v-result-list
      903                         + (if v-result-list > "" then pardelim else "")
      904                         + v-elem
      905         .
      906       end.
      907     end.
      908     def var v-num-parsecond-list as integer no-undo .
      909     assign
      910       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      911     .
      912     do ind = 1 to v-num-parsecond-list
      913     :
      914       assign
      915         v-elem = entry(ind, parsecond-list, pardelim)
      916       .
      917       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      918         assign
      919           v-result-list = v-result-list
      920                         + (if v-result-list > "" then pardelim else "")
      921                         + v-elem
      922         .
      923       end.
      924     end.
      925     return v-result-list .
      926   end function.
      927   function cross-list returns character (
      928    input parfirst-list  as character,
      929    input parsecond-list as character,
      930    input pardelim       as character).
      931     if pardelim = ""
      932     or pardelim = ?
      933     then do:
      934       assign
      935         pardelim = ","
      936       .
      937     end.
      938     def var ind as integer no-undo .
      939     def var v-elem as character no-undo .
      940     def var v-result-list as character no-undo init "".
      941     def var v-num-parfirst-list as integer no-undo .
      942     assign
      943       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      944     .
      945     do ind = 1 to v-num-parfirst-list
      946     :
      947       assign
      948         v-elem = entry(ind, parfirst-list, pardelim)
      949       .
      950       if lookup(v-elem, v-result-list, pardelim) = 0
      951       and lookup(v-elem, parsecond-list, pardelim) > 0
      952       then do:
      953         assign
      954           v-result-list = v-result-list
      955                         + (if v-result-list > "" then pardelim else "")
      956                         + v-elem
      957         .
      958       end.
      959     end.
      960     return v-result-list .
      961   end function.
      962   function radio-label returns character (
      963    input par-rs-value  as character,
      964    input par-rs-radio-buttons as character)
      965    .
      966    DEFINE variable v-result-label as character no-undo.
      967    assign
      968    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      969                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      970                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      971                             ), par-rs-radio-buttons
      972                           )
      973    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      974    .
      975   return v-result-label.
      976   end function.
      977   function m-radio-label returns character (
      978    input par-rs-value  as character,
      979    input par-rs-radio-buttons as character,
      980    input par-delim as character
      981    )
      982    .
      983    DEFINE variable v-result-label as character no-undo.
      984    assign
      985    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      986                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      987                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      988                             ), par-rs-radio-buttons, par-delim
      989                           )
      990    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      991    .
      992   return v-result-label.
      993   end function.
      994   FUNCTION mixlist returns character
      995   (
      996    input parfirst-list  as character
      997    ,input parsecond-list as character
      998    ,input pardelim       as character
      999    ,input pardelim-result as character ) :
     1000     if pardelim = ""
     1001     or pardelim = ?
     1002     then do:
     1003       assign
     1004         pardelim = ","
     1005       .
     1006     end.
     1007     def var ind as integer no-undo .
     1008     def var v-elem1 as character no-undo .
     1009     def var v-elem2 as character no-undo .
     1010     def var v-result-list as character no-undo init "".
     1011     do ind = 1 to num-entries(parfirst-list, pardelim)
     1012     :
     1013       assign
     1014         v-elem1 = entry(ind, parfirst-list, pardelim)
     1015         v-elem2 = entry(ind, parsecond-list, pardelim)
     1016       .
     1017         assign
     1018           v-result-list = v-result-list
     1019                         + (if v-result-list > "" then pardelim-result else "")
     1020                         + v-elem1 + pardelim-result + v-elem2
     1021         .
     1022     end.
     1023     return v-result-list .
     1024   END FUNCTION.
     1025   define stream getmc-stream .
     1026   procedure get-max-code :
     1027     define input  parameter p-action         as   character                 no-undo .
     1028     define input  parameter p-db-num         like ub.db.db-num             no-undo .
     1029     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
     1030     define input  parameter p-first-code     like ub.code-range.first-code no-undo .
     1031     define input  parameter p-last-code      like ub.code-range.last-code  no-undo .
     1032     define input  parameter p-view-mess      as   logical                   no-undo .
     1033     define output parameter v-b-code         as   integer                   no-undo .
     1034     do
     1035     on error undo, return error return-value
     1036     :
     1037       define variable v-main-bcode     like ub.bar-code.b-code no-undo .
     1038       define variable l-prod-bc-global as   logical             no-undo .
     1039       define variable l-prod-bc-weight as   logical             no-undo .
     1040       define variable l-prod-bc-pgweight as   logical             no-undo .
     1041       define variable rec-cnt          as   integer             no-undo .
     1042       define variable str-u-f          as   character           no-undo .
     1043       define variable str-u-f-rng      as   character           no-undo .
     1044       define variable ind              as   integer             no-undo .
     1045       define variable v-msg              as   character           no-undo initial "":U.
     1046       define variable v-ret-msg          as   character           no-undo initial "":U.
     1047       define frame get-max-code-inf
     1048         rec-cnt label "Просмотрено"
     1049         with view-as dialog-box side-labels row 11 centered
     1050         title "..........................................." three-d
     1051       .
     1052       define buffer buf_code-range   for ub.code-range .
     1053       define buffer buf-c_code-range for ub.code-range .
     1054       define buffer buf_bar-code     for ub.bar-code .
     1055       define buffer buf_place        for ub.place .
     1056       define buffer buf_goods        for ub.goods .
     1057       define buffer buf_units        for ub.units .
     1058       define buffer buf_prod-bc      for ub.prod-bc .
     1059       define buffer buf_dis-card     for ub.dis-card .
     1060       define buffer buf_dis-rule     for ub.dis-rule .
     1061       define buffer buf_dis-time-rule     for ub.dis-time-rule .
     1062       define buffer buf_firm         for ub.firm .
     1063       define buffer buf_person       for ub.person .
     1064       define buffer buf_contract     for ub.contract .
     1065       if p-curr-type-cdrg = 'sslc':U
     1066       or p-curr-type-cdrg = 'ssgb':U
     1067       then do:
     1068         assign
     1069           v-b-code = ?
     1070         .
     1071         return.
     1072       end.
     1073       if p-curr-type-cdrg = 'sclc':U
     1074       or p-curr-type-cdrg = 'pglc':U
     1075         or p-curr-type-cdrg = 'sslc':U
     1076       then do:
     1077         assign
     1078           p-db-num = 0
     1079         .
     1080       end.
     1081       case p-action :
     1082         when "get-m-code":U then do:
     1083           assign
     1084             v-b-code = p-first-code
     1085           .
     1086         end.
     1087         when "f-u":U then do:
     1088           assign
     1089             v-b-code = 0
     1090           .
