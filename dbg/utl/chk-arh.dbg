        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Жесткое архивирование чеков".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   define stream exp-stream.
      108   define variable rid-list as character no-undo.
      109   define new global shared variable g#language as character no-undo .
      110   if g#language <> '' and g#language <> 'rus':U then do:
      111     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      112   end.
      113   DEFINE BUTTON b-dir
      114        IMAGE-UP FILE "btn-down-arrow":U
      115        IMAGE-DOWN FILE "btn-down-arrow":U
      116        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      117        LABEL ""
      118        SIZE 3 BY 1.
      119   DEFINE BUTTON b-help
      120        LABEL "Помо&щь"
      121        SIZE 10 BY 1.
      122   DEFINE BUTTON b-obj
      123        IMAGE-UP FILE "btn-down-arrow":U
      124        IMAGE-DOWN FILE "btn-down-arrow":U
      125        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      126        LABEL ""
      127        SIZE 2.8 BY 1.
      128   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      129        LABEL "&Отмена"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON Btn_OK
      133        LABEL "&Ввод"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE VARIABLE dirname AS CHARACTER FORMAT "X(256)":U INITIAL ".~\"
      137        LABEL "Каталог для архива"
      138        VIEW-AS FILL-IN
      139        SIZE 29.5 BY 1 NO-UNDO.
      140   DEFINE VARIABLE i AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      141        LABEL "Обработано"
      142        VIEW-AS FILL-IN
      143        SIZE 14 BY 1 NO-UNDO.
      144   DEFINE VARIABLE i-month AS INTEGER FORMAT "99":U INITIAL 0
      145        LABEL "Месяц архивации"
      146        VIEW-AS FILL-IN
      147        SIZE 3.1 BY 1 NO-UNDO.
      148   DEFINE VARIABLE i-obj-code AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
      149        LABEL "Код магазина"
      150        VIEW-AS FILL-IN
      151        SIZE 14 BY 1 NO-UNDO.
      152   DEFINE VARIABLE i-year AS INTEGER FORMAT "9999":U INITIAL 0
      153        LABEL "Год архивации"
      154        VIEW-AS FILL-IN
      155        SIZE 4.8 BY 1 NO-UNDO.
      156   DEFINE VARIABLE sh-name AS CHARACTER FORMAT "X(50)":U
      157        VIEW-AS FILL-IN
      158        SIZE 34.9 BY 1 NO-UNDO.
      159   DEFINE VARIABLE T-del AS LOGICAL INITIAL no
      160        LABEL "С удалением чеков"
      161        VIEW-AS TOGGLE-BOX
      162        SIZE 21.5 BY .87 NO-UNDO.
      163   DEFINE QUERY Dialog-Frame FOR
      164         ub.chk-doc SCROLLING.
      165   DEFINE FRAME Dialog-Frame
      166        Btn_OK AT ROW 1 COL 1
      167        Btn_Cancel AT ROW 1 COL 11
      168        b-help AT ROW 1 COL 58 WIDGET-ID 2
      169        i-obj-code AT ROW 2.33 COL 13 COLON-ALIGNED
      170        b-obj AT ROW 2.4 COL 28.7
      171        sh-name AT ROW 2.4 COL 30.1 COLON-ALIGNED NO-LABEL
      172        i-month AT ROW 3.83 COL 16 COLON-ALIGNED
      173        i-year AT ROW 3.83 COL 33.5 COLON-ALIGNED
      174        i AT ROW 3.9 COL 50.6 COLON-ALIGNED
      175        dirname AT ROW 5.27 COL 19 COLON-ALIGNED
      176        b-dir AT ROW 5.27 COL 51
      177        ub.chk-doc.chk-date AT ROW 5.27 COL 59 COLON-ALIGNED
      178             VIEW-AS FILL-IN
      179             SIZE 10.9 BY 1
      180        T-del AT ROW 6.7 COL 2.5
      181        SPACE(48.89) SKIP(2.22)
      182       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      183            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      184            TITLE "Архивирование чеков"
      185            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      186   ASSIGN
      187          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      188          FRAME Dialog-Frame:HIDDEN           = TRUE.
      189   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      190   DO:
      191     APPLY "END-ERROR":U TO SELF.
      192   END.
      193   ON CHOOSE OF b-dir IN FRAME Dialog-Frame
      194   DO:
      195       define variable v_os-file   AS CHAR NO-UNDO INIT "":U.
      196       define variable ll_commit AS LOG    NO-UNDO INIT NO.
      197       SYSTEM-DIALOG GET-DIR v_os-file
      198           TITLE      "Выберите каталог для архива"
      199           UPDATE ll_commit.
      200       IF ll_commit <> YES THEN RETURN NO-APPLY.
      201       ASSIGN dirname = v_os-file + "\" .
      202       DISP dirname WITH FRAME Dialog-Frame.
      203   END.
      204   ON CHOOSE OF b-obj IN FRAME Dialog-Frame
      205   DO:
      206     run ref/cli-all.w ( input parparentproc
      207                        ,input "'ПРОСМОТР':U,b-sel"
      208                        ,input ?
      209                        ,input ?
      210                        ,input ?
      211                        ,input ?
      212                        ,input ?
      213                        ,input ?
      214                        ,output rid-list) .
      215     if rid-list = "":U then return no-apply.
      216     find clients no-lock
      217       where recid(clients) = integer(rid-list)
      218       no-error
      219       .
      220     assign
      221       i-obj-code = clients.obj-code
      222       sh-name = clients.obj-name.
      223     disp
      224       i-obj-code
      225       sh-name
      226     with frame Dialog-Frame.
      227   END.
      228   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      229   DO:
      230     assign
      231       i-obj-code
      232       i-month
      233       i-year
      234       dirname
      235       t-del.
      236     dirname = right-trim(dirname, "\").
      237     dirname = dirname + "\".
      238     find clients where clients.obj-type = 'маг':U and clients.obj-code = i-obj-code no-lock no-error.
      239     if not available clients then do:
      240       message "Неправильно задан объект" view-as alert-box error.
      241       return no-apply.
      242     end.
      243     sh-name = clients.obj-name.
      244     disp sh-name with frame Dialog-Frame.
      245     if i-month > 12 or i-month = 0 then do:
      246       message "Неправильно задан месяц архивации" view-as alert-box error.
      247       return no-apply.
      248     end.
      249     if i-year = 0  then do:
      250       message "Неправильно задан год архивации" view-as alert-box error.
      251       return no-apply.
      252     end.
      253     if (year(today) = i-year and month(today) <= i-month) or year(today) < i-year then do:
      254       message "Дата архива должна быть меньше текущей!" view-as alert-box error.
      255       return no-apply.
      256     end.
      257     if dirname = "" then dirname = ".\".
      258     if search( dirname + string(i-month, "99") + string(i-year) + ".txt") <> ? then do:
      259       message "Уже есть архив за этот месяц Переместите файл в другое место!" view-as alert-box error.
      260       return no-apply.
      261     end.
      262     run chk-out(t-del).
      263   END.
      264   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      265   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      266   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      267   on help of frame Dialog-Frame
      268   do:
      269     run gbl/app_help.p
      270       (input this-procedure :file-name
      271       ,input ''
      272       ,input ?
      273       ) no-error.
      274     if error-status :error then do:
      275       message
      276         "Ошибка при вызове помощи"
      277         error-status :get-message(1)
      278         view-as alert-box .
      279     end.
      280   end.
      281   run minbtn-set in this-procedure .
      282   on choose of b-help in frame Dialog-Frame
      283   do:
      284     apply "help":u to frame Dialog-Frame .
      285   end.
      286   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      287   procedure minbtn-set :
      288       do
      289           on error undo, return error return-value
      290           :
      291           define variable ii              as integer       no-undo .
      292           define variable fh              as widget-handle no-undo .
      293           define variable hh              as widget-handle no-undo .
      294           define variable v-h             as handle        extent 4 no-undo .
      295           define variable v-name-button   as character     no-undo .
      296           define variable v-help-old-x    as decimal       no-undo .
      297           define variable v-help-old-y    as decimal       no-undo .
      298           define variable v-help-old-size as decimal       no-undo .
      299           define variable v-frame-width   as decimal       no-undo .
      300           define variable jj              as integer       no-undo .
      301           do
      302               on error undo, return error
      303               :
      304               assign
      305                   v-frame-width = frame Dialog-Frame:width - 0.3
      306                   fh            = frame Dialog-Frame:first-child
      307                   hh            = fh:first-child
      308                   ii            = 1
      309                   .
      310               do while valid-handle(hh):
      311                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      312                   do:
      313                       case lc(hh:name) :
      314                           when "b-help" then
      315                               do:
      316                                   hh:load-image-up("cmp/b-help.bmp":u) .
      317                                   hh:load-image-down("cmp/b-help.bmp":u) .
      318                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      319                                   hh:TOOLTIP = "Помощь" .
      320                                   v-help-old-x = hh:column .
      321                                   v-help-old-y = hh:row    .
      322                                   v-help-old-size = hh:width .
      323                                   hh:width-chars = 2.5 .
      324                               end.
      325                           when "b-print" then
      326                               do:
      327                                   hh:load-image("cmp/b-print.bmp":u) .
      328                                   hh:TOOLTIP = "Печать" .
      329                                   v-h[ii] = hh:handle .
      330                                   ii = ii + 1 .
      331                                   hh:width-chars = 3 .
      332                               end.
      333                           when "b-history" or
      334                           when "b-hist" then
      335                               do:
      336                                   hh:load-image("cmp/b-hist.bmp":u) .
      337                                   hh:TOOLTIP = "История" .
      338                                   v-h[ii] = hh:handle .
      339                                   ii = ii + 1 .
      340                                   hh:width-chars = 3 .
      341                               end.
      342                           when "b-sch" then
      343                               do:
      344                                   hh:load-image("cmp/b-sch.bmp":u) .
      345                                   hh:TOOLTIP = "Установка Фильтра" .
      346                                   v-h[ii] = hh:handle .
      347                                   ii = ii + 1 .
      348                                   hh:width-chars = 3 .
      349                               end.
      350                           when "b-hist-user" then
      351                               do:
      352                                   hh:load-image("cmp/b-hist.bmp":u) .
      353                                   hh:TOOLTIP = "История пользователя" .
      354                                   ii = ii + 1 .
      355                               end.
      356                       end case.
      357                   end.
      358                   hh = hh:next-sibling.
      359               end.
      360               b-help:column = v-frame-width - b-help:width-chars.
      361               jj = 0.
      362               repeat ii = 4 to 1 by -1 :
      363                   if valid-handle (v-h[ii] ) then
      364                   do:
      365                       jj  = jj + 1 .
      366                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      367                       v-h[ii]:row    = v-help-old-y .
      368                   end.
      369               end.
      370           end.
      371       end.
      372   end procedure.
      373   MAIN-BLOCK:
      374   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      375      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      376     RUN enable_UI.
      377     WAIT-FOR GO OF FRAME Dialog-Frame.
      378   END.
      379   RUN disable_UI.
      380   PROCEDURE chk-out :
      381   define input parameter p-del as logical no-undo.
      382     ON DELETE of chk-doc override do: end.
      383     output stream exp-stream to value( dirname + string(i-month, "99") + string(i-year) + ".txt").
      384     put stream exp-stream unformatted
      385     i-obj-code chr(32)
      386     i-month chr(32)
      387     i-year chr(32)
      388     "v1.01"  skip(0).
      389     for each chk-doc where chk-doc.obj-type = 'маг':U and
      390                                         chk-doc.obj-code = i-obj-code and
      391                                         year(chk-doc.chk-date) = i-year and
      392                                         month(chk-doc.chk-date) = i-month
      393                                         use-index obj-date exclusive:
      394   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   export  stream exp-stream  "chk-doc"
      396     chk-doc.out-code chk-doc.doc-code
      397    .
      398   export  stream exp-stream  ub.chk-doc.
      399         for each chk-gds where chk-gds.doc-code = chk-doc.doc-code exclusive-lock:
      400   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   export  stream exp-stream  "chk-gds"
      402    .
      403   export  stream exp-stream  ub.chk-gds.
      404             if p-del then delete chk-gds.
      405         end.
      406         for each chk-pay where chk-pay.doc-code = chk-doc.doc-code exclusive-lock:
      407   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   export  stream exp-stream  "chk-pay"
      409    .
      410   export  stream exp-stream  ub.chk-pay.
      411             if p-del then delete chk-pay.
      412         end.
      413         for each chk-discnt where chk-discnt.doc-code = chk-doc.doc-code exclusive-lock:
      414   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   export  stream exp-stream  "chk-discnt"
      416    .
      417   export  stream exp-stream  ub.chk-discnt.
      418             if p-del then delete chk-discnt.
      419         end.
      420         for each chk-doc-attr where chk-doc-attr.doc-code = chk-doc.doc-code exclusive-lock:
      421   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422   export  stream exp-stream  "chk-doc-attr"
      423    .
      424   export  stream exp-stream  ub.chk-doc-attr.
      425             if p-del then delete chk-doc-attr.
      426         end.
      427        i = i + 1.
      428        disp i chk-doc.chk-date with frame Dialog-Frame .
      429        if p-del then delete chk-doc.
      430     end.
      431     output stream exp-stream close.
      432     ON DELETE of chk-doc revert.
      433     message "Архивация закончена. архив в каталоге " dirname view-as alert-box message.
      434   END PROCEDURE.
      435   PROCEDURE disable_UI :
      436     HIDE FRAME Dialog-Frame.
      437   END PROCEDURE.
      438   PROCEDURE enable_UI :
      439     OPEN QUERY Dialog-Frame FOR EACH ub.chk-doc SHARE-LOCK.
      440     GET FIRST Dialog-Frame.
      441     DISPLAY i-obj-code sh-name i-month i-year i dirname T-del
      442         WITH FRAME Dialog-Frame.
      443     IF AVAILABLE ub.chk-doc THEN
      444       DISPLAY ub.chk-doc.chk-date
      445         WITH FRAME Dialog-Frame.
      446     ENABLE Btn_OK Btn_Cancel b-help i-obj-code b-obj i-month i-year dirname b-dir
      447            ub.chk-doc.chk-date T-del
      448         WITH FRAME Dialog-Frame.
      449     VIEW FRAME Dialog-Frame.
      450   END PROCEDURE.
