      805           0xF00F9344, 0x8708A3D2, 0x1E01F268, 0x6906C2FE, 0xF762575D, 0x806567CB,
      806           0x196C3671, 0x6E6B06E7, 0xFED41B76, 0x89D32BE0, 0x10DA7A5A, 0x67DD4ACC,
      807           0xF9B9DF6F, 0x8EBEEFF9, 0x17B7BE43, 0x60B08ED5, 0xD6D6A3E8, 0xA1D1937E,
      808           0x38D8C2C4, 0x4FDFF252, 0xD1BB67F1, 0xA6BC5767, 0x3FB506DD, 0x48B2364B,
      809           0xD80D2BDA, 0xAF0A1B4C, 0x36034AF6, 0x41047A60, 0xDF60EFC3, 0xA867DF55,
      810           0x316E8EEF, 0x4669BE79, 0xCB61B38C, 0xBC66831A, 0x256FD2A0, 0x5268E236,
      811           0xCC0C7795, 0xBB0B4703, 0x220216B9, 0x5505262F, 0xC5BA3BBE, 0xB2BD0B28,
      812           0x2BB45A92, 0x5CB36A04, 0xC2D7FFA7, 0xB5D0CF31, 0x2CD99E8B, 0x5BDEAE1D,
      813           0x9B64C2B0, 0xEC63F226, 0x756AA39C, 0x026D930A, 0x9C0906A9, 0xEB0E363F,
      814           0x72076785, 0x05005713, 0x95BF4A82, 0xE2B87A14, 0x7BB12BAE, 0x0CB61B38,
      815           0x92D28E9B, 0xE5D5BE0D, 0x7CDCEFB7, 0x0BDBDF21, 0x86D3D2D4, 0xF1D4E242,
      816           0x68DDB3F8, 0x1FDA836E, 0x81BE16CD, 0xF6B9265B, 0x6FB077E1, 0x18B74777,
      817           0x88085AE6, 0xFF0F6A70, 0x66063BCA, 0x11010B5C, 0x8F659EFF, 0xF862AE69,
      818           0x616BFFD3, 0x166CCF45, 0xA00AE278, 0xD70DD2EE, 0x4E048354, 0x3903B3C2,
      819           0xA7672661, 0xD06016F7, 0x4969474D, 0x3E6E77DB, 0xAED16A4A, 0xD9D65ADC,
      820           0x40DF0B66, 0x37D83BF0, 0xA9BCAE53, 0xDEBB9EC5, 0x47B2CF7F, 0x30B5FFE9,
      821           0xBDBDF21C, 0xCABAC28A, 0x53B39330, 0x24B4A3A6, 0xBAD03605, 0xCDD70693,
      822           0x54DE5729, 0x23D967BF, 0xB3667A2E, 0xC4614AB8, 0x5D681B02, 0x2A6F2B94,
      823           0xB40BBE37, 0xC30C8EA1, 0x5A05DF1B, 0x2D02EF8D].
      824       RETURN crc32_tab.
      825   END .
      826   FUNCTION CRC32 RETURNS INT64
      827   (INPUT mpData AS MEMPTR):
      828       DEFINE VARIABLE IN_BYtes_Size   AS INTEGER   NO-UNDO.
      829       DEFINE VARIABLE in_byte         AS INTEGER   NO-UNDO.
      830       DEFINE VARIABLE crc_value       AS INT64     NO-UNDO.
      831       DEFINE VARIABLE tmp             AS INT64     NO-UNDO.
      832       DEFINE VARIABLE crc32_tab       AS INT64     NO-UNDO EXTENT 256.
      833       DEFINE VARIABLE in_loop         AS INTEGER     NO-UNDO.
      834       crc32_tab = crc32Table().
      835       crc_value = 0xffffffff.
      836       In_Bytes_Size = GET-SIZE(mpData).
      837       DO in_loop = 1 TO In_Bytes_Size:
      838           tmp = BinaryXOR(crc_value, GET-BYTE(mpData,in_loop )).
      839           crc_value = BinaryXOR( ShiftRight(crc_value, 8), crc32_tab[BinaryAND(tmp,0x00ff) + 1 ] ).
      840       END.
      841       crc_value = BinaryXOR(crc_value, 0xffffffff).
      842       RETURN crc_value.
      843   END .
      844   define temp-table tt-code like code.
      845   function getCashparamHash returns character ():
      846       define variable exp as ibs.th.bge.xmlimpexp no-undo.
      847       define variable hQuery   as handle  no-undo .
      848       define buffer Buf_code for tt-code.
      849       define buffer     code for    code.
      850       FOR EACH code where code.parent begins 'cash-param'
      851                       and num-entries(code.parent,chr(4)) eq 4
      852       no-lock:
      853          create Buf_code.
      854          buffer-copy code except export_ nwsgbd procview procedit to Buf_code.
      855       end.
      856       create query hQuery.
      857       hQuery:set-buffers(buffer Buf_code :HANDLE).
      858       hQuery:query-prepare("FOR EACH Buf_code").
      859       hQuery:query-open ().
      860       exp = new ibs.th.bge.xmlimpexp ().
      861       exp:updatetableforxml(hQuery).
      862       delete object hQuery.
      863       FOR EACH buf_code:
      864          delete buf_code.
      865       end.
      866       define variable vxmlCode as character  no-undo.
      867       define variable v-md5-signature as character no-undo.
      868       exp:xmldom-save  ( "cashparammd5.xml" ).
      869       vxmlCode = search("cashparammd5.xml").
      870       run gbl/md5.p (
      871             input  vxmlCode
      872            ,output v-md5-signature
      873            ) .
      874       os-delete value (vxmlCode).
      875       delete object exp.
      876       return encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      877     .
      878   end.
      879   function getCashParamHashDb returns character (idb as int):
      880      define buffer code for ub.code.
      881      find first code where code.parent eq "CashParamHash"
      882                        and code.code   eq  string(idb)
      883      no-lock no-error.
      884      return if available code then Code.CodeValue else ?.
      885   end.
      886   procedure saveCashParHash:
      887      define input  parameter iDb as integer no-undo.
      888      define buffer code for ub.code.
      889      find first code where code.parent eq ""
      890                        and code.code   eq "CashParamHash"
      891      no-lock no-error.
      892      if not available code
      893      then do:
      894         create code.
      895         assign
      896            Code.parent   = ""
      897            Code.code     = "CashParamHash"
      898            Code.CodeName = "Конрольная сумма Эталонных параметров для кассы"
      899         .
      900      end.
      901      find first code where code.parent eq "CashParamHash"
      902                        and code.code   eq  string(idb)
      903      exclusive-lock no-error.
      904      if not available code
      905      then do:
      906         create Code.
      907         assign
      908            code.parent = "CashParamHash"
      909            code.code   =  string(idb)
      910            Code.nwsubd = yes
      911         .
      912      end.
      913      Code.CodeName  = string(now).
      914      Code.CodeValue = getCashparamHash().
      915   end.
      916   if g#db-num ne 0
      917   then
      918      run saveCashParHash(g#db-num).
      919   define variable mSocetLog as character no-undo.
      920   mSocetLog = GetParamAsunc(1).
      921   for each shop no-lock,
      922   each clients where clients.db-num   eq g#db-num
      923                  and clients.obj-type eq 'маг':U
      924                  and clients.obj-code eq shop.obj-code
      925                  and clients.stts     eq 0
      926   no-lock:
      927      run str/send-all.p(?,
      928                         this-procedure,
      929                         this-procedure,
      930                         substitute ("&2&1&3&1&4&1&5&1&6&1cash-send=all,&7",
      931                                      chr(4),
      932                                      clients.obj-type,
      933                                      clients.obj-code,
      934                                      'U':U,
      935                                      "cashp1,cashp2",
      936                                      'Получение параметров кассы':U,
      937                                      "SocetLog=" + mSocetLog
      938                                      )
      939                         )
      940      .
      941      run bge\send1cerp.p (?,
      942                         this-procedure,
      943                         this-procedure,
      944                         "CashParamControl",
      945                         ?,
      946                         ?,
      947                         ?).
      948      run bge\send1cerp.p (?,
      949                         this-procedure,
      950                         this-procedure,
      951                         "CashParamHist",
      952                         ?,
      953                         ?,
      954                         ?).
      955   end.
