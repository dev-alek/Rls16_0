      667   PROCEDURE write-log :
      668   do
      669   on error undo, return error
      670   :
      671   define input parameter p-tab-position   as integer      no-undo.
      672   define input parameter p-log-string     as character    no-undo.
      673   run write-to-log in this-procedure( input ( fill( chr(32), 1  * p-tab-position)  +
      674                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
      675                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      676                                       ELSE p-log-string))).
      677   end.
      678   END PROCEDURE.
      679   procedure writelog :
      680   do
      681   on error undo, return error
      682   :
      683   define input parameter p-file-name AS CHAR     NO-UNDO.
      684   define input parameter p-log-level AS INTEGER  NO-UNDO.
      685   define input parameter p-log-string  AS CHAR     NO-UNDO.
      686     if p-file-name <> "" then
      687     run  auto2dia-Writefile in this-procedure (
      688                                       input p-file-name
      689                                     ,input p-log-level
      690                                     ,input p-log-string
      691                                   ) no-error .
      692      process events.
      693   end.
      694   end procedure.
      695   PROCEDURE auto2dia-writefile:
      696     define input parameter sFileName AS CHAR     NO-UNDO.
      697     define input parameter iLogLevel AS INTEGER  NO-UNDO.
      698     define input parameter sToWrite  AS CHAR     NO-UNDO.
      699     define variable v-SlashPos  as integer no-undo .
      700     define variable v-lDirName  as character no-undo .
      701     define variable v-lDirName2 as character no-undo .
      702     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
      703     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
      704     FILE-INFO:FILE-NAME = v-lDirName .
      705     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
      706     if v-lDirName2 <> ? then do :
      707   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
      708       PUT STREAM auto2dia UNFORMATTED chr(10).
      709       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      710                                         OR sToWrite = "&Line") THEN "" ELSE
      711                                         cur-time-string-sec() + " ").
      712       PUT STREAM auto2dia UNFORMATTED
      713               (IF sToWrite = "&Line" THEN FILL("-", 80)
      714                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      715                ELSE sToWrite).
      716   OUTPUT STREAM auto2dia CLOSE.
      717     end .
      718   END PROCEDURE.
      719   FUNCTION BinaryXOR RETURNS INT64(INPUT intOperand1 AS INT64,
      720                                    INPUT intOperand2 AS INT64)
      721                                    forward .
      722   FUNCTION ShiftRight RETURNS INT64(INPUT in_Operand_A AS INT64,
      723                                     INPUT in_Operand_B AS INTEGER)
      724                                     forward .
      725   FUNCTION BinaryAND RETURNS INTEGER (INPUT in_Operand_A AS INT64,
      726                                       INPUT in_Operand_B AS INT64)
      727                                       forward .
      728   FUNCTION intToHex RETURNS CHARACTER (i_iint AS INT64) forward .
      729   FUNCTION crc32Table RETURNS INT64 EXTENT 256  () forward .
      730   FUNCTION CRC32 RETURNS INT64 (INPUT mpData AS MEMPTR) forward .
      731   FUNCTION BinaryXOR RETURNS INT64
      732   (INPUT intOperand1 AS INT64,
      733    INPUT intOperand2 AS INT64):
      734       DEFINE VARIABLE iByteLoop  AS INTEGER NO-UNDO.
      735       DEFINE VARIABLE iXOResult  AS INT64 NO-UNDO.
      736       DEFINE VARIABLE lFirstBit  AS LOGICAL NO-UNDO.
      737       DEFINE VARIABLE lSecondBit AS LOGICAL NO-UNDO.
      738       iXOResult = 0.
      739       DO iByteLoop = 1 TO 64:
      740           ASSIGN
      741           lFirstBit  = LOGICAL(GET-BITS(intOperand1,iByteLoop  ,1))
      742           lSecondBit = LOGICAL(GET-BITS(intOperand2,iByteLoop , 1)).
      743           IF (lFirstBit  AND NOT lSecondBit) OR
      744              (lSecondBit AND NOT lFirstBit) THEN
      745               iXOResult = iXOResult + EXP(2, iByteLoop - 1).
      746       END.
      747       RETURN iXOResult.
      748   END .
      749   FUNCTION ShiftRight RETURNS INT64
      750   (INPUT in_Operand_A AS INT64,
      751    INPUT in_Operand_B AS INTEGER):
      752      RETURN INT64( TRUNCATE( in_Operand_A / EXP(2,in_Operand_B), 0 ) ).
      753   END .
      754   FUNCTION BinaryAND RETURNS INTEGER
      755   (INPUT in_Operand_A AS INT64,
      756    INPUT in_Operand_B AS INT64):
      757      DEFINE VARIABLE in_cbit     AS INTEGER     NO-UNDO.
      758      DEFINE VARIABLE in_result   AS INT64     NO-UNDO.
      759      DO in_cbit = 1 TO 64:
      760         IF LOGICAL( GET-BITS( in_Operand_A, in_cbit, 1 ) ) AND
      761            LOGICAL( GET-BITS( in_Operand_B, in_cbit, 1 ) )
      762         THEN
      763            PUT-BITS( in_result, in_cbit, 1 ) = 1.
      764     END.
      765     RETURN in_result.
      766   END .
      767   FUNCTION intToHex RETURNS CHARACTER
      768   (i_iint AS INT64):
      769      DEF VAR chex  AS CHAR NO-UNDO.
      770      DEF VAR rbyte AS RAW  NO-UNDO.
      771      DO WHILE i_iint > 0:
      772         PUT-BYTE( rbyte, 1 ) = i_iint MODULO 256.
      773         chex = STRING( HEX-ENCODE( rbyte ) ) + chex.
      774         i_iint = TRUNCATE( i_iint / 256, 0 ).
      775      END.
      776      RETURN chex.
      777   END .
