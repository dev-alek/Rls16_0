        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   define variable mError as logical no-undo.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable mAsyncProc as class ibs.th.file.AsyncProc.
       68   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       69   define variable mstopAsunc as logical no-undo.
       70   function StopCheck returns logical:
       71      define variable oFlag as logical no-undo.
       72      run StopCheckAsync (output oFlag).
       73      return oFlag.
       74   end.
       75   procedure StopCheckAsync:
       76       define output  parameter oFlag as logical no-undo.
       77       if mstopAsunc
       78       then
       79          oFlag = mstopAsunc.
       80       else do:
       81          oFlag = mAsyncProc:CheckStop().
       82          mstopAsunc = oFlag.
       83       end.
       84   end.
       85   function GetParamAsunc returns character
       86   (input iNumPar as integer  ):
       87      return mAsyncProc:GetPARAM(iNumPar).
       88   end.
       89   function GetParamAsuncStr returns ibs.th.file.asyncparam
       90   (input iParamName as character ):
       91      return mAsyncProc:GetPARAM(iParamName).
       92   end.
       93   procedure PutMesAsunc:
       94       define input  parameter Itext as character no-undo.
       95       define variable vflag as logical no-undo.
       96       Publish "WriteLogAsunc" (Itext, yes)  .
       97   end.
       98   procedure PutMesAsuncNoTime:
       99       define input  parameter Itext as character no-undo.
      100       define variable vflag as logical no-undo.
      101       Publish "WriteLogAsunc" (Itext,no)  .
      102   end.
      103   procedure PutStatAsunc:
      104       define input  parameter Itext as character no-undo.
      105       Publish "PutStatAsunc" (Itext,no) .
      106        run
      107       PutMesAsunc (itext).
      108   end.
      109   procedure PutStatAsuncNoTime:
      110       define input  parameter Itext as character no-undo.
      111       Publish "PutStatAsunc" (Itext,no)  .
      112        run
      113       PutMesAsuncNoTime (itext).
      114   end.
      115   procedure PutStatAsuncAdd:
      116       define input  parameter Itext as character no-undo.
      117       Publish "PutStatAsunc" (Itext,yes)  .
      118   end.
      119   procedure PutFileLogAsunc:
      120       define input  parameter IFile as character no-undo.
      121       Publish "PutFileLogAsunc" (ifile)  .
      122   end.
      123          mAsyncProc:mProcPublish = this-procedure.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define  shared variable g#auto-pid           as integer   no-undo .
      126   define  shared variable conn-par             as character no-undo .
      127   define  shared variable g#auto-user-id       as character no-undo .
      128   define  shared variable g#auto-user-login    as character no-undo .
      129   define  shared variable g#auto-user-password as character no-undo .
      130   define  shared variable v-socket             as logical   no-undo .
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define  shared variable auto-window-h     as handle    no-undo .
      133   define  shared variable auto-log-msg-h    as handle    no-undo .
      134   define  shared variable hand-log-msg-h    as handle    no-undo .
      135   define  shared variable log-file-name     as character no-undo initial ? .
      136   define  shared variable add-log-file-name as character no-undo initial ? .
      137   define  shared variable writelogvalue     as character no-undo initial ? .
      138   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   procedure cur-time :
      140      define output parameter p-today as date      no-undo .
      141      define output parameter p-time  as integer   no-undo .
      142     do
      143     on error undo, return error
      144     :
      145       define variable v-date1 as date      no-undo .
      146       define variable v-date2 as date      no-undo .
      147       define variable v-time  as integer   no-undo .
      148       assign
      149         v-date1 = today
      150         v-time  = time
      151         v-date2 = today
      152       .
      153       if v-date1 <> v-date2
      154       then do:
      155         assign
      156           v-date1 = today
      157           v-time  = v-time
      158         .
      159       end.
      160       assign
      161         p-today = v-date1
      162         p-time  = v-time
      163       .
      164     end.
      165   end.
      166   function cur-time-date returns character
      167   :
      168     return string(today, '99/99/9999':U) .
      169   end.
      170   function cur-time-mjd returns decimal
      171   :
      172     define variable v-date as date      no-undo .
      173     define variable v-time as integer   no-undo .
      174     run cur-time in this-procedure
      175       (output v-date
      176       ,output v-time
      177       ) .
      178     return integer(v-date) - 2400002 + (v-time / 86400) .
      179   end.
      180   function cur-time-get-ending-index returns integer
      181   (input p-number as integer
      182   )
      183   :
      184     if p-number < 0
      185     or p-number = ?
      186     then do:
      187       return 1 .
      188     end.
      189     define variable v-rest as integer   no-undo .
      190     assign
      191       p-number = p-number modulo 100
      192     .
      193     if p-number < 20
      194     then do:
      195       assign
      196         v-rest = p-number
      197       .
      198     end.
      199     else do:
      200       assign
      201         v-rest = p-number modulo 10
      202       .
      203     end.
      204     case v-rest :
      205       when 1
      206       then do:
      207         return 2 .
      208       end.
      209       when 2 or
      210       when 3 or
      211       when 4
      212       then do:
      213         return 3 .
      214       end.
      215       otherwise do:
      216         return 1 .
      217       end.
      218     end case .
      219   end.
      220   procedure cur-time-mjd-to-date :
      221      define input  parameter i-mjd-diff as decimal no-undo.
      222      define output parameter o-Date     as date    no-undo.
      223      define output parameter o-Time     as integer no-undo.
      224      define variable v-day-number as integer   no-undo .
      225      if    i-mjd-diff < 0
      226         or i-mjd-diff = ?
      227      then do:
      228         return "?" .
      229      end.
      230      assign
      231         v-day-number = truncate(i-mjd-diff,0).
      232         o-Date = date(v-day-number + 2400002).
      233         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      234     .
      235   end.
      236   function cur-time-mjd-to-string returns character
      237   (input p-mjd-diff as decimal
      238   )
      239   :
      240     define variable v-day-number as integer   no-undo .
      241     define variable v-seconds    as integer   no-undo .
      242     define variable v-hour       as integer   no-undo .
      243     define variable v-min        as integer   no-undo .
      244     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      245     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      246     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      247     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      248     if p-mjd-diff < 0
      249     or p-mjd-diff = ?
      250     then do:
      251       return "?" .
      252     end.
      253     assign
      254       v-day-number = integer(truncate(p-mjd-diff,0))
      255       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      256     .
      257     if v-seconds > 86400
      258     then do:
      259       assign
      260         v-seconds = 86400 - 1
      261       .
      262     end.
      263     if v-seconds < 0
      264     then do:
      265       assign
      266         v-seconds = 0
      267       .
      268     end.
      269     assign
      270       v-hour = truncate(v-seconds / 3600, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 3600
      274     .
      275     assign
      276       v-min = truncate(v-seconds / 60, 0)
      277     .
      278     assign
      279       v-seconds = v-seconds modulo 60
      280     .
      281     return
      282         (if v-day-number <> 0
      283           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0
      287           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      288           else ""
      289         )
      290       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      291           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      292           else ""
      293         )
      294       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      295       .
      296   end.
      297   function cur-time-string returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      306   end.
      307   function cur-time-string-sec returns character
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      316   end.
      317   function cur-time-custom  returns character
      318   (input p-prefix as character
      319   ,input p-date-format as character
      320   ,input p-delimiter as character
      321   ,input p-time-format as character
      322   ,input p-suffix as character
      323   )
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return
      332       p-prefix
      333       + string(v-date, p-date-format)
      334       + p-delimiter
      335       + string(v-time, p-time-format)
      336       + p-suffix
      337       .
      338   end.
      339   function cur-time-print  returns character
      340   :
      341     define variable v-date as date      no-undo .
      342     define variable v-time as integer   no-undo .
      343     run cur-time in this-procedure
      344       (output v-date
      345       ,output v-time
      346       ) .
      347     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      348   end.
      349   function cur-time-datetime returns datetime
      350   :
      351     define variable v-char as character no-undo .
      352     define variable v-datetime as datetime no-undo .
      353     v-char = cur-time-string().
      354     v-datetime = datetime(v-char).
      355     return  v-datetime.
      356   end.
      357   function cur-time-string-msec returns character
      358   :
      359     define variable v-date as datetime  no-undo .
      360     v-date = now.
      361     return string(v-date) .
      362   end.
      363   define stream LogStream .
      364   define variable mNoTime as logical no-undo.
      365   procedure write-to-log-notime :
      366     define input param i-str as character no-undo .
      367     mNoTime = yes.
      368     run write-to-log (i-str).
      369     mNoTime = no.
      370   end.
      371   procedure write-to-log :
      372     define input param p-str as character no-undo .
      373     do
      374     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      375     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      376     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      377     :
      378       define variable log-res        as logical   no-undo .
      379       define variable v-jj           as integer   no-undo .
      380       if    mNoTime
      381          or writelogvalue eq "AsyncProc"
      382       then
      383          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      384       else
      385          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      386       if auto-log-msg-h <> ? then do:
      387         log-res = auto-log-msg-h:move-to-eof( ) .
      388         log-res = auto-log-msg-h:insert-string( p-str ).
      389       end.
      390       if hand-log-msg-h <> ? then do:
      391         log-res = hand-log-msg-h:move-to-eof( ) .
      392         log-res = hand-log-msg-h:insert-string( p-str ).
      393       end.
      394       assign
      395         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      396         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      397         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      398       .
      399       if add-log-file-name <> ? then do:
      400         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      401           run gbl/fileapnd.p
      402             ( input entry(v-jj, add-log-file-name, chr(1) )
      403             ,input p-str
      404             ,input 20
      405             ) no-error .
      406           if error-status:error then do:
      407             return error return-value .
      408           end.
      409         end.
      410       end.
      411       if writelogvalue eq "AsyncProc"
      412       then do:
      413          p-str = trim(p-str, (chr(13) + chr(10)) )
      414       .
      415          Publish "WriteLogAsunc" (p-str,yes).
      416       end.
      417       else if writelogvalue <> "yes" then do:
      418         run gbl/fileapnd.p
      419           ( input log-file-name
      420           ,input p-str
      421           ,input 20
      422           ) no-error .
      423         if error-status:error then do:
      424           return error return-value .
      425         end.
      426       end.
      427     end.
      428   end procedure.
      429   procedure write-to-screen :
      430     define input param p-str as character no-undo .
      431     do
      432     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      433     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      434     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      435     :
      436       define variable log-res as logical no-undo.
      437       assign
      438         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      439       .
      440       if auto-log-msg-h <> ?
      441       then do:
      442         log-res = auto-log-msg-h:move-to-eof( ) .
      443         log-res = auto-log-msg-h:insert-string( p-str ).
      444       end.
      445       if hand-log-msg-h <> ?
      446       then do:
      447         log-res = hand-log-msg-h:move-to-eof( ) .
      448         log-res = hand-log-msg-h:insert-string( p-str ).
      449       end.
      450     end.
      451   end procedure.
      452   procedure send-msg-to-email :
      453     define input  parameter p-subject      as character no-undo .
      454     define input  parameter p-text-err     as character no-undo .
      455     define input  parameter p-attach-files as character no-undo .
      456     do
      457     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      458     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      459     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      460     :
      461       define variable v-tth             as handle    no-undo .
      462       define variable v-value-character as character no-undo .
      463       define variable v-value-date      as date      no-undo .
      464       define variable v-value-decimal   as decimal   no-undo .
      465       define variable v-value-integer   as integer   no-undo .
      466       define variable v-value-logical   as logical   no-undo .
      467       define variable v-param-type      as character no-undo .
      468       define variable v-email       as character no-undo .
      469       define variable v-tmp-str     as character no-undo .
      470       define variable v-tmp1-str    as character no-undo .
      471       define variable v-ind         as integer   no-undo .
      472       define variable v-num-entries as integer   no-undo .
      473       delete object v-tth no-error.
      474       run adm/shattri.p
      475         ( input "get":U
      476          ,input  "":U
      477          ,input  0
      478          ,input  'auto-task':U
      479          ,input  'send-msg-to-email':U
      480          ,output v-value-character
      481          ,output v-value-date
      482          ,output v-value-decimal
      483          ,output v-value-integer
      484          ,output v-value-logical
      485          ,output v-param-type
      486          ,input-output table-handle v-tth
      487         ) no-error .
      488       if not error-status :error  then do:
      489         assign
      490           v-tmp-str = v-value-character
      491         .
      492       end.
      493       delete object v-tth no-error.
      494       assign
      495         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      496         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      497         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      498         v-num-entries = num-entries( v-tmp-str, chr(44) )
      499         v-email       = "":U
      500       .
      501       do v-ind = 1 to v-num-entries
      502       :
      503         assign
      504           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      505         .
      506         if trim( v-tmp1-str ) <> "":U then do:
      507           if v-email = "":U then do:
      508             assign
      509               v-email = v-tmp1-str
      510             .
      511           end.
      512           else do:
      513             assign
      514               v-email = v-email + chr(44) + v-tmp1-str
      515             .
      516           end.
      517         end.
      518       end.
      519       if v-email <> "":U then do:
      520         run gbl/sendmail.p
      521           ( input v-email
      522           , input p-subject
      523           , input p-text-err
      524           , input p-attach-files
      525           ) no-error .
      526         if error-status :error
      527           or return-value <> "":U
      528         then do:
      529           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      530         end.
      531       end.
      532     end.
      533   end procedure.
      534   define new global shared variable g#library  as handle no-undo .
      535   define new global shared variable g#library2 as handle no-undo .
      536   define   shared variable g#auto as logical no-undo.
