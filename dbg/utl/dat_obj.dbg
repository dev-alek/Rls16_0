        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: dat_obj.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/dat_obj.p $":U .
        7   define variable vss-description as character no-undo init "Создание списка дат на объектах БД".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define temp-table tt-obj-db no-undo
       67     field obj-type like ub.clients.obj-type
       68     field obj-code like ub.clients.obj-code
       69     field db-num   like ub.clients.db-num
       70   index pi is primary unique
       71     obj-type
       72     obj-code
       73   .
       74   define buffer buf_obj-date  for ub.obj-date.
       75   define buffer buf_clients   for ub.clients.
       76   define buffer buf_tt-obj-db for tt-obj-db.
       77   define variable v-list-file    as character    no-undo.
       78   define variable v-counter      as integer      no-undo.
       79   do
       80   on error undo, return error
       81   :
       82     assign
       83       v-counter = 0
       84     .
       85     output to "Date1.txt":U .
       86     empty temp-table buf_tt-obj-db.
       87     for each buf_obj-date no-lock
       88     :
       89       find first buf_tt-obj-db
       90         where buf_tt-obj-db.obj-type = buf_obj-date.obj-type
       91           and buf_tt-obj-db.obj-code = buf_obj-date.obj-code
       92       no-error.
       93       if not available buf_tt-obj-db
       94       then do:
       95         find first buf_clients no-lock
       96             where buf_clients.obj-type = buf_obj-date.obj-type
       97               and buf_clients.obj-code = buf_obj-date.obj-code
       98         no-error.
       99         if available buf_clients
      100         then do:
      101           create buf_tt-obj-db.
      102           assign
      103               buf_tt-obj-db.obj-type = buf_clients.obj-type
      104               buf_tt-obj-db.obj-code = buf_clients.obj-code
      105               buf_tt-obj-db.db-num   = buf_clients.db-num
      106           .
      107         end.
      108       end.
      109       display buf_obj-date with width 320 stream-io.
      110       assign
      111         v-counter = v-counter + 1
      112       .
      113     end.
      114     put unformatted skip(2) fill('=',200) skip.
      115     for each buf_tt-obj-db
      116     :
      117       display buf_tt-obj-db with width 320 stream-io.
      118     end.
      119     output close.
      120     empty temp-table buf_tt-obj-db.
      121     if v-counter = 0
      122     then do:
      123       message
      124         "Таблица дат на объекте пуста" skip
      125       view-as alert-box warning
      126       title "Даты на объектах".
      127     end.
      128     assign
      129       v-list-file = search( "Date1.txt":U )
      130     .
      131     if v-list-file = ?
      132     then do:
      133       message
      134         "Не удалось выгрузить список дат"
      135         skip "в файл " "Date1.txt":U
      136       view-as alert-box error
      137       title "Даты на объектах".
      138     end.
      139     else do:
      140       message
      141         "Cписок дат на объектах"
      142         skip "выгружен в файл "
      143         skip v-list-file
      144       view-as alert-box information
      145       title "Даты на объектах".
      146     end.
      147   end.
