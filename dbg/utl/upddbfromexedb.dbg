        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "обновление болванки".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input  parameter iLogHandel as handle no-undo.
       63   define input  parameter iConPar as character no-undo.
       64   define input  parameter iDFfile as character no-undo.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable mAsyncProc as class ibs.th.file.AsyncProc.
       70   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       71   define variable mstopAsunc as logical no-undo.
       72   function StopCheck returns logical:
       73      define variable oFlag as logical no-undo.
       74      run StopCheckAsync (output oFlag).
       75      return oFlag.
       76   end.
       77   procedure StopCheckAsync:
       78       define output  parameter oFlag as logical no-undo.
       79       if mstopAsunc
       80       then
       81          oFlag = mstopAsunc.
       82       else do:
       83          oFlag = mAsyncProc:CheckStop().
       84          mstopAsunc = oFlag.
       85       end.
       86   end.
       87   function GetParamAsunc returns character
       88   (input iNumPar as integer  ):
       89      return mAsyncProc:GetPARAM(iNumPar).
       90   end.
       91   function GetParamAsuncStr returns ibs.th.file.asyncparam
       92   (input iParamName as character ):
       93      return mAsyncProc:GetPARAM(iParamName).
       94   end.
       95   procedure PutMesAsunc:
       96       define input  parameter Itext as character no-undo.
       97       define variable vflag as logical no-undo.
       98       Publish "WriteLogAsunc" (Itext, yes)  .
       99   end.
      100   procedure PutMesAsuncNoTime:
      101       define input  parameter Itext as character no-undo.
      102       define variable vflag as logical no-undo.
      103       Publish "WriteLogAsunc" (Itext,no)  .
      104   end.
      105   procedure PutStatAsunc:
      106       define input  parameter Itext as character no-undo.
      107       Publish "PutStatAsunc" (Itext,no) .
      108        run
      109       PutMesAsunc (itext).
      110   end.
      111   procedure PutStatAsuncNoTime:
      112       define input  parameter Itext as character no-undo.
      113       Publish "PutStatAsunc" (Itext,no)  .
      114        run
      115       PutMesAsuncNoTime (itext).
      116   end.
      117   procedure PutStatAsuncAdd:
      118       define input  parameter Itext as character no-undo.
      119       Publish "PutStatAsunc" (Itext,yes)  .
      120   end.
      121   procedure PutFileLogAsunc:
      122       define input  parameter IFile as character no-undo.
      123       Publish "PutFileLogAsunc" (ifile)  .
      124   end.
      125          mAsyncProc:mProcPublish = this-procedure.
      126   run PutStatAsunc (substitute("Запущен процес обновления БД. " )).
      127   define variable updschmObj as class ibs.th.adm.upd.updschm no-undo.
      128   define variable mname     as character no-undo.
      129   define variable mpassword as character no-undo.
      130   updschmObj = new ibs.th.adm.upd.updschm (input iconpar,input "OneDf",this-procedure,iDFfile) no-error.
      131   if error-status:error
      132   then do:
      133      run PutStatAsunc (substitute("error   Не удалось обновить структуру БД. &1 &2 &3 ", error-status:get-message(1),  error-status:get-message(2 ),  program-name( 1 ) )).
      134   end.
      135   else if updschmObj:IsErr
      136   then do:
      137      run PutStatAsunc (substitute("error   Не удалось обновить структуру БД. &1 &2 ", updschmObj:Msg, program-name( 1 ) )).
      138      delete object updschmObj no-error.
      139   end.
      140   else if updschmObj:isNeedUpd
      141   then do:
      142      updschmObj:upddbshm().
      143      if updschmObj:IsErr
      144      then do:
      145         run PutStatAsunc (substitute("error Не удалось обновить структуру БД. &1", updschmObj:Msg )).
      146         delete object updschmObj no-error.
      147      end.
      148      else if updschmObj:isUpdShm
      149      then do:
      150         run PutStatAsunc (substitute("БД обновлена. " )).
      151      end.
      152      else do:
      153         run PutStatAsunc (substitute("error Ошика при обновлении БД. &1",updschmObj:Msg )).
      154      end.
      155   end.
      156   else do:
      157      if updschmObj:CurrDBShm > updschmObj:TargetDBShm
      158      then do:
      159         run PutStatAsunc (substitute("error Версия базы &1 больше версии в сборке &2 ",updschmObj:CurrDBShm , updschmObj:TargetDBShm)).
      160      end.
      161      else
      162         run PutStatAsunc (substitute("error Обновление не требуется.")).
      163   end.
