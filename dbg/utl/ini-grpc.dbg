        1   block-level on error undo, throw.
        2   define input parameter par-calc-method like ub.gds-grp.calc-method no-undo .
        3   define input parameter par-increase-pc like ub.gds-grp.increase-pc no-undo .
        4   define input parameter par-min like ub.gds-grp.increase-pc no-undo .
        5   define input parameter par-max like ub.gds-grp.increase-pc no-undo .
        6   define input parameter par-round-method as character no-undo .
        7   define input parameter par-base as decimal no-undo .
        8   define input parameter par-cli-type as character no-undo .
        9   define input parameter par-cli-code as integer no-undo .
       10   define input parameter par-fill-method as character no-undo .
       11   define input parameter par-groups as character no-undo .
       12   define input parameter par-values as character no-undo .
       13   define input parameter par-fields as integer no-undo .
       14   define input parameter par-region as integer no-undo .
       15   define input parameter par-rid-list as character no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       17   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       18   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile: ini-grpc.p $":U .
       20   define variable vss-archive     as character no-undo init "$Archive: utl/ini-grpc.p $":U .
       21   define variable vss-description as character no-undo init "Инициализация поля СПОСОБ РАСЧЕТА в gds-grp".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
