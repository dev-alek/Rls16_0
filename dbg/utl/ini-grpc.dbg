       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
       84   def var vl_bin as char no-undo init "".
       85   if vl_int < 0 OR vl_int = ? then return ?.
       86   do while vl_int > 0:
       87     assign
       88     vl_bin = (if vl_int modulo 2 = 0
       89                 then "0":U
       90                 else "1":U) + vl_bin
       91     vl_int = truncate(vl_int / 2,0).
       92   end.
       93   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
       94   END FUNCTION.
       95   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
       96                                    input vl_binm as character):
       97   DEFINE VARIABLE vl_bin as character no-undo.
       98   DEFINE VARIABLE ii as integer no-undo.
       99   DEFINE VARIABLE ii-len as integer no-undo.
      100   DEFINE VARIABLE ii-lenm as integer no-undo.
      101   DEFINE VARIABLE mchar as character no-undo.
      102   DEFINE VARIABLE ichar as character no-undo.
      103   if vl_binm = ? then return ?.
      104   vl_bin = CIntBinS(vl_int).
      105   if vl_bin = ? then return ?.
      106   assign
      107   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      108   ii-lenm = LENGTH(vl_binm)
      109   ii-len = LENGTH(vl_bin) - ii-lenm
      110   .
      111   if II-LENM > 32 THEN RETURN ?.
      112   DO II = 1 to II-LENm:
      113     assign
      114     mchar = SUBSTR(vl_binm, ii, 1)
      115     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      116     .
      117     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      118     IF ichar <> mchar AND mchar <> "X":U then return no.
      119   END.
      120   return yes.
      121   END FUNCTION.
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   procedure grp-obj-write :
      124   do
      125   on error undo, return error
      126   :
      127   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      128   define input parameter p-host-code  as integer                          no-undo.
      129   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      130   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      131   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      132   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      133   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      134   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      135   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      136   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      137   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      138   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      139   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      140       find first buf_gds-grp-obj exclusive-lock
      141            where buf_gds-grp-obj.node-code  = p-node-code
      142              and buf_gds-grp-obj.host-code  = p-host-code
      143              and buf_gds-grp-obj.obj-type   = p-obj-type
      144              and buf_gds-grp-obj.obj-code   = p-obj-code
      145       no-error.
      146       if not available buf_gds-grp-obj
      147       then do:
      148           create buf_gds-grp-obj.
      149           assign
      150                   buf_gds-grp-obj.node-code  = p-node-code
      151                   buf_gds-grp-obj.host-code  = p-host-code
      152                   buf_gds-grp-obj.obj-type   = p-obj-type
      153                   buf_gds-grp-obj.obj-code   = p-obj-code
      154           .
      155       end.
      156       assign
      157       buf_gds-grp-obj.min-increase = p-min-increase
      158       buf_gds-grp-obj.max-increase = p-max-increase
      159       buf_gds-grp-obj.increase-pc = p-increase-pc
      160       buf_gds-grp-obj.calc-method = p-calc-method
      161       buf_gds-grp-obj.round-method = p-round-method
      162       buf_gds-grp-obj.round-coef = p-round-coef
      163       buf_gds-grp-obj.cli-type   = p-cli-type
      164       buf_gds-grp-obj.cli-code   = p-cli-code
      165       .
      166   end.
      167   end procedure.
      168   procedure grp-obj-margin-value :
      169   do
      170   on error undo, return error
      171   :
      172   define input parameter p-node-code as integer      no-undo.
      173   define input parameter p-obj-type  as character    no-undo.
      174   define input parameter p-obj-code  as integer      no-undo.
      175   define output parameter p-min-value as decimal      no-undo init ?.
      176   define output parameter p-max-value as decimal      no-undo init ?.
      177   define output parameter p-increase-pc as decimal      no-undo init ?.
      178   define output parameter p-round-method as character no-undo init "":U.
      179   define output parameter p-base as decimal no-undo init ?.
      180   define output parameter p-range-margin     as integer      no-undo.
      181   define output parameter p-exists-margin    as logical      no-undo.
      182   define output parameter p-range-increase     as integer      no-undo.
      183   define output parameter p-exists-increase    as logical      no-undo.
      184   define output parameter p-range-rmethod     as integer no-undo .
      185   define output parameter p-exists-rmethod    as logical no-undo .
      186   define variable v-host-code as integer      no-undo.
      187   DEFINE VARIABLE v-found as logical no-undo .
      188   DEFINE VARIABLE v-exists as logical no-undo .
      189   DEFINE VARIABLE v-range as integer no-undo .
      190   DEFINE VARIABLE jj as integer no-undo .
      191   DEFINE VARIABLE v-margin-found as logical no-undo .
      192   DEFINE VARIABLE v-increase-found as logical no-undo .
      193   DEFINE VARIABLE v-min-value as decimal      no-undo.
      194   DEFINE VARIABLE v-max-value as decimal      no-undo.
      195   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      196   define variable v-round-method as character no-undo .
      197   define variable v-base as decimal no-undo .
      198   define variable v-print-code as character no-undo .
      199   define buffer buf_gds-grp for ub.gds-grp.
      200   find first buf_gds-grp no-lock where
      201              buf_gds-grp.node-code = p-node-code no-error .
      202   if not avail buf_gds-grp and p-node-code <> 0 then do:
      203     message
      204       vss-workfile vss-revision vss-description
      205       skip "Не удалось найти группу товаров с кодом" p-node-code
      206       view-as alert-box error .
      207     undo, return error .
      208   end.
      209   if p-obj-type <> '' then do:
      210   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      212     (input  p-obj-type
      213     ,input  p-obj-code
      214     ,output v-host-code
      215     ) no-error .
      216     if error-status :error
      217     then do:
      218         message
      219           vss-workfile vss-revision vss-description
      220           skip "Не удалось найти фирму объекта"
      221           skip p-obj-type p-obj-code
      222           skip return-value
      223           skip trim(error-status :get-message(1))
      224               trim(error-status :get-message(2))
      225               trim(error-status :get-message(3))
      226               trim(error-status :get-message(4))
      227               trim(error-status :get-message(5))
      228         view-as alert-box error.
      229         undo, return error .
      230     end.
      231   end.
      232   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      233   do while v-found = no and jj < 2:
      234     if v-range <> 3 then do:
      235       find first buf_gds-grp-obj no-lock
      236           where buf_gds-grp-obj.node-code = p-node-code
      237             and buf_gds-grp-obj.host-code = v-host-code
      238             and buf_gds-grp-obj.obj-type  = p-obj-type
      239             and buf_gds-grp-obj.obj-code  = p-obj-code
      240       no-error .
      241     end.
      242     if v-range = 3 or not available buf_gds-grp-obj
      243     then do:
      244        if v-range <> 2 then do:
      245           find first buf_gds-grp-obj no-lock
      246               where buf_gds-grp-obj.node-code = p-node-code
      247                 and buf_gds-grp-obj.host-code = v-host-code
      248                 and buf_gds-grp-obj.obj-type  = ""
      249                 and buf_gds-grp-obj.obj-code  = 0
      250           no-error .
      251         end.
      252         if v-range = 2 or not available buf_gds-grp-obj
      253         then do:
      254             if v-range <> 1 then do:
      255               find first buf_gds-grp-obj no-lock
      256                   where buf_gds-grp-obj.node-code = p-node-code
      257                   and buf_gds-grp-obj.host-code = 0
      258                   and buf_gds-grp-obj.obj-type  = ""
      259                   and buf_gds-grp-obj.obj-code  = 0
      260               no-error .
      261             end.
      262             if v-range = 1 or not available buf_gds-grp-obj
      263             then do:
      264                 assign
      265                     v-exists = no
      266                 .
      267             end.
      268             else do:
      269                 assign
      270                     v-exists = yes
      271                     v-range = 1
      272                 .
      273             end.
      274         end.
      275         else do:
      276             assign
      277                 v-exists = yes
      278                 v-range  = 2
      279             .
      280         end.
      281     end.
      282     else do:
      283         assign
      284             v-exists = yes
      285             v-range  = 3
      286         .
      287     end.
      288     if available buf_gds-grp-obj
      289     then do:
      290       assign
      291       v-min-value    = buf_gds-grp-obj.min-increase
      292       v-max-value    = buf_gds-grp-obj.max-increase
      293       v-increase-pc  = buf_gds-grp-obj.increase-pc
      294       v-round-method = buf_gds-grp-obj.round-method
      295       v-base         = buf_gds-grp-obj.round-coef
      296       .
      297       assign
      298       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      299                           then yes
      300                           else p-exists-margin)
      301       p-range-margin = if p-exists-margin and p-min-value = ?
      302                         then v-range
      303                         else p-range-margin
      304       p-min-value   =  if p-exists-margin and  p-min-value = ?
      305                         then v-min-value
      306                         else p-min-value
      307       p-max-value   =  if p-exists-margin and  p-max-value = ?
      308                         then v-max-value
      309                         else p-max-value
      310       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      311                           then yes
      312                           else p-exists-increase)
      313       p-range-increase = if p-exists-increase and p-increase-pc = ?
      314                         then v-range
      315                         else p-range-increase
      316       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      317                         then v-increase-pc
      318                         else p-increase-pc)
      319       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      320                           then yes
      321                           else p-exists-rmethod
      322       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      323                           then v-range
      324                           else p-range-rmethod)
      325       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      326                           then v-round-method
      327                           else p-round-method)
      328       p-base          = (if p-exists-rmethod and p-base = ?
      329                           then v-base
      330                           else p-base)
      331       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      332       jj = jj + 1
      333       .
      334     end.
      335     else do:
      336       assign
      337       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      338       jj = jj + 1
      339       .
      340     end.
      341   end.
      342   end.
      343   end procedure.
      344   procedure grp-obj-income-cli-value :
      345   do
      346   on error undo, return error
      347   :
      348   define input parameter p-node-code as integer      no-undo.
      349   define input parameter p-obj-type  as character    no-undo.
      350   define input parameter p-obj-code  as integer      no-undo.
      351   define output parameter p-cli-type as character    no-undo init ?.
      352   define output parameter p-cli-code as integer      no-undo init ?.
      353   define output parameter p-range-income-cli     as integer      no-undo.
      354   define output parameter p-exists-income-cli    as logical      no-undo.
      355   define variable v-host-code as integer      no-undo.
      356   DEFINE VARIABLE v-found as logical no-undo .
      357   DEFINE VARIABLE v-exists as logical no-undo .
      358   DEFINE VARIABLE v-range as integer no-undo .
      359   DEFINE VARIABLE jj as integer no-undo .
      360   DEFINE VARIABLE v-income-cli-found as logical no-undo .
      361   DEFINE VARIABLE v-cli-type-value as char      no-undo.
      362   DEFINE VARIABLE v-cli-code-value as int      no-undo.
      363   define buffer buf_gds-grp for ub.gds-grp.
      364   find first buf_gds-grp no-lock where
      365              buf_gds-grp.node-code = p-node-code no-error .
      366   if not avail buf_gds-grp and p-node-code <> 0 then do:
      367     message
      368       vss-workfile vss-revision vss-description
      369       skip "Не удалось найти группу товаров с кодом" p-node-code
      370       view-as alert-box error .
      371     undo, return error .
      372   end.
      373   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      375     (input  p-obj-type
      376     ,input  p-obj-code
      377     ,output v-host-code
      378     ) no-error .
      379   if error-status :error
      380   then do:
      381       message
      382         vss-workfile vss-revision vss-description
      383         skip "Не удалось найти фирму объекта"
      384         skip p-obj-type p-obj-code
      385         skip return-value
      386         skip trim(error-status :get-message(1))
      387              trim(error-status :get-message(2))
      388              trim(error-status :get-message(3))
      389              trim(error-status :get-message(4))
      390              trim(error-status :get-message(5))
      391       view-as alert-box error.
      392       undo, return error .
      393   end.
      394   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      395   do while v-found = no and jj < 2:
      396     if v-range <> 3 then do:
      397       find first buf_gds-grp-obj no-lock
      398           where buf_gds-grp-obj.node-code = p-node-code
      399             and buf_gds-grp-obj.host-code = v-host-code
      400             and buf_gds-grp-obj.obj-type  = p-obj-type
      401             and buf_gds-grp-obj.obj-code  = p-obj-code
      402       no-error .
      403     end.
      404     if v-range = 3 or not available buf_gds-grp-obj
      405     then do:
      406        if v-range <> 2 then do:
      407           find first buf_gds-grp-obj no-lock
      408               where buf_gds-grp-obj.node-code = p-node-code
      409                 and buf_gds-grp-obj.host-code = v-host-code
      410                 and buf_gds-grp-obj.obj-type  = ""
      411                 and buf_gds-grp-obj.obj-code  = 0
      412           no-error .
      413         end.
      414         if v-range = 2 or not available buf_gds-grp-obj
      415         then do:
      416             if v-range <> 1 then do:
      417               find first buf_gds-grp-obj no-lock
      418                   where buf_gds-grp-obj.node-code = p-node-code
      419                   and buf_gds-grp-obj.host-code = 0
      420                   and buf_gds-grp-obj.obj-type  = ""
      421                   and buf_gds-grp-obj.obj-code  = 0
      422               no-error .
      423             end.
      424             if v-range = 1 or not available buf_gds-grp-obj
      425             then do:
      426                 assign
      427                     v-exists = no
      428                 .
      429             end.
      430             else do:
      431                 assign
      432                     v-exists = yes
      433                     v-range = 1
      434                 .
      435             end.
      436         end.
      437         else do:
      438             assign
      439                 v-exists = yes
      440                 v-range  = 2
      441             .
      442         end.
      443     end.
      444     else do:
      445         assign
      446             v-exists = yes
      447             v-range  = 3
      448         .
      449     end.
      450     if available buf_gds-grp-obj
      451     then do:
      452       assign
      453       v-cli-type-value    = buf_gds-grp-obj.cli-type
      454       v-cli-code-value    = buf_gds-grp-obj.cli-code
      455       .
      456       assign
      457       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
      458                           then yes
      459                           else p-exists-income-cli)
      460       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
      461                         then v-range
      462                         else p-range-income-cli
      463       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
      464                         then v-cli-type-value
      465                         else p-cli-type
      466       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
      467                         then v-cli-code-value
      468                         else p-cli-code
      469       v-found =  (p-exists-income-cli ) or (v-range <= 1)
      470       jj = jj + 1
      471       .
      472     end.
      473     else do:
      474       assign
      475       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
      476       jj = jj + 1
      477       .
      478     end.
      479   end.
      480   end.
      481   end procedure.
      482   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      483   define variable v-waitfram-action01         as character   no-undo .
      484   define variable v-waitfram-action02         as character   no-undo .
      485   define variable v-waitfram-action03         as character   no-undo .
      486   define variable mWaitFramTextBeg            as character   no-undo.
      487   define variable mWaitFramTextEnd            as character   no-undo.
      488   define variable mWaitFramView               as logical     no-undo.
      489   define variable mWaitProcEvent              as logical     no-undo init yes.
      490   define variable mWaitFramInterval           as integer     no-undo init 1 .
      491   define variable mWaitFramStop               as logical     no-undo.
      492   define variable mWaitFramStopUser           as logical     no-undo.
      493   define variable mWaitFramStopTimeOut        as logical     no-undo.
      494   define variable mWaitFramStartProc          as datetime-tz no-undo.
      495   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      496   define button B-WaitFramStop auto-end-key
      497        label "Стоп"
      498        size 10 by 1 tooltip "Остоновить процесс".
      499   define button B-viewProcInfo
      500        label "Информация"
      501        size 15 by 1 tooltip "Информация о процесс".
      502   define frame waitfram
      503     v-waitfram-action01 format "x(72)" no-label skip
      504     v-waitfram-action02 format "x(72)" no-label skip
      505     v-waitfram-action03 format "x(72)" no-label skip
      506     B-viewProcInfo
      507     B-WaitFramStop at row 4 col 30
      508     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      509     .
      510   define new global shared variable mBatchMode as logical no-undo init ?.
      511   define variable mFramBachModHandle as handle no-undo.
      512   mFramBachModHandle = frame waitfram:handle.
      513   define variable mFameOldVis as logical no-undo.
      514   define variable mVisCUrentVin as logical no-undo.
      515   if session:batch-mode
      516   then
      517      mBatchMode = yes.
      518   if mBatchMode = ? then do:
      519     mVisCUrentVin = current-window:visible.
      520     mFameOldVis = mFramBachModHandle:visible.
      521     mFramBachModHandle:visible  = yes.
      522     mBatchMode = mFramBachModHandle:visible ne yes.
      523     mFramBachModHandle:visible = mFameOldVis.
      524     current-window:visible = mVisCUrentVin.
      525   end.
      526    if  log-manager:logfile-name ne ?
      527     then DO:
      528         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      529         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      530         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      531     end.
      532   on choose of B-WaitFramStop in frame waitfram
      533   do:
      534     mWaitFramStop = yes.
      535     mWaitFramStopUser = yes.
      536   end.
      537   function waitfram-check-timeout returns logical():
      538      define variable vtime as int64 no-undo.
      539      if mWaitFramStopTimeOut
      540      then
      541         return yes.
      542      vtime = ( now - mWaitFramStartProc ) / 1000 .
      543      if     mWaitFramTimeOut ne ?
      544         and mWaitFramTimeOut ne 0
      545         and mWaitFramTimeOut lt vtime
      546      then do:
      547         mWaitFramStopTimeOut = yes.
      548      end.
      549      return mWaitFramStopTimeOut.
      550   end.
      551   procedure waitfram-hide :
      552     if not session:batch-mode
      553     then do
      554     on error undo, return error return-value
      555     :
      556       pause 0 before-hide .
      557       if not mBatchMode then
      558         hide frame waitfram .
      559     if     not mWaitFramView
      560        and mWaitProcEvent
      561     then
      562       process events .
      563     end.
      564   end procedure.
      565   procedure waitfram-show :
      566     define input  parameter p-message as character no-undo .
      567     define variable v-left-margin as integer   no-undo .
      568     if not session:batch-mode
      569     then do
      570     on error undo, return error return-value
      571     :
      572       if length(p-message) <= 70 then do:
      573         assign
      574           v-left-margin = integer((70 - length(p-message)) / 2)
      575         .
      576         assign
      577           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      578         .
      579         assign
      580           v-waitfram-action01 = " "
      581           v-waitfram-action02 = " "
      582                                    + fill(" ", v-left-margin)
      583                                    + p-message
      584           v-waitfram-action03 = " "
      585         .
      586       end.
      587       else do:
      588         define variable vRindex1 as integer no-undo.
      589         define variable vRindex2 as integer no-undo.
      590         vRindex1 = r-index(p-message," ",70).
      591         if vRindex1 = 0
      592         then
      593            vRindex1 = 70.
      594         if length(p-message)  <= vRindex1 + 70 then do:
      595           assign
      596             v-waitfram-action01 = " "
      597             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      598             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      599           .
      600         end.
      601         else do:
      602           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      603           if vRindex2 <= vRindex1
      604           then
      605              vRindex2 = vRindex1 + 70.
      606           assign
      607             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      608             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      609             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      610           .
      611         end.
      612       end.
      613       B-viewProcInfo:visible   in frame waitfram = no.
      614       B-viewProcInfo:sensitive in frame waitfram = no.
      615       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      616       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      617       if  (   mWaitFramView
      618          or  mWaitProcEvent)
      619          and not mBatchMode
      620       then
      621          display
      622             v-waitfram-action01 skip
      623             v-waitfram-action02 skip
      624             v-waitfram-action03 skip
      625          with frame waitfram .
      626       if     mWaitFramView
      627          then do:
      628             if     mWaitFramInterval ne ?
      629                and not mBatchMode
      630             then
      631                wait-for go of frame waitfram pause mWaitFramInterval.
      632          end.
      633          else
      634             if     mWaitProcEvent
      635                and not mBatchMode
      636             then
      637                process events .
      638     end.
      639   end procedure.
      640      procedure waitfram-show-this:
      641         define input  parameter iInterval as int64 no-undo.
      642         define variable vtime as int64 no-undo.
      643         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      644         mWaitFramInterval = iInterval.
      645         run waitfram-show (substitute("&1&2 &3&4" ,
      646                                       mWaitFramTextBeg ,
      647                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      648                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      649                                       mWaitFramTextEnd
      650                                      )
      651                           ).
      652      end.
      653      procedure WaitFramRunPause:
      654         define input  parameter iInterval as dec no-undo.
      655         define variable vStart  as datetime-tz no-undo.
      656         define variable vend    as datetime-tz no-undo.
      657         define variable vint as int64 no-undo.
      658         define variable vOk as logical no-undo.
      659         vStart = now.
      660         vend   = vStart.
      661         publish "WaitFramPause" (iInterval,output vOk).
      662         vend   =  now.
      663         vint = vend - vStart.
      664         vint = iInterval - vint / 1000.
      665         if     not mWaitFramStop
      666            and (   vint > 0
      667                 or (    not vOk
      668                     and iInterval eq ?
      669                     )
      670                 )
      671         then
      672            run waitfram-show-this (iInterval).
      673         vend   =  now.
      674         vint = vend - vStart.
      675         vint = iInterval - vint / 1000.
      676         if     not mWaitFramStop
      677            and vint > 0
      678         then do:
      679            run gbl/pause.p (vint * 1000).
      680         end.
      681         if iInterval ne ?
      682         then
      683            publish "WaitFramStop".
      684         waitfram-check-timeout().
      685      end.
      686      procedure WaitFramWaitFor:
      687         define input  parameter iInterval as dec no-undo.
      688         assign
      689            mWaitFramStartProc   = now
      690            mWaitFramStopUser    = no
      691            mWaitFramStopTimeOut = no
      692         .
      693         block-wait:
      694         do while not mWaitFramStop:
      695            run WaitFramRunPause (iInterval).
      696            if  waitfram-check-timeout()
      697            then do:
      698               leave block-wait.
      699            end.
      700         end.
      701         run waitfram-hide.
      702      end.
      703   procedure waitfram-join :
      704     define input  parameter p-line-1  as character no-undo .
      705     define input  parameter p-line-2  as character no-undo .
      706     define input  parameter p-line-3  as character no-undo .
      707     define output parameter p-message as character no-undo .
      708     do
      709     on error undo, return error return-value
      710     :
      711       assign
      712         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      713                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      714                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      715       .
      716     end.
      717   end procedure.
      718   function waitfram-join-function returns character
      719     (input p-line-1 as character
      720     ,input p-line-2 as character
      721     ,input p-line-3 as character
      722     ).
      723     define variable v-message as character no-undo .
      724     run waitfram-join in this-procedure
      725       (input  p-line-1
      726       ,input  p-line-2
      727       ,input  p-line-3
      728       ,output v-message
      729       ) .
      730     return v-message .
      731   end function .
      732   DEFINE VARIABLE ii as integer no-undo .
      733   DEFINE VARIABLE jj as integer no-undo .
      734   define variable kk as integer no-undo .
      735   define variable v-process as logical no-undo .
      736   define variable v-contin as logical no-undo .
      737   define variable v-lvl-num as integer no-undo .
      738   define variable v-node-code like ub.gds-grp.node-code no-undo .
      739   define variable glog as logical no-undo .
      740   define variable v-curr-db-num like ub.db.db-num no-undo .
      741   define buffer upper_gds-grp for ub.gds-grp.
      742   glog = no.
      743   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      745     (output v-curr-db-num
      746     )  .
      747   if BinMask(par-fields, "XXXX1":U) then do:
      748     if par-values = "default":U AND
      749       (par-calc-method = ? or
      750       par-calc-method = "":U or
      751       lookup(par-calc-method, 'Учетная,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U) = 0) then do:
      752         message
      753         vss-workfile vss-revision vss-description skip
      754         "Неверное значение параметра" par-calc-method
      755         view-as alert-box .
      756         return error .
      757     end.
      758   end.
      759   if BinMask(par-fields, "XX1XX":U) then do:
      760     if par-values = "default":U AND
      761       (par-round-method = ? or
      762       par-round-method = "":U or
      763       lookup(par-round-method, '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U) = 0) then do:
      764         message
      765         vss-workfile vss-revision vss-description skip
      766         "Неверное значение параметра" par-round-method
      767         view-as alert-box .
      768         return error .
      769     end.
      770     if par-values = "default":U AND
      771     lookup(par-round-method,  ('Произвольно,Вверх,Коэффициент,9-99окончание':U)) > 0 and
      772     par-base = 0 then do:
      773       message
      774       vss-workfile vss-revision vss-description skip
      775       "Неверное значение коэффициента 0 для метода округления" par-round-method
      776       view-as alert-box error .
      777       return error .
      778     end.
      779   end.
      780   if v-curr-db-num <> 0 then do:
      781     message vss-workfile vss-revision vss-description skip
      782     "Утилиту можно запустить только в ГБД"
      783     view-as alert-box error .
      784     return error .
      785   end.
      786   message
      787   "Инициализация полей СПОСОБ РАСЧЕТА,НАЦЕНКА,ДИАПАЗОНЫ НАЦЕНКИ,МЕТОД ОКРУГЛЕНИЯ в ГРУППАХ ТОВАРОВ ?   Вы уверены ?"
      788   view-as alert-box question buttons OK-Cancel update glog.
      789   if glog <> true then return.
      790   message
      791   "Внимание !  Если работа утилиты закончится ненормально"
      792   "(нормально - это сообщение о завершении - все записи успешно обработаны)," skip
      793   "запустите ее сразу же повторно !"
      794   view-as alert-box .
      795   CASE par-values:
      796     when "default":U then do:
      797       _group:
      798       for each ub.gds-grp
      799       on error undo, next:
      800         CASE par-groups:
      801           when "select":U then do:
      802              if lookup(string(recid(ub.gds-grp)), par-rid-list) = 0 then NEXT _group.
      803           end.
      804           when "select-tree" then do:
      805             assign
      806             v-contin = yes
      807             v-node-code = ub.gds-grp.node-code
      808             .
      809             do while v-contin:
      810               run tree-up in this-procedure (input-output v-node-code, output v-contin, output v-process).
      811             end.
      812             if not v-process then NEXT _group.
      813           end.
      814         END CASE.
      815         ii = ii + 1.
      816         run proc-assign in this-procedure
      817                         (buffer ub.gds-grp,
      818                         0,
      819                         "":U,
      820                         0,
      821                         par-calc-method,
      822                         par-increase-pc,
      823                         par-min,
      824                         par-max,
      825                         par-round-method,
      826                         par-base,
      827                         par-cli-type ,
      828                         par-cli-code
      829                           ) no-error .
      830         if not error-status:error and return-value <> "error":U then
      831         jj = jj + 1.
      832         run waitfram-show in this-procedure ("Обработано" + chr(32) +
      833                        string(ii) + chr(32) +
      834                        "записей - успешно" + chr(32) +
      835                        string(jj)).
      836       END.
      837     end.
      838     when "group":U then do:
      839       CASE par-groups:
      840         when "all":U or when "select-tree":U then do:
      841           find first upper_gds-grp No-LOCK where upper_gds-grp.upper-code = 0.
      842           assign
      843           v-lvl-num = upper_gds-grp.lvl-num
      844           v-node-code= upper_gds-grp.node-code
      845           .
      846           do while available upper_gds-grp:
      847             if upper_gds-grp.upper-code <> 0 then
      848             run ini-tree in this-procedure
      849                             (
      850                             input upper_gds-grp.node-code
      851                             ,input (upper_gds-grp.lvl-num + 1)
      852                             ,input upper_gds-grp.calc-method
      853                             ,input upper_gds-grp.increase-pc
      854                         ).
      855             find first upper_gds-grp NO-LOCK where
      856                        upper_gds-grp.lvl-num = v-lvl-num
      857                    AND upper_gds-grp.node-code > v-node-code no-error .
      858             if not avail upper_gds-grp then do:
      859               assign
      860               v-lvl-num = v-lvl-num + 1
      861               v-node-code = 0
      862               .
      863             end.
      864             find first upper_gds-grp NO-LOCK where
      865                        upper_gds-grp.lvl-num = v-lvl-num
      866                    AND upper_gds-grp.node-code > v-node-code no-error .
      867             if avail upper_gds-grp then do:
      868               assign
      869               v-lvl-num = upper_gds-grp.lvl-num
      870               v-node-code = upper_gds-grp.node-code
      871               .
      872             end.
      873           end.
      874         end.
      875         when "select":U then do:
      876           do kk = 1 to num-entries(par-rid-list):
      877             find first ub.gds-grp where
      878                       recid(ub.gds-grp) = integer(entry(kk, par-rid-list)) no-error .
      879             if avail ub.gds-grp then do:
      880               find first upper_gds-grp where
      881                          upper_gds-grp.node-code = ub.gds-grp.upper-code no-error .
      882                if avail upper_gds-grp then
      883                 run ini-tree  in this-procedure
      884                               (
      885                               input upper_gds-grp.node-code
      886                               ,input (upper_gds-grp.lvl-num + 1)
      887                               ,input upper_gds-grp.calc-method
      888                               ,input upper_gds-grp.increase-pc
      889                           ).
      890             end.
      891           end.
      892         end.
      893       END CASE.
      894     end.
      895   END CASE.
      896   run waitfram-hide in this-procedure .
      897   message
      898   "Работа утилиты завершена" skip
      899   "Обработано" ii "записей"  skip
      900   "успешно" jj
      901   view-as alert-box .
      902   procedure proc-assign :
      903   define parameter buffer buf_gds-grp for ub.gds-grp.
      904   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      905   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      906   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      907   define input parameter p-calc-method like ub.gds-grp.calc-method no-undo .
      908   define input parameter p-increase-pc like ub.gds-grp.increase-pc no-undo .
      909   define input parameter p-min like ub.gds-grp.increase-pc no-undo .
      910   define input parameter p-max like ub.gds-grp.increase-pc no-undo .
      911   define input parameter p-round-method as character no-undo .
      912   define input parameter p-base as decimal no-undo .
      913   define input parameter p-cli-type like ub.clients.obj-type no-undo .
      914   define input parameter p-cli-code like ub.clients.obj-code no-undo .
      915   define variable v-value as character no-undo .
      916   define variable v-type as character no-undo .
      917   define variable v-max as decimal no-undo init ?.
      918   define variable v-min as decimal no-undo init ?.
      919   define variable v-incr as decimal no-undo init ? .
      920   define variable v-round-method as character no-undo init ?.
      921   define variable v-base as decimal no-undo init ?.
      922   define variable v-rid as recid no-undo .
      923   define variable v-calc-method as character no-undo .
      924   define variable v-increase-pc as decimal no-undo .
      925   define variable v-cli-type as character no-undo .
      926   define variable v-cli-code as integer no-undo .
      927   define variable x_max as decimal no-undo init ?.
      928   define variable x_min as decimal no-undo init ?.
      929   define variable x_incr as decimal no-undo init ? .
      930   define variable x_round-method as character no-undo init ?.
      931   define variable x_base as decimal no-undo init ?.
      932   define variable x_rid as recid no-undo .
      933   define variable x_calc-method as character no-undo .
      934   define variable x_increase-pc as decimal no-undo .
      935   define variable x_cli-type as character no-undo .
      936   define variable x_cli-code as integer no-undo .
      937   define variable v-delim as character no-undo .
      938   define variable v-entry as character no-undo extent 4.
      939   define variable ll as integer no-undo .
      940   define variable v-error as logical no-undo .
      941   define variable var-fill-method as character no-undo .
      942   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      943   define buffer buf_root_gds-grp-obj for ub.gds-grp-obj.
      944     do
      945     on error undo, return error
      946     :
      947       assign
      948       var-fill-method = par-fill-method
      949       .
      950       find first buf_root_gds-grp-obj no-lock where
      951                  buf_root_gds-grp-obj.node-code = buf_gds-grp.node-code
      952              AND buf_root_gds-grp-obj.host-code = 0
      953              AND buf_root_gds-grp-obj.obj-type = "":U
      954              AND buf_root_gds-grp-obj.obj-code = 0 no-error .
      955       if available buf_root_gds-grp-obj then do:
      956         assign
      957         v-min           = buf_root_gds-grp-obj.min-increase
      958         v-max           = buf_root_gds-grp-obj.max-increase
      959         v-incr          = buf_root_gds-grp-obj.increase-pc
      960         v-round-method  = buf_root_gds-grp-obj.round-method
      961         v-base          = buf_root_gds-grp-obj.round-coef
      962         v-cli-type      = buf_root_gds-grp-obj.cli-type
      963         v-cli-code      = buf_root_gds-grp-obj.cli-code
      964         .
      965         assign
      966         v-calc-method = buf_gds-grp.calc-method
      967         v-increase-pc = buf_gds-grp.increase-pc
      968         .
      969         assign
      970         x_cli-type     = if BinMask(par-fields, "1XXXX":U) then p-cli-type else v-cli-type
      971         x_cli-code     = if BinMask(par-fields, "1XXXX":U) then p-cli-code else v-cli-code
      972         x_min          = if BinMask(par-fields, "X1XXX":U) then p-Min else v-min
      973         x_max          = if BinMask(par-fields, "X1XXX":U) then p-Max else v-max
      974         x_incr         = if BinMask(par-fields, "XXX1X":U) then p-increase-pc else v-incr
      975         x_round-method = if BinMask(par-fields, "XX1XX":U) then p-round-method else v-round-method
      976         x_base         = if BinMask(par-fields, "XX1XX":U) then p-base else v-base
      977         x_calc-method  = if BinMask(par-fields, "XXXX1":U) then p-calc-method else v-calc-method
      978         x_increase-pc  = if BinMask(par-fields, "XXX1X":U) then p-increase-pc else v-increase-pc
      979         .
      980       end.
      981       else do:
      982         assign
      983         x_cli-type     = p-cli-type
      984         x_cli-code     = p-cli-code
      985         x_min          = p-Min
      986         x_max          = p-Max
      987         x_incr         = p-increase-pc
      988         x_round-method = p-round-method
      989         x_base         = p-base
      990         x_calc-method  = p-calc-method
      991         x_increase-pc  = p-increase-pc
      992         var-fill-method = "space"
      993         .
      994       end.
      995       CASE var-fill-method:
      996         when "all":U then do:
      997         end.
      998         when "error-or-space":U then do:
      999           assign
     1000           x_cli-type     = if v-cli-type = ?
     1001                            or v-entry[1] = "":U
     1002                            then p-cli-type
     1003                            else v-cli-type
     1004           x_cli-code     = if v-cli-code = ?
     1005                            or v-entry[2] = "":U
     1006                            then p-cli-code
     1007                            else v-cli-code
     1008           x_min          = if v-min = ?
     1009                            or v-entry[1] = "":U
     1010                            then p-Min
     1011                            else v-min
     1012           x_max          = if v-max = ?
     1013                            or v-entry[2] = "":U
     1014                            then p-Max
     1015                            else v-max
     1016           x_increase-pc  = if v-incr = ?
     1017                            or v-entry[3] = "":U
     1018                            or v-incr <> v-increase-pc
     1019                            or v-increase-pc = ?
     1020                            then p-increase-pc
     1021                            else v-incr
     1022           x_round-method = if v-round-method = "":U
     1023                            or v-round-method = ?
     1024                            or lookup(v-round-method, '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U) = 0
     1025                            then p-round-method
     1026                            else v-round-method
     1027           x_base         = if v-base = ?
     1028                            or (lookup(v-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 and v-base = 0)
     1029                            then p-base
     1030                            else v-base
     1031           x_calc-method  = if v-calc-method = "":U
     1032                            or v-calc-method = ?
     1033                            or lookup(v-calc-method, 'Учетная,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U) = 0
     1034                            then p-calc-method
     1035                            else v-calc-method
     1036           .
     1037         end.
     1038         when "error":U then do:
     1039           assign
     1040           x_min          = if v-min = ?
     1041                            then p-Min
     1042                            else v-min
     1043           x_max          = if v-max = ?
     1044                            then p-Max
     1045                            else v-max
     1046           x_cli-type     = if v-cli-type = ?
     1047                            then p-cli-type
     1048                            else v-cli-type
     1049           x_cli-code     = if v-cli-code = ?
     1050                            then p-cli-code
     1051                            else v-cli-code
     1052           x_increase-pc  = if v-incr = ?
     1053                            or v-incr <> v-increase-pc
     1054                            or v-increase-pc = ?
     1055                            then p-increase-pc
     1056                            else v-incr
     1057           x_round-method = if v-round-method = ?
     1058                            or lookup(v-round-method, '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U) = 0
     1059                            then p-round-method
     1060                            else v-round-method
     1061           x_base         = if v-base = ?
     1062                            or (lookup(v-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 and v-base = 0)
     1063                            then p-base
     1064                            else v-base
     1065           x_calc-method  = if v-calc-method  = ?
     1066                            or lookup(v-calc-method, 'Учетная,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U) = 0
     1067                            then p-calc-method
     1068                            else v-calc-method
     1069           .
     1070         end.
     1071         when "space":U then do:
     1072           assign
     1073           x_min          = if v-entry[1] = "":U
     1074                            then p-Min
     1075                            else v-min
     1076           x_max          = if v-entry[2] = "":U
     1077                            then p-Max
     1078                            else v-max
     1079           x_cli-type     = if v-entry[1] = "":U
     1080                            then p-cli-type
     1081                            else v-cli-type
     1082           x_cli-code     = if v-entry[2] = "":U
     1083                            then p-cli-code
     1084                            else v-cli-code
     1085           x_increase-pc  = if v-entry[3] = "":U
     1086                            then p-increase-pc
     1087                            else v-incr
     1088           x_round-method = if v-round-method = "":U
     1089                            then p-round-method
     1090                            else v-round-method
     1091           x_base         = if v-round-method = "":U
     1092                            then p-base
     1093                            else v-base
     1094           x_calc-method  = if v-calc-method = "":U
     1095                            then p-calc-method
     1096                            else v-calc-method
     1097           .
     1098         end.
     1099       END CASE.
     1100       assign
     1101       v-error = if x_min = ? and BinMask(par-fields, "X1XXX":U)
     1102                 then yes
     1103                 else v-error
     1104       v-error = if x_max = ? and BinMask(par-fields, "X1XXX":U)
     1105                 then yes
     1106                 else v-error
     1107       v-error = if x_cli-type = ? and BinMask(par-fields, "1XXXX":U)
     1108                 then yes
     1109                 else v-error
     1110       v-error = if x_cli-code = ? and BinMask(par-fields, "1XXXX":U)
     1111                 then yes
     1112                 else v-error
     1113       v-error = if x_incr = ? and BinMask(par-fields, "XXX1X":U)
     1114                 then yes
     1115                 else v-error
     1116       v-error = if (x_round-method = ?
     1117                 or lookup(x_round-method, '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U) = 0)
     1118                 and BinMask(par-fields, "XX1XX":U)
     1119                 then yes
     1120                 else v-error
     1121       v-error = if (x_base = ?
     1122                 or (lookup(x_round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 and x_base = 0)
     1123                 )
     1124                 and BinMask(par-fields, "XX1XX":U)
     1125                 then yes
     1126                 else v-error
     1127       v-error = if (x_calc-method  = ?
     1128                 or lookup(x_calc-method, 'Учетная,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U) = 0)
     1129                 and BinMask(par-fields, "XXXX1":U)
     1130                 then yes
     1131                 else v-error
     1132       .
     1133       if v-error then return "error".
     1134       if x_calc-method <> v-calc-method
     1135       or x_increase-pc <> v-increase-pc then do:
     1136         run ref/gdsgrp01.p (
     1137                         input 'ИЗМЕНЕНИЕ':U
     1138                       ,input yes
     1139                       ,input no
     1140                       ,input no
     1141                       ,input-output buf_gds-grp.node-code
     1142                       ,input-output buf_gds-grp.upper-code
     1143                       ,input buf_gds-grp.node-name
     1144                       ,input x_calc-method
     1145                       ,input x_increase-pc
     1146                       ,input x_round-method
     1147                       ,input x_base
     1148                       ,output v-rid
     1149                       ) no-error.
     1150       end.
     1151       if  true = true  then do:
     1152         if ( BinMask(par-region, "XX1":U) and p-host-code = 0 ) or
     1153            (( BinMask(par-region, "X1X":U)  or BinMask(par-region, "1XX":U) )  and p-host-code <> 0 )
     1154         then do:
     1155             run grp-obj-write in this-procedure (
     1156                                                   input buf_gds-grp.node-code
     1157                                                 , input p-host-code
     1158                                                 , input p-obj-type
     1159                                                 , input p-obj-code
     1160                                                 , input x_min
     1161                                                 , input x_max
     1162                                                 , input x_increase-pc
     1163                                                 , input buf_gds-grp.calc-method
     1164                                                 , input x_round-method
     1165                                                 , input x_base
     1166                                                 , input x_cli-type
     1167                                                 , input x_cli-code
     1168                                                 ) no-error.
     1169             end.
     1170         if (BinMask(par-region, "X1X":U)
     1171         or BinMask(par-region, "1XX":U)
     1172            )
     1173         and  par-fields <> 1
     1174         and p-host-code = 0
     1175         then do:
     1176           if BinMask(par-region, "X1X":U) then do:
     1177                 for each buf_gds-grp-obj no-lock where
     1178                         buf_gds-grp-obj.node-code = buf_gds-grp.node-code
     1179                     AND buf_gds-grp-obj.host-code <> 0
     1180                     and buf_gds-grp-obj.obj-type = ""
     1181                     and buf_gds-grp-obj.obj-code = 0
     1182                     :
     1183                   assign
     1184                   ii = ii + 1
     1185                   .
     1186                   run proc-assign in this-procedure
     1187                                   (buffer ub.gds-grp,
     1188                                   buf_gds-grp-obj.host-code,
     1189                                   buf_gds-grp-obj.obj-type,
     1190                                   buf_gds-grp-obj.obj-code,
     1191                                   p-calc-method,
     1192                                   p-increase-pc,
     1193                                   p-min,
     1194                                   p-max,
     1195                                   p-round-method,
     1196                                   p-base,
     1197                                   p-cli-type ,
     1198                                   p-cli-code
     1199                                   ) no-error .
     1200                   if not error-status:error and return-value <> "error":U then
     1201                   jj = jj + 1.
     1202                   run waitfram-show in this-procedure ("Обработано" + chr(32) +
     1203                                 string(ii) + chr(32) +
     1204                                 "записей - успешно" + chr(32) +
     1205                                 string(jj)).
     1206                 end.
     1207           end.
     1208           if BinMask(par-region, "1XX":U) then do:
     1209                 for each buf_gds-grp-obj no-lock where
     1210                         buf_gds-grp-obj.node-code = buf_gds-grp.node-code
     1211                     AND buf_gds-grp-obj.host-code <> 0
     1212                     and buf_gds-grp-obj.obj-type <> ""
     1213                     and buf_gds-grp-obj.obj-code <> 0
     1214                     :
     1215                   assign
     1216                   ii = ii + 1
     1217                   .
     1218                   run proc-assign in this-procedure
     1219                                   (buffer ub.gds-grp,
     1220                                   buf_gds-grp-obj.host-code,
     1221                                   buf_gds-grp-obj.obj-type,
     1222                                   buf_gds-grp-obj.obj-code,
     1223                                   p-calc-method,
     1224                                   p-increase-pc,
     1225                                   p-min,
     1226                                   p-max,
     1227                                   p-round-method,
     1228                                   p-base,
     1229                                   p-cli-type ,
     1230                                   p-cli-code
     1231                                   ) no-error .
     1232                   if not error-status:error and return-value <> "error":U then
     1233                   jj = jj + 1.
     1234                   run waitfram-show in this-procedure ("Обработано" + chr(32) +
     1235                                 string(ii) + chr(32) +
     1236                                 "записей - успешно" + chr(32) +
     1237                                 string(jj)).
     1238                 end.
     1239           end.
     1240         end.
     1241       end.
     1242     end.
     1243   end procedure.
     1244   procedure ini-tree :
     1245   define input parameter par-node-code like ub.gds-grp.node-code no-undo .
     1246   define input parameter par-lvl-num   like ub.gds-grp.lvl-num no-undo .
     1247   define input parameter p_calc-method like ub.gds-grp.calc-method no-undo .
     1248   define input parameter p_increase-pc like ub.gds-grp.increase-pc no-undo .
     1249   define variable v-value as character no-undo .
     1250   define variable v-type as character no-undo .
     1251   define variable v-max as decimal no-undo .
     1252   define variable v-min as decimal no-undo .
     1253   define variable v-incr as decimal no-undo .
     1254   define variable v-round-method as character no-undo .
     1255   define variable v-base         as decimal no-undo .
     1256   define variable v-rid as recid no-undo .
     1257   define variable v-calc-method as character no-undo .
     1258   define variable v-increase-pc as decimal no-undo .
     1259   define variable v-cli-type as character no-undo .
     1260   define variable v-cli-code as integer no-undo .
     1261   DEFINE VARIABLE v-contin as logical no-undo .
     1262   define variable v-process as logical no-undo .
     1263   define variable v-nc like ub.gds-grp.node-code no-undo .
     1264   define buffer buf_gds-grp for ub.gds-grp.
     1265   define buffer new_gds-grp for ub.gds-grp.
     1266   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     1267     do
     1268     on error undo, return error
     1269     :
     1270       find first buf_gds-grp-obj no-lock where
     1271                  buf_gds-grp-obj.node-code = par-node-code
     1272              AND buf_gds-grp-obj.host-code = 0
     1273              AND buf_gds-grp-obj.obj-type = "":U
     1274              AND buf_gds-grp-obj.obj-code = 0.
     1275       assign
     1276       v-min          = buf_gds-grp-obj.min-increase
     1277       v-max          = buf_gds-grp-obj.max-increase
     1278       v-incr         = buf_gds-grp-obj.increase-pc
     1279       v-round-method = buf_gds-grp-obj.round-method
     1280       v-base         = buf_gds-grp-obj.round-coef
     1281       v-cli-type     = buf_gds-grp-obj.cli-type
     1282       v-cli-code     = buf_gds-grp-obj.cli-code
     1283       .
     1284       _buf_gds-grp:
     1285       for each  buf_gds-grp where
     1286                 buf_gds-grp.upper-code = par-node-code AND
     1287                 buf_gds-grp.lvl-num = par-lvl-num:
     1288         if par-groups = "select-tree":U then do:
     1289           assign
     1290           v-contin = yes
     1291           v-nc = buf_gds-grp.node-code
     1292           .
     1293           do while v-contin:
     1294             run tree-up in this-procedure (input-output v-nc, output v-contin, output v-process).
     1295           end.
     1296         end.
     1297         else v-process = yes
     1298         .
     1299         if not v-process then do:
     1300           next _buf_gds-grp.
     1301         end.
     1302         assign
     1303         ii = ii + 1
     1304         .
     1305         run proc-assign in this-procedure (
     1306                                             buffer buf_gds-grp,
     1307                                             0,
     1308                                             "":U,
     1309                                             0,
     1310                                             p_calc-method,
     1311                                             p_increase-pc,
     1312                                             v-min,
     1313                                             v-max,
     1314                                             v-round-method,
     1315                                             v-base,
     1316                                             v-cli-type ,
     1317                                             v-cli-code
     1318                                             ) no-error .
     1319         if not error-status:error and return-value <> "error":U then
     1320         jj = jj + 1.
     1321         release buf_gds-grp no-error .
     1322         run waitfram-show in this-procedure ("Обработано" + chr(32) +
     1323                       string(jj) + chr(32) +
     1324                       "записей - успешно" + chr(32) +
     1325                       string(ii)).
     1326       end.
     1327     end.
     1328   end procedure.
     1329   procedure tree-up :
     1330   define input-output parameter p-node-code like ub.gds-grp.node-code no-undo .
     1331   define output parameter p-contin as logical no-undo init yes.
     1332   define output parameter p-process as logical no-undo init yes.
     1333   define buffer buf_gds-grp for ub.gds-grp.
     1334     do
     1335     on error undo, return error
     1336     :
     1337       find first buf_gds-grp no-lock where
     1338                  buf_gds-grp.node-code = p-node-code no-error .
     1339       if not avail buf_gds-grp then do:
     1340         assign
     1341         p-process = no
     1342         p-contin = no
     1343         .
     1344         return.
     1345       end.
     1346       if lookup(string(recid(buf_gds-grp)), par-rid-list) > 0 then do:
     1347         assign
     1348         p-process = yes
     1349         p-contin = no
     1350         .
     1351         return.
     1352       end.
     1353       else do:
     1354         assign
     1355         p-process = no
     1356         p-contin = yes
     1357         p-node-code = buf_gds-grp.upper-code
     1358         .
     1359         return.
     1360       end.
     1361     end.
     1362   end procedure.
