        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   procedure create-price-list-attr :
       18    do
       19    on error undo, return error return-value
       20    :
       21   define input parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
       22   define input parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
       23   define input parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
       24   define input parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
       25   define input parameter p-price-type   like ub.price-list-attr.price-type no-undo .
       26   define buffer buf_price-list-attr for ub.price-list-attr.
       27   find first buf_price-list-attr  exclusive-lock  where
       28     buf_price-list-attr.attr-code    = p-attr-code    and
       29     buf_price-list-attr.b-code       = p-b-code       and
       30     buf_price-list-attr.doc-num      = p-doc-num      and
       31     buf_price-list-attr.price-type   = p-price-type  no-error .
       32     if not available  buf_price-list-attr then do:
       33         create buf_price-list-attr.
       34         assign
       35           buf_price-list-attr.attr-code    = p-attr-code
       36           buf_price-list-attr.attr-value   = p-attr-value
       37           buf_price-list-attr.b-code       = p-b-code
       38           buf_price-list-attr.doc-num      = p-doc-num
       39           buf_price-list-attr.price-type   = p-price-type
       40         .
       41     end.
       42     else do:
       43           buf_price-list-attr.attr-value   = p-attr-value .
       44     end.
       45    end.
       46   end procedure.
       47   procedure view-price-list-attr :
       48    do
       49    on error undo, return error return-value
       50    :
       51   define input  parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
       52   define input  parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
       53   define input  parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
       54   define input  parameter p-price-type   like ub.price-list-attr.price-type no-undo .
       55   define output parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
       56   define buffer buf_price-list-attr for ub.price-list-attr.
       57   find first buf_price-list-attr no-lock where
       58     buf_price-list-attr.attr-code    = p-attr-code    and
       59     buf_price-list-attr.b-code       = p-b-code       and
       60     buf_price-list-attr.doc-num      = p-doc-num      and
       61     buf_price-list-attr.price-type   = p-price-type  no-error .
       62     if available  buf_price-list-attr then do:
       63         assign
       64           p-attr-value = buf_price-list-attr.attr-value
       65         .
       66     end.
       67     else do:
       68           p-attr-value = ? .
       69     end.
       70    end.
       71   end procedure.
       72   procedure pdoc-forming-attr :
       73   define input  parameter p-plt-id       as integer   no-undo .
       74   define input  parameter p-plt-db-num   as integer   no-undo .
       75   define input  parameter p-pdf-id       as integer   no-undo .
       76   define input  parameter p-pdf-db       as integer   no-undo .
       77   define input  parameter p-attr-code    as character no-undo .
       78   define input  parameter p-val          as character no-undo .
       79     do
       80     on error undo, return error return-value
       81     :
       82     find first  ub.price-doc-forming-attr exclusive-lock where
       83                 ub.price-doc-forming-attr.plt-id       = p-plt-id       and
       84                 ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num   and
       85                 ub.price-doc-forming-attr.pdf-id       = p-pdf-id       and
       86                 ub.price-doc-forming-attr.pdf-db       = p-pdf-db       and
       87                 ub.price-doc-forming-attr.attr-code    = p-attr-code
       88                 no-error .
       89       if not available  ub.price-doc-forming-attr then create ub.price-doc-forming-attr.
       90       assign
       91         ub.price-doc-forming-attr.plt-id       = p-plt-id
       92         ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num
       93         ub.price-doc-forming-attr.pdf-id       = p-pdf-id
       94         ub.price-doc-forming-attr.pdf-db       = p-pdf-db
       95         ub.price-doc-forming-attr.attr-code    = p-attr-code
       96         ub.price-doc-forming-attr.attr-value   = p-val
       97       .
       98     end.
       99   end procedure.
      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   define variable v-waitfram-action01         as character   no-undo .
      102   define variable v-waitfram-action02         as character   no-undo .
      103   define variable v-waitfram-action03         as character   no-undo .
      104   define variable mWaitFramTextBeg            as character   no-undo.
      105   define variable mWaitFramTextEnd            as character   no-undo.
      106   define variable mWaitFramView               as logical     no-undo.
      107   define variable mWaitProcEvent              as logical     no-undo init yes.
      108   define variable mWaitFramInterval           as integer     no-undo init 1 .
      109   define variable mWaitFramStop               as logical     no-undo.
      110   define variable mWaitFramStopUser           as logical     no-undo.
      111   define variable mWaitFramStopTimeOut        as logical     no-undo.
      112   define variable mWaitFramStartProc          as datetime-tz no-undo.
      113   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      114   define button B-WaitFramStop auto-end-key
      115        label "Стоп"
      116        size 10 by 1 tooltip "Остоновить процесс".
      117   define button B-viewProcInfo
      118        label "Информация"
      119        size 15 by 1 tooltip "Информация о процесс".
      120   define frame waitfram
      121     v-waitfram-action01 format "x(72)" no-label skip
      122     v-waitfram-action02 format "x(72)" no-label skip
      123     v-waitfram-action03 format "x(72)" no-label skip
      124     B-viewProcInfo
      125     B-WaitFramStop at row 4 col 30
      126     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      127     .
      128   define new global shared variable mBatchMode as logical no-undo init ?.
      129   define variable mFramBachModHandle as handle no-undo.
      130   mFramBachModHandle = frame waitfram:handle.
      131   define variable mFameOldVis as logical no-undo.
      132   define variable mVisCUrentVin as logical no-undo.
      133   if session:batch-mode
      134   then
      135      mBatchMode = yes.
      136   if mBatchMode = ? then do:
      137     mVisCUrentVin = current-window:visible.
      138     mFameOldVis = mFramBachModHandle:visible.
      139     mFramBachModHandle:visible  = yes.
      140     mBatchMode = mFramBachModHandle:visible ne yes.
      141     mFramBachModHandle:visible = mFameOldVis.
      142     current-window:visible = mVisCUrentVin.
      143   end.
      144    if  log-manager:logfile-name ne ?
      145     then DO:
      146         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      147         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      148         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      149     end.
      150   on choose of B-WaitFramStop in frame waitfram
      151   do:
      152     mWaitFramStop = yes.
      153     mWaitFramStopUser = yes.
      154   end.
      155   function waitfram-check-timeout returns logical():
      156      define variable vtime as int64 no-undo.
      157      if mWaitFramStopTimeOut
      158      then
      159         return yes.
      160      vtime = ( now - mWaitFramStartProc ) / 1000 .
      161      if     mWaitFramTimeOut ne ?
      162         and mWaitFramTimeOut ne 0
      163         and mWaitFramTimeOut lt vtime
      164      then do:
      165         mWaitFramStopTimeOut = yes.
      166      end.
      167      return mWaitFramStopTimeOut.
      168   end.
      169   procedure waitfram-hide :
      170     if not session:batch-mode
      171     then do
      172     on error undo, return error return-value
      173     :
      174       pause 0 before-hide .
      175       if not mBatchMode then
      176         hide frame waitfram .
      177     if     not mWaitFramView
      178        and mWaitProcEvent
      179     then
      180       process events .
      181     end.
      182   end procedure.
      183   procedure waitfram-show :
      184     define input  parameter p-message as character no-undo .
      185     define variable v-left-margin as integer   no-undo .
      186     if not session:batch-mode
      187     then do
      188     on error undo, return error return-value
      189     :
      190       if length(p-message) <= 70 then do:
      191         assign
      192           v-left-margin = integer((70 - length(p-message)) / 2)
      193         .
      194         assign
      195           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      196         .
      197         assign
      198           v-waitfram-action01 = " "
      199           v-waitfram-action02 = " "
      200                                    + fill(" ", v-left-margin)
      201                                    + p-message
      202           v-waitfram-action03 = " "
      203         .
      204       end.
      205       else do:
      206         define variable vRindex1 as integer no-undo.
      207         define variable vRindex2 as integer no-undo.
      208         vRindex1 = r-index(p-message," ",70).
      209         if vRindex1 = 0
      210         then
      211            vRindex1 = 70.
      212         if length(p-message)  <= vRindex1 + 70 then do:
      213           assign
      214             v-waitfram-action01 = " "
      215             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      216             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      217           .
      218         end.
      219         else do:
      220           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      221           if vRindex2 <= vRindex1
      222           then
      223              vRindex2 = vRindex1 + 70.
      224           assign
      225             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      226             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      227             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      228           .
      229         end.
      230       end.
      231       B-viewProcInfo:visible   in frame waitfram = no.
      232       B-viewProcInfo:sensitive in frame waitfram = no.
      233       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      234       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      235       if  (   mWaitFramView
      236          or  mWaitProcEvent)
      237          and not mBatchMode
      238       then
      239          display
      240             v-waitfram-action01 skip
      241             v-waitfram-action02 skip
      242             v-waitfram-action03 skip
      243          with frame waitfram .
      244       if     mWaitFramView
      245          then do:
      246             if     mWaitFramInterval ne ?
      247                and not mBatchMode
      248             then
      249                wait-for go of frame waitfram pause mWaitFramInterval.
      250          end.
      251          else
      252             if     mWaitProcEvent
      253                and not mBatchMode
      254             then
      255                process events .
      256     end.
      257   end procedure.
      258      procedure waitfram-show-this:
      259         define input  parameter iInterval as int64 no-undo.
      260         define variable vtime as int64 no-undo.
      261         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      262         mWaitFramInterval = iInterval.
      263         run waitfram-show (substitute("&1&2 &3&4" ,
      264                                       mWaitFramTextBeg ,
      265                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      266                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      267                                       mWaitFramTextEnd
      268                                      )
      269                           ).
      270      end.
      271      procedure WaitFramRunPause:
      272         define input  parameter iInterval as dec no-undo.
      273         define variable vStart  as datetime-tz no-undo.
      274         define variable vend    as datetime-tz no-undo.
      275         define variable vint as int64 no-undo.
      276         define variable vOk as logical no-undo.
      277         vStart = now.
      278         vend   = vStart.
      279         publish "WaitFramPause" (iInterval,output vOk).
      280         vend   =  now.
      281         vint = vend - vStart.
      282         vint = iInterval - vint / 1000.
      283         if     not mWaitFramStop
      284            and (   vint > 0
      285                 or (    not vOk
      286                     and iInterval eq ?
      287                     )
      288                 )
      289         then
      290            run waitfram-show-this (iInterval).
      291         vend   =  now.
      292         vint = vend - vStart.
      293         vint = iInterval - vint / 1000.
      294         if     not mWaitFramStop
      295            and vint > 0
      296         then do:
      297            run gbl/pause.p (vint * 1000).
      298         end.
      299         if iInterval ne ?
      300         then
      301            publish "WaitFramStop".
      302         waitfram-check-timeout().
      303      end.
      304      procedure WaitFramWaitFor:
      305         define input  parameter iInterval as dec no-undo.
      306         assign
      307            mWaitFramStartProc   = now
      308            mWaitFramStopUser    = no
      309            mWaitFramStopTimeOut = no
      310         .
      311         block-wait:
      312         do while not mWaitFramStop:
      313            run WaitFramRunPause (iInterval).
      314            if  waitfram-check-timeout()
      315            then do:
      316               leave block-wait.
      317            end.
      318         end.
      319         run waitfram-hide.
      320      end.
      321   procedure waitfram-join :
      322     define input  parameter p-line-1  as character no-undo .
      323     define input  parameter p-line-2  as character no-undo .
      324     define input  parameter p-line-3  as character no-undo .
      325     define output parameter p-message as character no-undo .
      326     do
      327     on error undo, return error return-value
      328     :
      329       assign
      330         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      331                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      332                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      333       .
      334     end.
      335   end procedure.
      336   function waitfram-join-function returns character
      337     (input p-line-1 as character
      338     ,input p-line-2 as character
      339     ,input p-line-3 as character
      340     ).
      341     define variable v-message as character no-undo .
      342     run waitfram-join in this-procedure
      343       (input  p-line-1
      344       ,input  p-line-2
      345       ,input  p-line-3
      346       ,output v-message
      347       ) .
      348     return v-message .
      349   end function .
      350   define variable var-pr-r-b as character no-undo .
      351   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      352   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      353     (output var-pr-r-b
      354     )  .
      355   define buffer buf_price-doc  for price-doc  .
      356   define buffer buf_price-list for price-list .
      357   define variable col-part as integer no-undo .
      358   define variable temp1 as integer init 10 no-undo .
      359   define variable v-all as integer init 0 no-undo .
      360   run waitfram-show in this-procedure ("Ждите...").
      361   for each buf_price-doc no-lock
      362       where buf_price-doc.status_ = 'акт':U
      363       on error undo, return error :
      364           for each buf_price-list no-lock
      365               where    buf_price-list.doc-num = buf_price-doc.doc-num
      366               on error undo, return error :
      367               v-all = v-all + 1.
      368           end.
      369   end.
      370   for each buf_price-doc no-lock
      371       where buf_price-doc.status_ = 'акт':U
      372       on error undo, return error :
      373       for each buf_price-list no-lock
      374           where    buf_price-list.doc-num = buf_price-doc.doc-num
      375           on error undo, return error :
      376           run proc-cost-price-fact.
      377       end.
      378   end.
      379   run waitfram-hide in this-procedure .
      380   message "Процесс завершен!"  view-as alert-box .
      381   procedure proc-cost-price-fact :
      382    do
      383    on error undo, return error return-value
      384    :
      385   define variable v-total-avrg-base  as decimal no-undo .
      386   define variable v-total-avrg-rubl  as decimal no-undo .
      387   define variable v-total-avrg-qnty  as decimal no-undo .
      388   define buffer buf_parts      for parts.
      389   define buffer buf_price-list for price-list.
      390   define variable p-price-base as decimal no-undo .
      391   define variable p-price-rubl as decimal no-undo .
      392   col-part = col-part + 1.
      393   if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show ( " Всего строк: " + string( v-all ) + " Обработано строк price-list : " + string( col-part )) .
      394   run trg/chk_prc.p (buf_price-doc.doc-num) .
      395   for each buf_price-list no-lock
      396       where buf_price-list.doc-num = buf_price-doc.doc-num
      397       on error undo, return error :
      398         for each buf_parts no-lock
      399           where buf_parts.obj-type  = buf_price-doc.obj-type
      400             and buf_parts.obj-code   = buf_price-doc.obj-code
      401             and buf_parts.artic      = buf_price-list.artic
      402             and buf_parts.prod-type  = buf_price-list.prod-type
      403             and buf_parts.prod-code  = buf_price-list.prod-code
      404             and ( buf_parts.out-code  = buf_price-doc.doc-num
      405                 )
      406         on error undo, return error
      407         :
      408           assign
      409             v-total-avrg-base = v-total-avrg-base
      410                               + (buf_parts.price-base * buf_parts.qnty)
      411             v-total-avrg-rubl = v-total-avrg-rubl
      412                               + (buf_parts.price-rubl * buf_parts.qnty)
      413             v-total-avrg-qnty = v-total-avrg-qnty
      414                               + buf_parts.qnty
      415           .
      416         end.
      417         if v-total-avrg-qnty > 0 then do:
      418           assign
      419             p-price-base = ( v-total-avrg-base / v-total-avrg-qnty )
      420             p-price-rubl = ( v-total-avrg-rubl / v-total-avrg-qnty )
      421           .
      422         end.
      423         else do:
      424           assign
      425             p-price-base = ?
      426             p-price-rubl = ?
      427           .
      428         end.
      429    define variable p-attr-value as character no-undo .
      430    if var-pr-r-b = "rubl"  then
      431       p-attr-value = string ( p-price-rubl ) .
      432       else
      433       p-attr-value = string ( p-price-base ) .
      434     run create-price-list-attr (
      435       'cost-price-fact':U    ,
      436       p-attr-value          ,
      437       buf_price-list.b-code ,
      438       buf_price-doc.doc-num ,
      439       ""
      440       ) .
      441   end.
      442    end.
      443   end procedure.
