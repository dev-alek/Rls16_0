     3605   end procedure.
     3606   procedure validate-free-zone :
     3607     define buffer buf_lock_gds-obj for ub.gds-obj .
     3608     define buffer buf_gds-obj for ub.gds-obj .
     3609     define buffer buf_aht-stk-line for ub.aht-stk-line .
     3610     define buffer buf_temp-aht-stk-line for temp-aht-stk-line .
     3611     define buffer buf_temp-parts for temp-parts .
     3612     define buffer buf_goods for ub.goods .
     3613     define variable v-ind as integer   no-undo .
     3614     do
     3615     on error undo, return error return-value
     3616     :
     3617       for each buf_gds-obj no-lock
     3618         where buf_gds-obj.obj-type = p-obj-type
     3619           and buf_gds-obj.obj-code = p-obj-code
     3620       on error undo, return error return-value
     3621       :
     3622         assign
     3623           v-ind = v-ind + 1
     3624         .
     3625         if v-ind modulo 10 = 0
     3626         then do:
     3627           run waitfram-show in this-procedure
     3628             (input substitute("Проверка остатков. Ошибок &1. Объект &2 &3. Артикул &4 &5 &6."
     3629                             ,v-total-err
     3630                             ,p-obj-type
     3631                             ,p-obj-code
     3632                             ,buf_gds-obj.artic
     3633                             ,buf_gds-obj.prod-type
     3634                             ,buf_gds-obj.prod-code
     3635                             )
     3636             ).
     3637         end.
     3638         run clear-temp-aht-stk-line in this-procedure .
     3639         do transaction
     3640         on error undo, return error return-value
     3641         :
     3642           find buf_lock_gds-obj exclusive-lock
     3643             where rowid(buf_lock_gds-obj) = rowid(buf_gds-obj)
     3644             .
     3645           run partslib-init-temp-parts in this-procedure
     3646             (input  buf_gds-obj.obj-type
     3647             ,input  buf_gds-obj.obj-code
     3648             ,input  buf_gds-obj.artic
     3649             ,input  buf_gds-obj.prod-type
     3650             ,input  buf_gds-obj.prod-code
     3651             ) .
     3652         end.
     3653         define variable v-sum-type as character no-undo .
     3654         find first buf_goods no-lock
     3655           where buf_goods.gds-code = buf_gds-obj.gds-code
     3656           no-error .
     3657         if not available buf_goods
     3658         then do:
     3659           assign
     3660             v-total-err = v-total-err + 1
     3661           .
     3662           run cur-time in this-procedure
     3663             (output v-today
     3664             ,output v-time
     3665             ) .
     3666           run update-last-date in this-procedure
     3667             (input v-today
     3668             ) .
     3669           output stream sout to value(v-log-err-file) append .
     3670           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3671           export stream sout "error-04: ub.goods not found" .
     3672           export stream sout "obj-type"  p-obj-type                            .
     3673           export stream sout "obj-code"  p-obj-code                            .
     3674           export stream sout "gds-code"  buf_gds-obj.gds-code                  .
     3675           output stream sout close .
     3676         end.
     3677         if buf_goods.gds-type = 'т':U
     3678         then do:
     3679           for each buf_temp-parts
     3680           on error undo, return error return-value
     3681           :
     3682             case buf_temp-parts.purch-code
     3683             :
     3684               when 1
     3685               then do:
     3686                 assign
     3687                   v-sum-type = 'r':U
     3688                 .
     3689               end.
     3690               when 2
     3691               then do:
     3692                 assign
     3693                   v-sum-type = 'c':U
     3694                 .
     3695               end.
     3696               when 3
     3697               then do:
     3698                 assign
     3699                   v-sum-type = 's':U
     3700                 .
     3701               end.
     3702               when 4
     3703               then do:
     3704                 assign
     3705                   v-sum-type = 'o':U
     3706                 .
     3707               end.
     3708               otherwise do:
     3709               end.
     3710             end.
     3711             find first buf_temp-aht-stk-line
     3712               where buf_temp-aht-stk-line.temp-gds-code = buf_gds-obj.gds-code
     3713                 and buf_temp-aht-stk-line.temp-sum-type = v-sum-type
     3714               no-error .
     3715             if not available buf_temp-aht-stk-line
     3716             then do:
     3717               create buf_temp-aht-stk-line .
     3718               assign
     3719                 buf_temp-aht-stk-line.temp-gds-code = buf_gds-obj.gds-code
     3720                 buf_temp-aht-stk-line.temp-sum-type = v-sum-type
     3721               .
     3722             end.
     3723             assign
     3724               buf_temp-aht-stk-line.temp-fact-qnty = buf_temp-aht-stk-line.temp-fact-qnty
     3725                                                   + buf_temp-parts.fact-qnty
     3726             .
     3727             if v-sum-type = 'c':U
     3728             then do:
     3729               find first buf_temp-aht-stk-line
     3730                 where buf_temp-aht-stk-line.temp-gds-code = buf_gds-obj.gds-code
     3731                   and buf_temp-aht-stk-line.temp-sum-type = 'b':U
     3732                 no-error .
     3733               if not available buf_temp-aht-stk-line
     3734               then do:
     3735                 create buf_temp-aht-stk-line .
     3736                 assign
     3737                   buf_temp-aht-stk-line.temp-gds-code = buf_gds-obj.gds-code
     3738                   buf_temp-aht-stk-line.temp-sum-type = 'b':U
     3739                 .
     3740               end.
     3741               assign
     3742                 buf_temp-aht-stk-line.temp-fact-qnty = buf_temp-aht-stk-line.temp-fact-qnty
     3743                                                     + buf_temp-parts.fact-qnty
     3744               .
     3745             end.
     3746           end.
     3747         end.
     3748         else do:
     3749           find first buf_temp-aht-stk-line
     3750             where buf_temp-aht-stk-line.temp-gds-code = buf_gds-obj.gds-code
     3751               and buf_temp-aht-stk-line.temp-sum-type = 'v':U
     3752             no-error .
     3753           if not available buf_temp-aht-stk-line
     3754           then do:
     3755             create buf_temp-aht-stk-line .
     3756             assign
     3757               buf_temp-aht-stk-line.temp-gds-code = buf_gds-obj.gds-code
     3758               buf_temp-aht-stk-line.temp-sum-type = 'v':U
     3759             .
     3760           end.
     3761           assign
     3762             buf_temp-aht-stk-line.temp-fact-qnty = buf_temp-aht-stk-line.temp-fact-qnty
     3763                                                  + buf_gds-obj.fact-qnty
     3764           .
     3765         end.
     3766         for each buf_temp-aht-stk-line
     3767         on error undo, return error return-value
     3768         :
     3769           find last buf_aht-stk-line no-lock
     3770             where buf_aht-stk-line.obj-type   = p-obj-type
     3771               and buf_aht-stk-line.obj-code   = p-obj-code
     3772               and buf_aht-stk-line.gds-code   = buf_temp-aht-stk-line.temp-gds-code
     3773               and buf_aht-stk-line.sum-type   = buf_temp-aht-stk-line.temp-sum-type
     3774             use-index category
     3775             no-error .
     3776           if (available buf_aht-stk-line
     3777               and buf_temp-aht-stk-line.temp-fact-qnty <> buf_aht-stk-line.fact-qnty
     3778              )
     3779           or (not available buf_aht-stk-line
     3780               and buf_temp-aht-stk-line.temp-fact-qnty <> 0
     3781              )
     3782           then do:
     3783             assign
     3784               v-total-err = v-total-err + 1
     3785             .
     3786             run cur-time in this-procedure
     3787               (output v-today
     3788               ,output v-time
     3789               ) .
     3790             run update-last-date in this-procedure
     3791               (input v-today
     3792               ) .
     3793             output stream sout to value(v-log-err-file) append .
     3794             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3795             export stream sout "error-05: gds-obj aht-stk-line different fact-qnty" .
     3796             export stream sout "obj-type"  p-obj-type                            .
     3797             export stream sout "obj-code"  p-obj-code                            .
     3798             export stream sout "fact-date" v-today                               .
     3799             export stream sout "gds-code"  buf_temp-aht-stk-line.temp-gds-code   .
     3800             export stream sout "sum-type"  buf_temp-aht-stk-line.temp-sum-type   .
     3801             export stream sout "parts.fact-qnty" buf_temp-aht-stk-line.temp-fact-qnty .
     3802             if available buf_aht-stk-line
     3803             then do:
     3804               export stream sout "aht-stk-line.fact-qnty" buf_aht-stk-line.fact-qnty .
     3805             end.
     3806             output stream sout close .
     3807           end.
     3808         end.
     3809       end.
     3810     end.
     3811   end procedure.
     3812   procedure update-last-date :
     3813     define input  parameter p-update-date as date      no-undo .
     3814     do
     3815     on error undo, return error return-value
     3816     :
     3817       if p-last-date = ?
     3818       or p-last-date < p-update-date
     3819       then do:
     3820         assign
     3821           p-last-date = p-update-date
     3822         .
     3823       end.
     3824     end.
     3825   end procedure.
     3826   procedure clear-temp-aht-stk-line :
     3827     define buffer buf_temp-aht-stk-line for temp-aht-stk-line .
     3828     do
     3829     on error undo, return error return-value
     3830     :
     3831       for each buf_temp-aht-stk-line
     3832       on error undo, return error return-value
     3833       :
     3834         delete buf_temp-aht-stk-line .
     3835       end.
     3836     end.
     3837   end procedure.
     3838   procedure check-fact-order :
     3839     define buffer buf_aht-stk-line for ub.aht-stk-line .
     3840     define variable v-ind as integer   no-undo .
     3841     do
     3842     on error undo, return error return-value
     3843     :
     3844       for each buf_aht-stk-line no-lock
     3845         where buf_aht-stk-line.obj-type = p-obj-type
     3846           and buf_aht-stk-line.obj-code = p-obj-code
     3847       on error undo, return error return-value
     3848       :
     3849         assign
     3850           v-ind = v-ind + 1
     3851         .
     3852         if v-ind modulo 10 = 0
     3853         then do:
     3854           run waitfram-show in this-procedure
     3855             (input substitute("Проверка 02. Ошибок &1. Объект &2 &3. Записей &4."
     3856                             ,v-total-err
     3857                             ,p-obj-type
     3858                             ,p-obj-code
     3859                             ,v-ind
     3860                             )
     3861             ).
     3862         end.
     3863         define variable v-factord-date as date      no-undo .
     3864         run factord-to-date in this-procedure
     3865           (input  buf_aht-stk-line.fact-order
     3866           ,output v-factord-date
     3867           ) .
     3868         if truncate(buf_aht-stk-line.fact-order, 2) <> buf_aht-stk-line.fact-order
     3869         then do:
     3870           assign
     3871             v-total-err = v-total-err + 1
     3872           .
     3873           run update-last-date in this-procedure
     3874             (input v-factord-date
     3875             ) .
     3876           output stream sout to value(v-log-err-file) append .
     3877           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3878           export stream sout "error-06: fact-order"                .
     3879           export stream sout "obj-type"    buf_aht-stk-line.obj-type   .
     3880           export stream sout "obj-code"    buf_aht-stk-line.obj-code   .
     3881           export stream sout "gds-code"    buf_aht-stk-line.gds-code   .
     3882           export stream sout "fact-order"  buf_aht-stk-line.fact-order .
     3883           export stream sout "sum-type"    buf_aht-stk-line.sum-type   .
     3884           export stream sout "v-factord-date" v-factord-date .
     3885           export stream sout "aht-stk-line" .
     3886           export stream sout buf_aht-stk-line .
     3887           output stream sout close .
     3888         end.
     3889       end.
     3890     end.
     3891   end procedure.
     3892   procedure fill-temp-aht-stk-line :
     3893     define buffer buf_aht-stk-line for ub.aht-stk-line .
     3894     define buffer buf_temp-aht-stk-line for temp-aht-stk-line .
     3895     define buffer buf_temp-gds for temp-gds .
     3896     define variable v-ind as integer   no-undo .
     3897     do
     3898     on error undo, return error return-value
     3899     :
     3900       for each buf_aht-stk-line no-lock
     3901         where buf_aht-stk-line.obj-type = p-obj-type
     3902           and buf_aht-stk-line.obj-code = p-obj-code
     3903       on error undo, return error return-value
     3904       :
     3905         assign
     3906           v-ind = v-ind + 1
     3907         .
     3908         if v-ind modulo 10 = 0
     3909         then do:
     3910           run waitfram-show in this-procedure
     3911             (input substitute("Проверка остатков 02. Ошибок &1. Объект &2 &3. Записей &4."
     3912                             ,v-total-err
     3913                             ,p-obj-type
     3914                             ,p-obj-code
     3915                             ,v-ind
     3916                             )
     3917             ).
     3918         end.
     3919         find first buf_temp-aht-stk-line
     3920           where buf_temp-aht-stk-line.temp-gds-code = buf_aht-stk-line.gds-code
     3921             and buf_temp-aht-stk-line.temp-sum-type = buf_aht-stk-line.sum-type
     3922           no-error .
     3923         if not available buf_temp-aht-stk-line
     3924         then do:
     3925           create buf_temp-aht-stk-line .
     3926           assign
     3927             buf_temp-aht-stk-line.temp-gds-code   = buf_aht-stk-line.gds-code
     3928             buf_temp-aht-stk-line.temp-sum-type   = buf_aht-stk-line.sum-type
     3929             buf_temp-aht-stk-line.temp-fact-qnty  = buf_aht-stk-line.fact-qnty
     3930             buf_temp-aht-stk-line.temp-fact-order = buf_aht-stk-line.fact-order
     3931           .
     3932         end.
     3933         if buf_temp-aht-stk-line.temp-fact-order < buf_aht-stk-line.fact-order
     3934         then do:
     3935           assign
     3936             buf_temp-aht-stk-line.temp-fact-qnty  = buf_aht-stk-line.fact-qnty
     3937             buf_temp-aht-stk-line.temp-fact-order = buf_aht-stk-line.fact-order
     3938           .
     3939         end.
     3940         find first buf_temp-gds
     3941           where buf_temp-gds.temp-gds-code = buf_aht-stk-line.gds-code
     3942           no-error .
     3943         if not available buf_temp-gds
     3944         then do:
     3945           create buf_temp-gds .
     3946           assign
     3947             buf_temp-gds.temp-gds-code = buf_aht-stk-line.gds-code
     3948           .
     3949         end.
     3950       end.
     3951     end.
     3952   end procedure.
     3953   procedure check-free-zone-from-aht-stk-line :
     3954     define buffer buf_lock_gds-obj for ub.gds-obj .
     3955     define buffer buf_temp-gds for temp-gds .
     3956     define buffer buf_temp-aht-stk-line for temp-aht-stk-line .
     3957     define buffer buf_temp-parts for temp-parts .
     3958     define buffer buf_goods for ub.goods .
     3959     define variable v-ind as integer   no-undo .
     3960     do
     3961     on error undo, return error return-value
     3962     :
     3963       for each buf_temp-gds
     3964       on error undo, return error return-value
     3965       :
     3966         find first buf_goods no-lock
     3967           where buf_goods.gds-code = buf_temp-gds.temp-gds-code
     3968           no-error .
     3969         if not available buf_goods
     3970         then do:
     3971           undo, next .
     3972         end.
     3973         assign
     3974           v-ind = v-ind + 1
     3975         .
     3976         if v-ind modulo 10 = 0
     3977         then do:
     3978           run waitfram-show in this-procedure
     3979             (input substitute("Проверка остатков 03. Ошибок &1. Объект &2 &3. Код товара &4."
     3980                             ,v-total-err
     3981                             ,p-obj-type
     3982                             ,p-obj-code
     3983                             ,buf_temp-gds.temp-gds-code
     3984                             )
     3985             ).
     3986         end.
     3987         do transaction
     3988         on error undo, return error return-value
     3989         :
     3990           find buf_lock_gds-obj exclusive-lock
     3991             where buf_lock_gds-obj.obj-type  = p-obj-type
     3992               and buf_lock_gds-obj.obj-code  = p-obj-code
     3993               and buf_lock_gds-obj.artic     = buf_goods.artic
     3994               and buf_lock_gds-obj.prod-type = buf_goods.prod-type
     3995               and buf_lock_gds-obj.prod-code = buf_goods.prod-code
     3996             no-error .
     3997           if not available buf_lock_gds-obj
     3998           then do:
     3999             assign
     4000               v-total-err = v-total-err + 1
     4001             .
     4002             run cur-time in this-procedure
     4003               (output v-today
     4004               ,output v-time
     4005               ) .
     4006             run update-last-date in this-procedure
     4007               (input v-today
     4008               ) .
     4009             output stream sout to value(v-log-err-file) append .
     4010             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     4011             export stream sout "error-07: gds-obj not found"   .
     4012             export stream sout "obj-type"  p-obj-type          .
     4013             export stream sout "obj-code"  p-obj-code          .
     4014             export stream sout "artic"     buf_goods.artic     .
     4015             export stream sout "prod-type" buf_goods.prod-type .
     4016             export stream sout "prod-code" buf_goods.prod-code .
     4017             output stream sout close .
     4018           end.
     4019           else do:
     4020             run partslib-init-temp-parts in this-procedure
     4021               (input  p-obj-type
     4022               ,input  p-obj-code
     4023               ,input  buf_goods.artic
     4024               ,input  buf_goods.prod-type
     4025               ,input  buf_goods.prod-code
     4026               ) .
     4027           end.
     4028         end.
     4029         define variable v-sum-type as character no-undo .
     4030         for each buf_temp-parts
     4031         on error undo, return error return-value
     4032         :
     4033           case buf_temp-parts.purch-code
     4034           :
     4035             when 1
     4036             then do:
     4037               assign
     4038                 v-sum-type = 'r':U
     4039               .
     4040             end.
     4041             when 2
     4042             then do:
     4043               assign
     4044                 v-sum-type = 'c':U
     4045               .
     4046             end.
     4047             when 3
     4048             then do:
     4049               assign
     4050                 v-sum-type = 's':U
     4051               .
     4052             end.
     4053             when 4
     4054             then do:
     4055               assign
     4056                 v-sum-type = 'o':U
     4057               .
     4058             end.
     4059             otherwise do:
     4060             end.
     4061           end.
     4062           find first buf_temp-aht-stk-line
     4063             where buf_temp-aht-stk-line.temp-gds-code = buf_temp-gds.temp-gds-code
     4064               and buf_temp-aht-stk-line.temp-sum-type = v-sum-type
     4065             no-error .
     4066           if not available buf_temp-aht-stk-line
     4067           then do:
     4068             create buf_temp-aht-stk-line .
     4069             assign
     4070               buf_temp-aht-stk-line.temp-gds-code = buf_temp-gds.temp-gds-code
     4071               buf_temp-aht-stk-line.temp-sum-type = v-sum-type
     4072             .
     4073           end.
     4074           assign
     4075             buf_temp-aht-stk-line.temp-gds-qnty = buf_temp-aht-stk-line.temp-gds-qnty
     4076                                                 + buf_temp-parts.fact-qnty
     4077           .
     4078           if v-sum-type = 'c':U
     4079           then do:
     4080             find first buf_temp-aht-stk-line
     4081               where buf_temp-aht-stk-line.temp-gds-code = buf_temp-gds.temp-gds-code
     4082                 and buf_temp-aht-stk-line.temp-sum-type = 'b':U
     4083               no-error .
     4084             if not available buf_temp-aht-stk-line
     4085             then do:
     4086               create buf_temp-aht-stk-line .
     4087               assign
     4088                 buf_temp-aht-stk-line.temp-gds-code = buf_temp-gds.temp-gds-code
     4089                 buf_temp-aht-stk-line.temp-sum-type = 'b':U
     4090               .
     4091             end.
     4092             assign
     4093               buf_temp-aht-stk-line.temp-gds-qnty = buf_temp-aht-stk-line.temp-gds-qnty
     4094                                                   + buf_temp-parts.fact-qnty
     4095             .
     4096           end.
     4097         end.
     4098       end.
     4099       for each buf_temp-aht-stk-line
     4100         where length(buf_temp-aht-stk-line.temp-sum-type) = 1
     4101       on error undo, return error return-value
     4102       :
     4103         assign
     4104           v-ind = v-ind + 1
     4105         .
     4106         if v-ind modulo 10 = 0
     4107         then do:
     4108           run waitfram-show in this-procedure
     4109             (input substitute("Проверка остатков 04. Ошибок &1. Объект &2 &3. Записей &4."
     4110                             ,v-total-err
     4111                             ,p-obj-type
     4112                             ,p-obj-code
     4113                             ,v-ind
     4114                             )
     4115             ).
     4116         end.
     4117         if buf_temp-aht-stk-line.temp-fact-qnty <> buf_temp-aht-stk-line.temp-gds-qnty
     4118         then do:
     4119           assign
     4120             v-total-err = v-total-err + 1
     4121           .
     4122           run cur-time in this-procedure
     4123             (output v-today
     4124             ,output v-time
     4125             ) .
     4126           run update-last-date in this-procedure
     4127             (input v-today
     4128             ) .
     4129           output stream sout to value(v-log-err-file) append .
     4130           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     4131           export stream sout "error-08: gds-obj aht-stk-line different fact-qnty" .
     4132           export stream sout "obj-type"  p-obj-type                            .
     4133           export stream sout "obj-code"  p-obj-code                            .
     4134           export stream sout "fact-date" v-today                               .
     4135           export stream sout "gds-code"  buf_temp-aht-stk-line.temp-gds-code   .
     4136           export stream sout "sum-type"  buf_temp-aht-stk-line.temp-sum-type   .
     4137           export stream sout "aht-stk-line.fact-qnty" buf_temp-aht-stk-line.temp-fact-qnty .
     4138           export stream sout "parts.fact-qnty" buf_temp-aht-stk-line.temp-gds-qnty .
     4139           output stream sout close .
     4140         end.
     4141       end.
     4142     end.
     4143   end procedure.
