     2815   procedure clear-temp-aht-ot-day :
     2816     define buffer buf_temp-aht-ot-day for temp-aht-ot-day .
     2817     do
     2818     on error undo, return error return-value
     2819     :
     2820       for each buf_temp-aht-ot-day
     2821       on error undo, return error return-value
     2822       :
     2823         delete buf_temp-aht-ot-day .
     2824       end.
     2825     end.
     2826   end procedure.
     2827   procedure fill-temp-aht-ot-day :
     2828     define input  parameter p-fact-date            as date      no-undo .
     2829     define input  parameter p-fact-order-begin-day as decimal   no-undo .
     2830     define input  parameter p-fact-order-end-day   as decimal   no-undo .
     2831     define buffer buf_temp-aht-ot-day for temp-aht-ot-day .
     2832     define buffer buf_aht-ot-line     for ub.aht-ot-line .
     2833     do
     2834     on error undo, return error return-value
     2835     :
     2836       for each buf_aht-ot-line no-lock
     2837         where buf_aht-ot-line.obj-type   = p-obj-type
     2838           and buf_aht-ot-line.obj-code   = p-obj-code
     2839           and buf_aht-ot-line.fact-order > p-fact-order-begin-day
     2840           and buf_aht-ot-line.fact-order < p-fact-order-end-day
     2841       on error undo, return error return-value
     2842       :
     2843         find first buf_temp-aht-ot-day
     2844           where buf_temp-aht-ot-day.temp-gds-code  = buf_aht-ot-line.gds-code
     2845             and buf_temp-aht-ot-day.temp-sum-type  = buf_aht-ot-line.sum-type
     2846           no-error .
     2847         if not available buf_temp-aht-ot-day
     2848         then do:
     2849           create buf_temp-aht-ot-day .
     2850           assign
     2851             buf_temp-aht-ot-day.temp-gds-code  = buf_aht-ot-line.gds-code
     2852             buf_temp-aht-ot-day.temp-sum-type  = buf_aht-ot-line.sum-type
     2853           .
     2854         end.
     2855         assign
     2856           buf_temp-aht-ot-day.temp-fact-qnty           = buf_temp-aht-ot-day.temp-fact-qnty
     2857                                                        + buf_aht-ot-line.fact-qnty
     2858           buf_temp-aht-ot-day.temp-cost-sum-base       = buf_temp-aht-ot-day.temp-cost-sum-base
     2859                                                        + buf_aht-ot-line.cost-sum-base
     2860           buf_temp-aht-ot-day.temp-cost-sum-rubl       = buf_temp-aht-ot-day.temp-cost-sum-rubl
     2861                                                        + buf_aht-ot-line.cost-sum-rubl
     2862           buf_temp-aht-ot-day.temp-cost-VAT-base       = buf_temp-aht-ot-day.temp-cost-VAT-base
     2863                                                        + buf_aht-ot-line.cost-VAT-base
     2864           buf_temp-aht-ot-day.temp-cost-VAT-rubl       = buf_temp-aht-ot-day.temp-cost-VAT-rubl
     2865                                                        + buf_aht-ot-line.cost-VAT-rubl
     2866           buf_temp-aht-ot-day.temp-cost-SLT-base       = buf_temp-aht-ot-day.temp-cost-SLT-base
     2867                                                        + buf_aht-ot-line.cost-SLT-base
     2868           buf_temp-aht-ot-day.temp-cost-SLT-rubl       = buf_temp-aht-ot-day.temp-cost-SLT-rubl
     2869                                                        + buf_aht-ot-line.cost-SLT-rubl
     2870           buf_temp-aht-ot-day.temp-cost-road-tax-base  = buf_temp-aht-ot-day.temp-cost-road-tax-base
     2871                                                        + buf_aht-ot-line.cost-road-tax-base
     2872           buf_temp-aht-ot-day.temp-cost-road-tax-rubl  = buf_temp-aht-ot-day.temp-cost-road-tax-rubl
     2873                                                        + buf_aht-ot-line.cost-road-tax-rubl
     2874           buf_temp-aht-ot-day.temp-cost-excise-base    = buf_temp-aht-ot-day.temp-cost-excise-base
     2875                                                        + buf_aht-ot-line.cost-excise-base
     2876           buf_temp-aht-ot-day.temp-cost-excise-rubl    = buf_temp-aht-ot-day.temp-cost-excise-rubl
     2877                                                        + buf_aht-ot-line.cost-excise-rubl
     2878           buf_temp-aht-ot-day.temp-cost-transport-base = buf_temp-aht-ot-day.temp-cost-transport-base
     2879                                                        + buf_aht-ot-line.cost-transport-base
     2880           buf_temp-aht-ot-day.temp-cost-transport-rubl = buf_temp-aht-ot-day.temp-cost-transport-rubl
     2881                                                        + buf_aht-ot-line.cost-transport-rubl
     2882           buf_temp-aht-ot-day.temp-cost-other-base     = buf_temp-aht-ot-day.temp-cost-other-base
     2883                                                        + buf_aht-ot-line.cost-other-base
     2884           buf_temp-aht-ot-day.temp-cost-other-rubl     = buf_temp-aht-ot-day.temp-cost-other-rubl
     2885                                                        + buf_aht-ot-line.cost-other-rubl
     2886           buf_temp-aht-ot-day.temp-cost-discnt-base    = buf_temp-aht-ot-day.temp-cost-discnt-base
     2887                                                        + buf_aht-ot-line.cost-discnt-base
     2888           buf_temp-aht-ot-day.temp-cost-discnt-rubl    = buf_temp-aht-ot-day.temp-cost-discnt-rubl
     2889                                                        + buf_aht-ot-line.cost-discnt-rubl
     2890           buf_temp-aht-ot-day.temp-crsa-sum-base       = buf_temp-aht-ot-day.temp-crsa-sum-base
     2891                                                        + buf_aht-ot-line.crsa-sum-base
     2892           buf_temp-aht-ot-day.temp-crsa-sum-rubl       = buf_temp-aht-ot-day.temp-crsa-sum-rubl
     2893                                                        + buf_aht-ot-line.crsa-sum-rubl
     2894           buf_temp-aht-ot-day.temp-crsa-VAT-base       = buf_temp-aht-ot-day.temp-crsa-VAT-base
     2895                                                        + buf_aht-ot-line.crsa-VAT-base
     2896           buf_temp-aht-ot-day.temp-crsa-VAT-rubl       = buf_temp-aht-ot-day.temp-crsa-VAT-rubl
     2897                                                        + buf_aht-ot-line.crsa-VAT-rubl
     2898           buf_temp-aht-ot-day.temp-crsa-SLT-base       = buf_temp-aht-ot-day.temp-crsa-SLT-base
     2899                                                        + buf_aht-ot-line.crsa-SLT-base
     2900           buf_temp-aht-ot-day.temp-crsa-SLT-rubl       = buf_temp-aht-ot-day.temp-crsa-SLT-rubl
     2901                                                        + buf_aht-ot-line.crsa-SLT-rubl
     2902           buf_temp-aht-ot-day.temp-crsa-road-tax-base  = buf_temp-aht-ot-day.temp-crsa-road-tax-base
     2903                                                        + buf_aht-ot-line.crsa-road-tax-base
     2904           buf_temp-aht-ot-day.temp-crsa-road-tax-rubl  = buf_temp-aht-ot-day.temp-crsa-road-tax-rubl
     2905                                                        + buf_aht-ot-line.crsa-road-tax-rubl
     2906           buf_temp-aht-ot-day.temp-crsa-excise-base    = buf_temp-aht-ot-day.temp-crsa-excise-base
     2907                                                        + buf_aht-ot-line.crsa-excise-base
