     1246   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1248   procedure partslib-clear-temp-parts :
     1249     define buffer buf_temp-parts for temp-parts .
     1250     do
     1251     on error undo, return error
     1252     :
     1253       for each buf_temp-parts
     1254       on error undo, return error
     1255       :
     1256         delete buf_temp-parts .
     1257       end.
     1258     end.
     1259   end procedure.
     1260   procedure partslib-create-temp-parts :
     1261     define parameter buffer buf_parts       for ub.parts .
     1262     define parameter buffer buf_temp-parts  for temp-parts .
     1263     define input  parameter p-goods-twounit as logical   no-undo .
     1264     define variable v-base-part-code as character no-undo .
     1265     do
     1266     on error undo, return error
     1267     :
     1268       if p-goods-twounit = true
     1269       then do:
     1270         assign
     1271           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1272         .
     1273       end.
     1274       else do:
     1275         assign
     1276           v-base-part-code = buf_parts.part-code
     1277         .
     1278       end.
     1279       find first buf_temp-parts exclusive-lock
     1280         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1281           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1282           and buf_temp-parts.artic     = buf_parts.artic
     1283           and buf_temp-parts.prod-type = buf_parts.prod-type
     1284           and buf_temp-parts.prod-code = buf_parts.prod-code
     1285           and buf_temp-parts.in-code   = buf_parts.in-code
     1286           and buf_temp-parts.out-code  = 'free-zone':U
     1287           and buf_temp-parts.part-code = v-base-part-code
     1288         no-error.
     1289       if not available buf_temp-parts
     1290       then do:
     1291         create buf_temp-parts .
     1292         buffer-copy buf_parts to buf_temp-parts
     1293         assign
     1294           buf_temp-parts.out-code  = 'free-zone':U
     1295           buf_temp-parts.part-code = v-base-part-code
     1296           buf_temp-parts.rsrv-free = yes
     1297           buf_temp-parts.status_   = no
     1298           buf_temp-parts.qnty      = 0
     1299           buf_temp-parts.fact-qnty = 0
     1300           buf_temp-parts.real-qnty = 0
     1301           buf_temp-parts.cli-qnty  = 0
     1302         .
     1303       end.
     1304     end.
     1305   end procedure.
     1306   procedure partslib-init-temp-parts :
     1307     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1308     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1309     define input parameter p-artic           like ub.parts.artic     no-undo .
     1310     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1311     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1312     define buffer buf_parts      for ub.parts .
     1313     define buffer buf_temp-parts for temp-parts .
     1314     define variable v-goods-twounit    as logical   no-undo .
     1315     do
     1316     on error undo, return error
     1317     :
     1318   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1320     (input  p-artic
     1321     ,input  p-prod-type
     1322     ,input  p-prod-code
     1323     ,input  'twounit=request':u
     1324     ,output v-goods-twounit
     1325     ) no-error .
     1326       if error-status :error
     1327       then do:
     1328         message
     1329           vss-workfile vss-revision vss-description skip
     1330           vss-include-info6 skip
     1331           "Ошибка при определении атрибута товара" skip
     1332           "Артикул" p-artic p-prod-type p-prod-code skip
     1333           "twounit=request" skip
     1334           error-status :get-message(1) skip
     1335           return-value skip
     1336           view-as alert-box error .
     1337         undo, return error return-value .
     1338       end.
     1339       run partslib-clear-temp-parts in this-procedure .
     1340       for each buf_parts
     1341         where buf_parts.obj-type  = p-obj-type
     1342           and buf_parts.obj-code  = p-obj-code
     1343           and buf_parts.artic     = p-artic
     1344           and buf_parts.prod-type = p-prod-type
     1345           and buf_parts.prod-code = p-prod-code
     1346           and buf_parts.rsrv-free = yes
     1347           and buf_parts.status_   = no
     1348           and buf_parts.in-code   <> buf_parts.out-code
     1349       on error undo, return error
     1350       :
     1351         run partslib-create-temp-parts in this-procedure
     1352           (buffer buf_parts
     1353           ,buffer buf_temp-parts
     1354           ,input  v-goods-twounit
     1355           ) .
     1356         define variable v-parts-qnty          as decimal   no-undo .
     1357         define variable v-parts-cli-qnty      as decimal   no-undo .
     1358         define variable v-parts-free-qnty     as decimal   no-undo .
     1359         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1360         if buf_parts.out-code = 'free-zone':U
     1361         then do:
     1362           assign
     1363             v-parts-qnty          = buf_parts.qnty
     1364             v-parts-cli-qnty      = buf_parts.cli-qnty
     1365             v-parts-free-qnty     = buf_parts.qnty
     1366             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1367           .
     1368         end.
     1369         else do:
     1370           assign
     1371             v-parts-qnty          = abs(buf_parts.qnty)
     1372             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1373             v-parts-free-qnty     = 0
     1374             v-parts-free-cli-qnty = 0
     1375           .
     1376         end.
     1377         assign
     1378           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1379           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1380           buf_temp-parts.real-qnty     = 0
     1381           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1382           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1383           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1384         .
     1385       end.
     1386     end.
     1387   end procedure.
     1388   procedure partslib-init-temp-parts-by-factord :
     1389     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1390     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1391     define input parameter p-artic              like ub.parts.artic     no-undo .
     1392     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1393     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1394     define input parameter p-fact-order         as decimal   no-undo .
     1395     define input parameter p-include-fact-order as logical   no-undo .
     1396     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1397     define buffer buf_gds-obj  for ub.gds-obj .
     1398     do
     1399     on error undo, return error
     1400     :
     1401       do transaction
     1402       on error undo, return error
     1403       :
     1404   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1406     (input  p-obj-type
     1407     ,input  p-obj-code
     1408     ,input  p-artic
     1409     ,input  p-prod-type
     1410     ,input  p-prod-code
     1411     ,buffer buf_gds-obj
     1412     ) no-error .
     1413         if error-status :error
     1414         then do:
     1415           message
     1416             vss-workfile vss-revision vss-description skip
     1417             vss-include-info6 skip
     1418             "Невозможно найти товар на объекте" skip
     1419             "Объект" p-obj-type p-obj-code skip
     1420             "Артикул" p-artic p-prod-type p-prod-code skip
     1421             error-status :get-message(1) skip
     1422             return-value skip
     1423             view-as alert-box error .
     1424           undo, return error .
     1425         end.
     1426         find current buf_gds-obj exclusive-lock .
     1427       end.
     1428       run partslib-init-temp-parts in this-procedure
     1429         (input p-obj-type
     1430         ,input p-obj-code
     1431         ,input p-artic
     1432         ,input p-prod-type
     1433         ,input p-prod-code
     1434         ) no-error .
     1435       if error-status :error
     1436       then do:
     1437         message
     1438           vss-workfile vss-revision vss-description skip
     1439           vss-include-info6 skip
     1440           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1441           "Объект" p-obj-type p-obj-code skip
     1442           "Артикул" p-artic p-prod-type p-prod-code skip
     1443           "p-fact-order" p-fact-order skip
     1444           view-as alert-box error .
     1445         undo, return error .
     1446       end.
     1447       if p-include-fact-order = true
     1448       then do:
     1449         assign
     1450           p-fact-order = p-fact-order - 0.0000000001
     1451         .
     1452       end.
     1453       define variable v-max-fact-order as character no-undo .
     1454       run factord-max-fact-order in this-procedure
     1455         (output v-max-fact-order
     1456         ) no-error .
     1457       if error-status :error
     1458       then do:
     1459         message
     1460           vss-workfile vss-revision vss-description skip
