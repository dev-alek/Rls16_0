        1   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        2   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        3   define variable vss-date        as character no-undo init "$Date: Oct 29 2025 $":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile: run_fix_bts-2056.p $":U .
        5   define variable vss-archive     as character no-undo init "$Archive: utl/run_fix_bts-2056.p $".
        6   define variable vss-description as character no-undo init "Автозапуск утилиты для BTS-2056.".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure factord :
       69     define input  parameter p-fact-date            as date    no-undo .
       70     define input  parameter p-fact-time            as integer no-undo .
       71     define input  parameter p-fact-num             as integer no-undo .
       72     define input  parameter p-shift-date           as date    no-undo .
       73     define input  parameter p-shift-num            as integer no-undo .
       74     define input  parameter p-shift-on             as logical no-undo .
       75     define output parameter p-fact-order           as decimal no-undo .
       76     define output parameter p-shift-end-fact-order as decimal no-undo .
       77     define output parameter p-day-end-fact-order   as decimal no-undo .
       78     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       79     if p-fact-date = ?
       80     then do:
       81       return error "Не указана фактическая дата" .
       82     end.
       83     define variable v-fact-date-num as integer no-undo .
       84     assign
       85       v-fact-date-num = integer(p-fact-date)
       86     .
       87     if p-fact-num = ?
       88     or p-fact-num = 0
       89     then do:
       90       return error "Не задан p-fact-num " + string(p-fact-num) .
       91     end.
       92     if p-fact-num < 0
       93     then do:
       94       return error "Отрицательный fact-num " + string(p-fact-num) .
       95     end.
       96     if p-fact-num >= 100000000
       97     then do:
       98       return error "Недопустимо большой fact-num " + string(p-fact-num) .
       99     end.
      100     if p-shift-on = true
      101     then do:
      102       if p-shift-date = ?
      103       then do:
      104         return error "Не задана дата смены" .
      105       end.
      106       if p-shift-num = ?
      107       or p-shift-num = 0
      108       then do:
      109         return error "Не задан номер смены" .
      110       end.
      111     end.
      112     else do:
      113       assign
      114         p-shift-date = p-fact-date
      115         p-shift-num  = 24
      116       .
      117     end.
      118     define variable v-shift-offset as integer no-undo .
      119     if p-shift-date = p-fact-date
      120     then do:
      121       assign
      122         v-shift-offset = 1
      123       .
      124     end.
      125     if p-shift-date < p-fact-date
      126     then do:
      127       assign
      128         v-shift-offset = 0
      129       .
      130     end.
      131     if p-shift-date > p-fact-date
      132     then do:
      133       message
      134         vss-workfile vss-revision vss-description skip
      135         "Неправильная дата закрытия смены" skip
      136         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      137         view-as alert-box error .
      138       undo, return error
      139         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      140           ,string(p-fact-date, '99/99/9999':U)
      141           ,string(p-shift-date, '99/99/9999':U)
      142           )
      143       .
      144     end.
      145     if p-shift-num < 1
      146     or p-shift-num > 24
      147     then do:
      148       message
      149         vss-workfile vss-revision vss-description skip
      150         "Неправильный номер смены" skip
      151         "p-shift-num" p-shift-num skip
      152         view-as alert-box error .
      153       undo, return error return-value .
      154     end.
      155     assign
      156       p-fact-order           = v-fact-date-num
      157                              + v-shift-offset * 0.5
      158                              + p-shift-num    * 0.02 - 0.01
      159                              + p-fact-num     * 0.0000000001
      160       p-shift-end-fact-order = v-fact-date-num
      161                              + v-shift-offset * 0.5
      162                              + p-shift-num    * 0.02
      163       p-day-end-fact-order   = v-fact-date-num
      164                              + 0.99
      165     .
      166     if p-fact-order           <= v-fact-date-num
      167     or p-shift-end-fact-order <= v-fact-date-num
      168     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      169     or p-shift-end-fact-order >= p-day-end-fact-order
      170     then do:
      171       message
      172         vss-workfile vss-revision vss-description skip
      173         "Внутренняя ошибка при генерации фактического номера" skip
      174         "p-fact-date"            p-fact-date            skip
      175         "p-fact-time"            p-fact-time            skip
      176         "p-fact-num"             p-fact-num             skip
      177         "p-shift-date"           p-shift-date           skip
      178         "p-shift-num"            p-shift-num            skip
      179         "p-shift-on"             p-shift-on             skip
      180         "p-shift-end-fact-order" p-shift-end-fact-order skip
      181         "p-day-end-fact-order"   p-day-end-fact-order   skip
      182         "v-fact-date-num"        v-fact-date-num        skip
      183         view-as alert-box error .
      184       undo, return error return-value .
      185     end.
      186   end procedure.
      187   procedure day-begin-fact-order :
      188     define input  parameter p-fact-date            as date    no-undo .
      189     define output parameter p-day-begin-fact-order as decimal no-undo .
      190     do
      191     on error undo, return error return-value
      192     :
      193       if p-fact-date = ?
      194       then do:
      195         assign
      196           p-day-begin-fact-order = 0
      197         .
      198       end.
      199       else do:
      200         assign
      201           p-day-begin-fact-order = integer(p-fact-date)
      202         .
      203       end.
      204     end.
      205   end procedure.
      206   procedure factord-max-fact-order :
      207     define output parameter p-max-fact-order as decimal   no-undo .
      208     do
      209     on error undo, return error return-value
      210     :
      211       run day-begin-fact-order in this-procedure
      212         (input  date(1, 1, 5000)
      213         ,output p-max-fact-order
      214         ) .
      215     end.
      216   end procedure.
      217   procedure factord-cut-archive :
      218     define input  parameter p-obj-type             as character no-undo .
      219     define input  parameter p-obj-code             as integer   no-undo .
      220     define input  parameter p-fact-date            as date      no-undo .
      221     define output parameter p-shift-on             as logical   no-undo .
      222     define output parameter p-shift-date           as date      no-undo .
      223     define output parameter p-shift-num            as integer   no-undo .
      224     define output parameter p-day-end-fact-order   as decimal   no-undo .
      225     define output parameter p-shift-end-fact-order as decimal   no-undo .
      226     define variable v-fact-order as decimal   no-undo .
      227     define buffer buf_shift-obj for ub.shift-obj .
      228     do
      229     on error undo, return error return-value
      230     :
      231   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      233     (input  p-obj-type
      234     ,input  p-obj-code
      235     ,input  'shift-on=request'
      236     ,output p-shift-on
      237     ) no-error .
      238       if error-status :error
      239       then do:
      240         message
      241           vss-workfile vss-revision vss-description skip
      242           "Ошибка при определении атрибута объекта" skip
      243           "Объект" p-obj-type p-obj-code skip
      244           error-status :get-message(1) skip
      245           return-value skip
      246           view-as alert-box error .
      247         undo, return error return-value .
      248       end.
      249       if p-shift-on = false
      250       then do:
      251         assign
      252           p-shift-date               = ?
      253           p-shift-num                = 0
      254         .
      255       end.
      256       else do:
      257         find first buf_shift-obj share-lock
      258           where buf_shift-obj.obj-type   = p-obj-type
      259             and buf_shift-obj.obj-code   = p-obj-code
      260             and buf_shift-obj.shift-date > p-fact-date
      261           use-index pi
      262           no-error .
      263         if not available buf_shift-obj
      264         or buf_shift-obj.status_ <> 'зкр':U
      265         then do:
      266           message
      267             vss-workfile vss-revision vss-description skip
      268             "Невозможно вычислить последнюю смену" skip
      269             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      270             "Объект" p-obj-type p-obj-code skip
      271             "Дата" p-fact-date skip
      272             view-as alert-box error .
      273           undo, return error return-value .
      274         end.
      275         find last buf_shift-obj share-lock
      276           where buf_shift-obj.obj-type = p-obj-type
      277             and buf_shift-obj.obj-code = p-obj-code
      278             and buf_shift-obj.shift-date <= p-fact-date
      279           use-index pi
      280           no-error .
      281         if available buf_shift-obj
      282         then do:
      283           if  buf_shift-obj.status_ = 'зкр':U
      284           then do:
      285             assign
      286               p-shift-date = buf_shift-obj.shift-date
      287               p-shift-num  = buf_shift-obj.shift-num
      288             .
      289           end.
      290           else do:
      291             message
      292               vss-workfile vss-revision vss-description skip
      293               "Невозможно вычислить последнюю смену" skip
      294               "Статус смены отличен от статуса" 'зкр':U skip
      295               "Объект" p-obj-type p-obj-code skip
      296               "Дата" p-fact-date skip
      297               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      298               view-as alert-box error .
      299             undo, return error return-value .
      300           end.
      301         end.
      302         else do:
      303           assign
      304             p-shift-date = p-fact-date - 1
      305             p-shift-num  = 1
      306           .
      307         end.
      308       end.
      309       run factord in this-procedure
      310         (input  p-fact-date
      311         ,input  1
      312         ,input  1
      313         ,input  p-shift-date
      314         ,input  p-shift-num
      315         ,input  p-shift-on
      316         ,output v-fact-order
      317         ,output p-shift-end-fact-order
      318         ,output p-day-end-fact-order
      319         ) no-error .
      320       if error-status :error
      321       then do:
      322         message
      323           vss-workfile vss-revision vss-description skip
      324           "Ошибка при вызове процедуры factord"
      325           error-status :get-message(1) skip
      326           return-value skip
      327           view-as alert-box error .
      328         undo, return error return-value .
      329       end.
      330     end.
      331   end procedure.
      332   procedure factord-lock-shift :
      333     define input  parameter p-obj-type  as character no-undo .
      334     define input  parameter p-obj-code  as integer   no-undo .
      335     define input  parameter p-fact-date as date      no-undo .
      336     define parameter buffer buf_shift-obj for ub.shift-obj .
      337     define variable v-shift-on      as logical   no-undo .
      338     define variable v-extra-message as character no-undo .
      339     define variable v-error as character no-undo .
      340     do
      341     on error undo, return error return-value
      342     :
      343   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      345     (input  p-obj-type
      346     ,input  p-obj-code
      347     ,input  'shift-on=request'
      348     ,output v-shift-on
      349     ) no-error .
      350       if error-status :error
      351       then do:
      352         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      353         undo, return error v-error .
      354       end.
      355       if v-shift-on = true
      356       then do:
      357         find first buf_shift-obj share-lock
      358           where buf_shift-obj.obj-type   = p-obj-type
      359             and buf_shift-obj.obj-code   = p-obj-code
      360             and buf_shift-obj.shift-date > p-fact-date
      361           use-index pi
      362           no-error .
      363         if not available buf_shift-obj
      364         or buf_shift-obj.status_ <> 'зкр':U
      365         then do:
      366           find last buf_shift-obj
      367             where buf_shift-obj.obj-type = p-obj-type
      368               and buf_shift-obj.obj-code = p-obj-code
      369               and buf_shift-obj.status_  = 'зкр':U
      370             use-index stts
      371             no-error .
      372           if available buf_shift-obj
      373           then do:
      374             assign
      375               v-extra-message =
      376                     substitute("Дата начала последеней закрытой смены на объекте &1"
      377                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      378                               )
      379             .
      380           end.
      381           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      382           undo, return error v-error .
      383         end.
      384       end.
      385     end.
      386   end procedure.
      387   procedure factord-end-day :
      388     define input  parameter p-fact-date            as date    no-undo .
      389     define output parameter p-day-end-fact-order   as decimal no-undo .
      390     do
      391     on error undo, return error return-value
      392     :
      393       if p-fact-date = ?
      394       then do:
      395         return error "Не указана фактическая дата" .
      396       end.
      397       assign
      398         p-day-end-fact-order = integer(p-fact-date) + 0.99
      399       .
      400     end.
      401   end procedure.
      402   procedure factord-to-date :
      403     define input  parameter p-fact-order as decimal no-undo .
      404     define output parameter p-fact-date  as date    no-undo .
      405     define variable v-ref-date  as date      no-undo .
      406     define variable v-ref-delta as integer   no-undo .
      407     do
      408     on error undo, return error return-value
      409     :
      410       if p-fact-order = ?
      411       or p-fact-order = 0
      412       then do:
      413         return error "Не указан fact-order" .
      414       end.
      415       assign
      416         v-ref-date  = date(1, 1, 2000)
      417       .
      418       assign
      419         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      420       .
      421       assign
      422         p-fact-date = v-ref-date + v-ref-delta
      423       .
      424     end.
      425   end procedure.
      426   procedure factord-to-fact-num :
      427     define input  parameter p-fact-order as decimal no-undo .
      428     define output parameter p-fact-num   as integer no-undo .
      429     define variable v-fact-order-trunc as decimal no-undo .
      430     do
      431     on error undo, return error return-value
      432     :
      433       if p-fact-order = ?
      434       or p-fact-order = 0
      435       then do:
      436         return error "Не указан fact-order" .
      437       end.
      438       assign
      439        v-fact-order-trunc = truncate(p-fact-order, 2)
      440       .
      441       assign
      442         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      443       .
      444     end.
      445   end procedure.
      446   procedure factord-to-shift-num :
      447     define input  parameter p-fact-order as decimal no-undo .
      448     define output parameter p-shift-num   as integer no-undo .
      449     define variable  p-shift-numd  as decimal   no-undo .
      450     define variable v-fact-order-trunc as decimal no-undo .
      451     do
      452     on error undo, return error return-value
      453     :
      454       if p-fact-order = ?
      455       or p-fact-order = 0
      456       then do:
      457         return error "Не указан fact-order" .
      458       end.
      459       assign
      460        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      461       .
      462       if v-fact-order-trunc < 0.5 then do:
      463         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      464       end.
      465       assign
      466         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      467         .
      468        assign
      469         p-shift-num = truncate (p-shift-numd , 0)
      470       .
      471     end.
      472   end procedure.
      473   define variable v-fact-date  as date no-undo init 01/01/2026.
      474   define variable v-fact-order as decimal no-undo .
      475   define buffer tax-rate-gds     for ub.tax-rate-gds.
      476   define buffer buf_tax-rate-gds for ub.tax-rate-gds.
      477   define buffer tax-rate-gds-grp for ub.tax-rate-gds-grp.
      478   define buffer sys-ctrl         for ub.sys-ctrl.
      479   define buffer buf_code         for ub.code.
      480   find first sys-ctrl no-lock.
      481   run factord-end-day in this-procedure (
      482       input v-fact-date
      483      ,output v-fact-order).
      484   for each tax-rate-gds no-lock where
      485            tax-rate-gds.tax-code  = 1
      486        and tax-rate-gds.rate-code = 1
      487   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      488   :
      489     find first buf_tax-rate-gds exclusive-lock where
      490                buf_tax-rate-gds.gds-code = tax-rate-gds.gds-code
      491            and buf_tax-rate-gds.tax-code = tax-rate-gds.tax-code
      492            and buf_tax-rate-gds.host-code = tax-rate-gds.host-code
      493            and buf_tax-rate-gds.obj-type = tax-rate-gds.obj-type
      494            and buf_tax-rate-gds.obj-code = tax-rate-gds.obj-code
      495            and buf_tax-rate-gds.fact-order = v-fact-order
      496     no-error.
      497     if not avail buf_tax-rate-gds then
      498     do:
      499       create buf_tax-rate-gds.
      500       buffer-copy tax-rate-gds
      501         except chip-num corr-time corr-user-db-num corr-user-name corr-date
      502         to buf_tax-rate-gds
      503         assign
      504           buf_tax-rate-gds.fact-date = v-fact-date
      505           buf_tax-rate-gds.fact-order = v-fact-order
      506       .
      507     end.
      508     if buf_tax-rate-gds.rate-code <> 11 then
      509       buf_tax-rate-gds.rate-code = 11.
      510   end.
      511   for each tax-rate-gds-grp exclusive-lock where
      512            tax-rate-gds-grp.tax-code  = 1
      513        and tax-rate-gds-grp.rate-code = 1
      514   :
      515     tax-rate-gds-grp.rate-code = 11.
      516   end.
      517   find first buf_code exclusive-lock where
      518              buf_code.parent = substitute("RunUtils&1&2",chr(4),sys-ctrl.db-num)
      519          and buf_code.code = "nds22" no-error.
      520   if not avail buf_code then
      521   do:
      522     find first buf_code no-lock where
      523                buf_code.parent = "RunUtil"
      524            and buf_code.code = string(sys-ctrl.db-num) no-error.
      525     if not avail buf_code then
      526     do:
      527       create buf_code.
      528       assign
      529         buf_code.parent = "RunUtils"
      530         buf_code.code   = string(sys-ctrl.db-num)
      531         buf_code.CodeName = "БД " + string(sys-ctrl.db-num)
      532         buf_code.export_  = yes
      533         buf_code.status_  = 0
      534         buf_code.nwsubd   = yes
      535       .
      536     end.
      537     create buf_code.
      538     assign
      539       buf_code.parent = substitute("RunUtils&1&2",chr(4),sys-ctrl.db-num)
      540       buf_code.code   = "nds22"
      541       buf_code.CodeName = vss-description
      542       buf_code.export_  = yes
      543       buf_code.status_  = 0
      544       buf_code.nwsubd   = yes
      545     .
      546   end.
      547   buf_code.CodeValue = entry(1,string(datetime(today, mtime)),".").
      548   run utl\proc-msg.p (" Внимание! Проведено изменение ставки НДС у товаров с 20% на 22%. Необходимо передать информацию по налоговым ставкам и товарам на все кассы!") no-error.
