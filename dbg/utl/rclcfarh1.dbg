      492   DEFINE BUTTON b-doc-type
      493        LABEL "Изменить"
      494        SIZE 20 BY .96.
      495   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      496        LABEL "Отмена"
      497        SIZE 15 BY 1.13
      498        BGCOLOR 8 .
      499   DEFINE BUTTON Btn_OK AUTO-GO
      500        LABEL "Выполнить"
      501        SIZE 15 BY 1.13
      502        BGCOLOR 8 .
      503   DEFINE VARIABLE x-doc-type AS CHARACTER
      504        VIEW-AS SELECTION-LIST SINGLE NO-DRAG SCROLLBAR-VERTICAL
      505        LIST-ITEM-PAIRS "< ВСЕ > "," ''"
      506        SIZE 43 BY 6 NO-UNDO.
      507   DEFINE VARIABLE x-fin-ob AS LOGICAL INITIAL no
      508        LABEL "Учитывать архивы по фин. обязательствам"
      509        VIEW-AS TOGGLE-BOX
      510        SIZE 43 BY 1 NO-UNDO.
      511   DEFINE FRAME Dialog-Frame
      512        b-doc-type AT ROW 1.5 COL 26 WIDGET-ID 16
      513        x-doc-type AT ROW 2.54 COL 3 NO-LABEL WIDGET-ID 12
      514        x-fin-ob AT ROW 8.92 COL 3.13 WIDGET-ID 18
      515        Btn_OK AT ROW 10.63 COL 5
      516        Btn_Cancel AT ROW 10.63 COL 28
      517        "Типы архивов:" VIEW-AS TEXT
      518             SIZE 16 BY .63 AT ROW 1.58 COL 3 WIDGET-ID 14
      519             FGCOLOR 4
      520        SPACE(32.24) SKIP(10.53)
      521       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      522            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      523            TITLE "Утилита пересчета фин. архивов"
      524            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      525   ASSIGN
      526          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      527          FRAME Dialog-Frame:HIDDEN           = TRUE.
      528   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      529   DO:
      530     APPLY "END-ERROR":U TO SELF.
      531   END.
      532   ON CHOOSE OF b-doc-type IN FRAME Dialog-Frame
      533   DO:
      534   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   if lookup(self :type
      536            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      537            ) = 0
      538   then do:
      539     message
      540       "$Workfile$"
      541       "Указанному интерфейсному элементу фокус не может быть передан" skip
      542       "Интерфейсный элемент" self :name  skip
      543       "Тип" self :type  skip
      544       "Процедура" this-procedure :file-name skip
      545       view-as alert-box .
      546   end.
      547   else do:
      548     apply "entry":u to self  .
      549     if focus :handle <> self :handle  then do:
      550       return no-apply .
      551     end.
      552   end.
      553     run select-doc-type in this-procedure no-error.
      554     if error-status:error then do:
      555       return no-apply.
      556     end.
      557     v-sel-type = true.
      558   END.
      559   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      560   DO:
      561     define variable glog as logical no-undo .
      562     assign x-fin-ob.
      563       run utl/rclcfarh.p(
      564         input v-cntxt-host-code-obj,
      565         input x-fin-ob,
      566         input v-list)
      567       .
      568     message "Готово!" view-as alert-box.
      569   END.
      570   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      571   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      572   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573     run mainmenu_getcntxt in parparentproc
      574       (output v-cntxt-db-num
      575       ,output v-cntxt-userid
      576       ,output v-cntxt-level
      577       ,output v-cntxt-host-code-obj
      578       ,output v-cntxt-obj-type
      579       ,output v-cntxt-obj-code
      580       ,output v-cntxt-db-num-obj
      581       ,output v-cntxt-is-admin
      582       ) .
      583   MAIN-BLOCK:
      584   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      585      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      586     RUN enable_UI.
      587     WAIT-FOR GO OF FRAME Dialog-Frame.
      588   END.
      589   RUN disable_UI.
      590   PROCEDURE disable_UI :
      591     HIDE FRAME Dialog-Frame.
      592   END PROCEDURE.
      593   PROCEDURE enable_UI :
      594     DISPLAY x-doc-type x-fin-ob
      595         WITH FRAME Dialog-Frame.
      596     ENABLE b-doc-type x-doc-type x-fin-ob Btn_OK Btn_Cancel
      597         WITH FRAME Dialog-Frame.
      598     VIEW FRAME Dialog-Frame.
      599   END PROCEDURE.
      600   PROCEDURE proc-sel-host :
      601     do
      602     on error undo, return error return-value
      603     :
      604   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   run userhsts_select-one in this-procedure
      606     (input  parparentproc
      607     ,input  v-cntxt-db-num
      608     ,input  v-cntxt-userid
      609     ,input  v-cntxt-host-code-obj
      610     ,output v-user-select
      611     ,output v-select-host-code
      612     )  .
      613     end.
      614   END PROCEDURE.
      615   PROCEDURE select-doc-type :
      616       define variable v-counter       as integer      no-undo.
      617       define variable v-label         as character    no-undo.
      618       define variable v-value         as character    no-undo.
      619       define variable v-changed       as logical    no-undo.
      620       define variable v-accepted      as logical    no-undo.
      621       define variable v-list-edt      as character    no-undo.
      622       define variable v-list-edt-full as character    no-undo.
      623   do
      624   with frame Dialog-Frame
      625   on error undo, return error
      626   :
      627         assign
      628             v-list-edt  = 'arh-fin-doc-an':U
      629                 + ",":U + 'arh-fin-doc-an-nal':U
      630                 + ",":U + 'arh-fin-doc-an-nal-obj':U
      631                 + ",":U + 'arh-fin-doc-an-obj':U
      632                 + ",":U + 'arh-fin-doc-c-s-tax-nal-obj':U
      633                 + ",":U + 'arh-fin-doc-c-schet-tax-nal':U
      634                 + ",":U + 'arh-fin-doc-contr-s-nal-obj':U
      635                 + ",":U + 'arh-fin-doc-contr-s-tax-obj':U
      636                 + ",":U + 'arh-fin-doc-contr-schet':U
      637                 + ",":U + 'arh-fin-doc-contr-schet-nal':U
      638                 + ",":U + 'arh-fin-doc-contr-schet-obj':U
      639                 + ",":U + 'arh-fin-doc-contr-schet-tax':U
      640                 + ",":U + 'arh-fin-doc-s-tax-nal-obj':U
      641                 + ",":U + 'arh-fin-doc-schet':U
      642                 + ",":U + 'arh-fin-doc-schet-nal':U
      643                 + ",":U + 'arh-fin-doc-schet-nal-obj':U
      644                 + ",":U + 'arh-fin-doc-schet-obj':U
      645                 + ",":U + 'arh-fin-doc-schet-tax':U
      646                 + ",":U + 'arh-fin-doc-schet-tax-nal':U
      647                 + ",":U + 'arh-fin-doc-schet-tax-obj':U
      648         .
      649         assign
      650             v-list-edt-full   = 'Архив по счету по кодам':U
      651                       + ",":U + 'Архив по налсчету по кодам':U
      652                       + ",":U + 'Архив по налсчету по кодам по объектам':U
      653                       + ",":U + 'Архив по счету по кодам по объекту':U
      654                       + ",":U + 'Архив по нал.плат.догов.налоги по объектам':U
      655                       + ",":U + 'Архив по нал.плат.догов.налоги':U
      656                       + ",":U + 'Архивы по плат. налсч. по дог.':U
      657                       + ",":U + 'Архив по платеж. догов.налоги':U
      658                       + ",":U + 'Архивы по плат. счета по дог.':U
      659                       + ",":U + 'Архивы по плат. налсч. по дог.':U
      660                       + ",":U + 'Архивы по плат. счета по дог. по объекту':U
      661                       + ",":U + 'Архив по платеж. догов.налоги':U
      662                       + ",":U + 'Архив по платеж. налсчета нало':U
      663                       + ",":U + 'Архив по платежам по счету':U
      664                       + ",":U + 'Архив по платежам по налсчету':U
      665                       + ",":U + 'Архив по платежам по налсчету':U
      666                       + ",":U + 'Архив по платежам по счету по объекту':U
      667                       + ",":U + 'Архив по платеж. счета налоги':U
      668                       + ",":U + 'Архив по платеж. налсчета нало':U
      669                       + ",":U + 'Архив по платеж. счета налоги по объектам':U
      670         .
      671       run twowin_clear in this-procedure.
      672       do v-counter = 1 to num-entries( v-list-edt-full )
      673       on error undo, return error
      674       :
      675           assign
      676               v-label = entry( v-counter, v-list-edt-full )
      677               v-value = entry( v-counter, v-list-edt )
      678           .
      679           run twowin_add-item in this-procedure (
      680                 input v-value
      681               , input v-label
      682               , input substitute( "Код вида документа: &1", v-value )
      683               , input ( x-doc-type :lookup( v-value ) <> 0 or x-doc-type :list-item-pairs = "< Все >,''":U  )
      684           ).
      685       end.
      686       run gbl/twowin.w (
      687             input ?
      688           , input 1
      689           , input "Выбор типов финансовых архивов":U
      690           , input "":U
      691           , input "&Тест"
      692           , input table temp_twowin_items
      693           , output table temp_twowin_itemsSelected
      694           , output v-changed
      695           , output v-accepted
      696       ).
      697       do:
      698           assign
      699               x-doc-type :list-item-pairs    = "< ВСЕ >,''":U
      700               v-list                          = "":U
      701               v-counter = 0
      702           .
      703           for each temp_twowin_itemsSelected
      704           by temp_twowin_itemsSelected.itm-key
      705           :
      706               assign
      707                   v-counter = v-counter + 1
      708                   v-list = substitute( "&1&2&3"
      709                                   , v-list
      710                                   , ( if v-list = "":U then "":U else ",":U )
      711                                   , temp_twowin_itemsSelected.itmExtKey
      712                                   )
      713               .
      714               if v-counter = 1
      715               then do:
      716                   assign
      717                       x-doc-type :list-item-pairs    = substitute( "&1,&2"
      718                                           , entry( lookup( temp_twowin_itemsSelected.itmExtKey, v-list-edt ), v-list-edt-full )
      719                                           , temp_twowin_itemsSelected.itmExtKey
      720                                                )
      721                   .
      722               end.
      723               else do:
      724                   x-doc-type :add-last (
      725                       entry( lookup( temp_twowin_itemsSelected.itmExtKey, v-list-edt ), v-list-edt-full )
      726                       , temp_twowin_itemsSelected.itmExtKey
      727                   ).
      728               end.
      729           end.
      730           if v-list = v-list-edt
      731           then do:
      732               assign
      733                   x-doc-type :list-item-pairs = "< ВСЕ >,''":U
      734               .
      735           end.
      736       end.
      737   end.
      738   END PROCEDURE.
