      121     do
      122     on error undo, return error return-value
      123     :
      124       find first buf_userhsts_temp-user-host
      125         no-error .
      126       if not available buf_userhsts_temp-user-host
      127       then do:
      128         assign
      129           p-object-exist = false
      130         .
      131       end.
      132       else do:
      133         assign
      134           p-object-exist = true
      135         .
      136       end.
      137     end.
      138   end procedure.
      139   procedure userhsts_transfer :
      140     define input  parameter p-callback-handle as handle no-undo .
      141     define variable vss-description as character no-undo init "userhsts_transfer: Передача списка объектов".
      142     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      143     do
      144     on error undo, return error return-value
      145     :
      146       if valid-handle(p-callback-handle) <> true
      147       then do:
      148         message
      149           vss-workfile vss-revision vss-description skip
      150           "Ошибка задания входных параметров" skip
      151           "Неизвестный указатель на процедуру" skip
      152           view-as alert-box error .
      153         undo, return error return-value .
      154       end.
      155       if p-callback-handle :get-signature("userhsts_append") = ""
      156       then do:
      157         message
      158           vss-workfile vss-revision vss-description skip
      159           "Ошибка задания входных параметров" skip
      160           substitute("В процедуре &1 не найдена внутренняя процедура userhsts_append"
      161                     ,p-callback-handle :file-name
      162                     ) skip
      163           view-as alert-box error .
      164         undo, return error return-value .
      165       end.
      166       for each buf_userhsts_temp-user-host
      167       on error undo, return error return-value
      168       :
      169         run userhsts_append in p-callback-handle
      170           (input  buf_userhsts_temp-user-host.host-code
      171           ) .
      172       end.
      173     end.
      174   end procedure.
