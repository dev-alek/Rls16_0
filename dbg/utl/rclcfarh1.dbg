       96         .
       97       end.
       98     end.
       99   end procedure.
      100   procedure userhsts_append :
      101     define input  parameter p-host-code as integer   no-undo .
      102     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      103     do
      104     on error undo, return error return-value
      105     :
      106       find first buf_userhsts_temp-user-host
      107         where buf_userhsts_temp-user-host.host-code = p-host-code
      108         no-error .
      109       if not available buf_userhsts_temp-user-host
      110       then do:
      111         create buf_userhsts_temp-user-host .
      112         assign
      113           buf_userhsts_temp-user-host.host-code = p-host-code
      114         .
      115       end.
      116     end.
      117   end procedure.
      118   procedure userhsts_object-exist :
      119     define output parameter p-object-exist as logical   no-undo .
