       82   procedure userhsts_object-count :
       83     define output parameter p-total-count as integer   no-undo .
       84     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
       85     do
       86     on error undo, return error return-value
       87     :
       88       assign
       89         p-total-count = 0
       90       .
       91       for each buf_userhsts_temp-user-host
       92       on error undo, return error return-value
       93       :
