        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: prdocdel.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/prdocdel.p $":U .
        7   define variable vss-description as character no-undo init "Удаление незакрытых переоценок".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure cur-time :
       79      define output parameter p-today as date      no-undo .
       80      define output parameter p-time  as integer   no-undo .
       81     do
       82     on error undo, return error
       83     :
       84       define variable v-date1 as date      no-undo .
       85       define variable v-date2 as date      no-undo .
       86       define variable v-time  as integer   no-undo .
       87       assign
       88         v-date1 = today
       89         v-time  = time
       90         v-date2 = today
       91       .
       92       if v-date1 <> v-date2
       93       then do:
       94         assign
       95           v-date1 = today
       96           v-time  = v-time
       97         .
       98       end.
       99       assign
      100         p-today = v-date1
      101         p-time  = v-time
      102       .
      103     end.
      104   end.
      105   function cur-time-date returns character
      106   :
      107     return string(today, '99/99/9999':U) .
      108   end.
      109   function cur-time-mjd returns decimal
      110   :
      111     define variable v-date as date      no-undo .
      112     define variable v-time as integer   no-undo .
      113     run cur-time in this-procedure
      114       (output v-date
      115       ,output v-time
      116       ) .
      117     return integer(v-date) - 2400002 + (v-time / 86400) .
      118   end.
      119   function cur-time-get-ending-index returns integer
      120   (input p-number as integer
      121   )
      122   :
      123     if p-number < 0
      124     or p-number = ?
      125     then do:
      126       return 1 .
      127     end.
      128     define variable v-rest as integer   no-undo .
      129     assign
      130       p-number = p-number modulo 100
      131     .
      132     if p-number < 20
      133     then do:
      134       assign
      135         v-rest = p-number
      136       .
      137     end.
      138     else do:
      139       assign
      140         v-rest = p-number modulo 10
      141       .
      142     end.
      143     case v-rest :
      144       when 1
      145       then do:
      146         return 2 .
      147       end.
      148       when 2 or
      149       when 3 or
      150       when 4
      151       then do:
      152         return 3 .
      153       end.
      154       otherwise do:
      155         return 1 .
      156       end.
      157     end case .
      158   end.
      159   procedure cur-time-mjd-to-date :
      160      define input  parameter i-mjd-diff as decimal no-undo.
      161      define output parameter o-Date     as date    no-undo.
      162      define output parameter o-Time     as integer no-undo.
      163      define variable v-day-number as integer   no-undo .
      164      if    i-mjd-diff < 0
      165         or i-mjd-diff = ?
      166      then do:
      167         return "?" .
      168      end.
      169      assign
      170         v-day-number = truncate(i-mjd-diff,0).
      171         o-Date = date(v-day-number + 2400002).
      172         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      173     .
      174   end.
      175   function cur-time-mjd-to-string returns character
      176   (input p-mjd-diff as decimal
      177   )
      178   :
      179     define variable v-day-number as integer   no-undo .
      180     define variable v-seconds    as integer   no-undo .
      181     define variable v-hour       as integer   no-undo .
      182     define variable v-min        as integer   no-undo .
      183     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      184     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      185     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      186     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      187     if p-mjd-diff < 0
      188     or p-mjd-diff = ?
      189     then do:
      190       return "?" .
      191     end.
      192     assign
      193       v-day-number = integer(truncate(p-mjd-diff,0))
      194       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      195     .
      196     if v-seconds > 86400
      197     then do:
      198       assign
      199         v-seconds = 86400 - 1
      200       .
      201     end.
      202     if v-seconds < 0
      203     then do:
      204       assign
      205         v-seconds = 0
      206       .
      207     end.
      208     assign
      209       v-hour = truncate(v-seconds / 3600, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 3600
      213     .
      214     assign
      215       v-min = truncate(v-seconds / 60, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 60
      219     .
      220     return
      221         (if v-day-number <> 0
      222           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0
      226           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      230           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      231           else ""
      232         )
      233       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      234       .
      235   end.
      236   function cur-time-string returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      245   end.
      246   function cur-time-string-sec returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      255   end.
      256   function cur-time-custom  returns character
      257   (input p-prefix as character
      258   ,input p-date-format as character
      259   ,input p-delimiter as character
      260   ,input p-time-format as character
      261   ,input p-suffix as character
      262   )
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return
      271       p-prefix
      272       + string(v-date, p-date-format)
      273       + p-delimiter
      274       + string(v-time, p-time-format)
      275       + p-suffix
      276       .
      277   end.
      278   function cur-time-print  returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      287   end.
      288   function cur-time-datetime returns datetime
      289   :
      290     define variable v-char as character no-undo .
      291     define variable v-datetime as datetime no-undo .
      292     v-char = cur-time-string().
      293     v-datetime = datetime(v-char).
      294     return  v-datetime.
      295   end.
      296   function cur-time-string-msec returns character
      297   :
      298     define variable v-date as datetime  no-undo .
      299     v-date = now.
      300     return string(v-date) .
      301   end.
      302   do
      303   on error undo, return error return-value
      304   :
      305     define variable v-today as date      no-undo.
      306     define variable v-time  as integer   no-undo.
      307   define buffer buf_c-price-doc  for ub.c-price-doc  .
      308   define buffer buf_c-price-list for ub.c-price-list  .
      309   define buffer buf_c-price-list-attr for ub.c-price-list-attr  .
      310     on delete of ub.price-doc override do: end.
      311     define stream slog .
      312     define variable v-doc-code as character no-undo .
      313     run gbl/d-prompt.w (
      314         'title=':u + "Введите номер переоценки" + '\':u
      315       + 'text1=':u + "Введите номер переоценки" + '\':u
      316       + 'text2=':u + "которую необходимо удалить" + '\':u
      317       + 'format=X(14)\':u
      318       ,input-output v-doc-code
      319       ).
      320     if return-value = 'false':u then do:
      321       return .
      322     end.
      323     define buffer buf_price-doc for ub.price-doc .
      324     find first buf_price-doc no-lock
      325       where buf_price-doc.doc-num = v-doc-code
      326       no-error .
      327     if not available buf_price-doc then do:
      328       message
      329         "Переоценка не найдена" skip
      330         "Переоценка" v-doc-code skip
      331         view-as alert-box error .
      332       undo, return error .
      333     end.
      334     if buf_price-doc.status_ = 'акт':U then do:
      335       message
      336         "Удаление невозможно" skip
      337         "Переоценка закрыта до статуса" 'акт':U skip
      338         "Переоценка" buf_price-doc.doc-num skip
      339         "Объект" buf_price-doc.obj-type buf_price-doc.obj-code skip
      340         "Статус" buf_price-doc.status_ skip
      341         view-as alert-box error .
      342       undo, return error .
      343     end.
      344     if buf_price-doc.status_ = 'разрешен':U then do:
      345       message
      346         "Переоценка находится в статусе" 'разрешен':U skip
      347         "Если товары на кассе заблокированы" skip
      348         "вам необходимо сделать повторную переоценку по всем товарам" skip
      349         "удаляемой переоценки" skip
      350         "Переоценка" buf_price-doc.doc-num skip
      351         "Объект" buf_price-doc.obj-type buf_price-doc.obj-code skip
      352         "Статус" buf_price-doc.status_ skip
      353         view-as alert-box information .
      354     end.
      355     define buffer buf_clients for ub.clients .
      356     find first buf_clients no-lock
      357       where buf_clients.obj-type = buf_price-doc.obj-type
      358         and buf_clients.obj-code = buf_price-doc.obj-code
      359       no-error .
      360     if available buf_clients
      361     and buf_clients.db-num <> 0 then do:
      362       message
      363         "Переоценка принадлежит удаленной базе данных" skip
      364         "Возможно переоценка уже была передана в офис" skip
      365         "Свящитесь с администратором ГБД и попросите его удалить данную переоценку в ГБД" skip
      366         "Переоценка" buf_price-doc.doc-num skip
      367         "Объект" buf_price-doc.obj-type buf_price-doc.obj-code skip
      368         "Статус" buf_price-doc.status_ skip
      369         "База данных" buf_clients.db-num skip
      370         view-as alert-box information .
      371     end.
      372     define variable v-ok as logical   no-undo .
      373     assign
      374       v-ok = false
      375     .
      376     message
      377       "Удаление переоценки" skip
      378       "Переоценка" buf_price-doc.doc-num skip
      379       "Объект" buf_price-doc.obj-type buf_price-doc.obj-code skip
      380       "Статус" buf_price-doc.status_ skip
      381       "Продолжить?"
      382       view-as alert-box question buttons yes-no update v-ok .
      383     if v-ok <> true then do:
      384       return .
      385     end.
      386     do transaction
      387     on error undo, return error
      388     :
      389       define buffer buf_price-list for ub.price-list  .
      390       for each buf_price-list exclusive-lock
      391         where buf_price-list.doc-num = buf_price-doc.doc-num
      392       :
      393         define buffer buf_gds-obj for ub.gds-obj .
      394         find first buf_gds-obj exclusive-lock
      395           where buf_gds-obj.obj-type  = buf_price-list.obj-type
      396             and buf_gds-obj.obj-code  = buf_price-list.obj-code
      397             and buf_gds-obj.artic     = buf_price-list.artic
      398             and buf_gds-obj.prod-type = buf_price-list.prod-type
      399             and buf_gds-obj.prod-code = buf_price-list.prod-code
      400           no-error .
      401       end.
      402       find current buf_price-doc exclusive-lock .
      403       output stream slog to value('prdocdel.txt':u) append .
      404       run cur-time in this-procedure ( output v-today
      405                                      , output v-time
      406                                      ).
      407       export stream slog string(v-today, '99/99/9999') string(v-time, 'HH:MM:SS') "delete price-doc" buf_price-doc.doc-num .
      408       export stream slog buf_price-doc .
      409       output stream slog close .
      410      if buf_price-doc.status_ <> 'новый':U then do:
      411         create buf_c-price-doc.
      412         BUFFER-COPY buf_price-doc TO buf_c-price-doc
      413         assign
      414           buf_c-price-doc.chip-num           = next-value (s-corr-chip, ub)
      415           buf_c-price-doc.corr-time          = time
      416           buf_c-price-doc.corr-user-db-num   = g#db-num
      417           buf_c-price-doc.corr-man           = g#userid
      418           buf_c-price-doc.corr-date          = today
      419           buf_c-price-doc.is-del             = true
      420         .
      421      end.
      422       output stream slog to value('prdocdel.gds':u) .
      423       output stream slog close .
      424       for each buf_price-list exclusive-lock
      425         where buf_price-list.doc-num = buf_price-doc.doc-num
      426       :
      427         output stream slog to value('prdocdel.txt':u) append .
      428         export stream slog buf_price-list .
      429         output stream slog close .
      430         output stream slog to value('prdocdel.gds':u) append .
      431         export stream slog buf_price-list.prod-type buf_price-list.prod-code buf_price-list.artic 0 .
      432         output stream slog close .
      433         if buf_price-doc.status_ = 'разрешен':U then do:
      434           find first buf_gds-obj exclusive-lock
      435             where buf_gds-obj.obj-type  = buf_price-list.obj-type
      436               and buf_gds-obj.obj-code  = buf_price-list.obj-code
      437               and buf_gds-obj.artic     = buf_price-list.artic
      438               and buf_gds-obj.prod-type = buf_price-list.prod-type
      439               and buf_gds-obj.prod-code = buf_price-list.prod-code
      440             no-error .
      441           if available buf_gds-obj
      442           and buf_gds-obj.ov-on = true then do:
      443             assign
      444               buf_gds-obj.ov-on = false
      445             .
      446           end.
      447         end.
      448       if buf_price-doc.status_ <> 'новый':U then do:
      449         create buf_c-price-list.
      450         BUFFER-COPY buf_price-list TO buf_c-price-list
      451         assign
      452           buf_c-price-list.chip-num           = buf_c-price-doc.chip-num
      453           buf_c-price-list.corr-time           = time
      454           buf_c-price-list.corr-user-db-num    = g#db-num
      455           buf_c-price-list.corr-user-name     = g#userid
      456           buf_c-price-list.corr-date          = today
      457           buf_c-price-list.is-del             = true
      458         .
      459        end.
      460         delete buf_price-list .
      461       end.
      462       delete buf_price-doc .
      463       output stream slog to value('prdocdel.txt':u) append .
      464       run cur-time in this-procedure ( output v-today
      465                                      , output v-time
      466                                      ).
      467       export stream slog string(v-today, '99/99/9999') string(v-time, 'HH:MM:SS') "finish delete price-doc" v-doc-code .
      468       output stream slog close .
      469     end.
      470     message
      471       "Переоценка успешно удалена" skip
      472       "Информация по удаленной переоценке выведена в файл" 'prdocdel.txt':u skip
      473       "Список товаров выведен в файл" 'prdocdel.gds':u skip
      474       view-as alert-box information .
      475   end.
