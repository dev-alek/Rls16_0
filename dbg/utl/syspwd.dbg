      267   function pascur returns handle ():
      268   define buffer  Buf_user for  _user.
      269    find first gPasSysAdm no-error.
      270    if not available gPasSysAdm then crpas().
      271    define variable vReturn as handle no-undo.
      272    find first Buf_user
      273              where Buf_user._userid    = mloginsysadm
      274              no-error
      275              .
      276      if available Buf_user
      277      then do:
      278          block-pas:
      279          for each gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-lock:
      280             if Buf_user._password eq encode(gpasSysadm.pasw)
      281             then
      282                leave block-pas.
      283          end.
      284      end.
      285      release Buf_user.
      286      if not available gPasSysAdm
      287      then
      288         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      289      vReturn = buffer gPasSysAdm:handle.
      290      return vReturn.
      291   end.
      292   function pasNew returns handle ():
      293      define buffer  sys-ctrl for ub.sys-ctrl.
      294      define buffer  upgrade for ub.upgrade.
      295      define buffer  upgrade-attr for ub.upgrade-attr.
      296      find first gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-error.
      297      if not available gPasSysAdm then crpas().
      298      define variable vReturn as handle no-undo.
      299      find first sys-ctrl no-lock .
      300      block-upg:
      301      for each  upgrade  where upgrade.db-num = sys-ctrl.db-num
      302      no-lock
      303       by upgrade.db-num descending by upgrade.step-num descending
      304          :
      305        leave block-upg.
      306      end.
      307      find first upgrade-attr no-lock where
      308                 upgrade-attr.db-num      = upgrade.db-num and
      309                 upgrade-attr.version-num = upgrade.version-num and
      310                 upgrade-attr.attr-code   = "releace" no-error .
      311      find first  gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm and
      312                                   gPasSysAdm.num eq integer (upgrade-attr.attr-value) no-lock no-error.
      313      release sys-ctrl.
      314      release upgrade.
      315      release upgrade-attr.
      316      if not available gPasSysAdm
      317      then
      318         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      319      vReturn = buffer gPasSysAdm:handle.
      320      return vReturn.
      321   end.
      322   IBuff::Usr = "sysadm".
      323   IBuff::Pwd = pasCur()::pasw.
      324   return.
