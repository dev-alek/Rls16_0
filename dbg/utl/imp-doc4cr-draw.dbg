        1   block-level on error undo, throw.
        2   define temp-table tt-imp-parts no-undo // скопировано из utl/imp-doc4.p
        3      field artic         as character
        4              field f02           as character
        5      field part-code     as character
        6      field in-code       like ub.parts.in-code
        7      field gds-code      as int64
        8      field price-rubl    like ub.parts.price-rubl
        9      field fact-qnty     like ub.parts.fact-qnty
       10              field f08           as character
       11              field f09           as character
       12              field f10           as character
       13      field vat-tax-value as decimal
       14              field f12           as character
       15              field f13           as character
       16      field name-gtd      as character
       17              field f15           as character
       18              field f16           as character
       19      field srok-god      as character
       20              field f18           as character
       21              field f19           as character
       22      field supp-code     as integer
       23      field supp-type     as character
       24      field cont-prn-code like ub.contract.contract-prn-code
       25              field imp-row       as character // исходая строка из файла импорта
       26   .
       27   define input  parameter iUtil        as class ibs.th.utl.method-for-draw-utility no-undo.
       28   define input  parameter iosn-fname   as character no-undo.
       29   define input  parameter iart-fname   as character no-undo.
       30   define input  parameter iretry-fname as character no-undo.
       31   define input  parameter table for tt-imp-parts .
       32    define variable v-count-err as integer no-undo .
       33   define variable v-count-err1  as integer no-undo .
       34   define variable v-count-err2  as integer no-undo .
       35     run utl/imp-doc4cr.p ( iUtil:parparentproc
       36                          , this-procedure // хронометраж через write-log-and-file()
       37                          , ""             // имя лог-файла, в который выводится хронометраж
       38                          , iUtil:Obj-code
       39                          , iUtil:Obj-type
       40                          , true // закрывать созданные документы
       41                          , iosn-fname // список соответствия поставщиков
       42                          , iart-fname // список соответствия товаров
       43                          , iretry-fname // файл для повторного импорта
       44                          , input table tt-imp-parts
       45                        , output v-count-err
       46                        , output v-count-err1
       47                        , output v-count-err2
       48                          ) .
       49   procedure write-log-and-file :
       50   define input parameter p1 as integer no-undo .
       51   define input parameter p2 as character no-undo .
       52   define input parameter p3 as integer no-undo .
       53   define input parameter p-message as character no-undo .
       54     iutil:put-log(p-message) .
       55   end procedure.
