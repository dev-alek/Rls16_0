     1575   procedure process-stk-archive :
     1576     define input parameter p-obj-type like ub.price-list.obj-type no-undo .
     1577     define input parameter p-obj-code like ub.price-list.obj-code no-undo .
     1578     define input parameter p-shift-on as logical no-undo .
