        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-install as logical no-undo init no .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: factofil.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/factofil.p $":U .
        9   define variable vss-description as character no-undo init "Заполнение поля fact-order".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure factord :
       72     define input  parameter p-fact-date            as date    no-undo .
       73     define input  parameter p-fact-time            as integer no-undo .
       74     define input  parameter p-fact-num             as integer no-undo .
       75     define input  parameter p-shift-date           as date    no-undo .
       76     define input  parameter p-shift-num            as integer no-undo .
       77     define input  parameter p-shift-on             as logical no-undo .
       78     define output parameter p-fact-order           as decimal no-undo .
       79     define output parameter p-shift-end-fact-order as decimal no-undo .
       80     define output parameter p-day-end-fact-order   as decimal no-undo .
       81     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       82     if p-fact-date = ?
       83     then do:
       84       return error "Не указана фактическая дата" .
       85     end.
       86     define variable v-fact-date-num as integer no-undo .
       87     assign
       88       v-fact-date-num = integer(p-fact-date)
       89     .
       90     if p-fact-num = ?
       91     or p-fact-num = 0
       92     then do:
       93       return error "Не задан p-fact-num " + string(p-fact-num) .
       94     end.
       95     if p-fact-num < 0
       96     then do:
       97       return error "Отрицательный fact-num " + string(p-fact-num) .
       98     end.
       99     if p-fact-num >= 100000000
      100     then do:
      101       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      102     end.
      103     if p-shift-on = true
      104     then do:
      105       if p-shift-date = ?
      106       then do:
      107         return error "Не задана дата смены" .
      108       end.
      109       if p-shift-num = ?
      110       or p-shift-num = 0
      111       then do:
      112         return error "Не задан номер смены" .
      113       end.
      114     end.
      115     else do:
      116       assign
      117         p-shift-date = p-fact-date
      118         p-shift-num  = 24
      119       .
      120     end.
      121     define variable v-shift-offset as integer no-undo .
      122     if p-shift-date = p-fact-date
      123     then do:
      124       assign
      125         v-shift-offset = 1
      126       .
      127     end.
      128     if p-shift-date < p-fact-date
      129     then do:
      130       assign
      131         v-shift-offset = 0
      132       .
      133     end.
      134     if p-shift-date > p-fact-date
      135     then do:
      136       message
      137         vss-workfile vss-revision vss-description skip
      138         "Неправильная дата закрытия смены" skip
      139         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      140         view-as alert-box error .
      141       undo, return error
      142         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      143           ,string(p-fact-date, '99/99/9999':U)
      144           ,string(p-shift-date, '99/99/9999':U)
      145           )
      146       .
      147     end.
      148     if p-shift-num < 1
      149     or p-shift-num > 24
      150     then do:
      151       message
      152         vss-workfile vss-revision vss-description skip
      153         "Неправильный номер смены" skip
      154         "p-shift-num" p-shift-num skip
      155         view-as alert-box error .
      156       undo, return error return-value .
      157     end.
      158     assign
      159       p-fact-order           = v-fact-date-num
      160                              + v-shift-offset * 0.5
      161                              + p-shift-num    * 0.02 - 0.01
      162                              + p-fact-num     * 0.0000000001
      163       p-shift-end-fact-order = v-fact-date-num
      164                              + v-shift-offset * 0.5
      165                              + p-shift-num    * 0.02
      166       p-day-end-fact-order   = v-fact-date-num
      167                              + 0.99
      168     .
      169     if p-fact-order           <= v-fact-date-num
      170     or p-shift-end-fact-order <= v-fact-date-num
      171     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      172     or p-shift-end-fact-order >= p-day-end-fact-order
      173     then do:
      174       message
      175         vss-workfile vss-revision vss-description skip
      176         "Внутренняя ошибка при генерации фактического номера" skip
      177         "p-fact-date"            p-fact-date            skip
      178         "p-fact-time"            p-fact-time            skip
      179         "p-fact-num"             p-fact-num             skip
      180         "p-shift-date"           p-shift-date           skip
      181         "p-shift-num"            p-shift-num            skip
      182         "p-shift-on"             p-shift-on             skip
      183         "p-shift-end-fact-order" p-shift-end-fact-order skip
      184         "p-day-end-fact-order"   p-day-end-fact-order   skip
      185         "v-fact-date-num"        v-fact-date-num        skip
      186         view-as alert-box error .
      187       undo, return error return-value .
      188     end.
      189   end procedure.
      190   procedure day-begin-fact-order :
      191     define input  parameter p-fact-date            as date    no-undo .
      192     define output parameter p-day-begin-fact-order as decimal no-undo .
      193     do
      194     on error undo, return error return-value
      195     :
      196       if p-fact-date = ?
      197       then do:
      198         assign
      199           p-day-begin-fact-order = 0
      200         .
      201       end.
      202       else do:
      203         assign
      204           p-day-begin-fact-order = integer(p-fact-date)
      205         .
      206       end.
      207     end.
      208   end procedure.
      209   procedure factord-max-fact-order :
      210     define output parameter p-max-fact-order as decimal   no-undo .
      211     do
      212     on error undo, return error return-value
      213     :
      214       run day-begin-fact-order in this-procedure
      215         (input  date(1, 1, 5000)
      216         ,output p-max-fact-order
      217         ) .
      218     end.
      219   end procedure.
      220   procedure factord-cut-archive :
      221     define input  parameter p-obj-type             as character no-undo .
      222     define input  parameter p-obj-code             as integer   no-undo .
      223     define input  parameter p-fact-date            as date      no-undo .
      224     define output parameter p-shift-on             as logical   no-undo .
      225     define output parameter p-shift-date           as date      no-undo .
      226     define output parameter p-shift-num            as integer   no-undo .
      227     define output parameter p-day-end-fact-order   as decimal   no-undo .
      228     define output parameter p-shift-end-fact-order as decimal   no-undo .
      229     define variable v-fact-order as decimal   no-undo .
      230     define buffer buf_shift-obj for ub.shift-obj .
      231     do
      232     on error undo, return error return-value
      233     :
      234   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      236     (input  p-obj-type
      237     ,input  p-obj-code
      238     ,input  'shift-on=request'
      239     ,output p-shift-on
      240     ) no-error .
      241       if error-status :error
      242       then do:
      243         message
      244           vss-workfile vss-revision vss-description skip
      245           "Ошибка при определении атрибута объекта" skip
      246           "Объект" p-obj-type p-obj-code skip
      247           error-status :get-message(1) skip
      248           return-value skip
      249           view-as alert-box error .
      250         undo, return error return-value .
      251       end.
      252       if p-shift-on = false
      253       then do:
      254         assign
      255           p-shift-date               = ?
      256           p-shift-num                = 0
      257         .
      258       end.
      259       else do:
      260         find first buf_shift-obj share-lock
      261           where buf_shift-obj.obj-type   = p-obj-type
      262             and buf_shift-obj.obj-code   = p-obj-code
      263             and buf_shift-obj.shift-date > p-fact-date
      264           use-index pi
      265           no-error .
      266         if not available buf_shift-obj
      267         or buf_shift-obj.status_ <> 'зкр':U
      268         then do:
      269           message
      270             vss-workfile vss-revision vss-description skip
      271             "Невозможно вычислить последнюю смену" skip
      272             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      273             "Объект" p-obj-type p-obj-code skip
      274             "Дата" p-fact-date skip
      275             view-as alert-box error .
      276           undo, return error return-value .
      277         end.
      278         find last buf_shift-obj share-lock
      279           where buf_shift-obj.obj-type = p-obj-type
      280             and buf_shift-obj.obj-code = p-obj-code
      281             and buf_shift-obj.shift-date <= p-fact-date
      282           use-index pi
      283           no-error .
      284         if available buf_shift-obj
      285         then do:
      286           if  buf_shift-obj.status_ = 'зкр':U
      287           then do:
      288             assign
      289               p-shift-date = buf_shift-obj.shift-date
      290               p-shift-num  = buf_shift-obj.shift-num
      291             .
      292           end.
      293           else do:
      294             message
      295               vss-workfile vss-revision vss-description skip
      296               "Невозможно вычислить последнюю смену" skip
      297               "Статус смены отличен от статуса" 'зкр':U skip
      298               "Объект" p-obj-type p-obj-code skip
      299               "Дата" p-fact-date skip
      300               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      301               view-as alert-box error .
      302             undo, return error return-value .
      303           end.
      304         end.
      305         else do:
      306           assign
      307             p-shift-date = p-fact-date - 1
      308             p-shift-num  = 1
      309           .
      310         end.
      311       end.
      312       run factord in this-procedure
      313         (input  p-fact-date
      314         ,input  1
      315         ,input  1
      316         ,input  p-shift-date
      317         ,input  p-shift-num
      318         ,input  p-shift-on
      319         ,output v-fact-order
      320         ,output p-shift-end-fact-order
      321         ,output p-day-end-fact-order
      322         ) no-error .
      323       if error-status :error
      324       then do:
      325         message
      326           vss-workfile vss-revision vss-description skip
      327           "Ошибка при вызове процедуры factord"
      328           error-status :get-message(1) skip
      329           return-value skip
      330           view-as alert-box error .
      331         undo, return error return-value .
      332       end.
      333     end.
      334   end procedure.
      335   procedure factord-lock-shift :
      336     define input  parameter p-obj-type  as character no-undo .
      337     define input  parameter p-obj-code  as integer   no-undo .
      338     define input  parameter p-fact-date as date      no-undo .
      339     define parameter buffer buf_shift-obj for ub.shift-obj .
      340     define variable v-shift-on      as logical   no-undo .
      341     define variable v-extra-message as character no-undo .
      342     define variable v-error as character no-undo .
      343     do
      344     on error undo, return error return-value
      345     :
      346   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      348     (input  p-obj-type
      349     ,input  p-obj-code
      350     ,input  'shift-on=request'
      351     ,output v-shift-on
      352     ) no-error .
      353       if error-status :error
      354       then do:
      355         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      356         undo, return error v-error .
      357       end.
      358       if v-shift-on = true
      359       then do:
      360         find first buf_shift-obj share-lock
      361           where buf_shift-obj.obj-type   = p-obj-type
      362             and buf_shift-obj.obj-code   = p-obj-code
      363             and buf_shift-obj.shift-date > p-fact-date
      364           use-index pi
      365           no-error .
      366         if not available buf_shift-obj
      367         or buf_shift-obj.status_ <> 'зкр':U
      368         then do:
      369           find last buf_shift-obj
      370             where buf_shift-obj.obj-type = p-obj-type
      371               and buf_shift-obj.obj-code = p-obj-code
      372               and buf_shift-obj.status_  = 'зкр':U
      373             use-index stts
      374             no-error .
      375           if available buf_shift-obj
      376           then do:
      377             assign
      378               v-extra-message =
      379                     substitute("Дата начала последеней закрытой смены на объекте &1"
      380                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      381                               )
      382             .
      383           end.
      384           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      385           undo, return error v-error .
      386         end.
      387       end.
      388     end.
      389   end procedure.
      390   procedure factord-end-day :
      391     define input  parameter p-fact-date            as date    no-undo .
      392     define output parameter p-day-end-fact-order   as decimal no-undo .
      393     do
      394     on error undo, return error return-value
      395     :
      396       if p-fact-date = ?
      397       then do:
      398         return error "Не указана фактическая дата" .
      399       end.
      400       assign
      401         p-day-end-fact-order = integer(p-fact-date) + 0.99
      402       .
      403     end.
      404   end procedure.
      405   procedure factord-to-date :
      406     define input  parameter p-fact-order as decimal no-undo .
      407     define output parameter p-fact-date  as date    no-undo .
      408     define variable v-ref-date  as date      no-undo .
      409     define variable v-ref-delta as integer   no-undo .
      410     do
      411     on error undo, return error return-value
      412     :
      413       if p-fact-order = ?
      414       or p-fact-order = 0
      415       then do:
      416         return error "Не указан fact-order" .
      417       end.
      418       assign
      419         v-ref-date  = date(1, 1, 2000)
      420       .
      421       assign
      422         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      423       .
      424       assign
      425         p-fact-date = v-ref-date + v-ref-delta
      426       .
      427     end.
      428   end procedure.
      429   procedure factord-to-fact-num :
      430     define input  parameter p-fact-order as decimal no-undo .
      431     define output parameter p-fact-num   as integer no-undo .
      432     define variable v-fact-order-trunc as decimal no-undo .
      433     do
      434     on error undo, return error return-value
      435     :
      436       if p-fact-order = ?
      437       or p-fact-order = 0
      438       then do:
      439         return error "Не указан fact-order" .
      440       end.
      441       assign
      442        v-fact-order-trunc = truncate(p-fact-order, 2)
      443       .
      444       assign
      445         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      446       .
      447     end.
      448   end procedure.
      449   procedure factord-to-shift-num :
      450     define input  parameter p-fact-order as decimal no-undo .
      451     define output parameter p-shift-num   as integer no-undo .
      452     define variable  p-shift-numd  as decimal   no-undo .
      453     define variable v-fact-order-trunc as decimal no-undo .
      454     do
      455     on error undo, return error return-value
      456     :
      457       if p-fact-order = ?
      458       or p-fact-order = 0
      459       then do:
      460         return error "Не указан fact-order" .
      461       end.
      462       assign
      463        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      464       .
      465       if v-fact-order-trunc < 0.5 then do:
      466         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      467       end.
      468       assign
      469         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      470         .
      471        assign
      472         p-shift-num = truncate (p-shift-numd , 0)
      473       .
      474     end.
      475   end procedure.
      476   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477     define variable v-cntxt-db-num        as integer   no-undo .
      478     define variable v-cntxt-userid        as character no-undo .
      479     define variable v-cntxt-level         as character no-undo .
      480     define variable v-cntxt-host-code-obj as integer   no-undo .
      481     define variable v-cntxt-obj-type      as character no-undo .
      482     define variable v-cntxt-obj-code      as integer   no-undo .
      483     define variable v-cntxt-db-num-obj    as integer   no-undo .
      484     define variable v-cntxt-is-admin      as logical   no-undo .
      485   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      486   define variable v-waitfram-action01         as character   no-undo .
      487   define variable v-waitfram-action02         as character   no-undo .
      488   define variable v-waitfram-action03         as character   no-undo .
      489   define variable mWaitFramTextBeg            as character   no-undo.
      490   define variable mWaitFramTextEnd            as character   no-undo.
      491   define variable mWaitFramView               as logical     no-undo.
      492   define variable mWaitProcEvent              as logical     no-undo init yes.
      493   define variable mWaitFramInterval           as integer     no-undo init 1 .
      494   define variable mWaitFramStop               as logical     no-undo.
      495   define variable mWaitFramStopUser           as logical     no-undo.
      496   define variable mWaitFramStopTimeOut        as logical     no-undo.
      497   define variable mWaitFramStartProc          as datetime-tz no-undo.
      498   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      499   define button B-WaitFramStop auto-end-key
      500        label "Стоп"
      501        size 10 by 1 tooltip "Остоновить процесс".
      502   define button B-viewProcInfo
      503        label "Информация"
      504        size 15 by 1 tooltip "Информация о процесс".
      505   define frame waitfram
      506     v-waitfram-action01 format "x(72)" no-label skip
      507     v-waitfram-action02 format "x(72)" no-label skip
      508     v-waitfram-action03 format "x(72)" no-label skip
      509     B-viewProcInfo
      510     B-WaitFramStop at row 4 col 30
      511     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      512     .
      513   define new global shared variable mBatchMode as logical no-undo init ?.
      514   define variable mFramBachModHandle as handle no-undo.
      515   mFramBachModHandle = frame waitfram:handle.
      516   define variable mFameOldVis as logical no-undo.
      517   define variable mVisCUrentVin as logical no-undo.
      518   if session:batch-mode
      519   then
      520      mBatchMode = yes.
      521   if mBatchMode = ? then do:
      522     mVisCUrentVin = current-window:visible.
      523     mFameOldVis = mFramBachModHandle:visible.
      524     mFramBachModHandle:visible  = yes.
      525     mBatchMode = mFramBachModHandle:visible ne yes.
      526     mFramBachModHandle:visible = mFameOldVis.
      527     current-window:visible = mVisCUrentVin.
      528   end.
      529    if  log-manager:logfile-name ne ?
      530     then DO:
      531         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      532         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      533         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      534     end.
      535   on choose of B-WaitFramStop in frame waitfram
      536   do:
      537     mWaitFramStop = yes.
      538     mWaitFramStopUser = yes.
      539   end.
      540   function waitfram-check-timeout returns logical():
      541      define variable vtime as int64 no-undo.
      542      if mWaitFramStopTimeOut
      543      then
      544         return yes.
      545      vtime = ( now - mWaitFramStartProc ) / 1000 .
      546      if     mWaitFramTimeOut ne ?
      547         and mWaitFramTimeOut ne 0
      548         and mWaitFramTimeOut lt vtime
      549      then do:
      550         mWaitFramStopTimeOut = yes.
      551      end.
      552      return mWaitFramStopTimeOut.
      553   end.
      554   procedure waitfram-hide :
      555     if not session:batch-mode
      556     then do
      557     on error undo, return error return-value
      558     :
      559       pause 0 before-hide .
      560       if not mBatchMode then
      561         hide frame waitfram .
      562     if     not mWaitFramView
      563        and mWaitProcEvent
      564     then
      565       process events .
      566     end.
      567   end procedure.
      568   procedure waitfram-show :
      569     define input  parameter p-message as character no-undo .
      570     define variable v-left-margin as integer   no-undo .
      571     if not session:batch-mode
      572     then do
      573     on error undo, return error return-value
      574     :
      575       if length(p-message) <= 70 then do:
      576         assign
      577           v-left-margin = integer((70 - length(p-message)) / 2)
      578         .
      579         assign
      580           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      581         .
      582         assign
      583           v-waitfram-action01 = " "
      584           v-waitfram-action02 = " "
      585                                    + fill(" ", v-left-margin)
      586                                    + p-message
      587           v-waitfram-action03 = " "
      588         .
      589       end.
      590       else do:
      591         define variable vRindex1 as integer no-undo.
      592         define variable vRindex2 as integer no-undo.
      593         vRindex1 = r-index(p-message," ",70).
      594         if vRindex1 = 0
      595         then
      596            vRindex1 = 70.
      597         if length(p-message)  <= vRindex1 + 70 then do:
      598           assign
      599             v-waitfram-action01 = " "
      600             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      601             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      602           .
      603         end.
      604         else do:
      605           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      606           if vRindex2 <= vRindex1
      607           then
      608              vRindex2 = vRindex1 + 70.
      609           assign
      610             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      611             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      612             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      613           .
      614         end.
      615       end.
      616       B-viewProcInfo:visible   in frame waitfram = no.
      617       B-viewProcInfo:sensitive in frame waitfram = no.
      618       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      619       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      620       if  (   mWaitFramView
      621          or  mWaitProcEvent)
      622          and not mBatchMode
      623       then
      624          display
      625             v-waitfram-action01 skip
      626             v-waitfram-action02 skip
      627             v-waitfram-action03 skip
      628          with frame waitfram .
      629       if     mWaitFramView
      630          then do:
      631             if     mWaitFramInterval ne ?
      632                and not mBatchMode
      633             then
      634                wait-for go of frame waitfram pause mWaitFramInterval.
      635          end.
      636          else
      637             if     mWaitProcEvent
      638                and not mBatchMode
      639             then
      640                process events .
      641     end.
      642   end procedure.
      643      procedure waitfram-show-this:
      644         define input  parameter iInterval as int64 no-undo.
      645         define variable vtime as int64 no-undo.
      646         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      647         mWaitFramInterval = iInterval.
      648         run waitfram-show (substitute("&1&2 &3&4" ,
      649                                       mWaitFramTextBeg ,
      650                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      651                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      652                                       mWaitFramTextEnd
      653                                      )
      654                           ).
      655      end.
      656      procedure WaitFramRunPause:
      657         define input  parameter iInterval as dec no-undo.
      658         define variable vStart  as datetime-tz no-undo.
      659         define variable vend    as datetime-tz no-undo.
      660         define variable vint as int64 no-undo.
      661         define variable vOk as logical no-undo.
      662         vStart = now.
      663         vend   = vStart.
      664         publish "WaitFramPause" (iInterval,output vOk).
      665         vend   =  now.
      666         vint = vend - vStart.
      667         vint = iInterval - vint / 1000.
      668         if     not mWaitFramStop
      669            and (   vint > 0
      670                 or (    not vOk
      671                     and iInterval eq ?
      672                     )
      673                 )
      674         then
      675            run waitfram-show-this (iInterval).
      676         vend   =  now.
      677         vint = vend - vStart.
      678         vint = iInterval - vint / 1000.
      679         if     not mWaitFramStop
      680            and vint > 0
      681         then do:
      682            run gbl/pause.p (vint * 1000).
      683         end.
      684         if iInterval ne ?
      685         then
      686            publish "WaitFramStop".
      687         waitfram-check-timeout().
      688      end.
      689      procedure WaitFramWaitFor:
      690         define input  parameter iInterval as dec no-undo.
      691         assign
      692            mWaitFramStartProc   = now
      693            mWaitFramStopUser    = no
      694            mWaitFramStopTimeOut = no
      695         .
      696         block-wait:
      697         do while not mWaitFramStop:
      698            run WaitFramRunPause (iInterval).
      699            if  waitfram-check-timeout()
      700            then do:
      701               leave block-wait.
      702            end.
      703         end.
      704         run waitfram-hide.
      705      end.
      706   procedure waitfram-join :
      707     define input  parameter p-line-1  as character no-undo .
      708     define input  parameter p-line-2  as character no-undo .
      709     define input  parameter p-line-3  as character no-undo .
      710     define output parameter p-message as character no-undo .
      711     do
      712     on error undo, return error return-value
      713     :
      714       assign
      715         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      716                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      717                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      718       .
      719     end.
      720   end procedure.
      721   function waitfram-join-function returns character
      722     (input p-line-1 as character
      723     ,input p-line-2 as character
      724     ,input p-line-3 as character
      725     ).
      726     define variable v-message as character no-undo .
      727     run waitfram-join in this-procedure
      728       (input  p-line-1
      729       ,input  p-line-2
      730       ,input  p-line-3
      731       ,output v-message
      732       ) .
      733     return v-message .
      734   end function .
      735   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      736   define temp-table userobjs_temp-user-obj no-undo
      737     field obj-type as character
      738     field obj-code as integer
      739     index xpk is primary unique obj-type obj-code
      740     .
      741   procedure userobjs_clear :
      742     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      743     do
      744     on error undo, return error return-value
      745     :
      746       for each buf_userobjs_temp-user-obj
      747       on error undo, return error return-value
      748       :
      749         delete buf_userobjs_temp-user-obj .
      750       end.
      751     end.
      752   end .
      753   procedure userobjs_object-count :
      754     define output parameter p-total-count as integer   no-undo .
      755     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      756     do
      757     on error undo, return error return-value
      758     :
      759       assign
      760         p-total-count = 0
      761       .
      762       for each buf_userobjs_temp-user-obj
      763       on error undo, return error return-value
      764       :
      765         assign
      766           p-total-count = p-total-count + 1
      767         .
      768       end.
      769     end.
      770   end.
      771   procedure userobjs_append :
      772      define input  parameter p-obj-type as character no-undo .
      773      define input  parameter p-obj-code as integer   no-undo .
      774     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      775     do
      776     on error undo, return error return-value
      777     :
      778       find first buf_userobjs_temp-user-obj
      779         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      780           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      781         no-error .
      782       if not available buf_userobjs_temp-user-obj
      783       then do:
      784         create buf_userobjs_temp-user-obj .
      785         assign
      786           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      787           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      788         .
      789       end.
      790     end.
      791   end.
      792   procedure userobjs_object-exist :
      793     define output parameter p-object-exist as logical   no-undo .
      794     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      795     do
      796     on error undo, return error return-value
      797     :
      798       find first buf_userobjs_temp-user-obj
      799         no-error .
      800       if not available buf_userobjs_temp-user-obj
      801       then do:
      802         assign
      803           p-object-exist = false
      804         .
      805       end.
      806       else do:
