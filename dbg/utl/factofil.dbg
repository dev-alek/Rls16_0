      809         .
      810       end.
      811     end.
      812   end.
      813   procedure userobjs_transfer :
      814     define input  parameter p-callback-handle as handle no-undo .
      815     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      816     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      817     do
      818     on error undo, return error return-value
      819     :
      820       if valid-handle(p-callback-handle) <> true
      821       then do:
      822         message
      823           vss-workfile vss-revision vss-description skip
      824           "Ошибка задания входных параметров" skip
      825           "Неизвестный указатель на процедуру" skip
      826           view-as alert-box error .
      827         undo, return error return-value .
      828       end.
      829       if p-callback-handle :get-signature("userobjs_append") = ""
      830       then do:
      831         message
      832           vss-workfile vss-revision vss-description skip
      833           "Ошибка задания входных параметров" skip
      834           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      835                     ,p-callback-handle :file-name
      836                     ) skip
      837           view-as alert-box error .
      838         undo, return error return-value .
      839       end.
      840       for each buf_userobjs_temp-user-obj
      841       on error undo, return error return-value
      842       :
      843         run userobjs_append in p-callback-handle
      844           (input  buf_userobjs_temp-user-obj.obj-type
      845           ,input  buf_userobjs_temp-user-obj.obj-code
      846           ) .
      847       end.
      848     end.
      849   end procedure.
