      906   procedure thobjs :
      907      define input        parameter parparentproc     as widget-handle no-undo .
      908      define input        parameter i-bttns           as character     no-undo .
      909      define input        parameter i-list-mode       as character     no-undo.
      910      define input        parameter i-obj-type        as character     no-undo.
