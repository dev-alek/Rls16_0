     1080           return-value skip
     1081           view-as alert-box error .
     1082         undo, return error .
     1083       end.
     1084       run process-trn-doc in this-procedure
     1085         (input p-obj-type
     1086         ,input p-obj-code
     1087         ,input l-shift-on
     1088         ) .
     1089       run process-price-doc in this-procedure
     1090         (input p-obj-type
     1091         ,input p-obj-code
     1092         ,input l-shift-on
     1093         ) .
