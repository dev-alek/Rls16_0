     1796   procedure process-shift-obj :
     1797     define input parameter p-obj-type as character no-undo .
     1798     define input parameter p-obj-code as integer   no-undo .
     1799     define input parameter p-shift-on as logical   no-undo .
     1800     do
     1801     on error undo, return error
     1802     :
     1803       define buffer buf_shift-obj for ub.shift-obj .
     1804       for each buf_shift-obj exclusive-lock
     1805         where buf_shift-obj.obj-type = p-obj-type
     1806           and buf_shift-obj.obj-code = p-obj-code
     1807           and buf_shift-obj.status_  = 'факт':U
     1808       on error undo, return error
     1809       :
     1810         define variable v-fact-order           as decimal no-undo .
     1811         define variable v-shift-end-fact-order as decimal no-undo .
     1812         define variable v-day-end-fact-order   as decimal no-undo .
     1813         run factord in this-procedure
     1814           (input  buf_shift-obj.close-date
     1815           ,input  buf_shift-obj.close-time
     1816           ,input  1
     1817           ,input  buf_shift-obj.shift-date
     1818           ,input  buf_shift-obj.shift-num
     1819           ,input  p-shift-on
     1820           ,output v-fact-order
     1821           ,output v-shift-end-fact-order
     1822           ,output v-day-end-fact-order
     1823           ) no-error .
     1824         if error-status :error then do:
     1825           output stream slog to factofil.err append .
     1826           export stream slog
     1827             "err-shift-obj"
     1828             buf_shift-obj.obj-type buf_shift-obj.obj-code
     1829             buf_shift-obj.close-date buf_shift-obj.close-time
     1830             buf_shift-obj.shift-date buf_shift-obj.shift-num
     1831             buf_shift-obj.fact-order
     1832             return-value .
     1833           output stream slog close .
     1834           assign
     1835             v-error-count = v-error-count + 1
     1836           .
     1837         end.
     1838         else do:
     1839           if buf_shift-obj.fact-order <> v-shift-end-fact-order then do:
     1840             output stream slog to factofil.fix append .
     1841             export stream slog
     1842               "fix-shift-obj"
     1843               buf_shift-obj.obj-type buf_shift-obj.obj-code
     1844               buf_shift-obj.close-date buf_shift-obj.close-time
     1845               buf_shift-obj.shift-date buf_shift-obj.shift-num
     1846               buf_shift-obj.fact-order
     1847               .
     1848             output stream slog close .
     1849             assign
     1850               v-fix-count = v-fix-count + 1
     1851             .
     1852             assign
     1853               buf_shift-obj.fact-order = v-shift-end-fact-order
     1854             .
     1855           end.
     1856         end.
     1857       end.
     1858     end.
     1859   end procedure.
