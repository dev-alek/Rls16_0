     1121   procedure process-trn-doc :
     1122     define input parameter p-obj-type as character no-undo .
     1123     define input parameter p-obj-code as integer   no-undo .
     1124     define input parameter p-shift-on as logical   no-undo .
     1125     define buffer buf_trn-doc for ub.trn-doc .
     1126     do
     1127     on error undo, return error
     1128     :
     1129       if p-install = false then do:
     1130         run waitfram-show in this-procedure (input substitute("Обработка складских документов. Объект &1 &2", p-obj-type, p-obj-code)
     1131           ).
     1132       end.
     1133       for each buf_trn-doc exclusive-lock
     1134         where buf_trn-doc.obj-type = p-obj-type
     1135           and buf_trn-doc.obj-code = p-obj-code
     1136           and buf_trn-doc.status_  = 'факт':U
     1137       on error undo, return error
     1138       :
     1139         define variable v-fact-order           as decimal no-undo .
     1140         define variable v-shift-end-fact-order as decimal no-undo .
     1141         define variable v-day-end-fact-order   as decimal no-undo .
     1142         run factord in this-procedure
     1143           (input  buf_trn-doc.fact-date
     1144           ,input  buf_trn-doc.fact-time
     1145           ,input  buf_trn-doc.fact-num
     1146           ,input  buf_trn-doc.shift-date
     1147           ,input  buf_trn-doc.shift-num
     1148           ,input  p-shift-on
     1149           ,output v-fact-order
     1150           ,output v-shift-end-fact-order
     1151           ,output v-day-end-fact-order
     1152           ) no-error .
     1153         if error-status :error then do:
     1154           output stream slog to factofil.err append .
     1155           export stream slog
     1156             "err-trn-doc"
     1157             buf_trn-doc.obj-type buf_trn-doc.obj-code
     1158             buf_trn-doc.doc-code buf_trn-doc.fact-date buf_trn-doc.fact-time
     1159             buf_trn-doc.fact-num buf_trn-doc.shift-date buf_trn-doc.shift-num
     1160             buf_trn-doc.fact-order
     1161             return-value .
     1162           output stream slog close .
     1163           assign
     1164             v-error-count = v-error-count + 1
     1165           .
     1166         end.
     1167         else do:
     1168           if buf_trn-doc.fact-order <> v-fact-order then do:
     1169             output stream slog to factofil.fix append .
     1170             export stream slog
     1171               "fix-trn-doc"
     1172               buf_trn-doc.doc-code buf_trn-doc.fact-date buf_trn-doc.fact-time
     1173               buf_trn-doc.fact-num buf_trn-doc.shift-date buf_trn-doc.shift-num
     1174               buf_trn-doc.fact-order v-fact-order
     1175               .
     1176             output stream slog close .
     1177             assign
     1178               v-fix-count = v-fix-count + 1
     1179             .
     1180             assign
     1181               buf_trn-doc.fact-order = v-fact-order
     1182             .
     1183           end.
     1184         end.
     1185         define buffer buf_doc-line for ub.doc-line .
     1186         for each buf_doc-line exclusive-lock
     1187           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1188             and buf_doc-line.fact-order <> buf_trn-doc.fact-order
     1189         on error undo, return error
     1190         :
     1191           assign
     1192             buf_doc-line.fact-order = buf_trn-doc.fact-order
     1193           .
     1194         end.
     1195         run process-ot-archive in this-procedure
     1196           (input buf_trn-doc.doc-code
     1197           ,input buf_trn-doc.fact-order
     1198           ) no-error .
     1199         if error-status :error then do:
     1200           message
     1201             vss-workfile vss-revision vss-description skip
     1202             "Ошибка при обработке архивов по документу" skip
     1203             "Документ" buf_trn-doc.doc-code skip
     1204             error-status :get-message(1) skip
     1205             return-value skip
     1206             view-as alert-box error .
     1207           undo, return error .
     1208         end.
     1209       end.
     1210     end.
     1211   end procedure.
