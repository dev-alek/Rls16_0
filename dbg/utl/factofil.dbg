      926   on write of rvs-doc   override do: end.
      927   on write of icnt-doc  override do: end.
      928   on write of wth-doc   override do: end.
      929   define stream slog .
      930   define variable v-fix-count   as integer no-undo .
      931   define variable v-error-count as integer   no-undo .
      932   define variable v-num as integer no-undo .
      933   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      934     run mainmenu_getcntxt in parparentproc
      935       (output v-cntxt-db-num
      936       ,output v-cntxt-userid
      937       ,output v-cntxt-level
      938       ,output v-cntxt-host-code-obj
      939       ,output v-cntxt-obj-type
      940       ,output v-cntxt-obj-code
      941       ,output v-cntxt-db-num-obj
      942       ,output v-cntxt-is-admin
      943       ) .
      944   if p-install then do:
      945     assign
      946       v-num = 1
      947     .
      948   end.
      949   else do:
      950     run gbl/d-askw.w
      951       (input "Вопрос"
      952       ,input "Простановка фактического номера для всех документов системы." + chr(10)
      953       ,input "|^"
      954       ,input "Все объекты^confirm|Все сменные объекты^confirm|Выбрать объекты|Отмена"
      955       ,input "|"
      956           + "|"
      957           + "|"
      958           + ""
      959       ,input 1
      960       ,input 4
      961       ,output v-num
      962       ).
      963   end.
      964   if p-install = false then do:
      965     run waitfram-show in this-procedure (input "Простановка фактического номера"
      966       ).
      967   end.
      968   case v-num :
      969     when 1 then do:
      970       for each ub.db no-lock
      971       ,each ub.clients no-lock
      972         where ub.clients.db-num = ub.db.db-num
      973       on error undo, return error
      974       :
      975         run process-object in this-procedure
      976           (input ub.clients.obj-type
      977           ,input ub.clients.obj-code
      978           ).
      979       end.
      980     end.
      981     when 2 then do:
      982       for each ub.db no-lock
      983       ,each ub.clients no-lock
      984         where ub.clients.db-num = ub.db.db-num
      985       on error undo, return error
      986       :
      987         define variable l-shift-on as logical no-undo .
      988   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      990     (input  ub.clients.obj-type
      991     ,input  ub.clients.obj-code
      992     ,input  'shift-on=request'
      993     ,output l-shift-on
      994     ) no-error .
      995         if error-status :error then do:
      996           message
      997             vss-workfile vss-revision vss-description skip
      998             "Ошибка при запуске процедуры objat" skip
      999             error-status :get-message(1) skip
     1000             return-value skip
     1001             view-as alert-box error .
     1002           undo, return error .
     1003         end.
     1004         if l-shift-on = true then do:
     1005           run process-object in this-procedure
     1006             (input ub.clients.obj-type
     1007             ,input ub.clients.obj-code
     1008             ).
     1009         end.
     1010       end.
     1011     end.
     1012     when 3 then do:
     1013       define variable v-user-select as logical   no-undo .
     1014   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1015   run userobjs_select-many in this-procedure
     1016     (input  parparentproc
     1017     ,input  v-cntxt-db-num
     1018     ,input  v-cntxt-userid
     1019     ,input  v-cntxt-host-code-obj
     1020     ,input  v-cntxt-obj-type
     1021     ,input  v-cntxt-obj-code
     1022     ,output v-user-select
     1023     )  .
     1024       if v-user-select <> true
     1025       then do:
     1026         message
     1027           "Объект не выбран"
     1028           view-as alert-box information .
     1029         return .
     1030       end.
     1031       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1032       for each buf_userobjs_temp-user-obj
     1033       on error undo, return error return-value
     1034       :
     1035         run process-object in this-procedure
     1036           (input buf_userobjs_temp-user-obj.obj-type
     1037           ,input buf_userobjs_temp-user-obj.obj-code
     1038           ).
     1039       end.
     1040     end.
     1041     when 4 then do:
     1042       return .
     1043     end.
     1044   end case .
     1045   if p-install = false then do:
     1046     run waitfram-hide in this-procedure .
     1047   end.
     1048   if p-install = false then do:
     1049     message
     1050       "Закончена утилита инициализации поля fact-order" skip
     1051       "Исправлено документов" v-fix-count skip
     1052       view-as alert-box information .
     1053   end.
     1054   if v-error-count > 0 then do:
     1055     return
     1056       "При заполнении поля было обнаружено " + string(v-error-count) + chr(10)
     1057       + "Информация об ошибочных документах находится в файле factofil.err. " + chr(10)
     1058       .
     1059   end.
     1060   return .
     1061   procedure process-object :
     1062     define input parameter p-obj-type like ub.price-list.obj-type no-undo .
     1063     define input parameter p-obj-code like ub.price-list.obj-code no-undo .
     1064     do
     1065     on error undo, return error
     1066     :
     1067       define variable l-shift-on as logical no-undo .
     1068   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1069   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1070     (input  p-obj-type
     1071     ,input  p-obj-code
     1072     ,input  'shift-on=request'
     1073     ,output l-shift-on
     1074     ) no-error .
