        1   block-level on error undo, throw.
        2   class utl.math:
        3      method public static logical lxor(
        4         input iA as logical,
        5         input iB as logical):
        6         return (iA and not iB)
        7             or (iB and not iA).
        8      end method.
        9      method private static char cxor(
       10         input iA as char,
       11         input iB as char):
       12         def var vA  as int64 no-undo.
       13         def var vI  as int64 no-undo.
       14         def var vC1 as int64 no-undo.
       15         def var vC2 as int64 no-undo.
       16         assign
       17            vC1 = asc(iA)
       18            vC2 = asc(iB)
       19         .
       20         do vI  = 1 to 8:
       21            put-bits(vA,vI,1) = if lxor(get-bits(asc(iA),vI,1) = 1,
       22                                        get-bits(asc(iB),vI,1) = 1) then 1 else 0.
       23         end.
       24         return chr(vA).
       25      end method.
       26      method public static int64 ixor(
       27         input iA as int64,
       28         input iB as int64):
       29         def var vA  as int64 no-undo.
       30         def var vI  as int64 no-undo.
       31         do vI  = 1 to 64:
       32            put-bits(vA,vI,1) = if utl.math:lxor(get-bits(iA,vI,1) = 1,
       33                                                 get-bits(iB,vI,1) = 1) then 1
       34                                                                        else 0.
       35         end.
       36         return vA.
       37      end method.
       38      method public static char xcode(
       39         input iPass as char,
       40         input iKey  as char):
       41         def var vI   as int64 no-undo.
       42         def var vRes as char no-undo init "".
       43         def var vP   as int64 no-undo.
       44         def var vK   as int64 no-undo.
       45         do vI = 1 to length(iPass):
       46            assign
       47               vP = vI mod LENGTH(iPass)
       48               vK = vI mod LENGTH(iKey)
       49            .
       50            if vP = 0 then vP = length(iPass).
       51            if vK = 0 then vK = length(iKey).
       52            vRes = vRes + cxor(substring(iPass,vP,1),substring(iKey,vK,1)).
       53         end.
       54         return vRes.
       55      end method.
       56   end class.
