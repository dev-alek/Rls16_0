      411       then do:
      412         undo, return error return-value .
      413       end.
      414     end.
      415   end.
      416   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   define variable v-waitfram-action01         as character   no-undo .
      418   define variable v-waitfram-action02         as character   no-undo .
      419   define variable v-waitfram-action03         as character   no-undo .
      420   define variable mWaitFramTextBeg            as character   no-undo.
      421   define variable mWaitFramTextEnd            as character   no-undo.
      422   define variable mWaitFramView               as logical     no-undo.
      423   define variable mWaitProcEvent              as logical     no-undo init yes.
      424   define variable mWaitFramInterval           as integer     no-undo init 1 .
      425   define variable mWaitFramStop               as logical     no-undo.
      426   define variable mWaitFramStopUser           as logical     no-undo.
      427   define variable mWaitFramStopTimeOut        as logical     no-undo.
      428   define variable mWaitFramStartProc          as datetime-tz no-undo.
      429   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      430   define button B-WaitFramStop auto-end-key
      431        label "Стоп"
      432        size 10 by 1 tooltip "Остоновить процесс".
      433   define button B-viewProcInfo
      434        label "Информация"
      435        size 15 by 1 tooltip "Информация о процесс".
      436   define frame waitfram
      437     v-waitfram-action01 format "x(72)" no-label skip
      438     v-waitfram-action02 format "x(72)" no-label skip
      439     v-waitfram-action03 format "x(72)" no-label skip
      440     B-viewProcInfo
      441     B-WaitFramStop at row 4 col 30
      442     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      443     .
      444   define new global shared variable mBatchMode as logical no-undo init ?.
      445   define variable mFramBachModHandle as handle no-undo.
      446   mFramBachModHandle = frame waitfram:handle.
      447   define variable mFameOldVis as logical no-undo.
      448   define variable mVisCUrentVin as logical no-undo.
      449   if session:batch-mode
      450   then
      451      mBatchMode = yes.
      452   if mBatchMode = ? then do:
      453     mVisCUrentVin = current-window:visible.
      454     mFameOldVis = mFramBachModHandle:visible.
      455     mFramBachModHandle:visible  = yes.
      456     mBatchMode = mFramBachModHandle:visible ne yes.
      457     mFramBachModHandle:visible = mFameOldVis.
      458     current-window:visible = mVisCUrentVin.
      459   end.
      460    if  log-manager:logfile-name ne ?
      461     then DO:
      462         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      463         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      464         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      465     end.
      466   on choose of B-WaitFramStop in frame waitfram
      467   do:
      468     mWaitFramStop = yes.
      469     mWaitFramStopUser = yes.
      470   end.
      471   function waitfram-check-timeout returns logical():
      472      define variable vtime as int64 no-undo.
      473      if mWaitFramStopTimeOut
      474      then
      475         return yes.
      476      vtime = ( now - mWaitFramStartProc ) / 1000 .
      477      if     mWaitFramTimeOut ne ?
      478         and mWaitFramTimeOut ne 0
      479         and mWaitFramTimeOut lt vtime
      480      then do:
      481         mWaitFramStopTimeOut = yes.
      482      end.
      483      return mWaitFramStopTimeOut.
      484   end.
      485   procedure waitfram-hide :
      486     if not session:batch-mode
      487     then do
      488     on error undo, return error return-value
      489     :
      490       pause 0 before-hide .
      491       if not mBatchMode then
      492         hide frame waitfram .
      493     if     not mWaitFramView
      494        and mWaitProcEvent
      495     then
      496       process events .
      497     end.
      498   end procedure.
      499   procedure waitfram-show :
      500     define input  parameter p-message as character no-undo .
      501     define variable v-left-margin as integer   no-undo .
      502     if not session:batch-mode
      503     then do
      504     on error undo, return error return-value
      505     :
      506       if length(p-message) <= 70 then do:
      507         assign
      508           v-left-margin = integer((70 - length(p-message)) / 2)
      509         .
      510         assign
      511           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      512         .
      513         assign
      514           v-waitfram-action01 = " "
      515           v-waitfram-action02 = " "
      516                                    + fill(" ", v-left-margin)
      517                                    + p-message
      518           v-waitfram-action03 = " "
      519         .
      520       end.
      521       else do:
      522         define variable vRindex1 as integer no-undo.
      523         define variable vRindex2 as integer no-undo.
      524         vRindex1 = r-index(p-message," ",70).
      525         if vRindex1 = 0
      526         then
      527            vRindex1 = 70.
      528         if length(p-message)  <= vRindex1 + 70 then do:
      529           assign
      530             v-waitfram-action01 = " "
      531             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      532             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      533           .
      534         end.
      535         else do:
      536           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      537           if vRindex2 <= vRindex1
      538           then
      539              vRindex2 = vRindex1 + 70.
      540           assign
      541             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      542             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      543             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      544           .
      545         end.
      546       end.
      547       B-viewProcInfo:visible   in frame waitfram = no.
      548       B-viewProcInfo:sensitive in frame waitfram = no.
      549       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      550       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      551       if  (   mWaitFramView
      552          or  mWaitProcEvent)
      553          and not mBatchMode
      554       then
      555          display
      556             v-waitfram-action01 skip
      557             v-waitfram-action02 skip
      558             v-waitfram-action03 skip
      559          with frame waitfram .
      560       if     mWaitFramView
      561          then do:
      562             if     mWaitFramInterval ne ?
      563                and not mBatchMode
      564             then
      565                wait-for go of frame waitfram pause mWaitFramInterval.
      566          end.
      567          else
      568             if     mWaitProcEvent
      569                and not mBatchMode
      570             then
      571                process events .
      572     end.
      573   end procedure.
      574      procedure waitfram-show-this:
      575         define input  parameter iInterval as int64 no-undo.
      576         define variable vtime as int64 no-undo.
      577         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      578         mWaitFramInterval = iInterval.
      579         run waitfram-show (substitute("&1&2 &3&4" ,
      580                                       mWaitFramTextBeg ,
      581                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      582                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      583                                       mWaitFramTextEnd
      584                                      )
      585                           ).
      586      end.
      587      procedure WaitFramRunPause:
      588         define input  parameter iInterval as dec no-undo.
      589         define variable vStart  as datetime-tz no-undo.
      590         define variable vend    as datetime-tz no-undo.
      591         define variable vint as int64 no-undo.
      592         define variable vOk as logical no-undo.
      593         vStart = now.
      594         vend   = vStart.
      595         publish "WaitFramPause" (iInterval,output vOk).
      596         vend   =  now.
      597         vint = vend - vStart.
      598         vint = iInterval - vint / 1000.
      599         if     not mWaitFramStop
      600            and (   vint > 0
      601                 or (    not vOk
      602                     and iInterval eq ?
      603                     )
      604                 )
      605         then
      606            run waitfram-show-this (iInterval).
      607         vend   =  now.
      608         vint = vend - vStart.
      609         vint = iInterval - vint / 1000.
      610         if     not mWaitFramStop
      611            and vint > 0
      612         then do:
      613            run gbl/pause.p (vint * 1000).
      614         end.
      615         if iInterval ne ?
      616         then
      617            publish "WaitFramStop".
      618         waitfram-check-timeout().
      619      end.
      620      procedure WaitFramWaitFor:
      621         define input  parameter iInterval as dec no-undo.
      622         assign
      623            mWaitFramStartProc   = now
      624            mWaitFramStopUser    = no
      625            mWaitFramStopTimeOut = no
      626         .
      627         block-wait:
      628         do while not mWaitFramStop:
      629            run WaitFramRunPause (iInterval).
      630            if  waitfram-check-timeout()
      631            then do:
      632               leave block-wait.
      633            end.
      634         end.
      635         run waitfram-hide.
      636      end.
      637   procedure waitfram-join :
      638     define input  parameter p-line-1  as character no-undo .
      639     define input  parameter p-line-2  as character no-undo .
      640     define input  parameter p-line-3  as character no-undo .
      641     define output parameter p-message as character no-undo .
      642     do
      643     on error undo, return error return-value
      644     :
      645       assign
      646         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      647                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      648                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      649       .
      650     end.
      651   end procedure.
      652   function waitfram-join-function returns character
      653     (input p-line-1 as character
      654     ,input p-line-2 as character
      655     ,input p-line-3 as character
      656     ).
      657     define variable v-message as character no-undo .
      658     run waitfram-join in this-procedure
      659       (input  p-line-1
      660       ,input  p-line-2
      661       ,input  p-line-3
      662       ,output v-message
      663       ) .
      664     return v-message .
      665   end function .
      666   DEFINE VARIABLE r-bar-code like ub.bar-code.b-code no-undo.
      667   DEFINE VARIABLE num-rec as integer no-undo .
      668   DEFINE VARIABLE num-rec-ok as integer no-undo .
      669   DEFINE VARIABLE loc#log as logical no-undo .
      670   define stream errstream.
      671   message "Вы действительно хотите создать атрибут ВЕСОВОЙ КОД ТОВАРА НА ОБЪЕКТЕ ДЛЯ ВЕСОВЫХ ТОВАРОВ"
      672           "для всех объектов текущей БД?"
      673   view-as alert-box QUESTION buttons YES-NO update loc#log.
      674   if not loc#log then return.
      675   output stream errstream to uscdatr.err.
      676   _goods:
      677   FOR EACH ub.goods No-LOCK ,
      678       FIRST ub.units No-LOCK WHERE
      679             ub.units.unit-name = ub.goods.unit-base AND
      680             LOOKUP('вес':U, ub.units.type ) > 0:
      681     num-rec = num-rec + 1.
      682     do TRANSACTION on error undo, next _goods on stop undo, next _goods:
      683   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      684   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run sclcdattr in g#library
      685     (input  ub.goods.gds-code
      686     ,input  ''
      687     ,input  0
      688     ,input  ?
      689     ,input  no
      690     ) no-error .
      691     END.
      692     if not error-status:error then
      693     num-rec-ok = num-rec-ok + 1.
      694     ELSE DO:
      695       PUT stream Errstream UNFORMATTED
      696       return-value skip.
      697     end.
      698     if num-rec modulo 10 = 0 then do:
      699       run waitfram-show in this-procedure ("Обработано " + string(num-rec) + "  товаров.  Из  них успешно " + string(num-rec-ok)).
      700     end.
      701   END.
      702   run waitfram-hide in this-procedure .
      703   output stream errstream close.
      704   message "Утилита по созданию атрибута товара на объекте ВЕСОВОЙ КОД ТОВАРА"
      705           "работу завершила" SKIP
      706           "Из " num-rec " товаров в данной БД успешно обработаны " num-rec-ok skip
      707           string(if num-rec > num-rec-ok then
      708           "Ошибки ищите в файле uscldatr.err" else "")
      709   view-as alert-box .
