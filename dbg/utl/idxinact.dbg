        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: idxinact.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/idxinact.p $":U .
        7   define variable vss-description as character no-undo init "Проверяет что все индексы активны и выдает список неактивных индексов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable l-wordidx-inactive as logical no-undo init false .
       67   find first _index
       68     where _index._active = false
       69     no-error .
       70   if not available _index then do:
       71     message
       72       "Все индексы активны"
       73       view-as alert-box information .
       74     return .
       75   end.
       76   define variable v-database-name as character no-undo .
       77   assign
       78     v-database-name = dbname
       79   .
       80   run gbl/d-prompt.w (
       81       'title=\'
       82       + 'text1=Enter database name\'
       83       + 'text2=without .db extension\'
       84       + 'format=x(15)\'
       85       + 'type=char\'
       86       ,input-output v-database-name
       87       ).
       88   if return-value = 'false':u then do:
       89     return .
       90   end.
       91   define variable v-file-name as character no-undo .
       92   assign
       93     v-file-name = v-database-name + "_inact.txt"
       94   .
       95   output to value(v-file-name) .
       96   define variable i-ind as integer no-undo .
       97   for each _index
       98     where _index._active = false
       99   :
      100     assign
      101       i-ind = i-ind + 1
      102     .
      103     if _index._Wordidx <> ? then do:
      104       assign
      105         l-wordidx-inactive = true
      106       .
      107     end.
      108     find first _file of _index .
      109     display _file._file-name _index._index-name .
      110   end.
      111   output close .
      112   if i-ind <> 0 then do:
      113     message
      114       "Неактивно" i-ind "индексов" skip
      115       "Список неактивных индексов указан в файле" v-file-name skip
      116       "" (if l-wordidx-inactive
      117           then "ВНИМАНИЕ! В базе данных есть неактивные word индексы." + chr(10)
      118              + "Проверте правила разбиения на слова в базе данных."
      119           else ""
      120          ) skip
      121       "Для активизации индексов необходимо:" skip
      122       "1." + chr(9) + "Остановить базу данных" skip
      123       "2." + chr(9) + "Сделать архивную копию базы данных. ЭТО ОБЯЗАТЕЛЬНО." skip
      124       "3." + chr(9) + "Проверить внутренние настройки базы данных" skip
      125       chr(9) + "Кодовые страницы, правила преобразования регистра, правила разбиения на слова и т.д." skip
      126       "4." + chr(9) + "Запустить перестройку индексов" skip
      127       chr(9) + "_proutil " + v-database-name + ".db -C idxbuild" skip
      128       "5." + chr(9) + "Указать таблицы и индексы, которые требуют активизации" skip
      129       "6." + chr(9) + "Для завершения выбора индексов необходимо" skip
      130       chr(9) + "указать восклицательный знак '!'." skip
      131       view-as alert-box error.
      132   end.
      133   else do:
      134     message
      135       "Все индексы активны"
      136       view-as alert-box information .
      137   end.
