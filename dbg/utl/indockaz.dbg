        1   DEFINE INPUT PARAMETER parparentproc AS HANDLE NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Главное окно утилиты импорта документов по датам".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#library  as handle no-undo .
      112   define new global shared variable g#library2 as handle no-undo .
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define temp-table userobjs_temp-user-obj no-undo
      115     field obj-type as character
      116     field obj-code as integer
      117     index xpk is primary unique obj-type obj-code
      118     .
      119   procedure userobjs_clear :
      120     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      121     do
      122     on error undo, return error return-value
      123     :
      124       for each buf_userobjs_temp-user-obj
      125       on error undo, return error return-value
      126       :
      127         delete buf_userobjs_temp-user-obj .
      128       end.
      129     end.
      130   end .
      131   procedure userobjs_object-count :
      132     define output parameter p-total-count as integer   no-undo .
      133     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      134     do
      135     on error undo, return error return-value
      136     :
      137       assign
      138         p-total-count = 0
      139       .
      140       for each buf_userobjs_temp-user-obj
      141       on error undo, return error return-value
      142       :
      143         assign
      144           p-total-count = p-total-count + 1
      145         .
      146       end.
      147     end.
      148   end.
      149   procedure userobjs_append :
      150      define input  parameter p-obj-type as character no-undo .
      151      define input  parameter p-obj-code as integer   no-undo .
      152     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      153     do
      154     on error undo, return error return-value
      155     :
      156       find first buf_userobjs_temp-user-obj
      157         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      158           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      159         no-error .
      160       if not available buf_userobjs_temp-user-obj
      161       then do:
      162         create buf_userobjs_temp-user-obj .
      163         assign
      164           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      165           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      166         .
      167       end.
      168     end.
      169   end.
      170   procedure userobjs_object-exist :
      171     define output parameter p-object-exist as logical   no-undo .
      172     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      173     do
      174     on error undo, return error return-value
      175     :
      176       find first buf_userobjs_temp-user-obj
      177         no-error .
      178       if not available buf_userobjs_temp-user-obj
      179       then do:
      180         assign
      181           p-object-exist = false
      182         .
      183       end.
      184       else do:
      185         assign
      186           p-object-exist = true
      187         .
      188       end.
      189     end.
      190   end.
      191   procedure userobjs_transfer :
      192     define input  parameter p-callback-handle as handle no-undo .
      193     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      194     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      195     do
      196     on error undo, return error return-value
      197     :
      198       if valid-handle(p-callback-handle) <> true
      199       then do:
      200         message
      201           vss-workfile vss-revision vss-description skip
      202           "Ошибка задания входных параметров" skip
      203           "Неизвестный указатель на процедуру" skip
      204           view-as alert-box error .
      205         undo, return error return-value .
      206       end.
      207       if p-callback-handle :get-signature("userobjs_append") = ""
      208       then do:
      209         message
      210           vss-workfile vss-revision vss-description skip
      211           "Ошибка задания входных параметров" skip
      212           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      213                     ,p-callback-handle :file-name
      214                     ) skip
      215           view-as alert-box error .
      216         undo, return error return-value .
      217       end.
      218       for each buf_userobjs_temp-user-obj
      219       on error undo, return error return-value
      220       :
      221         run userobjs_append in p-callback-handle
      222           (input  buf_userobjs_temp-user-obj.obj-type
      223           ,input  buf_userobjs_temp-user-obj.obj-code
      224           ) .
      225       end.
      226     end.
      227   end procedure.
      228   procedure userobjs_select-one :
      229      define input  parameter parparentproc     as widget-handle no-undo .
      230      define input  parameter p-db-num          as integer   no-undo .
      231      define input  parameter p-user-id         as character no-undo .
      232      define input  parameter p-host-code-obj   as integer   no-undo .
      233      define input  parameter p-obj-type        as character no-undo .
      234      define input  parameter p-obj-code        as integer   no-undo .
      235      define output parameter p-user-select     as logical   no-undo .
      236      define output parameter p-select-obj-type as character no-undo .
      237      define output parameter p-select-obj-code as character no-undo .
      238     do
      239     on error undo, return error return-value
      240     :
      241       run gbl/userobjs.w
      242         (input  parparentproc
      243         ,input  this-procedure :handle
      244         ,input  p-db-num
      245         ,input  p-user-id
      246         ,input  p-host-code-obj
      247         ,input  p-obj-type
      248         ,input  p-obj-code
      249         ,INPUT  "b-sel"
      250         ,output p-user-select
      251         ,output p-select-obj-type
      252         ,output p-select-obj-code
      253         ) .
      254     end.
      255   end.
      256   procedure userobjs_select-many :
      257     define input  parameter parparentproc   as widget-handle no-undo .
      258     define input  parameter p-db-num        as integer   no-undo .
      259     define input  parameter p-user-id       as character no-undo .
      260     define input  parameter p-host-code-obj as integer   no-undo .
      261     define input  parameter p-obj-type      as character no-undo .
      262     define input  parameter p-obj-code      as integer   no-undo .
      263     define output parameter p-user-select   as logical   no-undo .
      264     define variable v-select-obj-type as character no-undo .
      265     define variable v-select-obj-code as integer   no-undo .
      266     do
      267     on error undo, return error return-value
      268     :
      269       run gbl/userobjs.w
      270         (input  parparentproc
      271         ,input  this-procedure :handle
      272         ,input  p-db-num
      273         ,input  p-user-id
      274         ,input  p-host-code-obj
      275         ,input  p-obj-type
      276         ,input  p-obj-code
      277         ,INPUT  "b-sel,b-mark"
      278         ,output p-user-select
      279         ,output v-select-obj-type
      280         ,output v-select-obj-code
      281         ) .
      282     end.
      283   end.
      284   procedure thobjs :
      285      define input        parameter parparentproc     as widget-handle no-undo .
      286      define input        parameter i-bttns           as character     no-undo .
      287      define input        parameter i-list-mode       as character     no-undo.
      288      define input        parameter i-obj-type        as character     no-undo.
      289      define input        parameter i-db-num          as integer       no-undo.
      290      define input        parameter i-host-code       as integer       no-undo.
      291      define input-output parameter p-rid-list        as character     no-undo .
      292   run ref/thobjs.p
      293           ( input parparentproc
      294            ,input  this-procedure :handle
      295           , input i-bttns
      296           , input i-list-mode
      297           , input i-obj-type
      298           , input i-db-num
      299           , input i-host-code
      300           , input-output p-rid-list ) no-error .
      301   end.
      302   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303     define variable v-cntxt-db-num        as integer   no-undo .
      304     define variable v-cntxt-userid        as character no-undo .
      305     define variable v-cntxt-level         as character no-undo .
      306     define variable v-cntxt-host-code-obj as integer   no-undo .
      307     define variable v-cntxt-obj-type      as character no-undo .
      308     define variable v-cntxt-obj-code      as integer   no-undo .
      309     define variable v-cntxt-db-num-obj    as integer   no-undo .
      310     define variable v-cntxt-is-admin      as logical   no-undo .
      311   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312     run mainmenu_getcntxt in parparentproc
      313       (output v-cntxt-db-num
      314       ,output v-cntxt-userid
      315       ,output v-cntxt-level
      316       ,output v-cntxt-host-code-obj
      317       ,output v-cntxt-obj-type
      318       ,output v-cntxt-obj-code
      319       ,output v-cntxt-db-num-obj
      320       ,output v-cntxt-is-admin
      321       ) .
      322   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      324   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      325   define variable par-type          as character no-undo.
      326   define variable v-value-character as character no-undo .
      327   define variable v-value-date      as date      no-undo .
      328   define variable v-value-decimal   as decimal   no-undo .
      329   define variable v-value-integer   as integer   no-undo .
      330   define variable v-value-logical   as logical   no-undo .
      331   DEFINE BUTTON b-agnt
      332        IMAGE-UP FILE "btn-down-arrow":U
      333        IMAGE-DOWN FILE "btn-down-arrow":U
      334        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      335        LABEL ""
      336        SIZE 3 BY .88.
      337   DEFINE BUTTON b-boss
      338        IMAGE-UP FILE "btn-down-arrow":U
      339        IMAGE-DOWN FILE "btn-down-arrow":U
      340        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      341        LABEL ""
      342        SIZE 3 BY .88.
      343   DEFINE BUTTON b-cancel AUTO-END-KEY
      344        LABEL "&Отмена"
      345        SIZE 10 BY 1
      346        BGCOLOR 8 .
      347   DEFINE BUTTON b-cli
      348        IMAGE-UP FILE "btn-down-arrow":U
      349        IMAGE-DOWN FILE "btn-down-arrow":U
      350        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      351        LABEL "b-cli"
      352        SIZE 3 BY .88.
      353   DEFINE BUTTON b-exit AUTO-GO
      354        LABEL "&Ввод"
      355        SIZE 10 BY 1
      356        BGCOLOR 8 .
      357   DEFINE BUTTON b-file-cli
      358        IMAGE-UP FILE "btn-down-arrow":U
      359        IMAGE-DOWN FILE "btn-down-arrow":U
      360        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      361        LABEL "b-file-cli"
      362        SIZE 3 BY .88.
      363   DEFINE BUTTON b-file-doc
      364        IMAGE-UP FILE "btn-down-arrow":U
      365        IMAGE-DOWN FILE "btn-down-arrow":U
      366        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      367        LABEL "b-file-doc"
      368        SIZE 3 BY .88.
      369   DEFINE BUTTON b-help
      370        LABEL "&Помощь"
      371        SIZE 10 BY 1
      372        BGCOLOR 8 .
      373   DEFINE BUTTON b-wrkr
      374        IMAGE-UP FILE "btn-down-arrow":U
      375        IMAGE-DOWN FILE "btn-down-arrow":U
      376        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      377        LABEL ""
      378        SIZE 3 BY .88.
      379   DEFINE VARIABLE varstatus AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      380        LABEL "Статус накладных"
      381        VIEW-AS COMBO-BOX INNER-LINES 3
      382        LIST-ITEM-PAIRS "накл-",0,
      383                        "накл+",1,
      384                        "факт",2
      385        DROP-DOWN-LIST
      386        SIZE 16 BY 1 NO-UNDO.
      387   DEFINE VARIABLE varagnt AS INTEGER FORMAT ">>>>9":U INITIAL 0
      388        LABEL "Исполнитель"
      389        VIEW-AS FILL-IN
      390        SIZE 6 BY 1 NO-UNDO.
      391   DEFINE VARIABLE varagnt-name AS CHARACTER FORMAT "X(256)":U
      392        VIEW-AS FILL-IN
      393        SIZE 34 BY 1 NO-UNDO.
      394   DEFINE VARIABLE varboss AS INTEGER FORMAT ">>>>9":U INITIAL 0
      395        LABEL "Менеджер"
      396        VIEW-AS FILL-IN
      397        SIZE 6 BY 1 NO-UNDO.
      398   DEFINE VARIABLE varboss-name AS CHARACTER FORMAT "X(256)":U
      399        VIEW-AS FILL-IN
      400        SIZE 34 BY 1 NO-UNDO.
      401   DEFINE VARIABLE varfile-cli AS CHARACTER FORMAT "X(256)":U INITIAL "id.txt"
      402        LABEL "Файл идентификации поставщиков"
      403        VIEW-AS FILL-IN
      404        SIZE 62 BY 1 NO-UNDO.
      405   DEFINE VARIABLE varfile-doc AS CHARACTER FORMAT "X(256)":U INITIAL "parts.txt"
      406        LABEL "Файл данных для накладных"
      407        VIEW-AS FILL-IN
      408        SIZE 62 BY 1 NO-UNDO.
      409   DEFINE VARIABLE varobj-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL 0
      410        LABEL "Объект"
      411        VIEW-AS FILL-IN
      412        SIZE 10 BY 1 NO-UNDO.
      413   DEFINE VARIABLE varobj-type AS CHARACTER FORMAT "X(3)"
      414        VIEW-AS FILL-IN
      415        SIZE 4 BY 1 NO-UNDO.
      416   DEFINE VARIABLE varwrkr AS INTEGER FORMAT ">>>>9":U INITIAL 0
      417        LABEL "Кладовщик"
      418        VIEW-AS FILL-IN
      419        SIZE 6 BY 1 NO-UNDO.
      420   DEFINE VARIABLE varwrkr-name AS CHARACTER FORMAT "X(256)":U
      421        VIEW-AS FILL-IN
      422        SIZE 34 BY 1 NO-UNDO.
      423   DEFINE QUERY Dialog-Frame FOR
      424         ub.clients SCROLLING.
      425   DEFINE FRAME Dialog-Frame
      426        b-exit AT ROW 1 COL 1
      427        b-cancel AT ROW 1 COL 11
      428        b-help AT ROW 1 COL 21
      429        varobj-code AT ROW 2 COL 31 COLON-ALIGNED
      430        varobj-type AT ROW 2 COL 41.5 COLON-ALIGNED NO-LABEL
      431        b-cli AT ROW 2 COL 48.5
      432        varfile-cli AT ROW 4 COL 1.5
      433        b-file-cli AT ROW 4 COL 96
      434        varfile-doc AT ROW 6 COL 31 COLON-ALIGNED
      435        b-file-doc AT ROW 6 COL 96
      436        varstatus AT ROW 8 COL 31 COLON-ALIGNED
      437        varagnt AT ROW 10 COL 31 COLON-ALIGNED
      438        varagnt-name AT ROW 10 COL 37.5 COLON-ALIGNED NO-LABEL
      439        b-agnt AT ROW 10 COL 74
      440        varboss AT ROW 12 COL 31 COLON-ALIGNED
      441        varboss-name AT ROW 12 COL 37.5 COLON-ALIGNED NO-LABEL
      442        b-boss AT ROW 12 COL 74
      443        varwrkr AT ROW 14 COL 31 COLON-ALIGNED
      444        varwrkr-name AT ROW 14 COL 37.5 COLON-ALIGNED NO-LABEL
      445        b-wrkr AT ROW 14 COL 74
      446        SPACE(24.12) SKIP(1.15)
      447       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      448            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      449            TITLE "Утилита импорта внешнего прихода по датам"
      450            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      451   ASSIGN
      452          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      453          FRAME Dialog-Frame:HIDDEN           = TRUE.
      454   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      455   DO:
      456     APPLY "END-ERROR":U TO SELF.
      457   END.
      458   ON CHOOSE OF b-agnt IN FRAME Dialog-Frame
      459   DO:
      460     DEFINE VARIABLE ref-rec  AS RECID     NO-UNDO.
      461     DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
      462     DEFINE VARIABLE varrecid AS RECID NO-UNDO.
      463     DEFINE BUFFER bf_clients FOR ub.clients.
      464     run ref/cli-all.w (  input parparentproc
      465                   ,  input "b-sel"
      466                   ,  input 'чел':U
      467                   ,  input ?
      468                   ,  input ?
      469                   ,  input ref-rec
      470                   ,  input ?
      471                   ,  input ?
      472                   , output ref-list ) .
      473     IF NUM-ENTRIES(ref-list) > 0 THEN DO:
      474       ASSIGN
      475         varrecid = INTEGER(ENTRY(1, ref-list)).
      476       FIND FIRST bf_clients WHERE recid(bf_clients) = varrecid NO-LOCK.
      477       DISPLAY bf_clients.obj-code @ varagnt bf_clients.obj-name @ varagnt-name WITH FRAME Dialog-Frame.
      478     END.
      479   END.
      480   ON CHOOSE OF b-boss IN FRAME Dialog-Frame
      481   DO:
      482       DEFINE VARIABLE ref-rec  AS RECID     NO-UNDO.
      483       DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
      484       DEFINE VARIABLE varrecid AS RECID NO-UNDO.
      485       DEFINE BUFFER bf_clients FOR ub.clients.
      486       run ref/cli-all.w (  input parparentproc
      487                     ,  input "b-sel"
      488                     ,  input 'чел':U
      489                     ,  input ?
      490                     ,  input ?
      491                     ,  input ref-rec
      492                     ,  input ?
      493                     ,  input ?
      494                     , output ref-list ) .
      495       IF NUM-ENTRIES(ref-list) > 0 THEN DO:
      496         ASSIGN
      497           varrecid = INTEGER(ENTRY(1, ref-list)).
      498         FIND FIRST bf_clients WHERE recid(bf_clients) = varrecid NO-LOCK.
      499         DISPLAY bf_clients.obj-code @ varboss bf_clients.obj-name @ varboss-name WITH FRAME Dialog-Frame.
      500       END.
      501   END.
      502   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
      503   DO:
      504     define variable v-user-select as logical   no-undo .
      505     define variable v-obj-type    as character no-undo .
      506     define variable v-obj-code    as integer   no-undo .
      507   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   run userobjs_select-one in this-procedure
      509     (input  parparentproc
      510     ,input  v-cntxt-db-num
      511     ,input  v-cntxt-userid
      512     ,input  v-cntxt-host-code-obj
      513     ,input  v-cntxt-obj-type
      514     ,input  v-cntxt-obj-code
      515     ,output v-user-select
      516     ,output v-obj-type
      517     ,output v-obj-code
      518     )  .
      519     if v-user-select <> true
      520     then do:
      521       RETURN NO-APPLY.
      522     end.
      523     DISPLAY
      524       v-obj-type @ varobj-type
      525       v-obj-code @ varobj-code
      526       WITH FRAME Dialog-Frame.
      527   END.
      528   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      529   DO:
      530     DEFINE BUFFER bf_clients FOR ub.clients.
      531     define variable varchk-prs      as logical   no-undo .
      532     define variable varchk-prs-type as character no-undo.
      533     ASSIGN FRAME Dialog-Frame
      534       varfile-cli
      535       varfile-doc
      536       varobj-type
      537       varobj-code
      538       varagnt
      539       varboss
      540       varwrkr
      541       varstatus.
      542     IF SEARCH(varfile-cli) = ? THEN DO:
      543       MESSAGE "Не найден файл идентификации поставщиков: " varfile-cli VIEW-AS ALERT-BOX ERROR.
      544       APPLY "entry" TO varfile-cli IN FRAME Dialog-Frame.
      545       RETURN NO-APPLY.
      546     END.
      547     IF SEARCH(varfile-doc) = ? THEN DO:
      548         MESSAGE "Не найден файл данных для накладных: " varfile-doc VIEW-AS ALERT-BOX ERROR.
      549         APPLY "entry" TO varfile-doc IN FRAME Dialog-Frame.
      550         RETURN NO-APPLY.
      551     END.
      552     IF varobj-type <> 'маг':U AND varobj-type <> 'скл':U THEN DO:
      553       MESSAGE "Объект должен быть типа " 'маг':U " или " 'скл':U " ."  VIEW-AS ALERT-BOX ERROR.
      554       APPLY "ENTRY" TO varobj-type IN FRAME Dialog-Frame.
      555       RETURN NO-APPLY.
      556     END.
      557     FIND FIRST bf_clients WHERE bf_clients.obj-type = varobj-type AND
      558                                 bf_clients.obj-code = varobj-code NO-LOCK NO-ERROR.
      559     IF NOT AVAILABLE bf_clients THEN DO:
      560       MESSAGE "Не найден объект " varobj-type " " varobj-code VIEW-AS ALERT-BOX ERROR.
      561       APPLY "ENTRY" TO varobj-code IN FRAME Dialog-Frame.
      562       RETURN NO-APPLY.
      563     END.
      564     if varagnt <> 0 and varagnt <> ? then do:
      565       FIND FIRST bf_clients WHERE bf_clients.obj-type = 'чел':U  AND
      566                                   bf_clients.obj-code = varagnt NO-LOCK NO-ERROR.
      567       IF NOT AVAILABLE bf_clients THEN DO:
      568         MESSAGE "Не найден исполнитель " varagnt VIEW-AS ALERT-BOX ERROR.
      569         APPLY "ENTRY" TO varagnt IN FRAME Dialog-Frame.
      570         RETURN NO-APPLY.
      571       END.
      572     END.
      573     if varboss <> 0 and varboss <> ? then do:
      574       FIND FIRST bf_clients WHERE bf_clients.obj-type = 'чел':U  AND
      575                                   bf_clients.obj-code = varboss NO-LOCK NO-ERROR.
      576       IF NOT AVAILABLE bf_clients THEN DO:
      577         MESSAGE "Не найден менеджер " varboss VIEW-AS ALERT-BOX ERROR.
      578         APPLY "ENTRY" TO varboss IN FRAME Dialog-Frame.
      579         RETURN NO-APPLY.
      580       END.
      581     END.
      582     if varwrkr <> 0 and varwrkr <> ? then do:
      583       FIND FIRST bf_clients WHERE bf_clients.obj-type = 'чел':U  AND
      584                                   bf_clients.obj-code = varwrkr NO-LOCK NO-ERROR.
      585       IF NOT AVAILABLE bf_clients THEN DO:
      586         MESSAGE "Не найден кладовщик " varwrkr VIEW-AS ALERT-BOX ERROR.
      587         APPLY "ENTRY" TO varwrkr IN FRAME Dialog-Frame.
      588         RETURN NO-APPLY.
      589       END.
      590     END.
      591   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   empty temp-table thbjattr_thbj-attr.
      593   run adm/shattri.p (
      594      input "get":U
      595     ,input ''
      596     ,input 0
      597     ,input 'nakl-glob':U
      598     ,input  ""
      599     ,output v-value-character
      600     ,output v-value-date
      601     ,output v-value-decimal
      602     ,output v-value-integer
      603     ,output v-value-logical
      604     ,output par-type
      605     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      606     ) no-error .
      607   for each thbjattr_thbj-attr :
      608       if thbjattr_thbj-attr.prop-code = 'chk-prs'   then varchk-prs     = thbjattr_thbj-attr.property-value-logical .
      609   end.
      610     if varchk-prs then do:
      611       if varagnt = 0 or varagnt = ? then do:
      612         message "Не указан исполнитель " varagnt view-as alert-box error.
      613         apply "entry" to varagnt in frame Dialog-Frame.
      614         return no-apply.
      615       end.
      616       if varboss = 0 or varboss = ? then do:
      617         message "Не указан менеджер " varboss view-as alert-box error.
      618         apply "entry" to varboss in frame Dialog-Frame.
      619         return no-apply.
      620       end.
      621       if varwrkr = 0 or varwrkr = ? then do:
      622         message "Не указан кладовщик " varwrkr view-as alert-box error.
      623         apply "entry" to varwrkr in frame Dialog-Frame.
      624         return no-apply.
      625       end.
      626     end.
      627     run utl/indocka.p (INPUT parparentproc, INPUT varobj-type, INPUT varobj-code, INPUT varfile-cli, INPUT varfile-doc, INPUT varstatus, INPUT varagnt, INPUT varboss, INPUT varwrkr) NO-ERROR.
      628   END.
      629   ON CHOOSE OF b-file-cli IN FRAME Dialog-Frame
      630   DO:
      631     DEFINE VARIABLE varfile-txt AS CHARACTER NO-UNDO.
      632     DEFINE VARIABLE varlog      AS LOGICAL   NO-UNDO.
      633     system-dialog get-file varfile-txt
      634     title "Выберите файл идентификации поставщиков"
      635          filters "txt" "*.txt",
      636                  "Все файлы" "*.*"
      637          update varlog.
      638     IF varlog THEN DO:
      639       DISPLAY varfile-txt @ varfile-cli WITH FRAME Dialog-Frame.
      640     END.
      641   END.
      642   ON CHOOSE OF b-file-doc IN FRAME Dialog-Frame
      643   DO:
      644     DEFINE VARIABLE varfile-txt AS CHARACTER NO-UNDO.
      645     DEFINE VARIABLE varlog      AS LOGICAL   NO-UNDO.
      646     system-dialog get-file varfile-txt
      647     title "Выберите файл данных для накладных"
      648          filters "txt" "*.txt",
      649                  "Все файлы" "*.*"
      650          update varlog.
      651     IF varlog THEN DO:
      652       DISPLAY varfile-txt @ varfile-doc WITH FRAME Dialog-Frame.
      653     END.
      654   END.
      655   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      656   OR HELP OF FRAME Dialog-Frame
      657   DO:
      658     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\utl\indockaz.w" VIEW-AS ALERT-BOX INFORMATION.
      659   END.
      660   ON CHOOSE OF b-wrkr IN FRAME Dialog-Frame
      661   DO:
      662       DEFINE VARIABLE ref-rec  AS RECID     NO-UNDO.
      663       DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
      664       DEFINE VARIABLE varrecid AS RECID NO-UNDO.
      665       DEFINE BUFFER bf_clients FOR ub.clients.
      666       run ref/cli-all.w (  input parparentproc
      667                     ,  input "b-sel"
      668                     ,  input 'чел':U
      669                     ,  input ?
      670                     ,  input ?
      671                     ,  input ref-rec
      672                     ,  input ?
      673                     ,  input ?
      674                     , output ref-list ) .
      675       IF NUM-ENTRIES(ref-list) > 0 THEN DO:
      676         ASSIGN
      677           varrecid = INTEGER(ENTRY(1, ref-list)).
      678         FIND FIRST bf_clients WHERE recid(bf_clients) = varrecid NO-LOCK.
      679         DISPLAY bf_clients.obj-code @ varwrkr bf_clients.obj-name @ varwrkr-name WITH FRAME Dialog-Frame.
      680       END.
      681   END.
      682   ON LEAVE OF varagnt IN FRAME Dialog-Frame
      683   DO:
      684       DEFINE BUFFER bf_clients FOR ub.clients.
      685       FIND FIRST bf_clients WHERE bf_clients.obj-type = 'чел':U AND
      686                                   bf_clients.obj-code = INPUT FRAME Dialog-Frame varagnt NO-LOCK NO-ERROR.
      687       IF AVAILABLE bf_clients THEN DO:
      688         DISPLAY bf_clients.obj-name @ varagnt-name WITH FRAME Dialog-Frame.
      689       END.
      690   END.
      691   ON LEAVE OF varboss IN FRAME Dialog-Frame
      692   DO:
      693      DEFINE BUFFER bf_clients FOR ub.clients.
      694     FIND FIRST bf_clients WHERE bf_clients.obj-type = 'чел':U AND
      695                                 bf_clients.obj-code = INPUT FRAME Dialog-Frame varboss NO-LOCK NO-ERROR.
      696     IF AVAILABLE bf_clients THEN DO:
      697       DISPLAY bf_clients.obj-name @ varboss-name WITH FRAME Dialog-Frame.
      698     END.
      699   END.
      700   ON LEAVE OF varwrkr IN FRAME Dialog-Frame
      701   DO:
      702       DEFINE BUFFER bf_clients FOR ub.clients.
      703       FIND FIRST bf_clients WHERE bf_clients.obj-type = 'чел':U AND
      704                                   bf_clients.obj-code = INPUT FRAME Dialog-Frame varwrkr NO-LOCK NO-ERROR.
      705       IF AVAILABLE bf_clients THEN DO:
      706         DISPLAY bf_clients.obj-name @ varwrkr-name WITH FRAME Dialog-Frame.
      707       END.
      708   END.
      709   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      710   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      711   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712   on help of frame Dialog-Frame
      713   do:
      714     run gbl/app_help.p
      715       (input this-procedure :file-name
      716       ,input ''
      717       ,input ?
      718       ) no-error.
      719     if error-status :error then do:
      720       message
      721         "Ошибка при вызове помощи"
      722         error-status :get-message(1)
      723         view-as alert-box .
      724     end.
      725   end.
      726   run minbtn-set in this-procedure .
      727   on choose of b-help in frame Dialog-Frame
      728   do:
      729     apply "help":u to frame Dialog-Frame .
      730   end.
      731   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      732   procedure minbtn-set :
      733       do
      734           on error undo, return error return-value
      735           :
      736           define variable ii              as integer       no-undo .
      737           define variable fh              as widget-handle no-undo .
      738           define variable hh              as widget-handle no-undo .
      739           define variable v-h             as handle        extent 4 no-undo .
      740           define variable v-name-button   as character     no-undo .
      741           define variable v-help-old-x    as decimal       no-undo .
      742           define variable v-help-old-y    as decimal       no-undo .
      743           define variable v-help-old-size as decimal       no-undo .
      744           define variable v-frame-width   as decimal       no-undo .
      745           define variable jj              as integer       no-undo .
      746           do
      747               on error undo, return error
      748               :
      749               assign
      750                   v-frame-width = frame Dialog-Frame:width - 0.3
      751                   fh            = frame Dialog-Frame:first-child
      752                   hh            = fh:first-child
      753                   ii            = 1
      754                   .
      755               do while valid-handle(hh):
      756                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      757                   do:
      758                       case lc(hh:name) :
      759                           when "b-help" then
      760                               do:
      761                                   hh:load-image-up("cmp/b-help.bmp":u) .
      762                                   hh:load-image-down("cmp/b-help.bmp":u) .
      763                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      764                                   hh:TOOLTIP = "Помощь" .
      765                                   v-help-old-x = hh:column .
      766                                   v-help-old-y = hh:row    .
      767                                   v-help-old-size = hh:width .
      768                                   hh:width-chars = 2.5 .
      769                               end.
      770                           when "b-print" then
      771                               do:
      772                                   hh:load-image("cmp/b-print.bmp":u) .
      773                                   hh:TOOLTIP = "Печать" .
      774                                   v-h[ii] = hh:handle .
      775                                   ii = ii + 1 .
      776                                   hh:width-chars = 3 .
      777                               end.
      778                           when "b-history" or
      779                           when "b-hist" then
      780                               do:
      781                                   hh:load-image("cmp/b-hist.bmp":u) .
      782                                   hh:TOOLTIP = "История" .
      783                                   v-h[ii] = hh:handle .
      784                                   ii = ii + 1 .
      785                                   hh:width-chars = 3 .
      786                               end.
      787                           when "b-sch" then
      788                               do:
      789                                   hh:load-image("cmp/b-sch.bmp":u) .
      790                                   hh:TOOLTIP = "Установка Фильтра" .
      791                                   v-h[ii] = hh:handle .
      792                                   ii = ii + 1 .
      793                                   hh:width-chars = 3 .
      794                               end.
      795                           when "b-hist-user" then
      796                               do:
      797                                   hh:load-image("cmp/b-hist.bmp":u) .
      798                                   hh:TOOLTIP = "История пользователя" .
      799                                   ii = ii + 1 .
      800                               end.
      801                       end case.
      802                   end.
      803                   hh = hh:next-sibling.
      804               end.
      805               b-help:column = v-frame-width - b-help:width-chars.
      806               jj = 0.
      807               repeat ii = 4 to 1 by -1 :
      808                   if valid-handle (v-h[ii] ) then
      809                   do:
      810                       jj  = jj + 1 .
      811                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      812                       v-h[ii]:row    = v-help-old-y .
      813                   end.
      814               end.
      815           end.
      816       end.
      817   end procedure.
      818   MAIN-BLOCK:
      819   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      820      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      821     RUN enable_UI.
      822     WAIT-FOR GO OF FRAME Dialog-Frame.
      823   END.
      824   RUN disable_UI.
      825   PROCEDURE disable_UI :
      826     HIDE FRAME Dialog-Frame.
      827   END PROCEDURE.
      828   PROCEDURE enable_UI :
      829     OPEN QUERY Dialog-Frame FOR EACH ub.clients SHARE-LOCK.
      830     GET FIRST Dialog-Frame.
      831     DISPLAY varobj-code varobj-type varfile-cli varfile-doc varstatus varagnt
      832             varagnt-name varboss varboss-name varwrkr varwrkr-name
      833         WITH FRAME Dialog-Frame.
      834     ENABLE b-exit b-cancel b-help varobj-code varobj-type b-cli varfile-cli
      835            b-file-cli varfile-doc b-file-doc varstatus varagnt b-agnt varboss
      836            b-boss varwrkr b-wrkr
      837         WITH FRAME Dialog-Frame.
      838     VIEW FRAME Dialog-Frame.
      839   END PROCEDURE.
