        1   define input-output parameter p-dir1 as character no-undo .
        2   define input-output parameter p-dir2 as character no-undo .
        3   define input-output parameter p-dir3 as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Запрашивает три директории".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   DEFINE BUTTON b-exit AUTO-GO
       65        LABEL "&Ввод"
       66        SIZE 10 BY 1
       67        BGCOLOR 8 .
       68   DEFINE BUTTON b-help
       69        LABEL "Помо&щь"
       70        SIZE 10 BY 1
       71        BGCOLOR 8 .
       72   DEFINE BUTTON b-quit AUTO-END-KEY
       73        LABEL "Отка&з"
       74        SIZE 10 BY 1
       75        BGCOLOR 8 .
       76   DEFINE BUTTON b-sel-dir1
       77        IMAGE-UP FILE "btn-down-arrow":U
       78        IMAGE-DOWN FILE "btn-down-arrow":U
       79        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       80        LABEL "b sel dir 1"
       81        SIZE 3 BY .87.
       82   DEFINE BUTTON b-sel-dir2
       83        IMAGE-UP FILE "btn-down-arrow":U
       84        IMAGE-DOWN FILE "btn-down-arrow":U
       85        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       86        LABEL "b sel dir 2"
       87        SIZE 3 BY .87.
       88   DEFINE BUTTON b-sel-dir3
       89        IMAGE-UP FILE "btn-down-arrow":U
       90        IMAGE-DOWN FILE "btn-down-arrow":U
       91        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       92        LABEL "b sel dir 2"
       93        SIZE 3 BY .87.
       94   DEFINE VARIABLE fi-dir1 AS CHARACTER FORMAT "X(256)":U
       95        LABEL "Старая"
       96        VIEW-AS FILL-IN
       97        SIZE 60.8 BY 1 NO-UNDO.
       98   DEFINE VARIABLE fi-dir2 AS CHARACTER FORMAT "X(256)":U
       99        LABEL "Новая"
      100        VIEW-AS FILL-IN
      101        SIZE 60.9 BY 1 NO-UNDO.
      102   DEFINE VARIABLE fi-dir3 AS CHARACTER FORMAT "X(256)":U
      103        LABEL "Пакет обновления"
      104        VIEW-AS FILL-IN
      105        SIZE 60.8 BY 1 NO-UNDO.
      106   DEFINE FRAME Dialog-Frame
      107        b-exit AT ROW 1 COL 1
      108        b-quit AT ROW 1 COL 11
      109        b-help AT ROW 1 COL 21
      110        fi-dir1 AT ROW 2.6 COL 15
      111        b-sel-dir1 AT ROW 2.63 COL 84.8
      112        fi-dir2 AT ROW 4.13 COL 21 COLON-ALIGNED
      113        b-sel-dir2 AT ROW 4.17 COL 85
      114        fi-dir3 AT ROW 5.63 COL 21 COLON-ALIGNED
      115        b-sel-dir3 AT ROW 5.7 COL 85.1
      116        SPACE(8.89) SKIP(0.69)
      117       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      118            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      119            TITLE "Сравнение директорий *.r кодов"
      120            CANCEL-BUTTON b-quit.
      121   ASSIGN
      122          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      123          FRAME Dialog-Frame:HIDDEN           = TRUE.
      124   ON GO OF FRAME Dialog-Frame
      125   DO:
      126     run validate-dir in this-procedure
      127       (input fi-dir1 :screen-value
      128       ,input fi-dir2 :screen-value
      129       ,input fi-dir3 :screen-value
      130       ) no-error .
      131     if error-status :error
      132     then do:
      133       if return-value <> ""
      134       then do:
      135         case return-value :
      136           when "p-dir1"
      137           then do:
      138             apply "entry":u to fi-dir1 .
      139           end.
      140           when "p-dir2"
      141           then do:
      142             apply "entry":u to fi-dir2 .
      143           end.
      144           when "p-dir3"
      145           then do:
      146             apply "entry":u to fi-dir3 .
      147           end.
      148         end.
      149       end.
      150       undo, return no-apply .
      151     end.
      152     assign
      153       p-dir1 = fi-dir1 :screen-value
      154       p-dir2 = fi-dir2 :screen-value
      155       p-dir3 = fi-dir3 :screen-value
      156     .
      157   END.
      158   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      159   DO:
      160     APPLY "END-ERROR":U TO SELF.
      161   END.
      162   ON CHOOSE OF b-sel-dir1 IN FRAME Dialog-Frame
      163   DO:
      164   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   if lookup(self :type
      166            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      167            ) = 0
      168   then do:
      169     message
      170       "$Workfile$"
      171       "Указанному интерфейсному элементу фокус не может быть передан" skip
      172       "Интерфейсный элемент" self :name  skip
      173       "Тип" self :type  skip
      174       "Процедура" this-procedure :file-name skip
      175       view-as alert-box .
      176   end.
      177   else do:
      178     apply "entry":u to self  .
      179     if focus :handle <> self :handle  then do:
      180       return no-apply .
      181     end.
      182   end.
      183     define variable v-dir-name  as character no-undo .
      184     define variable v-dir-type  as character no-undo .
      185     define variable v-can-write as logical   no-undo .
      186     run gbl/dir-sel.p
      187       (output v-dir-name
      188       ,output v-dir-type
      189       ,output v-can-write
      190       ) .
      191     if v-dir-name <> ""
      192     then do:
      193       assign
      194         fi-dir1 :screen-value = v-dir-name
      195       .
      196     end.
      197   END.
      198   ON CHOOSE OF b-sel-dir2 IN FRAME Dialog-Frame
      199   DO:
      200   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   if lookup(self :type
      202            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      203            ) = 0
      204   then do:
      205     message
      206       "$Workfile$"
      207       "Указанному интерфейсному элементу фокус не может быть передан" skip
      208       "Интерфейсный элемент" self :name  skip
      209       "Тип" self :type  skip
      210       "Процедура" this-procedure :file-name skip
      211       view-as alert-box .
      212   end.
      213   else do:
      214     apply "entry":u to self  .
      215     if focus :handle <> self :handle  then do:
      216       return no-apply .
      217     end.
      218   end.
      219     define variable v-dir-name  as character no-undo .
      220     define variable v-dir-type  as character no-undo .
      221     define variable v-can-write as logical   no-undo .
      222     run gbl/dir-sel.p
      223       (output v-dir-name
      224       ,output v-dir-type
      225       ,output v-can-write
      226       ) .
      227     if v-dir-name <> ""
      228     then do:
      229       assign
      230         fi-dir2 :screen-value = v-dir-name
      231       .
      232     end.
      233   END.
      234   ON CHOOSE OF b-sel-dir3 IN FRAME Dialog-Frame
      235   DO:
      236   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if lookup(self :type
      238            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      239            ) = 0
      240   then do:
      241     message
      242       "$Workfile$"
      243       "Указанному интерфейсному элементу фокус не может быть передан" skip
      244       "Интерфейсный элемент" self :name  skip
      245       "Тип" self :type  skip
      246       "Процедура" this-procedure :file-name skip
      247       view-as alert-box .
      248   end.
      249   else do:
      250     apply "entry":u to self  .
      251     if focus :handle <> self :handle  then do:
      252       return no-apply .
      253     end.
      254   end.
      255     define variable v-dir-name  as character no-undo .
      256     define variable v-dir-type  as character no-undo .
      257     define variable v-can-write as logical   no-undo .
      258     run gbl/dir-sel.p
      259       (output v-dir-name
      260       ,output v-dir-type
      261       ,output v-can-write
      262       ) .
      263     if v-dir-name <> ""
      264     then do:
      265       assign
      266         fi-dir3 :screen-value = v-dir-name
      267       .
      268     end.
      269   END.
      270   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   on help of frame Dialog-Frame
      272   do:
      273     run gbl/app_help.p
      274       (input this-procedure :file-name
      275       ,input ''
      276       ,input ?
      277       ) no-error.
      278     if error-status :error then do:
      279       message
      280         "Ошибка при вызове помощи"
      281         error-status :get-message(1)
      282         view-as alert-box .
      283     end.
      284   end.
      285   run minbtn-set in this-procedure .
      286   on choose of b-help in frame Dialog-Frame
      287   do:
      288     apply "help":u to frame Dialog-Frame .
      289   end.
      290   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      291   procedure minbtn-set :
      292       do
      293           on error undo, return error return-value
      294           :
      295           define variable ii              as integer       no-undo .
      296           define variable fh              as widget-handle no-undo .
      297           define variable hh              as widget-handle no-undo .
      298           define variable v-h             as handle        extent 4 no-undo .
      299           define variable v-name-button   as character     no-undo .
      300           define variable v-help-old-x    as decimal       no-undo .
      301           define variable v-help-old-y    as decimal       no-undo .
      302           define variable v-help-old-size as decimal       no-undo .
      303           define variable v-frame-width   as decimal       no-undo .
      304           define variable jj              as integer       no-undo .
      305           do
      306               on error undo, return error
      307               :
      308               assign
      309                   v-frame-width = frame Dialog-Frame:width - 0.3
      310                   fh            = frame Dialog-Frame:first-child
      311                   hh            = fh:first-child
      312                   ii            = 1
      313                   .
      314               do while valid-handle(hh):
      315                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      316                   do:
      317                       case lc(hh:name) :
      318                           when "b-help" then
      319                               do:
      320                                   hh:load-image-up("cmp/b-help.bmp":u) .
      321                                   hh:load-image-down("cmp/b-help.bmp":u) .
      322                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      323                                   hh:TOOLTIP = "Помощь" .
      324                                   v-help-old-x = hh:column .
      325                                   v-help-old-y = hh:row    .
      326                                   v-help-old-size = hh:width .
      327                                   hh:width-chars = 2.5 .
      328                               end.
      329                           when "b-print" then
      330                               do:
      331                                   hh:load-image("cmp/b-print.bmp":u) .
      332                                   hh:TOOLTIP = "Печать" .
      333                                   v-h[ii] = hh:handle .
      334                                   ii = ii + 1 .
      335                                   hh:width-chars = 3 .
      336                               end.
      337                           when "b-history" or
      338                           when "b-hist" then
      339                               do:
      340                                   hh:load-image("cmp/b-hist.bmp":u) .
      341                                   hh:TOOLTIP = "История" .
      342                                   v-h[ii] = hh:handle .
      343                                   ii = ii + 1 .
      344                                   hh:width-chars = 3 .
      345                               end.
      346                           when "b-sch" then
      347                               do:
      348                                   hh:load-image("cmp/b-sch.bmp":u) .
      349                                   hh:TOOLTIP = "Установка Фильтра" .
      350                                   v-h[ii] = hh:handle .
      351                                   ii = ii + 1 .
      352                                   hh:width-chars = 3 .
      353                               end.
      354                           when "b-hist-user" then
      355                               do:
      356                                   hh:load-image("cmp/b-hist.bmp":u) .
      357                                   hh:TOOLTIP = "История пользователя" .
      358                                   ii = ii + 1 .
      359                               end.
      360                       end case.
      361                   end.
      362                   hh = hh:next-sibling.
      363               end.
      364               b-help:column = v-frame-width - b-help:width-chars.
      365               jj = 0.
      366               repeat ii = 4 to 1 by -1 :
      367                   if valid-handle (v-h[ii] ) then
      368                   do:
      369                       jj  = jj + 1 .
      370                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      371                       v-h[ii]:row    = v-help-old-y .
      372                   end.
      373               end.
      374           end.
      375       end.
      376   end procedure.
      377   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      378   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      379   MAIN-BLOCK:
      380   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      381      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      382     RUN enable_UI.
      383     assign
      384       fi-dir1 :screen-value = p-dir1
      385       fi-dir2 :screen-value = p-dir2
      386       fi-dir3 :screen-value = p-dir3
      387     .
      388     assign
      389       p-dir1 = ""
      390       p-dir2 = ""
      391       p-dir3 = ""
      392     .
      393     WAIT-FOR GO OF FRAME Dialog-Frame.
      394   END.
      395   RUN disable_UI.
      396   PROCEDURE disable_UI :
      397     HIDE FRAME Dialog-Frame.
      398   END PROCEDURE.
      399   PROCEDURE enable_UI :
      400     DISPLAY fi-dir1 fi-dir2 fi-dir3
      401         WITH FRAME Dialog-Frame.
      402     ENABLE b-exit b-quit b-help fi-dir1 b-sel-dir1 fi-dir2 b-sel-dir2 fi-dir3
      403            b-sel-dir3
      404         WITH FRAME Dialog-Frame.
      405     VIEW FRAME Dialog-Frame.
      406   END PROCEDURE.
      407   PROCEDURE validate-dir :
      408     define input  parameter p-dir1 as character no-undo .
      409     define input  parameter p-dir2 as character no-undo .
      410     define input  parameter p-dir3 as character no-undo .
      411     if p-dir1 = ""
      412     or p-dir1 = ?
      413     then do:
      414       message
      415         "Необходимо ввести имя директории" skip
      416         view-as alert-box error .
      417       undo, return error "p-dir1" .
      418     end.
      419     if p-dir2 = ""
      420     or p-dir2 = ?
      421     then do:
      422       message
      423         "Необходимо ввести имя директории" skip
      424         view-as alert-box error .
      425       undo, return error "p-dir2" .
      426     end.
      427     if p-dir3 = ""
      428     or p-dir3 = ?
      429     then do:
      430       message
      431         "Необходимо ввести имя директории" skip
      432         view-as alert-box error .
      433       undo, return error "p-dir3" .
      434     end.
      435     if p-dir1 = p-dir2
      436     or p-dir2 = p-dir3
      437     or p-dir1 = p-dir3
      438     then do:
      439       message
      440         "Все директории должны быть различны" skip
      441         view-as alert-box error .
      442       undo, return error .
      443     end.
      444     assign
      445       file-info :file-name = p-dir1
      446     .
      447     if file-info :file-type = ?
      448     or index(file-info :file-type, 'D':u) = 0
      449     then do:
      450       message
      451         "Неправильно указана Директория 1" skip
      452         "" p-dir1 skip
      453         view-as alert-box error .
      454       undo, return error "p-dir1" .
      455     end.
      456     assign
      457       file-info :file-name = p-dir2
      458     .
      459     if file-info :file-type = ?
      460     or index(file-info :file-type, 'D':u) = 0
      461     then do:
      462       message
      463         "Неправильно указана Директория 2" skip
      464         "" p-dir2 skip
      465         view-as alert-box error .
      466       undo, return error "p-dir2" .
      467     end.
      468     assign
      469       file-info :file-name = p-dir3
      470     .
      471     if file-info :file-type = ?
      472     or index(file-info :file-type, 'D':u) = 0
      473     then do:
      474       message
      475         "Неправильно указана Директория 3" skip
      476         "" p-dir3 skip
      477         view-as alert-box error .
      478       undo, return error "p-dir3" .
      479     end.
      480   END PROCEDURE.
