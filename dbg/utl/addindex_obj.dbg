        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: addindex_obj.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/addindex_obj.p $":U .
        7   define variable vss-description as character no-undo init "Все таблицы с Host-code obj-type obj-code".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define buffer buf-_Field for ub._Field  .
       67   define temp-table temp-t no-undo
       68   field nametable as character
       69   field namefield as character
       70   field namefield2 as character
       71   index pi nametable namefield
       72   .
       73   define temp-table temp-i no-undo
       74   field nametable as character
       75   field namefield as character
       76   field nameindex as character
       77   index pi nametable namefield nameindex
       78   .
       79   define stream outstrim.
       80   output stream outstrim to value("c:\ttable.df") .
       81    run proc-obj.
       82    run proc-host.
       83    run proc-host-other.
       84    run proc-obj-other.
       85   output stream outstrim close.
       86   procedure proc-obj :
       87     do
       88     on error undo, return error return-value
       89     :
       90   empty temp-table temp-i.
       91   empty temp-table temp-t.
       92   define buffer buf1_Field for ub._Field  .
       93   for each _File no-lock :
       94      find first _Field no-lock of _File
       95           where _Field._Field-Name = 'obj-type'
       96           no-error .
       97      find first buf1_Field no-lock of _File
       98           where buf1_Field._Field-Name = 'obj-code'
       99           no-error .
      100       if available _Field and available  buf1_Field then do:
      101          create temp-t .
      102           assign
      103             temp-t.nametable = _File._File-Name
      104             temp-t.namefield = _Field._Field-Name
      105           .
      106             for each _index no-lock of _file  :
      107               for each  _index-field no-lock of _index  :
      108                   find first buf-_field no-lock of _index-field no-error .
      109                   if buf-_Field._Field-Name = 'obj-type' then do:
      110                       create temp-i .
      111                         assign
      112                           temp-i.nametable = _File._File-Name
      113                           temp-i.namefield = _Field._Field-Name
      114                           temp-i.nameindex = _index._index-name
      115                         .
      116                       leave.
      117                   end.
      118                   else do:
      119                       leave.
      120                   end.
      121               end.
      122             end.
      123      end.
      124      end.
      125   for each temp-t where
      126            not can-find ( first temp-i where temp-i.nametable = temp-t.nametable ) :
      127       put stream outstrim unformatted
      128         substitute('ADD INDEX &2auto_obj&2 ON &2&1&2' , temp-t.nametable , chr(34)) skip
      129         substitute('AREA &1Schema Area&1' , chr(34) ) skip
      130         'INDEX-FIELD "obj-type" ASCENDING' skip
      131         'INDEX-FIELD "obj-code" ASCENDING' skip " " skip .
      132   end.
      133     end.
      134   end procedure.
      135   procedure proc-host :
      136     do
      137     on error undo, return error return-value
      138     :
      139   empty temp-table temp-i.
      140   empty temp-table temp-t.
      141   for each _File no-lock :
      142      find first _Field no-lock of _File
      143           where _Field._Field-Name = 'host-code'
      144           no-error .
      145       if available _Field  then do:
      146          create temp-t .
      147           assign
      148             temp-t.nametable = _File._File-Name
      149             temp-t.namefield = _Field._Field-Name
      150           .
      151             for each _Index of _File no-lock  :
      152               for each  _Index-Field no-lock of _Index  :
      153                   find first buf-_Field no-lock of _Index-field no-error .
      154                       if available buf-_Field then do:
      155                           if buf-_Field._Field-Name = 'host-code' then do:
      156                               create temp-i .
      157                                 assign
      158                                   temp-i.nametable = _File._File-Name
      159                                   temp-i.namefield = _Field._Field-Name
      160                                   temp-i.nameindex = _index._index-name
      161                                 .
      162                               leave.
      163                           end.
      164                           else do:
      165                               leave.
      166                           end.
      167                       end.
      168               end.
      169             end.
      170      end.
      171      end.
      172   for each temp-t where
      173            not can-find ( first temp-i where temp-i.nametable = temp-t.nametable ) :
      174       put stream outstrim unformatted
      175          substitute('ADD INDEX &2auto_host&2 ON &2&1&2' , temp-t.nametable , chr(34)) skip
      176          substitute('AREA &1Schema Area&1' , chr(34) ) skip
      177         'INDEX-FIELD "host-code" ASCENDING' skip " " skip .
      178   end.
      179     end.
      180   end procedure.
      181   procedure proc-host-other :
      182     do
      183     on error undo, return error return-value
      184     :
      185   empty temp-table temp-i.
      186   empty temp-table temp-t.
      187   for each _File no-lock ,
      188      first _Field no-lock of _File
      189           where _Field._Field-Name <> 'host-code'
      190           and  index(_Field._Field-Name , 'host-code') > 0
      191      :
      192          create temp-t .
      193           assign
      194             temp-t.nametable = _File._File-Name
      195             temp-t.namefield = _Field._Field-Name
      196           .
      197             for each _Index of _File no-lock  :
      198               for each  _Index-Field no-lock of _Index  :
      199                   find first buf-_Field no-lock where
      200                              buf-_Field._Field-Name = _Field._Field-Name
      201                   of _Index-field no-error .
      202                       if available buf-_Field then do:
      203                           if buf-_Field._Field-Name <> 'host-code' and
      204                              index (buf-_Field._Field-Name, 'host-code' ) > 0
      205                           then do:
      206                               create temp-i .
      207                                 assign
      208                                   temp-i.nametable = _File._File-Name
      209                                   temp-i.namefield =  buf-_Field._Field-Name
      210                                   temp-i.nameindex = _index._index-name
      211                                 .
      212                               leave.
      213                           end.
      214                           else do:
      215                               leave.
      216                           end.
      217                       end.
      218               end.
      219             end.
      220      end.
      221     for each temp-t where
      222             not can-find ( first temp-i where
      223                 temp-i.nametable = temp-t.nametable and
      224                 temp-i.namefield = temp-t.namefield )
      225                 :
      226         put stream outstrim unformatted
      227           substitute('ADD INDEX &2auto_host_oth&2 ON &2&1&2' , temp-t.nametable , chr(34)) skip
      228           substitute('AREA &1Schema Area&1' , chr(34) ) skip
      229           substitute('INDEX-FIELD &2&1&2 ASCENDING ' ,temp-t.namefield, chr(34) )  skip " " skip .
      230     end.
      231   end.
      232   end procedure.
      233   procedure proc-obj-other :
      234     do
      235     on error undo, return error return-value
      236     :
      237   empty temp-table temp-i.
      238   empty temp-table temp-t.
      239   define buffer buf2_Field for ub._Field  .
      240   define variable v-pole1 as character no-undo .
      241   define variable v-pole2 as character no-undo .
      242   for each _File no-lock ,
      243      first _Field no-lock of _File
      244           where _Field._Field-Name <> 'obj-type'
      245           and  index(_Field._Field-Name , 'obj-type') > 0
      246      :
      247         v-pole1 = _Field._Field-Name .
      248         v-pole2 = REPLACE ( v-pole1 ,'obj-type' ,'obj-code') .
      249          find first buf2_Field where buf2_Field._Field-Name = v-pole2
      250                     of _File no-error .
      251             if available  buf2_Field then do:
      252               message  v-pole1  v-pole2 view-as alert-box .
      253               next.
      254           end.
      255          create temp-t .
      256           assign
      257             temp-t.nametable = _File._File-Name
      258             temp-t.namefield = _Field._Field-Name
      259             temp-t.namefield2 = v-pole2
      260           .
      261             for each _Index of _File no-lock  :
      262               for each  _Index-Field no-lock of _Index  :
      263                   find first buf-_Field no-lock where
      264                              buf-_Field._Field-Name = _Field._Field-Name
      265                   of _Index-field no-error .
      266                       if available buf-_Field then do:
      267                           if buf-_Field._Field-Name <> 'obj-type' and
      268                              index (buf-_Field._Field-Name, 'obj-type' ) > 0
      269                           then do:
      270                               create temp-i .
      271                                 assign
      272                                   temp-i.nametable = _File._File-Name
      273                                   temp-i.namefield =  buf-_Field._Field-Name
      274                                   temp-i.nameindex = _index._index-name
      275                                 .
      276                               leave.
      277                           end.
      278                           else do:
      279                               leave.
      280                           end.
      281                       end.
      282               end.
      283             end.
      284      end.
      285     for each temp-t where
      286             not can-find ( first temp-i where
      287                 temp-i.nametable = temp-t.nametable and
      288                 temp-i.namefield = temp-t.namefield )
      289                 :
      290         put stream outstrim unformatted
      291           substitute('ADD INDEX &2auto_obj_oth&2 ON &2&1&2' , temp-t.nametable , chr(34)) skip
      292           substitute('AREA &1Schema Area&1' , chr(34) ) skip
      293           substitute('INDEX-FIELD &2&1&2 ASCENDING ' ,temp-t.namefield, chr(34) )  skip
      294           substitute('INDEX-FIELD &2&1&2 ASCENDING ' ,temp-t.namefield2, chr(34) )  skip " " skip .
      295     end.
      296   end.
      297   end procedure.
      298   procedure proc-cli :
      299     do
      300     on error undo, return error return-value
      301     :
      302   empty temp-table temp-i.
      303   empty temp-table temp-t.
      304   define buffer buf1_Field for ub._Field  .
      305   for each _File no-lock :
      306      find first _Field no-lock of _File
      307           where _Field._Field-Name = 'cli-type'
      308           no-error .
      309      find first buf1_Field no-lock of _File
      310           where buf1_Field._Field-Name = 'cli-code'
      311           no-error .
      312       if available _Field and available  buf1_Field then do:
      313          create temp-t .
      314           assign
      315             temp-t.nametable = _File._File-Name
      316             temp-t.namefield = _Field._Field-Name
      317           .
      318             for each _index no-lock of _file  :
      319               for each  _index-field no-lock of _index  :
      320                   find first buf-_field no-lock of _index-field no-error .
      321                   if buf-_Field._Field-Name = 'cli-type' then do:
      322                       create temp-i .
      323                         assign
      324                           temp-i.nametable = _File._File-Name
      325                           temp-i.namefield = _Field._Field-Name
      326                           temp-i.nameindex = _index._index-name
      327                         .
      328                       leave.
      329                   end.
      330                   else do:
      331                       leave.
      332                   end.
      333               end.
      334             end.
      335      end.
      336      end.
      337   for each temp-t where
      338            not can-find ( first temp-i where temp-i.nametable = temp-t.nametable ) :
      339       put stream outstrim unformatted
      340         substitute('ADD INDEX &2auto_cli&2 ON &2&1&2' , temp-t.nametable , chr(34)) skip
      341         substitute('AREA &1Schema Area&1' , chr(34) ) skip
      342         'INDEX-FIELD "cli-type" ASCENDING' skip
      343         'INDEX-FIELD "cli-code" ASCENDING' skip " " skip .
      344   end.
      345     end.
      346   end procedure.
