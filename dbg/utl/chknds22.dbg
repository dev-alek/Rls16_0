        1   define output parameter oRun as logical no-undo.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define buffer buf_code for ub.code.
        7   define buffer buf_sys-ctrl for ub.sys-ctrl.
        8   find first buf_sys-ctrl no-lock.
        9   if buf_sys-ctrl.db-num = 0 then
       10   do:
       11     oRun = no.
       12   end.
       13   else
       14   do:
       15     oRun = not can-find(first buf_code where
       16                               buf_code.parent = substitute("RunUtils&1&2",chr(4), buf_sys-ctrl.db-num)
       17                           and buf_code.code = "nds22").
       18   end.
