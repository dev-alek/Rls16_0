        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER file-name as char.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: ucvespbc.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/ucvespbc.p $":U .
        8   define variable vss-description as character no-undo init "Утилита закачки дисконтных карт и клиентов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define variable v-waitfram-action01         as character   no-undo .
       80   define variable v-waitfram-action02         as character   no-undo .
       81   define variable v-waitfram-action03         as character   no-undo .
       82   define variable mWaitFramTextBeg            as character   no-undo.
       83   define variable mWaitFramTextEnd            as character   no-undo.
       84   define variable mWaitFramView               as logical     no-undo.
       85   define variable mWaitProcEvent              as logical     no-undo init yes.
       86   define variable mWaitFramInterval           as integer     no-undo init 1 .
       87   define variable mWaitFramStop               as logical     no-undo.
       88   define variable mWaitFramStopUser           as logical     no-undo.
       89   define variable mWaitFramStopTimeOut        as logical     no-undo.
       90   define variable mWaitFramStartProc          as datetime-tz no-undo.
       91   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       92   define button B-WaitFramStop auto-end-key
       93        label "Стоп"
       94        size 10 by 1 tooltip "Остоновить процесс".
       95   define button B-viewProcInfo
       96        label "Информация"
       97        size 15 by 1 tooltip "Информация о процесс".
       98   define frame waitfram
       99     v-waitfram-action01 format "x(72)" no-label skip
      100     v-waitfram-action02 format "x(72)" no-label skip
      101     v-waitfram-action03 format "x(72)" no-label skip
      102     B-viewProcInfo
      103     B-WaitFramStop at row 4 col 30
      104     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      105     .
      106   define new global shared variable mBatchMode as logical no-undo init ?.
      107   define variable mFramBachModHandle as handle no-undo.
      108   mFramBachModHandle = frame waitfram:handle.
      109   define variable mFameOldVis as logical no-undo.
      110   define variable mVisCUrentVin as logical no-undo.
      111   if session:batch-mode
      112   then
      113      mBatchMode = yes.
      114   if mBatchMode = ? then do:
      115     mVisCUrentVin = current-window:visible.
      116     mFameOldVis = mFramBachModHandle:visible.
      117     mFramBachModHandle:visible  = yes.
      118     mBatchMode = mFramBachModHandle:visible ne yes.
      119     mFramBachModHandle:visible = mFameOldVis.
      120     current-window:visible = mVisCUrentVin.
      121   end.
      122    if  log-manager:logfile-name ne ?
      123     then DO:
      124         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      125         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      126         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      127     end.
      128   on choose of B-WaitFramStop in frame waitfram
      129   do:
      130     mWaitFramStop = yes.
      131     mWaitFramStopUser = yes.
      132   end.
      133   function waitfram-check-timeout returns logical():
      134      define variable vtime as int64 no-undo.
      135      if mWaitFramStopTimeOut
      136      then
      137         return yes.
      138      vtime = ( now - mWaitFramStartProc ) / 1000 .
      139      if     mWaitFramTimeOut ne ?
      140         and mWaitFramTimeOut ne 0
      141         and mWaitFramTimeOut lt vtime
      142      then do:
      143         mWaitFramStopTimeOut = yes.
      144      end.
      145      return mWaitFramStopTimeOut.
      146   end.
      147   procedure waitfram-hide :
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       pause 0 before-hide .
      153       if not mBatchMode then
      154         hide frame waitfram .
      155     if     not mWaitFramView
      156        and mWaitProcEvent
      157     then
      158       process events .
      159     end.
      160   end procedure.
      161   procedure waitfram-show :
      162     define input  parameter p-message as character no-undo .
      163     define variable v-left-margin as integer   no-undo .
      164     if not session:batch-mode
      165     then do
      166     on error undo, return error return-value
      167     :
      168       if length(p-message) <= 70 then do:
      169         assign
      170           v-left-margin = integer((70 - length(p-message)) / 2)
      171         .
      172         assign
      173           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      174         .
      175         assign
      176           v-waitfram-action01 = " "
      177           v-waitfram-action02 = " "
      178                                    + fill(" ", v-left-margin)
      179                                    + p-message
      180           v-waitfram-action03 = " "
      181         .
      182       end.
      183       else do:
      184         define variable vRindex1 as integer no-undo.
      185         define variable vRindex2 as integer no-undo.
      186         vRindex1 = r-index(p-message," ",70).
      187         if vRindex1 = 0
      188         then
      189            vRindex1 = 70.
      190         if length(p-message)  <= vRindex1 + 70 then do:
      191           assign
      192             v-waitfram-action01 = " "
      193             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      195           .
      196         end.
      197         else do:
      198           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      199           if vRindex2 <= vRindex1
      200           then
      201              vRindex2 = vRindex1 + 70.
      202           assign
      203             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      204             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      205             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      206           .
      207         end.
      208       end.
      209       B-viewProcInfo:visible   in frame waitfram = no.
      210       B-viewProcInfo:sensitive in frame waitfram = no.
      211       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      212       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       if  (   mWaitFramView
      214          or  mWaitProcEvent)
      215          and not mBatchMode
      216       then
      217          display
      218             v-waitfram-action01 skip
      219             v-waitfram-action02 skip
      220             v-waitfram-action03 skip
      221          with frame waitfram .
      222       if     mWaitFramView
      223          then do:
      224             if     mWaitFramInterval ne ?
      225                and not mBatchMode
      226             then
      227                wait-for go of frame waitfram pause mWaitFramInterval.
      228          end.
      229          else
      230             if     mWaitProcEvent
      231                and not mBatchMode
      232             then
      233                process events .
      234     end.
      235   end procedure.
      236      procedure waitfram-show-this:
      237         define input  parameter iInterval as int64 no-undo.
      238         define variable vtime as int64 no-undo.
      239         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      240         mWaitFramInterval = iInterval.
      241         run waitfram-show (substitute("&1&2 &3&4" ,
      242                                       mWaitFramTextBeg ,
      243                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      244                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      245                                       mWaitFramTextEnd
      246                                      )
      247                           ).
      248      end.
      249      procedure WaitFramRunPause:
      250         define input  parameter iInterval as dec no-undo.
      251         define variable vStart  as datetime-tz no-undo.
      252         define variable vend    as datetime-tz no-undo.
      253         define variable vint as int64 no-undo.
      254         define variable vOk as logical no-undo.
      255         vStart = now.
      256         vend   = vStart.
      257         publish "WaitFramPause" (iInterval,output vOk).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and (   vint > 0
      263                 or (    not vOk
      264                     and iInterval eq ?
      265                     )
      266                 )
      267         then
      268            run waitfram-show-this (iInterval).
      269         vend   =  now.
      270         vint = vend - vStart.
      271         vint = iInterval - vint / 1000.
      272         if     not mWaitFramStop
      273            and vint > 0
      274         then do:
      275            run gbl/pause.p (vint * 1000).
      276         end.
      277         if iInterval ne ?
      278         then
      279            publish "WaitFramStop".
      280         waitfram-check-timeout().
      281      end.
      282      procedure WaitFramWaitFor:
      283         define input  parameter iInterval as dec no-undo.
      284         assign
      285            mWaitFramStartProc   = now
      286            mWaitFramStopUser    = no
      287            mWaitFramStopTimeOut = no
      288         .
      289         block-wait:
      290         do while not mWaitFramStop:
      291            run WaitFramRunPause (iInterval).
      292            if  waitfram-check-timeout()
      293            then do:
      294               leave block-wait.
      295            end.
      296         end.
      297         run waitfram-hide.
      298      end.
      299   procedure waitfram-join :
      300     define input  parameter p-line-1  as character no-undo .
      301     define input  parameter p-line-2  as character no-undo .
      302     define input  parameter p-line-3  as character no-undo .
      303     define output parameter p-message as character no-undo .
      304     do
      305     on error undo, return error return-value
      306     :
      307       assign
      308         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      309                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      311       .
      312     end.
      313   end procedure.
      314   function waitfram-join-function returns character
      315     (input p-line-1 as character
      316     ,input p-line-2 as character
      317     ,input p-line-3 as character
      318     ).
      319     define variable v-message as character no-undo .
      320     run waitfram-join in this-procedure
      321       (input  p-line-1
      322       ,input  p-line-2
      323       ,input  p-line-3
      324       ,output v-message
      325       ) .
      326     return v-message .
      327   end function .
      328   def stream InStream.
      329   def stream ErrStream.
      330   define variable my-artic like ub.goods.artic no-undo.
      331   define variable my-prod-code like ub.goods.prod-code no-undo.
      332   define variable my-prod-type like ub.goods.prod-type no-undo.
      333   define variable my-b-str like ub.prod-bc.b-str no-undo.
      334   define variable dopi as integer no-undo.
      335   define variable my-seek1 as integer.
      336   define variable my-seek2 as integer.
      337   define variable my-mess as char.
      338   define variable num-rec as integer.
      339   define variable num-rec-ok as integer.
      340   define variable ii as integer.
      341   define variable s as char format "X(300)".
      342   def buffer for-goods for ub.goods.
      343   define variable r-bar-code like ub.bar-code.b-code no-undo.
      344   input stream Instream from value(file-name).
      345   output stream Errstream to value(session:temp-directory + "\err.log").
      346   run waitfram-show in this-procedure ("Ждите...").
      347   _stroka:
      348   REPEAT:
      349       my-seek1 = seek(Instream).
      350       num-rec = num-rec + 1.
      351       import stream INstream
      352       my-artic
      353       my-b-str
      354       No-ERROR.
      355       my-seek2 = seek(Instream).
      356       IF ERROR-STATUS:ERROR then do:
      357           if num-rec = 1 then do:
      358           my-mess = "Строчка не разобрана!" + chr(10) +
      359                               "Требуемый формат строки(между полями пробелы - символьные поля закавычены):" + chr(10) +
      360                               "артикул" + chr(10) +
      361                               "тип производителя" + chr(10) +
      362                               "код проиводителя" + chr(10) +
      363                               "весовой код" + chr(10)
      364                               .
      365               DO ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
      366                   my-mess = my-mess + "ош " + string(ERROR-STATUS:GET-NUMBER(ii)) + " - " +
      367                                      ERROR-STATUS:GET-MESSAGE(ii).
      368               END.
      369               message my-mess view-as alert-box ERROR .
      370               run waitfram-hide in this-procedure .
      371               return.
      372           end.
      373           else do:
      374               my-mess = "Строчка не разобрана!"  .
      375               DO ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
      376                   my-mess = my-mess + "ош " + string(ERROR-STATUS:GET-NUMBER(ii)) + " - " +
      377                                      ERROR-STATUS:GET-MESSAGE(ii).
      378               END.
      379               run err-write (input-output my-mess).
      380           end.
      381           next _stroka.
      382       end.
      383       assign
      384       my-mess = ""
      385       .
      386       assign
      387       dopi = integer(my-b-str)
      388       no-error.
      389       if error-status:error or dopi > 99999 or dopi <= 0 then do:
      390           assign my-mess = "Нецифровой код "  + my-b-str  + " или неверный диапазон кодов " .
      391           run err-write(input-output my-mess).
      392           NEXT _stroka.
      393       end.
      394       if dopi > current-value (s-sclc-code, ub)
      395       or not can-find(first ub.code-range no-lock where
      396                            ub.code-range.range-type = 'sclc':U
      397                        and ub.code-range.db-num = 0
      398                        and ub.code-range.first-code <= dopi
      399                        and ub.code-range.last-code >= dopi)
      400       then do:
      401           assign my-mess = my-b-str + " - неверный диапазон кодов " .
      402           run err-write(input-output my-mess).
      403           NEXT _stroka.
      404       end.
      405       my-b-str = string(dopi, "99999").
      406       FIND FIRST ub.prod-bc No-LOCK where ub.prod-bc.b-str = my-b-str No-ERROR.
      407       if avail ub.prod-bc then do:
      408           assign my-mess = my-b-str + " - уже есть такой ДОПБК в системе " .
      409           run err-write(input-output my-mess).
      410           NEXT _stroka.
      411       end.
      412       FIND FIRST ub.goods no-lock where ub.goods.artic = my-artic  NO-ERROR.
      413       IF NOT AVAIL ub.goods then do:
      414           assign my-mess = "Нет товара с артикулом " + my-artic .
      415           run err-write(input-output my-mess).
      416           NEXT _stroka.
      417       end.
      418       if can-find(FIRST for-goods where for-goods.artic = my-artic AND
      419                                  NOT recid(for-goods)  = recid(ub.goods)) then do:
      420           assign my-mess = "В системе несколько товаров с артикулом " + my-artic .
      421           run err-write(input-output my-mess).
      422           NEXT _stroka.
      423       end.
      424       FIND FIRST ub.units No-LOCK WHERE ub.units.unit-name = ub.goods.unit-base No-ERROR.
      425       if not avail ub.units then do:
      426           assign my-mess = "Нет единицы измерения " + goods.unit-base.
      427           run err-write(input-output my-mess).
      428           NEXT _stroka.
      429       end.
      430       if LOOKUP('вес':U, ub.units.type) = 0 then do:
      431           assign my-mess = "Базовая единица измерения товара " + ub.goods.artic + " - невесовая".
      432           run err-write(input-output my-mess).
      433           NEXT _stroka.
      434       end.
      435       FIND FIRST prod-bc No-LOCK WHERE prod-bc.b-code = goods.gds-code NO-ERROR.
      436       IF AVAIL prod-bc then do:
      437           assign my-mess = "Уже есть весовой ДОПБК для товара " + goods.artic.
      438           run err-write(input-output my-mess).
      439           NEXT _stroka.
      440       end.
      441   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      442     (input  goods.gds-code
      443     ,input  ?
      444     ,output r-bar-code
      445     ) no-error .
      446       if error-status:error then do:
      447           if return-value = "" then
      448           assign my-mess = "Ошибка при поиске основного бар-кода для товара " + goods.artic.
      449           else
      450           assign my-mess = return-value.
      451           run err-write(input-output my-mess).
      452           NEXT _stroka.
      453       end.
      454       create prod-bc.
      455       assign
      456       prod-bc.b-code = r-bar-code
      457       prod-bc.bc-on = TRUE
      458       prod-bc.b-str = my-b-str
      459       prod-bc.bc-on-type = 'sclc':U
      460       no-error
      461       .
      462        num-rec-ok = num-rec-ok + 1.
      463        run waitfram-show in this-procedure ("Обработано " + string(num-rec) + " из них успешно " + string(num-rec-ok)).
      464   END.
      465   run waitfram-hide in this-procedure .
      466   input stream InStream close.
      467   output stream Errstream close.
      468   message "Из " num-rec "  записей  успешно закачано " num-rec-ok
      469                   view-as alert-box.
      470   return.
      471   PROCEDURE err-write:
      472       DEFINE INPUT-OUTPUT PARAMETER mess as char No-UNDO.
      473           seek STREAM Instream to my-seek1.
      474           import stream InStream unformatted
      475           s.
      476           put STREAM Errstream unformatted
      477           mess skip
      478           s
      479           skip.
      480           mess = "".
      481           seek STREAM Instream to my-seek2.
      482   END PROCEDURE.
