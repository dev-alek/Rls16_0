        1   block-level on error undo, throw.
        2   define stream inp.
        3   if search("./propath.txt") ne ?
        4   then do:
        5      input stream inp from value("./propath.txt").
        6      define variable vpropath as character no-undo.
        7      import stream inp unformatted vpropath  no-error.
        8      input stream inp close.
        9      if vpropath ne ""
       10      then
       11         propath = vpropath.
       12   end.
       13   run utl/proc-async.p.
