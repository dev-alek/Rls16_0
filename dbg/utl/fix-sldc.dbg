        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-read-only as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: fix-sldc.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/fix-sldc.p $":U .
        9   define variable vss-description as character no-undo init "Корректировка расхождения между полученными trn-doc/inkas и командой на расчет ДК по этим документам".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define new global shared variable g#trdcalib as handle no-undo.
       81   define variable conf-par as character no-undo .
       82   define variable par-type as character no-undo .
       83   define variable cre-pay as integer no-undo .
       84   define buffer buf_doc-attr for ub.doc-attr.
       85   define buffer buf_trn-doc for ub.trn-doc.
       86   define buffer buf_cash-pay for ub.cash-pay.
       87   define buffer buf_sysconf for ub.sysconf.
       88   define buffer locked_doc-attr for ub.doc-attr.
       89   if not (g#db-num > 0
       90   and not g#news) then do:
       91     return.
       92   end.
       93   main-block:
       94   for each buf_doc-attr no-lock where
       95           buf_doc-attr.attr-code = 'need-saledc':U
       96   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       97   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       98   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       99   :
      100     find first locked_doc-attr exclusive-lock where
      101               recid(locked_doc-attr) = recid(buf_doc-attr).
      102     if p-read-only then do:
      103       return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
      104                               ,vss-workfile
      105                               ,vss-revision
      106                               ,vss-description
      107                               ,chr(10)).
      108     end.
      109     find first buf_trn-doc exclusive-lock where
      110               buf_trn-doc.doc-code = locked_doc-attr.doc-code no-error.
      111     if not available buf_trn-doc then do:
      112       undo main-block, return error substitute("&1 &2&3Не найден документ &4 для атрибута <Требуется расчет данных по ДК>"
      113                                                , vss-workfile
      114                                                , vss-description
      115                                                , chr(10)
      116                                                , buf_trn-doc.doc-code).
      117     end.
      118     if buf_trn-doc.status_ <> 'факт':U then do:
      119       undo main-block, return error substitute("&1 &2&3Документ &4 для атрибута <Требуется расчет данных по ДК> находится в статусе  &5"
      120                                             , vss-workfile
      121                                             , vss-description
      122                                             , chr(10)
      123                                              , buf_trn-doc.doc-code
      124                                              , buf_trn-doc.status_
      125                                              ).
      126     end.
      127     case buf_trn-doc.ext-doc-type:
      128       when 'es':U then do:
      129         find first buf_sysconf where
      130                 buf_sysconf.host-code = buf_trn-doc.host-code no-lock.
      131         find first buf_Cash-pay no-lock where
      132                   buf_cash-pay.cdpay-code = buf_sysconf.credit-pay no-error.
      133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      134     (input  'iscredit'
      135     ,input  0
      136     ,input  ''
      137     ,input  0
      138     ,input  ''
      139     ,input  ''
      140     ,input  ''
      141     ,input  no
      142     ,output conf-par
      143     ,output par-type
      144     ) no-error .
      145         if error-status:error
      146         or not available buf_cash-pay
      147         or buf_cash-pay.is-credit = no
      148         or conf-par <> "yes"
      149         then do:
      150             assign
      151             cre-pay = 0
      152             .
      153         end.
      154         else do:
      155           assign
      156           cre-pay = buf_sysconf.credit-pay
      157           .
      158         end.
      159         run str/diallog.w ( input parparentproc
      160                     , input this-procedure
      161                     , input ('fix-sldc_diallog':U + chr(4) +
      162                             "1" + chr(4) +
      163                             "0" + chr(4) +
      164                             "1" + chr(4) +
      165                             "1" + chr(4) +
      166                             "yes")
      167                     , input ''
      168                     , input yes
      169                     , input 'Прервать'
      170                     , input substitute('Досчет ДК по недовыгруженной продаже &1 ', buf_trn-doc.doc-code)) no-error .
      171       end.
      172       otherwise do:
      173         if  (buf_trn-doc.ext-doc-type = 're':U OR
      174           buf_trn-doc.ext-doc-type = 'ee':U)
      175           and buf_trn-doc.d-card       <> ""
      176           and buf_trn-doc.d-card       <> ?
      177         then do:
      178           run str/saledc.p ( INPUT parparentproc
      179                       ,input ?
      180                       ,input ?
      181                       ,input 'trn-doc-close':U
      182                       ,input ?
      183                       ,input ""
      184                       ,input 0
      185                       ,input 0
      186                       ,input 0
      187                       ,INPUT g#db-num
      188                       ,INPUT buf_trn-doc.doc-code
      189                       ,input buf_trn-doc.doc-date
      190                       ,input buf_trn-doc.fact-date
      191                       ,input ?
      192                       ,input (if locked_doc-attr.attr-value = string(1)
      193                              then 1
      194                              else -1)
      195                       ,input (if buf_trn-doc.ext-doc-type = 're':U
      196                               then -1
      197                               else 1)
      198                       ,input yes
      199                       ) no-error .
      200         end.
      201       end.
      202     end case.
      203     if error-status :error
      204     then do:
      205       undo main-block, return error substitute("&1 &2&3Ошибка при проведении досчета ДК по недовыгруженной продаже/накладной &4.&3&5&3&6"
      206                                     , vss-workfile
      207                                     , vss-description
      208                                     , chr(10)
      209                                     , buf_trn-doc.doc-code
      210                                     , error-status:get-message(1)
      211                                     , return-value
      212                                     ).
      213     end.
      214     define variable v-deleted as logical no-undo .
      215   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-del in g#trdcalib (  input buf_trn-doc.doc-code ,
      216                           input 'need-saledc':U ,
      217                          output v-deleted ) no-error .
      218     if error-status:error then do:
      219       undo main-block, return error substitute("&1 &2&3Ошибка при удалении атрибута <Требуется расчет данных по ДК> после проведения досчета ДК по недовыгруженной продаже/накладной &4.&3&5&3&6"
      220                                     , vss-workfile
      221                                     , vss-description
      222                                     , chr(10)
      223                                     , buf_trn-doc.doc-code
      224                                     , error-status:get-message(1)
      225                                     , return-value
      226                                     ).
      227     end.
      228   end.
      229   procedure fix-sldc_diallog :
      230   define input parameter parparentproc as widget-handle no-undo .
      231   define input parameter p-parent-handle  as widget-handle no-undo .
      232   define input parameter p-log-handle  as handle no-undo .
      233   define input parameter p-parameter   as character no-undo .
      234   main-block:
      235   do
      236   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      237   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      238   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      239   :
      240       run str/saledc.p
      241         (
      242         input parparentproc
      243         ,input p-parent-handle
      244         ,input p-log-handle
      245         ,input 'sale-close':U
      246         ,input ?
      247         ,input ""
      248         ,input 0
      249         ,input 0
      250         ,input 0
      251         ,input g#db-num
      252         ,input buf_trn-doc.doc-code
      253         ,input buf_trn-doc.doc-date
      254         ,input buf_trn-doc.fact-date
      255         ,input cre-pay
      256         ,input (if locked_doc-attr.attr-value = string(1)
      257                 then 1
      258                 else -1 )
      259         ,input ?
      260         ,input yes
      261         ) no-error .
      262       if error-status:error then do:
      263         undo main-block, return error return-value .
      264       end.
      265   end.
      266   end procedure.
