     2761   procedure command_set_writebrand :
     2762   define input parameter p-d-card as character no-undo .
     2763   define input parameter p-hdoc   as handle no-undo .
     2764   define input parameter p-hroot  as handle no-undo .
     2765   define buffer buf_temp-nodes for temp-nodes.
     2766   define buffer buf_temp-ef for temp-ef.
     2767     do
     2768     on error undo, return error
     2769     :
     2770         find first buf_temp-ef where
     2771                   buf_temp-ef.d-card = p-d-card.
     2772         create buf_temp-nodes.
     2773         create x-noderef buf_temp-nodes.nhandle.
     2774         assign
     2775         buf_temp-nodes.nname = "WriteBrand".
     2776         p-hdoc:create-node(buf_temp-nodes.nhandle, "WriteBrand", "ELEMENT").
     2777         p-hroot:append-child(buf_temp-nodes.nhandle).
     2778         buf_temp-nodes.nhandle:set-attribute("token", p-d-card).
     2779         buf_temp-nodes.nhandle:set-attribute("format", string(buf_temp-ef.ef-format)).
     2780         buf_temp-nodes.nhandle:set-attribute("brand", buf_temp-ef.car-brand).
     2781     end.
     2782   end procedure.
     2783   procedure command_get_writebrand :
     2784   define input parameter p-d-card as character no-undo .
     2785   define input parameter p-hdoc   as handle no-undo .
     2786   define input parameter p-hnode  as handle no-undo .
     2787   define variable v-ii as integer no-undo .
     2788   define variable hattr as handle.
     2789   define variable htext as handle.
     2790   define variable v-error-mess as character no-undo .
     2791   define buffer buf_temp-nodes for temp-nodes.
     2792   define buffer buf2_temp-ef for vidtemp-ef.
     2793     do
     2794     on error undo, return error
     2795     :
