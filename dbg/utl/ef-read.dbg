     2916   procedure command_get_readlimit :
     2917   define input parameter p-d-card as character no-undo .
     2918   define input parameter p-hdoc   as handle no-undo .
     2919   define input parameter p-hnode  as handle no-undo .
     2920   define variable v-ii as integer no-undo .
     2921   define variable hattr as handle no-undo.
     2922   define variable htext as handle no-undo .
     2923   define variable v-hdoc as handle no-undo .
     2924   define variable helem as handle no-undo .
     2925   define variable v-error-mess as character no-undo .
     2926   define variable v-error-code as character no-undo .
     2927   define variable v-petrol-num as integer no-undo init ?.
     2928   define variable v-ef-petrol-code as integer no-undo .
     2929   define variable v-total as decimal no-undo .
     2930   define variable v-total-chr as character no-undo .
     2931   define variable v-month as decimal no-undo .
     2932   define variable v-month-chr as character no-undo .
     2933   define variable v-day as decimal no-undo .
     2934   define variable v-day-chr as character no-undo .
     2935   define variable v-doze as decimal no-undo .
     2936   define variable v-gds-code as integer no-undo .
     2937   define buffer buf_temp-nodes for temp-nodes.
     2938   define buffer buf2_temp-ef for vidtemp-ef .
     2939   define buffer buf2_temp-ef1 for vidtemp-ef1 .
     2940   define buffer buf_prop-ref for ub.prop-ref.
     2941     do
     2942     on error undo, return error
     2943     :
     2944       find first buf2_temp-ef .
     2945       create x-noderef hattr.
     2946       if P-hnode:get-attribute-node(hattr, "format") then do:
     2947         assign
     2948         buf2_temp-ef.ef-format = integer(hattr:node-value) no-error.
     2949       end.
     2950       create x-noderef htext.
     2951       do v-ii = 1 to p-hnode:num-children:
     2952         P-hnode:get-child(htext, v-ii).
     2953         if htext:subtype = "element"
     2954         and htext:name = "Limit" then do:
     2955           assign
     2956           v-ef-petrol-code = ?
     2957           v-total = ?
     2958           v-month = ?
     2959           v-day = ?
     2960           v-doze = ?
     2961           v-gds-code = ?
     2962           .
     2963           if htext:get-attribute-node(hattr, "n") then do:
     2964             v-petrol-num = integer(hattr:node-value) no-error.
     2965           end.
     2966           if htext:get-attribute-node(hattr, "product") then do:
     2967             v-ef-petrol-code = integer(hattr:node-value) no-error.
     2968           end.
     2969           if htext:get-attribute-node(hattr, "total") then do:
     2970             v-total-chr = hattr:node-value.
     2971             if v-total-chr = "unlimited" then do:
     2972               v-total = ?.
     2973             end.
     2974             else do:
     2975               v-total = decimal(hattr:node-value) no-error.
     2976             end.
     2977           end.
     2978           if htext:get-attribute-node(hattr, "month") then do:
     2979             v-month-chr = hattr:node-value.
     2980             if v-month-chr = "unlimited" then do:
     2981               v-month = ?.
     2982             end.
     2983             else do:
     2984               v-month = decimal(hattr:node-value) no-error.
     2985             end.
     2986           end.
     2987           if htext:get-attribute-node(hattr, "day") then do:
     2988             v-day-chr = hattr:node-value.
     2989             if v-day-chr = "unlimited" then do:
     2990               v-day = ?.
     2991             end.
     2992             else do:
     2993               v-day = decimal(hattr:node-value) no-error.
     2994             end.
     2995           end.
     2996           if htext:get-attribute-node(hattr, "doze") then do:
     2997             v-doze = decimal(hattr:node-value) no-error.
     2998           end.
     2999           if v-petrol-num <> ?
     3000           and v-petrol-num <=4
     3001           and v-petrol-num > 0
     3002           then do:
     3003              v-gds-code =  get-petrol-gds-code (v-ef-petrol-code) no-error.
     3004              assign
     3005              buffer buf2_temp-ef:handle:buffer-field( substitute( "petrol-code-&1", v-petrol-num)):buffer-value = v-gds-code.
     3006              if v-ef-petrol-code > 0 then do:
     3007               find first buf2_temp-ef1 where
     3008                           buf2_temp-ef1.d-card = p-d-card
     3009                     and buf2_temp-ef1.ef-petrol-code = v-ef-petrol-code no-error.
     3010               if not available buf2_temp-ef1 then do:
     3011                 find first buf_prop-ref no-lock where
     3012                           buf_prop-ref.dtm-code = 24
     3013                       and buf_prop-ref.sum-id = propreft-petrol-to-String(v-gds-code) no-error.
     3014                 create buf2_temp-ef1.
     3015                 assign
     3016                 buf2_temp-ef1.d-card = p-d-card
     3017                 buf2_temp-ef1.petrol-code = (if v-gds-code = ? then - v-ef-petrol-code else v-gds-code)
     3018                 buf2_temp-ef1.sum-id   = (if available buf_prop-ref then buf_prop-ref.sum-id else "")
     3019                 buf2_temp-ef1.dt-code  = (if available buf_prop-ref then buf_prop-ref.dt-code else  - v-gds-code)
     3020                 buf2_temp-ef1.dtm-code  = 24
     3021                 buf2_temp-ef1.ef-petrol-code  = v-ef-petrol-code
     3022                 .
     3023               end.
     3024               assign
     3025               buf2_temp-ef1.common-limit  = v-total
     3026               buf2_temp-ef1.month-limit  = v-month
     3027               buf2_temp-ef1.day-limit  = v-day
     3028               buf2_temp-ef1.standard-dose = v-doze
     3029               buf2_temp-ef1.petrol-num  = v-petrol-num
     3030               .
     3031             end.
     3032           end.
     3033         end.
     3034       end.
     3035       if P-hnode:get-attribute-node(hattr, "error") then do:
     3036         assign
     3037         v-error-code = hattr:node-value no-error.
     3038         create x-noderef htext.
     3039         repeat v-ii = 1 to P-hnode:num-children:
     3040           P-hnode:get-child(htext, v-ii).
     3041           if htext:subtype = "text" then do:
     3042             v-error-mess = htext:node-value.
     3043             leave.
     3044           end.
     3045         end.
     3046       end.
     3047       delete object hattr.
     3048       delete object htext.
     3049       if v-error-code = "99"
     3050       or v-error-code = ""
     3051       or v-error-code = ?
     3052       then return "".
     3053       return v-error-mess.
     3054     end.
     3055   end procedure.
     3056   procedure command_set_writecons :
     3057   define input parameter p-d-card as character no-undo .
     3058   define input parameter p-hdoc   as handle no-undo .
     3059   define input parameter p-hroot  as handle no-undo .
     3060   define variable v-ii as integer no-undo .
     3061   define variable v-wl-handle as handle no-undo .
     3062   define buffer buf_temp-nodes for temp-nodes.
     3063   define buffer buf_temp-ef1 for temp-ef1.
     3064   define buffer buf_temp-ef for temp-ef.
     3065   do
     3066   on error undo, return error
     3067   :
     3068     find first buf_temp-ef where
     3069               buf_temp-ef.d-card = p-d-card.
     3070     create buf_temp-nodes.
     3071     create x-noderef buf_temp-nodes.nhandle.
     3072     assign
     3073     buf_temp-nodes.nname = "WriteCons".
     3074     p-hdoc:create-node(buf_temp-nodes.nhandle, "WriteCons", "ELEMENT").
     3075     p-hroot:append-child(buf_temp-nodes.nhandle).
     3076     buf_temp-nodes.nhandle:set-attribute("token", p-d-card).
     3077     buf_temp-nodes.nhandle:set-attribute("format", string(buf_temp-ef.ef-format)).
     3078     v-wl-handle = buf_temp-nodes.nhandle.
     3079     do v-ii = 1 to 4:
     3080       find first buf_temp-ef1 where
     3081                 buf_temp-ef1.d-card = p-d-card
     3082               and buf_temp-ef1.petrol-num = v-ii no-error.
     3083       create buf_temp-nodes.
     3084       create x-noderef buf_temp-nodes.nhandle.
     3085       p-hdoc:create-node(buf_temp-nodes.nhandle, "Consumption", "ELEMENT").
     3086       v-wl-handle:append-child(buf_temp-nodes.nhandle).
     3087       buf_temp-nodes.nhandle:set-attribute("n", string(v-ii)).
     3088       if available buf_temp-ef1 then do:
     3089         buf_temp-nodes.nhandle:set-attribute("total", string(buf_temp-ef1.common-expense)).
     3090         buf_temp-nodes.nhandle:set-attribute("month", string(buf_temp-ef1.month-expense)).
     3091         buf_temp-nodes.nhandle:set-attribute("day", string(buf_temp-ef1.day-expense)).
     3092         buf_temp-nodes.nhandle:set-attribute("date", string((if buf_temp-ef1.last-date = ?
     3093                                                             then buf_temp-ef.valid-from
     3094                                                             else buf_temp-ef1.last-date), "99.99.9999")).
     3095       end.
     3096       else do:
     3097         buf_temp-nodes.nhandle:set-attribute("total", string(0)).
     3098         buf_temp-nodes.nhandle:set-attribute("month", string(0)).
     3099         buf_temp-nodes.nhandle:set-attribute("day", string(0)).
     3100         buf_temp-nodes.nhandle:set-attribute("date", string(buf_temp-ef.valid-from, "99.99.9999")).
     3101       end.
     3102     end.
     3103   end.
     3104   end procedure.
