     1698   FUNCTION get-ef-petrol-code RETURNS INTEGER
     1699     ( INPUT p-b-code AS INTEGER ) :
     1700   DEFINE VARIABLE v-ef-petrol-code AS INTEGER NO-UNDO.
     1701   define variable v-key-rec as character no-undo .
     1702   DEFINE buffer buf_goods FOR ub.goods.
     1703   DEFINE buffer buf_ext-classif FOR ub.ext-classif.
     1704   FIND FIRST buf_goods NO-LOCK WHERE
     1705           buf_goods.gds-code = p-b-code .
     1706   run gen-key-rec in THIS-PROCEDURE ( INPUT 'goods':U
     1707                                     ,INPUT (buffer buf_goods:HANDLE)
     1708                                       ,OUTPUT v-key-rec).
     1709    FIND FIRST buf_ext-classif NO-LOCK WHERE
     1710               buf_Ext-classif.classif-subject = 'goods':U
     1711            AND buf_Ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U
     1712         AND buf_ext-classif.uniq-key-rec = v-key-rec NO-ERROR.
     1713    IF AVAILABLE buf_ext-classif THEN DO:
     1714      ASSIGN
     1715      v-ef-petrol-code = buf_ext-classif.key#_one.
     1716    END.
     1717    RETURN v-ef-petrol-code.
     1718   END FUNCTION.
     1719   FUNCTION get-petrol-gds-code RETURNS INTEGER
     1720     ( INPUT p-ef-petrol-code AS INTEGER ) :
     1721   define variable v-tbl-row as rowid no-undo .
     1722   define variable v-tbl-name as character no-undo .
     1723   define variable v-key-rec as character no-undo .
     1724   DEFINE buffer buf_goods FOR ub.goods.
     1725   DEFINE buffer buf_ext-classif FOR ub.ext-classif.
     1726    FIND FIRST buf_ext-classif NO-LOCK WHERE
     1727               buf_Ext-classif.classif-subject = 'goods':U
     1728            AND buf_Ext-classif.classif-name = 'exp-easyfuel-talon-gds-code':U
     1729         AND buf_ext-classif.key#_one = p-ef-petrol-code NO-ERROR.
     1730    IF AVAILABLE buf_ext-classif THEN DO:
     1731      run gen-row-keyr in this-procedure (
     1732                                           input  buf_ext-classif.uniq-key-rec
     1733                                          ,input ?
     1734                                          ,input "ub"
     1735                                          ,input ?
     1736                                          ,input no-lock
     1737                                          ,output v-tbl-row
     1738                                          ,output v-tbl-name) no-error.
     1739      if not error-status:error then do:
     1740        find first buf_goods no-lock where
     1741                 rowid(buf_goods) = v-tbl-row.
     1742        return buf_goods.gds-code.
     1743      end.
     1744    END.
     1745    RETURN 0.
     1746   END FUNCTION.
     1747   procedure fill-main-table :
     1748   define input parameter p-d-card as character no-undo .
     1749   define parameter buffer buf_dis-card for ub.dis-card.
     1750   define buffer buf_temp-dis-card-property for temp-dis-card-property.
     1751   define buffer buf_temp-ef for temp-ef.
     1752   do
     1753   on error undo, return error
     1754   :
     1755     for each buf_temp-ef:
     1756       delete buf_temp-ef.
     1757     end.
     1758     create buf_temp-ef.
     1759     buf_temp-ef.ef-format = 1.
     1760     if available buf_dis-card then do:
     1761       buffer-copy buf_dis-card
     1762       except d-card
     1763       to buf_temp-ef
     1764       assign
     1765       buf_temp-ef.d-card = p-d-card
     1766       .
     1767     end.
     1768     else do:
     1769       assign
     1770       buf_temp-ef.d-card = p-d-card.
     1771     end.
     1772    FOR EACH temp-dis-card-property where
     1773          temp-dis-card-property.d-card = p-d-card
     1774       and temp-dis-card-property.dtm-code = 25
     1775       :
     1776      CASE temp-dis-card-property.node-code:
     1777        WHEN 1 THEN DO:
     1778          buf_temp-ef.car-reg-number = temp-dis-card-property.property-value-character.
     1779        END.
     1780        WHEN 2 THEN DO:
     1781           buf_temp-ef.car-brand = temp-dis-card-property.property-value-character.
     1782        END.
     1783        WHEN 3 THEN DO:
     1784          buf_temp-ef.ef-format = temp-dis-card-property.property-value-integer.
     1785          IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1786        END.
     1787        WHEN 4 THEN DO:
     1788          buf_temp-ef.access-key = temp-dis-card-property.property-value-character.
     1789        END.
     1790        WHEN 5 THEN DO:
     1791          buf_temp-ef.petrol-code-1 = temp-dis-card-property.property-value-integer.
     1792        END.
     1793        WHEN 6 THEN DO:
     1794          buf_temp-ef.petrol-code-2 = temp-dis-card-property.property-value-integer.
     1795        END.
     1796        WHEN 7 THEN DO:
     1797           buf_temp-ef.petrol-code-3 = temp-dis-card-property.property-value-integer.
     1798        END.
     1799        WHEN 8 THEN DO:
     1800          buf_temp-ef.petrol-code-4 = temp-dis-card-property.property-value-integer.
     1801        END.
     1802        WHEN 11 THEN DO:
     1803           buf_temp-ef.init-date-time = temp-dis-card-property.property-value-character.
     1804        END.
     1805        WHEN 12 THEN DO:
     1806           buf_temp-ef.init-operator = temp-dis-card-property.property-value-character.
     1807        END.
     1808        WHEN 13 THEN DO:
     1809           buf_temp-ef.issued-by = temp-dis-card-property.property-value-character.
     1810           buf_temp-ef.db-num = integer(entry(1, temp-dis-card-property.property-value-character, "-")).
     1811           buf_temp-ef.user-id = integer(entry(2, temp-dis-card-property.property-value-character, "-")).
     1812        END.
     1813      END CASE.
     1814    END.
     1815    RUN fill-tables IN THIS-PROCEDURE ( INPUT buf_temp-ef.ef-format, buffer buf_temp-ef) NO-ERROR.
     1816   end.
     1817   end procedure.
     1818   PROCEDURE fill-tables :
     1819   DEFINE INPUT PARAMETER p-ef-format AS INTEGER NO-UNDO.
     1820   define parameter buffer buf_temp-ef for temp-ef.
     1821   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     1822   DEFINE VARIABLE v-gds-code AS INTEGER NO-UNDO.
     1823   DEFINE BUFFER bufl_temp-dis-card-property FOR temp-dis-card-property.
     1824   DEFINE BUFFER buf_temp-dis-card-property FOR temp-dis-card-property.
     1825   CASE p-ef-format:
     1826     WHEN 1  THEN DO:
     1827       FOR EACH bufl_temp-dis-card-property NO-LOCK WHERE
     1828               bufl_temp-dis-card-property.d-card = buf_temp-ef.d-card
     1829            AND bufl_temp-dis-card-property.dtm-code = 24:
     1830         FIND FIRST temp-ef1 WHERE
     1831                   temp-ef1.d-card = buf_temp-ef.d-card
     1832               and temp-ef1.dt-code = bufl_temp-dis-card-property.dt-code NO-ERROR.
     1833         IF NOT AVAILABLE temp-ef1 THEN do:
     1834            CREATE temp-ef1.
     1835            ASSIGN
     1836            temp-ef1.d-card = buf_temp-ef.d-card
     1837            temp-ef1.sum-id = bufl_temp-dis-card-property.sum-id
     1838            temp-ef1.dt-code = bufl_temp-dis-card-property.dt-code
     1839            temp-ef1.dtm-code = bufl_temp-dis-card-property.dtm-code
     1840            .
     1841            v-gds-code = propreft-string-to-petrol( INPUT bufl_temp-dis-card-property.sum-id).
     1842            ASSIGN
     1843            temp-ef1.petrol-code  = v-gds-CODE
     1844            .
     1845            ASSIGN
     1846            temp-ef1.ef-petrol-code = get-ef-petrol-code ( temp-ef1.petrol-code)
     1847             .
     1848            DO v-ii = 1 TO 4:
     1849              IF temp-ef1.petrol-code = buffer buf_temp-ef:buffer-field( substitute("petrol-code-&1", v-ii)):buffer-value THEN DO:
     1850                temp-ef1.petrol-num = v-ii.
     1851              END.
     1852            END.
     1853         END.
     1854         CASE bufl_temp-dis-card-property.node-code:
     1855           WHEN 1 THEN DO:
     1856               ASSIGN
     1857               temp-ef1.month-limit = bufl_temp-dis-card-property.property-value-decimal
     1858               temp-ef1.unlim-month-limit = (temp-ef1.month-limit = ?)
     1859               .
     1860           END.
     1861           WHEN 2 THEN DO:
     1862               ASSIGN
     1863               temp-ef1.day-limit = bufl_temp-dis-card-property.property-value-decimal
     1864               temp-ef1.unlim-day-limit = (temp-ef1.day-limit = ?)
     1865               .
     1866           END.
     1867           WHEN 3 THEN DO:
     1868               ASSIGN
     1869               temp-ef1.standard-dose = bufl_temp-dis-card-property.property-value-decimal.
     1870           END.
     1871           WHEN 4 THEN DO:
     1872               ASSIGN
     1873               temp-ef1.common-limit = bufl_temp-dis-card-property.property-value-decimal
     1874               temp-ef1.unlim-common-limit = (temp-ef1.common-limit = ?)
     1875               .
     1876           END.
     1877         END CASE.
     1878      END.
     1879     END.
     1880     OTHERWISE DO:
     1881        MESSAGE
     1882        substitute("Формат данныx &1 для МБ в настоящий момент не поддерживается", p-ef-format)
     1883        VIEW-AS ALERT-BOX ERROR.
     1884        UNDO, RETURN ERROR.
     1885     END.
     1886   END CASE.
     1887   END PROCEDURE.
     1888   procedure fill-expenses :
     1889   DEFINE INPUT PARAMETER p-ef-format AS INTEGER NO-UNDO.
     1890   define parameter buffer buf_temp-ef for temp-ef.
     1891   define variable v-cd-petrol-code as character no-undo .
     1892   define buffer buf_cd-trans for ub.cd-trans.
     1893   define buffer bufe_cd-trans for ub.cd-trans.
     1894   define buffer buf_temp-ef1 for temp-ef1.
     1895   do
     1896   on error undo, return error
     1897   :
     1898     for each buf_temp-ef1 where
     1899           buf_temp-ef1.d-card = buf_temp-ef.d-card:
     1900       find last buf_cd-trans no-lock where
     1901               buf_cd-trans.trans-type  = integer('40':U)
     1902           and buf_cd-trans.charkey_one = buf_temp-ef.d-card
     1903           and buf_cd-trans.charkey_two = v-cd-petrol-code use-index ichkdate
     1904             no-error.
     1905       if available buf_cd-trans then do:
     1906         find first bufe_cd-trans no-lock where
     1907               bufe_cd-trans.trans-type  = integer('41':U)
     1908           and bufe_cd-trans.charkey_one = buf_temp-ef.d-card
     1909           and bufe_cd-trans.charkey_two = v-cd-petrol-code
     1910           and bufe_cd-trans.trans-id-chr = buf_cd-trans.trans-id-chr use-index ichkdate no-error .
     1911         if available bufe_cd-trans then do:
     1912           assign
     1913           buf_temp-ef1.common-expense = buf_cd-trans.deckey_one
     1914           buf_temp-ef1.month-expense = buf_cd-trans.deckey_two
     1915           buf_temp-ef1.day-expense = buf_cd-trans.deckey_three
     1916           buf_temp-ef1.last-date = buf_cd-trans.chk-date
     1917           .
     1918         end.
     1919         else do:
     1920           assign
     1921           buf_temp-ef1.last-date = string-to-date(buf_temp-ef.init-date-time)
     1922           .
     1923         end.
     1924       end.
     1925       else do:
     1926         assign
     1927         buf_temp-ef1.last-date = string-to-date(buf_temp-ef.init-date-time)
     1928         .
     1929       end.
     1930     end.
     1931   end.
     1932   end procedure.
