     2813   procedure command_set_writelimit :
     2814   define input parameter p-d-card as character no-undo .
     2815   define input parameter p-hdoc   as handle no-undo .
     2816   define input parameter p-hroot  as handle no-undo .
     2817   define variable v-ii as integer no-undo .
     2818   define variable v-wl-handle as handle no-undo .
     2819   define buffer buf_temp-nodes for temp-nodes.
     2820   define buffer buf_temp-ef1 for temp-ef1.
     2821   define buffer buf_temp-ef for temp-ef.
     2822   do
     2823   on error undo, return error
     2824   :
     2825     find first buf_temp-ef where
     2826               buf_temp-ef.d-card = p-d-card.
     2827     create buf_temp-nodes.
     2828     create x-noderef buf_temp-nodes.nhandle.
     2829     assign
     2830     buf_temp-nodes.nname = "WriteLimit".
     2831     p-hdoc:create-node(buf_temp-nodes.nhandle, "WriteLimit", "ELEMENT").
     2832     p-hroot:append-child(buf_temp-nodes.nhandle).
     2833     buf_temp-nodes.nhandle:set-attribute("token", p-d-card).
     2834     buf_temp-nodes.nhandle:set-attribute("format", string(buf_temp-ef.ef-format)).
     2835     v-wl-handle = buf_temp-nodes.nhandle.
     2836     do v-ii = 1 to 4:
     2837       find first buf_temp-ef1 where
     2838                 buf_temp-ef1.d-card = p-d-card
     2839               and buf_temp-ef1.petrol-num = v-ii no-error.
     2840       create buf_temp-nodes.
     2841       create x-noderef buf_temp-nodes.nhandle.
     2842       p-hdoc:create-node(buf_temp-nodes.nhandle, "Limit", "ELEMENT").
     2843       v-wl-handle:append-child(buf_temp-nodes.nhandle).
     2844       buf_temp-nodes.nhandle:set-attribute("n", string(v-ii)).
     2845       if available buf_temp-ef1 then do:
     2846         buf_temp-nodes.nhandle:set-attribute("product", string(buf_temp-ef1.ef-petrol-code)).
     2847         buf_temp-nodes.nhandle:set-attribute("total", (if buf_temp-ef1.unlim-common-limit
     2848                                                        then "unlimited"
     2849                                                        else string(buf_temp-ef1.common-limit))).
     2850         buf_temp-nodes.nhandle:set-attribute("month", (if buf_temp-ef1.unlim-month-limit
     2851                                                        then "unlimited"
     2852                                                        else string(buf_temp-ef1.month-limit))).
     2853         buf_temp-nodes.nhandle:set-attribute("day", (if buf_temp-ef1.unlim-day-limit
     2854                                                      then "unlimied"
     2855                                                      else string(buf_temp-ef1.day-limit))).
     2856         buf_temp-nodes.nhandle:set-attribute("doze", string(buf_temp-ef1.standard-dose)).
     2857       end.
     2858       else do:
     2859         buf_temp-nodes.nhandle:set-attribute("product", string(0)).
     2860         buf_temp-nodes.nhandle:set-attribute("total", string(0)).
     2861         buf_temp-nodes.nhandle:set-attribute("month", string(0)).
     2862         buf_temp-nodes.nhandle:set-attribute("day", string(0)).
     2863         buf_temp-nodes.nhandle:set-attribute("doze", string(0)).
     2864       end.
     2865     end.
     2866   end.
     2867   end procedure.
