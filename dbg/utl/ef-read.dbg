     2715   procedure command_get_readbrand :
     2716   define input parameter p-d-card as character no-undo .
     2717   define input parameter p-hdoc   as handle no-undo .
     2718   define input parameter p-hnode  as handle no-undo .
     2719   define variable v-ii as integer no-undo .
     2720   define variable hattr as handle.
     2721   define variable htext as handle.
     2722   define variable v-hdoc as handle.
     2723   define variable v-error-mess as character no-undo .
     2724   define variable v-error-code as character no-undo .
     2725   define buffer buf_temp-nodes for temp-nodes.
     2726   define buffer buf2_temp-ef for vidtemp-ef .
     2727     do
     2728     on error undo, return error
     2729     :
     2730       find first buf2_temp-ef .
