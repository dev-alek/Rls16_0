        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: ef-read.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/ef-read.p $":U .
       11   define variable vss-description as character no-undo init "Считывание всех данных с мобильного блока EasyFuel".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82     define variable v-cntxt-db-num        as integer   no-undo .
       83     define variable v-cntxt-userid        as character no-undo .
       84     define variable v-cntxt-level         as character no-undo .
       85     define variable v-cntxt-host-code-obj as integer   no-undo .
       86     define variable v-cntxt-obj-type      as character no-undo .
       87     define variable v-cntxt-obj-code      as integer   no-undo .
       88     define variable v-cntxt-db-num-obj    as integer   no-undo .
       89     define variable v-cntxt-is-admin      as logical   no-undo .
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91     run mainmenu_getcntxt in parparentproc
       92       (output v-cntxt-db-num
       93       ,output v-cntxt-userid
       94       ,output v-cntxt-level
       95       ,output v-cntxt-host-code-obj
       96       ,output v-cntxt-obj-type
       97       ,output v-cntxt-obj-code
       98       ,output v-cntxt-db-num-obj
       99       ,output v-cntxt-is-admin
      100       ) .
      101   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   DEFINE TEMP-TABLE temp-dis-card-property NO-UNDO LIKE ub.dis-card-property
      103   field rw-option as character
      104   field prop-label as character
      105   field node-label as character
      106   field data-type as character
      107   field range as integer
      108   INDEX attrc is
      109   UNIQUE PRIMARY
      110   prop-label
      111   node-label
      112   dt-code
      113   host-code
      114   obj-type
      115   obj-code
      116   INDEX attrcl is UNIQUE
      117   dt-code
      118   node-code
      119   host-code
      120   obj-type
      121   obj-code
      122   .
      123   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   procedure init-temp-dcp :
      125   define input parameter p-mode as character no-undo .
      126   define input parameter p-d-card as character no-undo .
      127   define input parameter p-dtm-code as integer no-undo .
      128   define input parameter p-sum-id as character no-undo .
      129   define input parameter p-dt-code as integer no-undo .
      130   define variable v-data-type as character no-undo .
      131   define variable v-format as character no-undo .
      132   define variable v-label as character no-undo .
      133   define variable v-property-value-character as character no-undo .
      134   define variable v-rw-option as character no-undo .
      135   define variable v-range as integer no-undo .
      136   define variable v-node-code-label as character no-undo .
      137   define variable v-entry as character no-undo .
      138   define variable ii as integer no-undo .
      139   define variable v-entry2 as character no-undo .
      140   define buffer buf_prop-head for ub.prop-head.
      141   define buffer buf_Dis-card-property for ub.dis-card-property.
      142   main-block:
      143   do
      144   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      145   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      146   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      147   :
      148     For each temp-dis-card-property where
      149             temp-dis-card-property.d-card = p-d-card
      150         and (p-dtm-code = 0 or temp-dis-card-property.dtm-code = p-dtm-code)
      151         and (p-dt-code = 0 or temp-dis-card-property.dt-code = p-dt-code):
      152       delete temp-dis-card-property.
      153     end.
      154     For each buf_dis-card-property no-lock where
      155             buf_dis-card-property.d-card = p-d-card
      156         and (p-dtm-code = 0 or buf_dis-card-property.dtm-code = p-dtm-code)
      157         and (p-dt-code = 0 or buf_dis-card-property.dt-code = p-dt-code)
      158     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      159     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      160     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      161     :
      162       find first buf_prop-head no-lock where
      163                 buf_prop-head.dtm-code = buf_dis-card-property.dtm-code no-error .
      164       run discprop-node-code (
      165                          input buf_dis-card-property.dtm-code
      166                         ,input buf_dis-card-property.node-code
      167                         ,output v-data-type
      168                         ,output v-format
      169                         ,output v-label
      170                         ,output v-range
      171                         ,output v-rw-option
      172                          ).
      173       create temp-dis-card-property.
      174       assign
      175       temp-dis-card-property.d-card     = buf_dis-card-property.d-card
      176       temp-dis-card-property.dt-code    = buf_dis-card-property.dt-code
      177       temp-dis-card-property.sum-id     = buf_dis-card-property.sum-id
      178       temp-dis-card-property.dtm-code   = buf_dis-card-property.dtm-code
      179       temp-dis-card-property.data-type  = v-data-type
      180       temp-dis-card-property.range      = v-range
      181       temp-dis-card-property.node-label = v-label
      182       temp-dis-card-property.prop-label = (if available buf_prop-head
      183                                            then buf_prop-head.prop-label
      184                                            else '':U)
      185       temp-dis-card-property.property-value-character = buf_dis-card-property.property-value-character
      186       temp-dis-card-property.property-value-date = buf_dis-card-property.property-value-date
      187       temp-dis-card-property.property-value-decimal = buf_dis-card-property.property-value-decimal
      188       temp-dis-card-property.property-value-integer = buf_dis-card-property.property-value-integer
      189       temp-dis-card-property.rw-option = v-rw-option
      190       temp-dis-card-property.node-code = buf_dis-card-property.node-code
      191       temp-dis-card-property.host-code = buf_dis-card-property.host-code
      192       temp-dis-card-property.obj-type = buf_dis-card-property.obj-type
      193       temp-dis-card-property.obj-code = buf_dis-card-property.obj-code
      194       .
      195     end.
      196   end.
      197   end procedure.
      198   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   procedure lock-dcp :
      200   define input parameter p-d-card as character no-undo .
      201   define parameter buffer locked_dis-card-property for ub.dis-card-property.
      202     do
      203     on error undo, return error
      204     on stop undo, return error
      205     on end-key undo, return error
      206     :
      207         Find first locked_dis-card-property exclusive-lock  where
      208                 locked_dis-card-property.d-card = p-d-card
      209             AND locked_dis-card-property.host-code = 0
      210             AND locked_dis-card-property.obj-type = '':U
      211             AND locked_dis-card-property.obj-code = 0
      212             and locked_dis-card-property.dt-code = 0
      213             and locked_dis-card-property.node-code = 0
      214             no-error no-wait.
      215         if not available locked_dis-card-property
      216         and not locked locked_dis-card-property then do:
      217           create locked_dis-card-property.
      218           assign
      219           locked_dis-card-property.host-code = 0
      220           locked_dis-card-property.obj-type =  '':U
      221           locked_dis-card-property.obj-code = 0
      222           locked_dis-card-property.d-card = p-d-card
      223           locked_dis-card-property.dtm-code = 0
      224           locked_dis-card-property.dt-code = 0
      225           locked_dis-card-property.node-code = 0
      226           .
      227         end.
      228         if locked locked_dis-card-property then do:
      229         Find first locked_dis-card-property exclusive-lock  where
      230                 locked_dis-card-property.d-card = p-d-card
      231             AND locked_dis-card-property.host-code = 0
      232             AND locked_dis-card-property.obj-type = '':U
      233             AND locked_dis-card-property.obj-code = 0
      234             and locked_dis-card-property.dt-code = 0
      235             and locked_dis-card-property.node-code = 0
      236             no-error .
      237         end.
      238     end.
      239   end procedure.
      240   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   define variable v-disprop-menu-section-num as integer no-undo .
      243   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      245   procedure gen-key-rec :
      246     define input  parameter p-tbl-name    as character no-undo.
      247     define input  parameter p-bh_tbl-name as handle    no-undo.
      248     define output parameter p-key-rec     as character no-undo.
      249     do
      250     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      251     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      252     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      253     :
      254       define variable fh               as handle    no-undo .
      255       define variable v-ok             as logical   no-undo .
      256       define variable v-inform         as character no-undo .
      257       define variable v-ind            as integer   no-undo .
      258       define variable v-idx-field-qnty as integer   no-undo .
      259       if p-tbl-name = ?
      260         or p-tbl-name = "":U
      261       then do:
      262         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
      263       end.
      264       if not p-bh_tbl-name:available then do:
      265         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
      266       end.
      267       assign
      268         p-key-rec = p-tbl-name
      269         v-inform  = p-bh_tbl-name:index-information(1)
      270         v-ind     = 2
      271       .
      272       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      273       on error undo, return error
      274       :
      275         assign
      276           v-inform = p-bh_tbl-name:index-information( v-ind )
      277           v-ind    = v-ind + 1
      278         .
      279       end.
      280       if v-inform = ?
      281         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      282         or entry( 3, v-inform, ",":U ) <> "1":U
      283       then do:
      284         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
      285       end.
      286       else do:
      287         assign
      288           v-idx-field-qnty = num-entries( v-inform ) - 4
      289         .
      290         if v-idx-field-qnty < 2 then do:
      291           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
      292         end.
      293         do v-ind = 1 to v-idx-field-qnty by 2
      294         on error undo, return error
      295         :
      296           assign
      297             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      298             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      299           .
      300         end.
      301       end.
      302       if p-key-rec = ? then do:
      303         assign
      304           p-key-rec = "":U
      305         .
      306         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
      307       end.
      308     end.
      309     return.
      310   end procedure.
      311   procedure gen-where-keyr-tab :
      312     define input  parameter i-tableSerach as character no-undo.
      313     define input  parameter i-tablekey   as character  no-undo.
      314     define input  parameter p-key-rec    as character  no-undo.
      315     define input  parameter p-key-handle as handle     no-undo .
      316     define input  parameter p-db-name    as character  no-undo .
      317     define input  parameter p-tt-handle  as handle     no-undo .
      318     define output parameter o-Where      as character  no-undo.
      319     do
      320     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      321     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      322     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      323     :
      324       define variable v-full-tbl-name  as character no-undo .
      325       define variable bh_tbl-name      as handle    no-undo .
      326       define variable fh_key           as handle    no-undo .
      327       define variable fh_search        as handle    no-undo .
      328       define variable v-field-num      as integer   no-undo .
      329       define variable v-count-fld      as integer   no-undo .
      330       define variable v-inform         as character no-undo .
      331       define variable v-ind            as integer   no-undo .
      332       define variable v-idx-field-qnty as integer   no-undo .
      333       define variable v-field-name     as character no-undo .
      334       define variable v-field-val      as character no-undo .
      335       define variable v-word-link      as character no-undo .
      336       define variable vTable           as character no-undo.
      337       define variable bh_tbl-key       as handle    no-undo .
      338       assign
      339         p-key-rec = trim( p-key-rec )
      340       .
      341       if p-key-handle <> ? then do:
      342         if not valid-handle(p-key-handle)
      343            or p-key-handle:type <> "buffer"
      344         then do:
      345           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
      346         end.
      347         if num-entries( p-key-rec, chr(3) ) > 1
      348           or p-key-rec = ?
      349           or p-key-rec = "":U
      350         then do:
      351           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
      352         end.
      353       end.
      354       else do:
      355         if p-key-rec = ?
      356           or p-key-rec = "":U
      357         then do:
      358           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
      359         end.
      360       end.
      361       assign
      362         vTable = entry( 1 , p-key-rec, chr(3) )
      363       .
      364       if p-tt-handle <> ?
      365         and ( not valid-handle(p-tt-handle)
      366               or p-tt-handle:type <> "buffer"
      367             )
      368       then do:
      369         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
      370       end.
      371       if p-tt-handle = ? then do:
      372         assign
      373           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      374         .
      375         create buffer bh_tbl-name for table v-full-tbl-name .
      376       end.
      377       else do:
      378         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      379       end.
      380       assign
      381         v-inform = bh_tbl-name:index-information(1)
      382         v-ind    = 2
      383       .
      384       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      385       on error undo, return error
      386       :
      387         assign
      388           v-inform = bh_tbl-name:index-information( v-ind )
      389           v-ind    = v-ind + 1
      390         .
      391       end.
      392       if v-inform = ?
      393         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      394         or entry( 3, v-inform, ",":U ) <> "1":U
      395       then do:
      396         delete object bh_tbl-name no-error.
      397         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
      398       end.
      399       assign
      400         v-idx-field-qnty = num-entries( v-inform ) - 4
      401       .
      402       if v-idx-field-qnty < 2 then do:
      403         delete object bh_tbl-name no-error.
      404         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
      405       end.
      406       assign
      407         o-where     = "where":U
      408         v-word-link = "":U
      409         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      410         v-count-fld = 0
      411       .
      412       if i-tablekey ne "" and i-tablekey ne ?
      413       then do:
      414         assign
      415           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      416         .
      417         create buffer bh_tbl-key for table v-full-tbl-name .
      418       end.
      419       if i-tableSerach ne "" and i-tableSerach ne ?
      420       then do:
      421         delete object bh_tbl-name no-error.
      422         assign
      423           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      424         .
      425         create buffer bh_tbl-name for table v-full-tbl-name .
      426       end.
      427       block_where:
      428       do v-ind = 1 to v-idx-field-qnty by 2
      429       on error undo, return error
      430       :
      431         assign
      432           v-count-fld = v-count-fld + 1
      433         .
      434         if p-key-handle = ?
      435           and v-count-fld > v-field-num
      436         then do:
      437           leave block_where.
      438         end.
      439         define variable VfieldKeyTable as handle no-undo.
      440         assign
      441           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      442           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      443         .
      444         if     bh_tbl-key ne ?
      445         then do:
      446            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      447            if VfieldKeyTable eq ?
      448            then next block_where.
      449         end.
      450         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      451         then
      452            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      453         else
      454            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      455         if p-key-handle = ? then do:
      456           assign
      457             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      458           .
      459         end.
      460         else do:
      461           assign
      462             fh_key = p-key-handle:buffer-field( v-field-name )
      463           .
      464           if fh_key = ?
      465             or not valid-handle( fh_key )
      466           then do:
      467             delete object bh_tbl-name.
      468             if     bh_tbl-key ne ?
      469             then
      470                delete object bh_tbl-key.
      471             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
      472           end.
      473           assign
      474             v-field-val = fh_key:buffer-value
      475           .
      476         end.
      477         if fh_search:data-type ="character":U then do:
      478           assign
      479             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      480             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      481             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      482             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      483             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      484             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      485             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      486             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      487             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      488             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      489             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      490             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      491             v-field-val = substitute( '"&1"', v-field-val )
      492           .
      493         end.
      494         assign
      495           o-where = substitute( "&1 &2", o-where, v-field-val )
      496         .
      497         if v-word-link = "":U then do:
      498           assign
      499             v-word-link = "and":U
      500           .
      501         end.
      502       end.
      503       delete object bh_tbl-name.
      504       if     bh_tbl-key ne ?
      505       then
      506          delete object bh_tbl-key.
      507       if p-key-handle = ?
      508         and v-count-fld <> v-field-num
      509       then do:
      510         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
      511       end.
      512     end.
      513   end procedure.
      514   procedure gen-hn-keyr-tab :
      515     define input  parameter i-tableSerach as character no-undo.
      516     define input  parameter i-tablekey   as character no-undo.
      517     define input  parameter p-key-rec    as character no-undo.
      518     define input  parameter p-key-handle as handle    no-undo .
      519     define input  parameter p-db-name    as character no-undo .
      520     define input  parameter p-tt-handle  as handle    no-undo .
      521     define input  parameter p-stts-lock  as integer   no-undo .
      522     define output parameter o-hn         as handle    no-undo.
      523     define variable v-full-tbl-name as character no-undo.
      524     define variable v-where         as character no-undo.
      525     define variable bh_tbl-name     as handle    no-undo.
      526     define variable vTable          as character no-undo.
      527     do
      528     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      529     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      530     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      531         run gen-where-keyr-tab(i-tableSerach,
      532                                i-tablekey,
      533                                p-key-rec,
      534                                p-key-handle,
      535                                p-db-name,
      536                                p-tt-handle,
      537                                output v-where).
      538         if i-tableSerach ne "" and i-tableSerach ne ?
      539         then do:
      540            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      541            create buffer bh_tbl-name for table v-full-tbl-name .
      542         end.
      543         else do:
      544            if p-tt-handle = ? then do:
      545               assign
      546                  vTable = entry( 1 , p-key-rec, chr(3) )
      547               .
      548               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      549               create buffer bh_tbl-name for table v-full-tbl-name .
      550            end.
      551            else do:
      552               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      553            end.
      554         end.
      555         if p-tt-handle = ? then do:
      556            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      557         end.
      558         else do:
      559            bh_tbl-name:find-first( v-where ) no-error .
      560         end.
      561         o-hn = bh_tbl-name.
      562      end.
      563   end procedure.
      564   procedure gen-hn-keyr :
      565     define input  parameter p-key-rec    as character no-undo.
      566     define input  parameter p-key-handle as handle    no-undo .
      567     define input  parameter p-db-name    as character no-undo .
      568     define input  parameter p-tt-handle  as handle    no-undo .
      569     define input  parameter p-stts-lock  as integer   no-undo .
      570     define output parameter o-hn         as handle    no-undo.
      571     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      572   end.
      573   procedure gen-row-keyr :
      574     define input  parameter p-key-rec    as character no-undo.
      575     define input  parameter p-key-handle as handle    no-undo .
      576     define input  parameter p-db-name    as character no-undo .
      577     define input  parameter p-tt-handle  as handle    no-undo .
      578     define input  parameter p-stts-lock  as integer   no-undo .
      579     define output parameter p-tbl-row    as rowid     no-undo.
      580     define output parameter p-tbl-name   as character no-undo.
      581     define variable vHn as handle no-undo.
      582       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      583       p-tbl-row = if vHn:available then vHn:rowid else ?.
      584       p-tbl-name =  vHn:table.
      585       delete object vHn no-error.
      586     if p-tbl-row = ? then do:
      587       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
      588     end.
      589     else do:
      590       return.
      591     end.
      592   end procedure.
      593   procedure gen-key-fv :
      594     define input  parameter p-key-rec    as character no-undo .
      595     define output parameter p-field-list as character no-undo .
      596     define output parameter p-value-list as character no-undo.
      597     do
      598     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      599     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      600     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      601     :
      602       define variable v-full-tbl-name  as character no-undo .
      603       define variable bh_tbl-name      as handle    no-undo .
      604       define variable v-tbl-name       as character no-undo .
      605       define variable v-field-num      as integer   no-undo .
      606       define variable v-count-fld      as integer   no-undo .
      607       define variable v-inform         as character no-undo .
      608       define variable v-ind            as integer   no-undo .
      609       define variable v-idx-field-qnty as integer   no-undo .
      610       define variable v-delim-key      as character no-undo .
      611       if p-key-rec = ?
      612         or p-key-rec = "":U
      613       then do:
      614         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
      615       end.
      616       assign
      617         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      618         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      619       .
      620       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      621       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
      622       assign
      623         v-inform = bh_tbl-name:index-information(1)
      624         v-ind    = 2
      625       .
      626       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      627       on error undo, return error
      628       :
      629         assign
      630           v-inform = bh_tbl-name:index-information( v-ind )
      631           v-ind    = v-ind + 1
      632         .
      633       end.
      634       if v-inform = ?
      635         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      636         or entry( 3, v-inform, ",":U ) <> "1":U
      637       then do:
      638         delete object bh_tbl-name no-error.
      639         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
      640       end.
      641       assign
      642         v-idx-field-qnty = num-entries( v-inform ) - 4
      643       .
      644       if v-idx-field-qnty < 2 then do:
      645         delete object bh_tbl-name no-error.
      646         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
      647       end.
      648       assign
      649         p-field-list = "":U
      650         p-value-list = "":U
      651         v-delim-key  = "":U
      652         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      653         v-count-fld  = 0
      654       .
      655       block_where:
      656       do v-ind = 1 to v-idx-field-qnty by 2
      657       on error undo, return error
      658       :
      659         assign
      660           v-count-fld = v-count-fld + 1
      661         .
      662         if v-count-fld > v-field-num then do:
      663           leave block_where.
      664         end.
      665         assign
      666           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      667           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      668         .
      669         if v-ind = 1 then do:
      670           assign
      671             v-delim-key = chr(3)
      672           .
      673         end.
      674       end.
      675       delete object bh_tbl-name.
      676       if v-count-fld <> v-field-num then do:
      677         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
      678       end.
      679     end.
      680   end procedure.
      681   procedure gen-key-field :
      682     define input  parameter p-table      as character no-undo .
      683     define output parameter p-field-list as character no-undo .
      684     do
      685     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      686     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      687     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      688     :
      689       define variable v-full-tbl-name  as character no-undo .
      690       define variable bh_tbl-name      as handle    no-undo .
      691       define variable v-tbl-name       as character no-undo .
      692       define variable v-field-num      as integer   no-undo .
      693       define variable v-count-fld      as integer   no-undo .
      694       define variable v-inform         as character no-undo .
      695       define variable v-ind            as integer   no-undo .
      696       define variable v-idx-field-qnty as integer   no-undo .
      697       define variable v-delim-key      as character no-undo .
      698       if p-table = ?
      699         or p-table = "":U
      700       then do:
      701         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
      702       end.
      703       assign
      704         v-tbl-name      = p-table
      705         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      706       .
      707       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      708       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
      709       assign
      710         v-inform = bh_tbl-name:index-information(1)
      711         v-ind    = 2
      712       .
      713       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      714       on error undo, return error
      715       :
      716         assign
      717           v-inform = bh_tbl-name:index-information( v-ind )
      718           v-ind    = v-ind + 1
      719         .
      720       end.
      721       if v-inform = ?
      722         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      723         or entry( 3, v-inform, ",":U ) <> "1":U
      724       then do:
      725         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
      726       end.
      727       assign
      728         v-idx-field-qnty = num-entries( v-inform ) - 4
      729       .
      730       if v-idx-field-qnty < 2 then do:
      731         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
      732       end.
      733       assign
      734         p-field-list = "":U
      735         v-delim-key  = "":U
      736         v-count-fld  = 0
      737       .
      738       block_where:
      739       do v-ind = 1 to v-idx-field-qnty by 2
      740       on error undo, return error
      741       :
      742         assign
      743           v-count-fld = v-count-fld + 1
      744         .
      745         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      746         if v-ind = 1 then do:
      747           assign
      748             v-delim-key = chr(3)
      749           .
      750         end.
      751       end.
      752       delete object bh_tbl-name.
      753     end.
      754   end procedure.
      755   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   define new global shared variable g#lib-nws as handle no-undo .
      757   procedure disproph_write-dis-card-property-proc  :
      758   define parameter buffer buf_dis-card-property for ub.dis-card-property .
      759   define parameter buffer buf_dis-card for ub.dis-card.
      760   define input parameter p-d-card      like ub.dis-card-property.d-card no-undo .
      761   define input parameter p-dt-code      like ub.dis-card-property.dt-code no-undo .
      762   define input parameter p-host-code   like ub.dis-card-property.host-code no-undo .
      763   define input parameter p-obj-type    like ub.dis-card-property.obj-type no-undo .
      764   define input parameter p-obj-code    like ub.dis-card-property.obj-code no-undo .
      765   define input parameter p-dtm-code    like ub.dis-card-property.dtm-code no-undo .
      766   define input parameter p-card-num    like ub.dis-card-property.card-num  no-undo .
      767   define input parameter p-main-card   like ub.dis-card-property.main-card  no-undo .
      768   define input parameter p-first-card  like ub.dis-card-property.first-card  no-undo .
      769   define input parameter p-first-main-card  like ub.dis-card-property.first-main-card  no-undo .
      770   define input parameter p-node-code   like ub.dis-card-property.node-code no-undo .
      771   define input parameter p-action      as integer no-undo .
      772   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      773   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      774   define input-output parameter p-chip-num as integer no-undo .
      775   define input-output parameter p-corr-date as date no-undo .
      776   define input-output parameter p-corr-time as integer no-undo .
      777   define variable v-date as date      no-undo.
      778   define variable v-time  as integer   no-undo.
      779   define variable v-uniq-key-rec as character no-undo .
      780   define variable v-send as integer no-undo .
      781   define buffer buf_c-dc-hist for ub.c-dc-hist.
      782   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
      783     main-block:
      784     do
      785     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      786     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      787     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      788     :
      789       if not available buf_dis-card-property and not p-action = integer('1':U) then do:
      790         message
      791           vss-workfile vss-revision vss-description skip
      792           "Ошибка задания входных параметров" skip
      793           "Не определена запись СВОЙСТВА ДК" skip
      794           view-as alert-box error .
      795         undo, return error .
      796       end.
      797     v-send = integer('0':U).
      798     if not p-action = integer('1':U) then do:
      799       if available buf_dis-card then do:
      800         if g#news then do:
      801   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      803     (input  g#db-num
      804     ,input  'dis-card-property':U
      805     ,input  0
      806     ,input  '':U
      807     ,input  0
      808     ,input  buf_dis-card.type
      809     ,input  '':U
      810     ,input  '':U
      811     ,input  buf_dis-card.emitent-host-code
      812     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
      813     ,input  0
      814     ,input  'nws-to-hist'
      815     ,output v-send
      816     ) no-error .
      817         end.
      818         else do:
      819   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      821     (input  g#db-num
      822     ,input  'dis-card-property':U
      823     ,input  0
      824     ,input  '':U
      825     ,input  0
      826     ,input  buf_dis-card.type
      827     ,input  '':U
      828     ,input  '':U
      829     ,input  buf_dis-card.emitent-host-code
      830     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
      831     ,input  0
      832     ,input  'hist-from-prim'
      833     ,output v-send
      834     ) no-error .
      835         end.
      836       end.
      837     end.
      838     if v-send >= 0 then do:
      839       run cur-time in this-procedure(output v-date, output v-time).
      840       if p-action = integer('1':U) then do:
      841         create buf_c-dis-card-property.
      842         assign
      843         buf_c-dis-card-property.d-card            = p-d-card
      844         buf_c-dis-card-property.card-num          = p-card-num
      845         buf_c-dis-card-property.host-code         = p-host-code
      846         buf_c-dis-card-property.obj-type          = p-obj-type
      847         buf_c-dis-card-property.obj-code          = p-obj-code
      848         buf_c-dis-card-property.dt-code           = p-dt-code
      849         buf_c-dis-card-property.node-code         = p-node-code
      850         buf_c-dis-card-property.dtm-code         = p-dtm-code
      851         buf_c-dis-card-property.main-card         = p-main-card
      852         buf_c-dis-card-property.first-main-card   = p-first-main-card
      853         buf_c-dis-card-property.first-card        = p-first-card
      854         buf_c-dis-card-property.chip-num          = (if p-chip-num = 0
      855                                                      then next-value (s-dc-chip, ub)
      856                                                      else p-chip-num)
      857         buf_c-dis-card-property.corr-time         = (if p-corr-time = ?
      858                                                      then v-time
      859                                                      else p-corr-time)
      860         buf_c-dis-card-property.corr-user-db-num  = g#db-num
      861         buf_c-dis-card-property.corr-user-name    = if g#news then (chr(4) +  'СПН':U) else g#userid
      862         buf_c-dis-card-property.corr-date         = (if p-corr-date = ?
      863                                                      then v-date
      864                                                      else p-corr-date)
      865         .
      866       end.
      867       else do:
      868         create buf_c-dis-card-property.
      869         buffer-copy buf_dis-card-property to buf_c-dis-card-property
      870         assign
      871         buf_c-dis-card-property.d-card             = buf_dis-card-property.d-card
      872         buf_c-dis-card-property.card-num           = buf_dis-card-property.card-num
      873         buf_c-dis-card-property.dt-code             = buf_dis-card-property.dt-code
      874         buf_c-dis-card-property.main-card          = buf_dis-card-property.main-card
      875         buf_c-dis-card-property.first-main-card    = buf_dis-card-property.first-main-card
      876         buf_c-dis-card-property.first-card         = buf_dis-card-property.first-card
      877         buf_c-dis-card-property.host-code          = buf_dis-card-property.host-code
      878         buf_c-dis-card-property.obj-type          = p-obj-type
      879         buf_c-dis-card-property.obj-code          = p-obj-code
      880         buf_c-dis-card-property.node-code         = p-node-code
      881         buf_c-dis-card-property.dtm-code         = p-dtm-code
      882         buf_c-dis-card-property.chip-num           = (if p-chip-num = 0
      883                                                       then next-value (s-dc-chip, ub)
      884                                                       else p-chip-num)
      885         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
      886                                                       then v-time
      887                                                       else p-corr-time)
      888         buf_c-dis-card-property.corr-user-db-num   = g#db-num
      889               buf_c-dis-card-property.corr-user-name    = (if g#news
      890                                                      then (chr(4) +  'СПН':U)
      891                                                      else (if g#esys
      892                                                            then (chr(4) +  'ВС':U)
      893                                                            else g#userid
      894                                                            )
      895                                                      )
      896         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
      897                                                       then v-date
      898                                                       else p-corr-date)
      899         .
      900         run gen-key-rec in this-procedure (
      901                                             input 'dis-card-property':U
      902                                           ,input buffer buf_dis-card-property:handle
      903                                           ,output v-uniq-key-rec).
      904       end.
      905       if p-chip-num = 0   then do:
      906         create buf_c-dc-hist.
      907         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
      908         assign
      909         buf_c-dc-hist.action =  p-action
      910         buf_c-dc-hist.subject = 'dis-card-property':U
      911         buf_c-dc-hist.is-news = g#news
      912         buf_c-dc-hist.source-type = p-source-type
      913         buf_c-dc-hist.source-ref = p-source-ref
      914         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
      915         .
      916       end.
      917       assign
      918       p-chip-num = buf_c-dis-card-property.chip-num
      919       p-corr-date = buf_c-dis-card-property.corr-date
      920       p-corr-time = buf_c-dis-card-property.corr-time
      921       .
      922       run disproph_send-nws in this-procedure (
      923                                                 buffer buf_c-dis-card-property
      924                                                ,buffer buf_c-dc-hist
      925                                                ,buffer buf_dis-card
      926                                                 ).
      927       end.
      928     end.
      929   end procedure.
      930   procedure disproph_send-nws :
      931   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
      932   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
      933   define parameter buffer buf_Dis-card for ub.dis-card.
      934   define variable v-dh-hn as integer no-undo .
      935   main-block:
      936   do
      937   on error undo, return error return-value
      938   :
      939     if g#news
      940     and g#db-num > 0
      941     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
      942     then return.
      943     if g#db-num = 0
      944     or (g#news
      945         and g#db-num > 0
      946         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
      947         )
      948     then do:
      949       if not available buf_dis-card then do:
      950         find first buf_dis-card no-lock where
      951                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
      952       end.
      953       if not available buf_dis-card then do:
      954         assign
      955         v-dh-hn = integer('0':U).
      956       end.
      957       else do:
      958   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      959   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      960     (input  g#db-num
      961     ,input  'dis-card-property':U
      962     ,input  0
      963     ,input  '':U
      964     ,input  0
      965     ,input  buf_dis-card.type
      966     ,input  '':U
      967     ,input  '':U
      968     ,input  buf_dis-card.emitent-host-code
      969     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
      970     ,input  0
      971     ,input  'hist-to-nws'
      972     ,output v-dh-hn
      973     ) no-error .
      974       end.
      975       if v-dh-hn >= 0 then do:
      976         run str/callnews.p (
      977           input 'c-dis-card-property':U
      978           ,input (buffer buf_c-dis-card-property:handle)
      979           ) no-error .
      980         if error-status:error then do:
      981           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      982         end.
      983         if available buf_c-dc-hist then do:
      984           run str/callnews.p (
      985             input 'c-dc-hist':U
      986             ,input (buffer buf_c-dc-hist:handle)
      987             ) no-error .
      988           if error-status:error then do:
      989             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      990           end.
      991         end.
      992       end.
      993     end.
      994   end.
      995   end procedure.
      996   procedure discprop-node-code :
      997   define input parameter p-dtm-code as integer no-undo .
      998   define input parameter p-node-code as integer no-undo .
      999   define output parameter p-data-type as character no-undo .
     1000   define output parameter p-format as character no-undo .
     1001   define output parameter p-label as character no-undo .
     1002   define output parameter p-range as integer no-undo .
     1003   define output parameter p-rw-option as character no-undo .
     1004   define buffer buf_prop-map for ub.prop-map.
     1005   define buffer buf_prop-head for ub.prop-head.
     1006   do
     1007   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1008   :
     1009   find first buf_prop-head no-lock where
     1010             buf_prop-head.dtm-code = p-dtm-code no-error .
     1011   if available buf_prop-head then do:
     1012     if p-node-code > 0 then do:
     1013       find first buf_prop-map no-lock where
     1014                 buf_prop-map.dtm-code = p-dtm-code
     1015             and buf_prop-map.node-code = p-node-code no-error .
     1016       if available buf_prop-map then do:
     1017         assign
     1018         p-data-type = buf_prop-map.node-value-type
     1019         p-format = buf_prop-map.node-format
     1020         p-label = buf_prop-map.node-label
     1021         p-rw-option = buf_prop-map.rw-option
     1022         .
     1023       end.
     1024     end.
     1025     if buf_prop-head.storage-place  = "":U
     1026     and buf_prop-head.storage-place-host  > "":U
     1027     and buf_prop-head.storage-place-obj  > "":U then do:
     1028       p-range =  12.
     1029     end.
     1030     if buf_prop-head.storage-place  > "":U
     1031     and buf_prop-head.storage-place-host  > "":U
     1032     and buf_prop-head.storage-place-obj  > "":U then do:
     1033       p-range =  3.
     1034     end.
     1035     if buf_prop-head.storage-place  > "":U
     1036     and buf_prop-head.storage-place-host  > "":U
     1037     and buf_prop-head.storage-place-obj  = "":U then do:
     1038       p-range =  2.
     1039     end.
     1040     if buf_prop-head.storage-place  = "":U
     1041     and buf_prop-head.storage-place-host  > "":U
     1042     and buf_prop-head.storage-place-obj  = "":U then do:
     1043       p-range =  1.
     1044     end.
     1045     if buf_prop-head.storage-place  > "":U
     1046     and buf_prop-head.storage-place-host  = "":U
     1047     and buf_prop-head.storage-place-obj  = "":U then do:
     1048       p-range =  0.
     1049     end.
     1050   end.
     1051   end.
     1052   end procedure.
     1053   procedure discprop-initial:
     1054   define input parameter p-dtm-code as integer no-undo .
     1055   define input parameter p-node-code as integer no-undo .
     1056   define output parameter p-init-value-character as character no-undo .
     1057   define output parameter p-init-value-date as date no-undo .
     1058   define output parameter p-init-value-decimal as decimal no-undo .
     1059   define output parameter p-init-value-integer as integer no-undo .
     1060   define output parameter p-init-value-logical as logical no-undo .
     1061   define buffer buf_prop-map for ub.prop-map.
     1062   find first buf_prop-map no-lock where
     1063             buf_prop-map.dtm-code = p-dtm-code
     1064         and buf_prop-map.node-code = p-node-code no-error.
     1065   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1066                                                               , p-node-code
     1067                                                               , p-dtm-code).
     1068   assign
     1069   p-init-value-character = buf_prop-map.init-value-character
     1070   p-init-value-date = buf_prop-map.init-value-date
     1071   p-init-value-decimal = buf_prop-map.init-value-decimal
     1072   p-init-value-integer = buf_prop-map.init-value-integer
     1073   p-init-value-logical = buf_prop-map.init-value-logical
     1074   .
     1075   end procedure.
     1076   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1077   define buffer buf_attr-prop for ub.attr-prop.
     1078   find first buf_attr-prop no-lock where
     1079             buf_attr-prop.table-name = 'dis-card-property':U
     1080         and buf_attr-prop.templ-rl-root = p-dtm-code
     1081         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1082         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1083   if not available buf_attr-prop
     1084   or logical(buf_attr-prop.property-value) = no then do:
     1085     return no.
     1086   end.
     1087   return yes.
     1088   end function.
     1089   procedure discprop-edit :
     1090   define input parameter p-dtm-code-node-name as character no-undo .
     1091   define output parameter p-edit-menu-section-num as integer no-undo .
     1092   define buffer buf_attr-prop for ub.attr-prop.
     1093   do
     1094   on error undo, return error return-value
     1095   :
     1096     find first buf_attr-prop no-lock where
     1097             buf_attr-prop.table-name = 'dis-card-property':U
     1098        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1099        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1100        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1101     if available buf_attr-prop then do:
     1102       assign
     1103       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1104     end.
     1105   end.
     1106   end procedure.
     1107   procedure discprop-node-name :
     1108   define input parameter p-dtm-code-node-name as character no-undo .
     1109   define output parameter p-tool-tip as character no-undo .
     1110   define output parameter p-node-label as character no-undo .
     1111   define buffer buf_prop-map for ub.prop-map.
     1112   define buffer buf_prop-head for ub.prop-head.
     1113   do
     1114   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1115   :
     1116     find first buf_prop-head no-lock where
     1117               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1118     assign
     1119     p-tool-tip   = if available buf_prop-head
     1120                    then buf_prop-head.prop-des
     1121                    else entry(1, p-dtm-code-node-name, chr(4) )
     1122     p-node-label = (if available buf_prop-head
     1123                     then buf_prop-head.prop-label
     1124                     else '':U)
     1125     .
     1126     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1127       find first buf_prop-map no-lock where
     1128                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1129           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1130       if available buf_prop-map then do:
     1131         assign
     1132         p-tool-tip   = buf_prop-map.node-description
     1133         p-node-label = (if available buf_prop-head
     1134                         then buf_prop-head.prop-label
     1135                         else '':U) + ":" + buf_prop-map.node-label
     1136         .
     1137       end.
     1138     end.
     1139   end.
     1140   end procedure.
     1141   procedure discprop-write :
     1142   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1143   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1144   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1145   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1146   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1147   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1148   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1149   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1150   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1151   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1152   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1153   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1154   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1155   define input parameter p-source-type     as character no-undo .
     1156   define input parameter p-source-ref      as character no-undo .
     1157   define input-output parameter p-chip-num as integer no-undo .
     1158   define input-output parameter p-corr-date as date no-undo .
     1159   define input-output parameter p-corr-time as integer no-undo .
     1160   do
     1161   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1162   :
     1163     define buffer buf_dis-card-property for ub.dis-card-property .
     1164     define buffer buf_dis-card for ub.dis-card.
     1165     define buffer buf_prop-ref for ub.prop-ref.
     1166     define variable v-data-type      as character no-undo .
     1167     define variable v-data-type-1    as character no-undo .
     1168     define variable v-format         as character no-undo .
     1169     define variable v-label          as character no-undo .
     1170     define variable v-range          as integer   no-undo .
     1171     define variable v-rw-option      as character no-undo .
     1172     run discprop-node-code in this-procedure
     1173       (
     1174        input  p-dtm-code
     1175       ,input  p-node-code
     1176       ,output v-data-type
     1177       ,output v-format
     1178       ,output v-label
     1179       ,output v-range
     1180       ,output v-rw-option
     1181       ) no-error .
     1182     if error-status :error then do:
     1183       undo, return error return-value .
     1184     end.
     1185     v-data-type-1 = entry(1, v-data-type).
     1186     if p-dt-code = ? then do:
     1187       find buf_prop-ref no-lock where
     1188           buf_prop-ref.dtm-code = p-dtm-code
     1189       and buf_prop-ref.sum-id = p-sum-id no-error.
     1190       if not available buf_prop-ref then do:
     1191         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1192                                       ,p-dtm-code
     1193                                       ,p-sum-id).
     1194       end.
     1195       assign
     1196       p-dt-code = buf_prop-ref.dt-code.
     1197     end.
     1198     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1199       undo, return error "Нельзя редактировать свойство в данной БД".
     1200     end.
     1201     run discprop-check in this-procedure (
     1202                                             input v-range
     1203                                           ,input p-d-card
     1204                                           ,input p-host-code
     1205                                           ,input p-obj-type
     1206                                           ,input p-obj-code
     1207                                           ,input p-dtm-code
     1208                                           ,input p-node-code
     1209                                           ,input p-dt-code
     1210                                         ) no-error .
     1211     if error-status:error then undo,  return error return-value .
     1212     find first buf_dis-card-property exclusive-lock
     1213       where buf_dis-card-property.d-card    = p-d-card
     1214         and buf_dis-card-property.host-code = p-host-code
     1215         and buf_dis-card-property.obj-type  = p-obj-type
     1216         and buf_dis-card-property.obj-code  = p-obj-code
     1217         and buf_dis-card-property.dt-code = p-dt-code
     1218         and buf_dis-card-property.node-code = p-node-code
     1219       no-error .
     1220       find first buf_dis-card no-lock where
     1221                   buf_dis-card.d-card = p-d-card.
     1222     if not available buf_dis-card-property then do:
     1223       create buf_dis-card-property .
     1224       assign
     1225         buf_dis-card-property.d-card    = p-d-card
     1226         buf_dis-card-property.host-code = p-host-code
     1227         buf_dis-card-property.obj-type  = p-obj-type
     1228         buf_dis-card-property.obj-code  = p-obj-code
     1229         buf_dis-card-property.dt-code = p-dt-code
     1230         buf_dis-card-property.node-code = p-node-code
     1231         buf_dis-card-property.dtm-code = p-dtm-code
     1232         buf_dis-card-property.sum-id   = p-sum-id
     1233         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1234         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1235         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1236         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1237       .
     1238     end.
     1239     else do:
     1240       if (v-data-type-1 = 'character':U
     1241       and buf_dis-card-property.property-value-character = p-value-character)
     1242       or  (v-data-type-1 = 'date':U
     1243           and buf_dis-card-property.property-value-date = p-value-date)
     1244       or  (v-data-type-1 = 'decimal':U
     1245           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1246       or  (v-data-type-1 = 'integer':U
     1247           and buf_dis-card-property.property-value-integer = p-value-integer)
     1248       or  (v-data-type-1 = 'logical':U
     1249           and buf_dis-card-property.property-value-logical = p-value-logical)
     1250       then return.
     1251     end.
     1252     run disproph_write-dis-card-property-proc  in this-procedure (
     1253             buffer buf_dis-card-property
     1254             ,buffer Buf_dis-card
     1255             ,input p-d-card
     1256             ,input p-dt-code
     1257             ,input p-host-code
     1258             ,input p-obj-type
     1259             ,input p-obj-code
     1260             ,input p-dtm-code
     1261             ,input buf_dis-card.card-num
     1262             ,input buf_dis-card.main-card
     1263             ,input buf_dis-card.first-card
     1264             ,input buf_dis-card.first-main-card
     1265             ,input p-node-code
     1266             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1267             ,input p-source-type
     1268             ,input p-source-ref
     1269             ,input-output p-chip-num
     1270             ,input-output p-corr-date
     1271             ,input-output p-corr-time
     1272             ).
     1273     assign
     1274     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1275                                                       then p-value-character
     1276                                                       else buf_dis-card-property.property-value-character)
     1277     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1278                                                       then p-value-date
     1279                                                       else buf_dis-card-property.property-value-date)
     1280     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1281                                                       then p-value-decimal
     1282                                                       else buf_dis-card-property.property-value-decimal)
     1283     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1284                                                       then p-value-integer
     1285                                                       else buf_dis-card-property.property-value-integer)
     1286     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1287                                                       then p-value-logical
     1288                                                       else buf_dis-card-property.property-value-logical)
     1289     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1290     .
     1291     release buf_dis-card-property no-error .
     1292     if error-status:error then do:
     1293       return error return-value .
     1294     end.
     1295   end.
     1296   end procedure.
     1297   procedure discprop-delete :
     1298   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1299   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1300   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1301   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1302   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1303   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1304   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1305   define input parameter p-source-type as character no-undo .
     1306   define input parameter p-source-ref as character no-undo .
     1307   define output parameter p-deleted  as logical no-undo.
     1308   define input-output parameter p-chip-num as integer no-undo .
     1309   define input-output parameter p-corr-date as date no-undo .
     1310   define input-output parameter p-corr-time as integer no-undo .
     1311   do
     1312   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1313   :
     1314   define buffer buf_dis-card-property for ub.dis-card-property .
     1315   define buffer buf_dis-card for ub.dis-card.
     1316   define variable v-data-type      as character no-undo .
     1317   define variable v-format         as character no-undo .
     1318   define variable v-label          as character no-undo .
     1319   define variable v-range          as integer   no-undo .
     1320   define variable v-rw-option      as character   no-undo .
     1321     run discprop-node-code in this-procedure
     1322       (input  p-dtm-code
     1323       ,input  p-node-code
     1324       ,output v-data-type
     1325       ,output v-format
     1326       ,output v-label
     1327       ,output v-range
     1328       ,output v-rw-option
     1329       ) no-error .
     1330     if error-status :error then do:
     1331       undo, return error return-value .
     1332     end.
     1333     find first buf_dis-card-property exclusive-lock
     1334       where buf_dis-card-property.d-card    = p-d-card
     1335         and buf_dis-card-property.host-code = p-host-code
     1336         and buf_dis-card-property.obj-type  = p-obj-type
     1337         and buf_dis-card-property.obj-code  = p-obj-code
     1338         and buf_dis-card-property.dt-code = p-dt-code
     1339         and buf_dis-card-property.node-code = p-node-code
     1340       no-error NO-WAIT.
     1341     if not available buf_dis-card-property then do:
     1342       p-deleted = no.
     1343     end.
     1344     else do:
     1345       run disproph_write-dis-card-property-proc  in this-procedure (
     1346            buffer buf_dis-card-property
     1347           ,buffer buf_dis-card
     1348           ,input buf_dis-card-property.d-card
     1349           ,input buf_dis-card-property.dt-code
     1350           ,input buf_dis-card-property.host-code
     1351           ,input buf_dis-card-property.obj-type
     1352           ,input buf_dis-card-property.obj-code
     1353           ,input buf_dis-card-property.dtm-code
     1354           ,input buf_dis-card-property.card-num
     1355           ,input buf_dis-card-property.main-card
     1356           ,input buf_dis-card-property.first-card
     1357           ,input buf_dis-card-property.first-main-card
     1358           ,input buf_dis-card-property.node-code
     1359           ,input integer('99':U)
     1360           ,input p-source-type
     1361           ,input p-source-ref
     1362           ,input-output p-chip-num
     1363           ,input-output p-corr-date
     1364           ,input-output p-corr-time
     1365            ).
     1366       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1367       delete buf_dis-card-property no-error .
     1368       if error-status:error then do:
     1369         return error return-value.
     1370       end.
     1371       p-deleted = yes.
     1372     end.
     1373   end.
     1374   end procedure.
     1375   procedure discprop-check :
     1376   define input parameter p-range  as integer no-undo .
     1377   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1378   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1379   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1380   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1381   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1382   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1383   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1384   define variable v-message as character no-undo .
     1385   define buffer buf_sysconf for ub.sysconf.
     1386   define buffer buf_clients for ub.clients.
     1387   define buffer buf_dis-card for ub.dis-card.
     1388   define buffer buf_attr-prop for ub.attr-prop.
     1389   do
     1390   on error undo, return error return-value
     1391   :
     1392     if p-host-code > 0 then do:
     1393       FIND FIRST buf_sysconf No-LOCK WHERE
     1394                 buf_sysconf.host-code = p-host-code No-ERROR.
     1395       IF NOT AVAIL buf_sysconf THEN DO:
     1396         v-message = substitute("Не найдена фирма &1", p-host-code).
     1397         RETURN ERROR v-message.
     1398       END.
     1399     end.
     1400     if p-obj-type <> "":U or
     1401         p-obj-code <> 0 then do:
     1402       find first buf_clients No-LOCK WHERE
     1403                 buf_clients.obj-type = p-obj-type AND
     1404                 buf_clients.obj-code = p-obj-code no-error .
     1405       if not available buf_clients then do:
     1406         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1407         RETURN ERROR v-message.
     1408       end.
     1409     end.
     1410     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1411       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1412                               , p-obj-type
     1413                               , p-obj-code
     1414                               , p-host-code).
     1415       RETURN ERROR v-message.
     1416     end.
     1417     if p-d-card <> "":U then do:
     1418       find first buf_dis-card No-LOCK WHERE
     1419                   buf_dis-card.d-card = p-d-card No-ERROR.
     1420       if not avail buf_dis-card then do:
     1421         v-message =substitute("Не найдена ДК").
     1422         return error  v-message.
     1423       end.
     1424       if buf_dis-card.emitent-host-code <> 0
     1425       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1426         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1427         return error v-message.
     1428       end.
     1429       if buf_dis-card.emitent-host-code = 0
     1430       and p-range = 1
     1431       and p-host-code <> 0 then do:
     1432         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1433                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1434                                 , chr(10)
     1435                               ).
     1436         return error v-message.
     1437       end.
     1438     end.
     1439   end.
     1440   end procedure.
     1441   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1442   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1443   FUNCTION propreft-Date-to-String returns character(input  p-date as date):
     1444   define variable v-date-str as character no-undo .
     1445   assign
     1446   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     1447                string(Month(p-date), "99":U) + chr(47) +
     1448                string(DAY(p-date), "99":U).
     1449   return v-date-str.
     1450   END FUNCTION.
     1451   function propreft-string-to-date returns date ( input p-string  as character):
     1452     define variable v-date as date no-undo .
     1453     assign
     1454     v-date = date(integer(substring(p-string, 6, 2))
     1455                   ,integer(substring(p-string, 9, 2))
     1456                   ,integer(substring(p-string, 1, 4))
     1457                  ) no-error .
     1458     if error-status:error then return ?.
     1459     return v-date.
     1460   END FUNCTION.
     1461   FUNCTION propreft-petrol-to-String returns character(input  p-gds-code as integer):
     1462   define variable v-date-str as character no-undo .
     1463   assign
     1464   v-date-str = substitute("petrol-&1", p-gds-code).
     1465   return v-date-str.
     1466   END FUNCTION.
     1467   FUNCTION propreft-string-to-petrol returns integer(input  p-string as character):
     1468   define variable v-gds-code as integer no-undo .
     1469   assign
     1470   v-gds-code = integer(entry(2, p-string, "-")) no-error.
     1471   return v-gds-code.
     1472   END FUNCTION.
     1473   define stream stmxmlout .
     1474   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1475   define variable v-xml-file-name     as character            no-undo.
     1476   define variable v-xml-file-name-path as character            no-undo.
     1477   define variable v-log-file-name     as character            no-undo.
     1478   define variable v-locked            as logical              no-undo.
     1479   define variable v-log-string        as character            no-undo.
     1480   define variable v-oper-num          as integer              no-undo.
     1481   define variable v-obj-list          as character            no-undo.
     1482   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     1483   DEF VAR intRep      AS INT NO-UNDO.
     1484   define variable hEDT             AS HANDLE NO-UNDO.
     1485   define variable hCNT             AS HANDLE NO-UNDO.
     1486   procedure xml-cd-write-header:
     1487   do
     1488   on error undo, return error
     1489   :
     1490   define input parameter p-xml-file-name       as character    no-undo.
     1491   define input parameter p-xml-file-name-path  as character    no-undo.
     1492   define input parameter p-doc-name            as character    no-undo.
     1493   define input parameter p-version             as character    no-undo.
     1494   define input parameter p-obj-list            as character    no-undo.
     1495   define input parameter p-correspondent       as character    no-undo .
     1496   define input parameter p-write-header        as logical      no-undo .
     1497   define variable OS-time as character no-undo .
     1498   define variable id as character no-undo .
     1499   define buffer buf_db for ub.db.
     1500   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1501   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1502   assign
     1503   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1504   .
     1505   run bgelib-tag-open in this-procedure (
     1506                                        1
     1507                                       ,p-doc-name
     1508                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1509                                         ).
     1510   if p-write-header then do:
     1511     run bgelib-tag-open(2, "Header","").
     1512     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1513     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1514     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1515     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1516     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1517     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1518     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1519     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1520     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1521     run bgelib-tag-close( 2, "Header" ).
     1522   end.
     1523   output stream stmXMLOut close.
     1524   end.
     1525   end procedure.
     1526   procedure xml-cd-write-footer:
     1527   do
     1528   on error undo, return error
     1529   :
     1530   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1531   define input parameter p-xml-file-name as character    no-undo.
     1532   define input parameter p-doc-name      as character    no-undo .
     1533   define variable v-error-num     as integer           no-undo.
     1534   define variable v-md5-signature as character no-undo .
     1535   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1536   run bgelib-tag-close( 0, p-doc-name ).
     1537   put stream stmXMLOut unformatted skip.
     1538   output stream stmXMLOut close.
     1539   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1540   if v-error-num > 0
     1541   then do:
     1542      return error.
     1543   end.
     1544   if opsys = "unix"
     1545   then do:
     1546       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1547   end.
     1548   end.
     1549   end procedure.
     1550   procedure xml-cd-filename :
     1551   do
     1552   on error undo, return error
     1553   :
     1554   define input parameter  p-out               as character no-undo .
     1555   define output parameter p-xml-file-name     as character    no-undo.
     1556   define output parameter p-xml-file-name-path   as character    no-undo.
     1557   define output parameter p-log-file-name     as character    no-undo.
     1558   define output parameter p-locked            as logical      no-undo.
     1559   define variable v-out as character     no-undo.
     1560   define variable loc#log as logical no-undo .
     1561   define variable BadFlag as logical no-undo .
     1562   define variable fq as integer no-undo .
     1563   define variable v-remote as character no-undo .
     1564   assign
     1565   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1566   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1567   p-log-file-name = p-out + "actions.log"
     1568   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1569   .
     1570   end.
     1571   end procedure.
     1572   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1573   define variable v-date-str as character no-undo .
     1574   assign
     1575   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1576                string(Month(p-date), "99":U) + "-":U +
     1577                string(DAY(p-date), "99":U).
     1578   return v-date-str.
     1579   END FUNCTION.
     1580   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1581   define variable v-date-str as character no-undo .
     1582   assign
     1583   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1584                string(Month(p-date), "99":U) + "-":U +
     1585                string(DAY(p-date), "99":U) + chr(32) +
     1586                string(p-time, "HH:MM:SS").
     1587   return v-date-str.
     1588   END FUNCTION.
     1589   function string-to-date returns date ( input p-string  as character):
     1590     define variable v-date as date no-undo .
     1591     assign
     1592     v-date = date(integer(substring(p-string, 4, 2))
     1593                   ,integer(substring(p-string, 1, 2))
     1594                   ,integer(substring(p-string, 7, 4))
     1595                  ) no-error .
     1596     if error-status:error then return ?.
     1597     return v-date.
     1598   END FUNCTION.
     1599   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1600   define variable v-time as integer no-undo init ?.
     1601   define variable v-dop1 as character no-undo .
     1602   define variable v-dop2 as character no-undo .
     1603   assign
     1604   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1605   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1606   no-error .
     1607   if error-status:error then return ?.
     1608   assign
     1609   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1610             integer(entry(2, v-dop2, ";":U)) * 60 +
     1611             integer(entry(3, v-dop2, ";":U)) no-error .
     1612   return v-time.
     1613   END FUNCTION.
