     3155   procedure command_get_readcons :
     3156   define input parameter p-d-card as character no-undo .
     3157   define input parameter p-hdoc   as handle no-undo .
     3158   define input parameter p-hnode  as handle no-undo .
     3159   define variable v-ii as integer no-undo .
     3160   define variable hattr as handle no-undo.
     3161   define variable htext as handle no-undo .
     3162   define variable v-hdoc as handle no-undo .
     3163   define variable helem as handle no-undo .
     3164   define variable v-error-mess as character no-undo .
     3165   define variable v-error-code as character no-undo .
     3166   define variable v-petrol-num as integer no-undo init ?.
     3167   define variable v-total as decimal no-undo .
     3168   define variable v-month as decimal no-undo .
     3169   define variable v-day as decimal no-undo .
     3170   define variable v-last-date as date no-undo .
     3171   define variable v-last-time as integer no-undo .
     3172   define buffer buf_temp-nodes for temp-nodes.
     3173   define buffer buf2_temp-ef for vidtemp-ef .
     3174   define buffer buf2_temp-ef1 for vidtemp-ef1 .
     3175   define buffer buf_prop-ref for ub.prop-ref.
     3176     do
     3177     on error undo, return error
     3178     :
     3179       find first buf2_temp-ef .
     3180       create x-noderef hattr.
     3181       if P-hnode:get-attribute-node(hattr, "format") then do:
     3182         assign
     3183         buf2_temp-ef.ef-format = integer(hattr:node-value) no-error.
     3184       end.
     3185       create x-noderef htext.
     3186       do v-ii = 1 to p-hnode:num-children:
     3187         P-hnode:get-child(htext, v-ii).
     3188         if htext:subtype = "element"
     3189         and htext:name = "Consumption" then do:
     3190           assign
     3191           v-total = ?
     3192           v-month = ?
     3193           v-day = ?
     3194           v-last-date = ?
     3195           .
     3196           if htext:get-attribute-node(hattr, "n") then do:
     3197             v-petrol-num = integer(hattr:node-value) no-error.
     3198           end.
     3199           if htext:get-attribute-node(hattr, "total") then do:
     3200             v-total = decimal(hattr:node-value) no-error.
     3201           end.
     3202           if htext:get-attribute-node(hattr, "month") then do:
     3203             v-month = decimal(hattr:node-value) no-error.
     3204           end.
     3205           if htext:get-attribute-node(hattr, "day") then do:
     3206             v-day = decimal(hattr:node-value) no-error.
     3207           end.
     3208           if htext:get-attribute-node(hattr, "date") then do:
     3209             assign
     3210             v-last-date = date(hattr:node-value) no-error.
     3211           end.
     3212           if v-petrol-num <> ?
     3213           and v-petrol-num <=4
     3214           and v-petrol-num > 0
     3215           then do:
     3216             find first buf2_temp-ef1 where
     3217                         buf2_temp-ef1.d-card = p-d-card
     3218                   and buf2_temp-ef1.petrol-num = v-petrol-num no-error.
     3219             if available buf2_temp-ef1 then do:
     3220               assign
     3221               buf2_temp-ef1.common-expense  = v-total
     3222               buf2_temp-ef1.month-expense  = v-month
     3223               buf2_temp-ef1.day-expense  = v-day
     3224               buf2_temp-ef1.last-date  = v-last-date
     3225               .
     3226             end.
     3227           end.
     3228         end.
     3229       end.
     3230       if P-hnode:get-attribute-node(hattr, "error") then do:
     3231         assign
     3232         v-error-code = hattr:node-value no-error.
     3233         create x-noderef htext.
     3234         repeat v-ii = 1 to P-hnode:num-children:
     3235           P-hnode:get-child(htext, v-ii).
     3236           if htext:subtype = "text" then do:
     3237             v-error-mess = htext:node-value.
     3238             leave.
     3239           end.
     3240         end.
     3241       end.
     3242       delete object hattr.
     3243       delete object htext.
     3244       if v-error-code = "99"
     3245       or v-error-code = ""
     3246       or v-error-code = ?
     3247       then return "".
     3248       return v-error-mess.
     3249     end.
     3250   end procedure.
     3251   procedure command_set_writehistory :
     3252   define input parameter p-d-card as character no-undo .
     3253   define input parameter p-hdoc   as handle no-undo .
     3254   define input parameter p-hroot  as handle no-undo .
     3255   define variable v-ii as integer no-undo .
     3256   define variable v-wl-handle as handle no-undo .
     3257   define buffer buf_temp-nodes for temp-nodes.
     3258   define buffer buf_temp-efh for temp-efh.
     3259   define buffer buf_temp-ef for temp-ef.
     3260   do
     3261   on error undo, return error
     3262   :
     3263     find first buf_temp-ef where
     3264               buf_temp-ef.d-card = p-d-card.
     3265     create buf_temp-nodes.
     3266     create x-noderef buf_temp-nodes.nhandle.
     3267     assign
     3268     buf_temp-nodes.nname = "WriteHistory".
     3269     p-hdoc:create-node(buf_temp-nodes.nhandle, "WriteHistory", "ELEMENT").
     3270     p-hroot:append-child(buf_temp-nodes.nhandle).
     3271     buf_temp-nodes.nhandle:set-attribute("token", p-d-card).
     3272     buf_temp-nodes.nhandle:set-attribute("format", string(buf_temp-ef.ef-format)).
     3273     v-wl-handle = buf_temp-nodes.nhandle.
     3274     do v-ii = 1 to 6:
     3275       find first buf_temp-efh where
     3276                 buf_temp-efh.d-card = p-d-card
     3277               and buf_temp-efh.seq = v-ii no-error.
     3278       create buf_temp-nodes.
     3279       create x-noderef buf_temp-nodes.nhandle.
     3280       p-hdoc:create-node(buf_temp-nodes.nhandle, "History", "ELEMENT").
     3281       v-wl-handle:append-child(buf_temp-nodes.nhandle).
     3282       buf_temp-nodes.nhandle:set-attribute("n", string(v-ii)).
     3283       if available buf_temp-efh then do:
     3284         buf_temp-nodes.nhandle:set-attribute("seq", string(buf_temp-efh.seq)).
     3285         buf_temp-nodes.nhandle:set-attribute("date", string(buf_temp-efh.date_, "99.99.9999")).
     3286         buf_temp-nodes.nhandle:set-attribute("time", string(buf_temp-efh.time_, "hh:mm:ss")).
     3287         buf_temp-nodes.nhandle:set-attribute("azs", string(buf_temp-efh.obj-code)).
     3288         buf_temp-nodes.nhandle:set-attribute("product", string(buf_temp-efh.ef-petrol-code)).
     3289         buf_temp-nodes.nhandle:set-attribute("fpoint", string(buf_temp-efh.pump-code)).
     3290         buf_temp-nodes.nhandle:set-attribute("nozzle", string(buf_temp-efh.nozzle-code)).
     3291         buf_temp-nodes.nhandle:set-attribute("volume", string(buf_temp-efh.doc-qnty-pl100)).
     3292         buf_temp-nodes.nhandle:set-attribute("cassa", string(buf_temp-efh.cash-desk)).
     3293         buf_temp-nodes.nhandle:set-attribute("doc", string(buf_temp-efh.chk-num)).
     3294       end.
     3295       else do:
     3296         buf_temp-nodes.nhandle:set-attribute("seq", string(0)).
     3297         buf_temp-nodes.nhandle:set-attribute("date", string(buf_temp-ef.valid-from, "99.99.9999")).
     3298         buf_temp-nodes.nhandle:set-attribute("time", string(0, "hh:mm:ss")).
     3299         buf_temp-nodes.nhandle:set-attribute("azs", string(0)).
     3300         buf_temp-nodes.nhandle:set-attribute("product", string(0)).
     3301         buf_temp-nodes.nhandle:set-attribute("fpoint", string(1)).
     3302         buf_temp-nodes.nhandle:set-attribute("nozzle", string(1)).
     3303         buf_temp-nodes.nhandle:set-attribute("volume", string(0)).
     3304         buf_temp-nodes.nhandle:set-attribute("cassa", string(0)).
     3305         buf_temp-nodes.nhandle:set-attribute("doc", string(0)).
     3306       end.
     3307     end.
     3308   end.
     3309   end procedure.
     3310   procedure command_get_writehistory :
     3311   define input parameter p-d-card as character no-undo .
     3312   define input parameter p-hdoc   as handle no-undo .
     3313   define input parameter p-hnode  as handle no-undo .
     3314   define variable v-ii as integer no-undo .
     3315   define variable hattr as handle.
     3316   define variable htext as handle.
     3317   define variable v-error-mess as character no-undo .
     3318   define buffer buf_temp-nodes for temp-nodes.
     3319   define buffer buf2_temp-ef for vidtemp-ef.
     3320     do
     3321     on error undo, return error
     3322     :
     3323       find first buf2_temp-ef .
     3324       create x-noderef hattr.
     3325       if P-hnode:get-attribute-node(hattr, "error") then do:
     3326         create x-noderef htext.
     3327         repeat v-ii = 1 to P-hnode:num-children:
     3328           P-hnode:get-child(htext, v-ii).
     3329           if htext:subtype = "text" then do:
     3330             v-error-mess = htext:node-value.
     3331             leave.
     3332           end.
     3333         end.
     3334       end.
     3335       delete object hattr.
     3336       delete object htext.
     3337       return v-error-mess.
     3338     end.
     3339   end procedure.
     3340   procedure prepare-file-names :
     3341   define input-output parameter p-out-file as character no-undo .
     3342   define input-output parameter p-in-file as character no-undo .
     3343   define variable v-xml-file-base as character no-undo .
     3344   define variable v-full-path        as character no-undo .
     3345   define variable v-path             as character no-undo .
     3346   define variable v-file-name        as character no-undo .
     3347   define variable v-file-name-no-ext as character no-undo .
     3348   define variable v-file-name-ext    as character no-undo .
     3349   define variable v-xml-path as character no-undo .
     3350   do
     3351   on error undo, return error
     3352   :
     3353     os-delete value(p-out-file).
     3354     os-delete value(p-in-file).
     3355     assign
     3356     v-xml-file-base = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3357     p-out-file = substitute("&1c.xml"
     3358                             ,v-xml-file-base
     3359                             )
     3360     p-in-file = substitute("&1r.xml"
     3361                             ,v-xml-file-base
     3362                             )
     3363     .
     3364   end.
     3365   end procedure.
     3366   procedure prepare-cmd-line :
     3367   define input parameter p-out-file as character no-undo .
     3368   define input parameter p-in-file as character no-undo .
     3369   define output parameter p-cmd-line as character no-undo .
     3370   define variable v-xml-file-base as character no-undo .
     3371   define variable v-full-path        as character no-undo .
     3372   define variable v-path             as character no-undo .
     3373   define variable v-file-name        as character no-undo .
     3374   define variable v-file-name-no-ext as character no-undo .
     3375   define variable v-file-name-ext    as character no-undo .
     3376   define variable v-xml-path as character no-undo .
     3377   define variable v-python-path as character no-undo .
     3378   define variable v-com-port as character no-undo .
     3379   define variable v-controller-no as character no-undo .
     3380   define variable glog as logical no-undo .
     3381   do
     3382   on error undo, return error
     3383   :
     3384     run gbl/filename.p  (
     3385                      input p-out-file
     3386                     ,output v-full-path
     3387                     ,output v-path
     3388                     ,output v-file-name
     3389                     ,output v-file-name-no-ext
     3390                     ,output v-file-name-ext
     3391                     ) no-error  .
     3392     if error-status:error then do:
     3393       undo, return error return-value .
     3394     end.
     3395     assign
     3396     v-xml-path  = v-path.
     3397     run gbl/filename.p  (
     3398                      input "exe/vid/vid.pyc"
     3399                     ,output v-full-path
     3400                     ,output v-path
     3401                     ,output v-file-name
     3402                     ,output v-file-name-no-ext
     3403                     ,output v-file-name-ext
     3404                     )  .
     3405     run verify-ini-entry in this-procedure (
     3406                                               INPUT  'python-path'
     3407                                             ,INPUT  'easyfuel'
     3408                                             ,INPUT substitute("в ini-файле отсутствует путь к подкаталогу установки PYTHON")
     3409                                             ,INPUT yes
     3410                                             ,output v-python-path) no-error .
     3411     if error-status:error or v-python-path = ? then return error return-value .
     3412     RUN verify-file in this-procedure
     3413                                       ( v-python-path
     3414                                       , substitute("Не найден каталог &1 параметр python-path, секция [easyfuel] ini-файла", v-python-path)
     3415                                       , yes
     3416                                       ,output glog) no-error.
     3417     if error-status:error or not glog then return error return-value .
     3418     run verify-ini-entry in this-procedure (
     3419                                               INPUT  'com-port'
     3420                                             ,INPUT  'easyfuel'
     3421                                             ,INPUT substitute("в ini-файле отсутствует настройка COM-порта для устройтва персонализации МБ")
     3422                                             ,INPUT yes
     3423                                             ,output v-com-port) no-error .
     3424     if error-status:error or v-com-port = ? then do:
     3425       v-com-port = "COM1".
     3426     end.
     3427     run verify-ini-entry in this-procedure (
     3428                                               INPUT  'controller-no'
     3429                                             ,INPUT  'easyfuel'
     3430                                             ,INPUT substitute("в ini-файле отсутствует настройка номера контролера для устройтва персонализации МБ")
     3431                                             ,INPUT yes
     3432                                             ,output v-controller-no) no-error .
     3433     if error-status:error or v-controller-no = ? then do:
     3434       v-controller-no = "1".
     3435     end.
     3436     p-cmd-line = substitute("&7\python.exe &6 &1 &2 &3 &4 &5"
     3437                             ,v-com-port
     3438                             ,v-controller-no
     3439                             ,v-xml-path + chr(47) + p-out-file
     3440                             ,v-xml-path + chr(47) + p-in-file
     3441                             ,""
     3442                             ,v-full-path
     3443                             ,prepare-path(v-python-path)
     3444                                                       ).
     3445   end.
     3446   end procedure.
     3447   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3448   define NEW SHARED temp-table temp-labels no-undo
     3449   field f_name as character
     3450   field l_name as character
     3451   field v_old as character
     3452   field v_new as character
     3453   field t_name as character
     3454   field num_ as integer
     3455   field uniq-key-rec as character
     3456   field action as integer
     3457   field fNotChange as logical
     3458   field f_update as logical
     3459   field f_can_update as logical
     3460   field f_parent as character
     3461   field f_visible as logical
     3462   field f_root as character
     3463   index iu f_update
     3464   index ivisible  f_visible
     3465   index iparent f_root f_parent
     3466   index pi is unique primary
     3467   num_
     3468   t_name
     3469   f_name
     3470   index
     3471   Chan
     3472   fnotChange
     3473   t_name
     3474   f_name
     3475   index imain uniq-key-rec
     3476   .
     3477   FUNCTION get-all-fields returns character (p-file-name as character ):
     3478   define variable v-dop as character no-undo .
     3479     find first _file no-lock where _file._file-name = p-file-name no-error .
     3480     if not available _file then return "":U.
     3481     for each _field no-lock where
     3482              _field._file-recid = recid(_file) :
     3483       assign
     3484       v-dop = v-dop + _field._field-name + chr(44)
     3485       .
     3486     end.
     3487     return trim(v-dop).
     3488   END FUNCTION.
     3489   procedure tempchgs-create-lable-record :
     3490   define input parameter p-t_name as character no-undo .
     3491   define input parameter p-f_name as character no-undo .
     3492   define input parameter p-l_name as character no-undo .
     3493   define input parameter p-f_update as logical no-undo .
     3494   define input parameter p-f_parent as character no-undo .
     3495   define input parameter p-f_visible as logical no-undo .
     3496   define buffer buf_temp-labels for temp-labels.
     3497     do
     3498     on error undo, return error
     3499     :
     3500        find first buf_temp-labels where
     3501                 buf_temp-labels.t_name = p-t_name
     3502             and buf_temp-labels.f_name = p-f_name no-error.
     3503        if not available buf_temp-labels then do:
     3504         create buf_temp-labels.
     3505         assign
     3506         buf_temp-labels.t_name = p-t_name
     3507         buf_temp-labels.f_name = p-f_name
     3508         buf_temp-labels.l_name = p-l_name
     3509         .
     3510        end.
     3511        assign
     3512        buf_temp-labels.f_can_update = p-f_update
     3513        buf_temp-labels.f_parent = p-f_parent
     3514        buf_temp-labels.f_visible = p-f_visible
     3515        buf_temp-labels.f_root = (if p-f_parent = '':U then p-f_name else p-f_parent)
     3516        buf_temp-labels.num_ = 0
     3517        .
     3518     end.
     3519   end procedure.
     3520   define variable v-num as integer no-undo .
     3521   DEFINE VARIABLE v-rid-list as character no-undo .
     3522   define variable v-setted as logical no-undo .
     3523   define variable v-sum-id as character no-undo .
     3524   define variable v-dt-code as integer no-undo .
     3525   define variable v-nid as character no-undo .
     3526   define variable glog as logical no-undo .
     3527   define buffer buf_dis-card for ub.dis-card.
     3528   define buffer locked_dis-card-property for ub.dis-card-property.
     3529   define buffer buf_temp-ef for temp-ef.
     3530   define buffer buf_temp-ef1 for temp-ef1.
     3531   define buffer buf_temp-ef2 for temp-ef2.
     3532   define buffer buf2_temp-ef for vidtemp-ef.
     3533   define buffer buf2_temp-ef1 for vidtemp-ef1.
     3534   define buffer buf2_temp-ef2 for vidtemp-ef2.
     3535   run ref/discards.w (
     3536                     input parparentproc
     3537                   ,input "b-sel":U
     3538                   ,input 'все':U
     3539                   ,input v-cntxt-host-code-obj
     3540                   ,input v-cntxt-obj-type
     3541                   ,input v-cntxt-obj-code
     3542                   ,input '':U
     3543                   ,input ?
     3544                   ,output v-rid-list ) no-error.
     3545   if not v-rid-list  = "" then do:
     3546     FIND FIRST buf_dis-card no-lock where
     3547                 recid(buf_dis-card) = integer(v-rid-list).
     3548     if buf_dis-card.status_ = 'неисп':U
     3549     or buf_dis-card.status_ = 'смкли':U
     3550     then do:
     3551       message
     3552       substitute("Нельзя изменять данные МБ &1&2" +
     3553                 "Карта имеет статус &3, &4"
     3554               , buf_dis-card.d-card
     3555               , chr(10)
     3556               , buf_dis-card.status_
     3557               , (if buf_dis-card.status_ = 'неисп':U
     3558                 then "карта должна быть ОКОНЧАТЕЛЬНО удалена"
     3559                 else "карта будет доступна по окончании процесса смены владельца")
     3560                   )
     3561       view-as alert-box error .
     3562       return .
     3563     end.
     3564     do
     3565     on error undo, return error return-value
     3566     on stop undo, return error return-value
     3567     on end-key undo, return error return-value :
     3568       run lock-dcp in this-procedure ( input buf_dis-card.d-card
     3569                                       ,buffer locked_dis-card-property).
     3570     end.
     3571     define buffer buf_Dis-card-property for ub.dis-card-property.
     3572     find first buf_Dis-card-property no-lock where
     3573                buf_dis-card-property.dtm-code = 25
     3574            and buf_dis-card-property.d-card = buf_Dis-card.d-card
     3575            and buf_dis-card-property.host-code = 0
     3576            and buf_dis-card-property.obj-type = ''
     3577            and buf_dis-card-property.obj-code = 0 no-error.
     3578     if not available buf_dis-card-property then do:
     3579       message
     3580       substitute("В системе IBS TH нет идентификационных данных EasyFuel для данной карты-МБ &1", buf_Dis-card.d-card)
     3581       view-as alert-box error .
     3582       undo, return ''.
     3583     end.
     3584     assign
     3585     v-sum-id = buf_dis-card-property.sum-id
     3586     v-dt-code = buf_dis-card-property.dt-code
     3587     .
     3588     for each temp-dis-card-property:
     3589       delete temp-dis-card-property.
     3590     end.
     3591     run init-temp-dcp in this-procedure ( input 'ПРОСМОТР':U + chr(44) + "init"
     3592                                         ,input buf_dis-card.d-card
     3593                                         ,input 25
     3594                                         ,input v-sum-id
     3595                                         ,input v-dt-code).
     3596     run init-temp-dcp in this-procedure ( input 'ПРОСМОТР':U + chr(44) + "init"
     3597                                         ,input buf_dis-card.d-card
     3598                                         ,input 24
     3599                                         ,input ""
     3600                                         ,input 0).
     3601     v-setted = yes.
     3602     if v-setted then do:
     3603       run write-log in p-log-handle ( input 0,  "Ждите..." ).
     3604       for each buf_temp-ef:
     3605         delete buf_temp-ef.
     3606       end.
     3607       for each buf_temp-ef1:
     3608         delete buf_temp-ef1.
     3609       end.
     3610       for each buf_temp-ef2:
     3611         delete buf_temp-ef2.
     3612       end.
     3613       run fill-main-table  in this-procedure ( input buf_Dis-card.d-card, buffer buf_Dis-card).
     3614       define variable v-out-file as character no-undo .
     3615       define variable v-in-file as character no-undo .
     3616       define variable v-cmd-line as character no-undo .
     3617       define variable v-time as integer no-undo init 30.
     3618       define variable v-xml-file-base as character no-undo .
     3619       define variable v-error-code as character no-undo.
     3620       for each buf_temp-ef:
     3621         create buf2_temp-ef.
     3622         buffer-copy buf_temp-ef
     3623         to buf2_temp-ef.
     3624       end.
     3625       for each buf_temp-ef1:
     3626         create buf2_temp-ef1.
     3627         buffer-copy buf_temp-ef1
     3628         to buf2_temp-ef1.
     3629       end.
     3630       for each buf_temp-ef2:
     3631         create buf2_temp-ef2.
     3632         buffer-copy buf_temp-ef2
     3633         to buf2_temp-ef2.
     3634       end.
     3635       define variable v-param-type as character no-undo .
     3636       define variable v-value-date as date no-undo .
     3637       define variable v-value-decimal as decimal no-undo .
     3638       define variable v-value-integer as INTEGER no-undo .
     3639       define variable v-value-logical AS LOGICAL no-undo .
     3640       define variable v-tth as handle no-undo .
     3641       run adm/shattri.p (
     3642            input "get":U
     3643           ,input  v-cntxt-obj-type
     3644           ,input  v-cntxt-obj-code
     3645           ,input  'easyfuel':U
     3646           ,input  'master-key':U
     3647           ,output v-nid
     3648           ,output v-value-date
     3649           ,output v-value-decimal
     3650           ,output v-value-integer
     3651           ,output v-value-logical
     3652           ,output v-param-type
     3653           ,INPUT-OUTPUT table-handle v-tth
     3654           ) no-error .
     3655       delete object v-tth.
     3656       v-time = 0 * 10 + 10.
     3657       run prepare-file-names in this-procedure ( input-output v-out-file, input-output v-in-file).
     3658       run set-cmd-file in this-procedure (
     3659                                           input ""
     3660                                          ,input v-nid
     3661                                          ,input buf_Dis-card.d-card
     3662                                          ,input v-out-file).
     3663       run prepare-cmd-line in this-procedure ( input v-out-file, input v-in-file, output v-cmd-line) no-error.
     3664       if error-status:error then do:
     3665         run write-log in p-log-handle ( input 0,  "Ошибка" ).
     3666         run write-log in p-log-handle ( input 0,  return-value  ).
     3667         undo, return error "".
     3668       end.
     3669       run write-log in p-log-handle ( input 0,  "Обращаюсь к программе связи с МБ...Проверка связи..." ).
     3670       run gbl/syn4.p (
     3671                        input v-cmd-line
     3672                       ,input v-in-file
     3673                       ,input ""
     3674                       ,input v-time
     3675                       ) no-error.
     3676       if error-status:error then do:
     3677         run write-log in p-log-handle ( input 0,  "Ошибка" ).
     3678         run write-log in p-log-handle ( input 0,  return-value  ).
     3679         undo, return error "".
     3680       end.
     3681       if not error-status:error then do:
     3682         run get-cmd-file in this-procedure (
     3683                                            input ''
     3684                                           ,input v-in-file
     3685                                           ,input buf_Dis-card.d-card
     3686                                           ,input "no-error"
     3687                                           ,output v-error-code)
     3688         no-error.
     3689        if error-status:error then do:
     3690          run write-log in p-log-handle ( input 0,  "Ошибка" ).
     3691          run write-log in p-log-handle ( input 0,  substitute("&1&2&3"
     3692                                       , chr(10)
     3693                                       , error-status:get-message(1)
     3694                                       , return-value )).
     3695          undo, return error "".
     3696        end.
     3697       end.
     3698       v-time = 1 * 10 + 10.
     3699       run prepare-file-names in this-procedure ( input-output v-out-file, input-output v-in-file).
     3700       run set-cmd-file in this-procedure (
     3701                                           input "ReadID,ReadBrand,ReadLimit"
     3702                                          ,input v-nid
     3703                                          ,input buf_Dis-card.d-card
     3704                                          ,input v-out-file).
     3705       run prepare-cmd-line in this-procedure ( input v-out-file, input v-in-file, output v-cmd-line) no-error .
     3706       if error-status:error then do:
     3707          run write-log in p-log-handle ( input 0,  "Ошибка" ).
     3708          run write-log in p-log-handle ( input 0,  return-value ).
     3709          undo, return error "" .
     3710       end.
     3711       run write-log in p-log-handle ( input 0
     3712                                      , substitute("Обращаюсь к программе связи с МБ...&1" +
     3713                                                   "Считывание идентификационных данных...&1" +
     3714                                                   "Считывание марки транспортного средства...&1" +
     3715                                                   "Считывание лимитов по топливам..." , chr(10))).
     3716       run gbl/syn4.p (
     3717                        input v-cmd-line
     3718                       ,input v-in-file
     3719                       ,input ""
     3720                       ,input v-time
     3721                       ) no-error.
     3722       if not error-status:error then do:
     3723         run get-cmd-file in this-procedure (
     3724                                            input 'ReadId,ReadBrand,ReadLimit'
     3725                                           ,input v-in-file
     3726                                           ,input buf_Dis-card.d-card
     3727                                           ,input ""
     3728                                           ,output v-error-code
     3729                                           ) no-error .
     3730         if error-status:error then do:
     3731           run write-log in p-log-handle ( input 0,  "Ошибка" ).
     3732           run write-log in p-log-handle ( input 0,  substitute("&1&2&3"
     3733                                         , chr(10)
     3734                                         , error-status:get-message(1)
     3735                                         , return-value )).
     3736           undo, return error "".
     3737         end.
     3738       end.
     3739       find first buf_temp-ef where
     3740                 buf_temp-ef.d-card = buf_Dis-card.d-card.
     3741       find first buf2_temp-ef where
     3742                 buf2_temp-ef.d-card = buf_Dis-card.d-card.
     3743       define variable v-th as handle no-undo .
     3744       define variable v-th2 as handle no-undo .
     3745       define variable v-jj as integer no-undo .
     3746           run create-table in this-procedure ( input "limits", buffer buf_temp-ef, output v-th) .
     3747       run create-table in this-procedure ( input "limits2", buffer buf_temp-ef, output v-th2) .
     3748       run copy-fields in this-procedure ( buffer buf_temp-ef
     3749                                         ,buffer buf2_temp-ef
     3750                                         ,input v-th
     3751                                         ,input v-th2) .
     3752       define variable v-bh1 as handle no-undo .
     3753       define variable v-bh2 as handle no-undo .
     3754       create buffer v-bh1 for table v-th.
     3755       create buffer v-bh2 for table v-th2.
     3756       do v-jj = 1 to v-th:default-buffer-handle:num-fields:
     3757         if v-th:default-buffer-handle:buffer-field(v-jj):name = "record-num" then next.
     3758         run tempchgs-create-lable-record in this-procedure (
     3759                                                             input v-th:name
     3760                                                           , input v-th:default-buffer-handle:buffer-field(v-jj):name
     3761                                                           , input (if v-th:default-buffer-handle:buffer-field(v-jj):name begins "EF-"
     3762                                                                   and not (v-th:default-buffer-handle:buffer-field(v-jj):name begins "EF-f")
     3763                                                                   then substitute("&1-&2"
     3764                                                                                  ,substring(v-th:default-buffer-handle:buffer-field(v-jj):name, 1, 4)
     3765                                                                                  ,v-th:default-buffer-handle:buffer-field(v-jj):label
     3766                                                                                  )
     3767                                                                   else v-th:default-buffer-handle:buffer-field(v-jj):label)
     3768                                                           , input no
     3769                                                           , input ""
     3770                                                           , input yes
     3771                                                          ).
     3772       end.
     3773       define variable v-ok as logical no-undo .
     3774       run ref/view-chg.w (
     3775                            INPUT parparentproc
     3776                           ,input ?
     3777                           ,input "limits"
     3778                           ,input v-bh1
     3779                           ,input v-bh2
     3780                           ,input 'ПРОСМОТР':U + chr(44) + "view-identical"
     3781                           ,input 0
     3782                           ,input "Разница в данных"
     3783                           ,input "Данные в IBS TH"
     3784                           ,input "Данные на МБ"
     3785                           ,input ""
     3786                           ,input ""
     3787                           ,output v-ok) no-error.
     3788       delete object v-bh1.
     3789       delete object v-bh2.
     3790       delete object v-th.
     3791       delete object v-th2.
     3792     end.
     3793   end.
     3794   procedure create-table :
     3795   define input parameter p-tbl-name as character no-undo .
     3796   define parameter buffer buf_temp-ef for temp-ef.
     3797   define output parameter v-th as handle no-undo .
     3798   define variable v-jj as integer no-undo .
     3799   define variable v-fname as character no-undo .
     3800   define variable v-fnamelist as character no-undo .
     3801   define buffer buf_temp-ef1 for temp-ef1.
     3802   define buffer buf2_temp-ef for vidtemp-ef1.
     3803     do
     3804     on error undo, return error
     3805     :
     3806       create temp-table v-th.
     3807       v-th:add-new-field( "record-num", 'integer':U).
     3808       v-fnamelist = "car-reg-number,car-brand,ef-format,issue-code,issued-by,issue-date,valid-from,valid-date,petrol-code-1,petrol-code-2,petrol-code-3,petrol-code-4".
     3809       do v-jj = 1 to num-entries(v-fnamelist):
     3810         v-fname = entry(v-jj, v-fnamelist).
     3811         v-th:add-like-field( v-fname, buffer buf_temp-ef:handle:buffer-field(v-fname)).
     3812       end.
     3813       v-fnamelist = "ef-petrol-code,petrol-num,common-limit,month-limit,day-limit,standard-dose,petrol-code".
     3814               for each buf_temp-ef1 :
     3815         do v-jj = 1 to num-entries(v-fnamelist):       v-fname = entry(v-jj, v-fnamelist).       v-th:add-like-field( substitute("EF-&1-&2", buf_temp-ef1.ef-petrol-code, v-fname), (buffer buf_temp-ef1:handle:buffer-field(v-fname))).      end.
     3816       end.
     3817       for each buf2_temp-ef1 :
     3818         find first buf_temp-ef1 where
     3819                   buf_temp-ef1.ef-petrol-code = buf_temp-ef1.ef-petrol-code no-error.
     3820         if not available buf_temp-ef1 then do:
     3821           do v-jj = 1 to num-entries(v-fnamelist):       v-fname = entry(v-jj, v-fnamelist).       v-th:add-like-field( substitute("EF-&1-&2", buf2_temp-ef1.ef-petrol-code, v-fname), (buffer buf2_temp-ef1:handle:buffer-field(v-fname))).      end.
     3822         end.
     3823       end.
     3824       v-th:add-new-index("pi", yes, yes).
     3825       v-th:add-index-field("pi", "record-num").
     3826       v-th:temp-table-prepare(p-tbl-name).
     3827     end.
     3828   end procedure.
     3829   procedure copy-fields :
     3830   define parameter buffer buf_temp-ef for temp-ef.
     3831   define parameter buffer buf2_temp-ef for vidtemp-ef.
     3832   define input parameter v-th as handle no-undo .
     3833   define input parameter v-th2 as handle no-undo .
     3834   define variable v-jj as integer no-undo .
     3835   define variable v-fname as character no-undo .
     3836   define variable v-fnamelist as character no-undo .
     3837   define buffer buf_temp-ef1 for temp-ef1.
     3838   define buffer buf2_temp-ef1 for vidtemp-ef1.
     3839     do
     3840     on error undo, return error
     3841     :
     3842       v-th:default-buffer-handle:buffer-create.
     3843       v-th:default-buffer-handle::record-num = 1.
     3844           v-fnamelist = "car-reg-number,car-brand,ef-format,issue-code,issued-by,issue-date,valid-from,valid-date,petrol-code-1,petrol-code-2,petrol-code-3,petrol-code-4".
     3845               do v-jj = 1 to num-entries(v-fnamelist):       v-fname = entry(v-jj, v-fnamelist).       v-th:default-buffer-handle:buffer-field( substitute("&1&2", "", v-fname)):buffer-value = buffer buf_temp-ef:handle:buffer-field(v-fname):buffer-value.     end.
     3846           v-fnamelist = "ef-petrol-code,petrol-num,common-limit,month-limit,day-limit,standard-dose,petrol-code".
     3847       for each buf_temp-ef1 :
     3848         do v-jj = 1 to num-entries(v-fnamelist):       v-fname = entry(v-jj, v-fnamelist).       v-th:default-buffer-handle:buffer-field( substitute("&1&2", substitute("EF-&1-", buf_temp-ef1.ef-petrol-code), v-fname)):buffer-value = buffer buf_temp-ef1:handle:buffer-field(v-fname):buffer-value.     end.
     3849       end.
     3850       v-th:default-buffer-handle:buffer-release().
     3851       v-th2:default-buffer-handle:buffer-create.
     3852       v-th2:default-buffer-handle::record-num = 1.
     3853           v-fnamelist = "car-reg-number,car-brand,ef-format,issue-code,issued-by,issue-date,valid-from,valid-date,petrol-code-1,petrol-code-2,petrol-code-3,petrol-code-4".
     3854               do v-jj = 1 to num-entries(v-fnamelist):       v-fname = entry(v-jj, v-fnamelist).       v-th2:default-buffer-handle:buffer-field( substitute("&1&2", "", v-fname)):buffer-value = buffer buf2_temp-ef:handle:buffer-field(v-fname):buffer-value.     end.
     3855           v-fnamelist = "ef-petrol-code,petrol-num,common-limit,month-limit,day-limit,standard-dose,petrol-code".
     3856       for each buf2_temp-ef1 :
     3857         do v-jj = 1 to num-entries(v-fnamelist):       v-fname = entry(v-jj, v-fnamelist).       v-th2:default-buffer-handle:buffer-field( substitute("&1&2", substitute("EF-&1-", buf2_temp-ef1.ef-petrol-code), v-fname)):buffer-value = buffer buf2_temp-ef1:handle:buffer-field(v-fname):buffer-value.     end.
     3858       end.
     3859       v-th2:default-buffer-handle:buffer-release().
     3860     end.
     3861   end procedure.
