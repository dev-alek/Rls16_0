     2741         assign
     2742         v-error-code = hattr:node-value no-error.
     2743         create x-noderef htext.
     2744         repeat v-ii = 1 to P-hnode:num-children:
     2745           P-hnode:get-child(htext, v-ii).
     2746           if htext:subtype = "text" then do:
     2747             v-error-mess = htext:node-value.
     2748             leave.
     2749           end.
     2750         end.
     2751       end.
     2752       delete object hattr.
     2753       delete object htext.
     2754       if v-error-code = "99"
     2755       or v-error-code = ""
     2756       or v-error-code = ?
     2757       then return "".
