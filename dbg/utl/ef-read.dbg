     2017   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2018   PROCEDURE DEC-TO-HEX :
     2019   DEFINE INPUT PARAMETER  pp-base10       AS INTEGER              NO-UNDO.
     2020   DEFINE OUTPUT PARAMETER pp-hex          AS CHARACTER            NO-UNDO.
     2021   DEFINE OUTPUT PARAMETER pp-result       AS INTEGER  INITIAL 99  NO-UNDO.
     2022   DEFINE VARIABLE         pv-base10       AS INTEGER              NO-UNDO.
     2023   DEFINE VARIABLE         pv-hex          AS CHARACTER            NO-UNDO.
     2024   REPEAT:
     2025     IF RETRY THEN DO:
     2026       pp-result = 660.
     2027       RETURN.
     2028     END.
     2029     pv-base10 = pp-base10 MODULO 16.
     2030     IF pv-base10 < 10 THEN DO:
     2031       pv-hex = STRING(pv-base10) + pv-hex.
     2032     END.
     2033     ELSE DO:
     2034       pv-hex = CHR(ASC("A") + pv-base10 - 10) + pv-hex.
     2035     END.
     2036     IF pp-base10 < 16 THEN DO:
     2037       LEAVE.
     2038     END.
     2039     pp-base10 = (pp-base10 - pv-base10) / 16.
     2040   END.
     2041   pp-hex = pv-hex.
     2042   pp-result = 0.
     2043   END PROCEDURE.
     2044   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2045   procedure cur-time :
     2046      define output parameter p-today as date      no-undo .
     2047      define output parameter p-time  as integer   no-undo .
     2048     do
     2049     on error undo, return error
     2050     :
     2051       define variable v-date1 as date      no-undo .
     2052       define variable v-date2 as date      no-undo .
     2053       define variable v-time  as integer   no-undo .
     2054       assign
     2055         v-date1 = today
     2056         v-time  = time
     2057         v-date2 = today
     2058       .
     2059       if v-date1 <> v-date2
     2060       then do:
     2061         assign
     2062           v-date1 = today
     2063           v-time  = v-time
     2064         .
     2065       end.
     2066       assign
     2067         p-today = v-date1
     2068         p-time  = v-time
     2069       .
     2070     end.
     2071   end.
     2072   function cur-time-date returns character
     2073   :
     2074     return string(today, '99/99/9999':U) .
     2075   end.
     2076   function cur-time-mjd returns decimal
     2077   :
     2078     define variable v-date as date      no-undo .
     2079     define variable v-time as integer   no-undo .
     2080     run cur-time in this-procedure
     2081       (output v-date
     2082       ,output v-time
     2083       ) .
     2084     return integer(v-date) - 2400002 + (v-time / 86400) .
     2085   end.
     2086   function cur-time-get-ending-index returns integer
     2087   (input p-number as integer
     2088   )
     2089   :
     2090     if p-number < 0
     2091     or p-number = ?
     2092     then do:
     2093       return 1 .
     2094     end.
     2095     define variable v-rest as integer   no-undo .
     2096     assign
     2097       p-number = p-number modulo 100
     2098     .
     2099     if p-number < 20
     2100     then do:
     2101       assign
     2102         v-rest = p-number
     2103       .
     2104     end.
     2105     else do:
     2106       assign
     2107         v-rest = p-number modulo 10
     2108       .
     2109     end.
     2110     case v-rest :
     2111       when 1
     2112       then do:
     2113         return 2 .
     2114       end.
     2115       when 2 or
     2116       when 3 or
     2117       when 4
     2118       then do:
     2119         return 3 .
     2120       end.
     2121       otherwise do:
     2122         return 1 .
     2123       end.
     2124     end case .
     2125   end.
     2126   procedure cur-time-mjd-to-date :
     2127      define input  parameter i-mjd-diff as decimal no-undo.
     2128      define output parameter o-Date     as date    no-undo.
     2129      define output parameter o-Time     as integer no-undo.
     2130      define variable v-day-number as integer   no-undo .
     2131      if    i-mjd-diff < 0
     2132         or i-mjd-diff = ?
     2133      then do:
     2134         return "?" .
     2135      end.
     2136      assign
     2137         v-day-number = truncate(i-mjd-diff,0).
     2138         o-Date = date(v-day-number + 2400002).
     2139         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2140     .
     2141   end.
     2142   function cur-time-mjd-to-string returns character
     2143   (input p-mjd-diff as decimal
     2144   )
     2145   :
     2146     define variable v-day-number as integer   no-undo .
     2147     define variable v-seconds    as integer   no-undo .
     2148     define variable v-hour       as integer   no-undo .
     2149     define variable v-min        as integer   no-undo .
     2150     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2151     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2152     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2153     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2154     if p-mjd-diff < 0
     2155     or p-mjd-diff = ?
     2156     then do:
     2157       return "?" .
     2158     end.
     2159     assign
     2160       v-day-number = integer(truncate(p-mjd-diff,0))
     2161       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2162     .
     2163     if v-seconds > 86400
     2164     then do:
     2165       assign
     2166         v-seconds = 86400 - 1
     2167       .
     2168     end.
     2169     if v-seconds < 0
     2170     then do:
     2171       assign
     2172         v-seconds = 0
     2173       .
     2174     end.
     2175     assign
     2176       v-hour = truncate(v-seconds / 3600, 0)
     2177     .
     2178     assign
     2179       v-seconds = v-seconds modulo 3600
     2180     .
     2181     assign
     2182       v-min = truncate(v-seconds / 60, 0)
     2183     .
     2184     assign
     2185       v-seconds = v-seconds modulo 60
     2186     .
     2187     return
     2188         (if v-day-number <> 0
     2189           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2190           else ""
     2191         )
     2192       + (if v-day-number <> 0 or v-hour <> 0
     2193           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2194           else ""
     2195         )
     2196       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2197           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2198           else ""
     2199         )
     2200       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2201       .
     2202   end.
     2203   function cur-time-string returns character
     2204   :
     2205     define variable v-date as date      no-undo .
     2206     define variable v-time as integer   no-undo .
     2207     run cur-time in this-procedure
     2208       (output v-date
     2209       ,output v-time
     2210       ) .
     2211     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2212   end.
     2213   function cur-time-string-sec returns character
     2214   :
     2215     define variable v-date as date      no-undo .
     2216     define variable v-time as integer   no-undo .
     2217     run cur-time in this-procedure
     2218       (output v-date
     2219       ,output v-time
     2220       ) .
     2221     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2222   end.
     2223   function cur-time-custom  returns character
     2224   (input p-prefix as character
     2225   ,input p-date-format as character
     2226   ,input p-delimiter as character
     2227   ,input p-time-format as character
     2228   ,input p-suffix as character
     2229   )
     2230   :
     2231     define variable v-date as date      no-undo .
     2232     define variable v-time as integer   no-undo .
     2233     run cur-time in this-procedure
     2234       (output v-date
     2235       ,output v-time
     2236       ) .
     2237     return
     2238       p-prefix
     2239       + string(v-date, p-date-format)
     2240       + p-delimiter
     2241       + string(v-time, p-time-format)
     2242       + p-suffix
     2243       .
     2244   end.
     2245   function cur-time-print  returns character
     2246   :
     2247     define variable v-date as date      no-undo .
     2248     define variable v-time as integer   no-undo .
     2249     run cur-time in this-procedure
     2250       (output v-date
     2251       ,output v-time
     2252       ) .
     2253     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2254   end.
     2255   function cur-time-datetime returns datetime
     2256   :
     2257     define variable v-char as character no-undo .
     2258     define variable v-datetime as datetime no-undo .
     2259     v-char = cur-time-string().
     2260     v-datetime = datetime(v-char).
     2261     return  v-datetime.
     2262   end.
     2263   function cur-time-string-msec returns character
     2264   :
     2265     define variable v-date as datetime  no-undo .
     2266     v-date = now.
     2267     return string(v-date) .
     2268   end.
     2269   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2270   PROCEDURE verify-ini-entry:
     2271   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     2272   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     2273   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     2274   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     2275   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     2276   define variable v-mess as character no-undo .
     2277   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     2278   if ini-entry-value = ? and ini-key-name begins "spl"
     2279   then
     2280   get-key-value section ini-section-name key "splall" value ini-entry-value.
     2281   if ini-entry-value = ? and ini-key-name begins "sav"
     2282   then
     2283   get-key-value section ini-section-name key "savall" value ini-entry-value.
     2284   if ini-entry-value = ? then do:
     2285     assign
     2286     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     2287                       , chr(10)
     2288                       , ini-section-name
     2289                       , ini-key-name
     2290                       , error-msg-text).
     2291       if not silence then do:
     2292         message
     2293         v-mess
     2294         view-as alert-box ERROR  .
     2295         return error.
     2296       end.
     2297       else do:
     2298         return error v-mess.
     2299       end.
     2300   end.
     2301   END PROCEDURE.
     2302   PROCEDURE verify-file:
     2303   DEFINE INPUT  PARAMETER filename       as character no-undo.
     2304   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     2305   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     2306   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     2307   file-info:file-name = filename.
     2308   found = NOT (file-info:full-pathname = ?).
     2309   if NOT found  then do:
     2310     if not silence then do:
     2311       message error-msg-text
     2312       view-as alert-box ERROR.
     2313       return error.
     2314     end.
     2315     else return error error-msg-text.
     2316   end.
     2317   END PROCEDURE.
     2318   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2319   function prepare-path returns character ( input p-nonprepared-path as character ):
     2320   define variable v-prepared-path as character no-undo .
     2321   assign
     2322   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
     2323   v-prepared-path = right-trim(v-prepared-path, chr(47))
     2324   .
     2325   return v-prepared-path.
     2326   END FUNCTION.
     2327   function prepare-path2 returns character ( input p-nonprepared-path as character ):
     2328   define variable v-prepared-path as character no-undo .
     2329   assign
     2330   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
     2331   v-prepared-path = right-trim(v-prepared-path, chr(92))
     2332   .
     2333   return v-prepared-path.
     2334   END FUNCTION.
     2335   function quote-spaces returns character ( input p-full-path as character):
     2336   define variable v-ii as integer no-undo .
     2337   define variable v-result as character no-undo .
     2338   do v-ii = 1 to num-entries(p-full-path, chr(92)):
     2339     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
     2340                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
     2341                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
     2342                else entry(v-ii, p-full-path, chr(92))
     2343                )
     2344     .
     2345   end.
     2346   return v-result.
     2347   end function.
     2348   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2349   define temp-table temp-nodes no-undo
     2350   field nhandle as handle
     2351   field nname as character
     2352   index pi is unique primary
     2353   nhandle
     2354   .
     2355   procedure set-cmd-file :
     2356   define input parameter p-cmd-name as character no-undo .
     2357   define input parameter p-nid as character no-undo .
     2358   define input parameter p-d-card as character no-undo .
     2359   define input parameter p-xml-file as character no-undo .
     2360   do
     2361   on error undo, return error
     2362   :
     2363     define variable hdoc as handle no-undo .
     2364     define variable hroot as handle no-undo .
     2365     define variable hrow as handle no-undo .
     2366     define variable hfield as handle no-undo .
     2367     define variable htext as handle no-undo .
     2368     define variable v-ii as integer no-undo .
     2369     create x-document hdoc.
     2370     create x-noderef hroot.
     2371     create x-noderef hrow.
     2372     create x-noderef hfield.
     2373     create x-noderef htext.
     2374     hdoc:create-node(hroot, "InitVid", "element").
     2375     hdoc:encoding = "WINDOWS-1251".
     2376     hdoc:append-child(hroot).
     2377     hroot:set-attribute("mode", "command").
     2378     hroot:set-attribute("vid",  substitute("&1", p-d-card)).
     2379     if p-nid <> "":U then do:
     2380       hroot:set-attribute("nid", p-nid).
     2381     end.
     2382     hroot:set-attribute("token", substitute("&1&2", v-cntxt-obj-type, v-cntxt-obj-code)).
     2383     if p-cmd-name <> "" then do:
     2384       do v-ii = 1 to num-entries(p-cmd-name):
     2385         run value( substitute("command_set_&1", entry(v-ii, p-cmd-name))) in this-procedure ( input p-d-card
     2386                                                                           ,input hdoc
     2387                                                                           ,input hroot).
     2388       end.
     2389     end.
     2390     hdoc:save("file", p-xml-file).
     2391     for each temp-nodes:
     2392       delete object temp-nodes.nhandle.
     2393       delete temp-nodes.
     2394     end.
     2395     delete object hdoc.
     2396     delete object hroot.
     2397     delete object hrow.
     2398     delete object hfield.
     2399     delete object htext.
     2400   end.
     2401   end procedure.
     2402   procedure get-cmd-file :
     2403   define input parameter p-cmd-name as character no-undo .
     2404   define input parameter p-xml-file as character no-undo .
     2405   define input parameter p-d-card as character no-undo .
     2406   define input parameter p-option as character no-undo .
     2407   define output parameter p-error-code as character no-undo.
     2408   define variable hdoc as handle no-undo .
     2409   define variable hroot as handle no-undo .
     2410   define variable htext as handle no-undo .
     2411   define variable hattr as handle no-undo .
     2412   define variable herror as handle no-undo .
     2413   define variable v-ii as integer no-undo .
     2414   define variable v-mode as character no-undo .
     2415   define variable v-d-card as character no-undo .
     2416   define variable v-obj-type-code as character no-undo .
     2417   define variable v-error-mess as character no-undo .
     2418   define variable v-error-mess2 as character no-undo .
     2419   define variable glog as logical no-undo .
     2420   do
     2421   on error undo, return error
     2422   :
     2423     create x-document hdoc.
     2424     create x-noderef hroot.
     2425     create x-noderef htext.
     2426     create x-noderef hattr.
     2427     create x-noderef herror.
     2428     assign
     2429     glog = hdoc:load("file", p-xml-file, false) no-error.
     2430     if error-status:error
     2431     or not glog
     2432     or  error-status:get-message(1) <> ""
     2433     then do:
     2434       message
     2435       "Ошибка при чтении файла XML-ответа от программы инициализации"
     2436       error-status:get-message(1) skip
     2437       return-value view-as alert-box .
     2438       undo, return error .
     2439     end.
     2440     else if p-cmd-name <> ''
     2441     and p-cmd-name <> "readid" then do:
     2442     end.
     2443     hdoc:get-document-element(hroot).
     2444     if hroot:get-attribute-node(hattr, "mode") then do:
     2445       v-mode = hattr:node-value.
     2446     end.
     2447     if hroot:get-attribute-node(hattr, "vid") then do:
     2448       v-d-card = hattr:node-value.
     2449     end.
     2450     if hroot:get-attribute-node(hattr, "token") then do:
     2451       v-obj-type-code = hattr:node-value.
     2452     end.
     2453     if hroot:get-attribute-node(hattr, "error") then do:
     2454       assign
     2455       p-error-code = hattr:node-value no-error.
     2456       repeat v-ii = 1 to hroot:num-children:
     2457         hroot:get-child(htext,v-ii).
     2458         if htext:subtype = "text"
     2459         then do:
     2460           v-error-mess = trim(htext:node-value).
     2461           leave.
     2462         end.
     2463       end.
     2464     end.
     2465     if v-mode <> "result"
     2466     then do:
     2467       undo, return error substitute("Ответ программы инициализации МБ имеет неверный формат: &1", v-mode).
     2468     end.
     2469     if v-d-card <> p-d-card
     2470     then do:
     2471       for each temp-nodes:
     2472         delete object temp-nodes.nhandle.
     2473         delete temp-nodes.
     2474       end.
     2475       delete object hdoc.
     2476       delete object hroot.
     2477       delete object hattr.
     2478       delete object htext.
     2479       delete object herror.
     2480       undo, return error substitute("Ответ программы инициализации МБ прислал данные для МБ с ДРУГИМ идентификаторовм &1", v-d-card).
     2481     end.
     2482     if v-obj-type-code <> substitute("&1&2", v-cntxt-obj-type, v-cntxt-obj-code) then do:
     2483       for each temp-nodes:
     2484         delete object temp-nodes.nhandle.
     2485         delete temp-nodes.
     2486       end.
     2487       delete object hdoc.
     2488       delete object hroot.
     2489       delete object hattr.
     2490       delete object htext.
     2491       delete object herror.
     2492       undo, return error substitute("Ответ программы инициализации МБ имеет неверного адресата: &1", v-obj-type-code).
     2493     end.
     2494     repeat v-ii = 1 to hroot:num-children:
     2495       hroot:get-child(htext, v-ii).
     2496       case htext:subtype:
     2497         when "ELEMENT" then do:
     2498           if index(p-cmd-name, htext:name) > 0 then do:
     2499             run value( substitute("command_get_&1", htext:name)) in this-procedure ( input p-d-card
     2500                                                                               ,input hdoc
     2501                                                                               ,input htext) .
     2502             if return-value <> "" then do:
     2503               v-error-mess2 = return-value.
     2504             end.
     2505           end.
     2506         end.
     2507       end case.
     2508     end.
     2509     for each temp-nodes:
     2510       delete object temp-nodes.nhandle.
     2511       delete temp-nodes.
     2512     end.
     2513     delete object hdoc.
     2514     delete object hroot.
     2515     delete object hattr.
     2516     delete object htext.
     2517     delete object herror.
     2518     if p-option = "no-error" then do:
     2519       return substitute("Ошибка при чтении ответа на команду(-ы) &1&2&3"
     2520                            , v-error-mess
     2521                            , chr(10)
     2522                           , v-error-mess2).
     2523     end.
     2524     if v-error-mess <> ''
     2525     or v-error-mess2 <> ''
     2526     then do:
     2527       return error substitute("Ошибка при чтении ответа на команду(-ы) &1&2&3"
     2528                            , v-error-mess
     2529                            , chr(10)
     2530                           , v-error-mess2).
     2531     end.
     2532   end.
     2533   end procedure.
     2534   procedure command_set_readid :
     2535   define input parameter p-d-card as character no-undo .
     2536   define input parameter p-hdoc   as handle no-undo .
     2537   define input parameter p-hroot  as handle no-undo .
     2538   define buffer buf_temp-nodes for temp-nodes.
     2539   define buffer buf_temp-ef for temp-ef.
     2540     do
     2541     on error undo, return error
     2542     :
     2543         find first buf_temp-ef where buf_temp-ef.d-card = p-d-card.
     2544         create buf_temp-nodes.
     2545         create x-noderef buf_temp-nodes.nhandle.
     2546         assign
     2547         buf_temp-nodes.nname = "ReadID".
     2548         p-hdoc:create-node(buf_temp-nodes.nhandle, "ReadID", "ELEMENT").
     2549         p-hroot:append-child(buf_temp-nodes.nhandle).
     2550         buf_temp-nodes.nhandle:set-attribute("token",  p-d-card).
     2551         buf_temp-nodes.nhandle:set-attribute("format", string(buf_temp-ef.ef-format)).
     2552     end.
     2553   end procedure.
     2554   procedure command_get_readid :
     2555   define input parameter p-d-card as character no-undo .
     2556   define input parameter p-hdoc   as handle no-undo .
     2557   define input parameter p-hnode  as handle no-undo .
     2558   define variable v-ii as integer no-undo .
     2559   define variable hattr as handle.
     2560   define variable htext as handle.
     2561   define variable v-hdoc as handle.
     2562   define variable v-error-mess as character no-undo .
     2563   define variable v-error-code as character no-undo .
     2564   define buffer buf_temp-nodes for temp-nodes.
     2565   define buffer buf2_temp-ef for vidtemp-ef .
     2566     do
     2567     on error undo, return error
     2568     :
     2569       find first buf2_temp-ef .
     2570       create x-noderef hattr.
     2571       if p-hnode:get-attribute-node(hattr, "vrn") then do:
     2572         assign
     2573         buf2_temp-ef.car-reg-number = hattr:node-value no-error.
     2574       end.
     2575       if P-hnode:get-attribute-node(hattr, "format") then do:
     2576         assign
     2577         buf2_temp-ef.ef-format = integer(hattr:node-value) no-error.
     2578       end.
     2579       if P-hnode:get-attribute-node(hattr, "issuer") then do:
     2580         assign
     2581         buf2_temp-ef.issue-code = integer(hattr:node-value) no-error.
     2582       end.
     2583       if P-hnode:get-attribute-node(hattr, "db") then do:
     2584         assign
     2585         buf2_temp-ef.db = integer(hattr:node-value) no-error.
     2586       end.
     2587       if P-hnode:get-attribute-node(hattr, "oper") then do:
     2588         assign
     2589         buf2_temp-ef.user-id = integer(hattr:node-value)  no-error.
     2590       end.
     2591       if P-hnode:get-attribute-node(hattr, "date") then do:
     2592         assign
     2593         buf2_temp-ef.issue-date = date(hattr:node-value) no-error.
     2594       end.
     2595       if P-hnode:get-attribute-node(hattr, "time") then do:
     2596         assign
     2597         buf2_temp-ef.issue-time = integer(entry(1, hattr:node-value, ":")) * 3600 + integer(entry(1, hattr:node-value, ":")) * 60 + integer(entry(1, hattr:node-value, ":"))
     2598         no-error
     2599         .
     2600       end.
     2601       if P-hnode:get-attribute-node(hattr, "begin") then do:
     2602         assign
     2603         buf2_temp-ef.valid-from = date(hattr:node-value) no-error.
     2604       end.
     2605       if P-hnode:get-attribute-node(hattr, "end") then do:
     2606         assign
     2607         buf2_temp-ef.valid-date = date(hattr:node-value) no-error.
     2608       end.
     2609       if P-hnode:get-attribute-node(hattr, "error") then do:
     2610         assign
     2611         v-error-code = hattr:node-value no-error.
     2612         create x-noderef htext.
     2613         repeat v-ii = 1 to P-hnode:num-children:
     2614           P-hnode:get-child(htext, v-ii).
     2615           if htext:subtype = "text" then do:
     2616             v-error-mess = htext:node-value.
     2617             leave.
     2618           end.
     2619         end.
     2620       end.
     2621       delete object hattr.
     2622       delete object htext.
     2623       if v-error-code = "99"
     2624       or v-error-code = ""
     2625       or v-error-code = ?
     2626       then return "".
     2627       return v-error-mess.
     2628     end.
     2629   end procedure.
     2630   procedure command_set_writeid :
     2631   define input parameter p-d-card as character no-undo .
     2632   define input parameter p-hdoc   as handle no-undo .
     2633   define input parameter p-hroot  as handle no-undo .
     2634   define buffer buf_temp-nodes for temp-nodes.
     2635   define buffer buf_temp-ef for temp-ef.
     2636     do
     2637     on error undo, return error
     2638     :
     2639         find first buf_temp-ef where
     2640                   buf_temp-ef.d-card = p-d-card.
     2641         create buf_temp-nodes.
     2642         create x-noderef buf_temp-nodes.nhandle.
     2643         assign
     2644         buf_temp-nodes.nname = "WriteID".
     2645         p-hdoc:create-node(buf_temp-nodes.nhandle, "WriteID", "ELEMENT").
     2646         p-hroot:append-child(buf_temp-nodes.nhandle).
     2647         buf_temp-nodes.nhandle:set-attribute("token", p-d-card).
     2648         buf_temp-nodes.nhandle:set-attribute("format", string(buf_temp-ef.ef-format)).
     2649         buf_temp-nodes.nhandle:set-attribute("vrn", buf_temp-ef.car-reg-number).
     2650         buf_temp-nodes.nhandle:set-attribute("issuer", string(buf_temp-ef.issue-code)).
     2651         buf_temp-nodes.nhandle:set-attribute("db", string(buf_temp-ef.db-num)).
     2652         buf_temp-nodes.nhandle:set-attribute("oper", string(buf_temp-ef.user-id)).
     2653         buf_temp-nodes.nhandle:set-attribute("date", (if buf_temp-ef.issue-date = ?
     2654                                                       then chr(63)
     2655                                                       else string(buf_temp-ef.issue-date, "99.99.9999"))).
     2656         buf_temp-nodes.nhandle:set-attribute("time", string(buf_temp-ef.issue-time, "hh:mm:ss") ).
     2657         buf_temp-nodes.nhandle:set-attribute("begin", (if buf_temp-ef.valid-from = ?
     2658                                                       then chr(63)
     2659                                                       else string(buf_temp-ef.valid-from, "99.99.9999"))).
     2660         buf_temp-nodes.nhandle:set-attribute("end",  (if buf_temp-ef.valid-date = ?
     2661                                                      then chr(63)
     2662                                                      else string(buf_temp-ef.valid-date + 1, "99.99.9999"))).
     2663     end.
     2664   end procedure.
     2665   procedure command_get_writeid :
     2666   define input parameter p-d-card as character no-undo .
     2667   define input parameter p-hdoc   as handle no-undo .
     2668   define input parameter p-hnode  as handle no-undo .
     2669   define variable v-ii as integer no-undo .
     2670   define variable hattr as handle.
     2671   define variable htext as handle.
     2672   define variable v-error-mess as character no-undo .
     2673   define buffer buf_temp-nodes for temp-nodes.
     2674   define buffer buf2_temp-ef for vidtemp-ef.
     2675     do
     2676     on error undo, return error
     2677     :
     2678       find first buf2_temp-ef .
     2679       create x-noderef hattr.
     2680       if P-hnode:get-attribute-node(hattr, "error") then do:
     2681         create x-noderef htext.
     2682         repeat v-ii = 1 to P-hnode:num-children:
     2683           P-hnode:get-child(htext, v-ii).
     2684           if htext:subtype = "text" then do:
     2685             v-error-mess = htext:node-value.
     2686             leave.
     2687           end.
     2688         end.
     2689       end.
     2690       delete object hattr.
     2691       delete object htext.
     2692       return v-error-mess.
     2693     end.
     2694   end procedure.
     2695   procedure command_set_readbrand :
