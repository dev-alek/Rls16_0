      375   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      377   procedure disrules-fill-properties:
      378   define input  parameter p-templ-rl-root as integer   no-undo .
      379   define buffer buf_drt-prop for ub.drt-prop.
      380   define buffer buf_temp-drt-prop for temp-drt-prop.
      381   do
      382   on error undo, return error return-value
      383   :
      384     for each buf_temp-drt-prop:
      385       delete buf_temp-drt-prop.
      386     end.
      387     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      388       create buf_temp-drt-prop.
      389       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      390     end.
      391   end.
      392   end procedure.
      393   ~
      394   define variable glog as logical no-undo .
      395   define variable v-rid-list as character no-undo .
      396   define variable v-templ-rl-root as integer no-undo .
      397   DEFINE BUFFER buf_file FOR dictdb._file.
      398   FUNCTION rule-name RETURNS CHARACTER
      399     ( INPUT p-subject AS character, input p-discnt-role AS character )  FORWARD.
      400   DEFINE BUTTON b-add
      401        LABEL "&Добавить"
      402        SIZE 10 BY 1.
      403   DEFINE BUTTON b-chg
      404        LABEL "&Изменить"
      405        SIZE 10 BY 1.
      406   DEFINE BUTTON b-copy
      407        LABEL "&Копировать"
      408        SIZE 10 BY 1.
      409   DEFINE BUTTON b-del
      410        LABEL "&Удалить"
      411        SIZE 10 BY 1.
      412   DEFINE BUTTON B-Help
      413        LABEL "Помо&щь"
      414        SIZE 3 BY 1
      415        BGCOLOR 8 .
      416   DEFINE BUTTON b-lkp
      417        LABEL "&Просмотр"
      418        SIZE 10 BY 1.
      419   DEFINE BUTTON b-mark
      420        LABEL "&*"
      421        SIZE 4 BY 1.
      422   DEFINE BUTTON b-quit AUTO-END-KEY
      423        LABEL "&Выход"
      424        SIZE 10 BY 1
      425        BGCOLOR 8 .
      426   DEFINE BUTTON b-sel AUTO-GO
      427        LABEL "Выбор"
      428        SIZE 10 BY 1.
      429   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      430         VIEW-AS TEXT
      431        SIZE 6 BY 1
      432        FGCOLOR 4  NO-UNDO.
      433   DEFINE QUERY br-dis-rule FOR
      434         X_dis-rule SCROLLING.
      435   DEFINE BROWSE br-dis-rule
      436     QUERY br-dis-rule NO-LOCK DISPLAY
      437         X_dis-rule.templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!шаблона"
      438   X_dis-rule.des FORMAT "X(255)":U WIDTH 85
      439       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.
      440   DEFINE FRAME Dialog-Frame
      441        b-quit AT ROW 1 COL 1
      442        b-mark AT ROW 1 COL 21 WIDGET-ID 32
      443        b-sel AT ROW 1 COL 25 WIDGET-ID 34
      444        b-add AT ROW 1 COL 35 WIDGET-ID 2
      445        b-copy AT ROW 1 COL 45 WIDGET-ID 30
      446        b-chg AT ROW 1 COL 55 WIDGET-ID 4
      447        b-del AT ROW 1 COL 65 WIDGET-ID 6
      448        b-lkp AT ROW 1 COL 75 WIDGET-ID 8
      449        B-Help AT ROW 1 COL 95
      450        br-dis-rule AT ROW 3 COL 1
      451        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      452        SPACE(78.50) SKIP(21.09)
      453       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      454            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      455            TITLE "ШАБЛОНЫ СКИДОК"
      456            CANCEL-BUTTON b-quit.
      457   ASSIGN
      458          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      459          FRAME Dialog-Frame:HIDDEN           = TRUE.
      460   ON GO OF FRAME Dialog-Frame
      461   DO:
      462     p-rid-list = v-rid-list.
      463   END.
      464   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      465   DO:
      466     APPLY "END-ERROR":U TO SELF.
      467   END.
      468   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      469   DO:
      470   define variable v-rec as recid no-undo .
      471     run utl/disruli0.w ( input parparentproc
      472                         ,INPUT 'ДОБАВЛЕНИЕ':U
      473                         ,INPUT 0
      474                         ,output v-rec
      475                         ) no-error .
      476     RUN openbr IN THIS-PROCEDURE  NO-ERROR.
      477     reposition br-dis-rule to recid(v-rec) no-error .
      478     APPLY "ENTRY" to br-dis-rule.
      479   END.
      480   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      481   DO:
      482   define variable v-rec   as recid no-undo .
      483   define variable v-rec2  as recid no-undo .
      484   v-rec = recid(X_dis-rule).
      485     if not available X_dis-rule then return no-apply.
      486     run utl/disruli0.w ( input parparentproc
      487                         ,INPUT 'ИЗМЕНЕНИЕ':U
      488                         ,INPUT X_dis-rule.templ-rl-root
      489                         ,output v-rec2
      490                         ) no-error .
      491     RUN openbr IN THIS-PROCEDURE  NO-ERROR.
      492     reposition br-dis-rule to recid(v-rec) no-error .
      493     APPLY "ENTRY" to br-dis-rule.
      494   END.
      495   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
      496   DO:
      497   define variable v-rec as recid no-undo .
      498   IF NOT AVAILABLE X_dis-rule THEN RETURN NO-APPLY.
      499     run utl/disruli0.w ( input parparentproc
      500                         ,INPUT 'КОПИРОВАНИЕ':U
      501                          ,INPUT X_dis-rule.templ-rl-root
      502                          ,output v-rec
      503                         ) no-error .
      504     RUN openbr IN THIS-PROCEDURE  NO-ERROR.
      505     reposition br-dis-rule to recid(v-rec) no-error .
      506     APPLY "ENTRY" to br-dis-rule.
      507   END.
      508   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      509   DO:
      510     message "b-del" VIEW-AS ALERT-BOX.
      511   END.
      512   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      513   DO:
      514    define variable v-rec as recid no-undo .
      515     if not available X_dis-rule then return no-apply.
      516     run utl/disruli0.w ( input parparentproc
      517                         ,INPUT 'ПРОСМОТР':U
      518                         ,INPUT X_dis-rule.templ-rl-root
      519                         ,output v-rec
      520                         ) no-error .
      521   END.
      522   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      523   DO:
      524     define variable glog as logical no-undo .
      525     if available X_dis-rule then do:
      526   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      527   define variable v-str-recid4 as character no-undo .
      528   define variable v-num-entry4 as integer   no-undo .
      529   assign
      530     v-str-recid4 = trim( string( recid( X_dis-rule ) , "->>>>>>>>>>>9":U ) )
      531     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      532   .
      533   if v-num-entry4 > 0 then do:
      534     assign
      535       entry( v-num-entry4, v-rid-list ) = "":U
      536       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      537     .
      538   end.
      539   else do:
      540     assign
      541       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      542     .
      543   end.
      544     glog = br-dis-rule:refresh() .
      545     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      546         glog = br-dis-rule:select-next-row ().
      547         apply "VALUE-CHANGED" to br-dis-rule in frame Dialog-Frame.
      548     end.
      549     if num-entries( v-rid-list ) = 0
      550     then
      551         hide mark-num in frame Dialog-Frame.
      552     else
      553         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      554   end.
      555   apply "entry" to br-dis-rule in frame Dialog-Frame.
      556   END.
      557   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      558   DO:
      559     if available X_dis-rule then do:
      560       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      561       then  v-rid-list = string( recid( X_dis-rule ) ) .
      562     end.
      563   END.
      564   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      565   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      566   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   on help of frame Dialog-Frame
      568   do:
      569     run gbl/app_help.p
      570       (input this-procedure :file-name
      571       ,input ''
      572       ,input ?
      573       ) no-error.
      574     if error-status :error then do:
      575       message
      576         "Ошибка при вызове помощи"
      577         error-status :get-message(1)
      578         view-as alert-box .
      579     end.
      580   end.
      581   run minbtn-set in this-procedure .
      582   on choose of b-help in frame Dialog-Frame
      583   do:
      584     apply "help":u to frame Dialog-Frame .
      585   end.
      586   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   procedure minbtn-set :
      588       do
      589           on error undo, return error return-value
      590           :
      591           define variable ii              as integer       no-undo .
      592           define variable fh              as widget-handle no-undo .
      593           define variable hh              as widget-handle no-undo .
      594           define variable v-h             as handle        extent 4 no-undo .
      595           define variable v-name-button   as character     no-undo .
      596           define variable v-help-old-x    as decimal       no-undo .
      597           define variable v-help-old-y    as decimal       no-undo .
      598           define variable v-help-old-size as decimal       no-undo .
      599           define variable v-frame-width   as decimal       no-undo .
      600           define variable jj              as integer       no-undo .
      601           do
      602               on error undo, return error
      603               :
      604               assign
      605                   v-frame-width = frame Dialog-Frame:width - 0.3
      606                   fh            = frame Dialog-Frame:first-child
      607                   hh            = fh:first-child
      608                   ii            = 1
      609                   .
      610               do while valid-handle(hh):
      611                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      612                   do:
      613                       case lc(hh:name) :
      614                           when "b-help" then
      615                               do:
      616                                   hh:load-image-up("cmp/b-help.bmp":u) .
      617                                   hh:load-image-down("cmp/b-help.bmp":u) .
      618                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      619                                   hh:TOOLTIP = "Помощь" .
      620                                   v-help-old-x = hh:column .
      621                                   v-help-old-y = hh:row    .
      622                                   v-help-old-size = hh:width .
      623                                   hh:width-chars = 2.5 .
      624                               end.
      625                           when "b-print" then
      626                               do:
      627                                   hh:load-image("cmp/b-print.bmp":u) .
      628                                   hh:TOOLTIP = "Печать" .
      629                                   v-h[ii] = hh:handle .
      630                                   ii = ii + 1 .
      631                                   hh:width-chars = 3 .
      632                               end.
      633                           when "b-history" or
      634                           when "b-hist" then
      635                               do:
      636                                   hh:load-image("cmp/b-hist.bmp":u) .
      637                                   hh:TOOLTIP = "История" .
      638                                   v-h[ii] = hh:handle .
      639                                   ii = ii + 1 .
      640                                   hh:width-chars = 3 .
      641                               end.
      642                           when "b-sch" then
      643                               do:
      644                                   hh:load-image("cmp/b-sch.bmp":u) .
      645                                   hh:TOOLTIP = "Установка Фильтра" .
      646                                   v-h[ii] = hh:handle .
      647                                   ii = ii + 1 .
      648                                   hh:width-chars = 3 .
      649                               end.
      650                           when "b-hist-user" then
      651                               do:
      652                                   hh:load-image("cmp/b-hist.bmp":u) .
      653                                   hh:TOOLTIP = "История пользователя" .
      654                                   ii = ii + 1 .
      655                               end.
      656                       end case.
      657                   end.
      658                   hh = hh:next-sibling.
      659               end.
      660               b-help:column = v-frame-width - b-help:width-chars.
      661               jj = 0.
      662               repeat ii = 4 to 1 by -1 :
      663                   if valid-handle (v-h[ii] ) then
      664                   do:
      665                       jj  = jj + 1 .
      666                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      667                       v-h[ii]:row    = v-help-old-y .
      668                   end.
      669               end.
      670           end.
      671       end.
      672   end procedure.
      673   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      674   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      675   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      676   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      677   define variable v-diasize-current-frame-width  as decimal   no-undo .
      678   define variable v-diasize-current-frame-height as decimal   no-undo .
      679   define variable v-diasize-change-size          as logical   no-undo .
      680   define variable v-diasize-resize-button        as handle    no-undo .
      681   define variable v-diasize-wndmax               as logical   no-undo .
      682   define variable v-diasize-wndstore             as logical   no-undo .
      683   define variable v-diasize-proc-name            as character no-undo .
      684   define variable v-diasize-browse-handle        as handle    no-undo .
      685   define variable v-diasize-browse-number        as integer   no-undo .
      686   define variable v-diasize-need-full-display    as logical   no-undo init false .
      687   define temp-table temp-diasize-handle no-undo
      688     field handle-value  as handle
      689     field save-position as decimal
      690     index xpk is primary unique handle-value
      691     .
      692   define temp-table temp-browse-handle no-undo
      693     field browse-type   as character
      694     field browse-number as integer
      695     field browse-handle as handle
      696     field original-size as decimal
      697     index xpk is primary unique browse-type browse-number
      698     index xie browse-type browse-handle
      699   .
      700   procedure diasize_change-height :
      701     define input  parameter p-change-value  as decimal   no-undo .
      702     define input  parameter p-move-resize   as logical   no-undo .
      703     define variable v-field-group-handle    as handle    no-undo .
      704     define variable v-object-handle         as handle    no-undo .
      705     define variable v-frame-height          as decimal   no-undo .
      706     define variable v-frame-virtual-height  as decimal   no-undo .
      707     define variable v-browse-height         as decimal   no-undo .
      708     define variable v-window-height         as decimal   no-undo .
      709     define variable v-window-virtual-height as decimal   no-undo .
      710     define variable v-change-sign           as integer   no-undo .
      711     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      712     define buffer buf_temp-browse-handle  for temp-browse-handle .
      713     if p-change-value > 0
      714     then do:
      715       if frame Dialog-Frame :height + p-change-value
      716           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      717       then do:
      718         assign
      719           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      720                           - (frame Dialog-Frame :height-chars)
      721         .
      722         if p-change-value <= 0
      723         then do:
      724           run diasize_position-resize-button in this-procedure .
      725           return .
      726         end.
      727       end.
      728     end.
      729     if p-change-value < 0
      730     then do:
      731       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      732       then do:
      733         assign
      734           p-change-value = v-diasize-orig-frame-height
      735                          - (frame Dialog-Frame :height-chars)
      736         .
      737         if p-change-value >= 0
      738         then do:
      739           run diasize_position-resize-button in this-procedure .
      740           return .
      741         end.
      742       end.
      743     end.
      744     if p-change-value >= 0
      745     then do:
      746       assign
      747         v-change-sign = 1
      748       .
      749     end.
      750     else do:
      751       assign
      752         v-change-sign = -1
      753       .
      754     end.
      755     assign
      756       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      757     .
      758     if p-change-value = 0
      759     then do:
      760       run diasize_position-resize-button in this-procedure .
      761       return .
      762     end.
      763     move_block:
      764     do
      765     on error undo move_block, retry move_block
      766     :
      767       if retry
      768       then do:
      769         do
      770         on error undo move_block, leave move_block
      771         :
      772           if p-change-value > 0
      773           then do:
      774             for each buf_temp-diasize-handle
      775             on error undo, next
      776             :
      777               assign
      778                 v-object-handle = buf_temp-diasize-handle.handle-value
      779               .
      780               if v-object-handle <> v-diasize-resize-button
      781               then do:
      782                 assign
      783                   v-object-handle :row = buf_temp-diasize-handle.save-position
      784                 .
      785               end.
      786             end.
      787             assign
      788               v-diasize-browse-handle :height = v-browse-height
      789             .
      790             for each buf_temp-browse-handle
      791               where buf_temp-browse-handle.browse-type = 'height':u
      792             on error undo, next
      793             :
      794               assign
      795                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      796               .
      797             end.
      798             assign
      799               frame Dialog-Frame :height = v-frame-height
      800             .
      801             if frame Dialog-Frame :scrollable = true
      802             then do:
      803               assign
      804                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      805               .
      806             end.
      807             run diasize_position-resize-button in this-procedure .
      808           end.
      809           else do:
      810             if frame Dialog-Frame :scrollable = true
      811             then do:
      812               assign
      813                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      814               .
      815             end.
      816             assign
      817               frame Dialog-Frame :height = v-frame-height
      818             .
      819             assign
      820               v-diasize-browse-handle :height = v-browse-height
      821             .
      822             for each buf_temp-browse-handle
      823               where buf_temp-browse-handle.browse-type = 'height':u
      824             on error undo, next
      825             :
      826               assign
      827                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      828               .
      829             end.
      830             for each buf_temp-diasize-handle
      831             on error undo, next
      832             :
      833               assign
      834                 v-object-handle = buf_temp-diasize-handle.handle-value
      835               .
      836               if v-object-handle <> v-diasize-resize-button
      837               then do:
      838                 assign
      839                   v-object-handle :row = buf_temp-diasize-handle.save-position
      840                 .
      841               end.
      842             end.
      843             run diasize_position-resize-button in this-procedure .
      844           end.
      845           assign
      846             v-diasize-change-size = false
      847           .
      848           leave move_block .
      849         end.
      850       end.
      851       assign
      852         v-diasize-need-full-display = true
      853       .
      854       if v-diasize-change-size = false
      855       then do:
      856         assign
      857           v-diasize-change-size = true
      858         .
      859       end.
      860       else do:
      861         return .
      862       end.
      863       assign
      864         v-frame-height = frame Dialog-Frame :height
      865         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      866         v-browse-height = v-diasize-browse-handle :height
      867       .
      868       for each buf_temp-browse-handle
      869         where buf_temp-browse-handle.browse-type = 'height':u
      870       :
      871         assign
      872           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      873         .
      874       end.
      875       for each buf_temp-diasize-handle
      876       :
      877         delete buf_temp-diasize-handle .
      878       end.
      879       assign
      880         v-field-group-handle = frame Dialog-Frame :first-child
      881       .
      882       do while valid-handle(v-field-group-handle)
      883       :
      884         assign
      885           v-object-handle = v-field-group-handle :first-child
      886         .
      887         do while valid-handle(v-object-handle)
      888         :
      889           if  v-object-handle <> v-diasize-browse-handle :handle
      890           and can-query(v-object-handle, "row")
      891           and can-query(v-object-handle, "height")
      892           and ( v-object-handle :row > v-diasize-browse-handle :row )
      893           then do:
      894             find first buf_temp-browse-handle
      895               where buf_temp-browse-handle.browse-type   = 'height':u
      896                 and buf_temp-browse-handle.browse-handle = v-object-handle
      897               no-error .
      898             if available buf_temp-browse-handle
      899             then do:
      900             end.
      901             else do:
      902               create buf_temp-diasize-handle .
      903               assign
      904                 buf_temp-diasize-handle.handle-value  = v-object-handle
      905                 buf_temp-diasize-handle.save-position = v-object-handle :row
      906               .
      907             end.
      908           end.
      909           assign
      910             v-object-handle = v-object-handle :next-sibling
      911           .
      912         end.
      913         assign
      914           v-field-group-handle = v-field-group-handle :next-sibling
      915         .
      916       end.
      917       do with frame Dialog-Frame
      918       :
      919         hide v-diasize-resize-button .
      920         assign
      921           v-diasize-resize-button :row    = 1
      922           v-diasize-resize-button :column = 1
      923         .
      924       end.
      925       if p-change-value > 0
      926       then do:
      927         if frame Dialog-Frame :scrollable = true
      928         then do:
      929           assign
      930             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      931             no-error .
      932           if error-status :error
      933           or error-status :get-message(1) <> ""
      934           then do:
      935             undo move_block, retry move_block .
      936           end.
      937         end.
      938         assign
      939           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      940           no-error .
      941         if error-status :error
      942         or error-status :get-message(1) <> ""
      943         then do:
      944           undo move_block, retry move_block .
      945         end.
      946         assign
      947           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      948           no-error .
      949         if error-status :error
      950         or error-status :get-message(1) <> ""
      951         then do:
      952           undo move_block, retry move_block .
      953         end.
      954         for each buf_temp-browse-handle
      955           where buf_temp-browse-handle.browse-type = 'height':u
      956         on error undo move_block, retry move_block
      957         :
      958           assign
      959             buf_temp-browse-handle.browse-handle :height
      960               = buf_temp-browse-handle.browse-handle :height + p-change-value
      961             no-error .
      962           if error-status :error
      963           or error-status :get-message(1) <> ""
      964           then do:
      965             undo move_block, retry move_block .
      966           end.
      967         end.
      968         for each buf_temp-diasize-handle
      969         on error undo move_block, retry move_block
      970         :
      971           assign
      972             v-object-handle = buf_temp-diasize-handle.handle-value
      973           .
      974           if v-object-handle <> v-diasize-resize-button
      975           then do:
      976             assign
      977               v-object-handle :row = v-object-handle :row + p-change-value
      978               no-error .
      979             if error-status :error
      980             or error-status :get-message(1) <> ""
      981             then do:
      982               undo move_block, retry move_block .
      983             end.
      984           end.
      985         end.
      986       end.
      987       else do:
      988         for each buf_temp-diasize-handle
      989         on error undo move_block, retry move_block
      990         :
      991           assign
      992             v-object-handle = buf_temp-diasize-handle.handle-value
      993           .
      994           if v-object-handle <> v-diasize-resize-button
      995           then do:
      996             assign
      997               v-object-handle :row = v-object-handle :row + p-change-value
      998               no-error .
      999             if error-status :error
     1000             or error-status :get-message(1) <> ""
     1001             then do:
     1002               undo move_block, retry move_block .
     1003             end.
     1004           end.
     1005         end.
     1006         assign
     1007           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1008           no-error .
     1009         if error-status :error
     1010         or error-status :get-message(1) <> ""
     1011         then do:
     1012           undo move_block, retry move_block .
     1013         end.
     1014         for each buf_temp-browse-handle
     1015           where buf_temp-browse-handle.browse-type = 'height':u
     1016         on error undo move_block, retry move_block
     1017         :
     1018           assign
     1019             buf_temp-browse-handle.browse-handle :height
     1020               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1021             no-error .
     1022           if error-status :error
     1023           or error-status :get-message(1) <> ""
     1024           then do:
     1025             undo move_block, retry move_block .
     1026           end.
     1027         end.
     1028         assign
     1029           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1030           no-error .
     1031         if error-status :error
     1032         or error-status :get-message(1) <> ""
     1033         then do:
     1034           undo move_block, retry move_block .
     1035         end.
     1036         if frame Dialog-Frame :scrollable = true
     1037         then do:
     1038           assign
     1039             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1040             no-error .
     1041           if error-status :error
     1042           or error-status :get-message(1) <> ""
     1043           then do:
     1044             undo move_block, retry move_block .
     1045           end.
     1046         end.
     1047       end.
     1048       if p-move-resize = true
     1049       then do:
     1050         run diasize_position-resize-button in this-procedure .
     1051       end.
     1052       if v-diasize-wndstore = true
     1053       then do:
     1054         if connected("ub") = true
     1055         then do:
     1056           define variable v-cntxt-db-num        as integer   no-undo .
     1057           define variable v-cntxt-userid        as character no-undo .
     1058           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1059                                             , OUTPUT v-cntxt-userid
     1060                                             ) .
     1061           run gbl/wndsizew.p
     1062             (input  v-cntxt-db-num
     1063             ,input  v-cntxt-userid
     1064             ,input  v-diasize-proc-name
     1065             ,input  'height':u
     1066             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1067             ) .
     1068         end.
     1069       end.
     1070     end.
     1071     assign
     1072       v-diasize-change-size = false
     1073     .
     1074   end procedure.
     1075   procedure diasize_set-height :
     1076     define input  parameter p-new-height  as decimal   no-undo .
     1077     define input  parameter p-move-resize as logical   no-undo .
     1078     do
     1079     on error undo, return error return-value
     1080     :
     1081       run diasize_change-height in this-procedure
     1082         (input  (p-new-height - frame Dialog-Frame :height)
     1083         ,input  p-move-resize
     1084         ) .
     1085     end.
     1086   end procedure.
     1087   procedure diasize_change-width :
     1088     define input  parameter p-change-value as decimal   no-undo .
     1089     define input  parameter p-move-resize  as logical   no-undo .
     1090     define variable v-field-group-handle   as handle    no-undo .
     1091     define variable v-object-handle        as handle    no-undo .
     1092     define variable v-frame-width          as decimal   no-undo .
     1093     define variable v-frame-virtual-width  as decimal   no-undo .
     1094     define variable v-browse-width         as decimal   no-undo .
     1095     define variable v-window-width         as decimal   no-undo .
     1096     define variable v-window-virtual-width as decimal   no-undo .
     1097     define variable v-change-sign          as integer   no-undo .
     1098     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1099     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1100     if p-change-value > 0
     1101     then do:
     1102       if frame Dialog-Frame :width + p-change-value >
     1103           session :width-chars
     1104       then do:
     1105         assign
     1106           p-change-value = session :width-chars - frame Dialog-Frame :width
     1107         .
     1108         if p-change-value <= 0
     1109         then do:
     1110           run diasize_position-resize-button in this-procedure .
     1111           return .
     1112         end.
     1113       end.
     1114     end.
     1115     if p-change-value < 0
     1116     then do:
     1117       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1118       then do:
     1119         assign
     1120           p-change-value = v-diasize-orig-frame-width
     1121                          - frame Dialog-Frame :width
     1122         .
     1123         if p-change-value >= 0
     1124         then do:
     1125           run diasize_position-resize-button in this-procedure .
     1126           return .
     1127         end.
     1128       end.
     1129     end.
     1130     if p-change-value >= 0
     1131     then do:
     1132       assign
     1133         v-change-sign = 1
     1134       .
     1135     end.
     1136     else do:
     1137       assign
     1138         v-change-sign = -1
     1139       .
     1140     end.
     1141     assign
     1142       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1143     .
     1144     if p-change-value = 0
     1145     then do:
     1146       run diasize_position-resize-button in this-procedure .
     1147       return .
     1148     end.
     1149     move_block:
     1150     do
     1151     on error undo move_block, leave move_block
     1152     :
     1153       if retry
     1154       then do:
     1155         do
     1156         on error undo move_block, leave move_block
     1157         :
     1158           if p-change-value > 0
     1159           then do:
     1160             for each buf_temp-diasize-handle
     1161             on error undo, next
     1162             :
     1163               assign
     1164                 v-object-handle = buf_temp-diasize-handle.handle-value
     1165               .
     1166               if v-object-handle <> v-diasize-resize-button
     1167               then do:
     1168                 assign
     1169                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1170                 .
     1171               end.
     1172             end.
     1173             assign
     1174               v-diasize-browse-handle :width = v-browse-width
     1175             .
     1176             for each buf_temp-browse-handle
     1177               where buf_temp-browse-handle.browse-type = 'width':u
     1178             on error undo, next
     1179             :
     1180               assign
     1181                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1182               .
     1183             end.
     1184             assign
     1185               frame Dialog-Frame :width = v-frame-width
     1186             .
     1187             if frame Dialog-Frame :scrollable = true
     1188             then do:
     1189               assign
     1190                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1191               .
     1192             end.
     1193             run diasize_position-resize-button in this-procedure .
     1194           end.
     1195           else do:
     1196             if frame Dialog-Frame :scrollable = true
     1197             then do:
     1198               assign
     1199                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1200               .
     1201             end.
     1202             assign
     1203               frame Dialog-Frame :width = v-frame-width
     1204             .
     1205             for each buf_temp-browse-handle
     1206               where buf_temp-browse-handle.browse-type = 'width':u
     1207             on error undo, next
     1208             :
     1209               assign
     1210                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1211               .
     1212             end.
     1213             assign
     1214               v-diasize-browse-handle :width = v-browse-width
     1215             .
     1216             for each buf_temp-diasize-handle
     1217             on error undo, next
     1218             :
     1219               assign
     1220                 v-object-handle = buf_temp-diasize-handle.handle-value
     1221               .
     1222               if v-object-handle <> v-diasize-resize-button
     1223               then do:
     1224                 assign
     1225                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1226                 .
     1227               end.
     1228             end.
     1229             run diasize_position-resize-button in this-procedure .
     1230           end.
     1231           assign
     1232             v-diasize-change-size = false
     1233           .
     1234           leave move_block .
     1235         end.
     1236       end.
     1237       assign
     1238         v-diasize-need-full-display = true
     1239       .
     1240       if v-diasize-change-size = false
     1241       then do:
     1242         assign
     1243           v-diasize-change-size = true
     1244         .
     1245       end.
     1246       else do:
     1247         return .
     1248       end.
     1249       assign
     1250         v-frame-width = frame Dialog-Frame :width
     1251         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1252         v-browse-width = v-diasize-browse-handle :width
     1253       .
     1254       for each buf_temp-browse-handle
     1255         where buf_temp-browse-handle.browse-type = 'width':u
     1256       :
     1257         assign
     1258           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1259         .
     1260       end.
     1261       for each buf_temp-diasize-handle
     1262       :
     1263         delete buf_temp-diasize-handle .
     1264       end.
     1265       assign
     1266         v-field-group-handle = frame Dialog-Frame :first-child
     1267       .
     1268       do while valid-handle(v-field-group-handle)
     1269       :
     1270         assign
     1271           v-object-handle = v-field-group-handle :first-child
     1272         .
     1273         do while valid-handle(v-object-handle)
     1274         :
     1275           if  v-object-handle <> v-diasize-browse-handle :handle
     1276           and v-object-handle <> v-diasize-resize-button
     1277           and can-query(v-object-handle, "row")
     1278           and can-query(v-object-handle, "height")
     1279           and ( v-object-handle :col + v-object-handle :width
     1280                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1281               )
     1282           then do:
     1283             find first buf_temp-browse-handle
     1284               where buf_temp-browse-handle.browse-type   = 'width':u
     1285                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1286               no-error .
     1287             if available buf_temp-browse-handle
     1288             then do:
     1289             end.
     1290             else do:
     1291               create buf_temp-diasize-handle .
     1292               assign
     1293                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1294                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1295               .
     1296             end.
     1297           end.
     1298           assign
     1299             v-object-handle = v-object-handle :next-sibling
     1300           .
     1301         end.
     1302         assign
     1303           v-field-group-handle = v-field-group-handle :next-sibling
     1304         .
     1305       end.
     1306       do with frame Dialog-Frame
     1307       :
     1308         hide v-diasize-resize-button .
     1309         v-diasize-resize-button :row = 1.
     1310         v-diasize-resize-button :column = 1.
     1311       end.
     1312       if p-change-value > 0
     1313       then do:
     1314         if frame Dialog-Frame :scrollable = true
     1315         then do:
     1316           assign
     1317             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1318             no-error .
     1319           if error-status :error
     1320           or error-status :get-message(1) <> ""
     1321           then do:
     1322             undo move_block, retry move_block.
     1323           end.
     1324         end.
     1325         assign
     1326           frame Dialog-Frame :width = v-frame-width + p-change-value
     1327           no-error .
     1328         if error-status :error
     1329         or error-status :get-message(1) <> ""
     1330         then do:
     1331           undo move_block, retry move_block.
     1332         end.
     1333         assign
     1334           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1335         no-error .
     1336         if error-status :error
     1337         or error-status :get-message(1) <> ""
     1338         then do:
     1339           undo move_block, retry move_block.
     1340         end.
     1341         for each buf_temp-browse-handle
     1342           where buf_temp-browse-handle.browse-type = 'width':u
     1343         on error undo move_block, retry move_block
     1344         :
     1345           assign
     1346             buf_temp-browse-handle.browse-handle :width
     1347               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1348             no-error .
     1349           if error-status :error
     1350           or error-status :get-message(1) <> ""
     1351           then do:
     1352             undo move_block, retry move_block .
     1353           end.
     1354         end.
     1355         for each buf_temp-diasize-handle
     1356         on error undo move_block, retry move_block
     1357         :
     1358           assign
     1359             v-object-handle = buf_temp-diasize-handle.handle-value
     1360           .
     1361           if v-object-handle <> v-diasize-resize-button
     1362           then do:
     1363             assign
     1364               v-object-handle :col = v-object-handle :col + p-change-value
     1365               no-error .
     1366             if error-status :error
     1367             or error-status :get-message(1) <> ""
     1368             then do:
     1369               undo move_block, retry move_block .
     1370             end.
     1371           end.
     1372         end.
     1373       end.
     1374       else do:
     1375         for each buf_temp-diasize-handle
     1376         on error undo move_block, retry move_block
     1377         :
     1378           assign
     1379             v-object-handle = buf_temp-diasize-handle.handle-value
     1380           .
     1381           if v-object-handle <> v-diasize-resize-button
     1382           then do:
     1383             assign
     1384               v-object-handle :col = v-object-handle :col + p-change-value
     1385               no-error .
     1386             if error-status :error
     1387             or error-status :get-message(1) <> ""
     1388             then do:
     1389               undo move_block, retry move_block .
     1390             end.
     1391           end.
     1392         end.
     1393         for each buf_temp-browse-handle
     1394           where buf_temp-browse-handle.browse-type = 'width':u
     1395         on error undo move_block, retry move_block
     1396         :
     1397           assign
     1398             buf_temp-browse-handle.browse-handle :width
     1399               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1400             no-error .
     1401           if error-status :error
     1402           or error-status :get-message(1) <> ""
     1403           then do:
     1404             undo move_block, retry move_block .
     1405           end.
     1406         end.
     1407         assign
     1408           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1409           no-error .
     1410         if error-status :error
     1411         or error-status :get-message(1) <> ""
     1412         then do:
     1413           undo move_block, retry move_block.
     1414         end.
     1415         assign
     1416           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1417         no-error .
     1418         if error-status :error
     1419         or error-status :get-message(1) <> ""
     1420         then do:
     1421           undo move_block, retry move_block.
     1422         end.
     1423         if frame Dialog-Frame :scrollable = true
     1424         then do:
     1425           assign
     1426             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1427           no-error .
     1428           if error-status :error
     1429           or error-status :get-message(1) <> ""
     1430           then do:
     1431             undo move_block, retry move_block.
     1432           end.
     1433         end.
     1434       end.
     1435       if p-move-resize
     1436       then do:
     1437         run diasize_position-resize-button in this-procedure .
     1438       end.
     1439       if v-diasize-wndstore = true
     1440       then do:
     1441         if connected("ub") = true
     1442         then do:
     1443           define variable v-cntxt-db-num        as integer   no-undo .
     1444           define variable v-cntxt-userid        as character no-undo .
     1445           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1446                                             , OUTPUT v-cntxt-userid
     1447                                             ) .
     1448           run gbl/wndsizew.p
     1449             (input  v-cntxt-db-num
     1450             ,input  v-cntxt-userid
     1451             ,input  v-diasize-proc-name
     1452             ,input  'width':u
     1453             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1454             ) .
     1455         end.
     1456       end.
     1457     end.
     1458     assign
     1459       v-diasize-change-size = false
     1460     .
     1461   end procedure.
     1462   procedure diasize_set-width :
     1463     define input  parameter p-new-width  as decimal   no-undo .
     1464     define input  parameter p-move-resize as logical   no-undo .
     1465     do
     1466     on error undo, return error return-value
     1467     :
     1468       run diasize_change-width in this-procedure
     1469         (input  (p-new-width - frame Dialog-Frame :width)
     1470         ,input  p-move-resize
     1471         ) .
     1472     end.
     1473   end procedure.
     1474   procedure diasize_position-resize-button :
     1475     do with frame Dialog-Frame
     1476     :
     1477       hide v-diasize-resize-button .
     1478       assign
     1479         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1480                     - 1
     1481                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1482         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1483                     - 1
     1484                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1485       .
     1486       view v-diasize-resize-button .
     1487     end.
     1488   end procedure.
     1489   on alt-right anywhere
     1490   do:
     1491     run diasize_change-width in this-procedure
     1492       (input 1
     1493       ,input true
     1494       ) .
     1495     return no-apply .
     1496   end.
     1497   on alt-left anywhere
     1498   do:
     1499     run diasize_change-width in this-procedure
     1500       (input -1
     1501       ,input true
     1502       ) .
     1503     return no-apply .
     1504   end.
     1505   on alt-down anywhere
     1506   do:
     1507     run diasize_change-height in this-procedure
     1508       (input 1
     1509       ,input true
     1510       ) .
     1511     return no-apply .
     1512   end.
     1513   on alt-up anywhere
     1514   do:
     1515     run diasize_change-height in this-procedure
     1516       (input -1
     1517       ,input true
     1518       ) .
     1519     return no-apply .
     1520   end.
     1521   on alt-enter of frame Dialog-Frame
     1522   do:
     1523     run diasize_maximize in this-procedure
     1524       (input  ?
     1525       ).
     1526     return no-apply .
     1527   end.
     1528   procedure diasize_end-move :
     1529     do
     1530     on error undo, return error return-value
     1531     :
     1532       define variable v-row-delta as decimal   no-undo .
     1533       define variable v-col-delta as decimal   no-undo .
     1534       define variable v-new-row as decimal   no-undo .
     1535       define variable v-new-col as decimal   no-undo .
     1536       assign
     1537         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1538         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1539       .
     1540       assign
     1541         v-row-delta = v-new-row - frame Dialog-Frame :height
     1542         v-col-delta = v-new-col - frame Dialog-Frame :width
     1543       .
     1544       run diasize_change-height in this-procedure
     1545         (input v-row-delta
     1546         ,input true
     1547         ) .
     1548       run diasize_change-width in this-procedure
     1549         (input v-col-delta
     1550         ,input true
     1551         ) .
     1552     end.
     1553   end procedure.
     1554   procedure diasize_maximize :
     1555     define input  parameter p-action as logical   no-undo .
     1556     do
     1557     on error undo, return error return-value
     1558     :
     1559       if p-action = ?
     1560       then do:
     1561         if v-diasize-need-maximize = true
     1562         then do:
     1563           assign
     1564             p-action = true
     1565           .
     1566         end.
     1567         else do:
     1568           assign
     1569             p-action = false
     1570           .
     1571         end.
     1572       end.
     1573       if p-action = true
     1574       then do:
     1575         run diasize_change-height in this-procedure
     1576           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1577               - frame Dialog-Frame :height-chars
     1578           ,input true
     1579           ) .
     1580         run diasize_change-width in this-procedure
     1581           (input session :width-chars
     1582               - frame Dialog-Frame :width-chars
     1583           ,input true
     1584           ) .
     1585         assign
     1586           v-diasize-need-maximize = false
     1587         .
     1588       end.
     1589       else do:
     1590         run diasize_change-width in this-procedure
     1591           (input v-diasize-orig-frame-width
     1592               - frame Dialog-Frame :width-chars
     1593           ,input true
     1594           ) .
     1595         run diasize_change-height in this-procedure
     1596           (input v-diasize-orig-frame-height
     1597               - frame Dialog-Frame :height-chars
     1598           ,input true
     1599           ) .
     1600         assign
     1601           v-diasize-need-maximize = true
     1602         .
     1603       end.
     1604     end.
     1605   end procedure.
     1606   procedure diasize_restore-orig-size :
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610       assign
     1611         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1612         v-diasize-current-frame-height = frame Dialog-Frame :height
     1613       .
     1614       run diasize_set-height in this-procedure
     1615         (input  v-diasize-orig-frame-height
     1616         ,input  true
     1617         ) .
     1618       run diasize_set-width in this-procedure
     1619         (input  v-diasize-orig-frame-width
     1620         ,input  true
     1621         ) .
     1622     end.
     1623   end procedure.
     1624   procedure diasize_restore-current-size :
     1625     do
     1626     on error undo, return error return-value
     1627     :
     1628       run diasize_set-height in this-procedure
     1629         (input  v-diasize-current-frame-height
     1630         ,input  true
     1631         ) .
     1632       run diasize_set-width in this-procedure
     1633         (input  v-diasize-current-frame-width
     1634         ,input  true
     1635         ) .
     1636     end.
     1637   end procedure.
     1638   procedure diasize_set-browse-handle :
     1639     define input  parameter p-browse-handle as handle   no-undo .
     1640     define buffer buf_temp-browse-handle for temp-browse-handle .
     1641     do
     1642     on error undo, return error return-value
     1643     :
     1644       assign
     1645         v-diasize-browse-handle = p-browse-handle
     1646       .
     1647       for each buf_temp-browse-handle
     1648       on error undo, return error return-value
     1649       :
     1650         delete buf_temp-browse-handle .
     1651       end.
     1652     end.
     1653   end procedure.
     1654   procedure diasize_add_browse :
     1655     define input  parameter p-browse-type   as character no-undo .
     1656     define input  parameter p-browse-handle as handle    no-undo .
     1657     define buffer buf_temp-browse-handle for temp-browse-handle .
     1658     do
     1659     on error undo, return error return-value
     1660     :
     1661       assign
     1662         v-diasize-browse-number = v-diasize-browse-number + 1
     1663       .
     1664       create buf_temp-browse-handle .
     1665       assign
     1666         buf_temp-browse-handle.browse-type   = p-browse-type
     1667         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1668         buf_temp-browse-handle.browse-handle = p-browse-handle
     1669       .
     1670     end.
     1671   end procedure.
     1672   procedure diasize_init :
     1673     define variable v-default-value    as logical   no-undo .
     1674     define variable v-restore-saved    as logical   no-undo .
     1675     define variable v-resize-value-str as character no-undo .
     1676     do
     1677     on error undo, return error return-value
     1678     :
     1679       do with frame Dialog-Frame
     1680       :
     1681         assign
     1682           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1683           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1684           v-diasize-browse-handle     = browse br-dis-rule :handle
     1685         .
     1686         create button v-diasize-resize-button
     1687         assign
     1688           parent        = frame Dialog-Frame :first-child
     1689           label         = "s"
     1690           height-pixels = 16
     1691           width-pixels  = 16
     1692           visible       = true
     1693           sensitive     = true
     1694           movable       = true
     1695           triggers:
     1696             on end-move persistent run diasize_end-move in this-procedure .
     1697           end triggers.
     1698         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1699         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1700         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1701         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1702         assign
     1703           v-diasize-wndmax = false
     1704         .
     1705         if connected("ub") = true
     1706         then do:
     1707           define variable v-cntxt-db-num        as integer   no-undo .
     1708           define variable v-cntxt-userid        as character no-undo .
     1709           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1710                                             , OUTPUT v-cntxt-userid
     1711                                             ) .
     1712           run gbl/wndpar_r.p
     1713             (input  v-cntxt-db-num
     1714             ,input  v-cntxt-userid
     1715             ,input  'wndmax':U
     1716             ,output v-diasize-wndmax
     1717             ,output v-default-value
     1718             ) .
     1719         end.
     1720         assign
     1721           v-diasize-wndstore = false
     1722         .
     1723         if connected("ub") = true
     1724         then do:
     1725           run gbl/wndpar_r.p
     1726             (input  v-cntxt-db-num
     1727             ,input  v-cntxt-userid
     1728             ,input  'wndstore':U
     1729             ,output v-diasize-wndstore
     1730             ,output v-default-value
     1731             ) .
     1732         end.
     1733         assign
     1734           v-diasize-proc-name = entry(1, program-name(2), '.')
     1735         .
     1736         if v-diasize-wndstore = true
     1737         then do:
     1738           assign
     1739             v-restore-saved = false
     1740           .
     1741           if connected("ub") = true
     1742           then do:
     1743             run gbl/wndsizer.p
     1744               (input  v-cntxt-db-num
     1745               ,input  v-cntxt-userid
     1746               ,input  v-diasize-proc-name
     1747               ,input  'height':u
     1748               ,output v-resize-value-str
     1749               ) .
     1750             if v-resize-value-str <> '':U
     1751             then do:
     1752               run diasize_change-height in this-procedure
     1753                 (input  integer(v-resize-value-str)
     1754                 ,input  true
     1755                 ) .
     1756               assign
     1757                 v-restore-saved = true
     1758               .
     1759             end.
     1760           end.
     1761           if connected("ub") = true
     1762           then do:
     1763             run gbl/wndsizer.p
     1764               (input  v-cntxt-db-num
     1765               ,input  v-cntxt-userid
     1766               ,input  v-diasize-proc-name
     1767               ,input  'width':u
     1768               ,output v-resize-value-str
     1769               ) .
     1770             if v-resize-value-str <> '':U
     1771             then do:
     1772               run diasize_change-width in this-procedure
     1773                 (input  integer(v-resize-value-str)
     1774                 ,input  true
     1775                 ) .
     1776               assign
     1777                 v-restore-saved = true
     1778               .
     1779             end.
     1780           end.
     1781           if v-restore-saved <> true
     1782           then do:
     1783             if v-diasize-wndmax = true
     1784             then do:
     1785               run diasize_maximize in this-procedure
     1786                 (input  true
     1787                 ) .
     1788             end.
     1789           end.
     1790         end.
     1791         else do:
     1792           if v-diasize-wndmax = true
     1793           then do:
     1794             run diasize_maximize in this-procedure
     1795               (input  true
     1796               ) .
     1797           end.
     1798         end.
     1799       end.
     1800     end.
     1801   end procedure.
     1802   procedure diasize_need-full-display :
     1803     define output parameter p-need-full-display as logical   no-undo .
     1804     do
     1805     on error undo, return error return-value
     1806     :
     1807       assign
     1808         p-need-full-display = v-diasize-need-full-display
     1809       .
     1810       assign
     1811         v-diasize-need-full-display = false
     1812       .
     1813     end.
     1814   end procedure.
     1815   procedure get-context :
     1816      define output parameter p-db-num as integer          no-undo.
     1817      define output parameter p-user-id as character        no-undo.
     1818      define variable v-login               as character    no-undo.
     1819      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1820      define buffer buf_user-login  for ub.user-login .
     1821      do
     1822      on error undo, return error
     1823      :
     1824            FIND FIRST buf_sys-ctrl no-lock.
     1825            ASSIGN
     1826               v-login = USERID("ub")
     1827               p-db-num = buf_sys-ctrl.db-num
     1828            .
     1829            FIND FIRST buf_user-login
     1830                 WHERE buf_user-login.db-num = p-db-num
     1831                   AND buf_user-login.user-login = v-login
     1832                 no-lock
     1833                 no-error
     1834                 .
     1835            IF AVAILABLE buf_user-login
     1836            THEN DO:
     1837               assign
     1838                  p-user-id = buf_user-login.user-id
     1839               .
     1840            END.
     1841      end.
     1842   end procedure.
     1843       run diasize_init in this-procedure .
     1844   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1845   on F2 of frame Dialog-Frame anywhere do:
     1846     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     1847     return no-apply.
     1848   end.
     1849   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1850   on F3 of frame Dialog-Frame anywhere do:
     1851     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1852     return no-apply.
     1853   end.
     1854   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1855   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1856     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     1857     return no-apply.
     1858   end.
     1859   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1860   on F4 of frame Dialog-Frame anywhere do:
     1861     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     1862     return no-apply.
     1863   end.
     1864   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1865   on F8 of frame Dialog-Frame anywhere do:
     1866     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     1867     return no-apply.
     1868   end.
     1869   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1870   on INS of frame Dialog-Frame anywhere do:
     1871     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1872     return no-apply.
     1873   end.
     1874   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1875   on F2 of frame Dialog-Frame anywhere do:
     1876     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1877     return no-apply.
     1878   end.
     1879   MAIN-BLOCK:
     1880   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1881      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1882   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1883     run mainmenu_getcntxt in parparentproc
     1884       (output v-cntxt-db-num
     1885       ,output v-cntxt-userid
     1886       ,output v-cntxt-level
     1887       ,output v-cntxt-host-code-obj
     1888       ,output v-cntxt-obj-type
     1889       ,output v-cntxt-obj-code
     1890       ,output v-cntxt-db-num-obj
     1891       ,output v-cntxt-is-admin
     1892       ) .
     1893     v-rid-list = p-rid-list.
     1894     RUN Myenable IN THIS-PROCEDURE .
     1895     run openbr in this-procedure .
     1896     APPLY "ENTRY" to br-dis-rule.
     1897     WAIT-FOR GO OF FRAME Dialog-Frame.
     1898   END.
     1899   RUN disable_UI.
     1900   PROCEDURE disable_UI :
     1901     HIDE FRAME Dialog-Frame.
     1902   END PROCEDURE.
     1903   PROCEDURE enable_UI :
     1904     DISPLAY mark-num
     1905         WITH FRAME Dialog-Frame.
     1906     ENABLE b-quit b-mark b-sel b-add b-copy b-chg b-del b-lkp B-Help br-dis-rule
     1907            mark-num
     1908         WITH FRAME Dialog-Frame.
     1909     VIEW FRAME Dialog-Frame.
     1910   END PROCEDURE.
     1911   PROCEDURE MyEnable :
     1912   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1913   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     1914   ch = br-dis-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     1915   DO ii = 1 TO br-dis-rule:NUM-COLUMNS IN FRAME Dialog-Frame:
     1916       ASSIGN
     1917       ch:RESIZABLE = YES.
     1918       ch = ch:NEXT-COLUMN.
     1919   END.
     1920   DISPLAY mark-num
     1921   WITH FRAME Dialog-Frame.
     1922   ENABLE
     1923   b-quit
     1924   B-add WHEn (v-cntxt-db-num = 0)
     1925   B-copy WHEn (v-cntxt-db-num = 0)
     1926   B-chg WHEn (v-cntxt-db-num = 0)
     1927   B-del WHEn (v-cntxt-db-num = 0)
     1928   B-mark WHEn LOOKUP("b-mark", bttns) > 0
     1929   B-sel WHEN LOOKUP("b-sel", bttns) > 0
     1930   B-Help
     1931   b-lkp
     1932   br-dis-rule
     1933   mark-num
     1934   WITH FRAME Dialog-Frame.
     1935   VIEW FRAME Dialog-Frame.
     1936   HIDE
     1937   mark-num
     1938   IN FRAME Dialog-Frame.
     1939   END PROCEDURE.
     1940   PROCEDURE openbr :
     1941   OPEN QUERY br-dis-rule
     1942   FOR EACH X_dis-rule NO-LOCK WHERE X_dis-rule.rule-num <= 99999 INDEXED-REPOSITION.
     1943   END PROCEDURE.
     1944   FUNCTION rule-name RETURNS CHARACTER
     1945     ( INPUT p-subject AS character, input p-discnt-role AS character ) :
     1946   DEFINE VARIABLE v-rule-name AS CHARACTER NO-UNDO.
     1947   CASE p-subject :
     1948     WHEN 'dis-gds-rule':U THEN DO:
     1949       v-rule-name = entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1950     END.
     1951     WHEN 'dis-thbj-rule':U THEN DO:
     1952       v-rule-name = entry (lookup (p-discnt-role, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u).
     1953     END.
     1954     WHEN 'dis-cp-rule':U THEN DO:
     1955       v-rule-name = entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u).
     1956     END.
     1957     WHEN 'dis-dc-rule':U THEN DO:
     1958       v-rule-name = entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u).
     1959     END.
     1960     WHEN 'dis-dct-rule':U THEN DO:
     1961       v-rule-name = entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u).
     1962     END.
     1963     WHEN 'dis-grp-rule':U THEN DO:
     1964       v-rule-name = entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u).
     1965     END.
     1966   END CASE.
     1967   RETURN v-RULE-name.
     1968   END FUNCTION.
