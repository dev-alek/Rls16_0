        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "обновление болванки".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input  parameter iLogHandel as handle no-undo.
       63   define input  parameter iConPar as character no-undo.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable mAsyncProc as class ibs.th.file.AsyncProc.
       69   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       70   define variable mstopAsunc as logical no-undo.
       71   function StopCheck returns logical:
       72      define variable oFlag as logical no-undo.
       73      run StopCheckAsync (output oFlag).
       74      return oFlag.
       75   end.
       76   procedure StopCheckAsync:
       77       define output  parameter oFlag as logical no-undo.
       78       if mstopAsunc
       79       then
       80          oFlag = mstopAsunc.
       81       else do:
       82          oFlag = mAsyncProc:CheckStop().
       83          mstopAsunc = oFlag.
       84       end.
       85   end.
       86   function GetParamAsunc returns character
       87   (input iNumPar as integer  ):
       88      return mAsyncProc:GetPARAM(iNumPar).
       89   end.
       90   function GetParamAsuncStr returns ibs.th.file.asyncparam
       91   (input iParamName as character ):
       92      return mAsyncProc:GetPARAM(iParamName).
       93   end.
       94   procedure PutMesAsunc:
       95       define input  parameter Itext as character no-undo.
       96       define variable vflag as logical no-undo.
       97       Publish "WriteLogAsunc" (Itext, yes)  .
       98   end.
       99   procedure PutMesAsuncNoTime:
      100       define input  parameter Itext as character no-undo.
      101       define variable vflag as logical no-undo.
      102       Publish "WriteLogAsunc" (Itext,no)  .
      103   end.
      104   procedure PutStatAsunc:
      105       define input  parameter Itext as character no-undo.
      106       Publish "PutStatAsunc" (Itext,no) .
      107        run
      108       PutMesAsunc (itext).
      109   end.
      110   procedure PutStatAsuncNoTime:
      111       define input  parameter Itext as character no-undo.
      112       Publish "PutStatAsunc" (Itext,no)  .
      113        run
      114       PutMesAsuncNoTime (itext).
      115   end.
      116   procedure PutStatAsuncAdd:
      117       define input  parameter Itext as character no-undo.
      118       Publish "PutStatAsunc" (Itext,yes)  .
      119   end.
      120   procedure PutFileLogAsunc:
      121       define input  parameter IFile as character no-undo.
      122       Publish "PutFileLogAsunc" (ifile)  .
      123   end.
      124          mAsyncProc:mProcPublish = this-procedure.
      125   run PutStatAsunc (substitute("Запущен процес обновления БД. " )).
      126   define variable updschmObj as class ibs.th.adm.upd.updschm no-undo.
      127   updschmObj = new ibs.th.adm.upd.updschm (input iconpar,input "updblank",this-procedure) no-error.
      128   if error-status:error
      129   then do:
      130      run PutStatAsunc (substitute("error   Не удалось обновить структуру БД. &1 &2 &3 ", error-status:get-message(1),  error-status:get-message(2 ),  program-name( 1 ) )).
      131   end.
      132   else if updschmObj:IsErr
      133   then do:
      134      run PutStatAsunc (substitute("error   Не удалось обновить структуру БД. &1 &2 ", updschmObj:Msg, program-name( 1 ) )).
      135      delete object updschmObj no-error.
      136   end.
      137   else if updschmObj:isNeedUpd
      138   then do:
      139      updschmObj:upddbshm().
      140      if updschmObj:IsErr
      141      then do:
      142         run PutStatAsunc (substitute("error Не удалось обновить структуру БД. &1", updschmObj:Msg )).
      143         delete object updschmObj no-error.
      144      end.
      145      else if updschmObj:isUpdShm
      146      then do:
      147         run PutStatAsunc (substitute("БД обновлена. " )).
      148      end.
      149      else do:
      150         run PutStatAsunc (substitute("error Ошика при обновлении БД. &1",updschmObj:Msg )).
      151      end.
      152   end.
      153   else do:
      154      if updschmObj:CurrDBShm > updschmObj:TargetDBShm
      155      then do:
      156         run PutStatAsunc (substitute("error Версия базы &1 больше версии в сборке &2 ",updschmObj:CurrDBShm , updschmObj:TargetDBShm)).
      157      end.
      158      else
      159         run PutStatAsunc (substitute("error Обновление не требуется.")).
      160   end.
