      144   id
      145   line
      146   index isdone
      147   done
      148   .
      149   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      150   define  temp-table temp-host no-undo
      151     field host-code like ub.store.host-code
      152     index xpk host-code
      153   .
      154   define  temp-table temp-obj no-undo
      155     field obj-type  like ub.clients.obj-type
      156     field obj-code  like ub.clients.obj-code
      157     field host-code like ub.store.host-code
      158     field db-num    like ub.clients.db-num
      159     index xpk  obj-type obj-code
      160     index xie1 host-code
      161     index xie2 db-num host-code
      162   .
      163   procedure init-temphost:
      164     define buffer buf_store   for ub.store .
      165     define buffer buf_shop    for ub.shop .
      166     define buffer buf_clients for ub.clients .
      167     define buffer buf_db for ub.db .
      168     define buffer buf_temp-host for temp-host .
      169     define buffer buf_temp-obj for temp-obj .
      170     do
      171     on error undo, return error return-value
      172     :
      173       for each buf_store
      174       on error undo, return error
      175       :
      176         find first buf_temp-host
      177           where buf_temp-host.host-code = buf_store.host-code
      178           no-error .
      179         if not available buf_temp-host
      180         then do:
      181           create buf_temp-host .
      182           assign
      183             buf_temp-host.host-code = buf_store.host-code
      184           .
      185         end.
      186         find first buf_clients no-lock
      187           where buf_clients.obj-type = 'скл':U
      188             and buf_clients.obj-code = buf_store.obj-code
      189           no-error .
      190         if not available buf_clients
      191         then do:
      192           message
      193             "Ошибка при поиске клиента" skip
      194             "Клиент" 'скл':U buf_store.obj-code skip
      195             view-as alert-box error .
      196           undo, return error .
      197         end.
      198         create buf_temp-obj .
      199         assign
      200           buf_temp-obj.obj-type  = 'скл':U
      201           buf_temp-obj.obj-code  = buf_store.obj-code
      202           buf_temp-obj.host-code = buf_store.host-code
      203           buf_temp-obj.db-num    = buf_clients.db-num
      204         .
      205       end.
      206       for each buf_shop
      207       on error undo, return error
      208       :
      209         find first buf_temp-host
      210           where buf_temp-host.host-code = buf_shop.host-code
      211           no-error .
      212         if not available buf_temp-host
      213         then do:
      214           create buf_temp-host .
      215           assign
      216             buf_temp-host.host-code = buf_shop.host-code
      217           .
      218         end.
      219         find first buf_clients no-lock
      220           where buf_clients.obj-type = 'маг':U
      221             and buf_clients.obj-code = buf_shop.obj-code
      222           no-error .
      223         if not available buf_clients then do:
      224           message
      225             "Ошибка при поиске клиента" skip
      226             "Клиент" 'маг':U buf_shop.obj-code skip
      227             view-as alert-box error .
      228           undo, return error .
      229         end.
      230         create buf_temp-obj .
      231         assign
      232           buf_temp-obj.obj-type  = 'маг':U
      233           buf_temp-obj.obj-code  = buf_shop.obj-code
      234           buf_temp-obj.host-code = buf_shop.host-code
      235           buf_temp-obj.db-num    = buf_clients.db-num
      236         .
      237       end.
      238     end.
      239   end.
      240   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241     define variable v-cntxt-db-num        as integer   no-undo .
      242     define variable v-cntxt-userid        as character no-undo .
      243     define variable v-cntxt-level         as character no-undo .
      244     define variable v-cntxt-host-code-obj as integer   no-undo .
      245     define variable v-cntxt-obj-type      as character no-undo .
      246     define variable v-cntxt-obj-code      as integer   no-undo .
      247     define variable v-cntxt-db-num-obj    as integer   no-undo .
      248     define variable v-cntxt-is-admin      as logical   no-undo .
      249   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   define temp-table userobjs_temp-user-obj no-undo
      251     field obj-type as character
      252     field obj-code as integer
      253     index xpk is primary unique obj-type obj-code
      254     .
      255   procedure userobjs_clear :
      256     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      257     do
      258     on error undo, return error return-value
      259     :
      260       for each buf_userobjs_temp-user-obj
      261       on error undo, return error return-value
      262       :
      263         delete buf_userobjs_temp-user-obj .
      264       end.
      265     end.
      266   end .
      267   procedure userobjs_object-count :
      268     define output parameter p-total-count as integer   no-undo .
      269     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      270     do
      271     on error undo, return error return-value
      272     :
      273       assign
      274         p-total-count = 0
      275       .
      276       for each buf_userobjs_temp-user-obj
      277       on error undo, return error return-value
      278       :
      279         assign
      280           p-total-count = p-total-count + 1
      281         .
      282       end.
      283     end.
      284   end.
      285   procedure userobjs_append :
      286      define input  parameter p-obj-type as character no-undo .
      287      define input  parameter p-obj-code as integer   no-undo .
      288     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      289     do
      290     on error undo, return error return-value
      291     :
      292       find first buf_userobjs_temp-user-obj
      293         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      294           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      295         no-error .
      296       if not available buf_userobjs_temp-user-obj
      297       then do:
      298         create buf_userobjs_temp-user-obj .
      299         assign
      300           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      301           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      302         .
      303       end.
      304     end.
      305   end.
      306   procedure userobjs_object-exist :
      307     define output parameter p-object-exist as logical   no-undo .
      308     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      309     do
      310     on error undo, return error return-value
      311     :
      312       find first buf_userobjs_temp-user-obj
      313         no-error .
      314       if not available buf_userobjs_temp-user-obj
      315       then do:
      316         assign
      317           p-object-exist = false
      318         .
      319       end.
      320       else do:
      321         assign
      322           p-object-exist = true
      323         .
      324       end.
      325     end.
      326   end.
      327   procedure userobjs_transfer :
      328     define input  parameter p-callback-handle as handle no-undo .
      329     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      330     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      331     do
      332     on error undo, return error return-value
      333     :
      334       if valid-handle(p-callback-handle) <> true
      335       then do:
      336         message
      337           vss-workfile vss-revision vss-description skip
      338           "Ошибка задания входных параметров" skip
      339           "Неизвестный указатель на процедуру" skip
      340           view-as alert-box error .
      341         undo, return error return-value .
      342       end.
      343       if p-callback-handle :get-signature("userobjs_append") = ""
      344       then do:
      345         message
      346           vss-workfile vss-revision vss-description skip
      347           "Ошибка задания входных параметров" skip
      348           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      349                     ,p-callback-handle :file-name
      350                     ) skip
      351           view-as alert-box error .
      352         undo, return error return-value .
      353       end.
      354       for each buf_userobjs_temp-user-obj
      355       on error undo, return error return-value
      356       :
      357         run userobjs_append in p-callback-handle
      358           (input  buf_userobjs_temp-user-obj.obj-type
      359           ,input  buf_userobjs_temp-user-obj.obj-code
      360           ) .
      361       end.
      362     end.
      363   end procedure.
      364   procedure userobjs_select-one :
      365      define input  parameter parparentproc     as widget-handle no-undo .
      366      define input  parameter p-db-num          as integer   no-undo .
      367      define input  parameter p-user-id         as character no-undo .
      368      define input  parameter p-host-code-obj   as integer   no-undo .
      369      define input  parameter p-obj-type        as character no-undo .
      370      define input  parameter p-obj-code        as integer   no-undo .
      371      define output parameter p-user-select     as logical   no-undo .
      372      define output parameter p-select-obj-type as character no-undo .
      373      define output parameter p-select-obj-code as character no-undo .
      374     do
      375     on error undo, return error return-value
      376     :
      377       run gbl/userobjs.w
      378         (input  parparentproc
      379         ,input  this-procedure :handle
      380         ,input  p-db-num
      381         ,input  p-user-id
      382         ,input  p-host-code-obj
      383         ,input  p-obj-type
      384         ,input  p-obj-code
      385         ,INPUT  "b-sel"
      386         ,output p-user-select
      387         ,output p-select-obj-type
      388         ,output p-select-obj-code
      389         ) .
      390     end.
      391   end.
      392   procedure userobjs_select-many :
      393     define input  parameter parparentproc   as widget-handle no-undo .
      394     define input  parameter p-db-num        as integer   no-undo .
      395     define input  parameter p-user-id       as character no-undo .
      396     define input  parameter p-host-code-obj as integer   no-undo .
      397     define input  parameter p-obj-type      as character no-undo .
      398     define input  parameter p-obj-code      as integer   no-undo .
      399     define output parameter p-user-select   as logical   no-undo .
      400     define variable v-select-obj-type as character no-undo .
      401     define variable v-select-obj-code as integer   no-undo .
      402     do
      403     on error undo, return error return-value
      404     :
      405       run gbl/userobjs.w
      406         (input  parparentproc
      407         ,input  this-procedure :handle
      408         ,input  p-db-num
      409         ,input  p-user-id
      410         ,input  p-host-code-obj
      411         ,input  p-obj-type
      412         ,input  p-obj-code
      413         ,INPUT  "b-sel,b-mark"
      414         ,output p-user-select
      415         ,output v-select-obj-type
