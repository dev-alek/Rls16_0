      420   procedure thobjs :
      421      define input        parameter parparentproc     as widget-handle no-undo .
      422      define input        parameter i-bttns           as character     no-undo .
      423      define input        parameter i-list-mode       as character     no-undo.
      424      define input        parameter i-obj-type        as character     no-undo.
      425      define input        parameter i-db-num          as integer       no-undo.
      426      define input        parameter i-host-code       as integer       no-undo.
