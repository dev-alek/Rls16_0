      438   define temp-table temp_goods no-undo
      439       field gds-code          as integer
      440       field artic             as character
      441       field prod-type         as character
      442       field prod-code         as integer
      443       field gds-name          as character
      444       field unit-base         as character
      445       field is-cd             as character
      446       field is-menu           as character
      447       field is-modificator    as character
      448       field is-null-price     as character
      449       field is-season         as character
      450       field is-semi-finished  as character
      451       field fbr-obj-type      as character
      452       field fbr-obj-code      as integer
      453       index pi is primary unique
      454           gds-code
      455       index ar
      456           artic
      457           prod-type
      458           prod-code
      459       index nm
      460           gds-name
      461       index unit
      462           unit-base
      463   .
      464   DEFINE BUTTON b-exit
      465        LABEL "&Выход"
      466        SIZE 10 BY 1
      467        BGCOLOR 8 .
      468   DEFINE BUTTON b-goods
      469        LABEL "&Товары"
      470        SIZE 10 BY 1.
      471   DEFINE BUTTON b-help
      472        LABEL "Помощ&ь"
      473        SIZE 10 BY 1
      474        BGCOLOR 8 .
      475   DEFINE BUTTON bt-attr
      476        LABEL "&Атрибуты"
      477        SIZE 10 BY 1.
      478   DEFINE BUTTON bt-set-obj
      479        LABEL "..."
      480        SIZE 4.63 BY .79.
      481   DEFINE BUTTON bt-set1
      482        LABEL "+-"
      483        SIZE 3.5 BY .79.
      484   DEFINE BUTTON bt-set2
      485        LABEL "+-"
      486        SIZE 3.5 BY .79.
      487   DEFINE BUTTON bt-set3
      488        LABEL "+-"
      489        SIZE 3.5 BY .79.
      490   DEFINE BUTTON bt-set4
      491        LABEL "+-"
      492        SIZE 3.5 BY .79.
      493   DEFINE BUTTON bt-set5
      494        LABEL "+-"
      495        SIZE 3.5 BY .79.
      496   DEFINE BUTTON bt-set6
      497        LABEL "+-"
      498        SIZE 3.5 BY .79.
      499   DEFINE VARIABLE rs-range AS INTEGER
      500        VIEW-AS RADIO-SET VERTICAL
      501        RADIO-BUTTONS
      502             "По фирме", 1,
      503   "Глобально", 2
      504        SIZE 16.5 BY 2 NO-UNDO.
      505   DEFINE QUERY br-table FOR
      506         temp_goods SCROLLING.
      507   DEFINE BROWSE br-table
      508     QUERY br-table NO-LOCK DISPLAY
      509         temp_goods.artic format "X(17)" column-label "Артикул"
      510       temp_goods.gds-name format "X(39)" column-label "Наименование товара"
      511       temp_goods.unit-base format "X(3)" column-label "ЕИ"
      512       temp_goods.is-cd format "X(1)" column-label "кас"
      513       temp_goods.is-menu format "X(1)" column-label "блю"
      514       temp_goods.is-modificator format "X(1)" column-label "мод"
      515       temp_goods.is-null-price format "X(1)" column-label "цен"
      516       temp_goods.is-season format "X(1)" column-label "сез"
      517       temp_goods.is-semi-finished format "X(1)" column-label "плф"
      518       temp_goods.fbr-obj-type format "X(3)" column-label "тип"
      519       temp_goods.fbr-obj-code format ">>>>9" column-label "код кух"
      520       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.88 BY 20.33.
      521   DEFINE FRAME Dialog-Frame
      522        b-exit AT ROW 1 COL 1.63
      523        b-goods AT ROW 1 COL 11.63
      524        bt-attr AT ROW 1 COL 25.25
      525        rs-range AT ROW 1 COL 42.5 NO-LABEL
      526        b-help AT ROW 1 COL 88.63
      527        bt-set1 AT ROW 2.21 COL 62.38
      528        bt-set2 AT ROW 2.21 COL 65.88
      529        bt-set3 AT ROW 2.21 COL 69.38
      530        bt-set4 AT ROW 2.21 COL 72.88
      531        bt-set5 AT ROW 2.21 COL 76.38
      532        bt-set6 AT ROW 2.21 COL 79.88
      533        bt-set-obj AT ROW 2.21 COL 83.38
      534        br-table AT ROW 3 COL 1.63
      535        SPACE(0.46) SKIP(0.20)
      536       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      537            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      538            TITLE "Атрибуты товаров производства".
      539   ASSIGN
      540          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      541          FRAME Dialog-Frame:HIDDEN           = TRUE.
      542   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      543   DO:
      544     APPLY "END-ERROR":U TO SELF.
      545   END.
      546   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      547   DO:
      548       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      549   END.
      550   ON CHOOSE OF b-goods IN FRAME Dialog-Frame
      551   DO:
      552       define variable v-gds-list-not-empty    as logical        no-undo.
      553       define buffer buf_goods         for goods.
      554       define buffer buf_temp_goods    for temp_goods.
      555       define buffer buf_fbr-gds-obj   for fbr-gds-obj.
      556       for each gds-list
      557       :
      558           delete gds-list.
      559       end.
      560       for each buf_temp_goods
      561       :
      562           find first buf_goods no-lock
      563                where buf_goods.gds-code = buf_temp_goods.gds-code
      564           .
      565           create gds-list.
      566           buffer-copy buf_goods to gds-list.
      567       end.
      568       run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
      569       for each buf_temp_goods
      570       :
      571           delete buf_temp_goods.
      572       end.
      573       for each gds-list
      574       :
      575           run create-temp-goods in this-procedure (
      576                 input gds-list.gds-code
      577               , input gds-list.artic
      578               , input gds-list.prod-type
      579               , input gds-list.prod-code
      580               , input gds-list.gds-name
      581               , input gds-list.unit-base
      582               , output v-gds-list-not-empty
      583           ).
      584       end.
      585       if v-gds-list-not-empty = yes
      586       then do:
      587           enable
      588               bt-attr
      589               bt-set1
      590               bt-set2
      591               bt-set3
      592               bt-set4
      593               bt-set5
      594               bt-set6
      595               bt-set-obj
      596           with frame Dialog-Frame.
      597       end.
      598       else do:
      599           disable
      600               bt-attr
      601               bt-set1
      602               bt-set2
      603               bt-set3
      604               bt-set4
      605               bt-set5
      606               bt-set6
      607               bt-set-obj
      608           with frame Dialog-Frame.
      609       end.
      610       OPEN QUERY br-table FOR EACH temp_goods NO-LOCK.
      611   END.
      612   ON CHOOSE OF bt-attr IN FRAME Dialog-Frame
      613   DO:
      614       define variable v-attr-list as character  no-undo.
      615       define variable v-recid     as recid      no-undo.
      616       define variable v-updated   as logical    no-undo .
      617       run ref/fgdsobji.w (
      618             input parparentproc
      619           , input 'template':U
      620           , input ( if available temp_goods then temp_goods.gds-code else 0 )
      621           , input v-cntxt-obj-type
      622           , input v-cntxt-obj-code
      623           , input no
      624           , input-output v-attr-list
      625           , output v-updated
      626           , input-output v-recid
      627       ).
      628       if v-attr-list = '':U
      629       then do:
      630           undo, return no-apply.
      631       end.
      632       else do:
      633           define variable v-yesno    as logical        no-undo.
      634           message
      635               skip "Для всех товаров списка"
      636               skip "будут установлены атрибуты:"
      637               skip(1)
      638               skip "Тип объекта кухни:"                entry( 7, v-attr-list )
      639               skip "Код объекта кухни:"                entry( 8, v-attr-list )
      640               skip "Является блюдом:"                  entry( 2, v-attr-list )
      641               skip "Является полуфабрикатом:"          entry( 6, v-attr-list )
      642               skip "Применять сезонный коэффициент:"   entry( 5, v-attr-list )
      643               skip "Модификатор блюда:"                entry( 3, v-attr-list )
      644               skip "Без цены:"                         entry( 4, v-attr-list )
      645               skip "Отправлять на кассу ресторана:"    entry( 1, v-attr-list )
      646               skip(1)
      647               skip "Назначить атрибуты всем товарам списка?"
      648           view-as alert-box question
      649           buttons yes-no
      650           title "Изменение атрибутов товаров списка"
      651           update v-yesno.
      652           if v-yesno = yes
      653           then do:
      654   if session :set-wait-state( "compiler" ) then.
      655               run set-attr in this-procedure (
      656                   input v-attr-list
      657               ) no-error.
      658               if error-status :error
      659               then do:
      660                   message
      661                            vss-workfile vss-revision vss-description
      662                       skip "Ошибка установки атрибутов на объекте."
      663                       skip return-value
      664                       skip trim(error-status :get-message(1))
      665                            trim(error-status :get-message(2))
      666                            trim(error-status :get-message(3))
      667                   view-as alert-box error.
      668                   undo, return no-apply .
      669               end.
      670   if session :set-wait-state( "" ) then.
      671               OPEN QUERY br-table FOR EACH temp_goods NO-LOCK.
      672           end.
      673           else do:
      674               undo, return no-apply.
      675           end.
      676       end.
      677   END.
