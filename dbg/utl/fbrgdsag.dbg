     1106     index xie browse-type browse-handle
     1107   .
     1108   procedure diasize_change-height :
     1109     define input  parameter p-change-value  as decimal   no-undo .
     1110     define input  parameter p-move-resize   as logical   no-undo .
     1111     define variable v-field-group-handle    as handle    no-undo .
     1112     define variable v-object-handle         as handle    no-undo .
     1113     define variable v-frame-height          as decimal   no-undo .
     1114     define variable v-frame-virtual-height  as decimal   no-undo .
     1115     define variable v-browse-height         as decimal   no-undo .
     1116     define variable v-window-height         as decimal   no-undo .
     1117     define variable v-window-virtual-height as decimal   no-undo .
     1118     define variable v-change-sign           as integer   no-undo .
     1119     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1120     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1121     if p-change-value > 0
     1122     then do:
     1123       if frame Dialog-Frame :height + p-change-value
     1124           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1125       then do:
     1126         assign
     1127           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1128                           - (frame Dialog-Frame :height-chars)
     1129         .
     1130         if p-change-value <= 0
     1131         then do:
     1132           run diasize_position-resize-button in this-procedure .
     1133           return .
     1134         end.
     1135       end.
     1136     end.
     1137     if p-change-value < 0
     1138     then do:
     1139       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1140       then do:
     1141         assign
     1142           p-change-value = v-diasize-orig-frame-height
     1143                          - (frame Dialog-Frame :height-chars)
     1144         .
     1145         if p-change-value >= 0
     1146         then do:
     1147           run diasize_position-resize-button in this-procedure .
     1148           return .
     1149         end.
     1150       end.
     1151     end.
     1152     if p-change-value >= 0
     1153     then do:
     1154       assign
     1155         v-change-sign = 1
     1156       .
     1157     end.
     1158     else do:
     1159       assign
     1160         v-change-sign = -1
     1161       .
     1162     end.
     1163     assign
     1164       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1165     .
     1166     if p-change-value = 0
     1167     then do:
     1168       run diasize_position-resize-button in this-procedure .
     1169       return .
     1170     end.
     1171     move_block:
     1172     do
     1173     on error undo move_block, retry move_block
     1174     :
     1175       if retry
     1176       then do:
     1177         do
     1178         on error undo move_block, leave move_block
     1179         :
     1180           if p-change-value > 0
     1181           then do:
     1182             for each buf_temp-diasize-handle
     1183             on error undo, next
     1184             :
     1185               assign
     1186                 v-object-handle = buf_temp-diasize-handle.handle-value
     1187               .
     1188               if v-object-handle <> v-diasize-resize-button
     1189               then do:
     1190                 assign
     1191                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1192                 .
     1193               end.
     1194             end.
     1195             assign
     1196               v-diasize-browse-handle :height = v-browse-height
     1197             .
     1198             for each buf_temp-browse-handle
     1199               where buf_temp-browse-handle.browse-type = 'height':u
     1200             on error undo, next
     1201             :
     1202               assign
     1203                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1204               .
     1205             end.
     1206             assign
     1207               frame Dialog-Frame :height = v-frame-height
     1208             .
     1209             if frame Dialog-Frame :scrollable = true
     1210             then do:
     1211               assign
     1212                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1213               .
     1214             end.
     1215             run diasize_position-resize-button in this-procedure .
     1216           end.
     1217           else do:
     1218             if frame Dialog-Frame :scrollable = true
     1219             then do:
     1220               assign
     1221                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1222               .
     1223             end.
     1224             assign
     1225               frame Dialog-Frame :height = v-frame-height
     1226             .
     1227             assign
     1228               v-diasize-browse-handle :height = v-browse-height
     1229             .
     1230             for each buf_temp-browse-handle
     1231               where buf_temp-browse-handle.browse-type = 'height':u
     1232             on error undo, next
     1233             :
     1234               assign
     1235                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1236               .
     1237             end.
     1238             for each buf_temp-diasize-handle
     1239             on error undo, next
     1240             :
     1241               assign
     1242                 v-object-handle = buf_temp-diasize-handle.handle-value
     1243               .
     1244               if v-object-handle <> v-diasize-resize-button
     1245               then do:
     1246                 assign
     1247                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1248                 .
     1249               end.
     1250             end.
     1251             run diasize_position-resize-button in this-procedure .
     1252           end.
     1253           assign
     1254             v-diasize-change-size = false
     1255           .
     1256           leave move_block .
     1257         end.
     1258       end.
     1259       assign
     1260         v-diasize-need-full-display = true
     1261       .
     1262       if v-diasize-change-size = false
     1263       then do:
     1264         assign
     1265           v-diasize-change-size = true
     1266         .
     1267       end.
     1268       else do:
     1269         return .
     1270       end.
     1271       assign
     1272         v-frame-height = frame Dialog-Frame :height
     1273         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1274         v-browse-height = v-diasize-browse-handle :height
     1275       .
     1276       for each buf_temp-browse-handle
     1277         where buf_temp-browse-handle.browse-type = 'height':u
     1278       :
     1279         assign
     1280           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1281         .
     1282       end.
     1283       for each buf_temp-diasize-handle
     1284       :
     1285         delete buf_temp-diasize-handle .
     1286       end.
     1287       assign
     1288         v-field-group-handle = frame Dialog-Frame :first-child
     1289       .
     1290       do while valid-handle(v-field-group-handle)
     1291       :
     1292         assign
     1293           v-object-handle = v-field-group-handle :first-child
     1294         .
     1295         do while valid-handle(v-object-handle)
     1296         :
     1297           if  v-object-handle <> v-diasize-browse-handle :handle
     1298           and can-query(v-object-handle, "row")
     1299           and can-query(v-object-handle, "height")
     1300           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1301           then do:
     1302             find first buf_temp-browse-handle
     1303               where buf_temp-browse-handle.browse-type   = 'height':u
     1304                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1305               no-error .
     1306             if available buf_temp-browse-handle
     1307             then do:
     1308             end.
     1309             else do:
     1310               create buf_temp-diasize-handle .
     1311               assign
     1312                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1313                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1314               .
     1315             end.
     1316           end.
     1317           assign
     1318             v-object-handle = v-object-handle :next-sibling
     1319           .
     1320         end.
     1321         assign
     1322           v-field-group-handle = v-field-group-handle :next-sibling
     1323         .
     1324       end.
     1325       do with frame Dialog-Frame
     1326       :
     1327         hide v-diasize-resize-button .
     1328         assign
     1329           v-diasize-resize-button :row    = 1
     1330           v-diasize-resize-button :column = 1
     1331         .
     1332       end.
     1333       if p-change-value > 0
     1334       then do:
     1335         if frame Dialog-Frame :scrollable = true
     1336         then do:
     1337           assign
     1338             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1339             no-error .
     1340           if error-status :error
     1341           or error-status :get-message(1) <> ""
     1342           then do:
     1343             undo move_block, retry move_block .
     1344           end.
     1345         end.
     1346         assign
     1347           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1348           no-error .
     1349         if error-status :error
     1350         or error-status :get-message(1) <> ""
     1351         then do:
     1352           undo move_block, retry move_block .
     1353         end.
     1354         assign
     1355           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1356           no-error .
     1357         if error-status :error
     1358         or error-status :get-message(1) <> ""
     1359         then do:
     1360           undo move_block, retry move_block .
     1361         end.
     1362         for each buf_temp-browse-handle
     1363           where buf_temp-browse-handle.browse-type = 'height':u
     1364         on error undo move_block, retry move_block
     1365         :
     1366           assign
     1367             buf_temp-browse-handle.browse-handle :height
     1368               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1369             no-error .
     1370           if error-status :error
     1371           or error-status :get-message(1) <> ""
     1372           then do:
     1373             undo move_block, retry move_block .
     1374           end.
     1375         end.
     1376         for each buf_temp-diasize-handle
     1377         on error undo move_block, retry move_block
     1378         :
     1379           assign
     1380             v-object-handle = buf_temp-diasize-handle.handle-value
     1381           .
     1382           if v-object-handle <> v-diasize-resize-button
     1383           then do:
     1384             assign
     1385               v-object-handle :row = v-object-handle :row + p-change-value
     1386               no-error .
     1387             if error-status :error
     1388             or error-status :get-message(1) <> ""
     1389             then do:
     1390               undo move_block, retry move_block .
     1391             end.
     1392           end.
     1393         end.
     1394       end.
     1395       else do:
     1396         for each buf_temp-diasize-handle
     1397         on error undo move_block, retry move_block
     1398         :
     1399           assign
     1400             v-object-handle = buf_temp-diasize-handle.handle-value
     1401           .
     1402           if v-object-handle <> v-diasize-resize-button
     1403           then do:
     1404             assign
     1405               v-object-handle :row = v-object-handle :row + p-change-value
     1406               no-error .
     1407             if error-status :error
     1408             or error-status :get-message(1) <> ""
     1409             then do:
     1410               undo move_block, retry move_block .
     1411             end.
     1412           end.
     1413         end.
     1414         assign
     1415           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1416           no-error .
     1417         if error-status :error
     1418         or error-status :get-message(1) <> ""
     1419         then do:
     1420           undo move_block, retry move_block .
     1421         end.
     1422         for each buf_temp-browse-handle
     1423           where buf_temp-browse-handle.browse-type = 'height':u
     1424         on error undo move_block, retry move_block
     1425         :
     1426           assign
     1427             buf_temp-browse-handle.browse-handle :height
     1428               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1429             no-error .
     1430           if error-status :error
     1431           or error-status :get-message(1) <> ""
     1432           then do:
     1433             undo move_block, retry move_block .
     1434           end.
     1435         end.
     1436         assign
     1437           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1438           no-error .
     1439         if error-status :error
     1440         or error-status :get-message(1) <> ""
     1441         then do:
     1442           undo move_block, retry move_block .
     1443         end.
     1444         if frame Dialog-Frame :scrollable = true
     1445         then do:
     1446           assign
     1447             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1448             no-error .
     1449           if error-status :error
     1450           or error-status :get-message(1) <> ""
     1451           then do:
     1452             undo move_block, retry move_block .
     1453           end.
     1454         end.
     1455       end.
     1456       if p-move-resize = true
     1457       then do:
     1458         run diasize_position-resize-button in this-procedure .
     1459       end.
     1460       if v-diasize-wndstore = true
     1461       then do:
     1462         if connected("ub") = true
     1463         then do:
     1464           define variable v-cntxt-db-num        as integer   no-undo .
     1465           define variable v-cntxt-userid        as character no-undo .
     1466           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1467                                             , OUTPUT v-cntxt-userid
     1468                                             ) .
     1469           run gbl/wndsizew.p
     1470             (input  v-cntxt-db-num
     1471             ,input  v-cntxt-userid
     1472             ,input  v-diasize-proc-name
     1473             ,input  'height':u
     1474             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1475             ) .
     1476         end.
     1477       end.
     1478     end.
     1479     assign
     1480       v-diasize-change-size = false
     1481     .
     1482   end procedure.
     1483   procedure diasize_set-height :
     1484     define input  parameter p-new-height  as decimal   no-undo .
     1485     define input  parameter p-move-resize as logical   no-undo .
     1486     do
     1487     on error undo, return error return-value
     1488     :
     1489       run diasize_change-height in this-procedure
     1490         (input  (p-new-height - frame Dialog-Frame :height)
     1491         ,input  p-move-resize
     1492         ) .
     1493     end.
     1494   end procedure.
     1495   procedure diasize_change-width :
     1496     define input  parameter p-change-value as decimal   no-undo .
     1497     define input  parameter p-move-resize  as logical   no-undo .
     1498     define variable v-field-group-handle   as handle    no-undo .
     1499     define variable v-object-handle        as handle    no-undo .
     1500     define variable v-frame-width          as decimal   no-undo .
     1501     define variable v-frame-virtual-width  as decimal   no-undo .
     1502     define variable v-browse-width         as decimal   no-undo .
     1503     define variable v-window-width         as decimal   no-undo .
     1504     define variable v-window-virtual-width as decimal   no-undo .
     1505     define variable v-change-sign          as integer   no-undo .
     1506     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1507     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1508     if p-change-value > 0
     1509     then do:
     1510       if frame Dialog-Frame :width + p-change-value >
     1511           session :width-chars
     1512       then do:
     1513         assign
     1514           p-change-value = session :width-chars - frame Dialog-Frame :width
     1515         .
     1516         if p-change-value <= 0
     1517         then do:
     1518           run diasize_position-resize-button in this-procedure .
     1519           return .
     1520         end.
     1521       end.
     1522     end.
     1523     if p-change-value < 0
     1524     then do:
     1525       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1526       then do:
     1527         assign
     1528           p-change-value = v-diasize-orig-frame-width
     1529                          - frame Dialog-Frame :width
     1530         .
     1531         if p-change-value >= 0
     1532         then do:
     1533           run diasize_position-resize-button in this-procedure .
     1534           return .
     1535         end.
     1536       end.
     1537     end.
     1538     if p-change-value >= 0
     1539     then do:
     1540       assign
     1541         v-change-sign = 1
     1542       .
     1543     end.
     1544     else do:
     1545       assign
     1546         v-change-sign = -1
     1547       .
     1548     end.
     1549     assign
     1550       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1551     .
     1552     if p-change-value = 0
     1553     then do:
     1554       run diasize_position-resize-button in this-procedure .
     1555       return .
     1556     end.
     1557     move_block:
     1558     do
     1559     on error undo move_block, leave move_block
     1560     :
     1561       if retry
     1562       then do:
     1563         do
     1564         on error undo move_block, leave move_block
     1565         :
     1566           if p-change-value > 0
     1567           then do:
     1568             for each buf_temp-diasize-handle
     1569             on error undo, next
     1570             :
     1571               assign
     1572                 v-object-handle = buf_temp-diasize-handle.handle-value
     1573               .
     1574               if v-object-handle <> v-diasize-resize-button
     1575               then do:
     1576                 assign
     1577                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1578                 .
     1579               end.
     1580             end.
     1581             assign
     1582               v-diasize-browse-handle :width = v-browse-width
     1583             .
     1584             for each buf_temp-browse-handle
     1585               where buf_temp-browse-handle.browse-type = 'width':u
     1586             on error undo, next
     1587             :
     1588               assign
     1589                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1590               .
     1591             end.
     1592             assign
     1593               frame Dialog-Frame :width = v-frame-width
     1594             .
     1595             if frame Dialog-Frame :scrollable = true
     1596             then do:
     1597               assign
     1598                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1599               .
     1600             end.
     1601             run diasize_position-resize-button in this-procedure .
     1602           end.
     1603           else do:
     1604             if frame Dialog-Frame :scrollable = true
     1605             then do:
     1606               assign
     1607                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1608               .
     1609             end.
     1610             assign
     1611               frame Dialog-Frame :width = v-frame-width
     1612             .
     1613             for each buf_temp-browse-handle
     1614               where buf_temp-browse-handle.browse-type = 'width':u
     1615             on error undo, next
     1616             :
     1617               assign
     1618                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1619               .
     1620             end.
     1621             assign
     1622               v-diasize-browse-handle :width = v-browse-width
     1623             .
     1624             for each buf_temp-diasize-handle
     1625             on error undo, next
     1626             :
     1627               assign
     1628                 v-object-handle = buf_temp-diasize-handle.handle-value
     1629               .
     1630               if v-object-handle <> v-diasize-resize-button
     1631               then do:
     1632                 assign
     1633                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1634                 .
     1635               end.
     1636             end.
     1637             run diasize_position-resize-button in this-procedure .
     1638           end.
     1639           assign
     1640             v-diasize-change-size = false
     1641           .
     1642           leave move_block .
     1643         end.
     1644       end.
     1645       assign
     1646         v-diasize-need-full-display = true
     1647       .
     1648       if v-diasize-change-size = false
     1649       then do:
     1650         assign
     1651           v-diasize-change-size = true
     1652         .
     1653       end.
     1654       else do:
     1655         return .
     1656       end.
     1657       assign
     1658         v-frame-width = frame Dialog-Frame :width
     1659         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1660         v-browse-width = v-diasize-browse-handle :width
     1661       .
     1662       for each buf_temp-browse-handle
     1663         where buf_temp-browse-handle.browse-type = 'width':u
     1664       :
     1665         assign
     1666           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1667         .
     1668       end.
     1669       for each buf_temp-diasize-handle
     1670       :
     1671         delete buf_temp-diasize-handle .
     1672       end.
     1673       assign
     1674         v-field-group-handle = frame Dialog-Frame :first-child
     1675       .
     1676       do while valid-handle(v-field-group-handle)
     1677       :
     1678         assign
     1679           v-object-handle = v-field-group-handle :first-child
     1680         .
     1681         do while valid-handle(v-object-handle)
     1682         :
     1683           if  v-object-handle <> v-diasize-browse-handle :handle
     1684           and v-object-handle <> v-diasize-resize-button
     1685           and can-query(v-object-handle, "row")
     1686           and can-query(v-object-handle, "height")
     1687           and ( v-object-handle :col + v-object-handle :width
     1688                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1689               )
     1690           then do:
     1691             find first buf_temp-browse-handle
     1692               where buf_temp-browse-handle.browse-type   = 'width':u
     1693                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1694               no-error .
     1695             if available buf_temp-browse-handle
     1696             then do:
     1697             end.
     1698             else do:
     1699               create buf_temp-diasize-handle .
     1700               assign
     1701                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1702                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1703               .
     1704             end.
     1705           end.
     1706           assign
     1707             v-object-handle = v-object-handle :next-sibling
     1708           .
     1709         end.
     1710         assign
     1711           v-field-group-handle = v-field-group-handle :next-sibling
     1712         .
     1713       end.
     1714       do with frame Dialog-Frame
     1715       :
     1716         hide v-diasize-resize-button .
     1717         v-diasize-resize-button :row = 1.
     1718         v-diasize-resize-button :column = 1.
     1719       end.
     1720       if p-change-value > 0
     1721       then do:
     1722         if frame Dialog-Frame :scrollable = true
     1723         then do:
     1724           assign
     1725             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1726             no-error .
     1727           if error-status :error
     1728           or error-status :get-message(1) <> ""
     1729           then do:
     1730             undo move_block, retry move_block.
     1731           end.
     1732         end.
     1733         assign
     1734           frame Dialog-Frame :width = v-frame-width + p-change-value
     1735           no-error .
     1736         if error-status :error
     1737         or error-status :get-message(1) <> ""
     1738         then do:
     1739           undo move_block, retry move_block.
     1740         end.
     1741         assign
     1742           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1743         no-error .
     1744         if error-status :error
     1745         or error-status :get-message(1) <> ""
     1746         then do:
     1747           undo move_block, retry move_block.
     1748         end.
     1749         for each buf_temp-browse-handle
     1750           where buf_temp-browse-handle.browse-type = 'width':u
     1751         on error undo move_block, retry move_block
     1752         :
     1753           assign
     1754             buf_temp-browse-handle.browse-handle :width
     1755               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1756             no-error .
     1757           if error-status :error
     1758           or error-status :get-message(1) <> ""
     1759           then do:
     1760             undo move_block, retry move_block .
     1761           end.
     1762         end.
     1763         for each buf_temp-diasize-handle
     1764         on error undo move_block, retry move_block
     1765         :
     1766           assign
     1767             v-object-handle = buf_temp-diasize-handle.handle-value
     1768           .
     1769           if v-object-handle <> v-diasize-resize-button
     1770           then do:
     1771             assign
     1772               v-object-handle :col = v-object-handle :col + p-change-value
     1773               no-error .
     1774             if error-status :error
     1775             or error-status :get-message(1) <> ""
     1776             then do:
     1777               undo move_block, retry move_block .
     1778             end.
     1779           end.
     1780         end.
     1781       end.
     1782       else do:
     1783         for each buf_temp-diasize-handle
     1784         on error undo move_block, retry move_block
     1785         :
     1786           assign
     1787             v-object-handle = buf_temp-diasize-handle.handle-value
     1788           .
     1789           if v-object-handle <> v-diasize-resize-button
     1790           then do:
     1791             assign
     1792               v-object-handle :col = v-object-handle :col + p-change-value
     1793               no-error .
     1794             if error-status :error
     1795             or error-status :get-message(1) <> ""
     1796             then do:
     1797               undo move_block, retry move_block .
     1798             end.
     1799           end.
     1800         end.
     1801         for each buf_temp-browse-handle
     1802           where buf_temp-browse-handle.browse-type = 'width':u
     1803         on error undo move_block, retry move_block
     1804         :
     1805           assign
     1806             buf_temp-browse-handle.browse-handle :width
     1807               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1808             no-error .
     1809           if error-status :error
     1810           or error-status :get-message(1) <> ""
     1811           then do:
     1812             undo move_block, retry move_block .
     1813           end.
     1814         end.
     1815         assign
     1816           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1817           no-error .
     1818         if error-status :error
     1819         or error-status :get-message(1) <> ""
     1820         then do:
     1821           undo move_block, retry move_block.
     1822         end.
     1823         assign
     1824           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1825         no-error .
     1826         if error-status :error
     1827         or error-status :get-message(1) <> ""
     1828         then do:
     1829           undo move_block, retry move_block.
     1830         end.
     1831         if frame Dialog-Frame :scrollable = true
     1832         then do:
     1833           assign
     1834             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1835           no-error .
     1836           if error-status :error
     1837           or error-status :get-message(1) <> ""
     1838           then do:
     1839             undo move_block, retry move_block.
     1840           end.
     1841         end.
     1842       end.
     1843       if p-move-resize
     1844       then do:
     1845         run diasize_position-resize-button in this-procedure .
     1846       end.
     1847       if v-diasize-wndstore = true
     1848       then do:
     1849         if connected("ub") = true
     1850         then do:
     1851           define variable v-cntxt-db-num        as integer   no-undo .
     1852           define variable v-cntxt-userid        as character no-undo .
     1853           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1854                                             , OUTPUT v-cntxt-userid
     1855                                             ) .
     1856           run gbl/wndsizew.p
     1857             (input  v-cntxt-db-num
     1858             ,input  v-cntxt-userid
     1859             ,input  v-diasize-proc-name
     1860             ,input  'width':u
     1861             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1862             ) .
     1863         end.
     1864       end.
     1865     end.
     1866     assign
     1867       v-diasize-change-size = false
     1868     .
     1869   end procedure.
     1870   procedure diasize_set-width :
     1871     define input  parameter p-new-width  as decimal   no-undo .
     1872     define input  parameter p-move-resize as logical   no-undo .
     1873     do
     1874     on error undo, return error return-value
     1875     :
     1876       run diasize_change-width in this-procedure
     1877         (input  (p-new-width - frame Dialog-Frame :width)
     1878         ,input  p-move-resize
     1879         ) .
     1880     end.
     1881   end procedure.
     1882   procedure diasize_position-resize-button :
     1883     do with frame Dialog-Frame
     1884     :
     1885       hide v-diasize-resize-button .
     1886       assign
     1887         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1888                     - 1
     1889                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1890         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1891                     - 1
     1892                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1893       .
     1894       view v-diasize-resize-button .
     1895     end.
     1896   end procedure.
     1897   on alt-right anywhere
     1898   do:
     1899     run diasize_change-width in this-procedure
     1900       (input 1
     1901       ,input true
     1902       ) .
     1903     return no-apply .
     1904   end.
     1905   on alt-left anywhere
     1906   do:
     1907     run diasize_change-width in this-procedure
     1908       (input -1
     1909       ,input true
     1910       ) .
     1911     return no-apply .
     1912   end.
     1913   on alt-down anywhere
     1914   do:
     1915     run diasize_change-height in this-procedure
     1916       (input 1
     1917       ,input true
     1918       ) .
     1919     return no-apply .
     1920   end.
     1921   on alt-up anywhere
     1922   do:
     1923     run diasize_change-height in this-procedure
     1924       (input -1
     1925       ,input true
     1926       ) .
     1927     return no-apply .
     1928   end.
     1929   on alt-enter of frame Dialog-Frame
     1930   do:
     1931     run diasize_maximize in this-procedure
     1932       (input  ?
     1933       ).
     1934     return no-apply .
     1935   end.
     1936   procedure diasize_end-move :
     1937     do
     1938     on error undo, return error return-value
     1939     :
     1940       define variable v-row-delta as decimal   no-undo .
     1941       define variable v-col-delta as decimal   no-undo .
     1942       define variable v-new-row as decimal   no-undo .
     1943       define variable v-new-col as decimal   no-undo .
     1944       assign
     1945         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1946         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1947       .
     1948       assign
     1949         v-row-delta = v-new-row - frame Dialog-Frame :height
     1950         v-col-delta = v-new-col - frame Dialog-Frame :width
     1951       .
     1952       run diasize_change-height in this-procedure
     1953         (input v-row-delta
     1954         ,input true
     1955         ) .
     1956       run diasize_change-width in this-procedure
     1957         (input v-col-delta
     1958         ,input true
     1959         ) .
     1960     end.
     1961   end procedure.
     1962   procedure diasize_maximize :
     1963     define input  parameter p-action as logical   no-undo .
     1964     do
     1965     on error undo, return error return-value
     1966     :
     1967       if p-action = ?
     1968       then do:
     1969         if v-diasize-need-maximize = true
     1970         then do:
     1971           assign
     1972             p-action = true
     1973           .
     1974         end.
     1975         else do:
     1976           assign
     1977             p-action = false
     1978           .
     1979         end.
     1980       end.
     1981       if p-action = true
     1982       then do:
     1983         run diasize_change-height in this-procedure
     1984           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1985               - frame Dialog-Frame :height-chars
     1986           ,input true
     1987           ) .
     1988         run diasize_change-width in this-procedure
     1989           (input session :width-chars
     1990               - frame Dialog-Frame :width-chars
     1991           ,input true
     1992           ) .
     1993         assign
     1994           v-diasize-need-maximize = false
     1995         .
     1996       end.
     1997       else do:
     1998         run diasize_change-width in this-procedure
     1999           (input v-diasize-orig-frame-width
     2000               - frame Dialog-Frame :width-chars
     2001           ,input true
     2002           ) .
     2003         run diasize_change-height in this-procedure
     2004           (input v-diasize-orig-frame-height
     2005               - frame Dialog-Frame :height-chars
     2006           ,input true
     2007           ) .
     2008         assign
     2009           v-diasize-need-maximize = true
     2010         .
     2011       end.
     2012     end.
     2013   end procedure.
     2014   procedure diasize_restore-orig-size :
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       assign
     2019         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2020         v-diasize-current-frame-height = frame Dialog-Frame :height
     2021       .
     2022       run diasize_set-height in this-procedure
     2023         (input  v-diasize-orig-frame-height
     2024         ,input  true
     2025         ) .
     2026       run diasize_set-width in this-procedure
     2027         (input  v-diasize-orig-frame-width
     2028         ,input  true
     2029         ) .
     2030     end.
     2031   end procedure.
     2032   procedure diasize_restore-current-size :
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       run diasize_set-height in this-procedure
     2037         (input  v-diasize-current-frame-height
     2038         ,input  true
     2039         ) .
     2040       run diasize_set-width in this-procedure
     2041         (input  v-diasize-current-frame-width
     2042         ,input  true
     2043         ) .
     2044     end.
     2045   end procedure.
     2046   procedure diasize_set-browse-handle :
     2047     define input  parameter p-browse-handle as handle   no-undo .
     2048     define buffer buf_temp-browse-handle for temp-browse-handle .
     2049     do
     2050     on error undo, return error return-value
     2051     :
     2052       assign
     2053         v-diasize-browse-handle = p-browse-handle
     2054       .
     2055       for each buf_temp-browse-handle
     2056       on error undo, return error return-value
     2057       :
     2058         delete buf_temp-browse-handle .
     2059       end.
     2060     end.
     2061   end procedure.
     2062   procedure diasize_add_browse :
     2063     define input  parameter p-browse-type   as character no-undo .
     2064     define input  parameter p-browse-handle as handle    no-undo .
     2065     define buffer buf_temp-browse-handle for temp-browse-handle .
     2066     do
     2067     on error undo, return error return-value
     2068     :
     2069       assign
     2070         v-diasize-browse-number = v-diasize-browse-number + 1
     2071       .
     2072       create buf_temp-browse-handle .
     2073       assign
     2074         buf_temp-browse-handle.browse-type   = p-browse-type
     2075         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2076         buf_temp-browse-handle.browse-handle = p-browse-handle
     2077       .
     2078     end.
     2079   end procedure.
     2080   procedure diasize_init :
     2081     define variable v-default-value    as logical   no-undo .
     2082     define variable v-restore-saved    as logical   no-undo .
     2083     define variable v-resize-value-str as character no-undo .
     2084     do
     2085     on error undo, return error return-value
     2086     :
     2087       do with frame Dialog-Frame
     2088       :
     2089         assign
     2090           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2091           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2092           v-diasize-browse-handle     = browse br-table :handle
     2093         .
     2094         create button v-diasize-resize-button
     2095         assign
     2096           parent        = frame Dialog-Frame :first-child
     2097           label         = "s"
     2098           height-pixels = 16
     2099           width-pixels  = 16
     2100           visible       = true
     2101           sensitive     = true
     2102           movable       = true
     2103           triggers:
     2104             on end-move persistent run diasize_end-move in this-procedure .
     2105           end triggers.
     2106         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2107         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2108         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2109         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2110         assign
     2111           v-diasize-wndmax = false
     2112         .
     2113         if connected("ub") = true
     2114         then do:
     2115           define variable v-cntxt-db-num        as integer   no-undo .
     2116           define variable v-cntxt-userid        as character no-undo .
     2117           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2118                                             , OUTPUT v-cntxt-userid
     2119                                             ) .
     2120           run gbl/wndpar_r.p
     2121             (input  v-cntxt-db-num
     2122             ,input  v-cntxt-userid
     2123             ,input  'wndmax':U
     2124             ,output v-diasize-wndmax
     2125             ,output v-default-value
     2126             ) .
     2127         end.
     2128         assign
     2129           v-diasize-wndstore = false
     2130         .
     2131         if connected("ub") = true
     2132         then do:
     2133           run gbl/wndpar_r.p
     2134             (input  v-cntxt-db-num
     2135             ,input  v-cntxt-userid
     2136             ,input  'wndstore':U
     2137             ,output v-diasize-wndstore
     2138             ,output v-default-value
     2139             ) .
     2140         end.
     2141         assign
     2142           v-diasize-proc-name = entry(1, program-name(2), '.')
     2143         .
     2144         if v-diasize-wndstore = true
     2145         then do:
     2146           assign
     2147             v-restore-saved = false
     2148           .
     2149           if connected("ub") = true
     2150           then do:
     2151             run gbl/wndsizer.p
     2152               (input  v-cntxt-db-num
     2153               ,input  v-cntxt-userid
     2154               ,input  v-diasize-proc-name
     2155               ,input  'height':u
     2156               ,output v-resize-value-str
     2157               ) .
     2158             if v-resize-value-str <> '':U
     2159             then do:
     2160               run diasize_change-height in this-procedure
     2161                 (input  integer(v-resize-value-str)
     2162                 ,input  true
     2163                 ) .
     2164               assign
     2165                 v-restore-saved = true
     2166               .
     2167             end.
     2168           end.
     2169           if connected("ub") = true
     2170           then do:
     2171             run gbl/wndsizer.p
     2172               (input  v-cntxt-db-num
     2173               ,input  v-cntxt-userid
     2174               ,input  v-diasize-proc-name
     2175               ,input  'width':u
     2176               ,output v-resize-value-str
     2177               ) .
     2178             if v-resize-value-str <> '':U
     2179             then do:
     2180               run diasize_change-width in this-procedure
     2181                 (input  integer(v-resize-value-str)
     2182                 ,input  true
     2183                 ) .
     2184               assign
     2185                 v-restore-saved = true
     2186               .
     2187             end.
     2188           end.
     2189           if v-restore-saved <> true
     2190           then do:
     2191             if v-diasize-wndmax = true
     2192             then do:
     2193               run diasize_maximize in this-procedure
     2194                 (input  true
     2195                 ) .
     2196             end.
     2197           end.
     2198         end.
     2199         else do:
     2200           if v-diasize-wndmax = true
     2201           then do:
     2202             run diasize_maximize in this-procedure
     2203               (input  true
     2204               ) .
     2205           end.
     2206         end.
     2207       end.
     2208     end.
     2209   end procedure.
     2210   procedure diasize_need-full-display :
     2211     define output parameter p-need-full-display as logical   no-undo .
     2212     do
     2213     on error undo, return error return-value
     2214     :
     2215       assign
     2216         p-need-full-display = v-diasize-need-full-display
     2217       .
     2218       assign
     2219         v-diasize-need-full-display = false
     2220       .
     2221     end.
     2222   end procedure.
     2223   procedure get-context :
     2224      define output parameter p-db-num as integer          no-undo.
     2225      define output parameter p-user-id as character        no-undo.
     2226      define variable v-login               as character    no-undo.
     2227      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2228      define buffer buf_user-login  for ub.user-login .
     2229      do
     2230      on error undo, return error
     2231      :
     2232            FIND FIRST buf_sys-ctrl no-lock.
     2233            ASSIGN
     2234               v-login = USERID("ub")
     2235               p-db-num = buf_sys-ctrl.db-num
     2236            .
     2237            FIND FIRST buf_user-login
     2238                 WHERE buf_user-login.db-num = p-db-num
     2239                   AND buf_user-login.user-login = v-login
     2240                 no-lock
     2241                 no-error
     2242                 .
     2243            IF AVAILABLE buf_user-login
     2244            THEN DO:
     2245               assign
     2246                  p-user-id = buf_user-login.user-id
     2247               .
     2248            END.
     2249      end.
     2250   end procedure.
     2251       run diasize_init in this-procedure .
     2252   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2253   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2254   MAIN-BLOCK:
     2255   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2256      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2257   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2258     run mainmenu_getcntxt in parparentproc
     2259       (output v-cntxt-db-num
     2260       ,output v-cntxt-userid
     2261       ,output v-cntxt-level
     2262       ,output v-cntxt-host-code-obj
     2263       ,output v-cntxt-obj-type
     2264       ,output v-cntxt-obj-code
     2265       ,output v-cntxt-db-num-obj
     2266       ,output v-cntxt-is-admin
     2267       ) .
     2268      run init-fields in this-procedure.
     2269      RUN enable_UI.
     2270      disable
     2271           bt-attr
     2272           bt-set1
     2273           bt-set2
     2274           bt-set3
     2275           bt-set4
     2276           bt-set5
     2277           bt-set6
     2278           bt-set-obj
     2279      with frame Dialog-Frame.
     2280      apply "entry" to b-goods.
     2281     WAIT-FOR GO OF FRAME Dialog-Frame.
     2282   END.
     2283   RUN disable_UI.
