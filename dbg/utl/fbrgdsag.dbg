     2301   END PROCEDURE.
     2302   PROCEDURE create-temp-goods :
     2303   define input parameter p-gds-code               as integer          no-undo.
     2304   define input parameter p-artic                  as character        no-undo.
     2305   define input parameter p-prod-type              as character        no-undo.
     2306   define input parameter p-prod-code              as integer          no-undo.
     2307   define input parameter p-gds-name               as character        no-undo.
     2308   define input parameter p-unit-base              as character        no-undo.
     2309   define output parameter p-gds-list-not-empty    as logical          no-undo.
     2310       define buffer buf_temp_goods        for temp_goods.
     2311       define buffer buf_fbr-gds-obj       for fbr-gds-obj.
     2312   do
     2313   for buf_temp_goods
     2314     , buf_fbr-gds-obj
     2315   on error undo, return error
     2316   :
     2317           create buf_temp_goods.
     2318           assign
     2319               buf_temp_goods.gds-code           = p-gds-code
     2320               buf_temp_goods.artic              = p-artic
     2321               buf_temp_goods.prod-type          = p-prod-type
     2322               buf_temp_goods.prod-code          = p-prod-code
     2323               buf_temp_goods.gds-name           = p-gds-name
     2324               buf_temp_goods.unit-base          = p-unit-base
     2325               buf_temp_goods.is-cd              = "":U
     2326               buf_temp_goods.is-menu            = "":U
     2327               buf_temp_goods.is-modificator     = "":U
     2328               buf_temp_goods.is-null-price      = "":U
     2329               buf_temp_goods.is-season          = "":U
     2330               buf_temp_goods.is-semi-finished   = "":U
     2331               buf_temp_goods.fbr-obj-type       = "":U
     2332               buf_temp_goods.fbr-obj-code       = -1
     2333               p-gds-list-not-empty              = no
     2334           .
     2335           manufacturing-object:
     2336           for each temp-obj
     2337           on error undo, return error
     2338           :
     2339               find first buf_fbr-gds-obj no-lock
     2340                    where buf_fbr-gds-obj.obj-type = temp-obj.obj-type
     2341                      and buf_fbr-gds-obj.obj-code = temp-obj.obj-code
     2342                      and buf_fbr-gds-obj.gds-code = p-gds-code
     2343               no-error.
     2344               if available buf_fbr-gds-obj
     2345               then do:
     2346                   run get-logical-string in this-procedure (
     2347                         input buf_temp_goods.is-cd
     2348                       , input buf_fbr-gds-obj.is-cd
     2349                       , output buf_temp_goods.is-cd
     2350                   ).
     2351                   run get-logical-string in this-procedure (
     2352                         input buf_temp_goods.is-menu
     2353                       , input buf_fbr-gds-obj.is-menu
     2354                       , output buf_temp_goods.is-menu
     2355                   ).
     2356                   run get-logical-string in this-procedure (
     2357                         input buf_temp_goods.is-modificator
     2358                       , input buf_fbr-gds-obj.is-modificator
     2359                       , output buf_temp_goods.is-modificator
     2360                   ).
     2361                   run get-logical-string in this-procedure (
     2362                         input buf_temp_goods.is-null-price
     2363                       , input buf_fbr-gds-obj.is-null-price
     2364                       , output buf_temp_goods.is-null-price
     2365                   ).
     2366                   run get-logical-string in this-procedure (
     2367                         input buf_temp_goods.is-season
     2368                       , input buf_fbr-gds-obj.is-season
     2369                       , output buf_temp_goods.is-season
     2370                   ).
     2371                   run get-logical-string in this-procedure (
     2372                         input buf_temp_goods.is-semi-finished
     2373                       , input buf_fbr-gds-obj.is-semi-finished
     2374                       , output buf_temp_goods.is-semi-finished
     2375                   ).
     2376                   assign
     2377                       buf_temp_goods.fbr-obj-type      = ( if buf_temp_goods.fbr-obj-type = "":U
     2378                                                            or buf_temp_goods.fbr-obj-type = buf_fbr-gds-obj.fbr-obj-type
     2379                                                            then buf_fbr-gds-obj.fbr-obj-type
     2380                                                            else "?" )
     2381                       buf_temp_goods.fbr-obj-code      = ( if buf_temp_goods.fbr-obj-code = -1
     2382                                                            or buf_temp_goods.fbr-obj-code  = buf_fbr-gds-obj.fbr-obj-code
     2383                                                            then buf_fbr-gds-obj.fbr-obj-code
     2384                                                            else 0 )
     2385                   .
     2386               end.
     2387               if p-gds-list-not-empty = no
     2388               then do:
     2389                   assign
     2390                       p-gds-list-not-empty = yes
     2391                   .
     2392               end.
     2393           end.
     2394           if buf_temp_goods.fbr-obj-code = -1
     2395           then do:
     2396               assign
     2397                   buf_temp_goods.fbr-obj-code = 0
     2398               .
     2399           end.
     2400   end.
     2401   END PROCEDURE.
     2402   PROCEDURE create-temp-obj :
     2403       define input parameter p-range  as integer          no-undo.
     2404       define buffer buf_shop      for shop.
     2405   do
     2406   for buf_shop
     2407   on error undo, return error
     2408   :
     2409       for each temp-obj
     2410       on error undo, return error
     2411       :
     2412           delete temp-obj.
     2413       end.
     2414       run init-temphost.
     2415       if p-range = 1
     2416       then do:
     2417           for each temp-obj
     2418           where temp-obj.host-code <> v-cntxt-host-code-obj
     2419           on error undo, return error
     2420           :
     2421               delete temp-obj.
     2422           end.
     2423       end.
     2424       for each temp-obj
     2425       on error undo, return error
     2426       :
     2427           if temp-obj.obj-type <> 'маг':U
     2428           or temp-obj.db-num   <> v-cntxt-db-num
     2429           then do:
     2430               delete temp-obj.
     2431           end.
     2432           else do:
     2433               find first buf_shop
     2434                    where buf_shop.obj-code = temp-obj.obj-code
     2435               .
     2436               if buf_shop.is-catering = no
     2437               and buf_shop.is-kitchen = no
     2438               then do:
     2439                   delete temp-obj.
     2440               end.
     2441           end.
     2442       end.
     2443   end.
     2444   END PROCEDURE.
     2445   PROCEDURE delete-doc :
     2446   do
     2447   on error undo, return error
     2448   :
     2449   end.
     2450   END PROCEDURE.
     2451   PROCEDURE disable_UI :
     2452     HIDE FRAME Dialog-Frame.
     2453   END PROCEDURE.
     2454   PROCEDURE enable_UI :
     2455     DISPLAY rs-range
     2456         WITH FRAME Dialog-Frame.
     2457     ENABLE b-exit b-goods bt-attr rs-range b-help bt-set1 bt-set2 bt-set3 bt-set4
     2458            bt-set5 bt-set6 bt-set-obj br-table
     2459         WITH FRAME Dialog-Frame.
     2460     VIEW FRAME Dialog-Frame.
     2461     OPEN QUERY br-table FOR EACH temp_goods NO-LOCK.
     2462   END PROCEDURE.
     2463   PROCEDURE init-fields :
     2464   do
     2465   on error undo, return error
     2466   :
     2467       assign
     2468           rs-range = 1
     2469       .
     2470       run create-temp-obj in this-procedure (
     2471           input rs-range
     2472       ).
     2473   end.
     2474   END PROCEDURE.
     2475   PROCEDURE open-doc :
     2476   do
     2477   on error undo, return error
     2478   :
     2479   end.
     2480   END PROCEDURE.
     2481   PROCEDURE set-attr :
     2482   define input parameter p-attr-list as character    no-undo.
     2483       define variable v-fbr-gds-obj-recid    as recid      no-undo.
     2484       define buffer buf_fbr-gds-obj   for fbr-gds-obj.
     2485       define buffer buf_temp_goods    for temp_goods.
     2486       define buffer buf_goods         for goods.
     2487   do
     2488   for buf_fbr-gds-obj
     2489     , buf_temp_goods
     2490     , buf_goods
     2491   on error undo, return error
     2492   :
     2493       for each buf_temp_goods
     2494       on error undo, return error
     2495       :
     2496           find first buf_goods no-lock
     2497                where buf_goods.gds-code = buf_temp_goods.gds-code
     2498           .
     2499           for each temp-obj
     2500           on error undo, return error
     2501           :
     2502               find first buf_fbr-gds-obj no-lock
     2503                    where buf_fbr-gds-obj.obj-type = temp-obj.obj-type
     2504                      and buf_fbr-gds-obj.obj-code = temp-obj.obj-code
     2505                      and buf_fbr-gds-obj.gds-code = buf_temp_goods.gds-code
     2506               no-error.
     2507               if available buf_fbr-gds-obj
     2508               then do:
     2509                   assign
     2510                       v-fbr-gds-obj-recid = recid( buf_fbr-gds-obj )
     2511                   .
     2512               end.
     2513               else do:
     2514                   assign
     2515                       v-fbr-gds-obj-recid = ?
     2516                   .
     2517               end.
     2518               assign
     2519                   buf_temp_goods.is-cd            = ( if entry( 1, p-attr-list ) = "yes" then "+":U else "-":U )
     2520                   buf_temp_goods.is-menu          = ( if entry( 2, p-attr-list ) = "yes" then "+":U else "-":U )
     2521                   buf_temp_goods.is-modificator   = ( if entry( 3, p-attr-list ) = "yes" then "+":U else "-":U )
     2522                   buf_temp_goods.is-null-price    = ( if entry( 4, p-attr-list ) = "yes" then "+":U else "-":U )
     2523                   buf_temp_goods.is-season        = ( if entry( 5, p-attr-list ) = "yes" then "+":U else "-":U )
     2524                   buf_temp_goods.is-semi-finished = ( if entry( 6, p-attr-list ) = "yes" then "+":U else "-":U )
     2525                   buf_temp_goods.fbr-obj-type     = entry( 7, p-attr-list )
     2526                   buf_temp_goods.fbr-obj-code     = integer( entry( 8, p-attr-list ) )
     2527               .
     2528               run ref/fgdsobj1.p (
     2529                   input-output v-fbr-gds-obj-recid
     2530                   , input ( if available buf_fbr-gds-obj
     2531                           then 'ИЗМЕНЕНИЕ':U
     2532                           else 'ДОБАВЛЕНИЕ':U )
     2533                   , input no
     2534                   , input buf_temp_goods.gds-code
     2535                   , input temp-obj.obj-type
     2536                   , input temp-obj.obj-code
     2537                   , input ( if available buf_fbr-gds-obj then buf_fbr-gds-obj.fbr-grp-code else 0 )
     2538                   , input buf_temp_goods.fbr-obj-type
     2539                   , input buf_temp_goods.fbr-obj-code
     2540                   , input ( buf_temp_goods.is-cd            = "+":U )
     2541                   , input ( buf_temp_goods.is-menu          = "+":U )
     2542                   , input ( buf_temp_goods.is-modificator   = "+":U )
     2543                   , input ( buf_temp_goods.is-null-price    = "+":U )
     2544                   , input ( buf_temp_goods.is-season        = "+":U )
     2545                   , input ( buf_temp_goods.is-semi-finished = "+":U )
     2546               ) no-error.
     2547               if error-status:error
     2548               then do:
     2549                   message
     2550                           vss-workfile vss-revision vss-description
     2551                       skip "Ошибка изменения атрибутов товара на объекте"
     2552                       skip return-value
     2553                       skip trim(error-status :get-message(1))
     2554                               trim(error-status :get-message(2))
     2555                               trim(error-status :get-message(3))
     2556                   view-as alert-box error.
     2557                   undo, return error .
     2558               end.
     2559           end.
     2560       end.
     2561   end.
     2562   END PROCEDURE.
     2563   PROCEDURE set-one-attr :
     2564   define input parameter p-attr-name  as character  no-undo.
     2565   define input parameter p-attr-value as logical      no-undo.
     2566       define variable v-fbr-gds-obj-recid    as recid      no-undo.
     2567       define buffer buf_fbr-gds-obj   for fbr-gds-obj.
     2568       define buffer buf_temp_goods    for temp_goods.
     2569       define buffer buf_goods         for goods.
     2570   do
     2571   for buf_fbr-gds-obj
     2572     , buf_temp_goods
     2573     , buf_goods
     2574   on error undo, return error
     2575   :
     2576       if p-attr-name = 'object':U
     2577       then do:
     2578           define variable v-user-select as logical   no-undo .
     2579           define variable v-obj-type    as character no-undo .
     2580           define variable v-obj-code    as integer   no-undo .
     2581           define variable v-yesno       as logical   no-undo .
     2582   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2583   run userobjs_select-one in this-procedure
     2584     (input  parparentproc
     2585     ,input  v-cntxt-db-num
     2586     ,input  v-cntxt-userid
     2587     ,input  v-cntxt-host-code-obj
     2588     ,input  v-cntxt-obj-type
     2589     ,input  v-cntxt-obj-code
     2590     ,output v-user-select
     2591     ,output v-obj-type
     2592     ,output v-obj-code
     2593     )  .
     2594           if v-user-select = true
     2595           then do:
     2596               message
     2597                   skip "Для всех товаров списка"
     2598                   skip "будет изменен атрибут:"
     2599                   skip(1)
     2600                   skip "'Объект кухня'"
     2601                   skip "Новое значение атрибута:" v-obj-type v-obj-code
     2602                   skip(1)
     2603                   skip "Yes - Установить атрибут"
     2604                   skip "No  - Не изменять значение атрибута"
     2605                   skip(1)
     2606                   skip "Назначить атрибут всем товарам списка?"
     2607               view-as alert-box question
     2608               buttons yes-no
     2609               title "Изменение атрибутов товаров списка"
     2610               update v-yesno.
     2611               if v-yesno = no
     2612               then do:
     2613                   undo, return.
     2614               end.
     2615           end.
     2616           else do:
     2617               undo, return.
     2618           end.
     2619       end.
     2620       for each buf_temp_goods
     2621       on error undo, return error
     2622       :
     2623           find first buf_goods no-lock
     2624                where buf_goods.gds-code = buf_temp_goods.gds-code
     2625           .
     2626           for each temp-obj
     2627           on error undo, return error
     2628           :
     2629               find first buf_fbr-gds-obj no-lock
     2630                    where buf_fbr-gds-obj.obj-type = temp-obj.obj-type
     2631                      and buf_fbr-gds-obj.obj-code = temp-obj.obj-code
     2632                      and buf_fbr-gds-obj.gds-code = buf_temp_goods.gds-code
     2633               no-error.
     2634               if available buf_fbr-gds-obj
     2635               then do:
     2636                   assign
     2637                       v-fbr-gds-obj-recid = recid( buf_fbr-gds-obj )
     2638                   .
     2639               end.
     2640               else do:
     2641                   assign
     2642                       v-fbr-gds-obj-recid = ?
     2643                   .
     2644               end.
     2645               case p-attr-name
     2646               :
     2647                   when 'is-cd':U
     2648                   then do:
     2649                       assign
     2650                           buf_temp_goods.is-cd            = ( if p-attr-value = yes then "+":U else "-":U )
     2651                       .
     2652                   end.
     2653                   when 'is-menu':U
     2654                   then do:
     2655                       assign
     2656                           buf_temp_goods.is-menu         = ( if p-attr-value = yes then "+":U else "-":U )
     2657                       .
     2658                       if p-attr-value = yes
     2659                       and buf_temp_goods.is-semi-finished = "+":U
     2660                       then do:
     2661                           assign
     2662                               buf_temp_goods.is-semi-finished = "-":U
     2663                           .
     2664                       end.
     2665                       if p-attr-value = yes
     2666                       and ( buf_temp_goods.fbr-obj-type = "":U
     2667                       or buf_temp_goods.fbr-obj-type = "?":U
     2668                       or buf_temp_goods.fbr-obj-code = 0 )
     2669                       then do:
     2670                           assign
     2671                               buf_temp_goods.fbr-obj-type = temp-obj.obj-type
     2672                               buf_temp_goods.fbr-obj-code = temp-obj.obj-code
     2673                           .
     2674                       end.
     2675                   end.
     2676                   when 'is-modificator':U
     2677                   then do:
     2678                       assign
     2679                           buf_temp_goods.is-modificator   = ( if p-attr-value = yes then "+":U else "-":U )
     2680                       .
     2681                   end.
     2682                   when 'is-null-price':U
     2683                   then do:
     2684                       assign
     2685                           buf_temp_goods.is-null-price    = ( if p-attr-value = yes then "+":U else "-":U )
     2686                       .
     2687                   end.
     2688                   when 'is-season':U
     2689                   then do:
     2690                       assign
     2691                           buf_temp_goods.is-season        = ( if p-attr-value = yes then "+":U else "-":U )
     2692                       .
     2693                   end.
     2694                   when 'is-semi-finished':U
     2695                   then do:
     2696                       assign
     2697                           buf_temp_goods.is-semi-finished = ( if p-attr-value = yes then "+":U else "-":U )
     2698                       .
     2699                       if p-attr-value = yes
     2700                       and buf_temp_goods.is-menu = "+":U
     2701                       then do:
     2702                           assign
     2703                               buf_temp_goods.is-menu = "-":U
     2704                           .
     2705                       end.
     2706                       if p-attr-value = yes
     2707                       and ( buf_temp_goods.fbr-obj-type = "":U
     2708                       or buf_temp_goods.fbr-obj-type = "?":U
     2709                       or buf_temp_goods.fbr-obj-code = 0 )
     2710                       then do:
     2711                           assign
     2712                               buf_temp_goods.fbr-obj-type = temp-obj.obj-type
     2713                               buf_temp_goods.fbr-obj-code = temp-obj.obj-code
     2714                           .
     2715                       end.
     2716                   end.
     2717                   when 'object':U
     2718                   then do:
     2719                       assign
     2720                           buf_temp_goods.fbr-obj-type = v-obj-type
     2721                           buf_temp_goods.fbr-obj-code = v-obj-code
     2722                       .
     2723                   end.
     2724               end case.
     2725               run ref/fgdsobj1.p (
     2726                   input-output v-fbr-gds-obj-recid
     2727                   , input ( if available buf_fbr-gds-obj
     2728                           then 'ИЗМЕНЕНИЕ':U
     2729                           else 'ДОБАВЛЕНИЕ':U )
     2730                   , input no
     2731                   , input buf_temp_goods.gds-code
     2732                   , input temp-obj.obj-type
     2733                   , input temp-obj.obj-code
     2734                   , input ( if available buf_fbr-gds-obj then buf_fbr-gds-obj.fbr-grp-code else 0 )
     2735                   , input buf_temp_goods.fbr-obj-type
     2736                   , input buf_temp_goods.fbr-obj-code
     2737                   , input ( buf_temp_goods.is-cd            = "+":U )
     2738                   , input ( buf_temp_goods.is-menu          = "+":U )
     2739                   , input ( buf_temp_goods.is-modificator   = "+":U )
     2740                   , input ( buf_temp_goods.is-null-price    = "+":U )
     2741                   , input ( buf_temp_goods.is-season        = "+":U )
     2742                   , input ( buf_temp_goods.is-semi-finished = "+":U )
     2743               ) no-error.
     2744               if error-status:error
     2745               then do:
     2746                   message
     2747                           vss-workfile vss-revision vss-description
     2748                       skip "Ошибка изменения атрибутов товара на объекте"
     2749                       skip return-value
     2750                       skip trim(error-status :get-message(1))
     2751                               trim(error-status :get-message(2))
     2752                               trim(error-status :get-message(3))
     2753                   view-as alert-box error.
     2754                   undo, return error .
     2755               end.
     2756           end.
     2757       end.
     2758   end.
     2759   END PROCEDURE.
     2760   PROCEDURE view-doc :
     2761   do
     2762   on error undo, return error
     2763   :
     2764   end.
     2765   END PROCEDURE.
     2766   PROCEDURE get-logical-string :
     2767   define input parameter p-current-string-value   as character        no-undo.
     2768   define input parameter p-current-logical-value  as logical          no-undo.
     2769   define output parameter p-new-string-value      as character        no-undo.
     2770   do
     2771   on error undo, return error
     2772   :
     2773       if p-current-string-value = "?":U
     2774       then do:
     2775           assign
     2776               p-new-string-value = "?":U
     2777           .
     2778           undo, return .
     2779       end.
     2780       if p-current-string-value = "":U
     2781       then do:
     2782           assign
     2783               p-new-string-value = ( if p-current-logical-value = yes then "+":U else "-":U )
     2784           .
     2785       end.
     2786       else do:
     2787           if ( p-current-string-value     = "+":U
     2788               and p-current-logical-value = no )
     2789           or ( p-current-string-value     = "-":U
     2790               and p-current-logical-value = yes )
     2791           then do:
     2792               assign
     2793                   p-new-string-value = "?":U
     2794               .
     2795           end.
     2796           else do:
     2797               assign
     2798                   p-new-string-value = p-current-string-value
     2799               .
     2800           end.
     2801       end.
     2802   end.
     2803   END PROCEDURE.
