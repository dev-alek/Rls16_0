     9474           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     9475         .
     9476         assign
     9477           self :screen-value = string(v-new-sv-date) .
     9478         .
     9479       end.
     9480     end.
     9481     return no-apply .
     9482   end.
     9483   on ctrl-e of x_parts.last-date in frame Dialog-Frame
     9484   do:
     9485     if (can-query (self, "sensitive")
     9486        and
     9487        self :sensitive = true
     9488        )
