     9293   run minbtn-set in this-procedure .
     9294   on choose of b-help in frame Dialog-Frame
     9295   do:
     9296     apply "help":u to frame Dialog-Frame .
     9297   end.
     9298   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9299   procedure minbtn-set :
     9300       do
     9301           on error undo, return error return-value
     9302           :
     9303           define variable ii              as integer       no-undo .
     9304           define variable fh              as widget-handle no-undo .
     9305           define variable hh              as widget-handle no-undo .
     9306           define variable v-h             as handle        extent 4 no-undo .
     9307           define variable v-name-button   as character     no-undo .
     9308           define variable v-help-old-x    as decimal       no-undo .
     9309           define variable v-help-old-y    as decimal       no-undo .
     9310           define variable v-help-old-size as decimal       no-undo .
     9311           define variable v-frame-width   as decimal       no-undo .
     9312           define variable jj              as integer       no-undo .
     9313           do
     9314               on error undo, return error
     9315               :
     9316               assign
     9317                   v-frame-width = frame Dialog-Frame:width - 0.3
     9318                   fh            = frame Dialog-Frame:first-child
     9319                   hh            = fh:first-child
     9320                   ii            = 1
     9321                   .
     9322               do while valid-handle(hh):
     9323                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     9324                   do:
     9325                       case lc(hh:name) :
     9326                           when "b-help" then
     9327                               do:
     9328                                   hh:load-image-up("cmp/b-help.bmp":u) .
     9329                                   hh:load-image-down("cmp/b-help.bmp":u) .
     9330                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     9331                                   hh:TOOLTIP = "Помощь" .
     9332                                   v-help-old-x = hh:column .
     9333                                   v-help-old-y = hh:row    .
     9334                                   v-help-old-size = hh:width .
     9335                                   hh:width-chars = 2.5 .
     9336                               end.
     9337                           when "b-print" then
     9338                               do:
     9339                                   hh:load-image("cmp/b-print.bmp":u) .
     9340                                   hh:TOOLTIP = "Печать" .
     9341                                   v-h[ii] = hh:handle .
     9342                                   ii = ii + 1 .
     9343                                   hh:width-chars = 3 .
     9344                               end.
     9345                           when "b-history" or
     9346                           when "b-hist" then
     9347                               do:
     9348                                   hh:load-image("cmp/b-hist.bmp":u) .
     9349                                   hh:TOOLTIP = "История" .
     9350                                   v-h[ii] = hh:handle .
     9351                                   ii = ii + 1 .
     9352                                   hh:width-chars = 3 .
     9353                               end.
     9354                           when "b-sch" then
     9355                               do:
     9356                                   hh:load-image("cmp/b-sch.bmp":u) .
     9357                                   hh:TOOLTIP = "Установка Фильтра" .
     9358                                   v-h[ii] = hh:handle .
     9359                                   ii = ii + 1 .
     9360                                   hh:width-chars = 3 .
     9361                               end.
     9362                           when "b-hist-user" then
     9363                               do:
     9364                                   hh:load-image("cmp/b-hist.bmp":u) .
     9365                                   hh:TOOLTIP = "История пользователя" .
     9366                                   ii = ii + 1 .
     9367                               end.
     9368                       end case.
     9369                   end.
     9370                   hh = hh:next-sibling.
     9371               end.
     9372               b-help:column = v-frame-width - b-help:width-chars.
     9373               jj = 0.
     9374               repeat ii = 4 to 1 by -1 :
     9375                   if valid-handle (v-h[ii] ) then
     9376                   do:
     9377                       jj  = jj + 1 .
     9378                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     9379                       v-h[ii]:row    = v-help-old-y .
     9380                   end.
     9381               end.
     9382           end.
     9383       end.
     9384   end procedure.
     9385   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9386   on ' ' of x_parts.last-date in frame Dialog-Frame
