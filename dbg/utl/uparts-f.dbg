     9956   PROCEDURE disable_UI :
     9957     HIDE FRAME Dialog-Frame.
     9958   END PROCEDURE.
     9959   PROCEDURE display-dependent-info :
     9960     define variable v-fact-qnty as decimal no-undo .
     9961     do with frame Dialog-Frame:
     9962       if v-goods-twounit = false
     9963       then do:
     9964         if x_parts.cli-qnty :sensitive
     9965         then do:
     9966           assign
     9967             x_parts.fact-qnty :screen-value = string( decimal(x_parts.cli-qnty :screen-value)
     9968                                                   * decimal(x_parts.cli-base-rate :screen-value)
     9969                                                 , x_parts.fact-qnty :format )
     9970             x_parts.qnty :screen-value = x_parts.fact-qnty :screen-value
     9971           .
     9972         end.
     9973         if x_parts.qnty :sensitive
     9974         then do:
     9975           if x_parts.cli-qnty :visible = true
     9976           then do:
     9977             assign
     9978               x_parts.cli-qnty :screen-value = string( decimal(x_parts.qnty :screen-value)
     9979                                                     / decimal(x_parts.cli-base-rate :screen-value)
     9980                                                   , x_parts.cli-qnty :format )
     9981             .
     9982           end.
     9983           if x_parts.fact-qnty :visible
     9984           then do:
     9985             assign
     9986               x_parts.fact-qnty :screen-value = x_parts.qnty :screen-value
     9987             .
     9988           end.
     9989         end.
     9990       end.
     9991       assign
     9992         fi-label-summa :screen-value = string("Сумма " + x_parts.fact-qnty :label)
     9993         tot-price-rubl :screen-value = string(decimal(x_parts.fact-qnty :screen-value)
     9994                                               * decimal(x_parts.price-rubl :screen-value)
     9995                                              , tot-price-cli :format )
     9996         tot-price-base :screen-value = string(decimal(x_parts.fact-qnty :screen-value)
     9997                                               * decimal(x_parts.price-base :screen-value)
     9998                                              , tot-price-cli :format )
     9999       .
    10000       if tot-price-cli :visible
    10001       then do:
    10002         assign
    10003           tot-price-cli  :screen-value = string(decimal(x_parts.cli-qnty :screen-value)
    10004                                                 * decimal(x_parts.price-cli :screen-value)
    10005                                                , tot-price-cli :format )
    10006         .
    10007       end.
    10008     end.
    10009   END PROCEDURE.
    10010   PROCEDURE display-fields :
    10011     define variable v-frame-title as character no-undo .
    10012     define variable v-host-code like ub.sysconf.host-code no-undo .
    10013     define variable v-base-code like ub.sysconf.base-code no-undo .
    10014     define buffer buf_parts        for x_parts .
    10015     define buffer buf_doc-line     for ub.doc-line .
    10016     define buffer buf_trn-doc      for ub.trn-doc .
    10017     define buffer buf_goods        for ub.goods .
    10018     define buffer buf_clients      for ub.clients .
    10019     define buffer buf_currency     for ub.currency .
    10020     define buffer buf_supp-clients for ub.clients .
    10021     do with frame Dialog-Frame:
    10022       define variable v-old-immediate-display as logical no-undo .
    10023       assign
    10024         v-old-immediate-display = session:immediate-display
    10025       .
    10026       if v-old-immediate-display = yes
    10027       then do:
    10028         assign
    10029           session:immediate-display = no
    10030         .
    10031       end.
    10032       assign
    10033         x_parts.price-cli         :screen-value = ""
    10034         x_parts.price-base        :screen-value = ""
    10035         x_parts.price-rubl        :screen-value = ""
    10036         x_parts.cli-qnty          :screen-value = ""
    10037         x_parts.qnty              :screen-value = ""
    10038         x_parts.fact-qnty         :screen-value = ""
    10039         x_parts.cli-base-rate     :screen-value = ""
    10040         x_parts.part-code         :screen-value = ""
    10041         x_parts.cst-code          :screen-value = ""
    10042         x_parts.last-date         :screen-value = ""
    10043         fi-last-date-offset       :screen-value = ""
    10044         x_parts.PS                :screen-value = ""
    10045         fi-vat-type             :screen-value = ""
