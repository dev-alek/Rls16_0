    11375         then do:
    11376           assign
    11377             p-record-modified = true
    11378           .
    11379           return .
    11380         end.
    11381       end.
    11382       if x_parts.price-rubl :sensitive
    11383       then do:
    11384         if x_parts.price-rubl :modified = true
    11385         then do:
    11386           assign
    11387             p-record-modified = true
    11388           .
    11389           return .
    11390         end.
    11391       end.
    11392       if fi-vat-pc :sensitive
    11393       then do:
    11394         if fi-vat-pc :modified = true
    11395         then do:
    11396           assign
    11397             p-record-modified = true
    11398           .
    11399           return .
    11400         end.
    11401       end.
    11402       if fi-slt-pc :sensitive
    11403       then do:
    11404         if fi-slt-pc :modified = true
    11405         then do:
    11406           assign
    11407             p-record-modified = true
    11408           .
    11409           return .
    11410         end.
    11411       end.
    11412       if x_parts.qnty :sensitive
    11413       then do:
    11414         if x_parts.qnty :modified = true
    11415         then do:
    11416           assign
    11417             p-record-modified = true
    11418           .
    11419           return .
    11420         end.
    11421       end.
    11422       if x_parts.fact-qnty :sensitive
    11423       then do:
    11424         if x_parts.fact-qnty :modified = true
    11425         then do:
    11426           assign
    11427             p-record-modified = true
    11428           .
    11429           return .
    11430         end.
    11431       end.
    11432       if x_parts.cli-qnty :sensitive
    11433       then do:
    11434         if x_parts.cli-qnty :modified = true
    11435         then do:
    11436           assign
    11437             p-record-modified = true
    11438           .
    11439           return .
    11440         end.
    11441       end.
    11442       if x_parts.PS :read-only = false
    11443       then do:
    11444         if x_parts.PS :modified = true
    11445         then do:
    11446           assign
    11447             p-record-modified = true
    11448           .
    11449           return .
    11450         end.
    11451       end.
    11452       if x_parts.supp-type :sensitive
    11453       then do:
    11454         if x_parts.supp-type :modified = true
    11455         then do:
    11456           assign
    11457             p-record-modified = true
    11458           .
    11459           return .
    11460         end.
    11461       end.
    11462       if x_parts.supp-code :sensitive
    11463       then do:
    11464         if x_parts.supp-code :modified = true
    11465         then do:
    11466           assign
    11467             p-record-modified = true
    11468           .
    11469           return .
    11470         end.
    11471       end.
    11472       if v-can-change-supp = true
    11473       then do:
    11474         if v-modified-exch-code = true
    11475         then do:
    11476           assign
    11477             p-record-modified = true
    11478           .
    11479           return .
    11480         end.
    11481       end.
    11482       if  v-can-change-supp = true
    11483       and v-is-fin          = true
    11484       then do:
    11485         if v-modified-contract-code = true
    11486         then do:
    11487           assign
    11488             p-record-modified = true
    11489           .
    11490           return .
    11491         end.
    11492       end.
    11493       if v-alcohol-prod = true
    11494       then do:
    11495         find first buf_parts no-lock
    11496           where recid(buf_parts) = v-parts-recid
    11497           no-error .
    11498         if available buf_parts and
    11499           (v-alc-mark-db-num         <> buf_parts.mark-db-num             or
    11500            v-alc-mark-code           <> buf_parts.mark-code               or
    11501            v-alc-bottling-date       <> buf_parts.alc-bottling-date       or
    11502            v-alc-ref-ab-path         <> buf_parts.alc-ref-ab-path         or
    11503            v-alc-quality-certif-path <> buf_parts.alc-quality-certif-path or
    11504            v-alc-certif-path         <> buf_parts.alc-certif-path
    11505           )
    11506         then do:
    11507           assign
    11508             p-record-modified = true
    11509           .
    11510           return .
    11511         end.
    11512       end.
    11513     end.
    11514     assign
    11515       p-record-modified = false
    11516     .
    11517     return .
    11518   END PROCEDURE.
    11519   PROCEDURE reopen-query :
    11520     define input parameter v-new-parts-recid as recid no-undo .
    11521     if valid-handle(h-call-prog)
    11522     then do:
    11523       run reopen-query in h-call-prog
    11524         .
    11525       run reposition-parts in h-call-prog
    11526         (input  string(v-new-parts-recid)
    11527         ,output v-new-parts-recid
    11528         ).
    11529       apply 'entry':u to b-exit in frame Dialog-Frame .
    11530       if v-new-parts-recid <> ?
    11531       then do:
    11532         define buffer buf_parts for x_parts .
    11533         find first buf_parts no-lock
    11534           where recid(buf_parts) = v-new-parts-recid
    11535           no-error .
    11536         assign
    11537           v-parts-recid = v-new-parts-recid
    11538         .
    11539         if available buf_parts
    11540         then do:
    11541           run disable-fields .
    11542           run display-fields .
    11543           run enable-fields .
    11544         end.
    11545       end.
    11546     end.
    11547   END PROCEDURE.
    11548   PROCEDURE reposition-parts :
    11549     define input parameter v-direction as character no-undo .
    11550     define variable v-new-parts-recid as recid no-undo .
    11551     if valid-handle(h-call-prog)
    11552     then do:
    11553       run reposition-parts in h-call-prog
    11554         (input  v-direction
    11555         ,output v-new-parts-recid
    11556         ).
    11557       if v-new-parts-recid <> ?
    11558       then do:
    11559         define buffer buf_parts for x_parts .
    11560         find first buf_parts no-lock
    11561           where recid(buf_parts) = v-new-parts-recid
    11562           no-error .
    11563         assign
    11564           v-parts-recid = v-new-parts-recid
    11565         .
    11566         if available buf_parts
    11567         then do:
    11568           run disable-fields .
    11569           run display-fields .
    11570           run enable-fields .
    11571         end.
    11572       end.
    11573     end.
    11574   END PROCEDURE.
    11575   PROCEDURE update-dependent-price :
    11576     do
    11577     on error undo, return error return-value
    11578     :
    11579       do with frame Dialog-Frame
    11580       :
    11581         if v-can-change-supp = true
    11582         then do:
    11583           if v-enable-price-rubl = false
    11584           then do:
    11585             assign
    11586               x_parts.price-rubl :screen-value = x_parts.price-cli :screen-value
    11587             .
    11588           end.
    11589           if v-enable-price-base = false
    11590           then do:
    11591             case v-price-base-source
    11592             :
    11593               when 'price-cli':u
    11594               then do:
    11595                 assign
    11596                   x_parts.price-base :screen-value = x_parts.price-cli :screen-value
    11597                 .
    11598               end.
    11599               when 'price-rubl':u
    11600               then do:
    11601                 assign
    11602                   x_parts.price-base :screen-value = x_parts.price-rubl :screen-value
    11603                 .
    11604               end.
    11605               otherwise do:
    11606                 message
    11607                   vss-workfile vss-revision vss-description skip
    11608                   "Внутренняя ошибка" skip
    11609                   "Неизвестное значение v-price-base-source" v-price-base-source skip
    11610                   view-as alert-box error .
    11611               end.
    11612             end.
    11613           end.
    11614         end.
    11615       end.
    11616     end.
    11617   END PROCEDURE.
    11618   PROCEDURE update-enable-price-cli :
    11619     do
    11620     on error undo, return error return-value
    11621     :
    11622       do with frame Dialog-Frame
    11623       :
    11624         assign
    11625           fi-contract-prn-code :sensitive = v-enable-contract
    11626           r-contract           :sensitive = v-enable-contract
    11627         .
    11628         if v-display-price-cli = true
    11629         then do:
    11630           assign
    11631             x_parts.cli-base-rate :screen-value = "1"
    11632           .
    11633           assign
    11634             fi-unit-cli          :visible = true
    11635             val-price-cli        :visible = true
    11636             x_parts.cli-base-rate  :visible = true
    11637             x_parts.exch-code      :visible = true
    11638             r-exch-code          :visible = true
    11639             x_parts.price-cli      :visible = true
    11640             x_parts.cli-qnty       :visible = true
    11641             tot-price-cli        :visible = true
    11642             FI-label-koefficient :visible = true
    11643           .
    11644           assign
    11645             fi-unit-cli          :sensitive = false
    11646             val-price-cli        :sensitive = false
    11647             x_parts.cli-base-rate  :sensitive = false
    11648             x_parts.exch-code      :sensitive = v-enable-cli-exch-code
    11649             r-exch-code          :sensitive = v-enable-cli-exch-code
    11650             x_parts.price-cli      :sensitive = v-enable-price-cli
    11651             x_parts.cli-qnty       :sensitive = false
    11652             tot-price-cli        :sensitive = false
    11653             FI-label-koefficient :sensitive = false
    11654           .
    11655           if v-curr-r-b = 'base':U
    11656           then do:
    11657             assign
    11658               x_parts.price-cli :screen-value = x_parts.price-base :screen-value
    11659             .
    11660           end.
    11661           else do:
    11662             assign
    11663               x_parts.price-cli :screen-value = x_parts.price-rubl :screen-value
    11664             .
    11665           end.
    11666           assign
    11667             x_parts.cli-qnty :screen-value = x_parts.fact-qnty :screen-value
    11668           .
    11669         end.
    11670         else do:
    11671           assign
    11672             fi-unit-cli          :sensitive = false
    11673             val-price-cli        :sensitive = false
    11674             x_parts.cli-base-rate  :sensitive = false
    11675             x_parts.exch-code      :sensitive = false
    11676             r-exch-code          :sensitive = false
    11677             x_parts.price-cli      :sensitive = false
    11678             x_parts.cli-qnty       :sensitive = false
    11679             tot-price-cli        :sensitive = false
    11680             FI-label-koefficient :sensitive = false
    11681           .
    11682           assign
    11683             fi-unit-cli          :visible = false
    11684             val-price-cli        :visible = false
    11685             x_parts.cli-base-rate  :visible = false
    11686             x_parts.exch-code      :visible = false
    11687             r-exch-code          :visible = false
    11688             x_parts.price-cli      :visible = false
    11689             x_parts.cli-qnty       :visible = false
    11690             tot-price-cli        :visible = false
    11691             FI-label-koefficient :visible = false
    11692           .
    11693         end.
    11694         if x_parts.exch-code :sensitive
    11695         then do:
    11696           assign
    11697             x_parts.exch-code :fgcolor = ?
    11698           .
    11699         end.
    11700         else do:
    11701           assign
    11702             x_parts.exch-code :fgcolor = 4
    11703           .
    11704         end.
    11705       end.
    11706     end.
    11707   END PROCEDURE.
    11708   PROCEDURE update-exch-code-dependent :
    11709     define buffer buf_currency for ub.currency .
    11710     do
    11711     on error undo, return error return-value
    11712     :
    11713       find first buf_currency no-lock
    11714         where buf_currency.curr-code = v-exch-code
    11715         no-error .
    11716       if not available buf_currency then do:
    11717         message
    11718           vss-workfile vss-revision vss-description skip
    11719           "Внутренняя ошибка" skip
    11720           "Неизвестный код валюты" v-exch-code skip
    11721           view-as alert-box error .
    11722         undo, return error return-value .
    11723       end.
    11724       else do:
    11725         do with frame Dialog-Frame
    11726         :
    11727           assign
    11728             x_parts.exch-code :screen-value = string(buf_currency.curr-code
    11729                                                   ,x_parts.exch-code :format
    11730                                                   )
    11731             val-price-cli   :screen-value = string(buf_currency.curr-abbr
    11732                                                   ,val-price-cli  :format
    11733                                                   )
    11734           .
    11735         end.
    11736       end.
    11737     end.
    11738   END PROCEDURE.
    11739   PROCEDURE update-exch-code-enable :
    11740     do
    11741     on error undo, return error return-value
    11742     :
    11743         assign
    11744           v-price-base-source = '':u
    11745           v-enable-price-rubl = true
    11746           v-enable-price-base = true
    11747         .
    11748         if v-enable-price-cli = true
    11749         then do:
    11750           if v-exch-code = 0
    11751           then do:
    11752             assign
    11753               v-enable-price-rubl = false
    11754             .
    11755           end.
    11756           else do:
    11757             assign
    11758               v-enable-price-rubl = true
    11759             .
    11760           end.
    11761           if v-exch-code = (input frame Dialog-Frame val-base-code)
    11762           then do:
    11763             assign
    11764               v-enable-price-base = false
    11765               v-price-base-source = 'price-cli':u
    11766             .
    11767           end.
    11768           else do:
    11769             assign
    11770               v-enable-price-base = true
    11771             .
    11772           end.
    11773         end.
    11774         if (input frame Dialog-Frame val-base-code) = 0
    11775         then do:
    11776           assign
    11777             v-enable-price-base = false
    11778             v-price-base-source = 'price-rubl':u
    11779           .
    11780         end.
    11781       if v-enable-price-rubl = true
    11782       then do:
    11783         assign
    11784           x_parts.price-rubl :sensitive = true
    11785         .
    11786       end.
    11787       else do:
    11788         assign
    11789           x_parts.price-rubl :sensitive = false
    11790         .
    11791       end.
    11792       if v-enable-price-base = true
    11793       then do:
    11794         assign
    11795           x_parts.price-base :sensitive = true
    11796         .
    11797       end.
    11798       else do:
    11799         assign
    11800           x_parts.price-base :sensitive = false
    11801         .
    11802       end.
    11803       run update-dependent-price in this-procedure .
    11804     end.
    11805   END PROCEDURE.
    11806   PROCEDURE update-last-date-offset :
    11807     do with frame Dialog-Frame
    11808     :
    11809       define variable v-last-date-offset as integer   no-undo .
    11810       define variable v-today     as date      no-undo .
    11811       define variable v-time      as integer   no-undo .
    11812       run cur-time in this-procedure
    11813         (output v-today
    11814         ,output v-time
    11815         ) .
    11816       run godendo-date-to-offset in this-procedure
    11817         (input  v-today
    11818         ,input  (input frame Dialog-Frame x_parts.last-date)
    11819         ,output v-last-date-offset
    11820         ) .
    11821       assign
    11822         fi-last-date-offset :screen-value = string(v-last-date-offset
    11823                                                   ,fi-last-date-offset :format
    11824                                                   )
    11825       .
    11826     end.
    11827   END PROCEDURE.
    11828   PROCEDURE update-record :
    11829     define output parameter v-close-window    as logical no-undo .
    11830     define variable v-ok as logical   no-undo .
    11831     define variable v-record-modified as logical no-undo .
    11832     define variable l-edit-reserv     as logical no-undo .
    11833     assign
    11834       v-close-window = false
    11835     .
    11836     run record-modified in this-procedure
    11837       (output v-record-modified
    11838       ) no-error .
    11839     if error-status :error
    11840     then do:
    11841       message
    11842         vss-workfile vss-revision vss-description skip
    11843         "Ошибка при вызове процедуры record-modified" skip
    11844         error-status :get-message(1) skip
    11845         return-value skip
    11846         view-as alert-box error .
    11847       undo, return error .
    11848     end.
    11849     if  v-record-modified = false
    11850     and v-create-part = false
    11851     then do:
    11852       return .
    11853     end.
    11854     define variable v-root-node as integer no-undo .
    11855     define buffer buf_parts    for x_parts .
    11856     define buffer buf_goods    for ub.goods .
    11857     define buffer buf_doc-line for ub.doc-line .
    11858     define buffer buf_trn-doc  for ub.trn-doc .
    11859     do
    11860     transaction
    11861     on error undo, return error
    11862     :
    11863       if v-can-change-part-code
    11864       then do:
    11865         run validate-part-code in this-procedure
    11866           (input v-new-parts-part-code
    11867           ,input v-parts-recid
    11868           ,input p-doc-code
    11869           ,input p-gds-code
    11870           ,input v-goods-serial
    11871           ) no-error .
    11872         if error-status :error
    11873         then do:
    11874           apply 'entry':u to x_parts.part-code in frame Dialog-Frame .
    11875           undo, return error .
    11876         end.
    11877       end.
    11878       if  x_parts.price-base :sensitive
    11879       then do:
    11880         if decimal(x_parts.price-base :screen-value) = ?
    11881         then do:
    11882           message
    11883             substitute("Не задана учётная цена (&1)"
    11884                       ,val-price-base :screen-value
    11885                       ) skip
    11886             view-as alert-box error .
    11887           apply 'entry':u to x_parts.price-base .
    11888           undo, return error .
    11889         end.
    11890         if decimal(x_parts.price-base :screen-value) = 0
    11891         then do:
    11892           assign
    11893             v-ok = false
    11894           .
    11895           message
    11896             substitute("Учётная цена (&1) равна нулю"
    11897                       ,val-price-base :screen-value
    11898                       ) skip
    11899             "Партия будет сохранена с нулевой учётной ценой." skip
    11900             "Продолжить?" skip
    11901             view-as alert-box question buttons yes-no update v-ok .
    11902           if v-ok <> true
    11903           then do:
    11904             apply 'entry':u to x_parts.price-base .
    11905             undo, return error .
    11906           end.
    11907         end.
    11908       end.
    11909       if  x_parts.price-rubl :sensitive
    11910       then do:
    11911         if decimal(x_parts.price-rubl :screen-value) = ?
    11912         then do:
    11913           message
    11914             substitute("Не задана учётная цена (&1)"
    11915                       ,val-price-rubl :screen-value
    11916                       ) skip
    11917             view-as alert-box error .
    11918           apply 'entry':u to x_parts.price-rubl .
    11919           undo, return error .
    11920         end.
    11921         if decimal(x_parts.price-rubl :screen-value) = 0
    11922         then do:
    11923           assign
    11924             v-ok = false
    11925           .
    11926           message
    11927             substitute("Учётная цена (&1) равна нулю"
    11928                       ,val-price-rubl :screen-value
    11929                       ) skip
    11930             "Партия будет сохранена с нулевой учётной ценой." skip
    11931             "Продолжить?" skip
    11932             view-as alert-box question buttons yes-no update v-ok .
    11933           if v-ok <> true
    11934           then do:
    11935             apply 'entry':u to x_parts.price-rubl .
    11936             undo, return error .
    11937           end.
    11938         end.
    11939       end.
    11940       if  x_parts.price-cli :sensitive
    11941       then do:
    11942         if decimal(x_parts.price-cli :screen-value) = ?
    11943         then do:
    11944           message
    11945             substitute("Не задана цена поставщика (&1)"
    11946                       ,val-price-cli :screen-value
    11947                       ) skip
    11948             view-as alert-box error .
    11949           apply 'entry':u to x_parts.price-cli .
    11950           undo, return error .
    11951         end.
    11952         if decimal(x_parts.price-cli :screen-value) = 0
    11953         then do:
    11954           assign
    11955             v-ok = false
    11956           .
    11957           message
    11958             substitute("Цена поставщика (&1) равна нулю"
    11959                       ,val-price-cli :screen-value
    11960                       ) skip
    11961             "Партия будет сохранена с нулевой ценой поставщика." skip
    11962             "Продолжить?" skip
    11963             view-as alert-box question buttons yes-no update v-ok .
    11964           if v-ok <> true
    11965           then do:
    11966             apply 'entry':u to x_parts.price-cli .
    11967             undo, return error .
    11968           end.
    11969         end.
    11970       end.
    11971       find first buf_trn-doc
    11972         where buf_trn-doc.doc-code = p-doc-code
    11973         .
    11974       find first buf_goods no-lock
    11975         where buf_goods.gds-code = p-gds-code
    11976         .
    11977       find first buf_doc-line no-lock
    11978         where buf_doc-line.doc-code  = p-doc-code
    11979           and buf_doc-line.artic     = buf_goods.artic
    11980           and buf_doc-line.prod-type = buf_goods.prod-type
    11981           and buf_doc-line.prod-code = buf_goods.prod-code
    11982         .
    11983         find first buf_parts
    11984           where recid(buf_parts) = v-parts-recid
    11985           .
    11986       assign
    11987         l-edit-reserv = (buf_parts.out-code = buf_trn-doc.doc-code)
    11988       .
    11989       if buf_parts.in-code = buf_parts.out-code
    11990       then do:
    11991         if x_parts.part-code :sensitive
    11992         then do:
    11993   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
    11995     (input  buf_parts.artic
    11996     ,input  buf_parts.prod-type
    11997     ,input  buf_parts.prod-code
    11998     ,output v-root-node
    11999     )  .
    12000           if v-goods-twounit = true
    12001           then do:
    12002             if length(buf_parts.part-code) > 10
    12003             or index(buf_parts.part-code, '#':U ) > 0
    12004             then do:
    12005               message
    12006                 "Код партии ювелирных изделий должен быть меньше или равен 10 символов" skip
    12007                 "И не должен содержать знак" '#':U skip
    12008                 view-as alert-box error .
    12009               apply 'entry':u to x_parts.part-code .
    12010               undo, return error .
    12011             end.
    12012           end.
    12013           assign
    12014             buf_parts.part-code = string(x_parts.part-code :screen-value)
    12015           .
    12016         end.
    12017         if v-can-change-part-code
    12018         then do:
    12019           if x_parts.price-cli :sensitive
    12020           then do:
    12021             assign
    12022               buf_parts.price-cli = decimal(x_parts.price-cli :screen-value)
    12023             .
    12024           end.
    12025           if fi-vat-pc :sensitive
    12026           then do:
    12027             assign
    12028               buf_parts.vat-pc = decimal(fi-vat-pc :screen-value)
    12029             .
    12030           end.
    12031           if fi-slt-pc :sensitive
    12032           then do:
    12033             assign
    12034               buf_parts.slt-pc = decimal(fi-slt-pc :screen-value)
    12035             .
    12036           end.
    12037           assign
    12038             buf_parts.price-base = decimal(x_parts.price-base :screen-value)
    12039           .
    12040           assign
    12041             buf_parts.price-rubl = decimal(x_parts.price-rubl :screen-value)
    12042           .
    12043           if not( buf_trn-doc.doc-type     = 'при':U
    12044                   and buf_trn-doc.internal = false)
    12045           then do:
    12046             if  buf_parts.cli-base-rate = 1
    12047             and buf_parts.exch-code     = 0
    12048             then do:
    12049               assign
    12050                 buf_parts.price-cli = buf_parts.price-rubl
    12051               .
    12052             end.
    12053             else do:
    12054               message
    12055                 vss-workfile vss-revision vss-description skip
    12056                 "Ошибка при создании партии" skip
    12057                 "Документ" buf_doc-line.price-base skip
    12058                 "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
    12059                 "Для порожденной партии cli-base-rate отличен от 1" skip
    12060                 "cli-base-rate" buf_parts.cli-base-rate skip
    12061                 view-as alert-box error .
    12062               undo, return error .
    12063             end.
    12064           end.
    12065         end.
    12066         define variable v-create-old-return as logical no-undo .
    12067         define variable v-reason as character no-undo .
    12068         assign
    12069           v-create-old-return = false
    12070         .
    12071         if x_parts.cst-code :sensitive
    12072         then do:
    12073           assign
    12074             buf_parts.cst-code = string(x_parts.cst-code :screen-value)
    12075           .
    12076         end.
    12077         if x_parts.last-date :sensitive
    12078         then do:
    12079           assign
    12080             buf_parts.last-date = date(x_parts.last-date :screen-value)
    12081           .
    12082         end.
    12083         if  v-can-change-supp = true
    12084         and v-is-fin          = true
    12085         then do:
    12086           assign
    12087             buf_parts.contract-code = v-contract-code
    12088           .
    12089         end.
    12090         if v-can-change-supp = true
    12091         then do:
    12092           assign
    12093             buf_parts.exch-code = v-exch-code
    12094           .
    12095           if x_parts.price-cli :sensitive
    12096           then do:
    12097             assign
    12098               buf_parts.price-cli = input frame Dialog-Frame x_parts.price-cli
    12099             .
    12100           end.
    12101         end.
    12102         if buf_parts.contract-code = ?
    12103         then do:
    12104           message
    12105             vss-workfile vss-revision vss-description skip
    12106             "Ошибка заведения партии" skip
    12107             "Номер контракта имеет неопределённое значение" skip
    12108             view-as alert-box error .
    12109           undo, return error return-value .
    12110         end.
    12111         if  v-is-fin = false
    12112         and buf_parts.contract-code <> 0
    12113         then do:
    12114           message
    12115             "В системе отсутствует АРМ взаиморасчёты" skip
    12116             "Нельзя задавать контракт для партии" skip
    12117             view-as alert-box error .
    12118           undo, return error return-value .
    12119         end.
    12120         if  v-is-fin   = true
    12121         and v-contract = true
