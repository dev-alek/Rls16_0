    12592   PROCEDURE validate-contract :
    12593     define variable v-host-code as integer   no-undo .
    12594     define buffer buf_trn-doc for ub.trn-doc .
    12595     define buffer buf_contract for ub.contract .
    12596     do
    12597     on error undo, return error return-value
    12598     :
    12599       find first buf_trn-doc no-lock
    12600         where buf_trn-doc.doc-code = p-doc-code
    12601         .
    12602   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12603   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    12604     (input  buf_trn-doc.obj-type
    12605     ,input  buf_trn-doc.obj-code
    12606     ,output v-host-code
    12607     )  .
    12608       if input frame Dialog-Frame fi-contract-prn-code <> fi-contract-prn-code
    12609       then do:
    12610         run validate-supp in this-procedure
    12611           (input (input frame Dialog-Frame x_parts.supp-type)
    12612           ,input (input frame Dialog-Frame x_parts.supp-code)
    12613           ) no-error .
    12614         if error-status :error
    12615         then do:
    12616           message
    12617             "Неправильно задан поставщик" skip
    12618             "" (input frame Dialog-Frame x_parts.supp-type)
    12619               (input frame Dialog-Frame x_parts.supp-code) skip
    12620             view-as alert-box error .
    12621           undo, return no-apply .
    12622         end.
    12623         run check-contract-code in this-procedure
    12624           (input  "input":u
    12625           ,input  v-host-code
    12626           ,input  (input frame Dialog-Frame x_parts.supp-type)
    12627           ,input  (input frame Dialog-Frame x_parts.supp-code)
    12628           ,input  input frame Dialog-Frame fi-contract-prn-code
    12629           ,input  parparentproc
    12630           ,input  buf_trn-doc.doc-date
    12631           ,input  ""
    12632           ,output v-contract-code
    12633           ) no-error .
    12634         if error-status :error
    12635         or v-contract-code = ?
    12636         then do:
    12637           if return-value <> ""
    12638           or error-status :get-message(1) <> ""
    12639           then do:
    12640             message
    12641               "Ошибка при заведении номера договора." skip
    12642               return-value skip
    12643               error-status :get-message(1)
    12644             view-as alert-box error .
    12645           end.
    12646           return error .
    12647         end.
    12648         assign
    12649           v-modified-contract-code = true
    12650         .
    12651         if v-contract-code <> 0
    12652         then do:
    12653           find first buf_contract no-lock
    12654             where buf_contract.host-code     = v-host-code
    12655               and buf_contract.contract-code = v-contract-code
    12656             .
    12657           display
    12658             buf_contract.contract-prn-code @ fi-contract-prn-code
    12659             substitute("&1 Вн.н. &2"
    12660                       ,string(buf_contract.contract-date,'99/99/9999':u)
    12661                       ,v-contract-code) @ fi-contract-name
    12662             with frame Dialog-Frame .
    12663           assign
    12664             v-enable-cli-exch-code = false
    12665             v-modified-exch-code   = true
    12666             v-exch-code            = buf_contract.curr-code
    12667           .
    12668           run update-exch-code-dependent in this-procedure .
    12669           run update-enable-price-cli    in this-procedure .
    12670           run update-exch-code-enable    in this-procedure .
    12671         end.
    12672         else do:
    12673           display
    12674             "" @ fi-contract-prn-code
    12675             "" @ fi-contract-name
    12676             with frame Dialog-Frame .
    12677           assign
    12678             v-enable-cli-exch-code = true
    12679             v-modified-exch-code   = true
    12680             v-exch-code            = 0
    12681           .
    12682           run update-exch-code-dependent in this-procedure .
    12683           run update-enable-price-cli    in this-procedure .
    12684           run update-exch-code-enable    in this-procedure .
    12685         end.
    12686         assign
    12687           fi-contract-prn-code
    12688         .
    12689       end.
    12690     end.
    12691   END PROCEDURE.
    12692   PROCEDURE validate-exch-code :
    12693     define buffer buf_currency for ub.currency .
    12694     do
    12695     on error undo, return error return-value
    12696     :
    12697       if input frame Dialog-Frame x_parts.exch-code <> v-exch-code
    12698       then do:
    12699         find first buf_currency no-lock
    12700           where buf_currency.curr-code = input frame Dialog-Frame x_parts.exch-code
    12701           no-error .
    12702         if not available buf_currency
    12703         then do:
    12704           message
    12705             "Неизвестный код валюты" skip
    12706             "Код валюты" input frame Dialog-Frame x_parts.exch-code skip
    12707             view-as alert-box error .
    12708           apply 'entry':u to x_parts.exch-code in frame Dialog-Frame .
    12709           undo, return error return-value .
    12710         end.
    12711         else do:
    12712           assign
    12713             v-modified-exch-code          = true
    12714             v-exch-code                   = buf_currency.curr-code
    12715           .
    12716           run update-exch-code-dependent in this-procedure .
    12717           run update-exch-code-enable    in this-procedure .
    12718         end.
    12719       end.
    12720     end.
    12721   END PROCEDURE.
    12722   PROCEDURE validate-part-code :
    12723     define input parameter p-new-part-code  as character no-undo .
    12724     define input parameter p-parts-recid    as recid     no-undo .
    12725     define input parameter p-doc-code       as character no-undo .
    12726     define input parameter p-gds-code       as integer   no-undo .
    12727     define input parameter p-goods-serial   as logical   no-undo .
    12728     define buffer buf_goods    for ub.goods .
    12729     define buffer buf_doc-line for ub.doc-line .
    12730     define buffer lookup_parts for x_parts .
    12731     find first buf_goods no-lock
    12732       where buf_goods.gds-code = p-gds-code
    12733       .
    12734     find first buf_doc-line no-lock
    12735       where buf_doc-line.doc-code  = p-doc-code
    12736         and buf_doc-line.artic     = buf_goods.artic
    12737         and buf_doc-line.prod-type = buf_goods.prod-type
    12738         and buf_doc-line.prod-code = buf_goods.prod-code
    12739       .
    12740     find first lookup_parts no-lock
    12741       where lookup_parts.obj-type  = buf_doc-line.obj-type
    12742         and lookup_parts.obj-code  = buf_doc-line.obj-code
    12743         and lookup_parts.artic     = buf_doc-line.artic
    12744         and lookup_parts.prod-type = buf_doc-line.prod-type
    12745         and lookup_parts.prod-code = buf_doc-line.prod-code
    12746         and lookup_parts.in-code   = buf_doc-line.doc-code
    12747         and lookup_parts.out-code  = buf_doc-line.doc-code
    12748         and lookup_parts.part-code = p-new-part-code
    12749         and recid (lookup_parts) <> p-parts-recid
    12750       no-error .
    12751     if available lookup_parts
    12752     then do:
    12753       define variable v-show-part-code as character no-undo .
    12754       if p-new-part-code = '':u
    12755       then do:
    12756         assign
    12757           v-show-part-code = '------':u
    12758         .
    12759       end.
    12760       else do:
    12761         assign
    12762           v-show-part-code = p-new-part-code
    12763         .
    12764       end.
    12765       message
    12766         "Партия с номером <<" + v-show-part-code + ">> уже есть"
    12767         view-as alert-box error .
    12768       undo, return error .
    12769     end.
    12770     if  p-goods-serial  = true
    12771     and p-new-part-code = ""
    12772     then do:
    12773       message
    12774         "Для серийных товаров - серийный номер обязателен"
    12775         view-as alert-box error .
    12776       undo, return error .
    12777     end.
    12778   END PROCEDURE.
    12779   PROCEDURE validate-qnty :
    12780   define buffer bufr_parts for ub.parts  .
    12781   define buffer free_parts for ub.parts  .
    12782   define buffer ras_parts for ub.parts  .
    12783   define buffer rez_parts for ub.parts  .
    12784   define buffer buf_goods  for ub.goods  .
    12785   define variable v-delta as decimal   no-undo .
    12786   define variable v-rashod as decimal   no-undo .
    12787   define variable v-rezerv as decimal   no-undo .
    12788   define variable v-qnty  as decimal   no-undo .
    12789   v-qnty = decimal ( x_parts.cli-qnty :screen-value in frame Dialog-Frame ) *
    12790            decimal ( x_parts.cli-base-rate :screen-value in frame Dialog-Frame ) .
    12791   find first buf_goods no-lock
    12792     where buf_goods.gds-code = p-gds-code no-error .
    12793       find first bufr_parts no-lock where
    12794                  bufr_parts.artic = buf_goods.artic and
    12795                  bufr_parts.prod-type = buf_goods.prod-type and
    12796                  bufr_parts.prod-code = buf_goods.prod-code and
    12797                  bufr_parts.in-code   = p-in-code and
    12798                  bufr_parts.part-code = p-part-code and
    12799                  bufr_parts.out-code  = p-out-code
    12800         no-error .
    12801     if bufr_parts.fact-qnty < v-qnty then do:
    12802        message
    12803        "Изменить Количество можно только в меньшую сторону !!!"
    12804        view-as alert-box information .
    12805        return error .
    12806     end.
    12807     v-delta = bufr_parts.cli-qnty - v-qnty .
    12808       v-rashod =  0 .
    12809       find first ras_parts no-lock where
    12810                  ras_parts.artic     = buf_goods.artic and
    12811                  ras_parts.prod-type = buf_goods.prod-type and
    12812                  ras_parts.prod-code = buf_goods.prod-code and
    12813                  ras_parts.in-code   = p-in-code and
    12814                  ras_parts.part-code = p-part-code and
    12815                  ras_parts.out-code  = 'out-zone':U and
    12816                  ras_parts.rsrv-free = no
    12817         no-error .
    12818     if available ras_parts  then do:
    12819         v-rashod = ras_parts.fact-qnty .
    12820     end.
    12821       v-rezerv = 0 .
    12822       for each rez_parts no-lock where
    12823               rez_parts.artic     = buf_goods.artic and
    12824               rez_parts.prod-type = buf_goods.prod-type and
    12825               rez_parts.prod-code = buf_goods.prod-code and
    12826               rez_parts.in-code   = p-in-code and
    12827               rez_parts.part-code = p-part-code and
    12828               rez_parts.out-code <> p-in-code and
    12829               rez_parts.out-code <> 'free-zone':U and
    12830               rez_parts.status_    = false  and
    12831               rez_parts.rsrv-free = true :
    12832           v-rezerv = v-rezerv + rez_parts.fact-qnty .
    12833       end.
    12834      v-rashod = v-rashod + v-rezerv .
    12835     if v-rashod > v-qnty then do:
    12836        message
    12837        "Израсходовано больше чем в приходе "  skip
    12838        "Израсходовано и зарезервировано :" v-rashod "(" v-rezerv ")"
    12839        view-as alert-box information .
    12840        return error .
    12841     end.
    12842   END PROCEDURE.
    12843   PROCEDURE validate-supp :
    12844     define input parameter p-supp-type like x_parts.supp-type no-undo .
    12845     define input parameter p-supp-code like x_parts.supp-code no-undo .
    12846     def buffer buf_supp-clients for clients .
    12847     define variable v-create-old-return as logical   no-undo .
    12848     define variable v-reason            as character no-undo .
    12849     do
    12850     on error undo, return error return-value
    12851     :
    12852       if  v-supp-type = p-supp-type
    12853       and v-supp-code = p-supp-code
    12854       then do:
    12855         return .
    12856       end.
    12857       find buf_supp-clients  no-lock
    12858         where buf_supp-clients.obj-type = p-supp-type
    12859           and buf_supp-clients.obj-code = p-supp-code
    12860         no-error.
    12861       if not available buf_supp-clients
    12862       then do:
    12863         if p-supp-type = ""
    12864         or p-supp-type = ?
    12865         or p-supp-code = 0
    12866         or p-supp-code = ?
    12867         then do:
    12868           message
    12869             "Не задан тип или код поставщика" skip
    12870             p-supp-type p-supp-code skip
    12871             view-as alert-box information .
    12872         end.
    12873         else do:
    12874           message
    12875             "Неправильный код или тип поставщика" skip
    12876             p-supp-type p-supp-code skip
    12877             view-as alert-box information .
    12878         end.
    12879         apply 'entry':u to x_parts.supp-type in frame Dialog-Frame.
    12880         return error.
    12881       end.
    12882       if buf_supp-clients.stts <> 0
    12883       then do:
    12884         message
    12885           "Клиент" buf_supp-clients.obj-name "удален" skip
    12886           "Выберите другого клиента" skip
    12887           view-as alert-box information .
    12888         return error .
    12889       end.
    12890       define buffer buf_trn-doc for ub.trn-doc .
    12891       find first buf_trn-doc no-lock
    12892         where buf_trn-doc.doc-code = p-doc-code
    12893         .
    12894       run partscr_check-valid-supp in this-procedure
    12895         (input  p-supp-type
    12896         ,input  p-supp-code
    12897         ,input
    12898           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
    12899         ,input
    12900           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
    12901         ,input  buf_trn-doc.ext-doc-type
    12902         ,output v-create-old-return
    12903         ,output v-reason
    12904         ).
    12905       if v-reason <> ""
    12906       then do:
    12907         message
    12908           v-reason
    12909           view-as alert-box error .
    12910         undo, return error .
    12911       end.
    12912       assign
    12913         v-supp-type = p-supp-type
    12914         v-supp-code = p-supp-code
    12915       .
    12916       run clear-contract-value in this-procedure .
    12917       assign
    12918         fi-supp :screen-value = buf_supp-clients.obj-name
    12919         fi-supp :modified     = false
    12920       .
    12921       if v-create-old-return = true
    12922       then do:
    12923         assign
    12924           v-display-price-cli    = true
    12925           v-enable-price-cli     = true
    12926           v-enable-cli-exch-code = true
    12927         .
    12928         if v-is-fin = true
    12929         then do:
    12930           assign
    12931             v-enable-contract    = true
    12932           .
    12933         end.
    12934         else do:
    12935           assign
    12936             v-enable-contract    = false
    12937           .
    12938         end.
    12939       end.
    12940       else do:
    12941         assign
    12942           v-display-price-cli    = false
    12943           v-enable-price-cli     = false
    12944           v-enable-cli-exch-code = false
    12945           v-enable-contract      = false
    12946         .
    12947       end.
    12948       run update-enable-price-cli in this-procedure .
    12949       run update-exch-code-enable in this-procedure .
    12950     end.
    12951   END PROCEDURE.
