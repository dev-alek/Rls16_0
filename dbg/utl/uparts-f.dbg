     5702   procedure partcopy-rsrv-parts :
     5703     define input  parameter p-doc-code-rowid as rowid no-undo .
     5704     define input  parameter p-parts-rowid    as rowid no-undo .
     5705     define input  parameter p-rsrv-direction as logical   no-undo .
     5706     define input  parameter p-goods-twounit  as logical   no-undo .
     5707     define input  parameter p-is-hold        as logical   no-undo .
     5708     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     5709     define buffer buf_trn-doc for ub.trn-doc .
     5710     define buffer archive_parts for ub.parts .
     5711     define buffer buf_parts   for ub.parts .
     5712     define buffer orig_marking-lines for ub.marking-lines .
     5713     define buffer buf_marking-lines for ub.marking-lines .
     5714     define buffer buf_marking   for ub.marking .
     5715     define buffer buf_goods for ub.goods .
     5716     define variable v-rsrv-code as character no-undo .
     5717     do
     5718     on error undo, return error return-value
     5719     :
     5720       find first buf_trn-doc no-lock
     5721         where rowid(buf_trn-doc) = p-doc-code-rowid
     5722         no-error .
     5723       if not available buf_trn-doc
     5724       then do:
     5725         message
     5726           vss-workfile vss-revision vss-description skip
     5727           vss-include-info23 skip
     5728           "Ошибка задания входных параметров" skip
     5729           "Не найден документ" skip
     5730           "Документ" string(p-doc-code-rowid) skip
     5731           "Партия" string(p-parts-rowid) skip
     5732           error-status :get-message(1) skip
     5733           return-value skip
     5734           view-as alert-box error .
     5735         undo, return error .
     5736       end.
     5737       find first archive_parts
     5738         where rowid(archive_parts) = p-parts-rowid
     5739         no-error .
     5740       if not available archive_parts
     5741       then do:
     5742         message
     5743           vss-workfile vss-revision vss-description skip
     5744           vss-include-info23 skip
     5745           "Ошибка задания входных параметров" skip
     5746           "Не найдена партия" skip
     5747           "Документ" string(p-doc-code-rowid) skip
     5748           "Партия" string(p-parts-rowid) skip
     5749           error-status :get-message(1) skip
     5750           return-value skip
     5751           view-as alert-box error .
     5752         undo, return error .
     5753       end.
     5754       if  archive_parts.out-code <> archive_parts.in-code
     5755       and archive_parts.qnty <> 0
     5756       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     5757       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     5758       then do:
     5759         assign
     5760           v-rsrv-code =
     5761           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     5762         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     5763         then 'free-zone':U
     5764         else 'out-zone':U )
     5765         .
     5766         run partcopy in this-procedure
     5767           (input  true
     5768           ,input  v-rsrv-code
     5769           ,buffer archive_parts
     5770           ,buffer buf_parts
     5771           ,input  "news"
     5772           ) no-error .
     5773         if error-status :error
     5774         then do:
     5775           message
     5776             vss-workfile vss-revision vss-description skip
     5777             vss-include-info23 skip
     5778             "Ошибка при создании партии" skip
     5779             "Документ" buf_trn-doc.doc-code skip
     5780             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     5781             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     5782             "Партия" archive_parts.in-code archive_parts.part-code skip
     5783             "Количество" archive_parts.qnty skip
     5784             "Резерв" v-rsrv-code skip
     5785             error-status :get-message(1) skip
     5786             return-value skip
     5787             view-as alert-box error .
     5788           undo, return error .
     5789         end.
     5790         assign
     5791           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     5792                                                     * (if p-rsrv-direction = true
     5793                                                       then 1
     5794                                                       else -1
     5795                                                       )
     5796           buf_parts.fact-qnty = buf_parts.qnty
     5797         .
     5798         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     5799                                        and buf_goods.prod-type = archive_parts.prod-type
     5800                                        and buf_goods.prod-code = archive_parts.prod-code
     5801                                        .
     5802         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5803                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     5804                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     5805                                               and orig_marking-lines.in-code    = archive_parts.in-code
     5806                                               and orig_marking-lines.out-code   = archive_parts.out-code
     5807                                               and orig_marking-lines.part-code  = archive_parts.part-code
     5808                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     5809                                               :
     5810           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     5811                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     5812                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     5813                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     5814                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     5815                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     5816                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     5817                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     5818                                                   no-error .
     5819           if available buf_marking-lines
     5820           then do :
     5821             find current buf_marking-lines exclusive-lock .
     5822             delete buf_marking-lines .
     5823             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5824               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     5825             end .
     5826           end .
     5827           else do :
     5828             create buf_marking-lines .
     5829             assign
     5830               buf_marking-lines.mark       = orig_marking-lines.mark
     5831               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     5832               buf_marking-lines.gds-code   = buf_goods.gds-code
     5833               buf_marking-lines.obj-type   = buf_parts.obj-type
     5834               buf_marking-lines.obj-code   = buf_parts.obj-code
     5835               buf_marking-lines.in-code    = buf_parts.in-code
     5836               buf_marking-lines.out-code   = buf_parts.out-code
     5837               buf_marking-lines.part-code  = buf_parts.part-code
     5838               buf_marking-lines.prt-code   = buf_parts.prt-code
     5839             .
     5840             if buf_parts.out-code <> buf_parts.in-code
     5841             and buf_parts.out-code <> 'free-zone':U
     5842             and buf_parts.out-code <> 'out-zone':U
     5843             then do :
     5844               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     5845               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     5846             end .
     5847             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5848               assign
     5849                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     5850                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     5851               .
     5852             end .
     5853           end .
     5854           release buf_marking-lines no-error .
     5855         end.
     5856         if p-goods-twounit = true
     5857         then do:
     5858           assign
     5859             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     5860                                                     * (if p-rsrv-direction = true
     5861                                                       then 1
     5862                                                       else -1
     5863                                                       )
     5864           .
     5865         end.
     5866         if  buf_parts.qnty      = 0
     5867         and buf_parts.fact-qnty = 0
     5868         then do:
     5869           if p-goods-twounit = true
     5870           then do:
     5871             if buf_parts.cli-qnty <> 0
     5872             then do:
     5873               message
     5874                 vss-workfile vss-revision vss-description skip
     5875                 vss-include-info23 skip
     5876                 "Ошибка при удалении партии" skip
     5877                 "Документ" buf_trn-doc.doc-code skip
     5878                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     5879                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     5880                 "Партия" buf_parts.in-code buf_parts.part-code skip
     5881                 "Резерв" buf_parts.out-code skip
     5882                 "qnty" buf_parts.qnty skip
     5883                 "fact-qnty" buf_parts.fact-qnty skip
     5884                 "cli-qnty" buf_parts.cli-qnty skip
     5885                 view-as alert-box error .
     5886               undo, return error .
     5887             end.
     5888           end.
     5889           delete buf_parts .
     5890         end.
     5891       end.
     5892     end.
     5893   end procedure.
     5894   procedure partcopy-update-doc-line-tot-fact :
     5895     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     5896     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     5897     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     5898     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     5899     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     5900       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     5901     define buffer buf_doc-line for ub.doc-line .
     5902     do
     5903     on error undo, return error return-value
     5904     :
     5905       find first buf_doc-line exclusive-lock
     5906         where buf_doc-line.doc-code  = p-doc-code
     5907           and buf_doc-line.artic     = p-artic
     5908           and buf_doc-line.prod-type = p-prod-type
     5909           and buf_doc-line.prod-code = p-prod-code
     5910         no-error .
     5911       if error-status :error
     5912       then do:
     5913         message
     5914           vss-workfile vss-revision vss-description skip
     5915           vss-include-info23 skip
     5916           "Ошибка задания входных параметров" skip
     5917           "Не найдена строка документа" skip
     5918           "Документ" p-doc-code skip
     5919           "Артикул" p-artic p-prod-type p-prod-code skip
     5920           error-status :get-message(1) skip
     5921           return-value skip
     5922           view-as alert-box error .
     5923         undo, return error .
     5924       end.
     5925       run partrqst in this-procedure
     5926         (input buf_doc-line.doc-code
     5927         ,input buf_doc-line.obj-type
     5928         ,input buf_doc-line.obj-code
     5929         ,input buf_doc-line.artic
     5930         ,input buf_doc-line.prod-type
     5931         ,input buf_doc-line.prod-code
     5932               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     5933         ) no-error .
     5934       if error-status :error
     5935       then do:
     5936         message
     5937           vss-workfile vss-revision vss-description skip
     5938           vss-include-info23 skip
     5939           "Ошибка при сборе информации по партиям" skip
     5940           "Документ" p-doc-code skip
     5941           "Артикул" p-artic p-prod-type p-prod-code skip
     5942           view-as alert-box error .
     5943         undo, return error .
     5944       end.
     5945       if v-total-parts-fact-qnty <> 0
     5946       then do:
     5947         assign
     5948           buf_doc-line.price-base      = v-total-parts-price-base
     5949                                        / v-total-parts-fact-qnty
     5950           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     5951                                        / v-total-parts-fact-qnty
     5952           buf_doc-line.transport-base  = v-total-parts-transport-base
     5953                                        / v-total-parts-fact-qnty
     5954           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     5955                                        / v-total-parts-fact-qnty
     5956           buf_doc-line.other-base      = v-total-parts-other-base
     5957                                        / v-total-parts-fact-qnty
     5958           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     5959                                        / v-total-parts-fact-qnty
     5960         .
     5961       end.
     5962       else do:
     5963       end.
     5964     end.
     5965   end procedure.
     5966   procedure partcopy-change-purch-code :
     5967     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     5968     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     5969     define parameter buffer buf_orig_parts     for ub.parts .
     5970     define parameter buffer buf1_parts         for ub.parts .
     5971     define parameter buffer buf2_parts         for ub.parts .
     5972     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     5973     define variable var-out-code  like ub.parts.out-code no-undo .
     5974     define variable var-part-code like ub.parts.part-code no-undo .
     5975     define buffer buf_goods        for ub.goods .
     5976     define buffer buf_parts-root   for ub.parts-root.
     5977     define buffer buf_trn-doc      for ub.trn-doc.
     5978     define buffer buf-orig_trn-doc for ub.trn-doc.
     5979     define buffer buf_units        for ub.units .
     5980     do
     5981     on error undo, return error return-value
     5982     :
     5983       if buf_orig_parts.out-code = p-in-code
     5984       then do:
     5985         message
     5986           vss-workfile vss-revision vss-description skip
     5987           vss-include-info23 skip
     5988           "Ошибка задания входных параметров процедуры partcopy" skip
     5989           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     5990           "p-in-code" p-in-code skip
     5991           view-as alert-box error .
     5992         undo, return error .
     5993       end.
     5994       find first buf_trn-doc no-lock
     5995         where buf_trn-doc.doc-code = p-in-code
     5996         .
     5997       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     5998       find first buf_goods no-lock
     5999         where buf_goods.artic = buf_orig_parts.artic
     6000           and buf_goods.prod-type = buf_orig_parts.prod-type
     6001           and buf_goods.prod-code = buf_orig_parts.prod-code
     6002         .
     6003       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     6004       find first buf1_parts exclusive-lock
     6005         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     6006           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     6007           and buf1_parts.artic     = buf_orig_parts.artic
     6008           and buf1_parts.prod-type = buf_orig_parts.prod-type
     6009           and buf1_parts.prod-code = buf_orig_parts.prod-code
     6010           and buf1_parts.in-code   = buf_orig_parts.in-code
     6011           and buf1_parts.out-code  = p-in-code
     6012           and buf1_parts.part-code = buf_orig_parts.part-code
     6013         no-error.
     6014       if not available buf1_parts
     6015       then do:
     6016         create buf1_parts .
     6017         buffer-copy buf_orig_parts to buf1_parts
     6018         assign
     6019           buf1_parts.in-code    = buf_orig_parts.in-code
     6020           buf1_parts.out-code   = p-in-code
     6021           buf1_parts.status_    = no
     6022           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6023           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6024           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     6025           buf1_parts.purch-code = buf_orig_parts.purch-code
     6026           buf1_parts.rsrv-free  = ?
     6027           buf1_parts.status_    = yes
     6028         .
     6029         validate buf1_parts .
     6030       end.
     6031       if  lookup('сер':U, buf_units.type) > 0
     6032       then do:
     6033          var-part-code = buf_orig_parts.part-code.
     6034       end.
     6035       else do:
     6036           run holdprts-get-part-code in this-procedure
     6037             (input  p-in-code
     6038             ,output var-part-code
     6039             ) no-error .
     6040           if error-status :error
     6041           then dO:
     6042             undo, return error return-value.
     6043           end.
     6044       end.
     6045       find first buf2_parts exclusive-lock
     6046         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     6047           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     6048           and buf2_parts.artic     = buf_orig_parts.artic
     6049           and buf2_parts.prod-type = buf_orig_parts.prod-type
     6050           and buf2_parts.prod-code = buf_orig_parts.prod-code
     6051           and buf2_parts.in-code   = p-in-code
     6052           and buf2_parts.out-code  = p-in-code
     6053           and buf2_parts.part-code = var-part-code
     6054         no-error.
     6055       if not available buf2_parts
     6056       then do:
     6057         create buf2_parts .
     6058         buffer-copy buf_orig_parts to buf2_parts
     6059         assign
     6060           buf2_parts.in-code   = p-in-code
     6061           buf2_parts.out-code  = p-in-code
     6062           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6063           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6064           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     6065           buf2_parts.purch-code = p-dest-purch-code
     6066           buf2_parts.part-code  = var-part-code
     6067           buf2_parts.rsrv-free  = ?
     6068           buf2_parts.status_    = yes
     6069         .
     6070         validate buf2_parts .
     6071       end.
     6072       assign
     6073         buf_orig_parts.in-code    = p-in-code
     6074         buf_orig_parts.part-code  = buf2_parts.part-code
     6075         buf_orig_parts.purch-code = buf2_parts.purch-code
     6076       .
     6077       find first buf_parts-root
     6078         where buf_parts-root.doc-code       = p-in-code
     6079           and buf_parts-root.in-code        = p-in-code
     6080           and buf_parts-root.gds-code       = buf_goods.gds-code
     6081           and buf_parts-root.part-code      = buf2_parts.part-code
     6082           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     6083           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6084           and buf_parts-root.orig-part-code = buf1_parts.part-code
     6085         no-error .
     6086       if not available buf_parts-root
     6087       then do:
     6088         create buf_parts-root.
     6089         assign
     6090         buf_parts-root.doc-code       = p-in-code
     6091         buf_parts-root.in-code        = p-in-code
     6092         buf_parts-root.gds-code       = buf_goods.gds-code
     6093         buf_parts-root.part-code      = buf2_parts.part-code
     6094         buf_parts-root.orig-in-code   = buf1_parts.in-code
     6095         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6096         buf_parts-root.orig-part-code = buf1_parts.part-code
     6097         .
     6098       end.
     6099     end.
     6100   end procedure.
     6101   procedure addChildMarkingLines:
     6102     define input parameter iMark as character no-undo.
     6103     define input parameter iSts  as integer   no-undo.
     6104     define parameter buffer buf_marking-lines  for ub.marking-lines.
     6105     define parameter buffer buf_parts          for ub.parts.
     6106     define parameter buffer orig_marking-lines for ub.marking-lines.
     6107     define parameter buffer buf_orig_parts     for ub.parts.
     6108     define parameter buffer buf_goods          for ub.goods.
     6109     define buffer buf_marking-childs        for ub.marking.
     6110     define buffer buf_marking-lines-childs  for ub.marking-lines.
     6111     define buffer buf_marking-chk           for ub.marking-chk.
     6112     define buffer buf_chk-doc               for ub.chk-doc.
     6113     define buffer orig_marking-lines-childs for ub.marking-lines.
     6114     for each buf_marking-childs exclusive-lock where
     6115              buf_marking-childs.mark-parent = iMark :
     6116         find first buf_marking-lines-childs no-lock where
     6117                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6118                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6119                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6120                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6121                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6122                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6123                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6124                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6125         no-error .
     6126         if not available buf_marking-lines-childs then
     6127         do:
     6128           create buf_marking-lines-childs .
     6129           assign
     6130             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6131             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6132             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6133             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6134             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6135             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6136             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6137             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6138             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     6139             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     6140           .
     6141           validate buf_marking-childs.
     6142         end .
     6143         buf_marking-childs.sts = iSts .
     6144         for each buf_marking-chk exclusive-lock where
     6145                  buf_marking-chk.mark begins buf_marking-childs.mark
     6146         :
     6147           for first buf_chk-doc no-lock where
     6148                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     6149                 and buf_chk-doc.out-code = buf_parts.out-code
     6150           :
     6151             buf_marking-chk.sts = 0 .
     6152             validate buf_marking-chk.
     6153           end .
     6154         end .
     6155         if available orig_marking-lines
     6156         then do :
     6157           find first orig_marking-lines-childs exclusive-lock where
     6158                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     6159                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     6160                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     6161                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     6162                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     6163                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     6164                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     6165                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     6166           no-error .
     6167           if available orig_marking-lines-childs then
     6168             delete orig_marking-lines-childs .
     6169         end.
     6170         run addChildMarkingLines in this-procedure (
     6171           buf_marking-childs.mark,
     6172           iSts,
     6173           buffer buf_marking-lines,
     6174           buffer buf_parts,
     6175           buffer orig_marking-lines,
     6176           buffer buf_orig_parts,
     6177           buffer buf_goods
     6178         ).
     6179     end .
     6180   end.
     6181   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6182   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6183   define new global shared variable g#trdcalib as handle no-undo.
     6184   function stsMarkWhenDeleteGoods returns integer
     6185       (input iDocCode as character,
     6186        input iMark as character):
     6187     define variable vValue as character no-undo.
     6188     define variable vType as character no-undo.
     6189     define buffer buf_trn-doc for ub.trn-doc.
     6190     define buffer buf_c-marking for ub.c-marking.
     6191     if iDocCode <> ? then
     6192     do:
     6193         find first buf_trn-doc no-lock where
     6194                    buf_trn-doc.doc-code = iDocCode no-error.
     6195         if avail buf_trn-doc then
     6196         do:
     6197   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6198                           input 'is-return':U ,
     6199                          output vValue ,
     6200                          output vType ) no-error .
     6201            if buf_trn-doc.ext-doc-type = 'we':U or
     6202               buf_trn-doc.ext-doc-type = 'ev':U or
     6203               vValue = "yes" then
     6204            do:
     6205              find last buf_c-marking no-lock where
     6206                        buf_c-marking.mark = iMark
     6207                   use-index pi-2 no-error.
     6208              if avail buf_c-marking and
     6209                      (buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB or
     6210                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB or
     6211                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB or
     6212                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:Moved:KeyIntDB or
     6213                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB) then
     6214                return buf_c-marking.sts .
     6215            end.
     6216         end.
     6217     end.
     6218     return objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     6219   end function.
     6220   procedure partrsrv :
     6221     define input parameter  p-chg-qnty      as decimal   no-undo .
     6222     define input parameter  p-goods-serial  as logical   no-undo .
     6223     define input parameter  p-goods-twounit as logical   no-undo .
     6224     define input parameter  p-unreserv-only as logical   no-undo .
     6225     define parameter buffer buf_orig_parts  for ub.parts .
     6226     define parameter buffer buf_trn-doc     for ub.trn-doc .
     6227     define output parameter p-real-chg-qnty as decimal   no-undo .
     6228     define output parameter p-parts-recid   as recid     no-undo .
     6229     define input  parameter p-mark          as character  no-undo .
     6230     define variable vss-description as character no-undo init "$Workfile$ Резервирование и снятие резервов по одной партии".
     6231     define buffer buf_parts  for ub.parts .
     6232     define buffer rsrv-parts for ub.parts .
     6233     define buffer unrsrv-parts for ub.parts .
     6234     define buffer buf_parts-attr for ub.parts-attr .
     6235     define buffer free_marking-lines for ub.marking-lines .
     6236     define variable lok                as logical   no-undo .
     6237     define variable v-sign-chg-qnty    as integer   no-undo .
     6238     define variable v-sign-rsrv-qnty   as integer   no-undo .
     6239     define variable v-rsrv-qnty        as decimal   no-undo .
     6240     define variable v-orig-unrsrv-code as character no-undo .
     6241     define variable v-new-rsrv-code    as character no-undo .
     6242     define variable v-new-unrsrv-code  as character no-undo .
     6243     define variable v-unrsrv-qnty      as decimal   no-undo .
     6244     define variable v-value-character as character no-undo .
     6245     define variable v-value-date      as date no-undo .
     6246     define variable v-value-decimal   as decimal no-undo .
     6247     define variable v-value-integer   as integer no-undo .
     6248     define variable v-izlcstpr        as logical no-undo .
     6249     define variable v-tth             as handle no-undo .
     6250     define variable v-type            as character no-undo .
     6251     define variable part-key-rec      as character no-undo .
     6252     define variable v-part-code-int   as integer no-undo .
     6253     define variable v-old-part-code   as character no-undo .
     6254     define variable v-part-gds-code   as integer   no-undo .
     6255     do transaction
     6256     on error undo, return error
     6257     :
     6258       if buf_trn-doc.ext-doc-type = 'vt':U
     6259       then do :
     6260           delete object v-tth no-error.
     6261           run adm/shattri.p (
     6262              input "get":U
     6263             ,input buf_orig_parts.obj-type
     6264             ,input buf_orig_parts.obj-code
     6265             ,input 'inv-obj':U
     6266             ,input  "izlcstpr"
     6267             ,output v-value-character
     6268             ,output v-value-date
     6269             ,output v-value-decimal
     6270             ,output v-value-integer
     6271             ,output v-izlcstpr
     6272             ,output v-type
     6273             ,INPUT-OUTPUT table-handle v-tth
     6274             ) no-error .
     6275             delete object v-tth no-error.
     6276           if error-status:error then do:
     6277             v-izlcstpr = false .
     6278           end.
     6279       end.
     6280       else do :
     6281           v-izlcstpr = false .
     6282       end.
     6283       assign
     6284         p-parts-recid = ?
     6285       .
     6286       if p-chg-qnty = 0 then do:
     6287         assign
     6288           p-parts-recid = recid(buf_orig_parts)
     6289         .
     6290         return .
     6291       end.
     6292       assign
     6293         v-sign-chg-qnty = 0
     6294       .
     6295       if p-chg-qnty < 0 then do:
     6296         assign
     6297           v-sign-chg-qnty = -1
     6298         .
     6299       end.
     6300       if p-chg-qnty > 0 then do:
     6301         assign
     6302           v-sign-chg-qnty = 1
     6303         .
     6304       end.
     6305       assign
     6306         v-sign-rsrv-qnty = v-sign-chg-qnty
     6307       .
     6308       if lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 then do:
     6309         assign
     6310           v-sign-rsrv-qnty = - v-sign-chg-qnty
     6311         .
     6312       end.
     6313       run partcopy in this-procedure
     6314         (input  false
     6315         ,input  buf_trn-doc.doc-code
     6316         ,buffer buf_orig_parts
     6317         ,buffer buf_parts
     6318         ,input  p-mark
     6319         ) no-error .
     6320       if error-status :error then do:
     6321         message
     6322           vss-workfile vss-revision vss-description skip
     6323           "Ошибка при создании партии" skip
     6324           "Объект" buf_orig_parts.obj-type buf_orig_parts.obj-code skip
     6325           "Артикул" buf_orig_parts.artic buf_orig_parts.prod-type buf_orig_parts.prod-code skip
     6326           "Партия" buf_orig_parts.in-code buf_orig_parts.part-code skip
     6327           "Резерв" buf_trn-doc.doc-code skip
     6328           error-status :get-message(1) skip
     6329           return-value skip
     6330           view-as alert-box error .
     6331         undo, return error .
     6332       end.
     6333       if buf_parts.in-code = buf_parts.out-code then do:
     6334         assign
     6335           v-rsrv-qnty = abs(p-chg-qnty)
     6336         .
     6337         if buf_trn-doc.doc-type <> 'инв':U then do:
     6338           if buf_parts.qnty < 0
     6339           or buf_parts.fact-qnty < 0 then do:
     6340             message
     6341               vss-workfile vss-revision vss-description skip
     6342               "Резервирование невозможно" skip
     6343               "Партия зарезервированная за обычным документом имеет отрицательное количество" skip
     6344               view-as alert-box error .
     6345             undo, return error .
     6346           end.
     6347           if v-sign-rsrv-qnty < 0 then do:
     6348             assign
     6349               v-rsrv-qnty = min(abs(buf_parts.qnty), v-rsrv-qnty)
     6350             .
     6351           end.
     6352         end.
     6353         assign
     6354           buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     6355           buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     6356         .
     6357         if p-goods-twounit = true
     6358         then do:
     6359           if buf_parts.qnty < 0 then do:
     6360             message
     6361               "Порожденная партия ювелирных изделий не может иметь отрицательное количество" skip
     6362               "Количество" buf_parts.qnty skip
     6363               view-as alert-box error .
     6364             undo, return error .
     6365           end.
     6366           if buf_parts.qnty = 0 then do:
     6367             assign
     6368               buf_parts.cli-qnty = 0
     6369             .
     6370           end.
     6371           if  buf_parts.qnty <> 0
     6372           and buf_parts.cli-qnty <> 1
     6373           then do:
     6374             message
     6375               vss-workfile vss-revision vss-description skip
     6376               "Порожденная партия ювелирных изделий должна иметь определенное клиентское количество" skip
     6377               "qnty" buf_parts.qnty skip
     6378               "cli-qnty" buf_parts.cli-qnty skip
     6379               view-as alert-box error .
     6380             undo, return error .
     6381           end.
     6382         end.
     6383         else do:
     6384           if buf_parts.cli-base-rate <> 0
     6385           then do:
     6386             assign
     6387               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6388             .
     6389           end.
     6390           else do:
     6391             assign
     6392               buf_parts.cli-qnty = 0
     6393             .
     6394           end.
     6395         end.
     6396         assign
     6397           p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     6398           p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     6399         .
     6400       end.
     6401       else do:
     6402         assign
     6403           v-orig-unrsrv-code =
     6404           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     6405         or (buf_trn-doc.doc-type = 'инв':U and buf_parts.qnty < 0)
     6406         then 'free-zone':U
     6407         else 'out-zone':U )
     6408           v-new-rsrv-code    =  ( if p-chg-qnty > 0
     6409                                   then 'free-zone':U
     6410                                   else 'out-zone':U
     6411                                 )
     6412           v-new-unrsrv-code  =  ( if p-chg-qnty > 0
     6413                                   then 'out-zone':U
     6414                                   else 'free-zone':U
     6415                                 )
     6416         .
     6417         if v-new-rsrv-code = v-orig-unrsrv-code then do:
     6418           assign
     6419             v-rsrv-qnty = min(abs(buf_parts.qnty), abs(p-chg-qnty) )
     6420           .
     6421           if v-izlcstpr and buf_parts.out-code <> v-new-rsrv-code and p-chg-qnty > 0
     6422           then do :
     6423               find first rsrv-parts exclusive-lock
     6424                   where rsrv-parts.obj-type  = buf_parts.obj-type
     6425                     and rsrv-parts.obj-code  = buf_parts.obj-code
     6426                     and rsrv-parts.artic     = buf_parts.artic
     6427                     and rsrv-parts.prod-type = buf_parts.prod-type
     6428                     and rsrv-parts.prod-code = buf_parts.prod-code
     6429                     and rsrv-parts.in-code   = buf_parts.out-code
     6430                     and rsrv-parts.out-code  = v-new-rsrv-code
     6431                     and rsrv-parts.part-code = buf_parts.part-code
     6432                   no-error.
     6433           end.
     6434           if not available rsrv-parts
     6435           then do :
     6436               run partcopy in this-procedure
     6437                 (input  true
     6438                 ,input  v-new-rsrv-code
     6439                 ,buffer buf_parts
     6440                 ,buffer rsrv-parts
     6441                 ,input p-mark
     6442                 ) no-error .
     6443               if error-status :error then do:
     6444                 message
     6445                   vss-workfile vss-revision vss-description skip
     6446                   "Ошибка при создании партии" skip
     6447                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6448                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6449                   "Партия" buf_parts.in-code buf_parts.part-code skip
     6450                   "Резерв" v-new-rsrv-code skip
     6451                   error-status :get-message(1) skip
     6452                   return-value skip
     6453                   view-as alert-box error .
     6454                 undo, return error .
     6455               end.
     6456           end.
     6457           if not v-izlcstpr or (v-izlcstpr and p-chg-qnty > 0)
     6458           then
     6459           assign
     6460             rsrv-parts.qnty      = rsrv-parts.qnty      + v-rsrv-qnty
     6461             rsrv-parts.fact-qnty = rsrv-parts.fact-qnty + v-rsrv-qnty
     6462           .
     6463           if p-goods-twounit = true then do:
     6464             assign
     6465               rsrv-parts.cli-qnty = rsrv-parts.cli-qnty + abs(buf_parts.cli-qnty)
     6466             .
     6467           end.
     6468           else do:
     6469             if rsrv-parts.cli-base-rate <> 0
     6470             then do:
     6471               assign
     6472                 rsrv-parts.cli-qnty = rsrv-parts.fact-qnty / rsrv-parts.cli-base-rate
     6473               .
     6474             end.
     6475             else do:
     6476               assign
     6477                 rsrv-parts.cli-qnty = 0
     6478               .
     6479             end.
     6480           end.
     6481           assign
     6482             buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     6483             buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     6484           .
     6485           if p-goods-twounit = true then do:
     6486             assign
     6487               buf_parts.cli-qnty = 0
     6488             .
     6489           end.
     6490           else do:
     6491             if buf_parts.cli-base-rate <> 0
     6492             then do:
     6493               assign
     6494                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6495               .
     6496             end.
     6497             else do:
     6498               assign
     6499                 buf_parts.cli-qnty = 0
     6500               .
     6501             end.
     6502           end.
     6503           assign
     6504             p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     6505             p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     6506           .
     6507         end.
     6508         if p-chg-qnty <> 0
     6509         and (
     6510              (buf_trn-doc.doc-type = 'инв':U
     6511              and p-unreserv-only = false
     6512              )
     6513             or v-new-unrsrv-code = v-orig-unrsrv-code
     6514             )
     6515         then do:
     6516           if v-izlcstpr and buf_parts.out-code <> v-new-unrsrv-code and p-chg-qnty < 0
     6517           then do :
     6518               find first unrsrv-parts exclusive-lock
     6519                   where unrsrv-parts.obj-type  = buf_parts.obj-type
     6520                     and unrsrv-parts.obj-code  = buf_parts.obj-code
     6521                     and unrsrv-parts.artic     = buf_parts.artic
     6522                     and unrsrv-parts.prod-type = buf_parts.prod-type
     6523                     and unrsrv-parts.prod-code = buf_parts.prod-code
     6524                     and unrsrv-parts.in-code   = buf_parts.in-code
     6525                     and unrsrv-parts.out-code  = v-new-unrsrv-code
     6526                     and unrsrv-parts.part-code = buf_parts.part-code
     6527                   no-error.
     6528           end.
     6529           if not available unrsrv-parts
     6530           then do :
     6531               run partcopy in this-procedure
     6532                 (input  true
     6533                 ,input  v-new-unrsrv-code
     6534                 ,buffer buf_parts
     6535                 ,buffer unrsrv-parts
     6536                 ,input  p-mark
     6537                 ) no-error .
     6538               if error-status :error then do:
     6539                 message
     6540                   vss-workfile vss-revision vss-description skip
     6541                   "Ошибка при создании партии" skip
     6542                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6543                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6544                   "Партия" buf_parts.in-code buf_parts.part-code skip
     6545                   "Резерв" v-new-rsrv-code skip
     6546                   error-status :get-message(1) skip
     6547                   return-value skip
     6548                   view-as alert-box error .
     6549                 undo, return error .
     6550               end.
     6551           end.
     6552           assign
     6553             v-unrsrv-qnty = min( (if unrsrv-parts.qnty > 0
     6554                                   then unrsrv-parts.qnty
     6555                                   else 0
     6556                                   )
     6557                             , abs(p-chg-qnty))
     6558           .
     6559           assign
     6560             buf_parts.qnty      = buf_parts.qnty      + v-unrsrv-qnty * v-sign-rsrv-qnty
     6561             buf_parts.fact-qnty = buf_parts.fact-qnty + v-unrsrv-qnty * v-sign-rsrv-qnty
     6562           .
     6563           if p-goods-twounit = true then do:
     6564             assign
     6565               buf_parts.cli-qnty = buf_parts.cli-qnty + unrsrv-parts.cli-qnty * v-sign-rsrv-qnty
     6566             .
     6567           end.
     6568           else do:
     6569             if buf_parts.cli-base-rate <> 0
     6570             then do:
     6571               assign
     6572                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6573               .
     6574             end.
     6575             else do:
     6576               assign
     6577                 buf_parts.cli-qnty = 0
     6578               .
     6579             end.
     6580           end.
     6581           if num-entries(buf_parts.part-code, "_") = 2
     6582           and buf_parts.qnty > 0
     6583           and buf_parts.out-code <> 'free-zone':U
     6584           and buf_parts.out-code <> 'out-zone':U
     6585           and buf_trn-doc.ext-doc-type = 'vt':U
     6586           then do :
     6587             v-old-part-code = buf_parts.part-code .
     6588             v-part-code-int = 0 .
     6589             buf_parts.part-code = entry(2, buf_parts.part-code, "_") no-error .
     6590             do while error-status:error :
     6591               v-part-code-int = v-part-code-int + 1 .
     6592               buf_parts.part-code = string(integer(entry(2, buf_parts.part-code, "_")) + v-part-code-int) no-error .
     6593             end .
     6594   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6595   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6596     (input  buf_parts.artic
