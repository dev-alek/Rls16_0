     9498       define variable v-curr-sv-date as date no-undo .
     9499       define variable v-new-sv-date  as date no-undo .
     9500       assign
     9501         v-curr-sv-date = date(self :screen-value) no-error
     9502       .
     9503       if v-curr-sv-date = ?
