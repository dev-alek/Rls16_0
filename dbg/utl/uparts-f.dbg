      394     define input  parameter p-last-date        as date      no-undo .
      395     define input  parameter p-hold-date        as date      no-undo .
      396     define input  parameter p-pl-code          as integer   no-undo .
      397     define parameter buffer buf_doc-line       for ub.doc-line .
      398     define parameter buffer buf_parts          for ub.parts .
      399     define variable vss-description as character no-undo initial "$Workfile$ $Revision$ Процедура создания партии".
      400     define variable v-price-cli                like ub.doc-line.price-rubl no-undo.
      401     define variable v-price-cli-unit-base      like ub.doc-line.price-rubl no-undo.
      402     define variable v-price-road-tax           like ub.doc-line.price-rubl no-undo.
      403     define variable v-price-other-exp          like ub.doc-line.price-rubl no-undo.
      404     define variable v-price-transport-exp      like ub.doc-line.price-rubl no-undo.
      405     define variable v-price-without-abs        like ub.doc-line.price-rubl no-undo.
      406     define variable v-price-slt                like ub.doc-line.price-rubl no-undo.
      407     define variable v-price-no-slt             like ub.doc-line.price-rubl no-undo.
      408     define variable v-price-vat                like ub.doc-line.price-rubl no-undo.
      409     define variable v-price-no-vat-slt         like ub.doc-line.price-rubl no-undo.
      410     define variable v-price-rubl               like ub.doc-line.price-rubl no-undo.
      411     define variable v-price-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
      412     define variable v-price-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
      413     define variable v-price-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
      414     define variable v-price-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
      415     define variable v-price-slt-rubl           like ub.doc-line.price-rubl no-undo.
      416     define variable v-price-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
      417     define variable v-price-vat-rubl           like ub.doc-line.price-rubl no-undo.
      418     define variable v-price-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
      419     define variable v-price-base               like ub.doc-line.price-base no-undo.
      420     define variable v-price-road-tax-base      like ub.doc-line.price-base no-undo.
      421     define variable v-price-other-exp-base     like ub.doc-line.price-base no-undo.
      422     define variable v-price-transport-exp-base like ub.doc-line.price-base no-undo.
      423     define variable v-price-without-abs-base   like ub.doc-line.price-base no-undo.
      424     define variable v-price-slt-base           like ub.doc-line.price-base no-undo.
      425     define variable v-price-no-slt-base        like ub.doc-line.price-base no-undo.
      426     define variable v-price-vat-base           like ub.doc-line.price-base no-undo.
      427     define variable v-price-no-vat-slt-base    like ub.doc-line.price-base no-undo.
      428     define variable l-fact-qnty              as logical   no-undo .
      429     define variable v-action                 as character no-undo .
      430     define variable l-need-create-old-return as logical   no-undo init false .
      431     define variable l-create-old-return      as logical   no-undo init false .
      432     define variable v-izlcstpr        as character no-undo .
      433     define variable l-goods-serial           as logical   no-undo .
      434     define variable l-goods-twounit          as logical   no-undo .
      435     define variable l-reserv-pl-code         as logical   no-undo .
      436     define variable l-goods-bottle           as logical   no-undo .
      437     define buffer buf_trn-doc  for ub.trn-doc .
      438     define buffer buf_goods    for ub.goods .
      439     define variable v-prompt-price       as character no-undo .
      440     define variable v-check-right        as logical   no-undo .
      441     define variable v-ind                as integer   no-undo .
      442     define variable v-num-entries-action as integer   no-undo .
      443     define variable v-option             as character no-undo .
      444     define variable v-type as character no-undo .
      445     do
      446     on error undo, return error return-value
      447     :
      448       assign
      449         v-check-right = true
      450       .
      451       if not available buf_doc-line
      452       then do:
      453         message
      454           vss-workfile vss-revision vss-description skip
      455           "Ошибка задания входных параметров" skip
      456           "Не задана строка документа" skip
      457           view-as alert-box error .
      458         undo, return error return-value .
      459       end.
      460       if p-supp-type = ?
      461       or p-supp-type = ''
      462       then do:
      463         message
      464           vss-workfile vss-revision vss-description skip
      465           "Ошибка задания входных параметров" skip
      466           "Параметр p-supp-type имеет неопределенное значение" skip
      467           "Документ" buf_doc-line.doc-code skip
      468           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      469           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      470           view-as alert-box error .
      471         undo, return error return-value .
      472       end.
      473       if p-supp-code = ?
      474       or p-supp-code = 0
      475       then do:
      476         message
      477           vss-workfile vss-revision vss-description skip
      478           "Ошибка задания входных параметров" skip
      479           "Параметр p-supp-code имеет неопределенное значение" skip
      480           "Документ" buf_doc-line.doc-code skip
      481           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      482           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      483           view-as alert-box error .
      484         undo, return error return-value .
      485       end.
      486       if p-part-code = ?
      487       then do:
      488         message
      489           vss-workfile vss-revision vss-description skip
      490           "Ошибка задания входных параметров" skip
      491           "Параметр p-part-code имеет неопределенное значение" skip
      492           "Документ" buf_doc-line.doc-code skip
      493           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      494           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      495           view-as alert-box error .
      496         undo, return error return-value .
      497       end.
      498       if p-cst-code = ?
      499       then do:
      500         message
      501           vss-workfile vss-revision vss-description skip
      502           "Ошибка задания входных параметров" skip
      503           "Параметр p-cst-code имеет неопределенное значение" skip
