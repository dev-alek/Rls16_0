     1468                                             or (can-do('инв':U, buf_trn-doc.doc-type)
     1469                                                 and (buf_parts.qnty + p-change-qnty) < 0
     1470                                                 )
     1471                                           then yes
     1472                                           else no
     1473                                         )
     1474                 buf_parts.is-supp       = ( if l-create-old-return then yes else no )
     1475                 buf_parts.pay-code      = buf_trn-doc.pay-code
     1476                 buf_parts.purch-code    = integer('1':U)
     1477                 buf_parts.price-base    = p-part-reserv-base
     1478                 buf_parts.price-rubl    = p-part-reserv-rubl
     1479                 buf_parts.road-tax-base = 0
     1480                 buf_parts.road-tax-rubl = 0
     1481                 buf_parts.cli-base-rate = buf_doc-line.cli-base-rate
     1482                 buf_parts.exch-code     = 0
     1483                 buf_parts.price-cli     = buf_parts.price-rubl
     1484               .
     1485             end.
     1486             validate buf_parts .
     1487           end.
     1488           when "quit":u
     1489           then do:
     1490           end.
     1491         end case .
     1492       end.
     1493       if available buf_parts
     1494       then do:
     1495         if l-fact-qnty
     1496         then do:
     1497           assign
     1498             buf_parts.fact-qnty = buf_parts.fact-qnty + p-change-qnty
     1499           .
     1500         end.
     1501         else do:
     1502           assign
     1503             buf_parts.qnty      = buf_parts.qnty + p-change-qnty
     1504             buf_parts.fact-qnty = buf_parts.qnty
     1505           .
     1506           if buf_trn-doc.doc-type = 'инв':U
     1507           then do:
     1508             assign
     1509               buf_parts.rsrv-free     = ( if buf_parts.qnty < 0
     1510                                           then true
     1511                                           else false
     1512                                         )
     1513             .
     1514           end.
     1515         end.
     1516         if l-goods-twounit = true
     1517         then do:
     1518           if p-cli-qnty <> 0
     1519           then do:
     1520             assign
     1521               buf_parts.cli-qnty = p-cli-qnty
     1522             .
     1523             assign
     1524               buf_parts.cli-base-rate = buf_parts.qnty / buf_parts.cli-qnty
     1525             .
     1526           end.
     1527         end.
     1528         else do:
     1529           if buf_parts.cli-base-rate <> 0
     1530           then do:
     1531             assign
     1532               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     1533             .
     1534           end.
     1535           else do:
     1536             assign
     1537               buf_parts.cli-qnty = 0
     1538             .
     1539           end.
     1540           if abs(buf_parts.cli-qnty - p-cli-qnty) < 0.0011
     1541           then do :
     1542             assign
     1543               buf_parts.cli-qnty = p-cli-qnty
     1544             .
     1545           end .
     1546         end.
     1547         if l-goods-twounit = false
     1548         then do:
     1549   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run qntycalc in g#library
     1550     (input  'cli-qnty'
     1551     ,input  buf_parts.cli-base-rate
     1552     ,input  buf_parts.cli-qnty
     1553     ,input  buf_parts.qnty
     1554     ,output buf_parts.cli-qnty
     1555     ,output buf_parts.qnty
     1556     ) no-error .
     1557           if error-status :error
     1558           then do:
     1559             message
     1560               "Невозможно пересчитать количество по ТТН" skip
     1561               "Документ" buf_parts.out-code skip
     1562               'Артикул':U buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     1563               "Партия" + string(buf_parts.part-code) skip
     1564               return-value skip
     1565               view-as alert-box .
     1566             undo, return error .
     1567           end.
     1568         end.
     1569         if l-goods-serial
     1570         then do:
     1571           if  buf_parts.qnty <> 0
     1572           and buf_parts.qnty <> 1
     1573           then do:
     1574             message
     1575               "Товар серийный." skip
     1576               "Невозможно порождение партии с количеством, отличным от 1."
     1577               view-as alert-box .
     1578             undo, return error .
     1579           end.
     1580         end.
     1581       end.
     1582       return .
     1583     end.
     1584   end procedure.
     1585   procedure partscr_check-valid-supp :
     1586     define input parameter  p-supp-type         like ub.parts.supp-type no-undo .
     1587     define input parameter  p-supp-code         like ub.parts.supp-code no-undo .
     1588     define input parameter  p-trn-doc-supp-type like ub.parts.supp-type no-undo .
     1589     define input parameter  p-trn-doc-supp-code like ub.parts.supp-code no-undo .
     1590     define input parameter  p-extended-doc-type as character no-undo .
     1591     define output parameter p-old-return        as logical no-undo .
     1592     define output parameter p-reason            as character no-undo .
     1593     assign
     1594       p-old-return = false
     1595       p-reason     = ""
     1596     .
     1597     if p-supp-type <> p-trn-doc-supp-type
     1598     or p-supp-code <> p-trn-doc-supp-code
     1599     then do:
     1600       if p-extended-doc-type = 're':U
     1601       or p-extended-doc-type = 'rs':U
     1602       or p-extended-doc-type = 'vt':U
     1603       or p-extended-doc-type = 'vp':U
     1604       then do:
     1605         if p-supp-type = 'чел':U
     1606         or p-supp-type = 'орг':U
     1607         then do:
     1608           assign
     1609             p-old-return = true
     1610           .
     1611         end.
     1612         else do:
     1613           assign
     1614             p-reason = "Поставщиком партии старого возврата может быть только человек или организация"
     1615           .
     1616           return .
     1617         end.
     1618       end.
     1619       else do:
     1620         assign
     1621           p-reason = "Поставщиком порожденной партии может быть только объект документа"
     1622         .
     1623         return .
     1624       end.
     1625     end.
     1626     return .
     1627   end procedure.
     1628   procedure partscr_get-default-values :
     1629     define parameter buffer buf_doc-line for ub.doc-line .
     1630     define output parameter p-vat-type   as character no-undo .
     1631     define output parameter p-vat-pc     as decimal   no-undo .
     1632     define output parameter p-slt-type   as character no-undo .
     1633     define output parameter p-slt-pc     as decimal   no-undo .
     1634     define buffer buf_trn-doc for ub.trn-doc .
     1635     define buffer buf_goods for ub.goods .
     1636     define variable v-vat-pc as decimal   no-undo .
     1637     define variable v-host-code as integer   no-undo .
     1638     do
     1639     on error undo, return error return-value
     1640     :
     1641       if not available buf_doc-line
     1642       then do:
     1643         message
     1644           vss-workfile vss-revision vss-description skip
     1645           "Ошибка задания входных параметров" skip
     1646           "Не задана строка документа" skip
     1647           view-as alert-box error .
     1648         undo, return error return-value .
     1649       end.
     1650       find first buf_trn-doc no-lock
     1651         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1652         no-error .
     1653       if not available buf_trn-doc
     1654       then do:
     1655         message
     1656           vss-workfile vss-revision vss-description skip
     1657           "Не найден документ" skip
     1658           "Код документа" buf_doc-line.doc-code skip
     1659           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1660           view-as alert-box error .
     1661         undo, return error return-value .
     1662       end.
     1663       find first buf_goods no-lock
     1664         where buf_goods.artic     = buf_doc-line.artic
     1665           and buf_goods.prod-type = buf_doc-line.prod-type
     1666           and buf_goods.prod-code = buf_doc-line.prod-code
     1667         no-error .
     1668       if not available buf_goods
     1669       then do:
     1670         message
     1671           vss-workfile vss-revision vss-description skip
     1672           "Ошибка поиска товара" skip
     1673           "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1674           view-as alert-box error .
     1675         undo, return error return-value .
     1676       end.
     1677       if buf_trn-doc.ext-doc-type = 'ie':U
     1678       or buf_trn-doc.ext-doc-type = 'im':U
     1679       then do:
     1680         assign
     1681           p-vat-type = buf_trn-doc.vat-type
     1682           p-vat-pc   = buf_doc-line.vat-pc
     1683           p-slt-type = buf_trn-doc.slt-type
     1684           p-slt-pc   = buf_doc-line.slt-pc
     1685         .
     1686       end.
     1687       else do:
     1688   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1690     (input  buf_doc-line.obj-type
     1691     ,input  buf_doc-line.obj-code
     1692     ,output v-host-code
     1693     )  .
     1694   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1696     (input  buf_goods.gds-code
     1697     ,input  '1':U
     1698     ,input  ?
     1699     ,input  v-host-code
     1700     ,input  buf_trn-doc.obj-type
     1701     ,input  buf_trn-doc.obj-code
     1702     ,output v-vat-pc
     1703     ) no-error .
     1704         assign
     1705           p-vat-type = 'в т. ч.':U
     1706           p-vat-pc   = v-vat-pc
     1707           p-slt-type = 'без':U
     1708           p-slt-pc   = 0
     1709         .
     1710       end.
     1711     end.
     1712   end procedure.
     1713   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1714   procedure partrqst :
     1715     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
     1716     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
     1717     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
     1718     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
     1719     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
     1720     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
     1721     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
     1722     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
     1723     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
     1724     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
     1725     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
     1726     define output parameter p-total-parts-price-base     as decimal                 no-undo .
     1727     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
     1728     define output parameter p-total-parts-transport-base as decimal                 no-undo .
     1729     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
     1730     define output parameter p-total-parts-other-base     as decimal                 no-undo .
     1731     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
     1732     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
     1733     do
     1734     on error undo, return error return-value
     1735     :
     1736       assign
     1737         p-total-parts-qnty           = 0
     1738         p-total-parts-fact-qnty      = 0
     1739         p-total-parts-cli-qnty       = 0
     1740         p-total-parts-fact-cli-qnty  = 0
     1741         p-total-parts-price-cli      = 0
     1742         p-total-parts-price-base     = 0
     1743         p-total-parts-price-rubl     = 0
     1744         p-total-parts-transport-base = 0
     1745         p-total-parts-transport-rubl = 0
     1746         p-total-parts-other-base     = 0
     1747         p-total-parts-other-rubl     = 0
     1748       .
     1749       define buffer buf_parts for ub.parts .
     1750       for each buf_parts no-lock
     1751         where buf_parts.out-code  = p-doc-code
     1752           and buf_parts.obj-type  = p-obj-type
     1753           and buf_parts.obj-code  = p-obj-code
     1754           and buf_parts.artic     = p-artic
     1755           and buf_parts.prod-type = p-prod-type
     1756           and buf_parts.prod-code = p-prod-code
     1757       on error undo, return error return-value
     1758       :
     1759         define variable v-parts-fact-multiplier as decimal   no-undo .
     1760         assign
     1761           v-parts-fact-multiplier = 1
     1762         .
     1763         if buf_parts.qnty <> 0 then do:
     1764           assign
     1765             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
     1766           .
     1767         end.
     1768         assign
     1769           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
     1770           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
     1771           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
     1772           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
     1773                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
     1774           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
     1775           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
     1776           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
     1777           p-total-parts-transport-base  = p-total-parts-transport-base
     1778                                         + buf_parts.fact-qnty
     1779                                           * (if   buf_parts.transport-base <> ?
     1780                                             then buf_parts.transport-base
     1781                                             else 0
     1782                                             )
     1783           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
     1784                                         + buf_parts.fact-qnty
     1785                                           * (if   buf_parts.transport-rubl <> ?
     1786                                             then buf_parts.transport-rubl
     1787                                             else 0
     1788                                             )
     1789           p-total-parts-other-base      = p-total-parts-other-base
     1790                                         + buf_parts.fact-qnty
     1791                                           * (if   buf_parts.other-base <> ?
     1792                                             then buf_parts.other-base
     1793                                             else 0
     1794                                             )
     1795           p-total-parts-other-rubl      = p-total-parts-other-rubl
     1796                                         + buf_parts.fact-qnty
     1797                                           * (if   buf_parts.other-rubl <> ?
     1798                                             then buf_parts.other-rubl
     1799                                             else 0
     1800                                             )
     1801         .
     1802       end.
     1803     end.
     1804   end procedure.
     1805   procedure plgdsfnd :
     1806     define input  parameter p-chk-and-chs    as logical               no-undo .
     1807     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1808     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1809     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1810     define output parameter p-reserv-pl-code as   logical             no-undo .
     1811     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1812     define buffer buf_goods         for ub.goods .
     1813     define buffer buf_pl-gds        for ub.pl-gds .
     1814     define buffer buf_second_pl-gds for ub.pl-gds .
     1815     find first buf_goods no-lock where
     1816                buf_goods.gds-code = p-gds-code no-error .
     1817     if not available buf_goods
     1818     then do:
     1819       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1820     end.
     1821   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1822   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1823     (input  p-obj-type
     1824     ,input  p-obj-code
     1825     ,input  buf_goods.artic
     1826     ,input  buf_goods.prod-type
     1827     ,input  buf_goods.prod-code
     1828     ,input  'place-rsrv=request'
     1829     ,output p-reserv-pl-code
     1830     ) no-error .
     1831     if error-status :error
     1832     then do:
     1833       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1834     end.
     1835     if p-reserv-pl-code = no
     1836     then do:
     1837       return .
     1838     end.
     1839     if p-chk-and-chs <> yes
     1840     then do:
     1841       return .
     1842     end.
     1843     find first buf_pl-gds no-lock where
     1844                buf_pl-gds.obj-type = p-obj-type and
     1845                buf_pl-gds.obj-code = p-obj-code and
     1846                buf_pl-gds.gds-code = p-gds-code no-error .
     1847     if not available buf_pl-gds
     1848     then do:
     1849       return error "К товару не привязано ни одного места хранения" .
     1850     end.
     1851     find first buf_second_pl-gds no-lock where
     1852                buf_second_pl-gds.obj-type  = p-obj-type          and
     1853                buf_second_pl-gds.obj-code  = p-obj-code          and
     1854                buf_second_pl-gds.gds-code  = p-gds-code          and
     1855                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1856     if not available buf_second_pl-gds
     1857     then do:
     1858       assign
     1859         p-pl-code = buf_pl-gds.pl-code
     1860       .
     1861     end.
     1862     else do:
     1863       if not valid-handle( parparentproc )
     1864       then do:
     1865         return error "Не выбрано место хранения " + chr(10) .
     1866       end.
     1867       run str/plgdssel.p
     1868         (
     1869            input parparentproc
     1870         ,  input p-obj-type
     1871         ,  input p-obj-code
     1872         ,  input p-gds-code
     1873         , output p-pl-code
     1874         ) no-error .
     1875       if error-status :error
     1876       then do:
     1877         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1878                                , 'plgdssel.p':U
     1879                                , chr(10)
     1880                                , error-status :get-message( 1 )
     1881                                , return-value
     1882                                ) .
     1883       end.
     1884       if p-pl-code = ? or
     1885          p-pl-code = 0
     1886       then do:
     1887         return error "Не выбрано место хранения " + chr(10) .
     1888       end.
     1889     end.
     1890   end procedure.
     1891   function hvrdtax return logical (input parrecid as recid):
     1892   define variable varresult as logical no-undo.
     1893   run hvrdtax-proc (input parrecid, output varresult).
     1894   return varresult.
     1895   end function.
     1896   procedure hvrdtax-proc:
     1897   define input  parameter parrecid  as recid   no-undo.
     1898   define output parameter parresult as logical no-undo.
     1899   define buffer bf_goods for ub.goods.
     1900   define buffer bf_units for ub.units.
     1901   define buffer rt_tax   for ub.tax.
     1902   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1903   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1904   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1905   if available rt_tax and
     1906       can-find(first ub.tax-units No-LOCK WHERE
     1907                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1908                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1909                                                       else assign parresult = no.
     1910   end procedure.
     1911   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1912   procedure gen-key-rec :
     1913     define input  parameter p-tbl-name    as character no-undo.
     1914     define input  parameter p-bh_tbl-name as handle    no-undo.
     1915     define output parameter p-key-rec     as character no-undo.
     1916     do
     1917     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1918     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1919     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1920     :
     1921       define variable fh               as handle    no-undo .
     1922       define variable v-ok             as logical   no-undo .
     1923       define variable v-inform         as character no-undo .
     1924       define variable v-ind            as integer   no-undo .
     1925       define variable v-idx-field-qnty as integer   no-undo .
     1926       if p-tbl-name = ?
     1927         or p-tbl-name = "":U
     1928       then do:
     1929         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info20 ).
     1930       end.
     1931       if not p-bh_tbl-name:available then do:
     1932         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info20, p-tbl-name ).
     1933       end.
     1934       assign
     1935         p-key-rec = p-tbl-name
     1936         v-inform  = p-bh_tbl-name:index-information(1)
     1937         v-ind     = 2
     1938       .
     1939       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1940       on error undo, return error
     1941       :
     1942         assign
     1943           v-inform = p-bh_tbl-name:index-information( v-ind )
     1944           v-ind    = v-ind + 1
     1945         .
     1946       end.
     1947       if v-inform = ?
     1948         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1949         or entry( 3, v-inform, ",":U ) <> "1":U
     1950       then do:
     1951         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, p-tbl-name ).
     1952       end.
     1953       else do:
     1954         assign
     1955           v-idx-field-qnty = num-entries( v-inform ) - 4
     1956         .
     1957         if v-idx-field-qnty < 2 then do:
     1958           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, p-tbl-name ).
     1959         end.
     1960         do v-ind = 1 to v-idx-field-qnty by 2
     1961         on error undo, return error
     1962         :
     1963           assign
     1964             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1965             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1966           .
     1967         end.
     1968       end.
     1969       if p-key-rec = ? then do:
     1970         assign
     1971           p-key-rec = "":U
     1972         .
     1973         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info20, p-tbl-name ).
     1974       end.
     1975     end.
     1976     return.
     1977   end procedure.
     1978   procedure gen-where-keyr-tab :
     1979     define input  parameter i-tableSerach as character no-undo.
     1980     define input  parameter i-tablekey   as character  no-undo.
     1981     define input  parameter p-key-rec    as character  no-undo.
     1982     define input  parameter p-key-handle as handle     no-undo .
     1983     define input  parameter p-db-name    as character  no-undo .
     1984     define input  parameter p-tt-handle  as handle     no-undo .
     1985     define output parameter o-Where      as character  no-undo.
     1986     do
     1987     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1988     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1989     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1990     :
     1991       define variable v-full-tbl-name  as character no-undo .
     1992       define variable bh_tbl-name      as handle    no-undo .
     1993       define variable fh_key           as handle    no-undo .
     1994       define variable fh_search        as handle    no-undo .
     1995       define variable v-field-num      as integer   no-undo .
     1996       define variable v-count-fld      as integer   no-undo .
     1997       define variable v-inform         as character no-undo .
     1998       define variable v-ind            as integer   no-undo .
     1999       define variable v-idx-field-qnty as integer   no-undo .
     2000       define variable v-field-name     as character no-undo .
     2001       define variable v-field-val      as character no-undo .
     2002       define variable v-word-link      as character no-undo .
     2003       define variable vTable           as character no-undo.
     2004       define variable bh_tbl-key       as handle    no-undo .
     2005       assign
     2006         p-key-rec = trim( p-key-rec )
     2007       .
     2008       if p-key-handle <> ? then do:
     2009         if not valid-handle(p-key-handle)
     2010            or p-key-handle:type <> "buffer"
     2011         then do:
     2012           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info20 ).
     2013         end.
     2014         if num-entries( p-key-rec, chr(3) ) > 1
     2015           or p-key-rec = ?
     2016           or p-key-rec = "":U
     2017         then do:
     2018           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info20, p-key-rec ).
     2019         end.
     2020       end.
     2021       else do:
     2022         if p-key-rec = ?
     2023           or p-key-rec = "":U
     2024         then do:
     2025           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info20 ).
     2026         end.
     2027       end.
     2028       assign
     2029         vTable = entry( 1 , p-key-rec, chr(3) )
     2030       .
     2031       if p-tt-handle <> ?
     2032         and ( not valid-handle(p-tt-handle)
     2033               or p-tt-handle:type <> "buffer"
     2034             )
     2035       then do:
     2036         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info20, vTable, chr(10) ).
     2037       end.
     2038       if p-tt-handle = ? then do:
     2039         assign
     2040           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2041         .
     2042         create buffer bh_tbl-name for table v-full-tbl-name .
     2043       end.
     2044       else do:
     2045         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2046       end.
     2047       assign
     2048         v-inform = bh_tbl-name:index-information(1)
     2049         v-ind    = 2
     2050       .
     2051       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2052       on error undo, return error
     2053       :
     2054         assign
     2055           v-inform = bh_tbl-name:index-information( v-ind )
     2056           v-ind    = v-ind + 1
     2057         .
     2058       end.
     2059       if v-inform = ?
     2060         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2061         or entry( 3, v-inform, ",":U ) <> "1":U
     2062       then do:
     2063         delete object bh_tbl-name no-error.
     2064         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info20, vTable ).
     2065       end.
     2066       assign
     2067         v-idx-field-qnty = num-entries( v-inform ) - 4
     2068       .
     2069       if v-idx-field-qnty < 2 then do:
     2070         delete object bh_tbl-name no-error.
     2071         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, vTable ).
     2072       end.
     2073       assign
     2074         o-where     = "where":U
     2075         v-word-link = "":U
     2076         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2077         v-count-fld = 0
     2078       .
     2079       if i-tablekey ne "" and i-tablekey ne ?
     2080       then do:
     2081         assign
     2082           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2083         .
     2084         create buffer bh_tbl-key for table v-full-tbl-name .
     2085       end.
     2086       if i-tableSerach ne "" and i-tableSerach ne ?
     2087       then do:
     2088         delete object bh_tbl-name no-error.
     2089         assign
     2090           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2091         .
     2092         create buffer bh_tbl-name for table v-full-tbl-name .
     2093       end.
     2094       block_where:
     2095       do v-ind = 1 to v-idx-field-qnty by 2
     2096       on error undo, return error
     2097       :
     2098         assign
     2099           v-count-fld = v-count-fld + 1
     2100         .
     2101         if p-key-handle = ?
     2102           and v-count-fld > v-field-num
     2103         then do:
     2104           leave block_where.
     2105         end.
     2106         define variable VfieldKeyTable as handle no-undo.
     2107         assign
     2108           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2109           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2110         .
     2111         if     bh_tbl-key ne ?
     2112         then do:
     2113            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2114            if VfieldKeyTable eq ?
     2115            then next block_where.
     2116         end.
     2117         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2118         then
     2119            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2120         else
     2121            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2122         if p-key-handle = ? then do:
     2123           assign
     2124             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2125           .
     2126         end.
     2127         else do:
     2128           assign
     2129             fh_key = p-key-handle:buffer-field( v-field-name )
     2130           .
     2131           if fh_key = ?
     2132             or not valid-handle( fh_key )
     2133           then do:
     2134             delete object bh_tbl-name.
     2135             if     bh_tbl-key ne ?
     2136             then
     2137                delete object bh_tbl-key.
     2138             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info20, p-key-handle:name, v-field-name ).
     2139           end.
     2140           assign
     2141             v-field-val = fh_key:buffer-value
     2142           .
     2143         end.
     2144         if fh_search:data-type ="character":U then do:
     2145           assign
     2146             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2147             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2148             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2149             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2150             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2151             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2152             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2153             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2154             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2155             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2156             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2157             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2158             v-field-val = substitute( '"&1"', v-field-val )
     2159           .
     2160         end.
     2161         assign
     2162           o-where = substitute( "&1 &2", o-where, v-field-val )
     2163         .
     2164         if v-word-link = "":U then do:
     2165           assign
     2166             v-word-link = "and":U
     2167           .
     2168         end.
     2169       end.
     2170       delete object bh_tbl-name.
     2171       if     bh_tbl-key ne ?
     2172       then
     2173          delete object bh_tbl-key.
     2174       if p-key-handle = ?
     2175         and v-count-fld <> v-field-num
     2176       then do:
     2177         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info20, vTable ).
     2178       end.
     2179     end.
     2180   end procedure.
     2181   procedure gen-hn-keyr-tab :
     2182     define input  parameter i-tableSerach as character no-undo.
     2183     define input  parameter i-tablekey   as character no-undo.
     2184     define input  parameter p-key-rec    as character no-undo.
     2185     define input  parameter p-key-handle as handle    no-undo .
     2186     define input  parameter p-db-name    as character no-undo .
     2187     define input  parameter p-tt-handle  as handle    no-undo .
     2188     define input  parameter p-stts-lock  as integer   no-undo .
     2189     define output parameter o-hn         as handle    no-undo.
     2190     define variable v-full-tbl-name as character no-undo.
     2191     define variable v-where         as character no-undo.
     2192     define variable bh_tbl-name     as handle    no-undo.
     2193     define variable vTable          as character no-undo.
     2194     do
     2195     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2196     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2197     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2198         run gen-where-keyr-tab(i-tableSerach,
     2199                                i-tablekey,
     2200                                p-key-rec,
     2201                                p-key-handle,
     2202                                p-db-name,
     2203                                p-tt-handle,
     2204                                output v-where).
     2205         if i-tableSerach ne "" and i-tableSerach ne ?
     2206         then do:
     2207            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2208            create buffer bh_tbl-name for table v-full-tbl-name .
     2209         end.
     2210         else do:
     2211            if p-tt-handle = ? then do:
     2212               assign
     2213                  vTable = entry( 1 , p-key-rec, chr(3) )
     2214               .
     2215               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2216               create buffer bh_tbl-name for table v-full-tbl-name .
     2217            end.
     2218            else do:
     2219               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2220            end.
     2221         end.
     2222         if p-tt-handle = ? then do:
     2223            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2224         end.
     2225         else do:
     2226            bh_tbl-name:find-first( v-where ) no-error .
     2227         end.
     2228         o-hn = bh_tbl-name.
     2229      end.
     2230   end procedure.
     2231   procedure gen-hn-keyr :
     2232     define input  parameter p-key-rec    as character no-undo.
     2233     define input  parameter p-key-handle as handle    no-undo .
     2234     define input  parameter p-db-name    as character no-undo .
     2235     define input  parameter p-tt-handle  as handle    no-undo .
     2236     define input  parameter p-stts-lock  as integer   no-undo .
     2237     define output parameter o-hn         as handle    no-undo.
     2238     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2239   end.
     2240   procedure gen-row-keyr :
     2241     define input  parameter p-key-rec    as character no-undo.
     2242     define input  parameter p-key-handle as handle    no-undo .
     2243     define input  parameter p-db-name    as character no-undo .
     2244     define input  parameter p-tt-handle  as handle    no-undo .
     2245     define input  parameter p-stts-lock  as integer   no-undo .
     2246     define output parameter p-tbl-row    as rowid     no-undo.
     2247     define output parameter p-tbl-name   as character no-undo.
     2248     define variable vHn as handle no-undo.
     2249       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2250       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2251       p-tbl-name =  vHn:table.
     2252       delete object vHn no-error.
     2253     if p-tbl-row = ? then do:
     2254       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info20, p-tbl-name, p-key-rec ).
     2255     end.
     2256     else do:
     2257       return.
     2258     end.
     2259   end procedure.
     2260   procedure gen-key-fv :
     2261     define input  parameter p-key-rec    as character no-undo .
     2262     define output parameter p-field-list as character no-undo .
     2263     define output parameter p-value-list as character no-undo.
     2264     do
     2265     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2266     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2267     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2268     :
     2269       define variable v-full-tbl-name  as character no-undo .
     2270       define variable bh_tbl-name      as handle    no-undo .
     2271       define variable v-tbl-name       as character no-undo .
     2272       define variable v-field-num      as integer   no-undo .
     2273       define variable v-count-fld      as integer   no-undo .
     2274       define variable v-inform         as character no-undo .
     2275       define variable v-ind            as integer   no-undo .
     2276       define variable v-idx-field-qnty as integer   no-undo .
     2277       define variable v-delim-key      as character no-undo .
     2278       if p-key-rec = ?
     2279         or p-key-rec = "":U
     2280       then do:
     2281         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info20 ).
     2282       end.
     2283       assign
     2284         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2285         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2286       .
     2287       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2288       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info20 ).
     2289       assign
     2290         v-inform = bh_tbl-name:index-information(1)
     2291         v-ind    = 2
     2292       .
     2293       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2294       on error undo, return error
     2295       :
     2296         assign
     2297           v-inform = bh_tbl-name:index-information( v-ind )
     2298           v-ind    = v-ind + 1
     2299         .
     2300       end.
     2301       if v-inform = ?
     2302         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2303         or entry( 3, v-inform, ",":U ) <> "1":U
     2304       then do:
     2305         delete object bh_tbl-name no-error.
     2306         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, v-tbl-name ).
     2307       end.
     2308       assign
     2309         v-idx-field-qnty = num-entries( v-inform ) - 4
     2310       .
     2311       if v-idx-field-qnty < 2 then do:
     2312         delete object bh_tbl-name no-error.
     2313         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, v-tbl-name ).
     2314       end.
     2315       assign
     2316         p-field-list = "":U
     2317         p-value-list = "":U
     2318         v-delim-key  = "":U
     2319         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2320         v-count-fld  = 0
     2321       .
     2322       block_where:
     2323       do v-ind = 1 to v-idx-field-qnty by 2
     2324       on error undo, return error
     2325       :
     2326         assign
     2327           v-count-fld = v-count-fld + 1
     2328         .
     2329         if v-count-fld > v-field-num then do:
     2330           leave block_where.
     2331         end.
     2332         assign
     2333           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2334           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2335         .
     2336         if v-ind = 1 then do:
     2337           assign
     2338             v-delim-key = chr(3)
     2339           .
     2340         end.
     2341       end.
     2342       delete object bh_tbl-name.
     2343       if v-count-fld <> v-field-num then do:
     2344         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info20, v-tbl-name ).
     2345       end.
     2346     end.
     2347   end procedure.
     2348   procedure gen-key-field :
     2349     define input  parameter p-table      as character no-undo .
     2350     define output parameter p-field-list as character no-undo .
     2351     do
     2352     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2353     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2354     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2355     :
     2356       define variable v-full-tbl-name  as character no-undo .
     2357       define variable bh_tbl-name      as handle    no-undo .
     2358       define variable v-tbl-name       as character no-undo .
     2359       define variable v-field-num      as integer   no-undo .
     2360       define variable v-count-fld      as integer   no-undo .
     2361       define variable v-inform         as character no-undo .
     2362       define variable v-ind            as integer   no-undo .
     2363       define variable v-idx-field-qnty as integer   no-undo .
     2364       define variable v-delim-key      as character no-undo .
     2365       if p-table = ?
     2366         or p-table = "":U
     2367       then do:
     2368         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info20 ).
     2369       end.
     2370       assign
     2371         v-tbl-name      = p-table
     2372         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2373       .
     2374       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2375       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info20 ).
     2376       assign
     2377         v-inform = bh_tbl-name:index-information(1)
     2378         v-ind    = 2
     2379       .
     2380       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2381       on error undo, return error
     2382       :
     2383         assign
     2384           v-inform = bh_tbl-name:index-information( v-ind )
     2385           v-ind    = v-ind + 1
     2386         .
     2387       end.
     2388       if v-inform = ?
     2389         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2390         or entry( 3, v-inform, ",":U ) <> "1":U
     2391       then do:
     2392         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, v-tbl-name ).
     2393       end.
     2394       assign
     2395         v-idx-field-qnty = num-entries( v-inform ) - 4
     2396       .
     2397       if v-idx-field-qnty < 2 then do:
     2398         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, v-tbl-name ).
     2399       end.
     2400       assign
     2401         p-field-list = "":U
     2402         v-delim-key  = "":U
     2403         v-count-fld  = 0
     2404       .
     2405       block_where:
     2406       do v-ind = 1 to v-idx-field-qnty by 2
     2407       on error undo, return error
     2408       :
     2409         assign
     2410           v-count-fld = v-count-fld + 1
     2411         .
     2412         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2413         if v-ind = 1 then do:
     2414           assign
     2415             v-delim-key = chr(3)
     2416           .
     2417         end.
     2418       end.
     2419       delete object bh_tbl-name.
     2420     end.
     2421   end procedure.
     2422   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2423   define variable vss-include-info22 as character format "X(65)" no-undo
     2424   initial "@(#)$Workfile$ $Revision$".
     2425   procedure xmlchar-test :
     2426   define input parameter p-in-string          as character        no-undo.
     2427   define output parameter p-out-string-enc    as character        no-undo.
     2428   define output parameter p-out-string-dec    as character        no-undo.
     2429   do
     2430   on error undo, return error
     2431   :
     2432          run xmlchar-encode in this-procedure
     2433       (
     2434             input p-in-string
     2435           , output p-out-string-enc
     2436       ).
     2437          run xmlchar-decode in this-procedure
     2438       (
     2439             input p-out-string-enc
     2440           , output p-out-string-dec
     2441       ).
     2442   end.
     2443   end .
     2444   procedure xmlchar-encode :
     2445   define input parameter p-in-string      as character        no-undo.
     2446   define output parameter p-out-string    as character        no-undo.
     2447       define variable v-position      as integer      no-undo.
     2448       define variable v-current-char  as character    no-undo.
     2449   do
     2450   on error undo, return error
     2451   :
     2452       assign
     2453           p-out-string = "":U
     2454       .
     2455       case p-in-string
     2456       :
     2457           when ?
     2458           then do:
     2459               assign
     2460                   p-out-string = "?":U
     2461               .
     2462           end.
     2463           when "?":U
     2464           then do:
     2465               assign
     2466                   p-out-string = "&#63;":U
     2467               .
     2468           end.
     2469           otherwise do:
     2470               do v-position = 1 to length( p-in-string )
     2471               :
     2472                   assign
     2473                       v-current-char = substring( p-in-string, v-position, 1 )
     2474                   .
     2475                   case v-current-char
     2476                   :
     2477                       when "&":U
     2478                       then do:
     2479                           assign
     2480                               p-out-string = p-out-string + "&amp;":U
     2481                           .
     2482                       end.
     2483                       when ">":U
     2484                       then do:
     2485                           assign
     2486                               p-out-string = p-out-string + "&gt;":U
     2487                           .
     2488                       end.
     2489                       when "<":U
     2490                       then do:
     2491                           assign
     2492                               p-out-string = p-out-string + "&lt;":U
     2493                           .
     2494                       end.
     2495                       when "'":U
     2496                       then do:
     2497                           assign
     2498                               p-out-string = p-out-string + "&apos;":U
     2499                           .
     2500                       end.
     2501                       when '"':U
     2502                       then do:
     2503                           assign
     2504                               p-out-string = p-out-string + "&quot;":U
     2505                           .
     2506                       end.
     2507                       when chr(1)
     2508                       then do:
     2509                           assign
     2510                               p-out-string = p-out-string + "":U
     2511                           .
     2512                       end.
     2513                       when chr(2)
     2514                       then do:
     2515                           assign
     2516                               p-out-string = p-out-string + "":U
     2517                           .
     2518                       end.
     2519                       when chr(3)
     2520                       then do:
     2521                           assign
     2522                               p-out-string = p-out-string + "":U
     2523                           .
     2524                       end.
     2525                       when chr(4)
     2526                       then do:
     2527                           assign
     2528                               p-out-string = p-out-string + "":U
     2529                           .
     2530                       end.
     2531                       when chr(5)
     2532                       then do:
     2533                           assign
     2534                               p-out-string = p-out-string + "":U
     2535                           .
     2536                       end.
     2537                       when chr(6)
     2538                       then do:
     2539                           assign
     2540                               p-out-string = p-out-string + "":U
     2541                           .
     2542                       end.
     2543                       when chr(7)
     2544                       then do:
     2545                           assign
     2546                               p-out-string = p-out-string + "":U
     2547                           .
     2548                       end.
     2549                       when chr(8)
     2550                       then do:
     2551                           assign
     2552                               p-out-string = p-out-string + "":U
     2553                           .
     2554                       end.
     2555                       when chr(9)
     2556                       then do:
     2557                           assign
     2558                               p-out-string = p-out-string + "":U
     2559                           .
     2560                       end.
     2561                       when chr(29)
     2562                       then do:
     2563                           assign
     2564                               p-out-string = p-out-string + "":U
     2565                           .
     2566                       end.
     2567                       when chr(10)
     2568                       then do:
     2569                           assign
     2570                               p-out-string = p-out-string + "&#10;":U
     2571                           .
     2572                       end.
     2573                       when chr(13)
     2574                       then do:
     2575                           assign
     2576                               p-out-string = p-out-string + "&#13;":U
     2577                           .
     2578                       end.
     2579                       otherwise do:
     2580                           assign
     2581                               p-out-string = p-out-string + v-current-char
     2582                           .
     2583                       end.
     2584                   end case.
     2585               end.
     2586           end.
     2587       end case.
     2588   end.
     2589   end .
     2590   procedure xmlchar-encode-1c :
     2591   define input parameter p-in-string      as character        no-undo.
     2592   define output parameter p-out-string    as character        no-undo.
     2593       define variable v-position      as integer      no-undo.
     2594       define variable v-current-char  as character    no-undo.
     2595   do
     2596   on error undo, return error
     2597   :
     2598       assign
     2599           p-out-string = "":U
     2600       .
     2601       case p-in-string
     2602       :
     2603           when ?
     2604           then do:
     2605               assign
     2606                   p-out-string = "?":U
     2607               .
     2608           end.
     2609           otherwise do:
     2610               do v-position = 1 to length( p-in-string )
     2611               :
     2612                   assign
     2613                       v-current-char = substring( p-in-string, v-position, 1 )
     2614                   .
     2615                   case v-current-char
     2616                   :
     2617                       when chr(1)
     2618                       then do:
     2619                           assign
     2620                               p-out-string = p-out-string + " ":U
     2621                           .
     2622                       end.
     2623                       when chr(2)
     2624                       then do:
     2625                           assign
     2626                               p-out-string = p-out-string + " ":U
     2627                           .
     2628                       end.
     2629                       when chr(3)
     2630                       then do:
     2631                           assign
     2632                               p-out-string = p-out-string + " ":U
     2633                           .
     2634                       end.
     2635                       when chr(4)
     2636                       then do:
     2637                           assign
     2638                               p-out-string = p-out-string + " ":U
     2639                           .
     2640                       end.
     2641                       when chr(5)
     2642                       then do:
     2643                           assign
     2644                               p-out-string = p-out-string + " ":U
     2645                           .
     2646                       end.
     2647                       when chr(6)
     2648                       then do:
     2649                           assign
     2650                               p-out-string = p-out-string + " ":U
     2651                           .
     2652                       end.
     2653                       when chr(7)
     2654                       then do:
     2655                           assign
     2656                               p-out-string = p-out-string + " ":U
     2657                           .
     2658                       end.
     2659                       when chr(8)
     2660                       then do:
     2661                           assign
     2662                               p-out-string = p-out-string + " ":U
     2663                           .
     2664                       end.
     2665                       when chr(9)
     2666                       then do:
     2667                           assign
     2668                               p-out-string = p-out-string + " ":U
     2669                           .
     2670                       end.
     2671                       when chr(29)
     2672                       then do:
     2673                           assign
     2674                               p-out-string = p-out-string + " ":U
     2675                           .
     2676                       end.
     2677                       when chr(10)
     2678                       then do:
     2679                           assign
     2680                               p-out-string = p-out-string + " ":U
     2681                           .
     2682                       end.
     2683                       when chr(13)
     2684                       then do:
     2685                           assign
     2686                               p-out-string = p-out-string + " ":U
     2687                           .
     2688                       end.
     2689                       otherwise do:
     2690                           assign
     2691                               p-out-string = p-out-string + v-current-char
     2692                           .
     2693                       end.
     2694                   end case.
     2695               end.
     2696           end.
     2697       end case.
     2698   end.
     2699   end .
     2700   procedure xmlchar-decode :
     2701   define input parameter p-in-string      as character        no-undo.
     2702   define output parameter p-out-string    as character        no-undo.
     2703       define variable v-position      as integer      no-undo.
     2704       define variable v-last-position as integer      no-undo.
     2705       define variable v-temp-integer  as integer      no-undo.
     2706       define variable v-current-char  as character    no-undo.
     2707       define variable v-next-char     as character    no-undo.
     2708       define variable v-success       as logical      no-undo.
     2709   do
     2710   on error undo, return error
     2711   :
     2712       assign
     2713           p-out-string = "":U
     2714           v-position   = 0
     2715       .
     2716       replace-cycle:
     2717       do while yes
     2718       on error undo, return error
     2719       :
     2720           assign
     2721               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2722           .
     2723           if v-last-position <= v-position
     2724           then do:
     2725               if v-position = 0
     2726               then do:
     2727                   assign
     2728                       p-out-string = p-in-string
     2729                   .
     2730               end.
     2731               else do:
     2732                   assign
     2733                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2734                   .
     2735               end.
     2736               leave replace-cycle.
     2737           end.
     2738           else do:
     2739               assign
     2740                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2741                   v-position      = v-last-position
     2742                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2743               .
     2744               if v-current-char = "#":U
     2745               then do:
     2746                   assign
     2747                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2748                   .
     2749                   if v-last-position > 0
     2750                   then do:
     2751                       run xmlchar-read-integer in this-procedure
     2752                        (
     2753                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2754                           , output v-temp-integer
     2755                           , output v-success
     2756                       ).
     2757                       if v-success = yes
     2758                       and v-temp-integer >= 1
     2759                       and v-temp-integer <= 255
     2760                       then do:
     2761                           assign
     2762                               p-out-string = p-out-string + chr( v-temp-integer )
     2763                               v-position   = v-last-position + 1
     2764                           .
     2765                       end.
     2766                       else do:
     2767                           assign
     2768                               p-out-string = p-out-string + "&":U
     2769                               v-position   = v-position   + 1
     2770                           .
     2771                       end.
     2772                   end.
     2773                   else do:
     2774                       assign
     2775                           p-out-string = p-out-string + "&":U
     2776                           v-position   = v-position   + 1
     2777                       .
     2778                   end.
     2779               end.
     2780               else do:
     2781                   case substring( p-in-string, v-position + 1, 3 )
     2782                   :
     2783                       when "lt;":U
     2784                       then do:
     2785                           assign
     2786                               p-out-string = p-out-string + "<":U
     2787                               v-position   = v-position   + 3
     2788                           .
     2789                       end.
     2790                       when "gt;":U
     2791                       then do:
     2792                           assign
     2793                               p-out-string = p-out-string + ">":U
     2794                               v-position   = v-position   + 3
     2795                           .
     2796                       end.
     2797                       otherwise do:
     2798                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2799                           then do:
     2800                               assign
     2801                                   p-out-string = p-out-string + "&":U
     2802                                   v-position   = v-position   + 4
     2803                               .
     2804                           end.
     2805                           else do:
     2806                               case substring( p-in-string, v-position + 1, 5 )
     2807                               :
     2808                                   when "quot;":U
     2809                                   then do:
     2810                                       assign
     2811                                           p-out-string = p-out-string + '"':U
     2812                                           v-position   = v-position   + 5
     2813                                       .
     2814                                   end.
     2815                                   when "apos;":U
     2816                                   then do:
     2817                                       assign
     2818                                           p-out-string = p-out-string + "'":U
     2819                                           v-position   = v-position   + 5
     2820                                       .
     2821                                   end.
     2822                                   otherwise do:
     2823                                       assign
     2824                                           p-out-string = p-out-string + "&":U
     2825                                       .
     2826                                   end.
     2827                               end case.
     2828                           end.
     2829                       end.
     2830                   end case.
     2831               end.
     2832           end.
     2833       end.
     2834   end.
     2835   end .
     2836   procedure xmlchar-read-integer :
     2837   define input parameter p-input-string      as character        no-undo.
     2838   define output parameter p-output-integer   as integer          no-undo.
     2839   define output parameter p-success       as logical          no-undo.
     2840   do
     2841   on error undo, return error
     2842   :
     2843       assign
     2844           p-output-integer = integer( p-input-string )
     2845       no-error.
     2846       if error-status :error
     2847       then do:
     2848           assign
     2849               p-success           = no
     2850               p-output-integer    = 0
     2851           .
     2852       end.
     2853       else do:
     2854           assign
     2855               p-success           = yes
     2856           .
     2857       end.
     2858   end.
     2859   end.
     2860   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2861   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2862   define new global shared variable g#attr-lib  as handle no-undo .
     2863   define variable v-attr-lib-variable as handle no-undo .
     2864   define variable mMRCCode  as logical    no-undo.
     2865   define variable mTypeMark as character  no-undo.
     2866   function IS-NeedMark returns logical
     2867   ( input ib-code as integer  ,
     2868     input ib-str as character ):
     2869      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2870      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2871                                    and buf_prod-bc-attr.b-str  eq ib-str
     2872                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2873        no-lock no-error.
     2874      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2875   end.
     2876   function repTegforDm return char
     2877   (iDM as char ):
     2878       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2879       define variable vteg as character no-undo.
     2880       define variable oDM as character no-undo.
     2881       define variable vi as integer no-undo.
     2882       oDM = iDm.
     2883       do vi = 1 to num-entries(vTeglist):
     2884          vTeg = entry(vi,vTeglist).
     2885          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2886       end.
     2887       return oDM.
     2888   end.
     2889   function repSpecSimbforDm return char
     2890   (iDM as char ):
     2891       define variable oDM as character no-undo.
     2892     run
     2893       xmlchar-decode(iDM, output oDM).
     2894     return repTegforDm (oDM).
     2895   end.
     2896   function CheckGtin return logical
     2897   (iGtin as char):
     2898      define variable bar_code as character no-undo.
     2899      define variable vGtin as logical no-undo init "yes".
     2900      if length(iGtin) eq 14
     2901      then do:
     2902         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2903         run str/chk-sum.p
     2904          (input-output bar_code ) no-error .
     2905         if iGtin ne  bar_code
     2906         then
     2907            vGtin = no.
     2908      end.
     2909      else
     2910         vGtin = no.
     2911      return vgtin.
     2912   end.
     2913   function repSpecSimbforXlm return char
     2914   (iDM as char ):
     2915       iDM = replace(iDM,chr(29),"").
     2916       return iDM.
     2917   end.
     2918   function getGtinByDM return char
     2919   (IDM as char):
     2920      define variable VTXT as char no-undo.
     2921      define variable vGtin as char no-undo.
     2922      vTXt = IdM.
     2923      vGtin = IDM.
     2924      if    length(vtxt) > 14
     2925      then do:
     2926         if   vtxt begins "(01)"
     2927                or vtxt begins "(02)"
     2928         then
     2929            vGtin = substring(vtxt,5,14).
     2930         else if   (vtxt begins "01"
     2931                or vtxt begins "02" )
     2932                and (   (    substring(iDm,17,2) eq "21"
     2933                         and length(vtxt) >= 21)
     2934                     or substring(iDm,17,2) eq "37"
     2935                     or substring(iDm,17,4) eq "(37)" )
     2936         then do:
     2937            vGtin = substring(vtxt,3,14).
     2938            if not checkGtin(vGtin)
     2939            then
     2940               vGtin = substring(vtxt,1,14).
     2941         end.
     2942         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2943             or length(vtxt) eq 14 + 7 + 4
     2944             or length(vtxt) eq 14 + 7
     2945         then
     2946            vGtin = substring(vtxt,1,14).
     2947      end.
     2948      if not checkGtin(vGtin)
     2949      then
     2950         vGtin = "".
     2951      return vgtin.
     2952   end.
     2953   function getGdsCodeByGtin return int
     2954   (iGtin as char):
     2955      define buffer prod-bc  for ub.prod-bc.
     2956      define buffer bar-code for ub.bar-code.
     2957      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2958      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2959      return if avail bar-code then bar-code.gds-code else ?.
     2960   end.
     2961   function getQntyCodeByGtin return decimal
     2962   (iGtin as char):
     2963      define buffer prod-bc  for ub.prod-bc.
     2964      define buffer bar-code for ub.bar-code.
     2965      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2966      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2967      return if avail bar-code then bar-code.cli-base-rate else ?.
     2968   end.
     2969   function getGdsCodeByDM return int
     2970   (iDm as char):
     2971      define variable vGtin as char no-undo.
     2972      define buffer prod-bc for ub.prod-bc.
     2973      vGtin  = getGtinByDM (IDM ).
     2974      return getGdsCodeByGtin (vGtin).
     2975   end.
     2976   function ChekTypeMarkByGds return logical
     2977   (iGds-code as integer ):
     2978      define buffer goods-attr for ub.goods-attr.
     2979      find first goods-attr where goods-attr.gds-code   = iGds-code
     2980                              and goods-attr.attr-code  = 'mark-type':U
     2981      no-lock no-error.
     2982      if available goods-attr
     2983      then do:
     2984         mTypeMark = goods-attr.attr-value.
     2985         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2986           .
     2987      end.
     2988      else
     2989         return no.
     2990   end.
     2991   function ChekTypeMarkByDm return logical
     2992   (iDM as char ):
     2993      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2994   end.
     2995   function ChekTypeMarkByGtin return logical
     2996   (iGtin as char ):
     2997      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2998   end.
     2999   function GetNextElement return character
     3000     (input iAllTeg        as logical
     3001     ,output oteg          as character
     3002     ,output otegval       as character
     3003     ,input-output pstr    as character
     3004      ):
     3005        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3006        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3007        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3008        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3009        define variable vTeg as character no-undo.
     3010        define variable vLength as integer no-undo.
     3011        define variable vi as integer no-undo.
     3012        define variable vj as integer no-undo.
     3013        define buffer code for ub.code.
     3014        find first code where Code.parent eq "MarkType"
     3015                          and Code.CodeValue   eq mTypeMark
     3016                          no-lock no-error.
     3017        if     available code
     3018           and Code.misc1 ne ""
     3019           and Code.misc1 ne ?
     3020        then do:
     3021           integer (Code.misc1) no-error.
     3022           if not error-status:error
     3023           then
     3024             entry (4,vlistleng) = Code.misc1.
     3025        end.
     3026        if iAllTeg
     3027        then
     3028           assign
     3029              vlistElem     = vlistElem    + vlistElemDop
     3030              vlistleng     = vlistleng    + vlistlengDop
     3031           .
     3032        else if mMRCCode
     3033        then
     3034           assign
     3035              vlistElem     = vlistElem    + ",(8005),8005"
     3036              vlistleng     = vlistleng    + ",000006,0006"
     3037           .
     3038       block-elem:
     3039       do vi = 1 to num-entries(vlistElem):
     3040          vTeg = entry(vi,vlistElem).
     3041          if pstr begins vTeg
     3042          then do:
     3043             if    vTeg eq "21"
     3044             then
     3045                vLength = index(pstr,chr(29)) - 2 no-error.
     3046             if vLength  <= 0
     3047             then
     3048                vLength = int(entry(vi,vlistleng)).
     3049             otegval = substring (pstr,length(vteg) + 1, vLength).
     3050             oteg = replace(replace(vteg,")",""),"(","").
     3051             vTeg = vteg + otegval.
     3052             otegval = replace(otegval,chr(29),"").
     3053             oteg = replace(replace(oteg,")",""),"(","").
     3054             pstr = substring (pstr,length(vTeg)+ 1).
     3055             vTeg = replace(vTeg,chr(29),"").
     3056             leave block-elem.
     3057          end.
     3058          else
     3059             vTeg = "".
     3060       end.
     3061       return vteg.
     3062   end.
     3063   function GetCodeIdent return character
     3064   (iDm as char):
     3065      define variable Velement   as character no-undo init "first".
     3066      define variable oCodeIdent as character no-undo.
     3067      define variable vteg as character no-undo.
     3068      define variable vtegval as character no-undo.
     3069      define variable vGtin as character no-undo.
     3070      define buffer marking for ub.marking.
     3071      for first marking no-lock where
     3072                marking.mark eq iDm
     3073            and marking.unit-ext = "LEVEL2"
     3074      :
     3075        return iDm.
     3076      end.
     3077      vGtin  = getGtinByDM (iDm ).
     3078      ChekTypeMarkByDm(idm).
     3079      if iDm begins 'tech_':U
     3080      then
     3081         oCodeIdent = iDm.
     3082      else if length(iDm) < 21
     3083      then do:
     3084         find first marking where marking.mark eq idm
     3085         no-lock no-error.
     3086         oCodeIdent = if available marking then marking.mark else  ?.
     3087      end.
     3088      else if     length(iDm) eq 29
     3089         and not iDm begins "01"
     3090         and not iDm begins "02"
     3091      then
     3092         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3093      else  if     length(iDm) >= 24
     3094               and (  iDm begins "01"
     3095                   or iDm begins "02")
     3096               and  substring(iDm,17,2) ne "21"
     3097      then do:
     3098         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3099                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3100         then
     3101            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3102         else
     3103            oCodeIdent = iDM.
     3104      end.
     3105      else  if     (   length(iDm) eq 25
     3106                    or length(iDm) eq 21)
     3107               and (not iDm begins "01"
     3108               and  not iDm begins "02")
     3109      then
     3110         oCodeIdent = substring(iDm,1,21).
     3111      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3112      then
     3113         oCodeIdent = substring(iDm,1,21).
     3114      else do while Velement ne "" and idm ne "":
     3115         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3116         oCodeIdent = oCodeIdent + Velement.
     3117      end.
     3118      return oCodeIdent.
     3119   end.
     3120   function GetTegCod return character
     3121   (icodeIdent as char, iTeg as char):
     3122      define variable Velement   as character no-undo init "first".
     3123      define variable oTeg as character no-undo init ?.
     3124      define variable vteg as character no-undo.
     3125      define variable vtegval as character no-undo.
     3126      if     ((length(icodeIdent) eq 21
     3127         and not icodeIdent begins "01"
     3128         and not icodeIdent begins "02")
     3129         or
     3130             ( length(icodeIdent) eq 25
     3131               and not icodeIdent begins "01"
     3132               and not icodeIdent begins "02"))
     3133      then do:
     3134         if iTeg eq "01" or iTeg eq "02"
     3135         then
     3136            oTeg = substring(icodeIdent,1,21).
     3137         else  if  iTeg eq "21"
     3138         then
     3139            oTeg = substring(icodeIdent,15,7).
     3140      end.
     3141      else do:
     3142         ChekTypeMarkByDm(icodeIdent).
     3143         block-teg:
     3144            do while Velement ne "" and icodeIdent ne "":
     3145            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3146            if    Velement begins iTeg
     3147               or Velement begins "(" + iTeg + ")"
     3148            then do:
     3149               oTeg = vtegval.
     3150               leave block-teg.
     3151            end.
     3152         end.
     3153      end.
     3154      return oTeg.
     3155   end.
     3156   function isOAD return logical
     3157   (icodeIdent as character):
     3158      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3159   end.
     3160   function isMark return logical
     3161   (icodeIdent as character):
     3162      define buffer buf_marking for ub.marking.
     3163      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3164             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3165   end.
     3166   function addBracketForCode return character
     3167   (icodeIdent as char):
     3168      define variable Velement   as character no-undo init "first".
     3169      define variable oTeg as character no-undo.
     3170      define variable vteg as character no-undo.
     3171      define variable vtegval as character no-undo.
     3172      define buffer marking for ub.marking.
     3173      find first marking no-lock where
     3174                 marking.mark begins icodeIdent no-error.
     3175      if    not ChekTypeMarkByDm(icodeIdent)
     3176         or length(icodeIdent) le 24
     3177         or (avail marking and marking.unit-ext = "LEVEL2")
     3178      then
     3179         oTeg = icodeIdent.
     3180      else do:
     3181         if (  icodeIdent begins "01"
     3182            or icodeIdent begins "02"
     3183            ) and CheckGtin(substring (icodeIdent,3,14))
     3184            and substring (icodeIdent,17,2) eq "21"
     3185         then do:
     3186            mMRCCode = yes.
     3187            ChekTypeMarkByDm(icodeIdent).
     3188            block-teg:
     3189            do while Velement ne "" and icodeIdent ne "":
     3190               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3191               if vteg ne ""
     3192               then
     3193                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3194            end.
     3195            mMRCCode = no.
     3196         end.
     3197         else do:
     3198            oTeg = icodeIdent.
     3199         end.
     3200      end.
     3201      return oTeg.
     3202   end.
     3203   function getlevelByCodId return int
     3204   (iCode as char):
     3205      define variable vLength as int no-undo.
     3206      define variable vLevel  as int no-undo.
     3207      if not ChekTypeMarkByDM (icode) then return ?.
     3208      vLength = length(iCode).
     3209      if    vLength eq 18
     3210         or vLength eq 20
     3211      then
     3212         Vlevel = 4.
     3213      else if vLength eq 21
     3214      then
     3215         Vlevel = 1.
     3216      else if vLength eq 25
     3217      then do:
     3218         if  iCode begins "01"
     3219         then
     3220            Vlevel = 3.
     3221         else
     3222            Vlevel = 1.
     3223      end.
     3224      else if     vLength >= 26
     3225              and vLength <= 46
     3226      then do:
     3227         if    substring(iCode,17,2) eq "11"
     3228            or substring(iCode,17,2) eq "13"
     3229            or (    substring(iCode,17,2) eq "21"
     3230                and vLength >= 33
     3231                and substring(iCode,26,4) ne "8005")
     3232         then
     3233            Vlevel = 4.
     3234         else if    vLength eq 31
     3235                 or vLength eq 38
     3236                 or vLength eq 39
     3237                 or vLength eq 45
     3238         then
     3239            Vlevel = 1.
     3240         else if    vLength eq 35
     3241                 or vLength eq 43
     3242         then
     3243            Vlevel = 3.
     3244         else
     3245            Vlevel = ?.
     3246      end.
     3247      else
     3248         Vlevel = ?.
     3249      return Vlevel.
     3250   end.
     3251   function getLevelMotpBycodid return character
     3252   (iDm as char):
     3253      define variable vLevel as integer no-undo.
     3254      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3255      vLevel = getlevelByCodId(iDm).
     3256      if    vLevel eq ?
     3257         or vLevel < 1
     3258         or vLevel > 6
     3259      then
     3260         return ?.
     3261      else
     3262         return entry(vlevel,vList).
     3263   end.
     3264   function getLevelUTDByLevelMotp return character
     3265   (iUnit as char):
     3266      define variable vLevel as integer no-undo.
     3267      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3268      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3269      vLevel = lookup(iUnit,vListMOTP).
     3270      if    vLevel eq ?
     3271         or vLevel < 1
     3272         or vLevel > 4
     3273      then
     3274         return ?.
     3275      else
     3276         return entry(vlevel,vListutd).
     3277   end.
     3278   function getLevelMotpByDM return character
     3279   (iDm as char):
     3280      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3281   end.
     3282   function getLevelUTDByCodId return character
     3283   (iDm as char):
     3284      define variable vLevel as integer no-undo.
     3285      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3286      vLevel = getlevelByCodId(iDm).
     3287      if    vLevel eq ?
     3288         or vLevel < 1
     3289         or vLevel > 4
     3290      then
     3291         return ?.
     3292      else
     3293         return entry(vlevel,vList).
     3294   end.
     3295   function getLevelUTDByDM return character
     3296   (iDm as char):
     3297      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3298   end.
     3299   define variable mNotMarkQnty as logical no-undo.
     3300   function getQntyUTDByCodId return decimal
     3301   (iDM as char):
     3302      define variable vLevel as integer no-undo.
     3303      define variable vList as character no-undo init "1,5,10,500".
     3304      define variable vGtin as character no-undo.
     3305      define variable vqnty as decimal no-undo init ?.
     3306      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3307      if vqnty eq ?
     3308      then do:
     3309         if not mNotMarkQnty
     3310         then do:
     3311            define buffer marking for ub.marking.
     3312            define variable vCodident as character no-undo.
     3313            vCodident = GetCodeIdent(idm).
     3314            find first marking where marking.mark begins vCodident no-lock no-error.
     3315            if     available marking
     3316               and marking.box-qnty ne ?
     3317            then
     3318               return marking.box-qnty.
     3319         end.
     3320         vGtin = getGtinByDm(iDM).
     3321         if ChekTypeMarkByGtin (vGtin)
     3322         then do:
     3323            vLevel = getlevelByCodId(iDM).
     3324            if     vLevel >= 1
     3325               and vLevel <= 4
     3326            then
     3327               vqnty = int(entry(vlevel,vList)).
     3328         end.
     3329         else
     3330            vqnty = getQntyCodeByGtin(vgtin).
     3331      end.
     3332      return vqnty.
     3333   end.
     3334   function getQntyUTDByDM return decimal
     3335   (iDm as char):
     3336      define variable vDM as character no-undo.
     3337      if     length (iDm) ne 25
     3338         and length (iDm) ne 29
     3339         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3340      then
     3341         vDM = substring (iDm,1,length (iDm) - 6 ).
     3342      else
     3343         vDM = substring (iDm,1,length (iDm) - 4 ).
     3344      return getQntyUTDByCodId(vDM).
     3345   end.
     3346   function getMRC4 return decimal
     3347   (iMRC as char):
     3348      define variable oMrc     as decimal no-undo init ?.
     3349      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3350      define variable vi       as integer no-undo.
     3351      define variable vfound   as integer no-undo.
     3352      define variable vposStart   as integer no-undo.
     3353      do:
     3354      OMRc = 0.
     3355      do vi = 1 to 4:
     3356         define variable vsimb as character no-undo.
     3357         vsimb = substring(iMRC,vi,1).
     3358         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3359         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3360         if vfound > 0
     3361         then
     3362            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3363         end.
     3364         OMRc = OMRc / 100.
     3365      end.
     3366      return OMRc.
     3367   end.
     3368   function getMRCByDM return decimal
     3369   (iDm as char):
     3370      define variable vMRC     as character no-undo.
     3371      define variable oMrc     as decimal no-undo init ?.
     3372      define variable Velement as character no-undo init "empty".
     3373      define variable vteg as character no-undo.
     3374      define variable vtegval as character no-undo.
     3375      if    length(idm) eq 14 + 7 + 4 + 4
     3376         or length(idm) eq 14 + 7 + 4
     3377      then do:
     3378         vMRC = substring(idm,22,4).
     3379         omrc = getMRC4(vMRC).
     3380      end.
     3381      else do:
     3382          ChekTypeMarkByDm(iDm).
     3383          block-mrc:
     3384          do while Velement ne "" and idm ne "":
     3385             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3386             if Velement begins "8005"
     3387             then do:
     3388                vMRC = substring(Velement,5,6).
     3389                leave block-mrc.
     3390             end.
     3391             else if Velement begins "(8005)"
     3392             then do:
     3393                vMRC = substring(Velement,7,6).
     3394                leave block-mrc.
     3395             end.
     3396          end.
     3397          if vMRC ne ""
     3398          then
     3399             OMRc = dec(vmrc) / 100 no-error.
     3400      end.
     3401      return OMRc.
     3402   end.
     3403   function MoveDate return Date
     3404   (idate as date,
     3405    iMonth as int64):
     3406      define variable vMonth   as int64 no-undo.
     3407      define variable vYear    as int64 no-undo.
     3408      define variable vDateNew as date  no-undo.
     3409       define variable vDay     as int64 no-undo.
     3410       vMonth = month(iDate) + iMonth.
     3411       vYear =  year(iDate).
     3412       if vMonth <= 0
     3413       then assign
     3414          vMonth = vMonth + 12
     3415           vYear  = vYear - 1
     3416       .
     3417       else if vMonth > 12
     3418       then assign
     3419          vMonth = vMonth - 12
     3420           vYear  = vYear + 1
     3421       .
     3422       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3423       do while error-status:error eq yes:
     3424          VDay = vDay + 1.
     3425          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3426       end.
     3427       if VDay > 0
     3428       then
     3429          vDateNew + 1.
     3430       return vDateNew.
     3431   end.
     3432   procedure checkEMRC:
     3433   define input  parameter iDm as character no-undo.
     3434   define output parameter vok as logical   no-undo init yes.
     3435      define variable v-value-emrc as character no-undo.
     3436      define variable v-type-emrc  as character no-undo.
     3437      define variable vDateIso     as character no-undo.
     3438      define variable vMRC         as decimal no-undo.
     3439      define variable vqnty        as decimal no-undo.
     3440      define variable vPrice       as decimal no-undo.
     3441      define variable vparent      as character no-undo.
     3442      define variable vgds-code    as integer no-undo.
     3443      define buffer code for ub.code.
     3444      vMRC = getMRCByDM(iDm).
     3445      if vMRC > 0
     3446      then do:
     3447         vgds-code = getGdsCodeByDM(iDm).
     3448         vqnty     = getQntyUTDByDM(iDm).
     3449               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3450            (
     3451             input   vgds-code
     3452            ,input   'emrc-type':U
     3453            ,output   v-value-emrc
     3454            ,output   v-type-emrc
     3455          ) no-error.
     3456          if     v-value-emrc ne ""
     3457             and v-value-emrc ne ?
     3458          then do:
     3459             vDateIso = iso-date(today).
     3460             vPrice = vMRC / vqnty.
     3461             vparent ="emc" + chr(4) + v-value-emrc.
     3462             find last code where Code.parent      eq vparent
     3463                              and Code.code        le vDateIso
     3464                              and code.status_  eq 0
     3465             no-lock no-error.
     3466             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3467             then
     3468                vOk = true .
     3469             else do:
     3470                 define variable vText      as character no-undo.
     3471                 define variable vDate      as date no-undo.
     3472                 define variable vDateLast  as character no-undo.
     3473                 define variable vDateFirst as character no-undo.
     3474                 define variable vDate3     as date no-undo.
     3475                 vdate = date(code.misc1).
     3476                 vDateLast = code.misc1.
     3477                 vDate3 = MoveDate(today, - 3 ).
     3478                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3479                                      string(vDate3  , "99/99/9999"),
     3480                                      string(vDate   , "99/99/9999")
     3481                                      ).
     3482                 vdateIso = iso-date(vdate3).
     3483                 find last code  where Code.parent      eq vparent
     3484                                   and Code.code        le vDateIso
     3485                                   and code.status_  eq 0 no-lock no-error.
     3486                 if available code
     3487                 then
     3488                    vDateIso = code.code.
     3489                 vDateFirst = vDateIso.
     3490                 vDateLast = iso-date(vdate).
     3491                 define variable vGood as logical no-undo.
     3492                 define variable vDateSale as date no-undo.
     3493                 define buffer bcode for code.
     3494                 for last code where Code.parent   eq vparent
     3495                                 and code.status_  eq 0
     3496                                 and code.code     < vDateLast
     3497                                 and code.code     >= vDateFirst
     3498                 no-lock:
     3499                    find first bcode where bCode.parent   eq vparent
     3500                                       and bcode.status_  eq 0
     3501                                       and bcode.code     > code.code no-lock no-error.
     3502                    if available bcode
     3503                    then do:
     3504                       if vPrice < dec(Code.CodeValue)
     3505                       then
     3506                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     3507                                                     chr(10),
     3508                                                     string(    date( code.misc1)       ,"99/99/9999"),
     3509                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     3510                                                     ).
     3511                       else do:
     3512                          vGood = yes.
     3513                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     3514                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     3515                                                     chr(10),
     3516                                                     string(    date( code.misc1)         ,"99/99/9999"),
     3517                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     3518                                                     string(         vDateSale            ,"99/99/9999"),
     3519                                                     string(vDateSale - today)
     3520                                                     ).
     3521                       end.
     3522                    end.
     3523                 end.
     3524                 if vgood
     3525                 then do:
     3526                    define variable choice as integer no-undo .
     3527                    run gbl/d-askw.w (input "Уточнение"
     3528                           ,input  vText
     3529                           ,input "|"
     3530                           ,input "Принять|Вернуть"
     3531                           ,input "Принять данный товар|Вернуть товар постащику"
     3532                           ,input 1
     3533                           ,input 2
     3534                           ,output choice) no-error.
     3535                    vok = choice eq 1.
     3536                 end.
     3537                 else
     3538                    vok =false.
     3539             end.
     3540          end.
     3541      end.
     3542   end.
     3543   function addGs2Mark return character
     3544   (iMark as char):
     3545      define variable vDM   as character no-undo.
     3546      define variable vIdx  as integer   no-undo.
     3547      if index(iMark,chr(29),1) > 0
     3548      then return iMark.
     3549      if substring(iMark,26,4) = "8005" then
     3550      do:
     3551        vIdx = index(iMark,"93",26 + 4 + 5).
     3552        if vIdx > 1 then do:
     3553          vDM = substitute("&1&4&2&4&3",
     3554                           substring(iMark,1,25),
     3555                           substring(iMark,26,vIdx - 25 - 1),
     3556                           substring(iMark,vIdx),
     3557                           chr(29)) no-error.
     3558          vIdx = index(vDm,"240",vIdx + 4).
     3559          if vIdx > 0 then
     3560          do:
     3561            vDM = substitute("&1&3&2",
     3562                             substring(vDm,1,vIdx - 1),
     3563                             substring(vDm,vIdx),
     3564                             chr(29)) no-error.
     3565          end.
     3566        end.
     3567        else
     3568          vDM = substitute("&1&3&2",
     3569                           substring(iMark,1,25),
     3570                           substring(iMark,26),
     3571                           chr(29)) no-error.
     3572      end.
     3573      else if substring(iMark,32,2) = "91" then
     3574      do:
     3575        vIdx = index(iMark,"92",32).
     3576        if vIdx > 1 then
     3577          vDM = substitute("&1&4&2&4&3",
     3578                           substring(iMark,1,31),
     3579                           substring(iMark,32,vIdx - 31 - 1),
     3580                           substring(iMark,vIdx),
     3581                           chr(29)) no-error.
     3582        else
     3583          vDM = substitute("&1&3&2",
     3584                           substring(iMark,1,31),
     3585                           substring(iMark,32),
     3586                           chr(29)) no-error.
     3587      end.
     3588      else if substring(iMark,39,2) = "91" then
     3589      do:
     3590        vIdx = index(iMark,"92",38).
     3591        if vIdx > 1 then
     3592          vDM = substitute("&1&4&2&4&3",
     3593                           substring(iMark,1,38),
     3594                           substring(iMark,39,vIdx - 38 - 1),
     3595                           substring(iMark,vIdx),
     3596                           chr(29)) no-error.
     3597        else
     3598          vDM = substitute("&1&3&2",
     3599                           substring(iMark,1,38),
     3600                           substring(iMark,39),
     3601                           chr(29)) no-error.
     3602      end.
     3603      else if substring(iMark,25,2) = "93" then
     3604      do:
     3605        vIdx = index(iMark,"92",25).
     3606        if vIdx > 1 then
     3607          vDM = substitute("&1&4&2&4&3",
     3608                           substring(iMark,1,24),
     3609                           substring(iMark,25,vIdx - 24 - 1),
     3610                           substring(iMark,vIdx),
     3611                           chr(29)) no-error.
     3612        else
     3613          vIdx = index(iMark,"3103",25).
     3614          if vIdx > 0 then
     3615          vDM = substitute("&1&4&2&4&3",
     3616                           substring(iMark,1,24),
     3617                           substring(iMark,25,vIdx - 24 - 1),
     3618                           substring(iMark,vIdx),
     3619                           chr(29)) no-error.
     3620          else
     3621            vDM = substitute("&1&3&2",
     3622                             substring(iMark,1,24),
     3623                             substring(iMark,25),
     3624                             chr(29)) no-error.
     3625      end.
     3626      else if substring(iMark,32,2) = "93" then
     3627      do:
     3628        vDM = substitute("&1&3&2",
     3629              substring(iMark,1,31),
     3630              substring(iMark,32),
     3631              chr(29)) no-error.
     3632      end.
     3633      return if vDM <> "" then vDm else iMark.
     3634   end.
     3635   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3636   procedure partcopy :
     3637     define input parameter  p-free-output-copy as logical   no-undo .
     3638     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     3639     define parameter buffer buf_orig_parts     for ub.parts .
     3640     define parameter buffer buf_parts          for ub.parts .
     3641     define input parameter  p-mark             as character no-undo .
     3642     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     3643     define variable v-value-character as character no-undo .
     3644     define variable v-value-date      as date no-undo .
     3645     define variable v-value-decimal   as decimal no-undo .
     3646     define variable v-value-integer   as integer no-undo .
     3647     define variable v-izlcstpr        as logical no-undo .
     3648     define variable v-tth             as handle no-undo .
     3649     define variable v-type            as character no-undo .
     3650     define variable part-key-rec      as character no-undo .
     3651     define variable orig-part-key-rec as character no-undo .
     3652     define variable del-part-key-rec  as character no-undo .
     3653     define variable objMarks as class excisemarks  no-undo .
     3654     define variable v-parent-mark-sts as integer   no-undo .
     3655     define variable v-mark-sts-list   as character no-undo .
     3656     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     3657     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     3658     define buffer buf_gen-attr for ub.gen-attr .
     3659     define buffer buf1_gen-attr for ub.gen-attr .
     3660     define buffer buf_doc-line  for ub.doc-line .
     3661     define buffer buf_marking for ub.marking .
     3662     define buffer buf_marking-childs for ub.marking .
     3663     define buffer orig_marking-lines for ub.marking-lines .
     3664     define buffer orig_marking-lines-childs for ub.marking-lines .
     3665     define buffer buf_marking-lines for ub.marking-lines .
     3666     define buffer buf_marking-lines-childs for ub.marking-lines .
     3667     define buffer buf_marking-pack for ub.marking .
     3668     define buffer buf_marking-chk for ub.marking-chk .
     3669     define buffer buf_goods for ub.goods .
     3670     define buffer buf_trn-doc for ub.trn-doc .
     3671     define buffer pri_trn-doc for ub.trn-doc .
     3672     define buffer buf_chk-doc for ub.chk-doc .
     3673     do
     3674     on error undo, return error return-value
     3675     :
     3676       if p-free-output-copy = true
     3677       then do:
     3678         if  p-out-code <> 'free-zone':U
     3679         and p-out-code <> 'out-zone':U
     3680         then do:
     3681           message
     3682             vss-workfile vss-revision vss-description skip
     3683             vss-include-info23 skip
     3684             "Ошибка задания входных параметров процедуры partcopy" skip
     3685             "p-free-output-copy" p-free-output-copy skip
     3686             "p-out-code" p-out-code skip
     3687             view-as alert-box error .
     3688           undo, return error .
     3689         end.
     3690       end.
     3691       if buf_orig_parts.out-code <> p-out-code
     3692       then do:
     3693         find first buf_parts exclusive-lock
     3694           where buf_parts.obj-type  = buf_orig_parts.obj-type
     3695             and buf_parts.obj-code  = buf_orig_parts.obj-code
     3696             and buf_parts.artic     = buf_orig_parts.artic
     3697             and buf_parts.prod-type = buf_orig_parts.prod-type
     3698             and buf_parts.prod-code = buf_orig_parts.prod-code
     3699             and buf_parts.in-code   = buf_orig_parts.in-code
     3700             and buf_parts.out-code  = p-out-code
     3701             and buf_parts.part-code = buf_orig_parts.part-code
     3702           no-error.
     3703         if not available buf_parts
     3704         then do:
     3705           define variable v-rsrv-free as logical   no-undo .
     3706           if p-out-code = 'free-zone':U
     3707           or p-out-code = 'out-zone':U
     3708           then do:
     3709             assign
     3710               v-rsrv-free =
     3711          (if p-out-code = 'free-zone':U then yes else no)
     3712             .
     3713           end.
     3714           else do:
     3715             assign
     3716               v-rsrv-free = ?
     3717             .
     3718           end.
     3719           create buf_parts .
     3720           buffer-copy buf_orig_parts to buf_parts
     3721           assign
     3722             buf_parts.out-code  = p-out-code
     3723             buf_parts.status_   = no
     3724             buf_parts.rsrv-free = v-rsrv-free
     3725             buf_parts.qnty      = 0
     3726             buf_parts.fact-qnty = 0
     3727             buf_parts.real-qnty = 0
     3728             buf_parts.cli-qnty  = 0
     3729           .
     3730           validate buf_parts .
     3731         end.
     3732         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3733                                           ,input (buffer buf_orig_parts:handle)
     3734                                           ,output orig-part-key-rec).
     3735         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3736                                           ,input (buffer buf_parts:handle)
     3737                                           ,output part-key-rec).
     3738         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     3739               and ub.gen-attr.p-key =  orig-part-key-rec:
     3740             if not valid-object (objMarks)
     3741               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     3742               if p-out-code = 'free-zone':U
     3743               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     3744                then
     3745               do:
     3746                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     3747                   if objMarks:StatusErr
     3748                       then
     3749                   do:
     3750                       message objMarks:ReturnMsg view-as alert-box error.
     3751                       delete object objMarks no-error.
     3752                       undo, return error.
     3753                   end.
     3754               end.
     3755             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     3756             do:
     3757                 if p-mark <> "" then do:
     3758                 if p-out-code = 'free-zone':U then do:
     3759                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     3760                 end.
     3761                 else do:
     3762                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     3763                 end.
     3764                 if objMarks:StatusErr
     3765                   then
     3766                 do:
     3767                   message objMarks:ReturnMsg view-as alert-box error.
     3768                   delete object objMarks no-error.
     3769                   undo, return error.
     3770                 end.
     3771               end.
     3772             end.
     3773             if p-out-code = 'out-zone':U then
     3774             do:
     3775                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     3776                 if objMarks:StatusErr
     3777                     then
     3778                 do:
     3779                     message objMarks:ReturnMsg view-as alert-box error.
     3780                     delete object objMarks no-error.
     3781                     undo, return error.
     3782                 end.
     3783             end.
     3784         end.
     3785         delete object objMarks no-error.
     3786         if p-mark = "news" then return .
     3787         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     3788         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     3789         if not available buf_trn-doc
     3790         then
     3791            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     3792         if (
     3793             p-out-code = 'free-zone':U
     3794             and buf_orig_parts.in-code = buf_orig_parts.out-code
     3795            )
     3796         or
     3797            (
     3798             p-out-code = 'free-zone':U
     3799             and available pri_trn-doc
     3800             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     3801            )
     3802         or
     3803            (
     3804             available buf_trn-doc
     3805             and p-out-code = buf_trn-doc.doc-code
     3806             and buf_trn-doc.ext-doc-type = 'vt':U
     3807            )
     3808         or
     3809            (
     3810             p-mark = ""
     3811             and available buf_trn-doc
     3812             and p-out-code = 'free-zone':U
     3813             and buf_trn-doc.ext-doc-type = 'vt':U
     3814            )
     3815         or
     3816            (
     3817             p-mark = ""
     3818             and available buf_trn-doc
     3819             and p-out-code = 'free-zone':U
     3820             and buf_trn-doc.ext-doc-type = 'rs':U
     3821            )
     3822         then do :
     3823           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     3824             and ub.goods.prod-type = buf_parts.prod-type
     3825             and ub.goods.prod-code = buf_parts.prod-code.
     3826           def buffer buf_orig_ml for ub.marking-lines.
     3827           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     3828             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     3829             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     3830             and buf_orig_ml.in-code = buf_orig_parts.in-code
     3831             and buf_orig_ml.out-code = buf_orig_parts.out-code
     3832             and buf_orig_ml.part-code = buf_orig_parts.part-code
     3833             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     3834             if available pri_trn-doc
     3835             and pri_trn-doc.ext-doc-type = 'iv':U
     3836             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3837             then do :
     3838               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     3839                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     3840               end .
     3841               next .
     3842             end .
     3843             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     3844                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     3845                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     3846                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     3847                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     3848                                                   and ub.marking-lines.out-code = p-out-code
     3849                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     3850                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     3851                                                   no-error .
     3852             if not available ub.marking-lines
     3853             then do :
     3854               create ub.marking-lines.
     3855               buffer-copy buf_orig_ml to ub.marking-lines
     3856               assign
     3857                 ub.marking-lines.out-code  = p-out-code
     3858                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     3859               .
     3860               validate ub.marking-lines.
     3861             end .
     3862             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     3863             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     3864               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     3865               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     3866                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     3867                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     3868                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     3869                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3870               then do:
     3871                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3872                 validate buf_marking.
     3873               end.
     3874             end .
     3875           end .
     3876           end.
     3877         end .
     3878         define variable v-doc-type  as character no-undo .
     3879         define variable   v-status    as character no-undo .
     3880         define variable v-fact-qnty   as  decimal no-undo .
     3881         define variable ii    as integer no-undo .
     3882         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     3883                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     3884                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     3885                                        .
     3886         if available pri_trn-doc
     3887         and pri_trn-doc.ext-doc-type = 'rs':U
     3888         then do :
     3889           if p-mark <> ""
     3890           then do :
     3891           end .
     3892           else do :
     3893           end .
     3894         end .
     3895         else do :
     3896           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     3897           and p-mark <> ""
     3898           then do :
     3899             if p-out-code = 'free-zone':U
     3900             then do:
     3901                 if chg-qnty < 0
     3902                 then do :
     3903                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     3904                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     3905                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     3906                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     3907                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     3908                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     3909                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     3910                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     3911                                                           no-error .
     3912                   if available orig_marking-lines
     3913                   then do :
     3914                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     3915                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     3916                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     3917                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     3918                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     3919                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     3920                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     3921                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     3922                                                            no-error .
     3923                     if not available buf_marking-lines
     3924                     then do :
     3925                       create buf_marking-lines .
     3926                       assign
     3927                         buf_marking-lines.mark       = p-mark
     3928                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     3929                         buf_marking-lines.gds-code   = buf_goods.gds-code
     3930                         buf_marking-lines.obj-type   = buf_parts.obj-type
     3931                         buf_marking-lines.obj-code   = buf_parts.obj-code
     3932                         buf_marking-lines.in-code    = buf_parts.in-code
     3933                         buf_marking-lines.out-code   = buf_parts.out-code
     3934                         buf_marking-lines.part-code  = buf_parts.part-code
     3935                         buf_marking-lines.prt-code   = buf_parts.prt-code
     3936                       .
     3937                       validate buf_marking-lines.
     3938                     end .
     3939                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     3940                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3941                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     3942                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     3943                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     3944                                                         :
     3945                           assign buf_marking-chk.sts = 0 .
     3946                           validate buf_marking-chk.
     3947                         end .
     3948                       end .
     3949                       if buf_marking.unit-ext <> "UNIT" or
     3950                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     3951                       then do :
     3952                         run addChildMarkingLines in this-procedure (
     3953                           buf_marking.mark,
     3954                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     3955                           buffer buf_marking-lines,
     3956                           buffer buf_parts,
     3957                           buffer orig_marking-lines,
     3958                           buffer buf_orig_parts,
     3959                           buffer buf_goods
     3960                         ).
     3961                       end .
     3962                     end.
     3963                     find current orig_marking-lines exclusive-lock .
     3964                     delete orig_marking-lines .
     3965                   end .
     3966                 end .
     3967             end.
     3968             else do:
     3969               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     3970                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     3971                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     3972                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     3973                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     3974                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     3975                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     3976                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     3977                                                              no-error .
     3978                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     3979                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     3980                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     3981                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     3982                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     3983                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     3984                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     3985                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     3986                                                         no-error .
     3987                 if not available buf_marking-lines
     3988                 then do :
     3989                   create buf_marking-lines .
     3990                   assign
     3991                     buf_marking-lines.mark       = p-mark
     3992                     buf_marking-lines.doc-level  = 1
     3993                     buf_marking-lines.gds-code   = buf_goods.gds-code
     3994                     buf_marking-lines.obj-type   = buf_parts.obj-type
     3995                     buf_marking-lines.obj-code   = buf_parts.obj-code
     3996                     buf_marking-lines.in-code    = buf_parts.in-code
     3997                     buf_marking-lines.out-code   = buf_parts.out-code
     3998                     buf_marking-lines.part-code  = buf_parts.part-code
     3999                     buf_marking-lines.prt-code   = buf_parts.prt-code
     4000                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     4001                   .
     4002                   validate buf_marking-lines.
     4003                 end .
     4004                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     4005                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     4006                   validate buf_marking.
     4007                   for first buf_marking-childs exclusive-lock where
     4008                             buf_marking-childs.mark = buf_marking.mark-parent:
     4009                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     4010                     validate buf_marking-childs.
     4011                   end.
     4012                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     4013                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     4014                                                     and buf_chk-doc.out-code = buf_parts.out-code
     4015                                                     :
     4016                       if buf_marking-chk.sts <> 2 then
     4017                       do:
     4018                          assign buf_marking-chk.sts = 1 .
     4019                          validate buf_marking-chk.
     4020                       end.
     4021                     end .
     4022                   end .
     4023                   if buf_marking.unit-ext <> "UNIT" or
     4024                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     4025                   then do :
     4026                     run addChildMarkingLines in this-procedure (
     4027                       buf_marking.mark,
     4028                       buf_marking.sts,
     4029                       buffer buf_marking-lines,
     4030                       buffer buf_parts,
     4031                       buffer orig_marking-lines,
     4032                       buffer buf_orig_parts,
     4033                       buffer buf_goods
     4034                     ).
     4035                   end .
     4036                 end.
     4037                 if available orig_marking-lines then
     4038                   delete orig_marking-lines .
     4039             end.
     4040           end.
     4041         end .
     4042         if p-out-code = 'out-zone':U
     4043         and trim(p-mark) = ""
     4044         then do :
     4045           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4046                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4047                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4048                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4049                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4050                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4051                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4052                                                 :
     4053             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     4054                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     4055                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     4056                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     4057                                                     and buf_marking-lines.out-code   = p-out-code
     4058                                                     no-error .
     4059             if available buf_marking-lines
     4060             then do :
     4061               find current buf_marking-lines exclusive-lock .
     4062               delete buf_marking-lines .
     4063               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4064                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     4065                 then do :
     4066                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4067                   validate buf_marking.
     4068                 end.
     4069               end .
     4070             end .
     4071             else do :
     4072               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     4073               create buf_marking-lines .
     4074               assign
     4075                 buf_marking-lines.mark       = orig_marking-lines.mark
     4076                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4077                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4078                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4079                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4080                 buf_marking-lines.in-code    = buf_parts.in-code
     4081                 buf_marking-lines.out-code   = buf_parts.out-code
     4082                 buf_marking-lines.part-code  = buf_parts.part-code
     4083                 buf_marking-lines.prt-code   = buf_parts.prt-code
     4084               .
     4085               validate buf_marking-lines.
     4086               if buf_parts.out-code <> buf_parts.in-code
     4087               and buf_parts.out-code <> 'free-zone':U
     4088               and buf_parts.out-code <> 'out-zone':U
     4089               then do :
     4090                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4091                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4092               end .
     4093               end.
     4094             end .
     4095             release buf_marking-lines no-error .
     4096           end.
     4097         end .
     4098         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     4099         then do:
     4100           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     4101                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     4102                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4103                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4104                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4105                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4106                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4107                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4108                                                   .
     4109             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     4110                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     4111                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     4112                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     4113                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     4114                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     4115                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     4116                                                    no-error .
     4117             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     4118               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4119                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     4120               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4121                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     4122               validate ub.marking.
     4123             end.
     4124             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     4125             if available (buf_marking-lines)
     4126             then do:
     4127               assign
     4128                 buf_marking-lines.mark       = p-mark
     4129                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4130                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4131                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4132                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4133                 buf_marking-lines.in-code    = buf_parts.in-code
     4134                 buf_marking-lines.out-code   = buf_parts.out-code
     4135                 buf_marking-lines.part-code  = buf_parts.part-code
     4136               .
     4137               validate buf_marking-lines.
     4138             end.
     4139           end.
     4140         end.
     4141       end.
     4142       else do:
     4143         find first buf_parts exclusive-lock
     4144           where recid(buf_parts) = recid(buf_orig_parts)
     4145           .
     4146       end.
     4147       if p-out-code = 'free-zone':U
     4148       or p-out-code = 'out-zone':U
     4149       then do:
     4150         if buf_parts.rsrv-free <>
     4151          (if buf_parts.out-code = 'free-zone':U then yes else no)
     4152         then do:
     4153           message
     4154             vss-workfile vss-revision vss-description skip
     4155             vss-include-info23 skip
     4156             "Ошибка типа резерва партии" skip
     4157             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     4158             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4159             "Партия" buf_parts.in-code buf_parts.part-code skip
     4160             "Резерв" buf_parts.out-code skip
     4161             "Статус" buf_parts.status_ skip
     4162             "Тип резерва" buf_parts.rsrv-free skip
     4163             view-as alert-box error .
     4164           undo, return error .
     4165         end.
     4166       end.
     4167     end.
     4168   end procedure.
     4169   procedure partcopy-to-childs-mark :
     4170     define parameter buffer buf_ml for ub.marking-lines .
     4171     define parameter buffer buf_orig-ml for ub.marking-lines .
     4172     define input parameter p-out-code as character no-undo .
     4173     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     4174     define buffer buf_ml-childs for ub.marking-lines .
     4175     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     4176       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4177         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     4178       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4179         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     4180       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     4181         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     4182         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     4183         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     4184         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     4185         and buf_ml-childs.part-code = buf_orig-ml.part-code
     4186         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     4187         :
     4188         assign
     4189           buf_ml-childs.out-code  = p-out-code
     4190         .
     4191         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     4192       end.
     4193     end.
     4194   end.
     4195   procedure partcopy-update-parts :
     4196     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4197     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     4198     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     4199     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4200     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4201     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4202     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     4203     define buffer buf_trn-doc for ub.trn-doc .
     4204     define buffer archive_parts for ub.parts .
     4205     define buffer buf_parts   for ub.parts .
     4206     define buffer orig_marking-lines for ub.marking-lines .
     4207     define buffer buf_marking for ub.marking .
     4208     define buffer buf_goods for ub.goods .
     4209     define variable v-rsrv-code     as character no-undo .
     4210     define variable v-goods-twounit as logical   no-undo .
     4211     define variable v-value-character as character no-undo .
     4212     define variable v-value-date      as date no-undo .
     4213     define variable v-value-decimal   as decimal no-undo .
     4214     define variable v-value-integer   as integer no-undo .
     4215     define variable v-izlcstpr        as logical no-undo .
     4216     define variable v-tth             as handle no-undo .
     4217     define variable v-type            as character no-undo .
     4218     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     4219     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     4220     do
     4221     on error undo, return error return-value
     4222     :
     4223       find first buf_trn-doc no-lock
     4224         where buf_trn-doc.doc-code = p-doc-code
     4225         no-error .
     4226       if not available buf_trn-doc
     4227       then do:
     4228         message
     4229           vss-workfile vss-revision vss-description skip
     4230           vss-include-info23 skip
     4231           "Ошибка задания входных параметров" skip
     4232           "Не найден документ" skip
     4233           "Документ" p-doc-code skip
     4234           "Объект" p-obj-type p-obj-code skip
     4235           "Артикул" p-artic p-prod-type p-prod-code skip
     4236           error-status :get-message(1) skip
     4237           return-value skip
     4238           view-as alert-box error .
     4239         undo, return error .
     4240       end.
     4241       find first buf_goods no-lock where buf_goods.artic = p-artic
     4242                                      and buf_goods.prod-type = p-prod-type
     4243                                      and buf_goods.prod-code = p-prod-code
     4244                                      no-error .
     4245       if not available buf_goods
     4246       then do:
     4247         message
     4248           vss-workfile vss-revision vss-description skip
     4249           vss-include-info23 skip
     4250           "Ошибка задания входных параметров" skip
     4251           "Не найден товар" skip
     4252           "Документ" p-doc-code skip
     4253           "Объект" p-obj-type p-obj-code skip
     4254           "Артикул" p-artic p-prod-type p-prod-code skip
     4255           error-status :get-message(1) skip
     4256           return-value skip
     4257           view-as alert-box error .
     4258         undo, return error .
     4259       end.
     4260       if buf_trn-doc.ext-doc-type = 'vt':U
     4261       then do :
     4262           delete object v-tth no-error.
     4263           run adm/shattri.p (
     4264              input "get":U
     4265             ,input buf_trn-doc.obj-type
     4266             ,input buf_trn-doc.obj-code
     4267             ,input 'inv-obj':U
     4268             ,input  "izlcstpr"
     4269             ,output v-value-character
     4270             ,output v-value-date
     4271             ,output v-value-decimal
     4272             ,output v-value-integer
     4273             ,output v-izlcstpr
     4274             ,output v-type
     4275             ,INPUT-OUTPUT table-handle v-tth
     4276             ) no-error .
     4277             delete object v-tth no-error.
     4278           if error-status:error then do:
     4279             v-izlcstpr = false .
     4280           end.
     4281       end.
     4282       else do :
     4283           v-izlcstpr = false .
     4284       end.
     4285   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4287     (input  p-artic
     4288     ,input  p-prod-type
     4289     ,input  p-prod-code
     4290     ,input  'twounit=request':u
     4291     ,output v-goods-twounit
     4292     ) no-error .
     4293       if error-status :error
     4294       then do:
     4295         message
     4296           vss-workfile vss-revision vss-description skip
     4297           vss-include-info23 skip
     4298           "Ошибка при определении атрибута товара" skip
     4299           "Артикул" p-artic p-prod-type p-prod-code skip
     4300           error-status :get-message(1) skip
     4301           return-value skip
     4302           view-as alert-box error .
     4303         undo, return error .
     4304       end.
     4305       define query partcopy-select-parts for archive_parts .
     4306       open query partcopy-select-parts preselect each archive_parts
     4307         where archive_parts.obj-type  = p-obj-type
     4308           and archive_parts.obj-code  = p-obj-code
     4309           and archive_parts.artic     = p-artic
     4310           and archive_parts.prod-type = p-prod-type
     4311           and archive_parts.prod-code = p-prod-code
     4312           and archive_parts.out-code  = p-doc-code
     4313         .
     4314       get first partcopy-select-parts .
     4315       if buf_trn-doc.doc-type = 'при':U
     4316       then do:
     4317         do while available archive_parts
     4318         on error undo, return error return-value
     4319         :
     4320           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     4321           or (buf_trn-doc.doc-type = 'инв':U
     4322               and archive_parts.fact-qnty < 0)
     4323           then do:
     4324             assign
     4325               v-rsrv-code = 'out-zone':U
     4326             .
     4327           end.
     4328           else do:
     4329             assign
     4330               v-rsrv-code = 'free-zone':U
     4331             .
     4332           end.
     4333           assign
     4334             archive_parts.status_   = yes
     4335             archive_parts.rsrv-free = ?
     4336           .
     4337           if archive_parts.in-code = p-doc-code
     4338           then do:
     4339             assign
     4340               archive_parts.fact-num  = buf_trn-doc.fact-num
     4341               archive_parts.fact-date = buf_trn-doc.fact-date
     4342               archive_parts.doc-type  = buf_trn-doc.doc-type
     4343             .
     4344           end.
     4345           if archive_parts.fact-qnty <> 0
     4346           then do:
     4347             run partcopy in this-procedure
     4348               (input  true
     4349               ,input  v-rsrv-code
     4350               ,buffer archive_parts
     4351               ,buffer buf_parts
     4352               ,input  ""
     4353               ) no-error .
     4354             if error-status :error
     4355             then do:
     4356               message
     4357                 vss-workfile vss-revision vss-description skip
     4358                 vss-include-info23 skip
     4359                 "Ошибка при создании партии" skip
     4360                 "Документ" p-doc-code skip
     4361                 "Объект" p-obj-type p-obj-code skip
     4362                 "Артикул" p-artic p-prod-type p-prod-code skip
     4363                 "Партия" archive_parts.in-code archive_parts.part-code skip
     4364                 "Резерв" v-rsrv-code skip
     4365                 error-status :get-message(1) skip
     4366                 return-value skip
     4367                 view-as alert-box error .
     4368               undo, return error .
     4369             end.
     4370             assign
     4371               buf_parts.qnty      = buf_parts.qnty     + archive_parts.fact-qnty
     4372               buf_parts.fact-qnty = buf_parts.qnty
     4373             .
     4374             if v-goods-twounit = true
     4375             then do:
     4376               assign
     4377                 buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     4378               .
     4379               case buf_trn-doc.ext-doc-type :
     4380                 when 'ie':U
     4381                 then do:
     4382                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     4383                   then do:
     4384                     message
     4385                       vss-workfile vss-revision vss-description skip
     4386                       vss-include-info23 skip
     4387                       "Клиентское количество для товара," skip
     4388                       "который учитывается по двум единицам измерения" skip
     4389                       "должно равняться единице" skip
     4390                       "Документ" p-doc-code skip
     4391                       "Объект" p-obj-type p-obj-code skip
     4392                       "Артикул" p-artic p-prod-type p-prod-code skip
     4393                       "Партия" archive_parts.in-code archive_parts.part-code skip
     4394                       "Количество по документу" archive_parts.qnty skip
