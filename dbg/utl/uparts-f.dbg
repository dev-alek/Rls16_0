     9580       ASSIGN
     9581         x_parts.last-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date63 :HANDLE
     9582         x_parts.last-date :MENU-MOUSE in frame Dialog-Frame = 3
     9583       .
     9584     end.
     9585     define variable v-label-handle63 as handle no-undo .
     9586     assign
     9587       v-label-handle63 = x_parts.last-date :side-label-handle in frame Dialog-Frame
     9588     .
     9589     if valid-handle (v-label-handle63)
     9590     then do:
     9591       if v-label-handle63 :tooltip = ""
     9592       or v-label-handle63 :tooltip = ?
     9593       then do:
     9594         assign
     9595           v-label-handle63 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     9596         .
     9597       end.
     9598     end.
     9599     ON CHOOSE OF MENU-ITEM m-ed-date63-1 in menu m-ed-date63 DO:
     9600       apply "ctrl-b":U to x_parts.last-date in frame Dialog-Frame .
     9601     END.
     9602     ON CHOOSE OF MENU-ITEM m-ed-date63-2 in menu m-ed-date63 DO:
     9603       apply "ctrl-d":U to x_parts.last-date in frame Dialog-Frame .
     9604     END.
     9605     ON CHOOSE OF MENU-ITEM m-ed-date63-3 in menu m-ed-date63 DO:
     9606       apply "ctrl-e":U to x_parts.last-date in frame Dialog-Frame .
     9607     END.
     9608     ON CHOOSE OF MENU-ITEM m-ed-date63-4 in menu m-ed-date63 DO:
     9609       apply "ctrl-f":U to x_parts.last-date in frame Dialog-Frame .
     9610     END.
     9611   on choose of b-choose-last-date in frame Dialog-Frame
     9612   do:
     9613     run sel-date in this-procedure
     9614       (input x_parts.last-date :handle
     9615       ,input "Годен до &1 (для партии товара)"
     9616       ) .
     9617   end.
     9618   MAIN-BLOCK:
     9619   DO
     9620   ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     9621   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     9622   :
     9623   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9624     run mainmenu_getcntxt in parparentproc
     9625       (output v-cntxt-db-num
     9626       ,output v-cntxt-userid
     9627       ,output v-cntxt-level
     9628       ,output v-cntxt-host-code-obj
     9629       ,output v-cntxt-obj-type
     9630       ,output v-cntxt-obj-code
     9631       ,output v-cntxt-db-num-obj
     9632       ,output v-cntxt-is-admin
     9633       ) .
     9634     run init-proc no-error .
     9635     if error-status :error
     9636     then do:
     9637       undo MAIN-BLOCK, LEAVE MAIN-BLOCK .
     9638     end.
     9639   END.
     9640   RUN disable_UI.
     9641   PROCEDURE apply-focus-next-entry :
     9642     define input parameter p-widget-handle as handle no-undo .
     9643     define variable v-apply-entry as logical no-undo .
     9644     assign
     9645       v-apply-entry = false
     9646     .
     9647     do with frame Dialog-Frame
     9648     :
     9649           if v-apply-entry   then do:     if x_parts.cli-qnty :sensitive     then do:       apply 'entry':u to x_parts.cli-qnty .       return .     end.   end.   if x_parts.cli-qnty :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9650           if v-apply-entry   then do:     if x_parts.qnty :sensitive     then do:       apply 'entry':u to x_parts.qnty .       return .     end.   end.   if x_parts.qnty :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9651           if v-apply-entry   then do:     if x_parts.fact-qnty :sensitive     then do:       apply 'entry':u to x_parts.fact-qnty .       return .     end.   end.   if x_parts.fact-qnty :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9652           if v-apply-entry   then do:     if x_parts.part-code :sensitive     then do:       apply 'entry':u to x_parts.part-code .       return .     end.   end.   if x_parts.part-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9653           if v-apply-entry   then do:     if x_parts.cst-code :sensitive     then do:       apply 'entry':u to x_parts.cst-code .       return .     end.   end.   if x_parts.cst-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9654           if v-apply-entry   then do:     if x_parts.supp-type :sensitive     then do:       apply 'entry':u to x_parts.supp-type .       return .     end.   end.   if x_parts.supp-type :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9655           if v-apply-entry   then do:     if x_parts.supp-code :sensitive     then do:       apply 'entry':u to x_parts.supp-code .       return .     end.   end.   if x_parts.supp-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9656           if v-apply-entry   then do:     if x_parts.last-date :sensitive     then do:       apply 'entry':u to x_parts.last-date .       return .     end.   end.   if x_parts.last-date :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9657           if v-apply-entry   then do:     if fi-last-date-offset :sensitive     then do:       apply 'entry':u to fi-last-date-offset .       return .     end.   end.   if fi-last-date-offset :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9658           if v-apply-entry   then do:     if fi-contract-prn-code :sensitive     then do:       apply 'entry':u to fi-contract-prn-code .       return .     end.   end.   if fi-contract-prn-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9659           if v-apply-entry   then do:     if x_parts.price-cli :sensitive     then do:       apply 'entry':u to x_parts.price-cli .       return .     end.   end.   if x_parts.price-cli :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9660           if v-apply-entry   then do:     if x_parts.exch-code :sensitive     then do:       apply 'entry':u to x_parts.exch-code .       return .     end.   end.   if x_parts.exch-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9661           if v-apply-entry   then do:     if x_parts.price-rubl :sensitive     then do:       apply 'entry':u to x_parts.price-rubl .       return .     end.   end.   if x_parts.price-rubl :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9662           if v-apply-entry   then do:     if x_parts.price-base :sensitive     then do:       apply 'entry':u to x_parts.price-base .       return .     end.   end.   if x_parts.price-base :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9663           if v-apply-entry   then do:     if fi-vat-pc :sensitive     then do:       apply 'entry':u to fi-vat-pc .       return .     end.   end.   if fi-vat-pc :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9664           if v-apply-entry   then do:     if fi-slt-pc :sensitive     then do:       apply 'entry':u to fi-slt-pc .       return .     end.   end.   if fi-slt-pc :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9665           if v-apply-entry   then do:     if b-exit :sensitive     then do:       apply 'entry':u to b-exit .       return .     end.   end.   if b-exit :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
     9666       assign
     9667         v-apply-entry = true
     9668       .
     9669       if v-apply-entry = true
     9670       then do:
     9671         apply 'entry':u to b-exit .
     9672       end.
     9673     end.
     9674   END PROCEDURE.
     9675   PROCEDURE check-current-modified :
     9676     define variable lok as logical no-undo .
     9677     define variable v-record-modified as logical no-undo .
     9678     if v-fields-enabled
     9679     then do:
     9680       run record-modified in this-procedure
     9681         (output v-record-modified
     9682         ) no-error .
     9683       if error-status :error
     9684       then do:
     9685         message
     9686           vss-workfile vss-revision vss-description skip
     9687           "Ошибка при вызове процедуры record-modified" skip
     9688           error-status :get-message(1) skip
     9689           return-value skip
     9690           view-as alert-box error .
     9691         undo, return error .
     9692       end.
     9693       if v-record-modified = false
     9694       then do:
     9695         return .
     9696       end.
     9697       message
     9698         "Партия была изменена." skip
     9699         "ДА"     chr(9) "сохранить изменения и перейти к другой записи." skip
     9700         "НЕТ"    chr(9) "не сохранять изменения и перейти к другой записи." skip
     9701         "ОТМЕНА" chr(9) "не переходить к другой записи." skip
     9702         view-as alert-box question button yes-no-cancel update lok .
     9703       if lok = true
     9704       then do:
     9705         define variable v-close-window as logical no-undo .
     9706         run update-record in this-procedure
     9707           (output v-close-window
     9708           ) no-error .
     9709         if error-status :error
     9710         then do:
     9711           undo, return error .
     9712         end.
     9713         return .
     9714       end.
     9715       if lok = false
     9716       then do:
     9717         return .
     9718       end.
     9719       if lok = ?
     9720       then do:
     9721         undo, return error .
     9722       end.
     9723     end.
     9724   END PROCEDURE.
     9725   PROCEDURE choose-contract :
     9726     define input  parameter v-supp-type as character no-undo .
     9727     define input  parameter v-supp-code as integer   no-undo .
     9728     define buffer buf_trn-doc for ub.trn-doc .
     9729     define variable v-host-code as integer   no-undo .
     9730     do
     9731     transaction on error undo, return error return-value
     9732     :
     9733       find first buf_trn-doc no-lock
     9734         where buf_trn-doc.doc-code = p-doc-code
     9735         .
     9736   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     9738     (input  buf_trn-doc.obj-type
     9739     ,input  buf_trn-doc.obj-code
     9740     ,output v-host-code
     9741     )  .
     9742       define buffer buf_contract for ub.contract .
     9743       run check-contract-code in this-procedure
     9744         (input  "choose":u
     9745         ,input  v-host-code
     9746         ,input  v-supp-type
     9747         ,input  v-supp-code
     9748         ,input  ?
     9749         ,input  parparentproc
     9750         ,input  buf_trn-doc.doc-date
     9751         ,input  ""
     9752         ,output v-contract-code
     9753         ) no-error .
     9754       if error-status :error
     9755       or v-contract-code = ?
     9756       or v-contract-code = 0
     9757       then do:
     9758         if return-value <> ""
     9759         or error-status :get-message(1) <> ""
     9760         then do:
     9761           message
     9762             "Ошибка при заведении номера договора." skip
     9763             return-value skip
     9764             error-status :get-message(1) skip
     9765             view-as alert-box error.
     9766         end.
     9767         return error.
     9768       end.
     9769       assign
     9770         v-modified-contract-code = true
     9771       .
     9772       find first buf_contract no-lock
     9773         where buf_contract.host-code     = v-host-code
     9774           and buf_contract.contract-code = v-contract-code
     9775         .
     9776       display
     9777         buf_contract.contract-prn-code @ fi-contract-prn-code
     9778         substitute("&1 Вн.н. &2"
     9779                   ,string(buf_contract.contract-date,'99/99/9999':u)
     9780                   ,v-contract-code) @ fi-contract-name
     9781         with frame Dialog-Frame .
     9782       assign
     9783         fi-contract-prn-code
     9784       .
     9785       assign
     9786         v-modified-exch-code = true
     9787         v-exch-code          = buf_contract.curr-code
     9788       .
     9789       run update-exch-code-dependent in this-procedure .
     9790       assign
     9791         v-display-price-cli    = true
     9792         v-enable-price-cli     = true
     9793         v-enable-cli-exch-code = false
     9794       .
     9795       run update-enable-price-cli in this-procedure .
     9796       run update-exch-code-enable in this-procedure .
     9797     end.
     9798   END PROCEDURE.
     9799   PROCEDURE choose-exch-code :
     9800     define input  parameter v-exch-code as integer   no-undo .
     9801     define buffer buf_currency for ub.currency .
     9802     define variable v-repos-recid as recid     no-undo .
     9803     do
     9804     on error undo, return error return-value
     9805     :
     9806       find first buf_currency no-lock
     9807         where buf_currency.curr-code = v-exch-code
     9808         no-error .
     9809       if available buf_currency
     9810       then do:
     9811         assign
     9812           v-repos-recid = recid(buf_currency)
     9813         .
     9814       end.
     9815       else do:
     9816         assign
     9817           v-repos-recid = ?
     9818         .
     9819       end.
     9820       run ref/currency.w
     9821         (input parparentproc
     9822         ,input "b-sel"
     9823         ,input-output v-repos-recid
     9824         ).
     9825       if v-repos-recid <> ?
     9826       then do:
     9827         find first buf_currency no-lock
     9828           where recid( buf_currency ) = v-repos-recid
     9829           no-error .
     9830         if available buf_currency
     9831         then do:
     9832           do with frame Dialog-Frame
     9833           :
     9834             assign
     9835               x_parts.exch-code :screen-value = string(buf_currency.curr-code
     9836                                                     ,x_parts.exch-code :format
     9837                                                     )
     9838               val-price-cli   :screen-value = string(buf_currency.curr-abbr
     9839                                                     ,val-price-cli  :format
     9840                                                     )
     9841             .
     9842           end.
     9843         end.
     9844         run validate-exch-code in this-procedure no-error .
     9845         if error-status :error
     9846         then do:
     9847           if error-status :get-message(1) <> ""
     9848           then do:
     9849             message
     9850               vss-workfile vss-revision vss-description skip
     9851               "Ошибка при вызове процедуры" skip
     9852               error-status :get-message(1) skip
     9853               return-value skip
     9854               view-as alert-box error .
     9855           end.
     9856           undo, return no-apply .
     9857         end.
     9858       end.
     9859     end.
     9860   END PROCEDURE.
     9861   PROCEDURE clear-contract-value :
     9862     define buffer buf_currency for ub.currency .
     9863     do
     9864     on error undo, return error return-value
     9865     :
     9866       do with frame Dialog-Frame
     9867       :
     9868         assign
     9869           v-modified-contract-code           = true
     9870           v-contract-code                    = 0
     9871           fi-contract-prn-code               = ""
     9872           fi-contract-prn-code :screen-value = ""
     9873           fi-contract-name     :screen-value = ""
     9874           x_parts.price-cli      :screen-value = ""
     9875           v-modified-exch-code               = true
     9876           v-exch-code                        = 0
     9877         .
     9878         find first buf_currency no-lock
     9879           where buf_currency.curr-code = v-exch-code
     9880           no-error .
     9881         if available buf_currency
     9882         then do:
     9883           assign
     9884             x_parts.exch-code :screen-value = string(buf_currency.curr-code
     9885                                                   ,x_parts.exch-code :format
     9886                                                   )
     9887             val-price-cli   :screen-value = string(buf_currency.curr-abbr
     9888                                                   ,val-price-cli  :format
     9889                                                   )
     9890           .
     9891         end.
     9892       end.
     9893     end.
     9894   END PROCEDURE.
     9895   PROCEDURE close-window :
     9896     assign
     9897       v-undo-last = true
     9898     .
     9899     apply "go":u to frame Dialog-Frame .
     9900   END PROCEDURE.
     9901   PROCEDURE determine-enable-qnty :
     9902   define output parameter p-enable-qnty  as character no-undo .
     9903       assign
     9904        p-enable-qnty = "cli-qnty":u
     9905       .
