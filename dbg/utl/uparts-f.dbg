     8090   DEFINE QUERY Dialog-Frame FOR
     8091         x_parts SCROLLING.
     8092   DEFINE FRAME Dialog-Frame
     8093        b-exit AT ROW 1 COL 1
     8094        b-quit AT ROW 1 COL 10
     8095        b-prev AT ROW 1 COL 19
     8096        b-next AT ROW 1 COL 23.5
     8097        b-save AT ROW 1 COL 28
     8098        b-rest AT ROW 1 COL 39
     8099        b-alc-attr AT ROW 1 COL 52.13
     8100        b-help AT ROW 1 COL 87
     8101        x_parts.PS AT ROW 5.92 COL 59 NO-LABEL
     8102             VIEW-AS EDITOR
     8103             SIZE 30.75 BY 4.17
     8104        x_parts.cli-qnty AT ROW 6.92 COL 13.25 COLON-ALIGNED
     8105             VIEW-AS FILL-IN
     8106             SIZE 16 BY 1
     8107        x_parts.cli-base-rate AT ROW 6.92 COL 41 COLON-ALIGNED NO-LABEL
     8108             VIEW-AS FILL-IN
     8109             SIZE 12.5 BY 1
     8110             FGCOLOR 4
     8111        x_parts.qnty AT ROW 8 COL 13.25 COLON-ALIGNED
     8112             VIEW-AS FILL-IN
     8113             SIZE 16 BY 1
     8114        x_parts.fact-qnty AT ROW 9.08 COL 13.25 COLON-ALIGNED HELP
     8115             "Укажите фактическое количество товара в учетных единицах"
     8116             LABEL "Факт"
     8117             VIEW-AS FILL-IN
     8118             SIZE 16 BY 1
     8119        x_parts.part-code AT ROW 10.83 COL 13.5 COLON-ALIGNED FORMAT "X(20)"
     8120             VIEW-AS FILL-IN
     8121             SIZE 23 BY 1
     8122        fi-vat-pc AT ROW 11 COL 65.5 COLON-ALIGNED
     8123        x_parts.cst-code AT ROW 12 COL 13.5 COLON-ALIGNED
     8124             FORMAT "x(31)"
     8125             VIEW-AS FILL-IN
     8126             SIZE 32 BY 1
     8127        fi-slt-pc AT ROW 12.08 COL 65.5 COLON-ALIGNED
     8128        x_parts.supp-type AT ROW 13.17 COL 13.5 COLON-ALIGNED
     8129             VIEW-AS FILL-IN
     8130             SIZE 9.25 BY 1
     8131        x_parts.supp-code AT ROW 13.17 COL 23 COLON-ALIGNED NO-LABEL FORMAT "9999999999"
     8132             VIEW-AS FILL-IN
     8133             SIZE 13.5 BY 1
     8134        r-supp AT ROW 13.25 COL 39.13
     8135        x_parts.last-date AT ROW 14.38 COL 13.63 COLON-ALIGNED
     8136             LABEL "Годен до"
     8137             VIEW-AS FILL-IN
     8138             SIZE 11 BY 1
     8139        b-choose-last-date AT ROW 14.38 COL 27.13
     8140        fi-last-date-offset AT ROW 14.38 COL 29 COLON-ALIGNED NO-LABEL
     8141        fi-contract-prn-code AT ROW 15.67 COL 13.38 COLON-ALIGNED
     8142        r-contract AT ROW 15.75 COL 33.5
     8143        x_parts.price-cli AT ROW 18.5 COL 13.5 COLON-ALIGNED
     8144             LABEL "По ТТН" FORMAT "->>,>>>,>>>,>>9.999"
     8145             VIEW-AS FILL-IN
     8146             SIZE 23.25 BY 1
     8147        tot-price-cli AT ROW 18.5 COL 43 COLON-ALIGNED NO-LABEL
     8148        x_parts.exch-code AT ROW 18.5 COL 66 COLON-ALIGNED NO-LABEL
     8149             VIEW-AS FILL-IN
     8150             SIZE 4 BY 1
     8151             FGCOLOR 4
     8152        r-exch-code AT ROW 18.5 COL 73
     8153        x_parts.price-rubl AT ROW 19.58 COL 13.5 COLON-ALIGNED
     8154             LABEL "Учет" FORMAT ">>,>>>,>>>,>>9.9999999999"
     8155             VIEW-AS FILL-IN
     8156             SIZE 23.25 BY 1
     8157        tot-price-rubl AT ROW 19.58 COL 43 COLON-ALIGNED NO-LABEL
     8158        b-edit-price AT ROW 20.25 COL 39.5
     8159        x_parts.price-base AT ROW 20.71 COL 13.5 COLON-ALIGNED
     8160             LABEL "Учет" FORMAT ">>,>>>,>>>,>>9.9999999999"
     8161             VIEW-AS FILL-IN
     8162             SIZE 23.25 BY 1
     8163        tot-price-base AT ROW 20.71 COL 43 COLON-ALIGNED NO-LABEL
     8164        FI-goods-artic AT ROW 2.42 COL 14.5 COLON-ALIGNED
     8165        fi-gds-name AT ROW 2.42 COL 36.75 COLON-ALIGNED NO-LABEL
     8166        FI-goods-prod-type-code AT ROW 3.5 COL 14.5 COLON-ALIGNED
     8167        FI-clients-name AT ROW 3.5 COL 36.75 COLON-ALIGNED NO-LABEL
     8168        FI-b-code AT ROW 4.67 COL 14.5 COLON-ALIGNED
     8169        fi-out-code AT ROW 4.67 COL 45.5 COLON-ALIGNED
     8170        FI-label-kolichestvo AT ROW 6.08 COL 13.25 COLON-ALIGNED NO-LABEL
     8171        FI-label-ed-izm AT ROW 6.08 COL 30.5 COLON-ALIGNED NO-LABEL
     8172       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     8173            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE .
     8174   DEFINE FRAME Dialog-Frame
     8175        FI-label-koefficient AT ROW 6.08 COL 41.25 COLON-ALIGNED NO-LABEL
     8176        fi-unit-cli AT ROW 7.08 COL 30.63 COLON-ALIGNED NO-LABEL
     8177        fi-unit AT ROW 8.21 COL 30.75 COLON-ALIGNED NO-LABEL
     8178        fi-unit-2 AT ROW 9.29 COL 30.75 COLON-ALIGNED NO-LABEL
     8179        fi-vat-type AT ROW 11.17 COL 54 COLON-ALIGNED
     8180        fi-slt-type AT ROW 12.21 COL 54 COLON-ALIGNED
     8181        fi-supp AT ROW 13.38 COL 40.88 COLON-ALIGNED NO-LABEL
     8182        fi-contract-name AT ROW 15.83 COL 35.88 COLON-ALIGNED NO-LABEL
     8183        FI-label-cena AT ROW 17.46 COL 13.5 COLON-ALIGNED NO-LABEL
     8184        FI-label-summa AT ROW 17.46 COL 43 COLON-ALIGNED NO-LABEL
     8185        FI-label-val AT ROW 17.46 COL 66.5 COLON-ALIGNED NO-LABEL
     8186        val-price-cli AT ROW 18.63 COL 75.5 COLON-ALIGNED NO-LABEL
     8187        val-rubl-code AT ROW 19.75 COL 66.25 COLON-ALIGNED NO-LABEL
     8188        val-price-rubl AT ROW 19.75 COL 75.38 COLON-ALIGNED NO-LABEL
     8189        val-base-code AT ROW 20.71 COL 66.25 COLON-ALIGNED NO-LABEL
     8190        val-price-base AT ROW 20.96 COL 75.25 COLON-ALIGNED NO-LABEL
     8191        RECT-2 AT ROW 5.83 COL 1
     8192        RECT-3 AT ROW 10.58 COL 1
     8193        RECT-4 AT ROW 17.21 COL 1.25
     8194        RECT-1 AT ROW 2.17 COL 1
     8195        SPACE(1.37) SKIP(16.57)
     8196       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     8197            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     8198            TITLE "Партия товара".
     8199   ASSIGN
     8200          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     8201          FRAME Dialog-Frame:HIDDEN           = TRUE.
     8202   ASSIGN
     8203          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     8204   ASSIGN
     8205          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     8206   ASSIGN
     8207          x_parts.PS:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     8208   ON ESC OF FRAME Dialog-Frame
     8209   DO:
     8210     assign
     8211       v-undo-last = true
     8212     .
     8213     apply "go":u to self .
     8214     return no-apply .
     8215   END.
     8216   ON GO OF FRAME Dialog-Frame
     8217   DO:
     8218     define variable v-close-window as logical no-undo .
     8219     if v-undo-last = true
     8220     then do:
     8221       return .
     8222     end.
     8223     run validate-qnty in this-procedure no-error .
     8224     if error-status :error
     8225     then do:
     8226       undo, return no-apply .
     8227     end.
     8228     run update-record in this-procedure
     8229       ( output v-close-window
     8230       ) no-error .
     8231     if error-status :error
     8232     then do:
     8233       undo, return no-apply .
     8234     end.
     8235   END.
     8236   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     8237   DO:
     8238     APPLY "END-ERROR":U TO SELF.
     8239   END.
     8240   ON CHOOSE OF b-alc-attr IN FRAME Dialog-Frame
     8241   DO:
     8242   define variable vss-include-info50 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8243   if lookup(self :type
     8244            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     8245            ) = 0
     8246   then do:
     8247     message
     8248       "$Workfile$"
     8249       "Указанному интерфейсному элементу фокус не может быть передан" skip
     8250       "Интерфейсный элемент" self :name  skip
     8251       "Тип" self :type  skip
     8252       "Процедура" this-procedure :file-name skip
     8253       view-as alert-box .
     8254   end.
     8255   else do:
     8256     apply "entry":u to self  .
     8257     if focus :handle <> self :handle  then do:
     8258       return no-apply .
     8259     end.
     8260   end.
     8261     define variable v-save-flag           as logical   no-undo .
     8262     if v-alcohol-prod = true then do:
     8263       run str/in-alc.w
     8264         (input        parparentproc
     8265         ,input        'ИЗМЕНЕНИЕ':U
     8266         ,input p-gds-code
     8267         ,input-output v-alc-mark-db-num
     8268         ,input-output v-alc-mark-code
     8269         ,input-output v-alc-bottling-date
     8270         ,input-output v-alc-ref-ab-path
     8271         ,input-output v-alc-quality-certif-path
     8272         ,input-output v-alc-certif-path
     8273         ,input-output v-alc-imp-type
     8274         ,input-output v-alc-imp-code
     8275         ,output       v-save-flag
     8276         ) no-error .
     8277       if error-status :error
     8278       then do:
     8279         if error-status :get-message(1) <> '':u
     8280         then do:
     8281           message
     8282             vss-workfile vss-revision vss-description skip
     8283             "Ошибка при вызове процедуры in-alc.w" skip
     8284             error-status :get-message(1) skip
     8285             return-value skip
     8286             view-as alert-box error .
     8287         end.
     8288         undo, return no-apply .
     8289       end.
     8290       define variable v-display-part-code as character no-undo .
     8291       run partsfnc_get-parts-show-code in this-procedure
     8292         (input  v-new-parts-part-code
     8293         ,input  v-alc-mark-db-num
     8294         ,input  v-alc-mark-code
     8295         ,input  v-alc-bottling-date
     8296         ,input  v-alcohol-prod
     8297         ,output v-display-part-code
     8298         ) .
     8299       assign
     8300         x_parts.part-code :screen-value = string(v-display-part-code
     8301                                               ,x_parts.part-code :format
     8302                                               )
     8303       .
     8304         run trg/partps.p ( input p-gds-code
     8305                          , input x_parts.in-code
     8306                          , input x_parts.part-code
     8307                          , input v-alc-mark-db-num
     8308                          , input v-alc-mark-code
     8309                          , input v-alc-bottling-date
     8310                          , input v-alc-ref-ab-path
     8311                          , input v-alc-quality-certif-path
     8312                          , input v-alc-certif-path
     8313                          , input v-alc-imp-type
     8314                          , input v-alc-imp-code
     8315                          ) no-error .
     8316     end.
     8317   END.
     8318   ON CHOOSE OF b-edit-price IN FRAME Dialog-Frame
     8319   DO:
     8320     define variable v-parts-price-base      as decimal   no-undo .
     8321     define variable v-parts-price-rubl      as decimal   no-undo .
     8322     define variable v-orig-parts-price-base as decimal   no-undo .
     8323     define variable v-orig-parts-price-rubl as decimal   no-undo .
     8324     define variable v-action                as character no-undo .
     8325     define variable v-parts-chg-qnty        as decimal   no-undo .
     8326     define buffer buf_trn-doc for ub.trn-doc .
     8327     define buffer buf_goods   for ub.goods .
     8328     define buffer buf_clients for ub.clients .
     8329     if v-can-change-supp = false
     8330     then do:
     8331       assign
     8332         v-parts-price-base = decimal(x_parts.price-base :screen-value)
     8333         v-parts-price-rubl = decimal(x_parts.price-rubl :screen-value)
     8334       .
     8335     end.
     8336     else do:
     8337       if v-enable-price-rubl = true
     8338       then do:
     8339         assign
     8340           v-parts-price-rubl = decimal(x_parts.price-rubl :screen-value)
     8341         .
     8342       end.
     8343       else do:
     8344         if  v-enable-price-cli = true
     8345         and v-exch-code        = 0
     8346         then do:
     8347           assign
     8348             v-parts-price-rubl = decimal(x_parts.price-cli :screen-value)
     8349           .
     8350         end.
     8351       end.
     8352       if v-enable-price-base = true
     8353       then do:
     8354         assign
     8355           v-parts-price-base = decimal(x_parts.price-base :screen-value)
     8356         .
     8357       end.
     8358       else do:
     8359         if  v-enable-price-cli = true
     8360         and v-exch-code        = (input frame Dialog-Frame val-base-code)
     8361         then do:
     8362           assign
     8363             v-parts-price-base = decimal(x_parts.price-cli :screen-value)
     8364           .
     8365         end.
     8366       end.
     8367     end.
     8368     assign
     8369       v-orig-parts-price-base = v-parts-price-base
     8370       v-orig-parts-price-rubl = v-parts-price-rubl
     8371     .
     8372     find first buf_trn-doc no-lock
     8373       where buf_trn-doc.doc-code = p-doc-code
     8374       .
     8375     find first buf_goods no-lock
     8376       where buf_goods.gds-code = p-gds-code
     8377       .
     8378     find first buf_clients no-lock
     8379       where buf_clients.obj-type = x_parts.supp-type :screen-value
     8380         and buf_clients.obj-code = integer(x_parts.supp-code :screen-value)
     8381       no-error .
     8382     if not available buf_clients
     8383     then do:
     8384       find first buf_clients no-lock
     8385         where buf_clients.obj-type = buf_trn-doc.obj-type
     8386           and buf_clients.obj-code = buf_trn-doc.obj-code
     8387         .
     8388     end.
     8389     assign
     8390       v-parts-chg-qnty = decimal(x_parts.qnty :screen-value)
     8391     .
     8392     run trg/in-price.w
     8393       (input parparentproc
     8394       ,input-output v-parts-price-base
     8395       ,input-output v-parts-price-rubl
     8396       ,output v-action
     8397       ,input  buf_trn-doc.obj-type
     8398       ,input  buf_trn-doc.obj-code
     8399       ,input  buf_goods.artic
     8400       ,input  buf_goods.prod-type
     8401       ,input  buf_goods.prod-code
     8402       ,input  buf_clients.obj-type
     8403       ,input  buf_clients.obj-code
     8404       ,input  buf_trn-doc.base-rate
     8405       ,input  buf_trn-doc.base-scale
     8406       ,input  v-parts-chg-qnty
     8407       ) no-error .
     8408     if error-status :error
     8409     then do:
     8410       return no-apply .
     8411     end.
     8412     if v-parts-price-rubl  <> v-orig-parts-price-rubl
     8413     then do:
     8414       if v-enable-price-rubl = true
     8415       then do:
     8416         assign
     8417           x_parts.price-rubl :screen-value = string(v-parts-price-rubl
     8418                                                    ,x_parts.price-rubl :format
     8419                                                   )
     8420         .
     8421       end.
     8422       else do:
     8423         if  v-enable-price-cli = true
     8424         and v-exch-code        = 0
     8425         then do:
     8426           assign
     8427             x_parts.price-cli :screen-value = string(v-parts-price-rubl
     8428                                                   ,x_parts.price-cli :format
     8429                                                   )
     8430           .
     8431         end.
     8432       end.
     8433     end.
     8434     if v-parts-price-base  <> v-orig-parts-price-base
     8435     then do:
     8436       if v-enable-price-base = true
     8437       then do:
     8438         assign
     8439           x_parts.price-base :screen-value = string(v-parts-price-base
     8440                                                 ,x_parts.price-base :format
     8441                                                 )
     8442         .
     8443       end.
     8444       else do:
     8445         if  v-enable-price-cli = true
     8446         and v-exch-code        = (input frame Dialog-Frame val-base-code)
     8447         then do:
     8448           assign
     8449             x_parts.price-cli :screen-value = string(v-parts-price-base
     8450                                                   ,x_parts.price-cli :format
     8451                                                   )
     8452           .
     8453         end.
