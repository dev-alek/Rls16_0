     4866           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     4867           )
     4868           or buf_trn-doc.ext-doc-type = 'rv':U
     4869           then do:
     4870             if can-do('рас,спи':U,buf_trn-doc.doc-type)
     4871             or (buf_trn-doc.doc-type = 'инв':U
     4872                 and archive_parts.fact-qnty < 0
     4873               )
     4874             then do:
     4875               assign
     4876                 v-rsrv-code = 'free-zone':U
     4877               .
     4878             end.
     4879             else do:
     4880               assign
     4881                 v-rsrv-code = 'out-zone':U
     4882               .
     4883             end.
     4884             if not v-izlcstpr
     4885             then do :
     4886                 run partcopy in this-procedure
     4887                   (input  true
     4888                   ,input  v-rsrv-code
     4889                   ,buffer archive_parts
     4890                   ,buffer buf_parts
     4891                   ,input  ""
     4892                   ) no-error .
     4893                 if error-status :error
     4894                 then do:
     4895                   message
     4896                     vss-workfile vss-revision vss-description skip
     4897                     vss-include-info23 skip
     4898                     "Ошибка при создании партии" skip
     4899                     "Документ" p-doc-code skip
     4900                     "Объект" p-obj-type p-obj-code skip
     4901                     "Артикул" p-artic p-prod-type p-prod-code skip
     4902                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4903                     "Резерв" v-rsrv-code skip
     4904                     error-status :get-message(1) skip
     4905                     return-value skip
     4906                     view-as alert-box error .
     4907                   undo, return error .
     4908                 end.
     4909                 assign
     4910                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
     4911                   buf_parts.fact-qnty = buf_parts.qnty
     4912                 .
     4913                 if buf_trn-doc.ext-doc-type = 'rv':U
     4914                 then
     4915                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4916                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     4917                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     4918                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     4919                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     4920                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     4921                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     4922                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4923                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     4924                   then
     4925                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4926                 end .
     4927                 if v-goods-twounit = true
     4928                 then do:
     4929                   message
     4930                     vss-workfile vss-revision vss-description skip
     4931                     vss-include-info23 skip
     4932                     "Запрещено порождение партий," skip
     4933                     "который учитывается по двум единицам измерения" skip
     4934                     "Документ" p-doc-code skip
     4935                     "Объект" p-obj-type p-obj-code skip
     4936                     "Артикул" p-artic p-prod-type p-prod-code skip
     4937                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4938                     "Количество по документу" archive_parts.qnty skip
     4939                     "Фактическое количество" archive_parts.fact-qnty skip
     4940                     "Клиентское количество" archive_parts.cli-qnty skip
     4941                     view-as alert-box error .
     4942                   undo, return error .
     4943                 end.
     4944                 else do:
     4945                   if buf_parts.cli-base-rate <> 0
     4946                   then do:
     4947                     assign
     4948                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     4949                     .
     4950                   end.
     4951                   else do:
     4952                     assign
     4953                       buf_parts.cli-qnty = 0
     4954                     .
     4955                   end.
     4956                 end.
     4957             end.
     4958           end.
     4959           get next partcopy-select-parts .
     4960         end.
     4961       end.
     4962     end.
     4963   end procedure.
     4964   procedure partcopy-update-parts-delete :
     4965     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
