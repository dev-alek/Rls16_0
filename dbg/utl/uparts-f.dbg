     9907   PROCEDURE disable-fields :
     9908     do with frame Dialog-Frame:
     9909       assign
     9910         x_parts.PS         :read-only = true
     9911       .
     9912       assign
     9913         b-alc-attr :sensitive = false
     9914         b-alc-attr :visible   = false
     9915       .
     9916       assign
     9917         x_parts.part-code      :sensitive = false
     9918         x_parts.cst-code       :sensitive = false
     9919         x_parts.last-date      :sensitive = false
     9920         b-choose-last-date   :sensitive = false
     9921         fi-last-date-offset  :sensitive = false
     9922         x_parts.price-cli      :sensitive = false
     9923         x_parts.price-base     :sensitive = false
     9924         x_parts.price-rubl     :sensitive = false
     9925         b-edit-price         :sensitive = false
     9926         fi-vat-pc            :sensitive = false
     9927         fi-slt-pc            :sensitive = false
     9928         x_parts.qnty           :sensitive = false
     9929         x_parts.fact-qnty      :sensitive = false
     9930         x_parts.cli-qnty       :sensitive = false
     9931         x_parts.supp-type      :sensitive = false
     9932         x_parts.supp-code      :sensitive = false
     9933         r-supp               :sensitive = false
     9934         fi-contract-prn-code :sensitive = false
     9935         r-contract           :sensitive = false
     9936         x_parts.exch-code      :sensitive = false
     9937         r-exch-code          :sensitive = false
     9938       .
     9939       assign
     9940         fi-vat-pc :fgcolor = ?
     9941         fi-slt-pc :fgcolor = ?
     9942       .
     9943       assign
     9944         b-exit :label in frame Dialog-Frame = "&Выход"
     9945       .
     9946       assign
     9947         b-save               :sensitive = false
     9948         b-quit               :sensitive = false
     9949         b-rest               :sensitive = false
     9950       .
