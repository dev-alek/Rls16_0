    11317   PROCEDURE record-modified :
    11318     define output parameter p-record-modified as logical no-undo .
    11319     define buffer buf_parts    for x_parts .
    11320     do with frame Dialog-Frame
    11321     :
    11322       if x_parts.part-code :sensitive
    11323       then do:
    11324         if x_parts.part-code :modified = true
    11325         then do:
    11326           assign
    11327             p-record-modified = true
    11328           .
    11329           return .
    11330         end.
    11331       end.
    11332       if x_parts.cst-code :sensitive
    11333       then do:
    11334         if x_parts.cst-code :modified = true
    11335         then do:
    11336           assign
