    12215           .
    12216           if v-goods-twounit = true
    12217           then do:
    12218             assign
    12219               v-chg-qnty = input frame Dialog-Frame x_parts.qnty - buf_parts.qnty
    12220             .
    12221           end.
    12222         end.
    12223         when "qnty":u
    12224         then do:
    12225           case buf_parts.out-code :
    12226             when 'free-zone':U
    12227             then do:
    12228               assign
    12229                 v-chg-qnty = - input frame Dialog-Frame x_parts.qnty
    12230               .
    12231             end.
    12232             when 'out-zone':U
