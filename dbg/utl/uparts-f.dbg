        1   using ibs.th.str.alcohol.*.
        2   DEFINE TEMP-TABLE x_parts NO-UNDO LIKE parts.
        3   define input  parameter parparentproc       as widget-handle no-undo.
        4   define input  parameter h-call-prog         as handle    no-undo .
        5   define input  parameter p-doc-code          as character no-undo .
        6   define input  parameter p-gds-code          as integer   no-undo .
        7   define input  parameter p-pl-code           as integer   no-undo .
        8   define input  parameter p-in-code   as character no-undo .
        9   define input  parameter p-part-code as character no-undo .
       10   define input  parameter p-out-code  as character no-undo .
       11   define input-output  parameter table for x_parts.
       12   define variable chg-qnty      as   decimal no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Редактирование партии документа ВнешПН факт".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37       assign
       38         p-vss-parameters = substitute('&1|&2|&3|&4|':u,h-call-prog,p-doc-code,p-gds-code,p-pl-code)
       39       .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     define variable v-cntxt-db-num        as integer   no-undo .
      129     define variable v-cntxt-userid        as character no-undo .
      130     define variable v-cntxt-level         as character no-undo .
      131     define variable v-cntxt-host-code-obj as integer   no-undo .
      132     define variable v-cntxt-obj-type      as character no-undo .
      133     define variable v-cntxt-obj-code      as integer   no-undo .
      134     define variable v-cntxt-db-num-obj    as integer   no-undo .
      135     define variable v-cntxt-is-admin      as logical   no-undo .
      136   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      139   define variable par-type          as character no-undo.
      140   define variable v-value-character as character no-undo .
      141   define variable v-value-date      as date      no-undo .
      142   define variable v-value-decimal   as decimal   no-undo .
      143   define variable v-value-integer   as integer   no-undo .
      144   define variable v-value-logical   as logical   no-undo .
      145   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   procedure cur-time :
      147      define output parameter p-today as date      no-undo .
      148      define output parameter p-time  as integer   no-undo .
      149     do
      150     on error undo, return error
      151     :
      152       define variable v-date1 as date      no-undo .
      153       define variable v-date2 as date      no-undo .
      154       define variable v-time  as integer   no-undo .
      155       assign
      156         v-date1 = today
      157         v-time  = time
      158         v-date2 = today
      159       .
      160       if v-date1 <> v-date2
      161       then do:
      162         assign
      163           v-date1 = today
      164           v-time  = v-time
      165         .
      166       end.
      167       assign
      168         p-today = v-date1
      169         p-time  = v-time
      170       .
      171     end.
      172   end.
      173   function cur-time-date returns character
      174   :
      175     return string(today, '99/99/9999':U) .
      176   end.
      177   function cur-time-mjd returns decimal
      178   :
      179     define variable v-date as date      no-undo .
      180     define variable v-time as integer   no-undo .
      181     run cur-time in this-procedure
      182       (output v-date
      183       ,output v-time
      184       ) .
      185     return integer(v-date) - 2400002 + (v-time / 86400) .
      186   end.
      187   function cur-time-get-ending-index returns integer
      188   (input p-number as integer
      189   )
      190   :
      191     if p-number < 0
      192     or p-number = ?
      193     then do:
      194       return 1 .
      195     end.
      196     define variable v-rest as integer   no-undo .
      197     assign
      198       p-number = p-number modulo 100
      199     .
      200     if p-number < 20
      201     then do:
      202       assign
      203         v-rest = p-number
      204       .
      205     end.
      206     else do:
      207       assign
      208         v-rest = p-number modulo 10
      209       .
      210     end.
      211     case v-rest :
      212       when 1
      213       then do:
      214         return 2 .
      215       end.
      216       when 2 or
      217       when 3 or
      218       when 4
      219       then do:
      220         return 3 .
      221       end.
      222       otherwise do:
      223         return 1 .
      224       end.
      225     end case .
      226   end.
      227   procedure cur-time-mjd-to-date :
      228      define input  parameter i-mjd-diff as decimal no-undo.
      229      define output parameter o-Date     as date    no-undo.
      230      define output parameter o-Time     as integer no-undo.
      231      define variable v-day-number as integer   no-undo .
      232      if    i-mjd-diff < 0
      233         or i-mjd-diff = ?
      234      then do:
      235         return "?" .
      236      end.
      237      assign
      238         v-day-number = truncate(i-mjd-diff,0).
      239         o-Date = date(v-day-number + 2400002).
      240         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      241     .
      242   end.
      243   function cur-time-mjd-to-string returns character
      244   (input p-mjd-diff as decimal
      245   )
      246   :
      247     define variable v-day-number as integer   no-undo .
      248     define variable v-seconds    as integer   no-undo .
      249     define variable v-hour       as integer   no-undo .
      250     define variable v-min        as integer   no-undo .
      251     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      252     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      253     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      254     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      255     if p-mjd-diff < 0
      256     or p-mjd-diff = ?
      257     then do:
      258       return "?" .
      259     end.
      260     assign
      261       v-day-number = integer(truncate(p-mjd-diff,0))
      262       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      263     .
      264     if v-seconds > 86400
      265     then do:
      266       assign
      267         v-seconds = 86400 - 1
      268       .
      269     end.
      270     if v-seconds < 0
      271     then do:
      272       assign
      273         v-seconds = 0
      274       .
      275     end.
      276     assign
      277       v-hour = truncate(v-seconds / 3600, 0)
      278     .
      279     assign
      280       v-seconds = v-seconds modulo 3600
      281     .
      282     assign
      283       v-min = truncate(v-seconds / 60, 0)
      284     .
      285     assign
      286       v-seconds = v-seconds modulo 60
      287     .
      288     return
      289         (if v-day-number <> 0
      290           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      291           else ""
      292         )
      293       + (if v-day-number <> 0 or v-hour <> 0
      294           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      295           else ""
      296         )
      297       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      298           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      299           else ""
      300         )
      301       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      302       .
      303   end.
      304   function cur-time-string returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      313   end.
      314   function cur-time-string-sec returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      323   end.
      324   function cur-time-custom  returns character
      325   (input p-prefix as character
      326   ,input p-date-format as character
      327   ,input p-delimiter as character
      328   ,input p-time-format as character
      329   ,input p-suffix as character
      330   )
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return
      339       p-prefix
      340       + string(v-date, p-date-format)
      341       + p-delimiter
      342       + string(v-time, p-time-format)
      343       + p-suffix
      344       .
      345   end.
      346   function cur-time-print  returns character
      347   :
      348     define variable v-date as date      no-undo .
      349     define variable v-time as integer   no-undo .
      350     run cur-time in this-procedure
      351       (output v-date
      352       ,output v-time
      353       ) .
      354     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      355   end.
      356   function cur-time-datetime returns datetime
      357   :
      358     define variable v-char as character no-undo .
      359     define variable v-datetime as datetime no-undo .
      360     v-char = cur-time-string().
      361     v-datetime = datetime(v-char).
      362     return  v-datetime.
      363   end.
      364   function cur-time-string-msec returns character
      365   :
      366     define variable v-date as datetime  no-undo .
      367     v-date = now.
      368     return string(v-date) .
      369   end.
      370   define new global shared variable g#lib-trn  as handle no-undo .
