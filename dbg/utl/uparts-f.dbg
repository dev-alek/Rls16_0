      374   define variable vss-include-info4 as character format "x(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      375   procedure partscr :
      376     define input  parameter parparentproc      as widget-handle no-undo.
      377     define input  parameter p-db-num           as integer   no-undo .
      378     define input  parameter p-user-id          as character no-undo .
      379     define input  parameter p-supp-type        as character no-undo .
      380     define input  parameter p-supp-code        as integer   no-undo .
      381     define input  parameter p-part-code        as character no-undo .
      382     define input  parameter p-cst-code         as character no-undo .
      383     define input  parameter p-ps               as character no-undo .
      384     define input  parameter p-dop              as character no-undo .
      385     define input  parameter p-part-reserv-base as decimal   no-undo .
      386     define input  parameter p-part-reserv-rubl as decimal   no-undo .
      387     define input  parameter p-vat-type         as character no-undo .
      388     define input  parameter p-vat-pc           as decimal   no-undo .
      389     define input  parameter p-slt-type         as character no-undo .
