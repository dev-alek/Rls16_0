    10508                                               ,fi-slt-type :format)
    10509             fi-slt-pc   :screen-value = string(v-slt-pc
    10510                                               ,fi-slt-pc :format)
    10511           .
    10512           run update-last-date-offset in this-procedure .
    10513           find first buf_supp-clients no-lock
    10514             where buf_supp-clients.obj-type = string (x_parts.supp-type :screen-value)
    10515               and buf_supp-clients.obj-code = integer(x_parts.supp-code :screen-value)
    10516             no-error .
    10517           if available buf_supp-clients
    10518           then do:
    10519             assign
    10520               fi-supp :screen-value = buf_supp-clients.obj-name
    10521             .
    10522           end.
    10523           if v-goods-serial = true
    10524           then do:
    10525             if buf_trn-doc.flag_ = no
    10526             then do:
    10527               if buf_doc-line.cli-base-rate <> 1
    10528               then do:
    10529                 message
    10530                   "Коэффициент пересчета для серийных товаров должен быть 1"
    10531                   view-as alert-box error .
    10532                 undo, return error .
    10533               end.
    10534               assign
    10535                 x_parts.cli-qnty  :screen-value = '1'
    10536                 x_parts.qnty      :screen-value = '1'
    10537                 x_parts.fact-qnty :screen-value = '1'
    10538               .
    10539             end.
    10540           end.
    10541   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10543     (input  buf_trn-doc.obj-type
    10544     ,input  buf_trn-doc.obj-code
    10545     ,output v-host-code
    10546     )  .
    10547   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    10549     (input  v-host-code
    10550     ,output v-base-code
    10551     ) no-error .
    10552           if error-status :error
    10553           then do:
    10554             message
    10555               vss-workfile vss-revision vss-description skip
    10556               "Ошибка при определении кода базовой валюты для фирмы" v-host-code skip
    10557               view-as alert-box error .
    10558           end.
    10559           find first buf_currency no-lock
    10560             where buf_currency.curr-code = v-base-code
    10561             no-error .
    10562           if available buf_currency
    10563           then do:
    10564             assign
    10565               val-price-base :screen-value = buf_currency.curr-abbr
    10566               val-base-code  :screen-value = string(buf_currency.curr-code
    10567                                                   ,val-base-code :format
    10568                                                   )
    10569             .
    10570           end.
    10571           find first buf_currency no-lock
    10572             where buf_currency.curr-code = 0
    10573             .
    10574           assign
    10575             val-price-rubl :screen-value = buf_currency.curr-abbr
    10576             val-rubl-code  :screen-value = string(buf_currency.curr-code
    10577                                                 ,val-rubl-code :format
    10578                                                 )
    10579           .
    10580           assign
    10581             v-same-currency = (v-base-code = 0)
    10582           .
    10583           assign
    10584             FI-goods-artic          :screen-value  = string(buf_doc-line.artic)
    10585             FI-goods-prod-type-code :screen-value  = string(buf_doc-line.prod-type)
    10586                                                    + " "
    10587                                                    + string(buf_doc-line.prod-code)
    10588           .
    10589           if available buf_goods
    10590           then do:
    10591             assign
    10592               fi-gds-name         :screen-value = buf_goods.gds-name
    10593               fi-unit             :screen-value = string(buf_goods.unit-base
    10594                                                             ,fi-unit:format)
    10595               fi-unit-2           :screen-value = string(buf_goods.unit-base
    10596                                                             ,fi-unit-2:format)
    10597             .
    10598           end.
    10599           if available buf_clients
    10600           then do:
    10601             assign
    10602               fi-clients-name :screen-value = buf_clients.obj-name
    10603             .
    10604           end.
    10605         end.
    10606       end.
    10607       run display-dependent-info in this-procedure .
    10608       assign
    10609         session:immediate-display = v-old-immediate-display
    10610       .
    10611     end.
    10612   END PROCEDURE.
    10613   PROCEDURE display-price :
    10614     define input parameter v-new-price-cli  like x_parts.price-cli  no-undo .
    10615     define input parameter v-new-price-base like x_parts.price-rubl no-undo .
    10616     define input parameter v-new-price-rubl like x_parts.price-rubl no-undo .
    10617     do with frame Dialog-Frame:
    10618       if x_parts.price-cli :visible
    10619       then do:
    10620         if string(decimal(x_parts.price-cli :screen-value)
    10621                  ,x_parts.price-cli :format )
    10622         <> string(v-new-price-cli
    10623                  ,x_parts.price-cli :format )
    10624         then do:
    10625           assign
    10626             x_parts.price-cli :screen-value = string(v-new-price-cli
    10627                                                   ,x_parts.price-cli :format )
    10628           .
    10629         end.
    10630       end.
    10631       if x_parts.price-base :visible
    10632       then do:
    10633         if string(decimal(x_parts.price-base :screen-value)
    10634                  ,x_parts.price-base :format )
    10635         <> string(v-new-price-base
    10636                  ,x_parts.price-base :format )
    10637         then do:
    10638           assign
    10639             x_parts.price-base :screen-value = string(v-new-price-base
    10640                                                   ,x_parts.price-base :format )
    10641           .
    10642         end.
    10643       end.
    10644       if x_parts.price-rubl :visible
    10645       then do:
    10646         if string(decimal(x_parts.price-rubl :screen-value)
    10647                  ,x_parts.price-rubl :format )
    10648         <> string(v-new-price-rubl
    10649                  ,x_parts.price-rubl :format )
    10650         then do:
    10651           assign
    10652             x_parts.price-rubl :screen-value = string(v-new-price-rubl
    10653                                                   ,x_parts.price-rubl :format )
    10654           .
    10655         end.
    10656       end.
    10657     end.
    10658   END PROCEDURE.
    10659   PROCEDURE enable-fields :
    10660     define buffer buf_parts    for x_parts .
    10661     define buffer buf_doc-line for ub.doc-line .
    10662     define buffer buf_trn-doc  for ub.trn-doc .
    10663     define buffer buf_goods    for ub.goods .
    10664     do with frame Dialog-Frame:
    10665         assign
    10666           v-fields-enabled = true
    10667         .
    10668         find first buf_trn-doc no-lock
    10669           where buf_trn-doc.doc-code = p-doc-code
    10670           .
    10671         find first buf_goods no-lock
    10672           where buf_goods.gds-code = p-gds-code
    10673           .
    10674         find first buf_doc-line no-lock
    10675           where buf_doc-line.doc-code  = p-doc-code
    10676             and buf_doc-line.artic     = buf_goods.artic
    10677             and buf_doc-line.prod-type = buf_goods.prod-type
    10678             and buf_doc-line.prod-code = buf_goods.prod-code
    10679           .
    10680         find first buf_parts no-lock
    10681           where recid(buf_parts) = v-parts-recid
    10682           no-error .
    10683         assign
    10684           x_parts.PS :read-only = false
    10685         .
    10686         define variable l-external-income as logical no-undo .
    10687         assign
    10688           l-external-income = true
    10689         .
    10690         if  l-external-income = true
    10691         and v-goods-petroleum = true
    10692         then do:
    10693           message
    10694             "Во внешнем приходе топливо нельзя редактировать через партии" skip
    10695             view-as alert-box information .
    10696           undo, return error .
    10697         end.
    10698         assign
    10699           v-can-change-part-code = false
    10700         .
    10701         run determine-enable-qnty in this-procedure
    10702           (output v-enable-qnty
    10703           ).
    10704         assign
    10705           v-can-change-supp = false
    10706         .
    10707         define variable v-can-change-price as logical no-undo .
    10708         assign
    10709           v-can-change-price = true
    10710         .
    10711           define variable confvalue     as character initial ? no-undo.
    10712           define variable conftype      as character initial ? no-undo.
    10713   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10714   empty temp-table thbjattr_thbj-attr.
    10715   run adm/shattri.p (
    10716      input "get":U
    10717     ,input ''
    10718     ,input 0
    10719     ,input 'nakl-glob':U
    10720     ,input  ""
    10721     ,output v-value-character
    10722     ,output v-value-date
    10723     ,output v-value-decimal
    10724     ,output v-value-integer
    10725     ,output v-value-logical
    10726     ,output par-type
    10727     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10728     ) no-error .
    10729           for each thbjattr_thbj-attr :
    10730               if thbjattr_thbj-attr.prop-code = 'part-prc' then v-can-change-price = thbjattr_thbj-attr.property-value-logical  .
    10731           end.
    10732         v-can-change-part-code = true .
    10733         assign
    10734           x_parts.part-code     :sensitive =  false
    10735         .
    10736         if v-alcohol-prod = true
    10737         then do:
    10738           assign
    10739             b-alc-attr :visible   = true
    10740             b-alc-attr :sensitive = true
    10741           .
    10742         end.
    10743         assign
    10744           x_parts.cst-code    :sensitive = v-can-change-part-code
    10745           x_parts.last-date   :sensitive = v-can-change-part-code
    10746           b-choose-last-date  :sensitive = v-can-change-part-code
    10747           fi-last-date-offset :sensitive = v-can-change-part-code
    10748           x_parts.price-cli  :sensitive = (v-can-change-part-code
    10749                                         and x_parts.price-cli :visible
    10750                                         and v-can-change-price
    10751                                         and l-external-income )
    10752           x_parts.price-base :sensitive = (v-can-change-part-code
    10753                                         and v-can-change-price )
    10754           x_parts.price-rubl :sensitive = (v-can-change-part-code
    10755                                         and v-can-change-price
    10756                                          )
    10757           b-edit-price     :sensitive =
    10758                                         false
    10759           x_parts.qnty       :sensitive = ( (v-enable-qnty = "qnty":u)     and not (v-goods-serial and v-create-part)
    10760                                         )
    10761                                         or ( (v-goods-twounit = true)
    10762                                             and (v-enable-qnty = "cli-qnty":u )
    10763                                           )
    10764           x_parts.fact-qnty  :sensitive = (v-enable-qnty = "fact-qnty":u)
    10765           x_parts.cli-qnty   :sensitive = (v-enable-qnty = "cli-qnty":u) and not (v-goods-serial and v-create-part)
    10766           fi-slt-pc        :sensitive = (v-can-change-part-code
    10767                                         and v-can-change-price
    10768                                         )
    10769           fi-vat-pc        :sensitive = (v-can-change-part-code
    10770                                         and v-can-change-price
    10771                                         )
    10772         .
    10773         if fi-slt-pc :sensitive = true
    10774         then do:
    10775           assign
    10776             fi-slt-pc :fgcolor = ?
    10777           .
    10778         end.
    10779         else do:
    10780           assign
    10781             fi-slt-pc :fgcolor = 4
    10782           .
    10783         end.
    10784         if fi-vat-pc :sensitive = true
    10785         then do:
    10786           assign
    10787             fi-vat-pc :fgcolor = ?
    10788           .
    10789         end.
    10790         else do:
    10791           assign
    10792             fi-vat-pc :fgcolor = 4
    10793           .
    10794         end.
    10795         if v-create-part
    10796         then do:
    10797           define variable v-new-qnty as decimal no-undo .
    10798           run guess-parts-qnty in this-procedure
    10799             (buffer buf_doc-line
    10800             ,output v-new-qnty
    10801             ).
    10802           if x_parts.qnty :sensitive
    10803           then do:
    10804             assign
    10805               x_parts.qnty  :screen-value = string(v-new-qnty
    10806                                                 ,x_parts.qnty :format )
    10807             .
    10808           end.
    10809           if x_parts.fact-qnty :sensitive
    10810           then do:
    10811             assign
    10812               x_parts.fact-qnty :screen-value = string(v-new-qnty
    10813                                                     ,x_parts.fact-qnty :format )
    10814             .
    10815           end.
    10816           if x_parts.cli-qnty :sensitive
    10817           then do:
    10818             assign
    10819               x_parts.cli-qnty  :screen-value = string(v-new-qnty
    10820                                                     ,x_parts.cli-qnty :format )
    10821             .
    10822           end.
    10823           run display-dependent-info in this-procedure .
    10824         end.
    10825         if v-can-change-supp
    10826         then do:
    10827           assign
    10828             x_parts.supp-type :sensitive = true
    10829             x_parts.supp-code :sensitive = true
    10830             r-supp :sensitive          = true
    10831           .
    10832           if v-create-part
    10833           then do:
    10834             if x_parts.supp-type :sensitive
    10835             then do:
    10836               assign
    10837                 x_parts.supp-type :screen-value = 'орг':U
    10838               .
    10839             end.
    10840             if x_parts.supp-code :sensitive
    10841             then do:
    10842               assign
    10843                 x_parts.supp-code :screen-value = ?
    10844               .
    10845             end.
    10846           end.
    10847         end.
    10848         define variable v-is-hold as logical   no-undo .
    10849   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    10851     (input  buf_trn-doc.doc-code
    10852     ,output v-is-hold
    10853     )  .
    10854         if v-can-change-supp = true
    10855         then do:
    10856           if available buf_parts
    10857           then do:
    10858             define variable v-create-old-return as logical no-undo .
    10859             define variable v-reason as character no-undo .
    10860             run partscr_check-valid-supp in this-procedure
    10861               (input  buf_parts.supp-type
    10862               ,input  buf_parts.supp-code
    10863               ,input
    10864           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
    10865               ,input
    10866           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
    10867               ,input  buf_trn-doc.ext-doc-type
    10868               ,output v-create-old-return
    10869               ,output v-reason
    10870               ).
    10871             if v-create-old-return = true
    10872             then do:
    10873               assign
    10874                 v-display-price-cli    = true
    10875                 v-enable-price-cli     = true
    10876               .
    10877               if  v-is-fin = true
    10878               then do:
    10879                 assign
    10880                   v-enable-contract      = true
    10881                 .
    10882                 if buf_parts.contract-code <> 0
    10883                 then do:
    10884                   assign
    10885                     v-enable-cli-exch-code = false
    10886                   .
    10887                 end.
    10888                 else do:
    10889                   assign
    10890                     v-enable-cli-exch-code = true
    10891                   .
    10892                 end.
    10893               end.
    10894               else do:
    10895                 assign
    10896                   v-enable-cli-exch-code = true
    10897                   v-enable-contract      = false
    10898                 .
    10899               end.
    10900             end.
    10901             else do:
    10902               assign
    10903                 v-display-price-cli    = false
    10904                 v-enable-price-cli     = false
    10905                 v-enable-cli-exch-code = false
    10906                 v-enable-contract      = false
    10907               .
    10908             end.
    10909           end.
    10910           else do:
    10911             assign
    10912               v-display-price-cli    = true
    10913               v-enable-price-cli     = true
    10914               v-enable-cli-exch-code = true
    10915               v-enable-contract      = false
    10916             .
    10917           end.
    10918           run update-enable-price-cli in this-procedure .
    10919           run update-exch-code-enable in this-procedure .
    10920           run display-dependent-info in this-procedure .
    10921         end.
    10922         assign
    10923           x_parts.part-code      :modified = false
    10924           x_parts.cst-code       :modified = false
    10925           x_parts.last-date      :modified = false
    10926           fi-last-date-offset  :modified = false
    10927           x_parts.price-base     :modified = false
    10928           x_parts.price-rubl     :modified = false
    10929           fi-vat-pc            :modified = false
    10930           fi-slt-pc            :modified = false
    10931           x_parts.qnty           :modified = false
    10932           x_parts.fact-qnty      :modified = false
    10933           x_parts.cli-qnty       :modified = false
    10934           x_parts.PS             :modified = false
    10935           x_parts.supp-type      :modified = false
    10936           x_parts.supp-code      :modified = false
    10937           fi-contract-prn-code :modified = false
    10938           v-modified-contract-code       = false
    10939           v-modified-exch-code           = false
    10940         .
    10941         if available buf_parts
    10942         and buf_parts.out-code <> buf_trn-doc.doc-code
    10943         then do:
    10944           if x_parts.qnty :sensitive
    10945           then do:
    10946             assign
    10947               x_parts.qnty      :modified = true
    10948             .
    10949           end.
    10950           if x_parts.fact-qnty :sensitive
    10951           then do:
    10952             assign
    10953               x_parts.fact-qnty :modified = true
    10954             .
    10955           end.
    10956         end.
    10957         define variable l-enable-button as logical no-undo .
    10958         assign
    10959           b-exit :label in frame Dialog-Frame = "&Ввод"
    10960         .
    10961         assign
    10962           b-save :sensitive = true
    10963           b-quit :sensitive = true
    10964           b-rest :sensitive = true
    10965         .
    10966         if x_parts.cli-qnty :sensitive
    10967         then do:
    10968           apply 'entry':u to x_parts.cli-qnty.
    10969         end.
    10970         else do:
    10971           if x_parts.fact-qnty:sensitive
    10972           then do:
    10973             apply 'entry':u to x_parts.fact-qnty.
    10974           end.
    10975           else do:
    10976             if x_parts.qnty:sensitive
    10977             then do:
    10978               apply 'entry':u to x_parts.qnty.
    10979             end.
    10980           end.
    10981         end.
    10982         if v-alcohol-prod = true
    10983         then do:
    10984           assign
    10985             b-alc-attr :visible   = true
    10986             b-alc-attr :sensitive = true
    10987           .
    10988         end.
    10989     end.
    10990   END PROCEDURE.
    10991   PROCEDURE enable_UI :
    10992     OPEN QUERY Dialog-Frame FOR EACH x_parts SHARE-LOCK.
    10993     GET FIRST Dialog-Frame.
    10994     DISPLAY fi-vat-pc fi-slt-pc fi-last-date-offset fi-contract-prn-code
    10995             tot-price-cli tot-price-rubl tot-price-base FI-goods-artic fi-gds-name
    10996             FI-goods-prod-type-code FI-clients-name FI-b-code fi-out-code
    10997             FI-label-kolichestvo FI-label-ed-izm FI-label-koefficient fi-unit-cli
    10998             fi-unit fi-unit-2 fi-vat-type fi-slt-type fi-supp fi-contract-name
    10999             FI-label-cena FI-label-summa FI-label-val val-price-cli val-rubl-code
    11000             val-price-rubl val-base-code val-price-base
    11001         WITH FRAME Dialog-Frame.
    11002     IF AVAILABLE x_parts THEN
    11003       DISPLAY x_parts.PS x_parts.cli-qnty x_parts.cli-base-rate x_parts.qnty
    11004             x_parts.fact-qnty x_parts.part-code x_parts.cst-code x_parts.supp-type
    11005             x_parts.supp-code x_parts.last-date x_parts.price-cli
    11006             x_parts.exch-code x_parts.price-rubl x_parts.price-base
    11007         WITH FRAME Dialog-Frame.
    11008     ENABLE b-exit b-quit b-prev b-next b-alc-attr b-help RECT-2 RECT-3 RECT-4
    11009            RECT-1 x_parts.PS fi-vat-pc fi-slt-pc x_parts.supp-type
    11010            x_parts.supp-code r-supp x_parts.last-date b-choose-last-date
    11011            fi-last-date-offset fi-contract-prn-code r-contract b-edit-price
    11012            FI-goods-artic fi-gds-name FI-goods-prod-type-code FI-clients-name
    11013            FI-b-code fi-out-code FI-label-kolichestvo FI-label-ed-izm
    11014            FI-label-koefficient fi-unit-cli fi-unit fi-unit-2 fi-vat-type
    11015            fi-slt-type fi-supp fi-contract-name FI-label-cena FI-label-summa
    11016            FI-label-val val-price-cli val-rubl-code val-price-rubl val-base-code
    11017            val-price-base
    11018         WITH FRAME Dialog-Frame.
    11019     VIEW FRAME Dialog-Frame.
    11020   END PROCEDURE.
    11021   PROCEDURE guess-parts-qnty :
    11022     define parameter buffer buf_doc-line for ub.doc-line .
    11023     define buffer buf_trn-doc for ub.trn-doc .
    11024     define output parameter p-guess-qnty as decimal no-undo .
    11025       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
    11026     run partrqst in this-procedure
    11027       (input  buf_doc-line.doc-code
    11028       ,input  buf_doc-line.obj-type
    11029       ,input  buf_doc-line.obj-code
    11030       ,input  buf_doc-line.artic
    11031       ,input  buf_doc-line.prod-type
    11032       ,input  buf_doc-line.prod-code
    11033           ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
    11034       ).
    11035     case v-enable-qnty :
    11036       when "qnty":u
    11037       then do:
    11038         define variable v-chg-qnty as decimal   no-undo .
    11039         if valid-handle(h-call-prog)
    11040         then do:
    11041           run get-attr-chg-qnty in h-call-prog
    11042             (output v-chg-qnty).
    11043         end.
    11044         define variable v-doc-line-qnty as decimal   no-undo .
    11045         find first buf_trn-doc no-lock
    11046           where buf_trn-doc.doc-code = buf_doc-line.doc-code
    11047           .
    11048         if buf_trn-doc.doc-type = 'инв':U
    11049         then do:
    11050           assign
    11051             v-doc-line-qnty = buf_doc-line.fact-qnty
    11052           .
    11053         end.
    11054         else do:
    11055           assign
    11056             v-doc-line-qnty = buf_doc-line.doc-qnty
    11057           .
    11058         end.
    11059         assign
    11060           p-guess-qnty = max(0, v-doc-line-qnty + v-chg-qnty  - v-total-parts-qnty)
    11061         .
    11062       end.
    11063       when "fact-qnty":u
    11064       then do:
    11065         assign
    11066           p-guess-qnty = max(0, buf_doc-line.fact-qnty - v-total-parts-fact-qnty)
    11067         .
    11068       end.
    11069       when "cli-qnty":u
    11070       then do:
    11071         assign
    11072           p-guess-qnty = max(0, buf_doc-line.cli-qnty  - v-total-parts-cli-qnty)
    11073         .
    11074       end.
    11075     end.
    11076   END PROCEDURE.
    11077   PROCEDURE init-proc :
