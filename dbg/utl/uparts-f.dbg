    11345         then do:
    11346           assign
    11347             p-record-modified = true
    11348           .
    11349           return .
    11350         end.
    11351       end.
    11352       if fi-last-date-offset :sensitive
    11353       then do:
    11354         if fi-last-date-offset :modified = true
    11355         then do:
    11356           assign
    11357             p-record-modified = true
    11358           .
    11359           return .
    11360         end.
    11361       end.
    11362       if x_parts.price-cli :sensitive
    11363       then do:
