     6898   procedure partrsrv-need-rsrv :
     6899     define input  parameter p-parts-in-code   as character no-undo .
     6900     define input  parameter p-parts-out-code  as character no-undo .
     6901     define output parameter p-need-rsrv-parts as logical   no-undo .
     6902     do
     6903     on error undo, return error return-value
     6904     :
     6905       if p-parts-out-code <> p-parts-in-code
     6906       then do:
     6907         assign
     6908           p-need-rsrv-parts = true
     6909         .
     6910       end.
     6911       else do:
     6912         assign
     6913           p-need-rsrv-parts = false
     6914         .
     6915       end.
     6916     end.
     6917   end procedure.
     6918   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6919   FUNCTION get-parts-part-code RETURNS CHARACTER
     6920     ( BUFFER buf_parts FOR ub.parts
     6921     , INPUT p-goods-alcohol-prod AS LOGICAL
     6922     ) :
     6923     define variable v-show-part-code as character no-undo .
     6924     if (p-goods-alcohol-prod = false) and (buf_parts.part-code = '':u)
     6925     then do:
     6926       return '------':u .
     6927     end.
     6928     run partsfnc_get-parts-show-code in this-procedure
     6929       (input  buf_parts.part-code
     6930       ,input  buf_parts.mark-db-num
     6931       ,input  buf_parts.mark-code
     6932       ,input  buf_parts.alc-bottling-date
     6933       ,input  p-goods-alcohol-prod
     6934       ,output v-show-part-code
     6935       ) .
     6936     return v-show-part-code .
     6937   END FUNCTION.
     6938   procedure partsfnc_get-parts-show-code :
     6939     define input  parameter p-part-code          as character no-undo .
     6940     define input  parameter p-mark-db-num        as integer   no-undo .
     6941     define input  parameter p-mark-code          as integer   no-undo .
     6942     define input  parameter p-alc-bottling-date  as date      no-undo .
     6943     define input  parameter p-goods-alcohol-prod as logical   no-undo .
     6944     define output parameter p-show-code          as character no-undo .
     6945     define variable v-alc-mark-name as character no-undo .
     6946     do
     6947     on error undo, return error return-value
     6948     :
     6949       assign
     6950         p-show-code = '':u
     6951       .
     6952       if p-goods-alcohol-prod = true
     6953       then do:
     6954         run alc-lib_mark-name in this-procedure
     6955           (input  p-mark-db-num
     6956           ,input  p-mark-code
     6957           ,output v-alc-mark-name
     6958           ) .
     6959         assign
     6960           p-show-code = substitute('&1,&2':u
     6961                                   ,v-alc-mark-name
     6962                                   ,string(p-alc-bottling-date,'99/99/9999':u)
     6963                                   )
     6964         .
     6965       end.
     6966       else do:
     6967         assign
     6968           p-show-code = p-part-code
     6969         .
     6970       end.
     6971       return '':u .
     6972     end.
     6973   end procedure.
     6974   FUNCTION get-parts-out-code RETURNS CHARACTER
     6975     ( BUFFER buf_parts FOR ub.parts ) :
     6976     case buf_parts.out-code :
     6977       when 'free-zone':U then do:
     6978         return "свободно" .
     6979       end.
     6980       when 'out-zone':U then do:
     6981         return "расход" .
     6982       end.
     6983       otherwise do:
     6984         if buf_parts.doc-type = 'акт':U then do:
     6985           return caps("ЦН") + " № " + buf_parts.out-code .
     6986         end.
     6987         else do:
     6988           define variable v-ext-name       as character no-undo .
     6989           define variable v-trn-doc-status as character no-undo .
     6990           define buffer buf_trn-doc for ub.trn-doc .
     6991           find first buf_trn-doc no-lock
     6992             where buf_trn-doc.doc-code = buf_parts.out-code
     6993             no-error .
     6994           if available buf_trn-doc then do:
     6995   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run docextnm in g#library
     6997     (input  buf_parts.out-code
     6998     ,output v-ext-name
     6999     )  .
     7000             assign
     7001               v-trn-doc-status = (if buf_trn-doc.status_ = 'факт':U then 'факт':U else "")
     7002             .
     7003           end.
     7004           else do:
     7005             assign
     7006               v-ext-name       = caps(substring(buf_parts.doc-type, 1, 1))
     7007               v-trn-doc-status = (if buf_parts.status_ = ? then 'факт':U else "")
     7008             .
     7009           end.
     7010           return substitute("&1 № &2 &3"
     7011              ,v-ext-name
     7012              ,buf_parts.out-code
     7013              ,v-trn-doc-status
     7014              ) .
     7015         end.
     7016       end.
     7017     end case .
     7018     return "".
     7019   END FUNCTION.
     7020   FUNCTION get-parts-cli-qnty RETURNS DECIMAL
     7021     ( BUFFER buf_parts FOR ub.parts
     7022     , INPUT p-goods-twounit AS LOGICAL
     7023     ) :
     7024     if p-goods-twounit then do:
     7025       RETURN buf_parts.cli-qnty .
     7026     end.
     7027     else do:
     7028       RETURN buf_parts.fact-qnty / buf_parts.cli-base-rate .
     7029     end.
     7030     RETURN ? .
     7031   END FUNCTION.
     7032   FUNCTION get-parts-cli-base-rate RETURNS DECIMAL
     7033     ( BUFFER buf_parts FOR ub.parts
     7034     , INPUT p-goods-twounit AS LOGICAL
     7035     ) :
     7036     if p-goods-twounit then do:
     7037       RETURN buf_parts.fact-qnty / buf_parts.cli-qnty .
     7038     end.
     7039     else do:
     7040       RETURN buf_parts.cli-base-rate .
     7041     end.
     7042     RETURN ? .
     7043   END FUNCTION.
     7044   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7045   function chkleave returns logical
     7046   (input p-widget-enter as handle
     7047   ,input p-button-list  as character
     7048   ).
     7049     if  valid-handle(p-widget-enter)
     7050     and can-query(p-widget-enter, "name":u)
     7051     and lookup(p-widget-enter :name, p-button-list) > 0
     7052     then do:
     7053       return false .
     7054     end.
     7055     return true .
     7056   end function.
     7057   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7058   function octal-to-char return character
     7059   ( p-string as character ) :
     7060     def var v-asc     as integer no-undo .
     7061     def var v-new-asc as integer no-undo .
     7062     def var ind       as integer no-undo .
     7063     if length(p-string) <> 3 then do:
     7064       return ? .
     7065     end.
     7066     assign
     7067       v-asc = 0
     7068     .
     7069     do ind = 1 to length(p-string)
     7070     :
     7071       assign
     7072         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     7073       .
     7074       if v-new-asc < 0 or v-new-asc >= 8 then do:
     7075         return ? .
     7076       end.
     7077       assign
     7078         v-asc = v-asc * 8 + v-new-asc
     7079       .
     7080     end.
     7081     return chr(v-asc) .
     7082   end function .
     7083   function char-to-octal return character
     7084   ( p-chr as character ) :
     7085     def var v-asc    as integer   no-undo .
     7086     def var ind      as integer   no-undo .
     7087     def var v-string as character no-undo .
     7088     if length(p-chr) <> 1 then do:
     7089       return ? .
     7090     end.
     7091     assign
     7092       v-asc    = asc(p-chr)
     7093       v-string = ""
     7094     .
     7095     do ind = 1 to 3
     7096     :
     7097       assign
     7098         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     7099       .
     7100       assign
     7101         v-asc = truncate(v-asc / 8, 0)
     7102       .
     7103     end.
     7104     return v-string .
     7105   end.
     7106   function str-encode return character
     7107   (   p-init-string       as character
     7108     , p-encode-char       as character
     7109     , p-special-char-list as character
     7110   ) :
     7111     def var p-encode-string as character no-undo .
     7112     def var ind                as integer no-undo .
     7113     def var v-num-special-char as integer no-undo .
     7114     def var v-special-char     as character no-undo .
     7115     if p-encode-char = ?
     7116     or p-encode-char = "" then do:
     7117       assign
     7118         p-encode-char = "~~"
     7119       .
     7120     end.
     7121     if p-init-string = ? then do:
     7122       return "?" .
     7123     end.
     7124     if p-init-string = "?" then do:
     7125       return p-encode-char + char-to-octal("?") .
     7126     end.
     7127     assign
     7128       v-num-special-char = length(p-special-char-list)
     7129       p-encode-string    = replace(p-init-string
     7130                                   ,p-encode-char
     7131                                   ,p-encode-char + char-to-octal(p-encode-char)
     7132                                   )
     7133     .
     7134     do ind = 1 to v-num-special-char
     7135     :
     7136       assign
     7137         v-special-char = substring(p-special-char-list, ind, 1)
     7138       .
     7139       if v-special-char <> p-encode-char then do:
     7140         assign
     7141           p-encode-string = replace (p-encode-string
     7142                                     ,v-special-char
     7143                                     ,p-encode-char + char-to-octal(v-special-char)
     7144                                     )
     7145         .
     7146       end.
     7147     end.
     7148     return p-encode-string .
     7149   end.
     7150   function str-decode returns character
     7151     (p-init-string   as character
     7152     ,p-encode-char   as character
     7153     ) :
     7154     def var p-decode-string as character no-undo .
     7155     def var ind                       as integer no-undo .
     7156     def var v-num-entries-init-string as integer no-undo .
     7157     def var v-sub-phrase              as character no-undo .
     7158     def var v-special-char            as character no-undo .
     7159     if p-encode-char = ?
     7160     or p-encode-char = "" then do:
     7161       assign
     7162         p-encode-char = "~~"
     7163       .
     7164     end.
     7165     if p-init-string = "?" then do:
     7166       return ? .
     7167     end.
     7168     assign
     7169       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     7170     .
     7171     if v-num-entries-init-string > 1 then do:
     7172       assign
     7173         p-decode-string = entry(1, p-init-string, p-encode-char)
     7174       .
     7175       do ind = 2 to v-num-entries-init-string
     7176       :
     7177         assign
     7178           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     7179         .
     7180         assign
     7181           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     7182         .
     7183         if v-special-char <> ? then do:
     7184           assign
     7185             p-decode-string = p-decode-string
     7186                             + v-special-char
     7187                             + substring(v-sub-phrase, 4)
     7188           .
     7189         end.
     7190         else do:
     7191           assign
     7192             p-decode-string = p-decode-string
     7193                             + p-encode-char
     7194                             + v-sub-phrase
     7195           .
     7196         end.
     7197       end.
     7198     end.
     7199     else do:
     7200       assign
     7201         p-decode-string = p-init-string
     7202       .
     7203     end.
     7204     return p-decode-string .
     7205   end.
     7206   procedure check-contract-code :
     7207   define input  parameter parmode           as   character                     no-undo.
     7208   define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
     7209   define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
     7210   define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
     7211   define input  parameter parframe-value    as   character                     no-undo.
     7212   define input  parameter parmenu-handle    as   handle                        no-undo.
     7213   define input  parameter parobj-date       as   date                          no-undo.
     7214   define input  parameter partype-contract  as   character                     no-undo .
     7215   define output parameter parcontract-code  like ub.contract.contract-code     no-undo.
     7216   define buffer bf_contract     for ub.contract.
     7217   define buffer bf-oth_contract for ub.contract.
     7218   define variable varrid-list as character no-undo.
     7219   define variable varrecid    as recid     no-undo.
     7220   define variable varlog      as logical   no-undo.
     7221   define variable var-args    as char      no-undo.
     7222   define variable var-ext-doc-type as char     no-undo.
     7223   do on error undo, return error return-value :
     7224   var-args = parmode.
     7225   parmode = entry(1, parmode).
     7226   run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
     7227   if partype-contract = "" or partype-contract = ? then
     7228      partype-contract = 'при':U .
     7229   assign
     7230     parcontract-code = 0
     7231   .
     7232   if parmode = "input":u
     7233   then do:
     7234     if parframe-value = ""
     7235     then do:
     7236       assign
     7237         parcontract-code = 0
     7238       .
     7239     end.
     7240     else do:
     7241       find first bf_contract no-lock
     7242         where bf_contract.host-code         = parhost-code
     7243           and bf_contract.cli-type          = parcli-type
     7244           and bf_contract.cli-code          = parcli-code
     7245           and bf_contract.contract-prn-code = parframe-value
     7246         no-error.
     7247       if available bf_contract
     7248       then do:
     7249         find first bf-oth_contract no-lock
     7250           where bf-oth_contract.host-code          = parhost-code
     7251             and bf-oth_contract.contract-prn-code  = parframe-value
     7252             and bf-oth_contract.cli-type           = parcli-type
     7253             and bf-oth_contract.cli-code           = parcli-code
     7254             and rowid(bf_contract)                 <> rowid(bf-oth_contract)
     7255           no-error .
     7256         if available bf-oth_contract
     7257         then do:
     7258           message
     7259             "На фирме " parhost-code skip
     7260             "у контрагента" parcli-type parcli-code skip
     7261             "имеются два контракта с номером" parframe-value skip
     7262           view-as alert-box .
     7263         end.
     7264         else do:
     7265           assign
     7266             parcontract-code = bf_contract.contract-code
     7267           .
     7268         end.
     7269       end.
     7270     end.
     7271   end.
     7272   if parmode <> "input":u
     7273   or parcontract-code = 0
     7274   then do:
     7275     run str/cont-all.w (input parmenu-handle,
     7276                     input parhost-code,
     7277                     input "b-sel",
     7278                     input if var-ext-doc-type = 'ee':U then 'фирма':U else "firm-curr" ,
     7279                     input parcli-type,
     7280                     input parcli-code,
     7281                     input ?,
     7282                     input ?,
     7283                     input "current":u,
     7284                     input partype-contract,
     7285                     input-output varrid-list ) no-error.
     7286     if error-status:error then do:
     7287       message "Ошибка при вызове справочника договоров." skip
     7288               return-value                skip
     7289               error-status:get-message(1) skip
     7290               error-status:get-message(2)
     7291       view-as alert-box error.
     7292       return error.
     7293     end.
     7294     assign
     7295       varrecid = integer(entry(1, varrid-list)).
     7296     find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
     7297     if available bf_contract then do:
     7298       assign
     7299         parcontract-code = bf_contract.contract-code.
     7300     end.
     7301   end.
     7302   if parcontract-code <> 0
     7303   then do:
     7304     if (bf_contract.status_ = 'зкр':U or
     7305         (bf_contract.contract-date-end <> ? and bf_contract.contract-date-end < parobj-date)) then do:
     7306       if lookup(var-ext-doc-type, 'ep,re,rs,ee') = 0
     7307       then do:
     7308           assign
     7309             varlog = no.
     7310           message "Договор с номером " bf_contract.contract-prn-code " закрыт." skip
     7311           view-as alert-box.
     7312           assign
     7313             parcontract-code = 0
     7314           .
     7315       end.
     7316     end.
     7317     if bf_contract.contract-date-beg > parobj-date then do:
     7318       assign
     7319         varlog = no.
     7320       message "Дата открытия договора " bf_contract.contract-date-beg " . Договор с номером " bf_contract.contract-prn-code " еще не открыт." skip
     7321       view-as alert-box.
     7322       assign
     7323         parcontract-code = 0
     7324       .
     7325     end.
     7326     if parcontract-code <> 0
     7327     then do:
     7328       if bf_contract.cli-type <> parcli-type
     7329       or bf_contract.cli-code <> parcli-code
     7330       then do:
     7331          message "По договору " bf_contract.contract-code
     7332                  ( if bf_contract.doc-type =  'при':U
     7333                    then " поставщиком является "
     7334                    else " покупателем является " )
     7335                  bf_contract.cli-type " " bf_contract.cli-code " ." skip
     7336                  "По документу контрагент " parcli-type " " parcli-code " ." skip
     7337          view-as alert-box error.
     7338          assign
     7339            parcontract-code = 0.
     7340       end.
     7341       if parcontract-code <> ? then do:
     7342         if not ( bf_contract.doc-type =  'при':U or bf_contract.doc-type =  'рас':U ) then do:
     7343           message "Контракт имеет недопустимый тип." view-as alert-box.
     7344           assign
     7345             parcontract-code = 0.
     7346         end.
     7347       end.
     7348     end.
     7349   end.
     7350   end.
     7351   end procedure.
     7352   procedure cntrcode-get-arg-val:
     7353       def input param p-args as char no-undo.
     7354       def input param p-key as char no-undo.
     7355       def output param p-val as char no-undo.
     7356       def var i as int no-undo.
     7357       def var nums as int no-undo.
     7358       def var key-val as char no-undo.
     7359       nums = num-entries(p-args).
     7360       do i = 1 to nums:
     7361           key-val = entry(i, p-args).
     7362           if key-val begins (p-key + "=") then do:
     7363               p-val = entry(2, key-val, "=").
     7364               return.
     7365           end.
     7366       end.
     7367       p-val = "".
     7368   end.
     7369   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7370   procedure godendo-date-to-offset :
     7371     define input  parameter p-today  as date      no-undo .
     7372     define input  parameter p-date   as date      no-undo .
     7373     define output parameter p-offset as integer   no-undo .
     7374     do
     7375     on error undo, return error return-value
     7376     :
     7377       if p-date  = ?
     7378       or p-today = ?
     7379       then do:
     7380         assign
     7381           p-offset = ?
     7382         .
     7383       end.
     7384       else do:
     7385         assign
     7386           p-offset = p-date - p-today + 1
     7387         .
     7388       end.
     7389     end.
     7390   end procedure.
     7391   procedure godendo-offset-to-date :
     7392     define input  parameter p-today  as date      no-undo .
     7393     define input  parameter p-offset as integer   no-undo .
     7394     define output parameter p-date   as date      no-undo .
     7395     do
     7396     on error undo, return error return-value
     7397     :
     7398       if p-today  = ?
     7399       or p-offset = ?
     7400       then do:
     7401         assign
     7402           p-date = ?
     7403         .
     7404       end.
     7405       else do:
     7406         assign
     7407           p-date = p-offset + p-today - 1
     7408         .
     7409       end.
     7410     end.
     7411   end procedure.
     7412   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7413   procedure sel-date :
     7414     define input  parameter p-date-handle as handle    no-undo .
     7415     define input  parameter p-description as character no-undo .
     7416     do
     7417     on error undo, return error return-value
     7418     :
     7419       if (can-query (p-date-handle, "sensitive")
     7420         and
     7421         p-date-handle :sensitive = true
     7422         )
     7423       or (can-query (p-date-handle, "read-only")
     7424         and
     7425         p-date-handle :read-only = false
     7426         )
     7427       then do:
     7428         if p-date-handle :handle <> focus :handle
     7429         then do:
     7430           apply "entry":u to p-date-handle .
     7431         end.
     7432         define variable v-ok            as logical no-undo .
     7433         define variable v-curr-sv-date as date no-undo .
     7434         assign
     7435           v-curr-sv-date = date(p-date-handle :screen-value) no-error
     7436         .
     7437         if v-curr-sv-date = ?
     7438         then do:
     7439           run gbl/getcurdt.p
     7440             (output v-curr-sv-date
     7441             ) .
     7442         end.
     7443         if v-curr-sv-date <> ?
     7444         then do:
     7445           run gbl/d-inpday.w
     7446             (input ?
     7447             ,input "Выбор даты"
     7448             ,input p-description
     7449             ,input ""
     7450             ,input-output v-curr-sv-date
     7451             ,output v-ok
     7452             ).
     7453           if v-ok = true
     7454           then do:
     7455             assign
     7456               p-date-handle :screen-value = string(v-curr-sv-date) .
     7457             .
     7458           end.
     7459         end.
     7460       end.
     7461     end.
     7462   end procedure.
     7463   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7464   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7465   procedure alc-lib_mark-name :
     7466     define input  parameter p-mark-db-num   as integer   no-undo .
     7467     define input  parameter p-mark-code     as integer   no-undo .
     7468     define output parameter p-mark-name     as character no-undo .
     7469     define buffer buf_ex-mark for ub.ex-mark .
     7470     do
     7471     on error undo, return error return-value
     7472     :
     7473       if p-mark-db-num = ?
     7474       or p-mark-code   = ?
     7475       then do:
     7476         assign
     7477           p-mark-name = '?':u
     7478         .
     7479         return .
     7480       end.
     7481       if  p-mark-db-num = 0
     7482       and p-mark-code   = 0
     7483       then do:
     7484         assign
     7485           p-mark-name = ""
     7486         .
     7487         return .
     7488       end.
     7489       find first buf_ex-mark no-lock
     7490         where buf_ex-mark.db-num    = p-mark-db-num
     7491           and buf_ex-mark.mark-code = p-mark-code
     7492         no-error .
     7493       if available buf_ex-mark
     7494       then do:
     7495         assign
     7496           p-mark-name = substitute('&1':u
     7497                                   ,buf_ex-mark.mark-name
     7498                                   )
     7499         .
     7500       end.
     7501     end.
     7502   end procedure.
     7503   procedure alc-lib_get-new-part-code :
     7504     define input  parameter p-obj-type       as character no-undo .
     7505     define input  parameter p-obj-code       as integer   no-undo .
     7506     define input  parameter p-prod-type      as character no-undo .
     7507     define input  parameter p-prod-code      as integer   no-undo .
     7508     define input  parameter p-artic          as character no-undo .
     7509     define input  parameter p-doc-code       as character no-undo .
     7510     define output parameter p-new-part-code  as character no-undo .
     7511     define variable v-cur-part-code as integer no-undo.
     7512     define variable v-max-part-code as integer no-undo.
     7513     define variable i               as integer no-undo.
     7514     define buffer bf_parts for ub.parts .
     7515     do
     7516     on error undo, return error return-value
     7517     :
     7518       assign
     7519         v-max-part-code = 0
     7520       .
     7521       for each bf_parts no-lock
     7522             where bf_parts.obj-type  = p-obj-type  and
     7523                   bf_parts.obj-code  = p-obj-code  and
     7524                   bf_parts.prod-type = p-prod-type and
     7525                   bf_parts.prod-code = p-prod-code and
     7526                   bf_parts.artic     = p-artic     and
     7527                   bf_parts.out-code  = p-doc-code
     7528         :
     7529         assign
     7530           v-cur-part-code = integer(bf_parts.part-code)
     7531           no-error.
     7532         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     7533           assign
     7534             v-max-part-code = v-cur-part-code
     7535           .
     7536         end.
     7537       end.
     7538       assign
     7539         p-new-part-code = string (v-max-part-code + 1)
     7540       .
     7541     end.
     7542   end procedure.
     7543   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7544   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7545   procedure thbjattr_code :
     7546      define input  parameter p-upper-code     as character no-undo .
     7547      define input  parameter p-code           as character no-undo .
     7548      define output parameter p-label          as character no-undo .
     7549      define output parameter p-user-can-edit  as logical   no-undo .
     7550      define output parameter p-output-display as logical   no-undo .
     7551      define output parameter p-other          as character no-undo .
     7552      define output parameter p-prop-list      as character no-undo .
     7553      define output parameter p-prop-type-list as character no-undo .
     7554      define output parameter p-prop-label-list as character no-undo .
     7555      define output parameter p-global          as logical no-undo .
     7556      define output parameter p-host           as logical no-undo .
     7557      define output parameter p-shop           as logical no-undo .
     7558      define output parameter p-store          as logical no-undo .
     7559      define output parameter p-db             as logical no-undo .
     7560      define variable p-region as logical no-undo.
     7561      run thbjattr_code_reg in this-procedure (
     7562                                               p-upper-code,
     7563                                               p-code,
     7564                                               output p-label,
     7565                                               output p-user-can-edit,
     7566                                               output p-output-display,
     7567                                               output p-other,
     7568                                               output p-prop-list,
     7569                                               output p-prop-type-list,
     7570                                               output p-prop-label-list,
     7571                                               output p-global,
     7572                                               output p-host,
     7573                                               output p-shop,
     7574                                               output p-store,
     7575                                               output p-db,
     7576                                               output p-region
     7577                                               ).
     7578   end procedure.
     7579   procedure thbjattr_code_reg :
     7580   define input  parameter p-upper-code     as character no-undo .
     7581   define input  parameter p-code           as character no-undo .
     7582   define output parameter p-label          as character no-undo .
     7583   define output parameter p-user-can-edit  as logical   no-undo .
     7584   define output parameter p-output-display as logical   no-undo .
     7585   define output parameter p-other          as character no-undo .
