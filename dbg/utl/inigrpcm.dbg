      556   ON RIGHT-MOUSE-CLICK OF Fincrease-pc IN FRAME Dialog-Frame
      557   DO:
      558       assign
      559       label-increase-pc:fgcolor = 15
      560       l-increase-pc:visible = true
      561       t-increase-pc = no
      562       .
      563       hide Fincrease-pc in frame Dialog-Frame.
      564       disable Fincrease-pc with frame Dialog-Frame.
      565       display
      566       t-increase-pc
      567       with frame Dialog-Frame .
      568   END.
      569   ON MOUSE-SELECT-CLICK OF l-calc-method IN FRAME Dialog-Frame
      570   DO:
      571      IF l-calc-method:visible then do:
      572       assign
      573       label-calc-method-2:fgcolor = ?
      574       l-calc-method:visible = false
      575       t-calc-method = yes
      576       .
      577       enable Scalc-method with frame Dialog-Frame.
      578       display t-calc-method with frame Dialog-Frame .
      579       APPLY "ENTRY" TO Scalc-method.
      580     end.
      581   END.
      582   ON MOUSE-SELECT-CLICK OF l-income-cli IN FRAME Dialog-Frame
      583   DO:
      584      IF l-income-cli:visible then do:
      585       assign
      586       label-diap-2:fgcolor = ?
      587       l-income-cli:visible = false
      588       t-income-cli = yes
      589       .
      590       enable
      591        Fi-cli-type
      592        Fi-cli-code
      593        with frame Dialog-Frame.
      594       display t-income-cli with frame Dialog-Frame .
      595       APPLY "ENTRY" TO Fi-cli-type.
      596     end.
      597   END.
