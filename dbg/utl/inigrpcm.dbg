      637   ON VALUE-CHANGED OF RS-groups IN FRAME Dialog-Frame
      638   DO:
      639     assign
      640     RS-groups.
      641     CASE rs-groups:
      642       when "all" then do:
      643           disable
      644            b-groups
      645            b-groups-tree
      646            with frame Dialog-Frame.
      647       end.
      648       when "select" then do:
      649            disable
      650            b-groups-tree
      651            with frame Dialog-Frame.
      652           enable
      653            b-groups
      654            with frame Dialog-Frame.
      655       end.
      656      when "select-tree" then do:
      657            disable
      658            b-groups
      659            with frame Dialog-Frame.
      660           enable
      661            b-groups-tree
      662            with frame Dialog-Frame.
      663       end.
      664     END CASE.
      665   END.
      666   ON RIGHT-MOUSE-CLICK OF S-round-method IN FRAME Dialog-Frame
      667   DO:
      668       assign
      669       label-round-method-2:fgcolor = 15
      670       l-round-method:visible = true
      671       t-round-method = no
      672       .
      673       display S-round-method with frame Dialog-Frame.
      674       display t-round-method with frame Dialog-Frame.
      675       disable S-round-method with frame Dialog-Frame.
      676   END.
      677   ON VALUE-CHANGED OF S-round-method IN FRAME Dialog-Frame
      678   DO:
      679       assign
      680     S-round-method
      681     .
      682     if lookup(S-round-method,  'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 then do:
      683       display
      684       f-base
      685       with frame Dialog-Frame.
      686       enable
      687       f-base
      688       with frame Dialog-Frame.
      689     end.
      690     else do:
      691       hide
      692       f-base
      693       in frame Dialog-Frame.
      694       disable
      695       f-base
      696       with frame Dialog-Frame.
      697     end.
      698   END.
      699   ON RIGHT-MOUSE-CLICK OF Scalc-method IN FRAME Dialog-Frame
      700   DO:
      701      assign
      702       label-calc-method-2:fgcolor = 15
      703       l-calc-method:visible = true
      704       t-calc-method = no
      705       .
      706       display Scalc-method with frame Dialog-Frame.
      707       display t-calc-method with frame Dialog-Frame.
      708       disable Scalc-method with frame Dialog-Frame.
      709   END.
      710   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      711   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      712   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   on help of frame Dialog-Frame
      714   do:
      715     run gbl/app_help.p
      716       (input this-procedure :file-name
      717       ,input ''
      718       ,input ?
      719       ) no-error.
      720     if error-status :error then do:
      721       message
      722         "Ошибка при вызове помощи"
      723         error-status :get-message(1)
      724         view-as alert-box .
      725     end.
      726   end.
      727   run minbtn-set in this-procedure .
      728   on choose of b-help in frame Dialog-Frame
      729   do:
      730     apply "help":u to frame Dialog-Frame .
      731   end.
      732   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      733   procedure minbtn-set :
      734       do
      735           on error undo, return error return-value
      736           :
      737           define variable ii              as integer       no-undo .
      738           define variable fh              as widget-handle no-undo .
      739           define variable hh              as widget-handle no-undo .
      740           define variable v-h             as handle        extent 4 no-undo .
      741           define variable v-name-button   as character     no-undo .
      742           define variable v-help-old-x    as decimal       no-undo .
      743           define variable v-help-old-y    as decimal       no-undo .
      744           define variable v-help-old-size as decimal       no-undo .
      745           define variable v-frame-width   as decimal       no-undo .
      746           define variable jj              as integer       no-undo .
      747           do
      748               on error undo, return error
      749               :
      750               assign
      751                   v-frame-width = frame Dialog-Frame:width - 0.3
      752                   fh            = frame Dialog-Frame:first-child
      753                   hh            = fh:first-child
      754                   ii            = 1
      755                   .
      756               do while valid-handle(hh):
      757                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      758                   do:
      759                       case lc(hh:name) :
      760                           when "b-help" then
      761                               do:
      762                                   hh:load-image-up("cmp/b-help.bmp":u) .
      763                                   hh:load-image-down("cmp/b-help.bmp":u) .
      764                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      765                                   hh:TOOLTIP = "Помощь" .
      766                                   v-help-old-x = hh:column .
      767                                   v-help-old-y = hh:row    .
      768                                   v-help-old-size = hh:width .
      769                                   hh:width-chars = 2.5 .
      770                               end.
      771                           when "b-print" then
      772                               do:
      773                                   hh:load-image("cmp/b-print.bmp":u) .
      774                                   hh:TOOLTIP = "Печать" .
      775                                   v-h[ii] = hh:handle .
      776                                   ii = ii + 1 .
      777                                   hh:width-chars = 3 .
      778                               end.
      779                           when "b-history" or
      780                           when "b-hist" then
      781                               do:
      782                                   hh:load-image("cmp/b-hist.bmp":u) .
      783                                   hh:TOOLTIP = "История" .
      784                                   v-h[ii] = hh:handle .
      785                                   ii = ii + 1 .
      786                                   hh:width-chars = 3 .
      787                               end.
      788                           when "b-sch" then
      789                               do:
      790                                   hh:load-image("cmp/b-sch.bmp":u) .
      791                                   hh:TOOLTIP = "Установка Фильтра" .
      792                                   v-h[ii] = hh:handle .
      793                                   ii = ii + 1 .
      794                                   hh:width-chars = 3 .
      795                               end.
      796                           when "b-hist-user" then
      797                               do:
      798                                   hh:load-image("cmp/b-hist.bmp":u) .
      799                                   hh:TOOLTIP = "История пользователя" .
      800                                   ii = ii + 1 .
      801                               end.
      802                       end case.
      803                   end.
      804                   hh = hh:next-sibling.
      805               end.
      806               b-help:column = v-frame-width - b-help:width-chars.
      807               jj = 0.
      808               repeat ii = 4 to 1 by -1 :
      809                   if valid-handle (v-h[ii] ) then
      810                   do:
      811                       jj  = jj + 1 .
      812                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      813                       v-h[ii]:row    = v-help-old-y .
      814                   end.
      815               end.
      816           end.
      817       end.
      818   end procedure.
      819   MAIN-BLOCK:
      820   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      821      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      822   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823     run mainmenu_getcntxt in parparentproc
      824       (output v-cntxt-db-num
      825       ,output v-cntxt-userid
      826       ,output v-cntxt-level
      827       ,output v-cntxt-host-code-obj
      828       ,output v-cntxt-obj-type
      829       ,output v-cntxt-obj-code
      830       ,output v-cntxt-db-num-obj
      831       ,output v-cntxt-is-admin
      832       ) .
      833   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      834   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      835     (output v-curr-db-num
      836     )  .
      837   if v-curr-db-num <> 0 then do:
      838     message vss-workfile vss-revision vss-description skip
      839     "Утилиту можно запустить только в ГБД"
      840     view-as alert-box error .
      841     return error .
      842   end.
      843     RUN Myenable.
      844     WAIT-FOR GO OF FRAME Dialog-Frame.
      845   END.
      846   RUN disable_UI.
      847   PROCEDURE disable_UI :
      848     HIDE FRAME Dialog-Frame.
      849   END PROCEDURE.
      850   PROCEDURE enable_UI :
      851     DISPLAY F-base S-round-method Scalc-method T-calc-method T-increase-pc
      852             T-minmax T-round-method T-income-cli Fi-cli-type Fi-cli-code
      853             Fincrease-pc Fimin Fimax RS-method RS-values RS-groups T-global T-firm
      854             T-object label-calc-method-2 label-round-method-2 label-increase-pc
      855             label-diap label-diap-2 label-fill-method label-fill-values
      856             label-fill-subject label-fill-tree
      857         WITH FRAME Dialog-Frame.
      858     ENABLE b-quit l-round-method l-increase-pc l-minmax RECT-2 RECT-1 RECT-5
      859            RECT-3 l-income-cli RECT-4 l-calc-method B-exit B-Help F-base
      860            S-round-method Scalc-method T-calc-method T-increase-pc T-minmax
      861            T-round-method T-income-cli Fi-cli-type Fi-cli-code Fincrease-pc Fimin
      862            Fimax RS-method RS-values RS-groups T-global B-groups T-firm
      863            B-groups-tree T-object label-calc-method-2 label-round-method-2
      864            label-increase-pc label-diap label-diap-2 label-fill-method
      865            label-fill-values label-fill-subject label-fill-tree
      866         WITH FRAME Dialog-Frame.
      867     VIEW FRAME Dialog-Frame.
      868   END PROCEDURE.
      869   PROCEDURE MyEnable :
