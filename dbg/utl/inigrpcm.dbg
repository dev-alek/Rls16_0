      871   S-round-method:list-items in frame Dialog-Frame = '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U.
      872   DISPLAY
      873   label-increase-pc
      874   label-calc-method-2
      875   label-round-method-2
      876   label-diap
      877   label-diap-2
      878   label-fill-method
      879   label-fill-subject
      880   label-fill-tree
      881   label-fill-values
      882   RS-groups
      883   RS-method
      884   RS-values
      885   T-firm
      886   T-global
      887   T-object
      888   t-income-cli
      889   B-groups
      890   B-groups-tree
      891   l-calc-method
      892   l-increase-pc
      893   l-minmax
      894   l-round-method
      895   l-income-cli
      896   WITH FRAME Dialog-Frame.
      897   ENABLE
      898   b-quit
      899   B-exit
      900   B-Help
      901   RS-groups
      902   RS-method
      903   RS-values
      904   T-firm
      905   T-global
      906   T-object
      907   l-calc-method
      908   l-increase-pc
      909   l-minmax
      910   l-round-method
      911   l-income-cli
      912   B-groups
      913   B-groups-tree
      914   WITH FRAME Dialog-Frame.
      915   VIEW FRAME Dialog-Frame.
      916   APPLY "VAlue-changed" to RS-groups.
      917   END PROCEDURE.
