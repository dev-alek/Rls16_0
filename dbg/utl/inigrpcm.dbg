        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Инициализация поля СПОСОБ РАСЧЕТА в gds-grp".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     define variable v-cntxt-db-num        as integer   no-undo .
      115     define variable v-cntxt-userid        as character no-undo .
      116     define variable v-cntxt-level         as character no-undo .
      117     define variable v-cntxt-host-code-obj as integer   no-undo .
      118     define variable v-cntxt-obj-type      as character no-undo .
      119     define variable v-cntxt-obj-code      as integer   no-undo .
      120     define variable v-cntxt-db-num-obj    as integer   no-undo .
      121     define variable v-cntxt-is-admin      as logical   no-undo .
      122   define variable v-RID-LIST as character no-undo .
      123   define variable v-curr-db-num like ub.db.db-num no-undo .
      124   DEFINE BUTTON B-exit AUTO-GO
      125        LABEL "&Ввод"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON B-groups
      129        IMAGE-UP FILE "btn-down-arrow":U
      130        IMAGE-DOWN FILE "btn-down-arrow":U
      131        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      132        LABEL "Btn 1"
      133        SIZE 3 BY 1.
      134   DEFINE BUTTON B-groups-tree
      135        IMAGE-UP FILE "btn-down-arrow":U
      136        IMAGE-DOWN FILE "btn-down-arrow":U
      137        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      138        LABEL "Btn 1"
      139        SIZE 3 BY 1.
      140   DEFINE BUTTON B-Help
      141        LABEL "Помо&щь"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON b-quit AUTO-END-KEY
      145        LABEL "&Отмена"
      146        SIZE 10 BY 1
      147        BGCOLOR 8 .
      148   DEFINE VARIABLE F-base AS DECIMAL FORMAT "->>>>9.99":U INITIAL 0
      149        VIEW-AS FILL-IN
      150        SIZE 15 BY 1 NO-UNDO.
      151   DEFINE VARIABLE Fi-cli-code AS INTEGER FORMAT ">>>>>":U INITIAL 0
      152        VIEW-AS FILL-IN
      153        SIZE 8.38 BY .96 NO-UNDO.
      154   DEFINE VARIABLE Fi-cli-type AS CHARACTER FORMAT "X(3)":U
      155        VIEW-AS FILL-IN
      156        SIZE 3.75 BY .96 NO-UNDO.
      157   DEFINE VARIABLE Fimax AS DECIMAL FORMAT ">>9.99":U INITIAL 0
      158        VIEW-AS FILL-IN
      159        SIZE 8.38 BY .96 NO-UNDO.
      160   DEFINE VARIABLE Fimin AS DECIMAL FORMAT ">>9.99":U INITIAL 0
      161        VIEW-AS FILL-IN
      162        SIZE 8.75 BY .96 NO-UNDO.
      163   DEFINE VARIABLE Fincrease-pc AS DECIMAL FORMAT ">>9.99":U INITIAL 0
      164        VIEW-AS FILL-IN
      165        SIZE 8.88 BY .96 NO-UNDO.
      166   DEFINE VARIABLE label-calc-method-2 AS CHARACTER FORMAT "X(256)":U INITIAL "СПОСОБ РАСЧЕТА"
      167         VIEW-AS TEXT
      168        SIZE 20.63 BY .67
      169        FGCOLOR 4  NO-UNDO.
      170   DEFINE VARIABLE label-diap AS CHARACTER FORMAT "X(256)":U INITIAL "min/max НАЦЕНКИ"
      171         VIEW-AS TEXT
      172        SIZE 16.25 BY .67
      173        FGCOLOR 4  NO-UNDO.
      174   DEFINE VARIABLE label-diap-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Вн.ПОСТАВЩИК"
      175         VIEW-AS TEXT
      176        SIZE 12.75 BY .67
      177        FGCOLOR 4  NO-UNDO.
      178   DEFINE VARIABLE label-fill-method AS CHARACTER FORMAT "X(256)":U INITIAL "Как заполнять"
      179         VIEW-AS TEXT
      180        SIZE 26.5 BY .67
      181        FGCOLOR 4  NO-UNDO.
      182   DEFINE VARIABLE label-fill-subject AS CHARACTER FORMAT "X(256)":U INITIAL "Какие группы заполнять"
      183         VIEW-AS TEXT
      184        SIZE 26.5 BY .67
      185        FGCOLOR 4  NO-UNDO.
      186   DEFINE VARIABLE label-fill-tree AS CHARACTER FORMAT "X(256)":U INITIAL "Область действия"
      187         VIEW-AS TEXT
      188        SIZE 26.5 BY .67
      189        FGCOLOR 4  NO-UNDO.
      190   DEFINE VARIABLE label-fill-values AS CHARACTER FORMAT "X(256)":U INITIAL "Чем заполнять"
      191         VIEW-AS TEXT
      192        SIZE 26.5 BY .67
      193        FGCOLOR 4  NO-UNDO.
      194   DEFINE VARIABLE label-increase-pc AS CHARACTER FORMAT "X(256)":U INITIAL "НАЦЕНКА"
      195         VIEW-AS TEXT
      196        SIZE 11.13 BY .67
      197        FGCOLOR 4  NO-UNDO.
      198   DEFINE VARIABLE label-round-method-2 AS CHARACTER FORMAT "X(256)":U INITIAL "МЕТОД ОКРУГЛЕНИЯ"
      199         VIEW-AS TEXT
      200        SIZE 21 BY .67
      201        FGCOLOR 4  NO-UNDO.
      202   DEFINE IMAGE l-calc-method
      203        FILENAME "adeicon\lock":U
      204        SIZE 2.88 BY .92.
      205   DEFINE IMAGE l-income-cli
      206        FILENAME "adeicon\lock":U
      207        SIZE 2.88 BY .92.
      208   DEFINE IMAGE l-increase-pc
      209        FILENAME "adeicon\lock":U
      210        SIZE 2.88 BY .92.
      211   DEFINE IMAGE l-minmax
      212        FILENAME "adeicon\lock":U
      213        SIZE 2.88 BY .92.
      214   DEFINE IMAGE l-round-method
      215        FILENAME "adeicon\lock":U
      216        SIZE 2.88 BY .92.
      217   DEFINE VARIABLE RS-groups AS CHARACTER
      218        VIEW-AS RADIO-SET VERTICAL
      219        RADIO-BUTTONS
      220             "Все группы", "all",
      221   "Выборочно", "select",
      222   "Выборочно с нижележащими группами", "select-tree"
      223        SIZE 38.75 BY 2.58 NO-UNDO.
      224   DEFINE VARIABLE RS-method AS CHARACTER
      225        VIEW-AS RADIO-SET VERTICAL
      226        RADIO-BUTTONS
      227             "Незаполненные и неправильно заполненные поля", "error-or-space",
      228   "Неправильно заполненные поля", "error",
      229   "Незаполненные поля", "space",
      230   "Все поля", "all"
      231        SIZE 48.13 BY 3.67 NO-UNDO.
      232   DEFINE VARIABLE RS-values AS CHARACTER
      233        VIEW-AS RADIO-SET VERTICAL
      234        RADIO-BUTTONS
      235             "Выбранные значения", "default",
      236   "Из группы верх. ур-ня(группа ур. 1 не мен.)", "group"
      237        SIZE 47.75 BY 2.5 NO-UNDO.
      238   DEFINE RECTANGLE RECT-1
      239        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      240        SIZE 25.5 BY 7.21.
      241   DEFINE RECTANGLE RECT-2
      242        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      243        SIZE 40.5 BY 7.29.
      244   DEFINE RECTANGLE RECT-3
      245        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      246        SIZE 25.38 BY 1.17.
      247   DEFINE RECTANGLE RECT-4
      248        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      249        SIZE 40.5 BY 1.17.
      250   DEFINE RECTANGLE RECT-5
      251        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      252        SIZE 27.88 BY 1.17.
      253   DEFINE VARIABLE S-round-method AS CHARACTER
      254        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      255        SIZE 20.75 BY 5.83 NO-UNDO.
      256   DEFINE VARIABLE Scalc-method AS CHARACTER
      257        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      258        SIZE 20.75 BY 5.71 NO-UNDO.
      259   DEFINE VARIABLE T-calc-method AS LOGICAL INITIAL no
      260        LABEL "Способ расчета"
      261        VIEW-AS TOGGLE-BOX
      262        SIZE 20 BY 1 NO-UNDO.
      263   DEFINE VARIABLE T-firm AS LOGICAL INITIAL no
      264        LABEL "Фирма"
      265        VIEW-AS TOGGLE-BOX
      266        SIZE 23.25 BY 1 NO-UNDO.
      267   DEFINE VARIABLE T-global AS LOGICAL INITIAL no
      268        LABEL "Глобально"
      269        VIEW-AS TOGGLE-BOX
      270        SIZE 23.25 BY 1 NO-UNDO.
      271   DEFINE VARIABLE T-income-cli AS LOGICAL INITIAL no
      272        LABEL "Внутр.поставщик"
      273        VIEW-AS TOGGLE-BOX
      274        SIZE 20 BY 1 NO-UNDO.
      275   DEFINE VARIABLE T-increase-pc AS LOGICAL INITIAL no
      276        LABEL "Наценка"
      277        VIEW-AS TOGGLE-BOX
      278        SIZE 20 BY 1 NO-UNDO.
      279   DEFINE VARIABLE T-minmax AS LOGICAL INITIAL no
      280        LABEL "Диапазоны наценки"
      281        VIEW-AS TOGGLE-BOX
      282        SIZE 20 BY 1 NO-UNDO.
      283   DEFINE VARIABLE T-object AS LOGICAL INITIAL no
      284        LABEL "Объекты"
      285        VIEW-AS TOGGLE-BOX
      286        SIZE 23.25 BY 1 NO-UNDO.
      287   DEFINE VARIABLE T-round-method AS LOGICAL INITIAL no
      288        LABEL "Метод округления"
      289        VIEW-AS TOGGLE-BOX
      290        SIZE 20 BY 1 NO-UNDO.
      291   DEFINE FRAME Dialog-Frame
      292        b-quit AT ROW 1 COL 1
      293        B-exit AT ROW 1 COL 11
      294        B-Help AT ROW 1 COL 89.13
      295        F-base AT ROW 3 COL 48.88 COLON-ALIGNED NO-LABEL
      296        S-round-method AT ROW 3.13 COL 28.88 NO-LABEL
      297        Scalc-method AT ROW 3.29 COL 1.63 NO-LABEL
      298        T-calc-method AT ROW 3.54 COL 73.13
      299        T-increase-pc AT ROW 4.54 COL 73.13
      300        T-minmax AT ROW 5.54 COL 73.13
      301        T-round-method AT ROW 6.54 COL 73.13
      302        T-income-cli AT ROW 7.54 COL 73.13
      303        Fi-cli-type AT ROW 9.5 COL 81.63 COLON-ALIGNED NO-LABEL
      304        Fi-cli-code AT ROW 9.5 COL 85.38 COLON-ALIGNED NO-LABEL
      305        Fincrease-pc AT ROW 9.54 COL 12 COLON-ALIGNED NO-LABEL
      306        Fimin AT ROW 9.54 COL 43 COLON-ALIGNED NO-LABEL
      307        Fimax AT ROW 9.54 COL 53 COLON-ALIGNED NO-LABEL
      308        RS-method AT ROW 11.54 COL 2.5 NO-LABEL
      309        RS-values AT ROW 11.58 COL 51.25 NO-LABEL
      310        RS-groups AT ROW 15.96 COL 2.5 NO-LABEL
      311        T-global AT ROW 16.13 COL 55.13
      312        B-groups AT ROW 16.92 COL 41.5
      313        T-firm AT ROW 17.13 COL 55.13
      314        B-groups-tree AT ROW 17.79 COL 41.5
      315        T-object AT ROW 18.13 COL 55.13
      316        label-calc-method-2 AT ROW 2.25 COL 1.75 NO-LABEL
      317        label-round-method-2 AT ROW 2.25 COL 27 COLON-ALIGNED NO-LABEL
      318        label-increase-pc AT ROW 9.67 COL 2.13 NO-LABEL
      319        label-diap AT ROW 9.67 COL 28 NO-LABEL
      320        label-diap-2 AT ROW 9.67 COL 70.38 NO-LABEL
      321        label-fill-method AT ROW 10.71 COL 2.25 NO-LABEL
      322        label-fill-values AT ROW 10.83 COL 51 NO-LABEL
      323        label-fill-subject AT ROW 15.21 COL 2.38 NO-LABEL
      324        label-fill-tree AT ROW 15.25 COL 54.75 NO-LABEL
      325        l-round-method AT ROW 4.38 COL 51.38
      326        l-increase-pc AT ROW 9.58 COL 24
      327        l-minmax AT ROW 9.58 COL 63.88
      328        RECT-2 AT ROW 2 COL 27.5
      329        RECT-1 AT ROW 2.08 COL 1.38
      330        "Заполнять поля" VIEW-AS TEXT
      331             SIZE 20 BY 1 AT ROW 2.54 COL 73.13
      332             FGCOLOR 4
      333        RECT-5 AT ROW 9.42 COL 68.38
      334        RECT-3 AT ROW 9.42 COL 1.63
      335        l-income-cli AT ROW 9.54 COL 96.25
      336        RECT-4 AT ROW 9.42 COL 27.5
      337        l-calc-method AT ROW 3.29 COL 23.25
      338        SPACE(73.00) SKIP(15.82)
      339       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      340            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      341            TITLE "Заполнение полей ПАРАМЕТРЫ НА ОБЪЕКТАХ"
      342            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      343   ASSIGN
      344          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      345          FRAME Dialog-Frame:HIDDEN           = TRUE.
      346   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      347   DO:
      348     APPLY "END-ERROR":U TO SELF.
      349   END.
      350   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      351   DO:
      352   define variable v-field as integer no-undo .
      353   define variable v-region as integer no-undo .
      354   define variable glog as logical no-undo .
      355     assign
      356     Scalc-method
      357     S-round-method
      358     f-base
      359     fimin
      360     fimax
      361     fi-cli-type
      362     fi-cli-code
      363     RS-method
      364     RS-groups
      365     RS-values T-firm T-global T-object
      366     fincrease-pc
      367     T-calc-method  = if scalc-method:sensitive then yes else no
      368     T-increase-pc  = if fincrease-pc:sensitive then yes else no
      369     T-round-method = if s-round-method:sensitive then yes else no
      370     T-minmax       = if fimin:sensitive then yes else no
      371     T-income-cli   = if fi-cli-type:sensitive then yes else no
      372     .
      373     if RS-values = "default":U AND
      374       (Scalc-method = ? or
      375       Scalc-method = "":U or
      376       lookup(Scalc-method, 'Учетная,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U) = 0) AND
      377       t-calc-method then do:
      378         message
      379         "Выберите значение для заполнения поля СПОСОБ РАСЧЕТА"
      380         view-as alert-box .
      381         return no-apply .
      382     end.
      383     if RS-values = "default":U AND
      384       (S-round-method = ? or
      385       S-round-method = "":U or
      386       lookup(S-round-method, '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U) = 0) AND
      387       t-round-method then do:
      388         message
      389         "Выберите значение для заполнения поля МЕТОД ОКРУГЛЕНИЯ"
      390         view-as alert-box .
      391         return no-apply .
      392     end.
      393     if RS-values = "default":U AND
      394       t-minmax = yes AND
      395       (fimax = ? or fimin = ? ) then do:
      396         message
      397         "Выберите значения для заполнения полей min и max НАЦЕНКИ"
      398         view-as alert-box .
      399         return no-apply .
      400     end.
      401     if t-minmax then do:
      402       if fimin > fimax then do:
      403           message
      404           "Значение минимальной наценки не должно быть больше значения максимальной наценки"
      405           view-as alert-box error.
      406           return no-apply.
      407       end.
      408     end.
      409     if T-round-method then do:
      410       CASE S-round-method:
      411         when 'Произвольно,Вверх,Коэффициент,9-99окончание':U then do:
      412           if f-base = 0 then do:
      413             message
      414             "Введите ненулевое значение коэффициента"
      415             view-as alert-box error .
      416             return no-apply.
      417           end.
      418         end.
      419       END CASE.
      420    end.
      421     assign
      422     v-field = v-field + (if T-calc-method then 1 else 0)
      423     v-field = v-field + (if T-increase-pc then 2 else 0)
      424     v-field = v-field + (if T-round-method then 4 else 0)
      425     v-field = v-field + (if T-minmax then 8 else 0)
      426     v-field = v-field + (if T-income-cli then 16 else 0)
      427     .
      428    assign
      429     v-region = v-region + (if T-global then 1 else 0)
      430     v-region = v-region + (if T-firm then 2 else 0)
      431     v-region = v-region + (if T-object then 4 else 0)
      432   .
      433     if v-field = 0 then do:
      434       message
      435       "Вы не выбрали для заполнения ни одного поля"
      436       view-as alert-box Error.
      437       return no-apply.
      438     end.
      439     if v-region = 0 and v-field <> 1 then do:
      440       message
      441       "Вы не выбрали область действия"
      442       view-as alert-box Error.
      443       return no-apply.
      444     end.
      445     if rs-groups <> "ALL" and v-rid-list = "":U then do:
      446       message
      447       "В списке групп нет ни одной группы"
      448       VIEW-AS ALERT-BOX ERROR.
      449       return no-apply .
      450     end.
      451     message
      452     "Вы уверены, что хотите провести изменения согласно выбранным Вами параметрам?"
      453     view-as alert-box QUestion buttons yes-no update glog.
      454     if not glog then return no-apply.
      455     run utl/ini-grpc.p (
      456                     Scalc-method
      457                   , fincrease-pc
      458                   , fimin
      459                   , fimax
      460                   , s-round-method
      461                   , f-base
      462                   , fi-cli-type
      463                   , fi-cli-code
      464                   , RS-method
      465                   , RS-groups
      466                   , RS-values
      467                   , v-field
      468                   , v-region
      469                   , V-RID-LIST
      470                 ).
      471   END.
      472   ON CHOOSE OF B-groups IN FRAME Dialog-Frame
      473   DO:
      474     run ref/gds-grp.w (
      475                   input parparentproc
      476                 , input "b-sel,b-mark"
      477                 , input v-cntxt-obj-type
      478                 , input v-cntxt-obj-code
      479                 , input-output v-rid-list ).
      480   END.
      481   ON CHOOSE OF B-groups-tree IN FRAME Dialog-Frame
      482   DO:
      483     run ref/gds-grp.w (
      484                   input parparentproc
      485                 , input "b-sel,b-mark"
      486                 , input v-cntxt-obj-type
      487                 , input v-cntxt-obj-code
      488                 , input-output v-rid-list ).
      489   END.
      490   ON RIGHT-MOUSE-CLICK OF Fi-cli-code IN FRAME Dialog-Frame
      491   DO:
      492       assign
      493       label-diap-2:fgcolor = 15
      494       l-income-cli:visible = true
      495       t-income-cli = no
      496       .
      497       hide
