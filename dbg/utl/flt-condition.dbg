        1   block-level on error undo, throw.
        2   class utl.flt-condition:
        3      define public property Field_ as char no-undo
        4      get.
        5      set.
        6      define public property FieldType as char no-undo
        7      get.
        8      set.
        9      define public property BufferName as char no-undo
       10      get.
       11      set.
       12      define public property FieldName as char no-undo
       13      get.
       14      set.
       15      define public property Value as char no-undo
       16      get.
       17      set.
       18      define public property Value1 as char no-undo
       19      get.
       20      set.
       21      define public property Operation as char no-undo
       22      get.
       23      set.
       24      define public property SupportOp as char no-undo
       25      get.
       26      private set.
       27      define public property Enabled as logical no-undo
       28      get.
       29      set.
       30      method public char GetWhere():
       31         def var vRes as char no-undo.
       32         if this-object:Enabled then
       33         do:
       34            case this-object:Operation:
       35               when "равно"        then vRes = get-flt("=").
       36               when "не равно"        then vRes = get-flt("<>").
       37               when "меньше"        then vRes = get-flt("<").
       38               when "меньше или равно"        then vRes = get-flt("<=").
       39               when "больше"        then vRes = get-flt(">").
       40               when "больше или равно"        then vRes = get-flt(">=").
       41               when "начинается с"    then vRes = get-flt("begins").
       42               when "между"   then vRes = get-flt-between().
       43               when "список"      then vRes = get-flt-list().
       44               when "содержит" then vRes = get-flt-contrains().
       45            end case.
       46         end.
       47         return vRes.
       48      end method.
       49      method public char AddOp(iOp as char):
       50         this-object:SupportOp = this-object:SupportOp + "," + iOp.
       51      end method.
       52      method public char GetValue( ):
       53         def var vRes as char no-undo.
       54         case this-object:FieldType:
       55            when "int"  then vRes = this-object:value.
       56            when "char" then vRes = quoter(this-object:value).
       57            when "date" then vRes = quoter(date(this-object:value)).
       58            when "datetime" then vRes = quoter(datetime(this-object:value)).
       59         end case.
       60         return vRes.
       61      end method.
       62      method private char get-flt(iOp as char):
       63         def var vRes as char no-undo.
       64         vRes = substitute("&1.&2 &3 &4",
       65                             this-object:BufferName,
       66                             this-object:Field_,
       67                             iOp,
       68                             GetValue()).
       69         return vRes.
       70      end method.
       71      method private char get-flt-between():
       72         def var vRes as char no-undo.
       73         case this-object:FieldType:
       74            when "date" then
       75            do:
       76               vRes = substitute("(&1.&2 >= &3) and (&1.&2 <= &4)",
       77                                   this-object:BufferName,
       78                                   this-object:Field_,
       79                                   quoter(date(this-object:Value)),
       80                                   quoter(date(this-object:Value1))).
       81            end.
       82            when "datetime" then
       83            do:
       84               vRes = substitute("(&1.&2 >= &3) and (&1.&2 <= &4)",
       85                                   this-object:BufferName,
       86                                   this-object:Field_,
       87                                   quoter(datetime(this-object:Value)),
       88                                   quoter(datetime(this-object:Value1))).
       89            end.
       90         end case.
       91         return vRes.
       92      end method.
       93      method private char get-flt-list():
       94         def var vRes as char no-undo.
       95         if this-object:FieldType = "char" then
       96         do:
       97            vRes = substitute("can-do(&3,&1.&2)",
       98                               this-object:BufferName,
       99                               this-object:Field_,
      100                               GetValue()).
      101         end.
      102         if this-object:FieldType = "int" then
      103         do:
      104            vRes = substitute("can-do(&3,string(&1.&2))",
      105                               this-object:BufferName,
      106                               this-object:Field_,
      107                               quoter(GetValue())).
      108         end.
      109         return vRes.
      110      end method.
      111      method private char get-flt-contrains():
      112         def var vRes as char no-undo.
      113         if this-object:FieldType = "char" then
      114         do:
      115            vRes = substitute("&1.&2 matches ('*&3*')",
      116                               this-object:BufferName,
      117                               this-object:Field_,
      118                               this-object:value).
      119         end.
      120         return vRes.
      121      end method.
      122   end class.
