        1   block-level on error undo, throw.
        2   define input parameter p-install as logical no-undo init no .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: chk-trn.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/chk-trn.p $":U .
        8   define variable vss-description as character no-undo init "Поиск приходов, по которым были сформированы автоматические переоценки с неправильным fact-num".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure cur-time :
       69      define output parameter p-today as date      no-undo .
       70      define output parameter p-time  as integer   no-undo .
       71     do
       72     on error undo, return error
       73     :
       74       define variable v-date1 as date      no-undo .
       75       define variable v-date2 as date      no-undo .
       76       define variable v-time  as integer   no-undo .
       77       assign
       78         v-date1 = today
       79         v-time  = time
       80         v-date2 = today
       81       .
       82       if v-date1 <> v-date2
       83       then do:
       84         assign
       85           v-date1 = today
       86           v-time  = v-time
       87         .
       88       end.
       89       assign
       90         p-today = v-date1
       91         p-time  = v-time
       92       .
       93     end.
       94   end.
       95   function cur-time-date returns character
       96   :
       97     return string(today, '99/99/9999':U) .
       98   end.
       99   function cur-time-mjd returns decimal
      100   :
      101     define variable v-date as date      no-undo .
      102     define variable v-time as integer   no-undo .
      103     run cur-time in this-procedure
      104       (output v-date
      105       ,output v-time
      106       ) .
      107     return integer(v-date) - 2400002 + (v-time / 86400) .
      108   end.
      109   function cur-time-get-ending-index returns integer
      110   (input p-number as integer
      111   )
      112   :
      113     if p-number < 0
      114     or p-number = ?
      115     then do:
      116       return 1 .
      117     end.
      118     define variable v-rest as integer   no-undo .
      119     assign
      120       p-number = p-number modulo 100
      121     .
      122     if p-number < 20
      123     then do:
      124       assign
      125         v-rest = p-number
      126       .
      127     end.
      128     else do:
      129       assign
      130         v-rest = p-number modulo 10
      131       .
      132     end.
      133     case v-rest :
      134       when 1
      135       then do:
      136         return 2 .
      137       end.
      138       when 2 or
      139       when 3 or
      140       when 4
      141       then do:
      142         return 3 .
      143       end.
      144       otherwise do:
      145         return 1 .
      146       end.
      147     end case .
      148   end.
      149   procedure cur-time-mjd-to-date :
      150      define input  parameter i-mjd-diff as decimal no-undo.
      151      define output parameter o-Date     as date    no-undo.
      152      define output parameter o-Time     as integer no-undo.
      153      define variable v-day-number as integer   no-undo .
      154      if    i-mjd-diff < 0
      155         or i-mjd-diff = ?
      156      then do:
      157         return "?" .
      158      end.
      159      assign
      160         v-day-number = truncate(i-mjd-diff,0).
      161         o-Date = date(v-day-number + 2400002).
      162         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      163     .
      164   end.
      165   function cur-time-mjd-to-string returns character
      166   (input p-mjd-diff as decimal
      167   )
      168   :
      169     define variable v-day-number as integer   no-undo .
      170     define variable v-seconds    as integer   no-undo .
      171     define variable v-hour       as integer   no-undo .
      172     define variable v-min        as integer   no-undo .
      173     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      174     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      175     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      176     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      177     if p-mjd-diff < 0
      178     or p-mjd-diff = ?
      179     then do:
      180       return "?" .
      181     end.
      182     assign
      183       v-day-number = integer(truncate(p-mjd-diff,0))
      184       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186     if v-seconds > 86400
      187     then do:
      188       assign
      189         v-seconds = 86400 - 1
      190       .
      191     end.
      192     if v-seconds < 0
      193     then do:
      194       assign
      195         v-seconds = 0
      196       .
      197     end.
      198     assign
      199       v-hour = truncate(v-seconds / 3600, 0)
      200     .
      201     assign
      202       v-seconds = v-seconds modulo 3600
      203     .
      204     assign
      205       v-min = truncate(v-seconds / 60, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 60
      209     .
      210     return
      211         (if v-day-number <> 0
      212           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      213           else ""
      214         )
      215       + (if v-day-number <> 0 or v-hour <> 0
      216           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      220           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      221           else ""
      222         )
      223       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      224       .
      225   end.
      226   function cur-time-string returns character
      227   :
      228     define variable v-date as date      no-undo .
      229     define variable v-time as integer   no-undo .
      230     run cur-time in this-procedure
      231       (output v-date
      232       ,output v-time
      233       ) .
      234     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      235   end.
      236   function cur-time-string-sec returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      245   end.
      246   function cur-time-custom  returns character
      247   (input p-prefix as character
      248   ,input p-date-format as character
      249   ,input p-delimiter as character
      250   ,input p-time-format as character
      251   ,input p-suffix as character
      252   )
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return
      261       p-prefix
      262       + string(v-date, p-date-format)
      263       + p-delimiter
      264       + string(v-time, p-time-format)
      265       + p-suffix
      266       .
      267   end.
      268   function cur-time-print  returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      277   end.
      278   function cur-time-datetime returns datetime
      279   :
      280     define variable v-char as character no-undo .
      281     define variable v-datetime as datetime no-undo .
      282     v-char = cur-time-string().
      283     v-datetime = datetime(v-char).
      284     return  v-datetime.
      285   end.
      286   function cur-time-string-msec returns character
      287   :
      288     define variable v-date as datetime  no-undo .
      289     v-date = now.
      290     return string(v-date) .
      291   end.
      292   define variable l-fix-documents         as logical          no-undo .
      293   define variable l-log-fact-num-change   as logical          no-undo .
      294   define variable i-err-count             as integer  init 0  no-undo .
      295   define variable v-today                 as date             no-undo.
      296   define variable v-time                  as integer          no-undo.
      297   if p-install = false then do:
      298     assign
      299       l-fix-documents       = no
      300       l-log-fact-num-change = true
      301     .
      302     message
      303       vss-description skip
      304       "Вся информация об ошибках записывается в файл chk-trn.txt." skip
      305       "Информация о переименованных документах записывается в файл chk-trn.fix." skip
      306       "да - исправлять найденные документы" skip
      307       "нет - не исправлять найденные документы" skip
      308       "отмена - отказаться от поиска" skip
      309       view-as alert-box buttons yes-no-cancel update l-fix-documents .
      310     if l-fix-documents = ? then do:
      311       return .
      312     end.
      313     if l-fix-documents = true then do:
      314       message
      315         vss-description skip
      316         "Найденные документы будут изменяться" skip
      317         "Информация о переименованных документах записывается в файл chk-trn.fix" skip
      318         "да - информация будет записана в дополнительный файл fctnumch.txt" skip
      319         "нет - информация не будет записана в дополнительный файл" skip
      320         "отмена - отказаться от изменения" skip
      321         view-as alert-box buttons yes-no-cancel update l-log-fact-num-change .
      322       if l-log-fact-num-change = ? then do:
      323         return .
      324       end.
      325     end.
      326   end.
      327   else do:
      328     assign
      329       l-fix-documents       = true
      330       l-log-fact-num-change = false
      331     .
      332   end.
      333   for each trn-doc no-lock
      334     where trn-doc.doc-type = 'при':U
      335       and trn-doc.status_  = 'факт':U
      336       and trn-doc.internal = true
      337       and trn-doc.discnt-type = 'прво':U
      338   :
      339     find first price-doc no-lock
      340       where ub.price-doc.doc-num = ub.trn-doc.doc-code
      341       no-error .
      342     if not available price-doc then do:
      343       find first ub.price-doc no-lock
      344         where ub.price-doc.obj-type = ub.trn-doc.obj-type
      345           and ub.price-doc.obj-code = ub.trn-doc.obj-code
      346           and ub.price-doc.fact-num = ub.trn-doc.fact-num + 1
      347         no-error .
      348     end.
      349     if available price-doc
      350     and price-doc.PS   = "@  Переоценка по приходу. Продажные цены устанавливаются = приходным."
      351     and price-doc.status_ = 'акт':U
      352     and price-doc.fact-num > trn-doc.fact-num
      353     then do:
      354       define variable l-find-goods as logical no-undo .
      355       assign
      356         l-find-goods = false
      357       .
      358       for each ub.price-list no-lock
      359         where ub.price-list.doc-num = ub.price-doc.doc-num
      360       :
      361         find first ub.doc-line no-lock
      362           where ub.doc-line.doc-code  = ub.trn-doc.doc-code
      363             and ub.doc-line.artic     = ub.price-list.artic
      364             and ub.doc-line.prod-type = ub.price-list.prod-type
      365             and ub.doc-line.prod-code = ub.price-list.prod-code
      366           no-error .
      367         if available ub.doc-line then do:
      368           assign
      369             l-find-goods = true
      370           .
      371           leave .
      372         end.
      373       end.
      374       if available price-doc
      375       and l-find-goods then do:
      376         assign
      377           i-err-count = i-err-count + 1
      378         .
      379         output to chk-trn.txt append .
      380         run cur-time in this-procedure ( output v-today
      381                                        , output v-time
      382                                        ).
      383         export
      384           string(v-today) string(v-time, "hh:mm") trn-doc.doc-code trn-doc.fact-num
      385           price-doc.doc-num price-doc.fact-num
      386           .
      387         output close .
      388         if l-fix-documents = true then do:
      389           do transaction
      390           on error undo, next
      391           on stop  undo, return
      392           :
      393             define variable v-new-trn-doc-fact-num   like ub.trn-doc.fact-num no-undo .
      394             define variable v-new-price-doc-fact-num like ub.price-doc.fact-num no-undo .
      395             assign
      396               v-new-trn-doc-fact-num   = ub.price-doc.fact-num
      397               v-new-price-doc-fact-num = ub.trn-doc.fact-num
      398             .
      399             output to chk-trn.fix append .
      400             run cur-time in this-procedure ( output v-today
      401                                            , output v-time
      402                                            ).
      403             export
      404               string(v-today) string(v-time, "hh:mm") "trn-doc_old-fact-num_new-fact-num":u
      405               ub.trn-doc.doc-code ub.trn-doc.fact-num v-new-trn-doc-fact-num
      406               .
      407             export
      408               string(v-today) string(v-time, "hh:mm") "price-doc_old-fact-num_new-fact-num":u
      409               ub.price-doc.doc-num ub.price-doc.fact-num v-new-price-doc-fact-num
      410               .
      411             output close .
      412             run utl/fctnumch.p
      413               (input ub.trn-doc.doc-code
      414               ,input 'trn-doc':U
      415               ,input v-new-trn-doc-fact-num
      416               ,input l-log-fact-num-change
      417               ).
      418             run utl/fctnumch.p
      419               (input ub.price-doc.doc-num
      420               ,input 'price-doc':U
      421               ,input v-new-price-doc-fact-num
      422               ,input l-log-fact-num-change
      423               ).
      424           end.
      425         end.
      426       end.
      427     end.
      428   end.
      429   if p-install = false then do:
      430     if i-err-count <> 0 then do:
      431       message
      432         "Просмотр документов и переоценок закончен" skip
      433         "Найдено" i-err-count "ошибок" skip
      434         ""
      435         ( if l-fix-documents
      436           then "Документы были исправлены"
      437           else "Документы не были исправлены"
      438         ) skip
      439         view-as alert-box error  .
      440     end.
      441     else do:
      442       message
      443         "Просмотр документов и переоценок закончен" skip
      444         "Ошибок не найдено" skip
      445         view-as alert-box information .
      446     end.
      447   end.
