      374   procedure arhisatr_encode-attr :
      375     define input  parameter p-attr-calc        as logical   no-undo .
      376     define input  parameter p-attr-del         as logical   no-undo .
      377     define input  parameter p-attr-disable     as logical   no-undo .
      378     define input  parameter p-attr-rest        as logical   no-undo .
      379     define output parameter p-attr-encode-calc as logical   no-undo .
      380     define output parameter p-attr-encode-del  as logical   no-undo .
      381     define output parameter p-attr-encode-ps   as character no-undo .
      382     do
      383     on error undo, return error return-value
      384     :
      385       if p-attr-calc = ?
      386       then do:
      387         message
      388           vss-workfile vss-revision vss-description skip
      389           "Внутренняя ошибка" skip
      390           "Атрибут 'Рассчёт архива' имеет неопределённое значение" skip
      391           view-as alert-box error .
      392         undo, return error return-value .
      393       end.
      394       if p-attr-del = ?
      395       then do:
      396         message
      397           vss-workfile vss-revision vss-description skip
      398           "Внутренняя ошибка" skip
      399           "Атрибут 'Требуется первоначальный расчёт архива' имеет неопределённое значение" skip
      400           view-as alert-box error .
      401         undo, return error return-value .
      402       end.
      403       if p-attr-disable = ?
      404       then do:
      405         message
      406           vss-workfile vss-revision vss-description skip
      407           "Внутренняя ошибка" skip
      408           "Атрибут 'Расчет архива выключен' имеет неопределённое значение" skip
      409           view-as alert-box error .
      410         undo, return error return-value .
      411       end.
      412       if p-attr-rest = ?
      413       then do:
      414         message
      415           vss-workfile vss-revision vss-description skip
      416           "Внутренняя ошибка" skip
      417           "Атрибут 'Удаление восстановление архива' имеет неопределённое значение" skip
      418           view-as alert-box error .
      419         undo, return error return-value .
      420       end.
      421       define variable v-total-value    as integer   no-undo .
      422       define variable v-encode-value-1 as integer   no-undo .
      423       define variable v-encode-value-2 as integer   no-undo .
      424       assign
      425         v-total-value = (if p-attr-calc
      426                          then 1
      427                          else 0
      428                         )
      429                         +
      430                         (if p-attr-del
      431                          then 2
      432                          else 0
      433                         )
      434                         +
      435                         (if p-attr-rest
      436                          then 4
      437                          else 0
      438                         )
      439       .
      440       assign
      441         v-encode-value-1 = truncate(v-total-value / 3, 0)
      442         v-encode-value-2 = v-total-value modulo 3
      443       .
      444       case v-encode-value-1
      445       :
      446         when 0
      447         then do:
      448           assign
      449             p-attr-encode-calc = false
      450           .
      451         end.
      452         when 1
      453         then do:
      454           assign
      455             p-attr-encode-calc = true
      456           .
      457         end.
      458         when 2
      459         then do:
      460           assign
      461             p-attr-encode-calc = ?
      462           .
      463         end.
      464         otherwise do:
      465           message
      466             vss-workfile vss-revision vss-description skip
      467             "Внутренняя ошибка" skip
      468             "Неизвестное значение v-encode-value-1" v-encode-value-1 skip
      469             view-as alert-box error .
      470           undo, return error return-value .
      471         end.
      472       end case .
      473       case v-encode-value-2
      474       :
      475         when 0
      476         then do:
      477           assign
      478             p-attr-encode-del = false
      479           .
      480         end.
      481         when 1
      482         then do:
      483           assign
      484             p-attr-encode-del = true
      485           .
      486         end.
      487         when 2
      488         then do:
      489           assign
      490             p-attr-encode-del = ?
      491           .
      492         end.
      493         otherwise do:
      494           message
      495             vss-workfile vss-revision vss-description skip
      496             "Внутренняя ошибка" skip
      497             "Неизвестное значение v-encode-value-2" v-encode-value-2 skip
      498             view-as alert-box error .
      499           undo, return error return-value .
      500         end.
      501       end case .
      502       assign
      503         p-attr-encode-ps = string(p-attr-disable)
      504       .
      505       define variable v-check-p-attr-calc    as logical   no-undo .
      506       define variable v-check-p-attr-del     as logical   no-undo .
      507       define variable v-check-p-attr-disable as logical   no-undo .
      508       define variable v-check-p-attr-rest    as logical   no-undo .
      509       run arhisatr_decode-attr in this-procedure
      510         (input  p-attr-encode-calc
      511         ,input  p-attr-encode-del
      512         ,input  p-attr-encode-ps
      513         ,output v-check-p-attr-calc
      514         ,output v-check-p-attr-del
      515         ,output v-check-p-attr-disable
      516         ,output v-check-p-attr-rest
      517         ) .
      518       if p-attr-calc    <> v-check-p-attr-calc
      519       or p-attr-del     <> v-check-p-attr-del
      520       or p-attr-disable <> v-check-p-attr-disable
      521       or p-attr-rest    <> v-check-p-attr-rest
      522       then do:
      523         message
      524           vss-workfile vss-revision vss-description skip
      525           "Внутренняя ошибка" skip
      526           "Не совпадают раскодированные значения" skip
      527           "p-attr-calc"    p-attr-calc    skip
      528           "p-attr-del"     p-attr-del     skip
      529           "p-attr-disable" p-attr-disable skip
      530           "p-attr-rest"    p-attr-rest    skip
      531           "v-check-p-attr-calc"    v-check-p-attr-calc    skip
      532           "v-check-p-attr-del"     v-check-p-attr-del     skip
      533           "v-check-p-attr-disable" v-check-p-attr-disable skip
      534           "v-check-p-attr-rest"    v-check-p-attr-rest    skip
      535           view-as alert-box error .
      536         undo, return error return-value .
      537       end.
      538     end.
      539   end procedure.
      540   procedure arhisatr_decode-attr :
      541     define input  parameter p-attr-decode-calc as logical   no-undo .
      542     define input  parameter p-attr-decode-del  as logical   no-undo .
      543     define input  parameter p-attr-decode-ps   as character no-undo .
      544     define output parameter p-attr-calc        as logical   no-undo .
      545     define output parameter p-attr-del         as logical   no-undo .
      546     define output parameter p-attr-disable     as logical   no-undo .
      547     define output parameter p-attr-rest        as logical   no-undo .
      548     do
      549     on error undo, return error return-value
      550     :
      551       define variable v-total-value    as integer   no-undo .
      552       define variable v-encode-value-1 as integer   no-undo .
      553       define variable v-encode-value-2 as integer   no-undo .
      554       case p-attr-decode-calc
      555       :
      556         when false
      557         then do:
      558           assign
      559             v-encode-value-1 = 0
      560           .
      561         end.
      562         when true
      563         then do:
      564           assign
      565             v-encode-value-1 = 1
      566           .
      567         end.
      568         when ?
      569         then do:
      570           assign
      571             v-encode-value-1 = 2
      572           .
      573         end.
      574         otherwise do:
      575           message
      576             vss-workfile vss-revision vss-description skip
      577             "Внутренняя ошибка" skip
      578             "Неизвестное значение p-attr-decode-calc" p-attr-decode-calc skip
      579             view-as alert-box error .
      580           undo, return error return-value .
      581         end.
      582       end case .
      583       case p-attr-decode-del
      584       :
      585         when false
      586         then do:
      587           assign
      588             v-encode-value-2 = 0
      589           .
      590         end.
      591         when true
      592         then do:
      593           assign
      594             v-encode-value-2 = 1
      595           .
      596         end.
      597         when ?
      598         then do:
      599           assign
      600             v-encode-value-2 = 2
      601           .
      602         end.
      603         otherwise do:
      604           message
      605             vss-workfile vss-revision vss-description skip
      606             "Внутренняя ошибка" skip
      607             "Неизвестное значение p-attr-decode-del" p-attr-decode-del skip
      608             view-as alert-box error .
      609           undo, return error return-value .
      610         end.
      611       end case .
      612       assign
      613         v-total-value = v-encode-value-1 * 3
      614                       + v-encode-value-2
      615       .
      616       define variable v-decode-value-1 as integer   no-undo .
      617       define variable v-decode-value-2 as integer   no-undo .
      618       define variable v-decode-value-3 as integer   no-undo .
      619       assign
      620         v-decode-value-1 = v-total-value modulo 2
      621       .
      622       assign
      623         v-total-value = truncate(v-total-value / 2, 0)
      624       .
      625       assign
      626         v-decode-value-2 = v-total-value modulo 2
      627       .
      628       assign
      629         v-total-value = truncate(v-total-value / 2, 0)
      630       .
      631       assign
      632         v-decode-value-3 = v-total-value
      633       .
      634       case v-decode-value-1
      635       :
      636         when 0
      637         then do:
      638           assign
      639             p-attr-calc = false
      640           .
      641         end.
      642         when 1
      643         then do:
      644           assign
      645             p-attr-calc = true
      646           .
      647         end.
      648         otherwise do:
      649           message
      650             vss-workfile vss-revision vss-description skip
      651             "Внутренняя ошибка" skip
      652             "Неизвестное значение v-decode-value-1" v-decode-value-1 skip
      653             view-as alert-box error .
      654           undo, return error return-value .
      655         end.
      656       end case .
      657       case v-decode-value-2
      658       :
      659         when 0
      660         then do:
      661           assign
      662             p-attr-del = false
      663           .
      664         end.
      665         when 1
      666         then do:
      667           assign
      668             p-attr-del = true
      669           .
      670         end.
      671         otherwise do:
      672           message
      673             vss-workfile vss-revision vss-description skip
      674             "Внутренняя ошибка" skip
      675             "Неизвестное значение v-decode-value-2" v-decode-value-2 skip
      676             view-as alert-box error .
      677           undo, return error return-value .
      678         end.
      679       end case .
      680       case v-decode-value-3
      681       :
      682         when 0
      683         then do:
      684           assign
      685             p-attr-rest = false
      686           .
      687         end.
      688         when 1
      689         then do:
      690           assign
      691             p-attr-rest = true
      692           .
      693         end.
      694         otherwise do:
      695           message
      696             vss-workfile vss-revision vss-description skip
      697             "Внутренняя ошибка" skip
      698             "Неизвестное значение v-decode-value-3" v-decode-value-3 skip
      699             view-as alert-box error .
      700           undo, return error return-value .
      701         end.
      702       end case .
      703       assign
      704         p-attr-disable = lookup(p-attr-decode-ps, 'true,yes':u) > 0
      705       .
      706     end.
      707   end procedure.
      708   function arhisatr_get-calc returns logical
      709   (input p-attr-decode-calc as logical
      710   ,input p-attr-decode-del  as logical
      711   ,input p-attr-decode-ps   as character
      712   )
      713   :
      714     define variable v-attr-calc    as logical   no-undo .
      715     define variable v-attr-del     as logical   no-undo .
      716     define variable v-attr-disable as logical   no-undo .
      717     define variable v-attr-rest    as logical   no-undo .
      718     run arhisatr_decode-attr in this-procedure
      719       (input  p-attr-decode-calc
      720       ,input  p-attr-decode-del
      721       ,input  p-attr-decode-ps
      722       ,output v-attr-calc
      723       ,output v-attr-del
      724       ,output v-attr-disable
      725       ,output v-attr-rest
      726       ) .
      727     return v-attr-calc .
      728   end function .
      729   function arhisatr_get-del returns logical
      730   (input p-attr-decode-calc as logical
      731   ,input p-attr-decode-del  as logical
      732   ,input p-attr-decode-ps   as character
      733   )
      734   :
      735     define variable v-attr-calc    as logical   no-undo .
      736     define variable v-attr-del     as logical   no-undo .
      737     define variable v-attr-disable as logical   no-undo .
      738     define variable v-attr-rest    as logical   no-undo .
      739     run arhisatr_decode-attr in this-procedure
      740       (input  p-attr-decode-calc
      741       ,input  p-attr-decode-del
      742       ,input  p-attr-decode-ps
      743       ,output v-attr-calc
      744       ,output v-attr-del
      745       ,output v-attr-disable
      746       ,output v-attr-rest
      747       ) .
      748     return v-attr-del .
      749   end function .
      750   function arhisatr_get-disable returns logical
      751   (input p-attr-decode-calc as logical
      752   ,input p-attr-decode-del  as logical
      753   ,input p-attr-decode-ps   as character
      754   )
      755   :
      756     define variable v-attr-calc    as logical   no-undo .
      757     define variable v-attr-del     as logical   no-undo .
      758     define variable v-attr-disable as logical   no-undo .
      759     define variable v-attr-rest    as logical   no-undo .
      760     run arhisatr_decode-attr in this-procedure
      761       (input  p-attr-decode-calc
      762       ,input  p-attr-decode-del
      763       ,input  p-attr-decode-ps
      764       ,output v-attr-calc
      765       ,output v-attr-del
      766       ,output v-attr-disable
      767       ,output v-attr-rest
      768       ) .
      769     return v-attr-disable .
      770   end function .
      771   function arhisatr_get-rest returns logical
      772   (input p-attr-decode-calc as logical
      773   ,input p-attr-decode-del  as logical
      774   ,input p-attr-decode-ps   as character
      775   )
      776   :
      777     define variable v-attr-calc    as logical   no-undo .
      778     define variable v-attr-del     as logical   no-undo .
      779     define variable v-attr-disable as logical   no-undo .
      780     define variable v-attr-rest    as logical   no-undo .
      781     run arhisatr_decode-attr in this-procedure
      782       (input  p-attr-decode-calc
      783       ,input  p-attr-decode-del
      784       ,input  p-attr-decode-ps
      785       ,output v-attr-calc
      786       ,output v-attr-del
      787       ,output v-attr-disable
      788       ,output v-attr-rest
      789       ) .
      790     return v-attr-rest .
      791   end function .
      792   define buffer buf_archive-history for ub.archive-history .
      793   do
      794   on error undo, return error return-value
      795   :
      796     define variable v-chip-num as integer   no-undo .
      797     find last buf_archive-history exclusive-lock
      798       where buf_archive-history.obj-type     = p-obj-type
      799         and buf_archive-history.obj-code     = p-obj-code
      800         and buf_archive-history.archive-type = p-archive-type
      801       use-index pi
      802       no-error .
      803     if available buf_archive-history
      804     then do:
      805       assign
      806         v-chip-num = buf_archive-history.chip-num + 1
      807       .
      808     end.
      809     else do:
      810       assign
      811         v-chip-num = 1
      812       .
      813     end.
      814     if  p-file-name <> ""
      815     and p-file-name <> ?
      816     then do:
      817       for each buf_archive-history exclusive-lock
      818         where buf_archive-history.obj-type     = p-obj-type
      819           and buf_archive-history.obj-code     = p-obj-code
      820           and buf_archive-history.archive-type = p-archive-type
      821           and buf_archive-history.file-valid   = true
      822           and buf_archive-history.file-name    = p-file-name
      823       on error undo, return error return-value
      824       :
      825         assign
      826           buf_archive-history.file-valid            = false
      827           buf_archive-history.file-invalid-chip-num = v-chip-num
      828         .
      829       end.
      830     end.
      831     assign
      832       p-create-chip-num = v-chip-num
      833     .
      834     create buf_archive-history .
      835     assign
      836       buf_archive-history.obj-type     = p-obj-type
      837       buf_archive-history.obj-code     = p-obj-code
      838       buf_archive-history.archive-type = p-archive-type
      839       buf_archive-history.chip-num     = v-chip-num
      840       buf_archive-history.action-type  = p-action-type
      841     .
      842     define variable v-attr-name-calc        as character no-undo .
      843     define variable v-attr-name-del         as character no-undo .
      844     define variable v-attr-name-rest        as character no-undo .
      845     define variable v-attr-name-start-date  as character no-undo .
      846     define variable v-attr-name-detail-date as character no-undo .
      847     define variable v-attr-name-recalc-date as character no-undo .
      848     define variable v-attr-value as character no-undo .
      849     define variable v-attr-type  as character no-undo .
      850     define variable v-arh-calc        as logical   no-undo .
      851     define variable v-arh-del         as logical   no-undo .
      852     define variable v-arh-disable     as logical   no-undo .
      853     define variable v-arh-rest        as logical   no-undo .
      854     define variable v-arh-start-date  as date      no-undo .
      855     define variable v-arh-detail-date as date      no-undo .
      856     define variable v-arh-recalc-date as date      no-undo .
      857     run get-attr-name in this-procedure
      858       (input  p-archive-type
      859       ,output v-attr-name-calc
      860       ,output v-attr-name-del
      861       ,output v-attr-name-rest
      862       ,output v-attr-name-start-date
      863       ,output v-attr-name-detail-date
      864       ,output v-attr-name-recalc-date
      865       ) .
      866     run clntattr-value in this-procedure
      867       (input  p-obj-type
      868       ,input  p-obj-code
      869       ,input  v-attr-name-calc
      870       ,output v-attr-value
      871       ,output v-attr-type
      872       ) .
      873     assign
      874       v-arh-calc = (lookup(v-attr-value, 'yes,true') > 0)
      875     .
      876     run clntattr-value in this-procedure
      877       (input  p-obj-type
      878       ,input  p-obj-code
      879       ,input  v-attr-name-del
      880       ,output v-attr-value
      881       ,output v-attr-type
      882       ) .
      883     assign
      884       v-arh-del = (lookup(v-attr-value, 'yes,true') > 0)
      885     .
      886     run clntattr-value in this-procedure
      887       (input  p-obj-type
      888       ,input  p-obj-code
      889       ,input  v-attr-name-rest
      890       ,output v-attr-value
      891       ,output v-attr-type
      892       ) .
      893     assign
      894       v-arh-rest = (lookup(v-attr-value, 'yes,true') > 0)
      895     .
      896     run clntattr-value in this-procedure
      897       (input  p-obj-type
      898       ,input  p-obj-code
      899       ,input  v-attr-name-start-date
      900       ,output v-attr-value
      901       ,output v-attr-type
      902       ) .
      903     assign
      904       v-arh-start-date = date(v-attr-value)
      905     .
      906     run clntattr-value in this-procedure
      907       (input  p-obj-type
      908       ,input  p-obj-code
      909       ,input  v-attr-name-detail-date
      910       ,output v-attr-value
      911       ,output v-attr-type
      912       ) .
      913     assign
      914       v-arh-detail-date = date(v-attr-value)
      915     .
      916     run clntattr-value in this-procedure
      917       (input  p-obj-type
      918       ,input  p-obj-code
      919       ,input  v-attr-name-recalc-date
      920       ,output v-attr-value
      921       ,output v-attr-type
      922       ) .
      923     assign
      924       v-arh-recalc-date = date(v-attr-value)
      925     .
      926     run arhisatr_encode-attr in this-procedure
      927       (input  v-arh-calc
      928       ,input  v-arh-del
      929       ,input  v-arh-disable
      930       ,input  v-arh-rest
      931       ,output buf_archive-history.archive-calc
      932       ,output buf_archive-history.archive-del
      933       ,output buf_archive-history.ps
      934       ) .
      935     assign
      936       buf_archive-history.archive-start-date  = v-arh-start-date
      937       buf_archive-history.archive-detail-date = v-arh-detail-date
      938       buf_archive-history.archive-recalc-date = v-arh-recalc-date
      939     .
      940   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
      942     (output buf_archive-history.corr-user-db-num
      943     ,output buf_archive-history.corr-user-name
      944     ,output buf_archive-history.corr-date
      945     ,output buf_archive-history.corr-time-str
      946     ,output buf_archive-history.corr-time
      947     )  .
      948     if  p-file-name <> ""
      949     and p-file-name <> ?
      950     then do:
      951       assign
      952         buf_archive-history.file-name  = p-file-name
      953         buf_archive-history.file-md5   = p-file-md5
      954         buf_archive-history.file-valid = true
      955       .
      956     end.
      957     assign
      958       buf_archive-history.file-invalid-chip-num = p-file-invalid-chip-num
      959       buf_archive-history.source-type           = p-source-type
      960       buf_archive-history.source-ref            = p-source-ref
      961       buf_archive-history.source-date           = p-source-date
      962     .
      963   end.
      964   procedure get-attr-name :
      965     define input  parameter p-archive-type          as character no-undo .
      966     define output parameter p-attr-name-calc        as character no-undo .
      967     define output parameter p-attr-name-del         as character no-undo .
      968     define output parameter p-attr-name-rest        as character no-undo .
      969     define output parameter p-attr-name-start-date  as character no-undo .
      970     define output parameter p-attr-name-detail-date as character no-undo .
      971     define output parameter p-attr-name-recalc-date as character no-undo .
      972     do
      973     on error undo, return error return-value
      974     :
      975       case p-archive-type
      976       :
      977         when 'arh':U
      978         then do:
      979           assign
      980             p-attr-name-calc        = 'arh-calc':U
      981             p-attr-name-del         = 'arh-del':U
      982             p-attr-name-rest        = 'arh-rest':U
      983             p-attr-name-start-date  = 'arh-start':U
      984             p-attr-name-detail-date = 'arh-detail':U
      985             p-attr-name-recalc-date = 'arh-recalc':U
      986           .
      987         end.
      988         when 'ahsp':U
      989         then do:
      990           assign
      991             p-attr-name-calc        = 'ahsp-calc':U
      992             p-attr-name-del         = 'ahsp-del':U
      993             p-attr-name-rest        = 'ahsp-rest':U
      994             p-attr-name-start-date  = 'ahsp-start':U
      995             p-attr-name-detail-date = 'ahsp-detail':U
      996             p-attr-name-recalc-date = 'ahsp-recalc':U
      997           .
      998         end.
      999         when 'aht':U
     1000         then do:
     1001           assign
     1002             p-attr-name-calc        = 'aht-calc':U
     1003             p-attr-name-del         = 'aht-del':U
     1004             p-attr-name-rest        = 'aht-rest':U
     1005             p-attr-name-start-date  = 'aht-start':U
     1006             p-attr-name-detail-date = 'aht-detail':U
     1007             p-attr-name-recalc-date = 'aht-recalc':U
     1008           .
     1009         end.
     1010         otherwise do:
     1011           message
     1012             vss-workfile vss-revision vss-description skip
     1013             "Неизвестное значение параметра тип архива" skip
     1014             "Тип архива" p-archive-type skip
     1015             view-as alert-box error .
     1016           undo, return error return-value .
     1017         end.
     1018       end case .
     1019     end.
     1020   end procedure.
