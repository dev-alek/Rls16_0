        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 120b44b64ef4, 1863, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: druban $":U .
        4   define variable vss-date        as character no-undo init "$Date: Wed May 08 13:02:45 2019 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: set-range-bcgb.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/set-range-bcgb.p $":U .
        7   define variable vss-description as character no-undo init "Установка диапазона дя товаров с 1с".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable mParams as character no-undo.
       69   define buffer bufcode-range    for code-range.
       70   define variable mMax as int64 no-undo.
       71   mParams = trim(session:parameter,'"').
       72     if dynamic-current-value( "s-bcgb-code", "ub" ) > 1000000000 then return.
       73     define variable conf-par as character no-undo.
       74     define variable mode-erprn as logical no-undo.
       75     define variable par-type as character no-undo.
       76   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
       77     (input  'is-erpRN'
       78     ,input  0
       79     ,input  ''
       80     ,input  0
       81     ,input  ''
       82     ,input  ''
       83     ,input  ''
       84     ,input  NO
       85     ,output conf-par
       86     ,output par-type
       87     ) no-error .
       88       if not error-status:error and conf-par = "yes":U then mode-erprn = yes.
       89       if not mode-erprn then return.
       90       find first sys-ctrl no-lock no-error.
       91       disable triggers for load of code-range.
       92       find code-range no-lock
       93           where code-range.range-type = 'bcgb':U
       94           and code-range.db-num     = sys-ctrl.db-num
       95           and code-range.stts       = "a":U
       96         no-error
       97       .
       98       if     available code-range
       99          and code-range.first-code >= 1000000000
      100       then return.
      101       find code-range exclusive-lock
      102           where code-range.range-type = 'bcgb':U
      103           and code-range.db-num     = sys-ctrl.db-num
      104           and code-range.stts       = "a":U
      105         no-error
      106       .
      107       create bufcode-range.
      108       buffer-copy code-range to bufcode-range
      109       assign
      110          bufcode-range.last-code  = if code-range.last-code > 1000000000 then code-range.last-code else 2000000000
      111          bufcode-range.first-code = 1000000000.
      112       assign
      113          code-range.last-code     = 1000000000 - 1
      114          code-range.stts          = "u":U
      115          .
      116       if code-range.first-code eq  1
      117       then
      118          code-range.first-code = 100000.
      119       dynamic-current-value( "s-bcgb-code", "ub" ) = 1000000000.
      120       finally:
      121          quit.
      122       end finally.
