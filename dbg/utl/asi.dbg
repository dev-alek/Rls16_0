      399        fnompres AT ROW 9 COL 36.5 COLON-ALIGNED WIDGET-ID 28
      400       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
      401            SIDE-LABELS NO-UNDERLINE THREE-D
      402            AT COL 1.5 ROW 23.5
      403            SIZE 66.5 BY 10.75
      404            TITLE "Параметры резервуарного парка" WIDGET-ID 600.
      405   DEFINE FRAME FRAME-B
      406        BROWSE-3 AT ROW 1.5 COL 2 WIDGET-ID 300
      407        bt-add AT ROW 5.5 COL 2 WIDGET-ID 10
      408        bt-del AT ROW 5.5 COL 13.5 WIDGET-ID 12
      409        bt-edit AT ROW 5.5 COL 25 WIDGET-ID 14
      410        ftypeasi AT ROW 6.75 COL 19 COLON-ALIGNED WIDGET-ID 20
      411        fSlaveId AT ROW 6.75 COL 47 COLON-ALIGNED WIDGET-ID 24
      412        fCom AT ROW 8 COL 11 COLON-ALIGNED WIDGET-ID 16
      413        fchet AT ROW 8 COL 40 COLON-ALIGNED WIDGET-ID 8
      414        fbit AT ROW 9.25 COL 40 COLON-ALIGNED WIDGET-ID 10
      415        fportasi AT ROW 9.26 COL 40 COLON-ALIGNED WIDGET-ID 10
      416        fspeed AT ROW 9.25 COL 11 COLON-ALIGNED WIDGET-ID 18
      417        fipasi AT ROW 9.3 COL 11 COLON-ALIGNED WIDGET-ID 8
      418        TOut AT ROW 10.5 COL 40 COLON-ALIGNED WIDGET-ID 6
      419        fSpec AT ROW 11.6 COL 15 COLON-ALIGNED WIDGET-ID 10
      420       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
      421            SIDE-LABELS NO-UNDERLINE THREE-D
      422            AT COL 1.5 ROW 10.5
      423            SIZE 66.5 BY 12.75
      424            TITLE "Параметры подключения" WIDGET-ID 400.
      425   DEFINE FRAME FRAME-A
      426        fip AT ROW 1.25 COL 10 COLON-ALIGNED WIDGET-ID 4
      427        ftype AT ROW 1.25 COL 44.5 COLON-ALIGNED WIDGET-ID 8
      428        FPort AT ROW 2.75 COL 10 COLON-ALIGNED WIDGET-ID 6
      429        tlive AT ROW 4 COL 50.5 COLON-ALIGNED WIDGET-ID 6
      430        rfrtime AT ROW 5.25 COL 50.5 COLON-ALIGNED WIDGET-ID 6
      431       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
      432            SIDE-LABELS NO-UNDERLINE THREE-D
      433            AT COL 1.5 ROW 3.75
      434            SIZE 66.5 BY 6.5
      435            TITLE "Параметры для внешних запросов" WIDGET-ID 200.
      436   ASSIGN FRAME FRAME-A:FRAME = FRAME Dialog-Frame:HANDLE
      437          FRAME FRAME-B:FRAME = FRAME Dialog-Frame:HANDLE
      438          FRAME FRAME-C:FRAME = FRAME Dialog-Frame:HANDLE.
      439   DEFINE VARIABLE XXTABVALXX AS LOGICAL NO-UNDO.
      440   ASSIGN XXTABVALXX = FRAME FRAME-A:MOVE-AFTER-TAB-ITEM (btloabfile:HANDLE IN FRAME Dialog-Frame)
      441          XXTABVALXX = FRAME FRAME-B:MOVE-BEFORE-TAB-ITEM (FRAME FRAME-C:HANDLE)
      442          XXTABVALXX = FRAME FRAME-A:MOVE-BEFORE-TAB-ITEM (FRAME FRAME-B:HANDLE)
      443   .
      444   ASSIGN
      445          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      446          FRAME Dialog-Frame:HIDDEN           = TRUE.
      447   ASSIGN
      448          fbit:HIDDEN IN FRAME FRAME-B           = TRUE.
      449   ASSIGN
      450          fchet:HIDDEN IN FRAME FRAME-B           = TRUE.
      451   ASSIGN
      452          fCom:HIDDEN IN FRAME FRAME-B           = TRUE.
      453   ASSIGN
      454          fspeed:HIDDEN IN FRAME FRAME-B           = TRUE.
      455   ON window-close OF FRAME Dialog-Frame
      456   do:
      457     apply "END-ERROR":U to self.
      458   end.
      459   ON value-changed OF BROWSE-3 IN FRAME FRAME-B
      460   do:
      461     if available tt-asi
      462     then do:
      463        assign
      464            ftypeasi:screen-value in frame FRAME-B = tt-asi.parent
      465            fCom    :screen-value in frame FRAME-B = tt-asi.code
      466            .
      467        apply  "VALUE-CHANGED" to ftypeasi in frame FRAME-B.
      468        apply  "VALUE-CHANGED" to fCom     in frame FRAME-B.
      469        assign
      470            fspeed  :screen-value in frame FRAME-B = tt-asi.Misc1
      471            fchet   :screen-value in frame FRAME-B = tt-asi.Misc2
      472            fbit    :screen-value in frame FRAME-B = tt-asi.Misc3
      473            fipasi  :screen-value in frame FRAME-B = tt-asi.misc5
      474            fportasi:screen-value in frame FRAME-B = tt-asi.misc6
      475            fSlaveId:screen-value in frame FRAME-B = tt-asi.misc7
      476            TOut:screen-value in frame FRAME-B = tt-asi.misc9
      477            fSpec:screen-value in frame FRAME-B = tt-asi.misc10
      478            .
      479           OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
      480          apply  "VALUE-CHANGED" to BROWSE-5 in frame FRAME-C.
      481      end.
      482   end.
      483   ON value-changed OF BROWSE-5 IN FRAME FRAME-C
      484   do:
      485     if available tt-tank
      486     then assign
      487          Faddr:screen-value = tt-tank.code
      488          Fcoor:screen-value = tt-tank.CodeValue
      489          fnompres:screen-value = if tt-tank.misc1 eq "" then "1" else tt-tank.misc1
      490          .
      491   end.
      492   ON CHOOSE OF bsavefile IN FRAME Dialog-Frame
      493   DO:
      494      define variable v-file-name as character no-undo.
      495      define variable vok as logical no-undo.
      496      SYSTEM-DIALOG GET-FILE v-file-name
      497           TITLE "Выберите файл для экспорта"
      498           FILTERS
      499             " Файл реестра(*.reg) " "*.reg",
      500             " Все файлы (*.*) "                      "*.*"
      501           ask-overwrite
      502           save-as
      503           use-filename
      504           update vok
      505           default-extension "txt"
      506           .
      507       IF vok THEN do:
      508          run proc-save (v-file-name).
      509       end.
      510   END.
      511   ON value-changed OF fSpec IN FRAME FRAME-B
      512   do:
      513     if available tt-asi and tt-asi.parent = "Modbus" then tt-asi.misc10 = fSpec:screen-value in frame FRAME-B.
      514   end.
      515   ON choose OF bt-add IN FRAME FRAME-B
      516   do:
      517     define buffer tt-asi_buf for tt-asi.
      518     if    ftypeasi:screen-value eq ?
      519        or fCom    :screen-value eq ?
      520     then do:
      521        message ftypeasi:label " и "  fCom:label "должны быть заполнены"
      522        view-as alert-box.
      523        return no-apply.
      524     end.
      525     if fCom    :screen-value in frame FRAME-B eq "Ethernet"
      526     then do:
      527        find first tt-asi_buf where tt-asi_buf.misc5 = fipasi      :screen-value in frame FRAME-B
      528                                and tt-asi_buf.misc6 = fportasi    :screen-value in frame FRAME-B
      529                           no-lock no-error.
      530        if available tt-asi_buf
      531        then do:
      532           message "Уже есть запись с тип IP "  tt-asi.misc5 " Порт " tt-asi.misc6
      533           view-as alert-box.
      534           return no-apply.
      535        end.
      536     end.
      537     else do:
      538        find first tt-asi_buf where tt-asi_buf.parent = ftypeasi:screen-value in frame FRAME-B
      539                                and tt-asi_buf.code   = fCom    :screen-value in frame FRAME-B
      540                           no-lock no-error.
      541        if available tt-asi_buf
      542        then do:
      543           message "Уже есть запись с тип АСИ "  tt-asi_buf.parent " Порт " tt-asi_buf.code
      544           view-as alert-box.
      545           return no-apply.
      546        end.
      547     end.
      548     create tt-asi.
      549     assign
      550        tt-asi.parent = ftypeasi:screen-value in frame FRAME-B
      551        tt-asi.code   = fCom    :screen-value in frame FRAME-B
      552        tt-asi.Misc1  = fspeed  :screen-value in frame FRAME-B when not fCom    :screen-value in frame FRAME-B eq "Ethernet"
      553        tt-asi.Misc2  = fchet   :screen-value in frame FRAME-B when not fCom    :screen-value in frame FRAME-B eq "Ethernet"
      554        tt-asi.Misc3  = fbit    :screen-value in frame FRAME-B when not fCom    :screen-value in frame FRAME-B eq "Ethernet"
      555        tt-asi.misc5  = fipasi  :screen-value in frame FRAME-B
      556        tt-asi.misc6  = fportasi:screen-value in frame FRAME-B
      557        tt-asi.misc7  = fSlaveId:screen-value in frame FRAME-B
      558        tt-asi.misc9  = TOut:screen-value in frame FRAME-B
      559        tt-asi.misc10   = (if ftypeasi:screen-value in frame FRAME-B = "Modbus"  then fSpec:screen-value in frame FRAME-B else "")
      560        .
      561     OPEN QUERY BROWSE-3 FOR EACH tt-asi NO-LOCK INDEXED-REPOSITION.
      562     apply  "VALUE-CHANGED" to BROWSE-3 in frame FRAME-B.
      563     OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
      564     apply  "VALUE-CHANGED" to BROWSE-5 in frame FRAME-C.
      565   end.
      566   ON choose OF bt-add-2 IN FRAME FRAME-C
      567   do:
      568     if available tt-asi
      569     then do:
      570        define buffer tt-tank_buf for tt-tank.
      571        if    Faddr:screen-value eq ?
      572           or Fcoor:screen-value eq ?
      573        then do:
      574           message Faddr:label " и "  Fcoor:label "должны быть заполнены"
      575           view-as alert-box.
      576           return no-apply.
      577        end.
      578        find first tt-tank_buf where tt-tank_buf.parent    = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6
      579                                 and tt-tank_buf.code      = Faddr:screen-value
      580        no-lock no-error.
      581        if available tt-tank_buf
      582        then
      583           message
      584           "Уже есть адрес " tt-tank_buf.code " для " tt-asi.parent tt-asi.code
      585           view-as alert-box.
      586        else do:
      587           find first tt-tank_buf where tt-tank_buf.CodeValue = Fcoor:screen-value
      588           no-lock no-error.
      589           if available tt-tank_buf
      590           then
      591              message
      592                "Уже есть  " Fcoor:label tt-tank_buf.CodeValue " для " replace (tt-tank_buf.parent, chr(4)," ")
      593              view-as alert-box.
      594           else do:
      595                 create tt-tank.
      596                 assign
      597                    tt-tank.parent    = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6
      598                    tt-tank.code      = Faddr:screen-value
      599                    tt-tank.CodeValue = Fcoor:screen-value
      600                    tt-tank.misc1  = fnompres:screen-value when ftypeasi    :screen-value in frame FRAME-B eq "kedr"
      601                 .
      602                 OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
      603                 apply  "VALUE-CHANGED" to BROWSE-5 in frame FRAME-C.
      604           end.
      605        end.
      606     end.
      607   end.
      608   ON choose OF bt-del IN FRAME FRAME-B
      609   do:
      610     if avail tt-asi
      611     then do:
      612         for each tt-tank where tt-tank.parent    = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6:
      613            delete tt-tank.
      614         end.
      615         delete tt-asi.
      616         assign
      617            ftypeasi:screen-value in frame FRAME-B = ""
      618            fCom    :screen-value in frame FRAME-B = ""
      619            fspeed  :screen-value in frame FRAME-B = ""
      620            fchet   :screen-value in frame FRAME-B = ""
      621            fbit    :screen-value in frame FRAME-B = ""
      622            fipasi  :screen-value in frame FRAME-B = ""
      623            fportasi:screen-value in frame FRAME-B = ""
      624            fSlaveId:screen-value in frame FRAME-B = ""
      625         .
      626         OPEN QUERY BROWSE-3 FOR EACH tt-asi NO-LOCK INDEXED-REPOSITION.
      627         apply  "VALUE-CHANGED" to BROWSE-3 in frame FRAME-B.
      628         OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
      629         apply  "VALUE-CHANGED" to BROWSE-5 in frame FRAME-c.
      630      end.
      631   end.
      632   ON choose OF bt-del-2 IN FRAME FRAME-C
      633   do:
      634     if avail tt-tank then
      635     delete tt-tank.
      636     OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
      637   end.
      638   ON choose OF bt-edit IN FRAME FRAME-B
      639   do:
      640     define buffer tt-asi_buf for tt-asi.
      641     define buffer tt-tank_buf for tt-tank.
      642     if    ftypeasi:screen-value eq ?
      643        or fCom    :screen-value eq ?
      644     then do:
      645        message ftypeasi:label " и "  fCom:label "должны быть заполнены"
      646        view-as alert-box.
      647        return no-apply.
      648     end.
      649     if fCom    :screen-value in frame FRAME-B eq "Ethernet"
      650     then do:
      651        find first tt-asi_buf where tt-asi_buf.misc5 = fipasi      :screen-value in frame FRAME-B
      652                                and tt-asi_buf.misc6 = fportasi    :screen-value in frame FRAME-B
      653                                and recid (tt-asi_buf) ne recid(tt-asi)
      654                           no-lock no-error.
      655        if available tt-asi_buf
      656        then do:
      657           message "Уже есть запись с тип IP "  tt-asi.misc5 " Порт " tt-asi.misc6
      658           view-as alert-box.
      659           return no-apply.
      660        end.
      661     end.
      662     else do:
      663        find first tt-asi_buf where tt-asi_buf.parent = ftypeasi:screen-value in frame FRAME-B
      664                            and tt-asi_buf.code   = fCom    :screen-value in frame FRAME-B
      665                            and recid (tt-asi_buf) ne recid(tt-asi)
      666                            no-lock no-error.
      667        if available tt-asi_buf
      668        then do:
      669           message "Уже есть запись с тип АСИ "  tt-asi_buf.parent " Порт " tt-asi_buf.code
      670           view-as alert-box.
      671           return no-apply.
      672        end.
      673     end.
      674     if available tt-asi
      675     then do:
      676       for each tt-tank_buf where tt-tank_buf.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6:
      677            tt-tank_buf.parent = ftypeasi:screen-value in frame FRAME-B + chr(4)
      678                               + fCom    :screen-value in frame FRAME-B + chr(4)
      679                               + fipasi  :screen-value in frame FRAME-B + chr(4)
      680                               + fportasi:screen-value in frame FRAME-B
      681                               .
      682        end.
      683        assign
      684        tt-asi.Misc1 = ""
      685        tt-asi.Misc2 = ""
      686        tt-asi.Misc3 = ""
      687        tt-asi.misc8 = ""
      688        tt-asi.parent = ftypeasi:screen-value in frame FRAME-B
      689        tt-asi.code   = fCom    :screen-value in frame FRAME-B
      690        tt-asi.Misc1  = fspeed  :screen-value in frame FRAME-B when not fCom    :screen-value in frame FRAME-B eq "Ethernet"
      691        tt-asi.Misc2  = fchet   :screen-value in frame FRAME-B when not fCom    :screen-value in frame FRAME-B eq "Ethernet"
      692        tt-asi.Misc3  = fbit    :screen-value in frame FRAME-B when not fCom    :screen-value in frame FRAME-B eq "Ethernet"
      693        tt-asi.misc5  = fipasi  :screen-value in frame FRAME-B
      694        tt-asi.misc6  = fportasi:screen-value in frame FRAME-B
      695        tt-asi.misc7  = fSlaveId:screen-value in frame FRAME-B
      696        tt-asi.misc9  = TOut:screen-value in frame FRAME-B
      697        tt-asi.misc10   = (if ftypeasi:screen-value in frame FRAME-B = "Modbus"  then fSpec:screen-value in frame FRAME-B else "")
      698        .
      699        OPEN QUERY BROWSE-3 FOR EACH tt-asi NO-LOCK INDEXED-REPOSITION.
      700        apply  "VALUE-CHANGED" to BROWSE-3 in frame FRAME-B.
      701        OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
      702        apply  "VALUE-CHANGED" to BROWSE-5 in frame FRAME-C.
      703     end.
      704     else
      705        message "Нет записи АСИ"
      706        view-as alert-box.
      707   end.
      708   ON choose OF bt-edit-2 IN FRAME FRAME-C
      709   do:
      710      define buffer tt-tank_buf for tt-tank.
      711     if     available tt-asi
      712        and available tt-tank
      713     then do:
      714        find first tt-tank_buf where tt-tank_buf.parent    eq tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6
      715                                 and tt-tank_buf.code      eq Faddr:screen-value
      716                                 and recid(tt-tank_buf)    ne recid(tt-tank)
      717        no-lock no-error.
      718        if available tt-tank_buf
      719        then
      720           message
      721           "Уже есть адрес " tt-tank_buf.code " для " tt-asi.parent tt-asi.code
      722           view-as alert-box.
      723        else do:
      724           FIND FIRST tt-tank_buf No-LOCK WHERE tt-tank_buf.CodeValue  = Fcoor:screen-value in frame FRAME-C
      725                                            and recid(tt-tank_buf)    ne recid(tt-tank) NO-ERROR.
      726           if available tt-tank_buf
      727           then
      728             message
      729                "Уже есть  " Fcoor:label tt-tank_buf.CodeValue " для " replace (tt-tank_buf.parent, chr(4)," ")
      730                   view-as alert-box.
      731           else do:
      732              assign
      733                 tt-tank.parent    = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6
      734                 tt-tank.code      = Faddr:screen-value
      735                 tt-tank.CodeValue = Fcoor:screen-value
      736                 tt-tank.misc1  = fnompres:screen-value when ftypeasi    :screen-value in frame FRAME-B eq "kedr"
      737              .
      738              OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
      739              apply  "VALUE-CHANGED" to BROWSE-5 in frame FRAME-C.
      740           end.
      741        end.
      742     end.
      743   end.
      744   ON CHOOSE OF btloabfile IN FRAME Dialog-Frame
      745   DO:
      746      define variable v-file-name as character no-undo.
      747      define variable vok as logical no-undo.
      748      system-dialog get-file v-file-name
      749               filters "Файлы реестра *.reg" "*.reg"
      750               title "Выберите файл списка"
      751               INITIAL-DIR "."
      752               return-to-start-dir
      753               must-exist
      754               update vok
      755               default-extension "cli".
      756      if  vok then do:
      757         run proc-load (v-file-name).
      758      end.
      759   END.
      760   ON choose OF Btload IN FRAME Dialog-Frame
      761   do:
      762     run proc-load (?).
      763   end.
      764   ON choose OF Btn_OK IN FRAME Dialog-Frame
      765   do:
      766     run proc-save (?).
      767   end.
      768   ON CHOOSE OF Bt_ok IN FRAME Dialog-Frame
      769   DO:
      770     find first sys-ctrl.
      771     run db-attr-write(sys-ctrl.db,"AsiIp",fip:screen-value in frame frame-a).
      772     run db-attr-write(sys-ctrl.db,"AsiPort",FPort:screen-value in frame frame-a).
      773     run db-attr-write(sys-ctrl.db,"AsiType",ftype:screen-value in frame frame-a).
      774   END.
      775   ON CHOOSE OF BUTTON-2 IN FRAME FRAME-C
      776   DO:
      777     define variable place-list as character no-undo .
      778     run ref/pl-list.w (
      779                    input parparentproc
      780                   ,input "b-sel"
      781                   ,input v-cntxt-obj-type
      782                   ,input v-cntxt-obj-code
      783                   ,input 'объект':U
      784                  , input-output place-list).
      785     if place-list = "cancel"
      786     then do :
      787       return no-apply .
      788     end .
      789     if place-list <> '':U then do:
      790        FIND FIRST ub.place No-LOCK WHERE recid(ub.place) = integer(entry(1, place-list)) NO-ERROR.
      791        if available ub.place
      792        then Fcoor:screen-value in frame FRAME-C = ub.place.loc1.
      793     end.
      794   END.
      795   ON value-changed OF fCom IN FRAME FRAME-B
      796   do:
      797     assign fcom.
      798     if fcom:screen-value begins "com"
      799     then do :
      800         assign
      801            fspeed:visible     = yes.
      802            fchet:visible      = yes.
      803            fbit:visible       = yes.
      804            fportasi:screen-value = "".
      805            fipasi  :screen-value = "".
      806            fipasi:visible     = no.
      807            fportasi:visible   = no.
      808         .
      809     end.
      810     else if fcom:screen-value eq "usb"
      811     then do with frame FRAME-B:
      812         assign
      813            fspeed:visible = no
      814            fchet:visible  = no
      815            fbit:visible   = no
      816            fspeed:screen-value = ""
      817            fchet:screen-value = ""
      818            fbit:screen-value = ""
      819            fportasi:screen-value = ""
      820            fipasi  :screen-value = ""
      821            fipasi:visible     = no
      822            fportasi:visible   = no
      823         .
      824      end.
      825      else if fcom:screen-value eq "Ethernet"
      826     then do with frame FRAME-B:
      827         assign
      828            fportasi:screen-value = ""
      829            fipasi  :screen-value = ""
      830            fspeed:visible = no
      831            fchet:visible  = no
      832            fbit:visible   = no
      833            fipasi:visible     = yes
      834            fportasi:visible   = yes
      835         .
      836      end.
      837      else
      838       do with frame FRAME-B:
      839         assign
      840            fspeed:visible = no
      841            fchet:visible  = no
      842            fbit:visible   = no
      843            fspeed:screen-value = ""
      844            fchet:screen-value = ""
      845            fbit:screen-value = ""
      846            fipasi:visible     = no
      847            fportasi:visible   = no
      848         .
      849      end.
      850   end.
      851   ON value-changed OF ftypeasi IN FRAME FRAME-B
      852   do:
      853     fCom:screen-value = "".
      854     fCom:visible   = no.
      855     fSlaveId:visible = no.
      856     fnompres:visible IN FRAME FRAME-C = ftypeasi:screen-value eq "kedr".
      857     assign ftypeasi.
      858     if    ftypeasi:screen-value eq "Modbus"
      859        or ftypeasi:screen-value eq "kedr"
      860        or ftypeasi:screen-value eq "Veeder-root"
      861     then do:
      862        assign
      863            fCom:visible     = yes
      864            fSlaveId:visible = ftypeasi:screen-value eq "Modbus"
      865        .
      866     end.
      867     else if    ftypeasi:screen-value eq "DOMS"
      868             or ftypeasi:screen-value eq "ifsfserver"
      869     then
      870        assign
      871            fCom:visible   = no
      872            fCom:screen-value = "Ethernet"
      873        .
      874      apply  "VALUE-CHANGED" to fCom in frame FRAME-B.
      875      if ftypeasi:screen-value = "Modbus" then do:
      876         fSpec:visible in frame FRAME-B = yes.
      877           if available tt-asi then fSpec:screen-value in frame FRAME-B = tt-asi.misc10.
      878     end.
      879     else do:
      880         fSpec:visible in frame FRAME-B = no.
      881         fSpec:screen-value in frame FRAME-B = "".
      882     end.
      883   end.
      884   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      885   then frame Dialog-Frame:PARENT = active-window.
      886   MAIN-BLOCK:
      887   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      888      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      889     run enable_UI.
      890     find first sys-ctrl.
      891     define variable mtype-attr as character no-undo.
      892     define variable mvalue-attr as character no-undo.
      893     run db-attr-value(sys-ctrl.db,"AsiIp",output mvalue-attr,output mtype-attr).
      894     fip:screen-value in frame frame-a = mvalue-attr.
      895     run db-attr-value(sys-ctrl.db,"AsiPort",output mvalue-attr,output mtype-attr).
      896     FPort:screen-value in frame frame-a = mvalue-attr.
      897     fSpec:screen-value in frame frame-b = "99" .
      898     run db-attr-value(sys-ctrl.db,"AsiType",output mvalue-attr,output mtype-attr).
      899     ftype:screen-value in frame frame-a = mvalue-attr.
      900     apply  "value-changed" to ftypeasi IN FRAME FRAME-B.
      901     apply  "VALUE-CHANGED" to fCom in frame FRAME-B.
      902     wait-for go of frame Dialog-Frame.
      903   end.
      904   run disable_UI.
      905   PROCEDURE disable_UI :
      906     HIDE FRAME Dialog-Frame.
      907     HIDE FRAME FRAME-A.
      908     HIDE FRAME FRAME-B.
      909     HIDE FRAME FRAME-C.
      910   END PROCEDURE.
      911   PROCEDURE enable_UI :
      912     ENABLE Btn_Cancel-2 Btn_OK Btload Bt_ok bsavefile btloabfile
      913         WITH FRAME Dialog-Frame.
      914     VIEW FRAME Dialog-Frame.
      915     DISPLAY fip ftype FPort tlive rfrtime
      916         WITH FRAME FRAME-A.
      917     ENABLE fip ftype FPort tlive rfrtime
      918         WITH FRAME FRAME-A.
      919     DISPLAY fip ftype FPort tlive rfrtime
      920         WITH FRAME FRAME-A.
      921     fSpec:visible in frame FRAME-B = no.
      922     ENABLE fip ftype FPort tlive rfrtime
      923         WITH FRAME FRAME-A.
      924     DISPLAY ftypeasi fipasi TOut fSpec
      925         WITH FRAME FRAME-B.
      926     ENABLE BROWSE-3 bt-add bt-del bt-edit ftypeasi fSlaveId fCom fchet fbit
      927            fportasi fspeed fipasi TOut fSpec
      928         WITH FRAME FRAME-B.
      929     OPEN QUERY BROWSE-3 FOR EACH tt-asi NO-LOCK INDEXED-REPOSITION.
      930     DISPLAY Faddr Fcoor fnompres
      931         WITH FRAME FRAME-C.
      932     ENABLE BROWSE-5 bt-add-2 bt-del-2 bt-edit-2 Faddr Fcoor BUTTON-2 fnompres
      933         WITH FRAME FRAME-C.
      934     OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
      935   END PROCEDURE.
      936   PROCEDURE proc-load :
      937   define input  parameter iFile as character no-undo.
      938   define variable vtxt as character no-undo.
      939   define variable vip as character no-undo.
      940   define variable vport as character no-undo.
      941   define variable currentSection as character no-undo.
      942   for each tt-asi_exp:
      943      delete tt-asi_exp.
      944   end.
      945   for each tt-tank_exp:
      946      delete tt-tank_exp.
      947   end.
      948   if iFile eq ? then do:
      949      iFile = "measurer_par_exp.reg".
      950      output to "measurer_par_exp.reg".
      951      output close.
      952      os-command silent value ("reg export HKEY_LOCAL_MACHINE\SOFTWARE\MEASURER_PAR " + search("measurer_par_exp.reg") + " /y /reg:" + (if is-ProcArch64 then "64" else "32") + " >> measurer_par_exp.rez 2>&1").
      953   end.
      954   input STREAM sReadfile FROM VALUE(iFile).
      955   repeat:
      956      import stream sReadfile unformatted vtxt.
      957      vtxt = trim(vtxt).
      958      vtxt = replace (vtxt,'"','').
      959      if vtxt begins "[" then do:
      960         currentSection = vtxt.
      961         if vtxt eq "[HKEY_LOCAL_MACHINE\SOFTWARE\MEASURER_PAR]" then do:
      962            mObj = "head".
      963            next.
      964         end.
      965         else if vtxt eq "[HKEY_LOCAL_MACHINE\SOFTWARE\MEASURER_PAR\Modbus]" or
      966                 vtxt eq "[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\MEASURER_PAR\Modbus]" then do:
      967            mObj = "modbus".
      968            next.
      969         end.
      970         else if vtxt begins "[HKEY_LOCAL_MACHINE\SOFTWARE\MEASURER_PAR\" then do:
      971            if index (vtxt,"TankTop") ne 0 then
      972               assign mObj = "tank".
      973            else
      974               assign
      975                  mObj = "asi"
      976                  vip = ""
      977                  vport = "".
      978            vtxt = entry(4,vtxt,"\").
      979            mtypeasi = entry(1,vtxt," ") .
      980            assign
      981               MCom = entry(2,vtxt," ")
      982               MCom = trim(MCom,"]")
      983               no-error.
      984            if error-status:error then
      985               message "Ошибка загрузки данных из реестра" view-as alert-box.
      986            if MCom begins "Ethernet" then
      987               MCom = "Ethernet".
      988            if mObj = "asi" then do:
      989               create tt-asi_exp.
      990               assign
      991                  tt-asi_exp.parent = mtypeasi
      992                  tt-asi_exp.code = mcom
      993               .
      994               validate tt-asi_exp.
      995            end.
      996            next.
      997         end.
      998         else do:
      999            mObj = "".
     1000            next.
     1001         end.
     1002      end.
     1003      else if mObj ne "" then do:
     1004         assign
     1005            mteg = entry(1,vtxt,"=")
     1006            mvalue = entry(2,vtxt,"=")
     1007            no-error.
     1008         if not error-status:error then do:
     1009            if mObj = "head" then do:
     1010               if mteg = "IP" then
     1011                  Fip:screen-value in frame frame-a = mvalue.
     1012               else if mteg = "PORT" then
     1013                  FPort:screen-value = mvalue.
     1014               else if mteg = "RefreshTime" then
     1015                  rfrtime:screen-value = mvalue.
     1016               else if mteg = "TimeLive" then
     1017                  tlive:screen-value = mvalue.
     1018               else if mteg = "TYPE" then
     1019                  ftype:screen-value = if mvalue eq ? or mvalue eq "?" then "1" else mvalue.
     1020            end.
     1021            else if mObj = "asi" then do:
     1022               if mteg = "TimeOut" then
     1023                  tt-asi_exp.misc9 = mvalue.
     1024               else if mteg = "PORT_NUM" then
     1025                  tt-asi_exp.code = "COM" + mvalue.
     1026               else if mteg = "Baud" then
     1027                  tt-asi_exp.misc1 = mvalue.
     1028               else if mteg = "Parity" then
     1029                  tt-asi_exp.misc2 = mvalue.
     1030               else if mteg = "Databits" then
     1031                  tt-asi_exp.misc3 = mvalue.
     1032               else if mteg = "License" then
     1033                  tt-asi_exp.misc4 = mvalue.
     1034               else if mteg = "ip" then do:
     1035                  vip = mvalue.
     1036                  tt-asi_exp.misc5 = mvalue.
     1037               end.
     1038               else if mteg = "Port" then assign
     1039                  vport = mvalue
     1040                  tt-asi_exp.misc6 = mvalue.
     1041               else if mteg = "SlaveId" then
     1042                  tt-asi_exp.misc7 = mvalue.
     1043               else  if mteg = "Spec" then do:
     1044                  tt-asi_exp.misc10 = mvalue.
     1045               end.
     1046            end.
     1047            else if mObj = "tank" then do:
     1048               if mteg begins "ID_" then do:
     1049                  create tt-tank_exp.
     1050                  assign
     1051                     tt-tank_exp.parent = mtypeasi + chr(4) + mcom + chr(4) + Vip + chr(4) + vport
     1052                     tt-tank_exp.code = substring(mteg,4)
     1053                     tt-tank_exp.CodeValue = entry(1,mvalue,":")
     1054                     tt-tank_exp.misc1 = entry(2,mvalue,":")
     1055                     no-error.
     1056               end.
     1057            end.
     1058         end.
     1059      end.
     1060   end.
     1061   input stream sReadfile close.
     1062   OPEN QUERY BROWSE-3 FOR EACH tt-asi NO-LOCK INDEXED-REPOSITION.
     1063   apply "VALUE-CHANGED" to BROWSE-3 in frame FRAME-B.
     1064   OPEN QUERY BROWSE-5 FOR EACH tt-tank       WHERE tt-tank.parent = tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 NO-LOCK INDEXED-REPOSITION.
     1065   apply "VALUE-CHANGED" to BROWSE-5 in frame FRAME-C.
     1066   end procedure.
     1067   PROCEDURE proc-save :
     1068   define input  parameter iFile as character no-undo.
     1069   define variable vhead as character no-undo.
     1070   define buffer tt-asi for tt-asi.
     1071   define buffer tt-tank for tt-tank.
     1072   define variable vi as integer no-undo.
     1073   output to value(if iFile ne ? then iFile else "measurer_par_imp.reg").
     1074   do with frame FRAME-A:
     1075      put unformatted  "Windows Registry Editor Version 5.00" skip.
     1076      put unformatted  "[HKEY_LOCAL_MACHINE\SOFTWARE\MEASURER_PAR]" skip
     1077      substitute('"IP"="&1"',       Fip:screen-value   ) skip
     1078      substitute('"PORT"="&1"',     Fport:screen-value ) skip.
     1079      put unformatted
     1080      substitute('"TYPE"="&1"',     ftype:screen-value ) skip
     1081      substitute('"CodePage"="&1"', "1251"             ) skip(1).
     1082      if tlive:screen-value  ne "" and tlive:screen-value  ne ?    then  put unformatted  substitute('"TimeLive"="&1"', tlive:screen-value) skip .
     1083      if rfrtime:screen-value  ne "" and rfrtime:screen-value  ne ?    then  put unformatted  substitute('"RefreshTime"="&1"', rfrtime:screen-value) skip .
     1084   end.
     1085   for each tt-asi:
     1086      if tt-asi.code begins "Ethernet"
     1087      then
     1088         vi = vi + 1.
     1089      vhead = substitute("[HKEY_LOCAL_MACHINE\SOFTWARE\MEASURER_PAR\&1 &2&3" ,
     1090                         tt-asi.parent ,
     1091                         ( tt-asi.code),
     1092                         if tt-asi.code begins "Ethernet" then string(vi) else "") .
     1093      put unformatted vhead + "]" skip.
     1094      if tt-asi.misc9 ne "" and tt-asi.misc9 ne ?
     1095      then
     1096         put unformatted substitute('"TimeOut"="&1"', tt-asi.misc9 ) skip(1).
     1097      if tt-asi.code begins "com"
     1098      then
     1099         put unformatted substitute('"PORT_NUM"="&1"', substring(tt-asi.code,4)              ) skip
     1100                         substitute('"Baud"="&1"'    , tt-asi.misc1                          ) skip
     1101                         substitute('"Parity"="&1"'  , (if tt-asi.misc2 eq "3" then "NONE" else tt-asi.misc2)) skip
     1102                         substitute('"Databits"="&1"', tt-asi.misc3                          ) skip.
     1103      if tt-asi.code begins "Ethernet"
     1104      then
     1105          put unformatted substitute('"ip"="&1"', tt-asi.misc5       ) skip
     1106                         substitute('"Port"="&1"'    , tt-asi.misc6  ) skip  .
     1107      if tt-asi.misc10 ne "" then put unformatted substitute('"Spec"="&1"', tt-asi.misc10) skip.
     1108      put unformatted substitute('"SlaveId"="&1"', tt-asi.misc7  ) skip.
     1109      if tt-asi.misc4 ne "" and tt-asi.misc4 ne ?
     1110      then
     1111         put unformatted substitute('"License"="&1"', tt-asi.misc4 ) skip(1).
     1112      if tt-asi.misc8 ne "" and tt-asi.misc8 ne ?
     1113      then
     1114         put unformatted substitute('"PRES_SENSOR_NUM"="&1"', tt-asi.misc8 ) skip(1).
     1115      put unformatted vhead + "\TankTop]" skip.
     1116      for each tt-tank where tt-tank.parent eq tt-asi.parent + chr(4) + tt-asi.code + chr(4) + tt-asi.misc5 + chr(4) + tt-asi.misc6 :
     1117          if tt-tank.misc1 eq ""
     1118          then
     1119             put unformatted substitute('"ID_&1"="&2"',tt-tank.code, tt-tank.CodeValue) skip.
     1120          else
     1121             put unformatted substitute('"ID_&1"="&2:&3"',tt-tank.code, tt-tank.CodeValue, tt-tank.misc1) skip.
     1122      end.
     1123      put unformatted skip(1).
     1124   end.
     1125     output close.
     1126     if iFile eq ?
     1127     then do:
     1128        run trg/userlog.p (
     1129                     input 'MEASURER_PAR'
     1130                   , input ("Запущено сохранение настроек для АСИ в реестр"  + chr(3) + userid("ub"))
     1131                   , input ?
     1132                   , input ?
     1133                   , input "") no-error.
     1134        os-command silent value ("reg delete HKEY_LOCAL_MACHINE\SOFTWARE\MEASURER_PAR /f /reg:" + (if is-ProcArch64 then "64" else "32") + " > measurer_par_del.rez 2>&1").
     1135        os-command silent value ("reg import " + search("measurer_par_imp.reg")      + " /reg:" + (if is-ProcArch64 then "64" else "32") + " > measurer_par_imp.rez 2>&1").
     1136        define variable vtxt as character no-undo.
     1137        input STREAM sReadfile FROM  VALUE("measurer_par_imp.rez") CONVERT TARGET  "1251" source 'ibm866'.
     1138        import stream sReadfile unformatted vtxt.
     1139        input close.
     1140        message vtxt
     1141        view-as alert-box.
     1142     end.
     1143   end procedure.
