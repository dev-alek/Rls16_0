      209   define variable tempStr as character no-undo.
      210   define variable is-ProcArch64 as logical no-undo.
      211   os-command silent value( 'set pro >>procarch') .
      212       if search ("procarch") = ?
      213       then do:
      214   message
      215          "Не найден файл с данными PROCESSOR_ARCHITECTURE, проверьте настройки propath - должен быть указан путь рабочий директории"
      216         view-as alert-box.
      217         return.
      218       end.
      219   input from value (search('procarch')) no-convert.
      220       import tempStr.
      221       if not index ("PROCESSOR_ARCHITECTURE=AMD64", tempStr) = 0
      222         then assign is-ProcArch64 = true.
      223       import tempStr.
      224       if not index ("PROCESSOR_ARCHITEW6432=AMD64", tempStr) = 0
      225         then assign is-ProcArch64 = true.
      226       input close.
      227   is-ProcArch64 = false.
