      483   procedure thobjs :
      484      define input        parameter parparentproc     as widget-handle no-undo .
      485      define input        parameter i-bttns           as character     no-undo .
      486      define input        parameter i-list-mode       as character     no-undo.
      487      define input        parameter i-obj-type        as character     no-undo.
      488      define input        parameter i-db-num          as integer       no-undo.
      489      define input        parameter i-host-code       as integer       no-undo.
      490      define input-output parameter p-rid-list        as character     no-undo .
      491   run ref/thobjs.p
      492           ( input parparentproc
      493            ,input  this-procedure :handle
      494           , input i-bttns
      495           , input i-list-mode
      496           , input i-obj-type
      497           , input i-db-num
      498           , input i-host-code
      499           , input-output p-rid-list ) no-error .
      500   end.
      501   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   procedure factord :
      503     define input  parameter p-fact-date            as date    no-undo .
      504     define input  parameter p-fact-time            as integer no-undo .
      505     define input  parameter p-fact-num             as integer no-undo .
      506     define input  parameter p-shift-date           as date    no-undo .
      507     define input  parameter p-shift-num            as integer no-undo .
      508     define input  parameter p-shift-on             as logical no-undo .
      509     define output parameter p-fact-order           as decimal no-undo .
      510     define output parameter p-shift-end-fact-order as decimal no-undo .
      511     define output parameter p-day-end-fact-order   as decimal no-undo .
      512     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      513     if p-fact-date = ?
      514     then do:
      515       return error "Не указана фактическая дата" .
      516     end.
      517     define variable v-fact-date-num as integer no-undo .
      518     assign
      519       v-fact-date-num = integer(p-fact-date)
      520     .
      521     if p-fact-num = ?
      522     or p-fact-num = 0
      523     then do:
      524       return error "Не задан p-fact-num " + string(p-fact-num) .
      525     end.
      526     if p-fact-num < 0
      527     then do:
      528       return error "Отрицательный fact-num " + string(p-fact-num) .
      529     end.
      530     if p-fact-num >= 100000000
      531     then do:
      532       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      533     end.
      534     if p-shift-on = true
      535     then do:
      536       if p-shift-date = ?
      537       then do:
      538         return error "Не задана дата смены" .
      539       end.
      540       if p-shift-num = ?
      541       or p-shift-num = 0
      542       then do:
      543         return error "Не задан номер смены" .
      544       end.
      545     end.
      546     else do:
      547       assign
      548         p-shift-date = p-fact-date
      549         p-shift-num  = 24
      550       .
      551     end.
      552     define variable v-shift-offset as integer no-undo .
      553     if p-shift-date = p-fact-date
      554     then do:
      555       assign
      556         v-shift-offset = 1
      557       .
      558     end.
      559     if p-shift-date < p-fact-date
      560     then do:
      561       assign
      562         v-shift-offset = 0
      563       .
      564     end.
      565     if p-shift-date > p-fact-date
      566     then do:
      567       message
      568         vss-workfile vss-revision vss-description skip
      569         "Неправильная дата закрытия смены" skip
      570         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      571         view-as alert-box error .
      572       undo, return error
      573         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      574           ,string(p-fact-date, '99/99/9999':U)
      575           ,string(p-shift-date, '99/99/9999':U)
      576           )
      577       .
      578     end.
      579     if p-shift-num < 1
      580     or p-shift-num > 24
      581     then do:
      582       message
      583         vss-workfile vss-revision vss-description skip
      584         "Неправильный номер смены" skip
      585         "p-shift-num" p-shift-num skip
      586         view-as alert-box error .
      587       undo, return error return-value .
      588     end.
      589     assign
      590       p-fact-order           = v-fact-date-num
      591                              + v-shift-offset * 0.5
      592                              + p-shift-num    * 0.02 - 0.01
      593                              + p-fact-num     * 0.0000000001
      594       p-shift-end-fact-order = v-fact-date-num
      595                              + v-shift-offset * 0.5
      596                              + p-shift-num    * 0.02
      597       p-day-end-fact-order   = v-fact-date-num
      598                              + 0.99
      599     .
      600     if p-fact-order           <= v-fact-date-num
      601     or p-shift-end-fact-order <= v-fact-date-num
      602     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      603     or p-shift-end-fact-order >= p-day-end-fact-order
      604     then do:
      605       message
      606         vss-workfile vss-revision vss-description skip
      607         "Внутренняя ошибка при генерации фактического номера" skip
      608         "p-fact-date"            p-fact-date            skip
      609         "p-fact-time"            p-fact-time            skip
      610         "p-fact-num"             p-fact-num             skip
      611         "p-shift-date"           p-shift-date           skip
      612         "p-shift-num"            p-shift-num            skip
      613         "p-shift-on"             p-shift-on             skip
      614         "p-shift-end-fact-order" p-shift-end-fact-order skip
      615         "p-day-end-fact-order"   p-day-end-fact-order   skip
      616         "v-fact-date-num"        v-fact-date-num        skip
      617         view-as alert-box error .
      618       undo, return error return-value .
      619     end.
      620   end procedure.
      621   procedure day-begin-fact-order :
      622     define input  parameter p-fact-date            as date    no-undo .
      623     define output parameter p-day-begin-fact-order as decimal no-undo .
      624     do
      625     on error undo, return error return-value
      626     :
      627       if p-fact-date = ?
      628       then do:
      629         assign
      630           p-day-begin-fact-order = 0
      631         .
      632       end.
      633       else do:
      634         assign
      635           p-day-begin-fact-order = integer(p-fact-date)
      636         .
      637       end.
      638     end.
      639   end procedure.
      640   procedure factord-max-fact-order :
      641     define output parameter p-max-fact-order as decimal   no-undo .
      642     do
      643     on error undo, return error return-value
      644     :
      645       run day-begin-fact-order in this-procedure
      646         (input  date(1, 1, 5000)
      647         ,output p-max-fact-order
      648         ) .
      649     end.
      650   end procedure.
      651   procedure factord-cut-archive :
      652     define input  parameter p-obj-type             as character no-undo .
      653     define input  parameter p-obj-code             as integer   no-undo .
      654     define input  parameter p-fact-date            as date      no-undo .
      655     define output parameter p-shift-on             as logical   no-undo .
      656     define output parameter p-shift-date           as date      no-undo .
      657     define output parameter p-shift-num            as integer   no-undo .
      658     define output parameter p-day-end-fact-order   as decimal   no-undo .
      659     define output parameter p-shift-end-fact-order as decimal   no-undo .
      660     define variable v-fact-order as decimal   no-undo .
      661     define buffer buf_shift-obj for ub.shift-obj .
      662     do
      663     on error undo, return error return-value
      664     :
      665   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      667     (input  p-obj-type
      668     ,input  p-obj-code
      669     ,input  'shift-on=request'
      670     ,output p-shift-on
      671     ) no-error .
      672       if error-status :error
      673       then do:
      674         message
      675           vss-workfile vss-revision vss-description skip
      676           "Ошибка при определении атрибута объекта" skip
      677           "Объект" p-obj-type p-obj-code skip
      678           error-status :get-message(1) skip
      679           return-value skip
      680           view-as alert-box error .
      681         undo, return error return-value .
      682       end.
      683       if p-shift-on = false
      684       then do:
      685         assign
      686           p-shift-date               = ?
      687           p-shift-num                = 0
      688         .
      689       end.
      690       else do:
      691         find first buf_shift-obj share-lock
      692           where buf_shift-obj.obj-type   = p-obj-type
      693             and buf_shift-obj.obj-code   = p-obj-code
      694             and buf_shift-obj.shift-date > p-fact-date
      695           use-index pi
      696           no-error .
      697         if not available buf_shift-obj
      698         or buf_shift-obj.status_ <> 'зкр':U
      699         then do:
      700           message
      701             vss-workfile vss-revision vss-description skip
      702             "Невозможно вычислить последнюю смену" skip
      703             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      704             "Объект" p-obj-type p-obj-code skip
      705             "Дата" p-fact-date skip
      706             view-as alert-box error .
      707           undo, return error return-value .
      708         end.
      709         find last buf_shift-obj share-lock
      710           where buf_shift-obj.obj-type = p-obj-type
      711             and buf_shift-obj.obj-code = p-obj-code
      712             and buf_shift-obj.shift-date <= p-fact-date
      713           use-index pi
      714           no-error .
      715         if available buf_shift-obj
      716         then do:
      717           if  buf_shift-obj.status_ = 'зкр':U
      718           then do:
      719             assign
      720               p-shift-date = buf_shift-obj.shift-date
      721               p-shift-num  = buf_shift-obj.shift-num
      722             .
      723           end.
      724           else do:
      725             message
      726               vss-workfile vss-revision vss-description skip
      727               "Невозможно вычислить последнюю смену" skip
      728               "Статус смены отличен от статуса" 'зкр':U skip
      729               "Объект" p-obj-type p-obj-code skip
      730               "Дата" p-fact-date skip
      731               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      732               view-as alert-box error .
      733             undo, return error return-value .
      734           end.
      735         end.
      736         else do:
      737           assign
      738             p-shift-date = p-fact-date - 1
      739             p-shift-num  = 1
      740           .
      741         end.
      742       end.
      743       run factord in this-procedure
      744         (input  p-fact-date
      745         ,input  1
      746         ,input  1
      747         ,input  p-shift-date
      748         ,input  p-shift-num
      749         ,input  p-shift-on
      750         ,output v-fact-order
      751         ,output p-shift-end-fact-order
      752         ,output p-day-end-fact-order
      753         ) no-error .
      754       if error-status :error
      755       then do:
      756         message
      757           vss-workfile vss-revision vss-description skip
      758           "Ошибка при вызове процедуры factord"
      759           error-status :get-message(1) skip
      760           return-value skip
      761           view-as alert-box error .
      762         undo, return error return-value .
      763       end.
      764     end.
      765   end procedure.
      766   procedure factord-lock-shift :
      767     define input  parameter p-obj-type  as character no-undo .
      768     define input  parameter p-obj-code  as integer   no-undo .
      769     define input  parameter p-fact-date as date      no-undo .
      770     define parameter buffer buf_shift-obj for ub.shift-obj .
      771     define variable v-shift-on      as logical   no-undo .
      772     define variable v-extra-message as character no-undo .
      773     define variable v-error as character no-undo .
      774     do
      775     on error undo, return error return-value
      776     :
      777   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      779     (input  p-obj-type
      780     ,input  p-obj-code
      781     ,input  'shift-on=request'
      782     ,output v-shift-on
      783     ) no-error .
      784       if error-status :error
      785       then do:
      786         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      787         undo, return error v-error .
      788       end.
      789       if v-shift-on = true
      790       then do:
      791         find first buf_shift-obj share-lock
      792           where buf_shift-obj.obj-type   = p-obj-type
      793             and buf_shift-obj.obj-code   = p-obj-code
      794             and buf_shift-obj.shift-date > p-fact-date
      795           use-index pi
      796           no-error .
      797         if not available buf_shift-obj
      798         or buf_shift-obj.status_ <> 'зкр':U
      799         then do:
      800           find last buf_shift-obj
      801             where buf_shift-obj.obj-type = p-obj-type
      802               and buf_shift-obj.obj-code = p-obj-code
      803               and buf_shift-obj.status_  = 'зкр':U
      804             use-index stts
      805             no-error .
      806           if available buf_shift-obj
      807           then do:
      808             assign
      809               v-extra-message =
      810                     substitute("Дата начала последеней закрытой смены на объекте &1"
      811                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      812                               )
      813             .
      814           end.
      815           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      816           undo, return error v-error .
      817         end.
      818       end.
      819     end.
      820   end procedure.
      821   procedure factord-end-day :
      822     define input  parameter p-fact-date            as date    no-undo .
      823     define output parameter p-day-end-fact-order   as decimal no-undo .
      824     do
      825     on error undo, return error return-value
      826     :
      827       if p-fact-date = ?
      828       then do:
      829         return error "Не указана фактическая дата" .
      830       end.
      831       assign
      832         p-day-end-fact-order = integer(p-fact-date) + 0.99
      833       .
      834     end.
      835   end procedure.
      836   procedure factord-to-date :
      837     define input  parameter p-fact-order as decimal no-undo .
      838     define output parameter p-fact-date  as date    no-undo .
      839     define variable v-ref-date  as date      no-undo .
      840     define variable v-ref-delta as integer   no-undo .
      841     do
      842     on error undo, return error return-value
      843     :
      844       if p-fact-order = ?
      845       or p-fact-order = 0
      846       then do:
      847         return error "Не указан fact-order" .
      848       end.
      849       assign
      850         v-ref-date  = date(1, 1, 2000)
      851       .
      852       assign
      853         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      854       .
      855       assign
      856         p-fact-date = v-ref-date + v-ref-delta
      857       .
      858     end.
      859   end procedure.
      860   procedure factord-to-fact-num :
      861     define input  parameter p-fact-order as decimal no-undo .
      862     define output parameter p-fact-num   as integer no-undo .
      863     define variable v-fact-order-trunc as decimal no-undo .
      864     do
      865     on error undo, return error return-value
      866     :
      867       if p-fact-order = ?
      868       or p-fact-order = 0
      869       then do:
      870         return error "Не указан fact-order" .
      871       end.
      872       assign
      873        v-fact-order-trunc = truncate(p-fact-order, 2)
      874       .
      875       assign
      876         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      877       .
      878     end.
      879   end procedure.
      880   procedure factord-to-shift-num :
      881     define input  parameter p-fact-order as decimal no-undo .
      882     define output parameter p-shift-num   as integer no-undo .
      883     define variable  p-shift-numd  as decimal   no-undo .
      884     define variable v-fact-order-trunc as decimal no-undo .
      885     do
      886     on error undo, return error return-value
      887     :
      888       if p-fact-order = ?
      889       or p-fact-order = 0
      890       then do:
      891         return error "Не указан fact-order" .
      892       end.
      893       assign
      894        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      895       .
      896       if v-fact-order-trunc < 0.5 then do:
      897         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      898       end.
      899       assign
      900         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      901         .
      902        assign
      903         p-shift-num = truncate (p-shift-numd , 0)
      904       .
      905     end.
      906   end procedure.
      907   define stream slog .
      908   define variable v-total-err   as integer   no-undo .
      909   define variable v-error-count as integer   no-undo .
      910   do
      911   on error undo, return error return-value
      912   :
      913     define variable v-cut-date                  as date      no-undo .
      914     run select-cut-date in this-procedure
      915       (output v-cut-date
      916       ) .
      917     if v-cut-date = ?
      918     then do:
      919       return .
      920     end.
      921     define variable v-num as integer no-undo .
      922     run gbl/d-askw.w
      923       (input "Вопрос"
      924       ,input "Инициализация начальных остатков складского архива по типам приобретения" + chr(10)
      925              + substitute("на дату &1", string(v-cut-date, '99/99/9999':u)) + chr(10)
      926              + "На сменных объектах смена должна быть открыта, иначе эти объекты не будут обработаны"
      927       ,input "|^"
      928       ,input "Все объекты^confirm|Выбрать объекты|Отмена"
      929       ,input "|"
      930           + "|"
      931           + ""
      932       ,input 1
      933       ,input 3
      934       ,output v-num
      935       ).
      936     case v-num :
      937       when 1
      938       then do:
      939         define buffer buf_db for ub.db .
      940         define buffer buf_clients for ub.clients .
      941         define variable v-db-num as integer   no-undo .
      942   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      943   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      944     (output v-db-num
      945     )  .
      946         for each buf_db no-lock
      947           where v-db-num = 0
      948              or (v-db-num <> 0
      949                  and buf_db.db-num = v-db-num
      950                 )
      951         on error undo, return error return-value
      952         :
      953           for each buf_clients no-lock
      954             where buf_clients.db-num = buf_db.db-num
      955           on error undo, return error
      956           :
      957             define variable v-attr-aht-disable-chr  as character no-undo .
      958             define variable v-attr-aht-disable-type as character no-undo .
      959             define variable v-attr-aht-disable      as logical   no-undo .
      960             run gbl/clntat-v.p
      961               (input  buf_clients.obj-type
      962               ,input  buf_clients.obj-code
      963               ,input  'aht-disable':U
      964               ,output v-attr-aht-disable-chr
      965               ,output v-attr-aht-disable-type
      966               ).
      967             assign
      968               v-attr-aht-disable = lookup(v-attr-aht-disable-chr, "yes,true") > 0
      969             .
      970             if  v-attr-aht-disable <> true
      971             and buf_clients.stts = 0
      972             then do:
      973               run utl/inobaht.p
      974                 (input  buf_clients.obj-type
      975                 ,input  buf_clients.obj-code
      976                 ,input  v-cut-date
      977                 ,output v-error-count
      978                 ) no-error .
      979                 if error-status :error then
      980                   message
      981                     error-status :get-message(1) skip
      982                     return-value skip
      983                     "Ошибка при инициализации на объекте"
      984                     buf_clients.obj-type
      985                     buf_clients.obj-code
      986                     view-as alert-box error
      987                   .
      988               assign
      989                 v-total-err = v-total-err
      990                             + v-error-count
      991               .
      992             end.
      993           end.
      994         end.
      995       end.
      996       when 2
      997       then do:
      998   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      999     run mainmenu_getcntxt in parparentproc
     1000       (output v-cntxt-db-num
     1001       ,output v-cntxt-userid
     1002       ,output v-cntxt-level
     1003       ,output v-cntxt-host-code-obj
     1004       ,output v-cntxt-obj-type
     1005       ,output v-cntxt-obj-code
     1006       ,output v-cntxt-db-num-obj
     1007       ,output v-cntxt-is-admin
     1008       ) .
     1009         define variable v-user-select as logical   no-undo .
     1010   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   run userobjs_select-many in this-procedure
     1012     (input  parparentproc
     1013     ,input  v-cntxt-db-num
     1014     ,input  v-cntxt-userid
     1015     ,input  v-cntxt-host-code-obj
     1016     ,input  v-cntxt-obj-type
     1017     ,input  v-cntxt-obj-code
     1018     ,output v-user-select
     1019     )  .
     1020         if v-user-select <> true
     1021         then do:
     1022           message
     1023             "Объект не выбран"
     1024             view-as alert-box information .
     1025           return .
     1026         end.
     1027         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1028         for each buf_userobjs_temp-user-obj
     1029         on error undo, return error return-value
     1030         :
     1031           find first buf_clients no-lock
     1032             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     1033               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     1034             .
     1035           run gbl/clntat-v.p
     1036             (input  buf_clients.obj-type
     1037             ,input  buf_clients.obj-code
     1038             ,input  'aht-disable':U
     1039             ,output v-attr-aht-disable-chr
     1040             ,output v-attr-aht-disable-type
     1041             ).
     1042           assign
     1043             v-attr-aht-disable = lookup(v-attr-aht-disable-chr, "yes,true") > 0
     1044           .
     1045           if  v-attr-aht-disable <> true
     1046           and buf_clients.stts   = 0
     1047           then do:
     1048             run utl/inobaht.p
     1049               (input  buf_clients.obj-type
     1050               ,input  buf_clients.obj-code
     1051               ,input  v-cut-date
     1052               ,output v-error-count
     1053                 ) no-error .
     1054                 if error-status :error then
     1055                   message
     1056                     error-status :get-message(1) skip
     1057                     return-value skip
     1058                     "Ошибка при инициализации на объекте"
     1059                     buf_clients.obj-type
     1060                     buf_clients.obj-code
     1061                     view-as alert-box error
     1062                   .
     1063             assign
     1064               v-total-err = v-total-err
     1065                           + v-error-count
     1066             .
     1067           end.
     1068         end.
     1069       end.
     1070       otherwise do:
     1071         return .
     1072       end.
     1073     end.
     1074     if v-total-err <> 0
     1075     then do:
     1076       message
     1077         "Инициализация начальных остатков по типам приобретения завершена" skip
     1078         "При расчет были обнаружены ошибки" skip
     1079         "Всего ошибок" v-total-err skip
     1080         "Подробная информация об ошибках выведена в файлы в текущей рабочей директории" skip
     1081         view-as alert-box error .
     1082     end.
     1083     else do:
     1084       message
     1085         "Инициализация начальных остатков по типам приобретения успешно завершена" skip
     1086         "Запустите расчет складского архива по типам приобретения (objaht.p)" skip
     1087         view-as alert-box information .
     1088     end.
     1089   end.
     1090   procedure select-cut-date :
     1091     define output parameter p-cut-date as date      no-undo .
     1092     do
     1093     on error undo, return error return-value
     1094     :
     1095       define variable v-today as date      no-undo .
     1096       define variable v-time  as integer   no-undo .
     1097       run cur-time in this-procedure
     1098         (output v-today
     1099         ,output v-time
     1100         ) .
     1101       assign
     1102         p-cut-date     = v-today
     1103       .
     1104       define variable v-string-last-fact-date as character no-undo .
     1105       assign
     1106         v-string-last-fact-date = string(p-cut-date, '99/99/9999':u)
     1107       .
     1108       run gbl/d-prompt.w
     1109         ( 'title=':u + "Введите дату" + '\':u
     1110         + 'text1=':u + "Введите дату, за которую будут проинициализирован складской архив" + '\':u
     1111         + 'text2=':u + "Обычно это первый день года, квартала или месяца" + '\':u
     1112         + 'type=date\':u
     1113         ,input-output v-string-last-fact-date
     1114         ).
     1115       if return-value = 'false':u
     1116       then do:
     1117         undo, return error return-value .
     1118       end.
     1119       assign
     1120         p-cut-date = date(v-string-last-fact-date)
     1121       .
     1122       if p-cut-date = ?
     1123       then do:
     1124         undo, return error return-value .
     1125       end.
     1126       define variable lok as logical   no-undo .
     1127       assign
     1128         lok = false
     1129       .
     1130       message
     1131         "После инициализации складского архива по типам приобретения" skip
     1132         "вы сможете закрывать документы в системе за дату" string(p-cut-date, "99/99/9999" ) skip
     1133         "В отчетах вы сможете запрашивать информацию только за более позднюю дату" skip
     1134         "" skip
     1135         "ВНИМАНИЕ!!!!" skip
     1136         "Если у вас были рассчитанный складской архив - то он будет удалён" skip
     1137         "и вы сможете получить отчеты только после расчета складского архива при помощи программы" skip
     1138         "Расчет складского архива по типам приобретения" skip
     1139         "" skip
     1140         "Продолжить?" skip
     1141         view-as alert-box question buttons yes-no update lok .
     1142       if lok <> true
     1143       then do:
     1144         undo, return error return-value .
     1145       end.
     1146       assign
     1147         lok = false
     1148       .
     1149       message
     1150         "У вас имеется работоспособная резервная копия вашей системы," skip
     1151         "которую вы сделали непосредственно перед запуском данной программы?" skip
     1152         view-as alert-box question buttons yes-no update lok .
     1153       if lok <> true
     1154       then do:
     1155         undo, return error return-value .
     1156       end.
     1157       if p-cut-date > v-today + 1
     1158       then do:
     1159         assign
     1160           lok = false
     1161         .
     1162         message
     1163           "Первый день работы системы," skip
     1164           "когда вы можете закрывать документы" p-cut-date skip
     1165           "Завтра" v-today + 1 skip
     1166           "Вы не сможете закрывать документы завтра." skip
     1167           "Инициализация складского архива." skip
     1168           "Продолжить?" skip
     1169           view-as alert-box question buttons yes-no update lok .
     1170         if lok <> true
     1171         then do:
     1172           undo, return error return-value .
     1173         end.
     1174       end.
     1175     end.
     1176   end procedure.
