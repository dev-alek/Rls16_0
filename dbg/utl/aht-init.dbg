        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: aht-init.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/aht-init.p $":U .
        8   define variable vss-description as character no-undo init "Первоначальный расчет складского архива по типу приобретени ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304     define variable v-cntxt-db-num        as integer   no-undo .
      305     define variable v-cntxt-userid        as character no-undo .
      306     define variable v-cntxt-level         as character no-undo .
      307     define variable v-cntxt-host-code-obj as integer   no-undo .
      308     define variable v-cntxt-obj-type      as character no-undo .
      309     define variable v-cntxt-obj-code      as integer   no-undo .
      310     define variable v-cntxt-db-num-obj    as integer   no-undo .
      311     define variable v-cntxt-is-admin      as logical   no-undo .
      312   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   define temp-table userobjs_temp-user-obj no-undo
      314     field obj-type as character
      315     field obj-code as integer
      316     index xpk is primary unique obj-type obj-code
      317     .
      318   procedure userobjs_clear :
      319     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      320     do
      321     on error undo, return error return-value
      322     :
      323       for each buf_userobjs_temp-user-obj
      324       on error undo, return error return-value
      325       :
      326         delete buf_userobjs_temp-user-obj .
      327       end.
      328     end.
      329   end .
      330   procedure userobjs_object-count :
      331     define output parameter p-total-count as integer   no-undo .
      332     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      333     do
      334     on error undo, return error return-value
      335     :
      336       assign
      337         p-total-count = 0
      338       .
      339       for each buf_userobjs_temp-user-obj
      340       on error undo, return error return-value
      341       :
      342         assign
      343           p-total-count = p-total-count + 1
      344         .
      345       end.
      346     end.
      347   end.
      348   procedure userobjs_append :
      349      define input  parameter p-obj-type as character no-undo .
      350      define input  parameter p-obj-code as integer   no-undo .
      351     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      352     do
      353     on error undo, return error return-value
      354     :
      355       find first buf_userobjs_temp-user-obj
      356         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      357           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      358         no-error .
      359       if not available buf_userobjs_temp-user-obj
      360       then do:
      361         create buf_userobjs_temp-user-obj .
      362         assign
      363           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      364           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      365         .
      366       end.
      367     end.
      368   end.
      369   procedure userobjs_object-exist :
      370     define output parameter p-object-exist as logical   no-undo .
      371     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      372     do
      373     on error undo, return error return-value
      374     :
      375       find first buf_userobjs_temp-user-obj
      376         no-error .
      377       if not available buf_userobjs_temp-user-obj
      378       then do:
      379         assign
      380           p-object-exist = false
      381         .
      382       end.
      383       else do:
      384         assign
      385           p-object-exist = true
      386         .
      387       end.
      388     end.
      389   end.
      390   procedure userobjs_transfer :
      391     define input  parameter p-callback-handle as handle no-undo .
      392     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      393     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      394     do
      395     on error undo, return error return-value
      396     :
      397       if valid-handle(p-callback-handle) <> true
      398       then do:
      399         message
      400           vss-workfile vss-revision vss-description skip
      401           "Ошибка задания входных параметров" skip
      402           "Неизвестный указатель на процедуру" skip
      403           view-as alert-box error .
      404         undo, return error return-value .
      405       end.
      406       if p-callback-handle :get-signature("userobjs_append") = ""
      407       then do:
      408         message
      409           vss-workfile vss-revision vss-description skip
      410           "Ошибка задания входных параметров" skip
      411           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      412                     ,p-callback-handle :file-name
      413                     ) skip
      414           view-as alert-box error .
      415         undo, return error return-value .
      416       end.
      417       for each buf_userobjs_temp-user-obj
      418       on error undo, return error return-value
      419       :
      420         run userobjs_append in p-callback-handle
      421           (input  buf_userobjs_temp-user-obj.obj-type
      422           ,input  buf_userobjs_temp-user-obj.obj-code
      423           ) .
      424       end.
      425     end.
      426   end procedure.
      427   procedure userobjs_select-one :
      428      define input  parameter parparentproc     as widget-handle no-undo .
      429      define input  parameter p-db-num          as integer   no-undo .
      430      define input  parameter p-user-id         as character no-undo .
      431      define input  parameter p-host-code-obj   as integer   no-undo .
      432      define input  parameter p-obj-type        as character no-undo .
      433      define input  parameter p-obj-code        as integer   no-undo .
      434      define output parameter p-user-select     as logical   no-undo .
      435      define output parameter p-select-obj-type as character no-undo .
      436      define output parameter p-select-obj-code as character no-undo .
      437     do
      438     on error undo, return error return-value
      439     :
      440       run gbl/userobjs.w
      441         (input  parparentproc
      442         ,input  this-procedure :handle
      443         ,input  p-db-num
      444         ,input  p-user-id
      445         ,input  p-host-code-obj
      446         ,input  p-obj-type
      447         ,input  p-obj-code
      448         ,INPUT  "b-sel"
      449         ,output p-user-select
      450         ,output p-select-obj-type
      451         ,output p-select-obj-code
      452         ) .
      453     end.
      454   end.
      455   procedure userobjs_select-many :
      456     define input  parameter parparentproc   as widget-handle no-undo .
      457     define input  parameter p-db-num        as integer   no-undo .
      458     define input  parameter p-user-id       as character no-undo .
      459     define input  parameter p-host-code-obj as integer   no-undo .
      460     define input  parameter p-obj-type      as character no-undo .
      461     define input  parameter p-obj-code      as integer   no-undo .
      462     define output parameter p-user-select   as logical   no-undo .
      463     define variable v-select-obj-type as character no-undo .
      464     define variable v-select-obj-code as integer   no-undo .
      465     do
      466     on error undo, return error return-value
      467     :
      468       run gbl/userobjs.w
      469         (input  parparentproc
