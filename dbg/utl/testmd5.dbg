        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: testmd5.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: utl/testmd5.p $":U .
        7   define variable vss-description as character no-undo initial "Программа проверки работы модуля md5.p".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define stream slog .
       67   do
       68   on error undo, return error return-value
       69   :
       70     run validate-md5 in this-procedure
       71       (input ''
       72       ,input 'D41D8CD98F00B204E9800998ECF8427E'
       73       ) no-error .
       74     if error-status :error
       75     then do:
       76       undo, return error return-value .
       77     end.
       78     run validate-md5 in this-procedure
       79       (input 'a'
       80       ,input '0CC175B9C0F1B6A831C399E269772661'
       81       ) no-error .
       82     if error-status :error
       83     then do:
       84       undo, return error return-value .
       85     end.
       86     run validate-md5 in this-procedure
       87       (input 'abc'
       88       ,input '900150983CD24FB0D6963F7D28E17F72'
       89       ) no-error .
       90     if error-status :error
       91     then do:
       92       undo, return error return-value .
       93     end.
       94     run validate-md5 in this-procedure
       95       (input 'message digest'
       96       ,input 'F96B697D7CB7938D525A2F31AAF161D0'
       97       ) no-error .
       98     if error-status :error
       99     then do:
      100       undo, return error return-value .
      101     end.
      102     run validate-md5 in this-procedure
      103       (input 'abcdefghijklmnopqrstuvwxyz'
      104       ,input 'C3FCD3D76192E4007DFB496CCA67E13B'
      105       ) no-error .
      106     if error-status :error
      107     then do:
      108       undo, return error return-value .
      109     end.
      110     run validate-md5 in this-procedure
      111       (input 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
      112       ,input 'D174AB98D277D9F5A5611C2C9F419D9F'
      113       ) no-error .
      114     if error-status :error
      115     then do:
      116       undo, return error return-value .
      117     end.
      118     run validate-md5 in this-procedure
      119       (input '12345678901234567890123456789012345678901234567890123456789012345678901234567890'
      120       ,input '57EDF4A22BE3C955AC49DA2E2107B67A'
      121       ) no-error .
      122     if error-status :error
      123     then do:
      124       undo, return error return-value .
      125     end.
      126   end.
      127   procedure validate-md5 :
      128     define input parameter p-string          as character no-undo .
      129     define input parameter p-check-signature as character no-undo .
      130     do
      131     on error undo, return error return-value
      132     :
      133       define variable v-test-file-name as character no-undo .
      134       assign
      135         v-test-file-name = 'testmd5.txt':u
      136       .
      137       output stream slog to value(v-test-file-name) .
      138       put stream slog unformatted p-string .
      139       output stream slog close .
      140       define variable v-signature as character no-undo .
      141       run gbl/md5.p
      142         (input  v-test-file-name
      143         ,output v-signature
      144         ) no-error .
      145       if  error-status :error
      146       then do:
      147         undo, return error return-value .
      148       end.
      149       if v-signature <> p-check-signature
      150       then do:
      151         undo, return error vss-workfile + chr(10)
      152           + "Ошибка при определении контрольной суммы" + chr(10)
      153           + substitute("Строка &1", p-string) + chr(10)
      154           + substitute("Контрольная сумма &1", v-signature) + chr(10)
      155           + substitute("Должна быть сумма &1", p-check-signature) + chr(10)
      156           .
      157       end.
      158       os-delete value(v-test-file-name) .
      159     end.
      160   end procedure .
