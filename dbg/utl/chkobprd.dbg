     3523         if p-start-date = ?
     3524         then do:
     3525           assign
     3526             v-start-fact-order = 0
     3527           .
     3528         end.
     3529         else do:
     3530           run factord-end-day in this-procedure
     3531             (input  p-start-date - 1
     3532             ,output v-start-fact-order
     3533             ) .
     3534   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     3536     (input  p-obj-type
     3537     ,input  p-obj-code
     3538     ,input  v-b-code
     3539     ,input  0
     3540     ,input  v-start-fact-order
     3541     ,output v-doc-num
     3542     ,output v-price-sale
     3543     ,output v-road-tax
     3544     ,output v-excise
     3545     ,output v-crsa-vat-pc
     3546     ,output v-crsa-slt-pc
     3547     ) no-error .
     3548           if error-status :error
     3549           then do:
     3550             assign
     3551               p-error-number = p-error-number + 1
     3552             .
     3553             output stream sout to value(v-detail-err-file-name) append .
     3554             export stream sout '### error 380':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     3555             export stream sout 'ошибка при поиске цены на определенное время (bcprcex.i)':U .
     3556             export stream sout 'obj-type':U p-obj-type .
     3557             export stream sout 'obj-code':U p-obj-code .
     3558             export stream sout 'b-code':U v-b-code .
     3559             export stream sout 'fact-order':U v-start-fact-order.
     3560             export stream sout 'error-message':U error-status :get-message(1)  .
     3561             export stream sout 'return-value':U return-value .
     3562             output stream sout close .
     3563             next gds-obj_cycle .
     3564           end.
     3565           if v-doc-num <> ?
     3566           then do:
     3567             find first buf_price-doc no-lock
     3568               where buf_price-doc.doc-num = v-doc-num
     3569               no-error .
     3570             if error-status :error
     3571             then do:
     3572               assign
     3573                 p-error-number = p-error-number + 1
     3574               .
     3575               output stream sout to value(v-detail-err-file-name) append .
     3576               export stream sout '### error 404':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     3577               export stream sout 'ошибка при поиске переоценки':U .
     3578               export stream sout 'doc-num':U v-doc-num .
     3579               output stream sout close .
     3580               run factord-end-day in this-procedure
     3581                 (input  buf_price-doc.fact-date - 1
     3582                 ,output v-start-fact-order
     3583                 ) .
     3584               next gds-obj_cycle .
     3585             end.
     3586             else do:
     3587             end.
     3588           end.
     3589         end.
     3590         run goods-operation-list-clear in this-procedure .
     3591         run goods-operation-list-init in this-procedure
     3592           (input  buf_gds-obj.obj-type
     3593           ,input  buf_gds-obj.obj-code
     3594           ,input  buf_gds-obj.artic
     3595           ,input  buf_gds-obj.prod-type
     3596           ,input  buf_gds-obj.prod-code
     3597           ,input  v-b-code
     3598           ,input  v-start-fact-order
     3599           ) .
     3600         run partslib-init-temp-parts in this-procedure
     3601           (input  buf_gds-obj.obj-type
     3602           ,input  buf_gds-obj.obj-code
     3603           ,input  buf_gds-obj.artic
     3604           ,input  buf_gds-obj.prod-type
     3605           ,input  buf_gds-obj.prod-code
     3606           ) .
     3607         run prdoclib-init-temp-prt-obj in this-procedure
     3608           (input  buf_gds-obj.obj-type
     3609           ,input  buf_gds-obj.obj-code
     3610           ,input  buf_gds-obj.artic
     3611           ,input  buf_gds-obj.prod-type
     3612           ,input  buf_gds-obj.prod-code
     3613           ,input  0
     3614           ) .
     3615         run temp-prt-obj-leave-term in this-procedure
     3616           .
     3617         run goods-operation-list-process in this-procedure
     3618           (input  buf_gds-obj.obj-type
     3619           ,input  buf_gds-obj.obj-code
     3620           ,input  buf_gds-obj.artic
     3621           ,input  buf_gds-obj.prod-type
     3622           ,input  buf_gds-obj.prod-code
     3623           ,input  v-b-code
     3624           ,input  v-goods-gds-goods
     3625           ,input  v-goods-twounit
     3626           ) .
     3627       end.
     3628     end.
     3629   end procedure.
     3630   procedure scan-doc-line :
     3631     define input  parameter p-obj-type         as character no-undo .
     3632     define input  parameter p-obj-code         as integer   no-undo .
     3633     define input  parameter p-artic            as character no-undo .
     3634     define input  parameter p-prod-type        as character no-undo .
     3635     define input  parameter p-prod-code        as integer   no-undo .
     3636     define input  parameter p-start-fact-order as decimal   no-undo .
     3637     define buffer buf_doc-line for ub.doc-line .
     3638     do
     3639     on error undo, return error return-value
     3640     :
     3641       for each buf_doc-line no-lock
     3642         where buf_doc-line.obj-type   = p-obj-type
     3643           and buf_doc-line.obj-code   = p-obj-code
     3644           and buf_doc-line.artic      = p-artic
     3645           and buf_doc-line.prod-type  = p-prod-type
     3646           and buf_doc-line.prod-code  = p-prod-code
     3647           and buf_doc-line.status_    = 'факт':U
     3648           and buf_doc-line.fact-order > p-start-fact-order
     3649       on error undo, return error return-value
     3650       :
     3651         run goods-operation-list-append in this-procedure
     3652           (input  buf_doc-line.doc-code
     3653           ,input  'trn-doc':U
     3654           ,input  buf_doc-line.fact-order
     3655           ) .
     3656       end.
     3657     end.
     3658   end procedure.
     3659   procedure scan-price-list :
     3660     define input  parameter p-obj-type         as character no-undo .
     3661     define input  parameter p-obj-code         as integer   no-undo .
     3662     define input  parameter p-b-code           as integer   no-undo .
     3663     define input  parameter p-start-fact-order as decimal   no-undo .
     3664     define buffer buf_price-list for ub.price-list .
     3665     do
     3666     on error undo, return error return-value
     3667     :
     3668       for each buf_price-list no-lock
     3669         where buf_price-list.obj-type   = p-obj-type
     3670           and buf_price-list.obj-code   = p-obj-code
     3671           and buf_price-list.b-code     = p-b-code
     3672           and buf_price-list.price-type = '':U
     3673           and buf_price-list.fact-order > p-start-fact-order
     3674       on error undo, return error return-value
     3675       :
     3676         run goods-operation-list-append in this-procedure
     3677           (input  buf_price-list.doc-num
     3678           ,input  'price-doc':U
     3679           ,input  buf_price-list.fact-order
     3680           ) .
     3681       end.
     3682     end.
     3683   end procedure.
     3684   procedure goods-operation-list-clear :
     3685     define buffer buf_goods-operation-list for goods-operation-list .
     3686     do
     3687     on error undo, return error return-value
     3688     :
     3689       for each buf_goods-operation-list
     3690       on error undo, return error return-value
     3691       :
     3692         delete buf_goods-operation-list .
     3693       end.
     3694     end.
     3695   end procedure.
     3696   procedure goods-operation-list-append :
     3697     define input  parameter p-doc-code   as character no-undo .
     3698     define input  parameter p-table-name as character no-undo .
     3699     define input  parameter p-fact-order as decimal   no-undo .
     3700     define buffer buf_goods-operation-list for goods-operation-list .
     3701     do
     3702     for buf_goods-operation-list
     3703     on error undo, return error return-value
     3704     :
     3705       find first buf_goods-operation-list
     3706         where buf_goods-operation-list.doc-code = p-doc-code
     3707         no-error .
     3708       if available buf_goods-operation-list
     3709       then do:
     3710         undo, return error '':U .
     3711       end.
     3712       if p-table-name = ?
     3713       or lookup(p-table-name, 'trn-doc':U + chr(44) + 'price-doc':U) = 0
     3714       then do:
     3715         undo, return error substitute("Неизвестный тип таблицы &1", p-table-name) .
     3716       end.
     3717       create buf_goods-operation-list .
     3718       assign
     3719         buf_goods-operation-list.doc-code   = p-doc-code
     3720         buf_goods-operation-list.table-name = p-table-name
     3721         buf_goods-operation-list.fact-order = p-fact-order
     3722       .
     3723     end.
     3724   end procedure.
     3725   procedure goods-operation-list-init :
     3726     define input  parameter p-obj-type         as character no-undo .
     3727     define input  parameter p-obj-code         as integer   no-undo .
     3728     define input  parameter p-artic            as character no-undo .
     3729     define input  parameter p-prod-type        as character no-undo .
     3730     define input  parameter p-prod-code        as integer   no-undo .
     3731     define input  parameter p-b-code           as integer   no-undo .
     3732     define input  parameter p-start-fact-order as decimal   no-undo .
     3733     do
     3734     on error undo, return error return-value
     3735     :
     3736       run scan-doc-line in this-procedure
     3737         (input  p-obj-type
     3738         ,input  p-obj-code
     3739         ,input  p-artic
     3740         ,input  p-prod-type
     3741         ,input  p-prod-code
     3742         ,input  p-start-fact-order
     3743         ) .
     3744       run scan-price-list in this-procedure
     3745         (input p-obj-type
     3746         ,input p-obj-code
     3747         ,input p-b-code
     3748         ,input p-start-fact-order
     3749         ) .
     3750     end.
     3751   end procedure.
     3752   procedure goods-operation-list-show :
     3753     define buffer buf_goods-operation-list for goods-operation-list .
     3754     do
     3755     on error undo, return error return-value
     3756     :
     3757       for each buf_goods-operation-list
     3758         by buf_goods-operation-list.fact-order
     3759       on error undo, return error return-value
     3760       :
     3761         display buf_goods-operation-list .
     3762       end.
     3763     end.
     3764   end procedure.
     3765   procedure goods-operation-list-process :
     3766     define input  parameter p-obj-type        as character no-undo .
     3767     define input  parameter p-obj-code        as integer   no-undo .
     3768     define input  parameter p-artic           as character no-undo .
     3769     define input  parameter p-prod-type       as character no-undo .
     3770     define input  parameter p-prod-code       as integer   no-undo .
     3771     define input  parameter p-b-code          as integer   no-undo .
     3772     define input  parameter p-goods-gds-goods as logical   no-undo .
     3773     define input  parameter p-goods-twounit   as logical   no-undo .
     3774     define buffer buf_goods-operation-list for goods-operation-list .
     3775     define variable v-total-parts-qnty   as decimal   no-undo .
     3776     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3777     do
     3778     on error undo, return error return-value
     3779     :
     3780       for each buf_goods-operation-list
     3781       by buf_goods-operation-list.fact-order descending
     3782       :
     3783         case buf_goods-operation-list.table-name
     3784         :
     3785           when 'trn-doc':U
     3786           then do:
     3787             run partslib-process-document in this-procedure
     3788               (input  buf_goods-operation-list.doc-code
     3789               ,input  p-obj-type
     3790               ,input  p-obj-code
     3791               ,input  p-artic
     3792               ,input  p-prod-type
     3793               ,input  p-prod-code
     3794               ,input  p-goods-gds-goods
     3795               ,input  p-goods-twounit
     3796               ,output v-total-parts-qnty
     3797               ) no-error .
     3798             if error-status :error
     3799             then do:
     3800               message
     3801                 vss-workfile vss-revision vss-description skip
     3802                 "Ошибка при вызове процедуры partslib-process-document" skip
     3803                 "Документ" buf_goods-operation-list.doc-code skip
     3804                 "Объект" p-obj-type p-obj-code skip
     3805                 "Артикул" p-artic p-prod-type p-prod-code skip
     3806                 error-status :get-message(1) skip
     3807                 return-value skip
     3808                 view-as alert-box error .
     3809               undo, return error return-value .
     3810             end.
     3811             run prdoclib-process-document in this-procedure
     3812               (input  buf_goods-operation-list.doc-code
     3813               ,input  p-obj-type
     3814               ,input  p-obj-code
     3815               ,input  p-artic
     3816               ,input  p-prod-type
     3817               ,input  p-prod-code
     3818               ,output v-total-gds-dtl-qnty
     3819               ) no-error .
     3820             if error-status :error
     3821             then do:
     3822               message
     3823                 vss-workfile vss-revision vss-description skip
     3824                 "Ошибка при вызове процедуры prdoclib-process-document" skip
     3825                 "Документ" buf_goods-operation-list.doc-code skip
     3826                 "Объект" p-obj-type p-obj-code skip
     3827                 "Артикул" p-artic p-prod-type p-prod-code skip
     3828                 error-status :get-message(1) skip
     3829                 return-value skip
     3830                 view-as alert-box error .
     3831               undo, return error return-value .
     3832             end.
     3833             define variable v-error-exist as logical   no-undo .
     3834             run compare-parts-gds-dtl-total in this-procedure
     3835               (input  buf_goods-operation-list.doc-code
     3836               ,input  p-obj-type
     3837               ,input  p-obj-code
     3838               ,input  p-artic
     3839               ,input  p-prod-type
     3840               ,input  p-prod-code
     3841               ,input  v-total-parts-qnty
     3842               ,input  v-total-gds-dtl-qnty
     3843               ,output v-error-exist
     3844               ) no-error .
     3845             if error-status :error
     3846             then do:
     3847               message
     3848                 vss-workfile vss-revision vss-description skip
     3849                 "Ошибка при вызове процедуры compare-parts-prt-obj" skip
     3850                 "Документ" buf_goods-operation-list.doc-code skip
     3851                 "Объект" p-obj-type p-obj-code skip
     3852                 "Артикул" p-artic p-prod-type p-prod-code skip
     3853                 error-status :get-message(1) skip
     3854                 return-value skip
     3855                 view-as alert-box error .
     3856               undo, return error return-value .
     3857             end.
     3858             if v-error-exist = true
     3859             then do:
     3860               run temp-trn-doc-list-append in this-procedure
     3861                 (input buf_goods-operation-list.doc-code
     3862                 ) .
     3863             end.
     3864           end.
     3865           when 'price-doc':U
     3866           then do:
     3867             run price-list-verify in this-procedure
     3868               (input  buf_goods-operation-list.doc-code
     3869               ,input  p-obj-type
     3870               ,input  p-obj-code
     3871               ,input  p-artic
     3872               ,input  p-prod-type
     3873               ,input  p-prod-code
     3874               ,input  p-b-code
     3875               ,input  p-goods-twounit
     3876               ) .
     3877           end.
     3878           otherwise do:
     3879             message
     3880               vss-workfile vss-revision vss-description skip
     3881               "Внутренняя ошибка" skip
     3882               "Неизвестный тип таблицы" skip
     3883               "Код" buf_goods-operation-list.doc-code skip
     3884               "Тип" buf_goods-operation-list.table-name skip
     3885               view-as alert-box error .
     3886             undo, return error return-value .
     3887           end.
     3888         end case .
     3889       end.
     3890     end.
     3891   end procedure.
     3892   procedure price-list-verify :
     3893     define input  parameter p-doc-code      as character no-undo .
     3894     define input  parameter p-obj-type      as character no-undo .
     3895     define input  parameter p-obj-code      as integer   no-undo .
     3896     define input  parameter p-artic         as character no-undo .
     3897     define input  parameter p-prod-type     as character no-undo .
     3898     define input  parameter p-prod-code     as integer   no-undo .
     3899     define input  parameter p-b-code        as integer   no-undo .
     3900     define input  parameter p-goods-twounit as logical   no-undo .
     3901     define variable v-error-exist as logical   no-undo .
     3902     do
     3903     on error undo, return error return-value
     3904     :
     3905       run temp-price-list-parts-clear in this-procedure .
     3906       run temp-price-list-parts-init in this-procedure
     3907         (input  p-doc-code
     3908         ,input  p-obj-type
     3909         ,input  p-obj-code
     3910         ,input  p-artic
     3911         ,input  p-prod-type
     3912         ,input  p-prod-code
     3913         ,input  p-goods-twounit
     3914         ) .
     3915       run temp-price-list-parts-validate in this-procedure
     3916         (input  p-doc-code
     3917         ,output v-error-exist
     3918         ).
     3919       if v-error-exist = true
     3920       then do:
     3921         run temp-price-doc-list-append in this-procedure
     3922           (input p-doc-code
     3923           ) .
     3924       end.
     3925       run temp-price-list-gds-dtl-clear in this-procedure .
     3926       run temp-price-list-gds-dtl-init in this-procedure
     3927         (input  p-doc-code
     3928         ,input  p-obj-type
     3929         ,input  p-obj-code
     3930         ,input  p-artic
     3931         ,input  p-prod-type
     3932         ,input  p-prod-code
     3933         ,input  p-b-code
     3934         ,output v-error-exist
     3935         ) .
     3936       if v-error-exist = true
     3937       then do:
     3938         run temp-price-doc-list-append in this-procedure
     3939           (input p-doc-code
     3940           ) .
     3941       end.
     3942       run temp-price-list-gds-dtl-validate in this-procedure
     3943         (input  p-doc-code
     3944         ,input  p-obj-type
     3945         ,input  p-obj-code
     3946         ,input  p-artic
     3947         ,input  p-prod-type
     3948         ,input  p-prod-code
     3949         ,output v-error-exist
     3950         ).
     3951       if v-error-exist = true
     3952       then do:
     3953         run temp-price-doc-list-append in this-procedure
     3954           (input p-doc-code
     3955           ) .
     3956       end.
     3957     end.
     3958   end procedure.
     3959   procedure temp-price-list-parts-clear :
     3960     define buffer buf_temp-price-list-parts for temp-price-list-parts .
     3961     do
     3962     on error undo, return error return-value
     3963     :
     3964       for each buf_temp-price-list-parts
     3965       on error undo, return error return-value
     3966       :
     3967         delete buf_temp-price-list-parts .
     3968       end.
     3969     end.
     3970   end procedure.
     3971   procedure temp-price-list-parts-init :
     3972     define input  parameter p-doc-code      as character no-undo .
     3973     define input  parameter p-obj-type      as character no-undo .
     3974     define input  parameter p-obj-code      as integer   no-undo .
     3975     define input  parameter p-artic         as character no-undo .
     3976     define input  parameter p-prod-type     as character no-undo .
     3977     define input  parameter p-prod-code     as integer   no-undo .
     3978     define input  parameter p-goods-twounit as logical   no-undo .
     3979     define buffer buf_parts for ub.parts .
     3980     define buffer buf_temp-price-list-parts for temp-price-list-parts .
     3981     define variable v-base-part-code as character no-undo .
     3982     do
     3983     on error undo, return error return-value
     3984     :
     3985       for each buf_parts no-lock
     3986         where buf_parts.out-code  = p-doc-code
     3987           and buf_parts.obj-type  = p-obj-type
     3988           and buf_parts.obj-code  = p-obj-code
     3989           and buf_parts.artic     = p-artic
     3990           and buf_parts.prod-type = p-prod-type
     3991           and buf_parts.prod-code = p-prod-code
     3992       on error undo, return error return-value
     3993       :
     3994         if p-goods-twounit = true
     3995         then do:
     3996           assign
     3997             v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     3998           .
     3999         end.
     4000         else do:
     4001           assign
     4002             v-base-part-code = buf_parts.part-code
     4003           .
     4004         end.
     4005         find first buf_temp-price-list-parts
     4006           where buf_temp-price-list-parts.obj-type  = buf_parts.obj-type
     4007             and buf_temp-price-list-parts.obj-code  = buf_parts.obj-code
     4008             and buf_temp-price-list-parts.artic     = buf_parts.artic
     4009             and buf_temp-price-list-parts.prod-type = buf_parts.prod-type
     4010             and buf_temp-price-list-parts.prod-code = buf_parts.prod-code
     4011             and buf_temp-price-list-parts.in-code   = buf_parts.in-code
     4012             and buf_temp-price-list-parts.out-code  = buf_parts.out-code
     4013             and buf_temp-price-list-parts.part-code = v-base-part-code
     4014           no-error .
     4015         if not available buf_temp-price-list-parts
     4016         then do:
     4017           create buf_temp-price-list-parts .
     4018           buffer-copy buf_parts to buf_temp-price-list-parts
     4019           assign
     4020             buf_temp-price-list-parts.temp-price-list-parts-process = false
     4021             buf_temp-price-list-parts.part-code = v-base-part-code
     4022             buf_temp-price-list-parts.qnty      = 0
     4023             buf_temp-price-list-parts.fact-qnty = 0
     4024             buf_temp-price-list-parts.real-qnty = 0
     4025             buf_temp-price-list-parts.cli-qnty  = 0
     4026           .
     4027         end.
     4028         assign
     4029           buf_temp-price-list-parts.qnty      = buf_temp-price-list-parts.qnty
     4030                                               + buf_parts.qnty
     4031           buf_temp-price-list-parts.fact-qnty = buf_temp-price-list-parts.fact-qnty
     4032                                               + buf_parts.fact-qnty
     4033           buf_temp-price-list-parts.real-qnty = buf_temp-price-list-parts.real-qnty
     4034                                               + buf_parts.real-qnty
     4035           buf_temp-price-list-parts.cli-qnty  = buf_temp-price-list-parts.cli-qnty
     4036                                               + buf_parts.cli-qnty
     4037         .
     4038       end.
     4039     end.
     4040   end procedure.
     4041   procedure temp-price-list-parts-validate :
     4042     define input  parameter p-doc-code    as character no-undo .
     4043     define output parameter p-error-exist as logical   no-undo .
     4044     define buffer buf_temp-parts for temp-parts .
     4045     define buffer buf_temp-price-list-parts for temp-price-list-parts .
     4046     define variable v-difference-field-list as character no-undo .
     4047     do
     4048     on error undo, return error return-value
     4049     :
     4050       assign
     4051         p-error-exist = false
     4052       .
     4053       temp-parts_cycle:
     4054       for each buf_temp-parts
     4055       on error undo, return error return-value
     4056       :
     4057         find first buf_temp-price-list-parts
     4058           where buf_temp-price-list-parts.obj-type  = buf_temp-parts.obj-type
     4059             and buf_temp-price-list-parts.obj-code  = buf_temp-parts.obj-code
     4060             and buf_temp-price-list-parts.artic     = buf_temp-parts.artic
     4061             and buf_temp-price-list-parts.prod-type = buf_temp-parts.prod-type
     4062             and buf_temp-price-list-parts.prod-code = buf_temp-parts.prod-code
     4063             and buf_temp-price-list-parts.in-code   = buf_temp-parts.in-code
     4064             and buf_temp-price-list-parts.out-code  = p-doc-code
     4065             and buf_temp-price-list-parts.part-code = buf_temp-parts.part-code
     4066           no-error .
     4067         if not available buf_temp-price-list-parts
     4068         then do:
     4069           assign
     4070             p-error-number = p-error-number + 1
     4071           .
     4072           assign
     4073             p-error-exist = true
     4074           .
     4075           output stream sout to value(v-detail-err-file-name) append .
     4076           export stream sout '### error 1002':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4077           export stream sout 'не найдена партия в переоценке':U .
     4078           export stream sout 'price-doc':U p-doc-code .
     4079           export stream sout 'obj-type':U buf_temp-parts.obj-type .
     4080           export stream sout 'obj-code':U buf_temp-parts.obj-code .
     4081           export stream sout 'artic':U buf_temp-parts.artic .
     4082           export stream sout 'prod-type':U buf_temp-parts.prod-type .
     4083           export stream sout 'prod-code':U buf_temp-parts.prod-code .
     4084           export stream sout 'in-code':U buf_temp-parts.in-code .
     4085           export stream sout 'out-code':U buf_temp-parts.out-code .
     4086           export stream sout 'part-code':U buf_temp-parts.part-code .
     4087           export stream sout 'calculated parts.fact-qnty':U buf_temp-parts.fact-qnty  .
     4088           output stream sout close .
     4089           next temp-parts_cycle .
     4090         end.
     4091         assign
     4092           buf_temp-price-list-parts.temp-price-list-parts-process = true
     4093         .
     4094         buffer-compare buf_temp-parts
     4095           except
     4096             out-code
     4097             status_
     4098             rsrv-free
     4099           to buf_temp-price-list-parts
     4100           save result in v-difference-field-list
     4101           .
     4102         if v-difference-field-list = '':U
     4103         then do:
     4104           assign
     4105             p-error-number = p-error-number + 1
     4106           .
     4107           assign
     4108             p-error-exist = true
     4109           .
     4110           output stream sout to value(v-detail-err-file-name) append .
     4111           export stream sout '### error 1040':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4112           export stream sout 'вычисленная парти и партия переоценки различаются':U .
     4113           export stream sout 'список полей отличий':U v-difference-field-list .
     4114           export stream sout 'price-doc':U p-doc-code .
     4115           export stream sout 'obj-type':U buf_temp-parts.obj-type .
     4116           export stream sout 'obj-code':U buf_temp-parts.obj-code .
     4117           export stream sout 'artic':U buf_temp-parts.artic .
     4118           export stream sout 'prod-type':U buf_temp-parts.prod-type .
     4119           export stream sout 'prod-code':U buf_temp-parts.prod-code .
     4120           export stream sout 'in-code':U buf_temp-parts.in-code .
     4121           export stream sout 'out-code':U buf_temp-parts.out-code .
     4122           export stream sout 'part-code':U buf_temp-parts.part-code .
     4123           export stream sout 'calculated parts.fact-qnty':U buf_temp-parts.fact-qnty  .
     4124           export stream sout 'price-doc parts.fact-qnty':U buf_temp-price-list-parts.fact-qnty .
     4125           export stream sout 'вычисленная партия':U .
     4126           export stream sout buf_temp-parts .
     4127           export stream sout 'партия переоценки':U .
     4128           export stream sout buf_temp-price-list-parts .
     4129           output stream sout close .
     4130           next temp-parts_cycle .
     4131         end.
     4132       end.
     4133       for each buf_temp-price-list-parts
     4134         where buf_temp-price-list-parts.temp-price-list-parts-process = false
     4135       on error undo, return error return-value
     4136       :
     4137         assign
     4138           p-error-number = p-error-number + 1
     4139         .
     4140         assign
     4141           p-error-exist = true
     4142         .
     4143         output stream sout to value(v-detail-err-file-name) append .
     4144         export stream sout '### error 1075':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4145         export stream sout 'в переоценке найдена лишняя партия (не найдена вычисленная партия)':U .
     4146         export stream sout 'price-doc':U p-doc-code .
     4147         export stream sout 'obj-type':U buf_temp-price-list-parts.obj-type .
     4148         export stream sout 'obj-code':U buf_temp-price-list-parts.obj-code .
     4149         export stream sout 'artic':U buf_temp-price-list-parts.artic .
     4150         export stream sout 'prod-type':U buf_temp-price-list-parts.prod-type .
     4151         export stream sout 'prod-code':U buf_temp-price-list-parts.prod-code .
     4152         export stream sout 'in-code':U buf_temp-price-list-parts.in-code .
     4153         export stream sout 'out-code':U buf_temp-price-list-parts.out-code .
     4154         export stream sout 'part-code':U buf_temp-price-list-parts.part-code .
     4155         export stream sout 'difference-field-list':U v-difference-field-list .
     4156         export stream sout 'price-doc parts.fact-qnty':U buf_temp-price-list-parts.fact-qnty .
     4157         export stream sout 'партия переоценки':U .
     4158         export stream sout buf_temp-price-list-parts .
     4159         output stream sout close .
     4160       end.
     4161     end.
     4162   end procedure.
     4163   procedure temp-price-list-gds-dtl-clear :
     4164     define buffer buf_temp-price-list-gds-dtl for temp-price-list-gds-dtl .
     4165     do
     4166     on error undo, return error return-value
     4167     :
     4168       for each buf_temp-price-list-gds-dtl
     4169       on error undo, return error return-value
     4170       :
     4171         delete buf_temp-price-list-gds-dtl .
     4172       end.
     4173     end.
     4174   end procedure.
     4175   procedure temp-price-list-gds-dtl-init :
     4176     define input  parameter p-doc-code    as character no-undo .
     4177     define input  parameter p-obj-type    as character no-undo .
     4178     define input  parameter p-obj-code    as integer   no-undo .
     4179     define input  parameter p-artic       as character no-undo .
     4180     define input  parameter p-prod-type   as character no-undo .
     4181     define input  parameter p-prod-code   as integer   no-undo .
     4182     define input  parameter p-b-code      as integer   no-undo .
     4183     define output parameter p-error-exist as logical   no-undo .
     4184     define buffer buf_bar-code                for ub.bar-code .
     4185     define buffer buf_price-list              for ub.price-list .
     4186     define buffer buf_temp-price-list-gds-dtl for temp-price-list-gds-dtl .
     4187     do
     4188     on error undo, return error return-value
     4189     :
     4190       assign
     4191         p-error-exist = false
     4192       .
     4193       find first buf_price-list no-lock
     4194         where buf_price-list.doc-num    = p-doc-code
     4195           and buf_price-list.main-price = true
     4196           and buf_price-list.artic      = p-artic
     4197           and buf_price-list.prod-type  = p-prod-type
     4198           and buf_price-list.prod-code  = p-prod-code
     4199         no-error .
     4200       if not available buf_price-list
     4201       then do:
     4202         assign
     4203           p-error-number = p-error-number + 1
     4204         .
     4205         assign
     4206           p-error-exist = true
     4207         .
     4208         output stream sout to value(v-detail-err-file-name) append .
     4209         export stream sout '### error 1151':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4210         export stream sout 'ошибка при поиске основной цены':U .
     4211         export stream sout 'doc-code':U p-doc-code .
     4212         export stream sout 'artic':U p-artic .
     4213         export stream sout 'prod-type':U p-prod-type .
     4214         export stream sout 'prod-code':U p-prod-code .
     4215         output stream sout close .
     4216         return .
     4217       end.
     4218       find first buf_bar-code no-lock
     4219         where buf_bar-code.b-code = buf_price-list.b-code
     4220         no-error .
     4221       if not available buf_bar-code
     4222       then do:
     4223         assign
     4224           p-error-number = p-error-number + 1
     4225         .
     4226         assign
     4227           p-error-exist = true
     4228         .
     4229         output stream sout to value(v-detail-err-file-name) append .
     4230         export stream sout '### error 1174':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4231         export stream sout 'ошибка при поиске штрих-кода':U .
     4232         export stream sout 'doc-code':U buf_price-list.doc-num .
     4233         export stream sout 'artic':U buf_price-list.artic .
     4234         export stream sout 'prod-type':U buf_price-list.prod-type .
     4235         export stream sout 'prod-code':U buf_price-list.prod-code .
     4236         export stream sout 'b-code':U buf_price-list.b-code .
     4237         output stream sout close .
     4238         return .
     4239       end.
     4240       create buf_temp-price-list-gds-dtl .
     4241       assign
     4242         buf_temp-price-list-gds-dtl.b-code       = buf_price-list.b-code
     4243         buf_temp-price-list-gds-dtl.prt-code     = buf_bar-code.node-code
     4244         buf_temp-price-list-gds-dtl.price-sale   = buf_price-list.price-sale
     4245         buf_temp-price-list-gds-dtl.fact-qnty    = buf_price-list.doc-qnty
     4246         buf_temp-price-list-gds-dtl.gds-dtl-qnty = 0
     4247       .
     4248       price-list_cycle:
     4249       for each buf_price-list no-lock
     4250         where buf_price-list.doc-num    = p-doc-code
     4251           and buf_price-list.main-price = false
     4252           and buf_price-list.artic      = p-artic
     4253           and buf_price-list.prod-type  = p-prod-type
     4254           and buf_price-list.prod-code  = p-prod-code
     4255       on error undo, return error return-value
     4256       :
     4257         find first buf_bar-code no-lock
     4258           where buf_bar-code.b-code = buf_price-list.b-code
     4259           no-error .
     4260         if not available buf_bar-code
     4261         then do:
     4262           assign
     4263             p-error-number = p-error-number + 1
     4264           .
     4265           assign
     4266             p-error-exist = true
     4267           .
     4268           output stream sout to value(v-detail-err-file-name) append .
     4269           export stream sout '### error 1217':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4270           export stream sout 'ошибка при поиске штрих-кода':U .
     4271           export stream sout 'doc-code':U buf_price-list.doc-num .
     4272           export stream sout 'artic':U buf_price-list.artic .
     4273           export stream sout 'prod-type':U buf_price-list.prod-type .
     4274           export stream sout 'prod-code':U buf_price-list.prod-code .
     4275           export stream sout 'b-code':U buf_price-list.b-code .
     4276           output stream sout close .
     4277           next price-list_cycle .
     4278         end.
     4279         if buf_bar-code.in-code <> ""
     4280         or buf_bar-code.part-code <> ""
     4281         then do:
     4282           assign
     4283             p-error-number = p-error-number + 1
     4284           .
     4285           assign
     4286             p-error-exist = true
     4287           .
     4288           output stream sout to value(v-detail-err-file-name) append .
     4289           export stream sout '### error 1242':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4290           export stream sout 'цены для штрих-кодов партий не поддерживаются':U .
     4291           export stream sout 'doc-code':U buf_price-list.doc-num .
     4292           export stream sout 'artic':U buf_price-list.artic .
     4293           export stream sout 'prod-type':U buf_price-list.prod-type .
     4294           export stream sout 'prod-code':U buf_price-list.prod-code .
     4295           export stream sout 'b-code':U buf_price-list.b-code .
     4296           output stream sout close .
     4297           next price-list_cycle .
     4298         end.
     4299         if buf_bar-code.unit-cli <> v-unit-base
     4300         then do:
     4301           if buf_price-list.doc-qnty <> ?
     4302           then do:
     4303             assign
     4304               p-error-number = p-error-number + 1
     4305             .
     4306             assign
     4307               p-error-exist = true
     4308             .
     4309             output stream sout to value(v-detail-err-file-name) append .
     4310             export stream sout '### error 1268':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4311             export stream sout 'для неосновных единиц измерения количество должно равняться вопросительному знаку':U .
     4312             export stream sout 'doc-code':U buf_price-list.doc-num .
     4313             export stream sout 'artic':U buf_price-list.artic .
     4314             export stream sout 'prod-type':U buf_price-list.prod-type .
     4315             export stream sout 'prod-code':U buf_price-list.prod-code .
     4316             export stream sout 'b-code':U buf_price-list.b-code .
     4317             export stream sout 'unit-base':U v-unit-base .
     4318             export stream sout 'bar-code.unit-cli':U buf_bar-code.unit-cli .
     4319             export stream sout 'price-list.doc-qnty':U buf_price-list.doc-qnty .
     4320             output stream sout close .
     4321           end.
     4322           next price-list_cycle .
     4323         end.
     4324         create buf_temp-price-list-gds-dtl .
     4325         assign
     4326           buf_temp-price-list-gds-dtl.b-code                          = buf_price-list.b-code
     4327           buf_temp-price-list-gds-dtl.prt-code                        = buf_bar-code.node-code
     4328           buf_temp-price-list-gds-dtl.price-sale                      = buf_price-list.price-sale
     4329           buf_temp-price-list-gds-dtl.fact-qnty                       = buf_price-list.doc-qnty
     4330           buf_temp-price-list-gds-dtl.gds-dtl-qnty                    = 0
     4331         .
     4332       end.
     4333     end.
     4334   end procedure.
     4335   procedure temp-price-list-gds-dtl-validate :
     4336     define input  parameter p-doc-code    as character no-undo .
     4337     define input  parameter p-obj-type    as character no-undo .
     4338     define input  parameter p-obj-code    as integer   no-undo .
     4339     define input  parameter p-artic       as character no-undo .
     4340     define input  parameter p-prod-type   as character no-undo .
     4341     define input  parameter p-prod-code   as integer   no-undo .
     4342     define output parameter p-error-exist as logical   no-undo .
     4343     define buffer buf_gds-prt for ub.gds-prt .
     4344     define buffer buf_temp-prt-obj for temp-prt-obj .
     4345     define buffer buf_temp-price-list-gds-dtl for temp-price-list-gds-dtl .
     4346     define variable v-difference-field-list as character no-undo .
     4347     define variable v-error-exist           as logical   no-undo .
     4348     do
     4349     on error undo, return error return-value
     4350     :
     4351       assign
     4352         p-error-exist = false
     4353       .
     4354       temp-prt-obj_cycle:
     4355       for each buf_temp-prt-obj
     4356       on error undo, return error return-value
     4357       :
     4358         find first buf_gds-prt no-lock
     4359           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     4360           no-error .
     4361         if not available buf_gds-prt
     4362         then do:
     4363           assign
     4364             p-error-number = p-error-number + 1
     4365           .
     4366           assign
     4367             p-error-exist = true
     4368           .
     4369           output stream sout to value(v-detail-err-file-name) append .
     4370           export stream sout '### error 1344':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4371           export stream sout 'не найден признак шкалы':U .
     4372           export stream sout 'doc-code':U p-doc-code .
     4373           export stream sout 'obj-type':U p-obj-type .
     4374           export stream sout 'obj-code':U p-obj-code .
     4375           export stream sout 'artic':U p-artic .
     4376           export stream sout 'prod-type':U p-prod-type .
     4377           export stream sout 'prod-code':U p-prod-code .
     4378           export stream sout 'prt-code':U buf_temp-prt-obj.prt-code .
     4379           output stream sout close .
     4380           return .
     4381         end.
     4382         do while available buf_gds-prt
     4383         :
     4384           find first buf_temp-price-list-gds-dtl
     4385             where buf_temp-price-list-gds-dtl.prt-code = buf_gds-prt.node-code
     4386             no-error .
     4387           if available buf_temp-price-list-gds-dtl
     4388           then do:
     4389             assign
     4390               buf_temp-price-list-gds-dtl.gds-dtl-qnty = buf_temp-price-list-gds-dtl.gds-dtl-qnty
     4391                                                        + buf_temp-prt-obj.fact-qnty
     4392             .
     4393             next temp-prt-obj_cycle .
     4394           end.
     4395           define variable v-node-code as integer   no-undo .
     4396           assign
     4397             v-node-code = buf_gds-prt.upper-code
     4398           .
     4399           find first buf_gds-prt no-lock
     4400             where buf_gds-prt.node-code = v-node-code
     4401             no-error .
     4402         end.
     4403       end.
     4404       for each buf_temp-price-list-gds-dtl
     4405       on error undo, return error return-value
     4406       :
     4407         if buf_temp-price-list-gds-dtl.fact-qnty <> buf_temp-price-list-gds-dtl.gds-dtl-qnty
     4408         then do:
     4409           assign
     4410             p-error-number = p-error-number + 1
     4411           .
     4412           assign
     4413             p-error-exist = true
     4414           .
     4415           output stream sout to value(v-detail-err-file-name) append .
     4416           export stream sout '### error 1395':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4417           export stream sout 'отличия в количествах для переоценки и вычисленных количествах по признаку':U .
     4418           export stream sout 'doc-code':U p-doc-code .
     4419           export stream sout 'obj-type':U p-obj-type .
     4420           export stream sout 'obj-code':U p-obj-code .
     4421           export stream sout 'artic':U p-artic .
     4422           export stream sout 'prod-type':U p-prod-type .
     4423           export stream sout 'prod-code':U p-prod-code .
     4424           export stream sout 'b-code':U buf_temp-price-list-gds-dtl.b-code .
     4425           export stream sout 'prt-code':U buf_temp-price-list-gds-dtl.prt-code .
     4426           export stream sout 'price-sale':U buf_temp-price-list-gds-dtl.price-sale .
     4427           export stream sout 'fact-qnty':U buf_temp-price-list-gds-dtl.fact-qnty .
     4428           export stream sout 'gds-dtl-qnty':U buf_temp-price-list-gds-dtl.gds-dtl-qnty .
     4429           output stream sout close .
     4430         end.
     4431       end.
     4432     end.
     4433   end procedure.
     4434   procedure temp-price-doc-list-append :
     4435     define input  parameter p-doc-code as character no-undo .
     4436     define buffer buf_temp-price-doc-list for temp-price-doc-list .
     4437     define buffer buf_price-doc           for ub.price-doc .
     4438     do
     4439     on error undo, return error return-value
     4440     :
     4441       find first buf_temp-price-doc-list
     4442         where buf_temp-price-doc-list.doc-code = p-doc-code
     4443         no-error .
     4444       if not available buf_temp-price-doc-list
     4445       then do:
     4446         create buf_temp-price-doc-list .
     4447         assign
     4448           buf_temp-price-doc-list.doc-code = p-doc-code
     4449         .
     4450         find first buf_price-doc no-lock
     4451           where buf_price-doc.doc-num = p-doc-code
     4452           no-error .
     4453         if available buf_price-doc
     4454         then do:
     4455           assign
     4456             buf_temp-price-doc-list.fact-order = buf_price-doc.fact-order
     4457             buf_temp-price-doc-list.fact-date  = buf_price-doc.fact-date
     4458           .
     4459         end.
     4460       end.
     4461     end.
     4462   end procedure.
     4463   procedure temp-price-doc-list-export :
     4464     define input  parameter p-obj-type as character no-undo .
     4465     define input  parameter p-obj-code as integer   no-undo .
     4466     define buffer buf_temp-price-doc-list for temp-price-doc-list .
     4467     do
     4468     on error undo, return error return-value
     4469     :
     4470       find first buf_temp-price-doc-list
     4471         no-error .
     4472       if available buf_temp-price-doc-list
     4473       then do:
     4474         output stream sout to value(v-price-doc-list-file-name) append .
     4475         export stream sout '### list of error price-doc':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4476         export stream sout 'p-obj-type' p-obj-type .
     4477         export stream sout 'p-obj-code' p-obj-code .
     4478         for each buf_temp-price-doc-list
     4479         by buf_temp-price-doc-list.fact-order
     4480         on error undo, return error return-value
     4481         :
     4482           export stream sout
     4483             buf_temp-price-doc-list.doc-code
     4484             buf_temp-price-doc-list.fact-date
     4485             .
     4486         end.
     4487         output stream sout close .
     4488       end.
     4489     end.
     4490   end procedure.
     4491   procedure temp-trn-doc-list-append :
     4492     define input  parameter p-doc-code as character no-undo .
     4493     define buffer buf_temp-trn-doc-list for temp-trn-doc-list .
     4494     define buffer buf_trn-doc           for ub.trn-doc .
     4495     do
     4496     on error undo, return error return-value
     4497     :
     4498       find first buf_temp-trn-doc-list
     4499         where buf_temp-trn-doc-list.doc-code = p-doc-code
     4500         no-error .
     4501       if not available buf_temp-trn-doc-list
     4502       then do:
     4503         create buf_temp-trn-doc-list .
     4504         assign
     4505           buf_temp-trn-doc-list.doc-code = p-doc-code
     4506         .
     4507         find first buf_trn-doc no-lock
     4508           where buf_trn-doc.doc-code = p-doc-code
     4509           no-error .
     4510         if available buf_trn-doc
     4511         then do:
     4512           assign
     4513             buf_temp-trn-doc-list.fact-order = buf_trn-doc.fact-order
     4514             buf_temp-trn-doc-list.fact-date  = buf_trn-doc.fact-date
     4515           .
     4516         end.
     4517       end.
     4518     end.
     4519   end procedure.
     4520   procedure temp-trn-doc-list-export :
     4521     define input  parameter p-obj-type as character no-undo .
     4522     define input  parameter p-obj-code as integer   no-undo .
     4523     define buffer buf_temp-trn-doc-list for temp-trn-doc-list .
     4524     do
     4525     on error undo, return error return-value
     4526     :
     4527       find first buf_temp-trn-doc-list
     4528         no-error .
     4529       if available buf_temp-trn-doc-list
     4530       then do:
     4531         output stream sout to value(v-trn-doc-list-file-name) append .
     4532         export stream sout '### list of error trn-doc':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4533         export stream sout 'p-obj-type' p-obj-type .
     4534         export stream sout 'p-obj-code' p-obj-code .
     4535         for each buf_temp-trn-doc-list
     4536         by buf_temp-trn-doc-list.fact-order
     4537         on error undo, return error return-value
     4538         :
     4539           export stream sout
     4540             buf_temp-trn-doc-list.doc-code
     4541             buf_temp-trn-doc-list.fact-date
     4542             .
     4543         end.
     4544         output stream sout close .
     4545       end.
     4546     end.
     4547   end procedure.
     4548   procedure compare-parts-gds-dtl-total :
     4549     define input  parameter p-doc-code           as character no-undo .
     4550     define input  parameter p-obj-type           as character no-undo .
     4551     define input  parameter p-obj-code           as integer   no-undo .
     4552     define input  parameter p-artic              as character no-undo .
     4553     define input  parameter p-prod-type          as character no-undo .
     4554     define input  parameter p-prod-code          as integer   no-undo .
     4555     define input  parameter p-total-parts-qnty   as decimal   no-undo .
     4556     define input  parameter p-total-gds-dtl-qnty as decimal   no-undo .
     4557     define output parameter p-error-exist        as logical   no-undo .
     4558     define buffer buf_temp-parts   for temp-parts .
     4559     define buffer buf_temp-prt-obj for temp-prt-obj .
     4560     do
     4561     on error undo, return error return-value
     4562     :
     4563       assign
     4564         p-error-exist = false
     4565       .
     4566       if p-total-parts-qnty <> p-total-gds-dtl-qnty
     4567       then do:
     4568         assign
     4569           p-error-number = p-error-number + 1
     4570         .
     4571         output stream sout to value(v-detail-err-file-name) append .
     4572         export stream sout '### error 1587':U string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     4573         export stream sout 'для складского документа обнаружена разница в общем количестве по партиям и признакам':U .
     4574         export stream sout 'trn-doc':U p-doc-code .
     4575         export stream sout 'obj-type':U p-obj-type .
     4576         export stream sout 'obj-code':U p-obj-code .
     4577         export stream sout 'artic':U p-artic .
     4578         export stream sout 'prod-type':U p-prod-type .
     4579         export stream sout 'prod-code':U p-prod-code .
     4580         export stream sout 'p-total-parts-qnty':U p-total-parts-qnty .
     4581         export stream sout 'p-total-gds-dtl-qnty':U p-total-gds-dtl-qnty .
     4582         output stream sout close .
     4583         assign
     4584           p-error-exist = true
     4585         .
     4586       end.
     4587     end.
     4588   end procedure.
     4589   procedure temp-prt-obj-leave-term :
     4590     define buffer buf_temp-prt-obj for temp-prt-obj .
     4591     do
     4592     on error undo, return error return-value
     4593     :
     4594       for each buf_temp-prt-obj
     4595         where buf_temp-prt-obj.is-term <> true
     4596       :
     4597         delete buf_temp-prt-obj .
     4598       end.
     4599     end.
     4600   end procedure.
