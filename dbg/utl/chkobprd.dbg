     1266       for each buf_temp-prt-obj
     1267       ,first buf_prt-obj exclusive-lock
     1268         where recid(buf_prt-obj) = buf_temp-prt-obj.prt-obj-recid
     1269       on error undo, return error return-value
     1270       :
     1271         assign
     1272           buf_prt-obj.price-sale = buf_temp-prt-obj.price-sale
     1273         .
     1274       end.
     1275     end.
     1276   end procedure.
     1277   procedure prdoclib-clear-temp-prt-obj :
     1278     define buffer buf_temp-prt-obj for temp-prt-obj .
     1279     do
     1280     on error undo, return error return-value
     1281     :
     1282       for each buf_temp-prt-obj
     1283       on error undo, return error return-value
     1284       :
     1285         delete buf_temp-prt-obj .
     1286       end.
     1287     end.
     1288   end procedure.
     1289   procedure prdoclib-create-temp-prt-obj :
     1290     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1291     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1292     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1293     define buffer buf_gds-prt for ub.gds-prt .
     1294     do
     1295     on error undo, return error return-value
     1296     :
     1297       find first buf_temp-prt-obj
     1298         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1299         no-error .
     1300       if not available buf_temp-prt-obj
     1301       then do:
     1302         create buf_temp-prt-obj .
     1303         assign
     1304           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1305           buf_temp-prt-obj.price-sale       = ?
     1306           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1307           buf_temp-prt-obj.price-list-qnty  = ?
     1308           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1309           buf_temp-prt-obj.price-list-recid = ?
     1310         .
     1311         find first buf_gds-prt no-lock
     1312           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1313           .
     1314         assign
     1315           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1316         .
     1317         if buf_temp-prt-obj.is-term
     1318         then do:
     1319           assign
     1320             buf_temp-prt-obj.price-sale = p-root-price-sale
     1321           .
     1322         end.
     1323       end.
     1324     end.
     1325   end procedure.
     1326   procedure prdoclib-temp-prt-obj-by-prt-root :
     1327     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1328     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1329     define buffer buf_gds-prt for ub.gds-prt .
     1330     do
     1331     on error undo, return error return-value
     1332     :
     1333       find first buf_temp-prt-obj
     1334         where buf_temp-prt-obj.prt-code = p-prt-code
     1335         no-error .
     1336       if not available buf_temp-prt-obj
     1337       then do:
     1338         create buf_temp-prt-obj .
     1339         assign
     1340           buf_temp-prt-obj.prt-code         = p-prt-code
     1341           buf_temp-prt-obj.price-sale       = ?
     1342           buf_temp-prt-obj.fact-qnty        = 0
     1343           buf_temp-prt-obj.price-list-qnty  = ?
     1344           buf_temp-prt-obj.prt-obj-recid    = ?
     1345           buf_temp-prt-obj.price-list-recid = ?
     1346         .
     1347         find first buf_gds-prt no-lock
     1348           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1349           .
     1350         assign
     1351           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1352         .
     1353         if buf_temp-prt-obj.is-term
     1354         then do:
     1355           assign
     1356             buf_temp-prt-obj.price-sale = 0
     1357           .
     1358         end.
     1359       end.
     1360     end.
     1361   end procedure.
     1362   procedure prdoclib-init-temp-prt-obj :
     1363     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1364     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1365     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1366     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1367     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1368     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1369     define buffer buf_prt-obj      for ub.prt-obj .
     1370     define buffer buf_temp-prt-obj for temp-prt-obj .
     1371     do
     1372     on error undo, return error return-value
     1373     :
     1374       run prdoclib-clear-temp-prt-obj in this-procedure .
     1375       for each buf_prt-obj
     1376         where buf_prt-obj.obj-type  = p-obj-type
     1377           and buf_prt-obj.obj-code  = p-obj-code
     1378           and buf_prt-obj.artic     = p-artic
     1379           and buf_prt-obj.prod-type = p-prod-type
     1380           and buf_prt-obj.prod-code = p-prod-code
     1381       on error undo, return error return-value
     1382       :
     1383         run prdoclib-create-temp-prt-obj in this-procedure
     1384           (input  p-root-price-sale
     1385           ,buffer buf_prt-obj
     1386           ,buffer buf_temp-prt-obj
     1387           ).
     1388       end.
     1389     end.
     1390   end procedure.
     1391   procedure prdoclib-calc-fact-sale :
     1392     define input  parameter p-price-list-recid   as recid     no-undo .
     1393     define output parameter p-fact-qnty          as decimal   no-undo .
     1394     define output parameter p-cur-base           as decimal   no-undo .
     1395     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1396     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1397     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1398     define output parameter p-cur-excise-base    as decimal   no-undo .
     1399     define buffer buf_main_price-list for ub.price-list .
     1400     define buffer buf_price-list      for ub.price-list .
     1401     define buffer buf_goods           for ub.goods .
     1402     define buffer buf_gds-obj         for ub.gds-obj .
     1403     define buffer buf_bar-code        for ub.bar-code .
     1404     define variable l-empty-scale   as logical   no-undo .
     1405     do
     1406     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     1407     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     1408     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     1409     :
     1410       find first buf_main_price-list no-lock
     1411         where recid(buf_main_price-list) = p-price-list-recid
     1412         no-error .
     1413       if not available buf_main_price-list
     1414       then do:
     1415         message
     1416           vss-workfile vss-revision vss-description skip
     1417           vss-include-info7 skip
     1418           "Ошибка задания входных параметров" skip
     1419           "Не найдена строка переоценки" skip
     1420           "Код записи (recid)" p-price-list-recid skip
     1421           view-as alert-box error .
     1422         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1423       end.
     1424       if buf_main_price-list.main-price <> true
     1425       then do:
     1426         message
     1427           vss-workfile vss-revision vss-description skip
     1428           vss-include-info7 skip
     1429           "Ошибка задания входных параметров" skip
     1430           "Строка переоценки не является основной" skip
     1431           "Код записи (recid)" p-price-list-recid skip
     1432           "Переоценка" buf_main_price-list.doc-num skip
     1433           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1434           "Бар-код" buf_main_price-list.b-code skip
     1435           view-as alert-box error .
     1436         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     1437       end.
     1438       find first buf_goods no-lock
     1439         where buf_goods.artic     = buf_main_price-list.artic
     1440           and buf_goods.prod-type = buf_main_price-list.prod-type
     1441           and buf_goods.prod-code = buf_main_price-list.prod-code
     1442         no-error .
     1443       if not available buf_goods
     1444       then do:
     1445         message
     1446           vss-workfile vss-revision vss-description skip
     1447           vss-include-info7 skip
     1448           "Не найден товар" skip
     1449           "Переоценка" buf_main_price-list.doc-num skip
     1450           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1451           view-as alert-box error .
     1452         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1453       end.
     1454   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1456     (input  buf_main_price-list.artic
     1457     ,input  buf_main_price-list.prod-type
     1458     ,input  buf_main_price-list.prod-code
     1459     ,input  'empty-scale=request':u
     1460     ,output l-empty-scale
     1461     ) no-error .
     1462       if error-status :error
     1463       then do:
     1464         message
     1465           vss-workfile vss-revision vss-description skip
     1466           vss-include-info7 skip
     1467           "Ошибка при определении атрибута товара" skip
     1468           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1469           'empty-scale=request':u skip
     1470           error-status :get-message(1) skip
     1471           return-value skip
     1472           view-as alert-box error .
     1473         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1474       end.
     1475       find first buf_gds-obj no-lock
     1476         where buf_gds-obj.gds-code = buf_goods.gds-code
     1477           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     1478           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     1479         no-error .
     1480         if not available buf_gds-obj then do:
     1481   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1483     (input  buf_main_price-list.obj-type
     1484     ,input  buf_main_price-list.obj-code
     1485     ,input  buf_goods.artic
     1486     ,input  buf_goods.prod-type
     1487     ,input  buf_goods.prod-code
     1488     ,buffer buf_gds-obj
     1489     ) no-error .
     1490           if error-status :error then do:
     1491              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1492           end.
     1493         end.
     1494       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1495       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1496       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1497       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1498       define variable vat-base-sale-prl               as decimal   no-undo .
     1499       define variable vat-rubl-sale-prl               as decimal   no-undo .
     1500       define variable vat-base-buyer-prl              as decimal   no-undo .
     1501       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1502       define variable slt-base-sale-prl               as decimal   no-undo .
     1503       define variable slt-rubl-sale-prl               as decimal   no-undo .
     1504       define variable road-tax-base-sale-prl          as decimal   no-undo .
     1505       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1506       define variable excise-base-sale-prl            as decimal   no-undo .
     1507       define variable excise-rubl-sale-prl            as decimal   no-undo .
     1508       define variable discnt-base-sale-prl            as decimal   no-undo .
     1509       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1510       if buf_main_price-list.doc-qnty <> 0
     1511       then do:
     1512         run prl-vat in this-procedure
     1513           (input  recid(buf_main_price-list)
     1514           ,output price-rubl-with-tax-sale-prl
     1515           ,output price-base-with-tax-sale-prl
     1516           ,output price-rubl-without-tax-sale-prl
     1517           ,output price-base-without-tax-sale-prl
     1518           ,output vat-base-sale-prl
     1519           ,output vat-rubl-sale-prl
     1520           ,output vat-base-buyer-prl
     1521           ,output vat-rubl-buyer-prl
     1522           ,output slt-base-sale-prl
     1523           ,output slt-rubl-sale-prl
     1524           ,output road-tax-base-sale-prl
     1525           ,output road-tax-rubl-sale-prl
     1526           ,output excise-base-sale-prl
     1527           ,output excise-rubl-sale-prl
     1528           ,output discnt-base-sale-prl
     1529           ,output discnt-rubl-sale-prl
     1530           ) no-error .
     1531         if error-status :error
     1532         then do:
     1533           message
     1534             vss-workfile vss-revision vss-description skip
     1535             vss-include-info7 skip
     1536             "Ошибка при вызове процеды prl-vat" skip
     1537             "Документ" buf_main_price-list.doc-num skip
     1538             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1539             error-status :get-message(1) skip
     1540             return-value skip
     1541             view-as alert-box error .
     1542           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1543         end.
     1544       end.
     1545       else do:
     1546         assign
     1547           price-rubl-with-tax-sale-prl    = 0
     1548           price-base-with-tax-sale-prl    = 0
     1549           price-rubl-without-tax-sale-prl = 0
     1550           price-base-without-tax-sale-prl = 0
     1551           vat-base-sale-prl               = 0
     1552           vat-rubl-sale-prl               = 0
     1553           vat-base-buyer-prl              = 0
     1554           vat-rubl-buyer-prl              = 0
     1555           slt-base-sale-prl               = 0
     1556           slt-rubl-sale-prl               = 0
     1557           road-tax-base-sale-prl          = 0
     1558           road-tax-rubl-sale-prl          = 0
     1559           excise-base-sale-prl            = 0
     1560           excise-rubl-sale-prl            = 0
     1561           discnt-base-sale-prl            = 0
     1562           discnt-rubl-sale-prl            = 0
     1563         .
     1564       end.
     1565       define variable v-curr-r-b as character no-undo .
     1566   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1568     (output v-curr-r-b
     1569     )  .
     1570       if v-curr-r-b = 'base':U
     1571       then do:
     1572         assign
     1573           p-fact-qnty         = buf_main_price-list.doc-qnty
     1574           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1575           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     1576           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     1577           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     1578           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     1579         .
     1580       end.
     1581       else do:
     1582         assign
     1583           p-fact-qnty         = buf_main_price-list.doc-qnty
     1584           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1585           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     1586           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     1587           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     1588           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     1589         .
     1590       end.
     1591         define variable v-unit-base like ub.goods.unit-base no-undo .
     1592   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1593   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1594     (input  buf_goods.gds-code
     1595     ,output v-unit-base
     1596     ) no-error .
     1597         if error-status :error
     1598         then do:
     1599           message
     1600             vss-workfile vss-revision vss-description skip
     1601             vss-include-info7 skip
     1602             "Ошибка при определении базовой единицы измерения товара" skip
     1603             "Код товара" buf_goods.gds-code skip
     1604             error-status :get-message(1) skip
     1605             return-value skip
     1606             view-as alert-box error .
     1607           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1608         end.
     1609         for each buf_price-list no-lock
     1610           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1611             and buf_price-list.main-price = false
     1612             and buf_price-list.artic      = buf_main_price-list.artic
     1613             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     1614             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     1615         :
     1616           if buf_price-list.doc-qnty = ?
     1617           then do:
     1618             find first buf_bar-code no-lock
     1619               where buf_bar-code.b-code = buf_price-list.b-code
     1620               no-error .
     1621             if available buf_bar-code
     1622             and buf_bar-code.unit-cli = v-unit-base
     1623             then do:
     1624               message
     1625                 vss-workfile vss-revision vss-description skip
     1626                 vss-include-info7 skip
     1627                 "Ошибка при закрытии переоценки" skip
     1628                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1629                 "Переоценка" buf_main_price-list.doc-num skip
     1630                 "Бар-код" buf_price-list.b-code skip
     1631                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1632                 "Количество" buf_price-list.doc-qnty skip
     1633                 "Основная единица измерения" v-unit-base skip
     1634                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1635                 view-as alert-box error .
     1636               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1637             end.
     1638             next .
     1639           end.
     1640           if not can-find
     1641             (first buf_bar-code
     1642             where buf_bar-code.b-code = buf_price-list.b-code
     1643             )
     1644           then do:
     1645             message
     1646               vss-workfile vss-revision vss-description skip
     1647               vss-include-info7 skip
     1648               "В переоценке задан несуществующий бар-код" skip
     1649               "Переоценка" buf_price-list.doc-num skip
     1650               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1651               "Бар-код" buf_price-list.b-code skip
     1652               view-as alert-box error .
     1653             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1654           end.
     1655           if buf_price-list.doc-qnty <> 0
     1656           then do:
     1657             run prl-vat in this-procedure
     1658               (input  recid(buf_price-list)
     1659               ,output price-rubl-with-tax-sale-prl
     1660               ,output price-base-with-tax-sale-prl
     1661               ,output price-rubl-without-tax-sale-prl
     1662               ,output price-base-without-tax-sale-prl
     1663               ,output vat-base-sale-prl
     1664               ,output vat-rubl-sale-prl
     1665               ,output vat-base-buyer-prl
     1666               ,output vat-rubl-buyer-prl
     1667               ,output slt-base-sale-prl
     1668               ,output slt-rubl-sale-prl
     1669               ,output road-tax-base-sale-prl
     1670               ,output road-tax-rubl-sale-prl
     1671               ,output excise-base-sale-prl
     1672               ,output excise-rubl-sale-prl
     1673               ,output discnt-base-sale-prl
     1674               ,output discnt-rubl-sale-prl
     1675               ) no-error .
     1676             if error-status :error
     1677             then do:
     1678               message
     1679                 vss-workfile vss-revision vss-description skip
     1680                 vss-include-info7 skip
     1681                 "Ошибка при вызове процеды prl-vat" skip
     1682                 "Документ" buf_price-list.doc-num skip
     1683                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1684                 error-status :get-message(1) skip
     1685                 return-value skip
     1686                 view-as alert-box error .
     1687               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1688             end.
     1689           end.
     1690           else do:
     1691             assign
     1692               price-rubl-with-tax-sale-prl    = 0
     1693               price-base-with-tax-sale-prl    = 0
     1694               price-rubl-without-tax-sale-prl = 0
     1695               price-base-without-tax-sale-prl = 0
     1696               vat-base-sale-prl               = 0
     1697               vat-rubl-sale-prl               = 0
     1698               vat-base-buyer-prl              = 0
     1699               vat-rubl-buyer-prl              = 0
     1700               slt-base-sale-prl               = 0
     1701               slt-rubl-sale-prl               = 0
     1702               road-tax-base-sale-prl          = 0
     1703               road-tax-rubl-sale-prl          = 0
     1704               excise-base-sale-prl            = 0
     1705               excise-rubl-sale-prl            = 0
     1706               discnt-base-sale-prl            = 0
     1707               discnt-rubl-sale-prl            = 0
     1708             .
     1709           end.
     1710           if v-curr-r-b = 'base':U
     1711           then do:
     1712             assign
     1713               p-fact-qnty         = p-fact-qnty
     1714                                   + buf_price-list.doc-qnty
     1715               p-cur-base          = p-cur-base
     1716                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1717               p-cur-VAT-base      = p-cur-VAT-base
     1718                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1719               p-cur-SLT-base      = p-cur-SLT-base
     1720                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1721               p-cur-road-tax-base = p-cur-road-tax-base
     1722                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1723               p-cur-excise-base   = p-cur-excise-base
     1724                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1725             .
     1726           end.
     1727           else do:
     1728             assign
     1729               p-fact-qnty         = p-fact-qnty
     1730                                   + buf_price-list.doc-qnty
     1731               p-cur-base          = p-cur-base
     1732                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1733               p-cur-VAT-base      = p-cur-VAT-base
     1734                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1735               p-cur-SLT-base      = p-cur-SLT-base
     1736                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1737               p-cur-road-tax-base = p-cur-road-tax-base
     1738                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1739               p-cur-excise-base   = p-cur-excise-base
     1740                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1741             .
     1742           end.
     1743         end.
     1744     end.
     1745   end procedure.
     1746   procedure prdoclib-calc-prc :
     1747     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1748     define input  parameter p-cons-pay        as   integer                no-undo.
     1749     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1750     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1751     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1752     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1753     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1754     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1755     do
     1756     on error undo, return error return-value
     1757     :
     1758       define buffer buf_price-doc       for ub.price-doc .
     1759       define buffer buf_price-list      for ub.price-list .
     1760       define buffer buf_parts           for ub.parts .
     1761       define variable v-ov-qnty     as decimal   no-undo .
     1762       define variable v-ov-base     as decimal   no-undo .
     1763       define variable v-ov-VAT-base as decimal   no-undo .
     1764       define variable v-ov-SLT-base as decimal   no-undo .
     1765       define variable v-cons-qnty   as decimal   no-undo .
     1766       define variable v-prch-qnty   as decimal   no-undo .
     1767       define variable v-cons-mult   as decimal   no-undo .
     1768       define variable v-prch-mult   as decimal   no-undo .
     1769       find first buf_price-doc no-lock
     1770         where recid(buf_price-doc) = p-price-doc-recid
     1771         no-error .
     1772       if not available buf_price-doc
     1773       then do:
     1774         message
     1775           vss-workfile vss-revision vss-description skip
     1776           vss-include-info7 skip
     1777           "Ошибка задания входных параметров" skip
     1778           "Не найден документ переоценки" skip
     1779           "Код записи (recid)" p-price-doc-recid skip
     1780           view-as alert-box error .
     1781         undo, return error .
     1782       end.
     1783       for each buf_price-list no-lock
     1784         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1785           and buf_price-list.main-price = true
     1786       on error undo, return error return-value
     1787       :
     1788         run prdoclib-calc-ov
     1789           (input recid(buf_price-list)
     1790           ,output v-ov-qnty
     1791           ,output v-ov-base
     1792           ,output v-ov-VAT-base
     1793           ,output v-ov-SLT-base
     1794           ) no-error .
     1795         if error-status :error
     1796         then do:
     1797           if error-status :get-message(1) <> ""
     1798           then do:
     1799             message
     1800               vss-workfile vss-revision vss-description skip
     1801               vss-include-info7 skip
     1802               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1803               error-status :get-message(1) skip
     1804               return-value skip
     1805               view-as alert-box error .
     1806           end.
     1807           undo, return error return-value .
     1808         end.
     1809         assign
     1810           v-cons-qnty = 0
     1811           v-prch-qnty = 0
     1812         .
     1813         for each buf_parts no-lock
     1814           where buf_parts.out-code  = buf_price-list.doc-num
     1815             and buf_parts.obj-type  = buf_price-list.obj-type
     1816             and buf_parts.obj-code  = buf_price-list.obj-code
     1817             and buf_parts.artic     = buf_price-list.artic
     1818             and buf_parts.prod-type = buf_price-list.prod-type
     1819             and buf_parts.prod-code = buf_price-list.prod-code
     1820         on error undo, return error return-value
     1821         :
     1822           if buf_parts.pay-code = p-cons-pay
     1823           then do:
     1824             assign
     1825               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1826             .
     1827           end.
     1828           else do:
     1829             assign
     1830               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1831             .
     1832           end.
     1833         end.
     1834         if (v-cons-qnty + v-prch-qnty) = 0
     1835         then do:
     1836           assign
     1837             v-cons-mult = 0
     1838             v-prch-mult = 1
     1839           .
     1840         end.
     1841         else do:
     1842           assign
     1843             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1844             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1845           .
     1846         end.
     1847         assign
     1848           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1849           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1850           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1851           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1852           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1853           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1854         .
     1855       end.
     1856     end.
     1857   end procedure.
     1858   procedure prdoclib-calc-ov :
     1859     define input  parameter p-price-list-recid as recid     no-undo .
     1860     define output parameter p-fact-qnty        as decimal   no-undo .
     1861     define output parameter p-ov-base          as decimal   no-undo .
     1862     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1863     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1864     do
     1865     on error undo, return error return-value
     1866     :
     1867       define buffer buf_main_price-list    for ub.price-list .
     1868       define buffer buf_prev_price-list    for ub.price-list .
     1869       define buffer buf_special_price-list for ub.price-list .
     1870       define buffer buf_goods              for ub.goods .
     1871       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1872       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1873       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1874       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1875       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1876       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1877       define variable v-prev-price-list-recid as   recid                  no-undo.
     1878       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1879       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1880       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1881       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1882       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1883       find first buf_main_price-list no-lock
     1884         where recid(buf_main_price-list) = p-price-list-recid
     1885         no-error .
     1886       if not available buf_main_price-list
     1887       then do:
     1888         message
     1889           vss-workfile vss-revision vss-description skip
     1890           vss-include-info7 skip
     1891           "Ошибка задания входных параметров" skip
     1892           "Не найдена строка переоценки" skip
     1893           "Код записи (recid)" p-price-list-recid skip
     1894           view-as alert-box error .
     1895         undo, return error .
     1896       end.
     1897       if buf_main_price-list.main-price <> true
     1898       then do:
     1899         message
     1900           vss-workfile vss-revision vss-description skip
     1901           vss-include-info7 skip
     1902           "Ошибка задания входных параметров" skip
     1903           "Строка переоценки не является основной" skip
     1904           "Код записи (recid)" p-price-list-recid skip
     1905           "Переоценка" buf_main_price-list.doc-num skip
     1906           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1907           "Бар-код" buf_main_price-list.b-code skip
     1908           view-as alert-box error .
     1909         undo, return error .
     1910       end.
     1911       run prdoclib-calc-fact-sale in this-procedure
     1912         (input  recid(buf_main_price-list)
     1913         ,output v-fact-qnty
     1914         ,output v-cur-base
     1915         ,output v-cur-VAT-base
     1916         ,output v-cur-SLT-base
     1917         ,output v-cur-road-tax-base
     1918         ,output v-cur-excise-base
     1919         ) no-error.
     1920       if error-status :error
     1921       then do:
     1922         message
     1923           vss-workfile vss-revision vss-description skip
     1924           vss-include-info7 skip
     1925           "Ошибка при расчете сумм переоценки." skip
     1926           "Документ переоценки" buf_main_price-list.doc-num skip
     1927           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1928           error-status :get-message(1) skip
     1929           return-value skip
     1930           view-as alert-box error .
     1931         undo, return error .
     1932       end.
     1933   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1935     (input  buf_main_price-list.obj-type
     1936     ,input  buf_main_price-list.obj-code
     1937     ,input  buf_main_price-list.b-code
     1938     ,input  buf_main_price-list.b-code
     1939     ,input  buf_main_price-list.fact-order
     1940     ,output v-prev-price-list-recid
     1941     ,output v-prev-cli-base-rate
     1942     ) no-error .
     1943       if error-status :error
     1944       then do:
     1945         message
     1946           vss-workfile vss-revision vss-description skip
     1947           vss-include-info7 skip
     1948           "Ошибка при поиске предыдущей переоценки." skip
     1949           "Документ переоценки " buf_main_price-list.doc-num skip
     1950           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1951           error-status :get-message(1) skip
     1952           return-value skip
     1953           view-as alert-box error .
     1954         undo, return error .
     1955       end.
     1956       if v-prev-price-list-recid <> ?
     1957       then do:
     1958         find first buf_prev_price-list no-lock
     1959           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1960           .
     1961         find first buf_special_price-list no-lock
     1962           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1963             and buf_special_price-list.main-price = false
     1964             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1965             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1966             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1967             and buf_special_price-list.doc-qnty   <> ?
     1968           no-error .
     1969         if available buf_special_price-list
     1970         then do:
     1971           message
     1972             "Товар имеет специальные цены на признаки" skip
     1973             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1974             "Переоценка" buf_prev_price-list.doc-num skip
     1975             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1976             view-as alert-box error .
     1977           undo, return error .
     1978         end.
     1979         find first buf_goods no-lock
     1980           where buf_goods.artic     = buf_main_price-list.artic
     1981             and buf_goods.prod-type = buf_main_price-list.prod-type
     1982             and buf_goods.prod-code = buf_main_price-list.prod-code
     1983           no-error .
     1984         if not available buf_goods
     1985         then do:
     1986           message
     1987             vss-workfile vss-revision vss-description skip
     1988             vss-include-info7 skip
     1989             "Не найден товар" skip
     1990             "Переоценка" buf_main_price-list.doc-num skip
     1991             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1992             view-as alert-box error .
     1993           undo, return error .
     1994         end.
     1995         if buf_prev_price-list.vat-pc = ?
     1996         or buf_prev_price-list.slt-pc = ?
     1997         then do:
     1998           message
     1999             "В переоценке не заданы налоги товара" skip
     2000             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2001             "Переоценка" buf_prev_price-list.doc-num skip
     2002             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2003             "НДС" buf_prev_price-list.vat-pc skip
     2004             "НП" buf_prev_price-list.slt-pc skip
     2005             view-as alert-box error .
     2006           undo, return error return-value .
     2007         end.
     2008         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2009         assign
     2010           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2011         .
     2012         assign
     2013           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2014           v-prev-cur-VAT-base = v-fact-qnty
     2015                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2016                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2017           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2018         .
     2019         assign
     2020           p-fact-qnty   = v-fact-qnty
     2021           p-ov-base     = v-cur-base     - v-prev-cur-base
     2022           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2023           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2024         .
     2025       end.
     2026       else do:
     2027         assign
     2028           v-prev-cur-base     = 0
     2029           v-prev-cur-VAT-base = 0
     2030           v-prev-cur-SLT-base = 0
     2031           .
     2032         assign
     2033           p-fact-qnty   = v-fact-qnty
     2034           p-ov-base     = v-cur-base     - v-prev-cur-base
     2035           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2036           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2037         .
     2038       end.
     2039     end.
     2040   end procedure.
     2041   procedure prdoclib-init-prt-obj-by-factord :
     2042     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2043     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2044     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2045     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2046     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2047     define input parameter p-fact-order         as decimal   no-undo .
     2048     define input parameter p-include-fact-order as logical   no-undo .
     2049     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2050     define buffer buf_gds-obj      for ub.gds-obj .
     2051     define buffer buf_doc-line     for ub.doc-line .
     2052     define buffer buf_temp-prt-obj for temp-prt-obj .
     2053     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2054     do
     2055     on error undo, return error return-value
     2056     :
     2057       do transaction
     2058       on error undo, return error return-value
     2059       :
     2060   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2061   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2062     (input  p-obj-type
     2063     ,input  p-obj-code
     2064     ,input  p-artic
     2065     ,input  p-prod-type
     2066     ,input  p-prod-code
     2067     ,buffer buf_gds-obj
     2068     ) no-error .
     2069         if error-status :error
     2070         then do:
     2071           message
     2072             vss-workfile vss-revision vss-description skip
     2073             vss-include-info7 skip
     2074             "Невозможно найти gds-obj" skip
     2075             error-status :get-message(1) skip
     2076             return-value skip
     2077             view-as alert-box error .
     2078           undo, return error .
     2079         end.
     2080         find current buf_gds-obj exclusive-lock .
     2081       end.
     2082       run prdoclib-init-temp-prt-obj in this-procedure
     2083         (input p-obj-type
     2084         ,input p-obj-code
     2085         ,input p-artic
     2086         ,input p-prod-type
     2087         ,input p-prod-code
     2088         ,input 0
     2089         ) .
     2090       for each buf_temp-prt-obj
     2091         where buf_temp-prt-obj.is-term <> true
     2092       on error undo, return error return-value
     2093       :
     2094         delete buf_temp-prt-obj .
     2095       end.
     2096       if p-include-fact-order = true
     2097       then do:
     2098         assign
     2099          p-fact-order = p-fact-order - 0.0000000001
     2100         .
     2101       end.
     2102       for each buf_doc-line no-lock
     2103         where buf_doc-line.obj-type   = p-obj-type
     2104           and buf_doc-line.obj-code   = p-obj-code
     2105           and buf_doc-line.artic      = p-artic
     2106           and buf_doc-line.prod-type  = p-prod-type
     2107           and buf_doc-line.prod-code  = p-prod-code
     2108           and buf_doc-line.status_    = 'факт':U
     2109           and buf_doc-line.fact-order >= p-fact-order
     2110       on error undo, return error return-value
     2111       :
     2112         run prdoclib-process-document in this-procedure
     2113           (input  buf_doc-line.doc-code
     2114           ,input  p-obj-type
     2115           ,input  p-obj-code
     2116           ,input  p-artic
     2117           ,input  p-prod-type
     2118           ,input  p-prod-code
     2119           ,output v-total-gds-dtl-qnty
     2120           ) .
     2121       end.
     2122     end.
     2123   end procedure.
     2124   procedure prdoclib-process-document :
     2125     define input  parameter p-doc-code           as character no-undo .
     2126     define input  parameter p-obj-type           as character no-undo .
     2127     define input  parameter p-obj-code           as integer   no-undo .
     2128     define input  parameter p-artic              as character no-undo .
     2129     define input  parameter p-prod-type          as character no-undo .
     2130     define input  parameter p-prod-code          as integer   no-undo .
     2131     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2132     define buffer buf_trn-doc      for ub.trn-doc .
     2133     define buffer buf_gds-dtl      for ub.gds-dtl .
     2134     define buffer buf_temp-prt-obj for temp-prt-obj .
     2135     do
     2136     on error undo, return error return-value
     2137     :
     2138       find first buf_trn-doc no-lock
     2139         where buf_trn-doc.doc-code = p-doc-code
     2140         no-error .
     2141       if not available buf_trn-doc then do:
     2142         message
     2143           vss-workfile vss-revision vss-description skip
     2144           vss-include-info7 skip
     2145           "Ошибка при поиске документа" skip
     2146           "Документ" p-doc-code skip
     2147           "Объект" p-obj-type p-obj-code skip
     2148           "Артикул" p-artic p-prod-type p-prod-code skip
     2149           view-as alert-box error .
     2150         undo, return error .
     2151       end.
     2152       assign
     2153         p-total-gds-dtl-qnty = 0
     2154       .
     2155       for each buf_gds-dtl no-lock
     2156         where buf_gds-dtl.doc-code  = p-doc-code
     2157           and buf_gds-dtl.artic     = p-artic
     2158           and buf_gds-dtl.prod-type = p-prod-type
     2159           and buf_gds-dtl.prod-code = p-prod-code
     2160       on error undo, return error
     2161       :
     2162         define variable v-term-node as integer   no-undo .
     2163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2164     (input  buf_gds-dtl.prt-code
     2165     ,output v-term-node
     2166     )  .
     2167         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2168           (input  v-term-node
     2169           ,buffer buf_temp-prt-obj
     2170           ) .
     2171         if buf_temp-prt-obj.is-term <> true then do:
     2172           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2173                                        ,buf_gds-dtl.prt-code
     2174                                        ) .
     2175         end.
     2176         case buf_trn-doc.doc-type :
     2177           when 'при':U or
     2178           when 'возврат':U
     2179           then do:
     2180             assign
     2181               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2182                                           - buf_gds-dtl.fact-qnty
     2183               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2184                                           - buf_gds-dtl.fact-qnty
     2185             .
     2186           end.
     2187           when 'рас':U or
     2188           when 'спи':U
     2189           then do:
     2190             assign
     2191               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2192                                           + buf_gds-dtl.fact-qnty
     2193               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2194                                           + buf_gds-dtl.fact-qnty
     2195             .
     2196           end.
     2197           when 'инв':U
     2198           then do:
     2199             assign
     2200               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2201                                           - buf_gds-dtl.doc-qnty
     2202               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2203                                           - buf_gds-dtl.doc-qnty
     2204             .
     2205           end.
     2206           otherwise do:
     2207             undo, return error substitute("Неизвестный тип документа &1"
     2208                                          ,buf_trn-doc.doc-type
     2209                                          ) .
     2210           end.
     2211         end.
     2212       end.
     2213     end.
     2214   end procedure.
     2215   procedure prdoclib-prc-pl-document :
     2216     define input  parameter p-doc-code              as character no-undo .
     2217     define input  parameter p-obj-type              as character no-undo .
     2218     define input  parameter p-obj-code              as integer   no-undo .
     2219     define input  parameter p-gds-code              as integer   no-undo .
     2220     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2221     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2222     do
     2223     on error undo, return error return-value
     2224     :
     2225       define buffer buf_trn-doc      for ub.trn-doc .
     2226       define buffer buf_doc-pl       for ub.doc-pl .
     2227       define buffer buf_temp-pl-gds for temp-pl-gds .
     2228       define variable v-sign as decimal   no-undo .
     2229       find first buf_trn-doc no-lock
     2230         where buf_trn-doc.doc-code = p-doc-code
     2231         no-error .
     2232       if not available buf_trn-doc then do:
     2233         message
     2234           vss-workfile vss-revision vss-description skip
     2235           vss-include-info7 skip
     2236           "Ошибка при поиске документа" skip
     2237           "Документ" p-doc-code skip
     2238           "Объект" p-obj-type p-obj-code skip
     2239           "Товар" p-gds-code skip
     2240           view-as alert-box error .
     2241         undo, return error .
     2242       end.
     2243       assign
     2244         p-total-pl-gds-qnty     = 0
     2245         p-total-pl-gds-cli-qnty = 0
     2246       .
     2247       for each buf_doc-pl no-lock
     2248         where buf_doc-pl.out-code  = p-doc-code
     2249           and buf_doc-pl.gds-code  = p-gds-code
     2250       on error undo, return error return-value
     2251       :
     2252         find first buf_temp-pl-gds
     2253           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2254             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2255             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2256           .
     2257         case buf_trn-doc.doc-type :
     2258           when 'при':U
     2259           or when 'возврат':U
     2260           or when 'инв':U
     2261           then do:
     2262             assign
     2263               v-sign = -1.0
     2264             .
     2265           end.
     2266           when 'рас':U or
     2267           when 'спи':U
     2268           then do:
     2269             assign
     2270               v-sign = 1.0
     2271             .
     2272           end.
     2273           otherwise do:
     2274             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2275           end.
     2276         end case.
     2277         assign
     2278           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2279           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2280           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2281           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2282         .
     2283       end.
     2284     end.
     2285   end procedure.
     2286   procedure prdoclib-init-prt-obj-by-date :
     2287     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2288     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2289     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2290     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2291     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2292     define input parameter p-fact-date  as date      no-undo .
     2293     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2294     do
     2295     on error undo, return error return-value
     2296     :
     2297       define variable v-fact-order                as decimal   no-undo .
     2298       define variable v-shift-end-fact-order      as decimal   no-undo .
     2299       define variable v-day-end-fact-order        as decimal   no-undo .
     2300       run factord in this-procedure
     2301         (input  p-fact-date
     2302         ,input  1
     2303         ,input  1
     2304         ,input  ?
     2305         ,input  0
     2306         ,input  false
     2307         ,output v-fact-order
     2308         ,output v-shift-end-fact-order
     2309         ,output v-day-end-fact-order
     2310         ) no-error .
     2311       if error-status :error
     2312       then do:
     2313         message
     2314           vss-workfile vss-revision vss-description skip
     2315           vss-include-info7 skip
     2316           "Ошибка при определении момента времени, на который требуется остаток" skip
     2317           "Объект" p-obj-type p-obj-code skip
     2318           "Артикул" p-artic p-prod-type p-prod-code skip
     2319           "Дата" p-fact-date skip
     2320           view-as alert-box error .
     2321         undo, return error .
     2322       end.
     2323       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2324         (input p-obj-type
     2325         ,input p-obj-code
     2326         ,input p-artic
     2327         ,input p-prod-type
     2328         ,input p-prod-code
     2329         ,input v-day-end-fact-order
     2330         ,input false
     2331         ) no-error .
     2332       if error-status :error
     2333       then do:
     2334         message
     2335           vss-workfile vss-revision vss-description skip
     2336           vss-include-info7 skip
     2337           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2338           "Объект" p-obj-type p-obj-code skip
     2339           "Артикул" p-artic p-prod-type p-prod-code skip
     2340           "Дата" p-fact-date skip
     2341           view-as alert-box error .
     2342         undo, return error .
     2343       end.
     2344     end.
     2345   end procedure.
     2346   procedure prdoclib-calc-temp-fact-sale :
     2347     define input  parameter p-obj-type           as character no-undo .
     2348     define input  parameter p-obj-code           as integer   no-undo .
     2349     define input  parameter p-gds-code           as integer   no-undo .
     2350     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2351     define input  parameter p-curr-r-b           as character no-undo .
     2352     define output parameter p-fact-qnty          as decimal   no-undo .
     2353     define output parameter p-cur-base           as decimal   no-undo .
     2354     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2355     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2356     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2357     define output parameter p-cur-excise-base    as decimal   no-undo .
     2358     define buffer buf_temp-prt-obj for temp-prt-obj .
     2359     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2360     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2361     define variable parrecid-prl        as recid     no-undo .
     2362     define variable v-fact-qnty         as decimal   no-undo .
     2363     define variable v-cur-base          as decimal   no-undo .
     2364     define variable v-cur-VAT-base      as decimal   no-undo .
     2365     define variable v-cur-SLT-base      as decimal   no-undo .
     2366     define variable v-cur-road-tax-base as decimal   no-undo .
     2367     define variable v-cur-excise-base   as decimal   no-undo .
     2368     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2369     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2370     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2371     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2372     define variable vat-base-sale-prl               as decimal   no-undo .
     2373     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2374     define variable vat-base-buyer-prl              as decimal   no-undo .
     2375     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2376     define variable slt-base-sale-prl               as decimal   no-undo .
     2377     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2378     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2379     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2380     define variable excise-base-sale-prl            as decimal   no-undo .
     2381     define variable excise-rubl-sale-prl            as decimal   no-undo .
     2382     define variable discnt-base-sale-prl            as decimal   no-undo .
     2383     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2384     do
     2385     on error undo, return error return-value
     2386     :
     2387       for each buf_temp-prt-obj no-lock
     2388       on error undo, return error return-value
     2389       :
     2390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2391     (input  p-gds-code
     2392     ,input  buf_temp-prt-obj.prt-code
     2393     ,output v-prt-b-code
     2394     ) no-error .
     2395         if error-status :error
     2396         then do:
     2397           message
     2398             vss-workfile vss-revision vss-description skip
     2399             "Ошибка при определении бар-кода признака" skip
     2400             "Код товара"   p-gds-code skip
     2401             "Код признака" buf_temp-prt-obj.prt-code skip
     2402             error-status :get-message(1) skip
     2403             return-value skip
     2404             view-as alert-box error .
     2405           undo, return error .
     2406         end.
     2407   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2408   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2409     (input  p-obj-type
     2410     ,input  p-obj-code
     2411     ,input  v-prt-b-code
     2412     ,input  0
     2413     ,input  p-day-end-fact-order
     2414     ,output parrecid-prl
     2415     ,output v-cli-base-rate
     2416     ) no-error .
     2417         if error-status :error
     2418         then do:
     2419           message
     2420             vss-workfile vss-revision vss-description skip
     2421             "Ошибка при определении цены бар-кода" skip
     2422             "Объект" p-obj-type p-obj-code skip
     2423             "Бар-код" v-prt-b-code skip
     2424             "fact-order" p-day-end-fact-order skip
     2425             error-status :get-message(1) skip
     2426             return-value skip
     2427             view-as alert-box error .
     2428           undo, return error .
     2429         end.
     2430         if parrecid-prl <> ?
     2431         then do:
     2432           run prl-vat in this-procedure
     2433             (input  parrecid-prl
     2434             ,output price-rubl-with-tax-sale-prl
     2435             ,output price-base-with-tax-sale-prl
     2436             ,output price-rubl-without-tax-sale-prl
     2437             ,output price-base-without-tax-sale-prl
     2438             ,output vat-base-sale-prl
     2439             ,output vat-rubl-sale-prl
     2440             ,output vat-base-buyer-prl
     2441             ,output vat-rubl-buyer-prl
     2442             ,output slt-base-sale-prl
     2443             ,output slt-rubl-sale-prl
     2444             ,output road-tax-base-sale-prl
     2445             ,output road-tax-rubl-sale-prl
     2446             ,output excise-base-sale-prl
     2447             ,output excise-rubl-sale-prl
     2448             ,output discnt-base-sale-prl
     2449             ,output discnt-rubl-sale-prl
     2450             ) no-error .
     2451           if error-status :error
     2452           then do:
     2453             message
     2454               vss-workfile vss-revision vss-description skip
     2455               "Ошибка при вызове процеды prl-vat" skip
     2456               "Объект" p-obj-type p-obj-code skip
     2457               "Код товара" p-gds-code skip
     2458               "Указатель на запись переоценки" parrecid-prl skip
     2459               error-status :get-message(1) skip
     2460               return-value skip
     2461               view-as alert-box error .
     2462             undo, return error .
     2463           end.
     2464         end.
     2465         else do:
     2466           assign
     2467             price-rubl-with-tax-sale-prl    = 0
     2468             price-base-with-tax-sale-prl    = 0
     2469             price-rubl-without-tax-sale-prl = 0
     2470             price-base-without-tax-sale-prl = 0
     2471             vat-base-sale-prl               = 0
     2472             vat-rubl-sale-prl               = 0
     2473             slt-base-sale-prl               = 0
     2474             slt-rubl-sale-prl               = 0
     2475             road-tax-base-sale-prl          = 0
     2476             road-tax-rubl-sale-prl          = 0
     2477             excise-base-sale-prl            = 0
     2478             excise-rubl-sale-prl            = 0
     2479             discnt-base-sale-prl            = 0
     2480             discnt-rubl-sale-prl            = 0
     2481           .
     2482         end.
     2483         assign
     2484           v-fact-qnty         = v-fact-qnty
     2485                               + buf_temp-prt-obj.fact-qnty
     2486           v-cur-base          = v-cur-base
     2487                               + (if p-curr-r-b = 'base':U
     2488                                   then price-base-with-tax-sale-prl
     2489                                   else price-rubl-with-tax-sale-prl
     2490                                 )
     2491                               * buf_temp-prt-obj.fact-qnty
     2492           v-cur-VAT-base      = v-cur-VAT-base
     2493                               + (if p-curr-r-b = 'base':U
     2494                                   then vat-base-sale-prl
     2495                                   else vat-rubl-sale-prl
     2496                                 )
     2497                               * buf_temp-prt-obj.fact-qnty
     2498           v-cur-SLT-base      = v-cur-SLT-base
     2499                               + (if p-curr-r-b = 'base':U
     2500                                   then slt-base-sale-prl
     2501                                   else slt-rubl-sale-prl
     2502                                 )
     2503                               * buf_temp-prt-obj.fact-qnty
     2504           v-cur-road-tax-base = v-cur-road-tax-base
     2505                               + (if p-curr-r-b = 'base':U
     2506                                   then road-tax-base-sale-prl
     2507                                   else road-tax-rubl-sale-prl
     2508                                 )
     2509                               * buf_temp-prt-obj.fact-qnty
     2510           v-cur-excise-base   = v-cur-excise-base
     2511                               + (if p-curr-r-b = 'base':U
     2512                                   then excise-base-sale-prl
     2513                                   else excise-rubl-sale-prl
     2514                                 )
     2515                               * buf_temp-prt-obj.fact-qnty
     2516         .
     2517       end.
     2518       assign
     2519         p-fact-qnty         = v-fact-qnty
     2520         p-cur-base          = v-cur-base
     2521         p-cur-VAT-base      = v-cur-VAT-base
     2522         p-cur-SLT-base      = v-cur-SLT-base
     2523         p-cur-road-tax-base = v-cur-road-tax-base
     2524         p-cur-excise-base   = v-cur-excise-base
     2525       .
     2526     end.
     2527   end procedure.
     2528   procedure prdoclib-clear-temp-pl-gds :
     2529     define buffer buf_temp-pl-gds for temp-pl-gds .
     2530     do
     2531     on error undo, return error return-value
     2532     :
     2533       for each buf_temp-pl-gds
     2534       on error undo, return error return-value
     2535       :
     2536         delete buf_temp-pl-gds .
     2537       end.
     2538     end.
     2539   end procedure.
     2540   procedure prdoclib-init-temp-pl-gds :
     2541     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2542     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2543     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2544     define buffer buf_pl-gds      for ub.pl-gds .
     2545     define buffer buf_temp-pl-gds for temp-pl-gds .
     2546     do
     2547     on error undo, return error return-value
     2548     :
     2549       run prdoclib-clear-temp-pl-gds in this-procedure .
     2550       for each buf_pl-gds
     2551         where buf_pl-gds.obj-type = p-obj-type
     2552           and buf_pl-gds.obj-code = p-obj-code
     2553           and buf_pl-gds.gds-code = p-gds-code
     2554       on error undo, return error return-value
     2555       :
     2556         create buf_temp-pl-gds .
     2557         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2558       end.
     2559     end.
     2560   end procedure.
     2561   procedure prdoclib-init-pl-gds-by-factord :
     2562     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2563     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2564     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2565     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2566     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2567     define input parameter p-fact-order         as decimal   no-undo .
     2568     define input parameter p-include-fact-order as logical   no-undo .
     2569     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     2570     define buffer buf_goods       for ub.goods .
     2571     define buffer buf_gds-obj     for ub.gds-obj .
     2572     define buffer buf_doc-line    for ub.doc-line .
     2573     define buffer buf_temp-pl-gds for temp-pl-gds .
     2574     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     2575     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     2576     do
     2577     on error undo, return error return-value
     2578     :
     2579       do transaction
     2580       on error undo, return error return-value
     2581       :
     2582   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2584     (input  p-obj-type
     2585     ,input  p-obj-code
     2586     ,input  p-artic
     2587     ,input  p-prod-type
     2588     ,input  p-prod-code
     2589     ,buffer buf_gds-obj
     2590     ) no-error .
     2591         if error-status :error
     2592         then do:
     2593           message
     2594             vss-workfile vss-revision vss-description skip
     2595             vss-include-info7 skip
     2596             "Невозможно найти gds-obj" skip
     2597             error-status :get-message(1) skip
     2598             return-value skip
     2599             view-as alert-box error .
     2600           undo, return error return-value .
     2601         end.
     2602         find current buf_gds-obj exclusive-lock .
     2603       end.
     2604       find first buf_goods no-lock
     2605         where buf_goods.artic     = p-artic
     2606           and buf_goods.prod-type = p-prod-type
     2607           and buf_goods.prod-code = p-prod-code
     2608         .
     2609       run prdoclib-init-temp-pl-gds in this-procedure
     2610         (input p-obj-type
     2611         ,input p-obj-code
     2612         ,input buf_goods.gds-code
     2613         ) .
     2614       if p-include-fact-order = true
     2615       then do:
     2616         assign
     2617          p-fact-order = p-fact-order - 0.0000000001
     2618         .
     2619       end.
     2620       for each buf_doc-line no-lock
     2621         where buf_doc-line.obj-type   = p-obj-type
     2622           and buf_doc-line.obj-code   = p-obj-code
     2623           and buf_doc-line.artic      = p-artic
     2624           and buf_doc-line.prod-type  = p-prod-type
     2625           and buf_doc-line.prod-code  = p-prod-code
     2626           and buf_doc-line.status_    = 'факт':U
     2627           and buf_doc-line.fact-order >= p-fact-order
     2628       on error undo, return error return-value
     2629       :
     2630         run prdoclib-prc-pl-document in this-procedure
     2631           ( input  buf_doc-line.doc-code
     2632            ,input  p-obj-type
     2633            ,input  p-obj-code
     2634            ,input  buf_goods.gds-code
     2635            ,output v-total-pl-gds-qnty
     2636            ,output v-total-pl-gds-cli-qnty
     2637           ) .
     2638       end.
     2639     end.
     2640   end procedure.
     2641   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2642   procedure factord :
     2643     define input  parameter p-fact-date            as date    no-undo .
     2644     define input  parameter p-fact-time            as integer no-undo .
     2645     define input  parameter p-fact-num             as integer no-undo .
     2646     define input  parameter p-shift-date           as date    no-undo .
     2647     define input  parameter p-shift-num            as integer no-undo .
     2648     define input  parameter p-shift-on             as logical no-undo .
     2649     define output parameter p-fact-order           as decimal no-undo .
     2650     define output parameter p-shift-end-fact-order as decimal no-undo .
     2651     define output parameter p-day-end-fact-order   as decimal no-undo .
     2652     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2653     if p-fact-date = ?
     2654     then do:
     2655       return error "Не указана фактическая дата" .
     2656     end.
     2657     define variable v-fact-date-num as integer no-undo .
     2658     assign
     2659       v-fact-date-num = integer(p-fact-date)
     2660     .
     2661     if p-fact-num = ?
     2662     or p-fact-num = 0
     2663     then do:
     2664       return error "Не задан p-fact-num " + string(p-fact-num) .
     2665     end.
     2666     if p-fact-num < 0
     2667     then do:
     2668       return error "Отрицательный fact-num " + string(p-fact-num) .
     2669     end.
     2670     if p-fact-num >= 100000000
     2671     then do:
     2672       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2673     end.
     2674     if p-shift-on = true
     2675     then do:
     2676       if p-shift-date = ?
     2677       then do:
     2678         return error "Не задана дата смены" .
     2679       end.
     2680       if p-shift-num = ?
     2681       or p-shift-num = 0
     2682       then do:
     2683         return error "Не задан номер смены" .
     2684       end.
     2685     end.
     2686     else do:
     2687       assign
     2688         p-shift-date = p-fact-date
     2689         p-shift-num  = 24
     2690       .
     2691     end.
     2692     define variable v-shift-offset as integer no-undo .
     2693     if p-shift-date = p-fact-date
     2694     then do:
     2695       assign
     2696         v-shift-offset = 1
     2697       .
     2698     end.
     2699     if p-shift-date < p-fact-date
     2700     then do:
     2701       assign
     2702         v-shift-offset = 0
     2703       .
     2704     end.
     2705     if p-shift-date > p-fact-date
     2706     then do:
     2707       message
     2708         vss-workfile vss-revision vss-description skip
     2709         "Неправильная дата закрытия смены" skip
     2710         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2711         view-as alert-box error .
     2712       undo, return error
     2713         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2714           ,string(p-fact-date, '99/99/9999':U)
     2715           ,string(p-shift-date, '99/99/9999':U)
     2716           )
     2717       .
     2718     end.
     2719     if p-shift-num < 1
     2720     or p-shift-num > 24
     2721     then do:
     2722       message
     2723         vss-workfile vss-revision vss-description skip
     2724         "Неправильный номер смены" skip
     2725         "p-shift-num" p-shift-num skip
     2726         view-as alert-box error .
     2727       undo, return error return-value .
     2728     end.
     2729     assign
     2730       p-fact-order           = v-fact-date-num
     2731                              + v-shift-offset * 0.5
     2732                              + p-shift-num    * 0.02 - 0.01
     2733                              + p-fact-num     * 0.0000000001
     2734       p-shift-end-fact-order = v-fact-date-num
     2735                              + v-shift-offset * 0.5
     2736                              + p-shift-num    * 0.02
     2737       p-day-end-fact-order   = v-fact-date-num
     2738                              + 0.99
     2739     .
     2740     if p-fact-order           <= v-fact-date-num
     2741     or p-shift-end-fact-order <= v-fact-date-num
     2742     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2743     or p-shift-end-fact-order >= p-day-end-fact-order
     2744     then do:
     2745       message
     2746         vss-workfile vss-revision vss-description skip
     2747         "Внутренняя ошибка при генерации фактического номера" skip
     2748         "p-fact-date"            p-fact-date            skip
     2749         "p-fact-time"            p-fact-time            skip
     2750         "p-fact-num"             p-fact-num             skip
     2751         "p-shift-date"           p-shift-date           skip
     2752         "p-shift-num"            p-shift-num            skip
     2753         "p-shift-on"             p-shift-on             skip
     2754         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2755         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2756         "v-fact-date-num"        v-fact-date-num        skip
     2757         view-as alert-box error .
     2758       undo, return error return-value .
     2759     end.
     2760   end procedure.
     2761   procedure day-begin-fact-order :
     2762     define input  parameter p-fact-date            as date    no-undo .
     2763     define output parameter p-day-begin-fact-order as decimal no-undo .
     2764     do
     2765     on error undo, return error return-value
     2766     :
     2767       if p-fact-date = ?
     2768       then do:
     2769         assign
     2770           p-day-begin-fact-order = 0
     2771         .
     2772       end.
     2773       else do:
     2774         assign
     2775           p-day-begin-fact-order = integer(p-fact-date)
     2776         .
     2777       end.
     2778     end.
     2779   end procedure.
     2780   procedure factord-max-fact-order :
     2781     define output parameter p-max-fact-order as decimal   no-undo .
     2782     do
     2783     on error undo, return error return-value
     2784     :
     2785       run day-begin-fact-order in this-procedure
     2786         (input  date(1, 1, 5000)
     2787         ,output p-max-fact-order
     2788         ) .
     2789     end.
     2790   end procedure.
     2791   procedure factord-cut-archive :
     2792     define input  parameter p-obj-type             as character no-undo .
     2793     define input  parameter p-obj-code             as integer   no-undo .
     2794     define input  parameter p-fact-date            as date      no-undo .
     2795     define output parameter p-shift-on             as logical   no-undo .
     2796     define output parameter p-shift-date           as date      no-undo .
     2797     define output parameter p-shift-num            as integer   no-undo .
     2798     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2799     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2800     define variable v-fact-order as decimal   no-undo .
     2801     define buffer buf_shift-obj for ub.shift-obj .
     2802     do
     2803     on error undo, return error return-value
     2804     :
     2805   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2806   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2807     (input  p-obj-type
     2808     ,input  p-obj-code
     2809     ,input  'shift-on=request'
     2810     ,output p-shift-on
     2811     ) no-error .
     2812       if error-status :error
     2813       then do:
     2814         message
     2815           vss-workfile vss-revision vss-description skip
     2816           "Ошибка при определении атрибута объекта" skip
     2817           "Объект" p-obj-type p-obj-code skip
     2818           error-status :get-message(1) skip
     2819           return-value skip
     2820           view-as alert-box error .
     2821         undo, return error return-value .
     2822       end.
     2823       if p-shift-on = false
     2824       then do:
     2825         assign
     2826           p-shift-date               = ?
     2827           p-shift-num                = 0
     2828         .
     2829       end.
     2830       else do:
     2831         find first buf_shift-obj share-lock
     2832           where buf_shift-obj.obj-type   = p-obj-type
     2833             and buf_shift-obj.obj-code   = p-obj-code
     2834             and buf_shift-obj.shift-date > p-fact-date
     2835           use-index pi
     2836           no-error .
     2837         if not available buf_shift-obj
     2838         or buf_shift-obj.status_ <> 'зкр':U
     2839         then do:
     2840           message
     2841             vss-workfile vss-revision vss-description skip
     2842             "Невозможно вычислить последнюю смену" skip
     2843             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2844             "Объект" p-obj-type p-obj-code skip
     2845             "Дата" p-fact-date skip
     2846             view-as alert-box error .
     2847           undo, return error return-value .
     2848         end.
     2849         find last buf_shift-obj share-lock
     2850           where buf_shift-obj.obj-type = p-obj-type
     2851             and buf_shift-obj.obj-code = p-obj-code
     2852             and buf_shift-obj.shift-date <= p-fact-date
     2853           use-index pi
     2854           no-error .
     2855         if available buf_shift-obj
     2856         then do:
     2857           if  buf_shift-obj.status_ = 'зкр':U
     2858           then do:
     2859             assign
     2860               p-shift-date = buf_shift-obj.shift-date
     2861               p-shift-num  = buf_shift-obj.shift-num
     2862             .
     2863           end.
     2864           else do:
     2865             message
     2866               vss-workfile vss-revision vss-description skip
     2867               "Невозможно вычислить последнюю смену" skip
     2868               "Статус смены отличен от статуса" 'зкр':U skip
     2869               "Объект" p-obj-type p-obj-code skip
     2870               "Дата" p-fact-date skip
     2871               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2872               view-as alert-box error .
     2873             undo, return error return-value .
     2874           end.
     2875         end.
     2876         else do:
     2877           assign
     2878             p-shift-date = p-fact-date - 1
     2879             p-shift-num  = 1
     2880           .
     2881         end.
     2882       end.
     2883       run factord in this-procedure
     2884         (input  p-fact-date
     2885         ,input  1
     2886         ,input  1
     2887         ,input  p-shift-date
     2888         ,input  p-shift-num
     2889         ,input  p-shift-on
     2890         ,output v-fact-order
     2891         ,output p-shift-end-fact-order
     2892         ,output p-day-end-fact-order
     2893         ) no-error .
     2894       if error-status :error
     2895       then do:
     2896         message
     2897           vss-workfile vss-revision vss-description skip
     2898           "Ошибка при вызове процедуры factord"
     2899           error-status :get-message(1) skip
     2900           return-value skip
     2901           view-as alert-box error .
     2902         undo, return error return-value .
     2903       end.
     2904     end.
     2905   end procedure.
     2906   procedure factord-lock-shift :
     2907     define input  parameter p-obj-type  as character no-undo .
     2908     define input  parameter p-obj-code  as integer   no-undo .
     2909     define input  parameter p-fact-date as date      no-undo .
     2910     define parameter buffer buf_shift-obj for ub.shift-obj .
     2911     define variable v-shift-on      as logical   no-undo .
     2912     define variable v-extra-message as character no-undo .
     2913     define variable v-error as character no-undo .
     2914     do
     2915     on error undo, return error return-value
     2916     :
     2917   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2918   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2919     (input  p-obj-type
     2920     ,input  p-obj-code
     2921     ,input  'shift-on=request'
     2922     ,output v-shift-on
     2923     ) no-error .
     2924       if error-status :error
     2925       then do:
     2926         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2927         undo, return error v-error .
     2928       end.
     2929       if v-shift-on = true
     2930       then do:
     2931         find first buf_shift-obj share-lock
     2932           where buf_shift-obj.obj-type   = p-obj-type
     2933             and buf_shift-obj.obj-code   = p-obj-code
     2934             and buf_shift-obj.shift-date > p-fact-date
     2935           use-index pi
     2936           no-error .
     2937         if not available buf_shift-obj
     2938         or buf_shift-obj.status_ <> 'зкр':U
     2939         then do:
     2940           find last buf_shift-obj
     2941             where buf_shift-obj.obj-type = p-obj-type
     2942               and buf_shift-obj.obj-code = p-obj-code
     2943               and buf_shift-obj.status_  = 'зкр':U
     2944             use-index stts
     2945             no-error .
     2946           if available buf_shift-obj
     2947           then do:
     2948             assign
     2949               v-extra-message =
     2950                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2951                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2952                               )
     2953             .
     2954           end.
     2955           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2956           undo, return error v-error .
     2957         end.
     2958       end.
     2959     end.
     2960   end procedure.
     2961   procedure factord-end-day :
     2962     define input  parameter p-fact-date            as date    no-undo .
     2963     define output parameter p-day-end-fact-order   as decimal no-undo .
     2964     do
     2965     on error undo, return error return-value
     2966     :
     2967       if p-fact-date = ?
     2968       then do:
     2969         return error "Не указана фактическая дата" .
     2970       end.
     2971       assign
     2972         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2973       .
     2974     end.
     2975   end procedure.
     2976   procedure factord-to-date :
     2977     define input  parameter p-fact-order as decimal no-undo .
     2978     define output parameter p-fact-date  as date    no-undo .
     2979     define variable v-ref-date  as date      no-undo .
     2980     define variable v-ref-delta as integer   no-undo .
     2981     do
     2982     on error undo, return error return-value
     2983     :
     2984       if p-fact-order = ?
     2985       or p-fact-order = 0
     2986       then do:
     2987         return error "Не указан fact-order" .
     2988       end.
     2989       assign
     2990         v-ref-date  = date(1, 1, 2000)
     2991       .
     2992       assign
     2993         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2994       .
     2995       assign
     2996         p-fact-date = v-ref-date + v-ref-delta
     2997       .
     2998     end.
     2999   end procedure.
     3000   procedure factord-to-fact-num :
     3001     define input  parameter p-fact-order as decimal no-undo .
     3002     define output parameter p-fact-num   as integer no-undo .
     3003     define variable v-fact-order-trunc as decimal no-undo .
     3004     do
     3005     on error undo, return error return-value
     3006     :
     3007       if p-fact-order = ?
     3008       or p-fact-order = 0
     3009       then do:
     3010         return error "Не указан fact-order" .
     3011       end.
     3012       assign
     3013        v-fact-order-trunc = truncate(p-fact-order, 2)
     3014       .
     3015       assign
     3016         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3017       .
     3018     end.
     3019   end procedure.
     3020   procedure factord-to-shift-num :
     3021     define input  parameter p-fact-order as decimal no-undo .
     3022     define output parameter p-shift-num   as integer no-undo .
     3023     define variable  p-shift-numd  as decimal   no-undo .
     3024     define variable v-fact-order-trunc as decimal no-undo .
     3025     do
     3026     on error undo, return error return-value
     3027     :
     3028       if p-fact-order = ?
     3029       or p-fact-order = 0
     3030       then do:
     3031         return error "Не указан fact-order" .
     3032       end.
     3033       assign
     3034        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3035       .
     3036       if v-fact-order-trunc < 0.5 then do:
     3037         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3038       end.
     3039       assign
     3040         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3041         .
     3042        assign
     3043         p-shift-num = truncate (p-shift-numd , 0)
     3044       .
     3045     end.
     3046   end procedure.
     3047   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3048   define variable v-waitfram-action01         as character   no-undo .
     3049   define variable v-waitfram-action02         as character   no-undo .
     3050   define variable v-waitfram-action03         as character   no-undo .
     3051   define variable mWaitFramTextBeg            as character   no-undo.
     3052   define variable mWaitFramTextEnd            as character   no-undo.
     3053   define variable mWaitFramView               as logical     no-undo.
     3054   define variable mWaitProcEvent              as logical     no-undo init yes.
     3055   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3056   define variable mWaitFramStop               as logical     no-undo.
     3057   define variable mWaitFramStopUser           as logical     no-undo.
     3058   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3059   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3060   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3061   define button B-WaitFramStop auto-end-key
     3062        label "Стоп"
     3063        size 10 by 1 tooltip "Остоновить процесс".
     3064   define button B-viewProcInfo
     3065        label "Информация"
     3066        size 15 by 1 tooltip "Информация о процесс".
     3067   define frame waitfram
     3068     v-waitfram-action01 format "x(72)" no-label skip
     3069     v-waitfram-action02 format "x(72)" no-label skip
     3070     v-waitfram-action03 format "x(72)" no-label skip
     3071     B-viewProcInfo
     3072     B-WaitFramStop at row 4 col 30
     3073     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3074     .
     3075   define new global shared variable mBatchMode as logical no-undo init ?.
     3076   define variable mFramBachModHandle as handle no-undo.
     3077   mFramBachModHandle = frame waitfram:handle.
     3078   define variable mFameOldVis as logical no-undo.
     3079   define variable mVisCUrentVin as logical no-undo.
     3080   if session:batch-mode
     3081   then
     3082      mBatchMode = yes.
     3083   if mBatchMode = ? then do:
     3084     mVisCUrentVin = current-window:visible.
     3085     mFameOldVis = mFramBachModHandle:visible.
     3086     mFramBachModHandle:visible  = yes.
     3087     mBatchMode = mFramBachModHandle:visible ne yes.
     3088     mFramBachModHandle:visible = mFameOldVis.
     3089     current-window:visible = mVisCUrentVin.
     3090   end.
     3091    if  log-manager:logfile-name ne ?
     3092     then DO:
     3093         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3094         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3095         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3096     end.
     3097   on choose of B-WaitFramStop in frame waitfram
     3098   do:
     3099     mWaitFramStop = yes.
     3100     mWaitFramStopUser = yes.
     3101   end.
     3102   function waitfram-check-timeout returns logical():
     3103      define variable vtime as int64 no-undo.
     3104      if mWaitFramStopTimeOut
     3105      then
     3106         return yes.
     3107      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3108      if     mWaitFramTimeOut ne ?
     3109         and mWaitFramTimeOut ne 0
     3110         and mWaitFramTimeOut lt vtime
     3111      then do:
     3112         mWaitFramStopTimeOut = yes.
     3113      end.
     3114      return mWaitFramStopTimeOut.
     3115   end.
     3116   procedure waitfram-hide :
     3117     if not session:batch-mode
     3118     then do
     3119     on error undo, return error return-value
     3120     :
     3121       pause 0 before-hide .
     3122       if not mBatchMode then
     3123         hide frame waitfram .
     3124     if     not mWaitFramView
     3125        and mWaitProcEvent
     3126     then
     3127       process events .
     3128     end.
     3129   end procedure.
     3130   procedure waitfram-show :
     3131     define input  parameter p-message as character no-undo .
     3132     define variable v-left-margin as integer   no-undo .
     3133     if not session:batch-mode
     3134     then do
     3135     on error undo, return error return-value
     3136     :
     3137       if length(p-message) <= 70 then do:
     3138         assign
     3139           v-left-margin = integer((70 - length(p-message)) / 2)
     3140         .
     3141         assign
     3142           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3143         .
     3144         assign
     3145           v-waitfram-action01 = " "
     3146           v-waitfram-action02 = " "
     3147                                    + fill(" ", v-left-margin)
     3148                                    + p-message
     3149           v-waitfram-action03 = " "
     3150         .
     3151       end.
     3152       else do:
     3153         define variable vRindex1 as integer no-undo.
     3154         define variable vRindex2 as integer no-undo.
     3155         vRindex1 = r-index(p-message," ",70).
     3156         if vRindex1 = 0
     3157         then
     3158            vRindex1 = 70.
     3159         if length(p-message)  <= vRindex1 + 70 then do:
     3160           assign
     3161             v-waitfram-action01 = " "
     3162             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3163             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3164           .
     3165         end.
     3166         else do:
     3167           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3168           if vRindex2 <= vRindex1
     3169           then
     3170              vRindex2 = vRindex1 + 70.
     3171           assign
     3172             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3173             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3174             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3175           .
     3176         end.
     3177       end.
     3178       B-viewProcInfo:visible   in frame waitfram = no.
     3179       B-viewProcInfo:sensitive in frame waitfram = no.
     3180       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3181       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3182       if  (   mWaitFramView
     3183          or  mWaitProcEvent)
     3184          and not mBatchMode
     3185       then
     3186          display
     3187             v-waitfram-action01 skip
     3188             v-waitfram-action02 skip
     3189             v-waitfram-action03 skip
     3190          with frame waitfram .
     3191       if     mWaitFramView
     3192          then do:
     3193             if     mWaitFramInterval ne ?
     3194                and not mBatchMode
     3195             then
     3196                wait-for go of frame waitfram pause mWaitFramInterval.
     3197          end.
     3198          else
     3199             if     mWaitProcEvent
     3200                and not mBatchMode
     3201             then
     3202                process events .
     3203     end.
     3204   end procedure.
     3205      procedure waitfram-show-this:
     3206         define input  parameter iInterval as int64 no-undo.
     3207         define variable vtime as int64 no-undo.
     3208         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3209         mWaitFramInterval = iInterval.
     3210         run waitfram-show (substitute("&1&2 &3&4" ,
     3211                                       mWaitFramTextBeg ,
     3212                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3213                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3214                                       mWaitFramTextEnd
     3215                                      )
     3216                           ).
     3217      end.
     3218      procedure WaitFramRunPause:
     3219         define input  parameter iInterval as dec no-undo.
     3220         define variable vStart  as datetime-tz no-undo.
     3221         define variable vend    as datetime-tz no-undo.
     3222         define variable vint as int64 no-undo.
     3223         define variable vOk as logical no-undo.
     3224         vStart = now.
     3225         vend   = vStart.
     3226         publish "WaitFramPause" (iInterval,output vOk).
     3227         vend   =  now.
     3228         vint = vend - vStart.
     3229         vint = iInterval - vint / 1000.
     3230         if     not mWaitFramStop
     3231            and (   vint > 0
     3232                 or (    not vOk
     3233                     and iInterval eq ?
     3234                     )
     3235                 )
     3236         then
     3237            run waitfram-show-this (iInterval).
     3238         vend   =  now.
     3239         vint = vend - vStart.
     3240         vint = iInterval - vint / 1000.
     3241         if     not mWaitFramStop
     3242            and vint > 0
     3243         then do:
     3244            run gbl/pause.p (vint * 1000).
     3245         end.
     3246         if iInterval ne ?
     3247         then
     3248            publish "WaitFramStop".
     3249         waitfram-check-timeout().
     3250      end.
     3251      procedure WaitFramWaitFor:
     3252         define input  parameter iInterval as dec no-undo.
     3253         assign
     3254            mWaitFramStartProc   = now
     3255            mWaitFramStopUser    = no
     3256            mWaitFramStopTimeOut = no
     3257         .
     3258         block-wait:
     3259         do while not mWaitFramStop:
     3260            run WaitFramRunPause (iInterval).
     3261            if  waitfram-check-timeout()
     3262            then do:
     3263               leave block-wait.
     3264            end.
     3265         end.
     3266         run waitfram-hide.
     3267      end.
     3268   procedure waitfram-join :
     3269     define input  parameter p-line-1  as character no-undo .
     3270     define input  parameter p-line-2  as character no-undo .
     3271     define input  parameter p-line-3  as character no-undo .
     3272     define output parameter p-message as character no-undo .
     3273     do
     3274     on error undo, return error return-value
     3275     :
     3276       assign
     3277         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3278                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3279                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3280       .
     3281     end.
     3282   end procedure.
     3283   function waitfram-join-function returns character
     3284     (input p-line-1 as character
     3285     ,input p-line-2 as character
     3286     ,input p-line-3 as character
     3287     ).
     3288     define variable v-message as character no-undo .
     3289     run waitfram-join in this-procedure
     3290       (input  p-line-1
     3291       ,input  p-line-2
     3292       ,input  p-line-3
     3293       ,output v-message
     3294       ) .
     3295     return v-message .
     3296   end function .
