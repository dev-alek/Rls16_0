     3395   procedure process-gds-obj :
     3396     define buffer buf_gds-obj      for ub.gds-obj .
     3397     define buffer buf_lock_gds-obj for ub.gds-obj .
     3398     define buffer buf_price-doc    for ub.price-doc .
     3399     define variable v-goods-gds-goods as logical   no-undo .
     3400     define variable v-goods-twounit   as logical   no-undo .
     3401     define variable v-doc-num         as character no-undo .
     3402     define variable v-price-sale      as decimal   no-undo .
     3403     define variable v-road-tax        as decimal   no-undo .
     3404     define variable v-excise          as decimal   no-undo .
     3405     define variable v-crsa-vat-pc     as decimal   no-undo .
     3406     define variable v-crsa-slt-pc     as decimal   no-undo .
     3407     do
     3408     on error undo, return error return-value
     3409     :
     3410       gds-obj_cycle:
     3411       for each buf_gds-obj no-lock
     3412         where buf_gds-obj.obj-type = p-obj-type
     3413           and buf_gds-obj.obj-code = p-obj-code
     3414       on error undo, return error return-value
     3415       :
     3416         assign
     3417           v-ind = v-ind + 1
     3418         .
     3419         if v-ind modulo 10 = 0
     3420         then do:
     3421           run waitfram-show in this-procedure
     3422             (input substitute("Проверка переоценок. Объект &1 &2. Проверено &3. Ошибок &4"
     3423                              ,p-obj-type
     3424                              ,p-obj-code
     3425                              ,v-ind
     3426                              ,p-error-number
     3427                              )
     3428             ) .
     3429         end.
     3430         do transaction
     3431         on error undo, return error return-value
     3432         :
     3433           find first buf_lock_gds-obj exclusive-lock
     3434             where rowid(buf_lock_gds-obj) = rowid(buf_gds-obj)
     3435             .
     3436         end.
