        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type                 as character no-undo .
        3   define input  parameter p-obj-code                 as integer   no-undo .
        4   define input  parameter p-start-date               as date      no-undo .
        5   define output parameter p-error-number             as integer   no-undo .
        6   define output parameter p-state-description        as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: chkobprd.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: utl/chkobprd.p $":U .
       12   define variable vss-description as character no-undo init "Программа проверки документов переоценки на объекте начиная с определенной даты".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       84   procedure partslib-clear-temp-parts :
       85     define buffer buf_temp-parts for temp-parts .
       86     do
       87     on error undo, return error
       88     :
       89       for each buf_temp-parts
       90       on error undo, return error
       91       :
       92         delete buf_temp-parts .
       93       end.
       94     end.
       95   end procedure.
       96   procedure partslib-create-temp-parts :
       97     define parameter buffer buf_parts       for ub.parts .
       98     define parameter buffer buf_temp-parts  for temp-parts .
       99     define input  parameter p-goods-twounit as logical   no-undo .
      100     define variable v-base-part-code as character no-undo .
      101     do
      102     on error undo, return error
      103     :
      104       if p-goods-twounit = true
      105       then do:
      106         assign
      107           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      108         .
      109       end.
      110       else do:
      111         assign
      112           v-base-part-code = buf_parts.part-code
      113         .
      114       end.
      115       find first buf_temp-parts exclusive-lock
      116         where buf_temp-parts.obj-type  = buf_parts.obj-type
      117           and buf_temp-parts.obj-code  = buf_parts.obj-code
      118           and buf_temp-parts.artic     = buf_parts.artic
      119           and buf_temp-parts.prod-type = buf_parts.prod-type
      120           and buf_temp-parts.prod-code = buf_parts.prod-code
      121           and buf_temp-parts.in-code   = buf_parts.in-code
      122           and buf_temp-parts.out-code  = 'free-zone':U
      123           and buf_temp-parts.part-code = v-base-part-code
      124         no-error.
      125       if not available buf_temp-parts
      126       then do:
      127         create buf_temp-parts .
      128         buffer-copy buf_parts to buf_temp-parts
      129         assign
      130           buf_temp-parts.out-code  = 'free-zone':U
      131           buf_temp-parts.part-code = v-base-part-code
      132           buf_temp-parts.rsrv-free = yes
      133           buf_temp-parts.status_   = no
      134           buf_temp-parts.qnty      = 0
      135           buf_temp-parts.fact-qnty = 0
      136           buf_temp-parts.real-qnty = 0
      137           buf_temp-parts.cli-qnty  = 0
      138         .
      139       end.
      140     end.
      141   end procedure.
      142   procedure partslib-init-temp-parts :
      143     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      144     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      145     define input parameter p-artic           like ub.parts.artic     no-undo .
      146     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      147     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      148     define buffer buf_parts      for ub.parts .
      149     define buffer buf_temp-parts for temp-parts .
      150     define variable v-goods-twounit    as logical   no-undo .
      151     do
      152     on error undo, return error
      153     :
      154   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      156     (input  p-artic
      157     ,input  p-prod-type
      158     ,input  p-prod-code
      159     ,input  'twounit=request':u
      160     ,output v-goods-twounit
      161     ) no-error .
      162       if error-status :error
      163       then do:
      164         message
      165           vss-workfile vss-revision vss-description skip
      166           vss-include-info0 skip
      167           "Ошибка при определении атрибута товара" skip
      168           "Артикул" p-artic p-prod-type p-prod-code skip
      169           "twounit=request" skip
      170           error-status :get-message(1) skip
      171           return-value skip
      172           view-as alert-box error .
      173         undo, return error return-value .
      174       end.
      175       run partslib-clear-temp-parts in this-procedure .
      176       for each buf_parts
      177         where buf_parts.obj-type  = p-obj-type
      178           and buf_parts.obj-code  = p-obj-code
      179           and buf_parts.artic     = p-artic
      180           and buf_parts.prod-type = p-prod-type
      181           and buf_parts.prod-code = p-prod-code
      182           and buf_parts.rsrv-free = yes
      183           and buf_parts.status_   = no
      184           and buf_parts.in-code   <> buf_parts.out-code
      185       on error undo, return error
      186       :
      187         run partslib-create-temp-parts in this-procedure
      188           (buffer buf_parts
      189           ,buffer buf_temp-parts
      190           ,input  v-goods-twounit
      191           ) .
      192         define variable v-parts-qnty          as decimal   no-undo .
      193         define variable v-parts-cli-qnty      as decimal   no-undo .
      194         define variable v-parts-free-qnty     as decimal   no-undo .
      195         define variable v-parts-free-cli-qnty as decimal   no-undo .
      196         if buf_parts.out-code = 'free-zone':U
      197         then do:
      198           assign
      199             v-parts-qnty          = buf_parts.qnty
      200             v-parts-cli-qnty      = buf_parts.cli-qnty
      201             v-parts-free-qnty     = buf_parts.qnty
      202             v-parts-free-cli-qnty = buf_parts.cli-qnty
      203           .
      204         end.
      205         else do:
      206           assign
      207             v-parts-qnty          = abs(buf_parts.qnty)
      208             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      209             v-parts-free-qnty     = 0
      210             v-parts-free-cli-qnty = 0
      211           .
      212         end.
      213         assign
      214           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      215           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      216           buf_temp-parts.real-qnty     = 0
      217           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      218           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      219           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      220         .
      221       end.
      222     end.
      223   end procedure.
      224   procedure partslib-init-temp-parts-by-factord :
      225     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      226     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      227     define input parameter p-artic              like ub.parts.artic     no-undo .
      228     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      229     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      230     define input parameter p-fact-order         as decimal   no-undo .
      231     define input parameter p-include-fact-order as logical   no-undo .
      232     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      233     define buffer buf_gds-obj  for ub.gds-obj .
      234     do
      235     on error undo, return error
      236     :
      237       do transaction
      238       on error undo, return error
      239       :
      240   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      242     (input  p-obj-type
      243     ,input  p-obj-code
      244     ,input  p-artic
      245     ,input  p-prod-type
      246     ,input  p-prod-code
      247     ,buffer buf_gds-obj
      248     ) no-error .
      249         if error-status :error
      250         then do:
      251           message
      252             vss-workfile vss-revision vss-description skip
      253             vss-include-info0 skip
      254             "Невозможно найти товар на объекте" skip
      255             "Объект" p-obj-type p-obj-code skip
      256             "Артикул" p-artic p-prod-type p-prod-code skip
      257             error-status :get-message(1) skip
      258             return-value skip
      259             view-as alert-box error .
      260           undo, return error .
      261         end.
      262         find current buf_gds-obj exclusive-lock .
      263       end.
      264       run partslib-init-temp-parts in this-procedure
      265         (input p-obj-type
      266         ,input p-obj-code
      267         ,input p-artic
      268         ,input p-prod-type
      269         ,input p-prod-code
      270         ) no-error .
      271       if error-status :error
      272       then do:
      273         message
      274           vss-workfile vss-revision vss-description skip
      275           vss-include-info0 skip
      276           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      277           "Объект" p-obj-type p-obj-code skip
      278           "Артикул" p-artic p-prod-type p-prod-code skip
      279           "p-fact-order" p-fact-order skip
      280           view-as alert-box error .
      281         undo, return error .
      282       end.
      283       if p-include-fact-order = true
      284       then do:
      285         assign
      286           p-fact-order = p-fact-order - 0.0000000001
      287         .
      288       end.
      289       define variable v-max-fact-order as character no-undo .
      290       run factord-max-fact-order in this-procedure
      291         (output v-max-fact-order
      292         ) no-error .
      293       if error-status :error
      294       then do:
      295         message
      296           vss-workfile vss-revision vss-description skip
      297           vss-include-info0 skip
      298           "Ошибка при вызове процедуры factord-max-fact-order" skip
      299           "Объект" p-obj-type p-obj-code skip
      300           "Артикул" p-artic p-prod-type p-prod-code skip
      301           "p-fact-order" p-fact-order skip
      302           view-as alert-box error .
      303         undo, return error .
      304       end.
      305       run partslib-update-by-factord in this-procedure
      306         (input p-obj-type
      307         ,input p-obj-code
      308         ,input p-artic
      309         ,input p-prod-type
      310         ,input p-prod-code
      311         ,input p-fact-order
      312         ,input v-max-fact-order
      313         ,input false
      314         ) no-error .
      315       if error-status :error
      316       then do:
      317         message
      318           vss-workfile vss-revision vss-description skip
      319           vss-include-info0 skip
      320           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      321           "Объект" p-obj-type p-obj-code skip
      322           "Артикул" p-artic p-prod-type p-prod-code skip
      323           "p-fact-order" p-fact-order skip
      324           "v-max-fact-order" v-max-fact-order skip
      325           view-as alert-box error .
      326         undo, return error .
      327       end.
      328     end.
      329   end procedure.
      330   procedure partslib-update-by-factord :
      331     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      332     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      333     define input parameter p-artic              like ub.parts.artic     no-undo .
      334     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      335     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      336     define input parameter p-start-fact-order   as decimal   no-undo .
      337     define input parameter p-end-fact-order     as decimal   no-undo .
      338     define input parameter p-lock-gds-obj       as logical   no-undo .
      339     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      340     define buffer buf_gds-obj  for ub.gds-obj .
      341     define buffer buf_doc-line for ub.doc-line .
      342     define variable v-total-parts-qnty as decimal   no-undo .
      343     define variable v-goods-gds-goods  as logical   no-undo .
      344     define variable v-goods-twounit    as logical   no-undo .
      345     do
      346     on error undo, return error
      347     :
      348       if p-start-fact-order > p-end-fact-order
      349       then do:
      350         message
      351           vss-workfile vss-revision vss-description skip
      352           vss-include-info0 skip
      353           "Ошибка задания входных параметров" skip
      354           "Начало интервала превышает конец интервала" skip
      355           "Объект" p-obj-type p-obj-code skip
      356           "Артикул" p-artic p-prod-type p-prod-code skip
      357           "p-start-fact-order" p-start-fact-order skip
      358           "p-end-fact-order"   p-end-fact-order skip
      359           view-as alert-box error .
      360         undo, return error .
      361       end.
      362       if p-lock-gds-obj = true
      363       then do:
      364         do transaction
      365         on error undo, return error
      366         :
      367   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      369     (input  p-obj-type
      370     ,input  p-obj-code
      371     ,input  p-artic
      372     ,input  p-prod-type
      373     ,input  p-prod-code
      374     ,buffer buf_gds-obj
      375     ) no-error .
      376           if error-status :error
      377           then do:
      378             message
      379               vss-workfile vss-revision vss-description skip
      380               vss-include-info0 skip
      381               "Невозможно найти gds-obj" skip
      382               error-status :get-message(1) skip
      383               return-value skip
      384               view-as alert-box error .
      385             undo, return error .
      386           end.
      387           find current buf_gds-obj exclusive-lock .
      388         end.
      389       end.
      390   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      392     (input  p-artic
      393     ,input  p-prod-type
      394     ,input  p-prod-code
      395     ,input  'gds-goods=request':u
      396     ,output v-goods-gds-goods
      397     ) no-error .
      398       if error-status :error
      399       then do:
      400         message
      401           vss-workfile vss-revision vss-description skip
      402           vss-include-info0 skip
      403           "Ошибка при определении атрибута товара" skip
      404           "Артикул" p-artic p-prod-type p-prod-code skip
      405           "gds-goods=request" skip
      406           error-status :get-message(1) skip
      407           return-value skip
      408           view-as alert-box error .
      409         undo, return error return-value .
      410       end.
      411   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      413     (input  p-artic
      414     ,input  p-prod-type
      415     ,input  p-prod-code
      416     ,input  'twounit=request':u
      417     ,output v-goods-twounit
      418     ) no-error .
      419       if error-status :error
      420       then do:
      421         message
      422           vss-workfile vss-revision vss-description skip
      423           vss-include-info0 skip
      424           "Ошибка при определении атрибута товара" skip
      425           "Артикул" p-artic p-prod-type p-prod-code skip
      426           "twounit=request" skip
      427           error-status :get-message(1) skip
      428           return-value skip
      429           view-as alert-box error .
      430         undo, return error return-value .
      431       end.
      432       for each buf_doc-line no-lock
      433         where buf_doc-line.obj-type   = p-obj-type
      434           and buf_doc-line.obj-code   = p-obj-code
      435           and buf_doc-line.artic      = p-artic
      436           and buf_doc-line.prod-type  = p-prod-type
      437           and buf_doc-line.prod-code  = p-prod-code
      438           and buf_doc-line.status_    = 'факт':U
      439           and buf_doc-line.fact-order > p-start-fact-order
      440           and buf_doc-line.fact-order <= p-end-fact-order
      441       on error undo, return error
      442       :
      443         run partslib-process-document in this-procedure
      444           (input  buf_doc-line.doc-code
      445           ,input  p-obj-type
      446           ,input  p-obj-code
      447           ,input  p-artic
      448           ,input  p-prod-type
      449           ,input  p-prod-code
      450           ,input  v-goods-gds-goods
      451           ,input  v-goods-twounit
      452           ,output v-total-parts-qnty
      453           ) no-error .
      454         if error-status :error
      455         then do:
      456           message
      457             vss-workfile vss-revision vss-description skip
      458             vss-include-info0 skip
      459             "Ошибка при вызове процедуры partslib-process-document" skip
      460             "Документ" buf_doc-line.doc-code skip
      461             "Объект" p-obj-type p-obj-code skip
      462             "Артикул" p-artic p-prod-type p-prod-code skip
      463             "p-start-fact-order" p-start-fact-order skip
      464             "p-end-fact-order" p-end-fact-order skip
      465             error-status :get-message(1) skip
      466             return-value skip
      467             view-as alert-box error .
      468           undo, return error return-value .
      469         end.
      470       end.
      471     end.
      472   end procedure.
      473   procedure partslib-process-document :
      474     define input  parameter p-doc-code         as character no-undo .
      475     define input  parameter p-obj-type         as character no-undo .
      476     define input  parameter p-obj-code         as integer   no-undo .
      477     define input  parameter p-artic            as character no-undo .
      478     define input  parameter p-prod-type        as character no-undo .
      479     define input  parameter p-prod-code        as integer   no-undo .
      480     define input  parameter p-goods-gds-goods  as logical   no-undo .
      481     define input  parameter p-goods-twounit    as logical   no-undo .
      482     define output parameter p-total-parts-qnty as decimal   no-undo .
      483     define variable v-parts-sign as integer   no-undo .
      484     define buffer buf_trn-doc    for ub.trn-doc .
      485     define buffer buf_doc-line   for ub.doc-line .
      486     define buffer buf_parts      for ub.parts .
      487     define buffer buf_temp-parts for temp-parts .
      488     do
      489     on error undo, return error return-value
      490     :
      491       find first buf_trn-doc no-lock
      492         where buf_trn-doc.doc-code = p-doc-code
      493         no-error .
      494       if not available buf_trn-doc
      495       then do:
      496         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      497                                      ,p-doc-code
      498                                      ) .
      499       end.
      500       case buf_trn-doc.doc-type
      501       :
      502         when 'при':U or
      503         when 'возврат':U or
      504         when 'инв':U
      505         then do:
      506           assign
      507             v-parts-sign = -1
      508           .
      509         end.
      510         when 'рас':U or
      511         when 'спи':U
      512         then do:
      513           assign
      514             v-parts-sign = 1
      515           .
      516         end.
      517         otherwise do:
      518           undo, return error substitute("Неизвестный тип документа &1"
      519                                       ,buf_trn-doc.doc-type
      520                                       ) .
      521         end.
      522       end.
      523       find first buf_doc-line no-lock
      524         where buf_doc-line.doc-code  = p-doc-code
      525           and buf_doc-line.artic     = p-artic
      526           and buf_doc-line.prod-type = p-prod-type
      527           and buf_doc-line.prod-code = p-prod-code
      528         no-error .
      529       if not available buf_doc-line
      530       then do:
      531         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      532                                      ,p-doc-code
      533                                      ,artic
      534                                      ,prod-type
      535                                      ,prod-code
      536                                      ) .
      537       end.
      538       assign
      539         p-total-parts-qnty = 0
      540       .
      541       if p-goods-gds-goods = true
      542       then do:
      543         for each buf_parts no-lock
      544           where buf_parts.out-code  = p-doc-code
      545             and buf_parts.obj-type  = p-obj-type
      546             and buf_parts.obj-code  = p-obj-code
      547             and buf_parts.artic     = p-artic
      548             and buf_parts.prod-type = p-prod-type
      549             and buf_parts.prod-code = p-prod-code
      550         on error undo, return error
      551         :
      552           run partslib-create-temp-parts in this-procedure
      553             (buffer buf_parts
      554             ,buffer buf_temp-parts
      555             ,input  p-goods-twounit
      556             ) .
      557           assign
      558             p-total-parts-qnty        = p-total-parts-qnty
      559                                       + v-parts-sign * buf_parts.fact-qnty
      560             buf_temp-parts.qnty       = buf_temp-parts.qnty
      561                                       + v-parts-sign * buf_parts.fact-qnty
      562             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      563                                       + v-parts-sign * buf_parts.fact-qnty
      564             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      565                                       + v-parts-sign * buf_parts.cli-qnty
      566           .
      567           if buf_temp-parts.qnty = 0
      568           then do:
      569             delete buf_temp-parts .
      570           end.
      571         end.
      572       end.
      573       else do:
      574         assign
      575           p-total-parts-qnty = p-total-parts-qnty
      576                              + v-parts-sign * buf_doc-line.fact-qnty
      577         .
      578       end.
      579     end.
      580   end procedure.
      581   procedure partslib-init-temp-parts-by-date :
      582     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      583     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      584     define input parameter p-artic           like ub.parts.artic     no-undo .
      585     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      586     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      587     define input parameter p-fact-date       as date      no-undo .
      588     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      589     do
      590     on error undo, return error
      591     :
      592       define variable v-fact-order                as decimal   no-undo .
      593       define variable v-shift-end-fact-order      as decimal   no-undo .
      594       define variable v-day-end-fact-order        as decimal   no-undo .
      595       run factord in this-procedure
      596         (input  p-fact-date
      597         ,input  1
      598         ,input  1
      599         ,input  ?
      600         ,input  0
      601         ,input  false
      602         ,output v-fact-order
      603         ,output v-shift-end-fact-order
      604         ,output v-day-end-fact-order
      605         ) no-error .
      606       if error-status :error
      607       then do:
      608         message
      609           vss-workfile vss-revision vss-description skip
      610           vss-include-info0 skip
      611           "Ошибка при определении момента времени, на который требуется остаток" skip
      612           "Объект" p-obj-type p-obj-code skip
      613           "Артикул" p-artic p-prod-type p-prod-code skip
      614           "Дата" p-fact-date skip
      615           view-as alert-box error .
      616         undo, return error .
      617       end.
      618       run partslib-init-temp-parts-by-factord in this-procedure
      619         (input p-obj-type
      620         ,input p-obj-code
      621         ,input p-artic
      622         ,input p-prod-type
      623         ,input p-prod-code
      624         ,input v-day-end-fact-order
      625         ,input false
      626         ) no-error .
      627       if error-status :error
      628       then do:
      629         message
      630           vss-workfile vss-revision vss-description skip
      631           vss-include-info0 skip
      632           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      633           "Объект" p-obj-type p-obj-code skip
      634           "Артикул" p-artic p-prod-type p-prod-code skip
      635           "Дата" p-fact-date skip
      636           view-as alert-box error .
      637         undo, return error .
      638       end.
      639     end.
      640   end procedure.
      641   procedure partslib-calc-cost :
      642     define output parameter p-fact-qnty      as decimal   no-undo .
      643     define output parameter p-vat-pc         as decimal   no-undo .
      644     define output parameter p-slt-pc         as decimal   no-undo .
      645     define output parameter p-sum-base       as decimal   no-undo .
      646     define output parameter p-sum-rubl       as decimal   no-undo .
      647     define output parameter p-vat-base       as decimal   no-undo .
      648     define output parameter p-vat-rubl       as decimal   no-undo .
      649     define output parameter p-slt-base       as decimal   no-undo .
      650     define output parameter p-slt-rubl       as decimal   no-undo .
      651     define output parameter p-road-tax-base  as decimal   no-undo .
      652     define output parameter p-road-tax-rubl  as decimal   no-undo .
      653     define output parameter p-transport-base as decimal   no-undo .
      654     define output parameter p-transport-rubl as decimal   no-undo .
      655     define output parameter p-other-base     as decimal   no-undo .
      656     define output parameter p-other-rubl     as decimal   no-undo .
      657     define output parameter p-excise-base    as decimal   no-undo .
      658     define output parameter p-excise-rubl    as decimal   no-undo .
      659     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      660     do
      661     on error undo, return error return-value
      662     :
      663       define buffer buf_temp-parts for temp-parts .
      664       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      665       define buffer   in-vatp-parts    for ub.parts   .
      666       define buffer   in-vatp-doc      for ub.trn-doc .
      667       define buffer   in-vatp-goods    for ub.goods   .
      668       define buffer   in-vatp-sysconf  for ub.sysconf .
      669       define buffer   in-vatp_doc-attr for ub.doc-attr.
      670       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      671       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      672       define variable varinvprb                  as   character              no-undo.
      673       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      674       define variable cli-base-rate              as   decimal                no-undo.
      675       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      676       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      677       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      678       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      679       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      680       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      681       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      682       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      683       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      684       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      685       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      686       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      687       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      688       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      689       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      690       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      691       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      692       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      693       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      694       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      695       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      696       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      697       define variable varinvatp-envd             as   character              no-undo.
      698       define variable varinvatp-type             as   character              no-undo.
      699       for each buf_temp-parts
      700       on error undo, return error
      701       :
      702   assign
      703     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      704     price-base-with-tax-loc = buf_temp-parts.price-base
      705   .
      706   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      707   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      708     (output varinvprb
      709     )  .
      710     if buf_temp-parts.out-code = 'free-zone':U     or
      711        buf_temp-parts.out-code = 'out-zone':U   or
      712        buf_temp-parts.doc-type = 'акт':U then do:
      713       assign
      714         in-vatp-have-vat-slt = yes.
      715     end.
      716     else do:
      717       find first in-vatp_doc-attr no-lock
      718         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      719           and in-vatp_doc-attr.attr-code = 'envd':U
      720         no-error .
      721       if not available in-vatp_doc-attr then do:
      722         assign
      723           in-vatp-have-vat-slt = yes.
      724       end.
      725       else do:
      726            in-vatp-have-vat-slt = no.
      727       end.
      728     end.
      729     assign
      730      price-cli-with-tax-loc = buf_temp-parts.price-cli
      731      cli-base-rate          = buf_temp-parts.cli-base-rate.
      732     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      733              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      734     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      735             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      736             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      737             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      738             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      739             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      740             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      741       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      742     assign
      743       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      744     assign
      745       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      746       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      747       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      748       transport-cli-loc  = 0
      749       other-cli-loc      = 0
      750     .
      751   ASSIGN
      752             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      753       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      754   .
      755         assign
      756           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      757           p-vat-pc         = p-vat-pc         + vat-pc-loc
      758           p-slt-pc         = p-slt-pc         + slt-pc-loc
      759           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      760           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      761           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      762           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      763           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      764           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      765           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      766           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      767           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      768           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      769           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      770           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      771           p-excise-base    = p-excise-base    + 0
      772           p-excise-rubl    = p-excise-rubl    + 0
      773         .
      774       end.
      775       if p-fact-qnty      = ?
      776       or p-sum-base       = ?
      777       or p-sum-rubl       = ?
      778       or p-vat-base       = ?
      779       or p-vat-rubl       = ?
      780       or p-slt-base       = ?
      781       or p-slt-rubl       = ?
      782       or p-road-tax-base  = ?
      783       or p-road-tax-rubl  = ?
      784       or p-transport-base = ?
      785       or p-transport-rubl = ?
      786       or p-other-base     = ?
      787       or p-other-rubl     = ?
      788       or p-excise-base    = ?
      789       or p-excise-rubl    = ?
      790       then do:
      791         message
      792           vss-workfile vss-revision vss-description skip
      793           vss-include-info0 skip
      794           "Программа in-vatp.i вернула неопределенные значения" skip
      795           "p-fact-qnty"      p-fact-qnty      skip
      796           "p-sum-base"       p-sum-base       skip
      797           "p-sum-rubl"       p-sum-rubl       skip
      798           "p-vat-base"       p-vat-base       skip
      799           "p-vat-rubl"       p-vat-rubl       skip
      800           "p-slt-base"       p-slt-base       skip
      801           "p-slt-rubl"       p-slt-rubl       skip
      802           "p-road-tax-base"  p-road-tax-base  skip
      803           "p-road-tax-rubl"  p-road-tax-rubl  skip
      804           "p-transport-base" p-transport-base skip
      805           "p-transport-rubl" p-transport-rubl skip
      806           "p-other-base"     p-other-base     skip
      807           "p-other-rubl"     p-other-rubl     skip
      808           "p-excise-base"    p-excise-base    skip
      809           "p-excise-rubl"    p-excise-rubl    skip
      810           view-as alert-box error .
      811         undo, return error .
      812       end.
      813     end.
      814   end procedure.
      815   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   define temp-table temp-pl-gds no-undo   like ub.pl-gds .
      817   define temp-table temp-prt-obj no-undo   field prt-code         like ub.prt-obj.prt-code     field price-sale       like ub.prt-obj.price-sale   field fact-qnty        like ub.prt-obj.fact-qnty    field price-list-qnty  like ub.prt-obj.fact-qnty    field is-term          as logical   field prt-obj-recid    as recid     field price-list-recid as recid     index xpk is primary unique prt-code   index xie1 is-term .
      818   procedure prdoclib-process-goods :
      819     define input  parameter p-obj-type          as character no-undo .
      820     define input  parameter p-obj-code          as integer   no-undo .
      821     define input  parameter p-artic             as character no-undo .
      822     define input  parameter p-prod-type         as character no-undo .
      823     define input  parameter p-prod-code         as integer   no-undo .
      824     define input  parameter p-check-price-list  as logical   no-undo .
      825     define input  parameter p-check-price-parts as logical   no-undo .
      826     define input  parameter p-doc-num           as character no-undo .
      827     define input  parameter p-fact-date         as date      no-undo .
      828     define input  parameter p-corr-user-db-num  as integer   no-undo .
      829     define input  parameter p-corr-user-name    as character no-undo .
      830     define input  parameter p-corr-date         as date      no-undo .
      831     define input  parameter p-corr-time         as integer   no-undo .
      832     define input  parameter p-corr-time-str     as character no-undo .
      833     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
      834     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
      835     define buffer buf_gds-obj      for ub.gds-obj .
      836     define buffer buf_prt-obj      for ub.prt-obj .
      837     define buffer buf_price-list   for ub.price-list .
      838     define buffer buf_bar-code     for ub.bar-code .
      839     define buffer buf_temp-prt-obj for temp-prt-obj .
      840     define variable v-gds-code             like ub.goods.gds-code    no-undo .
      841     define variable v-root-node            like ub.prt-obj.prt-code  no-undo .
      842     define variable v-root-b-code          like ub.bar-code.b-code   no-undo .
      843     define variable v-total-term-fact-qnty like ub.prt-obj.fact-qnty no-undo .
      844     define variable v-total-fact-sale      like ub.gds-obj.fact-sale no-undo .
      845     define variable v-doc-num     like ub.price-list.doc-num    no-undo .
      846     define variable v-price-sale  like ub.price-list.price-sale no-undo .
