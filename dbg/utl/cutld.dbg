      599   PROCEDURE run-load :
      600     do
      601     on error  undo, return error substitute( "&1 (run-load). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      602     on stop   undo, return error substitute( "&1 (run-load). stop", vss-workfile )
      603     on endkey undo, return error substitute( "&1 (run-load). endkey", vss-workfile )
      604     :
      605       define variable lok           as logical no-undo .
      606       define variable save_ab       as logical no-undo.
      607       define variable v-num-entries as integer no-undo .
      608       define variable v-ind         as integer no-undo .
      609       define variable v-db-num      as integer no-undo .
      610       define buffer buf_clients for ub.clients .
      611       if p-cut-type = 1 then do:
      612         run utl/chk-btpr.p
      613           ( input p-cut-type
      614            ,input p-db-list
      615            ,output lok
      616           ).
      617         if lok <> true then do:
      618           run write-to-log in this-procedure
      619             ( substitute( "БД не готова к обрезанию! &1&2", return-value, chr(10) )
      620              ,p-handle-callback
      621             ).
      622           return error  .
      623         end.
      624       end.
      625       assign
      626         save_ab = SESSION :APPL-ALERT-BOXES
      627         SESSION :APPL-ALERT-BOXES = NO
      628       .
      629       run utl/cutl-inf.p .
      630       run write-to-log in this-procedure
      631         ( chr(10) + string(today, '99/99/9999') + " " + string(time, 'HH:MM') + chr(10)
      632                         + SUBSTITUTE("&1", RETURN-VALUE) + chr(10)
      633         ,p-handle-callback
      634         ).
      635       run write-to-log in this-procedure
      636         (chr(10) + "Создание списка файлов для запуска." + chr(10)
      637         ,p-handle-callback
      638         ).
      639       assign
      640         lok = session :set-wait-state("compiler")
      641       .
      642       RUN cre-list-action no-error .
      643       if error-status :error then do:
      644         return error "Ошибка при создании списка файлов! " + return-value .
      645       end.
      646       assign
      647         lok = session :set-wait-state("")
      648       .
      649       case p-cut-type :
      650         when 0 then do:
      651           run write-to-log in this-procedure
      652             ( "Полное усечение БД" + chr(10)
      653               + substitute( "Дата актуальности складских документов и архивов: &1",  p-date-actual-docs ) + chr(10)
      654               + substitute( "Дата актуальности финансовых документов и архивов: &1",  p-date-actual-findoc ) + chr(10)
      655               + substitute( "Дата актуальности товаров: &1",  p-date-actual-goods ) + chr(10)
      656               + substitute( "Дата расходной зоны: &1",  p-date-output-zone ) + chr(10)
      657               + substitute( "Не копировать удаленные товары с ненулевыми остатками: &1",  p-not-copy-del-goods ) + chr(10)
      658               + substitute( "Переносить историю по всем таблицам: &1",  p-stay-history ) + chr(10)
      659               + substitute( "Оставить товары для рецептов: &1",  p-stay-recipe-goods ) + chr(10)
      660               + substitute( "Оставить все весовые товары: &1",  p-stay-weight-goods ) + chr(10)
      661               + chr(10)
      662               ,p-handle-callback
      663             ).
      664         end.
      665         when 1 then do:
      666           run write-to-log in this-procedure
      667             ( substitute( "Усечение документов в ГБД по БД &1", p-db-list ) + chr(10)
      668               + substitute( "Дата актуальности складских документов и архивов: &1",  p-date-actual-docs ) + chr(10)
      669               + substitute( "Дата актуальности финансовых документов и архивов: &1",  p-date-actual-findoc ) + chr(10)
      670               + chr(10)
      671               ,p-handle-callback
      672             ).
      673           assign
      674             v-num-entries = num-entries( p-db-list, chr(44) )
      675           .
      676           do v-ind = 1 to v-num-entries
      677           on error undo, return error substitute( "Ошибка при создании списка объектов. &1", error-status:GET-MESSAGE( error-status:NUM-MESSAGES ) )
      678           :
      679             assign
      680               v-db-num = integer( entry( v-ind, p-db-list ) )
      681             .
      682             for each buf_clients no-lock
      683               where buf_clients.db-num = v-db-num
      684             on error undo, return error substitute( "&1", error-status:GET-MESSAGE( error-status:NUM-MESSAGES ) )
      685             :
      686               create tt-objs .
      687               assign
      688                 tt-objs.obj-type = buf_clients.obj-type
      689                 tt-objs.obj-code = buf_clients.obj-code
      690               .
      691             end.
      692           end.
      693         end.
      694         otherwise do:
      695           return error substitute( "Неизвестный тип усечения '&1'", p-cut-type ).
      696         end.
      697       end case.
      698       for each list-action no-lock on error undo, return error return-value :
      699         run clear-return-value in this-procedure .
      700         assign
      701           ttd = string(today, '99/99/9999') + " " + string(time, 'HH:MM')
      702         .
      703         if search( list-action.file-name ) = ? then do:
      704           if search( entry(1, list-action.file-name, ".":U) + ".r":U  ) = ? then do:
      705             run write-to-log in this-procedure
      706               ( ' ERROR!!! Файл: ' + list-action.file-name + ' отсутствует в версии' + chr(10)
      707               ,p-handle-callback
      708               ).
      709             return error substitute( "Не найден файл &1", list-action.file-name ) .
      710           end.
      711         end.
      712         case list-action.action :
      713           when "p"
      714           or when "w"
      715           then do:
      716             run write-to-log in this-procedure
      717               ( ttd + " Utl: " + list-action.file-name + " "
      718               ,p-handle-callback
      719               ).
      720             assign
      721               v-old-time = ETIME
      722             .
      723             run value( list-action.file-name )
      724               ( input p-cut-type
      725                ,input p-db-list
      726                ,input p-date-actual-goods
      727                ,input p-date-actual-docs
      728                ,input p-date-actual-findoc
      729                ,input p-date-output-zone
      730                ,input p-stay-recipe-goods
      731                ,input p-stay-weight-goods
      732                ,input p-not-copy-del-goods
      733                ,input p-stay-history
      734                ,input v-gen-file
      735               )
      736               no-error .
      737             if error-status :error then do:
      738               run write-to-log in this-procedure
      739                 ( format-etime( ETIME - v-old-time) + " ERROR: " + SUBSTITUTE("&1", RETURN-VALUE) + chr(10)
      740                 ,p-handle-callback
      741                 ).
      742               run write-to-log in this-procedure
      743                 ( error-status:GET-MESSAGE( error-status:NUM-MESSAGES )
      744                 ,p-handle-callback
      745                 ).
      746               return error return-value + "Ошибка при выполнении процедуры " + SUBSTITUTE("&1", list-action.file-name) .
      747             end.
      748           end.
      749           otherwise do:
      750             return error "Неизвестное действие " + SUBSTITUTE("&1", list-action.action) + " " + SUBSTITUTE("&1", list-action.file-name) .
      751           end.
      752         end case .
      753         run write-to-log in this-procedure
      754           (format-etime( ETIME - v-old-time) + " ... Ok " + SUBSTITUTE("&1", RETURN-VALUE) + chr(10)
      755           ,p-handle-callback
      756           ).
      757       end.
      758       run write-to-log in this-procedure
      759         ( '"Обрезание" БД успешно завершено.' + chr(10)
      760           + string(today, '99/99/9999') + " " + string(time, 'HH:MM') + chr(10)
      761         ,p-handle-callback
      762         ).
      763       assign
      764         session :appl-alert-boxes = save_ab
      765       .
      766     end.
      767   END PROCEDURE.
      768   procedure clear-return-value :
      769     do
      770     on error undo, return error
      771     :
      772       return .
      773     end.
      774   end procedure.
