        1   block-level on error undo, throw.
        2   define input parameter p-cut-type            as integer   no-undo .
        3   define input parameter p-db-list             as character no-undo .
        4   define input parameter p-date-actual-goods   as date      no-undo .
        5   define input parameter p-date-actual-docs    as date      no-undo .
        6   define input parameter p-date-actual-findoc  as date      no-undo .
        7   define input parameter p-date-output-zone    as date      no-undo.
        8   define input parameter p-stay-recipe-goods   as logical   no-undo .
        9   define input parameter p-stay-weight-goods   as logical   no-undo .
       10   define input parameter p-not-copy-del-goods  as logical   no-undo .
       11   define input parameter p-stay-history        as logical   no-undo .
       12   define input parameter p-handle-callback     as handle    no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: cutld.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: utl/cutld.p $":U .
       18   define variable vss-description as character no-undo init "Автоматический upgrade базы данных".
       19   define new global shared variable g#language as character no-undo .
       20   if g#language <> '' and g#language <> 'rus':U then do:
       21     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       22   end.
       23   define stream LogStream .
       24   define variable ttd        as character no-undo .
       25   define variable v-old-time as int64     no-undo .
       26   PROCEDURE write-to-log :
       27     define input parameter p-msg-str   as character no-undo .
       28     define input parameter p-call-back as handle    no-undo .
       29     do
       30     on error undo, return error
       31     :
       32       output stream LogStream to "cut-load.log" page-size 0 append.
       33       put stream LogStream unformatted p-msg-str .
       34       output stream LogStream close.
       35       if  valid-handle(p-call-back)
       36       and lookup('callback-write-to-log', p-call-back :internal-entries) > 0
       37       then do:
       38         run callback-write-to-log in p-call-back
       39           (input p-msg-str
       40           ) no-error .
       41       end.
       42     end.
       43   END PROCEDURE.
       44   FUNCTION format-etime RETURNS CHARACTER
       45   (INPUT p-etime AS INT64  )
       46   :
       47     if p-etime = ?
       48     then do:
       49       return "?????????????" .
       50     end.
       51     assign
       52       p-etime = p-etime / 1000
       53     .
       54     return
       55       string( p-etime, '->>>>>>>9')
       56       + ' '
       57       + string( p-etime, 'HH:MM:SS')
       58     .
       59   END FUNCTION.
       60   define new shared temp-table tt-objs no-undo
       61     field obj-type as character
       62     field obj-code as integer
       63     index pi is unique primary obj-type obj-code
       64     .
       65   define temp-table list-action no-undo
       66     field action         as character format "x(15)" label "Процедура"
       67     field file-name      as character
       68     index pi is unique primary
       69       file-name ascending
       70     .
       71   define stream UpgStream .
       72   do
       73   on error undo, return error return-value
       74   :
       75     define buffer buf_sys-ctrl for ub.sys-ctrl .
       76     define buffer dst_sys-ctrl for dst.sys-ctrl .
       77     define buffer buf_connect      for ub._connect .
       78     define buffer buf_myconnection for ub._myconnection .
       79     define variable v-log       as logical   no-undo .
       80     define variable v-gen-file  as character no-undo .
       81     define variable v-choice    as integer   no-undo .
       82     define variable v-login-usr as logical   no-undo .
       83     if transaction then do:
       84       message
       85         vss-workfile vss-revision vss-description skip
       86         substitute( "Вызов данной процедуры невозможен при наличии транзакции" )
       87         view-as alert-box error
       88       .
       89       return error .
       90     end.
       91     find first buf_sys-ctrl .
       92     if trim( buf_sys-ctrl.status_ ) <> "":U
       93       and trim( buf_sys-ctrl.status_ ) <> 'sttsDB-cutld':u
       94     then do:
       95       message
       96         substitute( "При статусе БД равном &1 усечение не допускается!", buf_sys-ctrl.status_ ) skip
       97         view-as alert-box error .
       98       undo, return error .
       99     end.
      100     do transaction
      101     on error undo, return error return-value
      102     on stop  undo, return error return-value
      103     :
      104       find first buf_sys-ctrl exclusive-lock .
      105       assign
      106         buf_sys-ctrl.status_ = 'sttsDB-cutld':u
      107       .
      108       release buf_sys-ctrl.
      109     end.
      110     assign
      111       v-choice    = 0
      112       v-login-usr = false
      113     .
      114     block_working:
      115     do while v-choice <> 2
      116     on error undo, return error return-value
      117     :
      118       find first buf_myconnection .
      119       for each buf_connect
      120       on error undo, return error return-value
      121       :
      122         if ( buf_connect._connect-type = "REMC":U
      123               or buf_connect._connect-type = "SELF":U
      124             )
      125             and
      126             ( buf_connect._connect-pid <> buf_myconnection._Myconn-pid
      127               or buf_connect._connect-usr <> buf_myconnection._Myconn-userid
      128             )
      129         then do:
      130           if v-login-usr = false then do:
      131             assign
      132               v-login-usr = true
      133             .
      134             run callback-write-to-log in p-handle-callback
      135               ( input substitute( "&1 &2 В системе работают пользователи:&3", string(today, '99/99/9999'), string(time, 'HH:MM:SS'), chr(10) )
      136               ).
      137           end.
      138           run callback-write-to-log in p-handle-callback
      139             ( input substitute( "&1 &2 &3&4", buf_connect._connect-usr, buf_connect._connect-name, buf_connect._connect-device, chr(10) )
      140             ).
      141         end.
      142       end.
      143       if v-login-usr = true then do:
      144               run gbl/d-askw.w
      145           ( input "Усечение БД"
      146             ,input substitute("Для выполнения усечения БД необходимо, чтобы не было запущено ни одной сессии.&1" +                                   "Для продолжения работы ВЫКЛЮЧИТЕ ВСЕ работающие сессии и затeм нажмите <ПРОДОЛЖИТЬ>&1" +                                   "или нажмите <ВЫЙТИ> и попробуйте зайти в систему позднее"                                   , chr(10))
      147             ,input "|"
      148             ,input "Продолжить|Выйти"
      149             ,input "|"
      150             ,input 1
      151             ,input 2
      152             ,output v-choice
      153           ).
      154         if v-choice = 2 then do:
      155           do transaction
      156           on error undo, return error return-value
      157           on stop  undo, return error return-value
      158           :
      159             find first buf_sys-ctrl exclusive-lock .
      160             assign
      161               buf_sys-ctrl.status_ = "":U
      162             .
      163             release buf_sys-ctrl.
      164           end.
      165           return error .
      166         end.
      167         assign
      168           v-login-usr = false
      169         .
      170       end.
      171       else do:
      172         leave block_working .
      173       end.
      174     end.
      175     run run-load in this-procedure
      176       no-error .
      177     if error-status :error then do:
      178       message
      179         "Ошибка при выполнении процедуры run-load" skip
      180         error-status :get-message(1) skip
      181         return-value skip
      182         view-as alert-box error .
      183       return error return-value.
      184     end.
      185     do transaction
      186     on error undo, return error return-value
      187     on stop  undo, return error return-value
      188     :
      189       find first buf_sys-ctrl exclusive-lock .
      190       assign
      191         buf_sys-ctrl.status_ = "":U
      192       .
      193       release buf_sys-ctrl.
      194       find first dst_sys-ctrl exclusive-lock .
      195       assign
      196         dst_sys-ctrl.status_ = "":U
      197       .
      198       release dst_sys-ctrl.
      199     end.
      200   END.
