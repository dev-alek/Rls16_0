        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define variable i as int no-undo init 0.
        7   define variable j as int no-undo init 0.
        8   define variable jk as int no-undo init 0.
        9   define variable jl as int no-undo init 0.
       10   define variable jm as int no-undo init 0.
       11   define variable glog as logical no-undo .
       12   def frame a
       13    i label "Накладных"
       14    j label "Переоценок"
       15    jk label "Продаж"
       16    jl label "Товаров по объекту"
       17    jm label "Признаков по объекту"
       18    with title "Фирма в накладных, переоценках, продажах, товарах, признаках по объектам.".
       19   view frame a.
       20   glog = no.
       21   message
       22   "Инициализация фирмы в накладных, переоценках, продажах, а также в товарах и признаках по объектам.   Вы уверены ?"
       23   view-as alert-box question buttons OK-Cancel update glog.
       24   if not glog then return.
       25   on write of ub.trn-doc override do: end.
       26   for each ub.trn-doc :
       27     i = i + 1.
       28     disp i jk with frame a view-as dialog-box.
       29     if ub.trn-doc.obj-type = 'скл':U then do:
       30       find ub.store where ub.store.obj-code = ub.trn-doc.obj-code no-lock.
       31       ub.trn-doc.host-code = ub.store.host-code.
       32     end.
       33     else do:
       34       find ub.shop where ub.shop.obj-code = ub.trn-doc.obj-code no-lock.
       35       ub.trn-doc.host-code = ub.shop.host-code.
       36     end.
       37     if ub.trn-doc.discnt-type = 'касс':U then do:
       38       jk = jk + 1.
       39       find ub.inkas where ub.inkas.inkas-code = ub.trn-doc.doc-code no-error.
       40       if available ub.inkas then ub.inkas.host-code = ub.trn-doc.host-code.
       41     end.
       42     process events.
       43   end.
       44   on write of ub.trn-doc revert.
       45   on write of ub.price-doc override do: end.
       46   for each ub.price-doc :
       47     j = j + 1.
       48     disp j with frame a view-as dialog-box.
       49     if ub.price-doc.obj-type = 'скл':U then do:
       50       find ub.store where ub.store.obj-code = ub.price-doc.obj-code no-lock.
       51       ub.price-doc.host-code = ub.store.host-code.
       52     end.
       53     else do:
       54       find ub.shop where ub.shop.obj-code = ub.price-doc.obj-code no-lock.
       55       ub.price-doc.host-code = ub.shop.host-code.
       56     end.
       57     process events.
       58   end.
       59   on write of ub.price-doc revert.
       60   for each ub.gds-obj :
       61     jl = jl + 1.
       62     disp jl with frame a view-as dialog-box.
       63     if ub.gds-obj.obj-type = 'скл':U then do:
       64       find ub.store where ub.store.obj-code = ub.gds-obj.obj-code no-lock.
       65       ub.gds-obj.host-code = ub.store.host-code.
       66     end.
       67     else do:
       68       find ub.shop where ub.shop.obj-code = ub.gds-obj.obj-code no-lock.
       69       ub.gds-obj.host-code = ub.shop.host-code.
       70     end.
       71     process events.
       72   end.
       73   for each ub.prt-obj :
       74     jm = jm + 1.
       75     disp jm with frame a view-as dialog-box.
       76     if ub.prt-obj.obj-type = 'скл':U then do:
       77       find ub.store where ub.store.obj-code = ub.prt-obj.obj-code no-lock.
       78       ub.prt-obj.host-code = ub.store.host-code.
       79     end.
       80     else do:
       81       find ub.shop where ub.shop.obj-code = ub.prt-obj.obj-code no-lock.
       82       ub.prt-obj.host-code = ub.shop.host-code.
       83     end.
       84     process events.
       85   end.
       86   message "Инициализация закончена успешно.".
