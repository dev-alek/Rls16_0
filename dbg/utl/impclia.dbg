        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as handle     no-undo .
        3   define input  parameter p-filename      as character  no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: impclia.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/impclia.p $":U .
        9   define variable vss-description as character no-undo init "Импорт артикулов поставщиков из файла".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define stream sinp .
       69   define stream slog.
       70   define buffer buf_ext-artic for ub.ext-artic.
       71   define buffer buf_goods     for ub.goods.
       72   define buffer buf_clients   for ub.clients.
       73   define variable v-cli-type  like ub.cli-gds.cli-type   no-undo .
       74   define variable v-cli-code  like ub.cli-gds.cli-code   no-undo .
       75   define variable v-host-code like ub.cli-gds.host-code  no-undo .
       76   define variable v-article   like ub.cli-gds.artic      no-undo .
       77   define variable v-prod-type like ub.cli-gds.prod-type  no-undo .
       78   define variable v-prod-code like ub.cli-gds.prod-code  no-undo .
       79   define variable v-cli-art   like ub.cli-gds.cli-art    no-undo .
       80   define variable vv-unit-cli           like ub.ext-artic.unit-cli           no-undo .
       81   define variable vv-cli-base-rate      like ub.ext-artic.cli-base-rate      no-undo .
       82   define variable vv-unit-cli-ord       like ub.ext-artic.unit-cli-ord       no-undo .
       83   define variable vv-cli-base-rate-ord  like ub.ext-artic.cli-base-rate-ord  no-undo .
       84   define variable vv-unit-cli-rcv       like ub.ext-artic.unit-cli-rcv       no-undo .
       85   define variable vv-cli-base-rate-rcv  like ub.ext-artic.cli-base-rate-rcv  no-undo .
       86   define variable v-log           as logical   no-undo .
       87   define variable v-full-filename as character no-undo .
       88   define variable v-i             as integer   no-undo .
       89   define variable v-str           as character no-undo .
       90   define variable v-num-entries   as integer   no-undo .
       91   define variable v-cli-str       as character no-undo .
       92   define variable v-mode          as character no-undo .
       93   define variable v-err-cnt       as integer   no-undo .
       94   define frame imp-frame
       95     v-i                 format ">>>>>>>>9"  label "Прочитано записей" skip
       96     v-cli-str           format "X(13)"      label "Поставщик"         skip
       97     v-cli-art           format "X(14)"      label "Артикул"
       98     with view-as dialog-box side-labels three-d
       99     title "Импорт артикулов поставщиков из файла"
      100     .
      101   do
      102   on error undo, return error return-value
      103   :
      104     message
      105       "Импортировать из текстового файла артикулы поставщика ? "
      106     view-as alert-box question buttons yes-no UPDATE v-log.
      107     if not v-log
      108     then do:
      109       return .
      110     end.
      111     assign
      112       v-full-filename = search( p-filename )
      113     .
      114     if v-full-filename = ?
      115     then do:
      116       message
      117         "Не найден файл " p-filename
      118       view-as alert-box error.
      119       return .
      120     end.
      121     input stream sinp from value (p-filename) convert source "1251".
      122     _read:
      123     repeat transaction
      124       on error undo _read, return error return-value
      125     :
      126       import stream sinp unformatted v-str.
      127       assign
      128         v-str = trim(v-str)
      129       .
      130       if v-str <> ""
      131       then do:
      132         assign
      133           v-i           = v-i + 1
      134           v-num-entries = num-entries( v-str , ";":U )
      135         .
      136         if v-num-entries = 7
      137         then do:
      138           assign
      139             v-cli-type  = entry( 1 , v-str , ";":U )
      140             v-cli-code  = integer( entry( 2 , v-str , ";":U ) )
      141             v-host-code = integer( entry( 3 , v-str , ";":U ) )
      142             v-article   = entry( 4 , v-str , ";":U )
      143             v-prod-type = entry( 5 , v-str , ";":U )
      144             v-prod-code = integer( entry( 6 , v-str , ";":U ) )
      145             v-cli-art   = entry( 7 , v-str , ";":U )
      146           no-error .
      147           find first buf_goods no-lock
      148             where buf_goods.artic     = v-article
      149               and buf_goods.prod-type = v-prod-type
      150               and buf_goods.prod-code = v-prod-code
      151           no-error .
      152           find first buf_clients no-lock
      153             where buf_clients.obj-type  = v-cli-type
      154               and buf_clients.obj-code  = v-cli-code
      155           no-error .
      156           if  available buf_goods and
      157               available buf_clients
      158               then do:
      159             find first buf_ext-artic no-lock
      160               where buf_ext-artic.cli-type  = v-cli-type
      161                 and buf_ext-artic.cli-code  = v-cli-code
      162                 and buf_ext-artic.gds-code  = buf_goods.gds-code
      163             no-error .
      164             if available buf_ext-artic
      165             then do:
      166                 assign
      167                 v-mode = 'ИЗМЕНЕНИЕ':U
      168                 .
      169               end.
      170             else do:
      171               assign
      172                 v-mode = 'ДОБАВЛЕНИЕ':U
      173               .
      174             end.
      175             run ref/extarts.p ( input v-mode
      176                         , input v-cli-type
      177                         , input v-cli-code
      178                         , input buf_goods.gds-code
      179                         , input v-cli-art
      180                         , input "":U
      181                         , input vv-unit-cli
      182                         , input vv-cli-base-rate
      183                         , input vv-unit-cli-ord
      184                         , input vv-cli-base-rate-ord
      185                         , input vv-unit-cli-rcv
      186                         , input vv-cli-base-rate-rcv
      187                        ) no-error .
      188             if error-status :error
      189             then do:
      190               run write-log in this-procedure ( input substitute( "&1 &2 &3"
      191                                                                 , trim(return-value)
      192                                                                 , trim(error-status :get-message(1))
      193                                                                 , trim(error-status :get-message(2))
      194                                                                 )
      195                                               ).
      196               assign
      197                 v-err-cnt = v-err-cnt + 1
      198               .
      199             end.
      200             assign
      201               v-cli-str = string(v-cli-code, "999999999")  +  " "  +  trim(v-cli-type)
      202             .
      203             display
      204               v-i
      205               v-cli-str
      206               v-cli-art
      207             with frame imp-frame.
      208             pause 0.
      209           end.
      210         end.
      211       end.
      212     end.
      213     input stream sinp close.
      214     if v-err-cnt > 0 then do:
      215       message
      216         substitute( "Ошибок при импорте: &1.&2Лог имопрта: &3"
      217                   , v-err-cnt
      218                   , chr(10)
      219                   , "impclia.log":U
      220                   )
      221       view-as alert-box information.
      222     end.
      223     message
      224       "Импорт завершен."
      225     view-as alert-box information.
      226   end.
      227   procedure write-log :
      228     define input parameter p-log-message as character no-undo.
      229   do
      230   on error undo, return error return-value
      231   :
      232     output stream slog to value("impclia.log":U) append.
      233     put stream slog unformatted
      234       today chr(9)
      235       string(time, "hh:mm:ss") chr(9)
      236       p-log-message
      237       chr(10)
      238     .
      239     output stream slog close.
      240   end.
      241   end procedure.
