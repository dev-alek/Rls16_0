        1   DEFINE TEMP-TABLE temp-drt-prop NO-UNDO LIKE ub.drt-prop
        2          field upper-prop-label as character
        3          field prop-label as character
        4          field full-prop-name as character.
        5   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        6   DEFINE OUTPUT PARAMETER p-upper-prop-code AS character NO-UNDO.
        7   DEFINE OUTPUT PARAMETER p-upper-node-code AS integer NO-UNDO.
        8   DEFINE OUTPUT PARAMETER p-upper-prop-label AS character NO-UNDO.
        9   DEFINE OUTPUT PARAMETER p-upper-full-prop-name AS character NO-UNDO.
       10   DEFINE OUTPUT PARAMETER p-prop-code AS character NO-UNDO.
       11   DEFINE OUTPUT PARAMETER p-node-code AS integer NO-UNDO.
       12   DEFINE OUTPUT PARAMETER p-prop-label AS character NO-UNDO.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Редактирование свойств шаблона правил скидок и расписаний".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define variable v-waitfram-action01         as character   no-undo .
       75   define variable v-waitfram-action02         as character   no-undo .
       76   define variable v-waitfram-action03         as character   no-undo .
       77   define variable mWaitFramTextBeg            as character   no-undo.
       78   define variable mWaitFramTextEnd            as character   no-undo.
       79   define variable mWaitFramView               as logical     no-undo.
       80   define variable mWaitProcEvent              as logical     no-undo init yes.
       81   define variable mWaitFramInterval           as integer     no-undo init 1 .
       82   define variable mWaitFramStop               as logical     no-undo.
       83   define variable mWaitFramStopUser           as logical     no-undo.
       84   define variable mWaitFramStopTimeOut        as logical     no-undo.
       85   define variable mWaitFramStartProc          as datetime-tz no-undo.
       86   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       87   define button B-WaitFramStop auto-end-key
       88        label "Стоп"
       89        size 10 by 1 tooltip "Остоновить процесс".
       90   define button B-viewProcInfo
       91        label "Информация"
       92        size 15 by 1 tooltip "Информация о процесс".
       93   define frame waitfram
       94     v-waitfram-action01 format "x(72)" no-label skip
       95     v-waitfram-action02 format "x(72)" no-label skip
       96     v-waitfram-action03 format "x(72)" no-label skip
       97     B-viewProcInfo
       98     B-WaitFramStop at row 4 col 30
       99     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      100     .
      101   define new global shared variable mBatchMode as logical no-undo init ?.
      102   define variable mFramBachModHandle as handle no-undo.
      103   mFramBachModHandle = frame waitfram:handle.
      104   define variable mFameOldVis as logical no-undo.
      105   define variable mVisCUrentVin as logical no-undo.
      106   if session:batch-mode
      107   then
      108      mBatchMode = yes.
      109   if mBatchMode = ? then do:
      110     mVisCUrentVin = current-window:visible.
      111     mFameOldVis = mFramBachModHandle:visible.
      112     mFramBachModHandle:visible  = yes.
      113     mBatchMode = mFramBachModHandle:visible ne yes.
      114     mFramBachModHandle:visible = mFameOldVis.
      115     current-window:visible = mVisCUrentVin.
      116   end.
      117    if  log-manager:logfile-name ne ?
      118     then DO:
      119         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      120         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      121         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      122     end.
      123   on choose of B-WaitFramStop in frame waitfram
      124   do:
      125     mWaitFramStop = yes.
      126     mWaitFramStopUser = yes.
      127   end.
      128   function waitfram-check-timeout returns logical():
      129      define variable vtime as int64 no-undo.
      130      if mWaitFramStopTimeOut
      131      then
      132         return yes.
      133      vtime = ( now - mWaitFramStartProc ) / 1000 .
      134      if     mWaitFramTimeOut ne ?
      135         and mWaitFramTimeOut ne 0
      136         and mWaitFramTimeOut lt vtime
      137      then do:
      138         mWaitFramStopTimeOut = yes.
      139      end.
      140      return mWaitFramStopTimeOut.
      141   end.
      142   procedure waitfram-hide :
      143     if not session:batch-mode
      144     then do
      145     on error undo, return error return-value
      146     :
      147       pause 0 before-hide .
      148       if not mBatchMode then
      149         hide frame waitfram .
      150     if     not mWaitFramView
      151        and mWaitProcEvent
      152     then
      153       process events .
      154     end.
      155   end procedure.
      156   procedure waitfram-show :
      157     define input  parameter p-message as character no-undo .
      158     define variable v-left-margin as integer   no-undo .
      159     if not session:batch-mode
      160     then do
      161     on error undo, return error return-value
      162     :
      163       if length(p-message) <= 70 then do:
      164         assign
      165           v-left-margin = integer((70 - length(p-message)) / 2)
      166         .
      167         assign
      168           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      169         .
      170         assign
      171           v-waitfram-action01 = " "
      172           v-waitfram-action02 = " "
      173                                    + fill(" ", v-left-margin)
      174                                    + p-message
      175           v-waitfram-action03 = " "
      176         .
      177       end.
      178       else do:
      179         define variable vRindex1 as integer no-undo.
      180         define variable vRindex2 as integer no-undo.
      181         vRindex1 = r-index(p-message," ",70).
      182         if vRindex1 = 0
      183         then
      184            vRindex1 = 70.
      185         if length(p-message)  <= vRindex1 + 70 then do:
      186           assign
      187             v-waitfram-action01 = " "
      188             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      190           .
      191         end.
      192         else do:
      193           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      194           if vRindex2 <= vRindex1
      195           then
      196              vRindex2 = vRindex1 + 70.
      197           assign
      198             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      199             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      200             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      201           .
      202         end.
      203       end.
      204       B-viewProcInfo:visible   in frame waitfram = no.
      205       B-viewProcInfo:sensitive in frame waitfram = no.
      206       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       if  (   mWaitFramView
      209          or  mWaitProcEvent)
      210          and not mBatchMode
      211       then
      212          display
      213             v-waitfram-action01 skip
      214             v-waitfram-action02 skip
      215             v-waitfram-action03 skip
      216          with frame waitfram .
      217       if     mWaitFramView
      218          then do:
      219             if     mWaitFramInterval ne ?
      220                and not mBatchMode
      221             then
      222                wait-for go of frame waitfram pause mWaitFramInterval.
      223          end.
      224          else
      225             if     mWaitProcEvent
      226                and not mBatchMode
      227             then
      228                process events .
      229     end.
      230   end procedure.
      231      procedure waitfram-show-this:
      232         define input  parameter iInterval as int64 no-undo.
      233         define variable vtime as int64 no-undo.
      234         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      235         mWaitFramInterval = iInterval.
      236         run waitfram-show (substitute("&1&2 &3&4" ,
      237                                       mWaitFramTextBeg ,
      238                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      239                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      240                                       mWaitFramTextEnd
      241                                      )
      242                           ).
      243      end.
      244      procedure WaitFramRunPause:
      245         define input  parameter iInterval as dec no-undo.
      246         define variable vStart  as datetime-tz no-undo.
      247         define variable vend    as datetime-tz no-undo.
      248         define variable vint as int64 no-undo.
      249         define variable vOk as logical no-undo.
      250         vStart = now.
      251         vend   = vStart.
      252         publish "WaitFramPause" (iInterval,output vOk).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and (   vint > 0
      258                 or (    not vOk
      259                     and iInterval eq ?
      260                     )
      261                 )
      262         then
      263            run waitfram-show-this (iInterval).
      264         vend   =  now.
      265         vint = vend - vStart.
      266         vint = iInterval - vint / 1000.
      267         if     not mWaitFramStop
      268            and vint > 0
      269         then do:
      270            run gbl/pause.p (vint * 1000).
      271         end.
      272         if iInterval ne ?
      273         then
      274            publish "WaitFramStop".
      275         waitfram-check-timeout().
      276      end.
      277      procedure WaitFramWaitFor:
      278         define input  parameter iInterval as dec no-undo.
      279         assign
      280            mWaitFramStartProc   = now
      281            mWaitFramStopUser    = no
      282            mWaitFramStopTimeOut = no
      283         .
      284         block-wait:
      285         do while not mWaitFramStop:
      286            run WaitFramRunPause (iInterval).
      287            if  waitfram-check-timeout()
      288            then do:
      289               leave block-wait.
      290            end.
      291         end.
      292         run waitfram-hide.
      293      end.
      294   procedure waitfram-join :
      295     define input  parameter p-line-1  as character no-undo .
      296     define input  parameter p-line-2  as character no-undo .
      297     define input  parameter p-line-3  as character no-undo .
      298     define output parameter p-message as character no-undo .
      299     do
      300     on error undo, return error return-value
      301     :
      302       assign
      303         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      306       .
      307     end.
      308   end procedure.
      309   function waitfram-join-function returns character
      310     (input p-line-1 as character
      311     ,input p-line-2 as character
      312     ,input p-line-3 as character
      313     ).
      314     define variable v-message as character no-undo .
      315     run waitfram-join in this-procedure
      316       (input  p-line-1
      317       ,input  p-line-2
      318       ,input  p-line-3
      319       ,output v-message
      320       ) .
      321     return v-message .
      322   end function .
      323   define new global shared variable g#language as character no-undo .
      324   if g#language <> '' and g#language <> 'rus':U then do:
      325     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      326   end.
      327   procedure proc-alt-shift-f2:
      328     if not ibs.th.gbl.gbl-var:rcode
      329   then
      330     run gbl\inidebug.p .
      331   end.
      332   procedure proc-alt-shift-f3:
      333     run gbl/prvssinf.p
      334       ( input this-procedure
      335       ) .
      336   end.
      337   define variable v-inform-launched as logical no-undo initial false .
      338   procedure proc-alt-shift-f4:
      339     define variable v-action as character no-undo .
      340     if v-inform-launched = false then do:
      341       assign
      342         v-inform-launched = true
      343       .
      344       run gbl/d-inform.w
      345         (  input self
      346         ,  input this-procedure
      347         , output v-action
      348         ) no-error .
      349       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      350       assign
      351         v-inform-launched = false
      352       .
      353     end.
      354   end.
      355   procedure proc-alt-f1:
      356     run gbl/corrhelp.p
      357       (input this-procedure
      358       ) .
      359   end .
      360   on alt-shift-f2 anywhere do:
      361     run proc-alt-shift-f2.
      362   end.
      363   on alt-shift-f3 anywhere do:
      364     run proc-alt-shift-f3 in this-procedure .
      365   end.
      366   on alt-shift-f4 anywhere do:
      367     run proc-alt-shift-f4 in this-procedure.
      368   end.
      369   on alt-f1 anywhere do:
      370     run proc-alt-f1 in this-procedure .
      371   end.
      372   DEFINE STREAM instream.
      373   DEFINE BUTTON B-exit AUTO-GO
      374        LABEL "&Ввод"
      375        SIZE 10 BY 1
      376        BGCOLOR 8 .
      377   DEFINE BUTTON B-Help
      378        LABEL "Помо&щь"
      379        SIZE 3 BY 1
      380        BGCOLOR 8 .
      381   DEFINE BUTTON b-quit AUTO-END-KEY
      382        LABEL "&Отмена"
      383        SIZE 10 BY 1
      384        BGCOLOR 8 .
      385   DEFINE VARIABLE f-prop-code AS CHARACTER FORMAT "X(256)":U
      386        LABEL "Название  пар-ра"
      387        VIEW-AS FILL-IN NATIVE
      388        SIZE 28.5 BY 1 NO-UNDO.
      389   DEFINE VARIABLE f-prop-label AS CHARACTER FORMAT "X(256)":U
      390        LABEL "Лейбл  пар-ра"
      391        VIEW-AS FILL-IN NATIVE
      392        SIZE 28.5 BY 1 NO-UNDO.
      393   DEFINE VARIABLE f-upper-prop-code AS CHARACTER FORMAT "X(256)":U
      394        LABEL "Название  секции"
      395        VIEW-AS FILL-IN NATIVE
      396        SIZE 28.5 BY 1 NO-UNDO.
      397   DEFINE VARIABLE f-upper-prop-label AS CHARACTER FORMAT "X(256)":U
      398        LABEL "Лейбл секции"
      399        VIEW-AS FILL-IN NATIVE
      400        SIZE 28.5 BY 1 NO-UNDO.
      401   DEFINE VARIABLE full-prop-name AS CHARACTER FORMAT "X(256)":U
      402         VIEW-AS TEXT
      403        SIZE 97.5 BY .67
      404        FGCOLOR 4  NO-UNDO.
      405   DEFINE VARIABLE rs-add AS CHARACTER INITIAL "sel"
      406        VIEW-AS RADIO-SET HORIZONTAL
      407        RADIO-BUTTONS
      408             "Существующий", "sel",
      409   "Новый", "add"
      410        SIZE 23.5 BY 1 NO-UNDO.
      411   DEFINE QUERY BR-drt-prop FOR
      412         temp-drt-prop SCROLLING.
      413   DEFINE BROWSE BR-drt-prop
      414     QUERY BR-drt-prop NO-LOCK DISPLAY
      415         temp-drt-prop.upper-prop-code COLUMN-LABEL "Назв.секции" FORMAT "X(255)" WIDTH 12
      416   temp-drt-prop.upper-node-code COLUMN-LABEL "Код выше.!узла" FORMAT ">>>>9"
      417   temp-drt-prop.upper-prop-label COLUMN-LABEL "Лейбл секции" FORMAT "X(255)" WIDTH 30
      418   temp-drt-prop.node-code COLUMN-LABEL "Код!узла" FORMAT ">>>>9"
      419   temp-drt-prop.prop-code  COLUMN-LABEL "Назв.пар-ра" FORMAT "X(255)" WIDTH 12
      420   temp-drt-prop.prop-label COLUMN-LABEL "Лейбл пар-ра" FORMAT "X(255)" WIDTH 30
      421       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17.5 FIT-LAST-COLUMN.
      422   DEFINE FRAME Dialog-Frame
      423        B-exit AT ROW 1 COL 1
      424        b-quit AT ROW 1 COL 11
      425        rs-add AT ROW 1 COL 39 NO-LABEL WIDGET-ID 50
      426        B-Help AT ROW 1 COL 95
      427        f-upper-prop-code AT ROW 2 COL 17 COLON-ALIGNED WIDGET-ID 42
      428        f-upper-prop-label AT ROW 2 COL 66.5 COLON-ALIGNED WIDGET-ID 46
      429        f-prop-label AT ROW 3 COL 66.5 COLON-ALIGNED WIDGET-ID 48
      430        f-prop-code AT ROW 3.27 COL 17 COLON-ALIGNED WIDGET-ID 44
      431        BR-drt-prop AT ROW 4.77 COL 1 WIDGET-ID 100
      432        full-prop-name AT ROW 22.5 COL 1.5 NO-LABEL WIDGET-ID 54
      433        SPACE(0.00) SKIP(0.10)
      434       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      435            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      436            TITLE ""
      437            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      438   ASSIGN
      439          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      440          FRAME Dialog-Frame:HIDDEN           = TRUE.
      441   ASSIGN
      442          f-upper-prop-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      443   ASSIGN
      444          f-upper-prop-label:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      445   ON GO OF FRAME Dialog-Frame
      446   DO:
      447     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      448   END.
      449   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      450   DO:
      451     APPLY "END-ERROR":U TO SELF.
      452   END.
      453   ON MOUSE-SELECT-DBLCLICK OF BR-drt-prop IN FRAME Dialog-Frame
      454   DO:
      455     if not available temp-drt-prop then return no-apply.
      456     apply "go":u to frame Dialog-Frame.
      457   END.
      458   ON VALUE-CHANGED OF BR-drt-prop IN FRAME Dialog-Frame
      459   DO:
      460     IF rs-add = "add" THEN DO:
      461       rs-add = "sel".
      462       DISPLAY
      463       rs-add
      464       WITH FRAME Dialog-Frame.
      465     END.
      466     IF AVAILABLE temp-drt-prop THEN DO:
      467     DISPLAY
      468     temp-drt-prop.upper-prop-code @ f-upper-prop-code
      469     temp-drt-prop.upper-prop-label @ f-upper-prop-label
      470     temp-drt-prop.prop-code @ f-prop-code
      471     temp-drt-prop.prop-label @ f-prop-label
      472     temp-drt-prop.full-prop-name @ full-prop-name
      473     WITH FRAME Dialog-Frame
      474     .
      475     END.
      476     ELSE DO:
      477       DISPLAY
      478       '':U @ f-upper-prop-code
      479       '':U @ f-upper-prop-label
      480       '':U @ f-prop-code
      481       '':U @ f-prop-label
      482       '':U @ full-prop-name
      483       WITH FRAME Dialog-Frame
      484       .
      485     END.
      486   END.
      487   ON VALUE-CHANGED OF rs-add IN FRAME Dialog-Frame
      488   DO:
      489     DEFINE BUFFER buf_temp-drt-prop FOR temp-drt-prop.
      490     ASSIGN
      491      rs-add.
      492     CASE rs-add:
      493       WHEN "add" THEN DO:
      494         IF NOT AVAILABLE temp-drt-prop THEN DO:
      495           MESSAGE
      496           "Не к чему привязать"
      497           VIEW-AS ALERT-BOX ERROR.
      498           ASSIGN
      499           rs-add = "sel".
      500           DISPLAY
      501           rs-add
      502           WITH FRAME Dialog-Frame.
      503           UNDO, RETURN NO-APPLY.
      504         END.
      505           ASSIGN
      506           f-prop-code = '':U
      507           f-prop-label = '':U
      508           f-upper-prop-code = temp-drt-prop.prop-code
      509           f-upper-prop-label = temp-drt-prop.prop-label
      510           .
      511           DISPLAY
      512           f-prop-code
      513           f-prop-label
      514           f-upper-prop-code
      515           f-upper-prop-label
      516           WITH frame Dialog-Frame.
      517       ENd.
      518     END CASE.
      519   END.
      520   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      521   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      522   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      523   on help of frame Dialog-Frame
      524   do:
      525     run gbl/app_help.p
      526       (input this-procedure :file-name
      527       ,input ''
      528       ,input ?
      529       ) no-error.
      530     if error-status :error then do:
      531       message
      532         "Ошибка при вызове помощи"
      533         error-status :get-message(1)
      534         view-as alert-box .
      535     end.
      536   end.
      537   run minbtn-set in this-procedure .
      538   on choose of b-help in frame Dialog-Frame
      539   do:
      540     apply "help":u to frame Dialog-Frame .
      541   end.
      542   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   procedure minbtn-set :
      544       do
      545           on error undo, return error return-value
      546           :
      547           define variable ii              as integer       no-undo .
      548           define variable fh              as widget-handle no-undo .
      549           define variable hh              as widget-handle no-undo .
      550           define variable v-h             as handle        extent 4 no-undo .
      551           define variable v-name-button   as character     no-undo .
      552           define variable v-help-old-x    as decimal       no-undo .
      553           define variable v-help-old-y    as decimal       no-undo .
      554           define variable v-help-old-size as decimal       no-undo .
      555           define variable v-frame-width   as decimal       no-undo .
      556           define variable jj              as integer       no-undo .
      557           do
      558               on error undo, return error
      559               :
      560               assign
      561                   v-frame-width = frame Dialog-Frame:width - 0.3
      562                   fh            = frame Dialog-Frame:first-child
      563                   hh            = fh:first-child
      564                   ii            = 1
      565                   .
      566               do while valid-handle(hh):
      567                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      568                   do:
      569                       case lc(hh:name) :
      570                           when "b-help" then
      571                               do:
      572                                   hh:load-image-up("cmp/b-help.bmp":u) .
      573                                   hh:load-image-down("cmp/b-help.bmp":u) .
      574                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      575                                   hh:TOOLTIP = "Помощь" .
      576                                   v-help-old-x = hh:column .
      577                                   v-help-old-y = hh:row    .
      578                                   v-help-old-size = hh:width .
      579                                   hh:width-chars = 2.5 .
      580                               end.
      581                           when "b-print" then
      582                               do:
      583                                   hh:load-image("cmp/b-print.bmp":u) .
      584                                   hh:TOOLTIP = "Печать" .
      585                                   v-h[ii] = hh:handle .
      586                                   ii = ii + 1 .
      587                                   hh:width-chars = 3 .
      588                               end.
      589                           when "b-history" or
      590                           when "b-hist" then
      591                               do:
      592                                   hh:load-image("cmp/b-hist.bmp":u) .
      593                                   hh:TOOLTIP = "История" .
      594                                   v-h[ii] = hh:handle .
      595                                   ii = ii + 1 .
      596                                   hh:width-chars = 3 .
      597                               end.
      598                           when "b-sch" then
      599                               do:
      600                                   hh:load-image("cmp/b-sch.bmp":u) .
      601                                   hh:TOOLTIP = "Установка Фильтра" .
      602                                   v-h[ii] = hh:handle .
      603                                   ii = ii + 1 .
      604                                   hh:width-chars = 3 .
      605                               end.
      606                           when "b-hist-user" then
      607                               do:
      608                                   hh:load-image("cmp/b-hist.bmp":u) .
      609                                   hh:TOOLTIP = "История пользователя" .
      610                                   ii = ii + 1 .
      611                               end.
      612                       end case.
      613                   end.
      614                   hh = hh:next-sibling.
      615               end.
      616               b-help:column = v-frame-width - b-help:width-chars.
      617               jj = 0.
      618               repeat ii = 4 to 1 by -1 :
      619                   if valid-handle (v-h[ii] ) then
      620                   do:
      621                       jj  = jj + 1 .
      622                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      623                       v-h[ii]:row    = v-help-old-y .
      624                   end.
      625               end.
      626           end.
      627       end.
      628   end procedure.
      629   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      630   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      631   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      632   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      633   define variable v-diasize-current-frame-width  as decimal   no-undo .
      634   define variable v-diasize-current-frame-height as decimal   no-undo .
      635   define variable v-diasize-change-size          as logical   no-undo .
      636   define variable v-diasize-resize-button        as handle    no-undo .
      637   define variable v-diasize-wndmax               as logical   no-undo .
      638   define variable v-diasize-wndstore             as logical   no-undo .
      639   define variable v-diasize-proc-name            as character no-undo .
      640   define variable v-diasize-browse-handle        as handle    no-undo .
      641   define variable v-diasize-browse-number        as integer   no-undo .
      642   define variable v-diasize-need-full-display    as logical   no-undo init false .
      643   define temp-table temp-diasize-handle no-undo
      644     field handle-value  as handle
      645     field save-position as decimal
      646     index xpk is primary unique handle-value
      647     .
      648   define temp-table temp-browse-handle no-undo
      649     field browse-type   as character
      650     field browse-number as integer
      651     field browse-handle as handle
      652     field original-size as decimal
      653     index xpk is primary unique browse-type browse-number
      654     index xie browse-type browse-handle
      655   .
      656   procedure diasize_change-height :
      657     define input  parameter p-change-value  as decimal   no-undo .
      658     define input  parameter p-move-resize   as logical   no-undo .
      659     define variable v-field-group-handle    as handle    no-undo .
      660     define variable v-object-handle         as handle    no-undo .
      661     define variable v-frame-height          as decimal   no-undo .
      662     define variable v-frame-virtual-height  as decimal   no-undo .
      663     define variable v-browse-height         as decimal   no-undo .
      664     define variable v-window-height         as decimal   no-undo .
      665     define variable v-window-virtual-height as decimal   no-undo .
      666     define variable v-change-sign           as integer   no-undo .
      667     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      668     define buffer buf_temp-browse-handle  for temp-browse-handle .
      669     if p-change-value > 0
      670     then do:
      671       if frame Dialog-Frame :height + p-change-value
      672           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      673       then do:
      674         assign
      675           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      676                           - (frame Dialog-Frame :height-chars)
      677         .
      678         if p-change-value <= 0
      679         then do:
      680           run diasize_position-resize-button in this-procedure .
      681           return .
      682         end.
      683       end.
      684     end.
      685     if p-change-value < 0
      686     then do:
      687       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      688       then do:
      689         assign
      690           p-change-value = v-diasize-orig-frame-height
      691                          - (frame Dialog-Frame :height-chars)
      692         .
      693         if p-change-value >= 0
      694         then do:
      695           run diasize_position-resize-button in this-procedure .
      696           return .
      697         end.
      698       end.
      699     end.
      700     if p-change-value >= 0
      701     then do:
      702       assign
      703         v-change-sign = 1
      704       .
      705     end.
      706     else do:
      707       assign
      708         v-change-sign = -1
      709       .
      710     end.
      711     assign
      712       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      713     .
      714     if p-change-value = 0
      715     then do:
      716       run diasize_position-resize-button in this-procedure .
      717       return .
      718     end.
      719     move_block:
      720     do
      721     on error undo move_block, retry move_block
      722     :
      723       if retry
      724       then do:
      725         do
      726         on error undo move_block, leave move_block
      727         :
      728           if p-change-value > 0
      729           then do:
      730             for each buf_temp-diasize-handle
      731             on error undo, next
      732             :
      733               assign
      734                 v-object-handle = buf_temp-diasize-handle.handle-value
      735               .
      736               if v-object-handle <> v-diasize-resize-button
      737               then do:
      738                 assign
      739                   v-object-handle :row = buf_temp-diasize-handle.save-position
      740                 .
      741               end.
      742             end.
      743             assign
      744               v-diasize-browse-handle :height = v-browse-height
      745             .
      746             for each buf_temp-browse-handle
      747               where buf_temp-browse-handle.browse-type = 'height':u
      748             on error undo, next
      749             :
      750               assign
      751                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      752               .
      753             end.
      754             assign
      755               frame Dialog-Frame :height = v-frame-height
      756             .
      757             if frame Dialog-Frame :scrollable = true
      758             then do:
      759               assign
      760                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      761               .
      762             end.
      763             run diasize_position-resize-button in this-procedure .
      764           end.
      765           else do:
      766             if frame Dialog-Frame :scrollable = true
      767             then do:
      768               assign
      769                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      770               .
      771             end.
      772             assign
      773               frame Dialog-Frame :height = v-frame-height
      774             .
      775             assign
      776               v-diasize-browse-handle :height = v-browse-height
      777             .
      778             for each buf_temp-browse-handle
      779               where buf_temp-browse-handle.browse-type = 'height':u
      780             on error undo, next
      781             :
      782               assign
      783                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      784               .
      785             end.
      786             for each buf_temp-diasize-handle
      787             on error undo, next
      788             :
      789               assign
      790                 v-object-handle = buf_temp-diasize-handle.handle-value
      791               .
      792               if v-object-handle <> v-diasize-resize-button
      793               then do:
      794                 assign
      795                   v-object-handle :row = buf_temp-diasize-handle.save-position
      796                 .
      797               end.
      798             end.
      799             run diasize_position-resize-button in this-procedure .
      800           end.
      801           assign
      802             v-diasize-change-size = false
      803           .
      804           leave move_block .
      805         end.
      806       end.
      807       assign
      808         v-diasize-need-full-display = true
      809       .
      810       if v-diasize-change-size = false
      811       then do:
      812         assign
      813           v-diasize-change-size = true
      814         .
      815       end.
      816       else do:
      817         return .
      818       end.
      819       assign
      820         v-frame-height = frame Dialog-Frame :height
      821         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      822         v-browse-height = v-diasize-browse-handle :height
      823       .
      824       for each buf_temp-browse-handle
      825         where buf_temp-browse-handle.browse-type = 'height':u
      826       :
      827         assign
      828           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      829         .
      830       end.
      831       for each buf_temp-diasize-handle
      832       :
      833         delete buf_temp-diasize-handle .
      834       end.
      835       assign
      836         v-field-group-handle = frame Dialog-Frame :first-child
      837       .
      838       do while valid-handle(v-field-group-handle)
      839       :
      840         assign
      841           v-object-handle = v-field-group-handle :first-child
      842         .
      843         do while valid-handle(v-object-handle)
      844         :
      845           if  v-object-handle <> v-diasize-browse-handle :handle
      846           and can-query(v-object-handle, "row")
      847           and can-query(v-object-handle, "height")
      848           and ( v-object-handle :row > v-diasize-browse-handle :row )
      849           then do:
      850             find first buf_temp-browse-handle
      851               where buf_temp-browse-handle.browse-type   = 'height':u
      852                 and buf_temp-browse-handle.browse-handle = v-object-handle
      853               no-error .
      854             if available buf_temp-browse-handle
      855             then do:
      856             end.
      857             else do:
      858               create buf_temp-diasize-handle .
      859               assign
      860                 buf_temp-diasize-handle.handle-value  = v-object-handle
      861                 buf_temp-diasize-handle.save-position = v-object-handle :row
      862               .
      863             end.
      864           end.
      865           assign
      866             v-object-handle = v-object-handle :next-sibling
      867           .
      868         end.
      869         assign
      870           v-field-group-handle = v-field-group-handle :next-sibling
      871         .
      872       end.
      873       do with frame Dialog-Frame
      874       :
      875         hide v-diasize-resize-button .
      876         assign
      877           v-diasize-resize-button :row    = 1
      878           v-diasize-resize-button :column = 1
      879         .
      880       end.
      881       if p-change-value > 0
      882       then do:
      883         if frame Dialog-Frame :scrollable = true
      884         then do:
      885           assign
      886             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      887             no-error .
      888           if error-status :error
      889           or error-status :get-message(1) <> ""
      890           then do:
      891             undo move_block, retry move_block .
      892           end.
      893         end.
      894         assign
      895           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      896           no-error .
      897         if error-status :error
      898         or error-status :get-message(1) <> ""
      899         then do:
      900           undo move_block, retry move_block .
      901         end.
      902         assign
      903           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      904           no-error .
      905         if error-status :error
      906         or error-status :get-message(1) <> ""
      907         then do:
      908           undo move_block, retry move_block .
      909         end.
      910         for each buf_temp-browse-handle
      911           where buf_temp-browse-handle.browse-type = 'height':u
      912         on error undo move_block, retry move_block
      913         :
      914           assign
      915             buf_temp-browse-handle.browse-handle :height
      916               = buf_temp-browse-handle.browse-handle :height + p-change-value
      917             no-error .
      918           if error-status :error
      919           or error-status :get-message(1) <> ""
      920           then do:
      921             undo move_block, retry move_block .
      922           end.
      923         end.
      924         for each buf_temp-diasize-handle
      925         on error undo move_block, retry move_block
      926         :
      927           assign
      928             v-object-handle = buf_temp-diasize-handle.handle-value
      929           .
      930           if v-object-handle <> v-diasize-resize-button
      931           then do:
      932             assign
      933               v-object-handle :row = v-object-handle :row + p-change-value
      934               no-error .
      935             if error-status :error
      936             or error-status :get-message(1) <> ""
      937             then do:
      938               undo move_block, retry move_block .
      939             end.
      940           end.
      941         end.
      942       end.
      943       else do:
      944         for each buf_temp-diasize-handle
      945         on error undo move_block, retry move_block
      946         :
      947           assign
      948             v-object-handle = buf_temp-diasize-handle.handle-value
      949           .
      950           if v-object-handle <> v-diasize-resize-button
      951           then do:
      952             assign
      953               v-object-handle :row = v-object-handle :row + p-change-value
      954               no-error .
      955             if error-status :error
      956             or error-status :get-message(1) <> ""
      957             then do:
      958               undo move_block, retry move_block .
      959             end.
      960           end.
      961         end.
      962         assign
      963           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      964           no-error .
      965         if error-status :error
      966         or error-status :get-message(1) <> ""
      967         then do:
      968           undo move_block, retry move_block .
      969         end.
      970         for each buf_temp-browse-handle
      971           where buf_temp-browse-handle.browse-type = 'height':u
      972         on error undo move_block, retry move_block
      973         :
      974           assign
      975             buf_temp-browse-handle.browse-handle :height
      976               = buf_temp-browse-handle.browse-handle :height + p-change-value
      977             no-error .
      978           if error-status :error
      979           or error-status :get-message(1) <> ""
      980           then do:
      981             undo move_block, retry move_block .
      982           end.
      983         end.
      984         assign
      985           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      986           no-error .
      987         if error-status :error
      988         or error-status :get-message(1) <> ""
      989         then do:
      990           undo move_block, retry move_block .
      991         end.
      992         if frame Dialog-Frame :scrollable = true
      993         then do:
      994           assign
      995             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      996             no-error .
      997           if error-status :error
      998           or error-status :get-message(1) <> ""
      999           then do:
     1000             undo move_block, retry move_block .
     1001           end.
     1002         end.
     1003       end.
     1004       if p-move-resize = true
     1005       then do:
     1006         run diasize_position-resize-button in this-procedure .
     1007       end.
     1008       if v-diasize-wndstore = true
     1009       then do:
     1010         if connected("ub") = true
     1011         then do:
     1012           define variable v-cntxt-db-num        as integer   no-undo .
     1013           define variable v-cntxt-userid        as character no-undo .
     1014           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1015                                             , OUTPUT v-cntxt-userid
     1016                                             ) .
     1017           run gbl/wndsizew.p
     1018             (input  v-cntxt-db-num
     1019             ,input  v-cntxt-userid
     1020             ,input  v-diasize-proc-name
     1021             ,input  'height':u
     1022             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1023             ) .
     1024         end.
     1025       end.
     1026     end.
     1027     assign
     1028       v-diasize-change-size = false
     1029     .
     1030   end procedure.
     1031   procedure diasize_set-height :
     1032     define input  parameter p-new-height  as decimal   no-undo .
     1033     define input  parameter p-move-resize as logical   no-undo .
     1034     do
     1035     on error undo, return error return-value
     1036     :
     1037       run diasize_change-height in this-procedure
     1038         (input  (p-new-height - frame Dialog-Frame :height)
     1039         ,input  p-move-resize
     1040         ) .
     1041     end.
     1042   end procedure.
     1043   procedure diasize_change-width :
     1044     define input  parameter p-change-value as decimal   no-undo .
     1045     define input  parameter p-move-resize  as logical   no-undo .
     1046     define variable v-field-group-handle   as handle    no-undo .
     1047     define variable v-object-handle        as handle    no-undo .
     1048     define variable v-frame-width          as decimal   no-undo .
     1049     define variable v-frame-virtual-width  as decimal   no-undo .
     1050     define variable v-browse-width         as decimal   no-undo .
     1051     define variable v-window-width         as decimal   no-undo .
     1052     define variable v-window-virtual-width as decimal   no-undo .
     1053     define variable v-change-sign          as integer   no-undo .
     1054     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1055     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1056     if p-change-value > 0
     1057     then do:
     1058       if frame Dialog-Frame :width + p-change-value >
     1059           session :width-chars
     1060       then do:
     1061         assign
     1062           p-change-value = session :width-chars - frame Dialog-Frame :width
     1063         .
     1064         if p-change-value <= 0
     1065         then do:
     1066           run diasize_position-resize-button in this-procedure .
     1067           return .
     1068         end.
     1069       end.
     1070     end.
     1071     if p-change-value < 0
     1072     then do:
     1073       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1074       then do:
     1075         assign
     1076           p-change-value = v-diasize-orig-frame-width
     1077                          - frame Dialog-Frame :width
     1078         .
     1079         if p-change-value >= 0
     1080         then do:
     1081           run diasize_position-resize-button in this-procedure .
     1082           return .
     1083         end.
     1084       end.
     1085     end.
     1086     if p-change-value >= 0
     1087     then do:
     1088       assign
     1089         v-change-sign = 1
     1090       .
     1091     end.
     1092     else do:
     1093       assign
     1094         v-change-sign = -1
     1095       .
     1096     end.
     1097     assign
     1098       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1099     .
     1100     if p-change-value = 0
     1101     then do:
     1102       run diasize_position-resize-button in this-procedure .
     1103       return .
     1104     end.
     1105     move_block:
     1106     do
     1107     on error undo move_block, leave move_block
     1108     :
     1109       if retry
     1110       then do:
     1111         do
     1112         on error undo move_block, leave move_block
     1113         :
     1114           if p-change-value > 0
     1115           then do:
     1116             for each buf_temp-diasize-handle
     1117             on error undo, next
     1118             :
     1119               assign
     1120                 v-object-handle = buf_temp-diasize-handle.handle-value
     1121               .
     1122               if v-object-handle <> v-diasize-resize-button
     1123               then do:
     1124                 assign
     1125                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1126                 .
     1127               end.
     1128             end.
     1129             assign
     1130               v-diasize-browse-handle :width = v-browse-width
     1131             .
     1132             for each buf_temp-browse-handle
     1133               where buf_temp-browse-handle.browse-type = 'width':u
     1134             on error undo, next
     1135             :
     1136               assign
     1137                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1138               .
     1139             end.
     1140             assign
     1141               frame Dialog-Frame :width = v-frame-width
     1142             .
     1143             if frame Dialog-Frame :scrollable = true
     1144             then do:
     1145               assign
     1146                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1147               .
     1148             end.
     1149             run diasize_position-resize-button in this-procedure .
     1150           end.
     1151           else do:
     1152             if frame Dialog-Frame :scrollable = true
     1153             then do:
     1154               assign
     1155                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1156               .
     1157             end.
     1158             assign
     1159               frame Dialog-Frame :width = v-frame-width
     1160             .
     1161             for each buf_temp-browse-handle
     1162               where buf_temp-browse-handle.browse-type = 'width':u
     1163             on error undo, next
     1164             :
     1165               assign
     1166                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1167               .
     1168             end.
     1169             assign
     1170               v-diasize-browse-handle :width = v-browse-width
     1171             .
     1172             for each buf_temp-diasize-handle
     1173             on error undo, next
     1174             :
     1175               assign
     1176                 v-object-handle = buf_temp-diasize-handle.handle-value
     1177               .
     1178               if v-object-handle <> v-diasize-resize-button
     1179               then do:
     1180                 assign
     1181                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1182                 .
     1183               end.
     1184             end.
     1185             run diasize_position-resize-button in this-procedure .
     1186           end.
     1187           assign
     1188             v-diasize-change-size = false
     1189           .
     1190           leave move_block .
     1191         end.
     1192       end.
     1193       assign
     1194         v-diasize-need-full-display = true
     1195       .
     1196       if v-diasize-change-size = false
     1197       then do:
     1198         assign
     1199           v-diasize-change-size = true
     1200         .
     1201       end.
     1202       else do:
     1203         return .
     1204       end.
     1205       assign
     1206         v-frame-width = frame Dialog-Frame :width
     1207         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1208         v-browse-width = v-diasize-browse-handle :width
     1209       .
     1210       for each buf_temp-browse-handle
     1211         where buf_temp-browse-handle.browse-type = 'width':u
     1212       :
     1213         assign
     1214           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1215         .
     1216       end.
     1217       for each buf_temp-diasize-handle
     1218       :
     1219         delete buf_temp-diasize-handle .
     1220       end.
     1221       assign
     1222         v-field-group-handle = frame Dialog-Frame :first-child
     1223       .
     1224       do while valid-handle(v-field-group-handle)
     1225       :
     1226         assign
     1227           v-object-handle = v-field-group-handle :first-child
     1228         .
     1229         do while valid-handle(v-object-handle)
     1230         :
     1231           if  v-object-handle <> v-diasize-browse-handle :handle
     1232           and v-object-handle <> v-diasize-resize-button
     1233           and can-query(v-object-handle, "row")
     1234           and can-query(v-object-handle, "height")
     1235           and ( v-object-handle :col + v-object-handle :width
     1236                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1237               )
     1238           then do:
     1239             find first buf_temp-browse-handle
     1240               where buf_temp-browse-handle.browse-type   = 'width':u
     1241                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1242               no-error .
     1243             if available buf_temp-browse-handle
     1244             then do:
     1245             end.
     1246             else do:
     1247               create buf_temp-diasize-handle .
     1248               assign
     1249                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1250                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1251               .
     1252             end.
     1253           end.
     1254           assign
     1255             v-object-handle = v-object-handle :next-sibling
     1256           .
     1257         end.
     1258         assign
     1259           v-field-group-handle = v-field-group-handle :next-sibling
     1260         .
     1261       end.
     1262       do with frame Dialog-Frame
     1263       :
     1264         hide v-diasize-resize-button .
     1265         v-diasize-resize-button :row = 1.
     1266         v-diasize-resize-button :column = 1.
     1267       end.
     1268       if p-change-value > 0
     1269       then do:
     1270         if frame Dialog-Frame :scrollable = true
     1271         then do:
     1272           assign
     1273             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1274             no-error .
     1275           if error-status :error
     1276           or error-status :get-message(1) <> ""
     1277           then do:
     1278             undo move_block, retry move_block.
     1279           end.
     1280         end.
     1281         assign
     1282           frame Dialog-Frame :width = v-frame-width + p-change-value
     1283           no-error .
     1284         if error-status :error
     1285         or error-status :get-message(1) <> ""
     1286         then do:
     1287           undo move_block, retry move_block.
     1288         end.
     1289         assign
     1290           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1291         no-error .
     1292         if error-status :error
     1293         or error-status :get-message(1) <> ""
     1294         then do:
     1295           undo move_block, retry move_block.
     1296         end.
     1297         for each buf_temp-browse-handle
     1298           where buf_temp-browse-handle.browse-type = 'width':u
     1299         on error undo move_block, retry move_block
     1300         :
     1301           assign
     1302             buf_temp-browse-handle.browse-handle :width
     1303               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1304             no-error .
     1305           if error-status :error
     1306           or error-status :get-message(1) <> ""
     1307           then do:
     1308             undo move_block, retry move_block .
     1309           end.
     1310         end.
     1311         for each buf_temp-diasize-handle
     1312         on error undo move_block, retry move_block
     1313         :
     1314           assign
     1315             v-object-handle = buf_temp-diasize-handle.handle-value
     1316           .
     1317           if v-object-handle <> v-diasize-resize-button
     1318           then do:
     1319             assign
     1320               v-object-handle :col = v-object-handle :col + p-change-value
     1321               no-error .
     1322             if error-status :error
     1323             or error-status :get-message(1) <> ""
     1324             then do:
     1325               undo move_block, retry move_block .
     1326             end.
     1327           end.
     1328         end.
     1329       end.
     1330       else do:
     1331         for each buf_temp-diasize-handle
     1332         on error undo move_block, retry move_block
     1333         :
     1334           assign
     1335             v-object-handle = buf_temp-diasize-handle.handle-value
     1336           .
     1337           if v-object-handle <> v-diasize-resize-button
     1338           then do:
     1339             assign
     1340               v-object-handle :col = v-object-handle :col + p-change-value
     1341               no-error .
     1342             if error-status :error
     1343             or error-status :get-message(1) <> ""
     1344             then do:
     1345               undo move_block, retry move_block .
     1346             end.
     1347           end.
     1348         end.
     1349         for each buf_temp-browse-handle
     1350           where buf_temp-browse-handle.browse-type = 'width':u
     1351         on error undo move_block, retry move_block
     1352         :
     1353           assign
     1354             buf_temp-browse-handle.browse-handle :width
     1355               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1356             no-error .
     1357           if error-status :error
     1358           or error-status :get-message(1) <> ""
     1359           then do:
     1360             undo move_block, retry move_block .
     1361           end.
     1362         end.
     1363         assign
     1364           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1365           no-error .
     1366         if error-status :error
     1367         or error-status :get-message(1) <> ""
     1368         then do:
     1369           undo move_block, retry move_block.
     1370         end.
     1371         assign
     1372           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1373         no-error .
     1374         if error-status :error
     1375         or error-status :get-message(1) <> ""
     1376         then do:
     1377           undo move_block, retry move_block.
     1378         end.
     1379         if frame Dialog-Frame :scrollable = true
     1380         then do:
     1381           assign
     1382             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1383           no-error .
     1384           if error-status :error
     1385           or error-status :get-message(1) <> ""
     1386           then do:
     1387             undo move_block, retry move_block.
     1388           end.
     1389         end.
     1390       end.
     1391       if p-move-resize
     1392       then do:
     1393         run diasize_position-resize-button in this-procedure .
     1394       end.
     1395       if v-diasize-wndstore = true
     1396       then do:
     1397         if connected("ub") = true
     1398         then do:
     1399           define variable v-cntxt-db-num        as integer   no-undo .
     1400           define variable v-cntxt-userid        as character no-undo .
     1401           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1402                                             , OUTPUT v-cntxt-userid
     1403                                             ) .
     1404           run gbl/wndsizew.p
     1405             (input  v-cntxt-db-num
     1406             ,input  v-cntxt-userid
     1407             ,input  v-diasize-proc-name
     1408             ,input  'width':u
     1409             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1410             ) .
     1411         end.
     1412       end.
     1413     end.
     1414     assign
     1415       v-diasize-change-size = false
     1416     .
     1417   end procedure.
     1418   procedure diasize_set-width :
     1419     define input  parameter p-new-width  as decimal   no-undo .
     1420     define input  parameter p-move-resize as logical   no-undo .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424       run diasize_change-width in this-procedure
     1425         (input  (p-new-width - frame Dialog-Frame :width)
     1426         ,input  p-move-resize
     1427         ) .
     1428     end.
     1429   end procedure.
     1430   procedure diasize_position-resize-button :
     1431     do with frame Dialog-Frame
     1432     :
     1433       hide v-diasize-resize-button .
     1434       assign
     1435         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1436                     - 1
     1437                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1438         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1439                     - 1
     1440                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1441       .
     1442       view v-diasize-resize-button .
     1443     end.
     1444   end procedure.
     1445   on alt-right anywhere
     1446   do:
     1447     run diasize_change-width in this-procedure
     1448       (input 1
     1449       ,input true
     1450       ) .
     1451     return no-apply .
     1452   end.
     1453   on alt-left anywhere
     1454   do:
     1455     run diasize_change-width in this-procedure
     1456       (input -1
     1457       ,input true
     1458       ) .
     1459     return no-apply .
     1460   end.
     1461   on alt-down anywhere
     1462   do:
     1463     run diasize_change-height in this-procedure
     1464       (input 1
     1465       ,input true
     1466       ) .
     1467     return no-apply .
     1468   end.
     1469   on alt-up anywhere
     1470   do:
     1471     run diasize_change-height in this-procedure
     1472       (input -1
     1473       ,input true
     1474       ) .
     1475     return no-apply .
     1476   end.
     1477   on alt-enter of frame Dialog-Frame
     1478   do:
     1479     run diasize_maximize in this-procedure
     1480       (input  ?
     1481       ).
     1482     return no-apply .
     1483   end.
     1484   procedure diasize_end-move :
     1485     do
     1486     on error undo, return error return-value
     1487     :
     1488       define variable v-row-delta as decimal   no-undo .
     1489       define variable v-col-delta as decimal   no-undo .
     1490       define variable v-new-row as decimal   no-undo .
     1491       define variable v-new-col as decimal   no-undo .
     1492       assign
     1493         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1494         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1495       .
     1496       assign
     1497         v-row-delta = v-new-row - frame Dialog-Frame :height
     1498         v-col-delta = v-new-col - frame Dialog-Frame :width
     1499       .
     1500       run diasize_change-height in this-procedure
     1501         (input v-row-delta
     1502         ,input true
     1503         ) .
     1504       run diasize_change-width in this-procedure
     1505         (input v-col-delta
     1506         ,input true
     1507         ) .
     1508     end.
     1509   end procedure.
     1510   procedure diasize_maximize :
     1511     define input  parameter p-action as logical   no-undo .
     1512     do
     1513     on error undo, return error return-value
     1514     :
     1515       if p-action = ?
     1516       then do:
     1517         if v-diasize-need-maximize = true
     1518         then do:
     1519           assign
     1520             p-action = true
     1521           .
     1522         end.
     1523         else do:
     1524           assign
     1525             p-action = false
     1526           .
     1527         end.
     1528       end.
     1529       if p-action = true
     1530       then do:
     1531         run diasize_change-height in this-procedure
     1532           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1533               - frame Dialog-Frame :height-chars
     1534           ,input true
     1535           ) .
     1536         run diasize_change-width in this-procedure
     1537           (input session :width-chars
     1538               - frame Dialog-Frame :width-chars
     1539           ,input true
     1540           ) .
     1541         assign
     1542           v-diasize-need-maximize = false
     1543         .
     1544       end.
     1545       else do:
     1546         run diasize_change-width in this-procedure
     1547           (input v-diasize-orig-frame-width
     1548               - frame Dialog-Frame :width-chars
     1549           ,input true
     1550           ) .
     1551         run diasize_change-height in this-procedure
     1552           (input v-diasize-orig-frame-height
     1553               - frame Dialog-Frame :height-chars
     1554           ,input true
     1555           ) .
     1556         assign
     1557           v-diasize-need-maximize = true
     1558         .
     1559       end.
     1560     end.
     1561   end procedure.
     1562   procedure diasize_restore-orig-size :
     1563     do
     1564     on error undo, return error return-value
     1565     :
     1566       assign
     1567         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1568         v-diasize-current-frame-height = frame Dialog-Frame :height
     1569       .
     1570       run diasize_set-height in this-procedure
     1571         (input  v-diasize-orig-frame-height
     1572         ,input  true
     1573         ) .
     1574       run diasize_set-width in this-procedure
     1575         (input  v-diasize-orig-frame-width
     1576         ,input  true
     1577         ) .
     1578     end.
     1579   end procedure.
     1580   procedure diasize_restore-current-size :
     1581     do
     1582     on error undo, return error return-value
     1583     :
     1584       run diasize_set-height in this-procedure
     1585         (input  v-diasize-current-frame-height
     1586         ,input  true
     1587         ) .
     1588       run diasize_set-width in this-procedure
     1589         (input  v-diasize-current-frame-width
     1590         ,input  true
     1591         ) .
     1592     end.
     1593   end procedure.
     1594   procedure diasize_set-browse-handle :
     1595     define input  parameter p-browse-handle as handle   no-undo .
     1596     define buffer buf_temp-browse-handle for temp-browse-handle .
     1597     do
     1598     on error undo, return error return-value
     1599     :
     1600       assign
     1601         v-diasize-browse-handle = p-browse-handle
     1602       .
     1603       for each buf_temp-browse-handle
     1604       on error undo, return error return-value
     1605       :
     1606         delete buf_temp-browse-handle .
     1607       end.
     1608     end.
     1609   end procedure.
     1610   procedure diasize_add_browse :
     1611     define input  parameter p-browse-type   as character no-undo .
     1612     define input  parameter p-browse-handle as handle    no-undo .
     1613     define buffer buf_temp-browse-handle for temp-browse-handle .
     1614     do
     1615     on error undo, return error return-value
     1616     :
     1617       assign
     1618         v-diasize-browse-number = v-diasize-browse-number + 1
     1619       .
     1620       create buf_temp-browse-handle .
     1621       assign
     1622         buf_temp-browse-handle.browse-type   = p-browse-type
     1623         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1624         buf_temp-browse-handle.browse-handle = p-browse-handle
     1625       .
     1626     end.
     1627   end procedure.
     1628   procedure diasize_init :
     1629     define variable v-default-value    as logical   no-undo .
     1630     define variable v-restore-saved    as logical   no-undo .
     1631     define variable v-resize-value-str as character no-undo .
     1632     do
     1633     on error undo, return error return-value
     1634     :
     1635       do with frame Dialog-Frame
     1636       :
     1637         assign
     1638           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1639           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1640           v-diasize-browse-handle     = browse BR-drt-prop :handle
     1641         .
     1642         create button v-diasize-resize-button
     1643         assign
     1644           parent        = frame Dialog-Frame :first-child
     1645           label         = "s"
     1646           height-pixels = 16
     1647           width-pixels  = 16
     1648           visible       = true
     1649           sensitive     = true
     1650           movable       = true
     1651           triggers:
     1652             on end-move persistent run diasize_end-move in this-procedure .
     1653           end triggers.
     1654         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1655         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1656         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1657         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1658         assign
     1659           v-diasize-wndmax = false
     1660         .
     1661         if connected("ub") = true
     1662         then do:
     1663           define variable v-cntxt-db-num        as integer   no-undo .
     1664           define variable v-cntxt-userid        as character no-undo .
     1665           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1666                                             , OUTPUT v-cntxt-userid
     1667                                             ) .
     1668           run gbl/wndpar_r.p
     1669             (input  v-cntxt-db-num
     1670             ,input  v-cntxt-userid
     1671             ,input  'wndmax':U
     1672             ,output v-diasize-wndmax
     1673             ,output v-default-value
     1674             ) .
     1675         end.
     1676         assign
     1677           v-diasize-wndstore = false
     1678         .
     1679         if connected("ub") = true
     1680         then do:
     1681           run gbl/wndpar_r.p
     1682             (input  v-cntxt-db-num
     1683             ,input  v-cntxt-userid
     1684             ,input  'wndstore':U
     1685             ,output v-diasize-wndstore
     1686             ,output v-default-value
     1687             ) .
     1688         end.
     1689         assign
     1690           v-diasize-proc-name = entry(1, program-name(2), '.')
     1691         .
     1692         if v-diasize-wndstore = true
     1693         then do:
     1694           assign
     1695             v-restore-saved = false
     1696           .
     1697           if connected("ub") = true
     1698           then do:
     1699             run gbl/wndsizer.p
     1700               (input  v-cntxt-db-num
     1701               ,input  v-cntxt-userid
     1702               ,input  v-diasize-proc-name
     1703               ,input  'height':u
     1704               ,output v-resize-value-str
     1705               ) .
     1706             if v-resize-value-str <> '':U
     1707             then do:
     1708               run diasize_change-height in this-procedure
     1709                 (input  integer(v-resize-value-str)
     1710                 ,input  true
     1711                 ) .
     1712               assign
     1713                 v-restore-saved = true
     1714               .
     1715             end.
     1716           end.
     1717           if connected("ub") = true
     1718           then do:
     1719             run gbl/wndsizer.p
     1720               (input  v-cntxt-db-num
     1721               ,input  v-cntxt-userid
     1722               ,input  v-diasize-proc-name
     1723               ,input  'width':u
     1724               ,output v-resize-value-str
     1725               ) .
     1726             if v-resize-value-str <> '':U
     1727             then do:
     1728               run diasize_change-width in this-procedure
     1729                 (input  integer(v-resize-value-str)
     1730                 ,input  true
     1731                 ) .
     1732               assign
     1733                 v-restore-saved = true
     1734               .
     1735             end.
     1736           end.
     1737           if v-restore-saved <> true
     1738           then do:
     1739             if v-diasize-wndmax = true
     1740             then do:
     1741               run diasize_maximize in this-procedure
     1742                 (input  true
     1743                 ) .
     1744             end.
     1745           end.
     1746         end.
     1747         else do:
     1748           if v-diasize-wndmax = true
     1749           then do:
     1750             run diasize_maximize in this-procedure
     1751               (input  true
     1752               ) .
     1753           end.
     1754         end.
     1755       end.
     1756     end.
     1757   end procedure.
     1758   procedure diasize_need-full-display :
     1759     define output parameter p-need-full-display as logical   no-undo .
     1760     do
     1761     on error undo, return error return-value
     1762     :
     1763       assign
     1764         p-need-full-display = v-diasize-need-full-display
     1765       .
     1766       assign
     1767         v-diasize-need-full-display = false
     1768       .
     1769     end.
     1770   end procedure.
     1771   procedure get-context :
     1772      define output parameter p-db-num as integer          no-undo.
     1773      define output parameter p-user-id as character        no-undo.
     1774      define variable v-login               as character    no-undo.
     1775      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1776      define buffer buf_user-login  for ub.user-login .
     1777      do
     1778      on error undo, return error
     1779      :
     1780            FIND FIRST buf_sys-ctrl no-lock.
     1781            ASSIGN
     1782               v-login = USERID("ub")
     1783               p-db-num = buf_sys-ctrl.db-num
     1784            .
     1785            FIND FIRST buf_user-login
     1786                 WHERE buf_user-login.db-num = p-db-num
     1787                   AND buf_user-login.user-login = v-login
     1788                 no-lock
     1789                 no-error
     1790                 .
     1791            IF AVAILABLE buf_user-login
     1792            THEN DO:
     1793               assign
     1794                  p-user-id = buf_user-login.user-id
     1795               .
     1796            END.
     1797      end.
     1798   end procedure.
     1799       run diasize_init in this-procedure .
     1800   MAIN-BLOCK:
     1801   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1802      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1803     run fill-temp-drt-prop in this-procedure .
     1804     RUN Myenable.
     1805     WAIT-FOR GO OF FRAME Dialog-Frame.
     1806   END.
     1807   RUN disable_UI.
     1808   PROCEDURE disable_UI :
     1809     HIDE FRAME Dialog-Frame.
     1810   END PROCEDURE.
     1811   PROCEDURE enable_UI :
     1812     DISPLAY rs-add f-upper-prop-code f-upper-prop-label f-prop-label f-prop-code
     1813             full-prop-name
     1814         WITH FRAME Dialog-Frame.
     1815     ENABLE B-exit b-quit rs-add B-Help f-prop-label f-prop-code BR-drt-prop
     1816            full-prop-name
     1817         WITH FRAME Dialog-Frame.
     1818     VIEW FRAME Dialog-Frame.
     1819     OPEN QUERY BR-drt-prop FOR EACH temp-drt-prop NO-LOCK BY temp-drt-prop.upper-prop-code BY temp-drt-prop.prop-code INDEXED-REPOSITION.
     1820   END PROCEDURE.
     1821   PROCEDURE fill-temp-drt-prop :
     1822   define variable v-path                    as character                no-undo .
     1823   DEFINE VARIABLE v-full-path               as character                no-undo .
     1824   DEFINE VARIABLE v-file-name               as character                no-undo .
     1825   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1826   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1827   DEFINE VARIABLE v-start                   AS LOGICAL no-UNDO.
     1828   DEFINE VARIABLE v-node-code AS integer NO-UNDO.
     1829   DEFINE BUFFER UPPER_drt-prop FOR temp-drt-prop.
     1830   run gbl/filename.p (
     1831                   input 'cmp/drt-prop.new'
     1832                 ,output v-full-path
     1833                 ,output v-path
     1834                 ,output v-file-name
     1835                 ,output v-file-name-no-ext
     1836                 ,output v-file-name-ext
     1837                 ) no-error .
     1838   if error-status:error then do:
     1839     run gbl/filename.p (
     1840                     input 'cmp/drt-prop.txt'
     1841                   ,output v-full-path
     1842                   ,output v-path
     1843                   ,output v-file-name
     1844                   ,output v-file-name-no-ext
     1845                   ,output v-file-name-ext
     1846                   ) no-error .
     1847     if error-status:error then do:
     1848       message
     1849       return-value
     1850       view-as alert-box ERROR.
     1851       return.
     1852     end.
     1853   end.
     1854   INPUT STREAM instream FROM value(v-full-path).
     1855   REPEAT:
     1856     CREATE temp-drt-prop.
     1857     IMPORT STREAM instream temp-drt-prop no-error.
     1858   END.
     1859   INPUT STREAM instream CLOSE.
     1860   FOR EACH temp-drt-prop NO-LOCK WHERE
     1861           temp-drt-prop.node-code = 0 :
     1862     DELETE temp-drt-prop.
     1863   END.
     1864   _temp-drt-prop:
     1865   FOR EACH temp-drt-prop:
     1866     FIND FIRST UPPER_drt-prop NO-LOCK WHERE
     1867               UPPER_drt-prop.upper-node-code = temp-drt-prop.upper-node-code
     1868           AND UPPER_drt-prop.node-code = temp-drt-prop.node-code
     1869           AND UPPER_drt-prop.templ-rl-root = temp-drt-prop.templ-rl-root.
     1870     v-start = yes.
     1871     DO WHILE v-start OR temp-drt-prop.upper-node-code <> 0:
     1872       v-start = NO.
     1873       IF AVAILABLE UPPER_drt-prop THEN DO:
     1874         ASSIGN
     1875         temp-drt-prop.full-prop-name = UPPER_drt-prop.prop-code +
     1876                                             chr(47) +
     1877                                         temp-drt-prop.full-prop-name.
     1878       END.
     1879       v-node-code = UPPER_drt-prop.upper-node-code.
     1880       FIND FIRST UPPER_drt-prop NO-LOCK WHERE
     1881                  UPPER_drt-prop.node-code = v-node-code
     1882               and UPPER_drt-prop.templ-rl-root = temp-drt-prop.templ-rl-root
     1883                  NO-ERROR.
     1884      IF NOT AVAILABLE UPPER_drt-prop THEN NEXT _temp-drt-prop.
     1885     END.
     1886   END.
     1887   FOR EACH temp-drt-prop NO-LOCK WHERE
     1888           temp-drt-prop.node-code = 0 :
     1889     DELETE temp-drt-prop.
     1890   END.
     1891   CREATE temp-drt-prop.
     1892   ASSIGN
     1893   temp-drt-prop.prop-code = '':U
     1894   temp-drt-prop.node-code = 0
     1895   temp-drt-prop.prop-label = '':U
     1896   temp-drt-prop.upper-prop-code = '':U
     1897   temp-drt-prop.upper-node-code = 0
     1898   temp-drt-prop.upper-prop-label = '':U
     1899   temp-drt-prop.templ-rl-root = 0
     1900   .
     1901   RELEASE temp-drt-prop.
     1902   END PROCEDURE.
     1903   PROCEDURE MyEnable :
     1904   ASSIGN
     1905   temp-drt-prop.upper-prop-code:RESIZABLE IN BROWSE br-drt-prop = YES
     1906   temp-drt-prop.upper-prop-label:RESIZABLE IN BROWSE br-drt-prop = YES
     1907   temp-drt-prop.prop-code:RESIZABLE IN BROWSE br-drt-prop = YES
     1908   temp-drt-prop.prop-label:RESIZABLE IN BROWSE br-drt-prop = YES
     1909   .
     1910   DISPLAY
     1911   f-upper-prop-code
     1912   f-upper-prop-label
     1913   f-prop-label
     1914   f-prop-code
     1915   rs-add
     1916   WITH FRAME Dialog-Frame.
     1917   ENABLE
     1918   rs-add
     1919   B-exit
     1920   b-quit
     1921   B-Help
     1922   f-upper-prop-code
     1923   f-upper-prop-label
     1924   f-prop-label
     1925   f-prop-code
     1926   br-drt-prop
     1927   WITH FRAME Dialog-Frame.
     1928   VIEW FRAME Dialog-Frame.
     1929   Open query br-drt-prop for each temp-drt-prop.
     1930   APPLY "ENTRY" to br-drt-prop.
     1931   APPLY "VALUE-CHANGED" to br-drt-prop.
     1932   END PROCEDURE.
     1933   PROCEDURE proc-save :
     1934   define variable v-node-code as integer no-undo .
     1935   define variable v-upper-node-code as integer no-undo .
     1936   DEFINE BUFFER buf_temp-drt-prop FOR temp-drt-prop.
     1937   ASSIGN
     1938   FRAME Dialog-Frame
     1939   f-prop-code
     1940   f-prop-label
     1941   f-upper-prop-code
     1942   f-upper-prop-label
     1943   .
     1944   IF rs-add = "add" THEN DO:
     1945     FIND FIRST buf_temp-drt-prop WHERE
     1946               buf_temp-drt-prop.prop-code = f-prop-code
     1947           AND buf_temp-drt-prop.upper-node-code = temp-drt-prop.node-code NO-ERROR.
     1948     IF AVAILABLE buf_temp-drt-prop THEN DO:
     1949       MESSAGE
     1950       "Уже есть такое свойство в такой секции"
     1951       VIEW-AS ALERT-BOX ERROR.
     1952       UNDO, RETURN ERROR.
     1953     END.
     1954   END.
     1955   IF rs-add = "add" THEN DO:
     1956     find last buf_temp-drt-prop where
     1957             buf_temp-drt-prop.templ-rl-root = 0 no-error .
     1958     v-node-code = (if available buf_temp-drt-prop
     1959                   then buf_temp-drt-prop.node-code + 1
     1960                   else 1).
     1961     v-upper-node-code = (if available temp-drt-prop
     1962                         then temp-drt-prop.node-code
     1963                         else 0).
     1964      CREATE buf_temp-drt-prop.
     1965      ASSIGN
     1966      buf_temp-drt-prop.prop-code = f-prop-code
     1967      buf_temp-drt-prop.node-code =  v-node-code
     1968      buf_temp-drt-prop.prop-label = f-prop-label
     1969      buf_temp-drt-prop.upper-prop-code = f-upper-prop-code
     1970      buf_temp-drt-prop.upper-prop-label = f-upper-prop-label
     1971      buf_temp-drt-prop.upper-node-code =  v-upper-node-code
     1972      buf_temp-drt-prop.full-prop-name = temp-drt-prop.full-prop-name + f-prop-code + chr(47)
     1973      .
     1974   END.
     1975   else do:
     1976     assign
     1977     v-node-code = temp-drt-prop.node-code
     1978     v-upper-node-code = temp-drt-prop.upper-node-code
     1979     .
     1980   end.
     1981   ASSIGN
     1982   p-prop-code = f-prop-code
     1983   p-node-code = v-node-code
     1984   p-upper-node-code = v-upper-node-code
     1985   p-prop-label = f-prop-label
     1986   p-upper-prop-code = f-upper-prop-code
     1987   p-upper-prop-label = f-upper-prop-label
     1988   p-upper-full-prop-name = (if rs-add = "add"
     1989                             then buf_temp-drt-prop.full-prop-name
     1990                             else temp-drt-prop.full-prop-name)
     1991   .
     1992   if rs-add = "add" then do:
     1993     OUTPUT STREAM instream TO value("cmp/drt-prop.NEW").
     1994     FOR EACH buf_temp-drt-prop:
     1995       if buf_temp-drt-prop.node-code > 0 then
     1996       EXPORT STREAM instream buf_temp-drt-prop EXCEPT buf_temp-drt-prop.full-prop-name.
     1997     END.
     1998     OUTPUT stream instream CLOSE.
     1999   end.
     2000   END PROCEDURE.
