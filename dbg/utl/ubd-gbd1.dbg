     1371                   and buf_code-range.db-num = p-db-num
     1372                   and buf_code-range.stts = "f":U
     1373                 ) or
     1374                 ( buf_code-range.range-type = p-curr-type-cdrg
     1375                   and buf_code-range.db-num = p-db-num
     1376                   and buf_code-range.stts = "u":U
     1377                 )
     1378       on error undo, return error
     1379       :
