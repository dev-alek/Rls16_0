     1467         end.
     1468       end.
     1469     end.
     1470   end case.
     1471         end.
     1472         when 'scgb':U
     1473         or when 'sclc':U
     1474         then do:
     1475           case p-action :
     1476             when "get-m-code":U then do:
     1477               assign
     1478                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1479               .
     1480             end.
     1481             when "f-u":U then do:
     1482               assign
     1483                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1484               .
     1485               run mark-all-used-as-free in this-procedure (
     1486                                          input  p-db-num
     1487                                         ,input  p-curr-type-cdrg
     1488                                         ,output str-u-f
     1489                                         ,output str-u-f-rng
     1490                                       ).
     1491             end.
     1492           end case.
     1493           view frame get-max-code-inf.
     1494           assign
     1495             rec-cnt = 0
     1496           .
     1497           display
     1498             rec-cnt
     1499             with frame get-max-code-inf
     1500           .
     1501           for each buf_units no-lock
     1502               where lookup('вес':U, buf_units.type) > 0
     1503           on error undo, return error
     1504           :
     1505             for each buf_goods no-lock
     1506               where buf_goods.unit-base = buf_units.unit-name
     1507             on error undo, return error
     1508             :
     1509               assign
     1510                 rec-cnt = rec-cnt + 1
     1511               .
     1512               if ( rec-cnt modulo 10 ) = 0 then do:
     1513                 display
     1514                   rec-cnt
     1515                   with frame get-max-code-inf
     1516                 .
     1517               end.
     1518               run mc_gdsbcode in this-procedure (
     1519                                input  buf_goods.gds-code
     1520                               ,input  ?
     1521                               ,output v-main-bcode
     1522                             ) no-error .
     1523               if error-status :error then do:
     1524                 message
     1525                   vss-workfile vss-revision vss-description skip
     1526                   "Ошибка при поиске корневого бар-кода" skip
     1527                   "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     1528                   error-status :get-message(1) skip
     1529                   return-value skip
     1530                   view-as alert-box error .
     1531                 undo, return error .
     1532               end.
     1533               for each buf_prod-bc no-lock
     1534                   where buf_prod-bc.b-code = v-main-bcode
     1535               on error undo, return error
     1536               :
     1537                 if p-curr-type-cdrg = 'sclc':U
     1538                   and buf_prod-bc.bc-on = FALSE
     1539                 then do:
     1540                   next.
     1541                 end.
     1542                 run mc_prodbcat in this-procedure (
     1543                                  buffer buf_prod-bc
     1544                                 ,input  'global=request':u
     1545                                 ,output l-prod-bc-global
     1546                               ) no-error .
     1547                 if error-status :error then do:
     1548                   message
     1549                     vss-workfile vss-revision vss-description skip
     1550                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1551                     "Основной бар-код" buf_prod-bc.b-code skip
     1552                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1553                     "Действие global=request" skip
     1554                     error-status :get-message(1) skip
     1555                     return-value skip
     1556                     view-as alert-box error .
     1557                   undo, return error .
     1558                 end.
     1559                 run mc_prodbcat in this-procedure (
     1560                                  buffer buf_prod-bc
     1561                                 ,input  'weight=request':u
     1562                                 ,output l-prod-bc-weight
     1563                               ) no-error .
     1564                 if error-status :error then do:
     1565                   message
     1566                     vss-workfile vss-revision vss-description skip
     1567                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1568                     "Основной бар-код" buf_prod-bc.b-code skip
     1569                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1570                     "Действие weight=request" skip
     1571                     error-status :get-message(1) skip
     1572                     return-value skip
     1573                     view-as alert-box error .
     1574                   undo, return error .
     1575                 end.
     1576                 if l-prod-bc-weight
     1577                   and ( ( l-prod-bc-global
     1578                           and p-curr-type-cdrg = 'scgb':U
     1579                         )
     1580                         or
     1581                         ( not l-prod-bc-global
     1582                           and p-curr-type-cdrg = 'sclc':U
     1583                         )
     1584                       )
     1585                 then do:
     1586                   case p-action :
     1587                     when "get-m-code":U then do:
     1588                       if integer( buf_prod-bc.b-str ) >= p-first-code
     1589                         and integer( buf_prod-bc.b-str ) <= p-last-code
     1590                         and integer( buf_prod-bc.b-str ) > v-b-code
     1591                       then do:
     1592                         assign
     1593                           v-b-code = integer( buf_prod-bc.b-str )
     1594                         .
     1595                       end.
     1596                     end.
     1597                     when "f-u":U then do:
     1598                       for each buf_code-range
     1599                         where buf_code-range.db-num     = p-db-num
     1600                           and buf_code-range.range-type = p-curr-type-cdrg
     1601                           and buf_code-range.stts       = "f":U
     1602                           and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1603                           and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1604                       on error undo, return error
     1605                       :
     1606                         assign
     1607                           buf_code-range.stts = "u":U
     1608                         .
     1609                         if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1610                           assign
     1611                             str-u-f-rng = diff-list( str-u-f-rng
     1612                                                     ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1613                                                     ,",":U
     1614                                                     )
     1615                           .
     1616                         end.
     1617                         if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1618                           assign
     1619                             v-b-code = v-b-code + 1
     1620                             v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1621                                                     + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1622                                                     , chr(10)
     1623                                                     , buf_code-range.first-code
     1624                                                     , buf_code-range.last-code
     1625                                                     , buf_prod-bc.b-str
     1626                                                   )
     1627                             v-ret-msg = v-ret-msg + v-msg
     1628                           .
     1629                           if p-view-mess = true then do:
     1630                             message
     1631                               v-msg
     1632                               view-as alert-box information.
     1633                           end.
     1634                         end.
     1635                       end.
     1636                     end.
     1637                   end case.
     1638                 end.
     1639               end.
     1640             end.
     1641           end.
     1642           if p-action = "f-u":U then do:
     1643             do ind = 1 to num-entries( str-u-f-rng ):
     1644               assign
     1645                 v-b-code  = v-b-code + 1
     1646                 v-msg     = substitute( "Диапазон кодов &2&1"
     1647                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1648                                         , chr(10)
     1649                                         , entry( ind, str-u-f-rng )
     1650                                       )
     1651                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1652               .
     1653               if p-view-mess = true then do:
     1654                 message
     1655                   v-msg
     1656                   view-as alert-box information.
     1657               end.
     1658             end.
     1659           end.
     1660           hide frame get-max-code-inf no-pause .
     1661         end.
     1662         when 'pglc':U
     1663         then do:
     1664           case p-action :
     1665             when "get-m-code":U then do:
     1666               assign
     1667                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1668               .
     1669             end.
     1670             when "f-u":U then do:
     1671               assign
     1672                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1673               .
     1674               run mark-all-used-as-free in this-procedure (
     1675                                          input  p-db-num
     1676                                         ,input  p-curr-type-cdrg
     1677                                         ,output str-u-f
     1678                                         ,output str-u-f-rng
     1679                                       ).
     1680             end.
     1681           end case.
     1682           view frame get-max-code-inf.
     1683           assign
     1684             rec-cnt = 0
     1685           .
     1686           display
     1687             rec-cnt
     1688             with frame get-max-code-inf
     1689           .
     1690           for each buf_prod-bc no-lock where
     1691                   buf_prod-bc.b-str >= "00100"
     1692               and buf_prod-bc.b-str <= "99999"
     1693               and buf_prod-bc.bc-on-type = 'pglc':U
     1694               and length(buf_prod-bc.b-str) = 5
     1695           on error undo, return error
     1696           :
     1697               assign
     1698                 rec-cnt = rec-cnt + 1
     1699               .
     1700               if ( rec-cnt modulo 10 ) = 0 then do:
     1701                 display
     1702                   rec-cnt
     1703                   with frame get-max-code-inf
     1704                 .
     1705               end.
     1706               if p-curr-type-cdrg = 'pglc':U
     1707                 and buf_prod-bc.bc-on = FALSE
     1708               then do:
     1709                 next.
     1710               end.
     1711               run mc_prodbcat in this-procedure (
     1712                                 buffer buf_prod-bc
     1713                               ,input  'pgweight=request':u
     1714                               ,output l-prod-bc-pgweight
     1715                             ) no-error .
     1716               if error-status :error then do:
     1717                 message
     1718                   vss-workfile vss-revision vss-description skip
     1719                   "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1720                   "Основной бар-код" buf_prod-bc.b-code skip
     1721                   "Дополнительный бар-код" buf_prod-bc.b-str skip
     1722                   "Действие weight=request" skip
     1723                   error-status :get-message(1) skip
     1724                   return-value skip
     1725                   view-as alert-box error .
     1726                 undo, return error .
     1727               end.
     1728               if l-prod-bc-pgweight
     1729               and p-curr-type-cdrg = 'pglc':U
     1730               then do:
     1731                 case p-action :
     1732                   when "get-m-code":U then do:
     1733                     if integer( buf_prod-bc.b-str ) >= p-first-code
     1734                       and integer( buf_prod-bc.b-str ) <= p-last-code
     1735                       and integer( buf_prod-bc.b-str ) > v-b-code
     1736                     then do:
     1737                       assign
     1738                         v-b-code = integer( buf_prod-bc.b-str )
     1739                       .
     1740                     end.
     1741                   end.
     1742                   when "f-u":U then do:
     1743                     for each buf_code-range
     1744                       where buf_code-range.db-num     = p-db-num
     1745                         and buf_code-range.range-type = p-curr-type-cdrg
     1746                         and buf_code-range.stts       = "f":U
     1747                         and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1748                         and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1749                     on error undo, return error
     1750                     :
     1751                     assign
     1752                     buf_code-range.stts = "u":U
     1753                       .
     1754                     if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1755                         assign
     1756                           str-u-f-rng = diff-list( str-u-f-rng
     1757                                                   ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1758                                                   ,",":U
     1759                                                   )
     1760                         .
     1761                     end.
     1762                     if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1763                         assign
     1764                           v-b-code = v-b-code + 1
     1765                           v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1766                                                   + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1767                                                   , chr(10)
     1768                                                   , buf_code-range.first-code
     1769                                                   , buf_code-range.last-code
     1770                                                   , buf_prod-bc.b-str
     1771                                                 )
     1772                           v-ret-msg = v-ret-msg + v-msg
     1773                         .
     1774                       if p-view-mess = true then do:
     1775                         message
     1776                           v-msg
     1777                           view-as alert-box information.
     1778                       end.
     1779                     end.
     1780                   end.
     1781                 end.
     1782               end case.
     1783             end.
     1784           end.
     1785           if p-action = "f-u":U then do:
     1786             do ind = 1 to num-entries( str-u-f-rng ):
     1787               assign
     1788                 v-b-code = v-b-code + 1
     1789                 v-msg     = substitute( "Диапазон кодов &2&1"
     1790                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1791                                         , chr(10)
     1792                                         , entry( ind, str-u-f-rng )
     1793                                       )
     1794                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1795               .
     1796               if p-view-mess = true then do:
     1797                 message
     1798                   v-msg
     1799                   view-as alert-box information.
     1800               end.
     1801             end.
     1802           end.
     1803           hide frame get-max-code-inf no-pause .
     1804         end.
     1805         otherwise do:
     1806           message
     1807             vss-workfile vss-revision vss-description skip
     1808             "get-max-code" skip
     1809             "Непредусмотрена обработка диапазона кодов " p-curr-type-cdrg
     1810             view-as alert-box error.
     1811           return error.
     1812         end.
     1813       end case.
     1814     end.
     1815     return v-ret-msg.
     1816   end procedure.
     1817   procedure mark-all-used-as-free :
     1818     define input  parameter p-db-num         like ub.db.db-num             no-undo .
     1819     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
     1820     define output parameter p-str-u-f        as   character                 no-undo .
     1821     define output parameter p-str-u-f-rng    as   character                 no-undo .
     1822     do
     1823     on error undo, return error
     1824     :
     1825       define buffer buf_code-range   for ub.code-range.
     1826       define buffer buf-c_code-range for ub.code-range .
     1827       assign
     1828         p-str-u-f     = "":U
     1829         p-str-u-f-rng = "":U
     1830       .
     1831       for each buf_code-range share-lock
     1832           where buf_code-range.db-num     = p-db-num
     1833             and buf_code-range.range-type = p-curr-type-cdrg
     1834             and buf_code-range.stts       = "u":U
     1835       on error undo, return error
     1836       :
     1837         find first buf-c_code-range exclusive-lock
     1838           where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1839         .
     1840         assign
     1841           buf-c_code-range.stts = "c":U
     1842         .
     1843         release buf-c_code-range .
     1844         assign
     1845           buf_code-range.stts = "f":U
     1846           p-str-u-f     = p-str-u-f + ",":U + buf_code-range.range-type + chr(3) + string( buf_code-range.first-code )
     1847           p-str-u-f-rng = p-str-u-f-rng + ",":U + string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1848         .
     1849       end.
     1850       assign
     1851         p-str-u-f     = substring( p-str-u-f, 2, length( p-str-u-f ) - 1 )
     1852         p-str-u-f-rng = substring( p-str-u-f-rng, 2, length( p-str-u-f-rng ) - 1 )
     1853       .
     1854     end.
     1855   end procedure.
     1856   procedure mc_prodbcat :
     1857     do
     1858     on error undo, return error
     1859     :
     1860       define parameter buffer buf_prod-bc  for ub.prod-bc .
     1861       define input  parameter p-action           as character no-undo .
     1862       define output parameter p-return-attribute as logical no-undo .
     1863       def var vss-description as character no-undo init "prodbcat-01: определение параметров дополнительного бар-кода".
     1864       define buffer buf_bar-code   for ub.bar-code   .
     1865       define buffer buf_units      for ub.units      .
     1866       define buffer buf_code-range for ub.code-range .
     1867       define variable p-code-int as integer no-undo .
     1868       define variable v-cdrg-type as character no-undo .
     1869       if not available buf_prod-bc then do:
     1870         message
     1871           vss-workfile vss-revision vss-description skip
     1872           "Ошибка задания входных параметров" skip
     1873           "Не задан дополнительный бар-код" skip
     1874           view-as alert-box error .
     1875         undo, return error .
     1876       end.
     1877       find first buf_bar-code no-lock
     1878         where buf_bar-code.b-code = buf_prod-bc.b-code
     1879         no-error .
     1880       if not available buf_bar-code then do:
     1881         message
     1882           vss-workfile vss-revision vss-description skip
     1883           "Неправильная ссылка на основной бар-код" skip
     1884           "Основной бар-код" buf_prod-bc.b-code skip
     1885           "Дополнительный бар-код" buf_prod-bc.b-str skip
     1886           view-as alert-box error .
     1887         undo, return error .
     1888       end.
     1889       find first buf_units no-lock
     1890         where buf_units.unit-name = buf_bar-code.unit-cli
     1891         no-error .
     1892       if not available buf_units then do:
     1893         message
     1894           vss-workfile vss-revision vss-description skip
     1895           "Не найдена единица измерения основного бар-кода" skip
     1896           "Основной бар-код" buf_bar-code.b-code skip
     1897           "Единица измерения" buf_bar-code.unit-cli skip
     1898           view-as alert-box error .
     1899         undo, return error .
     1900       end.
     1901       def var ind                    as integer   no-undo .
     1902       def var v-num-entries-p-action as integer   no-undo .
     1903       def var v-action               as character no-undo .
     1904       assign
     1905         v-num-entries-p-action = num-entries(p-action)
     1906       .
     1907       assign
     1908         p-return-attribute = true
     1909       .
     1910       _ind:
     1911       do ind = 1 to v-num-entries-p-action
     1912       :
     1913        if ind > 1 and p-return-attribute = false then return.
     1914         assign
     1915           v-action = entry(ind, p-action)
     1916         .
     1917         case v-action :
     1918           when "global=request":u
     1919           then do:
     1920             if not (buf_prod-bc.bc-on-type = ''
     1921             or buf_prod-bc.bc-on-type = 'scgb':U
     1922             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     1923               assign
     1924                 p-return-attribute = false
     1925               .
     1926             end.
     1927           end.
     1928           when "weight=request":u
     1929           then do:
     1930             if not (buf_prod-bc.bc-on-type = 'sclc':U
     1931             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     1932               assign
     1933                 p-return-attribute = false.
     1934             end.
     1935           end.
     1936           when "pgweight=request":u
     1937           then do:
     1938             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     1939               assign
     1940                 p-return-attribute = false.
     1941             end.
     1942           end.
     1943           when "petrolium=request":u
     1944           then do:
     1945             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     1946               assign
     1947                 p-return-attribute = false.
     1948             end.
     1949           end.
     1950           when "scaleable=request":u
     1951           then do:
     1952             if not (buf_prod-bc.bc-on-type = 'sslc':U
     1953             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     1954               assign
     1955                 p-return-attribute = false.
     1956             end.
     1957           end.
     1958           otherwise do:
     1959             message
     1960               vss-workfile vss-revision vss-description skip
     1961               "Неизвестное значение параметра v-action " skip
     1962               "v-action" v-action skip
     1963               "p-action" p-action skip
     1964               view-as alert-box error .
     1965             undo, return error .
     1966           end.
     1967         end case.
     1968       end.
     1969     end.
     1970   end procedure.
     1971   procedure mc_gdsbcode :
     1972     define input  parameter p-gds-code  like ub.bar-code.gds-code  no-undo .
     1973     define input  parameter p-node-code like ub.bar-code.node-code no-undo .
     1974     define output parameter p-b-code    like ub.bar-code.b-code    no-undo .
     1975     def var vss-description as character no-undo init "gdsbcode-01: определение первичного бар-кода признака".
     1976     def var vss-proc-revision as character no-undo init "library.p gdsbcode-01" .
     1977     define buffer buf_bar-code for ub.bar-code .
     1978     def var v-unit-base like ub.goods.unit-base no-undo .
     1979     do
     1980     on error undo, return error
     1981     :
     1982       if p-node-code = ? then do:
     1983         run mc_gdsrootnode in this-procedure (
     1984            input  p-gds-code
     1985           ,output p-node-code
     1986           ) no-error .
     1987         if error-status :error then do:
     1988           message
     1989             vss-workfile vss-revision vss-description skip
     1990             "Ошибка при определении корневого признака товара" skip
     1991             "Код товара" p-gds-code skip
     1992             error-status :get-message(1) skip
     1993             return-value skip
     1994             view-as alert-box error .
     1995           undo, return error .
     1996         end.
     1997       end.
     1998       run mc_unitbase in this-procedure (
     1999          input  p-gds-code
     2000         ,output v-unit-base
     2001         ) no-error .
     2002       if error-status :error then do:
     2003         message
     2004           vss-workfile vss-revision vss-description skip
     2005           "Ошибка определения базовой единицы измерения товара" skip
     2006           "Код товара" p-gds-code skip
     2007           view-as alert-box error .
     2008         undo, return error .
     2009       end.
     2010       find first buf_bar-code no-lock
     2011         where buf_bar-code.gds-code  = p-gds-code
     2012           and buf_bar-code.node-code = p-node-code
     2013           and buf_bar-code.part-code = ""
     2014           and buf_bar-code.in-code   = ""
     2015           and buf_bar-code.unit-cli  = v-unit-base
     2016         no-error .
     2017       if not available buf_bar-code then do:
     2018         undo, return error vss-proc-revision + ":" + chr(10)
     2019           + "Не найден первичный бар-кода признака " + chr(10)
     2020           + "Код товара " + string(p-gds-code) + chr(10)
     2021           + "Код признака " + string(p-node-code) + chr(10)
     2022           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     2023           .
     2024       end.
     2025       assign
     2026         p-b-code = buf_bar-code.b-code
     2027       .
     2028     end.
     2029   end procedure.
     2030   procedure mc_gdsrootnode :
     2031     define input  parameter p-gds-code  like ub.goods.gds-code no-undo .
     2032     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2033     def var vss-description as character no-undo init "gdsrootnode-01: определение корневого признака товара по коду товара".
     2034     define buffer buf_goods   for ub.goods .
     2035     do
     2036     on error undo, return error
     2037     :
     2038       find first buf_goods no-lock
     2039         where buf_goods.gds-code  = p-gds-code
     2040         no-error .
     2041       if not available buf_goods then do:
     2042         message
     2043           vss-workfile vss-revision vss-description skip
     2044           "Не найден товар" skip
     2045           "Код товара" p-gds-code skip
     2046           view-as alert-box error .
     2047         undo, return error .
     2048       end.
     2049       run mc_prt-root-to-node-code in this-procedure (
     2050          input  buf_goods.prt-root
     2051         ,output p-root-node
     2052         ) no-error .
     2053       if error-status :error then do:
     2054         message
     2055           vss-workfile vss-revision vss-description skip
     2056           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     2057           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2058           "Указатель на корень шкалы" buf_goods.prt-root skip
     2059           error-status :get-message(1) skip
     2060           return-value skip
     2061           view-as alert-box error .
     2062         undo, return error .
     2063       end.
     2064     end.
     2065   end procedure.
     2066   procedure mc_prt-root-to-node-code :
     2067     define input  parameter p-prt-root  like ub.goods.prt-root no-undo .
     2068     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2069     def var vss-description as character no-undo init "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     2070     define buffer buf_gds-prt for ub.gds-prt .
     2071     do
     2072     on error undo, return error
     2073     :
     2074       find buf_gds-prt no-lock
     2075         where buf_gds-prt.upper-code = p-prt-root
     2076         no-error .
     2077       if not available buf_gds-prt then do:
     2078         message
     2079           vss-workfile vss-revision vss-description skip
     2080           "Не найден корень шкалы" skip
     2081           "Указатель на корень шкалы" p-prt-root skip
     2082           view-as alert-box error .
     2083         undo, return error .
     2084       end.
     2085       assign
     2086         p-root-node = buf_gds-prt.node-code
     2087       .
     2088     end.
     2089   end procedure.
     2090   procedure mc_unitbase :
     2091     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
     2092     define output parameter p-unit-base like ub.goods.unit-base no-undo .
     2093     def var vss-description as character no-undo init "unitbase-01: определение базовой единицы измерения товара".
     2094     define buffer buf_goods for ub.goods .
     2095     do
     2096     on error undo, return error
     2097     :
     2098       find first buf_goods no-lock
     2099         where buf_goods.gds-code = p-gds-code
     2100         no-error .
     2101       if not available buf_goods then do:
     2102         message
     2103           vss-workfile vss-revision vss-description skip
     2104           "Не найден товар" skip
     2105           "Код товара" p-gds-code skip
     2106           view-as alert-box error .
     2107         undo, return error .
     2108       end.
     2109       assign
     2110         p-unit-base = buf_goods.unit-base
     2111       .
     2112     end.
     2113   end procedure.
     2114   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2115   procedure cur-time :
     2116      define output parameter p-today as date      no-undo .
     2117      define output parameter p-time  as integer   no-undo .
     2118     do
     2119     on error undo, return error
     2120     :
     2121       define variable v-date1 as date      no-undo .
     2122       define variable v-date2 as date      no-undo .
     2123       define variable v-time  as integer   no-undo .
     2124       assign
     2125         v-date1 = today
     2126         v-time  = time
     2127         v-date2 = today
     2128       .
     2129       if v-date1 <> v-date2
     2130       then do:
     2131         assign
     2132           v-date1 = today
     2133           v-time  = v-time
     2134         .
     2135       end.
     2136       assign
     2137         p-today = v-date1
     2138         p-time  = v-time
     2139       .
     2140     end.
     2141   end.
     2142   function cur-time-date returns character
     2143   :
     2144     return string(today, '99/99/9999':U) .
     2145   end.
     2146   function cur-time-mjd returns decimal
     2147   :
     2148     define variable v-date as date      no-undo .
     2149     define variable v-time as integer   no-undo .
     2150     run cur-time in this-procedure
     2151       (output v-date
     2152       ,output v-time
     2153       ) .
     2154     return integer(v-date) - 2400002 + (v-time / 86400) .
     2155   end.
     2156   function cur-time-get-ending-index returns integer
     2157   (input p-number as integer
     2158   )
     2159   :
     2160     if p-number < 0
     2161     or p-number = ?
     2162     then do:
     2163       return 1 .
     2164     end.
     2165     define variable v-rest as integer   no-undo .
     2166     assign
     2167       p-number = p-number modulo 100
     2168     .
     2169     if p-number < 20
     2170     then do:
     2171       assign
     2172         v-rest = p-number
     2173       .
     2174     end.
     2175     else do:
     2176       assign
     2177         v-rest = p-number modulo 10
     2178       .
     2179     end.
     2180     case v-rest :
     2181       when 1
     2182       then do:
     2183         return 2 .
     2184       end.
     2185       when 2 or
     2186       when 3 or
     2187       when 4
     2188       then do:
     2189         return 3 .
     2190       end.
     2191       otherwise do:
     2192         return 1 .
     2193       end.
     2194     end case .
     2195   end.
     2196   procedure cur-time-mjd-to-date :
     2197      define input  parameter i-mjd-diff as decimal no-undo.
     2198      define output parameter o-Date     as date    no-undo.
     2199      define output parameter o-Time     as integer no-undo.
     2200      define variable v-day-number as integer   no-undo .
     2201      if    i-mjd-diff < 0
     2202         or i-mjd-diff = ?
     2203      then do:
     2204         return "?" .
     2205      end.
     2206      assign
     2207         v-day-number = truncate(i-mjd-diff,0).
     2208         o-Date = date(v-day-number + 2400002).
     2209         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2210     .
     2211   end.
     2212   function cur-time-mjd-to-string returns character
     2213   (input p-mjd-diff as decimal
     2214   )
     2215   :
     2216     define variable v-day-number as integer   no-undo .
     2217     define variable v-seconds    as integer   no-undo .
     2218     define variable v-hour       as integer   no-undo .
     2219     define variable v-min        as integer   no-undo .
     2220     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2221     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2222     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2223     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2224     if p-mjd-diff < 0
     2225     or p-mjd-diff = ?
     2226     then do:
     2227       return "?" .
     2228     end.
     2229     assign
     2230       v-day-number = integer(truncate(p-mjd-diff,0))
     2231       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2232     .
     2233     if v-seconds > 86400
     2234     then do:
     2235       assign
     2236         v-seconds = 86400 - 1
     2237       .
     2238     end.
     2239     if v-seconds < 0
     2240     then do:
     2241       assign
     2242         v-seconds = 0
     2243       .
     2244     end.
     2245     assign
     2246       v-hour = truncate(v-seconds / 3600, 0)
     2247     .
     2248     assign
     2249       v-seconds = v-seconds modulo 3600
     2250     .
     2251     assign
     2252       v-min = truncate(v-seconds / 60, 0)
     2253     .
     2254     assign
     2255       v-seconds = v-seconds modulo 60
     2256     .
     2257     return
     2258         (if v-day-number <> 0
     2259           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2260           else ""
     2261         )
     2262       + (if v-day-number <> 0 or v-hour <> 0
     2263           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2264           else ""
     2265         )
     2266       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2267           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2268           else ""
     2269         )
     2270       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2271       .
     2272   end.
     2273   function cur-time-string returns character
     2274   :
     2275     define variable v-date as date      no-undo .
     2276     define variable v-time as integer   no-undo .
     2277     run cur-time in this-procedure
     2278       (output v-date
     2279       ,output v-time
     2280       ) .
     2281     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2282   end.
     2283   function cur-time-string-sec returns character
     2284   :
     2285     define variable v-date as date      no-undo .
     2286     define variable v-time as integer   no-undo .
     2287     run cur-time in this-procedure
     2288       (output v-date
     2289       ,output v-time
     2290       ) .
     2291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2292   end.
     2293   function cur-time-custom  returns character
     2294   (input p-prefix as character
     2295   ,input p-date-format as character
     2296   ,input p-delimiter as character
     2297   ,input p-time-format as character
     2298   ,input p-suffix as character
     2299   )
     2300   :
     2301     define variable v-date as date      no-undo .
     2302     define variable v-time as integer   no-undo .
     2303     run cur-time in this-procedure
     2304       (output v-date
     2305       ,output v-time
     2306       ) .
     2307     return
     2308       p-prefix
     2309       + string(v-date, p-date-format)
     2310       + p-delimiter
     2311       + string(v-time, p-time-format)
     2312       + p-suffix
     2313       .
     2314   end.
     2315   function cur-time-print  returns character
     2316   :
     2317     define variable v-date as date      no-undo .
     2318     define variable v-time as integer   no-undo .
     2319     run cur-time in this-procedure
     2320       (output v-date
     2321       ,output v-time
     2322       ) .
     2323     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2324   end.
     2325   function cur-time-datetime returns datetime
     2326   :
     2327     define variable v-char as character no-undo .
     2328     define variable v-datetime as datetime no-undo .
     2329     v-char = cur-time-string().
     2330     v-datetime = datetime(v-char).
     2331     return  v-datetime.
     2332   end.
     2333   function cur-time-string-msec returns character
     2334   :
     2335     define variable v-date as datetime  no-undo .
     2336     v-date = now.
     2337     return string(v-date) .
     2338   end.
     2339   define new global shared variable g#library  as handle no-undo .
     2340   define new global shared variable g#library2 as handle no-undo .
     2341   define variable vss-include-info9 as character format "X(65)" no-undo
     2342   initial "@(#)$Workfile$ $Revision$".
     2343   define variable v-filelist-total-file-num           as integer      no-undo .
     2344   define variable v-filelist-total-dir-num            as integer      no-undo .
     2345   define variable v-filelist-main-procedure-handle    as handle       no-undo .
     2346   define variable v-filelist-main-procedure-name      as character    no-undo .
     2347   define temp-table temp-dirlist no-undo
     2348       field dir-full-name     as character
     2349       field dir-short-name    as character
     2350       field need-process      as logical
     2351       index xpk is primary unique dir-full-name
     2352   .
     2353   define temp-table temp-filelist no-undo
     2354     field file-name        as character
     2355     field file-name-no-ext as character
     2356     field file-extension   as character
     2357     field directory-name   as character
     2358     field full-name        as character
     2359     field dir-short-name   as character
     2360     field need-process     as logical
     2361     index xpk is unique primary full-name
     2362     index xie1 directory-name file-name
     2363     index xie2 directory-name file-name-no-ext
     2364     index xie3 file-name
     2365     index xie4 file-name-no-ext
     2366     index xie5 need-process file-name
     2367     .
     2368   define stream dir-list .
     2369   procedure filelist-get-file-num :
     2370     define output parameter p-file-num as integer   no-undo .
     2371     do
     2372     on error undo, return error return-value
     2373     :
     2374       assign
     2375         p-file-num = v-filelist-total-file-num
     2376       .
     2377     end.
     2378   end procedure.
     2379   procedure filelist-clear :
     2380     do
     2381     on error undo, return error return-value
     2382     :
     2383       define buffer buf_filelist for temp-filelist .
     2384       assign
     2385         v-filelist-total-file-num = 0
     2386       .
     2387       for each buf_filelist
     2388       on error undo, return error
     2389       :
     2390         delete buf_filelist .
     2391       end.
     2392     end.
     2393   end procedure.
     2394   procedure filelist-init :
     2395     do
     2396     on error undo, return error
     2397     :
     2398       define input parameter p-dir-name       as character no-undo .
     2399       define input parameter p-filter-ext     as logical   no-undo .
     2400       define input parameter p-ext-list       as character no-undo .
     2401       define input parameter p-dir-short-name as character no-undo .
     2402       define buffer buf_temp-filelist for temp-filelist .
     2403       if p-filter-ext = true
     2404          and p-ext-list = ?
     2405       or (p-filter-ext = false
     2406          and p-ext-list <> ?
     2407          and p-ext-list <> "":U
     2408          )
     2409       then do:
     2410         message
     2411           vss-workfile vss-revision vss-description skip
     2412           "Ошибка задания входных параметров" skip
     2413           "p-filter-ext" p-filter-ext skip
     2414           "p-ext-list"   p-ext-list   skip
     2415           view-as alert-box error .
     2416         undo, return error .
     2417       end.
     2418       for each buf_temp-filelist
     2419         where buf_temp-filelist.directory-name = p-dir-name
     2420       on error undo, return error return-value
     2421       :
     2422         delete buf_temp-filelist .
     2423       end.
     2424       input stream dir-list from os-dir( p-dir-name ).
     2425       define variable v-file                  as character no-undo .
     2426       define variable v-path                  as character no-undo .
     2427       define variable v-mask                  as character no-undo .
     2428       define variable v-extension             as character no-undo .
     2429       define variable v-file-name-without-ext as character no-undo .
     2430       repeat
     2431       on error undo, return error
     2432       :
     2433         import stream dir-list v-file v-path v-mask .
     2434         if  v-mask <> ?
     2435         and v-mask begins 'F':u
     2436         then do:
     2437         end.
     2438         else do:
     2439           next .
     2440         end.
     2441         if num-entries(v-file, '.':u) > 1
     2442         then do:
     2443           assign
     2444             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
     2445             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
     2446           .
     2447         end.
     2448         else do:
     2449           assign
     2450             v-extension = ''
     2451             v-file-name-without-ext = v-file
     2452           .
     2453         end.
     2454         if p-filter-ext = true
     2455         then do:
     2456           if lookup(v-extension, p-ext-list) = 0
     2457           then do:
     2458             next .
     2459           end.
     2460         end.
     2461         create buf_temp-filelist .
     2462         assign
     2463           buf_temp-filelist.file-name        = v-file
     2464           buf_temp-filelist.directory-name   = p-dir-name
     2465           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
     2466           buf_temp-filelist.file-extension   = v-extension
     2467           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
     2468           buf_temp-filelist.dir-short-name   = p-dir-short-name
     2469         .
     2470         assign
     2471           v-filelist-total-file-num = v-filelist-total-file-num + 1
     2472         .
     2473         if v-filelist-main-procedure-handle <> ?
     2474         then do:
     2475           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
     2476             (input "file":U
     2477             , input v-filelist-total-file-num
     2478             , input buf_temp-filelist.full-name
     2479             , input buf_temp-filelist.file-name
     2480             ) no-error.
     2481           if error-status :error
     2482           then do:
     2483             message
     2484               vss-workfile vss-revision vss-description skip
     2485               "filelist-dirlist-subdir-init" skip(1)
     2486               skip "Ошибка при вызове процедуры вывода"
     2487               skip "результатов сканирования каталогов."
     2488               skip return-value
     2489               skip trim(error-status :get-message(1))
     2490                       trim(error-status :get-message(2))
     2491                       trim(error-status :get-message(3))
     2492               view-as alert-box error.
     2493             undo, return error .
     2494           end.
     2495         end.
     2496       end.
     2497       input stream dir-list close .
     2498       return.
     2499     end.
     2500   end procedure.
     2501   procedure filelist-dirlist-init-by-list :
     2502     do
     2503     on error undo, return error
     2504     :
     2505       define input parameter p-root-dir   as character no-undo .
     2506       define input parameter p-dir-list   as character no-undo .
     2507       define input parameter p-filter-ext as logical   no-undo .
     2508       define input parameter p-ext-list   as character no-undo .
     2509       define variable v-num-appdir as integer   no-undo .
     2510       do v-num-appdir = 1 to num-entries(p-dir-list)
     2511       :
     2512         define variable v-curr-dir  as character no-undo .
     2513         assign
     2514           v-curr-dir = entry(v-num-appdir, p-dir-list)
     2515         .
     2516         run filelist-init in this-procedure
     2517           (input p-root-dir + '/':u + v-curr-dir
     2518           ,input p-filter-ext
     2519           ,input p-ext-list
     2520           ,input v-curr-dir
     2521           ) .
     2522       end.
     2523     end.
     2524   end procedure.
     2525   procedure filelist-dirlist-clear :
     2526     do
     2527     on error undo, return error
     2528     :
     2529       define buffer buf_temp-dirlist for temp-dirlist .
     2530       assign
     2531           v-filelist-total-dir-num = 0
     2532       .
     2533       for each buf_temp-dirlist
     2534       on error undo, return error
     2535       :
     2536         delete buf_temp-dirlist .
     2537       end.
     2538     end.
     2539   end procedure.
     2540   procedure filelist-dirlist-subdir-init :
     2541   define input parameter p-dir-name   as character no-undo .
     2542       define buffer buf_temp-dirlist for temp-dirlist .
     2543   do
     2544   for buf_temp-dirlist
     2545   on error undo, return error
     2546   :
     2547       assign
     2548           file-info :file-name = p-dir-name
     2549       .
     2550       if file-info :full-pathname = ?
     2551       or index( file-info :file-type, "D" ) = 0
     2552       then do:
     2553           message
     2554               vss-workfile vss-revision vss-description skip
     2555               "filelist-dirlist-init: Заданного каталога не существует."
     2556               skip (1)
     2557               skip "Задан каталог:"
     2558               skip substitute( "'&1'", p-dir-name )
     2559           view-as alert-box error .
     2560           undo, return error .
     2561       end.
     2562       input stream dir-list from os-dir( p-dir-name ).
     2563       define variable v-file                  as character no-undo .
     2564       define variable v-path                  as character no-undo .
     2565       define variable v-mask                  as character no-undo .
     2566       file-in-directory:
     2567       repeat
     2568       on error undo, return error
     2569       :
     2570           import stream dir-list
     2571               v-file
     2572               v-path
     2573               v-mask
     2574           .
     2575           if  v-mask = ?
     2576           or index( v-mask, 'D':u ) = 0
     2577           or v-file = ".":U
     2578           or v-file = "..":U
     2579           then do:
     2580               next file-in-directory.
     2581           end.
     2582           else do:
     2583               find first buf_temp-dirlist
     2584                    where buf_temp-dirlist.dir-full-name    = v-path
     2585               no-error.
     2586               if not available buf_temp-dirlist
     2587               then do:
     2588                   create buf_temp-dirlist .
     2589                   assign
     2590                       buf_temp-dirlist.dir-full-name    = v-path
     2591                       buf_temp-dirlist.dir-short-name   = v-file
     2592                       buf_temp-dirlist.need-process     = yes
     2593                   .
     2594               end.
     2595               assign
     2596                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
     2597               .
     2598               if v-filelist-main-procedure-handle <> ?
     2599               then do:
     2600                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
     2601                         input "dir":U
     2602                       , input v-filelist-total-dir-num
     2603                       , input buf_temp-dirlist.dir-full-name
     2604                       , input buf_temp-dirlist.dir-short-name
     2605                   ) no-error.
     2606                   if error-status :error
     2607                   then do:
     2608                       message
     2609                           vss-workfile vss-revision vss-description skip
     2610                           "filelist-dirlist-subdir-init"
     2611                           skip(1)
     2612                           skip "Ошибка при вызове процедуры вывода"
     2613                           skip "результатов сканирования каталогов."
     2614                           skip return-value
     2615                           skip trim(error-status :get-message(1))
     2616                                trim(error-status :get-message(2))
     2617                                trim(error-status :get-message(3))
     2618                       view-as alert-box error.
     2619                       undo, return error .
     2620                   end.
     2621               end.
     2622           end.
     2623       end.
     2624       input stream dir-list close .
     2625   end.
     2626   end procedure.
     2627   procedure filelist-dirlist-init :
     2628   define input parameter p-dir-name   as character no-undo .
     2629       define variable v-file  as character no-undo.
     2630       define variable v-path  as character no-undo.
     2631       define variable v-mask  as character no-undo.
     2632       define buffer buf_temp-dirlist for temp-dirlist .
     2633   do
     2634   for buf_temp-dirlist
     2635   on error undo, return error
     2636   :
     2637       assign
     2638           file-info :file-name = p-dir-name
     2639       .
     2640       if file-info :full-pathname = ?
     2641       or index( file-info :file-type, "D" ) = 0
     2642       then do:
     2643           message
     2644               vss-workfile vss-revision vss-description skip
     2645               "filelist-dirlist-init: Заданного каталога не существует."
     2646               skip (1)
     2647               skip "Задан каталог:"
     2648               skip substitute( "'&1'", p-dir-name )
     2649           view-as alert-box error .
     2650           undo, return error .
     2651       end.
     2652       for each buf_temp-dirlist
     2653          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
     2654       on error undo, return error return-value
     2655       :
     2656           delete buf_temp-dirlist .
     2657       end.
     2658       create buf_temp-dirlist .
     2659       assign
     2660           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
     2661           buf_temp-dirlist.dir-short-name   = file-info :file-name
     2662           buf_temp-dirlist.need-process     = yes
     2663       .
     2664       do
     2665       while available buf_temp-dirlist
     2666       on error undo, return error
     2667       :
     2668           run filelist-dirlist-subdir-init in this-procedure (
     2669               input buf_temp-dirlist.dir-full-name
     2670           ).
     2671           assign
     2672               buf_temp-dirlist.need-process = no
     2673           .
     2674           find first buf_temp-dirlist
     2675                where buf_temp-dirlist.need-process = yes
     2676           no-error.
     2677       end.
     2678   end.
     2679   end procedure.
     2680   procedure filelist-set-procedure-handle :
     2681   define input parameter p-proc-handle    as handle           no-undo.
     2682   define input parameter p-proc-name      as character        no-undo.
     2683       define variable v-signature    as character    no-undo.
     2684   do
     2685   on error undo, return error
     2686   :
     2687       if p-proc-handle = ?
     2688       or not valid-handle( p-proc-handle )
     2689       or p-proc-handle :get-signature( p-proc-name ) = ""
     2690       then do:
     2691           assign
     2692               v-filelist-main-procedure-handle = ?
     2693               v-filelist-main-procedure-name   = ""
     2694           .
     2695           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
     2696       end.
     2697       else do:
     2698           assign
     2699               v-signature = p-proc-handle :get-signature( p-proc-name )
     2700           .
     2701           if entry(   1, v-signature )    = "PROCEDURE":U
     2702           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
     2703           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
     2704           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
     2705           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
     2706           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
     2707           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
     2708           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
     2709           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
     2710           then do:
     2711               assign
     2712                   v-filelist-main-procedure-handle = p-proc-handle
     2713                   v-filelist-main-procedure-name   = p-proc-name
     2714               .
     2715           end.
     2716           else do:
     2717               assign
     2718                   v-filelist-main-procedure-handle = ?
     2719                   v-filelist-main-procedure-name   = ""
     2720               .
     2721               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
     2722           end.
     2723       end.
     2724   end.
     2725   end procedure.
     2726   procedure filelist-clear-procedure-handle :
     2727   do
     2728   on error undo, return error
     2729   :
     2730       assign
     2731           v-filelist-main-procedure-handle = ?
     2732           v-filelist-main-procedure-name   = ?
     2733       .
     2734   end.
     2735   end procedure.
     2736   procedure filelist-build-by-dirlist :
     2737       define buffer buf_temp-dirlist      for temp-dirlist.
     2738   do
     2739   for buf_temp-dirlist
     2740   on error undo, return error
     2741   :
     2742       for each buf_temp-dirlist
     2743       on error undo, return error
     2744       :
     2745           run filelist-init in this-procedure (
     2746                 input buf_temp-dirlist.dir-full-name
     2747               , input no
     2748               , input "":U
     2749               , input buf_temp-dirlist.dir-short-name
     2750           ).
     2751       end.
     2752   end.
     2753   end procedure.
     2754   procedure filelist-check-dir-exists :
     2755   define input parameter p-dir-name   as character        no-undo.
     2756   define output parameter p-exists    as logical          no-undo.
     2757   do
     2758   on error undo, return error
     2759   :
     2760       assign
     2761           file-info :file-name = p-dir-name
     2762       .
     2763       if file-info :file-type <> ?
     2764       and substring( file-info :file-type, 1, 1 ) = "D":U
     2765       then do:
     2766           assign
     2767               p-exists = yes
     2768           .
     2769       end.
     2770       else do:
     2771           assign
     2772               p-exists = no
     2773           .
     2774       end.
     2775   end.
     2776   end procedure.
     2777   define new shared temp-table temp-clients no-undo like ub.clients
     2778   field base-code as integer
     2779   field new-issue-code as integer
     2780   field deleted-sysconf as logical
     2781   .
     2782   define new shared temp-table temp-sysconf no-undo like ub.sysconf.
     2783   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2784   define variable p-db-num        as integer   no-undo .
     2785   define variable p-cli-code      as integer   no-undo .
     2786   define variable log-file-name   as character  no-undo init "ubd-gbd.txt".
     2787   define variable trg-Name as character no-undo .
     2788   define variable str as character no-undo .
     2789   define variable v-path-ver as character no-undo .
     2790   file-info:file-name = "utl/mig_0001.p":U .
     2791   v-path-ver = trim (file-info:FULL-PATHNAME, "mig_0001.p" ).
     2792   define variable v-dir-name as character no-undo .
     2793   v-dir-name = substring(v-path-ver , 1 , length (v-path-ver) - 5 ).
     2794   run gbl/d-prompt.w (
     2795       'title=':u + "Введите имя директории" + '\':u
     2796     + 'text1=':u + "Введите имя директории с файлами 'MIG'" + '\':u
     2797     + 'format=x(256)\':u
     2798     + 'type=char\':u
     2799     ,input-output v-dir-name
     2800     ).
     2801   if return-value = 'false':u then do:
     2802     return .
     2803   end.
     2804   assign
     2805     file-info :file-name = v-dir-name
     2806   .
     2807   if file-info :full-pathname = ""
     2808   or file-info :full-pathname = ?  then do:
     2809     message
     2810       vss-workfile vss-revision vss-description skip
     2811       substitute( "Каталог: &1 не найден !!!", v-dir-name ) skip
     2812       return-value skip
     2813       error-status :get-message ( error-status :num-messages )
     2814       view-as alert-box error
     2815     .
     2816     undo, return error .
     2817   end.
     2818   assign
     2819     v-dir-name = file-info :full-pathname
     2820   .
     2821   v-path-ver = v-dir-name .
     2822   define stream OutStream.
     2823   define temp-table temp-proc no-undo
     2824   field proc-name as character
     2825   index pi proc-name
     2826   .
     2827      p-db-num   = int (entry(1,p-parameter,chr(4))) .
     2828      p-cli-code = int (entry(2,p-parameter,chr(4))) .
     2829   MAIN-BLOCK:
     2830   do
     2831   on error   undo main-block, return error substitute('error main-block,&1', return-value )
     2832   on end-key undo main-block, return error substitute('end-key main-block,&1', return-value )
     2833   :
     2834   if transaction then do:
     2835     message
     2836       vss-workfile vss-revision vss-description skip
     2837       "Недопустимо вызывать процедуру из транзакции!" skip
     2838       view-as alert-box error .
     2839   end.
     2840   run write-log-and-file in p-log-handle (
     2841         input 1
     2842       , input log-file-name
     2843       , input 1
     2844       , input substitute("Трансформация УБД &1 в ГБД", p-db-num))
     2845       .
     2846   find first ub.clients no-lock where
     2847              ub.clients.obj-code = p-cli-code and
     2848              ub.clients.obj-type = 'орг':U no-error .
     2849       if error-status :error then do:
     2850           run write-log-and-file in p-log-handle (
     2851                 input 1
     2852               , input log-file-name
     2853               , input 1
     2854               , input substitute("err - &1", error-status :get-message(1) )).
     2855           return .
     2856       end.
     2857   run filelist-dirlist-subdir-init (input v-path-ver ) .
     2858   for each temp-proc :
     2859      delete temp-proc.
     2860   end.
     2861   for each temp-dirlist :
     2862       run filelist-clear .
     2863       run filelist-init
     2864         ( temp-dirlist.dir-full-name  ,
     2865           true                        ,
     2866           "p"                       ,
     2867           temp-dirlist.dir-short-name )  .
     2868       for each temp-filelist where temp-filelist.file-name-no-ext  begins "mig_" :
     2869           create temp-proc.
     2870           temp-proc.proc-name = temp-filelist.dir-short-name + "\" + temp-filelist.file-name .
     2871       end.
     2872   end.
     2873   for each temp-proc :
     2874       run write-log-and-file in p-log-handle (
     2875             input 1
     2876           , input log-file-name
     2877           , input 1
     2878           , input temp-proc.proc-name ) .
     2879       run value ( temp-proc.proc-name )
     2880           ( parparentproc
     2881           , p-parent-handle
     2882           , p-log-handle
     2883           , p-parameter
     2884           , p-db-num
     2885           , p-cli-code
     2886           , log-file-name )
     2887           no-error .
     2888       if error-status :error then do:
     2889           run write-log-and-file in p-log-handle (
     2890                 input 1
     2891               , input log-file-name
     2892               , input 1
     2893               , input substitute("err - &1 &2" , error-status :get-message(1) , return-value  )).
     2894           return .
     2895       end.
     2896   end.
     2897   run write-log-and-file in p-log-handle (
     2898       input 1
     2899     , input log-file-name
     2900     , input 1
     2901     , input substitute("Восстановление Последовательностей")).
     2902   create alias restseq    for database value( ldbname( "ub":U ) ) .
     2903   create alias restseqflt for database value( ldbname( "ub":U ) ) .
     2904   run adm/restseq.p (input "rest-no-msg", input "":U, input no) no-error .
     2905   if error-status :error then do:
     2906     run write-log-and-file in p-log-handle (
     2907           input 1
     2908         , input log-file-name
     2909         , input 1
     2910         , input substitute ( "err - &1 &2" , error-status :get-message(1) , return-value  )).
     2911         delete alias restseqflt.
     2912         delete alias restseq.
     2913     return .
     2914   end.
     2915   run write-log-and-file in p-log-handle (
     2916         input 1
     2917       , input log-file-name
     2918       , input 1
     2919       , input   return-value  ).
     2920   delete alias restseqflt.
     2921   delete alias restseq.
     2922   run write-log-and-file in p-log-handle (
     2923         input 1
     2924       , input log-file-name
     2925       , input 1
     2926       , input "Трансформация закончена" ).
     2927   end.
