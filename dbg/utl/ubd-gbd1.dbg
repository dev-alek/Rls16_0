     1205         q_h6:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
     1206                           ,v-table-name6
     1207                           ,v-field-name6
     1208                           ,p-first-code
     1209                           ,p-last-code)
     1210                           ).
     1211         q_h6:QUERY-OPEN.
     1212         REPEAT while  q_h6:get-next().
     1213           assign
     1214             v-code_6 = buf_h6:buffer-field(v-field-name6):buffer-value
     1215           .
     1216           leave .
     1217         END.
     1218         q_h6:QUERY-CLOSE().
     1219         delete object q_h6.
     1220         delete object buf_h6.
     1221         v-b-code = max(v-code_6, v-b-code).
     1222       end.
     1223     end.
     1224     when "f-u":U then do:
     1225       for each buf_code-range share-lock
