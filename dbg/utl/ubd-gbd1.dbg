     1088                   and buf_code-range.stts = "u":U
     1089                 )
     1090       on error undo, return error
     1091       :
     1092         v-avail5 = 0.
     1093         do v-ii5 = 1 to num-entries('ub.person'):
     1094           assign
     1095           v-table-name5 = entry(v-ii5, 'ub.person')
     1096           v-field-name5 = entry(v-ii5, 'psn-code')
     1097           .
     1098           create buffer buf_h5 for table v-table-name5.
     1099           glog5 = buf_h5:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
     1100                                   , v-table-name5
     1101                                   , v-field-name5
     1102                                   , buf_code-range.first-code
     1103                                   , buf_code-range.last-code)
     1104                                   ) no-error .
     1105           if buf_h5:available then do:
     1106             assign
     1107             v-avail5 = v-avail5 + 1
     1108             .
     1109             if v-avail5 = 1 then do:
     1110               v-code-mess5 = string(buf_h5:buffer-field(v-field-name5):buffer-value)
     1111               .
     1112             end.
     1113           end.
     1114           delete object buf_h5.
     1115        end.
     1116        if v-avail5 > 0
     1117           and buf_code-range.stts = "f":U
     1118         then do:
     1119           assign
     1120             buf_code-range.stts = "u":U
     1121             v-b-code            = v-b-code + 1
     1122             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1123                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1124                                               , chr(10)
     1125                                               , buf_code-range.first-code
     1126                                               , buf_code-range.last-code
     1127                                               , v-code-mess5
     1128                                             )
     1129           .
     1130           if p-view-mess = true then do:
     1131             message
     1132               v-msg
     1133               view-as alert-box information.
     1134           end.
     1135           else do:
     1136             output stream getmc-stream to "getmc.log" append.
     1137             put stream getmc-stream unformatted
     1138               string( today, "99/99/9999" ) space(1)
     1139               string( time, "HH:MM:SS" ) space(1)
     1140               v-msg skip
     1141             .
     1142             output stream getmc-stream close.
     1143           end.
     1144         end.
     1145         if v-avail5 = 0
     1146           and buf_code-range.stts = "u":U
     1147         then do:
     1148           find first buf-c_code-range exclusive-lock
     1149             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1150           .
     1151           assign
     1152             buf-c_code-range.stts = "c":U
     1153           .
