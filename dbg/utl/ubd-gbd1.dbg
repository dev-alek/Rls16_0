     1443           assign
     1444             buf_code-range.stts = "f":U
     1445             v-b-code            = v-b-code + 1
     1446             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1447                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1448                                               , chr(10)
     1449                                               , buf_code-range.first-code
     1450                                               , buf_code-range.last-code
     1451                                             )
     1452           .
     1453           if p-view-mess = true then do:
     1454             message
     1455               v-msg
     1456               view-as alert-box information.
     1457           end.
     1458           else do:
     1459             output stream getmc-stream to "getmc.log" append.
     1460             put stream getmc-stream unformatted
     1461               string( today, "99/99/9999" ) space(1)
     1462               string( time, "HH:MM:SS" ) space(1)
