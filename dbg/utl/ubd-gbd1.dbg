     1196     when "get-m-code":U then do:
     1197       do v-ii6 = 1 to num-entries('ub.dis-rule,ub.dis-time-rule'):
     1198         assign
     1199         v-table-name6 = entry(v-ii6, 'ub.dis-rule,ub.dis-time-rule')
     1200         v-field-name6 = entry(v-ii6, 'rule-num,time-rule-num')
     1201         .
