     1384           v-field-name7 = entry(v-ii7, 'b-code,pl-code')
     1385           .
     1386           create buffer buf_h7 for table v-table-name7.
     1387           glog7 = buf_h7:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
     1388                                   , v-table-name7
     1389                                   , v-field-name7
     1390                                   , buf_code-range.first-code
     1391                                   , buf_code-range.last-code)
     1392                                   ) no-error .
     1393           if buf_h7:available then do:
     1394             assign
     1395             v-avail7 = v-avail7 + 1
     1396             .
     1397             if v-avail7 = 1 then do:
     1398               v-code-mess7 = string(buf_h7:buffer-field(v-field-name7):buffer-value)
     1399               .
     1400             end.
     1401           end.
     1402           delete object buf_h7.
     1403        end.
     1404        if v-avail7 > 0
     1405           and buf_code-range.stts = "f":U
     1406         then do:
     1407           assign
     1408             buf_code-range.stts = "u":U
     1409             v-b-code            = v-b-code + 1
     1410             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1411                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1412                                               , chr(10)
     1413                                               , buf_code-range.first-code
     1414                                               , buf_code-range.last-code
     1415                                               , v-code-mess7
     1416                                             )
     1417           .
