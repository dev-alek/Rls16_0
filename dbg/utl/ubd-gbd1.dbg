        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle     as handle no-undo .
        5   define input parameter p-parameter      as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: ubd-gbd1.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/ubd-gbd1.p $":U .
       11   define variable vss-description as character no-undo init "Трансформация УБД в ГБД".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   function diff-list returns character (
       71     input parfirst-list  as character,
       72     input parsecond-list as character,
       73     input pardelim       as character).
       74     if pardelim = ""
       75     or pardelim = ?
       76     then do:
       77       assign
       78         pardelim = ","
       79       .
       80     end.
       81     def var ind as integer no-undo .
       82     def var v-elem as character no-undo .
       83     def var v-result-list as character no-undo init "".
       84     def var v-num-parfirst-list as integer no-undo .
       85     assign
       86       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
       87     .
       88     do ind = 1 to v-num-parfirst-list
       89     :
       90       assign
       91         v-elem = entry(ind, parfirst-list, pardelim)
       92       .
       93       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
       94         assign
       95           v-result-list = v-result-list
       96                         + (if v-result-list > "" then pardelim else "")
       97                         + v-elem
       98         .
       99       end.
      100     end.
      101     return v-result-list .
      102   end function.
      103   function add-list returns character (
      104    input parfirst-list  as character,
      105    input parsecond-list as character,
      106    input pardelim       as character).
      107     if pardelim = ""
      108     or pardelim = ?
      109     then do:
      110       assign
      111         pardelim = ","
      112       .
      113     end.
      114     def var ind as integer no-undo .
      115     def var v-elem as character no-undo .
      116     def var v-result-list as character no-undo init "".
      117     def var v-num-parfirst-list as integer no-undo .
      118     assign
      119       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      120     .
      121     do ind = 1 to v-num-parfirst-list
      122     :
      123       assign
      124         v-elem = entry(ind, parfirst-list, pardelim)
      125       .
      126       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      127         assign
      128           v-result-list = v-result-list
      129                         + (if v-result-list > "" then pardelim else "")
      130                         + v-elem
      131         .
      132       end.
      133     end.
      134     def var v-num-parsecond-list as integer no-undo .
      135     assign
      136       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      137     .
      138     do ind = 1 to v-num-parsecond-list
      139     :
      140       assign
      141         v-elem = entry(ind, parsecond-list, pardelim)
      142       .
      143       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      144         assign
      145           v-result-list = v-result-list
      146                         + (if v-result-list > "" then pardelim else "")
      147                         + v-elem
      148         .
      149       end.
      150     end.
      151     return v-result-list .
      152   end function.
      153   function cross-list returns character (
      154    input parfirst-list  as character,
      155    input parsecond-list as character,
      156    input pardelim       as character).
      157     if pardelim = ""
      158     or pardelim = ?
      159     then do:
      160       assign
      161         pardelim = ","
      162       .
      163     end.
      164     def var ind as integer no-undo .
      165     def var v-elem as character no-undo .
      166     def var v-result-list as character no-undo init "".
      167     def var v-num-parfirst-list as integer no-undo .
      168     assign
      169       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      170     .
      171     do ind = 1 to v-num-parfirst-list
      172     :
      173       assign
      174         v-elem = entry(ind, parfirst-list, pardelim)
      175       .
      176       if lookup(v-elem, v-result-list, pardelim) = 0
      177       and lookup(v-elem, parsecond-list, pardelim) > 0
      178       then do:
      179         assign
      180           v-result-list = v-result-list
      181                         + (if v-result-list > "" then pardelim else "")
      182                         + v-elem
      183         .
      184       end.
      185     end.
      186     return v-result-list .
      187   end function.
      188   function radio-label returns character (
      189    input par-rs-value  as character,
      190    input par-rs-radio-buttons as character)
      191    .
      192    DEFINE variable v-result-label as character no-undo.
      193    assign
      194    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      195                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      196                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      197                             ), par-rs-radio-buttons
      198                           )
      199    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      200    .
      201   return v-result-label.
      202   end function.
      203   function m-radio-label returns character (
      204    input par-rs-value  as character,
      205    input par-rs-radio-buttons as character,
      206    input par-delim as character
      207    )
      208    .
      209    DEFINE variable v-result-label as character no-undo.
      210    assign
      211    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      212                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      213                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      214                             ), par-rs-radio-buttons, par-delim
      215                           )
      216    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      217    .
      218   return v-result-label.
      219   end function.
      220   FUNCTION mixlist returns character
      221   (
      222    input parfirst-list  as character
      223    ,input parsecond-list as character
      224    ,input pardelim       as character
      225    ,input pardelim-result as character ) :
      226     if pardelim = ""
      227     or pardelim = ?
      228     then do:
      229       assign
      230         pardelim = ","
      231       .
      232     end.
      233     def var ind as integer no-undo .
      234     def var v-elem1 as character no-undo .
      235     def var v-elem2 as character no-undo .
      236     def var v-result-list as character no-undo init "".
      237     do ind = 1 to num-entries(parfirst-list, pardelim)
      238     :
      239       assign
      240         v-elem1 = entry(ind, parfirst-list, pardelim)
      241         v-elem2 = entry(ind, parsecond-list, pardelim)
      242       .
      243         assign
      244           v-result-list = v-result-list
      245                         + (if v-result-list > "" then pardelim-result else "")
      246                         + v-elem1 + pardelim-result + v-elem2
      247         .
      248     end.
      249     return v-result-list .
      250   END FUNCTION.
      251   define stream getmc-stream .
      252   procedure get-max-code :
      253     define input  parameter p-action         as   character                 no-undo .
      254     define input  parameter p-db-num         like ub.db.db-num             no-undo .
      255     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
      256     define input  parameter p-first-code     like ub.code-range.first-code no-undo .
      257     define input  parameter p-last-code      like ub.code-range.last-code  no-undo .
      258     define input  parameter p-view-mess      as   logical                   no-undo .
      259     define output parameter v-b-code         as   integer                   no-undo .
      260     do
      261     on error undo, return error return-value
      262     :
      263       define variable v-main-bcode     like ub.bar-code.b-code no-undo .
      264       define variable l-prod-bc-global as   logical             no-undo .
      265       define variable l-prod-bc-weight as   logical             no-undo .
      266       define variable l-prod-bc-pgweight as   logical             no-undo .
      267       define variable rec-cnt          as   integer             no-undo .
      268       define variable str-u-f          as   character           no-undo .
      269       define variable str-u-f-rng      as   character           no-undo .
      270       define variable ind              as   integer             no-undo .
      271       define variable v-msg              as   character           no-undo initial "":U.
      272       define variable v-ret-msg          as   character           no-undo initial "":U.
      273       define frame get-max-code-inf
      274         rec-cnt label "Просмотрено"
      275         with view-as dialog-box side-labels row 11 centered
      276         title "..........................................." three-d
      277       .
      278       define buffer buf_code-range   for ub.code-range .
      279       define buffer buf-c_code-range for ub.code-range .
      280       define buffer buf_bar-code     for ub.bar-code .
      281       define buffer buf_place        for ub.place .
      282       define buffer buf_goods        for ub.goods .
      283       define buffer buf_units        for ub.units .
      284       define buffer buf_prod-bc      for ub.prod-bc .
      285       define buffer buf_dis-card     for ub.dis-card .
      286       define buffer buf_dis-rule     for ub.dis-rule .
      287       define buffer buf_dis-time-rule     for ub.dis-time-rule .
      288       define buffer buf_firm         for ub.firm .
      289       define buffer buf_person       for ub.person .
      290       define buffer buf_contract     for ub.contract .
      291       if p-curr-type-cdrg = 'sslc':U
      292       or p-curr-type-cdrg = 'ssgb':U
      293       then do:
      294         assign
      295           v-b-code = ?
      296         .
      297         return.
      298       end.
      299       if p-curr-type-cdrg = 'sclc':U
      300       or p-curr-type-cdrg = 'pglc':U
      301         or p-curr-type-cdrg = 'sslc':U
      302       then do:
      303         assign
      304           p-db-num = 0
      305         .
      306       end.
      307       case p-action :
      308         when "get-m-code":U then do:
      309           assign
      310             v-b-code = p-first-code
      311           .
      312         end.
      313         when "f-u":U then do:
      314           assign
      315             v-b-code = 0
      316           .
      317         end.
      318       end case.
      319       case p-curr-type-cdrg :
      320         when 'dcgb':U then do:
      321   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   define variable v-ii0 as integer   no-undo .
      323   define variable v-table-name0 as character no-undo .
      324   define variable v-field-name0 as character no-undo .
      325   define variable buf_h0 as handle no-undo .
      326   define variable q_h0 as handle no-undo .
      327   define variable v-avail0 as integer   no-undo .
      328   define variable v-code-mess0 as character no-undo .
      329   define variable glog0 as logical   no-undo .
      330   define variable v-code_0 as integer   no-undo .
      331   case p-action :
      332     when "get-m-code":U then do:
      333       do v-ii0 = 1 to num-entries('ub.dis-card'):
      334         assign
      335         v-table-name0 = entry(v-ii0, 'ub.dis-card')
      336         v-field-name0 = entry(v-ii0, 'card-num')
      337         .
      338         create buffer buf_h0 for table v-table-name0.
      339         create query q_h0.
      340         q_h0:SET-BUFFERS(buf_h0).
      341         q_h0:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      342                           ,v-table-name0
      343                           ,v-field-name0
      344                           ,p-first-code
      345                           ,p-last-code)
      346                           ).
      347         q_h0:QUERY-OPEN.
      348         REPEAT while  q_h0:get-next().
      349           assign
      350             v-code_0 = buf_h0:buffer-field(v-field-name0):buffer-value
      351           .
      352           leave .
      353         END.
      354         q_h0:QUERY-CLOSE().
      355         delete object q_h0.
      356         delete object buf_h0.
      357         v-b-code = max(v-code_0, v-b-code).
      358       end.
      359     end.
      360     when "f-u":U then do:
      361       for each buf_code-range share-lock
      362           where ( buf_code-range.range-type = p-curr-type-cdrg
      363                   and buf_code-range.db-num = p-db-num
      364                   and buf_code-range.stts = "f":U
      365                 ) or
      366                 ( buf_code-range.range-type = p-curr-type-cdrg
      367                   and buf_code-range.db-num = p-db-num
      368                   and buf_code-range.stts = "u":U
      369                 )
      370       on error undo, return error
      371       :
      372         v-avail0 = 0.
      373         do v-ii0 = 1 to num-entries('ub.dis-card'):
      374           assign
      375           v-table-name0 = entry(v-ii0, 'ub.dis-card')
      376           v-field-name0 = entry(v-ii0, 'card-num')
      377           .
      378           create buffer buf_h0 for table v-table-name0.
      379           glog0 = buf_h0:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      380                                   , v-table-name0
      381                                   , v-field-name0
      382                                   , buf_code-range.first-code
      383                                   , buf_code-range.last-code)
      384                                   ) no-error .
      385           if buf_h0:available then do:
      386             assign
      387             v-avail0 = v-avail0 + 1
      388             .
      389             if v-avail0 = 1 then do:
      390               v-code-mess0 = string(buf_h0:buffer-field(v-field-name0):buffer-value)
      391               .
      392             end.
      393           end.
      394           delete object buf_h0.
      395        end.
      396        if v-avail0 > 0
      397           and buf_code-range.stts = "f":U
      398         then do:
      399           assign
      400             buf_code-range.stts = "u":U
      401             v-b-code            = v-b-code + 1
      402             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      403                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
      404                                               , chr(10)
      405                                               , buf_code-range.first-code
      406                                               , buf_code-range.last-code
      407                                               , v-code-mess0
      408                                             )
      409           .
      410           if p-view-mess = true then do:
      411             message
      412               v-msg
      413               view-as alert-box information.
      414           end.
      415           else do:
      416             output stream getmc-stream to "getmc.log" append.
      417             put stream getmc-stream unformatted
      418               string( today, "99/99/9999" ) space(1)
      419               string( time, "HH:MM:SS" ) space(1)
      420               v-msg skip
      421             .
      422             output stream getmc-stream close.
      423           end.
      424         end.
      425         if v-avail0 = 0
      426           and buf_code-range.stts = "u":U
      427         then do:
      428           find first buf-c_code-range exclusive-lock
      429             where rowid( buf-c_code-range ) = rowid( buf_code-range )
      430           .
      431           assign
      432             buf-c_code-range.stts = "c":U
      433           .
      434           release buf-c_code-range .
      435           assign
      436             buf_code-range.stts = "f":U
      437             v-b-code            = v-b-code + 1
      438             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      439                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
      440                                               , chr(10)
      441                                               , buf_code-range.first-code
      442                                               , buf_code-range.last-code
      443                                             )
      444           .
      445           if p-view-mess = true then do:
      446             message
      447               v-msg
      448               view-as alert-box information.
      449           end.
      450           else do:
      451             output stream getmc-stream to "getmc.log" append.
      452             put stream getmc-stream unformatted
      453               string( today, "99/99/9999" ) space(1)
      454               string( time, "HH:MM:SS" ) space(1)
      455               v-msg skip
      456             .
      457             output stream getmc-stream close.
      458           end.
      459         end.
      460       end.
      461     end.
      462   end case.
      463         end.
      464         when 'ctgb':U then do:
      465   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      466   define variable v-ii1 as integer   no-undo .
      467   define variable v-table-name1 as character no-undo .
      468   define variable v-field-name1 as character no-undo .
      469   define variable buf_h1 as handle no-undo .
      470   define variable q_h1 as handle no-undo .
      471   define variable v-avail1 as integer   no-undo .
      472   define variable v-code-mess1 as character no-undo .
      473   define variable glog1 as logical   no-undo .
      474   define variable v-code_1 as integer   no-undo .
      475   case p-action :
      476     when "get-m-code":U then do:
      477       do v-ii1 = 1 to num-entries('ub.contract'):
      478         assign
      479         v-table-name1 = entry(v-ii1, 'ub.contract')
      480         v-field-name1 = entry(v-ii1, 'contract-code')
      481         .
      482         create buffer buf_h1 for table v-table-name1.
      483         create query q_h1.
      484         q_h1:SET-BUFFERS(buf_h1).
      485         q_h1:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      486                           ,v-table-name1
      487                           ,v-field-name1
      488                           ,p-first-code
      489                           ,p-last-code)
      490                           ).
      491         q_h1:QUERY-OPEN.
      492         REPEAT while  q_h1:get-next().
      493           assign
      494             v-code_1 = buf_h1:buffer-field(v-field-name1):buffer-value
      495           .
      496           leave .
      497         END.
      498         q_h1:QUERY-CLOSE().
      499         delete object q_h1.
      500         delete object buf_h1.
      501         v-b-code = max(v-code_1, v-b-code).
      502       end.
      503     end.
      504     when "f-u":U then do:
      505       for each buf_code-range share-lock
      506           where ( buf_code-range.range-type = p-curr-type-cdrg
      507                   and buf_code-range.db-num = p-db-num
      508                   and buf_code-range.stts = "f":U
      509                 ) or
      510                 ( buf_code-range.range-type = p-curr-type-cdrg
      511                   and buf_code-range.db-num = p-db-num
      512                   and buf_code-range.stts = "u":U
      513                 )
      514       on error undo, return error
      515       :
      516         v-avail1 = 0.
      517         do v-ii1 = 1 to num-entries('ub.contract'):
      518           assign
      519           v-table-name1 = entry(v-ii1, 'ub.contract')
      520           v-field-name1 = entry(v-ii1, 'contract-code')
      521           .
      522           create buffer buf_h1 for table v-table-name1.
      523           glog1 = buf_h1:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      524                                   , v-table-name1
      525                                   , v-field-name1
      526                                   , buf_code-range.first-code
      527                                   , buf_code-range.last-code)
      528                                   ) no-error .
      529           if buf_h1:available then do:
      530             assign
      531             v-avail1 = v-avail1 + 1
      532             .
      533             if v-avail1 = 1 then do:
      534               v-code-mess1 = string(buf_h1:buffer-field(v-field-name1):buffer-value)
      535               .
      536             end.
      537           end.
      538           delete object buf_h1.
      539        end.
      540        if v-avail1 > 0
      541           and buf_code-range.stts = "f":U
      542         then do:
      543           assign
      544             buf_code-range.stts = "u":U
      545             v-b-code            = v-b-code + 1
      546             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
