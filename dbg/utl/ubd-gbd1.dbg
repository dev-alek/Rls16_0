     1259        end.
     1260        if v-avail6 > 0
     1261           and buf_code-range.stts = "f":U
     1262         then do:
     1263           assign
     1264             buf_code-range.stts = "u":U
     1265             v-b-code            = v-b-code + 1
     1266             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1267                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1268                                               , chr(10)
