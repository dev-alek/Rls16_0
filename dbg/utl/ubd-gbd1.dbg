     1434           and buf_code-range.stts = "u":U
     1435         then do:
     1436           find first buf-c_code-range exclusive-lock
     1437             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1438           .
     1439           assign
     1440             buf-c_code-range.stts = "c":U
