        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       18   define new global shared variable g#trdcalib as handle no-undo.
       19   define  shared stream vProtTest.
       20   define  shared variable testId as rowid no-undo.
       21   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
       22     then run str/lib-trn.p persistent no-error .
       23   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn2)
       24     then run str/lib-trn2.p persistent no-error .
       25   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
       26     then run str/lib-trn3.p persistent no-error .
       27   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn4)
       28     then run str/lib-trn4.p persistent no-error .
       29   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#trdcalib)
       30     then run str/trdcalib.p persistent no-error .
       31   define temp-table tt-trn like ub.trn-doc.
       32   define var      v-doc-code as char      no-undo.
       33   define variable varvalue   as character no-undo .
       34   define variable vartype    as character no-undo .
       35   if testId ne ? then
       36   do:
       37     find first ub.trn-doc where rowid(ub.trn-doc) = testId no-lock no-error.
       38     v-doc-code = ub.trn-doc.doc-code.
       39   end.
       40   else
       41   do:
       42   DEFINE FRAME frame1
       43     v-doc-code format "x(15)"
       44     with view-as dialog-box
       45     title "Введите номер документа (накл., инв., перес."
       46     .
       47   update v-doc-code with frame frame1.
       48   end.
       49   find first ub.trn-doc where ub.trn-doc.doc-code = v-doc-code no-error.
       50   if not available (ub.trn-doc)
       51     then
       52   do:
       53     message "Документ инвентаризации не найден: номер " v-doc-code view-as alert-box.
       54     return.
       55   end.
       56   buffer-copy trn-doc except trn-doc.status_ to tt-trn  assign
       57     tt-trn.status_ = "накл".
       58   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
       59     (input ?
       60     ,input this-procedure:handle
       61     ,input ?
       62     ,input 'event_trn-doc':U
       63     ,input  buffer tt-trn:handle
       64     ,input  buffer ub.trn-doc:handle
       65     ,input ''
       66     ,input ''
       67     ) no-error .
       68   if error-status:error
       69     then
       70   do:
       71     message return-value view-as alert-box.
       72   end.
       73   else
       74   do:
       75   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
       76                           input 'is-lgas':U ,
       77                          output varvalue ,
       78                          output vartype ) no-error .
       79     if varvalue = "yes" then
       80     do:
       81       run bge\send1cerp.p (?,
       82         this-procedure,
       83         this-procedure,
       84         "techlosses",
       85         (buffer trn-doc:handle),
       86         ?,
       87         ?) no-error.
       88       if error-status:error
       89         then
       90       do:
       91         message return-value view-as alert-box.
       92       end.
       93     end.
       94   if testId ne ? then
       95     put stream vProtTest unformatted "Документ " v-doc-code " отправлен" skip.
       96   else
       97     message trn-doc.doc-code " отправлен" view-as alert-box.
       98   end.
