        1   CREATE WIDGET-POOL.
        2   DEFINE VAR C-Win AS WIDGET-HANDLE NO-UNDO.
        3   DEFINE FRAME DEFAULT-FRAME
        4       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
        5            SIDE-LABELS NO-UNDERLINE THREE-D
        6            AT COL 1 ROW 1
        7            SIZE 20.25 BY .71 WIDGET-ID 100.
        8   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
        9     CREATE WINDOW C-Win ASSIGN
       10            HIDDEN             = YES
       11            TITLE              = "Сообщение"
       12            HEIGHT             = .67
       13            WIDTH              = 20.25
       14            MAX-HEIGHT         = 42.38
       15            MAX-WIDTH          = 240
       16            VIRTUAL-HEIGHT     = 42.38
       17            VIRTUAL-WIDTH      = 240
       18            RESIZE             = yes
       19            SCROLL-BARS        = no
       20            STATUS-AREA        = no
       21            BGCOLOR            = ?
       22            FGCOLOR            = ?
       23            KEEP-FRAME-Z-ORDER = yes
       24            THREE-D            = yes
       25            MESSAGE-AREA       = no
       26            SENSITIVE          = yes.
       27   ELSE C-Win = CURRENT-WINDOW.
       28   ASSIGN
       29          FRAME DEFAULT-FRAME:HIDDEN           = TRUE.
       30   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
       31   THEN C-Win:HIDDEN = no.
       32   ON END-ERROR OF C-Win
       33   OR ENDKEY OF C-Win ANYWHERE DO:
       34     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
       35   END.
       36   ON WINDOW-CLOSE OF C-Win
       37   DO:
       38     APPLY "CLOSE":U TO THIS-PROCEDURE.
       39     RETURN NO-APPLY.
       40   END.
       41   ASSIGN CURRENT-WINDOW                = C-Win
       42          THIS-PROCEDURE:CURRENT-WINDOW = C-Win.
       43   ON CLOSE OF THIS-PROCEDURE
       44      RUN disable_UI.
       45   PAUSE 0 BEFORE-HIDE.
       46   MAIN-BLOCK:
       47   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       48      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       49     RUN enable_UI.
       50     define variable FullFileName  as character no-undo.
       51     define variable v-param       as character no-undo .
       52     define variable ind           as integer   no-undo .
       53     define variable v-num-entries as integer   no-undo .
       54     define variable v-msg         as character no-undo .
       55     define stream   s-imp.
       56     if session:parameter <> "":U
       57       and session:parameter <> ?
       58     then do:
       59       assign
       60         v-num-entries = num-entries( session:parameter, ",":U )
       61       .
       62       do ind = 1 to v-num-entries :
       63         assign
       64           v-param = entry( ind, session:parameter, ",":U )
       65         .
       66           if v-param begins 'FullFileName' then do:
       67             assign
       68               FullFileName = entry( 2, v-param, "?":U )
       69             .
       70           end.
       71       end.
       72     end.
       73     if FullFileName = ? or FullFileName = ""
       74       then do:
       75         message "Не могу вывести сообщение" view-as alert-box.
       76         quit.
       77       end.
       78     input stream s-imp from value( FullFileName ).
       79     import stream s-imp unformatted v-msg no-error.
       80     message v-msg view-as alert-box information title "Информация.".
       81     quit.
       82   END.
       83   PROCEDURE disable_UI :
       84     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
       85     THEN DELETE WIDGET C-Win.
       86     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
       87   END PROCEDURE.
       88   PROCEDURE enable_UI :
       89     VIEW FRAME DEFAULT-FRAME IN WINDOW C-Win.
       90     VIEW C-Win.
       91   END PROCEDURE.
