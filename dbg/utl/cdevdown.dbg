        1   block-level on error undo, throw.
        2   define input        parameter parparentproc as widget-handle  no-undo .
        3   define input-output parameter p-base-version as integer          no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: cdevdown.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/cdevdown.p $":U .
        9   define variable vss-description as character no-undo init "Выгрузка списка событий на кассе".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define buffer bf_cd-events      for ub.cd-events .
      116   define buffer buf_cd-events      for ub.cd-events .
      117   define stream st-out .
      118   DEFINE STREAM st-in .
      119   define variable v-str      as character    no-undo.
      120   define variable v-str-enc  as character    no-undo.
      121   define variable v-file-version    as integer      no-undo.
      122   define variable v-new-version    as integer      no-undo.
      123   DEFINE VARIABLE v-count      AS INTEGER   NO-UNDO .
      124   do
      125   on error undo, return error
      126   :
      127      DO
      128      TRANSACTION
      129      :
      130         FIND LAST buf_cd-events
      131            EXCLUSIVE-LOCK
      132            NO-ERROR
      133            NO-WAIT
      134            .
      135         IF NOT AVAILABLE buf_cd-events
      136         AND LOCKED buf_cd-events
      137         THEN DO:
      138            RETURN ERROR "Список событий в данный момент выгружает другой пользователь".
      139         END.
      140      END.
      141      input stream st-out from "cmp/cd-event.enc".
      142      IMPORT STREAM st-in UNFORMATTED
      143         v-str-enc
      144         NO-ERROR.
      145      IF ERROR-STATUS:ERROR
      146      THEN DO:
      147         ASSIGN
      148            v-str = "0"
      149         .
      150      END.
      151      ELSE DO:
      152         input stream st-out close .
      153   define variable vss-include-info0 as character format "X(65)" no-undo
      154   initial "@(#)$Workfile$ $Revision$".
      155   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      156     (input  v-str-enc
      157     ,output v-str
      158     )  .
      159      END.
      160      ASSIGN
      161         v-file-version = INTEGER(v-str)
      162      NO-ERROR.
      163      IF ERROR-STATUS:ERROR
      164      THEN DO:
      165         RETURN ERROR SUBSTITUTE( "Не верный номер версии &1&2&3" , v-str, chr(10), ERROR-STATUS:GET-MESSAGE (1)) .
      166      END.
      167      IF v-file-version > p-base-version
      168      THEN DO:
      169         RETURN ERROR SUBSTITUTE( "В файле номер версии №&1 больше текущей №&2", v-file-version, p-base-version) .
      170      END.
      171      output stream st-out to "cmp/cd-event.enc" .
      172      ASSIGN
      173         v-new-version = p-base-version + 1
      174         v-str = STRING(v-new-version)
      175      .
      176   define variable vss-include-info1 as character format "X(65)" no-undo
      177   initial "@(#)$Workfile$ $Revision$".
      178     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
      179     (input  v-str
      180     ,output v-str-enc
      181     )  .
      182      PUT stream st-out UNFORMATTED
      183         v-str-enc SKIP
      184      .
      185      ASSIGN
      186         v-count = 0
      187      .
      188      FOR EACH bf_cd-events
      189          no-lock
      190          :
      191            ASSIGN
      192               v-str = SUBSTITUTE( "&1&2&3&4&5&6&7&8"
      193                                 , bf_cd-events.event-id
      194                                 , chr(4)
      195                                 , bf_cd-events.event-level
      196                                 , chr(4)
      197                                 , bf_cd-events.event-name
      198                                 , chr(4)
      199                                 , bf_cd-events.event-status
      200                                 , chr(4)
      201                                 )
      202            .
      203            ASSIGN
      204               v-str = SUBSTITUTE( "&1&2&3&4"
      205                                 , v-str
      206                                 , bf_cd-events.event-type
      207                                 , chr(4)
      208                                 , bf_cd-events.event-description
      209                                 )
      210            .
      211   define variable vss-include-info2 as character format "X(65)" no-undo
      212   initial "@(#)$Workfile$ $Revision$".
      213     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
      214     (input  v-str
      215     ,output v-str-enc
      216     )  .
      217            PUT stream st-out UNFORMATTED
      218                v-str-enc SKIP
      219            .
      220            ASSIGN
      221               v-count = v-count + 1
      222            .
      223      END.
      224      ASSIGN
      225         v-str = STRING(v-count)
      226      .
      227   define variable vss-include-info3 as character format "X(65)" no-undo
      228   initial "@(#)$Workfile$ $Revision$".
      229     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
      230     (input  v-str
      231     ,output v-str-enc
      232     )  .
      233      PUT stream st-out UNFORMATTED
      234         v-str-enc SKIP
      235      .
      236      DO
      237      TRANSACTION
      238      :
      239         FOR EACH bf_cd-events
      240            EXCLUSIVE-lock
      241            :
      242            ASSIGN
      243               bf_cd-events.version = v-new-version
      244            .
      245         END.
      246      END.
      247   end.
