      796        size 3 by .88.
      797   DEFINE BUTTON b-ok AUTO-GO
      798        LABEL "Выполнить"
      799        SIZE 15 BY 1.14
      800        BGCOLOR 8 .
      801   DEFINE VARIABLE f-rep-date1 AS DATE FORMAT "99/99/9999":U INITIAL ?
      802        LABEL "Период С"
      803        VIEW-AS FILL-IN
      804        SIZE 12 BY 1 NO-UNDO.
      805   DEFINE VARIABLE f-rep-date2 AS DATE FORMAT "99/99/9999":U INITIAL ?
      806        LABEL "По"
      807        VIEW-AS FILL-IN
      808        SIZE 12 BY 1 NO-UNDO.
      809   DEFINE VARIABLE f-timediff AS INTEGER FORMAT "->>>9":U INITIAL 0
      810        LABEL "Разница с московским часовым поясом, ч."
      811        VIEW-AS FILL-IN
      812        SIZE 7.2 BY 1 NO-UNDO.
      813   DEFINE FRAME Dialog-Frame
      814        b-ok AT ROW 1.24 COL 2
      815        b-cancel AT ROW 1.24 COL 17
      816        b-date1 AT ROW 2.95 COL 24 WIDGET-ID 6
      817        b-date2 AT ROW 2.95 COL 44 WIDGET-ID 6
      818        f-rep-date1 AT ROW 3 COL 10 COLON-ALIGNED WIDGET-ID 2
      819        f-rep-date2 AT ROW 3 COL 30 COLON-ALIGNED WIDGET-ID 8
      820        f-timediff AT ROW 4.4 COL 2 WIDGET-ID 4
      821        SPACE(0.39) SKIP(0.52)
      822       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      823            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      824            TITLE "Выгрузка данных ПМ в 1С"
      825            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      826   ASSIGN
      827          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      828          FRAME Dialog-Frame:HIDDEN           = TRUE.
      829   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      830   DO:
      831     APPLY "END-ERROR":U TO SELF.
      832   END.
      833   ON CHOOSE OF b-date1 IN FRAME Dialog-Frame
      834   DO:
      835     run sel-date in this-procedure
      836       (input f-rep-date1 :handle
      837       ,input ""
      838       ) .
      839   END.
      840   ON CHOOSE OF b-date2 IN FRAME Dialog-Frame
      841   DO:
      842     run sel-date in this-procedure
      843       (input f-rep-date2 :handle
      844       ,input ""
      845       ) .
      846   END.
      847   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      848   DO:
      849     assign
      850       f-rep-date1
      851       f-rep-date2
      852       f-timediff
      853     .
      854     if f-rep-date1 > f-rep-date2
      855     or f-rep-date1 > today
      856     then do :
      857       message "Даты введены неверно!" view-as alert-box .
      858       return no-apply .
      859     end .
      860     run waitfram-show in this-procedure ( input "Ждите..." ).
      861     curr-exec-date = f-rep-date1 .
      862     do while curr-exec-date <= f-rep-date2 :
      863       run waitfram-show in this-procedure ( input ("Формирование данных за "  + string(curr-exec-date) )).
      864       is_PM = new is_PM (input v-cntxt-db-num,
      865                          input v-cntxt-obj-code,
      866                          input (string(f-timediff) + ",10,10"),
      867                          input parparentproc,
      868                          input this-procedure,
      869                          input curr-exec-date)
      870                         .
      871       is_PM:exec_1c() .
      872       run str/send1C-some-data.p (input parparentproc,
      873                                   input this-procedure,
      874                                   input parparentproc,
      875                                   input is_PM:Data,
      876                                   input "operating-balances")
      877                                   no-error .
      878       if error-status:error
      879       then do :
      880         delete object is_PM .
      881         run write-to-log( "Ошибка при отправке в 1С данных за " + string(curr-exec-date) + ".   " + return-value ).
      882         curr-exec-date = curr-exec-date + 1 .
      883       end .
      884       delete object is_PM .
      885       curr-exec-date = curr-exec-date + 1 .
      886     end .
      887     run waitfram-hide in this-procedure.
      888     message "Данные для 1С успешно сформированы" view-as alert-box .
      889   END.
