     1187       then do:
     1188         apply "entry":u to self .
     1189       end.
     1190       define variable v-curr-sv-date as date no-undo .
     1191       define variable v-new-sv-date  as date no-undo .
     1192       assign
     1193         v-curr-sv-date = date(self :screen-value) no-error
     1194       .
     1195       if v-curr-sv-date = ?
     1196       then do:
     1197         run gbl/getcurdt.p
     1198           (output v-curr-sv-date
     1199           ) .
     1200       end.
     1201       if v-curr-sv-date <> ?
     1202       then do:
     1203         assign
     1204           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1205         .
     1206         assign
     1207           self :screen-value = string(v-new-sv-date) .
     1208         .
     1209       end.
     1210     end.
     1211     return no-apply .
     1212   end.
     1213   on ctrl-e of f-rep-date2 in frame Dialog-Frame
     1214   do:
     1215     if (can-query (self, "sensitive")
     1216        and
     1217        self :sensitive = true
     1218        )
     1219     or (can-query (self, "read-only")
     1220        and
     1221        self :read-only = false
     1222        )
     1223     then do:
     1224       if self :handle <> focus :handle
     1225       then do:
     1226         apply "entry":u to self .
     1227       end.
     1228       define variable v-curr-sv-date as date no-undo .
     1229       define variable v-new-sv-date  as date no-undo .
     1230       assign
     1231         v-curr-sv-date = date(self :screen-value) no-error
     1232       .
     1233       if v-curr-sv-date = ?
     1234       then do:
     1235         run gbl/getcurdt.p
     1236           (output v-curr-sv-date
     1237           ) .
     1238       end.
     1239       if v-curr-sv-date <> ?
     1240       then do:
     1241         run gbl/lastdate.p
     1242           (input  v-curr-sv-date
     1243           ,output v-new-sv-date
     1244           ).
     1245         assign
     1246           self :screen-value = string(v-new-sv-date) .
     1247         .
     1248       end.
     1249     end.
     1250     return no-apply .
     1251   end.
     1252   on ctrl-f of f-rep-date2 in frame Dialog-Frame
     1253   do:
     1254     if (can-query (self, "sensitive")
     1255        and
     1256        self :sensitive = true
     1257        )
     1258     or (can-query (self, "read-only")
     1259        and
     1260        self :read-only = false
     1261        )
     1262     then do:
     1263       if self :handle <> focus :handle
     1264       then do:
     1265         apply "entry":u to self .
     1266       end.
     1267       define variable v-ok            as logical   no-undo .
     1268       define variable v-curr-sv-date  as date      no-undo .
     1269       define variable v-description   as character no-undo .
     1270       assign
     1271         v-curr-sv-date = date(self :screen-value) no-error
     1272       .
     1273       if v-curr-sv-date = ?
     1274       then do:
     1275         run gbl/getcurdt.p
     1276           (output v-curr-sv-date
     1277           ) .
     1278       end.
     1279       if v-curr-sv-date <> ?
     1280       then do:
     1281         run gbl/d-inpday.w
     1282           (input ?
     1283           ,input "Выбор даты"
     1284           ,input v-description
     1285           ,input ""
     1286           ,input-output v-curr-sv-date
     1287           ,output v-ok
     1288           ).
     1289         if v-ok = true
     1290         then do:
     1291           assign
     1292             self :screen-value = string(v-curr-sv-date) .
     1293           .
     1294         end.
     1295       end.
     1296     end.
     1297     return no-apply .
     1298   end.
     1299     define MENU m-ed-date9
     1300       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1301       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1302       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1303       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1304       .
     1305     if f-rep-date2 :POPUP-MENU in frame Dialog-Frame = ?
     1306     then do:
     1307       ASSIGN
     1308         f-rep-date2 :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
     1309         f-rep-date2 :MENU-MOUSE in frame Dialog-Frame = 3
     1310       .
     1311     end.
     1312     define variable v-label-handle9 as handle no-undo .
     1313     assign
     1314       v-label-handle9 = f-rep-date2 :side-label-handle in frame Dialog-Frame
     1315     .
     1316     if valid-handle (v-label-handle9)
     1317     then do:
     1318       if v-label-handle9 :tooltip = ""
     1319       or v-label-handle9 :tooltip = ?
     1320       then do:
     1321         assign
     1322           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1323         .
     1324       end.
     1325     end.
     1326     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1327       apply "ctrl-b":U to f-rep-date2 in frame Dialog-Frame .
     1328     END.
     1329     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1330       apply "ctrl-d":U to f-rep-date2 in frame Dialog-Frame .
     1331     END.
     1332     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1333       apply "ctrl-e":U to f-rep-date2 in frame Dialog-Frame .
     1334     END.
     1335     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1336       apply "ctrl-f":U to f-rep-date2 in frame Dialog-Frame .
     1337     END.
     1338   MAIN-BLOCK:
     1339   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1340      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1341   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1342     run mainmenu_getcntxt in parparentproc
     1343       (output v-cntxt-db-num
     1344       ,output v-cntxt-userid
     1345       ,output v-cntxt-level
     1346       ,output v-cntxt-host-code-obj
     1347       ,output v-cntxt-obj-type
     1348       ,output v-cntxt-obj-code
     1349       ,output v-cntxt-db-num-obj
     1350       ,output v-cntxt-is-admin
     1351       ) .
     1352     run GetCurrentProcessID (output v-pid) .
     1353     f-timediff = (timezone - 180) / 60 .
     1354     f-rep-date1 = today - 1 .
     1355     f-rep-date2 = today - 1 .
     1356     RUN enable_UI.
     1357     WAIT-FOR GO OF FRAME Dialog-Frame.
     1358   END.
     1359   RUN disable_UI.
     1360   procedure write-to-log :
     1361     define input param p-str as character no-undo .
     1362     assign
     1363       p-str = substitute( "&1 (pid: &2) &3 &4&5", g#userid, v-pid, cur-time-string-sec(), p-str, chr(10) )
     1364     .
     1365     output to value(log-file-name) append .
     1366     put unformatted p-str .
     1367     output close .
     1368   end procedure .
     1369   PROCEDURE write-log-and-file :
     1370     define input parameter p-tab-position   as integer   no-undo.
     1371     define input parameter p-file-name      as character no-undo .
     1372     define input parameter p-log-level      as integer   no-undo .
     1373     define input parameter p-log-string     AS CHARacter NO-UNDO.
     1374     define variable v-jj as integer   no-undo .
     1375     run write-to-log (input p-log-string) .
     1376   end procedure .
     1377   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll" :
     1378     DEFINE RETURN PARAMETER RetVal          AS LONG.
     1379   END PROCEDURE.
     1380   PROCEDURE disable_UI :
     1381     HIDE FRAME Dialog-Frame.
     1382   END PROCEDURE.
     1383   PROCEDURE enable_UI :
     1384     DISPLAY f-rep-date1  f-rep-date2 f-timediff
     1385         WITH FRAME Dialog-Frame.
     1386     ENABLE b-ok b-cancel b-date1 b-date2 f-rep-date1  f-rep-date2 f-timediff
     1387         WITH FRAME Dialog-Frame.
     1388     VIEW FRAME Dialog-Frame.
     1389   END PROCEDURE.
