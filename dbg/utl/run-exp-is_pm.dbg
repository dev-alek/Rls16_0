        1   using ibs.th.bge.is_PM.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable log-file-name     as character no-undo initial "OB-to-PM.log" .
        4   define variable is_PM         as class is_PM no-undo .
        5   define variable curr-exec-date as date no-undo .
        6   define variable v-pid as int64 no-undo .
        7   define new global shared variable g#language as character no-undo .
        8   if g#language <> '' and g#language <> 'rus':U then do:
        9     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       10   end.
       11   define new global shared variable g#library  as handle no-undo .
       12   define new global shared variable g#library2 as handle no-undo .
       13   define   shared variable g#auto as logical no-undo.
       14   define   shared variable g#news as logical no-undo.
       15   define   shared variable g#oxml as logical no-undo.
       16   define   shared variable g#esys as logical no-undo.
       17   define   shared variable g#news-source-db as integer no-undo.
       18   define   shared variable g#esys-source-esys as integer no-undo.
       19   define   shared variable g#db-num as integer   no-undo .
       20   define   shared variable g#userid as character no-undo .
       21   define   shared variable g#passwd as character no-undo .
       22   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       23   procedure sel-date :
       24     define input  parameter p-date-handle as handle    no-undo .
       25     define input  parameter p-description as character no-undo .
       26     do
       27     on error undo, return error return-value
       28     :
       29       if (can-query (p-date-handle, "sensitive")
       30         and
       31         p-date-handle :sensitive = true
       32         )
       33       or (can-query (p-date-handle, "read-only")
       34         and
       35         p-date-handle :read-only = false
       36         )
       37       then do:
       38         if p-date-handle :handle <> focus :handle
       39         then do:
       40           apply "entry":u to p-date-handle .
       41         end.
       42         define variable v-ok            as logical no-undo .
       43         define variable v-curr-sv-date as date no-undo .
       44         assign
       45           v-curr-sv-date = date(p-date-handle :screen-value) no-error
       46         .
       47         if v-curr-sv-date = ?
       48         then do:
       49           run gbl/getcurdt.p
       50             (output v-curr-sv-date
       51             ) .
       52         end.
       53         if v-curr-sv-date <> ?
       54         then do:
       55           run gbl/d-inpday.w
       56             (input ?
       57             ,input "Выбор даты"
       58             ,input p-description
       59             ,input ""
       60             ,input-output v-curr-sv-date
       61             ,output v-ok
       62             ).
       63           if v-ok = true
       64           then do:
       65             assign
       66               p-date-handle :screen-value = string(v-curr-sv-date) .
       67             .
       68           end.
       69         end.
       70       end.
       71     end.
       72   end procedure.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define variable v-waitfram-action01         as character   no-undo .
      120   define variable v-waitfram-action02         as character   no-undo .
      121   define variable v-waitfram-action03         as character   no-undo .
      122   define variable mWaitFramTextBeg            as character   no-undo.
      123   define variable mWaitFramTextEnd            as character   no-undo.
      124   define variable mWaitFramView               as logical     no-undo.
      125   define variable mWaitProcEvent              as logical     no-undo init yes.
      126   define variable mWaitFramInterval           as integer     no-undo init 1 .
      127   define variable mWaitFramStop               as logical     no-undo.
      128   define variable mWaitFramStopUser           as logical     no-undo.
      129   define variable mWaitFramStopTimeOut        as logical     no-undo.
      130   define variable mWaitFramStartProc          as datetime-tz no-undo.
      131   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      132   define button B-WaitFramStop auto-end-key
      133        label "Стоп"
      134        size 10 by 1 tooltip "Остоновить процесс".
      135   define button B-viewProcInfo
      136        label "Информация"
      137        size 15 by 1 tooltip "Информация о процесс".
      138   define frame waitfram
      139     v-waitfram-action01 format "x(72)" no-label skip
      140     v-waitfram-action02 format "x(72)" no-label skip
      141     v-waitfram-action03 format "x(72)" no-label skip
      142     B-viewProcInfo
      143     B-WaitFramStop at row 4 col 30
      144     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      145     .
      146   define new global shared variable mBatchMode as logical no-undo init ?.
      147   define variable mFramBachModHandle as handle no-undo.
      148   mFramBachModHandle = frame waitfram:handle.
      149   define variable mFameOldVis as logical no-undo.
      150   define variable mVisCUrentVin as logical no-undo.
      151   if session:batch-mode
      152   then
      153      mBatchMode = yes.
      154   if mBatchMode = ? then do:
      155     mVisCUrentVin = current-window:visible.
      156     mFameOldVis = mFramBachModHandle:visible.
      157     mFramBachModHandle:visible  = yes.
      158     mBatchMode = mFramBachModHandle:visible ne yes.
      159     mFramBachModHandle:visible = mFameOldVis.
      160     current-window:visible = mVisCUrentVin.
      161   end.
      162    if  log-manager:logfile-name ne ?
      163     then DO:
      164         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      165         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      166         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      167     end.
      168   on choose of B-WaitFramStop in frame waitfram
      169   do:
      170     mWaitFramStop = yes.
      171     mWaitFramStopUser = yes.
      172   end.
      173   function waitfram-check-timeout returns logical():
      174      define variable vtime as int64 no-undo.
      175      if mWaitFramStopTimeOut
      176      then
      177         return yes.
      178      vtime = ( now - mWaitFramStartProc ) / 1000 .
      179      if     mWaitFramTimeOut ne ?
      180         and mWaitFramTimeOut ne 0
      181         and mWaitFramTimeOut lt vtime
      182      then do:
      183         mWaitFramStopTimeOut = yes.
      184      end.
      185      return mWaitFramStopTimeOut.
      186   end.
      187   procedure waitfram-hide :
      188     if not session:batch-mode
      189     then do
      190     on error undo, return error return-value
      191     :
      192       pause 0 before-hide .
      193       if not mBatchMode then
      194         hide frame waitfram .
      195     if     not mWaitFramView
      196        and mWaitProcEvent
      197     then
      198       process events .
      199     end.
      200   end procedure.
      201   procedure waitfram-show :
      202     define input  parameter p-message as character no-undo .
      203     define variable v-left-margin as integer   no-undo .
      204     if not session:batch-mode
      205     then do
      206     on error undo, return error return-value
      207     :
      208       if length(p-message) <= 70 then do:
      209         assign
      210           v-left-margin = integer((70 - length(p-message)) / 2)
      211         .
      212         assign
      213           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      214         .
      215         assign
      216           v-waitfram-action01 = " "
      217           v-waitfram-action02 = " "
      218                                    + fill(" ", v-left-margin)
      219                                    + p-message
      220           v-waitfram-action03 = " "
      221         .
      222       end.
      223       else do:
      224         define variable vRindex1 as integer no-undo.
      225         define variable vRindex2 as integer no-undo.
      226         vRindex1 = r-index(p-message," ",70).
      227         if vRindex1 = 0
      228         then
      229            vRindex1 = 70.
      230         if length(p-message)  <= vRindex1 + 70 then do:
      231           assign
      232             v-waitfram-action01 = " "
      233             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      234             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      235           .
      236         end.
      237         else do:
      238           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      239           if vRindex2 <= vRindex1
      240           then
      241              vRindex2 = vRindex1 + 70.
      242           assign
      243             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      244             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      245             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      246           .
      247         end.
      248       end.
      249       B-viewProcInfo:visible   in frame waitfram = no.
      250       B-viewProcInfo:sensitive in frame waitfram = no.
      251       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      252       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      253       if  (   mWaitFramView
      254          or  mWaitProcEvent)
      255          and not mBatchMode
      256       then
      257          display
      258             v-waitfram-action01 skip
      259             v-waitfram-action02 skip
      260             v-waitfram-action03 skip
      261          with frame waitfram .
      262       if     mWaitFramView
      263          then do:
      264             if     mWaitFramInterval ne ?
      265                and not mBatchMode
      266             then
      267                wait-for go of frame waitfram pause mWaitFramInterval.
      268          end.
      269          else
      270             if     mWaitProcEvent
      271                and not mBatchMode
      272             then
      273                process events .
      274     end.
      275   end procedure.
      276      procedure waitfram-show-this:
      277         define input  parameter iInterval as int64 no-undo.
      278         define variable vtime as int64 no-undo.
      279         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      280         mWaitFramInterval = iInterval.
      281         run waitfram-show (substitute("&1&2 &3&4" ,
      282                                       mWaitFramTextBeg ,
      283                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      284                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      285                                       mWaitFramTextEnd
      286                                      )
      287                           ).
      288      end.
      289      procedure WaitFramRunPause:
      290         define input  parameter iInterval as dec no-undo.
      291         define variable vStart  as datetime-tz no-undo.
      292         define variable vend    as datetime-tz no-undo.
      293         define variable vint as int64 no-undo.
      294         define variable vOk as logical no-undo.
      295         vStart = now.
      296         vend   = vStart.
      297         publish "WaitFramPause" (iInterval,output vOk).
      298         vend   =  now.
      299         vint = vend - vStart.
      300         vint = iInterval - vint / 1000.
      301         if     not mWaitFramStop
      302            and (   vint > 0
      303                 or (    not vOk
      304                     and iInterval eq ?
      305                     )
      306                 )
      307         then
      308            run waitfram-show-this (iInterval).
      309         vend   =  now.
      310         vint = vend - vStart.
      311         vint = iInterval - vint / 1000.
      312         if     not mWaitFramStop
      313            and vint > 0
      314         then do:
      315            run gbl/pause.p (vint * 1000).
      316         end.
      317         if iInterval ne ?
      318         then
      319            publish "WaitFramStop".
      320         waitfram-check-timeout().
      321      end.
      322      procedure WaitFramWaitFor:
      323         define input  parameter iInterval as dec no-undo.
      324         assign
      325            mWaitFramStartProc   = now
      326            mWaitFramStopUser    = no
      327            mWaitFramStopTimeOut = no
      328         .
      329         block-wait:
      330         do while not mWaitFramStop:
      331            run WaitFramRunPause (iInterval).
      332            if  waitfram-check-timeout()
      333            then do:
      334               leave block-wait.
      335            end.
      336         end.
      337         run waitfram-hide.
      338      end.
      339   procedure waitfram-join :
      340     define input  parameter p-line-1  as character no-undo .
      341     define input  parameter p-line-2  as character no-undo .
      342     define input  parameter p-line-3  as character no-undo .
      343     define output parameter p-message as character no-undo .
      344     do
      345     on error undo, return error return-value
      346     :
      347       assign
      348         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      349                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      350                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      351       .
      352     end.
      353   end procedure.
      354   function waitfram-join-function returns character
      355     (input p-line-1 as character
      356     ,input p-line-2 as character
      357     ,input p-line-3 as character
      358     ).
      359     define variable v-message as character no-undo .
      360     run waitfram-join in this-procedure
      361       (input  p-line-1
      362       ,input  p-line-2
      363       ,input  p-line-3
      364       ,output v-message
      365       ) .
      366     return v-message .
      367   end function .
      368   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   define  stream PrnLibStream.
      370   procedure prn-lib-prn-file :
      371     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      372     define input parameter p-DIsabledoptions as integer no-undo .
      373     define variable v-report-name as character no-undo .
      374     define variable v-user-action as character no-undo .
      375     define variable v-printed     as logical   no-undo .
      376     define variable v-exist       as logical   no-undo .
      377     do
      378       on error undo, return error
      379       :
      380       run prn-lib-get-report-name  in this-procedure (
      381         input parParentProc
      382         ,output v-report-name
      383         ).
      384   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      386     (input  v-report-name
      387     ,input  2
      388     ,output v-exist
      389     )  .
      390       if NOT v-exist then
      391       DO:
      392         Message
      393           "Нет заданий на печать ! "
      394           view-as alert-box .
      395         Return  .
      396       End.
      397       run gbl/prnfilen.w
      398         (input  ""
      399         ,input  p-DisabledOptions
      400         ,input  string(v-report-name )
      401         ,input  7
      402         ,output v-user-action
      403         ,output v-printed
      404         ) .
      405       if v-printed then
      406       do:
      407         return "YES" .
      408       end.
      409       else
      410       do:
      411         return "NO" .
      412       end.
      413     end.
      414   end procedure.
      415   procedure prn-lib-open-stream :
      416     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      417     define input parameter p-page-size    as integer no-undo .
      418     define input parameter p-is-stream    as logical no-undo .
      419     define input parameter p-append       as logical no-undo .
      420     define variable v-report-name as character no-undo .
      421     do
      422       on error undo, return error
      423       :
      424       run prn-lib-get-report-name  in this-procedure (
      425         input parParentProc
      426         ,output v-report-name
      427         ).
      428       if p-is-stream then
      429       do:
      430         if p-append then
      431         do:
      432           output stream PrnLibStream to value( v-report-name )
      433             page-size value(p-page-size) append .
      434         end.
      435         if not p-append then
      436         do:
      437           output stream PrnLibStream to value( v-report-name )
      438             page-size value(p-page-size) .
      439         end.
      440       end.
      441       if not p-is-stream then
      442       do:
      443         if p-append then
      444         do:
      445           output to value( v-report-name )
      446             page-size value(p-page-size) append .
      447         end.
      448         if not p-append then
      449         do:
      450           output to value( v-report-name )
      451             page-size value(p-page-size) .
      452         end.
      453       end.
      454     end.
      455   end procedure.
      456   procedure prn-lib-open-exp :
      457     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      458     define input parameter p-is-stream    as logical no-undo .
      459     define input parameter p-is-append    as logical no-undo .
      460     define output parameter p-ReportFileName as char init "report" no-undo.
      461     define output parameter p-process as logical no-undo .
      462     define variable glog as logical no-undo .
      463     do
      464       on error undo, return error
      465       :
      466       SYSTEM-DIALOG GET-FILE p-ReportFileName
      467         TITLE      "Укажите путь"
      468         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      469         ASK-OVERWRITE
      470         CREATE-TEST-FILE
      471         SAVE-AS
      472         USE-FILENAME
      473         DEFAULT-EXTENSION "txt"
      474         UPDATE glog
      475         .
      476       if not glog then  return.
      477       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      478       if p-is-stream then
      479       do:
      480         if p-is-append then
      481         do:
      482           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      483         end.
      484         else
      485         do:
      486           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      487         end.
      488       end.
      489       else
      490       do:
      491         if p-is-append then
      492         do:
      493           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      494         end.
      495         else
      496         do:
      497           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      498         end.
      499       end.
      500       p-process = yes.
      501     end.
      502   end procedure.
      503   procedure prn-lib-get-report-name :
      504     define input parameter parParentProc  as widget-handle no-undo.
      505     define output parameter p-report-name as character no-undo .
      506     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      507   end procedure.
      508   procedure prn-lib-reportviewer-report-name :
      509     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      510     define input parameter p-report-name-html as character no-undo .
      511     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      512   end procedure.
      513   procedure prn-lib-reportviewer :
      514     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      515     define input parameter p-report-name-html as character no-undo .
      516     define input parameter p-param        as character no-undo .
      517     define variable v-excel           as character no-undo init 'TRUE' .
      518     define variable v-value-character as character no-undo .
      519     define variable v-value-integer   as character no-undo .
      520     define variable v-value-date      as date      no-undo .
      521     define variable v-value-decimal   as decimal   no-undo .
      522     define variable rep-excel         as logical   no-undo .
      523     define variable excel-string      as character no-undo .
      524     define variable v-param-type      as character no-undo .
      525     define variable v-tth             as handle    no-undo .
      526     run adm/shattri.p (
      527       input "get":U
      528       ,input  ""
      529       ,input  0
      530       ,input  'report-glob':U
      531       ,input  'rep-excel':U
      532       ,output v-value-character
      533       ,output v-value-date
      534       ,output v-value-decimal
      535       ,output v-value-integer
      536       ,output rep-excel
      537       ,output v-param-type
      538       ,INPUT-OUTPUT table-handle v-tth
      539       )  .
      540     if rep-excel then v-excel = "TRUE" .
      541     else v-excel = "FALSE" .
      542     if p-param eq ""
      543     then
      544        p-param = "EXCEL:" + v-excel.
      545     else
      546        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      547     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      548   end procedure.
      549   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      550     define variable v-cntxt-db-num        as integer   no-undo .
      551     define variable v-cntxt-userid        as character no-undo .
      552     define variable v-cntxt-level         as character no-undo .
      553     define variable v-cntxt-host-code-obj as integer   no-undo .
      554     define variable v-cntxt-obj-type      as character no-undo .
      555     define variable v-cntxt-obj-code      as integer   no-undo .
      556     define variable v-cntxt-db-num-obj    as integer   no-undo .
      557     define variable v-cntxt-is-admin      as logical   no-undo .
      558   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      559   procedure cur-time :
      560      define output parameter p-today as date      no-undo .
      561      define output parameter p-time  as integer   no-undo .
      562     do
      563     on error undo, return error
      564     :
      565       define variable v-date1 as date      no-undo .
      566       define variable v-date2 as date      no-undo .
      567       define variable v-time  as integer   no-undo .
      568       assign
      569         v-date1 = today
      570         v-time  = time
      571         v-date2 = today
      572       .
      573       if v-date1 <> v-date2
      574       then do:
      575         assign
      576           v-date1 = today
      577           v-time  = v-time
      578         .
      579       end.
      580       assign
      581         p-today = v-date1
      582         p-time  = v-time
      583       .
      584     end.
      585   end.
      586   function cur-time-date returns character
      587   :
      588     return string(today, '99/99/9999':U) .
      589   end.
      590   function cur-time-mjd returns decimal
      591   :
      592     define variable v-date as date      no-undo .
      593     define variable v-time as integer   no-undo .
      594     run cur-time in this-procedure
      595       (output v-date
      596       ,output v-time
      597       ) .
      598     return integer(v-date) - 2400002 + (v-time / 86400) .
      599   end.
      600   function cur-time-get-ending-index returns integer
      601   (input p-number as integer
      602   )
      603   :
      604     if p-number < 0
      605     or p-number = ?
      606     then do:
      607       return 1 .
      608     end.
      609     define variable v-rest as integer   no-undo .
      610     assign
      611       p-number = p-number modulo 100
      612     .
      613     if p-number < 20
      614     then do:
      615       assign
      616         v-rest = p-number
      617       .
      618     end.
      619     else do:
      620       assign
      621         v-rest = p-number modulo 10
      622       .
      623     end.
      624     case v-rest :
      625       when 1
      626       then do:
      627         return 2 .
      628       end.
      629       when 2 or
      630       when 3 or
      631       when 4
      632       then do:
      633         return 3 .
      634       end.
      635       otherwise do:
      636         return 1 .
      637       end.
      638     end case .
      639   end.
      640   procedure cur-time-mjd-to-date :
      641      define input  parameter i-mjd-diff as decimal no-undo.
      642      define output parameter o-Date     as date    no-undo.
      643      define output parameter o-Time     as integer no-undo.
      644      define variable v-day-number as integer   no-undo .
      645      if    i-mjd-diff < 0
      646         or i-mjd-diff = ?
      647      then do:
      648         return "?" .
      649      end.
      650      assign
      651         v-day-number = truncate(i-mjd-diff,0).
      652         o-Date = date(v-day-number + 2400002).
      653         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      654     .
      655   end.
      656   function cur-time-mjd-to-string returns character
      657   (input p-mjd-diff as decimal
      658   )
      659   :
      660     define variable v-day-number as integer   no-undo .
      661     define variable v-seconds    as integer   no-undo .
      662     define variable v-hour       as integer   no-undo .
      663     define variable v-min        as integer   no-undo .
      664     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      665     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      666     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      667     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      668     if p-mjd-diff < 0
      669     or p-mjd-diff = ?
      670     then do:
      671       return "?" .
      672     end.
      673     assign
      674       v-day-number = integer(truncate(p-mjd-diff,0))
      675       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      676     .
      677     if v-seconds > 86400
      678     then do:
      679       assign
      680         v-seconds = 86400 - 1
      681       .
      682     end.
      683     if v-seconds < 0
      684     then do:
      685       assign
      686         v-seconds = 0
      687       .
      688     end.
      689     assign
      690       v-hour = truncate(v-seconds / 3600, 0)
      691     .
      692     assign
      693       v-seconds = v-seconds modulo 3600
      694     .
      695     assign
      696       v-min = truncate(v-seconds / 60, 0)
      697     .
      698     assign
      699       v-seconds = v-seconds modulo 60
      700     .
      701     return
      702         (if v-day-number <> 0
      703           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      704           else ""
      705         )
      706       + (if v-day-number <> 0 or v-hour <> 0
      707           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      708           else ""
      709         )
      710       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      711           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      712           else ""
      713         )
      714       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      715       .
      716   end.
      717   function cur-time-string returns character
      718   :
      719     define variable v-date as date      no-undo .
      720     define variable v-time as integer   no-undo .
      721     run cur-time in this-procedure
      722       (output v-date
      723       ,output v-time
      724       ) .
      725     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      726   end.
      727   function cur-time-string-sec returns character
      728   :
      729     define variable v-date as date      no-undo .
      730     define variable v-time as integer   no-undo .
      731     run cur-time in this-procedure
      732       (output v-date
      733       ,output v-time
      734       ) .
      735     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      736   end.
      737   function cur-time-custom  returns character
      738   (input p-prefix as character
      739   ,input p-date-format as character
      740   ,input p-delimiter as character
      741   ,input p-time-format as character
      742   ,input p-suffix as character
      743   )
      744   :
      745     define variable v-date as date      no-undo .
      746     define variable v-time as integer   no-undo .
      747     run cur-time in this-procedure
      748       (output v-date
      749       ,output v-time
      750       ) .
      751     return
      752       p-prefix
      753       + string(v-date, p-date-format)
      754       + p-delimiter
      755       + string(v-time, p-time-format)
      756       + p-suffix
      757       .
      758   end.
      759   function cur-time-print  returns character
      760   :
      761     define variable v-date as date      no-undo .
      762     define variable v-time as integer   no-undo .
      763     run cur-time in this-procedure
      764       (output v-date
      765       ,output v-time
      766       ) .
      767     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      768   end.
      769   function cur-time-datetime returns datetime
      770   :
      771     define variable v-char as character no-undo .
      772     define variable v-datetime as datetime no-undo .
      773     v-char = cur-time-string().
      774     v-datetime = datetime(v-char).
      775     return  v-datetime.
      776   end.
      777   function cur-time-string-msec returns character
      778   :
      779     define variable v-date as datetime  no-undo .
      780     v-date = now.
      781     return string(v-date) .
      782   end.
      783   DEFINE BUTTON b-cancel AUTO-END-KEY
      784        LABEL "Отмена"
      785        SIZE 15 BY 1.14
      786        BGCOLOR 8 .
      787   DEFINE BUTTON b-date1
      788        image-up          file "btn-down-arrow"
      789        image-down        file "btn-down-arrow"
      790        image-insensitive file "btn-down-arrow"
      791        size 3 by .88.
      792   DEFINE BUTTON b-date2
