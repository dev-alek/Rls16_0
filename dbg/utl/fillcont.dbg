      443        SIZE 10 BY 1
      444        BGCOLOR 8 .
      445   DEFINE BUTTON b-OK AUTO-GO
      446        LABEL "&Ввод ":L
      447        size 10 by 1.
      448   DEFINE BUTTON BUTTON-contr
      449        IMAGE-UP FILE "btn-down-arrow":U
      450        IMAGE-DOWN FILE "btn-down-arrow":U
      451        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      452        LABEL "2"
      453        SIZE 2.88 BY 1.
      454   DEFINE VARIABLE contr-code AS CHARACTER FORMAT "X(16)":U
      455        VIEW-AS FILL-IN
      456        SIZE 18.5 BY 1 NO-UNDO.
      457   DEFINE VARIABLE snum AS CHARACTER FORMAT "X(256)":U
      458        VIEW-AS FILL-IN
      459        SIZE 35 BY 1 NO-UNDO.
      460   DEFINE VARIABLE trn-doc-code AS CHARACTER FORMAT "X(15)":U
      461        LABEL "№"
      462        VIEW-AS FILL-IN
      463        SIZE 17.63 BY 1 NO-UNDO.
      464   DEFINE VARIABLE RADIO-contr AS INTEGER
      465        VIEW-AS RADIO-SET VERTICAL
      466        RADIO-BUTTONS
      467             "Вн. №", 1,
      468   "Номер", 2
      469        SIZE 10.5 BY 1.75 NO-UNDO.
      470   DEFINE VARIABLE RADIO-doc AS INTEGER
      471        VIEW-AS RADIO-SET VERTICAL
      472        RADIO-BUTTONS
      473             "Одна", 1,
      474   "Список", 2
      475        SIZE 11 BY 3.92 NO-UNDO.
      476   DEFINE RECTANGLE RECT-7
      477        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      478        SIZE 38.5 BY 4.75.
      479   DEFINE RECTANGLE RECT-8
      480        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      481        SIZE 38.5 BY 7.5.
      482   DEFINE VARIABLE SELECT-1 AS CHARACTER
      483        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      484        SIZE 19 BY 4.25 NO-UNDO.
      485   DEFINE FRAME Dialog-Frame
      486        b-OK at row 1 col 1
      487        b-exit at row 1 col 11
      488        B-Help AT ROW 1 COL 30.63
      489        RADIO-contr AT ROW 3.5 COL 3.5 NO-LABEL
      490        contr-code AT ROW 3.83 COL 13.5 COLON-ALIGNED NO-LABEL
      491        BUTTON-contr AT ROW 3.83 COL 35
      492        snum AT ROW 5.75 COL 1.5 COLON-ALIGNED NO-LABEL
      493        RADIO-doc AT ROW 8.71 COL 3.5 NO-LABEL
      494        trn-doc-code AT ROW 9 COL 16.38 COLON-ALIGNED
      495        SELECT-1 AT ROW 10.5 COL 17.13 NO-LABEL
      496        "Договор:" VIEW-AS TEXT
      497             SIZE 10 BY 1 AT ROW 2.5 COL 3
      498             FGCOLOR 4
      499        "Приходная накладная:" VIEW-AS TEXT
      500             SIZE 25 BY 1 AT ROW 7.75 COL 2.5
      501             FGCOLOR 4
      502        RECT-7 AT ROW 2.25 COL 2
      503        RECT-8 AT ROW 7.5 COL 2
      504        SPACE(9.50) SKIP(0.12)
      505       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      506            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      507            TITLE "Привязка партий и складских документов к договору".
      508   ASSIGN
      509          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      510          FRAME Dialog-Frame:HIDDEN           = TRUE.
      511   ASSIGN
      512          snum:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      513   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      514   DO:
      515     APPLY "END-ERROR":U TO SELF.
      516   END.
      517   ON CHOOSE OF b-OK IN FRAME Dialog-Frame
      518   DO:
      519     if list_num = "" then do:
      520       message  "Не выбраны документы!"  view-as alert-box.
      521       return no-apply .
      522     end.
      523     run proc-OK .
      524     message
      525       "Работа утилиты завершена"
      526       view-as alert-box.
      527   END.
      528   ON CHOOSE OF BUTTON-contr IN FRAME Dialog-Frame
      529   DO:
      530     DISABLE RADIO-doc WITH FRAME Dialog-Frame.
      531     run str/cont-all.w (input ParParentProc, input v-cntxt-host-code-obj, input "b-sel", input 'фирма':U, input ?,
      532                     input ?, input ?, input ?, input "current":u, input 'при':U, input-output contr-list).
      533     if contr-list <> "" then do:
      534       find first buf_contract no-lock where RECID(buf_contract) = int (contr-list) no-error .
      535       if available buf_contract then do:
      536         assign snum    = buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")  .
      537         if RADIO-contr = 1 then assign contr-code = string(buf_contract.contract-code) .
      538         else                    assign contr-code = buf_contract.contract-prn-code .
      539         ENABLE RADIO-doc WITH FRAME Dialog-Frame.
      540         find first buf_clients no-lock where buf_clients.obj-code = buf_contract.cli-code and buf_clients.obj-type = buf_contract.cli-type no-error .
      541   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cntpurch in g#library
      543     (input  buf_contract.contract-type
      544     ,output v-contract-purch-code
      545     )  .
      546         apply "VALUE-CHANGED" to RADIO-doc in frame Dialog-Frame.
      547       end.
      548       else assign  contr-code = ""   snum = "" .
      549     end.
      550     display contr-code snum with frame Dialog-Frame.
      551   END.
      552   ON LEAVE OF contr-code IN FRAME Dialog-Frame
      553   DO:
      554     assign contr-code RADIO-contr .
      555     run  FindRec in this-procedure  .
      556   END.
      557   ON RETURN OF contr-code IN FRAME Dialog-Frame
      558   DO:
      559     assign contr-code RADIO-contr .
      560     run FindRec in this-procedure .
      561   END.
      562   ON VALUE-CHANGED OF RADIO-contr IN FRAME Dialog-Frame
      563   DO:
      564     if trn-doc-code <> "" then apply "RETURN" to trn-doc-code in frame Dialog-Frame.
      565   END.
      566   ON VALUE-CHANGED OF RADIO-doc IN FRAME Dialog-Frame
      567   DO:
      568     if input frame Dialog-Frame radio-doc <> radio-doc then do:
      569       ASSIGN frame dialog-frame RADIO-doc .
      570       IF RADIO-doc = 1 THEN DO:
      571         ENABLE trn-doc-code WITH FRAME Dialog-Frame.
      572         DISABLE SELECT-1 WITH FRAME Dialog-Frame.
      573         apply "entry" to trn-doc-code in frame Dialog-Frame.
      574         return no-apply.
      575       END.
      576       ELSE DO:
      577         DISABLE trn-doc-code WITH FRAME Dialog-Frame.
      578         ENABLE SELECT-1 WITH FRAME Dialog-Frame.
      579         find first buf_clients no-lock where
      580               buf_clients.obj-code = buf_contract.cli-code and
      581               buf_clients.obj-type = buf_contract.cli-type no-error .
      582         assign
      583           doc-rec = recid(buf_clients)
      584           list-mode = "client-income":u
      585           list_num  = ""
      586           doc-list = ""
      587         .
      588         SELECT-1:LIST-ITEMS = list_num.
      589         run str/all-docs.w (
      590         input ParParentProc,
      591         input v-cntxt-host-code-obj,
      592         input ?,
      593         input ?,
      594         input "client-income":u,
      595         input ?,
      596         input ?,
      597         input ?,
      598         input ?,
      599         input "b-sel,b-mark",
      600         input 'ie':U,
      601         input no,
      602         input  doc-rec ,
      603         output doc-list).
      604         if doc-list <> "" then do:
      605           do ii = 1 to num-entries(doc-list):
      606             find first buf_trn-doc no-lock where RECID(buf_trn-doc) = integer(entry(ii, doc-list)) no-error.
      607             run CheckDoc no-error  .
      608             if error-status:error then return no-apply.
      609             if ii = 1 then assign list_num = buf_trn-doc.doc-code .
      610             else           assign list_num = list_num + "," + buf_trn-doc.doc-code .
      611           end.
      612           message "Проверка данных завершена, можно запустить утилиту." view-as alert-box.
      613         end.
      614         SELECT-1:LIST-ITEMS = list_num .
      615         return no-apply.
      616       END.
      617     end.
      618   END.
      619   ON LEAVE OF trn-doc-code IN FRAME Dialog-Frame
      620   DO:
      621     assign trn-doc-code.
      622     if trn-doc-code <> "" then run  FindDoc in this-procedure .
      623   END.
      624   ON RETURN OF trn-doc-code IN FRAME Dialog-Frame
      625   DO:
      626     assign trn-doc-code.
      627     if trn-doc-code <> "" then run FindDoc in this-procedure .
      628   END.
      629   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      630   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      631   MAIN-BLOCK:
      632   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      633      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      634   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   on help of frame Dialog-Frame
      636   do:
      637     run gbl/app_help.p
      638       (input this-procedure :file-name
      639       ,input ''
      640       ,input ?
      641       ) no-error.
      642     if error-status :error then do:
      643       message
      644         "Ошибка при вызове помощи"
      645         error-status :get-message(1)
      646         view-as alert-box .
      647     end.
      648   end.
      649   run minbtn-set in this-procedure .
      650   on choose of b-help in frame Dialog-Frame
      651   do:
      652     apply "help":u to frame Dialog-Frame .
      653   end.
      654   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      655   procedure minbtn-set :
      656       do
      657           on error undo, return error return-value
      658           :
      659           define variable ii              as integer       no-undo .
      660           define variable fh              as widget-handle no-undo .
      661           define variable hh              as widget-handle no-undo .
      662           define variable v-h             as handle        extent 4 no-undo .
      663           define variable v-name-button   as character     no-undo .
      664           define variable v-help-old-x    as decimal       no-undo .
      665           define variable v-help-old-y    as decimal       no-undo .
      666           define variable v-help-old-size as decimal       no-undo .
      667           define variable v-frame-width   as decimal       no-undo .
      668           define variable jj              as integer       no-undo .
      669           do
      670               on error undo, return error
      671               :
      672               assign
      673                   v-frame-width = frame Dialog-Frame:width - 0.3
      674                   fh            = frame Dialog-Frame:first-child
      675                   hh            = fh:first-child
      676                   ii            = 1
      677                   .
      678               do while valid-handle(hh):
      679                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      680                   do:
      681                       case lc(hh:name) :
      682                           when "b-help" then
      683                               do:
      684                                   hh:load-image-up("cmp/b-help.bmp":u) .
      685                                   hh:load-image-down("cmp/b-help.bmp":u) .
      686                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      687                                   hh:TOOLTIP = "Помощь" .
      688                                   v-help-old-x = hh:column .
      689                                   v-help-old-y = hh:row    .
      690                                   v-help-old-size = hh:width .
      691                                   hh:width-chars = 2.5 .
      692                               end.
      693                           when "b-print" then
      694                               do:
      695                                   hh:load-image("cmp/b-print.bmp":u) .
      696                                   hh:TOOLTIP = "Печать" .
      697                                   v-h[ii] = hh:handle .
      698                                   ii = ii + 1 .
      699                                   hh:width-chars = 3 .
      700                               end.
      701                           when "b-history" or
      702                           when "b-hist" then
      703                               do:
      704                                   hh:load-image("cmp/b-hist.bmp":u) .
      705                                   hh:TOOLTIP = "История" .
      706                                   v-h[ii] = hh:handle .
      707                                   ii = ii + 1 .
      708                                   hh:width-chars = 3 .
      709                               end.
      710                           when "b-sch" then
      711                               do:
      712                                   hh:load-image("cmp/b-sch.bmp":u) .
      713                                   hh:TOOLTIP = "Установка Фильтра" .
      714                                   v-h[ii] = hh:handle .
      715                                   ii = ii + 1 .
      716                                   hh:width-chars = 3 .
      717                               end.
      718                           when "b-hist-user" then
      719                               do:
      720                                   hh:load-image("cmp/b-hist.bmp":u) .
      721                                   hh:TOOLTIP = "История пользователя" .
      722                                   ii = ii + 1 .
      723                               end.
      724                       end case.
      725                   end.
      726                   hh = hh:next-sibling.
      727               end.
      728               b-help:column = v-frame-width - b-help:width-chars.
      729               jj = 0.
      730               repeat ii = 4 to 1 by -1 :
      731                   if valid-handle (v-h[ii] ) then
      732                   do:
      733                       jj  = jj + 1 .
      734                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      735                       v-h[ii]:row    = v-help-old-y .
      736                   end.
      737               end.
      738           end.
      739       end.
      740   end procedure.
      741     define variable num-db as integer   no-undo .
      742   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      744     (output num-db
      745     )  .
      746     if num-db <> 0 then do:
      747       message  "Данная утилита предназначена для работы только в главной БД"  view-as alert-box.
      748       return no-apply .
      749     end.
      750     RUN enable_UI.
      751     WAIT-FOR GO OF FRAME Dialog-Frame.
      752   END.
      753   RUN disable_UI.
      754   PROCEDURE CheckDoc :
      755   define variable p-status       as integer   no-undo .
      756   define variable p-cut-date     as date      no-undo .
      757   define variable p-cut-fin-date as date      no-undo .
      758   do on error undo, return error return-value :
      759       if buf_contract.cli-code <> buf_trn-doc.cli-code or buf_contract.cli-type <> buf_trn-doc.cli-type then do:
      760         message "Поставщик в накладной " buf_trn-doc.doc-code " не совпал с поставщиком в договоре!" view-as alert-box.
      761         return error.
      762       end.
      763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cutd-obj in g#library
      764     (input  buf_trn-doc.obj-type
      765     ,input  buf_trn-doc.obj-code
      766     ,output p-status
      767     ,output p-cut-date
      768     ,output p-cut-fin-date
      769     )  .
      770       if p-cut-date <> ? then do:
      771         message "Документ " buf_trn-doc.doc-code " по объекту " buf_trn-doc.obj-type " " buf_trn-doc.obj-code " . На объекте было обрезание документов. Перепривязка партий и пересчет архивов невозможен." view-as alert-box.
      772         return error.
      773       end.
      774       if buf_contract.curr-code <> buf_trn-doc.exch-code then do:
      775         message "Валюта в накладной " buf_trn-doc.doc-code " не совпала с валютой договора!" view-as alert-box.
      776         return error.
      777       end.
      778       run CheckParts (input buf_trn-doc.doc-code) no-error .
      779       if error-status:error then return error.
      780     end.
      781   end procedure.
      782   PROCEDURE CheckParts :
      783   define input  parameter num as character no-undo .
      784     do on error undo, return error return-value :
      785       for each buf_parts-attr no-lock where buf_parts-attr.in-code = num :
      786         if v-contract-purch-code <> buf_parts-attr.purch-code then do:
      787           message
      788             "Не совпали тип приобретения у партии (in-code=" num " gds-code=" buf_parts-attr.gds-code "
      789             part-code=" buf_parts-attr.part-code "тип=" string(buf_parts-attr.purch-code) ") и у договора (тип=" v-contract-purch-code ")"
      790           view-as alert-box.
      791           return error .
      792         end.
      793       end.
      794       for each buf_parts no-lock where buf_parts.out-code = num :
      795         if v-contract-purch-code <> buf_parts.purch-code then do:
      796           message
      797             "Не совпали тип приобретения у партии (
      798               in-code=" num
      799             " artic=" buf_parts.artic
      800             " prod-code=" buf_parts.prod-code
      801             " prod-type=" buf_parts.prod-type
      802             " part-code=" buf_parts.part-code "тип=" string(buf_parts.purch-code) ") и у договора (тип=" v-contract-purch-code ")"
      803           view-as alert-box.
      804           return error .
      805         end.
      806       end.
      807     end.
      808   end procedure.
      809   PROCEDURE disable_UI :
      810     HIDE FRAME Dialog-Frame.
      811   END PROCEDURE.
      812   PROCEDURE enable_UI :
      813     DISPLAY RADIO-contr contr-code snum RADIO-doc trn-doc-code SELECT-1
      814         WITH FRAME Dialog-Frame.
      815     ENABLE b-OK b-exit B-Help RECT-7 RECT-8 RADIO-contr contr-code BUTTON-contr
      816         WITH FRAME Dialog-Frame.
      817     VIEW FRAME Dialog-Frame.
      818   END PROCEDURE.
      819   PROCEDURE FindDoc :
      820   do on error undo, return error return-value :
      821       assign list_num = "" .
      822       find first buf_parts-attr no-lock where buf_parts-attr.in-code = trn-doc-code no-error .
      823       find first buf_parts no-lock where buf_parts.out-code = trn-doc-code no-error .
      824       if not available buf_parts-attr and  not available buf_parts then do:
      825         message
      826          "Следов документа " trn-doc-code "не найдено!"
      827         view-as alert-box.
      828         assign RADIO-doc = 2 .
      829         display RADIO-doc with frame Dialog-Frame.
      830         apply "VALUE-CHANGED" to RADIO-doc in frame Dialog-Frame.
      831         return no-apply .
      832       end.
      833       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = trn-doc-code no-error .
      834       if available buf_trn-doc then do:
      835         run CheckDoc no-error .
      836         if error-status:error then return no-apply.
      837       end.
      838       else do:
      839         run CheckParts (input trn-doc-code) no-error .
      840         if error-status:error then return no-apply.
      841       end.
      842       assign list_num = trn-doc-code .
      843       message
      844         "Проверка данных завершена, можно запустить утилиту."
      845         view-as alert-box.
      846     end.
      847   end procedure.
      848   PROCEDURE FindRec :
      849   do on error undo, return error return-value :
      850       DISABLE RADIO-doc WITH FRAME Dialog-Frame.
      851       if RADIO-contr = 1 then find first buf_contract no-lock where buf_contract.contract-code = int(contr-code) and buf_contract.host-code = v-cntxt-host-code-obj no-error .
      852       else                    find first buf_contract no-lock where buf_contract.contract-prn-code = contr-code  and buf_contract.host-code = v-cntxt-host-code-obj no-error .
      853       if available buf_contract then do:
      854         assign  snum = buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")  .
      855         find first buf_clients no-lock where buf_clients.obj-code = buf_contract.cli-code and buf_clients.obj-type = buf_contract.cli-type no-error .
      856   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cntpurch in g#library
      858     (input  buf_contract.contract-type
      859     ,output v-contract-purch-code
      860     )  .
      861         ENABLE RADIO-doc WITH FRAME Dialog-Frame.
      862         apply "VALUE-CHANGED" to RADIO-doc in frame Dialog-Frame.
      863       end.
      864       else assign  contr-code = ""    snum = "" .
      865       display contr-code snum with frame Dialog-Frame.
      866     end.
      867   end procedure.
      868   PROCEDURE AddDoc :
      869     define input  parameter p-num as character no-undo .
      870     do on error undo, return error return-value :
      871       find first temp-doc where temp-doc.id = p-num no-error .
      872       if not available temp-doc then do:
      873         create temp-doc .
      874         assign temp-doc.id = p-num .
      875         find first trn-doc no-lock where trn-doc.doc-code = p-num no-error  .
      876         if available trn-doc then do:
      877           run clntattr-value in this-procedure  (input trn-doc.obj-type,input trn-doc.obj-code,
      878                   input  'arh-trn-doc-contract':U, output v-str, output par-type) no-error .
      879           if error-status:error or logical(v-str) = no then do:
      880             run clntattr-write in this-procedure ( input trn-doc.obj-type,input trn-doc.obj-code, input 'arh-trn-doc-contract':U, input "yes":u).
      881           end.
      882         end.
      883       end.
      884     end.
      885   end procedure.
      886   PROCEDURE CalcArh :
      887     do on error undo, return error return-value :
      888       for each temp-doc use-index fact-order :
      889         find first trn-doc no-lock where trn-doc.doc-code = temp-doc.id no-error  .
      890         if available trn-doc then do:
      891   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      892   if (valid-handle(g#libtfarh) <> true) then do:   run str/libtfarh.p persistent no-error .   if error-status :error or (valid-handle(g#libtfarh) <> true) then do:     message       "Error starting libtfarh.p" skip       g#libtfarh skip       g#libtfarh :type skip       g#libtfarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libtfarh_st-fo in g#libtfarh
      893   (input  temp-doc.id
      894   ) no-error.
      895           if error-status:error then message return-value error-status:get-message(1) view-as alert-box.
      896         end.
      897       end.
      898     end.
      899   end procedure.
      900   procedure proc-OK :
      901     do
      902     on error undo, return error return-value
      903     :
      904     define variable Counter1 as integer   no-undo .
      905     on write of ub.trn-doc override do:  end.
      906     define variable num as character no-undo .
      907   define variable v-account as integer init 0 no-undo .
      908   define variable v-account-lavel as character no-undo .
      909   define variable v-button-stop as logical no-undo .
      910   define variable v-kol-spice as integer no-undo .
      911   define variable v-kol-spice2 as integer no-undo .
      912   define variable v-kol-spice3 as integer no-undo .
      913   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      914   DEFINE BUTTON StopBtn AUTO-END-KEY
      915        LABEL "Стоп"
      916        SIZE 10 BY 1.
      917   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      918        LABEL "Обработано записей"
      919         VIEW-AS TEXT
      920        SIZE 14 BY .67 NO-UNDO.
      921   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      922         VIEW-AS TEXT
      923        SIZE 53.25 BY .67
      924        FGCOLOR 1  NO-UNDO.
      925   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      926         VIEW-AS TEXT
      927        SIZE 53.25 BY .67
      928        FGCOLOR 1  NO-UNDO.
      929   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      930         VIEW-AS TEXT
      931        SIZE 53.25 BY .67
      932        FGCOLOR 1  NO-UNDO.
      933   DEFINE RECTANGLE RECT-1
      934        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      935        SIZE 55.13 BY 4.46.
      936   DEFINE FRAME InfoFrame
      937        StopBtn AT ROW 4.25 COL 21.75
      938        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      939        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      940        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      941        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      942        RECT-1 AT ROW 1 COL 1
      943       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      944            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      945            TITLE "Процесс"
      946            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      947   define variable mFrameView      as logical   no-undo init yes.
      948     define variable mFramHandle as handle no-undo.
      949     mFramHandle = frame InfoFrame:handle.
      950     if  log-manager:logfile-name ne ?
      951     then DO:
      952         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      953         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      954         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      955     end.
      956     mFrameView = not session:batch-mode and mFramHandle:visible.
      957     if mFrameView
      958     then do:
      959       ASSIGN
      960          FRAME InfoFrame:HIDDEN                           = TRUE
      961          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      962     end.
      963   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      964   DO:
      965     IF not StopProcessing THEN
      966       Message "Вы действительно хотите прервать" SKIP
      967               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      968                 UPDATE StopProcessing.
      969     IF StopProcessing THEN do:
      970        if mFrameView
      971        then do:
      972           HIDE FRAME InfoFrame.
      973        end.
      974     End.
      975   END.
      976   assign v-account = ( if integer( 5 ) = 0 then 100 else integer( 5 ) ).
      977     if  log-manager:logfile-name ne ?
      978     then DO:
      979         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      980     end.
      981     if not session:batch-mode then
      982     do:
      983       VIEW FRAME InfoFrame.
      984       mFrameView = true.
      985     end.
      986      v-button-stop = false .
      987         if mFrameView
      988         then do:
      989         if v-button-stop then view STOPBTN in frame InfoFrame.
      990                          else Hide STOPBTN in frame InfoFrame.
      991         end.
      992     do transaction :
      993       assign db-list = "" .
      994       for each db exclusive-lock where db.db-num <> 0 :
      995         if db-list = "" then assign db-list = string(db.db-num) .
      996         else                 assign db-list = db-list + chr(1) + string(db.db-num) .
      997       end.
      998       do ii = 1 to num-entries(list_num):
      999         num = entry(ii, list_num) .
     1000         run AddDoc (num) .
     1001         find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = num no-error .
     1002         if available buf_trn-doc then do:
     1003           assign buf_trn-doc.contract-code = buf_contract.contract-code .
     1004         end.
     1005         for each buf_parts-attr exclusive-lock where buf_parts-attr.in-code = num :
     1006           assign buf_parts-attr.contract-code = buf_contract.contract-code .
     1007           assign Counter1 = Counter1 + 1.
     1008   IF ( Counter1 modulo v-account = 0 )  then DO:
     1009             if  log-manager:logfile-name ne ?
     1010             then DO:
     1011                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1012             end.
     1013              if mFrameView
     1014              then do:
     1015               DISPLAY
     1016                 Counter1 @ RecordsDone
     1017                 WITH FRAME InfoFrame.
     1018              end.
     1019   End.
     1020      if v-button-stop then  DO:
     1021            if mFrameView
     1022            then
     1023               PROCESS EVENTS.
     1024            IF StopProcessing THEN DO:
     1025            RETURN error.
     1026            End.
     1027      end.
     1028         end.
     1029         for each buf_parts exclusive-lock where buf_parts.out-code = num :
     1030           assign buf_parts.contract-code = buf_contract.contract-code .
     1031           for each gds-obj exclusive-lock
     1032             where gds-obj.artic     =  buf_parts.artic
     1033               and gds-obj.prod-type =  buf_parts.prod-type
     1034               and gds-obj.prod-code =  buf_parts.prod-code
     1035            , each parts exclusive-lock
     1036             where parts.obj-type  =  gds-obj.obj-type
     1037               and parts.obj-code  =  gds-obj.obj-code
     1038               and parts.artic     =  buf_parts.artic
     1039               and parts.prod-type =  buf_parts.prod-type
     1040               and parts.prod-code =  buf_parts.prod-code
     1041               and parts.in-code   =  buf_parts.in-code
     1042               and parts.part-code =  buf_parts.part-code
     1043             :
     1044             run AddDoc (parts.out-code) .
     1045             assign parts.contract-code = buf_contract.contract-code .
     1046             assign Counter1 = Counter1 + 1.
     1047   IF ( Counter1 modulo v-account = 0 )  then DO:
     1048             if  log-manager:logfile-name ne ?
     1049             then DO:
     1050                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1051             end.
     1052              if mFrameView
     1053              then do:
     1054               DISPLAY
     1055                 Counter1 @ RecordsDone
     1056                 WITH FRAME InfoFrame.
     1057              end.
     1058   End.
     1059      if v-button-stop then  DO:
     1060            if mFrameView
     1061            then
     1062               PROCESS EVENTS.
     1063            IF StopProcessing THEN DO:
     1064            RETURN error.
     1065            End.
     1066      end.
     1067           end.
     1068         end.
     1069       end.
     1070       run CalcArh in this-procedure .
     1071     end.
     1072     run nws/cr-route.p ( input 'send-cmd':U
     1073                     ,input "command":U + chr(1) + "fill-contract":U + chr(1) + string(buf_contract.contract-code) + chr(1) + list_num
     1074                     ,input ?
     1075                     ,input db-list
     1076                    ).
     1077     end.
     1078   end procedure.
