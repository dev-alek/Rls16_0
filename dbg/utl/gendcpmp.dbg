        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: gendcpmp.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/gendcpmp.p $":U .
        7   define variable vss-description as character no-undo init "Автоматичекая генерация пропроцессингов dis-card-property".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable gen-dir         as character no-undo .
       67   define variable v-work-dir      as character no-undo .
       68   define stream OutStream.
       69   define stream errstream .
       70   do
       71   on error undo, return error
       72   :
       73     assign
       74       file-info :file-name = ".":U
       75     .
       76     if file-info :full-pathname = ""
       77     or file-info :full-pathname = ?  then do:
       78       message
       79         "Рабочий каталог не найден"
       80         view-as alert-box error .
       81       undo, return error .
       82     end.
       83     assign
       84       v-work-dir = file-info :full-pathname + chr(92)
       85     .
       86     run gbl/d-prompt.w (
       87         'title=':u + "Введите имя директории" + '\':u
       88       + 'text1=':u + "Введите имя директории" + '\':u
       89       + 'text2=':u + "где будет создан файл с препроцессингами dis-card-property (dc-prop.i)" + '\':u
       90       + 'format=x(256)\':u
       91       + 'type=char\':u
       92       ,input-output gen-dir
       93       ).
       94     if return-value = 'false':u then do:
       95       return .
       96     end.
       97     if gen-dir = "" then do:
       98       assign
       99         gen-dir = v-work-dir
      100       .
      101     end.
      102     else do:
      103       assign
      104         file-info :file-name = gen-dir
      105       .
      106       if file-info :full-pathname = ""
      107       or file-info :full-pathname = ?  then do:
      108         message
      109           "Указаный каталог не найден" skip
      110           gen-dir
      111           view-as alert-box error .
      112         undo, return error .
      113       end.
      114       assign
      115         gen-dir = file-info :full-pathname + chr(92)
      116       .
      117     end.
      118     run gen-file in this-procedure ( input gen-dir).
      119   end.
      120   procedure gen-file :
      121   define input parameter gen-dir as character no-undo .
      122   define buffer buf_prop-head for ub.prop-head.
      123   define buffer buf_prop-map for ub.prop-map.
      124   do
      125   on error undo, return error
      126   :
      127     OUTPUT STREAM OutStream TO value( gen-dir + "ref/dc-prop.i" ) .
      128     put stream Outstream unformatted
      129     chr(47) + chr(42) + chr(10) + chr(10) + chr(36) + 'Revision: ':U + chr(36) + chr(10) + chr(36) + 'Author: ':U + chr(36) + chr(10) + chr(36) + 'Date: ':U + chr(36) + chr(10) + chr(36) + 'Workfile: ':U + chr(36) + chr(10) + chr(36) + 'Archive: ':U + chr(36) + chr(10) + chr(10) + 'ФАЙЛ ГЕНЕРИРУЕТСЯ ПРОЦЕДУРОЙ ' + program-name(1) + chr(10) + chr(10) + "Автор: Бахтадзе Наталья Викторовна":U + chr(10) + "Дата создания: 07/31/07":U + chr(10) + "Author: Bakhtadze Natalya":U + chr(10) + "Creation date: 07/31/07":U + chr(10) + chr(10) + chr(42) + chr(47) + chr(10)
      130     .
      131     put stream Outstream unformatted
      132     chr(10)
      133     "&scoped-define vssseq ~{&sequence}" +  chr(10) + 'define variable vss-include-info~{&vssseq} as character format "x(65)" no-undo initial ' + chr(34) + '@(#)' + chr(36) + 'Workfile:  ' + chr(36) + chr(32) + chr(36) + 'Revision:  ' + chr(36) + chr(34) + '.':U
      134     skip(1).
      135     for each buf_prop-head no-lock
      136     by buf_prop-head.dtm-code:
      137       if buf_prop-head.storage-place = 'dis-card-property':U
      138       or buf_prop-head.storage-place-host = 'dis-card-property':U
      139       or buf_prop-head.storage-place-obj = 'dis-card-property':U then do:
      140         put stream Outstream unformatted
      141           substitute("/*&1*/", buf_prop-head.prop-label)
      142           skip
      143           substitute("~&&global-define dc-prop_&1 &2"
      144                      ,buf_prop-head.prop-name
      145                      ,buf_prop-head.dtm-code
      146                      )
      147         skip.
      148         for each buf_prop-map no-lock where
      149                 buf_prop-map.dtm-code = buf_prop-head.dtm-code:
      150           put stream Outstream unformatted
      151             substitute("/*&1*/", buf_prop-map.node-label)
      152             skip
      153             substitute("~&&global-define dc_prop_&1_&2 &3"
      154                       ,buf_prop-head.prop-name
      155                       ,buf_prop-map.node-name
      156                       ,buf_prop-map.node-code
      157                       )
      158           skip.
      159         end.
      160         put stream Outstream unformatted skip(1).
      161       end.
      162     end.
      163     put stream Outstream unformatted
      164     skip(1)
      165     chr(47) + chr(42) + chr(32) + chr(36) + 'Workfile: dc-prop.i' + chr(32) + chr(36) +  chr(32) + 'e n d ':U + chr(42) + chr(47)
      166     skip.
      167     output stream Outstream close.
      168   end.
      169   end procedure.
