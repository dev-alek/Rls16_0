        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as   handle               no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: trncstfr.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/trncstfr.p $":U .
        8   define variable vss-description as character no-undo init "Обновление информации о ГТД партий зарезервированных за документом".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure cur-time :
       69      define output parameter p-today as date      no-undo .
       70      define output parameter p-time  as integer   no-undo .
       71     do
       72     on error undo, return error
       73     :
       74       define variable v-date1 as date      no-undo .
       75       define variable v-date2 as date      no-undo .
       76       define variable v-time  as integer   no-undo .
       77       assign
       78         v-date1 = today
       79         v-time  = time
       80         v-date2 = today
       81       .
       82       if v-date1 <> v-date2
       83       then do:
       84         assign
       85           v-date1 = today
       86           v-time  = v-time
       87         .
       88       end.
       89       assign
       90         p-today = v-date1
       91         p-time  = v-time
       92       .
       93     end.
       94   end.
       95   function cur-time-date returns character
       96   :
       97     return string(today, '99/99/9999':U) .
       98   end.
       99   function cur-time-mjd returns decimal
      100   :
      101     define variable v-date as date      no-undo .
      102     define variable v-time as integer   no-undo .
      103     run cur-time in this-procedure
      104       (output v-date
      105       ,output v-time
      106       ) .
      107     return integer(v-date) - 2400002 + (v-time / 86400) .
      108   end.
      109   function cur-time-get-ending-index returns integer
      110   (input p-number as integer
      111   )
      112   :
      113     if p-number < 0
      114     or p-number = ?
      115     then do:
      116       return 1 .
      117     end.
      118     define variable v-rest as integer   no-undo .
      119     assign
      120       p-number = p-number modulo 100
      121     .
      122     if p-number < 20
      123     then do:
      124       assign
      125         v-rest = p-number
      126       .
      127     end.
      128     else do:
      129       assign
      130         v-rest = p-number modulo 10
      131       .
      132     end.
      133     case v-rest :
      134       when 1
      135       then do:
      136         return 2 .
      137       end.
      138       when 2 or
      139       when 3 or
      140       when 4
      141       then do:
      142         return 3 .
      143       end.
      144       otherwise do:
      145         return 1 .
      146       end.
      147     end case .
      148   end.
      149   procedure cur-time-mjd-to-date :
      150      define input  parameter i-mjd-diff as decimal no-undo.
      151      define output parameter o-Date     as date    no-undo.
      152      define output parameter o-Time     as integer no-undo.
      153      define variable v-day-number as integer   no-undo .
      154      if    i-mjd-diff < 0
      155         or i-mjd-diff = ?
      156      then do:
      157         return "?" .
      158      end.
      159      assign
      160         v-day-number = truncate(i-mjd-diff,0).
      161         o-Date = date(v-day-number + 2400002).
      162         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      163     .
      164   end.
      165   function cur-time-mjd-to-string returns character
      166   (input p-mjd-diff as decimal
      167   )
      168   :
      169     define variable v-day-number as integer   no-undo .
      170     define variable v-seconds    as integer   no-undo .
      171     define variable v-hour       as integer   no-undo .
      172     define variable v-min        as integer   no-undo .
      173     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      174     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      175     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      176     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      177     if p-mjd-diff < 0
      178     or p-mjd-diff = ?
      179     then do:
      180       return "?" .
      181     end.
      182     assign
      183       v-day-number = integer(truncate(p-mjd-diff,0))
      184       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186     if v-seconds > 86400
      187     then do:
      188       assign
      189         v-seconds = 86400 - 1
      190       .
      191     end.
      192     if v-seconds < 0
      193     then do:
      194       assign
      195         v-seconds = 0
      196       .
      197     end.
      198     assign
      199       v-hour = truncate(v-seconds / 3600, 0)
      200     .
      201     assign
      202       v-seconds = v-seconds modulo 3600
      203     .
      204     assign
      205       v-min = truncate(v-seconds / 60, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 60
      209     .
      210     return
      211         (if v-day-number <> 0
      212           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      213           else ""
      214         )
      215       + (if v-day-number <> 0 or v-hour <> 0
      216           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      220           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      221           else ""
      222         )
      223       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      224       .
      225   end.
      226   function cur-time-string returns character
      227   :
      228     define variable v-date as date      no-undo .
      229     define variable v-time as integer   no-undo .
      230     run cur-time in this-procedure
      231       (output v-date
      232       ,output v-time
      233       ) .
      234     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      235   end.
      236   function cur-time-string-sec returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      245   end.
      246   function cur-time-custom  returns character
      247   (input p-prefix as character
      248   ,input p-date-format as character
      249   ,input p-delimiter as character
      250   ,input p-time-format as character
      251   ,input p-suffix as character
      252   )
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return
      261       p-prefix
      262       + string(v-date, p-date-format)
      263       + p-delimiter
      264       + string(v-time, p-time-format)
      265       + p-suffix
      266       .
      267   end.
      268   function cur-time-print  returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      277   end.
      278   function cur-time-datetime returns datetime
      279   :
      280     define variable v-char as character no-undo .
      281     define variable v-datetime as datetime no-undo .
      282     v-char = cur-time-string().
      283     v-datetime = datetime(v-char).
      284     return  v-datetime.
      285   end.
      286   function cur-time-string-msec returns character
      287   :
      288     define variable v-date as datetime  no-undo .
      289     v-date = now.
      290     return string(v-date) .
      291   end.
      292   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      293     define variable v-cntxt-db-num        as integer   no-undo .
      294     define variable v-cntxt-userid        as character no-undo .
      295     define variable v-cntxt-level         as character no-undo .
      296     define variable v-cntxt-host-code-obj as integer   no-undo .
      297     define variable v-cntxt-obj-type      as character no-undo .
      298     define variable v-cntxt-obj-code      as integer   no-undo .
      299     define variable v-cntxt-db-num-obj    as integer   no-undo .
      300     define variable v-cntxt-is-admin      as logical   no-undo .
      301   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      302     run mainmenu_getcntxt in parparentproc
      303       (output v-cntxt-db-num
      304       ,output v-cntxt-userid
      305       ,output v-cntxt-level
      306       ,output v-cntxt-host-code-obj
      307       ,output v-cntxt-obj-type
      308       ,output v-cntxt-obj-code
      309       ,output v-cntxt-db-num-obj
      310       ,output v-cntxt-is-admin
      311       ) .
      312   define variable lok             as logical   no-undo .
      313   define variable v-lookup-ind    as integer   no-undo .
      314   define variable v-update-ind    as integer   no-undo .
      315   define variable v-error-ind     as integer   no-undo .
      316   define variable loc-ref-list    as character no-undo .
      317   define variable v-doc-rec       as integer   no-undo .
      318   define variable v-today         as date      no-undo .
      319   define variable v-time          as integer   no-undo .
      320   do
      321   on error undo, return error
      322   :
      323     run str/all-docs.w
      324       (input  parparentproc ,
      325       input v-cntxt-host-code-obj,
      326       input v-cntxt-obj-type,
      327       input v-cntxt-obj-code
      328       ,input  'выбор':U
      329       ,input  ?
      330       ,input  ?
      331       ,input  ?
      332       ,input  ?
      333       ,input  "b-sel":U
      334       ,input  ?
      335       ,input  ?
      336       ,input  ?
      337       ,output loc-ref-list
      338       ).
      339     assign
      340       v-doc-rec = integer (entry(1, loc-ref-list))
      341     .
      342     find trn-doc no-lock
      343       where recid (trn-doc) = v-doc-rec
      344       no-error .
      345     if available trn-doc
      346     then do:
      347       message
      348         "Проставить ГТД во все партии документа" ub.trn-doc.doc-code skip
      349         "На основании ГТД накладных, породивших партии" skip
      350         view-as alert-box question buttons ok-cancel update lok .
      351       if lok <> true then do:
      352         return .
      353       end.
      354       output to trncstfr.txt append .
      355       run cur-time in this-procedure ( output v-today
      356                                      , output v-time
      357                                      ).
      358       export
      359         "update_cst-code_in_trn-doc"
      360         string(v-today, "99/99/9999")
      361         string(v-time, "HH:MM")
      362         ub.trn-doc.doc-code
      363         .
      364       output close .
      365       define buffer buf_trn-doc for ub.trn-doc .
      366       do transaction
      367       on error undo, return error
      368       :
      369         for each ub.parts exclusive-lock
      370           where ub.parts.out-code = ub.trn-doc.doc-code
      371         on error undo, return error
      372         :
      373           assign
      374             v-lookup-ind = v-lookup-ind + 1
      375           .
      376           find first buf_trn-doc no-lock
      377             where buf_trn-doc.doc-code = ub.parts.in-code
      378             no-error .
      379           if available buf_trn-doc then do:
      380             if ub.parts.cst-code <> buf_trn-doc.cst-code then do:
      381               assign
      382                 v-update-ind = v-update-ind + 1
      383               .
      384               output to trncstfr.fix append .
      385               run cur-time in this-procedure ( output v-today
      386                                              , output v-time
      387                                              ).
      388               export
      389                 string(v-today, "99/99/9999")
      390                 string(v-time, "HH:MM")
      391                 "update_parts_old-cst-code_new-cst-code"
      392                 ub.parts.cst-code buf_trn-doc.cst-code
      393                 .
      394               export ub.parts .
      395               output close .
      396               assign
      397                 ub.parts.cst-code = buf_trn-doc.cst-code
      398               .
      399             end.
      400           end.
      401           else do:
      402             assign
      403               v-error-ind = v-error-ind + 1
      404             .
      405             output to trncstfr.err append .
      406             run cur-time in this-procedure ( output v-today
      407                                            , output v-time
      408                                            ).
      409             export
      410               "income_trn-doc_not_found"
      411               string(v-today, "99/99/9999")
      412               string(v-time, "HH:MM")
      413               ub.parts.in-code
      414               .
      415             export ub.parts .
      416             output close .
      417           end.
      418         end.
      419       end.
      420       if v-error-ind = 0 then do:
      421         message
      422           "Документ" ub.trn-doc.doc-code skip
      423           "Просмотр ГТД в партиях документа закончен." skip
      424           "Просмотрено партий" v-lookup-ind skip
      425           "Исправлено ГТД " v-update-ind skip
      426           view-as alert-box information .
      427       end.
      428       else do:
      429         message
      430           "Документ" ub.trn-doc.doc-code skip
      431           "Просмотр ГТД в партиях документа закончен." skip
      432           "Просмотрено партий" v-lookup-ind skip
      433           "Исправлено ГТД " v-update-ind skip
      434           "Ошибок" v-error-ind skip
      435           "Полный список ошибок в файле trncstfr.err" skip
      436           view-as alert-box error .
      437       end.
      438     end.
      439   end.
