      427   on error undo, return error return-value
      428   :
      429       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      430       (input  p-ucode
      431       ,input  p-code
      432       ,output  p-section-num
      433       ) no-error .
      434     if error-status :error
      435     then do:
      436       undo, return error return-value .
      437     end.
      438   end.
      439   end procedure.
      440   define buffer buf_clob-bind for ub.clob-bind.
      441   define buffer buf_clob-data for ub.clob-data.
      442   define variable extGdsObj        as class ExtGds         no-undo.
      443   define variable extGdsValueObj   as class ExtGdsValue    no-undo.
      444   define variable extGdsValueWBObj as class ExtGdsValue    no-undo.
      445   define variable parserWBObj      as class ParserXMLDocWB no-undo.
      446   define variable v-objCode         as integer   no-undo.
      447   define variable ii                as integer   no-undo.
      448   define variable v-objType         as character no-undo.
      449   define variable v-gds-code        as integer   no-undo.
      450   define variable v-alc-code        as character no-undo.
      451   define variable hDoc              as handle    no-undo.
      452   define variable bh-egais-goods    as handle    no-undo.
      453   define variable qh-egais-goods    as handle    no-undo.
      454   define stream out.
      455   output stream out to gds-fix.txt.
      456   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      457   define variable v-waitfram-action01         as character   no-undo .
      458   define variable v-waitfram-action02         as character   no-undo .
      459   define variable v-waitfram-action03         as character   no-undo .
      460   define variable mWaitFramTextBeg            as character   no-undo.
      461   define variable mWaitFramTextEnd            as character   no-undo.
      462   define variable mWaitFramView               as logical     no-undo.
      463   define variable mWaitProcEvent              as logical     no-undo init yes.
      464   define variable mWaitFramInterval           as integer     no-undo init 1 .
      465   define variable mWaitFramStop               as logical     no-undo.
      466   define variable mWaitFramStopUser           as logical     no-undo.
      467   define variable mWaitFramStopTimeOut        as logical     no-undo.
      468   define variable mWaitFramStartProc          as datetime-tz no-undo.
      469   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      470   define button B-WaitFramStop auto-end-key
      471        label "Стоп"
      472        size 10 by 1 tooltip "Остоновить процесс".
      473   define button B-viewProcInfo
      474        label "Информация"
      475        size 15 by 1 tooltip "Информация о процесс".
      476   define frame waitfram
      477     v-waitfram-action01 format "x(72)" no-label skip
      478     v-waitfram-action02 format "x(72)" no-label skip
      479     v-waitfram-action03 format "x(72)" no-label skip
      480     B-viewProcInfo
      481     B-WaitFramStop at row 4 col 30
      482     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      483     .
      484   define new global shared variable mBatchMode as logical no-undo init ?.
      485   define variable mFramBachModHandle as handle no-undo.
      486   mFramBachModHandle = frame waitfram:handle.
      487   define variable mFameOldVis as logical no-undo.
      488   define variable mVisCUrentVin as logical no-undo.
      489   if session:batch-mode
      490   then
      491      mBatchMode = yes.
      492   if mBatchMode = ? then do:
      493     mVisCUrentVin = current-window:visible.
      494     mFameOldVis = mFramBachModHandle:visible.
      495     mFramBachModHandle:visible  = yes.
      496     mBatchMode = mFramBachModHandle:visible ne yes.
      497     mFramBachModHandle:visible = mFameOldVis.
      498     current-window:visible = mVisCUrentVin.
      499   end.
      500    if  log-manager:logfile-name ne ?
      501     then DO:
      502         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      503         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      504         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      505     end.
      506   on choose of B-WaitFramStop in frame waitfram
      507   do:
      508     mWaitFramStop = yes.
      509     mWaitFramStopUser = yes.
      510   end.
      511   function waitfram-check-timeout returns logical():
      512      define variable vtime as int64 no-undo.
      513      if mWaitFramStopTimeOut
      514      then
      515         return yes.
      516      vtime = ( now - mWaitFramStartProc ) / 1000 .
      517      if     mWaitFramTimeOut ne ?
      518         and mWaitFramTimeOut ne 0
      519         and mWaitFramTimeOut lt vtime
      520      then do:
      521         mWaitFramStopTimeOut = yes.
      522      end.
      523      return mWaitFramStopTimeOut.
      524   end.
      525   procedure waitfram-hide :
      526     if not session:batch-mode
      527     then do
      528     on error undo, return error return-value
      529     :
      530       pause 0 before-hide .
      531       if not mBatchMode then
      532         hide frame waitfram .
      533     if     not mWaitFramView
      534        and mWaitProcEvent
      535     then
      536       process events .
      537     end.
      538   end procedure.
      539   procedure waitfram-show :
      540     define input  parameter p-message as character no-undo .
      541     define variable v-left-margin as integer   no-undo .
      542     if not session:batch-mode
      543     then do
      544     on error undo, return error return-value
      545     :
      546       if length(p-message) <= 70 then do:
      547         assign
      548           v-left-margin = integer((70 - length(p-message)) / 2)
      549         .
      550         assign
      551           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      552         .
      553         assign
      554           v-waitfram-action01 = " "
      555           v-waitfram-action02 = " "
      556                                    + fill(" ", v-left-margin)
      557                                    + p-message
      558           v-waitfram-action03 = " "
      559         .
      560       end.
      561       else do:
      562         define variable vRindex1 as integer no-undo.
      563         define variable vRindex2 as integer no-undo.
      564         vRindex1 = r-index(p-message," ",70).
      565         if vRindex1 = 0
      566         then
      567            vRindex1 = 70.
      568         if length(p-message)  <= vRindex1 + 70 then do:
      569           assign
      570             v-waitfram-action01 = " "
      571             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      572             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      573           .
      574         end.
      575         else do:
      576           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      577           if vRindex2 <= vRindex1
      578           then
      579              vRindex2 = vRindex1 + 70.
      580           assign
      581             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      582             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      583             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      584           .
      585         end.
      586       end.
      587       B-viewProcInfo:visible   in frame waitfram = no.
      588       B-viewProcInfo:sensitive in frame waitfram = no.
      589       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      590       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      591       if  (   mWaitFramView
      592          or  mWaitProcEvent)
      593          and not mBatchMode
      594       then
      595          display
      596             v-waitfram-action01 skip
      597             v-waitfram-action02 skip
      598             v-waitfram-action03 skip
      599          with frame waitfram .
      600       if     mWaitFramView
      601          then do:
      602             if     mWaitFramInterval ne ?
      603                and not mBatchMode
      604             then
      605                wait-for go of frame waitfram pause mWaitFramInterval.
      606          end.
      607          else
      608             if     mWaitProcEvent
      609                and not mBatchMode
      610             then
      611                process events .
      612     end.
      613   end procedure.
      614      procedure waitfram-show-this:
      615         define input  parameter iInterval as int64 no-undo.
      616         define variable vtime as int64 no-undo.
      617         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      618         mWaitFramInterval = iInterval.
      619         run waitfram-show (substitute("&1&2 &3&4" ,
      620                                       mWaitFramTextBeg ,
      621                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      622                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      623                                       mWaitFramTextEnd
      624                                      )
      625                           ).
      626      end.
      627      procedure WaitFramRunPause:
      628         define input  parameter iInterval as dec no-undo.
      629         define variable vStart  as datetime-tz no-undo.
      630         define variable vend    as datetime-tz no-undo.
      631         define variable vint as int64 no-undo.
      632         define variable vOk as logical no-undo.
      633         vStart = now.
      634         vend   = vStart.
      635         publish "WaitFramPause" (iInterval,output vOk).
      636         vend   =  now.
      637         vint = vend - vStart.
      638         vint = iInterval - vint / 1000.
      639         if     not mWaitFramStop
      640            and (   vint > 0
      641                 or (    not vOk
      642                     and iInterval eq ?
      643                     )
      644                 )
      645         then
      646            run waitfram-show-this (iInterval).
      647         vend   =  now.
      648         vint = vend - vStart.
      649         vint = iInterval - vint / 1000.
      650         if     not mWaitFramStop
      651            and vint > 0
      652         then do:
      653            run gbl/pause.p (vint * 1000).
      654         end.
      655         if iInterval ne ?
      656         then
      657            publish "WaitFramStop".
      658         waitfram-check-timeout().
      659      end.
      660      procedure WaitFramWaitFor:
      661         define input  parameter iInterval as dec no-undo.
      662         assign
      663            mWaitFramStartProc   = now
      664            mWaitFramStopUser    = no
      665            mWaitFramStopTimeOut = no
      666         .
      667         block-wait:
      668         do while not mWaitFramStop:
      669            run WaitFramRunPause (iInterval).
      670            if  waitfram-check-timeout()
      671            then do:
      672               leave block-wait.
      673            end.
      674         end.
      675         run waitfram-hide.
      676      end.
      677   procedure waitfram-join :
      678     define input  parameter p-line-1  as character no-undo .
      679     define input  parameter p-line-2  as character no-undo .
      680     define input  parameter p-line-3  as character no-undo .
      681     define output parameter p-message as character no-undo .
      682     do
      683     on error undo, return error return-value
      684     :
      685       assign
      686         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      687                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      688                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      689       .
      690     end.
      691   end procedure.
      692   function waitfram-join-function returns character
      693     (input p-line-1 as character
      694     ,input p-line-2 as character
      695     ,input p-line-3 as character
      696     ).
      697     define variable v-message as character no-undo .
      698     run waitfram-join in this-procedure
      699       (input  p-line-1
      700       ,input  p-line-2
      701       ,input  p-line-3
      702       ,output v-message
      703       ) .
      704     return v-message .
      705   end function .
      706   do:
      707     run waitfram-show in this-procedure
      708     (input substitute("Идет проверка и исправление доп. информации по товарам                на основе накладных")
      709     ) .
      710     extGdsObj = new ExtGds (true).
      711     parserWBObj = new ParserXMLDocWB (extGdsObj:ExtSystem).
      712     extGdsObj:GetHndlTable(0, "", input-output bh-egais-goods).
      713     create query qh-egais-goods.
      714     qh-egais-goods:set-buffers (bh-egais-goods).
      715     for each buf_clob-bind where buf_clob-bind.resource-type = 'egais-wb':U:
      716       find first buf_clob-data where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      717       run createhDoc(recid (buf_clob-data), "utl-egais-gds-synch.xml", output hDoc).
      718       parserWBObj:ParseRec(hDoc, ?, input-output table tt-wb-header, input-output table tt-wb-gds-EG, input-output table tt-wb-info-client).
      719       for each tt-wb-gds-EG:
      720         qh-egais-goods:query-prepare ("for each tt-egaisgds-hndls where ColorNum <> ? and alcCode = '" + tt-wb-gds-EG.alc-code + "'").
      721         qh-egais-goods:query-open.
      722         extGdsValueWBObj = extGdsObj:GetInfoObj(tt-wb-gds-EG.prod-list + chr (4) + tt-wb-gds-EG.importer-list + chr (4) + tt-wb-gds-EG.gds-name).
      723         if extGdsValueWBObj:INNImpor = "" and extGdsValueWBObj:INNProd = ""
      724         then do:
      725           next.
      726         end.
      727         do while qh-egais-goods:get-next ():
      728           v-gds-code = bh-egais-goods:buffer-field ("gdsCode"):buffer-value.
      729           v-alc-code = bh-egais-goods:buffer-field ("alcCode"):buffer-value.
      730           extGdsObj:OpenQueryExtGds(v-gds-code, v-alc-code).
      731           extGdsValueObj = extGdsObj:GetExtGdsValue().
      732           extGdsObj:CopyEgaisInfo (extGdsValueWBObj, extGdsValueObj).
      733           extGdsObj:SaveEGAISInfo (extGdsValueObj).
      734           bh-egais-goods:buffer-field ("ColorNum"):buffer-value = ?.
      735           ii = ii + 1.
      736           export stream out v-gds-code v-alc-code.
      737         end.
      738         qh-egais-goods:query-close.
      739         delete object extGdsValueWBObj.
      740       end.
      741       qh-egais-goods:query-prepare ("for each tt-egaisgds-hndls where ColorNum <> ?").
      742       qh-egais-goods:query-open.
      743       if not qh-egais-goods:get-first
      744       then do:
      745         qh-egais-goods:query-close.
      746         leave.
      747       end.
      748       qh-egais-goods:query-close.
      749     end.
      750     message "Завершено. Исправлено - " ii " См. лог - " search ('gds-fix.txt')  view-as alert-box.
      751     run waitfram-hide in this-procedure .
      752   end.
      753   procedure createhDoc:
      754     define input parameter inRecCD as recid no-undo.
      755     define input parameter inFileName as char no-undo.
      756     define output parameter outhDoc as handle no-undo.
      757     define buffer buf_cd for ub.clob-data.
      758     find first buf_cd where recid (buf_cd) = inRecCD no-lock.
      759     copy-lob
      760       from  object buf_cd.cdata
      761       to  file inFileName
      762       no-convert
      763       no-error .
      764     create x-document outhDoc.
      765     outhDoc:encoding = 'utf-8'.
      766     outhDoc:load("file", search (inFileName), false).
      767     release buf_cd.
      768   end.
