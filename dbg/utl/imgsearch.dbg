      705   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706   PROCEDURE verify-ini-entry:
      707   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      708   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      709   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      710   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      711   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      712   define variable v-mess as character no-undo .
      713   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      714   if ini-entry-value = ? and ini-key-name begins "spl"
      715   then
      716   get-key-value section ini-section-name key "splall" value ini-entry-value.
      717   if ini-entry-value = ? and ini-key-name begins "sav"
      718   then
      719   get-key-value section ini-section-name key "savall" value ini-entry-value.
      720   if ini-entry-value = ? then do:
      721     assign
      722     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      723                       , chr(10)
      724                       , ini-section-name
      725                       , ini-key-name
      726                       , error-msg-text).
      727       if not silence then do:
      728         message
      729         v-mess
      730         view-as alert-box ERROR  .
      731         return error.
      732       end.
      733       else do:
      734         return error v-mess.
      735       end.
      736   end.
      737   END PROCEDURE.
      738   PROCEDURE verify-file:
      739   DEFINE INPUT  PARAMETER filename       as character no-undo.
      740   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      741   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      742   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      743   file-info:file-name = filename.
      744   found = NOT (file-info:full-pathname = ?).
      745   if NOT found  then do:
      746     if not silence then do:
      747       message error-msg-text
      748       view-as alert-box ERROR.
      749       return error.
      750     end.
      751     else return error error-msg-text.
      752   end.
      753   END PROCEDURE.
      754   DEFINE VARIABLE mLogical       AS LOGICAL     NO-UNDO.
      755   DEFINE VARIABLE mLogFile       AS CHARACTER   NO-UNDO.
      756   DEFINE STREAM mLogStr.
      757   DEFINE STREAM mDirStr.
      758   DEFINE STREAM mPrevDirStr.
      759   DEFINE STREAM mGdsDirStr.
      760   DEFINE VARIABLE mF_select_photo AS LOGICAL     NO-UNDO.
      761   DEFINE VARIABLE vPhotoPath       AS CHARACTER   NO-UNDO.
      762   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
      763   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
      764   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
      765   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
      766   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
      767   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
      768   define variable v-param-types   as character  no-undo.
      769   define variable v-value-char    as character  no-undo.
      770   define variable v-val-date      as date       no-undo.
      771   define variable v-val-decimal   as decimal    no-undo.
      772   define variable v-val-integer   as integer    no-undo.
      773   define variable v-val-logical   as logical    no-undo.
      774   define variable v-tthd          as handle     no-undo.
      775   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
      776   PROCEDURE imagelist_loaddef:
      777       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
      778       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
      779       ASSIGN
      780           vPar-val  = "":U
      781           vPar-type = "":U
      782           .
      783   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      784     (input  'photo':u
      785     ,input  '':u
      786     ,input  '':u
      787     ,input  0
      788     ,input  '':u
      789     ,input  '':u
      790     ,input  '':u
      791     ,input  no
      792     ,output vPar-val
      793     ,output vPar-type
      794     ) no-error .
      795           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
      796       IF mImagePh THEN .
      797       ELSE RETURN.
      798       ASSIGN
      799           vPar-val  = "":U
      800           vPar-type = "":U
      801           .
      802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      803     (input  'ph-dir':u
      804     ,input  '':u
      805     ,input  '':u
      806     ,input  0
      807     ,input  '':u
      808     ,input  '':u
      809     ,input  '':u
      810     ,input  NO
      811     ,output vPar-val
      812     ,output vPar-type
      813     ) no-error .
      814       IF LENGTH (vPar-val) = 0 THEN
      815           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
      816       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
      817       ASSIGN
      818           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
      819           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
      820           mImagePreDir = mImagePath
      821           mImageDir    = mImagePreDir
      822           mImageTrash  = mImagePath + "trash\":U
      823           .
      824       ASSIGN
      825           vPar-val  = "":U
      826           vPar-type = "":U
      827           .
      828               run adm/shattri.p (
      829           input "get":U
      830           ,input  '':U
      831           ,input  0
      832           ,input  'gds-ref':U
      833           ,input  'shema-foto':U
      834           ,output v-value-char
      835           ,output v-val-date
      836           ,output v-val-decimal
      837           ,output v-val-integer
      838           ,output v-val-logical
      839           ,output v-param-types
      840           ,INPUT-OUTPUT table-handle v-tthd
      841           ) no-error.
      842           delete object v-tthd.
      843           mPhotomgd = IF v-val-integer = 2 then yes else no.
      844   END PROCEDURE.
      845   PROCEDURE imagelist_decode:
      846       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      847       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
      848       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      849       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      850       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      851       ASSIGN
      852           oImageList = iImageList
      853           .
      854       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      855           vCh =ENTRY (vInt, iImageList, ",":U).
      856           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
      857           ELSE
      858           DO:
      859               ASSIGN
      860                   vCh = REPLACE (vCh, "~/":U, "\":U)
      861                   vCh = REPLACE (vCh, "~\":U, "\":U)
      862                   .
      863               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
      864               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
      865               ENTRY (vInt, oImageList, ",":U) = vCh.
      866           END.
      867       END.
      868   END PROCEDURE.
      869   PROCEDURE imagelist_encode:
      870       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      871       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      872       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      873       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      874       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
      875       ASSIGN
      876           oImageList = iImageList
      877           vLen       = LENGTH (mImageDir)
      878           .
      879       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      880           vCh =ENTRY (vInt, iImageList, ",":U).
      881           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
      882               ENTRY (vInt, oImageList, ",":U) =
      883                   SUBSTRING (vCh, vLen + 1).
      884       END.
      885   END PROCEDURE.
      886   IF mImagePh THEN .
      887       ELSE RETURN.
      888   mPhotomgd = IF v-val-integer = 2 then yes else no.
      889   if mPhotomgd = yes then do:
      890       vPhotoPath =  mImagePreDir .
      891   RUN ProcDir IN THIS-PROCEDURE (vPhotoPath).
      892   end.
      893   PROCEDURE ProcDir PRIVATE:
      894       DEFINE INPUT PARAMETER iDir      AS CHARACTER  NO-UNDO.
      895       DEFINE VARIABLE vSubDirList      AS LONGCHAR   NO-UNDO.
      896       DEFINE VARIABLE vShortFName      AS CHARACTER  NO-UNDO.
      897       DEFINE VARIABLE vFullFName       AS CHARACTER  NO-UNDO.
      898       DEFINE VARIABLE vFileAttr        AS CHARACTER  NO-UNDO.
      899       DEFINE VARIABLE vGdsShortFName   AS CHARACTER  NO-UNDO.
      900       DEFINE VARIABLE vGdsFullFName    AS CHARACTER  NO-UNDO.
      901       DEFINE VARIABLE vGdsFileAttr     AS CHARACTER  NO-UNDO.
      902       DEFINE VARIABLE vPrevShortFName  AS CHARACTER  NO-UNDO.
      903       DEFINE VARIABLE vPrevFullFName   AS CHARACTER  NO-UNDO.
      904       DEFINE VARIABLE vPrevFileAttr    AS CHARACTER  NO-UNDO.
      905       INPUT STREAM mDirStr FROM OS-DIR (iDir).
      906       FileBlock:
      907       REPEAT:
      908           IMPORT STREAM mDirStr vShortFName vFullFName vFileAttr.
      909           IF vShortFName = ".":U OR vShortFName = "..":U THEN NEXT FileBLock.
      910           IF INDEX (vFileAttr, "D":U) > 0 THEN
      911           DO:
      912             FIND FIRST bar-code NO-LOCK WHERE bar-code.b-code = INTEGER(vShortFName) no-error.
      913             IF AVAILABLE bar-code THEN DO:
      914               FIND FIRST goods    NO-LOCK WHERE goods.gds-code  = bar-code.gds-code NO-ERROR.
      915               INPUT STREAM mPrevDirStr FROM OS-DIR (vFullFName).
      916               FileBlock1:
      917               REPEAT:
      918                   IMPORT STREAM mPrevDirStr vPrevShortFName vPrevFullFName vPrevFileAttr.
      919                   IF vPrevShortFName = ".":U OR vPrevShortFName = "..":U OR vPrevShortFName = "Thumbs.db":U THEN NEXT FileBLock1.
      920                   IF INDEX (vPrevFileAttr, "D":U) > 0 and vPrevShortFName begins "PREV" THEN
      921                   DO:
      922                       INPUT STREAM mGdsDirStr FROM OS-DIR (vPrevFullFName).
      923                       FileBlock2:
      924                       REPEAT:
      925                           IMPORT STREAM mGdsDirStr vGdsShortFName vGdsFullFName vGdsFileAttr.
      926                           IF vGdsShortFName = ".":U OR vGdsShortFName = "..":U OR vGdsShortFName = "Thumbs.db":U THEN NEXT FileBLock2.
      927                       IF INDEX (vGdsFileAttr, "F":U) > 0  THEN
      928                       vGdsShortFName = vPrevShortFName + "\" + vGdsShortFName.
      929                           RUN ProcFile (vShortFName, yes, vGdsShortFName).
      930                       END.
      931                       INPUT STREAM mGdsDirStr CLOSE.
      932                   END.
      933                       IF INDEX (vPrevFileAttr, "F":U) > 0  THEN
      934                           RUN ProcFile (vShortFName, no, vPrevShortFName).
      935                       END.
      936               END.
      937               INPUT STREAM mPrevDirStr CLOSE.
      938               END.
      939           END.
      940       INPUT STREAM mDirStr CLOSE.
      941   END PROCEDURE.
      942   PROCEDURE ProcFile PRIVATE:
      943       DEFINE INPUT PARAMETER v-bar-code      AS CHARACTER  NO-UNDO.
      944       DEFINE INPUT PARAMETER v-Prev          AS logical  NO-UNDO.
      945       DEFINE INPUT PARAMETER v-Path          AS CHARACTER  NO-UNDO.
      946       DEFINE VARIABLE vImageList             AS CHARACTER  NO-UNDO.
      947       DEFINE VARIABLE vFullFName             AS CHARACTER  NO-UNDO.
      948       DEFINE VARIABLE vType                  AS CHARACTER  NO-UNDO.
      949       DEFINE VARIABLE mImageList             AS CHARACTER  NO-UNDO.
      950       DEFINE VARIABLE vPrevFileAttr    AS CHARACTER  NO-UNDO.
      951           FOR FIRST bar-code NO-LOCK WHERE bar-code.b-code = integer(v-bar-code),
      952               FIRST goods    NO-LOCK WHERE goods.gds-code  = bar-code.gds-code:
      953            RUN gds-attr-value (goods.gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vType).
      954            if v-Path <> "" or v-Path <> "Thumbs.db" then do:
      955                if v-Prev = yes then do:
      956                    IF LOOKUP (v-Path, vImageList) = 0  THEN do:
      957                    if vImageList = "" then mImageList = v-Path.
      958                    else mImageList = v-Path + "," + vImageList .
      959                      RUN gds-attr-write (goods.gds-code, "image-list":U, mImageList).
      960                    END.
      961                end.
      962                else do:
      963                    IF LOOKUP (v-Path, vImageList) = 0  THEN do:
      964                       if vImageList = "" then mImageList = v-Path.
      965                       else mImageList = vImageList + "," + v-Path.
      966                      RUN gds-attr-write (goods.gds-code, "image-list":U, mImageList).
      967                    end.
      968                end.
      969              end.
      970             end.
      971   END PROCEDURE.
