     2751   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2752   on help of frame u-gds-form
     2753   do:
     2754     run gbl/app_help.p
     2755       (input this-procedure :file-name
     2756       ,input ''
     2757       ,input ?
     2758       ) no-error.
     2759     if error-status :error then do:
     2760       message
     2761         "Ошибка при вызове помощи"
     2762         error-status :get-message(1)
     2763         view-as alert-box .
     2764     end.
     2765   end.
     2766   run minbtn-set in this-procedure .
     2767   on choose of b-help in frame u-gds-form
     2768   do:
     2769     apply "help":u to frame u-gds-form .
     2770   end.
     2771   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2772   procedure minbtn-set :
     2773       do
     2774           on error undo, return error return-value
     2775           :
     2776           define variable ii              as integer       no-undo .
     2777           define variable fh              as widget-handle no-undo .
     2778           define variable hh              as widget-handle no-undo .
     2779           define variable v-h             as handle        extent 4 no-undo .
     2780           define variable v-name-button   as character     no-undo .
     2781           define variable v-help-old-x    as decimal       no-undo .
     2782           define variable v-help-old-y    as decimal       no-undo .
     2783           define variable v-help-old-size as decimal       no-undo .
     2784           define variable v-frame-width   as decimal       no-undo .
     2785           define variable jj              as integer       no-undo .
     2786           do
     2787               on error undo, return error
     2788               :
     2789               assign
     2790                   v-frame-width = frame u-gds-form:width - 0.3
     2791                   fh            = frame u-gds-form:first-child
     2792                   hh            = fh:first-child
     2793                   ii            = 1
     2794                   .
     2795               do while valid-handle(hh):
     2796                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2797                   do:
     2798                       case lc(hh:name) :
     2799                           when "b-help" then
     2800                               do:
     2801                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2802                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2803                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2804                                   hh:TOOLTIP = "Помощь" .
     2805                                   v-help-old-x = hh:column .
     2806                                   v-help-old-y = hh:row    .
     2807                                   v-help-old-size = hh:width .
     2808                                   hh:width-chars = 2.5 .
     2809                               end.
     2810                           when "b-print" then
     2811                               do:
     2812                                   hh:load-image("cmp/b-print.bmp":u) .
     2813                                   hh:TOOLTIP = "Печать" .
     2814                                   v-h[ii] = hh:handle .
     2815                                   ii = ii + 1 .
     2816                                   hh:width-chars = 3 .
     2817                               end.
     2818                           when "b-history" or
     2819                           when "b-hist" then
     2820                               do:
     2821                                   hh:load-image("cmp/b-hist.bmp":u) .
     2822                                   hh:TOOLTIP = "История" .
     2823                                   v-h[ii] = hh:handle .
     2824                                   ii = ii + 1 .
     2825                                   hh:width-chars = 3 .
     2826                               end.
     2827                           when "b-sch" then
     2828                               do:
     2829                                   hh:load-image("cmp/b-sch.bmp":u) .
     2830                                   hh:TOOLTIP = "Установка Фильтра" .
     2831                                   v-h[ii] = hh:handle .
     2832                                   ii = ii + 1 .
     2833                                   hh:width-chars = 3 .
     2834                               end.
     2835                           when "b-hist-user" then
     2836                               do:
     2837                                   hh:load-image("cmp/b-hist.bmp":u) .
     2838                                   hh:TOOLTIP = "История пользователя" .
     2839                                   ii = ii + 1 .
     2840                               end.
     2841                       end case.
     2842                   end.
     2843                   hh = hh:next-sibling.
     2844               end.
     2845               b-help:column = v-frame-width - b-help:width-chars.
     2846               jj = 0.
     2847               repeat ii = 4 to 1 by -1 :
     2848                   if valid-handle (v-h[ii] ) then
     2849                   do:
     2850                       jj  = jj + 1 .
     2851                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2852                       v-h[ii]:row    = v-help-old-y .
     2853                   end.
     2854               end.
     2855           end.
     2856       end.
     2857   end procedure.
     2858   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2859   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2860   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2861   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2862   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2863   define variable v-diasize-current-frame-height as decimal   no-undo .
     2864   define variable v-diasize-change-size          as logical   no-undo .
     2865   define variable v-diasize-resize-button        as handle    no-undo .
     2866   define variable v-diasize-wndmax               as logical   no-undo .
     2867   define variable v-diasize-wndstore             as logical   no-undo .
     2868   define variable v-diasize-proc-name            as character no-undo .
     2869   define variable v-diasize-browse-handle        as handle    no-undo .
     2870   define variable v-diasize-browse-number        as integer   no-undo .
     2871   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2872   define temp-table temp-diasize-handle no-undo
     2873     field handle-value  as handle
     2874     field save-position as decimal
     2875     index xpk is primary unique handle-value
     2876     .
     2877   define temp-table temp-browse-handle no-undo
     2878     field browse-type   as character
     2879     field browse-number as integer
     2880     field browse-handle as handle
     2881     field original-size as decimal
     2882     index xpk is primary unique browse-type browse-number
     2883     index xie browse-type browse-handle
     2884   .
     2885   procedure diasize_change-height :
     2886     define input  parameter p-change-value  as decimal   no-undo .
     2887     define input  parameter p-move-resize   as logical   no-undo .
     2888     define variable v-field-group-handle    as handle    no-undo .
     2889     define variable v-object-handle         as handle    no-undo .
     2890     define variable v-frame-height          as decimal   no-undo .
     2891     define variable v-frame-virtual-height  as decimal   no-undo .
     2892     define variable v-browse-height         as decimal   no-undo .
     2893     define variable v-window-height         as decimal   no-undo .
     2894     define variable v-window-virtual-height as decimal   no-undo .
     2895     define variable v-change-sign           as integer   no-undo .
     2896     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2897     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2898     if p-change-value > 0
     2899     then do:
     2900       if frame u-gds-form :height + p-change-value
     2901           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2902       then do:
     2903         assign
     2904           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2905                           - (frame u-gds-form :height-chars)
     2906         .
     2907         if p-change-value <= 0
     2908         then do:
     2909           run diasize_position-resize-button in this-procedure .
     2910           return .
     2911         end.
     2912       end.
     2913     end.
     2914     if p-change-value < 0
     2915     then do:
     2916       if frame u-gds-form :height + p-change-value < v-diasize-orig-frame-height
     2917       then do:
     2918         assign
     2919           p-change-value = v-diasize-orig-frame-height
     2920                          - (frame u-gds-form :height-chars)
     2921         .
     2922         if p-change-value >= 0
     2923         then do:
     2924           run diasize_position-resize-button in this-procedure .
     2925           return .
     2926         end.
     2927       end.
     2928     end.
     2929     if p-change-value >= 0
     2930     then do:
     2931       assign
     2932         v-change-sign = 1
     2933       .
     2934     end.
     2935     else do:
     2936       assign
     2937         v-change-sign = -1
     2938       .
     2939     end.
     2940     assign
     2941       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2942     .
     2943     if p-change-value = 0
     2944     then do:
     2945       run diasize_position-resize-button in this-procedure .
     2946       return .
     2947     end.
     2948     move_block:
     2949     do
     2950     on error undo move_block, retry move_block
     2951     :
     2952       if retry
     2953       then do:
     2954         do
     2955         on error undo move_block, leave move_block
     2956         :
     2957           if p-change-value > 0
     2958           then do:
     2959             for each buf_temp-diasize-handle
     2960             on error undo, next
     2961             :
     2962               assign
     2963                 v-object-handle = buf_temp-diasize-handle.handle-value
     2964               .
     2965               if v-object-handle <> v-diasize-resize-button
     2966               then do:
     2967                 assign
     2968                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2969                 .
     2970               end.
     2971             end.
     2972             assign
     2973               v-diasize-browse-handle :height = v-browse-height
     2974             .
     2975             for each buf_temp-browse-handle
