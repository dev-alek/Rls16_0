     1745        SIZE 2.9 BY .93.
     1746   DEFINE VARIABLE v-calc-method AS CHARACTER
     1747        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
     1748        LIST-ITEMS "1,2"
     1749        SIZE 15.3 BY 2.97 NO-UNDO.
     1750   DEFINE VARIABLE negative-rest AS LOGICAL INITIAL no
     1751        LABEL "Отрицательные остатки"
     1752        VIEW-AS TOGGLE-BOX
     1753        SIZE 31.4 BY .77
     1754        FGCOLOR 15  NO-UNDO.
     1755   DEFINE VARIABLE stts AS LOGICAL INITIAL no
     1756        LABEL "Удаленный товар?"
     1757        VIEW-AS TOGGLE-BOX
     1758        SIZE 31.4 BY .77
     1759        FGCOLOR 15  NO-UNDO.
     1760   DEFINE QUERY BR-tt-tax FOR
     1761         tt-tax SCROLLING.
     1762   DEFINE BROWSE BR-tt-tax
     1763     QUERY BR-tt-tax DISPLAY
     1764         tt-tax.tax-code
     1765         tt-tax.tax-name
     1766         tt-tax.tax-type
     1767         tt-tax.rate-code
     1768         tt-tax.rate-name
     1769         tt-tax.rate-value
     1770       WITH NO-ROW-MARKERS SIZE 58.6 BY 6.3
     1771            TITLE "Ставки налогов".
     1772   DEFINE FRAME u-gds-form
     1773        b-exit AT ROW 1 COL 1
     1774        b-quit AT ROW 1 COL 11
     1775        b-list AT ROW 1 COL 31
     1776        B-grp AT ROW 1 COL 41
     1777        b-prt AT ROW 1 COL 51
     1778        b-help AT ROW 1 COL 71
     1779        add-inf AT ROW 2 COL 71
     1780        gds-name AT ROW 5.3 COL 15.3 COLON-ALIGNED NO-LABEL
     1781        alpha1 AT ROW 6.3 COL 62.4 COLON-ALIGNED NO-LABEL
     1782        r-alpha1 AT ROW 6.33 COL 69.8
     1783        engl-name AT ROW 6.37 COL 15.4 COLON-ALIGNED NO-LABEL
     1784        label-name AT ROW 7.53 COL 15.5 COLON-ALIGNED NO-LABEL
     1785        chk-name AT ROW 8.53 COL 15.5 COLON-ALIGNED NO-LABEL
     1786        OKDP AT ROW 8.57 COL 69.8 COLON-ALIGNED NO-LABEL
     1787        ms-base AT ROW 9.8 COL 58.8 COLON-ALIGNED NO-LABEL
     1788        unit-cli AT ROW 9.87 COL 14.8 COLON-ALIGNED NO-LABEL
     1789        r-base AT ROW 9.93 COL 24
     1790        v-calc-method AT ROW 10.2 COL 71.4 NO-LABEL
     1791        wt-base AT ROW 10.7 COL 58.8 COLON-ALIGNED NO-LABEL
     1792        min-rate AT ROW 11.13 COL 31.5 COLON-ALIGNED NO-LABEL
     1793        cli-base-rate AT ROW 11.17 COL 6.9 COLON-ALIGNED NO-LABEL
     1794        ms-cart AT ROW 11.7 COL 58.8 COLON-ALIGNED NO-LABEL
     1795        qnty-cart AT ROW 12.47 COL 16.7 COLON-ALIGNED NO-LABEL
     1796        increase-pc AT ROW 12.5 COL 89.6 COLON-ALIGNED NO-LABEL
     1797        wt-cart AT ROW 12.7 COL 58.8 COLON-ALIGNED NO-LABEL
     1798        max-rate AT ROW 13.47 COL 31.1 COLON-ALIGNED NO-LABEL
     1799        B-add-tt-tax AT ROW 13.83 COL 7.8
     1800        B-del-tt-tax AT ROW 13.83 COL 16.9
     1801        PS AT ROW 14.03 COL 68.4 NO-LABEL
     1802        BR-tt-tax AT ROW 14.97 COL 2.5
     1803        negative-rest AT ROW 18.27 COL 65.3
     1804        stts AT ROW 19.3 COL 65.5
     1805        EDITOR-1 AT ROW 21.27 COL 1.8 NO-LABEL
     1806        n-grp-full AT ROW 3.07 COL 32.4 COLON-ALIGNED NO-LABEL
     1807        grp-full AT ROW 3.07 COL 40.1 COLON-ALIGNED NO-LABEL
     1808        FILL-IN-4 AT ROW 4.2 COL 32.8 COLON-ALIGNED NO-LABEL
     1809        ub.gds-prt.node-name AT ROW 4.2 COL 40 COLON-ALIGNED NO-LABEL
     1810              VIEW-AS TEXT
     1811             SIZE 51.3 BY 1
     1812             BGCOLOR 3 FGCOLOR 15
     1813        n-gds-name AT ROW 5.3 COL 5.3 COLON-ALIGNED NO-LABEL
     1814        n-engl-name AT ROW 6.33 COL 4.4 COLON-ALIGNED NO-LABEL
     1815        country_name AT ROW 6.33 COL 71 COLON-ALIGNED NO-LABEL
     1816        n-alpha1 AT ROW 6.37 COL 54.6 COLON-ALIGNED NO-LABEL
     1817        n-label-name AT ROW 7.53 COL 4.5 COLON-ALIGNED NO-LABEL
     1818        n-chk-name AT ROW 8.63 COL 4.4 COLON-ALIGNED NO-LABEL
     1819        n-okdp AT ROW 8.63 COL 64.9 NO-LABEL
     1820        n-ms-base AT ROW 9.77 COL 47.5 COLON-ALIGNED NO-LABEL
     1821        n-unit-cli AT ROW 9.93 COL 2.6 COLON-ALIGNED NO-LABEL
     1822        n-min-rate AT ROW 10 COL 27.9 COLON-ALIGNED NO-LABEL
     1823        n-wt-base AT ROW 10.7 COL 47.4 COLON-ALIGNED NO-LABEL
     1824        n-increase-pc AT ROW 11.03 COL 87.8 COLON-ALIGNED NO-LABEL
     1825        n-cli-base-rate AT ROW 11.13 COL 1.5 COLON-ALIGNED NO-LABEL
     1826        n-ms-cart AT ROW 11.77 COL 47.5 COLON-ALIGNED NO-LABEL
     1827        n-max-rate AT ROW 12.33 COL 27.8 COLON-ALIGNED NO-LABEL
     1828        n-qnty-cart AT ROW 12.47 COL 5.4 COLON-ALIGNED NO-LABEL
     1829        n-wt-cart AT ROW 12.7 COL 47.4 COLON-ALIGNED NO-LABEL
     1830        n-PS AT ROW 15.27 COL 61.9 NO-LABEL
     1831        l-negative-rest AT ROW 18.17 COL 62.1
     1832        l-grp-full AT ROW 3.13 COL 31.4
     1833        l-okdp AT ROW 8.7 COL 62.5
     1834        l-max-rate AT ROW 13.53 COL 29.8
     1835        l-tt-tax AT ROW 13.93 COL 3
     1836        l-PS AT ROW 14.07 COL 64.5
     1837        l-gds-name AT ROW 5.33 COL 3.1
     1838        l-engl-name AT ROW 6.33 COL 3
     1839        l-alpha1 AT ROW 6.43 COL 53.1
     1840        l-wt-cart AT ROW 13.07 COL 46.5
     1841       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1842            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1843            DEFAULT-BUTTON b-list CANCEL-BUTTON b-quit.
     1844   DEFINE FRAME u-gds-form
     1845        l-cli-base-rate AT ROW 11 COL 1.8
     1846        l-ms-cart AT ROW 12.07 COL 46.5
     1847        l-min-rate AT ROW 11.13 COL 30.1
     1848        l-unit-cli AT ROW 10 COL 1.8
     1849        l-qnty-cart AT ROW 12.53 COL 4.5
     1850        l-calc-method AT ROW 10 COL 87.4
     1851        l-increase-pc AT ROW 9.93 COL 96.4
     1852        l-node-name AT ROW 4.07 COL 31.5
     1853        l-stts AT ROW 19.13 COL 62.1
     1854        l-chk-name AT ROW 8.63 COL 3
     1855        l-label-name AT ROW 7.53 COL 3.1
     1856        l-wt-base AT ROW 11.07 COL 46.5
     1857        l-ms-base AT ROW 10.07 COL 46.5
     1858        SPACE(50.36) SKIP(11.77)
     1859       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1860            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1861            TITLE "Введите данные для пакетной обработки по списку товаров"
     1862            DEFAULT-BUTTON b-list CANCEL-BUTTON b-quit.
     1863   ASSIGN
     1864          FRAME u-gds-form:SCROLLABLE       = FALSE
     1865          FRAME u-gds-form:HIDDEN           = TRUE.
     1866   ASSIGN
     1867          EDITOR-1:RETURN-INSERTED IN FRAME u-gds-form  = TRUE
     1868          EDITOR-1:READ-ONLY IN FRAME u-gds-form        = TRUE.
     1869   ON WINDOW-CLOSE OF FRAME u-gds-form
     1870   DO:
     1871     APPLY "END-ERROR":U TO SELF.
     1872   END.
     1873   ON CHOOSE OF add-inf IN FRAME u-gds-form
     1874   DO:
     1875         run utl/pu51121.w (
     1876                        input parparentproc
     1877                       ,input v-cntxt-obj-type
     1878                       ,input v-cntxt-obj-code
     1879                       ,output destin_
     1880                       ,output attrib_
     1881                       ,output user-rule_
     1882                       ,output sert_
     1883                       ,output struct_
     1884                       ,output deadline_
     1885                       ,output sort_
     1886                       ,output nationality_
     1887                       ,output tnved_
     1888                       ,output unit-cst_
     1889                       ,output cst-base-rate_
     1890                       ,output normal-wastage_
     1891                       ,output normal-waste_
     1892                       ,output cond-keep-code_
     1893                       ,output proof_).
     1894   END.
     1895   ON LEAVE OF alpha1 IN FRAME u-gds-form
     1896   DO:
     1897       APPLY "RETURN" to alpha1.
     1898   END.
     1899   ON RETURN OF alpha1 IN FRAME u-gds-form
     1900   DO:
     1901    define variable v-rid-list as character no-undo .
     1902       FIND FIRST country where
     1903                           country.alpha1 = input frame u-gds-form alpha1 No-LOCK No-ERROR.
     1904   IF NOT AVAIL country then do:
     1905               run ref/countris.w (
     1906                               input parparentproc
     1907                              ,input "b-sel"
     1908                     ,input-output v-rid-list ).
     1909     if v-rid-list = "" then do:
     1910                       apply "entry" to alpha1 in frame u-gds-form.
     1911                       return no-apply.
     1912                   end.
     1913               FIND country WHERE recid (country) = integer(v-rid-list) NO-LOCK.
     1914               DISPLAY
     1915               country.alpha1 @ alpha1
     1916               country.short-name @ country_name
     1917               with frame u-gds-form.
     1918       end.
     1919       else do:
     1920           assign
     1921           country_name = country.short-name.
     1922           display country_name with frame u-gds-form.
     1923       end.
     1924   END.
     1925   ON RIGHT-MOUSE-CLICK OF alpha1 IN FRAME u-gds-form
     1926   DO:
     1927       assign
     1928       l-alpha1:fgcolor = 15
     1929       alpha1 = ""
     1930       l-alpha1:visible = true
     1931       country_name = "".
     1932       display alpha1 country_name with frame u-gds-form.
     1933       disable alpha1 with frame u-gds-form.
     1934       disable r-alpha1 with frame u-gds-form.
     1935   END.
     1936   ON CHOOSE OF B-add-tt-tax IN FRAME u-gds-form
     1937   DO:
     1938   DEFINE var tax-rate-rid As char NO-UNDO init "".
     1939   DEFINE var taxvalue like ub.tax-rate-value.rate-value NO-UNDO.
     1940   DEFINE buffer bf-tt-tax for tt-tax.
     1941     run ref/tax-tree.w (
     1942                      input parparentproc
     1943                     ,input "b-seltax-rate":U
     1944                     ,input "ALL-TAX-RATES":U
     1945                     ,input v-cntxt-host-code-obj
     1946                     ,input v-cntxt-obj-type
     1947                     ,input v-cntxt-obj-code
     1948                     ,input ?
     1949                     ,input-output tax-rate-rid) no-error .
     1950     IF ERROR-STATUS:error then return no-apply.
     1951     if tax-rate-rid <> "" then do:
     1952       FIND FIRST ub.tax-rate NO-LOCK WHERE recid(ub.tax-rate) = integer(tax-rate-rid) NO-ERROR.
     1953       if NOT AVAIL ub.tax-rate then return no-apply.
     1954       FIND first bf-tt-tax No-LOCK WHERE
     1955                                      bf-tt-tax.tax-code = ub.tax-rate.tax-code NO-ERROR.
     1956       IF avail bf-tt-tax then do:
     1957           message "В списке ставок налогов уже есть ставка по такому налогу!" view-as
     1958           alert-box ERROR.
     1959           return no-apply.
     1960       end.
     1961       FIND FIRST ub.tax NO-LOCK WHERE ub.tax.tax-code = ub.tax-rate.tax-code NO-ERROR.
     1962       if NOT AVAIL ub.tax then return no-apply.
     1963       if ub.tax.individual then do:
     1964           message "Нельзя редактировать налоги на товар, если налог индивидуальный!"
     1965           view-as alert-box ERROR.
     1966           return no-apply.
     1967       end.
     1968   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1969   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     1970     (input  ?
     1971     ,input  ub.tax-rate.tax-code
     1972     ,input  ub.tax-rate.rate-code
     1973     ,input  ?
     1974     ,input  v-cntxt-host-code-obj
     1975     ,input  v-cntxt-obj-type
     1976     ,input  v-cntxt-obj-code
     1977     ,output taxvalue
     1978     ) no-error .
     1979       if error-status:error or taxvalue = ? then return no-apply.
     1980       create
     1981       tt-tax.
     1982       assign
     1983       tt-tax.tax-code = ub.tax.tax-code
     1984       tt-tax.tax-name = ub.tax.tax-name
     1985       tt-tax.rate-code = ub.tax-rate.rate-code
     1986       tt-tax.rate-name = ub.tax-rate.rate-name
     1987       tt-tax.tax-type = ub.tax.tax-type
     1988       tt-tax.rate-value = taxvalue
     1989       tt-tax.tax-rate-gds-rc = ?
     1990       .
     1991       OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
     1992     end.
     1993   END.
     1994   ON CHOOSE OF B-del-tt-tax IN FRAME u-gds-form
     1995   DO:
     1996       DEFINE BUFFER bf-tt-tax for tt-tax.
     1997       IF AVAIL tt-tax then do:
     1998           FIND FIRST bf-tt-tax WHERE bf-tt-tax.tax-code = tt-tax.tax-code NO-ERROR.
     1999           if avail bf-tt-tax then delete bf-tt-tax.
     2000           OPEN QUERY BR-tt-tax for each tt-tax NO-LOCK.
     2001       end.
     2002   END.
     2003   ON CHOOSE OF b-exit IN FRAME u-gds-form
     2004   DO:
     2005     define variable v-parameter as character no-undo .
     2006     define variable glog as logical no-undo .
     2007     define variable mystr as char format "X(500)".
     2008     DEFINE VARIABLE par-date as date no-undo .
     2009     DEFINE VARIABLE v-today as date no-undo .
     2010     DEFINE VARIABLE v-time as integer no-undo .
     2011     DEFINE VARIABLE var-fact-order like ub.tax-rate-value.fact-order no-undo .
     2012     define buffer cli-units for ub.units.
     2013     if NOT can-find(first gds-list) then do:
     2014       BELL.
     2015       message "В списке товаров нет ни одного товара!" view-as alert-box WARNING.
     2016       return no-apply.
     2017     end.
     2018     assign
     2019     v-calc-method cli-base-rate engl-name label-name chk-name gds-name grp-full increase-pc
     2020     ms-base wt-base ms-cart negative-rest OKDP PS min-rate max-rate qnty-cart stts unit-cli wt-cart
     2021     alpha1
     2022     .
     2023     IF cli-base-rate:sensitive and cli-base-rate <> 1 then do:
     2024       message "ВНИМАНИЕ!" skip
     2025       "Для товаров, у которых базовая ед.изм. совпадает с ед.изм.поставщика,"
     2026       "изменения будут отклонены (задан коэф. не равный 1)!" view-as alert-box
     2027       WARNING.
     2028     end.
     2029     IF unit-cli:sensitive then do:
     2030       FIND FIRST cli-units No-LOCK WHERE cli-units.unit-name = unit-cli No-ERROR.
     2031       if LOOKUP('топ':U, cli-units.type) > 0 then
     2032       message "ВНИМАНИЕ!" skip
     2033       "Для товаров, у которых ед.изм.поставщика имеет топливный тип, а  базовая ед.изм. нет,"
     2034       "изменения будут отклонены!" view-as alert-box
     2035       WARNING.
     2036       else
     2037       message "ВНИМАНИЕ!" skip
     2038       "Для товаров, у которых базовая ед.изм. имеет топливный тип, а ед.изм.поставщика нет,"
     2039       "изменения будут отклонены!" view-as alert-box
     2040       WARNING.
     2041     end.
     2042     IF br-tt-tax:sensitive then do:
     2043       message "ВНИМАНИЕ!" skip
     2044       "Для товаров, у которых тип базовой ед.изм. не включен в список типов базовых ед.изм.," skip
     2045       "для которых определен налог, изменения списка ставок налогов по товару" skip
     2046       "                             будут отклонены!" view-as alert-box
     2047       WARNING.
     2048       run gbl/d-prompt.w (
     2049         'title=':u + "Введите дату, с которой начнут действовать новые ставки налогов" + '\':u
     2050       + 'text1=':u + " ДАТА" + '\':u
     2051       + 'format=' + "99/99/9999" + '\':u
     2052       + 'type=' + 'T':U + '\':u
     2053       + 'fillin_row=2\':u
     2054       + 'fillin_col=4\':u
     2055       + 'fillin_width=12\':u
     2056       + 'fillin_height=1\':u
     2057       + 'max-chars=70\':u
     2058       + 'readonly=no\':u
     2059       , input-output par-date
     2060       ).
     2061       if return-value = 'false':u then do:
     2062               return no-apply.
     2063           end.
     2064       run cur-time in this-procedure ( output v-today, output v-time).
     2065       run factord-end-day in this-procedure ( input (if par-date = ? then v-today else par-date) , output var-fact-order).
     2066     end.
     2067     IF min-rate:sensitive OR max-rate:sensitive then do:
     2068       message "ВНИМАНИЕ!" skip
     2069       "Для товаров у которых тип базовой ед.изм. не " '2ед':U "," skip
     2070       "изменения Min или MAx количества в штуке будут отклонены!"
     2071       view-as alert-box WARNING.
     2072     END.
     2073     mystr =   (IF gds-name:sensitive then ("НАЗВАНИЕ="+ gds-name + chr(10) ) else "") +
     2074     (IF engl-name:sensitive then ("АНГЛ.НАЗВАНИЕ=" + engl-name + chr(10) ) else "") +
     2075     (IF label-name:sensitive then ("ЭТИКЕТКА=" + label-name + chr(10) ) else "") +
     2076     (IF chk-name:sensitive then ("НА ЧЕКЕ=" + chk-name + chr(10) ) else "") +
     2077     (IF unit-cli:sensitive then ("Един. изм. пост-ка=" + unit-cli + chr(10) ) else "") +
     2078     (IF cli-base-rate:sensitive then ("Коэффициент к ед. изм. пост-ка=" + string(cli-base-rate)
     2079                                             + chr(10) ) else "") +
     2080     (IF okdp:sensitive then ("ОКДП=" + okdp + chr(10) ) else "") +
     2081     (IF v-calc-method:sensitive then ("Расчет цены по=" + v-calc-method + chr(10) ) else "") +
     2082     (IF increase-pc:sensitive then ("Наценка=" + string(increase-pc) + chr(10) ) else "") +
     2083     (IF negative-rest:sensitive then ("Отриц.остатки разрешены - " + string(negative-rest,"да/нет") + chr(10) )
     2084                                                   else "") +
     2085     (IF stts:sensitive then ("Товар удален - " + string(stts,"да/нет") + chr(10) ) else "") +
     2086     (IF min-rate:sensitive then ("Min кол-во в штуке=" + string(min-rate) + chr(10) ) else "") +
     2087     (IF max-rate:sensitive then ("Max кол-во в штуке=" + string(max-rate) + chr(10) ) else "") +
     2088     (IF qnty-cart:sensitive then ("Кол-во в упаковке=" + string(qnty-cart) + chr(10) ) else "") +
     2089     (IF ms-base:sensitive then ("Объем штуки=" + string(ms-base) + chr(10) ) else "") +
     2090     (IF wt-base:sensitive then ("Вес штуки=" + string(wt-base) + chr(10) ) else "") +
     2091     (IF ms-cart:sensitive then ("Объем упаковки=" + string(ms-cart) + chr(10) ) else "") +
     2092     (IF wt-cart:sensitive then ("Вес упаковки=" + string(wt-cart) + chr(10) ) else "") +
     2093     (IF PS:sensitive then ("Примечание=" + PS + chr(10) ) else "") +
     2094     (IF destin_ <> ? then ("Назначение=" + destin_ + chr(10) ) else "") +
     2095     (IF attrib_ <> ? then ("Характеристики=" + attrib_ + chr(10) ) else "") +
     2096     (IF sert_ <> ? then ("Сертификат=" + sert_ + chr(10)) else "") +
     2097     (IF sort_ <> ? then ("Сорт=" + sort_ + chr(10)) else "") +
     2098     (IF normal-wastage_ <> ? then ("Норма ест.убыли=" + string(normal-wastage_, "->9.99%") + chr(10)) else "") +
     2099     (IF normal-waste_ <> ? then ("Норма отходов=" + string(normal-waste_, "->9.99%") + chr(10)) else "") +
     2100     (IF cond-keep-code_ <> ? then ("Код услов.хран.=" + string(cond-keep-code_) + chr(10)) else "") +
     2101     (IF proof_ <> ? then ("Алкоголь %=" + string(proof_) + chr(10)) else "") +
     2102     (IF Struct_ <> ? then ("Состав(комплектность)=" + struct_ + chr(10)) else "") +
     2103     (IF user-rule_ <> ? then ("Правила эксплуатации=" + user-rule_ + chr(10)) else "") +
     2104     (IF Deadline_ <> ? then ("Срок годности=" + string(deadline_) + chr(10)) else "") +
     2105     (IF tnved_ <> ? then ("Код ТНВЭД=" + tnved_ + chr(10)) else "") +
     2106     (IF unit-cst_ <> ? then ("Тамож. ед-ца изм.=" + unit-cst_ + chr(10)) else "") +
     2107     (IF cst-base-rate_ <> ? then ("Коэффициент к тамож.ед=" + string(cst-base-rate_)
     2108                                                                + chr(10)) else "") +
     2109     (IF nationality_ <> ? then ("Статус товара(национальность)=" + nationality_ + chr(10)) else "") +
     2110     (IF alpha1:sensitive then ("Страна изготовления=" + alpha1 + chr(10)) else "").
     2111     IF br-tt-tax:sensitive then do:
     2112       for each tt-tax:
     2113           mystr = mystr + chr(10) + "Ставка налога " + string(tt-tax.rate-code)
     2114                   + " текущее значение ставки " + string(tt-tax.rate-value).
     2115       end.
     2116     end.
     2117     if REPLACE(mystr, chr(10), "")  = "" then do:
     2118       message "Не выбраны поля и значения для внесения изменений" view-as alert-box
     2119       Warning.
     2120       return no-apply.
     2121     end.
     2122     message "В выбранных товарах будут произведены следующие изменения:" skip
     2123     mystr skip "Продолжать?"
     2124     view-as alert-box QUESTION buttons YES-NO update glog.
     2125     IF not glog then return no-apply.
     2126     assign
     2127     v-parameter = "gdsuform":U + chr(1) +
     2128                   "":U + chr(1) +
     2129                 v-cntxt-obj-type                                                                                    + chr(4) +
     2130                 string(v-cntxt-obj-code)                                                                            + chr(4) +
     2131                 string(var-fact-order)                                                                              + chr(4) +
     2132                 (IF gds-name:sensitive then gds-name else "":U)                                                     + chr(4) +
     2133                 (IF engl-name:sensitive then engl-name else "":U)                                                   + chr(4) +
     2134                 (IF label-name:sensitive then label-name else "":U)                                                 + chr(4) +
     2135                 (IF chk-name:sensitive then chk-name else "":U)                                                     + chr(4) +
     2136                 (IF alpha1:sensitive then alpha1 else "":U)                                                         + chr(4) +
     2137                 (IF unit-cli:sensitive then unit-cli else "":U)                                                     + chr(4) +
     2138                 (IF max-rate:sensitive      then string(max-rate)  else "")                                         + chr(4) +
     2139                 (IF min-rate:sensitive      then string(min-rate)  else "")                                         + chr(4) +
     2140                 (IF cli-base-rate:sensitive then string(cli-base-rate) else "")                                     + chr(4) +
     2141                 (IF qnty-cart:sensitive     then string(qnty-cart) else "")                                         + chr(4) +
     2142                 (IF ms-base:sensitive       then string(ms-base) else "")                                           + chr(4) +
     2143                 (IF wt-base:sensitive       then string(wt-base) else "")                                           + chr(4) +
     2144                 (IF ms-cart:sensitive       then string(ms-cart) else "")                                           + chr(4) +
     2145                 (IF wt-cart:sensitive       then string(wt-cart) else "")                                           + chr(4) +
     2146                 (IF v-calc-method:sensitive then v-calc-method   else "")                                           + chr(4) +
     2147                 (IF increase-pc:sensitive   then string(increase-pc) else "")                                       + chr(4) +
     2148                 (IF negative-rest:sensitive then string(negative-rest) else "")                                     + chr(4) +
     2149                 (IF okdp:sensitive          then okdp else "")                                                      + chr(4) +
     2150                 (IF destin_ <> ?            then destin_ else "")                                                   + chr(4) +
     2151                 (IF attrib_ <> ?            then attrib_ else "")                                                   + chr(4) +
     2152                 (IF user-rule_<> ?          then user-rule_ else "")                                                + chr(4) +
     2153                 (IF sert_ <> ?              then sert_ else "")                                                     + chr(4) +
     2154                 (IF struct_<> ?             then struct_ else "")                                                   + chr(4) +
     2155                 (IF deadline_ <> ?          then string(deadline_) else "")                                         + chr(4) +
     2156                 (IF cond-keep-code_ <> ?    then string(cond-keep-code_) else "")                                   + chr(4) +
     2157                 (IF sort_ <> ?              then sort_ else "")                                                     + chr(4) +
     2158                 (IF proof_ <> ?             then string(proof_) else "")                                            + chr(4) +
     2159                 (IF normal-wastage_ <> ?    then string(normal-wastage_) else "")                                   + chr(4) +
     2160                 (IF normal-waste_ <> ?      then string(normal-waste_) else "")                                     + chr(4) +
     2161                 (IF tnved_ <> ?             then tnved_ else "")                                                    + chr(4) +
     2162                 (IF nationality_ <> ?       then nationality_ else "")                                              + chr(4) +
     2163                 (IF unit-cst_ <> ?          then unit-cst_ else "")                                                 + chr(4) +
     2164                 (IF cst-base-rate_ <> ?     then string(cst-base-rate_) else "")                                    + chr(4) +
     2165                 "":U                                                                                                + chr(4) +
     2166                 (IF ps:sensitive            then ps else "")                                                        + chr(4) +
     2167                 (IF br-tt-tax:sensitive     then string(par-date, "99/99/9999") else "":U)                          + chr(4) +
     2168                 (IF stts:sensitive          then string(stts) else "")
     2169   .
     2170   v-parameter = v-parameter + chr(1).
     2171   v-parameter = v-parameter +
     2172                 (IF gds-name:sensitive      then "yes" else "no":U)                                                 + chr(4) +
     2173                 (IF engl-name:sensitive     then "yes" else "no":U)                                                 + chr(4) +
     2174                 (IF label-name:sensitive    then "yes" else "no":U)                                                 + chr(4) +
     2175                 (IF chk-name:sensitive      then "yes" else "no":U)                                                 + chr(4) +
     2176                 (IF alpha1:sensitive        then "yes" else "no":U)                                                 + chr(4) +
     2177                 (IF unit-cli:sensitive      then "yes" else "no":U)                                                 + chr(4) +
     2178                 (IF max-rate:sensitive      then "yes" else "no":U)                                                 + chr(4) +
     2179                 (IF min-rate:sensitive      then "yes" else "no":U)                                                 + chr(4) +
     2180                 (IF cli-base-rate:sensitive then "yes" else "no":U)                                                 + chr(4) +
     2181                 (IF qnty-cart:sensitive     then "yes" else "no":U)                                                 + chr(4) +
     2182                 (IF ms-base:sensitive       then "yes" else "no":U)                                                 + chr(4) +
     2183                 (IF wt-base:sensitive       then "yes" else "no":U)                                                 + chr(4) +
     2184                 (IF ms-cart:sensitive       then "yes" else "no":U)                                                 + chr(4) +
     2185                 (IF wt-cart:sensitive       then "yes" else "no":U)                                                 + chr(4) +
     2186                 (IF v-calc-method:sensitive then "yes" else "no":U)                                                 + chr(4) +
     2187                 (IF increase-pc:sensitive   then "yes" else "no":U)                                                 + chr(4) +
     2188                 (IF negative-rest:sensitive then "yes" else "no":U)                                                 + chr(4) +
     2189                 (IF okdp:sensitive          then "yes" else "no":U)                                                 + chr(4) +
     2190                 (IF destin_ <> ?            then "yes" else "no":U)                                                 + chr(4) +
     2191                 (IF attrib_ <> ?            then "yes" else "no":U)                                                 + chr(4) +
     2192                 (IF user-rule_ <> ?         then "yes" else "no":U)                                                 + chr(4) +
     2193                 (IF sert_ <> ?              then "yes" else "no":U)                                                 + chr(4) +
     2194                 (IF struct_ <> ?            then "yes" else "no":U)                                                 + chr(4) +
     2195                 (IF deadline_ <> ?          then "yes" else "no":U)                                                 + chr(4) +
     2196                 (IF cond-keep-code_ <> ?    then "yes" else "no":U)                                                 + chr(4) +
     2197                 (IF sort_ <> ?              then "yes" else "no":U)                                                 + chr(4) +
     2198                 (IF proof_ <> ?             then "yes" else "no":U)                                                 + chr(4) +
     2199                 (IF normal-wastage_ <> ?    then "yes" else "no":U)                                                 + chr(4) +
     2200                 (IF normal-waste_ <> ?      then "yes" else "no":U)                                                 + chr(4) +
     2201                 (IF tnved_ <> ?             then "yes" else "no":U)                                                 + chr(4) +
     2202                 (IF nationality_ <> ?       then "yes" else "no":U)                                                 + chr(4) +
     2203                 (IF unit-cst_ <> ?          then "yes" else "no":U)                                                 + chr(4) +
     2204                 (IF cst-base-rate_ <> ?     then "yes" else "no":U)                                                 + chr(4) +
     2205                 "no":U                                                                                              + chr(4) +
     2206                 (IF ps:sensitive            then "yes" else "no":U)                                                 + chr(4) +
     2207                 (IF stts:sensitive          then "yes" else "no":U)                                                 + chr(4) +
     2208                 (IF br-tt-tax:sensitive     then "yes" else "no":U)
     2209    .
     2210     run str/diallog.w (
     2211                   input parparentproc
     2212                 , input this-procedure
     2213                 , input 'utl/goods01r.p':U
     2214                 , input v-parameter
     2215                 , input no
     2216                 , input "&Стоп"
     2217                 , input 'Изменение товаров по списку') .
     2218   END.
     2219   ON CHOOSE OF B-grp IN FRAME u-gds-form
     2220   DO:
     2221   define variable v-grp as character no-undo .
     2222   define variable glog as logical no-undo .
     2223       glog = yes.
     2224       message "Выберите группу, в которую нужно переместить товары списка."
     2225       view-as alert-box question buttons OK-Cancel update glog.
     2226       if not glog then do:
     2227          return no-apply.
     2228       end.
     2229       run ref/gds-grp.w (
     2230                      input parparentproc
     2231                     ,input ('терм':U + ',b-sel')
     2232                     ,input v-cntxt-obj-type
     2233                     ,input v-cntxt-obj-code
     2234                     ,input-output v-grp ).
     2235       if v-grp = "" then do:
     2236          return no-apply.
     2237       end.
     2238       FIND ub.gds-grp WHERE recid (ub.gds-grp) = integer (v-grp) .
     2239       grp-full = "".
     2240       RUN grplib-get-full-name in this-procedure
     2241                                                  ( input ub.gds-grp.node-code, output grp-full).
     2242       DISPLAY grp-full with frame u-gds-form.
     2243   END.
     2244   ON CHOOSE OF b-list IN FRAME u-gds-form
     2245   DO:
     2246       run str/gds-list.w (
     2247                            input parparentproc
     2248                          , input v-cntxt-host-code-obj
     2249                          , input v-cntxt-obj-type
     2250                          , input v-cntxt-obj-code) .
     2251   END.
     2252   ON CHOOSE OF b-prt IN FRAME u-gds-form
     2253   DO:
     2254   define variable glog as logical no-undo .
     2255   define variable ref-rec as recid no-undo .
     2256       message "Выберите шкалу, которую надо приписать товарам списка."
     2257       view-as alert-box question buttons OK-Cancel update glog.
     2258       if not glog then do:
     2259          return no-apply.
     2260       end.
     2261      run ref/gdsprts.w (
     2262                          input parparentproc
     2263                         ,input yes
     2264                         ,output ref-rec).
     2265      if ref-rec = ? then do:
     2266         return no-apply.
     2267      end.
     2268      FIND ub.gds-prt WHERE recid (ub.gds-prt) = ref-rec.
     2269      DISPLAY ub.gds-prt.node-name with frame u-gds-form.
     2270   END.
     2271   ON CHOOSE OF b-quit IN FRAME u-gds-form
     2272   DO:
     2273   define variable glog as logical no-undo .
     2274       IF can-find( first gds-list) then do:
     2275           message "Вы действительно хотите выйти (список товаров при этом сохранен не будет)?"
     2276           view-as alert-box WARNING buttons YES-NO update glog.
     2277           if not glog then return no-apply.
     2278       end.
     2279   END.
     2280   ON RIGHT-MOUSE-CLICK OF BR-tt-tax IN FRAME u-gds-form
     2281   DO:
     2282       for each tt-tax:
     2283           delete tt-tax.
     2284       end.
     2285       OPEN QUERY br-tt-tax for each tt-tax.
     2286       assign
     2287       l-tt-tax:visible = true.
     2288       display BR-tt-tax with frame u-gds-form.
     2289       disable
     2290       b-add-tt-tax
     2291       b-del-tt-tax
     2292       br-tt-tax
     2293       with frame u-gds-form.
     2294   END.
     2295   ON RIGHT-MOUSE-CLICK OF chk-name IN FRAME u-gds-form
     2296   DO:
     2297       assign
     2298       n-chk-NAME:fgcolor = 15
     2299       chk-NAME = ""
     2300       l-chk-NAME:visible = true.
     2301       display chk-NAME with frame u-gds-form.
     2302       disable chk-NAME with frame u-gds-form.
     2303   END.
