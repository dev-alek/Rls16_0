     3579           where buf_temp-browse-handle.browse-type = 'width':u
     3580         on error undo move_block, retry move_block
     3581         :
     3582           assign
     3583             buf_temp-browse-handle.browse-handle :width
     3584               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3585             no-error .
     3586           if error-status :error
     3587           or error-status :get-message(1) <> ""
     3588           then do:
     3589             undo move_block, retry move_block .
     3590           end.
     3591         end.
     3592         assign
     3593           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3594           no-error .
     3595         if error-status :error
     3596         or error-status :get-message(1) <> ""
     3597         then do:
     3598           undo move_block, retry move_block.
     3599         end.
     3600         assign
     3601           frame u-gds-form :width = frame u-gds-form :width + p-change-value
     3602         no-error .
     3603         if error-status :error
     3604         or error-status :get-message(1) <> ""
     3605         then do:
     3606           undo move_block, retry move_block.
     3607         end.
     3608         if frame u-gds-form :scrollable = true
     3609         then do:
     3610           assign
     3611             frame u-gds-form :virtual-width = frame u-gds-form :virtual-width + p-change-value
     3612           no-error .
     3613           if error-status :error
     3614           or error-status :get-message(1) <> ""
     3615           then do:
     3616             undo move_block, retry move_block.
     3617           end.
     3618         end.
     3619       end.
     3620       if p-move-resize
     3621       then do:
     3622         run diasize_position-resize-button in this-procedure .
     3623       end.
     3624       if v-diasize-wndstore = true
     3625       then do:
     3626         if connected("ub") = true
     3627         then do:
     3628           define variable v-cntxt-db-num        as integer   no-undo .
     3629           define variable v-cntxt-userid        as character no-undo .
     3630           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3631                                             , OUTPUT v-cntxt-userid
     3632                                             ) .
     3633           run gbl/wndsizew.p
     3634             (input  v-cntxt-db-num
     3635             ,input  v-cntxt-userid
     3636             ,input  v-diasize-proc-name
     3637             ,input  'width':u
     3638             ,input  string(frame u-gds-form :width - v-diasize-orig-frame-width)
     3639             ) .
     3640         end.
     3641       end.
     3642     end.
     3643     assign
     3644       v-diasize-change-size = false
     3645     .
     3646   end procedure.
     3647   procedure diasize_set-width :
     3648     define input  parameter p-new-width  as decimal   no-undo .
     3649     define input  parameter p-move-resize as logical   no-undo .
     3650     do
     3651     on error undo, return error return-value
     3652     :
     3653       run diasize_change-width in this-procedure
     3654         (input  (p-new-width - frame u-gds-form :width)
     3655         ,input  p-move-resize
     3656         ) .
     3657     end.
     3658   end procedure.
     3659   procedure diasize_position-resize-button :
     3660     do with frame u-gds-form
     3661     :
     3662       hide v-diasize-resize-button .
     3663       assign
     3664         v-diasize-resize-button :row = frame u-gds-form :height - v-diasize-resize-button :height
     3665                     - 1
     3666                     - (frame u-gds-form :border-bottom-pixels / session :pixels-per-row)
     3667         v-diasize-resize-button :col = frame u-gds-form :width - v-diasize-resize-button :width
     3668                     - 1
     3669                     - (frame u-gds-form :border-right-pixels / session :pixels-per-column)
     3670       .
     3671       view v-diasize-resize-button .
     3672     end.
     3673   end procedure.
     3674   on alt-right anywhere
     3675   do:
     3676     run diasize_change-width in this-procedure
     3677       (input 1
     3678       ,input true
     3679       ) .
     3680     return no-apply .
     3681   end.
     3682   on alt-left anywhere
     3683   do:
     3684     run diasize_change-width in this-procedure
     3685       (input -1
     3686       ,input true
     3687       ) .
     3688     return no-apply .
     3689   end.
     3690   on alt-down anywhere
     3691   do:
     3692     run diasize_change-height in this-procedure
     3693       (input 1
     3694       ,input true
     3695       ) .
     3696     return no-apply .
     3697   end.
     3698   on alt-up anywhere
     3699   do:
     3700     run diasize_change-height in this-procedure
     3701       (input -1
     3702       ,input true
     3703       ) .
     3704     return no-apply .
     3705   end.
     3706   on alt-enter of frame u-gds-form
     3707   do:
     3708     run diasize_maximize in this-procedure
     3709       (input  ?
     3710       ).
     3711     return no-apply .
     3712   end.
     3713   procedure diasize_end-move :
     3714     do
     3715     on error undo, return error return-value
     3716     :
     3717       define variable v-row-delta as decimal   no-undo .
     3718       define variable v-col-delta as decimal   no-undo .
     3719       define variable v-new-row as decimal   no-undo .
     3720       define variable v-new-col as decimal   no-undo .
     3721       assign
     3722         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3723         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3724       .
     3725       assign
     3726         v-row-delta = v-new-row - frame u-gds-form :height
     3727         v-col-delta = v-new-col - frame u-gds-form :width
     3728       .
     3729       run diasize_change-height in this-procedure
     3730         (input v-row-delta
     3731         ,input true
     3732         ) .
     3733       run diasize_change-width in this-procedure
     3734         (input v-col-delta
     3735         ,input true
     3736         ) .
     3737     end.
     3738   end procedure.
     3739   procedure diasize_maximize :
     3740     define input  parameter p-action as logical   no-undo .
     3741     do
     3742     on error undo, return error return-value
     3743     :
     3744       if p-action = ?
     3745       then do:
     3746         if v-diasize-need-maximize = true
     3747         then do:
     3748           assign
     3749             p-action = true
     3750           .
     3751         end.
     3752         else do:
     3753           assign
     3754             p-action = false
     3755           .
     3756         end.
     3757       end.
     3758       if p-action = true
     3759       then do:
     3760         run diasize_change-height in this-procedure
     3761           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3762               - frame u-gds-form :height-chars
     3763           ,input true
     3764           ) .
     3765         run diasize_change-width in this-procedure
     3766           (input session :width-chars
     3767               - frame u-gds-form :width-chars
     3768           ,input true
     3769           ) .
     3770         assign
     3771           v-diasize-need-maximize = false
     3772         .
     3773       end.
     3774       else do:
     3775         run diasize_change-width in this-procedure
     3776           (input v-diasize-orig-frame-width
     3777               - frame u-gds-form :width-chars
     3778           ,input true
     3779           ) .
     3780         run diasize_change-height in this-procedure
     3781           (input v-diasize-orig-frame-height
     3782               - frame u-gds-form :height-chars
     3783           ,input true
     3784           ) .
     3785         assign
     3786           v-diasize-need-maximize = true
     3787         .
     3788       end.
     3789     end.
     3790   end procedure.
     3791   procedure diasize_restore-orig-size :
     3792     do
     3793     on error undo, return error return-value
     3794     :
     3795       assign
     3796         v-diasize-current-frame-width  = frame u-gds-form :width
     3797         v-diasize-current-frame-height = frame u-gds-form :height
     3798       .
     3799       run diasize_set-height in this-procedure
     3800         (input  v-diasize-orig-frame-height
     3801         ,input  true
     3802         ) .
     3803       run diasize_set-width in this-procedure
     3804         (input  v-diasize-orig-frame-width
     3805         ,input  true
     3806         ) .
     3807     end.
     3808   end procedure.
     3809   procedure diasize_restore-current-size :
     3810     do
     3811     on error undo, return error return-value
     3812     :
     3813       run diasize_set-height in this-procedure
     3814         (input  v-diasize-current-frame-height
     3815         ,input  true
     3816         ) .
     3817       run diasize_set-width in this-procedure
     3818         (input  v-diasize-current-frame-width
     3819         ,input  true
     3820         ) .
     3821     end.
     3822   end procedure.
     3823   procedure diasize_set-browse-handle :
     3824     define input  parameter p-browse-handle as handle   no-undo .
     3825     define buffer buf_temp-browse-handle for temp-browse-handle .
     3826     do
     3827     on error undo, return error return-value
     3828     :
     3829       assign
     3830         v-diasize-browse-handle = p-browse-handle
     3831       .
     3832       for each buf_temp-browse-handle
     3833       on error undo, return error return-value
     3834       :
     3835         delete buf_temp-browse-handle .
     3836       end.
     3837     end.
     3838   end procedure.
     3839   procedure diasize_add_browse :
     3840     define input  parameter p-browse-type   as character no-undo .
     3841     define input  parameter p-browse-handle as handle    no-undo .
     3842     define buffer buf_temp-browse-handle for temp-browse-handle .
     3843     do
     3844     on error undo, return error return-value
     3845     :
     3846       assign
     3847         v-diasize-browse-number = v-diasize-browse-number + 1
     3848       .
     3849       create buf_temp-browse-handle .
     3850       assign
     3851         buf_temp-browse-handle.browse-type   = p-browse-type
     3852         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3853         buf_temp-browse-handle.browse-handle = p-browse-handle
     3854       .
     3855     end.
     3856   end procedure.
     3857   procedure diasize_init :
     3858     define variable v-default-value    as logical   no-undo .
     3859     define variable v-restore-saved    as logical   no-undo .
     3860     define variable v-resize-value-str as character no-undo .
     3861     do
     3862     on error undo, return error return-value
     3863     :
     3864       do with frame u-gds-form
     3865       :
     3866         assign
     3867           v-diasize-orig-frame-height = frame u-gds-form :height
     3868           v-diasize-orig-frame-width  = frame u-gds-form :width
     3869           v-diasize-browse-handle     = browse BR-tt-tax :handle
     3870         .
     3871         create button v-diasize-resize-button
     3872         assign
     3873           parent        = frame u-gds-form :first-child
     3874           label         = "s"
     3875           height-pixels = 16
     3876           width-pixels  = 16
     3877           visible       = true
     3878           sensitive     = true
     3879           movable       = true
     3880           triggers:
     3881             on end-move persistent run diasize_end-move in this-procedure .
     3882           end triggers.
     3883         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3884         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3885         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3886         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3887         assign
     3888           v-diasize-wndmax = false
     3889         .
     3890         if connected("ub") = true
     3891         then do:
     3892           define variable v-cntxt-db-num        as integer   no-undo .
     3893           define variable v-cntxt-userid        as character no-undo .
     3894           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3895                                             , OUTPUT v-cntxt-userid
     3896                                             ) .
     3897           run gbl/wndpar_r.p
     3898             (input  v-cntxt-db-num
     3899             ,input  v-cntxt-userid
     3900             ,input  'wndmax':U
     3901             ,output v-diasize-wndmax
     3902             ,output v-default-value
     3903             ) .
     3904         end.
     3905         assign
     3906           v-diasize-wndstore = false
     3907         .
     3908         if connected("ub") = true
     3909         then do:
     3910           run gbl/wndpar_r.p
     3911             (input  v-cntxt-db-num
     3912             ,input  v-cntxt-userid
     3913             ,input  'wndstore':U
     3914             ,output v-diasize-wndstore
     3915             ,output v-default-value
     3916             ) .
     3917         end.
     3918         assign
     3919           v-diasize-proc-name = entry(1, program-name(2), '.')
     3920         .
     3921         if v-diasize-wndstore = true
     3922         then do:
     3923           assign
     3924             v-restore-saved = false
     3925           .
     3926           if connected("ub") = true
     3927           then do:
     3928             run gbl/wndsizer.p
     3929               (input  v-cntxt-db-num
     3930               ,input  v-cntxt-userid
     3931               ,input  v-diasize-proc-name
     3932               ,input  'height':u
     3933               ,output v-resize-value-str
     3934               ) .
     3935             if v-resize-value-str <> '':U
     3936             then do:
     3937               run diasize_change-height in this-procedure
     3938                 (input  integer(v-resize-value-str)
     3939                 ,input  true
     3940                 ) .
     3941               assign
     3942                 v-restore-saved = true
     3943               .
     3944             end.
     3945           end.
     3946           if connected("ub") = true
     3947           then do:
     3948             run gbl/wndsizer.p
     3949               (input  v-cntxt-db-num
     3950               ,input  v-cntxt-userid
     3951               ,input  v-diasize-proc-name
     3952               ,input  'width':u
     3953               ,output v-resize-value-str
     3954               ) .
     3955             if v-resize-value-str <> '':U
     3956             then do:
     3957               run diasize_change-width in this-procedure
     3958                 (input  integer(v-resize-value-str)
     3959                 ,input  true
     3960                 ) .
     3961               assign
     3962                 v-restore-saved = true
     3963               .
     3964             end.
     3965           end.
     3966           if v-restore-saved <> true
     3967           then do:
     3968             if v-diasize-wndmax = true
     3969             then do:
     3970               run diasize_maximize in this-procedure
     3971                 (input  true
     3972                 ) .
     3973             end.
     3974           end.
     3975         end.
     3976         else do:
     3977           if v-diasize-wndmax = true
     3978           then do:
     3979             run diasize_maximize in this-procedure
     3980               (input  true
     3981               ) .
     3982           end.
     3983         end.
     3984       end.
     3985     end.
     3986   end procedure.
     3987   procedure diasize_need-full-display :
     3988     define output parameter p-need-full-display as logical   no-undo .
     3989     do
     3990     on error undo, return error return-value
     3991     :
     3992       assign
     3993         p-need-full-display = v-diasize-need-full-display
     3994       .
     3995       assign
     3996         v-diasize-need-full-display = false
     3997       .
     3998     end.
     3999   end procedure.
     4000   procedure get-context :
     4001      define output parameter p-db-num as integer          no-undo.
     4002      define output parameter p-user-id as character        no-undo.
     4003      define variable v-login               as character    no-undo.
     4004      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4005      define buffer buf_user-login  for ub.user-login .
     4006      do
     4007      on error undo, return error
     4008      :
     4009            FIND FIRST buf_sys-ctrl no-lock.
     4010            ASSIGN
     4011               v-login = USERID("ub")
     4012               p-db-num = buf_sys-ctrl.db-num
     4013            .
     4014            FIND FIRST buf_user-login
     4015                 WHERE buf_user-login.db-num = p-db-num
     4016                   AND buf_user-login.user-login = v-login
     4017                 no-lock
     4018                 no-error
     4019                 .
     4020            IF AVAILABLE buf_user-login
     4021            THEN DO:
     4022               assign
     4023                  p-user-id = buf_user-login.user-id
     4024               .
     4025            END.
     4026      end.
     4027   end procedure.
     4028       run diasize_init in this-procedure .
     4029   MAIN-BLOCK:
     4030   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4031      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4032   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4033     run mainmenu_getcntxt in parparentproc
     4034       (output v-cntxt-db-num
     4035       ,output v-cntxt-userid
     4036       ,output v-cntxt-level
     4037       ,output v-cntxt-host-code-obj
     4038       ,output v-cntxt-obj-type
     4039       ,output v-cntxt-obj-code
     4040       ,output v-cntxt-db-num-obj
     4041       ,output v-cntxt-is-admin
     4042       ) .
     4043      FIND ub.db WHERE ub.db.db-num = v-cntxt-db-num NO-LOCK .
     4044      IF NOT ub.db.add-goods then do:
     4045           message "В данной БД не разрешено изменять товары!" view-as alert-box ERROR.
     4046           return.
     4047      end.
     4048      FIND ub.sysconf WHERE ub.sysconf.host-code = v-cntxt-host-code-obj NO-LOCK .
     4049     RUN MyEnable in this-procedure .
     4050     WAIT-FOR GO OF FRAME u-gds-form.
     4051   END.
     4052   RUN disable_UI in this-procedure .
     4053   PROCEDURE disable_UI :
     4054     HIDE FRAME u-gds-form.
     4055   END PROCEDURE.
     4056   PROCEDURE enable_UI :
     4057     DISPLAY gds-name alpha1 engl-name label-name chk-name OKDP ms-base unit-cli
     4058             v-calc-method wt-base min-rate cli-base-rate ms-cart qnty-cart
     4059             increase-pc wt-cart max-rate PS negative-rest stts EDITOR-1 n-grp-full
     4060             grp-full FILL-IN-4 n-gds-name n-engl-name country_name n-alpha1
     4061             n-label-name n-chk-name n-okdp n-ms-base n-unit-cli n-min-rate
     4062             n-wt-base n-increase-pc n-cli-base-rate n-ms-cart n-max-rate
     4063             n-qnty-cart n-wt-cart n-PS
     4064         WITH FRAME u-gds-form.
     4065     IF AVAILABLE ub.gds-prt THEN
     4066       DISPLAY ub.gds-prt.node-name
     4067         WITH FRAME u-gds-form.
     4068     ENABLE b-exit l-negative-rest l-grp-full l-okdp l-max-rate l-tt-tax l-PS
     4069            l-gds-name l-engl-name l-alpha1 l-wt-cart l-cli-base-rate l-ms-cart
     4070            l-min-rate l-unit-cli l-qnty-cart l-calc-method l-increase-pc
     4071            l-node-name l-stts l-chk-name l-label-name l-wt-base l-ms-base b-quit
     4072            b-list b-help add-inf EDITOR-1 n-grp-full grp-full FILL-IN-4
     4073            ub.gds-prt.node-name n-gds-name n-engl-name n-alpha1 n-label-name
     4074            n-chk-name n-okdp n-ms-base n-unit-cli n-min-rate n-wt-base
     4075            n-increase-pc n-cli-base-rate n-ms-cart n-max-rate n-qnty-cart
     4076            n-wt-cart n-PS
     4077         WITH FRAME u-gds-form.
     4078     VIEW FRAME u-gds-form.
     4079     OPEN QUERY BR-tt-tax FOR EACH tt-tax NO-LOCK.
     4080   END PROCEDURE.
     4081   PROCEDURE MyEnable :
     4082   define variable p-list as character no-undo .
     4083   run str/pr-listv.p (
     4084                    input 'Учетная,Группа,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U
     4085                  , input "":U
     4086                  , output p-list) .
     4087   v-calc-method:list-items in frame u-gds-form  = p-list .
     4088     DISPLAY gds-name alpha1 engl-name label-name chk-name OKDP qnty-cart
     4089             v-calc-method unit-cli ms-base wt-base ms-cart wt-cart cli-base-rate increase-pc PS
     4090             negative-rest stts EDITOR-1 n-grp-full grp-full FILL-IN-4 n-gds-name
     4091             n-engl-name country_name n-alpha1 n-label-name n-chk-name n-okdp
     4092             n-qnty-cart n-unit-cli n-ms-base n-wt-base n-ms-cart n-wt-cart n-cli-base-rate
     4093             n-increase-pc n-PS
     4094             max-rate min-rate
     4095             n-max-rate n-min-rate
     4096         WITH FRAME u-gds-form.
     4097     IF AVAILABLE ub.gds-prt THEN
     4098       DISPLAY ub.gds-prt.node-name
     4099         WITH FRAME u-gds-form.
     4100     ENABLE b-exit b-list b-quit b-help add-inf l-grp-full l-node-name
     4101            l-gds-name l-engl-name l-alpha1 l-label-name l-chk-name l-okdp
     4102            l-qnty-cart l-calc-method
     4103            l-unit-cli l-ms-base l-wt-base l-ms-cart l-cli-base-rate l-wt-cart l-increase-pc l-tt-tax
     4104            l-PS l-negative-rest l-stts EDITOR-1 n-grp-full grp-full FILL-IN-4
     4105            gds-prt.node-name n-gds-name n-engl-name n-alpha1 n-label-name
     4106            n-chk-name n-okdp n-qnty-cart n-unit-cli n-ms-base n-wt-base n-ms-cart n-wt-cart
     4107            n-cli-base-rate n-increase-pc n-PS
     4108            n-max-rate n-min-rate
     4109         WITH FRAME u-gds-form.
     4110     VIEW FRAME u-gds-form.
     4111     OPEN QUERY BR-tt-tax FOR EACH tt-tax NO-LOCK.
     4112   END PROCEDURE.
