     2660                   ,input-output v-rid-list ).
     2661   if v-rid-list <> '' then do:
     2662               apply "entry" to r-alpha1 in frame u-gds-form.
     2663               return no-apply.
     2664       end.
     2665       FIND ub.country WHERE recid (ub.country) = integer(v-rid-list) NO-LOCK.
     2666       DISPLAY ub.country.alpha1 @ alpha1
     2667                       ub.country.short-name @ country_name with frame u-gds-form.
     2668   END.
     2669   ON CHOOSE OF r-base IN FRAME u-gds-form
     2670   DO:
     2671   define variable v-ref-rec as recid .
