      843   .
      844   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      845   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      846   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      847   procedure grplib-get-parameters :
      848   define input parameter p-store-type     as character        no-undo.
      849   define input parameter p-store-code     as integer          no-undo.
      850   do
