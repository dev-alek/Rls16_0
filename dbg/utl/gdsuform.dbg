        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":u .
        3   define variable vss-author      as character no-undo init "$Author$":u .
        4   define variable vss-date        as character no-undo init "$Date$":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        6   define variable vss-archive     as character no-undo init "$Archive$":u .
        7   define variable vss-description as character no-undo init "Форма ввода данных для редактирования списка товаров" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define new shared temp-table gds-list no-undo like ub.goods
      115     field qnty   as decimal
      116     field to-del as logical
      117     field order-num as integer
      118     field to-sel as logical
      119     field promo-code as character
      120     field ActionId  as int64
      121     field db-num as integer
      122     index art  is primary unique artic prod-type prod-code
      123     index code is         unique gds-code
      124     index oi order-num
      125     index isel to-sel
      126     .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define  new shared  temp-table gds-list-hist no-undo
      129   field list-table as character
      130   field id as integer
      131   field line as integer
      132   field hist-mode as character
      133   field des as character
      134   field num-recs as integer
      135   field option_ as character
      136   field item_ as character
      137   field status_ as character
      138   field num-add as integer
      139   field num-ignored as integer
      140   field done as logical
      141   field err_ as logical
      142   field err-mes as character
      143   index pi is primary
      144   id
      145   line
      146   index isdone
      147   done
      148   .
      149     define new shared temp-table  tt-tax no-undo
      150   field tax-code    like ub.tax.tax-code
      151   FIELD individual  like ub.tax.individual
      152   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      153   field rate-code   like ub.tax-rate.rate-code
      154   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      155   FIELD tax-type    like ub.tax.tax-type
      156   field rate-value  like ub.tax-rate-value.rate-value
      157   FIELD tax-rate-gds-rc  as recid
      158   FIELD to-cashdesk like ub.tax.to-cashdesk
      159   FIELD fact-date like ub.tax-rate-value.fact-date
      160   FIELD fact-order like ub.tax-rate-value.fact-order
      161   FIELD next-order like ub.tax-rate-value.fact-order
      162   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      163   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      164   FIELD corr-date like ub.tax-rate-gds.corr-date
      165   FIELD corr-time like ub.tax-rate-gds.corr-time
      166   index tax-code is unique primary tax-code fact-order descending rate-code.
      167   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   procedure factord :
      169     define input  parameter p-fact-date            as date    no-undo .
      170     define input  parameter p-fact-time            as integer no-undo .
      171     define input  parameter p-fact-num             as integer no-undo .
      172     define input  parameter p-shift-date           as date    no-undo .
      173     define input  parameter p-shift-num            as integer no-undo .
      174     define input  parameter p-shift-on             as logical no-undo .
      175     define output parameter p-fact-order           as decimal no-undo .
      176     define output parameter p-shift-end-fact-order as decimal no-undo .
      177     define output parameter p-day-end-fact-order   as decimal no-undo .
      178     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      179     if p-fact-date = ?
      180     then do:
      181       return error "Не указана фактическая дата" .
      182     end.
      183     define variable v-fact-date-num as integer no-undo .
      184     assign
      185       v-fact-date-num = integer(p-fact-date)
      186     .
      187     if p-fact-num = ?
      188     or p-fact-num = 0
      189     then do:
      190       return error "Не задан p-fact-num " + string(p-fact-num) .
      191     end.
      192     if p-fact-num < 0
      193     then do:
      194       return error "Отрицательный fact-num " + string(p-fact-num) .
      195     end.
      196     if p-fact-num >= 100000000
      197     then do:
      198       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      199     end.
      200     if p-shift-on = true
      201     then do:
      202       if p-shift-date = ?
      203       then do:
      204         return error "Не задана дата смены" .
      205       end.
      206       if p-shift-num = ?
      207       or p-shift-num = 0
      208       then do:
      209         return error "Не задан номер смены" .
      210       end.
      211     end.
      212     else do:
      213       assign
      214         p-shift-date = p-fact-date
      215         p-shift-num  = 24
      216       .
      217     end.
      218     define variable v-shift-offset as integer no-undo .
      219     if p-shift-date = p-fact-date
      220     then do:
      221       assign
      222         v-shift-offset = 1
      223       .
      224     end.
      225     if p-shift-date < p-fact-date
      226     then do:
      227       assign
      228         v-shift-offset = 0
      229       .
      230     end.
      231     if p-shift-date > p-fact-date
      232     then do:
      233       message
      234         vss-workfile vss-revision vss-description skip
      235         "Неправильная дата закрытия смены" skip
      236         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      237         view-as alert-box error .
      238       undo, return error
      239         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      240           ,string(p-fact-date, '99/99/9999':U)
      241           ,string(p-shift-date, '99/99/9999':U)
      242           )
      243       .
      244     end.
      245     if p-shift-num < 1
      246     or p-shift-num > 24
      247     then do:
      248       message
      249         vss-workfile vss-revision vss-description skip
      250         "Неправильный номер смены" skip
      251         "p-shift-num" p-shift-num skip
      252         view-as alert-box error .
      253       undo, return error return-value .
      254     end.
      255     assign
      256       p-fact-order           = v-fact-date-num
      257                              + v-shift-offset * 0.5
      258                              + p-shift-num    * 0.02 - 0.01
      259                              + p-fact-num     * 0.0000000001
      260       p-shift-end-fact-order = v-fact-date-num
      261                              + v-shift-offset * 0.5
      262                              + p-shift-num    * 0.02
      263       p-day-end-fact-order   = v-fact-date-num
      264                              + 0.99
      265     .
      266     if p-fact-order           <= v-fact-date-num
      267     or p-shift-end-fact-order <= v-fact-date-num
      268     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      269     or p-shift-end-fact-order >= p-day-end-fact-order
      270     then do:
      271       message
      272         vss-workfile vss-revision vss-description skip
      273         "Внутренняя ошибка при генерации фактического номера" skip
      274         "p-fact-date"            p-fact-date            skip
      275         "p-fact-time"            p-fact-time            skip
      276         "p-fact-num"             p-fact-num             skip
      277         "p-shift-date"           p-shift-date           skip
      278         "p-shift-num"            p-shift-num            skip
      279         "p-shift-on"             p-shift-on             skip
      280         "p-shift-end-fact-order" p-shift-end-fact-order skip
      281         "p-day-end-fact-order"   p-day-end-fact-order   skip
      282         "v-fact-date-num"        v-fact-date-num        skip
      283         view-as alert-box error .
      284       undo, return error return-value .
      285     end.
      286   end procedure.
      287   procedure day-begin-fact-order :
      288     define input  parameter p-fact-date            as date    no-undo .
      289     define output parameter p-day-begin-fact-order as decimal no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       if p-fact-date = ?
      294       then do:
      295         assign
      296           p-day-begin-fact-order = 0
      297         .
      298       end.
      299       else do:
      300         assign
      301           p-day-begin-fact-order = integer(p-fact-date)
      302         .
      303       end.
      304     end.
      305   end procedure.
      306   procedure factord-max-fact-order :
      307     define output parameter p-max-fact-order as decimal   no-undo .
      308     do
      309     on error undo, return error return-value
      310     :
      311       run day-begin-fact-order in this-procedure
      312         (input  date(1, 1, 5000)
      313         ,output p-max-fact-order
      314         ) .
      315     end.
      316   end procedure.
      317   procedure factord-cut-archive :
      318     define input  parameter p-obj-type             as character no-undo .
      319     define input  parameter p-obj-code             as integer   no-undo .
      320     define input  parameter p-fact-date            as date      no-undo .
      321     define output parameter p-shift-on             as logical   no-undo .
      322     define output parameter p-shift-date           as date      no-undo .
      323     define output parameter p-shift-num            as integer   no-undo .
      324     define output parameter p-day-end-fact-order   as decimal   no-undo .
      325     define output parameter p-shift-end-fact-order as decimal   no-undo .
      326     define variable v-fact-order as decimal   no-undo .
      327     define buffer buf_shift-obj for ub.shift-obj .
      328     do
      329     on error undo, return error return-value
      330     :
      331   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      333     (input  p-obj-type
      334     ,input  p-obj-code
      335     ,input  'shift-on=request'
      336     ,output p-shift-on
      337     ) no-error .
      338       if error-status :error
      339       then do:
      340         message
      341           vss-workfile vss-revision vss-description skip
      342           "Ошибка при определении атрибута объекта" skip
      343           "Объект" p-obj-type p-obj-code skip
      344           error-status :get-message(1) skip
      345           return-value skip
      346           view-as alert-box error .
      347         undo, return error return-value .
      348       end.
      349       if p-shift-on = false
      350       then do:
      351         assign
      352           p-shift-date               = ?
      353           p-shift-num                = 0
      354         .
      355       end.
      356       else do:
      357         find first buf_shift-obj share-lock
      358           where buf_shift-obj.obj-type   = p-obj-type
      359             and buf_shift-obj.obj-code   = p-obj-code
      360             and buf_shift-obj.shift-date > p-fact-date
      361           use-index pi
      362           no-error .
      363         if not available buf_shift-obj
      364         or buf_shift-obj.status_ <> 'зкр':U
      365         then do:
      366           message
      367             vss-workfile vss-revision vss-description skip
      368             "Невозможно вычислить последнюю смену" skip
      369             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      370             "Объект" p-obj-type p-obj-code skip
      371             "Дата" p-fact-date skip
      372             view-as alert-box error .
      373           undo, return error return-value .
      374         end.
      375         find last buf_shift-obj share-lock
      376           where buf_shift-obj.obj-type = p-obj-type
      377             and buf_shift-obj.obj-code = p-obj-code
      378             and buf_shift-obj.shift-date <= p-fact-date
      379           use-index pi
      380           no-error .
      381         if available buf_shift-obj
      382         then do:
      383           if  buf_shift-obj.status_ = 'зкр':U
      384           then do:
      385             assign
      386               p-shift-date = buf_shift-obj.shift-date
      387               p-shift-num  = buf_shift-obj.shift-num
      388             .
      389           end.
      390           else do:
      391             message
      392               vss-workfile vss-revision vss-description skip
      393               "Невозможно вычислить последнюю смену" skip
      394               "Статус смены отличен от статуса" 'зкр':U skip
      395               "Объект" p-obj-type p-obj-code skip
      396               "Дата" p-fact-date skip
      397               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      398               view-as alert-box error .
      399             undo, return error return-value .
      400           end.
      401         end.
      402         else do:
      403           assign
      404             p-shift-date = p-fact-date - 1
      405             p-shift-num  = 1
      406           .
      407         end.
      408       end.
      409       run factord in this-procedure
      410         (input  p-fact-date
      411         ,input  1
      412         ,input  1
      413         ,input  p-shift-date
      414         ,input  p-shift-num
      415         ,input  p-shift-on
      416         ,output v-fact-order
      417         ,output p-shift-end-fact-order
      418         ,output p-day-end-fact-order
      419         ) no-error .
      420       if error-status :error
      421       then do:
      422         message
      423           vss-workfile vss-revision vss-description skip
      424           "Ошибка при вызове процедуры factord"
      425           error-status :get-message(1) skip
      426           return-value skip
      427           view-as alert-box error .
      428         undo, return error return-value .
      429       end.
      430     end.
      431   end procedure.
      432   procedure factord-lock-shift :
      433     define input  parameter p-obj-type  as character no-undo .
      434     define input  parameter p-obj-code  as integer   no-undo .
      435     define input  parameter p-fact-date as date      no-undo .
      436     define parameter buffer buf_shift-obj for ub.shift-obj .
      437     define variable v-shift-on      as logical   no-undo .
      438     define variable v-extra-message as character no-undo .
      439     define variable v-error as character no-undo .
      440     do
      441     on error undo, return error return-value
      442     :
      443   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      444   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      445     (input  p-obj-type
      446     ,input  p-obj-code
      447     ,input  'shift-on=request'
      448     ,output v-shift-on
      449     ) no-error .
      450       if error-status :error
      451       then do:
      452         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      453         undo, return error v-error .
      454       end.
      455       if v-shift-on = true
      456       then do:
      457         find first buf_shift-obj share-lock
      458           where buf_shift-obj.obj-type   = p-obj-type
      459             and buf_shift-obj.obj-code   = p-obj-code
      460             and buf_shift-obj.shift-date > p-fact-date
      461           use-index pi
      462           no-error .
      463         if not available buf_shift-obj
      464         or buf_shift-obj.status_ <> 'зкр':U
      465         then do:
      466           find last buf_shift-obj
      467             where buf_shift-obj.obj-type = p-obj-type
      468               and buf_shift-obj.obj-code = p-obj-code
      469               and buf_shift-obj.status_  = 'зкр':U
      470             use-index stts
      471             no-error .
      472           if available buf_shift-obj
      473           then do:
      474             assign
      475               v-extra-message =
      476                     substitute("Дата начала последеней закрытой смены на объекте &1"
      477                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      478                               )
      479             .
      480           end.
      481           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      482           undo, return error v-error .
      483         end.
      484       end.
      485     end.
      486   end procedure.
      487   procedure factord-end-day :
      488     define input  parameter p-fact-date            as date    no-undo .
      489     define output parameter p-day-end-fact-order   as decimal no-undo .
      490     do
      491     on error undo, return error return-value
      492     :
      493       if p-fact-date = ?
      494       then do:
      495         return error "Не указана фактическая дата" .
      496       end.
      497       assign
      498         p-day-end-fact-order = integer(p-fact-date) + 0.99
      499       .
      500     end.
      501   end procedure.
      502   procedure factord-to-date :
      503     define input  parameter p-fact-order as decimal no-undo .
      504     define output parameter p-fact-date  as date    no-undo .
      505     define variable v-ref-date  as date      no-undo .
      506     define variable v-ref-delta as integer   no-undo .
      507     do
      508     on error undo, return error return-value
      509     :
      510       if p-fact-order = ?
      511       or p-fact-order = 0
      512       then do:
      513         return error "Не указан fact-order" .
      514       end.
      515       assign
      516         v-ref-date  = date(1, 1, 2000)
      517       .
      518       assign
      519         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      520       .
      521       assign
      522         p-fact-date = v-ref-date + v-ref-delta
      523       .
      524     end.
      525   end procedure.
      526   procedure factord-to-fact-num :
      527     define input  parameter p-fact-order as decimal no-undo .
      528     define output parameter p-fact-num   as integer no-undo .
      529     define variable v-fact-order-trunc as decimal no-undo .
      530     do
      531     on error undo, return error return-value
      532     :
      533       if p-fact-order = ?
      534       or p-fact-order = 0
      535       then do:
      536         return error "Не указан fact-order" .
      537       end.
      538       assign
      539        v-fact-order-trunc = truncate(p-fact-order, 2)
      540       .
      541       assign
      542         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      543       .
      544     end.
      545   end procedure.
      546   procedure factord-to-shift-num :
      547     define input  parameter p-fact-order as decimal no-undo .
      548     define output parameter p-shift-num   as integer no-undo .
      549     define variable  p-shift-numd  as decimal   no-undo .
      550     define variable v-fact-order-trunc as decimal no-undo .
      551     do
      552     on error undo, return error return-value
      553     :
      554       if p-fact-order = ?
      555       or p-fact-order = 0
      556       then do:
      557         return error "Не указан fact-order" .
      558       end.
      559       assign
      560        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      561       .
      562       if v-fact-order-trunc < 0.5 then do:
      563         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      564       end.
      565       assign
      566         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      567         .
      568        assign
      569         p-shift-num = truncate (p-shift-numd , 0)
      570       .
      571     end.
      572   end procedure.
      573   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   procedure cur-time :
      575      define output parameter p-today as date      no-undo .
      576      define output parameter p-time  as integer   no-undo .
      577     do
      578     on error undo, return error
      579     :
      580       define variable v-date1 as date      no-undo .
      581       define variable v-date2 as date      no-undo .
      582       define variable v-time  as integer   no-undo .
      583       assign
      584         v-date1 = today
      585         v-time  = time
      586         v-date2 = today
      587       .
      588       if v-date1 <> v-date2
      589       then do:
      590         assign
      591           v-date1 = today
      592           v-time  = v-time
      593         .
      594       end.
      595       assign
      596         p-today = v-date1
      597         p-time  = v-time
      598       .
      599     end.
      600   end.
      601   function cur-time-date returns character
      602   :
      603     return string(today, '99/99/9999':U) .
      604   end.
      605   function cur-time-mjd returns decimal
      606   :
      607     define variable v-date as date      no-undo .
      608     define variable v-time as integer   no-undo .
      609     run cur-time in this-procedure
      610       (output v-date
      611       ,output v-time
      612       ) .
      613     return integer(v-date) - 2400002 + (v-time / 86400) .
      614   end.
      615   function cur-time-get-ending-index returns integer
      616   (input p-number as integer
      617   )
      618   :
      619     if p-number < 0
      620     or p-number = ?
      621     then do:
      622       return 1 .
      623     end.
      624     define variable v-rest as integer   no-undo .
      625     assign
      626       p-number = p-number modulo 100
      627     .
      628     if p-number < 20
      629     then do:
      630       assign
      631         v-rest = p-number
      632       .
      633     end.
      634     else do:
      635       assign
      636         v-rest = p-number modulo 10
      637       .
      638     end.
      639     case v-rest :
      640       when 1
      641       then do:
      642         return 2 .
      643       end.
      644       when 2 or
      645       when 3 or
      646       when 4
      647       then do:
      648         return 3 .
      649       end.
      650       otherwise do:
      651         return 1 .
      652       end.
      653     end case .
      654   end.
      655   procedure cur-time-mjd-to-date :
      656      define input  parameter i-mjd-diff as decimal no-undo.
      657      define output parameter o-Date     as date    no-undo.
      658      define output parameter o-Time     as integer no-undo.
      659      define variable v-day-number as integer   no-undo .
      660      if    i-mjd-diff < 0
      661         or i-mjd-diff = ?
      662      then do:
      663         return "?" .
      664      end.
      665      assign
      666         v-day-number = truncate(i-mjd-diff,0).
      667         o-Date = date(v-day-number + 2400002).
      668         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      669     .
      670   end.
      671   function cur-time-mjd-to-string returns character
      672   (input p-mjd-diff as decimal
      673   )
      674   :
      675     define variable v-day-number as integer   no-undo .
      676     define variable v-seconds    as integer   no-undo .
      677     define variable v-hour       as integer   no-undo .
      678     define variable v-min        as integer   no-undo .
      679     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      680     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      681     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      682     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      683     if p-mjd-diff < 0
      684     or p-mjd-diff = ?
      685     then do:
      686       return "?" .
      687     end.
      688     assign
      689       v-day-number = integer(truncate(p-mjd-diff,0))
      690       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      691     .
      692     if v-seconds > 86400
      693     then do:
      694       assign
      695         v-seconds = 86400 - 1
      696       .
      697     end.
      698     if v-seconds < 0
      699     then do:
      700       assign
      701         v-seconds = 0
      702       .
      703     end.
      704     assign
      705       v-hour = truncate(v-seconds / 3600, 0)
      706     .
      707     assign
      708       v-seconds = v-seconds modulo 3600
      709     .
      710     assign
      711       v-min = truncate(v-seconds / 60, 0)
      712     .
      713     assign
      714       v-seconds = v-seconds modulo 60
      715     .
      716     return
      717         (if v-day-number <> 0
      718           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      719           else ""
      720         )
      721       + (if v-day-number <> 0 or v-hour <> 0
      722           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      723           else ""
      724         )
      725       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      726           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      727           else ""
      728         )
      729       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      730       .
      731   end.
      732   function cur-time-string returns character
      733   :
      734     define variable v-date as date      no-undo .
      735     define variable v-time as integer   no-undo .
      736     run cur-time in this-procedure
      737       (output v-date
      738       ,output v-time
      739       ) .
      740     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      741   end.
      742   function cur-time-string-sec returns character
      743   :
      744     define variable v-date as date      no-undo .
      745     define variable v-time as integer   no-undo .
      746     run cur-time in this-procedure
      747       (output v-date
      748       ,output v-time
      749       ) .
      750     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      751   end.
      752   function cur-time-custom  returns character
      753   (input p-prefix as character
      754   ,input p-date-format as character
      755   ,input p-delimiter as character
      756   ,input p-time-format as character
      757   ,input p-suffix as character
      758   )
      759   :
      760     define variable v-date as date      no-undo .
      761     define variable v-time as integer   no-undo .
      762     run cur-time in this-procedure
      763       (output v-date
      764       ,output v-time
      765       ) .
      766     return
      767       p-prefix
      768       + string(v-date, p-date-format)
      769       + p-delimiter
      770       + string(v-time, p-time-format)
      771       + p-suffix
      772       .
      773   end.
      774   function cur-time-print  returns character
      775   :
      776     define variable v-date as date      no-undo .
      777     define variable v-time as integer   no-undo .
      778     run cur-time in this-procedure
      779       (output v-date
      780       ,output v-time
      781       ) .
      782     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      783   end.
      784   function cur-time-datetime returns datetime
      785   :
      786     define variable v-char as character no-undo .
      787     define variable v-datetime as datetime no-undo .
      788     v-char = cur-time-string().
      789     v-datetime = datetime(v-char).
      790     return  v-datetime.
      791   end.
      792   function cur-time-string-msec returns character
      793   :
      794     define variable v-date as datetime  no-undo .
      795     v-date = now.
      796     return string(v-date) .
      797   end.
      798   define variable vss-include-info6 as character format "X(65)" no-undo
      799   initial "@(#)$Workfile$ $Revision$".
