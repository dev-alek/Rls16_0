      858   procedure grplib-get-sort-name :
      859   do
      860   on error undo, return error
      861   :
      862   define input parameter p-node-code  as integer      no-undo.
      863   define output parameter p-sort-name as character    no-undo.
      864       define variable v-upper-code    as integer           no-undo.
      865       define buffer buf_gds-grp       for ub.gds-grp.
      866       define buffer buf_upper_gds-grp for ub.gds-grp.
      867       find first buf_gds-grp no-lock
      868            where buf_gds-grp.node-code = p-node-code
      869       no-error.
      870       if not available buf_gds-grp
      871       then do:
      872           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      873       end.
      874       assign
      875           p-sort-name  = ""
      876           v-upper-code = 1
      877       .
      878       do while buf_gds-grp.upper-code <> 0
      879       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      880       :
      881           assign
      882               p-sort-name  = buf_gds-grp.node-name
      883                            + (if p-sort-name <> "" then chr(2) else "")
      884                            + p-sort-name
      885               v-upper-code = buf_gds-grp.upper-code
      886           .
      887           find first buf_gds-grp no-lock
      888                where buf_gds-grp.node-code = v-upper-code
      889           no-error.
      890           if not available buf_gds-grp
      891           then do:
      892               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      893                                   + string( v-upper-code )
      894                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      895           end.
      896       end.
      897   end.
      898   end procedure.
      899   define variable vss-include-info7 as character format "X(65)" no-undo
      900   initial "@(#)$Workfile$ $Revision$".
      901   procedure grplib-get-full-name :
      902      define input parameter p-node-code  as integer      no-undo.
      903      define output parameter p-full-name as character    no-undo.
      904      do
      905   on error undo, return error
      906   :
      907       define variable v-upper-code    as integer           no-undo.
      908       define buffer buf_gds-grp       for ub.gds-grp.
      909       define buffer buf_upper_gds-grp for ub.gds-grp.
      910       find first buf_gds-grp no-lock
      911            where buf_gds-grp.node-code = p-node-code
      912       no-error.
      913       if not available buf_gds-grp
      914       then do:
      915           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      916       end.
      917       assign
      918           p-full-name  = ""
      919           v-upper-code = 1
      920       .
      921       do while buf_gds-grp.upper-code <> 0
      922       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      923       :
      924           assign
      925               p-full-name  = buf_gds-grp.node-name
      926                            + (if p-full-name <> "" then chr(47) else "")
      927                            + p-full-name
      928               v-upper-code = buf_gds-grp.upper-code
      929           .
      930           find first buf_gds-grp no-lock
      931                where buf_gds-grp.node-code = v-upper-code
      932           no-error.
      933           if not available buf_gds-grp
      934           then do:
      935               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      936                                   + string( v-upper-code )
      937                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      938           end.
      939       end.
      940       assign
      941       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      942       .
      943   end.
      944   end .
      945   procedure grplib-get-node-from-full-name :
      946   define input parameter p-full-name as character no-undo .
      947   define output parameter p-node-code as integer no-undo .
      948   define variable v-ii as integer no-undo .
      949   define variable v-upper-code as integer no-undo .
      950   define variable v-root-code as integer no-undo .
      951   define variable v-entry as character no-undo .
      952   define buffer buf_gds-grp       for ub.gds-grp.
      953   do
      954   on error undo, return error
      955   :
      956     find first buf_gds-grp no-lock
      957         where buf_gds-grp.upper-code = 0
      958     no-error .
      959     if not available buf_gds-grp
      960     then do:
      961         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      962     end.
      963     else do:
      964       assign
      965       v-root-code = buf_gds-grp.node-code
      966       .
      967     end.
      968     v-upper-code = v-root-code.
      969     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      970       assign
      971       v-entry = entry(v-ii, p-full-name, chr(47)).
      972       if v-entry = '' then leave.
      973       find first buf_gds-grp no-lock where
      974                 buf_gds-grp.node-name = v-entry
      975             and buf_gds-grp.upper-code = v-upper-code
      976             no-error.
      977       if not available buf_gds-grp then do:
      978         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      979       end.
      980       else do:
      981         p-node-code = buf_gds-grp.node-code.
      982         v-upper-code = buf_gds-grp.node-code.
      983       end.
      984     end.
      985   end.
      986   end .
      987   procedure grplib-get-root-code :
      988   do
      989   on error undo, return error
      990   :
      991   define output parameter p-root-code as integer      no-undo.
      992       define buffer buf_gds-grp       for ub.gds-grp.
      993       find first buf_gds-grp no-lock
      994           where buf_gds-grp.upper-code = 0
      995       no-error .
      996       if not available buf_gds-grp
      997       then do:
      998           undo, return error .
      999       end.
     1000       else do:
     1001           assign
     1002               p-root-code = buf_gds-grp.node-code
     1003           .
     1004       end.
     1005   end.
     1006   end procedure.
     1007   procedure grplib-find-grp-by-full-name :
     1008   do
     1009   on error undo, return error
     1010   :
     1011   define input parameter p-search-name  as character    no-undo.
     1012   define input parameter p-fill-path    as logical      no-undo.
     1013   define output parameter p-found       as logical      no-undo.
     1014       define variable v-upper-code    as integer          no-undo.
     1015       define variable v-counter       as integer           no-undo.
     1016       define variable v-level         as integer           no-undo.
     1017       define variable v-full-name     as character         no-undo.
     1018       define variable v-sort-name     as character         no-undo.
     1019       define buffer buf_gds-grp       for ub.gds-grp.
     1020       assign
     1021           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1022       .
     1023       run grplib-get-root-code ( output v-upper-code ) no-error .
     1024       if error-status :error
     1025       then do:
     1026           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1027       end.
     1028       assign
     1029           v-full-name  = ""
     1030           v-level      = num-entries( p-search-name, chr(2) )
     1031       .
     1032       for each temp_grplib_found-grp
     1033       :
     1034           delete temp_grplib_found-grp.
     1035       end.
     1036       start-name-analyze:
     1037       do v-counter = 1 to v-level
     1038       :
     1039           if v-counter < v-level
     1040           then do:
     1041               find first buf_gds-grp no-lock
     1042                    where buf_gds-grp.upper-code = v-upper-code
     1043                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1044               no-error .
     1045               if not available buf_gds-grp
     1046               then do:
     1047                   assign
     1048                       v-full-name  = p-search-name
     1049                       v-sort-name  = p-search-name
     1050                   .
     1051                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1052               end.
     1053               else do:
     1054                   assign
     1055                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1056                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1057                       v-upper-code = buf_gds-grp.node-code
     1058                   .
     1059                   if p-fill-path = yes
     1060                   then do:
     1061                       create temp_grplib_found-grp.
     1062                       assign
     1063                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1064                           temp_grplib_found-grp.sort-name = v-sort-name
     1065                           temp_grplib_found-grp.node-code = v-upper-code
     1066                           temp_grplib_found-grp.level     = v-counter
     1067                       .
     1068                   end.
     1069               end.
     1070           end.
     1071           else do:
     1072               for each buf_gds-grp no-lock
     1073                  where buf_gds-grp.upper-code = v-upper-code
     1074                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1075               :
     1076                   assign
     1077                       p-found = yes
     1078                   .
     1079                   create temp_grplib_found-grp.
     1080                   assign
     1081                       temp_grplib_found-grp.full-name = v-full-name
     1082                                                           + (if v-full-name = "" then "" else chr(47) )
     1083                                                           + buf_gds-grp.node-name + chr(47)
     1084                       temp_grplib_found-grp.sort-name = v-sort-name
     1085                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1086                                                           + buf_gds-grp.node-name
     1087                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1088                       temp_grplib_found-grp.level     = v-level
     1089                   .
     1090               end.
     1091               if p-found = no
     1092               then do:
     1093                   assign
     1094                       v-full-name  = p-search-name
     1095                       v-sort-name  = p-search-name
     1096                   .
     1097                   for each temp_grplib_found-grp
     1098                   :
     1099                       delete temp_grplib_found-grp.
     1100                   end.
     1101                   assign
     1102                       p-found = no
     1103                   .
     1104               end.
     1105           end.
     1106       end.
     1107   end.
     1108   end procedure.
     1109   procedure grplib-find-all-subgroup :
     1110   do
     1111   on error undo, return error
     1112   :
     1113   define input parameter p-start-node-code    as integer      no-undo.
     1114   define input parameter p-terminal-only      as logical      no-undo.
     1115       define variable v-start-full-name   as character     no-undo.
     1116       define variable v-start-sort-name   as character     no-undo.
     1117       define variable v-not-found         as logical       no-undo.
     1118       define variable v-is-terminal       as logical       no-undo.
     1119       define buffer buf_gds-grp           for ub.gds-grp.
     1120       create temp_found-result-nodelist.
     1121       assign
     1122           temp_found-result-nodelist.node-code = p-start-node-code
     1123           temp_found-result-nodelist.processed = no
     1124       .
     1125       run grplib-get-full-name in this-procedure (
     1126             input p-start-node-code
     1127           , output v-start-full-name
     1128       ).
     1129       run grplib-get-full-name in this-procedure (
     1130             input p-start-node-code
     1131           , output v-start-sort-name
     1132       ).
     1133       process-nodes:
     1134       do while yes
     1135       :
     1136           find first temp_found-result-nodelist
     1137                where temp_found-result-nodelist.node-code = p-start-node-code
     1138           .
     1139           assign
     1140               temp_found-result-nodelist.processed = yes
     1141           .
     1142           for each buf_gds-grp no-lock
     1143              where buf_gds-grp.upper-code = p-start-node-code
     1144           on error undo, return error
     1145           :
     1146               run grplib-is-terminal in this-procedure (
     1147                     input buf_gds-grp.node-code
     1148                   , output v-is-terminal
     1149               ).
     1150               if v-is-terminal = yes
     1151               then do:
     1152                   create temp_grplib_found-grp.
     1153                   assign
     1154                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1155                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1156                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1157                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1158                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1159                       temp_grplib_found-grp.is-terminal = yes
     1160                   .
     1161               end.
     1162               else do:
     1163                   create temp_found-result-nodelist.
     1164                   assign
     1165                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1166                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1167                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1168                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1169                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1170                       temp_found-result-nodelist.processed = no
     1171                   .
     1172                   if p-terminal-only = no
     1173                   then do:
     1174                       create temp_grplib_found-grp.
     1175                       assign
     1176                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1177                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1178                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1179                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1180                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1181                           temp_grplib_found-grp.is-terminal = no
     1182                       .
     1183                   end.
     1184               end.
     1185           end.
     1186           find first temp_found-result-nodelist
     1187                where temp_found-result-nodelist.processed = no
     1188           no-error.
     1189           if not available temp_found-result-nodelist
     1190           then do:
     1191               leave process-nodes.
     1192           end.
     1193           else do:
     1194               assign
     1195                   p-start-node-code = temp_found-result-nodelist.node-code
     1196                   v-start-full-name = temp_found-result-nodelist.full-name
     1197                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1198               .
     1199           end.
     1200       end.
     1201   end.
     1202   end procedure.
     1203   procedure grplib-expand-name :
     1204   define input parameter p-start-name as character        no-undo.
     1205   define output parameter p-end-name  as character        no-undo.
     1206       define variable v-is-terminal   as logical      no-undo.
     1207       define variable v-found         as character    no-undo.
     1208       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1209   do
     1210   for buf_temp_grplib_found-grp
     1211   on error undo, return error
     1212   :
     1213       run grplib-find-grp-by-full-name in this-procedure (
     1214             input p-start-name
     1215           , input no
     1216           , output v-found
     1217       ) no-error.
     1218       run grplib-get-max-substring in this-procedure (
     1219                   input length( p-start-name )
     1220                 , output p-end-name
     1221       ) no-error .
     1222       if error-status :error
     1223       then do:
     1224           assign
     1225               p-end-name = ""
     1226           .
     1227       end.
     1228       else do:
     1229           find first temp_grplib_found-grp
     1230               where temp_grplib_found-grp.full-name = p-end-name
     1231           no-error.
     1232           if available temp_grplib_found-grp
     1233           then do:
     1234               find first buf_temp_grplib_found-grp
     1235                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1236                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1237               no-error.
     1238               if not available buf_temp_grplib_found-grp
     1239               then do:
     1240                   run grplib-is-terminal in this-procedure (
     1241                       input temp_grplib_found-grp.node-code
     1242                       , output v-is-terminal
     1243                   ).
     1244               end.
     1245           end.
     1246       end.
     1247   end.
     1248   end procedure.
     1249   procedure grplib-get-max-substring :
     1250   do
     1251   on error undo, return error
     1252   :
     1253   define input parameter p-min-substring-length   as integer      no-undo.
     1254   define output parameter p-substring             as character    no-undo.
     1255           define variable v-char-counter  as integer           no-undo.
     1256           define variable v-current-char  as character         no-undo.
     1257           define variable v-names-counter  as integer           no-undo.
     1258           define variable v-base-string   as character         no-undo.
     1259           assign
     1260               v-char-counter  = p-min-substring-length
     1261           .
     1262           find first temp_grplib_found-grp no-error.
     1263           if not available temp_grplib_found-grp
     1264           then do:
     1265               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1266           end.
     1267           else do:
     1268               assign
     1269                   v-base-string  = temp_grplib_found-grp.full-name
     1270                   v-char-counter = 0
     1271               .
     1272               counter-block:
     1273               do while yes
     1274               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1275               :
     1276                   assign
     1277                       v-char-counter  = v-char-counter + 1
     1278                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1279                       v-names-counter = 0
     1280                   .
     1281                   compare-block:
     1282                   for each temp_grplib_found-grp
     1283                   :
     1284                       assign
     1285                           v-names-counter = v-names-counter + 1
     1286                       .
     1287                       if v-names-counter = 1
     1288                       then do:
     1289                           next compare-block.
     1290                       end.
     1291                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1292                       then do:
     1293                           leave counter-block.
     1294                       end.
     1295                   end.
     1296                   if v-names-counter = 1
     1297                   then do:
     1298                       assign
     1299                           p-substring = v-base-string
     1300                       .
     1301                       return.
     1302                   end.
     1303               end.
     1304               assign
     1305                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1306               .
     1307           end.
     1308   end.
     1309   end procedure.
     1310   procedure grplib-is-terminal :
     1311   do
     1312   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1313   :
     1314   define input parameter p-node-code      as integer      no-undo.
     1315   define output parameter p-is-terminal   as logical      no-undo.
     1316       define buffer buf_gds-grp       for ub.gds-grp.
     1317       find first buf_gds-grp no-lock
     1318           where buf_gds-grp.upper-code = p-node-code
     1319       no-error .
     1320       if not available buf_gds-grp
     1321       then do:
     1322           assign
     1323               p-is-terminal = yes
     1324           .
     1325       end.
     1326       else do:
     1327           assign
     1328               p-is-terminal = no
     1329           .
     1330       end.
     1331   end.
     1332   end procedure.
     1333   procedure grplib-have-goods :
     1334   do
     1335   on error undo, return error
     1336   :
     1337   define input parameter p-node-code      as integer      no-undo.
     1338   define output parameter p-have-goods   as logical      no-undo.
     1339       define buffer buf_goods         for ub.goods.
     1340       find first buf_goods no-lock
     1341            where buf_goods.grp-code = p-node-code
     1342       no-error .
     1343       if available buf_goods
     1344       then do:
     1345           assign
     1346               p-have-goods = yes
     1347           .
     1348       end.
     1349       else do:
     1350           assign
     1351               p-have-goods = no
     1352           .
     1353       end.
     1354   end.
     1355   end procedure.
     1356   procedure grplib-find-by-substring :
     1357   do
     1358   on error undo, return error
     1359   :
     1360   define input parameter p-start-code         as integer      no-undo.
     1361   define input parameter p-full-search-string as character    no-undo.
     1362   define output parameter p-found-code        as integer      no-undo.
     1363   define output parameter p-full-name         as character    no-undo.
     1364       define variable v-start-code     as integer           no-undo.
     1365       define variable v-found          as logical  init no  no-undo.
     1366       define buffer buf_gds-grp       for ub.gds-grp.
     1367       search-grp:
     1368       for each buf_gds-grp no-lock
     1369           where buf_gds-grp.node-code > p-start-code
     1370       :
     1371           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1372           then do:
     1373               assign
     1374                   p-found-code = buf_gds-grp.node-code
     1375                   v-found      = yes
     1376               .
     1377               run grplib-get-full-name in this-procedure (
     1378                     input p-found-code
     1379                   , output p-full-name
     1380               ) no-error .
     1381               if error-status :error
     1382               then do:
     1383                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1384               end.
     1385               leave search-grp.
     1386           end.
     1387       end.
     1388       if v-found = yes
     1389       then do:
     1390       end.
     1391       else do:
     1392           assign
     1393               p-full-name  = ""
     1394               p-found-code = 0
     1395           .
     1396       end.
     1397   end.
     1398   end procedure.
     1399   procedure grplib-analyze-grp-name :
     1400   do
     1401   on error undo, return error
     1402   :
     1403   define input parameter p-grp-name       as character            no-undo.
     1404   define input parameter p-upper-code     as integer              no-undo.
     1405   define output parameter p-error-message as character init ""    no-undo.
     1406       define variable v-char-list     as character    no-undo.
     1407       define variable v-char-counter  as integer      no-undo.
     1408       define variable v-full-name     as character    no-undo.
     1409       if p-grp-name = "" then do:
     1410           assign
     1411               p-error-message = "Название группы не может быть пустым.".
     1412           .
     1413       end.
     1414       else do:
     1415           assign
     1416               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1417           .
     1418           do v-char-counter = 1 to num-entries( v-char-list )
     1419           :
     1420               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1421               then do:
     1422                   assign
     1423                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1424                   .
     1425                   return.
     1426               end.
     1427           end.
     1428           if p-upper-code > 0
     1429           then do:
     1430               run grplib-get-full-name in this-procedure (
     1431                     input p-upper-code
     1432                   , output v-full-name
     1433               ) no-error .
     1434               if error-status :error
     1435               then do:
     1436                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1437               end.
     1438               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1439               then do:
     1440                   assign
     1441                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1442                   .
     1443               end.
     1444           end.
     1445       end.
     1446   end.
     1447   end procedure.
     1448   procedure grplib-get-lvl-num :
     1449   define input parameter p-node-code  as integer      no-undo.
     1450   define output parameter p-lvl-num   as integer      no-undo.
     1451       define variable v-full-name    as character    no-undo.
     1452   do
     1453   on error undo, return error
     1454   :
     1455       run grplib-get-full-name in this-procedure (
     1456             input p-node-code
     1457           , output v-full-name
     1458       ).
     1459       assign
     1460           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1461       .
     1462       if p-lvl-num = -1
     1463       then do:
     1464           assign
     1465               p-lvl-num = 0
     1466           .
     1467       end.
     1468   end.
     1469   end procedure.
