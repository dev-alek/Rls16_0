     2673                   , input yes
     2674                   , output v-ref-rec ).
     2675   if v-ref-rec = ? then do:
     2676     apply "entry" to r-base in frame u-gds-form.
     2677     return no-apply.
     2678   end.
     2679   FIND ub.units WHERE recid (ub.units) = v-ref-rec NO-LOCK.
