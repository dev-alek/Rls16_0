        1   block-level on error undo, throw.
        2   define input  parameter iKey     as integer no-undo.
        3   define output parameter oChekSum as character no-undo.
        4   if userid("ub") eq ""
        5   then do:
        6      oChekSum = encode(string(iKey * 13)) + string(index(encode(string(iKey)), "k"))
        7    .
        8      return.
        9   end.
       10   define input parameter parparentproc    as widget-handle no-undo .
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   define new global shared variable g#library  as handle no-undo .
       16   define new global shared variable g#library2 as handle no-undo .
       17   define   shared variable g#auto as logical no-undo.
       18   define   shared variable g#news as logical no-undo.
       19   define   shared variable g#oxml as logical no-undo.
       20   define   shared variable g#esys as logical no-undo.
       21   define   shared variable g#news-source-db as integer no-undo.
       22   define   shared variable g#esys-source-esys as integer no-undo.
       23   define   shared variable g#db-num as integer   no-undo .
       24   define   shared variable g#userid as character no-undo .
       25   define   shared variable g#passwd as character no-undo .
       26   define new shared stream vProtTest.
       27   define new shared variable testId as rowid no-undo.
       28   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       29     define variable v-cntxt-db-num        as integer   no-undo .
       30     define variable v-cntxt-userid        as character no-undo .
       31     define variable v-cntxt-level         as character no-undo .
       32     define variable v-cntxt-host-code-obj as integer   no-undo .
       33     define variable v-cntxt-obj-type      as character no-undo .
       34     define variable v-cntxt-obj-code      as integer   no-undo .
       35     define variable v-cntxt-db-num-obj    as integer   no-undo .
       36     define variable v-cntxt-is-admin      as logical   no-undo .
       37   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
       38     then run str/lib-trn.p persistent no-error .
       39   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn2)
       40     then run str/lib-trn2.p persistent no-error .
       41   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
       42     then run str/lib-trn3.p persistent no-error .
       43   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn4)
       44     then run str/lib-trn4.p persistent no-error .
       45   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#trdcalib)
       46     then run str/trdcalib.p persistent no-error .
       47   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       48     run mainmenu_getcntxt in parparentproc
       49       (output v-cntxt-db-num
       50       ,output v-cntxt-userid
       51       ,output v-cntxt-level
       52       ,output v-cntxt-host-code-obj
       53       ,output v-cntxt-obj-type
       54       ,output v-cntxt-obj-code
       55       ,output v-cntxt-db-num-obj
       56       ,output v-cntxt-is-admin
       57       ) .
       58   output stream vProtTest to "sendtest1c.log".
       59   define buffer buf_trn-doc   for ub.trn-doc.
       60   define buffer buf_doc-attr  for ub.doc-attr.
       61   define buffer buf_shift-obj for ub.shift-obj.
       62   define buffer buf_rvs-doc   for ub.rvs-doc.
       63   define buffer buf_price-doc for ub.price-doc.
       64   define buffer buf_fin-doc   for ub.fin-doc.
       65   define buffer buf_fbr-doc   for ub.fbr-doc.
       66   define buffer buf_utd       for ub.utd.
       67   define buffer buf_place       for ub.place.
       68   find last buf_trn-doc where
       69             buf_trn-doc.obj-type = v-cntxt-obj-type
       70         and buf_trn-doc.obj-code = v-cntxt-obj-code
       71         and buf_trn-doc.status_ = "факт"
       72         and buf_trn-doc.flag_
       73         and (buf_trn-doc.ext-doc-type = 'ie':U or
       74              buf_trn-doc.ext-doc-type = 'ee':U or
       75              buf_trn-doc.ext-doc-type = 'ep':U or
       76              buf_trn-doc.ext-doc-type = 'we':U or
       77              buf_trn-doc.ext-doc-type = 'ev':U or
       78              buf_trn-doc.ext-doc-type = 'iv':U or
       79              buf_trn-doc.ext-doc-type = 'rv':U or
       80              buf_trn-doc.ext-doc-type = 're':U) no-lock no-error.
       81   if avail buf_trn-doc then
       82   do:
       83     testId = rowid(buf_trn-doc).
       84     run utl/send1c.p.
       85     testId = ?.
       86   end.
       87   find last buf_trn-doc where
       88             buf_trn-doc.obj-type = v-cntxt-obj-type
       89         and buf_trn-doc.obj-code = v-cntxt-obj-code
       90         and buf_trn-doc.status_ = "факт"
       91         and buf_trn-doc.flag_
       92         and buf_trn-doc.ext-doc-type = 'vt':U no-lock no-error.
       93   if avail buf_trn-doc then
       94   do:
       95     testId = rowid(buf_trn-doc).
       96     run utl/send1c.p.
       97     testId = ?.
       98   end.
       99   find last buf_trn-doc where
      100             buf_trn-doc.obj-type = v-cntxt-obj-type
      101         and buf_trn-doc.obj-code = v-cntxt-obj-code
      102         and buf_trn-doc.status_ = "факт"
      103         and buf_trn-doc.flag_
      104         and buf_trn-doc.ext-doc-type = 'vp':U no-lock no-error.
      105   if avail buf_trn-doc then
      106   do:
      107     testId = rowid(buf_trn-doc).
      108     run utl/send1c.p.
      109     testId = ?.
      110   end.
      111   find last buf_shift-obj where
      112             buf_shift-obj.obj-type = v-cntxt-obj-type
      113         and buf_shift-obj.obj-code = v-cntxt-obj-code
      114         and buf_shift-obj.status_  = "зкр" no-lock no-error.
      115   if avail buf_shift-obj then
      116   do:
      117     testid = rowid(buf_shift-obj).
      118     run utl/send2c.p.
      119     testId = ?.
      120   end.
      121   find last buf_rvs-doc where
      122             buf_rvs-doc.obj-type = v-cntxt-obj-type
      123         and buf_rvs-doc.obj-code = v-cntxt-obj-code
      124         and buf_rvs-doc.status_ = "факт"
      125        no-lock no-error.
      126   if avail buf_rvs-doc then
      127   do:
      128     testid = rowid(buf_rvs-doc).
      129     run utl/send3c.p.
      130     testId = ?.
      131   end.
      132   find last buf_price-doc where
      133             buf_price-doc.obj-type = v-cntxt-obj-type
      134         and buf_price-doc.obj-code = v-cntxt-obj-code
      135         and buf_price-doc.status_ = "акт"
      136        no-lock no-error.
      137   if avail buf_price-doc then
      138   do:
      139     testId = rowid(buf_price-doc).
      140     run utl/send4c.p.
      141     testId = ?.
      142   end.
      143   find last buf_fin-doc where
      144             buf_fin-doc.obj-type = v-cntxt-obj-type
      145         and buf_fin-doc.obj-code = v-cntxt-obj-code
      146         and buf_fin-doc.status_ = "факт"
      147        no-lock no-error.
      148   if avail buf_fin-doc then
      149   do:
      150     testId = rowid(buf_fin-doc).
      151     run utl/send5c.p.
      152     testId = ?.
      153   end.
      154   find last buf_fbr-doc where
      155             buf_fbr-doc.obj-type = v-cntxt-obj-type
      156         and buf_fbr-doc.obj-code = v-cntxt-obj-code
      157         and buf_fbr-doc.status_ = "факт"
      158        no-lock no-error.
      159   if avail buf_fbr-doc then
      160   do:
      161     testId = rowid(buf_fbr-doc).
      162     run utl/send6c.p.
      163     testId = ?.
      164   end.
      165   find last buf_utd where
      166             buf_utd.obj-type = v-cntxt-obj-type
      167         and buf_utd.obj-code = v-cntxt-obj-code
      168         and buf_utd.sts = 8
      169        no-lock no-error.
      170   if avail buf_utd then
      171   do:
      172     testId = rowid(buf_utd).
      173     run utl/send7c.p.
      174     testId = ?.
      175   end.
      176   for each buf_place no-lock where buf_place.status_ <> 'удал':U:
      177     testId = rowid(buf_place).
      178     run utl/send9c.p.
      179   end.
      180   testId = ?.
      181   find last buf_shift-obj where
      182             buf_shift-obj.obj-type = v-cntxt-obj-type
      183         and buf_shift-obj.obj-code = v-cntxt-obj-code
      184         and buf_shift-obj.status_  = 'зкр':U no-lock no-error.
      185   if avail buf_shift-obj then
      186   do:
      187     testid = rowid(buf_shift-obj).
      188     run utl/send10c.p.
      189     testId = ?.
      190   end.
      191   output stream vProtTest close.
      192   message "Ћог - " search("sendtest1c.log") view-as alert-box.
