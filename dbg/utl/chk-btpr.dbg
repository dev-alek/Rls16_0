        1   block-level on error undo, throw.
        2   define input  parameter p-type-cut as integer   no-undo .
        3   define input  parameter p-db-list  as character no-undo .
        4   define output parameter p-ready    as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: 784232a2254b, 2720, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        7   define variable vss-date        as character no-undo init "$Date: Пн янв 18 10:14:30 2021 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: chk-btpr.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/chk-btpr.p $":U .
       10   define variable vss-description as character no-undo init "проверка BatchProcess ДО начала обрезания".
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   do
       16   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       17   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       18   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       19   :
       20     define buffer buf_BatchProcess for ub.BatchProcess .
       21     define variable v-return-value as character no-undo .
       22     assign
       23       p-ready        = true
       24       v-return-value = "":U
       25     .
       26     for each buf_BatchProcess
       27     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       28     :
       29       case buf_BatchProcess.BP_type
       30       :
       31         when 'autonws':U or
       32         when 'autoarh':U or
       33         when 'autoexp':U or
       34         when 'autooxml':U or
       35         when 'autosuz':U or
       36         when 'autogcd':U or
       37         when 'autosale':U or
       38         when 'autocbnk':U or
       39         when 'autofree':U or
       40         when 'mercury':U or
       41         when 'hddtest':U or
       42         when 'is_motp':U or
       43         when 'is_diadoc':U or
       44         when 'is_PM':U
       45         then do:
       46         end.
       47         when 'cutdbs':U
       48         then do:
       49         end.
       50         when 'rt-doc':U or
       51         when 'rt-line':U or
       52         when 'bcprint':U
       53         then do:
       54         end.
       55         when 'lkrt':U
       56         then do:
       57           assign
       58             p-ready = false
       59             v-return-value = v-return-value + chr(10)
       60                              + substitute( "Маршрутизация в БД &1 заблокирована пользователем &2 &3 в &4 (&5)"
       61                                            ,buf_BatchProcess.CharKey_One
       62                                            ,buf_BatchProcess.User_ID
       63                                            ,string( buf_BatchProcess.BP_SysDate, "99.99.9999" )
       64                                            ,buf_BatchProcess.BP_SysTime
       65                                            ,buf_BatchProcess.CharKey_Three
       66                                           )
       67           .
       68         end.
       69         when 'autoupg':U
       70         then do:
       71           assign
       72             p-ready = false
       73             v-return-value = v-return-value + chr(10) + "Не завершен upgrade."
       74           .
       75         end.
       76         when 'arh':U
       77         then do:
       78         end.
       79         when 'ahsp':U
       80         then do:
       81         end.
       82         when 'aht':U
       83         then do:
       84         end.
       85         when 'prc':U
       86         then do:
       87         end.
       88         when 'trnhd':U
       89         then do:
       90         end.
       91         when 'hold':U
       92         then do:
       93         end.
       94         when 'hinv':U
       95         then do:
       96         end.
       97         when 'hspi':U
       98         then do:
       99         end.
      100         when 'gds':U
      101         then do:
      102         end.
      103         when 'dcard':U
      104         then do:
      105         end.
      106         when 'goa':U
      107         then do:
      108         end.
      109         when 'slr':U
      110         then do:
      111         end.
      112         when 'cshr':U
      113         then do:
      114         end.
      115         when 'fgrp':U
      116         then do:
      117         end.
      118         when 'mvob':U
      119         then do:
      120             assign
      121             p-ready = false
      122             v-return-value = v-return-value + chr(10) +
      123                             substitute("Не завершен перенос объекта из одной БД в БД:&1" +
      124                                        "&2&3 переносится из БД &4 в БД &5"
      125                                        , chr(10)
      126                                        , buf_BatchProcess.CharKey_One
      127                                        , buf_BatchProcess.Key#_One
      128                                        , buf_BatchProcess.Key#_Two
      129                                        , buf_BatchProcess.Key#_Three )
      130             .
      131         end.
      132         when 'bcode':U
      133         then do:
      134         end.
      135         when 'rnar':U
      136         then do:
      137         end.
      138         otherwise do:
      139           if buf_BatchProcess.BP_type begins 'lock':U
      140           or buf_BatchProcess.BP_type begins 'lusr':U
      141           then do:
      142           end.
      143           else do:
      144             return error substitute("&1. Неизвестный тип BatchProcess &2", vss-workfile, buf_BatchProcess.BP_type ) .
      145           end.
      146         end.
      147       end case.
      148     end.
      149     return v-return-value .
      150   end.
