        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: impartcl.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: utl/impartcl.p $":U .
        7   define variable vss-description as character no-undo initial "Импорт  артикул поставщика из файла":U .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define buffer buf_cli-gds for ub.cli-gds.
       63   def var file-name as char no-undo.
       64   def var i1        as int no-undo.
       65   def var i2        as int no-undo.
       66   def var s         as char no-undo.
       67   def var r-cli-type  like ub.cli-gds.cli-type   no-undo.
       68   def var r-cli-code  like ub.cli-gds.cli-code   no-undo.
       69   def var r-host-code like ub.cli-gds.host-code  no-undo.
       70   def var r-article   like ub.cli-gds.artic      no-undo.
       71   def var r-prod-type like ub.cli-gds.prod-type  no-undo.
       72   def var r-prod-code like ub.cli-gds.prod-code  no-undo.
       73   def var r-cli-art   like ub.cli-gds.cli-art    no-undo.
       74   def stream err.
       75   message " Будем импортировать из текстового файла артикулы поставщика ? "
       76   view-as alert-box Warning buttons yes-no UPDATE choice AS LOGICAL.
       77   if choice = false then return.
       78   def var g#log as log no-undo.
       79   system-dialog get-file file-name
       80     title "Выберите файл с артикулами поставщика"
       81     filters "Текстовый файл (*.txt)"   "*.txt",
       82               "Все файлы" "*.*"
       83   update g#log.
       84   input FROM value (File-Name) convert source "1251".
       85   i1 = 0.
       86   i2 = 0.
       87   repeat:
       88        import unformatted s.
       89        s = trim (s).
       90        if s = "" then next.
       91        i1 = i1 + 1.
       92        disp i1 label "Прочитано" with frame a view-as dialog-box. PAUSE 0.
       93        if NUm-ENTRIES(s, ";") <> 7 then do:
       94              next.
       95        end.
       96        r-cli-type  = entry (1, s, ";") no-error.
       97        r-cli-code  = int(entry (2, s, ";")) no-error.
       98        r-host-code = int(entry (3, s, ";")) no-error.
       99        r-article   = entry (4, s, ";") no-error.
      100        r-prod-type = entry (5, s, ";") no-error.
      101        r-prod-code = int(entry (6, s, ";")) no-error.
      102        r-cli-art   = entry (7, s, ";") no-error.
      103        find buf_cli-gds where
      104            buf_cli-gds.cli-type   = r-cli-type and
      105            buf_cli-gds.cli-code   = r-cli-code  and
      106            buf_cli-gds.host-code  = r-host-code and
      107            buf_cli-gds.artic      = r-article   and
      108            buf_cli-gds.prod-type  = r-prod-type  and
      109            buf_cli-gds.prod-code  = r-prod-code
      110        no-error.
      111        if available buf_cli-gds then do:
      112           if trim(buf_cli-gds.cli-art) <> "" then next.
      113           buf_cli-gds.cli-art = r-cli-art.
      114        end.
      115        else do:
      116            create buf_cli-gds.
      117            assign
      118                buf_cli-gds.cli-type   = r-cli-type
      119                buf_cli-gds.cli-code   = r-cli-code
      120                buf_cli-gds.host-code  = r-host-code
      121                buf_cli-gds.artic      = r-article
      122                buf_cli-gds.prod-type  = r-prod-type
      123                buf_cli-gds.prod-code  = r-prod-code
      124                buf_cli-gds.cli-art    = r-cli-art
      125            .
      126        end.
      127   end.
      128   input close.
      129   message " Импорт закончен "
      130   view-as alert-box information buttons ok.
