     1797   procedure isExemplarGoods :
     1798     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1799     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1800     define input  parameter p-gds-code as   integer                    no-undo .
     1801     define output parameter o-result   as   logical                    no-undo.
     1802     do
     1803     on error undo, return error
     1804     :
     1805           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isExemplarGoods in g#attr-lib
     1806         (input  p-obj-type
     1807         ,input  p-obj-code
     1808         ,input p-gds-code
     1809         ,output o-result
     1810         ) no-error .
     1811       if error-status :error
     1812       then do:
     1813         undo, return error return-value .
     1814       end.
     1815     end.
     1816   end procedure.
     1817   procedure isVolumArticGoods :
     1818     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1819     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1820     define input  parameter p-gds-code as   integer                    no-undo .
     1821     define output parameter o-result   as   logical                    no-undo.
     1822     do
     1823     on error undo, return error
     1824     :
     1825           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isVolumArticGoods in g#attr-lib
     1826         (input  p-obj-type
     1827         ,input  p-obj-code
     1828         ,input p-gds-code
     1829         ,output o-result
     1830         ) no-error .
     1831       if error-status :error
     1832       then do:
     1833         undo, return error return-value .
     1834       end.
     1835     end.
     1836   end procedure.
     1837       define buffer buf_parts    for ub.parts .
     1838       define buffer buf_goods    for ub.goods .
     1839       define buffer buf_trn-doc  for ub.trn-doc .
     1840       define buffer buf_doc-line for ub.doc-line .
     1841       define buffer bf_parts     for ub.parts .
     1842       define buffer bp_parts     for ub.parts .
     1843       define buffer bf_trn-doc   for ub.trn-doc .
     1844       define buffer bf_doc-line  for ub.doc-line .
     1845       define buffer buf_gen-attr for ub.gen-attr .
     1846       define buffer buf_obj-list for obj-list.
     1847       define buffer buf_gds-list for gds-list.
     1848       define VARIABLE v-count-mark              as INTEGER   no-undo .
     1849       define VARIABLE v-alc-code                as character no-undo .
     1850       define variable v-parts-income            as character no-undo .
     1851       define variable v-parts-expence           as character no-undo .
     1852       define variable v-parts-free              as character no-undo .
     1853       define variable hndl-proc-egais-marks-lib as handle.
     1854       define VARIABLE v-mark                    as character no-undo .
     1855       define VARIABLE v-rezerv                  as integer   no-undo .
     1856       define VARIABLE ii                        as integer   no-undo .
     1857       define VARIABLE jj                        as integer   no-undo .
     1858       define VARIABLE v-in-code                 as character no-undo .
     1859       define variable v-txt-name                as character no-undo initial 'log-marks.txt'.
     1860       define VARIABLE v-attr-value              as character no-undo .
     1861       define VARIABLE v-value                   as character no-undo .
     1862       define stream str-marks .
     1863       define temp-table tt-marks like ub.gen-attr .
     1864       define buffer buf_tt-marks for tt-marks .
     1865       define temp-table tt-marks-free like ub.gen-attr .
     1866       define buffer buf_tt-marks-free for tt-marks-free .
     1867       define temp-table tt-goods like ub.goods .
     1868       define buffer buf_tt-goods for tt-goods .
     1869       output stream str-marks to value(v-txt-name)   .
     1870       case X-selectgood:
     1871           when 2 then
     1872               do:
     1873                   define variable v-curr-grp-name as character no-undo .
     1874                   for each tmp#grp no-lock
     1875                       :
     1876                       run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     1877                       for each buf_goods no-lock where buf_goods.grp-name begins v-curr-grp-name:
     1878                           RUN gds-attr-value (
     1879                               INPUT buf_goods.gds-code,
     1880                               INPUT 'alcohol-prod':U,
     1881                               OUTPUT v-attr-value,
     1882                               OUTPUT v-value
     1883                               ).
     1884                           if v-attr-value = "yes" then
     1885                           do:
     1886                               create tt-goods .
     1887                               buffer-copy buf_goods to tt-goods no-error.
     1888                               v-attr-value = "no" .
     1889                           end.
     1890                       end.
     1891                   end.
     1892               end.
     1893           when 1 then
     1894               do:
     1895                   for each buf_goods no-lock :
     1896                       RUN gds-attr-value (
     1897                           INPUT buf_goods.gds-code,
     1898                           INPUT 'alcohol-prod':U,
     1899                           OUTPUT v-attr-value,
     1900                           OUTPUT v-value
     1901                           ).
     1902                       if v-attr-value = "yes" then
     1903                       do:
     1904                           create tt-goods .
     1905                           buffer-copy buf_goods to tt-goods no-error.
     1906                           v-attr-value = "no" .
     1907                       end.
     1908                   end.
     1909               end.
     1910           when 4 or
     1911           when 5 then
     1912               do:
     1913                   for each buf_gds-list no-lock :
     1914                       RUN gds-attr-value (
     1915                           INPUT buf_gds-list.gds-code,
     1916                           INPUT 'alcohol-prod':U,
     1917                           OUTPUT v-attr-value,
     1918                           OUTPUT v-value
     1919                           ).
     1920                       if v-attr-value = "yes" then
     1921                       do:
     1922                           create tt-goods .
     1923                           buffer-copy buf_gds-list to tt-goods no-error.
     1924                           v-attr-value = "no" .
     1925                       end.
     1926                   end.
     1927               end.
     1928       end case.
     1929       for each buf_obj-list,
     1930           each buf_tt-goods
     1931           :
     1932           for each buf_parts no-lock where buf_parts.artic = buf_tt-goods.artic
     1933               and buf_parts.prod-code = buf_tt-goods.prod-code
     1934               and buf_parts.prod-type = buf_tt-goods.prod-type
     1935               and buf_parts.obj-code = buf_obj-list.obj-code
     1936               and buf_parts.obj-type = buf_obj-list.obj-type
     1937               and buf_parts.out-code = 'free-zone':U:
     1938               find FIRST buf_trn-doc where buf_trn-doc.doc-code = buf_parts.in-code
     1939                   and buf_trn-doc.doc-type = 'при':U no-error .
     1940               if AVAILABLE buf_trn-doc then
     1941               do:
     1942                   for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_parts.in-code
     1943                       and buf_doc-line.artic = buf_parts.artic
     1944                       and buf_doc-line.prod-code = buf_parts.prod-code
     1945                       and buf_doc-line.prod-type = buf_parts.prod-type:
     1946                       find first bp_parts no-lock where bp_parts.in-code =  buf_doc-line.doc-code
     1947                           and bp_parts.out-code = buf_doc-line.doc-code no-error .
     1948                       if AVAILABLE bp_parts then
     1949                       do:
     1950                           run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     1951                               ,input (buffer bp_parts:handle)
     1952                               ,output v-parts-income).
     1953                           jj = 0 .
     1954                           for each buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     1955                               and buf_gen-attr.p-key  = v-parts-income :
     1956                               find first tt-marks where tt-marks.p-key = buf_gen-attr.p-key
     1957                                   and tt-marks.attr-code = buf_gen-attr.attr-code
     1958                                   and tt-marks.table-name = buf_gen-attr.table-name
     1959                                   and tt-marks.whole-send-news = buf_gen-attr.whole-send-news no-error .
     1960                               if not AVAILABLE tt-marks then
     1961                               do:
     1962                                   create tt-marks .
     1963                                   buffer-copy buf_gen-attr to tt-marks .
     1964                                   jj = jj + 1.
     1965                               end.
     1966                           end.
     1967                       end.
     1968                       if jj <> buf_doc-line.fact-qnty then
     1969                       do:
     1970                           put stream str-marks unformatted
     1971                               substitute ("В ПН &1 кол-во товара &2 не соответствует кол-ву марок"
     1972                               , buf_doc-line.doc-code
     1973                               , buf_doc-line.artic
     1974                               , jj )
     1975                               skip .
     1976                       end.
     1977                       if jj <> 0 then
     1978                       do:
     1979                           for each bf_parts no-lock where bf_parts.in-code = buf_parts.in-code
     1980                               and bf_parts.out-code <> 'free-zone':U:
     1981                               find FIRST bf_trn-doc where bf_trn-doc.doc-code = bf_parts.out-code
     1982                                   and bf_trn-doc.doc-type = 'рас':U no-error .
     1983                               if AVAILABLE bf_trn-doc then
     1984                               do:
     1985                                   for each bf_doc-line no-lock where bf_doc-line.doc-code = bf_trn-doc.doc-code
     1986                                       and bf_doc-line.artic = bf_parts.artic
     1987                                       and bf_doc-line.prod-code = bf_parts.prod-code
     1988                                       and bf_doc-line.prod-type = bf_parts.prod-type:
     1989                                       run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     1990                                           ,input (buffer bf_parts:handle)
     1991                                           ,output v-parts-expence).
     1992                                       for each buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     1993                                           and buf_gen-attr.p-key  = v-parts-expence :
     1994                                           find first buf_tt-marks where buf_tt-marks.attr-code = buf_gen-attr.attr-code no-error.
     1995                                           if AVAILABLE buf_tt-marks then
     1996                                           do:
     1997                                               delete buf_tt-marks .
     1998                                           end.
     1999                                           else
     2000                                           do:
     2001                                               put stream str-marks unformatted
     2002                                                   substitute ("В ПН &1 нет марки &2 из расхода &3"
     2003                                                   , buf_doc-line.doc-code
     2004                                                   , buf_gen-attr.attr-code
     2005                                                   , bf_doc-line.doc-code )
     2006                                                   skip .
     2007                                           end.
     2008                                       end.
     2009                                       run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2010                                           ,input (buffer buf_parts:handle)
     2011                                           ,output v-parts-free).
     2012                                       for each buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     2013                                           and buf_gen-attr.p-key  = v-parts-free :
     2014                                           find first buf_tt-marks where buf_tt-marks.attr-code = buf_gen-attr.attr-code no-error.
     2015                                           if AVAILABLE buf_tt-marks then
     2016                                           do:
     2017                                               delete buf_tt-marks .
     2018                                           end.
     2019                                           else
     2020                                           do:
     2021                                               put stream str-marks unformatted
     2022                                                   substitute ("В free-zone есть марка &1, которой нет в ПН и в РН"
     2023                                                   , buf_tt-marks.attr-code )
     2024                                                   skip .
     2025                                           end.
     2026                                           for each buf_tt-marks :
     2027                                               put stream str-marks unformatted
     2028                                                   substitute ("В ПН есть марка, которой нет ни в РН и в free-zone"
     2029                                                   , buf_tt-marks.attr-code )
     2030                                                   skip .
     2031                                           end.
     2032                                       end.
     2033                                   end.
     2034                               end.
     2035                           end.
     2036                       end.
     2037                   end.
     2038               end.
     2039           end.
     2040       end.
     2041       output stream str-marks close.
     2042       MESSAGE "Проверка завершена"
     2043           VIEW-AS ALERT-BOX.
