      738   procedure create_obj-list :
      739      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      740      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      741      do
      742      on error undo, return error return-value
      743      :
      744         define buffer cli-obj for ub.clients .
      745         define variable p-var as integer no-undo .
      746         define buffer buf_obj-list for obj-list .
      747         find last buf_obj-list  use-index pi no-error .
      748         if available buf_obj-list
      749         then
      750            p-var = buf_obj-list.obj-id + 1.
      751         else
      752            p-var = 1.
      753         find first cli-obj where
      754                   cli-obj.obj-type = p-obj-type
      755               and cli-obj.obj-code = p-obj-code
      756         no-lock no-error.
      757         if available cli-obj
      758         then do:
      759            create buf_obj-list.
      760            assign
      761               buf_obj-list.obj-id   = p-var
      762               buf_obj-list.obj-code = cli-obj.obj-code
      763               buf_obj-list.obj-type = cli-obj.obj-type
      764               buf_obj-list.obj-name = cli-obj.obj-name
      765               buf_obj-list.db-num   = cli-obj.db-num
      766            .
      767         end.
      768      end.
      769   end.
