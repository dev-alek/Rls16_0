     1751       if error-status :error
     1752       then do:
     1753         undo, return error return-value .
     1754       end.
     1755     end.
     1756   end procedure.
     1757   procedure gds-attr_check-can-energy-value :
     1758     define input  parameter p-gds-code    like ub.goods-attr.gds-code     no-undo .
     1759     define input  parameter p-code        like ub.goods-attr.attr-code  no-undo .
     1760     define input  parameter p-value       as character no-undo .
     1761     define input  parameter p-mode        as character no-undo .
     1762     define output parameter p-correct     as logical no-undo .
     1763     define output parameter p-error-code  as character no-undo .
     1764     do
     1765     on error undo, return error return-value
     1766     :
     1767           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-can-energy-value in g#attr-lib
     1768         (input  p-gds-code
     1769         ,input  p-code
     1770         ,input  p-value
     1771         ,input  p-mode
     1772         ,output p-correct
     1773         ,output p-error-code
     1774         ) no-error .
     1775       if error-status :error
     1776       then do:
     1777         undo, return error return-value .
     1778       end.
     1779     end.
     1780   end procedure.
     1781   procedure gds-attr_check-can-set-dt-seasons :
     1782     define input  parameter p-gds-code    like ub.goods-attr.gds-code     no-undo .
     1783     define output parameter p-can-set  as logical no-undo .
