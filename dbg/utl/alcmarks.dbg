      895   run proc-page0-assign in this-procedure .
      896   procedure proc-page0-assign :
      897    do
      898    on error undo, return error return-value
      899    :
      900   Assign
      901     Col-name[1] = 'A':U
      902     Col-name[2] = 'B':U
      903     Col-name[3] = 'C':U
