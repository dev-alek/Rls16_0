     1167   define variable vss-include-info10 as character format "X(65)" no-undo
     1168   initial "@(#)$Workfile$ $Revision$".
     1169   procedure grplib-get-full-name :
     1170      define input parameter p-node-code  as integer      no-undo.
     1171      define output parameter p-full-name as character    no-undo.
     1172      do
     1173   on error undo, return error
     1174   :
     1175       define variable v-upper-code    as integer           no-undo.
     1176       define buffer buf_gds-grp       for ub.gds-grp.
     1177       define buffer buf_upper_gds-grp for ub.gds-grp.
     1178       find first buf_gds-grp no-lock
     1179            where buf_gds-grp.node-code = p-node-code
     1180       no-error.
     1181       if not available buf_gds-grp
     1182       then do:
     1183           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1184       end.
     1185       assign
     1186           p-full-name  = ""
     1187           v-upper-code = 1
     1188       .
     1189       do while buf_gds-grp.upper-code <> 0
     1190       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1191       :
     1192           assign
     1193               p-full-name  = buf_gds-grp.node-name
     1194                            + (if p-full-name <> "" then chr(47) else "")
     1195                            + p-full-name
     1196               v-upper-code = buf_gds-grp.upper-code
     1197           .
     1198           find first buf_gds-grp no-lock
     1199                where buf_gds-grp.node-code = v-upper-code
     1200           no-error.
     1201           if not available buf_gds-grp
     1202           then do:
     1203               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1204                                   + string( v-upper-code )
     1205                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1206           end.
     1207       end.
     1208       assign
     1209       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1210       .
     1211   end.
     1212   end .
     1213   procedure grplib-get-node-from-full-name :
     1214   define input parameter p-full-name as character no-undo .
     1215   define output parameter p-node-code as integer no-undo .
     1216   define variable v-ii as integer no-undo .
     1217   define variable v-upper-code as integer no-undo .
     1218   define variable v-root-code as integer no-undo .
     1219   define variable v-entry as character no-undo .
     1220   define buffer buf_gds-grp       for ub.gds-grp.
     1221   do
     1222   on error undo, return error
     1223   :
     1224     find first buf_gds-grp no-lock
     1225         where buf_gds-grp.upper-code = 0
     1226     no-error .
     1227     if not available buf_gds-grp
     1228     then do:
     1229         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1230     end.
     1231     else do:
     1232       assign
     1233       v-root-code = buf_gds-grp.node-code
     1234       .
     1235     end.
     1236     v-upper-code = v-root-code.
     1237     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1238       assign
     1239       v-entry = entry(v-ii, p-full-name, chr(47)).
     1240       if v-entry = '' then leave.
     1241       find first buf_gds-grp no-lock where
     1242                 buf_gds-grp.node-name = v-entry
     1243             and buf_gds-grp.upper-code = v-upper-code
     1244             no-error.
     1245       if not available buf_gds-grp then do:
     1246         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1247       end.
     1248       else do:
     1249         p-node-code = buf_gds-grp.node-code.
     1250         v-upper-code = buf_gds-grp.node-code.
     1251       end.
     1252     end.
     1253   end.
     1254   end .
     1255   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1256   define new global shared variable g#attr-lib  as handle no-undo .
