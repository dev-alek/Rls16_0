        1   block-level on error undo, throw.
        2   define input  parameter file-pck-name as   character            no-undo .
        3   define input  parameter old-pck-name  as   character            no-undo .
        4   define input  parameter p-mode        as   character            no-undo .
        5   define input  parameter p-append      as   logical              no-undo .
        6   define input  parameter p-first       as   logical              no-undo .
        7   define input  parameter p-last        as   logical              no-undo .
        8   define input  parameter p-tbl-names   as   character            no-undo .
        9   define input  parameter p-buffer-num  as integer no-undo .
       10   define input  parameter p-prepare-phrase as character no-undo .
       11   define input-output parameter num-exp-rec   as   integer              no-undo .
       12   define input-output parameter err-gen-pack  as   integer              no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: upg-exp.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: utl/upg-exp.p $":U .
       18   define variable vss-description as character no-undo init "Экспорт в формате пакета новостей".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define stream ddl .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure upg-exp :
       91     define input  parameter p-tbl-handle as handle    no-undo .
       92     do
       93     on error  undo, return error substitute( "&1 (nws-exp). &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( 1 ) )
       94     on stop   undo, return error substitute( "&1 (nws-exp). stop", vss-include-info0 )
       95     on endkey undo, return error substitute( "&1 (nws-exp). endkey", vss-include-info0 )
       96     :
       97       define variable v-num-fields as integer   no-undo .
       98       define variable v-ind        as integer   no-undo .
       99       define variable v-fh         as handle    no-undo .
      100       define variable v-str        as character no-undo .
      101       assign
      102         v-num-fields = p-tbl-handle:num-fields
      103       .
      104       put stream ddl unformatted substitute( '"<num-fields>" "&1" ':U, v-num-fields ).
      105       do v-ind = 1 to v-num-fields
      106       on error undo, return error substitute( "&1 (nws-exp). &2", vss-include-info0, error-status :get-message ( 1 ) )
      107       :
      108           assign
      109             v-fh = p-tbl-handle:buffer-field(v-ind)
      110         .
      111         if v-fh:data-type = 'clob':U
      112         or v-fh:data-type = 'blob':U
      113         then do:
      114            assign
      115            v-str = ?.
      116         end.
      117         else do:
      118            assign
      119             v-str = replace( v-fh:buffer-value, '"':U, '""':U )
      120           .
      121           if v-fh:data-type = 'character':U
      122           and  v-fh:buffer-value = chr(63)
      123           then do:
      124             assign
      125             v-str = substitute("'&1'", v-str).
      126           end.
      127           if        p-tbl-handle:table            eq "tt_thbj-attr"
      128                and  p-tbl-handle::upper-prop-code eq "gismt"
      129                and  v-fh:name                     eq "property-value-character"
      130                and (    p-tbl-handle::prop-code eq "oflinepswd"
      131                      or p-tbl-handle::prop-code eq "proxypswd"
      132                      or p-tbl-handle::prop-code eq "MaxApiToken")
      133             then
      134                v-str = fill("*",length(v-str)).
      135         end.
      136         put stream ddl unformatted substitute( '"<&1>" "&2" ':U, v-fh:name, v-str ).
      137       end.
      138       put stream ddl unformatted skip.
      139     end.
      140   end procedure.
      141   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   define temp-table temp-lock no-undo
      143     field lock-conn-id   as integer   label "Номер Подключения"
      144     field user-name      as character label "Пользователь"
      145     field lock-flag      as character label "Флаг"
      146     field trans-id       as integer   label "Транзакция"
      147     field trans-txtime   as character
      148     field trans-state    as character
      149     field trans-dur      as integer
      150     field connect-type   as character label "Подключение"
      151     field connect-time   as character format "x(20)"
      152     field connect-device as character format "x(40)" label "Устройство"
      153     .
      154   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   procedure gen-key-rec :
      156     define input  parameter p-tbl-name    as character no-undo.
      157     define input  parameter p-bh_tbl-name as handle    no-undo.
      158     define output parameter p-key-rec     as character no-undo.
      159     do
      160     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      161     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      162     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      163     :
      164       define variable fh               as handle    no-undo .
      165       define variable v-ok             as logical   no-undo .
      166       define variable v-inform         as character no-undo .
      167       define variable v-ind            as integer   no-undo .
      168       define variable v-idx-field-qnty as integer   no-undo .
      169       if p-tbl-name = ?
      170         or p-tbl-name = "":U
      171       then do:
      172         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      173       end.
      174       if not p-bh_tbl-name:available then do:
      175         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      176       end.
      177       assign
      178         p-key-rec = p-tbl-name
      179         v-inform  = p-bh_tbl-name:index-information(1)
      180         v-ind     = 2
      181       .
      182       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      183       on error undo, return error
      184       :
      185         assign
      186           v-inform = p-bh_tbl-name:index-information( v-ind )
      187           v-ind    = v-ind + 1
      188         .
      189       end.
      190       if v-inform = ?
      191         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      192         or entry( 3, v-inform, ",":U ) <> "1":U
      193       then do:
      194         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      195       end.
      196       else do:
      197         assign
      198           v-idx-field-qnty = num-entries( v-inform ) - 4
      199         .
      200         if v-idx-field-qnty < 2 then do:
      201           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      202         end.
      203         do v-ind = 1 to v-idx-field-qnty by 2
      204         on error undo, return error
      205         :
      206           assign
      207             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      208             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      209           .
      210         end.
      211       end.
      212       if p-key-rec = ? then do:
      213         assign
      214           p-key-rec = "":U
      215         .
      216         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      217       end.
      218     end.
      219     return.
      220   end procedure.
      221   procedure gen-where-keyr-tab :
      222     define input  parameter i-tableSerach as character no-undo.
      223     define input  parameter i-tablekey   as character  no-undo.
      224     define input  parameter p-key-rec    as character  no-undo.
      225     define input  parameter p-key-handle as handle     no-undo .
      226     define input  parameter p-db-name    as character  no-undo .
      227     define input  parameter p-tt-handle  as handle     no-undo .
      228     define output parameter o-Where      as character  no-undo.
      229     do
      230     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      231     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      232     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      233     :
      234       define variable v-full-tbl-name  as character no-undo .
      235       define variable bh_tbl-name      as handle    no-undo .
      236       define variable fh_key           as handle    no-undo .
      237       define variable fh_search        as handle    no-undo .
      238       define variable v-field-num      as integer   no-undo .
      239       define variable v-count-fld      as integer   no-undo .
      240       define variable v-inform         as character no-undo .
      241       define variable v-ind            as integer   no-undo .
      242       define variable v-idx-field-qnty as integer   no-undo .
      243       define variable v-field-name     as character no-undo .
      244       define variable v-field-val      as character no-undo .
      245       define variable v-word-link      as character no-undo .
      246       define variable vTable           as character no-undo.
      247       define variable bh_tbl-key       as handle    no-undo .
      248       assign
      249         p-key-rec = trim( p-key-rec )
      250       .
      251       if p-key-handle <> ? then do:
      252         if not valid-handle(p-key-handle)
      253            or p-key-handle:type <> "buffer"
      254         then do:
      255           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      256         end.
      257         if num-entries( p-key-rec, chr(3) ) > 1
      258           or p-key-rec = ?
      259           or p-key-rec = "":U
      260         then do:
      261           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      262         end.
      263       end.
      264       else do:
      265         if p-key-rec = ?
      266           or p-key-rec = "":U
      267         then do:
      268           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      269         end.
      270       end.
      271       assign
      272         vTable = entry( 1 , p-key-rec, chr(3) )
      273       .
      274       if p-tt-handle <> ?
      275         and ( not valid-handle(p-tt-handle)
      276               or p-tt-handle:type <> "buffer"
      277             )
      278       then do:
      279         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      280       end.
      281       if p-tt-handle = ? then do:
      282         assign
      283           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      284         .
      285         create buffer bh_tbl-name for table v-full-tbl-name .
      286       end.
      287       else do:
      288         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      289       end.
      290       assign
      291         v-inform = bh_tbl-name:index-information(1)
      292         v-ind    = 2
      293       .
      294       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      295       on error undo, return error
      296       :
      297         assign
      298           v-inform = bh_tbl-name:index-information( v-ind )
      299           v-ind    = v-ind + 1
      300         .
      301       end.
      302       if v-inform = ?
      303         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      304         or entry( 3, v-inform, ",":U ) <> "1":U
      305       then do:
      306         delete object bh_tbl-name no-error.
      307         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      308       end.
      309       assign
      310         v-idx-field-qnty = num-entries( v-inform ) - 4
      311       .
      312       if v-idx-field-qnty < 2 then do:
      313         delete object bh_tbl-name no-error.
      314         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      315       end.
      316       assign
      317         o-where     = "where":U
      318         v-word-link = "":U
      319         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      320         v-count-fld = 0
      321       .
      322       if i-tablekey ne "" and i-tablekey ne ?
      323       then do:
      324         assign
      325           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      326         .
      327         create buffer bh_tbl-key for table v-full-tbl-name .
      328       end.
      329       if i-tableSerach ne "" and i-tableSerach ne ?
      330       then do:
      331         delete object bh_tbl-name no-error.
      332         assign
      333           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      334         .
      335         create buffer bh_tbl-name for table v-full-tbl-name .
      336       end.
      337       block_where:
      338       do v-ind = 1 to v-idx-field-qnty by 2
      339       on error undo, return error
      340       :
      341         assign
      342           v-count-fld = v-count-fld + 1
      343         .
      344         if p-key-handle = ?
      345           and v-count-fld > v-field-num
      346         then do:
      347           leave block_where.
      348         end.
      349         define variable VfieldKeyTable as handle no-undo.
      350         assign
      351           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      352           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      353         .
      354         if     bh_tbl-key ne ?
      355         then do:
      356            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      357            if VfieldKeyTable eq ?
      358            then next block_where.
      359         end.
      360         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      361         then
      362            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      363         else
      364            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      365         if p-key-handle = ? then do:
      366           assign
      367             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      368           .
      369         end.
      370         else do:
      371           assign
      372             fh_key = p-key-handle:buffer-field( v-field-name )
      373           .
      374           if fh_key = ?
      375             or not valid-handle( fh_key )
      376           then do:
      377             delete object bh_tbl-name.
      378             if     bh_tbl-key ne ?
      379             then
      380                delete object bh_tbl-key.
      381             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      382           end.
      383           assign
      384             v-field-val = fh_key:buffer-value
      385           .
      386         end.
      387         if fh_search:data-type ="character":U then do:
      388           assign
      389             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      390             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      391             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      392             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      393             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      394             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      395             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      396             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      397             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      398             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      399             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      400             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      401             v-field-val = substitute( '"&1"', v-field-val )
      402           .
      403         end.
      404         assign
      405           o-where = substitute( "&1 &2", o-where, v-field-val )
      406         .
      407         if v-word-link = "":U then do:
      408           assign
      409             v-word-link = "and":U
      410           .
      411         end.
      412       end.
      413       delete object bh_tbl-name.
      414       if     bh_tbl-key ne ?
      415       then
      416          delete object bh_tbl-key.
      417       if p-key-handle = ?
      418         and v-count-fld <> v-field-num
      419       then do:
      420         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      421       end.
      422     end.
      423   end procedure.
      424   procedure gen-hn-keyr-tab :
      425     define input  parameter i-tableSerach as character no-undo.
      426     define input  parameter i-tablekey   as character no-undo.
      427     define input  parameter p-key-rec    as character no-undo.
      428     define input  parameter p-key-handle as handle    no-undo .
      429     define input  parameter p-db-name    as character no-undo .
      430     define input  parameter p-tt-handle  as handle    no-undo .
      431     define input  parameter p-stts-lock  as integer   no-undo .
      432     define output parameter o-hn         as handle    no-undo.
      433     define variable v-full-tbl-name as character no-undo.
      434     define variable v-where         as character no-undo.
      435     define variable bh_tbl-name     as handle    no-undo.
      436     define variable vTable          as character no-undo.
      437     do
      438     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      439     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      440     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      441         run gen-where-keyr-tab(i-tableSerach,
      442                                i-tablekey,
      443                                p-key-rec,
      444                                p-key-handle,
      445                                p-db-name,
      446                                p-tt-handle,
      447                                output v-where).
      448         if i-tableSerach ne "" and i-tableSerach ne ?
      449         then do:
      450            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      451            create buffer bh_tbl-name for table v-full-tbl-name .
      452         end.
      453         else do:
      454            if p-tt-handle = ? then do:
      455               assign
      456                  vTable = entry( 1 , p-key-rec, chr(3) )
      457               .
      458               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      459               create buffer bh_tbl-name for table v-full-tbl-name .
      460            end.
      461            else do:
      462               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      463            end.
      464         end.
      465         if p-tt-handle = ? then do:
      466            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      467         end.
      468         else do:
      469            bh_tbl-name:find-first( v-where ) no-error .
      470         end.
      471         o-hn = bh_tbl-name.
      472      end.
      473   end procedure.
      474   procedure gen-hn-keyr :
      475     define input  parameter p-key-rec    as character no-undo.
      476     define input  parameter p-key-handle as handle    no-undo .
      477     define input  parameter p-db-name    as character no-undo .
      478     define input  parameter p-tt-handle  as handle    no-undo .
      479     define input  parameter p-stts-lock  as integer   no-undo .
      480     define output parameter o-hn         as handle    no-undo.
      481     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      482   end.
      483   procedure gen-row-keyr :
      484     define input  parameter p-key-rec    as character no-undo.
      485     define input  parameter p-key-handle as handle    no-undo .
      486     define input  parameter p-db-name    as character no-undo .
      487     define input  parameter p-tt-handle  as handle    no-undo .
      488     define input  parameter p-stts-lock  as integer   no-undo .
      489     define output parameter p-tbl-row    as rowid     no-undo.
      490     define output parameter p-tbl-name   as character no-undo.
      491     define variable vHn as handle no-undo.
      492       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      493       p-tbl-row = if vHn:available then vHn:rowid else ?.
      494       p-tbl-name =  vHn:table.
      495       delete object vHn no-error.
      496     if p-tbl-row = ? then do:
      497       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      498     end.
      499     else do:
      500       return.
      501     end.
      502   end procedure.
      503   procedure gen-key-fv :
      504     define input  parameter p-key-rec    as character no-undo .
      505     define output parameter p-field-list as character no-undo .
      506     define output parameter p-value-list as character no-undo.
      507     do
      508     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      509     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      510     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      511     :
      512       define variable v-full-tbl-name  as character no-undo .
      513       define variable bh_tbl-name      as handle    no-undo .
      514       define variable v-tbl-name       as character no-undo .
      515       define variable v-field-num      as integer   no-undo .
      516       define variable v-count-fld      as integer   no-undo .
      517       define variable v-inform         as character no-undo .
      518       define variable v-ind            as integer   no-undo .
      519       define variable v-idx-field-qnty as integer   no-undo .
      520       define variable v-delim-key      as character no-undo .
      521       if p-key-rec = ?
      522         or p-key-rec = "":U
      523       then do:
      524         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      525       end.
      526       assign
      527         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      528         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      529       .
      530       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      531       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      532       assign
      533         v-inform = bh_tbl-name:index-information(1)
      534         v-ind    = 2
      535       .
      536       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      537       on error undo, return error
      538       :
      539         assign
      540           v-inform = bh_tbl-name:index-information( v-ind )
      541           v-ind    = v-ind + 1
      542         .
      543       end.
      544       if v-inform = ?
      545         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      546         or entry( 3, v-inform, ",":U ) <> "1":U
      547       then do:
      548         delete object bh_tbl-name no-error.
      549         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      550       end.
      551       assign
      552         v-idx-field-qnty = num-entries( v-inform ) - 4
      553       .
      554       if v-idx-field-qnty < 2 then do:
      555         delete object bh_tbl-name no-error.
      556         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      557       end.
      558       assign
      559         p-field-list = "":U
      560         p-value-list = "":U
      561         v-delim-key  = "":U
      562         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      563         v-count-fld  = 0
      564       .
      565       block_where:
      566       do v-ind = 1 to v-idx-field-qnty by 2
      567       on error undo, return error
      568       :
      569         assign
      570           v-count-fld = v-count-fld + 1
      571         .
      572         if v-count-fld > v-field-num then do:
      573           leave block_where.
      574         end.
      575         assign
      576           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      577           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      578         .
      579         if v-ind = 1 then do:
      580           assign
      581             v-delim-key = chr(3)
      582           .
      583         end.
      584       end.
      585       delete object bh_tbl-name.
      586       if v-count-fld <> v-field-num then do:
      587         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      588       end.
      589     end.
      590   end procedure.
      591   procedure gen-key-field :
      592     define input  parameter p-table      as character no-undo .
      593     define output parameter p-field-list as character no-undo .
      594     do
      595     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      596     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      597     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      598     :
      599       define variable v-full-tbl-name  as character no-undo .
      600       define variable bh_tbl-name      as handle    no-undo .
      601       define variable v-tbl-name       as character no-undo .
      602       define variable v-field-num      as integer   no-undo .
      603       define variable v-count-fld      as integer   no-undo .
      604       define variable v-inform         as character no-undo .
      605       define variable v-ind            as integer   no-undo .
      606       define variable v-idx-field-qnty as integer   no-undo .
      607       define variable v-delim-key      as character no-undo .
      608       if p-table = ?
      609         or p-table = "":U
      610       then do:
      611         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      612       end.
      613       assign
      614         v-tbl-name      = p-table
      615         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      616       .
      617       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      618       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      619       assign
      620         v-inform = bh_tbl-name:index-information(1)
      621         v-ind    = 2
      622       .
      623       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      624       on error undo, return error
      625       :
      626         assign
      627           v-inform = bh_tbl-name:index-information( v-ind )
      628           v-ind    = v-ind + 1
      629         .
      630       end.
      631       if v-inform = ?
      632         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      633         or entry( 3, v-inform, ",":U ) <> "1":U
      634       then do:
      635         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      636       end.
      637       assign
      638         v-idx-field-qnty = num-entries( v-inform ) - 4
      639       .
      640       if v-idx-field-qnty < 2 then do:
      641         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      642       end.
      643       assign
      644         p-field-list = "":U
      645         v-delim-key  = "":U
      646         v-count-fld  = 0
      647       .
      648       block_where:
      649       do v-ind = 1 to v-idx-field-qnty by 2
      650       on error undo, return error
      651       :
      652         assign
      653           v-count-fld = v-count-fld + 1
      654         .
      655         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      656         if v-ind = 1 then do:
      657           assign
      658             v-delim-key = chr(3)
      659           .
      660         end.
      661       end.
      662       delete object bh_tbl-name.
      663     end.
      664   end procedure.
      665   define stream Imp-stream.
      666   define stream Imp2-stream.
      667   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   define  temp-table temp-tables no-undo
      669   field tbl-name as character
      670   field buf-handle as handle
      671   field tbl-handle as handle
      672   index pi is unique primary
      673   tbl-name.
      674   define  temp-table temp-command no-undo
      675   field command-name as character
      676   field tbl-name as character
      677   field uniq-key-rec as character
      678   index pi is unique primary
      679   tbl-name
      680   command-name
      681   uniq-key-rec
      682   index icommand
      683   command-name
      684   tbl-name
      685   uniq-key-rec
      686   .
      687   define buffer buf_temp-tables for temp-tables.
      688   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689   procedure impdelta :
      690     define input  parameter p-buf-handle as handle    no-undo .
      691     do
      692     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( 1 ) )
      693     on stop   undo, return error substitute( "&1. stop", vss-include-info4 )
      694     on endkey undo, return error substitute( "&1. endkey", vss-include-info4 )
      695     :
      696       define variable v-imp-str    as character extent 1000 no-undo .
      697       define variable v-num-fields as integer   no-undo .
      698       define variable v-ind        as integer   no-undo .
      699       define variable v-fld-name   as character no-undo .
      700       define variable v-fld-value  as character no-undo .
      701       define variable v-fh         as handle    no-undo .
      702       if not p-buf-handle:available then do:
      703         return error substitute( "(upg-imp) &1&2Buffer таблицы &3 еще не создан!"
      704                                   ,vss-include-info4
      705                                   ,chr(10)
      706                                   ,p-buf-handle:name
      707                                 ).
      708       end.
      709       import stream imp-stream v-imp-str.
      710       if v-imp-str[1] <> "<num-fields>" then do:
      711         return error substitute( "(upg-imp) &1&2Неверный формат строки для импорта записи&2Строка должна начинаться с <num-fields> а начинается с &3!"
      712                                   ,vss-include-info4
      713                                   ,chr(10)
      714                                   ,v-imp-str[1]
      715                                 ).
      716       end.
      717       assign
      718         v-fld-name   = "":U
      719         v-fld-value  = "":U
      720         v-num-fields = integer( v-imp-str[2] )
      721       .
      722       block_read:
      723       do v-ind = 3 to v-num-fields * 2 + 2 by 2
      724       on error undo, return error
      725       :
      726         assign
      727           v-fld-name  = v-imp-str[v-ind]
      728         .
      729         if v-fld-name <> "":U then do:
      730           assign
      731             v-fld-name  = substring( v-fld-name, 2, length(v-fld-name) - 2)
      732             v-fld-value = v-imp-str[v-ind + 1]
      733             v-fh = p-buf-handle:buffer-field( v-fld-name ) no-error
      734           .
      735           if error-status :error
      736             or v-fh = ?
      737           then do:
      738             return error substitute( "(upg-imp) &1&2Поле &3 не найдено в таблице &4&2&5"
      739                                       ,vss-include-info4
      740                                       ,chr(10)
      741                                       ,v-fld-name
      742                                       ,p-buf-handle:name
      743                                     ,error-status :get-message ( 1 )
      744                                     ).
      745           end.
      746           assign
      747             v-fh:buffer-value = v-fld-value
      748           .
      749         end.
      750         else do:
      751           leave block_read.
      752         end.
      753       end.
      754     end.
      755   end procedure.
      756   procedure proc-load-tt-standart :
      757     define input parameter p-tbl-name   as character no-undo .
      758     define input parameter p-imp-handle as handle    no-undo.
      759     define input parameter l-counter    as integer   no-undo.
      760     do
      761     on error  undo, return error substitute( "&1 (proc-load-tt-standart). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      762     on stop   undo, return error substitute( "&1 (proc-load-tt-standart). stop", vss-include-info4 )
      763     on endkey undo, return error substitute( "&1 (proc-load-tt-standart). endkey", vss-include-info4 )
      764     :
      765       define variable v-full-tbl-name  as character no-undo .
      766       define variable bh_tbl-name      as handle    no-undo .
      767       define variable tt-name         as character no-undo .
      768       define variable tth             as handle    no-undo .
      769       define variable bh_tt           as handle    no-undo .
      770       define variable v-ok            as logical   no-undo .
      771       define buffer buf_temp-tables for temp-tables.
      772       if l-counter <> 0 then do:
      773         return error substitute( "&1 (proc-load-tt-standart). Ошибка обработки записи &2&3Есть привязанные записи, а обработка идет для одной", vss-include-info4, p-tbl-name, chr(10) ).
      774       end.
      775       assign
      776         v-full-tbl-name = substitute( "ub.&1":U, p-tbl-name )
      777       .
      778       find first buf_temp-tables where
      779                 buf_temp-tables.tbl-name = p-tbl-name no-error .
      780       if not available buf_temp-tables then do:
      781         create temp-table tth.
      782         assign
      783           tt-name = "wt-" + p-tbl-name
      784           tth:undo = no
      785         .
      786         assign
      787           v-ok = tth:create-like( v-full-tbl-name ) no-error
      788         .
      789         if v-ok <> true then do:
      790           return error substitute( "&1 (proc-load-tt-standart). Ошибка при создании временной таблицы &2 (&3) (1)", vss-include-info4, tt-name, error-status:get-message(1)  ) .
      791         end.
      792         assign
      793           v-ok = tth:temp-table-prepare( tt-name ) no-error
      794         .
      795         if v-ok <> true then do:
      796           return error substitute( "&1 (proc-load-tt-standart). Ошибка при создании временной таблицы &2 (&3) (2)", vss-include-info4, tt-name, error-status:get-message(1)  ) .
      797         end.
      798         create buf_temp-tables.
      799         assign
      800         buf_temp-tables.tbl-name = p-tbl-name
      801         buf_temp-tables.buf-handle = tth:default-buffer-handle
      802         buf_temp-tables.tbl-handle = tth
      803         .
      804        end.
      805        assign
      806         bh_tt = buf_temp-tables.buf-handle
      807         .
      808         assign
      809           v-ok = bh_tt:buffer-create no-error
      810         .
      811         if v-ok <> true then do:
      812           return error substitute( "&1 (proc-load-tt-standart). Ошибка при создании буфера временной таблицы.", vss-include-info4 ).
      813         end.
      814         run impdelta in p-imp-handle
      815           (
      816           input bh_tt
      817           ) no-error.
      818         if error-status :error then do:
      819           return error return-value .
      820         end.
      821     end.
      822   end procedure.
      823   procedure proc-load-tt-command :
      824     define input parameter rec-full     as character no-undo .
      825     define input parameter p-imp-handle as handle    no-undo.
      826     define input parameter l-counter    as integer   no-undo.
      827     define variable v-key-rec        as character no-undo .
      828     define variable v-tbl-row        as rowid     no-undo .
      829     define variable v-tbl-name       as character no-undo .
      830     define variable v-full-tbl-name as character no-undo .
      831     define variable v-ok as logical no-undo .
      832     define variable bh_tbl-name      as handle no-undo .
      833     define buffer buf_temp-command for temp-command.
      834     do
      835     on error  undo, return error substitute( "&1 (proc-load-command). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      836     on stop   undo, return error substitute( "&1 (proc-load-command). stop", vss-include-info4 )
      837     on endkey undo, return error substitute( "&1 (proc-load-command). endkey", vss-include-info4 )
      838     :
      839       case entry(1,rec-full,chr(1)):
      840         when "command" then do:
      841           case entry(2,rec-full,chr(1)):
      842             when "delete":U then do:
      843               assign
      844                 v-key-rec = entry( 3, rec-full, chr(1) )
      845               .
      846               run gen-row-keyr in this-procedure
      847                 ( input  v-key-rec
      848                 ,input ?
      849                 ,input "ub":U
      850                 ,input ?
      851                 ,input share-lock
      852                 ,output v-tbl-row
      853                 ,output v-tbl-name
      854                 ) no-error .
      855               if error-status :error then do:
      856                 return error  ( substitute( "&1. Ошибка при поиске записи по уникальному ключу &2.&3&4&3&5"
      857                                               ,vss-workfile
      858                                               ,v-key-rec
      859                                               ,chr(10)
      860                                               ,return-value
      861                                               ,error-status :get-message ( error-status :num-messages )
      862                                             )
      863                                 ).
      864               end.
      865               assign
      866                 v-full-tbl-name = substitute( "&1.&2":U, "ub", v-tbl-name )
      867               .
      868               create buffer bh_tbl-name for table v-full-tbl-name .
      869               bh_tbl-name:find-by-rowid(v-tbl-row, exclusive-lock ) no-error .
      870               if bh_tbl-name:available then do:
      871                 find first buf_temp-command where
      872                           buf_temp-command.tbl-name = v-tbl-name
      873                       and buf_temp-command.command-name = entry(2,rec-full,chr(1))
      874                       and buf_temp-command.uniq-key-rec = v-key-rec  no-error .
      875                 if not available buf_temp-command then do:
      876                   create buf_temp-command.
      877                   assign
      878                   buf_temp-command.tbl-name = v-tbl-name
      879                   buf_temp-command.command-name = entry(2,rec-full,chr(1))
      880                   buf_temp-command.uniq-key-rec = v-key-rec
      881                   no-error.
      882                   if error-status:error then do:
      883                     return error substitute( "&1 (proc-load-tt-command). Ошибка при создании записи необходимости удаления.", vss-include-info4 ).
      884                   end.
      885                 end.
      886               end.
      887               else do:
      888               end.
      889               delete object bh_tbl-name.
      890             end.
      891           end case.
      892         end.
      893       end.
      894     end.
      895   end procedure.
      896   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      897   procedure import-in-tt :
      898   define input parameter p-pck-name as character no-undo .
      899   do
      900   on error undo, return error
      901   :
      902   define buffer buf_sys-ctrl          for ub.sys-ctrl .
      903   define variable rec-cnt as integer no-undo .
      904   define variable rec-full      as character no-undo.
      905   define variable rec-name      as character no-undo.
      906   define variable rec-num       as integer   no-undo.
      907   define variable Ok            as logical   no-undo.
      908   define variable sub-rec-cnt   as integer   no-undo.
      909   define variable v-str         as character no-undo .
      910   define variable v-temp-str    as character no-undo .
      911   define variable v-temp-all as character extent 1000 no-undo .
      912   define frame imp-pck
      913   p-pck-name    label "Имя файла" format "x(50)" skip
      914   rec-cnt       label "Записей" skip
      915   v-str         label "" format "x(50)" skip
      916   with view-as dialog-box side-labels 1 columns three-d title "** Разбор файла"
      917   .
      918   assign
      919     Ok = FALSE
      920     .
      921   view frame imp-pck.
      922   hide v-str in frame imp-pck.
      923   input stream imp-stream from value( p-pck-name ).
      924   do with frame imp-pck
      925   :
      926     assign
      927       p-pck-name :screen-value = string( p-pck-name, p-pck-name :format)
      928     .
      929   end.
      930   assign
      931   rec-cnt = 0
      932   .
      933   beg-imp:
      934   repeat
      935   on error  undo, return error substitute("&1. error beg-imp. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      936   on endkey undo, return error substitute("&1. endkey beg-imp")
      937   on stop   undo, return error substitute("&1. stop beg-imp")
      938   :
      939     import stream imp-stream rec-full .
      940     assign rec-cnt = rec-cnt + 1.
      941     if rec-full = ? then do:
      942       undo, return error substitute( "Ошибка приема записи N &1", rec-cnt ) .
      943     end.
      944     assign
      945       rec-name = entry( 1, rec-full, chr(1) )
      946       .
      947     do with frame imp-pck
      948     :
      949       assign
      950       p-pck-name :screen-value = string( p-pck-name, p-pck-name :format)
      951       rec-cnt :screen-value   = string( rec-cnt, rec-cnt :format)
      952       .
      953     end.
      954     transaction_block_otherwise:
      955     do transaction
      956     on error  undo, return error substitute("&1. error transaction_block_otherwise &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      957     on endkey undo, return error substitute("&1. endkey transaction_block_otherwise")
      958     on stop   undo, return error substitute("&1. stop transaction_block_otherwise")
      959     :
      960       CASE rec-name:
      961         when '**END OF PACKET**':U then do:
      962           assign
      963             rec-cnt = rec-cnt - 1
      964             OK = yes
      965             .
      966           leave beg-imp.
      967         end.
      968         when 'command':U then do:
      969           assign
      970           OK = yes
      971           .
      972         end.
      973         otherwise do:
      974           run proc-load-tt-standart in this-procedure
      975               ( input rec-name
      976               ,input this-procedure
      977               ,input sub-rec-cnt
      978               ) no-error.
      979           if error-status:error then do:
      980             return error return-value + chr(10) + "запись N" + chr(32) + string( rec-cnt ) .
      981           end.
      982         end.
      983       end case.
      984     end.
      985   end.
      986   input stream imp-stream close.
      987   hide frame imp-pck.
      988   end.
      989   end procedure.
      990   define variable rec-cnt as integer no-undo .
      991   define variable v-today    as date    no-undo .
      992   define variable v-time     as integer no-undo .
      993   define variable v-uniq-key-rt    as character no-undo .
      994   define variable tt-name         as character no-undo .
      995   define variable tth             as handle    no-undo .
      996   define variable bh_tt           as handle    no-undo .
      997   define variable v-ok            as logical   no-undo .
      998   define variable buf_h           as handle    no-undo extent 4.
      999   define variable q_h             as handle    no-undo .
     1000   define variable v-uniq-key-rec  as character no-undo .
     1001   define variable v-tbl-name      as character no-undo extent 4.
     1002   define variable v-ii            as integer   no-undo .
     1003   define variable v-inform         as character no-undo .
     1004   define variable v-idx-field-qnty as integer   no-undo .
     1005   define variable v-field-name     as character no-undo .
     1006   define variable v-field-val      as character no-undo .
     1007   define variable v-word-link      as character no-undo .
     1008   define variable v-where          as character no-undo .
     1009   define variable fh_tbl-name      as handle    no-undo .
     1010   define variable fh_tt           as handle    no-undo .
     1011   define variable v-to-export as logical no-undo .
     1012   define variable compare-log     as logical   no-undo.
     1013   define variable v-tbl-row        as rowid     no-undo .
     1014   define variable v-full-tbl-name as character no-undo .
     1015   define variable bh_tbl-name     as handle no-undo .
     1016   define variable v-ind         as integer   no-undo.
     1017   define variable ss as character no-undo .
     1018   define frame exp-pck
     1019     file-pck-name label "Файл" format "x(40)" skip
     1020     rec-cnt       label "Записей в файле"
     1021     with view-as dialog-box side-labels 1 columns three-d title "** Экспорт пакета".
     1022   if transaction then do:
     1023     message
     1024       vss-workfile vss-revision vss-description skip
     1025       substitute( "Вызов данной процедуры невозможен при наличии транзакции" )
     1026       view-as alert-box error
     1027     .
     1028     return error .
     1029   end.
     1030   if old-pck-name <> '':U then do:
     1031     run import-in-tt in this-procedure ( input old-pck-name) no-error.
     1032     if error-status:error then do :
     1033       return error substitute("Ошибка при чтении файла &1", old-pck-name).
     1034     end.
     1035   end.
     1036   rec-cnt = num-exp-rec.
     1037   do
     1038   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1039   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1040   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1041   :
     1042     view frame exp-pck.
     1043     if not p-append then
     1044     assign
     1045       err-gen-pack = 0
     1046     .
     1047     display
     1048       file-pck-name
     1049       with frame exp-pck.
     1050     if p-append then do:
     1051   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1052     output stream ddl to value( file-pck-name ) append.
     1053     if p-mode <> "full" then do:
     1054       export stream ddl substitute( "***&1***", entry(p-buffer-num,p-tbl-names)) .
     1055     end.
     1056     end.
     1057     else do:
     1058   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059     output stream ddl to value( file-pck-name )  .
     1060     if p-mode <> "full" then do:
     1061       export stream ddl substitute( "***&1***", entry(p-buffer-num,p-tbl-names)) .
     1062     end.
     1063     end.
     1064     if p-tbl-names = "fixing" then do:
     1065       input stream imp2-stream from value(p-prepare-phrase).
     1066       repeat:
     1067         import stream imp2-stream unformatted ss.
     1068         if index(ss, chr(1)) > 1 then do:
     1069           assign
     1070           rec-cnt = rec-cnt + 1
     1071           .
     1072   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1073     define variable v-entry8 as character no-undo .
     1074     v-entry8 = ss.
     1075     entry(num-entries(v-entry8, chr(1)), v-entry8, chr(1)) = string(rec-cnt) + chr(34).
     1076     put stream ddl unformatted v-entry8 skip.
     1077         end.
     1078         else do:
     1079   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080     put stream ddl unformatted ss skip.
     1081         end.
     1082         if rec-cnt modulo 100 = 0 then do:
     1083           display
     1084           rec-cnt
     1085           file-pck-name
     1086           with frame exp-pck.
     1087         end.
     1088       end.
     1089       input stream imp2-stream close.
     1090     end.
     1091     else do:
     1092     assign
     1093     v-uniq-key-rt = "":U
     1094     .
     1095     create query q_h .
     1096     do v-ii = 1 to min(4, num-entries( p-tbl-names)):
     1097       v-tbl-name[v-ii] = entry(v-ii, p-tbl-names).
     1098       create buffer buf_h[v-ii] for table v-tbl-name[v-ii].
     1099     end.
     1100     if num-entries( p-tbl-names) = 1 then do:
     1101       q_h:SET-BUFFERS( buf_h[1]).
     1102     end.
     1103     if num-entries( p-tbl-names) = 2 then do:
     1104       q_h:SET-BUFFERS( buf_h[1], buf_h[2]).
     1105     end.
     1106     if num-entries( p-tbl-names) = 3 then do:
     1107       q_h:SET-BUFFERS( buf_h[1], buf_h[2], buf_h[3]).
     1108     end.
     1109     if num-entries( p-tbl-names) = 4 then do:
     1110       q_h:SET-BUFFERS( buf_h[1], buf_h[2], buf_h[3], buf_h[4]).
     1111     end.
     1112     v-ok = q_h:QUERY-PREPARE(p-prepare-phrase) no-error.
     1113     if error-status:error
     1114     or not v-ok
     1115     then do:
     1116       return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1117     end.
     1118     q_h:QUERY-OPEN.
     1119     REPEAT WITH FRAME exp-pck:
     1120       q_h:GET-NEXT().
     1121       IF q_h:QUERY-OFF-END THEN LEAVE.
     1122       run gen-key-rec In this-procedure ( input v-tbl-name[p-buffer-num]
     1123                                          ,input buf_h[p-buffer-num]
     1124                                          ,output v-uniq-key-rec).
     1125       create temp-table tth.
     1126       assign
     1127         tt-name       = "tt_":U + v-tbl-name[p-buffer-num]
     1128         tth:undo = no
     1129       .
     1130       assign
     1131         v-ok = tth:create-like( "ub.":U + v-tbl-name[p-buffer-num] ) no-error
     1132       .
     1133       if v-ok <> true then do:
     1134         return error substitute( "&1. Ошибка при создании временной таблицы &2 (1)", vss-workfile, tt-name ) .
     1135       end.
     1136       assign
     1137         v-ok = tth:temp-table-prepare( tt-name ) no-error
     1138       .
     1139       if v-ok <> true then do:
     1140         return error substitute( "&1. Ошибка при создании временной таблицы &2 (2)", vss-workfile, tt-name ) .
     1141       end.
     1142       assign
     1143         bh_tt = tth:default-buffer-handle
     1144       .
     1145       assign
     1146         v-ok = bh_tt:buffer-create no-error
     1147       .
     1148       if v-ok <> true then do:
     1149         return error substitute( "&1. Ошибка при создании буфера временной таблицы.", vss-workfile, tt-name ).
     1150       end.
     1151       assign
     1152         v-ok = bh_tt:buffer-copy ( buf_h[p-buffer-num]) no-error
     1153       .
     1154       if v-ok <> true then do:
     1155         return error substitute( "&1. buffer-copy не прошел для таблицы &2", vss-workfile, tt-name ).
     1156       end.
     1157       v-to-export = no.
     1158       find first buf_temp-tables where
     1159                 buf_temp-tables.tbl-name = v-tbl-name[p-buffer-num] no-error.
     1160       if available buf_temp-tables then do:
     1161         define variable v-tbl-name-dop as character no-undo .
     1162         define variable v-tbl-row2 as rowid no-undo .
     1163         run gen-row-keyr in this-procedure
     1164           ( input  v-uniq-key-rec
     1165           ,input ?
     1166           ,input "":U
     1167           ,input buf_temp-tables.buf-handle
     1168           ,input no-lock
     1169           ,output v-tbl-row2
     1170           ,output v-tbl-name-dop
     1171           ) no-error .
     1172         if error-status :error then do:
     1173           return error  ( substitute( "&1. Ошибка при поиске записи по уникальному ключу &2 во врем таблице.&3&4&3&5"
     1174                                         ,vss-workfile
     1175                                         ,v-uniq-key-rec
     1176                                         ,chr(10)
     1177                                         ,return-value
     1178                                         ,error-status :get-message ( error-status :num-messages )
     1179                                       )
     1180                           ).
     1181         end.
     1182         buf_temp-tables.buf-handle:find-by-rowid( v-tbl-row2, no-lock ) no-error .
     1183         if not buf_temp-tables.buf-handle:available then do:
     1184           assign
     1185             v-to-export = yes
     1186           .
     1187         end.
     1188         else do:
     1189           assign
     1190             compare-log = buf_temp-tables.buf-handle:buffer-compare( bh_tt )
     1191           .
     1192         end.
     1193         if compare-log = false then do:
     1194           assign
     1195             v-to-export = yes.
     1196           .
     1197         end.
     1198       end.
     1199       else do:
     1200         v-to-export = yes.
     1201       end.
     1202       if v-to-export then do:
     1203         assign
     1204         rec-cnt = rec-cnt + 1
     1205         .
     1206   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207     if  p-mode = "full" then do:
     1208       export stream ddl substitute( "&1&2&3&2&4", v-tbl-name[p-buffer-num], chr(1), v-uniq-key-rec, rec-cnt ) .
     1209     end.
     1210     run upg-exp in this-procedure
     1211       ( input bh_tt
     1212       ) .
     1213           if rec-cnt modulo 100 = 0 then do:
     1214             display
     1215             rec-cnt
     1216             file-pck-name
     1217             with frame exp-pck.
     1218           end.
     1219       end.
     1220       assign
     1221         v-ok = tth:clear() no-error
     1222       .
     1223       if v-ok <> true then do:
     1224         return error substitute( "&1. Ошибка при очистке временной таблицы &2", vss-workfile, tt-name ) .
     1225       end.
     1226       delete object tth no-error .
     1227       if error-status:error then do:
     1228         return error substitute( "&1. Ошибка при удалении временной таблицы для &2", vss-workfile, tt-name ).
     1229       end.
     1230     end.
     1231     assign
     1232       v-uniq-key-rt = "":U
     1233     .
     1234     do v-ii = 1 to 4:
     1235       if valid-handle(buf_h[v-ii]) then do:
     1236         delete widget buf_h[v-ii] .
     1237       end.
     1238     end.
     1239     delete widget q_h.
     1240     for each buf_temp-tables
     1241     where buf_temp-tables.tbl-name = entry(p-buffer-num,p-tbl-names)
     1242     :
     1243       create query q_h .
     1244       q_h:SET-BUFFERS( buf_temp-tables.buf-handle).
     1245       v-ok = q_h:QUERY-PREPARE(replace(p-prepare-phrase, buf_temp-tables.tbl-name, "wt-" + buf_temp-tables.tbl-name)) no-error.
     1246       if error-status:error
     1247       or not v-ok
     1248       then do:
     1249         return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1250       end.
     1251       q_h:QUERY-OPEN.
     1252       REPEAT WITH FRAME exp-pck:
     1253         q_h:GET-NEXT().
     1254         IF q_h:QUERY-OFF-END THEN LEAVE.
     1255         run gen-key-rec In this-procedure ( input buf_temp-tables.tbl-name
     1256                                           ,input buf_temp-tables.buf-handle
     1257                                           ,output v-uniq-key-rec).
     1258         run gen-row-keyr in this-procedure
     1259           ( input  v-uniq-key-rec
     1260           ,input ?
     1261           ,input "ub":U
     1262           ,input ?
     1263           ,input no-lock
     1264           ,output v-tbl-row
     1265           ,output v-tbl-name[1]
     1266           ) no-error .
     1267         if error-status :error then do:
     1268           return error  ( substitute( "&1. Ошибка при поиске записи по уникальному ключу &2.&3&4&3&5"
     1269                                         ,vss-workfile
     1270                                         ,v-uniq-key-rec
     1271                                         ,chr(10)
     1272                                         ,return-value
     1273                                         ,error-status :get-message ( error-status :num-messages )
     1274                                       )
     1275                           ).
     1276         end.
     1277         assign
     1278           v-full-tbl-name = substitute( "&1.&2":U, "ub", v-tbl-name[1] )
     1279         .
     1280         create buffer bh_tbl-name for table v-full-tbl-name .
     1281         bh_tbl-name:find-by-rowid(v-tbl-row, no-lock ) no-error .
     1282         if bh_tbl-name:available then do:
     1283         end.
     1284         else do:
     1285           assign
     1286             rec-cnt = rec-cnt + 1
     1287             .
     1288   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289     export stream ddl substitute( "command&2&1&2&3&2&4", 'delete', chr(1), v-uniq-key-rec, rec-cnt ) .
     1290             if rec-cnt modulo 100 = 0 then do:
     1291               display
     1292               rec-cnt
     1293               file-pck-name
     1294               with frame exp-pck.
     1295             end.
     1296         end.
     1297         delete object bh_tbl-name.
     1298       end.
     1299       delete widget q_h.
     1300     end.
     1301     for each buf_temp-tables:
     1302       delete object buf_temp-tables.tbl-handle.
     1303     end.
     1304     end.
     1305     if p-append then do:
     1306       if p-last then do:
     1307   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1308     export stream ddl '**END OF PACKET**':U .
     1309     output stream ddl close.
     1310       end.
     1311       else do:
     1312   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313     output stream ddl close.
     1314       end.
     1315     end.
     1316     else do:
     1317       if p-first and not p-last then do:
     1318   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1319     output stream ddl close.
     1320       end.
     1321       else do:
     1322   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1323     export stream ddl '**END OF PACKET**':U .
     1324     output stream ddl close.
     1325       end.
     1326     end.
     1327     num-exp-rec = rec-cnt.
     1328   end.
     1329   hide frame exp-pck.
