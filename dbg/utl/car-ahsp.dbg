     1494   procedure partslib-update-by-factord :
     1495     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1496     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1497     define input parameter p-artic              like ub.parts.artic     no-undo .
     1498     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1499     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1500     define input parameter p-start-fact-order   as decimal   no-undo .
     1501     define input parameter p-end-fact-order     as decimal   no-undo .
     1502     define input parameter p-lock-gds-obj       as logical   no-undo .
     1503     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1504     define buffer buf_gds-obj  for ub.gds-obj .
     1505     define buffer buf_doc-line for ub.doc-line .
     1506     define variable v-total-parts-qnty as decimal   no-undo .
     1507     define variable v-goods-gds-goods  as logical   no-undo .
     1508     define variable v-goods-twounit    as logical   no-undo .
     1509     do
     1510     on error undo, return error
     1511     :
     1512       if p-start-fact-order > p-end-fact-order
     1513       then do:
     1514         message
     1515           vss-workfile vss-revision vss-description skip
     1516           vss-include-info6 skip
     1517           "Ошибка задания входных параметров" skip
     1518           "Начало интервала превышает конец интервала" skip
     1519           "Объект" p-obj-type p-obj-code skip
     1520           "Артикул" p-artic p-prod-type p-prod-code skip
     1521           "p-start-fact-order" p-start-fact-order skip
     1522           "p-end-fact-order"   p-end-fact-order skip
     1523           view-as alert-box error .
     1524         undo, return error .
     1525       end.
     1526       if p-lock-gds-obj = true
     1527       then do:
     1528         do transaction
     1529         on error undo, return error
     1530         :
     1531   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1533     (input  p-obj-type
     1534     ,input  p-obj-code
     1535     ,input  p-artic
     1536     ,input  p-prod-type
     1537     ,input  p-prod-code
     1538     ,buffer buf_gds-obj
     1539     ) no-error .
     1540           if error-status :error
     1541           then do:
     1542             message
     1543               vss-workfile vss-revision vss-description skip
     1544               vss-include-info6 skip
     1545               "Невозможно найти gds-obj" skip
     1546               error-status :get-message(1) skip
     1547               return-value skip
     1548               view-as alert-box error .
     1549             undo, return error .
     1550           end.
     1551           find current buf_gds-obj exclusive-lock .
     1552         end.
     1553       end.
     1554   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1556     (input  p-artic
     1557     ,input  p-prod-type
     1558     ,input  p-prod-code
     1559     ,input  'gds-goods=request':u
     1560     ,output v-goods-gds-goods
     1561     ) no-error .
     1562       if error-status :error
     1563       then do:
     1564         message
     1565           vss-workfile vss-revision vss-description skip
     1566           vss-include-info6 skip
     1567           "Ошибка при определении атрибута товара" skip
     1568           "Артикул" p-artic p-prod-type p-prod-code skip
     1569           "gds-goods=request" skip
     1570           error-status :get-message(1) skip
     1571           return-value skip
     1572           view-as alert-box error .
     1573         undo, return error return-value .
     1574       end.
     1575   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1577     (input  p-artic
     1578     ,input  p-prod-type
     1579     ,input  p-prod-code
     1580     ,input  'twounit=request':u
     1581     ,output v-goods-twounit
     1582     ) no-error .
     1583       if error-status :error
     1584       then do:
     1585         message
     1586           vss-workfile vss-revision vss-description skip
     1587           vss-include-info6 skip
     1588           "Ошибка при определении атрибута товара" skip
     1589           "Артикул" p-artic p-prod-type p-prod-code skip
     1590           "twounit=request" skip
     1591           error-status :get-message(1) skip
     1592           return-value skip
     1593           view-as alert-box error .
     1594         undo, return error return-value .
     1595       end.
     1596       for each buf_doc-line no-lock
     1597         where buf_doc-line.obj-type   = p-obj-type
     1598           and buf_doc-line.obj-code   = p-obj-code
     1599           and buf_doc-line.artic      = p-artic
     1600           and buf_doc-line.prod-type  = p-prod-type
     1601           and buf_doc-line.prod-code  = p-prod-code
     1602           and buf_doc-line.status_    = 'факт':U
     1603           and buf_doc-line.fact-order > p-start-fact-order
     1604           and buf_doc-line.fact-order <= p-end-fact-order
     1605       on error undo, return error
     1606       :
     1607         run partslib-process-document in this-procedure
     1608           (input  buf_doc-line.doc-code
     1609           ,input  p-obj-type
     1610           ,input  p-obj-code
     1611           ,input  p-artic
     1612           ,input  p-prod-type
     1613           ,input  p-prod-code
     1614           ,input  v-goods-gds-goods
     1615           ,input  v-goods-twounit
     1616           ,output v-total-parts-qnty
     1617           ) no-error .
     1618         if error-status :error
     1619         then do:
     1620           message
     1621             vss-workfile vss-revision vss-description skip
     1622             vss-include-info6 skip
     1623             "Ошибка при вызове процедуры partslib-process-document" skip
     1624             "Документ" buf_doc-line.doc-code skip
     1625             "Объект" p-obj-type p-obj-code skip
     1626             "Артикул" p-artic p-prod-type p-prod-code skip
     1627             "p-start-fact-order" p-start-fact-order skip
     1628             "p-end-fact-order" p-end-fact-order skip
     1629             error-status :get-message(1) skip
     1630             return-value skip
     1631             view-as alert-box error .
     1632           undo, return error return-value .
     1633         end.
     1634       end.
     1635     end.
     1636   end procedure.
     1637   procedure partslib-process-document :
     1638     define input  parameter p-doc-code         as character no-undo .
     1639     define input  parameter p-obj-type         as character no-undo .
     1640     define input  parameter p-obj-code         as integer   no-undo .
     1641     define input  parameter p-artic            as character no-undo .
     1642     define input  parameter p-prod-type        as character no-undo .
     1643     define input  parameter p-prod-code        as integer   no-undo .
     1644     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1645     define input  parameter p-goods-twounit    as logical   no-undo .
     1646     define output parameter p-total-parts-qnty as decimal   no-undo .
     1647     define variable v-parts-sign as integer   no-undo .
     1648     define buffer buf_trn-doc    for ub.trn-doc .
     1649     define buffer buf_doc-line   for ub.doc-line .
     1650     define buffer buf_parts      for ub.parts .
     1651     define buffer buf_temp-parts for temp-parts .
     1652     do
     1653     on error undo, return error return-value
     1654     :
     1655       find first buf_trn-doc no-lock
     1656         where buf_trn-doc.doc-code = p-doc-code
     1657         no-error .
     1658       if not available buf_trn-doc
     1659       then do:
     1660         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1661                                      ,p-doc-code
     1662                                      ) .
     1663       end.
     1664       case buf_trn-doc.doc-type
     1665       :
     1666         when 'при':U or
     1667         when 'возврат':U or
     1668         when 'инв':U
     1669         then do:
     1670           assign
     1671             v-parts-sign = -1
     1672           .
     1673         end.
     1674         when 'рас':U or
     1675         when 'спи':U
     1676         then do:
     1677           assign
     1678             v-parts-sign = 1
     1679           .
     1680         end.
     1681         otherwise do:
     1682           undo, return error substitute("Неизвестный тип документа &1"
     1683                                       ,buf_trn-doc.doc-type
     1684                                       ) .
     1685         end.
     1686       end.
     1687       find first buf_doc-line no-lock
     1688         where buf_doc-line.doc-code  = p-doc-code
     1689           and buf_doc-line.artic     = p-artic
     1690           and buf_doc-line.prod-type = p-prod-type
     1691           and buf_doc-line.prod-code = p-prod-code
     1692         no-error .
     1693       if not available buf_doc-line
     1694       then do:
     1695         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1696                                      ,p-doc-code
     1697                                      ,artic
     1698                                      ,prod-type
     1699                                      ,prod-code
     1700                                      ) .
     1701       end.
     1702       assign
     1703         p-total-parts-qnty = 0
     1704       .
     1705       if p-goods-gds-goods = true
     1706       then do:
     1707         for each buf_parts no-lock
     1708           where buf_parts.out-code  = p-doc-code
     1709             and buf_parts.obj-type  = p-obj-type
     1710             and buf_parts.obj-code  = p-obj-code
     1711             and buf_parts.artic     = p-artic
     1712             and buf_parts.prod-type = p-prod-type
     1713             and buf_parts.prod-code = p-prod-code
     1714         on error undo, return error
     1715         :
     1716           run partslib-create-temp-parts in this-procedure
     1717             (buffer buf_parts
     1718             ,buffer buf_temp-parts
     1719             ,input  p-goods-twounit
     1720             ) .
     1721           assign
     1722             p-total-parts-qnty        = p-total-parts-qnty
     1723                                       + v-parts-sign * buf_parts.fact-qnty
     1724             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1725                                       + v-parts-sign * buf_parts.fact-qnty
     1726             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1727                                       + v-parts-sign * buf_parts.fact-qnty
     1728             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1729                                       + v-parts-sign * buf_parts.cli-qnty
     1730           .
     1731           if buf_temp-parts.qnty = 0
     1732           then do:
     1733             delete buf_temp-parts .
     1734           end.
     1735         end.
     1736       end.
     1737       else do:
     1738         assign
     1739           p-total-parts-qnty = p-total-parts-qnty
     1740                              + v-parts-sign * buf_doc-line.fact-qnty
     1741         .
     1742       end.
     1743     end.
     1744   end procedure.
     1745   procedure partslib-init-temp-parts-by-date :
     1746     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1747     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1748     define input parameter p-artic           like ub.parts.artic     no-undo .
     1749     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1750     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1751     define input parameter p-fact-date       as date      no-undo .
     1752     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1753     do
     1754     on error undo, return error
     1755     :
     1756       define variable v-fact-order                as decimal   no-undo .
     1757       define variable v-shift-end-fact-order      as decimal   no-undo .
     1758       define variable v-day-end-fact-order        as decimal   no-undo .
     1759       run factord in this-procedure
     1760         (input  p-fact-date
     1761         ,input  1
     1762         ,input  1
     1763         ,input  ?
     1764         ,input  0
     1765         ,input  false
     1766         ,output v-fact-order
     1767         ,output v-shift-end-fact-order
     1768         ,output v-day-end-fact-order
     1769         ) no-error .
     1770       if error-status :error
     1771       then do:
     1772         message
     1773           vss-workfile vss-revision vss-description skip
     1774           vss-include-info6 skip
     1775           "Ошибка при определении момента времени, на который требуется остаток" skip
     1776           "Объект" p-obj-type p-obj-code skip
     1777           "Артикул" p-artic p-prod-type p-prod-code skip
     1778           "Дата" p-fact-date skip
     1779           view-as alert-box error .
     1780         undo, return error .
     1781       end.
     1782       run partslib-init-temp-parts-by-factord in this-procedure
     1783         (input p-obj-type
     1784         ,input p-obj-code
     1785         ,input p-artic
     1786         ,input p-prod-type
     1787         ,input p-prod-code
     1788         ,input v-day-end-fact-order
     1789         ,input false
     1790         ) no-error .
     1791       if error-status :error
     1792       then do:
     1793         message
     1794           vss-workfile vss-revision vss-description skip
     1795           vss-include-info6 skip
     1796           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1797           "Объект" p-obj-type p-obj-code skip
     1798           "Артикул" p-artic p-prod-type p-prod-code skip
     1799           "Дата" p-fact-date skip
     1800           view-as alert-box error .
     1801         undo, return error .
     1802       end.
     1803     end.
     1804   end procedure.
     1805   procedure partslib-calc-cost :
     1806     define output parameter p-fact-qnty      as decimal   no-undo .
     1807     define output parameter p-vat-pc         as decimal   no-undo .
     1808     define output parameter p-slt-pc         as decimal   no-undo .
     1809     define output parameter p-sum-base       as decimal   no-undo .
     1810     define output parameter p-sum-rubl       as decimal   no-undo .
     1811     define output parameter p-vat-base       as decimal   no-undo .
     1812     define output parameter p-vat-rubl       as decimal   no-undo .
     1813     define output parameter p-slt-base       as decimal   no-undo .
     1814     define output parameter p-slt-rubl       as decimal   no-undo .
     1815     define output parameter p-road-tax-base  as decimal   no-undo .
     1816     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1817     define output parameter p-transport-base as decimal   no-undo .
     1818     define output parameter p-transport-rubl as decimal   no-undo .
     1819     define output parameter p-other-base     as decimal   no-undo .
     1820     define output parameter p-other-rubl     as decimal   no-undo .
     1821     define output parameter p-excise-base    as decimal   no-undo .
     1822     define output parameter p-excise-rubl    as decimal   no-undo .
     1823     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1824     do
     1825     on error undo, return error return-value
     1826     :
     1827       define buffer buf_temp-parts for temp-parts .
     1828       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1829       define buffer   in-vatp-parts    for ub.parts   .
     1830       define buffer   in-vatp-doc      for ub.trn-doc .
     1831       define buffer   in-vatp-goods    for ub.goods   .
     1832       define buffer   in-vatp-sysconf  for ub.sysconf .
     1833       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1834       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1835       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1836       define variable varinvprb                  as   character              no-undo.
     1837       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1838       define variable cli-base-rate              as   decimal                no-undo.
     1839       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1840       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1841       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1842       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1843       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1844       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1845       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1846       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1847       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1848       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1849       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1850       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1851       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1852       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1853       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1854       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1855       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1856       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1857       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1858       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1859       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1860       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1861       define variable varinvatp-envd             as   character              no-undo.
     1862       define variable varinvatp-type             as   character              no-undo.
     1863       for each buf_temp-parts
     1864       on error undo, return error
     1865       :
     1866   assign
     1867     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1868     price-base-with-tax-loc = buf_temp-parts.price-base
     1869   .
     1870   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1871   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1872     (output varinvprb
     1873     )  .
     1874     if buf_temp-parts.out-code = 'free-zone':U     or
     1875        buf_temp-parts.out-code = 'out-zone':U   or
     1876        buf_temp-parts.doc-type = 'акт':U then do:
     1877       assign
     1878         in-vatp-have-vat-slt = yes.
     1879     end.
     1880     else do:
     1881       find first in-vatp_doc-attr no-lock
     1882         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1883           and in-vatp_doc-attr.attr-code = 'envd':U
     1884         no-error .
     1885       if not available in-vatp_doc-attr then do:
     1886         assign
     1887           in-vatp-have-vat-slt = yes.
     1888       end.
     1889       else do:
     1890            in-vatp-have-vat-slt = no.
     1891       end.
     1892     end.
     1893     assign
     1894      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1895      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1896     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1897              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1898     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1899             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1900             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1901             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1902             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1903             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1904             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1905       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1906     assign
     1907       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1908     assign
     1909       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1910       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1911       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1912       transport-cli-loc  = 0
     1913       other-cli-loc      = 0
     1914     .
     1915   ASSIGN
     1916             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1917       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1918   .
     1919         assign
     1920           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1921           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1922           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1923           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1924           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1925           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1926           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1927           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1928           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1929           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1930           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1931           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1932           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1933           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1934           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1935           p-excise-base    = p-excise-base    + 0
     1936           p-excise-rubl    = p-excise-rubl    + 0
     1937         .
     1938       end.
     1939       if p-fact-qnty      = ?
     1940       or p-sum-base       = ?
     1941       or p-sum-rubl       = ?
     1942       or p-vat-base       = ?
     1943       or p-vat-rubl       = ?
     1944       or p-slt-base       = ?
     1945       or p-slt-rubl       = ?
     1946       or p-road-tax-base  = ?
     1947       or p-road-tax-rubl  = ?
     1948       or p-transport-base = ?
     1949       or p-transport-rubl = ?
     1950       or p-other-base     = ?
     1951       or p-other-rubl     = ?
     1952       or p-excise-base    = ?
     1953       or p-excise-rubl    = ?
     1954       then do:
     1955         message
     1956           vss-workfile vss-revision vss-description skip
     1957           vss-include-info6 skip
     1958           "Программа in-vatp.i вернула неопределенные значения" skip
     1959           "p-fact-qnty"      p-fact-qnty      skip
     1960           "p-sum-base"       p-sum-base       skip
     1961           "p-sum-rubl"       p-sum-rubl       skip
     1962           "p-vat-base"       p-vat-base       skip
     1963           "p-vat-rubl"       p-vat-rubl       skip
     1964           "p-slt-base"       p-slt-base       skip
     1965           "p-slt-rubl"       p-slt-rubl       skip
     1966           "p-road-tax-base"  p-road-tax-base  skip
     1967           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1968           "p-transport-base" p-transport-base skip
     1969           "p-transport-rubl" p-transport-rubl skip
     1970           "p-other-base"     p-other-base     skip
     1971           "p-other-rubl"     p-other-rubl     skip
     1972           "p-excise-base"    p-excise-base    skip
     1973           "p-excise-rubl"    p-excise-rubl    skip
     1974           view-as alert-box error .
     1975         undo, return error .
     1976       end.
     1977     end.
     1978   end procedure.
     1979   define variable v-ind            as integer   no-undo .
     1980   define variable v-total-err      as integer   no-undo .
     1981   define variable v-today          as date      no-undo .
     1982   define variable v-time           as integer   no-undo .
     1983   define variable v-log-err-file   as character no-undo .
     1984   define stream sout .
     1985   define temp-table temp-date no-undo
     1986     field arch-date          as date    format '99/99/9999':u
     1987     field fact-ord-begin-day as decimal format '>>>,>>>,>>9.99':u
     1988     field fact-ord-end-day   as decimal format '>>>,>>>,>>9.99':u
     1989     field temp-date-ok       as logical
     1990     index xpk is primary unique arch-date
     1991       .
     1992   define temp-table temp-ot-supp-day no-undo
     1993     field temp-cli-type       as character
     1994     field temp-cli-code       as integer
     1995     field temp-artic          as character
     1996     field temp-prod-type      as character
     1997     field temp-prod-code      as integer
     1998     field temp-sum-type       as character
     1999     field temp-cat-id         as character
     2000     field temp-fact-qnty      as decimal
     2001     field temp-sum-base       as decimal
     2002     field temp-sum-rubl       as decimal
     2003     field temp-VAT-base       as decimal
     2004     field temp-VAT-rubl       as decimal
     2005     field temp-SLT-base       as decimal
     2006     field temp-SLT-rubl       as decimal
     2007     field temp-road-tax-base  as decimal
     2008     field temp-road-tax-rubl  as decimal
     2009     field temp-excise-base    as decimal
     2010     field temp-excise-rubl    as decimal
     2011     field temp-transport-base as decimal
     2012     field temp-transport-rubl as decimal
     2013     field temp-other-base     as decimal
     2014     field temp-other-rubl     as decimal
     2015     index xpk is primary unique
     2016       temp-cli-type
     2017       temp-cli-code
     2018       temp-artic
     2019       temp-prod-type
     2020       temp-prod-code
     2021       temp-sum-type
     2022       temp-cat-id
     2023     index xie temp-sum-type
     2024       .
     2025   define temp-table temp-stk-supp-line no-undo
     2026     field temp-artic          as character
     2027     field temp-prod-type      as character
     2028     field temp-prod-code      as integer
     2029     field temp-cli-type       as character
     2030     field temp-cli-code       as integer
     2031     field temp-fact-qnty      as decimal
     2032     field temp-fact-order     as decimal
     2033     field temp-gds-qnty       as decimal
     2034     index xpk is primary unique
     2035       temp-artic
     2036       temp-prod-type
     2037       temp-prod-code
     2038       temp-cli-type
     2039       temp-cli-code
     2040       .
     2041   define temp-table temp-gds no-undo
     2042     field temp-artic          as character
     2043     field temp-prod-type      as character
     2044     field temp-prod-code      as integer
     2045     index xpk is primary unique
     2046       temp-artic
     2047       temp-prod-type
     2048       temp-prod-code
     2049       .
     2050   do
     2051   on error undo, return error return-value
     2052   :
     2053     assign
     2054       v-log-err-file = substitute('car-ahsp-&1-&2.err':U
     2055                                  ,p-obj-type
     2056                                  ,p-obj-code
     2057                                  )
     2058       p-detail-error-file-name = v-log-err-file
     2059     .
     2060     os-delete value(v-log-err-file) .
     2061     run fill-temp-date in this-procedure .
     2062     run check-temp-date in this-procedure .
     2063     run clear-temp-date in this-procedure .
     2064     run clear-temp-ot-supp-day in this-procedure .
     2065     run validate-free-zone in this-procedure .
     2066     run clear-temp-stk-supp-line in this-procedure .
     2067     run check-fact-order in this-procedure .
     2068     run fill-temp-stk-supp-line in this-procedure .
     2069     run check-free-zone-from-stk-supp-line in this-procedure .
     2070     run check-sub-type-stk-supp-line in this-procedure .
     2071     assign
     2072       p-err-num = v-total-err
     2073     .
     2074   end.
     2075   procedure clear-temp-date :
     2076     define buffer buf_temp-date for temp-date .
     2077     do
     2078     on error undo, return error return-value
     2079     :
     2080       for each buf_temp-date
     2081       on error undo, return error return-value
     2082       :
     2083         delete buf_temp-date .
     2084       end.
     2085     end.
     2086   end procedure.
     2087   procedure fill-temp-date :
     2088     define variable v-attr-value          as character no-undo .
     2089     define variable v-attr-type           as character no-undo .
     2090     define variable v-ahsp-detail-date    as date      no-undo .
     2091     define variable v-fact-ord-begin-ahsp as decimal   no-undo .
     2092     define variable v-fact-date           as date      no-undo .
     2093     define variable v-fact-ord-begin-day  as decimal   no-undo .
     2094     define variable v-fact-ord-end-day    as decimal   no-undo .
     2095     define buffer buf_temp-date for temp-date .
     2096     define buffer buf_ot-supp-line for ub.ot-supp-line .
     2097     define buffer buf_stk-supp-line for ub.stk-supp-line .
     2098     do
     2099     on error undo, return error return-value
     2100     :
     2101       run clntattr-value in this-procedure
     2102         (input  p-obj-type
     2103         ,input  p-obj-code
     2104         ,input  'ahsp-detail':U
     2105         ,output v-attr-value
     2106         ,output v-attr-type
     2107         ) .
     2108       assign
     2109         v-ahsp-detail-date = date(v-attr-value)
     2110       .
     2111       if v-ahsp-detail-date <> ?
     2112       then do:
     2113         run day-begin-fact-order in this-procedure
     2114           (input  v-ahsp-detail-date
     2115           ,output v-fact-ord-begin-ahsp
     2116           ) .
     2117       end.
     2118       else do:
     2119         assign
     2120           v-fact-ord-begin-ahsp = 0
     2121         .
     2122       end.
     2123       find first buf_ot-supp-line no-lock
     2124         where buf_ot-supp-line.obj-type   = p-obj-type
     2125           and buf_ot-supp-line.obj-code   = p-obj-code
     2126           and buf_ot-supp-line.fact-order > v-fact-ord-begin-ahsp
     2127         use-index fact-order
     2128         no-error .
     2129       do while available buf_ot-supp-line
     2130       :
     2131         run factord-to-date in this-procedure
     2132           (input  buf_ot-supp-line.fact-order
     2133           ,output v-fact-date
     2134           ) .
     2135         run day-begin-fact-order in this-procedure
     2136           (input  v-fact-date
     2137           ,output v-fact-ord-begin-day
     2138           ) .
     2139         run factord-end-day in this-procedure
     2140           (input  v-fact-date
     2141           ,output v-fact-ord-end-day
     2142           ) .
     2143         create buf_temp-date .
     2144         assign
     2145           buf_temp-date.arch-date          = v-fact-date
     2146           buf_temp-date.fact-ord-begin-day = v-fact-ord-begin-day
     2147           buf_temp-date.fact-ord-end-day   = v-fact-ord-end-day
     2148         .
     2149         find first buf_ot-supp-line no-lock
     2150           where buf_ot-supp-line.obj-type   = p-obj-type
     2151             and buf_ot-supp-line.obj-code   = p-obj-code
     2152             and buf_ot-supp-line.fact-order > v-fact-ord-end-day
     2153           use-index fact-order
     2154           no-error .
     2155       end.
     2156       find first buf_stk-supp-line no-lock
     2157         where buf_stk-supp-line.obj-type   = p-obj-type
     2158           and buf_stk-supp-line.obj-code   = p-obj-code
     2159           and buf_stk-supp-line.fact-order > v-fact-ord-begin-ahsp
     2160         use-index fact-order
     2161         no-error .
     2162       do while available buf_stk-supp-line
     2163       :
     2164         run factord-to-date in this-procedure
     2165           (input  buf_stk-supp-line.fact-order
     2166           ,output v-fact-date
     2167           ) .
     2168         run day-begin-fact-order in this-procedure
     2169           (input  v-fact-date
     2170           ,output v-fact-ord-begin-day
     2171           ) .
     2172         run factord-end-day in this-procedure
     2173           (input  v-fact-date
     2174           ,output v-fact-ord-end-day
     2175           ) .
     2176         find first buf_temp-date
     2177           where buf_temp-date.arch-date = v-fact-date
     2178           no-error .
     2179         if not available buf_temp-date
     2180         then do:
     2181           create buf_temp-date .
     2182           assign
     2183             buf_temp-date.arch-date          = v-fact-date
     2184             buf_temp-date.fact-ord-begin-day = v-fact-ord-begin-day
     2185             buf_temp-date.fact-ord-end-day   = v-fact-ord-end-day
     2186           .
     2187         end.
     2188         find first buf_stk-supp-line no-lock
     2189           where buf_stk-supp-line.obj-type   = p-obj-type
     2190             and buf_stk-supp-line.obj-code   = p-obj-code
     2191             and buf_stk-supp-line.fact-order > v-fact-ord-end-day
     2192           use-index fact-order
     2193           no-error .
     2194       end.
     2195     end.
     2196   end procedure.
     2197   procedure check-temp-date :
     2198     define buffer buf_temp-date for temp-date .
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       define variable v-ahsp-detail-date as date      no-undo .
     2203       define variable v-attr-value      as character no-undo .
     2204       define variable v-attr-type       as character no-undo .
     2205       run clntattr-value in this-procedure
     2206         (input  p-obj-type
     2207         ,input  p-obj-code
     2208         ,input  'ahsp-detail':U
     2209         ,output v-attr-value
     2210         ,output v-attr-type
     2211         ) .
     2212       assign
     2213         v-ahsp-detail-date = date(v-attr-value)
     2214       .
     2215       for each buf_temp-date
     2216       on error undo, return error return-value
     2217       :
     2218         run waitfram-show in this-procedure
     2219           (input substitute("Анализ складского архива по поставщикам. Ошибок &1. Объект &2 &3. Дата &4."
     2220                           ,v-total-err
     2221                           ,p-obj-type
     2222                           ,p-obj-code
     2223                           ,string(buf_temp-date.arch-date, '99/99/9999':u)
     2224                           )
     2225           ).
     2226         run clear-temp-ot-supp-day in this-procedure .
     2227         run fill-temp-ot-supp-day in this-procedure
     2228           (input  buf_temp-date.arch-date
     2229           ,input  buf_temp-date.fact-ord-begin-day
     2230           ,input  buf_temp-date.fact-ord-end-day
     2231           ) .
     2232         run validate-ot-supp-line-stk in this-procedure
     2233           (input  buf_temp-date.arch-date
     2234           ,input  buf_temp-date.fact-ord-begin-day
     2235           ,input  buf_temp-date.fact-ord-end-day
     2236           ) .
     2237         run validate-ot-supp-line-cost-sale in this-procedure
     2238           (input  buf_temp-date.arch-date
     2239           ,input  buf_temp-date.fact-ord-begin-day
     2240           ,input  buf_temp-date.fact-ord-end-day
     2241           ,input  'cost':U
     2242           ,input  'sale':U
     2243           ) .
     2244         run validate-ot-supp-line-cost-sale in this-procedure
     2245           (input buf_temp-date.arch-date
     2246           ,input buf_temp-date.fact-ord-begin-day
     2247           ,input buf_temp-date.fact-ord-end-day
     2248           ,input 'sale':U
     2249           ,input 'cost':U
     2250           ) .
     2251         if v-ahsp-detail-date = ?
     2252         or (v-ahsp-detail-date <> ?
     2253             and buf_temp-date.arch-date >= v-ahsp-detail-date
     2254            )
     2255         then do:
     2256           run validate-stk-supp-line in this-procedure
     2257             (input buf_temp-date.arch-date
     2258             ,input buf_temp-date.fact-ord-begin-day
     2259             ,input buf_temp-date.fact-ord-end-day
     2260             ) .
     2261         end.
     2262       end.
     2263     end.
     2264   end procedure.
     2265   procedure validate-ot-supp-line-stk :
     2266     define input  parameter p-fact-date            as date      no-undo .
     2267     define input  parameter p-fact-order-begin-day as decimal   no-undo .
     2268     define input  parameter p-fact-order-end-day   as decimal   no-undo .
     2269     define variable v-fact-qnty      as decimal   no-undo .
     2270     define variable v-sum-base       as decimal   no-undo .
     2271     define variable v-sum-rubl       as decimal   no-undo .
     2272     define variable v-VAT-base       as decimal   no-undo .
     2273     define variable v-VAT-rubl       as decimal   no-undo .
     2274     define variable v-SLT-base       as decimal   no-undo .
     2275     define variable v-SLT-rubl       as decimal   no-undo .
     2276     define variable v-road-tax-base  as decimal   no-undo .
     2277     define variable v-road-tax-rubl  as decimal   no-undo .
     2278     define variable v-excise-base    as decimal   no-undo .
     2279     define variable v-excise-rubl    as decimal   no-undo .
     2280     define variable v-transport-base as decimal   no-undo .
     2281     define variable v-transport-rubl as decimal   no-undo .
     2282     define variable v-other-base     as decimal   no-undo .
     2283     define variable v-other-rubl     as decimal   no-undo .
     2284     define buffer buf_stk-supp-line    for ub.stk-supp-line .
     2285     define buffer buf_temp-ot-supp-day for temp-ot-supp-day .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       for each buf_temp-ot-supp-day
     2290       on error undo, return error return-value
     2291       :
     2292         if buf_temp-ot-supp-day.temp-sum-type begins 'cost':U
     2293         or buf_temp-ot-supp-day.temp-sum-type begins 'csdt':U
     2294         or buf_temp-ot-supp-day.temp-sum-type begins 'sadt':U
     2295         then do:
     2296           if buf_temp-ot-supp-day.temp-sum-type begins 'cost':U
     2297           then do:
     2298             find last buf_stk-supp-line no-lock
     2299               where buf_stk-supp-line.obj-type   = p-obj-type
     2300                 and buf_stk-supp-line.obj-code   = p-obj-code
     2301                 and buf_stk-supp-line.cli-type   = buf_temp-ot-supp-day.temp-cli-type
     2302                 and buf_stk-supp-line.cli-code   = buf_temp-ot-supp-day.temp-cli-code
     2303                 and buf_stk-supp-line.artic      = buf_temp-ot-supp-day.temp-artic
     2304                 and buf_stk-supp-line.prod-type  = buf_temp-ot-supp-day.temp-prod-type
     2305                 and buf_stk-supp-line.prod-code  = buf_temp-ot-supp-day.temp-prod-code
     2306                 and buf_stk-supp-line.sum-type   = 'cost':U
     2307                 and buf_stk-supp-line.cat-id     = '##':U
     2308                 and buf_stk-supp-line.fact-order < p-fact-order-begin-day
     2309                 and buf_stk-supp-line.shift-date = ?
     2310               use-index category
     2311               no-error .
     2312             if  available buf_stk-supp-line
     2313             and buf_temp-ot-supp-day.temp-sum-type <> 'cost':U
     2314             then do:
     2315               define variable v-sub-fact-order as decimal   no-undo .
     2316               assign
     2317                 v-sub-fact-order = buf_stk-supp-line.fact-order
     2318               .
     2319               find last buf_stk-supp-line no-lock
     2320                 where buf_stk-supp-line.obj-type   = p-obj-type
     2321                   and buf_stk-supp-line.obj-code   = p-obj-code
     2322                   and buf_stk-supp-line.cli-type   = buf_temp-ot-supp-day.temp-cli-type
     2323                   and buf_stk-supp-line.cli-code   = buf_temp-ot-supp-day.temp-cli-code
     2324                   and buf_stk-supp-line.artic      = buf_temp-ot-supp-day.temp-artic
     2325                   and buf_stk-supp-line.prod-type  = buf_temp-ot-supp-day.temp-prod-type
     2326                   and buf_stk-supp-line.prod-code  = buf_temp-ot-supp-day.temp-prod-code
     2327                   and buf_stk-supp-line.sum-type   = buf_temp-ot-supp-day.temp-sum-type
     2328                   and buf_stk-supp-line.cat-id     = buf_temp-ot-supp-day.temp-cat-id
     2329                   and buf_stk-supp-line.fact-order = v-sub-fact-order
     2330                   and buf_stk-supp-line.shift-date = ?
     2331                 use-index category
     2332                 no-error .
     2333             end.
     2334           end.
     2335           else do:
     2336             find last buf_stk-supp-line no-lock
     2337               where buf_stk-supp-line.obj-type   = p-obj-type
     2338                 and buf_stk-supp-line.obj-code   = p-obj-code
     2339                 and buf_stk-supp-line.cli-type   = buf_temp-ot-supp-day.temp-cli-type
     2340                 and buf_stk-supp-line.cli-code   = buf_temp-ot-supp-day.temp-cli-code
     2341                 and buf_stk-supp-line.artic      = buf_temp-ot-supp-day.temp-artic
     2342                 and buf_stk-supp-line.prod-type  = buf_temp-ot-supp-day.temp-prod-type
     2343                 and buf_stk-supp-line.prod-code  = buf_temp-ot-supp-day.temp-prod-code
     2344                 and buf_stk-supp-line.sum-type   = buf_temp-ot-supp-day.temp-sum-type
     2345                 and buf_stk-supp-line.cat-id     = buf_temp-ot-supp-day.temp-cat-id
     2346                 and buf_stk-supp-line.fact-order < p-fact-order-begin-day
     2347                 and buf_stk-supp-line.shift-date = ?
     2348               use-index category
     2349               no-error .
     2350           end.
     2351           if available buf_stk-supp-line
     2352           then do:
     2353             assign
     2354               v-fact-qnty      = - buf_stk-supp-line.fact-qnty
     2355               v-sum-base       = - buf_stk-supp-line.sum-base
     2356               v-sum-rubl       = - buf_stk-supp-line.sum-rubl
     2357               v-VAT-base       = - buf_stk-supp-line.VAT-base
     2358               v-VAT-rubl       = - buf_stk-supp-line.VAT-rubl
     2359               v-SLT-base       = - buf_stk-supp-line.SLT-base
     2360               v-SLT-rubl       = - buf_stk-supp-line.SLT-rubl
     2361               v-road-tax-base  = - buf_stk-supp-line.road-tax-base
     2362               v-road-tax-rubl  = - buf_stk-supp-line.road-tax-rubl
     2363               v-excise-base    = - buf_stk-supp-line.excise-base
     2364               v-excise-rubl    = - buf_stk-supp-line.excise-rubl
     2365               v-transport-base = - buf_stk-supp-line.transport-base
     2366               v-transport-rubl = - buf_stk-supp-line.transport-rubl
     2367               v-other-base     = - buf_stk-supp-line.other-base
     2368               v-other-rubl     = - buf_stk-supp-line.other-rubl
     2369             .
     2370           end.
     2371           else do:
     2372             assign
     2373               v-fact-qnty      = 0
     2374               v-sum-base       = 0
     2375               v-sum-rubl       = 0
     2376               v-VAT-base       = 0
     2377               v-VAT-rubl       = 0
     2378               v-SLT-base       = 0
     2379               v-SLT-rubl       = 0
     2380               v-road-tax-base  = 0
     2381               v-road-tax-rubl  = 0
     2382               v-excise-base    = 0
     2383               v-excise-rubl    = 0
     2384               v-transport-base = 0
     2385               v-transport-rubl = 0
     2386               v-other-base     = 0
     2387               v-other-rubl     = 0
     2388             .
     2389           end.
     2390           assign
     2391             v-fact-qnty      = v-fact-qnty      - buf_temp-ot-supp-day.temp-fact-qnty
     2392             v-sum-base       = v-sum-base       - buf_temp-ot-supp-day.temp-sum-base
     2393             v-sum-rubl       = v-sum-rubl       - buf_temp-ot-supp-day.temp-sum-rubl
     2394             v-VAT-base       = v-VAT-base       - buf_temp-ot-supp-day.temp-VAT-base
     2395             v-VAT-rubl       = v-VAT-rubl       - buf_temp-ot-supp-day.temp-VAT-rubl
     2396             v-SLT-base       = v-SLT-base       - buf_temp-ot-supp-day.temp-SLT-base
     2397             v-SLT-rubl       = v-SLT-rubl       - buf_temp-ot-supp-day.temp-SLT-rubl
     2398             v-road-tax-base  = v-road-tax-base  - buf_temp-ot-supp-day.temp-road-tax-base
     2399             v-road-tax-rubl  = v-road-tax-rubl  - buf_temp-ot-supp-day.temp-road-tax-rubl
     2400             v-excise-base    = v-excise-base    - buf_temp-ot-supp-day.temp-excise-base
     2401             v-excise-rubl    = v-excise-rubl    - buf_temp-ot-supp-day.temp-excise-rubl
     2402             v-transport-base = v-transport-base - buf_temp-ot-supp-day.temp-transport-base
     2403             v-transport-rubl = v-transport-rubl - buf_temp-ot-supp-day.temp-transport-rubl
     2404             v-other-base     = v-other-base     - buf_temp-ot-supp-day.temp-other-base
     2405             v-other-rubl     = v-other-rubl     - buf_temp-ot-supp-day.temp-other-rubl
     2406           .
     2407           find first buf_stk-supp-line no-lock
     2408             where buf_stk-supp-line.obj-type   = p-obj-type
     2409               and buf_stk-supp-line.obj-code   = p-obj-code
     2410               and buf_stk-supp-line.cli-type   = buf_temp-ot-supp-day.temp-cli-type
     2411               and buf_stk-supp-line.cli-code   = buf_temp-ot-supp-day.temp-cli-code
     2412               and buf_stk-supp-line.artic      = buf_temp-ot-supp-day.temp-artic
     2413               and buf_stk-supp-line.prod-type  = buf_temp-ot-supp-day.temp-prod-type
     2414               and buf_stk-supp-line.prod-code  = buf_temp-ot-supp-day.temp-prod-code
     2415               and buf_stk-supp-line.sum-type   = buf_temp-ot-supp-day.temp-sum-type
     2416               and buf_stk-supp-line.cat-id     = buf_temp-ot-supp-day.temp-cat-id
     2417               and buf_stk-supp-line.fact-order = p-fact-order-end-day
     2418             use-index category
     2419             no-error .
     2420           if available buf_stk-supp-line
     2421           then do:
     2422             assign
     2423               v-fact-qnty      = v-fact-qnty      + buf_stk-supp-line.fact-qnty
     2424               v-sum-base       = v-sum-base       + buf_stk-supp-line.sum-base
     2425               v-sum-rubl       = v-sum-rubl       + buf_stk-supp-line.sum-rubl
     2426               v-VAT-base       = v-VAT-base       + buf_stk-supp-line.VAT-base
     2427               v-VAT-rubl       = v-VAT-rubl       + buf_stk-supp-line.VAT-rubl
     2428               v-SLT-base       = v-SLT-base       + buf_stk-supp-line.SLT-base
     2429               v-SLT-rubl       = v-SLT-rubl       + buf_stk-supp-line.SLT-rubl
     2430               v-road-tax-base  = v-road-tax-base  + buf_stk-supp-line.road-tax-base
     2431               v-road-tax-rubl  = v-road-tax-rubl  + buf_stk-supp-line.road-tax-rubl
     2432               v-excise-base    = v-excise-base    + buf_stk-supp-line.excise-base
     2433               v-excise-rubl    = v-excise-rubl    + buf_stk-supp-line.excise-rubl
     2434               v-transport-base = v-transport-base + buf_stk-supp-line.transport-base
     2435               v-transport-rubl = v-transport-rubl + buf_stk-supp-line.transport-rubl
     2436               v-other-base     = v-other-base     + buf_stk-supp-line.other-base
     2437               v-other-rubl     = v-other-rubl     + buf_stk-supp-line.other-rubl
     2438             .
     2439           end.
     2440           else do:
     2441             if  buf_temp-ot-supp-day.temp-sum-type begins 'cost':U
     2442             and buf_temp-ot-supp-day.temp-sum-type <>     'cost':U
     2443             and v-fact-qnty       = 0
     2444             and v-sum-base        = 0
     2445             and v-sum-rubl        = 0
     2446             and v-VAT-base        = 0
     2447             and v-VAT-rubl        = 0
     2448             and v-SLT-base        = 0
     2449             and v-SLT-rubl        = 0
     2450             and v-road-tax-base   = 0
     2451             and v-road-tax-rubl   = 0
     2452             and v-excise-base     = 0
     2453             and v-excise-rubl     = 0
     2454             and v-transport-base  = 0
     2455             and v-transport-rubl  = 0
     2456             and v-other-base      = 0
     2457             and v-other-rubl      = 0
     2458             then do:
     2459             end.
     2460             else do:
     2461               assign
     2462                 v-total-err = v-total-err + 1
     2463               .
     2464               run cur-time in this-procedure
     2465                 (output v-today
     2466                 ,output v-time
     2467                 ) .
     2468               run update-last-date in this-procedure
     2469                 (input p-fact-date
     2470                 ) .
     2471               output stream sout to value(v-log-err-file) append .
     2472               export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     2473               export stream sout "error-01: stk-supp-line not found" .
     2474               export stream sout "obj-type"       p-obj-type                          .
     2475               export stream sout "obj-code"       p-obj-code                          .
     2476               export stream sout "fact-date"      p-fact-date                         .
     2477               export stream sout "cli-type"       buf_temp-ot-supp-day.temp-cli-type  .
     2478               export stream sout "cli-code"       buf_temp-ot-supp-day.temp-cli-code  .
     2479               export stream sout "artic"          buf_temp-ot-supp-day.temp-artic     .
     2480               export stream sout "prod-type"      buf_temp-ot-supp-day.temp-prod-type .
     2481               export stream sout "prod-code"      buf_temp-ot-supp-day.temp-prod-code .
     2482               export stream sout "sum-type"       buf_temp-ot-supp-day.temp-sum-type  .
     2483               export stream sout "cat-id"         buf_temp-ot-supp-day.temp-cat-id    .
     2484               export stream sout "fact-order"     p-fact-order-end-day                .
     2485               export stream sout "fact-qnty"      v-fact-qnty                         .
     2486               export stream sout "sum-base"       v-sum-base                          .
     2487               export stream sout "sum-rubl"       v-sum-rubl                          .
     2488               export stream sout "VAT-base"       v-VAT-base                          .
     2489               export stream sout "VAT-rubl"       v-VAT-rubl                          .
     2490               export stream sout "SLT-base"       v-SLT-base                          .
     2491               export stream sout "SLT-rubl"       v-SLT-rubl                          .
     2492               export stream sout "road-tax-base"  v-road-tax-base                     .
     2493               export stream sout "road-tax-rubl"  v-road-tax-rubl                     .
     2494               export stream sout "excise-base"    v-excise-base                       .
     2495               export stream sout "excise-rubl"    v-excise-rubl                       .
     2496               export stream sout "transport-base" v-transport-base                    .
     2497               export stream sout "transport-rubl" v-transport-rubl                    .
     2498               export stream sout "other-base"     v-other-base                        .
     2499               export stream sout "other-rubl"     v-other-rubl                        .
     2500               output stream sout close .
     2501             end.
     2502           end.
     2503           if v-fact-qnty      <> 0
     2504           or v-sum-base       <> 0
     2505           or v-sum-rubl       <> 0
     2506           or v-VAT-base       <> 0
     2507           or v-VAT-rubl       <> 0
     2508           or v-SLT-base       <> 0
     2509           or v-SLT-rubl       <> 0
     2510           or v-road-tax-base  <> 0
     2511           or v-road-tax-rubl  <> 0
     2512           or v-excise-base    <> 0
     2513           or v-excise-rubl    <> 0
     2514           or v-transport-base <> 0
     2515           or v-transport-rubl <> 0
     2516           or v-other-base     <> 0
     2517           or v-other-rubl     <> 0
     2518           then do:
     2519             assign
     2520               v-total-err = v-total-err + 1
     2521             .
     2522             run cur-time in this-procedure
     2523               (output v-today
     2524               ,output v-time
     2525               ) .
     2526             run update-last-date in this-procedure
     2527               (input p-fact-date
     2528               ) .
     2529             output stream sout to value(v-log-err-file) append .
     2530             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     2531             export stream sout "error-02: stk-supp-line different quantity" .
     2532             export stream sout "obj-type"       p-obj-type                          .
     2533             export stream sout "obj-code"       p-obj-code                          .
     2534             export stream sout "fact-date"      p-fact-date                         .
     2535             export stream sout "cli-type"       buf_temp-ot-supp-day.temp-cli-type  .
     2536             export stream sout "cli-code"       buf_temp-ot-supp-day.temp-cli-code  .
     2537             export stream sout "artic"          buf_temp-ot-supp-day.temp-artic     .
     2538             export stream sout "prod-type"      buf_temp-ot-supp-day.temp-prod-type .
     2539             export stream sout "prod-code"      buf_temp-ot-supp-day.temp-prod-code .
     2540             export stream sout "sum-type"       buf_temp-ot-supp-day.temp-sum-type  .
     2541             export stream sout "cat-id"         buf_temp-ot-supp-day.temp-cat-id    .
     2542             export stream sout "fact-order"     p-fact-order-end-day                .
     2543             export stream sout "fact-qnty"      v-fact-qnty                         .
     2544             export stream sout "sum-base"       v-sum-base                          .
     2545             export stream sout "sum-rubl"       v-sum-rubl                          .
     2546             export stream sout "VAT-base"       v-VAT-base                          .
     2547             export stream sout "VAT-rubl"       v-VAT-rubl                          .
     2548             export stream sout "SLT-base"       v-SLT-base                          .
     2549             export stream sout "SLT-rubl"       v-SLT-rubl                          .
     2550             export stream sout "road-tax-base"  v-road-tax-base                     .
     2551             export stream sout "road-tax-rubl"  v-road-tax-rubl                     .
     2552             export stream sout "excise-base"    v-excise-base                       .
     2553             export stream sout "excise-rubl"    v-excise-rubl                       .
     2554             export stream sout "transport-base" v-transport-base                    .
     2555             export stream sout "transport-rubl" v-transport-rubl                    .
     2556             export stream sout "other-base"     v-other-base                        .
     2557             export stream sout "other-rubl"     v-other-rubl                        .
     2558             output stream sout close .
     2559           end.
     2560         end.
     2561       end.
     2562     end.
     2563   end procedure.
     2564   procedure validate-ot-supp-line-cost-sale :
     2565     define input  parameter p-fact-date            as date      no-undo .
     2566     define input  parameter p-fact-order-begin-day as decimal   no-undo .
     2567     define input  parameter p-fact-order-end-day   as decimal   no-undo .
     2568     define input  parameter p-scan-sum-type        as character no-undo .
     2569     define input  parameter p-compare-sum-type     as character no-undo .
     2570     define variable v-fact-qnty      as decimal   no-undo .
     2571     define variable v-sum-base       as decimal   no-undo .
     2572     define variable v-sum-rubl       as decimal   no-undo .
     2573     define variable v-VAT-base       as decimal   no-undo .
     2574     define variable v-VAT-rubl       as decimal   no-undo .
     2575     define variable v-SLT-base       as decimal   no-undo .
     2576     define variable v-SLT-rubl       as decimal   no-undo .
     2577     define variable v-road-tax-base  as decimal   no-undo .
     2578     define variable v-road-tax-rubl  as decimal   no-undo .
     2579     define variable v-excise-base    as decimal   no-undo .
     2580     define variable v-excise-rubl    as decimal   no-undo .
     2581     define variable v-transport-base as decimal   no-undo .
     2582     define variable v-transport-rubl as decimal   no-undo .
     2583     define variable v-other-base     as decimal   no-undo .
     2584     define variable v-other-rubl     as decimal   no-undo .
     2585     define buffer buf_temp-ot-supp-day      for temp-ot-supp-day .
     2586     define buffer buf_other_temp-ot-supp-day for temp-ot-supp-day .
     2587     do
     2588     on error undo, return error return-value
     2589     :
     2590       for each buf_temp-ot-supp-day
     2591         where buf_temp-ot-supp-day.temp-sum-type = p-scan-sum-type
     2592       on error undo, return error return-value
     2593       :
     2594         find first buf_other_temp-ot-supp-day
     2595           where buf_other_temp-ot-supp-day.temp-cli-type  = buf_temp-ot-supp-day.temp-cli-type
     2596             and buf_other_temp-ot-supp-day.temp-cli-code  = buf_temp-ot-supp-day.temp-cli-code
     2597             and buf_other_temp-ot-supp-day.temp-artic     = buf_temp-ot-supp-day.temp-artic
     2598             and buf_other_temp-ot-supp-day.temp-prod-type = buf_temp-ot-supp-day.temp-prod-type
     2599             and buf_other_temp-ot-supp-day.temp-prod-code = buf_temp-ot-supp-day.temp-prod-code
     2600             and buf_other_temp-ot-supp-day.temp-sum-type  = p-compare-sum-type
     2601             and buf_other_temp-ot-supp-day.temp-cat-id    = '##':U
     2602           no-error .
     2603         if (available buf_other_temp-ot-supp-day
     2604             and buf_other_temp-ot-supp-day.temp-fact-qnty <> buf_temp-ot-supp-day.temp-fact-qnty
     2605            )
     2606         or (not available buf_other_temp-ot-supp-day
     2607             and buf_temp-ot-supp-day.temp-fact-qnty <> 0
     2608            )
     2609         then do:
     2610           assign
     2611             v-total-err = v-total-err + 1
     2612           .
     2613           run cur-time in this-procedure
     2614             (output v-today
     2615             ,output v-time
     2616             ) .
     2617           run update-last-date in this-procedure
     2618             (input p-fact-date
     2619             ) .
     2620           output stream sout to value(v-log-err-file) append .
     2621           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     2622           if available buf_other_temp-ot-supp-day
     2623           then do:
     2624             export stream sout "error-03: " + p-compare-sum-type + " record not found" .
     2625           end.
     2626           else do:
     2627             export stream sout "error-04: " + p-compare-sum-type + " record different quantity" .
     2628           end.
     2629           export stream sout "obj-type"  p-obj-type                               .
     2630           export stream sout "obj-code"  p-obj-code                               .
     2631           export stream sout "fact-date" p-fact-date                              .
     2632           export stream sout "cli-type"  buf_temp-ot-supp-day.temp-cli-type       .
     2633           export stream sout "cli-code"  buf_temp-ot-supp-day.temp-cli-code       .
     2634           export stream sout "artic"     buf_temp-ot-supp-day.temp-artic          .
     2635           export stream sout "prod-type" buf_temp-ot-supp-day.temp-prod-type      .
     2636           export stream sout "prod-code" buf_temp-ot-supp-day.temp-prod-code      .
     2637           export stream sout "sum-type"  buf_temp-ot-supp-day.temp-sum-type       .
     2638           export stream sout "cat-id"    buf_temp-ot-supp-day.temp-cat-id         .
     2639           export stream sout p-scan-sum-type + "-fact-order"     p-fact-order-end-day                     .
     2640           export stream sout p-scan-sum-type + "-fact-qnty"      buf_temp-ot-supp-day.temp-fact-qnty           .
     2641           export stream sout p-scan-sum-type + "-sum-base"       buf_temp-ot-supp-day.temp-sum-base            .
     2642           export stream sout p-scan-sum-type + "-sum-rubl"       buf_temp-ot-supp-day.temp-sum-rubl            .
     2643           export stream sout p-scan-sum-type + "-VAT-base"       buf_temp-ot-supp-day.temp-VAT-base            .
     2644           export stream sout p-scan-sum-type + "-VAT-rubl"       buf_temp-ot-supp-day.temp-VAT-rubl            .
     2645           export stream sout p-scan-sum-type + "-SLT-base"       buf_temp-ot-supp-day.temp-SLT-base            .
     2646           export stream sout p-scan-sum-type + "-SLT-rubl"       buf_temp-ot-supp-day.temp-SLT-rubl            .
     2647           export stream sout p-scan-sum-type + "-road-tax-base"  buf_temp-ot-supp-day.temp-road-tax-base       .
     2648           export stream sout p-scan-sum-type + "-road-tax-rubl"  buf_temp-ot-supp-day.temp-road-tax-rubl       .
     2649           export stream sout p-scan-sum-type + "-excise-base"    buf_temp-ot-supp-day.temp-excise-base         .
     2650           export stream sout p-scan-sum-type + "-excise-rubl"    buf_temp-ot-supp-day.temp-excise-rubl         .
     2651           export stream sout p-scan-sum-type + "-transport-base" buf_temp-ot-supp-day.temp-transport-base      .
     2652           export stream sout p-scan-sum-type + "-transport-rubl" buf_temp-ot-supp-day.temp-transport-rubl      .
     2653           export stream sout p-scan-sum-type + "-other-base"     buf_temp-ot-supp-day.temp-other-base          .
     2654           export stream sout p-scan-sum-type + "-other-rubl"     buf_temp-ot-supp-day.temp-other-rubl          .
     2655           if available buf_other_temp-ot-supp-day
     2656           then do:
     2657             export stream sout p-compare-sum-type + "-fact-qnty"      buf_other_temp-ot-supp-day.temp-fact-qnty      .
     2658             export stream sout p-compare-sum-type + "-sum-base"       buf_other_temp-ot-supp-day.temp-sum-base       .
     2659             export stream sout p-compare-sum-type + "-sum-rubl"       buf_other_temp-ot-supp-day.temp-sum-rubl       .
     2660             export stream sout p-compare-sum-type + "-VAT-base"       buf_other_temp-ot-supp-day.temp-VAT-base       .
     2661             export stream sout p-compare-sum-type + "-VAT-rubl"       buf_other_temp-ot-supp-day.temp-VAT-rubl       .
     2662             export stream sout p-compare-sum-type + "-SLT-base"       buf_other_temp-ot-supp-day.temp-SLT-base       .
     2663             export stream sout p-compare-sum-type + "-SLT-rubl"       buf_other_temp-ot-supp-day.temp-SLT-rubl       .
     2664             export stream sout p-compare-sum-type + "-road-tax-base"  buf_other_temp-ot-supp-day.temp-road-tax-base  .
     2665             export stream sout p-compare-sum-type + "-road-tax-rubl"  buf_other_temp-ot-supp-day.temp-road-tax-rubl  .
     2666             export stream sout p-compare-sum-type + "-excise-base"    buf_other_temp-ot-supp-day.temp-excise-base    .
     2667             export stream sout p-compare-sum-type + "-excise-rubl"    buf_other_temp-ot-supp-day.temp-excise-rubl    .
     2668             export stream sout p-compare-sum-type + "-transport-base" buf_other_temp-ot-supp-day.temp-transport-base .
     2669             export stream sout p-compare-sum-type + "-transport-rubl" buf_other_temp-ot-supp-day.temp-transport-rubl .
     2670             export stream sout p-compare-sum-type + "-other-base"     buf_other_temp-ot-supp-day.temp-other-base     .
     2671             export stream sout p-compare-sum-type + "-other-rubl"     buf_other_temp-ot-supp-day.temp-other-rubl     .
     2672           end.
     2673           output stream sout close .
     2674         end.
     2675       end.
     2676     end.
     2677   end procedure.
     2678   procedure clear-temp-ot-supp-day :
     2679     define buffer buf_temp-ot-supp-day for temp-ot-supp-day .
     2680     do
     2681     on error undo, return error return-value
     2682     :
     2683       for each buf_temp-ot-supp-day
     2684       on error undo, return error return-value
     2685       :
     2686         delete buf_temp-ot-supp-day .
     2687       end.
     2688     end.
     2689   end procedure.
     2690   procedure fill-temp-ot-supp-day :
     2691     define input  parameter p-fact-date            as date      no-undo .
     2692     define input  parameter p-fact-order-begin-day as decimal   no-undo .
     2693     define input  parameter p-fact-order-end-day   as decimal   no-undo .
     2694     define buffer buf_temp-ot-supp-day for temp-ot-supp-day .
     2695     define buffer buf_ot-supp-line     for ub.ot-supp-line .
     2696     do
     2697     on error undo, return error return-value
     2698     :
     2699       for each buf_ot-supp-line no-lock
     2700         where buf_ot-supp-line.obj-type   = p-obj-type
     2701           and buf_ot-supp-line.obj-code   = p-obj-code
     2702           and buf_ot-supp-line.fact-order > p-fact-order-begin-day
     2703           and buf_ot-supp-line.fact-order < p-fact-order-end-day
     2704       on error undo, return error return-value
     2705       :
     2706         find first buf_temp-ot-supp-day
     2707           where buf_temp-ot-supp-day.temp-cli-type  = buf_ot-supp-line.cli-type
     2708             and buf_temp-ot-supp-day.temp-cli-code  = buf_ot-supp-line.cli-code
     2709             and buf_temp-ot-supp-day.temp-artic     = buf_ot-supp-line.artic
     2710             and buf_temp-ot-supp-day.temp-prod-type = buf_ot-supp-line.prod-type
     2711             and buf_temp-ot-supp-day.temp-prod-code = buf_ot-supp-line.prod-code
     2712             and buf_temp-ot-supp-day.temp-sum-type  = buf_ot-supp-line.sum-type
     2713             and buf_temp-ot-supp-day.temp-cat-id    = buf_ot-supp-line.cat-id
     2714           no-error .
     2715         if not available buf_temp-ot-supp-day
     2716         then do:
     2717           create buf_temp-ot-supp-day .
     2718           assign
     2719             buf_temp-ot-supp-day.temp-cli-type  = buf_ot-supp-line.cli-type
     2720             buf_temp-ot-supp-day.temp-cli-code  = buf_ot-supp-line.cli-code
     2721             buf_temp-ot-supp-day.temp-artic     = buf_ot-supp-line.artic
     2722             buf_temp-ot-supp-day.temp-prod-type = buf_ot-supp-line.prod-type
     2723             buf_temp-ot-supp-day.temp-prod-code = buf_ot-supp-line.prod-code
     2724             buf_temp-ot-supp-day.temp-sum-type  = buf_ot-supp-line.sum-type
     2725             buf_temp-ot-supp-day.temp-cat-id    = buf_ot-supp-line.cat-id
     2726           .
     2727         end.
     2728         assign
     2729           buf_temp-ot-supp-day.temp-fact-qnty      = buf_temp-ot-supp-day.temp-fact-qnty
     2730                                                    + buf_ot-supp-line.fact-qnty
     2731           buf_temp-ot-supp-day.temp-sum-base       = buf_temp-ot-supp-day.temp-sum-base
     2732                                                    + buf_ot-supp-line.sum-base
     2733           buf_temp-ot-supp-day.temp-sum-rubl       = buf_temp-ot-supp-day.temp-sum-rubl
     2734                                                    + buf_ot-supp-line.sum-rubl
     2735           buf_temp-ot-supp-day.temp-VAT-base       = buf_temp-ot-supp-day.temp-VAT-base
     2736                                                    + buf_ot-supp-line.VAT-base
     2737           buf_temp-ot-supp-day.temp-VAT-rubl       = buf_temp-ot-supp-day.temp-VAT-rubl
     2738                                                    + buf_ot-supp-line.VAT-rubl
     2739           buf_temp-ot-supp-day.temp-SLT-base       = buf_temp-ot-supp-day.temp-SLT-base
     2740                                                    + buf_ot-supp-line.SLT-base
     2741           buf_temp-ot-supp-day.temp-SLT-rubl       = buf_temp-ot-supp-day.temp-SLT-rubl
     2742                                                    + buf_ot-supp-line.SLT-rubl
     2743           buf_temp-ot-supp-day.temp-road-tax-base  = buf_temp-ot-supp-day.temp-road-tax-base
     2744                                                    + buf_ot-supp-line.road-tax-base
     2745           buf_temp-ot-supp-day.temp-road-tax-rubl  = buf_temp-ot-supp-day.temp-road-tax-rubl
     2746                                                    + buf_ot-supp-line.road-tax-rubl
     2747           buf_temp-ot-supp-day.temp-excise-base    = buf_temp-ot-supp-day.temp-excise-base
     2748                                                    + buf_ot-supp-line.excise-base
     2749           buf_temp-ot-supp-day.temp-excise-rubl    = buf_temp-ot-supp-day.temp-excise-rubl
     2750                                                    + buf_ot-supp-line.excise-rubl
     2751           buf_temp-ot-supp-day.temp-transport-base = buf_temp-ot-supp-day.temp-transport-base
     2752                                                    + buf_ot-supp-line.transport-base
     2753           buf_temp-ot-supp-day.temp-transport-rubl = buf_temp-ot-supp-day.temp-transport-rubl
     2754                                                    + buf_ot-supp-line.transport-rubl
     2755           buf_temp-ot-supp-day.temp-other-base     = buf_temp-ot-supp-day.temp-other-base
     2756                                                    + buf_ot-supp-line.other-base
     2757           buf_temp-ot-supp-day.temp-other-rubl     = buf_temp-ot-supp-day.temp-other-rubl
     2758                                                    + buf_ot-supp-line.other-rubl
     2759         .
     2760         if buf_ot-supp-line.sum-type = 'cost':U
     2761         then do:
     2762           find first buf_temp-ot-supp-day
     2763             where buf_temp-ot-supp-day.temp-cli-type  = buf_ot-supp-line.cli-type
     2764               and buf_temp-ot-supp-day.temp-cli-code  = buf_ot-supp-line.cli-code
     2765               and buf_temp-ot-supp-day.temp-artic     = buf_ot-supp-line.artic
     2766               and buf_temp-ot-supp-day.temp-prod-type = buf_ot-supp-line.prod-type
     2767               and buf_temp-ot-supp-day.temp-prod-code = buf_ot-supp-line.prod-code
     2768               and buf_temp-ot-supp-day.temp-sum-type  = 'csdt':U + buf_ot-supp-line.ext-doc-type
     2769               and buf_temp-ot-supp-day.temp-cat-id    = '##':U
     2770             no-error .
     2771           if not available buf_temp-ot-supp-day
     2772           then do:
     2773             create buf_temp-ot-supp-day .
     2774             assign
     2775               buf_temp-ot-supp-day.temp-cli-type  = buf_ot-supp-line.cli-type
     2776               buf_temp-ot-supp-day.temp-cli-code  = buf_ot-supp-line.cli-code
     2777               buf_temp-ot-supp-day.temp-artic     = buf_ot-supp-line.artic
     2778               buf_temp-ot-supp-day.temp-prod-type = buf_ot-supp-line.prod-type
     2779               buf_temp-ot-supp-day.temp-prod-code = buf_ot-supp-line.prod-code
     2780               buf_temp-ot-supp-day.temp-sum-type  = 'csdt':U + buf_ot-supp-line.ext-doc-type
     2781               buf_temp-ot-supp-day.temp-cat-id    = '##':U
     2782             .
     2783           end.
     2784           assign
     2785             buf_temp-ot-supp-day.temp-fact-qnty      = buf_temp-ot-supp-day.temp-fact-qnty
     2786                                                      + buf_ot-supp-line.fact-qnty
     2787             buf_temp-ot-supp-day.temp-sum-base       = buf_temp-ot-supp-day.temp-sum-base
     2788                                                      + buf_ot-supp-line.sum-base
     2789             buf_temp-ot-supp-day.temp-sum-rubl       = buf_temp-ot-supp-day.temp-sum-rubl
     2790                                                      + buf_ot-supp-line.sum-rubl
     2791             buf_temp-ot-supp-day.temp-VAT-base       = buf_temp-ot-supp-day.temp-VAT-base
     2792                                                      + buf_ot-supp-line.VAT-base
     2793             buf_temp-ot-supp-day.temp-VAT-rubl       = buf_temp-ot-supp-day.temp-VAT-rubl
     2794                                                      + buf_ot-supp-line.VAT-rubl
     2795             buf_temp-ot-supp-day.temp-SLT-base       = buf_temp-ot-supp-day.temp-SLT-base
     2796                                                      + buf_ot-supp-line.SLT-base
     2797             buf_temp-ot-supp-day.temp-SLT-rubl       = buf_temp-ot-supp-day.temp-SLT-rubl
     2798                                                      + buf_ot-supp-line.SLT-rubl
     2799             buf_temp-ot-supp-day.temp-road-tax-base  = buf_temp-ot-supp-day.temp-road-tax-base
     2800                                                      + buf_ot-supp-line.road-tax-base
     2801             buf_temp-ot-supp-day.temp-road-tax-rubl  = buf_temp-ot-supp-day.temp-road-tax-rubl
     2802                                                      + buf_ot-supp-line.road-tax-rubl
     2803             buf_temp-ot-supp-day.temp-excise-base    = buf_temp-ot-supp-day.temp-excise-base
     2804                                                      + buf_ot-supp-line.excise-base
     2805             buf_temp-ot-supp-day.temp-excise-rubl    = buf_temp-ot-supp-day.temp-excise-rubl
     2806                                                      + buf_ot-supp-line.excise-rubl
     2807             buf_temp-ot-supp-day.temp-transport-base = buf_temp-ot-supp-day.temp-transport-base
     2808                                                      + buf_ot-supp-line.transport-base
     2809             buf_temp-ot-supp-day.temp-transport-rubl = buf_temp-ot-supp-day.temp-transport-rubl
     2810                                                      + buf_ot-supp-line.transport-rubl
     2811             buf_temp-ot-supp-day.temp-other-base     = buf_temp-ot-supp-day.temp-other-base
     2812                                                      + buf_ot-supp-line.other-base
     2813             buf_temp-ot-supp-day.temp-other-rubl     = buf_temp-ot-supp-day.temp-other-rubl
     2814                                                      + buf_ot-supp-line.other-rubl
     2815           .
     2816         end.
     2817         if buf_ot-supp-line.sum-type = 'sale':U
     2818         then do:
     2819           find first buf_temp-ot-supp-day
     2820             where buf_temp-ot-supp-day.temp-cli-type  = buf_ot-supp-line.cli-type
     2821               and buf_temp-ot-supp-day.temp-cli-code  = buf_ot-supp-line.cli-code
     2822               and buf_temp-ot-supp-day.temp-artic     = buf_ot-supp-line.artic
     2823               and buf_temp-ot-supp-day.temp-prod-type = buf_ot-supp-line.prod-type
     2824               and buf_temp-ot-supp-day.temp-prod-code = buf_ot-supp-line.prod-code
     2825               and buf_temp-ot-supp-day.temp-sum-type  = 'sadt':U + buf_ot-supp-line.ext-doc-type
     2826               and buf_temp-ot-supp-day.temp-cat-id    = '##':U
     2827             no-error .
     2828           if not available buf_temp-ot-supp-day
     2829           then do:
     2830             create buf_temp-ot-supp-day .
     2831             assign
     2832               buf_temp-ot-supp-day.temp-cli-type  = buf_ot-supp-line.cli-type
     2833               buf_temp-ot-supp-day.temp-cli-code  = buf_ot-supp-line.cli-code
     2834               buf_temp-ot-supp-day.temp-artic     = buf_ot-supp-line.artic
     2835               buf_temp-ot-supp-day.temp-prod-type = buf_ot-supp-line.prod-type
     2836               buf_temp-ot-supp-day.temp-prod-code = buf_ot-supp-line.prod-code
     2837               buf_temp-ot-supp-day.temp-sum-type  = 'sadt':U + buf_ot-supp-line.ext-doc-type
     2838               buf_temp-ot-supp-day.temp-cat-id    = '##':U
     2839             .
     2840           end.
     2841           assign
     2842             buf_temp-ot-supp-day.temp-fact-qnty      = buf_temp-ot-supp-day.temp-fact-qnty
     2843                                                      + buf_ot-supp-line.fact-qnty
     2844             buf_temp-ot-supp-day.temp-sum-base       = buf_temp-ot-supp-day.temp-sum-base
     2845                                                      + buf_ot-supp-line.sum-base
     2846             buf_temp-ot-supp-day.temp-sum-rubl       = buf_temp-ot-supp-day.temp-sum-rubl
     2847                                                      + buf_ot-supp-line.sum-rubl
     2848             buf_temp-ot-supp-day.temp-VAT-base       = buf_temp-ot-supp-day.temp-VAT-base
     2849                                                      + buf_ot-supp-line.VAT-base
     2850             buf_temp-ot-supp-day.temp-VAT-rubl       = buf_temp-ot-supp-day.temp-VAT-rubl
     2851                                                      + buf_ot-supp-line.VAT-rubl
     2852             buf_temp-ot-supp-day.temp-SLT-base       = buf_temp-ot-supp-day.temp-SLT-base
     2853                                                      + buf_ot-supp-line.SLT-base
     2854             buf_temp-ot-supp-day.temp-SLT-rubl       = buf_temp-ot-supp-day.temp-SLT-rubl
     2855                                                      + buf_ot-supp-line.SLT-rubl
     2856             buf_temp-ot-supp-day.temp-road-tax-base  = buf_temp-ot-supp-day.temp-road-tax-base
     2857                                                      + buf_ot-supp-line.road-tax-base
     2858             buf_temp-ot-supp-day.temp-road-tax-rubl  = buf_temp-ot-supp-day.temp-road-tax-rubl
     2859                                                      + buf_ot-supp-line.road-tax-rubl
     2860             buf_temp-ot-supp-day.temp-excise-base    = buf_temp-ot-supp-day.temp-excise-base
     2861                                                      + buf_ot-supp-line.excise-base
     2862             buf_temp-ot-supp-day.temp-excise-rubl    = buf_temp-ot-supp-day.temp-excise-rubl
     2863                                                      + buf_ot-supp-line.excise-rubl
     2864             buf_temp-ot-supp-day.temp-transport-base = buf_temp-ot-supp-day.temp-transport-base
     2865                                                      + buf_ot-supp-line.transport-base
     2866             buf_temp-ot-supp-day.temp-transport-rubl = buf_temp-ot-supp-day.temp-transport-rubl
     2867                                                      + buf_ot-supp-line.transport-rubl
     2868             buf_temp-ot-supp-day.temp-other-base     = buf_temp-ot-supp-day.temp-other-base
     2869                                                      + buf_ot-supp-line.other-base
     2870             buf_temp-ot-supp-day.temp-other-rubl     = buf_temp-ot-supp-day.temp-other-rubl
     2871                                                      + buf_ot-supp-line.other-rubl
     2872           .
     2873         end.
     2874       end.
     2875     end.
     2876   end procedure.
     2877   procedure validate-stk-supp-line :
     2878     define input  parameter p-fact-date            as date      no-undo .
     2879     define input  parameter p-fact-order-begin-day as decimal   no-undo .
     2880     define input  parameter p-fact-order-end-day   as decimal   no-undo .
     2881     define variable v-fact-qnty      as decimal   no-undo .
     2882     define variable v-sum-base       as decimal   no-undo .
     2883     define variable v-sum-rubl       as decimal   no-undo .
     2884     define variable v-VAT-base       as decimal   no-undo .
     2885     define variable v-VAT-rubl       as decimal   no-undo .
     2886     define variable v-SLT-base       as decimal   no-undo .
     2887     define variable v-SLT-rubl       as decimal   no-undo .
     2888     define variable v-road-tax-base  as decimal   no-undo .
     2889     define variable v-road-tax-rubl  as decimal   no-undo .
     2890     define variable v-excise-base    as decimal   no-undo .
     2891     define variable v-excise-rubl    as decimal   no-undo .
     2892     define variable v-transport-base as decimal   no-undo .
     2893     define variable v-transport-rubl as decimal   no-undo .
     2894     define variable v-other-base     as decimal   no-undo .
     2895     define variable v-other-rubl     as decimal   no-undo .
     2896     define buffer buf_stk-supp-line for ub.stk-supp-line .
     2897     define buffer buf_prev_stk-supp-line for ub.stk-supp-line .
     2898     define buffer buf_temp-ot-supp-day for temp-ot-supp-day .
     2899     do
     2900     on error undo, return error return-value
     2901     :
     2902       for each buf_stk-supp-line no-lock
     2903         where buf_stk-supp-line.obj-type   = p-obj-type
     2904           and buf_stk-supp-line.obj-code   = p-obj-code
     2905           and buf_stk-supp-line.fact-order = p-fact-order-end-day
     2906       on error undo, return error return-value
     2907       :
     2908         if buf_stk-supp-line.sum-type = 'cost':U
     2909         then do:
     2910           assign
     2911             v-fact-qnty      = buf_stk-supp-line.fact-qnty
     2912             v-sum-base       = buf_stk-supp-line.sum-base
     2913             v-sum-rubl       = buf_stk-supp-line.sum-rubl
     2914             v-VAT-base       = buf_stk-supp-line.VAT-base
     2915             v-VAT-rubl       = buf_stk-supp-line.VAT-rubl
     2916             v-SLT-base       = buf_stk-supp-line.SLT-base
     2917             v-SLT-rubl       = buf_stk-supp-line.SLT-rubl
     2918             v-road-tax-base  = buf_stk-supp-line.road-tax-base
     2919             v-road-tax-rubl  = buf_stk-supp-line.road-tax-rubl
     2920             v-excise-base    = buf_stk-supp-line.excise-base
     2921             v-excise-rubl    = buf_stk-supp-line.excise-rubl
     2922             v-transport-base = buf_stk-supp-line.transport-base
     2923             v-transport-rubl = buf_stk-supp-line.transport-rubl
     2924             v-other-base     = buf_stk-supp-line.other-base
     2925             v-other-rubl     = buf_stk-supp-line.other-rubl
     2926           .
     2927           find last buf_prev_stk-supp-line no-lock
     2928             where buf_prev_stk-supp-line.obj-type   = buf_stk-supp-line.obj-type
     2929               and buf_prev_stk-supp-line.obj-code   = buf_stk-supp-line.obj-code
     2930               and buf_prev_stk-supp-line.cli-type   = buf_stk-supp-line.cli-type
     2931               and buf_prev_stk-supp-line.cli-code   = buf_stk-supp-line.cli-code
     2932               and buf_prev_stk-supp-line.artic      = buf_stk-supp-line.artic
     2933               and buf_prev_stk-supp-line.prod-type  = buf_stk-supp-line.prod-type
     2934               and buf_prev_stk-supp-line.prod-code  = buf_stk-supp-line.prod-code
     2935               and buf_prev_stk-supp-line.sum-type   = 'cost':U
     2936               and buf_prev_stk-supp-line.cat-id     = '##':U
     2937               and buf_prev_stk-supp-line.fact-order < p-fact-order-begin-day
     2938               and buf_prev_stk-supp-line.shift-date = ?
     2939             use-index category
     2940             no-error .
     2941           if  available buf_prev_stk-supp-line
     2942           and buf_stk-supp-line.sum-type <> 'cost':U
     2943           then do:
     2944             define variable v-prev-fact-order as decimal   no-undo .
     2945             assign
     2946               v-prev-fact-order = buf_prev_stk-supp-line.fact-order
     2947             .
     2948             find last buf_prev_stk-supp-line no-lock
     2949               where buf_prev_stk-supp-line.obj-type   = buf_stk-supp-line.obj-type
     2950                 and buf_prev_stk-supp-line.obj-code   = buf_stk-supp-line.obj-code
     2951                 and buf_prev_stk-supp-line.cli-type   = buf_stk-supp-line.cli-type
     2952                 and buf_prev_stk-supp-line.cli-code   = buf_stk-supp-line.cli-code
     2953                 and buf_prev_stk-supp-line.artic      = buf_stk-supp-line.artic
     2954                 and buf_prev_stk-supp-line.prod-type  = buf_stk-supp-line.prod-type
     2955                 and buf_prev_stk-supp-line.prod-code  = buf_stk-supp-line.prod-code
     2956                 and buf_prev_stk-supp-line.sum-type   = buf_stk-supp-line.sum-type
     2957                 and buf_prev_stk-supp-line.cat-id     = buf_stk-supp-line.cat-id
     2958                 and buf_prev_stk-supp-line.fact-order = v-prev-fact-order
     2959                 and buf_prev_stk-supp-line.shift-date = ?
     2960               use-index category
     2961               no-error .
     2962           end.
     2963           if available buf_prev_stk-supp-line
     2964           then do:
     2965             assign
     2966               v-fact-qnty      = v-fact-qnty      - buf_prev_stk-supp-line.fact-qnty
     2967               v-sum-base       = v-sum-base       - buf_prev_stk-supp-line.sum-base
     2968               v-sum-rubl       = v-sum-rubl       - buf_prev_stk-supp-line.sum-rubl
     2969               v-VAT-base       = v-VAT-base       - buf_prev_stk-supp-line.VAT-base
     2970               v-VAT-rubl       = v-VAT-rubl       - buf_prev_stk-supp-line.VAT-rubl
     2971               v-SLT-base       = v-SLT-base       - buf_prev_stk-supp-line.SLT-base
     2972               v-SLT-rubl       = v-SLT-rubl       - buf_prev_stk-supp-line.SLT-rubl
     2973               v-road-tax-base  = v-road-tax-base  - buf_prev_stk-supp-line.road-tax-base
     2974               v-road-tax-rubl  = v-road-tax-rubl  - buf_prev_stk-supp-line.road-tax-rubl
     2975               v-excise-base    = v-excise-base    - buf_prev_stk-supp-line.excise-base
     2976               v-excise-rubl    = v-excise-rubl    - buf_prev_stk-supp-line.excise-rubl
     2977               v-transport-base = v-transport-base - buf_prev_stk-supp-line.transport-base
     2978               v-transport-rubl = v-transport-rubl - buf_prev_stk-supp-line.transport-rubl
     2979               v-other-base     = v-other-base     - buf_prev_stk-supp-line.other-base
     2980               v-other-rubl     = v-other-rubl     - buf_prev_stk-supp-line.other-rubl
     2981             .
     2982           end.
     2983           find first buf_temp-ot-supp-day
     2984             where buf_temp-ot-supp-day.temp-cli-type  = buf_stk-supp-line.cli-type
     2985               and buf_temp-ot-supp-day.temp-cli-code  = buf_stk-supp-line.cli-code
     2986               and buf_temp-ot-supp-day.temp-artic     = buf_stk-supp-line.artic
     2987               and buf_temp-ot-supp-day.temp-prod-type = buf_stk-supp-line.prod-type
     2988               and buf_temp-ot-supp-day.temp-prod-code = buf_stk-supp-line.prod-code
     2989               and buf_temp-ot-supp-day.temp-sum-type  = buf_stk-supp-line.sum-type
