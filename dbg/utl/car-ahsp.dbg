     3302           or v-excise-rubl    <> 0
     3303           or v-transport-base <> 0
     3304           or v-transport-rubl <> 0
     3305           or v-other-base     <> 0
     3306           or v-other-rubl     <> 0
     3307           then do:
     3308             assign
     3309               v-total-err = v-total-err + 1
     3310             .
     3311             run cur-time in this-procedure
     3312               (output v-today
     3313               ,output v-time
     3314               ) .
     3315             run update-last-date in this-procedure
     3316               (input buf_stk-supp-line.fact-date
     3317               ) .
     3318             output stream sout to value(v-log-err-file) append .
     3319             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3320             export stream sout "error-07: stk-supp-line record different quantity" .
     3321             export stream sout "obj-type"       buf_stk-supp-line.obj-type       .
     3322             export stream sout "obj-code"       buf_stk-supp-line.obj-code       .
     3323             export stream sout "fact-date"      buf_stk-supp-line.fact-date      .
     3324             export stream sout "cli-type"       buf_stk-supp-line.cli-type       .
     3325             export stream sout "cli-code"       buf_stk-supp-line.cli-code       .
     3326             export stream sout "artic"          buf_stk-supp-line.artic          .
     3327             export stream sout "prod-type"      buf_stk-supp-line.prod-type      .
     3328             export stream sout "prod-code"      buf_stk-supp-line.prod-code      .
     3329             export stream sout "sum-type"       buf_stk-supp-line.sum-type       .
     3330             export stream sout "cat-id"         buf_stk-supp-line.cat-id         .
     3331             export stream sout "fact-order"     buf_stk-supp-line.fact-order     .
     3332             export stream sout "fact-qnty"      buf_stk-supp-line.fact-qnty      .
     3333             export stream sout "sum-base"       buf_stk-supp-line.sum-base       .
     3334             export stream sout "sum-rubl"       buf_stk-supp-line.sum-rubl       .
     3335             export stream sout "VAT-base"       buf_stk-supp-line.VAT-base       .
     3336             export stream sout "VAT-rubl"       buf_stk-supp-line.VAT-rubl       .
     3337             export stream sout "SLT-base"       buf_stk-supp-line.SLT-base       .
     3338             export stream sout "SLT-rubl"       buf_stk-supp-line.SLT-rubl       .
     3339             export stream sout "road-tax-base"  buf_stk-supp-line.road-tax-base  .
     3340             export stream sout "road-tax-rubl"  buf_stk-supp-line.road-tax-rubl  .
     3341             export stream sout "excise-base"    buf_stk-supp-line.excise-base    .
     3342             export stream sout "excise-rubl"    buf_stk-supp-line.excise-rubl    .
     3343             export stream sout "transport-base" buf_stk-supp-line.transport-base .
     3344             export stream sout "transport-rubl" buf_stk-supp-line.transport-rubl .
     3345             export stream sout "other-base"     buf_stk-supp-line.other-base     .
     3346             export stream sout "other-rubl"     buf_stk-supp-line.other-rubl     .
     3347             output stream sout close .
     3348           end.
     3349         end.
     3350       end.
     3351     end.
     3352   end procedure.
     3353   procedure clear-temp-stk-supp-line :
     3354     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     3355     do
     3356     on error undo, return error return-value
     3357     :
     3358       for each buf_temp-stk-supp-line
     3359       on error undo, return error return-value
     3360       :
     3361         delete buf_temp-stk-supp-line .
     3362       end.
     3363     end.
     3364   end procedure.
     3365   procedure validate-free-zone :
     3366     define buffer buf_lock_gds-obj for ub.gds-obj .
     3367     define buffer buf_gds-obj for ub.gds-obj .
     3368     define buffer buf_stk-supp-line for ub.stk-supp-line .
     3369     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     3370     define buffer buf_temp-parts for temp-parts .
     3371     define variable v-ind as integer   no-undo .
     3372     do
     3373     on error undo, return error return-value
     3374     :
     3375       for each buf_gds-obj no-lock
     3376         where buf_gds-obj.obj-type = p-obj-type
     3377           and buf_gds-obj.obj-code = p-obj-code
     3378       on error undo, return error return-value
     3379       :
     3380         assign
     3381           v-ind = v-ind + 1
     3382         .
     3383         if v-ind modulo 10 = 0
     3384         then do:
     3385           run waitfram-show in this-procedure
     3386             (input substitute("Проверка остатков. Ошибок &1. Объект &2 &3. Артикул &4 &5 &6."
     3387                             ,v-total-err
     3388                             ,p-obj-type
     3389                             ,p-obj-code
     3390                             ,buf_gds-obj.artic
     3391                             ,buf_gds-obj.prod-type
     3392                             ,buf_gds-obj.prod-code
     3393                             )
     3394             ).
     3395         end.
     3396         run clear-temp-stk-supp-line in this-procedure .
     3397         do transaction
     3398         on error undo, return error return-value
     3399         :
     3400           find buf_lock_gds-obj exclusive-lock
     3401             where rowid(buf_lock_gds-obj) = rowid(buf_gds-obj)
     3402             .
     3403           run partslib-init-temp-parts in this-procedure
     3404             (input  buf_gds-obj.obj-type
     3405             ,input  buf_gds-obj.obj-code
     3406             ,input  buf_gds-obj.artic
     3407             ,input  buf_gds-obj.prod-type
     3408             ,input  buf_gds-obj.prod-code
     3409             ) .
     3410         end.
     3411         for each buf_temp-parts
     3412         on error undo, return error return-value
     3413         :
     3414           find first buf_temp-stk-supp-line
     3415             where buf_temp-stk-supp-line.temp-artic     = buf_temp-parts.artic
     3416               and buf_temp-stk-supp-line.temp-prod-type = buf_temp-parts.prod-type
     3417               and buf_temp-stk-supp-line.temp-prod-code = buf_temp-parts.prod-code
     3418               and buf_temp-stk-supp-line.temp-cli-type  = buf_temp-parts.supp-type
     3419               and buf_temp-stk-supp-line.temp-cli-code  = buf_temp-parts.supp-code
     3420             no-error .
     3421           if not available buf_temp-stk-supp-line
     3422           then do:
     3423             create buf_temp-stk-supp-line .
     3424             assign
     3425               buf_temp-stk-supp-line.temp-artic     = buf_temp-parts.artic
     3426               buf_temp-stk-supp-line.temp-prod-type = buf_temp-parts.prod-type
     3427               buf_temp-stk-supp-line.temp-prod-code = buf_temp-parts.prod-code
     3428               buf_temp-stk-supp-line.temp-cli-type  = buf_temp-parts.supp-type
     3429               buf_temp-stk-supp-line.temp-cli-code  = buf_temp-parts.supp-code
     3430             .
     3431           end.
     3432           assign
     3433             buf_temp-stk-supp-line.temp-fact-qnty = buf_temp-stk-supp-line.temp-fact-qnty
     3434                                                   + buf_temp-parts.fact-qnty
     3435           .
     3436         end.
     3437         for each buf_temp-stk-supp-line
     3438         on error undo, return error return-value
     3439         :
     3440           find last buf_stk-supp-line no-lock
     3441             where buf_stk-supp-line.obj-type   = p-obj-type
     3442               and buf_stk-supp-line.obj-code   = p-obj-code
     3443               and buf_stk-supp-line.cli-type   = buf_temp-stk-supp-line.temp-cli-type
     3444               and buf_stk-supp-line.cli-code   = buf_temp-stk-supp-line.temp-cli-code
     3445               and buf_stk-supp-line.artic      = buf_temp-stk-supp-line.temp-artic
     3446               and buf_stk-supp-line.prod-type  = buf_temp-stk-supp-line.temp-prod-type
     3447               and buf_stk-supp-line.prod-code  = buf_temp-stk-supp-line.temp-prod-code
     3448               and buf_stk-supp-line.sum-type   = 'cost':U
     3449               and buf_stk-supp-line.cat-id     = '##':U
     3450               and buf_stk-supp-line.shift-date = ?
     3451             use-index category
     3452             no-error .
     3453           if (available buf_stk-supp-line
     3454               and buf_temp-stk-supp-line.temp-fact-qnty <> buf_stk-supp-line.fact-qnty
     3455              )
     3456           or (not available buf_stk-supp-line
     3457               and buf_temp-stk-supp-line.temp-fact-qnty <> 0
     3458              )
     3459           then do:
     3460             assign
     3461               v-total-err = v-total-err + 1
     3462             .
     3463             run cur-time in this-procedure
     3464               (output v-today
     3465               ,output v-time
     3466               ) .
     3467             run update-last-date in this-procedure
     3468               (input v-today
     3469               ) .
     3470             output stream sout to value(v-log-err-file) append .
     3471             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3472             if available buf_stk-supp-line
     3473             then do:
     3474               export stream sout "error-08: gds-obj stk-supp-line different fact-qnty" .
     3475             end.
     3476             else do:
     3477               export stream sout "error-09: gds-obj stk-supp-line fact-qnty not found" .
     3478             end.
     3479             export stream sout "obj-type"  p-obj-type                            .
     3480             export stream sout "obj-code"  p-obj-code                            .
     3481             export stream sout "fact-date" v-today                               .
     3482             export stream sout "cli-type"  buf_temp-stk-supp-line.temp-cli-type  .
     3483             export stream sout "cli-code"  buf_temp-stk-supp-line.temp-cli-code  .
     3484             export stream sout "artic"     buf_temp-stk-supp-line.temp-artic     .
     3485             export stream sout "prod-type" buf_temp-stk-supp-line.temp-prod-type .
     3486             export stream sout "prod-code" buf_temp-stk-supp-line.temp-prod-code .
     3487             export stream sout "parts.fact-qnty" buf_temp-stk-supp-line.temp-fact-qnty .
     3488             if available buf_stk-supp-line
     3489             then do:
     3490               export stream sout "stk-supp-line.fact-qnty" buf_stk-supp-line.fact-qnty .
     3491             end.
     3492             output stream sout close .
     3493           end.
     3494         end.
     3495       end.
     3496     end.
     3497   end procedure.
     3498   procedure update-last-date :
     3499     define input  parameter p-update-date as date      no-undo .
     3500     do
     3501     on error undo, return error return-value
     3502     :
     3503       if p-last-date = ?
     3504       or p-last-date < p-update-date
     3505       then do:
     3506         assign
     3507           p-last-date = p-update-date
     3508         .
     3509       end.
     3510     end.
     3511   end procedure.
     3512   procedure check-fact-order :
     3513     define buffer buf_stk-supp-line for ub.stk-supp-line .
     3514     define variable v-ind as integer   no-undo .
     3515     do
     3516     on error undo, return error return-value
     3517     :
     3518       for each buf_stk-supp-line no-lock
     3519         where buf_stk-supp-line.obj-type = p-obj-type
     3520           and buf_stk-supp-line.obj-code = p-obj-code
     3521       on error undo, return error return-value
     3522       :
     3523         assign
     3524           v-ind = v-ind + 1
     3525         .
     3526         if v-ind modulo 10 = 0
     3527         then do:
     3528           run waitfram-show in this-procedure
     3529             (input substitute("Проверка 02. Ошибок &1. Объект &2 &3. Записей &4."
     3530                             ,v-total-err
     3531                             ,p-obj-type
     3532                             ,p-obj-code
     3533                             ,v-ind
     3534                             )
     3535             ).
     3536         end.
     3537         define variable v-factord-date as date      no-undo .
     3538         run factord-to-date in this-procedure
     3539           (input  buf_stk-supp-line.fact-order
     3540           ,output v-factord-date
     3541           ) .
     3542         if truncate(buf_stk-supp-line.fact-order, 2) <> buf_stk-supp-line.fact-order
     3543         then do:
     3544           assign
     3545             v-total-err = v-total-err + 1
     3546           .
     3547           run update-last-date in this-procedure
     3548             (input v-factord-date
     3549             ) .
     3550           output stream sout to value(v-log-err-file) append .
     3551           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3552           export stream sout "error-10: fact-order"                .
     3553           export stream sout "obj-type"    buf_stk-supp-line.obj-type   .
     3554           export stream sout "obj-code"    buf_stk-supp-line.obj-code   .
     3555           export stream sout "cli-type"    buf_stk-supp-line.cli-type   .
     3556           export stream sout "cli-code"    buf_stk-supp-line.cli-code   .
     3557           export stream sout "artic"       buf_stk-supp-line.artic      .
     3558           export stream sout "prod-type"   buf_stk-supp-line.prod-type  .
     3559           export stream sout "prod-code"   buf_stk-supp-line.prod-code  .
     3560           export stream sout "fact-order"  buf_stk-supp-line.fact-order .
     3561           export stream sout "sum-type"    buf_stk-supp-line.sum-type   .
     3562           export stream sout "v-factord-date" v-factord-date .
     3563           export stream sout "stk-supp-line" .
     3564           export stream sout buf_stk-supp-line .
     3565           output stream sout close .
     3566         end.
     3567       end.
     3568     end.
     3569   end procedure.
     3570   procedure fill-temp-stk-supp-line :
     3571     define buffer buf_stk-supp-line for ub.stk-supp-line .
     3572     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     3573     define buffer buf_temp-gds for temp-gds .
     3574     define variable v-ind as integer   no-undo .
     3575     do
     3576     on error undo, return error return-value
     3577     :
     3578       for each buf_stk-supp-line no-lock
     3579         where buf_stk-supp-line.obj-type = p-obj-type
     3580           and buf_stk-supp-line.obj-code = p-obj-code
     3581           and buf_stk-supp-line.sum-type = 'cost':U
     3582       on error undo, return error return-value
     3583       :
     3584         assign
     3585           v-ind = v-ind + 1
     3586         .
     3587         if v-ind modulo 10 = 0
     3588         then do:
     3589           run waitfram-show in this-procedure
     3590             (input substitute("Проверка остатков 02. Ошибок &1. Объект &2 &3. Записей &4."
     3591                             ,v-total-err
     3592                             ,p-obj-type
     3593                             ,p-obj-code
     3594                             ,v-ind
     3595                             )
     3596             ).
     3597         end.
     3598         find first buf_temp-stk-supp-line
     3599           where buf_temp-stk-supp-line.temp-artic     = buf_stk-supp-line.artic
     3600             and buf_temp-stk-supp-line.temp-prod-type = buf_stk-supp-line.prod-type
     3601             and buf_temp-stk-supp-line.temp-prod-code = buf_stk-supp-line.prod-code
     3602             and buf_temp-stk-supp-line.temp-cli-type  = buf_stk-supp-line.cli-type
     3603             and buf_temp-stk-supp-line.temp-cli-code  = buf_stk-supp-line.cli-code
     3604           no-error .
     3605         if not available buf_temp-stk-supp-line
     3606         then do:
     3607           create buf_temp-stk-supp-line .
     3608           assign
     3609             buf_temp-stk-supp-line.temp-artic      = buf_stk-supp-line.artic
     3610             buf_temp-stk-supp-line.temp-prod-type  = buf_stk-supp-line.prod-type
     3611             buf_temp-stk-supp-line.temp-prod-code  = buf_stk-supp-line.prod-code
     3612             buf_temp-stk-supp-line.temp-cli-type   = buf_stk-supp-line.cli-type
     3613             buf_temp-stk-supp-line.temp-cli-code   = buf_stk-supp-line.cli-code
     3614             buf_temp-stk-supp-line.temp-fact-qnty  = buf_stk-supp-line.fact-qnty
     3615             buf_temp-stk-supp-line.temp-fact-order = buf_stk-supp-line.fact-order
     3616           .
     3617         end.
     3618         if buf_temp-stk-supp-line.temp-fact-order < buf_stk-supp-line.fact-order
     3619         then do:
     3620           assign
     3621             buf_temp-stk-supp-line.temp-fact-qnty  = buf_stk-supp-line.fact-qnty
     3622             buf_temp-stk-supp-line.temp-fact-order = buf_stk-supp-line.fact-order
     3623           .
     3624         end.
     3625         find first buf_temp-gds
     3626           where buf_temp-gds.temp-artic      = buf_stk-supp-line.artic
     3627             and buf_temp-gds.temp-prod-type  = buf_stk-supp-line.prod-type
     3628             and buf_temp-gds.temp-prod-code  = buf_stk-supp-line.prod-code
     3629           no-error .
     3630         if not available buf_temp-gds
     3631         then do:
     3632           create buf_temp-gds .
     3633           assign
     3634             buf_temp-gds.temp-artic      = buf_stk-supp-line.artic
     3635             buf_temp-gds.temp-prod-type  = buf_stk-supp-line.prod-type
     3636             buf_temp-gds.temp-prod-code  = buf_stk-supp-line.prod-code
     3637           .
     3638         end.
     3639       end.
     3640     end.
     3641   end procedure.
     3642   procedure check-free-zone-from-stk-supp-line :
     3643     define buffer buf_lock_gds-obj for ub.gds-obj .
     3644     define buffer buf_temp-gds for temp-gds .
     3645     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     3646     define buffer buf_temp-parts for temp-parts .
     3647     define variable v-ind as integer   no-undo .
     3648     do
     3649     on error undo, return error return-value
     3650     :
     3651       for each buf_temp-gds
     3652       on error undo, return error return-value
     3653       :
     3654         assign
     3655           v-ind = v-ind + 1
     3656         .
     3657         if v-ind modulo 10 = 0
     3658         then do:
     3659           run waitfram-show in this-procedure
     3660             (input substitute("Проверка остатков 03. Ошибок &1. Объект &2 &3. Артикул &4 &5 &6."
     3661                             ,v-total-err
     3662                             ,p-obj-type
     3663                             ,p-obj-code
     3664                             ,buf_temp-gds.temp-artic
     3665                             ,buf_temp-gds.temp-prod-type
     3666                             ,buf_temp-gds.temp-prod-code
     3667                             )
     3668             ).
     3669         end.
     3670         do transaction
     3671         on error undo, return error return-value
     3672         :
     3673           find buf_lock_gds-obj exclusive-lock
     3674             where buf_lock_gds-obj.obj-type  = p-obj-type
     3675               and buf_lock_gds-obj.obj-code  = p-obj-code
     3676               and buf_lock_gds-obj.artic     = buf_temp-gds.temp-artic
     3677               and buf_lock_gds-obj.prod-type = buf_temp-gds.temp-prod-type
     3678               and buf_lock_gds-obj.prod-code = buf_temp-gds.temp-prod-code
     3679             no-error .
     3680           if not available buf_lock_gds-obj
     3681           then do:
     3682             assign
     3683               v-total-err = v-total-err + 1
     3684             .
     3685             run cur-time in this-procedure
     3686               (output v-today
     3687               ,output v-time
     3688               ) .
     3689             run update-last-date in this-procedure
     3690               (input v-today
     3691               ) .
     3692             output stream sout to value(v-log-err-file) append .
     3693             export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3694             export stream sout "error-11: gds-obj not found"           .
     3695             export stream sout "obj-type"  p-obj-type                  .
     3696             export stream sout "obj-code"  p-obj-code                  .
     3697             export stream sout "artic"     buf_temp-gds.temp-artic     .
     3698             export stream sout "prod-type" buf_temp-gds.temp-prod-type .
     3699             export stream sout "prod-code" buf_temp-gds.temp-prod-code .
     3700             output stream sout close .
     3701           end.
     3702           else do:
     3703             run partslib-init-temp-parts in this-procedure
     3704               (input  p-obj-type
     3705               ,input  p-obj-code
     3706               ,input  buf_temp-gds.temp-artic
     3707               ,input  buf_temp-gds.temp-prod-type
     3708               ,input  buf_temp-gds.temp-prod-code
     3709               ) .
     3710           end.
     3711         end.
     3712         for each buf_temp-parts
     3713         on error undo, return error return-value
     3714         :
     3715           find first buf_temp-stk-supp-line
     3716             where buf_temp-stk-supp-line.temp-artic     = buf_temp-parts.artic
     3717               and buf_temp-stk-supp-line.temp-prod-type = buf_temp-parts.prod-type
     3718               and buf_temp-stk-supp-line.temp-prod-code = buf_temp-parts.prod-code
     3719               and buf_temp-stk-supp-line.temp-cli-type  = buf_temp-parts.supp-type
     3720               and buf_temp-stk-supp-line.temp-cli-code  = buf_temp-parts.supp-code
     3721             no-error .
     3722           if not available buf_temp-stk-supp-line
     3723           then do:
     3724             create buf_temp-stk-supp-line .
     3725             assign
     3726               buf_temp-stk-supp-line.temp-artic     = buf_temp-parts.artic
     3727               buf_temp-stk-supp-line.temp-prod-type = buf_temp-parts.prod-type
     3728               buf_temp-stk-supp-line.temp-prod-code = buf_temp-parts.prod-code
     3729               buf_temp-stk-supp-line.temp-cli-type  = buf_temp-parts.supp-type
     3730               buf_temp-stk-supp-line.temp-cli-code  = buf_temp-parts.supp-code
     3731             .
     3732           end.
     3733           assign
     3734             buf_temp-stk-supp-line.temp-gds-qnty = buf_temp-stk-supp-line.temp-gds-qnty
     3735                                                   + buf_temp-parts.fact-qnty
     3736           .
     3737         end.
     3738       end.
     3739       for each buf_temp-stk-supp-line
     3740       on error undo, return error return-value
     3741       :
     3742         assign
     3743           v-ind = v-ind + 1
     3744         .
     3745         if v-ind modulo 10 = 0
     3746         then do:
     3747           run waitfram-show in this-procedure
     3748             (input substitute("Проверка остатков 04. Ошибок &1. Объект &2 &3. Записей &4."
     3749                             ,v-total-err
     3750                             ,p-obj-type
     3751                             ,p-obj-code
     3752                             ,v-ind
     3753                             )
     3754             ).
     3755         end.
     3756         if buf_temp-stk-supp-line.temp-fact-qnty <> buf_temp-stk-supp-line.temp-gds-qnty
     3757         then do:
     3758           assign
     3759             v-total-err = v-total-err + 1
     3760           .
     3761           run cur-time in this-procedure
     3762             (output v-today
     3763             ,output v-time
     3764             ) .
     3765           run update-last-date in this-procedure
     3766             (input v-today
     3767             ) .
     3768           output stream sout to value(v-log-err-file) append .
     3769           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3770           export stream sout "error-12: gds-obj stk-supp-line different fact-qnty" .
     3771           export stream sout "obj-type"  p-obj-type                            .
     3772           export stream sout "obj-code"  p-obj-code                            .
     3773           export stream sout "fact-date" v-today                               .
     3774           export stream sout "cli-type"  buf_temp-stk-supp-line.temp-cli-type  .
     3775           export stream sout "cli-code"  buf_temp-stk-supp-line.temp-cli-code  .
     3776           export stream sout "artic"     buf_temp-stk-supp-line.temp-artic     .
     3777           export stream sout "prod-type" buf_temp-stk-supp-line.temp-prod-type .
     3778           export stream sout "prod-code" buf_temp-stk-supp-line.temp-prod-code .
     3779           export stream sout "stk-supp-line.fact-qnty" buf_temp-stk-supp-line.temp-fact-qnty .
     3780           export stream sout "parts.fact-qnty" buf_temp-stk-supp-line.temp-gds-qnty .
     3781           output stream sout close .
     3782         end.
     3783       end.
     3784     end.
     3785   end procedure.
     3786   procedure check-sub-type-stk-supp-line :
     3787     define buffer buf_temp-gds for temp-gds .
     3788     define buffer buf_stk-supp-line for ub.stk-supp-line .
     3789     define buffer buf_sub_stk-supp-line for ub.stk-supp-line .
     3790     define variable v-ind            as integer   no-undo .
     3791     define variable v-fact-qnty      as decimal   no-undo .
     3792     define variable v-sum-base       as decimal   no-undo .
     3793     define variable v-sum-rubl       as decimal   no-undo .
     3794     define variable v-VAT-base       as decimal   no-undo .
     3795     define variable v-VAT-rubl       as decimal   no-undo .
     3796     define variable v-SLT-base       as decimal   no-undo .
     3797     define variable v-SLT-rubl       as decimal   no-undo .
     3798     define variable v-road-tax-base  as decimal   no-undo .
     3799     define variable v-road-tax-rubl  as decimal   no-undo .
     3800     define variable v-excise-base    as decimal   no-undo .
     3801     define variable v-excise-rubl    as decimal   no-undo .
     3802     define variable v-transport-base as decimal   no-undo .
     3803     define variable v-transport-rubl as decimal   no-undo .
     3804     define variable v-other-base     as decimal   no-undo .
     3805     define variable v-other-rubl     as decimal   no-undo .
     3806     do
     3807     on error undo, return error return-value
     3808     :
     3809       for each buf_stk-supp-line no-lock
     3810         where buf_stk-supp-line.obj-type  = p-obj-type
     3811           and buf_stk-supp-line.obj-code  = p-obj-code
     3812           and buf_stk-supp-line.sum-type  = 'cost':U
     3813       on error undo, return error return-value
     3814       :
     3815         assign
     3816           v-ind = v-ind + 1
     3817         .
     3818         if v-ind modulo 10 = 0
     3819         then do:
     3820           run waitfram-show in this-procedure
     3821             (input substitute("Проверка 05. Ошибок &1. Объект &2 &3. Артикул &4 &5 &6."
     3822                             ,v-total-err
     3823                             ,p-obj-type
     3824                             ,p-obj-code
     3825                             ,buf_stk-supp-line.artic
     3826                             ,buf_stk-supp-line.prod-type
     3827                             ,buf_stk-supp-line.prod-code
     3828                             )
     3829             ).
     3830         end.
     3831         assign
     3832           v-fact-qnty      = 0
     3833           v-sum-base       = 0
     3834           v-sum-rubl       = 0
     3835           v-VAT-base       = 0
     3836           v-VAT-rubl       = 0
     3837           v-SLT-base       = 0
     3838           v-SLT-rubl       = 0
     3839           v-road-tax-base  = 0
     3840           v-road-tax-rubl  = 0
     3841           v-excise-base    = 0
     3842           v-excise-rubl    = 0
     3843           v-transport-base = 0
     3844           v-transport-rubl = 0
     3845           v-other-base     = 0
     3846           v-other-rubl     = 0
     3847         .
     3848         for each buf_sub_stk-supp-line no-lock
     3849           where buf_sub_stk-supp-line.obj-type   = buf_stk-supp-line.obj-type
     3850             and buf_sub_stk-supp-line.obj-code   = buf_stk-supp-line.obj-code
     3851             and buf_sub_stk-supp-line.cli-type   = buf_stk-supp-line.cli-type
     3852             and buf_sub_stk-supp-line.cli-code   = buf_stk-supp-line.cli-code
     3853             and buf_sub_stk-supp-line.artic      = buf_stk-supp-line.artic
     3854             and buf_sub_stk-supp-line.prod-type  = buf_stk-supp-line.prod-type
     3855             and buf_sub_stk-supp-line.prod-code  = buf_stk-supp-line.prod-code
     3856             and buf_sub_stk-supp-line.fact-order = buf_stk-supp-line.fact-order
     3857             and buf_sub_stk-supp-line.sum-type   = 'cost':U + 'p':U
     3858         on error undo, return error return-value
     3859         :
     3860           assign
     3861             v-fact-qnty      = v-fact-qnty      + buf_sub_stk-supp-line.fact-qnty
     3862             v-sum-base       = v-sum-base       + buf_sub_stk-supp-line.sum-base
     3863             v-sum-rubl       = v-sum-rubl       + buf_sub_stk-supp-line.sum-rubl
     3864             v-VAT-base       = v-VAT-base       + buf_sub_stk-supp-line.VAT-base
     3865             v-VAT-rubl       = v-VAT-rubl       + buf_sub_stk-supp-line.VAT-rubl
     3866             v-SLT-base       = v-SLT-base       + buf_sub_stk-supp-line.SLT-base
     3867             v-SLT-rubl       = v-SLT-rubl       + buf_sub_stk-supp-line.SLT-rubl
     3868             v-road-tax-base  = v-road-tax-base  + buf_sub_stk-supp-line.road-tax-base
     3869             v-road-tax-rubl  = v-road-tax-rubl  + buf_sub_stk-supp-line.road-tax-rubl
     3870             v-excise-base    = v-excise-base    + buf_sub_stk-supp-line.excise-base
     3871             v-excise-rubl    = v-excise-rubl    + buf_sub_stk-supp-line.excise-rubl
     3872             v-transport-base = v-transport-base + buf_sub_stk-supp-line.transport-base
     3873             v-transport-rubl = v-transport-rubl + buf_sub_stk-supp-line.transport-rubl
     3874             v-other-base     = v-other-base     + buf_sub_stk-supp-line.other-base
     3875             v-other-rubl     = v-other-rubl     + buf_sub_stk-supp-line.other-rubl
     3876           .
     3877         end.
     3878         if buf_stk-supp-line.fact-qnty       <> v-fact-qnty
     3879         or buf_stk-supp-line.sum-base        <> v-sum-base
     3880         or buf_stk-supp-line.sum-rubl        <> v-sum-rubl
     3881         or buf_stk-supp-line.VAT-base        <> v-VAT-base
     3882         or buf_stk-supp-line.VAT-rubl        <> v-VAT-rubl
     3883         or buf_stk-supp-line.SLT-base        <> v-SLT-base
     3884         or buf_stk-supp-line.SLT-rubl        <> v-SLT-rubl
     3885         or buf_stk-supp-line.road-tax-base   <> v-road-tax-base
     3886         or buf_stk-supp-line.road-tax-rubl   <> v-road-tax-rubl
     3887         or buf_stk-supp-line.excise-base     <> v-excise-base
     3888         or buf_stk-supp-line.excise-rubl     <> v-excise-rubl
     3889         or buf_stk-supp-line.transport-base  <> v-transport-base
     3890         or buf_stk-supp-line.transport-rubl  <> v-transport-rubl
     3891         or buf_stk-supp-line.other-base      <> v-other-base
     3892         or buf_stk-supp-line.other-rubl      <> v-other-rubl
     3893         then do:
     3894           output stream sout to value(v-log-err-file) append .
     3895           export stream sout '***':u string(v-today, '99/99/9999':u) string(v-time, 'HH:MM:SS':u) .
     3896           export stream sout "error-13: sub_stk-supp-line different qnty"                              .
     3897           export stream sout "obj-type"            p-obj-type                                     .
     3898           export stream sout "obj-code"            p-obj-code                                     .
     3899           export stream sout "obj-type"            buf_stk-supp-line.obj-type                          .
     3900           export stream sout "obj-type"            buf_stk-supp-line.obj-type                          .
     3901           export stream sout "artic"               buf_stk-supp-line.artic                             .
     3902           export stream sout "prod-type"           buf_stk-supp-line.prod-type                         .
     3903           export stream sout "prod-code"           buf_stk-supp-line.prod-code                         .
     3904           export stream sout "fact-order"          buf_stk-supp-line.fact-order                        .
     3905           export stream sout "diff-fact-qnty"      buf_stk-supp-line.fact-qnty      - v-fact-qnty      .
     3906           export stream sout "diff-sum-base"       buf_stk-supp-line.sum-base       - v-sum-base       .
     3907           export stream sout "diff-sum-rubl"       buf_stk-supp-line.sum-rubl       - v-sum-rubl       .
     3908           export stream sout "diff-VAT-base"       buf_stk-supp-line.VAT-base       - v-VAT-base       .
     3909           export stream sout "diff-VAT-rubl"       buf_stk-supp-line.VAT-rubl       - v-VAT-rubl       .
     3910           export stream sout "diff-SLT-base"       buf_stk-supp-line.SLT-base       - v-SLT-base       .
     3911           export stream sout "diff-SLT-rubl"       buf_stk-supp-line.SLT-rubl       - v-SLT-rubl       .
     3912           export stream sout "diff-road-tax-base"  buf_stk-supp-line.road-tax-base  - v-road-tax-base  .
     3913           export stream sout "diff-road-tax-rubl"  buf_stk-supp-line.road-tax-rubl  - v-road-tax-rubl  .
     3914           export stream sout "diff-excise-base"    buf_stk-supp-line.excise-base    - v-excise-base    .
     3915           export stream sout "diff-excise-rubl"    buf_stk-supp-line.excise-rubl    - v-excise-rubl    .
     3916           export stream sout "diff-transport-base" buf_stk-supp-line.transport-base - v-transport-base .
     3917           export stream sout "diff-transport-rubl" buf_stk-supp-line.transport-rubl - v-transport-rubl .
     3918           export stream sout "diff-other-base"     buf_stk-supp-line.other-base     - v-other-base     .
     3919           export stream sout "diff-other-rubl"     buf_stk-supp-line.other-rubl     - v-other-rubl     .
     3920           export stream sout "sub-sum-type"        'cost':U + 'v':U                       .
     3921           export stream sout "fact-qnty"           buf_stk-supp-line.fact-qnty                         .
     3922           export stream sout "sum-base"            buf_stk-supp-line.sum-base                          .
     3923           export stream sout "sum-rubl"            buf_stk-supp-line.sum-rubl                          .
     3924           export stream sout "VAT-base"            buf_stk-supp-line.VAT-base                          .
     3925           export stream sout "VAT-rubl"            buf_stk-supp-line.VAT-rubl                          .
     3926           export stream sout "SLT-base"            buf_stk-supp-line.SLT-base                          .
     3927           export stream sout "SLT-rubl"            buf_stk-supp-line.SLT-rubl                          .
     3928           export stream sout "road-tax-base"       buf_stk-supp-line.road-tax-base                     .
     3929           export stream sout "road-tax-rubl"       buf_stk-supp-line.road-tax-rubl                     .
     3930           export stream sout "excise-base"         buf_stk-supp-line.excise-base                       .
     3931           export stream sout "excise-rubl"         buf_stk-supp-line.excise-rubl                       .
     3932           export stream sout "transport-base"      buf_stk-supp-line.transport-base                    .
     3933           export stream sout "transport-rubl"      buf_stk-supp-line.transport-rubl                    .
     3934           export stream sout "other-base"          buf_stk-supp-line.other-base                        .
     3935           export stream sout "other-rubl"          buf_stk-supp-line.other-rubl                        .
     3936           export stream sout "sub-fact-qnty"       v-fact-qnty                                    .
     3937           export stream sout "sub-sum-base"        v-sum-base                                     .
     3938           export stream sout "sub-sum-rubl"        v-sum-rubl                                     .
     3939           export stream sout "sub-VAT-base"        v-VAT-base                                     .
     3940           export stream sout "sub-VAT-rubl"        v-VAT-rubl                                     .
     3941           export stream sout "sub-SLT-base"        v-SLT-base                                     .
     3942           export stream sout "sub-SLT-rubl"        v-SLT-rubl                                     .
     3943           export stream sout "sub-road-tax-base"   v-road-tax-base                                .
     3944           export stream sout "sub-road-tax-rubl"   v-road-tax-rubl                                .
     3945           export stream sout "sub-excise-base"     v-excise-base                                  .
     3946           export stream sout "sub-excise-rubl"     v-excise-rubl                                  .
     3947           export stream sout "sub-transport-base"  v-transport-base                               .
     3948           export stream sout "sub-transport-rubl"  v-transport-rubl                               .
     3949           export stream sout "sub-other-base"      v-other-base                                   .
     3950           export stream sout "sub-other-rubl"      v-other-rubl                                   .
     3951           output stream sout close .
     3952         end.
     3953       end.
     3954     end.
     3955   end procedure.
