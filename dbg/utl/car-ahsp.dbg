        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type               as character no-undo .
        3   define input  parameter p-obj-code               as integer   no-undo .
        4   define output parameter p-err-num                as integer   no-undo .
        5   define output parameter p-last-date              as date      no-undo .
        6   define output parameter p-error-description      as character no-undo .
        7   define output parameter p-detail-error-file-name as character no-undo .
        8   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo initial "$Workfile: car-ahsp.p $":U .
       12   define variable vss-archive     as character no-undo initial "$Archive: utl/car-ahsp.p $":U .
       13   define variable vss-description as character no-undo initial "Программа проверки складского архива по поставщикам".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure cur-time :
       85      define output parameter p-today as date      no-undo .
       86      define output parameter p-time  as integer   no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       define variable v-date1 as date      no-undo .
       91       define variable v-date2 as date      no-undo .
       92       define variable v-time  as integer   no-undo .
       93       assign
       94         v-date1 = today
       95         v-time  = time
       96         v-date2 = today
       97       .
       98       if v-date1 <> v-date2
       99       then do:
      100         assign
      101           v-date1 = today
      102           v-time  = v-time
      103         .
      104       end.
      105       assign
      106         p-today = v-date1
      107         p-time  = v-time
      108       .
      109     end.
      110   end.
      111   function cur-time-date returns character
      112   :
      113     return string(today, '99/99/9999':U) .
      114   end.
      115   function cur-time-mjd returns decimal
      116   :
      117     define variable v-date as date      no-undo .
      118     define variable v-time as integer   no-undo .
      119     run cur-time in this-procedure
      120       (output v-date
      121       ,output v-time
      122       ) .
      123     return integer(v-date) - 2400002 + (v-time / 86400) .
      124   end.
      125   function cur-time-get-ending-index returns integer
      126   (input p-number as integer
      127   )
      128   :
      129     if p-number < 0
      130     or p-number = ?
      131     then do:
      132       return 1 .
      133     end.
      134     define variable v-rest as integer   no-undo .
      135     assign
      136       p-number = p-number modulo 100
      137     .
      138     if p-number < 20
      139     then do:
      140       assign
      141         v-rest = p-number
      142       .
      143     end.
      144     else do:
      145       assign
      146         v-rest = p-number modulo 10
      147       .
      148     end.
      149     case v-rest :
      150       when 1
      151       then do:
      152         return 2 .
      153       end.
      154       when 2 or
      155       when 3 or
      156       when 4
      157       then do:
      158         return 3 .
      159       end.
      160       otherwise do:
      161         return 1 .
      162       end.
      163     end case .
      164   end.
      165   procedure cur-time-mjd-to-date :
      166      define input  parameter i-mjd-diff as decimal no-undo.
      167      define output parameter o-Date     as date    no-undo.
      168      define output parameter o-Time     as integer no-undo.
      169      define variable v-day-number as integer   no-undo .
      170      if    i-mjd-diff < 0
      171         or i-mjd-diff = ?
      172      then do:
      173         return "?" .
      174      end.
      175      assign
      176         v-day-number = truncate(i-mjd-diff,0).
      177         o-Date = date(v-day-number + 2400002).
      178         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      179     .
      180   end.
      181   function cur-time-mjd-to-string returns character
      182   (input p-mjd-diff as decimal
      183   )
      184   :
      185     define variable v-day-number as integer   no-undo .
      186     define variable v-seconds    as integer   no-undo .
      187     define variable v-hour       as integer   no-undo .
      188     define variable v-min        as integer   no-undo .
      189     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      190     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      191     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      192     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      193     if p-mjd-diff < 0
      194     or p-mjd-diff = ?
      195     then do:
      196       return "?" .
      197     end.
      198     assign
      199       v-day-number = integer(truncate(p-mjd-diff,0))
      200       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202     if v-seconds > 86400
      203     then do:
      204       assign
      205         v-seconds = 86400 - 1
      206       .
      207     end.
      208     if v-seconds < 0
      209     then do:
      210       assign
      211         v-seconds = 0
      212       .
      213     end.
      214     assign
      215       v-hour = truncate(v-seconds / 3600, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 3600
      219     .
      220     assign
      221       v-min = truncate(v-seconds / 60, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 60
      225     .
      226     return
      227         (if v-day-number <> 0
      228           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0
      232           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      236           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      237           else ""
      238         )
      239       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      240       .
      241   end.
      242   function cur-time-string returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      251   end.
      252   function cur-time-string-sec returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      261   end.
      262   function cur-time-custom  returns character
      263   (input p-prefix as character
      264   ,input p-date-format as character
      265   ,input p-delimiter as character
      266   ,input p-time-format as character
      267   ,input p-suffix as character
      268   )
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return
      277       p-prefix
      278       + string(v-date, p-date-format)
      279       + p-delimiter
      280       + string(v-time, p-time-format)
      281       + p-suffix
      282       .
      283   end.
      284   function cur-time-print  returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-datetime returns datetime
      295   :
      296     define variable v-char as character no-undo .
      297     define variable v-datetime as datetime no-undo .
      298     v-char = cur-time-string().
      299     v-datetime = datetime(v-char).
      300     return  v-datetime.
      301   end.
      302   function cur-time-string-msec returns character
      303   :
      304     define variable v-date as datetime  no-undo .
      305     v-date = now.
      306     return string(v-date) .
      307   end.
      308   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   define variable v-waitfram-action01         as character   no-undo .
      310   define variable v-waitfram-action02         as character   no-undo .
      311   define variable v-waitfram-action03         as character   no-undo .
      312   define variable mWaitFramTextBeg            as character   no-undo.
      313   define variable mWaitFramTextEnd            as character   no-undo.
      314   define variable mWaitFramView               as logical     no-undo.
      315   define variable mWaitProcEvent              as logical     no-undo init yes.
      316   define variable mWaitFramInterval           as integer     no-undo init 1 .
      317   define variable mWaitFramStop               as logical     no-undo.
      318   define variable mWaitFramStopUser           as logical     no-undo.
      319   define variable mWaitFramStopTimeOut        as logical     no-undo.
      320   define variable mWaitFramStartProc          as datetime-tz no-undo.
      321   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      322   define button B-WaitFramStop auto-end-key
      323        label "Стоп"
      324        size 10 by 1 tooltip "Остоновить процесс".
      325   define button B-viewProcInfo
      326        label "Информация"
      327        size 15 by 1 tooltip "Информация о процесс".
      328   define frame waitfram
      329     v-waitfram-action01 format "x(72)" no-label skip
      330     v-waitfram-action02 format "x(72)" no-label skip
      331     v-waitfram-action03 format "x(72)" no-label skip
      332     B-viewProcInfo
      333     B-WaitFramStop at row 4 col 30
      334     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      335     .
      336   define new global shared variable mBatchMode as logical no-undo init ?.
      337   define variable mFramBachModHandle as handle no-undo.
      338   mFramBachModHandle = frame waitfram:handle.
      339   define variable mFameOldVis as logical no-undo.
      340   define variable mVisCUrentVin as logical no-undo.
      341   if session:batch-mode
      342   then
      343      mBatchMode = yes.
      344   if mBatchMode = ? then do:
      345     mVisCUrentVin = current-window:visible.
      346     mFameOldVis = mFramBachModHandle:visible.
      347     mFramBachModHandle:visible  = yes.
      348     mBatchMode = mFramBachModHandle:visible ne yes.
      349     mFramBachModHandle:visible = mFameOldVis.
      350     current-window:visible = mVisCUrentVin.
      351   end.
      352    if  log-manager:logfile-name ne ?
      353     then DO:
      354         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      355         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      356         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      357     end.
      358   on choose of B-WaitFramStop in frame waitfram
      359   do:
      360     mWaitFramStop = yes.
      361     mWaitFramStopUser = yes.
      362   end.
      363   function waitfram-check-timeout returns logical():
      364      define variable vtime as int64 no-undo.
      365      if mWaitFramStopTimeOut
      366      then
      367         return yes.
      368      vtime = ( now - mWaitFramStartProc ) / 1000 .
      369      if     mWaitFramTimeOut ne ?
      370         and mWaitFramTimeOut ne 0
      371         and mWaitFramTimeOut lt vtime
      372      then do:
      373         mWaitFramStopTimeOut = yes.
      374      end.
      375      return mWaitFramStopTimeOut.
      376   end.
      377   procedure waitfram-hide :
      378     if not session:batch-mode
      379     then do
      380     on error undo, return error return-value
      381     :
      382       pause 0 before-hide .
      383       if not mBatchMode then
      384         hide frame waitfram .
      385     if     not mWaitFramView
      386        and mWaitProcEvent
      387     then
      388       process events .
      389     end.
      390   end procedure.
      391   procedure waitfram-show :
      392     define input  parameter p-message as character no-undo .
      393     define variable v-left-margin as integer   no-undo .
      394     if not session:batch-mode
      395     then do
      396     on error undo, return error return-value
      397     :
      398       if length(p-message) <= 70 then do:
      399         assign
      400           v-left-margin = integer((70 - length(p-message)) / 2)
      401         .
      402         assign
      403           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      404         .
      405         assign
      406           v-waitfram-action01 = " "
      407           v-waitfram-action02 = " "
      408                                    + fill(" ", v-left-margin)
      409                                    + p-message
      410           v-waitfram-action03 = " "
      411         .
      412       end.
      413       else do:
      414         define variable vRindex1 as integer no-undo.
      415         define variable vRindex2 as integer no-undo.
      416         vRindex1 = r-index(p-message," ",70).
      417         if vRindex1 = 0
      418         then
      419            vRindex1 = 70.
      420         if length(p-message)  <= vRindex1 + 70 then do:
      421           assign
      422             v-waitfram-action01 = " "
      423             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      424             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      425           .
      426         end.
      427         else do:
      428           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      429           if vRindex2 <= vRindex1
      430           then
      431              vRindex2 = vRindex1 + 70.
      432           assign
      433             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      434             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      435             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      436           .
      437         end.
      438       end.
      439       B-viewProcInfo:visible   in frame waitfram = no.
      440       B-viewProcInfo:sensitive in frame waitfram = no.
      441       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      442       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      443       if  (   mWaitFramView
      444          or  mWaitProcEvent)
      445          and not mBatchMode
      446       then
      447          display
      448             v-waitfram-action01 skip
      449             v-waitfram-action02 skip
      450             v-waitfram-action03 skip
      451          with frame waitfram .
      452       if     mWaitFramView
      453          then do:
      454             if     mWaitFramInterval ne ?
      455                and not mBatchMode
      456             then
      457                wait-for go of frame waitfram pause mWaitFramInterval.
      458          end.
      459          else
      460             if     mWaitProcEvent
      461                and not mBatchMode
      462             then
      463                process events .
      464     end.
      465   end procedure.
      466      procedure waitfram-show-this:
      467         define input  parameter iInterval as int64 no-undo.
      468         define variable vtime as int64 no-undo.
      469         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      470         mWaitFramInterval = iInterval.
      471         run waitfram-show (substitute("&1&2 &3&4" ,
      472                                       mWaitFramTextBeg ,
      473                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      474                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      475                                       mWaitFramTextEnd
      476                                      )
      477                           ).
      478      end.
      479      procedure WaitFramRunPause:
      480         define input  parameter iInterval as dec no-undo.
      481         define variable vStart  as datetime-tz no-undo.
      482         define variable vend    as datetime-tz no-undo.
      483         define variable vint as int64 no-undo.
      484         define variable vOk as logical no-undo.
      485         vStart = now.
      486         vend   = vStart.
      487         publish "WaitFramPause" (iInterval,output vOk).
      488         vend   =  now.
      489         vint = vend - vStart.
      490         vint = iInterval - vint / 1000.
      491         if     not mWaitFramStop
      492            and (   vint > 0
      493                 or (    not vOk
      494                     and iInterval eq ?
      495                     )
      496                 )
      497         then
      498            run waitfram-show-this (iInterval).
      499         vend   =  now.
      500         vint = vend - vStart.
      501         vint = iInterval - vint / 1000.
      502         if     not mWaitFramStop
      503            and vint > 0
      504         then do:
      505            run gbl/pause.p (vint * 1000).
      506         end.
      507         if iInterval ne ?
      508         then
      509            publish "WaitFramStop".
      510         waitfram-check-timeout().
      511      end.
      512      procedure WaitFramWaitFor:
      513         define input  parameter iInterval as dec no-undo.
      514         assign
      515            mWaitFramStartProc   = now
      516            mWaitFramStopUser    = no
      517            mWaitFramStopTimeOut = no
      518         .
      519         block-wait:
      520         do while not mWaitFramStop:
      521            run WaitFramRunPause (iInterval).
      522            if  waitfram-check-timeout()
      523            then do:
      524               leave block-wait.
      525            end.
      526         end.
      527         run waitfram-hide.
      528      end.
      529   procedure waitfram-join :
      530     define input  parameter p-line-1  as character no-undo .
      531     define input  parameter p-line-2  as character no-undo .
      532     define input  parameter p-line-3  as character no-undo .
      533     define output parameter p-message as character no-undo .
      534     do
      535     on error undo, return error return-value
      536     :
      537       assign
      538         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      539                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      540                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      541       .
      542     end.
      543   end procedure.
      544   function waitfram-join-function returns character
      545     (input p-line-1 as character
      546     ,input p-line-2 as character
      547     ,input p-line-3 as character
      548     ).
      549     define variable v-message as character no-undo .
      550     run waitfram-join in this-procedure
      551       (input  p-line-1
      552       ,input  p-line-2
      553       ,input  p-line-3
      554       ,output v-message
      555       ) .
      556     return v-message .
      557   end function .
      558   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      559   procedure factord :
      560     define input  parameter p-fact-date            as date    no-undo .
      561     define input  parameter p-fact-time            as integer no-undo .
      562     define input  parameter p-fact-num             as integer no-undo .
      563     define input  parameter p-shift-date           as date    no-undo .
      564     define input  parameter p-shift-num            as integer no-undo .
      565     define input  parameter p-shift-on             as logical no-undo .
      566     define output parameter p-fact-order           as decimal no-undo .
      567     define output parameter p-shift-end-fact-order as decimal no-undo .
      568     define output parameter p-day-end-fact-order   as decimal no-undo .
      569     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      570     if p-fact-date = ?
      571     then do:
      572       return error "Не указана фактическая дата" .
      573     end.
      574     define variable v-fact-date-num as integer no-undo .
      575     assign
      576       v-fact-date-num = integer(p-fact-date)
      577     .
      578     if p-fact-num = ?
      579     or p-fact-num = 0
      580     then do:
      581       return error "Не задан p-fact-num " + string(p-fact-num) .
      582     end.
      583     if p-fact-num < 0
      584     then do:
      585       return error "Отрицательный fact-num " + string(p-fact-num) .
      586     end.
      587     if p-fact-num >= 100000000
      588     then do:
      589       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      590     end.
      591     if p-shift-on = true
      592     then do:
      593       if p-shift-date = ?
      594       then do:
      595         return error "Не задана дата смены" .
      596       end.
      597       if p-shift-num = ?
      598       or p-shift-num = 0
      599       then do:
      600         return error "Не задан номер смены" .
      601       end.
      602     end.
      603     else do:
      604       assign
      605         p-shift-date = p-fact-date
      606         p-shift-num  = 24
      607       .
      608     end.
      609     define variable v-shift-offset as integer no-undo .
      610     if p-shift-date = p-fact-date
      611     then do:
      612       assign
      613         v-shift-offset = 1
      614       .
      615     end.
      616     if p-shift-date < p-fact-date
      617     then do:
      618       assign
      619         v-shift-offset = 0
      620       .
      621     end.
      622     if p-shift-date > p-fact-date
      623     then do:
      624       message
      625         vss-workfile vss-revision vss-description skip
      626         "Неправильная дата закрытия смены" skip
      627         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      628         view-as alert-box error .
      629       undo, return error
      630         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      631           ,string(p-fact-date, '99/99/9999':U)
      632           ,string(p-shift-date, '99/99/9999':U)
      633           )
      634       .
      635     end.
      636     if p-shift-num < 1
      637     or p-shift-num > 24
      638     then do:
      639       message
      640         vss-workfile vss-revision vss-description skip
      641         "Неправильный номер смены" skip
      642         "p-shift-num" p-shift-num skip
      643         view-as alert-box error .
      644       undo, return error return-value .
      645     end.
      646     assign
      647       p-fact-order           = v-fact-date-num
      648                              + v-shift-offset * 0.5
      649                              + p-shift-num    * 0.02 - 0.01
      650                              + p-fact-num     * 0.0000000001
      651       p-shift-end-fact-order = v-fact-date-num
      652                              + v-shift-offset * 0.5
      653                              + p-shift-num    * 0.02
      654       p-day-end-fact-order   = v-fact-date-num
      655                              + 0.99
      656     .
      657     if p-fact-order           <= v-fact-date-num
      658     or p-shift-end-fact-order <= v-fact-date-num
      659     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      660     or p-shift-end-fact-order >= p-day-end-fact-order
      661     then do:
      662       message
      663         vss-workfile vss-revision vss-description skip
      664         "Внутренняя ошибка при генерации фактического номера" skip
      665         "p-fact-date"            p-fact-date            skip
      666         "p-fact-time"            p-fact-time            skip
      667         "p-fact-num"             p-fact-num             skip
      668         "p-shift-date"           p-shift-date           skip
      669         "p-shift-num"            p-shift-num            skip
      670         "p-shift-on"             p-shift-on             skip
      671         "p-shift-end-fact-order" p-shift-end-fact-order skip
      672         "p-day-end-fact-order"   p-day-end-fact-order   skip
      673         "v-fact-date-num"        v-fact-date-num        skip
      674         view-as alert-box error .
      675       undo, return error return-value .
      676     end.
      677   end procedure.
      678   procedure day-begin-fact-order :
      679     define input  parameter p-fact-date            as date    no-undo .
      680     define output parameter p-day-begin-fact-order as decimal no-undo .
      681     do
      682     on error undo, return error return-value
      683     :
      684       if p-fact-date = ?
      685       then do:
      686         assign
      687           p-day-begin-fact-order = 0
      688         .
      689       end.
      690       else do:
      691         assign
      692           p-day-begin-fact-order = integer(p-fact-date)
      693         .
      694       end.
      695     end.
      696   end procedure.
      697   procedure factord-max-fact-order :
      698     define output parameter p-max-fact-order as decimal   no-undo .
      699     do
      700     on error undo, return error return-value
      701     :
      702       run day-begin-fact-order in this-procedure
      703         (input  date(1, 1, 5000)
      704         ,output p-max-fact-order
      705         ) .
      706     end.
      707   end procedure.
      708   procedure factord-cut-archive :
      709     define input  parameter p-obj-type             as character no-undo .
      710     define input  parameter p-obj-code             as integer   no-undo .
      711     define input  parameter p-fact-date            as date      no-undo .
      712     define output parameter p-shift-on             as logical   no-undo .
      713     define output parameter p-shift-date           as date      no-undo .
      714     define output parameter p-shift-num            as integer   no-undo .
      715     define output parameter p-day-end-fact-order   as decimal   no-undo .
      716     define output parameter p-shift-end-fact-order as decimal   no-undo .
      717     define variable v-fact-order as decimal   no-undo .
      718     define buffer buf_shift-obj for ub.shift-obj .
      719     do
      720     on error undo, return error return-value
      721     :
      722   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      723   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      724     (input  p-obj-type
      725     ,input  p-obj-code
      726     ,input  'shift-on=request'
      727     ,output p-shift-on
      728     ) no-error .
      729       if error-status :error
      730       then do:
      731         message
      732           vss-workfile vss-revision vss-description skip
      733           "Ошибка при определении атрибута объекта" skip
      734           "Объект" p-obj-type p-obj-code skip
      735           error-status :get-message(1) skip
      736           return-value skip
      737           view-as alert-box error .
      738         undo, return error return-value .
      739       end.
      740       if p-shift-on = false
      741       then do:
      742         assign
      743           p-shift-date               = ?
      744           p-shift-num                = 0
      745         .
      746       end.
      747       else do:
      748         find first buf_shift-obj share-lock
      749           where buf_shift-obj.obj-type   = p-obj-type
      750             and buf_shift-obj.obj-code   = p-obj-code
      751             and buf_shift-obj.shift-date > p-fact-date
      752           use-index pi
      753           no-error .
      754         if not available buf_shift-obj
      755         or buf_shift-obj.status_ <> 'зкр':U
      756         then do:
      757           message
      758             vss-workfile vss-revision vss-description skip
      759             "Невозможно вычислить последнюю смену" skip
      760             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      761             "Объект" p-obj-type p-obj-code skip
      762             "Дата" p-fact-date skip
      763             view-as alert-box error .
      764           undo, return error return-value .
      765         end.
      766         find last buf_shift-obj share-lock
      767           where buf_shift-obj.obj-type = p-obj-type
      768             and buf_shift-obj.obj-code = p-obj-code
      769             and buf_shift-obj.shift-date <= p-fact-date
      770           use-index pi
      771           no-error .
      772         if available buf_shift-obj
      773         then do:
      774           if  buf_shift-obj.status_ = 'зкр':U
      775           then do:
      776             assign
      777               p-shift-date = buf_shift-obj.shift-date
      778               p-shift-num  = buf_shift-obj.shift-num
      779             .
      780           end.
      781           else do:
      782             message
      783               vss-workfile vss-revision vss-description skip
      784               "Невозможно вычислить последнюю смену" skip
      785               "Статус смены отличен от статуса" 'зкр':U skip
      786               "Объект" p-obj-type p-obj-code skip
      787               "Дата" p-fact-date skip
      788               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      789               view-as alert-box error .
      790             undo, return error return-value .
      791           end.
      792         end.
      793         else do:
      794           assign
      795             p-shift-date = p-fact-date - 1
      796             p-shift-num  = 1
      797           .
      798         end.
      799       end.
      800       run factord in this-procedure
      801         (input  p-fact-date
      802         ,input  1
      803         ,input  1
      804         ,input  p-shift-date
      805         ,input  p-shift-num
      806         ,input  p-shift-on
      807         ,output v-fact-order
      808         ,output p-shift-end-fact-order
      809         ,output p-day-end-fact-order
      810         ) no-error .
      811       if error-status :error
      812       then do:
      813         message
      814           vss-workfile vss-revision vss-description skip
      815           "Ошибка при вызове процедуры factord"
      816           error-status :get-message(1) skip
      817           return-value skip
      818           view-as alert-box error .
      819         undo, return error return-value .
      820       end.
      821     end.
      822   end procedure.
      823   procedure factord-lock-shift :
      824     define input  parameter p-obj-type  as character no-undo .
      825     define input  parameter p-obj-code  as integer   no-undo .
      826     define input  parameter p-fact-date as date      no-undo .
      827     define parameter buffer buf_shift-obj for ub.shift-obj .
      828     define variable v-shift-on      as logical   no-undo .
      829     define variable v-extra-message as character no-undo .
      830     define variable v-error as character no-undo .
      831     do
      832     on error undo, return error return-value
      833     :
      834   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      836     (input  p-obj-type
      837     ,input  p-obj-code
      838     ,input  'shift-on=request'
      839     ,output v-shift-on
      840     ) no-error .
      841       if error-status :error
      842       then do:
      843         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      844         undo, return error v-error .
      845       end.
      846       if v-shift-on = true
      847       then do:
      848         find first buf_shift-obj share-lock
      849           where buf_shift-obj.obj-type   = p-obj-type
      850             and buf_shift-obj.obj-code   = p-obj-code
      851             and buf_shift-obj.shift-date > p-fact-date
      852           use-index pi
      853           no-error .
      854         if not available buf_shift-obj
      855         or buf_shift-obj.status_ <> 'зкр':U
      856         then do:
      857           find last buf_shift-obj
      858             where buf_shift-obj.obj-type = p-obj-type
      859               and buf_shift-obj.obj-code = p-obj-code
      860               and buf_shift-obj.status_  = 'зкр':U
      861             use-index stts
      862             no-error .
      863           if available buf_shift-obj
      864           then do:
      865             assign
      866               v-extra-message =
      867                     substitute("Дата начала последеней закрытой смены на объекте &1"
      868                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      869                               )
      870             .
      871           end.
      872           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      873           undo, return error v-error .
      874         end.
      875       end.
      876     end.
      877   end procedure.
      878   procedure factord-end-day :
      879     define input  parameter p-fact-date            as date    no-undo .
      880     define output parameter p-day-end-fact-order   as decimal no-undo .
      881     do
      882     on error undo, return error return-value
      883     :
      884       if p-fact-date = ?
      885       then do:
      886         return error "Не указана фактическая дата" .
      887       end.
      888       assign
      889         p-day-end-fact-order = integer(p-fact-date) + 0.99
      890       .
      891     end.
      892   end procedure.
      893   procedure factord-to-date :
      894     define input  parameter p-fact-order as decimal no-undo .
      895     define output parameter p-fact-date  as date    no-undo .
      896     define variable v-ref-date  as date      no-undo .
      897     define variable v-ref-delta as integer   no-undo .
      898     do
      899     on error undo, return error return-value
      900     :
      901       if p-fact-order = ?
      902       or p-fact-order = 0
      903       then do:
      904         return error "Не указан fact-order" .
      905       end.
      906       assign
      907         v-ref-date  = date(1, 1, 2000)
      908       .
      909       assign
      910         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      911       .
      912       assign
      913         p-fact-date = v-ref-date + v-ref-delta
      914       .
      915     end.
      916   end procedure.
      917   procedure factord-to-fact-num :
      918     define input  parameter p-fact-order as decimal no-undo .
      919     define output parameter p-fact-num   as integer no-undo .
      920     define variable v-fact-order-trunc as decimal no-undo .
      921     do
      922     on error undo, return error return-value
      923     :
      924       if p-fact-order = ?
      925       or p-fact-order = 0
      926       then do:
      927         return error "Не указан fact-order" .
      928       end.
      929       assign
      930        v-fact-order-trunc = truncate(p-fact-order, 2)
      931       .
      932       assign
      933         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      934       .
      935     end.
      936   end procedure.
      937   procedure factord-to-shift-num :
      938     define input  parameter p-fact-order as decimal no-undo .
      939     define output parameter p-shift-num   as integer no-undo .
      940     define variable  p-shift-numd  as decimal   no-undo .
      941     define variable v-fact-order-trunc as decimal no-undo .
      942     do
      943     on error undo, return error return-value
      944     :
      945       if p-fact-order = ?
      946       or p-fact-order = 0
      947       then do:
      948         return error "Не указан fact-order" .
      949       end.
      950       assign
      951        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      952       .
      953       if v-fact-order-trunc < 0.5 then do:
      954         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      955       end.
      956       assign
      957         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      958         .
      959        assign
      960         p-shift-num = truncate (p-shift-numd , 0)
      961       .
      962     end.
      963   end procedure.
