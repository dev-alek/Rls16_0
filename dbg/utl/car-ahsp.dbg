     1465           "p-fact-order" p-fact-order skip
     1466           view-as alert-box error .
     1467         undo, return error .
     1468       end.
     1469       run partslib-update-by-factord in this-procedure
     1470         (input p-obj-type
     1471         ,input p-obj-code
     1472         ,input p-artic
     1473         ,input p-prod-type
     1474         ,input p-prod-code
     1475         ,input p-fact-order
     1476         ,input v-max-fact-order
     1477         ,input false
     1478         ) no-error .
     1479       if error-status :error
     1480       then do:
     1481         message
     1482           vss-workfile vss-revision vss-description skip
     1483           vss-include-info6 skip
     1484           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1485           "Объект" p-obj-type p-obj-code skip
