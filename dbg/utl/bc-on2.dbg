        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: bc-on2.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/bc-on2.p $":U .
        7   define variable vss-description as character no-undo init "Выключение повторных доп.БК".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define buffer b-prod-bc for ub.prod-bc.
       78   define buffer buf_bar-code for ub.bar-code .
       79   define buffer buf_goods for ub.goods .
       80   define buffer buf_units for ub.units .
       81   define variable all-bc as integer no-undo .
       82   define variable on-bc  as integer no-undo .
       83   define variable off-bc as integer no-undo .
       84   define variable l-prod-bc-pgweight as logical no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define variable v-waitfram-action01         as character   no-undo .
       87   define variable v-waitfram-action02         as character   no-undo .
       88   define variable v-waitfram-action03         as character   no-undo .
       89   define variable mWaitFramTextBeg            as character   no-undo.
       90   define variable mWaitFramTextEnd            as character   no-undo.
       91   define variable mWaitFramView               as logical     no-undo.
       92   define variable mWaitProcEvent              as logical     no-undo init yes.
       93   define variable mWaitFramInterval           as integer     no-undo init 1 .
       94   define variable mWaitFramStop               as logical     no-undo.
       95   define variable mWaitFramStopUser           as logical     no-undo.
       96   define variable mWaitFramStopTimeOut        as logical     no-undo.
       97   define variable mWaitFramStartProc          as datetime-tz no-undo.
       98   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       99   define button B-WaitFramStop auto-end-key
      100        label "Стоп"
      101        size 10 by 1 tooltip "Остоновить процесс".
      102   define button B-viewProcInfo
      103        label "Информация"
      104        size 15 by 1 tooltip "Информация о процесс".
      105   define frame waitfram
      106     v-waitfram-action01 format "x(72)" no-label skip
      107     v-waitfram-action02 format "x(72)" no-label skip
      108     v-waitfram-action03 format "x(72)" no-label skip
      109     B-viewProcInfo
      110     B-WaitFramStop at row 4 col 30
      111     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      112     .
      113   define new global shared variable mBatchMode as logical no-undo init ?.
      114   define variable mFramBachModHandle as handle no-undo.
      115   mFramBachModHandle = frame waitfram:handle.
      116   define variable mFameOldVis as logical no-undo.
      117   define variable mVisCUrentVin as logical no-undo.
      118   if session:batch-mode
      119   then
      120      mBatchMode = yes.
      121   if mBatchMode = ? then do:
      122     mVisCUrentVin = current-window:visible.
      123     mFameOldVis = mFramBachModHandle:visible.
      124     mFramBachModHandle:visible  = yes.
      125     mBatchMode = mFramBachModHandle:visible ne yes.
      126     mFramBachModHandle:visible = mFameOldVis.
      127     current-window:visible = mVisCUrentVin.
      128   end.
      129    if  log-manager:logfile-name ne ?
      130     then DO:
      131         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      132         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      133         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      134     end.
      135   on choose of B-WaitFramStop in frame waitfram
      136   do:
      137     mWaitFramStop = yes.
      138     mWaitFramStopUser = yes.
      139   end.
      140   function waitfram-check-timeout returns logical():
      141      define variable vtime as int64 no-undo.
      142      if mWaitFramStopTimeOut
      143      then
      144         return yes.
      145      vtime = ( now - mWaitFramStartProc ) / 1000 .
      146      if     mWaitFramTimeOut ne ?
      147         and mWaitFramTimeOut ne 0
      148         and mWaitFramTimeOut lt vtime
      149      then do:
      150         mWaitFramStopTimeOut = yes.
      151      end.
      152      return mWaitFramStopTimeOut.
      153   end.
      154   procedure waitfram-hide :
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       pause 0 before-hide .
      160       if not mBatchMode then
      161         hide frame waitfram .
      162     if     not mWaitFramView
      163        and mWaitProcEvent
      164     then
      165       process events .
      166     end.
      167   end procedure.
      168   procedure waitfram-show :
      169     define input  parameter p-message as character no-undo .
      170     define variable v-left-margin as integer   no-undo .
      171     if not session:batch-mode
      172     then do
      173     on error undo, return error return-value
      174     :
      175       if length(p-message) <= 70 then do:
      176         assign
      177           v-left-margin = integer((70 - length(p-message)) / 2)
      178         .
      179         assign
      180           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      181         .
      182         assign
      183           v-waitfram-action01 = " "
      184           v-waitfram-action02 = " "
      185                                    + fill(" ", v-left-margin)
      186                                    + p-message
      187           v-waitfram-action03 = " "
      188         .
      189       end.
      190       else do:
      191         define variable vRindex1 as integer no-undo.
      192         define variable vRindex2 as integer no-undo.
      193         vRindex1 = r-index(p-message," ",70).
      194         if vRindex1 = 0
      195         then
      196            vRindex1 = 70.
      197         if length(p-message)  <= vRindex1 + 70 then do:
      198           assign
      199             v-waitfram-action01 = " "
      200             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      202           .
      203         end.
      204         else do:
      205           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      206           if vRindex2 <= vRindex1
      207           then
      208              vRindex2 = vRindex1 + 70.
      209           assign
      210             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      211             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      212             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      213           .
      214         end.
      215       end.
      216       B-viewProcInfo:visible   in frame waitfram = no.
      217       B-viewProcInfo:sensitive in frame waitfram = no.
      218       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      219       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      220       if  (   mWaitFramView
      221          or  mWaitProcEvent)
      222          and not mBatchMode
      223       then
      224          display
      225             v-waitfram-action01 skip
      226             v-waitfram-action02 skip
      227             v-waitfram-action03 skip
      228          with frame waitfram .
      229       if     mWaitFramView
      230          then do:
      231             if     mWaitFramInterval ne ?
      232                and not mBatchMode
      233             then
      234                wait-for go of frame waitfram pause mWaitFramInterval.
      235          end.
      236          else
      237             if     mWaitProcEvent
      238                and not mBatchMode
      239             then
      240                process events .
      241     end.
      242   end procedure.
      243      procedure waitfram-show-this:
      244         define input  parameter iInterval as int64 no-undo.
      245         define variable vtime as int64 no-undo.
      246         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      247         mWaitFramInterval = iInterval.
      248         run waitfram-show (substitute("&1&2 &3&4" ,
      249                                       mWaitFramTextBeg ,
      250                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      251                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      252                                       mWaitFramTextEnd
      253                                      )
      254                           ).
      255      end.
      256      procedure WaitFramRunPause:
      257         define input  parameter iInterval as dec no-undo.
      258         define variable vStart  as datetime-tz no-undo.
      259         define variable vend    as datetime-tz no-undo.
      260         define variable vint as int64 no-undo.
      261         define variable vOk as logical no-undo.
      262         vStart = now.
      263         vend   = vStart.
      264         publish "WaitFramPause" (iInterval,output vOk).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and (   vint > 0
      270                 or (    not vOk
      271                     and iInterval eq ?
      272                     )
      273                 )
      274         then
      275            run waitfram-show-this (iInterval).
      276         vend   =  now.
      277         vint = vend - vStart.
      278         vint = iInterval - vint / 1000.
      279         if     not mWaitFramStop
      280            and vint > 0
      281         then do:
      282            run gbl/pause.p (vint * 1000).
      283         end.
      284         if iInterval ne ?
      285         then
      286            publish "WaitFramStop".
      287         waitfram-check-timeout().
      288      end.
      289      procedure WaitFramWaitFor:
      290         define input  parameter iInterval as dec no-undo.
      291         assign
      292            mWaitFramStartProc   = now
      293            mWaitFramStopUser    = no
      294            mWaitFramStopTimeOut = no
      295         .
      296         block-wait:
      297         do while not mWaitFramStop:
      298            run WaitFramRunPause (iInterval).
      299            if  waitfram-check-timeout()
      300            then do:
      301               leave block-wait.
      302            end.
      303         end.
      304         run waitfram-hide.
      305      end.
      306   procedure waitfram-join :
      307     define input  parameter p-line-1  as character no-undo .
      308     define input  parameter p-line-2  as character no-undo .
      309     define input  parameter p-line-3  as character no-undo .
      310     define output parameter p-message as character no-undo .
      311     do
      312     on error undo, return error return-value
      313     :
      314       assign
      315         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      316                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      317                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      318       .
      319     end.
      320   end procedure.
      321   function waitfram-join-function returns character
      322     (input p-line-1 as character
      323     ,input p-line-2 as character
      324     ,input p-line-3 as character
      325     ).
      326     define variable v-message as character no-undo .
      327     run waitfram-join in this-procedure
      328       (input  p-line-1
      329       ,input  p-line-2
      330       ,input  p-line-3
      331       ,output v-message
      332       ) .
      333     return v-message .
      334   end function .
      335   define variable lok as logical no-undo .
      336   assign
      337     lok = no
      338   .
      339   message
      340     "Включение всех выключенных неповторных доп. БК, (кроме весовых)"
      341     "включение первого из повторных доп. БК, если все они выключены." skip
      342     "ВНИМАНИЕ - изменения бар-кодов не будут передаваться через новости" skip
      343     "Данную утилиту необходимо запустить на всех базах данных"
      344     "и сравнить выключенные бар-коды" skip
      345     "bc-on2.err - список выключенных бар-кодов" skip
      346     "bc-on2.txt - список включенных бар-кодов" skip
      347     "Продолжить?"
      348     view-as alert-box question buttons OK-Cancel update lok.
      349   if not lok then do:
      350     return.
      351   end.
      352   run waitfram-show in this-procedure (
      353    input "Выбор всех бар-кодов..."
      354     ).
      355   for each ub.prod-bc
      356   :
      357     assign
      358       all-bc = all-bc + 1
      359     .
      360     run waitfram-show in this-procedure (input "Всего бар-кодов" + STRING( all-bc ) +  ". "
      361        + "Включено "  + STRING(on-bc) + ". "
      362        + "Выключено "  + STRING(off-bc) + ". "
      363       ).
      364     if can-find (b-prod-bc where b-prod-bc.b-str = prod-bc.b-str and
      365                      b-prod-bc.bc-on = yes and
      366                      recid (b-prod-bc) <> recid (prod-bc) no-lock) then do:
      367       find first buf_bar-code no-lock where
      368                   buf_bar-code.b-code = ub.prod-bc.b-code.
      369       find first buf_goods No-lock where
      370                   buf_goods.gds-code =buf_bar-code.b-code .
      371       find first buf_units No-lock where
      372                   buf_units.unit-name = buf_goods.unit-base.
      373       if lookup('вес':U, buf_units.type) > 0  then do:
      374         next.
      375       end.
      376       if lookup('шту':U, buf_units.type) > 0  then do:
      377         l-prod-bc-pgweight = yes.
      378   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      380     (buffer ub.prod-bc
      381     ,input  'pgweight=request':u
      382     ,output l-prod-bc-pgweight
      383     ) no-error .
      384         if l-prod-bc-pgweight then do:
      385           next.
      386         end.
      387       end.
      388       assign
      389         off-bc = off-bc + 1
      390       .
      391       output to bc-on2.err append .
      392       export prod-bc.b-str .
      393       output close .
      394       if prod-bc.bc-on then do:
      395         output to bc-on2.err append .
      396         export prod-bc.b-str "**error must be off" .
      397         output close .
      398       end.
      399       next.
      400     end.
      401     if not prod-bc.bc-on then do:
      402       assign
      403         on-bc = on-bc + 1
      404       .
      405       assign
      406         prod-bc.bc-on = yes
      407       .
      408       output to bc-on2.txt append .
      409       export prod-bc.b-str .
      410       output close .
      411     end.
      412   end.
      413   run waitfram-hide in this-procedure .
      414   message
      415     "Включение доп. БК закончено."
      416     view-as alert-box.
