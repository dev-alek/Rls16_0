        1   block-level on error undo, throw.
        2   DEFINE var install as logical no-undo init no.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":u .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
        6   define variable vss-workfile    as character no-undo init "$Workfile: inicshp.p $":u .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/inicshp.p $":u .
        8   define variable vss-description as character no-undo init "Инициализация поля gds-obj.cash-parts" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define new shared temp-table gds-list no-undo like ub.goods
       69     field qnty   as decimal
       70     field to-del as logical
       71     field order-num as integer
       72     field to-sel as logical
       73     field promo-code as character
       74     field ActionId  as int64
       75     field db-num as integer
       76     index art  is primary unique artic prod-type prod-code
       77     index code is         unique gds-code
       78     index oi order-num
       79     index isel to-sel
       80     .
       81   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define  new shared  temp-table gds-list-hist no-undo
       83   field list-table as character
       84   field id as integer
       85   field line as integer
       86   field hist-mode as character
       87   field des as character
       88   field num-recs as integer
       89   field option_ as character
       90   field item_ as character
       91   field status_ as character
       92   field num-add as integer
       93   field num-ignored as integer
       94   field done as logical
       95   field err_ as logical
       96   field err-mes as character
       97   index pi is primary
       98   id
       99   line
      100   index isdone
      101   done
      102   .
      103   define variable i as integer no-undo.
      104   define variable k as integer no-undo.
      105   define variable choice as integer no-undo.
      106   def frame b
      107   i label "Обработано товаров"
      108   with side-labels title "Заполнение поля ПРОДАЖА ПО ПАРТИЯМ для серийных товаров" view-as dialog-box.
      109       view frame b.
      110       i = 0.
      111   for each ub.units No-LOCK WHERE lookup('сер':U, ub.units.type) > 0:
      112       for each ub.goods No-LOCK ON STOP UNDO, NEXT
      113                               ON ERROR UNDO, NEXT:
      114           if ub.goods.unit-base = ub.units.unit-name then do:
      115               FOR EACH ub.gds-obj where ub.gds-obj.artic = ub.goods.artic AND
      116                                                         ub.gds-obj.prod-type = ub.goods.prod-type AND
      117                                                         ub.gds-obj.prod-code = ub.goods.prod-code:
      118                   i = i + 1.
      119                   ASSIGN
      120                   ub.gds-obj.cash-parts = yes
      121                   k = k + 1.
      122               END.
      123               disp i with frame b.
      124               process events.
      125           end.
      126       end.
      127   end.
      128   if i = k then
      129   message "Заполнение поля ПРОДАЖА ПО ПАРТИЯМ для серийных товаров закончено успешно."
      130   view-as alert-box.
      131   else
      132   message "Из " i " товаров на объекте, выбранных для изменения удалось изменить" k " !" view-as
      133   alert-box WARNING.
