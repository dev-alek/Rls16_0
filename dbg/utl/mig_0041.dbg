        1   block-level on error undo, throw.
        2   using Ibs.Th.Gbl.ProgressBar.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: mig_0041.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/mig_0041.p $":U .
        8   define variable vss-description as character no-undo init "Модификация таблиц раздела Клиенты".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define input parameter parparentproc    as widget-handle no-undo .
       64   define input parameter p-parent-handle  as widget-handle no-undo .
       65   define input parameter p-log-handle     as handle no-undo .
       66   define input parameter p-parameter      as character no-undo .
       67   define input parameter p-db-num         as integer   no-undo .
       68   define input parameter p-cli-code       as integer   no-undo .
       69   define input parameter log-file-name   as character  no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define new global shared variable g#library  as handle no-undo .
      301   define new global shared variable g#library2 as handle no-undo .
      302   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303     define variable v-prg-bar_progress-bar  as class ProgressBar  no-undo .
      304     procedure prg-bar_new-progress-bar :
      305       define input  parameter p-min as int64   no-undo .
      306       define input  parameter p-max as int64   no-undo .
      307     do
      308     on error undo, return error return-value
      309     :
      310       if v-prg-bar_progress-bar <> ?
      311       then do:
      312         run prg-bar_delete-progress-bar in this-procedure .
      313       end.
      314       v-prg-bar_progress-bar = new progressbar( p-min , p-max ).
      315     end.
      316     end procedure.
      317     procedure prg-bar_delete-progress-bar :
      318     do
      319     on error undo, return error return-value
      320     :
      321       if v-prg-bar_progress-bar <> ?
      322       then do:
      323         delete object v-prg-bar_progress-bar.
      324         assign
      325           v-prg-bar_progress-bar = ?
      326         .
      327       end.
      328     end.
      329     end procedure.
      330     procedure prg-bar_show-progress-bar :
      331     do
      332     on error undo, return error return-value
      333     :
      334       if v-prg-bar_progress-bar <> ?
      335       then do:
      336         v-prg-bar_progress-bar :show-bar() .
      337       end.
      338     end.
      339     end procedure.
      340     procedure prg-bar_increment-progress-bar :
      341     do
      342     on error undo, return error return-value
      343     :
      344       if v-prg-bar_progress-bar <> ?
      345       then do:
      346         v-prg-bar_progress-bar :increment() .
      347       end.
      348     end.
      349     end procedure.
      350     procedure prg-bar_title-progress-bar :
      351       define input  parameter p-str as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       if v-prg-bar_progress-bar <> ?
      356       then do:
      357         assign
      358           v-prg-bar_progress-bar :frame-title = p-str
      359         .
      360       end.
      361     end.
      362     end procedure.
      363     procedure prg-bar_stepto-progress-bar :
      364       define input  parameter p-val as integer   no-undo .
      365     do
      366     on error undo, return error return-value
      367     :
      368       if v-prg-bar_progress-bar <> ?
      369       then do:
      370           v-prg-bar_progress-bar :stepto( p-val ) .
      371       end.
      372     end.
      373     end procedure.
      374   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375     define variable v-prg-bar_cb-handle     as handle             no-undo .
      376     procedure prg-bar_init-cb-handle :
      377       define input  parameter p-cb-handle as handle    no-undo .
      378     do
      379     on error undo, return error return-value
      380     :
      381       if valid-handle( p-cb-handle )
      382       then do:
      383         assign
      384           v-prg-bar_cb-handle = p-cb-handle
      385         .
      386       end.
      387       else do:
      388         assign
      389           v-prg-bar_cb-handle = ?
      390         .
      391       end.
      392     end.
      393     end procedure.
      394     procedure prg-bar_new :
      395       define input  parameter p-min as int64   no-undo .
      396       define input  parameter p-max as int64   no-undo .
      397     do
      398     on error undo, return error return-value
      399     :
      400       if valid-handle(v-prg-bar_cb-handle)
      401       then do:
      402         run prg-bar_new-progress-bar in v-prg-bar_cb-handle ( input p-min , input p-max ).
      403       end.
      404     end.
      405     end procedure.
      406     procedure prg-bar_delete :
      407     do
      408     on error undo, return error return-value
      409     :
      410       if valid-handle(v-prg-bar_cb-handle)
      411       then do:
      412         run prg-bar_delete-progress-bar in v-prg-bar_cb-handle .
      413       end.
      414     end.
      415     end procedure.
      416     procedure prg-bar_show :
      417     do
      418     on error undo, return error return-value
      419     :
      420       if valid-handle(v-prg-bar_cb-handle)
      421       then do:
      422         run prg-bar_show-progress-bar in v-prg-bar_cb-handle .
      423       end.
      424     end.
      425     end procedure.
      426     procedure prg-bar_increment :
      427     do
      428     on error undo, return error return-value
      429     :
      430       if valid-handle(v-prg-bar_cb-handle)
      431       then do:
      432         run prg-bar_increment-progress-bar in v-prg-bar_cb-handle.
      433       end.
      434     end.
      435     end procedure.
      436     procedure prg-bar_title :
      437       define input  parameter p-str as character no-undo .
      438     do
      439     on error undo, return error return-value
      440     :
      441       if valid-handle(v-prg-bar_cb-handle)
      442       then do:
      443         run prg-bar_title-progress-bar in v-prg-bar_cb-handle ( input p-str ) .
      444       end.
      445     end.
      446     end procedure.
      447     procedure prg-bar_stepto :
      448       define input  parameter p-val as integer   no-undo .
      449     do
      450     on error undo, return error return-value
      451     :
      452       if valid-handle(v-prg-bar_cb-handle)
      453       then do:
      454         run prg-bar_stepto-progress-bar in v-prg-bar_cb-handle ( input p-val ) .
      455       end.
      456     end.
      457     end procedure.
      458   define variable v-progress-bar as class ProgressBar no-undo .
      459   run prg-bar_init-cb-handle in this-procedure ( this-procedure ) .
      460   define variable v-tot-rec as int64 no-undo .
      461   run write-log-and-file in p-log-handle (
      462         input 1
      463       , input log-file-name
      464       , input 1
      465       , input substitute("ДК") ).
      466   define shared temp-table temp-clients no-undo like ub.clients
      467   field base-code as integer
      468   field new-issue-code as integer
      469   field deleted-sysconf as logical
      470   .
      471   define shared temp-table temp-sysconf no-undo like ub.sysconf.
      472   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      473   define buffer buf_dis-obj for ub.dis-obj.
      474   define buffer buf_c-dis-obj for ub.c-dis-obj.
      475   define buffer buf_dis-host for ub.dis-host.
      476   define buffer buf_c-dis-host for ub.c-dis-host.
      477   define buffer buf_dis-card for ub.dis-card.
      478   define buffer buf_sysconf for ub.sysconf.
      479   define buffer buf_shop for ub.shop.
      480   on write of ub.dis-host override do: end.
      481   on delete of ub.dis-card override do: end.
      482   on delete of ub.dis-host override do: end.
      483   on delete of ub.dis-obj override do: end.
      484   on delete of ub.dis-card-property override do: end.
      485   on delete of ub.c-dis-host override do: end.
      486   on delete of ub.c-dis-obj override do: end.
      487   on delete of ub.c-dis-card-property override do: end.
      488   on delete of ub.dis-card-type override do: end.
      489   on delete of ub.dis-card-type-attr override do: end.
      490   on delete of ub.dis-dct-rule override do: end.
      491   on delete of ub.c-dis-dct-rule override do: end.
      492   on delete of ub.dis-card-mask override do: end.
      493   on delete of ub.c-dis-card-type override do: end.
      494   on delete of ub.c-dis-card-type-attr override do: end.
      495   on delete of ub.c-dis-card-mask override do: end.
      496   on write of ub.trn-doc override do: end.
      497   on delete of ub.hist-nws-option override do: end.
      498   on delete of ub.c-hist-nws-option override do: end.
      499   on delete of ub.rp-by-call override do: end.
      500   on delete of ub.c-rp-by-call override do: end.
      501   on delete of ub.rule-by-call override do: end.
      502   on delete of ub.c-rule-by-call override do: end.
      503   on delete of ub.rule-call-param override do: end.
      504   on delete of ub.c-rule-call-param override do: end.
      505   on delete of ub.prop-ref-call override do: end.
      506     do
      507     on error undo, return error return-value
      508     :
      509     v-tot-rec = 0 .
      510     for each buf_dis-card no-lock where
      511       v-tot-rec = v-tot-rec + 1.
      512     end.
      513     run prg-bar_new in this-procedure ( 1, v-tot-rec).
      514     run prg-bar_title in this-procedure ( input "Обработка таблицы ДК...":U).
      515     run prg-bar_show in this-procedure .
      516     for each buf_dis-card no-lock:
      517       run prg-bar_increment in this-procedure .
      518       find first buf_dis-host no-lock where
      519                 buf_dis-host.d-card = buf_dis-card.d-card
      520             and buf_dis-host.host-code = 0
      521             and buf_dis-host.dt-code = 0
      522             no-error .
      523       if not available buf_dis-host then do:
      524         run create-dis-host-0 in this-procedure ( input buf_dis-card.d-card, input buf_dis-card.card-num) no-error .
      525         if error-status :error then do:
      526             run write-log-and-file in p-log-handle (
      527                   input 1
      528                 , input log-file-name
      529                 , input 1
      530                 , input substitute("err ДК&2 - &1 &3", error-status :get-message(1) , buf_Dis-card.d-card, return-value  )).
      531                 run prg-bar_delete-progress-bar in this-procedure .
      532             return .
      533         end.
      534       end.
      535     end.
      536     v-tot-rec = 0 .
      537     for each ub.sysconf no-lock :
      538       v-tot-rec = v-tot-rec + 1.
      539     end.
      540     for each  ub.staff no-lock :
      541       v-tot-rec = v-tot-rec + 1.
      542     end.
      543     run prg-bar_delete-progress-bar in this-procedure .
      544     v-tot-rec = 0 .
      545     for each temp-clients where
      546              temp-clients.obj-type = 'маг':U
      547          and temp-clients.obj-type = 'скл':U
      548             :
      549       v-tot-rec = v-tot-rec + 1.
      550     end.
      551     run prg-bar_new in this-procedure ( 1, v-tot-rec).
      552     run prg-bar_title in this-procedure ( input "Определение базовых валют удаляемых объектов и фирм...":U).
      553     run prg-bar_show in this-procedure .
      554     for each temp-clients where
      555             temp-clients.obj-type = 'маг':U:
      556       run prg-bar_increment in this-procedure .
      557       find first buf_sysconf no-lock where
      558                 buf_sysconf.host-code = temp-clients.host-code no-error.
      559       if not available buf_sysconf then do:
      560         find first temp-sysconf no-lock where
      561                   temp-sysconf.host-code = temp-clients.host-code.
      562         assign
      563         temp-clients.base-code = temp-sysconf.base-code.
      564       end.
      565       else do:
      566         assign
      567         temp-clients.base-code = buf_sysconf.base-code.
      568       end.
      569       for each buf_shop no-lock,
      570              first buf_sysconf no-lock where
      571                  buf_sysconf.host-code = buf_shop.host-code
      572              and buf_sysconf.base-code = temp-clients.base-code :
      573         leave.
      574       end.
      575       if not available buf_shop then do:
      576         find first buf_shop.
      577       end.
      578       assign
      579       temp-clients.new-issue-code = buf_shop.obj-code.
      580     end.
      581     for each temp-clients where
      582             temp-clients.obj-type = 'скл':U:
      583       run prg-bar_increment in this-procedure .
      584       find first buf_sysconf no-lock where
      585                 buf_sysconf.host-code = temp-clients.host-code no-error.
      586       if not available buf_sysconf then do:
      587         find first temp-sysconf no-lock where
      588                   temp-sysconf.host-code = temp-clients.host-code.
      589         assign
      590         temp-clients.base-code = temp-sysconf.base-code.
      591       end.
      592       else do:
      593         assign
      594         temp-clients.base-code = buf_sysconf.base-code.
      595       end.
      596     end.
      597     run prg-bar_delete-progress-bar in this-procedure .
      598     v-tot-rec = 0 .
      599     for each temp-sysconf   :
      600       v-tot-rec = v-tot-rec + 1.
      601     end.
      602     run prg-bar_new in this-procedure ( 1, v-tot-rec).
      603     run prg-bar_title in this-procedure ( input "Обработка НЕглобальных ДК (по удаляемым фирмам)...":U).
      604     run prg-bar_show in this-procedure .
      605     for each temp-sysconf no-lock  :
      606       for each temp-clients where
      607               temp-clients.host-code = temp-sysconf.host-code:
      608         assign
      609         temp-clients.deleted-sysconf = yes.
      610       end.
      611       run delete-sysconf-dc in this-procedure ( input temp-sysconf.host-code) no-error .
      612       if error-status:error then do:
      613         run write-log-and-file in p-log-handle (
      614               input 1
      615             , input log-file-name
      616             , input 1
      617             , input substitute("delete-sysconf-dc - host-code = &1 &2"
      618                               , temp-sysconf.host-code
      619                               , error-status :get-message(1) )).
      620         return .
      621       end.
      622       find first buf_sysconf no-lock where buf_sysconf.base-code = temp-sysconf.base-code no-error.
      623       if not available buf_sysconf then do:
      624         find first buf_sysconf no-lock.
      625       end.
      626       for each buf_dis-host share-lock where
      627               buf_dis-host.host-code = temp-sysconf.host-code,
      628           first buf_dis-card no-lock where
      629                 buf_Dis-card.d-card = buf_dis-host.d-card:
      630         if buf_dis-host.dt-code = 0 then do:
      631           run create-dh-sum-record in this-procedure (
      632                                                       input buf_sysconf.host-code
      633                                                     ,input temp-sysconf.base-code
      634                                                     ,input buf_sysconf.base-code
      635                                                     ,buffer buf_Dis-host
      636                                                     ,buffer buf_dis-card) no-error.
      637           if error-status:error then do:
      638             run write-log-and-file in p-log-handle (
      639                   input 1
      640                 , input log-file-name
      641                 , input 1
      642                 , input substitute("create-dh-sum-record err - d-card=&1 host-code = &2 &3"
      643                                   , buf_dis-card.d-card
      644                                   , temp-sysconf.host-code
      645                                   , error-status :get-message(1) )).
      646             return .
      647           end.
      648         end.
      649         delete buf_Dis-host.
      650         for each buf_c-dis-host share-lock where
      651               buf_c-dis-host.d-card = buf_Dis-host.d-card
      652           and buf_c-dis-host.host-code = temp-sysconf.host-code
      653           and buf_c-dis-host.dt-code = buf_Dis-host.dt-code
      654           :
      655           delete buf_c-dis-host.
      656         end.
      657       end.
      658       delete temp-sysconf.
      659       run prg-bar_increment in this-procedure .
      660     end.
      661     run prg-bar_delete-progress-bar in this-procedure .
      662     v-tot-rec = 0 .
      663     for each temp-clients   :
      664       v-tot-rec = v-tot-rec + 1.
      665     end.
      666     run prg-bar_new in this-procedure ( 1, v-tot-rec).
      667     run prg-bar_title in this-procedure ( input "Обработка ДК (по удаляемым объектам)...":U).
      668     run prg-bar_show in this-procedure .
      669     for each temp-clients:
      670       find first buf_sysconf no-lock where buf_sysconf.base-code = temp-clients.base-code no-error.
      671       if not available buf_sysconf then do:
      672         find first buf_sysconf no-lock.
      673       end.
      674       for each buf_dis-obj share-lock where
      675               buf_dis-obj.obj-type = temp-clients.obj-type
      676           and buf_dis-obj.obj-code = temp-clients.obj-code,
      677           first buf_dis-card no-lock where
      678                 buf_Dis-card.d-card = buf_dis-obj.d-card  :
      679         if not temp-clients.deleted-sysconf then do:
      680           if buf_dis-obj.dt-code = 0 then do:
      681             run create-do-sum-record in this-procedure (
      682                                                         input buf_sysconf.host-code
      683                                                       ,input temp-clients.base-code
      684                                                       ,input buf_sysconf.base-code
      685                                                       ,buffer buf_Dis-obj
      686                                                       ,buffer buf_dis-card) no-error.
      687             if error-status:error then do:
      688               run write-log-and-file in p-log-handle (
      689                     input 1
      690                   , input log-file-name
      691                   , input 1
      692                   , input substitute("create-do-sum-record err - d-card=&1 &2&3 &4"
      693                                     , buf_dis-card.d-card
      694                                     , temp-clients.obj-type
      695                                     , temp-clients.obj-code
      696                                     , error-status :get-message(1) )).
      697               return .
      698             end.
      699           end.
      700         end.
      701         for each buf_c-dis-obj share-lock where
      702               buf_c-dis-obj.d-card = buf_Dis-obj.d-card
      703           and buf_c-dis-obj.obj-type = temp-clients.obj-type
      704           and buf_c-dis-obj.obj-code = temp-clients.obj-code:
      705           delete buf_c-dis-obj.
      706         end.
      707         delete buf_Dis-obj.
      708       end.
      709       if temp-clients.obj-type = 'маг':U then do:
      710         run rename-issue-code in this-procedure ( input temp-clients.obj-code) no-error .
      711         if error-status:error then do:
      712           run write-log-and-file in p-log-handle (
      713                 input 1
      714               , input log-file-name
      715               , input 1
      716               , input substitute("rename-issue-code err - d-card=&1 &2", buf_dis-card.d-card, error-status :get-message(1) )).
      717           return .
      718         end.
      719       end.
      720       run prg-bar_increment in this-procedure .
      721     end.
      722     run prg-bar_delete-progress-bar in this-procedure .
      723     v-tot-rec = 0 .
      724     for each buf_sysconf   :
      725       v-tot-rec = v-tot-rec + 1.
      726     end.
      727     run prg-bar_new in this-procedure ( 1, v-tot-rec).
      728     run prg-bar_title in this-procedure ( input "Обработка ДК - создание записей платежей...":U).
      729     run prg-bar_show in this-procedure .
      730     for each buf_sysconf no-lock
      731     :
      732       for each buf_dis-host no-lock where
      733               buf_dis-host.host-code = buf_sysconf.host-code,
      734           first buf_dis-card no-lock where
      735                 buf_Dis-card.d-card = buf_dis-host.d-card
      736       :
      737         if buf_dis-host.dt-code = 0 then do:
      738           run create-dh-sum-record in this-procedure (
      739                                                       input buf_sysconf.host-code
      740                                                     ,input buf_sysconf.base-code
      741                                                     ,input buf_sysconf.base-code
      742                                                     ,buffer buf_Dis-host
      743                                                     ,buffer buf_dis-card) no-error.
      744           if error-status:error then do:
      745             run write-log-and-file in p-log-handle (
      746                   input 1
      747                 , input log-file-name
      748                 , input 1
      749                 , input substitute("create-dh-sum-record err - d-card=&1 host-code=&2 &3"
      750                                   , buf_dis-card.d-card
      751                                   , buf_sysconf.host-code
      752                                   , error-status :get-message(1) )).
      753             return .
      754           end.
      755         end.
      756       end.
      757       run prg-bar_increment in this-procedure .
      758     end.
      759     run prg-bar_delete-progress-bar in this-procedure .
      760   end.
      761   procedure create-do-sum-record :
      762   define input parameter p-host-code as integer no-undo .
      763   define input parameter p-old-base-code as integer no-undo .
      764   define input parameter p-base-code as integer no-undo .
      765   define parameter buffer buf_dis-obj for ub.dis-obj.
      766   define parameter buffer buf_dis-card for ub.dis-card.
      767   DEFINE VARIABLE v-today as date no-undo .
      768   DEFINE VARIABLE v-time as integer no-undo .
      769   define variable v-source-ref as character no-undo .
      770   define variable v-exch-rate as decimal no-undo .
      771   define variable v-exch-scale as integer no-undo .
      772   define variable v-curr-abbr as character no-undo .
      773   define buffer buf_payment for ub.payment.
      774   do
      775   on error undo, return error return-value
      776   :
      777       run cur-time in this-procedure ( output v-today, output v-time).
      778       v-source-ref = substitute('&1&2-&3'
      779                               , buf_dis-obj.obj-type
      780                               , buf_dis-obj.obj-code
      781                               , string(v-today, '99/99/9999')
      782                               ).
      783       find first buf_payment where
      784               buf_payment.host-code = p-host-code
      785           and buf_payment.d-card = buf_dis-obj.d-card
      786           and buf_payment.source-type = ''
      787           and buf_payment.source-ref = v-source-ref
      788           and buf_payment.status_ = 'факт':U
      789           and buf_payment.fact-date = v-today
      790           no-error.
      791       if not available buf_payment then do:
      792         create buf_payment.
      793         assign
      794         buf_payment.host-code = p-host-code
      795         buf_payment.d-card = buf_dis-obj.d-card
      796         buf_payment.source-type = ''
      797         buf_payment.source-ref = v-source-ref
      798         buf_payment.fact-date = v-today
      799         buf_payment.base-scale = 1
      800         buf_payment.cli-code = buf_Dis-card.cli-code
      801         buf_payment.cli-type = buf_Dis-card.cli-type
      802         buf_payment.closid = userid("ub")
      803         buf_payment.creid = userid("ub")
      804         buf_payment.due-date = v-today
      805         buf_payment.exch-code = p-old-base-code
      806         buf_payment.exch-date = v-today
      807         buf_payment.exch-scale = 1
      808         buf_payment.pay-code = 1
      809         buf_payment.payer-type = buf_Dis-card.cli-type
      810         buf_payment.payer-code = buf_Dis-card.cli-code
      811         buf_payment.pmnt-code = string(next-value(s-pmnt-code, ub))
      812         buf_payment.ps = ''
      813         buf_payment.status_ =  'факт':U
      814         .
      815       end.
      816   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      818     (input  p-old-base-code
      819     ,input  v-today
      820     ,output v-exch-rate
      821     ,output v-exch-scale
      822     ,output v-curr-abbr
      823     )  .
      824       assign
      825       buf_payment.tot-base = buf_payment.tot-base + (if buf_dis-card.credit-card
      826                                                     then buf_dis-obj.pay-tot-base
      827                                                     else (buf_dis-obj.gds-tot-base - buf_dis-obj.gds-dis-base)
      828                                                     )
      829       buf_payment.tot-rubl = buf_payment.tot-rubl + (if buf_dis-card.credit-card
      830                                                     then buf_dis-obj.pay-tot-rubl
      831                                                     else (buf_dis-obj.gds-tot-rubl - buf_dis-obj.gds-dis-rubl)
      832                                                     )
      833       buf_payment.tot-cli  = (if p-old-base-code = 0 then buf_payment.tot-rubl else buf_payment.tot-base)
      834       buf_payment.tot-base = (if p-old-base-code = p-base-code then buf_payment.tot-base else buf_payment.tot-rubl / v-exch-rate * v-exch-scale)
      835       buf_payment.base-rate = (if p-old-base-code = 0 then 1 else buf_payment.tot-rubl / buf_payment.tot-base)
      836       buf_payment.exch-rate = (if p-old-base-code = 0 then 1 else buf_payment.tot-rubl / buf_payment.tot-base)
      837       .
      838   end.
      839   end procedure.
      840   procedure create-dh-sum-record :
      841   define input parameter p-host-code as integer no-undo .
      842   define input parameter p-old-base-code as integer no-undo .
      843   define input parameter p-base-code as integer no-undo .
      844   define parameter buffer buf_dis-host for ub.dis-host.
      845   define parameter buffer buf_dis-card for ub.dis-card.
      846   DEFINE VARIABLE v-today as date no-undo .
      847   DEFINE VARIABLE v-time as integer no-undo .
      848   define variable v-source-ref as character no-undo .
      849   define variable v-exch-rate as decimal no-undo .
      850   define variable v-exch-scale as integer no-undo .
      851   define variable v-curr-abbr as character no-undo .
      852   define buffer buf_payment for ub.payment.
      853   do
      854   on error undo, return error return-value
      855   :
      856       run cur-time in this-procedure ( output v-today, output v-time).
      857       v-source-ref = substitute('&1&2-&3'
      858                               , 'орг':U
      859                               , buf_dis-host.host-code
      860                               , string(v-today, '99/99/9999')
      861                               ).
      862       find first buf_payment where
      863               buf_payment.host-code = p-host-code
      864           and buf_payment.d-card = buf_dis-host.d-card
      865           and buf_payment.source-type = ''
      866           and buf_payment.source-ref = v-source-ref
      867           and buf_payment.status_ = 'факт':U
      868           and buf_payment.fact-date = v-today
      869           no-error.
      870       if not available buf_payment then do:
      871         create buf_payment.
      872         assign
      873         buf_payment.host-code = p-host-code
      874         buf_payment.d-card = buf_dis-host.d-card
      875         buf_payment.source-type = ''
      876         buf_payment.source-ref = v-source-ref
      877         buf_payment.fact-date = v-today
      878         buf_payment.base-scale = 1
      879         buf_payment.cli-code = buf_Dis-card.cli-code
      880         buf_payment.cli-type = buf_Dis-card.cli-type
      881         buf_payment.closid = userid("ub")
      882         buf_payment.creid = userid("ub")
      883         buf_payment.due-date = v-today
      884         buf_payment.exch-code = p-old-base-code
      885         buf_payment.exch-date = v-today
      886         buf_payment.exch-scale = 1
      887         buf_payment.pay-code = 1
      888         buf_payment.payer-type = buf_Dis-card.cli-type
      889         buf_payment.payer-code = buf_Dis-card.cli-code
      890         buf_payment.pmnt-code = string(next-value(s-pmnt-code, ub))
      891         buf_payment.ps = ''
      892         buf_payment.status_ =  'факт':U
      893         .
      894       end.
      895   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      897     (input  p-old-base-code
      898     ,input  v-today
      899     ,output v-exch-rate
      900     ,output v-exch-scale
      901     ,output v-curr-abbr
      902     )  .
      903       assign
      904       buf_payment.tot-base = buf_payment.tot-base + (if buf_dis-card.credit-card
      905                                                     then buf_dis-host.pay-tot-base
      906                                                     else (buf_dis-host.gds-tot-base - buf_dis-host.gds-dis-base)
      907                                                     )
      908       buf_payment.tot-rubl = buf_payment.tot-rubl + (if buf_dis-card.credit-card
      909                                                     then buf_dis-host.pay-tot-rubl
      910                                                     else (buf_dis-host.gds-tot-rubl - buf_dis-host.gds-dis-rubl)
      911                                                     )
      912       buf_payment.tot-cli  = (if p-old-base-code = 0 then buf_payment.tot-rubl else buf_payment.tot-base)
      913       buf_payment.tot-base = (if p-old-base-code = p-base-code then buf_payment.tot-base else buf_payment.tot-rubl / v-exch-rate * v-exch-scale)
      914       buf_payment.base-rate = (if p-old-base-code = 0 then 1 else buf_payment.tot-rubl / buf_payment.tot-base)
      915       buf_payment.exch-rate = (if p-old-base-code = 0 then 1 else buf_payment.tot-rubl / buf_payment.tot-base)
      916       .
      917   end.
      918   end procedure.
      919   procedure delete-sysconf-dc :
      920   define input parameter p-host-code as integer no-undo .
      921   define buffer buf_dis-card for ub.dis-card.
      922   define buffer buf_dis-card-property for ub.dis-card-property.
      923   define buffer buf_dis-host for ub.dis-host.
      924   define buffer buf_dis-obj for ub.dis-obj.
      925   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
      926   define buffer buf_c-dis-host for ub.c-dis-host.
      927   define buffer buf_c-dis-obj for ub.c-dis-obj.
      928   define buffer buf_dis-card-type for ub.dis-card-type.
      929   define buffer buf_dis-card-type-attr for ub.dis-card-type-attr.
      930   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
      931   define buffer buf_c-dis-dct-rule for ub.c-dis-dct-rule.
      932   define buffer buf_dis-card-mask for ub.dis-card-mask.
      933   define buffer buf_c-dis-card-type for ub.c-dis-card-type.
      934   define buffer buf_c-dis-card-type-attr for ub.c-dis-card-type-attr.
      935   define buffer buf_c-dis-card-mask for ub.c-dis-card-mask.
      936   define buffer buf_clients for ub.clients.
      937   define buffer buf_trn-doc for ub.trn-doc.
      938   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
      939   define buffer buf_c-dis-dc-rule for ub.c-dis-dc-rule.
      940   define buffer buf_hist-nws-option for ub.hist-nws-option.
      941   define buffer buf_c-hist-nws-option for ub.c-hist-nws-option.
      942   define buffer buf_rp-by-call for ub.rp-by-call.
      943   define buffer buf_c-rp-by-call for ub.c-rp-by-call.
      944   define buffer buf_rule-by-call for ub.rule-by-call.
      945   define buffer buf_c-rule-by-call for ub.c-rule-by-call.
      946   define buffer buf_rule-call-param for ub.rule-call-param.
      947   define buffer buf_c-rule-call-param for ub.c-rule-call-param.
      948   define buffer buf_prop-ref-call for ub.prop-ref-call.
      949   do
      950   on error undo, return error
      951   :
      952     find first buf_dis-card-type no-lock where
      953               buf_dis-card-type.emitent-host-code = p-host-code no-error.
      954     if not available buf_dis-card-type then return.
      955     for each buf_dis-card share-lock where
      956            buf_Dis-card.emitent-host-code = p-host-code:
      957       for each buf_Dis-card-property share-lock where
      958               buf_dis-card-property.d-card = buf_Dis-card.d-card :
      959         delete buf_dis-card-property.
      960       end.
      961       for each buf_c-Dis-card-property share-lock where
      962               buf_c-dis-card-property.d-card = buf_Dis-card.d-card :
      963         delete buf_c-dis-card-property.
      964       end.
      965       for each buf_Dis-obj share-lock where
      966               buf_dis-obj.d-card = buf_Dis-card.d-card :
      967         delete buf_dis-obj.
      968       end.
      969       for each buf_c-Dis-obj share-lock where
      970               buf_c-dis-obj.d-card = buf_Dis-card.d-card :
      971         delete buf_c-dis-obj.
      972       end.
      973       for each buf_Dis-host share-lock where
      974               buf_dis-host.d-card = buf_Dis-card.d-card :
      975         delete buf_dis-host.
      976       end.
      977       for each buf_c-Dis-host share-lock where
      978               buf_c-dis-host.d-card = buf_Dis-card.d-card :
      979         delete buf_c-dis-host.
      980       end.
      981       for each buf_dis-dc-rule share-lock where
      982               buf_dis-dc-rule.d-card = buf_Dis-card.d-card :
      983         delete buf_dis-dc-rule.
      984       end.
      985       for each buf_c-dis-dc-rule share-lock where
      986               buf_c-dis-dc-rule.d-card = buf_Dis-card.d-card :
      987         delete buf_c-dis-dc-rule.
      988       end.
      989       for each buf_clients no-lock where
      990              buf_clients.host-code = p-host-code:
      991          for each buf_trn-doc no-lock where
      992                   buf_trn-doc.obj-type = buf_Clients.obj-type
      993               and buf_trn-doc.obj-code = buf_Clients.obj-code
      994               and buf_trn-doc.cli-type = buf_dis-card.cli-type
      995               and buf_trn-doc.cli-code = buf_dis-card.cli-code:
      996            if buf_trn-doc.d-card = buf_dis-card.d-card then do:
      997              buf_trn-doc.d-card = ''.
      998            end.
      999          end.
     1000       end.
     1001       delete buf_Dis-card.
     1002     end.
     1003     for each buf_Dis-card-type share-lock where
     1004             buf_Dis-card-type.emitent-host-code = p-host-code:
     1005       for each buf_Dis-card-type-attr share-lock where
     1006               buf_Dis-card-type-attr.emitent-host-code = p-host-code
     1007           and buf_Dis-card-type-attr.type = buf_dis-card-type.type
     1008               :
     1009          delete buf_dis-card-type-attr.
     1010       end.
     1011       for each buf_Dis-card-mask share-lock where
     1012               buf_Dis-card-mask.emitent-host-code = p-host-code
     1013           and buf_Dis-card-mask.type = buf_dis-card-type.type
     1014               :
     1015          delete buf_dis-card-mask.
     1016       end.
     1017       for each buf_Dis-dct-rule share-lock where
     1018               buf_Dis-dct-rule.emitent-host-code = p-host-code
     1019           and buf_Dis-dct-rule.type = buf_dis-card-type.type
     1020               :
     1021          delete buf_dis-dct-rule.
     1022       end.
     1023       for each buf_c-Dis-dct-rule share-lock where
     1024               buf_c-Dis-dct-rule.emitent-host-code = p-host-code
     1025           and buf_c-Dis-dct-rule.type = buf_dis-card-type.type
     1026               :
     1027          delete buf_c-dis-dct-rule.
     1028       end.
     1029       for each buf_hist-nws-option share-lock where
     1030               buf_hist-nws-option.subject-group = 'c-dc-hist':U
     1031           and buf_hist-nws-option.host-code = buf_dis-card-type.emitent-host-code
     1032           and buf_hist-nws-option.charkey_one = buf_dis-card-type.type:
     1033        delete buf_hist-nws-option.
     1034       end.
     1035       for each buf_c-hist-nws-option share-lock where
     1036               buf_c-hist-nws-option.subject-group = 'c-dc-hist':U
     1037           and buf_c-hist-nws-option.host-code = buf_dis-card-type.emitent-host-code
     1038           and buf_c-hist-nws-option.charkey_one = buf_dis-card-type.type:
     1039        delete buf_c-hist-nws-option.
     1040       end.
     1041       for each  buf_rp-by-call share-lock where
     1042               buf_rp-by-call.call_id = buf_dis-card-type.uniq-key-rec:
     1043         delete buf_rp-by-call.
     1044       end.
     1045       for each  buf_c-rp-by-call share-lock where
     1046               buf_c-rp-by-call.call_id = buf_dis-card-type.uniq-key-rec:
     1047         delete buf_c-rp-by-call.
     1048       end.
     1049       for each  buf_rule-by-call share-lock where
     1050               buf_rule-by-call.call_id = buf_dis-card-type.uniq-key-rec:
     1051         delete buf_rule-by-call.
     1052       end.
     1053       for each  buf_c-rule-by-call share-lock where
     1054               buf_c-rule-by-call.call_id = buf_dis-card-type.uniq-key-rec:
     1055         delete buf_c-rule-by-call.
     1056       end.
     1057       for each  buf_rule-call-param share-lock where
     1058               buf_rule-call-param.call_id = buf_dis-card-type.uniq-key-rec:
     1059         delete buf_rule-call-param.
     1060       end.
     1061       for each  buf_c-rule-call-param share-lock where
     1062               buf_c-rule-call-param.call_id = buf_dis-card-type.uniq-key-rec:
     1063         delete buf_c-rule-call-param.
     1064       end.
     1065       for each  buf_prop-ref-call share-lock where
     1066               buf_prop-ref-call.call_id = buf_dis-card-type.uniq-key-rec:
     1067         delete buf_prop-ref-call.
     1068       end.
     1069       delete buf_dis-card-type.
     1070     end.
     1071   end.
     1072   end procedure.
     1073   procedure rename-issue-code :
     1074   define input parameter p-obj-code as integer no-undo .
     1075   define buffer buf_dis-card for ub.dis-card.
     1076   on write of ub.dis-card override do: end.
     1077   do
     1078   on error undo, return error
     1079   :
     1080     for each buf_dis-card share-lock:
     1081       if can-find(first temp-clients no-lock where
     1082                       temp-clients.obj-type = 'маг':U
     1083                   and temp-clients.obj-code = buf_dis-card.issue-code) then do:
     1084         assign
     1085         buf_dis-card.issue-code = temp-clients.new-issue-code.
     1086       end.
     1087     end.
     1088   end.
     1089   end procedure.
     1090   define temp-table tt-dis-host no-undo like ub.dis-host.
     1091   procedure create-dis-host-0 :
     1092   define input parameter p-d-card like ub.dis-card.d-card no-undo .
     1093   define input parameter p-card-num like ub.dis-card.card-num no-undo .
     1094   define buffer buf_dis-host for ub.dis-host.
     1095     do
     1096     on error undo, return error return-value
     1097     :
     1098       if available tt-dis-host then delete tt-dis-host.
     1099       create tt-dis-host.
     1100       assign
     1101       tt-dis-host.d-card = p-d-card
     1102       tt-dis-host.card-num = p-card-num
     1103       tt-dis-host.dt-code = 0
     1104       .
     1105       for each buf_Dis-host no-lock where
     1106             buf_dis-host.d-card = p-d-card
     1107         and buf_dis-host.host-code > 0
     1108         on error undo, return error
     1109         on stop undo, return error :
     1110         assign
     1111         tt-dis-host.gds-dis-base = tt-dis-host.gds-dis-base + buf_dis-host.gds-dis-base
     1112         tt-dis-host.gds-dis-rubl = tt-dis-host.gds-dis-rubl + buf_dis-host.gds-dis-rubl
     1113         tt-dis-host.gds-tot-base = tt-dis-host.gds-tot-base + buf_dis-host.gds-tot-base
     1114         tt-dis-host.gds-tot-rubl = tt-dis-host.gds-tot-rubl + buf_dis-host.gds-tot-rubl
     1115         tt-dis-host.num-chk      = tt-dis-host.num-chk      + buf_dis-host.num-chk
     1116         tt-dis-host.pay-tot-base = tt-dis-host.pay-tot-base + buf_dis-host.pay-tot-base
     1117         tt-dis-host.pay-tot-rubl = tt-dis-host.pay-tot-rubl + buf_dis-host.pay-tot-rubl
     1118         .
     1119       end.
     1120       create buf_Dis-host.
     1121       buffer-copy tt-dis-host to buf_dis-host.
     1122       release buf_dis-host.
     1123       delete tt-dis-host.
     1124     end.
     1125   end procedure.
