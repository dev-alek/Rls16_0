      461        F-level-1 AT ROW 6.27 COL 14.5 COLON-ALIGNED WIDGET-ID 72
      462        F-level-2 AT ROW 7.5 COL 14.5 COLON-ALIGNED WIDGET-ID 74
      463        tt-dis-rule.sts AT ROW 10 COL 1 NO-LABEL WIDGET-ID 42
      464             VIEW-AS RADIO-SET VERTICAL
      465             RADIO-BUTTONS
      466                       "Item 1", 0,
      467   "Item 2", 1
      468             SIZE 15.5 BY 1.87
      469        tg-has-global AT ROW 10.27 COL 74.5 WIDGET-ID 62
      470        tg-has-host AT ROW 11.27 COL 74.5 WIDGET-ID 64
