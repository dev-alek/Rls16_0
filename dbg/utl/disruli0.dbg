      472        b-del AT ROW 12.27 COL 11 WIDGET-ID 38
      473        b-chg AT ROW 12.27 COL 21 WIDGET-ID 40
      474        tt-dis-rule.value-type AT ROW 12.27 COL 45 COLON-ALIGNED WIDGET-ID 16
      475             LABEL "Тип значения"
      476             VIEW-AS COMBO-BOX INNER-LINES 5
      477             LIST-ITEM-PAIRS "Item 1",0
