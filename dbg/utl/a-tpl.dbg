        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: a-tpl.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/a-tpl.p $":U .
        8   define variable vss-description as character no-undo init "".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define temp-table x_obj-group no-undo like ub.clients  .
       80   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       81   procedure metod-gop-obj :
       82     do
       83     on error undo, return error return-value
       84     :
       85   define input  parameter p-cntxt-db-num as integer   no-undo .
       86   define input  parameter p-gop-id       as integer   no-undo .
       87   define input  parameter p-gop-db-num   as integer   no-undo .
       88   define buffer buf1_clients for ub.clients  .
       89   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
       90   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
       91   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
       92   for each  x_obj-group : delete x_obj-group. end.
       93   if p-gop-id = 0 or p-gop-id = ?  then do:
       94      if p-cntxt-db-num = 0  then do:
       95           for each buf1_clients no-lock where
       96                   (buf1_clients.obj-type = 'маг':U  or
       97                    buf1_clients.obj-type = 'скл':U  )
       98                   and
       99                   buf1_clients.db-num >= 0  and
      100                   buf1_clients.stts = 0
      101                   :
      102             create x_obj-group .
      103             assign
      104               x_obj-group.obj-code   = buf1_clients.obj-code
      105               x_obj-group.obj-type   = buf1_clients.obj-type
      106               x_obj-group.obj-name   = buf1_clients.obj-name
      107               x_obj-group.db-num     = buf1_clients.db-num
      108             .
      109           end.
      110      end.
      111      else do:
      112           for each buf1_clients no-lock where
      113                   (buf1_clients.obj-type = 'маг':U  or
      114                    buf1_clients.obj-type = 'скл':U  ) and
      115                    buf1_clients.db-num = p-cntxt-db-num  and
      116                    buf1_clients.stts = 0
      117                   :
      118             create x_obj-group .
      119             assign
      120               x_obj-group.obj-code   = buf1_clients.obj-code
      121               x_obj-group.obj-type   = buf1_clients.obj-type
      122               x_obj-group.obj-name   = buf1_clients.obj-name
      123               x_obj-group.db-num     = buf1_clients.db-num
      124             .
      125           end.
      126      end.
      127   end.
      128   else do:
      129         for each buf_db-grp-obj-price  where
      130                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      131                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      132                 buf_db-grp-obj-price.stts = 0  no-lock :
      133           for each buf1_clients no-lock where
      134                  (buf1_clients.obj-type = 'маг':U  or
      135                   buf1_clients.obj-type = 'скл':U  ) and
      136                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      137                   buf1_clients.stts = 0
      138                   :
      139             create x_obj-group .
      140             assign
      141               x_obj-group.obj-code   = buf1_clients.obj-code
      142               x_obj-group.obj-type   = buf1_clients.obj-type
      143               x_obj-group.obj-name   = buf1_clients.obj-name
      144               x_obj-group.db-num     = buf1_clients.db-num
      145             .
      146           end.
      147         end.
      148       for each buf_host-grp-obj-price where
      149               buf_host-grp-obj-price.gop-id     = p-gop-id and
      150               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      151               buf_host-grp-obj-price.stts = 0
      152               no-lock :
      153         for each buf1_clients no-lock where
      154                (buf1_clients.obj-type = 'маг':U  or
      155                 buf1_clients.obj-type = 'скл':U  ) and
      156                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      157                 buf1_clients.stts = 0
      158                 :
      159             find first x_obj-group no-lock  where
      160                       x_obj-group.obj-code   = buf1_clients.obj-code and
      161                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      162             if not available  x_obj-group then   create x_obj-group .
      163             assign
      164               x_obj-group.obj-code   = buf1_clients.obj-code
      165               x_obj-group.obj-type   = buf1_clients.obj-type
      166               x_obj-group.obj-name   = buf1_clients.obj-name
      167               x_obj-group.db-num     = buf1_clients.db-num
      168             .
      169         end.
      170       end.
      171       for each buf_obj-grp-obj-price where
      172               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      173               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      174               buf_obj-grp-obj-price.stts = 0
      175               no-lock :
      176         for each buf1_clients no-lock where
      177                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      178                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      179                   buf1_clients.stts     = 0
      180                   :
      181             find first  x_obj-group no-lock  where
      182                         x_obj-group.obj-code   = buf1_clients.obj-code and
      183                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      184             if not available  x_obj-group then   create x_obj-group .
      185             assign
      186               x_obj-group.obj-code   = buf1_clients.obj-code
      187               x_obj-group.obj-type   = buf1_clients.obj-type
      188               x_obj-group.obj-name   = buf1_clients.obj-name
      189               x_obj-group.db-num     = buf1_clients.db-num
      190             .
      191         end.
      192       end.
      193   end.
      194   end.
      195   end procedure.
      196   procedure metod-obj-in-gop :
      197   define input  parameter p-curr-db-num as integer   no-undo .
      198   define input  parameter p-obj-type as character no-undo .
      199   define input  parameter p-obj-code as integer   no-undo .
      200   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      201     do
      202     on error undo, return error return-value
      203     :
      204       empty temp-table x_grp-obj-price.
      205       for each buf_grp-obj-price where
      206                buf_grp-obj-price.stts = 0
      207                no-lock :
      208                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      209                  for each x_obj-group where
      210                           x_obj-group.obj-type = p-obj-type and
      211                           x_obj-group.obj-code = p-obj-code :
      212                       create  x_grp-obj-price.
      213                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      214                  end.
      215       end.
      216     end.
      217   end procedure.
      218   procedure metod-delobj-usr :
      219   define input  parameter p-pdf-id  as integer   no-undo .
      220   define input  parameter p-pdf-db  as integer   no-undo .
      221   define input  parameter p-plt-id  as integer   no-undo .
      222   define input  parameter p-plt-db-num as integer   no-undo .
      223   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      224     do
      225     on error undo, return error return-value
      226     :
      227   for each buf_price-doc-forming-attr no-lock  where
      228            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      229            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      230            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      231            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      232            buf_price-doc-forming-attr.attr-code begins "obj" :
      233      for each x_obj-group  where
      234               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      235               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      236        delete x_obj-group.
      237      end.
      238   end.
      239     if not can-find (first x_obj-group) then do:
      240        return "nullobj" .
      241     end.
      242   end.
      243   end procedure.
      244   procedure metod-obj-pdf :
      245   define input  parameter p-cntxt-db-num as integer   no-undo .
      246   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      247   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      248   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      249   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      250   define buffer buf_price-list-type for ub.price-list-type  .
      251   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      252     do
      253     on error undo, return error return-value
      254     :
      255    for each  x_obj-group : delete x_obj-group. end.
      256    find first buf_price-list-type no-lock where
      257               buf_price-list-type.plt-id = p-plt-id and
      258               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      259   if error-status :error then return error return-value .
      260    find first buf_price-doc-forming no-lock where
      261               buf_price-doc-forming.plt-id     = p-plt-id and
      262               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      263               buf_price-doc-forming.pdf-id     = p-pdf-id and
      264               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      265               no-error .
      266   if error-status :error then return error return-value .
      267     run metod-gop-obj in this-procedure (
      268         p-cntxt-db-num,
      269         buf_price-list-type.gop-id ,
      270         buf_price-list-type.gop-db-num
      271         ) no-error .
      272     run metod-delobj-usr in this-procedure (
      273       buf_price-doc-forming.pdf-id ,
      274       buf_price-doc-forming.pdf-db ,
      275       buf_price-doc-forming.plt-id ,
      276       buf_price-doc-forming.plt-db-num
      277       ) no-error .
      278     end.
      279   end procedure.
      280   define new global shared variable g#lib-trn  as handle no-undo .
      281   define new global shared variable g#lib-trn2 as handle no-undo .
      282   define new global shared variable g#lib-trn3 as handle no-undo .
      283   define new global shared variable g#lib-trn4 as handle no-undo .
      284   procedure proc-alt-shift-f2:
      285     if not ibs.th.gbl.gbl-var:rcode
      286   then
      287     run gbl\inidebug.p .
      288   end.
      289   procedure proc-alt-shift-f3:
      290     run gbl/prvssinf.p
      291       ( input this-procedure
      292       ) .
      293   end.
      294   define variable v-inform-launched as logical no-undo initial false .
      295   procedure proc-alt-shift-f4:
      296     define variable v-action as character no-undo .
      297     if v-inform-launched = false then do:
      298       assign
      299         v-inform-launched = true
      300       .
      301       run gbl/d-inform.w
      302         (  input self
      303         ,  input this-procedure
      304         , output v-action
      305         ) no-error .
      306       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      307       assign
      308         v-inform-launched = false
      309       .
      310     end.
      311   end.
      312   procedure proc-alt-f1:
      313     run gbl/corrhelp.p
      314       (input this-procedure
      315       ) .
      316   end .
      317   on alt-shift-f2 anywhere do:
      318     run proc-alt-shift-f2.
      319   end.
      320   on alt-shift-f3 anywhere do:
      321     run proc-alt-shift-f3 in this-procedure .
      322   end.
      323   on alt-shift-f4 anywhere do:
      324     run proc-alt-shift-f4 in this-procedure.
      325   end.
      326   on alt-f1 anywhere do:
      327     run proc-alt-f1 in this-procedure .
      328   end.
      329   define temp-table temp-obj no-undo like ub.clients
      330     field is-yes as logical
      331   .
      332   if g#db-num  <> 0 then  do:
      333    message "Утилита для ГБД" view-as alert-box information .
      334    return .
      335   end.
      336   define temp-table temp-tpl no-undo like ub.price-list-type .
      337   for each ub.price-list-type no-lock where
      338            ub.price-list-type.stts = integer('0':U) and
      339            ub.price-list-type.main = true :
      340       for each x_obj-group : delete  x_obj-group . end.
      341       run metod-gop-obj ( 0 , ub.price-list-type.gop-id , ub.price-list-type.gop-db-num ) .
      342       for each x_obj-group :
      343           find first temp-obj where
      344                      temp-obj.obj-type = x_obj-group.obj-type and
      345                      temp-obj.obj-code = x_obj-group.obj-code
      346           no-error .
      347           if  not available temp-obj then do:
      348               create temp-obj.
      349               buffer-copy x_obj-group to temp-obj .
      350           end.
      351           else do:
      352              find first temp-tpl where
      353                         temp-tpl.plt-id      = ub.price-list-type.plt-id     and
      354                         temp-tpl.plt-db-num  = ub.price-list-type.plt-db-num
      355                 no-error .
      356                 if not available temp-tpl  then do:
      357                   create temp-tpl.
      358                   buffer-copy ub.price-list-type to  temp-tpl .
      359                 end.
      360           end.
      361       end.
      362   end.
      363   for each ub.price-list-type exclusive-lock where
      364            ub.price-list-type.main = true and
      365            ub.price-list-type.stts = integer('0':U)  and
      366            ub.price-list-type.only-gbd <> integer(yes) :
      367         find first temp-tpl where
      368                    temp-tpl.plt-id      = ub.price-list-type.plt-id       and
      369                    temp-tpl.plt-db-num  = ub.price-list-type.plt-db-num
      370         no-error .
      371         if not available temp-tpl  then do:
      372            ub.price-list-type.only-gbd = integer(yes) .
      373            ub.price-list-type.ban-discnt = 0 .
      374         end.
      375   end.
      376   define variable vvv as logical   no-undo init false .
      377   if can-find (first temp-tpl ) then do:
      378      vvv = true .
      379      message "Найдены ТПЛ по которым объекты пересекаются. Они и их объекты будут выведены в файл dbltpl.txt" view-as alert-box information .
      380   end.
      381   else do:
      382      vvv = false  .
      383      message "Пересечений нет . ГТПЛ обнавлены. ОК" view-as alert-box information .
      384   end.
      385   if vvv = true  then do:
      386   define stream rpt .
      387   output stream rpt to "dbltpl.txt" .
      388   for each temp-tpl :
      389       Put stream  rpt unformatted
      390           temp-tpl.plt-id     " БД"
      391           temp-tpl.plt-db-num  " "
      392           temp-tpl.name
      393           skip.
      394       for each x_obj-group : delete  x_obj-group . end.
      395       run metod-gop-obj ( 0 , temp-tpl.gop-id , temp-tpl.gop-db-num ) .
      396       for each x_obj-group :
      397          Put stream  rpt unformatted
      398           x_obj-group.obj-type
      399           x_obj-group.obj-code
      400           skip.
      401       end.
      402   end.
      403   output stream rpt close.
      404   message "все".
      405   end.
