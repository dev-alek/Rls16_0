        1   DEFINE TEMP-TABLE temp-attr-prop NO-UNDO LIKE ub.attr-prop
        2          field upper-prop-label as character
        3          field prop-label as character
        4          .
        5   DEFINE TEMP-TABLE tt-attr-prop NO-UNDO LIKE ub.attr-prop
        6          field full-prop-name as character.
        7   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        8   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        9   define input parameter p-table-name as character no-undo .
       10   DEFINE INPUT PARAMETER p-templ-rl-root AS integer NO-UNDO.
       11   DEFINE OUTPUT PARAMETER p-rec AS RECID NO-UNDO.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Список свойств АТРИБУТА ".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     if     not mWaitFramView
      150        and mWaitProcEvent
      151     then
      152       process events .
      153     end.
      154   end procedure.
      155   procedure waitfram-show :
      156     define input  parameter p-message as character no-undo .
      157     define variable v-left-margin as integer   no-undo .
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       if length(p-message) <= 70 then do:
      163         assign
      164           v-left-margin = integer((70 - length(p-message)) / 2)
      165         .
      166         assign
      167           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      168         .
      169         assign
      170           v-waitfram-action01 = " "
      171           v-waitfram-action02 = " "
      172                                    + fill(" ", v-left-margin)
      173                                    + p-message
      174           v-waitfram-action03 = " "
      175         .
      176       end.
      177       else do:
      178         define variable vRindex1 as integer no-undo.
      179         define variable vRindex2 as integer no-undo.
      180         vRindex1 = r-index(p-message," ",70).
      181         if vRindex1 = 0
      182         then
      183            vRindex1 = 70.
      184         if length(p-message)  <= vRindex1 + 70 then do:
      185           assign
      186             v-waitfram-action01 = " "
      187             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      189           .
      190         end.
      191         else do:
      192           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      193           if vRindex2 <= vRindex1
      194           then
      195              vRindex2 = vRindex1 + 70.
      196           assign
      197             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      200           .
      201         end.
      202       end.
      203       B-viewProcInfo:visible   in frame waitfram = no.
      204       B-viewProcInfo:sensitive in frame waitfram = no.
      205       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       if  (   mWaitFramView
      208          or  mWaitProcEvent)
      209          and not mBatchMode
      210       then
      211          display
      212             v-waitfram-action01 skip
      213             v-waitfram-action02 skip
      214             v-waitfram-action03 skip
      215          with frame waitfram .
      216       if     mWaitFramView
      217          then do:
      218             if     mWaitFramInterval ne ?
      219                and not mBatchMode
      220             then
      221                wait-for go of frame waitfram pause mWaitFramInterval.
      222          end.
      223          else
      224             if     mWaitProcEvent
      225                and not mBatchMode
      226             then
      227                process events .
      228     end.
      229   end procedure.
      230      procedure waitfram-show-this:
      231         define input  parameter iInterval as int64 no-undo.
      232         define variable vtime as int64 no-undo.
      233         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      234         mWaitFramInterval = iInterval.
      235         run waitfram-show (substitute("&1&2 &3&4" ,
      236                                       mWaitFramTextBeg ,
      237                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      238                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      239                                       mWaitFramTextEnd
      240                                      )
      241                           ).
      242      end.
      243      procedure WaitFramRunPause:
      244         define input  parameter iInterval as dec no-undo.
      245         define variable vStart  as datetime-tz no-undo.
      246         define variable vend    as datetime-tz no-undo.
      247         define variable vint as int64 no-undo.
      248         define variable vOk as logical no-undo.
      249         vStart = now.
      250         vend   = vStart.
      251         publish "WaitFramPause" (iInterval,output vOk).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and (   vint > 0
      257                 or (    not vOk
      258                     and iInterval eq ?
      259                     )
      260                 )
      261         then
      262            run waitfram-show-this (iInterval).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and vint > 0
      268         then do:
      269            run gbl/pause.p (vint * 1000).
      270         end.
      271         if iInterval ne ?
      272         then
      273            publish "WaitFramStop".
      274         waitfram-check-timeout().
      275      end.
      276      procedure WaitFramWaitFor:
      277         define input  parameter iInterval as dec no-undo.
      278         assign
      279            mWaitFramStartProc   = now
      280            mWaitFramStopUser    = no
      281            mWaitFramStopTimeOut = no
      282         .
      283         block-wait:
      284         do while not mWaitFramStop:
      285            run WaitFramRunPause (iInterval).
      286            if  waitfram-check-timeout()
      287            then do:
      288               leave block-wait.
      289            end.
      290         end.
      291         run waitfram-hide.
      292      end.
      293   procedure waitfram-join :
      294     define input  parameter p-line-1  as character no-undo .
      295     define input  parameter p-line-2  as character no-undo .
      296     define input  parameter p-line-3  as character no-undo .
      297     define output parameter p-message as character no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       assign
      302         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      305       .
      306     end.
      307   end procedure.
      308   function waitfram-join-function returns character
      309     (input p-line-1 as character
      310     ,input p-line-2 as character
      311     ,input p-line-3 as character
      312     ).
      313     define variable v-message as character no-undo .
      314     run waitfram-join in this-procedure
      315       (input  p-line-1
      316       ,input  p-line-2
      317       ,input  p-line-3
      318       ,output v-message
      319       ) .
      320     return v-message .
      321   end function .
      322   define new global shared variable g#language as character no-undo .
      323   if g#language <> '' and g#language <> 'rus':U then do:
      324     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      325   end.
      326   procedure proc-alt-shift-f2:
      327     if not ibs.th.gbl.gbl-var:rcode
      328   then
      329     run gbl\inidebug.p .
      330   end.
      331   procedure proc-alt-shift-f3:
      332     run gbl/prvssinf.p
      333       ( input this-procedure
      334       ) .
      335   end.
      336   define variable v-inform-launched as logical no-undo initial false .
      337   procedure proc-alt-shift-f4:
      338     define variable v-action as character no-undo .
      339     if v-inform-launched = false then do:
      340       assign
      341         v-inform-launched = true
      342       .
      343       run gbl/d-inform.w
      344         (  input self
      345         ,  input this-procedure
      346         , output v-action
      347         ) no-error .
      348       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      349       assign
      350         v-inform-launched = false
      351       .
      352     end.
      353   end.
      354   procedure proc-alt-f1:
      355     run gbl/corrhelp.p
      356       (input this-procedure
      357       ) .
      358   end .
      359   on alt-shift-f2 anywhere do:
      360     run proc-alt-shift-f2.
      361   end.
      362   on alt-shift-f3 anywhere do:
      363     run proc-alt-shift-f3 in this-procedure .
      364   end.
      365   on alt-shift-f4 anywhere do:
      366     run proc-alt-shift-f4 in this-procedure.
      367   end.
      368   on alt-f1 anywhere do:
      369     run proc-alt-f1 in this-procedure .
      370   end.
      371   DEFINE BUTTON b-add
      372        LABEL "&Добавить"
      373        SIZE 10 BY 1.
      374   DEFINE BUTTON b-chg
      375        LABEL "&Изменить"
      376        SIZE 10 BY 1.
      377   DEFINE BUTTON b-del
      378        LABEL "&Удалить"
      379        SIZE 10 BY 1.
      380   DEFINE BUTTON B-exit AUTO-GO
      381        LABEL "&Ввод"
      382        SIZE 10 BY 1
      383        BGCOLOR 8 .
      384   DEFINE BUTTON B-Help
      385        LABEL "Помо&щь"
      386        SIZE 3 BY 1
      387        BGCOLOR 8 .
      388   DEFINE BUTTON b-quit AUTO-END-KEY
      389        LABEL "&Отмена"
      390        SIZE 10 BY 1
      391        BGCOLOR 8 .
      392   DEFINE QUERY br-attr-prop FOR
      393         tt-attr-prop SCROLLING.
      394   DEFINE BROWSE br-attr-prop
      395     QUERY br-attr-prop NO-LOCK DISPLAY
      396         tt-attr-prop.node-code COLUMN-LABEL "код" FORMAT ">>9"
      397         tt-attr-prop.full-prop-name COLUMN-LABEL "Свойство" FORMAT "X(255)" WIDTH 40
      398   tt-attr-prop.property-value COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 58
      399       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 19 FIT-LAST-COLUMN.
      400   DEFINE FRAME Dialog-Frame
      401        B-exit AT ROW 1 COL 1
      402        b-quit AT ROW 1 COL 11
      403        b-add AT ROW 1 COL 41 WIDGET-ID 36
      404        b-del AT ROW 1 COL 51 WIDGET-ID 38
      405        b-chg AT ROW 1 COL 61 WIDGET-ID 40
      406        B-Help AT ROW 1 COL 95
      407        br-attr-prop AT ROW 3 COL 1 WIDGET-ID 100
      408        SPACE(0.70) SKIP(1.22)
      409       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      410            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      411            TITLE ""
      412            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      413   ASSIGN
      414          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      415          FRAME Dialog-Frame:HIDDEN           = TRUE.
      416   ON GO OF FRAME Dialog-Frame
      417   DO:
      418       RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      419     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      420   END.
      421   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      422   DO:
      423     APPLY "END-ERROR":U TO SELF.
      424   END.
      425   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      426   DO:
      427     define variable v-node-code as integer   no-undo .
      428     RUN proc-b-add IN THIS-PROCEDURE ( output v-node-code) NO-ERROR.
      429     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      430     if not available tt-attr-prop or v-node-code = ? then return no-apply.
      431     run proc-b-chg in this-procedure no-error .
      432     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      433   END.
      434   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      435   DO:
      436     IF NOT AVAILABLE tt-attr-prop THEN RETURN NO-APPLY.
      437     RUN proc-b-chg IN THIS-PROCEDURE NO-ERROR.
      438   END.
      439   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      440   DO:
      441     IF NOT AVAILABLE tt-attr-prop THEN RETURN NO-APPLY.
      442     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
      443     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      444   END.
      445   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      446   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      447   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   on help of frame Dialog-Frame
      449   do:
      450     run gbl/app_help.p
      451       (input this-procedure :file-name
      452       ,input ''
      453       ,input ?
      454       ) no-error.
      455     if error-status :error then do:
      456       message
      457         "Ошибка при вызове помощи"
      458         error-status :get-message(1)
      459         view-as alert-box .
      460     end.
      461   end.
      462   run minbtn-set in this-procedure .
      463   on choose of b-help in frame Dialog-Frame
      464   do:
      465     apply "help":u to frame Dialog-Frame .
      466   end.
      467   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      468   procedure minbtn-set :
      469       do
      470           on error undo, return error return-value
      471           :
      472           define variable ii              as integer       no-undo .
      473           define variable fh              as widget-handle no-undo .
      474           define variable hh              as widget-handle no-undo .
      475           define variable v-h             as handle        extent 4 no-undo .
      476           define variable v-name-button   as character     no-undo .
      477           define variable v-help-old-x    as decimal       no-undo .
      478           define variable v-help-old-y    as decimal       no-undo .
      479           define variable v-help-old-size as decimal       no-undo .
      480           define variable v-frame-width   as decimal       no-undo .
      481           define variable jj              as integer       no-undo .
      482           do
      483               on error undo, return error
      484               :
      485               assign
      486                   v-frame-width = frame Dialog-Frame:width - 0.3
      487                   fh            = frame Dialog-Frame:first-child
      488                   hh            = fh:first-child
      489                   ii            = 1
      490                   .
      491               do while valid-handle(hh):
      492                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      493                   do:
      494                       case lc(hh:name) :
      495                           when "b-help" then
      496                               do:
      497                                   hh:load-image-up("cmp/b-help.bmp":u) .
      498                                   hh:load-image-down("cmp/b-help.bmp":u) .
      499                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      500                                   hh:TOOLTIP = "Помощь" .
      501                                   v-help-old-x = hh:column .
      502                                   v-help-old-y = hh:row    .
      503                                   v-help-old-size = hh:width .
      504                                   hh:width-chars = 2.5 .
      505                               end.
      506                           when "b-print" then
      507                               do:
      508                                   hh:load-image("cmp/b-print.bmp":u) .
      509                                   hh:TOOLTIP = "Печать" .
      510                                   v-h[ii] = hh:handle .
      511                                   ii = ii + 1 .
      512                                   hh:width-chars = 3 .
      513                               end.
      514                           when "b-history" or
      515                           when "b-hist" then
      516                               do:
      517                                   hh:load-image("cmp/b-hist.bmp":u) .
      518                                   hh:TOOLTIP = "История" .
      519                                   v-h[ii] = hh:handle .
      520                                   ii = ii + 1 .
      521                                   hh:width-chars = 3 .
      522                               end.
      523                           when "b-sch" then
      524                               do:
      525                                   hh:load-image("cmp/b-sch.bmp":u) .
      526                                   hh:TOOLTIP = "Установка Фильтра" .
      527                                   v-h[ii] = hh:handle .
      528                                   ii = ii + 1 .
      529                                   hh:width-chars = 3 .
      530                               end.
      531                           when "b-hist-user" then
      532                               do:
      533                                   hh:load-image("cmp/b-hist.bmp":u) .
      534                                   hh:TOOLTIP = "История пользователя" .
      535                                   ii = ii + 1 .
      536                               end.
      537                       end case.
      538                   end.
      539                   hh = hh:next-sibling.
      540               end.
      541               b-help:column = v-frame-width - b-help:width-chars.
      542               jj = 0.
      543               repeat ii = 4 to 1 by -1 :
      544                   if valid-handle (v-h[ii] ) then
      545                   do:
      546                       jj  = jj + 1 .
      547                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      548                       v-h[ii]:row    = v-help-old-y .
      549                   end.
      550               end.
      551           end.
      552       end.
      553   end procedure.
      554   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      555   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      556   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      557   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      558   define variable v-diasize-current-frame-width  as decimal   no-undo .
      559   define variable v-diasize-current-frame-height as decimal   no-undo .
      560   define variable v-diasize-change-size          as logical   no-undo .
      561   define variable v-diasize-resize-button        as handle    no-undo .
      562   define variable v-diasize-wndmax               as logical   no-undo .
      563   define variable v-diasize-wndstore             as logical   no-undo .
      564   define variable v-diasize-proc-name            as character no-undo .
      565   define variable v-diasize-browse-handle        as handle    no-undo .
      566   define variable v-diasize-browse-number        as integer   no-undo .
      567   define variable v-diasize-need-full-display    as logical   no-undo init false .
      568   define temp-table temp-diasize-handle no-undo
      569     field handle-value  as handle
      570     field save-position as decimal
      571     index xpk is primary unique handle-value
      572     .
      573   define temp-table temp-browse-handle no-undo
      574     field browse-type   as character
      575     field browse-number as integer
      576     field browse-handle as handle
      577     field original-size as decimal
      578     index xpk is primary unique browse-type browse-number
      579     index xie browse-type browse-handle
      580   .
      581   procedure diasize_change-height :
      582     define input  parameter p-change-value  as decimal   no-undo .
      583     define input  parameter p-move-resize   as logical   no-undo .
      584     define variable v-field-group-handle    as handle    no-undo .
      585     define variable v-object-handle         as handle    no-undo .
      586     define variable v-frame-height          as decimal   no-undo .
      587     define variable v-frame-virtual-height  as decimal   no-undo .
      588     define variable v-browse-height         as decimal   no-undo .
      589     define variable v-window-height         as decimal   no-undo .
      590     define variable v-window-virtual-height as decimal   no-undo .
      591     define variable v-change-sign           as integer   no-undo .
      592     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      593     define buffer buf_temp-browse-handle  for temp-browse-handle .
      594     if p-change-value > 0
      595     then do:
      596       if frame Dialog-Frame :height + p-change-value
      597           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      598       then do:
      599         assign
      600           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      601                           - (frame Dialog-Frame :height-chars)
      602         .
      603         if p-change-value <= 0
      604         then do:
      605           run diasize_position-resize-button in this-procedure .
      606           return .
      607         end.
      608       end.
      609     end.
      610     if p-change-value < 0
      611     then do:
      612       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      613       then do:
      614         assign
      615           p-change-value = v-diasize-orig-frame-height
      616                          - (frame Dialog-Frame :height-chars)
      617         .
      618         if p-change-value >= 0
      619         then do:
      620           run diasize_position-resize-button in this-procedure .
      621           return .
      622         end.
      623       end.
      624     end.
      625     if p-change-value >= 0
      626     then do:
      627       assign
      628         v-change-sign = 1
      629       .
      630     end.
      631     else do:
      632       assign
      633         v-change-sign = -1
      634       .
      635     end.
      636     assign
      637       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      638     .
      639     if p-change-value = 0
      640     then do:
      641       run diasize_position-resize-button in this-procedure .
      642       return .
      643     end.
      644     move_block:
      645     do
      646     on error undo move_block, retry move_block
      647     :
      648       if retry
      649       then do:
      650         do
      651         on error undo move_block, leave move_block
      652         :
      653           if p-change-value > 0
      654           then do:
      655             for each buf_temp-diasize-handle
      656             on error undo, next
      657             :
      658               assign
      659                 v-object-handle = buf_temp-diasize-handle.handle-value
      660               .
      661               if v-object-handle <> v-diasize-resize-button
      662               then do:
      663                 assign
      664                   v-object-handle :row = buf_temp-diasize-handle.save-position
      665                 .
      666               end.
      667             end.
      668             assign
      669               v-diasize-browse-handle :height = v-browse-height
      670             .
      671             for each buf_temp-browse-handle
      672               where buf_temp-browse-handle.browse-type = 'height':u
      673             on error undo, next
      674             :
      675               assign
      676                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      677               .
      678             end.
      679             assign
      680               frame Dialog-Frame :height = v-frame-height
      681             .
      682             if frame Dialog-Frame :scrollable = true
      683             then do:
      684               assign
      685                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      686               .
      687             end.
      688             run diasize_position-resize-button in this-procedure .
      689           end.
      690           else do:
      691             if frame Dialog-Frame :scrollable = true
      692             then do:
      693               assign
      694                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      695               .
      696             end.
      697             assign
      698               frame Dialog-Frame :height = v-frame-height
      699             .
      700             assign
      701               v-diasize-browse-handle :height = v-browse-height
      702             .
      703             for each buf_temp-browse-handle
      704               where buf_temp-browse-handle.browse-type = 'height':u
      705             on error undo, next
      706             :
      707               assign
      708                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      709               .
      710             end.
      711             for each buf_temp-diasize-handle
      712             on error undo, next
      713             :
      714               assign
      715                 v-object-handle = buf_temp-diasize-handle.handle-value
      716               .
      717               if v-object-handle <> v-diasize-resize-button
      718               then do:
      719                 assign
      720                   v-object-handle :row = buf_temp-diasize-handle.save-position
      721                 .
      722               end.
      723             end.
      724             run diasize_position-resize-button in this-procedure .
      725           end.
      726           assign
      727             v-diasize-change-size = false
      728           .
      729           leave move_block .
      730         end.
      731       end.
      732       assign
      733         v-diasize-need-full-display = true
      734       .
      735       if v-diasize-change-size = false
      736       then do:
      737         assign
      738           v-diasize-change-size = true
      739         .
      740       end.
      741       else do:
      742         return .
      743       end.
      744       assign
      745         v-frame-height = frame Dialog-Frame :height
      746         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      747         v-browse-height = v-diasize-browse-handle :height
      748       .
      749       for each buf_temp-browse-handle
      750         where buf_temp-browse-handle.browse-type = 'height':u
      751       :
      752         assign
      753           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      754         .
      755       end.
      756       for each buf_temp-diasize-handle
      757       :
      758         delete buf_temp-diasize-handle .
      759       end.
      760       assign
      761         v-field-group-handle = frame Dialog-Frame :first-child
      762       .
      763       do while valid-handle(v-field-group-handle)
      764       :
      765         assign
      766           v-object-handle = v-field-group-handle :first-child
      767         .
      768         do while valid-handle(v-object-handle)
      769         :
      770           if  v-object-handle <> v-diasize-browse-handle :handle
      771           and can-query(v-object-handle, "row")
      772           and can-query(v-object-handle, "height")
      773           and ( v-object-handle :row > v-diasize-browse-handle :row )
      774           then do:
      775             find first buf_temp-browse-handle
      776               where buf_temp-browse-handle.browse-type   = 'height':u
      777                 and buf_temp-browse-handle.browse-handle = v-object-handle
      778               no-error .
      779             if available buf_temp-browse-handle
      780             then do:
      781             end.
      782             else do:
      783               create buf_temp-diasize-handle .
      784               assign
      785                 buf_temp-diasize-handle.handle-value  = v-object-handle
      786                 buf_temp-diasize-handle.save-position = v-object-handle :row
      787               .
      788             end.
      789           end.
      790           assign
      791             v-object-handle = v-object-handle :next-sibling
      792           .
      793         end.
      794         assign
      795           v-field-group-handle = v-field-group-handle :next-sibling
      796         .
      797       end.
      798       do with frame Dialog-Frame
      799       :
      800         hide v-diasize-resize-button .
      801         assign
      802           v-diasize-resize-button :row    = 1
      803           v-diasize-resize-button :column = 1
      804         .
      805       end.
      806       if p-change-value > 0
      807       then do:
      808         if frame Dialog-Frame :scrollable = true
      809         then do:
      810           assign
      811             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      812             no-error .
      813           if error-status :error
      814           or error-status :get-message(1) <> ""
      815           then do:
      816             undo move_block, retry move_block .
      817           end.
      818         end.
      819         assign
      820           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      821           no-error .
      822         if error-status :error
      823         or error-status :get-message(1) <> ""
      824         then do:
      825           undo move_block, retry move_block .
      826         end.
      827         assign
      828           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      829           no-error .
      830         if error-status :error
      831         or error-status :get-message(1) <> ""
      832         then do:
      833           undo move_block, retry move_block .
      834         end.
      835         for each buf_temp-browse-handle
      836           where buf_temp-browse-handle.browse-type = 'height':u
      837         on error undo move_block, retry move_block
      838         :
      839           assign
      840             buf_temp-browse-handle.browse-handle :height
      841               = buf_temp-browse-handle.browse-handle :height + p-change-value
      842             no-error .
      843           if error-status :error
      844           or error-status :get-message(1) <> ""
      845           then do:
      846             undo move_block, retry move_block .
      847           end.
      848         end.
      849         for each buf_temp-diasize-handle
      850         on error undo move_block, retry move_block
      851         :
      852           assign
      853             v-object-handle = buf_temp-diasize-handle.handle-value
      854           .
      855           if v-object-handle <> v-diasize-resize-button
      856           then do:
      857             assign
      858               v-object-handle :row = v-object-handle :row + p-change-value
      859               no-error .
      860             if error-status :error
      861             or error-status :get-message(1) <> ""
      862             then do:
      863               undo move_block, retry move_block .
      864             end.
      865           end.
      866         end.
      867       end.
      868       else do:
      869         for each buf_temp-diasize-handle
      870         on error undo move_block, retry move_block
      871         :
      872           assign
      873             v-object-handle = buf_temp-diasize-handle.handle-value
      874           .
      875           if v-object-handle <> v-diasize-resize-button
      876           then do:
      877             assign
      878               v-object-handle :row = v-object-handle :row + p-change-value
      879               no-error .
      880             if error-status :error
      881             or error-status :get-message(1) <> ""
      882             then do:
      883               undo move_block, retry move_block .
      884             end.
      885           end.
      886         end.
      887         assign
      888           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      889           no-error .
      890         if error-status :error
      891         or error-status :get-message(1) <> ""
      892         then do:
      893           undo move_block, retry move_block .
      894         end.
      895         for each buf_temp-browse-handle
      896           where buf_temp-browse-handle.browse-type = 'height':u
      897         on error undo move_block, retry move_block
      898         :
      899           assign
      900             buf_temp-browse-handle.browse-handle :height
      901               = buf_temp-browse-handle.browse-handle :height + p-change-value
      902             no-error .
      903           if error-status :error
      904           or error-status :get-message(1) <> ""
      905           then do:
      906             undo move_block, retry move_block .
      907           end.
      908         end.
      909         assign
      910           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      911           no-error .
      912         if error-status :error
      913         or error-status :get-message(1) <> ""
      914         then do:
      915           undo move_block, retry move_block .
      916         end.
      917         if frame Dialog-Frame :scrollable = true
      918         then do:
      919           assign
      920             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      921             no-error .
      922           if error-status :error
      923           or error-status :get-message(1) <> ""
      924           then do:
      925             undo move_block, retry move_block .
      926           end.
      927         end.
      928       end.
      929       if p-move-resize = true
      930       then do:
      931         run diasize_position-resize-button in this-procedure .
      932       end.
      933       if v-diasize-wndstore = true
      934       then do:
      935         if connected("ub") = true
      936         then do:
      937           define variable v-cntxt-db-num        as integer   no-undo .
      938           define variable v-cntxt-userid        as character no-undo .
      939           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      940                                             , OUTPUT v-cntxt-userid
      941                                             ) .
      942           run gbl/wndsizew.p
      943             (input  v-cntxt-db-num
      944             ,input  v-cntxt-userid
      945             ,input  v-diasize-proc-name
      946             ,input  'height':u
      947             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      948             ) .
      949         end.
      950       end.
      951     end.
      952     assign
      953       v-diasize-change-size = false
      954     .
      955   end procedure.
      956   procedure diasize_set-height :
      957     define input  parameter p-new-height  as decimal   no-undo .
      958     define input  parameter p-move-resize as logical   no-undo .
      959     do
      960     on error undo, return error return-value
      961     :
      962       run diasize_change-height in this-procedure
      963         (input  (p-new-height - frame Dialog-Frame :height)
      964         ,input  p-move-resize
      965         ) .
      966     end.
      967   end procedure.
      968   procedure diasize_change-width :
      969     define input  parameter p-change-value as decimal   no-undo .
      970     define input  parameter p-move-resize  as logical   no-undo .
      971     define variable v-field-group-handle   as handle    no-undo .
      972     define variable v-object-handle        as handle    no-undo .
      973     define variable v-frame-width          as decimal   no-undo .
      974     define variable v-frame-virtual-width  as decimal   no-undo .
      975     define variable v-browse-width         as decimal   no-undo .
      976     define variable v-window-width         as decimal   no-undo .
      977     define variable v-window-virtual-width as decimal   no-undo .
      978     define variable v-change-sign          as integer   no-undo .
      979     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      980     define buffer buf_temp-browse-handle  for temp-browse-handle .
      981     if p-change-value > 0
      982     then do:
      983       if frame Dialog-Frame :width + p-change-value >
      984           session :width-chars
      985       then do:
      986         assign
      987           p-change-value = session :width-chars - frame Dialog-Frame :width
      988         .
      989         if p-change-value <= 0
      990         then do:
      991           run diasize_position-resize-button in this-procedure .
      992           return .
      993         end.
      994       end.
      995     end.
      996     if p-change-value < 0
      997     then do:
      998       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      999       then do:
     1000         assign
     1001           p-change-value = v-diasize-orig-frame-width
     1002                          - frame Dialog-Frame :width
     1003         .
     1004         if p-change-value >= 0
     1005         then do:
     1006           run diasize_position-resize-button in this-procedure .
     1007           return .
     1008         end.
     1009       end.
     1010     end.
     1011     if p-change-value >= 0
     1012     then do:
     1013       assign
     1014         v-change-sign = 1
     1015       .
     1016     end.
     1017     else do:
     1018       assign
     1019         v-change-sign = -1
     1020       .
     1021     end.
     1022     assign
     1023       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1024     .
     1025     if p-change-value = 0
     1026     then do:
     1027       run diasize_position-resize-button in this-procedure .
     1028       return .
     1029     end.
     1030     move_block:
     1031     do
     1032     on error undo move_block, leave move_block
     1033     :
     1034       if retry
     1035       then do:
     1036         do
     1037         on error undo move_block, leave move_block
     1038         :
     1039           if p-change-value > 0
     1040           then do:
     1041             for each buf_temp-diasize-handle
     1042             on error undo, next
     1043             :
     1044               assign
     1045                 v-object-handle = buf_temp-diasize-handle.handle-value
     1046               .
     1047               if v-object-handle <> v-diasize-resize-button
     1048               then do:
     1049                 assign
     1050                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1051                 .
     1052               end.
     1053             end.
     1054             assign
     1055               v-diasize-browse-handle :width = v-browse-width
     1056             .
     1057             for each buf_temp-browse-handle
     1058               where buf_temp-browse-handle.browse-type = 'width':u
     1059             on error undo, next
     1060             :
     1061               assign
     1062                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1063               .
     1064             end.
     1065             assign
     1066               frame Dialog-Frame :width = v-frame-width
     1067             .
     1068             if frame Dialog-Frame :scrollable = true
     1069             then do:
     1070               assign
     1071                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1072               .
     1073             end.
     1074             run diasize_position-resize-button in this-procedure .
     1075           end.
     1076           else do:
     1077             if frame Dialog-Frame :scrollable = true
     1078             then do:
     1079               assign
     1080                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1081               .
     1082             end.
     1083             assign
     1084               frame Dialog-Frame :width = v-frame-width
     1085             .
     1086             for each buf_temp-browse-handle
     1087               where buf_temp-browse-handle.browse-type = 'width':u
     1088             on error undo, next
     1089             :
     1090               assign
     1091                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1092               .
     1093             end.
     1094             assign
     1095               v-diasize-browse-handle :width = v-browse-width
     1096             .
     1097             for each buf_temp-diasize-handle
     1098             on error undo, next
     1099             :
     1100               assign
     1101                 v-object-handle = buf_temp-diasize-handle.handle-value
     1102               .
     1103               if v-object-handle <> v-diasize-resize-button
     1104               then do:
     1105                 assign
     1106                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1107                 .
     1108               end.
     1109             end.
     1110             run diasize_position-resize-button in this-procedure .
     1111           end.
     1112           assign
     1113             v-diasize-change-size = false
     1114           .
     1115           leave move_block .
     1116         end.
     1117       end.
     1118       assign
     1119         v-diasize-need-full-display = true
     1120       .
     1121       if v-diasize-change-size = false
     1122       then do:
     1123         assign
     1124           v-diasize-change-size = true
     1125         .
     1126       end.
     1127       else do:
     1128         return .
     1129       end.
     1130       assign
     1131         v-frame-width = frame Dialog-Frame :width
     1132         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1133         v-browse-width = v-diasize-browse-handle :width
     1134       .
     1135       for each buf_temp-browse-handle
     1136         where buf_temp-browse-handle.browse-type = 'width':u
     1137       :
     1138         assign
     1139           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1140         .
     1141       end.
     1142       for each buf_temp-diasize-handle
     1143       :
     1144         delete buf_temp-diasize-handle .
     1145       end.
     1146       assign
     1147         v-field-group-handle = frame Dialog-Frame :first-child
     1148       .
     1149       do while valid-handle(v-field-group-handle)
     1150       :
     1151         assign
     1152           v-object-handle = v-field-group-handle :first-child
     1153         .
     1154         do while valid-handle(v-object-handle)
     1155         :
     1156           if  v-object-handle <> v-diasize-browse-handle :handle
     1157           and v-object-handle <> v-diasize-resize-button
     1158           and can-query(v-object-handle, "row")
     1159           and can-query(v-object-handle, "height")
     1160           and ( v-object-handle :col + v-object-handle :width
     1161                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1162               )
     1163           then do:
     1164             find first buf_temp-browse-handle
     1165               where buf_temp-browse-handle.browse-type   = 'width':u
     1166                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1167               no-error .
     1168             if available buf_temp-browse-handle
     1169             then do:
     1170             end.
     1171             else do:
     1172               create buf_temp-diasize-handle .
     1173               assign
     1174                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1175                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1176               .
     1177             end.
     1178           end.
     1179           assign
     1180             v-object-handle = v-object-handle :next-sibling
     1181           .
     1182         end.
     1183         assign
     1184           v-field-group-handle = v-field-group-handle :next-sibling
     1185         .
     1186       end.
     1187       do with frame Dialog-Frame
     1188       :
     1189         hide v-diasize-resize-button .
     1190         v-diasize-resize-button :row = 1.
     1191         v-diasize-resize-button :column = 1.
     1192       end.
     1193       if p-change-value > 0
     1194       then do:
     1195         if frame Dialog-Frame :scrollable = true
     1196         then do:
     1197           assign
     1198             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1199             no-error .
     1200           if error-status :error
     1201           or error-status :get-message(1) <> ""
     1202           then do:
     1203             undo move_block, retry move_block.
     1204           end.
     1205         end.
     1206         assign
     1207           frame Dialog-Frame :width = v-frame-width + p-change-value
     1208           no-error .
     1209         if error-status :error
     1210         or error-status :get-message(1) <> ""
     1211         then do:
     1212           undo move_block, retry move_block.
     1213         end.
     1214         assign
     1215           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1216         no-error .
     1217         if error-status :error
     1218         or error-status :get-message(1) <> ""
     1219         then do:
     1220           undo move_block, retry move_block.
     1221         end.
     1222         for each buf_temp-browse-handle
     1223           where buf_temp-browse-handle.browse-type = 'width':u
     1224         on error undo move_block, retry move_block
     1225         :
     1226           assign
     1227             buf_temp-browse-handle.browse-handle :width
     1228               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1229             no-error .
     1230           if error-status :error
     1231           or error-status :get-message(1) <> ""
     1232           then do:
     1233             undo move_block, retry move_block .
     1234           end.
     1235         end.
     1236         for each buf_temp-diasize-handle
     1237         on error undo move_block, retry move_block
     1238         :
     1239           assign
     1240             v-object-handle = buf_temp-diasize-handle.handle-value
     1241           .
     1242           if v-object-handle <> v-diasize-resize-button
     1243           then do:
     1244             assign
     1245               v-object-handle :col = v-object-handle :col + p-change-value
     1246               no-error .
     1247             if error-status :error
     1248             or error-status :get-message(1) <> ""
     1249             then do:
     1250               undo move_block, retry move_block .
     1251             end.
     1252           end.
     1253         end.
     1254       end.
     1255       else do:
     1256         for each buf_temp-diasize-handle
     1257         on error undo move_block, retry move_block
     1258         :
     1259           assign
     1260             v-object-handle = buf_temp-diasize-handle.handle-value
     1261           .
     1262           if v-object-handle <> v-diasize-resize-button
     1263           then do:
     1264             assign
     1265               v-object-handle :col = v-object-handle :col + p-change-value
     1266               no-error .
     1267             if error-status :error
     1268             or error-status :get-message(1) <> ""
     1269             then do:
     1270               undo move_block, retry move_block .
     1271             end.
     1272           end.
     1273         end.
     1274         for each buf_temp-browse-handle
     1275           where buf_temp-browse-handle.browse-type = 'width':u
     1276         on error undo move_block, retry move_block
     1277         :
     1278           assign
     1279             buf_temp-browse-handle.browse-handle :width
     1280               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1281             no-error .
     1282           if error-status :error
     1283           or error-status :get-message(1) <> ""
     1284           then do:
     1285             undo move_block, retry move_block .
     1286           end.
     1287         end.
     1288         assign
     1289           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1290           no-error .
     1291         if error-status :error
     1292         or error-status :get-message(1) <> ""
     1293         then do:
     1294           undo move_block, retry move_block.
     1295         end.
     1296         assign
     1297           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1298         no-error .
     1299         if error-status :error
     1300         or error-status :get-message(1) <> ""
     1301         then do:
     1302           undo move_block, retry move_block.
     1303         end.
     1304         if frame Dialog-Frame :scrollable = true
     1305         then do:
     1306           assign
     1307             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1308           no-error .
     1309           if error-status :error
     1310           or error-status :get-message(1) <> ""
     1311           then do:
     1312             undo move_block, retry move_block.
     1313           end.
     1314         end.
     1315       end.
     1316       if p-move-resize
     1317       then do:
     1318         run diasize_position-resize-button in this-procedure .
     1319       end.
     1320       if v-diasize-wndstore = true
     1321       then do:
     1322         if connected("ub") = true
     1323         then do:
     1324           define variable v-cntxt-db-num        as integer   no-undo .
     1325           define variable v-cntxt-userid        as character no-undo .
     1326           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1327                                             , OUTPUT v-cntxt-userid
     1328                                             ) .
     1329           run gbl/wndsizew.p
     1330             (input  v-cntxt-db-num
     1331             ,input  v-cntxt-userid
     1332             ,input  v-diasize-proc-name
     1333             ,input  'width':u
     1334             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1335             ) .
     1336         end.
     1337       end.
     1338     end.
     1339     assign
     1340       v-diasize-change-size = false
     1341     .
     1342   end procedure.
     1343   procedure diasize_set-width :
     1344     define input  parameter p-new-width  as decimal   no-undo .
     1345     define input  parameter p-move-resize as logical   no-undo .
     1346     do
     1347     on error undo, return error return-value
     1348     :
     1349       run diasize_change-width in this-procedure
     1350         (input  (p-new-width - frame Dialog-Frame :width)
     1351         ,input  p-move-resize
     1352         ) .
     1353     end.
     1354   end procedure.
     1355   procedure diasize_position-resize-button :
     1356     do with frame Dialog-Frame
     1357     :
     1358       hide v-diasize-resize-button .
     1359       assign
     1360         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1361                     - 1
     1362                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1363         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1364                     - 1
     1365                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1366       .
     1367       view v-diasize-resize-button .
     1368     end.
     1369   end procedure.
     1370   on alt-right anywhere
     1371   do:
     1372     run diasize_change-width in this-procedure
     1373       (input 1
     1374       ,input true
     1375       ) .
     1376     return no-apply .
     1377   end.
     1378   on alt-left anywhere
     1379   do:
     1380     run diasize_change-width in this-procedure
     1381       (input -1
     1382       ,input true
     1383       ) .
     1384     return no-apply .
     1385   end.
     1386   on alt-down anywhere
     1387   do:
     1388     run diasize_change-height in this-procedure
     1389       (input 1
     1390       ,input true
     1391       ) .
     1392     return no-apply .
     1393   end.
     1394   on alt-up anywhere
     1395   do:
     1396     run diasize_change-height in this-procedure
     1397       (input -1
     1398       ,input true
     1399       ) .
     1400     return no-apply .
     1401   end.
     1402   on alt-enter of frame Dialog-Frame
     1403   do:
     1404     run diasize_maximize in this-procedure
     1405       (input  ?
     1406       ).
     1407     return no-apply .
     1408   end.
     1409   procedure diasize_end-move :
     1410     do
     1411     on error undo, return error return-value
     1412     :
     1413       define variable v-row-delta as decimal   no-undo .
     1414       define variable v-col-delta as decimal   no-undo .
     1415       define variable v-new-row as decimal   no-undo .
     1416       define variable v-new-col as decimal   no-undo .
     1417       assign
     1418         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1419         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1420       .
     1421       assign
     1422         v-row-delta = v-new-row - frame Dialog-Frame :height
     1423         v-col-delta = v-new-col - frame Dialog-Frame :width
     1424       .
     1425       run diasize_change-height in this-procedure
     1426         (input v-row-delta
     1427         ,input true
     1428         ) .
     1429       run diasize_change-width in this-procedure
     1430         (input v-col-delta
     1431         ,input true
     1432         ) .
     1433     end.
     1434   end procedure.
     1435   procedure diasize_maximize :
     1436     define input  parameter p-action as logical   no-undo .
     1437     do
     1438     on error undo, return error return-value
     1439     :
     1440       if p-action = ?
     1441       then do:
     1442         if v-diasize-need-maximize = true
     1443         then do:
     1444           assign
     1445             p-action = true
     1446           .
     1447         end.
     1448         else do:
     1449           assign
     1450             p-action = false
     1451           .
     1452         end.
     1453       end.
     1454       if p-action = true
     1455       then do:
     1456         run diasize_change-height in this-procedure
     1457           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1458               - frame Dialog-Frame :height-chars
     1459           ,input true
     1460           ) .
     1461         run diasize_change-width in this-procedure
     1462           (input session :width-chars
     1463               - frame Dialog-Frame :width-chars
     1464           ,input true
     1465           ) .
     1466         assign
     1467           v-diasize-need-maximize = false
     1468         .
     1469       end.
     1470       else do:
     1471         run diasize_change-width in this-procedure
     1472           (input v-diasize-orig-frame-width
     1473               - frame Dialog-Frame :width-chars
     1474           ,input true
     1475           ) .
     1476         run diasize_change-height in this-procedure
     1477           (input v-diasize-orig-frame-height
     1478               - frame Dialog-Frame :height-chars
     1479           ,input true
     1480           ) .
     1481         assign
     1482           v-diasize-need-maximize = true
     1483         .
     1484       end.
     1485     end.
     1486   end procedure.
     1487   procedure diasize_restore-orig-size :
     1488     do
     1489     on error undo, return error return-value
     1490     :
     1491       assign
     1492         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1493         v-diasize-current-frame-height = frame Dialog-Frame :height
     1494       .
     1495       run diasize_set-height in this-procedure
     1496         (input  v-diasize-orig-frame-height
     1497         ,input  true
     1498         ) .
     1499       run diasize_set-width in this-procedure
     1500         (input  v-diasize-orig-frame-width
     1501         ,input  true
     1502         ) .
     1503     end.
     1504   end procedure.
     1505   procedure diasize_restore-current-size :
     1506     do
     1507     on error undo, return error return-value
     1508     :
     1509       run diasize_set-height in this-procedure
     1510         (input  v-diasize-current-frame-height
     1511         ,input  true
     1512         ) .
     1513       run diasize_set-width in this-procedure
     1514         (input  v-diasize-current-frame-width
     1515         ,input  true
     1516         ) .
     1517     end.
     1518   end procedure.
     1519   procedure diasize_set-browse-handle :
     1520     define input  parameter p-browse-handle as handle   no-undo .
     1521     define buffer buf_temp-browse-handle for temp-browse-handle .
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525       assign
     1526         v-diasize-browse-handle = p-browse-handle
     1527       .
     1528       for each buf_temp-browse-handle
     1529       on error undo, return error return-value
     1530       :
     1531         delete buf_temp-browse-handle .
     1532       end.
     1533     end.
     1534   end procedure.
     1535   procedure diasize_add_browse :
     1536     define input  parameter p-browse-type   as character no-undo .
     1537     define input  parameter p-browse-handle as handle    no-undo .
     1538     define buffer buf_temp-browse-handle for temp-browse-handle .
     1539     do
     1540     on error undo, return error return-value
     1541     :
     1542       assign
     1543         v-diasize-browse-number = v-diasize-browse-number + 1
     1544       .
     1545       create buf_temp-browse-handle .
     1546       assign
     1547         buf_temp-browse-handle.browse-type   = p-browse-type
     1548         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1549         buf_temp-browse-handle.browse-handle = p-browse-handle
     1550       .
     1551     end.
     1552   end procedure.
     1553   procedure diasize_init :
     1554     define variable v-default-value    as logical   no-undo .
     1555     define variable v-restore-saved    as logical   no-undo .
     1556     define variable v-resize-value-str as character no-undo .
     1557     do
     1558     on error undo, return error return-value
     1559     :
     1560       do with frame Dialog-Frame
     1561       :
     1562         assign
     1563           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1564           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1565           v-diasize-browse-handle     = browse br-attr-prop :handle
     1566         .
     1567         create button v-diasize-resize-button
     1568         assign
     1569           parent        = frame Dialog-Frame :first-child
     1570           label         = "s"
     1571           height-pixels = 16
     1572           width-pixels  = 16
     1573           visible       = true
     1574           sensitive     = true
     1575           movable       = true
     1576           triggers:
     1577             on end-move persistent run diasize_end-move in this-procedure .
     1578           end triggers.
     1579         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1580         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1581         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1582         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1583         assign
     1584           v-diasize-wndmax = false
     1585         .
     1586         if connected("ub") = true
     1587         then do:
     1588           define variable v-cntxt-db-num        as integer   no-undo .
     1589           define variable v-cntxt-userid        as character no-undo .
     1590           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1591                                             , OUTPUT v-cntxt-userid
     1592                                             ) .
     1593           run gbl/wndpar_r.p
     1594             (input  v-cntxt-db-num
     1595             ,input  v-cntxt-userid
     1596             ,input  'wndmax':U
     1597             ,output v-diasize-wndmax
     1598             ,output v-default-value
     1599             ) .
     1600         end.
     1601         assign
     1602           v-diasize-wndstore = false
     1603         .
     1604         if connected("ub") = true
     1605         then do:
     1606           run gbl/wndpar_r.p
     1607             (input  v-cntxt-db-num
     1608             ,input  v-cntxt-userid
     1609             ,input  'wndstore':U
     1610             ,output v-diasize-wndstore
     1611             ,output v-default-value
     1612             ) .
     1613         end.
     1614         assign
     1615           v-diasize-proc-name = entry(1, program-name(2), '.')
     1616         .
     1617         if v-diasize-wndstore = true
     1618         then do:
     1619           assign
     1620             v-restore-saved = false
     1621           .
     1622           if connected("ub") = true
     1623           then do:
     1624             run gbl/wndsizer.p
     1625               (input  v-cntxt-db-num
     1626               ,input  v-cntxt-userid
     1627               ,input  v-diasize-proc-name
     1628               ,input  'height':u
     1629               ,output v-resize-value-str
     1630               ) .
     1631             if v-resize-value-str <> '':U
     1632             then do:
     1633               run diasize_change-height in this-procedure
     1634                 (input  integer(v-resize-value-str)
     1635                 ,input  true
     1636                 ) .
     1637               assign
     1638                 v-restore-saved = true
     1639               .
     1640             end.
     1641           end.
     1642           if connected("ub") = true
     1643           then do:
     1644             run gbl/wndsizer.p
     1645               (input  v-cntxt-db-num
     1646               ,input  v-cntxt-userid
     1647               ,input  v-diasize-proc-name
     1648               ,input  'width':u
     1649               ,output v-resize-value-str
     1650               ) .
     1651             if v-resize-value-str <> '':U
     1652             then do:
     1653               run diasize_change-width in this-procedure
     1654                 (input  integer(v-resize-value-str)
     1655                 ,input  true
     1656                 ) .
     1657               assign
     1658                 v-restore-saved = true
     1659               .
     1660             end.
     1661           end.
     1662           if v-restore-saved <> true
     1663           then do:
     1664             if v-diasize-wndmax = true
     1665             then do:
     1666               run diasize_maximize in this-procedure
     1667                 (input  true
     1668                 ) .
     1669             end.
     1670           end.
     1671         end.
     1672         else do:
     1673           if v-diasize-wndmax = true
     1674           then do:
     1675             run diasize_maximize in this-procedure
     1676               (input  true
     1677               ) .
     1678           end.
     1679         end.
     1680       end.
     1681     end.
     1682   end procedure.
     1683   procedure diasize_need-full-display :
     1684     define output parameter p-need-full-display as logical   no-undo .
     1685     do
     1686     on error undo, return error return-value
     1687     :
     1688       assign
     1689         p-need-full-display = v-diasize-need-full-display
     1690       .
     1691       assign
     1692         v-diasize-need-full-display = false
     1693       .
     1694     end.
     1695   end procedure.
     1696   procedure get-context :
     1697      define output parameter p-db-num as integer          no-undo.
     1698      define output parameter p-user-id as character        no-undo.
     1699      define variable v-login               as character    no-undo.
     1700      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1701      define buffer buf_user-login  for ub.user-login .
     1702      do
     1703      on error undo, return error
     1704      :
     1705            FIND FIRST buf_sys-ctrl no-lock.
     1706            ASSIGN
     1707               v-login = USERID("ub")
     1708               p-db-num = buf_sys-ctrl.db-num
     1709            .
     1710            FIND FIRST buf_user-login
     1711                 WHERE buf_user-login.db-num = p-db-num
     1712                   AND buf_user-login.user-login = v-login
     1713                 no-lock
     1714                 no-error
     1715                 .
     1716            IF AVAILABLE buf_user-login
     1717            THEN DO:
     1718               assign
     1719                  p-user-id = buf_user-login.user-id
     1720               .
     1721            END.
     1722      end.
     1723   end procedure.
     1724       run diasize_init in this-procedure .
     1725   MAIN-BLOCK:
     1726   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1727      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1728     IF p-mode <> 'ИЗМЕНЕНИЕ':U
     1729     AND p-mode <> 'ПРОСМОТР':U
     1730     THEN DO:
     1731       MESSAGE
     1732       "Неверное значение параметра p-mode=" p-mode
     1733        VIEW-AS ALERT-BOX ERROR.
     1734       UNDO, RETURN ERROR.
     1735     END.
     1736     RUN fill-temp-attr-prop IN THIS-PROCEDURE.
     1737     RUN Myenable.
     1738     WAIT-FOR GO OF FRAME Dialog-Frame.
     1739   END.
     1740   RUN disable_UI.
     1741   PROCEDURE disable_UI :
     1742     HIDE FRAME Dialog-Frame.
     1743   END PROCEDURE.
     1744   PROCEDURE enable_UI :
     1745     ENABLE B-exit b-quit b-add b-del b-chg B-Help br-attr-prop
     1746         WITH FRAME Dialog-Frame.
     1747     VIEW FRAME Dialog-Frame.
     1748   END PROCEDURE.
     1749   PROCEDURE fill-temp-attr-prop :
     1750   define variable v-path                    as character                no-undo .
     1751   DEFINE VARIABLE v-full-path               as character                no-undo .
     1752   DEFINE VARIABLE v-file-name               as character                no-undo .
     1753   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1754   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1755   DEFINE VARIABLE v-start AS LOGICAL NO-UNDO INIT YES.
     1756   DEFINE VARIABLE v-node-code AS integer NO-UNDO.
     1757   DEFINE BUFFER buf_attr-prop FOR  ub.attr-prop.
     1758   DEFINE BUFFER upper_attr-prop FOR ub.attr-prop.
     1759   DEFINE BUFFER buf_tt-attr-prop FOR tt-attr-prop.
     1760   _buf_attr-prop:
     1761   FOR EACH buf_attr-prop NO-LOCK WHERE
     1762           buf_attr-prop.table-name = p-table-name
     1763        and buf_attr-prop.templ-rl-root = p-templ-rl-root:
     1764     CREATE buf_tt-attr-prop.
     1765     BUFFER-COPY buf_attr-prop TO buf_tt-attr-prop
     1766     .
     1767     v-start = YES.
     1768     FIND FIRST UPPER_attr-prop NO-LOCK WHERE
     1769               UPPER_attr-prop.table-name = p-table-name
     1770           and UPPER_attr-prop.upper-node-code = buf_attr-prop.upper-node-code
     1771           AND UPPER_attr-prop.node-code = buf_attr-prop.node-code
     1772           AND UPPER_attr-prop.templ-rl-root = buf_attr-prop.templ-rl-root.
     1773     DO WHILE v-start OR buf_attr-prop.upper-node-code <> 0:
     1774       v-start = NO.
     1775       IF AVAILABLE UPPER_attr-prop THEN DO:
     1776         ASSIGN
     1777         buf_tt-attr-prop.full-prop-name = UPPER_attr-prop.prop-code +
     1778                                             chr(47) +
     1779                                         buf_tt-attr-prop.full-prop-name.
     1780       END.
     1781       v-node-code = upper_attr-prop.upper-node-code.
     1782       FIND FIRST UPPER_attr-prop NO-LOCK WHERE
     1783                  UPPER_attr-prop.table-name = p-table-name
     1784               and UPPER_attr-prop.node-code = v-node-code
     1785               AND UPPER_attr-prop.templ-rl-root = buf_attr-prop.templ-rl-root NO-ERROR.
     1786       IF NOT AVAILABLE UPPER_attr-prop THEN next _buf_attr-prop.
     1787     END.
     1788   END.
     1789   CREATE tt-attr-prop.
     1790   ASSIGN
     1791   tt-attr-prop.table-name = p-table-name
     1792   tt-attr-prop.prop-code = '':U
     1793   tt-attr-prop.node-code = 0
     1794   tt-attr-prop.upper-prop-code = '':U
     1795   tt-attr-prop.upper-node-code = 0
     1796   tt-attr-prop.templ-rl-root =  p-templ-rl-root
     1797   .
     1798   END PROCEDURE.
     1799   PROCEDURE MyEnable :
     1800   assign
     1801   frame Dialog-Frame:title = substitute("Таблица &1, код &2"
     1802                                          ,p-table-name
     1803                                          , p-templ-rl-root).
     1804   ENABLE
     1805   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     1806   b-quit
     1807   B-Help
     1808   b-add WHEn p-mode <> 'ПРОСМОТР':U
     1809   b-del WHEn p-mode <> 'ПРОСМОТР':U
     1810   b-chg WHEn p-mode <> 'ПРОСМОТР':U
     1811   br-attr-prop
     1812   WITH FRAME Dialog-Frame.
     1813   VIEW FRAME Dialog-Frame.
     1814   if p-mode = 'ПРОСМОТР':U then do:
     1815     hide
     1816     b-exit
     1817     in frame Dialog-Frame .
     1818     assign
     1819     b-quit:column = 1
     1820     b-quit:label = "&Выход"
     1821     .
     1822   end.
     1823   RUN OPENbr IN THIS-PROCEDURE.
     1824   END PROCEDURE.
     1825   PROCEDURE Openbr :
     1826   OPEN QUERY br-attr-prop FOR EACH tt-attr-prop by tt-attr-prop.full-prop-name.
     1827   END PROCEDURE.
     1828   PROCEDURE proc-b-add :
     1829   define output parameter p-node-code     as integer initial ?  no-undo .
     1830   DEFINE VARIABLE v-upper-prop-code       AS CHARACTER NO-UNDO .
     1831   define variable v-upper-node-code       as integer   no-undo .
     1832   DEFINE VARIABLE v-upper-prop-label      AS CHARACTER NO-UNDO .
     1833   DEFINE VARIABLE v-full-prop-name        AS CHARACTER NO-UNDO .
     1834   DEFINE VARIABLE v-upper-full-prop-name  AS CHARACTER NO-UNDO .
     1835   DEFINE VARIABLE v-prop-code             AS CHARACTER NO-UNDO .
     1836   define variable v-node-code             as integer   no-undo .
     1837   DEFINE VARIABLE v-prop-label            AS CHARACTER NO-UNDO .
     1838   DEFINE VARIABLE v-property-value        AS CHARACTER NO-UNDO .
     1839   DEFINE BUFFER buf_tt-attr-prop FOR tt-attr-prop.
     1840   run utl/attrprpi.w (  INPUT parparentproc
     1841                        ,input p-table-name
     1842                        ,output v-upper-prop-code
     1843                        ,output v-upper-node-code
     1844                        ,OUTPUT v-upper-prop-label
     1845                        ,OUTPUT v-full-prop-name
     1846                        ,OUTPUT v-prop-code
     1847                        ,output v-node-code
     1848                        ,OUTPUT v-prop-label
     1849                        ) NO-ERROR.
     1850   IF ERROR-STATUS:ERROR THEN undo, RETURN ERROR.
     1851   if v-prop-code = '':u then return.
     1852   FIND FIRST buf_tt-attr-prop WHERE
     1853             buf_tt-attr-prop.full-prop-name = v-full-prop-name
     1854         and buf_tt-attr-prop.table-name = p-table-name
     1855             NO-ERROR.
     1856   IF AVAILABLE buf_tt-attr-prop THEN DO:
     1857      MESSAGE
     1858     "Уже есть такой параметр в такой секции" SKIP
     1859      v-full-prop-name
     1860      VIEW-AS ALERT-BOX ERROR.
     1861      UNDO, RETURN ERROR.
     1862   END.
     1863   ASSIGN
     1864   v-UPPER-full-prop-name = v-full-prop-name
     1865   .
     1866   ASSIGN
     1867   v-upper-full-prop-name = RIGHT-TRIM(v-upper-full-prop-name, chr(47))
     1868   .
     1869   ENTRY(NUM-ENTRIES(v-upper-full-prop-name, chr(47)), v-upper-full-prop-name, chr(47)) = '':U.
     1870   FIND FIRST buf_tt-attr-prop WHERE
     1871              buf_tt-attr-prop.table-name = p-table-name
     1872          and buf_tt-attr-prop.full-prop-name = v-upper-full-prop-name NO-ERROR.
     1873   IF NOT AVAILABLE buf_tt-attr-prop THEN DO:
     1874      MESSAGE
     1875     "Нет секции с полным именем ="
     1876      v-upper-full-prop-name
     1877      VIEW-AS ALERT-BOX ERROR.
     1878      UNDO, RETURN ERROR.
     1879   END.
     1880   CREATE buf_tt-attr-prop.
     1881   ASSIGN
     1882   buf_tt-attr-prop.table-name      = p-table-name
     1883   buf_tt-attr-prop.prop-code       = v-prop-code
     1884   buf_tt-attr-prop.node-code       = v-node-code
     1885   buf_tt-attr-prop.upper-prop-code = v-upper-prop-code
     1886   buf_tt-attr-prop.upper-node-code = v-upper-node-code
     1887   buf_tt-attr-prop.property-value  = v-property-value
     1888   buf_tt-attr-prop.full-prop-name  = v-full-prop-name
     1889   buf_tt-attr-prop.templ-rl-root   = p-templ-rl-root
     1890   p-node-code                     = v-node-code
     1891   .
     1892   release buf_tt-attr-prop.
     1893   RUN openbr IN THIS-PROCEDURE .
     1894   find first buf_tt-attr-prop no-lock
     1895     where buf_tt-attr-prop.templ-rl-root = p-templ-rl-root
     1896       and buf_tt-attr-prop.table-name = p-table-name
     1897       and buf_tt-attr-prop.node-code     = v-node-code
     1898   no-error .
     1899   if available buf_tt-attr-prop  then do:
     1900     REPOSITION  br-attr-prop TO RECID RECID(buf_tt-attr-prop) NO-ERROR.
     1901   end.
     1902   APPLY "ENTRY" TO BROWSE br-attr-prop.
     1903   END PROCEDURE.
     1904   PROCEDURE proc-b-chg :
     1905   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     1906   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     1907   v-value = tt-attr-prop.property-value.
     1908         run gbl/d-character.w (
     1909                input ?
     1910               ,input (
     1911               'title=':u + substitute("Изменение свойства &1", tt-attr-prop.prop-code) + '\':u
     1912             + 'text1=':u + tt-attr-prop.prop-code + '\':u
     1913             + 'format=' + "X(90)" + '\':u
     1914             + 'fillin_row=3\':u
     1915             + 'fillin_col=4\':u
     1916             + 'fillin_width=90\':u
     1917             + 'fillin_height=1\':u
     1918             + 'max-chars=90\':u
     1919             + 'readonly=no' + '\':u)
     1920             , input-output v-value
     1921             , output v-ok
     1922                 ).
     1923             if not v-ok then return error.
     1924   assign
     1925   tt-attr-prop.property-value = v-value.
     1926   br-attr-prop:REFRESH() IN FRAME Dialog-Frame.
     1927   END PROCEDURE.
     1928   PROCEDURE proc-b-del :
     1929   DEFINE VARIABLE glog AS LOGICAL no-undo.
     1930   DEFINE BUFFER buf_tt-attr-prop FOR tt-attr-prop.
     1931   MESSAGE
     1932   SUBSTITUTE("Вы уверены, что хотите удалить свойство?")
     1933   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1934   IF NOT glog  THEN RETURN ERROR.
     1935   FIND FIRST buf_tt-attr-prop WHERE
     1936             buf_tt-attr-prop.table-name = p-table-name
     1937         and buf_tt-attr-prop.upper-node-code = tt-attr-prop.node-code  NO-ERROR.
     1938   IF AVAILABLE buf_tt-attr-prop THEN DO:
     1939     MESSAGE
     1940     "Нельзя удалить свойство, к нему есть привязки"
     1941      VIEW-AS ALERT-BOX ERROR.
     1942     UNDO, RETURN ERROR.
     1943   END.
     1944   FIND FIRST buf_tt-attr-prop WHERE
     1945            RECID(buf_tt-attr-prop) = RECID(tt-attr-prop).
     1946   DELETE buf_tt-attr-prop.
     1947   RUN Openbr IN THIS-PROCEDURE.
     1948   END PROCEDURE.
     1949   PROCEDURE proc-save :
     1950   define buffer buf_tt-attr-prop for tt-attr-prop.
     1951   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1952   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1953   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1954     v-rec = p-rec.
     1955   END.
     1956   for each buf_tt-attr-prop:
     1957     assign
     1958     buf_tt-attr-prop.templ-rl-root = p-templ-rl-root
     1959     .
     1960   end.
     1961   run utl/attrprp0.p ( INPUT p-mode
     1962                       ,INPUT NO
     1963                       ,input p-table-name
     1964                       ,input p-templ-rl-root
     1965                       ,input table tt-attr-prop
     1966                       ) NO-ERROR.
     1967   IF ERROR-STATUS:ERROR THEN DO:
     1968   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1969   define variable fh as widget-handle no-undo .
     1970   define variable hh as widget-handle no-undo .
     1971   define variable rv as character no-undo .
     1972   assign
     1973   rv = entry(1, return-value , chr(4)).
     1974   if rv <> "":U then do:
     1975     assign
     1976     fh = frame Dialog-Frame:first-child
     1977     hh = fh:first-child
     1978     .
     1979     do while valid-handle(hh):
     1980       if hh:name = rv then do:
     1981         APPLY "ENTRY" to hh.
     1982         undo ,
     1983         return error.
     1984       end.
     1985       hh = hh:next-sibling.
     1986     end.
     1987   end.
     1988     undo, return error.
     1989   END.
     1990   p-rec = v-rec.
     1991   END PROCEDURE.
