        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as handle     no-undo .
        3   define input  parameter p-filename      as character  no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: expclia.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/expclia.p $":U .
        9   define variable vss-description as character no-undo init "Экспорт артикулов поставщиков из файла".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define temp-table tt-cli-art no-undo
       69     field cli-type  like ub.cli-gds.cli-type
       70     field cli-code  like ub.cli-gds.cli-code
       71     field host-code like ub.cli-gds.host-code
       72     field artic     like ub.cli-gds.artic
       73     field prod-type like ub.cli-gds.prod-type
       74     field prod-code like ub.cli-gds.prod-code
       75     field ext-artic like ub.cli-gds.cli-art
       76   index pi is primary unique
       77     cli-type
       78     cli-code
       79     host-code
       80     artic
       81     prod-type
       82     prod-code
       83     ext-artic
       84   .
       85   define stream sout.
       86   define buffer buf_cli-gds   for ub.cli-gds.
       87   define buffer buf_ext-artic for ub.ext-artic.
       88   define buffer buf_goods     for ub.goods.
       89   define variable v-log           as logical   no-undo .
       90   define variable v-full-filename as character no-undo .
       91   define variable v-i             as integer   no-undo .
       92   define variable v-cli-str       as character no-undo .
       93   define variable v-cli-art       as character no-undo .
       94   define frame exp-frame
       95     v-i                 format ">>>>>>>>9" label "Количество записей" skip
       96     v-cli-str           format "X(13)"     label "Поставщик"          skip
       97     v-cli-art           format "X(14)"     label "Артикул"
       98     with view-as dialog-box side-labels three-d
       99     title "Экспорт артикулов поставщиков в файл"
      100   .
      101   do on error undo, return error return-value
      102   :
      103     message
      104       "Экспорт артикул поставщика в файл." skip (2)
      105       "Продолжить ?"
      106     view-as alert-box question buttons yes-no update v-log.
      107     if not v-log
      108     then do:
      109       return .
      110     end.
      111     assign
      112       v-full-filename = search( p-filename )
      113     .
      114     if v-full-filename <> ?
      115     then do:
      116       message
      117         "Перезаписать файл " v-full-filename " ?"
      118       view-as alert-box question buttons OK-Cancel update v-log.
      119       if not v-log
      120       then do:
      121         return .
      122       end.
      123     end.
      124     for each buf_ext-artic no-lock ,
      125       first buf_goods no-lock
      126           where buf_ext-artic.status_ = 'тек':U
      127             and buf_goods.gds-code = buf_ext-artic.gds-code
      128     :
      129       assign
      130         v-i       = v-i + 1
      131         v-cli-str = string(buf_ext-artic.cli-code, "999999999")  +  " "  +  trim(buf_ext-artic.cli-type)
      132         v-cli-art = buf_ext-artic.ext-artic
      133       .
      134       display
      135         v-i
      136         v-cli-art
      137         v-cli-str
      138       with frame exp-frame.
      139       pause 0.
      140       find first tt-cli-art no-lock
      141         where tt-cli-art.cli-type   = buf_ext-artic.cli-type
      142           and tt-cli-art.cli-code   = buf_ext-artic.cli-code
      143           and tt-cli-art.host-code  = 0
      144           and tt-cli-art.artic      = buf_goods.artic
      145           and tt-cli-art.prod-type  = buf_goods.prod-type
      146           and tt-cli-art.prod-code  = buf_goods.prod-code
      147           and tt-cli-art.ext-artic  = buf_ext-artic.ext-artic
      148       no-error .
      149       if not available tt-cli-art
      150       then do:
      151         create tt-cli-art.
      152         assign
      153           tt-cli-art.cli-type   = buf_ext-artic.cli-type
      154           tt-cli-art.cli-code   = buf_ext-artic.cli-code
      155           tt-cli-art.host-code  = 0
      156           tt-cli-art.artic      = buf_goods.artic
      157           tt-cli-art.prod-type  = buf_goods.prod-type
      158           tt-cli-art.prod-code  = buf_goods.prod-code
      159           tt-cli-art.ext-artic  = buf_ext-artic.ext-artic
      160         .
      161     end.
      162     end.
      163     output stream sout to value( p-filename ) .
      164     for each tt-cli-art :
      165       put stream sout unformatted
      166        tt-cli-art.cli-type                  + ";":U +
      167        trim(string(tt-cli-art.cli-code))    + ";":U +
      168        trim(string(tt-cli-art.host-code))   + ";":U +
      169        tt-cli-art.artic                     + ";":U +
      170        tt-cli-art.prod-type                 + ";":U +
      171        trim(string(tt-cli-art.prod-code))   + ";":U +
      172        tt-cli-art.ext-artic
      173       skip.
      174     end.
      175     output stream sout close.
      176     message
      177       "Экспорт завершен."
      178     view-as alert-box information.
      179   end.
