        1   define temp-table tt-stk-gd no-undo
        2     field gds-code      as integer
        3     field gds-name      as character
        4     field fact-qnty     as decimal
        5     field sum-rubl-cost as decimal
        6     field vat-rubl      as decimal
        7     field sum-rubl-crsa as decimal
        8     index pi is primary gds-code
        9   .
       10   define temp-table tt-stk-fu no-undo
       11     field gds-code      as integer
       12     field gds-name      as character
       13     field fact-qnty-lt  as decimal
       14     field fact-qnty-kg  as decimal
       15     index pi is primary gds-code
       16   .
       17   define input  parameter p-obj-code       as integer no-undo .
       18   define input  parameter p-obj-type       as character no-undo .
       19   define output parameter table for tt-stk-gd .
       20   define output parameter table for tt-stk-fu .
       21   define variable vss-revision    as character no-undo init "$Revision$":U .
       22   define variable vss-author      as character no-undo init "$Author$":U .
       23   define variable vss-date        as character no-undo init "$Date$":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       25   define variable vss-archive     as character no-undo init "$Archive$":U .
       26   define variable vss-description as character no-undo init "¬ыгружает текущие остатки дл€ сравнени€ остатков в 16_0 после импорта".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#lib-trn  as handle no-undo .
       86   define new global shared variable g#lib-trn2 as handle no-undo .
       87   define new global shared variable g#lib-trn3 as handle no-undo .
       88   define new global shared variable g#lib-trn4 as handle no-undo .
       89   define variable is-petrolium as logical no-undo .
       90   define variable is-pieces    as logical no-undo .
       91   define variable v-today      as date no-undo .
       92   define variable v-line-count as integer no-undo .
       93   define buffer buf_gds-obj   for ub.gds-obj .
       94   define buffer buf_goods     for ub.goods .
       95   define buffer buf_pl-gds    for ub.pl-gds .
       96   define buffer buf_stk-line  for ub.stk-line .
       97       v-today = today .
       98     define variable v-date-start as date no-undo .
       99     define variable v-date-end   as date no-undo .
      100     define variable v-archive-ok as logical no-undo .
      101     define variable v-comment    as character no-undo .
      102     define variable v-can-print  as logical no-undo .
      103     assign
      104       v-date-start = v-today
      105       v-date-end   = v-today
      106     .
      107     run rep/chk-ahz.p
      108     (input p-obj-type
      109     ,input p-obj-code
      110     ,input false
      111     ,input true
      112     ,input false
      113     ,input false
      114     ,input false
      115     ,input 0
      116     ,input ""
      117     ,input-output v-date-start
      118     ,input-output v-date-end
      119     ,output       v-archive-ok
      120     ,output       v-comment
      121     ,output       v-can-print
      122     ) .
      123       empty temp-table tt-stk-gd .
      124       empty temp-table tt-stk-fu .
      125       v-line-count = 0 .
      126       for each buf_gds-obj no-lock
      127          where buf_gds-obj.obj-type = p-obj-type
      128            and buf_gds-obj.obj-code = p-obj-code :
      129         v-line-count = v-line-count + 1 .
      130         find first buf_goods no-lock where buf_goods.gds-code = buf_gds-obj.gds-code no-error .
      131   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      132     (
      133        input buf_gds-obj.artic
      134     ,  input buf_gds-obj.prod-type
      135     ,  input buf_gds-obj.prod-code
      136     , output is-petrolium
      137     , output is-pieces
      138     ) .
      139         if is-petrolium then do :
      140           create tt-stk-fu .
      141           assign
      142             tt-stk-fu.gds-code     = buf_gds-obj.gds-code
      143             tt-stk-fu.gds-name     = if available buf_goods then buf_goods.gds-name else "товар отсутствует"
      144             tt-stk-fu.fact-qnty-lt = 0
      145             tt-stk-fu.fact-qnty-kg = 0
      146           .
      147           for each buf_pl-gds no-lock
      148              where buf_pl-gds.gds-code = buf_gds-obj.gds-code
      149                and buf_pl-gds.obj-type = buf_gds-obj.obj-type
      150                and buf_pl-gds.obj-code = buf_gds-obj.obj-code :
      151             assign
      152               tt-stk-fu.fact-qnty-lt = tt-stk-fu.fact-qnty-lt + buf_pl-gds.fact-qnty
      153               tt-stk-fu.fact-qnty-kg = tt-stk-fu.fact-qnty-kg + buf_pl-gds.cli-fact-qnty
      154             .
      155           end .
      156         end .
      157         else do :
      158           create tt-stk-gd .
      159           assign
      160             tt-stk-gd.gds-code      = buf_gds-obj.gds-code
      161             tt-stk-gd.gds-name      = if available buf_goods then buf_goods.gds-name else "товар отсутствует"
      162             tt-stk-gd.fact-qnty     = 0
      163             tt-stk-gd.sum-rubl-cost = 0
      164             tt-stk-gd.vat-rubl      = 0
      165             tt-stk-gd.sum-rubl-crsa = 0
      166           .
      167           find last buf_stk-line no-lock
      168               where buf_stk-line.obj-type   = buf_gds-obj.obj-type
      169                 and buf_stk-line.obj-code   = buf_gds-obj.obj-code
      170                 and buf_stk-line.artic      = buf_gds-obj.artic
      171                 and buf_stk-line.prod-type  = buf_gds-obj.prod-type
      172                 and buf_stk-line.prod-code  = buf_gds-obj.prod-code
      173                 and buf_stk-line.sum-type   = 'cost':U
      174                 and buf_stk-line.cat-id     = '##,##':U
      175                 and buf_stk-line.fact-date <= v-today
      176           use-index category no-error.
      177           if available buf_stk-line then assign
      178             tt-stk-gd.fact-qnty     = buf_stk-line.fact-qnty
      179             tt-stk-gd.sum-rubl-cost = buf_stk-line.sum-rubl
      180             tt-stk-gd.vat-rubl      = buf_stk-line.VAT-rubl
      181           .
      182           find last buf_stk-line no-lock
      183               where buf_stk-line.obj-type   = buf_gds-obj.obj-type
      184                 and buf_stk-line.obj-code   = buf_gds-obj.obj-code
      185                 and buf_stk-line.artic      = buf_gds-obj.artic
      186                 and buf_stk-line.prod-type  = buf_gds-obj.prod-type
      187                 and buf_stk-line.prod-code  = buf_gds-obj.prod-code
      188                 and buf_stk-line.sum-type   = 'crsa':U
      189                 and buf_stk-line.cat-id     = '##,##':U
      190                 and buf_stk-line.fact-date <= v-today
      191           use-index category no-error.
      192           if available buf_stk-line then assign
      193             tt-stk-gd.fact-qnty     = buf_stk-line.fact-qnty when tt-stk-gd.fact-qnty = 0
      194             tt-stk-gd.sum-rubl-crsa = buf_stk-line.sum-rubl
      195           .
      196         end .
      197       end .
