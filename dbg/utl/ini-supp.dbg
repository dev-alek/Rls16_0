        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: ini-supp.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/ini-supp.p $":U .
        8   define variable vss-description as character no-undo init "Инициализация остатков по поставщику".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       71   procedure partslib-clear-temp-parts :
       72     define buffer buf_temp-parts for temp-parts .
       73     do
       74     on error undo, return error
       75     :
       76       for each buf_temp-parts
       77       on error undo, return error
       78       :
       79         delete buf_temp-parts .
       80       end.
       81     end.
       82   end procedure.
       83   procedure partslib-create-temp-parts :
       84     define parameter buffer buf_parts       for ub.parts .
       85     define parameter buffer buf_temp-parts  for temp-parts .
       86     define input  parameter p-goods-twounit as logical   no-undo .
       87     define variable v-base-part-code as character no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       if p-goods-twounit = true
       92       then do:
       93         assign
       94           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
       95         .
       96       end.
       97       else do:
       98         assign
       99           v-base-part-code = buf_parts.part-code
      100         .
      101       end.
      102       find first buf_temp-parts exclusive-lock
      103         where buf_temp-parts.obj-type  = buf_parts.obj-type
      104           and buf_temp-parts.obj-code  = buf_parts.obj-code
      105           and buf_temp-parts.artic     = buf_parts.artic
      106           and buf_temp-parts.prod-type = buf_parts.prod-type
      107           and buf_temp-parts.prod-code = buf_parts.prod-code
      108           and buf_temp-parts.in-code   = buf_parts.in-code
      109           and buf_temp-parts.out-code  = 'free-zone':U
      110           and buf_temp-parts.part-code = v-base-part-code
      111         no-error.
      112       if not available buf_temp-parts
      113       then do:
      114         create buf_temp-parts .
      115         buffer-copy buf_parts to buf_temp-parts
      116         assign
      117           buf_temp-parts.out-code  = 'free-zone':U
      118           buf_temp-parts.part-code = v-base-part-code
      119           buf_temp-parts.rsrv-free = yes
      120           buf_temp-parts.status_   = no
      121           buf_temp-parts.qnty      = 0
      122           buf_temp-parts.fact-qnty = 0
      123           buf_temp-parts.real-qnty = 0
      124           buf_temp-parts.cli-qnty  = 0
      125         .
      126       end.
      127     end.
      128   end procedure.
      129   procedure partslib-init-temp-parts :
      130     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      131     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      132     define input parameter p-artic           like ub.parts.artic     no-undo .
      133     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      134     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      135     define buffer buf_parts      for ub.parts .
      136     define buffer buf_temp-parts for temp-parts .
      137     define variable v-goods-twounit    as logical   no-undo .
      138     do
      139     on error undo, return error
      140     :
      141   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      143     (input  p-artic
      144     ,input  p-prod-type
      145     ,input  p-prod-code
      146     ,input  'twounit=request':u
      147     ,output v-goods-twounit
      148     ) no-error .
      149       if error-status :error
      150       then do:
      151         message
      152           vss-workfile vss-revision vss-description skip
      153           vss-include-info0 skip
      154           "Ошибка при определении атрибута товара" skip
      155           "Артикул" p-artic p-prod-type p-prod-code skip
      156           "twounit=request" skip
      157           error-status :get-message(1) skip
      158           return-value skip
      159           view-as alert-box error .
      160         undo, return error return-value .
      161       end.
      162       run partslib-clear-temp-parts in this-procedure .
      163       for each buf_parts
      164         where buf_parts.obj-type  = p-obj-type
      165           and buf_parts.obj-code  = p-obj-code
      166           and buf_parts.artic     = p-artic
      167           and buf_parts.prod-type = p-prod-type
      168           and buf_parts.prod-code = p-prod-code
      169           and buf_parts.rsrv-free = yes
      170           and buf_parts.status_   = no
      171           and buf_parts.in-code   <> buf_parts.out-code
      172       on error undo, return error
      173       :
      174         run partslib-create-temp-parts in this-procedure
      175           (buffer buf_parts
      176           ,buffer buf_temp-parts
      177           ,input  v-goods-twounit
      178           ) .
      179         define variable v-parts-qnty          as decimal   no-undo .
      180         define variable v-parts-cli-qnty      as decimal   no-undo .
      181         define variable v-parts-free-qnty     as decimal   no-undo .
      182         define variable v-parts-free-cli-qnty as decimal   no-undo .
      183         if buf_parts.out-code = 'free-zone':U
      184         then do:
      185           assign
      186             v-parts-qnty          = buf_parts.qnty
      187             v-parts-cli-qnty      = buf_parts.cli-qnty
      188             v-parts-free-qnty     = buf_parts.qnty
      189             v-parts-free-cli-qnty = buf_parts.cli-qnty
      190           .
      191         end.
      192         else do:
      193           assign
      194             v-parts-qnty          = abs(buf_parts.qnty)
      195             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      196             v-parts-free-qnty     = 0
      197             v-parts-free-cli-qnty = 0
      198           .
      199         end.
      200         assign
      201           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      202           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      203           buf_temp-parts.real-qnty     = 0
      204           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      205           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      206           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      207         .
      208       end.
      209     end.
      210   end procedure.
      211   procedure partslib-init-temp-parts-by-factord :
      212     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      213     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      214     define input parameter p-artic              like ub.parts.artic     no-undo .
      215     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      216     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      217     define input parameter p-fact-order         as decimal   no-undo .
      218     define input parameter p-include-fact-order as logical   no-undo .
      219     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      220     define buffer buf_gds-obj  for ub.gds-obj .
      221     do
      222     on error undo, return error
      223     :
      224       do transaction
      225       on error undo, return error
      226       :
      227   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      229     (input  p-obj-type
      230     ,input  p-obj-code
      231     ,input  p-artic
      232     ,input  p-prod-type
      233     ,input  p-prod-code
      234     ,buffer buf_gds-obj
      235     ) no-error .
      236         if error-status :error
      237         then do:
      238           message
      239             vss-workfile vss-revision vss-description skip
      240             vss-include-info0 skip
      241             "Невозможно найти товар на объекте" skip
      242             "Объект" p-obj-type p-obj-code skip
      243             "Артикул" p-artic p-prod-type p-prod-code skip
      244             error-status :get-message(1) skip
      245             return-value skip
      246             view-as alert-box error .
      247           undo, return error .
      248         end.
      249         find current buf_gds-obj exclusive-lock .
      250       end.
      251       run partslib-init-temp-parts in this-procedure
      252         (input p-obj-type
      253         ,input p-obj-code
      254         ,input p-artic
      255         ,input p-prod-type
      256         ,input p-prod-code
      257         ) no-error .
      258       if error-status :error
      259       then do:
      260         message
      261           vss-workfile vss-revision vss-description skip
      262           vss-include-info0 skip
      263           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      264           "Объект" p-obj-type p-obj-code skip
      265           "Артикул" p-artic p-prod-type p-prod-code skip
      266           "p-fact-order" p-fact-order skip
      267           view-as alert-box error .
      268         undo, return error .
      269       end.
      270       if p-include-fact-order = true
      271       then do:
      272         assign
      273           p-fact-order = p-fact-order - 0.0000000001
      274         .
      275       end.
      276       define variable v-max-fact-order as character no-undo .
      277       run factord-max-fact-order in this-procedure
      278         (output v-max-fact-order
      279         ) no-error .
      280       if error-status :error
      281       then do:
      282         message
      283           vss-workfile vss-revision vss-description skip
      284           vss-include-info0 skip
      285           "Ошибка при вызове процедуры factord-max-fact-order" skip
      286           "Объект" p-obj-type p-obj-code skip
      287           "Артикул" p-artic p-prod-type p-prod-code skip
      288           "p-fact-order" p-fact-order skip
      289           view-as alert-box error .
      290         undo, return error .
      291       end.
      292       run partslib-update-by-factord in this-procedure
      293         (input p-obj-type
      294         ,input p-obj-code
      295         ,input p-artic
      296         ,input p-prod-type
      297         ,input p-prod-code
      298         ,input p-fact-order
      299         ,input v-max-fact-order
      300         ,input false
      301         ) no-error .
      302       if error-status :error
      303       then do:
      304         message
      305           vss-workfile vss-revision vss-description skip
      306           vss-include-info0 skip
      307           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      308           "Объект" p-obj-type p-obj-code skip
      309           "Артикул" p-artic p-prod-type p-prod-code skip
      310           "p-fact-order" p-fact-order skip
      311           "v-max-fact-order" v-max-fact-order skip
      312           view-as alert-box error .
      313         undo, return error .
      314       end.
      315     end.
      316   end procedure.
      317   procedure partslib-update-by-factord :
      318     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      319     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      320     define input parameter p-artic              like ub.parts.artic     no-undo .
      321     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      322     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      323     define input parameter p-start-fact-order   as decimal   no-undo .
      324     define input parameter p-end-fact-order     as decimal   no-undo .
      325     define input parameter p-lock-gds-obj       as logical   no-undo .
      326     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      327     define buffer buf_gds-obj  for ub.gds-obj .
      328     define buffer buf_doc-line for ub.doc-line .
      329     define variable v-total-parts-qnty as decimal   no-undo .
      330     define variable v-goods-gds-goods  as logical   no-undo .
      331     define variable v-goods-twounit    as logical   no-undo .
      332     do
      333     on error undo, return error
      334     :
      335       if p-start-fact-order > p-end-fact-order
      336       then do:
      337         message
      338           vss-workfile vss-revision vss-description skip
      339           vss-include-info0 skip
      340           "Ошибка задания входных параметров" skip
      341           "Начало интервала превышает конец интервала" skip
      342           "Объект" p-obj-type p-obj-code skip
      343           "Артикул" p-artic p-prod-type p-prod-code skip
      344           "p-start-fact-order" p-start-fact-order skip
      345           "p-end-fact-order"   p-end-fact-order skip
      346           view-as alert-box error .
      347         undo, return error .
      348       end.
      349       if p-lock-gds-obj = true
      350       then do:
      351         do transaction
      352         on error undo, return error
      353         :
      354   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      356     (input  p-obj-type
      357     ,input  p-obj-code
      358     ,input  p-artic
      359     ,input  p-prod-type
      360     ,input  p-prod-code
      361     ,buffer buf_gds-obj
      362     ) no-error .
      363           if error-status :error
      364           then do:
      365             message
      366               vss-workfile vss-revision vss-description skip
      367               vss-include-info0 skip
      368               "Невозможно найти gds-obj" skip
      369               error-status :get-message(1) skip
      370               return-value skip
      371               view-as alert-box error .
      372             undo, return error .
      373           end.
      374           find current buf_gds-obj exclusive-lock .
      375         end.
      376       end.
      377   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      379     (input  p-artic
      380     ,input  p-prod-type
      381     ,input  p-prod-code
      382     ,input  'gds-goods=request':u
      383     ,output v-goods-gds-goods
      384     ) no-error .
      385       if error-status :error
      386       then do:
      387         message
      388           vss-workfile vss-revision vss-description skip
      389           vss-include-info0 skip
      390           "Ошибка при определении атрибута товара" skip
      391           "Артикул" p-artic p-prod-type p-prod-code skip
      392           "gds-goods=request" skip
      393           error-status :get-message(1) skip
      394           return-value skip
      395           view-as alert-box error .
      396         undo, return error return-value .
      397       end.
      398   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      400     (input  p-artic
      401     ,input  p-prod-type
      402     ,input  p-prod-code
      403     ,input  'twounit=request':u
      404     ,output v-goods-twounit
      405     ) no-error .
      406       if error-status :error
      407       then do:
      408         message
      409           vss-workfile vss-revision vss-description skip
      410           vss-include-info0 skip
      411           "Ошибка при определении атрибута товара" skip
      412           "Артикул" p-artic p-prod-type p-prod-code skip
      413           "twounit=request" skip
      414           error-status :get-message(1) skip
      415           return-value skip
      416           view-as alert-box error .
      417         undo, return error return-value .
      418       end.
      419       for each buf_doc-line no-lock
      420         where buf_doc-line.obj-type   = p-obj-type
      421           and buf_doc-line.obj-code   = p-obj-code
      422           and buf_doc-line.artic      = p-artic
      423           and buf_doc-line.prod-type  = p-prod-type
      424           and buf_doc-line.prod-code  = p-prod-code
      425           and buf_doc-line.status_    = 'факт':U
      426           and buf_doc-line.fact-order > p-start-fact-order
      427           and buf_doc-line.fact-order <= p-end-fact-order
      428       on error undo, return error
      429       :
      430         run partslib-process-document in this-procedure
      431           (input  buf_doc-line.doc-code
      432           ,input  p-obj-type
      433           ,input  p-obj-code
      434           ,input  p-artic
      435           ,input  p-prod-type
      436           ,input  p-prod-code
      437           ,input  v-goods-gds-goods
      438           ,input  v-goods-twounit
      439           ,output v-total-parts-qnty
      440           ) no-error .
      441         if error-status :error
      442         then do:
      443           message
      444             vss-workfile vss-revision vss-description skip
      445             vss-include-info0 skip
      446             "Ошибка при вызове процедуры partslib-process-document" skip
      447             "Документ" buf_doc-line.doc-code skip
      448             "Объект" p-obj-type p-obj-code skip
      449             "Артикул" p-artic p-prod-type p-prod-code skip
      450             "p-start-fact-order" p-start-fact-order skip
      451             "p-end-fact-order" p-end-fact-order skip
      452             error-status :get-message(1) skip
      453             return-value skip
      454             view-as alert-box error .
      455           undo, return error return-value .
      456         end.
      457       end.
      458     end.
      459   end procedure.
      460   procedure partslib-process-document :
      461     define input  parameter p-doc-code         as character no-undo .
      462     define input  parameter p-obj-type         as character no-undo .
      463     define input  parameter p-obj-code         as integer   no-undo .
      464     define input  parameter p-artic            as character no-undo .
      465     define input  parameter p-prod-type        as character no-undo .
      466     define input  parameter p-prod-code        as integer   no-undo .
      467     define input  parameter p-goods-gds-goods  as logical   no-undo .
      468     define input  parameter p-goods-twounit    as logical   no-undo .
      469     define output parameter p-total-parts-qnty as decimal   no-undo .
      470     define variable v-parts-sign as integer   no-undo .
      471     define buffer buf_trn-doc    for ub.trn-doc .
      472     define buffer buf_doc-line   for ub.doc-line .
      473     define buffer buf_parts      for ub.parts .
      474     define buffer buf_temp-parts for temp-parts .
      475     do
      476     on error undo, return error return-value
      477     :
      478       find first buf_trn-doc no-lock
      479         where buf_trn-doc.doc-code = p-doc-code
      480         no-error .
      481       if not available buf_trn-doc
      482       then do:
      483         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      484                                      ,p-doc-code
      485                                      ) .
      486       end.
      487       case buf_trn-doc.doc-type
      488       :
      489         when 'при':U or
      490         when 'возврат':U or
      491         when 'инв':U
      492         then do:
      493           assign
      494             v-parts-sign = -1
      495           .
      496         end.
      497         when 'рас':U or
      498         when 'спи':U
      499         then do:
      500           assign
      501             v-parts-sign = 1
      502           .
      503         end.
      504         otherwise do:
      505           undo, return error substitute("Неизвестный тип документа &1"
      506                                       ,buf_trn-doc.doc-type
      507                                       ) .
      508         end.
      509       end.
      510       find first buf_doc-line no-lock
      511         where buf_doc-line.doc-code  = p-doc-code
      512           and buf_doc-line.artic     = p-artic
      513           and buf_doc-line.prod-type = p-prod-type
      514           and buf_doc-line.prod-code = p-prod-code
      515         no-error .
      516       if not available buf_doc-line
      517       then do:
      518         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      519                                      ,p-doc-code
      520                                      ,artic
      521                                      ,prod-type
      522                                      ,prod-code
      523                                      ) .
      524       end.
      525       assign
      526         p-total-parts-qnty = 0
      527       .
      528       if p-goods-gds-goods = true
      529       then do:
      530         for each buf_parts no-lock
      531           where buf_parts.out-code  = p-doc-code
      532             and buf_parts.obj-type  = p-obj-type
      533             and buf_parts.obj-code  = p-obj-code
      534             and buf_parts.artic     = p-artic
      535             and buf_parts.prod-type = p-prod-type
      536             and buf_parts.prod-code = p-prod-code
      537         on error undo, return error
      538         :
      539           run partslib-create-temp-parts in this-procedure
      540             (buffer buf_parts
      541             ,buffer buf_temp-parts
      542             ,input  p-goods-twounit
      543             ) .
      544           assign
      545             p-total-parts-qnty        = p-total-parts-qnty
      546                                       + v-parts-sign * buf_parts.fact-qnty
      547             buf_temp-parts.qnty       = buf_temp-parts.qnty
      548                                       + v-parts-sign * buf_parts.fact-qnty
      549             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      550                                       + v-parts-sign * buf_parts.fact-qnty
      551             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      552                                       + v-parts-sign * buf_parts.cli-qnty
      553           .
      554           if buf_temp-parts.qnty = 0
      555           then do:
      556             delete buf_temp-parts .
      557           end.
      558         end.
      559       end.
      560       else do:
      561         assign
      562           p-total-parts-qnty = p-total-parts-qnty
      563                              + v-parts-sign * buf_doc-line.fact-qnty
      564         .
      565       end.
      566     end.
      567   end procedure.
      568   procedure partslib-init-temp-parts-by-date :
      569     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      570     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      571     define input parameter p-artic           like ub.parts.artic     no-undo .
      572     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      573     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      574     define input parameter p-fact-date       as date      no-undo .
      575     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      576     do
      577     on error undo, return error
      578     :
      579       define variable v-fact-order                as decimal   no-undo .
      580       define variable v-shift-end-fact-order      as decimal   no-undo .
      581       define variable v-day-end-fact-order        as decimal   no-undo .
      582       run factord in this-procedure
      583         (input  p-fact-date
      584         ,input  1
      585         ,input  1
      586         ,input  ?
      587         ,input  0
      588         ,input  false
      589         ,output v-fact-order
      590         ,output v-shift-end-fact-order
      591         ,output v-day-end-fact-order
      592         ) no-error .
      593       if error-status :error
      594       then do:
      595         message
      596           vss-workfile vss-revision vss-description skip
      597           vss-include-info0 skip
      598           "Ошибка при определении момента времени, на который требуется остаток" skip
      599           "Объект" p-obj-type p-obj-code skip
      600           "Артикул" p-artic p-prod-type p-prod-code skip
      601           "Дата" p-fact-date skip
      602           view-as alert-box error .
      603         undo, return error .
      604       end.
      605       run partslib-init-temp-parts-by-factord in this-procedure
      606         (input p-obj-type
      607         ,input p-obj-code
      608         ,input p-artic
      609         ,input p-prod-type
      610         ,input p-prod-code
      611         ,input v-day-end-fact-order
      612         ,input false
      613         ) no-error .
      614       if error-status :error
      615       then do:
      616         message
      617           vss-workfile vss-revision vss-description skip
      618           vss-include-info0 skip
      619           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      620           "Объект" p-obj-type p-obj-code skip
      621           "Артикул" p-artic p-prod-type p-prod-code skip
      622           "Дата" p-fact-date skip
      623           view-as alert-box error .
      624         undo, return error .
      625       end.
      626     end.
      627   end procedure.
      628   procedure partslib-calc-cost :
      629     define output parameter p-fact-qnty      as decimal   no-undo .
      630     define output parameter p-vat-pc         as decimal   no-undo .
      631     define output parameter p-slt-pc         as decimal   no-undo .
      632     define output parameter p-sum-base       as decimal   no-undo .
      633     define output parameter p-sum-rubl       as decimal   no-undo .
      634     define output parameter p-vat-base       as decimal   no-undo .
      635     define output parameter p-vat-rubl       as decimal   no-undo .
      636     define output parameter p-slt-base       as decimal   no-undo .
      637     define output parameter p-slt-rubl       as decimal   no-undo .
      638     define output parameter p-road-tax-base  as decimal   no-undo .
      639     define output parameter p-road-tax-rubl  as decimal   no-undo .
      640     define output parameter p-transport-base as decimal   no-undo .
      641     define output parameter p-transport-rubl as decimal   no-undo .
      642     define output parameter p-other-base     as decimal   no-undo .
      643     define output parameter p-other-rubl     as decimal   no-undo .
      644     define output parameter p-excise-base    as decimal   no-undo .
      645     define output parameter p-excise-rubl    as decimal   no-undo .
      646     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      647     do
      648     on error undo, return error return-value
      649     :
      650       define buffer buf_temp-parts for temp-parts .
      651       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      652       define buffer   in-vatp-parts    for ub.parts   .
      653       define buffer   in-vatp-doc      for ub.trn-doc .
      654       define buffer   in-vatp-goods    for ub.goods   .
      655       define buffer   in-vatp-sysconf  for ub.sysconf .
      656       define buffer   in-vatp_doc-attr for ub.doc-attr.
      657       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      658       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      659       define variable varinvprb                  as   character              no-undo.
      660       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      661       define variable cli-base-rate              as   decimal                no-undo.
      662       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      663       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      664       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      665       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      666       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      667       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      668       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      669       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      670       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      671       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      672       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      673       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      674       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      675       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      676       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      677       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      678       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      679       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      680       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      681       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      682       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      683       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      684       define variable varinvatp-envd             as   character              no-undo.
      685       define variable varinvatp-type             as   character              no-undo.
      686       for each buf_temp-parts
      687       on error undo, return error
      688       :
      689   assign
      690     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      691     price-base-with-tax-loc = buf_temp-parts.price-base
      692   .
      693   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      694   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      695     (output varinvprb
      696     )  .
      697     if buf_temp-parts.out-code = 'free-zone':U     or
      698        buf_temp-parts.out-code = 'out-zone':U   or
      699        buf_temp-parts.doc-type = 'акт':U then do:
      700       assign
      701         in-vatp-have-vat-slt = yes.
      702     end.
      703     else do:
      704       find first in-vatp_doc-attr no-lock
      705         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      706           and in-vatp_doc-attr.attr-code = 'envd':U
      707         no-error .
      708       if not available in-vatp_doc-attr then do:
      709         assign
      710           in-vatp-have-vat-slt = yes.
      711       end.
      712       else do:
      713            in-vatp-have-vat-slt = no.
      714       end.
      715     end.
      716     assign
      717      price-cli-with-tax-loc = buf_temp-parts.price-cli
      718      cli-base-rate          = buf_temp-parts.cli-base-rate.
      719     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      720              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      721     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      722             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      723             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      724             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      725             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      726             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      727             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      728       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      729     assign
      730       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      731     assign
      732       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      733       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      734       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      735       transport-cli-loc  = 0
      736       other-cli-loc      = 0
      737     .
      738   ASSIGN
      739             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      740       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      741   .
      742         assign
      743           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      744           p-vat-pc         = p-vat-pc         + vat-pc-loc
      745           p-slt-pc         = p-slt-pc         + slt-pc-loc
      746           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      747           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      748           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      749           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      750           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      751           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      752           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      753           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      754           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      755           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      756           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      757           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      758           p-excise-base    = p-excise-base    + 0
      759           p-excise-rubl    = p-excise-rubl    + 0
      760         .
      761       end.
      762       if p-fact-qnty      = ?
      763       or p-sum-base       = ?
      764       or p-sum-rubl       = ?
      765       or p-vat-base       = ?
      766       or p-vat-rubl       = ?
      767       or p-slt-base       = ?
      768       or p-slt-rubl       = ?
      769       or p-road-tax-base  = ?
      770       or p-road-tax-rubl  = ?
      771       or p-transport-base = ?
      772       or p-transport-rubl = ?
      773       or p-other-base     = ?
      774       or p-other-rubl     = ?
      775       or p-excise-base    = ?
      776       or p-excise-rubl    = ?
      777       then do:
      778         message
      779           vss-workfile vss-revision vss-description skip
      780           vss-include-info0 skip
      781           "Программа in-vatp.i вернула неопределенные значения" skip
      782           "p-fact-qnty"      p-fact-qnty      skip
      783           "p-sum-base"       p-sum-base       skip
      784           "p-sum-rubl"       p-sum-rubl       skip
      785           "p-vat-base"       p-vat-base       skip
      786           "p-vat-rubl"       p-vat-rubl       skip
      787           "p-slt-base"       p-slt-base       skip
      788           "p-slt-rubl"       p-slt-rubl       skip
      789           "p-road-tax-base"  p-road-tax-base  skip
      790           "p-road-tax-rubl"  p-road-tax-rubl  skip
      791           "p-transport-base" p-transport-base skip
      792           "p-transport-rubl" p-transport-rubl skip
      793           "p-other-base"     p-other-base     skip
      794           "p-other-rubl"     p-other-rubl     skip
      795           "p-excise-base"    p-excise-base    skip
      796           "p-excise-rubl"    p-excise-rubl    skip
      797           view-as alert-box error .
      798         undo, return error .
      799       end.
      800     end.
      801   end procedure.
      802   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      803   define variable v-waitfram-action01         as character   no-undo .
      804   define variable v-waitfram-action02         as character   no-undo .
      805   define variable v-waitfram-action03         as character   no-undo .
      806   define variable mWaitFramTextBeg            as character   no-undo.
      807   define variable mWaitFramTextEnd            as character   no-undo.
      808   define variable mWaitFramView               as logical     no-undo.
      809   define variable mWaitProcEvent              as logical     no-undo init yes.
      810   define variable mWaitFramInterval           as integer     no-undo init 1 .
      811   define variable mWaitFramStop               as logical     no-undo.
      812   define variable mWaitFramStopUser           as logical     no-undo.
      813   define variable mWaitFramStopTimeOut        as logical     no-undo.
      814   define variable mWaitFramStartProc          as datetime-tz no-undo.
      815   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      816   define button B-WaitFramStop auto-end-key
      817        label "Стоп"
      818        size 10 by 1 tooltip "Остоновить процесс".
      819   define button B-viewProcInfo
      820        label "Информация"
      821        size 15 by 1 tooltip "Информация о процесс".
      822   define frame waitfram
      823     v-waitfram-action01 format "x(72)" no-label skip
      824     v-waitfram-action02 format "x(72)" no-label skip
      825     v-waitfram-action03 format "x(72)" no-label skip
      826     B-viewProcInfo
      827     B-WaitFramStop at row 4 col 30
      828     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      829     .
      830   define new global shared variable mBatchMode as logical no-undo init ?.
      831   define variable mFramBachModHandle as handle no-undo.
      832   mFramBachModHandle = frame waitfram:handle.
      833   define variable mFameOldVis as logical no-undo.
      834   define variable mVisCUrentVin as logical no-undo.
      835   if session:batch-mode
      836   then
      837      mBatchMode = yes.
      838   if mBatchMode = ? then do:
      839     mVisCUrentVin = current-window:visible.
      840     mFameOldVis = mFramBachModHandle:visible.
      841     mFramBachModHandle:visible  = yes.
      842     mBatchMode = mFramBachModHandle:visible ne yes.
      843     mFramBachModHandle:visible = mFameOldVis.
      844     current-window:visible = mVisCUrentVin.
      845   end.
      846    if  log-manager:logfile-name ne ?
      847     then DO:
      848         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      849         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      850         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      851     end.
      852   on choose of B-WaitFramStop in frame waitfram
      853   do:
      854     mWaitFramStop = yes.
      855     mWaitFramStopUser = yes.
      856   end.
      857   function waitfram-check-timeout returns logical():
      858      define variable vtime as int64 no-undo.
      859      if mWaitFramStopTimeOut
      860      then
      861         return yes.
      862      vtime = ( now - mWaitFramStartProc ) / 1000 .
      863      if     mWaitFramTimeOut ne ?
      864         and mWaitFramTimeOut ne 0
      865         and mWaitFramTimeOut lt vtime
      866      then do:
      867         mWaitFramStopTimeOut = yes.
      868      end.
      869      return mWaitFramStopTimeOut.
      870   end.
      871   procedure waitfram-hide :
      872     if not session:batch-mode
      873     then do
      874     on error undo, return error return-value
      875     :
      876       pause 0 before-hide .
      877       if not mBatchMode then
      878         hide frame waitfram .
      879     if     not mWaitFramView
      880        and mWaitProcEvent
      881     then
      882       process events .
      883     end.
      884   end procedure.
      885   procedure waitfram-show :
      886     define input  parameter p-message as character no-undo .
      887     define variable v-left-margin as integer   no-undo .
      888     if not session:batch-mode
      889     then do
      890     on error undo, return error return-value
      891     :
      892       if length(p-message) <= 70 then do:
      893         assign
      894           v-left-margin = integer((70 - length(p-message)) / 2)
      895         .
      896         assign
      897           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      898         .
      899         assign
      900           v-waitfram-action01 = " "
      901           v-waitfram-action02 = " "
      902                                    + fill(" ", v-left-margin)
      903                                    + p-message
      904           v-waitfram-action03 = " "
      905         .
      906       end.
      907       else do:
      908         define variable vRindex1 as integer no-undo.
      909         define variable vRindex2 as integer no-undo.
      910         vRindex1 = r-index(p-message," ",70).
      911         if vRindex1 = 0
      912         then
      913            vRindex1 = 70.
      914         if length(p-message)  <= vRindex1 + 70 then do:
      915           assign
      916             v-waitfram-action01 = " "
      917             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      918             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      919           .
      920         end.
      921         else do:
      922           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      923           if vRindex2 <= vRindex1
      924           then
      925              vRindex2 = vRindex1 + 70.
      926           assign
      927             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      928             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      929             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      930           .
      931         end.
      932       end.
      933       B-viewProcInfo:visible   in frame waitfram = no.
      934       B-viewProcInfo:sensitive in frame waitfram = no.
      935       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      936       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      937       if  (   mWaitFramView
      938          or  mWaitProcEvent)
      939          and not mBatchMode
      940       then
      941          display
      942             v-waitfram-action01 skip
      943             v-waitfram-action02 skip
      944             v-waitfram-action03 skip
      945          with frame waitfram .
      946       if     mWaitFramView
      947          then do:
      948             if     mWaitFramInterval ne ?
      949                and not mBatchMode
      950             then
      951                wait-for go of frame waitfram pause mWaitFramInterval.
      952          end.
      953          else
      954             if     mWaitProcEvent
      955                and not mBatchMode
      956             then
      957                process events .
      958     end.
      959   end procedure.
      960      procedure waitfram-show-this:
      961         define input  parameter iInterval as int64 no-undo.
      962         define variable vtime as int64 no-undo.
      963         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      964         mWaitFramInterval = iInterval.
      965         run waitfram-show (substitute("&1&2 &3&4" ,
      966                                       mWaitFramTextBeg ,
      967                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      968                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      969                                       mWaitFramTextEnd
      970                                      )
      971                           ).
      972      end.
      973      procedure WaitFramRunPause:
      974         define input  parameter iInterval as dec no-undo.
      975         define variable vStart  as datetime-tz no-undo.
      976         define variable vend    as datetime-tz no-undo.
      977         define variable vint as int64 no-undo.
      978         define variable vOk as logical no-undo.
      979         vStart = now.
      980         vend   = vStart.
      981         publish "WaitFramPause" (iInterval,output vOk).
      982         vend   =  now.
      983         vint = vend - vStart.
      984         vint = iInterval - vint / 1000.
      985         if     not mWaitFramStop
      986            and (   vint > 0
      987                 or (    not vOk
      988                     and iInterval eq ?
      989                     )
      990                 )
      991         then
      992            run waitfram-show-this (iInterval).
      993         vend   =  now.
      994         vint = vend - vStart.
      995         vint = iInterval - vint / 1000.
      996         if     not mWaitFramStop
      997            and vint > 0
      998         then do:
      999            run gbl/pause.p (vint * 1000).
     1000         end.
     1001         if iInterval ne ?
     1002         then
     1003            publish "WaitFramStop".
     1004         waitfram-check-timeout().
     1005      end.
     1006      procedure WaitFramWaitFor:
     1007         define input  parameter iInterval as dec no-undo.
     1008         assign
     1009            mWaitFramStartProc   = now
     1010            mWaitFramStopUser    = no
     1011            mWaitFramStopTimeOut = no
     1012         .
     1013         block-wait:
     1014         do while not mWaitFramStop:
     1015            run WaitFramRunPause (iInterval).
     1016            if  waitfram-check-timeout()
     1017            then do:
     1018               leave block-wait.
     1019            end.
     1020         end.
     1021         run waitfram-hide.
     1022      end.
     1023   procedure waitfram-join :
     1024     define input  parameter p-line-1  as character no-undo .
     1025     define input  parameter p-line-2  as character no-undo .
     1026     define input  parameter p-line-3  as character no-undo .
     1027     define output parameter p-message as character no-undo .
     1028     do
     1029     on error undo, return error return-value
     1030     :
     1031       assign
     1032         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1033                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1034                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1035       .
     1036     end.
     1037   end procedure.
     1038   function waitfram-join-function returns character
     1039     (input p-line-1 as character
     1040     ,input p-line-2 as character
     1041     ,input p-line-3 as character
     1042     ).
     1043     define variable v-message as character no-undo .
     1044     run waitfram-join in this-procedure
     1045       (input  p-line-1
     1046       ,input  p-line-2
     1047       ,input  p-line-3
     1048       ,output v-message
     1049       ) .
     1050     return v-message .
     1051   end function .
     1052   define temp-table temp-cli-gds no-undo
     1053     field temp-cli-type  like ub.cli-gds.cli-type
     1054     field temp-cli-code  like ub.cli-gds.cli-code
     1055     field temp-host-code like ub.cli-gds.host-code
     1056     field temp-artic     like ub.cli-gds.artic
     1057     field temp-prod-type like ub.cli-gds.prod-type
     1058     field temp-prod-code like ub.cli-gds.prod-code
     1059     field new-supp-qnty  like ub.cli-gds.supp-qnty
     1060     field new-supp-base  like ub.cli-gds.supp-base
     1061     field new-supp-rubl  like ub.cli-gds.supp-rubl
     1062     field old-supp-qnty  like ub.cli-gds.supp-qnty
     1063     field old-supp-base  like ub.cli-gds.supp-base
     1064     field old-supp-rubl  like ub.cli-gds.supp-rubl
     1065     index pi temp-cli-type temp-cli-code temp-host-code temp-artic temp-prod-type temp-prod-code
     1066   .
     1067   define variable v-num       as integer   no-undo .
     1068   define variable v-ind       as integer   no-undo .
     1069   define variable v-all-goods as logical   no-undo .
     1070   define variable v-gds-code  as integer   no-undo .
     1071   do
     1072   on error undo, return error return-value
     1073   :
     1074     run gbl/d-askw.w
     1075       (input "Вопрос"
     1076       ,input "Товарный архив по контрагентам." + chr(10)
     1077             + "Рассчет остатков по поставщикам"
     1078       ,input "|^"
     1079       ,input "Все товары^confirm|Выбрать товар|Отмена"
     1080       ,input "|"
     1081           + "|"
     1082           + ""
     1083       ,input 1
     1084       ,input 3
     1085       ,output v-num
     1086       ).
     1087     case v-num
     1088     :
     1089       when 1
     1090       then do:
     1091         assign
     1092           v-all-goods = true
     1093         .
     1094       end.
     1095       when 2
     1096       then do:
     1097         define variable rid-list as character no-undo.
     1098         run ref/gds-ref.p (
     1099                          input parparentproc
     1100                         ,input "'ПРОСМОТР':U,b-sel"
     1101                         ,input ?
     1102                         ,input ?
     1103                         ,input ?
     1104                         ,input ?
     1105                         ,input ?
     1106                         ,input ?
     1107                         ,input ?
     1108                         ,input ?
     1109                         ,input ?
     1110                         ,input ?
     1111                         ,output rid-list).
     1112         find ub.goods no-lock
     1113           where recid(ub.goods) = integer(rid-list)
     1114           no-error
     1115           .
     1116         if not available ub.goods
     1117         then do:
     1118           message
     1119             "Товар не выбран"
     1120             view-as alert-box information.
     1121           return .
     1122         end.
     1123         else do:
     1124           assign
     1125             v-all-goods = false
     1126             v-gds-code  = goods.gds-code
     1127           .
     1128         end.
     1129       end.
     1130       when 3
     1131       then do:
     1132         return .
     1133       end.
     1134       otherwise do:
     1135         message
     1136           vss-workfile vss-revision vss-description skip
     1137           "Неизвестное значение v-num" v-num skip
     1138           view-as alert-box error .
     1139         undo, return error return-value .
     1140       end.
     1141     end.
     1142     define query q-goods for goods .
     1143     if v-all-goods
     1144     then do:
     1145       open query q-goods
     1146         for each ub.goods no-lock
     1147           where ub.goods.gds-type = 'т':U
     1148       .
     1149     end.
     1150     else do:
     1151       open query q-goods
     1152         for each ub.goods no-lock
     1153           where ub.goods.gds-type = 'т':U
     1154             and ub.goods.gds-code = v-gds-code
     1155       .
     1156     end.
     1157     repeat
     1158     :
     1159       do
     1160       on error undo, next
     1161       on stop undo, return
     1162       :
     1163         get next q-goods .
     1164         if not available goods
     1165         then do:
     1166           leave .
     1167         end.
     1168         assign
     1169           v-ind = v-ind + 1
     1170         .
     1171         if v-ind modulo 10 = 0
     1172         then do:
     1173           run waitfram-show in this-procedure
     1174             (input waitfram-join-function(vss-description
     1175                                         ,substitute("Артикул: &1 &2 &3"
     1176                                                     ,goods.artic
     1177                                                     ,goods.prod-type
     1178                                                     ,goods.prod-code
     1179                                                     )
     1180                                         ,substitute("Обработано: &1"
     1181                                                     , v-ind
     1182                                                     )
     1183                                         )
     1184             ).
     1185         end.
     1186         run calc-supp-by-parts in this-procedure
     1187           (input  ub.goods.gds-code
     1188           ) .
     1189       end.
     1190     end.
     1191     run waitfram-hide in this-procedure .
     1192     if v-all-goods = false
     1193     then do:
     1194       message
     1195         vss-description "для товара "
     1196         string(v-gds-code)
     1197         "завершен"
     1198         view-as alert-box .
     1199     end.
     1200     else do:
     1201       message
     1202         vss-description "завершен"
     1203         view-as alert-box .
     1204     end.
     1205   end.
     1206   procedure calc-supp-by-parts :
     1207     define input  parameter p-gds-code as integer   no-undo .
     1208     define buffer buf_goods        for ub.goods     .
     1209     define buffer buf_gds-obj      for ub.gds-obj   .
     1210     define buffer buf_cli-gds      for ub.cli-gds   .
     1211     define buffer buf_temp-cli-gds for temp-cli-gds .
     1212     define buffer buf_temp-parts   for temp-parts   .
     1213     do transaction
     1214     on error undo, return error return-value
     1215     :
     1216       find first buf_goods no-lock
     1217         where buf_goods.gds-code = p-gds-code
     1218         .
     1219       for each buf_temp-cli-gds
     1220       on error undo, return error
     1221       :
     1222         delete buf_temp-cli-gds .
     1223       end.
     1224       for each buf_cli-gds exclusive-lock
     1225         where buf_cli-gds.artic     = buf_goods.artic
     1226           and buf_cli-gds.prod-type = buf_goods.prod-type
     1227           and buf_cli-gds.prod-code = buf_goods.prod-code
     1228       on error undo, return error return-value
     1229       :
     1230         create buf_temp-cli-gds .
     1231         assign
     1232           buf_temp-cli-gds.temp-cli-type  = buf_cli-gds.cli-type
     1233           buf_temp-cli-gds.temp-cli-code  = buf_cli-gds.cli-code
     1234           buf_temp-cli-gds.temp-host-code = buf_cli-gds.host-code
     1235           buf_temp-cli-gds.temp-artic     = buf_cli-gds.artic
     1236           buf_temp-cli-gds.temp-prod-type = buf_cli-gds.prod-type
     1237           buf_temp-cli-gds.temp-prod-code = buf_cli-gds.prod-code
     1238         .
     1239         assign
     1240           buf_temp-cli-gds.old-supp-qnty = buf_cli-gds.supp-base
     1241           buf_temp-cli-gds.old-supp-base = buf_cli-gds.supp-rubl
     1242           buf_temp-cli-gds.old-supp-rubl = buf_cli-gds.supp-qnty
     1243         .
     1244       end.
     1245       for each buf_gds-obj exclusive-lock
     1246         where buf_gds-obj.gds-code = p-gds-code
     1247       on error undo, return error
     1248       :
     1249         define variable v-host-code like ub.cli-gds.host-code no-undo .
     1250   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1251   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1252     (input  buf_gds-obj.obj-type
     1253     ,input  buf_gds-obj.obj-code
     1254     ,output v-host-code
     1255     )  .
     1256         run partslib-init-temp-parts in this-procedure
     1257           (input buf_gds-obj.obj-type
     1258           ,input buf_gds-obj.obj-code
     1259           ,input buf_gds-obj.artic
     1260           ,input buf_gds-obj.prod-type
     1261           ,input buf_gds-obj.prod-code
     1262           ) .
     1263         for each buf_temp-parts
     1264         on error undo, return error return-value
     1265         :
     1266           find first buf_temp-cli-gds
     1267             where buf_temp-cli-gds.temp-cli-type  = buf_temp-parts.supp-type
     1268               and buf_temp-cli-gds.temp-cli-code  = buf_temp-parts.supp-code
     1269               and buf_temp-cli-gds.temp-host-code = v-host-code
     1270               and buf_temp-cli-gds.temp-artic     = buf_temp-parts.artic
     1271               and buf_temp-cli-gds.temp-prod-type = buf_temp-parts.prod-type
     1272               and buf_temp-cli-gds.temp-prod-code = buf_temp-parts.prod-code
     1273             no-error .
     1274           if not available buf_temp-cli-gds
     1275           then do:
     1276             create buf_temp-cli-gds .
     1277             assign
     1278               buf_temp-cli-gds.temp-cli-type  = buf_temp-parts.supp-type
     1279               buf_temp-cli-gds.temp-cli-code  = buf_temp-parts.supp-code
     1280               buf_temp-cli-gds.temp-host-code = v-host-code
     1281               buf_temp-cli-gds.temp-artic     = buf_temp-parts.artic
     1282               buf_temp-cli-gds.temp-prod-type = buf_temp-parts.prod-type
     1283               buf_temp-cli-gds.temp-prod-code = buf_temp-parts.prod-code
     1284             .
     1285           end.
     1286           assign
     1287             buf_temp-cli-gds.new-supp-qnty = buf_temp-cli-gds.new-supp-qnty
     1288                                            + buf_temp-parts.fact-qnty
     1289             buf_temp-cli-gds.new-supp-base = buf_temp-cli-gds.new-supp-base
     1290                                            + (buf_temp-parts.price-base * buf_temp-parts.fact-qnty )
     1291             buf_temp-cli-gds.new-supp-rubl = buf_temp-cli-gds.new-supp-rubl
     1292                                            + (buf_temp-parts.price-rubl * buf_temp-parts.fact-qnty )
     1293           .
     1294         end.
     1295       end.
     1296       for each buf_temp-cli-gds
     1297         where (buf_temp-cli-gds.new-supp-qnty <> buf_temp-cli-gds.old-supp-qnty)
     1298            or (buf_temp-cli-gds.new-supp-base <> buf_temp-cli-gds.old-supp-base)
     1299            or (buf_temp-cli-gds.new-supp-rubl <> buf_temp-cli-gds.old-supp-rubl)
     1300       on error undo, return error
     1301       :
     1302   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1303   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cligdscr in g#library
     1304     (input  buf_temp-cli-gds.temp-cli-type
     1305     ,input  buf_temp-cli-gds.temp-cli-code
     1306     ,input  buf_temp-cli-gds.temp-host-code
     1307     ,input  buf_temp-cli-gds.temp-artic
     1308     ,input  buf_temp-cli-gds.temp-prod-type
     1309     ,input  buf_temp-cli-gds.temp-prod-code
     1310     ,buffer buf_cli-gds
     1311     )  .
     1312         find current buf_cli-gds exclusive-lock .
     1313         assign
     1314           buf_cli-gds.supp-qnty = buf_temp-cli-gds.new-supp-qnty
     1315           buf_cli-gds.supp-base = buf_temp-cli-gds.new-supp-base
     1316           buf_cli-gds.supp-rubl = buf_temp-cli-gds.new-supp-rubl
     1317         .
     1318       end.
     1319     end.
     1320   end procedure.
