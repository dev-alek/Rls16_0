        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type as character no-undo .
        3   define input  parameter p-obj-code as integer   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: delobjck.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/delobjck.p $":U .
        9   define variable vss-description as character no-undo init "Процедура проверки того, что объект можно удалять".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define buffer buf_scales-gds for ub.scales-gds.
       71   define buffer buf_gds-obj    for ub.gds-obj .
       72   define buffer buf_trn-doc    for ub.trn-doc .
       73   define buffer buf_price-doc  for ub.price-doc .
       74   define buffer buf_clients    for ub.clients .
       75   define buffer buf_dis-card   for ub.dis-card .
       76   define buffer buf_parts      for ub.parts .
       77   define variable v-host-code as integer   no-undo .
       78   do
       79   on error undo, return error return-value
       80   :
       81     find first buf_scales-gds no-lock
       82       where buf_scales-gds.obj-type = p-obj-type
       83         AND buf_scales-gds.obj-code = p-obj-code no-error .
       84     if available buf_scales-gds
       85     then do:
       86       return error "Существуют товары объекта на весах".
       87     end.
       88     find first buf_gds-obj no-lock
       89       where buf_gds-obj.obj-type = p-obj-type
       90         and buf_gds-obj.obj-code = p-obj-code
       91         and (buf_gds-obj.fact-qnty <> 0
       92             or buf_gds-obj.avrg-qnty <> 0
       93             )
       94       no-error .
       95     if available buf_gds-obj
       96     then do:
       97       return error substitute("Существует ненулевые остатки. Товар &1 &2 &3"
       98         ,buf_gds-obj.artic
       99         ,buf_gds-obj.prod-type
      100         ,buf_gds-obj.prod-code
      101         ) .
      102     end.
      103     find first buf_trn-doc no-lock
      104       where buf_trn-doc.obj-type = p-obj-type
      105         and buf_trn-doc.obj-code = p-obj-code
      106         and buf_trn-doc.status_  <> 'факт':U
      107         and buf_trn-doc.status_  <> 'запрос':U
      108       no-error .
      109     if available buf_trn-doc
      110     then do:
      111       return error substitute("Существует незакрытый документ. Документ &1"
      112         ,buf_trn-doc.doc-code
      113         ) .
      114     end.
      115     find first buf_trn-doc no-lock
      116       where buf_trn-doc.cli-type = p-obj-type
      117         and buf_trn-doc.cli-code = p-obj-code
      118         and buf_trn-doc.status_ <> 'факт':U
      119         and buf_trn-doc.status_ <> 'запрос':U
      120       no-error .
      121     if available buf_trn-doc
      122     then do:
      123       return error substitute("Существует незакрытый документ. Документ &1"
      124         ,buf_trn-doc.doc-code
      125         ) .
      126     end.
      127     find first buf_price-doc no-lock
      128       where buf_price-doc.obj-type = p-obj-type
      129         and buf_price-doc.obj-code = p-obj-code
      130         and buf_price-doc.status_  <> 'акт':U
      131       no-error.
      132     if available price-doc
      133     then do:
      134       return error substitute("Существует незакрытая переоценка. Документ &1"
      135         ,buf_price-doc.doc-num
      136         ) .
      137     end.
      138     if p-obj-type = 'маг':U
      139     then do:
      140       find first buf_clients no-lock where
      141               buf_clients.obj-type = p-obj-type
      142           AND buf_clients.obj-code = p-obj-code .
      143       for each buf_dis-card no-lock where
      144               buf_dis-card.emitent-host-code = 0
      145           or buf_dis-card.emitent-host-code = buf_clients.host-code:
      146         if buf_dis-card.issue-code = p-obj-code
      147         then do:
      148           return error substitute("Существует ДК выданная на объекте. ДК &1"
      149             ,buf_dis-card.d-card
      150             ) .
      151         end.
      152       end.
      153     end.
      154   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      156     (input  p-obj-type
      157     ,input  p-obj-code
      158     ,output v-host-code
      159     )  .
      160     for each buf_clients no-lock
      161       where buf_clients.host-code = v-host-code
      162     on error undo, return error return-value
      163     :
      164       if  buf_clients.obj-type = p-obj-type
      165       and buf_clients.obj-code = p-obj-code
      166       then do:
      167       end.
      168       else do:
      169         find first buf_parts no-lock
      170           where buf_parts.host-code = v-host-code
      171             and buf_parts.supp-type = p-obj-type
      172             and buf_parts.supp-code = p-obj-code
      173             and buf_parts.status_   = yes
      174             and buf_parts.obj-type  = buf_clients.obj-type
      175             and buf_parts.obj-code  = buf_clients.obj-code
      176           no-error .
      177         if available buf_parts
      178         then do:
      179           return error substitute("Существует партия порожденная текущим объектом на объекте &2 &3. Код партии &1"
      180             ,recid(buf_parts)
      181             ,buf_clients.obj-type
      182             ,buf_clients.obj-code
      183             ) .
      184         end.
      185       end.
      186     end.
      187   end.
