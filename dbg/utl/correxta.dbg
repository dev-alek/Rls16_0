        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: correxta.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/correxta.p $":U .
        7   define variable vss-description as character no-undo init "Корректировка статусов внешних артикулов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define stream slog.
       67   define stream sout.
       68   define buffer buf_goods     for ub.goods.
       69   define buffer buf_ext-artic for ub.ext-artic.
       70   define buffer sch_ext-artic for ub.ext-artic.
       71   define variable v-total-uncorret-rec  as integer   no-undo .
       72   define variable v-cur-stts-counter    as integer   no-undo .
       73   define variable v-del-stts-counter    as integer   no-undo .
       74   define variable v-log                 as logical   no-undo .
       75   define variable v-filename            as character no-undo .
       76   define variable v-full-filename       as character no-undo .
       77   define variable v-str                 as character no-undo .
       78   define variable v-i                   as integer   no-undo .
       79   define variable v-cli-str             as character no-undo .
       80   define variable v-cli-art             as character no-undo .
       81   define frame log-frame
       82     v-str               format "X(40)"      no-label                  skip
       83     v-i                 format ">>>>>>>>9"  label "Прочитано записей" skip
       84     v-cli-str           format "X(13)"      label "Поставщик"         skip
       85     v-cli-art           format "X(14)"      label "Внешний артикул"
       86     with view-as dialog-box side-labels three-d
       87     title "Корректировка статусов внешних артикулов"
       88   .
       89   do
       90   on error undo, return error return-value
       91   :
       92     run write-log in this-procedure ( input "Корректировка статусов внешних артикулов") .
       93     run calc-uncorrect-recs in this-procedure ( output v-total-uncorret-rec ) .
       94     run write-log in this-procedure ( input substitute("Найдено некорректных записей: &1 " , v-total-uncorret-rec )) .
       95     assign
       96       file-info :file-name = ".":U
       97     .
       98     message
       99       "Сохранить внешние артикулы в файл перед корректировкой ?" skip
      100     view-as alert-box question buttons yes-no update v-log.
      101     pause 0 before-hide.
      102     view frame log-frame.
      103     if v-log = yes
      104     then do :
      105       SYSTEM-DIALOG GET-FILE v-filename
      106                     TITLE   "Файл"
      107                     FILTERS "Резервная копия (*.bak)"    "*.bak",
      108                             "Все файлы (*.*)"    "*.*"
      109                     USE-FILENAME
      110                     UPDATE v-log.
      111       if v-log then do:
      112         assign
      113           v-full-filename = search(v-filename)
      114         .
      115         if v-full-filename <> ?
      116         then do:
      117           message
      118             "Файл " v-full-filename " будет перезаписан."
      119           view-as alert-box warning.
      120         end.
      121         assign
      122           v-str = "Экспорт некорректных внешних артикулов..."
      123         .
      124         output stream sout to value(v-filename).
      125         for each buf_ext-artic no-lock
      126           where buf_ext-artic.status_ <> 'тек':U
      127             and buf_ext-artic.status_ <> 'удал':U
      128         :
      129           assign
      130             v-i = v-i + 1
      131             v-cli-str = string(buf_ext-artic.cli-code, "999999999")  +  " "  +  trim(buf_ext-artic.cli-type)
      132             v-cli-art = buf_ext-artic.ext-artic
      133           .
      134           display
      135             v-str
      136             v-i
      137             v-cli-str
      138             v-cli-art
      139           with frame log-frame.
      140           export stream sout delimiter ";" buf_ext-artic.
      141         end.
      142         output stream sout close.
      143       end.
      144     end.
      145     assign
      146       v-str = "Корректировка внешних артикулов..."
      147       v-i   = 0
      148     .
      149     for each buf_ext-artic no-lock
      150       where buf_ext-artic.status_ <> 'тек':U
      151         and buf_ext-artic.status_ <> 'удал':U ,
      152       first buf_goods no-lock
      153         where buf_goods.gds-code = buf_ext-artic.gds-code
      154     :
      155       assign
      156         v-i = v-i + 1
      157         v-cli-str = string(buf_ext-artic.cli-code, "999999999")  +  " "  +  trim(buf_ext-artic.cli-type)
      158         v-cli-art = buf_ext-artic.ext-artic
      159       .
      160       display
      161         v-str
      162         v-i
      163         v-cli-str
      164         v-cli-art
      165       with frame log-frame.
      166       find first sch_ext-artic no-lock
      167         where sch_ext-artic.cli-type  = buf_ext-artic.cli-type
      168           and sch_ext-artic.cli-code  = buf_ext-artic.cli-code
      169           and sch_ext-artic.gds-code <> buf_ext-artic.gds-code
      170           and sch_ext-artic.ext-artic = buf_ext-artic.ext-artic
      171           and sch_ext-artic.status_   = 'тек':U
      172       use-index ea-stts
      173       no-error .
      174       if available(sch_ext-artic)
      175       then do:
      176         run write-log in this-procedure (input substitute( "Перевод вн. артикула &1 поставщик &2 &3 товара артик. &4 в статус '&5'"
      177                                                          , buf_ext-artic.ext-artic
      178                                                          , buf_ext-artic.cli-type
      179                                                          , buf_ext-artic.cli-code
      180                                                          , buf_goods.artic
      181                                                          , 'удал':U
      182                                                          )
      183                                         ).
      184         run ref/extartd.p ( buf_ext-artic.cli-type
      185                           , buf_ext-artic.cli-code
      186                           , buf_ext-artic.gds-code
      187                           , 'удал':U
      188                           ) no-error .
      189         if error-status :error
      190         then do:
      191           run write-log in this-procedure ( input substitute( "Ошибка при установке статуса &1 для записи &2 &3 &4 : &5 &6"
      192                                                             , 'удал':U
      193                                                             , buf_ext-artic.cli-type
      194                                                             , buf_ext-artic.cli-code
      195                                                             , buf_goods.artic
      196                                                             , trim(return-value)
      197                                                             , trim(error-status :get-message(1))
      198                                                             )
      199                                           ) .
      200         end.
      201       end.
      202       else do:
      203         run write-log in this-procedure (input substitute( "Перевод вн. артикула &1 поставщик &2 &3 товара артик. &4 в статус '&5'"
      204                                                          , buf_ext-artic.ext-artic
      205                                                          , buf_ext-artic.cli-type
      206                                                          , buf_ext-artic.cli-code
      207                                                          , buf_goods.artic
      208                                                          , 'тек':U
      209                                                          )
      210                                         ).
      211         run ref/extartd.p ( buf_ext-artic.cli-type
      212                           , buf_ext-artic.cli-code
      213                           , buf_ext-artic.gds-code
      214                           , 'тек':U
      215                           ) no-error .
      216         if error-status :error
      217         then do:
      218           run write-log in this-procedure ( input substitute( "Ошибка при установке статуса &1 для записи &2 &3 &4 : &5 &6"
      219                                                             , 'тек':U
      220                                                             , buf_ext-artic.cli-type
      221                                                             , buf_ext-artic.cli-code
      222                                                             , buf_ext-artic.gds-code
      223                                                             , trim(return-value)
      224                                                             , trim(error-status :get-message(1))
      225                                                             )
      226                                           ) .
      227         end.
      228       end.
      229     end.
      230     hide frame log-frame.
      231     run write-log in this-procedure ( input "Проверка статусов внешних артикулов") .
      232     run calc-uncorrect-recs in this-procedure ( output v-total-uncorret-rec ) .
      233     run write-log in this-procedure ( input substitute("Найдено некорректных записей: &1 " , v-total-uncorret-rec )) .
      234     run write-log in this-procedure ( input "Корректировка статусов внешних артикулов завершена") .
      235     message
      236       "Корректировка заершена." skip
      237       "Лог файл: " string( file-info :full-pathname + '\' +  "correct-ext-artic.log":U)
      238     view-as alert-box information.
      239   end.
      240   procedure calc-uncorrect-recs :
      241     define output parameter p-tot-recs as integer   no-undo .
      242   do
      243   on error undo, return error return-value
      244   :
      245     define variable v-tot-recs as integer   no-undo .
      246     for each buf_ext-artic no-lock
      247       where buf_ext-artic.status_ <> 'тек':U
      248         and buf_ext-artic.status_ <> 'удал':U
      249     :
      250       assign
      251         v-tot-recs = v-tot-recs + 1
      252       .
      253     end.
      254     assign
      255       p-tot-recs = v-tot-recs
      256     .
      257   end.
      258   end procedure.
      259   procedure write-log :
      260     define input parameter p-log-message as character no-undo.
      261   do
      262   on error undo, return error return-value
      263   :
      264     output stream slog to value("correct-ext-artic.log":U) append.
      265     put stream slog unformatted
      266       today chr(9)
      267       string(time, "hh:mm:ss") chr(9)
      268       p-log-message
      269       chr(10)
      270     .
      271     output stream slog close.
      272   end.
      273   end procedure.
