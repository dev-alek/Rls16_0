        1   block-level on error undo, throw.
        2   define input  parameter i-Text  as longchar no-undo.
        3   define input  parameter i-pasword as character no-undo.
        4   define input  parameter i-encrypt as logical   no-undo.
        5   define output parameter o-Text as longchar no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: 1eba0946c2d7, 3078, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        8   define variable vss-date        as character no-undo init "$Date: Пт авг 05 19:16:25 2022 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: filecrypchar.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/filecrypchar.p $":U .
       11   define variable vss-description as character no-undo init "шифрование текста".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info0 as character format "X(65)" no-undo
       67   initial "@(#)$Workfile$ $Revision$".
       68   procedure pencrypt :
       69          define input parameter ip-value-to-enc as character no-undo.
       70          define output parameter op-char-value  as character no-undo.
       71     define variable crypto-value           as raw       no-undo.
       72     do
       73     on error undo, return error return-value
       74     :
       75      assign
       76         crypto-value  = encrypt(ip-value-to-enc)
       77         op-char-value = base64-encode(crypto-value)
       78      no-error.
       79      if error-status:error then op-char-value = ? .
       80      end.
       81   end procedure.
       82   define variable vss-include-info1 as character format "X(65)" no-undo
       83   initial "@(#)$Workfile$ $Revision$".
       84   procedure pdecrypt :
       85        define input  parameter ip-value-to-dec as character no-undo.
       86        define output parameter op-char-value   as character no-undo.
       87     define variable decrypt-value          as raw       no-undo.
       88     define variable long-char-value        as longchar  no-undo.
       89     do
       90     on error undo, return error return-value
       91     :
       92      assign
       93         long-char-value = ip-value-to-dec
       94         op-char-value   = get-string(decrypt(base64-decode(long-char-value)),1)
       95         long-char-value = ""
       96      no-error.
       97      if error-status:error then op-char-value = ? .
       98      end.
       99   end procedure.
      100   do
      101   on error undo, return error
      102   :
      103      if i-encrypt = ? then do:
      104         return error "Не опредлено дейcтвие".
      105      end.
      106      security-policy:symmetric-encryption-key = generate-pbe-key(i-pasword).
      107      if i-encrypt
      108      then do:
      109   define variable vss-include-info2 as character format "X(65)" no-undo
      110   initial "@(#)$Workfile$ $Revision$".
      111   run pencrypt in this-procedure (input  i-Text
      112     ,output o-Text
      113     )  .
      114      end.
      115      else do:
      116   define variable vss-include-info3 as character format "X(65)" no-undo
      117   initial "@(#)$Workfile$ $Revision$".
      118   run pdecrypt in this-procedure (input  i-Text
      119     ,output o-Text
      120     )  .
      121      end.
      122   end.
