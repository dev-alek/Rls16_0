      851           .
      852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      853     (input  'ph-dir':u
      854     ,input  '':u
      855     ,input  '':u
      856     ,input  0
      857     ,input  '':u
      858     ,input  '':u
      859     ,input  '':u
      860     ,input  NO
      861     ,output vPar-val
      862     ,output vPar-type
      863     ) no-error .
      864       IF LENGTH (vPar-val) = 0 THEN
      865           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
      866       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
      867       ASSIGN
      868           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
      869           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
      870           mImagePreDir = mImagePath
      871           mImageDir    = mImagePreDir
      872           mImageTrash  = mImagePath + "trash\":U
      873           .
      874       ASSIGN
      875           vPar-val  = "":U
      876           vPar-type = "":U
      877           .
      878               run adm/shattri.p (
      879           input "get":U
      880           ,input  '':U
      881           ,input  0
      882           ,input  'gds-ref':U
      883           ,input  'shema-foto':U
      884           ,output v-value-char
      885           ,output v-val-date
      886           ,output v-val-decimal
      887           ,output v-val-integer
      888           ,output v-val-logical
      889           ,output v-param-types
      890           ,INPUT-OUTPUT table-handle v-tthd
      891           ) no-error.
      892           delete object v-tthd.
      893           mPhotomgd = IF v-val-integer = 2 then yes else no.
      894   END PROCEDURE.
      895   PROCEDURE imagelist_decode:
      896       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      897       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
      898       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      899       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      900       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      901       ASSIGN
      902           oImageList = iImageList
      903           .
      904       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      905           vCh =ENTRY (vInt, iImageList, ",":U).
      906           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
      907           ELSE
      908           DO:
      909               ASSIGN
      910                   vCh = REPLACE (vCh, "~/":U, "\":U)
      911                   vCh = REPLACE (vCh, "~\":U, "\":U)
      912                   .
      913               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
      914               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
      915               ENTRY (vInt, oImageList, ",":U) = vCh.
      916           END.
      917       END.
      918   END PROCEDURE.
      919   PROCEDURE imagelist_encode:
      920       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      921       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      922       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      923       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      924       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
      925       ASSIGN
      926           oImageList = iImageList
      927           vLen       = LENGTH (mImageDir)
      928           .
      929       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      930           vCh =ENTRY (vInt, iImageList, ",":U).
      931           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
      932               ENTRY (vInt, oImageList, ",":U) =
      933                   SUBSTRING (vCh, vLen + 1).
      934       END.
      935   END PROCEDURE.
      936   IF mImagePh THEN .
      937       ELSE RETURN.
      938   RUN verify-file (mImagePath,
      939       "Не найден каталог " + mImagePath + chr(10) +
      940       "параметр конфигурации ph-dir",
      941       NO, OUTPUT mLogical) NO-ERROR.
      942   IF ERROR-STATUS:ERROR OR NOT mLogical THEN RETURN ERROR.
      943   SYSTEM-DIALOG GET-DIR mOldDir
      944       INITIAL-DIR  mOldDir
      945       TITLE "Исходная директория"
      946       .
      947   IF mOldDir > "":U THEN .
      948   ELSE RETURN.
      949   mLogFile = SUBSTITUTE ("&1&2.txt":U, SESSION:TEMP-DIRECTORY, GUID).
      950   OUTPUT STREAM mLogStr TO VALUE (mLogFile).
      951   RUN ProcDir IN THIS-PROCEDURE (mOldDir).
      952   OUTPUT STREAM mLogStr CLOSE.
      953   OS-COMMAND NO-WAIT VALUE (
      954       SUBSTITUTE ("notepad ~"&1~"":U, mLogFile)).
      955   FUNCTION DeBase RETURNS INTEGER PRIVATE
      956       (iString AS CHARACTER , iBase AS INTEGER):
      957       DEFINE VARIABLE vPos  AS INTEGER    NO-UNDO.
      958       DEFINE VARIABLE vRes  AS INTEGER    NO-UNDO.
      959       DEFINE VARIABLE vMul  AS INTEGER    NO-UNDO.
      960       DEFINE VARIABLE vCode AS INTEGER    NO-UNDO.
      961       IF iString = ? THEN RETURN ?.
      962       IF iBase >= 2 AND iBase <= 36 THEN .
      963       ELSE RETURN ?.
      964       iString = TRIM (iString).
      965       IF LENGTH (iString) = 0 THEN RETURN 0.
      966       vMul = 1.
      967       DO vPos = LENGTH (iString) TO 1 BY -1:
      968           vCode = ASC (SUBSTRING (iString, vPos, 1)).
      969           IF vCode < 48 OR vCode > 90 THEN RETURN ?.
      970           vRes = vRes + vMul * (vCode - IF vCode <= 57 THEN 48 ELSE 55).
      971           IF vPos > 1 THEN vMul = vMul * iBase.
      972       END.
      973       RETURN vRes.
      974   END FUNCTION.
      975   PROCEDURE ProcDir PRIVATE:
      976       DEFINE INPUT PARAMETER iDir AS CHARACTER  NO-UNDO.
      977       DEFINE VARIABLE vSubDirList AS LONGCHAR   NO-UNDO.
      978       DEFINE VARIABLE vCounter    AS INTEGER    NO-UNDO.
      979       DEFINE VARIABLE vShortFName AS CHARACTER  NO-UNDO.
      980       DEFINE VARIABLE vFullFName  AS CHARACTER  NO-UNDO.
      981       DEFINE VARIABLE vFileAttr   AS CHARACTER  NO-UNDO.
      982       INPUT STREAM mDirStr FROM OS-DIR (iDir).
      983       FileBlock:
      984       REPEAT:
      985           IMPORT STREAM mDirStr vShortFName vFullFName vFileAttr.
      986           IF vShortFName = ".":U OR vShortFName = "..":U THEN NEXT FileBLock.
      987           IF INDEX (vFileAttr, "D":U) > 0 THEN
      988           DO:
      989               vSubDirList = vSubDirList + "~n":U + vFullFName.
      990               NEXT FileBLock.
      991           END.
      992           RUN ProcFile (vShortFName, vFullFName).
      993       END.
      994       vSubDirList = TRIM (vSubDirList, "~n":U).
      995       IF LENGTH (vSubDirList) > 0 THEN
      996       DO vCounter = 1 TO NUM-ENTRIES (vSubDirList, "~n":U):
      997           RUN ProcDir (ENTRY (vCounter, vSubDirList, "~n":U)).
      998       END.
      999   END PROCEDURE.
     1000   PROCEDURE ProcFile PRIVATE:
     1001       DEFINE INPUT PARAMETER iShortFName AS CHARACTER  NO-UNDO.
     1002       DEFINE INPUT PARAMETER iFullFName  AS CHARACTER  NO-UNDO.
     1003       DEFINE VARIABLE vBarID             AS INTEGER    NO-UNDO INITIAL ?.
     1004       DEFINE VARIABLE vGdsID             AS INTEGER    NO-UNDO INITIAL ?.
     1005       DEFINE VARIABLE vGdsName           AS CHARACTER  NO-UNDO.
     1006       DEFINE VARIABLE vLogFormat         AS CHARACTER  NO-UNDO
     1007           INITIAL "&1~t&2~t&3~t&4~t&5~t&6~t&7":U.
     1008       DEFINE VARIABLE vNewFName          AS CHARACTER  NO-UNDO.
     1009       DEFINE VARIABLE mImageList         AS CHARACTER  NO-UNDO.
     1010       DEFINE VARIABLE vCh                AS CHARACTER  NO-UNDO.
     1011       DEFINE BUFFER bar-code FOR bar-code.
     1012       DEFINE BUFFER goods    FOR goods.
     1013       vBarID = DeBase ( ENTRY (1, iShortFName, ".":U), 16).
     1014       IF vBarID <> ? THEN
     1015       DO:
     1016           FOR FIRST bar-code NO-LOCK WHERE bar-code.b-code = vBarID,
     1017               FIRST goods    NO-LOCK WHERE goods.gds-code  = bar-code.gds-code:
     1018               ASSIGN
     1019                   vGdsID    = goods.gds-code
     1020                   vGdsName  = goods.gds-name.
     1021               IF mPhotomgd THEN
     1022                   mImageDir = SUBSTITUTE ("&1&2\":U, mImagePreDir, vGdsID).
     1023               ASSIGN
     1024                   vNewFName = mImageDir + STRING (vGdsID) +
     1025                       SUBSTRING (iShortFName, INDEX (iShortFName, ".":U))
     1026                   .
     1027               IF LENGTH (SEARCH (vNewFName)) > 0 THEN
     1028               DO:
     1029                   PUT STREAM mLogStr UNFORMATTED
     1030                       SUBSTITUTE (vLogFormat, NOW, "ERROR2":U,
     1031                       iFullFName, vNewFName, vGdsID, vGdsName,
     1032                       "Файл уже существует.") SKIP.
     1033               END.
     1034               RUN verify-file (mImagePreDir, "":U, YES, OUTPUT mLogical) NO-ERROR.
     1035               IF ERROR-STATUS:ERROR OR NOT mLogical THEN
     1036               DO:
     1037                   OS-CREATE-DIR VALUE (mImagePreDir).
     1038                   IF OS-ERROR <> 0 THEN
     1039                   DO:
     1040                       PUT STREAM mLogStr UNFORMATTED
     1041                           SUBSTITUTE (vLogFormat, NOW, "ERROR3":U,
     1042                           iFullFName, vNewFName, vGdsID, vGdsName,
     1043                           SUBSTITUTE ("Ошибка &1 создания поддиректории &2",
     1044                                           OS-ERROR, mImagePreDir)) SKIP.
     1045                       RETURN.
     1046                   END.
     1047               END.
     1048               RUN verify-file (mImageDir, "":U, YES, OUTPUT mLogical) NO-ERROR.
     1049               IF ERROR-STATUS:ERROR OR NOT mLogical THEN
     1050               DO:
     1051                   OS-CREATE-DIR VALUE (mImageDir).
     1052                   IF OS-ERROR <> 0 THEN
     1053                   DO:
     1054                       PUT STREAM mLogStr UNFORMATTED
     1055                           SUBSTITUTE (vLogFormat, NOW, "ERROR4":U,
     1056                           iFullFName, vNewFName, vGdsID, vGdsName,
     1057                           SUBSTITUTE ("Ошибка &1 создания поддиректории &2",
     1058                                           OS-ERROR, mImageDir)) SKIP.
     1059                       RETURN.
     1060                   END.
     1061               END.
     1062               OS-COPY VALUE (iFullFName) VALUE (vNewFName).
     1063               IF OS-ERROR <> 0 THEN
     1064               DO:
     1065                   PUT STREAM mLogStr UNFORMATTED
     1066                       SUBSTITUTE (vLogFormat, NOW, "ERROR5":U,
     1067                           iFullFName, vNewFName, vGdsID, vGdsName,
     1068                           SUBSTITUTE ("Ошибка &1 копирования файла &2 в &3",
     1069                                       OS-ERROR, iFullFName, vNewFName)) SKIP.
     1070                   RETURN.
     1071               END.
     1072               RUN gds-attr-value (vGdsID, "image-list":U, OUTPUT mImageList, OUTPUT vCh).
     1073               RUN imagelist_decode IN THIS-PROCEDURE (INPUT mImageList,vGdsID, OUTPUT mImageList).
     1074               mImageList = (IF LENGTH (mImageList) > 0 THEN mImageList + ",":U
     1075                   ELSE "":U) + vNewFName.
     1076               RUN imagelist_encode IN THIS-PROCEDURE (INPUT mImageList, OUTPUT mImageList).
     1077               RUN gds-attr-write (vGdsID, "image-list":U, mImageList).
     1078               PUT STREAM mLogStr UNFORMATTED SUBSTITUTE (vLogFormat, NOW, "OK":U,
     1079                   iFullFName, vNewFName, vGdsID, vGdsName) SKIP.
     1080               RETURN.
     1081           END.
     1082       END.
     1083           PUT STREAM mLogStr UNFORMATTED SUBSTITUTE (vLogFormat, NOW, "ERROR1":U,
     1084               iFullFName, vBarID, vGdsID,            "Не найден товар") SKIP.
     1085           RETURN.
     1086   END PROCEDURE.
