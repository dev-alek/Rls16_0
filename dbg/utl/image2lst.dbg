      720   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      721   PROCEDURE verify-ini-entry:
      722   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      723   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      724   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      725   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      726   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      727   define variable v-mess as character no-undo .
      728   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      729   if ini-entry-value = ? and ini-key-name begins "spl"
      730   then
      731   get-key-value section ini-section-name key "splall" value ini-entry-value.
      732   if ini-entry-value = ? and ini-key-name begins "sav"
      733   then
      734   get-key-value section ini-section-name key "savall" value ini-entry-value.
      735   if ini-entry-value = ? then do:
      736     assign
      737     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      738                       , chr(10)
      739                       , ini-section-name
      740                       , ini-key-name
      741                       , error-msg-text).
      742       if not silence then do:
      743         message
      744         v-mess
      745         view-as alert-box ERROR  .
      746         return error.
      747       end.
      748       else do:
      749         return error v-mess.
      750       end.
      751   end.
      752   END PROCEDURE.
      753   PROCEDURE verify-file:
      754   DEFINE INPUT  PARAMETER filename       as character no-undo.
      755   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      756   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      757   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      758   file-info:file-name = filename.
      759   found = NOT (file-info:full-pathname = ?).
      760   if NOT found  then do:
      761     if not silence then do:
      762       message error-msg-text
      763       view-as alert-box ERROR.
      764       return error.
      765     end.
      766     else return error error-msg-text.
      767   end.
      768   END PROCEDURE.
