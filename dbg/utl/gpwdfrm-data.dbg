        1   using Progress.Lang.*.
        2   using utl.*.
        3   block-level on error undo, throw.
        4   class utl.gpwdfrm-data:
        5      method public "System.Collections.Generic.List<System.Object>" GetShopList():
        6         def buffer b-clients for clients.
        7         def var vItem as class net-item no-undo.
        8         def var vShopList as class "System.Collections.Generic.List<System.Object>" no-undo.
        9         vShopList = new "System.Collections.Generic.List<System.Object>"().
       10         for each b-clients where b-clients.obj-type = 'маг':U no-lock:
       11            vItem = new net-item(string(b-clients.obj-code),
       12                                 b-clients.obj-type + "," + string(b-clients.obj-code),
       13                                 b-clients.obj-name).
       14            vShopList:Add(vItem).
       15         end.
       16         return vShopList.
       17      end method.
       18      method public "System.Collections.Generic.List<System.Object>" GetCashDeskList(iShopSurr as char):
       19         def buffer b-clients for clients.
       20         def buffer b-cash-desk for cash-desk.
       21         def var vItem as class net-item no-undo.
       22         def var vItems as class "System.Collections.Generic.List<System.Object>" no-undo.
       23         vItems = new "System.Collections.Generic.List<System.Object>"().
       24         find first b-clients where
       25                    b-clients.obj-type = entry(1,iShopSurr)
       26                and b-clients.obj-code = int(entry(2,iShopSurr))
       27         no-lock no-error.
       28         if avail b-clients then
       29         do:
       30            for each b-cash-desk where
       31                     b-cash-desk.obj-code = b-clients.obj-code
       32             and not b-cash-desk.is-del
       33            no-lock
       34            by b-cash-desk.cash-num:
       35               vItem = new net-item(string(b-cash-desk.cash-num),
       36                                    string(b-cash-desk.db-num) + "," +
       37                                    string(b-cash-desk.obj-code) + "," +
       38                                    string(b-cash-desk.pos-type) + "," +
       39                                    string(b-cash-desk.cash-num)).
       40               vItems:Add(vItem).
       41            end.
       42         end.
       43         return vItems.
       44      end method.
       45      method public "System.Collections.Generic.List<System.Object>" GetUserList():
       46         def var vItem as class net-item no-undo.
       47         def var vItems as class "System.Collections.Generic.List<System.Object>" no-undo.
       48         vItems = new "System.Collections.Generic.List<System.Object>"().
       49         return vItems.
       50      end method.
       51      method public net-item GetCashDesk(iSurr as char):
       52         def buffer b-cash-desk for cash-desk.
       53         define variable vNetItem as class net-item no-undo.
       54         vNetItem = new net-item().
       55         find first b-cash-desk where
       56                    b-cash-desk.db-num   = int64(entry(1,iSurr))
       57                and b-cash-desk.obj-code = int64(entry(2,iSurr))
       58                and b-cash-desk.pos-type = entry(3,iSurr)
       59                and b-cash-desk.cash-num = int64(entry(4,iSurr))
       60         no-lock no-error.
       61         if avail b-cash-desk then
       62         do:
       63            assign
       64               vNetItem:DisplayName = string(b-cash-desk.cash-num)
       65               vNetItem:Value = iSurr
       66            .
       67         end.
       68         return vNetItem.
       69      end method.
       70      method public net-item GetShop(iSurr as char):
       71         def buffer b-clients for clients.
       72         define variable vNetItem as class net-item no-undo.
       73         vNetItem = new net-item().
       74         find first b-clients where
       75                    b-clients.obj-type = entry(1,iSurr)
       76                and b-clients.obj-code = int(entry(2,iSurr))
       77         no-lock no-error.
       78         if avail b-clients then
       79         do:
       80            assign
       81               vNetItem:DisplayName = string(b-clients.obj-code)
       82               vNetItem:Value = iSurr
       83               vNetItem:Desctiption = b-clients.obj-name
       84            .
       85         end.
       86         return vNetItem.
       87      end method.
       88      method public char GetShopSurrogate(iShop as char):
       89         def buffer b-clients for clients.
       90         define variable vSurr as character no-undo.
       91         for first b-clients where
       92                    b-clients.obj-type = 'маг':U
       93                and b-clients.obj-code = int64(iShop)
       94         no-lock:
       95            vSurr = b-clients.obj-type + "," + string(b-clients.obj-code).
       96         end.
       97         return vSurr.
       98      end method.
       99      method public char GetUserLogin():
      100         define variable vUserLogin as char no-undo.
      101         define buffer buf_user-account for ub.user-account .
      102         vUserLogin = ibs.th.gbl.gbl-var:g#userid.
      103         return vUserLogin.
      104      end method.
      105      method public void ValidateShop(
      106         iShop as char,
      107         iComboBox as System.Windows.Forms.ComboBox):
      108         def var vShop as int64 no-undo.
      109         def buffer b-clients for clients.
      110         assign
      111            vShop = int64(iShop)
      112         no-error.
      113         if error-status:error
      114         or vShop <= 0 then
      115         do:
      116            if valid-object(iComboBox) then iComboBox:Focus().
      117            undo, throw new ValidateError("Неверное значение магазина",-1).
      118         end.
      119         if not can-find(b-clients where
      120                         b-clients.obj-type = 'маг':U
      121                     and b-clients.obj-code = vShop
      122                     no-lock) then
      123         do:
      124            if valid-object(iComboBox) then iComboBox:Focus().
      125            undo, throw new ValidateError("Код магазина не найден в базе",-1).
      126         end.
      127      end method.
      128      method public void ValidateCashDesk(
      129         iShopSurr as char,
      130         iCashNum  as char,
      131         iComboBox as System.Windows.Forms.ComboBox):
      132         def var vCashNum as int64 no-undo.
      133         def buffer b-clients   for clients.
      134         def buffer b-cash-desk for cash-desk.
      135         if num-entries(iShopSurr) <> 2 then
      136         do:
      137            if valid-object(iComboBox) then iComboBox:Focus().
      138            undo, throw new ValidateError("Ошибка с выбором магазина",-1).
      139         end.
      140         assign
      141            vCashNum = int64(iCashNum)
      142         no-error.
      143         if error-status:error
      144         or vCashNum < 0 then
      145         do:
      146            if valid-object(iComboBox) then iComboBox:Focus().
      147            undo, throw new ValidateError("Неверное значение магазина при выборе кассы",-1).
      148         end.
      149         find first b-clients where
      150                    b-clients.obj-type = entry(1,iShopSurr)
      151                and b-clients.obj-code = int64(entry(2,iShopSurr))
      152         no-lock no-error.
      153         if not avail b-clients then
      154         do:
      155            if valid-object(iComboBox) then iComboBox:Focus().
      156            undo, throw new ValidateError("Магазин не найден в базе",-1).
      157         end.
      158         if not can-find(first b-cash-desk where
      159                               b-cash-desk.obj-code = b-clients.obj-code
      160                           and b-cash-desk.cash-num = vCashNum no-lock) then
      161         do:
      162            if valid-object(iComboBox) then iComboBox:Focus().
      163            undo, throw new ValidateError("Нет такой кассы",-1).
      164         end.
      165      end method.
      166      method public char GetCli():
      167         def buffer bclients for clients.
      168         def var v-rid-list as char no-undo.
      169         def var vCli       as char no-undo.
      170         run ref/cli-all.w (gpwdbrw:parParentProc
      171                     ,input "b-sel"
      172                     ,input 'чел':U
      173                     ,input 'все':U
      174                     ,input 'текущие':U
      175                     ,input ?
      176                     ,input ",,,,,,NO,,"
      177                     ,input "":U
      178                     ,output v-rid-list) no-error.
      179         if (v-rid-list <> "" or v-rid-list <> ?) and num-entries(v-rid-list) = 1 then
      180         do:
      181            for first bclients where
      182                recid(bclients) = int64(v-rid-list)
      183            no-lock:
      184               vCli = bclients.obj-name.
      185            end.
      186         end.
      187         return vCli.
      188      end method.
      189      method public char TransChar(iChar as char):
      190         define variable vChar as character no-undo.
      191         if length(iChar) = 4 then
      192            vChar = substitute("&1:&2",substring(iChar,1,2),substring(iChar,3,4)).
      193         else
      194            vChar = iChar.
      195         return vChar.
      196      end method.
      197   end class.
