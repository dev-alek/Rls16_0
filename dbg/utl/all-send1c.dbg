        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO .
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define new global shared variable g#library  as handle no-undo .
        8   define new global shared variable g#library2 as handle no-undo .
        9   define   shared variable g#auto as logical no-undo.
       10   define   shared variable g#news as logical no-undo.
       11   define   shared variable g#oxml as logical no-undo.
       12   define   shared variable g#esys as logical no-undo.
       13   define   shared variable g#news-source-db as integer no-undo.
       14   define   shared variable g#esys-source-esys as integer no-undo.
       15   define   shared variable g#db-num as integer   no-undo .
       16   define   shared variable g#userid as character no-undo .
       17   define   shared variable g#passwd as character no-undo .
       18   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       19   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       20   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       21   define new global shared variable g#trdcalib as handle no-undo.
       22   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
       23       then run str/lib-trn.p persistent no-error .
       24   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn2)
       25       then run str/lib-trn2.p persistent no-error .
       26   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
       27       then run str/lib-trn3.p persistent no-error .
       28   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn4)
       29       then run str/lib-trn4.p persistent no-error .
       30   if not valid-handle (ibs.th.gbl.gbl-hndllib:g#trdcalib)
       31       then run str/trdcalib.p persistent no-error .
       32   define buffer buf_shift-obj for ub.shift-obj .
       33   define variable v-obj-type as character no-undo .
       34   define variable v-obj-code as integer   no-undo .
       35   define variable v-sht-date as date      no-undo .
       36   define variable v-sht-num  as integer   no-undo .
       37   define variable varvalue   as character no-undo .
       38   define variable vartype    as character no-undo .
       39   define button btnOk auto-go label "Ok" .
       40   define button btnCancel auto-endkey label "Cancel".
       41   define temp-table tt-shift like ub.shift-obj .
       42   define temp-table tt-trn like ub.trn-doc.
       43   define temp-table tt-price-doc like ub.price-doc.
       44   define temp-table tt-rvs like ub.rvs-doc.
       45   define temp-table tt-fbr like ub.fbr-doc.
       46   define temp-table tt-fin like ub.fin-doc.
       47   define temp-table tt-utd like ub.utd .
       48   DEFINE FRAME frame1
       49       skip
       50       v-obj-code format ">>>>>>>>9"  label "Код магазина"
       51       skip    space(2) v-sht-date format "99/99/9999" label "Дата смены"
       52       space(2) v-sht-num                      label "Порядок смены"
       53       skip(1) space(2) btnOk
       54       space(2) btnCancel
       55       with
       56       side-labels
       57       default-button btnOk
       58       cancel-button btnCancel
       59       view-as dialog-box
       60       title "Введите номер код магазина, дату и номер смены"
       61       .
       62   update v-obj-code v-sht-date v-sht-num btnOk btnCancel with frame frame1.
       63   find first buf_shift-obj no-lock
       64       where buf_shift-obj.obj-type = 'маг'
       65       and buf_shift-obj.obj-code = v-obj-code
       66       and buf_shift-obj.shift-date = v-sht-date
       67       and buf_shift-obj.shift-num  = v-sht-num no-error .
       68   if not available (buf_shift-obj) then
       69   do:
       70       message substitute("Отсутствует смена №&1 от &2 в магазине &3",
       71           v-sht-num, v-sht-date, v-obj-code) view-as alert-box.
       72       return.
       73   end.
       74   buffer-copy buf_shift-obj except buf_shift-obj.status_ to tt-shift  assign tt-shift.status_ = "накл".
       75   for each ub.trn-doc no-lock where ub.trn-doc.obj-type = buf_shift-obj.obj-type
       76       and ub.trn-doc.obj-code = buf_shift-obj.obj-code
       77       and ub.trn-doc.shift-date = buf_shift-obj.shift-date
       78       and ub.trn-doc.shift-num = buf_shift-obj.shift-num :
       79       buffer-copy ub.trn-doc except ub.trn-doc.status_ to tt-trn  assign
       80           tt-trn.status_ = "накл".
       81   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
       82     (input ?
       83     ,input this-procedure:handle
       84     ,input ?
       85     ,input 'event_trn-doc':U
       86     ,input  buffer tt-trn:handle
       87     ,input  buffer ub.trn-doc:handle
       88     ,input ''
       89     ,input ''
       90     ) no-error .
       91   if error-status:error
       92   then do:
       93     message return-value view-as alert-box.
       94   end.
       95   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
       96                           input 'is-lgas':U ,
       97                          output varvalue ,
       98                          output vartype ) no-error .
       99     if varvalue = "yes" then
      100     do:
      101       run bge\send1cerp.p (?,
      102         this-procedure,
      103         this-procedure,
      104         "techlosses",
      105         (buffer ub.trn-doc:handle),
      106         ?,
      107         ?) no-error.
      108       if error-status:error
      109         then
      110       do:
      111         message return-value view-as alert-box.
      112       end.
      113     end.
      114   for each tt-trn:
      115       delete tt-trn .
      116   end.
      117   end.
      118   for each ub.price-doc no-lock where ub.price-doc.obj-code = buf_shift-obj.obj-code and
      119       ub.price-doc.obj-type = buf_shift-obj.obj-type and
      120       ub.price-doc.shift-date = buf_shift-obj.shift-date and
      121       ub.price-doc.shift-num = buf_shift-obj.shift-num :
      122       buffer-copy ub.price-doc except ub.price-doc.status_ to tt-price-doc  assign
      123           tt-price-doc.status_ = "приказ".
      124   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      125     (input ?
      126     ,input this-procedure:handle
      127     ,input ?
      128     ,input 'event_price-doc':U
      129     ,input  buffer tt-price-doc:handle
      130     ,input  buffer ub.price-doc:handle
      131     ,input ''
      132     ,input ''
      133     ) no-error .
      134   if error-status:error
      135       then
      136   do:
      137       message return-value view-as alert-box.
      138   end.
      139   for each tt-price-doc:
      140       delete tt-price-doc .
      141   end.
      142   end.
      143   for each ub.rvs-doc no-lock where ub.rvs-doc.obj-code = buf_shift-obj.obj-code and
      144       ub.rvs-doc.obj-type = buf_shift-obj.obj-type and
      145       ub.rvs-doc.shift-date = buf_shift-obj.shift-date and
      146       ub.rvs-doc.shift-num = buf_shift-obj.shift-num:
      147       buffer-copy rvs-doc except rvs-doc.status_ to tt-rvs  assign
      148           tt-rvs.status_ = "накл".
      149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      150     (input ?
      151     ,input this-procedure:handle
      152     ,input ?
      153     ,input 'event_rvs-doc':U
      154     ,input  buffer tt-rvs:handle
      155     ,input  buffer ub.rvs-doc:handle
      156     ,input ''
      157     ,input ''
      158     ) no-error .
      159   if error-status:error
      160       then
      161   do:
      162       message return-value view-as alert-box.
      163   end.
      164   for each tt-rvs:
      165       delete tt-rvs .
      166   end.
      167   end.
      168   for each ub.fbr-doc no-lock where ub.fbr-doc.obj-code = buf_shift-obj.obj-code and
      169       ub.fbr-doc.obj-type = buf_shift-obj.obj-type and
      170       ub.fbr-doc.shift-date = buf_shift-obj.shift-date and
      171       ub.fbr-doc.shift-num = buf_shift-obj.shift-num:
      172       buffer-copy fbr-doc except fbr-doc.status_ to tt-fbr  assign
      173           tt-fbr.status_ = "накл".
      174   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      175     (input ?
      176     ,input this-procedure:handle
      177     ,input ?
      178     ,input 'event_fbr-doc':U
      179     ,input  buffer tt-fbr:handle
      180     ,input  buffer ub.fbr-doc:handle
      181     ,input ''
      182     ,input ''
      183     ) no-error .
      184   if error-status:error
      185       then
      186   do:
      187       message return-value view-as alert-box.
      188   end.
      189   for each tt-fbr:
      190       delete tt-fbr .
      191   end.
      192   end.
      193   for each ub.fin-doc no-lock where ub.fin-doc.obj-code = buf_shift-obj.obj-code and
      194       ub.fin-doc.obj-type = buf_shift-obj.obj-type and
      195       ub.fin-doc.shift-date = buf_shift-obj.shift-date and
      196       ub.fin-doc.shift-num = buf_shift-obj.shift-num:
      197       buffer-copy fin-doc except fin-doc.status_ to tt-fin  assign
      198           tt-fin.status_ = "накл".
      199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      200     (input ?
      201     ,input this-procedure:handle
      202     ,input ?
      203     ,input 'event_fin-doc':U
      204     ,input  buffer tt-fin:handle
      205     ,input  buffer ub.fin-doc:handle
      206     ,input ''
      207     ,input ''
      208     ) no-error .
      209   if error-status:error
      210       then
      211   do:
      212       message return-value view-as alert-box.
      213   end.
      214   for each tt-fin:
      215       delete tt-fin .
      216   end.
      217   end.
      218   run str/prep1C-shift-period.p (input ?,
      219                                  input buf_shift-obj.obj-type,
      220                                  input buf_shift-obj.obj-code,
      221                                  input buf_shift-obj.shift-date,
      222                                  input buf_shift-obj.shift-num)
      223                                  no-error .
      224   if error-status:error
      225   then do:
      226     message return-value view-as alert-box.
      227   end.
      228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      229     (input ?
      230     ,input this-procedure:handle
      231     ,input ?
      232     ,input 'event_shift':U
      233     ,input  buffer tt-shift:handle
      234     ,input  buffer buf_shift-obj:handle
      235     ,input ''
      236     ,input ''
      237     ) no-error .
      238   if error-status:error then
      239   do :
      240       message "Ошибка маршрутизации записи в машину правил" skip return-value skip error-status:get-message(1) view-as alert-box.
      241   end.
      242   else
      243   do:
      244       define buffer buf_reportShift for ub.reportShift .
      245       find first buf_reportShift exclusive-lock where buf_reportShift.shift-date = buf_shift-obj.shift-date and
      246           buf_reportShift.shift-num = buf_shift-obj.shift-num and buf_reportShift.obj-code = buf_shift-obj.obj-code and
      247           buf_reportShift.obj-type = buf_shift-obj.obj-type and buf_reportShift.report-type = 1 no-error .
      248       if available (buf_reportShift) then
      249       do:
      250           run bge\send1cerp.p (parparentproc,
      251               this-procedure,
      252               this-procedure,
      253               "reportShift",
      254               (buffer buf_reportShift:handle),
      255               ?,
      256               ?) no-error.
      257           if  error-status:error then
      258           do:
      259               message return-value
      260                   view-as alert-box.
      261               return .
      262           end.
      263       end.
      264       message substitute("Cмена №&1 от &2 в магазине &3 отправлена",
      265           v-sht-num, v-sht-date, v-obj-code) view-as alert-box.
      266   end.
