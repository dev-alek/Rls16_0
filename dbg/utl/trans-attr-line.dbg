        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   def var v-list-attr-code as character no-undo.
        7   def var ii as integer no-undo.
        8   def buffer buf_doc-line-attr for ub.doc-line-attr.
        9   v-list-attr-code = "autoent-obj-type,ptbotype,item-pour,car-num,fio,time-income".
       10   for each ub.doc-line-attr .
       11     do trans:
       12       if lookup (ub.doc-line-attr.attr-code, v-list-attr-code) = 0 then next.
       13       find first ub.trn-doc where ub.trn-doc.doc-code = ub.doc-line-attr.doc-code and ub.trn-doc.doc-type = 'при':U no-error.
       14       if not available ub.trn-doc then next.
       15       create ub.doc-attr .
       16       case ub.doc-line-attr.attr-code:
       17         when 'autoent-obj-type' then do:
       18           find first buf_doc-line-attr where buf_doc-line-attr.doc-code = ub.doc-line-attr.doc-code and buf_doc-line-attr.gds-code = ub.doc-line-attr.gds-code and buf_doc-line-attr.attr-code = 'autoent-obj-code' no-error.
       19           if not available buf_doc-line-attr then next.
       20           buffer-copy ub.doc-line-attr except ub.doc-line-attr.gds-code ub.doc-line-attr.attr-code ub.doc-line-attr.attr-value to ub.doc-attr
       21               assign
       22                 ub.doc-attr.attr-code = 'autoent':U
       23                 ub.doc-attr.attr-value = ub.doc-line-attr.attr-value + ";" + buf_doc-line-attr.attr-value.
       24               .
       25         end.
       26         when 'ptbotype' then do:
       27           find first buf_doc-line-attr where buf_doc-line-attr.doc-code = ub.doc-line-attr.doc-code and buf_doc-line-attr.gds-code = ub.doc-line-attr.gds-code and buf_doc-line-attr.attr-code = 'ptbocode' no-error.
       28           if not available buf_doc-line-attr then next.
       29           buffer-copy ub.doc-line-attr except ub.doc-line-attr.gds-code ub.doc-line-attr.attr-code ub.doc-line-attr.attr-value to ub.doc-attr
       30               assign
       31                 ub.doc-attr.attr-code = 'ptbobj':U
       32                 ub.doc-attr.attr-value = ub.doc-line-attr.attr-value + ";" + buf_doc-line-attr.attr-value.
       33               .
       34         end.
       35         when 'item-pour' then do:
       36           buffer-copy ub.doc-line-attr except ub.doc-line-attr.gds-code ub.doc-line-attr.attr-code to ub.doc-attr
       37               assign
       38                 ub.doc-attr.attr-code = 'ptb-item-pour':U
       39               .
       40         end.
       41         when 'car-num' then do:
       42           buffer-copy ub.doc-line-attr except ub.doc-line-attr.gds-code ub.doc-line-attr.attr-code to ub.doc-attr
       43               assign
       44                 ub.doc-attr.attr-code = 'car-num':U
       45               .
       46         end.
       47         when 'fio' then do:
       48           buffer-copy ub.doc-line-attr except ub.doc-line-attr.gds-code ub.doc-line-attr.attr-code to ub.doc-attr
       49               assign
       50                 ub.doc-attr.attr-code = 'fio-driver':U
       51               .
       52         end.
       53         when 'time-income' then do:
       54           buffer-copy ub.doc-line-attr except ub.doc-line-attr.gds-code ub.doc-line-attr.attr-code to ub.doc-attr
       55               assign
       56                 ub.doc-attr.attr-code = 'time-income':U
       57               .
       58         end.
       59       end case.
       60       if ub.doc-attr.attr-code = ? or ub.doc-attr.attr-code = "" then delete ub.doc-attr.
       61       else do:
       62         ii = ii + 1.
       63         for each buf_doc-line-attr where buf_doc-line-attr.doc-code = ub.doc-line-attr.doc-code
       64             and buf_doc-line-attr.attr-code = ub.doc-line-attr.attr-code
       65             and rowid (buf_doc-line-attr) <> rowid (ub.doc-line-attr):
       66           delete buf_doc-line-attr.
       67         end.
       68         delete ub.doc-line-attr.
       69       end.
       70     end.
       71   end.
       72   message "Перенесено атрибутов " ii view-as alert-box information.
