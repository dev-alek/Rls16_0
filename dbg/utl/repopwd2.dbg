        1   using Progress.Lang.*.
        2   using utl.*.
        3   block-level on error undo, throw.
        4   class utl.repoPwd2 inherits repository:
        5      define public property Obj as class tech-prol-pwd no-undo
        6      get.
        7      set.
        8      constructor public repoPwd2 (iObj as class tech-prol-pwd):
        9         super ().
       10         this-object:Obj = iObj.
       11      end constructor.
       12      method override public void Refresh(  ):
       13         define buffer btech-prol-pwd for ub.tech-prol-pwd.
       14         if Obj:Id > 0 then
       15         do:
       16            find first btech-prol-pwd where
       17                       btech-prol-pwd.Id = Obj:Id
       18            no-lock no-error.
       19            if avail btech-prol-pwd then
       20            do:
       21               assign
       22                  Obj:f-date         = btech-prol-pwd.f-date
       23                  Obj:f-time         = btech-prol-pwd.f-time
       24                  Obj:f-user         = btech-prol-pwd.f-user
       25                  Obj:f-host         = btech-prol-pwd.f-host
       26                  Obj:f-pwd-type     = btech-prol-pwd.f-pwd-type
       27                  Obj:f-pwd          = btech-prol-pwd.f-pwd
       28                  Obj:f-fio          = btech-prol-pwd.f-fio
       29                  Obj:f-beg-time     = btech-prol-pwd.f-beg-time
       30                  Obj:f-end-time     = btech-prol-pwd.f-end-time
       31                  Obj:cash-desk-surr = btech-prol-pwd.cash-desk-surr
       32               .
       33               if num-entries (btech-prol-pwd.shop-surr,chr(4))eq 2 and entry(1,btech-prol-pwd.shop-surr,chr(4)) ne  "маг"
       34               then assign
       35                  Obj:region-surr      = entry(1,btech-prol-pwd.shop-surr,chr(4))
       36                  Obj:shop-surr      = entry(2,btech-prol-pwd.shop-surr,chr(4))
       37               .
       38               else
       39                  Obj:shop-surr      = btech-prol-pwd.shop-surr.
       40            end.
       41         end.
       42      end method.
       43      method override public void Save(  ):
       44         define buffer btech-prol-pwd for tech-prol-pwd.
       45         def var vId as int64 no-undo.
       46         define variable vShop as integer no-undo.
       47         vShop = int(Obj:shop-surr) no-error.
       48         if error-status:error
       49         then do:
       50            undo, throw new ValidateError("Не удалось выделить номер магазина " + Obj:shop-surr,-1).
       51         end.
       52         define variable vCash as integer no-undo.
       53         vCash = int(Obj:cash-desk-surr) no-error.
       54         if error-status:error
       55         then do:
       56            undo, throw new ValidateError("Не удалось выделить номер кассы " + Obj:cash-desk-surr,-1).
       57         end.
       58         tr:
       59         do transaction:
       60            vId = GetId().
       61            create btech-prol-pwd.
       62            assign
       63               btech-prol-pwd.id = vId
       64               btech-prol-pwd.f-date         = Obj:f-date
       65               btech-prol-pwd.f-time         = Obj:f-time
       66               btech-prol-pwd.f-user         = Obj:f-user
       67               btech-prol-pwd.f-host         = Obj:f-host
       68               btech-prol-pwd.f-pwd-type     = Obj:f-pwd-type
       69               btech-prol-pwd.f-pwd          = Obj:f-pwd
       70               btech-prol-pwd.f-fio          = Obj:f-fio
       71               btech-prol-pwd.f-beg-time     = Obj:f-beg-time
       72               btech-prol-pwd.f-end-time     = Obj:f-end-time
       73               btech-prol-pwd.cash-desk-surr = Obj:cash-desk-surr
       74               btech-prol-pwd.f-object-num   = INT(if num-entries (Obj:shop-surr) eq 1 then Obj:shop-surr else ENTRY(2,Obj:shop-surr))
       75               btech-prol-pwd.f-cash-num     = INT(if num-entries (btech-prol-pwd.cash-desk-surr) eq 1  then btech-prol-pwd.cash-desk-surr else ENTRY(4,btech-prol-pwd.cash-desk-surr))
       76            .
       77            if Obj:region-surr eq ""
       78            then
       79               btech-prol-pwd.shop-surr      = Obj:shop-surr.
       80            else
       81               btech-prol-pwd.shop-surr      = Obj:region-surr  + chr(4) + Obj:shop-surr.
       82            run trg/userlog.p (
       83               input 'tech-prol-pwd'
       84             , input ("Генерация пароля " + chr(3) + string(vId) )
       85             , input ?
       86             , input ?
       87             , input "") no-error.
       88         end.
       89         Obj:Id = vId.
       90      end method.
       91      method private int64 GetId(  ):
       92         define buffer btech-prol-pwd for tech-prol-pwd.
       93         def var vId as int64 no-undo.
       94         vId = next-value(s-tech-prol-pwd).
       95         find first btech-prol-pwd where
       96                    btech-prol-pwd.id = vId
       97         no-lock no-error.
       98         cl:
       99         do while avail btech-prol-pwd:
      100            vId = next-value(s-tech-prol-pwd).
      101            find first btech-prol-pwd where
      102                       btech-prol-pwd.id = vId
      103            no-lock no-error.
      104         end.
      105         return vId.
      106      end method.
      107   end class.
