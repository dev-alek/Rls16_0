        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00000005.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00000005.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 0.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   do
       13   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       14   on stop   undo, return error substitute( "&1. stop"  , vss-workfile )
       15   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       16   :
       17     define buffer old-sequence for src._sequence .
       18     define buffer new-sequence for dst._sequence .
       19     define variable dopi as int64 no-undo .
       20   define input parameter vartype-cut            as integer   no-undo.
       21   define input parameter varlist-db             as character no-undo.
       22   define input parameter vardate-actual-goods   as date      no-undo.
       23   define input parameter vardate-actual-docs    as date      no-undo.
       24   define input parameter vardate-actual-findoc  as date      no-undo.
       25   define input parameter vardate-output-zone    as date      no-undo.
       26   define input parameter varstay-recipe-goods   as logical   no-undo.
       27   define input parameter varstay-weight-goods   as logical   no-undo.
       28   define input parameter varnot-copy-del-goods  as logical   no-undo.
       29   define input parameter varstay-history        as logical   no-undo.
       30   define input parameter vargen-file            as character no-undo.
       31   define stream str-gen.
       32   output stream str-gen to vargen-file append.
       33   if not connected("src") then do:
       34      return error "Нет коннекта с базой 'src'.".
       35   end.
       36   if not connected("dst") then do:
       37      return error "Нет коннекта с базой 'dst'.".
       38   end.
       39   find src.sys-ctrl no-lock.
       40   if not available src.sys-ctrl then do:
       41      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       42   end.
       43   if src.sys-ctrl.db-num <> 0 then do:
       44      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       45   end.
       46   if vardate-actual-docs <> ? and
       47      (vardate-actual-goods   > vardate-actual-docs or
       48       vardate-actual-goods   = ? )   then do:
       49         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       50                                 "Дата актуальности товаров &1."        +
       51                                 "Дата актуальности документов &2."     +
       52                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       53                                 vardate-actual-goods,
       54                                 vardate-actual-docs).
       55   end.
       56     for each new-sequence
       57       ,first old-sequence no-lock
       58       where old-sequence._seq-name = new-sequence._seq-name
       59     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       60     :
       61       assign
       62         dopi = dynamic-current-value( old-sequence._seq-name, "src":U )
       63       .
       64       if dopi < new-sequence._Seq-Min then do:
       65         assign
       66           dopi = new-sequence._Seq-Min
       67         .
       68       end.
       69       if new-sequence._Seq-Max <> ?
       70         and dopi > new-sequence._Seq-Max
       71       then do:
       72         assign
       73           dopi = new-sequence._Seq-Max
       74         .
       75       end.
       76       assign
       77         dynamic-current-value( new-sequence._seq-name, "dst":U ) = dopi
       78       .
       79     end.
       80     output stream str-gen close.
       81     return "Произведен экспорт счетчиков.".
       82   end.
