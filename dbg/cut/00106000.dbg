        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00106000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00106000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 106.".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define buffer old-tnved-head for src.tnved-head.
       63   define buffer new-tnved-head for dst.tnved-head.
       64   define buffer old-tnved-head-attr for src.tnved-head-attr.
       65   define buffer new-tnved-head-attr for dst.tnved-head-attr.
       66   define buffer old-tnved-item for src.tnved-item.
       67   define buffer new-tnved-item for dst.tnved-item.
       68   define buffer old-tnved-item-attr for src.tnved-item-attr.
       69   define buffer new-tnved-item-attr for dst.tnved-item-attr.
       70   do
       71   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       72   define input parameter vartype-cut            as integer   no-undo.
       73   define input parameter varlist-db             as character no-undo.
       74   define input parameter vardate-actual-goods   as date      no-undo.
       75   define input parameter vardate-actual-docs    as date      no-undo.
       76   define input parameter vardate-actual-findoc  as date      no-undo.
       77   define input parameter vardate-output-zone    as date      no-undo.
       78   define input parameter varstay-recipe-goods   as logical   no-undo.
       79   define input parameter varstay-weight-goods   as logical   no-undo.
       80   define input parameter varnot-copy-del-goods  as logical   no-undo.
       81   define input parameter varstay-history        as logical   no-undo.
       82   define input parameter vargen-file            as character no-undo.
       83   define stream str-gen.
       84   output stream str-gen to vargen-file append.
       85   if not connected("src") then do:
       86      return error "Нет коннекта с базой 'src'.".
       87   end.
       88   if not connected("dst") then do:
       89      return error "Нет коннекта с базой 'dst'.".
       90   end.
       91   find src.sys-ctrl no-lock.
       92   if not available src.sys-ctrl then do:
       93      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       94   end.
       95   if src.sys-ctrl.db-num <> 0 then do:
       96      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       97   end.
       98   if vardate-actual-docs <> ? and
       99      (vardate-actual-goods   > vardate-actual-docs or
      100       vardate-actual-goods   = ? )   then do:
      101         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      102                                 "Дата актуальности товаров &1."        +
      103                                 "Дата актуальности документов &2."     +
      104                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      105                                 vardate-actual-goods,
      106                                 vardate-actual-docs).
      107   end.
      108   on WRITE of dst.tnved-head override do: end.
      109   on WRITE of dst.tnved-head-attr override do: end.
      110   on WRITE of dst.tnved-item override do: end.
      111   on WRITE of dst.tnved-item-attr override do: end.
      112   for each old-tnved-head  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      113      create new-tnved-head.
      114      buffer-copy old-tnved-head to new-tnved-head.
      115   end.
      116   for each old-tnved-head-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      117      create new-tnved-head-attr.
      118      buffer-copy old-tnved-head-attr to new-tnved-head-attr.
      119   end.
      120   for each old-tnved-item  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      121      create new-tnved-item.
      122      buffer-copy old-tnved-item to new-tnved-item.
      123   end.
      124   for each old-tnved-item-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      125      create new-tnved-item-attr.
      126      buffer-copy old-tnved-item-attr to new-tnved-item-attr.
      127   end.
      128   output stream str-gen close.
      129   return "Произведен экспорт таблиц: ~
      130   tnved-head tnved-head-attr tnved-item tnved-item-attr .".
      131   end.
