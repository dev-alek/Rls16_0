        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00079000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00079000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 14.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   do
       13   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       14   :
       15   define input parameter vartype-cut            as integer   no-undo.
       16   define input parameter varlist-db             as character no-undo.
       17   define input parameter vardate-actual-goods   as date      no-undo.
       18   define input parameter vardate-actual-docs    as date      no-undo.
       19   define input parameter vardate-actual-findoc  as date      no-undo.
       20   define input parameter vardate-output-zone    as date      no-undo.
       21   define input parameter varstay-recipe-goods   as logical   no-undo.
       22   define input parameter varstay-weight-goods   as logical   no-undo.
       23   define input parameter varnot-copy-del-goods  as logical   no-undo.
       24   define input parameter varstay-history        as logical   no-undo.
       25   define input parameter vargen-file            as character no-undo.
       26   define stream str-gen.
       27   output stream str-gen to vargen-file append.
       28   if not connected("src") then do:
       29      return error "Нет коннекта с базой 'src'.".
       30   end.
       31   if not connected("dst") then do:
       32      return error "Нет коннекта с базой 'dst'.".
       33   end.
       34   find src.sys-ctrl no-lock.
       35   if not available src.sys-ctrl then do:
       36      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       37   end.
       38   if src.sys-ctrl.db-num <> 0 then do:
       39      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       40   end.
       41   if vardate-actual-docs <> ? and
       42      (vardate-actual-goods   > vardate-actual-docs or
       43       vardate-actual-goods   = ? )   then do:
       44         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       45                                 "Дата актуальности товаров &1."        +
       46                                 "Дата актуальности документов &2."     +
       47                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       48                                 vardate-actual-goods,
       49                                 vardate-actual-docs).
       50   end.
       51   output stream str-gen close.
       52   return "Таблицы archive-history archive-history-attr aht-doc aht-gds aht-ot-line aht-ot-tot aht-stk aht-stk-line aht-stk-tot aht-time ot-line ot-tot stk-line stk-tot hst-cli-tot hst-cli-line ot-cli-tot ot-cli-line ot-supp-tot ot-supp-line saldo-cli stk-supp-tot stk-supp-line не экспортировались.".
       53   end.
