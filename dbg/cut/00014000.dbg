        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00014000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00014000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 14.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-c-ext-artic         for src.c-ext-artic        .
       13   define buffer old-c-ext-artic-attr    for src.c-ext-artic-attr   .
       14   define buffer old-ext-artic           for src.ext-artic          .
       15   define buffer old-ext-artic-attr      for src.ext-artic-attr     .
       16   define buffer old-ext-artic-db        for src.ext-artic-db       .
       17   define buffer old-ext-artic-db-attr   for src.ext-artic-db-attr  .
       18   define buffer old-ext-artic-host      for src.ext-artic-host     .
       19   define buffer old-ext-artic-host-attr for src.ext-artic-host-attr.
       20   define buffer old-ext-artic-obj       for src.ext-artic-obj      .
       21   define buffer old-ext-artic-obj-attr  for src.ext-artic-obj-attr .
       22   define buffer new-c-ext-artic         for dst.c-ext-artic        .
       23   define buffer new-c-ext-artic-attr    for dst.c-ext-artic-attr   .
       24   define buffer new-ext-artic           for dst.ext-artic          .
       25   define buffer new-ext-artic-attr      for dst.ext-artic-attr     .
       26   define buffer new-ext-artic-db        for dst.ext-artic-db       .
       27   define buffer new-ext-artic-db-attr   for dst.ext-artic-db-attr  .
       28   define buffer new-ext-artic-host      for dst.ext-artic-host     .
       29   define buffer new-ext-artic-host-attr for dst.ext-artic-host-attr.
       30   define buffer new-ext-artic-obj       for dst.ext-artic-obj      .
       31   define buffer new-ext-artic-obj-attr  for dst.ext-artic-obj-attr .
       32   define buffer new-goods               for dst.goods .
       33   do
       34   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       35   define input parameter vartype-cut            as integer   no-undo.
       36   define input parameter varlist-db             as character no-undo.
       37   define input parameter vardate-actual-goods   as date      no-undo.
       38   define input parameter vardate-actual-docs    as date      no-undo.
       39   define input parameter vardate-actual-findoc  as date      no-undo.
       40   define input parameter vardate-output-zone    as date      no-undo.
       41   define input parameter varstay-recipe-goods   as logical   no-undo.
       42   define input parameter varstay-weight-goods   as logical   no-undo.
       43   define input parameter varnot-copy-del-goods  as logical   no-undo.
       44   define input parameter varstay-history        as logical   no-undo.
       45   define input parameter vargen-file            as character no-undo.
       46   define stream str-gen.
       47   output stream str-gen to vargen-file append.
       48   if not connected("src") then do:
       49      return error "Нет коннекта с базой 'src'.".
       50   end.
       51   if not connected("dst") then do:
       52      return error "Нет коннекта с базой 'dst'.".
       53   end.
       54   find src.sys-ctrl no-lock.
       55   if not available src.sys-ctrl then do:
       56      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       57   end.
       58   if src.sys-ctrl.db-num <> 0 then do:
       59      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       60   end.
       61   if vardate-actual-docs <> ? and
       62      (vardate-actual-goods   > vardate-actual-docs or
       63       vardate-actual-goods   = ? )   then do:
       64         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       65                                 "Дата актуальности товаров &1."        +
       66                                 "Дата актуальности документов &2."     +
       67                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       68                                 vardate-actual-goods,
       69                                 vardate-actual-docs).
       70   end.
       71     on WRITE of dst.c-ext-artic                         override do: end.
       72     on WRITE of dst.c-ext-artic-attr                    override do: end.
       73     on WRITE of dst.ext-artic                           override do: end.
       74     on WRITE of dst.ext-artic-attr                      override do: end.
       75     on WRITE of dst.ext-artic-db                        override do: end.
       76     on WRITE of dst.ext-artic-db-attr                   override do: end.
       77     on WRITE of dst.ext-artic-host                      override do: end.
       78     on WRITE of dst.ext-artic-host-attr                 override do: end.
       79     on WRITE of dst.ext-artic-obj                       override do: end.
       80     on WRITE of dst.ext-artic-obj-attr                  override do: end.
       81     for each old-ext-artic no-lock
       82     :
       83       find first new-goods no-lock
       84         where new-goods.gds-code = old-ext-artic.gds-code
       85       no-error .
       86       if available new-goods
       87       then do:
       88         create new-ext-artic.
       89         buffer-copy old-ext-artic to new-ext-artic.
       90       end.
       91     end.
       92     for each old-ext-artic-attr no-lock
       93     :
       94       find first new-goods no-lock
       95         where new-goods.gds-code = old-ext-artic-attr.gds-code
       96       no-error .
       97       if available new-goods
       98       then do:
       99         create new-ext-artic-attr.
      100         buffer-copy old-ext-artic-attr to new-ext-artic-attr.
      101       end.
      102     end.
      103     for each old-ext-artic-db no-lock
      104     :
      105       find first new-goods no-lock
      106         where new-goods.gds-code = old-ext-artic-db.gds-code
      107       no-error .
      108       if available new-goods
      109       then do:
      110         create new-ext-artic-db.
      111         buffer-copy old-ext-artic-db to new-ext-artic-db.
      112       end.
      113     end.
      114     for each old-ext-artic-db-attr no-lock
      115     :
      116       find first new-goods no-lock
      117         where new-goods.gds-code = old-ext-artic-db-attr.gds-code
      118       no-error .
      119       if available new-goods
      120       then do:
      121         create new-ext-artic-db-attr.
      122         buffer-copy old-ext-artic-db-attr to new-ext-artic-db-attr .
      123       end.
      124     end.
      125     for each old-ext-artic-host no-lock
      126     :
      127       find first new-goods no-lock
      128         where new-goods.gds-code = old-ext-artic-host.gds-code
      129       no-error .
      130       if available new-goods
      131       then do:
      132         create new-ext-artic-host .
      133         buffer-copy old-ext-artic-host to new-ext-artic-host .
      134       end.
      135     end.
      136     for each old-ext-artic-host-attr no-lock
      137     :
      138       find first new-goods no-lock
      139         where new-goods.gds-code = old-ext-artic-host-attr.gds-code
      140       no-error .
      141       if available new-goods
      142       then do:
      143         create new-ext-artic-host-attr .
      144         buffer-copy old-ext-artic-host-attr to new-ext-artic-host-attr .
      145       end.
      146     end.
      147     for each old-ext-artic-obj no-lock
      148     :
      149       find first new-goods no-lock
      150         where new-goods.gds-code = old-ext-artic-obj.gds-code
      151       no-error .
      152       if available new-goods
      153       then do:
      154         create new-ext-artic-obj .
      155         buffer-copy old-ext-artic-obj to new-ext-artic-obj .
      156       end.
      157     end.
      158     for each old-ext-artic-obj-attr no-lock
      159     :
      160       find first new-goods no-lock
      161         where new-goods.gds-code = old-ext-artic-obj-attr.gds-code
      162       no-error .
      163       if available new-goods
      164       then do:
      165         create new-ext-artic-obj-attr.
      166         buffer-copy old-ext-artic-obj-attr to new-ext-artic-obj-attr .
      167       end.
      168     end.
      169     if varstay-history
      170     then do:
      171       for each old-c-ext-artic no-lock
      172       :
      173         find first new-goods no-lock
      174           where new-goods.gds-code = old-c-ext-artic.gds-code
      175         no-error .
      176         if available new-goods
      177         then do:
      178           create new-c-ext-artic.
      179           buffer-copy old-c-ext-artic to new-c-ext-artic.
      180         end.
      181       end.
      182       for each old-c-ext-artic-attr no-lock
      183       :
      184         find first new-goods no-lock
      185           where new-goods.gds-code = old-c-ext-artic-attr.gds-code
      186         no-error .
      187         if available new-goods
      188         then do:
      189           create new-c-ext-artic-attr.
      190           buffer-copy old-c-ext-artic-attr to new-c-ext-artic-attr .
      191         end.
      192       end.
      193     end.
      194   output stream str-gen close.
      195   return "Произведен экспорт таблиц: " +
      196   "~
      197   c-ext-artic ~
      198   c-ext-artic-attr ~
      199   ext-artic ~
      200   ext-artic-attr ~
      201   ext-artic-db ~
      202   ext-artic-db-attr ~
      203   ext-artic-host ~
      204   ext-artic-host-attr ~
      205   ext-artic-obj ~
      206   ext-artic-obj-attr ~
      207   .".
      208   end.
