        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00128000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00128000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 128.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-tmp-sale      for src.tmp-sale.
       13   define buffer new-tmp-sale      for dst.tmp-sale.
       14   define buffer old-tmp-sale-gds  for src.tmp-sale-gds.
       15   define buffer new-tmp-sale-gds  for dst.tmp-sale-gds.
       16   define buffer old-tmp-sale-dtl  for src.tmp-sale-dtl.
       17   define buffer new-tmp-sale-dtl  for dst.tmp-sale-dtl.
       18   define buffer old-tmp-sale-attr      for src.tmp-sale-attr.
       19   define buffer new-tmp-sale-attr      for dst.tmp-sale-attr.
       20   define buffer old-tmp-sale-gds-attr  for src.tmp-sale-gds-attr.
       21   define buffer new-tmp-sale-gds-attr  for dst.tmp-sale-gds-attr.
       22   define buffer old-tmp-sale-dtl-attr  for src.tmp-sale-dtl-attr.
       23   define buffer new-tmp-sale-dtl-attr  for dst.tmp-sale-dtl-attr.
       24   define buffer new-goods         for dst.goods.
       25   do
       26   on error undo, return error
       27   :
       28   define input parameter vartype-cut            as integer   no-undo.
       29   define input parameter varlist-db             as character no-undo.
       30   define input parameter vardate-actual-goods   as date      no-undo.
       31   define input parameter vardate-actual-docs    as date      no-undo.
       32   define input parameter vardate-actual-findoc  as date      no-undo.
       33   define input parameter vardate-output-zone    as date      no-undo.
       34   define input parameter varstay-recipe-goods   as logical   no-undo.
       35   define input parameter varstay-weight-goods   as logical   no-undo.
       36   define input parameter varnot-copy-del-goods  as logical   no-undo.
       37   define input parameter varstay-history        as logical   no-undo.
       38   define input parameter vargen-file            as character no-undo.
       39   define stream str-gen.
       40   output stream str-gen to vargen-file append.
       41   if not connected("src") then do:
       42      return error "Нет коннекта с базой 'src'.".
       43   end.
       44   if not connected("dst") then do:
       45      return error "Нет коннекта с базой 'dst'.".
       46   end.
       47   find src.sys-ctrl no-lock.
       48   if not available src.sys-ctrl then do:
       49      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       50   end.
       51   if src.sys-ctrl.db-num <> 0 then do:
       52      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       53   end.
       54   if vardate-actual-docs <> ? and
       55      (vardate-actual-goods   > vardate-actual-docs or
       56       vardate-actual-goods   = ? )   then do:
       57         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       58                                 "Дата актуальности товаров &1."        +
       59                                 "Дата актуальности документов &2."     +
       60                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       61                                 vardate-actual-goods,
       62                                 vardate-actual-docs).
       63   end.
       64   on WRITE of dst.tmp-sale             override do: end.
       65   on WRITE of dst.tmp-sale-gds         override do: end.
       66   on WRITE of dst.tmp-sale-dtl         override do: end.
       67   on WRITE of dst.tmp-sale-attr        override do: end.
       68   on WRITE of dst.tmp-sale-gds-attr    override do: end.
       69   on WRITE of dst.tmp-sale-dtl-attr    override do: end.
       70   for each old-tmp-sale  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       71      create new-tmp-sale.
       72      buffer-copy old-tmp-sale to new-tmp-sale.
       73   end.
       74   for each old-tmp-sale-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       75      create new-tmp-sale-attr.
       76      buffer-copy old-tmp-sale-attr to new-tmp-sale-attr.
       77   end.
       78   for each old-tmp-sale-gds  no-lock , first new-goods where   new-goods.artic = old-tmp-sale-gds.artic and   new-goods.prod-type = old-tmp-sale-gds.prod-type and   new-goods.prod-code = old-tmp-sale-gds.prod-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       79      create new-tmp-sale-gds.
       80      buffer-copy old-tmp-sale-gds to new-tmp-sale-gds.
       81   end.
       82   for each old-tmp-sale-gds-attr  no-lock , first new-goods  where   new-goods.artic = old-tmp-sale-gds-attr.artic and   new-goods.prod-type = old-tmp-sale-gds-attr.prod-type and   new-goods.prod-code = old-tmp-sale-gds-attr.prod-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       83      create new-tmp-sale-gds-attr.
       84      buffer-copy old-tmp-sale-gds-attr to new-tmp-sale-gds-attr.
       85   end.
       86   for each old-tmp-sale-dtl  no-lock , first new-goods  where   new-goods.artic = old-tmp-sale-dtl.artic and   new-goods.prod-type = old-tmp-sale-dtl.prod-type and   new-goods.prod-code = old-tmp-sale-dtl.prod-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       87      create new-tmp-sale-dtl.
       88      buffer-copy old-tmp-sale-dtl to new-tmp-sale-dtl.
       89   end.
       90   for each old-tmp-sale-dtl-attr  no-lock , first new-goods where   new-goods.artic = old-tmp-sale-dtl-attr.artic and   new-goods.prod-type = old-tmp-sale-dtl-attr.prod-type and   new-goods.prod-code = old-tmp-sale-dtl-attr.prod-code    no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       91      create new-tmp-sale-dtl-attr.
       92      buffer-copy old-tmp-sale-dtl-attr to new-tmp-sale-dtl-attr.
       93   end.
       94     output stream str-gen close.
       95     return "Произведен экспорт таблиц: tmp-sale tmp-sale-gds tmp-sale-dtl .".
       96   end.
