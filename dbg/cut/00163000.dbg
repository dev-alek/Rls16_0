        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00163000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00163000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 163.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-sert           for src.sert.
       13   define buffer new-sert           for dst.sert.
       14   define buffer old-c-sert         for src.c-sert.
       15   define buffer new-c-sert         for dst.c-sert.
       16   define buffer old-sert-attr      for src.sert-attr.
       17   define buffer new-sert-attr      for dst.sert-attr.
       18   define buffer old-sert-join      for src.sert-join.
       19   define buffer new-sert-join      for dst.sert-join.
       20   define buffer old-sert-join-attr for src.sert-join-attr.
       21   define buffer new-sert-join-attr for dst.sert-join-attr.
       22   define buffer new-clients   for dst.clients.
       23   define buffer new-bar-code  for dst.bar-code.
       24   define variable varmoved-sert as logical no-undo.
       25   do
       26   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       27   define input parameter vartype-cut            as integer   no-undo.
       28   define input parameter varlist-db             as character no-undo.
       29   define input parameter vardate-actual-goods   as date      no-undo.
       30   define input parameter vardate-actual-docs    as date      no-undo.
       31   define input parameter vardate-actual-findoc  as date      no-undo.
       32   define input parameter vardate-output-zone    as date      no-undo.
       33   define input parameter varstay-recipe-goods   as logical   no-undo.
       34   define input parameter varstay-weight-goods   as logical   no-undo.
       35   define input parameter varnot-copy-del-goods  as logical   no-undo.
       36   define input parameter varstay-history        as logical   no-undo.
       37   define input parameter vargen-file            as character no-undo.
       38   define stream str-gen.
       39   output stream str-gen to vargen-file append.
       40   if not connected("src") then do:
       41      return error "Нет коннекта с базой 'src'.".
       42   end.
       43   if not connected("dst") then do:
       44      return error "Нет коннекта с базой 'dst'.".
       45   end.
       46   find src.sys-ctrl no-lock.
       47   if not available src.sys-ctrl then do:
       48      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       49   end.
       50   if src.sys-ctrl.db-num <> 0 then do:
       51      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       52   end.
       53   if vardate-actual-docs <> ? and
       54      (vardate-actual-goods   > vardate-actual-docs or
       55       vardate-actual-goods   = ? )   then do:
       56         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       57                                 "Дата актуальности товаров &1."        +
       58                                 "Дата актуальности документов &2."     +
       59                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       60                                 vardate-actual-goods,
       61                                 vardate-actual-docs).
       62   end.
       63   on WRITE of dst.sert      override do: end.
       64   on WRITE of dst.c-sert         override do: end.
       65   on WRITE of dst.sert-attr      override do: end.
       66   on WRITE of dst.sert-join override do: end.
       67   on WRITE of dst.sert-join-attr override do: end.
       68   for each old-sert no-lock ,
       69      first new-clients where new-clients.obj-type = old-sert.cli-type and
       70                              new-clients.obj-code = old-sert.cli-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       71      assign varmoved-sert = yes.
       72      old-sert-join-label:
       73      for each old-sert-join where old-sert-join.cli-type  = old-sert.cli-type  and
       74                                   old-sert-join.cli-code  = old-sert.cli-code  and
       75                                   old-sert-join.sert-code = old-sert.sert-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       76          find first new-bar-code where new-bar-code.b-code = old-sert-join.b-code no-lock no-error.
       77          if not available new-bar-code then do:
       78             assign varmoved-sert = no.
       79             leave old-sert-join-label.
       80          end.
       81      end.
       82      if varmoved-sert = yes then do:
       83         create new-sert.
       84         buffer-copy old-sert to new-sert.
       85         for each old-sert-join where old-sert-join.cli-type  = old-sert.cli-type  and
       86                                      old-sert-join.cli-code  = old-sert.cli-code  and
       87                                      old-sert-join.sert-code = old-sert.sert-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       88            create new-sert-join.
       89            buffer-copy old-sert-join to new-sert-join.
       90         end.
       91         for each old-sert-join-attr where old-sert-join-attr.cli-type  = old-sert.cli-type  and
       92                                      old-sert-join-attr.cli-code  = old-sert.cli-code  and
       93                                      old-sert-join-attr.sert-code = old-sert.sert-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       94            create new-sert-join-attr.
       95            buffer-copy old-sert-join-attr to new-sert-join-attr.
       96         end.
       97         if varstay-history then do:
       98           for each old-c-sert where old-c-sert.cli-type  = old-sert.cli-type  and
       99                                       old-c-sert.cli-code  = old-sert.cli-code  and
      100                                       old-c-sert.sert-code = old-sert.sert-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      101             create new-c-sert.
      102             buffer-copy old-c-sert to new-c-sert.
      103           end.
      104         end.
      105         for each old-sert-attr where old-sert-attr.cli-type  = old-sert.cli-type  and
      106                                      old-sert-attr.cli-code  = old-sert.cli-code  and
      107                                      old-sert-attr.sert-code = old-sert.sert-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      108            create new-sert-attr.
      109            buffer-copy old-sert-attr to new-sert-attr.
      110         end.
      111      end.
      112   end.
      113   output stream str-gen close.
      114   return "Произведен экспорт таблиц: sert c-sert sert-attr sert-join sert-joint-attr.".
      115   end.
