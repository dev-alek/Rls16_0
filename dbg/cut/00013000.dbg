      204   for each old-store  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      205      create new-store.
      206      buffer-copy old-store to new-store.
      207   end.
      208   for each old-thbj-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      209      create new-thbj-attr.
      210      buffer-copy old-thbj-attr to new-thbj-attr.
      211   end.
      212   for each old-dis-thbj-rule  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      213      create new-dis-thbj-rule.
      214      buffer-copy old-dis-thbj-rule to new-dis-thbj-rule.
      215   end.
      216   for each old-dis-thbj-rule-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      217      create new-dis-thbj-rule-attr.
      218      buffer-copy old-dis-thbj-rule-attr to new-dis-thbj-rule-attr.
      219   end.
      220   for each old-person  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      221      create new-person.
      222      buffer-copy old-person to new-person.
      223   end.
      224   for each old-staff  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      225      create new-staff.
      226      buffer-copy old-staff to new-staff.
      227   end.
      228   for each old-staff-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      229      create new-staff-attr.
      230      buffer-copy old-staff-attr to new-staff-attr.
      231   end.
      232   for each old-cli-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      233      create new-cli-grp.
      234      buffer-copy old-cli-grp to new-cli-grp.
      235   end.
      236   for each old-cli-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      237      create new-cli-grp-attr.
      238      buffer-copy old-cli-grp-attr to new-cli-grp-attr.
      239   end.
      240   for each old-clients-attr no-lock,
      241       first new-clients where new-clients.obj-type = old-clients-attr.obj-type and
      242                               new-clients.obj-code = old-clients-attr.obj-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      243      create new-clients-attr.
      244      buffer-copy old-clients-attr to new-clients-attr.
      245   end.
      246   do v-ii = 1 to num-entries('C,S':U):
      247     for each old-rcs-country no-lock where old-rcs-country.id begins (entry(v-ii, 'C,S':U) + chr(4)) :
      248       create new-rcs-country.
      249       buffer-copy old-rcs-country to new-rcs-country.
      250     end.
      251   end.
      252   for each old-rcs-clients no-lock where old-rcs-clients.id begins 'inn' + chr(4),
      253       first new-clients no-lock where
      254             new-clients.obj-type = substring(old-rcs-clients.obj-type, 5)
      255         and new-clients.obj-code = old-rcs-clients.obj-code:
      256     create new-rcs-clients.
      257     buffer-copy old-rcs-clients to new-rcs-clients.
      258   end.
      259   if varstay-history then do:
      260     for each old-c-clients no-lock
      261     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      262       if old-c-clients.obj-type = 'орг':U then next.
      263       create new-c-clients.
      264       buffer-copy old-c-clients to new-c-clients.
      265     end.
      266     for each old-c-cli-hist no-lock where old-c-cli-hist.obj-type = 'маг':U
      267     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      268       create new-c-cli-hist.
      269       buffer-copy old-c-cli-hist to new-c-cli-hist.
      270     end.
      271     for each old-c-cli-hist no-lock where old-c-cli-hist.obj-type = 'скл':U
      272     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      273       create new-c-cli-hist.
      274       buffer-copy old-c-cli-hist to new-c-cli-hist.
      275     end.
      276     for each old-c-cli-hist no-lock where old-c-cli-hist.obj-type = 'чел':U
      277     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      278       create new-c-cli-hist.
      279       buffer-copy old-c-cli-hist to new-c-cli-hist.
      280     end.
      281     for each old-c-clients-attr no-lock
      282     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      283       if old-c-clients-attr.obj-type = 'орг':U then next.
      284       create new-c-clients-attr.
      285       buffer-copy old-c-clients-attr to new-c-clients-attr.
      286     end.
      287   for each old-c-shop  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      288      create new-c-shop.
      289      buffer-copy old-c-shop to new-c-shop.
      290   end.
      291   for each old-c-store  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      292      create new-c-store.
      293      buffer-copy old-c-store to new-c-store.
      294   end.
      295   for each old-c-thbj-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      296      create new-c-thbj-attr.
      297      buffer-copy old-c-thbj-attr to new-c-thbj-attr.
      298   end.
      299   for each old-c-dis-thbj-rule  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      300      create new-c-dis-thbj-rule.
      301      buffer-copy old-c-dis-thbj-rule to new-c-dis-thbj-rule.
      302   end.
      303   for each old-c-person  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      304      create new-c-person.
      305      buffer-copy old-c-person to new-c-person.
      306   end.
      307   for each old-c-staff  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      308      create new-c-staff.
      309      buffer-copy old-c-staff to new-c-staff.
      310   end.
      311   for each old-c-cli-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      312      create new-c-cli-grp.
      313      buffer-copy old-c-cli-grp to new-c-cli-grp.
      314   end.
      315   for each old-c-cli-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      316      create new-c-cli-grp-attr.
      317      buffer-copy old-c-cli-grp-attr to new-c-cli-grp-attr.
