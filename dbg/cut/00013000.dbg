      319   end.
      320   for each old-cli-art no-lock,
      321       first new-clients where new-clients.obj-type = old-cli-art.cli-type and
      322                               new-clients.obj-code = old-cli-art.cli-code no-lock,
      323         first new-goods where new-goods.artic     = old-cli-art.artic     and
