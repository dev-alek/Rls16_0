        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00073000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00073000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 13.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-curr-accnt for src.curr-accnt.
       13   define buffer new-curr-accnt for dst.curr-accnt.
       14   define buffer old-c-curr-accnt for src.c-curr-accnt.
       15   define buffer new-c-curr-accnt for dst.c-curr-accnt.
       16   define buffer old-curr-accnt-attr for src.curr-accnt-attr.
       17   define buffer new-curr-accnt-attr for dst.curr-accnt-attr.
       18   define buffer old-curr-bank  for src.curr-bank.
       19   define buffer new-curr-bank  for dst.curr-bank.
       20   define buffer old-c-curr-bank for src.c-curr-bank.
       21   define buffer new-c-curr-bank for dst.c-curr-bank.
       22   define buffer old-curr-bank-attr for src.curr-bank-attr.
       23   define buffer new-curr-bank-attr for dst.curr-bank-attr.
       24   define buffer old-currency   for src.currency.
       25   define buffer new-currency   for dst.currency.
       26   define buffer old-c-currency for src.c-currency.
       27   define buffer new-c-currency for dst.c-currency.
       28   define buffer old-currency-attr for src.currency-attr.
       29   define buffer new-currency-attr for dst.currency-attr.
       30   define buffer old-c-currency-attr for src.c-currency-attr.
       31   define buffer new-c-currency-attr for dst.c-currency-attr.
       32   define buffer old-curr-shop  for src.curr-shop.
       33   define buffer new-curr-shop  for dst.curr-shop.
       34   define buffer old-curr-shop-attr  for src.curr-shop-attr.
       35   define buffer new-curr-shop-attr  for dst.curr-shop-attr.
       36   do
       37   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       38   define input parameter vartype-cut            as integer   no-undo.
       39   define input parameter varlist-db             as character no-undo.
       40   define input parameter vardate-actual-goods   as date      no-undo.
       41   define input parameter vardate-actual-docs    as date      no-undo.
       42   define input parameter vardate-actual-findoc  as date      no-undo.
       43   define input parameter vardate-output-zone    as date      no-undo.
       44   define input parameter varstay-recipe-goods   as logical   no-undo.
       45   define input parameter varstay-weight-goods   as logical   no-undo.
       46   define input parameter varnot-copy-del-goods  as logical   no-undo.
       47   define input parameter varstay-history        as logical   no-undo.
       48   define input parameter vargen-file            as character no-undo.
       49   define stream str-gen.
       50   output stream str-gen to vargen-file append.
       51   if not connected("src") then do:
       52      return error "Нет коннекта с базой 'src'.".
       53   end.
       54   if not connected("dst") then do:
       55      return error "Нет коннекта с базой 'dst'.".
       56   end.
       57   find src.sys-ctrl no-lock.
       58   if not available src.sys-ctrl then do:
       59      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       60   end.
       61   if src.sys-ctrl.db-num <> 0 then do:
       62      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       63   end.
       64   if vardate-actual-docs <> ? and
       65      (vardate-actual-goods   > vardate-actual-docs or
       66       vardate-actual-goods   = ? )   then do:
       67         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       68                                 "Дата актуальности товаров &1."        +
       69                                 "Дата актуальности документов &2."     +
       70                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       71                                 vardate-actual-goods,
       72                                 vardate-actual-docs).
       73   end.
       74   on WRITE of dst.curr-accnt override do: end.
       75   on WRITE of dst.c-curr-accnt override do: end.
       76   on WRITE of dst.curr-accnt-attr override do: end.
       77   on WRITE of dst.curr-bank  override do: end.
       78   on WRITE of dst.c-curr-bank override do: end.
       79   on WRITE of dst.curr-bank-attr override do: end.
       80   on WRITE of dst.currency   override do: end.
       81   on WRITE of dst.c-currency override do: end.
       82   on WRITE of dst.currency-attr override do: end.
       83   on WRITE of dst.c-currency-attr override do: end.
       84   on WRITE of dst.curr-shop  override do: end.
       85   on WRITE of dst.curr-shop-attr  override do: end.
       86   for each old-curr-accnt  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       87      create new-curr-accnt.
       88      buffer-copy old-curr-accnt to new-curr-accnt.
       89   end.
       90   if varstay-history then do:
       91   for each old-c-curr-accnt  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       92      create new-c-curr-accnt.
       93      buffer-copy old-c-curr-accnt to new-c-curr-accnt.
       94   end.
       95   end.
       96   for each old-curr-accnt-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       97      create new-curr-accnt-attr.
       98      buffer-copy old-curr-accnt-attr to new-curr-accnt-attr.
       99   end.
      100   for each old-curr-bank  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      101      create new-curr-bank.
      102      buffer-copy old-curr-bank to new-curr-bank.
      103   end.
      104   if varstay-history then do:
      105   for each old-c-curr-bank  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      106      create new-c-curr-bank.
      107      buffer-copy old-c-curr-bank to new-c-curr-bank.
      108   end.
      109   end.
      110   for each old-curr-bank-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      111      create new-curr-bank-attr.
      112      buffer-copy old-curr-bank-attr to new-curr-bank-attr.
      113   end.
      114   for each old-currency  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      115      create new-currency.
      116      buffer-copy old-currency to new-currency.
      117   end.
      118   if varstay-history then do:
      119   for each old-c-currency  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      120      create new-c-currency.
      121      buffer-copy old-c-currency to new-c-currency.
      122   end.
      123   end.
      124   for each old-currency-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      125      create new-currency-attr.
      126      buffer-copy old-currency-attr to new-currency-attr.
      127   end.
      128   if varstay-history then do:
      129   for each old-c-currency-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      130      create new-c-currency-attr.
      131      buffer-copy old-c-currency-attr to new-c-currency-attr.
      132   end.
      133   end.
      134   for each old-curr-shop  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      135      create new-curr-shop.
      136      buffer-copy old-curr-shop to new-curr-shop.
      137   end.
      138   for each old-curr-shop-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      139      create new-curr-shop-attr.
      140      buffer-copy old-curr-shop-attr to new-curr-shop-attr.
      141   end.
      142   output stream str-gen close.
      143   return "Произведен экспорт таблиц: curr-accnt c-curr-accnt curr-accnt-attr curr-bank c-curr-bank curr-bank-attr ~
      144   currency c-currency currency-attr c-currency-attr curr-shop curr-shop-attr.".
      145   end.
