        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 36493b7e3299, 155, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Feb 17 18:03:53 2015 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00043002.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00043002.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 43.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define new global shared variable g#library  as handle no-undo .
       13   define new global shared variable g#library2 as handle no-undo .
       14   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       15   procedure factord :
       16     define input  parameter p-fact-date            as date    no-undo .
       17     define input  parameter p-fact-time            as integer no-undo .
       18     define input  parameter p-fact-num             as integer no-undo .
       19     define input  parameter p-shift-date           as date    no-undo .
       20     define input  parameter p-shift-num            as integer no-undo .
       21     define input  parameter p-shift-on             as logical no-undo .
       22     define output parameter p-fact-order           as decimal no-undo .
       23     define output parameter p-shift-end-fact-order as decimal no-undo .
       24     define output parameter p-day-end-fact-order   as decimal no-undo .
       25     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       26     if p-fact-date = ?
       27     then do:
       28       return error "Не указана фактическая дата" .
       29     end.
       30     define variable v-fact-date-num as integer no-undo .
       31     assign
       32       v-fact-date-num = integer(p-fact-date)
       33     .
       34     if p-fact-num = ?
       35     or p-fact-num = 0
       36     then do:
       37       return error "Не задан p-fact-num " + string(p-fact-num) .
       38     end.
       39     if p-fact-num < 0
       40     then do:
       41       return error "Отрицательный fact-num " + string(p-fact-num) .
       42     end.
       43     if p-fact-num >= 100000000
       44     then do:
       45       return error "Недопустимо большой fact-num " + string(p-fact-num) .
       46     end.
       47     if p-shift-on = true
       48     then do:
       49       if p-shift-date = ?
       50       then do:
       51         return error "Не задана дата смены" .
       52       end.
       53       if p-shift-num = ?
       54       or p-shift-num = 0
       55       then do:
       56         return error "Не задан номер смены" .
       57       end.
       58     end.
       59     else do:
       60       assign
       61         p-shift-date = p-fact-date
       62         p-shift-num  = 24
       63       .
       64     end.
       65     define variable v-shift-offset as integer no-undo .
       66     if p-shift-date = p-fact-date
       67     then do:
       68       assign
       69         v-shift-offset = 1
       70       .
       71     end.
       72     if p-shift-date < p-fact-date
       73     then do:
       74       assign
       75         v-shift-offset = 0
       76       .
       77     end.
       78     if p-shift-date > p-fact-date
       79     then do:
       80       message
       81         vss-workfile vss-revision vss-description skip
       82         "Неправильная дата закрытия смены" skip
       83         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
       84         view-as alert-box error .
       85       undo, return error
       86         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
       87           ,string(p-fact-date, '99/99/9999':U)
       88           ,string(p-shift-date, '99/99/9999':U)
       89           )
       90       .
       91     end.
       92     if p-shift-num < 1
       93     or p-shift-num > 24
       94     then do:
       95       message
       96         vss-workfile vss-revision vss-description skip
       97         "Неправильный номер смены" skip
       98         "p-shift-num" p-shift-num skip
       99         view-as alert-box error .
      100       undo, return error return-value .
      101     end.
      102     assign
      103       p-fact-order           = v-fact-date-num
      104                              + v-shift-offset * 0.5
      105                              + p-shift-num    * 0.02 - 0.01
      106                              + p-fact-num     * 0.0000000001
      107       p-shift-end-fact-order = v-fact-date-num
      108                              + v-shift-offset * 0.5
      109                              + p-shift-num    * 0.02
      110       p-day-end-fact-order   = v-fact-date-num
      111                              + 0.99
      112     .
      113     if p-fact-order           <= v-fact-date-num
      114     or p-shift-end-fact-order <= v-fact-date-num
      115     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      116     or p-shift-end-fact-order >= p-day-end-fact-order
      117     then do:
      118       message
      119         vss-workfile vss-revision vss-description skip
      120         "Внутренняя ошибка при генерации фактического номера" skip
      121         "p-fact-date"            p-fact-date            skip
      122         "p-fact-time"            p-fact-time            skip
      123         "p-fact-num"             p-fact-num             skip
      124         "p-shift-date"           p-shift-date           skip
      125         "p-shift-num"            p-shift-num            skip
      126         "p-shift-on"             p-shift-on             skip
      127         "p-shift-end-fact-order" p-shift-end-fact-order skip
      128         "p-day-end-fact-order"   p-day-end-fact-order   skip
      129         "v-fact-date-num"        v-fact-date-num        skip
      130         view-as alert-box error .
      131       undo, return error return-value .
      132     end.
      133   end procedure.
      134   procedure day-begin-fact-order :
      135     define input  parameter p-fact-date            as date    no-undo .
      136     define output parameter p-day-begin-fact-order as decimal no-undo .
      137     do
      138     on error undo, return error return-value
      139     :
      140       if p-fact-date = ?
      141       then do:
      142         assign
      143           p-day-begin-fact-order = 0
      144         .
      145       end.
      146       else do:
      147         assign
      148           p-day-begin-fact-order = integer(p-fact-date)
      149         .
      150       end.
      151     end.
      152   end procedure.
      153   procedure factord-max-fact-order :
      154     define output parameter p-max-fact-order as decimal   no-undo .
      155     do
      156     on error undo, return error return-value
      157     :
      158       run day-begin-fact-order in this-procedure
      159         (input  date(1, 1, 5000)
      160         ,output p-max-fact-order
      161         ) .
      162     end.
      163   end procedure.
      164   procedure factord-cut-archive :
      165     define input  parameter p-obj-type             as character no-undo .
      166     define input  parameter p-obj-code             as integer   no-undo .
      167     define input  parameter p-fact-date            as date      no-undo .
      168     define output parameter p-shift-on             as logical   no-undo .
      169     define output parameter p-shift-date           as date      no-undo .
      170     define output parameter p-shift-num            as integer   no-undo .
      171     define output parameter p-day-end-fact-order   as decimal   no-undo .
      172     define output parameter p-shift-end-fact-order as decimal   no-undo .
      173     define variable v-fact-order as decimal   no-undo .
      174     define buffer buf_shift-obj for ub.shift-obj .
      175     do
      176     on error undo, return error return-value
      177     :
      178   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      180     (input  p-obj-type
      181     ,input  p-obj-code
      182     ,input  'shift-on=request'
      183     ,output p-shift-on
      184     ) no-error .
      185       if error-status :error
      186       then do:
      187         message
      188           vss-workfile vss-revision vss-description skip
      189           "Ошибка при определении атрибута объекта" skip
      190           "Объект" p-obj-type p-obj-code skip
      191           error-status :get-message(1) skip
      192           return-value skip
      193           view-as alert-box error .
      194         undo, return error return-value .
      195       end.
      196       if p-shift-on = false
      197       then do:
      198         assign
      199           p-shift-date               = ?
      200           p-shift-num                = 0
      201         .
      202       end.
      203       else do:
      204         find first buf_shift-obj share-lock
      205           where buf_shift-obj.obj-type   = p-obj-type
      206             and buf_shift-obj.obj-code   = p-obj-code
      207             and buf_shift-obj.shift-date > p-fact-date
      208           use-index pi
      209           no-error .
      210         if not available buf_shift-obj
      211         or buf_shift-obj.status_ <> 'зкр':U
      212         then do:
      213           message
      214             vss-workfile vss-revision vss-description skip
      215             "Невозможно вычислить последнюю смену" skip
      216             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      217             "Объект" p-obj-type p-obj-code skip
      218             "Дата" p-fact-date skip
      219             view-as alert-box error .
      220           undo, return error return-value .
      221         end.
      222         find last buf_shift-obj share-lock
      223           where buf_shift-obj.obj-type = p-obj-type
      224             and buf_shift-obj.obj-code = p-obj-code
      225             and buf_shift-obj.shift-date <= p-fact-date
      226           use-index pi
      227           no-error .
      228         if available buf_shift-obj
      229         then do:
      230           if  buf_shift-obj.status_ = 'зкр':U
      231           then do:
      232             assign
      233               p-shift-date = buf_shift-obj.shift-date
      234               p-shift-num  = buf_shift-obj.shift-num
      235             .
      236           end.
      237           else do:
      238             message
      239               vss-workfile vss-revision vss-description skip
      240               "Невозможно вычислить последнюю смену" skip
      241               "Статус смены отличен от статуса" 'зкр':U skip
      242               "Объект" p-obj-type p-obj-code skip
      243               "Дата" p-fact-date skip
      244               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      245               view-as alert-box error .
      246             undo, return error return-value .
      247           end.
      248         end.
      249         else do:
      250           assign
      251             p-shift-date = p-fact-date - 1
      252             p-shift-num  = 1
      253           .
      254         end.
      255       end.
      256       run factord in this-procedure
      257         (input  p-fact-date
      258         ,input  1
      259         ,input  1
      260         ,input  p-shift-date
      261         ,input  p-shift-num
      262         ,input  p-shift-on
      263         ,output v-fact-order
      264         ,output p-shift-end-fact-order
      265         ,output p-day-end-fact-order
      266         ) no-error .
      267       if error-status :error
      268       then do:
      269         message
      270           vss-workfile vss-revision vss-description skip
      271           "Ошибка при вызове процедуры factord"
      272           error-status :get-message(1) skip
      273           return-value skip
      274           view-as alert-box error .
      275         undo, return error return-value .
      276       end.
      277     end.
      278   end procedure.
      279   procedure factord-lock-shift :
      280     define input  parameter p-obj-type  as character no-undo .
      281     define input  parameter p-obj-code  as integer   no-undo .
      282     define input  parameter p-fact-date as date      no-undo .
      283     define parameter buffer buf_shift-obj for ub.shift-obj .
      284     define variable v-shift-on      as logical   no-undo .
      285     define variable v-extra-message as character no-undo .
      286     define variable v-error as character no-undo .
      287     do
      288     on error undo, return error return-value
      289     :
      290   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      291   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      292     (input  p-obj-type
      293     ,input  p-obj-code
      294     ,input  'shift-on=request'
      295     ,output v-shift-on
      296     ) no-error .
      297       if error-status :error
      298       then do:
      299         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      300         undo, return error v-error .
      301       end.
      302       if v-shift-on = true
      303       then do:
      304         find first buf_shift-obj share-lock
      305           where buf_shift-obj.obj-type   = p-obj-type
      306             and buf_shift-obj.obj-code   = p-obj-code
      307             and buf_shift-obj.shift-date > p-fact-date
      308           use-index pi
      309           no-error .
      310         if not available buf_shift-obj
      311         or buf_shift-obj.status_ <> 'зкр':U
      312         then do:
      313           find last buf_shift-obj
      314             where buf_shift-obj.obj-type = p-obj-type
      315               and buf_shift-obj.obj-code = p-obj-code
      316               and buf_shift-obj.status_  = 'зкр':U
      317             use-index stts
      318             no-error .
      319           if available buf_shift-obj
      320           then do:
      321             assign
      322               v-extra-message =
      323                     substitute("Дата начала последеней закрытой смены на объекте &1"
      324                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      325                               )
      326             .
      327           end.
      328           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      329           undo, return error v-error .
      330         end.
      331       end.
      332     end.
      333   end procedure.
      334   procedure factord-end-day :
      335     define input  parameter p-fact-date            as date    no-undo .
      336     define output parameter p-day-end-fact-order   as decimal no-undo .
      337     do
      338     on error undo, return error return-value
      339     :
      340       if p-fact-date = ?
      341       then do:
      342         return error "Не указана фактическая дата" .
      343       end.
      344       assign
      345         p-day-end-fact-order = integer(p-fact-date) + 0.99
      346       .
      347     end.
      348   end procedure.
      349   procedure factord-to-date :
      350     define input  parameter p-fact-order as decimal no-undo .
      351     define output parameter p-fact-date  as date    no-undo .
      352     define variable v-ref-date  as date      no-undo .
      353     define variable v-ref-delta as integer   no-undo .
      354     do
      355     on error undo, return error return-value
      356     :
      357       if p-fact-order = ?
      358       or p-fact-order = 0
      359       then do:
      360         return error "Не указан fact-order" .
      361       end.
      362       assign
      363         v-ref-date  = date(1, 1, 2000)
      364       .
      365       assign
      366         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      367       .
      368       assign
      369         p-fact-date = v-ref-date + v-ref-delta
      370       .
      371     end.
      372   end procedure.
      373   procedure factord-to-fact-num :
      374     define input  parameter p-fact-order as decimal no-undo .
      375     define output parameter p-fact-num   as integer no-undo .
      376     define variable v-fact-order-trunc as decimal no-undo .
      377     do
      378     on error undo, return error return-value
      379     :
      380       if p-fact-order = ?
      381       or p-fact-order = 0
      382       then do:
      383         return error "Не указан fact-order" .
      384       end.
      385       assign
      386        v-fact-order-trunc = truncate(p-fact-order, 2)
      387       .
      388       assign
      389         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      390       .
      391     end.
      392   end procedure.
      393   procedure factord-to-shift-num :
      394     define input  parameter p-fact-order as decimal no-undo .
      395     define output parameter p-shift-num   as integer no-undo .
      396     define variable  p-shift-numd  as decimal   no-undo .
      397     define variable v-fact-order-trunc as decimal no-undo .
      398     do
      399     on error undo, return error return-value
      400     :
      401       if p-fact-order = ?
      402       or p-fact-order = 0
      403       then do:
      404         return error "Не указан fact-order" .
      405       end.
      406       assign
      407        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      408       .
      409       if v-fact-order-trunc < 0.5 then do:
      410         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      411       end.
      412       assign
      413         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      414         .
      415        assign
      416         p-shift-num = truncate (p-shift-numd , 0)
      417       .
      418     end.
      419   end procedure.
      420   define buffer old-trn-doc              for src.trn-doc.
      421   define buffer new-trn-doc              for dst.trn-doc.
      422   define buffer old-doc-line             for src.doc-line.
      423   define buffer new-doc-line             for dst.doc-line.
      424   define buffer old-parts                for src.parts.
      425   define buffer new-parts                for dst.parts.
      426   define buffer new-goods                for dst.goods.
      427   define buffer old-clients              for src.clients.
      428   define buffer old-trn-doc-sum          for src.trn-doc-sum.
      429   define buffer new-trn-doc-sum          for dst.trn-doc-sum.
      430   define buffer old-c-trn-doc-sum          for src.c-trn-doc-sum.
      431   define buffer new-c-trn-doc-sum          for dst.c-trn-doc-sum.
      432   define buffer old-doc-line-sum         for src.doc-line-sum.
      433   define buffer new-doc-line-sum         for dst.doc-line-sum.
      434   define buffer old-c-doc-line-sum       for src.c-doc-line-sum.
      435   define buffer new-c-doc-line-sum       for dst.c-doc-line-sum.
      436   define buffer old-parts-root           for src.parts-root.
      437   define buffer new-parts-root           for dst.parts-root.
      438   define buffer old-parts-root-attr           for src.parts-root-attr.
      439   define buffer new-parts-root-attr           for dst.parts-root-attr.
      440   define buffer old-parts-attr           for src.parts-attr     .
      441   define buffer new-parts-attr           for dst.parts-attr     .
      442   define buffer old-parts-supp           for src.parts-supp.
      443   define buffer new-parts-supp           for dst.parts-supp.
      444   define buffer old-parts-supp-attr          for src.parts-supp-attr.
      445   define buffer new-parts-supp-attr          for dst.parts-supp-attr.
      446   define buffer old-arh-trn-doc-contract      for src.arh-trn-doc-contract.
      447   define buffer old-arh-trn-doc-contract-attr      for src.arh-trn-doc-contract-attr.
      448   define buffer old-next-arh-trn-doc-contract for src.arh-trn-doc-contract.
      449   define buffer new-arh-trn-doc-contract      for dst.arh-trn-doc-contract.
      450   define buffer new-arh-trn-doc-contract-attr      for dst.arh-trn-doc-contract-attr.
      451   define buffer old-parts-obj-attr for src.parts-obj-attr.
      452   define buffer new-parts-obj-attr for dst.parts-obj-attr.
      453   define buffer old-c-parts-obj-attr for src.c-parts-obj-attr.
      454   define buffer new-c-parts-obj-attr for dst.c-parts-obj-attr.
      455   define variable var-fact-order-docs as decimal no-undo .
      456   if transaction then do:
      457     return error substitute( "&1. Вызов данной процедуры невозможен при наличии транзакции", vss-workfile ).
      458   end.
      459   do
      460   on error undo, return error
      461   :
      462   define input parameter vartype-cut            as integer   no-undo.
      463   define input parameter varlist-db             as character no-undo.
      464   define input parameter vardate-actual-goods   as date      no-undo.
      465   define input parameter vardate-actual-docs    as date      no-undo.
      466   define input parameter vardate-actual-findoc  as date      no-undo.
      467   define input parameter vardate-output-zone    as date      no-undo.
      468   define input parameter varstay-recipe-goods   as logical   no-undo.
      469   define input parameter varstay-weight-goods   as logical   no-undo.
      470   define input parameter varnot-copy-del-goods  as logical   no-undo.
      471   define input parameter varstay-history        as logical   no-undo.
      472   define input parameter vargen-file            as character no-undo.
      473   define stream str-gen.
      474   output stream str-gen to vargen-file append.
      475   if not connected("src") then do:
      476      return error "Нет коннекта с базой 'src'.".
      477   end.
      478   if not connected("dst") then do:
      479      return error "Нет коннекта с базой 'dst'.".
      480   end.
      481   find src.sys-ctrl no-lock.
      482   if not available src.sys-ctrl then do:
      483      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      484   end.
      485   if src.sys-ctrl.db-num <> 0 then do:
      486      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      487   end.
      488   if vardate-actual-docs <> ? and
      489      (vardate-actual-goods   > vardate-actual-docs or
      490       vardate-actual-goods   = ? )   then do:
      491         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      492                                 "Дата актуальности товаров &1."        +
      493                                 "Дата актуальности документов &2."     +
      494                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      495                                 vardate-actual-goods,
      496                                 vardate-actual-docs).
      497   end.
      498     on WRITE of dst.trn-doc-sum               override do: end.
      499     on WRITE of dst.c-trn-doc-sum               override do: end.
      500     on WRITE of dst.doc-line-sum              override do: end.
      501     on WRITE of dst.c-doc-line-sum            override do: end.
      502     on WRITE of dst.parts-root                override do: end.
      503     on WRITE of dst.parts-supp                override do: end.
      504     on WRITE of dst.parts-root-attr           override do: end.
      505     on WRITE of dst.parts-supp-attr           override do: end.
      506     on WRITE of dst.parts-attr                override do: end.
      507     on WRITE of dst.arh-trn-doc-contract      override do: end.
      508     on WRITE of dst.arh-trn-doc-contract-attr override do: end.
      509     on WRITE of dst.parts-obj-attr            override do: end.
      510     on WRITE of dst.c-parts-obj-attr          override do: end.
      511   for each old-parts-supp  no-lock , first new-goods where new-goods.artic = old-parts-supp.artic and new-goods.prod-type = old-parts-supp.prod-type and new-goods.prod-code = old-parts-supp.prod-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      512      create new-parts-supp.
      513      buffer-copy old-parts-supp to new-parts-supp.
      514   end.
      515   for each old-parts-supp-attr  no-lock , first new-goods where new-goods.artic = old-parts-supp-attr.artic and new-goods.prod-type = old-parts-supp-attr.prod-type and new-goods.prod-code = old-parts-supp-attr.prod-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      516      create new-parts-supp-attr.
      517      buffer-copy old-parts-supp-attr to new-parts-supp-attr.
      518   end.
      519     define buffer buf_new-goods            for dst.goods        .
      520          for each new-parts no-lock
      521                   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      522                   :
      523                   find first buf_new-goods no-lock where
      524                         buf_new-goods.artic     =  new-parts.artic and
      525                         buf_new-goods.prod-type =  new-parts.prod-type and
      526                         buf_new-goods.prod-code =  new-parts.prod-code
      527                         no-error .
      528                   for each old-parts-attr no-lock
      529                     where old-parts-attr.in-code = new-parts.in-code
      530                       and old-parts-attr.gds-code = buf_new-goods.gds-code
      531                       and old-parts-attr.part-code = new-parts.part-code
      532                   on error undo, return error
      533                   :
      534                     find first  new-parts-attr no-lock
      535                       where   new-parts-attr.in-code   =  old-parts-attr.in-code
      536                         and   new-parts-attr.gds-code  =  old-parts-attr.gds-code
      537                         and   new-parts-attr.part-code =  old-parts-attr.part-code
      538                       no-error  .
      539                     if not available new-parts-attr then do:
      540                       create new-parts-attr.
      541                       buffer-copy old-parts-attr to new-parts-attr
      542                       assign
      543                         new-parts-attr.fact-qnty = new-parts.fact-qnty
      544                         new-parts-attr.doc-qnty  = new-parts.qnty
      545                       .
      546                     end.
      547                   end.
      548                   for each old-parts-obj-attr no-lock
      549                     where old-parts-obj-attr.obj-type = new-parts.obj-type
      550                       and old-parts-obj-attr.obj-code = new-parts.obj-code
      551                       and old-parts-obj-attr.gds-code = buf_new-goods.gds-code
      552                       and old-parts-obj-attr.prt-code = new-parts.prt-code
      553                       and old-parts-obj-attr.in-code = new-parts.in-code
      554                       and old-parts-obj-attr.out-code = new-parts.out-code
      555                       and old-parts-obj-attr.part-code = new-parts.part-code
      556                   on error undo, return error
      557                   :
      558                       create new-parts-obj-attr.
      559                       buffer-copy old-parts-obj-attr to new-parts-obj-attr
      560                       .
      561                   end.
      562                   for each old-c-parts-obj-attr no-lock
      563                     where old-c-parts-obj-attr.obj-type = new-parts.obj-type
      564                       and old-c-parts-obj-attr.obj-code = new-parts.obj-code
      565                       and old-c-parts-obj-attr.gds-code = buf_new-goods.gds-code
      566                       and old-c-parts-obj-attr.prt-code = new-parts.prt-code
      567                       and old-c-parts-obj-attr.in-code = new-parts.in-code
      568                       and old-c-parts-obj-attr.out-code = new-parts.out-code
      569                       and old-c-parts-obj-attr.part-code = new-parts.part-code
      570                   on error undo, return error
      571                   :
      572                       create new-c-parts-obj-attr.
      573                       buffer-copy old-c-parts-obj-attr to new-c-parts-obj-attr
      574                       .
      575                   end.
      576          end.
      577     for each new-trn-doc no-lock :
      578       for each old-trn-doc-sum no-lock  where
      579           old-trn-doc-sum.doc-code = new-trn-doc.doc-code
      580           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      581           :
      582           create new-trn-doc-sum.
      583           BUFFER-COPY old-trn-doc-sum to new-trn-doc-sum.
      584       end.
      585       if varstay-history then for each old-c-trn-doc-sum no-lock  where
      586           old-c-trn-doc-sum.doc-code = new-trn-doc.doc-code
      587           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      588           :
      589           create new-c-trn-doc-sum.
      590           BUFFER-COPY old-c-trn-doc-sum to new-c-trn-doc-sum.
      591       end.
      592       for each old-doc-line-sum no-lock  where
      593           old-doc-line-sum.doc-code = new-trn-doc.doc-code
      594           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      595           :
      596           create new-doc-line-sum.
      597           BUFFER-COPY old-doc-line-sum to new-doc-line-sum.
      598       end.
      599       if varstay-history then for each old-c-doc-line-sum no-lock  where
      600           old-c-doc-line-sum.doc-code = new-trn-doc.doc-code
      601           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      602           :
      603           create new-c-doc-line-sum.
      604           BUFFER-COPY old-c-doc-line-sum to new-c-doc-line-sum.
      605       end.
      606       for each old-parts-root no-lock  where
      607           old-parts-root.doc-code = new-trn-doc.doc-code
      608           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      609           :
      610           create new-parts-root.
      611           BUFFER-COPY old-parts-root to new-parts-root.
      612       end.
      613       for each old-parts-root-attr no-lock  where
      614           old-parts-root-attr.doc-code = new-trn-doc.doc-code
      615           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      616           :
      617           create new-parts-root-attr.
      618           BUFFER-COPY old-parts-root-attr to new-parts-root-attr.
      619       end.
      620     end.
      621     run factord-end-day in this-procedure ( vardate-actual-docs - 1, output var-fact-order-docs).
      622     for each old-clients no-lock where old-clients.db-num <> ? on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      623       for each old-arh-trn-doc-contract no-lock  where
      624           old-arh-trn-doc-contract.obj-type = old-clients.obj-type and
      625           old-arh-trn-doc-contract.obj-code = old-clients.obj-code
      626           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      627           :
      628           find first new-trn-doc no-lock where new-trn-doc.doc-code = old-arh-trn-doc-contract.doc-code no-error.
      629           if available new-trn-doc then do:
      630             create new-arh-trn-doc-contract.
      631             BUFFER-COPY old-arh-trn-doc-contract to new-arh-trn-doc-contract.
      632           end.
      633           else do:
      634             find first old-next-arh-trn-doc-contract where old-next-arh-trn-doc-contract.host-code     = old-arh-trn-doc-contract.host-code     and
      635                                                            old-next-arh-trn-doc-contract.contract-code = old-arh-trn-doc-contract.contract-code and
      636                                                            old-next-arh-trn-doc-contract.cli-type      = old-arh-trn-doc-contract.cli-type      and
      637                                                            old-next-arh-trn-doc-contract.cli-code      = old-arh-trn-doc-contract.cli-code      and
      638                                                            old-next-arh-trn-doc-contract.obj-type      = old-arh-trn-doc-contract.obj-type      and
      639                                                            old-next-arh-trn-doc-contract.obj-code      = old-arh-trn-doc-contract.obj-code      and
      640                                                            old-next-arh-trn-doc-contract.ext-doc-type  = old-arh-trn-doc-contract.ext-doc-type  and
      641                                                            old-next-arh-trn-doc-contract.sum-type      = old-arh-trn-doc-contract.sum-type      and
      642                                                            old-next-arh-trn-doc-contract.fact-order    > old-arh-trn-doc-contract.fact-order    and
      643                                                            old-next-arh-trn-doc-contract.fact-order    <= var-fact-order-docs                   no-lock no-error.
      644             if not available old-next-arh-trn-doc-contract then do:
      645               create new-arh-trn-doc-contract.
      646               BUFFER-COPY old-arh-trn-doc-contract to new-arh-trn-doc-contract.
      647             end.
      648           end.
      649           find first old-arh-trn-doc-contract-attr no-lock  where
      650                       old-arh-trn-doc-contract-attr.host-code     = old-arh-trn-doc-contract.host-code     and
      651                       old-arh-trn-doc-contract-attr.contract-code = old-arh-trn-doc-contract.contract-code and
      652                       old-arh-trn-doc-contract-attr.cli-type      = old-arh-trn-doc-contract.cli-type      and
      653                       old-arh-trn-doc-contract-attr.cli-code      = old-arh-trn-doc-contract.cli-code      and
      654                       old-arh-trn-doc-contract-attr.obj-type      = old-arh-trn-doc-contract.obj-type      and
      655                       old-arh-trn-doc-contract-attr.obj-code      = old-arh-trn-doc-contract.obj-code      and
      656                       old-arh-trn-doc-contract-attr.ext-doc-type  = old-arh-trn-doc-contract.ext-doc-type  and
      657                       old-arh-trn-doc-contract-attr.sum-type      = old-arh-trn-doc-contract.sum-type      and
      658                       old-arh-trn-doc-contract-attr.fact-order    = old-arh-trn-doc-contract.fact-order
      659                       no-error.
      660           if available old-arh-trn-doc-contract-attr then do:
      661               find first new-arh-trn-doc-contract-attr no-lock  where
      662                           new-arh-trn-doc-contract-attr.host-code     = old-arh-trn-doc-contract.host-code     and
      663                           new-arh-trn-doc-contract-attr.contract-code = old-arh-trn-doc-contract.contract-code and
      664                           new-arh-trn-doc-contract-attr.cli-type      = old-arh-trn-doc-contract.cli-type      and
      665                           new-arh-trn-doc-contract-attr.cli-code      = old-arh-trn-doc-contract.cli-code      and
      666                           new-arh-trn-doc-contract-attr.obj-type      = old-arh-trn-doc-contract.obj-type      and
      667                           new-arh-trn-doc-contract-attr.obj-code      = old-arh-trn-doc-contract.obj-code      and
      668                           new-arh-trn-doc-contract-attr.ext-doc-type  = old-arh-trn-doc-contract.ext-doc-type  and
      669                           new-arh-trn-doc-contract-attr.sum-type      = old-arh-trn-doc-contract.sum-type      and
      670                           new-arh-trn-doc-contract-attr.fact-order    = old-arh-trn-doc-contract.fact-order
      671                           no-error.
      672                   if not available new-arh-trn-doc-contract-attr then do:
      673                       create new-arh-trn-doc-contract-attr.
      674                       BUFFER-COPY old-arh-trn-doc-contract-attr to new-arh-trn-doc-contract-attr.
      675                   end.
      676           end.
      677       end.
      678     end.
      679     output stream str-gen close.
      680     return "Произведен экспорт таблиц: trn-doc-sum doc-line-sum parts-root parts-supp parts-attr arh-trn-doc-contract part-obj-attr c-parts-obj-attr.".
      681   end.
