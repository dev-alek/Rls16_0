      441   define buffer old-arh-fin-doc-contr-s-tax-obj for src.arh-fin-doc-contr-s-tax-obj.
      442   define buffer bf_arh-fin-doc-contr-s-tax-obj  for src.arh-fin-doc-contr-s-tax-obj.
      443   define buffer new-arh-fin-doc-contr-s-tax-obj for dst.arh-fin-doc-contr-s-tax-obj.
      444   define buffer old-arh-fin-doc-contr-schet     for src.arh-fin-doc-contr-schet.
      445   define buffer bf_arh-fin-doc-contr-schet      for src.arh-fin-doc-contr-schet.
      446   define buffer new-arh-fin-doc-contr-schet     for dst.arh-fin-doc-contr-schet.
      447   define buffer old-arh-fin-doc-contr-schet-nal for src.arh-fin-doc-contr-schet-nal.
      448   define buffer bf_arh-fin-doc-contr-schet-nal  for src.arh-fin-doc-contr-schet-nal.
      449   define buffer new-arh-fin-doc-contr-schet-nal for dst.arh-fin-doc-contr-schet-nal.
      450   define buffer old-arh-fin-doc-contr-schet-obj for src.arh-fin-doc-contr-schet-obj.
      451   define buffer bf_arh-fin-doc-contr-schet-obj  for src.arh-fin-doc-contr-schet-obj.
      452   define buffer new-arh-fin-doc-contr-schet-obj for dst.arh-fin-doc-contr-schet-obj.
      453   define buffer old-arh-fin-doc-contr-schet-tax for src.arh-fin-doc-contr-schet-tax.
      454   define buffer bf_arh-fin-doc-contr-schet-tax  for src.arh-fin-doc-contr-schet-tax.
      455   define buffer new-arh-fin-doc-contr-schet-tax for dst.arh-fin-doc-contr-schet-tax.
      456   define buffer old-arh-fin-doc-s-tax-nal-obj   for src.arh-fin-doc-s-tax-nal-obj.
      457   define buffer bf_arh-fin-doc-s-tax-nal-obj    for src.arh-fin-doc-s-tax-nal-obj.
      458   define buffer new-arh-fin-doc-s-tax-nal-obj   for dst.arh-fin-doc-s-tax-nal-obj.
      459   define buffer old-arh-fin-doc-schet           for src.arh-fin-doc-schet.
      460   define buffer bf_arh-fin-doc-schet            for src.arh-fin-doc-schet.
      461   define buffer new-arh-fin-doc-schet           for dst.arh-fin-doc-schet.
      462   define buffer old-arh-fin-doc-schet-nal       for src.arh-fin-doc-schet-nal.
