      423   define buffer old-arh-fin-doc-an-nal          for src.arh-fin-doc-an-nal.
      424   define buffer bf_arh-fin-doc-an-nal           for src.arh-fin-doc-an-nal.
      425   define buffer new-arh-fin-doc-an-nal          for dst.arh-fin-doc-an-nal.
      426   define buffer old-arh-fin-doc-an-nal-obj      for src.arh-fin-doc-an-nal-obj.
      427   define buffer bf_arh-fin-doc-an-nal-obj       for src.arh-fin-doc-an-nal-obj.
      428   define buffer new-arh-fin-doc-an-nal-obj      for dst.arh-fin-doc-an-nal-obj.
      429   define buffer old-arh-fin-doc-an-obj          for src.arh-fin-doc-an-obj.
