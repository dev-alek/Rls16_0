      431   define buffer new-arh-fin-doc-an-obj          for dst.arh-fin-doc-an-obj.
      432   define buffer old-arh-fin-doc-c-s-tax-nal-obj for src.arh-fin-doc-c-s-tax-nal-obj.
      433   define buffer bf_arh-fin-doc-c-s-tax-nal-obj  for src.arh-fin-doc-c-s-tax-nal-obj.
      434   define buffer new-arh-fin-doc-c-s-tax-nal-obj for dst.arh-fin-doc-c-s-tax-nal-obj.
      435   define buffer old-arh-fin-doc-c-schet-tax-nal for src.arh-fin-doc-c-schet-tax-nal.
      436   define buffer bf_arh-fin-doc-c-schet-tax-nal  for src.arh-fin-doc-c-schet-tax-nal.
      437   define buffer new-arh-fin-doc-c-schet-tax-nal for dst.arh-fin-doc-c-schet-tax-nal.
      438   define buffer old-arh-fin-doc-contr-s-nal-obj for src.arh-fin-doc-contr-s-nal-obj.
      439   define buffer bf_arh-fin-doc-contr-s-nal-obj  for src.arh-fin-doc-contr-s-nal-obj.
