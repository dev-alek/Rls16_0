      133   do
      134   on error undo, return error
      135   :
      136   define input parameter vartype-cut            as integer   no-undo.
      137   define input parameter varlist-db             as character no-undo.
      138   define input parameter vardate-actual-goods   as date      no-undo.
      139   define input parameter vardate-actual-docs    as date      no-undo.
      140   define input parameter vardate-actual-findoc  as date      no-undo.
      141   define input parameter vardate-output-zone    as date      no-undo.
      142   define input parameter varstay-recipe-goods   as logical   no-undo.
      143   define input parameter varstay-weight-goods   as logical   no-undo.
      144   define input parameter varnot-copy-del-goods  as logical   no-undo.
      145   define input parameter varstay-history        as logical   no-undo.
      146   define input parameter vargen-file            as character no-undo.
      147   define stream str-gen.
      148   output stream str-gen to vargen-file append.
      149   if not connected("src") then do:
      150      return error "Нет коннекта с базой 'src'.".
      151   end.
      152   if not connected("dst") then do:
      153      return error "Нет коннекта с базой 'dst'.".
      154   end.
      155   find src.sys-ctrl no-lock.
      156   if not available src.sys-ctrl then do:
      157      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      158   end.
      159   if src.sys-ctrl.db-num <> 0 then do:
      160      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      161   end.
      162   if vardate-actual-docs <> ? and
      163      (vardate-actual-goods   > vardate-actual-docs or
      164       vardate-actual-goods   = ? )   then do:
      165         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      166                                 "Дата актуальности товаров &1."        +
      167                                 "Дата актуальности документов &2."     +
      168                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      169                                 vardate-actual-goods,
      170                                 vardate-actual-docs).
      171   end.
