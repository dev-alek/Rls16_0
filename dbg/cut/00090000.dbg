       94   DEFINE temp-table temp-del-yes no-undo
       95     field host-code  as integer
       96     field doc-code  as character
       97     field type  as integer
       98     INDEX pi IS PRIMARY type host-code doc-code
       99   .
      100   DEFINE temp-table temp-del-no no-undo
      101     field host-code  as integer
      102     field doc-code   as character
      103     field type       as integer
      104     INDEX pi IS PRIMARY type host-code doc-code
      105   .
      106   DEFINE temp-table temp-cur no-undo
      107     field host-code  as integer
      108     field doc-code  as character
      109     field type  as integer
      110     INDEX pi IS PRIMARY type host-code doc-code
      111   .
      112   do
      113   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      114   :
      115   define input parameter vartype-cut            as integer   no-undo.
      116   define input parameter varlist-db             as character no-undo.
      117   define input parameter vardate-actual-goods   as date      no-undo.
      118   define input parameter vardate-actual-docs    as date      no-undo.
      119   define input parameter vardate-actual-findoc  as date      no-undo.
      120   define input parameter vardate-output-zone    as date      no-undo.
      121   define input parameter varstay-recipe-goods   as logical   no-undo.
      122   define input parameter varstay-weight-goods   as logical   no-undo.
      123   define input parameter varnot-copy-del-goods  as logical   no-undo.
      124   define input parameter varstay-history        as logical   no-undo.
      125   define input parameter vargen-file            as character no-undo.
      126   define stream str-gen.
      127   output stream str-gen to vargen-file append.
      128   if not connected("src") then do:
      129      return error "Нет коннекта с базой 'src'.".
      130   end.
      131   if not connected("dst") then do:
      132      return error "Нет коннекта с базой 'dst'.".
      133   end.
      134   find src.sys-ctrl no-lock.
      135   if not available src.sys-ctrl then do:
      136      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      137   end.
      138   if src.sys-ctrl.db-num <> 0 then do:
      139      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      140   end.
      141   if vardate-actual-docs <> ? and
      142      (vardate-actual-goods   > vardate-actual-docs or
      143       vardate-actual-goods   = ? )   then do:
      144         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      145                                 "Дата актуальности товаров &1."        +
      146                                 "Дата актуальности документов &2."     +
      147                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      148                                 vardate-actual-goods,
      149                                 vardate-actual-docs).
      150   end.
      151     on WRITE of dst.fin-connect        override do: end.
      152     on WRITE of dst.c-fin-connect      override do: end.
      153     on WRITE of dst.fin-doc            override do: end.
      154     on WRITE of dst.fin-doc-attr       override do: end.
      155     on WRITE of dst.fin-doc-tax        override do: end.
      156     on WRITE of dst.fin-doc-tax-attr  override do: end.
      157     on WRITE of dst.c-fin-doc          override do: end.
      158     on WRITE of dst.c-fin-doc-attr     override do: end.
      159     on WRITE of dst.c-fin-doc-tax      override do: end.
      160     on WRITE of dst.fin-doc-obj        override do: end.
      161     on WRITE of dst.fin-ob             override do: end.
      162     on WRITE of dst.fin-ob-attr        override do: end.
      163     on WRITE of dst.fin-ob-tax         override do: end.
      164     on WRITE of dst.fin-ob-tax-attr    override do: end.
      165     on WRITE of dst.fin-gds-part       override do: end.
      166     on WRITE of dst.fin-gds-part-attr  override do: end.
      167     on WRITE of dst.c-fin-ob           override do: end.
      168     on WRITE of dst.c-fin-ob-attr      override do: end.
      169     on WRITE of dst.c-fin-ob-tax       override do: end.
      170     on WRITE of dst.c-fin-gds-part     override do: end.
      171     on WRITE of dst.fin-ob-before      override do: end.
      172     on WRITE of dst.fin-ob-tax-before  override do: end.
      173     on WRITE of dst.fin-ob-trn         override do: end.
      174     on WRITE of dst.fin-ob-cor-acc-lk  override do: end.
      175     on WRITE of dst.fin-ob-schet-lk    override do: end.
      176     on WRITE of dst.fin-doc-cor-acc-lk override do: end.
      177     on WRITE of dst.fin-doc-schet-lk   override do: end.
      178     on WRITE of dst.fin-statement      override do: end.
      179     on WRITE of dst.c-fin-statement    override do: end.
      180     on WRITE of dst.fin-statement-attr      override do: end.
      181     on WRITE of dst.c-fin-statement-attr    override do: end.
      182     on WRITE of dst.fin-statement-line      override do: end.
      183     on WRITE of dst.c-fin-statement-line    override do: end.
      184     on WRITE of dst.fin-statement-line-attr      override do: end.
      185   on WRITE of dst.fin-connect-attr          override do: end.
      186   on WRITE of dst.fin-doc-cor-acc-lk-attr   override do: end.
      187   on WRITE of dst.fin-doc-obj-attr          override do: end.
      188   on WRITE of dst.fin-doc-schet-lk-attr     override do: end.
      189   on WRITE of dst.fin-ob-cor-acc-lk-attr    override do: end.
      190   on WRITE of dst.fin-ob-schet-lk-attr      override do: end.
      191   on WRITE of dst.fin-ob-trn-attr           override do: end.
      192     define variable is-del as logical   no-undo .
      193     for each buf_old_fin-ob no-lock
      194       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      195       :
      196       assign is-del = no .
      197       if  buf_old_fin-ob.fact-date <= vardate-actual-findoc then do:
      198         assign is-del = yes .
      199         if buf_old_fin-ob.con-stat < 2 then
      200         do:
      201             if buf_old_fin-ob.con-stat = 0  then
      202                assign is-del = yes .
      203             else assign is-del = no .
      204         end.
      205         else do:
      206           run CheckDel ( input buf_old_fin-ob.host-code, input buf_old_fin-ob.doc-code, input 0 , output is-del ) .
      207           if is-del = yes then do:
      208             for each temp-cur :
      209               find first temp-del-yes where
      210                           temp-del-yes.host-code = temp-cur.host-code and
      211                           temp-del-yes.doc-code  = temp-cur.doc-code  and
      212                           temp-del-yes.type      = temp-cur.type no-error .
      213               if not available temp-del-yes then do:
      214                   create temp-del-yes.
      215                   BUFFER-COPY temp-cur TO temp-del-yes no-error .
      216               end.
      217               delete temp-cur .
      218             end.
      219           end.
      220           else do:
      221             for each temp-cur :
      222               find first temp-del-no where
      223                           temp-del-no.host-code = temp-cur.host-code and
      224                           temp-del-no.doc-code  = temp-cur.doc-code  and
      225                           temp-del-no.type      = temp-cur.type no-error .
      226               if not available temp-del-no then do:
      227                   create temp-del-no.
      228                   BUFFER-COPY temp-cur TO temp-del-no no-error .
      229               end.
      230               delete temp-cur .
      231             end.
      232           end.
      233         end.
      234       end.
      235       if is-del = no then do:
      236         create buf_new_fin-ob.
      237         buffer-copy buf_old_fin-ob to buf_new_fin-ob.
      238         for each buf_old_fin-connect no-lock
      239           where buf_old_fin-connect.host-code   = buf_old_fin-ob.host-code
      240             and buf_old_fin-connect.fin-ob-code = buf_old_fin-ob.doc-code
      241           :
      242           create buf_new_fin-connect.
      243           buffer-copy buf_old_fin-connect to buf_new_fin-connect.
      244           if varstay-history = yes then do:
      245             for each buf_old_c-fin-connect no-lock
      246               where buf_old_c-fin-connect.host-code   = buf_old_fin-connect.host-code
      247                 and buf_old_c-fin-connect.connect-code = buf_old_fin-connect.connect-code
      248               :
      249               create buf_new_c-fin-connect.
      250               buffer-copy buf_old_c-fin-connect to buf_new_c-fin-connect.
      251             end.
      252           end.
      253         end.
      254         for each buf_old_fin-ob-attr no-lock
      255           where buf_old_fin-ob-attr.host-code = buf_old_fin-ob.host-code
      256             and buf_old_fin-ob-attr.doc-code  = buf_old_fin-ob.doc-code
      257           :
      258           create buf_new_fin-ob-attr.
      259           buffer-copy buf_old_fin-ob-attr to buf_new_fin-ob-attr.
      260         end.
      261         for each buf_old_fin-ob-tax no-lock
      262           where buf_old_fin-ob-tax.host-code = buf_old_fin-ob.host-code
      263             and buf_old_fin-ob-tax.doc-code  = buf_old_fin-ob.doc-code
      264           :
      265           create buf_new_fin-ob-tax.
      266           buffer-copy buf_old_fin-ob-tax to buf_new_fin-ob-tax.
      267         end.
      268         for each buf_old_fin-ob-tax-attr no-lock
      269           where buf_old_fin-ob-tax-attr.host-code = buf_old_fin-ob.host-code
      270             and buf_old_fin-ob-tax-attr.doc-code  = buf_old_fin-ob.doc-code
      271           :
      272           create buf_new_fin-ob-tax-attr.
      273           buffer-copy buf_old_fin-ob-tax-attr to buf_new_fin-ob-tax-attr.
      274         end.
      275         for each buf_old_fin-gds-part no-lock
      276           where buf_old_fin-gds-part.host-code   = buf_old_fin-ob.host-code
      277             and buf_old_fin-gds-part.fin-ob-code = buf_old_fin-ob.doc-code
      278           :
      279           create buf_new_fin-gds-part.
      280           buffer-copy buf_old_fin-gds-part to buf_new_fin-gds-part.
      281         end.
      282         for each buf_old_fin-gds-part-attr no-lock
      283           where buf_old_fin-gds-part-attr.host-code   = buf_old_fin-ob.host-code
      284             and buf_old_fin-gds-part-attr.fin-ob-code = buf_old_fin-ob.doc-code
      285           :
      286           find first buf_new_fin-gds-part-attr no-lock where
      287             buf_new_fin-gds-part-attr.host-code   = buf_old_fin-gds-part-attr.host-code      and
      288             buf_new_fin-gds-part-attr.fin-ob-code = buf_old_fin-gds-part-attr.fin-ob-code    and
      289             buf_new_fin-gds-part-attr.obj-type    = buf_old_fin-gds-part-attr.obj-type       and
      290             buf_new_fin-gds-part-attr.obj-code    = buf_old_fin-gds-part-attr.obj-code       and
      291             buf_new_fin-gds-part-attr.gds-code    = buf_old_fin-gds-part-attr.gds-code       and
      292             buf_new_fin-gds-part-attr.in-code     = buf_old_fin-gds-part-attr.in-code        and
      293             buf_new_fin-gds-part-attr.part-code   = buf_old_fin-gds-part-attr.part-code      and
      294             buf_new_fin-gds-part-attr.out-code    = buf_old_fin-gds-part-attr.out-code       and
      295             buf_new_fin-gds-part-attr.doc-type    = buf_old_fin-gds-part-attr.doc-type      and
      296             buf_new_fin-gds-part-attr.attr-code   = buf_old_fin-gds-part-attr.attr-code    no-error .
      297            if not available buf_new_fin-gds-part-attr then do:
      298               create buf_new_fin-gds-part-attr.
      299               buffer-copy buf_old_fin-gds-part-attr to buf_new_fin-gds-part-attr.
      300            end.
      301         end.
      302         for each buf_old_fin-ob-trn no-lock
      303           where buf_old_fin-ob-trn.host-code = buf_old_fin-ob.host-code
      304             and buf_old_fin-ob-trn.doc-code  = buf_old_fin-ob.doc-code
      305           :
      306           find first dst.trn-doc no-lock where dst.trn-doc.doc-code = buf_old_fin-ob-trn.trn-doc-code no-error .
      307           if not available dst.trn-doc then next .
      308           create buf_new_fin-ob-trn.
      309           buffer-copy buf_old_fin-ob-trn to buf_new_fin-ob-trn.
      310         end.
      311         if varstay-history = yes then do:
      312           for each buf_old_c-fin-ob no-lock
      313             where buf_old_c-fin-ob.host-code = buf_old_fin-ob.host-code
      314               and buf_old_c-fin-ob.doc-code  = buf_old_fin-ob.doc-code
      315             :
      316             create buf_new_c-fin-ob.
      317             buffer-copy buf_old_c-fin-ob to buf_new_c-fin-ob.
      318             for each buf_old_c-fin-ob-attr no-lock
      319               where buf_old_c-fin-ob-attr.host-code = buf_old_c-fin-ob.host-code
      320                 and buf_old_c-fin-ob-attr.doc-code  = buf_old_c-fin-ob.doc-code
      321                 and buf_old_c-fin-ob-attr.chip-num  = buf_old_c-fin-ob.chip-num
      322               :
      323               create buf_new_c-fin-ob-attr.
      324               buffer-copy buf_old_c-fin-ob-attr to buf_new_c-fin-ob-attr.
      325             end.
      326             for each buf_old_c-fin-ob-tax no-lock
      327               where buf_old_c-fin-ob-tax.host-code = buf_old_c-fin-ob.host-code
      328                 and buf_old_c-fin-ob-tax.doc-code  = buf_old_c-fin-ob.doc-code
      329                 and buf_old_c-fin-ob-tax.chip-num  = buf_old_c-fin-ob.chip-num
      330               :
      331               create buf_new_c-fin-ob-tax.
      332               buffer-copy buf_old_c-fin-ob-tax to buf_new_c-fin-ob-tax.
      333             end.
      334             for each buf_old_c-fin-gds-part no-lock
      335               where buf_old_c-fin-gds-part.host-code   = buf_old_c-fin-ob.host-code
      336                 and buf_old_c-fin-gds-part.fin-ob-code = buf_old_c-fin-ob.doc-code
      337                 and buf_old_c-fin-gds-part.chip-num    = buf_old_c-fin-ob.chip-num
      338               :
      339               create buf_new_c-fin-gds-part.
      340               buffer-copy buf_old_c-fin-gds-part to buf_new_c-fin-gds-part.
      341             end.
      342           end.
      343         end.
      344       end.
      345     end.
      346     for each buf_old_fin-ob-before no-lock
      347       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      348       :
      349       if buf_old_fin-ob-before.status_ = 'факт':U or buf_old_fin-ob-before.doc-code <> ""  then next .
      350       find first dst.trn-doc no-lock where dst.trn-doc.doc-code = buf_old_fin-ob-before.trn-doc-code no-error .
      351       if not available dst.trn-doc then next .
      352       create buf_new_fin-ob-before.
      353       buffer-copy buf_old_fin-ob-before to buf_new_fin-ob-before.
      354       for each buf_old_fin-ob-tax-before no-lock
      355         where buf_old_fin-ob-tax-before.host-code   = buf_old_fin-ob-before.host-code
      356           and buf_old_fin-ob-tax-before.before-code = buf_old_fin-ob-before.before-code
      357         :
      358         create buf_new_fin-ob-tax-before.
      359         buffer-copy buf_old_fin-ob-tax-before to buf_new_fin-ob-tax-before.
      360       end.
      361     end.
      362     for each buf_old_fin-doc no-lock
      363       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      364       :
      365       assign is-del = no .
      366       if vardate-actual-findoc >= buf_old_fin-doc.fact-date  then do:
      367         if buf_old_fin-doc.con-stat < 2 then assign is-del = no .
      368         else do:
      369           find first temp-del-yes
      370             where temp-del-yes.host-code = buf_old_fin-doc.host-code
      371               and temp-del-yes.doc-code  = string(buf_old_fin-doc.fin-doc-code)
      372               and temp-del-yes.type      = 1
      373           no-error .
      374           if available temp-del-yes then is-del = yes .
      375         end.
      376       end.
      377       if is-del = no then do :
      378         create buf_new_fin-doc.
      379         buffer-copy buf_old_fin-doc to buf_new_fin-doc.
      380         for each buf_old_fin-doc-attr no-lock
      381           where buf_old_fin-doc-attr.host-code = buf_old_fin-doc.host-code
      382             and buf_old_fin-doc-attr.fin-doc-code  = buf_old_fin-doc.fin-doc-code
      383           :
      384           create buf_new_fin-doc-attr.
      385           buffer-copy buf_old_fin-doc-attr to buf_new_fin-doc-attr.
      386         end.
      387         for each buf_old_fin-doc-tax no-lock
      388           where buf_old_fin-doc-tax.host-code = buf_old_fin-doc.host-code
      389             and buf_old_fin-doc-tax.fin-doc-code  = buf_old_fin-doc.fin-doc-code
      390           :
      391           create buf_new_fin-doc-tax.
      392           buffer-copy buf_old_fin-doc-tax to buf_new_fin-doc-tax.
      393         end.
      394         for each buf_old_fin-doc-tax-attr no-lock
      395           where buf_old_fin-doc-tax-attr.host-code = buf_old_fin-doc.host-code
      396             and buf_old_fin-doc-tax-attr.fin-doc-code  = buf_old_fin-doc.fin-doc-code
      397           :
      398           create buf_new_fin-doc-tax-attr.
      399           buffer-copy buf_old_fin-doc-tax-attr to buf_new_fin-doc-tax-attr.
      400         end.
      401         for each buf_old_fin-doc-obj no-lock
      402           where buf_old_fin-doc-obj.host-code = buf_old_fin-doc.host-code
      403             and buf_old_fin-doc-obj.fin-doc-code  = buf_old_fin-doc.fin-doc-code
      404           :
      405           create buf_new_fin-doc-obj.
      406           buffer-copy buf_old_fin-doc-obj to buf_new_fin-doc-obj.
      407         end.
      408         if varstay-history = yes then do:
      409           for each buf_old_c-fin-doc no-lock
      410             where buf_old_c-fin-doc.host-code     = buf_old_fin-doc.host-code
      411               and buf_old_c-fin-doc.fin-doc-code  = buf_old_fin-doc.fin-doc-code
      412             :
      413             create buf_new_c-fin-doc.
      414             buffer-copy buf_old_c-fin-doc to buf_new_c-fin-doc.
      415             for each buf_old_c-fin-doc-attr no-lock
      416               where buf_old_c-fin-doc-attr.host-code    = buf_old_c-fin-doc.host-code
      417                 and buf_old_c-fin-doc-attr.fin-doc-code = buf_old_c-fin-doc.fin-doc-code
      418                 and buf_old_c-fin-doc-attr.corr-user-db-num = buf_old_c-fin-doc.corr-user-db-num
      419                 and buf_old_c-fin-doc-attr.chip-num     = buf_old_c-fin-doc.chip-num
      420               :
      421               create buf_new_c-fin-doc-attr.
      422               buffer-copy buf_old_c-fin-doc-attr to buf_new_c-fin-doc-attr.
      423             end.
      424             for each buf_old_c-fin-doc-tax no-lock
      425               where buf_old_c-fin-doc-tax.host-code    = buf_old_c-fin-doc.host-code
      426                 and buf_old_c-fin-doc-tax.fin-doc-code = buf_old_c-fin-doc.fin-doc-code
      427                 and buf_old_c-fin-doc-tax.corr-user-db-num = buf_old_c-fin-doc.corr-user-db-num
      428                 and buf_old_c-fin-doc-tax.chip-num     = buf_old_c-fin-doc.chip-num
      429               :
      430               create buf_new_c-fin-doc-tax.
      431               buffer-copy buf_old_c-fin-doc-tax to buf_new_c-fin-doc-tax.
      432             end.
      433           end.
      434         end.
      435       end.
      436     end.
      437     for each buf_old_fin-statement no-lock
      438       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      439       :
      440       assign is-del = no .
      441       if vardate-actual-findoc >= buf_old_fin-statement.fact-date  then do:
      442         create buf_new_fin-statement.
      443         buffer-copy buf_old_fin-statement to buf_new_fin-statement.
      444         for each buf_old_fin-statement-attr no-lock
      445           where buf_old_fin-statement-attr.host-code = buf_old_fin-statement.host-code
      446             and buf_old_fin-statement-attr.sttm-code  = buf_old_fin-statement.sttm-code
      447           :
      448           create buf_new_fin-statement-attr.
      449           buffer-copy buf_old_fin-statement-attr to buf_new_fin-statement-attr.
      450         end.
      451         for each buf_old_fin-statement-line no-lock
      452           where buf_old_fin-statement-line.host-code = buf_old_fin-statement.host-code
      453             and buf_old_fin-statement-line.sttm-code  = buf_old_fin-statement.sttm-code
      454           :
      455           create buf_new_fin-statement-line.
      456           buffer-copy buf_old_fin-statement-line to buf_new_fin-statement-line.
      457         end.
      458         for each buf_old_fin-statement-line-attr no-lock
      459           where buf_old_fin-statement-line-attr.host-code = buf_old_fin-statement.host-code
      460             and buf_old_fin-statement-line-attr.sttm-code  = buf_old_fin-statement.sttm-code
      461           :
      462           create buf_new_fin-statement-line-attr.
      463           buffer-copy buf_old_fin-statement-line-attr to buf_new_fin-statement-line-attr.
      464         end.
      465         if varstay-history = yes then do:
      466           for each buf_old_c-fin-statement no-lock
      467             where buf_old_c-fin-statement.host-code     = buf_old_fin-statement.host-code
      468               and buf_old_c-fin-statement.sttm-code  = buf_old_fin-statement.sttm-code
      469             :
      470             create buf_new_c-fin-statement.
      471             buffer-copy buf_old_c-fin-statement to buf_new_c-fin-statement.
      472             for each buf_old_c-fin-statement-attr no-lock
      473               where buf_old_c-fin-statement-attr.host-code    = buf_old_c-fin-statement.host-code
      474                 and buf_old_c-fin-statement-attr.sttm-code = buf_old_c-fin-statement.sttm-code
      475                 and buf_old_c-fin-statement-attr.corr-user-db-num = buf_old_c-fin-statement.corr-user-db-num
      476                 and buf_old_c-fin-statement-attr.chip-num     = buf_old_c-fin-statement.chip-num
      477               :
      478               create buf_new_c-fin-statement-attr.
      479               buffer-copy buf_old_c-fin-statement-attr to buf_new_c-fin-statement-attr.
      480             end.
      481             for each buf_old_c-fin-statement-line no-lock
      482               where buf_old_c-fin-statement-line.host-code    = buf_old_c-fin-statement.host-code
      483                 and buf_old_c-fin-statement-line.sttm-code = buf_old_c-fin-statement.sttm-code
      484                 and buf_old_c-fin-statement-line.corr-user-db-num = buf_old_c-fin-statement.corr-user-db-num
      485                 and buf_old_c-fin-statement-line.chip-num     = buf_old_c-fin-statement.chip-num
      486               :
      487               create buf_new_c-fin-statement-line.
      488               buffer-copy buf_old_c-fin-statement-line to buf_new_c-fin-statement-line.
      489             end.
      490           end.
      491         end.
      492       end.
      493     end.
      494     for each buf_old_fin-ob-cor-acc-lk no-lock
      495       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      496       :
      497       create buf_new_fin-ob-cor-acc-lk.
      498       buffer-copy buf_old_fin-ob-cor-acc-lk to buf_new_fin-ob-cor-acc-lk.
      499     end.
      500     for each buf_old_fin-ob-schet-lk no-lock
      501       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      502       :
      503       create buf_new_fin-ob-schet-lk.
      504       buffer-copy buf_old_fin-ob-schet-lk to buf_new_fin-ob-schet-lk.
      505     end.
      506     for each buf_old_fin-doc-cor-acc-lk no-lock
      507       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      508       :
      509       create buf_new_fin-doc-cor-acc-lk.
      510       buffer-copy buf_old_fin-doc-cor-acc-lk to buf_new_fin-doc-cor-acc-lk.
      511     end.
      512     for each buf_old_fin-doc-schet-lk no-lock
      513       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      514       :
      515       create buf_new_fin-doc-schet-lk.
      516       buffer-copy buf_old_fin-doc-schet-lk to buf_new_fin-doc-schet-lk.
      517     end.
      518   for each old-fin-connect-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      519      create new-fin-connect-attr.
      520      buffer-copy old-fin-connect-attr to new-fin-connect-attr.
      521   end.
      522   for each old-fin-doc-cor-acc-lk-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      523      create new-fin-doc-cor-acc-lk-attr.
      524      buffer-copy old-fin-doc-cor-acc-lk-attr to new-fin-doc-cor-acc-lk-attr.
      525   end.
      526   for each old-fin-doc-obj-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      527      create new-fin-doc-obj-attr.
      528      buffer-copy old-fin-doc-obj-attr to new-fin-doc-obj-attr.
      529   end.
      530   for each old-fin-doc-schet-lk-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      531      create new-fin-doc-schet-lk-attr.
      532      buffer-copy old-fin-doc-schet-lk-attr to new-fin-doc-schet-lk-attr.
      533   end.
      534   for each old-fin-ob-cor-acc-lk-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      535      create new-fin-ob-cor-acc-lk-attr.
      536      buffer-copy old-fin-ob-cor-acc-lk-attr to new-fin-ob-cor-acc-lk-attr.
      537   end.
      538   for each old-fin-ob-schet-lk-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      539      create new-fin-ob-schet-lk-attr.
      540      buffer-copy old-fin-ob-schet-lk-attr to new-fin-ob-schet-lk-attr.
      541   end.
      542   for each old-fin-ob-trn-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      543      create new-fin-ob-trn-attr.
      544      buffer-copy old-fin-ob-trn-attr to new-fin-ob-trn-attr.
      545   end.
      546     output stream str-gen close.
      547     return "Произведен экспорт таблиц: fin-connect c-fin-connect fin-doc fin-doc-attr fin-doc-tax fin-doc-tax-attr c-fin-doc c-fin-doc-attr c-fin-doc-tax fin-doc-obj fin-ob fin-ob-attr fin-ob-tax fin-gds-part c-fin-ob c-fin-ob-attr c-fin-ob-tax c-fin-gds-part fin-ob-before fin-ob-tax-before fin-ob-trn fin-ob-cor-acc-lk fin-ob-schet-lk fin-doc-cor-acc-lk fin-doc-schet-lk.".
      548   end.
      549   procedure CheckDel :
      550     do on error undo, return error return-value :
      551       define input  parameter p-host-code as integer   no-undo .
      552       define input  parameter p-doc-code  as character no-undo .
      553       define input  parameter p-type      as integer   no-undo .
      554       define output parameter p-is-del    as logical   no-undo .
      555       define buffer bf_fin-ob   for src.fin-ob .
      556       define buffer bf_fin-doc  for src.fin-doc .
      557       assign p-is-del = yes .
      558       find first temp-cur where
      559         temp-cur.host-code = p-host-code and
      560         temp-cur.doc-code  = p-doc-code  and
      561         temp-cur.type      = p-type     no-error .
      562         if  not available  temp-cur then do:
      563             create temp-cur .
      564             assign
      565               temp-cur.host-code = p-host-code
      566               temp-cur.doc-code  = p-doc-code
      567               temp-cur.type      = p-type
      568             .
      569       end.
      570       find first temp-del-yes
      571         where temp-del-yes.host-code = p-host-code
      572           and temp-del-yes.doc-code  = p-doc-code
      573           and temp-del-yes.type      = p-type
      574       no-error .
      575       if available temp-del-yes then do:
      576         assign p-is-del = yes .
      577         return .
      578       end.
      579       find first temp-del-no
      580         where temp-del-no.host-code = p-host-code
      581           and temp-del-no.doc-code  = p-doc-code
      582           and temp-del-no.type      = p-type
      583       no-error .
      584       if available temp-del-no then do:
      585         assign p-is-del = no .
      586         return .
      587       end.
      588       if p-type = 0 then do:
      589         for each buf_old_fin-connect no-lock
      590           where buf_old_fin-connect.host-code   = p-host-code
      591             and buf_old_fin-connect.fin-ob-code = p-doc-code
      592           :
      593           find first bf_fin-doc no-lock
      594             where bf_fin-doc.host-code    = buf_old_fin-connect.host-code
      595               and bf_fin-doc.fin-doc-code = buf_old_fin-connect.fin-doc-code
      596           no-error .
      597           if available bf_fin-doc then do:
      598             if ( bf_fin-doc.con-stat = 1  ) or bf_fin-doc.fact-date >= vardate-actual-findoc then do:
      599               assign p-is-del = no .
      600               return  .
      601             end.
      602             else do:
      603               find first temp-cur where
      604                          temp-cur.host-code = p-host-code and
      605                          temp-cur.doc-code  = string(bf_fin-doc.fin-doc-code) and
      606                          temp-cur.type = 1
      607                          no-error .
      608                         if not available temp-cur then do:
      609                           run CheckDel ( input p-host-code, input bf_fin-doc.fin-doc-code, input 1 , output p-is-del ) .
      610                           if p-is-del = no then return .
      611                         end.
      612             end.
      613           end.
      614         end.
      615       end.
      616       else do:
      617         for each buf_old_fin-connect no-lock
      618           where buf_old_fin-connect.host-code   = p-host-code
      619             and buf_old_fin-connect.fin-doc-code = integer (p-doc-code)
      620           :
      621           find first bf_fin-ob no-lock
      622             where bf_fin-ob.host-code = buf_old_fin-connect.host-code
      623               and bf_fin-ob.doc-code  = buf_old_fin-connect.fin-ob-code
      624           no-error .
      625           if available bf_fin-ob then do:
      626             if ( bf_fin-ob.con-stat = 1 and bf_fin-ob.fact-date < vardate-actual-findoc ) or bf_fin-ob.fact-date >= vardate-actual-findoc then do:
      627               assign p-is-del = no .
      628               return .
      629             end.
      630             else do:
      631               find first temp-cur where
      632                          temp-cur.host-code = p-host-code and
      633                          temp-cur.doc-code  = bf_fin-ob.doc-code and
      634                          temp-cur.type = 0
      635                          no-error .
      636                         if not available temp-cur then do:
      637                           run CheckDel ( input p-host-code, input bf_fin-ob.doc-code, input 0 , output p-is-del ) .
      638                           if p-is-del = no then return .
      639                         end.
      640             end.
      641           end.
      642         end.
      643       end.
      644     end.
      645   end procedure.
