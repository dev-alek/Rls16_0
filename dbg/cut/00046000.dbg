        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 36493b7e3299, 155, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Feb 17 18:03:53 2015 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00046000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00046000.p $":U.
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 46.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-c-trn-doc   for src.c-trn-doc.
       13   define buffer new-c-trn-doc   for dst.c-trn-doc.
       14   define buffer old-c-doc-line  for src.c-doc-line.
       15   define buffer new-c-doc-line  for dst.c-doc-line.
       16   define buffer new-shop        for dst.shop.
       17   define buffer new-store       for dst.store.
       18   define buffer old-c-doc-line-attr  for src.c-doc-line-attr.
       19   define buffer new-c-doc-line-attr  for dst.c-doc-line-attr.
       20   define buffer old-c-gds-dtl  for src.c-gds-dtl.
       21   define buffer new-c-gds-dtl  for dst.c-gds-dtl.
       22   define buffer old-c-gds-dtl-attr  for src.c-gds-dtl-attr.
       23   define buffer new-c-gds-dtl-attr  for dst.c-gds-dtl-attr.
       24   define buffer old-c-doc-pl        for src.c-doc-pl.
       25   define buffer new-c-doc-pl        for dst.c-doc-pl.
       26   define buffer old-c-doc-pl-pump   for src.c-doc-pl-pump.
       27   define buffer new-c-doc-pl-pump   for dst.c-doc-pl-pump.
       28   define buffer new-pump            for dst.pump.
       29   define buffer new-place           for dst.place.
       30   define buffer old-c-inkas          for src.c-inkas          .
       31   define buffer new-c-inkas          for dst.c-inkas          .
       32   define buffer old-c-sale-doc       for src.c-sale-doc       .
       33   define buffer new-c-sale-doc       for dst.c-sale-doc       .
       34   define buffer old-c-inkas-pay      for src.c-inkas-pay      .
       35   define buffer new-c-inkas-pay      for dst.c-inkas-pay      .
       36   define buffer old-c-inkas-pay-desk for src.c-inkas-pay-desk .
       37   define buffer new-c-inkas-pay-desk for dst.c-inkas-pay-desk .
       38   define buffer old-c-inkas-pay-wth  for src.c-inkas-pay-wth  .
       39   define buffer new-c-inkas-pay-wth  for dst.c-inkas-pay-wth  .
       40   define buffer old-c-doc-prts       for src.c-doc-prts       .
       41   define buffer new-c-doc-prts       for dst.c-doc-prts       .
       42   define buffer old-c-parts          for src.c-parts          .
       43   define buffer new-c-parts          for dst.c-parts          .
       44   define buffer old-c-parts-root     for src.c-parts-root          .
       45   define buffer new-c-parts-root     for dst.c-parts-root          .
       46   do
       47   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       48   define input parameter vartype-cut            as integer   no-undo.
       49   define input parameter varlist-db             as character no-undo.
       50   define input parameter vardate-actual-goods   as date      no-undo.
       51   define input parameter vardate-actual-docs    as date      no-undo.
       52   define input parameter vardate-actual-findoc  as date      no-undo.
       53   define input parameter vardate-output-zone    as date      no-undo.
       54   define input parameter varstay-recipe-goods   as logical   no-undo.
       55   define input parameter varstay-weight-goods   as logical   no-undo.
       56   define input parameter varnot-copy-del-goods  as logical   no-undo.
       57   define input parameter varstay-history        as logical   no-undo.
       58   define input parameter vargen-file            as character no-undo.
       59   define stream str-gen.
       60   output stream str-gen to vargen-file append.
       61   if not connected("src") then do:
       62      return error "Нет коннекта с базой 'src'.".
       63   end.
       64   if not connected("dst") then do:
       65      return error "Нет коннекта с базой 'dst'.".
       66   end.
       67   find src.sys-ctrl no-lock.
       68   if not available src.sys-ctrl then do:
       69      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       70   end.
       71   if src.sys-ctrl.db-num <> 0 then do:
       72      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       73   end.
       74   if vardate-actual-docs <> ? and
       75      (vardate-actual-goods   > vardate-actual-docs or
       76       vardate-actual-goods   = ? )   then do:
       77         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       78                                 "Дата актуальности товаров &1."        +
       79                                 "Дата актуальности документов &2."     +
       80                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       81                                 vardate-actual-goods,
       82                                 vardate-actual-docs).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure factord :
       88     define input  parameter p-fact-date            as date    no-undo .
       89     define input  parameter p-fact-time            as integer no-undo .
       90     define input  parameter p-fact-num             as integer no-undo .
       91     define input  parameter p-shift-date           as date    no-undo .
       92     define input  parameter p-shift-num            as integer no-undo .
       93     define input  parameter p-shift-on             as logical no-undo .
       94     define output parameter p-fact-order           as decimal no-undo .
       95     define output parameter p-shift-end-fact-order as decimal no-undo .
       96     define output parameter p-day-end-fact-order   as decimal no-undo .
       97     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       98     if p-fact-date = ?
       99     then do:
      100       return error "Не указана фактическая дата" .
      101     end.
      102     define variable v-fact-date-num as integer no-undo .
      103     assign
      104       v-fact-date-num = integer(p-fact-date)
      105     .
      106     if p-fact-num = ?
      107     or p-fact-num = 0
      108     then do:
      109       return error "Не задан p-fact-num " + string(p-fact-num) .
      110     end.
      111     if p-fact-num < 0
      112     then do:
      113       return error "Отрицательный fact-num " + string(p-fact-num) .
      114     end.
      115     if p-fact-num >= 100000000
      116     then do:
      117       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      118     end.
      119     if p-shift-on = true
      120     then do:
      121       if p-shift-date = ?
      122       then do:
      123         return error "Не задана дата смены" .
      124       end.
      125       if p-shift-num = ?
      126       or p-shift-num = 0
      127       then do:
      128         return error "Не задан номер смены" .
      129       end.
      130     end.
      131     else do:
      132       assign
      133         p-shift-date = p-fact-date
      134         p-shift-num  = 24
      135       .
      136     end.
      137     define variable v-shift-offset as integer no-undo .
      138     if p-shift-date = p-fact-date
      139     then do:
      140       assign
      141         v-shift-offset = 1
      142       .
      143     end.
      144     if p-shift-date < p-fact-date
      145     then do:
      146       assign
      147         v-shift-offset = 0
      148       .
      149     end.
      150     if p-shift-date > p-fact-date
      151     then do:
      152       message
      153         vss-workfile vss-revision vss-description skip
      154         "Неправильная дата закрытия смены" skip
      155         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      156         view-as alert-box error .
      157       undo, return error
      158         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      159           ,string(p-fact-date, '99/99/9999':U)
      160           ,string(p-shift-date, '99/99/9999':U)
      161           )
      162       .
      163     end.
      164     if p-shift-num < 1
      165     or p-shift-num > 24
      166     then do:
      167       message
      168         vss-workfile vss-revision vss-description skip
      169         "Неправильный номер смены" skip
      170         "p-shift-num" p-shift-num skip
      171         view-as alert-box error .
      172       undo, return error return-value .
      173     end.
      174     assign
      175       p-fact-order           = v-fact-date-num
      176                              + v-shift-offset * 0.5
      177                              + p-shift-num    * 0.02 - 0.01
      178                              + p-fact-num     * 0.0000000001
      179       p-shift-end-fact-order = v-fact-date-num
      180                              + v-shift-offset * 0.5
      181                              + p-shift-num    * 0.02
      182       p-day-end-fact-order   = v-fact-date-num
      183                              + 0.99
      184     .
      185     if p-fact-order           <= v-fact-date-num
      186     or p-shift-end-fact-order <= v-fact-date-num
      187     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      188     or p-shift-end-fact-order >= p-day-end-fact-order
      189     then do:
      190       message
      191         vss-workfile vss-revision vss-description skip
      192         "Внутренняя ошибка при генерации фактического номера" skip
      193         "p-fact-date"            p-fact-date            skip
      194         "p-fact-time"            p-fact-time            skip
      195         "p-fact-num"             p-fact-num             skip
      196         "p-shift-date"           p-shift-date           skip
      197         "p-shift-num"            p-shift-num            skip
      198         "p-shift-on"             p-shift-on             skip
      199         "p-shift-end-fact-order" p-shift-end-fact-order skip
      200         "p-day-end-fact-order"   p-day-end-fact-order   skip
      201         "v-fact-date-num"        v-fact-date-num        skip
      202         view-as alert-box error .
      203       undo, return error return-value .
      204     end.
      205   end procedure.
      206   procedure day-begin-fact-order :
      207     define input  parameter p-fact-date            as date    no-undo .
      208     define output parameter p-day-begin-fact-order as decimal no-undo .
      209     do
      210     on error undo, return error return-value
      211     :
      212       if p-fact-date = ?
      213       then do:
      214         assign
      215           p-day-begin-fact-order = 0
      216         .
      217       end.
      218       else do:
      219         assign
      220           p-day-begin-fact-order = integer(p-fact-date)
      221         .
      222       end.
      223     end.
      224   end procedure.
      225   procedure factord-max-fact-order :
      226     define output parameter p-max-fact-order as decimal   no-undo .
      227     do
      228     on error undo, return error return-value
      229     :
      230       run day-begin-fact-order in this-procedure
      231         (input  date(1, 1, 5000)
      232         ,output p-max-fact-order
      233         ) .
      234     end.
      235   end procedure.
      236   procedure factord-cut-archive :
      237     define input  parameter p-obj-type             as character no-undo .
      238     define input  parameter p-obj-code             as integer   no-undo .
      239     define input  parameter p-fact-date            as date      no-undo .
      240     define output parameter p-shift-on             as logical   no-undo .
      241     define output parameter p-shift-date           as date      no-undo .
      242     define output parameter p-shift-num            as integer   no-undo .
      243     define output parameter p-day-end-fact-order   as decimal   no-undo .
      244     define output parameter p-shift-end-fact-order as decimal   no-undo .
      245     define variable v-fact-order as decimal   no-undo .
      246     define buffer buf_shift-obj for ub.shift-obj .
      247     do
      248     on error undo, return error return-value
      249     :
      250   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      251   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      252     (input  p-obj-type
      253     ,input  p-obj-code
      254     ,input  'shift-on=request'
      255     ,output p-shift-on
      256     ) no-error .
      257       if error-status :error
      258       then do:
      259         message
      260           vss-workfile vss-revision vss-description skip
      261           "Ошибка при определении атрибута объекта" skip
      262           "Объект" p-obj-type p-obj-code skip
      263           error-status :get-message(1) skip
      264           return-value skip
      265           view-as alert-box error .
      266         undo, return error return-value .
      267       end.
      268       if p-shift-on = false
      269       then do:
      270         assign
      271           p-shift-date               = ?
      272           p-shift-num                = 0
      273         .
      274       end.
      275       else do:
      276         find first buf_shift-obj share-lock
      277           where buf_shift-obj.obj-type   = p-obj-type
      278             and buf_shift-obj.obj-code   = p-obj-code
      279             and buf_shift-obj.shift-date > p-fact-date
      280           use-index pi
      281           no-error .
      282         if not available buf_shift-obj
      283         or buf_shift-obj.status_ <> 'зкр':U
      284         then do:
      285           message
      286             vss-workfile vss-revision vss-description skip
      287             "Невозможно вычислить последнюю смену" skip
      288             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      289             "Объект" p-obj-type p-obj-code skip
      290             "Дата" p-fact-date skip
      291             view-as alert-box error .
      292           undo, return error return-value .
      293         end.
      294         find last buf_shift-obj share-lock
      295           where buf_shift-obj.obj-type = p-obj-type
      296             and buf_shift-obj.obj-code = p-obj-code
      297             and buf_shift-obj.shift-date <= p-fact-date
      298           use-index pi
      299           no-error .
      300         if available buf_shift-obj
      301         then do:
      302           if  buf_shift-obj.status_ = 'зкр':U
      303           then do:
      304             assign
      305               p-shift-date = buf_shift-obj.shift-date
      306               p-shift-num  = buf_shift-obj.shift-num
      307             .
      308           end.
      309           else do:
      310             message
      311               vss-workfile vss-revision vss-description skip
      312               "Невозможно вычислить последнюю смену" skip
      313               "Статус смены отличен от статуса" 'зкр':U skip
      314               "Объект" p-obj-type p-obj-code skip
      315               "Дата" p-fact-date skip
      316               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      317               view-as alert-box error .
      318             undo, return error return-value .
      319           end.
      320         end.
      321         else do:
      322           assign
      323             p-shift-date = p-fact-date - 1
      324             p-shift-num  = 1
      325           .
      326         end.
      327       end.
      328       run factord in this-procedure
      329         (input  p-fact-date
      330         ,input  1
      331         ,input  1
      332         ,input  p-shift-date
      333         ,input  p-shift-num
      334         ,input  p-shift-on
      335         ,output v-fact-order
      336         ,output p-shift-end-fact-order
      337         ,output p-day-end-fact-order
      338         ) no-error .
      339       if error-status :error
      340       then do:
      341         message
      342           vss-workfile vss-revision vss-description skip
      343           "Ошибка при вызове процедуры factord"
      344           error-status :get-message(1) skip
      345           return-value skip
      346           view-as alert-box error .
      347         undo, return error return-value .
      348       end.
      349     end.
      350   end procedure.
      351   procedure factord-lock-shift :
      352     define input  parameter p-obj-type  as character no-undo .
      353     define input  parameter p-obj-code  as integer   no-undo .
      354     define input  parameter p-fact-date as date      no-undo .
      355     define parameter buffer buf_shift-obj for ub.shift-obj .
      356     define variable v-shift-on      as logical   no-undo .
      357     define variable v-extra-message as character no-undo .
      358     define variable v-error as character no-undo .
      359     do
      360     on error undo, return error return-value
      361     :
      362   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      364     (input  p-obj-type
      365     ,input  p-obj-code
      366     ,input  'shift-on=request'
      367     ,output v-shift-on
      368     ) no-error .
      369       if error-status :error
      370       then do:
      371         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      372         undo, return error v-error .
      373       end.
      374       if v-shift-on = true
      375       then do:
      376         find first buf_shift-obj share-lock
      377           where buf_shift-obj.obj-type   = p-obj-type
      378             and buf_shift-obj.obj-code   = p-obj-code
      379             and buf_shift-obj.shift-date > p-fact-date
      380           use-index pi
      381           no-error .
      382         if not available buf_shift-obj
      383         or buf_shift-obj.status_ <> 'зкр':U
      384         then do:
      385           find last buf_shift-obj
      386             where buf_shift-obj.obj-type = p-obj-type
      387               and buf_shift-obj.obj-code = p-obj-code
      388               and buf_shift-obj.status_  = 'зкр':U
      389             use-index stts
      390             no-error .
      391           if available buf_shift-obj
      392           then do:
      393             assign
      394               v-extra-message =
      395                     substitute("Дата начала последеней закрытой смены на объекте &1"
      396                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      397                               )
      398             .
      399           end.
      400           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      401           undo, return error v-error .
      402         end.
      403       end.
      404     end.
      405   end procedure.
      406   procedure factord-end-day :
      407     define input  parameter p-fact-date            as date    no-undo .
      408     define output parameter p-day-end-fact-order   as decimal no-undo .
      409     do
      410     on error undo, return error return-value
      411     :
      412       if p-fact-date = ?
      413       then do:
      414         return error "Не указана фактическая дата" .
      415       end.
      416       assign
      417         p-day-end-fact-order = integer(p-fact-date) + 0.99
      418       .
      419     end.
      420   end procedure.
      421   procedure factord-to-date :
      422     define input  parameter p-fact-order as decimal no-undo .
      423     define output parameter p-fact-date  as date    no-undo .
      424     define variable v-ref-date  as date      no-undo .
      425     define variable v-ref-delta as integer   no-undo .
      426     do
      427     on error undo, return error return-value
      428     :
      429       if p-fact-order = ?
      430       or p-fact-order = 0
      431       then do:
      432         return error "Не указан fact-order" .
      433       end.
      434       assign
      435         v-ref-date  = date(1, 1, 2000)
      436       .
      437       assign
      438         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      439       .
      440       assign
      441         p-fact-date = v-ref-date + v-ref-delta
      442       .
      443     end.
      444   end procedure.
      445   procedure factord-to-fact-num :
      446     define input  parameter p-fact-order as decimal no-undo .
      447     define output parameter p-fact-num   as integer no-undo .
      448     define variable v-fact-order-trunc as decimal no-undo .
      449     do
      450     on error undo, return error return-value
      451     :
      452       if p-fact-order = ?
      453       or p-fact-order = 0
      454       then do:
      455         return error "Не указан fact-order" .
      456       end.
      457       assign
      458        v-fact-order-trunc = truncate(p-fact-order, 2)
      459       .
      460       assign
      461         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      462       .
      463     end.
      464   end procedure.
      465   procedure factord-to-shift-num :
      466     define input  parameter p-fact-order as decimal no-undo .
      467     define output parameter p-shift-num   as integer no-undo .
      468     define variable  p-shift-numd  as decimal   no-undo .
      469     define variable v-fact-order-trunc as decimal no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473       if p-fact-order = ?
      474       or p-fact-order = 0
      475       then do:
      476         return error "Не указан fact-order" .
      477       end.
      478       assign
      479        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      480       .
      481       if v-fact-order-trunc < 0.5 then do:
      482         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      483       end.
      484       assign
      485         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      486         .
      487        assign
      488         p-shift-num = truncate (p-shift-numd , 0)
      489       .
      490     end.
      491   end procedure.
      492   define  shared temp-table tt-objs no-undo
      493     field obj-type as character
      494     field obj-code as integer
      495     index pi is unique primary obj-type obj-code
      496     .
      497   on WRITE of dst.c-trn-doc         override do: end.
      498   on WRITE of dst.c-doc-line        override do: end.
      499   on WRITE of dst.c-gds-dtl         override do: end.
      500   on WRITE of dst.c-gds-dtl-attr         override do: end.
      501   on WRITE of dst.c-doc-line-attr   override do: end.
      502   on WRITE of dst.c-doc-pl          override do: end.
      503   on WRITE of dst.c-doc-pl-pump     override do: end.
      504   on write of dst.c-inkas           override do: end.
      505   on write of dst.c-sale-doc        override do: end.
      506   on write of dst.c-inkas-pay       override do: end.
      507   on write of dst.c-inkas-pay-desk  override do: end.
      508   on write of dst.c-inkas-pay-wth   override do: end.
      509   on write of dst.c-doc-prts        override do: end.
      510   on write of dst.c-parts           override do: end.
      511   on write of dst.c-parts-root      override do: end.
      512   if not varstay-history  then return .
      513   define variable my-fact-order as decimal   no-undo .
      514   run day-begin-fact-order (input vardate-actual-docs , output my-fact-order) .
      515   if vardate-actual-docs <> ? then do:
      516      for each new-shop no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      517         if vartype-cut = 1 then do:
      518           find first tt-objs where tt-objs.obj-type = 'маг':U           and
      519                                    tt-objs.obj-code = new-shop.obj-code no-error.
      520         end.
      521         if vartype-cut = 0      or
      522            (vartype-cut = 1 and available tt-objs) then do:
      523           for each old-c-trn-doc where old-c-trn-doc.obj-type   = 'маг':U           and
      524                    old-c-trn-doc.obj-code                       = new-shop.obj-code and
      525                    old-c-trn-doc.status_                        = 'факт':U           and
      526                    old-c-trn-doc.fact-order                    >= my-fact-order
      527                    no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      528              run proc-bod .
      529           end.
      530         end.
      531         else do:
      532           for each old-c-trn-doc where old-c-trn-doc.obj-type   = 'маг':U           and
      533                    old-c-trn-doc.obj-code                       = new-shop.obj-code and
      534                    old-c-trn-doc.status_                        = 'факт':U           no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      535              run proc-bod .
      536           end.
      537         end.
      538      end.
      539      for each new-store no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      540         if vartype-cut = 1 then do:
      541           find first tt-objs where tt-objs.obj-type = 'скл':U           and
      542                                    tt-objs.obj-code = new-store.obj-code no-error.
      543         end.
      544         if vartype-cut = 0      or
      545            (vartype-cut = 1 and available tt-objs) then do:
      546           for each old-c-trn-doc where old-c-trn-doc.obj-type   = 'скл':U   and
      547                    old-c-trn-doc.obj-code   = new-store.obj-code            and
      548                    old-c-trn-doc.status_    = 'факт':U                       and
      549                    old-c-trn-doc.fact-order >= my-fact-order                no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      550              run proc-bod .
      551           end.
      552         end.
      553         else do:
      554           for each old-c-trn-doc where old-c-trn-doc.obj-type   = 'скл':U  and
      555                    old-c-trn-doc.obj-code   = new-store.obj-code            and
      556                    old-c-trn-doc.status_    = 'факт':U                       no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      557              run proc-bod .
      558           end.
      559         end.
      560      end.
      561   end.
      562   output stream str-gen close.
      563   return "Произведен экспорт таблиц:  c-trn-doc c-doc-line c-gds-dtl c-doc-line-attr c-doc-pl c-doc-pl-pump c-inkas c-sale-doc " +
      564   "c-inkas-pay c-inkas-pay-desk c-inkas-pay-wth c-doc-prts  c-parts  c-parts-root".
      565   end.
      566   procedure proc-bod :
      567     do
      568     on error undo, return error return-value
      569     :
      570     for each old-c-doc-line where
      571              old-c-doc-line.doc-code = old-c-trn-doc.doc-code
      572              no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      573              :
      574             create new-c-doc-line.
      575             buffer-copy old-c-doc-line to new-c-doc-line.
      576     end.
      577     for each old-c-doc-line-attr where
      578              old-c-doc-line-attr.doc-code = old-c-trn-doc.doc-code
      579              no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      580              :
      581             create new-c-doc-line-attr.
      582             buffer-copy old-c-doc-line-attr to new-c-doc-line-attr.
      583     end.
      584     for each old-c-gds-dtl where
      585              old-c-gds-dtl.doc-code = old-c-trn-doc.doc-code
      586              no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      587              :
      588             create new-c-gds-dtl.
      589             buffer-copy old-c-gds-dtl to new-c-gds-dtl.
      590     end.
      591     for each old-c-gds-dtl-attr where
      592              old-c-gds-dtl-attr.doc-code = old-c-trn-doc.doc-code
      593              no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      594              :
      595             create new-c-gds-dtl-attr.
      596             buffer-copy old-c-gds-dtl-attr to new-c-gds-dtl-attr.
      597     end.
      598     for each new-place
      599          no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      600          :
      601          for each old-c-doc-pl where
      602              old-c-doc-pl.obj-code = new-place.obj-code and
      603              old-c-doc-pl.obj-type = new-place.obj-type and
      604              old-c-doc-pl.pl-code  = new-place.pl-code  and
      605              old-c-doc-pl.out-code = old-c-trn-doc.doc-code
      606              no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      607              :
      608                 create new-c-doc-pl .
      609                 buffer-copy old-c-doc-pl to new-c-doc-pl .
      610          end.
      611          for each new-pump where
      612                   new-pump.obj-code = new-place.obj-code and
      613                   new-pump.obj-type = new-place.obj-type
      614                   no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      615                   :
      616             for each old-c-doc-pl-pump where
      617                 old-c-doc-pl-pump.obj-code   = new-place.obj-code and
      618                 old-c-doc-pl-pump.obj-type   = new-place.obj-type and
      619                 old-c-doc-pl-pump.pl-code    = new-place.pl-code  and
      620                 old-c-doc-pl-pump.pump-code  = new-pump.pump-code  and
      621                 old-c-doc-pl-pump.out-code   = old-c-trn-doc.doc-code
      622                 no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      623                 :
      624                     create new-c-doc-pl-pump .
      625                     buffer-copy old-c-doc-pl-pump to new-c-doc-pl-pump .
      626             end.
      627          end.
      628     end.
      629       for each old-c-doc-prts where
      630           old-c-doc-prts.out-code = old-c-trn-doc.doc-code
      631           no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      632           :
      633             create new-c-doc-prts .
      634             buffer-copy old-c-doc-prts to new-c-doc-prts .
      635       end.
      636       for each old-c-parts where
      637           old-c-parts.out-code = old-c-trn-doc.doc-code
      638           no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      639           :
      640             create new-c-parts .
      641             buffer-copy old-c-parts to new-c-parts .
      642       end.
      643         for each old-c-parts-root no-lock  where
      644             old-c-parts-root.doc-code = old-c-trn-doc.doc-code
      645             on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      646             :
      647             create new-c-parts-root.
      648             BUFFER-COPY old-c-parts-root to new-c-parts-root.
      649         end.
      650         if old-c-trn-doc.ext-doc-type = 'es':U then do:
      651               for each old-c-inkas
      652                 where old-c-inkas.inkas-code = old-c-trn-doc.doc-code no-lock
      653               on error undo, return error
      654               :
      655                   create new-c-inkas.
      656                   buffer-copy old-c-inkas to new-c-inkas.
      657               end.
      658               for each old-c-sale-doc
      659                 where old-c-sale-doc.inkas-code = old-c-trn-doc.doc-code no-lock
      660               on error undo, return error
      661               :
      662                   create new-c-sale-doc.
      663                   buffer-copy old-c-sale-doc to new-c-sale-doc.
      664               end.
      665               for each old-c-inkas-pay
      666                 where old-c-inkas-pay.inkas-code = old-c-trn-doc.doc-code no-lock
      667               on error undo, return error
      668               :
      669                   create new-c-inkas-pay.
      670                   buffer-copy old-c-inkas-pay to new-c-inkas-pay.
      671               end.
      672               for each old-c-inkas-pay-wth
      673                 where old-c-inkas-pay-wth.inkas-code = old-c-trn-doc.doc-code no-lock
      674               on error undo, return error
      675               :
      676                   create new-c-inkas-pay-wth.
      677                   buffer-copy old-c-inkas-pay-wth to new-c-inkas-pay.
      678               end.
      679               for each old-c-inkas-pay-desk
      680                 where old-c-inkas-pay-desk.inkas-code = old-c-trn-doc.doc-code no-lock
      681               on error undo, return error
      682               :
      683                   create new-c-inkas-pay-desk.
      684                   buffer-copy old-c-inkas-pay-desk to new-c-inkas-pay-desk.
      685               end.
      686         end.
      687     create new-c-trn-doc.
      688     buffer-copy old-c-trn-doc to new-c-trn-doc.
      689     end.
      690   end procedure.
