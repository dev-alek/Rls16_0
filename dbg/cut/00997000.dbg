        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00997000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00997000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 10.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-rcs-destn  for src.rcs-destn.
       13   define buffer new-rcs-destn  for dst.rcs-destn.
       14   define buffer old-rcs-shops  for src.rcs-shops.
       15   define buffer new-rcs-shops  for dst.rcs-shops.
       16   do
       17   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       18   define input parameter vartype-cut            as integer   no-undo.
       19   define input parameter varlist-db             as character no-undo.
       20   define input parameter vardate-actual-goods   as date      no-undo.
       21   define input parameter vardate-actual-docs    as date      no-undo.
       22   define input parameter vardate-actual-findoc  as date      no-undo.
       23   define input parameter vardate-output-zone    as date      no-undo.
       24   define input parameter varstay-recipe-goods   as logical   no-undo.
       25   define input parameter varstay-weight-goods   as logical   no-undo.
       26   define input parameter varnot-copy-del-goods  as logical   no-undo.
       27   define input parameter varstay-history        as logical   no-undo.
       28   define input parameter vargen-file            as character no-undo.
       29   define stream str-gen.
       30   output stream str-gen to vargen-file append.
       31   if not connected("src") then do:
       32      return error "Нет коннекта с базой 'src'.".
       33   end.
       34   if not connected("dst") then do:
       35      return error "Нет коннекта с базой 'dst'.".
       36   end.
       37   find src.sys-ctrl no-lock.
       38   if not available src.sys-ctrl then do:
       39      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       40   end.
       41   if src.sys-ctrl.db-num <> 0 then do:
       42      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       43   end.
       44   if vardate-actual-docs <> ? and
       45      (vardate-actual-goods   > vardate-actual-docs or
       46       vardate-actual-goods   = ? )   then do:
       47         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       48                                 "Дата актуальности товаров &1."        +
       49                                 "Дата актуальности документов &2."     +
       50                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       51                                 vardate-actual-goods,
       52                                 vardate-actual-docs).
       53   end.
       54   on WRITE of dst.rcs-destn override do: end.
       55   on WRITE of dst.rcs-shops override do: end.
       56   for each old-rcs-destn no-lock
       57   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       58   :
       59       create new-rcs-destn.
       60       buffer-copy old-rcs-destn to new-rcs-destn.
       61   end.
       62   for each old-rcs-shops no-lock
       63   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       64   :
       65       create new-rcs-shops.
       66       buffer-copy old-rcs-shops to new-rcs-shops.
       67   end.
       68   output stream str-gen close.
       69   return "Произведен экспорт таблиц: rcs-destn rcs-shops.".
       70   end.
