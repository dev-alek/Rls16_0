        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00195000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00195000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 195.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-doc-attr          for src.doc-attr.
       13   define buffer new-doc-attr          for dst.doc-attr.
       14   define buffer new-trn-doc            for dst.trn-doc  .
       15   define buffer new-rvs-doc            for dst.rvs-doc  .
       16   define buffer new-price-doc          for dst.price-doc.
       17   define buffer new-fbr-doc            for dst.fbr-doc  .
       18   define buffer new-wth-doc            for dst.wth-doc  .
       19   define buffer new-icnt-doc           for dst.icnt-doc .
       20   do
       21   on error undo, return error
       22   :
       23   define input parameter vartype-cut            as integer   no-undo.
       24   define input parameter varlist-db             as character no-undo.
       25   define input parameter vardate-actual-goods   as date      no-undo.
       26   define input parameter vardate-actual-docs    as date      no-undo.
       27   define input parameter vardate-actual-findoc  as date      no-undo.
       28   define input parameter vardate-output-zone    as date      no-undo.
       29   define input parameter varstay-recipe-goods   as logical   no-undo.
       30   define input parameter varstay-weight-goods   as logical   no-undo.
       31   define input parameter varnot-copy-del-goods  as logical   no-undo.
       32   define input parameter varstay-history        as logical   no-undo.
       33   define input parameter vargen-file            as character no-undo.
       34   define stream str-gen.
       35   output stream str-gen to vargen-file append.
       36   if not connected("src") then do:
       37      return error "Нет коннекта с базой 'src'.".
       38   end.
       39   if not connected("dst") then do:
       40      return error "Нет коннекта с базой 'dst'.".
       41   end.
       42   find src.sys-ctrl no-lock.
       43   if not available src.sys-ctrl then do:
       44      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       45   end.
       46   if src.sys-ctrl.db-num <> 0 then do:
       47      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       48   end.
       49   if vardate-actual-docs <> ? and
       50      (vardate-actual-goods   > vardate-actual-docs or
       51       vardate-actual-goods   = ? )   then do:
       52         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       53                                 "Дата актуальности товаров &1."        +
       54                                 "Дата актуальности документов &2."     +
       55                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       56                                 vardate-actual-goods,
       57                                 vardate-actual-docs).
       58   end.
       59     on WRITE of dst.doc-attr      override do: end.
       60     for each new-trn-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       61         run proc-1(new-trn-doc.doc-code) .
       62     end.
       63     for each new-rvs-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       64         run proc-1(new-rvs-doc.rvs-code) .
       65     end.
       66     for each new-price-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       67         run proc-1(new-price-doc.doc-num) .
       68     end.
       69     for each new-fbr-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       70         run proc-1(new-fbr-doc.doc-code) .
       71     end.
       72     for each new-wth-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       73         run proc-1(new-wth-doc.doc-code) .
       74     end.
       75     for each new-icnt-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       76         run proc-1(new-icnt-doc.doc-code) .
       77     end.
       78   output stream str-gen close.
       79     return "Произведен экспорт таблиц: doc-attr.".
       80   end.
       81   procedure proc-1 :
       82     do
       83     on error undo, return error return-value
       84     :
       85     define input  parameter p-doc as character no-undo .
       86     for each old-doc-attr where old-doc-attr.doc-code = p-doc
       87         no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       88         :
       89         find first new-doc-attr where new-doc-attr.doc-code  = old-doc-attr.doc-code  and
       90                                       new-doc-attr.attr-code = old-doc-attr.attr-code no-error.
       91         if not available new-doc-attr then do:
       92           create new-doc-attr.
       93           buffer-copy old-doc-attr to new-doc-attr.
       94         end.
       95     end.
       96     end.
       97   end procedure.
