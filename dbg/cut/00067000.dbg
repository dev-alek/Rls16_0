        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00067000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00067000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 67.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-country for src.country.
       13   define buffer new-country for dst.country.
       14   define buffer old-c-country for src.c-country.
       15   define buffer new-c-country for dst.c-country.
       16   define buffer old-country-attr for src.country-attr.
       17   define buffer new-country-attr for dst.country-attr.
       18   define buffer old-c-country-attr for src.c-country-attr.
       19   define buffer new-c-country-attr for dst.c-country-attr.
       20   define buffer old-c-regions      for src.c-regions   .
       21   define buffer old-regions        for src.regions     .
       22   define buffer old-regions-attr   for src.regions-attr.
       23   define buffer new-c-regions      for dst.c-regions   .
       24   define buffer new-regions        for dst.regions     .
       25   define buffer new-regions-attr   for dst.regions-attr.
       26   do
       27   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       28   define input parameter vartype-cut            as integer   no-undo.
       29   define input parameter varlist-db             as character no-undo.
       30   define input parameter vardate-actual-goods   as date      no-undo.
       31   define input parameter vardate-actual-docs    as date      no-undo.
       32   define input parameter vardate-actual-findoc  as date      no-undo.
       33   define input parameter vardate-output-zone    as date      no-undo.
       34   define input parameter varstay-recipe-goods   as logical   no-undo.
       35   define input parameter varstay-weight-goods   as logical   no-undo.
       36   define input parameter varnot-copy-del-goods  as logical   no-undo.
       37   define input parameter varstay-history        as logical   no-undo.
       38   define input parameter vargen-file            as character no-undo.
       39   define stream str-gen.
       40   output stream str-gen to vargen-file append.
       41   if not connected("src") then do:
       42      return error "Нет коннекта с базой 'src'.".
       43   end.
       44   if not connected("dst") then do:
       45      return error "Нет коннекта с базой 'dst'.".
       46   end.
       47   find src.sys-ctrl no-lock.
       48   if not available src.sys-ctrl then do:
       49      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       50   end.
       51   if src.sys-ctrl.db-num <> 0 then do:
       52      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       53   end.
       54   if vardate-actual-docs <> ? and
       55      (vardate-actual-goods   > vardate-actual-docs or
       56       vardate-actual-goods   = ? )   then do:
       57         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       58                                 "Дата актуальности товаров &1."        +
       59                                 "Дата актуальности документов &2."     +
       60                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       61                                 vardate-actual-goods,
       62                                 vardate-actual-docs).
       63   end.
       64   on WRITE of dst.country override do: end.
       65   on WRITE of dst.c-country override do: end.
       66   on WRITE of dst.country-attr override do: end.
       67   on WRITE of dst.c-country-attr override do: end.
       68   on WRITE of dst.c-regions      override do: end.
       69   on WRITE of dst.regions        override do: end.
       70   on WRITE of dst.regions-attr   override do: end.
       71   for each old-country  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       72      create new-country.
       73      buffer-copy old-country to new-country.
       74   end.
       75   if varstay-history then do:
       76   for each old-c-country  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       77      create new-c-country.
       78      buffer-copy old-c-country to new-c-country.
       79   end.
       80   end.
       81   for each old-country-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       82      create new-country-attr.
       83      buffer-copy old-country-attr to new-country-attr.
       84   end.
       85   if varstay-history then do:
       86   for each old-c-country-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       87      create new-c-country-attr.
       88      buffer-copy old-c-country-attr to new-c-country-attr.
       89   end.
       90   end.
       91   for each old-regions  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       92      create new-regions.
       93      buffer-copy old-regions to new-regions.
       94   end.
       95   for each old-regions-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       96      create new-regions-attr.
       97      buffer-copy old-regions-attr to new-regions-attr.
       98   end.
       99   if varstay-history then do:
      100   for each old-c-regions  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      101      create new-c-regions.
      102      buffer-copy old-c-regions to new-c-regions.
      103   end.
      104   end.
      105   output stream str-gen close.
      106   return "Произведен экспорт таблиц: country c-country country-attr c-country-attr " +
      107   "~
      108   c-regions ~
      109   regions ~
      110   regions-attr ~
      111   .".
      112   end.
