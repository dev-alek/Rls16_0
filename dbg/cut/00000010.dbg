        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define buffer old-user for src._user.
        7   define buffer new-user for dst._user.
        8   do
        9   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       10   define input parameter vartype-cut            as integer   no-undo.
       11   define input parameter varlist-db             as character no-undo.
       12   define input parameter vardate-actual-goods   as date      no-undo.
       13   define input parameter vardate-actual-docs    as date      no-undo.
       14   define input parameter vardate-actual-findoc  as date      no-undo.
       15   define input parameter vardate-output-zone    as date      no-undo.
       16   define input parameter varstay-recipe-goods   as logical   no-undo.
       17   define input parameter varstay-weight-goods   as logical   no-undo.
       18   define input parameter varnot-copy-del-goods  as logical   no-undo.
       19   define input parameter varstay-history        as logical   no-undo.
       20   define input parameter vargen-file            as character no-undo.
       21   define stream str-gen.
       22   output stream str-gen to vargen-file append.
       23   if not connected("src") then do:
       24      return error "Нет коннекта с базой 'src'.".
       25   end.
       26   if not connected("dst") then do:
       27      return error "Нет коннекта с базой 'dst'.".
       28   end.
       29   find src.sys-ctrl no-lock.
       30   if not available src.sys-ctrl then do:
       31      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       32   end.
       33   if src.sys-ctrl.db-num <> 0 then do:
       34      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       35   end.
       36   if vardate-actual-docs <> ? and
       37      (vardate-actual-goods   > vardate-actual-docs or
       38       vardate-actual-goods   = ? )   then do:
       39         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       40                                 "Дата актуальности товаров &1."        +
       41                                 "Дата актуальности документов &2."     +
       42                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       43                                 vardate-actual-goods,
       44                                 vardate-actual-docs).
       45   end.
       46   for each old-user no-lock
       47   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       48   :
       49     find first new-user no-lock
       50       where new-user._userid = old-user._userid
       51       no-error .
       52     if not available new-user then do:
       53       create new-user.
       54       buffer-copy old-user to new-user.
       55     end.
       56   end.
       57   output stream str-gen close.
       58   return "Произведен экспорт таблиц: _user.".
       59   end.
