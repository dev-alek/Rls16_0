        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00151000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00151000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 151.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-sum-grp          for src.sum-grp   .
       13   define buffer new-sum-grp          for dst.sum-grp   .
       14   define buffer old-c-sum-grp        for src.c-sum-grp   .
       15   define buffer new-c-sum-grp        for dst.c-sum-grp   .
       16   define buffer old-sum-grp-attr     for src.sum-grp-attr   .
       17   define buffer new-sum-grp-attr     for dst.sum-grp-attr   .
       18   define buffer old-sum-grp-obj      for src.sum-grp-obj .
       19   define buffer new-sum-grp-obj      for dst.sum-grp-obj .
       20   define buffer old-c-sum-grp-obj    for src.c-sum-grp-obj .
       21   define buffer new-c-sum-grp-obj    for dst.c-sum-grp-obj .
       22   define buffer old-sum-grp-obj-attr for src.sum-grp-obj-attr .
       23   define buffer new-sum-grp-obj-attr for dst.sum-grp-obj-attr .
       24   define buffer old-scales           for src.scales    .
       25   define buffer new-scales           for dst.scales    .
       26   define buffer old-c-scales         for src.c-scales    .
       27   define buffer new-c-scales         for dst.c-scales    .
       28   define buffer old-scales-attr      for src.scales-attr    .
       29   define buffer new-scales-attr      for dst.scales-attr    .
       30   define buffer old-c-scales-attr    for src.c-scales-attr    .
       31   define buffer new-c-scales-attr    for dst.c-scales-attr    .
       32   define buffer old-scales-gds       for src.scales-gds.
       33   define buffer new-scales-gds       for dst.scales-gds.
       34   define buffer old-c-scales-gds     for src.c-scales-gds.
       35   define buffer new-c-scales-gds     for dst.c-scales-gds.
       36   define buffer old-scales-gds-attr  for src.scales-gds-attr.
       37   define buffer new-scales-gds-attr  for dst.scales-gds-attr.
       38   define buffer old-scales-grp       for src.scales-grp.
       39   define buffer new-scales-grp       for dst.scales-grp.
       40   define buffer old-c-scales-grp     for src.c-scales-grp.
       41   define buffer new-c-scales-grp     for dst.c-scales-grp.
       42   define buffer old-scales-grp-attr  for src.scales-grp-attr.
       43   define buffer new-scales-grp-attr  for dst.scales-grp-attr.
       44   define buffer new-goods      for dst.goods     .
       45   define buffer new-bar-code   for dst.bar-code  .
       46   do
       47   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       48   define input parameter vartype-cut            as integer   no-undo.
       49   define input parameter varlist-db             as character no-undo.
       50   define input parameter vardate-actual-goods   as date      no-undo.
       51   define input parameter vardate-actual-docs    as date      no-undo.
       52   define input parameter vardate-actual-findoc  as date      no-undo.
       53   define input parameter vardate-output-zone    as date      no-undo.
       54   define input parameter varstay-recipe-goods   as logical   no-undo.
       55   define input parameter varstay-weight-goods   as logical   no-undo.
       56   define input parameter varnot-copy-del-goods  as logical   no-undo.
       57   define input parameter varstay-history        as logical   no-undo.
       58   define input parameter vargen-file            as character no-undo.
       59   define stream str-gen.
       60   output stream str-gen to vargen-file append.
       61   if not connected("src") then do:
       62      return error "Нет коннекта с базой 'src'.".
       63   end.
       64   if not connected("dst") then do:
       65      return error "Нет коннекта с базой 'dst'.".
       66   end.
       67   find src.sys-ctrl no-lock.
       68   if not available src.sys-ctrl then do:
       69      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       70   end.
       71   if src.sys-ctrl.db-num <> 0 then do:
       72      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       73   end.
       74   if vardate-actual-docs <> ? and
       75      (vardate-actual-goods   > vardate-actual-docs or
       76       vardate-actual-goods   = ? )   then do:
       77         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       78                                 "Дата актуальности товаров &1."        +
       79                                 "Дата актуальности документов &2."     +
       80                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       81                                 vardate-actual-goods,
       82                                 vardate-actual-docs).
       83   end.
       84   on WRITE of dst.sum-grp         override do: end.
       85   on WRITE of dst.c-sum-grp       override do: end.
       86   on WRITE of dst.sum-grp-attr    override do: end.
       87   on WRITE of dst.sum-grp-obj     override do: end.
       88   on WRITE of dst.c-sum-grp-obj   override do: end.
       89   on WRITE of dst.sum-grp-obj-attr override do: end.
       90   on WRITE of dst.scales          override do: end.
       91   on WRITE of dst.c-scales        override do: end.
       92   on WRITE of dst.scales-attr     override do: end.
       93   on WRITE of dst.c-scales-attr   override do: end.
       94   on WRITE of dst.scales-gds      override do: end.
       95   on WRITE of dst.c-scales-gds    override do: end.
       96   on WRITE of dst.scales-gds-attr override do: end.
       97   on WRITE of dst.scales-grp      override do: end.
       98   on WRITE of dst.c-scales-grp    override do: end.
       99   for each old-sum-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      100      create new-sum-grp.
      101      buffer-copy old-sum-grp to new-sum-grp.
      102   end.
      103   if varstay-history then do:
      104   for each old-c-sum-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      105      create new-c-sum-grp.
      106      buffer-copy old-c-sum-grp to new-c-sum-grp.
      107   end.
      108   end.
      109   for each old-sum-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      110      create new-sum-grp-attr.
      111      buffer-copy old-sum-grp-attr to new-sum-grp-attr.
      112   end.
      113   for each old-sum-grp-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      114      create new-sum-grp-obj.
      115      buffer-copy old-sum-grp-obj to new-sum-grp-obj.
      116   end.
      117   if varstay-history then do:
      118   for each old-c-sum-grp-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      119      create new-c-sum-grp-obj.
      120      buffer-copy old-c-sum-grp-obj to new-c-sum-grp-obj.
      121   end.
      122   end.
      123   for each old-sum-grp-obj-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      124      create new-sum-grp-obj-attr.
      125      buffer-copy old-sum-grp-obj-attr to new-sum-grp-obj-attr.
      126   end.
      127   for each old-scales  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      128      create new-scales.
      129      buffer-copy old-scales to new-scales.
      130   end.
      131   if varstay-history then do:
      132   for each old-c-scales  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      133      create new-c-scales.
      134      buffer-copy old-c-scales to new-c-scales.
      135   end.
      136   end.
      137   for each old-scales-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      138      create new-scales-attr.
      139      buffer-copy old-scales-attr to new-scales-attr.
      140   end.
      141   if varstay-history then do:
      142   for each old-c-scales-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      143      create new-c-scales-attr.
      144      buffer-copy old-c-scales-attr to new-c-scales-attr.
      145   end.
      146   end.
      147   for each old-scales-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      148      create new-scales-grp.
      149      buffer-copy old-scales-grp to new-scales-grp.
      150   end.
      151   if varstay-history then do:
      152   for each old-c-scales-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      153      create new-c-scales-grp.
      154      buffer-copy old-c-scales-grp to new-c-scales-grp.
      155   end.
      156   end.
      157   for each old-scales-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      158      create new-scales-grp-attr.
      159      buffer-copy old-scales-grp-attr to new-scales-grp-attr.
      160   end.
      161   for each old-scales-gds no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      162     find first new-bar-code where new-bar-code.b-code = old-scales-gds.b-code no-lock  no-error.
      163     if available new-bar-code then do:
      164       create new-scales-gds.
      165       buffer-copy old-scales-gds to new-scales-gds.
      166       if varstay-history then do:
      167         for each old-c-scales-gds no-lock where
      168                 old-c-scales-gds.db-num = old-scales-gds.db-num
      169             and old-c-scales-gds.scales-num = old-scales-gds.scales-num
      170             and old-c-scales-gds.plu-code = old-scales-gds.plu-code
      171                 on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      172           create new-c-scales-gds.
      173           buffer-copy old-c-scales-gds to new-c-scales-gds.
      174         end.
      175       end.
      176       for each old-scales-gds-attr no-lock where
      177                old-scales-gds-attr.db-num = old-scales-gds.db-num
      178            and old-scales-gds-attr.scales-num = old-scales-gds.scales-num
      179            and old-scales-gds-attr.plu-code = old-scales-gds.plu-code
      180                on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      181         create new-scales-gds-attr.
      182         buffer-copy old-scales-gds-attr to new-scales-gds-attr.
      183       end.
      184     end.
      185   end.
      186   output stream str-gen close.
      187   return "Произведен экспорт таблиц: ~
      188   sum-grp c-sum-grp sum-grp-attr sum-grp-obj c-sum-grp-obj sum-grp-obj-attr ~
      189   scales c-scales scales-attr c-scales-attr scales-gds c-scales-gds scales-gds-attr scales-grp c-scales-grp scales-grp-attr .".
      190   end.
