        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00127000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00127000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 127.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-ord-blank for src.ord-blank.
       13   define buffer new-ord-blank for dst.ord-blank.
       14   define buffer old-ord-doc   for src.ord-doc  .
       15   define buffer new-ord-doc   for dst.ord-doc  .
       16   define buffer old-edi-status   for src.edi-status  .
       17   define buffer new-edi-status   for dst.edi-status  .
       18   define buffer old-c-ord-doc   for src.c-ord-doc  .
       19   define buffer new-c-ord-doc   for dst.c-ord-doc  .
       20   define buffer old-c-ord-doc-attr   for src.c-ord-doc-attr  .
       21   define buffer new-c-ord-doc-attr   for dst.c-ord-doc-attr  .
       22   define buffer old-ord-doc-attr   for src.ord-doc-attr  .
       23   define buffer new-ord-doc-attr   for dst.ord-doc-attr  .
       24   define buffer old-ord-line  for src.ord-line .
       25   define buffer new-ord-line  for dst.ord-line .
       26   define buffer old-c-ord-line  for src.c-ord-line .
       27   define buffer new-c-ord-line  for dst.c-ord-line .
       28   define buffer old-c-ord-line-attr  for src.c-ord-line-attr .
       29   define buffer new-c-ord-line-attr  for dst.c-ord-line-attr .
       30   define buffer old-c-ord-dtl  for src.c-ord-dtl .
       31   define buffer new-c-ord-dtl  for dst.c-ord-dtl .
       32   define buffer old-ord-line-attr  for src.ord-line-attr .
       33   define buffer new-ord-line-attr  for dst.ord-line-attr .
       34   define buffer old-ord-dtl   for src.ord-dtl .
       35   define buffer new-ord-dtl   for dst.ord-dtl .
       36   define buffer old-ord-doc-rcv   for src.ord-doc-rcv  .
       37   define buffer new-ord-doc-rcv   for dst.ord-doc-rcv  .
       38   define buffer old-ord-rcv-attr   for src.ord-rcv-attr  .
       39   define buffer new-ord-rcv-attr   for dst.ord-rcv-attr  .
       40   define buffer old-ord-line-rcv  for src.ord-line-rcv .
       41   define buffer new-ord-line-rcv  for dst.ord-line-rcv .
       42   define buffer old-ord-rcv-line-attr   for src.ord-rcv-line-attr  .
       43   define buffer new-ord-rcv-line-attr   for dst.ord-rcv-line-attr  .
       44   define buffer old-ord-dtl-rcv   for src.ord-dtl-rcv .
       45   define buffer new-ord-dtl-rcv   for dst.ord-dtl-rcv .
       46   define buffer new-ord-cons     for dst.ord-cons.
       47   define buffer new-ord-gds-cons for dst.ord-gds-cons.
       48   define buffer new-ord-dtl-cons for dst.ord-dtl-cons.
       49   define buffer old-ord-cons     for src.ord-cons.
       50   define buffer old-ord-gds-cons for src.ord-gds-cons.
       51   define buffer old-ord-dtl-cons for src.ord-dtl-cons.
       52   define buffer new-ord-cons-attr       for dst.ord-cons-attr      .
       53   define buffer new-ord-cons-line-attr  for dst.ord-cons-line-attr .
       54   define buffer old-ord-cons-attr       for src.ord-cons-attr      .
       55   define buffer old-ord-cons-line-attr  for src.ord-cons-line-attr .
       56   define buffer new-ord-chain           for dst.ord-chain                .
       57   define buffer new-ord-chain-attr      for dst.ord-chain-attr           .
       58   define buffer new-ord-blank-attr      for dst.ord-blank-attr           .
       59   define buffer new-ord-dtl-attr        for dst.ord-dtl-attr             .
       60   define buffer old-ord-chain           for src.ord-chain                .
       61   define buffer old-ord-chain-attr      for src.ord-chain-attr           .
       62   define buffer old-ord-blank-attr      for src.ord-blank-attr           .
       63   define buffer old-ord-dtl-attr        for src.ord-dtl-attr             .
       64   define buffer old-sysconf     for src.sysconf.
       65   define buffer new-shop        for dst.shop.
       66   define buffer new-store       for dst.store.
       67   define buffer new-clients   for dst.clients.
       68   do
       69   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       70   :
       71   define input parameter vartype-cut            as integer   no-undo.
       72   define input parameter varlist-db             as character no-undo.
       73   define input parameter vardate-actual-goods   as date      no-undo.
       74   define input parameter vardate-actual-docs    as date      no-undo.
       75   define input parameter vardate-actual-findoc  as date      no-undo.
       76   define input parameter vardate-output-zone    as date      no-undo.
       77   define input parameter varstay-recipe-goods   as logical   no-undo.
       78   define input parameter varstay-weight-goods   as logical   no-undo.
       79   define input parameter varnot-copy-del-goods  as logical   no-undo.
       80   define input parameter varstay-history        as logical   no-undo.
       81   define input parameter vargen-file            as character no-undo.
       82   define stream str-gen.
       83   output stream str-gen to vargen-file append.
       84   if not connected("src") then do:
       85      return error "Нет коннекта с базой 'src'.".
       86   end.
       87   if not connected("dst") then do:
       88      return error "Нет коннекта с базой 'dst'.".
       89   end.
       90   find src.sys-ctrl no-lock.
       91   if not available src.sys-ctrl then do:
       92      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       93   end.
       94   if src.sys-ctrl.db-num <> 0 then do:
       95      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       96   end.
       97   if vardate-actual-docs <> ? and
       98      (vardate-actual-goods   > vardate-actual-docs or
       99       vardate-actual-goods   = ? )   then do:
      100         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      101                                 "Дата актуальности товаров &1."        +
      102                                 "Дата актуальности документов &2."     +
      103                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      104                                 vardate-actual-goods,
      105                                 vardate-actual-docs).
      106   end.
      107   define new global shared variable g#library  as handle no-undo .
      108   define new global shared variable g#library2 as handle no-undo .
      109   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      110   procedure factord :
      111     define input  parameter p-fact-date            as date    no-undo .
      112     define input  parameter p-fact-time            as integer no-undo .
      113     define input  parameter p-fact-num             as integer no-undo .
      114     define input  parameter p-shift-date           as date    no-undo .
      115     define input  parameter p-shift-num            as integer no-undo .
      116     define input  parameter p-shift-on             as logical no-undo .
      117     define output parameter p-fact-order           as decimal no-undo .
      118     define output parameter p-shift-end-fact-order as decimal no-undo .
      119     define output parameter p-day-end-fact-order   as decimal no-undo .
      120     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      121     if p-fact-date = ?
      122     then do:
      123       return error "Не указана фактическая дата" .
      124     end.
      125     define variable v-fact-date-num as integer no-undo .
      126     assign
      127       v-fact-date-num = integer(p-fact-date)
      128     .
      129     if p-fact-num = ?
      130     or p-fact-num = 0
      131     then do:
      132       return error "Не задан p-fact-num " + string(p-fact-num) .
      133     end.
      134     if p-fact-num < 0
      135     then do:
      136       return error "Отрицательный fact-num " + string(p-fact-num) .
      137     end.
      138     if p-fact-num >= 100000000
      139     then do:
      140       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      141     end.
      142     if p-shift-on = true
      143     then do:
      144       if p-shift-date = ?
      145       then do:
      146         return error "Не задана дата смены" .
      147       end.
      148       if p-shift-num = ?
      149       or p-shift-num = 0
      150       then do:
      151         return error "Не задан номер смены" .
      152       end.
      153     end.
      154     else do:
      155       assign
      156         p-shift-date = p-fact-date
      157         p-shift-num  = 24
      158       .
      159     end.
      160     define variable v-shift-offset as integer no-undo .
      161     if p-shift-date = p-fact-date
      162     then do:
      163       assign
      164         v-shift-offset = 1
      165       .
      166     end.
      167     if p-shift-date < p-fact-date
      168     then do:
      169       assign
      170         v-shift-offset = 0
      171       .
      172     end.
      173     if p-shift-date > p-fact-date
      174     then do:
      175       message
      176         vss-workfile vss-revision vss-description skip
      177         "Неправильная дата закрытия смены" skip
      178         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      179         view-as alert-box error .
      180       undo, return error
      181         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      182           ,string(p-fact-date, '99/99/9999':U)
      183           ,string(p-shift-date, '99/99/9999':U)
      184           )
      185       .
      186     end.
      187     if p-shift-num < 1
      188     or p-shift-num > 24
      189     then do:
      190       message
      191         vss-workfile vss-revision vss-description skip
      192         "Неправильный номер смены" skip
      193         "p-shift-num" p-shift-num skip
      194         view-as alert-box error .
      195       undo, return error return-value .
      196     end.
      197     assign
      198       p-fact-order           = v-fact-date-num
      199                              + v-shift-offset * 0.5
      200                              + p-shift-num    * 0.02 - 0.01
      201                              + p-fact-num     * 0.0000000001
      202       p-shift-end-fact-order = v-fact-date-num
      203                              + v-shift-offset * 0.5
      204                              + p-shift-num    * 0.02
      205       p-day-end-fact-order   = v-fact-date-num
      206                              + 0.99
      207     .
      208     if p-fact-order           <= v-fact-date-num
      209     or p-shift-end-fact-order <= v-fact-date-num
      210     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      211     or p-shift-end-fact-order >= p-day-end-fact-order
      212     then do:
      213       message
      214         vss-workfile vss-revision vss-description skip
      215         "Внутренняя ошибка при генерации фактического номера" skip
      216         "p-fact-date"            p-fact-date            skip
      217         "p-fact-time"            p-fact-time            skip
      218         "p-fact-num"             p-fact-num             skip
      219         "p-shift-date"           p-shift-date           skip
      220         "p-shift-num"            p-shift-num            skip
      221         "p-shift-on"             p-shift-on             skip
      222         "p-shift-end-fact-order" p-shift-end-fact-order skip
      223         "p-day-end-fact-order"   p-day-end-fact-order   skip
      224         "v-fact-date-num"        v-fact-date-num        skip
      225         view-as alert-box error .
      226       undo, return error return-value .
      227     end.
      228   end procedure.
      229   procedure day-begin-fact-order :
      230     define input  parameter p-fact-date            as date    no-undo .
      231     define output parameter p-day-begin-fact-order as decimal no-undo .
      232     do
      233     on error undo, return error return-value
      234     :
      235       if p-fact-date = ?
      236       then do:
      237         assign
      238           p-day-begin-fact-order = 0
      239         .
      240       end.
      241       else do:
      242         assign
      243           p-day-begin-fact-order = integer(p-fact-date)
      244         .
      245       end.
      246     end.
      247   end procedure.
      248   procedure factord-max-fact-order :
      249     define output parameter p-max-fact-order as decimal   no-undo .
      250     do
      251     on error undo, return error return-value
      252     :
      253       run day-begin-fact-order in this-procedure
      254         (input  date(1, 1, 5000)
      255         ,output p-max-fact-order
      256         ) .
      257     end.
      258   end procedure.
      259   procedure factord-cut-archive :
      260     define input  parameter p-obj-type             as character no-undo .
      261     define input  parameter p-obj-code             as integer   no-undo .
      262     define input  parameter p-fact-date            as date      no-undo .
      263     define output parameter p-shift-on             as logical   no-undo .
      264     define output parameter p-shift-date           as date      no-undo .
      265     define output parameter p-shift-num            as integer   no-undo .
      266     define output parameter p-day-end-fact-order   as decimal   no-undo .
      267     define output parameter p-shift-end-fact-order as decimal   no-undo .
      268     define variable v-fact-order as decimal   no-undo .
      269     define buffer buf_shift-obj for ub.shift-obj .
      270     do
      271     on error undo, return error return-value
      272     :
      273   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      274   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      275     (input  p-obj-type
      276     ,input  p-obj-code
      277     ,input  'shift-on=request'
      278     ,output p-shift-on
      279     ) no-error .
      280       if error-status :error
      281       then do:
      282         message
      283           vss-workfile vss-revision vss-description skip
      284           "Ошибка при определении атрибута объекта" skip
      285           "Объект" p-obj-type p-obj-code skip
      286           error-status :get-message(1) skip
      287           return-value skip
      288           view-as alert-box error .
      289         undo, return error return-value .
      290       end.
      291       if p-shift-on = false
      292       then do:
      293         assign
      294           p-shift-date               = ?
      295           p-shift-num                = 0
      296         .
      297       end.
      298       else do:
      299         find first buf_shift-obj share-lock
      300           where buf_shift-obj.obj-type   = p-obj-type
      301             and buf_shift-obj.obj-code   = p-obj-code
      302             and buf_shift-obj.shift-date > p-fact-date
      303           use-index pi
      304           no-error .
      305         if not available buf_shift-obj
      306         or buf_shift-obj.status_ <> 'зкр':U
      307         then do:
      308           message
      309             vss-workfile vss-revision vss-description skip
      310             "Невозможно вычислить последнюю смену" skip
      311             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      312             "Объект" p-obj-type p-obj-code skip
      313             "Дата" p-fact-date skip
      314             view-as alert-box error .
      315           undo, return error return-value .
      316         end.
      317         find last buf_shift-obj share-lock
      318           where buf_shift-obj.obj-type = p-obj-type
      319             and buf_shift-obj.obj-code = p-obj-code
      320             and buf_shift-obj.shift-date <= p-fact-date
      321           use-index pi
      322           no-error .
      323         if available buf_shift-obj
      324         then do:
      325           if  buf_shift-obj.status_ = 'зкр':U
      326           then do:
      327             assign
      328               p-shift-date = buf_shift-obj.shift-date
      329               p-shift-num  = buf_shift-obj.shift-num
      330             .
      331           end.
      332           else do:
      333             message
      334               vss-workfile vss-revision vss-description skip
      335               "Невозможно вычислить последнюю смену" skip
      336               "Статус смены отличен от статуса" 'зкр':U skip
      337               "Объект" p-obj-type p-obj-code skip
      338               "Дата" p-fact-date skip
      339               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      340               view-as alert-box error .
      341             undo, return error return-value .
      342           end.
      343         end.
      344         else do:
      345           assign
      346             p-shift-date = p-fact-date - 1
      347             p-shift-num  = 1
      348           .
      349         end.
      350       end.
      351       run factord in this-procedure
      352         (input  p-fact-date
      353         ,input  1
      354         ,input  1
      355         ,input  p-shift-date
      356         ,input  p-shift-num
      357         ,input  p-shift-on
      358         ,output v-fact-order
      359         ,output p-shift-end-fact-order
      360         ,output p-day-end-fact-order
      361         ) no-error .
      362       if error-status :error
      363       then do:
      364         message
      365           vss-workfile vss-revision vss-description skip
      366           "Ошибка при вызове процедуры factord"
      367           error-status :get-message(1) skip
      368           return-value skip
      369           view-as alert-box error .
      370         undo, return error return-value .
      371       end.
      372     end.
      373   end procedure.
      374   procedure factord-lock-shift :
      375     define input  parameter p-obj-type  as character no-undo .
      376     define input  parameter p-obj-code  as integer   no-undo .
      377     define input  parameter p-fact-date as date      no-undo .
      378     define parameter buffer buf_shift-obj for ub.shift-obj .
      379     define variable v-shift-on      as logical   no-undo .
      380     define variable v-extra-message as character no-undo .
      381     define variable v-error as character no-undo .
      382     do
      383     on error undo, return error return-value
      384     :
      385   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      387     (input  p-obj-type
      388     ,input  p-obj-code
      389     ,input  'shift-on=request'
      390     ,output v-shift-on
      391     ) no-error .
      392       if error-status :error
      393       then do:
      394         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      395         undo, return error v-error .
      396       end.
      397       if v-shift-on = true
      398       then do:
      399         find first buf_shift-obj share-lock
      400           where buf_shift-obj.obj-type   = p-obj-type
      401             and buf_shift-obj.obj-code   = p-obj-code
      402             and buf_shift-obj.shift-date > p-fact-date
      403           use-index pi
      404           no-error .
      405         if not available buf_shift-obj
      406         or buf_shift-obj.status_ <> 'зкр':U
      407         then do:
      408           find last buf_shift-obj
      409             where buf_shift-obj.obj-type = p-obj-type
      410               and buf_shift-obj.obj-code = p-obj-code
      411               and buf_shift-obj.status_  = 'зкр':U
      412             use-index stts
      413             no-error .
      414           if available buf_shift-obj
      415           then do:
      416             assign
      417               v-extra-message =
      418                     substitute("Дата начала последеней закрытой смены на объекте &1"
      419                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      420                               )
      421             .
      422           end.
      423           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      424           undo, return error v-error .
      425         end.
      426       end.
      427     end.
      428   end procedure.
      429   procedure factord-end-day :
      430     define input  parameter p-fact-date            as date    no-undo .
      431     define output parameter p-day-end-fact-order   as decimal no-undo .
      432     do
      433     on error undo, return error return-value
      434     :
      435       if p-fact-date = ?
      436       then do:
      437         return error "Не указана фактическая дата" .
      438       end.
      439       assign
      440         p-day-end-fact-order = integer(p-fact-date) + 0.99
      441       .
      442     end.
      443   end procedure.
      444   procedure factord-to-date :
      445     define input  parameter p-fact-order as decimal no-undo .
      446     define output parameter p-fact-date  as date    no-undo .
      447     define variable v-ref-date  as date      no-undo .
      448     define variable v-ref-delta as integer   no-undo .
      449     do
      450     on error undo, return error return-value
      451     :
      452       if p-fact-order = ?
      453       or p-fact-order = 0
      454       then do:
      455         return error "Не указан fact-order" .
      456       end.
      457       assign
      458         v-ref-date  = date(1, 1, 2000)
      459       .
      460       assign
      461         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      462       .
      463       assign
      464         p-fact-date = v-ref-date + v-ref-delta
      465       .
      466     end.
      467   end procedure.
      468   procedure factord-to-fact-num :
      469     define input  parameter p-fact-order as decimal no-undo .
      470     define output parameter p-fact-num   as integer no-undo .
      471     define variable v-fact-order-trunc as decimal no-undo .
      472     do
      473     on error undo, return error return-value
      474     :
      475       if p-fact-order = ?
      476       or p-fact-order = 0
      477       then do:
      478         return error "Не указан fact-order" .
      479       end.
      480       assign
      481        v-fact-order-trunc = truncate(p-fact-order, 2)
      482       .
      483       assign
      484         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      485       .
      486     end.
      487   end procedure.
      488   procedure factord-to-shift-num :
      489     define input  parameter p-fact-order as decimal no-undo .
      490     define output parameter p-shift-num   as integer no-undo .
      491     define variable  p-shift-numd  as decimal   no-undo .
      492     define variable v-fact-order-trunc as decimal no-undo .
      493     do
      494     on error undo, return error return-value
      495     :
      496       if p-fact-order = ?
      497       or p-fact-order = 0
      498       then do:
      499         return error "Не указан fact-order" .
      500       end.
      501       assign
      502        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      503       .
      504       if v-fact-order-trunc < 0.5 then do:
      505         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      506       end.
      507       assign
      508         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      509         .
      510        assign
      511         p-shift-num = truncate (p-shift-numd , 0)
      512       .
      513     end.
      514   end procedure.
      515   define variable v-beg-fact-order as integer no-undo .
      516   define  shared temp-table tt-objs no-undo
      517     field obj-type as character
      518     field obj-code as integer
      519     index pi is unique primary obj-type obj-code
      520     .
      521   define buffer buf_clients for src.clients .
      522   on WRITE of dst.ord-blank             override do: end.
      523   on WRITE of dst.ord-doc               override do: end.
      524   on WRITE of dst.ord-line              override do: end.
      525   on WRITE of dst.ord-dtl               override do: end.
      526   on WRITE of dst.ord-doc-rcv           override do: end.
      527   on WRITE of dst.ord-line-rcv          override do: end.
      528   on WRITE of dst.ord-dtl-rcv           override do: end.
      529   on WRITE of dst.c-ord-doc            override do: end.
      530   on WRITE of dst.c-ord-doc-attr            override do: end.
      531   on WRITE of dst.c-ord-line           override do: end.
      532   on WRITE of dst.c-ord-line-attr           override do: end.
      533   on WRITE of dst.c-ord-dtl           override do: end.
      534   on WRITE of dst.ord-cons             override do: end.
      535   on WRITE of dst.ord-gds-cons         override do: end.
      536   on WRITE of dst.ord-dtl-cons         override do: end.
      537   on WRITE of dst.ord-cons-attr        override do: end.
      538   on WRITE of dst.ord-cons-line-attr   override do: end.
      539   on WRITE of dst.ord-doc-attr         override do: end.
      540   on WRITE of dst.ord-line-attr        override do: end.
      541   on WRITE of dst.ord-rcv-attr         override do: end.
      542   on WRITE of dst.ord-rcv-line-attr    override do: end.
      543   on WRITE of dst.ord-chain            override do: end.
      544   on WRITE of dst.ord-chain-attr       override do: end.
      545   on WRITE of dst.ord-blank-attr       override do: end.
      546   on WRITE of dst.ord-dtl-attr         override do: end.
      547   on WRITE of dst.edi-status           override do: end.
      548   define variable my-fact-order as decimal   no-undo .
      549   run day-begin-fact-order (input vardate-actual-docs , output my-fact-order) .
      550   for each old-ord-blank no-lock,
      551       first new-clients where new-clients.obj-type = old-ord-blank.cli-type and
      552                               new-clients.obj-code = old-ord-blank.cli-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      553       create new-ord-blank.
      554       buffer-copy old-ord-blank to new-ord-blank.
      555       for each old-ord-blank-attr no-lock where
      556                old-ord-blank-attr.blank-name   = new-ord-blank.blank-name  and
      557                old-ord-blank-attr.cli-code     = new-ord-blank.cli-code    and
      558                old-ord-blank-attr.cli-type     = new-ord-blank.cli-type    :
      559           create new-ord-blank-attr.
      560           buffer-copy old-ord-blank-attr to new-ord-blank-attr.
      561       end.
      562   end.
      563   if vardate-actual-docs <> ? then do:
      564     for each buf_clients no-lock  where
      565             buf_clients.db-num <> ?
      566     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      567       :
      568       if vartype-cut = 1 then do:
      569           find first tt-objs where tt-objs.obj-type = buf_clients.obj-type and
      570                                   tt-objs.obj-code = buf_clients.obj-code no-error.
      571       end.
      572       if vartype-cut = 0      or
      573           (vartype-cut = 1 and available tt-objs) then do:
      574             run proc-bod .
      575             run proc-bod-cons .
      576             run proc-bod-rcv .
      577       end.
      578       else do:
      579             run proc-bod1 ( input 'ОП':U) .
      580             run proc-bod1 ( input 'ФП':U) .
      581             run proc-bod1 ( input 'ОФ':U) .
      582             run proc-bod1 ( input 'ОО':U) .
      583             run proc-bod1 ( input 'ОР':U) .
      584             run proc-bod1-cons .
      585             run proc-bod1-rcv .
      586       end.
      587     end.
      588   end.
      589   output stream str-gen close.
      590   return "Произведен экспорт таблиц для заказов .".
      591   end.
      592   procedure proc-bod :
      593     do
      594     on error undo, return error return-value
      595     :
      596         for each old-ord-doc where
      597             old-ord-doc.obj-code  = buf_clients.obj-code and
      598             old-ord-doc.obj-type  = buf_clients.obj-type and
      599             old-ord-doc.fact-order >= my-fact-order   and
      600             old-ord-doc.status_ = 'факт':U
      601             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      602             if old-ord-doc.doc-type <> 'ОП':U and
      603               old-ord-doc.doc-type <> 'ФП':U and
      604               old-ord-doc.doc-type <> 'ОФ':U and
      605               old-ord-doc.doc-type <> 'ОО':U and
      606               old-ord-doc.doc-type <> 'ОР':U then next.
      607            run make-2 .
      608         end.
      609         for each old-ord-doc where
      610             old-ord-doc.obj-code  = buf_clients.obj-code and
      611             old-ord-doc.obj-type  = buf_clients.obj-type and
      612             old-ord-doc.status_ = 'поставка':U
      613             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      614             if old-ord-doc.doc-type <> 'ОП':U and
      615               old-ord-doc.doc-type <> 'ФП':U and
      616               old-ord-doc.doc-type <> 'ОФ':U and
      617               old-ord-doc.doc-type <> 'ОО':U and
      618               old-ord-doc.doc-type <> 'ОР':U then next.
      619            run make-2 .
      620         end.
      621         for each old-ord-doc where
      622             old-ord-doc.obj-code  = buf_clients.obj-code and
      623             old-ord-doc.obj-type  = buf_clients.obj-type and
      624             old-ord-doc.status_ = 'согласование':U
      625             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      626             if old-ord-doc.doc-type <> 'ОП':U and
      627               old-ord-doc.doc-type <> 'ФП':U and
      628               old-ord-doc.doc-type <> 'ОФ':U and
      629               old-ord-doc.doc-type <> 'ОО':U and
      630               old-ord-doc.doc-type <> 'ОР':U then next.
      631            run make-2 .
      632         end.
      633         for each old-ord-doc where
      634             old-ord-doc.obj-code  = buf_clients.obj-code and
      635             old-ord-doc.obj-type  = buf_clients.obj-type and
      636             old-ord-doc.status_ = 'новый':U
      637             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      638             if old-ord-doc.doc-type <> 'ОП':U and
      639               old-ord-doc.doc-type <> 'ФП':U and
      640               old-ord-doc.doc-type <> 'ОФ':U and
      641               old-ord-doc.doc-type <> 'ОО':U and
      642               old-ord-doc.doc-type <> 'ОР':U then next.
      643            run make-2 .
      644         end.
      645         for each old-ord-doc where
      646             old-ord-doc.obj-code  = buf_clients.obj-code and
      647             old-ord-doc.obj-type  = buf_clients.obj-type and
      648             old-ord-doc.status_ = 'разрешено':U
      649             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      650             if old-ord-doc.doc-type <> 'ОП':U and
      651               old-ord-doc.doc-type <> 'ФП':U and
      652               old-ord-doc.doc-type <> 'ОФ':U and
      653               old-ord-doc.doc-type <> 'ОО':U and
      654               old-ord-doc.doc-type <> 'ОР':U then next.
      655            run make-2 .
      656         end.
      657   end.
      658   end procedure.
      659   procedure proc-bod-cons :
      660     do
      661     on error undo, return error return-value
      662     :
      663      if buf_clients.obj-type = 'орг':U then do :
      664         for each old-ord-cons where
      665             old-ord-cons.host-code  = buf_clients.obj-code and
      666             old-ord-cons.status_    = 'факт':U and
      667             old-ord-cons.fact-date >= vardate-actual-docs
      668             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      669             create new-ord-cons.
      670             buffer-copy old-ord-cons to new-ord-cons.
      671             for each old-ord-gds-cons where
      672                      old-ord-gds-cons.cons-code = new-ord-cons.cons-code
      673                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      674                 create new-ord-gds-cons.
      675                 buffer-copy old-ord-gds-cons to new-ord-gds-cons.
      676             end.
      677             for each old-ord-dtl-cons where
      678                      old-ord-dtl-cons.cons-code = new-ord-cons.cons-code
      679                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      680                 create new-ord-dtl-cons.
      681                 buffer-copy old-ord-dtl-cons to new-ord-dtl-cons.
      682             end.
      683             for each old-ord-cons-attr where
      684                      old-ord-cons-attr.cons-code = new-ord-cons.cons-code
      685                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      686                 create new-ord-cons-attr.
      687                 buffer-copy old-ord-cons-attr to new-ord-cons-attr.
      688             end.
      689             for each old-ord-cons-line-attr where
      690                      old-ord-cons-line-attr.cons-code = new-ord-cons.cons-code
      691                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      692                 create new-ord-cons-line-attr.
      693                 buffer-copy old-ord-cons-line-attr to new-ord-cons-line-attr.
      694             end.
      695         end.
      696     end.
      697     end.
      698   end procedure.
      699   procedure proc-bod-rcv :
      700     do
      701     on error undo, return error return-value
      702     :
      703         for each old-ord-doc-rcv where
      704             old-ord-doc-rcv.obj-code  = buf_clients.obj-code and
      705             old-ord-doc-rcv.obj-type  = buf_clients.obj-type and
      706             old-ord-doc-rcv.status_   = 'факт':U  and
      707             old-ord-doc-rcv.doc-code  = ""     and
      708             old-ord-doc-rcv.fact-order >= my-fact-order
      709             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      710                 run make-in.
      711         end.
      712     end.
      713   end procedure.
      714   procedure make-in :
      715     do
      716     on error undo, return error return-value
      717     :
      718     if can-find (first new-ord-doc-rcv no-lock where
      719                       new-ord-doc-rcv.rcv-code = old-ord-doc-rcv.rcv-code and
      720                       new-ord-doc-rcv.doc-code = old-ord-doc-rcv.doc-code ) then return .
      721       create new-ord-doc-rcv.
      722       buffer-copy old-ord-doc-rcv to new-ord-doc-rcv.
      723       for each  old-ord-chain where
      724                 old-ord-chain.doc-code = new-ord-doc-rcv.rcv-code and
      725                 old-ord-chain.doc-type = 'rcv'  and
      726                 old-ord-chain.rel-doc-type = 'trn'
      727                 no-lock on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      728           create new-ord-chain no-error .
      729           buffer-copy old-ord-chain to new-ord-chain no-error .
      730           if not error-status :error then do:
      731             for each  old-ord-chain-attr where
      732                       old-ord-chain-attr.db-num = new-ord-chain.db-num and
      733                       old-ord-chain-attr.rel-id = new-ord-chain.rel-id
      734                       no-lock on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      735                find first new-ord-chain-attr no-lock where
      736                           new-ord-chain-attr.db-num = new-ord-chain.db-num and
      737                           new-ord-chain-attr.rel-id = new-ord-chain.rel-id no-error .
      738                 if not available new-ord-chain-attr then do:
      739                   create new-ord-chain-attr.
      740                   buffer-copy old-ord-chain-attr to new-ord-chain-attr.
      741                 end.
      742             end.
      743           end.
      744       end.
      745       for each old-ord-line-rcv where
      746                 old-ord-line-rcv.doc-code = new-ord-doc-rcv.doc-code and
      747                 old-ord-line-rcv.rcv-code = new-ord-doc-rcv.rcv-code
      748                 no-lock on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      749           create new-ord-line-rcv.
      750           buffer-copy old-ord-line-rcv to new-ord-line-rcv.
      751       end.
      752       for each old-ord-dtl-rcv where
      753                old-ord-dtl-rcv.doc-code = new-ord-doc-rcv.doc-code and
      754                old-ord-dtl-rcv.rcv-code = new-ord-doc-rcv.rcv-code
      755                no-lock on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      756           create new-ord-dtl-rcv.
      757           buffer-copy old-ord-dtl-rcv to new-ord-dtl-rcv.
      758       end.
      759       for each old-ord-rcv-attr where
      760                 old-ord-rcv-attr.doc-code = new-ord-doc-rcv.doc-code and
      761                 old-ord-rcv-attr.rcv-code = new-ord-doc-rcv.rcv-code
      762                 no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      763           create new-ord-rcv-attr.
      764           buffer-copy old-ord-rcv-attr to new-ord-rcv-attr.
      765       end.
      766       for each old-ord-rcv-line-attr where
      767                 old-ord-rcv-line-attr.doc-code = new-ord-doc-rcv.doc-code and
      768                 old-ord-rcv-line-attr.rcv-code = new-ord-doc-rcv.rcv-code
      769                 no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      770           create new-ord-rcv-line-attr.
      771           buffer-copy old-ord-rcv-line-attr to new-ord-rcv-line-attr.
      772       end.
      773     end.
      774   end procedure.
      775   procedure make-2 :
      776     do
      777     on error undo, return error return-value
      778     :
      779             create new-ord-doc.
      780             buffer-copy old-ord-doc to new-ord-doc.
      781             for each old-ord-line where
      782                      old-ord-line.doc-code = new-ord-doc.doc-code
      783                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      784                 create new-ord-line.
      785                 buffer-copy old-ord-line to new-ord-line.
      786             end.
      787             for each old-ord-dtl where
      788                      old-ord-dtl.doc-code = new-ord-doc.doc-code
      789                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      790                 create new-ord-dtl.
      791                 buffer-copy old-ord-dtl to new-ord-dtl.
      792             end.
      793             for each old-ord-dtl-attr where
      794                      old-ord-dtl-attr.doc-code = new-ord-doc.doc-code
      795                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      796                 create new-ord-dtl-attr.
      797                 buffer-copy old-ord-dtl-attr to new-ord-dtl-attr.
      798             end.
      799             for each old-ord-line-attr where
      800                      old-ord-line-attr.doc-code = new-ord-doc.doc-code
      801                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      802                 create new-ord-line-attr.
      803                 buffer-copy old-ord-line-attr to new-ord-line-attr.
      804             end.
      805             for each old-ord-doc-attr where
      806                      old-ord-doc-attr.doc-code = new-ord-doc.doc-code
      807                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      808                 create new-ord-doc-attr.
      809                 buffer-copy old-ord-doc-attr to new-ord-doc-attr.
      810             end.
      811             for each old-ord-doc-rcv where
      812                      old-ord-doc-rcv.doc-code = new-ord-doc.doc-code
      813                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      814               create new-ord-doc-rcv.
      815               buffer-copy old-ord-doc-rcv to new-ord-doc-rcv.
      816               if new-ord-doc.whole-send-news > 0 then do:
      817                 for each old-edi-status where
      818                           old-edi-status.tbl-name = 'ord-doc-rcv':U
      819                       and old-edi-status.doc-code = new-ord-doc-rcv.rcv-code
      820                           no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      821                     create new-edi-status.
      822                     buffer-copy old-edi-status to new-edi-status.
      823                 end.
      824                 for each old-edi-status where
      825                           old-edi-status.tbl-name = 'ord-line-rcv':U
      826                       and old-edi-status.doc-code begins (new-ord-doc-rcv.rcv-code + chr(4) )
      827                           no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      828                     create new-edi-status.
      829                     buffer-copy old-edi-status to new-edi-status.
      830                 end.
      831               end.
      832             end.
      833             for each old-ord-line-rcv where
      834                      old-ord-line-rcv.doc-code = new-ord-doc.doc-code
      835                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      836                 create new-ord-line-rcv.
      837                 buffer-copy old-ord-line-rcv to new-ord-line-rcv.
      838             end.
      839             for each old-ord-dtl-rcv where
      840                      old-ord-dtl-rcv.doc-code = new-ord-doc.doc-code
      841                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      842                 create new-ord-dtl-rcv.
      843                 buffer-copy old-ord-dtl-rcv to new-ord-dtl-rcv.
      844             end.
      845       for each old-ord-rcv-attr where
      846                 old-ord-rcv-attr.doc-code = new-ord-doc.doc-code
      847                 no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      848           create new-ord-rcv-attr.
      849           buffer-copy old-ord-rcv-attr to new-ord-rcv-attr.
      850       end.
      851       for each old-ord-rcv-line-attr where
      852                 old-ord-rcv-line-attr.doc-code = new-ord-doc.doc-code
      853                 no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      854           create new-ord-rcv-line-attr.
      855           buffer-copy old-ord-rcv-line-attr to new-ord-rcv-line-attr.
      856       end.
      857       if new-ord-doc.whole-send-news > 0 then do:
      858         for each old-edi-status where
      859                   old-edi-status.tbl-name = 'ord-doc':U
      860               and old-edi-status.doc-code = new-ord-doc.doc-code
      861                   no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      862             create new-edi-status.
      863             buffer-copy old-edi-status to new-edi-status.
      864         end.
      865         for each old-edi-status where
      866                   old-edi-status.tbl-name = 'ord-line':U
      867               and old-edi-status.doc-code begins (new-ord-doc.doc-code + chr(4) )
      868                   no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      869             create new-edi-status.
      870             buffer-copy old-edi-status to new-edi-status.
      871         end.
      872       end.
      873       for each old-ord-chain of old-ord-doc
      874       no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      875             create new-ord-chain.
      876             buffer-copy old-ord-chain to new-ord-chain.
      877             for each old-ord-chain-attr of old-ord-chain
      878             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      879             create new-ord-chain-attr.
      880             buffer-copy old-ord-chain-attr to new-ord-chain-attr.
      881             end.
      882       end.
      883       if varstay-history = true then do:
      884             for each old-c-ord-doc where
      885                      old-c-ord-doc.doc-code = new-ord-doc.doc-code
      886                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      887                 create new-c-ord-doc.
      888                 buffer-copy old-c-ord-doc to new-c-ord-doc.
      889             end.
      890             for each old-c-ord-doc-attr where
      891                      old-c-ord-doc-attr.doc-code = new-ord-doc.doc-code
      892                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      893                 create new-c-ord-doc-attr.
      894                 buffer-copy old-c-ord-doc-attr to new-c-ord-doc-attr.
      895             end.
      896             for each old-c-ord-line where
      897                      old-c-ord-line.doc-code = new-ord-doc.doc-code
      898                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      899                 create new-c-ord-line.
      900                 buffer-copy old-c-ord-line to new-c-ord-line.
      901             end.
      902             for each old-c-ord-line-attr where
      903                      old-c-ord-line-attr.doc-code = new-ord-doc.doc-code
      904                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      905                 create new-c-ord-line-attr.
      906                 buffer-copy old-c-ord-line-attr to new-c-ord-line-attr.
      907             end.
      908             for each old-c-ord-dtl where
      909                      old-c-ord-dtl.doc-code = new-ord-doc.doc-code
      910                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      911                 create new-c-ord-dtl.
      912                 buffer-copy old-c-ord-dtl to new-c-ord-dtl.
      913             end.
      914       end.
      915     end.
      916   end procedure.
      917   procedure proc-bod1 :
      918     do
      919     on error undo, return error return-value
      920     :
      921   define input  parameter p-val as character no-undo .
      922      for each old-sysconf no-lock :
      923         for each old-ord-doc where
      924             old-ord-doc.host-code = old-sysconf.host-code and
      925             old-ord-doc.obj-code  = buf_clients.obj-code and
      926             old-ord-doc.obj-type  = buf_clients.obj-type and
      927             old-ord-doc.doc-type  = p-val
      928             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      929            run make-2 .
      930         end.
      931      end.
      932   end.
      933   end procedure.
      934   procedure proc-bod1-cons :
      935     do
      936     on error undo, return error return-value
      937     :
      938      if buf_clients.obj-type = 'орг':U then do :
      939         for each old-ord-cons where
      940             old-ord-cons.host-code  = buf_clients.obj-code and
      941             old-ord-cons.status_    = 'факт':U
      942             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      943             create new-ord-cons.
      944             buffer-copy old-ord-cons to new-ord-cons.
      945             for each old-ord-gds-cons where
      946                      old-ord-gds-cons.cons-code = new-ord-cons.cons-code
      947                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      948                 create new-ord-gds-cons.
      949                 buffer-copy old-ord-gds-cons to new-ord-gds-cons.
      950             end.
      951             for each old-ord-dtl-cons where
      952                      old-ord-dtl-cons.cons-code = new-ord-cons.cons-code
      953                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      954                 create new-ord-dtl-cons.
      955                 buffer-copy old-ord-dtl-cons to new-ord-dtl-cons.
      956             end.
      957             for each old-ord-cons-attr where
      958                      old-ord-cons-attr.cons-code = new-ord-cons.cons-code
      959                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      960                 create new-ord-cons-attr.
      961                 buffer-copy old-ord-cons-attr to new-ord-cons-attr.
      962             end.
      963             for each old-ord-cons-line-attr where
      964                      old-ord-cons-line-attr.cons-code = new-ord-cons.cons-code
      965                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      966                 create new-ord-cons-line-attr.
      967                 buffer-copy old-ord-cons-line-attr to new-ord-cons-line-attr.
      968             end.
      969         end.
      970     end.
      971     end.
      972   end procedure.
      973   procedure proc-bod1-rcv :
      974     do
      975     on error undo, return error return-value
      976     :
      977         for each old-ord-doc-rcv where
      978             old-ord-doc-rcv.obj-code  = buf_clients.obj-code and
      979             old-ord-doc-rcv.obj-type  = buf_clients.obj-type and
      980             old-ord-doc-rcv.status_    = 'факт':U and
      981             old-ord-doc-rcv.doc-code    = ""
      982             no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      983                 run make-in.
      984         end.
      985     end.
      986   end procedure.
