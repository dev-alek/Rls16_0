        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: a0259edc0fbd, 1040, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        4   define variable vss-date        as character no-undo init "$Date: Fri Oct 06 18:30:43 2017 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00181000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00181000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 181.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-usr-flt  for ubfltsrc.usr-flt .
       13   define buffer new-usr-flt  for ubfltdst.usr-flt .
       14   define buffer old-usr-flt-attr                     for ubfltsrc.usr-flt-attr .
       15   define buffer new-usr-flt-attr                     for ubfltdst.usr-flt-attr .
       16   define buffer old-menu-user-call                   for ubfltsrc.menu-user-call .
       17   define buffer new-menu-user-call                   for ubfltdst.menu-user-call .
       18   define buffer old-menu-user-call-attr              for ubfltsrc.menu-user-call-attr .
       19   define buffer new-menu-user-call-attr              for ubfltdst.menu-user-call-attr .
       20   define buffer old-user-context-history             for ubfltsrc.user-context-history .
       21   define buffer new-user-context-history             for ubfltdst.user-context-history .
       22   define buffer old-user-context-history-attr        for ubfltsrc.user-context-history-attr .
       23   define buffer new-user-context-history-attr        for ubfltdst.user-context-history-attr .
       24   define buffer old-user-window-attr                 for ubfltsrc.user-window-attr .
       25   define buffer new-user-window-attr                 for ubfltdst.user-window-attr .
       26   define buffer old-db-usr-flt                       for src.db-usr-flt .
       27   define buffer new-db-usr-flt                       for dst.db-usr-flt .
       28   define buffer old-db-usr-flt-attr                  for src.db-usr-flt-attr .
       29   define buffer new-db-usr-flt-attr                  for dst.db-usr-flt-attr .
       30   define buffer old-user-login                       for src.user-login .
       31   define buffer new-user-login                       for dst.user-login .
       32   define buffer old-c-user-login                     for src.c-user-login .
       33   define buffer new-c-user-login                     for dst.c-user-login .
       34   define buffer old-c-user-log                       for src.c-user-log .
       35   define buffer new-c-user-log                       for dst.c-user-log .
       36   define buffer old-c-usr-hist                       for src.c-usr-hist .
       37   define buffer new-c-usr-hist                       for dst.c-usr-hist .
       38   define buffer old-user-login-action-item           for src.user-login-action-item .
       39   define buffer new-user-login-action-item           for dst.user-login-action-item .
       40   define buffer old-user-login-action-item-attr      for src.user-login-action-item-attr .
       41   define buffer new-user-login-action-item-attr      for dst.user-login-action-item-attr .
       42   define buffer old-user-login-action-role           for src.user-login-action-role .
       43   define buffer new-user-login-action-role           for dst.user-login-action-role .
       44   define buffer old-user-login-action-role-attr      for src.user-login-action-role-attr .
       45   define buffer new-user-login-action-role-attr      for dst.user-login-action-role-attr .
       46   define buffer old-user-login-attr                  for src.user-login-attr .
       47   define buffer new-user-login-attr                  for dst.user-login-attr .
       48   define buffer old-user-account                     for src.user-account .
       49   define buffer new-user-account                     for dst.user-account .
       50   define buffer old-c-user-account                   for src.c-user-account .
       51   define buffer new-c-user-account                   for dst.c-user-account .
       52   define buffer old-user-account-attr                for src.user-account-attr .
       53   define buffer new-user-account-attr                for dst.user-account-attr .
       54   define buffer old-user-conn-attr                   for src.user-conn-attr .
       55   define buffer new-user-conn-attr                   for dst.user-conn-attr .
       56   define buffer old-user-host                        for src.user-host .
       57   define buffer new-user-host                        for dst.user-host .
       58   define buffer old-user-host-attr                   for src.user-host-attr   .
       59   define buffer new-user-host-attr                   for dst.user-host-attr   .
       60   define buffer old-user-menu-group                  for src.user-menu-group  .
       61   define buffer new-user-menu-group                  for dst.user-menu-group  .
       62   define buffer old-user-menu-group-attr             for src.user-menu-group-attr.
       63   define buffer new-user-menu-group-attr             for dst.user-menu-group-attr.
       64   define buffer old-user-obj                         for src.user-obj .
       65   define buffer new-user-obj                         for dst.user-obj .
       66   define buffer old-user-obj-attr                    for src.user-obj-attr.
       67   define buffer new-user-obj-attr                    for dst.user-obj-attr.
       68   define buffer old-menu-user                        for src.menu-user.
       69   define buffer new-menu-user                        for dst.menu-user .
       70   define buffer old-menu-user-attr                   for src.menu-user-attr.
       71   define buffer new-menu-user-attr                   for dst.menu-user-attr .
       72   do
       73   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       74   define input parameter vartype-cut            as integer   no-undo.
       75   define input parameter varlist-db             as character no-undo.
       76   define input parameter vardate-actual-goods   as date      no-undo.
       77   define input parameter vardate-actual-docs    as date      no-undo.
       78   define input parameter vardate-actual-findoc  as date      no-undo.
       79   define input parameter vardate-output-zone    as date      no-undo.
       80   define input parameter varstay-recipe-goods   as logical   no-undo.
       81   define input parameter varstay-weight-goods   as logical   no-undo.
       82   define input parameter varnot-copy-del-goods  as logical   no-undo.
       83   define input parameter varstay-history        as logical   no-undo.
       84   define input parameter vargen-file            as character no-undo.
       85   define stream str-gen.
       86   output stream str-gen to vargen-file append.
       87   if not connected("src") then do:
       88      return error "Нет коннекта с базой 'src'.".
       89   end.
       90   if not connected("dst") then do:
       91      return error "Нет коннекта с базой 'dst'.".
       92   end.
       93   find src.sys-ctrl no-lock.
       94   if not available src.sys-ctrl then do:
       95      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       96   end.
       97   if src.sys-ctrl.db-num <> 0 then do:
       98      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       99   end.
      100   if vardate-actual-docs <> ? and
      101      (vardate-actual-goods   > vardate-actual-docs or
      102       vardate-actual-goods   = ? )   then do:
      103         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      104                                 "Дата актуальности товаров &1."        +
      105                                 "Дата актуальности документов &2."     +
      106                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      107                                 vardate-actual-goods,
      108                                 vardate-actual-docs).
      109   end.
      110   on write of ubfltdst.usr-flt override do: end.
      111   on write of ubfltdst.usr-flt-attr             override do: end.
      112   on write of ubfltdst.menu-user-call           override do: end.
      113   on write of ubfltdst.menu-user-call-attr      override do: end.
      114   on write of ubfltdst.user-context-history     override do: end.
      115   on write of ubfltdst.user-context-history-attr override do: end.
      116   on write of ubfltdst.user-window-attr         override do: end.
      117   on write of dst.db-usr-flt                    override do: end.
      118   on write of dst.db-usr-flt-attr               override do: end.
      119   on write of dst.user-login                    override do: end.
      120   on write of dst.c-user-login                  override do: end.
      121   on write of dst.c-user-log                    override do: end.
      122   on write of dst.user-login-action-item        override do: end.
      123   on write of dst.user-login-action-item-attr   override do: end.
      124   on write of dst.user-login-action-role        override do: end.
      125   on write of dst.user-login-action-role-attr   override do: end.
      126   on write of dst.user-login-attr               override do: end.
      127   on write of dst.user-account                  override do: end.
      128   on write of dst.c-user-account                override do: end.
      129   on write of dst.user-account-attr             override do: end.
      130   on write of dst.user-conn-attr                override do: end.
      131   on write of dst.user-host                     override do: end.
      132   on write of dst.user-host-attr                override do: end.
      133   on write of dst.user-menu-group               override do: end.
      134   on write of dst.user-menu-group-attr          override do: end.
      135   on write of dst.user-obj                      override do: end.
      136   on write of dst.user-obj-attr                 override do: end.
      137   on write of dst.menu-user                     override do: end.
      138   on write of dst.menu-user-attr                override do: end.
      139   on write of dst.c-usr-hist                    override do: end.
      140   for each old-usr-flt  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      141      create new-usr-flt.
      142      buffer-copy old-usr-flt to new-usr-flt.
      143   end.
      144   for each old-usr-flt-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      145      create new-usr-flt-attr.
      146      buffer-copy old-usr-flt-attr to new-usr-flt-attr.
      147   end.
      148   for each old-menu-user-call  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      149      create new-menu-user-call.
      150      buffer-copy old-menu-user-call to new-menu-user-call.
      151   end.
      152   for each old-menu-user-call-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      153      create new-menu-user-call-attr.
      154      buffer-copy old-menu-user-call-attr to new-menu-user-call-attr.
      155   end.
      156   for each old-user-context-history  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      157      create new-user-context-history.
      158      buffer-copy old-user-context-history to new-user-context-history.
      159   end.
      160   for each old-user-context-history-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      161      create new-user-context-history-attr.
      162      buffer-copy old-user-context-history-attr to new-user-context-history-attr.
      163   end.
      164   for each old-user-window-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      165      create new-user-window-attr.
      166      buffer-copy old-user-window-attr to new-user-window-attr.
      167   end.
      168   for each old-db-usr-flt  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      169      create new-db-usr-flt.
      170      buffer-copy old-db-usr-flt to new-db-usr-flt.
      171   end.
      172   for each old-db-usr-flt-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      173      create new-db-usr-flt-attr.
      174      buffer-copy old-db-usr-flt-attr to new-db-usr-flt-attr.
      175   end.
      176   for each old-user-login  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      177      create new-user-login.
      178      buffer-copy old-user-login to new-user-login.
      179   end.
      180   if varstay-history then do:
      181   for each old-c-user-login  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      182      create new-c-user-login.
      183      buffer-copy old-c-user-login to new-c-user-login.
      184   end.
      185   for each old-c-user-log  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      186      create new-c-user-log.
      187      buffer-copy old-c-user-log to new-c-user-log.
      188   end.
      189   for each old-c-usr-hist  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      190      create new-c-usr-hist.
      191      buffer-copy old-c-usr-hist to new-c-usr-hist.
      192   end.
      193   end.
      194   for each old-user-login-action-item  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      195      create new-user-login-action-item.
      196      buffer-copy old-user-login-action-item to new-user-login-action-item.
      197   end.
      198   for each old-user-login-action-item-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      199      create new-user-login-action-item-attr.
      200      buffer-copy old-user-login-action-item-attr to new-user-login-action-item-attr.
      201   end.
      202   for each old-user-login-action-role  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      203      create new-user-login-action-role.
      204      buffer-copy old-user-login-action-role to new-user-login-action-role.
      205   end.
      206   for each old-user-login-action-role-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      207      create new-user-login-action-role-attr.
      208      buffer-copy old-user-login-action-role-attr to new-user-login-action-role-attr.
      209   end.
      210   for each old-user-login-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      211      create new-user-login-attr.
      212      buffer-copy old-user-login-attr to new-user-login-attr.
      213   end.
      214   for each old-user-account  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      215      create new-user-account.
      216      buffer-copy old-user-account to new-user-account.
      217   end.
      218   if varstay-history then do:
      219   for each old-c-user-account  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      220      create new-c-user-account.
      221      buffer-copy old-c-user-account to new-c-user-account.
      222   end.
      223   end.
      224   for each old-user-account-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      225      create new-user-account-attr.
      226      buffer-copy old-user-account-attr to new-user-account-attr.
      227   end.
      228   for each old-user-conn-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      229      create new-user-conn-attr.
      230      buffer-copy old-user-conn-attr to new-user-conn-attr.
      231   end.
      232   for each old-user-host  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      233      create new-user-host.
      234      buffer-copy old-user-host to new-user-host.
      235   end.
      236   for each old-user-host-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      237      create new-user-host-attr.
      238      buffer-copy old-user-host-attr to new-user-host-attr.
      239   end.
      240   for each old-user-menu-group  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      241      create new-user-menu-group.
      242      buffer-copy old-user-menu-group to new-user-menu-group.
      243   end.
      244   for each old-user-menu-group-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      245      create new-user-menu-group-attr.
      246      buffer-copy old-user-menu-group-attr to new-user-menu-group-attr.
      247   end.
      248   for each old-user-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      249      create new-user-obj.
      250      buffer-copy old-user-obj to new-user-obj.
      251   end.
      252   for each old-user-obj-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      253      create new-user-obj-attr.
      254      buffer-copy old-user-obj-attr to new-user-obj-attr.
      255   end.
      256   for each old-menu-user  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      257      create new-menu-user.
      258      buffer-copy old-menu-user to new-menu-user.
      259   end.
      260   for each old-menu-user-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      261      create new-menu-user-attr.
      262      buffer-copy old-menu-user-attr to new-menu-user-attr.
      263   end.
      264   output stream str-gen close.
      265   return "Произведен экспорт таблиц: usr-flt usr-flt-attr menu-user-call menu-user-call-attr user-context-history user-context-history-attr user-window-attr ~
      266   db-usr-flt db-usr-flt-attr ~
      267   user-login c-user-login c-user-log c-usr-hist user-login-action-item user-login-action-item-attr user-login-action-role ~
      268   user-login-action-role-attr user-login-attr user-conn-attr ~
      269   user-host user-host-attr user-menu-group user-menu-group-attr user-obj user-obj-attr ~
      270   menu-user menu-user-attr .".
      271   end.
