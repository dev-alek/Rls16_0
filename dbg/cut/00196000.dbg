        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 36493b7e3299, 155, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Feb 17 18:03:53 2015 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00196000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00196000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 196.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-c-doc-attr          for src.c-doc-attr.
       13   define buffer new-c-doc-attr          for dst.c-doc-attr.
       14   define buffer new-c-trn-doc            for dst.c-trn-doc  .
       15   define buffer new-c-rvs-doc            for dst.c-rvs-doc  .
       16   define buffer new-c-price-doc          for dst.c-price-doc.
       17   define buffer new-c-fbr-doc            for dst.c-fbr-doc  .
       18   define buffer new-c-wth-doc            for dst.c-wth-doc  .
       19   do
       20   on error undo, return error
       21   :
       22   define input parameter vartype-cut            as integer   no-undo.
       23   define input parameter varlist-db             as character no-undo.
       24   define input parameter vardate-actual-goods   as date      no-undo.
       25   define input parameter vardate-actual-docs    as date      no-undo.
       26   define input parameter vardate-actual-findoc  as date      no-undo.
       27   define input parameter vardate-output-zone    as date      no-undo.
       28   define input parameter varstay-recipe-goods   as logical   no-undo.
       29   define input parameter varstay-weight-goods   as logical   no-undo.
       30   define input parameter varnot-copy-del-goods  as logical   no-undo.
       31   define input parameter varstay-history        as logical   no-undo.
       32   define input parameter vargen-file            as character no-undo.
       33   define stream str-gen.
       34   output stream str-gen to vargen-file append.
       35   if not connected("src") then do:
       36      return error "Нет коннекта с базой 'src'.".
       37   end.
       38   if not connected("dst") then do:
       39      return error "Нет коннекта с базой 'dst'.".
       40   end.
       41   find src.sys-ctrl no-lock.
       42   if not available src.sys-ctrl then do:
       43      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       44   end.
       45   if src.sys-ctrl.db-num <> 0 then do:
       46      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       47   end.
       48   if vardate-actual-docs <> ? and
       49      (vardate-actual-goods   > vardate-actual-docs or
       50       vardate-actual-goods   = ? )   then do:
       51         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       52                                 "Дата актуальности товаров &1."        +
       53                                 "Дата актуальности документов &2."     +
       54                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       55                                 vardate-actual-goods,
       56                                 vardate-actual-docs).
       57   end.
       58     if not varstay-history  then return .
       59     on WRITE of dst.c-doc-attr      override do: end.
       60     for each new-c-trn-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       61         run proc-1(new-c-trn-doc.doc-code, new-c-trn-doc.chip-num) .
       62     end.
       63     for each new-c-rvs-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       64         run proc-1(new-c-rvs-doc.rvs-code, new-c-rvs-doc.chip-num) .
       65     end.
       66     for each new-c-price-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       67         run proc-1(new-c-price-doc.doc-num, new-c-price-doc.chip-num) .
       68     end.
       69     for each new-c-fbr-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       70         run proc-1(new-c-fbr-doc.doc-code, new-c-fbr-doc.chip-num) .
       71     end.
       72     for each new-c-wth-doc no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       73         run proc-1(new-c-wth-doc.doc-code, new-c-wth-doc.chip-num) .
       74     end.
       75   output stream str-gen close.
       76     return "Произведен экспорт таблиц: doc-attr.".
       77   end.
       78   procedure proc-1 :
       79     do
       80     on error undo, return error return-value
       81     :
       82     define input parameter p-doc as character no-undo .
       83     define input parameter p-chip-num as integer no-undo.
       84     for each old-c-doc-attr where old-c-doc-attr.doc-code = p-doc      and
       85                                   old-c-doc-attr.chip-num = p-chip-num no-lock  on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       86         :
       87         create new-c-doc-attr.
       88         BUFFER-COPY old-c-doc-attr to new-c-doc-attr.
       89     end.
       90     end.
       91   end procedure.
