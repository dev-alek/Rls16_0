        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 36493b7e3299, 155, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Feb 17 18:03:53 2015 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00045000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00045000.p $":U.
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 45.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-c-price-doc   for src.c-price-doc.
       13   define buffer new-c-price-doc   for dst.c-price-doc.
       14   define buffer old-c-price-list  for src.c-price-list.
       15   define buffer new-c-price-list  for dst.c-price-list.
       16   define buffer old-c-price-list-attr  for src.c-price-list-attr.
       17   define buffer new-c-price-list-attr  for dst.c-price-list-attr.
       18   define buffer new-shop        for dst.shop.
       19   define buffer new-store       for dst.store.
       20   do
       21   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       22   define input parameter vartype-cut            as integer   no-undo.
       23   define input parameter varlist-db             as character no-undo.
       24   define input parameter vardate-actual-goods   as date      no-undo.
       25   define input parameter vardate-actual-docs    as date      no-undo.
       26   define input parameter vardate-actual-findoc  as date      no-undo.
       27   define input parameter vardate-output-zone    as date      no-undo.
       28   define input parameter varstay-recipe-goods   as logical   no-undo.
       29   define input parameter varstay-weight-goods   as logical   no-undo.
       30   define input parameter varnot-copy-del-goods  as logical   no-undo.
       31   define input parameter varstay-history        as logical   no-undo.
       32   define input parameter vargen-file            as character no-undo.
       33   define stream str-gen.
       34   output stream str-gen to vargen-file append.
       35   if not connected("src") then do:
       36      return error "Нет коннекта с базой 'src'.".
       37   end.
       38   if not connected("dst") then do:
       39      return error "Нет коннекта с базой 'dst'.".
       40   end.
       41   find src.sys-ctrl no-lock.
       42   if not available src.sys-ctrl then do:
       43      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       44   end.
       45   if src.sys-ctrl.db-num <> 0 then do:
       46      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       47   end.
       48   if vardate-actual-docs <> ? and
       49      (vardate-actual-goods   > vardate-actual-docs or
       50       vardate-actual-goods   = ? )   then do:
       51         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       52                                 "Дата актуальности товаров &1."        +
       53                                 "Дата актуальности документов &2."     +
       54                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       55                                 vardate-actual-goods,
       56                                 vardate-actual-docs).
       57   end.
       58   define  shared temp-table tt-objs no-undo
       59     field obj-type as character
       60     field obj-code as integer
       61     index pi is unique primary obj-type obj-code
       62     .
       63   if not varstay-history then return .
       64   define buffer buf_clients for src.clients .
       65   on WRITE of dst.c-price-doc  override do: end.
       66   on WRITE of dst.c-price-list override do: end.
       67   on WRITE of dst.c-price-list-attr override do: end.
       68   if vardate-actual-docs <> ? then do:
       69       for each buf_clients no-lock  where
       70                buf_clients.db-num <> ?
       71       on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       72         :
       73         if vartype-cut = 1 then do:
       74             find first tt-objs where tt-objs.obj-type = buf_clients.obj-type and
       75                                      tt-objs.obj-code = buf_clients.obj-code no-error.
       76         end.
       77         if vartype-cut = 0      or
       78             (vartype-cut = 1 and available tt-objs) then do:
       79                        if buf_clients.obj-type  = 'маг':U OR buf_clients.obj-type  = 'скл':U then DO:
       80                               for each old-c-price-doc where
       81                                         old-c-price-doc.obj-type   = buf_clients.obj-TYPE  and
       82                                         old-c-price-doc.obj-code   = buf_clients.obj-code  and
       83                                         old-c-price-doc.status_    = 'акт':U      and
       84                                         old-c-price-doc.fact-date >= vardate-actual-docs no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       85                                   RUN proc-copy no-error .
       86                                   IF error-status :error THEN return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
       87                               end.
       88                        end.
       89         end.
       90         else do:
       91                       if buf_clients.obj-type  = 'маг':U OR buf_clients.obj-type  = 'скл':U then DO:
       92                               for each old-c-price-doc where
       93                                         old-c-price-doc.obj-type   = buf_clients.obj-TYPE  and
       94                                         old-c-price-doc.obj-code   = buf_clients.obj-code  and
       95                                         old-c-price-doc.status_    = 'акт':U
       96                                         no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       97                                   RUN proc-copy no-error .
       98                                   IF error-status :error THEN return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
       99                               end.
      100                        end.
      101         end.
      102     END.
      103   output stream str-gen close.
      104   END.
      105   return "Произведен экспорт таблиц: c-price-doc c-price-list ( только переоценки )".
      106   end.
      107   procedure proc-copy :
      108     do
      109     on error undo, return error return-value
      110     :
      111     for each old-c-price-list where old-c-price-list.doc-num  = old-c-price-doc.doc-num  and
      112                                     old-c-price-list.chip-num = old-c-price-doc.chip-num no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      113         create new-c-price-list.
      114         buffer-copy old-c-price-list to new-c-price-list.
      115     end.
      116     for each old-c-price-list-attr where old-c-price-list-attr.doc-num  = old-c-price-doc.doc-num  and
      117                                           old-c-price-list-attr.chip-num = old-c-price-doc.chip-num no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      118         create new-c-price-list-attr.
      119         buffer-copy old-c-price-list-attr to new-c-price-list-attr.
      120     end.
      121     create new-c-price-doc.
      122     buffer-copy old-c-price-doc to new-c-price-doc.
      123     end.
      124   end procedure.
