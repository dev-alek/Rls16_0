        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00109000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00109000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 109.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   do
       13   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       14   define input parameter vartype-cut            as integer   no-undo.
       15   define input parameter varlist-db             as character no-undo.
       16   define input parameter vardate-actual-goods   as date      no-undo.
       17   define input parameter vardate-actual-docs    as date      no-undo.
       18   define input parameter vardate-actual-findoc  as date      no-undo.
       19   define input parameter vardate-output-zone    as date      no-undo.
       20   define input parameter varstay-recipe-goods   as logical   no-undo.
       21   define input parameter varstay-weight-goods   as logical   no-undo.
       22   define input parameter varnot-copy-del-goods  as logical   no-undo.
       23   define input parameter varstay-history        as logical   no-undo.
       24   define input parameter vargen-file            as character no-undo.
       25   define stream str-gen.
       26   output stream str-gen to vargen-file append.
       27   if not connected("src") then do:
       28      return error "Нет коннекта с базой 'src'.".
       29   end.
       30   if not connected("dst") then do:
       31      return error "Нет коннекта с базой 'dst'.".
       32   end.
       33   find src.sys-ctrl no-lock.
       34   if not available src.sys-ctrl then do:
       35      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       36   end.
       37   if src.sys-ctrl.db-num <> 0 then do:
       38      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       39   end.
       40   if vardate-actual-docs <> ? and
       41      (vardate-actual-goods   > vardate-actual-docs or
       42       vardate-actual-goods   = ? )   then do:
       43         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       44                                 "Дата актуальности товаров &1."        +
       45                                 "Дата актуальности документов &2."     +
       46                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       47                                 vardate-actual-goods,
       48                                 vardate-actual-docs).
       49   end.
       50   output stream str-gen close.
       51   return "Произведен экспорт таблиц по группам прав: .".
       52   end.
