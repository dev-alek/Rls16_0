        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00240000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00240000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 240.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-schet-fact-doc                for src.schet-fact-doc                  .
       13   define buffer old-schet-fact-line               for src.schet-fact-line                 .
       14   define buffer old-schet-fact-doc-attr           for src.schet-fact-doc-attr             .
       15   define buffer old-schet-fact-line-attr          for src.schet-fact-line-attr            .
       16   define buffer old-factur-connect                for src.factur-connect                  .
       17   define buffer old-factur-connect-attr           for src.factur-connect-attr             .
       18   define buffer old-factur-connect-line        for src.factur-connect-line          .
       19   define buffer old-factur-connect-line-attr   for src.factur-connect-line-attr     .
       20   define buffer old-c-schet-fact-doc             for src.c-schet-fact-doc              .
       21   define buffer old-c-schet-fact-line            for src.c-schet-fact-line             .
       22   define buffer new-schet-fact-doc               for dst.schet-fact-doc                .
       23   define buffer new-schet-fact-line              for dst.schet-fact-line               .
       24   define buffer new-schet-fact-doc-attr          for dst.schet-fact-doc-attr              .
       25   define buffer new-schet-fact-line-attr         for dst.schet-fact-line-attr               .
       26   define buffer new-factur-connect               for dst.factur-connect                .
       27   define buffer new-factur-connect-attr          for dst.factur-connect-attr           .
       28   define buffer new-factur-connect-line       for dst.factur-connect-line        .
       29   define buffer new-factur-connect-line-attr  for dst.factur-connect-line-attr   .
       30   define buffer new-c-schet-fact-doc             for dst.c-schet-fact-doc              .
       31   define buffer new-c-schet-fact-line            for dst.c-schet-fact-line             .
       32   define buffer new-goods for dst.goods  .
       33   define buffer buf_clients     for dst.clients.
       34   do
       35   on error undo, return error
       36   :
       37   define input parameter vartype-cut            as integer   no-undo.
       38   define input parameter varlist-db             as character no-undo.
       39   define input parameter vardate-actual-goods   as date      no-undo.
       40   define input parameter vardate-actual-docs    as date      no-undo.
       41   define input parameter vardate-actual-findoc  as date      no-undo.
       42   define input parameter vardate-output-zone    as date      no-undo.
       43   define input parameter varstay-recipe-goods   as logical   no-undo.
       44   define input parameter varstay-weight-goods   as logical   no-undo.
       45   define input parameter varnot-copy-del-goods  as logical   no-undo.
       46   define input parameter varstay-history        as logical   no-undo.
       47   define input parameter vargen-file            as character no-undo.
       48   define stream str-gen.
       49   output stream str-gen to vargen-file append.
       50   if not connected("src") then do:
       51      return error "Нет коннекта с базой 'src'.".
       52   end.
       53   if not connected("dst") then do:
       54      return error "Нет коннекта с базой 'dst'.".
       55   end.
       56   find src.sys-ctrl no-lock.
       57   if not available src.sys-ctrl then do:
       58      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       59   end.
       60   if src.sys-ctrl.db-num <> 0 then do:
       61      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       62   end.
       63   if vardate-actual-docs <> ? and
       64      (vardate-actual-goods   > vardate-actual-docs or
       65       vardate-actual-goods   = ? )   then do:
       66         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       67                                 "Дата актуальности товаров &1."        +
       68                                 "Дата актуальности документов &2."     +
       69                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       70                                 vardate-actual-goods,
       71                                 vardate-actual-docs).
       72   end.
       73   define  shared temp-table tt-objs no-undo
       74     field obj-type as character
       75     field obj-code as integer
       76     index pi is unique primary obj-type obj-code
       77     .
       78     on WRITE of dst.schet-fact-doc               override do: end.
       79     on WRITE of dst.schet-fact-line              override do: end.
       80     on WRITE of dst.factur-connect               override do: end.
       81     on WRITE of dst.factur-connect-attr          override do: end.
       82     on WRITE of dst.factur-connect-line          override do: end.
       83     on WRITE of dst.factur-connect-line-attr     override do: end.
       84     on WRITE of dst.c-schet-fact-doc             override do: end.
       85     on WRITE of dst.c-schet-fact-line            override do: end.
       86   for each old-factur-connect  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       87      create new-factur-connect.
       88      buffer-copy old-factur-connect to new-factur-connect.
       89   end.
       90   for each old-factur-connect-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       91      create new-factur-connect-attr.
       92      buffer-copy old-factur-connect-attr to new-factur-connect-attr.
       93   end.
       94   for each old-factur-connect-line  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       95      create new-factur-connect-line.
       96      buffer-copy old-factur-connect-line to new-factur-connect-line.
       97   end.
       98   for each old-factur-connect-line-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       99      create new-factur-connect-line-attr.
      100      buffer-copy old-factur-connect-line-attr to new-factur-connect-line-attr.
      101   end.
      102   if vardate-actual-docs <> ? then do:
      103       for each buf_clients no-lock  where
      104                buf_clients.db-num <> ?
      105       on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      106         :
      107         if vartype-cut = 1 then do:
      108             find first tt-objs where tt-objs.obj-type = buf_clients.obj-type and
      109                                      tt-objs.obj-code = buf_clients.obj-code no-error.
      110         end.
      111         if vartype-cut = 0      or
      112             (vartype-cut = 1 and available tt-objs) then do:
      113           if buf_clients.obj-type  = 'маг':U OR buf_clients.obj-type  = 'скл':U then DO:
      114             for each old-schet-fact-doc where old-schet-fact-doc.obj-type   = buf_clients.obj-type             and
      115                       old-schet-fact-doc.obj-code   = buf_clients.obj-CODE and
      116                       old-schet-fact-doc.fact-date >= vardate-actual-docs no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      117                RUN proc-copy ( old-schet-fact-doc.doc-code , old-schet-fact-doc.db-num ) no-error .
      118                IF error-status :error THEN return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
      119             END.
      120           end.
      121         end.
      122         else do:
      123           if buf_clients.obj-type  = 'маг':U OR buf_clients.obj-type  = 'скл':U then DO:
      124               for each old-schet-fact-doc where
      125                        old-schet-fact-doc.obj-type   = buf_clients.obj-type             and
      126                        old-schet-fact-doc.obj-code   = buf_clients.obj-CODE
      127                      no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      128                        RUN proc-copy ( old-schet-fact-doc.doc-code , old-schet-fact-doc.db-num) no-error .
      129                        IF error-status :error THEN return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
      130               end.
      131           END.
      132         END.
      133      end.
      134   end.
      135   output stream str-gen close.
      136   return "Произведен экспорт таблиц: ~
      137           schet-fact-doc schet-fact-line factur-connect factur-connect-attr factur-connect-line factur-connect-line-attr c-schet-fact-doc c-schet-fact-line ".
      138   end.
      139   procedure proc-copy :
      140   define input  parameter p-doc-code as character no-undo .
      141   define input  parameter p-db-num  as integer   no-undo .
      142     do
      143     on error undo, return error return-value
      144     :
      145   for each old-schet-fact-doc  where old-schet-fact-doc.doc-code       = p-doc-code and old-schet-fact-doc.db-num       = p-db-num  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      146      create new-schet-fact-doc.
      147      buffer-copy old-schet-fact-doc to new-schet-fact-doc.
      148   end.
      149   for each old-schet-fact-doc-attr  where old-schet-fact-doc-attr.doc-code  = p-doc-code and old-schet-fact-doc-attr.db-num  = p-db-num  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      150      create new-schet-fact-doc-attr.
      151      buffer-copy old-schet-fact-doc-attr to new-schet-fact-doc-attr.
      152   end.
      153   for each old-schet-fact-line  where old-schet-fact-line.doc-code      = p-doc-code and old-schet-fact-line.db-num      = p-db-num  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      154      create new-schet-fact-line.
      155      buffer-copy old-schet-fact-line to new-schet-fact-line.
      156   end.
      157   for each old-schet-fact-line-attr  where old-schet-fact-line-attr.doc-code = p-doc-code and old-schet-fact-line-attr.db-num = p-db-num  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      158      create new-schet-fact-line-attr.
      159      buffer-copy old-schet-fact-line-attr to new-schet-fact-line-attr.
      160   end.
      161   for each old-factur-connect  where
      162            old-factur-connect.factur-doc-code = p-doc-code and
      163            old-factur-connect.db-num      = p-db-num  no-lock on error undo,
      164            return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      165      create new-factur-connect.
      166      buffer-copy old-factur-connect to new-factur-connect.
      167         for each old-factur-connect-attr  where
      168                  old-factur-connect-attr.connect-code = old-factur-connect.connect-code and
      169                  old-factur-connect-attr.db-num      =  old-factur-connect.db-num  no-lock on error undo,
      170                 return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      171           create new-factur-connect-attr.
      172           buffer-copy old-factur-connect-attr to new-factur-connect-attr.
      173         end.
      174         for each old-factur-connect-line  where
      175                  old-factur-connect-line.connect-code = old-factur-connect.connect-code and
      176                  old-factur-connect-line.db-num      =  old-factur-connect.db-num  no-lock on error undo,
      177                 return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      178           create new-factur-connect-line.
      179           buffer-copy old-factur-connect-line to new-factur-connect-line.
      180         end.
      181         for each old-factur-connect-line-attr  where
      182                  old-factur-connect-line-attr.connect-code = old-factur-connect.connect-code and
      183                  old-factur-connect-line-attr.db-num      =  old-factur-connect.db-num  no-lock on error undo,
      184                 return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      185           create new-factur-connect-line-attr.
      186           buffer-copy old-factur-connect-line-attr to new-factur-connect-line-attr.
      187         end.
      188   end.
      189     if varstay-history = yes then do:
      190   for each old-c-schet-fact-doc  where old-c-schet-fact-doc.doc-code = p-doc-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      191      create new-c-schet-fact-doc.
      192      buffer-copy old-c-schet-fact-doc to new-c-schet-fact-doc.
      193   end.
      194   for each old-c-schet-fact-line  where old-c-schet-fact-line.doc-code = p-doc-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      195      create new-c-schet-fact-line.
      196      buffer-copy old-c-schet-fact-line to new-c-schet-fact-line.
      197   end.
      198     end.
      199   end.
      200   end procedure.
