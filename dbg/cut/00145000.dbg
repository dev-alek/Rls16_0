        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00145000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00145000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 145.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12       define variable v-moved-recipe as logical no-undo.
       13       define buffer old-recipe            for src.recipe    .
       14       define buffer new-recipe            for dst.recipe    .
       15       define buffer old-recipe-gds        for src.recipe-gds.
       16       define buffer new-recipe-gds        for dst.recipe-gds.
       17       define buffer old-s-coeff           for src.s-coeff.
       18       define buffer new-s-coeff           for dst.s-coeff.
       19       define buffer old-c-s-coeff         for src.c-s-coeff.
       20       define buffer new-c-s-coeff         for dst.c-s-coeff.
       21       define buffer old-s-coeff-attr      for src.s-coeff-attr.
       22       define buffer new-s-coeff-attr      for dst.s-coeff-attr.
       23       define buffer old-fbr-gds-grp       for src.fbr-gds-grp.
       24       define buffer new-fbr-gds-grp       for dst.fbr-gds-grp.
       25       define buffer old-c-fbr-gds-grp     for src.c-fbr-gds-grp.
       26       define buffer new-c-fbr-gds-grp     for dst.c-fbr-gds-grp.
       27       define buffer old-fbr-gds-grp-attr  for src.fbr-gds-grp-attr.
       28       define buffer new-fbr-gds-grp-attr  for dst.fbr-gds-grp-attr.
       29       define buffer old-c-fbr-gds-grp-attr for src.c-fbr-gds-grp-attr.
       30       define buffer new-c-fbr-gds-grp-attr for dst.c-fbr-gds-grp-attr.
       31       define buffer old-c-fbr-gds-grp-hist for src.c-fbr-gds-grp-hist.
       32       define buffer new-c-fbr-gds-grp-hist for dst.c-fbr-gds-grp-hist.
       33       define buffer old-dish-grp          for src.dish-grp.
       34       define buffer new-dish-grp          for dst.dish-grp.
       35       define buffer old-dish-grp-attr     for src.dish-grp-attr.
       36       define buffer new-dish-grp-attr     for dst.dish-grp-attr.
       37       define buffer old-fbr-prn           for src.fbr-prn.
       38       define buffer new-fbr-prn           for dst.fbr-prn.
       39       define buffer old-c-fbr-prn         for src.c-fbr-prn.
       40       define buffer new-c-fbr-prn         for dst.c-fbr-prn.
       41       define buffer old-fbr-prn-attr      for src.fbr-prn-attr.
       42       define buffer new-fbr-prn-attr      for dst.fbr-prn-attr.
       43       define buffer old-fbr-prn-gds       for src.fbr-prn-gds.
       44       define buffer new-fbr-prn-gds       for dst.fbr-prn-gds.
       45       define buffer old-c-fbr-prn-gds     for src.c-fbr-prn-gds.
       46       define buffer new-c-fbr-prn-gds     for dst.c-fbr-prn-gds.
       47       define buffer old-fbr-prn-gds-attr  for src.fbr-prn-gds-attr.
       48       define buffer new-fbr-prn-gds-attr  for dst.fbr-prn-gds-attr.
       49       define buffer old-fbr-prn-grp       for src.fbr-prn-grp.
       50       define buffer new-fbr-prn-grp       for dst.fbr-prn-grp.
       51       define buffer old-c-fbr-prn-grp     for src.c-fbr-prn-grp.
       52       define buffer new-c-fbr-prn-grp     for dst.c-fbr-prn-grp.
       53       define buffer old-fbr-prn-grp-attr  for src.fbr-prn-grp-attr.
       54       define buffer new-fbr-prn-grp-attr  for dst.fbr-prn-grp-attr.
       55       define buffer new-goods             for dst.goods.
       56       define buffer new-rcp_goods         for dst.goods.
       57       define buffer old-recipe-develop    for src.recipe-develop.
       58       define buffer new-recipe-develop    for dst.recipe-develop.
       59       define buffer old-c-recipe         for src.c-recipe        .
       60       define buffer old-c-recipe-develop for src.c-recipe-develop.
       61       define buffer old-c-recipe-gds     for src.c-recipe-gds    .
       62       define buffer old-c-recipe-hist    for src.c-recipe-hist   .
       63       define buffer new-c-recipe         for dst.c-recipe        .
       64       define buffer new-c-recipe-develop for dst.c-recipe-develop.
       65       define buffer new-c-recipe-gds     for dst.c-recipe-gds    .
       66       define buffer new-c-recipe-hist    for dst.c-recipe-hist   .
       67   do
       68   on error undo, return error SUBSTITUTE( "&1 &2 &3", return-value, error-status:get-message( 1 ), error-status:get-message( 2 ) )
       69   :
       70   define input parameter vartype-cut            as integer   no-undo.
       71   define input parameter varlist-db             as character no-undo.
       72   define input parameter vardate-actual-goods   as date      no-undo.
       73   define input parameter vardate-actual-docs    as date      no-undo.
       74   define input parameter vardate-actual-findoc  as date      no-undo.
       75   define input parameter vardate-output-zone    as date      no-undo.
       76   define input parameter varstay-recipe-goods   as logical   no-undo.
       77   define input parameter varstay-weight-goods   as logical   no-undo.
       78   define input parameter varnot-copy-del-goods  as logical   no-undo.
       79   define input parameter varstay-history        as logical   no-undo.
       80   define input parameter vargen-file            as character no-undo.
       81   define stream str-gen.
       82   output stream str-gen to vargen-file append.
       83   if not connected("src") then do:
       84      return error "Нет коннекта с базой 'src'.".
       85   end.
       86   if not connected("dst") then do:
       87      return error "Нет коннекта с базой 'dst'.".
       88   end.
       89   find src.sys-ctrl no-lock.
       90   if not available src.sys-ctrl then do:
       91      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       92   end.
       93   if src.sys-ctrl.db-num <> 0 then do:
       94      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       95   end.
       96   if vardate-actual-docs <> ? and
       97      (vardate-actual-goods   > vardate-actual-docs or
       98       vardate-actual-goods   = ? )   then do:
       99         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      100                                 "Дата актуальности товаров &1."        +
      101                                 "Дата актуальности документов &2."     +
      102                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      103                                 vardate-actual-goods,
      104                                 vardate-actual-docs).
      105   end.
      106   on WRITE of dst.recipe               override do: end.
      107   on WRITE of dst.recipe-gds           override do: end.
      108   on WRITE of dst.s-coeff              override do: end.
      109   on WRITE of dst.s-coeff-attr         override do: end.
      110   on WRITE of dst.c-s-coeff            override do: end.
      111   on WRITE of dst.fbr-gds-grp          override do: end.
      112   on WRITE of dst.c-fbr-gds-grp        override do: end.
      113   on WRITE of dst.fbr-gds-grp-attr     override do: end.
      114   on WRITE of dst.c-fbr-gds-grp-attr   override do: end.
      115   on WRITE of dst.c-fbr-gds-grp-hist    override do: end.
      116   on WRITE of dst.dish-grp              override do: end.
      117   on WRITE of dst.dish-grp-attr         override do: end.
      118   on WRITE of dst.fbr-prn               override do: end.
      119   on WRITE of dst.c-fbr-prn             override do: end.
      120   on WRITE of dst.fbr-prn-attr          override do: end.
      121   on WRITE of dst.fbr-prn-gds           override do: end.
      122   on WRITE of dst.fbr-prn-gds-attr      override do: end.
      123   on WRITE of dst.c-fbr-prn-gds         override do: end.
      124   on WRITE of dst.fbr-prn-grp           override do: end.
      125   on WRITE of dst.fbr-prn-grp-attr      override do: end.
      126   on WRITE of dst.recipe-develop        override do: end.
      127   on WRITE of dst.c-recipe              override do: end.
      128   on WRITE of dst.c-recipe-develop      override do: end.
      129   on WRITE of dst.c-recipe-gds          override do: end.
      130   on WRITE of dst.c-recipe-hist         override do: end.
      131   for each old-dish-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      132      create new-dish-grp.
      133      buffer-copy old-dish-grp to new-dish-grp.
      134   end.
      135   for each old-dish-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      136      create new-dish-grp-attr.
      137      buffer-copy old-dish-grp-attr to new-dish-grp-attr.
      138   end.
      139   for each old-recipe-develop  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      140      create new-recipe-develop.
      141      buffer-copy old-recipe-develop to new-recipe-develop.
      142   end.
      143      if varstay-history then
      144       for each old-c-recipe no-lock
      145       on error undo, return error
      146       :
      147           find first new-goods
      148                where new-goods.artic     = old-c-recipe.artic
      149                  and new-goods.prod-type = old-c-recipe.prod-type
      150                  and new-goods.prod-code = old-c-recipe.prod-code
      151            no-lock
      152           no-error
      153           .
      154           if available new-goods
      155           then do:
      156             create new-c-recipe.
      157             buffer-copy old-c-recipe to new-c-recipe.
      158           end.
      159      end.
      160      if varstay-history then
      161       for each old-c-recipe-develop no-lock
      162       on error undo, return error
      163       :
      164           find first new-goods no-lock
      165                where new-goods.gds-code     = old-c-recipe-develop.gds-code
      166           no-error.
      167           if available new-goods
      168           then do:
      169             create new-c-recipe-develop.
      170             buffer-copy old-c-recipe-develop to new-c-recipe-develop.
      171           end.
      172      end.
      173      if varstay-history then
      174       for each old-c-recipe-gds no-lock
      175       on error undo, return error
      176       :
      177           find first new-goods no-lock
      178                where new-goods.gds-code     = old-c-recipe-gds.gds-code
      179           no-error.
      180           if available new-goods
      181           then do:
      182             create new-c-recipe-gds.
      183             buffer-copy old-c-recipe-gds to new-c-recipe-gds.
      184           end.
      185      end.
      186      if varstay-history then
      187       for each old-c-recipe-hist no-lock
      188       on error undo, return error
      189       :
      190           find first new-goods no-lock
      191                where new-goods.gds-code     = old-c-recipe-hist.gds-code
      192           no-error.
      193           if available new-goods
      194           then do:
      195             create new-c-recipe-hist.
      196             buffer-copy old-c-recipe-hist to new-c-recipe-hist.
      197           end.
      198      end.
      199   for each old-fbr-prn  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      200      create new-fbr-prn.
      201      buffer-copy old-fbr-prn to new-fbr-prn.
      202   end.
      203       if varstay-history then do:
      204   for each old-c-fbr-prn  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      205      create new-c-fbr-prn.
      206      buffer-copy old-c-fbr-prn to new-c-fbr-prn.
      207   end.
      208       end.
      209   for each old-fbr-prn-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      210      create new-fbr-prn-grp.
      211      buffer-copy old-fbr-prn-grp to new-fbr-prn-grp.
      212   end.
      213       if varstay-history then do:
      214   for each old-c-fbr-prn-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      215      create new-c-fbr-prn-grp.
      216      buffer-copy old-c-fbr-prn-grp to new-c-fbr-prn-grp.
      217   end.
      218       end.
      219   for each old-fbr-gds-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      220      create new-fbr-gds-grp.
      221      buffer-copy old-fbr-gds-grp to new-fbr-gds-grp.
      222   end.
      223       if varstay-history then do:
      224   for each old-c-fbr-gds-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      225      create new-c-fbr-gds-grp.
      226      buffer-copy old-c-fbr-gds-grp to new-c-fbr-gds-grp.
      227   end.
      228       end.
      229   for each old-fbr-gds-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      230      create new-fbr-gds-grp-attr.
      231      buffer-copy old-fbr-gds-grp-attr to new-fbr-gds-grp-attr.
      232   end.
      233       if varstay-history then do:
      234   for each old-c-fbr-gds-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      235      create new-c-fbr-gds-grp-attr.
      236      buffer-copy old-c-fbr-gds-grp-attr to new-c-fbr-gds-grp-attr.
      237   end.
      238   for each old-c-fbr-gds-grp-hist  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      239      create new-c-fbr-gds-grp-hist.
      240      buffer-copy old-c-fbr-gds-grp-hist to new-c-fbr-gds-grp-hist.
      241   end.
      242       end.
      243       for each old-fbr-prn-gds no-lock
      244       on error undo, return error
      245       :
      246           find first new-goods no-lock
      247                where new-goods.gds-code     = old-fbr-prn-gds.gds-code
      248           no-error.
      249           if available new-goods
      250           then do:
      251             create new-fbr-prn-gds.
      252             buffer-copy old-fbr-prn-gds to new-fbr-prn-gds.
      253           end.
      254       end.
      255       if varstay-history then do:
      256         for each old-c-fbr-prn-gds no-lock
      257         on error undo, return error
      258         :
      259             find first new-goods no-lock
      260                 where new-goods.gds-code     = old-c-fbr-prn-gds.gds-code
      261             no-error.
      262             if available new-goods
      263             then do:
      264               create new-c-fbr-prn-gds.
      265               buffer-copy old-c-fbr-prn-gds to new-c-fbr-prn-gds.
      266             end.
      267         end.
      268       end.
      269       for each old-fbr-prn-gds-attr no-lock
      270       on error undo, return error
      271       :
      272           find first new-goods no-lock
      273                where new-goods.gds-code     = old-fbr-prn-gds-attr.gds-code
      274           no-error.
      275           if available new-goods
      276           then do:
      277             create new-fbr-prn-gds-attr.
      278             buffer-copy old-fbr-prn-gds-attr to new-fbr-prn-gds-attr.
      279           end.
      280       end.
      281       for each old-recipe no-lock
      282       on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      283       :
      284           find first new-goods no-lock
      285                where new-goods.artic     = old-recipe.artic
      286                  and new-goods.prod-type = old-recipe.prod-type
      287                  and new-goods.prod-code = old-recipe.prod-code
      288           no-error.
      289           if available new-goods
      290           then do:
      291               assign
      292                   v-moved-recipe = yes
      293               .
      294               for each old-recipe-gds no-lock
      295               where old-recipe-gds.recipe-code = old-recipe.recipe-code
      296               on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      297               :
      298                   find first new-rcp_goods no-lock
      299                        where new-rcp_goods.artic     = old-recipe-gds.artic
      300                          and new-rcp_goods.prod-type = old-recipe-gds.prod-type
      301                          and new-rcp_goods.prod-code = old-recipe-gds.prod-code
      302                   no-error.
      303                   if not available new-rcp_goods
      304                   then do:
      305                       assign
      306                           v-moved-recipe = no
      307                       .
      308                       leave.
      309                   end.
      310               end.
      311               if v-moved-recipe = yes
      312               then do:
      313                   create new-recipe.
      314                   buffer-copy old-recipe to new-recipe.
      315                   for each old-recipe-gds no-lock
      316                      where old-recipe-gds.recipe-code = old-recipe.recipe-code
      317                   :
      318                       create new-recipe-gds.
      319                       buffer-copy old-recipe-gds to new-recipe-gds.
      320                   end.
      321               end.
      322           end.
      323       end.
      324       for each old-s-coeff no-lock
      325       on error undo, return error
      326       :
      327           find first new-goods no-lock
      328                where new-goods.gds-code     = old-s-coeff.gds-code
      329           no-error.
      330           if available new-goods
      331           then do:
      332               create new-s-coeff.
      333               buffer-copy old-s-coeff to new-s-coeff.
      334           end.
      335       end.
      336       if varstay-history then do:
      337         for each old-c-s-coeff no-lock
      338         on error undo, return error
      339         :
      340             find first new-goods no-lock
      341                 where new-goods.gds-code     = old-c-s-coeff.gds-code
      342             no-error.
      343             if available new-goods
      344             then do:
      345                 create new-c-s-coeff.
      346                 buffer-copy old-c-s-coeff to new-c-s-coeff.
      347             end.
      348         end.
      349       end.
      350       for each old-s-coeff-attr no-lock
      351       on error undo, return error
      352       :
      353           find first new-goods no-lock
      354                where new-goods.gds-code     = old-s-coeff-attr.gds-code
      355           no-error.
      356           if available new-goods
      357           then do:
      358               create new-s-coeff-attr.
      359               buffer-copy old-s-coeff-attr to new-s-coeff-attr.
      360           end.
      361       end.
      362       output stream str-gen close.
      363       return "Произведен экспорт таблиц: ~
      364   recipe recipe-gds s-coeff c-s-coeff s-coeff-attr ~
      365   fbr-gds-grp c-fbr-gds-grp fbr-gds-grp-attr c-fbr-gds-grp-attr c-fbr-gds-grp-hist dish-grp dish-grp-attr recipe-develop ~
      366   fbr-prn c-fbr-prn fbr-prn-attr fbr-prn-attr fbr-prn-gds c-fbr-prn-gds fbr-prn-gds-attr fbr-prn-grp c-fbr-prn-grp fbr-prn-grp-attr ~
      367   c-recipe ~
      368   c-recipe-develop ~
      369   c-recipe-gds ~
      370   c-recipe-hist ~
      371   .".
      372   end.
