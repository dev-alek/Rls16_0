        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00995000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00995000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 995.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-some-lk for src.some-lk.
       13   define buffer new-some-lk for dst.some-lk.
       14   define buffer old-some-lk-attr for src.some-lk-attr.
       15   define buffer new-some-lk-attr for dst.some-lk-attr.
       16   define buffer old-who-lk for src.who-lk.
       17   define buffer new-who-lk for dst.who-lk.
       18   define buffer old-who-lk-attr for src.who-lk-attr.
       19   define buffer new-who-lk-attr for dst.who-lk-attr.
       20   do
       21   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       22   define input parameter vartype-cut            as integer   no-undo.
       23   define input parameter varlist-db             as character no-undo.
       24   define input parameter vardate-actual-goods   as date      no-undo.
       25   define input parameter vardate-actual-docs    as date      no-undo.
       26   define input parameter vardate-actual-findoc  as date      no-undo.
       27   define input parameter vardate-output-zone    as date      no-undo.
       28   define input parameter varstay-recipe-goods   as logical   no-undo.
       29   define input parameter varstay-weight-goods   as logical   no-undo.
       30   define input parameter varnot-copy-del-goods  as logical   no-undo.
       31   define input parameter varstay-history        as logical   no-undo.
       32   define input parameter vargen-file            as character no-undo.
       33   define stream str-gen.
       34   output stream str-gen to vargen-file append.
       35   if not connected("src") then do:
       36      return error "Нет коннекта с базой 'src'.".
       37   end.
       38   if not connected("dst") then do:
       39      return error "Нет коннекта с базой 'dst'.".
       40   end.
       41   find src.sys-ctrl no-lock.
       42   if not available src.sys-ctrl then do:
       43      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       44   end.
       45   if src.sys-ctrl.db-num <> 0 then do:
       46      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       47   end.
       48   if vardate-actual-docs <> ? and
       49      (vardate-actual-goods   > vardate-actual-docs or
       50       vardate-actual-goods   = ? )   then do:
       51         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       52                                 "Дата актуальности товаров &1."        +
       53                                 "Дата актуальности документов &2."     +
       54                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       55                                 vardate-actual-goods,
       56                                 vardate-actual-docs).
       57   end.
       58   on WRITE of dst.some-lk override do: end.
       59   on WRITE of dst.some-lk-attr override do: end.
       60   on WRITE of dst.who-lk override do: end.
       61   on WRITE of dst.who-lk-attr override do: end.
       62   for each old-some-lk  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       63      create new-some-lk.
       64      buffer-copy old-some-lk to new-some-lk.
       65   end.
       66   for each old-some-lk-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       67      create new-some-lk-attr.
       68      buffer-copy old-some-lk-attr to new-some-lk-attr.
       69   end.
       70   for each old-who-lk  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       71      create new-who-lk.
       72      buffer-copy old-who-lk to new-who-lk.
       73   end.
       74   for each old-who-lk-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       75      create new-who-lk-attr.
       76      buffer-copy old-who-lk-attr to new-who-lk-attr.
       77   end.
       78   output stream str-gen close.
       79   return "Произведен экспорт таблиц: some-lk some-lk-attr who-lk who-lk-attr .".
       80   end.
