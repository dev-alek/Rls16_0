        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00105000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00105000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 105.".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define buffer old-prop-ref for src.prop-ref.
       63   define buffer new-prop-ref for dst.prop-ref.
       64   define buffer old-c-prop-ref for src.c-prop-ref.
       65   define buffer new-c-prop-ref for dst.c-prop-ref.
       66   define buffer old-prop-ref-attr for src.prop-ref-attr.
       67   define buffer new-prop-ref-attr for dst.prop-ref-attr.
       68   define buffer old-prop-ref-call for src.prop-ref-call.
       69   define buffer new-prop-ref-call for dst.prop-ref-call.
       70   define buffer old-prop-ref-call-attr for src.prop-ref-call-attr.
       71   define buffer new-prop-ref-call-attr for dst.prop-ref-call-attr.
       72   define buffer old-rp-by-call for src.rp-by-call.
       73   define buffer new-rp-by-call for dst.rp-by-call.
       74   define buffer old-c-rp-by-call for src.c-rp-by-call.
       75   define buffer new-c-rp-by-call for dst.c-rp-by-call.
       76   define buffer old-rp-by-call-attr for src.rp-by-call-attr.
       77   define buffer new-rp-by-call-attr for dst.rp-by-call-attr.
       78   define buffer old-rule-by-call for src.rule-by-call.
       79   define buffer new-rule-by-call for dst.rule-by-call.
       80   define buffer old-c-rule-by-call for src.c-rule-by-call.
       81   define buffer new-c-rule-by-call for dst.c-rule-by-call.
       82   define buffer old-rule-by-call-attr for src.rule-by-call-attr.
       83   define buffer new-rule-by-call-attr for dst.rule-by-call-attr.
       84   define buffer old-rule-call-param for src.rule-call-param.
       85   define buffer new-rule-call-param for dst.rule-call-param.
       86   define buffer old-c-rule-call-param for src.c-rule-call-param.
       87   define buffer new-c-rule-call-param for dst.c-rule-call-param.
       88   define buffer old-rule-call-param-attr for src.rule-call-param-attr.
       89   define buffer new-rule-call-param-attr for dst.rule-call-param-attr.
       90   define buffer old-rule-trans-memo for src.rule-trans-memo.
       91   define buffer new-rule-trans-memo for dst.rule-trans-memo.
       92   define buffer old-rule-trans-memo-attr for src.rule-trans-memo-attr.
       93   define buffer new-rule-trans-memo-attr for dst.rule-trans-memo-attr.
       94   do
       95   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       96   define input parameter vartype-cut            as integer   no-undo.
       97   define input parameter varlist-db             as character no-undo.
       98   define input parameter vardate-actual-goods   as date      no-undo.
       99   define input parameter vardate-actual-docs    as date      no-undo.
      100   define input parameter vardate-actual-findoc  as date      no-undo.
      101   define input parameter vardate-output-zone    as date      no-undo.
      102   define input parameter varstay-recipe-goods   as logical   no-undo.
      103   define input parameter varstay-weight-goods   as logical   no-undo.
      104   define input parameter varnot-copy-del-goods  as logical   no-undo.
      105   define input parameter varstay-history        as logical   no-undo.
      106   define input parameter vargen-file            as character no-undo.
      107   define stream str-gen.
      108   output stream str-gen to vargen-file append.
      109   if not connected("src") then do:
      110      return error "Нет коннекта с базой 'src'.".
      111   end.
      112   if not connected("dst") then do:
      113      return error "Нет коннекта с базой 'dst'.".
      114   end.
      115   find src.sys-ctrl no-lock.
      116   if not available src.sys-ctrl then do:
      117      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      118   end.
      119   if src.sys-ctrl.db-num <> 0 then do:
      120      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      121   end.
      122   if vardate-actual-docs <> ? and
      123      (vardate-actual-goods   > vardate-actual-docs or
      124       vardate-actual-goods   = ? )   then do:
      125         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      126                                 "Дата актуальности товаров &1."        +
      127                                 "Дата актуальности документов &2."     +
      128                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      129                                 vardate-actual-goods,
      130                                 vardate-actual-docs).
      131   end.
      132   on WRITE of dst.prop-ref override do: end.
      133   on WRITE of dst.c-prop-ref override do: end.
      134   on WRITE of dst.prop-ref-attr override do: end.
      135   on WRITE of dst.prop-ref-call override do: end.
      136   on WRITE of dst.prop-ref-call-attr override do: end.
      137   on WRITE of dst.rp-by-call override do: end.
      138   on WRITE of dst.c-rp-by-call override do: end.
      139   on WRITE of dst.rp-by-call-attr override do: end.
      140   on WRITE of dst.rule-by-call override do: end.
      141   on WRITE of dst.c-rule-by-call override do: end.
      142   on WRITE of dst.rule-by-call-attr override do: end.
      143   on WRITE of dst.rule-call-param override do: end.
      144   on WRITE of dst.c-rule-call-param override do: end.
      145   on WRITE of dst.rule-call-param-attr override do: end.
      146   on WRITE of dst.rule-trans-memo override do: end.
      147   on WRITE of dst.rule-trans-memo-attr override do: end.
      148   for each old-prop-ref  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      149      create new-prop-ref.
      150      buffer-copy old-prop-ref to new-prop-ref.
      151   end.
      152   if varstay-history then do:
      153   for each old-c-prop-ref  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      154      create new-c-prop-ref.
      155      buffer-copy old-c-prop-ref to new-c-prop-ref.
      156   end.
      157   end.
      158   for each old-prop-ref-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      159      create new-prop-ref-attr.
      160      buffer-copy old-prop-ref-attr to new-prop-ref-attr.
      161   end.
      162   for each old-prop-ref-call  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      163      create new-prop-ref-call.
      164      buffer-copy old-prop-ref-call to new-prop-ref-call.
      165   end.
      166   for each old-prop-ref-call-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      167      create new-prop-ref-call-attr.
      168      buffer-copy old-prop-ref-call-attr to new-prop-ref-call-attr.
      169   end.
      170   for each old-rp-by-call  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      171      create new-rp-by-call.
      172      buffer-copy old-rp-by-call to new-rp-by-call.
      173   end.
      174   if varstay-history then do:
      175   for each old-c-rp-by-call  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      176      create new-c-rp-by-call.
      177      buffer-copy old-c-rp-by-call to new-c-rp-by-call.
      178   end.
      179   end.
      180   for each old-rp-by-call-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      181      create new-rp-by-call-attr.
      182      buffer-copy old-rp-by-call-attr to new-rp-by-call-attr.
      183   end.
      184   for each old-rule-by-call  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      185      create new-rule-by-call.
      186      buffer-copy old-rule-by-call to new-rule-by-call.
      187   end.
      188   if varstay-history then do:
      189   for each old-c-rule-by-call  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      190      create new-c-rule-by-call.
      191      buffer-copy old-c-rule-by-call to new-c-rule-by-call.
      192   end.
      193   end.
      194   for each old-rule-by-call-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      195      create new-rule-by-call-attr.
      196      buffer-copy old-rule-by-call-attr to new-rule-by-call-attr.
      197   end.
      198   for each old-rule-call-param  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      199      create new-rule-call-param.
      200      buffer-copy old-rule-call-param to new-rule-call-param.
      201   end.
      202   if varstay-history then do:
      203   for each old-c-rule-call-param  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      204      create new-c-rule-call-param.
      205      buffer-copy old-c-rule-call-param to new-c-rule-call-param.
      206   end.
      207   end.
      208   for each old-rule-call-param-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      209      create new-rule-call-param-attr.
      210      buffer-copy old-rule-call-param-attr to new-rule-call-param-attr.
      211   end.
      212   for each old-rule-trans-memo  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      213      create new-rule-trans-memo.
      214      buffer-copy old-rule-trans-memo to new-rule-trans-memo.
      215   end.
      216   for each old-rule-trans-memo-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      217      create new-rule-trans-memo-attr.
      218      buffer-copy old-rule-trans-memo-attr to new-rule-trans-memo-attr.
      219   end.
      220   output stream str-gen close.
      221   return "Произведен экспорт таблиц: ~
      222   prop-ref c-prop-ref prop-ref-attr prop-ref-call prop-ref-call-attr rp-by-call c-rp-by-call rp-by-call-attr~
      223   rule-by-call c-rule-by-call rule-by-call-attr rule-call-param c-rule-call-param rule-call-param-attr rule-trans-memo rule-trans-memo-attr.".
      224   end.
