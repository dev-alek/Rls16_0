        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00198000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00198000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 198.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-nws-doc-hist for src.nws-doc-hist.
       13   define buffer new-nws-doc-hist for dst.nws-doc-hist.
       14   define buffer old-nws-doc-hist-attr for src.nws-doc-hist-attr.
       15   define buffer new-nws-doc-hist-attr for dst.nws-doc-hist-attr.
       16   define buffer new-trn-doc     for dst.trn-doc.
       17   define buffer new-rvs-doc     for dst.rvs-doc.
       18   define buffer new-price-doc   for dst.price-doc.
       19   define buffer new-fbr-doc     for dst.fbr-doc.
       20   define buffer new-wth-doc     for dst.wth-doc.
       21   define buffer new-icnt-doc    for dst.icnt-doc.
       22   define buffer new-inkas       for dst.inkas.
       23   define buffer new-ord-cons    for dst.ord-cons.
       24   define buffer new-ord-doc     for dst.ord-doc.
       25   define buffer new-ord-doc-rcv for dst.ord-doc-rcv.
       26   do
       27   on error undo, return error
       28   :
       29   define input parameter vartype-cut            as integer   no-undo.
       30   define input parameter varlist-db             as character no-undo.
       31   define input parameter vardate-actual-goods   as date      no-undo.
       32   define input parameter vardate-actual-docs    as date      no-undo.
       33   define input parameter vardate-actual-findoc  as date      no-undo.
       34   define input parameter vardate-output-zone    as date      no-undo.
       35   define input parameter varstay-recipe-goods   as logical   no-undo.
       36   define input parameter varstay-weight-goods   as logical   no-undo.
       37   define input parameter varnot-copy-del-goods  as logical   no-undo.
       38   define input parameter varstay-history        as logical   no-undo.
       39   define input parameter vargen-file            as character no-undo.
       40   define stream str-gen.
       41   output stream str-gen to vargen-file append.
       42   if not connected("src") then do:
       43      return error "Нет коннекта с базой 'src'.".
       44   end.
       45   if not connected("dst") then do:
       46      return error "Нет коннекта с базой 'dst'.".
       47   end.
       48   find src.sys-ctrl no-lock.
       49   if not available src.sys-ctrl then do:
       50      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       51   end.
       52   if src.sys-ctrl.db-num <> 0 then do:
       53      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       54   end.
       55   if vardate-actual-docs <> ? and
       56      (vardate-actual-goods   > vardate-actual-docs or
       57       vardate-actual-goods   = ? )   then do:
       58         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       59                                 "Дата актуальности товаров &1."        +
       60                                 "Дата актуальности документов &2."     +
       61                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       62                                 vardate-actual-goods,
       63                                 vardate-actual-docs).
       64   end.
       65     on write of dst.nws-doc-hist override do: end.
       66     on write of dst.nws-doc-hist-attr override do: end.
       67     define variable v-need-copy as logical   no-undo .
       68     for each old-nws-doc-hist no-lock
       69     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       70     :
       71       assign
       72         v-need-copy = false
       73       .
       74       case old-nws-doc-hist.doc-type
       75       :
       76         when 'trn-doc':u
       77         then do:
       78           find first new-trn-doc no-lock
       79             where new-trn-doc.doc-code = old-nws-doc-hist.doc-code
       80             no-error .
       81           if available new-trn-doc
       82           then do:
       83             assign
       84               v-need-copy = true
       85             .
       86           end.
       87         end.
       88         when 'rvs-doc':u
       89         then do:
       90           find first new-rvs-doc no-lock
       91             where new-rvs-doc.rvs-code = old-nws-doc-hist.doc-code
       92             no-error .
       93           if available new-rvs-doc
       94           then do:
       95             assign
       96               v-need-copy = true
       97             .
       98           end.
       99         end.
      100         when 'price-doc':u
      101         then do:
      102           find first new-price-doc no-lock
      103             where new-price-doc.doc-num = old-nws-doc-hist.doc-code
      104             no-error .
      105           if available new-price-doc
      106           then do:
      107             assign
      108               v-need-copy = true
      109             .
      110           end.
      111         end.
      112         when 'fbr-doc':u
      113         then do:
      114           find first new-fbr-doc no-lock
      115             where new-fbr-doc.doc-code = old-nws-doc-hist.doc-code
      116             no-error .
      117           if available new-fbr-doc
      118           then do:
      119             assign
      120               v-need-copy = true
      121             .
      122           end.
      123         end.
      124         when 'wth-doc':u
      125         then do:
      126           find first new-wth-doc no-lock
      127             where new-wth-doc.doc-code = old-nws-doc-hist.doc-code
      128             no-error .
      129           if available new-wth-doc
      130           then do:
      131             assign
      132               v-need-copy = true
      133             .
      134           end.
      135         end.
      136         when 'icnt-doc':u
      137         then do:
      138           find first new-icnt-doc no-lock
      139             where new-icnt-doc.doc-code = old-nws-doc-hist.doc-code
      140             no-error .
      141           if available new-icnt-doc
      142           then do:
      143             assign
      144               v-need-copy = true
      145             .
      146           end.
      147         end.
      148         when 'inkas':u
      149         then do:
      150           find first new-inkas no-lock
      151             where new-inkas.inkas-code = old-nws-doc-hist.doc-code
      152             no-error .
      153           if available new-inkas
      154           then do:
      155             assign
      156               v-need-copy = true
      157             .
      158           end.
      159         end.
      160         when 'ord-cons':u
      161         then do:
      162           find first new-ord-cons no-lock
      163             where new-ord-cons.cons-code = old-nws-doc-hist.doc-code
      164             no-error .
      165           if available new-ord-cons
      166           then do:
      167             assign
      168               v-need-copy = true
      169             .
      170           end.
      171         end.
      172         when 'ord-doc':u
      173         then do:
      174           find first new-ord-doc no-lock
      175             where new-ord-doc.doc-code = old-nws-doc-hist.doc-code
      176             no-error .
      177           if available new-ord-doc
      178           then do:
      179             assign
      180               v-need-copy = true
      181             .
      182           end.
      183         end.
      184         when 'ord-doc-rcv':u
      185         then do:
      186           find first new-ord-doc-rcv no-lock
      187             where new-ord-doc-rcv.rcv-code = old-nws-doc-hist.doc-code
      188             no-error .
      189           if available new-ord-doc-rcv
      190           then do:
      191             assign
      192               v-need-copy = true
      193             .
      194           end.
      195         end.
      196       end.
      197       if v-need-copy = true
      198       then do:
      199         create new-nws-doc-hist.
      200         buffer-copy old-nws-doc-hist to new-nws-doc-hist.
      201       end.
      202     end.
      203     for each old-nws-doc-hist-attr no-lock
      204     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      205     :
      206       find first new-nws-doc-hist no-lock where
      207                 new-nws-doc-hist.db-num = old-nws-doc-hist-attr.db-num
      208              and new-nws-doc-hist.ord-num = old-nws-doc-hist-attr.ord-num no-error.
      209       if available new-nws-doc-hist then do:
      210         create new-nws-doc-hist-attr.
      211         buffer-copy old-nws-doc-hist-attr to new-nws-doc-hist-attr.
      212       end.
      213     end.
      214     output stream str-gen close.
      215     return "Произведен экспорт таблиц: nws-doc-hist nws-doc-hist-attr .".
      216   end.
