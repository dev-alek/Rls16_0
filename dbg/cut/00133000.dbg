        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00133000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00133000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 133.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-pay-type for src.pay-type.
       13   define buffer new-pay-type for dst.pay-type.
       14   define buffer old-c-pay-type for src.c-pay-type.
       15   define buffer new-c-pay-type for dst.c-pay-type.
       16   define buffer old-pay-type-attr for src.pay-type-attr.
       17   define buffer new-pay-type-attr for dst.pay-type-attr.
       18   define buffer old-c-pay-type-attr for src.c-pay-type-attr.
       19   define buffer new-c-pay-type-attr for dst.c-pay-type-attr.
       20   define buffer old-trn-reason for src.trn-reason.
       21   define buffer new-trn-reason for dst.trn-reason.
       22   define buffer old-c-trn-reason for src.c-trn-reason.
       23   define buffer new-c-trn-reason for dst.c-trn-reason.
       24   define buffer old-trn-reason-host for src.trn-reason-host.
       25   define buffer new-trn-reason-host for dst.trn-reason-host.
       26   define buffer old-c-trn-reason-host for src.c-trn-reason-host.
       27   define buffer new-c-trn-reason-host for dst.c-trn-reason-host.
       28   define buffer old-trn-reason-obj for src.trn-reason-obj.
       29   define buffer new-trn-reason-obj for dst.trn-reason-obj.
       30   define buffer old-c-trn-reason-obj for src.c-trn-reason-obj.
       31   define buffer new-c-trn-reason-obj for dst.c-trn-reason-obj.
       32   define buffer old-trn-rsn-attr for src.trn-rsn-attr.
       33   define buffer new-trn-rsn-attr for dst.trn-rsn-attr.
       34   define buffer old-c-trn-rsn-attr for src.c-trn-rsn-attr.
       35   define buffer new-c-trn-rsn-attr for dst.c-trn-rsn-attr.
       36   do
       37   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       38   define input parameter vartype-cut            as integer   no-undo.
       39   define input parameter varlist-db             as character no-undo.
       40   define input parameter vardate-actual-goods   as date      no-undo.
       41   define input parameter vardate-actual-docs    as date      no-undo.
       42   define input parameter vardate-actual-findoc  as date      no-undo.
       43   define input parameter vardate-output-zone    as date      no-undo.
       44   define input parameter varstay-recipe-goods   as logical   no-undo.
       45   define input parameter varstay-weight-goods   as logical   no-undo.
       46   define input parameter varnot-copy-del-goods  as logical   no-undo.
       47   define input parameter varstay-history        as logical   no-undo.
       48   define input parameter vargen-file            as character no-undo.
       49   define stream str-gen.
       50   output stream str-gen to vargen-file append.
       51   if not connected("src") then do:
       52      return error "Нет коннекта с базой 'src'.".
       53   end.
       54   if not connected("dst") then do:
       55      return error "Нет коннекта с базой 'dst'.".
       56   end.
       57   find src.sys-ctrl no-lock.
       58   if not available src.sys-ctrl then do:
       59      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       60   end.
       61   if src.sys-ctrl.db-num <> 0 then do:
       62      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       63   end.
       64   if vardate-actual-docs <> ? and
       65      (vardate-actual-goods   > vardate-actual-docs or
       66       vardate-actual-goods   = ? )   then do:
       67         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       68                                 "Дата актуальности товаров &1."        +
       69                                 "Дата актуальности документов &2."     +
       70                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       71                                 vardate-actual-goods,
       72                                 vardate-actual-docs).
       73   end.
       74   on WRITE of dst.pay-type override do: end.
       75   on WRITE of dst.c-pay-type override do: end.
       76   on WRITE of dst.pay-type-attr override do: end.
       77   on WRITE of dst.c-pay-type-attr override do: end.
       78   on WRITE of dst.trn-reason override do: end.
       79   on WRITE of dst.c-trn-reason override do: end.
       80   on WRITE of dst.trn-reason-host override do: end.
       81   on WRITE of dst.c-trn-reason-host override do: end.
       82   on WRITE of dst.trn-reason-obj override do: end.
       83   on WRITE of dst.c-trn-reason-obj override do: end.
       84   on WRITE of dst.trn-reason override do: end.
       85   on WRITE of dst.c-trn-rsn-attr override do: end.
       86   on WRITE of dst.trn-rsn-attr override do: end.
       87   for each old-pay-type  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       88      create new-pay-type.
       89      buffer-copy old-pay-type to new-pay-type.
       90   end.
       91   if varstay-history then do:
       92   for each old-c-pay-type  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       93      create new-c-pay-type.
       94      buffer-copy old-c-pay-type to new-c-pay-type.
       95   end.
       96   end.
       97   for each old-pay-type-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       98      create new-pay-type-attr.
       99      buffer-copy old-pay-type-attr to new-pay-type-attr.
      100   end.
      101   if varstay-history then do:
      102   for each old-c-pay-type-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      103      create new-c-pay-type-attr.
      104      buffer-copy old-c-pay-type-attr to new-c-pay-type-attr.
      105   end.
      106   end.
      107   for each old-trn-reason  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      108      create new-trn-reason.
      109      buffer-copy old-trn-reason to new-trn-reason.
      110   end.
      111   if varstay-history then do:
      112   for each old-c-trn-reason  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      113      create new-c-trn-reason.
      114      buffer-copy old-c-trn-reason to new-c-trn-reason.
      115   end.
      116   end.
      117   for each old-trn-rsn-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      118      create new-trn-rsn-attr.
      119      buffer-copy old-trn-rsn-attr to new-trn-rsn-attr.
      120   end.
      121   if varstay-history then do:
      122   for each old-c-trn-rsn-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      123      create new-c-trn-rsn-attr.
      124      buffer-copy old-c-trn-rsn-attr to new-c-trn-rsn-attr.
      125   end.
      126   end.
      127   for each old-trn-reason-host  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      128      create new-trn-reason-host.
      129      buffer-copy old-trn-reason-host to new-trn-reason-host.
      130   end.
      131   if varstay-history then do:
      132   for each old-c-trn-reason-host  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      133      create new-c-trn-reason-host.
      134      buffer-copy old-c-trn-reason-host to new-c-trn-reason-host.
      135   end.
      136   end.
      137   for each old-trn-reason-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      138      create new-trn-reason-obj.
      139      buffer-copy old-trn-reason-obj to new-trn-reason-obj.
      140   end.
      141   if varstay-history then do:
      142   for each old-c-trn-reason-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      143      create new-c-trn-reason-obj.
      144      buffer-copy old-c-trn-reason-obj to new-c-trn-reason-obj.
      145   end.
      146   end.
      147   output stream str-gen close.
      148   return "Произведен экспорт таблиц: pay-type c-pay-type pay-type-attr c-pay-type-attr ~
      149   trn-reason c-trn-reason trn-rsn-attr c-trn-rsn-attr ~
      150   trn-reason-host c-trn-reason-host trn-reason-obj c-trn-reason-obj.".
      151   end.
