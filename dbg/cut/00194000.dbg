        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 36493b7e3299, 155, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Feb 17 18:03:53 2015 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00194000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00194000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 194.".
        8   define buffer old-c-wth-doc    for src.c-wth-doc.
        9   define buffer new-c-wth-doc    for dst.c-wth-doc.
       10   define buffer old-c-wth-line   for src.c-wth-line.
       11   define buffer new-c-wth-line   for dst.c-wth-line.
       12   define buffer old-c-wth-dtl    for src.c-wth-dtl.
       13   define buffer new-c-wth-dtl    for dst.c-wth-dtl.
       14   define buffer old-c-wth-parts   for src.c-wth-parts.
       15   define buffer new-c-wth-parts   for dst.c-wth-parts.
       16   define buffer new-shop         for dst.shop .
       17   define buffer new-store        for dst.store .
       18   define variable var-fact-order-docs as decimal no-undo .
       19   define variable v-host-code like src.sysconf.host-code no-undo .
       20   define stream LogStream.
       21   define new global shared variable g#language as character no-undo .
       22   if g#language <> '' and g#language <> 'rus':U then do:
       23     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       24   end.
       25   define new global shared variable g#library  as handle no-undo .
       26   define new global shared variable g#library2 as handle no-undo .
       27   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       28   procedure factord :
       29     define input  parameter p-fact-date            as date    no-undo .
       30     define input  parameter p-fact-time            as integer no-undo .
       31     define input  parameter p-fact-num             as integer no-undo .
       32     define input  parameter p-shift-date           as date    no-undo .
       33     define input  parameter p-shift-num            as integer no-undo .
       34     define input  parameter p-shift-on             as logical no-undo .
       35     define output parameter p-fact-order           as decimal no-undo .
       36     define output parameter p-shift-end-fact-order as decimal no-undo .
       37     define output parameter p-day-end-fact-order   as decimal no-undo .
       38     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       39     if p-fact-date = ?
       40     then do:
       41       return error "Не указана фактическая дата" .
       42     end.
       43     define variable v-fact-date-num as integer no-undo .
       44     assign
       45       v-fact-date-num = integer(p-fact-date)
       46     .
       47     if p-fact-num = ?
       48     or p-fact-num = 0
       49     then do:
       50       return error "Не задан p-fact-num " + string(p-fact-num) .
       51     end.
       52     if p-fact-num < 0
       53     then do:
       54       return error "Отрицательный fact-num " + string(p-fact-num) .
       55     end.
       56     if p-fact-num >= 100000000
       57     then do:
       58       return error "Недопустимо большой fact-num " + string(p-fact-num) .
       59     end.
       60     if p-shift-on = true
       61     then do:
       62       if p-shift-date = ?
       63       then do:
       64         return error "Не задана дата смены" .
       65       end.
       66       if p-shift-num = ?
       67       or p-shift-num = 0
       68       then do:
       69         return error "Не задан номер смены" .
       70       end.
       71     end.
       72     else do:
       73       assign
       74         p-shift-date = p-fact-date
       75         p-shift-num  = 24
       76       .
       77     end.
       78     define variable v-shift-offset as integer no-undo .
       79     if p-shift-date = p-fact-date
       80     then do:
       81       assign
       82         v-shift-offset = 1
       83       .
       84     end.
       85     if p-shift-date < p-fact-date
       86     then do:
       87       assign
       88         v-shift-offset = 0
       89       .
       90     end.
       91     if p-shift-date > p-fact-date
       92     then do:
       93       message
       94         vss-workfile vss-revision vss-description skip
       95         "Неправильная дата закрытия смены" skip
       96         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
       97         view-as alert-box error .
       98       undo, return error
       99         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      100           ,string(p-fact-date, '99/99/9999':U)
      101           ,string(p-shift-date, '99/99/9999':U)
      102           )
      103       .
      104     end.
      105     if p-shift-num < 1
      106     or p-shift-num > 24
      107     then do:
      108       message
      109         vss-workfile vss-revision vss-description skip
      110         "Неправильный номер смены" skip
      111         "p-shift-num" p-shift-num skip
      112         view-as alert-box error .
      113       undo, return error return-value .
      114     end.
      115     assign
      116       p-fact-order           = v-fact-date-num
      117                              + v-shift-offset * 0.5
      118                              + p-shift-num    * 0.02 - 0.01
      119                              + p-fact-num     * 0.0000000001
      120       p-shift-end-fact-order = v-fact-date-num
      121                              + v-shift-offset * 0.5
      122                              + p-shift-num    * 0.02
      123       p-day-end-fact-order   = v-fact-date-num
      124                              + 0.99
      125     .
      126     if p-fact-order           <= v-fact-date-num
      127     or p-shift-end-fact-order <= v-fact-date-num
      128     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      129     or p-shift-end-fact-order >= p-day-end-fact-order
      130     then do:
      131       message
      132         vss-workfile vss-revision vss-description skip
      133         "Внутренняя ошибка при генерации фактического номера" skip
      134         "p-fact-date"            p-fact-date            skip
      135         "p-fact-time"            p-fact-time            skip
      136         "p-fact-num"             p-fact-num             skip
      137         "p-shift-date"           p-shift-date           skip
      138         "p-shift-num"            p-shift-num            skip
      139         "p-shift-on"             p-shift-on             skip
      140         "p-shift-end-fact-order" p-shift-end-fact-order skip
      141         "p-day-end-fact-order"   p-day-end-fact-order   skip
      142         "v-fact-date-num"        v-fact-date-num        skip
      143         view-as alert-box error .
      144       undo, return error return-value .
      145     end.
      146   end procedure.
      147   procedure day-begin-fact-order :
      148     define input  parameter p-fact-date            as date    no-undo .
      149     define output parameter p-day-begin-fact-order as decimal no-undo .
      150     do
      151     on error undo, return error return-value
      152     :
      153       if p-fact-date = ?
      154       then do:
      155         assign
      156           p-day-begin-fact-order = 0
      157         .
      158       end.
      159       else do:
      160         assign
      161           p-day-begin-fact-order = integer(p-fact-date)
      162         .
      163       end.
      164     end.
      165   end procedure.
      166   procedure factord-max-fact-order :
      167     define output parameter p-max-fact-order as decimal   no-undo .
      168     do
      169     on error undo, return error return-value
      170     :
      171       run day-begin-fact-order in this-procedure
      172         (input  date(1, 1, 5000)
      173         ,output p-max-fact-order
      174         ) .
      175     end.
      176   end procedure.
      177   procedure factord-cut-archive :
      178     define input  parameter p-obj-type             as character no-undo .
      179     define input  parameter p-obj-code             as integer   no-undo .
      180     define input  parameter p-fact-date            as date      no-undo .
      181     define output parameter p-shift-on             as logical   no-undo .
      182     define output parameter p-shift-date           as date      no-undo .
      183     define output parameter p-shift-num            as integer   no-undo .
      184     define output parameter p-day-end-fact-order   as decimal   no-undo .
      185     define output parameter p-shift-end-fact-order as decimal   no-undo .
      186     define variable v-fact-order as decimal   no-undo .
      187     define buffer buf_shift-obj for ub.shift-obj .
      188     do
      189     on error undo, return error return-value
      190     :
      191   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      193     (input  p-obj-type
      194     ,input  p-obj-code
      195     ,input  'shift-on=request'
      196     ,output p-shift-on
      197     ) no-error .
      198       if error-status :error
      199       then do:
      200         message
      201           vss-workfile vss-revision vss-description skip
      202           "Ошибка при определении атрибута объекта" skip
      203           "Объект" p-obj-type p-obj-code skip
      204           error-status :get-message(1) skip
      205           return-value skip
      206           view-as alert-box error .
      207         undo, return error return-value .
      208       end.
      209       if p-shift-on = false
      210       then do:
      211         assign
      212           p-shift-date               = ?
      213           p-shift-num                = 0
      214         .
      215       end.
      216       else do:
      217         find first buf_shift-obj share-lock
      218           where buf_shift-obj.obj-type   = p-obj-type
      219             and buf_shift-obj.obj-code   = p-obj-code
      220             and buf_shift-obj.shift-date > p-fact-date
      221           use-index pi
      222           no-error .
      223         if not available buf_shift-obj
      224         or buf_shift-obj.status_ <> 'зкр':U
      225         then do:
      226           message
      227             vss-workfile vss-revision vss-description skip
      228             "Невозможно вычислить последнюю смену" skip
      229             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      230             "Объект" p-obj-type p-obj-code skip
      231             "Дата" p-fact-date skip
      232             view-as alert-box error .
      233           undo, return error return-value .
      234         end.
      235         find last buf_shift-obj share-lock
      236           where buf_shift-obj.obj-type = p-obj-type
      237             and buf_shift-obj.obj-code = p-obj-code
      238             and buf_shift-obj.shift-date <= p-fact-date
      239           use-index pi
      240           no-error .
      241         if available buf_shift-obj
      242         then do:
      243           if  buf_shift-obj.status_ = 'зкр':U
      244           then do:
      245             assign
      246               p-shift-date = buf_shift-obj.shift-date
      247               p-shift-num  = buf_shift-obj.shift-num
      248             .
      249           end.
      250           else do:
      251             message
      252               vss-workfile vss-revision vss-description skip
      253               "Невозможно вычислить последнюю смену" skip
      254               "Статус смены отличен от статуса" 'зкр':U skip
      255               "Объект" p-obj-type p-obj-code skip
      256               "Дата" p-fact-date skip
      257               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      258               view-as alert-box error .
      259             undo, return error return-value .
      260           end.
      261         end.
      262         else do:
      263           assign
      264             p-shift-date = p-fact-date - 1
      265             p-shift-num  = 1
      266           .
      267         end.
      268       end.
      269       run factord in this-procedure
      270         (input  p-fact-date
      271         ,input  1
      272         ,input  1
      273         ,input  p-shift-date
      274         ,input  p-shift-num
      275         ,input  p-shift-on
      276         ,output v-fact-order
      277         ,output p-shift-end-fact-order
      278         ,output p-day-end-fact-order
      279         ) no-error .
      280       if error-status :error
      281       then do:
      282         message
      283           vss-workfile vss-revision vss-description skip
      284           "Ошибка при вызове процедуры factord"
      285           error-status :get-message(1) skip
      286           return-value skip
      287           view-as alert-box error .
      288         undo, return error return-value .
      289       end.
      290     end.
      291   end procedure.
      292   procedure factord-lock-shift :
      293     define input  parameter p-obj-type  as character no-undo .
      294     define input  parameter p-obj-code  as integer   no-undo .
      295     define input  parameter p-fact-date as date      no-undo .
      296     define parameter buffer buf_shift-obj for ub.shift-obj .
      297     define variable v-shift-on      as logical   no-undo .
      298     define variable v-extra-message as character no-undo .
      299     define variable v-error as character no-undo .
      300     do
      301     on error undo, return error return-value
      302     :
      303   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      305     (input  p-obj-type
      306     ,input  p-obj-code
      307     ,input  'shift-on=request'
      308     ,output v-shift-on
      309     ) no-error .
      310       if error-status :error
      311       then do:
      312         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      313         undo, return error v-error .
      314       end.
      315       if v-shift-on = true
      316       then do:
      317         find first buf_shift-obj share-lock
      318           where buf_shift-obj.obj-type   = p-obj-type
      319             and buf_shift-obj.obj-code   = p-obj-code
      320             and buf_shift-obj.shift-date > p-fact-date
      321           use-index pi
      322           no-error .
      323         if not available buf_shift-obj
      324         or buf_shift-obj.status_ <> 'зкр':U
      325         then do:
      326           find last buf_shift-obj
      327             where buf_shift-obj.obj-type = p-obj-type
      328               and buf_shift-obj.obj-code = p-obj-code
      329               and buf_shift-obj.status_  = 'зкр':U
      330             use-index stts
      331             no-error .
      332           if available buf_shift-obj
      333           then do:
      334             assign
      335               v-extra-message =
      336                     substitute("Дата начала последеней закрытой смены на объекте &1"
      337                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      338                               )
      339             .
      340           end.
      341           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      342           undo, return error v-error .
      343         end.
      344       end.
      345     end.
      346   end procedure.
      347   procedure factord-end-day :
      348     define input  parameter p-fact-date            as date    no-undo .
      349     define output parameter p-day-end-fact-order   as decimal no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       if p-fact-date = ?
      354       then do:
      355         return error "Не указана фактическая дата" .
      356       end.
      357       assign
      358         p-day-end-fact-order = integer(p-fact-date) + 0.99
      359       .
      360     end.
      361   end procedure.
      362   procedure factord-to-date :
      363     define input  parameter p-fact-order as decimal no-undo .
      364     define output parameter p-fact-date  as date    no-undo .
      365     define variable v-ref-date  as date      no-undo .
      366     define variable v-ref-delta as integer   no-undo .
      367     do
      368     on error undo, return error return-value
      369     :
      370       if p-fact-order = ?
      371       or p-fact-order = 0
      372       then do:
      373         return error "Не указан fact-order" .
      374       end.
      375       assign
      376         v-ref-date  = date(1, 1, 2000)
      377       .
      378       assign
      379         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      380       .
      381       assign
      382         p-fact-date = v-ref-date + v-ref-delta
      383       .
      384     end.
      385   end procedure.
      386   procedure factord-to-fact-num :
      387     define input  parameter p-fact-order as decimal no-undo .
      388     define output parameter p-fact-num   as integer no-undo .
      389     define variable v-fact-order-trunc as decimal no-undo .
      390     do
      391     on error undo, return error return-value
      392     :
      393       if p-fact-order = ?
      394       or p-fact-order = 0
      395       then do:
      396         return error "Не указан fact-order" .
      397       end.
      398       assign
      399        v-fact-order-trunc = truncate(p-fact-order, 2)
      400       .
      401       assign
      402         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      403       .
      404     end.
      405   end procedure.
      406   procedure factord-to-shift-num :
      407     define input  parameter p-fact-order as decimal no-undo .
      408     define output parameter p-shift-num   as integer no-undo .
      409     define variable  p-shift-numd  as decimal   no-undo .
      410     define variable v-fact-order-trunc as decimal no-undo .
      411     do
      412     on error undo, return error return-value
      413     :
      414       if p-fact-order = ?
      415       or p-fact-order = 0
      416       then do:
      417         return error "Не указан fact-order" .
      418       end.
      419       assign
      420        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      421       .
      422       if v-fact-order-trunc < 0.5 then do:
      423         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      424       end.
      425       assign
      426         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      427         .
      428        assign
      429         p-shift-num = truncate (p-shift-numd , 0)
      430       .
      431     end.
      432   end procedure.
      433   define  shared temp-table tt-objs no-undo
      434     field obj-type as character
      435     field obj-code as integer
      436     index pi is unique primary obj-type obj-code
      437     .
      438   do
      439   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      440   define input parameter vartype-cut            as integer   no-undo.
      441   define input parameter varlist-db             as character no-undo.
      442   define input parameter vardate-actual-goods   as date      no-undo.
      443   define input parameter vardate-actual-docs    as date      no-undo.
      444   define input parameter vardate-actual-findoc  as date      no-undo.
      445   define input parameter vardate-output-zone    as date      no-undo.
      446   define input parameter varstay-recipe-goods   as logical   no-undo.
      447   define input parameter varstay-weight-goods   as logical   no-undo.
      448   define input parameter varnot-copy-del-goods  as logical   no-undo.
      449   define input parameter varstay-history        as logical   no-undo.
      450   define input parameter vargen-file            as character no-undo.
      451   define stream str-gen.
      452   output stream str-gen to vargen-file append.
      453   if not connected("src") then do:
      454      return error "Нет коннекта с базой 'src'.".
      455   end.
      456   if not connected("dst") then do:
      457      return error "Нет коннекта с базой 'dst'.".
      458   end.
      459   find src.sys-ctrl no-lock.
      460   if not available src.sys-ctrl then do:
      461      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      462   end.
      463   if src.sys-ctrl.db-num <> 0 then do:
      464      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      465   end.
      466   if vardate-actual-docs <> ? and
      467      (vardate-actual-goods   > vardate-actual-docs or
      468       vardate-actual-goods   = ? )   then do:
      469         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      470                                 "Дата актуальности товаров &1."        +
      471                                 "Дата актуальности документов &2."     +
      472                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      473                                 vardate-actual-goods,
      474                                 vardate-actual-docs).
      475   end.
      476   on WRITE of dst.c-wth-doc    override do: end.
      477   on WRITE of dst.c-wth-line   override do: end.
      478   on WRITE of dst.c-wth-dtl    override do: end.
      479   on WRITE of dst.c-wth-parts  override do: end.
      480   if not varstay-history  then return.
      481   if vardate-actual-docs <> ? then do:
      482      run factord-end-day in this-procedure ( vardate-actual-docs - 1, output var-fact-order-docs).
      483     for each new-shop no-lock
      484     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      485       if vartype-cut = 1 then do:
      486         find first tt-objs where tt-objs.obj-type = 'маг':U and
      487                                   tt-objs.obj-code = new-shop.obj-code no-error.
      488       end.
      489       if vartype-cut = 0      or
      490           (vartype-cut = 1 and available tt-objs) then do:
      491         for each old-c-wth-doc where old-c-wth-doc.host-code  = new-shop.host-code and
      492                                 old-c-wth-doc.obj-type  = 'маг':U and
      493                                   old-c-wth-doc.obj-code   = new-shop.obj-code and
      494                                   old-c-wth-doc.status_    = 'факт':U              and
      495                                   old-c-wth-doc.fact-order >= var-fact-order-docs  no-lock
      496         use-index stat-fact
      497         on error undo, return error
      498         :
      499         create new-c-wth-doc.
      500         buffer-copy old-c-wth-doc to new-c-wth-doc.
      501           for each old-c-wth-line no-lock
      502             where old-c-wth-line.doc-code = new-c-wth-doc.doc-code
      503             and   old-c-wth-line.chip-num = new-c-wth-doc.chip-num
      504             and   old-c-wth-line.corr-user-db-num = new-c-wth-doc.corr-user-db-num
      505           on error undo, return error
      506           :
      507               create new-c-wth-line.
      508               buffer-copy old-c-wth-line to new-c-wth-line.
      509           end.
      510           for each old-c-wth-dtl no-lock
      511             where old-c-wth-dtl.doc-code  = new-c-wth-doc.doc-code
      512             and   old-c-wth-dtl.chip-num = new-c-wth-doc.chip-num
      513             and   old-c-wth-dtl.corr-user-db-num = new-c-wth-doc.corr-user-db-num
      514           on error undo, return error
      515           :
      516             create new-c-wth-dtl.
      517             buffer-copy old-c-wth-dtl to new-c-wth-dtl.
      518             for each  old-c-wth-parts no-lock
      519             where old-c-wth-parts.obj-type = new-c-wth-doc.obj-type
      520               and old-c-wth-parts.obj-code = new-c-wth-doc.obj-code
      521               and old-c-wth-parts.w-p-code = new-c-wth-dtl.w-p-code
      522               and old-c-wth-parts.wth-code = new-c-wth-dtl.wth-code
      523               and old-c-wth-parts.par-code = new-c-wth-dtl.par-code
      524               and old-c-wth-parts.out-code  = new-c-wth-doc.doc-code
      525           on error undo, return error
      526           :
      527              if   old-c-wth-parts.chip-num = new-c-wth-doc.chip-num
      528               and   old-c-wth-parts.corr-user-db-num = new-c-wth-doc.corr-user-db-num then next.
      529               create new-c-wth-parts.
      530               buffer-copy old-c-wth-parts to new-c-wth-parts.
      531             end.
      532           end.
      533         end.
      534       end.
      535       run export-c-wth-parts in this-procedure ( input 'маг':U, input new-shop.obj-code).
      536     end.
      537     for each new-store no-lock
      538     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      539       if vartype-cut = 1 then do:
      540         find first tt-objs where tt-objs.obj-type = 'скл':U and
      541                                   tt-objs.obj-code = new-store.obj-code no-error.
      542       end.
      543       if vartype-cut = 0      or
      544           (vartype-cut = 1 and available tt-objs) then do:
      545         for each old-c-wth-doc where old-c-wth-doc.host-code  = new-store.host-code and
      546                                 old-c-wth-doc.obj-type  = 'скл':U and
      547                                   old-c-wth-doc.obj-code   = new-store.obj-code and
      548                                   old-c-wth-doc.status_    = 'факт':U              and
      549                                   old-c-wth-doc.fact-order >= var-fact-order-docs  no-lock
      550         use-index stat-fact
      551         on error undo, return error
      552         :
      553         create new-c-wth-doc.
      554         buffer-copy old-c-wth-doc to new-c-wth-doc.
      555           for each old-c-wth-line no-lock
      556             where old-c-wth-line.doc-code = new-c-wth-doc.doc-code
      557             and   old-c-wth-line.chip-num = new-c-wth-doc.chip-num
      558             and   old-c-wth-line.corr-user-db-num = new-c-wth-doc.corr-user-db-num
      559           on error undo, return error
      560           :
      561               create new-c-wth-line.
      562               buffer-copy old-c-wth-line to new-c-wth-line.
      563           end.
      564           for each old-c-wth-dtl no-lock
      565             where old-c-wth-dtl.doc-code  = new-c-wth-doc.doc-code
      566             and   old-c-wth-dtl.chip-num = new-c-wth-doc.chip-num
      567             and   old-c-wth-dtl.corr-user-db-num = new-c-wth-doc.corr-user-db-num
      568           on error undo, return error
      569           :
      570             create new-c-wth-dtl.
      571             buffer-copy old-c-wth-dtl to new-c-wth-dtl.
      572             for each  old-c-wth-parts no-lock
      573             where old-c-wth-parts.obj-type = new-c-wth-doc.obj-type
      574               and old-c-wth-parts.obj-code = new-c-wth-doc.obj-code
      575               and old-c-wth-parts.w-p-code = new-c-wth-dtl.w-p-code
      576               and old-c-wth-parts.wth-code = new-c-wth-dtl.wth-code
      577               and old-c-wth-parts.par-code = new-c-wth-dtl.par-code
      578               and old-c-wth-parts.out-code  = new-c-wth-doc.doc-code
      579           on error undo, return error
      580           :
      581              if   old-c-wth-parts.chip-num = new-c-wth-doc.chip-num
      582               and   old-c-wth-parts.corr-user-db-num = new-c-wth-doc.corr-user-db-num then next.
      583               create new-c-wth-parts.
      584               buffer-copy old-c-wth-parts to new-c-wth-parts.
      585             end.
      586           end.
      587         end.
      588       end.
      589       run export-c-wth-parts in this-procedure ( input 'скл':U, input new-store.obj-code).
      590     end.
      591   end.
      592   procedure export-c-wth-parts :
      593   define input parameter p-obj-type as character no-undo .
      594   define input parameter p-obj-code as integer no-undo .
      595   define buffer new-wth-gds for dst.wth-gds.
      596   define buffer new-wth-parts for dst.wth-parts.
      597   for each new-wth-parts no-lock where
      598           new-wth-parts.obj-type = p-obj-type
      599       and new-wth-parts.obj-code = p-obj-code,
      600       each old-c-wth-parts no-lock
      601       where old-c-wth-parts.obj-type  = p-obj-type
      602         and old-c-wth-parts.obj-code  = p-obj-code
      603         and old-c-wth-parts.w-p-code = new-wth-parts.w-p-code
      604         and old-c-wth-parts.wth-code = new-wth-parts.wth-code
      605         and old-c-wth-parts.par-code = new-wth-parts.par-code
      606         and old-c-wth-parts.in-code = new-wth-parts.in-code
      607         and old-c-wth-parts.out-code = new-wth-parts.out-code
      608         and old-c-wth-parts.ser-code = new-wth-parts.ser-code
      609         and old-c-wth-parts.db-num = new-wth-parts.db-num
      610         and old-c-wth-parts.fact-rangeFrom = new-wth-parts.fact-rangefrom
      611         and old-c-wth-parts.fact-rangeto = new-wth-parts.fact-rangeto
      612     on error undo, return error
      613     :
      614         create new-c-wth-parts.
      615         buffer-copy old-c-wth-parts to new-c-wth-parts.
      616     end.
      617   end procedure.
      618   output stream str-gen close.
      619   return "Произведен экспорт таблиц: c-wth-doc c-wth-line c-wth-dtl c-wth-parts".
      620   end.
