        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00080000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00080000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 80.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer buf_old_c-contract         for src.c-contract        .
       13   define buffer buf_old_c-contract-line    for src.c-contract-line   .
       14   define buffer buf_old_c-contract-specif  for src.c-contract-specif .
       15   define buffer buf_old_contract           for src.contract          .
       16   define buffer buf_old_contract-line      for src.contract-line     .
       17   define buffer buf_old_contract-specif    for src.contract-specif   .
       18   define buffer buf_old_contract-attr           for src.contract-attr          .
       19   define buffer buf_old_contract-line-attr      for src.contract-line-attr     .
       20   define buffer buf_old_contract-specif-attr    for src.contract-specif-attr   .
       21   define buffer buf_new_c-contract         for dst.c-contract        .
       22   define buffer buf_new_c-contract-line    for dst.c-contract-line   .
       23   define buffer buf_new_c-contract-specif  for dst.c-contract-specif .
       24   define buffer buf_new_contract           for dst.contract          .
       25   define buffer buf_new_contract-line      for dst.contract-line     .
       26   define buffer buf_new_contract-specif    for dst.contract-specif   .
       27   define buffer buf_new_contract-attr           for dst.contract-attr          .
       28   define buffer buf_new_contract-line-attr      for dst.contract-line-attr     .
       29   define buffer buf_new_contract-specif-attr    for dst.contract-specif-attr   .
       30   define buffer new_goods                  for dst.goods   .
       31   define buffer old-ext-classif         for src.ext-classif.
       32   define buffer new-ext-classif         for dst.ext-classif.
       33   on WRITE of dst.ext-classif            override do: end.
       34   do
       35   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       36   :
       37   define input parameter vartype-cut            as integer   no-undo.
       38   define input parameter varlist-db             as character no-undo.
       39   define input parameter vardate-actual-goods   as date      no-undo.
       40   define input parameter vardate-actual-docs    as date      no-undo.
       41   define input parameter vardate-actual-findoc  as date      no-undo.
       42   define input parameter vardate-output-zone    as date      no-undo.
       43   define input parameter varstay-recipe-goods   as logical   no-undo.
       44   define input parameter varstay-weight-goods   as logical   no-undo.
       45   define input parameter varnot-copy-del-goods  as logical   no-undo.
       46   define input parameter varstay-history        as logical   no-undo.
       47   define input parameter vargen-file            as character no-undo.
       48   define stream str-gen.
       49   output stream str-gen to vargen-file append.
       50   if not connected("src") then do:
       51      return error "Нет коннекта с базой 'src'.".
       52   end.
       53   if not connected("dst") then do:
       54      return error "Нет коннекта с базой 'dst'.".
       55   end.
       56   find src.sys-ctrl no-lock.
       57   if not available src.sys-ctrl then do:
       58      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       59   end.
       60   if src.sys-ctrl.db-num <> 0 then do:
       61      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       62   end.
       63   if vardate-actual-docs <> ? and
       64      (vardate-actual-goods   > vardate-actual-docs or
       65       vardate-actual-goods   = ? )   then do:
       66         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       67                                 "Дата актуальности товаров &1."        +
       68                                 "Дата актуальности документов &2."     +
       69                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       70                                 vardate-actual-goods,
       71                                 vardate-actual-docs).
       72   end.
       73     on WRITE of dst.c-contract        override do: end.
       74     on WRITE of dst.c-contract-line   override do: end.
       75     on WRITE of dst.c-contract-specif override do: end.
       76     on WRITE of dst.contract          override do: end.
       77     on WRITE of dst.contract-line     override do: end.
       78     on WRITE of dst.contract-specif   override do: end.
       79     on WRITE of dst.contract-attr          override do: end.
       80     on WRITE of dst.contract-line-attr     override do: end.
       81     on WRITE of dst.contract-specif-attr   override do: end.
       82     for each buf_old_contract no-lock
       83       on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       84       :
       85       create buf_new_contract.
       86       buffer-copy buf_old_contract to buf_new_contract.
       87       for each buf_old_contract-line no-lock
       88         where buf_old_contract-line.host-code    = buf_old_contract.host-code
       89           and buf_old_contract-line.contract-num = buf_old_contract.contract-code
       90         :
       91         create buf_new_contract-line.
       92         buffer-copy buf_old_contract-line to buf_new_contract-line.
       93       end.
       94       for each buf_old_contract-specif no-lock
       95         where buf_old_contract-specif.host-code    = buf_old_contract.host-code
       96           and buf_old_contract-specif.contract-num = buf_old_contract.contract-code
       97         :
       98           find first new_goods no-lock where
       99                     new_goods.gds-code = buf_old_contract-specif.gds-code no-error .
      100           if available new_goods then do:
      101               create buf_new_contract-specif.
      102               buffer-copy buf_old_contract-specif to buf_new_contract-specif.
      103           end.
      104        END.
      105       for each buf_old_contract-line-attr no-lock
      106         where buf_old_contract-line-attr.host-code    = buf_old_contract.host-code
      107           and buf_old_contract-line-attr.contract-num = buf_old_contract.contract-code
      108         :
      109         create buf_new_contract-line-attr.
      110         buffer-copy buf_old_contract-line-attr to buf_new_contract-line-attr.
      111       end.
      112       for each buf_old_contract-specif-attr no-lock
      113         where buf_old_contract-specif-attr.host-code    = buf_old_contract.host-code
      114           and buf_old_contract-specif-attr.contract-num = buf_old_contract.contract-code
      115         :
      116           find first new_goods no-lock where
      117                      new_goods.gds-code = buf_old_contract-specif-ATTR.gds-code no-error .
      118           if available new_goods then do:
      119               create buf_new_contract-specif-attr.
      120               buffer-copy buf_old_contract-specif-attr to buf_new_contract-specif-attr.
      121           END.
      122       end.
      123       for each buf_old_contract-attr no-lock
      124         where buf_old_contract-attr.host-code    = buf_old_contract.host-code
      125           and buf_old_contract-attr.contract-code = buf_old_contract.contract-code
      126         :
      127         create buf_new_contract-attr.
      128         buffer-copy buf_old_contract-attr to buf_new_contract-attr.
      129       end.
      130       if varstay-history = yes then do:
      131         for each buf_old_c-contract no-lock
      132           where buf_old_c-contract.host-code     = buf_old_contract.host-code
      133             and buf_old_c-contract.contract-code = buf_old_contract.contract-code
      134           :
      135           create buf_new_c-contract.
      136           buffer-copy buf_old_c-contract to buf_new_c-contract.
      137         end.
      138         for each buf_old_c-contract-line no-lock
      139           where buf_old_c-contract-line.host-code    = buf_old_contract.host-code
      140             and buf_old_c-contract-line.contract-num = buf_old_contract.contract-code
      141           :
      142           create buf_new_c-contract-line.
      143           buffer-copy buf_old_c-contract-line to buf_new_c-contract-line.
      144         end.
      145         for each buf_old_c-contract-specif no-lock
      146           where buf_old_c-contract-specif.host-code    = buf_old_contract.host-code
      147             and buf_old_c-contract-specif.contract-num = buf_old_contract.contract-code
      148           :
      149           find first new_goods no-lock where
      150                      new_goods.gds-code = buf_old_c-contract-specif.gds-code no-error .
      151           if available new_goods then do:
      152               create buf_new_c-contract-specif.
      153               buffer-copy buf_old_c-contract-specif to buf_new_c-contract-specif.
      154           end.
      155         end.
      156       end.
      157     end.
      158   for each old-ext-classif  where old-ext-classif.classif-subject = 'contract':U  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      159      create new-ext-classif.
      160      buffer-copy old-ext-classif to new-ext-classif.
      161   end.
      162     output stream str-gen close.
      163     return "Произведен экспорт таблиц: c-contract c-contract-line c-contract-specif contract contract-line contract-specif ext-classif.".
      164   end.
