        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00207000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00207000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 104.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-menu-group           for src.menu-group          .
       13   define buffer old-menu-group-attr      for src.menu-group-attr     .
       14   define buffer old-menu-head            for src.menu-head           .
       15   define buffer old-menu-head-attr       for src.menu-head-attr      .
       16   define buffer old-menu-item            for src.menu-item           .
       17   define buffer old-menu-item-attr       for src.menu-item-attr      .
       18   define buffer old-menu-item-group      for src.menu-item-group     .
       19   define buffer old-menu-item-group-attr for src.menu-item-group-attr.
       20   define buffer new-menu-group           for dst.menu-group          .
       21   define buffer new-menu-group-attr      for dst.menu-group-attr     .
       22   define buffer new-menu-head            for dst.menu-head           .
       23   define buffer new-menu-head-attr       for dst.menu-head-attr      .
       24   define buffer new-menu-item            for dst.menu-item           .
       25   define buffer new-menu-item-attr       for dst.menu-item-attr      .
       26   define buffer new-menu-item-group      for dst.menu-item-group     .
       27   define buffer new-menu-item-group-attr for dst.menu-item-group-attr.
       28   do
       29   on error undo, return error SUBSTITUTE ( "&1 &2 &3"
       30                                          , return-value
       31                                          , error-status:get-message(1)
       32                                          , error-status:get-message(2)
       33                                          ) :
       34   define input parameter vartype-cut            as integer   no-undo.
       35   define input parameter varlist-db             as character no-undo.
       36   define input parameter vardate-actual-goods   as date      no-undo.
       37   define input parameter vardate-actual-docs    as date      no-undo.
       38   define input parameter vardate-actual-findoc  as date      no-undo.
       39   define input parameter vardate-output-zone    as date      no-undo.
       40   define input parameter varstay-recipe-goods   as logical   no-undo.
       41   define input parameter varstay-weight-goods   as logical   no-undo.
       42   define input parameter varnot-copy-del-goods  as logical   no-undo.
       43   define input parameter varstay-history        as logical   no-undo.
       44   define input parameter vargen-file            as character no-undo.
       45   define stream str-gen.
       46   output stream str-gen to vargen-file append.
       47   if not connected("src") then do:
       48      return error "Нет коннекта с базой 'src'.".
       49   end.
       50   if not connected("dst") then do:
       51      return error "Нет коннекта с базой 'dst'.".
       52   end.
       53   find src.sys-ctrl no-lock.
       54   if not available src.sys-ctrl then do:
       55      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       56   end.
       57   if src.sys-ctrl.db-num <> 0 then do:
       58      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       59   end.
       60   if vardate-actual-docs <> ? and
       61      (vardate-actual-goods   > vardate-actual-docs or
       62       vardate-actual-goods   = ? )   then do:
       63         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       64                                 "Дата актуальности товаров &1."        +
       65                                 "Дата актуальности документов &2."     +
       66                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       67                                 vardate-actual-goods,
       68                                 vardate-actual-docs).
       69   end.
       70   on WRITE of dst.menu-group                           override do: end.
       71   on WRITE of dst.menu-group-attr                      override do: end.
       72   on WRITE of dst.menu-head                            override do: end.
       73   on WRITE of dst.menu-head-attr                       override do: end.
       74   on WRITE of dst.menu-item                            override do: end.
       75   on WRITE of dst.menu-item-attr                       override do: end.
       76   on WRITE of dst.menu-item-group                      override do: end.
       77   on WRITE of dst.menu-item-group-attr                 override do: end.
       78   for each old-menu-group  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       79      create new-menu-group.
       80      buffer-copy old-menu-group to new-menu-group.
       81   end.
       82   for each old-menu-group-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       83      create new-menu-group-attr.
       84      buffer-copy old-menu-group-attr to new-menu-group-attr.
       85   end.
       86   for each old-menu-head  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       87      create new-menu-head.
       88      buffer-copy old-menu-head to new-menu-head.
       89   end.
       90   for each old-menu-head-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       91      create new-menu-head-attr.
       92      buffer-copy old-menu-head-attr to new-menu-head-attr.
       93   end.
       94   for each old-menu-item  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       95      create new-menu-item.
       96      buffer-copy old-menu-item to new-menu-item.
       97   end.
       98   for each old-menu-item-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       99      create new-menu-item-attr.
      100      buffer-copy old-menu-item-attr to new-menu-item-attr.
      101   end.
      102   for each old-menu-item-group  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      103      create new-menu-item-group.
      104      buffer-copy old-menu-item-group to new-menu-item-group.
      105   end.
      106   for each old-menu-item-group-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      107      create new-menu-item-group-attr.
      108      buffer-copy old-menu-item-group-attr to new-menu-item-group-attr.
      109   end.
      110   output stream str-gen close.
      111   return "Произведен экспорт таблиц: ~
      112   menu-group ~
      113   menu-group-attr ~
      114   menu-head ~
      115   menu-head-attr ~
      116   menu-item ~
      117   menu-item-attr ~
      118   menu-item-group ~
      119   menu-item-group-attr ~
      120   ".
      121   end.
