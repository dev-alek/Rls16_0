      657         old-blob-bind.resource-type = v-entry
      658   and old-blob-bind.db-num = 0
      659   and old-blob-bind.int64-id > 0
      660   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      661       if v-entry = 'data':U then do:
