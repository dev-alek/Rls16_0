      572   do
      573   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      574   define input parameter vartype-cut            as integer   no-undo.
      575   define input parameter varlist-db             as character no-undo.
