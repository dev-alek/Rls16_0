      579   define input parameter vardate-output-zone    as date      no-undo.
      580   define input parameter varstay-recipe-goods   as logical   no-undo.
      581   define input parameter varstay-weight-goods   as logical   no-undo.
      582   define input parameter varnot-copy-del-goods  as logical   no-undo.
      583   define input parameter varstay-history        as logical   no-undo.
      584   define input parameter vargen-file            as character no-undo.
      585   define stream str-gen.
      586   output stream str-gen to vargen-file append.
      587   if not connected("src") then do:
      588      return error "Нет коннекта с базой 'src'.".
      589   end.
      590   if not connected("dst") then do:
      591      return error "Нет коннекта с базой 'dst'.".
      592   end.
      593   find src.sys-ctrl no-lock.
      594   if not available src.sys-ctrl then do:
      595      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      596   end.
      597   if src.sys-ctrl.db-num <> 0 then do:
      598      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      599   end.
      600   if vardate-actual-docs <> ? and
      601      (vardate-actual-goods   > vardate-actual-docs or
      602       vardate-actual-goods   = ? )   then do:
      603         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      604                                 "Дата актуальности товаров &1."        +
      605                                 "Дата актуальности документов &2."     +
      606                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      607                                 vardate-actual-goods,
      608                                 vardate-actual-docs).
      609   end.
