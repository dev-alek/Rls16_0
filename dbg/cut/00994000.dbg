      874         old-clob-bind.resource-type = 'egais-wb-act':U
      875     and can-find (first new-doc-attr where new-doc-attr.attr-code = 'negais':U and old-clob-bind.uniq-key-rec matches ("*" + new-doc-attr.attr-value + "*"))
      876     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      877     create new-clob-bind.
      878     buffer-copy old-clob-bind to new-clob-bind no-error.
      879     if error-status:error then do:
      880       delete new-clob-bind.
      881       next cicl4_.
      882     end.
      883     for  EACH old-clob-data NO-LOCK
      884           where old-clob-data.db-num = old-clob-bind.db-num
      885                   and old-clob-data.int64-id = old-clob-bind.int64-id
      886       on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      887       create new-clob-data.
      888       buffer-copy old-clob-data to new-clob-data no-error.
      889       if error-status:error then do:
      890         delete new-clob-data.
      891         next cicl4_.
      892       end.
      893     end.
      894   end.
      895   output stream str-gen close.
      896   return "Произведен экспорт таблиц: clob-data clob-bind blob-bind blob-data.".
      897   end.
