      634      if error-status:error then next.
      635      create buffer v-bh for table "dst." + v-tbl-name .
      636      v-bh:find-by-rowid( v-tbl-row, exclusive-lock ) no-error .
      637      if not v-bh:available then do:
      638         delete widget v-bh.
      639         next.
      640      end.
      641      delete widget v-bh.
      642       end.
      643      create new-clob-bind.
