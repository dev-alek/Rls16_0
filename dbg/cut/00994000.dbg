      645      for  EACH old-clob-data NO-LOCK
      646         where      (old-clob-data.db-num = old-clob-bind.db-num
      647                 and old-clob-data.int64-id = old-clob-bind.int64-id )
      648                 or (old-clob-data.file-name = old-clob-bind.uniq-key-rec
      649                     and
      650                     old-clob-bind.uniq-key-rec begins "exe/")
      651       on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      652       create new-clob-data.
