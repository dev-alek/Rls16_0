        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: 00998000.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: cut/00998000.p $":U .
        7   define variable vss-description as character no-undo initial "Файл пирога обрезания. Относится к категории 98.":U .
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-rep              for src.rep              .
       13   define buffer new-rep              for dst.rep              .
       14   define buffer old-rep-line         for src.rep-line         .
       15   define buffer new-rep-line         for dst.rep-line         .
       16   define buffer old-doc-fact-num        for src.doc-fact-num        .
       17   define buffer new-doc-fact-num        for dst.doc-fact-num        .
       18   define buffer old-doc-fact-num-attr        for src.doc-fact-num-attr        .
       19   define buffer new-doc-fact-num-attr        for dst.doc-fact-num-attr        .
       20   do
       21   on error undo, return error SUBSTITUTE( "&1 &2 &3"
       22                                         , return-value
       23                                         , error-status :get-message( 1 )
       24                                         , error-status :get-message( 2 )
       25                                         )
       26   :
       27   define input parameter vartype-cut            as integer   no-undo.
       28   define input parameter varlist-db             as character no-undo.
       29   define input parameter vardate-actual-goods   as date      no-undo.
       30   define input parameter vardate-actual-docs    as date      no-undo.
       31   define input parameter vardate-actual-findoc  as date      no-undo.
       32   define input parameter vardate-output-zone    as date      no-undo.
       33   define input parameter varstay-recipe-goods   as logical   no-undo.
       34   define input parameter varstay-weight-goods   as logical   no-undo.
       35   define input parameter varnot-copy-del-goods  as logical   no-undo.
       36   define input parameter varstay-history        as logical   no-undo.
       37   define input parameter vargen-file            as character no-undo.
       38   define stream str-gen.
       39   output stream str-gen to vargen-file append.
       40   if not connected("src") then do:
       41      return error "Нет коннекта с базой 'src'.".
       42   end.
       43   if not connected("dst") then do:
       44      return error "Нет коннекта с базой 'dst'.".
       45   end.
       46   find src.sys-ctrl no-lock.
       47   if not available src.sys-ctrl then do:
       48      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       49   end.
       50   if src.sys-ctrl.db-num <> 0 then do:
       51      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       52   end.
       53   if vardate-actual-docs <> ? and
       54      (vardate-actual-goods   > vardate-actual-docs or
       55       vardate-actual-goods   = ? )   then do:
       56         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       57                                 "Дата актуальности товаров &1."        +
       58                                 "Дата актуальности документов &2."     +
       59                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       60                                 vardate-actual-goods,
       61                                 vardate-actual-docs).
       62   end.
       63     on CREATE of dst.rep              override do: end.
       64     on CREATE of dst.rep-line         override do: end.
       65     on CREATE of dst.doc-fact-num        override do: end.
       66     on CREATE of dst.doc-fact-num-attr        override do: end.
       67     on WRITE  of dst.rep              override do: end.
       68     on WRITE  of dst.rep-line         override do: end.
       69     on WRITE of dst.doc-fact-num        override do: end.
       70     on WRITE of dst.doc-fact-num-attr        override do: end.
       71   for each old-rep  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       72      create new-rep.
       73      buffer-copy old-rep to new-rep.
       74   end.
       75   for each old-rep-line  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       76      create new-rep-line.
       77      buffer-copy old-rep-line to new-rep-line.
       78   end.
       79   for each old-doc-fact-num  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       80      create new-doc-fact-num.
       81      buffer-copy old-doc-fact-num to new-doc-fact-num.
       82   end.
       83   for each old-doc-fact-num-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       84      create new-doc-fact-num-attr.
       85      buffer-copy old-doc-fact-num-attr to new-doc-fact-num-attr.
       86   end.
       87     output stream str-gen close.
       88     return "Произведен экспорт таблиц: rep-line " .
       89   end.
