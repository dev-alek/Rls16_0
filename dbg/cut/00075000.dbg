       67   do
       68   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       69   :
       70   define input parameter vartype-cut            as integer   no-undo.
       71   define input parameter varlist-db             as character no-undo.
       72   define input parameter vardate-actual-goods   as date      no-undo.
       73   define input parameter vardate-actual-docs    as date      no-undo.
       74   define input parameter vardate-actual-findoc  as date      no-undo.
       75   define input parameter vardate-output-zone    as date      no-undo.
       76   define input parameter varstay-recipe-goods   as logical   no-undo.
       77   define input parameter varstay-weight-goods   as logical   no-undo.
       78   define input parameter varnot-copy-del-goods  as logical   no-undo.
       79   define input parameter varstay-history        as logical   no-undo.
       80   define input parameter vargen-file            as character no-undo.
       81   define stream str-gen.
       82   output stream str-gen to vargen-file append.
       83   if not connected("src") then do:
       84      return error "Нет коннекта с базой 'src'.".
       85   end.
       86   if not connected("dst") then do:
       87      return error "Нет коннекта с базой 'dst'.".
       88   end.
       89   find src.sys-ctrl no-lock.
       90   if not available src.sys-ctrl then do:
       91      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       92   end.
       93   if src.sys-ctrl.db-num <> 0 then do:
       94      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       95   end.
       96   if vardate-actual-docs <> ? and
       97      (vardate-actual-goods   > vardate-actual-docs or
       98       vardate-actual-goods   = ? )   then do:
       99         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      100                                 "Дата актуальности товаров &1."        +
      101                                 "Дата актуальности документов &2."     +
      102                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      103                                 vardate-actual-goods,
      104                                 vardate-actual-docs).
      105   end.
      106     on WRITE of dst.fin-bank            override do: end.
      107     on WRITE of dst.c-fin-bank          override do: end.
      108     on WRITE of dst.fin-bank-attr       override do: end.
      109     on WRITE of dst.c-fin-bank-attr     override do: end.
      110     on WRITE of dst.fin-code-an-uchet   override do: end.
      111     on WRITE of dst.fin-code-an-uchet-attr   override do: end.
      112     on WRITE of dst.c-fin-code-an-uchet override do: end.
      113     on WRITE of dst.fin-code-cel-nazn   override do: end.
      114     on WRITE of dst.fin-code-cel-nazn-attr   override do: end.
      115     on WRITE of dst.c-fin-code-cel-nazn      override do: end.
      116     on WRITE of dst.fin-code-cor-acc-attr    override do: end.
      117     on WRITE of dst.c-fin-code-cor-acc  override do: end.
      118     on WRITE of dst.fin-code-cor-acc    override do: end.
      119     on WRITE of dst.fin-schet           override do: end.
      120     on WRITE of dst.c-fin-schet         override do: end.
      121     on WRITE of dst.fin-schet-attr      override do: end.
      122     on WRITE of dst.c-fin-schet-attr    override do: end.
      123     on WRITE of dst.cbr-bank            override do: end.
      124     on WRITE of dst.c-cbr-bank          override do: end.
      125     on WRITE of dst.cbr-bank-attr       override do: end.
      126     on WRITE of dst.c-cbr-bank-attr     override do: end.
      127     on WRITE of dst.CashBook         override do: end.
      128     on WRITE of dst.CashBookAttr     override do: end.
      129     on WRITE of dst.CashBookRule     override do: end.
      130     on WRITE of dst.CashBookRuleAttr override do: end.
      131     on WRITE of dst.OperServ         override do: end.
      132     on WRITE of dst.OperServAttr     override do: end.
      133   for each old-fin-bank  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      134      create new-fin-bank.
      135      buffer-copy old-fin-bank to new-fin-bank.
      136   end.
      137     if varstay-history then do:
      138   for each old-c-fin-bank  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      139      create new-c-fin-bank.
      140      buffer-copy old-c-fin-bank to new-c-fin-bank.
      141   end.
      142     end.
