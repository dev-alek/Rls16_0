      236      create new-CashBook.
      237      buffer-copy old-CashBook to new-CashBook.
      238   end.
      239   for each old-CashBookAttr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      240      create new-CashBookAttr.
      241      buffer-copy old-CashBookAttr to new-CashBookAttr.
      242   end.
      243     for each buf_clients no-lock
      244        where buf_clients.db-num >= 0
      245     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      246     :
      247   for each old-CashBookRule  where old-CashBookRule.Obj-type = buf_clients.obj-type
      248             and old-CashBookRule.Obj-code = buf_clients.obj-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      249      create new-CashBookRule.
      250      buffer-copy old-CashBookRule to new-CashBookRule.
      251   end.
      252       for each old-CashBookRule no-lock
      253          where old-CashBookRule.Obj-type = buf_clients.obj-type
      254            and old-CashBookRule.Obj-code = buf_clients.obj-code
      255       on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      256       :
      257   for each old-CashBookRuleAttr  where old-CashBookRuleAttr.cashbookid = old-CashBookRule.cashbookid and old-CashBookRuleAttr.obj-type = old-CashBookRule.obj-type and old-CashBookRuleAttr.obj-code = old-CashBookRule.obj-code  and old-CashBookRuleAttr.code = old-CashBookRule.code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      258      create new-CashBookRuleAttr.
      259      buffer-copy old-CashBookRuleAttr to new-CashBookRuleAttr.
      260   end.
      261       end .
      262     end .
      263   for each old-OperServ  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      264      create new-OperServ.
      265      buffer-copy old-OperServ to new-OperServ.
      266   end.
      267   for each old-OperServAttr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      268      create new-OperServAttr.
      269      buffer-copy old-OperServAttr to new-OperServAttr.
      270   end.
      271   output stream str-gen close.
      272     return "Произведен экспорт таблиц: fin-bank c-fin-bank fin-bank-attr c-fin-bank-attr ~
      273   fin-code-an-uchet c-fin-code-an-uchet fin-code-cel-nazn c-fin-code-cel-nazn fin-code-cor-acc c-fin-code-cor-acc ~
      274   fin-schet c-fin-schet fin-schet-attr c-fin-schet-attr cbr-bank c-cbr-bank cbr-bank-attr c-cbr-bank-attr ~
      275   CashBook CashBookAttr CashBookRule CashBookRuleAttr OperServ OperServAttr .".
