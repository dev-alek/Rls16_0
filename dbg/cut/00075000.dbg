        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 4c8fe616231f, 2126, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        4   define variable vss-date        as character no-undo init "$Date: Wed Dec 25 15:23:53 2019 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00075000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00075000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 75.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
