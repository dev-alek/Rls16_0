      144      create new-fin-schet.
      145      buffer-copy old-fin-schet to new-fin-schet.
      146   end.
      147     if varstay-history then do:
      148   for each old-c-fin-schet  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      149      create new-c-fin-schet.
