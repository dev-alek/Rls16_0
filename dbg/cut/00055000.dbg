        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00055000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00055000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 10.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define  shared temp-table tt-objs no-undo
       13     field obj-type as character
       14     field obj-code as integer
       15     index pi is unique primary obj-type obj-code
       16     .
       17       define buffer buf_new_clients       for dst.clients.
       18       define buffer buf_old_fbr-doc       for src.fbr-doc.
       19       define buffer buf_old_fbr-pln       for src.fbr-pln.
       20       define buffer buf_old_fbr-gds-obj           for src.fbr-gds-obj.
       21       define buffer buf_new_fbr-gds-obj           for dst.fbr-gds-obj.
       22       define buffer buf_old_c-fbr-gds-obj         for src.c-fbr-gds-obj.
       23       define buffer buf_new_c-fbr-gds-obj         for dst.c-fbr-gds-obj.
       24       define buffer buf_old_fbr-gds-obj-attr           for src.fbr-gds-obj-attr.
       25       define buffer buf_new_fbr-gds-obj-attr           for dst.fbr-gds-obj-attr.
       26       define buffer buf_old_c-fbr-gds-obj-attr         for src.c-fbr-gds-obj-attr.
       27       define buffer buf_new_c-fbr-gds-obj-attr         for dst.c-fbr-gds-obj-attr.
       28       define buffer new-doc-fbr-gds for dst.doc-fbr-gds.
       29   define buffer old-doc-fbr-gds-attr for src.doc-fbr-gds-attr.
       30   define buffer new-doc-fbr-gds-attr for dst.doc-fbr-gds-attr.
       31       define buffer buf_new_goods     for dst.goods.
       32   do
       33   for buf_new_clients
       34     , buf_old_fbr-doc
       35     , buf_old_fbr-pln
       36     , buf_old_fbr-gds-obj
       37     , buf_new_fbr-gds-obj
       38     , buf_old_c-fbr-gds-obj
       39     , buf_new_c-fbr-gds-obj
       40     , buf_old_fbr-gds-obj-attr
       41     , buf_new_fbr-gds-obj-attr
       42     , buf_old_c-fbr-gds-obj-attr
       43     , buf_new_c-fbr-gds-obj-attr
       44     , buf_new_goods
       45   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       46   :
       47   define input parameter vartype-cut            as integer   no-undo.
       48   define input parameter varlist-db             as character no-undo.
       49   define input parameter vardate-actual-goods   as date      no-undo.
       50   define input parameter vardate-actual-docs    as date      no-undo.
       51   define input parameter vardate-actual-findoc  as date      no-undo.
       52   define input parameter vardate-output-zone    as date      no-undo.
       53   define input parameter varstay-recipe-goods   as logical   no-undo.
       54   define input parameter varstay-weight-goods   as logical   no-undo.
       55   define input parameter varnot-copy-del-goods  as logical   no-undo.
       56   define input parameter varstay-history        as logical   no-undo.
       57   define input parameter vargen-file            as character no-undo.
       58   define stream str-gen.
       59   output stream str-gen to vargen-file append.
       60   if not connected("src") then do:
       61      return error "Нет коннекта с базой 'src'.".
       62   end.
       63   if not connected("dst") then do:
       64      return error "Нет коннекта с базой 'dst'.".
       65   end.
       66   find src.sys-ctrl no-lock.
       67   if not available src.sys-ctrl then do:
       68      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       69   end.
       70   if src.sys-ctrl.db-num <> 0 then do:
       71      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       72   end.
       73   if vardate-actual-docs <> ? and
       74      (vardate-actual-goods   > vardate-actual-docs or
       75       vardate-actual-goods   = ? )   then do:
       76         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       77                                 "Дата актуальности товаров &1."        +
       78                                 "Дата актуальности документов &2."     +
       79                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       80                                 vardate-actual-goods,
       81                                 vardate-actual-docs).
       82   end.
       83   on WRITE of dst.fbr-doc  override do: end.
       84   on WRITE of dst.fbr-line override do: end.
       85   on WRITE of dst.fbr-pln override do: end.
       86   on WRITE of dst.fbr-gds-obj override do: end.
       87   on WRITE of dst.c-fbr-gds-obj override do: end.
       88   on WRITE of dst.fbr-gds-obj-attr override do: end.
       89   on WRITE of dst.c-fbr-gds-obj-attr override do: end.
       90   on WRITE of dst.doc-fbr-gds-attr override DO: END.
       91   on WRITE of dst.c-gds-hist override DO: END.
       92       for each buf_new_clients no-lock
       93          where buf_new_clients.db-num <> ?
       94       on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       95       :
       96           if vartype-cut = 1
       97           then do:
       98               find first tt-objs
       99                    where tt-objs.obj-type = buf_new_clients.obj-type
      100                      and tt-objs.obj-code = buf_new_clients.obj-code
      101               no-error.
      102           end.
      103           if vartype-cut = 0
      104           or ( vartype-cut = 1 and available tt-objs )
      105           then do:
      106               for each buf_old_fbr-gds-obj no-lock
      107                  where buf_old_fbr-gds-obj.obj-type = buf_new_clients.obj-type
      108                    and buf_old_fbr-gds-obj.obj-code = buf_new_clients.obj-code
      109               on error undo, return error
      110               :
      111                   find first buf_new_goods no-lock
      112                        where buf_new_goods.gds-code = buf_old_fbr-gds-obj.gds-code
      113                   no-error.
      114                   if available buf_new_goods
      115                   then do:
      116                       create buf_new_fbr-gds-obj.
      117                       buffer-copy buf_old_fbr-gds-obj to buf_new_fbr-gds-obj.
      118                       if varstay-history then do:
      119                         for each buf_old_c-fbr-gds-obj no-lock
      120                           where buf_old_c-fbr-gds-obj.obj-type = buf_old_fbr-gds-obj.obj-type
      121                             and buf_old_c-fbr-gds-obj.obj-code = buf_old_fbr-gds-obj.obj-code
      122                             and buf_old_c-fbr-gds-obj.gds-code = buf_old_fbr-gds-obj.gds-code
      123                         on error undo, return error
      124                         :
      125                             create buf_new_c-fbr-gds-obj.
      126                             buffer-copy buf_old_c-fbr-gds-obj to buf_new_c-fbr-gds-obj.
      127                         end.
      128                         for each buf_old_c-fbr-gds-obj-attr no-lock
      129                           where buf_old_c-fbr-gds-obj-attr.obj-type = buf_old_fbr-gds-obj-attr.obj-type
      130                             and buf_old_c-fbr-gds-obj-attr.obj-code = buf_old_fbr-gds-obj-attr.obj-code
      131                             and buf_old_c-fbr-gds-obj-attr.gds-code = buf_old_fbr-gds-obj-attr.gds-code
      132                         on error undo, return error
      133                         :
      134                             create buf_new_c-fbr-gds-obj-attr.
      135                             buffer-copy buf_old_c-fbr-gds-obj-attr to buf_new_c-fbr-gds-obj-attr.
      136                         end.
      137                       end.
      138                       for each buf_old_fbr-gds-obj-attr no-lock
      139                          where buf_old_fbr-gds-obj-attr.obj-type = buf_old_fbr-gds-obj.obj-type
      140                            and buf_old_fbr-gds-obj-attr.obj-code = buf_old_fbr-gds-obj.obj-code
      141                            and buf_old_fbr-gds-obj-attr.gds-code = buf_old_fbr-gds-obj.gds-code
      142                       on error undo, return error
      143                       :
      144                           create buf_new_fbr-gds-obj-attr.
      145                           buffer-copy buf_old_fbr-gds-obj-attr to buf_new_fbr-gds-obj-attr.
      146                       end.
      147                   end.
      148               end.
      149               if vardate-actual-docs <> ?
      150               then do:
      151                   for each buf_old_fbr-doc no-lock
      152                      where buf_old_fbr-doc.obj-type = buf_new_clients.obj-type
      153                        and buf_old_fbr-doc.obj-code = buf_new_clients.obj-code
      154                        and buf_old_fbr-doc.fact-date >= vardate-actual-docs
      155                   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      156                   :
      157                       run copy-records-to-new in this-procedure (
      158                           input rowid( buf_old_fbr-doc )
      159                       ).
      160                   end.
      161                   for each buf_old_fbr-pln no-lock
      162                      where buf_old_fbr-pln.obj-type = buf_new_clients.obj-type
      163                        and buf_old_fbr-pln.obj-code = buf_new_clients.obj-code
      164                        and buf_old_fbr-pln.fact-date >= vardate-actual-docs
      165                   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      166                   :
      167                       run copy-fbr-pln-to-new in this-procedure (
      168                           input rowid( buf_old_fbr-pln )
      169                       ).
      170                   end.
      171               end.
      172           end.
      173           else do:
      174               for each buf_old_fbr-doc no-lock
      175                  where buf_old_fbr-doc.obj-type = buf_new_clients.obj-type
      176                    and buf_old_fbr-doc.obj-code = buf_new_clients.obj-code
      177               on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      178               :
      179                   run copy-records-to-new in this-procedure (
      180                       input rowid( buf_old_fbr-doc )
      181                   ).
      182               end.
      183               for each buf_old_fbr-pln no-lock
      184                  where buf_old_fbr-pln.obj-type = buf_new_clients.obj-type
      185                    and buf_old_fbr-pln.obj-code = buf_new_clients.obj-code
      186               on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      187               :
      188                   run copy-fbr-pln-to-new in this-procedure (
      189                       input rowid( buf_old_fbr-pln )
      190                   ).
      191               end.
      192           end.
      193       end.
      194       for each old-doc-fbr-gds-attr
      195           no-lock
      196           :
      197          FIND first new-doc-fbr-gds
      198               where new-doc-fbr-gds.obj-type     = old-doc-fbr-gds-attr.obj-type
      199               and new-doc-fbr-gds.obj-code     = old-doc-fbr-gds-attr.obj-code
      200               and new-doc-fbr-gds.fbr-obj-type = old-doc-fbr-gds-attr.fbr-obj-type
      201               and new-doc-fbr-gds.fbr-obj-code = old-doc-fbr-gds-attr.fbr-obj-code
      202               and new-doc-fbr-gds.out-code     = old-doc-fbr-gds-attr.out-code
      203               no-lock
      204               no-error
      205               .
      206          IF AVAILABLE new-doc-fbr-gds
      207          THEN DO:
      208            create new-doc-fbr-gds-attr.
      209            BUFFER-COPY old-doc-fbr-gds-attr to new-doc-fbr-gds-attr.
      210          END.
      211       end.
      212       output stream str-gen close.
      213       return "Произведен экспорт таблиц: fbr-doc fbr-line recipe-develop fbr-pln fbr-pln-line fbr-history doc-fbr-gds-attr.".
      214   end.
      215   procedure copy-fbr-pln-to-new :
      216   define input parameter p-old-fbr-pln-rowid  as rowid            no-undo.
      217       define variable v-need-copy-fbr-line          as logical      no-undo.
      218       define buffer buf_old_fbr-pln               for src.fbr-pln.
      219       define buffer buf_new_fbr-pln               for dst.fbr-pln.
      220       define buffer buf_old_c-fbr-pln               for src.c-fbr-pln.
      221       define buffer buf_new_c-fbr-pln               for dst.c-fbr-pln.
      222       define buffer buf_old_fbr-pln-line          for src.fbr-pln-line.
      223       define buffer buf_new_fbr-pln-line          for dst.fbr-pln-line.
      224       define buffer buf_old_c-fbr-pln-line          for src.c-fbr-pln-line.
      225       define buffer buf_new_c-fbr-pln-line          for dst.c-fbr-pln-line.
      226       define buffer buf_old_fbr-history           for src.fbr-history.
      227       define buffer buf_new_fbr-history           for dst.fbr-history.
      228       define buffer buf_new_test_fbr-history      for dst.fbr-history.
      229       define buffer buf_old_c-doc-fbr-gds         for src.c-doc-fbr-gds.
      230       define buffer buf_new_c-doc-fbr-gds         for dst.c-doc-fbr-gds.
      231       define buffer buf_new_test_c-doc-fbr-gds    for dst.c-doc-fbr-gds.
      232       define buffer buf_new_goods                 for dst.goods.
      233   do
      234   for buf_old_fbr-pln
      235     , buf_new_fbr-pln
      236     , buf_old_c-fbr-pln
      237     , buf_new_c-fbr-pln
      238     , buf_old_fbr-pln-line
      239     , buf_new_fbr-pln-line
      240     , buf_old_c-fbr-pln-line
      241     , buf_new_c-fbr-pln-line
      242     , buf_old_fbr-history
      243     , buf_new_fbr-history
      244     , buf_new_test_fbr-history
      245     , buf_old_c-doc-fbr-gds
      246     , buf_new_c-doc-fbr-gds
      247     , buf_new_test_c-doc-fbr-gds
      248     , buf_new_goods
      249   on error undo, return error
      250   :
      251       find first buf_old_fbr-pln no-lock
      252            where rowid( buf_old_fbr-pln ) = p-old-fbr-pln-rowid
      253       .
      254              for each buf_old_c-fbr-pln no-lock
      255                 where buf_old_c-fbr-pln.doc-code  = buf_old_fbr-pln.doc-code
      256               on error undo, return error
      257               :
      258                 create buf_new_c-fbr-pln.
      259                 buffer-copy buf_old_c-fbr-pln to buf_new_c-fbr-pln.
      260               end.
      261       create buf_new_fbr-pln.
      262       buffer-copy buf_old_fbr-pln to buf_new_fbr-pln.
      263       assign
      264           v-need-copy-fbr-line = yes
      265       .
      266       for each buf_old_fbr-pln-line no-lock
      267          where buf_old_fbr-pln-line.doc-code = buf_old_fbr-pln.doc-code
      268       on error undo, return error
      269       :
      270           find first buf_new_goods no-lock
      271                where buf_new_goods.gds-code = buf_old_fbr-pln-line.gds-code
      272           no-error.
      273           if not available buf_new_goods
      274           then do:
      275               assign
      276                   v-need-copy-fbr-line = no
      277               .
      278           end.
      279       end.
      280       if v-need-copy-fbr-line = yes
      281       then do:
      282           for each buf_old_fbr-pln-line no-lock
      283              where buf_old_fbr-pln-line.doc-code = buf_old_fbr-pln.doc-code
      284           on error undo, return error
      285           :
      286               for each buf_old_c-fbr-pln-line no-lock
      287                 where buf_old_c-fbr-pln-line.doc-code = buf_old_fbr-pln.doc-code and
      288                       buf_old_c-fbr-pln-line.fbr-obj-type = buf_old_fbr-pln-line.fbr-obj-type  and
      289                       buf_old_c-fbr-pln-line.fbr-obj-code = buf_old_fbr-pln-line.fbr-obj-code  and
      290                       buf_old_c-fbr-pln-line.gds-code     = buf_old_fbr-pln-line.gds-code      and
      291                       buf_old_c-fbr-pln-line.recipe-code  = buf_old_fbr-pln-line.recipe-code
      292               on error undo, return error
      293               :
      294                 create buf_new_c-fbr-pln-line.
      295                 buffer-copy buf_old_c-fbr-pln-line to buf_new_c-fbr-pln-line.
      296               end.
      297               create buf_new_fbr-pln-line.
      298               buffer-copy buf_old_fbr-pln-line to buf_new_fbr-pln-line.
      299               for each buf_old_c-doc-fbr-gds no-lock
      300                  where buf_old_c-doc-fbr-gds.obj-type = buf_old_fbr-pln.obj-type
      301                    and buf_old_c-doc-fbr-gds.obj-code = buf_old_fbr-pln.obj-code
      302                    and buf_old_c-doc-fbr-gds.gds-code = buf_old_fbr-pln-line.gds-code
      303               on error undo, return error
      304               :
      305                   find first buf_new_test_c-doc-fbr-gds no-lock
      306                        where buf_new_test_c-doc-fbr-gds.obj-type     = buf_old_c-doc-fbr-gds.obj-type
      307                          and buf_new_test_c-doc-fbr-gds.obj-code     = buf_old_c-doc-fbr-gds.obj-code
      308                          and buf_new_test_c-doc-fbr-gds.fbr-obj-type = buf_old_c-doc-fbr-gds.fbr-obj-type
      309                          and buf_new_test_c-doc-fbr-gds.fbr-obj-code = buf_old_c-doc-fbr-gds.fbr-obj-code
      310                          and buf_new_test_c-doc-fbr-gds.out-code     = buf_old_c-doc-fbr-gds.out-code
      311                          and buf_new_test_c-doc-fbr-gds.chip-num     = buf_old_c-doc-fbr-gds.chip-num
      312                          and buf_new_test_c-doc-fbr-gds.gds-code     = buf_old_c-doc-fbr-gds.gds-code
      313                   no-error.
      314                   if not available buf_new_test_c-doc-fbr-gds
      315                   then do:
      316                       create buf_new_c-doc-fbr-gds.
      317                       buffer-copy buf_old_c-doc-fbr-gds to buf_new_c-doc-fbr-gds.
      318                   end.
      319               end.
      320           end.
      321       end.
      322       for each buf_old_fbr-history no-lock
      323          where buf_old_fbr-history.obj-type = buf_old_fbr-pln.obj-type
      324            and buf_old_fbr-history.obj-code = buf_old_fbr-pln.obj-code
      325            and buf_old_fbr-history.doc-code = buf_old_fbr-pln.doc-code
      326       on error undo, return error
      327       :
      328           find first buf_new_test_fbr-history no-lock
      329                where buf_new_test_fbr-history.obj-type = buf_old_fbr-pln.obj-type
      330                  and buf_new_test_fbr-history.obj-code = buf_old_fbr-pln.obj-code
      331                  and buf_new_test_fbr-history.hst-code = buf_old_fbr-history.hst-code
      332           no-error.
      333           if not available buf_new_test_fbr-history
      334           then do:
      335               create buf_new_fbr-history.
      336               buffer-copy buf_old_fbr-history to buf_new_fbr-history.
      337           end.
      338       end.
      339   end.
      340   end procedure.
      341   procedure copy-records-to-new :
      342   define input parameter p-old-fbr-doc-rowid  as rowid            no-undo.
      343       define variable v-need-copy-fbr-line          as logical      no-undo.
      344       define variable v-need-copy-recipe-develop    as logical      no-undo.
      345       define buffer buf_old_fbr-doc               for src.fbr-doc.
      346       define buffer buf_new_fbr-doc               for dst.fbr-doc.
      347       define buffer buf_old_fbr-line              for src.fbr-line.
      348       define buffer buf_new_fbr-line              for dst.fbr-line.
      349       define buffer buf_old_fbr-recipe            for src.fbr-recipe.
      350       define buffer buf_new_fbr-recipe            for dst.fbr-recipe.
      351       define buffer buf_old_fbr-recipe-gds        for src.fbr-recipe-gds.
      352       define buffer buf_new_fbr-recipe-gds        for dst.fbr-recipe-gds.
      353       define buffer buf_old_recipe-develop        for src.recipe-develop.
      354       define buffer buf_new_recipe-develop        for dst.recipe-develop.
      355       define buffer buf_old_fbr-history           for src.fbr-history.
      356       define buffer buf_new_fbr-history           for dst.fbr-history.
      357       define buffer buf_new_test_fbr-history      for dst.fbr-history.
      358       define buffer buf_old_c-doc-fbr-gds         for src.c-doc-fbr-gds.
      359       define buffer buf_new_c-doc-fbr-gds         for dst.c-doc-fbr-gds.
      360       define buffer buf_new_test_c-doc-fbr-gds    for dst.c-doc-fbr-gds.
      361       define buffer buf_new_goods     for dst.goods.
      362   do
      363   for buf_old_fbr-doc
      364     , buf_new_fbr-doc
      365     , buf_old_fbr-line
      366     , buf_new_fbr-line
      367     , buf_old_fbr-recipe
      368     , buf_new_fbr-recipe
      369     , buf_old_fbr-recipe-gds
      370     , buf_new_fbr-recipe-gds
      371     , buf_old_recipe-develop
      372     , buf_new_recipe-develop
      373     , buf_old_fbr-history
      374     , buf_new_fbr-history
      375     , buf_new_test_fbr-history
      376     , buf_old_c-doc-fbr-gds
      377     , buf_new_c-doc-fbr-gds
      378     , buf_new_test_c-doc-fbr-gds
      379     , buf_new_goods
      380   on error undo, return error
      381   :
      382       find first buf_old_fbr-doc no-lock
      383            where rowid( buf_old_fbr-doc ) = p-old-fbr-doc-rowid
      384       .
      385       create buf_new_fbr-doc.
      386       buffer-copy buf_old_fbr-doc to buf_new_fbr-doc.
      387       assign
      388           v-need-copy-fbr-line    = yes
      389       .
      390       for each buf_old_fbr-line no-lock
      391          where buf_old_fbr-line.doc-code = buf_old_fbr-doc.doc-code
      392       :
      393           find first buf_new_goods no-lock
      394                where buf_new_goods.artic     = buf_old_fbr-line.artic
      395                  and buf_new_goods.prod-type = buf_old_fbr-line.prod-type
      396                  and buf_new_goods.prod-code = buf_old_fbr-line.prod-code
      397           no-error.
      398           if not available buf_new_goods
      399           then do:
      400               assign
      401                   v-need-copy-fbr-line    = no
      402               .
      403           end.
      404       end.
      405       if v-need-copy-fbr-line    = yes
      406       then do:
      407           for each buf_old_fbr-line no-lock
      408           where buf_old_fbr-line.doc-code = buf_old_fbr-doc.doc-code
      409           :
      410               create buf_new_fbr-line.
      411               buffer-copy buf_old_fbr-line to buf_new_fbr-line.
      412               find first buf_new_goods no-lock
      413                    where buf_new_goods.artic     = buf_old_fbr-line.artic
      414                      and buf_new_goods.prod-type = buf_old_fbr-line.prod-type
      415                      and buf_new_goods.prod-code = buf_old_fbr-line.prod-code
      416               .
      417               for each buf_old_c-doc-fbr-gds no-lock
      418                  where buf_old_c-doc-fbr-gds.obj-type = buf_old_fbr-doc.obj-type
      419                    and buf_old_c-doc-fbr-gds.obj-code = buf_old_fbr-doc.obj-code
      420                    and buf_old_c-doc-fbr-gds.gds-code = buf_new_goods.gds-code
      421               on error undo, return error
      422               :
      423                   find first buf_new_test_c-doc-fbr-gds no-lock
      424                        where buf_new_test_c-doc-fbr-gds.obj-type     = buf_old_c-doc-fbr-gds.obj-type
      425                          and buf_new_test_c-doc-fbr-gds.obj-code     = buf_old_c-doc-fbr-gds.obj-code
      426                          and buf_new_test_c-doc-fbr-gds.fbr-obj-type = buf_old_c-doc-fbr-gds.fbr-obj-type
      427                          and buf_new_test_c-doc-fbr-gds.fbr-obj-code = buf_old_c-doc-fbr-gds.fbr-obj-code
      428                          and buf_new_test_c-doc-fbr-gds.out-code     = buf_old_c-doc-fbr-gds.out-code
      429                          and buf_new_test_c-doc-fbr-gds.chip-num     = buf_old_c-doc-fbr-gds.chip-num
      430                          and buf_new_test_c-doc-fbr-gds.gds-code     = buf_old_c-doc-fbr-gds.gds-code
      431                   no-error.
      432                   if not available buf_new_test_c-doc-fbr-gds
      433                   then do:
      434                       create buf_new_c-doc-fbr-gds.
      435                       buffer-copy buf_old_c-doc-fbr-gds to buf_new_c-doc-fbr-gds.
      436                   end.
      437               end.
      438               if buf_old_fbr-line.recipe-code <> ?
      439               and buf_old_fbr-line.recipe-code <> "":U
      440               then do:
      441                   if buf_old_fbr-line.is-comp = yes
      442                   then do:
      443                       assign
      444                           v-need-copy-recipe-develop = yes
      445                       .
      446                       for each buf_old_recipe-develop no-lock
      447                          where buf_old_recipe-develop.recipe-code = buf_old_fbr-line.recipe-code
      448                            and buf_old_recipe-develop.doc-code    = buf_old_fbr-line.doc-code
      449                       on error undo, return error
      450                       :
      451                           find first buf_new_goods no-lock
      452                                where buf_new_goods.gds-code = buf_old_recipe-develop.gds-code
      453                           no-error.
      454                           if not available buf_new_goods
      455                           then do:
      456                               assign
      457                                   v-need-copy-recipe-develop = no
      458                               .
      459                           end.
      460                       end.
      461                       if v-need-copy-recipe-develop = yes
      462                       then do:
      463                           for each buf_old_recipe-develop no-lock
      464                              where buf_old_recipe-develop.recipe-code = buf_old_fbr-line.recipe-code
      465                                and buf_old_recipe-develop.doc-code    = buf_old_fbr-line.doc-code
      466                           on error undo, return error
      467                           :
      468                               create buf_new_recipe-develop.
      469                               buffer-copy buf_old_recipe-develop to buf_new_recipe-develop.
      470                           end.
      471                       end.
      472                   end.
      473                   find first buf_new_fbr-recipe no-lock
      474                        where buf_new_fbr-recipe.doc-code      = buf_old_fbr-line.doc-code
      475                          and buf_new_fbr-recipe.recipe-code   = buf_old_fbr-line.recipe-code
      476                   no-error.
      477                   if not available buf_new_fbr-recipe
      478                   then do:
      479                       for each buf_old_fbr-recipe no-lock
      480                       where buf_old_fbr-recipe.doc-code    = buf_old_fbr-line.doc-code
      481                           and buf_old_fbr-recipe.recipe-code = buf_old_fbr-line.recipe-code
      482                       :
      483                           create buf_new_fbr-recipe.
      484                           buffer-copy buf_old_fbr-recipe to buf_new_fbr-recipe.
      485                           for each buf_old_fbr-recipe-gds no-lock
      486                              where buf_old_fbr-recipe-gds.doc-code    = buf_old_fbr-recipe.doc-code
      487                                and buf_old_fbr-recipe-gds.recipe-code = buf_old_fbr-recipe.recipe-code
      488                           on error undo, return error
      489                           :
      490                               create buf_new_fbr-recipe-gds.
      491                               buffer-copy buf_old_fbr-recipe-gds to buf_new_fbr-recipe-gds.
      492                           end.
      493                       end.
      494                   end.
      495               end.
      496           end.
      497       end.
      498       for each buf_old_fbr-history no-lock
      499          where buf_old_fbr-history.obj-type = buf_old_fbr-doc.obj-type
      500            and buf_old_fbr-history.obj-code = buf_old_fbr-doc.obj-code
      501            and buf_old_fbr-history.doc-code = buf_old_fbr-doc.doc-code
      502       on error undo, return error
      503       :
      504           find first buf_new_test_fbr-history no-lock
      505                where buf_new_test_fbr-history.obj-type = buf_old_fbr-doc.obj-type
      506                  and buf_new_test_fbr-history.obj-code = buf_old_fbr-doc.obj-code
      507                  and buf_new_test_fbr-history.hst-code = buf_old_fbr-history.hst-code
      508           no-error.
      509           if not available buf_new_test_fbr-history
      510           then do:
      511               create buf_new_fbr-history.
      512               buffer-copy buf_old_fbr-history to buf_new_fbr-history.
      513           end.
      514       end.
      515   end.
      516   end procedure.
