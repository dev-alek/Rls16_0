        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00019000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00019000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 19.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-tax              for src.tax             .
       13   define buffer new-tax              for dst.tax             .
       14   define buffer old-c-tax            for src.c-tax           .
       15   define buffer new-c-tax            for dst.c-tax           .
       16   define buffer old-tax-attr         for src.tax-attr        .
       17   define buffer new-tax-attr         for dst.tax-attr        .
       18   define buffer old-tax-rate-gds     for src.tax-rate-gds    .
       19   define buffer new-tax-rate-gds     for dst.tax-rate-gds    .
       20   define buffer old-tax-rate-gds-attr for src.tax-rate-gds-attr .
       21   define buffer new-tax-rate-gds-attr for dst.tax-rate-gds-attr .
       22   define buffer old-tax-rate         for src.tax-rate        .
       23   define buffer new-tax-rate         for dst.tax-rate        .
       24   define buffer old-c-tax-rate       for src.c-tax-rate      .
       25   define buffer new-c-tax-rate       for dst.c-tax-rate      .
       26   define buffer old-tax-rate-attr    for src.tax-rate-attr   .
       27   define buffer new-tax-rate-attr    for dst.tax-rate-attr   .
       28   define buffer old-tax-rate-value   for src.tax-rate-value  .
       29   define buffer new-tax-rate-value   for dst.tax-rate-value  .
       30   define buffer old-tax-rate-value-attr   for src.tax-rate-value-attr .
       31   define buffer new-tax-rate-value-attr   for dst.tax-rate-value-attr  .
       32   define buffer old-c-tax-rate-gds-grp for src.c-tax-rate-gds-grp.
       33   define buffer new-c-tax-rate-gds-grp for dst.c-tax-rate-gds-grp.
       34   define buffer old-tax-rate-gds-grp for src.tax-rate-gds-grp.
       35   define buffer new-tax-rate-gds-grp for dst.tax-rate-gds-grp.
       36   define buffer old-tax-rate-gds-grp-attr for src.tax-rate-gds-grp-attr.
       37   define buffer new-tax-rate-gds-grp-attr for dst.tax-rate-gds-grp-attr.
       38   define buffer old-tax-units        for src.tax-units       .
       39   define buffer new-tax-units        for dst.tax-units       .
       40   define buffer old-c-tax-units      for src.c-tax-units       .
       41   define buffer new-c-tax-units      for dst.c-tax-units       .
       42   define buffer old-tax-units-attr   for src.tax-units-attr       .
       43   define buffer new-tax-units-attr   for dst.tax-units-attr       .
       44   define buffer old-c-tax-hist       for src.c-tax-hist       .
       45   define buffer new-c-tax-hist       for dst.c-tax-hist       .
       46   define buffer new-goods            for dst.goods.
       47   do
       48   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       49   define input parameter vartype-cut            as integer   no-undo.
       50   define input parameter varlist-db             as character no-undo.
       51   define input parameter vardate-actual-goods   as date      no-undo.
       52   define input parameter vardate-actual-docs    as date      no-undo.
       53   define input parameter vardate-actual-findoc  as date      no-undo.
       54   define input parameter vardate-output-zone    as date      no-undo.
       55   define input parameter varstay-recipe-goods   as logical   no-undo.
       56   define input parameter varstay-weight-goods   as logical   no-undo.
       57   define input parameter varnot-copy-del-goods  as logical   no-undo.
       58   define input parameter varstay-history        as logical   no-undo.
       59   define input parameter vargen-file            as character no-undo.
       60   define stream str-gen.
       61   output stream str-gen to vargen-file append.
       62   if not connected("src") then do:
       63      return error "Нет коннекта с базой 'src'.".
       64   end.
       65   if not connected("dst") then do:
       66      return error "Нет коннекта с базой 'dst'.".
       67   end.
       68   find src.sys-ctrl no-lock.
       69   if not available src.sys-ctrl then do:
       70      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       71   end.
       72   if src.sys-ctrl.db-num <> 0 then do:
       73      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       74   end.
       75   if vardate-actual-docs <> ? and
       76      (vardate-actual-goods   > vardate-actual-docs or
       77       vardate-actual-goods   = ? )   then do:
       78         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       79                                 "Дата актуальности товаров &1."        +
       80                                 "Дата актуальности документов &2."     +
       81                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       82                                 vardate-actual-goods,
       83                                 vardate-actual-docs).
       84   end.
       85   on WRITE of dst.tax                override do: end.
       86   on WRITE of dst.tax-attr           override do: end.
       87   on WRITE of dst.c-tax              override do: end.
       88   on WRITE of dst.tax-rate-gds       override do: end.
       89   on WRITE of dst.tax-rate-gds-attr  override do: end.
       90   on WRITE of dst.tax-rate           override do: end.
       91   on WRITE of dst.c-tax-rate         override do: end.
       92   on WRITE of dst.tax-rate-attr      override do: end.
       93   on WRITE of dst.tax-rate-value     override do: end.
       94   on WRITE of dst.tax-rate-value-attr override do: end.
       95   on WRITE of dst.tax-rate-gds-grp   override do: end.
       96   on WRITE of dst.c-tax-rate-gds-grp override do: end.
       97   on WRITE of dst.tax-rate-gds-grp-attr   override do: end.
       98   on WRITE of dst.tax-units          override do: end.
       99   on WRITE of dst.c-tax-units        override do: end.
      100   on WRITE of dst.tax-units-attr     override do: end.
      101   on WRITE of dst.c-tax-hist         override do: end.
      102   for each old-tax  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      103      create new-tax.
      104      buffer-copy old-tax to new-tax.
      105   end.
      106   for each old-tax-rate-gds no-lock,
      107      first new-goods where new-goods.gds-code    = old-tax-rate-gds.gds-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      108     create new-tax-rate-gds.
      109     buffer-copy old-tax-rate-gds to new-tax-rate-gds.
      110   end.
      111   for each old-tax-rate-gds-attr no-lock,
      112      first new-goods where new-goods.gds-code    = old-tax-rate-gds-attr.gds-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      113     create new-tax-rate-gds-attr.
      114     buffer-copy old-tax-rate-gds-attr to new-tax-rate-gds-attr.
      115   end.
      116   for each old-tax-rate  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      117      create new-tax-rate.
      118      buffer-copy old-tax-rate to new-tax-rate.
      119   end.
      120   for each old-tax-rate-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      121      create new-tax-rate-attr.
      122      buffer-copy old-tax-rate-attr to new-tax-rate-attr.
      123   end.
      124   for each old-tax-rate-value  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      125      create new-tax-rate-value.
      126      buffer-copy old-tax-rate-value to new-tax-rate-value.
      127   end.
      128   for each old-tax-rate-value-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      129      create new-tax-rate-value-attr.
      130      buffer-copy old-tax-rate-value-attr to new-tax-rate-value-attr.
      131   end.
      132   for each old-tax-rate-gds-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      133      create new-tax-rate-gds-grp.
      134      buffer-copy old-tax-rate-gds-grp to new-tax-rate-gds-grp.
      135   end.
      136   for each old-tax-rate-gds-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      137      create new-tax-rate-gds-grp-attr.
      138      buffer-copy old-tax-rate-gds-grp-attr to new-tax-rate-gds-grp-attr.
      139   end.
      140   for each old-tax-units  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      141      create new-tax-units.
      142      buffer-copy old-tax-units to new-tax-units.
      143   end.
      144   for each old-tax-units-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      145      create new-tax-units-attr.
      146      buffer-copy old-tax-units-attr to new-tax-units-attr.
      147   end.
      148   if varstay-history then do:
      149   for each old-c-tax  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      150      create new-c-tax.
      151      buffer-copy old-c-tax to new-c-tax.
      152   end.
      153   for each old-c-tax-rate  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      154      create new-c-tax-rate.
      155      buffer-copy old-c-tax-rate to new-c-tax-rate.
      156   end.
      157   for each old-c-tax-rate-gds-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      158      create new-c-tax-rate-gds-grp.
      159      buffer-copy old-c-tax-rate-gds-grp to new-c-tax-rate-gds-grp.
      160   end.
      161   for each old-c-tax-units  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      162      create new-c-tax-units.
      163      buffer-copy old-c-tax-units to new-c-tax-units.
      164   end.
      165   for each old-c-tax-hist  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      166      create new-c-tax-hist.
      167      buffer-copy old-c-tax-hist to new-c-tax-hist.
      168   end.
      169   end.
      170   output stream str-gen close.
      171   return "Произведен экспорт таблиц: tax c-tax-hist c-tax tax-attr tax-rate-gds tax-rate-gds-attr tax-rate c-tax-rate tax-rate-attr tax-rate-value tax-rate-value-attr ~
      172   tax-rate-gds-grp c-tax-rate-gds-grp tax-rate-gds-grp-attr tax-units c-tax-units tax-units-attr ".
      173   end.
