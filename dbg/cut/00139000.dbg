        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00139000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00139000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 139.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-pck-rcvd        for src.pck-rcvd.
       13   define buffer new-pck-rcvd        for dst.pck-rcvd.
       14   define buffer old-pck-rcvd-attr        for src.pck-rcvd-attr.
       15   define buffer new-pck-rcvd-attr        for dst.pck-rcvd-attr.
       16   define buffer old-pck-sent        for src.pck-sent.
       17   define buffer new-pck-sent        for dst.pck-sent.
       18   define buffer old-pck-sent-attr   for src.pck-sent-attr.
       19   define buffer new-pck-sent-attr   for dst.pck-sent-attr.
       20   define buffer old-pck-keys        for src.pck-keys.
       21   define buffer new-pck-keys        for dst.pck-keys.
       22   define buffer old-route           for src.route.
       23   define buffer new-route           for dst.route.
       24   define buffer old-route-attr      for src.route-attr.
       25   define buffer new-route-attr      for dst.route-attr.
       26   define buffer old-route-dump      for src.route-dump.
       27   define buffer new-route-dump      for dst.route-dump.
       28   define buffer old-route-dump-attr for src.route-dump-attr.
       29   define buffer new-route-dump-attr for dst.route-dump-attr.
       30   define buffer old-route-dump-link for src.route-dump-link.
       31   define buffer new-route-dump-link for dst.route-dump-link.
       32   do
       33   on error undo, return error substitute( "&1 &2 &3", return-value, error-status :get-message(1), error-status :get-message(2))
       34   on stop  undo, return error substitute( "stop" )
       35   :
       36     define variable v-msg as character no-undo .
       37     define buffer buf_db for src.db .
       38   define input parameter vartype-cut            as integer   no-undo.
       39   define input parameter varlist-db             as character no-undo.
       40   define input parameter vardate-actual-goods   as date      no-undo.
       41   define input parameter vardate-actual-docs    as date      no-undo.
       42   define input parameter vardate-actual-findoc  as date      no-undo.
       43   define input parameter vardate-output-zone    as date      no-undo.
       44   define input parameter varstay-recipe-goods   as logical   no-undo.
       45   define input parameter varstay-weight-goods   as logical   no-undo.
       46   define input parameter varnot-copy-del-goods  as logical   no-undo.
       47   define input parameter varstay-history        as logical   no-undo.
       48   define input parameter vargen-file            as character no-undo.
       49   define stream str-gen.
       50   output stream str-gen to vargen-file append.
       51   if not connected("src") then do:
       52      return error "Нет коннекта с базой 'src'.".
       53   end.
       54   if not connected("dst") then do:
       55      return error "Нет коннекта с базой 'dst'.".
       56   end.
       57   find src.sys-ctrl no-lock.
       58   if not available src.sys-ctrl then do:
       59      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       60   end.
       61   if src.sys-ctrl.db-num <> 0 then do:
       62      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       63   end.
       64   if vardate-actual-docs <> ? and
       65      (vardate-actual-goods   > vardate-actual-docs or
       66       vardate-actual-goods   = ? )   then do:
       67         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       68                                 "Дата актуальности товаров &1."        +
       69                                 "Дата актуальности документов &2."     +
       70                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       71                                 vardate-actual-goods,
       72                                 vardate-actual-docs).
       73   end.
       74     on write of dst.route override do: end.
       75     on write of dst.pck-rcvd override do: end.
       76     on write of dst.pck-rcvd-attr override do: end.
       77     on write of dst.pck-sent override do: end.
       78     on write of dst.pck-sent-attr override do: end.
       79     if vartype-cut = 0 then do:
       80       for each buf_db
       81       on error undo, return error substitute( "&1 &2", return-value, error-status :get-message ( 1 ) )
       82       :
       83         find last old-pck-sent
       84           where old-pck-sent.db-num = buf_db.db-num
       85           use-index pi
       86           no-error
       87         .
       88         if available old-pck-sent then do:
       89           create new-pck-sent.
       90           buffer-copy old-pck-sent to new-pck-sent
       91             assign
       92               new-pck-sent.pack-num   = 0
       93               new-pck-sent.rcvd       = true
       94               new-pck-sent.total-recs = 0
       95           .
       96         end.
       97         find last old-pck-rcvd
       98           where old-pck-rcvd.db-num = buf_db.db-num
       99           use-index pi
      100           no-error
      101         .
      102         if available old-pck-rcvd then do:
      103           create new-pck-rcvd.
      104           buffer-copy old-pck-rcvd to new-pck-rcvd
      105             assign
      106               new-pck-rcvd.pack-num   = 0
      107               new-pck-rcvd.rcvd-recs  = 0
      108               new-pck-rcvd.rcvd       = true
      109               new-pck-rcvd.total-recs = 0
      110           .
      111         end.
      112       end.
      113       assign
      114         v-msg = "Игнорированы таблицы:"
      115       .
      116     end.
      117     else do:
      118   for each old-pck-rcvd  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      119      create new-pck-rcvd.
      120      buffer-copy old-pck-rcvd to new-pck-rcvd.
      121   end.
      122   for each old-pck-rcvd-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      123      create new-pck-rcvd-attr.
      124      buffer-copy old-pck-rcvd-attr to new-pck-rcvd-attr.
      125   end.
      126   for each old-pck-sent  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      127      create new-pck-sent.
      128      buffer-copy old-pck-sent to new-pck-sent.
      129   end.
      130   for each old-pck-sent-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      131      create new-pck-sent-attr.
      132      buffer-copy old-pck-sent-attr to new-pck-sent-attr.
      133   end.
      134   for each old-pck-keys  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      135      create new-pck-keys.
      136      buffer-copy old-pck-keys to new-pck-keys.
      137   end.
      138   for each old-route  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      139      create new-route.
      140      buffer-copy old-route to new-route.
      141   end.
      142   for each old-route-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      143      create new-route-attr.
      144      buffer-copy old-route-attr to new-route-attr.
      145   end.
      146   for each old-route-dump  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      147      create new-route-dump.
      148      buffer-copy old-route-dump to new-route-dump.
      149   end.
      150   for each old-route-dump-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      151      create new-route-dump-attr.
      152      buffer-copy old-route-dump-attr to new-route-dump-attr.
      153   end.
      154   for each old-route-dump-link  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      155      create new-route-dump-link.
      156      buffer-copy old-route-dump-link to new-route-dump-link.
      157   end.
      158       assign
      159         v-msg = "Произведен экспорт таблиц:"
      160       .
      161     end.
      162   output stream str-gen close.
      163     return substitute( "&1 pck-rcvd, pck-rcvd-attr, pck-sent, pck-sent-attr, pck-keys, route, route-attr, route-dump, route-dump-attr, route-dump-link.", v-msg ).
      164   end.
