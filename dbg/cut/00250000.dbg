        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00250000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00250000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 230.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-c-place-io      for src.c-place-io    .
       13   define buffer old-c-point-io      for src.c-point-io    .
       14   define buffer old-place-io        for src.place-io      .
       15   define buffer old-place-io-attr   for src.place-io-attr .
       16   define buffer old-point-io        for src.point-io      .
       17   define buffer old-point-io-attr   for src.point-io-attr .
       18   define buffer old-point-place-rel for src.point-place-rel  .
       19   define buffer old-c-point-place-rel for src.c-point-place-rel  .
       20   define buffer old-point-point-rel   for src.point-point-rel      .
       21   define buffer old-c-point-point-rel   for src.c-point-point-rel      .
       22   define buffer new-c-place-io     for dst.c-place-io     .
       23   define buffer new-c-point-io     for dst.c-point-io     .
       24   define buffer new-place-io       for dst.place-io       .
       25   define buffer new-place-io-attr  for dst.place-io-attr  .
       26   define buffer new-point-io       for dst.point-io       .
       27   define buffer new-point-io-attr  for dst.point-io-attr  .
       28   define buffer new-point-place-rel for dst.point-place-rel  .
       29   define buffer new-c-point-place-rel for dst.c-point-place-rel  .
       30   define buffer new-point-point-rel   for dst.point-point-rel       .
       31   define buffer new-c-point-point-rel   for dst.c-point-point-rel       .
       32   do
       33   on error undo, return error
       34   :
       35   define input parameter vartype-cut            as integer   no-undo.
       36   define input parameter varlist-db             as character no-undo.
       37   define input parameter vardate-actual-goods   as date      no-undo.
       38   define input parameter vardate-actual-docs    as date      no-undo.
       39   define input parameter vardate-actual-findoc  as date      no-undo.
       40   define input parameter vardate-output-zone    as date      no-undo.
       41   define input parameter varstay-recipe-goods   as logical   no-undo.
       42   define input parameter varstay-weight-goods   as logical   no-undo.
       43   define input parameter varnot-copy-del-goods  as logical   no-undo.
       44   define input parameter varstay-history        as logical   no-undo.
       45   define input parameter vargen-file            as character no-undo.
       46   define stream str-gen.
       47   output stream str-gen to vargen-file append.
       48   if not connected("src") then do:
       49      return error "Нет коннекта с базой 'src'.".
       50   end.
       51   if not connected("dst") then do:
       52      return error "Нет коннекта с базой 'dst'.".
       53   end.
       54   find src.sys-ctrl no-lock.
       55   if not available src.sys-ctrl then do:
       56      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       57   end.
       58   if src.sys-ctrl.db-num <> 0 then do:
       59      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       60   end.
       61   if vardate-actual-docs <> ? and
       62      (vardate-actual-goods   > vardate-actual-docs or
       63       vardate-actual-goods   = ? )   then do:
       64         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       65                                 "Дата актуальности товаров &1."        +
       66                                 "Дата актуальности документов &2."     +
       67                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       68                                 vardate-actual-goods,
       69                                 vardate-actual-docs).
       70   end.
       71   on WRITE of dst.c-place-io     override do: end.
       72   on WRITE of dst.c-point-io     override do: end.
       73   on WRITE of dst.place-io       override do: end.
       74   on WRITE of dst.place-io-attr  override do: end.
       75   on WRITE of dst.point-io       override do: end.
       76   on WRITE of dst.point-io-attr  override do: end.
       77   on WRITE of dst.point-place-rel override do: end.
       78   on WRITE of dst.c-point-place-rel override do: end.
       79   on WRITE of dst.point-point-rel    override do: end.
       80   on WRITE of dst.c-point-point-rel  override do: end.
       81   for each old-place-io  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       82      create new-place-io.
       83      buffer-copy old-place-io to new-place-io.
       84   end.
       85   for each old-place-io-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       86      create new-place-io-attr.
       87      buffer-copy old-place-io-attr to new-place-io-attr.
       88   end.
       89   for each old-point-io  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       90      create new-point-io.
       91      buffer-copy old-point-io to new-point-io.
       92   end.
       93   for each old-point-io-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       94      create new-point-io-attr.
       95      buffer-copy old-point-io-attr to new-point-io-attr.
       96   end.
       97   for each old-point-place-rel  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       98      create new-point-place-rel.
       99      buffer-copy old-point-place-rel to new-point-place-rel.
      100   end.
      101   for each old-point-point-rel  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      102      create new-point-point-rel.
      103      buffer-copy old-point-point-rel to new-point-point-rel.
      104   end.
      105     if varstay-history = yes then do:
      106   for each old-c-place-io  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      107      create new-c-place-io.
      108      buffer-copy old-c-place-io to new-c-place-io.
      109   end.
      110   for each old-c-point-io  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      111      create new-c-point-io.
      112      buffer-copy old-c-point-io to new-c-point-io.
      113   end.
      114   for each old-c-point-place-rel  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      115      create new-c-point-place-rel.
      116      buffer-copy old-c-point-place-rel to new-c-point-place-rel.
      117   end.
      118   for each old-c-point-point-rel  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      119      create new-c-point-point-rel.
      120      buffer-copy old-c-point-point-rel to new-c-point-point-rel.
      121   end.
      122     end.
      123   output stream str-gen close.
      124   return "Произведен экспорт таблиц: ~
      125     c-place-io ~
      126     c-point-io ~
      127     place-io ~
      128     place-io-attr ~
      129     point-io ~
      130     point-io-attr ~
      131     point-place-rel ~
      132     c-point-place-rel ~
      133     ".
      134   end.
