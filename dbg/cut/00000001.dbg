        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   do
        7   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
        8   define input parameter vartype-cut            as integer   no-undo.
        9   define input parameter varlist-db             as character no-undo.
       10   define input parameter vardate-actual-goods   as date      no-undo.
       11   define input parameter vardate-actual-docs    as date      no-undo.
       12   define input parameter vardate-actual-findoc  as date      no-undo.
       13   define input parameter vardate-output-zone    as date      no-undo.
       14   define input parameter varstay-recipe-goods   as logical   no-undo.
       15   define input parameter varstay-weight-goods   as logical   no-undo.
       16   define input parameter varnot-copy-del-goods  as logical   no-undo.
       17   define input parameter varstay-history        as logical   no-undo.
       18   define input parameter vargen-file            as character no-undo.
       19   define stream str-gen.
       20   output stream str-gen to vargen-file append.
       21   if not connected("src") then do:
       22      return error "Нет коннекта с базой 'src'.".
       23   end.
       24   if not connected("dst") then do:
       25      return error "Нет коннекта с базой 'dst'.".
       26   end.
       27   find src.sys-ctrl no-lock.
       28   if not available src.sys-ctrl then do:
       29      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       30   end.
       31   if src.sys-ctrl.db-num <> 0 then do:
       32      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       33   end.
       34   if vardate-actual-docs <> ? and
       35      (vardate-actual-goods   > vardate-actual-docs or
       36       vardate-actual-goods   = ? )   then do:
       37         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       38                                 "Дата актуальности товаров &1."        +
       39                                 "Дата актуальности документов &2."     +
       40                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       41                                 vardate-actual-goods,
       42                                 vardate-actual-docs).
       43   end.
       44   define buffer new_file for dst._file.
       45   define buffer newflt_file for ubfltdst._file.
       46   define variable v-ok as logical no-undo .
       47   define variable v-skip-tables as character no-undo .
       48   define variable v-skip-flt-tables as character no-undo .
       49   for each new_file no-lock
       50     where new_file._hidden = false
       51   :
       52     if lookup(new_file._file-name, v-skip-tables) > 0 then next.
       53     run check-clear in this-procedure ( input "dst." + new_file._file-name
       54                                        ,output v-ok) no-error.
       55     if error-status:error then do:
       56       return error substitute("Ошибка при проверке пуста ли таблица &1 в БД-приемнике", new_file._file-name).
       57     end.
       58     if not v-ok then do:
       59       return error substitute("База данных dst не пуста. Eсть записи в таблице &1", new_file._file-name).
       60     end.
       61   end.
       62   if sdbname( "ubfltdst" ) <> sdbname( "dst" ) then do:
       63     for each newflt_file no-lock
       64       where newflt_file._hidden = false
       65     :
       66       if lookup(newflt_file._file-name, v-skip-flt-tables) > 0 then next.
       67       run check-clear in this-procedure ( input "ubfltdst." + newflt_file._file-name
       68                                          ,output v-ok) no-error.
       69       if error-status:error then do:
       70         return error substitute("Ошибка при проверке пуста ли таблица &1 в БД-приемнике для фильтров", newflt_file._file-name).
       71       end.
       72       if not v-ok then do:
       73         return error substitute("База данных ubfltdst не пуста. Eсть записи в таблице &1", newflt_file._file-name).
       74       end.
       75     end.
       76   end.
       77   output stream str-gen close.
       78   return "Проверили, что все таблицы в базе данных dst пусты.".
       79   end.
       80   procedure check-clear :
       81   define input parameter p-tbl-name as character no-undo .
       82   define output parameter p-ok as logical no-undo .
       83   define variable v-bh as handle no-undo .
       84   do
       85   on error undo, return error
       86   :
       87     create buffer v-bh for table p-tbl-name.
       88     v-ok = v-bh:find-first( " where true ") no-error.
       89     if v-bh:available then do:
       90       delete widget v-bh.
       91     end.
       92     else do:
       93       delete widget v-bh.
       94       p-ok = yes.
       95     end.
       96   end.
       97   end procedure.
