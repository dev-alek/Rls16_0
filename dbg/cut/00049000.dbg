        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 784232a2254b, 2720, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        4   define variable vss-date        as character no-undo init "$Date: Пн янв 18 10:14:30 2021 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00049000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00049000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 9.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-BatchProcess for src.BatchProcess.
       13   define buffer new-BatchProcess for dst.BatchProcess.
       14   define buffer old-Filter       for ubfltsrc.Filter.
       15   define buffer new-Filter       for ubfltdst.Filter.
       16   define buffer new-goods        for dst.goods.
       17   define buffer old-db-filter      for src.db-filter     .
       18   define buffer old-db-filter-attr for src.db-filter-attr.
       19   define buffer old-filter-attr    for ubfltsrc.filter-attr   .
       20   define buffer new-db-filter      for dst.db-filter     .
       21   define buffer new-db-filter-attr for dst.db-filter-attr.
       22   define buffer new-filter-attr    for ubfltdst.filter-attr   .
       23   define variable v-need-copy-batchprocess as logical   no-undo .
       24   do
       25   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       26   :
       27   define input parameter vartype-cut            as integer   no-undo.
       28   define input parameter varlist-db             as character no-undo.
       29   define input parameter vardate-actual-goods   as date      no-undo.
       30   define input parameter vardate-actual-docs    as date      no-undo.
       31   define input parameter vardate-actual-findoc  as date      no-undo.
       32   define input parameter vardate-output-zone    as date      no-undo.
       33   define input parameter varstay-recipe-goods   as logical   no-undo.
       34   define input parameter varstay-weight-goods   as logical   no-undo.
       35   define input parameter varnot-copy-del-goods  as logical   no-undo.
       36   define input parameter varstay-history        as logical   no-undo.
       37   define input parameter vargen-file            as character no-undo.
       38   define stream str-gen.
       39   output stream str-gen to vargen-file append.
       40   if not connected("src") then do:
       41      return error "Нет коннекта с базой 'src'.".
       42   end.
       43   if not connected("dst") then do:
       44      return error "Нет коннекта с базой 'dst'.".
       45   end.
       46   find src.sys-ctrl no-lock.
       47   if not available src.sys-ctrl then do:
       48      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       49   end.
       50   if src.sys-ctrl.db-num <> 0 then do:
       51      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       52   end.
       53   if vardate-actual-docs <> ? and
       54      (vardate-actual-goods   > vardate-actual-docs or
       55       vardate-actual-goods   = ? )   then do:
       56         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       57                                 "Дата актуальности товаров &1."        +
       58                                 "Дата актуальности документов &2."     +
       59                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       60                                 vardate-actual-goods,
       61                                 vardate-actual-docs).
       62   end.
       63     on write  of dst.batchprocess     override do: end.
       64     on write  of ubfltdst.filter      override do: end.
       65     on create of ubfltdst.filter      override do: end.
       66     on WRITE  of dst.db-filter        override do: end.
       67     on WRITE  of dst.db-filter-attr   override do: end.
       68     on WRITE  of ubfltdst.filter-attr override do: end.
       69   for each old-Filter  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       70      create new-Filter.
       71      buffer-copy old-Filter to new-Filter.
       72   end.
       73     for each old-BatchProcess no-lock
       74       where old-BatchProcess.bp_type = 'prc':U
       75     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       76     :
       77       run check-exist in this-procedure
       78         (input  'price-doc':u
       79         ,input  old-batchprocess.charkey_one
       80         ,output v-need-copy-batchprocess
       81         ) .
       82       if v-need-copy-batchprocess = true
       83       then do:
       84         create new-batchprocess.
       85         buffer-copy old-batchprocess to new-batchprocess.
       86       end.
       87     end.
       88     for each old-BatchProcess no-lock
       89       where old-BatchProcess.bp_type = 'trnhd':U
       90     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       91     :
       92       run check-exist in this-procedure
       93         (input  'trn-doc':u
       94         ,input  old-batchprocess.charkey_one
       95         ,output v-need-copy-batchprocess
       96         ) .
       97       if v-need-copy-batchprocess = true
       98       then do:
       99         create new-batchprocess.
      100         buffer-copy old-batchprocess to new-batchprocess.
      101       end.
      102     end.
      103     if vartype-cut = 1
      104     then do:
      105       for each old-BatchProcess no-lock
      106       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      107       :
      108         case old-BatchProcess.BP_type
      109         :
      110           when 'autonws':U or
      111           when 'autoarh':U or
      112           when 'autoexp':U or
      113           when 'autosuz':U or
      114           when 'autogcd':U or
      115           when 'autosale':U or
      116           when 'autocbnk':U or
      117           when 'autofree':U or
      118           when 'mercury':U or
      119           when 'hddtest':U or
      120           when 'is_motp':U or
      121           when 'is_diadoc':U or
      122           when 'is_PM':U
      123           then do:
      124           end.
      125           when 'cutdbs':U
      126           then do:
      127           end.
      128           when 'autoupg':U
      129           then do:
      130           end.
      131           when 'prc':U or
      132           when 'trnhd':U
      133           then do:
      134           end.
      135           when 'rt-doc':U or
      136           when 'rt-line':U or
      137           when 'bcprint':U
      138           then do:
      139           end.
      140           when 'arh':U
      141           then do:
      142             run check-exist in this-procedure
      143               (input  old-batchprocess.charkey_two
      144               ,input  old-batchprocess.charkey_one
      145               ,output v-need-copy-batchprocess
      146               ) .
      147             if v-need-copy-batchprocess = true
      148             then do:
      149               create new-batchprocess.
      150               buffer-copy old-batchprocess to new-batchprocess.
      151             end.
      152           end.
      153           when 'ahsp':U
      154           then do:
      155             run check-exist in this-procedure
      156               (input  old-batchprocess.charkey_two
      157               ,input  old-batchprocess.charkey_one
      158               ,output v-need-copy-batchprocess
      159               ) .
      160             if v-need-copy-batchprocess = true
      161             then do:
      162               create new-batchprocess.
      163               buffer-copy old-batchprocess to new-batchprocess.
      164             end.
      165           end.
      166           when 'aht':U
      167           then do:
      168             run check-exist in this-procedure
      169               (input  old-batchprocess.charkey_two
      170               ,input  old-batchprocess.charkey_one
      171               ,output v-need-copy-batchprocess
      172               ) .
      173             if v-need-copy-batchprocess = true
      174             then do:
      175               create new-batchprocess.
      176               buffer-copy old-batchprocess to new-batchprocess.
      177             end.
      178           end.
      179           when 'hold':U
      180           then do:
      181             run check-exist in this-procedure
      182               (input  'trn-doc':u
      183               ,input  old-batchprocess.charkey_one
      184               ,output v-need-copy-batchprocess
      185               ) .
      186             if v-need-copy-batchprocess = true
      187             then do:
      188               create new-batchprocess.
      189               buffer-copy old-batchprocess to new-batchprocess.
      190             end.
      191           end.
      192           when 'hinv':U
      193           then do:
      194             run check-exist in this-procedure
      195               (input  'trn-doc':u
      196               ,input  old-batchprocess.charkey_one
      197               ,output v-need-copy-batchprocess
      198               ) .
      199             if v-need-copy-batchprocess = true
      200             then do:
      201               create new-batchprocess.
      202               buffer-copy old-batchprocess to new-batchprocess.
      203             end.
      204           end.
      205           when 'hspi':U
      206           then do:
      207             run check-exist in this-procedure
      208               (input  'trn-doc':u
      209               ,input  old-batchprocess.charkey_one
      210               ,output v-need-copy-batchprocess
      211               ) .
      212             if v-need-copy-batchprocess = true
      213             then do:
      214               create new-batchprocess.
      215               buffer-copy old-batchprocess to new-batchprocess.
      216             end.
      217           end.
      218           when 'gds':U
      219           then do:
      220              find first new-goods no-lock where
      221                     new-goods.gds-code   = old-BatchProcess.key#_one no-error.
      222              if available new-goods then do:
      223                 create new-batchprocess.
      224                 buffer-copy old-batchprocess to new-batchprocess.
      225              end.
      226           end.
      227           when 'dcard':U
      228           then do:
      229             create new-batchprocess.
      230             buffer-copy old-batchprocess to new-batchprocess.
      231           end.
      232           when 'goa':U
      233           then do:
      234              find first new-goods no-lock where
      235                     new-goods.gds-code   = old-BatchProcess.key#_one no-error.
      236              if available new-goods then do:
      237                 create new-batchprocess.
      238                 buffer-copy old-batchprocess to new-batchprocess.
      239              end.
      240           end.
      241           when 'slr':U
      242           then do:
      243             create new-batchprocess.
      244             buffer-copy old-batchprocess to new-batchprocess.
      245           end.
      246           when 'cshr':U
      247           then do:
      248             create new-batchprocess.
      249             buffer-copy old-batchprocess to new-batchprocess.
      250           end.
      251           when 'mvob':U
      252           then do:
      253           end.
      254           when 'bcode':U
      255           then do:
      256           end.
      257           when 'fgrp':U
      258           then do:
      259             create new-batchprocess.
      260             buffer-copy old-batchprocess to new-batchprocess.
      261           end.
      262           when 'rnar':U
      263           then do:
      264           end.
      265           when 'autooxml':U then do:
      266             create new-batchprocess.
      267             buffer-copy old-batchprocess to new-batchprocess.
      268           end.
      269           otherwise do:
      270             if old-BatchProcess.BP_type begins 'lock':U
      271             or old-BatchProcess.BP_type begins 'lusr':U
      272             then do:
      273             end.
      274             else do:
      275               return error substitute("Неизвестный тип BatchProcess &1", old-BatchProcess.BP_type ) .
      276             end.
      277           end.
      278         end case.
      279       end.
      280     end.
      281   for each old-db-filter  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      282      create new-db-filter.
      283      buffer-copy old-db-filter to new-db-filter.
      284   end.
      285   for each old-db-filter-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      286      create new-db-filter-attr.
      287      buffer-copy old-db-filter-attr to new-db-filter-attr.
      288   end.
      289   for each old-filter-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      290      create new-filter-attr.
      291      buffer-copy old-filter-attr to new-filter-attr.
      292   end.
      293     output stream str-gen close.
      294     return "Произведен экспорт таблиц: BatchProcess Filter db-filter db-filter-attr filter-attr .".
      295   end.
      296   procedure check-exist :
      297     define input  parameter p-table-name as character no-undo .
      298     define input  parameter p-doc-code   as character no-undo .
      299     define output parameter p-need-copy  as logical   no-undo .
      300     define buffer new-trn-doc      for dst.trn-doc .
      301     define buffer new-price-doc    for dst.price-doc .
      302     do
      303     on error undo, return error return-value
      304     :
      305       assign
      306         p-need-copy = false
      307       .
      308       case p-table-name
      309       :
      310         when 'trn-doc':u
      311         then do:
      312           find first new-trn-doc no-lock
      313             where new-trn-doc.doc-code = p-doc-code
      314             no-error .
      315           if available new-trn-doc
      316           then do:
      317             assign
      318               p-need-copy = true
      319             .
      320           end.
      321         end.
      322         when 'price-doc':u
      323         then do:
      324           find first new-price-doc no-lock
      325             where new-price-doc.doc-num = p-doc-code
      326             no-error .
      327           if available new-price-doc
      328           then do:
      329             assign
      330               p-need-copy = true
      331             .
      332           end.
      333         end.
      334         otherwise do:
      335           undo, return error substitute("Неизвестный тип задания &1", p-table-name) .
      336         end.
      337       end case .
      338     end.
      339   end procedure.
