     1776                 .
     1777                 leave old-clients-price.
     1778               end.
     1779             end.
     1780           end.
     1781           if varactual-goods = false then do:
     1782             old-rvs-doc :
     1783             for each old_db
     1784               ,each old-clients no-lock
     1785                 where old-clients.db-num = old_db.db-num on error undo, return error return-value :
     1786               for each old-rvs-line where old-rvs-line.obj-type = old-clients.obj-type and
     1787                                           old-rvs-line.obj-code = old-clients.obj-code and
     1788                                           old-rvs-line.gds-code = old-goods.gds-code   no-lock,
     1789                   first old-rvs-doc where old-rvs-doc.rvs-code    = old-rvs-line.rvs-code and
     1790                                           old-rvs-doc.fact-order >= var-fact-order-docs   on error undo, return error return-value :
     1791                 assign
