      139   define buffer old-wth-gds             for src.wth-gds.
      140   define variable varactual-goods  as logical no-undo.
      141   define variable varin-date       as date    no-undo.
      142   define variable varlast-date     as date    no-undo.
      143   define variable i                as integer no-undo.
      144   define variable varwrite-to-file as logical no-undo.
      145   define variable var-date-docs    as date    no-undo .
      146   define variable var-fact-order-docs as decimal no-undo .
      147   define variable l-is-empty-scale as logical no-undo .
      148   define stream LogStream.
      149   define new global shared variable g#language as character no-undo .
      150   if g#language <> '' and g#language <> 'rus':U then do:
      151     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      152   end.
      153   define new global shared variable g#library  as handle no-undo .
      154   define new global shared variable g#library2 as handle no-undo .
      155   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   procedure factord :
      157     define input  parameter p-fact-date            as date    no-undo .
      158     define input  parameter p-fact-time            as integer no-undo .
      159     define input  parameter p-fact-num             as integer no-undo .
      160     define input  parameter p-shift-date           as date    no-undo .
      161     define input  parameter p-shift-num            as integer no-undo .
      162     define input  parameter p-shift-on             as logical no-undo .
      163     define output parameter p-fact-order           as decimal no-undo .
      164     define output parameter p-shift-end-fact-order as decimal no-undo .
      165     define output parameter p-day-end-fact-order   as decimal no-undo .
      166     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      167     if p-fact-date = ?
      168     then do:
      169       return error "Не указана фактическая дата" .
      170     end.
      171     define variable v-fact-date-num as integer no-undo .
      172     assign
      173       v-fact-date-num = integer(p-fact-date)
      174     .
      175     if p-fact-num = ?
      176     or p-fact-num = 0
      177     then do:
      178       return error "Не задан p-fact-num " + string(p-fact-num) .
      179     end.
      180     if p-fact-num < 0
      181     then do:
      182       return error "Отрицательный fact-num " + string(p-fact-num) .
      183     end.
      184     if p-fact-num >= 100000000
      185     then do:
      186       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      187     end.
      188     if p-shift-on = true
      189     then do:
      190       if p-shift-date = ?
      191       then do:
      192         return error "Не задана дата смены" .
      193       end.
      194       if p-shift-num = ?
      195       or p-shift-num = 0
      196       then do:
      197         return error "Не задан номер смены" .
      198       end.
      199     end.
      200     else do:
      201       assign
      202         p-shift-date = p-fact-date
      203         p-shift-num  = 24
      204       .
      205     end.
      206     define variable v-shift-offset as integer no-undo .
      207     if p-shift-date = p-fact-date
      208     then do:
      209       assign
      210         v-shift-offset = 1
      211       .
      212     end.
      213     if p-shift-date < p-fact-date
      214     then do:
      215       assign
      216         v-shift-offset = 0
      217       .
      218     end.
      219     if p-shift-date > p-fact-date
      220     then do:
      221       message
      222         vss-workfile vss-revision vss-description skip
      223         "Неправильная дата закрытия смены" skip
      224         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      225         view-as alert-box error .
      226       undo, return error
      227         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      228           ,string(p-fact-date, '99/99/9999':U)
      229           ,string(p-shift-date, '99/99/9999':U)
      230           )
      231       .
      232     end.
      233     if p-shift-num < 1
      234     or p-shift-num > 24
      235     then do:
      236       message
      237         vss-workfile vss-revision vss-description skip
      238         "Неправильный номер смены" skip
      239         "p-shift-num" p-shift-num skip
      240         view-as alert-box error .
      241       undo, return error return-value .
      242     end.
      243     assign
      244       p-fact-order           = v-fact-date-num
      245                              + v-shift-offset * 0.5
      246                              + p-shift-num    * 0.02 - 0.01
      247                              + p-fact-num     * 0.0000000001
      248       p-shift-end-fact-order = v-fact-date-num
      249                              + v-shift-offset * 0.5
      250                              + p-shift-num    * 0.02
      251       p-day-end-fact-order   = v-fact-date-num
      252                              + 0.99
      253     .
      254     if p-fact-order           <= v-fact-date-num
      255     or p-shift-end-fact-order <= v-fact-date-num
      256     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      257     or p-shift-end-fact-order >= p-day-end-fact-order
      258     then do:
      259       message
      260         vss-workfile vss-revision vss-description skip
      261         "Внутренняя ошибка при генерации фактического номера" skip
      262         "p-fact-date"            p-fact-date            skip
      263         "p-fact-time"            p-fact-time            skip
      264         "p-fact-num"             p-fact-num             skip
      265         "p-shift-date"           p-shift-date           skip
      266         "p-shift-num"            p-shift-num            skip
      267         "p-shift-on"             p-shift-on             skip
      268         "p-shift-end-fact-order" p-shift-end-fact-order skip
      269         "p-day-end-fact-order"   p-day-end-fact-order   skip
      270         "v-fact-date-num"        v-fact-date-num        skip
      271         view-as alert-box error .
      272       undo, return error return-value .
      273     end.
      274   end procedure.
      275   procedure day-begin-fact-order :
      276     define input  parameter p-fact-date            as date    no-undo .
      277     define output parameter p-day-begin-fact-order as decimal no-undo .
      278     do
      279     on error undo, return error return-value
      280     :
      281       if p-fact-date = ?
      282       then do:
      283         assign
      284           p-day-begin-fact-order = 0
      285         .
      286       end.
      287       else do:
      288         assign
      289           p-day-begin-fact-order = integer(p-fact-date)
      290         .
      291       end.
      292     end.
      293   end procedure.
      294   procedure factord-max-fact-order :
      295     define output parameter p-max-fact-order as decimal   no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       run day-begin-fact-order in this-procedure
      300         (input  date(1, 1, 5000)
      301         ,output p-max-fact-order
      302         ) .
      303     end.
      304   end procedure.
      305   procedure factord-cut-archive :
      306     define input  parameter p-obj-type             as character no-undo .
      307     define input  parameter p-obj-code             as integer   no-undo .
      308     define input  parameter p-fact-date            as date      no-undo .
      309     define output parameter p-shift-on             as logical   no-undo .
      310     define output parameter p-shift-date           as date      no-undo .
      311     define output parameter p-shift-num            as integer   no-undo .
      312     define output parameter p-day-end-fact-order   as decimal   no-undo .
      313     define output parameter p-shift-end-fact-order as decimal   no-undo .
      314     define variable v-fact-order as decimal   no-undo .
      315     define buffer buf_shift-obj for ub.shift-obj .
      316     do
      317     on error undo, return error return-value
      318     :
      319   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      321     (input  p-obj-type
      322     ,input  p-obj-code
      323     ,input  'shift-on=request'
      324     ,output p-shift-on
      325     ) no-error .
      326       if error-status :error
      327       then do:
      328         message
      329           vss-workfile vss-revision vss-description skip
      330           "Ошибка при определении атрибута объекта" skip
      331           "Объект" p-obj-type p-obj-code skip
      332           error-status :get-message(1) skip
      333           return-value skip
      334           view-as alert-box error .
      335         undo, return error return-value .
      336       end.
      337       if p-shift-on = false
      338       then do:
      339         assign
      340           p-shift-date               = ?
      341           p-shift-num                = 0
      342         .
      343       end.
      344       else do:
      345         find first buf_shift-obj share-lock
      346           where buf_shift-obj.obj-type   = p-obj-type
      347             and buf_shift-obj.obj-code   = p-obj-code
      348             and buf_shift-obj.shift-date > p-fact-date
      349           use-index pi
      350           no-error .
      351         if not available buf_shift-obj
      352         or buf_shift-obj.status_ <> 'зкр':U
      353         then do:
      354           message
      355             vss-workfile vss-revision vss-description skip
      356             "Невозможно вычислить последнюю смену" skip
      357             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      358             "Объект" p-obj-type p-obj-code skip
      359             "Дата" p-fact-date skip
      360             view-as alert-box error .
      361           undo, return error return-value .
      362         end.
      363         find last buf_shift-obj share-lock
      364           where buf_shift-obj.obj-type = p-obj-type
      365             and buf_shift-obj.obj-code = p-obj-code
      366             and buf_shift-obj.shift-date <= p-fact-date
      367           use-index pi
      368           no-error .
      369         if available buf_shift-obj
      370         then do:
      371           if  buf_shift-obj.status_ = 'зкр':U
      372           then do:
      373             assign
      374               p-shift-date = buf_shift-obj.shift-date
      375               p-shift-num  = buf_shift-obj.shift-num
      376             .
      377           end.
      378           else do:
      379             message
      380               vss-workfile vss-revision vss-description skip
      381               "Невозможно вычислить последнюю смену" skip
      382               "Статус смены отличен от статуса" 'зкр':U skip
      383               "Объект" p-obj-type p-obj-code skip
      384               "Дата" p-fact-date skip
      385               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      386               view-as alert-box error .
      387             undo, return error return-value .
      388           end.
      389         end.
      390         else do:
      391           assign
      392             p-shift-date = p-fact-date - 1
      393             p-shift-num  = 1
      394           .
      395         end.
      396       end.
      397       run factord in this-procedure
      398         (input  p-fact-date
      399         ,input  1
      400         ,input  1
      401         ,input  p-shift-date
      402         ,input  p-shift-num
      403         ,input  p-shift-on
      404         ,output v-fact-order
      405         ,output p-shift-end-fact-order
      406         ,output p-day-end-fact-order
      407         ) no-error .
      408       if error-status :error
      409       then do:
      410         message
      411           vss-workfile vss-revision vss-description skip
      412           "Ошибка при вызове процедуры factord"
      413           error-status :get-message(1) skip
      414           return-value skip
      415           view-as alert-box error .
      416         undo, return error return-value .
      417       end.
      418     end.
      419   end procedure.
      420   procedure factord-lock-shift :
      421     define input  parameter p-obj-type  as character no-undo .
      422     define input  parameter p-obj-code  as integer   no-undo .
      423     define input  parameter p-fact-date as date      no-undo .
      424     define parameter buffer buf_shift-obj for ub.shift-obj .
      425     define variable v-shift-on      as logical   no-undo .
      426     define variable v-extra-message as character no-undo .
      427     define variable v-error as character no-undo .
      428     do
      429     on error undo, return error return-value
      430     :
      431   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      433     (input  p-obj-type
      434     ,input  p-obj-code
      435     ,input  'shift-on=request'
      436     ,output v-shift-on
      437     ) no-error .
      438       if error-status :error
      439       then do:
      440         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      441         undo, return error v-error .
      442       end.
      443       if v-shift-on = true
      444       then do:
      445         find first buf_shift-obj share-lock
      446           where buf_shift-obj.obj-type   = p-obj-type
      447             and buf_shift-obj.obj-code   = p-obj-code
      448             and buf_shift-obj.shift-date > p-fact-date
      449           use-index pi
      450           no-error .
      451         if not available buf_shift-obj
      452         or buf_shift-obj.status_ <> 'зкр':U
      453         then do:
      454           find last buf_shift-obj
      455             where buf_shift-obj.obj-type = p-obj-type
      456               and buf_shift-obj.obj-code = p-obj-code
      457               and buf_shift-obj.status_  = 'зкр':U
      458             use-index stts
      459             no-error .
      460           if available buf_shift-obj
      461           then do:
      462             assign
      463               v-extra-message =
      464                     substitute("Дата начала последеней закрытой смены на объекте &1"
      465                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      466                               )
      467             .
      468           end.
      469           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      470           undo, return error v-error .
      471         end.
      472       end.
      473     end.
      474   end procedure.
      475   procedure factord-end-day :
      476     define input  parameter p-fact-date            as date    no-undo .
      477     define output parameter p-day-end-fact-order   as decimal no-undo .
      478     do
      479     on error undo, return error return-value
      480     :
      481       if p-fact-date = ?
      482       then do:
      483         return error "Не указана фактическая дата" .
      484       end.
      485       assign
      486         p-day-end-fact-order = integer(p-fact-date) + 0.99
      487       .
      488     end.
      489   end procedure.
      490   procedure factord-to-date :
      491     define input  parameter p-fact-order as decimal no-undo .
      492     define output parameter p-fact-date  as date    no-undo .
      493     define variable v-ref-date  as date      no-undo .
      494     define variable v-ref-delta as integer   no-undo .
      495     do
      496     on error undo, return error return-value
      497     :
      498       if p-fact-order = ?
      499       or p-fact-order = 0
      500       then do:
      501         return error "Не указан fact-order" .
      502       end.
      503       assign
      504         v-ref-date  = date(1, 1, 2000)
      505       .
      506       assign
      507         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      508       .
      509       assign
      510         p-fact-date = v-ref-date + v-ref-delta
      511       .
      512     end.
      513   end procedure.
      514   procedure factord-to-fact-num :
      515     define input  parameter p-fact-order as decimal no-undo .
      516     define output parameter p-fact-num   as integer no-undo .
      517     define variable v-fact-order-trunc as decimal no-undo .
      518     do
      519     on error undo, return error return-value
      520     :
      521       if p-fact-order = ?
      522       or p-fact-order = 0
      523       then do:
      524         return error "Не указан fact-order" .
      525       end.
      526       assign
      527        v-fact-order-trunc = truncate(p-fact-order, 2)
      528       .
      529       assign
      530         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      531       .
      532     end.
      533   end procedure.
      534   procedure factord-to-shift-num :
      535     define input  parameter p-fact-order as decimal no-undo .
      536     define output parameter p-shift-num   as integer no-undo .
      537     define variable  p-shift-numd  as decimal   no-undo .
      538     define variable v-fact-order-trunc as decimal no-undo .
      539     do
      540     on error undo, return error return-value
      541     :
      542       if p-fact-order = ?
      543       or p-fact-order = 0
      544       then do:
      545         return error "Не указан fact-order" .
      546       end.
      547       assign
      548        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      549       .
      550       if v-fact-order-trunc < 0.5 then do:
      551         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      552       end.
      553       assign
      554         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      555         .
      556        assign
      557         p-shift-num = truncate (p-shift-numd , 0)
      558       .
      559     end.
      560   end procedure.
      561   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562   procedure gen-key-rec :
      563     define input  parameter p-tbl-name    as character no-undo.
      564     define input  parameter p-bh_tbl-name as handle    no-undo.
      565     define output parameter p-key-rec     as character no-undo.
      566     do
      567     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      568     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      569     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      570     :
      571       define variable fh               as handle    no-undo .
      572       define variable v-ok             as logical   no-undo .
      573       define variable v-inform         as character no-undo .
      574       define variable v-ind            as integer   no-undo .
      575       define variable v-idx-field-qnty as integer   no-undo .
      576       if p-tbl-name = ?
      577         or p-tbl-name = "":U
      578       then do:
      579         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      580       end.
      581       if not p-bh_tbl-name:available then do:
      582         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      583       end.
      584       assign
      585         p-key-rec = p-tbl-name
      586         v-inform  = p-bh_tbl-name:index-information(1)
      587         v-ind     = 2
      588       .
      589       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      590       on error undo, return error
      591       :
      592         assign
      593           v-inform = p-bh_tbl-name:index-information( v-ind )
      594           v-ind    = v-ind + 1
      595         .
      596       end.
      597       if v-inform = ?
      598         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      599         or entry( 3, v-inform, ",":U ) <> "1":U
      600       then do:
      601         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      602       end.
      603       else do:
      604         assign
      605           v-idx-field-qnty = num-entries( v-inform ) - 4
      606         .
      607         if v-idx-field-qnty < 2 then do:
      608           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      609         end.
      610         do v-ind = 1 to v-idx-field-qnty by 2
      611         on error undo, return error
      612         :
      613           assign
      614             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      615             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      616           .
      617         end.
      618       end.
      619       if p-key-rec = ? then do:
      620         assign
      621           p-key-rec = "":U
      622         .
      623         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      624       end.
      625     end.
      626     return.
      627   end procedure.
      628   procedure gen-where-keyr-tab :
      629     define input  parameter i-tableSerach as character no-undo.
      630     define input  parameter i-tablekey   as character  no-undo.
      631     define input  parameter p-key-rec    as character  no-undo.
      632     define input  parameter p-key-handle as handle     no-undo .
      633     define input  parameter p-db-name    as character  no-undo .
      634     define input  parameter p-tt-handle  as handle     no-undo .
      635     define output parameter o-Where      as character  no-undo.
      636     do
      637     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      638     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      639     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      640     :
      641       define variable v-full-tbl-name  as character no-undo .
      642       define variable bh_tbl-name      as handle    no-undo .
      643       define variable fh_key           as handle    no-undo .
      644       define variable fh_search        as handle    no-undo .
      645       define variable v-field-num      as integer   no-undo .
      646       define variable v-count-fld      as integer   no-undo .
      647       define variable v-inform         as character no-undo .
      648       define variable v-ind            as integer   no-undo .
      649       define variable v-idx-field-qnty as integer   no-undo .
      650       define variable v-field-name     as character no-undo .
      651       define variable v-field-val      as character no-undo .
      652       define variable v-word-link      as character no-undo .
      653       define variable vTable           as character no-undo.
      654       define variable bh_tbl-key       as handle    no-undo .
      655       assign
      656         p-key-rec = trim( p-key-rec )
      657       .
      658       if p-key-handle <> ? then do:
      659         if not valid-handle(p-key-handle)
      660            or p-key-handle:type <> "buffer"
      661         then do:
      662           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      663         end.
      664         if num-entries( p-key-rec, chr(3) ) > 1
      665           or p-key-rec = ?
      666           or p-key-rec = "":U
      667         then do:
      668           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      669         end.
      670       end.
      671       else do:
      672         if p-key-rec = ?
      673           or p-key-rec = "":U
      674         then do:
      675           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      676         end.
      677       end.
      678       assign
      679         vTable = entry( 1 , p-key-rec, chr(3) )
      680       .
      681       if p-tt-handle <> ?
      682         and ( not valid-handle(p-tt-handle)
      683               or p-tt-handle:type <> "buffer"
      684             )
      685       then do:
      686         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      687       end.
      688       if p-tt-handle = ? then do:
      689         assign
      690           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      691         .
      692         create buffer bh_tbl-name for table v-full-tbl-name .
      693       end.
      694       else do:
      695         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      696       end.
      697       assign
      698         v-inform = bh_tbl-name:index-information(1)
      699         v-ind    = 2
      700       .
      701       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      702       on error undo, return error
      703       :
      704         assign
      705           v-inform = bh_tbl-name:index-information( v-ind )
      706           v-ind    = v-ind + 1
      707         .
      708       end.
      709       if v-inform = ?
      710         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      711         or entry( 3, v-inform, ",":U ) <> "1":U
      712       then do:
      713         delete object bh_tbl-name no-error.
      714         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      715       end.
      716       assign
      717         v-idx-field-qnty = num-entries( v-inform ) - 4
      718       .
      719       if v-idx-field-qnty < 2 then do:
      720         delete object bh_tbl-name no-error.
      721         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      722       end.
      723       assign
      724         o-where     = "where":U
      725         v-word-link = "":U
      726         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      727         v-count-fld = 0
      728       .
      729       if i-tablekey ne "" and i-tablekey ne ?
      730       then do:
      731         assign
      732           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      733         .
      734         create buffer bh_tbl-key for table v-full-tbl-name .
      735       end.
      736       if i-tableSerach ne "" and i-tableSerach ne ?
      737       then do:
      738         delete object bh_tbl-name no-error.
      739         assign
      740           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      741         .
      742         create buffer bh_tbl-name for table v-full-tbl-name .
      743       end.
      744       block_where:
      745       do v-ind = 1 to v-idx-field-qnty by 2
      746       on error undo, return error
      747       :
      748         assign
      749           v-count-fld = v-count-fld + 1
      750         .
      751         if p-key-handle = ?
      752           and v-count-fld > v-field-num
      753         then do:
      754           leave block_where.
      755         end.
      756         define variable VfieldKeyTable as handle no-undo.
      757         assign
      758           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      759           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      760         .
      761         if     bh_tbl-key ne ?
      762         then do:
      763            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      764            if VfieldKeyTable eq ?
      765            then next block_where.
      766         end.
      767         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      768         then
      769            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      770         else
      771            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      772         if p-key-handle = ? then do:
      773           assign
      774             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      775           .
      776         end.
      777         else do:
      778           assign
      779             fh_key = p-key-handle:buffer-field( v-field-name )
      780           .
      781           if fh_key = ?
      782             or not valid-handle( fh_key )
      783           then do:
      784             delete object bh_tbl-name.
      785             if     bh_tbl-key ne ?
      786             then
      787                delete object bh_tbl-key.
      788             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      789           end.
      790           assign
      791             v-field-val = fh_key:buffer-value
      792           .
      793         end.
      794         if fh_search:data-type ="character":U then do:
      795           assign
      796             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      797             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      798             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      799             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      800             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      801             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      802             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      803             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      804             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      805             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      806             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      807             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      808             v-field-val = substitute( '"&1"', v-field-val )
      809           .
      810         end.
      811         assign
      812           o-where = substitute( "&1 &2", o-where, v-field-val )
      813         .
      814         if v-word-link = "":U then do:
      815           assign
      816             v-word-link = "and":U
      817           .
      818         end.
      819       end.
      820       delete object bh_tbl-name.
      821       if     bh_tbl-key ne ?
      822       then
      823          delete object bh_tbl-key.
      824       if p-key-handle = ?
      825         and v-count-fld <> v-field-num
      826       then do:
      827         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      828       end.
      829     end.
      830   end procedure.
      831   procedure gen-hn-keyr-tab :
      832     define input  parameter i-tableSerach as character no-undo.
      833     define input  parameter i-tablekey   as character no-undo.
      834     define input  parameter p-key-rec    as character no-undo.
      835     define input  parameter p-key-handle as handle    no-undo .
      836     define input  parameter p-db-name    as character no-undo .
      837     define input  parameter p-tt-handle  as handle    no-undo .
      838     define input  parameter p-stts-lock  as integer   no-undo .
      839     define output parameter o-hn         as handle    no-undo.
      840     define variable v-full-tbl-name as character no-undo.
      841     define variable v-where         as character no-undo.
      842     define variable bh_tbl-name     as handle    no-undo.
      843     define variable vTable          as character no-undo.
      844     do
      845     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      846     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      847     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      848         run gen-where-keyr-tab(i-tableSerach,
      849                                i-tablekey,
      850                                p-key-rec,
      851                                p-key-handle,
      852                                p-db-name,
      853                                p-tt-handle,
      854                                output v-where).
      855         if i-tableSerach ne "" and i-tableSerach ne ?
      856         then do:
      857            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      858            create buffer bh_tbl-name for table v-full-tbl-name .
      859         end.
      860         else do:
      861            if p-tt-handle = ? then do:
      862               assign
      863                  vTable = entry( 1 , p-key-rec, chr(3) )
      864               .
      865               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      866               create buffer bh_tbl-name for table v-full-tbl-name .
      867            end.
      868            else do:
      869               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      870            end.
      871         end.
      872         if p-tt-handle = ? then do:
      873            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      874         end.
      875         else do:
      876            bh_tbl-name:find-first( v-where ) no-error .
      877         end.
      878         o-hn = bh_tbl-name.
      879      end.
      880   end procedure.
      881   procedure gen-hn-keyr :
      882     define input  parameter p-key-rec    as character no-undo.
      883     define input  parameter p-key-handle as handle    no-undo .
      884     define input  parameter p-db-name    as character no-undo .
      885     define input  parameter p-tt-handle  as handle    no-undo .
      886     define input  parameter p-stts-lock  as integer   no-undo .
      887     define output parameter o-hn         as handle    no-undo.
      888     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      889   end.
      890   procedure gen-row-keyr :
      891     define input  parameter p-key-rec    as character no-undo.
      892     define input  parameter p-key-handle as handle    no-undo .
      893     define input  parameter p-db-name    as character no-undo .
      894     define input  parameter p-tt-handle  as handle    no-undo .
      895     define input  parameter p-stts-lock  as integer   no-undo .
      896     define output parameter p-tbl-row    as rowid     no-undo.
      897     define output parameter p-tbl-name   as character no-undo.
      898     define variable vHn as handle no-undo.
      899       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      900       p-tbl-row = if vHn:available then vHn:rowid else ?.
      901       p-tbl-name =  vHn:table.
      902       delete object vHn no-error.
      903     if p-tbl-row = ? then do:
      904       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      905     end.
      906     else do:
      907       return.
      908     end.
      909   end procedure.
      910   procedure gen-key-fv :
      911     define input  parameter p-key-rec    as character no-undo .
      912     define output parameter p-field-list as character no-undo .
      913     define output parameter p-value-list as character no-undo.
      914     do
      915     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      916     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      917     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      918     :
      919       define variable v-full-tbl-name  as character no-undo .
      920       define variable bh_tbl-name      as handle    no-undo .
      921       define variable v-tbl-name       as character no-undo .
      922       define variable v-field-num      as integer   no-undo .
      923       define variable v-count-fld      as integer   no-undo .
      924       define variable v-inform         as character no-undo .
      925       define variable v-ind            as integer   no-undo .
      926       define variable v-idx-field-qnty as integer   no-undo .
      927       define variable v-delim-key      as character no-undo .
      928       if p-key-rec = ?
      929         or p-key-rec = "":U
      930       then do:
      931         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      932       end.
      933       assign
      934         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      935         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      936       .
      937       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      938       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      939       assign
      940         v-inform = bh_tbl-name:index-information(1)
      941         v-ind    = 2
      942       .
      943       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      944       on error undo, return error
      945       :
      946         assign
      947           v-inform = bh_tbl-name:index-information( v-ind )
      948           v-ind    = v-ind + 1
      949         .
      950       end.
      951       if v-inform = ?
      952         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      953         or entry( 3, v-inform, ",":U ) <> "1":U
      954       then do:
      955         delete object bh_tbl-name no-error.
      956         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      957       end.
      958       assign
      959         v-idx-field-qnty = num-entries( v-inform ) - 4
      960       .
      961       if v-idx-field-qnty < 2 then do:
      962         delete object bh_tbl-name no-error.
      963         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      964       end.
      965       assign
      966         p-field-list = "":U
      967         p-value-list = "":U
      968         v-delim-key  = "":U
      969         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      970         v-count-fld  = 0
      971       .
      972       block_where:
      973       do v-ind = 1 to v-idx-field-qnty by 2
      974       on error undo, return error
      975       :
      976         assign
      977           v-count-fld = v-count-fld + 1
      978         .
      979         if v-count-fld > v-field-num then do:
      980           leave block_where.
      981         end.
      982         assign
      983           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      984           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      985         .
      986         if v-ind = 1 then do:
      987           assign
      988             v-delim-key = chr(3)
      989           .
      990         end.
      991       end.
      992       delete object bh_tbl-name.
      993       if v-count-fld <> v-field-num then do:
      994         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      995       end.
      996     end.
      997   end procedure.
      998   procedure gen-key-field :
      999     define input  parameter p-table      as character no-undo .
     1000     define output parameter p-field-list as character no-undo .
     1001     do
     1002     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1003     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1004     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1005     :
     1006       define variable v-full-tbl-name  as character no-undo .
     1007       define variable bh_tbl-name      as handle    no-undo .
     1008       define variable v-tbl-name       as character no-undo .
     1009       define variable v-field-num      as integer   no-undo .
     1010       define variable v-count-fld      as integer   no-undo .
     1011       define variable v-inform         as character no-undo .
     1012       define variable v-ind            as integer   no-undo .
     1013       define variable v-idx-field-qnty as integer   no-undo .
     1014       define variable v-delim-key      as character no-undo .
     1015       if p-table = ?
     1016         or p-table = "":U
     1017       then do:
     1018         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1019       end.
     1020       assign
     1021         v-tbl-name      = p-table
     1022         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1023       .
     1024       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1025       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1026       assign
     1027         v-inform = bh_tbl-name:index-information(1)
     1028         v-ind    = 2
     1029       .
     1030       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1031       on error undo, return error
     1032       :
     1033         assign
     1034           v-inform = bh_tbl-name:index-information( v-ind )
     1035           v-ind    = v-ind + 1
     1036         .
     1037       end.
     1038       if v-inform = ?
     1039         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1040         or entry( 3, v-inform, ",":U ) <> "1":U
     1041       then do:
     1042         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1043       end.
     1044       assign
     1045         v-idx-field-qnty = num-entries( v-inform ) - 4
     1046       .
     1047       if v-idx-field-qnty < 2 then do:
     1048         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1049       end.
     1050       assign
     1051         p-field-list = "":U
     1052         v-delim-key  = "":U
     1053         v-count-fld  = 0
     1054       .
     1055       block_where:
     1056       do v-ind = 1 to v-idx-field-qnty by 2
     1057       on error undo, return error
     1058       :
     1059         assign
     1060           v-count-fld = v-count-fld + 1
     1061         .
     1062         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1063         if v-ind = 1 then do:
     1064           assign
     1065             v-delim-key = chr(3)
     1066           .
     1067         end.
     1068       end.
     1069       delete object bh_tbl-name.
     1070     end.
     1071   end procedure.
     1072   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1073   procedure grp-attr-name :
     1074   do
     1075     on error undo, return error
     1076     :
     1077     define input  parameter p-code           as character no-undo .
     1078     define output parameter p-type           as character no-undo .
     1079     define output parameter p-format         as character no-undo .
     1080     define output parameter p-label          as character no-undo .
     1081     define output parameter p-user-can-edit  as logical   no-undo .
     1082     define output parameter p-output-display as logical   no-undo .
     1083     define output parameter p-other          as character no-undo .
     1084       case p-code :
     1085               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1086         otherwise do:
     1087           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     1088         end.
     1089       end.
     1090     end.
     1091   end procedure.
     1092   procedure grp-attr-tooltip :
     1093   do
     1094     on error undo, return error
     1095     :
     1096       define input  parameter p-code    as character no-undo .
     1097       define output parameter p-tooltip as character no-undo .
     1098       define output parameter p-label   as character no-undo .
     1099       case p-code :
     1100               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
     1101         otherwise do:
     1102               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     1103         end.
     1104       end.
     1105     end.
     1106   end procedure.
     1107   procedure grp-attr-value :
     1108   do
     1109   on error undo, return error
     1110   :
     1111   define input  parameter p-node-code   as integer    no-undo.
     1112   define input  parameter p-code        as character  no-undo.
     1113   define input  parameter p-host-code   as integer    no-undo.
     1114   define input  parameter p-obj-type    as character  no-undo.
     1115   define input  parameter p-obj-code    as integer    no-undo.
     1116   define output parameter p-value       as character  no-undo.
     1117   define output parameter p-type        as character  no-undo.
     1118       define variable v-format         as character no-undo .
     1119       define variable v-label          as character no-undo .
     1120       define variable v-user-can-edit  as logical   no-undo .
     1121       define variable v-output-display as logical   no-undo .
     1122       define variable v-other          as character no-undo .
     1123       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
     1124       run grp-attr-name in this-procedure (
     1125             input  p-code
     1126           , output p-type
     1127           , output v-format
     1128           , output v-label
     1129           , output v-user-can-edit
     1130           , output v-output-display
     1131           , output v-other
     1132       ) no-error .
     1133       if error-status :error
     1134       then do:
     1135           undo, return error return-value .
     1136       end.
     1137       find first buf_gds-grp-attr no-lock
     1138            where buf_gds-grp-attr.node-code = p-node-code
     1139              and buf_gds-grp-attr.attr-code = p-code
     1140              and buf_gds-grp-attr.host-code = p-host-code
     1141              and buf_gds-grp-attr.obj-type  = p-obj-type
     1142              and buf_gds-grp-attr.obj-code  = p-obj-code
     1143       no-error .
     1144       if available buf_gds-grp-attr
     1145       then do:
     1146           assign
     1147               p-value = buf_gds-grp-attr.attr-value
     1148           .
     1149       end.
     1150       else do:
     1151           assign
     1152               p-value = if p-type = 'L':U then "no":U else ""
     1153           .
     1154       end.
     1155   end.
     1156   end procedure.
     1157   procedure grp-attr-write :
     1158   do
     1159   on error undo, return error
     1160   :
     1161   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
     1162   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
     1163   define input parameter p-host-code  as integer                          no-undo.
     1164   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     1165   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     1166   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
     1167       define variable v-type              as character                no-undo.
     1168       define variable v-format            as character                no-undo.
     1169       define variable v-label             as character                no-undo.
     1170       define variable v-user-can-edit     as logical                  no-undo.
     1171       define variable v-output-display    as logical                  no-undo.
     1172       define variable v-other             as character                no-undo.
     1173       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     1174       run grp-attr-name in this-procedure (
     1175                         input  p-code
     1176                       , output v-type
     1177                       , output v-format
     1178                       , output v-label
     1179                       , output v-user-can-edit
     1180                       , output v-output-display
     1181                       , output v-other
     1182       ) no-error.
     1183       if error-status :error
     1184       then do:
     1185           undo, return error return-value.
     1186       end.
     1187       find first buf_gds-grp-attr exclusive-lock
     1188            where buf_gds-grp-attr.node-code  = p-node-code
     1189              and buf_gds-grp-attr.attr-code  = p-code
     1190              and buf_gds-grp-attr.host-code  = p-host-code
     1191              and buf_gds-grp-attr.obj-type   = p-obj-type
     1192              and buf_gds-grp-attr.obj-code   = p-obj-code
     1193       no-error.
     1194       if not available buf_gds-grp-attr
     1195       then do:
     1196           create buf_gds-grp-attr.
     1197           assign
     1198                   buf_gds-grp-attr.node-code  = p-node-code
     1199                   buf_gds-grp-attr.attr-code  = p-code
     1200                   buf_gds-grp-attr.host-code  = p-host-code
     1201                   buf_gds-grp-attr.obj-type   = p-obj-type
     1202                   buf_gds-grp-attr.obj-code   = p-obj-code
     1203                   buf_gds-grp-attr.attr-value = p-value
     1204           .
     1205       end.
     1206       else do:
     1207           assign
     1208               buf_gds-grp-attr.attr-value = p-value
     1209           .
     1210       end.
     1211   end.
     1212   end procedure.
     1213   procedure grp-attr-delete :
     1214   do
     1215   on error undo, return error
     1216   :
     1217   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
     1218   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
     1219   define input parameter p-host-code  as integer                      no-undo.
     1220   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
     1221   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
     1222   define output parameter p-deleted   as logical                      no-undo.
     1223       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     1224       define variable v-type              as character                no-undo.
     1225       define variable v-format            as character                no-undo.
     1226       define variable v-label             as character                no-undo.
     1227       define variable v-user-can-edit     as logical                  no-undo.
     1228       define variable v-output-display    as logical                  no-undo.
     1229       define variable v-other             as character                no-undo.
     1230       run grp-attr-name in this-procedure
     1231       ( input  p-code
     1232       , output v-type
     1233       , output v-format
     1234       , output v-label
     1235       , output v-user-can-edit
     1236       , output v-output-display
     1237       , output v-other
     1238       ) no-error .
     1239       if error-status :error then do:
     1240           undo, return error return-value .
     1241       end.
     1242       find first buf_gds-grp-attr exclusive-lock
     1243            where buf_gds-grp-attr.node-code  = p-node-code
     1244              and buf_gds-grp-attr.attr-code  = p-code
     1245              and buf_gds-grp-attr.host-code  = p-host-code
     1246              and buf_gds-grp-attr.obj-type   = p-obj-type
     1247              and buf_gds-grp-attr.obj-code   = p-obj-code
     1248       no-error.
     1249       if not available buf_gds-grp-attr
     1250       then do:
     1251           assign
     1252               p-deleted = no
     1253           .
     1254       end.
     1255       else do:
     1256          delete buf_gds-grp-attr.
     1257          assign
     1258               p-deleted = yes
     1259           .
     1260       end.
     1261   end.
     1262   end procedure.
     1263   procedure grp-attr-news :
     1264   do
     1265   on error undo, return error
     1266   :
     1267       define input  parameter p-code           as character no-undo .
     1268       define output parameter p-news           as logical   no-undo .
     1269       case p-code :
     1270               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
     1271         otherwise do:
     1272           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
     1273         end.
     1274       end.
     1275   end.
     1276   end procedure.
     1277   procedure grp-attr-obj-value :
     1278   do
     1279   on error undo, return error
     1280   :
     1281   define input parameter p-node-code as integer      no-undo.
     1282   define input parameter p-obj-type  as character    no-undo.
     1283   define input parameter p-obj-code  as integer      no-undo.
     1284   define input parameter p-attr-code as character    no-undo .
     1285   define output parameter p-attr-value     as character   no-undo.
     1286   define output parameter p-range     as integer      no-undo.
     1287   define output parameter p-exists    as logical      no-undo.
     1288   define variable v-host-code as integer      no-undo.
     1289   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1290   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1291     (input  p-obj-type
     1292     ,input  p-obj-code
     1293     ,output v-host-code
     1294     ) no-error .
     1295   if error-status :error
     1296   then do:
     1297       message
     1298         vss-workfile vss-revision vss-description
     1299         skip "Не удалось найти фирму объекта"
     1300         skip p-obj-type p-obj-code
     1301         skip return-value
     1302         skip trim(error-status :get-message(1))
     1303              trim(error-status :get-message(2))
     1304              trim(error-status :get-message(3))
     1305              trim(error-status :get-message(4))
     1306              trim(error-status :get-message(5))
     1307       view-as alert-box error.
     1308       undo, return error .
     1309   end.
     1310   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
     1311   find first buf_gds-grp-attr no-lock
     1312        where buf_gds-grp-attr.node-code = p-node-code
     1313          and buf_gds-grp-attr.attr-code = p-attr-code
     1314          and buf_gds-grp-attr.host-code = v-host-code
     1315          and buf_gds-grp-attr.obj-type  = p-obj-type
     1316          and buf_gds-grp-attr.obj-code  = p-obj-code
     1317   no-error .
     1318   if not available buf_gds-grp-attr
     1319   then do:
     1320       find first buf_gds-grp-attr no-lock
     1321            where buf_gds-grp-attr.node-code = p-node-code
     1322              and buf_gds-grp-attr.attr-code = p-attr-code
     1323              and buf_gds-grp-attr.host-code = v-host-code
     1324              and buf_gds-grp-attr.obj-type  = ""
     1325              and buf_gds-grp-attr.obj-code  = 0
     1326       no-error .
     1327       if not available buf_gds-grp-attr
     1328       then do:
     1329           find first buf_gds-grp-attr no-lock
     1330               where buf_gds-grp-attr.node-code = p-node-code
     1331               and buf_gds-grp-attr.attr-code = p-attr-code
     1332               and buf_gds-grp-attr.host-code = 0
     1333               and buf_gds-grp-attr.obj-type  = ""
     1334               and buf_gds-grp-attr.obj-code  = 0
     1335           no-error .
     1336           if not available buf_gds-grp-attr
     1337           then do:
     1338               assign
     1339                   p-exists = no
     1340               .
     1341           end.
     1342           else do:
     1343               assign
     1344                   p-exists = yes
     1345                   p-range  = 1
     1346               .
     1347           end.
     1348       end.
     1349       else do:
     1350           assign
     1351               p-exists = yes
     1352               p-range  = 2
     1353           .
     1354       end.
     1355   end.
     1356   else do:
     1357       assign
     1358           p-exists = yes
     1359           p-range  = 3
     1360       .
     1361   end.
     1362   if available buf_gds-grp-attr
     1363   then do:
     1364     assign
     1365     p-attr-value = buf_gds-grp-attr.attr-value
     1366     .
     1367   end.
     1368   end.
     1369   end procedure.
     1370   procedure ver-gds-grp-nabor :
     1371   do
     1372   on error undo, return error return-value
     1373   :
     1374   define input  parameter p-gds-code as integer   no-undo .
     1375   define output parameter p-nabor as logical   no-undo .
     1376   define buffer buf_goods for ub.goods.
     1377   p-nabor = false .
     1378   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1379   if error-status :error then return error .
     1380   define variable v-value       as character  no-undo.
     1381   define variable v-type        as character  no-undo.
     1382     run grp-attr-value (
     1383        input   buf_goods.grp-code
     1384       ,input   'gds-grp-nabor':U
     1385       ,input   0
     1386       ,input   ""
     1387       ,input   0
     1388       ,output  v-value
     1389       ,output  v-type       ) no-error .
     1390       if error-status :error then return error .
     1391     if v-value = "yes" then p-nabor = true  .
     1392   end.
     1393   end procedure.
     1394   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1395   do
     1396   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     1397   define input parameter vartype-cut            as integer   no-undo.
     1398   define input parameter varlist-db             as character no-undo.
     1399   define input parameter vardate-actual-goods   as date      no-undo.
