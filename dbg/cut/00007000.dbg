     1806                                          old-ord-doc.obj-code    = old-clients.obj-code and
     1807                                          old-ord-doc.status_     = 'факт':U              and
     1808                                          old-ord-doc.fact-order >= var-fact-order-docs  no-lock,
     1809                 first old-ord-line where  old-ord-line.prod-type = old-goods.prod-type  and
     1810                                           old-ord-line.prod-code = old-goods.prod-code  and
     1811                                           old-ord-line.artic     = old-goods.artic      and
     1812                                           old-ord-line.doc-code  = old-ord-doc.doc-code no-lock on error undo, return error return-value :
     1813                 assign
