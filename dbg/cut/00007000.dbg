     1401   define input parameter vardate-actual-findoc  as date      no-undo.
     1402   define input parameter vardate-output-zone    as date      no-undo.
     1403   define input parameter varstay-recipe-goods   as logical   no-undo.
     1404   define input parameter varstay-weight-goods   as logical   no-undo.
