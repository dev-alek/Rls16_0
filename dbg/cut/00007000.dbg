     1498   fact-date
     1499   gds-code
     1500   .
     1501   if vardate-actual-goods <> ? then do:
     1502     if vartype-cut = 0 then do:
     1503       for each old-c-fbr-doc no-lock:
     1504         if old-c-fbr-doc.fact-date >= vardate-actual-goods then do:
     1505           for each old-c-fbr-line where
     1506                   old-c-fbr-line.doc-code = old-c-fbr-doc.doc-code
     1507               AND old-c-fbr-line.chip-num = old-c-fbr-doc.chip-num on error undo, return error return-value :
     1508             find first temp-c-fbr-line where
     1509                       temp-c-fbr-line.fact-date = old-c-fbr-doc.fact-date
     1510                   AND temp-c-fbr-line.artic    = old-c-fbr-line.artic
     1511                   AND temp-c-fbr-line.prod-type = old-c-fbr-line.prod-type
     1512                   AND temp-c-fbr-line.prod-code = old-c-fbr-line.prod-code no-error .
     1513             if not available temp-c-fbr-line then do:
     1514               create temp-c-fbr-line.
     1515               buffer-copy
     1516               old-c-fbr-line to temp-c-fbr-line
     1517               assign
     1518               temp-c-fbr-line.fact-date = old-c-fbr-doc.fact-date
     1519               .
     1520             end.
     1521           end.
     1522         end.
     1523       end.
     1524       for each old_db
     1525       ,each old-clients no-lock
     1526         where old-clients.db-num = old_db.db-num,
     1527         each old-inkas no-lock where
     1528             old-inkas.obj-type = old-clients.obj-type
     1529         AND old-inkas.obj-code = old-clients.obj-code
     1530         AND old-inkas.status_  = 'факт':U
     1531         AND old-inkas.doc-date >= vardate-actual-goods
     1532         on error undo, return error:
     1533         for each old-chk-gds no-lock where
     1534                     old-chk-gds.out-code = old-inkas.inkas-code:
     1535           if old-chk-gds.line-sign = ?
     1536           or old-chk-gds.line-sign = no then do:
     1537             find first temp-chk-gds no-lock where
     1538                         temp-chk-gds.fact-date = old-inkas.fact-date
     1539                     and temp-chk-gds.b-code    = old-chk-gds.b-code no-error .
     1540             if not available temp-chk-gds then do:
     1541               find first old-bar-code no-lock where
     1542                         old-bar-code.b-code = old-chk-gds.b-code no-error .
     1543               if not available old-bar-code then do:
     1544                   return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) .
     1545               end.
     1546               create temp-chk-gds.
     1547               assign
     1548               temp-chk-gds.fact-date = old-inkas.fact-date
     1549               temp-chk-gds.b-code    = old-chk-gds.b-code
     1550               temp-chk-gds.gds-code  = old-bar-code.gds-code
     1551               .
     1552             end.
     1553           end.
     1554         end.
     1555       end.
     1556     end.
     1557     for each old-goods no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     1558       if vartype-cut = 1 then do:
     1559         assign
     1560         varactual-goods = true.
     1561       end.
     1562       if vartype-cut = 0 then do:
     1563         assign
     1564         varactual-goods  = false
     1565         varwrite-to-file = false
     1566         .
     1567         if varstay-weight-goods then do:
     1568           find old-units where old-units.unit-name = old-goods.unit-base no-lock.
     1569           wt:
     1570           do i = 1 to num-entries(old-units.type):
     1571             if entry(i, old-units.type) = 'вес':U then do:
     1572               assign
     1573                 varactual-goods = true
     1574               .
     1575               leave wt.
     1576             end.
     1577           end.
     1578         end.
     1579         if varstay-recipe-goods = true
     1580         then do:
     1581           find first old-recipe no-lock
     1582                 where old-recipe.artic     = old-goods.artic
     1583                   and old-recipe.prod-type = old-goods.prod-type
     1584                   and old-recipe.prod-code = old-goods.prod-code
     1585           no-error.
     1586           if available old-recipe
     1587           then do:
     1588               assign
     1589                   varactual-goods = true
     1590               .
     1591           end.
     1592           else do:
     1593               find first old-recipe-gds no-lock
     1594                    where old-recipe-gds.artic     = old-goods.artic
     1595                      and old-recipe-gds.prod-type = old-goods.prod-type
     1596                      and old-recipe-gds.prod-code = old-goods.prod-code
     1597               no-error.
     1598               if available old-recipe-gds
     1599               then do:
     1600                   assign
     1601                       varactual-goods = true
     1602                   .
     1603               end.
     1604           end.
     1605         end.
     1606         if varactual-goods = false then do:
     1607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     1608     (input  old-goods.gds-code
     1609     ,input  'empty-scale=request'
     1610     ,output l-is-empty-scale
     1611     )  .
     1612           old-gds-obj:
     1613           for each old-gds-obj no-lock
     1614             where old-gds-obj.gds-code     = old-goods.gds-code
     1615           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1616           :
     1617             if old-gds-obj.fact-qnty <> 0
     1618             or old-gds-obj.avrg-qnty <> 0
     1619             or old-gds-obj.in-date   >= vardate-actual-goods
     1620             then do:
     1621               if old-goods.stts <> 0
     1622                 and varnot-copy-del-goods
     1623               then do:
     1624                 assign
     1625                   varwrite-to-file = true
     1626                 .
     1627               end.
     1628               else do:
     1629                 assign
     1630                   varactual-goods = true
     1631                 .
     1632               end.
     1633               if varactual-goods = false
     1634               and  l-is-empty-scale = false then do:
     1635                 _prt-obj:
     1636                 for each old-prt-obj no-lock where
     1637                         old-prt-obj.obj-type = old-gds-obj.obj-type
     1638                     and old-prt-obj.obj-code = old-gds-obj.obj-code
     1639                     and old-prt-obj.artic    = old-gds-obj.artic
     1640                     and old-prt-obj.prod-type    = old-gds-obj.prod-type
     1641                     and old-prt-obj.prod-code    = old-gds-obj.prod-code
     1642                 on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1643                 :
     1644                   if not old-prt-obj.is-term then next.
     1645                   if old-prt-obj.fact-qnty <> 0
     1646                   or old-prt-obj.free-qnty <> 0
     1647                   then do:
     1648                     if old-goods.stts <> 0
     1649                       and varnot-copy-del-goods
     1650                     then do:
     1651                       assign
     1652                         varwrite-to-file = true
     1653                       .
     1654                     end.
     1655                     else do:
     1656                       assign
     1657                         varactual-goods = true
     1658                       .
     1659                     end.
     1660                     leave old-gds-obj.
     1661                   end.
     1662                 end.
     1663               end.
     1664               leave old-gds-obj.
     1665             end.
     1666           end.
     1667         end.
     1668         if varactual-goods = false then do:
     1669             if old-goods.stts <> 0
     1670                and varnot-copy-del-goods = true
     1671             then do:
     1672               assign
     1673                 var-date-docs = vardate-actual-docs
     1674               .
     1675             end.
     1676             else do:
     1677               assign
     1678                 var-date-docs = vardate-actual-goods
     1679               .
     1680             end.
     1681             run factord-end-day in this-procedure ( var-date-docs - 1, output var-fact-order-docs).
     1682             old-clients :
     1683             for each old_db
     1684               ,each old-clients no-lock
     1685                 where old-clients.db-num = old_db.db-num
     1686               on error undo, return error
     1687               :
     1688                 find last old-doc-line where old-doc-line.obj-type   = old-clients.obj-type and
     1689                                              old-doc-line.obj-code   = old-clients.obj-code and
     1690                                              old-doc-line.prod-type  = old-goods.prod-type  and
     1691                                              old-doc-line.prod-code  = old-goods.prod-code  and
     1692                                              old-doc-line.artic      = old-goods.artic      and
     1693                                              old-doc-line.status_    = 'факт':U
     1694                                              use-index fact-order no-lock no-error.
     1695                 if available old-doc-line                         and
     1696                   old-doc-line.fact-order >= var-fact-order-docs then do:
     1697                   assign
     1698                     varactual-goods = true
     1699                   .
     1700                   leave old-clients.
     1701                 end.
     1702             end.
     1703           end.
     1704           if varactual-goods = false then do:
