     1406   define input parameter varstay-history        as logical   no-undo.
     1407   define input parameter vargen-file            as character no-undo.
     1408   define stream str-gen.
     1409   output stream str-gen to vargen-file append.
     1410   if not connected("src") then do:
     1411      return error "Нет коннекта с базой 'src'.".
     1412   end.
     1413   if not connected("dst") then do:
     1414      return error "Нет коннекта с базой 'dst'.".
     1415   end.
     1416   find src.sys-ctrl no-lock.
     1417   if not available src.sys-ctrl then do:
     1418      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
     1419   end.
     1420   if src.sys-ctrl.db-num <> 0 then do:
     1421      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
     1422   end.
     1423   if vardate-actual-docs <> ? and
     1424      (vardate-actual-goods   > vardate-actual-docs or
     1425       vardate-actual-goods   = ? )   then do:
     1426         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
     1427                                 "Дата актуальности товаров &1."        +
     1428                                 "Дата актуальности документов &2."     +
     1429                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
     1430                                 vardate-actual-goods,
     1431                                 vardate-actual-docs).
     1432   end.
