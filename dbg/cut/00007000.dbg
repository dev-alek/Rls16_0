     1820           if varactual-goods = false then do:
     1821               old-ord-doc-rcv :
     1822               for each old_db
     1823             ,each old-clients no-lock
     1824               where old-clients.db-num = old_db.db-num
     1825             on error undo, return error
     1826             :
     1827               for each old-ord-doc-rcv where old-ord-doc-rcv.obj-type    = old-clients.obj-type and
     1828                                              old-ord-doc-rcv.obj-code    = old-clients.obj-code and
     1829                                              old-ord-doc-rcv.status_     = 'факт':U              and
     1830                                              old-ord-doc-rcv.fact-order >= var-fact-order-docs  no-lock,
     1831                 first old-ord-line-rcv where  old-ord-line-rcv.artic     = old-goods.artic          and
     1832                                               old-ord-line-rcv.prod-type = old-goods.prod-type      and
     1833                                               old-ord-line-rcv.prod-code = old-goods.prod-code      and
     1834                                               old-ord-line-rcv.doc-code  = old-ord-doc-rcv.doc-code no-lock on error undo, return error return-value :
     1835                 assign
     1836                   varactual-goods = true
     1837                 .
     1838                 leave old-ord-doc-rcv.
     1839               end.
     1840             end.
     1841           end.
     1842           if varactual-goods = false then do:
     1843               old-fbr-doc :
     1844             for each old_db
     1845              ,each old-clients no-lock where old-clients.db-num = old_db.db-num on error undo, return error return-value :
     1846               for each old-fbr-doc where old-fbr-doc.obj-type   = old-clients.obj-type and
     1847                                          old-fbr-doc.obj-code   = old-clients.obj-code and
     1848                                          old-fbr-doc.status_    = 'факт':U              and
     1849                                          old-fbr-doc.fact-date >= var-date-docs        no-lock,
     1850                 first old-fbr-line where  old-fbr-line.prod-type = old-goods.prod-type      and
     1851                                           old-fbr-line.prod-code = old-goods.prod-code      and
     1852                                           old-fbr-line.artic     = old-goods.artic          and
     1853                                           old-fbr-line.doc-code  = old-ord-doc-rcv.doc-code no-lock on error undo, return error return-value :
     1854                 assign
     1855                   varactual-goods = true
     1856                 .
     1857                 leave old-fbr-doc.
     1858               end.
     1859             end.
     1860           end.
     1861           if varactual-goods = false then do:
     1862               old-c-trn-doc :
     1863               for each old_db
     1864             ,each old-clients no-lock
     1865               where old-clients.db-num = old_db.db-num
     1866             on error undo, return error
     1867             :
     1868               for each old-c-trn-doc where old-c-trn-doc.obj-type   = old-clients.obj-type and
     1869                                            old-c-trn-doc.obj-code   = old-clients.obj-code and
     1870                                            old-c-trn-doc.status_    = 'факт':U              and
     1871                                             old-c-trn-doc.doc-date >= var-date-docs        no-lock,
     1872                 first old-c-doc-line where old-c-doc-line.doc-code  = old-c-trn-doc.doc-code AND
     1873                                            old-c-doc-line.chip-num  = old-c-trn-doc.chip-num AND
     1874                                            old-c-doc-line.artic     = old-goods.artic        and
     1875                                            old-c-doc-line.prod-type = old-goods.prod-type    and
     1876                                            old-c-doc-line.prod-code = old-goods.prod-code    no-lock on error undo, return error return-value :
     1877                 assign
     1878                   varactual-goods = true
     1879                 .
     1880                 leave old-c-trn-doc.
     1881               end.
     1882             end.
     1883           end.
     1884           if varactual-goods = false then do:
     1885             old-c-price-doc :
     1886             for each old_db
     1887           ,each old-clients no-lock
     1888             where old-clients.db-num = old_db.db-num
     1889           on error undo, return error
     1890           :
     1891               find old-gds-prt no-lock
     1892               where old-gds-prt.upper-code = old-goods.prt-root
     1893               no-error .
     1894               if error-status :error then return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) .
     1895               find first  old-bar-code no-lock
     1896               where old-bar-code.gds-code  = old-goods.gds-code
     1897                 and old-bar-code.node-code = old-gds-prt.node-code
     1898                 and old-bar-code.part-code = "":u
     1899                 and old-bar-code.in-code   = "":u
     1900                 and old-bar-code.unit-cli  = old-goods.unit-base
     1901               no-error .
     1902               if error-status :error then return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) .
     1903               for each old-c-price-doc where old-c-price-doc.obj-type    = old-clients.obj-type and
     1904                                              old-c-price-doc.obj-code    = old-clients.obj-code and
     1905                                              old-c-price-doc.status_     = 'факт':U              and
     1906                                              old-c-price-doc.fact-order   >= var-fact-order-docs  no-lock,
     1907                 first old-c-price-list where old-c-price-list.doc-num    = old-c-price-doc.doc-num  and
     1908                                              old-c-price-list.chip-num   = old-c-price-doc.chip-num and
     1909                                              old-c-price-list.price-type = "":u                     and
     1910                                              old-c-price-list.b-code     = old-bar-code.b-code      no-lock on error undo, return error return-value :
     1911                 assign
     1912                   varactual-goods = true
     1913                 .
     1914                 leave old-c-price-doc.
     1915               end.
     1916             end.
     1917           end.
     1918           if varactual-goods = false then do:
     1919             old-c-rvs-doc :
     1920             for each old_db
     1921           ,each old-clients no-lock
     1922             where old-clients.db-num = old_db.db-num
     1923           on error undo, return error
     1924           :
     1925               for each old-c-rvs-doc where old-c-rvs-doc.obj-type    = old-clients.obj-type and
     1926                                            old-c-rvs-doc.obj-code    = old-clients.obj-code and
     1927                                            old-c-rvs-doc.status_     = 'факт':U              and
     1928                                            old-c-rvs-doc.fact-order >= var-fact-order-docs  no-lock,
     1929                   first old-c-rvs-line where old-c-rvs-line.rvs-code = old-c-rvs-doc.rvs-code AND
     1930                                             old-c-rvs-line.chip-num = old-c-rvs-doc.chip-num  AND
     1931                                             old-c-rvs-line.gds-code  = old-goods.gds-code no-lock:
     1932                   assign
     1933                     varactual-goods = true
     1934                   .
     1935                   leave old-c-rvs-doc.
     1936               end.
     1937             end.
     1938           end.
     1939           if varactual-goods = false then do:
     1940             old-c-fbr-doc :
     1941             for each temp-c-fbr-line where temp-c-fbr-line.fact-date >= var-date-docs       and
     1942                                            temp-c-fbr-line.artic      = old-goods.artic     and
     1943                                            temp-c-fbr-line.prod-type  = old-goods.prod-type and
     1944                                            temp-c-fbr-line.prod-code  = old-goods.prod-code no-lock
     1945             on error undo, return error return-value
     1946             :
     1947               assign
     1948                 varactual-goods = true
     1949               .
     1950               leave old-c-fbr-doc.
     1951             end.
     1952           end.
     1953           if varactual-goods = false then do:
     1954             find first old-contract-specif where old-contract-specif.gds-code = old-goods.gds-code no-error .
     1955             if available old-contract-specif then assign varactual-goods = true .
     1956           end.
     1957           if varactual-goods = false then do:
     1958             old-chk-gds :
     1959             for each temp-chk-gds no-lock where
     1960                      temp-chk-gds.fact-date  > var-date-docs
     1961                  and temp-chk-gds.gds-code   = old-goods.gds-code
     1962               on error undo, return error
     1963               :
     1964                   assign
     1965                     varactual-goods = true
     1966                   .
     1967                   leave old-chk-gds.
     1968             end.
     1969           end.
     1970           if varactual-goods = false then do:
     1971             old-wth-gds :
     1972             for each old-wth-gds where old-wth-gds.gds-code = old-goods.gds-code
     1973             on error undo, return error return-value
     1974             :
     1975               assign
     1976                 varactual-goods = true
     1977               .
     1978               leave old-wth-gds.
     1979             end.
     1980           end.
     1981           if varactual-goods = false then do:
     1982             gds-grp-attr :
     1983             for each old-gds-grp-attr where
     1984                      old-gds-grp-attr.node-code = old-goods.grp-code      and
     1985                      old-gds-grp-attr.attr-code = 'gds-grp-nabor':U and
     1986                      old-gds-grp-attr.attr-value = "yes"  and
     1987                      old-gds-grp-attr.host-code = 0  and
     1988                      old-gds-grp-attr.obj-code  = 0  and
     1989                      old-gds-grp-attr.obj-type  = ""
     1990             on error undo, return error return-value
     1991             :
     1992               assign
     1993                 varactual-goods = true
     1994               .
     1995               leave gds-grp-attr.
     1996             end.
     1997           end.
     1998           old-c-cd-doc :
     1999           for each old_db
     2000         ,each old-clients no-lock
     2001           where old-clients.db-num = old_db.db-num
     2002         on error undo, return error  :
     2003            for each old-c-cd-doc no-lock where
     2004                    old-c-cd-doc.obj-type   = old-clients.obj-type
     2005                and old-c-cd-doc.obj-code   = old-clients.obj-code,
     2006             first old-c-cd-doc-line where
     2007                  old-c-cd-doc-line.obj-type  = old-c-cd-doc.obj-type
     2008               and old-c-cd-doc-line.obj-code  = old-c-cd-doc.obj-code
     2009               and old-c-cd-doc-line.pos-type  = old-c-cd-doc.pos-type
     2010               and old-c-cd-doc-line.doc-type  = old-c-cd-doc.doc-type
     2011               and old-c-cd-doc-line.doc-code  = old-c-cd-doc.doc-code
     2012               and old-c-cd-doc-line.corr-user-db-num  = old-c-cd-doc.corr-user-db-num
     2013               and old-c-cd-doc-line.chip-num  = old-c-cd-doc.chip-num
     2014               and old-c-cd-doc-line.gds-code  = old-goods.gds-code
     2015               no-lock on error undo, return error return-value :
     2016             if old-c-cd-doc.datekey_one >= var-date-docs     and
     2017             old-c-cd-doc.is-del = yes  then do:
     2018               assign
     2019                 varactual-goods = true
     2020               .
     2021               leave old-c-cd-doc.
     2022             end.
     2023           end.
     2024         end.
     2025           old-cd-doc :
     2026           for each old_db
     2027         ,each old-clients no-lock
     2028           where old-clients.db-num = old_db.db-num
     2029         on error undo, return error  :
     2030            for each old-cd-doc no-lock where
     2031                    old-cd-doc.obj-type   = old-clients.obj-type
     2032                and old-cd-doc.obj-code   = old-clients.obj-code,
     2033             first old-cd-doc-line where
     2034                  old-cd-doc-line.obj-type  = old-cd-doc.obj-type
     2035               and old-cd-doc-line.obj-code  = old-cd-doc.obj-code
     2036               and old-cd-doc-line.pos-type  = old-cd-doc.pos-type
     2037               and old-cd-doc-line.doc-type  = old-cd-doc.doc-type
     2038               and old-cd-doc-line.doc-code  = old-cd-doc.doc-code
     2039               and old-cd-doc-line.gds-code  = old-goods.gds-code
     2040             no-lock on error undo, return error return-value :
     2041             if old-cd-doc.datekey_one >= var-date-docs  then do:
     2042               assign
     2043                 varactual-goods = true
     2044               .
     2045               leave old-cd-doc.
     2046             end.
     2047           end.
     2048         end.
     2049       end.
     2050       if varactual-goods = true then do:
     2051         do transaction
     2052         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2053         :
     2054         create new-goods.
     2055         buffer-copy old-goods to new-goods.
     2056         end.
     2057         for each old-goods-attr no-lock where
     2058                 old-goods-attr.gds-code = old-goods.gds-code
     2059         on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2060           create new-goods-attr.
     2061           buffer-copy old-goods-attr to new-goods-attr.
     2062         end.
     2063         for each old-gds-obj-attr no-lock where
     2064                 old-gds-obj-attr.gds-code = old-goods.gds-code
     2065         on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2066           create new-gds-obj-attr.
     2067           buffer-copy old-gds-obj-attr to new-gds-obj-attr.
     2068         end.
     2069         for each old-gds-host-attr no-lock where
     2070                 old-gds-host-attr.gds-code = old-goods.gds-code
     2071         on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2072           create new-gds-host-attr.
     2073           buffer-copy old-gds-host-attr to new-gds-host-attr.
     2074         end.
     2075         if varstay-history then do:
     2076           for each old-c-gds-hist no-lock where
     2077                   old-c-gds-hist.gds-code = old-goods.gds-code
     2078               on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2079             create new-c-gds-hist.
     2080             buffer-copy old-c-gds-hist to new-c-gds-hist.
     2081           end.
     2082           for each old-c-goods no-lock where
     2083                   old-c-goods.gds-code = old-goods.gds-code
     2084           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2085             create new-c-goods.
     2086             buffer-copy old-c-goods to new-c-goods.
     2087           end.
     2088           for each old-c-goods-attr no-lock where
     2089                   old-c-goods-attr.gds-code = old-goods.gds-code
     2090           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2091             create new-c-goods-attr.
     2092             buffer-copy old-c-goods-attr to new-c-goods-attr.
     2093           end.
     2094           for each old-c-gds-host-attr no-lock where
     2095                   old-c-gds-host-attr.gds-code = old-goods.gds-code
     2096           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2097             create new-c-gds-host-attr.
     2098             buffer-copy old-c-gds-host-attr to new-c-gds-host-attr.
     2099           end.
     2100           for each old-c-gds-obj-attr no-lock where
     2101                   old-c-gds-obj-attr.gds-code = old-goods.gds-code
     2102           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2103             create new-c-gds-obj-attr.
     2104             buffer-copy old-c-gds-obj-attr to new-c-gds-obj-attr.
     2105           end.
     2106           for each old-c-bar-code-obj-attr no-lock where
     2107                   old-c-bar-code-obj-attr.gds-code = old-goods.gds-code
     2108           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2109             create new-c-bar-code-obj-attr.
     2110             buffer-copy old-c-bar-code-obj-attr to new-c-bar-code-obj-attr.
     2111           end.
     2112           for each old-c-bar-code-attr no-lock where
     2113                   old-c-bar-code-attr.gds-code = old-goods.gds-code
     2114           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2115             create new-c-bar-code-attr.
     2116             buffer-copy old-c-bar-code-attr to new-c-bar-code-attr.
     2117           end.
     2118         end.
     2119       end.
     2120       else do:
     2121         if varwrite-to-file = true then do:
     2122           output stream LogStream to "del-gds.txt" append.
     2123           put stream LogStream unformatted
     2124           "Артикул:" chr(32) old-goods.artic chr(32)
     2125           "Производитель:" chr(32) old-goods.prod-code chr(32) old-goods.prod-type chr(32)
     2126           "Название:" chr(32) old-goods.gds-name
     2127           skip
     2128           .
     2129           output stream LogStream close.
     2130         end.
     2131       end.
     2132     end.
     2133     for each old-bar-code no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2134       find first new-goods where new-goods.gds-code  = old-bar-code.gds-code no-lock no-error.
     2135       if available new-goods then do:
     2136         create new-bar-code.
     2137         buffer-copy old-bar-code to new-bar-code.
     2138         if varstay-history then do:
     2139           for each old-c-bar-code no-lock where
     2140                   old-c-bar-code.b-code = new-bar-code.b-code
     2141           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2142             create new-c-bar-code.
     2143             buffer-copy old-c-bar-code to new-c-bar-code.
     2144           end.
     2145         end.
     2146       end.
     2147       else do:
     2148       end.
     2149     end.
     2150     for each old-bar-code-attr no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2151       find first new-goods where new-goods.gds-code  = old-bar-code-attr.gds-code no-lock no-error.
     2152       if available new-goods then do:
     2153         create new-bar-code-attr.
     2154         buffer-copy old-bar-code-attr to new-bar-code-attr.
     2155         if varstay-history then do:
     2156           for each old-c-bar-code-attr no-lock where
     2157                   old-c-bar-code-attr.b-code = new-bar-code-attr.b-code
     2158               and old-c-bar-code-attr.attr-code = new-bar-code-attr.attr-code
     2159           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2160             create new-c-bar-code-attr.
     2161             buffer-copy old-c-bar-code-attr to new-c-bar-code-attr.
     2162       end.
     2163         end.
     2164       end.
     2165     end.
     2166     for each old-prod-bc no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2167       find first new-bar-code no-lock
     2168         where new-bar-code.b-code = old-prod-bc.b-code no-error.
     2169       if available new-bar-code then do:
     2170         create new-prod-bc.
     2171         buffer-copy old-prod-bc to new-prod-bc.
     2172         if varstay-history then do:
     2173           for each old-c-prod-bc no-lock
     2174             where old-c-prod-bc.b-str = new-prod-bc.b-str
     2175           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2176           :
     2177             if old-c-prod-bc.b-code = new-prod-bc.b-code then do:
     2178               create new-c-prod-bc.
     2179               buffer-copy old-c-prod-bc to new-c-prod-bc.
     2180             end.
     2181           end.
     2182         end.
     2183       end.
     2184     end.
     2185     for each old-prod-bc-attr no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2186       find first new-bar-code no-lock
     2187         where new-bar-code.b-code = old-prod-bc-attr.b-code no-error.
     2188       if available new-bar-code then do:
     2189         create new-prod-bc-attr.
     2190         buffer-copy old-prod-bc-attr to new-prod-bc-attr.
     2191         if varstay-history then do:
     2192           for each old-c-prod-bc-attr no-lock
     2193             where old-c-prod-bc-attr.b-str = new-prod-bc-attr.b-str
     2194           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2195           :
     2196             if old-c-prod-bc-attr.b-code = new-prod-bc-attr.b-code then do:
     2197               create new-c-prod-bc-attr.
     2198               buffer-copy old-c-prod-bc-attr to new-c-prod-bc-attr.
     2199             end.
     2200           end.
     2201         end.
     2202       end.
     2203     end.
     2204     for each old-prod-bc-db no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2205       find first new-bar-code no-lock
     2206         where new-bar-code.b-code = old-prod-bc-db.b-code no-error.
     2207       if available new-bar-code then do:
     2208         create new-prod-bc-db.
     2209         buffer-copy old-prod-bc-db to new-prod-bc-db.
     2210       end.
     2211     end.
     2212     define variable v-first-time as logical no-undo .
     2213     define variable v-b-code as integer no-undo .
     2214     define variable v-b-str as character no-undo .
     2215     for each old-prod-bc-db-attr no-lock
     2216     by old-prod-bc-db-attr.b-code
     2217     by old-prod-bc-db-attr.b-str
     2218     by old-prod-bc-db-attr.db-num
     2219     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2220       if not (v-b-str = old-prod-bc-db-attr.b-str
     2221              and
     2222              v-b-code = old-prod-bc-db-attr.b-code) then do:
     2223         assign
     2224         v-first-time = yes
     2225         v-b-str = old-prod-bc-db-attr.b-str
     2226         v-b-code = old-prod-bc-db-attr.b-code
     2227         .
     2228       end.
     2229       find first new-bar-code no-lock
     2230         where new-bar-code.b-code = old-prod-bc-db-attr.b-code no-error.
     2231       if available new-bar-code then do:
     2232         create new-prod-bc-db-attr.
     2233         buffer-copy old-prod-bc-db-attr to new-prod-bc-db-attr.
     2234         if varstay-history
     2235         and v-first-time
     2236         then do:
     2237           for each old-c-prod-bc-db-attr no-lock
     2238             where old-c-prod-bc-db-attr.b-str = new-prod-bc-db-attr.b-str
     2239           on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
