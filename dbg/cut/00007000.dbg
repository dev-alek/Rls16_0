     1740                 and old-icnt-doc.obj-code = old-clients.obj-code
     1741                 and old-icnt-doc.doc-code = old-icnt-line.doc-code
     1742                 and old-icnt-doc.doc-date >= var-date-docs
     1743                 on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     1744                 assign
