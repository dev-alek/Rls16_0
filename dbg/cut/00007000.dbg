     1753               ,each old-clients no-lock
     1754                 where old-clients.db-num = old_db.db-num
     1755               on error undo, return error
     1756               :
     1757               find old-gds-prt no-lock
     1758               where old-gds-prt.upper-code = old-goods.prt-root
     1759               no-error .
     1760               if error-status :error then return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) .
     1761               find first  old-bar-code no-lock
     1762               where old-bar-code.gds-code  = old-goods.gds-code
     1763                 and old-bar-code.node-code = old-gds-prt.node-code
     1764                 and old-bar-code.part-code = ""
     1765                 and old-bar-code.in-code   = ""
     1766                 and old-bar-code.unit-cli  = old-goods.unit-base
     1767               no-error .
     1768               if error-status :error then return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) .
     1769               for each old-price-list where old-price-list.obj-type   =  old-clients.obj-type and
     1770                                             old-price-list.obj-code   =  old-clients.obj-code and
     1771                                             old-price-list.price-type =  ""                   and
     1772                                             old-price-list.fact-order >= var-fact-order-docs  and
     1773                                             old-price-list.b-code     =  old-bar-code.b-code  no-lock on error undo, return error return-value :
     1774                 assign
