     1706             for each old_db
     1707               ,each old-clients no-lock
     1708                 where old-clients.db-num = old_db.db-num
     1709               on error undo, return error
     1710               :
     1711               for each old-parts no-lock where
     1712                       old-parts.obj-type  = old-clients.obj-type
     1713                   and old-parts.obj-code  = old-clients.obj-code
     1714                   and old-parts.artic     = old-goods.artic
     1715                   and old-parts.prod-type = old-goods.prod-type
     1716                   and old-parts.prod-code = old-goods.prod-code
     1717                   and old-parts.status_   = no
     1718                   and old-parts.rsrv-free = yes
     1719                   and old-parts.in-code   <> old-parts.out-code
     1720               on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     1721                 assign
     1722                   varactual-goods = true
     1723                 .
     1724                 leave old-clients-parts-free.
     1725               end.
     1726             end.
     1727           end.
     1728           if varactual-goods = false then do:
     1729             old_icnt-line:
     1730             for each old_db
     1731               ,each old-clients no-lock
     1732                 where old-clients.db-num = old_db.db-num
     1733               on error undo, return error
     1734               :
     1735               _icnt-line:
