      337   for each old-c-dis-some-rule  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      338      create new-c-dis-some-rule.
      339      buffer-copy old-c-dis-some-rule to new-c-dis-some-rule.
      340   end.
      341   end.
      342   for each old-dis-card  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      343      create new-dis-card.
      344      buffer-copy old-dis-card to new-dis-card.
      345   end.
      346   for each old-dis-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      347      create new-dis-obj.
      348      buffer-copy old-dis-obj to new-dis-obj.
      349   end.
      350   for each old-dis-host  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      351      create new-dis-host.
      352      buffer-copy old-dis-host to new-dis-host.
      353   end.
      354   for each old-dis-card-property  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      355      create new-dis-card-property.
      356      buffer-copy old-dis-card-property to new-dis-card-property.
      357   end.
      358   for each old-dis-card-long  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      359      create new-dis-card-long.
      360      buffer-copy old-dis-card-long to new-dis-card-long.
      361   end.
      362   for each old-dis-card-long-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      363      create new-dis-card-long-attr.
      364      buffer-copy old-dis-card-long-attr to new-dis-card-long-attr.
      365   end.
      366   for each old-dis-dc-rule  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      367      create new-dis-dc-rule.
      368      buffer-copy old-dis-dc-rule to new-dis-dc-rule.
      369   end.
      370   for each old-dis-dc-rule-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      371      create new-dis-dc-rule-attr.
      372      buffer-copy old-dis-dc-rule-attr to new-dis-dc-rule-attr.
      373   end.
      374   if varstay-history then do:
      375   for each old-c-dis-card  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      376      create new-c-dis-card.
      377      buffer-copy old-c-dis-card to new-c-dis-card.
      378   end.
      379   for each old-c-dis-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      380      create new-c-dis-obj.
      381      buffer-copy old-c-dis-obj to new-c-dis-obj.
      382   end.
      383   for each old-c-dis-host  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      384      create new-c-dis-host.
      385      buffer-copy old-c-dis-host to new-c-dis-host.
      386   end.
      387   for each old-c-dc-hist  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      388      create new-c-dc-hist.
      389      buffer-copy old-c-dc-hist to new-c-dc-hist.
      390   end.
      391   for each old-c-dis-card-property  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      392      create new-c-dis-card-property.
      393      buffer-copy old-c-dis-card-property to new-c-dis-card-property.
      394   end.
      395   for each old-c-dis-card-long  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      396      create new-c-dis-card-long.
      397      buffer-copy old-c-dis-card-long to new-c-dis-card-long.
      398   end.
      399   for each old-c-dis-card-long-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      400      create new-c-dis-card-long-attr.
      401      buffer-copy old-c-dis-card-long-attr to new-c-dis-card-long-attr.
      402   end.
      403   for each old-c-dis-dc-rule  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      404      create new-c-dis-dc-rule.
      405      buffer-copy old-c-dis-dc-rule to new-c-dis-dc-rule.
      406   end.
      407   end.
      408   _payment:
      409   for each old-payment no-lock
      410   break
      411   by old-payment.source-type
      412   by old-payment.source-ref
      413   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      414     v-export = no.
      415     if old-payment.d-card = '':u
      416     or (vardate-actual-docs <> ?
      417         and old-payment.fact-date >= vardate-actual-docs)
      418     or not (old-payment.source-type = 'накл':U
      419            or
      420            old-payment.source-type = 'касс':U)
      421     then do:
      422       case old-payment.source-type:
      423         when 'платеж':U then do:
      424           if old-payment.pmnt-code begins "-" then do:
      425             find first new-c-fin-doc no-lock where
      426                       new-c-fin-doc.host-code = old-payment.host-code
      427                   and new-c-fin-doc.fin-doc-code = integer(entry(2, old-payment.source-ref, "-"))
      428                   and new-c-fin-doc.is-del = yes
      429                   no-error.
      430             if available new-c-fin-doc then do:
      431               v-export = yes.
      432             end.
      433           end.
      434           else do:
      435             find first new-fin-doc no-lock where
      436                       new-fin-doc.host-code = old-payment.host-code
      437                   and new-fin-doc.fin-doc-code = integer(old-payment.source-ref)
      438                   no-error.
      439             if available new-fin-doc then do:
      440               v-export = yes.
      441             end.
      442           end.
      443         end.
      444         when 'заказ':U then do:
      445           find first new-ord-doc no-lock where
      446                     new-ord-doc.doc-code = old-payment.source-ref no-error.
      447           if available new-ord-doc then do:
      448             v-export = yes.
      449           end.
      450         end.
      451       end case.
      452       if v-export then do:
      453         create new-payment.
      454         buffer-copy old-payment to new-payment.
      455         next _payment.
      456       end.
      457     end.
      458     else do:
      459       if old-payment.source-type = 'накл':U then do:
      460         find first new-trn-doc no-lock where
      461                   new-trn-doc.doc-code = old-payment.source-ref no-error.
      462         if not available new-trn-doc then do:
      463           find first new-c-trn-doc no-lock where
      464                     new-c-trn-doc.doc-code = old-payment.source-ref no-error.
      465           if not available new-c-trn-doc then do:
      466             find first old-trn-doc no-lock where
      467                       old-trn-doc.doc-code = old-payment.source-ref no-error.
      468             if not available old-trn-doc then do:
      469               find first old-c-trn-doc no-lock where
      470                         old-c-trn-doc.doc-code = old-payment.source-ref no-error.
      471               if available old-c-inkas then do:
      472                 assign
      473                 v-obj-type = old-c-trn-doc.obj-type
      474                 v-obj-code = old-c-trn-doc.obj-code
      475                 .
      476               end.
      477               else do:
      478                 assign
      479                 v-obj-type = 'маг':U
      480                 v-obj-code = 0
      481                 .
      482               end.
      483             end.
      484             else do:
      485               assign
      486               v-obj-type = old-trn-doc.obj-type
      487               v-obj-code = old-trn-doc.obj-code
      488               .
      489             end.
      490             run create-sum-record ( buffer old-payment
      491                                   , input v-obj-type
      492                                   , input v-obj-code
      493                                   ).
      494           end.
      495         end.
      496         else do:
      497           create new-payment.
      498           buffer-copy old-payment to new-payment.
      499         end.
      500       end.
      501       if old-payment.source-type = 'касс':U then do:
      502         find first new-inkas no-lock where
      503                   new-inkas.inkas-code = old-payment.source-ref no-error.
      504         if not available new-inkas then do:
      505           find first new-c-inkas no-lock where
      506                     new-c-inkas.inkas-code = old-payment.source-ref no-error.
      507           if not available new-c-inkas then do:
      508             find first old-inkas no-lock where
      509                       old-inkas.inkas-code = old-payment.source-ref no-error.
      510             if not available old-inkas then do:
      511               find first old-c-inkas no-lock where
      512                         old-c-inkas.inkas-code = old-payment.source-ref no-error.
      513               if available old-c-inkas then do:
      514                 assign
      515                 v-obj-type = old-c-inkas.obj-type
      516                 v-obj-code = old-c-inkas.obj-code
      517                 .
      518               end.
      519               else do:
      520                 assign
      521                 v-obj-type = 'маг':U
      522                 v-obj-code = 0
      523                 .
      524               end.
      525             end.
      526             else do:
      527               assign
      528               v-obj-type = old-inkas.obj-type
      529               v-obj-code = old-inkas.obj-code
      530               .
      531             end.
      532             run create-sum-record ( buffer old-payment
      533                                   , input v-obj-type
      534                                   , input v-obj-code
      535                                   ).
      536           end.
      537         end.
      538         else do:
      539           create new-payment.
      540           buffer-copy old-payment to new-payment.
      541         end.
      542       end.
      543     end.
      544   end.
      545   for each old-payment-attr no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      546     find first new-payment no-lock where new-payment.pmnt-code = old-payment-attr.pmnt-code no-error.
      547     if available new-payment then do:
      548       create new-payment-attr.
      549       buffer-copy old-payment-attr to new-payment-attr.
      550     end.
      551   end.
      552   for each old-c-payment no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      553     find first new-payment no-lock where new-payment.pmnt-code = old-c-payment.pmnt-code no-error.
      554     if available new-payment then do:
      555       create new-c-payment.
      556       buffer-copy old-c-payment to new-payment.
      557     end.
      558   end.
      559   for each old-c-payment-attr no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      560     find first new-payment no-lock where new-payment.pmnt-code = old-c-payment-attr.pmnt-code no-error.
      561     if available new-payment then do:
      562       create new-c-payment-attr.
      563       buffer-copy old-c-payment-attr to new-payment-attr.
      564     end.
      565   end.
      566   for each old-stop-list no-lock
      567   where old-stop-list.status_ = 'факт':U
      568     and (vardate-actual-docs = ? or old-stop-list.fact-date >= vardate-actual-docs)
      569     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      570    create new-stop-list.
      571    buffer-copy old-stop-list to new-stop-list.
      572    for each old-stop-list-line no-lock where
      573           old-stop-list-line.classif-type = old-stop-list.classif-type
      574       and old-stop-list-line.stop-list-code = old-stop-list.stop-list-code
      575        on error undo, return error:
      576      create new-stop-list-line.
      577      buffer-copy old-stop-list-line to new-stop-list-line.
      578    end.
      579    for each old-stop-list-line-attr no-lock where
      580           old-stop-list-line-attr.classif-type = old-stop-list.classif-type
      581       and old-stop-list-line-attr.stop-list-code = old-stop-list.stop-list-code
      582        on error undo, return error:
      583      create new-stop-list-line-attr.
      584      buffer-copy old-stop-list-line-attr to new-stop-list-line-attr.
      585    end.
      586    if varstay-history then do:
      587     for each old-c-stop-list no-lock where
      588             old-c-stop-list.classif-type = old-stop-list.classif-type
      589         and old-c-stop-list.stop-list-code = old-stop-list.stop-list-code
      590         on error undo, return error:
      591       create new-c-stop-list.
      592       buffer-copy old-c-stop-list to new-c-stop-list.
      593     end.
      594     for each old-c-stop-list-line no-lock where
      595             old-c-stop-list-line.classif-type = old-stop-list.classif-type
      596         and old-c-stop-list-line.stop-list-code = old-stop-list.stop-list-code
      597         on error undo, return error:
      598       create new-c-stop-list-line.
      599       buffer-copy old-c-stop-list-line to new-c-stop-list-line.
      600     end.
      601    end.
      602    for each old-stop-list-attr no-lock where
      603           old-stop-list-attr.classif-type = old-stop-list.classif-type
      604       and old-stop-list-attr.stop-list-code = old-stop-list.stop-list-code
      605        on error undo, return error:
      606      create new-stop-list-attr.
      607      buffer-copy old-stop-list-attr to new-stop-list-attr.
      608    end.
      609   end.
      610   output stream str-gen close.
      611   return "Произведен экспорт таблиц: dis-card-type c-dis-card-type dis-card-mask c-dis-card-mask dis-dct-rule dis-dct-rule-attr c-dis-dct-rule ~
      612   dis-rule c-dis-rule dis-rule-attr c-dis-rule-attr dis-time-rule c-dis-time-rule dis-time-rule-attr ~
      613   dis-cfg-rule dis-cfg-rule-attr c-dis-cfg-rule drt-prop c-drt-prop  dis-some-rule dis-some-rule-attr c-dis-some-rule ~
      614   dis-card c-dc-hist c-dis-card  dis-obj c-dis-obj dis-host c-dis-dis-host dis-card-type-property c-dis-card-type-property ~
      615   dis-card-long c-dis-card-long dis-card-long-attr c-dis-card-long-attr dis-dc-rule c-dis-dc-rule dis-dc-rule-attr ~
      616   payment c-payment payment-attr c-payment-attr ~
      617   stop-list c-stop-list stop-list-line stop-list-line-attr c-stop-list-line stop-list-attr .".
      618   end.
      619   procedure create-sum-record :
      620   define parameter buffer old-payment for src.payment.
      621   define input parameter p-obj-type as character no-undo .
      622   define input parameter p-obj-code as integer no-undo .
      623   define variable v-source-ref as character no-undo .
      624   define buffer new-payment for dst.payment.
      625     do
      626     on error undo, return error return-value
      627     :
      628        v-source-ref = substitute('&1&2-&3-&4'
      629                                 , p-obj-type
      630                                 , p-obj-code
      631                                 , string(vardate-actual-docs, '99/99/9999')
      632                                 , old-payment.pay-code
      633                                 ).
      634        find first new-payment where
      635                 new-payment.host-code = old-payment.host-code
      636             and new-payment.d-card = old-payment.d-card
      637             and new-payment.source-type = old-payment.source-type
      638             and new-payment.source-ref = v-source-ref
      639             and new-payment.status_ = 'факт':U
      640             and new-payment.fact-date = vardate-actual-docs
      641             no-error.
      642        if not available new-payment then do:
      643          create new-payment.
      644          buffer-copy old-payment
      645          except source-ref fact-date exch-date
      646          to new-payment
      647          assign
      648          new-payment.source-ref = v-source-ref
      649          new-payment.fact-date = vardate-actual-docs
      650          new-payment.exch-date = vardate-actual-docs
      651          .
      652        end.
      653        else do:
      654         assign
      655         new-payment.tot-base = new-payment.tot-base + old-payment.tot-base
      656         new-payment.tot-cli  = new-payment.tot-cli  + old-payment.tot-cli
      657         new-payment.tot-rubl = new-payment.tot-rubl + old-payment.tot-rubl
      658         .
      659        end.
      660     end.
      661   end procedure.
