      132   do
      133   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      134   define input parameter vartype-cut            as integer   no-undo.
      135   define input parameter varlist-db             as character no-undo.
      136   define input parameter vardate-actual-goods   as date      no-undo.
      137   define input parameter vardate-actual-docs    as date      no-undo.
      138   define input parameter vardate-actual-findoc  as date      no-undo.
      139   define input parameter vardate-output-zone    as date      no-undo.
      140   define input parameter varstay-recipe-goods   as logical   no-undo.
      141   define input parameter varstay-weight-goods   as logical   no-undo.
      142   define input parameter varnot-copy-del-goods  as logical   no-undo.
      143   define input parameter varstay-history        as logical   no-undo.
      144   define input parameter vargen-file            as character no-undo.
      145   define stream str-gen.
      146   output stream str-gen to vargen-file append.
      147   if not connected("src") then do:
      148      return error "Нет коннекта с базой 'src'.".
      149   end.
      150   if not connected("dst") then do:
      151      return error "Нет коннекта с базой 'dst'.".
      152   end.
      153   find src.sys-ctrl no-lock.
      154   if not available src.sys-ctrl then do:
      155      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      156   end.
      157   if src.sys-ctrl.db-num <> 0 then do:
      158      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      159   end.
      160   if vardate-actual-docs <> ? and
      161      (vardate-actual-goods   > vardate-actual-docs or
      162       vardate-actual-goods   = ? )   then do:
      163         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      164                                 "Дата актуальности товаров &1."        +
      165                                 "Дата актуальности документов &2."     +
      166                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      167                                 vardate-actual-goods,
      168                                 vardate-actual-docs).
      169   end.
