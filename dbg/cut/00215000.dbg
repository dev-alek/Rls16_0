        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00215000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00215000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 215.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-criterion-analysis          for src.criterion-analysis.
       13   define buffer new-criterion-analysis          for dst.criterion-analysis.
       14   define buffer old-criterion-analysis-attr     for src.criterion-analysis-attr.
       15   define buffer new-criterion-analysis-attr     for dst.criterion-analysis-attr.
       16   do
       17   on error undo, return error
       18   :
       19   define input parameter vartype-cut            as integer   no-undo.
       20   define input parameter varlist-db             as character no-undo.
       21   define input parameter vardate-actual-goods   as date      no-undo.
       22   define input parameter vardate-actual-docs    as date      no-undo.
       23   define input parameter vardate-actual-findoc  as date      no-undo.
       24   define input parameter vardate-output-zone    as date      no-undo.
       25   define input parameter varstay-recipe-goods   as logical   no-undo.
       26   define input parameter varstay-weight-goods   as logical   no-undo.
       27   define input parameter varnot-copy-del-goods  as logical   no-undo.
       28   define input parameter varstay-history        as logical   no-undo.
       29   define input parameter vargen-file            as character no-undo.
       30   define stream str-gen.
       31   output stream str-gen to vargen-file append.
       32   if not connected("src") then do:
       33      return error "Нет коннекта с базой 'src'.".
       34   end.
       35   if not connected("dst") then do:
       36      return error "Нет коннекта с базой 'dst'.".
       37   end.
       38   find src.sys-ctrl no-lock.
       39   if not available src.sys-ctrl then do:
       40      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       41   end.
       42   if src.sys-ctrl.db-num <> 0 then do:
       43      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       44   end.
       45   if vardate-actual-docs <> ? and
       46      (vardate-actual-goods   > vardate-actual-docs or
       47       vardate-actual-goods   = ? )   then do:
       48         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       49                                 "Дата актуальности товаров &1."        +
       50                                 "Дата актуальности документов &2."     +
       51                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       52                                 vardate-actual-goods,
       53                                 vardate-actual-docs).
       54   end.
       55     on WRITE of dst.criterion-analysis            override do: end.
       56     on WRITE of dst.criterion-analysis-attr       override do: end.
       57   for each old-criterion-analysis  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       58      create new-criterion-analysis.
       59      buffer-copy old-criterion-analysis to new-criterion-analysis.
       60   end.
       61   for each old-criterion-analysis-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       62      create new-criterion-analysis-attr.
       63      buffer-copy old-criterion-analysis-attr to new-criterion-analysis-attr.
       64   end.
       65   output stream str-gen close.
       66     return "Произведен экспорт таблиц: criterion-analysis criterion-analysis-attr  . " .
       67   end.
