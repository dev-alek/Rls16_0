        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00008000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00008000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 8.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-season          for src.season.
       13   define buffer new-season          for dst.season.
       14   define buffer old-c-season        for src.c-season.
       15   define buffer new-c-season        for dst.c-season.
       16   define buffer old-gds-season      for src.gds-season.
       17   define buffer new-gds-season      for dst.gds-season.
       18   define buffer old-c-gds-season    for src.c-gds-season.
       19   define buffer new-c-gds-season    for dst.c-gds-season.
       20   define buffer old-season-attr     for src.season-attr.
       21   define buffer new-season-attr     for dst.season-attr.
       22   define buffer old-gds-season-attr for src.gds-season-attr.
       23   define buffer new-gds-season-attr for dst.gds-season-attr.
       24   define buffer new-goods           for dst.goods.
       25   do
       26   on error undo, return error
       27   :
       28   define input parameter vartype-cut            as integer   no-undo.
       29   define input parameter varlist-db             as character no-undo.
       30   define input parameter vardate-actual-goods   as date      no-undo.
       31   define input parameter vardate-actual-docs    as date      no-undo.
       32   define input parameter vardate-actual-findoc  as date      no-undo.
       33   define input parameter vardate-output-zone    as date      no-undo.
       34   define input parameter varstay-recipe-goods   as logical   no-undo.
       35   define input parameter varstay-weight-goods   as logical   no-undo.
       36   define input parameter varnot-copy-del-goods  as logical   no-undo.
       37   define input parameter varstay-history        as logical   no-undo.
       38   define input parameter vargen-file            as character no-undo.
       39   define stream str-gen.
       40   output stream str-gen to vargen-file append.
       41   if not connected("src") then do:
       42      return error "Нет коннекта с базой 'src'.".
       43   end.
       44   if not connected("dst") then do:
       45      return error "Нет коннекта с базой 'dst'.".
       46   end.
       47   find src.sys-ctrl no-lock.
       48   if not available src.sys-ctrl then do:
       49      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       50   end.
       51   if src.sys-ctrl.db-num <> 0 then do:
       52      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       53   end.
       54   if vardate-actual-docs <> ? and
       55      (vardate-actual-goods   > vardate-actual-docs or
       56       vardate-actual-goods   = ? )   then do:
       57         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       58                                 "Дата актуальности товаров &1."        +
       59                                 "Дата актуальности документов &2."     +
       60                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       61                                 vardate-actual-goods,
       62                                 vardate-actual-docs).
       63   end.
       64     on WRITE of dst.season        override do: end.
       65     on WRITE of dst.season-attr   override do: end.
       66     on WRITE of dst.c-season      override do: end.
       67     on WRITE of dst.gds-season    override do: end.
       68     on WRITE of dst.gds-season-attr override do: end.
       69     on WRITE of dst.c-gds-season  override do: end.
       70   for each old-season  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       71      create new-season.
       72      buffer-copy old-season to new-season.
       73   end.
       74   for each old-season-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       75      create new-season-attr.
       76      buffer-copy old-season-attr to new-season-attr.
       77   end.
       78     for each old-gds-season no-lock ,
       79         first new-goods no-lock where new-goods.gds-code = old-gds-season.gds-code
       80         on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       81         :
       82         create new-gds-season.
       83         BUFFER-COPY old-gds-season to new-gds-season.
       84     end.
       85     for each old-gds-season-attr no-lock ,
       86         first new-goods no-lock where new-goods.gds-code = old-gds-season-attr.gds-code
       87         on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       88         :
       89         create new-gds-season-attr.
       90         BUFFER-COPY old-gds-season-attr to new-gds-season-attr.
       91     end.
       92     if varstay-history = true then do:
       93   for each old-c-season  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       94      create new-c-season.
       95      buffer-copy old-c-season to new-c-season.
       96   end.
       97         for each old-c-gds-season no-lock ,
       98             first new-goods no-lock where new-goods.gds-code = old-c-gds-season.gds-code
       99             on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      100             :
      101             create new-c-gds-season.
      102             BUFFER-COPY old-c-gds-season to new-c-gds-season.
      103         end.
      104     end.
      105     output stream str-gen close.
      106     return "Произведен экспорт таблиц: season gds-season c-season c-gds-season season-attr gds-season-attr . " .
      107   end.
