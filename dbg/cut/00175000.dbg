        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00175000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00175000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 175.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-units      for src.units.
       13   define buffer new-units      for dst.units.
       14   define buffer old-c-units    for src.c-units.
       15   define buffer new-c-units    for dst.c-units.
       16   define buffer old-units-attr for src.units-attr.
       17   define buffer new-units-attr for dst.units-attr.
       18   define buffer old-tare      for src.tare.
       19   define buffer new-tare      for dst.tare.
       20   define buffer old-c-tare    for src.c-tare.
       21   define buffer new-c-tare    for dst.c-tare.
       22   do
       23   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       24   define input parameter vartype-cut            as integer   no-undo.
       25   define input parameter varlist-db             as character no-undo.
       26   define input parameter vardate-actual-goods   as date      no-undo.
       27   define input parameter vardate-actual-docs    as date      no-undo.
       28   define input parameter vardate-actual-findoc  as date      no-undo.
       29   define input parameter vardate-output-zone    as date      no-undo.
       30   define input parameter varstay-recipe-goods   as logical   no-undo.
       31   define input parameter varstay-weight-goods   as logical   no-undo.
       32   define input parameter varnot-copy-del-goods  as logical   no-undo.
       33   define input parameter varstay-history        as logical   no-undo.
       34   define input parameter vargen-file            as character no-undo.
       35   define stream str-gen.
       36   output stream str-gen to vargen-file append.
       37   if not connected("src") then do:
       38      return error "Нет коннекта с базой 'src'.".
       39   end.
       40   if not connected("dst") then do:
       41      return error "Нет коннекта с базой 'dst'.".
       42   end.
       43   find src.sys-ctrl no-lock.
       44   if not available src.sys-ctrl then do:
       45      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       46   end.
       47   if src.sys-ctrl.db-num <> 0 then do:
       48      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       49   end.
       50   if vardate-actual-docs <> ? and
       51      (vardate-actual-goods   > vardate-actual-docs or
       52       vardate-actual-goods   = ? )   then do:
       53         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       54                                 "Дата актуальности товаров &1."        +
       55                                 "Дата актуальности документов &2."     +
       56                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       57                                 vardate-actual-goods,
       58                                 vardate-actual-docs).
       59   end.
       60   on WRITE of dst.units override do: end.
       61   on WRITE of dst.c-units override do: end.
       62   on WRITE of dst.tare override do: end.
       63   on WRITE of dst.c-tare override do: end.
       64   on WRITE of dst.units-attr override do: end.
       65   for each old-units  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       66      create new-units.
       67      buffer-copy old-units to new-units.
       68   end.
       69   if varstay-history then do:
       70   for each old-c-units  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       71      create new-c-units.
       72      buffer-copy old-c-units to new-c-units.
       73   end.
       74   end.
       75   for each old-units-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       76      create new-units-attr.
       77      buffer-copy old-units-attr to new-units-attr.
       78   end.
       79   for each old-tare  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       80      create new-tare.
       81      buffer-copy old-tare to new-tare.
       82   end.
       83   if varstay-history then do:
       84   for each old-c-tare  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       85      create new-c-tare.
       86      buffer-copy old-c-tare to new-c-tare.
       87   end.
       88   end.
       89   output stream str-gen close.
       90   return "Произведен экспорт таблиц: units c-units units-attr tare c-tare .".
       91   end.
