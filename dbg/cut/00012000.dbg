        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00012000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00012000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 12.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       13   define new global shared variable g#attr-lib  as handle no-undo .
       14   define variable v-attr-lib-variable as handle no-undo .
       15   procedure db-attr-code :
       16     define input  parameter p-code           as character no-undo .
       17     define output parameter p-type           as character no-undo .
       18     define output parameter p-format         as character no-undo .
       19     define output parameter p-label          as character no-undo .
       20     define output parameter p-user-can-edit  as logical   no-undo .
       21     define output parameter p-output-display as logical   no-undo .
       22     define output parameter p-other          as character no-undo .
       23     do
       24     on error undo, return error
       25     :
       26           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
       27         (input  p-code
       28         ,output p-type
       29         ,output p-format
       30         ,output p-label
       31         ,output p-user-can-edit
       32         ,output p-output-display
       33         ,output p-other
       34         ) no-error .
       35       if error-status :error
       36       then do:
       37         undo, return error return-value .
       38       end.
       39     end.
       40   end procedure.
       41   procedure db-attr-tooltip :
       42     define input  parameter p-code    as character no-undo .
       43     define output parameter p-tooltip as character no-undo .
       44     define output parameter p-label   as character no-undo .
       45     do
       46     on error undo, return error
       47     :
       48           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-tooltip in g#attr-lib
       49         (input  p-code
       50         ,output p-tooltip
       51         ,output p-label
       52         ) no-error .
       53       if error-status :error
       54       then do:
       55         undo, return error return-value .
       56       end.
       57     end.
       58   end procedure.
       59   procedure db-attr-value :
       60     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
       61     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
       62     define output parameter p-value     like ub.db-attr.attr-value no-undo .
       63     define output parameter p-type      as character no-undo .
       64     do
       65     on error undo, return error
       66     :
       67           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
       68         (input  p-db-num
       69         ,input  p-code
       70         ,output p-value
       71         ,output p-type
       72         ) no-error .
       73       if error-status :error
       74       then do:
       75         undo, return error return-value .
       76       end.
       77     end.
       78   end procedure.
       79   procedure db-attr-write :
       80     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
       81     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
       82     define input parameter p-value     like ub.db-attr.attr-value no-undo .
       83     do
       84     on error undo, return error
       85     :
       86           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
       87         (input p-db-num
       88         ,input p-code
       89         ,input p-value
       90         ) no-error .
       91       if error-status :error
       92       then do:
       93         undo, return error return-value .
       94       end.
       95     end.
       96   end procedure.
       97   procedure db-attr-exist :
       98     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
       99     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      100     define output parameter p-exist    as logical  no-undo .
      101     do
      102     on error undo, return error
      103     :
      104           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
      105         (input  p-db-num
      106         ,input  p-code
      107         ,output p-exist
      108         ) no-error .
      109       if error-status :error
      110       then do:
      111         undo, return error return-value .
      112       end.
      113     end.
      114   end procedure.
      115   procedure db-attr-delete :
      116     define input  parameter p-db-num   like ub.db-attr.db-num     no-undo .
      117     define input  parameter p-code     like ub.db-attr.attr-code  no-undo .
