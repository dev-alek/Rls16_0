      165   procedure db-attr-batch-edit :
      166     define input  parameter p-code           as character no-undo .
      167     define output parameter p-section-num    as integer no-undo .
      168     do
      169     on error undo, return error
      170     :
      171           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-batch-edit in g#attr-lib
      172         (input  p-code
      173         ,output p-section-num
