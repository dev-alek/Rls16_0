      133   procedure db-attr-news :
      134     define input  parameter p-code           as character no-undo .
      135     define output parameter p-news           as logical   no-undo .
      136     do
      137     on error undo, return error
      138     :
      139           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-news in g#attr-lib
      140         (input  p-code
      141         ,output p-news
      142         ) no-error .
      143       if error-status :error
      144       then do:
      145         undo, return error return-value .
      146       end.
