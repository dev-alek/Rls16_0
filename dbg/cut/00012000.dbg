      119     do
      120     on error undo, return error
      121     :
      122           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-delete in g#attr-lib
      123         (input  p-db-num
      124         ,input  p-code
      125         ,output p-deleted
      126         ) no-error .
      127       if error-status :error
      128       then do:
      129         undo, return error return-value .
