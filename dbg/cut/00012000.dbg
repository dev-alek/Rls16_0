      181   define buffer old-db          for src.db.
      182   define buffer new-db          for dst.db.
      183   define buffer old-c-db        for src.c-db.
      184   define buffer new-c-db        for dst.c-db.
      185   define buffer old-db-info     for src.db-info.
      186   define buffer new-db-info     for dst.db-info.
      187   define buffer old-db-status   for src.db-status.
      188   define buffer new-db-status   for dst.db-status.
      189   define buffer old-db-status-attr   for src.db-status-attr.
      190   define buffer new-db-status-attr   for dst.db-status-attr.
      191   define buffer old-db-attr     for src.db-attr.
      192   define buffer new-db-attr     for dst.db-attr.
      193   define buffer old-db-rec-attr for src.db-rec-attr.
      194   define buffer new-db-rec-attr for dst.db-rec-attr.
      195   define buffer old-hist-nws-option  for src.hist-nws-option.
      196   define buffer new-hist-nws-option  for dst.hist-nws-option.
      197   define buffer old-c-hist-nws-option  for src.c-hist-nws-option.
      198   define buffer new-c-hist-nws-option  for dst.c-hist-nws-option.
      199   define buffer old-hist-nws-option-attr  for src.hist-nws-option-attr.
      200   define buffer new-hist-nws-option-attr  for dst.hist-nws-option-attr.
      201   define buffer old-c-hist-nws-option-attr  for src.c-hist-nws-option-attr.
      202   define buffer new-c-hist-nws-option-attr  for dst.c-hist-nws-option-attr.
      203   do
      204   on error undo, return error
      205   :
      206   define input parameter vartype-cut            as integer   no-undo.
      207   define input parameter varlist-db             as character no-undo.
      208   define input parameter vardate-actual-goods   as date      no-undo.
      209   define input parameter vardate-actual-docs    as date      no-undo.
      210   define input parameter vardate-actual-findoc  as date      no-undo.
      211   define input parameter vardate-output-zone    as date      no-undo.
      212   define input parameter varstay-recipe-goods   as logical   no-undo.
      213   define input parameter varstay-weight-goods   as logical   no-undo.
      214   define input parameter varnot-copy-del-goods  as logical   no-undo.
      215   define input parameter varstay-history        as logical   no-undo.
      216   define input parameter vargen-file            as character no-undo.
      217   define stream str-gen.
      218   output stream str-gen to vargen-file append.
      219   if not connected("src") then do:
      220      return error "Нет коннекта с базой 'src'.".
      221   end.
      222   if not connected("dst") then do:
      223      return error "Нет коннекта с базой 'dst'.".
      224   end.
      225   find src.sys-ctrl no-lock.
      226   if not available src.sys-ctrl then do:
      227      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      228   end.
      229   if src.sys-ctrl.db-num <> 0 then do:
      230      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      231   end.
      232   if vardate-actual-docs <> ? and
      233      (vardate-actual-goods   > vardate-actual-docs or
      234       vardate-actual-goods   = ? )   then do:
      235         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      236                                 "Дата актуальности товаров &1."        +
      237                                 "Дата актуальности документов &2."     +
      238                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      239                                 vardate-actual-goods,
      240                                 vardate-actual-docs).
      241   end.
      242     on WRITE of dst.db          override do: end.
      243     on WRITE of dst.c-db        override do: end.
      244     on WRITE of dst.db-info     override do: end.
      245     on WRITE of dst.db-status   override do: end.
      246     on WRITE of dst.db-status-attr override do: end.
      247     on write of dst.db-attr     override do: end.
      248     on write of dst.db-rec-attr override do: end.
      249     on WRITE of dst.hist-nws-option  override do: end.
      250     on WRITE of dst.c-hist-nws-option  override do: end.
      251     on WRITE of dst.hist-nws-option-attr  override do: end.
      252     on WRITE of dst.c-hist-nws-option-attr  override do: end.
      253     for each old-db no-lock
      254     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      255     :
      256       create new-db.
      257       buffer-copy old-db to new-db.
      258       if old-db.db-num <> 0
      259          and vartype-cut <> 1
      260       then do:
      261         assign
      262           new-db.db-key = ""
      263           new-db.db-key-enc = ""
      264         .
      265       end.
      266     end.
      267     if varstay-history then do:
      268   for each old-c-db  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      269      create new-c-db.
      270      buffer-copy old-c-db to new-c-db.
      271   end.
      272     end.
      273   for each old-db-info  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      274      create new-db-info.
      275      buffer-copy old-db-info to new-db-info.
      276   end.
      277   for each old-db-status  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      278      create new-db-status.
      279      buffer-copy old-db-status to new-db-status.
      280   end.
      281   for each old-db-status-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      282      create new-db-status-attr.
      283      buffer-copy old-db-status-attr to new-db-status-attr.
      284   end.
      285     for each old-db-attr no-lock
      286     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      287     :
      288       if vartype-cut = 0
      289         and old-db-attr.attr-code = 'cut-fin-date':U
      290       then do:
      291         next.
      292       end.
      293       create new-db-attr.
      294       buffer-copy old-db-attr to new-db-attr.
      295     end.
      296   for each old-db-rec-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      297      create new-db-rec-attr.
      298      buffer-copy old-db-rec-attr to new-db-rec-attr.
      299   end.
      300   for each old-hist-nws-option  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      301      create new-hist-nws-option.
      302      buffer-copy old-hist-nws-option to new-hist-nws-option.
      303   end.
      304     if varstay-history then do:
      305   for each old-c-hist-nws-option  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      306      create new-c-hist-nws-option.
      307      buffer-copy old-c-hist-nws-option to new-c-hist-nws-option.
      308   end.
      309     end.
      310   for each old-hist-nws-option-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      311      create new-hist-nws-option-attr.
      312      buffer-copy old-hist-nws-option-attr to new-hist-nws-option-attr.
      313   end.
      314     if varstay-history then do:
      315   for each old-c-hist-nws-option-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      316      create new-c-hist-nws-option-attr.
      317      buffer-copy old-c-hist-nws-option-attr to new-c-hist-nws-option-attr.
      318   end.
      319     end.
      320     output stream str-gen close.
      321     return "Произведен экспорт таблиц: db c-db db-status db-attr db-rec-attr hist-nws-option c-hist-nws-option hist-nws-option-attr c-hist-nws-option-attr.".
      322   end.
