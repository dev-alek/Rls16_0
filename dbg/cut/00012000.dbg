      149   procedure db-attr-manual-edit :
      150     define input  parameter p-code           as character no-undo .
      151     define output parameter p-section-num    as integer no-undo .
      152     do
      153     on error undo, return error
      154     :
      155           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-manual-edit in g#attr-lib
      156         (input  p-code
      157         ,output p-section-num
      158         ) no-error .
      159       if error-status :error
      160       then do:
      161         undo, return error return-value .
