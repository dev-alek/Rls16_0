      122   on WRITE of dst.action-role-item             override do: end.
      123   on WRITE of dst.action-role-item-attr        override do: end.
      124   on WRITE of dst.action-role-item-gds         override do: end.
      125   on WRITE of dst.action-role-item-gds-grp     override do: end.
      126   for each old-action-group  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      127      create new-action-group.
      128      buffer-copy old-action-group to new-action-group.
      129   end.
      130   for each old-action-group-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
