        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00206000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00206000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 104.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-action-group                for src.action-group               .
       13   define buffer old-action-group-attr           for src.action-group-attr          .
       14   define buffer old-action-head                 for src.action-head                .
       15   define buffer old-action-head-attr            for src.action-head-attr           .
       16   define buffer old-action-item                 for src.action-item                .
       17   define buffer old-action-item-attr            for src.action-item-attr           .
       18   define buffer old-action-post                 for src.action-post                .
       19   define buffer old-action-post-attr            for src.action-post-attr           .
