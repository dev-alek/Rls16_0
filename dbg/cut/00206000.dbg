       33   define buffer old-action-role-item-attr       for src.action-role-item-attr      .
       34   define buffer old-action-role-item-gds        for src.action-role-item-gds       .
       35   define buffer old-action-role-item-gds-grp    for src.action-role-item-gds-grp   .
       36   define buffer new-action-group                for dst.action-group               .
       37   define buffer new-action-group-attr           for dst.action-group-attr          .
       38   define buffer new-action-head                 for dst.action-head                .
       39   define buffer new-action-head-attr            for dst.action-head-attr           .
       40   define buffer new-action-item                 for dst.action-item                .
       41   define buffer new-action-item-attr            for dst.action-item-attr           .
       42   define buffer new-action-post                 for dst.action-post                .
       43   define buffer new-action-post-attr            for dst.action-post-attr           .
       44   define buffer new-action-post-host            for dst.action-post-host           .
       45   define buffer new-action-post-host-attr       for dst.action-post-host-attr      .
       46   define buffer new-action-post-menu-group      for dst.action-post-menu-group     .
       47   define buffer new-action-post-menu-group-attr for dst.action-post-menu-group-attr.
       48   define buffer new-action-post-obj             for dst.action-post-obj            .
       49   define buffer new-action-post-obj-attr        for dst.action-post-obj-attr       .
       50   define buffer new-action-post-role            for dst.action-post-role           .
       51   define buffer new-action-post-role-attr       for dst.action-post-role-attr      .
       52   define buffer new-action-post-user-login      for dst.action-post-user-login     .
       53   define buffer new-action-post-user-login-attr for dst.action-post-user-login-attr.
       54   define buffer new-action-role                 for dst.action-role                .
       55   define buffer new-action-role-attr            for dst.action-role-attr           .
       56   define buffer new-action-role-item            for dst.action-role-item           .
       57   define buffer new-action-role-item-attr       for dst.action-role-item-attr      .
       58   define buffer new-action-role-item-gds        for dst.action-role-item-gds       .
       59   define buffer new-action-role-item-gds-grp    for dst.action-role-item-gds-grp   .
       60   do
       61   on error undo, return error SUBSTITUTE ( "&1 &2 &3"
       62                                          , return-value
       63                                          , error-status:get-message(1)
       64                                          , error-status:get-message(2)
       65                                          ) :
       66   define input parameter vartype-cut            as integer   no-undo.
       67   define input parameter varlist-db             as character no-undo.
       68   define input parameter vardate-actual-goods   as date      no-undo.
       69   define input parameter vardate-actual-docs    as date      no-undo.
       70   define input parameter vardate-actual-findoc  as date      no-undo.
       71   define input parameter vardate-output-zone    as date      no-undo.
       72   define input parameter varstay-recipe-goods   as logical   no-undo.
       73   define input parameter varstay-weight-goods   as logical   no-undo.
       74   define input parameter varnot-copy-del-goods  as logical   no-undo.
       75   define input parameter varstay-history        as logical   no-undo.
       76   define input parameter vargen-file            as character no-undo.
       77   define stream str-gen.
       78   output stream str-gen to vargen-file append.
       79   if not connected("src") then do:
       80      return error "Нет коннекта с базой 'src'.".
       81   end.
       82   if not connected("dst") then do:
       83      return error "Нет коннекта с базой 'dst'.".
       84   end.
       85   find src.sys-ctrl no-lock.
       86   if not available src.sys-ctrl then do:
       87      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       88   end.
       89   if src.sys-ctrl.db-num <> 0 then do:
       90      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       91   end.
       92   if vardate-actual-docs <> ? and
       93      (vardate-actual-goods   > vardate-actual-docs or
       94       vardate-actual-goods   = ? )   then do:
       95         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       96                                 "Дата актуальности товаров &1."        +
       97                                 "Дата актуальности документов &2."     +
       98                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       99                                 vardate-actual-goods,
      100                                 vardate-actual-docs).
      101   end.
      102   on WRITE of dst.action-group                 override do: end.
      103   on WRITE of dst.action-group-attr            override do: end.
      104   on WRITE of dst.action-head                  override do: end.
      105   on WRITE of dst.action-head-attr             override do: end.
      106   on WRITE of dst.action-item                  override do: end.
      107   on WRITE of dst.action-item-attr             override do: end.
      108   on WRITE of dst.action-post                  override do: end.
      109   on WRITE of dst.action-post-attr             override do: end.
      110   on WRITE of dst.action-post-host             override do: end.
      111   on WRITE of dst.action-post-host-attr        override do: end.
      112   on WRITE of dst.action-post-menu-group       override do: end.
      113   on WRITE of dst.action-post-menu-group-attr  override do: end.
      114   on WRITE of dst.action-post-obj              override do: end.
      115   on WRITE of dst.action-post-obj-attr         override do: end.
      116   on WRITE of dst.action-post-role             override do: end.
      117   on WRITE of dst.action-post-role-attr        override do: end.
      118   on WRITE of dst.action-post-user-login       override do: end.
      119   on WRITE of dst.action-post-user-login-attr  override do: end.
      120   on WRITE of dst.action-role                  override do: end.
