      281      create new-c-ex-mark.
      282      buffer-copy old-c-ex-mark to new-c-ex-mark.
      283   end.
      284   end.
      285   for each old-egais-gds  , first new-goods where new-goods.gds-code = old-egais-gds.gds-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      286      create new-egais-gds.
      287      buffer-copy old-egais-gds to new-egais-gds.
      288   end.
