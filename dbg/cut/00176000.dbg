      174   end.
      175   for each old-alc-type-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      176      create new-alc-type-attr.
      177      buffer-copy old-alc-type-attr to new-alc-type-attr.
      178   end.
      179   for each old-alc-type-gds
      180       no-lock
      181       :
      182      FIND first new-goods
      183           where new-goods.gds-code = old-alc-type-gds.gds-code
      184           no-lock
      185           no-error
      186           .
      187      IF AVAILABLE new-goods
      188      THEN DO:
