       68   define buffer new-goods                  for dst.goods .
       69   do
       70   on error undo, return error SUBSTITUTE ( "&1 &2 &3"
       71                                          , return-value
       72                                          , error-status:get-message(1)
       73                                          , error-status:get-message(2)
       74                                          ) :
       75   define input parameter vartype-cut            as integer   no-undo.
       76   define input parameter varlist-db             as character no-undo.
       77   define input parameter vardate-actual-goods   as date      no-undo.
       78   define input parameter vardate-actual-docs    as date      no-undo.
       79   define input parameter vardate-actual-findoc  as date      no-undo.
       80   define input parameter vardate-output-zone    as date      no-undo.
       81   define input parameter varstay-recipe-goods   as logical   no-undo.
       82   define input parameter varstay-weight-goods   as logical   no-undo.
       83   define input parameter varnot-copy-del-goods  as logical   no-undo.
       84   define input parameter varstay-history        as logical   no-undo.
       85   define input parameter vargen-file            as character no-undo.
       86   define stream str-gen.
       87   output stream str-gen to vargen-file append.
       88   if not connected("src") then do:
       89      return error "Нет коннекта с базой 'src'.".
       90   end.
       91   if not connected("dst") then do:
       92      return error "Нет коннекта с базой 'dst'.".
       93   end.
       94   find src.sys-ctrl no-lock.
       95   if not available src.sys-ctrl then do:
       96      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       97   end.
       98   if src.sys-ctrl.db-num <> 0 then do:
       99      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      100   end.
      101   if vardate-actual-docs <> ? and
      102      (vardate-actual-goods   > vardate-actual-docs or
      103       vardate-actual-goods   = ? )   then do:
      104         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      105                                 "Дата актуальности товаров &1."        +
      106                                 "Дата актуальности документов &2."     +
      107                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      108                                 vardate-actual-goods,
      109                                 vardate-actual-docs).
      110   end.
      111   on WRITE of dst.alc-sale-lic                           override do: end.
      112   on WRITE of dst.alc-sale-lic-attr                      override do: end.
      113   on WRITE of dst.alc-sale-lic-type                      override do: end.
      114   on WRITE of dst.alc-sale-lic-type-attr                 override do: end.
      115   on WRITE of dst.alc-supp-lic                           override do: end.
      116   on WRITE of dst.alc-supp-lic-attr                      override do: end.
      117   on WRITE of dst.alc-supp-lic-type                      override do: end.
      118   on WRITE of dst.alc-supp-lic-type-attr                 override do: end.
      119   on WRITE of dst.alc-type                               override do: end.
      120   on WRITE of dst.alc-type-attr                          override do: end.
      121   on WRITE of dst.alc-type-gds                           override do: end.
      122   on WRITE of dst.alc-type-gds-attr                      override do: end.
      123   on WRITE of dst.c-alc-sale-lic                         override do: end.
      124   on WRITE of dst.c-alc-sale-lic-attr                    override do: end.
      125   on WRITE of dst.c-alc-sale-lic-type                    override do: end.
      126   on WRITE of dst.c-alc-supp-lic                         override do: end.
      127   on WRITE of dst.c-alc-supp-lic-attr                    override do: end.
      128   on WRITE of dst.c-alc-supp-lic-type                    override do: end.
      129   on WRITE of dst.c-alc-type                             override do: end.
      130   on WRITE of dst.c-alc-type-attr                        override do: end.
      131   on WRITE of dst.c-alc-type-gds                         override do: end.
      132   on WRITE of dst.c-ex-mark                              override do: end.
      133   on WRITE of dst.ex-mark                                override do: end.
      134   on WRITE of dst.ex-mark-attr                           override do: end.
      135   on WRITE of dst.egais-clients                          override do: end.
      136   on WRITE of dst.c-egais-clients                        override do: end.
      137   on WRITE of dst.egais-gds                              override do: end.
      138   on WRITE of dst.c-egais-gds                            override do: end.
      139   for each old-alc-sale-lic  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      140      create new-alc-sale-lic.
      141      buffer-copy old-alc-sale-lic to new-alc-sale-lic.
      142   end.
      143   for each old-alc-sale-lic-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      144      create new-alc-sale-lic-attr.
