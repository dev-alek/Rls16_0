      164      create new-alc-supp-lic-type.
      165      buffer-copy old-alc-supp-lic-type to new-alc-supp-lic-type.
      166   end.
      167   for each old-alc-supp-lic-type-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      168      create new-alc-supp-lic-type-attr.
