      190         BUFFER-COPY old-alc-type-gds to new-alc-type-gds.
      191      END.
      192   end.
      193   for each old-alc-type-gds-attr
      194      no-lock
      195      :
      196      FIND first new-goods
      197           where new-goods.gds-code = old-alc-type-gds-attr.gds-code
      198           no-lock
      199           no-error
      200           .
      201      IF AVAILABLE new-goods
      202      THEN DO:
      203         create new-alc-type-gds-attr.
      204         BUFFER-COPY old-alc-type-gds-attr to new-alc-type-gds-attr.
      205      END.
      206   end.
      207   if varstay-history then do:
      208   for each old-c-alc-sale-lic  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      209      create new-c-alc-sale-lic.
      210      buffer-copy old-c-alc-sale-lic to new-c-alc-sale-lic.
      211   end.
      212   end.
