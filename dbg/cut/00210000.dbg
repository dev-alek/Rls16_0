      104   do
      105   on error undo, return error
      106   :
      107   define input parameter vartype-cut            as integer   no-undo.
      108   define input parameter varlist-db             as character no-undo.
      109   define input parameter vardate-actual-goods   as date      no-undo.
      110   define input parameter vardate-actual-docs    as date      no-undo.
      111   define input parameter vardate-actual-findoc  as date      no-undo.
      112   define input parameter vardate-output-zone    as date      no-undo.
      113   define input parameter varstay-recipe-goods   as logical   no-undo.
      114   define input parameter varstay-weight-goods   as logical   no-undo.
      115   define input parameter varnot-copy-del-goods  as logical   no-undo.
      116   define input parameter varstay-history        as logical   no-undo.
      117   define input parameter vargen-file            as character no-undo.
      118   define stream str-gen.
      119   output stream str-gen to vargen-file append.
      120   if not connected("src") then do:
      121      return error "Нет коннекта с базой 'src'.".
      122   end.
      123   if not connected("dst") then do:
      124      return error "Нет коннекта с базой 'dst'.".
      125   end.
      126   find src.sys-ctrl no-lock.
      127   if not available src.sys-ctrl then do:
      128      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      129   end.
      130   if src.sys-ctrl.db-num <> 0 then do:
      131      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      132   end.
      133   if vardate-actual-docs <> ? and
      134      (vardate-actual-goods   > vardate-actual-docs or
      135       vardate-actual-goods   = ? )   then do:
      136         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      137                                 "Дата актуальности товаров &1."        +
      138                                 "Дата актуальности документов &2."     +
      139                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      140                                 vardate-actual-goods,
      141                                 vardate-actual-docs).
      142   end.
      143   for each old-condition-keeping  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      144      create new-condition-keeping.
      145      buffer-copy old-condition-keeping to new-condition-keeping.
      146   end.
      147     if varstay-history then do:
      148   for each old-c-condition-keeping  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      149      create new-c-condition-keeping.
      150      buffer-copy old-c-condition-keeping to new-c-condition-keeping.
      151   end.
      152     end.
