       83   define buffer new-c-chk-doc  for dst.c-chk-doc.
       84   define buffer old-c-chk-pay   for src.c-chk-pay .
       85   define buffer new-c-chk-pay   for dst.c-chk-pay.
       86   define buffer new-goods      for dst.goods.
       87   define buffer new-db      for dst.db .
       88   define buffer new-clients    for dst.clients.
       89   define variable varactual-goods  as logical no-undo.
       90   define variable v-temp-date as date no-undo .
       91   define variable v-fact-order as decimal no-undo .
       92   define variable find-fact-order  as decimal no-undo .
       93   define temp-table temp-new-wth-line no-undo like dst.wth-line.
       94   define stream LogStream.
       95   define new global shared variable g#language as character no-undo .
       96   if g#language <> '' and g#language <> 'rus':U then do:
       97     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       98   end.
       99   define  shared temp-table tt-objs no-undo
      100     field obj-type as character
      101     field obj-code as integer
      102     index pi is unique primary obj-type obj-code
      103     .
      104   do
      105   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      106   define input parameter vartype-cut            as integer   no-undo.
      107   define input parameter varlist-db             as character no-undo.
      108   define input parameter vardate-actual-goods   as date      no-undo.
      109   define input parameter vardate-actual-docs    as date      no-undo.
      110   define input parameter vardate-actual-findoc  as date      no-undo.
      111   define input parameter vardate-output-zone    as date      no-undo.
      112   define input parameter varstay-recipe-goods   as logical   no-undo.
      113   define input parameter varstay-weight-goods   as logical   no-undo.
      114   define input parameter varnot-copy-del-goods  as logical   no-undo.
      115   define input parameter varstay-history        as logical   no-undo.
      116   define input parameter vargen-file            as character no-undo.
      117   define stream str-gen.
      118   output stream str-gen to vargen-file append.
      119   if not connected("src") then do:
      120      return error "Нет коннекта с базой 'src'.".
      121   end.
      122   if not connected("dst") then do:
      123      return error "Нет коннекта с базой 'dst'.".
      124   end.
      125   find src.sys-ctrl no-lock.
      126   if not available src.sys-ctrl then do:
      127      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      128   end.
      129   if src.sys-ctrl.db-num <> 0 then do:
      130      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      131   end.
      132   if vardate-actual-docs <> ? and
      133      (vardate-actual-goods   > vardate-actual-docs or
      134       vardate-actual-goods   = ? )   then do:
      135         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      136                                 "Дата актуальности товаров &1."        +
      137                                 "Дата актуальности документов &2."     +
      138                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      139                                 vardate-actual-goods,
      140                                 vardate-actual-docs).
      141   end.
      142   on WRITE of dst.wealth          override do: end.
      143   on WRITE of dst.c-wealth        override do: end.
      144   on WRITE of dst.wealth-attr     override do: end.
      145   on WRITE of dst.wth-gds         override do: end.
      146   on WRITE of dst.c-wth-gds       override do: end.
      147   on WRITE of dst.wth-gds-attr    override do: end.
      148   on WRITE of dst.c-wth-gds-attr  override do: end.
      149   on WRITE of dst.wth-ser         override do: end.
      150   on WRITE of dst.c-wth-ser       override do: end.
      151   on WRITE of dst.wth-ser-attr    override do: end.
      152   on WRITE of dst.c-wth-ser-attr  override do: end.
      153   on WRITE of dst.wth-par         override do: end.
      154   on WRITE of dst.c-wth-par       override do: end.
      155   on WRITE of dst.wth-par-attr    override do: end.
      156   on WRITE of dst.wth-obj         override do: end.
      157   on WRITE of dst.c-wth-obj       override do: end.
      158   on WRITE of dst.wth-obj-attr    override do: end.
      159   on WRITE of dst.wth-pobj        override do: end.
      160   on WRITE of dst.c-wth-pobj      override do: end.
      161   on WRITE of dst.wth-pobj-attr   override do: end.
      162   on WRITE of dst.wth-place       override do: end.
      163   on WRITE of dst.c-wth-place     override do: end.
      164   on WRITE of dst.wth-place-attr  override do: end.
      165   on WRITE of dst.c-wth-hist      override do: end.
      166   on WRITE of dst.wth-doc         override do: end.
      167   on WRITE of dst.wth-doc-attr    override do: end.
      168   on WRITE of dst.wth-line        override do: end.
      169   on WRITE of dst.wth-line-attr   override do: end.
      170   on WRITE of dst.wth-dtl         override do: end.
      171   on WRITE of dst.wth-dtl-attr    override do: end.
      172   on WRITE of dst.wth-parts       override do: end.
      173   on WRITE of dst.wth-parts-attr  override do: end.
      174   on write of dst.chk-doc         override do: end.
      175   on write of dst.chk-doc-attr    override do: end.
      176   on write of dst.chk-pay         override do: end.
      177   on write of dst.chk-pay-attr    override do: end.
      178   on write of dst.c-chk-doc       override do: end.
      179   on write of dst.c-chk-pay       override do: end.
      180   for each old-wealth  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      181      create new-wealth.
      182      buffer-copy old-wealth to new-wealth.
      183   end.
      184   if varstay-history then do:
      185   for each old-c-wealth  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      186      create new-c-wealth.
      187      buffer-copy old-c-wealth to new-c-wealth.
      188   end.
      189   end.
      190   for each old-wealth-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      191      create new-wealth-attr.
      192      buffer-copy old-wealth-attr to new-wealth-attr.
      193   end.
      194   for each old-wth-ser  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      195      create new-wth-ser.
      196      buffer-copy old-wth-ser to new-wth-ser.
      197   end.
      198   for each old-wth-ser-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      199      create new-wth-ser-attr.
      200      buffer-copy old-wth-ser-attr to new-wth-ser-attr.
      201   end.
      202   if varstay-history then do:
      203   for each old-c-wth-ser  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      204      create new-c-wth-ser.
      205      buffer-copy old-c-wth-ser to new-c-wth-ser.
      206   end.
      207   for each old-c-wth-ser-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      208      create new-c-wth-ser-attr.
      209      buffer-copy old-c-wth-ser-attr to new-c-wth-ser-attr.
      210   end.
      211   end.
      212   for each old-wth-par  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      213      create new-wth-par.
      214      buffer-copy old-wth-par to new-wth-par.
      215   end.
      216   if varstay-history then do:
      217   for each old-c-wth-par  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      218      create new-c-wth-par.
      219      buffer-copy old-c-wth-par to new-c-wth-par.
      220   end.
      221   end.
      222   for each old-wth-par-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      223      create new-wth-par-attr.
      224      buffer-copy old-wth-par-attr to new-wth-par-attr.
      225   end.
      226   for each old-wth-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      227      create new-wth-obj.
      228      buffer-copy old-wth-obj to new-wth-obj.
      229   end.
      230   if varstay-history then do:
      231   for each old-c-wth-obj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      232      create new-c-wth-obj.
      233      buffer-copy old-c-wth-obj to new-c-wth-obj.
      234   end.
      235   end.
      236   for each old-wth-obj-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      237      create new-wth-obj-attr.
      238      buffer-copy old-wth-obj-attr to new-wth-obj-attr.
      239   end.
      240   for each old-wth-pobj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      241      create new-wth-pobj.
      242      buffer-copy old-wth-pobj to new-wth-pobj.
      243   end.
      244   if varstay-history then do:
      245   for each old-c-wth-pobj  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      246      create new-c-wth-pobj.
      247      buffer-copy old-c-wth-pobj to new-c-wth-pobj.
      248   end.
      249   end.
      250   for each old-wth-pobj-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      251      create new-wth-pobj-attr.
      252      buffer-copy old-wth-pobj-attr to new-wth-pobj-attr.
      253   end.
      254   for each old-wth-place  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      255      create new-wth-place.
      256      buffer-copy old-wth-place to new-wth-place.
      257   end.
      258   if varstay-history then do:
      259   for each old-c-wth-hist  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      260      create new-c-wth-hist.
      261      buffer-copy old-c-wth-hist to new-c-wth-hist.
      262   end.
      263   end.
      264   for each old-wth-gds no-lock
      265   on error undo, return error
      266   :
      267       find first new-goods no-lock
      268             where new-goods.gds-code     = old-wth-gds.gds-code
      269       no-error.
      270       if available new-goods
      271       then do:
      272           create new-wth-gds.
      273           buffer-copy old-wth-gds to new-wth-gds.
      274       end.
      275   end.
      276   for each old-wth-gds-attr no-lock
      277   on error undo, return error
      278   :
      279       find first new-goods no-lock
      280             where new-goods.gds-code     = old-wth-gds-attr.gds-code
      281       no-error.
      282       if available new-goods
      283       then do:
      284           create new-wth-gds-attr.
      285           buffer-copy old-wth-gds-attr to new-wth-gds-attr.
      286       end.
      287   end.
      288   if varstay-history then do:
      289     for each old-c-wth-gds no-lock
      290     on error undo, return error
      291     :
      292         find first new-goods no-lock
      293               where new-goods.gds-code     = old-c-wth-gds.gds-code
      294         no-error.
      295         if available new-goods
      296         then do:
      297             create new-c-wth-gds.
      298             buffer-copy old-c-wth-gds to new-c-wth-gds.
      299         end.
      300     end.
      301     for each old-c-wth-gds-attr no-lock
      302     on error undo, return error
      303     :
      304         find first new-goods no-lock
      305               where new-goods.gds-code     = old-c-wth-gds-attr.gds-code
      306         no-error.
      307         if available new-goods
      308         then do:
      309             create new-c-wth-gds-attr.
      310             buffer-copy old-c-wth-gds-attr to new-c-wth-gds-attr.
      311         end.
      312     end.
      313   end.
      314   if vardate-actual-docs <> ? then  do:
      315     v-temp-date = vardate-actual-docs  - 1 .
      316   end.
      317   else  do:
      318     v-temp-date = today .
      319   end.
      320   assign
      321   v-fact-order =  integer(v-temp-date) + 0.97 + 3 * 0.0000000001
      322   find-fact-order =  integer(v-temp-date) + 0.99
      323   .
      324   if vardate-actual-docs <> ? then do:
      325     for each new-db no-lock
      326     ,each new-clients no-lock
      327       where new-clients.db-num = new-db.db-num
      328     :
      329       if vartype-cut = 1 then do:
      330         find first tt-objs where tt-objs.obj-type = new-clients.obj-type and
      331                                   tt-objs.obj-code = new-clients.obj-code no-error.
      332       end.
      333       if vartype-cut = 0      or
      334           (vartype-cut = 1 and available tt-objs) then do:
      335         for each old-wth-doc where
      336                 old-wth-doc.host-code = new-clients.host-code
      337             and old-wth-doc.obj-type = new-clients.obj-type
      338             and old-wth-doc.obj-code = new-clients.obj-code
      339             and old-wth-doc.status_ = 'факт':U
      340             and old-wth-doc.fact-date >= vardate-actual-docs  no-lock
      341         use-index stat-fact
      342         on error undo, return error
      343         :
      344         create new-wth-doc.
      345         buffer-copy old-wth-doc to new-wth-doc.
      346           run copy-body in this-procedure ( input new-wth-doc.doc-code).
      347         end.
      348           for each new-wth-gds no-lock
      349           :
      350           for each old-wth-parts no-lock
      351             where old-wth-parts.obj-type = new-clients.obj-type
      352               and old-wth-parts.obj-code = new-clients.obj-code
      353               and old-wth-parts.wth-code = new-wth-gds.wth-code
      354               and old-wth-parts.gds-code = new-wth-gds.gds-code
      355               and old-wth-parts.out-code = 'put-zone':U
      356           on error undo, return error
      357           :
      358              create new-wth-parts.
      359              buffer-copy old-wth-parts to new-wth-parts.
      360           end.
      361           for each old-wth-parts no-lock
      362             where old-wth-parts.obj-type = new-clients.obj-type
      363               and old-wth-parts.obj-code = new-clients.obj-code
      364               and old-wth-parts.wth-code = new-wth-gds.wth-code
      365               and old-wth-parts.gds-code = new-wth-gds.gds-code
      366               and old-wth-parts.out-code = 'cli-zone':U
      367           on error undo, return error
      368           :
      369              create new-wth-parts.
      370              buffer-copy old-wth-parts to new-wth-parts.
      371           end.
      372           for each old-wth-parts no-lock
      373             where old-wth-parts.obj-type = new-clients.obj-type
      374               and old-wth-parts.obj-code = new-clients.obj-code
      375               and old-wth-parts.wth-code = new-wth-gds.wth-code
      376               and old-wth-parts.gds-code = new-wth-gds.gds-code
      377               and old-wth-parts.out-code = 'free-zone':U
      378           on error undo, return error
      379           :
      380              create new-wth-parts.
      381              buffer-copy old-wth-parts to new-wth-parts.
      382           end.
      383         end.
      384       end.
      385       for each temp-new-wth-line:
      386         delete temp-new-wth-line.
      387       end.
      388       for each old-wth-pobj
      389         where old-wth-pobj.host-code = new-clients.host-code
      390           and old-wth-pobj.obj-type  = new-clients.obj-type
      391           and old-wth-pobj.obj-code  = new-clients.obj-code
      392        on error undo, return error:
      393         find last old-wth-line no-lock where
      394                   old-wth-line.obj-type   = new-clients.obj-type
      395               and old-wth-line.obj-code   = new-clients.obj-code
      396               and old-wth-line.w-p-code   = old-wth-pobj.w-p-code
      397               and old-wth-line.wth-code   = old-wth-pobj.wth-code
      398               and old-wth-line.fact-date  < vardate-actual-docs
      399               and old-wth-line.status_ = 'факт':U  use-index stat-cld-pl no-error.
      400         create temp-new-wth-line.
      401         if available old-wth-line then buffer-copy old-wth-line
      402         except doc-code ext-doc-type fact-date fact-order shift-date shift-num credate creid doc-sum bef-sum aft-sum
      403         to temp-new-wth-line.
      404         buffer-copy old-wth-pobj
      405         using
      406         host-code
      407         obj-code
      408         obj-type
      409         wth-code
      410         w-p-code
      411         to temp-new-wth-line
      412         .
      413         if available old-wth-line then
      414         assign
      415         temp-new-wth-line.bef-sum = old-wth-line.income-pl - old-wth-line.incass-pl
      416         temp-new-wth-line.aft-sum = temp-new-wth-line.bef-sum
      417         .
      418         else do:
      419           assign
      420           temp-new-wth-line.bef-sum = 0
      421           temp-new-wth-line.aft-sum = 0
      422           .
      423         end.
      424       end.
      425       find first temp-new-wth-line no-error.
      426       if available temp-new-wth-line then do:
      427         main-block:
      428         do
      429         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      430         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      431         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      432         :
      433           create dst.wth-doc.
      434           assign
      435           dst.wth-doc.cli-name   = new-clients.obj-name
      436           dst.wth-doc.doc-code   = "1-" + new-clients.obj-type  + string( new-clients.obj-code)
      437           dst.wth-doc.host-code  = new-clients.host-code
      438           dst.wth-doc.obj-type   = new-clients.obj-type
      439           dst.wth-doc.obj-code   = new-clients.obj-code
      440           dst.wth-doc.cli-type   = 'орг':U
      441           dst.wth-doc.cli-code   = new-clients.host-code
      442           dst.wth-doc.doc-date   = v-temp-date
      443           dst.wth-doc.fact-date  = v-temp-date
      444           dst.wth-doc.fact-order = v-fact-order
      445           dst.wth-doc.fact-num   = 3
      446           dst.wth-doc.shift-date = ?
      447           dst.wth-doc.shift-num  = ?
      448           dst.wth-doc.operator   = 0
      449           dst.wth-doc.deliver    = 0
      450           dst.wth-doc.receiver   = 0
      451           dst.wth-doc.inv-prs4   = 0
      452           dst.wth-doc.inv-prs5   = 0
      453           dst.wth-doc.doc-type   = 'инв':U
      454           dst.wth-doc.ext-doc-type = 'iy':U
      455           dst.wth-doc.auto-fill  = no
      456           dst.wth-doc.exter_     = yes
      457           dst.wth-doc.inter_     = no
      458           dst.wth-doc.PS         = "Инвентаризация создана в процессе обрезания базы (по остаткам на МХ МЦ на объекте) "
      459           dst.wth-doc.status_    = 'факт':U
      460           dst.wth-doc.creid      = USERID("dst")
      461           dst.wth-doc.credate    = v-temp-date
      462           .
      463           for each temp-new-wth-line
      464           on error undo, return error :
      465              create new-wth-line.
      466              buffer-copy temp-new-wth-line
      467              to new-wth-line.
      468              buffer-copy  dst.wth-doc
      469              using credate creid doc-code ext-doc-type fact-date fact-order shift-date shift-num obj-type obj-code status_
      470              to  new-wth-line.
      471              assign
      472              dst.wth-doc.bef-sum = dst.wth-doc.bef-sum + temp-new-wth-line.bef-sum
      473              dst.wth-doc.aft-sum = dst.wth-doc.aft-sum + temp-new-wth-line.aft-sum
      474              .
      475           end.
      476         end.
      477       end.
      478     end.
      479     if vardate-output-zone <> ? then do:
      480       for each new-db no-lock
      481       ,each new-clients no-lock
      482         where new-clients.db-num = new-db.db-num
      483       :
      484         for each new-wth-gds no-lock
      485         :
      486           for each old-wth-parts no-lock
      487             where old-wth-parts.obj-type  = new-clients.obj-type
      488               and old-wth-parts.obj-code  = new-clients.obj-code
      489               and old-wth-parts.gds-code = new-wth-gds.gds-code
      490               and old-wth-parts.out-code = 'out-zone':U
      491           on error undo, return error
      492           :
      493             if old-wth-parts.fact-date >= vardate-output-zone  then do:
      494               create new-wth-parts.
      495               buffer-copy old-wth-parts to new-wth-parts.
      496             end.
      497           end.
      498         end.
      499       end.
      500     end.
      501   end.
      502   output stream str-gen close.
      503   return "Произведен экспорт таблиц: wealth c-wealth wealth-attr wth-ser wth-ser-attr c-wth-ser c-wth-ser-attr wth-gds c-wth-gds wth-gds-attr c-wth-gds-attr wth-par c-wth-par wth-part-attr ~
      504   wth-obj c-wth-obj wth-obj-attr wth-place c-wth-place wth-place-attr wht-pobj c-wth-pobj wth-pobj-attr ~
      505   wth-doc wth-doc-attr wth-line wth-line-attr wth-dtl wth-dtl-attr wth-parts wth-parts-attr chk-doc c-chk-doc chk-doc-attr chk-pay c-chk-pay chk-pay-attr chk-par c-chk-par chk-par-attr ".
      506   end.
      507   procedure copy-body :
      508   define input parameter p-doc-code as character no-undo .
      509   for each old-wth-line
      510     where old-wth-line.doc-code = p-doc-code no-lock
      511   on error undo, return error
      512   :
      513       create new-wth-line.
      514       buffer-copy old-wth-line to new-wth-line.
      515   end.
      516   for each old-wth-doc-attr
      517     where old-wth-doc-attr.doc-code = p-doc-code no-lock
      518   on error undo, return error
      519   :
      520       create new-wth-doc-attr.
      521       buffer-copy old-wth-doc-attr to new-wth-doc-attr.
      522   end.
      523   for each old-wth-line-attr
      524     where old-wth-line-attr.doc-code = p-doc-code no-lock
      525   on error undo, return error
      526   :
      527       create new-wth-line-attr.
      528       buffer-copy old-wth-line-attr to new-wth-line-attr.
      529   end.
      530   for each old-wth-dtl
      531     where old-wth-dtl.doc-code  = p-doc-code no-lock
      532   on error undo, return error
      533   :
      534     create new-wth-dtl.
      535     buffer-copy old-wth-dtl to new-wth-dtl.
      536   end.
      537   for each old-wth-dtl-attr
      538     where old-wth-dtl-attr.doc-code  = p-doc-code no-lock
      539   on error undo, return error
      540   :
      541     create new-wth-dtl-attr.
      542     buffer-copy old-wth-dtl-attr to new-wth-dtl-attr.
      543   end.
      544   for each old-wth-parts
      545     where old-wth-parts.out-code = p-doc-code no-lock
      546   on error undo, return error
      547   :
      548       create new-wth-parts.
      549       buffer-copy old-wth-parts to new-wth-parts.
      550   end.
      551   for each old-wth-parts-attr
      552     where old-wth-parts-attr.out-code = p-doc-code no-lock
      553   on error undo, return error
      554   :
      555       create new-wth-parts-attr.
      556       buffer-copy old-wth-parts-attr to new-wth-parts-attr.
      557   end.
      558   for each old-chk-doc  no-lock
      559     where old-chk-doc.out-code = p-doc-code
      560   on error undo, return error
      561   :
      562       create new-chk-doc.
      563       buffer-copy old-chk-doc to new-chk-doc.
      564   end.
      565   for each old-c-chk-doc
      566     where  old-c-chk-doc.out-code = p-doc-code
      567     no-lock
      568   on error undo, return error
      569   :
      570       create new-c-chk-doc.
      571       buffer-copy old-c-chk-doc to new-c-chk-doc.
      572   end.
      573   for each old-chk-doc-attr no-lock
      574     where old-chk-doc-attr.out-code = p-doc-code
      575   on error undo, return error
      576   :
      577       create new-chk-doc-attr.
      578       buffer-copy old-chk-doc-attr to new-chk-doc-attr.
      579   end.
      580   for each old-c-chk-doc-attr no-lock
      581     where old-c-chk-doc-attr.out-code = p-doc-code
      582   on error undo, return error
      583   :
      584       create new-c-chk-doc-attr.
      585       buffer-copy old-c-chk-doc-attr to new-c-chk-doc-attr.
      586   end.
      587   for each old-chk-pay
      588     where old-chk-pay.out-code = p-doc-code no-lock
      589   on error undo, return error
      590   :
      591       create new-chk-pay.
      592       buffer-copy old-chk-pay to new-chk-pay.
      593   end.
      594   for each old-c-chk-pay
      595     where old-c-chk-pay.out-code = p-doc-code no-lock
      596   on error undo, return error
      597   :
      598       create new-c-chk-pay.
      599       buffer-copy old-c-chk-pay to new-c-chk-pay.
      600   end.
      601   for each old-chk-pay-attr no-lock
      602     where old-chk-pay-attr.out-code = p-doc-code
      603   on error undo, return error
      604   :
      605       create new-chk-pay-attr.
      606       buffer-copy old-chk-pay-attr to new-chk-pay-attr.
      607   end.
      608   end procedure.
