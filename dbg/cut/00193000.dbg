       62   define buffer old-wth-line-attr  for src.wth-line-attr.
       63   define buffer new-wth-line-attr  for dst.wth-line-attr.
       64   define buffer old-wth-dtl        for src.wth-dtl.
       65   define buffer new-wth-dtl        for dst.wth-dtl.
