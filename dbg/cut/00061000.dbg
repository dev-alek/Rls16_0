        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00061000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00061000.p $":U .
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 61.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define  shared temp-table tt-objs no-undo
       13     field obj-type as character
       14     field obj-code as integer
       15     index pi is unique primary obj-type obj-code
       16     .
       17   define buffer new-db for dst.db .
       18   define buffer new-clients for dst.clients .
       19   define buffer new-goods for dst.goods .
       20   define buffer old-cash-desk  for src.cash-desk.
       21   define buffer new-cash-desk  for dst.cash-desk.
       22   define buffer old-c-cash-desk  for src.c-cash-desk.
       23   define buffer new-c-cash-desk  for dst.c-cash-desk.
       24   define buffer old-cash-desk-attr  for src.cash-desk-attr.
       25   define buffer new-cash-desk-attr  for dst.cash-desk-attr.
       26   define buffer old-c-cash-desk-attr  for src.c-cash-desk-attr.
       27   define buffer new-c-cash-desk-attr  for dst.c-cash-desk-attr.
       28   define buffer old-cash-pay   for src.cash-pay.
       29   define buffer new-cash-pay   for dst.cash-pay.
       30   define buffer old-c-cash-pay   for src.c-cash-pay.
       31   define buffer new-c-cash-pay   for dst.c-cash-pay.
       32   define buffer old-cash-pay-attr   for src.cash-pay-attr.
       33   define buffer new-cash-pay-attr   for dst.cash-pay-attr.
       34   define buffer old-c-cash-pay-attr   for src.c-cash-pay-attr.
       35   define buffer new-c-cash-pay-attr   for dst.c-cash-pay-attr.
       36   define buffer old-dis-cp-rule  for src.dis-cp-rule.
       37   define buffer new-dis-cp-rule  for dst.dis-cp-rule.
       38   define buffer old-c-dis-cp-rule  for src.c-dis-cp-rule.
       39   define buffer new-c-dis-cp-rule  for dst.c-dis-cp-rule.
       40   define buffer old-dis-cp-rule-attr  for src.dis-cp-rule-attr.
       41   define buffer new-dis-cp-rule-attr  for dst.dis-cp-rule-attr.
       42   define buffer old-cshr-month for src.cshr-month.
       43   define buffer new-cshr-month for dst.cshr-month.
       44   define buffer old-cshr-month-attr for src.cshr-month-attr.
       45   define buffer new-cshr-month-attr for dst.cshr-month-attr.
       46   define buffer old-shift-cash for src.shift-cash.
       47   define buffer new-shift-cash for dst.shift-cash.
       48   define buffer old-shift-cash-attr for src.shift-cash-attr.
       49   define buffer new-shift-cash-attr for dst.shift-cash-attr.
       50   define buffer old-cd-clu  for src.cd-clu.
       51   define buffer new-cd-clu  for dst.cd-clu.
       52   define buffer old-c-cd-clu  for src.c-cd-clu.
       53   define buffer new-c-cd-clu  for dst.c-cd-clu.
       54   define buffer old-cd-clu-attr  for src.cd-clu-attr.
       55   define buffer new-cd-clu-attr  for dst.cd-clu-attr.
       56   define buffer old-cd-dlu  for src.cd-dlu.
       57   define buffer new-cd-dlu  for dst.cd-dlu.
       58   define buffer old-c-cd-dlu  for src.c-cd-dlu.
       59   define buffer new-c-cd-dlu  for dst.c-cd-dlu.
       60   define buffer old-cd-dlu-attr  for src.cd-dlu-attr.
       61   define buffer new-cd-dlu-attr  for dst.cd-dlu-attr.
       62   define buffer old-cd-grp  for src.cd-grp.
       63   define buffer new-cd-grp  for dst.cd-grp.
       64   define buffer old-c-cd-grp  for src.c-cd-grp.
       65   define buffer new-c-cd-grp  for dst.c-cd-grp.
       66   define buffer old-cd-grp-attr  for src.cd-grp-attr.
       67   define buffer new-cd-grp-attr  for dst.cd-grp-attr.
       68   define buffer old-cd-doc  for src.cd-doc.
       69   define buffer new-cd-doc  for dst.cd-doc.
       70   define buffer old-c-cd-doc  for src.c-cd-doc.
       71   define buffer new-c-cd-doc  for dst.c-cd-doc.
       72   define buffer old-cd-doc-attr  for src.cd-doc-attr.
       73   define buffer new-cd-doc-attr  for dst.cd-doc-attr.
       74   define buffer old-cd-doc-line  for src.cd-doc-line.
       75   define buffer new-cd-doc-line  for dst.cd-doc-line.
       76   define buffer old-c-cd-doc-line  for src.c-cd-doc-line.
       77   define buffer new-c-cd-doc-line  for dst.c-cd-doc-line.
       78   define buffer old-cd-doc-line-attr  for src.cd-doc-line-attr.
       79   define buffer new-cd-doc-line-attr  for dst.cd-doc-line-attr.
       80   define buffer old-cd-plu  for src.cd-plu.
       81   define buffer new-cd-plu  for dst.cd-plu.
       82   define buffer old-c-cd-plu  for src.c-cd-plu.
       83   define buffer new-c-cd-plu  for dst.c-cd-plu.
       84   define buffer old-cd-plu-attr  for src.cd-plu-attr.
       85   define buffer new-cd-plu-attr  for dst.cd-plu-attr.
       86   define buffer old-cd-events  for src.cd-events.
       87   define buffer new-cd-events  for dst.cd-events.
       88   define buffer old-cd-events-attr  for src.cd-events-attr.
       89   define buffer new-cd-events-attr  for dst.cd-events-attr.
       90   define buffer old-cd-event-log  for src.cd-event-log.
       91   define buffer new-cd-event-log  for dst.cd-event-log.
       92   define buffer old-cd-event-log-attr  for src.cd-event-log-attr.
       93   define buffer new-cd-event-log-attr  for dst.cd-event-log-attr.
       94   define buffer old-cd-video-link  for src.cd-video-link.
       95   define buffer new-cd-video-link  for dst.cd-video-link.
       96   define buffer old-cd-video-link-attr  for src.cd-video-link-attr.
       97   define buffer new-cd-video-link-attr  for dst.cd-video-link-attr.
       98   do
       99   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      100   define input parameter vartype-cut            as integer   no-undo.
      101   define input parameter varlist-db             as character no-undo.
      102   define input parameter vardate-actual-goods   as date      no-undo.
      103   define input parameter vardate-actual-docs    as date      no-undo.
      104   define input parameter vardate-actual-findoc  as date      no-undo.
      105   define input parameter vardate-output-zone    as date      no-undo.
      106   define input parameter varstay-recipe-goods   as logical   no-undo.
      107   define input parameter varstay-weight-goods   as logical   no-undo.
      108   define input parameter varnot-copy-del-goods  as logical   no-undo.
      109   define input parameter varstay-history        as logical   no-undo.
      110   define input parameter vargen-file            as character no-undo.
      111   define stream str-gen.
      112   output stream str-gen to vargen-file append.
      113   if not connected("src") then do:
      114      return error "Нет коннекта с базой 'src'.".
      115   end.
      116   if not connected("dst") then do:
      117      return error "Нет коннекта с базой 'dst'.".
      118   end.
      119   find src.sys-ctrl no-lock.
      120   if not available src.sys-ctrl then do:
      121      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      122   end.
      123   if src.sys-ctrl.db-num <> 0 then do:
      124      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      125   end.
      126   if vardate-actual-docs <> ? and
      127      (vardate-actual-goods   > vardate-actual-docs or
      128       vardate-actual-goods   = ? )   then do:
      129         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      130                                 "Дата актуальности товаров &1."        +
      131                                 "Дата актуальности документов &2."     +
      132                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      133                                 vardate-actual-goods,
      134                                 vardate-actual-docs).
      135   end.
      136   on WRITE of dst.cash-desk         override do: end.
      137   on WRITE of dst.c-cash-desk       override do: end.
      138   on WRITE of dst.cash-desk-attr    override do: end.
      139   on WRITE of dst.c-cash-desk-attr  override do: end.
      140   on WRITE of dst.cash-pay          override do: end.
      141   on WRITE of dst.c-cash-pay        override do: end.
      142   on WRITE of dst.cash-pay-attr     override do: end.
      143   on WRITE of dst.c-cash-pay-attr   override do: end.
      144   on WRITE of dst.dis-cp-rule       override do: end.
      145   on WRITE of dst.c-dis-cp-rule     override do: end.
      146   on WRITE of dst.dis-cp-rule-attr  override do: end.
      147   on WRITE of dst.cshr-month        override do: end.
      148   on WRITE of dst.cshr-month-attr   override do: end.
      149   on WRITE of dst.shift-cash        override do: end.
      150   on WRITE of dst.shift-cash-attr   override do: end.
      151   on WRITE of dst.cd-clu            override do: end.
      152   on WRITE of dst.c-cd-clu          override do: end.
      153   on WRITE of dst.cd-clu-attr       override do: end.
      154   on WRITE of dst.cd-dlu            override do: end.
      155   on WRITE of dst.c-cd-dlu          override do: end.
      156   on WRITE of dst.cd-dlu-attr       override do: end.
      157   on WRITE of dst.cd-grp            override do: end.
      158   on WRITE of dst.c-cd-grp          override do: end.
      159   on WRITE of dst.cd-grp-attr       override do: end.
      160   on WRITE of dst.cd-doc            override do: end.
      161   on WRITE of dst.c-cd-doc          override do: end.
      162   on WRITE of dst.cd-doc-attr       override do: end.
      163   on WRITE of dst.cd-doc-line       override do: end.
      164   on WRITE of dst.c-cd-doc-line     override do: end.
      165   on WRITE of dst.cd-doc-line-attr  override do: end.
      166   on WRITE of dst.cd-plu            override do: end.
      167   on WRITE of dst.c-cd-plu          override do: end.
      168   on WRITE of dst.cd-plu-attr       override do: end.
      169   on WRITE of dst.cd-events         override do: end.
      170   on WRITE of dst.cd-events-attr    override do: end.
      171   on WRITE of dst.cd-event-log         override do: end.
      172   on WRITE of dst.cd-event-log-attr    override do: end.
      173   on WRITE of dst.cd-video-link        override do: end.
      174   on WRITE of dst.cd-video-link-attr   override do: end.
      175   for each old-cash-desk  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      176      create new-cash-desk.
      177      buffer-copy old-cash-desk to new-cash-desk.
      178   end.
      179   for each old-cash-desk-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      180      create new-cash-desk-attr.
      181      buffer-copy old-cash-desk-attr to new-cash-desk-attr.
      182   end.
      183   if varstay-history then do:
      184     for each old-c-cash-desk no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      185       if old-c-cash-desk.subject = 'cd-plu':U
      186       or old-c-cash-desk.subject = 'cd-plu-attr':U then next.
      187       create new-c-cash-desk.
      188       buffer-copy old-c-cash-desk to new-c-cash-desk.
      189     end.
      190   for each old-c-cash-desk-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      191      create new-c-cash-desk-attr.
      192      buffer-copy old-c-cash-desk-attr to new-c-cash-desk-attr.
      193   end.
      194   end.
      195   for each old-cash-pay  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      196      create new-cash-pay.
      197      buffer-copy old-cash-pay to new-cash-pay.
      198   end.
      199   if varstay-history then do:
      200   for each old-c-cash-pay  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      201      create new-c-cash-pay.
      202      buffer-copy old-c-cash-pay to new-c-cash-pay.
      203   end.
      204   end.
      205   for each old-cash-pay-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      206      create new-cash-pay-attr.
      207      buffer-copy old-cash-pay-attr to new-cash-pay-attr.
      208   end.
      209   if varstay-history then do:
      210   for each old-c-cash-pay-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      211      create new-c-cash-pay-attr.
      212      buffer-copy old-c-cash-pay-attr to new-c-cash-pay-attr.
      213   end.
      214   end.
      215   for each old-cshr-month  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      216      create new-cshr-month.
      217      buffer-copy old-cshr-month to new-cshr-month.
      218   end.
      219   for each old-cshr-month-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      220      create new-cshr-month-attr.
      221      buffer-copy old-cshr-month-attr to new-cshr-month-attr.
      222   end.
      223   for each old-shift-cash  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      224      create new-shift-cash.
      225      buffer-copy old-shift-cash to new-shift-cash.
      226   end.
      227   for each old-shift-cash-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      228      create new-shift-cash-attr.
      229      buffer-copy old-shift-cash-attr to new-shift-cash-attr.
      230   end.
      231   for each old-cd-clu  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      232      create new-cd-clu.
      233      buffer-copy old-cd-clu to new-cd-clu.
      234   end.
      235   if varstay-history then do:
      236   for each old-c-cd-clu  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      237      create new-c-cd-clu.
      238      buffer-copy old-c-cd-clu to new-c-cd-clu.
      239   end.
      240   end.
      241   for each old-cd-clu-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      242      create new-cd-clu-attr.
      243      buffer-copy old-cd-clu-attr to new-cd-clu-attr.
      244   end.
      245   for each old-cd-dlu  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      246      create new-cd-dlu.
      247      buffer-copy old-cd-dlu to new-cd-dlu.
      248   end.
      249   if varstay-history then do:
      250   for each old-c-cd-dlu  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      251      create new-c-cd-dlu.
      252      buffer-copy old-c-cd-dlu to new-c-cd-dlu.
      253   end.
      254   end.
      255   for each old-cd-dlu-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      256      create new-cd-dlu-attr.
      257      buffer-copy old-cd-dlu-attr to new-cd-dlu-attr.
      258   end.
      259   for each old-cd-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      260      create new-cd-grp.
      261      buffer-copy old-cd-grp to new-cd-grp.
      262   end.
      263   if varstay-history then do:
      264   for each old-c-cd-grp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      265      create new-c-cd-grp.
      266      buffer-copy old-c-cd-grp to new-c-cd-grp.
      267   end.
      268   end.
      269   for each old-cd-grp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      270      create new-cd-grp-attr.
      271      buffer-copy old-cd-grp-attr to new-cd-grp-attr.
      272   end.
      273   for each old-dis-cp-rule  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      274      create new-dis-cp-rule.
      275      buffer-copy old-dis-cp-rule to new-dis-cp-rule.
      276   end.
      277   if varstay-history then do:
      278   for each old-c-dis-cp-rule  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      279      create new-c-dis-cp-rule.
      280      buffer-copy old-c-dis-cp-rule to new-c-dis-cp-rule.
      281   end.
      282   end.
      283   for each old-dis-cp-rule-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      284      create new-dis-cp-rule-attr.
      285      buffer-copy old-dis-cp-rule-attr to new-dis-cp-rule-attr.
      286   end.
      287   for each old-cd-plu no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      288     find first new-goods where new-goods.gds-code  = old-cd-plu.gds-code no-lock no-error.
      289     if available new-goods then do:
      290       create new-cd-plu.
      291       buffer-copy old-cd-plu to new-cd-plu.
      292       if varstay-history then do:
      293         for each old-c-cd-plu no-lock where
      294                 old-c-cd-plu.gds-code = new-cd-plu.gds-code
      295         on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      296           create new-c-cd-plu.
      297           buffer-copy old-c-cd-plu to new-c-cd-plu.
      298           find first old-c-cash-desk no-lock where
      299                     (old-c-cash-desk.subject = 'cd-plu':U
      300                     and old-c-cash-desk.corr-user-db-num = old-c-cd-plu.corr-user-db-num
      301                     and old-c-cash-desk.chip-num = old-c-cd-plu.chip-num
      302                     )
      303                     or  (old-c-cash-desk.subject = 'cd-plu-attr':U
      304                     and old-c-cash-desk.corr-user-db-num = old-c-cd-plu.corr-user-db-num
      305                     and old-c-cash-desk.chip-num = old-c-cd-plu.chip-num
      306                     ) no-error.
      307           if available old-c-cash-desk then do:
      308             create new-c-cash-desk.
      309             buffer-copy old-c-cash-desk to new-c-cash-desk.
      310           end.
      311         end.
      312       end.
      313       for each old-cd-plu-attr no-lock where
      314               old-cd-plu-attr.obj-type = new-cd-plu.obj-type
      315           and old-cd-plu-attr.obj-code = new-cd-plu.obj-code
      316           and old-cd-plu-attr.pos-type = new-cd-plu.pos-type
      317           and old-cd-plu-attr.plu-type = new-cd-plu.plu-type
      318           and old-cd-plu-attr.plu-code = new-cd-plu.plu-code
      319       on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      320         create new-cd-plu-attr.
      321         buffer-copy old-cd-plu-attr to new-cd-plu-attr.
      322       end.
      323     end.
      324   end.
      325   for each new-db no-lock
      326   ,each new-clients no-lock
      327     where new-clients.db-num = new-db.db-num
      328   :
      329     if vardate-actual-docs <> ? then do:
      330       if vartype-cut = 1 then do:
      331         find first tt-objs where tt-objs.obj-type = new-clients.obj-type and
      332                                   tt-objs.obj-code = new-clients.obj-code no-error.
      333       end.
      334       if vartype-cut = 0      or
      335           (vartype-cut = 1 and available tt-objs) then do:
      336         for each old-cd-doc where old-cd-doc.obj-type   = new-clients.obj-type  and
      337                                     old-cd-doc.obj-code   = new-clients.obj-code and
      338                                     old-cd-doc.datekey_one >= vardate-actual-docs  no-lock
      339         on error undo, return error
      340         :
      341           run copy-cd-doc-body in this-procedure.
      342         end.
      343         for each old-cd-event-log where old-cd-event-log.obj-type   = new-clients.obj-type  and
      344                                     old-cd-event-log.obj-code   = new-clients.obj-code and
      345                                     old-cd-event-log.event-date >= vardate-actual-docs  no-lock
      346         on error undo, return error
      347         :
      348           create new-cd-event-log.
      349           buffer-copy old-cd-event-log to new-cd-event-log.
      350         end.
      351       end.
      352       else do:
      353         for each old-cd-doc where old-cd-doc.obj-type   = new-clients.obj-type  and
      354                                     old-cd-doc.obj-code   = new-clients.obj-code
      355         on error undo, return error
      356         :
      357           run copy-cd-doc-body in this-procedure.
      358         end.
      359         for each old-cd-event-log where old-cd-event-log.obj-type   = new-clients.obj-type  and
      360                                     old-cd-event-log.obj-code   = new-clients.obj-code
      361         on error undo, return error
      362         :
      363           create new-cd-event-log.
      364           buffer-copy old-cd-event-log to new-cd-event-log.
      365         end.
      366       end.
      367     end.
      368   end.
      369   for each old-cd-events  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      370      create new-cd-events.
      371      buffer-copy old-cd-events to new-cd-events.
      372   end.
      373   for each old-cd-events-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      374      create new-cd-events-attr.
      375      buffer-copy old-cd-events-attr to new-cd-events-attr.
      376   end.
      377   for each old-cd-event-log-attr  , first new-cd-event-log where                                          new-cd-event-log.db-num = old-cd-event-log-attr.db-num                                      and new-cd-event-log.trans-id = old-cd-event-log-attr.trans-id  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      378      create new-cd-event-log-attr.
      379      buffer-copy old-cd-event-log-attr to new-cd-event-log-attr.
      380   end.
      381   for each old-cd-video-link  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      382      create new-cd-video-link.
      383      buffer-copy old-cd-video-link to new-cd-video-link.
      384   end.
      385   for each old-cd-video-link-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      386      create new-cd-video-link-attr.
      387      buffer-copy old-cd-video-link-attr to new-cd-video-link-attr.
      388   end.
      389   output stream str-gen close.
      390   return "Произведен экспорт таблиц: cash-desk cash-desk-attr c-cash-desk c-cash-desk-attr cash-pay c-cash-pay cash-pay-attr c-cash-pay-attr dis-cp-rule dis-cp-rule-attr c-dis-cp-rule ~
      391   cshr-month csht-month-attr shift-cash shift-cash-attr ~
      392   cd-clu c-cd-clu cd-clu-attr cd-dlu c-cd-dlu cd-dlu-attr cd-grp c-cd-grp cd-grp-attr cd-plu cd-plu-attr c-cd-plu ~
      393   cd-doc c-cd-doc cd-doc-attr cd-doc-line cd-doc-line-attr c-cd-doc-line ~
      394   cd-events cd-events-attr cd-event-log cd-event-log-attr cd-video-link cd-video-link-attr ~
      395   .".
      396   end.
      397   procedure copy-cd-doc-body :
      398   create new-cd-doc.
      399   buffer-copy old-cd-doc to new-cd-doc.
      400   for each old-cd-doc-attr no-lock  where
      401           old-cd-doc-attr.obj-type = new-cd-doc.obj-type
      402       and old-cd-doc-attr.obj-code = new-cd-doc.obj-code
      403       and old-cd-doc-attr.pos-type = new-cd-doc.pos-type
      404       and old-cd-doc-attr.doc-type = new-cd-doc.doc-type
      405       and old-cd-doc-attr.doc-code = new-cd-doc.doc-code
      406   on error undo, return error
      407   :
      408       create new-cd-doc-attr.
      409       buffer-copy old-cd-doc-attr to new-cd-doc-attr.
      410   end.
      411   for each old-cd-doc-line no-lock  where
      412           old-cd-doc-line.obj-type = new-cd-doc.obj-type
      413       and old-cd-doc-line.obj-code = new-cd-doc.obj-code
      414       and old-cd-doc-line.pos-type = new-cd-doc.pos-type
      415       and old-cd-doc-line.doc-type = new-cd-doc.doc-type
      416       and old-cd-doc-line.doc-code = new-cd-doc.doc-code
      417   on error undo, return error
      418   :
      419       create new-cd-doc-line.
      420       buffer-copy old-cd-doc-line to new-cd-doc-line.
      421   end.
      422   for each old-cd-doc-line-attr no-lock  where
      423           old-cd-doc-line-attr.obj-type = new-cd-doc.obj-type
      424       and old-cd-doc-line-attr.obj-code = new-cd-doc.obj-code
      425       and old-cd-doc-line-attr.pos-type = new-cd-doc.pos-type
      426       and old-cd-doc-line-attr.doc-type = new-cd-doc.doc-type
      427       and old-cd-doc-line-attr.doc-code = new-cd-doc.doc-code
      428   on error undo, return error
      429   :
      430       create new-cd-doc-line-attr.
      431       buffer-copy old-cd-doc-line-attr to new-cd-doc-line-attr.
      432   end.
      433   for each old-c-cd-doc no-lock  where
      434           old-c-cd-doc.obj-type = new-cd-doc.obj-type
      435       and old-c-cd-doc.obj-code = new-cd-doc.obj-code
      436       and old-c-cd-doc.pos-type = new-cd-doc.pos-type
      437       and old-c-cd-doc.doc-type = new-cd-doc.doc-type
      438       and old-c-cd-doc.doc-code = new-cd-doc.doc-code
      439   on error undo, return error
      440   :
      441       create new-c-cd-doc.
      442       buffer-copy old-c-cd-doc to new-c-cd-doc.
      443   end.
      444   for each old-c-cd-doc-line no-lock  where
      445           old-c-cd-doc-line.obj-type = new-cd-doc.obj-type
      446       and old-c-cd-doc-line.obj-code = new-cd-doc.obj-code
      447       and old-c-cd-doc-line.pos-type = new-cd-doc.pos-type
      448       and old-c-cd-doc-line.doc-type = new-cd-doc.doc-type
      449       and old-c-cd-doc-line.doc-code = new-cd-doc.doc-code
      450   on error undo, return error
      451   :
      452       create new-c-cd-doc-line.
      453       buffer-copy old-c-cd-doc-line to new-c-cd-doc-line.
      454   end.
      455   end procedure.
