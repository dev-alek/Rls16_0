        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00216000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00216000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 8.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-assortment-matrix             for src.assortment-matrix.
       13   define buffer new-assortment-matrix             for dst.assortment-matrix.
       14   define buffer old-c-assortment-matrix           for src.c-assortment-matrix.
       15   define buffer new-c-assortment-matrix           for dst.c-assortment-matrix.
       16   define buffer old-assortment-matrix-goods       for src.assortment-matrix-goods.
       17   define buffer new-assortment-matrix-goods       for dst.assortment-matrix-goods.
       18   define buffer old-c-assortment-matrix-goods     for src.c-assortment-matrix-goods.
       19   define buffer new-c-assortment-matrix-goods     for dst.c-assortment-matrix-goods.
       20   define buffer old-assortment-matrix-attr        for src.assortment-matrix-attr.
       21   define buffer new-assortment-matrix-attr        for dst.assortment-matrix-attr.
       22   define buffer old-assortment-matrix-goods-attr  for src.assortment-matrix-goods-attr.
       23   define buffer new-assortment-matrix-goods-attr  for dst.assortment-matrix-goods-attr.
       24   define buffer new-gds-obj-prop                  for dst.gds-obj-prop.
       25   define buffer new-gds-obj-prop-attr             for dst.gds-obj-prop-attr.
       26   define buffer new-c-gds-obj-prop                for dst.c-gds-obj-prop.
       27   define buffer old-gds-obj-prop                  for src.gds-obj-prop.
       28   define buffer old-gds-obj-prop-attr             for src.gds-obj-prop-attr.
       29   define buffer old-c-gds-obj-prop                for src.c-gds-obj-prop.
       30   define buffer new-goods           for dst.goods.
       31   do
       32   on error undo, return error
       33   :
       34   define input parameter vartype-cut            as integer   no-undo.
       35   define input parameter varlist-db             as character no-undo.
       36   define input parameter vardate-actual-goods   as date      no-undo.
       37   define input parameter vardate-actual-docs    as date      no-undo.
       38   define input parameter vardate-actual-findoc  as date      no-undo.
       39   define input parameter vardate-output-zone    as date      no-undo.
       40   define input parameter varstay-recipe-goods   as logical   no-undo.
       41   define input parameter varstay-weight-goods   as logical   no-undo.
       42   define input parameter varnot-copy-del-goods  as logical   no-undo.
       43   define input parameter varstay-history        as logical   no-undo.
       44   define input parameter vargen-file            as character no-undo.
       45   define stream str-gen.
       46   output stream str-gen to vargen-file append.
       47   if not connected("src") then do:
       48      return error "Нет коннекта с базой 'src'.".
       49   end.
       50   if not connected("dst") then do:
       51      return error "Нет коннекта с базой 'dst'.".
       52   end.
       53   find src.sys-ctrl no-lock.
       54   if not available src.sys-ctrl then do:
       55      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       56   end.
       57   if src.sys-ctrl.db-num <> 0 then do:
       58      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       59   end.
       60   if vardate-actual-docs <> ? and
       61      (vardate-actual-goods   > vardate-actual-docs or
       62       vardate-actual-goods   = ? )   then do:
       63         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       64                                 "Дата актуальности товаров &1."        +
       65                                 "Дата актуальности документов &2."     +
       66                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       67                                 vardate-actual-goods,
       68                                 vardate-actual-docs).
       69   end.
       70     on WRITE of dst.assortment-matrix            override do: end.
       71     on WRITE of dst.assortment-matrix-attr       override do: end.
       72     on WRITE of dst.assortment-matrix-goods      override do: end.
       73     on WRITE of dst.assortment-matrix-goods-attr override do: end.
       74     on WRITE of dst.c-assortment-matrix          override do: end.
       75     on WRITE of dst.c-assortment-matrix-goods    override do: end.
       76     on WRITE of dst.gds-obj-prop                 override do: end.
       77     on WRITE of dst.gds-obj-prop-attr            override do: end.
       78     on WRITE of dst.c-gds-obj-prop               override do: end.
       79   for each old-assortment-matrix  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       80      create new-assortment-matrix.
       81      buffer-copy old-assortment-matrix to new-assortment-matrix.
       82   end.
       83   for each old-assortment-matrix-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       84      create new-assortment-matrix-attr.
       85      buffer-copy old-assortment-matrix-attr to new-assortment-matrix-attr.
       86   end.
       87   for each old-assortment-matrix-goods  no-lock , first new-goods where new-goods.gds-code = old-assortment-matrix-goods.gds-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       88      create new-assortment-matrix-goods.
       89      buffer-copy old-assortment-matrix-goods to new-assortment-matrix-goods.
       90   end.
       91   for each old-assortment-matrix-goods-attr  no-lock , first new-goods where new-goods.gds-code = old-assortment-matrix-goods-attr.gds-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       92      create new-assortment-matrix-goods-attr.
       93      buffer-copy old-assortment-matrix-goods-attr to new-assortment-matrix-goods-attr.
       94   end.
       95   for each old-gds-obj-prop  no-lock , first new-goods where new-goods.gds-code = old-gds-obj-prop.gds-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
       96      create new-gds-obj-prop.
       97      buffer-copy old-gds-obj-prop to new-gds-obj-prop.
       98   end.
       99   for each old-gds-obj-prop-attr  no-lock , first new-goods where new-goods.gds-code = old-gds-obj-prop-attr.gds-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      100      create new-gds-obj-prop-attr.
      101      buffer-copy old-gds-obj-prop-attr to new-gds-obj-prop-attr.
      102   end.
      103     if varstay-history = true then do:
      104   for each old-c-assortment-matrix  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      105      create new-c-assortment-matrix.
      106      buffer-copy old-c-assortment-matrix to new-c-assortment-matrix.
      107   end.
      108   for each old-c-assortment-matrix-goods  no-lock , first new-goods where new-goods.gds-code = old-c-assortment-matrix-goods.gds-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      109      create new-c-assortment-matrix-goods.
      110      buffer-copy old-c-assortment-matrix-goods to new-c-assortment-matrix-goods.
      111   end.
      112   for each old-c-gds-obj-prop  no-lock , first new-goods where new-goods.gds-code = old-c-gds-obj-prop.gds-code  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      113      create new-c-gds-obj-prop.
      114      buffer-copy old-c-gds-obj-prop to new-c-gds-obj-prop.
      115   end.
      116     end.
      117   output stream str-gen close.
      118     return "Произведен экспорт таблиц: assortment-matrix assortment-matrix-goods c-assortment-matrix c-assortment-matrix-goods assortment-matrix-attr assortment-matrix-goods-attr
      119             gds-obj-prop gds-obj-prop-attr c-gds-obj-prop . " .
      120   end.
