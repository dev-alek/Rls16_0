      107   do
      108   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      109   define input parameter vartype-cut            as integer   no-undo.
      110   define input parameter varlist-db             as character no-undo.
      111   define input parameter vardate-actual-goods   as date      no-undo.
      112   define input parameter vardate-actual-docs    as date      no-undo.
      113   define input parameter vardate-actual-findoc  as date      no-undo.
      114   define input parameter vardate-output-zone    as date      no-undo.
      115   define input parameter varstay-recipe-goods   as logical   no-undo.
      116   define input parameter varstay-weight-goods   as logical   no-undo.
      117   define input parameter varnot-copy-del-goods  as logical   no-undo.
      118   define input parameter varstay-history        as logical   no-undo.
      119   define input parameter vargen-file            as character no-undo.
      120   define stream str-gen.
      121   output stream str-gen to vargen-file append.
      122   if not connected("src") then do:
      123      return error "Нет коннекта с базой 'src'.".
      124   end.
      125   if not connected("dst") then do:
      126      return error "Нет коннекта с базой 'dst'.".
      127   end.
      128   find src.sys-ctrl no-lock.
      129   if not available src.sys-ctrl then do:
      130      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      131   end.
      132   if src.sys-ctrl.db-num <> 0 then do:
      133      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      134   end.
      135   if vardate-actual-docs <> ? and
      136      (vardate-actual-goods   > vardate-actual-docs or
      137       vardate-actual-goods   = ? )   then do:
      138         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      139                                 "Дата актуальности товаров &1."        +
      140                                 "Дата актуальности документов &2."     +
      141                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      142                                 vardate-actual-goods,
      143                                 vardate-actual-docs).
      144   end.
      145     on WRITE of dst.place          override do: end.
