      140   do
      141   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
      142   define input parameter vartype-cut            as integer   no-undo.
      143   define input parameter varlist-db             as character no-undo.
      144   define input parameter vardate-actual-goods   as date      no-undo.
      145   define input parameter vardate-actual-docs    as date      no-undo.
      146   define input parameter vardate-actual-findoc  as date      no-undo.
      147   define input parameter vardate-output-zone    as date      no-undo.
      148   define input parameter varstay-recipe-goods   as logical   no-undo.
      149   define input parameter varstay-weight-goods   as logical   no-undo.
      150   define input parameter varnot-copy-del-goods  as logical   no-undo.
      151   define input parameter varstay-history        as logical   no-undo.
      152   define input parameter vargen-file            as character no-undo.
      153   define stream str-gen.
      154   output stream str-gen to vargen-file append.
      155   if not connected("src") then do:
      156      return error "Нет коннекта с базой 'src'.".
      157   end.
      158   if not connected("dst") then do:
      159      return error "Нет коннекта с базой 'dst'.".
      160   end.
      161   find src.sys-ctrl no-lock.
      162   if not available src.sys-ctrl then do:
      163      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
      164   end.
      165   if src.sys-ctrl.db-num <> 0 then do:
      166      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
      167   end.
      168   if vardate-actual-docs <> ? and
      169      (vardate-actual-goods   > vardate-actual-docs or
      170       vardate-actual-goods   = ? )   then do:
      171         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
      172                                 "Дата актуальности товаров &1."        +
      173                                 "Дата актуальности документов &2."     +
      174                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
      175                                 vardate-actual-goods,
      176                                 vardate-actual-docs).
      177   end.
