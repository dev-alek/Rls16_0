        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00111000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cut/00111000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога обрезания. Относится к категории 111.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define buffer old-ext-system for src.ext-system.
       13   define buffer new-ext-system for dst.ext-system.
       14   define buffer old-c-ext-system for src.c-ext-system.
       15   define buffer new-c-ext-system for dst.c-ext-system.
       16   define buffer old-ext-system-attr for src.ext-system-attr.
       17   define buffer new-ext-system-attr for dst.ext-system-attr.
       18   define buffer old-esys-all-attr for src.esys-all-attr.
       19   define buffer new-esys-all-attr for dst.esys-all-attr.
       20   define buffer old-esys-pck-keys for src.esys-pck-keys.
       21   define buffer new-esys-pck-keys for dst.esys-pck-keys.
       22   define buffer old-esys-pck-rcvd for src.esys-pck-rcvd.
       23   define buffer new-esys-pck-rcvd for dst.esys-pck-rcvd.
       24   define buffer old-esys-pck-sent for src.esys-pck-sent.
       25   define buffer new-esys-pck-sent for dst.esys-pck-sent.
       26   define buffer old-esys-route for src.esys-route.
       27   define buffer new-esys-route for dst.esys-route.
       28   define buffer old-esys-route-dump for src.esys-route-dump.
       29   define buffer new-esys-route-dump for dst.esys-route-dump.
       30   define buffer old-c-esys-datatype-exp      for src.c-esys-datatype-exp     .
       31   define buffer old-c-esys-datatype-imp      for src.c-esys-datatype-imp     .
       32   define buffer old-datatype-exp             for src.datatype-exp            .
       33   define buffer old-datatype-exp-attr        for src.datatype-exp-attr       .
       34   define buffer old-datatype-imp             for src.datatype-imp            .
       35   define buffer old-datatype-imp-attr        for src.datatype-imp-attr       .
       36   define buffer old-datatype-table           for src.datatype-table          .
       37   define buffer old-datatype-table-exp       for src.datatype-table-exp      .
       38   define buffer old-datatype-table-field     for src.datatype-table-field    .
       39   define buffer old-datatype-table-field-exp for src.datatype-table-field-exp.
       40   define buffer old-datatype-table-field-imp for src.datatype-table-field-imp.
       41   define buffer old-datatype-table-imp       for src.datatype-table-imp      .
       42   define buffer old-esys-datatype-exp        for src.esys-datatype-exp       .
       43   define buffer old-esys-datatype-imp        for src.esys-datatype-imp       .
       44   define buffer new-c-esys-datatype-exp      for dst.c-esys-datatype-exp     .
       45   define buffer new-c-esys-datatype-imp      for dst.c-esys-datatype-imp     .
       46   define buffer new-datatype-exp             for dst.datatype-exp            .
       47   define buffer new-datatype-exp-attr        for dst.datatype-exp-attr       .
       48   define buffer new-datatype-imp             for dst.datatype-imp            .
       49   define buffer new-datatype-imp-attr        for dst.datatype-imp-attr       .
       50   define buffer new-datatype-table           for dst.datatype-table          .
       51   define buffer new-datatype-table-exp       for dst.datatype-table-exp      .
       52   define buffer new-datatype-table-field     for dst.datatype-table-field    .
       53   define buffer new-datatype-table-field-exp for dst.datatype-table-field-exp.
       54   define buffer new-datatype-table-field-imp for dst.datatype-table-field-imp.
       55   define buffer new-datatype-table-imp       for dst.datatype-table-imp      .
       56   define buffer new-esys-datatype-exp        for dst.esys-datatype-exp       .
       57   define buffer new-esys-datatype-imp        for dst.esys-datatype-imp       .
       58   do
       59   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
       60   define input parameter vartype-cut            as integer   no-undo.
       61   define input parameter varlist-db             as character no-undo.
       62   define input parameter vardate-actual-goods   as date      no-undo.
       63   define input parameter vardate-actual-docs    as date      no-undo.
       64   define input parameter vardate-actual-findoc  as date      no-undo.
       65   define input parameter vardate-output-zone    as date      no-undo.
       66   define input parameter varstay-recipe-goods   as logical   no-undo.
       67   define input parameter varstay-weight-goods   as logical   no-undo.
       68   define input parameter varnot-copy-del-goods  as logical   no-undo.
       69   define input parameter varstay-history        as logical   no-undo.
       70   define input parameter vargen-file            as character no-undo.
       71   define stream str-gen.
       72   output stream str-gen to vargen-file append.
       73   if not connected("src") then do:
       74      return error "Нет коннекта с базой 'src'.".
       75   end.
       76   if not connected("dst") then do:
       77      return error "Нет коннекта с базой 'dst'.".
       78   end.
       79   find src.sys-ctrl no-lock.
       80   if not available src.sys-ctrl then do:
       81      return error "В базе данных src не найдена уникальная запись sys-ctrl.".
       82   end.
       83   if src.sys-ctrl.db-num <> 0 then do:
       84      return error "Пакет обрезания работает только в главной базе данных. В данной версии удаленные БД создаются выгрузкой из главных.".
       85   end.
       86   if vardate-actual-docs <> ? and
       87      (vardate-actual-goods   > vardate-actual-docs or
       88       vardate-actual-goods   = ? )   then do:
       89         return error SUBSTITUTE("Ошибка при задании дат актуальности." +
       90                                 "Дата актуальности товаров &1."        +
       91                                 "Дата актуальности документов &2."     +
       92                                 "Дата актуальности документов должна быть больше или равна дат актуальностей товаров.",
       93                                 vardate-actual-goods,
       94                                 vardate-actual-docs).
       95   end.
       96   on WRITE of dst.ext-system override do: end.
       97   on WRITE of dst.c-ext-system override do: end.
       98   on WRITE of dst.ext-system-attr override do: end.
       99   on WRITE of dst.esys-all-attr override do: end.
      100   on WRITE of dst.esys-pck-keys override do: end.
      101   on WRITE of dst.esys-pck-rcvd override do: end.
      102   on WRITE of dst.esys-pck-sent override do: end.
      103   on WRITE of dst.esys-route override do: end.
      104   on WRITE of dst.esys-route-dump override do: end.
      105   on WRITE of dst.c-esys-datatype-exp      override do: end.
      106   on WRITE of dst.c-esys-datatype-imp      override do: end.
      107   on WRITE of dst.datatype-exp             override do: end.
      108   on WRITE of dst.datatype-exp-attr        override do: end.
      109   on WRITE of dst.datatype-imp             override do: end.
      110   on WRITE of dst.datatype-imp-attr        override do: end.
      111   on WRITE of dst.datatype-table           override do: end.
      112   on WRITE of dst.datatype-table-exp       override do: end.
      113   on WRITE of dst.datatype-table-field     override do: end.
      114   on WRITE of dst.datatype-table-field-exp override do: end.
      115   on WRITE of dst.datatype-table-field-imp override do: end.
      116   on WRITE of dst.datatype-table-imp       override do: end.
      117   on WRITE of dst.esys-datatype-exp        override do: end.
      118   on WRITE of dst.esys-datatype-imp        override do: end.
      119   for each old-ext-system  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      120      create new-ext-system.
      121      buffer-copy old-ext-system to new-ext-system.
      122   end.
      123   if varstay-history then do:
      124   for each old-c-ext-system  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      125      create new-c-ext-system.
      126      buffer-copy old-c-ext-system to new-c-ext-system.
      127   end.
      128   end.
      129   for each old-ext-system-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      130      create new-ext-system-attr.
      131      buffer-copy old-ext-system-attr to new-ext-system-attr.
      132   end.
      133   for each old-esys-all-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      134      create new-esys-all-attr.
      135      buffer-copy old-esys-all-attr to new-esys-all-attr.
      136   end.
      137   for each old-esys-pck-keys  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      138      create new-esys-pck-keys.
      139      buffer-copy old-esys-pck-keys to new-esys-pck-keys.
      140   end.
      141   for each old-esys-pck-rcvd  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      142      create new-esys-pck-rcvd.
      143      buffer-copy old-esys-pck-rcvd to new-esys-pck-rcvd.
      144   end.
      145   for each old-esys-pck-sent  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      146      create new-esys-pck-sent.
      147      buffer-copy old-esys-pck-sent to new-esys-pck-sent.
      148   end.
      149   for each old-esys-route  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      150      create new-esys-route.
      151      buffer-copy old-esys-route to new-esys-route.
      152   end.
      153   for each old-esys-route-dump  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      154      create new-esys-route-dump.
      155      buffer-copy old-esys-route-dump to new-esys-route-dump.
      156   end.
      157   for each old-datatype-exp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      158      create new-datatype-exp.
      159      buffer-copy old-datatype-exp to new-datatype-exp.
      160   end.
      161   for each old-datatype-exp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      162      create new-datatype-exp-attr.
      163      buffer-copy old-datatype-exp-attr to new-datatype-exp-attr.
      164   end.
      165   for each old-datatype-imp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      166      create new-datatype-imp.
      167      buffer-copy old-datatype-imp to new-datatype-imp.
      168   end.
      169   for each old-datatype-imp-attr  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      170      create new-datatype-imp-attr.
      171      buffer-copy old-datatype-imp-attr to new-datatype-imp-attr.
      172   end.
      173   for each old-datatype-table  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      174      create new-datatype-table.
      175      buffer-copy old-datatype-table to new-datatype-table.
      176   end.
      177   for each old-datatype-table-exp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      178      create new-datatype-table-exp.
      179      buffer-copy old-datatype-table-exp to new-datatype-table-exp.
      180   end.
      181   for each old-datatype-table-field  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      182      create new-datatype-table-field.
      183      buffer-copy old-datatype-table-field to new-datatype-table-field.
      184   end.
      185   for each old-datatype-table-field-exp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      186      create new-datatype-table-field-exp.
      187      buffer-copy old-datatype-table-field-exp to new-datatype-table-field-exp.
      188   end.
      189   for each old-datatype-table-field-imp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      190      create new-datatype-table-field-imp.
      191      buffer-copy old-datatype-table-field-imp to new-datatype-table-field-imp.
      192   end.
      193   for each old-datatype-table-imp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      194      create new-datatype-table-imp.
      195      buffer-copy old-datatype-table-imp to new-datatype-table-imp.
      196   end.
      197   for each old-esys-datatype-exp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      198      create new-esys-datatype-exp.
      199      buffer-copy old-esys-datatype-exp to new-esys-datatype-exp.
      200   end.
      201   for each old-esys-datatype-imp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      202      create new-esys-datatype-imp.
      203      buffer-copy old-esys-datatype-imp to new-esys-datatype-imp.
      204   end.
      205   if varstay-history then do:
      206   for each old-c-esys-datatype-exp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      207      create new-c-esys-datatype-exp.
      208      buffer-copy old-c-esys-datatype-exp to new-c-esys-datatype-exp.
      209   end.
      210   for each old-c-esys-datatype-imp  no-lock on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      211      create new-c-esys-datatype-imp.
      212      buffer-copy old-c-esys-datatype-imp to new-c-esys-datatype-imp.
      213   end.
      214   end.
      215   output stream str-gen close.
      216   return "Произведен экспорт таблиц: ext-system c-ext-system ext-system-attr esys-all-attr" +
      217   "esys-pck-keys esys-pck-rcvd esys-pck-sent esys-route esys-route-dump" +
      218   "~
      219   c-esys-datatype-exp ~
      220   c-esys-datatype-imp ~
      221   datatype-exp ~
      222   datatype-exp-attr ~
      223   datatype-imp ~
      224   datatype-imp-attr ~
      225   datatype-table ~
      226   datatype-table-exp ~
      227   datatype-table-field ~
      228   datatype-table-field-exp ~
      229   datatype-table-field-imp ~
      230   datatype-table-imp ~
      231   esys-datatype-exp ~
      232   esys-datatype-imp ~
      233   .".
      234   end.
