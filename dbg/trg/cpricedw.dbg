        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-price-doc old buffer old-c-doc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись документа переоценки ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3',ub.c-price-doc.doc-num,ub.c-price-doc.chip-num,ub.c-price-doc.status_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable v-host-code like c-price-doc.host-code no-undo.
       82   MAIN-BLOCK :
       83   do
       84   on error   undo main-block, return error
       85   on end-key undo main-block, return error
       86   on stop    undo main-block, return error
       87   :
       88     find first ub.clients no-lock
       89       where ub.clients.obj-type = ub.c-price-doc.obj-type
       90         and ub.clients.obj-code = ub.c-price-doc.obj-code
       91       no-error .
       92     if not available ub.clients then do:
       93       message
       94         vss-workfile vss-revision vss-description skip
       95         "Неправильная ссылка на объект" skip
       96         "Документ " ub.c-price-doc.doc-num skip
       97         "Не найден объект" ub.c-price-doc.obj-type ub.c-price-doc.obj-code skip
       98         view-as alert-box error .
       99       undo main-block, return error .
      100     end.
      101   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      103     (input  ub.c-price-doc.obj-type
      104     ,input  ub.c-price-doc.obj-code
      105     ,output v-host-code
      106     ) no-error .
      107     if error-status :error then do:
      108       message
      109        vss-workfile vss-revision vss-description skip
      110        "Ошика при определении кода фирмы для объекта" skip
      111        "Документ " ub.c-price-doc.doc-num skip
      112        "obj-type" ub.c-price-doc.obj-type skip
      113        "obj-code" ub.c-price-doc.obj-code skip
      114        error-status :get-message(1) skip
      115        return-value skip
      116        view-as alert-box error .
      117       undo main-block, return error .
      118     end.
      119     if ub.c-price-doc.host-code <> v-host-code then do:
      120       message
      121         vss-workfile vss-revision vss-description skip
      122         "Неправильно заполнено поле фирма" skip
      123         "Документ " ub.c-price-doc.doc-num skip
      124         "Объект"  ub.c-price-doc.obj-type ub.c-price-doc.obj-code skip
      125         "Фирма"   ub.c-price-doc.host-code skip
      126         "Должна быть фирма" v-host-code skip
      127         view-as alert-box error .
      128       undo main-block, return error .
      129     end.
      130     if  not g#news
      131     and ub.c-price-doc.corr-man = "" then do:
      132       assign
      133         ub.c-price-doc.corr-man = g#userid
      134       .
      135     end.
      136     if  g#news  = false   then do:
      137       run str/callnews.p
      138         (input "c-price-doc"
      139         ,input (buffer ub.c-price-doc:handle)
      140         ) no-error .
      141       if error-status :error then do:
      142         message
      143           vss-workfile vss-revision vss-description skip
      144           "Невозможно маршрутизировать c-price-doc для отправки в новости" skip
      145           "Документ " ub.c-price-doc.doc-num skip
      146           "chip-num " ub.c-price-doc.chip-num skip
      147           "Объект"  ub.c-price-doc.obj-type ub.c-price-doc.obj-code skip
      148           "Фирма"   ub.c-price-doc.host-code skip
      149           error-status :get-message(1) skip
      150           return-value skip
      151           view-as alert-box error .
      152         undo, return error .
      153       end.
      154    end.
      155       if g#oxml = yes
      156       then do:
      157       run str/calloxml.p (
      158             input 'update':U
      159           , input 'c-price-doc':U
      160           , input ( buffer ub.c-price-doc:handle )
      161       ) no-error.
      162       if error-status :error
      163       then do:
      164           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      165                                , chr(10)
      166                                , vss-workfile
      167                                , return-value
      168                                , error-status :get-message ( 1 ) ).
      169       end.
      170       end.
      171   end.
