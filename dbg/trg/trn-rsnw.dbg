        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.trn-reason NEW BUFFER Buf_New OLD BUFFER Buf_Old.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Триггер на запись оснований (причин) создания документов":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   main-block:
       79   do
       80   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       81   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       82   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       83   :
       84   define variable j-reason-code like ub.trn-reason.reason-code no-undo.
       85   define buffer buf_rsn-attr for ub.trn-rsn-attr.
       86     if Buf_New.reason-code <> Buf_Old.reason-code and Buf_New.reason-code <> ? and Buf_New.reason-code <> 0 and
       87                                                       Buf_Old.reason-code <> ? and Buf_Old.reason-code <> 0 then do:
       88       for each buf_rsn-attr no-lock where
       89                buf_rsn-attr.reason-code = Buf_Old.reason-code :
       90         find first ub.trn-rsn-attr exclusive-lock where
       91             recid( ub.trn-rsn-attr ) = recid( buf_rsn-attr ).
       92         assign buf_rsn-attr.reason-code = Buf_New.reason-code.
       93         find first ub.trn-rsn-attr        no-lock where
       94             recid( ub.trn-rsn-attr ) = recid( buf_rsn-attr ).
       95         run str/callnews.p ( input "trn-rsn-attr", input ( buffer ub.trn-rsn-attr :handle ) ) no-error.
       96         if error-status :error then do:
       97           if error-status :get-message( 1 ) <> "":U then do:
       98             message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
       99                     "Ошибка при вызове процедуры callnews.p" skip
      100                     error-status :get-message( 1 ) skip
      101                     return-value skip
      102             view-as alert-box error.
      103           end.
      104           undo Main-Block, return error return-value.
      105         end.
      106       end.
      107     end.
      108     assign j-reason-code = ( if new( Buf_New ) then Buf_New.reason-code else Buf_Old.reason-code ).
      109     if g#news <> yes then do:
      110       create ub.c-trn-reason.
      111       buffer-copy Buf_Old except reason-code to ub.c-trn-reason no-error.
      112       if error-status :error then do: undo Main-Block, return error. end.
      113       assign ub.c-trn-reason.action      = integer( if new( Buf_New )                            then '1':U else
      114                                              ( if Buf_New.reason-code = Buf_Old.reason-code then '2':U else
      115                                                                                                  '9':U ) )
      116              ub.c-trn-reason.reason-code         = j-reason-code
      117              ub.c-trn-reason.corr-date           = today
      118              ub.c-trn-reason.corr-time           = time
      119              ub.c-trn-reason.corr-user-name      = g#userid
      120              ub.c-trn-reason.corr-user-db-num    = g#db-num
      121              ub.c-trn-reason.chip-num            = next-value( s-corr-chip, ub ) no-error.
      122       if error-status :error then do: undo Main-Block, return error. end.
      123       for each buf_rsn-attr no-lock where
      124                buf_rsn-attr.reason-code = j-reason-code :
      125         find first ub.trn-rsn-attr exclusive-lock where
      126             recid( ub.trn-rsn-attr ) = recid( buf_rsn-attr ).
      127         create ub.c-trn-rsn-attr.
      128         buffer-copy ub.trn-rsn-attr to ub.c-trn-rsn-attr no-error.
      129         if error-status :error then do: undo, return error. end.
      130         assign ub.c-trn-rsn-attr.action           = ub.c-trn-reason.action
      131                ub.c-trn-rsn-attr.corr-date        = ub.c-trn-reason.corr-date
      132                ub.c-trn-rsn-attr.corr-time        = ub.c-trn-reason.corr-time
      133                ub.c-trn-rsn-attr.corr-user-name   = ub.c-trn-reason.corr-user-name
      134                ub.c-trn-rsn-attr.corr-user-db-num = ub.c-trn-reason.corr-user-db-num
      135                ub.c-trn-rsn-attr.chip-num         = ub.c-trn-reason.chip-num no-error.
      136         if error-status :error then do: undo, return error. end.
      137       end.
      138     end.
      139     run str/callnews.p ( input "trn-reason", input ( buffer Buf_New :handle ) ) no-error.
      140     if error-status :error then do:
      141       if error-status :get-message( 1 ) <> "":U then do:
      142         message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      143                 "Ошибка при вызове процедуры callnews.p" skip
      144                 error-status :get-message( 1 ) skip
      145                 return-value skip
      146         view-as alert-box error.
      147       end.
      148       undo Main-Block, return error return-value.
      149     end.
      150       if g#oxml = yes
      151       then do:
      152       run str/calloxml.p (
      153             input 'update':U
      154           , input 'trn-reason':U
      155           , input ( buffer ub.trn-reason:handle )
      156       ) no-error.
      157       if error-status :error
      158       then do:
      159           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      160                                , chr(10)
      161                                , vss-workfile
      162                                , return-value
      163                                , error-status :get-message ( 1 ) ).
      164       end.
      165       end.
      166   end.
