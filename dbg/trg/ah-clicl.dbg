        1   block-level on error undo, throw.
        2   define input parameter p-obj-type         as character no-undo .
        3   define input parameter p-obj-code         as integer no-undo .
        4   define input parameter p-last-fact-order  as decimal no-undo .
        5   define input parameter p-cut-fact-order   as decimal   no-undo .
        6   define input parameter v-export-file-name as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Очистка и экспорт складского архива по поставщикам".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure factord :
       84     define input  parameter p-fact-date            as date    no-undo .
       85     define input  parameter p-fact-time            as integer no-undo .
       86     define input  parameter p-fact-num             as integer no-undo .
       87     define input  parameter p-shift-date           as date    no-undo .
       88     define input  parameter p-shift-num            as integer no-undo .
       89     define input  parameter p-shift-on             as logical no-undo .
       90     define output parameter p-fact-order           as decimal no-undo .
       91     define output parameter p-shift-end-fact-order as decimal no-undo .
       92     define output parameter p-day-end-fact-order   as decimal no-undo .
       93     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       94     if p-fact-date = ?
       95     then do:
       96       return error "Не указана фактическая дата" .
       97     end.
       98     define variable v-fact-date-num as integer no-undo .
       99     assign
      100       v-fact-date-num = integer(p-fact-date)
      101     .
      102     if p-fact-num = ?
      103     or p-fact-num = 0
      104     then do:
      105       return error "Не задан p-fact-num " + string(p-fact-num) .
      106     end.
      107     if p-fact-num < 0
      108     then do:
      109       return error "Отрицательный fact-num " + string(p-fact-num) .
      110     end.
      111     if p-fact-num >= 100000000
      112     then do:
      113       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      114     end.
      115     if p-shift-on = true
      116     then do:
      117       if p-shift-date = ?
      118       then do:
      119         return error "Не задана дата смены" .
      120       end.
      121       if p-shift-num = ?
      122       or p-shift-num = 0
      123       then do:
      124         return error "Не задан номер смены" .
      125       end.
      126     end.
      127     else do:
      128       assign
      129         p-shift-date = p-fact-date
      130         p-shift-num  = 24
      131       .
      132     end.
      133     define variable v-shift-offset as integer no-undo .
      134     if p-shift-date = p-fact-date
      135     then do:
      136       assign
      137         v-shift-offset = 1
      138       .
      139     end.
      140     if p-shift-date < p-fact-date
      141     then do:
      142       assign
      143         v-shift-offset = 0
      144       .
      145     end.
      146     if p-shift-date > p-fact-date
      147     then do:
      148       message
      149         vss-workfile vss-revision vss-description skip
      150         "Неправильная дата закрытия смены" skip
      151         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      152         view-as alert-box error .
      153       undo, return error
      154         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      155           ,string(p-fact-date, '99/99/9999':U)
      156           ,string(p-shift-date, '99/99/9999':U)
      157           )
      158       .
      159     end.
      160     if p-shift-num < 1
      161     or p-shift-num > 24
      162     then do:
      163       message
      164         vss-workfile vss-revision vss-description skip
      165         "Неправильный номер смены" skip
      166         "p-shift-num" p-shift-num skip
      167         view-as alert-box error .
      168       undo, return error return-value .
      169     end.
      170     assign
      171       p-fact-order           = v-fact-date-num
      172                              + v-shift-offset * 0.5
      173                              + p-shift-num    * 0.02 - 0.01
      174                              + p-fact-num     * 0.0000000001
      175       p-shift-end-fact-order = v-fact-date-num
      176                              + v-shift-offset * 0.5
      177                              + p-shift-num    * 0.02
      178       p-day-end-fact-order   = v-fact-date-num
      179                              + 0.99
      180     .
      181     if p-fact-order           <= v-fact-date-num
      182     or p-shift-end-fact-order <= v-fact-date-num
      183     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      184     or p-shift-end-fact-order >= p-day-end-fact-order
      185     then do:
      186       message
      187         vss-workfile vss-revision vss-description skip
      188         "Внутренняя ошибка при генерации фактического номера" skip
      189         "p-fact-date"            p-fact-date            skip
      190         "p-fact-time"            p-fact-time            skip
      191         "p-fact-num"             p-fact-num             skip
      192         "p-shift-date"           p-shift-date           skip
      193         "p-shift-num"            p-shift-num            skip
      194         "p-shift-on"             p-shift-on             skip
      195         "p-shift-end-fact-order" p-shift-end-fact-order skip
      196         "p-day-end-fact-order"   p-day-end-fact-order   skip
      197         "v-fact-date-num"        v-fact-date-num        skip
      198         view-as alert-box error .
      199       undo, return error return-value .
      200     end.
      201   end procedure.
      202   procedure day-begin-fact-order :
      203     define input  parameter p-fact-date            as date    no-undo .
      204     define output parameter p-day-begin-fact-order as decimal no-undo .
      205     do
      206     on error undo, return error return-value
      207     :
      208       if p-fact-date = ?
      209       then do:
      210         assign
      211           p-day-begin-fact-order = 0
      212         .
      213       end.
      214       else do:
      215         assign
      216           p-day-begin-fact-order = integer(p-fact-date)
      217         .
      218       end.
      219     end.
      220   end procedure.
      221   procedure factord-max-fact-order :
      222     define output parameter p-max-fact-order as decimal   no-undo .
      223     do
      224     on error undo, return error return-value
      225     :
      226       run day-begin-fact-order in this-procedure
      227         (input  date(1, 1, 5000)
      228         ,output p-max-fact-order
      229         ) .
      230     end.
      231   end procedure.
      232   procedure factord-cut-archive :
      233     define input  parameter p-obj-type             as character no-undo .
      234     define input  parameter p-obj-code             as integer   no-undo .
      235     define input  parameter p-fact-date            as date      no-undo .
      236     define output parameter p-shift-on             as logical   no-undo .
      237     define output parameter p-shift-date           as date      no-undo .
      238     define output parameter p-shift-num            as integer   no-undo .
      239     define output parameter p-day-end-fact-order   as decimal   no-undo .
      240     define output parameter p-shift-end-fact-order as decimal   no-undo .
      241     define variable v-fact-order as decimal   no-undo .
      242     define buffer buf_shift-obj for ub.shift-obj .
      243     do
      244     on error undo, return error return-value
      245     :
      246   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      247   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      248     (input  p-obj-type
      249     ,input  p-obj-code
      250     ,input  'shift-on=request'
      251     ,output p-shift-on
      252     ) no-error .
      253       if error-status :error
      254       then do:
      255         message
      256           vss-workfile vss-revision vss-description skip
      257           "Ошибка при определении атрибута объекта" skip
      258           "Объект" p-obj-type p-obj-code skip
      259           error-status :get-message(1) skip
      260           return-value skip
      261           view-as alert-box error .
      262         undo, return error return-value .
      263       end.
      264       if p-shift-on = false
      265       then do:
      266         assign
      267           p-shift-date               = ?
      268           p-shift-num                = 0
      269         .
      270       end.
      271       else do:
      272         find first buf_shift-obj share-lock
      273           where buf_shift-obj.obj-type   = p-obj-type
      274             and buf_shift-obj.obj-code   = p-obj-code
      275             and buf_shift-obj.shift-date > p-fact-date
      276           use-index pi
      277           no-error .
      278         if not available buf_shift-obj
      279         or buf_shift-obj.status_ <> 'зкр':U
      280         then do:
      281           message
      282             vss-workfile vss-revision vss-description skip
      283             "Невозможно вычислить последнюю смену" skip
      284             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      285             "Объект" p-obj-type p-obj-code skip
      286             "Дата" p-fact-date skip
      287             view-as alert-box error .
      288           undo, return error return-value .
      289         end.
      290         find last buf_shift-obj share-lock
      291           where buf_shift-obj.obj-type = p-obj-type
      292             and buf_shift-obj.obj-code = p-obj-code
      293             and buf_shift-obj.shift-date <= p-fact-date
      294           use-index pi
      295           no-error .
      296         if available buf_shift-obj
      297         then do:
      298           if  buf_shift-obj.status_ = 'зкр':U
      299           then do:
      300             assign
      301               p-shift-date = buf_shift-obj.shift-date
      302               p-shift-num  = buf_shift-obj.shift-num
      303             .
      304           end.
      305           else do:
      306             message
      307               vss-workfile vss-revision vss-description skip
      308               "Невозможно вычислить последнюю смену" skip
      309               "Статус смены отличен от статуса" 'зкр':U skip
      310               "Объект" p-obj-type p-obj-code skip
      311               "Дата" p-fact-date skip
      312               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      313               view-as alert-box error .
      314             undo, return error return-value .
      315           end.
      316         end.
      317         else do:
      318           assign
      319             p-shift-date = p-fact-date - 1
      320             p-shift-num  = 1
      321           .
      322         end.
      323       end.
      324       run factord in this-procedure
      325         (input  p-fact-date
      326         ,input  1
      327         ,input  1
      328         ,input  p-shift-date
      329         ,input  p-shift-num
      330         ,input  p-shift-on
      331         ,output v-fact-order
      332         ,output p-shift-end-fact-order
      333         ,output p-day-end-fact-order
      334         ) no-error .
      335       if error-status :error
      336       then do:
      337         message
      338           vss-workfile vss-revision vss-description skip
      339           "Ошибка при вызове процедуры factord"
      340           error-status :get-message(1) skip
      341           return-value skip
      342           view-as alert-box error .
      343         undo, return error return-value .
      344       end.
      345     end.
      346   end procedure.
      347   procedure factord-lock-shift :
      348     define input  parameter p-obj-type  as character no-undo .
      349     define input  parameter p-obj-code  as integer   no-undo .
      350     define input  parameter p-fact-date as date      no-undo .
      351     define parameter buffer buf_shift-obj for ub.shift-obj .
      352     define variable v-shift-on      as logical   no-undo .
      353     define variable v-extra-message as character no-undo .
      354     define variable v-error as character no-undo .
      355     do
      356     on error undo, return error return-value
      357     :
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      360     (input  p-obj-type
      361     ,input  p-obj-code
      362     ,input  'shift-on=request'
      363     ,output v-shift-on
      364     ) no-error .
      365       if error-status :error
      366       then do:
      367         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      368         undo, return error v-error .
      369       end.
      370       if v-shift-on = true
      371       then do:
      372         find first buf_shift-obj share-lock
      373           where buf_shift-obj.obj-type   = p-obj-type
      374             and buf_shift-obj.obj-code   = p-obj-code
      375             and buf_shift-obj.shift-date > p-fact-date
      376           use-index pi
      377           no-error .
      378         if not available buf_shift-obj
      379         or buf_shift-obj.status_ <> 'зкр':U
      380         then do:
      381           find last buf_shift-obj
      382             where buf_shift-obj.obj-type = p-obj-type
      383               and buf_shift-obj.obj-code = p-obj-code
      384               and buf_shift-obj.status_  = 'зкр':U
      385             use-index stts
      386             no-error .
      387           if available buf_shift-obj
      388           then do:
      389             assign
      390               v-extra-message =
      391                     substitute("Дата начала последеней закрытой смены на объекте &1"
      392                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      393                               )
      394             .
      395           end.
      396           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      397           undo, return error v-error .
      398         end.
      399       end.
      400     end.
      401   end procedure.
      402   procedure factord-end-day :
      403     define input  parameter p-fact-date            as date    no-undo .
      404     define output parameter p-day-end-fact-order   as decimal no-undo .
      405     do
      406     on error undo, return error return-value
      407     :
      408       if p-fact-date = ?
      409       then do:
      410         return error "Не указана фактическая дата" .
      411       end.
      412       assign
      413         p-day-end-fact-order = integer(p-fact-date) + 0.99
      414       .
      415     end.
      416   end procedure.
      417   procedure factord-to-date :
      418     define input  parameter p-fact-order as decimal no-undo .
      419     define output parameter p-fact-date  as date    no-undo .
      420     define variable v-ref-date  as date      no-undo .
      421     define variable v-ref-delta as integer   no-undo .
      422     do
      423     on error undo, return error return-value
      424     :
      425       if p-fact-order = ?
      426       or p-fact-order = 0
      427       then do:
      428         return error "Не указан fact-order" .
      429       end.
      430       assign
      431         v-ref-date  = date(1, 1, 2000)
      432       .
      433       assign
      434         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      435       .
      436       assign
      437         p-fact-date = v-ref-date + v-ref-delta
      438       .
      439     end.
      440   end procedure.
      441   procedure factord-to-fact-num :
      442     define input  parameter p-fact-order as decimal no-undo .
      443     define output parameter p-fact-num   as integer no-undo .
      444     define variable v-fact-order-trunc as decimal no-undo .
      445     do
      446     on error undo, return error return-value
      447     :
      448       if p-fact-order = ?
      449       or p-fact-order = 0
      450       then do:
      451         return error "Не указан fact-order" .
      452       end.
      453       assign
      454        v-fact-order-trunc = truncate(p-fact-order, 2)
      455       .
      456       assign
      457         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      458       .
      459     end.
      460   end procedure.
      461   procedure factord-to-shift-num :
      462     define input  parameter p-fact-order as decimal no-undo .
      463     define output parameter p-shift-num   as integer no-undo .
      464     define variable  p-shift-numd  as decimal   no-undo .
      465     define variable v-fact-order-trunc as decimal no-undo .
      466     do
      467     on error undo, return error return-value
      468     :
      469       if p-fact-order = ?
      470       or p-fact-order = 0
      471       then do:
      472         return error "Не указан fact-order" .
      473       end.
      474       assign
      475        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      476       .
      477       if v-fact-order-trunc < 0.5 then do:
      478         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      479       end.
      480       assign
      481         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      482         .
      483        assign
      484         p-shift-num = truncate (p-shift-numd , 0)
      485       .
      486     end.
      487   end procedure.
      488   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      489   define new global shared variable g#attr-lib  as handle no-undo .
      490   define variable v-attr-lib-variable as handle no-undo .
      491   procedure clntattr-code :
      492     define input  parameter p-code           as character no-undo .
      493     define output parameter p-type           as character no-undo .
      494     define output parameter p-format         as character no-undo .
      495     define output parameter p-label          as character no-undo .
      496     define output parameter p-user-can-edit  as logical   no-undo .
      497     define output parameter p-output-display as logical   no-undo .
      498     define output parameter p-other          as character no-undo .
      499     do
      500     on error undo, return error return-value
      501     :
      502           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      503         (input  p-code
      504         ,output p-type
      505         ,output p-format
      506         ,output p-label
      507         ,output p-user-can-edit
      508         ,output p-output-display
      509         ,output p-other
      510         ) no-error .
      511       if error-status :error
      512       then do:
      513         undo, return error return-value .
      514       end.
      515     end.
      516   end procedure.
      517   procedure clntattr-tooltip :
      518     define input  parameter p-code    as character no-undo .
      519     define output parameter p-tooltip as character no-undo .
      520     define output parameter p-label   as character no-undo .
      521     do
