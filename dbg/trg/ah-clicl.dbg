      770   define variable v-export-archive as logical   no-undo .
      771   define variable v-action         as character no-undo .
      772   define stream slog .
      773   define temp-table temp-goods no-undo
      774     field gds-code  as integer
      775     field artic     as character
      776     field prod-type as character
      777     field prod-code as integer
      778     index xpk is primary unique gds-code
      779     index xie artic prod-type prod-code
      780     .
      781   define temp-table temp-ot-supp-tot no-undo like ub.ot-supp-tot
      782     .
      783   define temp-table temp-ot-supp-line no-undo like ub.ot-supp-line
      784     field gds-code as integer
      785     .
      786   define temp-table temp-stk-supp-tot no-undo like ub.stk-supp-tot
      787     .
      788   define temp-table temp-stk-supp-line no-undo like ub.stk-supp-line
      789     field gds-code as integer
      790     .
      791   define buffer buf_ot-supp-tot        for ub.ot-supp-tot     .
      792   define buffer buf_ot-supp-line       for ub.ot-supp-line    .
      793   define buffer buf_stk-supp-tot       for ub.stk-supp-tot    .
      794   define buffer buf_stk-supp-line      for ub.stk-supp-line   .
      795   define buffer buf_temp-ot-supp-tot   for temp-ot-supp-tot   .
      796   define buffer buf_temp-ot-supp-line  for temp-ot-supp-line  .
      797   define buffer buf_temp-stk-supp-tot  for temp-stk-supp-tot  .
      798   define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
      799   main-block:
      800   do
      801   on error undo main-block, return error
      802   :
      803     if  v-export-file-name <> ""
      804     and v-export-file-name <> ?
      805     then do:
      806       assign
      807         v-export-archive = true
      808         v-action         = "Экспорт складского архива по поставщикам"
      809       .
      810     end.
      811     else do:
      812       assign
      813         v-export-archive = false
      814         v-action         = "Очистка складского архива по поставщикам"
      815       .
      816     end.
      817     define variable v-obj-type       like ub.gds-obj.obj-type no-undo .
      818     define variable v-obj-code       like ub.gds-obj.obj-code no-undo .
      819     define variable v-start-time     as integer   no-undo .
      820     define variable v-current-time   as character no-undo .
      821     define variable v-current-action as character no-undo .
      822     define variable v-count          as integer   no-undo .
      823     define variable v-sub-action     as character no-undo .
      824     def frame a
      825       v-obj-type       label "Объект"
      826       v-obj-code       no-label skip
      827       v-current-action format "x(40)" no-label skip
      828       v-current-time   format "x(8)"  label "Время очистки складского архива" skip
      829       v-count          format ">>>,>>>,>>9" no-label skip
      830       v-sub-action     format "x(40)" no-label skip
      831       with view-as dialog-box side-labels three-d
      832       title v-action
      833       .
      834     assign
      835       v-obj-type   = p-obj-type
      836       v-obj-code   = p-obj-code
      837       v-start-time = time
      838     .
      839     view frame a .
      840     display
      841       v-obj-type
      842       v-obj-code
      843       with frame a .
      844     if v-export-archive = true
      845     then do:
      846       output stream slog to value(v-export-file-name) append .
      847     end.
      848     define variable v-obj-exist as logical no-undo .
      849   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      851     (input  p-obj-type
      852     ,input  p-obj-code
      853     ,input  'check-exist':u
      854     ,output v-obj-exist
      855     )  .
      856     if p-cut-fact-order = ?
      857     then do:
      858       message
      859         vss-workfile vss-revision vss-description skip
      860         "Ошибка задания входных параметров" skip
      861         "Объект" p-obj-type p-obj-code skip
      862         "p-cut-fact-order" p-cut-fact-order skip
      863         view-as alert-box error .
      864       undo, return error .
      865     end.
      866     define variable v-max-fact-order as decimal   no-undo .
      867     run factord-max-fact-order in this-procedure
      868       (output v-max-fact-order
      869       ) .
      870     if p-cut-fact-order = 0
      871     then do:
      872       assign
      873         p-cut-fact-order = v-max-fact-order
      874       .
      875     end.
      876     define variable v-attr-value as character no-undo .
      877     define variable v-attr-type  as character no-undo .
      878     run clntattr-value in this-procedure
      879       (input  p-obj-type
      880       ,input  p-obj-code
      881       ,input  'ahsp-detail':U
      882       ,output v-attr-value
      883       ,output v-attr-type
      884       ) .
      885     define variable v-cut-date       as date    no-undo .
      886     define variable v-cut-fact-order as decimal no-undo .
      887     if v-attr-type = 'T':U
      888     then do:
      889       assign
      890         v-cut-date = date(v-attr-value)
      891       .
      892     end.
      893     else do:
      894       message
      895         vss-workfile vss-revision vss-description skip
      896         "Неправильный тип атрибута" 'ahsp-detail':U skip
      897         "Тип атрибута" v-attr-type skip
      898         view-as alert-box error .
      899       undo, return error .
      900     end.
      901     run day-begin-fact-order in this-procedure
      902       (input  v-cut-date
      903       ,output v-cut-fact-order
      904       ).
      905     if p-last-fact-order = ?
      906     then do:
      907       message
      908         vss-workfile vss-revision vss-description skip
      909         "Ошибка при задании входных параметров" skip
      910         "Не задана дата начиная с которой необходимо удалить складской архив по поставщикам" skip
      911         "Объект" p-obj-type p-obj-code skip
      912         "v-cut-fact-order"  v-cut-fact-order skip
      913         "p-last-fact-order" p-last-fact-order skip
      914         view-as alert-box error .
      915       undo, return error .
      916     end.
      917     if v-export-archive = false
      918     then do:
      919       if  (v-cut-fact-order  <= p-last-fact-order
      920            and p-last-fact-order <= p-cut-fact-order )
      921       or  (p-last-fact-order <= p-cut-fact-order
      922            and p-cut-fact-order <= v-cut-fact-order
      923           )
      924       then do:
      925       end.
      926       else do:
      927         message
      928           vss-workfile vss-revision vss-description skip
      929           "Ошибка при удалении складского архива по поставщикам" skip
      930           "Неправильный диапазон удаления складского архива по поставщикам" skip
      931           "Объект" p-obj-type p-obj-code skip
      932           "v-cut-fact-order"  v-cut-fact-order skip
      933           "p-last-fact-order" p-last-fact-order skip
      934           "p-cut-fact-order" p-last-fact-order skip
      935           view-as alert-box error .
      936         undo, return error .
      937       end.
      938     end.
      939     define variable v-ind as integer no-undo .
      940     run show-action in this-procedure
      941       (input "Итоги по документам"
      942       ).
      943     for each buf_ot-supp-tot
      944       where buf_ot-supp-tot.obj-type   = p-obj-type
      945         and buf_ot-supp-tot.obj-code   = p-obj-code
      946         and buf_ot-supp-tot.fact-order > p-last-fact-order
      947         and buf_ot-supp-tot.fact-order <= p-cut-fact-order
      948     on error undo main-block, return error
      949     :
      950       assign
      951         v-ind = v-ind + 1
      952       .
      953       if v-ind modulo 10 = 0
      954       then do:
      955         run show-count in this-procedure
      956           (input v-ind
      957           ,input "Документ " + string(buf_ot-supp-tot.doc-code)
      958           ).
      959       end.
      960       if v-export-archive = true
      961       then do:
      962         create buf_temp-ot-supp-tot .
      963         buffer-copy buf_ot-supp-tot to buf_temp-ot-supp-tot .
      964         export stream slog 'ot-supp-tot':U .
      965         export stream slog buf_temp-ot-supp-tot .
      966         delete buf_temp-ot-supp-tot .
      967       end.
      968       else do:
      969         delete buf_ot-supp-tot .
      970       end.
      971     end.
      972     run show-action in this-procedure
      973       (input "Итоги по строкам документов"
      974       ).
      975     for each buf_ot-supp-line
      976       where buf_ot-supp-line.obj-type   = p-obj-type
      977         and buf_ot-supp-line.obj-code   = p-obj-code
      978         and buf_ot-supp-line.fact-order > p-last-fact-order
      979         and buf_ot-supp-line.fact-order <= p-cut-fact-order
      980     on error undo main-block, return error
      981     :
      982       assign
      983         v-ind = v-ind + 1
      984       .
      985       if v-ind modulo 10 = 0
      986       then do:
      987         run show-count in this-procedure
      988           (input v-ind
      989           ,input "Документ " + string(buf_ot-supp-line.doc-code)
      990                 + " Артикул " + string(buf_ot-supp-line.artic)
      991           ).
      992       end.
      993       if v-export-archive = true
      994       then do:
      995         create buf_temp-ot-supp-line .
      996         buffer-copy buf_ot-supp-line to buf_temp-ot-supp-line .
      997         run fill-gds-code in this-procedure
      998           (input  buf_temp-ot-supp-line.artic
      999           ,input  buf_temp-ot-supp-line.prod-type
     1000           ,input  buf_temp-ot-supp-line.prod-code
     1001           ,output buf_temp-ot-supp-line.gds-code
     1002           ) .
     1003         export stream slog 'ot-supp-line':U .
     1004         export stream slog buf_temp-ot-supp-line except artic prod-type prod-code .
     1005         delete buf_temp-ot-supp-line .
     1006       end.
     1007       else do:
     1008         delete buf_ot-supp-line .
     1009       end.
     1010     end.
     1011     run show-action in this-procedure
     1012       (input "Итоги по объекту"
     1013       ).
     1014     for each buf_stk-supp-tot
     1015       where buf_stk-supp-tot.obj-type   = p-obj-type
     1016         and buf_stk-supp-tot.obj-code   = p-obj-code
     1017         and buf_stk-supp-tot.fact-order > p-last-fact-order
     1018         and buf_stk-supp-tot.fact-order <= p-cut-fact-order
     1019     on error undo main-block, return error
     1020     :
     1021       assign
     1022         v-ind = v-ind + 1
     1023       .
     1024       if v-ind modulo 10 = 0
     1025       then do:
     1026         run show-count in this-procedure
     1027           (input v-ind
     1028           ,input "Дата " + string(buf_stk-supp-tot.fact-date, '99/99/9999':U )
     1029           ).
     1030       end.
     1031       if v-export-archive = true
     1032       then do:
     1033         create buf_temp-stk-supp-tot .
     1034         buffer-copy buf_stk-supp-tot to buf_temp-stk-supp-tot .
     1035         export stream slog 'stk-supp-tot':U .
     1036         export stream slog buf_temp-stk-supp-tot .
     1037         delete buf_temp-stk-supp-tot .
     1038       end.
     1039       else do:
     1040         delete buf_stk-supp-tot .
     1041       end.
     1042     end.
     1043     run show-action in this-procedure
     1044       (input "Итоги по товарам на объекте"
     1045       ).
     1046     for each buf_stk-supp-line
     1047       where buf_stk-supp-line.obj-type   = p-obj-type
     1048         and buf_stk-supp-line.obj-code   = p-obj-code
     1049         and buf_stk-supp-line.fact-order > p-last-fact-order
     1050         and buf_stk-supp-line.fact-order <= p-cut-fact-order
     1051     on error undo main-block, return error
     1052     :
     1053       assign
     1054         v-ind = v-ind + 1
     1055       .
     1056       if v-ind modulo 10 = 0
     1057       then do:
     1058         run show-count in this-procedure
     1059           (input v-ind
     1060           ,input "Артикул " + string(buf_stk-supp-line.artic)
     1061           ).
     1062       end.
     1063       if v-export-archive = true
     1064       then do:
     1065         create buf_temp-stk-supp-line .
     1066         buffer-copy buf_stk-supp-line to buf_temp-stk-supp-line .
     1067         run fill-gds-code in this-procedure
     1068           (input  buf_temp-stk-supp-line.artic
     1069           ,input  buf_temp-stk-supp-line.prod-type
     1070           ,input  buf_temp-stk-supp-line.prod-code
     1071           ,output buf_temp-stk-supp-line.gds-code
     1072           ) .
     1073         export stream slog 'stk-supp-line':U .
     1074         export stream slog buf_temp-stk-supp-line except artic prod-type prod-code .
     1075         delete buf_temp-stk-supp-line .
     1076       end.
     1077       else do:
     1078         delete buf_stk-supp-line .
     1079       end.
     1080     end.
     1081     if v-export-archive = true
     1082     then do:
     1083       output stream slog close .
     1084     end.
     1085   end.
     1086   procedure show-action :
     1087     define input  parameter p-action as character no-undo .
     1088     do
     1089     on error undo, return error
     1090     :
     1091       assign
     1092         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1093         v-current-action = p-action
     1094       .
     1095       display
     1096         v-current-time
     1097         v-current-action
     1098         with frame a.
     1099     end.
     1100   end procedure.
     1101   procedure show-count :
     1102     define input  parameter p-count      as integer   no-undo .
     1103     define input  parameter p-sub-action as character no-undo .
     1104     do
     1105     on error undo, return error
     1106     :
     1107       assign
     1108         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1109         v-count        = p-count
     1110         v-sub-action   = p-sub-action
     1111       .
     1112       display
     1113         v-current-time
     1114         v-count
     1115         v-sub-action
     1116         with frame a.
     1117     end.
     1118   end procedure.
     1119   procedure fill-gds-code :
     1120     define input  parameter p-artic     as character no-undo .
     1121     define input  parameter p-prod-type as character no-undo .
     1122     define input  parameter p-prod-code as integer   no-undo .
     1123     define output parameter p-gds-code  as integer   no-undo .
     1124     define buffer buf_temp-goods for temp-goods .
     1125     define buffer buf_goods for ub.goods .
     1126     do
     1127     on error undo, return error return-value
     1128     :
     1129       find first buf_temp-goods
     1130         where buf_temp-goods.artic     = p-artic
     1131           and buf_temp-goods.prod-type = p-prod-type
     1132           and buf_temp-goods.prod-code = p-prod-code
     1133         no-error .
     1134       if not available buf_temp-goods
     1135       then do:
     1136         find first buf_goods no-lock
     1137           where buf_goods.artic     = p-artic
     1138             and buf_goods.prod-type = p-prod-type
     1139             and buf_goods.prod-code = p-prod-code
     1140           no-error .
     1141         if not available buf_goods
     1142         then do:
     1143           message
     1144             vss-workfile vss-revision vss-description skip
     1145             "Не найден товар" skip
     1146             "Товар" p-artic p-prod-type p-prod-code skip
     1147             view-as alert-box error .
     1148           undo, return error return-value .
     1149         end.
     1150         create buf_temp-goods .
     1151         assign
     1152           buf_temp-goods.artic     = p-artic
     1153           buf_temp-goods.prod-type = p-prod-type
     1154           buf_temp-goods.prod-code = p-prod-code
     1155           buf_temp-goods.gds-code  = buf_goods.gds-code
     1156         .
     1157       end.
     1158       assign
     1159         p-gds-code = buf_temp-goods.gds-code
     1160       .
     1161     end.
     1162   end procedure.
