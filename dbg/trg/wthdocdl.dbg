     3613             and buf-recalc-cli-doc.cli-code = tt-parts-cli-doc.cli-code
     3614             and buf-recalc-cli-doc.host-code     = tt-parts-cli-doc.host-code
     3615             and buf-recalc-cli-doc.contract-code = tt-parts-cli-doc.contract-code
     3616             and buf-recalc-cli-doc.gds-code      = tt-parts-cli-doc.gds-code
     3617             and buf-recalc-cli-doc.obj-type      = tt-parts-cli-doc.obj-type
     3618             and buf-recalc-cli-doc.obj-code      = tt-parts-cli-doc.obj-code
     3619             and buf-recalc-cli-doc.w-p-code      = tt-parts-cli-doc.w-p-code
