     3476   procedure wth-arhdoc-delete:
     3477    define input parameter pardoc-code as char no-undo.
     3478     do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     3479     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
     3480     if not available buf-arh_wth-doc then do:
     3481       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
     3482     end.
     3483     if buf-arh_wth-doc.status_ <> 'факт':U then do:
     3484       return error substitute ("Документ МЦ с номером &1 не в статусе факт. Создание архивов невозможно.", pardoc-code).
     3485     end.
     3486     if buf-arh_wth-doc.fact-order = 0 or
     3487       buf-arh_wth-doc.fact-order = ? then do:
     3488       return error substitute ("В документе МЦ с номером &1 не проставлен fact-order.", buf-arh_wth-doc.doc-code).
     3489     end.
     3490     run wth-arh-calctt-loc(input buf-arh_wth-doc.doc-code
     3491                           ,input no) no-error.
     3492     if error-status:error then  return error return-value + error-status:get-message(1).
     3493     for each  tt-parts-tot on error undo, return error return-value:
     3494         find first  buf-arh-wth-tot where buf-arh-wth-tot.wth-code =  tt-parts-tot.wth-code
     3495                                           and buf-arh-wth-tot.par-code =  tt-parts-tot.par-code
     3496                                           and buf-arh-wth-tot.obj-type = tt-parts-tot.obj-type
     3497                                           and buf-arh-wth-tot.obj-code = tt-parts-tot.obj-code
     3498                                           and buf-arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3499                                           and buf-arh-wth-tot.sum-type = tt-parts-tot.sum-type
     3500                                           and buf-arh-wth-tot.fact-order = buf-arh_wth-doc.fact-order
     3501                                           no-error.
     3502         if available buf-arh-wth-tot then do:
     3503             delete buf-arh-wth-tot.
     3504         end.
     3505         for each buf-recalc-tot where buf-recalc-tot.fact-order > buf-arh_wth-doc.fact-order
     3506               and buf-recalc-tot.wth-code = tt-parts-tot.wth-code
     3507               and buf-recalc-tot.par-code = tt-parts-tot.par-code
     3508               and buf-recalc-tot.obj-type = tt-parts-tot.obj-type
     3509               and buf-recalc-tot.obj-code = tt-parts-tot.obj-code
     3510               and buf-recalc-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3511               and buf-recalc-tot.sum-type = tt-parts-tot.sum-type
     3512                :
     3513               assign buf-recalc-tot.out-qnty     = buf-recalc-tot.out-qnty - tt-parts-tot.out-qnty
     3514                     buf-recalc-tot.out-sum-rubl = buf-recalc-tot.out-sum-rubl - tt-parts-tot.out-sum-rubl
     3515                     buf-recalc-tot.out-sum-base = buf-recalc-tot.out-sum-base - tt-parts-tot.out-sum-base
     3516                     buf-recalc-tot.in-qnty       = buf-recalc-tot.in-qnty - tt-parts-tot.in-qnty
     3517                     buf-recalc-tot.in-sum-rubl = buf-recalc-tot.in-sum-rubl - tt-parts-tot.in-sum-rubl
     3518                     buf-recalc-tot.in-sum-base = buf-recalc-tot.in-sum-base - tt-parts-tot.in-sum-base
     3519                     .
     3520         end.
     3521     end.
     3522     for each  tt-parts-wp on error undo, return error return-value:
     3523         find first  buf-arh-wth-wp where buf-arh-wth-wp.wth-code =  tt-parts-wp.wth-code
     3524                                           and buf-arh-wth-wp.par-code =  tt-parts-wp.par-code
     3525                                           and buf-arh-wth-wp.obj-type = tt-parts-wp.obj-type
     3526                                           and buf-arh-wth-wp.obj-code = tt-parts-wp.obj-code
     3527                                           and buf-arh-wth-wp.out-code = tt-parts-wp.out-code
     3528                                           and buf-arh-wth-wp.w-p-code = tt-parts-wp.w-p-code
     3529                                           and buf-arh-wth-wp.sum-type = tt-parts-wp.sum-type
     3530                                           and buf-arh-wth-wp.fact-order = buf-arh_wth-doc.fact-order
     3531                                           no-error.
     3532         if available buf-arh-wth-wp then do:
     3533             delete buf-arh-wth-wp.
     3534         end.
     3535         for each buf-recalc-wp where buf-recalc-wp.fact-order > buf-arh_wth-doc.fact-order
     3536               and buf-recalc-wp.wth-code = tt-parts-wp.wth-code
     3537               and buf-recalc-wp.par-code = tt-parts-wp.par-code
     3538               and buf-recalc-wp.obj-type = tt-parts-wp.obj-type
     3539               and buf-recalc-wp.obj-code = tt-parts-wp.obj-code
     3540               and buf-recalc-wp.out-code = tt-parts-wp.out-code
     3541               and buf-recalc-wp.w-p-code = tt-parts-wp.w-p-code
     3542               and buf-recalc-wp.sum-type = tt-parts-wp.sum-type
     3543                :
     3544               assign buf-recalc-wp.out-qnty     = buf-recalc-wp.out-qnty - tt-parts-wp.out-qnty
     3545                     buf-recalc-wp.out-sum-rubl = buf-recalc-wp.out-sum-rubl - tt-parts-wp.out-sum-rubl
