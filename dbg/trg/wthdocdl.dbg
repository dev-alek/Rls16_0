     1109            input-output shift-name      ,
     1110            input        yes
     1111            ) no-error .
     1112         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1113         v-fact-date = p-doc-date .
     1114         run factord in this-procedure
     1115           (input  v-fact-date
     1116           ,input  v-fact-time
     1117           ,input  v-fact-time
     1118           ,input  shift-date
     1119           ,input  shift-num
     1120           ,input  l-shift-on
     1121           ,output v-fact-order
     1122           ,output v-shift-end-fact-order
