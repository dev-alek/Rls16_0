     1297     )  .
     1298     v-cli-oborot-ALL  = 0 .
     1299     for each buf_turnover-buyer-main no-lock  where
     1300              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1301              buf_turnover-buyer-main.cli-code = p-cli-code
     1302              :
     1303              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1304     end.
     1305   for each buf_price-all no-lock where
     1306            buf_price-all.obj-type = p-obj-type and
     1307            buf_price-all.obj-code = p-obj-code and
     1308            buf_price-all.gds-code = buf_goods.gds-code and
     1309            buf_price-all.status_  = 'акт':U  and
     1310          ( p-only-b-code = false   or
     1311          ( buf_price-all.b-code = p-main-b-code or
     1312            buf_price-all.b-code = p-b-code))    and
     1313           ( p-only-b-code = true  or
     1314             buf_price-all.b-code = p-b-code)
     1315             and
     1316             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1317           ( buf_price-all.fact-order-sys-to = ? or
     1318             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1319           :
     1320            v-interv   = "" .
     1321            v-grp-name = "" .
     1322            v-pay-name = "" .
     1323            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1324            if buf_price-all.bgr-id > 0 then do:
     1325               find first buf_buyer-group no-lock where
     1326                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1327                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1328               if available buf_buyer-group then do:
     1329                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1330                  find first buf_buyer-in-buyer-group no-lock where
     1331                             buf_buyer-in-buyer-group.stts         = 0 and
     1332                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1333                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1334                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1335                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1336                             no-error .
     1337                             if not available buf_buyer-in-buyer-group then do:
     1338                                v-grp-name = "".
     1339                                next.
     1340                             end.
     1341                             v-grp-name = buf_buyer-group.name .
     1342                  end.
     1343               end.
     1344               else do:
     1345                    v-grp-name = "".
     1346                    next.
     1347               end.
     1348            end.
     1349            if buf_price-all.tog-id > 0 then do:
     1350               find first buf_turnover-group no-lock where
     1351                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1352                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1353               if available buf_turnover-group then do:
     1354                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1355                     v-cli-oborot = v-cli-oborot-all  .
     1356                     find first buf1_tnv-in-turnover-group no-lock where
     1357                                buf1_tnv-in-turnover-group.stts       =  0     and
     1358                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1359                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1360                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1361                     find first buf2_tnv-in-turnover-group no-lock where
     1362                                buf2_tnv-in-turnover-group.stts       =  0     and
     1363                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1364                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1365                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1366                     if not (available buf1_tnv-in-turnover-group and
     1367                             available buf2_tnv-in-turnover-group ) then do:
     1368                             v-grp-name = "".
     1369                             next .
     1370                     end.
     1371                     v-grp-name = buf_turnover-group.name.
     1372                  end.
     1373               end.
     1374               else do:
     1375                    v-grp-name = "".
     1376                    next.
     1377               end.
     1378            end.
     1379            if buf_price-all.plt-fix-cource-crc-base = true then
     1380               assign
     1381                 v-base-rate  = buf_price-all.pdf-base-rate
     1382                 v-base-scale = buf_price-all.pdf-base-scale
     1383               .
     1384               else
     1385               assign
     1386                 v-base-rate  = v-base-rate0
     1387                 v-base-scale = v-base-scale0
     1388               .
     1389            if buf_price-all.plt-fix-cource-crc-doc = true then
     1390               assign
     1391                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1392                 v-exch-scale = buf_price-all.pdf-exch-scale
     1393               .
     1394               else do:
     1395   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1397     (input  buf_price-all.curr-code
     1398     ,input  to-day
     1399     ,output v-exch-rate0
     1400     ,output v-exch-scale0
     1401     ,output v-curr-abbr
     1402     )  .
     1403               assign
     1404                 v-exch-rate  = v-exch-rate0
     1405                 v-exch-scale = v-exch-scale0
     1406                 .
     1407              end.
     1408              v-date-1 = date ( "" )  .
     1409              if buf_price-all.fact-order-sys-from > 0 then do:
     1410                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1411                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1412                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1413              end.
     1414              v-date-2 =  date ( "" )  .
     1415              if buf_price-all.fact-order-sys-to > 0 then do:
     1416                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1417                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1418                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1419              end.
     1420              if buf_price-all.qnty-from <> ? then do :
     1421                 if not (
     1422                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1423                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1424                 ) then do:
     1425                        v-interv = "".
     1426                        next.
     1427                 end.
     1428                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1429              end.
     1430              if buf_price-all.sum-from <> ? then do :
     1431                 if not (
     1432                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1433                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1434                 ) then do:
     1435                    v-interv = "".
     1436                    next.
     1437                 end.
     1438                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1439              end.
     1440              if buf_price-all.turnover-from <> ? then do :
     1441                 if not (
     1442                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1443                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1444                 ) then do:
     1445                    v-interv = "".
     1446                    next.
     1447                 end.
     1448                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1449              end.
     1450              if buf_price-all.use-pay-type = 1 then do :
     1451                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1452                    v-pay-name = "" .
     1453                    next.
     1454                  end.
     1455                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1456              end.
     1457              if buf_price-all.use-cash-pay = 1 then do :
     1458                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1459                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1460                   v-pay-name = "" .
     1461                   next.
     1462                 end.
     1463                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1464              end.
     1465             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1466             create tt_price-all .
     1467             buffer-copy buf_price-all to tt_price-all
     1468             assign
     1469               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1470               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1471               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1472               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1473               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1474               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1475               tt_price-all.price-sale     = buf_price-all.price-sale
     1476               tt_price-all.road-tax       = buf_price-all.road-tax
     1477               tt_price-all.excise         = buf_price-all.excise
     1478               tt_price-all.pdf-exch-rate   = v-exch-rate
     1479               tt_price-all.pdf-exch-scale  = v-exch-scale
     1480               tt_price-all.pdf-base-rate   = v-base-rate
     1481               tt_price-all.pdf-base-scale  = v-base-scale
     1482               tt_price-all.grp-name        = v-grp-name
     1483               tt_price-all.date-1          = v-date-1
     1484               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1485               tt_price-all.time-1          = buf_price-all.start-sys-time
     1486               tt_price-all.date-2          = v-date-2
     1487               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1488               tt_price-all.time-2          = buf_price-all.end-sys-time
     1489               tt_price-all.interv-name     = v-interv
     1490               tt_price-all.pay-name        = v-pay-name
     1491               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1492             .
     1493   end.
     1494   define variable vt-plt-id as integer   no-undo .
     1495   define variable vt-plt-db as integer   no-undo .
     1496   define variable vt-pdf-id as integer   no-undo .
     1497   define variable vt-pdf-db as integer   no-undo .
     1498   define buffer neos_price-all for tt_price-all  .
     1499   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1500       if available tt_price-all then do:
     1501        assign
     1502          vt-plt-id = tt_price-all.plt-id
     1503          vt-plt-db = tt_price-all.plt-db-num
     1504          vt-pdf-id = tt_price-all.pdf-id
     1505          vt-pdf-db = tt_price-all.pdf-db
     1506        .
     1507        if tt_price-all.b-code = p-b-code then do:
     1508             assign
     1509               p-plt-id           = tt_price-all.plt-id
     1510               p-plt-db-num       = tt_price-all.plt-db-num
     1511               p-pdf-id           = tt_price-all.pdf-id
     1512               p-pdf-db-num       = tt_price-all.pdf-db
     1513               p-sale-price-base  = tt_price-all.price-sale-base
     1514               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1515               p-road-tax-base    = tt_price-all.road-tax-base
     1516               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1517               p-excise-base      = tt_price-all.excise-base
     1518               p-excise-rubl      = tt_price-all.excise-rubl
     1519               .
     1520        end.
     1521        else do:
     1522          find first neos_price-all where
     1523                     neos_price-all.b-code     = p-b-code  and
     1524                     neos_price-all.plt-id     = vt-plt-id and
     1525                     neos_price-all.plt-db-num = vt-plt-db and
     1526                     neos_price-all.pdf-id     = vt-pdf-id and
     1527                     neos_price-all.pdf-db     = vt-pdf-db
     1528                     use-index pi no-error .
     1529            if available neos_price-all then do:
     1530             assign
     1531               p-plt-id           = tt_price-all.plt-id
     1532               p-plt-db-num       = tt_price-all.plt-db-num
     1533               p-pdf-id           = tt_price-all.pdf-id
     1534               p-pdf-db-num       = tt_price-all.pdf-db
     1535               p-sale-price-base  = neos_price-all.price-sale-base
     1536               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1537               p-road-tax-base    = neos_price-all.road-tax-base
     1538               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1539               p-excise-base      = neos_price-all.excise-base
     1540               p-excise-rubl      = neos_price-all.excise-rubl
     1541               .
     1542            end.
     1543            else do:
     1544                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1545                 if error-status :error    then do:
     1546                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1547                   return error return-value .
     1548                 end.
     1549             assign
     1550               p-plt-id           = tt_price-all.plt-id
     1551               p-plt-db-num       = tt_price-all.plt-db-num
     1552               p-pdf-id           = tt_price-all.pdf-id
     1553               p-pdf-db-num       = tt_price-all.pdf-db
     1554               p-sale-price-base  = tt_price-all.price-sale-base
     1555               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1556               p-road-tax-base    = tt_price-all.road-tax-base
     1557               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1558               p-excise-base      = tt_price-all.excise-base
     1559               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1560               .
     1561            end.
     1562        end.
     1563     end.
     1564   end.
     1565   end procedure.
     1566   procedure mpl-tpl-auto :
     1567   define input  parameter p-b-code     as integer   no-undo .
     1568   define input  parameter p-obj-type   as character no-undo .
     1569   define input  parameter p-obj-code   as integer   no-undo .
     1570   define input  parameter p-plt-id     as integer   no-undo .
     1571   define input  parameter p-plt-db-num as integer   no-undo .
     1572   define input  parameter p-fact-order as decimal   no-undo .
     1573   define output parameter p-sale-price as decimal   no-undo .
     1574   define output parameter p-pdf-id     as integer   no-undo .
     1575   define output parameter p-pdf-db-num as integer   no-undo .
     1576     do
     1577     on error undo, return error return-value
     1578     :
     1579   if p-fact-order = ? then do:
     1580     run fact-order-mpl (
     1581         input   today       ,
     1582         input   p-obj-type  ,
     1583         input   p-obj-code  ,
     1584         output  p-fact-order ) .
     1585   end.
     1586   assign
     1587     p-pdf-id      = ?
     1588     p-pdf-db-num  = ?
     1589     p-sale-price  = ?
     1590   .
     1591   define buffer buf_bar-code for ub.bar-code  .
     1592   define buffer buf_goods for ub.goods  .
     1593   find first buf_bar-code no-lock where
     1594              buf_bar-code.b-code = p-b-code
     1595              no-error .
     1596   if error-status :error then return error return-value .
     1597   find first buf_goods no-lock where
     1598              buf_goods.gds-code = buf_bar-code.gds-code
     1599              no-error .
     1600   if error-status :error then return error return-value .
     1601   define variable v-main-b-code as integer   no-undo .
     1602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1603     (input  buf_goods.gds-code
     1604     ,input  ?
     1605     ,output v-main-b-code
     1606     )  .
     1607   define buffer buf_price-all for ub.price-all  .
     1608   for each tt_price-all : delete tt_price-all. end.
     1609       for each buf_price-all no-lock where
     1610               buf_price-all.plt-id     = p-plt-id                 and
     1611               buf_price-all.plt-db-num = p-plt-db-num             and
     1612               buf_price-all.obj-type   = p-obj-type               and
     1613               buf_price-all.obj-code   = p-obj-code               and
     1614               buf_price-all.gds-code   = buf_goods.gds-code       and
     1615             ( buf_price-all.b-code = v-main-b-code or
     1616               buf_price-all.b-code = p-b-code)    and
     1617               buf_price-all.status_    = 'акт':U         and
     1618               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1619             ( buf_price-all.fact-order-sys-to = ? or
     1620               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1621               :
     1622                 create tt_price-all .
     1623                 buffer-copy buf_price-all to tt_price-all
     1624                 assign
     1625                   tt_price-all.price-sale  = buf_price-all.price-sale
     1626                 .
     1627       end.
     1628   define variable vt-plt-id as integer   no-undo .
     1629   define variable vt-plt-db as integer   no-undo .
     1630   define variable vt-pdf-id as integer   no-undo .
     1631   define variable vt-pdf-db as integer   no-undo .
     1632   define buffer neos_price-all for tt_price-all  .
     1633   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1634       if available tt_price-all then do:
     1635        assign
     1636          vt-plt-id = tt_price-all.plt-id
     1637          vt-plt-db = tt_price-all.plt-db-num
     1638          vt-pdf-id = tt_price-all.pdf-id
     1639          vt-pdf-db = tt_price-all.pdf-db
     1640        .
     1641        if tt_price-all.b-code = p-b-code then do:
     1642             assign
     1643               p-plt-id           = tt_price-all.plt-id
     1644               p-plt-db-num       = tt_price-all.plt-db-num
     1645               p-pdf-id           = tt_price-all.pdf-id
     1646               p-pdf-db-num       = tt_price-all.pdf-db
     1647               p-sale-price       = tt_price-all.price-sale
     1648               .
     1649        end.
     1650        else do:
     1651          find first neos_price-all where
     1652                     neos_price-all.b-code     = p-b-code  and
     1653                     neos_price-all.plt-id     = vt-plt-id and
     1654                     neos_price-all.plt-db-num = vt-plt-db and
     1655                     neos_price-all.pdf-id     = vt-pdf-id and
     1656                     neos_price-all.pdf-db     = vt-pdf-db
     1657                     use-index pi no-error .
     1658            if available neos_price-all then do:
     1659             assign
     1660               p-plt-id           = tt_price-all.plt-id
     1661               p-plt-db-num       = tt_price-all.plt-db-num
     1662               p-pdf-id           = tt_price-all.pdf-id
     1663               p-pdf-db-num       = tt_price-all.pdf-db
     1664               p-sale-price       = neos_price-all.price-sale
     1665               .
     1666            end.
     1667            else do:
     1668           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1669           if error-status :error    then do:
     1670              message "Не найден бар-код" p-b-code view-as alert-box error .
     1671              return error return-value .
     1672           end.
     1673             assign
     1674               p-plt-id           = tt_price-all.plt-id
     1675               p-plt-db-num       = tt_price-all.plt-db-num
     1676               p-pdf-id           = tt_price-all.pdf-id
     1677               p-pdf-db-num       = tt_price-all.pdf-db
     1678               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1679               .
     1680            end.
     1681        end.
     1682     end.
     1683     end.
     1684   end procedure.
     1685   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1686   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1687   procedure wthcattr-sprcli :
     1688   define input parameter parparentproc  as widget-handle no-undo.
     1689   define input parameter p-mode  as character no-undo.
     1690   define input-output parameter p-value as character no-undo .
     1691   define output parameter p-setted as logical no-undo .
     1692     DEFINE VARIABLE v-value as character no-undo .
     1693     define variable v-cli-type as character no-undo .
     1694     define variable v-cli-code as integer no-undo .
     1695     define buffer buf_clients   for ub.clients.
     1696     define variable v_rid as character no-undo.
     1697     define variable ref-rec as recid no-undo .
     1698     do
     1699     on error undo, return error
     1700     :
     1701         v-value = p-value.
     1702      if p-value <> '':U then do:
     1703       assign
     1704       v-cli-type = substring(p-value, 1, 3)
     1705       v-cli-code = integer(substring(p-value, 4))
     1706       no-error.
     1707       if error-status:error then do:
     1708         assign
     1709         v-cli-type = '':U
     1710         v-cli-code = 0
     1711         .
     1712       end.
     1713      end.
     1714      FIND FIRST buf_clients NO-LOCK WHERE
     1715               buf_clients.obj-type = v-cli-type AND
     1716               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1717      IF available(buf_clients) then do:
     1718       run ref/cli-all.w (
     1719                   input parparentproc
     1720                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1721                  ,input v-cli-type
     1722                  ,input 'все':U
     1723                  ,input 'все':U
     1724                  ,input RECID( buf_clients )
     1725                  ,input ",,,,,,NO"
     1726                  ,input ?
     1727                  ,OUTPUT v_rid ).
     1728     END.
     1729     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1730       run ref/cli-all.w (
     1731                    input parparentproc
     1732                   ,INPUT "b-sel":U
     1733                  ,input  v-cli-type
     1734                  ,input 'все':U
     1735                  ,input 'текущие':U
     1736                  ,input ?
     1737                  ,input ",,,,,,NO"
     1738                  ,input ?
     1739                  ,OUTPUT v_rid ).
     1740     END.
     1741     else do:
     1742       message
     1743       if p-value = "":U then 'Атрибут не задан!'
     1744       else substitute('Не найден клиент &1',p-value)
     1745       view-as alert-box warning.
     1746     end.
     1747     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1748       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1749       IF ERROR-STATUS:ERROR THEN DO:
     1750           RETURN NO-APPLY.
     1751       END.
     1752       FIND FIRST buf_clients NO-LOCK WHERE
     1753                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1754       IF AVAIL buf_clients THEN DO:
     1755         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1756       end.
     1757     end.
     1758     if v-value <> p-value then do:
     1759       p-value = v-value.
     1760       p-setted = yes.
     1761     end.
     1762     end.
     1763   end procedure.
     1764     define new global shared variable g#wthcalib as handle no-undo.
     1765   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1766   define variable v-tth as handle no-undo .
     1767   assign
     1768   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1769   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     1770   Procedure wth-doc-close:
     1771       define input parameter p-rec        as recid     no-undo .
     1772       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1773     do
     1774     on error undo, return error return-value
     1775     :
     1776       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     1777       if not available cur-wth-parts then return error substitute("Не найдена партия").
     1778       CASE cur-wth-parts.ext-doc-type:
     1779           WHEN 'ie':U or when 'rf':U or when 'ff':U
     1780           OR WHEN 'fj':U
     1781           THEN DO:
     1782              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     1783           END.
     1784           WHEN 'ee':U THEN DO:
     1785               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1786           END.
     1787           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     1788             OR WHEN 'ip':U OR WHEN 'pc':U
     1789             OR WHEN 'pj':U
     1790              THEN DO:
     1791               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1792           END.
     1793           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     1794             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     1795           end.
     1796           when 'ep':U or when 'ef':U
     1797           OR WHEN 'oj':U or when 'jj':U
     1798           then .
     1799           when 'xc':U then do:
     1800             if cur-wth-parts.type = 'при':U then
     1801                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1802             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1803           end.
     1804           OTHERWISE DO:
     1805               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     1806                                    , cur-wth-parts.ext-doc-type
     1807                                       ).
     1808           END.
     1809       END CASE.
     1810       RELEASE cur-wth-parts.
     1811       END.
     1812   END.
     1813   PROCEDURE wth-parts-close:
     1814       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1815       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1816       define variable v-rec as recid.
     1817       if bfrom_wth-parts.stts  = 1 then return.
     1818          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     1819                     INPUT     bfrom_wth-parts.obj-type,
     1820                     INPUT     bfrom_wth-parts.obj-code,
     1821                     INPUT     bfrom_wth-parts.w-p-code,
     1822                     INPUT     bfrom_wth-parts.wth-code,
     1823                     INPUT     bfrom_wth-parts.par-code,
     1824                     INPUT     bfrom_wth-parts.in-code ,
     1825                     INPUT     p-zone,
     1826                     INPUT     bfrom_wth-parts.ser-code,
     1827                     INPUT     bfrom_wth-parts.db-num  ,
     1828                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1829                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     1830                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1831                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     1832                     INPUT     bfrom_wth-parts.host-code     ,
     1833                     INPUT     bfrom_wth-parts.contract-code               ,
     1834                     INPUT     bfrom_wth-parts.price-rubl    ,
     1835                     INPUT     bfrom_wth-parts.price-base    ,
     1836                     INPUT     bfrom_wth-parts.supp-type,
     1837                     INPUT     bfrom_wth-parts.supp-code,
     1838                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1839                     INPUT     bfrom_wth-parts.in-obj-code      ,
     1840                     INPUT     bfrom_wth-parts.ext-doc-type,
     1841                     INPUT     bfrom_wth-parts.gds-code,
     1842                     INPUT     bfrom_wth-parts.stts               ,
     1843                     INPUT     bfrom_wth-parts.beg-dt        ,
     1844                     INPUT     bfrom_wth-parts.end-dt        ,
     1845                     INPUT     bfrom_wth-parts.vat-pc        ,
     1846                     INPUT     bfrom_wth-parts.cli-code,
     1847                     INPUT     bfrom_wth-parts.cli-type,
     1848                     INPUT     bfrom_wth-parts.out-obj-code,
     1849                     INPUT     bfrom_wth-parts.out-obj-type,
     1850                     INPUT     bfrom_wth-parts.sale-obj-code,
     1851                     INPUT     bfrom_wth-parts.sale-obj-type,
     1852                     INPUT     bfrom_wth-parts.out-code ,
     1853                     INPUT  yes,
     1854                     INPUT     '':U ,
     1855                     INPUT-OUTPUT v-rec
     1856                     ) no-error.
     1857       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     1858   END.
     1859   Procedure wth-doc-razrez:
     1860       define input parameter p-rec as recid NO-UNDO.
     1861       define input parameter p-doc-del AS log NO-UNDO.
     1862       define variable v-mess AS CHAR NO-UNDO.
     1863       define variable p-silent AS LOG INIT NO NO-UNDO.
     1864       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     1865       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1866       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1867     do
     1868     on error undo, return error return-value
     1869     :
     1870       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     1871                                 EXCLUSIVE-LOCK .
     1872       IF AVAILABLE cur-wth-parts THEN DO:
     1873           CASE cur-wth-parts.ext-doc-type:
     1874               WHEN 'ie':U or when 'ip':U or when 'rp':U
     1875               or when 'ff':U or when 'rf':U
     1876               or when 'fj':U or when 'pj':U
     1877               THEN DO:
     1878                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     1879               END.
     1880               WHEN 'ee':U or when 'ef':U or when 'jj':U
     1881               THEN DO:
     1882                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     1883               END.
     1884               WHEN 'ep':U or when 'oj':U THEN DO:
     1885                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     1886               END.
     1887               WHEN 'pc':U THEN DO:
     1888                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1889               END.
     1890               WHEN 'dp':U THEN DO:
     1891                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     1892               END.
     1893               WHEN 'df':U THEN DO:
     1894                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     1895               END.
     1896               WHEN 'dc':U THEN DO:
     1897                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1898               END.
     1899               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     1900                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     1901               END.
     1902               when 'xc':U then do:
     1903                 if cur-wth-parts.type = 'при':U then
     1904                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     1905                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     1906               end.
     1907               OTHERWISE DO:
     1908                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     1909                                        , cur-wth-parts.ext-doc-type
     1910                                        , error-status:get-message(1)
     1911                                        , return-value
     1912                                        ).
     1913               END.
     1914           END CASE.
     1915       END.
     1916     END.
     1917   END.
     1918   PROCEDURE wth-parts-raz:
     1919       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1920       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1921       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     1922       define variable v-mes as char no-undo.
     1923       define variable v-rec as recid no-undo.
     1924       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1925     do
     1926     on error undo, return error return-value
     1927     :
     1928       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     1929                                      ,bfrom_wth-parts.ser-code
     1930                                      ,bfrom_wth-parts.db-num
     1931                                      ,bfrom_wth-parts.doc-rangeFrom
     1932                                      ,bfrom_wth-parts.doc-rangeTo).
     1933       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     1934           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     1935                                , error-status:get-message(1)
     1936                                , bfrom_wth-parts.out-code
     1937                                , return-value
     1938                                ,chr(10)
     1939                                ,v-mes
     1940                                ).
     1941       END.
     1942       v-rec = recid(bfrom_wth-parts).
     1943       CASE bfrom_wth-parts.ext-doc-type:
     1944           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     1945               delete bfrom_wth-parts NO-ERROR.
     1946               if error-status:error then do:
     1947                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1948                                      , error-status:get-message(1)
     1949                                      , chr(10)
     1950                                      , return-value
     1951                                      ,v-mes
     1952                                      ).
     1953               END.
     1954           END.
     1955           when 'rp':U or when 'rf':U then do:
     1956             if p-doc-del then do:
     1957               delete bfrom_wth-parts NO-ERROR.
     1958               if error-status:error then do:
     1959                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1960                                      , error-status:get-message(1)
     1961                                      , chr(10)
     1962                                      , return-value
     1963                                      ,v-mes
     1964                                      ).
     1965               END.
     1966             end.
     1967             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     1968           end.
     1969           when 'ip':U or when 'ff':U then do:
     1970             if p-doc-del then do:
     1971               delete bfrom_wth-parts NO-ERROR.
     1972               if error-status:error then do:
     1973                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1974                                      , error-status:get-message(1)
     1975                                      , chr(10)
     1976                                      , return-value
     1977                                      ,v-mes
     1978                                      ).
     1979               END.
     1980             end.
     1981             else do:
     1982               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     1983                     INPUT     bfrom_wth-parts.obj-type,
     1984                     INPUT     bfrom_wth-parts.obj-code,
     1985                     INPUT     bfrom_wth-parts.w-p-code,
     1986                     INPUT     bfrom_wth-parts.wth-code,
     1987                     INPUT     bfrom_wth-parts.par-code,
     1988                     INPUT     bfrom_wth-parts.in-code ,
     1989                     INPUT     bfrom_wth-parts.out-code,
     1990                     INPUT     bfrom_wth-parts.ser-code,
     1991                     INPUT     bfrom_wth-parts.db-num  ,
     1992                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1993                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     1994                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     1995                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     1996                     INPUT     bfrom_wth-parts.host-code     ,
     1997                     INPUT     bfrom_wth-parts.contract-code ,
     1998                     INPUT     bfrom_wth-parts.price-rubl    ,
     1999                     INPUT     bfrom_wth-parts.price-base    ,
     2000                     INPUT     bfrom_wth-parts.supp-type,
     2001                     INPUT     bfrom_wth-parts.supp-code,
     2002                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2003                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2004                     INPUT     bfrom_wth-parts.ext-doc-type,
     2005                     INPUT     bfrom_wth-parts.gds-code,
     2006                     INPUT     1            ,
     2007                     INPUT     bfrom_wth-parts.beg-dt        ,
     2008                     INPUT     bfrom_wth-parts.end-dt        ,
     2009                     INPUT     bfrom_wth-parts.vat-pc        ,
     2010                     INPUT     bfrom_wth-parts.cli-code,
     2011                     INPUT     bfrom_wth-parts.cli-type,
     2012                     INPUT     bfrom_wth-parts.out-obj-code,
     2013                     INPUT     bfrom_wth-parts.out-obj-type,
     2014                     INPUT     bfrom_wth-parts.sale-obj-code,
     2015                     INPUT     bfrom_wth-parts.sale-obj-type,
     2016                     INPUT     bfrom_wth-parts.doc-code ,
     2017                     INPUT  yes,
     2018                     INPUT     bfrom_wth-parts.type ,
     2019                     INPUT-OUTPUT v-rec
     2020                     ) no-error.
     2021                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2022             end.
     2023           end.
     2024           OTHERWISE DO:
     2025            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2026                     INPUT     bfrom_wth-parts.obj-type,
     2027                     INPUT     bfrom_wth-parts.obj-code,
     2028                     INPUT     bfrom_wth-parts.w-p-code,
     2029                     INPUT     bfrom_wth-parts.wth-code,
     2030                     INPUT     bfrom_wth-parts.par-code,
     2031                     INPUT     bfrom_wth-parts.in-code ,
     2032                     INPUT     p-zone,
     2033                     INPUT     bfrom_wth-parts.ser-code,
     2034                     INPUT     bfrom_wth-parts.db-num  ,
     2035                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2036                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2037                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2038                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2039                     INPUT     bfrom_wth-parts.host-code     ,
     2040                     INPUT     bfrom_wth-parts.contract-code ,
     2041                     INPUT     bfrom_wth-parts.price-rubl    ,
     2042                     INPUT     bfrom_wth-parts.price-base    ,
     2043                     INPUT     bfrom_wth-parts.supp-type,
     2044                     INPUT     bfrom_wth-parts.supp-code,
     2045                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2046                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2047                     INPUT     bfrom_wth-parts.ext-doc-type,
     2048                     INPUT     bfrom_wth-parts.gds-code,
     2049                     INPUT     bfrom_wth-parts.stts             ,
     2050                     INPUT     bfrom_wth-parts.beg-dt        ,
     2051                     INPUT     bfrom_wth-parts.end-dt        ,
     2052                     INPUT     bfrom_wth-parts.vat-pc        ,
     2053                     INPUT     bfrom_wth-parts.cli-code,
     2054                     INPUT     bfrom_wth-parts.cli-type,
     2055                     INPUT     bfrom_wth-parts.out-obj-code,
     2056                     INPUT     bfrom_wth-parts.out-obj-type,
     2057                     INPUT     bfrom_wth-parts.sale-obj-code,
     2058                     INPUT     bfrom_wth-parts.sale-obj-type,
     2059                     INPUT     bfrom_wth-parts.doc-code ,
     2060                     INPUT  yes,
     2061                     INPUT      "":U ,
     2062                     INPUT-OUTPUT v-rec
     2063                     ) no-error.
     2064       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2065           END.
     2066       END CASE.
     2067     END.
     2068   END.
     2069   procedure wth-parts-rezerv:
     2070       define input parameter        p-param            as logical no-undo.
     2071       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2072       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2073       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2074       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2075       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2076       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2077       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2078       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2079       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2080       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2081       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2082       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2083       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2084       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2085       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2086       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2087       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2088       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2089       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2090       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2091       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2092       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2093       define input-output parameter p-rec        as recid     no-undo .
     2094     define buffer bfrom_wth-parts   for ub.wth-parts.
     2095     define buffer bufr_wth-doc      for ub.wth-doc.
     2096     define variable v-rec    as recid        no-undo.
     2097     define variable v-recDop as recid        no-undo.
     2098     define variable v-zone   as character    no-undo.
     2099     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2100     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2101     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2102     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2103     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2104     define variable v-mpl-date         as date      no-undo.
     2105     empty temp-table tt-wthlib-parts.
     2106   main-block:
     2107   do  transaction
     2108   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2109   on stop   undo main-block, return error
     2110   on endkey undo main-block, return error
     2111   :
     2112   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2113   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2114     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2115           then do:
     2116        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2117                     INPUT  p-obj-type,
     2118                     INPUT  p-obj-code,
     2119                     INPUT  p-w-p-code,
     2120                     INPUT  p-wth-code,
     2121                     INPUT  p-par-code,
     2122                     INPUT  p-in-code,
     2123                     INPUT  p-doc-code,
     2124                     INPUT  p-ser-code,
     2125                     INPUT  p-db-num  ,
     2126                     INPUT  p-Fact-RangeFrom ,
     2127                     INPUT  p-fact-rangeTo  ,
     2128                     INPUT  p-Fact-RangeFrom ,
     2129                     INPUT  p-fact-rangeTo ,
     2130                     INPUT  p-host-code     ,
     2131                     INPUT  0   ,
     2132                     INPUT  p-price-rubl    ,
     2133                     INPUT  p-price-base    ,
     2134                     INPUT  '':U,
     2135                     INPUT  0,
     2136                     INPUT  p-obj-type      ,
     2137                     INPUT  p-obj-code      ,
     2138                     INPUT  p-ext-doc-type,
     2139                     INPUT  p-gds-code,
     2140                     INPUT  0           ,
     2141                     INPUT  p-beg-dt        ,
     2142                     INPUT  p-end-dt        ,
     2143                     INPUT  p-vat-pc      ,
     2144                     INPUT  0,
     2145                     INPUT  '':U,
     2146                     INPUT  0,
     2147                     INPUT  '':U,
     2148                     INPUT  0,
     2149                     INPUT  '':U,
     2150                     INPUT  p-doc-code,
     2151                     INPUT  yes,
     2152                     INPUT p-type,
     2153                     INPUT-OUTPUT p-rec
     2154                     ) no-error.
     2155                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2156     end.
     2157     else do:
     2158       if p-rec <> ? then do:
     2159         find first bfrom_wth-parts exclusive-lock where
     2160                   recid(bfrom_wth-parts) = p-rec no-error.
     2161         if  available bfrom_wth-parts
     2162           and bfrom_wth-parts.wth-code = p-wth-code
     2163           and bfrom_wth-parts.par-code = p-par-code
     2164           and bfrom_wth-parts.ser-code = p-ser-code
     2165           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2166         then.
     2167         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2168         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2169                                      ,bfrom_wth-parts.ser-code
     2170                                      ,bfrom_wth-parts.db-num
     2171                                      ,bfrom_wth-parts.doc-rangeFrom
     2172                                      ,bfrom_wth-parts.doc-rangeTo).
     2173         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2174         if available bfrom_wth-parts
     2175            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2176            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2177         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2178                                            ,chr(10)
     2179                                            ,bfrom_wth-parts.doc-rangeFrom
     2180                                            ,bfrom_wth-parts.doc-rangeTo
     2181                                            ,p-fact-rangeFrom
     2182                                            ,p-fact-rangeTo).
     2183       end.
     2184       else do:
     2185         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2186           for first bfrom_wth-parts no-lock where
     2187                                     bfrom_wth-parts.wth-code = p-wth-code
     2188                                 and bfrom_wth-parts.par-code = p-par-code
     2189                                 and bfrom_wth-parts.ser-code = p-ser-code
     2190                                 and bfrom_wth-parts.db-num = p-db-num
     2191                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2192                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2193                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2194                                 and bfrom_wth-parts.stts = 0
     2195                                 and bfrom_wth-parts.cli-code = p-cli-code
     2196                                 and bfrom_wth-parts.cli-type = p-cli-type
     2197                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2198                                 use-index  wth-idnt:
     2199                                 p-rec = recid(bfrom_wth-parts).
     2200            end.
     2201           If p-rec = ? and p-in-code > '' then do:
     2202              for first bfrom_wth-parts no-lock where
     2203                                     bfrom_wth-parts.wth-code = p-wth-code
     2204                                 and bfrom_wth-parts.par-code = p-par-code
     2205                                 and bfrom_wth-parts.ser-code = p-ser-code
     2206                                 and bfrom_wth-parts.db-num = p-db-num
     2207                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2208                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2209                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2210                                 and bfrom_wth-parts.stts = 0
     2211                                 and bfrom_wth-parts.cli-code = p-cli-code
     2212                                 and bfrom_wth-parts.cli-type = p-cli-type
     2213                                 use-index  wth-idnt:
     2214                                 p-rec = recid(bfrom_wth-parts).
     2215                 end.
     2216           end.
     2217                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2218                   recid(bfrom_wth-parts) = p-rec no-error.
     2219         end.
     2220         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2221           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2222                                 and bfrom_wth-parts.par-code = p-par-code
     2223                                 and bfrom_wth-parts.ser-code = p-ser-code
     2224                                 and bfrom_wth-parts.db-num = p-db-num
     2225                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2226                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2227                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2228                                 and bfrom_wth-parts.stts = 0
     2229                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2230                                 use-index wth-idnt:
     2231                                 p-rec = recid(bfrom_wth-parts).
     2232            end.
     2233           If p-rec = ? and p-in-code > '' then do:
     2234            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2235                                 and bfrom_wth-parts.par-code = p-par-code
     2236                                 and bfrom_wth-parts.ser-code = p-ser-code
     2237                                 and bfrom_wth-parts.db-num = p-db-num
     2238                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2239                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2240                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2241                                 and bfrom_wth-parts.stts = 0
     2242                                 :
     2243                                 p-rec = recid(bfrom_wth-parts).
     2244            end.
     2245           end.
     2246           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2247                   recid(bfrom_wth-parts) = p-rec no-error.
     2248         end.
     2249         else do:
     2250           CASE p-ext-doc-type:
     2251                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2252                   or when 'jj':U THEN DO:
     2253                       v-zone = 'free-zone':U.
     2254                   END.
     2255                   WHEN 'ep':U or when 'oj':U THEN DO:
     2256                       v-zone = 'put-zone':U.
     2257                   END.
     2258                   WHEN 'df':U THEN DO:
     2259                       v-zone = 'free-zone':U.
     2260                   END.
     2261                   WHEN 'dp':U  THEN DO:
     2262                       v-zone = 'put-zone':U.
     2263                   END.
     2264                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2265                       v-zone = 'cli-zone':U.
     2266                   END.
     2267                   OTHERWISE DO:
     2268                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2269                                            , p-ext-doc-type
     2270                                               ).
     2271                   END.
     2272           END CASE.
     2273           find first bfrom_wth-parts no-lock where
     2274                                     bfrom_wth-parts.wth-code = p-wth-code
     2275                                 and bfrom_wth-parts.obj-code = p-obj-code
     2276                                 and bfrom_wth-parts.obj-type = p-obj-type
     2277                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2278                                 and bfrom_wth-parts.par-code = p-par-code
     2279                                 and bfrom_wth-parts.ser-code = p-ser-code
     2280                                 and bfrom_wth-parts.db-num = p-db-num
     2281                                 and bfrom_wth-parts.out-code = v-zone
     2282                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2283                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2284                                 and bfrom_wth-parts.stts = 0
     2285                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2286                                 no-error.
     2287          If not available bfrom_wth-parts and p-in-code > '' then do:
     2288                  find first bfrom_wth-parts no-lock where
     2289                                     bfrom_wth-parts.wth-code = p-wth-code
     2290                                 and bfrom_wth-parts.obj-code = p-obj-code
     2291                                 and bfrom_wth-parts.obj-type = p-obj-type
     2292                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2293                                 and bfrom_wth-parts.par-code = p-par-code
     2294                                 and bfrom_wth-parts.ser-code = p-ser-code
     2295                                 and bfrom_wth-parts.db-num = p-db-num
     2296                                 and bfrom_wth-parts.out-code = v-zone
     2297                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2298                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2299                                 and bfrom_wth-parts.stts = 0
     2300                                 no-error.
     2301          end.
     2302         end.
     2303       end.
     2304       if not available bfrom_wth-parts then do:
     2305            if g#news then do:
     2306             return error 'forged':U.
     2307            end.
     2308            else
     2309             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2310                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2311                                           p-fact-rangeTo).
     2312       end.
     2313       p-rec = recid(bfrom_wth-parts).
     2314       find current bfrom_wth-parts exclusive-lock.
     2315       create tt-wthlib-parts.
     2316       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2317           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2318                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2319                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2320                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2321                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2322       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2323           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2324               RUN init_prtdate ( INPUT p-obj-type
     2325                                                 ,INPUT p-obj-code
     2326                                                 ,INPUT p-ser-code
     2327                                                 ,INPUT p-db-num
     2328                                                 ,INPUT bufr_wth-doc.doc-date
     2329                                                 ,OUTPUT v-beg-dt
     2330                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2331               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2332           END.
     2333           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2334             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2335                                ,bufr_wth-doc.doc-date
     2336                                , v-beg-dt
     2337                                , output v-mpl-date) no-error.
     2338               RUN INIT_prtprice (
     2339                             p-host-code
     2340                           , p-obj-type
     2341                           , p-obj-code
     2342                           , p-cli-type
     2343                           , p-cli-code
     2344                           , p-wth-code
     2345                           , p-gds-code
     2346                           , p-par-code
     2347                           , v-mpl-date
     2348                           , OUTPUT  v-vat-pc
     2349                           , OUTPUT  v-price-rubl
     2350                           , OUTPUT  v-price-base
     2351                   ) NO-ERROR.
     2352             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2353           END.
     2354       END.
     2355         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2356                     INPUT     p-obj-type,
     2357                     INPUT     p-obj-code,
     2358                     INPUT     p-w-p-code,
     2359                     INPUT     bfrom_wth-parts.wth-code,
     2360                     INPUT     bfrom_wth-parts.par-code,
     2361                     INPUT     bfrom_wth-parts.in-code ,
     2362                     INPUT     p-doc-code,
     2363                     INPUT     bfrom_wth-parts.ser-code,
     2364                     INPUT     bfrom_wth-parts.db-num  ,
     2365                     INPUT     p-Fact-RangeFrom ,
     2366                     INPUT     p-fact-rangeTo  ,
     2367                     INPUT     p-Fact-RangeFrom ,
     2368                     INPUT     p-fact-rangeTo ,
     2369                     INPUT     bfrom_wth-parts.host-code     ,
     2370                     INPUT     bfrom_wth-parts.contract-code               ,
     2371                     INPUT     v-price-rubl ,
     2372                     INPUT     v-price-base  ,
     2373                     INPUT     bfrom_wth-parts.supp-type,
     2374                     INPUT     bfrom_wth-parts.supp-code,
     2375                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2376                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2377                     INPUT     p-ext-doc-type,
     2378                     INPUT     bfrom_wth-parts.gds-code,
     2379                     INPUT     0              ,
     2380                     INPUT     v-beg-dt    ,
     2381                     INPUT     v-end-dt   ,
     2382                     INPUT     v-vat-pc    ,
     2383                     INPUT     bfrom_wth-parts.cli-code,
     2384                     INPUT     bfrom_wth-parts.cli-type,
     2385                     INPUT     bfrom_wth-parts.out-obj-code,
     2386                     INPUT     bfrom_wth-parts.out-obj-type,
     2387                     INPUT     bfrom_wth-parts.sale-obj-code,
     2388                     INPUT     bfrom_wth-parts.sale-obj-type,
     2389                     INPUT     bfrom_wth-parts.doc-code,
     2390                     INPUT     yes,
     2391                     INPUT     p-type,
     2392                     INPUT-OUTPUT p-rec
     2393                     ) no-error.
     2394       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2395       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2396       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2397                     INPUT     tt-wthlib-parts.obj-type,
     2398                     INPUT     tt-wthlib-parts.obj-code,
     2399                     INPUT     tt-wthlib-parts.w-p-code,
     2400                     INPUT     tt-wthlib-parts.wth-code,
     2401                     INPUT     tt-wthlib-parts.par-code,
     2402                     INPUT     tt-wthlib-parts.in-code ,
     2403                     INPUT     tt-wthlib-parts.out-code,
     2404                     INPUT     tt-wthlib-parts.ser-code,
     2405                     INPUT     tt-wthlib-parts.db-num  ,
     2406                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2407                     INPUT     p-fact-rangeFrom - 1  ,
     2408                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2409                     INPUT     p-fact-rangeFrom - 1,
     2410                     INPUT     tt-wthlib-parts.host-code     ,
     2411                     INPUT     tt-wthlib-parts.contract-code               ,
     2412                     INPUT     tt-wthlib-parts.price-rubl    ,
     2413                     INPUT     tt-wthlib-parts.price-base    ,
     2414                     INPUT     tt-wthlib-parts.supp-type,
     2415                     INPUT     tt-wthlib-parts.supp-code,
     2416                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2417                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2418                     INPUT     tt-wthlib-parts.ext-doc-type,
     2419                     INPUT     tt-wthlib-parts.gds-code,
     2420                     INPUT     tt-wthlib-parts.stts               ,
     2421                     INPUT     tt-wthlib-parts.beg-dt        ,
     2422                     INPUT     tt-wthlib-parts.end-dt        ,
     2423                     INPUT     tt-wthlib-parts.vat-pc        ,
     2424                     INPUT     tt-wthlib-parts.cli-code,
     2425                     INPUT     tt-wthlib-parts.cli-type,
     2426                     INPUT     tt-wthlib-parts.out-obj-code,
     2427                     INPUT     tt-wthlib-parts.out-obj-type,
     2428                     INPUT     tt-wthlib-parts.sale-obj-code,
     2429                     INPUT     tt-wthlib-parts.sale-obj-type,
     2430                     INPUT     tt-wthlib-parts.doc-code,
     2431                     INPUT  yes,
     2432                     INPUT    tt-wthlib-parts.type,
     2433                     INPUT-OUTPUT v-recDop
     2434                     ) no-error.
     2435       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2436       end.
     2437       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2438               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2439                     INPUT     tt-wthlib-parts.obj-type,
     2440                     INPUT     tt-wthlib-parts.obj-code,
     2441                     INPUT     tt-wthlib-parts.w-p-code,
     2442                     INPUT     tt-wthlib-parts.wth-code,
     2443                     INPUT     tt-wthlib-parts.par-code,
     2444                     INPUT     tt-wthlib-parts.in-code ,
     2445                     INPUT     tt-wthlib-parts.out-code,
     2446                     INPUT     tt-wthlib-parts.ser-code,
     2447                     INPUT     tt-wthlib-parts.db-num  ,
     2448                     INPUT     p-fact-rangeTo + 1 ,
     2449                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2450                     INPUT     p-fact-rangeTo + 1 ,
     2451                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2452                     INPUT     tt-wthlib-parts.host-code     ,
     2453                     INPUT     tt-wthlib-parts.contract-code               ,
     2454                     INPUT     tt-wthlib-parts.price-rubl    ,
     2455                     INPUT     tt-wthlib-parts.price-base    ,
     2456                     INPUT     tt-wthlib-parts.supp-type,
     2457                     INPUT     tt-wthlib-parts.supp-code,
     2458                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2459                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2460                     INPUT     tt-wthlib-parts.ext-doc-type,
     2461                     INPUT     tt-wthlib-parts.gds-code,
     2462                     INPUT     tt-wthlib-parts.stts               ,
     2463                     INPUT     tt-wthlib-parts.beg-dt        ,
     2464                     INPUT     tt-wthlib-parts.end-dt        ,
     2465                     INPUT     tt-wthlib-parts.vat-pc        ,
     2466                     INPUT     tt-wthlib-parts.cli-code,
     2467                     INPUT     tt-wthlib-parts.cli-type,
     2468                     INPUT     tt-wthlib-parts.out-obj-code,
     2469                     INPUT     tt-wthlib-parts.out-obj-type,
     2470                     INPUT     tt-wthlib-parts.sale-obj-code,
     2471                     INPUT     tt-wthlib-parts.sale-obj-type,
     2472                     INPUT     tt-wthlib-parts.doc-code,
     2473                     INPUT     yes,
     2474                     INPUT     tt-wthlib-parts.type,
     2475                     INPUT-OUTPUT v-recDop
     2476                     ) no-error.
     2477         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2478       end.
     2479     end.
     2480   end.
     2481   end procedure.
     2482   procedure wth-parts-inter-edit:
     2483     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2484     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2485     define input-output parameter p-rec        as recid     no-undo .
     2486     define buffer bfrom_wth-parts   for ub.wth-parts.
     2487     define variable v-recDop as recid        no-undo.
     2488     do on error undo, return error:
     2489         find first bfrom_wth-parts exclusive-lock where
     2490                   recid(bfrom_wth-parts) = p-rec no-error.
     2491         if not available bfrom_wth-parts then return error
     2492           substitute('Не найдена партия (recid &1)', p-rec).
     2493         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     2494            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     2495            return error 'Нельзя увеличивать границы диапазона.'.
     2496         end.
     2497         empty temp-table tt-wthlib-parts.
     2498         create tt-wthlib-parts.
     2499         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2500         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2501                     INPUT     bfrom_wth-parts.obj-type,
     2502                     INPUT     bfrom_wth-parts.obj-code,
     2503                     INPUT     bfrom_wth-parts.w-p-code,
     2504                     INPUT     bfrom_wth-parts.wth-code,
     2505                     INPUT     bfrom_wth-parts.par-code,
     2506                     INPUT     bfrom_wth-parts.in-code ,
     2507                     INPUT     bfrom_wth-parts.doc-code,
     2508                     INPUT     bfrom_wth-parts.ser-code,
     2509                     INPUT     bfrom_wth-parts.db-num  ,
     2510                     INPUT     p-Fact-RangeFrom ,
     2511                     INPUT     p-fact-rangeTo  ,
     2512                     INPUT     p-Fact-RangeFrom ,
     2513                     INPUT     p-fact-rangeTo ,
     2514                     INPUT     bfrom_wth-parts.host-code     ,
     2515                     INPUT     bfrom_wth-parts.contract-code               ,
     2516                     INPUT     bfrom_wth-parts.price-rubl  ,
     2517                     INPUT     bfrom_wth-parts.price-base    ,
     2518                     INPUT     bfrom_wth-parts.supp-type,
     2519                     INPUT     bfrom_wth-parts.supp-code,
     2520                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2521                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2522                     INPUT     bfrom_wth-parts.ext-doc-type,
     2523                     INPUT     bfrom_wth-parts.gds-code,
     2524                     INPUT     0              ,
     2525                     INPUT     bfrom_wth-parts.beg-dt      ,
     2526                     INPUT     bfrom_wth-parts.end-dt      ,
     2527                     INPUT     bfrom_wth-parts.vat-pc      ,
     2528                     INPUT     bfrom_wth-parts.cli-code,
     2529                     INPUT     bfrom_wth-parts.cli-type,
     2530                     INPUT     bfrom_wth-parts.out-obj-code,
     2531                     INPUT     bfrom_wth-parts.out-obj-type,
     2532                     INPUT     bfrom_wth-parts.sale-obj-code,
     2533                     INPUT     bfrom_wth-parts.sale-obj-type,
     2534                     INPUT     bfrom_wth-parts.doc-code,
     2535                     INPUT     yes,
     2536                     INPUT     bfrom_wth-parts.type,
     2537                     INPUT-OUTPUT p-rec
     2538                     ) no-error.
     2539       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2540       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2541       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2542                     INPUT     tt-wthlib-parts.obj-type,
     2543                     INPUT     tt-wthlib-parts.obj-code,
     2544                     INPUT     tt-wthlib-parts.w-p-code,
     2545                     INPUT     tt-wthlib-parts.wth-code,
     2546                     INPUT     tt-wthlib-parts.par-code,
     2547                     INPUT     tt-wthlib-parts.in-code ,
     2548                     INPUT     tt-wthlib-parts.out-code,
     2549                     INPUT     tt-wthlib-parts.ser-code,
     2550                     INPUT     tt-wthlib-parts.db-num  ,
     2551                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2552                     INPUT     p-fact-rangeFrom - 1  ,
     2553                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2554                     INPUT     p-fact-rangeFrom - 1,
     2555                     INPUT     tt-wthlib-parts.host-code     ,
     2556                     INPUT     tt-wthlib-parts.contract-code               ,
     2557                     INPUT     tt-wthlib-parts.price-rubl    ,
     2558                     INPUT     tt-wthlib-parts.price-base    ,
     2559                     INPUT     tt-wthlib-parts.supp-type,
     2560                     INPUT     tt-wthlib-parts.supp-code,
     2561                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2562                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2563                     INPUT     tt-wthlib-parts.ext-doc-type,
     2564                     INPUT     tt-wthlib-parts.gds-code,
     2565                     INPUT     1             ,
     2566                     INPUT     tt-wthlib-parts.beg-dt        ,
     2567                     INPUT     tt-wthlib-parts.end-dt        ,
     2568                     INPUT     tt-wthlib-parts.vat-pc        ,
     2569                     INPUT     tt-wthlib-parts.cli-code,
     2570                     INPUT     tt-wthlib-parts.cli-type,
     2571                     INPUT     tt-wthlib-parts.out-obj-code,
     2572                     INPUT     tt-wthlib-parts.out-obj-type,
     2573                     INPUT     tt-wthlib-parts.sale-obj-code,
     2574                     INPUT     tt-wthlib-parts.sale-obj-type,
     2575                     INPUT     tt-wthlib-parts.doc-code,
     2576                     INPUT  yes,
     2577                     INPUT    tt-wthlib-parts.type,
     2578                     INPUT-OUTPUT v-recDop
     2579                     ) no-error.
     2580       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2581       end.
     2582       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2583               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2584                     INPUT     tt-wthlib-parts.obj-type,
     2585                     INPUT     tt-wthlib-parts.obj-code,
     2586                     INPUT     tt-wthlib-parts.w-p-code,
     2587                     INPUT     tt-wthlib-parts.wth-code,
     2588                     INPUT     tt-wthlib-parts.par-code,
     2589                     INPUT     tt-wthlib-parts.in-code ,
     2590                     INPUT     tt-wthlib-parts.out-code,
     2591                     INPUT     tt-wthlib-parts.ser-code,
     2592                     INPUT     tt-wthlib-parts.db-num  ,
     2593                     INPUT     p-fact-rangeTo + 1 ,
     2594                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2595                     INPUT     p-fact-rangeTo + 1 ,
     2596                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2597                     INPUT     tt-wthlib-parts.host-code     ,
     2598                     INPUT     tt-wthlib-parts.contract-code               ,
     2599                     INPUT     tt-wthlib-parts.price-rubl    ,
     2600                     INPUT     tt-wthlib-parts.price-base    ,
     2601                     INPUT     tt-wthlib-parts.supp-type,
     2602                     INPUT     tt-wthlib-parts.supp-code,
     2603                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2604                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2605                     INPUT     tt-wthlib-parts.ext-doc-type,
     2606                     INPUT     tt-wthlib-parts.gds-code,
     2607                     INPUT     1             ,
     2608                     INPUT     tt-wthlib-parts.beg-dt        ,
     2609                     INPUT     tt-wthlib-parts.end-dt        ,
     2610                     INPUT     tt-wthlib-parts.vat-pc        ,
     2611                     INPUT     tt-wthlib-parts.cli-code,
     2612                     INPUT     tt-wthlib-parts.cli-type,
     2613                     INPUT     tt-wthlib-parts.out-obj-code,
     2614                     INPUT     tt-wthlib-parts.out-obj-type,
     2615                     INPUT     tt-wthlib-parts.sale-obj-code,
     2616                     INPUT     tt-wthlib-parts.sale-obj-type,
     2617                     INPUT     tt-wthlib-parts.doc-code,
     2618                     INPUT     yes,
     2619                     INPUT     tt-wthlib-parts.type,
     2620                     INPUT-OUTPUT v-recDop
     2621                     ) no-error.
     2622         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2623         end.
     2624     end.
     2625   end procedure.
     2626   PROCEDURE INIT_prtdate:
     2627       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2628       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2629       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2630       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2631       define input parameter        p-date                AS DATE no-undo .
     2632       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     2633       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     2634       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     2635       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     2636       define variable v-value-character as character no-undo .
     2637       define variable v-value-date as date no-undo .
     2638       define variable v-value-decimal as decimal no-undo .
     2639       define variable v-value-integer as INTEGER no-undo .
     2640       define variable v-value-logical AS LOGICAL no-undo .
     2641       define variable v-param-type as character no-undo .
     2642       FIND FIRST buf_wth-ser NO-LOCK
     2643           WHERE buf_wth-ser.ser-code = p-ser-code
     2644           AND buf_wth-ser.db-num = p-db-num.
     2645       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     2646           p-beg-dt = buf_wth-ser.beg-dt.
     2647       END.
     2648       IF buf_wth-ser.chk-edt = 2 THEN DO:
     2649           p-end-dt = buf_wth-ser.end-dt.
     2650       END.
     2651       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     2652           run adm/shattri.p (
     2653               input "get":U
     2654               ,input  p-obj-type
     2655               ,input  p-obj-code
     2656               ,input  'wthdoc_obj':U
     2657               ,input  'rangerule':U
     2658               ,output v-value-character
     2659               ,output v-value-date
     2660               ,output v-value-decimal
     2661               ,output v-value-integer
     2662               ,output v-value-logical
     2663               ,output v-param-type
     2664               ,INPUT-OUTPUT table-handle v-tth
     2665               ) no-error .
     2666           IF not error-status:error  then do:
     2667               v-rangeRule =  v-value-integer.
     2668           END.
     2669           CASE v-rangeRule:
     2670           WHEN 1 THEN DO:
     2671               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     2672                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     2673               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     2674                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     2675               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     2676                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2677           END.
     2678           when 2 then do:
     2679             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2680                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2681             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     2682                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     2683                        .
     2684           end.
     2685           WHEN 3 THEN DO:
     2686               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     2687                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     2688               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     2689                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2690               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     2691                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2692               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2693                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     2694           END.
     2695           when 4 then do:
     2696                p-beg-dt = p-date.
     2697                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     2698           end.
     2699           END CASE.
     2700       END.
     2701   END.
     2702   PROCEDURE INIT_prtprice:
     2703   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     2704   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2705   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2706   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2707   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2708   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     2709   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2710   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2711   define input parameter        p-date                AS DATE no-undo .
     2712   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     2713   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     2714   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     2715   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     2716   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     2717   DEF VAR v-cash-type-pay AS CHAR no-undo.
     2718   define variable p-plt-id AS INT no-undo.
     2719   define variable  p-plt-db-num   AS INT no-undo.
     2720   define variable  p-pdf-id  AS INT no-undo.
     2721   define variable  p-pdf-db-num AS INT no-undo.
     2722   define variable  p-sale-price-base AS DEC no-undo.
     2723   define variable  p-sale-price-rubl AS DEC no-undo.
     2724   define variable  p-road-tax-base AS DEC no-undo.
     2725   define variable  p-road-tax-rubl AS DEC no-undo.
     2726   define variable  p-excise-base AS DEC no-undo.
     2727   define variable  p-excise-rubl AS DEC no-undo.
     2728   define variable  p-fact-order  AS DEC no-undo.
     2729   do on error undo, return error return-value :
     2730     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     2731                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     2732     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     2733     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     2734     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     2735     ELSE v-cash-type-pay = ?.
     2736     run fact-order-mpl (
     2737         INPUT p-date ,
     2738         INPUT p-obj-type ,
     2739         INPUT p-obj-code ,
     2740         OUTPUT p-fact-order
     2741         ) no-error .
     2742     if error-status:error then do:
     2743       message   return-value skip error-status:get-message(1)
     2744       skip  'Получение цены из множественного прайс-листа отклонено.'
     2745       view-as alert-box.
     2746       return.
     2747     end.
     2748   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2749   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2750     (input  p-gds-code
     2751     ,input  '1':U
     2752     ,input  ?
     2753     ,input  p-host-code
     2754     ,input  p-obj-type
     2755     ,input  p-obj-code
     2756     ,output p-vat-pc
     2757     ) no-error .
     2758     run mpl-autoprice in this-procedure
     2759       ( input    false
     2760         ,input   p-cli-type
     2761         ,input   p-cli-code
     2762         ,input   p-gds-code
     2763         ,input   p-gds-code
     2764         ,input   p-obj-type
     2765         ,input   p-obj-code
     2766         ,input   0
     2767         ,input   0
     2768         ,input   ""
     2769         ,input   v-cash-type-pay
     2770         ,input   p-fact-order
     2771         ,output  p-plt-id
     2772         ,output  p-plt-db-num
     2773         ,output  p-pdf-id
     2774         ,output  p-pdf-db-num
     2775         ,output  p-sale-price-base
     2776         ,output  p-sale-price-rubl
     2777         ,output  p-road-tax-base
     2778         ,output  p-road-tax-rubl
     2779         ,output  p-excise-base
     2780         ,output  p-excise-rubl
     2781         ) no-error .
     2782     if error-status:error then do:
     2783       message   return-value skip error-status:get-message(1) view-as alert-box.
     2784       return.
     2785     end.
     2786     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     2787     p-price-base = p-sale-price-base * b-wth-par.par-val.
     2788   end.
     2789   END.
     2790   procedure  set-wthmpl-date:
     2791   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     2792   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     2793   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     2794   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     2795   define variable v-atrValue      as character no-undo .
     2796   define variable v-atrDsf      as CHARACTER no-undo .
     2797   define variable v-atrType     as character no-undo .
     2798   do on error undo, return error return-value :
     2799   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     2800                           input 'wthdsf':U ,
     2801                          output v-atrValue ,
     2802                          output v-atrType )  .
     2803     p-date = date(v-atrValue) no-error.
     2804     if p-date = ? then p-date = p-beg-dt no-error.
     2805     if p-date = ? then p-date = p-doc-date.
     2806   end.
     2807   end procedure.
     2808   define temp-table tt-parts-cli    no-undo like ub.arh-wth-cli
     2809    .
     2810   define temp-table tt-parts-cli-tot    no-undo like ub.arh-wth-cli-tot
     2811    .
     2812   define temp-table tt-parts-cli-doc no-undo like ub.arh-wth-cli-doc
     2813   .
     2814   define temp-table tt-parts-tot    no-undo like ub.arh-wth-tot.
     2815   define temp-table tt-parts-wp     no-undo like ub.arh-wth-w-p.
     2816   define buffer buf-prev_arh-wth-cli   for ub.arh-wth-cli.
     2817   define buffer buf-arh-wth-cli        for ub.arh-wth-cli.
     2818   define buffer buf-recalc-cli         for ub.arh-wth-cli.
     2819   define buffer buf-prev_arh-wth-cli-doc   for ub.arh-wth-cli-doc.
     2820   define buffer buf-arh-wth-cli-doc    for ub.arh-wth-cli-doc.
     2821   define buffer buf-recalc-cli-doc     for ub.arh-wth-cli-doc.
     2822   define buffer buf-prev_arh-wth-tot   for ub.arh-wth-tot.
     2823   define buffer buf-arh-wth-tot        for ub.arh-wth-tot.
     2824   define buffer buf-recalc-tot         for ub.arh-wth-tot.
     2825   define buffer buf-prev_arh-wth-wp    for ub.arh-wth-w-p.
     2826   define buffer buf-arh-wth-wp         for ub.arh-wth-w-p.
     2827   define buffer buf-recalc-wp          for ub.arh-wth-w-p.
     2828   define buffer buf-arh_wth-doc        for ub.wth-doc.
     2829   define buffer buf-prev_arh-wth-cli-tot   for ub.arh-wth-cli-tot.
     2830   define buffer buf-arh-wth-cli-tot        for ub.arh-wth-cli-tot.
     2831   define buffer buf-recalc-cli-tot         for ub.arh-wth-cli-tot.
     2832   procedure wth-arh-mode:
     2833     define input  parameter parext-doc-type like ub.wth-doc.ext-doc-type no-undo.
     2834     define input  parameter pardoc-code like ub.wth-doc.doc-code no-undo.
     2835     define output parameter parinc-exp      as   integer                 no-undo.
     2836     define buffer buf_wth-parts   for ub.wth-parts.
     2837     case parext-doc-type:
     2838       when 'ee':U
     2839       or when 'pc':U
     2840       or when 'ps':U
     2841       or when 'pz':U
     2842       or when 'dc':U
     2843       or when 'xc':U
     2844       then do:
     2845         if can-find(first buf_wth-parts where buf_wth-parts.out-code = pardoc-code)
     2846         then parinc-exp = 1.
     2847         else parinc-exp = 0.
     2848       end.
     2849     end case.
     2850   end procedure.
     2851    procedure wth-arh-calctt-loc:
     2852     define input parameter pardoc-code as char no-undo.
     2853     define input parameter par-lock as log no-undo.
     2854     define var vararh-mode as int no-undo.
     2855     define buffer buf_wth-parts   for ub.wth-parts.
     2856     define variable v-cli-type    as character    no-undo.
     2857     define variable v-cli-code    as integer      no-undo.
     2858     define variable v-zone        as character    no-undo.
     2859     do on error undo, return error substitute ("Создание архивов по документу &4 &1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2),pardoc-code) :
     2860     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
     2861     if not available buf-arh_wth-doc then do:
     2862       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
     2863     end.
     2864     run wth-arh-mode(input buf-arh_wth-doc.ext-doc-type
     2865             ,input buf-arh_wth-doc.doc-code
     2866             ,output vararh-mode).
     2867     empty temp-table tt-parts-cli.
     2868     empty temp-table tt-parts-cli-tot.
     2869     empty temp-table tt-parts-wp.
     2870     empty temp-table tt-parts-cli-doc.
     2871     empty temp-table tt-parts-tot   .
     2872     for each buf_wth-parts no-lock where
     2873              buf_wth-parts.out-code = pardoc-code
     2874          and buf_wth-parts.stts = 0 :
     2875      if  not g#news
     2876          or (g#news and  g#db-num  = 0)
     2877      then do:
     2878         find first tt-parts-tot where
     2879                   tt-parts-tot.wth-code = buf_wth-parts.wth-code
     2880               and tt-parts-tot.par-code = buf_wth-parts.par-code
     2881               and tt-parts-tot.obj-type = buf_wth-parts.obj-type
     2882               and tt-parts-tot.obj-code = buf_wth-parts.obj-code
     2883               and tt-parts-tot.ext-doc-type = buf_wth-parts.ext-doc-type
     2884               and tt-parts-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     2885               no-error.
     2886         if not available tt-parts-tot then do:
     2887           create tt-parts-tot.
     2888           assign tt-parts-tot.wth-code = buf_wth-parts.wth-code
     2889                 tt-parts-tot.par-code = buf_wth-parts.par-code
     2890                 tt-parts-tot.gds-code = buf_wth-parts.gds-code
     2891                 tt-parts-tot.w-p-code = buf_wth-parts.w-p-code
     2892                 tt-parts-tot.obj-type = buf_wth-parts.obj-type
     2893                 tt-parts-tot.obj-code = buf_wth-parts.obj-code
     2894                 tt-parts-tot.ext-doc-type = buf_wth-parts.ext-doc-type
     2895                 tt-parts-tot.doc-code = buf_wth-parts.out-code
     2896                 tt-parts-tot.host-code = buf_wth-parts.host-code
     2897                 tt-parts-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     2898           .
     2899         end.
     2900         if buf-arh_wth-doc.doc-type = 'при':U or (buf-arh_wth-doc.doc-type = 'обмен':U and  buf_wth-parts.type = 'при':U) or  buf_wth-parts.type = 'возврат':U then      assign tt-parts-tot.in-qnty     = tt-parts-tot.in-qnty     + buf_wth-parts.fact-qnty            tt-parts-tot.in-sum-rubl = tt-parts-tot.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl           tt-parts-tot.in-sum-base = tt-parts-tot.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .    else   assign tt-parts-tot.out-qnty  = tt-parts-tot.out-qnty + buf_wth-parts.fact-qnty                               tt-parts-tot.out-sum-rubl = tt-parts-tot.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl            tt-parts-tot.out-sum-base = tt-parts-tot.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     2901         if lookup(buf-arh_wth-doc.ext-doc-type,'ie,ff,rf':U) > 0
     2902         or (buf-arh_wth-doc.ext-doc-type = 'xc':U  and buf_wth-parts.type = 'рас':U)
     2903         or lookup (buf-arh_wth-doc.ext-doc-type,'ee,ef,df':u) > 0 then
     2904         v-zone = 'free-zone':U.
     2905         else if lookup(buf-arh_wth-doc.ext-doc-type,'ip,pc,ps,pz,rp':u) > 0
     2906         or (buf-arh_wth-doc.ext-doc-type = 'xc':U  and buf_wth-parts.type = 'при':U)
     2907         or lookup (buf-arh_wth-doc.ext-doc-type,'ep,dp':u) > 0 then
     2908         v-zone = 'put-zone':U.
     2909         if v-zone = 'free-zone':U or  v-zone = 'put-zone':U then do:
     2910           find first tt-parts-wp where
     2911                     tt-parts-wp.obj-type = buf_wth-parts.obj-type
     2912                 and tt-parts-wp.obj-code = buf_wth-parts.obj-code
     2913                 and tt-parts-wp.w-p-code = buf_wth-parts.w-p-code
     2914                 and tt-parts-wp.wth-code = buf_wth-parts.wth-code
     2915                 and tt-parts-wp.par-code = buf_wth-parts.par-code
     2916                 and tt-parts-wp.out-code = v-zone
     2917                 no-error.
     2918           if not available tt-parts-wp then do:
     2919             create tt-parts-wp.
     2920             assign tt-parts-wp.wth-code = buf_wth-parts.wth-code
     2921                   tt-parts-wp.par-code = buf_wth-parts.par-code
     2922                   tt-parts-wp.gds-code = buf_wth-parts.gds-code
     2923                   tt-parts-wp.w-p-code = buf_wth-parts.w-p-code
     2924                   tt-parts-wp.obj-type = buf_wth-parts.obj-type
     2925                   tt-parts-wp.obj-code = buf_wth-parts.obj-code
     2926                   tt-parts-wp.out-code = v-zone
     2927                   tt-parts-wp.ext-doc-type = buf_wth-parts.ext-doc-type
     2928                   tt-parts-wp.doc-code = buf_wth-parts.out-code
     2929                   tt-parts-wp.host-code = buf_wth-parts.host-code
     2930             .
     2931           end.
     2932           if buf-arh_wth-doc.doc-type = 'при':U or (buf-arh_wth-doc.doc-type = 'обмен':U and  buf_wth-parts.type = 'при':U) then
     2933       assign tt-parts-wp.in-qnty     = tt-parts-wp.in-qnty     + buf_wth-parts.fact-qnty
     2934              tt-parts-wp.in-sum-rubl = tt-parts-wp.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     2935              tt-parts-wp.in-sum-base = tt-parts-wp.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
     2936       else   assign tt-parts-wp.out-qnty  = tt-parts-wp.out-qnty + buf_wth-parts.fact-qnty
     2937              tt-parts-wp.out-sum-rubl = tt-parts-wp.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     2938              tt-parts-wp.out-sum-base = tt-parts-wp.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     2939         end.
     2940       end.
     2941       if vararh-mode = 1 then do:
     2942         if buf_wth-parts.in-code = 'фальшивый':U then
     2943         assign v-cli-type = '':U
     2944                v-cli-code = 0.
     2945         else assign v-cli-type = buf_wth-parts.cli-type
     2946                v-cli-code = buf_wth-parts.cli-code.
     2947         find first tt-parts-cli where
     2948                   tt-parts-cli.wth-code = buf_wth-parts.wth-code
     2949               and tt-parts-cli.par-code = buf_wth-parts.par-code
     2950               and tt-parts-cli.ser-code = buf_wth-parts.ser-code
     2951               and tt-parts-cli.db-num   = buf_wth-parts.db-num
     2952               and tt-parts-cli.cli-type = v-cli-type
     2953               and tt-parts-cli.cli-code = v-cli-code
     2954               and tt-parts-cli.obj-type = buf_wth-parts.obj-type
     2955               and tt-parts-cli.obj-code = buf_wth-parts.obj-code
     2956               and tt-parts-cli.ext-doc-type = buf_wth-parts.ext-doc-type
     2957               and tt-parts-cli.gds-code = buf_wth-parts.gds-code
     2958               and tt-parts-cli.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     2959               no-error.
     2960         if not available tt-parts-cli then do:
     2961           create tt-parts-cli.
     2962           assign tt-parts-cli.wth-code = buf_wth-parts.wth-code
     2963                 tt-parts-cli.par-code = buf_wth-parts.par-code
     2964                 tt-parts-cli.ser-code = buf_wth-parts.ser-code
     2965                 tt-parts-cli.db-num   = buf_wth-parts.db-num
     2966                 tt-parts-cli.cli-type = v-cli-type
     2967                 tt-parts-cli.cli-code = v-cli-code
     2968                 tt-parts-cli.obj-type = buf_wth-parts.obj-type
     2969                 tt-parts-cli.obj-code = buf_wth-parts.obj-code
     2970                 tt-parts-cli.doc-code  = buf_wth-parts.out-code
     2971                 tt-parts-cli.ext-doc-type = buf_wth-parts.ext-doc-type
     2972                 tt-parts-cli.gds-code = buf_wth-parts.gds-code
     2973                 tt-parts-cli.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     2974           .
     2975         end.
     2976       if buf-arh_wth-doc.doc-type = 'при':U
     2977       or buf-arh_wth-doc.doc-type = 'возврат':U
     2978       or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U)
     2979       then
     2980       assign tt-parts-cli.in-qnty     = tt-parts-cli.in-qnty     + buf_wth-parts.fact-qnty
     2981              tt-parts-cli.in-sum-rubl = tt-parts-cli.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     2982              tt-parts-cli.in-sum-base = tt-parts-cli.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
     2983       else   assign tt-parts-cli.out-qnty  = tt-parts-cli.out-qnty + buf_wth-parts.fact-qnty
     2984              tt-parts-cli.out-sum-rubl = tt-parts-cli.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     2985              tt-parts-cli.out-sum-base = tt-parts-cli.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     2986         find first tt-parts-cli-doc where
     2987                   tt-parts-cli-doc.wth-code = buf_wth-parts.wth-code
     2988               and tt-parts-cli-doc.par-code = buf_wth-parts.par-code
     2989               and tt-parts-cli-doc.cli-type = v-cli-type
     2990               and tt-parts-cli-doc.cli-code = v-cli-code
     2991               and tt-parts-cli-doc.host-code = buf_wth-parts.host-code
     2992               and tt-parts-cli-doc.contract-code = buf_wth-parts.contract-code
     2993               and tt-parts-cli-doc.gds-code = buf_wth-parts.gds-code
     2994               and tt-parts-cli-doc.obj-type = buf_wth-parts.obj-type
     2995               and tt-parts-cli-doc.obj-code = buf_wth-parts.obj-code
     2996               and tt-parts-cli-doc.w-p-code = buf_wth-parts.w-p-code
     2997               and tt-parts-cli-doc.ext-doc-type = buf_wth-parts.ext-doc-type
     2998               and tt-parts-cli-doc.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     2999               no-error.
     3000         if not available tt-parts-cli-doc then do:
     3001           create tt-parts-cli-doc.
     3002           buffer-copy buf_wth-parts using wth-code
     3003                                           par-code
     3004                                           host-code
     3005                                           contract-code
     3006                                           gds-code
     3007                                           obj-type
     3008                                           obj-code
     3009                                           w-p-code
     3010                                           ext-doc-type
     3011                       to tt-parts-cli-doc.
     3012           assign tt-parts-cli-doc.doc-code = buf_wth-parts.out-code
     3013                  tt-parts-cli-doc.cli-code = v-cli-code
     3014                  tt-parts-cli-doc.cli-type = v-cli-type
     3015                  tt-parts-cli-doc.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3016           .
     3017         end.
     3018         if buf-arh_wth-doc.doc-type = 'при':U
     3019         or buf-arh_wth-doc.doc-type = 'возврат':U
     3020         or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U )
     3021         then
     3022       assign tt-parts-cli-doc.in-qnty     = tt-parts-cli-doc.in-qnty     + buf_wth-parts.fact-qnty
     3023              tt-parts-cli-doc.in-sum-rubl = tt-parts-cli-doc.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3024              tt-parts-cli-doc.in-sum-base = tt-parts-cli-doc.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
     3025       else   assign tt-parts-cli-doc.out-qnty  = tt-parts-cli-doc.out-qnty + buf_wth-parts.fact-qnty
     3026              tt-parts-cli-doc.out-sum-rubl = tt-parts-cli-doc.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3027              tt-parts-cli-doc.out-sum-base = tt-parts-cli-doc.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     3028         find first tt-parts-cli-tot where
     3029                   tt-parts-cli-tot.cli-type = v-cli-type
     3030               and tt-parts-cli-tot.cli-code = v-cli-code
     3031               and tt-parts-cli-tot.obj-type = buf_wth-parts.obj-type
     3032               and tt-parts-cli-tot.obj-code = buf_wth-parts.obj-code
     3033               and tt-parts-cli-tot.ext-doc-type = buf_wth-parts.ext-doc-type
     3034               and tt-parts-cli-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3035         no-error.
     3036         if not available tt-parts-cli-tot then do:
     3037           create tt-parts-cli-tot.
     3038           assign tt-parts-cli-tot.cli-type = v-cli-type
     3039                 tt-parts-cli-tot.cli-code  = v-cli-code
     3040                 tt-parts-cli-tot.obj-type  = buf_wth-parts.obj-type
     3041                 tt-parts-cli-tot.obj-code  = buf_wth-parts.obj-code
     3042                 tt-parts-cli-tot.doc-code  = buf_wth-parts.out-code
     3043                 tt-parts-cli-tot.host-code = buf_wth-parts.host-code
     3044                 tt-parts-cli-tot.ext-doc-type = buf_wth-parts.ext-doc-type
     3045                 tt-parts-cli-tot.sum-type = if buf_wth-parts.type > '' then buf_wth-parts.type else buf-arh_wth-doc.doc-type
     3046           .
     3047         end.
     3048         if buf-arh_wth-doc.doc-type = 'при':U
     3049         or buf-arh_wth-doc.doc-type = 'возврат':U
     3050         or (buf-arh_wth-doc.doc-type = 'обмен':U and buf_wth-parts.type = 'при':U )
     3051         then
     3052         assign tt-parts-cli-tot.in-qnty     = tt-parts-cli-tot.in-qnty     + buf_wth-parts.fact-qnty
     3053               tt-parts-cli-tot.in-sum-rubl = tt-parts-cli-tot.in-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3054               tt-parts-cli-tot.in-sum-base = tt-parts-cli-tot.in-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base .
     3055         else   assign tt-parts-cli-tot.out-qnty = tt-parts-cli-tot.out-qnty  + buf_wth-parts.fact-qnty
     3056               tt-parts-cli-tot.out-sum-rubl = tt-parts-cli-tot.out-sum-rubl + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     3057               tt-parts-cli-tot.out-sum-base = tt-parts-cli-tot.out-sum-base + buf_wth-parts.fact-qnty * buf_wth-parts.price-base  .
     3058       end.
     3059     end.
     3060     if par-lock then do:
     3061       for each tt-parts-tot:
     3062         find last   buf-arh-wth-tot exclusive-lock  where
     3063                     buf-arh-wth-tot.wth-code =  tt-parts-tot.wth-code
     3064                 and buf-arh-wth-tot.par-code =  tt-parts-tot.par-code
     3065                 and buf-arh-wth-tot.obj-type = tt-parts-tot.obj-type
     3066                 and buf-arh-wth-tot.obj-code = tt-parts-tot.obj-code
     3067                 and buf-arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3068                 and buf-arh-wth-tot.sum-type = tt-parts-tot.sum-type     no-error.
     3069         if not available buf-arh-wth-tot then do:
     3070           create buf-arh-wth-tot.
     3071           buffer-copy tt-parts-tot using
     3072                       wth-code
     3073                       par-code
     3074                       gds-code
     3075                       obj-type
     3076                       obj-code
     3077                       w-p-code
     3078                       sum-type
     3079                       ext-doc-type
     3080           to buf-arh-wth-tot.
     3081         end.
     3082       end.
     3083       for each tt-parts-wp:
     3084         find last   buf-arh-wth-wp exclusive-lock  where
     3085                     buf-arh-wth-wp.wth-code =  tt-parts-wp.wth-code
     3086                 and buf-arh-wth-wp.par-code =  tt-parts-wp.par-code
     3087                 and buf-arh-wth-wp.obj-type = tt-parts-wp.obj-type
     3088                 and buf-arh-wth-wp.obj-code = tt-parts-wp.obj-code
     3089                 and buf-arh-wth-wp.w-p-code = tt-parts-wp.w-p-code
     3090                 and buf-arh-wth-wp.out-code = tt-parts-wp.out-code     no-error.
     3091         if not available buf-arh-wth-wp then do:
     3092           create buf-arh-wth-wp.
     3093           buffer-copy tt-parts-wp using
     3094                       wth-code
     3095                       par-code
     3096                       gds-code
     3097                       obj-type
     3098                       obj-code
     3099                       w-p-code
     3100                       doc-code
     3101                       out-code
     3102                       ext-doc-type
     3103           to buf-arh-wth-wp.
     3104         end.
     3105       end.
     3106       for each tt-parts-cli:
     3107         find last  buf-arh-wth-cli exclusive-lock where
     3108                    buf-arh-wth-cli.wth-code =  tt-parts-cli.wth-code
     3109               and  buf-arh-wth-cli.par-code =  tt-parts-cli.par-code
     3110               and  buf-arh-wth-cli.ser-code =  tt-parts-cli.ser-code
     3111               and  buf-arh-wth-cli.db-num   =  tt-parts-cli.db-num
     3112               and  buf-arh-wth-cli.cli-type =  tt-parts-cli.cli-type
     3113               and  buf-arh-wth-cli.cli-code =  tt-parts-cli.cli-code
     3114               and  buf-arh-wth-cli.obj-type =  tt-parts-cli.obj-type
     3115               and  buf-arh-wth-cli.obj-code =  tt-parts-cli.obj-code
     3116               and  buf-arh-wth-cli.sum-type = tt-parts-cli.sum-type
     3117               and  buf-arh-wth-cli.ext-doc-type =  tt-parts-cli.ext-doc-type
     3118               and  buf-arh-wth-cli.gds-code =  tt-parts-cli.gds-code
     3119                no-error.
     3120         if not available buf-arh-wth-cli then do:
     3121           create buf-arh-wth-cli.
     3122           buffer-copy tt-parts-cli using wth-code
     3123                                          sum-type
     3124                                          par-code
     3125                                          ser-code
     3126                                          db-num
     3127                                          cli-type
     3128                                          cli-code
     3129                                          obj-type
     3130                                          obj-code
     3131                                          ext-doc-type
     3132                                          gds-code to buf-arh-wth-cli.
     3133         end.
     3134       end.
     3135       for each tt-parts-cli-doc:
     3136         find last buf-arh-wth-cli-doc exclusive-lock  where
     3137                    buf-arh-wth-cli-doc.wth-code = tt-parts-cli-doc.wth-code
     3138               and  buf-arh-wth-cli-doc.par-code = tt-parts-cli-doc.par-code
     3139               and  buf-arh-wth-cli-doc.cli-type = tt-parts-cli-doc.cli-type
     3140               and  buf-arh-wth-cli-doc.cli-code = tt-parts-cli-doc.cli-code
     3141               and  buf-arh-wth-cli-doc.host-code     = tt-parts-cli-doc.host-code
     3142               and  buf-arh-wth-cli-doc.contract-code = tt-parts-cli-doc.contract-code
     3143               and  buf-arh-wth-cli-doc.gds-code      = tt-parts-cli-doc.gds-code
     3144               and  buf-arh-wth-cli-doc.obj-type      = tt-parts-cli-doc.obj-type
     3145               and  buf-arh-wth-cli-doc.obj-code      = tt-parts-cli-doc.obj-code
     3146               and  buf-arh-wth-cli-doc.w-p-code      = tt-parts-cli-doc.w-p-code
     3147               and  buf-arh-wth-cli-doc.sum-type      = tt-parts-cli-doc.sum-type
     3148               and  buf-arh-wth-cli-doc.ext-doc-type  = tt-parts-cli-doc.ext-doc-type
     3149               no-error.
     3150         if not available buf-arh-wth-cli-doc then do:
     3151           create buf-arh-wth-cli-doc.
     3152           buffer-copy tt-parts-cli-doc using
     3153                       wth-code
     3154                       par-code
     3155                       cli-type
     3156                       cli-code
     3157                       host-code
     3158                       contract-code
     3159                       gds-code
     3160                       obj-type
     3161                       obj-code
     3162                       w-p-code
     3163                       ext-doc-type
     3164                       sum-type
     3165                       to buf-arh-wth-cli-doc.
     3166         end.
     3167       end.
     3168       for each tt-parts-cli-tot:
     3169         find last  buf-arh-wth-cli-tot exclusive-lock where
     3170                    buf-arh-wth-cli-tot.cli-type =  tt-parts-cli-tot.cli-type
     3171               and  buf-arh-wth-cli-tot.cli-code =  tt-parts-cli-tot.cli-code
     3172               and  buf-arh-wth-cli-tot.obj-type =  tt-parts-cli-tot.obj-type
     3173               and  buf-arh-wth-cli-tot.obj-code =  tt-parts-cli-tot.obj-code
     3174               and  buf-arh-wth-cli-tot.sum-type = tt-parts-cli-tot.sum-type
     3175               and  buf-arh-wth-cli-tot.ext-doc-type =  tt-parts-cli-tot.ext-doc-type
     3176         no-error.
     3177         if not available buf-arh-wth-cli-tot then do:
     3178           create buf-arh-wth-cli-tot.
     3179           buffer-copy tt-parts-cli-tot using cli-type sum-type cli-code obj-type obj-code ext-doc-type host-code to buf-arh-wth-cli-tot.
     3180         end.
     3181       end.
     3182     end.
     3183     end.
     3184    end procedure.
     3185    procedure wth-arhdoc-close:
     3186    define input parameter pardoc-code as char no-undo.
     3187    define variable vararh-mode  as integer      no-undo.
     3188     do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     3189     find first buf-arh_wth-doc where buf-arh_wth-doc.doc-code = pardoc-code no-lock no-error.
     3190     if not available buf-arh_wth-doc then do:
     3191       return error substitute ("Не найден документ МЦ с номером &1.", pardoc-code).
     3192     end.
     3193     run wth-arh-mode(input buf-arh_wth-doc.ext-doc-type
     3194             ,input buf-arh_wth-doc.doc-code
     3195             ,output vararh-mode).
     3196     if buf-arh_wth-doc.status_ <> 'факт':U then do:
     3197       return error substitute ("Документ МЦ с номером &1 не в статусе факт. Создание архивов невозможно.", pardoc-code).
     3198     end.
     3199     if buf-arh_wth-doc.fact-order = 0 or
     3200       buf-arh_wth-doc.fact-order = ? then do:
     3201       return error substitute ("В документе МЦ с номером &1 не проставлен fact-order.", buf-arh_wth-doc.doc-code).
     3202     end.
     3203     if  not g#news
     3204          or (g#news and  g#db-num  = 0)
     3205     then do:
     3206       for each  tt-parts-tot on error undo, return error:
     3207           find last  buf-prev_arh-wth-tot where buf-prev_arh-wth-tot.wth-code =  tt-parts-tot.wth-code
     3208                                             and buf-prev_arh-wth-tot.par-code =  tt-parts-tot.par-code
     3209                                             and buf-prev_arh-wth-tot.obj-type = tt-parts-tot.obj-type
     3210                                             and buf-prev_arh-wth-tot.obj-code = tt-parts-tot.obj-code
     3211                                             and buf-prev_arh-wth-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3212                                             and buf-prev_arh-wth-tot.sum-type = tt-parts-tot.sum-type
     3213                                             and buf-prev_arh-wth-tot.fact-order < buf-arh_wth-doc.fact-order
     3214                                             no-error.
     3215           if available buf-prev_arh-wth-tot and buf-prev_arh-wth-tot.fact-order = 0 then do:
     3216               find first buf-arh-wth-tot where recid(buf-arh-wth-tot) = recid(buf-prev_arh-wth-tot) exclusive-lock.
     3217           end.
     3218           else do:
     3219             create buf-arh-wth-tot.
     3220             buffer-copy tt-parts-tot to buf-arh-wth-tot .
     3221           end.
     3222           assign  buf-arh-wth-tot.doc-code = buf-arh_wth-doc.doc-code
     3223                   buf-arh-wth-tot.fact-order = buf-arh_wth-doc.fact-order
     3224                   buf-arh-wth-tot.in-qnty     = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-qnty  else 0)    + tt-parts-tot.in-qnty
     3225                   buf-arh-wth-tot.in-sum-rubl = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-sum-rubl else 0) + tt-parts-tot.in-sum-rubl
     3226                   buf-arh-wth-tot.in-sum-base = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.in-sum-base else 0) + tt-parts-tot.in-sum-base
     3227                   buf-arh-wth-tot.out-qnty    = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-qnty else 0)    + tt-parts-tot.out-qnty
     3228                   buf-arh-wth-tot.out-sum-rubl = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-sum-rubl else 0) + tt-parts-tot.out-sum-rubl
     3229                   buf-arh-wth-tot.out-sum-base = (if available buf-prev_arh-wth-tot then buf-prev_arh-wth-tot.out-sum-base else 0) + tt-parts-tot.out-sum-base
     3230                   .
     3231           for each buf-recalc-tot where buf-recalc-tot.fact-order > buf-arh_wth-doc.fact-order
     3232                 and buf-recalc-tot.wth-code = tt-parts-tot.wth-code
     3233                 and buf-recalc-tot.par-code = tt-parts-tot.par-code
     3234                 and buf-recalc-tot.obj-type = tt-parts-tot.obj-type
     3235                 and buf-recalc-tot.obj-code = tt-parts-tot.obj-code
     3236                 and buf-recalc-tot.ext-doc-type = tt-parts-tot.ext-doc-type
     3237                 and buf-recalc-tot.sum-type = tt-parts-tot.sum-type
     3238                 on error undo, return error :
     3239                 assign buf-recalc-tot.out-qnty    = buf-recalc-tot.out-qnty     + tt-parts-tot.out-qnty
     3240                       buf-recalc-tot.out-sum-rubl = buf-recalc-tot.out-sum-rubl + tt-parts-tot.out-sum-rubl
     3241                       buf-recalc-tot.out-sum-base = buf-recalc-tot.out-sum-base + tt-parts-tot.out-sum-base
     3242                       buf-recalc-tot.in-qnty      = buf-recalc-tot.in-qnty    + tt-parts-tot.in-qnty
     3243                       buf-recalc-tot.in-sum-rubl = buf-recalc-tot.in-sum-rubl + tt-parts-tot.in-sum-rubl
     3244                       buf-recalc-tot.in-sum-base = buf-recalc-tot.in-sum-base + tt-parts-tot.in-sum-base
     3245                       .
     3246           end.
     3247        end.
     3248        for each  tt-parts-wp on error undo, return error:
     3249           find last  buf-prev_arh-wth-wp where buf-prev_arh-wth-wp.wth-code  = tt-parts-wp.wth-code
     3250                                             and buf-prev_arh-wth-wp.par-code = tt-parts-wp.par-code
     3251                                             and buf-prev_arh-wth-wp.obj-type = tt-parts-wp.obj-type
     3252                                             and buf-prev_arh-wth-wp.obj-code = tt-parts-wp.obj-code
     3253                                             and buf-prev_arh-wth-wp.out-code = tt-parts-wp.out-code
     3254                                             and buf-prev_arh-wth-wp.w-p-code = tt-parts-wp.w-p-code
     3255                                             and buf-prev_arh-wth-wp.fact-order < buf-arh_wth-doc.fact-order
     3256                                             no-error.
     3257           if available buf-prev_arh-wth-wp and buf-prev_arh-wth-wp.fact-order = 0 then do:
     3258               find first buf-arh-wth-wp where recid(buf-arh-wth-wp) = recid(buf-prev_arh-wth-wp) exclusive-lock.
     3259           end.
     3260           else do:
     3261             create buf-arh-wth-wp.
     3262             buffer-copy tt-parts-wp to buf-arh-wth-wp .
     3263           end.
     3264           assign  buf-arh-wth-wp.doc-code = buf-arh_wth-doc.doc-code
     3265                   buf-arh-wth-wp.fact-order = buf-arh_wth-doc.fact-order
     3266                   buf-arh-wth-wp.ext-doc-type = buf-arh_wth-doc.ext-doc-type
     3267                   buf-arh-wth-wp.in-qnty     = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.in-qnty  else 0)    + tt-parts-wp.in-qnty
     3268                   buf-arh-wth-wp.in-sum-rubl = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.in-sum-rubl else 0) + tt-parts-wp.in-sum-rubl
     3269                   buf-arh-wth-wp.in-sum-base = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.in-sum-base else 0) + tt-parts-wp.in-sum-base
     3270                   buf-arh-wth-wp.out-qnty    = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.out-qnty else 0)    + tt-parts-wp.out-qnty
     3271                   buf-arh-wth-wp.out-sum-rubl = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.out-sum-rubl else 0) + tt-parts-wp.out-sum-rubl
     3272                   buf-arh-wth-wp.out-sum-base = (if available buf-prev_arh-wth-wp then buf-prev_arh-wth-wp.out-sum-base else 0) + tt-parts-wp.out-sum-base
     3273                   .
     3274           for each buf-recalc-wp where buf-recalc-wp.fact-order > buf-arh_wth-doc.fact-order
     3275                 and buf-recalc-wp.wth-code = tt-parts-wp.wth-code
     3276                 and buf-recalc-wp.par-code = tt-parts-wp.par-code
     3277                 and buf-recalc-wp.obj-type = tt-parts-wp.obj-type
     3278                 and buf-recalc-wp.obj-code = tt-parts-wp.obj-code
     3279                 and buf-recalc-wp.out-code = tt-parts-wp.out-code
     3280                 and buf-recalc-wp.w-p-code = tt-parts-wp.w-p-code
     3281                 and buf-recalc-wp.sum-type = tt-parts-wp.sum-type
     3282                 on error undo, return error :
     3283                 assign buf-recalc-wp.out-qnty    = buf-recalc-wp.out-qnty     + tt-parts-wp.out-qnty
     3284                       buf-recalc-wp.out-sum-rubl = buf-recalc-wp.out-sum-rubl + tt-parts-wp.out-sum-rubl
