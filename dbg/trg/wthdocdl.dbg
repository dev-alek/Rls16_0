     3661   end procedure.
     3662   define buffer buf_wth-doc     for ub.wth-doc .
     3663   define buffer buf_wth-parts   for ub.wth-parts.
     3664   define buffer buf_out-doc for ub.wth-doc.
     3665   define variable v-db-doc        as integer      no-undo.
     3666   define variable v-db-out-doc    as integer      no-undo.
     3667   main-block: do  transaction
     3668   on error  undo main-block, return error substitute( "&1 &2 &3&4&5&6&7", vss-workfile,vss-revision,vss-description,chr(10), return-value, chr(10), error-status :get-message (1))
     3669   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3670   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3671   :
     3672     define variable l-shift-on      as logical   no-undo .
     3673     define variable varobj-date     as date                      no-undo.
     3674     define variable varshift-date   like ub.shift-obj.shift-date no-undo.
     3675     define variable varshift-num    like ub.shift-obj.shift-num  no-undo.
     3676     define variable varshift-name as character no-undo.
     3677     find first buf_wth-doc exclusive-lock
     3678       where buf_wth-doc.doc-code = p-doc-code
     3679       no-error .
     3680     if not available buf_wth-doc then do:
     3681       undo, return error substitute("&1 &3 &4",
     3682                             "Ошибка задания входных параметров."  ,
     3683                             "Документ МЦ"  ,
     3684                             p-doc-code).
     3685     end.
     3686     if not g#news then do:
     3687       if buf_wth-doc.doc-type = 'рас':U and not buf_wth-doc.exter_ then do:
     3688   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3690     (input  buf_wth-doc.obj-type
     3691     ,input  buf_wth-doc.obj-code
     3692     ,output v-db-doc
     3693     )  .
     3694   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3696     (input  buf_wth-doc.cli-type
     3697     ,input  buf_wth-doc.cli-code
     3698     ,output v-db-out-doc
     3699     )  .
     3700           if v-db-doc <> v-db-out-doc then do:
     3701           undo, return error   substitute("Документ создан для объектов  с разными номерам БД.&4Номер БД документа &5&4Номер БД порожденного документа  &6",
     3702                          vss-workfile,
     3703                          vss-revision,
     3704                          vss-description,
     3705                          chr(10),
     3706                          v-db-doc,
     3707                          v-db-out-doc)
     3708              .
     3709           end.
     3710       end.
     3711       find first buf_out-doc no-lock where
     3712               buf_out-doc.source-ref = buf_wth-doc.doc-code
     3713           and buf_out-doc.source-type = 'док.МЦ':U
     3714           and buf_out-doc.borned no-error.
     3715       if available buf_out-doc then do:
     3716         if buf_out-doc.status_ <> 'факт':U then do:
     3717           undo, return error substitute('Нельзя удалять связанный документ не в статусе &1.&2Номер документа &3',
     3718                                         'факт':U,
     3719                                         chr(10),
     3720                                         buf_out-doc.doc-code
     3721                                         ).
     3722         end.
     3723         run trg/wthdocdl.p ( buf_out-doc.doc-code
     3724                             ,input parphchip-num
     3725                             ,input p-file-name-err
     3726                             ,output parchip-num
     3727                             ) no-error.
     3728           if error-status:error then do:
     3729                 undo, return error return-value.
     3730           end.
     3731           parphchip-num =  parchip-num .
     3732       end.
     3733     end.
     3734     if not g#news or (g#news and  g#db-num  = 0)  then do:
     3735   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3737     (input  buf_wth-doc.obj-type
     3738     ,input  buf_wth-doc.obj-code
     3739     ,output varobj-date
     3740     ) no-error .
     3741       if error-status :error
     3742       or varobj-date = ?
     3743       then do:
     3744         undo, return error   "Нет текущей даты на объекте продажи".
     3745       end.
     3746   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3747   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3748     (input  buf_wth-doc.obj-type
     3749     ,input  buf_wth-doc.obj-code
     3750     ,input  'shift-on=request'
     3751     ,output l-shift-on
     3752     )  .
     3753       if l-shift-on then do:
     3754   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3756     (input  buf_wth-doc.obj-type
     3757     ,input  buf_wth-doc.obj-code
     3758     ,output varshift-date
     3759     ,output varshift-num
     3760     ,output varshift-name
     3761     ) no-error .
     3762         if error-status :error then do:
     3763           undo, return error   "Ошибка при поиске текущей смены на объекте " .
     3764         end.
     3765       end.
     3766       else do:
     3767         assign
     3768           varshift-date = ?
     3769           varshift-num  = ?.
     3770       end.
     3771       run trg/lock-wth.p
     3772         (input p-doc-code
     3773         ,input yes
     3774         ,input buf_wth-doc.fact-order
     3775         ,input (buf_wth-doc.status_ = 'факт':U)
     3776         ,input g#news
     3777         ) no-error .
     3778       if error-status :error
     3779       then do:
     3780         message
     3781           "Не удалось наложить блокировку на все товары принадлежащие документу" skip
     3782           "Документ" buf_wth-doc.doc-code skip
     3783           error-status :get-message(1) skip
     3784           return-value skip
     3785           view-as alert-box information .
     3786         undo , return error .
     3787       end.
     3788     end.
     3789       assign
     3790         buf_wth-doc.is-del = true
     3791       .
     3792       if not g#news then do:
     3793         run hstc-wth-doc in this-procedure
     3794           (input recid(buf_wth-doc)
     3795           ,input varobj-date
     3796           ,input varshift-date
     3797           ,input varshift-num
     3798           ,input varshift-name
     3799           ,input g#userid
     3800           ,input buf_wth-doc.source-ref
     3801           ,input parphchip-num
     3802           ,output parchip-num
     3803           ) .
     3804       end.
     3805     if not g#news or (g#news and  g#db-num  = 0)  then do:
     3806       define buffer buf_chk-doc for ub.chk-doc.
     3807       define buffer buf_chk-pay for  ub.chk-pay.
     3808       define buffer buf_c-chk-doc for  ub.c-chk-doc.
     3809       define buffer buf_c-chk-pay for  ub.c-chk-pay.
     3810       for each buf_chk-doc exclusive-lock
     3811         where buf_chk-doc.out-code = buf_wth-doc.doc-code
     3812           and BUF_chk-doc.obj-type = buf_wth-doc.obj-type
     3813           and buf_chk-doc.obj-code = buf_wth-doc.obj-code
     3814       on error undo, return error
     3815       :
     3816       if  lookup(string(buf_chk-doc.chk-type),'2,3,4,5,7':U )  = 0 then next.
     3817         for each buf_chk-pay
     3818           where buf_chk-pay.doc-code = buf_chk-doc.doc-code
     3819         on error undo, return error
     3820         :
     3821           assign
     3822             buf_chk-pay.out-code = ?
     3823           .
     3824           if g#news then do:
     3825             delete buf_chk-pay.
     3826           end.
     3827         end.
     3828         for each buf_c-chk-doc
     3829           where buf_c-chk-doc.doc-code = buf_c-chk-doc.doc-code
     3830         on error undo, return error
     3831         :
     3832           assign
     3833             buf_c-chk-doc.out-code = ?
     3834           .
     3835           if g#news then do:
     3836             delete buf_c-chk-doc.
     3837           end.
     3838         end.
     3839         for each buf_c-chk-pay
     3840           where buf_c-chk-pay.doc-code = buf_c-chk-doc.doc-code
     3841         on error undo, return error
     3842         :
     3843           assign
     3844             buf_c-chk-pay.out-code = ?
     3845           .
     3846           if g#news then do:
     3847             delete buf_c-chk-pay.
     3848           end.
     3849         end.
     3850         assign
     3851           buf_chk-doc.out-code = ?
     3852         .
     3853         if g#news then do:
     3854           delete buf_chk-doc.
     3855         end.
     3856       end.
     3857       run wth-arhdoc-delete in this-procedure ( buf_wth-doc.doc-code
     3858                               )  no-error.
     3859       if error-status :error
     3860       then do:
     3861         undo Main-Block, return error return-value .
     3862       end.
     3863     end.
     3864     if buf_wth-doc.status_ = 'факт':U
     3865     and (not g#news or (g#news and  g#db-num  = 0))
     3866     then do:
     3867           run str/chkwthd.p
     3868             ( input p-doc-code
     3869             , p-file-name-err
     3870              ) no-error .
     3871           if error-status :error
     3872           then do:
     3873             undo Main-Block, return error return-value .
     3874           end.
     3875     end.
     3876     for each buf_wth-parts exclusive-lock
     3877       where buf_wth-parts.doc-code = buf_wth-doc.doc-code
     3878       on error undo Main-Block, return error return-value:
     3879       if lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 then delete buf_wth-parts.
     3880     end.
     3881     for each buf_wth-parts where buf_wth-parts.out-code = buf_wth-doc.doc-code
     3882       on error undo Main-Block, return error return-value:
     3883            run wth-doc-razrez in this-procedure
     3884             (INPUT RECID(buf_wth-parts),
     3885              input yes
     3886             ).
     3887     end.
     3888         define variable v-obj-type   as character no-undo .
     3889         define variable v-obj-code   as integer   no-undo .
     3890         define variable v-fact-order as decimal   no-undo .
     3891         define variable v-doc-code     like ub.wth-doc.doc-code no-undo .
     3892         define variable v-fact-date    like ub.wth-doc.fact-date     no-undo .
     3893         define variable v-user-db-num  like ub.wth-doc.user-db-num   no-undo .
     3894         define variable v-user-name    like ub.wth-doc.user-name     no-undo .
     3895         define variable v-sys-date     like ub.wth-doc.sys-date      no-undo .
     3896         define variable v-sys-time-int like ub.wth-doc.sys-time-int  no-undo .
     3897         define variable v-sys-time     like ub.wth-doc.sys-time      no-undo .
     3898         assign
     3899           v-obj-type   = buf_wth-doc.obj-type
     3900           v-obj-code   = buf_wth-doc.obj-code
     3901           v-fact-order = buf_wth-doc.fact-order
     3902           v-doc-code   = buf_wth-doc.doc-code
     3903           v-fact-date  = buf_wth-doc.fact-date
     3904           v-user-db-num = buf_wth-doc.user-db-num
     3905           v-user-name   = buf_wth-doc.user-name
     3906           v-sys-date   = buf_wth-doc.sys-date
     3907           v-sys-time   = buf_wth-doc.sys-time
     3908           v-sys-time-int   = buf_wth-doc.sys-time-int
     3909         .
     3910         delete buf_wth-doc .
     3911      if not g#news or (g#news and  g#db-num  = 0)  then do:
     3912         run str/reclcwtf.p
     3913           (input v-obj-type
     3914           ,input v-obj-code
     3915           ,input v-fact-order
     3916           ,input no
     3917           ,input 'delete':U
     3918           ,input v-doc-code
     3919           ,input v-fact-date
     3920           ,input v-user-db-num
     3921           ,input v-user-name
     3922           ,input v-sys-date
     3923           ,input v-sys-time-int
     3924           ,input v-sys-time
     3925           ) .
     3926       end.
     3927     end.
     3928   procedure hstc-wth-doc :
     3929     define input parameter parrec-wth-doc as   recid                 no-undo.
     3930     define input parameter parobj-date    as   date                    no-undo.
     3931     define input parameter parshift-date  like ub.shift-obj.shift-date no-undo.
     3932     define input parameter parshift-num   like ub.shift-obj.shift-num  no-undo.
     3933     define input parameter parshift-name  like ub.shift-obj.shift-name no-undo.
     3934     define input parameter paruserid      as   character               no-undo.
     3935     define input parameter parout-code    like ub.wth-doc.source-ref   no-undo.
     3936     define input  parameter parphchip-num      as   integer                      no-undo.
     3937     define output parameter parchip-num        as   integer                      no-undo.
     3938     define buffer hstc_wth-doc          for ub.wth-doc.
     3939     define buffer hstc_wth-line         for ub.wth-line.
     3940     define buffer hstc_wth-dtl          for ub.wth-dtl.
     3941     define buffer hstc_wth-parts        for ub.wth-parts.
     3942     define buffer hstc_c-wth-doc        for ub.c-wth-doc.
     3943     define buffer hstc_c-wth-line       for ub.c-wth-line.
     3944     define buffer hstc_c-wth-dtl        for ub.c-wth-dtl.
     3945     define buffer hstc_c-wth-parts      for ub.c-wth-parts.
     3946     define buffer hstc_inkas-pay-wth    for ub.inkas-pay-wth.
     3947     define buffer hstc_c-inkas-pay-wth  for ub.c-inkas-pay-wth.
     3948     do
     3949     on error undo, return error return-value
     3950     :
     3951       find first hstc_wth-doc
     3952         where recid (hstc_wth-doc) = parrec-wth-doc
     3953         .
     3954       create hstc_c-wth-doc .
     3955       buffer-copy hstc_wth-doc to hstc_c-wth-doc .
     3956       assign
     3957         hstc_c-wth-doc.chip-num        = (if parphchip-num <> ?
     3958                                          then parphchip-num
     3959                                          else next-value(s-corr-chip, ub))
     3960         hstc_c-wth-doc.corr-inkas-code = buf_wth-doc.source-ref
     3961         hstc_c-wth-doc.corr-date       = parobj-date
     3962         hstc_c-wth-doc.corr-shift-date = parshift-date
     3963         hstc_c-wth-doc.corr-shift-num  = parshift-num
     3964         hstc_c-wth-doc.corr-shift-name  = parshift-name
     3965         hstc_c-wth-doc.corr-user-name        = paruserid
     3966         hstc_c-wth-doc.corr-user-db-num = g#db-num
     3967       .
     3968       for each hstc_wth-line
     3969         where hstc_wth-line.doc-code = hstc_wth-doc.doc-code
     3970       on error undo, return error
     3971       :
     3972         create hstc_c-wth-line.
     3973         buffer-copy hstc_wth-line to hstc_c-wth-line.
     3974         assign
     3975         hstc_c-wth-line.corr-user-db-num = hstc_c-wth-doc.corr-user-db-num
     3976         hstc_c-wth-line.chip-num = hstc_c-wth-doc.chip-num
     3977         .
     3978       end.
     3979       for each hstc_wth-dtl
     3980         where hstc_wth-dtl.doc-code = hstc_wth-doc.doc-code
     3981       on error undo, return error
     3982       :
     3983         create hstc_c-wth-dtl.
     3984         buffer-copy hstc_wth-dtl to hstc_c-wth-dtl.
     3985         assign
     3986         hstc_c-wth-dtl.corr-user-db-num = hstc_c-wth-doc.corr-user-db-num
     3987         hstc_c-wth-dtl.chip-num = hstc_c-wth-doc.chip-num
     3988         .
     3989       end.
     3990       for each hstc_wth-parts
     3991         where hstc_wth-parts.out-code = hstc_wth-doc.doc-code
     3992       on error undo, return error
     3993       :
     3994         create hstc_c-wth-parts.
     3995         buffer-copy hstc_wth-parts to hstc_c-wth-parts.
     3996         assign
     3997         hstc_c-wth-parts.corr-user-db-num = hstc_c-wth-doc.corr-user-db-num
     3998         hstc_c-wth-parts.chip-num = hstc_c-wth-doc.chip-num
     3999         .
     4000       end.
     4001       for each hstc_inkas-pay-wth where
     4002               hstc_inkas-pay-wth.inkas-code = hstc_wth-doc.doc-code
     4003       on error undo, return error
     4004               :
     4005         create hstc_c-inkas-pay-wth.
     4006         buffer-copy hstc_inkas-pay-wth to hstc_c-inkas-pay-wth.
     4007         assign
     4008           hstc_c-inkas-pay-wth.chip-num = hstc_c-wth-doc.chip-num
     4009           hstc_c-inkas-pay-wth.corr-user-db-num = hstc_c-wth-doc.corr-user-db-num
     4010           .
     4011       end.
     4012       assign
     4013       parchip-num = hstc_c-wth-doc.chip-num
     4014       .
     4015     end.
     4016   end procedure.
