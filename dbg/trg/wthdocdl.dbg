     1220   define variable v-trn-pay-code  as integer   no-undo .
     1221   define variable v-cash-pay-curr as integer   no-undo .
     1222   define variable v-cash-pay-code as integer   no-undo .
     1223   do
     1224   on error undo, return error return-value
     1225   :
     1226   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1227   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1228   if p-fact-order = ? then do:
     1229     run fact-order-mpl (
     1230         input   today       ,
     1231         input   p-obj-type  ,
     1232         input   p-obj-code  ,
     1233         output  p-fact-order ).
     1234   end.
     1235   if p-vid-pay <> "" then do:
     1236      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1237      if available buf_pay-type
     1238         then v-trn-pay-code = buf_pay-type.obj-code.
     1239         else v-trn-pay-code =  0.
     1240   end.
     1241   else v-trn-pay-code = 0 .
     1242   if p-cash-pay-type <> "" then do:
     1243      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1244      if available buf_pay-type
     1245         then
     1246           assign
     1247             v-cash-pay-curr = buf_cash-pay.curr-code
     1248             v-cash-pay-code = buf_cash-pay.cdpay-code
     1249           .
     1250         else
     1251           assign
     1252             v-cash-pay-curr = 0
     1253             v-cash-pay-code = 0
     1254             .
     1255   end.
     1256   else
     1257     assign
     1258       v-cash-pay-curr = 0
     1259       v-cash-pay-code = 0
     1260       .
     1261   for each tt_price-all  : delete tt_price-all . end.
     1262   assign
     1263     p-plt-id             = ?
     1264     p-plt-db-num         = ?
     1265     p-pdf-id             = ?
     1266     p-pdf-db-num         = ?
     1267     p-sale-price-base    = ?
     1268     p-sale-price-rubl    = ?
     1269     v-cli-oborot         = 0
     1270   .
