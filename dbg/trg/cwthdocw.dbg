        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-wth-doc old buffer old-c-doc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись документа".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                             ,ub.c-wth-doc.doc-code
       30                             ,ub.c-wth-doc.ext-doc-type
       31                             ,ub.c-wth-doc.status_
       32                             ,ub.c-wth-doc.corr-user-db-num
       33                             ,ub.c-wth-doc.chip-num)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-host-code like c-wth-doc.host-code no-undo.
       87   main-block:
       88   do
       89   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       90   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       91   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       92   :
       93     find first ub.clients no-lock
       94       where ub.clients.obj-type = ub.c-wth-doc.obj-type
       95         and ub.clients.obj-code = ub.c-wth-doc.obj-code
       96       no-error .
       97     if not available ub.clients then do:
       98       message
       99         vss-workfile vss-revision vss-description skip
      100         "Неправильная ссылка на объект" skip
      101         "Документ МЦ" ub.c-wth-doc.doc-code skip
      102         "Не найден объект" ub.c-wth-doc.obj-type ub.c-wth-doc.obj-code skip
      103         view-as alert-box error .
      104       undo main-block, return error .
      105     end.
      106   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      108     (input  ub.c-wth-doc.obj-type
      109     ,input  ub.c-wth-doc.obj-code
      110     ,output v-host-code
      111     ) no-error .
      112     if error-status :error then do:
      113       message
      114        vss-workfile vss-revision vss-description skip
      115        "Ошика при определении кода фирмы для объекта" skip
      116        "Документ " ub.c-wth-doc.doc-code skip
      117        "obj-type" ub.c-wth-doc.obj-type skip
      118        "obj-code" ub.c-wth-doc.obj-code skip
      119        error-status :get-message(1) skip
      120        return-value skip
      121        view-as alert-box error .
      122       undo main-block, return error .
      123     end.
      124     if ub.c-wth-doc.host-code <> v-host-code then do:
      125       message
      126         vss-workfile vss-revision vss-description skip
      127         "Неправильно заполнено поле фирма" skip
      128         "Документ МЦ" ub.c-wth-doc.doc-code skip
      129         "Объект"  ub.c-wth-doc.obj-type ub.c-wth-doc.obj-code skip
      130         "Фирма"   ub.c-wth-doc.host-code skip
      131         "Должна быть фирма" v-host-code skip
      132         view-as alert-box error .
      133       undo main-block, return error .
      134     end.
      135     if  not g#news
      136     and ub.c-wth-doc.corr-user-name = "" then do:
      137       assign
      138         ub.c-wth-doc.corr-user-name = g#userid
      139       .
      140     end.
      141     if not g#news
      142     and ub.c-wth-doc.is-del
      143     AND ub.c-wth-doc.status_ = 'факт':U
      144     then do:
      145       run str/callnews.p
      146          (input 'c-wth-doc':U
      147          ,input (buffer ub.c-wth-doc:handle)
      148          ) no-error .
      149       if error-status :error then do:
      150         message
      151           vss-workfile vss-revision vss-description skip
      152           "Невозможно маршрутизировать c-wth-doc для отправки в новости" skip
      153           error-status :get-message(1) skip
      154           return-value skip
      155           view-as alert-box error .
      156         undo main-block, return error .
      157       end.
      158     end.
      159       if g#oxml = yes
      160       then do:
      161       run str/calloxml.p (
      162             input 'update':U
      163           , input 'c-wth-doc':U
      164           , input ( buffer ub.c-wth-doc:handle )
      165       ) no-error.
      166       if error-status :error
      167       then do:
      168           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      169                                , chr(10)
      170                                , vss-workfile
      171                                , return-value
      172                                , error-status :get-message ( 1 ) ).
      173       end.
      174       end.
      175   end.
