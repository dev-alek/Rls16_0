        1   block-level on error undo, throw.
        2   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
        4   define input parameter p-action    as character no-undo .
        5   define input parameter p-new-value as logical   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Проверка того, что можно изменить признак объекта".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   main-block:
       82   do
       83   on error undo main-block, return error
       84   :
       85     define buffer buf_clients for ub.clients .
       86     define buffer buf_db for ub.db .
       87     if p-new-value = ? then do:
       88       message
       89         vss-workfile vss-revision vss-description skip
       90         "Ошибка задания входных параметров" skip
       91         "Неизвестное значение параметра p-new-value" skip
       92         "Объект" p-obj-type p-obj-code skip
       93         view-as alert-box error .
       94       undo, return error .
       95     end.
       96     case p-action :
       97       when "doc-prt":u then do:
       98         if p-new-value = false then do:
       99           message
      100             "Включенные шкалы не выключаются" skip
      101             "Объект" p-obj-type p-obj-code skip
      102             view-as alert-box information .
      103           undo, return error.
      104         end.
      105         if p-new-value = true then do:
      106           if can-find( first ub.trn-doc
      107             where ub.trn-doc.obj-type = p-obj-type
      108               and ub.trn-doc.obj-code = p-obj-code
      109               and ub.trn-doc.status_  <> 'факт':U
      110           ) then do:
      111             message
      112               "На объекте имеются незакрытые документы"
      113               "Объект" p-obj-type p-obj-code skip
      114               view-as alert-box information .
      115             undo, return error.
      116           end.
      117         end.
      118       end.
      119       when "shift-on":u then do:
      120         find first buf_clients share-lock
      121           where buf_clients.obj-type = p-obj-type
      122             and buf_clients.obj-code = p-obj-code
      123           .
      124         find first buf_db no-lock
      125           where buf_db.db-num = buf_clients.db-num
      126           .
      127         if p-new-value = false then do:
      128           if can-find( first ub.trn-doc
      129             where ub.trn-doc.obj-type = p-obj-type
      130               and ub.trn-doc.obj-code = p-obj-code
      131           )
      132           or can-find( first ub.price-doc
      133             where ub.price-doc.obj-type = p-obj-type
      134               and ub.price-doc.obj-code = p-obj-code
      135           )
      136           or can-find( first ub.rvs-doc
      137             where ub.rvs-doc.obj-type = p-obj-type
      138               and ub.rvs-doc.obj-code = p-obj-code
      139           )
      140           or can-find( first ub.shift-obj
      141             where ub.shift-obj.obj-type = p-obj-type
      142               and ub.shift-obj.obj-code = p-obj-code
      143           )
      144           then do:
      145             message
      146               "На объекте существуют документы и/или смены" skip
      147               "Включенные смены нельзя выключить" skip
      148               "Объект" p-obj-type p-obj-code skip
      149               view-as alert-box information .
      150             undo, return error.
      151           end.
      152         end.
      153         else do:
      154           if p-obj-type = 'скл':U then do:
      155             message
      156               "Для склада нельзя включить сменную работу" skip
      157               "Объект" p-obj-type p-obj-code skip
      158               view-as alert-box information .
      159             undo, return error.
      160           end.
      161           if p-obj-type = 'маг':U then do:
      162             for each ub.cash-desk no-lock
      163               where ub.cash-desk.obj-code = p-obj-code
      164                 and ub.cash-desk.db-num   = buf_db.db-num
      165             :
      166                 if ub.cash-desk.pos-type <> 'IBM':U
      167                 and ub.cash-desk.pos-type <> 'IBM-XML':U
      168                 and ub.cash-desk.pos-type <> 'MARIA':U then do:
      169                 message
      170                   "У магазина имеются кассы с типом, отличным от IBM" skip
      171                   "Нельзя включить сменную работу для магазина" skip
      172                   "Объект" p-obj-type p-obj-code skip
      173                   view-as alert-box error .
      174                 undo, return error .
      175               end.
      176             end.
      177           end.
      178           if can-find( first ub.trn-doc
      179             where ub.trn-doc.obj-type = p-obj-type
      180               and ub.trn-doc.obj-code = p-obj-code
      181           ) then do:
      182             message
      183               "Нельзя включить сменную работу" skip
      184               "На объекте имеются складские документы" skip
      185               "Объект" p-obj-type p-obj-code skip
      186               view-as alert-box information .
      187             undo, return error.
      188           end.
      189           if can-find( first ub.price-doc
      190             where ub.price-doc.obj-type = p-obj-type
      191               and ub.price-doc.obj-code = p-obj-code
      192           ) then do:
      193             message
      194               "Нельзя включить сменную работу" skip
      195               "На объекте имеются документы переоценки" skip
      196               "Объект" p-obj-type p-obj-code skip
      197               view-as alert-box information .
      198             undo, return error.
      199           end.
      200           if can-find( first ub.rvs-doc
      201             where ub.rvs-doc.obj-type = p-obj-type
      202               and ub.rvs-doc.obj-code = p-obj-code
      203           ) then do:
      204             message
      205               "Нельзя включить сменную работу" skip
      206               "На объекте имеются документы сверки" skip
      207               "Объект" p-obj-type p-obj-code skip
      208               view-as alert-box information .
      209             undo, return error.
      210           end.
      211         end.
      212         if buf_db.db-num > 0
      213           and trim( buf_db.db-key ) <> "":U
      214           and buf_db.db-key <> ?
      215         then do:
      216             message
      217               substitute( "Нельзя &1 сменную работу", (if p-new-value = true then "включать" else "выключать") )  skip
      218               "УБД уже существует и возможно на объекте уже созданы документы" skip
      219               substitute( "Объект &1 &2 для БД &3", p-obj-type, p-obj-code, buf_db.db-num ) skip
      220               view-as alert-box information .
      221             undo, return error.
      222         end.
      223       end.
      224       otherwise do:
      225         message
      226           vss-workfile vss-revision vss-description skip
      227           "Ошибка задания входных параметров" skip
      228           "Неизвестное значение p-action" skip
      229           "Объект" p-obj-type p-obj-code skip
      230           "p-action" p-action skip
      231           view-as alert-box error .
      232         undo, return error .
      233       end.
      234     end.
      235   end.
