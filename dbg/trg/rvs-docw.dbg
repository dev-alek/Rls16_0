        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.rvs-doc old buffer buf-old_rvs-doc.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Триггер на запись документа сверки ":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78     define new global shared variable g#lib-rvs as handle no-undo.
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure factord :
       81     define input  parameter p-fact-date            as date    no-undo .
       82     define input  parameter p-fact-time            as integer no-undo .
       83     define input  parameter p-fact-num             as integer no-undo .
       84     define input  parameter p-shift-date           as date    no-undo .
       85     define input  parameter p-shift-num            as integer no-undo .
       86     define input  parameter p-shift-on             as logical no-undo .
       87     define output parameter p-fact-order           as decimal no-undo .
       88     define output parameter p-shift-end-fact-order as decimal no-undo .
       89     define output parameter p-day-end-fact-order   as decimal no-undo .
       90     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       91     if p-fact-date = ?
       92     then do:
       93       return error "Не указана фактическая дата" .
       94     end.
       95     define variable v-fact-date-num as integer no-undo .
       96     assign
       97       v-fact-date-num = integer(p-fact-date)
       98     .
       99     if p-fact-num = ?
      100     or p-fact-num = 0
      101     then do:
      102       return error "Не задан p-fact-num " + string(p-fact-num) .
      103     end.
      104     if p-fact-num < 0
      105     then do:
      106       return error "Отрицательный fact-num " + string(p-fact-num) .
      107     end.
      108     if p-fact-num >= 100000000
      109     then do:
      110       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      111     end.
      112     if p-shift-on = true
      113     then do:
      114       if p-shift-date = ?
      115       then do:
      116         return error "Не задана дата смены" .
      117       end.
      118       if p-shift-num = ?
      119       or p-shift-num = 0
      120       then do:
      121         return error "Не задан номер смены" .
      122       end.
      123     end.
      124     else do:
      125       assign
      126         p-shift-date = p-fact-date
      127         p-shift-num  = 24
      128       .
      129     end.
      130     define variable v-shift-offset as integer no-undo .
      131     if p-shift-date = p-fact-date
      132     then do:
      133       assign
      134         v-shift-offset = 1
      135       .
      136     end.
      137     if p-shift-date < p-fact-date
      138     then do:
      139       assign
      140         v-shift-offset = 0
      141       .
      142     end.
      143     if p-shift-date > p-fact-date
      144     then do:
      145       message
      146         vss-workfile vss-revision vss-description skip
      147         "Неправильная дата закрытия смены" skip
      148         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      149         view-as alert-box error .
      150       undo, return error
      151         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      152           ,string(p-fact-date, '99/99/9999':U)
      153           ,string(p-shift-date, '99/99/9999':U)
      154           )
      155       .
      156     end.
      157     if p-shift-num < 1
      158     or p-shift-num > 24
      159     then do:
      160       message
      161         vss-workfile vss-revision vss-description skip
      162         "Неправильный номер смены" skip
      163         "p-shift-num" p-shift-num skip
      164         view-as alert-box error .
      165       undo, return error return-value .
      166     end.
      167     assign
      168       p-fact-order           = v-fact-date-num
      169                              + v-shift-offset * 0.5
      170                              + p-shift-num    * 0.02 - 0.01
      171                              + p-fact-num     * 0.0000000001
      172       p-shift-end-fact-order = v-fact-date-num
      173                              + v-shift-offset * 0.5
      174                              + p-shift-num    * 0.02
      175       p-day-end-fact-order   = v-fact-date-num
      176                              + 0.99
      177     .
      178     if p-fact-order           <= v-fact-date-num
      179     or p-shift-end-fact-order <= v-fact-date-num
      180     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      181     or p-shift-end-fact-order >= p-day-end-fact-order
      182     then do:
      183       message
      184         vss-workfile vss-revision vss-description skip
      185         "Внутренняя ошибка при генерации фактического номера" skip
      186         "p-fact-date"            p-fact-date            skip
      187         "p-fact-time"            p-fact-time            skip
      188         "p-fact-num"             p-fact-num             skip
      189         "p-shift-date"           p-shift-date           skip
      190         "p-shift-num"            p-shift-num            skip
      191         "p-shift-on"             p-shift-on             skip
      192         "p-shift-end-fact-order" p-shift-end-fact-order skip
      193         "p-day-end-fact-order"   p-day-end-fact-order   skip
      194         "v-fact-date-num"        v-fact-date-num        skip
      195         view-as alert-box error .
      196       undo, return error return-value .
      197     end.
      198   end procedure.
      199   procedure day-begin-fact-order :
      200     define input  parameter p-fact-date            as date    no-undo .
      201     define output parameter p-day-begin-fact-order as decimal no-undo .
      202     do
      203     on error undo, return error return-value
      204     :
      205       if p-fact-date = ?
      206       then do:
      207         assign
      208           p-day-begin-fact-order = 0
      209         .
      210       end.
      211       else do:
      212         assign
      213           p-day-begin-fact-order = integer(p-fact-date)
      214         .
      215       end.
      216     end.
      217   end procedure.
      218   procedure factord-max-fact-order :
      219     define output parameter p-max-fact-order as decimal   no-undo .
      220     do
      221     on error undo, return error return-value
      222     :
      223       run day-begin-fact-order in this-procedure
      224         (input  date(1, 1, 5000)
      225         ,output p-max-fact-order
      226         ) .
      227     end.
      228   end procedure.
      229   procedure factord-cut-archive :
      230     define input  parameter p-obj-type             as character no-undo .
      231     define input  parameter p-obj-code             as integer   no-undo .
      232     define input  parameter p-fact-date            as date      no-undo .
      233     define output parameter p-shift-on             as logical   no-undo .
      234     define output parameter p-shift-date           as date      no-undo .
      235     define output parameter p-shift-num            as integer   no-undo .
      236     define output parameter p-day-end-fact-order   as decimal   no-undo .
      237     define output parameter p-shift-end-fact-order as decimal   no-undo .
      238     define variable v-fact-order as decimal   no-undo .
      239     define buffer buf_shift-obj for ub.shift-obj .
      240     do
      241     on error undo, return error return-value
      242     :
      243   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      245     (input  p-obj-type
      246     ,input  p-obj-code
      247     ,input  'shift-on=request'
      248     ,output p-shift-on
      249     ) no-error .
      250       if error-status :error
      251       then do:
      252         message
      253           vss-workfile vss-revision vss-description skip
      254           "Ошибка при определении атрибута объекта" skip
      255           "Объект" p-obj-type p-obj-code skip
      256           error-status :get-message(1) skip
      257           return-value skip
      258           view-as alert-box error .
      259         undo, return error return-value .
      260       end.
      261       if p-shift-on = false
      262       then do:
      263         assign
      264           p-shift-date               = ?
      265           p-shift-num                = 0
      266         .
      267       end.
      268       else do:
      269         find first buf_shift-obj share-lock
      270           where buf_shift-obj.obj-type   = p-obj-type
      271             and buf_shift-obj.obj-code   = p-obj-code
      272             and buf_shift-obj.shift-date > p-fact-date
      273           use-index pi
      274           no-error .
      275         if not available buf_shift-obj
      276         or buf_shift-obj.status_ <> 'зкр':U
      277         then do:
      278           message
      279             vss-workfile vss-revision vss-description skip
      280             "Невозможно вычислить последнюю смену" skip
      281             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      282             "Объект" p-obj-type p-obj-code skip
      283             "Дата" p-fact-date skip
      284             view-as alert-box error .
      285           undo, return error return-value .
      286         end.
      287         find last buf_shift-obj share-lock
      288           where buf_shift-obj.obj-type = p-obj-type
      289             and buf_shift-obj.obj-code = p-obj-code
      290             and buf_shift-obj.shift-date <= p-fact-date
      291           use-index pi
      292           no-error .
      293         if available buf_shift-obj
      294         then do:
      295           if  buf_shift-obj.status_ = 'зкр':U
      296           then do:
      297             assign
      298               p-shift-date = buf_shift-obj.shift-date
      299               p-shift-num  = buf_shift-obj.shift-num
      300             .
      301           end.
      302           else do:
      303             message
      304               vss-workfile vss-revision vss-description skip
      305               "Невозможно вычислить последнюю смену" skip
      306               "Статус смены отличен от статуса" 'зкр':U skip
      307               "Объект" p-obj-type p-obj-code skip
      308               "Дата" p-fact-date skip
      309               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      310               view-as alert-box error .
      311             undo, return error return-value .
      312           end.
      313         end.
      314         else do:
      315           assign
      316             p-shift-date = p-fact-date - 1
      317             p-shift-num  = 1
      318           .
      319         end.
      320       end.
      321       run factord in this-procedure
      322         (input  p-fact-date
      323         ,input  1
      324         ,input  1
      325         ,input  p-shift-date
      326         ,input  p-shift-num
      327         ,input  p-shift-on
      328         ,output v-fact-order
      329         ,output p-shift-end-fact-order
      330         ,output p-day-end-fact-order
      331         ) no-error .
      332       if error-status :error
      333       then do:
      334         message
      335           vss-workfile vss-revision vss-description skip
      336           "Ошибка при вызове процедуры factord"
      337           error-status :get-message(1) skip
      338           return-value skip
      339           view-as alert-box error .
      340         undo, return error return-value .
      341       end.
      342     end.
      343   end procedure.
      344   procedure factord-lock-shift :
      345     define input  parameter p-obj-type  as character no-undo .
      346     define input  parameter p-obj-code  as integer   no-undo .
      347     define input  parameter p-fact-date as date      no-undo .
      348     define parameter buffer buf_shift-obj for ub.shift-obj .
      349     define variable v-shift-on      as logical   no-undo .
      350     define variable v-extra-message as character no-undo .
      351     define variable v-error as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      357     (input  p-obj-type
      358     ,input  p-obj-code
      359     ,input  'shift-on=request'
      360     ,output v-shift-on
      361     ) no-error .
      362       if error-status :error
      363       then do:
      364         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      365         undo, return error v-error .
      366       end.
      367       if v-shift-on = true
      368       then do:
      369         find first buf_shift-obj share-lock
      370           where buf_shift-obj.obj-type   = p-obj-type
      371             and buf_shift-obj.obj-code   = p-obj-code
      372             and buf_shift-obj.shift-date > p-fact-date
      373           use-index pi
      374           no-error .
      375         if not available buf_shift-obj
      376         or buf_shift-obj.status_ <> 'зкр':U
      377         then do:
      378           find last buf_shift-obj
      379             where buf_shift-obj.obj-type = p-obj-type
      380               and buf_shift-obj.obj-code = p-obj-code
      381               and buf_shift-obj.status_  = 'зкр':U
      382             use-index stts
      383             no-error .
      384           if available buf_shift-obj
      385           then do:
      386             assign
      387               v-extra-message =
      388                     substitute("Дата начала последеней закрытой смены на объекте &1"
      389                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      390                               )
      391             .
      392           end.
      393           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      394           undo, return error v-error .
      395         end.
      396       end.
      397     end.
      398   end procedure.
      399   procedure factord-end-day :
      400     define input  parameter p-fact-date            as date    no-undo .
      401     define output parameter p-day-end-fact-order   as decimal no-undo .
      402     do
      403     on error undo, return error return-value
      404     :
      405       if p-fact-date = ?
      406       then do:
      407         return error "Не указана фактическая дата" .
      408       end.
      409       assign
      410         p-day-end-fact-order = integer(p-fact-date) + 0.99
      411       .
      412     end.
      413   end procedure.
      414   procedure factord-to-date :
      415     define input  parameter p-fact-order as decimal no-undo .
      416     define output parameter p-fact-date  as date    no-undo .
      417     define variable v-ref-date  as date      no-undo .
      418     define variable v-ref-delta as integer   no-undo .
      419     do
      420     on error undo, return error return-value
      421     :
      422       if p-fact-order = ?
      423       or p-fact-order = 0
      424       then do:
      425         return error "Не указан fact-order" .
      426       end.
      427       assign
      428         v-ref-date  = date(1, 1, 2000)
      429       .
      430       assign
      431         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      432       .
      433       assign
      434         p-fact-date = v-ref-date + v-ref-delta
      435       .
      436     end.
      437   end procedure.
      438   procedure factord-to-fact-num :
      439     define input  parameter p-fact-order as decimal no-undo .
      440     define output parameter p-fact-num   as integer no-undo .
      441     define variable v-fact-order-trunc as decimal no-undo .
      442     do
      443     on error undo, return error return-value
      444     :
      445       if p-fact-order = ?
      446       or p-fact-order = 0
      447       then do:
      448         return error "Не указан fact-order" .
      449       end.
      450       assign
      451        v-fact-order-trunc = truncate(p-fact-order, 2)
      452       .
      453       assign
      454         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      455       .
      456     end.
      457   end procedure.
      458   procedure factord-to-shift-num :
      459     define input  parameter p-fact-order as decimal no-undo .
      460     define output parameter p-shift-num   as integer no-undo .
      461     define variable  p-shift-numd  as decimal   no-undo .
      462     define variable v-fact-order-trunc as decimal no-undo .
      463     do
      464     on error undo, return error return-value
      465     :
      466       if p-fact-order = ?
      467       or p-fact-order = 0
      468       then do:
      469         return error "Не указан fact-order" .
      470       end.
      471       assign
      472        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      473       .
      474       if v-fact-order-trunc < 0.5 then do:
      475         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      476       end.
      477       assign
      478         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      479         .
      480        assign
      481         p-shift-num = truncate (p-shift-numd , 0)
      482       .
      483     end.
      484   end procedure.
      485   define variable v-host-code     like ub.rvs-doc.host-code no-undo.
      486   define variable varis-back-date as logical   no-undo initial "no".
      487   define variable v-vid-ok        as logical   no-undo .
      488   define variable v-vid-mes       as character no-undo .
      489   define variable v-vid-action    as integer   no-undo .
      490   define variable v-vid-param     as longchar  no-undo .
      491   define variable v-mess          as character no-undo.
      492   define buffer buf_rvs-doc    for ub.rvs-doc .
      493   define buffer before_rvs-doc for ub.rvs-doc .
      494   define buffer after_rvs-doc  for ub.rvs-doc .
      495   define variable varshift-date as date    no-undo.
      496   define variable varshift-num  as integer no-undo.
      497   define variable varshift-name as char    no-undo.
      498   main-block:
      499   do
      500       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      501       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      502       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      503       :
      504   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      506     (input  ub.rvs-doc.obj-type
      507     ,input  ub.rvs-doc.obj-code
      508     ,output varshift-date
      509     ,output varshift-num
      510     ,output varshift-name
      511     ) no-error .
      512       find first ub.clients no-lock
      513           where ub.clients.obj-type = ub.rvs-doc.obj-type
      514           and ub.clients.obj-code = ub.rvs-doc.obj-code
      515           no-error .
      516       if not available ub.clients then
      517       do:
      518           message
      519               vss-workfile vss-revision vss-description skip
      520               "Неправильная ссылка на объект" skip
      521               "Документ сверки" ub.rvs-doc.rvs-code skip
      522               "Не найден объект" ub.rvs-doc.obj-type ub.rvs-doc.obj-code skip
      523               view-as alert-box error .
      524           undo main-block, return error .
      525       end.
      526       run trg/chkdocnm.p
      527           (input ub.rvs-doc.rvs-code
      528           ,input 'rvs-doc':U
      529           ,input recid(ub.rvs-doc)
      530           ) no-error .
      531       if error-status :error then
      532       do:
      533           message
      534               vss-workfile vss-revision vss-description skip
      535               "Ошибка при проверке уникальности кода документа" skip
      536               "Документ сверки" ub.rvs-doc.rvs-code skip
      537               error-status :get-message(1) skip
      538               return-value skip
      539               view-as alert-box error .
      540           undo main-block, return error .
      541       end.
      542       if  ub.rvs-doc.status_ <> 'новый':U
      543           and ub.rvs-doc.status_ <> 'разрешен':U
      544           and ub.rvs-doc.status_ <> 'нередакт':U
      545           and ub.rvs-doc.status_ <> 'факт':U then
      546       do:
      547           message
      548               vss-workfile vss-revision vss-description skip
      549               "Неправильный статус документа сверки" skip
      550               "Документ сверки" ub.rvs-doc.rvs-code skip
      551               "Статус" ub.rvs-doc.status_ skip
      552               view-as alert-box error .
      553           undo main-block, return error .
      554       end.
      555       if g#news <> yes
      556           and buf-old_rvs-doc.status_ <> ub.rvs-doc.status_
      557           then
      558       do:
      559   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
      561     (output ub.rvs-doc.user-db-num
      562     ,output ub.rvs-doc.user-name
      563     ,output ub.rvs-doc.sys-date
      564     ,output ub.rvs-doc.sys-time
      565     ,output ub.rvs-doc.sys-time-int
      566     )  .
      567       end.
      568       if g#news <> yes
      569           and ( buf-old_rvs-doc.status_ <> ub.rvs-doc.status_
      570           or ( new ub.rvs-doc )
      571           )
      572           then
      573       do:
      574   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_hstc-rvs in g#lib-rvs
      575   ( buffer ub.rvs-doc
      576    ,input integer( (if new ub.rvs-doc then '1':U else '2':U) )
      577    ,input ub.rvs-doc.rvs-code
      578    ,input dynamic-next-value('s-corr-chip':U,'ub':U)
      579   ) no-error.
      580           if error-status :error then
      581           do:
      582               message
      583                   vss-workfile vss-revision vss-description skip
      584                   substitute("Ошибка записи истории создания/изменения документа сверки &1", ub.rvs-doc.rvs-code ) skip
      585                   error-status :get-message(1) skip
      586                   return-value skip
      587                   view-as alert-box error .
      588               undo main-block, return error .
      589           end.
      590       end.
      591       if buf-old_rvs-doc.status_ = ub.rvs-doc.status_ then
      592       do:
      593           return .
      594       end.
      595       if not new ub.rvs-doc
      596           and buf-old_rvs-doc.status_ = 'факт':U
      597           and ub.rvs-doc.status_     <> 'факт':U then
      598       do:
      599           message
      600               vss-workfile vss-revision vss-description skip
      601               "Документ сверки" ub.rvs-doc.rvs-code skip
      602               "Документ закрыт до статуса" 'факт':U skip
      603               "Нельзя изменить статус документа на " ub.rvs-doc.status_ skip
      604               "Изменение статуса документа невозможно" skip
      605               view-as alert-box error .
      606           undo main-block, return error .
      607       end.
      608   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      610     (input  ub.rvs-doc.obj-type
      611     ,input  ub.rvs-doc.obj-code
      612     ,output v-host-code
      613     ) no-error .
      614       if error-status :error then
      615       do:
      616           message
      617               vss-workfile vss-revision vss-description skip
      618               "Ошика при определении кода фирмы для объекта" skip
      619               "Документ сверки" ub.rvs-doc.rvs-code skip
      620               "obj-type" ub.rvs-doc.obj-type skip
      621               "obj-code" ub.rvs-doc.obj-code skip
      622               error-status :get-message(1) skip
      623               return-value skip
      624               view-as alert-box error .
      625           undo main-block, return error .
      626       end.
      627       if ub.rvs-doc.host-code <> v-host-code then
      628       do:
      629           message
      630               vss-workfile vss-revision vss-description skip
      631               "Неправильно заполнено поле фирма" skip
      632               "Документ сверки" ub.rvs-doc.rvs-code skip
      633               "Объект"  ub.rvs-doc.obj-type ub.rvs-doc.obj-code skip
      634               "Фирма"   ub.rvs-doc.host-code skip
      635               "Должна быть фирма" v-host-code skip
      636               view-as alert-box error .
      637           undo main-block, return error .
      638       end.
      639       if g#news = false
      640       and ub.rvs-doc.rvs-type <> 'проверка':U
      641       then do:
      642           run str/chk-rvs.p (input recid(ub.rvs-doc)) no-error.
      643           if error-status :error then
      644           do:
      645               message
      646                   vss-workfile vss-revision vss-description skip
      647                   "Ошибка при проверке сверки" skip
      648                   "Документ сверки" ub.rvs-doc.rvs-code skip
      649                   error-status :get-message(1) skip
      650                   return-value skip
      651                   view-as alert-box error .
      652               undo main-block, return error return-value + error-status :get-message(1) .
      653           end.
      654       end.
      655       if ub.rvs-doc.status_ = 'разрешен':U
      656           or ub.rvs-doc.status_ = 'нередакт':U
      657           or ( ub.rvs-doc.status_ = 'факт':U
      658           and g#news = false
      659           )
      660       and ub.rvs-doc.rvs-type <> 'проверка':U
      661           then
      662       do:
      663           run trg/lock-rvs.p
      664               ( input ub.rvs-doc.rvs-code
      665               , input "check-rvs-on=true"
      666               , input ""
      667               , input yes
      668               ) no-error.
      669           if error-status :error then
      670           do:
      671               message
      672                   vss-workfile vss-revision vss-description skip
      673                   "Не заблокированы товары документа сверки" skip
      674                   "Документ сверки" ub.rvs-doc.rvs-code skip
      675                   "Статус" ub.rvs-doc.status_ skip
      676                   error-status :get-message(1) skip
      677                   return-value skip
      678                   view-as alert-box error .
      679               undo, return error .
      680           end.
      681       end.
      682       if ub.rvs-doc.status_ = 'факт':U then
      683       do:
      684           run change-status-fact in this-procedure
      685               no-error .
      686           if error-status :error then
      687           do:
      688               message
      689                   vss-workfile vss-revision vss-description skip
      690                   "Ошибка при выполнении программы change-status-fact" skip
      691                   "Документ сверки" ub.rvs-doc.rvs-code skip
      692                   error-status :get-message(1) skip
      693                   return-value skip
      694                   view-as alert-box error .
      695               undo main-block, return error .
      696           end.
      697       end.
      698       if g#news = false
      699           and ub.rvs-doc.creid = ""
      700           then
      701       do:
      702           assign
      703               ub.rvs-doc.creid = g#userid
      704               .
      705       end.
      706       if not g#news then
      707       do:
      708           if ub.rvs-doc.status_ = 'новый':U then
      709           do:
      710               if g#db-num <> 0
      711                   and not (new ub.rvs-doc)
      712                   then
      713               do:
      714                   run nws/cmd-del.p
      715                       ( input 'rvs-doc':U
      716                       ,input (buffer ub.rvs-doc:handle)
      717                       ,input "":U
      718                       ) no-error .
      719                   if error-status :error then
      720                   do:
      721                       undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      722                   end.
      723               end.
      724           end.
      725           else
      726           do:
      727               run str/callnews.p
      728                   (input 'rvs-doc':U
      729                   ,input (buffer ub.rvs-doc:handle)
      730                   ) no-error .
      731               if error-status :error then
      732               do:
      733                   undo, return error substitute( "&1. Невозможно маршрутизировать rvs-doc для отправки в новости. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      734               end.
      735           end.
      736       end.
      737       if g#oxml = yes then
      738       do:
      739           run str/calloxml.p
      740               ( input 'update':U
      741               ,input 'rvs-doc':U
      742               ,input ( buffer ub.rvs-doc:handle )
      743               ) no-error.
      744           if error-status :error then
      745           do:
      746               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      747                   ,chr(10)
      748                   ,vss-workfile
      749                   ,return-value
      750                   ,error-status :get-message ( 1 )
      751                   ).
      752           end.
      753       end.
      754       if ub.rvs-doc.rvs-type <> 'перед_док':U
      755           and ub.rvs-doc.rvs-type <> 'проверка':U
      756           and ( ub.rvs-doc.status_ = 'факт':U
      757           or ( ub.rvs-doc.status_ = 'новый':U
      758           and not new( ub.rvs-doc )
      759           )
      760           )
      761           then
      762       do:
      763           run trg/lock-rvs.p
      764               ( input ub.rvs-doc.rvs-code
      765               ,input "assign-rvs-on=false"
      766               ,input ""
      767               ,input false
      768               ) no-error.
      769           if error-status :error then
      770           do:
      771               undo, return error return-value .
      772           end.
      773       end.
      774       if  ub.rvs-doc.status_ = 'факт':U
      775       and ub.rvs-doc.rvs-type <> 'проверка':U
      776       and not g#news
      777       then do:
      778           v-mess = return-value.
      779           define variable v-person as character no-undo.
      780           for last  c-rvs-doc no-lock where
      781               c-rvs-doc.rvs-code = rvs-doc.rvs-code and
      782               c-rvs-doc.corr-user-db-num = g#db-num:
      783               for first  ub.clients where ub.clients.obj-type = 'чел':U and  ub.clients.obj-code = ub.rvs-doc.boss no-lock :
      784                   v-person = clients.obj-name.
      785               end.
      786   define variable v-initiator  as character no-undo.
      787   case true:
      788     when g#auto then v-initiator = "Auto".
      789     when g#news then v-initiator = "Nws".
      790     when g#esys then v-initiator = "Esys".
      791     otherwise v-initiator = "User".
      792   end case.
      793               v-vid-action = 58 .
      794               v-vid-param =
      795                   "Initiator=" + v-initiator + chr(4) +
      796                   "ResponsiblePerson=" + (if v-person <> ?  then v-person else "") + chr(4) +
      797                   "SHOP_NUM=" + string(ub.rvs-doc.obj-code) + chr(4) +
      798                   "DocType=" + string(ub.rvs-doc.rvs-type) + chr(4) +
      799                   "DocNum=" + string(ub.rvs-doc.rvs-code) + chr(4) +
      800                   "FactDate=" + (if ub.rvs-doc.status_ = 'факт':U then string(rvs-doc.fact-date) else "") + chr(4) +
      801                   "SHIFT_NUM_DOC=" + (if string( ub.rvs-doc.shift-num) = ? then '' else string( ub.rvs-doc.shift-num)) + (if string( ub.rvs-doc.shift-date) = ? then '' else string( ub.rvs-doc.shift-date , "99999999" )) + chr(4) +
      802                   "SHIFT_NUM=" + (if string(varshift-num) = ? then '' else string(varshift-num)) + (if string(varshift-date) = ? then '' else string(varshift-date, "99999999")) + chr(4) +
      803                   "StatusOld=" + string(buf-old_rvs-doc.status_) + chr(4) +
      804                   "StatusNew=" + string(ub.rvs-doc.status_) + chr(4) +
      805                   "RESULT=" + string( 0 ) + chr(4) +
      806                   "Description=" + v-mess no-error.
      807               run trg/userlog.p (
      808                   input 'update':U
      809                   , input 'c-rvs-doc':U
      810                   , input ( buffer ub.c-rvs-doc :handle )
      811                   , input v-vid-action
      812                   , input v-vid-param
      813                   ) no-error.
      814               if error-status :error
      815                   then
      816               do:
      817                   return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      818                       , chr(10)
      819                       , vss-workfile
      820                       , return-value
      821                       , error-status :get-message ( 1 ) ).
      822               end.
      823           end.
      824           for each rvs-line no-lock
      825               where rvs-line.rvs-code = ub.rvs-doc.rvs-code
      826               on error undo, return error return-value
      827               :
      828               find first rvs-line-attr no-lock
      829                   where rvs-line-attr.obj-code  = rvs-line.obj-code
      830                   and rvs-line-attr.obj-type  = rvs-line.obj-type
      831                   and rvs-line-attr.gds-code  = rvs-line.gds-code
      832                   and rvs-line-attr.pl-code   = rvs-line.pl-code
      833                   and rvs-line-attr.rvs-code  = rvs-line.rvs-code
      834                   and rvs-line-attr.attr-code = "CriticalDif" no-error.
      835               if available rvs-line-attr then
      836               do:
      837                   v-vid-action = 56 .
      838                   v-vid-param =
      839                       "Initiator=" + v-initiator + chr(4) +
      840                       "SHOP_NUM=" + string(ub.rvs-doc.obj-code) + chr(4) +
      841                       "DocType=" + string(ub.rvs-doc.rvs-type) + chr(4) +
      842                       "DocNum=" + string(ub.rvs-doc.rvs-code) + chr(4) +
      843                       "SHIFT_NUM_DOC=" + (if string( ub.rvs-doc.shift-num) = ? then '' else string( ub.rvs-doc.shift-num)) + (if string( ub.rvs-doc.shift-date) = ? then '' else string( ub.rvs-doc.shift-date , "99999999" )) + chr(4) +
      844                       "SHIFT_NUM=" + (if string(varshift-num) = ? then '' else string(varshift-num)) + (if string(varshift-date) = ? then '' else string(varshift-date, "99999999")) + chr(4) +
      845                       "PlCode=" + string( rvs-line.pl-code) + chr(4) +
      846                       "RESULT=0" + chr(4) +
      847                       "Temperature=" + string( rvs-line.state-temperature) + chr(4) +
      848                       "StateDensity=" + string(  rvs-line.state-density) + chr(4) +
      849                       "StateMeasureQnty=" + string(   rvs-line.state-measure-qnty  ) + chr(4) +
      850                       "StateBruttoQnty=" +  string( rvs-line.state-brutto-qnty ) + chr(4) +
      851                       "StateMeasureCliQnty=" + string( rvs-line.state-measure-cli-qnty)  + chr(4) +
      852                       "StateBruttoCliQnty=" + string( rvs-line.state-brutto-cli-qnty ) +  chr(4) +
      853                       "StateLevelTotal=" + string(  rvs-line.state-level-total) +  chr(4) +
      854                       "StateLevelPetrol=" + string(   rvs-line.state-level-petrol  ) +  chr(4) +
      855                       "StateLevelWater=" + string(  rvs-line.state-level-water    ) +  chr(4) +
      856                       "StateMeasureTcQnty=" + string(   rvs-line.state-measure-tc-qnty  ) +   chr(4) +
      857                       "StateBruttoTcQnty=" + string(    rvs-line.state-brutto-tc-qnty ) +   chr(4) +
      858                       "CriticalDiff=" + string(rvs-line-attr.attr-value) + chr(4) +
      859                       "Description=".
      860                   run trg/userlog.p (
      861                       input 'update':U
      862                       , input 'rvs-doc':U
      863                       , input ( buffer ub.rvs-doc :handle )
      864                       , input v-vid-action
      865                       , input v-vid-param
      866                       ) no-error.
      867                   if error-status :error
      868                       then
      869                   do:
      870                       return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      871                           , chr(10)
      872                           , vss-workfile
      873                           , return-value
      874                           , error-status :get-message ( 1 ) ).
      875                   end.
      876               end.
      877           end.
      878       end.
      879       if ub.rvs-doc.status_ = 'факт':U
      880       and ub.rvs-doc.rvs-type <> 'проверка':U
      881       and g#news
      882         then
      883       do:
      884           run str/rvs-wt-email.p(ub.rvs-doc.rvs-code) no-error.
      885           if error-status:error then
      886               message return-value
      887                   view-as alert-box error.
      888       end.
      889       define variable v-new-rvs-doc as logical no-undo .
      890       assign
      891           v-new-rvs-doc = new(ub.rvs-doc)
      892           .
      893       if v-new-rvs-doc = true
      894       and ub.rvs-doc.rvs-type <> 'проверка':U
      895       and not g#news
      896       then do:
      897           run trg/userlog.p (
      898               input 'create':U
      899               , input 'rvs-doc':U
      900               , input ( buffer ub.rvs-doc :handle )
      901               , input ?
      902               , input ""
      903               ) no-error.
      904           if error-status :error
      905               then
      906           do:
      907               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      908                   , chr(10)
      909                   , vss-workfile
      910                   , return-value
      911                   , error-status :get-message ( 1 ) ).
      912           end.
      913       end.
      914   end.
      915   procedure change-status-fact :
      916       do
      917           on error undo, return error
      918           :
      919           if g#news then
      920           do:
      921               if ub.rvs-doc.fact-order = ?
      922                   or ub.rvs-doc.fact-order = 0 then
      923               do:
      924                   message
      925                       vss-workfile vss-revision vss-description skip
      926                       "Не задан фактический номер сверки" skip
      927                       "Документ сверки" ub.rvs-doc.rvs-code skip
      928                       "fact-order" ub.rvs-doc.fact-order skip
      929                       view-as alert-box error .
      930                   undo, return error .
      931               end.
      932           end.
      933           if not g#news then
      934           do:
      935               run gbl/chk-date.p
      936                   (input ub.rvs-doc.obj-type
      937                   ,input ub.rvs-doc.obj-code
      938                   ,input ub.rvs-doc.fact-date
      939                   ,input ub.rvs-doc.fact-time
      940                   ,input ub.rvs-doc.shift-date
      941                   ,input ub.rvs-doc.shift-num
      942                   ,input yes
      943                   ) no-error.
      944               if error-status :error then
      945               do:
      946                   message
      947                       vss-workfile vss-revision vss-description skip
      948                       "Ошибка при установке дат, времен, смен в документе сверки." skip
      949                       "fact-num" ub.rvs-doc.rvs-code skip
      950                       "fact-date" ub.rvs-doc.fact-date skip
      951                       "fact-time" ub.rvs-doc.fact-time skip
      952                       "shift-date" ub.rvs-doc.shift-date skip
      953                       "shift-num" ub.rvs-doc.shift-num skip
      954                       error-status :get-message(1) skip
      955                       return-value skip
      956                       view-as alert-box error .
      957                   undo, return error .
      958               end.
      959               if ub.rvs-doc.rvs-type = 'перед_док':U
      960                   or ub.rvs-doc.rvs-type = 'после_док':U then
      961               do:
      962                   find first ub.trn-doc no-lock
      963                       where ub.trn-doc.doc-code = ub.rvs-doc.out-code
      964                       no-error .
      965                   if not available ub.trn-doc then
      966                   do:
      967                       message
      968                           vss-workfile vss-revision vss-description skip
      969                           "Ошибка при поиске складского документа для сверки" skip
      970                           "Документ сверки"    ub.rvs-doc.rvs-code skip
      971                           "Складской документ" ub.rvs-doc.out-code skip
      972                           view-as alert-box error .
      973                       undo, return error .
      974                   end.
      975                   find first buf_rvs-doc
      976                       where buf_rvs-doc.rvs-type = ub.rvs-doc.rvs-type
      977                       and buf_rvs-doc.out-code = ub.rvs-doc.rvs-code
      978                       and recid(buf_rvs-doc)   <> recid(ub.rvs-doc)
      979                       no-error .
      980                   if available buf_rvs-doc then
      981                   do:
      982                       message
      983                           vss-workfile vss-revision vss-description skip
      984                           "Для складского документа указано более одной сверки одного и того же типа" skip
      985                           "Складской документ" ub.rvs-doc.out-code skip
      986                           "Документ сверки" ub.rvs-doc.rvs-code skip
      987                           "Тип документа сверки" ub.rvs-doc.rvs-type skip
      988                           "Документ сверки 2" buf_rvs-doc.rvs-code skip
      989                           "Тип документа сверки 2" buf_rvs-doc.rvs-type skip
      990                           view-as alert-box error .
      991                       undo, return error .
      992                   end.
      993                   if ub.rvs-doc.rvs-type = 'после_док':U then
      994                   do:
      995                       find first before_rvs-doc no-lock
      996                           where before_rvs-doc.out-code = ub.rvs-doc.out-code
      997                           and before_rvs-doc.rvs-type = 'перед_док':U
      998                           no-error .
      999                       if not available before_rvs-doc then
     1000                       do:
     1001                           message
     1002                               vss-workfile vss-revision vss-description skip
     1003                               "Для склаского документа задана сверка после налива." skip
     1004                               "Но отсутствует сверка до налива" skip
     1005                               "Сверка после налива" ub.rvs-doc.rvs-code skip
     1006                               "Складской документ"  ub.rvs-doc.out-code skip
     1007                               "Тип сверки" ub.rvs-doc.rvs-type skip
     1008                               view-as alert-box error .
     1009                           undo, return error .
     1010                       end.
     1011                       if ub.rvs-doc.fact-date  <> ub.trn-doc.fact-date
     1012                           or ub.rvs-doc.shift-date <> ub.trn-doc.shift-date
     1013                           or ub.rvs-doc.shift-num  <> ub.trn-doc.shift-num
     1014                           then
     1015                       do:
     1016                           message
     1017                               vss-workfile vss-revision vss-description skip
     1018                               "Несоответствие дат для документа сверки и складского документа" skip
     1019                               "Документ сверки" skip
     1020                               chr(9) "Документ сверки"    ub.rvs-doc.rvs-code skip
     1021                               chr(9) "Дата фактического закрытия" ub.rvs-doc.fact-date skip
     1022                               chr(9) "Дата начала смены"  ub.rvs-doc.shift-date skip
     1023                               chr(9) "Номер смены"        ub.rvs-doc.shift-name skip
     1024                               chr(9) "Порядок смены"        ub.rvs-doc.shift-num skip
     1025                               chr(9) "Складской документ" ub.rvs-doc.out-code  skip
     1026                               "Складской документ" skip
     1027                               chr(9) "Складской документ" ub.trn-doc.doc-code skip
     1028                               chr(9) "Дата фактического закрытия" ub.trn-doc.fact-date skip
     1029                               chr(9) "Дата начала смены"  ub.trn-doc.shift-date skip
     1030                               chr(9) "Номер смены"        ub.trn-doc.shift-name skip
     1031                               chr(9) "Порядок смены"        ub.trn-doc.shift-num skip
     1032                               view-as alert-box error .
     1033                           undo, return error .
     1034                       end.
     1035                       if ub.rvs-doc.fact-date  <> before_rvs-doc.fact-date
     1036                           or ub.rvs-doc.shift-date <> before_rvs-doc.shift-date
     1037                           or ub.rvs-doc.shift-num  <> before_rvs-doc.shift-num
     1038                           then
     1039                       do:
     1040                           message
     1041                               vss-workfile vss-revision vss-description skip
     1042                               "Несоответствие дат для документа сверки и складского документа" skip
     1043                               "Документ сверки после налива" skip
     1044                               chr(9) "Документ сверки"    ub.rvs-doc.rvs-code skip
     1045                               chr(9) "Дата фактического закрытия" ub.rvs-doc.fact-date skip
     1046                               chr(9) "Дата начала смены"  ub.rvs-doc.shift-date skip
     1047                               chr(9) "Номер смены"        ub.rvs-doc.shift-name skip
     1048                               chr(9) "Порядок смены"        ub.rvs-doc.shift-num skip
     1049                               chr(9) "Складской документ" ub.rvs-doc.out-code  skip
     1050                               "Документ сверки до налива" skip
     1051                               chr(9) "Документ сверки"    before_rvs-doc.rvs-code skip
     1052                               chr(9) "Дата фактического закрытия" before_rvs-doc.fact-date skip
     1053                               chr(9) "Дата начала смены"  before_rvs-doc.shift-date skip
     1054                               chr(9) "Номер смены"        before_rvs-doc.shift-name skip
     1055                               chr(9) "Порядок смены"        before_rvs-doc.shift-num skip
     1056                               chr(9) "Складской документ" before_rvs-doc.out-code  skip
     1057                               view-as alert-box error .
     1058                           undo, return error .
     1059                       end.
     1060                   end.
     1061                   if ub.rvs-doc.rvs-type = 'перед_док':U then
     1062                   do:
     1063                       find first after_rvs-doc no-lock
     1064                           where after_rvs-doc.out-code = ub.rvs-doc.out-code
     1065                           and after_rvs-doc.rvs-type = 'после_док':U
     1066                           no-error .
     1067                       if not available after_rvs-doc then
     1068                       do:
     1069                           message
     1070                               vss-workfile vss-revision vss-description skip
     1071                               "Для склаского документа задана сверка после налива." skip
     1072                               "Но отсутствует сверка до налива" skip
     1073                               "Сверка до налива"   ub.rvs-doc.rvs-code skip
     1074                               "Складской документ" ub.rvs-doc.out-code skip
     1075                               "Тип сверки" ub.rvs-doc.rvs-type skip
     1076                               view-as alert-box error .
     1077                           undo, return error .
     1078                       end.
     1079                   end.
     1080               end.
     1081               if ub.rvs-doc.rvs-type = 'смена':U then
     1082               do:
     1083                   if  ub.rvs-doc.out-code <> ""
     1084                       and ub.rvs-doc.out-code <> ?  then
     1085                   do:
     1086                       message
     1087                           vss-workfile vss-revision vss-description skip
     1088                           "Для документа сверки по смене указан номер документа" skip
     1089                           "Документ сверки" ub.rvs-doc.rvs-code skip
     1090                           "Тип документа" ub.rvs-doc.rvs-type skip
     1091                           "Складской документ" ub.rvs-doc.out-code skip
     1092                           view-as alert-box error .
     1093                       undo, return error .
     1094                   end.
     1095               end.
     1096               if ub.rvs-doc.fact-order > 0 then
     1097               do:
     1098                   message
     1099                       vss-workfile vss-revision vss-description skip
     1100                       "Ошибочно задан фактический номер документа сверки" skip
     1101                       "Документ сверки" ub.rvs-doc.rvs-code skip
     1102                       "fact-order" ub.rvs-doc.fact-order skip
     1103                       view-as alert-box error .
     1104                   undo, return error .
     1105               end.
     1106               define variable v-fact-num as integer no-undo .
     1107               assign
     1108                   v-fact-num = dynamic-next-value('s-trn-fact':U, 'ub':U)
     1109                   .
     1110               define variable v-fact-order           as decimal no-undo .
     1111               define variable v-shift-end-fact-order as decimal no-undo .
     1112               define variable v-day-end-fact-order   as decimal no-undo .
     1113               define variable l-shift-on             as logical no-undo .
     1114   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1116     (input  ub.rvs-doc.obj-type
     1117     ,input  ub.rvs-doc.obj-code
     1118     ,input  'shift-on=request'
     1119     ,output l-shift-on
     1120     ) no-error .
     1121               if error-status :error then
     1122               do:
     1123                   message
     1124                       vss-workfile vss-revision vss-description skip
     1125                       "Ошибка при запуске процедуры objat" skip
     1126                       error-status :get-message(1) skip
     1127                       return-value skip
     1128                       view-as alert-box error .
     1129                   undo, return error .
     1130               end.
     1131               run factord in this-procedure
     1132                   (input  ub.rvs-doc.fact-date
     1133                   ,input  ub.rvs-doc.fact-time
     1134                   ,input  v-fact-num
     1135                   ,input  ub.rvs-doc.shift-date
     1136                   ,input  ub.rvs-doc.shift-num
     1137                   ,input  l-shift-on
     1138                   ,output v-fact-order
     1139                   ,output v-shift-end-fact-order
     1140                   ,output v-day-end-fact-order
     1141                   ) no-error .
     1142               if error-status :error
     1143                   or v-fact-order = ?
     1144                   or v-fact-order = 0 then
     1145               do:
     1146                   message
     1147                       vss-workfile vss-revision vss-description skip
     1148                       "Ошибка при определении фактического номера сверки" skip
     1149                       "doc-num"                 ub.rvs-doc.rvs-code    skip
     1150                       "fact-date"               ub.rvs-doc.fact-date   skip
     1151                       "fact-time"               ub.rvs-doc.fact-time   skip
     1152                       "fact-num"                v-fact-num             skip
     1153                       "shift-date"              ub.rvs-doc.shift-date  skip
     1154                       "shift-num"               ub.rvs-doc.shift-num   skip
     1155                       "v-fact-order"            v-fact-order           skip
     1156                       "v-shift-end-fact-order"  v-shift-end-fact-order skip
     1157                       "v-day-end-fact-order"    v-day-end-fact-order   skip
     1158                       error-status :get-message(1) skip
     1159                       return-value skip
     1160                       view-as alert-box error .
     1161                   undo, return error .
     1162               end.
     1163               if ub.rvs-doc.rvs-type = 'смена':U then
     1164               do:
     1165                   assign
     1166                       ub.rvs-doc.fact-order = v-shift-end-fact-order - 0.0000000001
     1167                       .
     1168               end.
     1169               else
     1170               do:
     1171                   assign
     1172                       ub.rvs-doc.fact-order = v-fact-order
     1173                       .
     1174               end.
     1175               find first ub.trn-doc where ub.trn-doc.doc-code = ub.rvs-doc.out-code no-error.
     1176               if available ub.trn-doc and
     1177                   ub.trn-doc.is-back-date then
     1178               do:
     1179                   assign
     1180                       varis-back-date = yes.
     1181               end.
     1182               if ub.rvs-doc.rvs-type <> 'проверка':U
     1183               then do :
     1184                 run clcavrgd in this-procedure (input rvs-doc.rvs-code)  no-error.
     1185                 if error-status:error then
     1186                 do:
     1187                     message
     1188                         vss-workfile vss-revision vss-description skip
     1189                         "Ошибка при расчете веса по средней плотности" skip
     1190                         "Закрываемая сверка" skip
     1191                         chr(9) "Документ сверки"   ub.rvs-doc.rvs-code skip
     1192                         chr(9) "Тип сверки"        ub.rvs-doc.rvs-type skip
     1193                         return-value                 skip
     1194                         error-status:get-message(1)  skip
     1195                         error-status:get-message(2)  skip
     1196                         error-status:get-message(3)
     1197                         view-as alert-box error .
     1198                     undo , return error .
     1199                 end.
     1200               end .
     1201           end.
     1202   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1203     (input ?
     1204     ,input this-procedure:handle
     1205     ,input ?
     1206     ,input 'event_rvs-doc':U
     1207     ,input  buffer buf-old_rvs-doc:handle
     1208     ,input  buffer ub.rvs-doc:handle
     1209     ,input ''
     1210     ,input ''
     1211     ) no-error .
     1212           if error-status :error
     1213               then
     1214           do:
     1215               return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
     1216                   , chr(10)
     1217                   , vss-workfile
     1218                   , return-value
     1219                   , error-status :get-message ( 1 ) ).
     1220             end.
     1221       end.
     1222   end procedure.
     1223   procedure clcavrgd:
     1224   define input parameter parrvs-code like ub.rvs-doc.rvs-code no-undo.
     1225   define buffer bf_rvs-doc    for ub.rvs-doc.
     1226   define buffer bf_rvs-line   for ub.rvs-line.
     1227   define buffer bf_goods      for ub.goods.
     1228   define buffer prev_rvs-line for ub.rvs-line.
     1229   define buffer prev_rvs-doc  for ub.rvs-doc.
     1230   define variable varsystem-cli-avrg-qnty like ub.rvs-line.system-cli-avrg-qnty no-undo.
     1231   define variable vardensity like ub.rvs-line.density no-undo.
     1232   find first bf_rvs-doc where bf_rvs-doc.rvs-code = parrvs-code no-error.
     1233   if not available bf_rvs-doc then return error "Неверный номер документа сверки(clcavrgd)".
     1234   for each bf_rvs-line where bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code exclusive,
     1235       first bf_goods where bf_goods.gds-code = bf_rvs-line.gds-code break by bf_rvs-line.gds-code on error undo, return error return-value :
     1236       if first-of(bf_rvs-line.gds-code) then do:
     1237          run str/avrgdens.p (input  bf_rvs-doc.obj-type,
     1238                          input  bf_rvs-doc.obj-code,
     1239                          input  bf_rvs-doc.shift-date,
     1240                          input  bf_rvs-doc.shift-num,
     1241                          input  bf_rvs-line.gds-code,
     1242                          input  bf_rvs-doc.rvs-code,
     1243                          input  no,
     1244                          output vardensity) no-error.
     1245          if error-status:error or
     1246             vardensity = ?     then do:
     1247             undo, return error.
     1248          end.
     1249       end.
     1250       if bf_rvs-line.rvs-prev-code <> ? then do:
     1251          find first prev_rvs-line where prev_rvs-line.rvs-code = bf_rvs-line.rvs-prev-code and
     1252                                         prev_rvs-line.obj-type = bf_rvs-line.obj-type      and
     1253                                         prev_rvs-line.obj-code = bf_rvs-line.obj-code      and
     1254                                         prev_rvs-line.pl-code  = bf_rvs-line.pl-code       and
     1255                                         prev_rvs-line.gds-code = bf_rvs-line.gds-code      no-lock no-error.
     1256          if not available prev_rvs-line then do:
     1257             undo, return error SUBSTITUTE
     1258             ("Не найдена строка документа сверки с № &1 на которую имеет ссылку строка по складскому месту &2 товару &3 &4 &5 &6 .",
     1259              bf_rvs-line.rvs-prev-code,
     1260              bf_rvs-line.pl-code,
     1261              bf_goods.artic,
     1262              bf_goods.prod-type,
     1263              bf_goods.prod-code,
     1264              bf_goods.gds-name).
     1265          end.
     1266          find first prev_rvs-doc where prev_rvs-doc.rvs-code = prev_rvs-line.rvs-code No-LOCK No-ERROR.
     1267          if not available prev_rvs-doc then do:
     1268             undo, return error SUBSTITUTE
     1269             ("Не найден документ сверки с № &1 на который имеет ссылку строка по складскому месту &2 товару &3 &4 &5 &6 .",
     1270              bf_rvs-line.rvs-prev-code,
     1271              bf_rvs-line.pl-code,
     1272              bf_goods.artic,
     1273              bf_goods.prod-type,
     1274              bf_goods.prod-code,
     1275              bf_goods.gds-name).
     1276          end.
     1277       end.
     1278       else do:
     1279          if bf_rvs-doc.rvs-type = 'смена':U then
     1280             undo, return error SUBSTITUTE
     1281            ("По складскому месту &1 товару &2 &3 &4 &5 нет ссылки на предыдущую сверку.",
     1282             bf_rvs-line.pl-code,
     1283             bf_goods.artic,
     1284             bf_goods.prod-type,
     1285             bf_goods.prod-code,
     1286             bf_goods.gds-name).
     1287      end.
     1288      run calc_avrg_stock (input  bf_rvs-doc.shift-date,
     1289                           input  bf_rvs-doc.shift-num,
     1290                           input  bf_rvs-doc.obj-type,
     1291                           input  bf_rvs-doc.obj-code,
     1292                           input  bf_rvs-line.pl-code,
     1293                           input  bf_rvs-line.gds-code,
     1294                           input  vardensity,
     1295                           output varsystem-cli-avrg-qnty) no-error.
     1296      if error-status:error then do:
     1297         undo, return error substitute ("Ошибка при расчета остатка по средней плотности &1.",return-value) .
     1298      end.
     1299      ASSIGN bf_rvs-line.system-cli-avrg-qnty =
     1300             (if available prev_rvs-line then prev_rvs-line.system-cli-avrg-qnty else 0) + varsystem-cli-avrg-qnty.
     1301      if bf_rvs-line.system-cli-avrg-qnty = ? then return error SUBSTITUTE
     1302      ("Невозможно рассчитать вес по средней плотности для резервуара &1 товара &2 &3 &4 &5 .",
     1303      bf_rvs-line.pl-code,
     1304      bf_goods.artic,
     1305      bf_rvs-line.obj-type,
     1306      bf_rvs-line.obj-code,
     1307      bf_goods.gds-name).
     1308   end.
     1309   end procedure.
     1310   procedure calc_avrg_stock:
     1311   define input  parameter parshift-date            like ub.rvs-doc.shift-date           no-undo.
     1312   define input  parameter parshift-num             like ub.rvs-doc.shift-num            no-undo.
     1313   define input  parameter parobj-type              like ub.rvs-doc.obj-type             no-undo.
     1314   define input  parameter parobj-code              like ub.rvs-doc.obj-code             no-undo.
     1315   define input  parameter parpl-code               like ub.rvs-line.pl-code             no-undo.
     1316   define input  parameter pargds-code              like ub.rvs-line.gds-code            no-undo.
     1317   define input  parameter pardensity               like ub.rvs-line.density             no-undo.
     1318   define output parameter parsystem-cli-avrg-qnty  like ub.rvs-doc.system-cli-avrg-qnty no-undo.
     1319   define buffer bf_trn-doc  for ub.trn-doc.
     1320   define buffer bf_doc-line for ub.doc-line.
     1321   define buffer bf_doc-pl   for ub.doc-pl.
     1322   define buffer bf_goods    for ub.goods.
     1323   find first bf_goods where bf_goods.gds-code = pargds-code no-lock.
     1324   for each bf_trn-doc where bf_trn-doc.obj-type   = parobj-type   and
     1325                             bf_trn-doc.obj-code   = parobj-code   and
     1326                             bf_trn-doc.shift-date = parshift-date and
     1327                             bf_trn-doc.shift-num  = parshift-num  and
     1328                             bf_trn-doc.status_    = 'факт':U       no-lock,
     1329       first bf_doc-line where bf_doc-line.doc-code  = bf_trn-doc.doc-code and
     1330                               bf_doc-line.artic     = bf_goods.artic      and
     1331                               bf_doc-line.prod-type = bf_goods.prod-type  and
     1332                               bf_doc-line.prod-code = bf_goods.prod-code  no-lock,
     1333             first bf_doc-pl where bf_doc-pl.out-code = bf_trn-doc.doc-code and
     1334                                   bf_doc-pl.gds-code = pargds-code         and
     1335                                   bf_doc-pl.obj-type = parobj-type         and
     1336                                   bf_doc-pl.obj-code = parobj-code         and
     1337                                   bf_doc-pl.pl-code  = parpl-code:
     1338       if lookup (bf_trn-doc.ext-doc-type, 'ie,re,iv,rv,im,io':U) > 0 then do:
     1339          if bf_trn-doc.ext-doc-type = 'ie':U then do:
     1340             assign parsystem-cli-avrg-qnty = parsystem-cli-avrg-qnty + bf_doc-line.fact-density * bf_doc-pl.fact-qnty.
     1341          end.
     1342          else
     1343             assign parsystem-cli-avrg-qnty = parsystem-cli-avrg-qnty + pardensity * bf_doc-pl.fact-qnty.
     1344       end.
     1345       else do:
     1346          if lookup (bf_trn-doc.ext-doc-type, 'ee,ep,es,rs,we,vt,vp,ap,mp,pc,ev,em,wm,eo':U) > 0 then do:
     1347             if lookup (bf_trn-doc.ext-doc-type, 'vt,vp,rs':U) > 0 then do:
     1348                assign parsystem-cli-avrg-qnty = parsystem-cli-avrg-qnty + pardensity * bf_doc-pl.fact-qnty.
     1349             end.
     1350             else do:
     1351                assign parsystem-cli-avrg-qnty = parsystem-cli-avrg-qnty - pardensity * bf_doc-pl.fact-qnty.
     1352             end.
     1353          end.
     1354          else return error SUBSTITUTE
     1355          ("Документ &1. Расширенный тип документа &2. Невозможно определить, реализация или поступление.",
     1356          bf_trn-doc.doc-code,
     1357          bf_trn-doc.ext-doc-type).
     1358       end.
     1359   end.
     1360   end procedure.
