      351                 ub.inv-doc-attr.doc-code = inv_trn-doc.doc-code and
      352                 ub.inv-doc-attr.attr-value = string(true) no-error .
      353                 if not available(ub.inv-doc-attr) then do:
      354                 vErrorMessage = substitute(
      355                   "Товар: &1 &2 &3~n&4~nна объекте &5 &6~nсейчас в инвентаризации (Документ № &7).",
      356                   buf_goods.artic,
      357                   buf_goods.prod-type,
      358                   buf_goods.prod-code,
