      366                 undo main-block, return error vErrorMessage.
      367               end.
      368             end.
      369           end.
      370                   end.
      371           for each inv_doc-line no-lock
      372             where inv_doc-line.obj-type  = buf_doc-line.obj-type
      373               and inv_doc-line.obj-code  = buf_doc-line.obj-code
      374               and inv_doc-line.artic     = buf_doc-line.artic
