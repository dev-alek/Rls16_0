      307             error-status :get-message(1) skip
      308             return-value skip
      309             view-as alert-box error .
      310           undo main-block, return no-apply .
      311         end.
      312         if l-inv-on then do:
      313           define variable v-doc-with-inv as logical no-undo .
      314           assign
      315             v-doc-with-inv = false
      316           .
      317           for each inv_doc-line no-lock
      318             where ( inv_doc-line.obj-type      = buf_doc-line.obj-type
      319                     and inv_doc-line.obj-code  = buf_doc-line.obj-code
      320                     and inv_doc-line.artic     = buf_doc-line.artic
      321                     and inv_doc-line.prod-type = buf_doc-line.prod-type
      322                     and inv_doc-line.prod-code = buf_doc-line.prod-code
      323                     and inv_doc-line.status_   = 'разрешен':U
      324                   )
      325                or ( inv_doc-line.obj-type      = buf_doc-line.obj-type
      326                     and inv_doc-line.obj-code  = buf_doc-line.obj-code
      327                     and inv_doc-line.artic     = buf_doc-line.artic
      328                     and inv_doc-line.prod-type = buf_doc-line.prod-type
      329                     and inv_doc-line.prod-code = buf_doc-line.prod-code
      330                     and inv_doc-line.status_   = 'нередакт':U
      331                   )
      332           ,first inv_trn-doc no-lock
      333             where inv_trn-doc.doc-code     = inv_doc-line.doc-code
      334           on error undo main-block, return error
