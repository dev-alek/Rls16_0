      244         if l-reserv-pl-code = yes then do:
      245           assign
      246             v-rvs-list = "":U
      247           .
      248           if buf_trn-doc.doc-type = 'при':U then do:
      249             for each buf_rvs-doc no-lock
      250               where buf_rvs-doc.out-code = buf_trn-doc.doc-code
      251             on error undo, return error return-value
      252             :
      253               if v-rvs-list <> "":U then do:
      254                 assign
      255                   v-rvs-list = v-rvs-list + chr(44)
      256                 .
      257               end.
      258               assign
      259                 v-rvs-list = v-rvs-list + substitute( "&1", buf_rvs-doc.rvs-code )
      260               .
      261             end.
      262           end.
      263           for each buf_doc-pl no-lock
      264             where buf_doc-pl.obj-type = buf_doc-line.obj-type
      265               and buf_doc-pl.obj-code = buf_doc-line.obj-code
      266               and buf_doc-pl.out-code = buf_doc-line.doc-code
      267               and buf_doc-pl.gds-code = buf_goods.gds-code
      268           on error undo, return error return-value
      269           :
      270             run trg/lockplgd.p
      271               ( input buf_doc-line.obj-type
      272               , input buf_doc-line.obj-code
      273               , input buf_doc-pl.pl-code
      274               , input buf_goods.gds-code
      275               , input "check-rvs-on=false"
      276               , input v-rvs-list
      277               , input false
      278               ) no-error .
      279             if error-status :error then do:
      280               message
