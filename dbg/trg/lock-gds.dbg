      433                   buf_goods.prod-type,
      434                   buf_goods.prod-code,
      435                   inv_doc-line.obj-type,
      436                   inv_doc-line.obj-code
      437                 ).
      438             if not g#esys then
      439               message vErrorMessage view-as alert-box information .
      440             undo main-block, return error vErrorMessage.
      441           end.
      442         end.
      443       end.
      444       if false  then do:
      445         for each inv_doc-line no-lock
      446           where inv_doc-line.obj-type     = buf_doc-line.obj-type
      447             and inv_doc-line.obj-code     = buf_doc-line.obj-code
      448             and inv_doc-line.artic        = buf_doc-line.artic
      449             and inv_doc-line.prod-type    = buf_doc-line.prod-type
      450             and inv_doc-line.prod-code    = buf_doc-line.prod-code
      451             and inv_doc-line.ext-doc-type = 'vt':U
      452             and inv_doc-line.status_      = 'разрешен':U
      453             and inv_doc-line.doc-code     <> v-trn-doc-doc-code
      454         ,first ub.trn-doc no-lock
      455           where ub.trn-doc.doc-code       = inv_doc-line.doc-code
      456             and ub.trn-doc.flag_          = no
      457         on error undo main-block, return error
      458         :
      459           vErrorMessage = substitute(
      460             "На объекте &1 &2~nсуществует инвентаризация (Документ №&3) по товару~n&4 &5 &6~n&7~nНаходящаяся в статусе ~"&8&9~".",
      461             inv_doc-line.obj-type,
      462             inv_doc-line.obj-code,
      463             inv_doc-line.doc-code,
      464             buf_goods.artic,
      465             buf_goods.prod-type,
      466             buf_goods.prod-code,
      467             buf_goods.gds-name,
      468             STRING(ub.trn-doc.status_),
      469             STRING(ub.trn-doc.flag_, "+/-")
      470           ).
      471           if not g#esys then
      472               message vErrorMessage view-as alert-box information .
      473           undo main-block, return error vErrorMessage.
      474         end.
      475       end.
      476       if p-document-fact-order <> 0 then do:
      477         for each inv_doc-line no-lock
      478           where inv_doc-line.obj-type     = buf_doc-line.obj-type
      479             and inv_doc-line.obj-code     = buf_doc-line.obj-code
      480             and inv_doc-line.artic        = buf_doc-line.artic
      481             and inv_doc-line.prod-type    = buf_doc-line.prod-type
      482             and inv_doc-line.prod-code    = buf_doc-line.prod-code
      483             and inv_doc-line.ext-doc-type = 'vp':U
      484             and inv_doc-line.status_      = 'факт':U
      485             and inv_doc-line.fact-order   > p-document-fact-order
      486         on error undo main-block, return error
      487         :
      488           vErrorMessage = substitute(
      489             "На объекте &1 &2~nсуществует инвентаризация (Документ №&3) по товару~n&4 &5 &6~n&7~nс большим логическим номером &8.~n&9.",
      490             inv_doc-line.obj-type,
      491             inv_doc-line.obj-code,
      492             inv_doc-line.doc-code,
      493             buf_goods.artic,
      494             buf_goods.prod-type,
      495             buf_goods.prod-code,
      496             buf_goods.gds-name,
      497             inv_doc-line.fact-order,
      498             substitute("Невозможно закрыть документ &1 с логическим номером &2.",
      499                        buf_doc-line.doc-code,
      500                        p-document-fact-order)
      501           ).
      502           if not g#esys then
      503               message vErrorMessage view-as alert-box information .
      504           undo main-block, return error vErrorMessage.
      505         end.
      506       end.
      507       if p-document-fact-order-price <> 0 then do:
      508         define variable v-root-b-code like ub.bar-code.b-code no-undo .
      509   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      510     (input  buf_goods.gds-code
      511     ,input  ?
      512     ,output v-root-b-code
      513     ) no-error .
      514         if error-status :error then do:
      515           vErrorMessage = substitute(
      516             "Ошибка при поиске корневого бар-кода~nДокумент &1~nАртикул &2 &3 &4~n&5~n&6.",
      517             buf_doc-line.doc-code,
      518             buf_goods.artic,
      519             buf_goods.prod-type,
      520             buf_goods.prod-cod,
      521             error-status :get-message(1),
      522             return-value
      523           ).
      524           if not g#esys then
      525             message vErrorMessage view-as alert-box information .
      526           undo main-block, return error vErrorMessage.
      527         end.
      528         find last ub.price-list no-lock
      529           where ub.price-list.obj-type   = buf_doc-line.obj-type
      530             and ub.price-list.obj-code   = buf_doc-line.obj-code
      531             and ub.price-list.b-code     = v-root-b-code
      532             and ub.price-list.price-type = ""
      533           use-index fact-close
      534           no-error .
      535         if available ub.price-list
      536         and ub.price-list.fact-order > p-document-fact-order
      537         then do:
      538           vErrorMessage = substitute(
      539             "На объекте &1 &2~nсуществует переоценка (Документ №&3) по товару~n&4 &5 &6~n&7~nс более высоким логическим номером &8.~n~
      540   Невозможно закрыть документ с логическим номером &9.",
      541             buf_doc-line.obj-type,
      542             buf_doc-line.obj-code,
      543             ub.price-list.doc-num,
      544             buf_goods.artic,
      545             buf_goods.prod-type,
      546             buf_goods.prod-code,
      547             buf_goods.gds-name,
      548             ub.price-list.fact-order,
      549             p-document-fact-order
      550           ).
      551           if not g#esys then
      552               message vErrorMessage view-as alert-box information .
      553           undo main-block, return error vErrorMessage.
      554         end.
      555       end.
      556     end.
      557   end.
