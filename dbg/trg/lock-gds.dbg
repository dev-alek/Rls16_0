      106   main-block :
      107   do transaction
      108   on error undo main-block, return error
      109   :
      110     find first buf_trn-doc no-lock
      111       where buf_trn-doc.doc-code = v-trn-doc-doc-code
      112       no-error .
      113     if not available buf_trn-doc then do:
      114       message
      115         vss-workfile vss-revision vss-description skip
      116         "Ошибка задания входных параметров" skip
      117         "Не найден документ" skip
      118         "Документ" v-trn-doc-doc-code skip
      119         view-as alert-box error .
      120       undo main-block, return error .
      121     end.
      122     if p-document-fact-order = ? then do:
      123       message
      124         vss-workfile vss-revision vss-description skip
      125         "Ошибка задания входных параметров" skip
      126         "Документ" v-trn-doc-doc-code skip
      127         "Логический номер закрываемого документа" p-document-fact-order skip
      128         view-as alert-box error .
      129       undo main-block, return error .
      130     end.
      131    find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = buf_trn-doc.doc-code and
      132    ub.inv-doc-attr.attr-code = "invMultDevice" and
      133    ub.inv-doc-attr.attr-value = string(true) no-error .
      134    if available(ub.inv-doc-attr) then return .
      135    find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = buf_trn-doc.doc-code and
      136    ub.inv-doc-attr.attr-code = "correctItogInv" and
      137    ub.inv-doc-attr.attr-value = string(true) no-error .
      138    if available(ub.inv-doc-attr) then return .
      139     def frame a
      140       "Блокировка товаров на объекте." skip
      141       num_rec           format ">>>>>>>9"   label "Обработано артикулов" skip
      142       buf_doc-line.artic format "x(15)"      label "Текущий артикул" skip
      143       curr_time         format "->>>>>>>>9" label "Время" skip
      144       with view-as dialog-box side-labels three-d
      145       title "Документ " + v-trn-doc-doc-code .
      146     assign
      147       start_time = time
      148     .
      149     view frame a.
      150     for each buf_doc-line no-lock
      151       where buf_doc-line.doc-code = v-trn-doc-doc-code
      152     on error undo main-block, return error
      153     :
      154       find first buf_goods no-lock
      155         where buf_goods.artic     = buf_doc-line.artic
      156           and buf_goods.prod-type = buf_doc-line.prod-type
      157           and buf_goods.prod-code = buf_doc-line.prod-code
      158         no-error .
      159       if error-status :error then do:
      160         message
      161           vss-workfile vss-revision vss-description skip
      162           "Не найден товар" skip
      163           "Документ" buf_doc-line.doc-code skip
      164           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      165           error-status :get-message(1) skip
      166           return-value skip
      167           view-as alert-box error .
      168         undo main-block, return error .
      169       end.
      170       assign
      171         num_rec   = num_rec + 1
      172       .
      173       if num_rec mod 10 = 0 then do:
      174         assign
      175           curr_time = time - start_time
      176         .
      177         display
      178           num_rec buf_doc-line.artic curr_time
      179           with frame a.
      180       end.
      181   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      183     (input  buf_doc-line.obj-type
