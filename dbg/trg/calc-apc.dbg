     2473     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     2474     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     2475     do
     2476     on error undo, return error return-value
     2477     :
     2478       do transaction
     2479       on error undo, return error return-value
     2480       :
     2481   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2483     (input  p-obj-type
     2484     ,input  p-obj-code
     2485     ,input  p-artic
     2486     ,input  p-prod-type
     2487     ,input  p-prod-code
     2488     ,buffer buf_gds-obj
     2489     ) no-error .
     2490         if error-status :error
     2491         then do:
     2492           message
     2493             vss-workfile vss-revision vss-description skip
     2494             vss-include-info5 skip
     2495             "Невозможно найти gds-obj" skip
     2496             error-status :get-message(1) skip
     2497             return-value skip
     2498             view-as alert-box error .
     2499           undo, return error return-value .
     2500         end.
     2501         find current buf_gds-obj exclusive-lock .
     2502       end.
     2503       find first buf_goods no-lock
     2504         where buf_goods.artic     = p-artic
     2505           and buf_goods.prod-type = p-prod-type
     2506           and buf_goods.prod-code = p-prod-code
     2507         .
     2508       run prdoclib-init-temp-pl-gds in this-procedure
     2509         (input p-obj-type
     2510         ,input p-obj-code
     2511         ,input buf_goods.gds-code
     2512         ) .
     2513       if p-include-fact-order = true
     2514       then do:
     2515         assign
     2516          p-fact-order = p-fact-order - 0.0000000001
     2517         .
     2518       end.
     2519       for each buf_doc-line no-lock
     2520         where buf_doc-line.obj-type   = p-obj-type
     2521           and buf_doc-line.obj-code   = p-obj-code
     2522           and buf_doc-line.artic      = p-artic
     2523           and buf_doc-line.prod-type  = p-prod-type
     2524           and buf_doc-line.prod-code  = p-prod-code
     2525           and buf_doc-line.status_    = 'факт':U
     2526           and buf_doc-line.fact-order >= p-fact-order
     2527       on error undo, return error return-value
     2528       :
     2529         run prdoclib-prc-pl-document in this-procedure
     2530           ( input  buf_doc-line.doc-code
     2531            ,input  p-obj-type
     2532            ,input  p-obj-code
     2533            ,input  buf_goods.gds-code
     2534            ,output v-total-pl-gds-qnty
     2535            ,output v-total-pl-gds-cli-qnty
     2536           ) .
     2537       end.
     2538     end.
     2539   end procedure.
