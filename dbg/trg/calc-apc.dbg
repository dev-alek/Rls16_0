     7077   procedure check-valid-archives :
     7078     define buffer day_stk-tot   for ub.stk-tot .
     7079     define buffer shift_stk-tot for ub.stk-tot .
     7080     define variable v-different-fields as character no-undo .
     7081     do
     7082     on error undo, return error
     7083     :
     7084       find last day_stk-tot no-lock
     7085         where day_stk-tot.obj-type   = ub.price-doc.obj-type
     7086           and day_stk-tot.obj-code   = ub.price-doc.obj-code
     7087           and day_stk-tot.sum-type   = 'crsa':U
     7088           and day_stk-tot.shift-date = ?
     7089         .
     7090       find last shift_stk-tot no-lock
     7091         where shift_stk-tot.obj-type   = ub.price-doc.obj-type
     7092           and shift_stk-tot.obj-code   = ub.price-doc.obj-code
     7093           and shift_stk-tot.sum-type   = 'crsa':U
     7094           and shift_stk-tot.shift-date <> ?
     7095         .
     7096       buffer-compare
     7097         day_stk-tot
     7098         except fact-order shift-date shift-num
     7099         to shift_stk-tot
     7100         CASE-SENSITIVE
     7101         save result in v-different-fields .
     7102       if v-different-fields <> "" then do:
     7103         output stream slog to calc-apc.err append .
     7104         export stream slog v-different-fields .
     7105         export stream slog "day_stk-tot" .
     7106         export stream slog day_stk-tot .
     7107         export stream slog "shift_stk-tot" .
     7108         export stream slog shift_stk-tot .
     7109         output stream slog close .
     7110         message
     7111           vss-workfile vss-revision vss-description skip
     7112           "Внутренняя ошибка расчета складского архива по товарам" skip
     7113           v-different-fields
     7114           view-as alert-box error .
     7115         undo, return error .
     7116       end.
     7117     end.
     7118   end procedure.
     7119   procedure show-action :
     7120     do
     7121     on error undo, return error
     7122     :
     7123       define input parameter p-action as character no-undo .
     7124       define variable v-today as date      no-undo.
     7125       define variable v-time  as integer   no-undo.
     7126       run cur-time in this-procedure ( output v-today
     7127                                      , output v-time
     7128                                      ).
     7129       assign
     7130         current-time = string(v-time - start-time, "HH:MM:SS")
     7131         current-action = p-action
     7132       .
     7133       if mFrameView
     7134       then do:
     7135          display
     7136             current-time
     7137             current-action
     7138          with frame inf.
     7139       end.
     7140     end.
     7141   end procedure.
