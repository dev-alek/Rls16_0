     2427   procedure prdoclib-clear-temp-pl-gds :
     2428     define buffer buf_temp-pl-gds for temp-pl-gds .
     2429     do
     2430     on error undo, return error return-value
     2431     :
     2432       for each buf_temp-pl-gds
     2433       on error undo, return error return-value
     2434       :
     2435         delete buf_temp-pl-gds .
     2436       end.
     2437     end.
     2438   end procedure.
     2439   procedure prdoclib-init-temp-pl-gds :
     2440     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2441     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2442     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2443     define buffer buf_pl-gds      for ub.pl-gds .
     2444     define buffer buf_temp-pl-gds for temp-pl-gds .
     2445     do
     2446     on error undo, return error return-value
     2447     :
     2448       run prdoclib-clear-temp-pl-gds in this-procedure .
     2449       for each buf_pl-gds
     2450         where buf_pl-gds.obj-type = p-obj-type
     2451           and buf_pl-gds.obj-code = p-obj-code
     2452           and buf_pl-gds.gds-code = p-gds-code
     2453       on error undo, return error return-value
     2454       :
     2455         create buf_temp-pl-gds .
     2456         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2457       end.
     2458     end.
     2459   end procedure.
     2460   procedure prdoclib-init-pl-gds-by-factord :
     2461     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
