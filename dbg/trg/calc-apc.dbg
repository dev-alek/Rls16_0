     2787   end.
     2788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2789     (input  varroot-nodeprl
     2790     ,input  'empty-scale=request'
     2791     ,output varempty-scaleprl
     2792     ) no-error .
     2793   if error-status :error then do:
     2794     message
     2795       vss-workfile vss-revision vss-description skip
     2796       "Ошибка при определении атрибута признака" skip
     2797       "Артикул" varartic varprod-type varprod-code skip
     2798       "Признак" varroot-nodeprl skip
     2799       "Запрашивался атрибут" "empty-scale=request" skip
     2800       error-status :get-message(1) skip
     2801       return-value skip
     2802       view-as alert-box error .
     2803     undo, return error .
     2804   end.
     2805   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2806   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2807     (output varoutvprbprl
     2808     )  .
     2809   if varoutvprbprl = "base":u then do:
     2810     assign
     2811           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     2812       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     2813     .
     2814   end.
     2815   else do:
     2816     assign
     2817           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     2818       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     2819     .
     2820   end.
     2821   if varoutvprbprl = "rubl":u then do:
     2822     assign
     2823           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     2824       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     2825   end.
     2826   else do:
     2827     assign
     2828           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     2829       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     2830   end.
     2831   assign
     2832     varis-cons-parts-haveprl =  no.
     2833   assign
     2834     varfact-qntyprl       = 0
     2835     varcons-qntyprl       = 0
     2836     varprice-base-consprl = 0
     2837     varprice-rubl-consprl = 0.
     2838   find first out-vatp_doc-lineprl where
     2839              out-vatp_doc-lineprl.doc-code   = vardoc-num
     2840          and out-vatp_doc-lineprl.artic      = varartic
     2841          and out-vatp_doc-lineprl.prod-type  = varprod-type
     2842          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     2843   if available out-vatp_doc-lineprl           and
     2844     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     2845     assign
     2846       varfact-qntyprl = out-vatp_doc-lineprl.fact-qnty.
     2847   end.
     2848   else do:
     2849     for each out-vatp_partsprl where out-vatp_partsprl.out-code   = vardoc-num
     2850                                  and out-vatp_partsprl.obj-type   = varobj-type
     2851                                  and out-vatp_partsprl.obj-code   = varobj-code
     2852                                  and out-vatp_partsprl.artic      = varartic
     2853                                  and out-vatp_partsprl.prod-type  = varprod-type
     2854                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     2855       if out-vatp_partsprl.purch-code = 2 then do:
     2856   assign
     2857     price-rubl-with-tax-locoprl = out-vatp_partsprl.price-rubl
     2858     price-base-with-tax-locoprl = out-vatp_partsprl.price-base
     2859   .
     2860   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2861   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2862     (output varinvprboprl
     2863     )  .
     2864     if out-vatp_partsprl.out-code = 'free-zone':U     or
     2865        out-vatp_partsprl.out-code = 'out-zone':U   or
     2866        out-vatp_partsprl.doc-type = 'акт':U then do:
     2867       assign
     2868         in-vatp-have-vat-sltoprl = yes.
