     1176   procedure prdoclib-clear-temp-prt-obj :
     1177     define buffer buf_temp-prt-obj for temp-prt-obj .
     1178     do
     1179     on error undo, return error return-value
     1180     :
     1181       for each buf_temp-prt-obj
     1182       on error undo, return error return-value
     1183       :
     1184         delete buf_temp-prt-obj .
     1185       end.
     1186     end.
     1187   end procedure.
     1188   procedure prdoclib-create-temp-prt-obj :
     1189     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1190     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1191     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1192     define buffer buf_gds-prt for ub.gds-prt .
     1193     do
     1194     on error undo, return error return-value
     1195     :
     1196       find first buf_temp-prt-obj
     1197         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1198         no-error .
     1199       if not available buf_temp-prt-obj
     1200       then do:
     1201         create buf_temp-prt-obj .
     1202         assign
     1203           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1204           buf_temp-prt-obj.price-sale       = ?
     1205           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1206           buf_temp-prt-obj.price-list-qnty  = ?
     1207           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1208           buf_temp-prt-obj.price-list-recid = ?
     1209         .
     1210         find first buf_gds-prt no-lock
     1211           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1212           .
     1213         assign
     1214           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1215         .
     1216         if buf_temp-prt-obj.is-term
     1217         then do:
     1218           assign
     1219             buf_temp-prt-obj.price-sale = p-root-price-sale
     1220           .
     1221         end.
     1222       end.
     1223     end.
     1224   end procedure.
     1225   procedure prdoclib-temp-prt-obj-by-prt-root :
     1226     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1227     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1228     define buffer buf_gds-prt for ub.gds-prt .
     1229     do
     1230     on error undo, return error return-value
     1231     :
     1232       find first buf_temp-prt-obj
     1233         where buf_temp-prt-obj.prt-code = p-prt-code
     1234         no-error .
     1235       if not available buf_temp-prt-obj
     1236       then do:
     1237         create buf_temp-prt-obj .
     1238         assign
     1239           buf_temp-prt-obj.prt-code         = p-prt-code
     1240           buf_temp-prt-obj.price-sale       = ?
     1241           buf_temp-prt-obj.fact-qnty        = 0
     1242           buf_temp-prt-obj.price-list-qnty  = ?
     1243           buf_temp-prt-obj.prt-obj-recid    = ?
     1244           buf_temp-prt-obj.price-list-recid = ?
     1245         .
     1246         find first buf_gds-prt no-lock
     1247           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1248           .
     1249         assign
     1250           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1251         .
     1252         if buf_temp-prt-obj.is-term
     1253         then do:
     1254           assign
     1255             buf_temp-prt-obj.price-sale = 0
     1256           .
     1257         end.
     1258       end.
     1259     end.
     1260   end procedure.
     1261   procedure prdoclib-init-temp-prt-obj :
     1262     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1263     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1264     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1265     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1266     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1267     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1268     define buffer buf_prt-obj      for ub.prt-obj .
     1269     define buffer buf_temp-prt-obj for temp-prt-obj .
     1270     do
     1271     on error undo, return error return-value
     1272     :
     1273       run prdoclib-clear-temp-prt-obj in this-procedure .
     1274       for each buf_prt-obj
     1275         where buf_prt-obj.obj-type  = p-obj-type
     1276           and buf_prt-obj.obj-code  = p-obj-code
     1277           and buf_prt-obj.artic     = p-artic
     1278           and buf_prt-obj.prod-type = p-prod-type
     1279           and buf_prt-obj.prod-code = p-prod-code
     1280       on error undo, return error return-value
     1281       :
     1282         run prdoclib-create-temp-prt-obj in this-procedure
     1283           (input  p-root-price-sale
     1284           ,buffer buf_prt-obj
     1285           ,buffer buf_temp-prt-obj
     1286           ).
     1287       end.
     1288     end.
     1289   end procedure.
     1290   procedure prdoclib-calc-fact-sale :
     1291     define input  parameter p-price-list-recid   as recid     no-undo .
     1292     define output parameter p-fact-qnty          as decimal   no-undo .
     1293     define output parameter p-cur-base           as decimal   no-undo .
