     1490         define variable v-unit-base like ub.goods.unit-base no-undo .
     1491   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1493     (input  buf_goods.gds-code
     1494     ,output v-unit-base
     1495     ) no-error .
     1496         if error-status :error
     1497         then do:
     1498           message
     1499             vss-workfile vss-revision vss-description skip
     1500             vss-include-info5 skip
     1501             "Ошибка при определении базовой единицы измерения товара" skip
     1502             "Код товара" buf_goods.gds-code skip
     1503             error-status :get-message(1) skip
     1504             return-value skip
     1505             view-as alert-box error .
     1506           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1507         end.
     1508         for each buf_price-list no-lock
     1509           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1510             and buf_price-list.main-price = false
     1511             and buf_price-list.artic      = buf_main_price-list.artic
     1512             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     1513             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     1514         :
     1515           if buf_price-list.doc-qnty = ?
     1516           then do:
     1517             find first buf_bar-code no-lock
     1518               where buf_bar-code.b-code = buf_price-list.b-code
     1519               no-error .
     1520             if available buf_bar-code
     1521             and buf_bar-code.unit-cli = v-unit-base
     1522             then do:
     1523               message
     1524                 vss-workfile vss-revision vss-description skip
     1525                 vss-include-info5 skip
     1526                 "Ошибка при закрытии переоценки" skip
     1527                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1528                 "Переоценка" buf_main_price-list.doc-num skip
     1529                 "Бар-код" buf_price-list.b-code skip
     1530                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1531                 "Количество" buf_price-list.doc-qnty skip
     1532                 "Основная единица измерения" v-unit-base skip
     1533                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1534                 view-as alert-box error .
     1535               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1536             end.
     1537             next .
     1538           end.
     1539           if not can-find
     1540             (first buf_bar-code
     1541             where buf_bar-code.b-code = buf_price-list.b-code
     1542             )
     1543           then do:
     1544             message
     1545               vss-workfile vss-revision vss-description skip
     1546               vss-include-info5 skip
     1547               "В переоценке задан несуществующий бар-код" skip
     1548               "Переоценка" buf_price-list.doc-num skip
     1549               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1550               "Бар-код" buf_price-list.b-code skip
     1551               view-as alert-box error .
     1552             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1553           end.
     1554           if buf_price-list.doc-qnty <> 0
     1555           then do:
     1556             run prl-vat in this-procedure
     1557               (input  recid(buf_price-list)
     1558               ,output price-rubl-with-tax-sale-prl
     1559               ,output price-base-with-tax-sale-prl
     1560               ,output price-rubl-without-tax-sale-prl
     1561               ,output price-base-without-tax-sale-prl
     1562               ,output vat-base-sale-prl
     1563               ,output vat-rubl-sale-prl
     1564               ,output vat-base-buyer-prl
     1565               ,output vat-rubl-buyer-prl
     1566               ,output slt-base-sale-prl
     1567               ,output slt-rubl-sale-prl
     1568               ,output road-tax-base-sale-prl
     1569               ,output road-tax-rubl-sale-prl
     1570               ,output excise-base-sale-prl
     1571               ,output excise-rubl-sale-prl
     1572               ,output discnt-base-sale-prl
     1573               ,output discnt-rubl-sale-prl
     1574               ) no-error .
     1575             if error-status :error
     1576             then do:
     1577               message
     1578                 vss-workfile vss-revision vss-description skip
     1579                 vss-include-info5 skip
     1580                 "Ошибка при вызове процеды prl-vat" skip
     1581                 "Документ" buf_price-list.doc-num skip
     1582                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1583                 error-status :get-message(1) skip
     1584                 return-value skip
     1585                 view-as alert-box error .
     1586               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1587             end.
     1588           end.
     1589           else do:
     1590             assign
     1591               price-rubl-with-tax-sale-prl    = 0
     1592               price-base-with-tax-sale-prl    = 0
     1593               price-rubl-without-tax-sale-prl = 0
     1594               price-base-without-tax-sale-prl = 0
     1595               vat-base-sale-prl               = 0
     1596               vat-rubl-sale-prl               = 0
     1597               vat-base-buyer-prl              = 0
     1598               vat-rubl-buyer-prl              = 0
     1599               slt-base-sale-prl               = 0
     1600               slt-rubl-sale-prl               = 0
     1601               road-tax-base-sale-prl          = 0
     1602               road-tax-rubl-sale-prl          = 0
     1603               excise-base-sale-prl            = 0
     1604               excise-rubl-sale-prl            = 0
     1605               discnt-base-sale-prl            = 0
     1606               discnt-rubl-sale-prl            = 0
     1607             .
     1608           end.
     1609           if v-curr-r-b = 'base':U
     1610           then do:
     1611             assign
     1612               p-fact-qnty         = p-fact-qnty
     1613                                   + buf_price-list.doc-qnty
     1614               p-cur-base          = p-cur-base
     1615                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1616               p-cur-VAT-base      = p-cur-VAT-base
     1617                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1618               p-cur-SLT-base      = p-cur-SLT-base
     1619                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1620               p-cur-road-tax-base = p-cur-road-tax-base
     1621                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1622               p-cur-excise-base   = p-cur-excise-base
     1623                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1624             .
     1625           end.
     1626           else do:
     1627             assign
     1628               p-fact-qnty         = p-fact-qnty
     1629                                   + buf_price-list.doc-qnty
     1630               p-cur-base          = p-cur-base
     1631                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1632               p-cur-VAT-base      = p-cur-VAT-base
     1633                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1634               p-cur-SLT-base      = p-cur-SLT-base
     1635                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1636               p-cur-road-tax-base = p-cur-road-tax-base
     1637                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1638               p-cur-excise-base   = p-cur-excise-base
