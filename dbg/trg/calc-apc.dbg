     4339       bfacc_tt-allsum.slt-rubl-acc        = bf_tt-allsum.slt-rubl-acc
     4340       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     4341       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     4342       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     4343       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     4344       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     4345       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     4346       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     4347       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     4348       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     4349       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     4350       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     4351       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     4352       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     4353       .
     4354     assign
     4355       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     4356       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     4357       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     4358       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     4359       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     4360       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     4361       bfsacc_tt-allsum.vat-base-doc        = 0
     4362       bfsacc_tt-allsum.vat-rubl-doc        = 0
     4363       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     4364       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     4365       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     4366       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     4367       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     4368       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     4369       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     4370       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     4371       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     4372       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     4373       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     4374       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     4375       bfsacc_tt-allsum.vat-base-cur        = 0
     4376       bfsacc_tt-allsum.vat-rubl-cur        = 0
     4377       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     4378       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     4379       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     4380       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     4381       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     4382       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     4383       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     4384       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     4385       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     4386       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     4387       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     4388       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     4389       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     4390       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     4391       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     4392       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     4393       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     4394       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     4395       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     4396       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     4397       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     4398       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     4399       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     4400       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     4401       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     4402       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     4403       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     4404       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     4405       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     4406       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     4407       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     4408       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     4409       .
     4410   end.
     4411   otherwise do:
     4412     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     4413                              cl_tt-clcparts.purch-code,
     4414                              cl_tt-clcparts.part-code,
     4415                              cl_tt-clcparts.out-code,
     4416                              cl_tt-clcparts.in-code,
     4417                              cl_tt-clcparts.artic,
     4418                              cl_tt-clcparts.prod-type,
     4419                              cl_tt-clcparts.prod-code).
     4420   end.
     4421   end case.
     4422   end.
     4423   end procedure.
     4424   procedure clcprtsl_calc-line :
     4425   define input  parameter parrec-line as recid no-undo.
     4426   define variable v-tax-date         as   date                     no-undo.
     4427   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     4428   define variable varr-b             as   character                no-undo.
     4429   define variable varr-btype         as   character                no-undo.
     4430   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     4431   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     4432   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     4433   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     4434   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     4435   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     4436   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     4437   define variable varb-code          like ub.bar-code.b-code       no-undo.
     4438   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4439   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4440   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4441   define variable varexcise          like ub.price-list.excise     no-undo.
     4442   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     4443   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     4444   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     4445   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4446   define variable v-varsum           as decimal                  no-undo.
     4447   define variable varprice-salef as decimal   no-undo .
     4448   define buffer bf_trn-doc             for ub.trn-doc.
     4449   define buffer bf_doc-line            for ub.doc-line.
     4450   define buffer bf_gds-dtl             for ub.gds-dtl.
     4451   define buffer bf_goods               for ub.goods.
     4452   define buffer bf_parts               for ub.parts.
     4453   define buffer bf_sysconf             for ub.sysconf.
     4454   define buffer bf_tt-allsum-line      for tt-allsum-line.
     4455   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     4456   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     4457   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     4458   define buffer buf_parts        for ub.parts.
     4459   v-calcbypart = no.
     4460   do on error undo, return error return-value :
     4461   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4462   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4463     (output varr-b
     4464     )  .
     4465     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     4466     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     4467     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     4468                               bf_goods.prod-type = bf_doc-line.prod-type and
     4469                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     4470     if bf_trn-doc.fact-date <> ?        then do:
     4471       assign v-tax-date = bf_trn-doc.fact-date.
     4472     end.
     4473     else do:
     4474       assign v-tax-date = ?.
     4475     end.
     4476   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4477   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4478     (input  bf_goods.gds-code
     4479     ,input  '1':U
     4480     ,input  v-tax-date
     4481     ,input  bf_trn-doc.host-code
     4482     ,input  bf_trn-doc.obj-type
     4483     ,input  bf_trn-doc.obj-code
     4484     ,output v-vat-pc
     4485     ) no-error .
     4486     if error-status :error
     4487     or v-vat-pc = ? then do:
     4488        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4489     end.
     4490     if bf_goods.gds-type = 'у':U or
     4491        bf_trn-doc.status_ = 'запрос':U then do:
     4492       for each bf_tt-allsum-line
     4493       on error undo, return error return-value
     4494        :
     4495         delete bf_tt-allsum-line.
     4496       end.
     4497       create bf_tt-allsum-line.
     4498       assign
     4499        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     4500       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     4501                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     4502                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     4503                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     4504         assign
     4505           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     4506           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     4507           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     4508           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     4509           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     4510           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     4511           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     4512           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     4513           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     4514           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     4515           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     4516           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     4517           bf_tt-allsum-line.vat-cli-acc          =  ?
     4518           .
     4519       end.
     4520       assign
     4521         bf_tt-allsum-line.cli-qnty             =  ?
     4522         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4523         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4524         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4525         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4526         bf_tt-allsum-line.road-tax-base-doc    =  0
     4527         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     4528         bf_tt-allsum-line.excise-base-doc      =  0
     4529         bf_tt-allsum-line.excise-rubl-doc      =  0
     4530         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     4531         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     4532         bf_tt-allsum-line.dsc-base-cur         =  0
     4533         bf_tt-allsum-line.dsc-rubl-cur         =  0
     4534         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4535         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     4536         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4537         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4538         bf_tt-allsum-line.road-tax-base-cur    =  0
     4539         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     4540         bf_tt-allsum-line.excise-base-cur      =  0
     4541         bf_tt-allsum-line.excise-rubl-cur      =  0
     4542         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     4543         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     4544         bf_tt-allsum-line.dsc-base-acc         =  0
     4545         bf_tt-allsum-line.dsc-rubl-acc         =  0
     4546         bf_tt-allsum-line.dsc-cli-acc          =  0
     4547         bf_tt-allsum-line.slt-base-acc         =  0
     4548         bf_tt-allsum-line.slt-rubl-acc         =  0
     4549         bf_tt-allsum-line.slt-cli-acc          =  0
     4550         bf_tt-allsum-line.road-tax-base-acc    =  0
     4551         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     4552         bf_tt-allsum-line.road-tax-cli-acc     =  0
     4553         bf_tt-allsum-line.excise-base-acc      =  0
