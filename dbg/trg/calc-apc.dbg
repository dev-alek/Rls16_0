     1316           vss-include-info5 skip
     1317           "Ошибка задания входных параметров" skip
     1318           "Не найдена строка переоценки" skip
     1319           "Код записи (recid)" p-price-list-recid skip
     1320           view-as alert-box error .
     1321         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1322       end.
     1323       if buf_main_price-list.main-price <> true
     1324       then do:
     1325         message
     1326           vss-workfile vss-revision vss-description skip
     1327           vss-include-info5 skip
     1328           "Ошибка задания входных параметров" skip
     1329           "Строка переоценки не является основной" skip
     1330           "Код записи (recid)" p-price-list-recid skip
     1331           "Переоценка" buf_main_price-list.doc-num skip
     1332           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1333           "Бар-код" buf_main_price-list.b-code skip
     1334           view-as alert-box error .
     1335         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     1336       end.
     1337       find first buf_goods no-lock
     1338         where buf_goods.artic     = buf_main_price-list.artic
     1339           and buf_goods.prod-type = buf_main_price-list.prod-type
     1340           and buf_goods.prod-code = buf_main_price-list.prod-code
     1341         no-error .
     1342       if not available buf_goods
     1343       then do:
     1344         message
     1345           vss-workfile vss-revision vss-description skip
     1346           vss-include-info5 skip
     1347           "Не найден товар" skip
     1348           "Переоценка" buf_main_price-list.doc-num skip
     1349           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1350           view-as alert-box error .
     1351         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1352       end.
