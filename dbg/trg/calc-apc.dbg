     2870     else do:
     2871       find first in-vatp_doc-attroprl no-lock
     2872         where in-vatp_doc-attroprl.doc-code  = out-vatp_partsprl.out-code
     2873           and in-vatp_doc-attroprl.attr-code = 'envd':U
     2874         no-error .
     2875       if not available in-vatp_doc-attroprl then do:
