     1442         end.
     1443       end.
     1444       else do:
     1445         assign
     1446           price-rubl-with-tax-sale-prl    = 0
     1447           price-base-with-tax-sale-prl    = 0
     1448           price-rubl-without-tax-sale-prl = 0
     1449           price-base-without-tax-sale-prl = 0
     1450           vat-base-sale-prl               = 0
     1451           vat-rubl-sale-prl               = 0
     1452           vat-base-buyer-prl              = 0
     1453           vat-rubl-buyer-prl              = 0
     1454           slt-base-sale-prl               = 0
     1455           slt-rubl-sale-prl               = 0
     1456           road-tax-base-sale-prl          = 0
     1457           road-tax-rubl-sale-prl          = 0
     1458           excise-base-sale-prl            = 0
     1459           excise-rubl-sale-prl            = 0
     1460           discnt-base-sale-prl            = 0
     1461           discnt-rubl-sale-prl            = 0
     1462         .
     1463       end.
     1464       define variable v-curr-r-b as character no-undo .
     1465   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1466   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1467     (output v-curr-r-b
     1468     )  .
     1469       if v-curr-r-b = 'base':U
     1470       then do:
     1471         assign
     1472           p-fact-qnty         = buf_main_price-list.doc-qnty
     1473           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1474           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     1475           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     1476           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     1477           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     1478         .
     1479       end.
     1480       else do:
     1481         assign
     1482           p-fact-qnty         = buf_main_price-list.doc-qnty
     1483           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1484           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     1485           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     1486           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     1487           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     1488         .
