     4733               varlastcur-excise   = varexcise
     4734               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     4735               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     4736               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
