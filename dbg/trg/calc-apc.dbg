     1299     define buffer buf_price-list      for ub.price-list .
     1300     define buffer buf_goods           for ub.goods .
     1301     define buffer buf_gds-obj         for ub.gds-obj .
     1302     define buffer buf_bar-code        for ub.bar-code .
     1303     define variable l-empty-scale   as logical   no-undo .
     1304     do
     1305     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     1306     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     1307     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     1308     :
     1309       find first buf_main_price-list no-lock
     1310         where recid(buf_main_price-list) = p-price-list-recid
     1311         no-error .
     1312       if not available buf_main_price-list
     1313       then do:
     1314         message
