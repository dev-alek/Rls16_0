        1   block-level on error undo, throw.
        2   define input  parameter p-doc-num  as character no-undo .
        3   define input  parameter p-cut-date as date      no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Расчет складского архива по товарам по переоценке".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2':u,p-doc-num,p-cut-date)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   procedure factord :
      310     define input  parameter p-fact-date            as date    no-undo .
      311     define input  parameter p-fact-time            as integer no-undo .
      312     define input  parameter p-fact-num             as integer no-undo .
      313     define input  parameter p-shift-date           as date    no-undo .
      314     define input  parameter p-shift-num            as integer no-undo .
      315     define input  parameter p-shift-on             as logical no-undo .
      316     define output parameter p-fact-order           as decimal no-undo .
      317     define output parameter p-shift-end-fact-order as decimal no-undo .
      318     define output parameter p-day-end-fact-order   as decimal no-undo .
      319     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      320     if p-fact-date = ?
      321     then do:
      322       return error "Не указана фактическая дата" .
      323     end.
      324     define variable v-fact-date-num as integer no-undo .
      325     assign
      326       v-fact-date-num = integer(p-fact-date)
      327     .
      328     if p-fact-num = ?
      329     or p-fact-num = 0
      330     then do:
      331       return error "Не задан p-fact-num " + string(p-fact-num) .
      332     end.
      333     if p-fact-num < 0
      334     then do:
      335       return error "Отрицательный fact-num " + string(p-fact-num) .
      336     end.
      337     if p-fact-num >= 100000000
      338     then do:
      339       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      340     end.
      341     if p-shift-on = true
      342     then do:
      343       if p-shift-date = ?
      344       then do:
      345         return error "Не задана дата смены" .
      346       end.
      347       if p-shift-num = ?
      348       or p-shift-num = 0
      349       then do:
      350         return error "Не задан номер смены" .
      351       end.
      352     end.
      353     else do:
      354       assign
      355         p-shift-date = p-fact-date
      356         p-shift-num  = 24
      357       .
      358     end.
      359     define variable v-shift-offset as integer no-undo .
      360     if p-shift-date = p-fact-date
      361     then do:
      362       assign
      363         v-shift-offset = 1
      364       .
      365     end.
      366     if p-shift-date < p-fact-date
      367     then do:
      368       assign
      369         v-shift-offset = 0
      370       .
      371     end.
      372     if p-shift-date > p-fact-date
      373     then do:
      374       message
      375         vss-workfile vss-revision vss-description skip
      376         "Неправильная дата закрытия смены" skip
      377         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      378         view-as alert-box error .
      379       undo, return error
      380         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      381           ,string(p-fact-date, '99/99/9999':U)
      382           ,string(p-shift-date, '99/99/9999':U)
      383           )
      384       .
      385     end.
      386     if p-shift-num < 1
      387     or p-shift-num > 24
      388     then do:
      389       message
      390         vss-workfile vss-revision vss-description skip
      391         "Неправильный номер смены" skip
      392         "p-shift-num" p-shift-num skip
      393         view-as alert-box error .
      394       undo, return error return-value .
      395     end.
      396     assign
      397       p-fact-order           = v-fact-date-num
      398                              + v-shift-offset * 0.5
      399                              + p-shift-num    * 0.02 - 0.01
      400                              + p-fact-num     * 0.0000000001
      401       p-shift-end-fact-order = v-fact-date-num
      402                              + v-shift-offset * 0.5
      403                              + p-shift-num    * 0.02
      404       p-day-end-fact-order   = v-fact-date-num
      405                              + 0.99
      406     .
      407     if p-fact-order           <= v-fact-date-num
      408     or p-shift-end-fact-order <= v-fact-date-num
      409     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      410     or p-shift-end-fact-order >= p-day-end-fact-order
      411     then do:
      412       message
      413         vss-workfile vss-revision vss-description skip
      414         "Внутренняя ошибка при генерации фактического номера" skip
      415         "p-fact-date"            p-fact-date            skip
      416         "p-fact-time"            p-fact-time            skip
      417         "p-fact-num"             p-fact-num             skip
      418         "p-shift-date"           p-shift-date           skip
      419         "p-shift-num"            p-shift-num            skip
      420         "p-shift-on"             p-shift-on             skip
      421         "p-shift-end-fact-order" p-shift-end-fact-order skip
      422         "p-day-end-fact-order"   p-day-end-fact-order   skip
      423         "v-fact-date-num"        v-fact-date-num        skip
      424         view-as alert-box error .
      425       undo, return error return-value .
      426     end.
      427   end procedure.
      428   procedure day-begin-fact-order :
      429     define input  parameter p-fact-date            as date    no-undo .
      430     define output parameter p-day-begin-fact-order as decimal no-undo .
      431     do
      432     on error undo, return error return-value
      433     :
      434       if p-fact-date = ?
      435       then do:
      436         assign
      437           p-day-begin-fact-order = 0
      438         .
      439       end.
      440       else do:
      441         assign
      442           p-day-begin-fact-order = integer(p-fact-date)
      443         .
      444       end.
      445     end.
      446   end procedure.
      447   procedure factord-max-fact-order :
      448     define output parameter p-max-fact-order as decimal   no-undo .
      449     do
      450     on error undo, return error return-value
      451     :
      452       run day-begin-fact-order in this-procedure
      453         (input  date(1, 1, 5000)
      454         ,output p-max-fact-order
      455         ) .
      456     end.
      457   end procedure.
      458   procedure factord-cut-archive :
      459     define input  parameter p-obj-type             as character no-undo .
      460     define input  parameter p-obj-code             as integer   no-undo .
      461     define input  parameter p-fact-date            as date      no-undo .
      462     define output parameter p-shift-on             as logical   no-undo .
      463     define output parameter p-shift-date           as date      no-undo .
      464     define output parameter p-shift-num            as integer   no-undo .
      465     define output parameter p-day-end-fact-order   as decimal   no-undo .
      466     define output parameter p-shift-end-fact-order as decimal   no-undo .
      467     define variable v-fact-order as decimal   no-undo .
      468     define buffer buf_shift-obj for ub.shift-obj .
      469     do
      470     on error undo, return error return-value
      471     :
      472   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      473   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      474     (input  p-obj-type
      475     ,input  p-obj-code
      476     ,input  'shift-on=request'
      477     ,output p-shift-on
      478     ) no-error .
      479       if error-status :error
      480       then do:
      481         message
      482           vss-workfile vss-revision vss-description skip
      483           "Ошибка при определении атрибута объекта" skip
      484           "Объект" p-obj-type p-obj-code skip
      485           error-status :get-message(1) skip
      486           return-value skip
      487           view-as alert-box error .
      488         undo, return error return-value .
      489       end.
      490       if p-shift-on = false
      491       then do:
      492         assign
      493           p-shift-date               = ?
      494           p-shift-num                = 0
      495         .
      496       end.
      497       else do:
      498         find first buf_shift-obj share-lock
      499           where buf_shift-obj.obj-type   = p-obj-type
      500             and buf_shift-obj.obj-code   = p-obj-code
      501             and buf_shift-obj.shift-date > p-fact-date
      502           use-index pi
      503           no-error .
      504         if not available buf_shift-obj
      505         or buf_shift-obj.status_ <> 'зкр':U
      506         then do:
      507           message
      508             vss-workfile vss-revision vss-description skip
      509             "Невозможно вычислить последнюю смену" skip
      510             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      511             "Объект" p-obj-type p-obj-code skip
      512             "Дата" p-fact-date skip
      513             view-as alert-box error .
      514           undo, return error return-value .
      515         end.
      516         find last buf_shift-obj share-lock
      517           where buf_shift-obj.obj-type = p-obj-type
      518             and buf_shift-obj.obj-code = p-obj-code
      519             and buf_shift-obj.shift-date <= p-fact-date
      520           use-index pi
      521           no-error .
      522         if available buf_shift-obj
      523         then do:
      524           if  buf_shift-obj.status_ = 'зкр':U
      525           then do:
      526             assign
      527               p-shift-date = buf_shift-obj.shift-date
      528               p-shift-num  = buf_shift-obj.shift-num
      529             .
      530           end.
      531           else do:
      532             message
      533               vss-workfile vss-revision vss-description skip
      534               "Невозможно вычислить последнюю смену" skip
      535               "Статус смены отличен от статуса" 'зкр':U skip
      536               "Объект" p-obj-type p-obj-code skip
      537               "Дата" p-fact-date skip
      538               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      539               view-as alert-box error .
      540             undo, return error return-value .
      541           end.
      542         end.
      543         else do:
      544           assign
      545             p-shift-date = p-fact-date - 1
      546             p-shift-num  = 1
      547           .
      548         end.
      549       end.
      550       run factord in this-procedure
      551         (input  p-fact-date
      552         ,input  1
      553         ,input  1
      554         ,input  p-shift-date
      555         ,input  p-shift-num
      556         ,input  p-shift-on
      557         ,output v-fact-order
      558         ,output p-shift-end-fact-order
      559         ,output p-day-end-fact-order
      560         ) no-error .
      561       if error-status :error
      562       then do:
      563         message
      564           vss-workfile vss-revision vss-description skip
      565           "Ошибка при вызове процедуры factord"
      566           error-status :get-message(1) skip
      567           return-value skip
      568           view-as alert-box error .
      569         undo, return error return-value .
      570       end.
      571     end.
      572   end procedure.
      573   procedure factord-lock-shift :
      574     define input  parameter p-obj-type  as character no-undo .
      575     define input  parameter p-obj-code  as integer   no-undo .
      576     define input  parameter p-fact-date as date      no-undo .
      577     define parameter buffer buf_shift-obj for ub.shift-obj .
      578     define variable v-shift-on      as logical   no-undo .
      579     define variable v-extra-message as character no-undo .
      580     define variable v-error as character no-undo .
      581     do
      582     on error undo, return error return-value
      583     :
      584   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      586     (input  p-obj-type
      587     ,input  p-obj-code
      588     ,input  'shift-on=request'
      589     ,output v-shift-on
      590     ) no-error .
      591       if error-status :error
      592       then do:
      593         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      594         undo, return error v-error .
      595       end.
      596       if v-shift-on = true
      597       then do:
      598         find first buf_shift-obj share-lock
      599           where buf_shift-obj.obj-type   = p-obj-type
      600             and buf_shift-obj.obj-code   = p-obj-code
      601             and buf_shift-obj.shift-date > p-fact-date
      602           use-index pi
      603           no-error .
      604         if not available buf_shift-obj
      605         or buf_shift-obj.status_ <> 'зкр':U
      606         then do:
      607           find last buf_shift-obj
      608             where buf_shift-obj.obj-type = p-obj-type
      609               and buf_shift-obj.obj-code = p-obj-code
      610               and buf_shift-obj.status_  = 'зкр':U
      611             use-index stts
      612             no-error .
      613           if available buf_shift-obj
      614           then do:
      615             assign
      616               v-extra-message =
      617                     substitute("Дата начала последеней закрытой смены на объекте &1"
      618                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      619                               )
      620             .
      621           end.
      622           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      623           undo, return error v-error .
      624         end.
      625       end.
      626     end.
      627   end procedure.
      628   procedure factord-end-day :
      629     define input  parameter p-fact-date            as date    no-undo .
      630     define output parameter p-day-end-fact-order   as decimal no-undo .
      631     do
      632     on error undo, return error return-value
      633     :
      634       if p-fact-date = ?
      635       then do:
      636         return error "Не указана фактическая дата" .
      637       end.
      638       assign
      639         p-day-end-fact-order = integer(p-fact-date) + 0.99
      640       .
      641     end.
      642   end procedure.
      643   procedure factord-to-date :
      644     define input  parameter p-fact-order as decimal no-undo .
      645     define output parameter p-fact-date  as date    no-undo .
      646     define variable v-ref-date  as date      no-undo .
      647     define variable v-ref-delta as integer   no-undo .
      648     do
      649     on error undo, return error return-value
      650     :
      651       if p-fact-order = ?
      652       or p-fact-order = 0
      653       then do:
      654         return error "Не указан fact-order" .
      655       end.
      656       assign
      657         v-ref-date  = date(1, 1, 2000)
      658       .
      659       assign
      660         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      661       .
      662       assign
      663         p-fact-date = v-ref-date + v-ref-delta
      664       .
      665     end.
      666   end procedure.
      667   procedure factord-to-fact-num :
      668     define input  parameter p-fact-order as decimal no-undo .
      669     define output parameter p-fact-num   as integer no-undo .
      670     define variable v-fact-order-trunc as decimal no-undo .
      671     do
      672     on error undo, return error return-value
      673     :
      674       if p-fact-order = ?
      675       or p-fact-order = 0
      676       then do:
      677         return error "Не указан fact-order" .
      678       end.
      679       assign
      680        v-fact-order-trunc = truncate(p-fact-order, 2)
      681       .
      682       assign
      683         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      684       .
      685     end.
      686   end procedure.
      687   procedure factord-to-shift-num :
      688     define input  parameter p-fact-order as decimal no-undo .
      689     define output parameter p-shift-num   as integer no-undo .
      690     define variable  p-shift-numd  as decimal   no-undo .
      691     define variable v-fact-order-trunc as decimal no-undo .
      692     do
      693     on error undo, return error return-value
      694     :
      695       if p-fact-order = ?
      696       or p-fact-order = 0
      697       then do:
      698         return error "Не указан fact-order" .
      699       end.
      700       assign
      701        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      702       .
      703       if v-fact-order-trunc < 0.5 then do:
      704         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      705       end.
      706       assign
      707         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      708         .
      709        assign
      710         p-shift-num = truncate (p-shift-numd , 0)
      711       .
      712     end.
      713   end procedure.
