     3383   do on error undo, return error return-value :
     3384   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     3385   for each bf_tt-allsum on error undo, return error return-value :
     3386     delete bf_tt-allsum.
     3387   end.
     3388   assign
     3389     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     3390     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     3391   .
     3392   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3394     (output varinvprbcl
     3395     )  .
     3396     if cl_tt-clcparts.out-code = 'free-zone':U     or
     3397        cl_tt-clcparts.out-code = 'out-zone':U   or
     3398        cl_tt-clcparts.doc-type = 'акт':U then do:
     3399       assign
     3400         in-vatp-have-vat-sltcl = yes.
     3401     end.
     3402     else do:
     3403       find first in-vatp_doc-attrcl no-lock
     3404         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     3405           and in-vatp_doc-attrcl.attr-code = 'envd':U
     3406         no-error .
     3407       if not available in-vatp_doc-attrcl then do:
     3408         assign
     3409           in-vatp-have-vat-sltcl = yes.
     3410       end.
     3411       else do:
     3412            in-vatp-have-vat-sltcl = no.
     3413       end.
     3414     end.
     3415     assign
     3416      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     3417      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     3418     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     3419              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     3420     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     3421             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     3422             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     3423             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     3424             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     3425             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     3426             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     3427       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     3428     assign
     3429       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
     3430     assign
     3431       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
     3432       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
     3433       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
     3434       transport-cli-loccl  = 0
     3435       other-cli-loccl      = 0
     3436     .
     3437   ASSIGN
     3438             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
     3439       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
     3440   .
     3441   if paris-doc then do:
     3442     assign
     3443       parartic     = cl_tt-clcparts.artic
     3444       parprod-type = cl_tt-clcparts.prod-type
     3445       parprod-code = cl_tt-clcparts.prod-code
     3446       pardoc-type  = cl_tt-clcparts.doc-type
     3447       pardoc-code  = cl_tt-clcparts.out-code
     3448       parobj-type  = cl_tt-clcparts.obj-type
     3449       parobj-code  = cl_tt-clcparts.obj-code.
     3450   if parext-doc-type = 'ot':U or
     3451      parext-doc-type = ?                 then do:
     3452     assign
     3453      out-vatp-have-vat-sltcl = yes.
     3454   end.
     3455   else do:
     3456     find first out-vatp_doc-attrcl no-lock
     3457       where out-vatp_doc-attrcl.doc-code  = pardoc-code
     3458         and out-vatp_doc-attrcl.attr-code = 'envd':U
     3459         no-error .
     3460     if not available out-vatp_doc-attrcl then do:
     3461       assign
     3462         out-vatp-have-vat-sltcl = yes.
     3463     end.
     3464     else do:
     3465        out-vatp-have-vat-sltcl = no.
     3466     end.
     3467   end.
     3468   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
     3469                                      out-vatp_goodscl.prod-type = parprod-type and
     3470                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
     3471   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3472   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3473     (input  parartic
     3474     ,input  parprod-type
     3475     ,input  parprod-code
     3476     ,output varroot-nodecl
     3477     ) no-error .
     3478   if error-status :error then do:
     3479     message
     3480       vss-workfile vss-revision vss-description skip
     3481       "Ошибка при определении корневого признака товара" skip
     3482       "Артикул" parartic parprod-type parprod-code skip
     3483       error-status :get-message(1) skip
     3484       return-value skip
     3485       view-as alert-box error .
     3486     undo, return error .
     3487   end.
     3488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     3489     (input  varroot-nodecl
     3490     ,input  'empty-scale=request'
     3491     ,output varempty-scalecl
     3492     ) no-error .
     3493   if error-status :error then do:
     3494     message
     3495       vss-workfile vss-revision vss-description skip
     3496       "Ошибка при определении атрибута признака" skip
     3497       "Артикул" parartic parprod-type parprod-code skip
     3498       "Признак" varroot-nodecl skip
     3499       "Запрашивался атрибут" "empty-scale=request" skip
