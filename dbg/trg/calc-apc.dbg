     4851   procedure clcprtsl_calc-ttable :
     4852   define input parameter paris-doc           as   logical                 no-undo.
     4853   define input parameter paris-cur           as   logical                 no-undo.
     4854   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     4855   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     4856   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     4857   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4858   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     4859   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     4860   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     4861   define input parameter parr-b              as   character               no-undo.
     4862   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     4863   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     4864   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     4865   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     4866   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4867   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4868   define buffer bf_tt-allsum      for tt-allsum.
     4869   define buffer bf_tt-clcparts    for tt-clcparts.
     4870   define buffer bf_tt-allsum-line for tt-allsum-line.
     4871   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4872   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4873   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4874   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4875   define variable varexcise          like ub.price-list.excise     no-undo.
     4876   do on error undo, return error return-value :
     4877   for each bf_tt-allsum-line
     4878   on error undo, return error return-value
     4879    :
     4880     delete bf_tt-allsum-line.
     4881   end.
     4882   for each bf_tt-allsum
