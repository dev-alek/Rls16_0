     2690         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2691       end.
     2692       if varslt-pc = ?
     2693       then do:
     2694         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2695       end.
     2696       assign
     2697         varbase-rate   = 1
     2698         varbase-scale  = 1
     2699         varroad-tax    = bf_price-list.road-tax
     2700         varexcise      = bf_price-list.excise
     2701         varprice-base  = bf_price-list.price-sale
     2702         varprice-rubl  = bf_price-list.price-sale
     2703         vardiscnt-base = 0
     2704         vardiscnt-rubl = 0
     2705       .
     2706       assign
     2707         varfact-qnty = 0
     2708       .
     2709       for each bf_parts no-lock
     2710         where bf_parts.out-code   = bf_price-list.doc-num
     2711           and bf_parts.obj-type   = bf_price-list.obj-type
     2712           and bf_parts.obj-code   = bf_price-list.obj-code
     2713           and bf_parts.artic      = bf_price-list.artic
     2714           and bf_parts.prod-type  = bf_price-list.prod-type
     2715           and bf_parts.prod-code  = bf_price-list.prod-code
     2716       :
     2717         assign
     2718           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     2719         .
     2720       end.
     2721       assign
     2722         vardoc-num   = bf_price-list.doc-num
     2723         vardoc-code  = bf_price-list.doc-num
     2724         varobj-type  = bf_price-list.obj-type
     2725         varobj-code  = bf_price-list.obj-code
     2726         varartic     = bf_price-list.artic
     2727         varprod-type = bf_price-list.prod-type
     2728         varprod-code = bf_price-list.prod-code
     2729         vardoc-qnty  = varfact-qnty
     2730         varext-doc-type = 'ot':U
     2731       .
     2732   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2733   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2734     (input  bf_price-list.obj-type
     2735     ,input  bf_price-list.obj-code
     2736     ,output v-host-code
     2737     )  .
     2738       find first bf_sysconf no-lock
     2739         where bf_sysconf.host-code = v-host-code
     2740         .
     2741       if bf_sysconf.cons-vat-pc = ?
     2742       then do:
     2743         return error "Не задан консигнационный НДС по фирме." .
     2744       end.
     2745       else do:
     2746         assign
     2747           varcons-vat-pc = bf_sysconf.cons-vat-pc
     2748         .
     2749       end.
     2750   if varext-doc-type = 'ot':U or
     2751      varext-doc-type = ?                 then do:
     2752     assign
     2753      out-vatp-have-vat-sltprl = yes.
     2754   end.
     2755   else do:
     2756     find first out-vatp_doc-attrprl no-lock
     2757       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     2758         and out-vatp_doc-attrprl.attr-code = 'envd':U
     2759         no-error .
     2760     if not available out-vatp_doc-attrprl then do:
     2761       assign
     2762         out-vatp-have-vat-sltprl = yes.
     2763     end.
     2764     else do:
     2765        out-vatp-have-vat-sltprl = no.
     2766     end.
     2767   end.
     2768   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
     2769                                      out-vatp_goodsprl.prod-type = varprod-type and
     2770                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
     2771   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2772   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2773     (input  varartic
     2774     ,input  varprod-type
     2775     ,input  varprod-code
     2776     ,output varroot-nodeprl
     2777     ) no-error .
     2778   if error-status :error then do:
     2779     message
     2780       vss-workfile vss-revision vss-description skip
     2781       "Ошибка при определении корневого признака товара" skip
     2782       "Артикул" varartic varprod-type varprod-code skip
     2783       error-status :get-message(1) skip
     2784       return-value skip
     2785       view-as alert-box error .
