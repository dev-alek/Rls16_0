     1422           ,output slt-rubl-sale-prl
     1423           ,output road-tax-base-sale-prl
     1424           ,output road-tax-rubl-sale-prl
     1425           ,output excise-base-sale-prl
     1426           ,output excise-rubl-sale-prl
     1427           ,output discnt-base-sale-prl
     1428           ,output discnt-rubl-sale-prl
     1429           ) no-error .
     1430         if error-status :error
     1431         then do:
     1432           message
     1433             vss-workfile vss-revision vss-description skip
