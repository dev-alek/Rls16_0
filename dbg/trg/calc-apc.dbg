     6101           undo, return error .
     6102         end.
     6103         if l-gds-goods then do:
     6104           do v-root-sum-type-ind-ext = 1 to extent(v-root-sum-type)
     6105           :
     6106             find last ub.stk-line no-lock
     6107               where ub.stk-line.obj-type   = ub.price-list.obj-type
     6108                 and ub.stk-line.obj-code   = ub.price-list.obj-code
     6109                 and ub.stk-line.artic      = ub.price-list.artic
     6110                 and ub.stk-line.prod-type  = ub.price-list.prod-type
     6111                 and ub.stk-line.prod-code  = ub.price-list.prod-code
     6112                 and ub.stk-line.sum-type   = v-root-sum-type[v-root-sum-type-ind-ext]
     6113                 and ub.stk-line.fact-order <= v-stk-line-fact-order
     6114                 and ub.stk-line.shift-date = ?
     6115               use-index category
     6116               no-error .
     6117             if available ub.stk-line then do:
     6118               assign
     6119                 v-prev-stk-line-fact-order = ub.stk-line.fact-order
     6120               .
     6121               for each ub.stk-line no-lock
     6122                 where ub.stk-line.obj-type   = ub.price-list.obj-type
     6123                   and ub.stk-line.obj-code   = ub.price-list.obj-code
     6124                   and ub.stk-line.artic      = ub.price-list.artic
     6125                   and ub.stk-line.prod-type  = ub.price-list.prod-type
     6126                   and ub.stk-line.prod-code  = ub.price-list.prod-code
     6127                   and ub.stk-line.fact-order = v-prev-stk-line-fact-order
     6128                   and ub.stk-line.sum-type   begins v-root-sum-type[v-root-sum-type-ind-ext]
     6129               on error undo, return error
     6130               :
     6131                 create temp-stk-line .
     6132                 buffer-copy ub.stk-line to temp-stk-line
     6133                 assign
     6134                   temp-stk-line.fact-order = v-stk-line-fact-order
     6135                   temp-stk-line.fact-date  = ub.price-doc.fact-date
     6136                   temp-stk-line.shift-date = ?
     6137                   temp-stk-line.shift-num  = 0
     6138                 .
     6139                 if v-root-sum-type-ind-ext = 2 then do:
     6140                   assign
     6141                                                                                                                                 temp-stk-line.new-fact-qnty      = ub.stk-line.fact-qnty            temp-stk-line.new-sum-base       = ub.stk-line.sum-base             temp-stk-line.new-sum-rubl       = ub.stk-line.sum-rubl             temp-stk-line.new-vat-base       = ub.stk-line.vat-base             temp-stk-line.new-vat-rubl       = ub.stk-line.vat-rubl             temp-stk-line.new-slt-base       = ub.stk-line.slt-base             temp-stk-line.new-slt-rubl       = ub.stk-line.slt-rubl             temp-stk-line.new-road-tax-base  = ub.stk-line.road-tax-base        temp-stk-line.new-road-tax-rubl  = ub.stk-line.road-tax-rubl        temp-stk-line.new-excise-base    = ub.stk-line.excise-base          temp-stk-line.new-excise-rubl    = ub.stk-line.excise-rubl          temp-stk-line.new-transport-base = ub.stk-line.transport-base       temp-stk-line.new-transport-rubl = ub.stk-line.transport-rubl       temp-stk-line.new-other-base     = ub.stk-line.other-base           temp-stk-line.new-other-rubl     = ub.stk-line.other-rubl
     6142                   .
     6143                 end.
     6144               end.
     6145               for each ub.stk-line no-lock
     6146                 where ub.stk-line.obj-type   = ub.price-list.obj-type
     6147                   and ub.stk-line.obj-code   = ub.price-list.obj-code
     6148                   and ub.stk-line.artic      = ub.price-list.artic
     6149                   and ub.stk-line.prod-type  = ub.price-list.prod-type
     6150                   and ub.stk-line.prod-code  = ub.price-list.prod-code
     6151                   and ub.stk-line.fact-order > v-stk-line-fact-order
     6152                   and ub.stk-line.fact-order <= v-day-cut-fact-order
     6153               on error undo, return error
     6154               :
     6155                 if ub.stk-line.sum-type   begins v-root-sum-type[v-root-sum-type-ind-ext]
     6156                 and ub.stk-line.shift-date = ?
     6157                 then do:
     6158                   message
     6159                     vss-workfile vss-revision vss-description skip
     6160                     "Обнаружены более поздние данные складского архива по товарам" skip
     6161                     "Данная версия программы не рассчитана на закрытие переоценок задним числом" skip
     6162                     "ub.stk-line.obj-type"     ub.stk-line.obj-type   skip
     6163                     "ub.stk-line.obj-code"     ub.stk-line.obj-code   skip
     6164                     "ub.stk-line.artic"        ub.stk-line.artic      skip
     6165                     "ub.stk-line.prod-type"    ub.stk-line.prod-type  skip
     6166                     "ub.stk-line.prod-code"    ub.stk-line.prod-code  skip
     6167                     "ub.stk-line.fact-order"   ub.stk-line.fact-order skip
     6168                     "ub.stk-line.sum-type"     ub.stk-line.sum-type   skip
     6169                     "Документ переоценки"      ub.price-doc.doc-num   skip
     6170                     "Объект"                   ub.price-doc.obj-type ub.price-doc.obj-code skip
     6171                     "Дата закрытия переоценки" ub.price-doc.fact-date skip
     6172                     "Артикул"                  ub.price-list.artic ub.price-list.prod-type ub.price-list.prod-code skip
     6173                     "Смена переоценки"         ub.price-doc.shift-date "Номер" ub.price-doc.shift-num skip
     6174                     view-as alert-box error .
     6175                   undo, return error .
     6176                 end.
     6177               end.
     6178             end.
     6179             else do:
     6180               create temp-stk-line.
     6181               assign
     6182                 temp-stk-line.obj-type   = ub.price-list.obj-type
     6183                 temp-stk-line.obj-code   = ub.price-list.obj-code
     6184                 temp-stk-line.artic      = ub.price-list.artic
     6185                 temp-stk-line.prod-type  = ub.price-list.prod-type
     6186                 temp-stk-line.prod-code  = ub.price-list.prod-code
     6187                 temp-stk-line.fact-order = v-stk-line-fact-order
     6188                 temp-stk-line.sum-type   = v-root-sum-type[v-root-sum-type-ind-ext]
     6189                 temp-stk-line.cat-id     = '##,##':U
     6190                 temp-stk-line.fact-date  = ub.price-doc.fact-date
     6191                 temp-stk-line.shift-date = ?
     6192                 temp-stk-line.shift-num  = 0
     6193               .
     6194             end.
     6195             if v-shift-on then do:
     6196               assign
     6197                 v-prev-shift-stk-line-fact-order = 0
     6198               .
     6199               find last ub.stk-line no-lock
     6200                 where ub.stk-line.obj-type   = ub.price-list.obj-type
     6201                   and ub.stk-line.obj-code   = ub.price-list.obj-code
     6202                   and ub.stk-line.artic      = ub.price-list.artic
     6203                   and ub.stk-line.prod-type  = ub.price-list.prod-type
     6204                   and ub.stk-line.prod-code  = ub.price-list.prod-code
     6205                   and ub.stk-line.sum-type   = v-root-sum-type[v-root-sum-type-ind-ext]
     6206                   and ub.stk-line.fact-order <= v-shift-stk-line-fact-order
     6207                   and ub.stk-line.shift-date <> ?
     6208                 use-index category
     6209                 no-error .
     6210               if available ub.stk-line then do:
     6211                 assign
     6212                   v-prev-shift-stk-line-fact-order = ub.stk-line.fact-order
     6213                 .
     6214               end.
     6215               if v-prev-shift-stk-line-fact-order > 0 then do:
     6216                 for each ub.stk-line no-lock
     6217                   where ub.stk-line.obj-type   = ub.price-list.obj-type
     6218                     and ub.stk-line.obj-code   = ub.price-list.obj-code
     6219                     and ub.stk-line.artic      = ub.price-list.artic
     6220                     and ub.stk-line.prod-type  = ub.price-list.prod-type
     6221                     and ub.stk-line.prod-code  = ub.price-list.prod-code
     6222                     and ub.stk-line.fact-order = v-prev-shift-stk-line-fact-order
     6223                     and ub.stk-line.sum-type   begins v-root-sum-type[v-root-sum-type-ind-ext]
     6224                 on error undo, return error
     6225                 :
     6226                   create temp-shift-stk-line .
     6227                   buffer-copy ub.stk-line to temp-shift-stk-line
     6228                   assign
     6229                     temp-shift-stk-line.fact-order = v-shift-stk-line-fact-order
     6230                     temp-shift-stk-line.fact-date  = ub.price-doc.fact-date
     6231                     temp-shift-stk-line.shift-date = ub.price-doc.shift-date
     6232                     temp-shift-stk-line.shift-num  = ub.price-doc.shift-num
     6233                   .
     6234                   if v-root-sum-type-ind-ext = 2 then do:
     6235                     assign
     6236                                                                                                                                               temp-shift-stk-line.new-fact-qnty      = ub.stk-line.fact-qnty            temp-shift-stk-line.new-sum-base       = ub.stk-line.sum-base             temp-shift-stk-line.new-sum-rubl       = ub.stk-line.sum-rubl             temp-shift-stk-line.new-vat-base       = ub.stk-line.vat-base             temp-shift-stk-line.new-vat-rubl       = ub.stk-line.vat-rubl             temp-shift-stk-line.new-slt-base       = ub.stk-line.slt-base             temp-shift-stk-line.new-slt-rubl       = ub.stk-line.slt-rubl             temp-shift-stk-line.new-road-tax-base  = ub.stk-line.road-tax-base        temp-shift-stk-line.new-road-tax-rubl  = ub.stk-line.road-tax-rubl        temp-shift-stk-line.new-excise-base    = ub.stk-line.excise-base          temp-shift-stk-line.new-excise-rubl    = ub.stk-line.excise-rubl          temp-shift-stk-line.new-transport-base = ub.stk-line.transport-base       temp-shift-stk-line.new-transport-rubl = ub.stk-line.transport-rubl       temp-shift-stk-line.new-other-base     = ub.stk-line.other-base           temp-shift-stk-line.new-other-rubl     = ub.stk-line.other-rubl
     6237                     .
     6238                   end.
     6239                 end.
     6240                 for each ub.stk-line no-lock
     6241                   where ub.stk-line.obj-type   = ub.price-list.obj-type
     6242                     and ub.stk-line.obj-code   = ub.price-list.obj-code
     6243                     and ub.stk-line.artic      = ub.price-list.artic
     6244                     and ub.stk-line.prod-type  = ub.price-list.prod-type
     6245                     and ub.stk-line.prod-code  = ub.price-list.prod-code
     6246                     and ub.stk-line.fact-order > v-shift-stk-line-fact-order
     6247                     and ub.stk-line.fact-order <= v-shift-cut-fact-order
     6248                 on error undo, return error
     6249                 :
     6250                   if ub.stk-line.sum-type   begins v-root-sum-type[v-root-sum-type-ind-ext]
     6251                   and ub.stk-line.shift-date <> ?
     6252                   then do:
     6253                     message
     6254                       vss-workfile vss-revision vss-description skip
     6255                       "Обнаружены более поздние данные складского архива по товарам" skip
     6256                       "Данная версия программы не рассчитана на закрытие переоценок задним числом" skip
     6257                       "ub.stk-line.obj-type"     ub.stk-line.obj-type   skip
     6258                       "ub.stk-line.obj-code"     ub.stk-line.obj-code   skip
     6259                       "ub.stk-line.artic"        ub.stk-line.artic      skip
     6260                       "ub.stk-line.prod-type"    ub.stk-line.prod-type  skip
     6261                       "ub.stk-line.prod-code"    ub.stk-line.prod-code  skip
     6262                       "ub.stk-line.fact-order"   ub.stk-line.fact-order skip
     6263                       "ub.stk-line.sum-type"     ub.stk-line.sum-type   skip
     6264                       "Документ переоценки"      ub.price-doc.doc-num   skip
     6265                       "Объект"                   ub.price-doc.obj-type ub.price-doc.obj-code skip
     6266                       "Дата закрытия переоценки" ub.price-doc.fact-date skip
     6267                       "Артикул"                  ub.price-list.artic ub.price-list.prod-type ub.price-list.prod-code skip
     6268                       "Смена переоценки"         ub.price-doc.shift-date "Номер" ub.price-doc.shift-num skip
     6269                       view-as alert-box error .
     6270                     undo, return error .
     6271                   end.
     6272                 end.
     6273               end.
     6274               else do:
     6275                 create temp-shift-stk-line.
     6276                 assign
     6277                   temp-shift-stk-line.obj-type   = ub.price-list.obj-type
     6278                   temp-shift-stk-line.obj-code   = ub.price-list.obj-code
     6279                   temp-shift-stk-line.artic      = ub.price-list.artic
     6280                   temp-shift-stk-line.prod-type  = ub.price-list.prod-type
     6281                   temp-shift-stk-line.prod-code  = ub.price-list.prod-code
     6282                   temp-shift-stk-line.fact-order = v-shift-stk-line-fact-order
     6283                   temp-shift-stk-line.sum-type   = v-root-sum-type[v-root-sum-type-ind-ext]
     6284                   temp-shift-stk-line.cat-id     = '##,##':U
     6285                   temp-shift-stk-line.fact-date  = ub.price-doc.fact-date
     6286                   temp-shift-stk-line.shift-date = ub.price-doc.shift-date
     6287                   temp-shift-stk-line.shift-num  = ub.price-doc.shift-num
     6288                 .
     6289               end.
     6290             end.
     6291           end.
     6292         end.
     6293       end.
     6294     end.
     6295   end procedure.
     6296   procedure update-ot-line :
     6297     define variable v-crsa-vat-pc like doc-line.vat-pc   no-undo .
     6298     define variable v-crsa-slt-pc like doc-line.slt-pc   no-undo .
     6299     define variable v-host-code   like sysconf.host-code no-undo .
     6300     define buffer buf_goods for ub.goods .
     6301     define buffer buf_price-list for ub.price-list .
     6302     do
     6303     on error undo, return error
     6304     :
     6305   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6306   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6307     (input  ub.price-doc.obj-type
     6308     ,input  ub.price-doc.obj-code
     6309     ,output v-host-code
     6310     )  .
     6311       for each temp-stk-line
     6312         where (
     6313                                             temp-stk-line.fact-qnty      <> temp-stk-line.new-fact-qnty        or    temp-stk-line.sum-base       <> temp-stk-line.new-sum-base         or    temp-stk-line.sum-rubl       <> temp-stk-line.new-sum-rubl         or    temp-stk-line.vat-base       <> temp-stk-line.new-vat-base         or    temp-stk-line.vat-rubl       <> temp-stk-line.new-vat-rubl         or    temp-stk-line.slt-base       <> temp-stk-line.new-slt-base         or    temp-stk-line.slt-rubl       <> temp-stk-line.new-slt-rubl         or    temp-stk-line.road-tax-base  <> temp-stk-line.new-road-tax-base    or    temp-stk-line.road-tax-rubl  <> temp-stk-line.new-road-tax-rubl    or    temp-stk-line.excise-base    <> temp-stk-line.new-excise-base      or    temp-stk-line.excise-rubl    <> temp-stk-line.new-excise-rubl      or    temp-stk-line.transport-base <> temp-stk-line.new-transport-base   or    temp-stk-line.transport-rubl <> temp-stk-line.new-transport-rubl   or    temp-stk-line.other-base     <> temp-stk-line.new-other-base       or    temp-stk-line.other-rubl     <> temp-stk-line.new-other-rubl
     6314               )
     6315           and temp-stk-line.sum-type = 'crsa':U
     6316       on error undo, return error
     6317       :
     6318         find first temp-ot-line
     6319           where temp-ot-line.doc-code  = ub.price-doc.doc-num
     6320             and temp-ot-line.artic     = temp-stk-line.artic
     6321             and temp-ot-line.prod-type = temp-stk-line.prod-type
     6322             and temp-ot-line.prod-code = temp-stk-line.prod-code
     6323             and temp-ot-line.sum-type  = temp-stk-line.sum-type
     6324           no-error .
     6325         if not available temp-ot-line then do:
     6326           create temp-ot-line .
     6327           assign
     6328             temp-ot-line.doc-code  = ub.price-doc.doc-num
     6329             temp-ot-line.artic     = temp-stk-line.artic
     6330             temp-ot-line.prod-type = temp-stk-line.prod-type
     6331             temp-ot-line.prod-code = temp-stk-line.prod-code
     6332             temp-ot-line.sum-type  = temp-stk-line.sum-type
     6333           .
     6334           find first buf_goods no-lock
     6335             where buf_goods.artic     = temp-stk-line.artic
     6336               and buf_goods.prod-type = temp-stk-line.prod-type
     6337               and buf_goods.prod-code = temp-stk-line.prod-code
     6338             .
     6339           find first buf_price-list no-lock
     6340             where buf_price-list.doc-num    = ub.price-doc.doc-num
     6341               and buf_price-list.main-price = true
     6342               and buf_price-list.artic      = temp-stk-line.artic
     6343               and buf_price-list.prod-type  = temp-stk-line.prod-type
     6344               and buf_price-list.prod-code  = temp-stk-line.prod-code
     6345             .
     6346           assign
     6347             v-crsa-vat-pc = buf_price-list.vat-pc
     6348             v-crsa-slt-pc = buf_price-list.slt-pc
     6349           .
     6350           if v-crsa-vat-pc = ?
     6351           then do:
     6352             message
     6353               vss-workfile vss-revision vss-description skip
     6354               "Не задан налог товара на дату" skip
     6355               "Налог" "НДС" skip
     6356               "Переоценка" ub.price-doc.doc-num skip
     6357               "Код товара" buf_goods.gds-code skip
     6358               "Тип налога" '1':U skip
     6359               "Дата" ub.price-doc.fact-date skip
     6360               view-as alert-box error .
     6361             undo, return error return-value .
     6362           end.
     6363           if v-crsa-slt-pc = ?
     6364           then do:
     6365             message
     6366               vss-workfile vss-revision vss-description skip
     6367               "Не задан налог товара на дату" skip
     6368               "Налог" "НП" skip
     6369               "Переоценка" ub.price-doc.doc-num skip
     6370               "Код товара" buf_goods.gds-code skip
     6371               "Тип налога" '2':U skip
     6372               "Дата" ub.price-doc.fact-date skip
     6373               view-as alert-box error .
     6374             undo, return error return-value .
     6375           end.
     6376           assign
     6377             temp-ot-line.cat-id    = trim(string(v-crsa-vat-pc, ">99")) + ","
     6378                                   + trim(string(v-crsa-slt-pc, ">99"))
     6379             temp-ot-line.ext-doc-type = v-ext-doc-type
     6380             temp-ot-line.obj-type     = ub.price-doc.obj-type
     6381             temp-ot-line.obj-code     = ub.price-doc.obj-code
     6382             temp-ot-line.fact-order   = v-ot-fact-order
     6383           .
     6384         end.
     6385         assign
     6386                                                                                           temp-ot-line.new-fact-qnty      = temp-ot-line.new-fact-qnty      + temp-stk-line.new-fact-qnty      - temp-stk-line.fact-qnty           temp-ot-line.new-sum-base       = temp-ot-line.new-sum-base       + temp-stk-line.new-sum-base       - temp-stk-line.sum-base            temp-ot-line.new-sum-rubl       = temp-ot-line.new-sum-rubl       + temp-stk-line.new-sum-rubl       - temp-stk-line.sum-rubl            temp-ot-line.new-vat-base       = temp-ot-line.new-vat-base       + temp-stk-line.new-vat-base       - temp-stk-line.vat-base            temp-ot-line.new-vat-rubl       = temp-ot-line.new-vat-rubl       + temp-stk-line.new-vat-rubl       - temp-stk-line.vat-rubl            temp-ot-line.new-slt-base       = temp-ot-line.new-slt-base       + temp-stk-line.new-slt-base       - temp-stk-line.slt-base            temp-ot-line.new-slt-rubl       = temp-ot-line.new-slt-rubl       + temp-stk-line.new-slt-rubl       - temp-stk-line.slt-rubl            temp-ot-line.new-road-tax-base  = temp-ot-line.new-road-tax-base  + temp-stk-line.new-road-tax-base  - temp-stk-line.road-tax-base       temp-ot-line.new-road-tax-rubl  = temp-ot-line.new-road-tax-rubl  + temp-stk-line.new-road-tax-rubl  - temp-stk-line.road-tax-rubl       temp-ot-line.new-excise-base    = temp-ot-line.new-excise-base    + temp-stk-line.new-excise-base    - temp-stk-line.excise-base         temp-ot-line.new-excise-rubl    = temp-ot-line.new-excise-rubl    + temp-stk-line.new-excise-rubl    - temp-stk-line.excise-rubl         temp-ot-line.new-transport-base = temp-ot-line.new-transport-base + temp-stk-line.new-transport-base - temp-stk-line.transport-base      temp-ot-line.new-transport-rubl = temp-ot-line.new-transport-rubl + temp-stk-line.new-transport-rubl - temp-stk-line.transport-rubl      temp-ot-line.new-other-base     = temp-ot-line.new-other-base     + temp-stk-line.new-other-base     - temp-stk-line.other-base          temp-ot-line.new-other-rubl     = temp-ot-line.new-other-rubl     + temp-stk-line.new-other-rubl     - temp-stk-line.other-rubl
     6387         .
     6388       end.
     6389     end.
     6390   end procedure.
     6391   procedure update-shift-ot-line :
     6392     define variable v-crsa-vat-pc like doc-line.vat-pc   no-undo .
     6393     define variable v-crsa-slt-pc like doc-line.slt-pc   no-undo .
     6394     define variable v-host-code   like sysconf.host-code no-undo .
     6395     define buffer buf_goods for ub.goods .
     6396     define buffer buf_price-list for ub.price-list .
     6397     do
     6398     on error undo, return error
     6399     :
     6400   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6402     (input  ub.price-doc.obj-type
     6403     ,input  ub.price-doc.obj-code
     6404     ,output v-host-code
     6405     )  .
     6406       for each temp-shift-stk-line
     6407         where (
     6408                                             temp-shift-stk-line.fact-qnty      <> temp-shift-stk-line.new-fact-qnty        or    temp-shift-stk-line.sum-base       <> temp-shift-stk-line.new-sum-base         or    temp-shift-stk-line.sum-rubl       <> temp-shift-stk-line.new-sum-rubl         or    temp-shift-stk-line.vat-base       <> temp-shift-stk-line.new-vat-base         or    temp-shift-stk-line.vat-rubl       <> temp-shift-stk-line.new-vat-rubl         or    temp-shift-stk-line.slt-base       <> temp-shift-stk-line.new-slt-base         or    temp-shift-stk-line.slt-rubl       <> temp-shift-stk-line.new-slt-rubl         or    temp-shift-stk-line.road-tax-base  <> temp-shift-stk-line.new-road-tax-base    or    temp-shift-stk-line.road-tax-rubl  <> temp-shift-stk-line.new-road-tax-rubl    or    temp-shift-stk-line.excise-base    <> temp-shift-stk-line.new-excise-base      or    temp-shift-stk-line.excise-rubl    <> temp-shift-stk-line.new-excise-rubl      or    temp-shift-stk-line.transport-base <> temp-shift-stk-line.new-transport-base   or    temp-shift-stk-line.transport-rubl <> temp-shift-stk-line.new-transport-rubl   or    temp-shift-stk-line.other-base     <> temp-shift-stk-line.new-other-base       or    temp-shift-stk-line.other-rubl     <> temp-shift-stk-line.new-other-rubl
     6409               )
     6410           and temp-shift-stk-line.sum-type = 'crsa':U
     6411       on error undo, return error
     6412       :
     6413         find first temp-shift-ot-line
     6414           where temp-shift-ot-line.doc-code  = ub.price-doc.doc-num
     6415             and temp-shift-ot-line.artic     = temp-shift-stk-line.artic
     6416             and temp-shift-ot-line.prod-type = temp-shift-stk-line.prod-type
     6417             and temp-shift-ot-line.prod-code = temp-shift-stk-line.prod-code
     6418             and temp-shift-ot-line.sum-type  = temp-shift-stk-line.sum-type
     6419           no-error .
     6420         if not available temp-shift-ot-line then do:
     6421           create temp-shift-ot-line .
     6422           assign
     6423             temp-shift-ot-line.doc-code  = ub.price-doc.doc-num
     6424             temp-shift-ot-line.artic     = temp-shift-stk-line.artic
     6425             temp-shift-ot-line.prod-type = temp-shift-stk-line.prod-type
     6426             temp-shift-ot-line.prod-code = temp-shift-stk-line.prod-code
     6427             temp-shift-ot-line.sum-type  = temp-shift-stk-line.sum-type
     6428           .
     6429           find first buf_goods no-lock
     6430             where buf_goods.artic     = temp-shift-stk-line.artic
     6431               and buf_goods.prod-type = temp-shift-stk-line.prod-type
     6432               and buf_goods.prod-code = temp-shift-stk-line.prod-code
     6433             .
     6434           find first buf_price-list no-lock
     6435             where buf_price-list.doc-num    = ub.price-doc.doc-num
     6436               and buf_price-list.main-price = true
     6437               and buf_price-list.artic      = temp-stk-line.artic
     6438               and buf_price-list.prod-type  = temp-stk-line.prod-type
     6439               and buf_price-list.prod-code  = temp-stk-line.prod-code
     6440             .
     6441           assign
     6442             v-crsa-vat-pc = buf_price-list.vat-pc
     6443             v-crsa-slt-pc = buf_price-list.slt-pc
     6444           .
     6445           if v-crsa-vat-pc = ?
     6446           then do:
     6447             message
     6448               vss-workfile vss-revision vss-description skip
     6449               "Не задан налог товара на дату" skip
     6450               "Налог" "НДС" skip
     6451               "Переоценка" ub.price-doc.doc-num skip
     6452               "Код товара" buf_goods.gds-code skip
     6453               "Тип налога" '1':U skip
     6454               "Дата" ub.price-doc.fact-date skip
     6455               view-as alert-box error .
     6456             undo, return error return-value .
     6457           end.
     6458           if v-crsa-slt-pc = ?
     6459           then do:
     6460             message
     6461               vss-workfile vss-revision vss-description skip
     6462               "Не задан налог товара на дату" skip
     6463               "Налог" "НП" skip
     6464               "Переоценка" ub.price-doc.doc-num skip
     6465               "Код товара" buf_goods.gds-code skip
     6466               "Тип налога" '2':U skip
     6467               "Дата" ub.price-doc.fact-date skip
     6468               view-as alert-box error .
     6469             undo, return error return-value .
     6470           end.
     6471           assign
     6472             temp-shift-ot-line.cat-id = trim(string(v-crsa-vat-pc, ">99")) + ","
     6473                                       + trim(string(v-crsa-slt-pc, ">99"))
     6474             temp-shift-ot-line.ext-doc-type = v-ext-doc-type
     6475             temp-shift-ot-line.obj-type     = ub.price-doc.obj-type
     6476             temp-shift-ot-line.obj-code     = ub.price-doc.obj-code
     6477             temp-shift-ot-line.fact-order   = v-ot-fact-order
     6478           .
     6479         end.
     6480         assign
     6481                                                                                           temp-shift-ot-line.new-fact-qnty      = temp-shift-ot-line.new-fact-qnty      + temp-shift-stk-line.new-fact-qnty      - temp-shift-stk-line.fact-qnty           temp-shift-ot-line.new-sum-base       = temp-shift-ot-line.new-sum-base       + temp-shift-stk-line.new-sum-base       - temp-shift-stk-line.sum-base            temp-shift-ot-line.new-sum-rubl       = temp-shift-ot-line.new-sum-rubl       + temp-shift-stk-line.new-sum-rubl       - temp-shift-stk-line.sum-rubl            temp-shift-ot-line.new-vat-base       = temp-shift-ot-line.new-vat-base       + temp-shift-stk-line.new-vat-base       - temp-shift-stk-line.vat-base            temp-shift-ot-line.new-vat-rubl       = temp-shift-ot-line.new-vat-rubl       + temp-shift-stk-line.new-vat-rubl       - temp-shift-stk-line.vat-rubl            temp-shift-ot-line.new-slt-base       = temp-shift-ot-line.new-slt-base       + temp-shift-stk-line.new-slt-base       - temp-shift-stk-line.slt-base            temp-shift-ot-line.new-slt-rubl       = temp-shift-ot-line.new-slt-rubl       + temp-shift-stk-line.new-slt-rubl       - temp-shift-stk-line.slt-rubl            temp-shift-ot-line.new-road-tax-base  = temp-shift-ot-line.new-road-tax-base  + temp-shift-stk-line.new-road-tax-base  - temp-shift-stk-line.road-tax-base       temp-shift-ot-line.new-road-tax-rubl  = temp-shift-ot-line.new-road-tax-rubl  + temp-shift-stk-line.new-road-tax-rubl  - temp-shift-stk-line.road-tax-rubl       temp-shift-ot-line.new-excise-base    = temp-shift-ot-line.new-excise-base    + temp-shift-stk-line.new-excise-base    - temp-shift-stk-line.excise-base         temp-shift-ot-line.new-excise-rubl    = temp-shift-ot-line.new-excise-rubl    + temp-shift-stk-line.new-excise-rubl    - temp-shift-stk-line.excise-rubl         temp-shift-ot-line.new-transport-base = temp-shift-ot-line.new-transport-base + temp-shift-stk-line.new-transport-base - temp-shift-stk-line.transport-base      temp-shift-ot-line.new-transport-rubl = temp-shift-ot-line.new-transport-rubl + temp-shift-stk-line.new-transport-rubl - temp-shift-stk-line.transport-rubl      temp-shift-ot-line.new-other-base     = temp-shift-ot-line.new-other-base     + temp-shift-stk-line.new-other-base     - temp-shift-stk-line.other-base          temp-shift-ot-line.new-other-rubl     = temp-shift-ot-line.new-other-rubl     + temp-shift-stk-line.new-other-rubl     - temp-shift-stk-line.other-rubl
     6482         .
     6483       end.
     6484     end.
     6485   end procedure.
     6486   procedure update-ot-tot :
     6487     for each temp-ot-line
     6488       where (
     6489                               temp-ot-line.fact-qnty      <> temp-ot-line.new-fact-qnty        or    temp-ot-line.sum-base       <> temp-ot-line.new-sum-base         or    temp-ot-line.sum-rubl       <> temp-ot-line.new-sum-rubl         or    temp-ot-line.vat-base       <> temp-ot-line.new-vat-base         or    temp-ot-line.vat-rubl       <> temp-ot-line.new-vat-rubl         or    temp-ot-line.slt-base       <> temp-ot-line.new-slt-base         or    temp-ot-line.slt-rubl       <> temp-ot-line.new-slt-rubl         or    temp-ot-line.road-tax-base  <> temp-ot-line.new-road-tax-base    or    temp-ot-line.road-tax-rubl  <> temp-ot-line.new-road-tax-rubl    or    temp-ot-line.excise-base    <> temp-ot-line.new-excise-base      or    temp-ot-line.excise-rubl    <> temp-ot-line.new-excise-rubl      or    temp-ot-line.transport-base <> temp-ot-line.new-transport-base   or    temp-ot-line.transport-rubl <> temp-ot-line.new-transport-rubl   or    temp-ot-line.other-base     <> temp-ot-line.new-other-base       or    temp-ot-line.other-rubl     <> temp-ot-line.new-other-rubl
     6490             )
     6491     on error undo, return error
     6492     :
     6493       case temp-ot-line.sum-type :
     6494         when 'crsa':U then do:
     6495           assign
     6496             v-sum-type[1] = temp-ot-line.sum-type
     6497             v-cat-id[1]   = '##,##':U
     6498             v-sum-type[2] = temp-ot-line.sum-type + 'v':U
     6499             v-cat-id[2]   = entry(1, temp-ot-line.cat-id) + "," + '##':U
     6500             v-sum-type[3] = temp-ot-line.sum-type + 's':U
     6501             v-cat-id[3]   = '##':U + "," + entry(2, temp-ot-line.cat-id)
     6502             v-sum-type[4] = temp-ot-line.sum-type + 'x':U
     6503             v-cat-id[4]   = temp-ot-line.cat-id
     6504           .
     6505           do ind-ext = 1 to 4
     6506           :
     6507             find first temp-ot-tot
     6508               where temp-ot-tot.doc-code = temp-ot-line.doc-code
     6509                 and temp-ot-tot.sum-type = v-sum-type[ind-ext]
     6510                 and temp-ot-tot.cat-id   = v-cat-id[ind-ext]
     6511               no-error .
     6512             if not available temp-ot-tot then do:
     6513               create temp-ot-tot .
     6514               assign
     6515                 temp-ot-tot.doc-code = temp-ot-line.doc-code
     6516                 temp-ot-tot.sum-type = v-sum-type[ind-ext]
     6517                 temp-ot-tot.cat-id   = v-cat-id[ind-ext]
     6518                 temp-ot-tot.ext-doc-type = v-ext-doc-type
     6519                 temp-ot-tot.obj-type     = ub.price-doc.obj-type
     6520                 temp-ot-tot.obj-code     = ub.price-doc.obj-code
     6521                 temp-ot-tot.fact-order   = v-ot-fact-order
     6522               .
     6523             end.
     6524             assign
     6525                                                                                                                                       temp-ot-tot.new-fact-qnty      = temp-ot-tot.new-fact-qnty      + temp-ot-line.new-fact-qnty      - temp-ot-line.fact-qnty           temp-ot-tot.new-sum-base       = temp-ot-tot.new-sum-base       + temp-ot-line.new-sum-base       - temp-ot-line.sum-base            temp-ot-tot.new-sum-rubl       = temp-ot-tot.new-sum-rubl       + temp-ot-line.new-sum-rubl       - temp-ot-line.sum-rubl            temp-ot-tot.new-vat-base       = temp-ot-tot.new-vat-base       + temp-ot-line.new-vat-base       - temp-ot-line.vat-base            temp-ot-tot.new-vat-rubl       = temp-ot-tot.new-vat-rubl       + temp-ot-line.new-vat-rubl       - temp-ot-line.vat-rubl            temp-ot-tot.new-slt-base       = temp-ot-tot.new-slt-base       + temp-ot-line.new-slt-base       - temp-ot-line.slt-base            temp-ot-tot.new-slt-rubl       = temp-ot-tot.new-slt-rubl       + temp-ot-line.new-slt-rubl       - temp-ot-line.slt-rubl            temp-ot-tot.new-road-tax-base  = temp-ot-tot.new-road-tax-base  + temp-ot-line.new-road-tax-base  - temp-ot-line.road-tax-base       temp-ot-tot.new-road-tax-rubl  = temp-ot-tot.new-road-tax-rubl  + temp-ot-line.new-road-tax-rubl  - temp-ot-line.road-tax-rubl       temp-ot-tot.new-excise-base    = temp-ot-tot.new-excise-base    + temp-ot-line.new-excise-base    - temp-ot-line.excise-base         temp-ot-tot.new-excise-rubl    = temp-ot-tot.new-excise-rubl    + temp-ot-line.new-excise-rubl    - temp-ot-line.excise-rubl         temp-ot-tot.new-transport-base = temp-ot-tot.new-transport-base + temp-ot-line.new-transport-base - temp-ot-line.transport-base      temp-ot-tot.new-transport-rubl = temp-ot-tot.new-transport-rubl + temp-ot-line.new-transport-rubl - temp-ot-line.transport-rubl      temp-ot-tot.new-other-base     = temp-ot-tot.new-other-base     + temp-ot-line.new-other-base     - temp-ot-line.other-base          temp-ot-tot.new-other-rubl     = temp-ot-tot.new-other-rubl     + temp-ot-line.new-other-rubl     - temp-ot-line.other-rubl
     6526             .
     6527           end.
     6528         end.
     6529         otherwise do:
     6530           message
     6531             vss-workfile vss-revision vss-description skip
     6532             "Неизвестный тип оборота по строке" temp-ot-line.sum-type skip
     6533             view-as alert-box error .
     6534           undo, return error .
     6535         end.
     6536       end.
     6537     end.
     6538   end procedure.
     6539   procedure update-shift-ot-tot :
     6540     for each temp-shift-ot-line
     6541       where (
     6542                               temp-shift-ot-line.fact-qnty      <> temp-shift-ot-line.new-fact-qnty        or    temp-shift-ot-line.sum-base       <> temp-shift-ot-line.new-sum-base         or    temp-shift-ot-line.sum-rubl       <> temp-shift-ot-line.new-sum-rubl         or    temp-shift-ot-line.vat-base       <> temp-shift-ot-line.new-vat-base         or    temp-shift-ot-line.vat-rubl       <> temp-shift-ot-line.new-vat-rubl         or    temp-shift-ot-line.slt-base       <> temp-shift-ot-line.new-slt-base         or    temp-shift-ot-line.slt-rubl       <> temp-shift-ot-line.new-slt-rubl         or    temp-shift-ot-line.road-tax-base  <> temp-shift-ot-line.new-road-tax-base    or    temp-shift-ot-line.road-tax-rubl  <> temp-shift-ot-line.new-road-tax-rubl    or    temp-shift-ot-line.excise-base    <> temp-shift-ot-line.new-excise-base      or    temp-shift-ot-line.excise-rubl    <> temp-shift-ot-line.new-excise-rubl      or    temp-shift-ot-line.transport-base <> temp-shift-ot-line.new-transport-base   or    temp-shift-ot-line.transport-rubl <> temp-shift-ot-line.new-transport-rubl   or    temp-shift-ot-line.other-base     <> temp-shift-ot-line.new-other-base       or    temp-shift-ot-line.other-rubl     <> temp-shift-ot-line.new-other-rubl
     6543             )
     6544     on error undo, return error
     6545     :
     6546       case temp-shift-ot-line.sum-type :
     6547         when 'crsa':U then do:
     6548           assign
     6549             v-sum-type[1] = temp-shift-ot-line.sum-type
     6550             v-cat-id[1]   = '##,##':U
     6551             v-sum-type[2] = temp-shift-ot-line.sum-type + 'v':U
     6552             v-cat-id[2]   = entry(1, temp-shift-ot-line.cat-id) + "," + '##':U
     6553             v-sum-type[3] = temp-shift-ot-line.sum-type + 's':U
     6554             v-cat-id[3]   = '##':U + "," + entry(2, temp-shift-ot-line.cat-id)
     6555             v-sum-type[4] = temp-shift-ot-line.sum-type + 'x':U
     6556             v-cat-id[4]   = temp-shift-ot-line.cat-id
     6557           .
     6558           do ind-ext = 1 to 4
     6559           :
     6560             find first temp-shift-ot-tot
     6561               where temp-shift-ot-tot.doc-code = temp-shift-ot-line.doc-code
     6562                 and temp-shift-ot-tot.sum-type = v-sum-type[ind-ext]
     6563                 and temp-shift-ot-tot.cat-id   = v-cat-id[ind-ext]
     6564               no-error .
     6565             if not available temp-shift-ot-tot then do:
     6566               create temp-shift-ot-tot .
     6567               assign
     6568                 temp-shift-ot-tot.doc-code = temp-shift-ot-line.doc-code
     6569                 temp-shift-ot-tot.sum-type = v-sum-type[ind-ext]
     6570                 temp-shift-ot-tot.cat-id   = v-cat-id[ind-ext]
     6571                 temp-shift-ot-tot.ext-doc-type = v-ext-doc-type
     6572                 temp-shift-ot-tot.obj-type     = ub.price-doc.obj-type
     6573                 temp-shift-ot-tot.obj-code     = ub.price-doc.obj-code
     6574                 temp-shift-ot-tot.fact-order   = v-ot-fact-order
     6575               .
     6576             end.
     6577             assign
     6578                                                                                                                                       temp-shift-ot-tot.new-fact-qnty      = temp-shift-ot-tot.new-fact-qnty      + temp-shift-ot-line.new-fact-qnty      - temp-shift-ot-line.fact-qnty           temp-shift-ot-tot.new-sum-base       = temp-shift-ot-tot.new-sum-base       + temp-shift-ot-line.new-sum-base       - temp-shift-ot-line.sum-base            temp-shift-ot-tot.new-sum-rubl       = temp-shift-ot-tot.new-sum-rubl       + temp-shift-ot-line.new-sum-rubl       - temp-shift-ot-line.sum-rubl            temp-shift-ot-tot.new-vat-base       = temp-shift-ot-tot.new-vat-base       + temp-shift-ot-line.new-vat-base       - temp-shift-ot-line.vat-base            temp-shift-ot-tot.new-vat-rubl       = temp-shift-ot-tot.new-vat-rubl       + temp-shift-ot-line.new-vat-rubl       - temp-shift-ot-line.vat-rubl            temp-shift-ot-tot.new-slt-base       = temp-shift-ot-tot.new-slt-base       + temp-shift-ot-line.new-slt-base       - temp-shift-ot-line.slt-base            temp-shift-ot-tot.new-slt-rubl       = temp-shift-ot-tot.new-slt-rubl       + temp-shift-ot-line.new-slt-rubl       - temp-shift-ot-line.slt-rubl            temp-shift-ot-tot.new-road-tax-base  = temp-shift-ot-tot.new-road-tax-base  + temp-shift-ot-line.new-road-tax-base  - temp-shift-ot-line.road-tax-base       temp-shift-ot-tot.new-road-tax-rubl  = temp-shift-ot-tot.new-road-tax-rubl  + temp-shift-ot-line.new-road-tax-rubl  - temp-shift-ot-line.road-tax-rubl       temp-shift-ot-tot.new-excise-base    = temp-shift-ot-tot.new-excise-base    + temp-shift-ot-line.new-excise-base    - temp-shift-ot-line.excise-base         temp-shift-ot-tot.new-excise-rubl    = temp-shift-ot-tot.new-excise-rubl    + temp-shift-ot-line.new-excise-rubl    - temp-shift-ot-line.excise-rubl         temp-shift-ot-tot.new-transport-base = temp-shift-ot-tot.new-transport-base + temp-shift-ot-line.new-transport-base - temp-shift-ot-line.transport-base      temp-shift-ot-tot.new-transport-rubl = temp-shift-ot-tot.new-transport-rubl + temp-shift-ot-line.new-transport-rubl - temp-shift-ot-line.transport-rubl      temp-shift-ot-tot.new-other-base     = temp-shift-ot-tot.new-other-base     + temp-shift-ot-line.new-other-base     - temp-shift-ot-line.other-base          temp-shift-ot-tot.new-other-rubl     = temp-shift-ot-tot.new-other-rubl     + temp-shift-ot-line.new-other-rubl     - temp-shift-ot-line.other-rubl
     6579             .
     6580           end.
     6581         end.
     6582         otherwise do:
     6583           message
     6584             vss-workfile vss-revision vss-description skip
     6585             "Неизвестный тип оборота по строке" temp-shift-ot-line.sum-type skip
     6586             view-as alert-box error .
     6587           undo, return error .
     6588         end.
     6589       end.
     6590     end.
     6591   end procedure.
     6592   procedure update-stk-table :
     6593     define buffer root-temp-stk-tot        for temp-stk-tot  .
     6594     define buffer root-temp-stk-line       for temp-stk-line .
     6595     define buffer root-temp-shift-stk-tot  for temp-shift-stk-tot  .
     6596     define buffer root-temp-shift-stk-line for temp-shift-stk-line .
     6597     for each temp-ot-tot
     6598       where temp-ot-tot.sum-type begins 'crsa':U
     6599         and (
     6600                               temp-ot-tot.fact-qnty      <> temp-ot-tot.new-fact-qnty        or    temp-ot-tot.sum-base       <> temp-ot-tot.new-sum-base         or    temp-ot-tot.sum-rubl       <> temp-ot-tot.new-sum-rubl         or    temp-ot-tot.vat-base       <> temp-ot-tot.new-vat-base         or    temp-ot-tot.vat-rubl       <> temp-ot-tot.new-vat-rubl         or    temp-ot-tot.slt-base       <> temp-ot-tot.new-slt-base         or    temp-ot-tot.slt-rubl       <> temp-ot-tot.new-slt-rubl         or    temp-ot-tot.road-tax-base  <> temp-ot-tot.new-road-tax-base    or    temp-ot-tot.road-tax-rubl  <> temp-ot-tot.new-road-tax-rubl    or    temp-ot-tot.excise-base    <> temp-ot-tot.new-excise-base      or    temp-ot-tot.excise-rubl    <> temp-ot-tot.new-excise-rubl      or    temp-ot-tot.transport-base <> temp-ot-tot.new-transport-base   or    temp-ot-tot.transport-rubl <> temp-ot-tot.new-transport-rubl   or    temp-ot-tot.other-base     <> temp-ot-tot.new-other-base       or    temp-ot-tot.other-rubl     <> temp-ot-tot.new-other-rubl
     6601             )
