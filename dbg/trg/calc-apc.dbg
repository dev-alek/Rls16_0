     1640             .
     1641           end.
     1642         end.
     1643     end.
     1644   end procedure.
     1645   procedure prdoclib-calc-prc :
     1646     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1647     define input  parameter p-cons-pay        as   integer                no-undo.
     1648     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1649     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1650     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1651     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1652     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1653     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1654     do
     1655     on error undo, return error return-value
     1656     :
     1657       define buffer buf_price-doc       for ub.price-doc .
     1658       define buffer buf_price-list      for ub.price-list .
     1659       define buffer buf_parts           for ub.parts .
     1660       define variable v-ov-qnty     as decimal   no-undo .
     1661       define variable v-ov-base     as decimal   no-undo .
     1662       define variable v-ov-VAT-base as decimal   no-undo .
     1663       define variable v-ov-SLT-base as decimal   no-undo .
     1664       define variable v-cons-qnty   as decimal   no-undo .
     1665       define variable v-prch-qnty   as decimal   no-undo .
     1666       define variable v-cons-mult   as decimal   no-undo .
     1667       define variable v-prch-mult   as decimal   no-undo .
     1668       find first buf_price-doc no-lock
     1669         where recid(buf_price-doc) = p-price-doc-recid
     1670         no-error .
     1671       if not available buf_price-doc
     1672       then do:
     1673         message
     1674           vss-workfile vss-revision vss-description skip
     1675           vss-include-info5 skip
     1676           "Ошибка задания входных параметров" skip
     1677           "Не найден документ переоценки" skip
     1678           "Код записи (recid)" p-price-doc-recid skip
     1679           view-as alert-box error .
     1680         undo, return error .
     1681       end.
     1682       for each buf_price-list no-lock
     1683         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1684           and buf_price-list.main-price = true
     1685       on error undo, return error return-value
     1686       :
     1687         run prdoclib-calc-ov
     1688           (input recid(buf_price-list)
     1689           ,output v-ov-qnty
     1690           ,output v-ov-base
     1691           ,output v-ov-VAT-base
     1692           ,output v-ov-SLT-base
     1693           ) no-error .
     1694         if error-status :error
     1695         then do:
     1696           if error-status :get-message(1) <> ""
     1697           then do:
     1698             message
     1699               vss-workfile vss-revision vss-description skip
     1700               vss-include-info5 skip
     1701               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1702               error-status :get-message(1) skip
     1703               return-value skip
     1704               view-as alert-box error .
     1705           end.
     1706           undo, return error return-value .
     1707         end.
     1708         assign
     1709           v-cons-qnty = 0
     1710           v-prch-qnty = 0
     1711         .
     1712         for each buf_parts no-lock
     1713           where buf_parts.out-code  = buf_price-list.doc-num
     1714             and buf_parts.obj-type  = buf_price-list.obj-type
     1715             and buf_parts.obj-code  = buf_price-list.obj-code
     1716             and buf_parts.artic     = buf_price-list.artic
     1717             and buf_parts.prod-type = buf_price-list.prod-type
     1718             and buf_parts.prod-code = buf_price-list.prod-code
     1719         on error undo, return error return-value
     1720         :
     1721           if buf_parts.pay-code = p-cons-pay
     1722           then do:
     1723             assign
     1724               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1725             .
     1726           end.
     1727           else do:
     1728             assign
     1729               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1730             .
     1731           end.
     1732         end.
     1733         if (v-cons-qnty + v-prch-qnty) = 0
     1734         then do:
     1735           assign
     1736             v-cons-mult = 0
     1737             v-prch-mult = 1
     1738           .
     1739         end.
     1740         else do:
     1741           assign
     1742             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1743             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1744           .
     1745         end.
     1746         assign
     1747           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1748           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1749           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1750           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1751           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1752           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1753         .
     1754       end.
     1755     end.
     1756   end procedure.
     1757   procedure prdoclib-calc-ov :
     1758     define input  parameter p-price-list-recid as recid     no-undo .
     1759     define output parameter p-fact-qnty        as decimal   no-undo .
     1760     define output parameter p-ov-base          as decimal   no-undo .
     1761     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1762     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1763     do
     1764     on error undo, return error return-value
     1765     :
     1766       define buffer buf_main_price-list    for ub.price-list .
     1767       define buffer buf_prev_price-list    for ub.price-list .
     1768       define buffer buf_special_price-list for ub.price-list .
     1769       define buffer buf_goods              for ub.goods .
     1770       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1771       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1772       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1773       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1774       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1775       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1776       define variable v-prev-price-list-recid as   recid                  no-undo.
     1777       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1778       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1779       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1780       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1781       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1782       find first buf_main_price-list no-lock
     1783         where recid(buf_main_price-list) = p-price-list-recid
     1784         no-error .
     1785       if not available buf_main_price-list
     1786       then do:
     1787         message
     1788           vss-workfile vss-revision vss-description skip
     1789           vss-include-info5 skip
     1790           "Ошибка задания входных параметров" skip
     1791           "Не найдена строка переоценки" skip
     1792           "Код записи (recid)" p-price-list-recid skip
     1793           view-as alert-box error .
     1794         undo, return error .
     1795       end.
     1796       if buf_main_price-list.main-price <> true
     1797       then do:
     1798         message
     1799           vss-workfile vss-revision vss-description skip
     1800           vss-include-info5 skip
     1801           "Ошибка задания входных параметров" skip
     1802           "Строка переоценки не является основной" skip
     1803           "Код записи (recid)" p-price-list-recid skip
     1804           "Переоценка" buf_main_price-list.doc-num skip
     1805           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1806           "Бар-код" buf_main_price-list.b-code skip
     1807           view-as alert-box error .
     1808         undo, return error .
     1809       end.
     1810       run prdoclib-calc-fact-sale in this-procedure
     1811         (input  recid(buf_main_price-list)
     1812         ,output v-fact-qnty
     1813         ,output v-cur-base
     1814         ,output v-cur-VAT-base
     1815         ,output v-cur-SLT-base
     1816         ,output v-cur-road-tax-base
     1817         ,output v-cur-excise-base
     1818         ) no-error.
     1819       if error-status :error
     1820       then do:
     1821         message
     1822           vss-workfile vss-revision vss-description skip
     1823           vss-include-info5 skip
     1824           "Ошибка при расчете сумм переоценки." skip
     1825           "Документ переоценки" buf_main_price-list.doc-num skip
     1826           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1827           error-status :get-message(1) skip
     1828           return-value skip
     1829           view-as alert-box error .
     1830         undo, return error .
     1831       end.
     1832   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1833   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1834     (input  buf_main_price-list.obj-type
     1835     ,input  buf_main_price-list.obj-code
     1836     ,input  buf_main_price-list.b-code
     1837     ,input  buf_main_price-list.b-code
     1838     ,input  buf_main_price-list.fact-order
     1839     ,output v-prev-price-list-recid
     1840     ,output v-prev-cli-base-rate
     1841     ) no-error .
     1842       if error-status :error
     1843       then do:
     1844         message
     1845           vss-workfile vss-revision vss-description skip
     1846           vss-include-info5 skip
     1847           "Ошибка при поиске предыдущей переоценки." skip
     1848           "Документ переоценки " buf_main_price-list.doc-num skip
     1849           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1850           error-status :get-message(1) skip
     1851           return-value skip
     1852           view-as alert-box error .
     1853         undo, return error .
     1854       end.
     1855       if v-prev-price-list-recid <> ?
     1856       then do:
     1857         find first buf_prev_price-list no-lock
     1858           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1859           .
     1860         find first buf_special_price-list no-lock
     1861           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1862             and buf_special_price-list.main-price = false
     1863             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1864             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1865             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1866             and buf_special_price-list.doc-qnty   <> ?
     1867           no-error .
     1868         if available buf_special_price-list
     1869         then do:
     1870           message
     1871             "Товар имеет специальные цены на признаки" skip
     1872             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1873             "Переоценка" buf_prev_price-list.doc-num skip
     1874             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1875             view-as alert-box error .
     1876           undo, return error .
     1877         end.
     1878         find first buf_goods no-lock
     1879           where buf_goods.artic     = buf_main_price-list.artic
     1880             and buf_goods.prod-type = buf_main_price-list.prod-type
     1881             and buf_goods.prod-code = buf_main_price-list.prod-code
     1882           no-error .
     1883         if not available buf_goods
     1884         then do:
     1885           message
     1886             vss-workfile vss-revision vss-description skip
     1887             vss-include-info5 skip
     1888             "Не найден товар" skip
     1889             "Переоценка" buf_main_price-list.doc-num skip
     1890             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1891             view-as alert-box error .
     1892           undo, return error .
     1893         end.
     1894         if buf_prev_price-list.vat-pc = ?
     1895         or buf_prev_price-list.slt-pc = ?
     1896         then do:
     1897           message
     1898             "В переоценке не заданы налоги товара" skip
     1899             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1900             "Переоценка" buf_prev_price-list.doc-num skip
     1901             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1902             "НДС" buf_prev_price-list.vat-pc skip
     1903             "НП" buf_prev_price-list.slt-pc skip
     1904             view-as alert-box error .
     1905           undo, return error return-value .
     1906         end.
     1907         define variable v-prev-cur-SLT-pc as decimal no-undo .
     1908         assign
     1909           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     1910         .
     1911         assign
     1912           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     1913           v-prev-cur-VAT-base = v-fact-qnty
     1914                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     1915                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     1916           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     1917         .
     1918         assign
     1919           p-fact-qnty   = v-fact-qnty
     1920           p-ov-base     = v-cur-base     - v-prev-cur-base
     1921           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1922           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1923         .
     1924       end.
     1925       else do:
     1926         assign
     1927           v-prev-cur-base     = 0
     1928           v-prev-cur-VAT-base = 0
     1929           v-prev-cur-SLT-base = 0
     1930           .
     1931         assign
     1932           p-fact-qnty   = v-fact-qnty
     1933           p-ov-base     = v-cur-base     - v-prev-cur-base
     1934           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1935           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1936         .
     1937       end.
     1938     end.
     1939   end procedure.
     1940   procedure prdoclib-init-prt-obj-by-factord :
     1941     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1942     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1943     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1944     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1945     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1946     define input parameter p-fact-order         as decimal   no-undo .
     1947     define input parameter p-include-fact-order as logical   no-undo .
     1948     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     1949     define buffer buf_gds-obj      for ub.gds-obj .
     1950     define buffer buf_doc-line     for ub.doc-line .
     1951     define buffer buf_temp-prt-obj for temp-prt-obj .
     1952     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     1953     do
     1954     on error undo, return error return-value
     1955     :
     1956       do transaction
     1957       on error undo, return error return-value
     1958       :
     1959   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1960   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1961     (input  p-obj-type
     1962     ,input  p-obj-code
     1963     ,input  p-artic
     1964     ,input  p-prod-type
     1965     ,input  p-prod-code
     1966     ,buffer buf_gds-obj
     1967     ) no-error .
     1968         if error-status :error
     1969         then do:
     1970           message
     1971             vss-workfile vss-revision vss-description skip
     1972             vss-include-info5 skip
     1973             "Невозможно найти gds-obj" skip
     1974             error-status :get-message(1) skip
     1975             return-value skip
     1976             view-as alert-box error .
     1977           undo, return error .
     1978         end.
     1979         find current buf_gds-obj exclusive-lock .
     1980       end.
     1981       run prdoclib-init-temp-prt-obj in this-procedure
     1982         (input p-obj-type
     1983         ,input p-obj-code
     1984         ,input p-artic
     1985         ,input p-prod-type
     1986         ,input p-prod-code
     1987         ,input 0
     1988         ) .
     1989       for each buf_temp-prt-obj
     1990         where buf_temp-prt-obj.is-term <> true
     1991       on error undo, return error return-value
     1992       :
     1993         delete buf_temp-prt-obj .
     1994       end.
     1995       if p-include-fact-order = true
     1996       then do:
     1997         assign
     1998          p-fact-order = p-fact-order - 0.0000000001
     1999         .
     2000       end.
     2001       for each buf_doc-line no-lock
     2002         where buf_doc-line.obj-type   = p-obj-type
     2003           and buf_doc-line.obj-code   = p-obj-code
     2004           and buf_doc-line.artic      = p-artic
     2005           and buf_doc-line.prod-type  = p-prod-type
     2006           and buf_doc-line.prod-code  = p-prod-code
     2007           and buf_doc-line.status_    = 'факт':U
     2008           and buf_doc-line.fact-order >= p-fact-order
     2009       on error undo, return error return-value
     2010       :
     2011         run prdoclib-process-document in this-procedure
     2012           (input  buf_doc-line.doc-code
     2013           ,input  p-obj-type
     2014           ,input  p-obj-code
     2015           ,input  p-artic
     2016           ,input  p-prod-type
     2017           ,input  p-prod-code
     2018           ,output v-total-gds-dtl-qnty
     2019           ) .
     2020       end.
     2021     end.
     2022   end procedure.
     2023   procedure prdoclib-process-document :
     2024     define input  parameter p-doc-code           as character no-undo .
     2025     define input  parameter p-obj-type           as character no-undo .
     2026     define input  parameter p-obj-code           as integer   no-undo .
     2027     define input  parameter p-artic              as character no-undo .
     2028     define input  parameter p-prod-type          as character no-undo .
     2029     define input  parameter p-prod-code          as integer   no-undo .
     2030     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2031     define buffer buf_trn-doc      for ub.trn-doc .
     2032     define buffer buf_gds-dtl      for ub.gds-dtl .
     2033     define buffer buf_temp-prt-obj for temp-prt-obj .
     2034     do
     2035     on error undo, return error return-value
     2036     :
     2037       find first buf_trn-doc no-lock
     2038         where buf_trn-doc.doc-code = p-doc-code
     2039         no-error .
     2040       if not available buf_trn-doc then do:
     2041         message
     2042           vss-workfile vss-revision vss-description skip
     2043           vss-include-info5 skip
     2044           "Ошибка при поиске документа" skip
     2045           "Документ" p-doc-code skip
     2046           "Объект" p-obj-type p-obj-code skip
     2047           "Артикул" p-artic p-prod-type p-prod-code skip
     2048           view-as alert-box error .
     2049         undo, return error .
     2050       end.
     2051       assign
     2052         p-total-gds-dtl-qnty = 0
     2053       .
     2054       for each buf_gds-dtl no-lock
     2055         where buf_gds-dtl.doc-code  = p-doc-code
     2056           and buf_gds-dtl.artic     = p-artic
     2057           and buf_gds-dtl.prod-type = p-prod-type
     2058           and buf_gds-dtl.prod-code = p-prod-code
     2059       on error undo, return error
     2060       :
     2061         define variable v-term-node as integer   no-undo .
     2062   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2063     (input  buf_gds-dtl.prt-code
     2064     ,output v-term-node
     2065     )  .
     2066         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2067           (input  v-term-node
     2068           ,buffer buf_temp-prt-obj
     2069           ) .
     2070         if buf_temp-prt-obj.is-term <> true then do:
     2071           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2072                                        ,buf_gds-dtl.prt-code
     2073                                        ) .
     2074         end.
     2075         case buf_trn-doc.doc-type :
     2076           when 'при':U or
     2077           when 'возврат':U
     2078           then do:
     2079             assign
     2080               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2081                                           - buf_gds-dtl.fact-qnty
     2082               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2083                                           - buf_gds-dtl.fact-qnty
     2084             .
     2085           end.
     2086           when 'рас':U or
     2087           when 'спи':U
     2088           then do:
     2089             assign
     2090               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2091                                           + buf_gds-dtl.fact-qnty
     2092               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2093                                           + buf_gds-dtl.fact-qnty
     2094             .
     2095           end.
     2096           when 'инв':U
     2097           then do:
     2098             assign
     2099               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2100                                           - buf_gds-dtl.doc-qnty
     2101               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2102                                           - buf_gds-dtl.doc-qnty
     2103             .
     2104           end.
     2105           otherwise do:
     2106             undo, return error substitute("Неизвестный тип документа &1"
     2107                                          ,buf_trn-doc.doc-type
     2108                                          ) .
     2109           end.
     2110         end.
     2111       end.
     2112     end.
     2113   end procedure.
     2114   procedure prdoclib-prc-pl-document :
     2115     define input  parameter p-doc-code              as character no-undo .
     2116     define input  parameter p-obj-type              as character no-undo .
     2117     define input  parameter p-obj-code              as integer   no-undo .
     2118     define input  parameter p-gds-code              as integer   no-undo .
     2119     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2120     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2121     do
     2122     on error undo, return error return-value
     2123     :
     2124       define buffer buf_trn-doc      for ub.trn-doc .
     2125       define buffer buf_doc-pl       for ub.doc-pl .
     2126       define buffer buf_temp-pl-gds for temp-pl-gds .
     2127       define variable v-sign as decimal   no-undo .
     2128       find first buf_trn-doc no-lock
     2129         where buf_trn-doc.doc-code = p-doc-code
     2130         no-error .
     2131       if not available buf_trn-doc then do:
     2132         message
     2133           vss-workfile vss-revision vss-description skip
     2134           vss-include-info5 skip
     2135           "Ошибка при поиске документа" skip
     2136           "Документ" p-doc-code skip
     2137           "Объект" p-obj-type p-obj-code skip
     2138           "Товар" p-gds-code skip
     2139           view-as alert-box error .
     2140         undo, return error .
     2141       end.
     2142       assign
     2143         p-total-pl-gds-qnty     = 0
     2144         p-total-pl-gds-cli-qnty = 0
     2145       .
     2146       for each buf_doc-pl no-lock
     2147         where buf_doc-pl.out-code  = p-doc-code
     2148           and buf_doc-pl.gds-code  = p-gds-code
     2149       on error undo, return error return-value
     2150       :
     2151         find first buf_temp-pl-gds
     2152           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2153             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2154             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2155           .
     2156         case buf_trn-doc.doc-type :
     2157           when 'при':U
     2158           or when 'возврат':U
     2159           or when 'инв':U
     2160           then do:
     2161             assign
     2162               v-sign = -1.0
     2163             .
     2164           end.
     2165           when 'рас':U or
     2166           when 'спи':U
     2167           then do:
     2168             assign
     2169               v-sign = 1.0
     2170             .
     2171           end.
     2172           otherwise do:
     2173             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2174           end.
     2175         end case.
     2176         assign
     2177           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2178           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2179           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2180           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2181         .
     2182       end.
     2183     end.
     2184   end procedure.
     2185   procedure prdoclib-init-prt-obj-by-date :
     2186     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2187     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2188     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2189     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2190     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2191     define input parameter p-fact-date  as date      no-undo .
     2192     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2193     do
     2194     on error undo, return error return-value
     2195     :
     2196       define variable v-fact-order                as decimal   no-undo .
     2197       define variable v-shift-end-fact-order      as decimal   no-undo .
     2198       define variable v-day-end-fact-order        as decimal   no-undo .
     2199       run factord in this-procedure
     2200         (input  p-fact-date
     2201         ,input  1
     2202         ,input  1
     2203         ,input  ?
     2204         ,input  0
     2205         ,input  false
     2206         ,output v-fact-order
     2207         ,output v-shift-end-fact-order
     2208         ,output v-day-end-fact-order
     2209         ) no-error .
     2210       if error-status :error
     2211       then do:
     2212         message
     2213           vss-workfile vss-revision vss-description skip
     2214           vss-include-info5 skip
     2215           "Ошибка при определении момента времени, на который требуется остаток" skip
     2216           "Объект" p-obj-type p-obj-code skip
     2217           "Артикул" p-artic p-prod-type p-prod-code skip
     2218           "Дата" p-fact-date skip
     2219           view-as alert-box error .
     2220         undo, return error .
     2221       end.
     2222       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2223         (input p-obj-type
     2224         ,input p-obj-code
     2225         ,input p-artic
     2226         ,input p-prod-type
     2227         ,input p-prod-code
     2228         ,input v-day-end-fact-order
     2229         ,input false
     2230         ) no-error .
     2231       if error-status :error
     2232       then do:
     2233         message
     2234           vss-workfile vss-revision vss-description skip
     2235           vss-include-info5 skip
     2236           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2237           "Объект" p-obj-type p-obj-code skip
     2238           "Артикул" p-artic p-prod-type p-prod-code skip
     2239           "Дата" p-fact-date skip
     2240           view-as alert-box error .
     2241         undo, return error .
     2242       end.
     2243     end.
     2244   end procedure.
     2245   procedure prdoclib-calc-temp-fact-sale :
     2246     define input  parameter p-obj-type           as character no-undo .
     2247     define input  parameter p-obj-code           as integer   no-undo .
     2248     define input  parameter p-gds-code           as integer   no-undo .
     2249     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2250     define input  parameter p-curr-r-b           as character no-undo .
     2251     define output parameter p-fact-qnty          as decimal   no-undo .
     2252     define output parameter p-cur-base           as decimal   no-undo .
     2253     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2254     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2255     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2256     define output parameter p-cur-excise-base    as decimal   no-undo .
     2257     define buffer buf_temp-prt-obj for temp-prt-obj .
     2258     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2259     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2260     define variable parrecid-prl        as recid     no-undo .
     2261     define variable v-fact-qnty         as decimal   no-undo .
     2262     define variable v-cur-base          as decimal   no-undo .
     2263     define variable v-cur-VAT-base      as decimal   no-undo .
     2264     define variable v-cur-SLT-base      as decimal   no-undo .
     2265     define variable v-cur-road-tax-base as decimal   no-undo .
     2266     define variable v-cur-excise-base   as decimal   no-undo .
     2267     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2268     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2269     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2270     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2271     define variable vat-base-sale-prl               as decimal   no-undo .
     2272     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2273     define variable vat-base-buyer-prl              as decimal   no-undo .
     2274     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2275     define variable slt-base-sale-prl               as decimal   no-undo .
     2276     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2277     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2278     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2279     define variable excise-base-sale-prl            as decimal   no-undo .
     2280     define variable excise-rubl-sale-prl            as decimal   no-undo .
