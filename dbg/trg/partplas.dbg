      151       define variable cli-base-rateoprl              as   decimal                no-undo.
      152       define variable price-rubl-with-tax-locoprl    like ub.doc-line.price-rubl no-undo.
      153       define variable price-base-with-tax-locoprl    like ub.doc-line.price-base no-undo.
      154       define variable price-cli-with-tax-locoprl     like ub.doc-line.price-cli  no-undo.
      155       define variable price-rubl-without-tax-locoprl like ub.doc-line.price-rubl no-undo.
      156       define variable price-base-without-tax-locoprl like ub.doc-line.price-base no-undo.
      157       define variable price-cli-without-tax-locoprl  like ub.doc-line.price-base no-undo.
      158       define variable vat-base-locoprl               like ub.doc-line.price-base no-undo.
      159       define variable vat-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
      160       define variable vat-cli-locoprl                like ub.doc-line.price-rubl no-undo.
      161       define variable slt-base-locoprl               like ub.doc-line.price-base no-undo.
      162       define variable slt-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
      163       define variable slt-cli-locoprl                like ub.doc-line.price-rubl no-undo.
      164       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
      165       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
      166       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
      167       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
      168       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
      169       define variable transport-cli-locoprl          like ub.doc-line.price-rubl no-undo.
      170       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
      171       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
      172       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
      173       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
      174       define variable varinvatp-envdoprl             as   character              no-undo.
      175       define variable varinvatp-typeoprl             as   character              no-undo.
      176     define buffer bf_price-list for ub.price-list.
      177     define buffer bf_goods      for ub.goods.
      178     define buffer bf_sysconf    for ub.sysconf.
      179     define buffer bf_parts      for ub.parts.
      180     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
      181     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
      182     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
      183     define variable varexcise      like ub.price-list.excise     no-undo.
      184     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
      185     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
      186     define variable varprice-base  like ub.price-list.price-sale no-undo.
      187     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
      188     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
      189     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
      190     define variable v-host-code    like ub.sysconf.host-code     no-undo.
      191     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
      192     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
      193     define variable varobj-type    like ub.price-list.obj-type   no-undo.
      194     define variable varobj-code    like ub.price-list.obj-code   no-undo.
      195     define variable varartic       like ub.price-list.artic      no-undo.
      196     define variable varprod-type   like ub.price-list.prod-type  no-undo.
      197     define variable varprod-code   like ub.price-list.prod-code  no-undo.
      198     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
      199     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
      200     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
      201     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
      202     define variable vardoc-type     as   character              no-undo.
      203     do
      204     on error undo, return error "Ошибка при вызове процедуры prl-vat."
      205     :
      206       find first bf_price-list no-lock
      207         where recid(bf_price-list) = parrecid
      208         no-error .
      209       if not available bf_price-list
      210       then do:
      211         return error "Ошибка во входящих параметрах prl-vat.i" .
      212       end.
      213       find first bf_goods no-lock
      214         where bf_goods.artic     = bf_price-list.artic
      215           and bf_goods.prod-type = bf_price-list.prod-type
      216           and bf_goods.prod-code = bf_price-list.prod-code
      217         no-error .
      218       if not available bf_goods
      219       then do:
      220         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
      221       end.
      222       assign
      223         varvat-pc = bf_price-list.vat-pc
      224         varslt-pc = bf_price-list.slt-pc
      225       .
      226       if varvat-pc = ?
      227       then do:
      228         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
      229       end.
      230       if varslt-pc = ?
      231       then do:
      232         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
      233       end.
      234       assign
      235         varbase-rate   = 1
      236         varbase-scale  = 1
      237         varroad-tax    = bf_price-list.road-tax
      238         varexcise      = bf_price-list.excise
      239         varprice-base  = bf_price-list.price-sale
      240         varprice-rubl  = bf_price-list.price-sale
      241         vardiscnt-base = 0
      242         vardiscnt-rubl = 0
      243       .
      244       assign
      245         varfact-qnty = 0
      246       .
      247       for each bf_parts no-lock
      248         where bf_parts.out-code   = bf_price-list.doc-num
      249           and bf_parts.obj-type   = bf_price-list.obj-type
      250           and bf_parts.obj-code   = bf_price-list.obj-code
      251           and bf_parts.artic      = bf_price-list.artic
      252           and bf_parts.prod-type  = bf_price-list.prod-type
      253           and bf_parts.prod-code  = bf_price-list.prod-code
      254       :
      255         assign
      256           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
      257         .
      258       end.
      259       assign
      260         vardoc-num   = bf_price-list.doc-num
      261         vardoc-code  = bf_price-list.doc-num
      262         varobj-type  = bf_price-list.obj-type
      263         varobj-code  = bf_price-list.obj-code
      264         varartic     = bf_price-list.artic
      265         varprod-type = bf_price-list.prod-type
      266         varprod-code = bf_price-list.prod-code
      267         vardoc-qnty  = varfact-qnty
      268         varext-doc-type = 'ot':U
      269       .
      270   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      272     (input  bf_price-list.obj-type
      273     ,input  bf_price-list.obj-code
      274     ,output v-host-code
      275     )  .
      276       find first bf_sysconf no-lock
      277         where bf_sysconf.host-code = v-host-code
      278         .
      279       if bf_sysconf.cons-vat-pc = ?
      280       then do:
      281         return error "Не задан консигнационный НДС по фирме." .
      282       end.
      283       else do:
      284         assign
      285           varcons-vat-pc = bf_sysconf.cons-vat-pc
      286         .
      287       end.
      288   if varext-doc-type = 'ot':U or
      289      varext-doc-type = ?                 then do:
      290     assign
      291      out-vatp-have-vat-sltprl = yes.
      292   end.
      293   else do:
      294     find first out-vatp_doc-attrprl no-lock
      295       where out-vatp_doc-attrprl.doc-code  = vardoc-code
      296         and out-vatp_doc-attrprl.attr-code = 'envd':U
      297         no-error .
      298     if not available out-vatp_doc-attrprl then do:
      299       assign
      300         out-vatp-have-vat-sltprl = yes.
      301     end.
      302     else do:
      303        out-vatp-have-vat-sltprl = no.
      304     end.
      305   end.
      306   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
      307                                      out-vatp_goodsprl.prod-type = varprod-type and
      308                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
      309   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      311     (input  varartic
      312     ,input  varprod-type
      313     ,input  varprod-code
      314     ,output varroot-nodeprl
      315     ) no-error .
      316   if error-status :error then do:
      317     message
      318       vss-workfile vss-revision vss-description skip
      319       "Ошибка при определении корневого признака товара" skip
      320       "Артикул" varartic varprod-type varprod-code skip
      321       error-status :get-message(1) skip
      322       return-value skip
      323       view-as alert-box error .
      324     undo, return error .
      325   end.
      326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      327     (input  varroot-nodeprl
      328     ,input  'empty-scale=request'
      329     ,output varempty-scaleprl
      330     ) no-error .
      331   if error-status :error then do:
      332     message
      333       vss-workfile vss-revision vss-description skip
      334       "Ошибка при определении атрибута признака" skip
      335       "Артикул" varartic varprod-type varprod-code skip
      336       "Признак" varroot-nodeprl skip
      337       "Запрашивался атрибут" "empty-scale=request" skip
      338       error-status :get-message(1) skip
      339       return-value skip
      340       view-as alert-box error .
      341     undo, return error .
      342   end.
      343   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      344   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      345     (output varoutvprbprl
      346     )  .
      347   if varoutvprbprl = "base":u then do:
      348     assign
      349           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
      350       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
      351     .
      352   end.
      353   else do:
      354     assign
      355           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
      356       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
      357     .
      358   end.
      359   if varoutvprbprl = "rubl":u then do:
      360     assign
      361           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
      362       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
      363   end.
      364   else do:
      365     assign
      366           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
      367       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
      368   end.
      369   assign
      370     varis-cons-parts-haveprl =  no.
      371   assign
      372     varfact-qntyprl       = 0
      373     varcons-qntyprl       = 0
      374     varprice-base-consprl = 0
      375     varprice-rubl-consprl = 0.
      376   find first out-vatp_doc-lineprl where
      377              out-vatp_doc-lineprl.doc-code   = vardoc-num
      378          and out-vatp_doc-lineprl.artic      = varartic
      379          and out-vatp_doc-lineprl.prod-type  = varprod-type
      380          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
      381   if available out-vatp_doc-lineprl           and
      382     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
      383     assign
      384       varfact-qntyprl = out-vatp_doc-lineprl.fact-qnty.
      385   end.
      386   else do:
      387     for each out-vatp_partsprl where out-vatp_partsprl.out-code   = vardoc-num
      388                                  and out-vatp_partsprl.obj-type   = varobj-type
      389                                  and out-vatp_partsprl.obj-code   = varobj-code
      390                                  and out-vatp_partsprl.artic      = varartic
      391                                  and out-vatp_partsprl.prod-type  = varprod-type
      392                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
      393       if out-vatp_partsprl.purch-code = 2 then do:
      394   assign
      395     price-rubl-with-tax-locoprl = out-vatp_partsprl.price-rubl
      396     price-base-with-tax-locoprl = out-vatp_partsprl.price-base
      397   .
      398   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      400     (output varinvprboprl
      401     )  .
      402     if out-vatp_partsprl.out-code = 'free-zone':U     or
      403        out-vatp_partsprl.out-code = 'out-zone':U   or
      404        out-vatp_partsprl.doc-type = 'акт':U then do:
      405       assign
      406         in-vatp-have-vat-sltoprl = yes.
      407     end.
      408     else do:
      409       find first in-vatp_doc-attroprl no-lock
      410         where in-vatp_doc-attroprl.doc-code  = out-vatp_partsprl.out-code
      411           and in-vatp_doc-attroprl.attr-code = 'envd':U
      412         no-error .
      413       if not available in-vatp_doc-attroprl then do:
      414         assign
      415           in-vatp-have-vat-sltoprl = yes.
      416       end.
      417       else do:
      418            in-vatp-have-vat-sltoprl = no.
      419       end.
      420     end.
      421     assign
      422      price-cli-with-tax-locoprl = out-vatp_partsprl.price-cli
      423      cli-base-rateoprl          = out-vatp_partsprl.cli-base-rate.
      424     ASSIGN   road-tax-base-locoprl  = (if out-vatp_partsprl.road-tax-base  = ? then 0 else out-vatp_partsprl.road-tax-base)
      425              road-tax-rubl-locoprl  = (if out-vatp_partsprl.road-tax-rubl  = ? then 0 else out-vatp_partsprl.road-tax-rubl).
      426     ASSIGN  transport-base-locoprl = (if out-vatp_partsprl.transport-base = ? then 0 else out-vatp_partsprl.transport-base)
      427             transport-rubl-locoprl = (if out-vatp_partsprl.transport-rubl = ? then 0 else out-vatp_partsprl.transport-rubl)
      428             other-base-locoprl     = (if out-vatp_partsprl.other-base     = ? then 0 else out-vatp_partsprl.other-base)
      429             other-rubl-locoprl     = (if out-vatp_partsprl.other-rubl     = ? then 0 else out-vatp_partsprl.other-rubl)
      430             vat-pc-locoprl         = (if out-vatp_partsprl.vat-pc         = ? then 0 else out-vatp_partsprl.vat-pc)
      431             slt-pc-locoprl         = (if out-vatp_partsprl.slt-pc         = ? then 0 else out-vatp_partsprl.slt-pc).
      432             ASSIGN   slt-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
      433       ASSIGN   slt-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
      434     assign
      435       exch-rate-cli-locoprl = (out-vatp_partsprl.price-rubl - transport-rubl-locoprl - other-rubl-locoprl - road-tax-rubl-locoprl - (if out-vatp_partsprl.vat-type <> 'в т. ч.':U then vat-rubl-locoprl else 0) - (if out-vatp_partsprl.slt-type <> 'в т. ч.':U then slt-rubl-locoprl else 0)) / out-vatp_partsprl.price-cli .
      436     assign
