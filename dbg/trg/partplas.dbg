      438       vat-cli-locoprl        = vat-rubl-locoprl       / exch-rate-cli-locoprl
      439       road-tax-cli-locoprl   = road-tax-rubl-locoprl  / exch-rate-cli-locoprl
      440       transport-cli-locoprl  = 0
      441       other-cli-locoprl      = 0
      442     .
      443   ASSIGN
      444             price-base-without-tax-locoprl = price-base-with-tax-locoprl - vat-base-locoprl - slt-base-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))
      445       price-rubl-without-tax-locoprl = price-rubl-with-tax-locoprl - vat-rubl-locoprl - slt-rubl-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))
      446   .
      447         assign
      448           varprice-base-consprl = varprice-base-consprl + (price-base-with-tax-locoprl - (if road-tax-base-locoprl = ? then 0 else road-tax-base-locoprl))* out-vatp_partsprl.fact-qnty
      449           varprice-rubl-consprl = varprice-rubl-consprl + (price-rubl-with-tax-locoprl - (if road-tax-rubl-locoprl = ? then 0 else road-tax-rubl-locoprl))* out-vatp_partsprl.fact-qnty.
      450         assign
      451           varis-cons-parts-haveprl = yes
      452           varcons-qntyprl          = varcons-qntyprl + out-vatp_partsprl.fact-qnty.
      453       end.
      454       assign
      455         varfact-qntyprl = varfact-qntyprl + out-vatp_partsprl.fact-qnty.
      456     end.
      457   end.
      458   assign
      459     varprice-base-consprl = varprice-base-consprl / varcons-qntyprl
      460     varprice-rubl-consprl = varprice-rubl-consprl / varcons-qntyprl.
      461   if varprice-base-consprl = ? then do:
      462     assign
      463       varprice-base-consprl = 0.
      464   end.
      465   if varprice-rubl-consprl = ? then do:
      466     assign
      467       varprice-rubl-consprl = 0.
      468   end.
      469   assign
      470       slt-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc)
      471     vat-base-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
      472     discnt-base-saleprl            = vardiscnt-base
      473     price-base-with-tax-saleprl    = (varprice-base - vardiscnt-base)
      474       slt-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc)
      475     vat-rubl-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc)
      476     discnt-rubl-saleprl            = vardiscnt-rubl
      477     price-rubl-with-tax-saleprl    = (varprice-rubl - vardiscnt-rubl)
      478     .
      479   if vardoc-type = 'инв':U then do:
      480     assign
      481       varfact-qntyprl = vardoc-qnty.
      482   end.
      483   else do:
      484     assign
      485       varfact-qntyprl = varfact-qnty.
      486   end.
      487   if varis-cons-parts-haveprl = no then do:
      488     assign
      489           vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
      490           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
      491   end.
      492   else do:
      493     if vardoc-type = 'инв':U then do:
      494       assign
      495               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
      496               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
      497        .
      498     end.
      499     else do:
      500       assign
      501               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
      502               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
      503        .
      504     end.
      505   end.
      506   assign
      507   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
      508   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
      509     end.
      510   end procedure.
      511   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      514   define variable par-type          as character no-undo.
      515   define variable v-value-character as character no-undo .
      516   define variable v-value-date      as date      no-undo .
      517   define variable v-value-decimal   as decimal   no-undo .
      518   define variable v-value-integer   as integer   no-undo .
      519   define variable v-value-logical   as logical   no-undo .
      520   define buffer buf_goods   for ub.goods .
      521   define buffer buf_db      for ub.db .
      522   define buffer buf_clients for ub.clients .
      523   define buffer buf_parts   for ub.parts .
      524   do
      525   on error undo, return error return-value
      526   :
      527     find first buf_goods no-lock
      528       where buf_goods.gds-code = p-gds-code
      529       no-error .
      530     if not available buf_goods
      531     then do:
      532       message
      533         vss-workfile vss-revision vss-description skip
      534         "Ошибка задания входных параметров" skip
      535         "Не найден товар" skip
      536         "Объект" p-obj-type p-obj-code skip
      537         "Код товара" p-gds-code
      538         view-as alert-box error .
      539       undo, return error return-value .
      540     end.
      541     find last buf_parts no-lock
      542       where buf_parts.obj-type  = p-obj-type
      543         and buf_parts.obj-code  = p-obj-code
      544         and buf_parts.artic     = buf_goods.artic
      545         and buf_parts.prod-type = buf_goods.prod-type
      546         and buf_parts.prod-code = buf_goods.prod-code
      547       use-index FIFO
      548       no-error.
      549     if available buf_parts
      550     then do:
      551       assign
      552         p-last-price-base = buf_parts.price-base
      553         p-last-price-rubl = buf_parts.price-rubl
      554       .
      555     end.
      556     if p-last-price-base = 0
      557     or p-last-price-rubl = 0
      558     then do:
      559       define variable v-rb-is-base                     as logical   no-undo .
      560       define variable v-host-code                      as integer   no-undo .
      561       define variable v-b-code                         as integer   no-undo .
      562       define variable v-price-list-recid               as recid     no-undo .
      563       define variable v-cli-base-rate                  as decimal   no-undo .
      564       define variable v-prsalpr-value                  as character no-undo .
      565       define variable v-prsalpr-type                   as character no-undo .
      566       define variable v-price-rubl-with-tax-saleprl    as decimal   no-undo .
      567       define variable v-price-base-with-tax-saleprl    as decimal   no-undo .
      568       define variable v-price-rubl-without-tax-saleprl as decimal   no-undo .
      569       define variable v-price-base-without-tax-saleprl as decimal   no-undo .
      570       define variable v-vat-base-saleprl               as decimal   no-undo .
      571       define variable v-vat-rubl-saleprl               as decimal   no-undo .
      572       define variable v-vat-base-buyerprl              as decimal   no-undo .
      573       define variable v-vat-rubl-buyerprl              as decimal   no-undo .
      574       define variable v-slt-base-saleprl               as decimal   no-undo .
      575       define variable v-slt-rubl-saleprl               as decimal   no-undo .
      576       define variable v-road-tax-base-saleprl          as decimal   no-undo .
      577       define variable v-road-tax-rubl-saleprl          as decimal   no-undo .
      578       define variable v-excise-base-saleprl            as decimal   no-undo .
      579       define variable v-excise-rubl-saleprl            as decimal   no-undo .
      580       define variable v-discnt-base-saleprl            as decimal   no-undo .
      581       define variable v-discnt-rubl-saleprl            as decimal   no-undo .
      582   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      584     (input  p-obj-type
      585     ,input  p-obj-code
      586     ,output v-host-code
      587     )  .
      588   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   empty temp-table thbjattr_thbj-attr.
      590   run adm/shattri.p (
      591      input "get":U
      592     ,input p-obj-type
      593     ,input p-obj-code
      594     ,input 'rezerv-obj':U
      595     ,input  ""
      596     ,output v-value-character
      597     ,output v-value-date
      598     ,output v-value-decimal
      599     ,output v-value-integer
      600     ,output v-value-logical
      601     ,output par-type
