        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-trn-doc old buffer old-c-doc .
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Триггер на запись документа":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|5',ub.c-trn-doc.doc-code,ub.c-trn-doc.chip-num,ub.c-trn-doc.ext-doc-type,ub.c-trn-doc.status_,ub.c-trn-doc.flag_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable v-host-code like c-trn-doc.host-code no-undo.
       82   MAIN-BLOCK :
       83   do
       84   on error   undo main-block, return error
       85   on end-key undo main-block, return error
       86   on stop    undo main-block, return error
       87   :
       88     find first ub.clients no-lock where
       89                ub.clients.obj-type = ub.c-trn-doc.obj-type and
       90                ub.clients.obj-code = ub.c-trn-doc.obj-code no-error .
       91     if not available ub.clients then do:
       92       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
       93               "Неправильная ссылка на объект" skip
       94               "Документ " ub.c-trn-doc.doc-code skip
       95               "Не найден объект" ub.c-trn-doc.obj-type ub.c-trn-doc.obj-code skip
       96       view-as alert-box error .
       97       undo main-block, return error .
       98     end.
       99     run trg/chkchpnm.p ( input ub.c-trn-doc.doc-code
      100                    , input ub.c-trn-doc.chip-num
      101                    , input "c-trn-doc":U
      102                    , input recid( ub.c-trn-doc )
      103                    ) no-error .
      104     if error-status :error then do:
      105       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      106               "Ошибка при проверке уникальности кода документа" skip
      107               "Документ " ub.c-trn-doc.doc-code skip
      108               error-status :get-message( 1 ) skip
      109               return-value skip
      110       view-as alert-box error .
      111       undo main-block, return error .
      112     end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      115     (input  ub.c-trn-doc.obj-type
      116     ,input  ub.c-trn-doc.obj-code
      117     ,output v-host-code
      118     ) no-error .
      119     if error-status :error then do:
      120       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      121               "Ошика при определении кода фирмы для объекта" skip
      122               "Документ " ub.c-trn-doc.doc-code skip
      123               "obj-type"  ub.c-trn-doc.obj-type skip
      124               "obj-code"  ub.c-trn-doc.obj-code skip
      125               error-status :get-message( 1 ) skip
      126               return-value skip
      127       view-as alert-box error .
      128       undo main-block, return error .
      129     end.
      130     if ub.c-trn-doc.host-code <> v-host-code then do:
      131       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      132               "Неправильно заполнено поле фирма" skip
      133               "Документ " ub.c-trn-doc.doc-code skip
      134               "Объект"    ub.c-trn-doc.obj-type ub.c-trn-doc.obj-code skip
      135               "Фирма"     ub.c-trn-doc.host-code skip
      136               "Должна быть фирма" v-host-code skip
      137       view-as alert-box error .
      138       undo main-block, return error .
      139     end.
      140     if g#news <> yes then do:
      141       if ub.c-trn-doc.corr-user-name = "":U then do:
      142         assign
      143           ub.c-trn-doc.corr-user-name = g#userid
      144         .
      145       end.
      146       run str/callnews.p ( input "c-trn-doc"
      147                      , input ( buffer ub.c-trn-doc :handle )
      148                      ) no-error .
      149       if error-status :error then do:
      150         message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      151                 "Невозможно маршрутизировать c-trn-doc для отправки в новости" skip
      152                 error-status :get-message( 1 ) skip
      153                 return-value skip
      154         view-as alert-box error .
      155         undo, return error .
      156       end.
      157     end.
      158       if g#oxml = true
      159       then do:
      160       run str/calloxml.p (
      161             input 'update':U
      162           , input 'c-trn-doc':U
      163           , input ( buffer ub.c-trn-doc:handle )
      164       ) no-error.
      165       if error-status :error
      166       then do:
      167           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      168                                , chr(10)
      169                                , vss-workfile
      170                                , return-value
      171                                , error-status :get-message ( 1 ) ).
      172       end.
      173       end.
      174   end.
