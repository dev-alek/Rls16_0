      963           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      964         (input  p-gds-code
      965         ,input  'fuel-type':U
      966         ,output c-value
      967         ,output c-type) no-error.
      968   end.
      969   result = logical(c-value = 'metan':U) no-error.
      970   return result.
      971   end function.
      972   procedure placelib_write-attr:
      973   define input  parameter p-code     like ub.place-attr.attr-code .
      974   define input  parameter p-obj-code like ub.place-attr.obj-code .
      975   define input  parameter p-obj-type like ub.place-attr.obj-type .
      976   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      977   define input  parameter p-value    like ub.place-attr.attr-value .
      978   define output parameter p-ok       as logical.
      979   define buffer buf_place-attr for ub.place-attr .
      980     do on error undo, return error return-value :
      981        p-ok = false.
      982        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      983                                                   and buf_place-attr.obj-code    = p-obj-code
      984                                                   and buf_place-attr.obj-type    = p-obj-type
      985                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      986        if not available buf_place-attr then do :
      987           create buf_place-attr.
      988           assign
      989             buf_place-attr.attr-code   = p-code
      990             buf_place-attr.attr-value  = p-value
      991             buf_place-attr.obj-code    = p-obj-code
      992             buf_place-attr.obj-type    = p-obj-type
      993             buf_place-attr.pl-code     = p-pl-code
      994           .
      995           p-ok = true.
      996        end.
      997        else do:
      998           buf_place-attr.attr-value  = p-value .
      999           p-ok = true.
     1000        end.
     1001     end.
     1002   end.
     1003   procedure placelib_get-attr:
     1004   define input  parameter  p-code     like ub.place-attr.attr-code .
     1005   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1006   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1007   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1008   define output parameter  p-value    like ub.place-attr.attr-value .
     1009   define output parameter  p-ok       as logical.
     1010   define buffer buf_place-attr for ub.place-attr .
     1011     do on error undo, return error return-value :
     1012        p-ok = false.
     1013        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1014                                                   and buf_place-attr.obj-code    = p-obj-code
     1015                                                   and buf_place-attr.obj-type    = p-obj-type
     1016                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1017        if available buf_place-attr then do :
     1018          p-value = buf_place-attr.attr-value.
     1019          p-ok = true.
     1020        end.
     1021        else do :
     1022          p-ok = false.
     1023        end.
     1024     end.
     1025   end.
     1026   procedure placelib_del-attr:
     1027   define input parameter  p-code     like ub.place-attr.attr-code .
     1028   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1029   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1030   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1031   define input parameter  p-value    like ub.place-attr.attr-value .
     1032   define output parameter p-ok       as logical.
     1033   define buffer buf_place-attr for ub.place-attr .
     1034     do on error undo, return error return-value :
     1035        p-ok = false.
     1036        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1037                                                   and buf_place-attr.obj-code    = p-obj-code
     1038                                                   and buf_place-attr.obj-type    = p-obj-type
     1039                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1040        if available buf_place-attr then do :
     1041           delete buf_place-attr.
     1042           p-ok = true.
     1043        end.
     1044     end.
     1045   end.
     1046   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1047   define new global shared variable g#trdcalib as handle no-undo.
     1048   do
     1049   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1050   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1051   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1052   :
     1053     define variable v-reserv-pl       as logical   no-undo .
     1054     define variable is-petrol         as logical   no-undo.
     1055     define variable is-pieces         as logical   no-undo.
     1056     define variable v-is-ptrl         as character no-undo.
     1057     define variable v-data-type       as character no-undo.
     1058     define variable v-chk-null-qnty   as logical   no-undo .
     1059     define variable v-sign            as decimal   no-undo .
     1060     define variable v-chk-rvs         as logical   no-undo .
     1061     define variable v-attr-value      as character no-undo .
     1062     define variable v-attr-type       as character no-undo .
     1063     define variable v-pl-fact-qnty        as decimal   no-undo .
     1064     define variable v-pl-doc-qnty         as decimal   no-undo .
     1065     define variable v-pl-cli-qnty         as decimal   no-undo .
     1066     define variable v-pl-cli-fact-qnty    as decimal   no-undo .
     1067     define variable v-pl-cli-doc-qnty     as decimal   no-undo .
     1068     define variable v-pl-rest-bf-qnty     as decimal   no-undo .
     1069     define variable v-pl-cli-rest-bf-qnty as decimal   no-undo .
     1070     define variable v-pl-rest-af-qnty     as decimal   no-undo .
     1071     define variable v-pl-cli-rest-af-qnty as decimal   no-undo .
     1072     define variable v-density         as decimal   no-undo .
     1073     define variable v-before-cli-qnty as decimal   no-undo .
     1074     define variable v-after-qnty      as decimal   no-undo .
     1075     define variable v-after-cli-qnty  as decimal   no-undo .
     1076     define variable v-last-invlin     as recid     no-undo .
     1077     define variable trn-is-lgas-corr  as logical   no-undo.
     1078     define variable is-vir as logical no-undo.
     1079     define variable v-value as character no-undo.
     1080     define variable v-ok as logical no-undo.
     1081     define buffer buf_doc-line      for ub.doc-line.
     1082     define buffer buf_inv-line      for ub.inv-line.
     1083     define buffer buf_trn-doc       for ub.trn-doc.
     1084     define buffer buf_goods         for ub.goods.
     1085     define buffer buf_rvs-doc       for ub.rvs-doc.
     1086     define buffer buf_rvs-line      for ub.rvs-line .
     1087     define buffer buf_doc-pl        for ub.doc-pl .
     1088     define buffer buf_pl-gds        for ub.pl-gds .
     1089     define buffer buf-cre_trn-doc   for ub.trn-doc .
     1090     define buffer buf_gds-obj       for ub.gds-obj .
     1091     define buffer buf-next_doc-line for ub.doc-line .
     1092     define buffer buf-next_inv-line for ub.inv-line .
     1093     define buffer buf-prev_inv-line for ub.inv-line .
     1094   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1095     (input  'is-ptrl'
     1096     ,input  ''
     1097     ,input  ''
     1098     ,input  0
     1099     ,input  ''
     1100     ,input  ''
     1101     ,input  ''
     1102     ,input  no
     1103     ,output v-is-ptrl
     1104     ,output v-data-type
     1105     ) no-error .
     1106     if error-status :error
     1107       or v-data-type <> "L"
     1108       or lookup( v-is-ptrl, "yes,no" ) = 0
     1109       or v-is-ptrl = "no"
     1110     then do:
     1111       return .
     1112     end.
     1113     find buf_trn-doc exclusive-lock
     1114       where buf_trn-doc.doc-code = p-doc-code
     1115     no-error.
     1116     if not available buf_trn-doc then do:
     1117       undo, return error substitute( "&1. Не найден документ &2", vss-workfile, p-doc-code ).
     1118     end.
     1119     if buf_trn-doc.ext-doc-type = 'iv':U
     1120       and buf_trn-doc.status_ = 'накл':U
     1121     then do:
     1122       return .
     1123     end.
     1124     if buf_trn-doc.ext-doc-type = 'io':U
     1125     then do:
     1126       return .
     1127     end.
     1128     else do:
     1129       if lookup( buf_trn-doc.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then do:
     1130         assign
     1131           v-sign = -1.0
     1132         .
     1133       end.
     1134       else do:
     1135         assign
     1136           v-sign = 1.0
     1137         .
     1138         if lookup( buf_trn-doc.ext-doc-type, 'ie,re,rs,vt,vp,ap,mp,pc,iv,rv,im,io':U ) = 0 then do:
     1139           undo, return error substitute( '&1. Тип "&2" не внесен в списки документов уменьшающих(увеличивающих) остатки!', vss-workfile, buf_trn-doc.ext-doc-type).
     1140         end.
     1141       end.
     1142       assign
     1143         v-chk-null-qnty = true
     1144       .
     1145       if buf_trn-doc.ext-doc-type = 'we':U
     1146         or buf_trn-doc.ext-doc-type = 're':U
     1147       then do:
     1148         find first buf-cre_trn-doc no-lock
     1149           where buf-cre_trn-doc.doc-code = buf_trn-doc.out-code
     1150           no-error .
     1151         if available buf-cre_trn-doc
     1152           and buf-cre_trn-doc.ext-doc-type = 'vt':U
     1153         then do:
     1154           assign
     1155             v-chk-null-qnty = false
     1156           .
     1157         end.
     1158       end.
     1159       assign
     1160         v-chk-rvs = false
     1161       .
     1162       if buf_trn-doc.doc-type = 'при':U then do:
     1163         assign
     1164           v-chk-rvs = true
     1165         .
     1166         if buf_trn-doc.ext-doc-type = 'ie':U then do:
     1167           run clntattr-value in this-procedure
     1168             ( input  buf_trn-doc.cli-type
     1169              ,input  buf_trn-doc.cli-code
     1170              ,input  'shftrep2':U
     1171              ,output v-attr-value
     1172              ,output v-attr-type
     1173             ) .
     1174           if v-attr-value = "yes":U then do:
     1175             assign
     1176               v-chk-rvs = false
     1177             .
     1178           end.
     1179         end.
     1180         if v-chk-rvs = true then do:
     1181           assign
     1182             v-chk-rvs = false
     1183           .
     1184           block_chk_ptrl :
     1185           for each buf_doc-line exclusive-lock
     1186             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1187           on error undo, return error return-value
     1188           :
     1189   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1190     (
     1191        input buf_doc-line.artic
     1192     ,  input buf_doc-line.prod-type
     1193     ,  input buf_doc-line.prod-code
     1194     , output is-petrol
     1195     , output is-pieces
     1196     ) .
     1197             if is-petrol = true
     1198               and is-pieces = false
     1199             then do:
     1200               find first buf_goods no-lock
     1201                 where buf_goods.artic     = buf_doc-line.artic
     1202                   and buf_goods.prod-type = buf_doc-line.prod-type
     1203                   and buf_goods.prod-code = buf_doc-line.prod-code
     1204               .
     1205               trn-is-lgas-corr = false.
     1206   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_doc-line.doc-code ,
     1207                           input 'is-lgas-corr':U ,
     1208                          output v-attr-value ,
     1209                          output v-attr-type ) no-error .
     1210               if v-attr-value = "yes" then do:
     1211               assign
     1212                 trn-is-lgas-corr = true.
     1213               end.
     1214               run gds-attr-value in this-procedure
     1215                 ( input  buf_goods.gds-code
     1216                 ,input  'ptrl-without-rvs':U
     1217                 ,output v-attr-value
     1218                 ,output v-attr-type
     1219                 ) .
     1220               find first buf_doc-pl no-lock
     1221                   where buf_doc-pl.obj-type = buf_doc-line.obj-type
     1222                   and buf_doc-pl.obj-code = buf_doc-line.obj-code
     1223                   and buf_doc-pl.out-code = buf_doc-line.doc-code
     1224                   and buf_doc-pl.gds-code = buf_goods.gds-code no-error.
     1225               run placelib_get-attr(input "place-virtual"
     1226                                    ,input buf_doc-pl.obj-code
     1227                                    ,input buf_doc-pl.obj-type
     1228                                    ,input buf_doc-pl.pl-code
     1229                                    ,output v-value
     1230                                    ,output v-ok) no-error.
     1231               is-vir = if (v-ok and logical(v-value)) then true else false.
     1232               if lookup(v-attr-value, 'true,yes':u) = 0 and not is-gas(buf_goods.gds-code) and not is-vir and
     1233                 not trn-is-lgas-corr then do:
     1234                 assign
     1235                   v-chk-rvs = true
     1236                 .
     1237                 leave block_chk_ptrl.
     1238               end.
     1239             end.
     1240           end.
     1241         end.
     1242         if buf_trn-doc.status_ = 'факт':U
     1243           and v-chk-rvs = true
     1244         then do:
     1245           find first buf_rvs-doc no-lock
     1246             where buf_rvs-doc.out-code = buf_trn-doc.doc-code
     1247               and buf_rvs-doc.rvs-type = 'перед_док':U
     1248             no-error .
