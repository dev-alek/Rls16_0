      935     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      936       define variable v-answ as logical no-undo .
      937       if ( p-unit-base-cli-eq = true
      938            and p-density = 1.0
      939          )
      940         or ( p-unit-base-cli-eq = false
      941              and p-density <> ?
      942              and p-density > 0.0
      943              and p-density < 1.0
      944            )
      945       then do:
      946         assign
      947           v-answ = true
      948         .
      949       end.
      950       else do:
      951         assign
      952           v-answ = false
      953         .
      954       end.
      955       return v-answ.
      956     end function.
      957   function is-gas returns logical
