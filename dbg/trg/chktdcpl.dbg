     1652                                               + '"Стало" &8 (&3) (inv-line.after-cli-qnty)&1'
     1653                                               ,chr(10)
     1654                                               ,buf_goods.unit-base
     1655                                               ,buf_goods.unit-cli
     1656                                               ,buf_doc-line.fact-qnty
     1657                                               ,buf_doc-line.cli-qnty
     1658                                               ,buf_doc-line.doc-qnty
     1659                                               ,buf_inv-line.wast-cli-qnty
     1660                                               ,buf_inv-line.after-cli-qnty
     1661                                             ).
     1662               end.
     1663               if buf_trn-doc.status_ = 'факт':U
     1664                 and absolute( buf_doc-line.doc-qnty * buf_doc-line.fact-density - buf_inv-line.wast-cli-qnty ) > 0.01
     1665               then do:
     1666                 undo, return error substitute( 'Ошибка в количествах "стало"&1'
     1667                                               + 'Документ &2&1'
     1668                                               + 'Товар &3&1'
     1669                                               + '"Стало" &6 (&4)&1'
     1670                                               + '"Стало" &7 (&5)&1'
     1671                                               + '"Стало" (плотность) &8&1'
     1672                                               ,chr(10)
     1673                                               ,buf_trn-doc.doc-code
     1674                                               ,buf_goods.gds-code
     1675                                               ,buf_goods.unit-base
     1676                                               ,buf_goods.unit-cli
     1677                                               ,buf_doc-line.doc-qnty
     1678                                               ,buf_inv-line.after-cli-qnty
     1679                                               ,buf_doc-line.fact-density
     1680                                             ).
     1681               end.
     1682             end.
     1683             else do:
     1684               if absolute( buf_doc-line.fact-qnty * buf_doc-line.fact-density - buf_inv-line.wast-cli-qnty ) > 0.001
     1685                 and ( buf_doc-line.fact-qnty <> 0
     1686                       or ( buf_doc-line.fact-qnty = 0
     1687                           and v-chk-null-qnty = true
     1688                         )
     1689                     )
     1690               then do:
     1691                 undo, return error substitute( "Несоответствие по товару &2 в строке документа &3&1"
     1692                                                 + "Фактическое количество (&4): &6&1"
     1693                                                 + "Фактическое количество (&5): &7&1"
     1694                                                 + "Плотность: &8"
     1695                                                 ,chr(10)
     1696                                                 ,buf_goods.gds-code
     1697                                                 ,buf_doc-line.doc-code
     1698                                                 ,buf_goods.unit-base
     1699                                                 ,buf_goods.unit-cli
     1700                                                 ,buf_doc-line.fact-qnty
     1701                                                 ,buf_inv-line.wast-cli-qnty
     1702                                                 ,buf_doc-line.fact-density
     1703                                               ).
     1704               end.
     1705             end.
     1706             if buf_trn-doc.status_ = 'факт':U then do:
     1707               if v-chk-rvs = true then do:
     1708                 run gds-attr-value in this-procedure
     1709                   ( input  buf_goods.gds-code
     1710                   ,input  'ptrl-without-rvs':U
     1711                   ,output v-attr-value
     1712                   ,output v-attr-type
     1713                   ) .
     1714                 if lookup(v-attr-value, 'true,yes':u) = 0 then do:
     1715                   find first buf_rvs-line no-lock
     1716                     where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     1717                       and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     1718                       and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     1719                       and buf_rvs-line.gds-code = buf_goods.gds-code
     1720                     no-error .
     1721                   if not available buf_rvs-doc then do:
     1722                     undo, return error substitute( 'Вы не сделали сверку перед документом "&1" (тип "&2") по товару &3 ("&4").'
     1723                                                   , buf_trn-doc.doc-code
     1724                                                   , 'перед_док':U
     1725                                                   , buf_goods.gds-code
     1726                                                   , buf_goods.gds-name
     1727                                                   ) .
     1728                   end.
     1729                   find first buf_rvs-line no-lock
     1730                     where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     1731                       and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     1732                       and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     1733                       and buf_rvs-line.gds-code = buf_goods.gds-code
     1734                     no-error .
     1735                   if not available buf_rvs-doc then do:
     1736                     undo, return error substitute( 'Вы не сделали сверку после документа "&1" (тип "&2") по товару &3 ("&4").'
     1737                                                   , buf_trn-doc.doc-code
     1738                                                   , 'после_док':U
     1739                                                   , buf_goods.gds-code
     1740                                                   , buf_goods.gds-name
     1741                                                   ) .
     1742                   end.
     1743                 end.
     1744               end.
     1745               if ( buf_trn-doc.doc-type <> 'инв':U
     1746                   and buf_inv-line.wast-cli-qnty = ?
     1747                 )
     1748                 or
     1749                 ( buf_trn-doc.doc-type = 'инв':U
     1750                   and buf_doc-line.cli-qnty = ?
     1751                 )
     1752               then do:
     1753                 undo, return error substitute( 'Ошибка в нарастающем итоге&1'
     1754                                                 + 'Документ &2&1'
     1755                                                 + 'Товар &3&1'
     1756                                                 + 'По документу &5 (&4)&1'
     1757                                                 ,chr(10)
     1758                                                 ,buf_trn-doc.doc-code
     1759                                                 ,buf_goods.gds-code
     1760                                                 ,buf_goods.unit-cli
     1761                                                 ,(if buf_trn-doc.doc-type = 'инв':U then buf_doc-line.cli-qnty else buf_inv-line.wast-cli-qnty )
     1762                                               ).
     1763               end.
     1764   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_lastinvl in g#lib-trn3
     1765   (
     1766      input buf_inv-line.doc-code
     1767   ,  input buf_inv-line.artic
     1768   ,  input buf_inv-line.prod-type
     1769   ,  input buf_inv-line.prod-code
     1770   , output v-before-cli-qnty
     1771   , output v-last-invlin
     1772   )  .
     1773               find first buf-prev_inv-line no-lock
     1774                 where recid( buf-prev_inv-line ) = v-last-invlin
     1775                 no-error .
     1776               IF AVAILABLE buf-prev_inv-line THEN DO :
     1777               case buf_trn-doc.doc-type :
     1778                 when 'инв':U then do:
     1779                   assign
     1780                     v-after-cli-qnty = v-before-cli-qnty + buf_doc-line.cli-qnty
     1781                   .
     1782                 end.
     1783                 otherwise do:
     1784                   assign
     1785                     v-after-cli-qnty = v-before-cli-qnty + buf_inv-line.wast-cli-qnty * v-sign
     1786                   .
     1787                 end.
     1788               end case.
     1789               if v-before-cli-qnty <> buf_inv-line.before-cli-qnty
     1790                 or v-after-cli-qnty <> buf_inv-line.after-cli-qnty
     1791               then do:
     1792                 if abs(v-before-cli-qnty - buf_inv-line.before-cli-qnty) <= 0.001
     1793                 and abs(v-after-cli-qnty  -  buf_inv-line.after-cli-qnty) <= 0.001
     1794                 then do :
     1795                   assign
     1796                     buf_inv-line.before-cli-qnty = v-before-cli-qnty
     1797                     buf_inv-line.after-cli-qnty  = v-after-cli-qnty
     1798                   .
     1799                 end.
     1800                 else do :
     1801                 undo, return error substitute( 'Ошибка в нарастающем итоге&1'
     1802                                                 + 'Документ &2&1'
     1803                                                 + 'Товар &3&1'
     1804                                                 + '"Было" предыдущий документ (&5) &6 (&4)&1'
     1805                                                 + '"Было" текущий документ &7 (&4)&1'
     1806                                                 ,chr(10)
     1807                                                 ,buf_trn-doc.doc-code
     1808                                                 ,buf_goods.gds-code
     1809                                                 ,buf_goods.unit-cli
     1810                                                 ,(if available buf-prev_inv-line then buf-prev_inv-line.doc-code else "":U)
     1811                                                 ,v-before-cli-qnty
     1812                                                 ,buf_inv-line.before-cli-qnty
     1813                                               )
     1814                                 + substitute( 'По документу &3 (&2)&1'
     1815                                                 + '"Стало" текущий документ &4 (&2)&1'
     1816                                                 + '"Стало" должно быть &5 (&2)&1'
     1817                                                 ,chr(10)
     1818                                                 ,buf_goods.unit-cli
     1819                                                 ,(if buf_trn-doc.doc-type <> 'инв':U then buf_inv-line.wast-cli-qnty else buf_doc-line.cli-qnty )
     1820                                                 ,buf_inv-line.after-cli-qnty
     1821                                                 ,v-after-cli-qnty
     1822                                               ).
     1823               end.
     1824               end.
     1825               END.
     1826               find first buf-next_doc-line
     1827                 where buf-next_doc-line.obj-type   = buf_doc-line.obj-type
     1828                   and buf-next_doc-line.obj-code   = buf_doc-line.obj-code
     1829                   and buf-next_doc-line.prod-type  = buf_doc-line.prod-type
     1830                   and buf-next_doc-line.prod-code  = buf_doc-line.prod-code
     1831                   and buf-next_doc-line.artic      = buf_doc-line.artic
     1832                   and buf-next_doc-line.status_    = 'факт':U
     1833                   and buf-next_doc-line.fact-order > buf_doc-line.fact-order
     1834                 no-error .
     1835               if not available buf-next_doc-line then do:
     1836                 assign
     1837                   v-after-qnty     = 0.0
     1838                   v-after-cli-qnty = 0.0
     1839                 .
     1840                 for each buf_pl-gds no-lock
     1841                   where buf_pl-gds.gds-code = buf_goods.gds-code
     1842                     and buf_pl-gds.obj-type = buf_doc-line.obj-type
     1843                     and buf_pl-gds.obj-code = buf_doc-line.obj-code
     1844                 on error undo, return error return-value
     1845                 :
     1846                   assign
     1847                     v-after-qnty     = v-after-qnty     + buf_pl-gds.fact-qnty
     1848                     v-after-cli-qnty = v-after-cli-qnty + buf_pl-gds.cli-fact-qnty
     1849                   .
     1850                 end.
     1851                 if absolute( v-after-cli-qnty - buf_inv-line.after-cli-qnty ) > 0.001 then do:
     1852                   undo, return error substitute( 'Ошибка в нарастающем итоге&1'
     1853                                                   + 'Документ &2&1'
     1854                                                   + 'Товар &3&1'
     1855                                                   + '"Стало" (текущий документ) &5 (&4)&1'
     1856                                                   + '"Стало" (по местам хр.) &6 (&4)'
     1857                                                   ,chr(10)
     1858                                                   ,buf_trn-doc.doc-code
     1859                                                   ,buf_goods.gds-code
     1860                                                   ,buf_goods.unit-cli
     1861                                                   ,buf_inv-line.after-cli-qnty
     1862                                                   ,v-after-cli-qnty
     1863                                                 ).
     1864                 end.
     1865                 find first buf_gds-obj no-lock
     1866                   where buf_gds-obj.obj-type  = buf_doc-line.obj-type
     1867                     and buf_gds-obj.obj-code  = buf_doc-line.obj-code
     1868                     and buf_gds-obj.artic     = buf_doc-line.artic
     1869                     and buf_gds-obj.prod-type = buf_doc-line.prod-type
     1870                     and buf_gds-obj.prod-code = buf_doc-line.prod-code
     1871                 .
     1872                 if absolute( v-after-qnty - buf_gds-obj.fact-qnty ) > 0.001 then do:
     1873                   undo, return error substitute( 'Ошибка в итоговом кол-ве товара на местах хранения&1'
     1874                                                   + 'Документ &2&1'
     1875                                                   + 'Товар &3&1'
     1876                                                   + '"Стало" (на объекте) &5 (&4)&1'
     1877                                                   + '"Стало" (по местам хр.) &6 (&4)'
     1878                                                   ,chr(10)
     1879                                                   ,buf_trn-doc.doc-code
     1880                                                   ,buf_goods.gds-code
     1881                                                   ,buf_goods.unit-base
     1882                                                   ,buf_gds-obj.fact-qnty
     1883                                                   ,v-after-qnty
     1884                                                 ).
     1885                 end.
     1886               end.
     1887               else do:
     1888                 find first buf-next_inv-line
     1889                   where buf-next_inv-line.doc-code  = buf-next_doc-line.doc-code
     1890                     and buf-next_inv-line.artic     = buf-next_doc-line.artic
     1891                     and buf-next_inv-line.prod-type = buf-next_doc-line.prod-type
     1892                     and buf-next_inv-line.prod-code = buf-next_doc-line.prod-code
     1893                   no-error.
     1894                 if not available buf-next_inv-line then do:
     1895                   undo, return error substitute( "Не найдена строка с информацией о кол-ве (&1) товара в документе &2 для товара &3."
     1896                                                 ,buf_goods.unit-cli
     1897                                                 ,buf-next_doc-line.doc-code
     1898                                                 ,buf_goods.gds-code
     1899                                                 ).
     1900                 end.
     1901                 if buf_inv-line.after-cli-qnty <> buf-next_inv-line.before-cli-qnty then do:
     1902                   undo, return error substitute( 'При закрытии документа задним числом не пересчитан нарастающий итог&1'
     1903                                                   + 'Документ &2&1'
     1904                                                   + 'Товар &3&1'
     1905                                                   + '"Стало" текущего документа &5 (&4)&1'
     1906                                                   + '"Было" следующего документа (&6) &7 (&4)'
     1907                                                   ,chr(10)
     1908                                                   ,buf_trn-doc.doc-code
     1909                                                   ,buf_goods.gds-code
     1910                                                   ,buf_goods.unit-cli
     1911                                                   ,buf_inv-line.after-cli-qnty
     1912                                                   ,buf-next_doc-line.doc-code
     1913                                                   ,buf-next_inv-line.before-cli-qnty
     1914                                                 ).
     1915                 end.
     1916               end.
     1917             end.
     1918           end.
     1919         end.
     1920       end.
     1921     end.
     1922     return .
     1923   end.
