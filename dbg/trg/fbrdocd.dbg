        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.fbr-doc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление записи документ производства".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "X(65)" no-undo
       79   initial "@(#)$Workfile$ $Revision$".
       80   define temp-table temp_fbrcode-doc-code no-undo
       81       field rec-type      as character
       82       field doc-code      as character
       83       field obj-type      as character
       84       field obj-code      as integer
       85       field cli-type      as character
       86       field cli-code      as integer
       87       field ext-doc-type  as character
       88       field doc-type      as character
       89       field order         as integer
       90       index pi is primary unique rec-type doc-code
       91       index od order
       92   .
       93   procedure fbrcode-gen-recipe-code :
       94   do
       95   on error undo, return error
       96   :
       97   define input parameter p-obj-type           as character    no-undo.
       98   define input parameter p-obj-code           as integer      no-undo.
       99   define output parameter p-recipe-code       as character    no-undo.
      100       assign
      101           p-recipe-code   = string( next-value( s-recipe, ub ) )
      102                               + "-"
      103                               + trim( string( p-obj-code, ">>>>9" ) )
      104                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      105       .
      106   end.
      107   end procedure.
      108   procedure fbrcode-is-from-object :
      109   do
      110   on error undo, return error
      111   :
      112   define input parameter p-doc-code           as character    no-undo.
      113   define input parameter p-obj-type           as character    no-undo.
      114   define input parameter p-obj-code           as integer      no-undo.
      115   define output parameter p-is-from-object    as logical      no-undo.
      116       if num-entries( p-doc-code, "-" ) < 2
      117       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
      118                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      119       then do:
      120           assign
      121               p-is-from-object = no
      122           .
      123       end.
      124       else do:
      125           assign
      126               p-is-from-object = yes
      127           .
      128       end.
      129   end.
      130   end procedure.
      131   procedure fbrcode-trn-doc :
      132   do
      133   on error undo, return error
      134   :
      135       define input parameter p-out-doc-type       as character    no-undo.
      136       define input parameter p-out-code           as character    no-undo.
      137       define input parameter p-trn-doc-out-type   as character    no-undo.
      138       define output parameter p-trn-doc-doc-code  as character   no-undo.
      139       case p-out-doc-type:
      140           when 'производство':U
      141           then do:
      142               case p-trn-doc-out-type :
      143                   when 'рас':U
      144                   then do:
      145                       assign
      146                           p-trn-doc-doc-code = p-out-code
      147                       .
      148                   end.
      149                   when 'при':U
      150                   then do:
      151                       assign
      152                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
      153                       .
      154                   end.
      155                   when 'спи':U
      156                   then do:
      157                       assign
      158                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
      159                       .
      160                   end.
      161                   otherwise do:
      162                       assign
      163                           p-trn-doc-doc-code = ""
      164                       .
      165                       undo, return error "Не может быть обработан тип складского документа '"
      166                                           + p-trn-doc-out-type + "' во входных параметрах".
      167                   end.
      168               end case.
      169           end.
      170           otherwise do:
      171               assign
      172                   p-trn-doc-doc-code = ""
      173               .
      174               undo, return error "Не может быть обработан тип внешнего документа '"
      175                                   + p-out-doc-type + "' во входных параметрах".
      176           end.
      177       end case.
      178   end.
      179   end procedure.
      180   procedure fbrcode-fill-fbr-by-sale-or-pln :
      181   define input parameter p-main-doc-code      as character        no-undo.
      182       define variable v-order    as integer      no-undo.
      183       define buffer buf_fbr-doc               for ub.fbr-doc.
      184       define buffer buf_trn-doc               for ub.trn-doc.
      185       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      186   do
      187   for buf_fbr-doc
      188     , buf_trn-doc
      189     , buf_temp_fbrcode-doc-code
      190   on error undo, return error
      191   :
      192       for each buf_temp_fbrcode-doc-code
      193       on error undo, return error
      194       :
      195           delete buf_temp_fbrcode-doc-code.
      196       end.
      197       assign
      198           v-order = 0
      199       .
      200       for each buf_fbr-doc no-lock
      201          where buf_fbr-doc.out-code = p-main-doc-code
      202       on error undo, return error
      203       :
      204           create buf_temp_fbrcode-doc-code.
      205           assign
      206               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
      207               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
      208               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
      209               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
      210               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
      211               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
      212               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
      213               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
      214           .
      215           for each buf_trn-doc no-lock
      216              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      217           by buf_trn-doc.fact-order
      218           on error undo, return error
      219           :
      220               if buf_trn-doc.ext-doc-type = 'em':U
      221               or buf_trn-doc.ext-doc-type = 'im':U
      222               or buf_trn-doc.ext-doc-type = 'wm':U
      223               or buf_trn-doc.ext-doc-type = 'ev':U
      224               then do:
      225                   assign
      226                       v-order = v-order + 1
      227                   .
      228                   create buf_temp_fbrcode-doc-code.
      229                   assign
      230                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      231                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
      232                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      233                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      234                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      235                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      236                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      237                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      238                       buf_temp_fbrcode-doc-code.order         = v-order
      239                   .
      240               end.
      241           end.
      242           assign
      243               v-order  = v-order + 1
      244           .
      245           find first buf_temp_fbrcode-doc-code
      246                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
      247                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
      248           .
      249           assign
      250               buf_temp_fbrcode-doc-code.order = v-order
      251           .
      252       end.
      253       for each buf_trn-doc no-lock
      254          where buf_trn-doc.out-code = p-main-doc-code
      255       by buf_trn-doc.fact-order
      256       on error undo, return error
      257       :
      258           assign
      259               v-order = v-order + 1
      260           .
      261           create buf_temp_fbrcode-doc-code.
      262           assign
      263               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      264               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
      265               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      266               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      267               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      268               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      269               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      270               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      271               buf_temp_fbrcode-doc-code.order         = v-order
      272           .
      273       end.
      274   end.
      275   end procedure.
      276   procedure fbrcode-get-final-doc :
      277   define input parameter p-main-doc-code      as character        no-undo.
      278   define output parameter p-income-doc-code   as character        no-undo.
      279       define variable v-main-obj-type    as character    no-undo.
      280       define variable v-main-obj-code    as integer      no-undo.
      281       define buffer buf_trn-doc               for ub.trn-doc.
      282       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      283   do
      284   for buf_trn-doc
      285   on error undo, return error
      286   :
      287       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
      288           input p-main-doc-code
      289       ).
      290       find first buf_trn-doc no-lock
      291            where buf_trn-doc.doc-code = p-main-doc-code
      292       .
      293       assign
      294           v-main-obj-type = buf_trn-doc.obj-type
      295           v-main-obj-code = buf_trn-doc.obj-code
      296       .
      297       find first buf_temp_fbrcode-doc-code
      298            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
      299              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
      300              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
      301       no-error.
      302       if available buf_temp_fbrcode-doc-code
      303       then do:
      304           find first buf_trn-doc no-lock
      305                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
      306                  and buf_trn-doc.ext-doc-type = 'iv':U
      307           .
      308           assign
      309               p-income-doc-code = buf_trn-doc.doc-code
      310           .
      311       end.
      312       else do:
      313           find first buf_temp_fbrcode-doc-code
      314                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
      315                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
      316                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
      317           no-error.
      318           if available buf_temp_fbrcode-doc-code
      319           then do:
      320               assign
      321                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
      322               .
      323           end.
      324           else do:
      325               assign
      326                   p-income-doc-code = "":U
      327               .
      328           end.
      329       end.
      330   end.
      331   end procedure.
      332   define variable v-message as character no-undo .
      333   main-block:
      334   do
      335   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      336   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      337   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      338   :
      339     if ub.fbr-doc.status_ = 'факт':U
      340     and not g#news
      341     then do:
      342       if ub.fbr-doc.is-del = no
      343       then do:
      344         message
      345         vss-workfile vss-revision vss-description skip
      346         "Нельзя удалять документ, закрытый до статуса" 'факт':U skip
      347         "Документ        " ub.fbr-doc.doc-code skip
      348         "Статус документа" ub.fbr-doc.status_ skip
      349         view-as alert-box error .
      350         undo main-block, return error .
      351       end.
      352       else do:
      353         run check-fact-trn-doc in this-procedure (
      354             input 'при':U
      355         ) no-error.
      356         if error-status :error
      357         then do:
      358           undo main-block, return error .
      359         end.
      360         run check-fact-trn-doc in this-procedure (
      361             input 'рас':U
      362         ) no-error.
      363         if error-status :error
      364         then do:
      365           undo main-block, return error .
      366         end.
      367         run check-fact-trn-doc in this-procedure (
      368             input 'спи':U
      369         ) no-error.
      370         if error-status :error
      371         then do:
      372           undo main-block, return error .
      373         end.
      374         run trg/userlog.p (
      375                             input 'delete':U
      376                           , input 'fbr-doc':U
      377                           , input ( buffer ub.fbr-doc :handle )
      378                           , input ?
      379                           , input ""
      380                       ) no-error.
      381                       if error-status :error
      382                       then do:
      383                           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      384                                               , chr(10)
      385                                               , vss-workfile
      386                                               , return-value
      387                                               , error-status :get-message ( 1 ) ).
      388                       end.
      389       end.
      390     end.
      391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      392     (input ?
      393     ,input this-procedure:handle
      394     ,input ?
      395     ,input 'event_fbr-doc':U
      396     ,input  buffer ub.fbr-doc:handle
      397     ,input ?
      398     ,input ''
      399     ,input ''
      400     ) no-error .
      401     if error-status:error
      402     then do:
      403       v-message = substitute("&1 &2 &3&4Ошибка при вызове процедуры rum-runa.i&4&5&4&5&6"
      404                               ,vss-workfile
      405                               ,vss-revision
      406                               ,vss-description
      407                               ,chr(10)
      408                               , error-status:get-message(1)
      409                               , return-value ).
      410         if not g#news
      411         and not g#auto
      412         and not g#esys
      413         then do:
      414         message
      415         v-message
      416         view-as alert-box error .
      417       end.
      418       undo main-block,  return error v-message.
      419     end.
      420     if g#news then do:
      421       for each ub.fbr-line share-lock where
      422               ub.fbr-line.doc-code = ub.fbr-doc.doc-code
      423       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      424       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      425       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      426       :
      427         delete ub.fbr-line.
      428       end.
      429       for each ub.fbr-recipe share-lock where
      430               ub.fbr-recipe.doc-code = ub.fbr-doc.doc-code
      431       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      432       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      433       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      434       :
      435         delete ub.fbr-recipe.
      436       end.
      437       for each ub.fbr-recipe-gds share-lock where
      438               ub.fbr-recipe-gds.doc-code = ub.fbr-doc.doc-code
      439       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      440       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      441       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      442       :
      443         delete ub.fbr-recipe-gds.
      444       end.
      445     end.
      446     else do:
      447       find first ub.fbr-line no-lock
      448         where ub.fbr-line.doc-code = ub.fbr-doc.doc-code
      449         no-error .
      450       if available ub.fbr-line then do:
      451         message
      452           vss-workfile vss-revision vss-description skip
      453           "Ошибка при удалении документа производства" skip
      454           "Найдена строка документа производства" skip
      455           "Документ"    ub.fbr-line.doc-code    skip
      456           "trn-type"    ub.fbr-line.trn-type    skip
      457           "recipe-code" ub.fbr-line.recipe-code skip
      458           "artic"       ub.fbr-line.artic       skip
      459           "prod-type"   ub.fbr-line.prod-type   skip
      460           "prod-code"   ub.fbr-line.prod-code   skip
      461           view-as alert-box error .
      462         undo main-block, return error .
      463       end.
      464     find first ub.fbr-recipe no-lock
      465       where ub.fbr-recipe.doc-code = ub.fbr-doc.doc-code
      466       no-error .
      467     if available ub.fbr-recipe then do:
      468       message
      469       vss-workfile vss-revision vss-description skip
      470       "Ошибка при удалении документа производства" skip
      471       "Найден рецепт документа производства"       skip
      472       "Документ"       ub.fbr-recipe.doc-code      skip
      473       "recipe-code"    ub.fbr-recipe.recipe-code   skip
      474       view-as alert-box error .
      475       undo main-block, return error .
      476     end.
      477     find first ub.fbr-recipe-gds no-lock
      478       where ub.fbr-recipe-gds.doc-code = ub.fbr-doc.doc-code
      479       no-error .
      480     if available ub.fbr-recipe-gds then do:
      481       message
      482       vss-workfile vss-revision vss-description skip
      483       "Ошибка при удалении документа производства" skip
      484       "Найдена строка рецепта документа производства" skip
      485       "Документ"    ub.fbr-line.doc-code    skip
      486       "recipe-code" ub.fbr-recipe-gds.recipe-code skip
      487       "artic"       ub.fbr-recipe-gds.artic       skip
      488       "prod-type"   ub.fbr-recipe-gds.prod-type   skip
      489       "prod-code"   ub.fbr-recipe-gds.prod-code   skip
      490       view-as alert-box error .
      491       undo main-block, return error .
      492     end.
      493     end.
      494     if g#oxml = yes
      495     then do:
      496       run str/calloxml.p (
      497             input 'delete':U
      498           , input 'fbr-doc':U
      499           , input ( buffer ub.fbr-doc:handle )
      500       ) no-error.
      501       if error-status :error
      502       then do:
      503           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      504                                , chr(10)
      505                                , vss-workfile
      506                                , return-value
      507                                , error-status :get-message ( 1 ) ).
      508       end.
      509     end.
      510     run nws/cmd-del.p
      511       ( input 'fbr-doc':U
      512        ,input (buffer ub.fbr-doc:handle)
      513        ,input ''
      514       ) no-error .
      515     if error-status :error then do:
      516       undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      517     end.
      518   end.
      519   procedure check-fact-trn-doc :
      520   define input parameter p-doc-type as character    no-undo.
      521   define variable v-doc-code          like trn-doc.doc-code       no-undo.
      522   define buffer buf_trn-doc       for trn-doc.
      523   main-block:
      524   do
      525   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      526   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      527   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      528   :
      529     run fbrcode-trn-doc in this-procedure (
      530           input 'производство':U
      531         , input ub.fbr-doc.doc-code
      532         , input p-doc-type
      533         , output v-doc-code
      534     ).
      535     find first buf_trn-doc
      536           where buf_trn-doc.doc-code = v-doc-code
      537     no-error.
      538     if available buf_trn-doc
      539     then do:
      540       message
      541       vss-workfile vss-revision vss-description
      542       skip "Нельзя удалять документ производства, закрытый до статуса" 'факт':U
      543       skip "Номер документа " ub.fbr-doc.doc-code
      544       skip "Статус документа" ub.fbr-doc.status_
      545       skip (1) "Есть связанный складской документ:"
      546       skip "Тип документа  " buf_trn-doc.doc-type
      547       skip "Номер документа" buf_trn-doc.doc-code
      548       view-as alert-box error .
      549       undo main-block, return error .
      550     end.
      551   end.
      552   end procedure.
