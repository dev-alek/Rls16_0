      468   procedure expense-payoff-permitted:
      469   case p-mode:
      470     when '<открытие документа>':U then do:
      471       assign
      472       p-status_ = 'новый':U
      473       p-ask-message = "Открыть платеж(и)" + chr(10) +
      474                       "(отменить разрешение на погашение  и разрешить редактирование РАСХОДНОГО АПЗ)?"
      475       .
      476     end.
      477     when '<закрытие документа>':U then do:
      478       assign
      479       p-status_ = 'факт':U
      480       p-ask-message = "Закрыть платеж(и)" + chr(10) +
      481                       "(подтвердить факт погашения средств)?"
      482       .
      483     end.
      484     otherwise do:
      485       return error substitute ('Недопустима операция &1 для платежа с атрибутами тип-статус &2-&3.', p-mode, p-fin-doc-type, p-status-current).
      486     end.
      487   end case.
      488   end procedure.
