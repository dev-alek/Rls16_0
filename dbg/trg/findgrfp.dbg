        1   block-level on error undo, throw.
        2   define input  parameter p-parent-handle     as handle no-undo .
        3   define input  parameter p-fin-doc-type      like ub.fin-doc.fin-doc-type     no-undo .
        4   define input  parameter p-fin-ext-doc-type  like ub.fin-doc.fin-ext-doc-type no-undo .
        5   define input  parameter p-status-current    like ub.fin-doc.status_          no-undo .
        6   define input  parameter p-mode              as   character                   no-undo .
        7   define input  parameter p-author            as   character                   no-undo .
        8   define input  parameter p-status-date       like ub.fin-doc.fact-date        no-undo .
        9   define output parameter p-status_           like ub.fin-doc.status_          no-undo .
       10   define output parameter p-ask-date          as logical                       no-undo .
       11   define output parameter p-ask-message       as character                     no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Стандартный граф переходов финансовых документов по параметрам".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   do on error undo, return error return-value :
       78     CASE p-fin-doc-type:
       79       when 'пко':U then do:
       80         CASE P-status-current:
       81           when 'новый':U then do:
       82              run income-cash-new             .
       83           end.
       84           when 'разрешен':U then do:
       85              run income-cash-permitted       .
       86           end.
       87           when 'банк':U then do:
       88              return error substitute ("Недопустимый тип-статус &1-&2.", p-fin-doc-type, p-status-current).
       89           end.
       90         END CASE.
       91       end.
       92       when 'ппп':U then do:
       93         CASE P-status-current:
       94           when 'новый':U then do:
       95              run income-cashless-new             .
       96           end.
       97           when 'разрешен':U then do:
       98              run income-cashless-permitted       .
       99           end.
      100           when 'банк':U then do:
      101              run income-cashless-bank       .
      102           end.
      103         END CASE.
      104       end.
      105       when 'апп':U then do:
      106         CASE P-status-current:
      107           when 'новый':U then do:
      108              run income-payoff-new             .
      109           end.
      110           when 'разрешен':U then do:
      111              run income-payoff-permitted       .
      112           end.
      113           when 'банк':U then do:
      114              return error substitute ("Недопустимый тип-статус &1-&2.", p-fin-doc-type, p-status-current).
      115           end.
      116         END CASE.
      117       end.
      118       when 'рко':U then do:
      119         CASE P-status-current:
      120           when 'новый':U then do:
      121              run expense-cash-new             .
      122           end.
      123           when 'разрешен':U then do:
      124              run expense-cash-permitted       .
      125           end.
      126           when 'банк':U then do:
      127              return error substitute ("Недопустимый тип-статус &1-&2.", p-fin-doc-type, p-status-current).
      128           end.
      129         END CASE.
      130       end.
      131       when 'рпп':U then do:
      132         CASE P-status-current:
      133           when 'новый':U then do:
      134              run expense-cashless-new             .
      135           end.
      136           when 'разрешен':U then do:
      137              run expense-cashless-permitted       .
      138           end.
      139           when 'банк':U then do:
      140               run expense-cashless-bank       .
      141           end.
      142           when 'отказ':U then do:
      143               run expense-cashless-rejected       .
      144           end.
      145         END CASE.
      146       end.
      147       when 'апр':U then do:
      148         CASE P-status-current:
      149           when 'новый':U then do:
      150              run expense-payoff-new             .
      151           end.
      152           when 'разрешен':U then do:
      153              run expense-payoff-permitted       .
      154           end.
      155           when 'банк':U then do:
      156              return error substitute ("Недопустимый тип-статус &1-&2.", p-fin-doc-type, p-status-current).
      157           end.
      158         END CASE.
      159       end.
      160     END CASE.
      161   END.
      162   procedure income-cash-new :
      163   case p-mode:
      164     when '<открытие документа>':U then do:
      165       return error substitute ('Платеж открыт.').
      166     end.
      167     when '<закрытие документа>':U then do:
      168        assign
      169        p-status_ = 'разрешен':U
      170        p-ask-message = "Закрыть платеж(и)" + chr(10) +
      171                        "(закончить редактирование ПРИХОДНОГО КАССОВОГО ОРДЕРА и разрешить прием наличных средств)?"
      172        .
      173     end.
      174     otherwise do:
      175       return error substitute ('Недопустима операция &1 для платежа с атрибутами тип-статус &2-&3.', p-mode, p-fin-doc-type, p-status-current).
      176     end.
      177   end case.
      178   end procedure.
      179   procedure income-cash-permitted:
      180   case p-mode:
      181     when '<открытие документа>':U then do:
      182       assign
      183       p-status_ = 'новый':U
      184       p-ask-message = "Открыть платеж(и)" + chr(10) +
      185                       "(отменить разрешение на прием наличных средств  и разрешить редактирование ПРИХОДНОГО КАССОВОГО ОРДЕРА)?"
      186       .
      187     end.
      188     when '<закрытие документа>':U then do:
      189       assign
      190       p-status_ = 'факт':U
      191       p-ask-message = "Закрыть платеж(и)" + chr(10) +
      192                       "(подтвердить факт приема наличных средств)?"
      193       .
      194     end.
      195     otherwise do:
      196       return error substitute ('Недопустима операция &1 для платежа с атрибутами тип-статус &2-&3.', p-mode, p-fin-doc-type, p-status-current).
      197     end.
      198   end case.
      199   end procedure.
