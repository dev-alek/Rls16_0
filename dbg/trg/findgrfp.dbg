      365   procedure expense-cashless-bank:
      366   case p-mode:
      367     when '<открытие документа>':U then do:
      368       assign
      369       p-status_ = 'разрешен':U
      370       p-ask-message = "Открыть платеж(и)" + chr(10) +
      371                       "(отозвать РАСХОДНОЕ ПЛАТЕЖНОЕ ПОРУЧЕНИЕ из банка)?"
