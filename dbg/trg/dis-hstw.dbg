        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.dis-host OLD oldb .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись итогов по диcконтной карте  на фирме".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2':u,ub.dis-host.d-card,ub.dis-host.dt-code,ub.dis-host.host-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable for-saldo-rubl as decimal no-undo.
       82   define variable for-saldo-base as decimal no-undo.
       83   define variable l-is-updated-saldo as logical no-undo .
       84   define temp-table tt-dis-host no-undo like ub.dis-host.
       85   main-block:
       86   do
       87   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status:get-message (1) )
       88   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       89   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       90   :
       91     if g#db-num = 0 then do:
       92       define variable v-curr-r-b as character no-undo .
       93   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$".
       94   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
       95     (output v-curr-r-b
       96     )  .
       97       if ub.dis-host.host-code > 0
       98       and ub.dis-host.dt-code = 0
       99       then do:
      100         buffer-compare oldb to ub.dis-host
      101         case-sensitive
      102         save result in l-is-updated-saldo.
      103         if l-is-updated-saldo <> yes then do:
      104           assign
      105             for-saldo-rubl = ub.dis-host.pay-tot-rubl - (ub.dis-host.gds-tot-rubl - ub.dis-host.gds-dis-rubl )
      106             for-saldo-base = ub.dis-host.pay-tot-base - (ub.dis-host.gds-tot-base - ub.dis-host.gds-dis-base )
      107           .
      108           find first ub.dis-card
      109             where ub.dis-card.d-card = ub.dis-host.d-card
      110             no-error .
      111           if not available ub.dis-card then do:
      112             undo main-block, return error substitute( "&1. &2&3&4Не найдена дисконтная карта с номером &5"
      113                                                      , vss-workfile
      114                                                      , vss-revision
      115                                                      , vss-description
      116                                                      , chr(10)
      117                                                      , ub.dis-host.d-card).
      118           end.
      119           if (
      120               (v-curr-r-b = 'base':U and (for-saldo-base) < ( -0.001))
      121               OR
      122               (v-curr-r-b = 'rubl':U and (for-saldo-rubl) < ( -0.001))
      123               )
      124           and (not ub.dis-card.credit-card
      125               or ub.dis-card.emitent-host-code = 0
      126               )
      127           then do:
      128             if ub.dis-card.emitent-host-code = 0
      129             then do:
      130               undo main-block, return error substitute( "&1. &2&3&4Не может быть отрицательного сальдо на глобальной дисконтной карте &5"
      131                                                       , vss-workfile
      132                                                       , vss-revision
      133                                                       , vss-description
      134                                                       , chr(10)
      135                                                       , ub.dis-host.d-card).
      136             end.
      137           end.
      138           assign
      139           ub.dis-card.saldo-rubl = for-saldo-rubl
      140           ub.dis-card.saldo-base = for-saldo-base
      141           .
      142         end.
      143       end.
      144     end.
      145     if g#oxml = yes
      146     then do:
      147       run str/calloxml.p (
      148             input 'update':U
      149           , input 'dis-host':U
      150           , input ( buffer ub.dis-host:handle )
      151       ) no-error.
      152       if error-status :error
      153       then do:
      154           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      155                                , chr(10)
      156                                , vss-workfile
      157                                , return-value
      158                                , error-status :get-message ( 1 ) ).
      159       end.
      160       end.
      161   end.
