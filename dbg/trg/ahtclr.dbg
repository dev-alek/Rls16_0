      770   define variable v-export-archive as logical   no-undo .
      771   define variable v-action         as character no-undo .
      772   define stream slog .
      773   main-block:
      774   do
      775   on error undo main-block, return error
      776   :
      777     if  v-export-file-name <> ""
      778     and v-export-file-name <> ?
      779     then do:
      780       assign
      781         v-export-archive = true
      782         v-action         = "Экспорт складского архива по типам приобретения"
      783       .
      784     end.
      785     else do:
      786       assign
      787         v-export-archive = false
      788         v-action         = "Очистка складского архива по типам приобретения"
      789       .
      790     end.
      791     define variable v-obj-type       like ub.gds-obj.obj-type no-undo .
      792     define variable v-obj-code       like ub.gds-obj.obj-code no-undo .
      793     define variable v-start-time     as integer   no-undo .
      794     define variable v-current-time   as character no-undo .
      795     define variable v-current-action as character no-undo .
      796     define variable v-count          as integer   no-undo .
      797     define variable v-sub-action     as character no-undo .
      798     def frame a
      799       v-obj-type       label "Объект"
      800       v-obj-code       no-label skip
      801       v-current-action format "x(40)" no-label skip
      802       v-current-time   format "x(8)"  label "Время очистки архива" skip
      803       v-count          format ">>>,>>>,>>9" no-label skip
      804       v-sub-action     format "x(40)" no-label skip
      805       with view-as dialog-box side-labels three-d
      806       title v-action
      807       .
      808     assign
      809       v-obj-type   = p-obj-type
      810       v-obj-code   = p-obj-code
      811       v-start-time = time
      812     .
      813     view frame a .
      814     display
      815       v-obj-type
      816       v-obj-code
      817       with frame a .
      818     if v-export-archive = true
      819     then do:
      820       output stream slog to value(v-export-file-name) append .
      821     end.
      822     define variable v-obj-exist as logical no-undo .
      823   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      825     (input  p-obj-type
      826     ,input  p-obj-code
      827     ,input  'check-exist':u
      828     ,output v-obj-exist
      829     )  .
      830     if p-cut-fact-order = ?
      831     then do:
      832       message
      833         vss-workfile vss-revision vss-description skip
      834         "Ошибка задания входных параметров" skip
      835         "Объект" p-obj-type p-obj-code skip
      836         "p-cut-fact-order" p-cut-fact-order skip
      837         view-as alert-box error .
      838       undo, return error .
      839     end.
      840     define variable v-max-fact-order as decimal   no-undo .
      841     run factord-max-fact-order in this-procedure
      842       (output v-max-fact-order
      843       ) .
      844     if p-cut-fact-order = 0
      845     then do:
      846       assign
      847         p-cut-fact-order = v-max-fact-order
      848       .
      849     end.
      850     define variable v-attr-value as character no-undo .
      851     define variable v-attr-type  as character no-undo .
      852     run clntattr-value in this-procedure
      853       (input  p-obj-type
      854       ,input  p-obj-code
      855       ,input  'aht-detail':U
      856       ,output v-attr-value
      857       ,output v-attr-type
      858       ) .
      859     define variable v-cut-date       as date    no-undo .
      860     define variable v-cut-fact-order as decimal no-undo .
      861     if v-attr-type = 'T':U
      862     then do:
      863       assign
      864         v-cut-date = date(v-attr-value)
      865       .
      866     end.
      867     else do:
      868       message
      869         vss-workfile vss-revision vss-description skip
      870         "Неправильный тип атрибута aht-start-date=request" skip
      871         view-as alert-box error .
      872       undo, return error .
      873     end.
      874     run day-begin-fact-order in this-procedure
      875       (input  v-cut-date
      876       ,output v-cut-fact-order
      877       ).
      878     if p-last-fact-order = ?
      879     then do:
      880       message
      881         vss-workfile vss-revision vss-description skip
      882         "Ошибка при задании входных параметров" skip
      883         "Не задана дата начиная с которой необходимо удалить складской архив по типам приобретения" skip
      884         "Объект" p-obj-type p-obj-code skip
      885         "v-cut-fact-order"  v-cut-fact-order skip
      886         "p-last-fact-order" p-last-fact-order skip
      887         view-as alert-box error .
      888       undo, return error .
      889     end.
      890     if v-export-archive = false
      891     then do:
      892       if  (v-cut-fact-order  <= p-last-fact-order
      893            and p-last-fact-order <= p-cut-fact-order )
      894       or  (p-last-fact-order <= p-cut-fact-order
      895            and p-cut-fact-order <= v-cut-fact-order
      896           )
      897       then do:
      898       end.
      899       else do:
      900         message
      901           vss-workfile vss-revision vss-description skip
      902           "Ошибка при удалении складского архива по типам приобретения" skip
      903           "Неправильный диапазон удаления складского архива по типам приобретения" skip
      904           "Объект" p-obj-type p-obj-code skip
      905           "v-cut-fact-order"  v-cut-fact-order skip
      906           "p-last-fact-order" p-last-fact-order skip
      907           "p-cut-fact-order" p-cut-fact-order skip
      908           view-as alert-box error .
      909         undo, return error .
      910       end.
      911     end.
      912     run clear-aht-doc in this-procedure no-error .
      913     if error-status :error
      914     then do:
      915       message
      916         vss-workfile vss-revision vss-description skip
      917         "Ошибка при вызове процедуры clear-aht-doc" skip
      918         "Объект" p-obj-type p-obj-code skip
      919         "Начальная дата очистки" p-last-fact-order skip
      920         "Конечная дата очистки" p-cut-fact-order skip
      921         "Имя файла" v-export-file-name skip
      922         view-as alert-box error .
      923       undo, return error .
      924     end.
      925     run clear-aht-ot-line in this-procedure no-error .
      926     if error-status :error
      927     then do:
      928       message
      929         vss-workfile vss-revision vss-description skip
      930         "Ошибка при вызове процедуры clear-aht-ot-line" skip
      931         "Объект" p-obj-type p-obj-code skip
      932         "Начальная дата очистки" p-last-fact-order skip
      933         "Конечная дата очистки" p-cut-fact-order skip
      934         "Имя файла" v-export-file-name skip
      935         view-as alert-box error .
      936       undo, return error .
      937     end.
      938     run clear-aht-ot-tot in this-procedure no-error .
      939     if error-status :error
      940     then do:
      941       message
      942         vss-workfile vss-revision vss-description skip
      943         "Ошибка при вызове процедуры clear-aht-ot-tot" skip
      944         "Объект" p-obj-type p-obj-code skip
      945         "Начальная дата очистки" p-last-fact-order skip
      946         "Конечная дата очистки" p-cut-fact-order skip
      947         "Имя файла" v-export-file-name skip
      948         view-as alert-box error .
      949       undo, return error .
      950     end.
      951     run clear-aht-stk in this-procedure no-error .
      952     if error-status :error
      953     then do:
      954       message
      955         vss-workfile vss-revision vss-description skip
      956         "Ошибка при вызове процедуры clear-aht-stk" skip
      957         "Объект" p-obj-type p-obj-code skip
      958         "Начальная дата очистки" p-last-fact-order skip
      959         "Конечная дата очистки" p-cut-fact-order skip
      960         "Имя файла" v-export-file-name skip
      961         view-as alert-box error .
      962       undo, return error .
      963     end.
      964     run clear-aht-stk-line in this-procedure no-error .
      965     if error-status :error
      966     then do:
      967       message
      968         vss-workfile vss-revision vss-description skip
      969         "Ошибка при вызове процедуры clear-aht-stk-line" skip
      970         "Объект" p-obj-type p-obj-code skip
      971         "Начальная дата очистки" p-last-fact-order skip
      972         "Конечная дата очистки" p-cut-fact-order skip
      973         "Имя файла" v-export-file-name skip
      974         view-as alert-box error .
      975       undo, return error .
      976     end.
      977     run clear-aht-stk-tot in this-procedure no-error .
      978     if error-status :error
      979     then do:
      980       message
      981         vss-workfile vss-revision vss-description skip
      982         "Ошибка при вызове процедуры clear-aht-stk-tot" skip
      983         "Объект" p-obj-type p-obj-code skip
      984         "Начальная дата очистки" p-last-fact-order skip
      985         "Конечная дата очистки" p-cut-fact-order skip
      986         "Имя файла" v-export-file-name skip
      987         view-as alert-box error .
      988       undo, return error .
      989     end.
      990     if v-export-archive = true
      991     then do:
      992       output stream slog close .
      993     end.
      994   end.
      995   procedure show-action :
      996     define input  parameter p-action as character no-undo .
      997     do
      998     on error undo, return error
      999     :
     1000       assign
     1001         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1002         v-current-action = p-action
     1003       .
     1004       display
     1005         v-current-time
     1006         v-current-action
     1007         with frame a.
     1008     end.
     1009   end procedure.
     1010   procedure show-count :
     1011     define input  parameter p-count      as integer   no-undo .
     1012     define input  parameter p-sub-action as character no-undo .
     1013     do
     1014     on error undo, return error
     1015     :
     1016       assign
     1017         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1018         v-count        = p-count
     1019         v-sub-action   = p-sub-action
     1020       .
     1021       display
     1022         v-current-time
     1023         v-count
     1024         v-sub-action
     1025         with frame a.
     1026     end.
     1027   end procedure.
     1028   procedure clear-aht-doc :
     1029     do
     1030     on error undo, return error return-value
     1031     :
     1032       define buffer buf_aht-doc for ub.aht-doc .
     1033       define variable v-ind as integer   no-undo .
     1034       run show-action in this-procedure
     1035         (input "Итоги по документам"
     1036         ).
     1037       for each buf_aht-doc
     1038         where buf_aht-doc.obj-type   = p-obj-type
     1039           and buf_aht-doc.obj-code   = p-obj-code
     1040           and buf_aht-doc.fact-order > p-last-fact-order
     1041           and buf_aht-doc.fact-order <= p-cut-fact-order
     1042       on error undo, return error
     1043       :
     1044         assign
     1045           v-ind = v-ind + 1
     1046         .
     1047         if v-ind modulo 10 = 0
     1048         then do:
     1049           run show-count in this-procedure
     1050             (input v-ind
     1051             ,input "Документ " + string(buf_aht-doc.doc-code)
     1052             ).
     1053         end.
     1054         if v-export-archive = true
     1055         then do:
     1056           export stream slog 'aht-doc':U .
     1057           export stream slog buf_aht-doc .
     1058         end.
     1059         else do:
     1060           delete buf_aht-doc .
     1061         end.
     1062       end.
     1063     end.
     1064   end procedure.
