        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-delivery-subject.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись в таблице ИСТОРИЯ СУБЪЕКТОВ ДОСТАВКИ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3'
       29                           , ub.c-delivery-subject.deliv-subj-code
       30                           , ub.c-delivery-subject.corr-user-db-num
       31                           , ub.c-delivery-subject.chip-num
       32                                                            )
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define buffer buf_delivery-subject for ub.delivery-subject.
       86   main-block:
       87   do
       88   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       89   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       90   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       91   :
       92     if not g#news then do:
       93       find first buf_delivery-subject no-lock where
       94                  buf_delivery-subject.deliv-subj-code = c-delivery-subject.deliv-subj-code  no-error .
       95       if not available buf_delivery-subject then do:
       96         message
       97         vss-workfile vss-revision vss-description skip
       98         "Неправильная ссылка на ТИП ДОСТАВКИ" skip
       99         "код" c-delivery-subject.deliv-subj-code skip
      100          view-as alert-box error .
      101         undo main-block, return error.
      102       end.
      103     end.
      104     if not g#news then do:
      105       if ( g#db-num > 0 ) then do:
      106         message
      107         vss-workfile vss-revision vss-description skip
      108         "Нельзя создавать записи истории СУБЪЕКТОВ ДОСТАВКИ в УБД" skip
      109         view-as alert-box error .
      110         undo main-block, return error.
      111       end.
      112     end.
      113     run str/callnews.p
      114       (input "c-delivery-subject"
      115       ,input (buffer ub.c-delivery-subject:handle)
      116       ).
      117       if g#oxml = yes
      118       then do:
      119       run str/calloxml.p (
      120             input 'update':U
      121           , input 'c-delivery-subject':U
      122           , input ( buffer ub.c-delivery-subject:handle )
      123       ) no-error.
      124       if error-status :error
      125       then do:
      126           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      127                                , chr(10)
      128                                , vss-workfile
      129                                , return-value
      130                                , error-status :get-message ( 1 ) ).
      131       end.
      132       end.
      133   end.
