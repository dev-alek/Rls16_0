        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.thbj-attr OLD oldthbj-attr.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись пар-ров объекта TH".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2'
       29                            , ub.thbj-attr.obj-type
       30                            , ub.thbj-attr.obj-code
       31                            , ub.thbj-attr.upper-prop-code
       32                            , ub.thbj-attr.prop-code
       33                            )
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure cur-time :
       88      define output parameter p-today as date      no-undo .
       89      define output parameter p-time  as integer   no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       define variable v-date1 as date      no-undo .
       94       define variable v-date2 as date      no-undo .
       95       define variable v-time  as integer   no-undo .
       96       assign
       97         v-date1 = today
       98         v-time  = time
       99         v-date2 = today
      100       .
      101       if v-date1 <> v-date2
      102       then do:
      103         assign
      104           v-date1 = today
      105           v-time  = v-time
      106         .
      107       end.
      108       assign
      109         p-today = v-date1
      110         p-time  = v-time
      111       .
      112     end.
      113   end.
      114   function cur-time-date returns character
      115   :
      116     return string(today, '99/99/9999':U) .
      117   end.
      118   function cur-time-mjd returns decimal
      119   :
      120     define variable v-date as date      no-undo .
      121     define variable v-time as integer   no-undo .
      122     run cur-time in this-procedure
      123       (output v-date
      124       ,output v-time
      125       ) .
      126     return integer(v-date) - 2400002 + (v-time / 86400) .
      127   end.
      128   function cur-time-get-ending-index returns integer
      129   (input p-number as integer
      130   )
      131   :
      132     if p-number < 0
      133     or p-number = ?
      134     then do:
      135       return 1 .
      136     end.
      137     define variable v-rest as integer   no-undo .
      138     assign
      139       p-number = p-number modulo 100
      140     .
      141     if p-number < 20
      142     then do:
      143       assign
      144         v-rest = p-number
      145       .
      146     end.
      147     else do:
      148       assign
      149         v-rest = p-number modulo 10
      150       .
      151     end.
      152     case v-rest :
      153       when 1
      154       then do:
      155         return 2 .
      156       end.
      157       when 2 or
      158       when 3 or
      159       when 4
      160       then do:
      161         return 3 .
      162       end.
      163       otherwise do:
      164         return 1 .
      165       end.
      166     end case .
      167   end.
      168   procedure cur-time-mjd-to-date :
      169      define input  parameter i-mjd-diff as decimal no-undo.
      170      define output parameter o-Date     as date    no-undo.
      171      define output parameter o-Time     as integer no-undo.
      172      define variable v-day-number as integer   no-undo .
      173      if    i-mjd-diff < 0
      174         or i-mjd-diff = ?
      175      then do:
      176         return "?" .
      177      end.
      178      assign
      179         v-day-number = truncate(i-mjd-diff,0).
      180         o-Date = date(v-day-number + 2400002).
      181         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      182     .
      183   end.
      184   function cur-time-mjd-to-string returns character
      185   (input p-mjd-diff as decimal
      186   )
      187   :
      188     define variable v-day-number as integer   no-undo .
      189     define variable v-seconds    as integer   no-undo .
      190     define variable v-hour       as integer   no-undo .
      191     define variable v-min        as integer   no-undo .
      192     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      193     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      194     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      195     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      196     if p-mjd-diff < 0
      197     or p-mjd-diff = ?
      198     then do:
      199       return "?" .
      200     end.
      201     assign
      202       v-day-number = integer(truncate(p-mjd-diff,0))
      203       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205     if v-seconds > 86400
      206     then do:
      207       assign
      208         v-seconds = 86400 - 1
      209       .
      210     end.
      211     if v-seconds < 0
      212     then do:
      213       assign
      214         v-seconds = 0
      215       .
      216     end.
      217     assign
      218       v-hour = truncate(v-seconds / 3600, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 3600
      222     .
      223     assign
      224       v-min = truncate(v-seconds / 60, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 60
      228     .
      229     return
      230         (if v-day-number <> 0
      231           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0
      235           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      239           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      240           else ""
      241         )
      242       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      243       .
      244   end.
      245   function cur-time-string returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-string-sec returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      264   end.
      265   function cur-time-custom  returns character
      266   (input p-prefix as character
      267   ,input p-date-format as character
      268   ,input p-delimiter as character
      269   ,input p-time-format as character
      270   ,input p-suffix as character
      271   )
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return
      280       p-prefix
      281       + string(v-date, p-date-format)
      282       + p-delimiter
      283       + string(v-time, p-time-format)
      284       + p-suffix
      285       .
      286   end.
      287   function cur-time-print  returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-datetime returns datetime
      298   :
      299     define variable v-char as character no-undo .
      300     define variable v-datetime as datetime no-undo .
      301     v-char = cur-time-string().
      302     v-datetime = datetime(v-char).
      303     return  v-datetime.
      304   end.
      305   function cur-time-string-msec returns character
      306   :
      307     define variable v-date as datetime  no-undo .
      308     v-date = now.
      309     return string(v-date) .
      310   end.
      311   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   define new global shared variable g#lib-nws as handle no-undo .
      313   define variable v-date as date no-undo .
      314   define variable v-time as integer no-undo .
      315   define variable v-host-code like ub.sysconf.host-code no-undo .
      316   define buffer buf_c-thbj-attr for ub.c-thbj-attr.
      317   define buffer buf_c-cli-hist for ub.c-cli-hist.
      318   main-block:
      319   do
      320   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      321   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      322   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      323   :
      324    if not g#news then do:
      325      if (ub.thbj-attr.obj-type = 'орг':U
      326      or ub.thbj-attr.obj-type = '':U
      327      or (ub.thbj-attr.obj-type = 'БД':U and  g#db-num <>  ub.thbj-attr.obj-code)
      328      )
      329      and g#db-num > 0 then do:
      330        message
      331        vss-workfile vss-revision vss-description skip
      332        "Запрещено создавать/изменять параметры объектов TH в УБД"
      333        substitute("Параметр &1 &2 тип объекта &3 код объекта &4"
      334                    , ub.thbj-attr.upper-prop-code
      335                    , ub.thbj-attr.prop-code
      336                    , ub.thbj-attr.obj-code
      337                    , ub.thbj-attr.obj-type
      338                    )
      339        view-as alert-box error .
      340      end.
      341    end.
      342    run str/callnews.p
      343       ( input 'thbj-attr':U
      344         ,input (buffer ub.thbj-attr:handle)
      345       ) .
      346    if g#news then do:
      347       define variable v-send as integer no-undo .
      348       v-send = integer('0':U).
      349   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      351     (input  g#db-num
      352     ,input  'thbj-attr':U
      353     ,input  0
      354     ,input  '':U
      355     ,input  0
      356     ,input  '':U
      357     ,input  '':U
      358     ,input  '':U
      359     ,input  0
      360     ,input  0
      361     ,input  0
      362     ,input  'nws-to-hist'
      363     ,output v-send
      364     ) no-error .
      365     end.
      366     if not g#news
      367     or v-send >= 0 then do:
      368       run cur-time in this-procedure ( output v-date, output v-time).
      369       create buf_c-thbj-attr.
      370       buffer-copy oldthbj-attr to buf_c-thbj-attr
      371       assign
      372       buf_c-thbj-attr.obj-type           = ub.thbj-attr.obj-type
      373       buf_c-thbj-attr.obj-code           = ub.thbj-attr.obj-code
      374       buf_c-thbj-attr.upper-prop-code    = ub.thbj-attr.upper-prop-code
      375       buf_c-thbj-attr.prop-code          = ub.thbj-attr.prop-code
      376       buf_c-thbj-attr.chip-num           = next-value (s-cli-chip, ub)
      377       buf_c-thbj-attr.corr-time          = v-time
      378       buf_c-thbj-attr.corr-user-db-num   = g#db-num
      379       buf_c-thbj-attr.corr-user-name     = (if g#news
      380                                         then (chr(4) +  'СПН':U)
      381                                         else (if g#esys
      382                                               then (chr(4) +  'ВС':U)
      383                                               else g#userid)
      384                                         )
      385       buf_c-thbj-attr.corr-date          = v-date
      386       buf_c-thbj-attr.action = (if new (ub.thbj-attr )
      387                               then integer('1':U)
      388                               else integer('2':U))
      389       buf_c-thbj-attr.subject = 'thbj-attr':U
      390       .
      391       if ub.thbj-attr.obj-type = 'маг':U
      392       or ub.thbj-attr.obj-type = 'скл':U then do:
      393   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      395     (input  ub.thbj-attr.obj-type
      396     ,input  ub.thbj-attr.obj-code
      397     ,output v-host-code
      398     )  .
      399       end.
      400       create buf_c-cli-hist.
      401       buffer-copy buf_c-thbj-attr to buf_c-cli-hist
      402       assign
      403       buf_c-cli-hist.action = (if new (ub.thbj-attr )
      404                               then integer('1':U)
      405                               else integer('2':U))
      406       buf_c-cli-hist.subject = 'thbj-attr':U
      407       buf_c-cli-hist.host-code = v-host-code
      408       buf_c-cli-hist.is-news = g#news
      409       buf_c-cli-hist.source-type = (if g#news then 'db':U else "":U)
      410       buf_c-cli-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      411       .
      412       if ub.thbj-attr.upper-prop-code = 'marking':U and
      413          ub.thbj-attr.prop-code = 'ban-recipes':U and
      414          ub.thbj-attr.property-value-logical = true then do:
      415             if buf_c-thbj-attr.property-value-logical <> ub.thbj-attr.property-value-logical then
      416   define buffer buf_PromoAction for ub.PromoAction .
      417   define buffer buf_PromoGoods  for ub.PromoGoods .
      418   define buffer buf_PromoGift   for ub.PromoGift .
      419   define buffer buf_goods-attr  for ub.goods-attr .
      420   define buffer buf_clients     for ub.clients .
      421   for each buf_PromoGift no-lock:
      422      if can-find (first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_PromoGift.gds-code and
      423         buf_goods-attr.attr-code = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" and
      424         buf_goods-attr.attr-value <> "") then
      425      do:
      426         find first buf_PromoAction exclusive-lock where buf_PromoAction.id = buf_PromoGift.idaction and
      427            buf_PromoAction.db-num = buf_PromoGift.db-num and buf_PromoAction.end-date >= today no-error .
      428         if available (buf_PromoAction) then
      429         do:
      430            buf_PromoAction.end-date = today - 1 .
      431            buf_PromoAction.Status_ = 1 .
      432       find first buf_clients no-lock
      433            where buf_clients.db-num   = buf_PromoAction.db-num
      434              and buf_clients.obj-type = 'маг':U no-error .
      435       if available (buf_clients) then do:
      436           run str/diallog.w (
      437           input this-procedure
      438         , input this-procedure
      439         , input "str/promosendoxml.p":U  + chr(4) +
      440                   "1":U  + chr(4) +
      441                   "1":U + chr(4) +
      442                   "1":U
      443         , input ('IBM-XML':U + chr(4) + buf_clients.obj-type + chr(4) + string(buf_clients.obj-code) + chr(4) + "U":U + chr(4) + string(buf_clients.db-num) + chr(4) + string(buf_PromoAction.id))
      444         , input yes
      445         , input "":U
      446         , input substitute("Отсылка промоакций на кассы &1", 'IBM-XML':U)
      447     ) no-error.
      448     end.
      449         end.
      450      end.
      451   end.
      452     .
      453       end.
      454     end.
      455     if g#oxml = yes
      456     then do:
      457       run str/calloxml.p (
      458             input 'update':U
      459           , input 'thbj-attr':U
      460           , input ( buffer ub.thbj-attr:handle )
      461       ) no-error.
      462       if error-status :error
      463       then do:
      464           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      465                                , chr(10)
      466                                , vss-workfile
      467                                , return-value
      468                                , error-status :get-message ( 1 ) ).
      469       end.
      470     end.
      471   end.
