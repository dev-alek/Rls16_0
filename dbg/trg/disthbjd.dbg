        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-thbj-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление истории скидок по объектам".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                           ,  ub.dis-thbj-rule.obj-type
       30                           ,  ub.dis-thbj-rule.obj-code
       31                           ,  ub.dis-thbj-rule.pos-type
       32                           ,  ub.dis-thbj-rule.discnt-role
       33                           ,  ub.dis-thbj-rule.nonunique
       34                           )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   define new global shared variable g#lib-nws as handle no-undo .
      314   define variable v-host-code as integer no-undo .
      315   define variable v-date as date no-undo .
      316   define variable v-time as integer no-undo .
      317   define variable v-obj-db-num as integer no-undo .
      318   define variable v-obj-type as character no-undo .
      319   define variable v-obj-code as integer no-undo .
      320   define buffer buf_c-dis-thbj-rule for ub.c-dis-thbj-rule.
      321   define buffer buf_c-cli-hist for ub.c-cli-hist.
      322   main-block:
      323   do
      324   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      325   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      326   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      327   :
      328     if not g#news
      329     and g#db-num > 0
      330     and (
      331         ub.dis-thbj-rule.obj-type  = '':U
      332         or
      333         ub.dis-thbj-rule.obj-code = 0
      334         or
      335         ub.dis-thbj-rule.host-code  = 0
      336         ) then do:
      337       message
      338       vss-workfile vss-revision vss-description skip
      339       substitute("&1&2 POS &3 тип скидки &4&5" +
      340                  "Нельзя удалять запись СКИДОК ПО ОБЪЕКТАМ в УБД"
      341                  ,ub.dis-thbj-rule.obj-type
      342                  ,ub.dis-thbj-rule.obj-code
      343                  ,ub.dis-thbj-rule.pos-type
      344                  ,ub.dis-thbj-rule.discnt-role)
      345       view-as alert-box error .
      346       undo main-block, return error .
      347     end.
      348     if ub.dis-thbj-rule.obj-type = 'маг':U
      349     or ub.dis-thbj-rule.obj-type = 'скл':U then do:
      350   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      352     (input  ub.dis-thbj-rule.obj-type
      353     ,input  ub.dis-thbj-rule.obj-code
      354     ,output v-obj-db-num
      355     )  .
      356       if v-obj-db-num <> g#db-num
      357       and g#db-num <> 0
      358       and not g#news
      359       then do:
      360         message
      361         vss-workfile vss-revision vss-description skip
      362         substitute("&1&2 POS &3 тип скидки &4&5" +
      363                   "Нельзя удалять запись СКИДОК ПО ОБЪЕКТАМ в чужой БД"
      364                  ,ub.dis-thbj-rule.obj-type
      365                  ,ub.dis-thbj-rule.obj-code
      366                  ,ub.dis-thbj-rule.pos-type
      367                  ,ub.dis-thbj-rule.discnt-role)
      368         view-as alert-box error .
      369         undo main-block, return error .
      370       end.
      371     end.
      372     if g#news then do:
      373       define variable v-send as integer no-undo .
      374       v-send = integer('0':U).
      375   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      377     (input  g#db-num
      378     ,input  'dis-thbj-rule':U
      379     ,input  0
      380     ,input  '':U
      381     ,input  0
      382     ,input  '':U
      383     ,input  '':U
      384     ,input  '':U
      385     ,input  0
      386     ,input  0
      387     ,input  0
      388     ,input  'nws-to-hist'
      389     ,output v-send
      390     ) no-error .
      391     end.
      392     if not g#news
      393     or v-send >= 0 then do:
      394       run cur-time in this-procedure(output v-date, output v-time).
      395       create buf_c-dis-thbj-rule.
      396       buffer-copy ub.dis-thbj-rule
      397       to buf_c-dis-thbj-rule
      398       assign
      399       buf_c-dis-thbj-rule.chip-num           = next-value (s-cli-chip, ub)
      400       buf_c-dis-thbj-rule.corr-time          = v-time
      401       buf_c-dis-thbj-rule.corr-user-db-num   = g#db-num
      402       buf_c-dis-thbj-rule.corr-user-name     = (if g#news
      403                                                 then (chr(4) +  'СПН':U)
      404                                                 else (if g#esys
      405                                                       then (chr(4) +  'ВС':U)
      406                                                       else g#userid
      407                                                       )
      408                                                 )
      409       buf_c-dis-thbj-rule.corr-date          = v-date
      410       .
      411       if not (ub.dis-thbj-rule.obj-type = '':U
      412              and
      413              ub.dis-thbj-rule.obj-code = 0
      414              and
      415              ub.dis-thbj-rule.host-code = 0) then do:
      416         if ub.dis-thbj-rule.obj-type = 'маг':U
      417         or ub.dis-thbj-rule.obj-type = 'скл':U then do:
      418   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      420     (input  ub.dis-thbj-rule.obj-type
      421     ,input  ub.dis-thbj-rule.obj-code
      422     ,output v-host-code
      423     )  .
      424           assign
      425           v-obj-type = ub.dis-thbj-rule.obj-type
      426           v-obj-code = ub.dis-thbj-rule.obj-code
      427           .
      428         end.
      429         if ub.dis-thbj-rule.obj-type = 'орг':U then do:
      430           assign
      431           v-obj-type = 'орг':U
      432           v-obj-code = ub.dis-thbj-rule.host-code
      433           v-host-code = ub.dis-thbj-rule.obj-code
      434           .
      435         end.
      436         create buf_c-cli-hist.
      437         buffer-copy ub.dis-thbj-rule to buf_c-cli-hist
      438         assign
      439         buf_c-cli-hist.action = integer('99':U)
      440         buf_c-cli-hist.subject = 'dis-thbj-rule':U
      441         buf_c-cli-hist.chip-num       = buf_c-dis-thbj-rule.chip-num
      442         buf_c-cli-hist.corr-time      = buf_c-dis-thbj-rule.corr-time
      443         buf_c-cli-hist.corr-user-db-num   = buf_c-dis-thbj-rule.corr-user-db-num
      444         buf_c-cli-hist.corr-user-name     = buf_c-dis-thbj-rule.corr-user-name
      445         buf_c-dis-thbj-rule.corr-date     = buf_c-dis-thbj-rule.corr-date
      446         buf_c-cli-hist.host-code = v-host-code
      447         buf_c-cli-hist.obj-type = v-obj-type
      448         buf_c-cli-hist.obj-code = v-obj-code
      449         buf_c-cli-hist.is-news = g#news
      450         buf_c-cli-hist.source-type = (if g#news
      451                                       then 'db':U
      452                                       else (if g#esys
      453                                             then 'esys':U
      454                                             else "":U)
      455                                       )
      456         buf_c-cli-hist.source-ref = (if g#news
      457                                     then string(g#news-source-db)
      458                                     else (if g#esys
      459                                           then string(g#esys-source-esys)
      460                                           else "":U)
      461                                     )
      462         .
      463       end.
      464     end.
      465     run nws/cmd-del.p
      466       ( input 'dis-thbj-rule':U
      467         ,input (buffer ub.dis-thbj-rule:handle)
      468         ,input "":U
      469       ) no-error .
      470     if error-status :error then do:
      471       return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      472     end.
      473     if g#oxml = yes
      474     then do:
      475       run str/calloxml.p (
      476             input 'delete':U
      477           , input 'dis-thbj-rule':U
      478           , input ( buffer ub.dis-thbj-rule:handle )
      479       ) no-error.
      480       if error-status :error
      481       then do:
      482           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      483                                , chr(10)
      484                                , vss-workfile
      485                                , return-value
      486                                , error-status :get-message ( 1 ) ).
      487       end.
      488     end.
      489   end.
