        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code   as character no-undo .
        3   define input  parameter p-fact-date  as date      no-undo .
        4   define input  parameter p-action     as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Создать запись о том, что необходимо пересчитать межфирменные архивы".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2|&3',p-doc-code,p-fact-date,p-action)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure cur-time :
       85      define output parameter p-today as date      no-undo .
       86      define output parameter p-time  as integer   no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       define variable v-date1 as date      no-undo .
       91       define variable v-date2 as date      no-undo .
       92       define variable v-time  as integer   no-undo .
       93       assign
       94         v-date1 = today
       95         v-time  = time
       96         v-date2 = today
       97       .
       98       if v-date1 <> v-date2
       99       then do:
      100         assign
      101           v-date1 = today
      102           v-time  = v-time
      103         .
      104       end.
      105       assign
      106         p-today = v-date1
      107         p-time  = v-time
      108       .
      109     end.
      110   end.
      111   function cur-time-date returns character
      112   :
      113     return string(today, '99/99/9999':U) .
      114   end.
      115   function cur-time-mjd returns decimal
      116   :
      117     define variable v-date as date      no-undo .
      118     define variable v-time as integer   no-undo .
      119     run cur-time in this-procedure
      120       (output v-date
      121       ,output v-time
      122       ) .
      123     return integer(v-date) - 2400002 + (v-time / 86400) .
      124   end.
      125   function cur-time-get-ending-index returns integer
      126   (input p-number as integer
      127   )
      128   :
      129     if p-number < 0
      130     or p-number = ?
      131     then do:
      132       return 1 .
      133     end.
      134     define variable v-rest as integer   no-undo .
      135     assign
      136       p-number = p-number modulo 100
      137     .
      138     if p-number < 20
      139     then do:
      140       assign
      141         v-rest = p-number
      142       .
      143     end.
      144     else do:
      145       assign
      146         v-rest = p-number modulo 10
      147       .
      148     end.
      149     case v-rest :
      150       when 1
      151       then do:
      152         return 2 .
      153       end.
      154       when 2 or
      155       when 3 or
      156       when 4
      157       then do:
      158         return 3 .
      159       end.
      160       otherwise do:
      161         return 1 .
      162       end.
      163     end case .
      164   end.
      165   procedure cur-time-mjd-to-date :
      166      define input  parameter i-mjd-diff as decimal no-undo.
      167      define output parameter o-Date     as date    no-undo.
      168      define output parameter o-Time     as integer no-undo.
      169      define variable v-day-number as integer   no-undo .
      170      if    i-mjd-diff < 0
      171         or i-mjd-diff = ?
      172      then do:
      173         return "?" .
      174      end.
      175      assign
      176         v-day-number = truncate(i-mjd-diff,0).
      177         o-Date = date(v-day-number + 2400002).
      178         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      179     .
      180   end.
      181   function cur-time-mjd-to-string returns character
      182   (input p-mjd-diff as decimal
      183   )
      184   :
      185     define variable v-day-number as integer   no-undo .
      186     define variable v-seconds    as integer   no-undo .
      187     define variable v-hour       as integer   no-undo .
      188     define variable v-min        as integer   no-undo .
      189     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      190     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      191     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      192     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      193     if p-mjd-diff < 0
      194     or p-mjd-diff = ?
      195     then do:
      196       return "?" .
      197     end.
      198     assign
      199       v-day-number = integer(truncate(p-mjd-diff,0))
      200       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202     if v-seconds > 86400
      203     then do:
      204       assign
      205         v-seconds = 86400 - 1
      206       .
      207     end.
      208     if v-seconds < 0
      209     then do:
      210       assign
      211         v-seconds = 0
      212       .
      213     end.
      214     assign
      215       v-hour = truncate(v-seconds / 3600, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 3600
      219     .
      220     assign
      221       v-min = truncate(v-seconds / 60, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 60
      225     .
      226     return
      227         (if v-day-number <> 0
      228           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0
      232           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      236           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      237           else ""
      238         )
      239       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      240       .
      241   end.
      242   function cur-time-string returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      251   end.
      252   function cur-time-string-sec returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      261   end.
      262   function cur-time-custom  returns character
      263   (input p-prefix as character
      264   ,input p-date-format as character
      265   ,input p-delimiter as character
      266   ,input p-time-format as character
      267   ,input p-suffix as character
      268   )
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return
      277       p-prefix
      278       + string(v-date, p-date-format)
      279       + p-delimiter
      280       + string(v-time, p-time-format)
      281       + p-suffix
      282       .
      283   end.
      284   function cur-time-print  returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-datetime returns datetime
      295   :
      296     define variable v-char as character no-undo .
      297     define variable v-datetime as datetime no-undo .
      298     v-char = cur-time-string().
      299     v-datetime = datetime(v-char).
      300     return  v-datetime.
      301   end.
      302   function cur-time-string-msec returns character
      303   :
      304     define variable v-date as datetime  no-undo .
      305     v-date = now.
      306     return string(v-date) .
      307   end.
      308   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   define variable v-waitfram-action01         as character   no-undo .
      310   define variable v-waitfram-action02         as character   no-undo .
      311   define variable v-waitfram-action03         as character   no-undo .
      312   define variable mWaitFramTextBeg            as character   no-undo.
      313   define variable mWaitFramTextEnd            as character   no-undo.
      314   define variable mWaitFramView               as logical     no-undo.
      315   define variable mWaitProcEvent              as logical     no-undo init yes.
      316   define variable mWaitFramInterval           as integer     no-undo init 1 .
      317   define variable mWaitFramStop               as logical     no-undo.
      318   define variable mWaitFramStopUser           as logical     no-undo.
      319   define variable mWaitFramStopTimeOut        as logical     no-undo.
      320   define variable mWaitFramStartProc          as datetime-tz no-undo.
      321   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      322   define button B-WaitFramStop auto-end-key
      323        label "Стоп"
      324        size 10 by 1 tooltip "Остоновить процесс".
      325   define button B-viewProcInfo
      326        label "Информация"
      327        size 15 by 1 tooltip "Информация о процесс".
      328   define frame waitfram
      329     v-waitfram-action01 format "x(72)" no-label skip
      330     v-waitfram-action02 format "x(72)" no-label skip
      331     v-waitfram-action03 format "x(72)" no-label skip
      332     B-viewProcInfo
      333     B-WaitFramStop at row 4 col 30
      334     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      335     .
      336   define new global shared variable mBatchMode as logical no-undo init ?.
      337   define variable mFramBachModHandle as handle no-undo.
      338   mFramBachModHandle = frame waitfram:handle.
      339   define variable mFameOldVis as logical no-undo.
      340   define variable mVisCUrentVin as logical no-undo.
      341   if session:batch-mode
      342   then
      343      mBatchMode = yes.
      344   if mBatchMode = ? then do:
      345     mVisCUrentVin = current-window:visible.
      346     mFameOldVis = mFramBachModHandle:visible.
      347     mFramBachModHandle:visible  = yes.
      348     mBatchMode = mFramBachModHandle:visible ne yes.
      349     mFramBachModHandle:visible = mFameOldVis.
      350     current-window:visible = mVisCUrentVin.
      351   end.
      352    if  log-manager:logfile-name ne ?
      353     then DO:
      354         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      355         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      356         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      357     end.
      358   on choose of B-WaitFramStop in frame waitfram
      359   do:
      360     mWaitFramStop = yes.
      361     mWaitFramStopUser = yes.
      362   end.
      363   function waitfram-check-timeout returns logical():
      364      define variable vtime as int64 no-undo.
      365      if mWaitFramStopTimeOut
      366      then
      367         return yes.
      368      vtime = ( now - mWaitFramStartProc ) / 1000 .
      369      if     mWaitFramTimeOut ne ?
      370         and mWaitFramTimeOut ne 0
      371         and mWaitFramTimeOut lt vtime
      372      then do:
      373         mWaitFramStopTimeOut = yes.
      374      end.
      375      return mWaitFramStopTimeOut.
      376   end.
      377   procedure waitfram-hide :
      378     if not session:batch-mode
      379     then do
      380     on error undo, return error return-value
      381     :
      382       pause 0 before-hide .
      383       if not mBatchMode then
      384         hide frame waitfram .
      385     if     not mWaitFramView
      386        and mWaitProcEvent
      387     then
      388       process events .
      389     end.
      390   end procedure.
      391   procedure waitfram-show :
      392     define input  parameter p-message as character no-undo .
      393     define variable v-left-margin as integer   no-undo .
      394     if not session:batch-mode
      395     then do
      396     on error undo, return error return-value
      397     :
      398       if length(p-message) <= 70 then do:
      399         assign
      400           v-left-margin = integer((70 - length(p-message)) / 2)
      401         .
      402         assign
      403           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      404         .
      405         assign
      406           v-waitfram-action01 = " "
      407           v-waitfram-action02 = " "
      408                                    + fill(" ", v-left-margin)
      409                                    + p-message
      410           v-waitfram-action03 = " "
      411         .
      412       end.
      413       else do:
      414         define variable vRindex1 as integer no-undo.
      415         define variable vRindex2 as integer no-undo.
      416         vRindex1 = r-index(p-message," ",70).
      417         if vRindex1 = 0
      418         then
      419            vRindex1 = 70.
      420         if length(p-message)  <= vRindex1 + 70 then do:
      421           assign
      422             v-waitfram-action01 = " "
      423             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      424             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      425           .
      426         end.
      427         else do:
      428           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      429           if vRindex2 <= vRindex1
      430           then
      431              vRindex2 = vRindex1 + 70.
      432           assign
      433             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      434             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      435             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      436           .
      437         end.
      438       end.
      439       B-viewProcInfo:visible   in frame waitfram = no.
      440       B-viewProcInfo:sensitive in frame waitfram = no.
      441       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      442       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      443       if  (   mWaitFramView
      444          or  mWaitProcEvent)
      445          and not mBatchMode
      446       then
      447          display
      448             v-waitfram-action01 skip
      449             v-waitfram-action02 skip
      450             v-waitfram-action03 skip
      451          with frame waitfram .
      452       if     mWaitFramView
      453          then do:
      454             if     mWaitFramInterval ne ?
      455                and not mBatchMode
      456             then
      457                wait-for go of frame waitfram pause mWaitFramInterval.
      458          end.
      459          else
      460             if     mWaitProcEvent
      461                and not mBatchMode
      462             then
      463                process events .
      464     end.
      465   end procedure.
      466      procedure waitfram-show-this:
      467         define input  parameter iInterval as int64 no-undo.
      468         define variable vtime as int64 no-undo.
      469         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      470         mWaitFramInterval = iInterval.
      471         run waitfram-show (substitute("&1&2 &3&4" ,
      472                                       mWaitFramTextBeg ,
      473                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      474                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      475                                       mWaitFramTextEnd
      476                                      )
      477                           ).
      478      end.
      479      procedure WaitFramRunPause:
      480         define input  parameter iInterval as dec no-undo.
      481         define variable vStart  as datetime-tz no-undo.
      482         define variable vend    as datetime-tz no-undo.
      483         define variable vint as int64 no-undo.
      484         define variable vOk as logical no-undo.
      485         vStart = now.
      486         vend   = vStart.
      487         publish "WaitFramPause" (iInterval,output vOk).
      488         vend   =  now.
      489         vint = vend - vStart.
      490         vint = iInterval - vint / 1000.
      491         if     not mWaitFramStop
      492            and (   vint > 0
      493                 or (    not vOk
      494                     and iInterval eq ?
      495                     )
      496                 )
      497         then
      498            run waitfram-show-this (iInterval).
      499         vend   =  now.
      500         vint = vend - vStart.
      501         vint = iInterval - vint / 1000.
      502         if     not mWaitFramStop
      503            and vint > 0
      504         then do:
      505            run gbl/pause.p (vint * 1000).
      506         end.
      507         if iInterval ne ?
      508         then
      509            publish "WaitFramStop".
      510         waitfram-check-timeout().
      511      end.
      512      procedure WaitFramWaitFor:
      513         define input  parameter iInterval as dec no-undo.
      514         assign
      515            mWaitFramStartProc   = now
      516            mWaitFramStopUser    = no
      517            mWaitFramStopTimeOut = no
      518         .
      519         block-wait:
      520         do while not mWaitFramStop:
      521            run WaitFramRunPause (iInterval).
      522            if  waitfram-check-timeout()
      523            then do:
      524               leave block-wait.
      525            end.
      526         end.
      527         run waitfram-hide.
      528      end.
      529   procedure waitfram-join :
      530     define input  parameter p-line-1  as character no-undo .
      531     define input  parameter p-line-2  as character no-undo .
      532     define input  parameter p-line-3  as character no-undo .
      533     define output parameter p-message as character no-undo .
      534     do
      535     on error undo, return error return-value
      536     :
      537       assign
      538         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      539                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      540                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      541       .
      542     end.
      543   end procedure.
      544   function waitfram-join-function returns character
      545     (input p-line-1 as character
      546     ,input p-line-2 as character
      547     ,input p-line-3 as character
      548     ).
      549     define variable v-message as character no-undo .
      550     run waitfram-join in this-procedure
      551       (input  p-line-1
      552       ,input  p-line-2
      553       ,input  p-line-3
      554       ,output v-message
      555       ) .
      556     return v-message .
      557   end function .
      558   do
      559   on error undo, return error return-value
      560   :
      561     if p-action = ?
      562     or lookup(p-action, 'doc-delete':u + chr(44) + 'doc-change':u) = 0
      563     then do:
      564       message
      565         vss-workfile vss-revision vss-description skip
      566         "Ошибка задания входных параметров" skip
      567         "Неизвестное действие" skip
      568         "Документ" p-doc-code skip
      569         "Действие" p-action skip
      570         view-as alert-box error .
      571       undo, return error return-value .
      572     end.
      573     run mark-hold in this-procedure
      574       (input 1
      575       ,input 'hold':U
      576       ,input 'hold':U
      577       ,input p-action
      578       ) .
      579     run mark-hold in this-procedure
      580       (input 2
      581       ,input 'hinv':U
      582       ,input 'hinv':U
      583       ,input p-action
      584       ) .
      585     run mark-hold in this-procedure
      586       (input 3
      587       ,input 'hspi':U
      588       ,input 'hspi':U
      589       ,input p-action
      590       ) .
      591   end.
      592   procedure mark-hold :
      593     define input  parameter p-cat-code       as integer   no-undo .
      594     define input  parameter p-lock-code      as character no-undo .
      595     define input  parameter p-btpr-type-code as character no-undo .
      596     define input  parameter p-action         as character no-undo .
      597   define variable v-need-stop-hold as logical   no-undo .
      598     do
      599     on error undo, return error substitute(" &1 &2" ,return-value, error-status:get-message(1) )
      600     :
      601       define buffer calc-hold-lock_batchprocess for ub.batchprocess .
      602       v-need-stop-hold = false .
      603       run gbl/lock-prc.p
      604         (input p-lock-code
      605         ,input p-cat-code
      606         ,input 0
      607         ,input 0
      608         ,input ""
      609         ,input ""
      610         ,input ""
      611         ,input "Категория,,,,,,Расчет межфирменных архивов"
      612         ,input true
      613         ,buffer calc-hold-lock_batchprocess
      614         ) no-error .
      615       if error-status :error then do:
      616             if error-status :get-message(1) <> "" then do:
      617             message
      618               vss-workfile vss-revision vss-description skip
      619               return-value skip
      620               error-status :get-message(1) skip
      621               "В данный момент рассчитываются межфирменные архивы" skip
      622               "Категория" p-cat-code skip
      623               "Невозможно пометить архивы как требующие перерасчета" skip
      624               view-as alert-box error .
      625             undo, return error .
      626           end.
      627           assign
      628             v-need-stop-hold = true
      629           .
      630     define buffer stop-hold-news-lock_btpr for batchprocess .
      631     if v-need-stop-hold = true
      632     then do:
      633       do transaction
      634       on error undo, return error return-value
      635       :
      636         create stop-hold-news-lock_btpr .
      637         assign
      638           stop-hold-news-lock_btpr.bp_type       = 'lock':U + 'hold'
      639           stop-hold-news-lock_btpr.bp_status     = 'N':U
      640           stop-hold-news-lock_btpr.Key#_One      = 0
      641           stop-hold-news-lock_btpr.Key#_Two      = 0
      642           stop-hold-news-lock_btpr.Key#_Three    = 0
      643           stop-hold-news-lock_btpr.CharKey_One   = ""
      644           stop-hold-news-lock_btpr.CharKey_Two   = p-doc-code
      645           stop-hold-news-lock_btpr.CharKey_Three = ""
      646         .
      647         define variable v-start-lock-time   as int64     no-undo .
      648         define variable v-start-lock-second as integer   no-undo .
      649         assign
      650           v-start-lock-time = etime
      651         .
      652         wait_block:
      653         do while true
      654         :
      655           assign
      656             v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
      657           .
      658           run waitfram-show in this-procedure
      659             (input waitfram-join-function("Архив по типам приобретения рассчитывается на другой машине"
      660                                           ,"Отправлено сообщение о необходимости остановки расчёта складского архива по типам приобретения"
      661                                           ,substitute("Ожидание освобождение ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
      662                                           )
      663             ) .
      664           run gbl/lock-prc.p
      665             (input p-lock-code
      666             ,input p-cat-code
      667             ,input 0
      668             ,input 0
      669             ,input ""
      670             ,input ""
      671             ,input ""
      672             ,input "Категория,,,,,,Расчет межфирменных архивов"
      673             ,input true
      674             ,buffer calc-hold-lock_batchprocess
      675             ) no-error .
      676           if error-status :error
      677           then do:
      678             if error-status :get-message(1) <> ""
      679             then do:
      680               message
      681                 vss-workfile vss-revision vss-description skip
      682                 "Ошибка при вызове процедуры блокировки расчета складского архива по типам приобретения" skip
      683                 error-status :get-message(1) skip
      684                 return-value skip
      685                 view-as alert-box error .
      686               undo, return error "В данный момент рассчитывается складской архив по типам приобретения" .
      687             end.
      688           end.
      689           else do:
      690             leave wait_block .
      691           end.
      692           pause 1 no-message .
      693         end.
      694         delete stop-hold-news-lock_btpr .
      695         run waitfram-hide in this-procedure .
      696       end.
      697     end.
      698     end.
      699     do transaction
      700     on error undo, return error return-value
      701     :
      702     find first ub.batchprocess exclusive-lock
      703       where ub.batchprocess.bp_type   = p-btpr-type-code
      704         and ub.batchprocess.bp_status = 'N':U
      705         and ub.batchprocess.charkey_one = p-doc-code
      706     no-error .
      707       if available ub.batchprocess then do:
      708         if p-action = 'doc-delete':u
      709         then do:
      710           delete ub.batchprocess .
      711         end.
      712       end.
      713       else do:
      714         run trg/markhold.p
      715           (input p-cat-code
      716           ,input p-lock-code
      717           ,input p-fact-date
      718           ) no-error .
      719         if error-status :error then do:
      720           message
      721             vss-workfile vss-revision vss-description skip
      722             "Ошибка при вызове процедуры markhold.p" skip
      723             "Дата" p-fact-date skip
      724             error-status :get-message(1) skip
      725             return-value skip
      726             view-as alert-box error .
      727           undo, return error .
      728         end.
      729       end.
      730     end.
      731     end.
      732   end procedure.
