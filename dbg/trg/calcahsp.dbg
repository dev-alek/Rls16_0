      595   function diff-list returns character (
      596     input parfirst-list  as character,
      597     input parsecond-list as character,
      598     input pardelim       as character).
      599     if pardelim = ""
      600     or pardelim = ?
      601     then do:
      602       assign
      603         pardelim = ","
      604       .
      605     end.
      606     def var ind as integer no-undo .
      607     def var v-elem as character no-undo .
      608     def var v-result-list as character no-undo init "".
      609     def var v-num-parfirst-list as integer no-undo .
      610     assign
      611       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      612     .
      613     do ind = 1 to v-num-parfirst-list
      614     :
      615       assign
      616         v-elem = entry(ind, parfirst-list, pardelim)
      617       .
      618       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      619         assign
      620           v-result-list = v-result-list
      621                         + (if v-result-list > "" then pardelim else "")
      622                         + v-elem
      623         .
      624       end.
      625     end.
      626     return v-result-list .
      627   end function.
      628   function add-list returns character (
      629    input parfirst-list  as character,
      630    input parsecond-list as character,
      631    input pardelim       as character).
      632     if pardelim = ""
      633     or pardelim = ?
      634     then do:
      635       assign
      636         pardelim = ","
      637       .
      638     end.
      639     def var ind as integer no-undo .
      640     def var v-elem as character no-undo .
      641     def var v-result-list as character no-undo init "".
      642     def var v-num-parfirst-list as integer no-undo .
      643     assign
      644       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      645     .
      646     do ind = 1 to v-num-parfirst-list
      647     :
      648       assign
      649         v-elem = entry(ind, parfirst-list, pardelim)
      650       .
      651       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      652         assign
      653           v-result-list = v-result-list
      654                         + (if v-result-list > "" then pardelim else "")
      655                         + v-elem
      656         .
      657       end.
      658     end.
      659     def var v-num-parsecond-list as integer no-undo .
      660     assign
      661       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      662     .
      663     do ind = 1 to v-num-parsecond-list
      664     :
      665       assign
      666         v-elem = entry(ind, parsecond-list, pardelim)
      667       .
      668       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      669         assign
      670           v-result-list = v-result-list
      671                         + (if v-result-list > "" then pardelim else "")
      672                         + v-elem
      673         .
      674       end.
      675     end.
      676     return v-result-list .
      677   end function.
      678   function cross-list returns character (
      679    input parfirst-list  as character,
      680    input parsecond-list as character,
      681    input pardelim       as character).
      682     if pardelim = ""
      683     or pardelim = ?
      684     then do:
      685       assign
      686         pardelim = ","
      687       .
      688     end.
      689     def var ind as integer no-undo .
      690     def var v-elem as character no-undo .
      691     def var v-result-list as character no-undo init "".
      692     def var v-num-parfirst-list as integer no-undo .
      693     assign
      694       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      695     .
      696     do ind = 1 to v-num-parfirst-list
      697     :
      698       assign
      699         v-elem = entry(ind, parfirst-list, pardelim)
      700       .
      701       if lookup(v-elem, v-result-list, pardelim) = 0
      702       and lookup(v-elem, parsecond-list, pardelim) > 0
      703       then do:
      704         assign
      705           v-result-list = v-result-list
      706                         + (if v-result-list > "" then pardelim else "")
      707                         + v-elem
      708         .
      709       end.
      710     end.
      711     return v-result-list .
      712   end function.
      713   function radio-label returns character (
      714    input par-rs-value  as character,
      715    input par-rs-radio-buttons as character)
      716    .
      717    DEFINE variable v-result-label as character no-undo.
      718    assign
      719    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      720                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      721                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      722                             ), par-rs-radio-buttons
      723                           )
      724    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      725    .
      726   return v-result-label.
      727   end function.
      728   function m-radio-label returns character (
      729    input par-rs-value  as character,
      730    input par-rs-radio-buttons as character,
      731    input par-delim as character
      732    )
      733    .
      734    DEFINE variable v-result-label as character no-undo.
      735    assign
      736    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      737                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      738                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      739                             ), par-rs-radio-buttons, par-delim
      740                           )
      741    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      742    .
      743   return v-result-label.
      744   end function.
      745   FUNCTION mixlist returns character
      746   (
      747    input parfirst-list  as character
      748    ,input parsecond-list as character
      749    ,input pardelim       as character
      750    ,input pardelim-result as character ) :
      751     if pardelim = ""
      752     or pardelim = ?
      753     then do:
      754       assign
      755         pardelim = ","
      756       .
      757     end.
      758     def var ind as integer no-undo .
      759     def var v-elem1 as character no-undo .
      760     def var v-elem2 as character no-undo .
      761     def var v-result-list as character no-undo init "".
      762     do ind = 1 to num-entries(parfirst-list, pardelim)
      763     :
      764       assign
      765         v-elem1 = entry(ind, parfirst-list, pardelim)
      766         v-elem2 = entry(ind, parsecond-list, pardelim)
      767       .
      768         assign
      769           v-result-list = v-result-list
      770                         + (if v-result-list > "" then pardelim-result else "")
      771                         + v-elem1 + pardelim-result + v-elem2
      772         .
      773     end.
      774     return v-result-list .
      775   END FUNCTION.
      776   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      777   procedure factord :
      778     define input  parameter p-fact-date            as date    no-undo .
      779     define input  parameter p-fact-time            as integer no-undo .
      780     define input  parameter p-fact-num             as integer no-undo .
      781     define input  parameter p-shift-date           as date    no-undo .
      782     define input  parameter p-shift-num            as integer no-undo .
      783     define input  parameter p-shift-on             as logical no-undo .
      784     define output parameter p-fact-order           as decimal no-undo .
      785     define output parameter p-shift-end-fact-order as decimal no-undo .
      786     define output parameter p-day-end-fact-order   as decimal no-undo .
      787     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      788     if p-fact-date = ?
      789     then do:
      790       return error "Не указана фактическая дата" .
      791     end.
      792     define variable v-fact-date-num as integer no-undo .
      793     assign
      794       v-fact-date-num = integer(p-fact-date)
      795     .
      796     if p-fact-num = ?
      797     or p-fact-num = 0
      798     then do:
      799       return error "Не задан p-fact-num " + string(p-fact-num) .
      800     end.
      801     if p-fact-num < 0
      802     then do:
      803       return error "Отрицательный fact-num " + string(p-fact-num) .
      804     end.
      805     if p-fact-num >= 100000000
      806     then do:
      807       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      808     end.
      809     if p-shift-on = true
      810     then do:
      811       if p-shift-date = ?
      812       then do:
      813         return error "Не задана дата смены" .
      814       end.
      815       if p-shift-num = ?
      816       or p-shift-num = 0
      817       then do:
      818         return error "Не задан номер смены" .
      819       end.
      820     end.
      821     else do:
      822       assign
      823         p-shift-date = p-fact-date
      824         p-shift-num  = 24
      825       .
      826     end.
      827     define variable v-shift-offset as integer no-undo .
      828     if p-shift-date = p-fact-date
      829     then do:
      830       assign
      831         v-shift-offset = 1
      832       .
      833     end.
      834     if p-shift-date < p-fact-date
      835     then do:
      836       assign
      837         v-shift-offset = 0
      838       .
      839     end.
      840     if p-shift-date > p-fact-date
      841     then do:
      842       message
      843         vss-workfile vss-revision vss-description skip
      844         "Неправильная дата закрытия смены" skip
      845         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      846         view-as alert-box error .
      847       undo, return error
      848         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      849           ,string(p-fact-date, '99/99/9999':U)
      850           ,string(p-shift-date, '99/99/9999':U)
      851           )
      852       .
      853     end.
      854     if p-shift-num < 1
      855     or p-shift-num > 24
      856     then do:
      857       message
      858         vss-workfile vss-revision vss-description skip
      859         "Неправильный номер смены" skip
      860         "p-shift-num" p-shift-num skip
      861         view-as alert-box error .
      862       undo, return error return-value .
      863     end.
      864     assign
      865       p-fact-order           = v-fact-date-num
      866                              + v-shift-offset * 0.5
      867                              + p-shift-num    * 0.02 - 0.01
      868                              + p-fact-num     * 0.0000000001
      869       p-shift-end-fact-order = v-fact-date-num
      870                              + v-shift-offset * 0.5
      871                              + p-shift-num    * 0.02
      872       p-day-end-fact-order   = v-fact-date-num
      873                              + 0.99
      874     .
      875     if p-fact-order           <= v-fact-date-num
      876     or p-shift-end-fact-order <= v-fact-date-num
      877     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      878     or p-shift-end-fact-order >= p-day-end-fact-order
      879     then do:
      880       message
      881         vss-workfile vss-revision vss-description skip
      882         "Внутренняя ошибка при генерации фактического номера" skip
      883         "p-fact-date"            p-fact-date            skip
      884         "p-fact-time"            p-fact-time            skip
      885         "p-fact-num"             p-fact-num             skip
      886         "p-shift-date"           p-shift-date           skip
      887         "p-shift-num"            p-shift-num            skip
      888         "p-shift-on"             p-shift-on             skip
      889         "p-shift-end-fact-order" p-shift-end-fact-order skip
      890         "p-day-end-fact-order"   p-day-end-fact-order   skip
      891         "v-fact-date-num"        v-fact-date-num        skip
      892         view-as alert-box error .
      893       undo, return error return-value .
      894     end.
      895   end procedure.
      896   procedure day-begin-fact-order :
      897     define input  parameter p-fact-date            as date    no-undo .
      898     define output parameter p-day-begin-fact-order as decimal no-undo .
      899     do
      900     on error undo, return error return-value
      901     :
      902       if p-fact-date = ?
      903       then do:
      904         assign
      905           p-day-begin-fact-order = 0
      906         .
      907       end.
      908       else do:
      909         assign
      910           p-day-begin-fact-order = integer(p-fact-date)
      911         .
      912       end.
      913     end.
      914   end procedure.
      915   procedure factord-max-fact-order :
      916     define output parameter p-max-fact-order as decimal   no-undo .
      917     do
      918     on error undo, return error return-value
      919     :
      920       run day-begin-fact-order in this-procedure
      921         (input  date(1, 1, 5000)
      922         ,output p-max-fact-order
      923         ) .
      924     end.
      925   end procedure.
      926   procedure factord-cut-archive :
      927     define input  parameter p-obj-type             as character no-undo .
      928     define input  parameter p-obj-code             as integer   no-undo .
      929     define input  parameter p-fact-date            as date      no-undo .
      930     define output parameter p-shift-on             as logical   no-undo .
      931     define output parameter p-shift-date           as date      no-undo .
      932     define output parameter p-shift-num            as integer   no-undo .
      933     define output parameter p-day-end-fact-order   as decimal   no-undo .
      934     define output parameter p-shift-end-fact-order as decimal   no-undo .
      935     define variable v-fact-order as decimal   no-undo .
      936     define buffer buf_shift-obj for ub.shift-obj .
      937     do
      938     on error undo, return error return-value
      939     :
      940   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      942     (input  p-obj-type
      943     ,input  p-obj-code
      944     ,input  'shift-on=request'
      945     ,output p-shift-on
      946     ) no-error .
      947       if error-status :error
      948       then do:
      949         message
      950           vss-workfile vss-revision vss-description skip
      951           "Ошибка при определении атрибута объекта" skip
      952           "Объект" p-obj-type p-obj-code skip
      953           error-status :get-message(1) skip
      954           return-value skip
      955           view-as alert-box error .
      956         undo, return error return-value .
      957       end.
      958       if p-shift-on = false
      959       then do:
      960         assign
      961           p-shift-date               = ?
      962           p-shift-num                = 0
      963         .
      964       end.
      965       else do:
      966         find first buf_shift-obj share-lock
      967           where buf_shift-obj.obj-type   = p-obj-type
      968             and buf_shift-obj.obj-code   = p-obj-code
      969             and buf_shift-obj.shift-date > p-fact-date
      970           use-index pi
      971           no-error .
      972         if not available buf_shift-obj
      973         or buf_shift-obj.status_ <> 'зкр':U
      974         then do:
      975           message
      976             vss-workfile vss-revision vss-description skip
      977             "Невозможно вычислить последнюю смену" skip
      978             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      979             "Объект" p-obj-type p-obj-code skip
      980             "Дата" p-fact-date skip
      981             view-as alert-box error .
      982           undo, return error return-value .
      983         end.
      984         find last buf_shift-obj share-lock
      985           where buf_shift-obj.obj-type = p-obj-type
      986             and buf_shift-obj.obj-code = p-obj-code
      987             and buf_shift-obj.shift-date <= p-fact-date
      988           use-index pi
      989           no-error .
      990         if available buf_shift-obj
      991         then do:
      992           if  buf_shift-obj.status_ = 'зкр':U
      993           then do:
      994             assign
      995               p-shift-date = buf_shift-obj.shift-date
      996               p-shift-num  = buf_shift-obj.shift-num
      997             .
      998           end.
      999           else do:
     1000             message
     1001               vss-workfile vss-revision vss-description skip
     1002               "Невозможно вычислить последнюю смену" skip
     1003               "Статус смены отличен от статуса" 'зкр':U skip
     1004               "Объект" p-obj-type p-obj-code skip
     1005               "Дата" p-fact-date skip
     1006               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1007               view-as alert-box error .
     1008             undo, return error return-value .
     1009           end.
     1010         end.
     1011         else do:
     1012           assign
     1013             p-shift-date = p-fact-date - 1
     1014             p-shift-num  = 1
     1015           .
     1016         end.
     1017       end.
     1018       run factord in this-procedure
     1019         (input  p-fact-date
     1020         ,input  1
     1021         ,input  1
     1022         ,input  p-shift-date
     1023         ,input  p-shift-num
     1024         ,input  p-shift-on
     1025         ,output v-fact-order
     1026         ,output p-shift-end-fact-order
     1027         ,output p-day-end-fact-order
     1028         ) no-error .
     1029       if error-status :error
     1030       then do:
     1031         message
     1032           vss-workfile vss-revision vss-description skip
     1033           "Ошибка при вызове процедуры factord"
     1034           error-status :get-message(1) skip
     1035           return-value skip
     1036           view-as alert-box error .
     1037         undo, return error return-value .
     1038       end.
     1039     end.
     1040   end procedure.
     1041   procedure factord-lock-shift :
     1042     define input  parameter p-obj-type  as character no-undo .
     1043     define input  parameter p-obj-code  as integer   no-undo .
     1044     define input  parameter p-fact-date as date      no-undo .
     1045     define parameter buffer buf_shift-obj for ub.shift-obj .
     1046     define variable v-shift-on      as logical   no-undo .
     1047     define variable v-extra-message as character no-undo .
     1048     define variable v-error as character no-undo .
     1049     do
     1050     on error undo, return error return-value
     1051     :
     1052   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1054     (input  p-obj-type
     1055     ,input  p-obj-code
     1056     ,input  'shift-on=request'
     1057     ,output v-shift-on
     1058     ) no-error .
     1059       if error-status :error
     1060       then do:
     1061         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1062         undo, return error v-error .
     1063       end.
     1064       if v-shift-on = true
     1065       then do:
     1066         find first buf_shift-obj share-lock
     1067           where buf_shift-obj.obj-type   = p-obj-type
     1068             and buf_shift-obj.obj-code   = p-obj-code
     1069             and buf_shift-obj.shift-date > p-fact-date
     1070           use-index pi
     1071           no-error .
     1072         if not available buf_shift-obj
     1073         or buf_shift-obj.status_ <> 'зкр':U
     1074         then do:
     1075           find last buf_shift-obj
     1076             where buf_shift-obj.obj-type = p-obj-type
     1077               and buf_shift-obj.obj-code = p-obj-code
     1078               and buf_shift-obj.status_  = 'зкр':U
     1079             use-index stts
     1080             no-error .
     1081           if available buf_shift-obj
     1082           then do:
     1083             assign
     1084               v-extra-message =
     1085                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1086                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1087                               )
     1088             .
     1089           end.
     1090           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1091           undo, return error v-error .
     1092         end.
     1093       end.
     1094     end.
     1095   end procedure.
     1096   procedure factord-end-day :
     1097     define input  parameter p-fact-date            as date    no-undo .
     1098     define output parameter p-day-end-fact-order   as decimal no-undo .
     1099     do
     1100     on error undo, return error return-value
     1101     :
     1102       if p-fact-date = ?
     1103       then do:
     1104         return error "Не указана фактическая дата" .
     1105       end.
     1106       assign
     1107         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1108       .
     1109     end.
     1110   end procedure.
     1111   procedure factord-to-date :
     1112     define input  parameter p-fact-order as decimal no-undo .
     1113     define output parameter p-fact-date  as date    no-undo .
     1114     define variable v-ref-date  as date      no-undo .
     1115     define variable v-ref-delta as integer   no-undo .
     1116     do
     1117     on error undo, return error return-value
     1118     :
     1119       if p-fact-order = ?
     1120       or p-fact-order = 0
     1121       then do:
     1122         return error "Не указан fact-order" .
     1123       end.
     1124       assign
     1125         v-ref-date  = date(1, 1, 2000)
     1126       .
     1127       assign
     1128         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1129       .
     1130       assign
     1131         p-fact-date = v-ref-date + v-ref-delta
     1132       .
     1133     end.
     1134   end procedure.
     1135   procedure factord-to-fact-num :
     1136     define input  parameter p-fact-order as decimal no-undo .
     1137     define output parameter p-fact-num   as integer no-undo .
     1138     define variable v-fact-order-trunc as decimal no-undo .
     1139     do
     1140     on error undo, return error return-value
     1141     :
     1142       if p-fact-order = ?
     1143       or p-fact-order = 0
     1144       then do:
     1145         return error "Не указан fact-order" .
     1146       end.
     1147       assign
     1148        v-fact-order-trunc = truncate(p-fact-order, 2)
     1149       .
     1150       assign
     1151         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1152       .
     1153     end.
     1154   end procedure.
     1155   procedure factord-to-shift-num :
     1156     define input  parameter p-fact-order as decimal no-undo .
     1157     define output parameter p-shift-num   as integer no-undo .
     1158     define variable  p-shift-numd  as decimal   no-undo .
     1159     define variable v-fact-order-trunc as decimal no-undo .
     1160     do
     1161     on error undo, return error return-value
     1162     :
     1163       if p-fact-order = ?
     1164       or p-fact-order = 0
     1165       then do:
     1166         return error "Не указан fact-order" .
     1167       end.
     1168       assign
     1169        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1170       .
     1171       if v-fact-order-trunc < 0.5 then do:
     1172         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1173       end.
     1174       assign
     1175         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1176         .
     1177        assign
     1178         p-shift-num = truncate (p-shift-numd , 0)
     1179       .
     1180     end.
     1181   end procedure.
     1182   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   define temp-table doc-list no-undo
     1184     field doc-code         like ub.trn-doc.doc-code
     1185     field obj-type         like ub.trn-doc.obj-type
     1186     field obj-code         like ub.trn-doc.obj-code
     1187     field fact-date        like ub.trn-doc.fact-date
     1188     field shift-date       like ub.trn-doc.shift-date
     1189     field shift-num        like ub.trn-doc.shift-num
     1190     field shift-name       like ub.trn-doc.shift-name
     1191     field fact-order       as decimal
     1192     field is-trn-doc       as logical
     1193     field doc-type         like ub.trn-doc.doc-type
     1194     field is-archive-exist as logical
     1195     index xpk is primary unique doc-code doc-type
     1196     index xfact-order fact-order
     1197     index xfact-date  fact-date
     1198     .
     1199   define temp-table doclslib-goods no-undo
     1200     field gds-code  as integer
     1201     field artic     as character
     1202     field prod-type as character
     1203     field prod-code as integer
     1204     index xpk is primary unique gds-code
     1205     index xie1 artic prod-type prod-code
     1206     .
     1207   define buffer inkas_trn-doc for ub.trn-doc .
     1208   define stream doclsliblog .
     1209   procedure doclslib-clear-doc-list :
     1210     define buffer buf_doc-list for doc-list .
     1211     do
     1212     on error undo, return error
     1213     :
     1214       for each buf_doc-list
     1215       on error undo, return error
     1216       :
     1217         delete buf_doc-list .
     1218       end.
     1219     end.
     1220   end procedure.
     1221   procedure doclslib-init-trn-doc :
     1222     define input parameter p-obj-type      as character no-undo .
     1223     define input parameter p-obj-code      as integer   no-undo .
     1224     define input parameter p-cut-date      as date      no-undo .
     1225     define buffer buf_trn-doc for ub.trn-doc .
     1226     define buffer buf_doc-list for doc-list .
     1227     do
     1228     on error undo, return error
     1229     :
     1230       if p-cut-date = ?
     1231       then do:
     1232         for each buf_trn-doc no-lock
     1233           where buf_trn-doc.obj-type = p-obj-type
     1234             and buf_trn-doc.obj-code = p-obj-code
     1235             and buf_trn-doc.status_  = 'факт':U
     1236         on error undo, return error
     1237         :
     1238           create buf_doc-list .
     1239           assign
     1240             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1241             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1242             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1243             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1244             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1245             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1246             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1247             buf_doc-list.is-trn-doc = true
     1248           .
     1249         end.
     1250       end.
     1251       else do:
     1252         for each buf_trn-doc no-lock
     1253           where buf_trn-doc.obj-type  = p-obj-type
     1254             and buf_trn-doc.obj-code  = p-obj-code
     1255             and buf_trn-doc.status_   = 'факт':U
     1256             and buf_trn-doc.fact-date >= p-cut-date
     1257         on error undo, return error
     1258         :
     1259           create buf_doc-list .
     1260           assign
     1261             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1262             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1263             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1264             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1265             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1266             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1267             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1268             buf_doc-list.is-trn-doc = true
     1269           .
     1270         end.
     1271       end.
     1272     end.
     1273   end procedure.
     1274   procedure doclslib-init-price-doc :
     1275     define input parameter p-obj-type      as character no-undo .
     1276     define input parameter p-obj-code      as integer   no-undo .
