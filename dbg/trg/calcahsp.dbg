     1292           assign
     1293             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1294             buf_doc-list.doc-type   = ''
     1295             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1296             buf_doc-list.shift-date = buf_price-doc.shift-date
     1297             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1298             buf_doc-list.shift-name = buf_price-doc.shift-name
     1299             buf_doc-list.fact-order = buf_price-doc.fact-order
     1300             buf_doc-list.is-trn-doc = false
     1301           .
     1302         end.
     1303       end.
     1304       else do:
     1305         for each buf_price-doc no-lock
     1306           where buf_price-doc.obj-type = p-obj-type
     1307             and buf_price-doc.obj-code = p-obj-code
     1308             and buf_price-doc.status_  = 'акт':U
     1309             and ub.buf_price-doc.fact-date >= p-cut-date
     1310         on error undo, return error
     1311         :
     1312           create buf_doc-list .
     1313           assign
     1314             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1315             buf_doc-list.doc-type   = ''
     1316             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1317             buf_doc-list.shift-date = buf_price-doc.shift-date
     1318             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1319             buf_doc-list.shift-name = buf_price-doc.shift-name
     1320             buf_doc-list.fact-order = buf_price-doc.fact-order
     1321             buf_doc-list.is-trn-doc = false
     1322           .
     1323         end.
     1324       end.
     1325     end.
     1326   end procedure.
     1327   procedure doclslib-clear-bydate-doc-list :
     1328     define input parameter p-fact-date as date no-undo .
     1329     define buffer buf_doc-list for doc-list .
     1330     do
     1331     on error undo, return error
     1332     :
     1333       if p-fact-date <> ?
     1334       then do:
     1335         for each buf_doc-list
     1336           where buf_doc-list.fact-date < p-fact-date
     1337         on error undo, return error
     1338         :
