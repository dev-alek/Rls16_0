     1284       then do:
     1285         for each buf_price-doc no-lock
     1286           where buf_price-doc.obj-type = p-obj-type
     1287             and buf_price-doc.obj-code = p-obj-code
     1288             and buf_price-doc.status_  = 'акт':U
     1289         on error undo, return error
     1290         :
