     2837   procedure cb-doclslib-log :
     2838     define input parameter p-message  as character no-undo .
     2839     define variable v-log-file-name as character no-undo .
     2840     assign
     2841       v-log-file-name = substitute("calcahsp_&1_&2.txt", p-obj-type, p-obj-code)
     2842     .
     2843     do
     2844     on error undo, return error return-value
     2845     :
     2846       output stream slog to value(v-log-file-name) append .
     2847       export stream slog
     2848         p-obj-type
     2849         p-obj-code
     2850         cur-time-string-sec()
     2851         p-message .
     2852       output stream slog close .
     2853     end.
     2854   end procedure.
     2855   procedure show-action :
     2856     define input parameter p-message  as character no-undo .
     2857     do
     2858     on error undo, return error return-value
     2859     :
     2860       assign
     2861         v-action = p-message
     2862       .
     2863       display
     2864         v-action with frame a .
     2865     end.
     2866   end procedure.
     2867   procedure log-information :
     2868     define input parameter p-obj-type as character no-undo .
     2869     define input parameter p-obj-code as integer   no-undo .
     2870     define input parameter p-message  as character no-undo .
     2871     do
     2872     on error undo, return error return-value
     2873     :
     2874       output stream slog to objahsp.log append .
     2875       export stream slog
     2876         p-obj-type
     2877         p-obj-code
     2878         cur-time-string()
     2879         p-message .
     2880       output stream slog close .
     2881     end.
     2882   end procedure.
