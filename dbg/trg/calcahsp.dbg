     1340         end.
     1341       end.
     1342     end.
     1343   end procedure.
     1344   procedure doclslib-clear-rst :
     1345     define input parameter p-fact-date as date no-undo .
     1346     define buffer buf_doc-list for doc-list .
     1347     do
     1348     on error undo, return error
     1349     :
     1350       if p-fact-date <> ?
     1351       then do:
     1352         for each buf_doc-list
     1353           where buf_doc-list.fact-date >= p-fact-date
     1354         on error undo, return error
