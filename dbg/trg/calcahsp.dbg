     2532                     "Введенная дата не может быть меньше даты" v-ahsp-detail-date skip
     2533                     "Вы ввели дату" v-last-fact-date skip
     2534                     view-as alert-box information .
     2535                   next update-block .
     2536                 end.
     2537                 leave update-block .
     2538               end.
     2539               run cb-doclslib-log in this-procedure
     2540                 (input substitute("Выбор пользователя 2. Пересчитать с даты &1"
     2541                                  ,string(v-last-fact-date, '99/99/9999':u)
     2542                                  )
     2543                 ) .
