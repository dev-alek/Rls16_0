     1361   procedure doclslib-export-doc-list :
     1362     define input  parameter p-obj-type      as character no-undo .
     1363     define input  parameter p-obj-code      as integer no-undo .
     1364     define input  parameter p-log-file-name as character no-undo .
     1365     define input  parameter p-description   as character no-undo .
     1366     define buffer buf_doc-list for doc-list .
     1367     do
     1368     on error undo, return error
     1369     :
     1370       output stream doclsliblog to value(p-log-file-name) .
     1371       export stream doclsliblog "#############################################################" .
     1372       export stream doclsliblog "Список документов" .
     1373       export stream doclsliblog p-description .
     1374       export stream doclsliblog "Объект" p-obj-type p-obj-code .
     1375       export stream doclsliblog "Дата" string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     1376       for each buf_doc-list
     1377       by buf_doc-list.fact-order
     1378       on error undo, return error
     1379       :
     1380         export stream doclsliblog buf_doc-list .
     1381       end.
     1382       export stream doclsliblog "#############################################################" .
     1383       output stream doclsliblog close .
     1384     end.
     1385   end procedure.
     1386   procedure doclslib-clear-batch-process :
     1387     define input parameter p-bp_type like ub.batchprocess.bp_type no-undo .
     1388     define buffer buf_batchprocess        for ub.batchprocess .
     1389     define buffer execdelete_batchprocess for ub.batchprocess .
     1390     define buffer buf_doc-list            for doc-list .
     1391     for each buf_doc-list
     1392     on end-key undo, return error substitute( "doclslib-clear-batch-process. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1393     on error   undo, return error substitute( "doclslib-clear-batch-process. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1394     on stop    undo, return error substitute( "doclslib-clear-batch-process. STOP      &2"
     1395                                    + "bp_type &3&2"
     1396                                    + "Документ &4"
     1397                                    , chr(10)
     1398                                    , p-bp_type
     1399                                    , buf_doc-list.doc-code
     1400                                   )
     1401     :
     1402       find first buf_batchprocess exclusive-lock
     1403         where buf_BatchProcess.BP_Status   = 'N':U
     1404           and buf_batchprocess.bp_type     = p-bp_type
     1405           and buf_batchprocess.charkey_one = buf_doc-list.doc-code
     1406         no-error .
     1407       if available buf_batchprocess
     1408       then do:
     1409         delete buf_batchprocess .
     1410       end.
     1411     end.
     1412   end procedure.
     1413   procedure doclslib-calc-arh :
     1414     define input  parameter p-log-handle     as handle    no-undo .
     1415     define input  parameter p-obj-type       as character no-undo .
     1416     define input  parameter p-obj-code       as integer   no-undo .
     1417     define input  parameter p-cut-date       as date      no-undo .
     1418     define input  parameter p-update-recalc  as logical   no-undo .
     1419     define variable v-prev-fact-date as date      no-undo .
     1420     define buffer buf_doc-list for doc-list .
     1421     define buffer stop-arh-restore-lock_btpr for ub.batchprocess .
     1422     define buffer stop-arh-news-lock_btpr    for ub.batchprocess .
     1423     do
     1424     on stop    undo, return error substitute( "doclslib-calc-arh. stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1425     on end-key undo, return error substitute( "doclslib-calc-arh. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1426     on error   undo, return error substitute( "doclslib-calc-arh. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1427     :
     1428       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1429       run gbl/lockrngd.p
     1430         (input  'grar':U
     1431         ,input  'disable':U
     1432         ,buffer buf_lock_gdsrenart_batchprocess
     1433         ) no-error .
     1434       if error-status :error
     1435       then do:
     1436         if error-status :get-message(1) <> ""
     1437         then do:
     1438           message
     1439             vss-workfile vss-revision vss-description skip
     1440             "Ошибка при блокировании функции переименования артикула товара" skip
     1441             error-status :get-message(1) skip
     1442             return-value skip
     1443             view-as alert-box error .
     1444         end.
     1445         undo, return error return-value .
     1446       end.
     1447       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1448       run gbl/lockrngd.p
     1449         (input  'grgc':U
     1450         ,input  'disable':U
     1451         ,buffer buf_lock_gdsrengc_batchprocess
     1452         ) no-error .
     1453       if error-status :error
     1454       then do:
     1455         if error-status :get-message(1) <> ""
     1456         then do:
     1457           message
     1458             vss-workfile vss-revision vss-description skip
     1459             "Ошибка при блокировании функции переименования кода товара" skip
     1460             error-status :get-message(1) skip
     1461             return-value skip
     1462             view-as alert-box error .
     1463         end.
     1464         undo, return error return-value .
     1465       end.
     1466       for each buf_doc-list
     1467       by buf_doc-list.fact-order
     1468       on stop    undo, return error substitute( "f e . stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1469       on end-key undo, return error substitute( "f e . end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1470       on error   undo, return error substitute( "f e . error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1471       :
     1472         find first stop-arh-restore-lock_btpr no-lock
     1473           where stop-arh-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
     1474             and stop-arh-restore-lock_btpr.bp_status     = 'N':U
     1475             and stop-arh-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1476             and stop-arh-restore-lock_btpr.Key#_Two      = 0
     1477             and stop-arh-restore-lock_btpr.Key#_Three    = 0
     1478             and stop-arh-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1479             and stop-arh-restore-lock_btpr.CharKey_Two   = ""
     1480             and stop-arh-restore-lock_btpr.CharKey_Three = ""
     1481           no-error .
     1482         if available stop-arh-restore-lock_btpr
     1483         then do:
     1484           run doclslib-log-information in this-procedure
     1485             (input p-log-handle
     1486             ,input "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива"
     1487             ) .
     1488           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1489         end.
     1490         find first stop-arh-news-lock_btpr no-lock
     1491           where stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
     1492             and stop-arh-news-lock_btpr.bp_status     = 'N':U
     1493             and stop-arh-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1494             and stop-arh-news-lock_btpr.Key#_Two      = 0
     1495             and stop-arh-news-lock_btpr.Key#_Three    = 0
     1496             and stop-arh-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1497             and stop-arh-news-lock_btpr.CharKey_Three = ""
     1498           no-error .
     1499         if available stop-arh-news-lock_btpr
     1500         then do:
     1501           run doclslib-log-information in this-procedure
     1502             (input p-log-handle
     1503             ,input "Система новостей запросила остановку процедуры расчета складского архива"
     1504             ) .
     1505           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1506         end.
     1507         if buf_doc-list.is-trn-doc
     1508         then do:
     1509           run doclslib-log-information in this-procedure
     1510             (input p-log-handle
     1511             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1512                              ,buf_doc-list.doc-code
     1513                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1514                              ,buf_doc-list.fact-order
     1515                              )
     1516             ) .
     1517           run trg/calc-arh.p
     1518             (input buf_doc-list.doc-code
     1519             ,input p-cut-date
     1520             ).
     1521           run doclslib-log-information in this-procedure
     1522             (input p-log-handle
     1523             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1524                              ,buf_doc-list.doc-code
     1525                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1526                              ,buf_doc-list.fact-order
     1527                              )
     1528             ) .
     1529         end.
     1530         else do:
     1531           run doclslib-log-information in this-procedure
     1532             (input p-log-handle
     1533             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1534                              ,buf_doc-list.doc-code
     1535                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1536                              ,buf_doc-list.fact-order
     1537                              )
     1538             ) .
     1539           run trg/calc-apc.p
     1540             (input buf_doc-list.doc-code
     1541             ,input p-cut-date
     1542             ).
     1543           run doclslib-log-information in this-procedure
     1544             (input p-log-handle
     1545             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1546                              ,buf_doc-list.doc-code
     1547                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1548                              ,buf_doc-list.fact-order
     1549                              )
     1550             ) .
     1551         end.
     1552         if  p-update-recalc  = true
     1553         and v-prev-fact-date <> ?
     1554         and buf_doc-list.fact-date > v-prev-fact-date
     1555         then do:
     1556           run gbl/clntat-w.p
     1557             (input p-obj-type
     1558             ,input p-obj-code
     1559             ,input 'arh-recalc':U
     1560             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1561             ) .
     1562           run doclslib-log-information in this-procedure
     1563             (input p-log-handle
     1564             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1565                              ,string(v-prev-fact-date, '99/99/9999':u)
     1566                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1567                              )
     1568             ) .
     1569         end.
     1570         assign
     1571           v-prev-fact-date = buf_doc-list.fact-date
     1572         .
     1573       end.
     1574     end.
     1575   end procedure.
     1576   procedure doclslib-calc-aht :
     1577     define input  parameter p-log-handle    as handle    no-undo .
     1578     define input  parameter p-obj-type      as character no-undo .
     1579     define input  parameter p-obj-code      as integer   no-undo .
     1580     define input  parameter p-cut-date      as date      no-undo .
     1581     define input  parameter p-update-recalc as logical   no-undo .
     1582     define variable v-prev-fact-date as date      no-undo .
     1583     define buffer buf_doc-list for doc-list .
     1584     define buffer stop-aht-restore-lock_btpr for ub.batchprocess .
     1585     define buffer stop-aht-news-lock_btpr    for ub.batchprocess .
     1586     do
     1587     on error undo, return error return-value
     1588     :
     1589       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1590       run gbl/lockrngd.p
     1591         (input  'grar':U
     1592         ,input  'disable':U
     1593         ,buffer buf_lock_gdsrenart_batchprocess
     1594         ) no-error .
     1595       if error-status :error
     1596       then do:
     1597         if error-status :get-message(1) <> ""
     1598         then do:
     1599           message
     1600             vss-workfile vss-revision vss-description skip
     1601             "Ошибка при блокировании функции переименования артикула товара" skip
     1602             error-status :get-message(1) skip
     1603             return-value skip
     1604             view-as alert-box error .
     1605         end.
     1606         undo, return error return-value .
     1607       end.
     1608       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1609       run gbl/lockrngd.p
     1610         (input  'grgc':U
     1611         ,input  'disable':U
     1612         ,buffer buf_lock_gdsrengc_batchprocess
     1613         ) no-error .
     1614       if error-status :error
     1615       then do:
     1616         if error-status :get-message(1) <> ""
     1617         then do:
     1618           message
     1619             vss-workfile vss-revision vss-description skip
     1620             "Ошибка при блокировании функции переименования кода товара" skip
     1621             error-status :get-message(1) skip
     1622             return-value skip
     1623             view-as alert-box error .
     1624         end.
     1625         undo, return error return-value .
     1626       end.
     1627       for each buf_doc-list
     1628       by buf_doc-list.fact-order
     1629       on error undo, return error
     1630       :
     1631         find first stop-aht-restore-lock_btpr no-lock
     1632           where stop-aht-restore-lock_btpr.bp_type       = 'lock':U + 'rsts':U
     1633             and stop-aht-restore-lock_btpr.bp_status     = 'N':U
     1634             and stop-aht-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1635             and stop-aht-restore-lock_btpr.Key#_Two      = 0
     1636             and stop-aht-restore-lock_btpr.Key#_Three    = 0
     1637             and stop-aht-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1638             and stop-aht-restore-lock_btpr.CharKey_Two   = ""
     1639             and stop-aht-restore-lock_btpr.CharKey_Three = ""
     1640           no-error .
     1641         if available stop-aht-restore-lock_btpr
     1642         then do:
     1643           undo, return error "Процедура восстановления складского архива запросила остановку процедуры автоматического расчета складского архива" .
     1644         end.
     1645         find first stop-aht-news-lock_btpr no-lock
     1646           where stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
     1647             and stop-aht-news-lock_btpr.bp_status     = 'N':U
     1648             and stop-aht-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1649             and stop-aht-news-lock_btpr.Key#_Two      = 0
     1650             and stop-aht-news-lock_btpr.Key#_Three    = 0
     1651             and stop-aht-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1652             and stop-aht-news-lock_btpr.CharKey_Three = ""
     1653           no-error .
     1654         if available stop-aht-news-lock_btpr
     1655         then do:
     1656           undo, return error "Система новостей запросила остановку процедуры автоматического расчета складского архива" .
     1657         end.
     1658         if buf_doc-list.is-trn-doc
     1659         then do:
     1660           run doclslib-log-information in this-procedure
     1661             (input p-log-handle
     1662             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1663                              ,buf_doc-list.doc-code
     1664                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1665                              ,buf_doc-list.fact-order
     1666                              )
     1667             ) .
     1668           run trg/aht-doc.p
     1669             (input buf_doc-list.doc-code
     1670             ,input p-cut-date
     1671             ).
     1672           run doclslib-log-information in this-procedure
     1673             (input p-log-handle
     1674             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1675                              ,buf_doc-list.doc-code
     1676                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1677                              ,buf_doc-list.fact-order
     1678                              )
     1679             ) .
     1680         end.
     1681         else do:
     1682           run doclslib-log-information in this-procedure
     1683             (input p-log-handle
     1684             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1685                              ,buf_doc-list.doc-code
     1686                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1687                              ,buf_doc-list.fact-order
     1688                              )
     1689             ) .
     1690           run trg/aht-prc.p
     1691             (input buf_doc-list.doc-code
     1692             ,input p-cut-date
     1693             ).
     1694           run doclslib-log-information in this-procedure
     1695             (input p-log-handle
     1696             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1697                              ,buf_doc-list.doc-code
     1698                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1699                              ,buf_doc-list.fact-order
     1700                              )
     1701             ) .
     1702         end.
     1703         if  p-update-recalc  = true
     1704         and v-prev-fact-date <> ?
     1705         and buf_doc-list.fact-date > v-prev-fact-date
     1706         then do:
     1707           run gbl/clntat-w.p
     1708             (input p-obj-type
     1709             ,input p-obj-code
     1710             ,input 'aht-recalc':U
     1711             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1712             ) .
     1713           run doclslib-log-information in this-procedure
     1714             (input p-log-handle
     1715             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1716                              ,string(v-prev-fact-date, '99/99/9999':u)
     1717                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1718                              )
     1719             ) .
     1720         end.
     1721         assign
     1722           v-prev-fact-date = buf_doc-list.fact-date
     1723         .
     1724       end.
     1725     end.
     1726   end procedure.
     1727   procedure doclslib-calc-ahsp :
     1728     define input  parameter p-log-handle    as handle    no-undo .
     1729     define input  parameter p-obj-type      as character no-undo .
     1730     define input  parameter p-obj-code      as integer   no-undo .
     1731     define input  parameter p-cut-date      as date      no-undo .
     1732     define input  parameter p-update-recalc as logical   no-undo .
     1733     define variable v-prev-fact-date as date      no-undo .
     1734     define buffer buf_doc-list for doc-list .
     1735     define buffer stop-ahsp-restore-lock_btpr for ub.batchprocess .
     1736     define buffer stop-ahsp-news-lock_btpr    for ub.batchprocess .
     1737     do
     1738     on error undo, return error return-value
     1739     :
     1740       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1741       run gbl/lockrngd.p
     1742         (input  'grar':U
     1743         ,input  'disable':U
     1744         ,buffer buf_lock_gdsrenart_batchprocess
     1745         ) no-error .
     1746       if error-status :error
     1747       then do:
     1748         if error-status :get-message(1) <> ""
     1749         then do:
     1750           message
     1751             vss-workfile vss-revision vss-description skip
     1752             "Ошибка при блокировании функции переименования артикула товара" skip
     1753             error-status :get-message(1) skip
     1754             return-value skip
     1755             view-as alert-box error .
     1756         end.
     1757         undo, return error return-value .
     1758       end.
     1759       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1760       run gbl/lockrngd.p
     1761         (input  'grgc':U
     1762         ,input  'disable':U
     1763         ,buffer buf_lock_gdsrengc_batchprocess
     1764         ) no-error .
     1765       if error-status :error
     1766       then do:
     1767         if error-status :get-message(1) <> ""
     1768         then do:
     1769           message
     1770             vss-workfile vss-revision vss-description skip
     1771             "Ошибка при блокировании функции переименования кода товара" skip
     1772             error-status :get-message(1) skip
     1773             return-value skip
     1774             view-as alert-box error .
     1775         end.
     1776         undo, return error return-value .
     1777       end.
     1778       for each buf_doc-list
     1779         where buf_doc-list.is-trn-doc = true
     1780       by buf_doc-list.fact-order
     1781       on error undo, return error
     1782       :
     1783         find first stop-ahsp-restore-lock_btpr no-lock
     1784           where stop-ahsp-restore-lock_btpr.bp_type       = 'lock':U + 'rsss':U
     1785             and stop-ahsp-restore-lock_btpr.bp_status     = 'N':U
     1786             and stop-ahsp-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1787             and stop-ahsp-restore-lock_btpr.Key#_Two      = 0
     1788             and stop-ahsp-restore-lock_btpr.Key#_Three    = 0
     1789             and stop-ahsp-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1790             and stop-ahsp-restore-lock_btpr.CharKey_Two   = ""
     1791             and stop-ahsp-restore-lock_btpr.CharKey_Three = ""
     1792           no-error .
     1793         if available stop-ahsp-restore-lock_btpr
     1794         then do:
     1795           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1796         end.
     1797         find first stop-ahsp-news-lock_btpr no-lock
     1798           where stop-ahsp-news-lock_btpr.bp_type       = 'lock':U + 'rssn':U
     1799             and stop-ahsp-news-lock_btpr.bp_status     = 'N':U
     1800             and stop-ahsp-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1801             and stop-ahsp-news-lock_btpr.Key#_Two      = 0
     1802             and stop-ahsp-news-lock_btpr.Key#_Three    = 0
     1803             and stop-ahsp-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1804             and stop-ahsp-news-lock_btpr.CharKey_Three = ""
     1805           no-error .
     1806         if available stop-ahsp-news-lock_btpr
     1807         then do:
     1808           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1809         end.
     1810         run doclslib-log-information in this-procedure
     1811           (input p-log-handle
     1812           ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1813                             ,buf_doc-list.doc-code
     1814                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1815                             ,buf_doc-list.fact-order
     1816                             )
     1817           ) .
     1818         define variable v-need-process as logical   no-undo .
     1819         run trg/ah-csptr.p
     1820           (input  buf_doc-list.doc-code
     1821           ,input  p-cut-date
     1822           ,input  false
     1823           ,output v-need-process
     1824           ).
     1825         run doclslib-log-information in this-procedure
     1826           (input p-log-handle
     1827           ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1828                             ,buf_doc-list.doc-code
     1829                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1830                             ,buf_doc-list.fact-order
     1831                             )
     1832           ) .
     1833         if  p-update-recalc  = true
     1834         and v-prev-fact-date <> ?
     1835         and buf_doc-list.fact-date > v-prev-fact-date
     1836         then do:
     1837           run gbl/clntat-w.p
     1838             (input p-obj-type
     1839             ,input p-obj-code
     1840             ,input 'ahsp-recalc':U
     1841             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1842             ) .
     1843           run doclslib-log-information in this-procedure
     1844             (input p-log-handle
     1845             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1846                              ,string(v-prev-fact-date, '99/99/9999':u)
     1847                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1848                              )
     1849             ) .
     1850         end.
     1851         assign
     1852           v-prev-fact-date = buf_doc-list.fact-date
     1853         .
     1854       end.
     1855     end.
     1856   end procedure.
     1857   procedure doclslib-log-information :
     1858     define input  parameter p-log-handle as handle    no-undo .
     1859     define input  parameter p-message    as character no-undo .
     1860     do
     1861     on error undo, return error return-value
     1862     :
     1863       define variable v-log-procedure-name as character no-undo .
     1864       assign
     1865         v-log-procedure-name = "cb-doclslib-log"
     1866       .
     1867       if valid-handle(p-log-handle)
     1868       and p-log-handle :get-signature(v-log-procedure-name) <> ""
     1869       then do:
     1870         run value(v-log-procedure-name) in p-log-handle
     1871           (input p-message
     1872           ) no-error .
     1873       end.
     1874     end.
     1875   end procedure.
     1876   procedure doclslib-find-last-fact-date :
     1877     define output parameter p-last-fact-date  as date      no-undo .
     1878     define output parameter p-reason          as character no-undo .
     1879     do
     1880     on error undo, return error
     1881     :
     1882       define variable v-last-fact-date    as date      no-undo .
     1883       define buffer buf_doc-list for doc-list .
     1884       assign
     1885         v-last-fact-date    = ?
     1886       .
     1887       for each buf_doc-list
     1888       by buf_doc-list.fact-order
     1889       on error undo, return error
     1890       :
     1891         if buf_doc-list.is-archive-exist = false
     1892         or buf_doc-list.fact-date = ?
     1893         then do:
     1894           assign
     1895             p-reason = p-reason + substitute("По документу &1 отсутствует рассчитанный складской архив"
     1896                                             ,buf_doc-list.doc-code
     1897                                             )
     1898           .
     1899           leave .
     1900         end.
     1901         if buf_doc-list.fact-date = ?
     1902         then do:
     1903           assign
     1904             p-reason = p-reason + substitute("Документ &1 имеет не заданную фактическую дату "
     1905                                             ,buf_doc-list.doc-code
     1906                                             )
     1907           .
     1908           leave .
     1909         end.
     1910         if v-last-fact-date = ?
     1911         or (v-last-fact-date <> ?
     1912             and v-last-fact-date < buf_doc-list.fact-date
     1913            )
     1914         then do:
     1915           assign
     1916             v-last-fact-date = buf_doc-list.fact-date
     1917             p-reason         = substitute("Последний рассчитанный документ &1" + chr(10)
     1918                                          ,buf_doc-list.doc-code
     1919                                          )
     1920           .
     1921         end.
     1922       end.
     1923       assign
     1924         p-last-fact-date = v-last-fact-date
     1925       .
     1926     end.
     1927   end procedure.
     1928   procedure doclslib-check-arh-exist :
     1929     define input parameter  p-obj-type       as character no-undo .
     1930     define input parameter  p-obj-code       as integer   no-undo .
     1931     define input parameter  p-cut-fact-order as decimal   no-undo .
     1932     define output parameter p-archive-exist  as logical   no-undo .
     1933     define buffer buf_stk-tot for ub.stk-tot .
     1934     do
     1935     on error undo, return error
     1936     :
     1937       find first buf_stk-tot no-lock
     1938         where buf_stk-tot.obj-type   = p-obj-type
     1939           and buf_stk-tot.obj-code   = p-obj-code
     1940           and buf_stk-tot.fact-order > p-cut-fact-order
     1941         no-error .
     1942       assign
     1943         p-archive-exist = (available buf_stk-tot)
     1944       .
     1945     end.
     1946   end procedure.
     1947   procedure doclslib-check-aht-exist :
     1948     define input parameter  p-obj-type       as character no-undo .
     1949     define input parameter  p-obj-code       as integer   no-undo .
     1950     define input parameter  p-cut-fact-order as decimal   no-undo .
     1951     define output parameter p-archive-exist  as logical   no-undo .
     1952     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     1953     do
     1954     on error undo, return error
     1955     :
     1956       find first buf_aht-stk-tot no-lock
     1957         where buf_aht-stk-tot.obj-type   = p-obj-type
     1958           and buf_aht-stk-tot.obj-code   = p-obj-code
     1959           and buf_aht-stk-tot.fact-order > p-cut-fact-order
     1960         no-error .
     1961       assign
     1962         p-archive-exist = (available buf_aht-stk-tot)
     1963       .
     1964     end.
     1965   end procedure.
     1966   procedure doclslib-check-ahsp-exist :
     1967     define input parameter  p-obj-type       as character no-undo .
     1968     define input parameter  p-obj-code       as integer   no-undo .
     1969     define input parameter  p-cut-fact-order as decimal   no-undo .
     1970     define output parameter p-archive-exist  as logical   no-undo .
     1971     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     1972     do
     1973     on error undo, return error
     1974     :
     1975       find first buf_stk-supp-tot no-lock
     1976         where buf_stk-supp-tot.obj-type   = p-obj-type
     1977           and buf_stk-supp-tot.obj-code   = p-obj-code
     1978           and buf_stk-supp-tot.fact-order > p-cut-fact-order
     1979         no-error .
     1980       assign
     1981         p-archive-exist = (available buf_stk-supp-tot)
     1982       .
     1983     end.
     1984   end procedure.
     1985   procedure doclslib-check-doc-arh-exist :
     1986     define buffer buf_doc-list for doc-list .
     1987     define buffer buf_ot-tot for ub.ot-tot .
     1988     do
     1989     on error undo, return error return-value
     1990     :
     1991       for each buf_doc-list
     1992       on error undo, return error
     1993       :
     1994         find first buf_ot-tot no-lock
     1995           where buf_ot-tot.doc-code = buf_doc-list.doc-code
     1996           no-error .
     1997         if available buf_ot-tot
     1998         then do:
     1999           assign
     2000             buf_doc-list.is-archive-exist = true
     2001           .
     2002         end.
     2003         else do:
     2004           assign
     2005             buf_doc-list.is-archive-exist = false
     2006           .
     2007         end.
     2008       end.
     2009     end.
     2010   end procedure.
     2011   procedure doclslib-check-doc-aht-exist :
     2012     define buffer buf_doc-list for doc-list .
     2013     define buffer buf_aht-doc for ub.aht-doc .
     2014     do
     2015     on error undo, return error return-value
     2016     :
     2017       for each buf_doc-list
     2018       on error undo, return error
     2019       :
     2020         find first buf_aht-doc no-lock
     2021           where buf_aht-doc.doc-code = buf_doc-list.doc-code
     2022           no-error .
     2023         if available buf_aht-doc
     2024         then do:
     2025           assign
     2026             buf_doc-list.is-archive-exist = true
     2027           .
     2028         end.
     2029         else do:
     2030           assign
     2031             buf_doc-list.is-archive-exist = false
     2032           .
     2033         end.
     2034       end.
     2035     end.
     2036   end procedure.
     2037   procedure doclslib-check-doc-ahsp-exist :
     2038     define buffer buf_doc-list for doc-list .
     2039     define buffer buf_ot-supp-line for ub.ot-supp-tot .
     2040     do
     2041     on error undo, return error return-value
     2042     :
     2043       for each buf_doc-list
     2044       on error undo, return error
     2045       :
     2046         find first buf_ot-supp-line no-lock
     2047           where buf_ot-supp-line.doc-code = buf_doc-list.doc-code
     2048           no-error .
     2049         if available buf_ot-supp-line
     2050         then do:
     2051           assign
     2052             buf_doc-list.is-archive-exist = true
     2053           .
     2054         end.
     2055         else do:
     2056           if buf_doc-list.doc-type = 'инв':U
     2057           then do:
     2058             define variable v-need-process as logical   no-undo .
     2059             run trg/ah-csptr.p
     2060               (input  buf_doc-list.doc-code
     2061               ,input  0
     2062               ,input  true
     2063               ,output v-need-process
     2064               ).
     2065             if v-need-process = true
     2066             then do:
     2067               assign
     2068                 buf_doc-list.is-archive-exist = false
     2069               .
     2070             end.
     2071             else do:
     2072               assign
     2073                 buf_doc-list.is-archive-exist = true
     2074               .
     2075             end.
     2076           end.
     2077           else do:
     2078             assign
     2079               buf_doc-list.is-archive-exist = false
     2080             .
     2081           end.
     2082         end.
     2083       end.
     2084     end.
     2085   end procedure.
     2086   procedure doclslib-clear-ahsp-doc-list :
     2087     define buffer buf_doc-list for doc-list .
     2088     define buffer buf_trn-doc  for ub.trn-doc .
     2089     define buffer buf_doc-line for ub.doc-line .
     2090     define buffer buf_parts    for ub.parts .
     2091     do
     2092     on error undo, return error return-value
     2093     :
     2094       check-doc-list :
     2095       for each buf_doc-list
     2096       on error undo, return error return-value
     2097       :
     2098         find first buf_trn-doc no-lock
     2099           where buf_trn-doc.doc-code = buf_doc-list.doc-code
     2100           .
     2101         if buf_trn-doc.office = true
     2102         then do:
     2103           delete buf_doc-list .
     2104           next check-doc-list .
     2105         end.
     2106         find first buf_doc-line no-lock
     2107           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2108           no-error .
     2109         if not available buf_doc-line
     2110         then do:
     2111           delete buf_doc-list .
     2112           next check-doc-list .
     2113         end.
     2114         find first buf_parts no-lock
     2115           where buf_parts.out-code = buf_trn-doc.doc-code
     2116             and buf_parts.fact-qnty <> 0
     2117           no-error .
     2118         if not available buf_parts
     2119         then do:
     2120           delete buf_doc-list .
     2121           next check-doc-list .
     2122         end.
     2123       end.
     2124     end.
     2125   end procedure.
     2126   procedure doclslib-init-goods :
     2127     define buffer buf_doclslib-goods for doclslib-goods .
     2128     define buffer buf_doc-list       for doc-list .
     2129     define buffer buf_trn-doc        for ub.trn-doc .
     2130     define buffer buf_price-doc      for ub.price-doc .
     2131     define buffer buf_doc-line       for ub.doc-line .
     2132     define buffer buf_price-list     for ub.price-list .
     2133     define variable v-gds-code as integer   no-undo .
     2134     do
     2135     on error undo, return error return-value
     2136     :
     2137       for each buf_doclslib-goods
     2138       on error undo, return error return-value
     2139       :
     2140         delete buf_doclslib-goods .
     2141       end.
     2142       for each buf_doc-list
     2143       on error undo, return error return-value
     2144       :
     2145         if buf_doc-list.is-trn-doc
     2146         then do:
     2147           find first buf_trn-doc no-lock
     2148             where buf_trn-doc.doc-code = buf_doc-list.doc-code
     2149             .
     2150           for each buf_doc-line no-lock
     2151             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2152           on error undo, return error return-value
     2153           :
     2154   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2156     (input  buf_doc-line.artic
     2157     ,input  buf_doc-line.prod-type
     2158     ,input  buf_doc-line.prod-code
     2159     ,output v-gds-code
     2160     )  .
     2161             find first buf_doclslib-goods
     2162               where buf_doclslib-goods.gds-code = v-gds-code
     2163               no-error .
     2164             if not available buf_doclslib-goods
     2165             then do:
     2166               create buf_doclslib-goods .
     2167               assign
     2168                 buf_doclslib-goods.gds-code  = v-gds-code
     2169                 buf_doclslib-goods.artic     = buf_doc-line.artic
     2170                 buf_doclslib-goods.prod-type = buf_doc-line.prod-type
     2171                 buf_doclslib-goods.prod-code = buf_doc-line.prod-code
     2172               .
     2173             end.
     2174           end.
     2175         end.
     2176         else do:
     2177           find first buf_price-doc no-lock
     2178             where buf_price-doc.doc-num = buf_doc-list.doc-code
     2179             .
     2180           for each buf_price-list no-lock
     2181             where buf_price-list.doc-num = buf_price-doc.doc-num
     2182           on error undo, return error return-value
     2183           :
     2184   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2185   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2186     (input  buf_price-list.artic
     2187     ,input  buf_price-list.prod-type
     2188     ,input  buf_price-list.prod-code
     2189     ,output v-gds-code
     2190     )  .
     2191             find first buf_doclslib-goods
     2192               where buf_doclslib-goods.gds-code = v-gds-code
     2193               no-error .
     2194             if not available buf_doclslib-goods
     2195             then do:
     2196               create buf_doclslib-goods .
     2197               assign
     2198                 buf_doclslib-goods.gds-code  = v-gds-code
     2199                 buf_doclslib-goods.artic     = buf_price-list.artic
     2200                 buf_doclslib-goods.prod-type = buf_price-list.prod-type
     2201                 buf_doclslib-goods.prod-code = buf_price-list.prod-code
     2202               .
     2203             end.
     2204           end.
     2205         end.
     2206       end.
     2207     end.
     2208   end procedure.
     2209   define stream slog .
     2210   do
     2211   on error undo, return error return-value
     2212   :
     2213     define variable v-today as date      no-undo .
     2214     define variable v-action as character no-undo .
     2215     def frame a
     2216       "Объект" p-obj-type no-label p-obj-code no-label skip
     2217       v-action format "x(50)" no-label skip
     2218       with view-as dialog-box side-labels three-d
     2219       title "Расчет складского архива по поставщикам"
     2220       .
     2221     view frame a .
     2222     define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
     2223     run gbl/lock-prc.p
     2224       (input 'ahsp':U
     2225       ,input p-obj-code
     2226       ,input 0
     2227       ,input 0
     2228       ,input p-obj-type
     2229       ,input ""
     2230       ,input ""
     2231       ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
     2232       ,input p-message-on
     2233       ,buffer calc-supp-arh-lock_batchprocess
     2234       ) no-error .
     2235     if error-status :error
     2236     then do:
     2237       if p-message-on = true
     2238       then do:
     2239         message
     2240           vss-workfile vss-revision vss-description skip
     2241           "Складской архив по поставщикам" skip
     2242           "Объект" p-obj-type p-obj-code skip
     2243           "В данный момент рассчитывается складской архив по поставщикам" skip
     2244           "Невозможно произвести расчет складского архива по поставщикам" skip
     2245           view-as alert-box error .
     2246       end.
     2247       undo, return error "Складской архив по поставщикам рассчитывается" .
     2248     end.
     2249     run log-information in this-procedure
     2250       (input p-obj-type
     2251       ,input p-obj-code
     2252       ,input "start"
     2253       ) .
     2254     run cb-doclslib-log in this-procedure
     2255       (input substitute("Начало расчёта архива. Проверять документы &1. Сообщения &2. Дата перерасчёта &3"
     2256                        ,p-check-doc
     2257                        ,p-message-on
     2258                        ,string(p-last-fact-date, '99/99/9999':U)
     2259                        )
     2260       ) .
     2261     define variable v-archive-exist as logical no-undo .
     2262     define variable v-attr-value as character no-undo .
     2263     define variable v-attr-type  as character no-undo .
     2264     define variable v-ahsp-del as logical   no-undo .
     2265     run clntattr-value in this-procedure
     2266       (input  p-obj-type
     2267       ,input  p-obj-code
     2268       ,input  'ahsp-del':U
     2269       ,output v-attr-value
     2270       ,output v-attr-type
     2271       ) .
     2272     assign
     2273       v-ahsp-del = (lookup(v-attr-value, 'yes,true') > 0)
     2274     .
     2275     if v-ahsp-del = true
     2276     then do:
     2277       if p-message-on = true
     2278       then do:
     2279         run cb-doclslib-log in this-procedure
     2280           (input "На объекте отсутствуют рассчитанные остатки"
     2281           ) .
     2282         message
     2283           "Складской архив по поставщикам" skip
     2284           "Объект" p-obj-type p-obj-code skip
     2285           "На объекте отсутствуют рассчитанные остатки" skip
     2286           "Расчет складского архива по поставщикам невозможен" skip
     2287           view-as alert-box error .
     2288       end.
     2289       undo, return error "Складской архив по поставщикам: отсутствуют остатки" .
     2290     end.
     2291     run clntattr-value in this-procedure
     2292       (input  p-obj-type
     2293       ,input  p-obj-code
     2294       ,input  'ahsp-detail':U
     2295       ,output v-attr-value
     2296       ,output v-attr-type
     2297       ) .
     2298     define variable v-ahsp-detail-date       as date    no-undo .
     2299     define variable v-ahsp-detail-fact-order as decimal no-undo .
     2300     assign
     2301       v-ahsp-detail-date = date(v-attr-value)
     2302     .
     2303     display
     2304       p-obj-type p-obj-code
     2305       with frame a.
     2306     define variable v-last-fact-date  as date    no-undo .
     2307     if p-check-doc = false
     2308     then do:
     2309       if p-last-fact-date = ?
     2310       then do:
     2311         if p-message-on = true
     2312         then do:
     2313           run cb-doclslib-log in this-procedure
     2314             (input "Ошибка задания входных параметров. Не задана дата перерасчёта"
     2315             ) .
     2316           message
     2317             vss-workfile vss-revision vss-description skip
     2318             "Ошибка задания входных параметров" skip
     2319             "Не задана дата перерасчета" skip
     2320             "Складской архив по поставщикам" skip
     2321             "Объект" p-obj-type p-obj-code skip
     2322             "Проверять наличие документов" p-check-doc skip
     2323             "Выводить сообщение" p-message-on skip
     2324             "Дата перерасчета" p-last-fact-date skip
     2325             view-as alert-box error .
     2326         end.
     2327         undo, return error "Не задана дата перерасчета складского архива по поставщикам" .
     2328       end.
     2329       else do:
     2330         assign
     2331           v-last-fact-date = p-last-fact-date
     2332         .
     2333       end.
     2334     end.
     2335     else do:
     2336       run show-action in this-procedure
     2337         (input "Составление списка документов"
     2338         ) .
     2339       run day-begin-fact-order in this-procedure
     2340         (input  v-ahsp-detail-date
     2341         ,output v-ahsp-detail-fact-order
     2342         ).
     2343       run doclslib-check-ahsp-exist in this-procedure
     2344         (input  p-obj-type
     2345         ,input  p-obj-code
     2346         ,input  v-ahsp-detail-fact-order
     2347         ,output v-archive-exist
     2348         ).
     2349       run doclslib-clear-doc-list in this-procedure .
     2350       run doclslib-init-trn-doc in this-procedure
     2351         (input p-obj-type
     2352         ,input p-obj-code
     2353         ,input v-ahsp-detail-date
     2354         ) no-error .
     2355       if error-status :error
     2356       then do:
     2357         message
     2358           vss-workfile vss-revision vss-description skip
     2359           "Складской архив по поставщикам" skip
     2360           "Объект" p-obj-type p-obj-code skip
     2361           "Ошибка при вызове процедуры doclslib-init-trn-doc" skip
     2362           error-status :get-message(1) skip
     2363           return-value skip
     2364           view-as alert-box error .
     2365         undo, return error return-value .
     2366       end.
     2367       run doclslib-clear-ahsp-doc-list in this-procedure
     2368         no-error .
     2369       if error-status :error
     2370       then do:
     2371         message
     2372           vss-workfile vss-revision vss-description skip
     2373           "Складской архив по поставщикам" skip
     2374           "Объект" p-obj-type p-obj-code skip
     2375           "Ошибка при вызове процедуры doclslib-clear-ahsp-doc-list" skip
     2376           error-status :get-message(1) skip
     2377           return-value skip
     2378           view-as alert-box error .
     2379         undo, return error return-value .
     2380       end.
     2381       if v-archive-exist = true
     2382       then do:
     2383         run doclslib-check-doc-ahsp-exist in this-procedure
     2384           .
     2385         define variable v-last-fact-date-reason as character no-undo .
     2386         run doclslib-find-last-fact-date in this-procedure
     2387           (output v-last-fact-date
     2388           ,output v-last-fact-date-reason
     2389           ) .
     2390         define variable v-ahsp-recalc      as character no-undo .
     2391         define variable v-ahsp-recalc-date as date      no-undo .
     2392         run clntattr-value in this-procedure
     2393           (input  p-obj-type
     2394           ,input  p-obj-code
     2395           ,input  'ahsp-recalc':U
     2396           ,output v-ahsp-recalc
     2397           ,output v-attr-type
     2398           ) .
     2399         assign
     2400           v-ahsp-recalc-date = date(v-ahsp-recalc)
     2401         .
     2402         if  v-ahsp-recalc-date <> ?
     2403         then do:
     2404           if v-last-fact-date = ?
     2405           or (v-last-fact-date <> ?
     2406               and
     2407               v-last-fact-date > v-ahsp-recalc-date
     2408              )
     2409           then do:
     2410             assign
     2411               v-last-fact-date        = v-ahsp-recalc-date
     2412               v-last-fact-date-reason = "Складской архив по поставщикам требует перерасчета из-за удаления или закрытия документа задним числом"
     2413             .
     2414           end.
     2415         end.
     2416         if  v-ahsp-detail-date <> ?
     2417         and v-last-fact-date   <> ?
     2418         and v-last-fact-date   < v-ahsp-detail-date
     2419         then do:
     2420           message
     2421             vss-workfile vss-revision vss-description skip
     2422             "Складской архив по поставщикам" skip
     2423             "Объект" p-obj-type p-obj-code skip
     2424             "Дата последнего рассчитанного документа" skip
     2425             "не может быть меньше чем дата начала подробного складского архива по поставщикам" skip
     2426             "Дата последнего рассчитанного документ" v-last-fact-date skip
     2427             "Дата начала подробного складского архива по поставщикам" v-ahsp-detail-date skip
     2428             view-as alert-box error .
     2429           undo, return error return-value .
     2430         end.
     2431         if p-message-on = true
     2432         then do:
     2433           define variable v-num as integer   no-undo .
     2434           run gbl/d-askw.w
     2435             (input "Вопрос"
     2436             ,input "На объекте уже есть рассчитанный складской архив по поставщикам" + chr(10)
     2437                 + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     2438             ,input "|^"
     2439             ,input "С последней" + (if v-last-fact-date = ? then "^disable" else "") + "|"
     2440                 + "С выбранной|Весь архив^confirm|Отмена"
     2441             ,input "Пересчитать складской архив по поставщикам начиная с даты " +
     2442                     (if v-last-fact-date <> ? then string(v-last-fact-date, '99/99/9999':u)
     2443                                                     + chr(10) + v-last-fact-date-reason
     2444                       else "?"
     2445                     ) + "|"
     2446                 + "Выбрать дату и пересчитать складской архив по поставщикам начиная с выбранной даты" + "|"
     2447                 + "Удалить складской архив по поставщикам и рассчитать их на основе документов" + chr(10)
     2448                 + (if v-ahsp-detail-date <> ?
     2449                   then "Будут рассмотрены документы с даты " + string(v-ahsp-detail-date, '99/99/9999')
     2450                   else ""
     2451                   )
     2452                 + "|"
     2453                 + "Отказаться от расчета складского архива по поставщикам"
     2454             ,input 1
     2455             ,input 4
     2456             ,output v-num
     2457             ).
     2458           case v-num :
     2459             when 1
     2460             then do:
     2461               run cb-doclslib-log in this-procedure
     2462                 (input substitute("Выбор пользователя 1. Пересчитать с последней даты &1"
     2463                                  ,string(v-last-fact-date, '99/99/9999':u)
     2464                                  )
     2465                 ) .
     2466             end.
     2467             when 2
     2468             then do:
     2469               update-block:
     2470               do while true
     2471               :
     2472                 if v-ahsp-recalc-date <> ?
     2473                 then do:
     2474                   assign
     2475                     v-today = v-ahsp-recalc-date
     2476                   .
     2477                 end.
     2478                 else do:
     2479   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2481     (input  p-obj-type
     2482     ,input  p-obj-code
     2483     ,output v-today
     2484     )  .
     2485                 end.
