        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.PromoGoods.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo init "Тригер удаления PromoGoods".
        9   define buffer buf_promogoods for PromoGoods.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   procedure gen-key-rec :
      306     define input  parameter p-tbl-name    as character no-undo.
      307     define input  parameter p-bh_tbl-name as handle    no-undo.
      308     define output parameter p-key-rec     as character no-undo.
      309     do
      310     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      311     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      312     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      313     :
      314       define variable fh               as handle    no-undo .
      315       define variable v-ok             as logical   no-undo .
      316       define variable v-inform         as character no-undo .
      317       define variable v-ind            as integer   no-undo .
      318       define variable v-idx-field-qnty as integer   no-undo .
      319       if p-tbl-name = ?
      320         or p-tbl-name = "":U
      321       then do:
      322         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      323       end.
      324       if not p-bh_tbl-name:available then do:
      325         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      326       end.
      327       assign
      328         p-key-rec = p-tbl-name
      329         v-inform  = p-bh_tbl-name:index-information(1)
      330         v-ind     = 2
      331       .
      332       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      333       on error undo, return error
      334       :
      335         assign
      336           v-inform = p-bh_tbl-name:index-information( v-ind )
      337           v-ind    = v-ind + 1
      338         .
      339       end.
      340       if v-inform = ?
      341         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      342         or entry( 3, v-inform, ",":U ) <> "1":U
      343       then do:
      344         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      345       end.
      346       else do:
      347         assign
      348           v-idx-field-qnty = num-entries( v-inform ) - 4
      349         .
      350         if v-idx-field-qnty < 2 then do:
      351           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      352         end.
      353         do v-ind = 1 to v-idx-field-qnty by 2
      354         on error undo, return error
      355         :
      356           assign
      357             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      358             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      359           .
      360         end.
      361       end.
      362       if p-key-rec = ? then do:
      363         assign
      364           p-key-rec = "":U
      365         .
      366         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      367       end.
      368     end.
      369     return.
      370   end procedure.
      371   procedure gen-where-keyr-tab :
      372     define input  parameter i-tableSerach as character no-undo.
      373     define input  parameter i-tablekey   as character  no-undo.
      374     define input  parameter p-key-rec    as character  no-undo.
      375     define input  parameter p-key-handle as handle     no-undo .
      376     define input  parameter p-db-name    as character  no-undo .
      377     define input  parameter p-tt-handle  as handle     no-undo .
      378     define output parameter o-Where      as character  no-undo.
      379     do
      380     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      381     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      382     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      383     :
      384       define variable v-full-tbl-name  as character no-undo .
      385       define variable bh_tbl-name      as handle    no-undo .
      386       define variable fh_key           as handle    no-undo .
      387       define variable fh_search        as handle    no-undo .
      388       define variable v-field-num      as integer   no-undo .
      389       define variable v-count-fld      as integer   no-undo .
      390       define variable v-inform         as character no-undo .
      391       define variable v-ind            as integer   no-undo .
      392       define variable v-idx-field-qnty as integer   no-undo .
      393       define variable v-field-name     as character no-undo .
      394       define variable v-field-val      as character no-undo .
      395       define variable v-word-link      as character no-undo .
      396       define variable vTable           as character no-undo.
      397       define variable bh_tbl-key       as handle    no-undo .
      398       assign
      399         p-key-rec = trim( p-key-rec )
      400       .
      401       if p-key-handle <> ? then do:
      402         if not valid-handle(p-key-handle)
      403            or p-key-handle:type <> "buffer"
      404         then do:
      405           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      406         end.
      407         if num-entries( p-key-rec, chr(3) ) > 1
      408           or p-key-rec = ?
      409           or p-key-rec = "":U
      410         then do:
      411           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      412         end.
      413       end.
      414       else do:
      415         if p-key-rec = ?
      416           or p-key-rec = "":U
      417         then do:
      418           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      419         end.
      420       end.
      421       assign
      422         vTable = entry( 1 , p-key-rec, chr(3) )
      423       .
      424       if p-tt-handle <> ?
      425         and ( not valid-handle(p-tt-handle)
      426               or p-tt-handle:type <> "buffer"
      427             )
      428       then do:
      429         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      430       end.
      431       if p-tt-handle = ? then do:
      432         assign
      433           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      434         .
      435         create buffer bh_tbl-name for table v-full-tbl-name .
      436       end.
      437       else do:
      438         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      439       end.
      440       assign
      441         v-inform = bh_tbl-name:index-information(1)
      442         v-ind    = 2
      443       .
      444       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      445       on error undo, return error
      446       :
      447         assign
      448           v-inform = bh_tbl-name:index-information( v-ind )
      449           v-ind    = v-ind + 1
      450         .
      451       end.
      452       if v-inform = ?
      453         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      454         or entry( 3, v-inform, ",":U ) <> "1":U
      455       then do:
      456         delete object bh_tbl-name no-error.
      457         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      458       end.
      459       assign
      460         v-idx-field-qnty = num-entries( v-inform ) - 4
      461       .
      462       if v-idx-field-qnty < 2 then do:
      463         delete object bh_tbl-name no-error.
      464         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      465       end.
      466       assign
      467         o-where     = "where":U
      468         v-word-link = "":U
      469         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      470         v-count-fld = 0
      471       .
      472       if i-tablekey ne "" and i-tablekey ne ?
      473       then do:
      474         assign
      475           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      476         .
      477         create buffer bh_tbl-key for table v-full-tbl-name .
      478       end.
      479       if i-tableSerach ne "" and i-tableSerach ne ?
      480       then do:
      481         delete object bh_tbl-name no-error.
      482         assign
      483           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      484         .
      485         create buffer bh_tbl-name for table v-full-tbl-name .
      486       end.
      487       block_where:
      488       do v-ind = 1 to v-idx-field-qnty by 2
      489       on error undo, return error
      490       :
      491         assign
      492           v-count-fld = v-count-fld + 1
      493         .
      494         if p-key-handle = ?
      495           and v-count-fld > v-field-num
      496         then do:
      497           leave block_where.
      498         end.
      499         define variable VfieldKeyTable as handle no-undo.
      500         assign
      501           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      502           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      503         .
      504         if     bh_tbl-key ne ?
      505         then do:
      506            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      507            if VfieldKeyTable eq ?
      508            then next block_where.
      509         end.
      510         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      511         then
      512            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      513         else
      514            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      515         if p-key-handle = ? then do:
      516           assign
      517             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      518           .
      519         end.
      520         else do:
      521           assign
      522             fh_key = p-key-handle:buffer-field( v-field-name )
      523           .
      524           if fh_key = ?
      525             or not valid-handle( fh_key )
      526           then do:
      527             delete object bh_tbl-name.
      528             if     bh_tbl-key ne ?
      529             then
      530                delete object bh_tbl-key.
      531             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      532           end.
      533           assign
      534             v-field-val = fh_key:buffer-value
      535           .
      536         end.
      537         if fh_search:data-type ="character":U then do:
      538           assign
      539             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      540             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      541             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      542             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      543             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      544             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      545             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      546             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      547             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      548             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      549             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      550             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      551             v-field-val = substitute( '"&1"', v-field-val )
      552           .
      553         end.
      554         assign
      555           o-where = substitute( "&1 &2", o-where, v-field-val )
      556         .
      557         if v-word-link = "":U then do:
      558           assign
      559             v-word-link = "and":U
      560           .
      561         end.
      562       end.
      563       delete object bh_tbl-name.
      564       if     bh_tbl-key ne ?
      565       then
      566          delete object bh_tbl-key.
      567       if p-key-handle = ?
      568         and v-count-fld <> v-field-num
      569       then do:
      570         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      571       end.
      572     end.
      573   end procedure.
      574   procedure gen-hn-keyr-tab :
      575     define input  parameter i-tableSerach as character no-undo.
      576     define input  parameter i-tablekey   as character no-undo.
      577     define input  parameter p-key-rec    as character no-undo.
      578     define input  parameter p-key-handle as handle    no-undo .
      579     define input  parameter p-db-name    as character no-undo .
      580     define input  parameter p-tt-handle  as handle    no-undo .
      581     define input  parameter p-stts-lock  as integer   no-undo .
      582     define output parameter o-hn         as handle    no-undo.
      583     define variable v-full-tbl-name as character no-undo.
      584     define variable v-where         as character no-undo.
      585     define variable bh_tbl-name     as handle    no-undo.
      586     define variable vTable          as character no-undo.
      587     do
      588     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      589     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      590     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      591         run gen-where-keyr-tab(i-tableSerach,
      592                                i-tablekey,
      593                                p-key-rec,
      594                                p-key-handle,
      595                                p-db-name,
      596                                p-tt-handle,
      597                                output v-where).
      598         if i-tableSerach ne "" and i-tableSerach ne ?
      599         then do:
      600            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      601            create buffer bh_tbl-name for table v-full-tbl-name .
      602         end.
      603         else do:
      604            if p-tt-handle = ? then do:
      605               assign
      606                  vTable = entry( 1 , p-key-rec, chr(3) )
      607               .
      608               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      609               create buffer bh_tbl-name for table v-full-tbl-name .
      610            end.
      611            else do:
      612               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      613            end.
      614         end.
      615         if p-tt-handle = ? then do:
      616            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      617         end.
      618         else do:
      619            bh_tbl-name:find-first( v-where ) no-error .
      620         end.
      621         o-hn = bh_tbl-name.
      622      end.
      623   end procedure.
      624   procedure gen-hn-keyr :
      625     define input  parameter p-key-rec    as character no-undo.
      626     define input  parameter p-key-handle as handle    no-undo .
      627     define input  parameter p-db-name    as character no-undo .
      628     define input  parameter p-tt-handle  as handle    no-undo .
      629     define input  parameter p-stts-lock  as integer   no-undo .
      630     define output parameter o-hn         as handle    no-undo.
      631     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      632   end.
      633   procedure gen-row-keyr :
      634     define input  parameter p-key-rec    as character no-undo.
      635     define input  parameter p-key-handle as handle    no-undo .
      636     define input  parameter p-db-name    as character no-undo .
      637     define input  parameter p-tt-handle  as handle    no-undo .
      638     define input  parameter p-stts-lock  as integer   no-undo .
      639     define output parameter p-tbl-row    as rowid     no-undo.
      640     define output parameter p-tbl-name   as character no-undo.
      641     define variable vHn as handle no-undo.
      642       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      643       p-tbl-row = if vHn:available then vHn:rowid else ?.
      644       p-tbl-name =  vHn:table.
      645       delete object vHn no-error.
      646     if p-tbl-row = ? then do:
      647       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      648     end.
      649     else do:
      650       return.
      651     end.
      652   end procedure.
      653   procedure gen-key-fv :
      654     define input  parameter p-key-rec    as character no-undo .
      655     define output parameter p-field-list as character no-undo .
      656     define output parameter p-value-list as character no-undo.
      657     do
      658     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      659     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      660     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      661     :
      662       define variable v-full-tbl-name  as character no-undo .
      663       define variable bh_tbl-name      as handle    no-undo .
      664       define variable v-tbl-name       as character no-undo .
      665       define variable v-field-num      as integer   no-undo .
      666       define variable v-count-fld      as integer   no-undo .
      667       define variable v-inform         as character no-undo .
      668       define variable v-ind            as integer   no-undo .
      669       define variable v-idx-field-qnty as integer   no-undo .
      670       define variable v-delim-key      as character no-undo .
      671       if p-key-rec = ?
      672         or p-key-rec = "":U
      673       then do:
      674         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      675       end.
      676       assign
      677         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      678         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      679       .
      680       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      681       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      682       assign
      683         v-inform = bh_tbl-name:index-information(1)
      684         v-ind    = 2
      685       .
      686       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      687       on error undo, return error
      688       :
      689         assign
      690           v-inform = bh_tbl-name:index-information( v-ind )
      691           v-ind    = v-ind + 1
      692         .
      693       end.
      694       if v-inform = ?
      695         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      696         or entry( 3, v-inform, ",":U ) <> "1":U
      697       then do:
      698         delete object bh_tbl-name no-error.
      699         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      700       end.
      701       assign
      702         v-idx-field-qnty = num-entries( v-inform ) - 4
      703       .
      704       if v-idx-field-qnty < 2 then do:
      705         delete object bh_tbl-name no-error.
      706         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      707       end.
      708       assign
      709         p-field-list = "":U
      710         p-value-list = "":U
      711         v-delim-key  = "":U
      712         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      713         v-count-fld  = 0
      714       .
      715       block_where:
      716       do v-ind = 1 to v-idx-field-qnty by 2
      717       on error undo, return error
      718       :
      719         assign
      720           v-count-fld = v-count-fld + 1
      721         .
      722         if v-count-fld > v-field-num then do:
      723           leave block_where.
      724         end.
      725         assign
      726           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      727           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      728         .
      729         if v-ind = 1 then do:
      730           assign
      731             v-delim-key = chr(3)
      732           .
      733         end.
      734       end.
      735       delete object bh_tbl-name.
      736       if v-count-fld <> v-field-num then do:
      737         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      738       end.
      739     end.
      740   end procedure.
      741   procedure gen-key-field :
      742     define input  parameter p-table      as character no-undo .
      743     define output parameter p-field-list as character no-undo .
      744     do
      745     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      746     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      747     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      748     :
      749       define variable v-full-tbl-name  as character no-undo .
      750       define variable bh_tbl-name      as handle    no-undo .
      751       define variable v-tbl-name       as character no-undo .
      752       define variable v-field-num      as integer   no-undo .
      753       define variable v-count-fld      as integer   no-undo .
      754       define variable v-inform         as character no-undo .
      755       define variable v-ind            as integer   no-undo .
      756       define variable v-idx-field-qnty as integer   no-undo .
      757       define variable v-delim-key      as character no-undo .
      758       if p-table = ?
      759         or p-table = "":U
      760       then do:
      761         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      762       end.
      763       assign
      764         v-tbl-name      = p-table
      765         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      766       .
      767       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      768       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      769       assign
      770         v-inform = bh_tbl-name:index-information(1)
      771         v-ind    = 2
      772       .
      773       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      774       on error undo, return error
      775       :
      776         assign
      777           v-inform = bh_tbl-name:index-information( v-ind )
      778           v-ind    = v-ind + 1
      779         .
      780       end.
      781       if v-inform = ?
      782         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      783         or entry( 3, v-inform, ",":U ) <> "1":U
      784       then do:
      785         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      786       end.
      787       assign
      788         v-idx-field-qnty = num-entries( v-inform ) - 4
      789       .
      790       if v-idx-field-qnty < 2 then do:
      791         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      792       end.
      793       assign
      794         p-field-list = "":U
      795         v-delim-key  = "":U
      796         v-count-fld  = 0
      797       .
      798       block_where:
      799       do v-ind = 1 to v-idx-field-qnty by 2
      800       on error undo, return error
      801       :
      802         assign
      803           v-count-fld = v-count-fld + 1
      804         .
      805         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      806         if v-ind = 1 then do:
      807           assign
      808             v-delim-key = chr(3)
      809           .
      810         end.
      811       end.
      812       delete object bh_tbl-name.
      813     end.
      814   end procedure.
      815   define buffer buf_c-PromoGoods  for ub.c-PromoGoods .
      816   define variable v-date      as date      no-undo .
      817   define variable v-time      as integer   no-undo .
      818   define variable v-field-chg as character no-undo .
      819   define variable v-Seq       as int64     no-undo init ?.
      820   define variable vFlagseq    as logical no-undo.
      821   define variable vuniq-key-rec as character no-undo.
      822   define variable v-rowid as rowid no-undo.
      823   define variable v-tbl-name as character no-undo.
      824       run cur-time in this-procedure (output v-date, output v-time).
      825       publish "getNextseq" ("PromoGoods","s-promo-chip", "ub", output v-Seq ).
      826       if v-Seq = ?
      827       then
      828          v-Seq  = next-value (s-promo-chip, ub).
      829       else
      830          vFlagSeq = yes.
      831       if vFlagseq
      832       then do:
      833    for first buf_c-PromoGoods where buf_c-PromoGoods.id eq PromoGoods.id
      834   and buf_c-PromoGoods.db-num eq PromoGoods.db-num
      835     and buf_c-PromoGoods.corr-user-db-num   = g#db-num and buf_c-PromoGoods.chip-num = v-Seq exclusive-lock: leave. end.
      836       end.
      837       if not available buf_c-PromoGoods
      838       then do:
      839          create buf_c-PromoGoods.
      840          buffer-copy ub.PromoGoods to buf_c-PromoGoods
      841          assign
      842            buf_c-PromoGoods.chip-num           = v-Seq
      843            buf_c-PromoGoods.corr-date          = v-date
      844            buf_c-PromoGoods.corr-time          = v-time
      845            buf_c-PromoGoods.corr-user-db-num   = g#db-num
      846            buf_c-PromoGoods.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
      847            buf_c-PromoGoods.action             = 99
      848            buf_c-PromoGoods.is-del             = true
      849          .
      850       end.
      851       else
      852          buf_c-PromoGoods.action             = 99.
      853     if not g#news then do :
      854       run nws/cmd-del.p
      855         ( input 'PromoGoods':U
      856          ,input (buffer ub.PromoGoods:handle)
      857          ,input "":U
      858         ) no-error .
      859       if error-status :error then do:
      860         message
      861           vss-workfile vss-revision vss-description skip
      862           "Невозможно маршрутизировать удаление PromoGoods для отправки в новости" skip
      863           error-status :get-message(1) skip
      864           return-value skip
      865           view-as alert-box error .
      866         undo , return error return-value .
      867       end.
      868       end.
      869     for each buf_promogoods where buf_promogoods.idaction eq PromoGoods.idAction
      870                             and buf_promogoods.IdSet      eq PromoGoods.id
      871     exclusive-lock:
      872        delete buf_promogoods.
      873     end.
      874     for each  ub.PromoAttr where ub.PromoAttr.tablename eq "PromoGoods"
      875                               and ub.PromoAttr.p-key     eq string(ub.PromoGoods.id) + chr(3) + string(ub.PromoGoods.db-num)
      876      exclusive-lock:
      877          delete ub.PromoAttr.
      878      end.
