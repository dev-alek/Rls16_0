      773   define variable v-export-archive as logical   no-undo .
      774   define variable v-action         as character no-undo .
      775   define stream slog .
      776   define temp-table temp-goods no-undo
      777     field gds-code  as integer
      778     field artic     as character
      779     field prod-type as character
      780     field prod-code as integer
      781     index xpk is primary unique gds-code
      782     index xie artic prod-type prod-code
      783     .
      784   define temp-table temp-ot-tot no-undo like ub.ot-tot
      785     .
      786   define temp-table temp-ot-line no-undo like ub.ot-line
      787     field gds-code as integer
      788     .
      789   define temp-table temp-stk-tot no-undo like ub.stk-tot
      790     .
      791   define temp-table temp-stk-line no-undo like ub.stk-line
      792     field gds-code as integer
      793     .
      794   define buffer buf_ot-tot        for ub.ot-tot     .
      795   define buffer buf_ot-line       for ub.ot-line    .
      796   define buffer buf_stk-tot       for ub.stk-tot    .
      797   define buffer buf_stk-line      for ub.stk-line   .
      798   define buffer buf_temp-ot-tot   for temp-ot-tot   .
      799   define buffer buf_temp-ot-line  for temp-ot-line  .
      800   define buffer buf_temp-stk-tot  for temp-stk-tot  .
      801   define buffer buf_temp-stk-line for temp-stk-line .
      802   main-block:
      803   do
      804   on error undo main-block, return error
      805   :
      806     if  v-export-file-name <> ""
      807     and v-export-file-name <> ?
      808     then do:
      809       assign
      810         v-export-archive = true
      811         v-action         = "Экспорт складского архива по товарам"
      812       .
      813     end.
      814     else do:
      815       assign
      816         v-export-archive = false
      817         v-action         = "Очистка складского архива по товарам"
      818       .
      819     end.
      820     define variable v-obj-type       like ub.gds-obj.obj-type no-undo .
      821     define variable v-obj-code       like ub.gds-obj.obj-code no-undo .
      822     define variable v-start-time     as integer   no-undo .
      823     define variable v-current-time   as character no-undo .
      824     define variable v-current-action as character no-undo .
      825     define variable v-count          as integer   no-undo .
      826     define variable v-sub-action     as character no-undo .
      827     def frame a
      828       v-obj-type       label "Объект"
      829       v-obj-code       no-label skip
      830       v-current-action format "x(40)" no-label skip
      831       v-current-time   format "x(8)"  label "Время очистки архива" skip
      832       v-count          format ">>>,>>>,>>9" no-label skip
      833       v-sub-action     format "x(40)" no-label skip
      834       with view-as dialog-box side-labels three-d
      835       title v-action
      836       .
      837     assign
      838       v-obj-type   = p-obj-type
      839       v-obj-code   = p-obj-code
      840       v-start-time = time
      841     .
      842     view frame a .
      843     display
      844       v-obj-type
      845       v-obj-code
      846       with frame a .
      847     if v-export-archive = true
      848     then do:
      849       output stream slog to value(v-export-file-name) append .
      850     end.
      851     define variable v-obj-exist as logical no-undo .
      852   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      854     (input  p-obj-type
      855     ,input  p-obj-code
      856     ,input  'check-exist':u
      857     ,output v-obj-exist
      858     )  .
      859     if p-cut-fact-order = ?
      860     then do:
      861       message
      862         vss-workfile vss-revision vss-description skip
      863         "Ошибка задания входных параметров" skip
      864         "Объект" p-obj-type p-obj-code skip
      865         "p-cut-fact-order" p-cut-fact-order skip
      866         view-as alert-box error .
      867       undo, return error .
      868     end.
      869     define variable v-max-fact-order as decimal   no-undo .
      870     run factord-max-fact-order in this-procedure
      871       (output v-max-fact-order
      872       ) .
      873     if p-cut-fact-order = 0
      874     then do:
      875       assign
      876         p-cut-fact-order = v-max-fact-order
      877       .
      878     end.
      879     define variable v-attr-value as character no-undo .
      880     define variable v-attr-type  as character no-undo .
      881     run clntattr-value in this-procedure
      882       (input  p-obj-type
      883       ,input  p-obj-code
      884       ,input  'arh-detail':U
      885       ,output v-attr-value
      886       ,output v-attr-type
      887       ) .
      888     define variable v-cut-date       as date    no-undo .
      889     define variable v-cut-fact-order as decimal no-undo .
      890     if v-attr-type = 'T':U
      891     then do:
      892       assign
      893         v-cut-date = date(v-attr-value)
      894       .
      895     end.
      896     else do:
      897       message
      898         vss-workfile vss-revision vss-description skip
      899         "Неправильный тип атрибута" 'arh-detail':U skip
      900         "Тип атрибута" v-attr-type skip
      901         view-as alert-box error .
      902       undo, return error .
      903     end.
      904     run day-begin-fact-order in this-procedure
      905       (input  v-cut-date
      906       ,output v-cut-fact-order
      907       ).
      908     if p-last-fact-order = ?
      909     then do:
      910       message
      911         vss-workfile vss-revision vss-description skip
      912         "Ошибка при задании входных параметров" skip
      913         "Не задана дата начиная с которой необходимо удалить складской архив по товарам" skip
      914         "Объект" p-obj-type p-obj-code skip
      915         "v-cut-fact-order"  v-cut-fact-order skip
      916         "p-last-fact-order" p-last-fact-order skip
      917         view-as alert-box error .
      918       undo, return error .
      919     end.
      920     if v-export-archive = false
      921     then do:
      922       if  (v-cut-fact-order  <= p-last-fact-order
      923            and p-last-fact-order <= p-cut-fact-order )
      924       or  (p-last-fact-order <= p-cut-fact-order
      925            and p-cut-fact-order <= v-cut-fact-order
      926           )
      927       then do:
      928       end.
      929       else do:
      930         message
      931           vss-workfile vss-revision vss-description skip
      932           "Ошибка при удалении складского архива по товарам" skip
      933           "Неправильный диапазон удаления складского архива по товарам" skip
      934           "Объект" p-obj-type p-obj-code skip
      935           "v-cut-fact-order"  v-cut-fact-order skip
      936           "p-last-fact-order" p-last-fact-order skip
      937           "p-cut-fact-order" p-cut-fact-order skip
      938           view-as alert-box error .
      939         undo, return error .
      940       end.
      941     end.
      942     define variable v-ind as integer no-undo .
      943     run show-action in this-procedure
      944       (input "Итоги по документам"
      945       ).
      946     for each buf_ot-tot
      947       where buf_ot-tot.obj-type   = p-obj-type
      948         and buf_ot-tot.obj-code   = p-obj-code
      949         and buf_ot-tot.fact-order > p-last-fact-order
      950         and buf_ot-tot.fact-order <= p-cut-fact-order
      951     on error undo main-block, return error
      952     :
      953       assign
      954         v-ind = v-ind + 1
      955       .
      956       if v-ind modulo 10 = 0
      957       then do:
      958         run show-count in this-procedure
      959           (input v-ind
      960           ,input "Документ " + string(buf_ot-tot.doc-code)
      961           ).
      962       end.
      963       if v-export-archive = true
      964       then do:
      965         create buf_temp-ot-tot .
      966         buffer-copy buf_ot-tot to buf_temp-ot-tot .
      967         export stream slog 'ot-tot':U .
      968         export stream slog buf_temp-ot-tot .
      969         delete buf_temp-ot-tot .
      970       end.
      971       else do:
      972         delete buf_ot-tot .
      973       end.
      974     end.
      975     run show-action in this-procedure
      976       (input "Итоги по строкам документов"
      977       ).
      978     for each buf_ot-line
      979       where buf_ot-line.obj-type   = p-obj-type
      980         and buf_ot-line.obj-code   = p-obj-code
      981         and buf_ot-line.fact-order > p-last-fact-order
      982         and buf_ot-line.fact-order <= p-cut-fact-order
      983     on error undo main-block, return error
      984     :
      985       assign
      986         v-ind = v-ind + 1
      987       .
      988       if v-ind modulo 10 = 0
      989       then do:
      990         run show-count in this-procedure
      991           (input v-ind
      992           ,input "Документ " + string(buf_ot-line.doc-code)
      993                   + " Артикул " + string(buf_ot-line.artic)
      994           ).
      995       end.
      996       if v-export-archive = true
      997       then do:
      998         create buf_temp-ot-line  .
      999         buffer-copy buf_ot-line to buf_temp-ot-line .
     1000         run fill-gds-code in this-procedure
     1001           (input  buf_temp-ot-line.artic
     1002           ,input  buf_temp-ot-line.prod-type
     1003           ,input  buf_temp-ot-line.prod-code
     1004           ,output buf_temp-ot-line.gds-code
     1005           ) .
     1006         export stream slog 'ot-line':U .
     1007         export stream slog buf_temp-ot-line except artic prod-type prod-code .
     1008         delete buf_temp-ot-line  .
     1009       end.
     1010       else do:
     1011         delete buf_ot-line .
     1012       end.
     1013     end.
     1014     run show-action in this-procedure
     1015       (input "Итоги по объекту"
     1016       ).
     1017     for each buf_stk-tot
     1018       where buf_stk-tot.obj-type   = p-obj-type
     1019         and buf_stk-tot.obj-code   = p-obj-code
     1020         and buf_stk-tot.fact-order > p-last-fact-order
     1021         and buf_stk-tot.fact-order <= p-cut-fact-order
     1022     on error undo main-block, return error
     1023     :
     1024       assign
     1025         v-ind = v-ind + 1
     1026       .
     1027       if v-ind modulo 10 = 0
     1028       then do:
     1029         run show-count in this-procedure
     1030           (input v-ind
     1031           ,input "Дата " + string(buf_stk-tot.fact-date, '99/99/9999':U )
     1032           ).
     1033       end.
     1034       if v-export-archive = true
     1035       then do:
     1036         create buf_temp-stk-tot .
     1037         buffer-copy buf_stk-tot to buf_temp-stk-tot .
     1038         export stream slog 'stk-tot':U .
     1039         export stream slog buf_temp-stk-tot .
     1040         delete buf_temp-stk-tot .
     1041       end.
     1042       else do:
     1043         delete buf_stk-tot .
     1044       end.
     1045     end.
     1046     run show-action in this-procedure
     1047       (input "Итоги по товарам на объекте"
     1048       ).
     1049     for each buf_stk-line
     1050       where buf_stk-line.obj-type   = p-obj-type
     1051         and buf_stk-line.obj-code   = p-obj-code
     1052         and buf_stk-line.fact-order > p-last-fact-order
     1053         and buf_stk-line.fact-order <= p-cut-fact-order
     1054     on error undo main-block, return error
     1055     :
     1056       assign
     1057         v-ind = v-ind + 1
     1058       .
     1059       if v-ind modulo 10 = 0
     1060       then do:
     1061         run show-count in this-procedure
     1062           (input v-ind
     1063           ,input "Артикул " + string(buf_stk-line.artic)
     1064           ).
     1065       end.
     1066       if v-export-archive = true
     1067       then do:
     1068         create buf_temp-stk-line .
     1069         buffer-copy buf_stk-line to buf_temp-stk-line .
     1070         run fill-gds-code in this-procedure
     1071           (input  buf_temp-stk-line.artic
     1072           ,input  buf_temp-stk-line.prod-type
     1073           ,input  buf_temp-stk-line.prod-code
     1074           ,output buf_temp-stk-line.gds-code
     1075           ) .
     1076         export stream slog 'stk-line':U .
     1077         export stream slog buf_temp-stk-line except artic prod-type prod-code .
     1078         delete buf_temp-stk-line .
     1079       end.
     1080       else do:
     1081         delete buf_stk-line .
     1082       end.
     1083     end.
     1084     if v-export-archive = true
     1085     then do:
     1086       output stream slog close .
     1087     end.
     1088   end.
     1089   procedure show-action :
     1090     define input  parameter p-action as character no-undo .
     1091     do
     1092     on error undo, return error
     1093     :
     1094       assign
     1095         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1096         v-current-action = p-action
     1097       .
     1098       display
     1099         v-current-time
     1100         v-current-action
     1101         with frame a.
     1102     end.
     1103   end procedure.
     1104   procedure show-count :
     1105     define input  parameter p-count      as integer   no-undo .
     1106     define input  parameter p-sub-action as character no-undo .
     1107     do
     1108     on error undo, return error
     1109     :
     1110       assign
     1111         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1112         v-count        = p-count
     1113         v-sub-action   = p-sub-action
     1114       .
     1115       display
     1116         v-current-time
     1117         v-count
     1118         v-sub-action
     1119         with frame a.
     1120     end.
     1121   end procedure.
     1122   procedure fill-gds-code :
     1123     define input  parameter p-artic     as character no-undo .
     1124     define input  parameter p-prod-type as character no-undo .
     1125     define input  parameter p-prod-code as integer   no-undo .
     1126     define output parameter p-gds-code  as integer   no-undo .
     1127     define buffer buf_temp-goods for temp-goods .
     1128     define buffer buf_goods for ub.goods .
     1129     do
     1130     on error undo, return error return-value
     1131     :
     1132       find first buf_temp-goods
     1133         where buf_temp-goods.artic     = p-artic
     1134           and buf_temp-goods.prod-type = p-prod-type
     1135           and buf_temp-goods.prod-code = p-prod-code
     1136         no-error .
     1137       if not available buf_temp-goods
     1138       then do:
     1139         find first buf_goods no-lock
     1140           where buf_goods.artic     = p-artic
     1141             and buf_goods.prod-type = p-prod-type
     1142             and buf_goods.prod-code = p-prod-code
     1143           no-error .
     1144         if not available buf_goods
     1145         then do:
     1146           message
     1147             vss-workfile vss-revision vss-description skip
     1148             "Не найден товар" skip
     1149             "Товар" p-artic p-prod-type p-prod-code skip
     1150             view-as alert-box error .
     1151           undo, return error return-value .
     1152         end.
     1153         create buf_temp-goods .
     1154         assign
     1155           buf_temp-goods.artic     = p-artic
     1156           buf_temp-goods.prod-type = p-prod-type
     1157           buf_temp-goods.prod-code = p-prod-code
     1158           buf_temp-goods.gds-code  = buf_goods.gds-code
     1159         .
     1160       end.
     1161       assign
     1162         p-gds-code = buf_temp-goods.gds-code
     1163       .
     1164     end.
     1165   end procedure.
