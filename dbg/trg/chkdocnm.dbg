        1   block-level on error undo, throw.
        2   define input parameter p-doc-code   as character no-undo .
        3   define input parameter p-table-name as character no-undo .
        4   define input parameter p-recid      as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Проверка уникальности кода документа".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2|&3',p-doc-code,p-table-name,p-recid)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   main-block:
       73   do
       74   on error undo main-block, return error
       75   :
       76     define buffer buf_trn-doc   for ub.trn-doc .
       77     define buffer buf_price-doc for ub.price-doc .
       78     define buffer buf_rvs-doc   for ub.rvs-doc .
       79     define buffer buf_icnt-doc  for ub.icnt-doc .
       80     if lookup(p-table-name,
       81       'trn-doc':U
       82       + chr(44) + 'price-doc':U
       83       + chr(44) + 'rvs-doc':U
       84       + chr(44) + 'icnt-doc':U
       85       + chr(44) + 'fbr-doc':U
       86     ) = 0
       87     then do:
       88       message
       89         vss-workfile vss-revision vss-description skip
       90         "Ошибка задания входных параметров" skip
       91         "Неизвестный тип таблицы" skip
       92         "Код товара" p-doc-code skip
       93         "Таблица" p-table-name skip
       94         "Код" p-recid skip
       95         view-as alert-box error .
       96       undo main-block, return error .
       97     end.
       98     find first buf_trn-doc no-lock
       99       where buf_trn-doc.doc-code = p-doc-code
      100         and recid(buf_trn-doc) <> p-recid
      101       no-error .
      102     if available buf_trn-doc
      103     then do:
      104       message
      105         vss-workfile vss-revision vss-description skip
      106         "Неправильный номер документа" skip
      107         "Уже существует складской документ" buf_trn-doc.doc-code
      108           "с физическим номером" recid(buf_trn-doc) skip
      109         "Таблица" p-table-name skip
      110         "Код" p-recid skip
      111         view-as alert-box error .
      112       undo, return error .
      113     end.
      114     find first buf_price-doc no-lock
      115       where buf_price-doc.doc-num = p-doc-code
      116         and recid(buf_price-doc) <> p-recid
      117       no-error .
      118     if available buf_price-doc
      119     then do:
      120       message
      121         vss-workfile vss-revision vss-description skip
      122         "Неправильный номер документа" skip
      123         "Уже существует переоценка" buf_price-doc.doc-num
      124           "с физическим номером" recid(buf_price-doc) skip
      125         "Таблица" p-table-name skip
      126         "Код" p-recid skip
      127         view-as alert-box error .
      128       undo, return error .
      129     end.
      130     find first buf_rvs-doc no-lock
      131       where buf_rvs-doc.rvs-code = p-doc-code
      132         and recid(buf_rvs-doc) <> p-recid
      133       no-error .
      134     if available buf_rvs-doc
      135     then do:
      136       message
      137         vss-workfile vss-revision vss-description skip
      138         "Неправильный номер документа" skip
      139         "Уже существует сверка" buf_rvs-doc.rvs-code
      140           "с физическим номером" recid(buf_rvs-doc) skip
      141         "Таблица" p-table-name skip
      142         "Код" p-recid skip
      143         view-as alert-box error .
      144       undo, return error .
      145     end.
      146     find first buf_icnt-doc no-lock
      147       where buf_icnt-doc.doc-code = p-doc-code
      148         and recid(buf_icnt-doc)  <> p-recid
      149       no-error .
      150     if available buf_icnt-doc
      151     then do:
      152       message
      153         vss-workfile vss-revision vss-description skip
      154         "Неправильный номер документа" skip
      155         "Уже существует инвентаризация счетчиков ТРК" buf_icnt-doc.doc-code
      156           "с физическим номером" recid(buf_icnt-doc) skip
      157         "Таблица" p-table-name skip
      158         "Код" p-recid skip
      159         view-as alert-box error .
      160       undo, return error .
      161     end.
      162   end.
