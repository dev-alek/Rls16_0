        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code   as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Создать запись о том, что необходимо пересчитать межфирменные архивы по документу".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1',p-doc-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable v-start-date as date      no-undo .
      307   define buffer buf_trn-doc   for ub.trn-doc   .
      308   define buffer buf_hold-time for ub.hold-time .
      309   define buffer buf_hold-trn  for ub.hold-trn  .
      310   do
      311   on error undo, return error return-value
      312   :
      313     find first buf_trn-doc no-lock
      314       where buf_trn-doc.doc-code = p-doc-code
      315       no-error .
      316     if not available buf_trn-doc
      317     then do:
      318       message
      319         vss-workfile vss-revision vss-description skip
      320         "Ошибка задания входных параметров" skip
      321         "Не найден документ" p-doc-code skip
      322         view-as alert-box error .
      323       undo, return error return-value .
      324     end.
      325     if buf_trn-doc.fact-date = ?
      326     then do:
      327       message
      328         vss-workfile vss-revision vss-description skip
      329         "Не задана дата фактического закрытия документа" skip
      330         "Документ" p-doc-code skip
      331         view-as alert-box error .
      332       undo, return error return-value .
      333     end.
      334     assign
      335       v-start-date = date(month(buf_trn-doc.fact-date), 1, year(buf_trn-doc.fact-date))
      336     .
      337     find first buf_hold-time no-lock
      338       where buf_hold-time.cat-code   = 1
      339         and buf_hold-time.time-type  = 'мес':U
      340         and buf_hold-time.start-date = v-start-date
      341       no-error .
      342     if available buf_hold-time
      343     then do:
      344       find first buf_hold-trn no-lock
      345         where buf_hold-trn.cat-code  = 1
      346           and buf_hold-trn.doc-code  = p-doc-code
      347           and buf_hold-trn.time-code = buf_hold-time.time-code
      348         no-error .
      349       if available buf_hold-trn
      350       then do:
      351         message
      352           vss-workfile vss-revision vss-description skip
      353           "ВНИМАНИЕ!!!!" skip
      354           "Попытка повторного создания записи расчета межфирменного архива" skip
      355           "Пожалуйста, не закрывайте это сообщение и позвните в службу поддержки" skip
      356           "Межфирменный архив по приходам и продажам" skip
      357           "Документ" p-doc-code skip
      358           "Дата фактического закрытия" buf_trn-doc.fact-date skip
      359           "Дата начала периода" v-start-date skip
      360           view-as alert-box error .
      361         undo, return error return-value .
      362       end.
      363     end.
      364     find first buf_hold-time no-lock
      365       where buf_hold-time.cat-code   = 2
      366         and buf_hold-time.time-type  = 'мес':U
      367         and buf_hold-time.start-date = v-start-date
      368       no-error .
      369     if available buf_hold-time
      370     then do:
      371       find first buf_hold-trn no-lock
      372         where buf_hold-trn.cat-code  = 2
      373           and buf_hold-trn.doc-code  = p-doc-code
      374           and buf_hold-trn.time-code = buf_hold-time.time-code
      375         no-error .
      376       if available buf_hold-trn
      377       then do:
      378         message
      379           vss-workfile vss-revision vss-description skip
      380           "ВНИМАНИЕ!!!!" skip
      381           "Попытка повторного создания записи расчета межфирменного архива" skip
      382           "Пожалуйста, не закрывайте это сообщение и позвните в службу поддержки" skip
      383           "Межфирменный архив по инвентаризациям" skip
      384           "Документ" p-doc-code skip
      385           "Дата фактического закрытия" buf_trn-doc.fact-date skip
      386           "Дата начала периода" v-start-date skip
      387           view-as alert-box error .
      388         undo, return error return-value .
      389       end.
      390     end.
      391     find first buf_hold-time no-lock
      392       where buf_hold-time.cat-code   = 3
      393         and buf_hold-time.time-type  = 'мес':U
      394         and buf_hold-time.start-date = v-start-date
      395       no-error .
      396     if available buf_hold-time
      397     then do:
      398       find first buf_hold-trn no-lock
      399         where buf_hold-trn.cat-code  = 3
      400           and buf_hold-trn.doc-code  = p-doc-code
      401           and buf_hold-trn.time-code = buf_hold-time.time-code
      402         no-error .
      403       if available buf_hold-trn
      404       then do:
      405         message
      406           vss-workfile vss-revision vss-description skip
      407           "ВНИМАНИЕ!!!!" skip
      408           "Попытка повторного создания записи расчета межфирменного архива" skip
      409           "Пожалуйста, не закрывайте это сообщение и позвните в службу поддержки" skip
      410           "Межфирменный архив по списаниям" skip
      411           "Документ" p-doc-code skip
      412           "Дата фактического закрытия" buf_trn-doc.fact-date skip
      413           "Дата начала периода" v-start-date skip
      414           view-as alert-box error .
      415         undo, return error return-value .
      416       end.
      417     end.
      418     find first ub.batchprocess no-lock
      419       where ub.batchprocess.bp_type   = 'hold':U
      420         and ub.batchprocess.bp_status = 'N':U
      421         and ub.batchprocess.charkey_one = p-doc-code
      422     no-error .
      423     if not available ub.BatchProcess then do:
      424       create ub.BatchProcess .
      425           define variable v-btpr_upd-today-1 as date      no-undo.
      426       define variable v-btpr_upd-time-1  as integer   no-undo.
      427       run cur-time in this-procedure ( output v-btpr_upd-today-1
      428                                      , output v-btpr_upd-time-1
      429                                      ).
      430       assign
      431         ub.BatchProcess.BP_Type       = 'hold':U
      432         ub.BatchProcess.BP_Status     = 'N':U
      433         ub.BatchProcess.BatchProcess# = next-value( s-btpr, ub )
      434         ub.BatchProcess.User_ID       = g#userid
      435         ub.BatchProcess.BP_SysDate    = v-btpr_upd-today-1
      436         ub.BatchProcess.BP_SysTime    = string( v-btpr_upd-time-1, 'HH:MM' )
      437         ub.BatchProcess.BP_SysTimeInt = v-btpr_upd-time-1
      438       .
      439       assign
      440         ub.BatchProcess.CharKey_One   = p-doc-code
      441       .
      442     end.
      443     find first ub.batchprocess no-lock
      444       where ub.batchprocess.bp_type   = 'hinv':U
      445         and ub.batchprocess.bp_status = 'N':U
      446         and ub.batchprocess.charkey_one = p-doc-code
      447     no-error .
      448     if not available ub.BatchProcess then do:
      449       create ub.BatchProcess .
      450           define variable v-btpr_upd-today-2 as date      no-undo.
      451       define variable v-btpr_upd-time-2  as integer   no-undo.
      452       run cur-time in this-procedure ( output v-btpr_upd-today-2
      453                                      , output v-btpr_upd-time-2
      454                                      ).
      455       assign
      456         ub.BatchProcess.BP_Type       = 'hinv':U
      457         ub.BatchProcess.BP_Status     = 'N':U
      458         ub.BatchProcess.BatchProcess# = next-value( s-btpr, ub )
      459         ub.BatchProcess.User_ID       = g#userid
      460         ub.BatchProcess.BP_SysDate    = v-btpr_upd-today-2
      461         ub.BatchProcess.BP_SysTime    = string( v-btpr_upd-time-2, 'HH:MM' )
      462         ub.BatchProcess.BP_SysTimeInt = v-btpr_upd-time-2
      463       .
      464       assign
      465         ub.BatchProcess.CharKey_One   = p-doc-code
      466       .
      467     end.
      468     find first ub.batchprocess no-lock
      469       where ub.batchprocess.bp_type   = 'hspi':U
      470         and ub.batchprocess.bp_status = 'N':U
      471         and ub.batchprocess.charkey_one = p-doc-code
      472     no-error .
      473     if not available ub.BatchProcess then do:
      474       create ub.BatchProcess .
      475           define variable v-btpr_upd-today-3 as date      no-undo.
      476       define variable v-btpr_upd-time-3  as integer   no-undo.
      477       run cur-time in this-procedure ( output v-btpr_upd-today-3
      478                                      , output v-btpr_upd-time-3
      479                                      ).
      480       assign
      481         ub.BatchProcess.BP_Type       = 'hspi':U
      482         ub.BatchProcess.BP_Status     = 'N':U
      483         ub.BatchProcess.BatchProcess# = next-value( s-btpr, ub )
      484         ub.BatchProcess.User_ID       = g#userid
      485         ub.BatchProcess.BP_SysDate    = v-btpr_upd-today-3
      486         ub.BatchProcess.BP_SysTime    = string( v-btpr_upd-time-3, 'HH:MM' )
      487         ub.BatchProcess.BP_SysTimeInt = v-btpr_upd-time-3
      488       .
      489       assign
      490         ub.BatchProcess.CharKey_One   = p-doc-code
      491       .
      492     end.
      493   end.
