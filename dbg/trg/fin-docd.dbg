      682   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   procedure write-fin-doc-history :
      684   define parameter buffer buf_fin-doc for ub.fin-doc.
      685   define variable v-date as date no-undo .
      686   define variable v-time as integer no-undo .
      687   define buffer buf_c-fin-doc for ub.c-fin-doc.
      688   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
      689   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      690     do
      691     on error undo, return error
      692     :
      693       run cur-time in this-procedure(output v-date, output v-time).
      694       create buf_c-fin-doc.
      695       buffer-copy buf_fin-doc to buf_c-fin-doc
      696       assign
      697       buf_c-fin-doc.chip-num           = next-value (s-corr-chip, ub)
      698       buf_c-fin-doc.corr-time          = v-time
      699       buf_c-fin-doc.corr-user-db-num   = g#db-num
      700       buf_c-fin-doc.corr-user-name     = g#userid
      701       buf_c-fin-doc.corr-date          = v-date
      702       buf_c-fin-doc.corr-doc-code      = "":U
      703       .
      704       for each ub.fin-doc-tax where
      705                ub.fin-doc-tax.host-code = buf_fin-doc.host-code
      706            AND ub.fin-doc-tax.fin-doc-code = buf_fin-doc.fin-doc-code:
      707         create buf_c-fin-doc-tax.
      708         buffer-copy ub.fin-doc-tax to buf_c-fin-doc-tax
      709         assign
      710         buf_c-fin-doc-tax.chip-num           = buf_c-fin-doc.chip-num
      711         buf_c-fin-doc-tax.corr-user-db-num   = buf_c-fin-doc.corr-user-db-num
      712         .
      713       end.
      714       for each ub.fin-doc-attr where
      715                ub.fin-doc-attr.host-code = buf_fin-doc.host-code
      716            AND ub.fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code:
      717         create buf_c-fin-doc-attr.
      718         buffer-copy ub.fin-doc-attr to buf_c-fin-doc-attr
      719         assign
      720         buf_c-fin-doc-attr.chip-num           = buf_c-fin-doc.chip-num
      721         buf_c-fin-doc-attr.corr-user-db-num   = buf_c-fin-doc.corr-user-db-num
      722         buf_c-fin-doc-attr.attr-value         = buf_c-fin-doc-attr.attr-value
      723         .
      724       end.
      725       release buf_c-fin-doc.
      726     end.
      727   end procedure.
