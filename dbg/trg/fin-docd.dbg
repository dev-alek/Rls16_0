        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.fin-doc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление финансового док-та ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2', ub.fin-doc.host-code, ub.fin-doc.fin-doc-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure fd-attr-code :
      308     do
      309     on error undo, return error
      310     :
      311       define input  parameter p-code           as character no-undo .
      312       define output parameter p-type           as character no-undo .
      313       define output parameter p-format         as character no-undo .
      314       define output parameter p-label          as character no-undo .
      315       define output parameter p-user-can-edit  as logical   no-undo .
      316       define output parameter p-output-display as logical   no-undo .
      317       define output parameter p-other          as character no-undo .
      318       case p-code :
      319               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      320               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      321               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      322               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      323               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      324               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      325               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
      326               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      327         otherwise do:
      328           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      329         end.
      330       end.
      331     end.
      332   end procedure.
      333   procedure fd-attr-tooltip :
      334     do
      335     on error undo, return error
      336     :
      337       define input  parameter p-code    as character no-undo .
      338       define output parameter p-tooltip as character no-undo .
      339       define output parameter p-label   as character no-undo .
      340       case p-code :
      341               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      342               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      343               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      344               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      345               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      346               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      347               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      348               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      349         otherwise do:
      350           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      351         end.
      352       end.
      353     end.
      354   end procedure.
      355   procedure fin-doc-attr-write :
      356    do
      357    on error undo, return error return-value
      358    :
      359   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      360   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      361   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      362   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      363   define variable  v-format         as character no-undo .
      364   define variable  v-label          as character no-undo .
      365   define variable  v-user-can-edit  as logical   no-undo .
      366   define variable  v-output-display as logical   no-undo .
      367   define variable  v-other          as character no-undo .
      368   define variable  v-type           as character no-undo .
      369   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      370   run fd-attr-code in this-procedure
      371                                     (input  p-attr-code
      372                                     ,output v-type
      373                                     ,output v-format
      374                                     ,output v-label
      375                                     ,output v-user-can-edit
      376                                     ,output v-output-display
      377                                     ,output v-other
      378                                     ) no-error .
      379   if error-status :error then do:
      380     undo, return error return-value .
      381   end.
      382   find first buf_fin-doc-attr  exclusive-lock  where
      383             buf_fin-doc-attr.attr-code    = p-attr-code
      384         AND buf_fin-doc-attr.host-code    = p-host-code
      385         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      386     if not available  buf_fin-doc-attr then do:
      387         create buf_fin-doc-attr.
      388         assign
      389         buf_fin-doc-attr.attr-code    = p-attr-code
      390         buf_fin-doc-attr.attr-value   = p-attr-value
      391         buf_fin-doc-attr.host-code    = p-host-code
      392         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      393         .
      394     end.
      395     else do:
      396          assign
      397          buf_fin-doc-attr.attr-value = p-attr-value.
      398     end.
      399    end.
      400   end procedure.
      401   procedure fd-attr-exist :
      402     do
      403     on error undo, return error
      404     :
      405       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      406       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      407       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      408       define output parameter p-exist   as logical  no-undo .
      409       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      410       define variable  v-type           as character no-undo .
      411       define variable  v-format         as character no-undo .
      412       define variable  v-label          as character no-undo .
      413       define variable  v-user-can-edit  as logical   no-undo .
      414       define variable  v-output-display as logical   no-undo .
      415       define variable  v-other          as character no-undo .
      416       run fd-attr-code in this-procedure
      417         (input  p-code
      418         ,output v-type
      419         ,output v-format
      420         ,output v-label
      421         ,output v-user-can-edit
      422         ,output v-output-display
      423         ,output v-other
      424         ) no-error .
      425       if error-status :error then do:
      426         undo, return error return-value .
      427       end.
      428       find first buf_fin-doc-attr exclusive-lock
      429         where buf_fin-doc-attr.host-code  = p-host-code
      430           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      431           and buf_fin-doc-attr.attr-code = p-code
      432         no-error .
      433       if  available buf_fin-doc-attr then do:
      434         p-exist = yes.
      435       end.
      436     end.
      437   end procedure.
      438   procedure fd-attr-delete :
      439     do
      440     on error undo, return error
      441     :
      442     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      443     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      444     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      445     define output parameter p-deleted  as logical no-undo.
      446       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      447       define variable  v-type           as character no-undo .
      448       define variable  v-format         as character no-undo .
      449       define variable  v-label          as character no-undo .
      450       define variable  v-user-can-edit  as logical   no-undo .
      451       define variable  v-output-display as logical   no-undo .
      452       define variable  v-other          as character no-undo .
      453       run fd-attr-code in this-procedure
      454         (input  p-code
      455         ,output v-type
      456         ,output v-format
      457         ,output v-label
      458         ,output v-user-can-edit
      459         ,output v-output-display
      460         ,output v-other
      461         ) no-error .
      462       if error-status :error then do:
      463         undo, return error return-value .
      464       end.
      465       find first buf_fin-doc-attr exclusive-lock
      466         where buf_fin-doc-attr.host-code  = p-host-code
      467           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      468           and buf_fin-doc-attr.attr-code = p-code
      469         no-error NO-WAIT.
      470       if not available buf_fin-doc-attr then do:
      471         p-deleted = no.
      472       end.
      473       else do:
      474         delete buf_fin-doc-attr no-error .
      475         if error-status:error then do:
      476           undo, return error return-value .
      477         end.
      478         p-deleted = yes.
      479       end.
      480     end.
      481   end procedure.
      482   procedure fin-doc-attr-value :
      483    do
      484    on error undo, return error return-value
      485    :
      486   define input  parameter p-host-code    like ub.fin-doc-attr.host-code    no-undo .
      487   define input  parameter p-fin-doc-code like ub.fin-doc-attr.fin-doc-code     no-undo .
      488   define input  parameter p-attr-code    like ub.fin-doc-attr.attr-code    no-undo .
      489   define output parameter p-attr-value   like ub.fin-doc-attr.attr-value   no-undo .
      490   define variable  v-format         as character no-undo .
      491   define variable  v-label          as character no-undo .
      492   define variable  v-user-can-edit  as logical   no-undo .
      493   define variable  v-output-display as logical   no-undo .
      494   define variable  v-other          as character no-undo .
      495   define variable  v-type           as character no-undo .
      496   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      497   run fd-attr-code in this-procedure
      498     (input  p-attr-code
      499     ,output v-type
      500     ,output v-format
      501     ,output v-label
      502     ,output v-user-can-edit
      503     ,output v-output-display
      504     ,output v-other
      505     ) no-error .
      506   if error-status :error then do:
      507     undo, return error return-value .
      508   end.
      509   find first buf_fin-doc-attr no-lock where
      510             buf_fin-doc-attr.attr-code    = p-attr-code
      511         AND buf_fin-doc-attr.host-code     = p-host-code
      512         AND buf_fin-doc-attr.fin-doc-code = p-fin-doc-code      no-error .
      513     if available  buf_fin-doc-attr then do:
      514       assign
      515       p-attr-value = buf_fin-doc-attr.attr-value
      516       .
      517     end.
      518     else do:
      519       p-attr-value = ? .
      520     end.
      521    end.
      522   end procedure.
      523   procedure fd-attr-news :
      524     do
      525     on error undo, return error
      526     :
      527       define input  parameter p-code           as character no-undo .
      528       define output parameter p-news           as logical   no-undo .
      529       case p-code :
      530               when 'shift-date':U then do:     assign     p-news = no.   end.
      531               when 'shift-num':U then do:     assign     p-news = no.   end.
      532               when 'shift-name':U then do:     assign     p-news = no.   end.
      533               when 'barcode':U then do:     assign     p-news = no.   end.
      534               when 'lockid':U then do:     assign     p-news = no.   end.
      535               when 'cover_sheet':U then do:     assign     p-news = no.   end.
      536               when 'pre-vedom':U then do:     assign     p-news = no.   end.
      537         otherwise do:
      538           undo, return error "неизвестный атрибут платежа " + " " + p-code .
      539         end.
      540       end.
      541     end.
      542   end procedure.
