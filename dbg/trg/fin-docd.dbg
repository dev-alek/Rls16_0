      921   :
      922       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_write in g#attr-lib
      923       (input  p-obj-type
      924       ,input  p-obj-code
      925       ,input  p-upper-code
      926       ,input  p-code
      927       ,input  p-value-character
      928       ,input  p-value-date
      929       ,input  p-value-decimal
      930       ,input  p-value-integer
      931       ,input  p-value-logical
      932       ) no-error .
      933     if error-status :error
      934     then do:
