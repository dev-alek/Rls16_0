      767   procedure thbjattr_code_reg :
      768   define input  parameter p-upper-code     as character no-undo .
      769   define input  parameter p-code           as character no-undo .
      770   define output parameter p-label          as character no-undo .
      771   define output parameter p-user-can-edit  as logical   no-undo .
      772   define output parameter p-output-display as logical   no-undo .
      773   define output parameter p-other          as character no-undo .
      774   define output parameter p-prop-list      as character no-undo .
      775   define output parameter p-prop-type-list as character no-undo .
      776   define output parameter p-prop-label-list as character no-undo .
      777   define output parameter p-global          as logical no-undo .
      778   define output parameter p-host           as logical no-undo .
      779   define output parameter p-shop           as logical no-undo .
      780   define output parameter p-store          as logical no-undo .
      781   define output parameter p-db             as logical no-undo .
      782   define output parameter p-region         as logical no-undo .
      783   do
      784   on error undo, return error return-value
      785   :
      786       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      787       (input  p-upper-code
      788       ,input  p-code
      789       ,output p-label
      790       ,output p-user-can-edit
      791       ,output p-output-display
      792       ,output p-other
      793       ,output p-prop-list
      794       ,output p-prop-type-list
      795       ,output p-prop-label-list
      796       ,output p-global
      797       ,output p-host
      798       ,output p-shop
      799       ,output p-store
      800       ,output p-db
      801       ,output p-region
      802       ) no-error .
      803     if error-status :error
      804     then do:
      805       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      806     end.
      807   end.
      808   end procedure.
