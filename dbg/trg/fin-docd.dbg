      936     end.
      937   end.
      938   end procedure.
      939   procedure thbjattr_set-section :
      940   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      941   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      942   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      943   define input  parameter table-handle p-tth.
      944   do
      945   on error undo, return error return-value
      946   :
      947       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
      948       (input  p-obj-type
      949       ,input  p-obj-code
      950       ,input  p-upper-code
      951       ,input  table-handle p-tth
      952       ) no-error .
      953     if error-status :error
      954     then do:
      955       delete object p-tth.
