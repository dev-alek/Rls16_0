     1001   procedure thbjattr_manual-edit :
     1002   define input  parameter p-ucode          as character no-undo .
     1003   define input  parameter p-code           as character no-undo .
     1004   define output parameter p-section-num    as integer no-undo .
     1005   do
     1006   on error undo, return error return-value
     1007   :
     1008       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
     1009       (input  p-ucode
     1010       ,input  p-code
     1011       ,output  p-section-num
     1012       ) no-error .
     1013     if error-status :error
     1014     then do:
     1015       undo, return error return-value .
     1016     end.
     1017   end.
     1018   end procedure.
     1019   define buffer buf_sysconf  for ub.sysconf.
     1020   define buffer buf_fin-connect for ub.fin-connect.
     1021   define buffer buf_fin-doc-tax for ub.fin-doc-tax.
     1022   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     1023   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1024   define buffer buf_fin-ob for ub.fin-ob.
     1025   main-block:
     1026   do
     1027   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1028   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1029   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1030   :
     1031       find first buf_sysconf no-lock where buf_sysconf.host-code = ub.fin-doc.host-code.
     1032     if not g#news then do:
     1033       if ub.fin-doc.obj-type <> ''
     1034       or ub.fin-doc.obj-code <> 0 then do:
     1035         define variable v-obj-db-num as integer no-undo .
     1036   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1037   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1038     (input  ub.fin-doc.obj-type
     1039     ,input  ub.fin-doc.obj-code
     1040     ,output v-obj-db-num
     1041     )  .
     1042       end.
     1043       if not (buf_sysconf.firm-db-num = g#db-num
     1044               or v-obj-db-num = g#db-num)
     1045       then do:
     1046         message
     1047         vss-workfile vss-revision vss-description skip
     1048         "Нельзя удалять запись ПЛАТЕЖА в БД, отличной от главной БД фирмы и/или БД объекта" skip
     1049         "Номер текущей БД" g#db-num skip(0)
     1050         "Номер главной БД фирмы" buf_sysconf.firm-db-num skip(0)
     1051         "Номер БД объекта" v-obj-db-num
     1052         view-as alert-box error .
     1053         undo main-block, return error .
     1054       end.
     1055       find first buf_fin-connect NO-LOCK
     1056         where buf_fin-connect.host-code = ub.fin-doc.host-code
     1057           and buf_fin-connect.fin-doc-code = ub.fin-doc.fin-doc-code
     1058       no-error .
     1059       if available buf_fin-connect then do:
     1060         define variable  v-delcnavt        as logical no-undo .
     1061         define variable  par-type          as character no-undo .
     1062         define variable  v-found           as logical   no-undo .
     1063         define variable  v-value-date      as date   no-undo .
     1064         define variable  v-value-decimal   as decimal   no-undo .
     1065         define variable  v-value-integer   as integer   no-undo .
     1066         define variable  v-value-logical   as logical   no-undo .
     1067         define variable  v-value-character as character no-undo .
     1068         run thbjattr_value in this-procedure  (
     1069           input   "",
     1070           input   0 ,
     1071           input   'fin-global':U ,
     1072           input   'del-conn-avt'  ,
     1073           output  v-value-character ,
     1074           output  v-value-date      ,
     1075           output  v-value-decimal   ,
     1076           output  v-value-integer   ,
     1077           output  v-delcnavt  ,
     1078           output  par-type            ,
     1079           output  v-found
     1080           ) no-error
     1081           .
     1082         if error-status :error then v-delcnavt = false .
     1083         if v-delcnavt = no then do:
     1084           MESSAGE
     1085             "Нельзя удалять связанный платеж! Сначала удалите связь с фин. обязательствами."
     1086           VIEW-AS ALERT-BOX ERROR TITLE "Удаление невозможно!" .
     1087           UNDO main-block, RETURN ERROR.
     1088         end.
     1089         else do:
     1090           for each buf_fin-connect exclusive-lock
     1091             where buf_fin-connect.host-code = ub.fin-doc.host-code
     1092               and buf_fin-connect.fin-doc-code = ub.fin-doc.fin-doc-code
     1093             :
     1094             find first buf_fin-ob exclusive-lock where
     1095                        buf_fin-ob.host-code = buf_fin-connect.host-code
     1096                    and buf_fin-ob.doc-code = buf_fin-connect.fin-ob-code .
     1097             assign
     1098               buf_fin-ob.con-sum-rubl  = buf_fin-ob.con-sum-rubl  - buf_fin-connect.sum-rubl
     1099               buf_fin-ob.con-sum-base  = buf_fin-ob.con-sum-base  - buf_fin-connect.sum-base
     1100               buf_fin-ob.con-sum-doc   = buf_fin-ob.con-sum-doc   - buf_fin-connect.sum-doc
     1101               buf_fin-ob.con-sum-contr = buf_fin-ob.con-sum-contr - buf_fin-connect.sum-contr
     1102             .
     1103             if buf_fin-ob.con-sum-contr = 0 then assign buf_fin-ob.con-stat = 0 .
     1104             else                             assign buf_fin-ob.con-stat = 1 .
     1105             delete buf_fin-connect .
     1106           end.
     1107         end.
     1108       end.
     1109     end.
     1110     if (ub.fin-doc.status_ = 'факт':U
     1111     OR ub.fin-doc.status_ = 'банк':U)
     1112     and ub.fin-doc.is-del  <> yes
     1113     and not g#news
     1114     then do:
     1115       message
     1116         vss-workfile vss-revision vss-description skip
     1117         "Нельзя удалять платеж, закрытый до статуса" ub.fin-doc.status_ skip
     1118         "Фирма" ub.fin-doc.host-code skip
     1119         "Платеж" ub.fin-doc.fin-doc-code skip
     1120         "Статус платежа" ub.fin-doc.status_ skip
     1121         view-as alert-box error .
     1122       undo main-block, return error .
     1123     end.
     1124     if not g#news
     1125     and ub.fin-doc.status_ <> 'новый':U
     1126     and ub.fin-doc.status_ <> 'факт':U then do:
     1127       run write-fin-doc-history in this-procedure( buffer ub.fin-doc) no-error .
     1128       if error-status :error
     1129       then do:
     1130         message
     1131           vss-workfile vss-revision vss-description skip
     1132           "Ошибка при обновлении истории по платежу" skip
     1133           "Фирма" ub.fin-doc.host-code skip
     1134           "Платеж" ub.fin-doc.fin-doc-code skip
     1135           error-status :get-message(1) skip
     1136           return-value skip
     1137           view-as alert-box error .
     1138         undo main-block, return error .
     1139       end.
     1140     end.
     1141     for each buf_fin-doc-tax where
     1142             buf_fin-doc-tax.fin-doc-code = ub.fin-doc.fin-doc-code
     1143        AND  buf_fin-doc-tax.host-code = ub.fin-doc.host-code
     1144     on error undo main-block, return error
     1145     :
     1146       delete buf_fin-doc-tax .
     1147     end.
     1148     if ub.fin-doc.status_ = 'новый':U then do:
     1149       on delete of ub.fin-doc-attr override do: end.
     1150       on delete of ub.c-fin-doc-attr override do: end.
     1151     end.
     1152     for each buf_fin-doc-attr where
     1153             buf_fin-doc-attr.fin-doc-code = ub.fin-doc.fin-doc-code
     1154        AND  buf_fin-doc-attr.host-code = ub.fin-doc.host-code
     1155     on error undo main-block, return error
     1156     :
     1157       delete buf_fin-doc-attr .
     1158     end.
     1159     if ub.fin-doc.status_ = 'новый':U then do:
     1160       for each buf_c-fin-doc-attr where
     1161               buf_c-fin-doc-attr.fin-doc-code = ub.fin-doc.fin-doc-code
     1162         AND  buf_c-fin-doc-attr.host-code = ub.fin-doc.host-code
     1163       on error undo main-block, return error
     1164       :
     1165         delete buf_c-fin-doc-attr .
     1166       end.
     1167     end.
     1168     if g#news then do:
     1169       for each buf_fin-connect NO-LOCK
     1170         where buf_fin-connect.host-code = ub.fin-doc.host-code
     1171           and buf_fin-connect.fin-doc-code = ub.fin-doc.fin-doc-code:
     1172         delete buf_fin-connect .
     1173       end.
     1174     end.
     1175     if (g#db-num <> 0 and not g#news)
     1176     or (v-obj-db-num >= 0 and g#db-num <> v-obj-db-num and not g#news)
     1177     then do:
     1178       run nws/cmd-del.p
     1179         ( input 'fin-doc':U
     1180          ,input (buffer ub.fin-doc:handle)
     1181          ,input (if g#db-num > 0
     1182                  then "0":U
     1183                  else string(v-obj-db-num)
     1184                  )
     1185         ) no-error .
     1186       if error-status :error then do:
     1187         undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
     1188       end.
     1189     end.
     1190       if g#oxml = yes
     1191       then do:
     1192       run str/calloxml.p (
     1193             input 'delete':U
     1194           , input 'fin-doc':U
     1195           , input ( buffer ub.fin-doc:handle )
     1196       ) no-error.
     1197       if error-status :error
     1198       then do:
     1199           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
     1200                               , chr(10)
     1201                               , vss-workfile
     1202                               , return-value
     1203                               , error-status :get-message ( 1 ) ).
     1204       end.
     1205       end.
     1206   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1207     (input ?
     1208     ,input this-procedure:handle
     1209     ,input ?
     1210     ,input 'event_fin-doc':U
     1211     ,input  buffer ub.fin-doc:handle
     1212     ,input ''
     1213     ,input ''
     1214     ,input ''
     1215     ) no-error .
     1216       if error-status :error
     1217       then
     1218       do:
     1219           return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
     1220               , chr(10)
     1221               , vss-workfile
     1222               , return-value
     1223               , error-status :get-message ( 1 ) ).
     1224       end.
     1225   end.
