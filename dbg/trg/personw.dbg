        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.person OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись person".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1', ub.person.psn-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure gen-b-code :
      308     define input  parameter type-code like ub.code-range.range-type no-undo .
      309     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      310     do
      311     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      312     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      313     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      314     :
      315       define buffer buf_thbj-attr     for ub.thbj-attr .
      316       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      317       define buffer buf_code-range for ub.code-range .
      318       define variable l-code         as   integer              no-undo .
      319       define variable v-db-num       like ub.db.db-num         no-undo .
      320       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      321       if type-code = 'sslc':U
      322       or type-code = 'ssgb':U
      323       then do:
      324         message
      325           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      326           "Обратитесь к администратору системы."
      327           view-as alert-box error .
      328         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      329       end.
      330       run trg/getpcode.p ( input  type-code
      331                      ,output cfg-param-code
      332                     ).
      333       run get-next-seq( input  type-code,
      334                         output l-code
      335                       ).
      336       find first buf_sys-ctrl no-lock.
      337       if type-code = 'sclc':U
      338       or type-code = 'pglc':U
      339       then do:
      340         assign
      341           v-db-num = 0
      342         .
      343       end.
      344       else do:
      345         assign
      346           v-db-num = buf_sys-ctrl.db-num
      347         .
      348       end.
      349       find first buf_code-range no-lock
      350         where buf_code-range.db-num     = v-db-num
      351           and buf_code-range.range-type = type-code
      352           and buf_code-range.stts       = "a"
      353         use-index stts
      354         no-error .
      355       if available buf_code-range
      356          and l-code <= buf_code-range.last-code
      357          and l-code >= buf_code-range.first-code then do:
      358         assign
      359           p-b-code = l-code
      360         .
      361       end.
      362       else do:
      363         if available buf_code-range
      364            and l-code < buf_code-range.last-code then do:
      365           message
      366             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      367             "Обратитесь к администратору системы."
      368             view-as alert-box error .
      369           undo, return error "sequence":U .
      370         end.
      371         do transaction
      372         on error undo, return error
      373         :
      374           find first buf_thbj-attr exclusive-lock
      375             where buf_thbj-attr.upper-prop-code = 'code-range':U
      376               and buf_thbj-attr.prop-code = cfg-param-code
      377               and buf_thbj-attr.obj-type   = 'БД':U
      378               and buf_thbj-attr.obj-code   = v-db-num
      379             no-error .
      380           if not available buf_thbj-attr then do:
      381             find first buf_thbj-attr exclusive-lock
      382               where buf_thbj-attr.upper-prop-code = 'code-range':U
      383                 and buf_thbj-attr.prop-code = cfg-param-code
      384                 and buf_thbj-attr.obj-type   = ''
      385                 and buf_thbj-attr.obj-code   = 0
      386               no-error .
      387             if not available buf_thbj-attr then do:
      388               if not locked buf_thbj-attr then do:
      389                 message
      390                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      391                   "Обратитесь к администратору системы."
      392                   view-as alert-box error .
      393               end.
      394               undo, return error "config":U .
      395             end.
      396           end.
      397           run get-next-seq( input type-code,
      398                             output l-code
      399                           ).
      400           find first buf_code-range
      401             where buf_code-range.db-num     = v-db-num
      402               and buf_code-range.range-type = type-code
      403               and buf_code-range.stts       = "a"
      404             use-index stts
      405             no-error .
      406           if available buf_code-range
      407           and l-code <= buf_code-range.last-code
      408           and l-code >= buf_code-range.first-code
      409           then do:
      410             assign
      411               p-b-code = l-code
      412             .
      413           end.
      414           else do:
      415             if available buf_code-range then do:
      416               assign
      417                 buf_code-range.stts = "u"
      418               .
      419             end.
      420             find first buf_code-range
      421               where buf_code-range.db-num     = v-db-num
      422                 and buf_code-range.range-type = type-code
      423                 and buf_code-range.stts       = "f"
      424               use-index stts
      425               no-error .
      426             if not available buf_code-range then do:
      427               message
      428                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      429                 "Обратитесь к администратору системы"
      430                 view-as alert-box error .
      431               undo, return error "code-range":U .
      432             end.
      433             assign
      434               buf_code-range.stts           = "a"
      435             .
      436             if buf_code-range.first-code = 1 then do:
      437               run set-seq-cr( input type-code,
      438                               input buf_code-range.first-code
      439                             ).
      440               assign
      441                 p-b-code = 1
      442               .
      443             end.
      444             else do:
      445               run set-seq-cr( input type-code,
      446                               input ( buf_code-range.first-code - 1 )
      447                             ).
      448               run get-next-seq( input type-code,
      449                                 output p-b-code
      450                               ).
      451             end.
      452           end.
      453         end.
      454       end.
      455     end.
      456   end procedure.
      457   procedure get-next-seq :
      458     define input  parameter type-code like ub.code-range.range-type no-undo .
      459     define output parameter next-seq  as   integer                  no-undo .
      460     do
      461     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      462     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      463     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      464     :
      465       case type-code:
      466         when 'bcgb':U then do:
      467           assign
      468             next-seq = next-value(s-bcgb-code, ub)
      469           .
      470         end.
      471         when 'scgb':U then do:
      472           assign
      473             next-seq = next-value(s-scgb-code, ub)
      474           .
      475         end.
      476         when 'sclc':U then do:
      477           assign
      478             next-seq = next-value(s-sclc-code, ub)
      479           .
      480         end.
      481         when 'pglc':U then do:
      482           assign
      483             next-seq = next-value(s-pglc-code, ub)
      484           .
      485         end.
      486         when 'dcgb':U then do:
      487           assign
      488             next-seq = next-value(s-dcgb-code, ub)
      489           .
      490         end.
      491         when 'ctgb':U then do:
      492           assign
      493             next-seq = next-value(s-ctgb-code, ub)
      494           .
      495         end.
      496         when 'drgb':U then do:
      497           assign
      498             next-seq = next-value(s-drgb-code, ub)
      499           .
      500         end.
      501         when 'fmgb':U then do:
      502           assign
      503             next-seq = next-value(s-fmgb-code, ub)
      504           .
      505         end.
      506         when 'pngb':U then do:
      507           assign
      508             next-seq = next-value(s-pngb-code, ub)
      509           .
      510         end.
      511         when 'cagb':U then do:
      512           assign
      513             next-seq = next-value(s-cagb-code, ub)
      514           .
      515         end.
      516         when 'fdgb':U then do:
      517           assign
      518             next-seq = next-value(s-fin-doc, ub)
      519           .
      520         end.
      521       end case.
      522     end.
      523   end procedure.
      524   procedure set-seq-cr :
      525     define input parameter type-code like ub.code-range.range-type no-undo .
      526     define input parameter set-val   like ub.code-range.first-code no-undo .
      527     do
      528     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      529     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      530     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      531     :
      532       case type-code:
      533         when 'bcgb':U then do:
      534           assign
      535             current-value(s-bcgb-code, ub) = set-val
      536           .
      537         end.
      538         when 'scgb':U then do:
      539           assign
      540             current-value(s-scgb-code, ub) = set-val
      541           .
      542         end.
      543         when 'sclc':U then do:
      544           assign
      545             current-value(s-sclc-code, ub) = set-val
      546           .
      547         end.
      548         when 'pglc':U then do:
      549           assign
      550             current-value(s-pglc-code, ub) = set-val
      551           .
      552         end.
      553         when 'dcgb':U then do:
      554           assign
      555             current-value(s-dcgb-code, ub) = set-val
      556           .
      557         end.
      558         when 'ctgb':U then do:
      559           assign
      560             current-value(s-ctgb-code, ub) = set-val
      561           .
      562         end.
      563         when 'drgb':U then do:
      564           assign
      565             current-value(s-drgb-code, ub) = set-val
      566           .
      567         end.
      568         when 'fmgb':U then do:
      569           assign
      570             current-value(s-fmgb-code, ub) = set-val
      571           .
      572         end.
      573         when 'pngb':U then do:
      574           assign
      575             current-value(s-pngb-code, ub) = set-val
      576           .
      577         end.
      578         when 'cagb':U then do:
      579           assign
      580             current-value(s-cagb-code, ub) = set-val
      581           .
      582         end.
      583         when 'fdgb':U then do:
      584           assign
      585             current-value(s-fin-doc, ub) = set-val
      586           .
      587         end.
      588       end case.
      589     end.
      590   end procedure.
      591   procedure new-bcod-gen-code-range :
      592     do
      593     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      594     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      595     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      596     :
      597       define input parameter p-db-num  like ub.db.db-num             no-undo .
      598       define input parameter type-code like ub.code-range.range-type no-undo .
      599       define buffer buf_code-range      for ub.code-range .
      600       define buffer last_code-range     for ub.code-range .
      601       define buffer last-1_code-range   for ub.code-range .
      602       define buffer last-2_code-range   for ub.code-range .
      603       define buffer last-3_code-range   for ub.code-range .
      604       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      605       define variable conf-par       as character no-undo .
      606       define variable par-type       as character no-undo .
      607       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      608       define variable v-cre-cdrg as logical   no-undo .
      609       define variable v-cre-str  as character no-undo .
      610       define variable v-cr1      as integer no-undo .
      611       define variable v-cr2      as integer no-undo .
      612       define variable v-cr3      as integer no-undo .
      613       define variable v-cmax     as integer no-undo .
      614       find first buf_sys-ctrl no-lock .
      615       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      616         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      617                                       ,vss-workfile
      618                                       ,vss-revision
      619                                       ,vss-description
      620                                       ,chr(10)
      621                                       , p-db-num
      622                                      ).
      623       end.
      624       run trg/getpcode.p ( input  type-code
      625                      ,output cfg-param-code
      626                     ).
      627       for each buf_code-range
      628         where buf_code-range.db-num     = -1
      629           and buf_code-range.range-type = type-code
      630           and buf_code-range.stts       = "f"
      631       by buf_code-range.first-code
      632       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      633       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      634       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      635       :
      636         assign
      637           buf_code-range.db-num = p-db-num
      638         .
      639         return .
      640       end.
      641       assign
      642         v-cre-cdrg = TRUE
      643       .
      644       case type-code:
      645         when 'sclc':U
      646         or when 'scgb':U
      647         or when 'pglc':U
      648         then do:
      649           find last last-1_code-range no-lock
      650             where last-1_code-range.range-type = 'sclc':U
      651             no-error .
      652           if available last-1_code-range then do:
      653             v-cr1 = last-1_code-range.last-code.
      654           end.
      655           find last last-2_code-range no-lock
      656             where last-2_code-range.range-type = 'scgb':U
      657             no-error .
      658           if available last-2_code-range then do:
      659             v-cr2 = last-2_code-range.last-code.
      660             end.
      661           find last last-3_code-range no-lock
      662             where last-3_code-range.range-type = 'pglc':U
      663             no-error .
      664           if available last-3_code-range then do:
      665             v-cr3 = last-3_code-range.last-code.
      666           end.
      667           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      668           .
      669           if v-cmax = v-cr1  then do:
      670               find last last_code-range no-lock
      671                 where recid( last_code-range ) = recid( last-1_code-range )
      672                 .
      673             end.
      674           if v-cmax = v-cr2  then do:
      675               find last last_code-range no-lock
      676                 where recid( last_code-range ) = recid( last-2_code-range )
      677                 .
      678             end.
      679           if v-cmax = v-cr3  then do:
      680             find last last_code-range no-lock
      681               where recid( last_code-range ) = recid( last-3_code-range )
      682               .
      683           end.
      684           if last_code-range.last-code + 1 > 99999 then do:
      685             assign
      686               v-cre-cdrg = FALSE
      687             .
      688           end.
      689         end.
      690         when 'bcgb':U
      691         or when 'sslc':U
      692         or when 'ssgb':U
      693         then do:
      694           find last last-1_code-range no-lock
      695             where last-1_code-range.range-type = 'sslc':U
      696             no-error .
      697           if available last-1_code-range then do:
      698             v-cr1 = last-1_code-range.last-code.
      699           end.
      700           find last last-2_code-range no-lock
      701             where last-2_code-range.range-type = 'bcgb':U
      702             no-error .
      703           if available last-2_code-range then do:
      704             v-cr2 = last-2_code-range.last-code.
      705             end.
      706           find last last-3_code-range no-lock
      707             where last-3_code-range.range-type = 'ssgb':U
      708             no-error .
      709           if available last-3_code-range then do:
      710             v-cr3 = last-3_code-range.last-code.
      711           end.
      712           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      713           .
      714           if v-cmax = v-cr1  then do:
      715               find last last_code-range no-lock
      716                 where recid( last_code-range ) = recid( last-1_code-range )
      717                 .
      718             end.
      719           if v-cmax = v-cr2  then do:
      720               find last last_code-range no-lock
      721                 where recid( last_code-range ) = recid( last-2_code-range )
      722                 .
      723             end.
      724           if v-cmax = v-cr3  then do:
      725             find last last_code-range no-lock
      726               where recid( last_code-range ) = recid( last-3_code-range )
      727               .
      728           end.
      729         end.
      730         otherwise do:
      731           find last last_code-range no-lock
      732             where last_code-range.range-type = type-code
      733             no-error .
      734         end.
      735       end case.
      736       if not available last_code-range then do:
      737         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      738                                       ,vss-workfile
      739                                       ,vss-revision
      740                                       ,vss-description
      741                                       , chr(10)
      742                                       , type-code
      743                                      ) .
      744       end.
      745       define variable v-mes1 as character no-undo .
      746       define variable v-param-type1 as character no-undo .
      747       define variable v-value-character1 as INTEGER no-undo .
      748       define variable v-value-date1 as date no-undo .
      749       define variable v-value-decimal1 as decimal no-undo .
      750       define variable v-value-integer1 AS integer no-undo .
      751       define variable v-value-logical1 AS LOGICAL no-undo .
      752       define variable v-tth1 as handle no-undo .
      753       run adm/shattri.p (
      754           input "get":U
      755           ,input  'БД':U
      756           ,input  p-db-num
      757           ,input  'code-range':U
      758           ,input  cfg-param-code
      759           ,output v-value-character1
      760           ,output v-value-date1
      761           ,output v-value-decimal1
      762           ,output v-value-integer1
      763           ,output v-value-logical1
      764           ,output v-param-type1
      765           ,INPUT-OUTPUT table-handle v-tth1
      766           ) no-error .
      767       if error-status :error then do:
      768         delete object v-tth1.
      769         v-mes1 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      770                            , error-status:get-message(1)
      771                            , chr(10)
      772                            , return-value ).
      773         undo, return error v-mes1.
      774       end.
      775       delete object v-tth1.
      776       if v-cre-cdrg = TRUE then do:
      777         create buf_code-range .
      778         assign
      779           buf_code-range.db-num     = p-db-num
      780           buf_code-range.range-type = type-code
      781           buf_code-range.stts       = "f"
      782           buf_code-range.first-code = last_code-range.last-code + 1
      783           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer1)
      784           v-cre-str = "Свободный диапазон успешно создан"
      785         .
      786       end.
      787       else do:
      788         assign
      789           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      790                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      791         .
      792       end.
      793     end.
      794     return v-cre-str .
      795   end procedure.
      796   procedure gen-new-code-range-if-neces :
      797     define input parameter v-db-num           like ub.db.db-num             no-undo .
      798     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      799     define input parameter v-cur-code         as   integer                  no-undo .
      800     define input parameter v-g#news           as   logical                  no-undo .
      801     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      802     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      803     do
      804     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      805     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      806     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      807     :
      808       define variable l-code-range-exist as logical   no-undo init false .
      809       define variable v-db-for-send      as character no-undo .
      810       define buffer buf_code-range  for ub.code-range .
      811       define buffer buf1_code-range for ub.code-range .
      812       define buffer buf_db          for ub.db .
      813       find first buf_code-range
      814         where buf_code-range.range-type = v-range-type
      815           and buf_code-range.last-code >= v-cur-code
      816         use-index last-codei
      817         no-error .
      818       if
      819       (
      820          available buf_code-range
      821          and
      822         (buf_code-range.db-num = v-db-num
      823           and
      824         buf_code-range.first-code <= v-cur-code
      825         )
      826       or
      827         (
      828           v-range-type = 'drgb':U
      829           AND
      830           v-cur-code = 0
      831         )
      832      )
      833      then do:
      834         assign
      835           l-code-range-exist = true
      836         .
      837         if v-g#news
      838         and buf_code-range.stts = "f" then do:
      839           assign
      840             buf_code-range.stts = "u"
      841           .
      842         end.
      843       end.
      844       if not l-code-range-exist
      845          and v-g#news-source-db <> 0
      846       then do:
      847         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      848                                       ,vss-workfile
      849                                       ,vss-revision
      850                                       ,vss-description
      851                                       ,chr(10)
      852                                       ,v-db-num
      853                                       ,v-range-type
      854                                       ,v-cur-code
      855                                      ).
      856       end.
      857       if (not l-code-range-exist
      858           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      859          )
      860       and ( not can-find (first buf1_code-range no-lock
      861                           where buf1_code-range.db-num = v-db-num
      862                             and buf1_code-range.range-type = v-range-type
      863                             and buf1_code-range.stts = "f"
      864                          )
      865           )
      866       then do:
      867         if v-g#db-num = 0 then do:
      868           run new-bcod-gen-code-range in this-procedure
      869             (input v-db-num,
      870              input v-range-type
      871             ) no-error .
      872           if error-status :error then do:
      873             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      874                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      875                                           ,v-db-num
      876                                           ,v-range-type
      877                                           ,v-cur-code
      878                                           ,chr(10)
      879                                           ,error-status:get-message(1)
      880                                           ,return-value
      881                                          ).
      882           end.
      883         end.
      884         else do:
      885           if v-range-type = 'sclc':U
      886           or v-range-type = 'pglc':U
      887           then do:
      888             assign
      889               v-db-for-send = "":U
      890             .
      891             if v-g#db-num = 0 then do:
      892               for each buf_db no-lock
      893                 where buf_db.db-num > 0
      894                   and buf_db.db-num <> v-g#news-source-db
      895               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      896               :
      897                 assign
      898                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      899                 .
      900               end.
      901               assign
      902                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      903               .
      904             end.
      905             else do:
      906               if not v-g#news then do:
      907                 assign
      908                   v-db-for-send = "0":U
      909                 .
      910               end.
      911             end.
      912             run nws/cr-route.p ( input 'send-cmd':U
      913                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      914                                  "code-range":U + chr(1) +
      915                                  (if v-range-type = 'sclc':U
      916                                   then string( current-value(s-sclc-code, ub))
      917                                   else string( current-value(s-pglc-code, ub))
      918                                   ) + chr(1) +
      919                                   v-range-type)
      920                           ,input ?
      921                           ,input v-db-for-send
      922                           ) no-error .
      923             if error-status :error then do:
      924               undo, return error return-value.
      925             end.
      926           end.
      927         end.
      928       end.
      929     end.
      930   end procedure.
      931   procedure cre-loc-sc-code-range :
      932     define input parameter v-cur-code as integer no-undo .
      933   define input parameter p-cdrg-type as character no-undo .
      934     do
      935     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      936     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      937     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      938     :
      939       define buffer buf_code-range for ub.code-range .
      940       find first buf_code-range
      941            where buf_code-range.range-type = p-cdrg-type
      942              and buf_code-range.first-code >= v-cur-code
      943            no-error .
      944       if not available buf_code-range then do:
      945         run new-bcod-gen-code-range in this-procedure
      946           ( input 0,
      947             input p-cdrg-type
      948           ) no-error .
      949         if error-status :error then do:
      950           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      951                                          + "Код &2&1&3 &4"
      952                                         , chr(10)
      953                                         , v-cur-code
      954                                         , error-status:get-message(1)
      955                                         , return-value
      956                                        ) .
      957         end.
      958       end.
      959     end.
      960   end procedure.
      961   procedure mark-used-if-need :
      962   define input parameter p-cur-code as integer no-undo .
      963   define input parameter p-range-type like ub.code-range.range-type no-undo .
      964   define input parameter p-db-num like ub.code-range.db-num no-undo .
      965     do
      966     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      967     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      968     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      969     :
      970       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      971       define buffer buf_code-range for ub.code-range .
      972       assign
      973       v-db-num = if p-range-type = 'sclc':U
      974                  then 0
      975                  else p-db-num
      976       .
      977   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      978   define buffer locK-batchprocess2 for ub.batchprocess.
      979   run gbl/lock-prc.p
      980       (input 'lscc':U
      981       ,input 0
      982       ,input 0
      983       ,input 0
      984       ,input ""
      985       ,input ""
      986       ,input ""
      987       ,input (
      988               ",,,Вкл/выкл лок. вес. кодов"
      989              )
      990       ,input true
      991       ,buffer lock-batchprocess2
      992       ) no-error .
      993     if error-status :error then do:
      994       message
      995         vss-workfile vss-revision vss-description skip
      996         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      997         view-as alert-box error .
      998       undo, return error .
      999     end.
     1000       find first buf_code-range
     1001            where buf_code-range.range-type = p-range-type
     1002              and buf_code-range.first-code >= p-cur-code
     1003              and buf_code-range.last-code <= p-cur-code
     1004              and buf_code-range.db-num = v-db-num
     1005            no-error .
     1006       if not available buf_code-range then do:
     1007         message
     1008           vss-workfile vss-revision vss-description skip
     1009           "Ошибка при создании поиске диапазона" skip
     1010           "База данных" p-db-num skip
     1011           "Код" p-cur-code skip
     1012           "Тип" p-range-type
     1013           error-status :get-message(1) skip
     1014           return-value skip
     1015           view-as alert-box error .
     1016         undo, return error .
     1017       end.
     1018       if buf_code-range.stts = "f":U then do:
     1019         assign
     1020         buf_code-range.stts = "u":U
     1021         .
     1022       end.
     1023     end.
     1024   end procedure.
     1025   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026   define new global shared variable g#lib-nws as handle no-undo .
     1027   DEFINE VARIABLE conf-par as character no-undo .
     1028   DEFINE VARIABLE par-type as character no-undo .
     1029   DEFINE VARIABLE v-l as logical no-undo .
     1030   define variable v-inn-uniq-error as logical no-undo .
     1031   define variable v-new-inn like ub.person.inn no-undo .
     1032   define variable v-date as date no-undo .
     1033   define variable v-time as integer no-undo .
     1034   define variable v-err-mess as character no-undo .
     1035   define variable v-db-num as integer no-undo .
     1036   define variable v-trg-param as character no-undo .
     1037   assign
     1038   v-trg-param = ub.person.trg-param
     1039   ub.person.trg-param = '':U
     1040   .
     1041   define buffer buf_c-cli-hist for ub.c-cli-hist.
     1042   define buffer buf_c-person for ub.c-person.
     1043   define buffer buf_dis-card for ub.dis-card.
     1044   main-block:
     1045   do
     1046   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1047   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1048   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1049   :
     1050     if not g#news then do:
     1051   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1052   define variable send-ref as logical no-undo.
     1053   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1054     (input  'send-ref'
     1055     ,input  0
     1056     ,input  ''
     1057     ,input  0
     1058     ,input  ''
     1059     ,input  ''
     1060     ,input  ''
     1061     ,input  no
     1062     ,output conf-par
     1063     ,output par-type
     1064     ) no-error .
     1065     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
     1066       if send-ref then do:
     1067         assign
     1068         v-l = yes
     1069         .
     1070         IF not new(ub.person) then do:
     1071           buffer-compare ub.person using
     1072           city ind address name1 name2
     1073           to oldb
     1074           case-sensitive
     1075           save result in v-l .
     1076           if not v-l then do:
     1077             for each buf_dis-card no-lock where
     1078                     buf_dis-card.cli-type = 'чел':U
     1079                 AND buf_dis-card.cli-code = person.psn-code :
     1080               run trg/nu_dcard.p (
     1081                             input  buf_dis-card.d-card
     1082                             ,input  buf_dis-card.emitent-host-code
     1083                             ,input  "":U
     1084                             ,input  0
     1085                             ,input  "U":U
     1086                           ).
     1087             end.
     1088           end.
     1089         end.
     1090       end.
     1091     end.
     1092     if g#news then do:
     1093       v-new-inn = ub.person.inn.
     1094       run trg/inn-uniq.p (
     1095                        input-output v-new-inn
     1096                       ,input oldb.inn
     1097                       ,input 'чел':U
     1098                       ,input ub.person.psn-code
     1099                       ,input yes
     1100                       ,input recid(ub.person)
     1101                       ,input buffer ub.person:handle
     1102                       ,output v-inn-uniq-error
     1103                       ) no-error.
     1104       if error-status:error then do:
     1105         v-err-mess = substitute("Контрагент &1&2&3Ошибка при проверке ИНН на уникальность&3&4&3&5"
     1106                                 , 'чел':U
     1107                                 , ub.person.psn-code
     1108                                 , chr(10)
     1109                                 , error-status:get-message(1)
     1110                                 , return-value) .
     1111         undo, return error v-err-mess.
     1112       end.
     1113       if v-inn-uniq-error then do:
     1114         v-err-mess = substitute("Контрагент &1&2&3&4"
     1115                                 , 'чел':U
     1116                                 , ub.person.psn-code
     1117                                 , chr(10)
     1118                                 , return-value) .
     1119         undo, return error v-err-mess.
     1120       end.
     1121       if g#db-num = 0 then do:
     1122         assign
     1123         ub.person.inn = v-new-inn.
     1124       end.
     1125     end.
     1126     if new(ub.person) then do:
     1127       if g#news then do:
     1128         assign
     1129           v-db-num = g#news-source-db
     1130         .
     1131       end.
     1132       else do:
     1133         assign
     1134           v-db-num = g#db-num
     1135         .
     1136       end.
     1137       run gen-new-code-range-if-neces (
     1138                                         input v-db-num
     1139                                        ,input 'pngb':U
     1140                                        ,input ub.person.psn-code
     1141                                        ,input g#news
     1142                                        ,input g#db-num
     1143                                        ,input g#news-source-db
     1144                                      ) no-error .
     1145       if error-status:error then do:
     1146         message
     1147         vss-workfile vss-revision vss-description skip
     1148         error-status:get-message(1) skip
     1149         return-value
     1150         view-as alert-box error .
     1151         undo main-block,  return error .
     1152       end.
     1153     end.
     1154     if lookup('no-hist':U, v-trg-param) = 0 then do:
     1155       if g#news then do:
     1156         define variable v-send as integer no-undo .
     1157         v-send = integer('0':U).
     1158   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1160     (input  g#db-num
     1161     ,input  'person':U
     1162     ,input  0
     1163     ,input  '':U
     1164     ,input  0
     1165     ,input  '':U
     1166     ,input  '':U
     1167     ,input  '':U
     1168     ,input  0
     1169     ,input  0
     1170     ,input  0
     1171     ,input  'nws-to-hist'
     1172     ,output v-send
     1173     ) no-error .
     1174       end.
     1175       if not g#news
     1176       or v-send >= 0 then do:
     1177         run cur-time in this-procedure(output v-date, output v-time).
     1178         create buf_c-person.
     1179         buffer-copy oldb to buf_c-person
     1180         assign
     1181         buf_c-person.psn-code           = ub.person.psn-code
     1182         buf_c-person.chip-num           = next-value (s-cli-chip, ub)
     1183         buf_c-person.corr-time          = v-time
     1184         buf_c-person.corr-user-db-num   = g#db-num
     1185         buf_c-person.corr-user-name     = (if g#news
     1186                                          then (chr(4) +  'СПН':U)
     1187                                          else (if g#esys
     1188                                                then (chr(4) +  'ВС':U)
     1189                                                else g#userid)
     1190                                          )
     1191         buf_c-person.corr-date          = v-date
     1192         .
     1193         create buf_c-cli-hist.
     1194         buffer-copy buf_c-person to buf_c-cli-hist
     1195         assign
     1196         buf_c-cli-hist.obj-type = 'чел':U
     1197         buf_c-cli-hist.obj-code = ub.person.psn-code
     1198         buf_c-cli-hist.action = (if new (ub.person )
     1199                                 then integer('1':U)
     1200                                 else integer('2':U))
     1201         buf_c-cli-hist.subject = 'person':U
     1202         buf_c-cli-hist.is-news = g#news
     1203         buf_c-cli-hist.source-type = (if g#news
     1204                                       then 'db':U
     1205                                       else (if g#esys
     1206                                             then 'esys':U
     1207                                             else "":U)
     1208                                       )
     1209         buf_c-cli-hist.source-ref = (if g#news
     1210                                      then string(g#news-source-db)
     1211                                      else (if g#esys
     1212                                            then string(g#esys-source-esys)
     1213                                            else "":U)
     1214                                      )
     1215         .
     1216       end.
     1217     end.
     1218     if lookup('no-callnews':U, v-trg-param) = 0 then do:
     1219       run str/callnews.p
     1220         (input 'person':U
     1221         ,input (buffer ub.person:handle)
     1222         ) no-error .
     1223       if error-status:error then do:
     1224         undo main-block, return error return-value .
     1225       end.
     1226     end.
     1227     if g#oxml = yes
     1228     then do:
     1229       run str/calloxml.p (
     1230             input 'update':U
     1231           , input 'person':U
     1232           , input ( buffer ub.person:handle )
     1233       ) no-error.
     1234       if error-status :error
     1235       then do:
     1236           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1237                                , chr(10)
     1238                                , vss-workfile
     1239                                , return-value
     1240                                , error-status :get-message ( 1 ) ).
     1241       end.
     1242     end.
     1243   end.
