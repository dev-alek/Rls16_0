        1   block-level on error undo, throw.
        2   define input  parameter p-host-code           like ub.fin-statement.host-code    no-undo .
        3   define input  parameter p-fin-sttm-code       like ub.fin-statement.sttm-code    no-undo .
        4   define input  parameter p-mode                as character                 no-undo .
        5   define input  parameter p-author              as character                 no-undo .
        6   define input  parameter p-status-current      like ub.fin-statement.status_      no-undo .
        7   define input  parameter p-status-date         like ub.fin-statement.fact-date    no-undo .
        8   define output parameter p-status_             like ub.fin-statement.status_      no-undo .
        9   define output parameter p-ask-date            as logical                   no-undo .
       10   define output parameter p-ask-message         as character                 no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Стандартный граф переходов банковских выписок".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-db-num like ub.db.db-num no-undo .
       87   define variable v-author as character no-undo .
       88   define buffer buf_sysconf for ub.sysconf.
       89   define buffer buf_fin-statement for ub.fin-statement.
       90   define buffer bf_clients for ub.clients.
       91   define buffer bf_db for ub.db .
       92   do on error undo, return error substitute ("Ошибка при вызове программы finsgraf.p: &1 &2 &3 &4 при работе с документом &4.", error-status:get-message(1), error-status:get-message(2), return-value, p-host-code, p-fin-sttm-code):
       93     if p-mode <> '<закрытие документа>':U
       94     AND p-mode <> '<открытие документа>':U
       95     AND p-mode <> '<закрытие документа на факт>':U
       96        then do:
       97        return error substitute ("Неверный режим обработки документа &1.", p-mode).
       98     end.
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      101     (output v-db-num
      102     ) no-error .
      103     if error-status:error then do:
      104       return error "Ошибка при определении номер текущей БД".
      105     end.
      106     find first buf_sysconf where
      107                buf_sysconf.host-code = p-host-code no-error.
      108     if not available buf_sysconf then do:
      109        return error substitute ("Не найдена фирма с номером &1 для платежа", p-host-code, p-fin-sttm-code).
      110     end.
      111     find first buf_fin-statement where
      112               buf_fin-statement.host-code = p-host-code
      113           AND buf_fin-statement.sttm-code = p-fin-sttm-code no-lock no-error.
      114     if not available buf_fin-statement then do:
      115        return error substitute ("Не найдена выписка: фирма &1 с номером &2.", p-host-code, p-fin-sttm-code).
      116     end.
      117     if buf_sysconf.firm-db-num = ? or
      118        buf_sysconf.firm-db-num < 0 then do:
      119        return error substitute ("Неверный номер базы данных &1 фирмы &2.", buf_sysconf.firm-db-num, buf_sysconf.host-code).
      120     end.
      121     find first bf_db where bf_db.db-num = buf_sysconf.firm-db-num no-lock no-error.
      122     if not available bf_db then do:
      123        return error substitute("Не найдена БД &1 документа &2 для фирмы &3.", buf_sysconf.firm-db-num, p-fin-sttm-code, buf_sysconf.host-code).
      124     end.
      125     if v-db-num <> buf_sysconf.firm-db-num then do:
      126       return error substitute("Нельзя изменять запись БАНКОВСКОЙ ВЫПИСКИ в БД, отличной от главной БД фирмы:&3" +
      127                               "номер текущей БД &1, номер главной БД фирмы &2"
      128                               , v-db-num
      129                               , buf_sysconf.firm-db-num
      130                               , chr(10)
      131                               ).
      132     end.
      133     if buf_fin-statement.status_ = 'факт':U then do:
      134        return error substitute ("Банковская выписка &1 для фирмы &2 закрыта до факта.&3"
      135                                 + "Операции с ней не допустимы."
      136                                 , buf_fin-statement.prn-doc-code
      137                                 , buf_sysconf.host-code
      138                                 , chr(10)
      139                                 ).
      140     end.
      141     run trg/finsgrfp.p (
      142                      input this-procedure:handle
      143                     ,input  buf_fin-statement.fins-doc-type
      144                     ,input  buf_fin-statement.fins-ext-doc-type
      145                     ,input  buf_fin-statement.status_
      146                     ,input  p-mode
      147                     ,input  p-author
      148                     ,input  p-status-date
      149                     ,output p-status_
      150                     ,output p-ask-date
      151                     ,output p-ask-message
      152                     ) no-error.
      153     if error-status:error then do:
      154        return error substitute ("Ошибка:  &1&2"
      155                                 + "по операции: &3&2"
      156                                 + "номер документа &4&2"
      157                                 + "тип &5&2"
      158                                 + "расш.тип &6&2"
      159                                 + "статус &7"
      160                                 ,return-value
      161                                 ,chr(10)
      162                                 ,p-mode
      163                                 ,buf_fin-statement.sttm-code
      164                                 ,buf_fin-statement.fins-doc-type
      165                                 ,buf_fin-statement.fins-ext-doc-type
      166                                 ,buf_fin-statement.status_
      167                                 ).
      168     end.
      169   end.
      170   procedure check-cl-bank :
      171   define buffer buf_fin-schet for ub.fin-schet.
      172   define buffer buf_fin-bank  for ub.fin-bank.
      173     do
      174     on error undo, return error
      175     :
      176     find first buf_fin-schet no-lock where
      177               buf_fin-schet.host-code = buf_fin-statement.host-code
      178           AND buf_fin-schet.code-schet = buf_fin-statement.code-schet .
      179     find first buf_fin-bank no-lock where
      180               buf_fin-bank.host-code = buf_fin-statement.host-code
      181           AND buf_fin-bank.code-bank = buf_fin-statement.code-bank.
      182     if buf_fin-bank.cl-bank <> '':U then do:
      183       return error substitute("Выписка &1 (вн.№ &2) для фирмы &3 проходит по счету банка &4,&5" +
      184                               "который подключен к системе КЛИЕНТ-БАНК. ВРУЧНУЮ обработать невозможно"
      185                               , buf_fin-statement.prn-doc-code
      186                               , buf_fin-statement.sttm-code
      187                               , buf_fin-statement.host-code
      188                               , chr(10)
      189                               , buf_fin-bank.bank-name).
      190     end.
      191     end.
      192   end procedure.
