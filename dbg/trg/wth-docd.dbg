        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.wth-doc.
        3   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
        4   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
        5   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
        6   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
        7   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
        8   define variable vss-description AS CHAR NO-UNDO INIT "триггер на удаление документов МЦ":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3'
       29                         ,ub.wth-doc.doc-code
       30                         ,ub.wth-doc.ext-doc-type
       31                         ,ub.wth-doc.status_ )
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define new global shared variable g#attr-lib  as handle no-undo .
       86   define variable v-attr-lib-variable as handle no-undo .
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       89   procedure thbjattr_code :
       90      define input  parameter p-upper-code     as character no-undo .
       91      define input  parameter p-code           as character no-undo .
       92      define output parameter p-label          as character no-undo .
       93      define output parameter p-user-can-edit  as logical   no-undo .
       94      define output parameter p-output-display as logical   no-undo .
       95      define output parameter p-other          as character no-undo .
       96      define output parameter p-prop-list      as character no-undo .
       97      define output parameter p-prop-type-list as character no-undo .
       98      define output parameter p-prop-label-list as character no-undo .
       99      define output parameter p-global          as logical no-undo .
      100      define output parameter p-host           as logical no-undo .
      101      define output parameter p-shop           as logical no-undo .
      102      define output parameter p-store          as logical no-undo .
      103      define output parameter p-db             as logical no-undo .
      104      define variable p-region as logical no-undo.
      105      run thbjattr_code_reg in this-procedure (
      106                                               p-upper-code,
      107                                               p-code,
      108                                               output p-label,
      109                                               output p-user-can-edit,
      110                                               output p-output-display,
      111                                               output p-other,
      112                                               output p-prop-list,
      113                                               output p-prop-type-list,
      114                                               output p-prop-label-list,
      115                                               output p-global,
      116                                               output p-host,
      117                                               output p-shop,
      118                                               output p-store,
      119                                               output p-db,
      120                                               output p-region
      121                                               ).
      122   end procedure.
      123   procedure thbjattr_code_reg :
      124   define input  parameter p-upper-code     as character no-undo .
      125   define input  parameter p-code           as character no-undo .
      126   define output parameter p-label          as character no-undo .
      127   define output parameter p-user-can-edit  as logical   no-undo .
      128   define output parameter p-output-display as logical   no-undo .
      129   define output parameter p-other          as character no-undo .
      130   define output parameter p-prop-list      as character no-undo .
      131   define output parameter p-prop-type-list as character no-undo .
      132   define output parameter p-prop-label-list as character no-undo .
      133   define output parameter p-global          as logical no-undo .
      134   define output parameter p-host           as logical no-undo .
      135   define output parameter p-shop           as logical no-undo .
      136   define output parameter p-store          as logical no-undo .
      137   define output parameter p-db             as logical no-undo .
      138   define output parameter p-region         as logical no-undo .
      139   do
      140   on error undo, return error return-value
      141   :
      142       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      143       (input  p-upper-code
      144       ,input  p-code
      145       ,output p-label
      146       ,output p-user-can-edit
      147       ,output p-output-display
      148       ,output p-other
      149       ,output p-prop-list
      150       ,output p-prop-type-list
      151       ,output p-prop-label-list
      152       ,output p-global
      153       ,output p-host
      154       ,output p-shop
      155       ,output p-store
      156       ,output p-db
      157       ,output p-region
      158       ) no-error .
      159     if error-status :error
      160     then do:
      161       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      162     end.
      163   end.
      164   end procedure.
