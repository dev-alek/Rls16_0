      375   procedure wthcattr-sprcli :
      376   define input parameter parparentproc  as widget-handle no-undo.
      377   define input parameter p-mode  as character no-undo.
      378   define input-output parameter p-value as character no-undo .
      379   define output parameter p-setted as logical no-undo .
      380     DEFINE VARIABLE v-value as character no-undo .
      381     define variable v-cli-type as character no-undo .
      382     define variable v-cli-code as integer no-undo .
      383     define buffer buf_clients   for ub.clients.
      384     define variable v_rid as character no-undo.
      385     define variable ref-rec as recid no-undo .
      386     do
      387     on error undo, return error
      388     :
      389         v-value = p-value.
      390      if p-value <> '':U then do:
      391       assign
      392       v-cli-type = substring(p-value, 1, 3)
      393       v-cli-code = integer(substring(p-value, 4))
      394       no-error.
      395       if error-status:error then do:
      396         assign
      397         v-cli-type = '':U
      398         v-cli-code = 0
      399         .
      400       end.
      401      end.
      402      FIND FIRST buf_clients NO-LOCK WHERE
      403               buf_clients.obj-type = v-cli-type AND
      404               buf_clients.obj-code = v-cli-code  NO-ERROR.
      405      IF available(buf_clients) then do:
      406       run ref/cli-all.w (
      407                   input parparentproc
      408                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      409                  ,input v-cli-type
      410                  ,input 'все':U
      411                  ,input 'все':U
      412                  ,input RECID( buf_clients )
      413                  ,input ",,,,,,NO"
      414                  ,input ?
      415                  ,OUTPUT v_rid ).
      416     END.
      417     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      418       run ref/cli-all.w (
      419                    input parparentproc
      420                   ,INPUT "b-sel":U
      421                  ,input  v-cli-type
      422                  ,input 'все':U
      423                  ,input 'текущие':U
      424                  ,input ?
      425                  ,input ",,,,,,NO"
      426                  ,input ?
      427                  ,OUTPUT v_rid ).
      428     END.
      429     else do:
      430       message
      431       if p-value = "":U then 'Атрибут не задан!'
      432       else substitute('Не найден клиент &1',p-value)
      433       view-as alert-box warning.
      434     end.
      435     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      436       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      437       IF ERROR-STATUS:ERROR THEN DO:
      438           RETURN NO-APPLY.
      439       END.
      440       FIND FIRST buf_clients NO-LOCK WHERE
      441                  RECID( buf_clients ) = ref-rec NO-ERROR.
      442       IF AVAIL buf_clients THEN DO:
      443         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      444       end.
      445     end.
      446     if v-value <> p-value then do:
      447       p-value = v-value.
      448       p-setted = yes.
      449     end.
      450     end.
      451   end procedure.
      452     define new global shared variable g#wthcalib as handle no-undo.
      453   DEF BUFFER buf-line FOR ub.wth-line.
      454   DEF BUFFER buf_line FOR ub.wth-line.
      455   DEF BUFFER buf-dtl  FOR ub.wth-dtl.
      456   DEF BUFFER buf_dtl  FOR ub.wth-dtl.
      457   DEF BUFFER buf_c-wth-doc FOR ub.c-wth-doc.
      458   DEF BUFFER buf_c-wth-line FOR ub.c-wth-line.
      459   DEF BUFFER buf_c-wth-dtl FOR ub.c-wth-dtl.
      460   define buffer buf_c-wth-parts  for ub.c-wth-parts.
      461   define buffer buf_wth-parts   for ub.wth-parts.
      462   define buffer buf_wth-doc-attr    for ub.wth-doc-attr.
      463   define buffer buf-wth-doc-attr    for ub.wth-doc-attr.
      464   define    variable v-dstnws as logical init YES no-undo.
      465   main-block:
      466   do
      467   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      468   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      469   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      470   :
      471     if ( ub.wth-doc.is-del = no) AND
      472       (ub.wth-doc.status_ = 'факт':U or
      473        ub.wth-doc.status_ = 'разрешен':U) then undo main-block, return error.
      474     find first ub.chk-doc no-lock
      475       where ub.chk-doc.out-code = ub.wth-doc.doc-code
      476       and   lookup(string(ub.chk-doc.chk-type),'2,3,4,5,7':U )  > 0
      477       no-error .
      478     if available ub.chk-doc then do:
      479       message
      480         vss-workfile vss-revision vss-description skip
      481         "Ошибка при удалении автоматического документа МЦ" skip
      482         "Найден чек привязанный к документу" skip
      483         "Документ" ub.wth-doc.doc-code skip
      484         "Код чека" ub.chk-doc.doc-code skip
      485         view-as alert-box error .
      486       undo main-block, return error .
      487     end.
      488     IF NOT g#news THEN DO:
      489         define variable v-atrValue    as character no-undo .
      490         define variable v-atrType     as character no-undo .
      491         define variable v-value-character as character no-undo .
      492         define variable v-value-date as date no-undo .
      493         define variable v-value-decimal as decimal no-undo .
      494         define variable v-value-integer as INTEGER no-undo .
      495         define variable v-value-logical AS LOGICAL no-undo .
      496         define variable v-param-type as character no-undo .
      497         define variable v-stfactpref as character no-undo .
      498         define variable v-numsfact   as integer no-undo .
      499         define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      500         define variable v-tth as handle no-undo .
      501         assign
      502         v-tth = buffer thbjattr_thbj-attr:table-handle .
      503   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input ub.wth-doc.doc-code ,
      504                           input 'wthnsf':U ,
      505                          output v-atrValue ,
      506                          output v-atrType ) NO-ERROR .
      507         if v-atrValue > '' then do:
      508            run adm/shattri.p (
      509               input "get":U
      510               ,input  ub.wth-doc.obj-type
      511               ,input  ub.wth-doc.obj-code
      512               ,input  'wthdoc':U
      513               ,input  '':U
      514               ,output v-value-character
      515               ,output v-value-date
      516               ,output v-value-decimal
      517               ,output v-value-integer
      518               ,output v-value-logical
      519               ,output v-param-type
      520               ,INPUT-OUTPUT table-handle v-tth
      521               ) no-error .
      522           IF not error-status:error  then do:
      523             for each thbjattr_thbj-attr no-lock:
      524               if thbjattr_thbj-attr.prop-code = 'stfactpref':U then v-stfactpref = thbjattr_thbj-attr.property-value-character.
      525               if thbjattr_thbj-attr.prop-code = 'numsfact':U then v-numsfact = thbjattr_thbj-attr.property-value-integer.
      526             end.
      527           end.
      528           if v-atrValue = v-stfactpref + string(v-numsfact) then do:
      529             v-numsfact = v-numsfact - 1.
      530             RUN thbjattr_write IN THIS-PROCEDURE (
      531                  input ub.wth-doc.obj-type
      532                 ,input ub.wth-doc.obj-code
      533                 ,input 'wthdoc':U
      534                 ,input 'numsfact':U
      535                 ,input '':U
      536                 ,input ?
      537                 ,input 0
      538                 ,input v-numsfact
      539                 ,input no
      540             ) NO-ERROR.
      541             IF ERROR-STATUS:error THEN do:
      542               MESSAGE ERROR-STATUS:get-message(1)  SKIP
      543               RETURN-VALUE
      544               VIEW-AS ALERT-BOX warning.
      545             END.
      546           end.
      547         end.
      548     END.
      549     FOR EACH buf-line NO-LOCK WHERE buf-line.doc-code = ub.wth-doc.doc-code :
      550       FIND buf_line EXCLUSIVE-LOCK WHERE RECID( buf_line ) = RECID( buf-line ).
      551       FOR EACH buf-dtl NO-LOCK WHERE
      552        buf-dtl.doc-code = buf_line.doc-code AND
      553        buf-dtl.wth-code = buf_line.wth-code AND
      554        buf-dtl.w-p-code = buf_line.w-p-code :
      555         FIND buf_dtl EXCLUSIVE-LOCK WHERE RECID( buf_dtl ) = RECID( buf-dtl ).
      556         DELETE buf_dtl.
      557       END.
      558       DELETE buf_line.
      559     END.
      560     if can-find(first buf_wth-parts where buf_wth-parts.out-code = ub.wth-doc.doc-code  ) then do:
      561       undo, return error 'Найдены неснятые резервы по документу'.
      562     end.
      563     if can-find(first buf_wth-parts where buf_wth-parts.doc-code = ub.wth-doc.doc-code  ) then do:
      564       undo, return error 'Найдены партии, порожденные данным документом'.
      565     end.
      566     FOR EACH buf_wth-doc-attr NO-LOCK WHERE buf_wth-doc-attr.doc-code = ub.wth-doc.doc-code :
      567       FIND buf-wth-doc-attr EXCLUSIVE-LOCK WHERE RECID( buf-wth-doc-attr ) = RECID( buf_wth-doc-attr ).
      568       delete buf-wth-doc-attr.
      569     end.
      570     if ub.wth-doc.status_ = 'накл':U then do:
      571       for each buf_c-wth-doc where
      572               buf_c-wth-doc.doc-code = ub.wth-doc.doc-code
      573       on error undo MAin-block,  return error return-value
      574       :
      575         delete buf_c-wth-doc.
      576       end.
      577       for each buf_c-wth-line where
      578               buf_c-wth-line.doc-code = ub.wth-doc.doc-code
      579       on error undo MAin-block,  return error return-value
      580       :
      581         delete buf_c-wth-line.
      582       end.
      583       for each buf_c-wth-dtl where
      584               buf_c-wth-dtl.doc-code = ub.wth-doc.doc-code
      585       on error undo MAin-block,  return error return-value
      586       :
      587         delete buf_c-wth-dtl.
      588       end.
      589       for each buf_c-wth-parts where
      590                buf_c-wth-parts.out-code = wth-doc.doc-code
      591       on error undo MAin-block,  return error return-value
      592       :
      593         delete buf_c-wth-parts.
      594       end.
      595     end.
      596       if lookup(ub.wth-doc.ext-doc-type,'ep,ip,pj,rp,dp,oj':U) > 0 and g#db-num = 0  then do:
      597               run adm/shattri.p ( input "get":U
      598                             , input ""
      599                             , input 0
      600                             , input 'attr-wthrep':U
      601                             , input  ""
      602                             , output v-value-character
      603                             , output v-value-date
      604                             , output v-value-decimal
      605                             , output v-value-integer
      606                             , output v-value-logical
      607                             , output v-param-type
      608                             , INPUT-OUTPUT TABLE thbjattr_thbj-attr
      609                             ) no-error .
      610           for first thbjattr_thbj-attr
      611                 where thbjattr_thbj-attr.obj-code  = 0
      612                   and thbjattr_thbj-attr.obj-type  = ""
      613                   and thbjattr_thbj-attr.prop-code = 'docdstnws':U
      614                   and thbjattr_thbj-attr.upper-prop-code = 'attr-wthrep':U
      615                 no-lock:
      616               assign
      617               v-dstnws = not thbjattr_thbj-attr.property-value-logical.
      618           end.
      619       end.
      620     if
      621     ub.wth-doc.status_ = 'факт':U
      622     and  (lookup(ub.wth-doc.ext-doc-type,'ep,ip,pj,rp,dp,oj':U) = 0 or ( lookup(ub.wth-doc.ext-doc-type,'ep,ip,pj,rp,dp,oj':U) > 0 and v-dstnws))
      623     then do:
      624       run nws/cmd-del.p
      625         ( input "wth-doc":U
      626          ,input (buffer ub.wth-doc:handle)
      627          ,input "":U
      628         ) no-error .
      629       if error-status :error then do:
      630         undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      631       end.
      632     end.
      633       if g#oxml = yes
      634       then do:
      635       run str/calloxml.p (
      636             input 'delete':U
      637           , input 'wth-doc':U
      638           , input ( buffer ub.wth-doc:handle )
      639       ) no-error.
      640       if error-status :error
      641       then do:
      642           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      643                                , chr(10)
      644                                , vss-workfile
      645                                , return-value
      646                                , error-status :get-message ( 1 ) ).
      647       end.
      648       end.
      649   END.
