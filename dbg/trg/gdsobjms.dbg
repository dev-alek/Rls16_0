        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type         like ub.gds-obj.obj-type  no-undo .
        3   define input  parameter p-obj-code         like ub.gds-obj.obj-code  no-undo .
        4   define input  parameter p-artic            like ub.gds-obj.artic     no-undo .
        5   define input  parameter p-prod-type        like ub.gds-obj.prod-type no-undo .
        6   define input  parameter p-prod-code        like ub.gds-obj.prod-code no-undo .
        7   define input  parameter p-action           as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Вывести информацию о товаре на объекте".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   case p-action :
       73     when "ov-on" then do:
       74       define buffer buf_goods      for ub.goods .
       75       define buffer buf_price-doc  for ub.price-doc .
       76       define buffer buf_price-list for ub.price-list .
       77       find first buf_goods no-lock
       78         where buf_goods.artic     = p-artic
       79           and buf_goods.prod-type = p-prod-type
       80           and buf_goods.prod-code = p-prod-code
       81         .
       82       for each buf_price-doc no-lock
       83         where buf_price-doc.obj-type = p-obj-type
       84           and buf_price-doc.obj-code = p-obj-code
       85           and buf_price-doc.status_  = 'разрешен':U
       86       ,first buf_price-list no-lock
       87         where buf_price-list.doc-num   = buf_price-doc.doc-num
       88           and buf_price-list.artic     = p-artic
       89           and buf_price-list.prod-type = p-prod-type
       90           and buf_price-list.prod-code = p-prod-code
       91       on error undo, return error
       92       :
       93         message
       94           "Для товара сейчас идет переоценка" skip
       95           "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
       96           buf_goods.gds-name skip
       97           "Переоценка" buf_price-doc.doc-num skip
       98           "Включить переоценку невозможно."
       99           view-as alert-box .
      100         return .
      101       end.
      102       message
      103         vss-workfile vss-revision vss-description skip
      104         "Установлен признак того, что для товара идет переоценка" skip
      105         "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
      106         buf_goods.gds-name skip
      107         "Переоценка в статусе" 'разрешен':U "не найдена" skip
      108         view-as alert-box error .
      109     end.
      110     otherwise do:
      111       message
      112         vss-workfile vss-revision vss-description skip
      113         "Неизвестное значение параметра p-action " skip
      114         "p-action" p-action skip
      115         view-as alert-box error .
      116       undo, return error .
      117     end.
      118   end.
