        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-host-code like ub.fin-doc.host-code no-undo .
        4   define input parameter p-fin-doc-code like ub.fin-doc.fin-doc-code no-undo .
        5   define input parameter p-fact-delete as logical no-undo .
        6   define input parameter p-silent as logical no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Удаление платежа закрытого до факт".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define new global shared variable g#lib-farh as handle no-undo .
      308   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   procedure fd-attr-code :
      310     do
      311     on error undo, return error
      312     :
      313       define input  parameter p-code           as character no-undo .
      314       define output parameter p-type           as character no-undo .
      315       define output parameter p-format         as character no-undo .
      316       define output parameter p-label          as character no-undo .
      317       define output parameter p-user-can-edit  as logical   no-undo .
      318       define output parameter p-output-display as logical   no-undo .
      319       define output parameter p-other          as character no-undo .
      320       case p-code :
      321               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      322               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      323               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      324               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      325               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      326               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      327               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
      328               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      329         otherwise do:
      330           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      331         end.
      332       end.
      333     end.
      334   end procedure.
      335   procedure fd-attr-tooltip :
      336     do
      337     on error undo, return error
      338     :
      339       define input  parameter p-code    as character no-undo .
      340       define output parameter p-tooltip as character no-undo .
      341       define output parameter p-label   as character no-undo .
      342       case p-code :
      343               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      344               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      345               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      346               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      347               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      348               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      349               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      350               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      351         otherwise do:
      352           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      353         end.
      354       end.
      355     end.
      356   end procedure.
      357   procedure fin-doc-attr-write :
      358    do
      359    on error undo, return error return-value
      360    :
      361   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      362   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      363   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      364   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      365   define variable  v-format         as character no-undo .
      366   define variable  v-label          as character no-undo .
      367   define variable  v-user-can-edit  as logical   no-undo .
      368   define variable  v-output-display as logical   no-undo .
      369   define variable  v-other          as character no-undo .
      370   define variable  v-type           as character no-undo .
      371   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      372   run fd-attr-code in this-procedure
      373                                     (input  p-attr-code
      374                                     ,output v-type
      375                                     ,output v-format
      376                                     ,output v-label
      377                                     ,output v-user-can-edit
      378                                     ,output v-output-display
      379                                     ,output v-other
      380                                     ) no-error .
      381   if error-status :error then do:
      382     undo, return error return-value .
      383   end.
      384   find first buf_fin-doc-attr  exclusive-lock  where
      385             buf_fin-doc-attr.attr-code    = p-attr-code
      386         AND buf_fin-doc-attr.host-code    = p-host-code
      387         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      388     if not available  buf_fin-doc-attr then do:
      389         create buf_fin-doc-attr.
      390         assign
      391         buf_fin-doc-attr.attr-code    = p-attr-code
      392         buf_fin-doc-attr.attr-value   = p-attr-value
      393         buf_fin-doc-attr.host-code    = p-host-code
      394         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      395         .
      396     end.
      397     else do:
      398          assign
      399          buf_fin-doc-attr.attr-value = p-attr-value.
      400     end.
      401    end.
      402   end procedure.
      403   procedure fd-attr-exist :
      404     do
      405     on error undo, return error
      406     :
      407       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      408       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      409       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      410       define output parameter p-exist   as logical  no-undo .
      411       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      412       define variable  v-type           as character no-undo .
      413       define variable  v-format         as character no-undo .
      414       define variable  v-label          as character no-undo .
      415       define variable  v-user-can-edit  as logical   no-undo .
      416       define variable  v-output-display as logical   no-undo .
      417       define variable  v-other          as character no-undo .
      418       run fd-attr-code in this-procedure
      419         (input  p-code
      420         ,output v-type
      421         ,output v-format
      422         ,output v-label
      423         ,output v-user-can-edit
      424         ,output v-output-display
      425         ,output v-other
      426         ) no-error .
      427       if error-status :error then do:
      428         undo, return error return-value .
      429       end.
      430       find first buf_fin-doc-attr exclusive-lock
      431         where buf_fin-doc-attr.host-code  = p-host-code
      432           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      433           and buf_fin-doc-attr.attr-code = p-code
      434         no-error .
      435       if  available buf_fin-doc-attr then do:
      436         p-exist = yes.
      437       end.
      438     end.
      439   end procedure.
      440   procedure fd-attr-delete :
      441     do
      442     on error undo, return error
      443     :
      444     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      445     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      446     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      447     define output parameter p-deleted  as logical no-undo.
      448       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      449       define variable  v-type           as character no-undo .
      450       define variable  v-format         as character no-undo .
      451       define variable  v-label          as character no-undo .
      452       define variable  v-user-can-edit  as logical   no-undo .
      453       define variable  v-output-display as logical   no-undo .
      454       define variable  v-other          as character no-undo .
      455       run fd-attr-code in this-procedure
      456         (input  p-code
      457         ,output v-type
      458         ,output v-format
      459         ,output v-label
      460         ,output v-user-can-edit
      461         ,output v-output-display
      462         ,output v-other
      463         ) no-error .
      464       if error-status :error then do:
      465         undo, return error return-value .
      466       end.
      467       find first buf_fin-doc-attr exclusive-lock
      468         where buf_fin-doc-attr.host-code  = p-host-code
      469           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      470           and buf_fin-doc-attr.attr-code = p-code
      471         no-error NO-WAIT.
      472       if not available buf_fin-doc-attr then do:
      473         p-deleted = no.
      474       end.
      475       else do:
      476         delete buf_fin-doc-attr no-error .
      477         if error-status:error then do:
      478           undo, return error return-value .
      479         end.
      480         p-deleted = yes.
      481       end.
      482     end.
      483   end procedure.
      484   procedure fin-doc-attr-value :
      485    do
      486    on error undo, return error return-value
      487    :
      488   define input  parameter p-host-code    like ub.fin-doc-attr.host-code    no-undo .
      489   define input  parameter p-fin-doc-code like ub.fin-doc-attr.fin-doc-code     no-undo .
      490   define input  parameter p-attr-code    like ub.fin-doc-attr.attr-code    no-undo .
      491   define output parameter p-attr-value   like ub.fin-doc-attr.attr-value   no-undo .
      492   define variable  v-format         as character no-undo .
      493   define variable  v-label          as character no-undo .
      494   define variable  v-user-can-edit  as logical   no-undo .
      495   define variable  v-output-display as logical   no-undo .
      496   define variable  v-other          as character no-undo .
      497   define variable  v-type           as character no-undo .
      498   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      499   run fd-attr-code in this-procedure
      500     (input  p-attr-code
      501     ,output v-type
      502     ,output v-format
      503     ,output v-label
      504     ,output v-user-can-edit
      505     ,output v-output-display
      506     ,output v-other
      507     ) no-error .
      508   if error-status :error then do:
      509     undo, return error return-value .
      510   end.
      511   find first buf_fin-doc-attr no-lock where
      512             buf_fin-doc-attr.attr-code    = p-attr-code
      513         AND buf_fin-doc-attr.host-code     = p-host-code
      514         AND buf_fin-doc-attr.fin-doc-code = p-fin-doc-code      no-error .
      515     if available  buf_fin-doc-attr then do:
      516       assign
      517       p-attr-value = buf_fin-doc-attr.attr-value
      518       .
      519     end.
      520     else do:
      521       p-attr-value = ? .
      522     end.
      523    end.
      524   end procedure.
      525   procedure fd-attr-news :
      526     do
      527     on error undo, return error
      528     :
      529       define input  parameter p-code           as character no-undo .
      530       define output parameter p-news           as logical   no-undo .
      531       case p-code :
      532               when 'shift-date':U then do:     assign     p-news = no.   end.
      533               when 'shift-num':U then do:     assign     p-news = no.   end.
      534               when 'shift-name':U then do:     assign     p-news = no.   end.
      535               when 'barcode':U then do:     assign     p-news = no.   end.
      536               when 'lockid':U then do:     assign     p-news = no.   end.
      537               when 'cover_sheet':U then do:     assign     p-news = no.   end.
      538               when 'pre-vedom':U then do:     assign     p-news = no.   end.
      539         otherwise do:
      540           undo, return error "неизвестный атрибут платежа " + " " + p-code .
      541         end.
      542       end.
      543     end.
      544   end procedure.
