      769   procedure thbjattr_code_reg :
      770   define input  parameter p-upper-code     as character no-undo .
      771   define input  parameter p-code           as character no-undo .
      772   define output parameter p-label          as character no-undo .
      773   define output parameter p-user-can-edit  as logical   no-undo .
      774   define output parameter p-output-display as logical   no-undo .
      775   define output parameter p-other          as character no-undo .
      776   define output parameter p-prop-list      as character no-undo .
      777   define output parameter p-prop-type-list as character no-undo .
      778   define output parameter p-prop-label-list as character no-undo .
      779   define output parameter p-global          as logical no-undo .
      780   define output parameter p-host           as logical no-undo .
      781   define output parameter p-shop           as logical no-undo .
      782   define output parameter p-store          as logical no-undo .
      783   define output parameter p-db             as logical no-undo .
      784   define output parameter p-region         as logical no-undo .
      785   do
      786   on error undo, return error return-value
      787   :
      788       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      789       (input  p-upper-code
      790       ,input  p-code
      791       ,output p-label
      792       ,output p-user-can-edit
      793       ,output p-output-display
      794       ,output p-other
      795       ,output p-prop-list
      796       ,output p-prop-type-list
      797       ,output p-prop-label-list
      798       ,output p-global
      799       ,output p-host
      800       ,output p-shop
      801       ,output p-store
      802       ,output p-db
      803       ,output p-region
      804       ) no-error .
      805     if error-status :error
      806     then do:
      807       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      808     end.
      809   end.
      810   end procedure.
