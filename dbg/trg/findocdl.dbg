     1003   procedure thbjattr_manual-edit :
     1004   define input  parameter p-ucode          as character no-undo .
     1005   define input  parameter p-code           as character no-undo .
     1006   define output parameter p-section-num    as integer no-undo .
     1007   do
     1008   on error undo, return error return-value
     1009   :
     1010       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
     1011       (input  p-ucode
     1012       ,input  p-code
     1013       ,output  p-section-num
     1014       ) no-error .
     1015     if error-status :error
     1016     then do:
     1017       undo, return error return-value .
     1018     end.
     1019   end.
     1020   end procedure.
     1021   main-block:
     1022   do
     1023   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1024   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1025   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1026   :
     1027     define variable v-mes as character no-undo .
     1028     define variable v-ret-mess as character no-undo .
     1029     define variable v-status_ like ub.fin-doc.status_ no-undo .
     1030     DEFINE VARIABLE v-today as date no-undo .
     1031     DEFINE VARIABLE v-time as integer no-undo .
     1032     define variable v-pmnt-code as character no-undo .
     1033     define variable v-full-pmnt-code as character no-undo .
     1034     define buffer buf_fin-doc for ub.fin-doc .
     1035     define buffer buf_fin-connect for ub.fin-connect.
     1036     define buffer buf_fin-statement-line for ub.fin-statement-line.
     1037     define buffer buf_payment for ub.payment.
     1038     define buffer buf0_payment for ub.payment.
     1039     define buffer buf_fin-ob for ub.fin-ob.
     1040     find first buf_fin-doc exclusive-lock where
     1041               buf_fin-doc.host-code = p-host-code
     1042           AND buf_fin-doc.fin-doc-code = p-fin-doc-code
     1043       no-error .
     1044     if not available buf_fin-doc then do:
     1045       message
     1046         vss-workfile vss-revision vss-description skip
     1047         "Ошибка задания входных параметров" skip
     1048         "Фирма" p-host-code
     1049         "Платеж" p-fin-doc-code skip
     1050         view-as alert-box error .
     1051       undo main-block, return error .
     1052     end.
     1053     if (buf_fin-doc.status_ = 'факт':U
     1054     and p-fact-delete = no)
     1055     or
     1056       (buf_fin-doc.status_ <> 'факт':U
     1057     and p-fact-delete = yes)
     1058     or (not g#news and p-fact-delete = ?)
     1059       then do:
     1060       message
     1061         vss-workfile vss-revision vss-description skip
     1062         "Ошибка задания входных параметров" skip
     1063         "Фирма" p-host-code
     1064         "Платеж" p-fin-doc-code skip
     1065         "Статус" buf_fin-doc.status_
     1066         "Параметр p-fact-delete" p-fact-delete
     1067         view-as alert-box error .
     1068       undo main-block, return error .
     1069     end.
     1070     if p-fact-delete = yes then do:
     1071       find first buf_fin-connect NO-LOCK
     1072         where buf_fin-connect.host-code = buf_fin-doc.host-code
     1073           and buf_fin-connect.fin-doc-code = buf_fin-doc.fin-doc-code
     1074       no-error .
     1075       if available buf_fin-connect then do:
     1076         define variable  v-delcnavt        as logical no-undo .
     1077         define variable  par-type          as character no-undo .
     1078         define variable  v-found           as logical   no-undo .
     1079         define variable  v-value-date      as date   no-undo .
     1080         define variable  v-value-decimal   as decimal   no-undo .
     1081         define variable  v-value-integer   as integer   no-undo .
     1082         define variable  v-value-logical   as logical   no-undo .
     1083         define variable  v-value-character as character no-undo .
     1084         run thbjattr_value in this-procedure  (
     1085           input   "",
     1086           input   0 ,
     1087           input   'fin-global':U ,
     1088           input   'del-conn-avt'  ,
     1089           output  v-value-character ,
     1090           output  v-value-date      ,
     1091           output  v-value-decimal   ,
     1092           output  v-value-integer   ,
     1093           output  v-delcnavt  ,
     1094           output  par-type            ,
     1095           output  v-found
     1096           ) no-error
     1097           .
     1098         if error-status :error then v-delcnavt = false .
     1099         if v-delcnavt = no then do:
     1100           assign
     1101           v-mes = substitute("Нельзя удалять платеж: код фирмы &1, вн № &2: платеж связан с фин. обязательствами."
     1102                             , p-host-code , p-fin-doc-code) .
     1103           run err-mess in this-procedure (  input v-mes, output v-ret-mess).
     1104           undo main-block, return error v-ret-mess.
     1105         end.
     1106         else do:
     1107           for each buf_fin-connect exclusive-lock
     1108             where buf_fin-connect.host-code = buf_fin-doc.host-code
     1109               and buf_fin-connect.fin-doc-code = buf_fin-doc.fin-doc-code
     1110          on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1111          on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1112          on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1113          :
     1114             find first buf_fin-ob exclusive-lock where
     1115                       buf_fin-ob.host-code = buf_fin-connect.host-code
     1116                   and buf_fin-ob.doc-code = buf_fin-connect.fin-ob-code .
     1117             assign
     1118               buf_fin-ob.con-sum-rubl  = buf_fin-ob.con-sum-rubl  - buf_fin-connect.sum-rubl
     1119               buf_fin-ob.con-sum-base  = buf_fin-ob.con-sum-base  - buf_fin-connect.sum-base
     1120               buf_fin-ob.con-sum-doc   = buf_fin-ob.con-sum-doc   - buf_fin-connect.sum-doc
     1121               buf_fin-ob.con-sum-contr = buf_fin-ob.con-sum-contr - buf_fin-connect.sum-contr
     1122             .
     1123             if buf_fin-ob.con-sum-contr = 0 then assign buf_fin-ob.con-stat = 0 .
     1124             else                             assign buf_fin-ob.con-stat = 1 .
     1125             delete buf_fin-connect .
     1126           end.
     1127         end.
     1128       end.
     1129       find first buf_fin-statement-line NO-LOCK
     1130         where buf_fin-statement-line.host-code = buf_fin-doc.host-code
     1131           and buf_fin-statement-line.fin-doc-code = buf_fin-doc.fin-doc-code
     1132       no-error .
     1133       if available buf_fin-statement-line then do:
     1134         for each buf_fin-statement-line where
     1135                   buf_fin-statement-line.host-code = buf_fin-doc.host-code
     1136              and  buf_fin-statement-line.fin-doc-code = buf_fin-doc.fin-doc-code
     1137         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1138         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1139         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
     1140           assign
     1141           buf_fin-statement-line.fin-doc-code = 0
     1142           buf_fin-statement-line.fin-doc-type = '':U
     1143           .
     1144         end.
     1145       end.
     1146       assign
     1147       buf_fin-doc.is-del = true
     1148       .
     1149       if not g#news then do:
     1150         run write-fin-doc-history in this-procedure (buffer buf_fin-doc) no-error .
     1151         if error-status :error then do:
     1152           run err-mess in this-procedure (  input "Ошибка при копировании в историю удаляемых платежей", output v-ret-mess).
     1153           undo main-block, return error v-ret-mess.
     1154         end.
     1155       end.
     1156   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_taskclcd in g#lib-farh
     1157   (input p-host-code
     1158   ,input p-fin-doc-code
     1159   ,input 'all':U
     1160   ,input g#userid
     1161   ,input 'delete':u
     1162   ) no-error
     1163   .
     1164       if error-status :error then do:
     1165         run err-mess in this-procedure (  input "Ошибка при пересчете остатков по платежам", output v-ret-mess).
     1166         undo main-block, return error v-ret-mess.
     1167       end.
     1168       if buf_fin-doc.fin-ext-doc-type = 'пко':U
     1169       or buf_fin-doc.fin-ext-doc-type = 'ппп':U
     1170       or buf_fin-doc.fin-ext-doc-type = 'апп':U
     1171       then do:
     1172         define variable v-num-dc as integer no-undo .
     1173         run str/lock-dc.p ( input ?
     1174                     ,input this-procedure:handle
     1175                     ,input 'fin-doc':U
     1176                     ,input string(buf_fin-doc.fin-doc-code)
     1177                     ,input '':U
     1178                     ,input 1
     1179                     ,input no
     1180                     ,input '':U
     1181                     ,output v-num-dc) no-error.
     1182         if error-status:error then do:
     1183           run err-mess in this-procedure ( substitute("Ошибка при блокировании ДК, к котоым привязан платеж&1&2&1&3"
     1184                                                       ,chr(10)
     1185                                                       , error-status:get-message(1)
     1186                                                       , return-value )
     1187                                           ,output v-ret-mess).
     1188           undo main-block, return error v-ret-mess.
     1189         end.
     1190         if v-num-dc > 0 then do:
     1191           for each buf_payment exclusive-lock where
     1192                   buf_payment.source-type = 'платеж':U
     1193               and buf_payment.source-ref = string(buf_fin-doc.fin-doc-code)
     1194           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1195           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1196           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1197           :
     1198             run cur-time in this-procedure( output v-today, output v-time).
     1199             if v-pmnt-code = '':U then do:
     1200               find first buf0_payment no-lock where
     1201                       buf0_payment.source-type = 'платеж':U
     1202                   AND buf0_payment.source-ref = substitute("-&1", string(p-fin-doc-code)) no-error.
     1203               if available buf0_payment then do:
     1204                 assign
     1205                 v-pmnt-code = entry(1, buf0_payment.pmnt-code, "_").
     1206               end.
     1207             end.
     1208             assign
     1209             v-full-pmnt-code  = substitute("&1_&2", v-pmnt-code, entry(2, buf_payment.pmnt-code, "_"))
     1210             .
     1211             run ref/payment1.p (
     1212                                input 'ДОБАВЛЕНИЕ':U
     1213                               ,input  yes
     1214                               ,input-output v-full-pmnt-code
     1215                               ,input buf_payment.cli-type
     1216                               ,input buf_payment.cli-code
     1217                               ,input buf_payment.payer-type
     1218                               ,input buf_payment.payer-code
     1219                               ,input buf_payment.host-code
     1220                               ,input - buf_payment.tot-cli
     1221                               ,input - buf_payment.tot-base
     1222                               ,input - buf_payment.tot-rubl
     1223                               ,input buf_payment.exch-date
     1224                               ,input buf_payment.exch-code
     1225                               ,input buf_payment.exch-rate
     1226                               ,input buf_payment.exch-scale
     1227                               ,input buf_payment.base-rate
     1228                               ,input buf_payment.base-scale
     1229                               ,input buf_payment.due-date
     1230                               ,input v-today
     1231                               ,input buf_payment.source-type
     1232                               ,input substitute("-&1", buf_payment.source-ref)
     1233                               ,input buf_payment.d-card
     1234                               ,input buf_payment.pay-code
     1235                               ,input buf_payment.status_
     1236                               ,input buf_payment.PS
     1237                               ,INPUT buf_fin-doc.user-name-fact
     1238                               ,INPUT buf_fin-doc.user-name-fact
     1239                               ) no-error .
     1240             if error-status:error then do:
     1241               run err-mess in this-procedure (  input substitute("Ошибка при порождении ОТРИЦАТЕЛЬНЫХ привязок по ДК&1&2&1&3"
     1242                                                                   , chr(10)
     1243                                                                   , error-status:get-message(1)
     1244                                                                   , return-value )
     1245                                               , output v-ret-mess).
     1246               undo main-block, return error v-ret-mess.
     1247             end.
     1248           end.
     1249           run str/saledc.p
     1250             (
     1251              input parparentproc
     1252             ,input this-procedure :handle
     1253             ,input ?
     1254             ,input 'delete-fin-doc-from-card':U
     1255             ,input ?
     1256             ,input ""
     1257             ,input 0
     1258             ,input 0
     1259             ,input 0
     1260             ,input g#db-num
     1261             ,input string(buf_fin-doc.fin-doc-code)
     1262             ,input buf_fin-doc.doc-date
     1263             ,input buf_fin-doc.fact-date
     1264             ,input 0
     1265             ,input 1
     1266             ,input ?
     1267             ,input yes
     1268             ) no-error .
     1269           if error-status:error then do:
     1270             run err-mess in this-procedure (  input "Ошибка при пересчете итогов по ДК, привязанным к платежу", output v-ret-mess).
     1271             undo main-block, return error v-ret-mess.
     1272           end.
     1273         end.
     1274       end.
     1275     end.
     1276     delete buf_fin-doc no-error .
     1277     if error-status:error then do:
     1278       run err-mess in this-procedure (  input substitute("Ошибка при удалении платежа:&1&2&1&3"
     1279                                                         , chr(10)
     1280                                                         , error-status:get-message(1)
     1281                                                         , return-value )
     1282                                       , output v-ret-mess).
     1283       undo main-block, return error v-ret-mess.
     1284     end.
     1285   end.
     1286   PROCEDURE err-mess:
     1287     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
     1288     define output parameter p-ret-mess as character no-undo .
     1289     assign
     1290     p-ret-mess =  substitute("ПЛАТЕЖ &1: фирма: &2 N: &3,&4 вн. № &5&4 статус &6&4&7"
     1291                               , buf_fin-doc.fin-doc-type
     1292                               , p-host-code
     1293                               , buf_fin-doc.prn-doc-code
     1294                               , chr(10)
     1295                               , p-fin-doc-code
     1296                               , v-status_
     1297                               , p-mess
     1298                               ).
     1299     CASE p-silent:
     1300       when no then do:
     1301         message
     1302         p-mess
     1303         view-as alert-box error .
     1304       end.
     1305     end.
     1306   END PROCEDURE.
