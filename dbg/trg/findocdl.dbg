      739      define output parameter p-user-can-edit  as logical   no-undo .
      740      define output parameter p-output-display as logical   no-undo .
      741      define output parameter p-other          as character no-undo .
      742      define output parameter p-prop-list      as character no-undo .
      743      define output parameter p-prop-type-list as character no-undo .
      744      define output parameter p-prop-label-list as character no-undo .
      745      define output parameter p-global          as logical no-undo .
      746      define output parameter p-host           as logical no-undo .
      747      define output parameter p-shop           as logical no-undo .
      748      define output parameter p-store          as logical no-undo .
      749      define output parameter p-db             as logical no-undo .
      750      define variable p-region as logical no-undo.
      751      run thbjattr_code_reg in this-procedure (
      752                                               p-upper-code,
      753                                               p-code,
      754                                               output p-label,
      755                                               output p-user-can-edit,
      756                                               output p-output-display,
      757                                               output p-other,
      758                                               output p-prop-list,
      759                                               output p-prop-type-list,
      760                                               output p-prop-label-list,
      761                                               output p-global,
      762                                               output p-host,
      763                                               output p-shop,
      764                                               output p-store,
      765                                               output p-db,
      766                                               output p-region
      767                                               ).
