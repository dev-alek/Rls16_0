      546    do
      547    on error undo, return error return-value
      548    :
      549   define input parameter p-host-code     like ub.c-fin-doc-attr.host-code  no-undo .
      550   define input parameter p-fin-doc-code  like ub.c-fin-doc-attr.fin-doc-code   no-undo .
