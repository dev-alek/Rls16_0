      575             buf_c-fin-doc-attr.attr-code    = p-attr-code
      576         AND buf_c-fin-doc-attr.host-code    = p-host-code
      577         AND buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
      578         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
      579         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
