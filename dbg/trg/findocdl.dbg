      922   on error undo, return error return-value
      923   :
      924       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_write in g#attr-lib
      925       (input  p-obj-type
      926       ,input  p-obj-code
      927       ,input  p-upper-code
      928       ,input  p-code
      929       ,input  p-value-character
      930       ,input  p-value-date
      931       ,input  p-value-decimal
      932       ,input  p-value-integer
      933       ,input  p-value-logical
      934       ) no-error .
      935     if error-status :error
      936     then do:
      937       undo, return error return-value .
      938     end.
      939   end.
      940   end procedure.
      941   procedure thbjattr_set-section :
      942   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      943   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      944   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      945   define input  parameter table-handle p-tth.
      946   do
      947   on error undo, return error return-value
      948   :
      949       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
      950       (input  p-obj-type
      951       ,input  p-obj-code
      952       ,input  p-upper-code
      953       ,input  table-handle p-tth
      954       ) no-error .
      955     if error-status :error
      956     then do:
      957       delete object p-tth.
      958       undo, return error return-value .
      959     end.
      960     delete object p-tth.
      961   end.
      962   end procedure.
      963   procedure thbjattr_delete :
      964   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      965   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      966   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      967   define input  parameter p-code       like ub.thbj-attr.prop-code  no-undo .
      968   define output parameter p-deleted  as logical no-undo.
      969   do
      970   on error undo, return error return-value
      971   :
      972       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete in g#attr-lib
      973       (input  p-obj-type
      974       ,input  p-obj-code
      975       ,input  p-upper-code
      976       ,input  p-code
      977       ,output p-deleted
      978       ) no-error .
      979     if error-status :error
      980     then do:
      981       undo, return error return-value .
      982     end.
      983   end.
      984   end procedure.
      985   procedure thbjattr_delete-section :
      986   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      987   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      988   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      989   do
      990   on error undo, return error return-value
      991   :
      992       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
      993       (input  p-obj-type
      994       ,input  p-obj-code
      995       ,input  p-upper-code
      996       ) no-error .
      997     if error-status :error
