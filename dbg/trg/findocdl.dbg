      684   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      685   procedure write-fin-doc-history :
      686   define parameter buffer buf_fin-doc for ub.fin-doc.
      687   define variable v-date as date no-undo .
      688   define variable v-time as integer no-undo .
      689   define buffer buf_c-fin-doc for ub.c-fin-doc.
      690   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
      691   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      692     do
      693     on error undo, return error
      694     :
      695       run cur-time in this-procedure(output v-date, output v-time).
      696       create buf_c-fin-doc.
      697       buffer-copy buf_fin-doc to buf_c-fin-doc
      698       assign
      699       buf_c-fin-doc.chip-num           = next-value (s-corr-chip, ub)
      700       buf_c-fin-doc.corr-time          = v-time
      701       buf_c-fin-doc.corr-user-db-num   = g#db-num
      702       buf_c-fin-doc.corr-user-name     = g#userid
      703       buf_c-fin-doc.corr-date          = v-date
      704       buf_c-fin-doc.corr-doc-code      = "":U
      705       .
      706       for each ub.fin-doc-tax where
      707                ub.fin-doc-tax.host-code = buf_fin-doc.host-code
      708            AND ub.fin-doc-tax.fin-doc-code = buf_fin-doc.fin-doc-code:
      709         create buf_c-fin-doc-tax.
      710         buffer-copy ub.fin-doc-tax to buf_c-fin-doc-tax
      711         assign
      712         buf_c-fin-doc-tax.chip-num           = buf_c-fin-doc.chip-num
      713         buf_c-fin-doc-tax.corr-user-db-num   = buf_c-fin-doc.corr-user-db-num
      714         .
      715       end.
      716       for each ub.fin-doc-attr where
      717                ub.fin-doc-attr.host-code = buf_fin-doc.host-code
      718            AND ub.fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code:
      719         create buf_c-fin-doc-attr.
      720         buffer-copy ub.fin-doc-attr to buf_c-fin-doc-attr
      721         assign
      722         buf_c-fin-doc-attr.chip-num           = buf_c-fin-doc.chip-num
      723         buf_c-fin-doc-attr.corr-user-db-num   = buf_c-fin-doc.corr-user-db-num
      724         buf_c-fin-doc-attr.attr-value         = buf_c-fin-doc-attr.attr-value
      725         .
      726       end.
      727       release buf_c-fin-doc.
      728     end.
      729   end procedure.
