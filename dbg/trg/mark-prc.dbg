        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code            as character no-undo .
        3   define input  parameter p-fact-order          as decimal   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Отметка переоценок, закрытых после указанного документа как требующих перерасчета".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2',p-doc-code,p-fact-order)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define variable v-waitfram-action01         as character   no-undo .
       84   define variable v-waitfram-action02         as character   no-undo .
       85   define variable v-waitfram-action03         as character   no-undo .
       86   define variable mWaitFramTextBeg            as character   no-undo.
       87   define variable mWaitFramTextEnd            as character   no-undo.
       88   define variable mWaitFramView               as logical     no-undo.
       89   define variable mWaitProcEvent              as logical     no-undo init yes.
       90   define variable mWaitFramInterval           as integer     no-undo init 1 .
       91   define variable mWaitFramStop               as logical     no-undo.
       92   define variable mWaitFramStopUser           as logical     no-undo.
       93   define variable mWaitFramStopTimeOut        as logical     no-undo.
       94   define variable mWaitFramStartProc          as datetime-tz no-undo.
       95   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       96   define button B-WaitFramStop auto-end-key
       97        label "Стоп"
       98        size 10 by 1 tooltip "Остоновить процесс".
       99   define button B-viewProcInfo
      100        label "Информация"
      101        size 15 by 1 tooltip "Информация о процесс".
      102   define frame waitfram
      103     v-waitfram-action01 format "x(72)" no-label skip
      104     v-waitfram-action02 format "x(72)" no-label skip
      105     v-waitfram-action03 format "x(72)" no-label skip
      106     B-viewProcInfo
      107     B-WaitFramStop at row 4 col 30
      108     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      109     .
      110   define new global shared variable mBatchMode as logical no-undo init ?.
      111   define variable mFramBachModHandle as handle no-undo.
      112   mFramBachModHandle = frame waitfram:handle.
      113   define variable mFameOldVis as logical no-undo.
      114   define variable mVisCUrentVin as logical no-undo.
      115   if session:batch-mode
      116   then
      117      mBatchMode = yes.
      118   if mBatchMode = ? then do:
      119     mVisCUrentVin = current-window:visible.
      120     mFameOldVis = mFramBachModHandle:visible.
      121     mFramBachModHandle:visible  = yes.
      122     mBatchMode = mFramBachModHandle:visible ne yes.
      123     mFramBachModHandle:visible = mFameOldVis.
      124     current-window:visible = mVisCUrentVin.
      125   end.
      126    if  log-manager:logfile-name ne ?
      127     then DO:
      128         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      129         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      130         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      131     end.
      132   on choose of B-WaitFramStop in frame waitfram
      133   do:
      134     mWaitFramStop = yes.
      135     mWaitFramStopUser = yes.
      136   end.
      137   function waitfram-check-timeout returns logical():
      138      define variable vtime as int64 no-undo.
      139      if mWaitFramStopTimeOut
      140      then
      141         return yes.
      142      vtime = ( now - mWaitFramStartProc ) / 1000 .
      143      if     mWaitFramTimeOut ne ?
      144         and mWaitFramTimeOut ne 0
      145         and mWaitFramTimeOut lt vtime
      146      then do:
      147         mWaitFramStopTimeOut = yes.
      148      end.
      149      return mWaitFramStopTimeOut.
      150   end.
      151   procedure waitfram-hide :
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       pause 0 before-hide .
      157       if not mBatchMode then
      158         hide frame waitfram .
      159     if     not mWaitFramView
      160        and mWaitProcEvent
      161     then
      162       process events .
      163     end.
      164   end procedure.
      165   procedure waitfram-show :
      166     define input  parameter p-message as character no-undo .
      167     define variable v-left-margin as integer   no-undo .
      168     if not session:batch-mode
      169     then do
      170     on error undo, return error return-value
      171     :
      172       if length(p-message) <= 70 then do:
      173         assign
      174           v-left-margin = integer((70 - length(p-message)) / 2)
      175         .
      176         assign
      177           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      178         .
      179         assign
      180           v-waitfram-action01 = " "
      181           v-waitfram-action02 = " "
      182                                    + fill(" ", v-left-margin)
      183                                    + p-message
      184           v-waitfram-action03 = " "
      185         .
      186       end.
      187       else do:
      188         define variable vRindex1 as integer no-undo.
      189         define variable vRindex2 as integer no-undo.
      190         vRindex1 = r-index(p-message," ",70).
      191         if vRindex1 = 0
      192         then
      193            vRindex1 = 70.
      194         if length(p-message)  <= vRindex1 + 70 then do:
      195           assign
      196             v-waitfram-action01 = " "
      197             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      199           .
      200         end.
      201         else do:
      202           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      203           if vRindex2 <= vRindex1
      204           then
      205              vRindex2 = vRindex1 + 70.
      206           assign
      207             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      208             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      209             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      210           .
      211         end.
      212       end.
      213       B-viewProcInfo:visible   in frame waitfram = no.
      214       B-viewProcInfo:sensitive in frame waitfram = no.
      215       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      216       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      217       if  (   mWaitFramView
      218          or  mWaitProcEvent)
      219          and not mBatchMode
      220       then
      221          display
      222             v-waitfram-action01 skip
      223             v-waitfram-action02 skip
      224             v-waitfram-action03 skip
      225          with frame waitfram .
      226       if     mWaitFramView
      227          then do:
      228             if     mWaitFramInterval ne ?
      229                and not mBatchMode
      230             then
      231                wait-for go of frame waitfram pause mWaitFramInterval.
      232          end.
      233          else
      234             if     mWaitProcEvent
      235                and not mBatchMode
      236             then
      237                process events .
      238     end.
      239   end procedure.
      240      procedure waitfram-show-this:
      241         define input  parameter iInterval as int64 no-undo.
      242         define variable vtime as int64 no-undo.
      243         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      244         mWaitFramInterval = iInterval.
      245         run waitfram-show (substitute("&1&2 &3&4" ,
      246                                       mWaitFramTextBeg ,
      247                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      248                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      249                                       mWaitFramTextEnd
      250                                      )
      251                           ).
      252      end.
      253      procedure WaitFramRunPause:
      254         define input  parameter iInterval as dec no-undo.
      255         define variable vStart  as datetime-tz no-undo.
      256         define variable vend    as datetime-tz no-undo.
      257         define variable vint as int64 no-undo.
      258         define variable vOk as logical no-undo.
      259         vStart = now.
      260         vend   = vStart.
      261         publish "WaitFramPause" (iInterval,output vOk).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and (   vint > 0
      267                 or (    not vOk
      268                     and iInterval eq ?
      269                     )
      270                 )
      271         then
      272            run waitfram-show-this (iInterval).
      273         vend   =  now.
      274         vint = vend - vStart.
      275         vint = iInterval - vint / 1000.
      276         if     not mWaitFramStop
      277            and vint > 0
      278         then do:
      279            run gbl/pause.p (vint * 1000).
      280         end.
      281         if iInterval ne ?
      282         then
      283            publish "WaitFramStop".
      284         waitfram-check-timeout().
      285      end.
      286      procedure WaitFramWaitFor:
      287         define input  parameter iInterval as dec no-undo.
      288         assign
      289            mWaitFramStartProc   = now
      290            mWaitFramStopUser    = no
      291            mWaitFramStopTimeOut = no
      292         .
      293         block-wait:
      294         do while not mWaitFramStop:
      295            run WaitFramRunPause (iInterval).
      296            if  waitfram-check-timeout()
      297            then do:
      298               leave block-wait.
      299            end.
      300         end.
      301         run waitfram-hide.
      302      end.
      303   procedure waitfram-join :
      304     define input  parameter p-line-1  as character no-undo .
      305     define input  parameter p-line-2  as character no-undo .
      306     define input  parameter p-line-3  as character no-undo .
      307     define output parameter p-message as character no-undo .
      308     do
      309     on error undo, return error return-value
      310     :
      311       assign
      312         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      313                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      314                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      315       .
      316     end.
      317   end procedure.
      318   function waitfram-join-function returns character
      319     (input p-line-1 as character
      320     ,input p-line-2 as character
      321     ,input p-line-3 as character
      322     ).
      323     define variable v-message as character no-undo .
      324     run waitfram-join in this-procedure
      325       (input  p-line-1
      326       ,input  p-line-2
      327       ,input  p-line-3
      328       ,output v-message
      329       ) .
      330     return v-message .
      331   end function .
      332   define buffer buf_trn-doc for ub.trn-doc .
      333   define buffer buf_doc-line for ub.doc-line .
      334   define buffer buf_price-list for ub.price-list .
      335   define variable v-archive-recalc as logical   no-undo .
      336   define temp-table temp-price-doc no-undo
      337     field doc-num as character
      338     index xpk is primary unique doc-num
      339   .
      340   define variable v-price-list-found as logical   no-undo .
      341   do
      342   on error undo, return error return-value
      343   :
      344     assign
      345       v-archive-recalc = false
      346     .
      347     find first buf_trn-doc no-lock
      348       where buf_trn-doc.doc-code = p-doc-code
      349       no-error .
      350     if not available buf_trn-doc then do:
      351       message
      352         vss-workfile vss-revision vss-description skip
      353         "Ошибка задания входных параметров" skip
      354         "Не найден документ" p-doc-code skip
      355         view-as alert-box error .
      356       undo, return error .
      357     end.
      358     for each buf_doc-line
      359       where buf_doc-line.doc-code = p-doc-code
      360     on error undo, return error
      361     :
      362       run process-price-list in this-procedure
      363         (input  buf_doc-line.obj-type
      364         ,input  buf_doc-line.obj-code
      365         ,input  buf_doc-line.artic
      366         ,input  buf_doc-line.prod-type
      367         ,input  buf_doc-line.prod-code
      368         ,input  p-fact-order
      369         ) no-error .
      370       if error-status :error then do:
      371         message
      372           vss-workfile vss-revision vss-description skip
      373           "Ошибка при вызове процедуры process-price-list" skip
      374           "Документ" p-doc-code skip
      375           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      376           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      377           "Фактический номер" p-fact-order skip
      378           error-status :get-message(1) skip
      379           return-value skip
      380           view-as alert-box error .
      381         undo, return error .
      382       end.
      383     end.
      384     find first temp-price-doc
      385       no-error .
      386     if available temp-price-doc
      387     then do:
      388       define variable v-message as character no-undo .
      389       define variable v-need-stop-arh as logical   no-undo .
      390       assign
      391         v-need-stop-arh = false
      392       .
      393       define buffer calc-arh-lock_batchprocess for ub.batchprocess .
      394       run gbl/lock-prc.p
      395         (input 'btpr':U
      396         ,input buf_trn-doc.obj-code
      397         ,input 0
      398         ,input 0
      399         ,input buf_trn-doc.obj-type
      400         ,input ""
      401         ,input ""
      402         ,input "Объект,,, ,,,Расчет складского архива по товарам"
      403         ,input false
      404         ,buffer calc-arh-lock_batchprocess
      405         ) no-error .
      406       if error-status :error
      407       then do:
      408         if error-status :get-message(1) <> ""
      409         then do:
      410           message
      411             vss-workfile vss-revision vss-description skip
      412             "Ошибка при вызове процедуры блокировки расчета складского архива по товарам" skip
      413             error-status :get-message(1) skip
      414             return-value skip
      415             view-as alert-box error .
      416           undo, return error "Ошибка при вызове процедуры блокировки расчёта складского архива по товарам" .
      417         end.
      418         assign
      419           v-need-stop-arh = true
      420         .
      421       end.
      422       define buffer stop-arh-news-lock_btpr for batchprocess .
      423       if v-need-stop-arh = true
      424       then do:
      425         do transaction
      426         on error undo, return error return-value
      427         :
      428           create stop-arh-news-lock_btpr .
      429           assign
      430             stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
      431             stop-arh-news-lock_btpr.bp_status     = 'N':U
      432             stop-arh-news-lock_btpr.Key#_One      = buf_trn-doc.obj-code
      433             stop-arh-news-lock_btpr.Key#_Two      = 0
      434             stop-arh-news-lock_btpr.Key#_Three    = 0
      435             stop-arh-news-lock_btpr.CharKey_One   = buf_trn-doc.obj-type
      436             stop-arh-news-lock_btpr.CharKey_Two   = buf_trn-doc.doc-code
      437             stop-arh-news-lock_btpr.CharKey_Three = ""
      438           .
      439           define variable v-start-lock-time   as int64     no-undo .
      440           define variable v-start-lock-second as integer   no-undo .
      441           assign
      442             v-start-lock-time = etime
      443           .
      444           wait_block:
      445           do while true
      446           :
      447             assign
      448               v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
      449             .
      450             run waitfram-show in this-procedure
      451               (input waitfram-join-function("Архив по товарам рассчитывается на другой машине"
      452                                            ,"Отправлено сообщение о необходимости остановки расчёта складского архива"
      453                                            ,substitute("Ожидание освобождение ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
      454                                            )
      455               ) .
      456             run gbl/lock-prc.p
      457               (input 'btpr':U
      458               ,input buf_trn-doc.obj-code
      459               ,input 0
      460               ,input 0
      461               ,input buf_trn-doc.obj-type
      462               ,input ""
      463               ,input ""
      464               ,input "Объект,,, ,,,Расчет складского архива по товарам"
      465               ,input false
      466               ,buffer calc-arh-lock_batchprocess
      467               ) no-error .
      468             if error-status :error
      469             then do:
      470               if error-status :get-message(1) <> ""
      471               then do:
      472                 message
      473                   vss-workfile vss-revision vss-description skip
      474                   "Ошибка при вызове процедуры блокировки расчета складского архива по товарам" skip
      475                   error-status :get-message(1) skip
      476                   return-value skip
      477                   view-as alert-box error .
      478                 undo, return error "В данный момент рассчитывается складской архив по товарам" .
      479               end.
      480             end.
      481             else do:
      482               run waitfram-hide in this-procedure .
      483               leave wait_block .
      484             end.
      485             pause 1 no-message .
      486           end.
      487           delete stop-arh-news-lock_btpr .
      488           run waitfram-hide in this-procedure .
      489         end.
      490       end.
      491       define variable v-need-stop-ahsp as logical   no-undo .
      492       assign
      493         v-need-stop-ahsp = false
      494       .
      495       define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
      496       run gbl/lock-prc.p
      497         (input 'ahsp':U
      498         ,input buf_trn-doc.obj-code
      499         ,input 0
      500         ,input 0
      501         ,input buf_trn-doc.obj-type
      502         ,input ""
      503         ,input ""
      504         ,input "Объект,,, ,,,Расчет складского складского архива по поставщикам"
      505         ,input false
      506         ,buffer calc-supp-arh-lock_batchprocess
      507         ) no-error .
      508       if error-status :error
      509       then do:
      510         if error-status :get-message(1) <> ""
      511         then do:
      512           message
      513             vss-workfile vss-revision vss-description skip
      514             "Ошибка при вызове процедуры блокировки расчета складского архива по поставщикам" skip
      515             error-status :get-message(1) skip
      516             return-value skip
      517             view-as alert-box error .
      518           undo, return error "Ошибка при вызове процедуры блокировки расчёта складского архива по поставщикам" .
      519         end.
      520         assign
      521           v-need-stop-ahsp = true
      522         .
      523       end.
      524       define buffer stop-ahsp-news-lock_btpr for batchprocess .
      525       if v-need-stop-ahsp = true
      526       then do:
      527         do transaction
      528         on error undo, return error return-value
      529         :
      530           create stop-ahsp-news-lock_btpr .
      531           assign
      532             stop-ahsp-news-lock_btpr.bp_type       = 'lock':U + 'rssn':U
      533             stop-ahsp-news-lock_btpr.bp_status     = 'N':U
      534             stop-ahsp-news-lock_btpr.Key#_One      = buf_trn-doc.obj-code
      535             stop-ahsp-news-lock_btpr.Key#_Two      = 0
      536             stop-ahsp-news-lock_btpr.Key#_Three    = 0
      537             stop-ahsp-news-lock_btpr.CharKey_One   = buf_trn-doc.obj-type
      538             stop-ahsp-news-lock_btpr.CharKey_Two   = buf_trn-doc.doc-code
      539             stop-ahsp-news-lock_btpr.CharKey_Three = ""
      540           .
      541           assign
      542             v-start-lock-time = etime
      543           .
      544           wait_block:
      545           do while true
      546           :
      547             assign
      548               v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
      549             .
      550             run waitfram-show in this-procedure
      551               (input waitfram-join-function("Архив по поставщикам рассчитывается на другой машине"
      552                                            ,"Отправлено сообщение о необходимости остановки расчёта складского архива"
      553                                            ,substitute("Ожидание освобождение ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
      554                                            )
      555               ) .
      556             run gbl/lock-prc.p
      557               (input 'ahsp':U
      558               ,input buf_trn-doc.obj-code
      559               ,input 0
      560               ,input 0
      561               ,input buf_trn-doc.obj-type
      562               ,input ""
      563               ,input ""
      564               ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
      565               ,input false
      566               ,buffer calc-supp-arh-lock_batchprocess
      567               ) no-error .
      568             if error-status :error
      569             then do:
      570               if error-status :get-message(1) <> ""
      571               then do:
      572                 message
      573                   vss-workfile vss-revision vss-description skip
      574                   "Ошибка при вызове процедуры блокировки расчета архива по поставщикам" skip
      575                   error-status :get-message(1) skip
      576                   return-value skip
      577                   view-as alert-box error .
      578                 undo, return error "Ошибка при вызове процедуры блокировки расчета архива по поставщикам" .
      579               end.
      580             end.
      581             else do:
      582               leave wait_block .
      583             end.
      584             pause 1 no-message .
      585           end.
      586           delete stop-ahsp-news-lock_btpr .
      587           run waitfram-hide in this-procedure .
      588         end.
      589       end.
      590       define variable v-need-stop-aht as logical   no-undo .
      591       assign
      592         v-need-stop-aht = false
      593       .
      594       define buffer calc-aht-lock_batchprocess for ub.batchprocess .
      595       run gbl/lock-prc.p
      596         (input 'ahtb':U
      597         ,input buf_trn-doc.obj-code
      598         ,input 0
      599         ,input 0
      600         ,input buf_trn-doc.obj-type
      601         ,input ""
      602         ,input ""
      603         ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
      604         ,input false
      605         ,buffer calc-aht-lock_batchprocess
      606         ) no-error .
      607       if error-status :error
      608       then do:
      609         if error-status :get-message(1) <> ""
      610         then do:
      611           message
      612             vss-workfile vss-revision vss-description skip
      613             "Ошибка при вызове процедуры блокировки расчета складского архива по поставщикам" skip
      614             error-status :get-message(1) skip
      615             return-value skip
      616             view-as alert-box error .
      617           undo, return error "Ошибка при вызове процедуры блокировки расчёта складского архива по поставщикам" .
      618         end.
      619         assign
      620           v-need-stop-aht = true
      621         .
      622       end.
      623       define buffer stop-aht-news-lock_btpr for batchprocess .
      624       if v-need-stop-aht = true
      625       then do:
      626         do transaction
      627         on error undo, return error return-value
      628         :
      629           create stop-aht-news-lock_btpr .
      630           assign
      631             stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
      632             stop-aht-news-lock_btpr.bp_status     = 'N':U
      633             stop-aht-news-lock_btpr.Key#_One      = buf_trn-doc.obj-code
      634             stop-aht-news-lock_btpr.Key#_Two      = 0
      635             stop-aht-news-lock_btpr.Key#_Three    = 0
      636             stop-aht-news-lock_btpr.CharKey_One   = buf_trn-doc.obj-type
      637             stop-aht-news-lock_btpr.CharKey_Two   = buf_trn-doc.doc-code
      638             stop-aht-news-lock_btpr.CharKey_Three = ""
      639           .
      640           assign
      641             v-start-lock-time = etime
      642           .
      643           wait_block:
      644           do while true
      645           :
      646             assign
      647               v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
      648             .
      649             run waitfram-show in this-procedure
      650               (input waitfram-join-function("Архив по типам приобретения рассчитывается на другой машине"
      651                                            ,"Отправлено сообщение о необходимости остановки расчёта складского архива"
      652                                            ,substitute("Ожидание освобождение ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
      653                                            )
      654               ) .
      655             run gbl/lock-prc.p
      656               (input 'ahtb':U
      657               ,input buf_trn-doc.obj-code
      658               ,input 0
      659               ,input 0
      660               ,input buf_trn-doc.obj-type
      661               ,input ""
      662               ,input ""
      663               ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
      664               ,input false
      665               ,buffer calc-aht-lock_batchprocess
      666               ) no-error .
      667             if error-status :error
      668             then do:
      669               if error-status :get-message(1) <> ""
      670               then do:
      671                 message
      672                   vss-workfile vss-revision vss-description skip
      673                   "Ошибка при вызове процедуры блокировки расчета складского архива по типам приобретения" skip
      674                   error-status :get-message(1) skip
      675                   return-value skip
      676                   view-as alert-box error .
      677                 undo, return error "В данный момент рассчитывается складской архив по типам приобретения" .
      678               end.
      679             end.
      680             else do:
      681               leave wait_block .
      682             end.
      683             pause 1 no-message .
      684           end.
      685           delete stop-aht-news-lock_btpr .
      686           run waitfram-hide in this-procedure .
      687         end.
      688       end.
      689       for each temp-price-doc
      690       on error undo, return error return-value
      691       :
      692         run trg/nu_prc.p
      693           (input temp-price-doc.doc-num
      694           ,input 'price-doc':U
      695           ,input buf_trn-doc.obj-type
      696           ,input buf_trn-doc.obj-code
      697           ) no-error .
      698         if error-status :error then do:
      699           message
      700             vss-workfile vss-revision vss-description skip
      701             "Ошибка при вызове процедуры nu_prc.p" skip
      702             error-status :get-message(1) skip
      703             return-value skip
      704             view-as alert-box error .
      705           undo, return error .
      706         end.
      707     find first ub.batchprocess exclusive-lock
      708       where ub.batchprocess.bp_type   = 'arh':U
      709         and ub.batchprocess.bp_status = 'N':U
      710         and  ub.batchprocess.key#_one  = buf_trn-doc.obj-code
      711         and ub.batchprocess.charkey_one = temp-price-doc.doc-num
      712         and ub.batchprocess.charkey_two = 'price-doc':U
      713         and ub.batchprocess.charkey_three = buf_trn-doc.obj-type
      714     no-error .
      715         if not available ub.batchprocess
      716         then do:
      717           assign
      718             v-archive-recalc = true
      719           .
      720         end.
      721     find first ub.batchprocess exclusive-lock
      722       where ub.batchprocess.bp_type   = 'aht':U
      723         and ub.batchprocess.bp_status = 'N':U
      724         and  ub.batchprocess.key#_one  = buf_trn-doc.obj-code
      725         and ub.batchprocess.charkey_one = temp-price-doc.doc-num
      726         and ub.batchprocess.charkey_two = 'price-doc':U
      727         and ub.batchprocess.charkey_three = buf_trn-doc.obj-type
      728     no-error .
      729         if not available ub.batchprocess
      730         then do:
      731           assign
      732             v-archive-recalc = true
      733           .
      734         end.
      735       end.
      736       if v-archive-recalc = true
      737       then do:
      738         run trg/markarh.p
      739           (input buf_trn-doc.obj-type
      740           ,input buf_trn-doc.obj-code
      741           ,input buf_trn-doc.fact-date
      742           ,input p-doc-code
      743           ) no-error .
      744         if error-status :error
      745         then do:
      746           message
      747             vss-workfile vss-revision vss-description skip
      748             "Закрытие документа задним числом" skip
      749             "Ошибка при отметке складского архива по товару, что он требует перерасчета" skip
      750             "Документ" buf_trn-doc.doc-code skip
      751             "Расширенный тип документа" buf_trn-doc.ext-doc-type skip
      752             "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
      753             "Дата" buf_trn-doc.fact-date skip
      754             error-status :get-message(1) skip
      755             return-value skip
      756             view-as alert-box error .
      757           undo, return error return-value .
      758         end.
      759         run trg/markahsp.p
      760           (input  buf_trn-doc.obj-type
      761           ,input  buf_trn-doc.obj-code
      762           ,input  buf_trn-doc.fact-date
      763           ,input  p-doc-code
      764           ) no-error .
      765         if error-status :error
      766         then do:
      767           message
      768             vss-workfile vss-revision vss-description skip
      769             "Закрытие документа задним числом" skip
      770             "Ошибка при отметке складского архива по поставщикам, что он требует перерасчета" skip
      771             "Документ" buf_trn-doc.doc-code skip
      772             "Расширенный тип документа" buf_trn-doc.ext-doc-type skip
      773             "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
      774             "Дата" buf_trn-doc.fact-date skip
      775             error-status :get-message(1) skip
      776             return-value skip
      777             view-as alert-box error .
      778           undo, return error return-value .
      779         end.
      780         run trg/markaht.p
      781           (input  buf_trn-doc.obj-type
      782           ,input  buf_trn-doc.obj-code
      783           ,input  buf_trn-doc.fact-date
      784           ,input  p-doc-code
      785           ) no-error .
      786         if error-status :error
      787         then do:
      788           message
      789             vss-workfile vss-revision vss-description skip
      790             "Закрытие документа задним числом" skip
      791             "Ошибка при отметке складского архива по типам приобретения, что он требует перерасчета" skip
      792             "Документ" buf_trn-doc.doc-code skip
      793             "Расширенный тип документа" buf_trn-doc.ext-doc-type skip
      794             "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
      795             "Дата" buf_trn-doc.fact-date skip
      796             error-status :get-message(1) skip
      797             return-value skip
      798             view-as alert-box error .
      799           undo, return error return-value .
      800         end.
      801       end.
      802     end.
      803   end.
      804   procedure process-price-list :
      805     define input  parameter p-obj-type         like ub.trn-doc.obj-type     no-undo.
      806     define input  parameter p-obj-code         like ub.trn-doc.obj-code     no-undo.
      807     define input  parameter p-artic            like ub.doc-line.artic       no-undo.
      808     define input  parameter p-prod-type        like ub.doc-line.prod-type   no-undo.
      809     define input  parameter p-prod-code        like ub.doc-line.prod-code   no-undo.
      810     define input  parameter p-fact-order       like ub.trn-doc.fact-order   no-undo.
      811     define variable vss-description as character no-undo init "process-price-list: поиск строк переоценок, подлежащих перерасчету".
      812     define variable v-is-new   as   logical              no-undo.
      813     define variable v-root-node like ub.bar-code.node-code no-undo.
      814     define buffer buf_price-list for ub.price-list.
      815     define buffer buf_goods      for ub.goods.
      816     define variable v-b-code like ub.bar-code.b-code no-undo .
      817     do
      818     on error undo, return error return-value
      819     :
      820       find first buf_goods no-lock
      821         where buf_goods.artic     = p-artic
      822           and buf_goods.prod-type = p-prod-type
      823           and buf_goods.prod-code = p-prod-code
      824         no-error .
      825       if not available buf_goods then do:
      826         message
      827           vss-workfile vss-revision vss-description skip
      828           "Не найден товар" skip
      829           "Артикул" p-artic p-prod-type p-prod-code skip
      830           view-as alert-box error .
      831         undo, return error .
      832       end.
      833   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      834     (input  buf_goods.gds-code
      835     ,input  ?
      836     ,output v-b-code
      837     ) no-error .
      838       if error-status :error then do:
      839         message
      840           vss-workfile vss-revision vss-description skip
      841           "Ошибка при определении основного бар-кода товара" skip
      842           "Артикул" p-artic p-prod-type p-prod-code skip
      843           error-status :get-message(1) skip
      844           return-value skip
      845           view-as alert-box error .
      846         undo, return error .
      847       end.
      848       for each buf_price-list
      849         where buf_price-list.obj-type   = p-obj-type
      850           and buf_price-list.obj-code   = p-obj-code
      851           and buf_price-list.b-code     = v-b-code
      852           and buf_price-list.price-type = ""
      853           and buf_price-list.fact-order > p-fact-order
      854       on error undo, return error
      855       :
      856         run register-price-doc in this-procedure
      857           (input buf_price-list.doc-num
      858           ) .
      859       end.
      860     end.
      861   end procedure.
      862   procedure register-price-doc :
      863     define input  parameter p-doc-num as character no-undo .
      864     define buffer buf_temp-price-doc for temp-price-doc .
      865     do
      866     on error undo, return error return-value
      867     :
      868       find first buf_temp-price-doc
      869         where buf_temp-price-doc.doc-num = p-doc-num
      870         no-error .
      871       if not available buf_temp-price-doc
      872       then do:
      873         create buf_temp-price-doc .
      874         assign
      875           buf_temp-price-doc.doc-num = p-doc-num
      876         .
      877       end.
      878     end.
      879   end procedure.
