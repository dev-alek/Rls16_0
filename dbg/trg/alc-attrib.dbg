        1   block-level on error undo, throw.
        2   define input parameter p-in-code   like ub.parts.in-code   no-undo .
        3   define input parameter p-artic     like ub.parts.artic     no-undo .
        4   define input parameter p-prod-type like ub.parts.prod-type no-undo .
        5   define input parameter p-prod-code like ub.parts.prod-code no-undo .
        6   define input parameter p-part-code like ub.parts.part-code no-undo .
        7   define input parameter p-alc-mark-db-num         as integer   no-undo.
        8   define input parameter p-alc-mark-code           as integer   no-undo.
        9   define input parameter p-alc-bottling-date       as date      no-undo.
       10   define input parameter p-alc-ref-ab-path         as character no-undo.
       11   define input parameter p-alc-quality-certif-path as character no-undo.
       12   define input parameter p-alc-certif-path         as character no-undo.
       13   define input parameter p-alc-imp-type            as character no-undo.
       14   define input parameter p-alc-imp-code            as integer   no-undo.
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Изменение алкогольных аттрибутов для партии приходной накладной ".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define buffer buf_gds-obj for ub.gds-obj .
       78   define buffer buf_parts for ub.parts .
       79   define buffer buf_parts-attr for ub.parts-attr .
       80   main-block:
       81   do transaction
       82   on error undo main-block, return error
       83   :
       84     for each ub.gds-obj no-lock
       85       where ub.gds-obj.artic     = p-artic
       86         and ub.gds-obj.prod-type = p-prod-type
       87         and ub.gds-obj.prod-code = p-prod-code
       88     on error undo main-block, return error
       89     :
       90       find first buf_gds-obj exclusive-lock
       91         where recid(buf_gds-obj) = recid(ub.gds-obj)
       92         .
       93     end.
       94     define variable v-gds-code as integer   no-undo .
       95   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
       97     (input  p-artic
       98     ,input  p-prod-type
       99     ,input  p-prod-code
      100     ,output v-gds-code
      101     )  .
      102     for each ub.parts no-lock
      103       where ub.parts.in-code   = p-in-code
      104         and ub.parts.artic     = p-artic
      105         and ub.parts.prod-type = p-prod-type
      106         and ub.parts.prod-code = p-prod-code
      107         and ub.parts.part-code = p-part-code
      108     on error undo main-block, return error
      109     :
      110         find first buf_parts exclusive-lock
      111           where recid(buf_parts) = recid(ub.parts)
      112           .
      113         assign
      114           buf_parts.mark-db-num = p-alc-mark-db-num
      115           buf_parts.mark-code = p-alc-mark-code
      116           buf_parts.alc-bottling-date = p-alc-bottling-date
      117           buf_parts.alc-ref-ab-path = p-alc-ref-ab-path
      118           buf_parts.alc-quality-certif-path = p-alc-quality-certif-path
      119           buf_parts.alc-certif-path = p-alc-certif-path
      120           buf_parts.alc-imp-type = p-alc-imp-type
      121           buf_parts.alc-imp-code = p-alc-imp-code
      122         .
      123     end.
      124   end.
